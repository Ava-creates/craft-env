{"timestamp": "2025-07-29T20:53:36.005248", "function_name": "craft", "function_body": "    import collections\n\n    # Constants for actions as defined by action_specs\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Mapping actions to (delta_row, delta_col) for movement\n    _MOVE_DELTAS = {\n        ACTION_UP: (-1, 0),\n        ACTION_DOWN: (1, 0),\n        ACTION_LEFT: (0, -1),\n        ACTION_RIGHT: (0, 1),\n    }\n\n    def _find_path_actions_to_adjacent(start_pos, target_pos, grid_shape, obstacle_indices, current_grid):\n        \"\"\"\n        Finds a path using BFS from start_pos to a cell adjacent to target_pos,\n        avoiding obstacles. Returns a list of move actions or None if no path.\n        \"\"\"\n        rows, cols, _ = grid_shape\n        queue = collections.deque([(start_pos, [])])  # (pos, path_actions)\n        visited = {start_pos}\n\n        target_r, target_c = target_pos\n        \n        # Determine all valid adjacent cells to the target that are traversable\n        valid_adj_cells = []\n        for (dr, dc) in _MOVE_DELTAS.values():\n            adj_r, adj_c = target_r + dr, target_c + dc\n            adj_pos = (adj_r, adj_c)\n\n            if not (0 <= adj_r < rows and 0 <= adj_c < cols):\n                continue # Out of bounds\n\n            # Check if this adjacent cell is an obstacle for movement\n            is_obstacle = False\n            for obstacle_idx in obstacle_indices:\n                if current_grid[adj_r, adj_c, obstacle_idx] > 0:\n                    is_obstacle = True\n                    break\n            \n            if not is_obstacle: # Only add if traversable\n                valid_adj_cells.append(adj_pos)\n\n        if not valid_adj_cells:\n            return None # No traversable adjacent cells to the target\n\n        while queue:\n            current_pos, path_actions = queue.popleft()\n\n            # If current_pos is one of the valid adjacent cells, we found a path\n            if current_pos in valid_adj_cells:\n                return path_actions\n\n            r, c = current_pos\n            for action, (dr, dc) in _MOVE_DELTAS.items():\n                next_r, next_c = r + dr, c + dc\n                next_pos = (next_r, next_c)\n\n                if not (0 <= next_r < rows and 0 <= next_c < cols):\n                    continue\n\n                # Check if the next cell is an obstacle for movement\n                is_obstacle = False\n                for obstacle_idx in obstacle_indices:\n                    if current_grid[next_r, next_c, obstacle_idx] > 0:\n                        is_obstacle = True\n                        break\n                if is_obstacle:\n                    continue\n\n                if next_pos not in visited:\n                    visited.add(next_pos)\n                    queue.append((next_pos, path_actions + [action]))\n        return None\n\n\n    all_actions = []\n    current_state = env._current_state \n\n    cookbook = env.world.cookbook\n    grid_shape = current_state.grid.shape\n    \n    # Obstacles for pathfinding are typically non-grabbable environment entities.\n    # Using cookbook.environment as a proxy for impassable terrain.\n    obstacle_grid_indices = cookbook.environment\n\n    # 1. Check if the item is already crafted\n    if current_state.inventory[item] > 0:\n        return all_actions # Already have it, no actions needed\n\n    # 2. Determine all primitive ingredients needed\n    # The cookbook's primitives_for method resolves all dependencies to base primitives.\n    needed_primitives = cookbook.primitives_for(item)\n\n    # Simulate agent's state (position and inventory) to plan subsequent actions\n    current_agent_pos = current_state.pos\n    simulated_inventory = np.copy(current_state.inventory)\n    \n    # Track collected items on the *simulated* grid to avoid trying to collect the same instance again.\n    # This is a simplification: a more complex planner would update the grid state.\n    collected_grid_items = set() # Stores (r, c, kind_idx) of collected instances\n\n    # 3. Collect missing primitives\n    for p_idx, p_count in needed_primitives.items():\n        while simulated_inventory[p_idx] < p_count:\n            found_item_location = None\n            best_path = None\n            min_path_len = float('inf')\n\n            # Search for the closest instance of p_idx on the grid that is collectible and not yet \"collected\"\n            for r in range(grid_shape[0]):\n                for c in range(grid_shape[1]):\n                    # Check if the primitive is at (r,c), hasn't been collected, and is grabbable.\n                    # Grabbable means it's not in the environment set (which is also non-grabbable).\n                    if current_state.grid[r, c, p_idx] > 0 and \\\n                       (r, c, p_idx) not in collected_grid_items and \\\n                       p_idx not in cookbook.environment: \n                        \n                        path_to_item_adjacent = _find_path_actions_to_adjacent(\n                            current_agent_pos, (r, c), grid_shape, obstacle_grid_indices, current_state.grid\n                        )\n                        \n                        if path_to_item_adjacent is not None:\n                            if len(path_to_item_adjacent) < min_path_len:\n                                min_path_len = len(path_to_item_adjacent)\n                                best_path = path_to_item_adjacent\n                                found_item_location = (r, c)\n            \n            if found_item_location is None:\n                # If we cannot find an available instance of a required primitive, the goal is unachievable.\n                print(f\"Warning: Cannot find enough instances of primitive {cookbook.index.get(p_idx)} on the grid.\")\n                return [] \n\n            all_actions.extend(best_path)\n            # Update current_agent_pos based on the path taken\n            if best_path:\n                current_agent_pos = (current_agent_pos[0] + sum([_MOVE_DELTAS[a][0] for a in best_path]),\n                                     current_agent_pos[1] + sum([_MOVE_DELTAS[a][1] for a in best_path]))\n            \n            all_actions.append(ACTION_USE) # Perform the \"use\" action to pick up the item\n            simulated_inventory[p_idx] += 1\n            collected_grid_items.add((found_item_location[0], found_item_location[1], p_idx)) # Mark instance as collected\n\n    # 4. Craft the final item if it's not a primitive itself\n    # Check if the goal item is listed as a primitive. If so, no crafting step is needed.\n    is_goal_a_primitive = item in cookbook.primitives\n\n    if not is_goal_a_primitive:\n        # If it's not a primitive, it must be crafted, which typically requires a workshop.\n        if not env.world.workshop_indices:\n            print(\"Warning: No workshop indices defined in CraftWorld. Cannot craft final item.\")\n            return [] \n\n        workshop_idx = env.world.workshop_indices[0] # Assume the first workshop is sufficient\n        workshop_location = None\n\n        # Find the first workshop location on the grid\n        for r in range(grid_shape[0]):\n            for c in range(grid_shape[1]):\n                if current_state.grid[r, c, workshop_idx] > 0:\n                    workshop_location = (r, c)\n                    break\n            if workshop_location:\n                break\n        \n        if workshop_location is None:\n            print(\"Warning: No workshop found on the grid to craft the final item.\")\n            return [] \n\n        # Path to a cell adjacent to the workshop\n        path_to_workshop_adjacent = _find_path_actions_to_adjacent(\n            current_agent_pos, workshop_location, grid_shape, obstacle_grid_indices, current_state.grid\n        )\n        \n        if path_to_workshop_adjacent is None:\n            print(f\"Warning: No path to workshop at {workshop_location}.\")\n            return [] \n\n        all_actions.extend(path_to_workshop_adjacent)\n        # Update current_agent_pos after pathing\n        if path_to_workshop_adjacent:\n            current_agent_pos = (current_agent_pos[0] + sum([_MOVE_DELTAS[a][0] for a in path_to_workshop_adjacent]),\n                                 current_agent_pos[1] + sum([_MOVE_DELTAS[a][1] for a in path_to_workshop_adjacent]))\n            \n        all_actions.append(ACTION_USE) # Perform the craft action at the workshop\n\n    return all_actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-29T20:53:36.089585", "function_name": "craft", "function_body": "    cookbook = env.world.cookbook\n    initial_state = env._current_state\n    \n    # Memoization for _solve_for_item results to avoid recomputing paths for the same\n    # (inventory state, item_to_get) tuple.\n    # Key: (tuple(current_inventory.tolist()), item_idx_to_get)\n    # Value: (list_of_actions, final_simulated_state)\n    _solve_item_memo = {}\n\n    def _find_path_to_adjacent(start_state, target_entity_kind_idx):\n        \"\"\"\n        Performs a Breadth-First Search (BFS) to find actions to get adjacent to a target entity kind.\n        This function only finds the path to the location, it does not perform any 'USE' action.\n        \n        Args:\n            start_state: The CraftState from which to start the search.\n            target_entity_kind_idx: The index of the entity kind to get adjacent to.\n        Returns:\n            (list_of_actions, final_state) or (None, None) if no path found.\n        \"\"\"\n        q = collections.deque([(start_state, [])])\n        # Visited set: (pos_tuple, dir_int, inventory_tuple)\n        # We include inventory because picking up items changes the state and thus subsequent paths.\n        # Grid changes (e.g., items disappearing) are handled implicitly by `state.step` returning a new state,\n        # but the full grid is not hashed to keep the visited set tractable.\n        visited = set([(start_state.pos, start_state.dir, tuple(start_state.inventory.tolist()))])\n        \n        # Heuristic: limit BFS search depth to prevent excessively long pathfinding for single adjacency\n        MAX_BFS_STEPS = 100 \n\n        while q:\n            current_state, actions_so_far = q.popleft()\n\n            # Stop if path becomes too long (heuristic)\n            if len(actions_so_far) > MAX_BFS_STEPS:\n                continue\n\n            # Goal Check: Are we already adjacent to the target_entity_kind_idx?\n            if current_state.next_to(target_entity_kind_idx):\n                return actions_so_far, current_state\n            \n            # Explore Movement Actions (UP, DOWN, LEFT, RIGHT)\n            for action in [env_factory.DOWN, env_factory.UP, env_factory.LEFT, env_factory.RIGHT]:\n                reward, next_s = current_state.step(action)\n                \n                # Check if this new state has been visited\n                next_state_key = (next_s.pos, next_s.dir, tuple(next_s.inventory.tolist()))\n                if next_state_key not in visited:\n                    visited.add(next_state_key)\n                    q.append((next_s, actions_so_far + [action]))\n        \n        return None, None # No path found\n\n    def _find_path_to_grab_item(start_state, target_item_idx):\n        \"\"\"\n        Performs a BFS to find actions to obtain a grabbable item by moving onto its cell.\n        Assumes moving onto a grabbable item automatically picks it up (handled by CraftState.step).\n        \n        Args:\n            start_state: The CraftState from which to start the search.\n            target_item_idx: The index of the item to be grabbed.\n        Returns:\n            (list_of_actions, final_state) or (None, None) if no path found.\n        \"\"\"\n        q = collections.deque([(start_state, [])])\n        visited = set([(start_state.pos, start_state.dir, tuple(start_state.inventory.tolist()))])\n        \n        original_item_count = start_state.inventory[target_item_idx]\n        MAX_BFS_STEPS = 100 # Heuristic limit\n\n        while q:\n            current_state, actions_so_far = q.popleft()\n\n            if len(actions_so_far) > MAX_BFS_STEPS:\n                continue\n\n            # Goal Check: Is the target item now in inventory (meaning it was grabbed)?\n            if current_state.inventory[target_item_idx] > original_item_count:\n                return actions_so_far, current_state\n\n            # Explore Movement Actions\n            for action in [env_factory.DOWN, env_factory.UP, env_factory.LEFT, env_factory.RIGHT]:\n                reward, next_s = current_state.step(action)\n                \n                next_state_key = (next_s.pos, next_s.dir, tuple(next_s.inventory.tolist()))\n                if next_state_key not in visited:\n                    visited.add(next_state_key)\n                    q.append((next_s, actions_so_far + [action]))\n        \n        return None, None # No path found\n\n    def _solve_for_item(current_sim_state, item_idx_to_get):\n        \"\"\"\n        Recursively finds actions to obtain item_idx_to_get starting from current_sim_state.\n        This function implements the high-level planning:\n        1. If item already in inventory, return empty actions.\n        2. If item is craftable, recursively get ingredients, then go to workshop and USE.\n        3. If item is a primitive/grabbable, find path to get it (either by moving or by USE on a source).\n\n        Args:\n            current_sim_state: The current simulated CraftState from which to plan.\n            item_idx_to_get: The integer index of the item to be obtained.\n        Returns:\n            (list_of_actions, final_simulated_state) or (None, None) if item cannot be obtained.\n        \"\"\"\n        # Base case: If the item is already in the inventory\n        if current_sim_state.inventory[item_idx_to_get] > 0:\n            return [], current_sim_state\n\n        # Check memoization: prevents redundant computation for already-solved sub-problems\n        memo_key = (tuple(current_sim_state.inventory.tolist()), item_idx_to_get)\n        if memo_key in _solve_item_memo:\n            return _solve_item_memo[memo_key]\n\n        actions_taken = []\n        # This state will be updated as sub-actions are planned and \"executed\"\n        # It's crucial that `step` returns a new state object, so direct assignment is fine.\n        state_after_sub_actions = current_sim_state \n\n        # Check if the item has a recipe (i.e., it's craftable)\n        recipe = cookbook.recipes.get(item_idx_to_get)\n\n        if recipe: # Item is craftable\n            # First, gather all required ingredients\n            for ingredient_idx, count_needed in recipe.items():\n                if ingredient_idx == cookbook.index.contents['_key']: # Skip meta-data in recipe\n                    continue\n                \n                # Determine how many units of this ingredient are still needed\n                needed_now = count_needed - state_after_sub_actions.inventory[ingredient_idx]\n                \n                # Recursively solve for each needed unit of the ingredient\n                for _ in range(needed_now):\n                    ing_actions, updated_ing_state = _solve_for_item(state_after_sub_actions, ingredient_idx)\n                    if ing_actions is None: # If an ingredient cannot be obtained, this item cannot be crafted\n                        _solve_item_memo[memo_key] = (None, None)\n                        return None, None\n                    actions_taken.extend(ing_actions)\n                    state_after_sub_actions = updated_ing_state # Update state for next ingredient/step\n            \n            # After acquiring all ingredients, navigate to a workshop and perform the USE action\n            if not env.world.workshop_indices: # No workshops exist in this world\n                _solve_item_memo[memo_key] = (None, None)\n                return None, None\n\n            # Pathfind to be adjacent to any workshop (assuming the first one is fine)\n            workshop_idx = env.world.workshop_indices[0] \n            path_to_workshop_actions, state_at_workshop = _find_path_to_adjacent(\n                state_after_sub_actions, workshop_idx\n            )\n            \n            if path_to_workshop_actions is None: # Cannot reach a workshop\n                _solve_item_memo[memo_key] = (None, None)\n                return None, None\n            \n            actions_taken.extend(path_to_workshop_actions)\n            state_after_sub_actions = state_at_workshop\n\n            # Now, at the workshop, turn to face it and USE\n            craft_successful = False\n            final_craft_state = None\n            original_inventory_at_craft_time = state_after_sub_actions.inventory[item_idx_to_get]\n\n            # Try turning in all 4 cardinal directions and performing USE\n            temp_state_for_craft_attempt = state_after_sub_actions\n            for _ in range(4): # Iterate through possible orientations (up to 3 turns)\n                # Check the cell directly in front of the agent\n                fx, fy = temp_state_for_craft_attempt.pos[0] + env_factory.DIR_TO_COORD_DELTA[temp_state_for_craft_attempt.dir][0], \\\n                         temp_state_for_craft_attempt.pos[1] + env_factory.DIR_TO_COORD_DELTA[temp_state_for_craft_attempt.dir][1]\n                \n                # Check if the cell is within grid bounds\n                if 0 <= fx < temp_state_for_craft_attempt.grid.shape[0] and 0 <= fy < temp_state_for_craft_attempt.grid.shape[1]:\n                    # If a workshop is found in front\n                    if any(temp_state_for_craft_attempt.grid[fx, fy, w_idx] > 0 for w_idx in env.world.workshop_indices):\n                        # Attempt to USE\n                        reward, next_s_after_use = temp_state_for_craft_attempt.step(env_factory.USE)\n                        # Check if crafting was successful (item appeared in inventory)\n                        if next_s_after_use.inventory[item_idx_to_get] > original_inventory_at_craft_time:\n                            actions_taken.append(env_factory.USE)\n                            final_craft_state = next_s_after_use\n                            craft_successful = True\n                            break # Craft successful, exit the turning loop\n                \n                # If not successful or not facing workshop, turn right to try next orientation\n                _, turned_s = temp_state_for_craft_attempt.step(env_factory.RIGHT)\n                actions_taken.append(env_factory.RIGHT)\n                temp_state_for_craft_attempt = turned_s\n            \n            if not craft_successful: # If crafting failed even after reaching workshop and trying all turns\n                _solve_item_memo[memo_key] = (None, None)\n                return None, None\n            \n            result = (actions_taken, final_craft_state)\n            _solve_item_memo[memo_key] = result\n            return result\n\n        elif item_idx_to_get in cookbook.primitives or item_idx_to_get in env.world.grabbable_indices:\n            # Item is a primitive resource (either grabbable by moving onto it, or requires USE on a source)\n            \n            # Case 1: Grabbable item (e.g., dirt, sapling) - can be picked up by moving onto its cell\n            if item_idx_to_get in env.world.grabbable_indices:\n                get_actions, final_get_state = _find_path_to_grab_item(\n                    state_after_sub_actions, item_idx_to_get\n                )\n                if get_actions is None:\n                    _solve_item_memo[memo_key] = (None, None)\n                    return None, None\n                \n                actions_taken.extend(get_actions)\n                result = (actions_taken, final_get_state)\n                _solve_item_memo[memo_key] = result\n                return result\n\n            # Case 2: Primitive item requiring USE (e.g., water from a water tile, stone from a stone block)\n            # This relies on the assumption that `item_idx_to_get` also represents the source entity kind\n            # (e.g., to get `water_idx`, you `USE` on a `water_idx` tile). This mapping is not explicit in schema.\n            source_entity_kind_idx = item_idx_to_get \n            \n            # Find path to be adjacent to the source entity\n            path_to_source_actions, state_at_source = _find_path_to_adjacent(\n                state_after_sub_actions, source_entity_kind_idx\n            )\n            \n            if path_to_source_actions is None: # Cannot reach the source\n                _solve_item_memo[memo_key] = (None, None)\n                return None, None\n            \n            actions_taken.extend(path_to_source_actions)\n            state_after_sub_actions = state_at_source\n\n            # Now adjacent to the source, turn and USE to obtain the item\n            get_successful = False\n            final_get_state = None\n            original_inventory_at_get_time = state_after_sub_actions.inventory[item_idx_to_get]\n            \n            temp_state_for_get_attempt = state_after_sub_actions\n            for _ in range(4): # Try all 4 orientations\n                # Check cell in front for the source entity\n                fx, fy = temp_state_for_get_attempt.pos[0] + env_factory.DIR_TO_COORD_DELTA[temp_state_for_get_attempt.dir][0], \\\n                         temp_state_for_get_attempt.pos[1] + env_factory.DIR_TO_COORD_DELTA[temp_state_for_get_attempt.dir][1]\n                \n                if 0 <= fx < temp_state_for_get_attempt.grid.shape[0] and 0 <= fy < temp_state_for_get_attempt.grid.shape[1]:\n                    # If the source entity is found in front\n                    if temp_state_for_get_attempt.grid[fx, fy, source_entity_kind_idx] > 0:\n                        reward, next_s_after_use = temp_state_for_get_attempt.step(env_factory.USE)\n                        if next_s_after_use.inventory[item_idx_to_get] > original_inventory_at_get_time:\n                            actions_taken.append(env_factory.USE)\n                            final_get_state = next_s_after_use\n                            get_successful = True\n                            break # Item obtained, exit turning loop\n                \n                # If not successful or not facing source, turn right\n                _, turned_s = temp_state_for_get_attempt.step(env_factory.RIGHT)\n                actions_taken.append(env_factory.RIGHT)\n                temp_state_for_get_attempt = turned_s\n\n            if not get_successful: # Failed to get item after reaching source and trying all turns\n                _solve_item_memo[memo_key] = (None, None)\n                return None, None\n            \n            result = (actions_taken, final_get_state)\n            _solve_item_memo[memo_key] = result\n            return result\n        else:\n            # Item is neither craftable nor a known primitive/grabbable.\n            _solve_item_memo[memo_key] = (None, None)\n            return None, None\n\n    # Start the recursive planning from the initial state of the environment\n    final_actions, _ = _solve_for_item(initial_state, item)\n    return final_actions if final_actions is not None else []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-29T20:54:31.281920", "function_name": "craft", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants (corresponding to env_factory.ACTIONS values)\n  # DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  _ACTIONS = [0, 1, 2, 3, 4]\n\n  # Use a deque for BFS queue\n  queue = collections.deque()\n  # Use a set to store visited states (hashable representation)\n  visited = set()\n\n  # Get the initial CraftState from the CraftLab environment\n  initial_state = env._current_state\n\n  # Helper function to create a hashable representation of a CraftState\n  # This is crucial for checking if a state has been visited to avoid cycles\n  # and redundant exploration.\n  def _hash_state(state):\n      # Convert numpy arrays (grid, inventory) to bytes for efficient hashing.\n      # Other attributes (pos, dir) are already hashable (tuple, int).\n      return (state.grid.tobytes(), state.pos, state.dir, state.inventory.tobytes())\n\n  # Add the initial state to the queue and visited set\n  initial_hash = _hash_state(initial_state)\n  queue.append((initial_state, []))  # (current_CraftState_object, actions_path_to_current_state)\n  visited.add(initial_hash)\n\n  # The target item index for the goal\n  goal_item_idx = item\n\n  # BFS loop\n  while queue:\n      current_state, current_path = queue.popleft()\n\n      # Check if the goal is satisfied in the current state\n      # CraftState.satisfies expects a goal_name (ignored) and goal_arg (item index).\n      if current_state.satisfies(None, goal_item_idx):\n          return current_path\n\n      # Explore all possible next states by trying each action\n      for action in _ACTIONS:\n          # Simulate the action to get the next state.\n          # CraftState.step returns (reward, new_state). We only need new_state for planning.\n          _reward, next_state = current_state.step(action)\n\n          next_hash = _hash_state(next_state)\n\n          # If this next state has not been visited, add it to the queue and visited set.\n          if next_hash not in visited:\n              visited.add(next_hash)\n              queue.append((next_state, current_path + [action]))\n\n  # If the queue becomes empty and the goal was not reached,\n  # it means the item is uncraftable or unreachable from the initial state within\n  # the explored state space.\n  return []", "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-07-29T20:54:32.256496", "function_name": "craft", "function_body": "  import collections\n\n  # Action constants are defined within the function, assuming env_factory is\n  # available in the scope where this function will be executed.\n  # The problem description's file structure places 'import env_factory' after\n  # function definitions, so it's safer to define ACTIONS within the function.\n  ACTIONS = [\n      env_factory.ACTION_DOWN,\n      env_factory.ACTION_UP,\n      env_factory.ACTION_LEFT,\n      env_factory.ACTION_RIGHT,\n      env_factory.ACTION_USE\n  ]\n\n  # Get the initial state from the CraftLab environment.\n  # env._current_state holds the CraftState object representing the current state.\n  initial_craft_state = env._current_state\n\n  # If the item is already in the inventory, no actions are needed.\n  if initial_craft_state.satisfies(None, item):\n    return []\n\n  # Initialize a BFS queue. Each element is a tuple:\n  # (CraftState object, list of actions taken to reach this state)\n  queue = collections.deque([(initial_craft_state, [])])\n  \n  # Initialize a set to keep track of visited states to prevent cycles and\n  # redundant exploration. States are represented as immutable tuples of\n  # (grid_bytes, position_tuple, direction_int, inventory_bytes).\n  visited = set()\n  \n  # Add the initial state to the visited set.\n  initial_state_representation = (\n      initial_craft_state.grid.tobytes(),\n      initial_craft_state.pos,\n      initial_craft_state.dir,\n      initial_craft_state.inventory.tobytes()\n  )\n  visited.add(initial_state_representation)\n\n  # Perform BFS\n  while queue:\n    current_state, path_to_current_state = queue.popleft()\n\n    # Explore all possible actions from the current state\n    for action in ACTIONS:\n      # Apply the action to get the next state.\n      # CraftState.step returns (reward, new_state). We only need the new_state.\n      # Importantly, CraftState.step returns a *new* CraftState object,\n      # ensuring that the state in the queue remains unchanged.\n      _, next_state = current_state.step(action)\n\n      # Create an immutable representation of the next state for the visited set.\n      next_state_representation = (\n          next_state.grid.tobytes(),\n          next_state.pos,\n          next_state.dir,\n          next_state.inventory.tobytes()\n      )\n\n      # If this next state has not been visited before, explore it.\n      if next_state_representation not in visited:\n        visited.add(next_state_representation)\n        new_path = path_to_current_state + [action]\n\n        # Check if the goal (item crafted) is satisfied in the new state.\n        if next_state.satisfies(None, item):\n          return new_path  # Goal found, return the sequence of actions.\n        \n        # Add the new state and its path to the queue for further exploration.\n        queue.append((next_state, new_path))\n  \n  # If the queue is exhausted and the goal was never reached,\n  # it means the item cannot be crafted from the current state.\n  return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-29T20:57:02.075686", "function_name": "craft", "function_body": "  import collections\n  import numpy as np\n\n  # Assuming these action constants based on typical DMLab interface and problem description.\n  # The problem lists actions as \"DOWN, UP, LEFT, RIGHT, USE\".\n  # We assume a standard numerical mapping for these actions.\n  ACTIONS = {\n      'DOWN': 0,\n      'UP': 1,\n      'LEFT': 2,\n      'RIGHT': 3,\n      'USE': 4\n  }\n\n  # A helper function for Breadth-First Search (BFS) based pathfinding.\n  # This function finds a path for the agent to get adjacent to a `target_kind_idx` on the grid\n  # and then performs a specified `action_to_take_at_target` (e.g., ACTIONS['USE']).\n  # It simulates the state changes during movement to ensure the path is valid.\n  def find_path_to_kind_and_interact(start_state, target_kind_idx, action_to_take_at_target):\n      q = collections.deque([(start_state, [])]) # Queue: (current_CraftState, list_of_actions_taken_to_reach_here)\n      visited_states = set() # To store (pos_x, pos_y, dir_val) to avoid redundant paths and cycles\n\n      # Helper to create a hashable representation of the relevant parts of the state for the visited set.\n      # For pathfinding, we only care about position and direction, not inventory or grid contents,\n      # as those are handled by the outer loop's state updates.\n      def get_pos_dir_hash(state):\n          return (state.pos[0], state.pos[1], state.dir)\n\n      initial_hash = get_pos_dir_hash(start_state)\n      visited_states.add(initial_hash)\n\n      MAX_PATH_STEPS = 100 # Arbitrary limit to prevent excessively long or infinite searches\n\n      while q:\n          current_s, current_path_actions = q.popleft()\n\n          # If the agent is currently next to the target kind, we have found a path.\n          # Now, perform the final interaction action.\n          if current_s.next_to(target_kind_idx):\n              # Simulate the final action (e.g., 'USE' on a primitive or workshop).\n              # CraftState.step returns (reward, new_state).\n              _reward, final_s = current_s.step(action_to_take_at_target)\n              return current_path_actions + [action_to_take_at_target], final_s\n\n          # Prune paths that exceed the maximum allowed length to manage computation time.\n          if len(current_path_actions) >= MAX_PATH_STEPS:\n              continue\n\n          # Explore possible movement actions: UP, DOWN, LEFT, RIGHT.\n          for action_name in ['UP', 'DOWN', 'LEFT', 'RIGHT']:\n              action = ACTIONS[action_name]\n              \n              # Simulate the effect of taking this action to get the next state.\n              _reward, next_s = current_s.step(action)\n              next_pos_dir_hash = get_pos_dir_hash(next_s)\n\n              # If this new state (position and direction) hasn't been visited before,\n              # add it to the queue for exploration.\n              if next_pos_dir_hash not in visited_states:\n                  visited_states.add(next_pos_dir_hash)\n                  q.append((next_s, current_path_actions + [action]))\n      \n      # If the queue becomes empty and no path to the target was found, return None.\n      return None, None \n  \n  # --- Main Crafting Logic for craft_v2 ---\n  total_actions = []\n  \n  # Get the initial state of the environment from the CraftLab instance.\n  current_simulated_state = env._current_state \n\n  # Optimization: If the target item is already in the inventory, no actions are needed.\n  if current_simulated_state.inventory[item] > 0:\n      return []\n\n  # Determine all primitive resources needed to craft the target item.\n  # The `Cookbook.primitives_for` method is crucial here, as it recursively\n  # calculates the total primitive ingredients for complex recipes.\n  primitive_needs = env.world.cookbook.primitives_for(item)\n\n  # Handle special cases for `primitives_for` returning an empty dictionary:\n  # 1. The target `item` might itself be a primitive (e.g., 'stone', 'wood').\n  # 2. The target `item` might have no recipe and is not a primitive (unachievable).\n  if not primitive_needs:\n      if item in env.world.cookbook.primitives:\n          # If the item is a primitive itself, we just need one unit of it.\n          primitive_needs = {item: 1}\n      else:\n          # If the item is neither craftable via recipes nor a primitive, it's unachievable.\n          return [] \n  \n  # --- Phase 1: Collect all required primitive resources ---\n  # Iterate through each primitive type and its required count.\n  for p_idx, needed_count in primitive_needs.items():\n      # Continue collecting this specific primitive until the required quantity is in inventory.\n      while current_simulated_state.inventory[p_idx] < needed_count:\n          # Find a path to the primitive resource on the grid and then 'USE' it to collect.\n          path_to_primitive, state_after_collection = find_path_to_kind_and_interact(\n              current_simulated_state, p_idx, ACTIONS['USE']\n          )\n\n          # If the primitive cannot be reached or collected, the overall goal is unachievable.\n          if path_to_primitive is None:\n              return [] \n          \n          # Add the actions for collecting this primitive to the total action sequence.\n          total_actions.extend(path_to_primitive)\n          # Update the simulated state to reflect the inventory change after collection.\n          current_simulated_state = state_after_collection\n  \n  # --- Phase 2: Craft the final item at a workshop ---\n  workshop_index = None\n  # Check if there are any workshop locations defined in the world.\n  if env.world.workshop_indices:\n      # For simplicity, we assume the first workshop found is suitable for all crafting.\n      workshop_index = env.world.workshop_indices[0] \n  \n  # If no workshop exists, crafting is impossible.\n  if workshop_index is None:\n      return []\n\n  # Find a path to the workshop and then 'USE' it to initiate the crafting process.\n  crafting_actions, final_state_after_crafting = find_path_to_kind_and_interact(\n      current_simulated_state, workshop_index, ACTIONS['USE']\n  )\n\n  # If the workshop cannot be reached, the goal is unachievable.\n  if crafting_actions is None:\n      return []\n\n  # Add the crafting actions to the total sequence.\n  total_actions.extend(crafting_actions)\n\n  # Final verification: Check if the target item is successfully in the inventory\n  # of the final simulated state. This confirms successful crafting.\n  if final_state_after_crafting.inventory[item] > 0:\n      return total_actions\n  else:\n      # If the item was not crafted, despite collecting ingredients and reaching a workshop,\n      # it suggests a more complex game rule not captured (e.g., specific workshop types,\n      # or limits not explicitly modeled). In this case, the goal is considered unachievable\n      # with this planning strategy.\n      return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-29T20:57:02.144800", "function_name": "craft", "function_body": "    import collections\n\n    # Get the number of possible actions from the environment's specification.\n    # Based on CraftLab.action_specs, this will be 5 (DOWN, UP, LEFT, RIGHT, USE).\n    N_ACTIONS = len(env.action_specs()) \n\n    # Re-initialize the environment to a known initial state before starting the search.\n    # The 'seed=0' is used to ensure a consistent starting point for the agent's state\n    # within the pre-configured scenario.\n    _ = env.reset(seed=0)\n    initial_state = env._current_state\n\n    # BFS Queue: stores tuples of (current_CraftState_object, list_of_actions_taken_to_reach_it).\n    queue = collections.deque([(initial_state, [])])\n\n    # Visited set: stores hashable representations of states to prevent infinite loops\n    # and redundant exploration. A state is uniquely identified by its position, direction,\n    # current inventory, and the layout of the grid.\n    visited = set()\n    \n    # Define a maximum path length to limit the search depth. This prevents\n    # excessively long action sequences and bounds the computation time for impossible goals.\n    MAX_PATH_LENGTH = 100 \n\n    while queue:\n        current_state, current_actions = queue.popleft()\n\n        # Pruning: If the current path has exceeded the maximum allowed length, discard it.\n        if len(current_actions) >= MAX_PATH_LENGTH:\n            continue\n\n        # Generate a hashable representation of the current state.\n        # NumPy arrays (grid, inventory) must be converted to bytes using .tobytes() for hashing.\n        state_hash = (current_state.pos, current_state.dir, \n                      current_state.inventory.tobytes(), current_state.grid.tobytes())\n\n        # Check if this state has been visited before. If so, skip to avoid cycles and redundant work.\n        if state_hash in visited:\n            continue\n        visited.add(state_hash)\n\n        # Check if the current state satisfies the crafting goal.\n        # `current_state.satisfies(goal_name, goal_arg)` checks if `inventory[goal_arg] > 0`.\n        # `goal_name` is ignored in this implementation, so we pass None.\n        if current_state.satisfies(None, item):\n            return current_actions # Goal reached, return the sequence of actions.\n\n        # Explore all possible next states by applying each valid action.\n        # Actions range from 0 to N_ACTIONS-1 (e.g., DOWN, UP, LEFT, RIGHT, USE).\n        for action in range(N_ACTIONS): \n            # Simulate the action. `current_state.step(action)` returns a new CraftState object,\n            # representing the state after the action.\n            # The reward is always 0.0 in this specific CraftState implementation, so it's ignored.\n            _reward, next_state = current_state.step(action)\n\n            # Add the new state and the extended action sequence to the queue for future exploration.\n            queue.append((next_state, current_actions + [action]))\n\n    # If the queue becomes empty and the goal was never reached, it implies\n    # that the item cannot be crafted from the initial scenario under the given constraints\n    # (or within the `MAX_PATH_LENGTH`).\n    return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-29T20:58:47.795820", "function_name": "craft", "function_body": "  import collections\n\n  # Define action constants (assuming these mappings from CraftLab.action_specs)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n\n  def _execute_path_and_update_state(state, actions_list):\n      \"\"\"Helper to apply a list of actions and return the new state and full action list.\"\"\"\n      current_state = state\n      total_actions_executed_in_this_segment = []\n      for action in actions_list:\n          _reward, current_state = current_state.step(action)\n          total_actions_executed_in_this_segment.append(action)\n      return current_state, total_actions_executed_in_this_segment\n\n\n  def _find_item_path(current_state, target_kind_idx, blocked_kinds_set):\n      \"\"\"\n      Finds a path (list of actions) from the agent's current position to a cell\n      adjacent to an instance of target_kind_idx. Uses BFS.\n      Returns (target_location_on_grid, path_actions) or (None, []).\n      \"\"\"\n      grid = current_state.grid\n      width, height, _ = grid.shape\n      start_pos = current_state.pos\n\n      # BFS queue: (current_pos, path_actions)\n      q = collections.deque([(start_pos, [])])\n\n      # Visited set: (x, y) to prevent cycles\n      visited = {start_pos}\n\n      # Directions for movement: (dx, dy, action) assuming (0,0) is top-left\n      moves = {\n          UP: (0, -1),\n          DOWN: (0, 1),\n          LEFT: (-1, 0),\n          RIGHT: (1, 0)\n      }\n\n      # First, find all locations on the grid where the target item might be\n      target_item_locations = []\n      for x in range(width):\n          for y in range(height):\n              if grid[x, y, target_kind_idx] == 1:\n                  target_item_locations.append((x, y))\n\n      if not target_item_locations:\n          return None, []  # Target item not found on the grid\n\n      # BFS for pathfinding\n      while q:\n          (curr_x, curr_y), path = q.popleft()\n\n          # Check if the current position is adjacent to any target item location\n          for tx, ty in target_item_locations:\n              # Check adjacency using Manhattan distance (abs(dx) + abs(dy) == 1)\n              if abs(curr_x - tx) + abs(curr_y - ty) == 1:\n                  # Found a path to a cell adjacent to the target!\n                  # Return the specific target item's location and the path to the adjacent cell.\n                  return (tx, ty), path\n\n          # Explore neighbors\n          for action, (dx, dy) in moves.items():\n              next_x, next_y = curr_x + dx, curr_y + dy\n\n              # Check bounds\n              if 0 <= next_x < width and 0 <= next_y < height:\n                  next_pos = (next_x, next_y)\n\n                  # Check if the next cell is blocked by non-grabbable entities\n                  is_blocked = False\n                  for k in blocked_kinds_set:\n                      if grid[next_x, next_y, k] == 1:\n                          is_blocked = True\n                          break\n\n                  if not is_blocked and next_pos not in visited:\n                      visited.add(next_pos)\n                      q.append((next_pos, path + [action]))\n\n      return None, []  # No path found to any cell adjacent to the target\n\n\n  world = env.world\n  cookbook = world.cookbook\n  initial_state = env._current_state\n\n  # This list will accumulate all actions required for the entire crafting process\n  all_actions = []\n\n  def _obtain_item_recursive(current_state_in_plan, target_item_idx):\n      nonlocal all_actions # Allows modification of the 'all_actions' list from outer scope\n\n      # 1. Check if the item is already in the agent's inventory in the current planning state\n      if current_state_in_plan.inventory[target_item_idx] > 0:\n          return current_state_in_plan  # Item is already obtained, no actions needed for this specific goal\n\n      # 2. Determine if the target item is a primitive resource or a crafted item\n      recipe = cookbook.recipes.get(target_item_idx)\n\n      if target_item_idx in cookbook.primitives:\n          # If it's a primitive, the agent needs to find it on the grid and pick it up.\n          target_loc_on_grid, path_actions = _find_item_path(current_state_in_plan, target_item_idx, world.non_grabbable_indices)\n          \n          if not path_actions: # If no path is found (e.g., item not on map, or unreachable)\n              return None  # Cannot obtain this primitive\n\n          # Execute the path actions and update the current state in the planning simulation\n          current_state_in_plan, path_actions_executed = _execute_path_and_update_state(current_state_in_plan, path_actions)\n          all_actions.extend(path_actions_executed) # Add these movement actions to the global list\n\n          # Agent is now adjacent to the primitive. Execute the USE action.\n          _reward, new_state = current_state_in_plan.step(USE)\n          all_actions.append(USE) # Add USE action to the global list\n          current_state_in_plan = new_state # Update state after USE\n\n          # Verify if the item was successfully picked up\n          if current_state_in_plan.inventory[target_item_idx] > 0:\n              return current_state_in_plan # Successfully obtained\n          else:\n              return None  # Failed to pick up the item (e.g., incorrect USE logic or full inventory)\n\n      elif recipe:  # If it's a crafted item (has a recipe)\n          # First, ensure all necessary ingredients are in the inventory.\n          # Iterate through recipe ingredients, recursively calling _obtain_item_recursive for each.\n          current_recipe_needs = {k: v for k, v in recipe.items() if k != \"_key\"} # Exclude special \"_key\" for workshop\n\n          for ingredient_idx, count_needed in current_recipe_needs.items():\n              while current_state_in_plan.inventory[ingredient_idx] < count_needed:\n                  # Recursively try to obtain the required ingredient\n                  updated_state_after_ingredient = _obtain_item_recursive(current_state_in_plan, ingredient_idx)\n                  if updated_state_after_ingredient is None:\n                      # If any ingredient cannot be obtained, this crafting path fails\n                      return None\n                  current_state_in_plan = updated_state_after_ingredient # Update state after ingredient acquisition\n\n          # All ingredients are now in inventory. Proceed to crafting.\n          workshop_idx = None\n          if \"_key\" in recipe: # Check if a specific workshop is required\n              workshop_name = recipe[\"_key\"]\n              workshop_idx = cookbook.index[workshop_name] # Get the index for the workshop\n\n          if workshop_idx is not None:\n              # If a workshop is required, path to it\n              target_loc_on_grid, path_actions = _find_item_path(current_state_in_plan, workshop_idx, world.non_grabbable_indices)\n              if not path_actions:\n                  return None  # Cannot reach the required workshop\n\n              current_state_in_plan, path_actions_executed = _execute_path_and_update_state(current_state_in_plan, path_actions)\n              all_actions.extend(path_actions_executed) # Add these movement actions\n\n          # Agent is now in position (adjacent to workshop, or anywhere if no workshop is needed).\n          # Execute the USE action to craft the item.\n          _reward, new_state = current_state_in_plan.step(USE)\n          all_actions.append(USE) # Add USE action\n          current_state_in_plan = new_state # Update state after USE\n\n          # Verify if the item was successfully crafted\n          if current_state_in_plan.inventory[target_item_idx] > 0:\n              return current_state_in_plan # Successfully crafted\n          else:\n              return None  # Crafting failed (e.g., wrong location, or internal game logic failure)\n\n      else:\n          # The item is neither a primitive nor has a recipe. It cannot be obtained by the agent.\n          return None\n\n  # Start the recursive planning process from the initial state\n  final_state_after_plan = _obtain_item_recursive(initial_state, item)\n\n  if final_state_after_plan is not None:\n      return all_actions # Return the complete list of actions if successful\n  else:\n      return [] # Return empty list if the item cannot be crafted/obtained", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-07-29T20:58:48.822981", "function_name": "craft", "function_body": "  start_state = env._current_state\n  \n  # Check if the goal item is already present in the initial inventory.\n  if start_state.satisfies(None, item):\n      return []\n\n  # Get action integer mappings from the environment's action_specs.\n  # This ensures compatibility with the specific action mapping of the CraftLab instance.\n  action_map = env.action_specs()\n  ACTIONS = [\n      action_map['DOWN'],\n      action_map['UP'],\n      action_map['LEFT'],\n      action_map['RIGHT'],\n      action_map['USE']\n  ]\n\n  # Helper function to create a hashable representation of a CraftState.\n  # This is crucial for using states in a `set` for visited tracking in BFS.\n  # Using .tobytes() for NumPy arrays is efficient and reliable for hashing their content.\n  def get_hashable_state(state):\n      return (\n          state.grid.tobytes(),     # Current grid layout as bytes\n          state.pos,                # Agent's (x, y) position tuple\n          state.dir,                # Agent's facing direction integer\n          state.inventory.tobytes() # Agent's inventory counts as bytes\n      )\n\n  queue = collections.deque()\n  visited = set()\n\n  # Each element in the queue is a tuple: (current_CraftState, list_of_actions_to_reach_this_state).\n  initial_hashable_state = get_hashable_state(start_state)\n  queue.append((start_state, []))\n  visited.add(initial_hashable_state)\n\n  # Define a maximum search depth to prevent excessively long computations\n  # or out-of-memory errors for very complex or unsolvable goals.\n  # This value may need tuning based on typical map sizes and recipe complexities.\n  MAX_SEARCH_DEPTH = 200 # A reasonable heuristic for typical CraftWorld scenarios\n\n  while queue:\n      current_craft_state, current_path = queue.popleft()\n\n      # If the current path length exceeds the maximum allowed search depth,\n      # stop exploring this path. This prunes the search tree.\n      if len(current_path) >= MAX_SEARCH_DEPTH:\n          continue\n\n      for action in ACTIONS:\n          # Simulate the action to get the next state.\n          # CraftState.step returns (reward, new_state). We only care about new_state here.\n          _, next_craft_state = current_craft_state.step(action)\n          \n          next_hashable_state = get_hashable_state(next_craft_state)\n\n          # If this new state has not been visited before (or visited with a longer path,\n          # which BFS implicitly handles by processing shortest paths first), add it to the queue.\n          if next_hashable_state not in visited:\n              visited.add(next_hashable_state)\n              new_path = current_path + [action]\n\n              # Check if the goal is satisfied in this newly generated state.\n              # If satisfied, this is the shortest path found (due to BFS property).\n              if next_craft_state.satisfies(None, item):\n                  return new_path\n              \n              # If not the goal, add the new state to the queue for further exploration.\n              queue.append((next_craft_state, new_path))\n  \n  # If the queue becomes empty and the goal was never satisfied, it means no path\n  # was found within the defined search limits, or the goal is genuinely unreachable.\n  return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-29T21:00:32.766848", "function_name": "craft", "function_body": "  # Get the initial state from the environment\n  # CraftLab (env) holds the current state in its _current_state attribute.\n  initial_state = env._current_state\n\n  # Check if the item is already crafted in the initial state.\n  if initial_state.satisfies(None, item):\n    return []  # Item already in inventory, no actions needed.\n\n  q = collections.deque()\n  # The queue stores tuples of (CraftState_instance, list_of_actions_taken_to_reach_this_state).\n  q.append((initial_state, []))\n\n  visited = set()\n  # The visited set stores canonical representations of states to avoid revisiting them,\n  # preventing infinite loops and redundant computation.\n  # A canonical representation for a CraftState is a tuple of (grid_bytes, inventory_bytes, pos, dir).\n\n  def get_state_key(state):\n    # Convert grid and inventory numpy arrays to bytes for hashing.\n    # .tobytes() requires arrays to be C-contiguous, which they typically are from CraftState.\n    grid_bytes = state.grid.tobytes()\n    inventory_bytes = state.inventory.tobytes()\n    return (grid_bytes, inventory_bytes, state.pos, state.dir)\n\n  # Add the initial state to the visited set.\n  visited.add(get_state_key(initial_state))\n\n  # Define possible actions based on CraftLab's action_specs (0 for DOWN, 1 for UP, etc.).\n  # These constants are expected to be available from the env_factory module.\n  actions = [env_factory.DOWN, env_factory.UP, env_factory.LEFT,\n             env_factory.RIGHT, env_factory.USE]\n\n  # Set a maximum search depth to prevent excessive computation or memory usage\n  # in case a path is very long or unreachable. This is a heuristic value.\n  MAX_SEARCH_DEPTH = 100\n\n  while q:\n    current_state, path_actions = q.popleft()\n\n    # Prune paths that exceed the maximum allowed depth.\n    if len(path_actions) >= MAX_SEARCH_DEPTH:\n      continue  # Skip this path, it's too long.\n\n    for action in actions:\n      # Apply the action to get the next state.\n      # CraftState.step returns (reward, new_state).\n      # The reward is always 0.0 in this implementation, so we ignore it.\n      _reward, next_state = current_state.step(action)\n      new_path_actions = path_actions + [action]\n\n      # Check if the goal (item) is satisfied in the new state.\n      if next_state.satisfies(None, item):\n        return new_path_actions\n\n      # Get the canonical key for the new state.\n      next_state_key = get_state_key(next_state)\n\n      # If this state has not been visited, add it to the queue and the visited set.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, new_path_actions))\n\n  # If the queue becomes empty and the goal was not reached, it means\n  # no path exists within the defined search limits.\n  return []  # No path found.", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-29T21:00:32.839040", "function_name": "craft", "function_body": "    import collections\n    import numpy as np\n\n    # Action mappings\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n    MOVE_ACTIONS = [DOWN, UP, LEFT, RIGHT]\n\n    # Direction mappings (agent's facing direction)\n    DIR_NORTH = 0  # Agent faces North (Up on grid)\n    DIR_EAST = 1   # Agent faces East (Right on grid)\n    DIR_SOUTH = 2  # Agent faces South (Down on grid)\n    DIR_WEST = 3   # Agent faces West (Left on grid)\n\n    # Change in (x, y) for each absolute movement action\n    _ACTION_DELTAS = {\n        DOWN: (0, 1),   # Move one cell South (y+1)\n        UP: (0, -1),    # Move one cell North (y-1)\n        LEFT: (-1, 0),  # Move one cell West (x-1)\n        RIGHT: (1, 0),  # Move one cell East (x+1)\n    }\n\n    # Mapping relative target position (dx, dy) to the required agent facing direction\n    # Example: If target is (0, -1) relative to agent (i.e., North of agent), agent must face North (DIR_NORTH)\n    _TARGET_RELATIVE_TO_DIR = {\n        (0, -1): DIR_NORTH,\n        (1, 0): DIR_EAST,\n        (0, 1): DIR_SOUTH,\n        (-1, 0): DIR_WEST,\n    }\n\n    # Mapping movement action to the direction it sets the agent's facing direction\n    _ACTION_TO_FINAL_DIR = {\n        UP: DIR_NORTH,\n        RIGHT: DIR_EAST,\n        DOWN: DIR_SOUTH,\n        LEFT: DIR_WEST,\n    }\n\n    def _simulate_actions(initial_state, actions):\n        # type: (CraftState, list[int]) -> CraftState\n        \"\"\"\n        Simulates a sequence of actions on a CraftState and returns the resulting state.\n        CraftState.step returns a new state object, so no deep copy needed initially.\n        \"\"\"\n        current_state = initial_state\n        for action in actions:\n            # Rewards are ignored for planning purposes\n            _, current_state = current_state.step(action)\n        return current_state\n\n    def _get_path_and_use_actions(current_state, target_kind_idx):\n        # type: (CraftState, int) -> list[int] | None\n        \"\"\"\n        Finds the shortest path of actions to move the agent to a cell adjacent\n        to an instance of `target_kind_idx`, turn to face it, and then perform a USE action.\n        Returns the list of actions or None if no such path is found.\n        \"\"\"\n        grid = current_state.grid\n        width, height, _ = grid.shape\n\n        # 1. Find all grid locations where the target_kind_idx exists.\n        target_locs = []\n        for x in range(width):\n            for y in range(height):\n                if grid[x, y, target_kind_idx] > 0:\n                    target_locs.append((x, y))\n\n        if not target_locs:\n            return None # Target item/workshop not found on the grid\n\n        # 2. Determine all valid (adjacent_x, adjacent_y, required_facing_direction) states\n        #    that would allow using a target_kind_idx instance.\n        target_final_states = set() # Stores (adj_x, adj_y, required_dir)\n        for tx, ty in target_locs:\n            for dx, dy in _ACTION_DELTAS.values(): # Iterate over offsets for adjacent cells\n                adj_x, adj_y = tx + dx, ty + dy\n                \n                # Check bounds\n                if not (0 <= adj_x < width and 0 <= adj_y < height):\n                    continue\n                \n                # Check if the adjacent cell is walkable (agent cannot move onto non-grabbable items like workshops)\n                is_walkable = True\n                for kind_idx in current_state.world.non_grabbable_indices:\n                    if grid[adj_x, adj_y, kind_idx] > 0:\n                        is_walkable = False\n                        break\n                if not is_walkable:\n                    continue\n                \n                # Calculate relative position of the target from this adjacent cell\n                rel_dx, rel_dy = tx - adj_x, ty - adj_y\n                required_dir = _TARGET_RELATIVE_TO_DIR.get((rel_dx, rel_dy))\n                if required_dir is not None:\n                    target_final_states.add((adj_x, adj_y, required_dir))\n        \n        if not target_final_states:\n            return None # No valid adjacent cells or facing directions found\n\n        # 3. Perform a Breadth-First Search (BFS) to find the shortest path to any\n        #    of the `target_final_states`.\n        # BFS Queue: stores (current_pos, current_dir, list_of_actions_to_reach_here)\n        q = collections.deque([(current_state.pos, current_state.dir, [])])\n        # Visited set: stores (x, y, dir) to prevent cycles and redundant exploration\n        visited = set([(current_state.pos[0], current_state.pos[1], current_state.dir)])\n\n        while q:\n            (curr_x, curr_y), curr_dir, path_actions = q.popleft()\n\n            # If the current state (position and direction) matches a desired target_final_state,\n            # we've found a path. Since it's BFS, this is the shortest.\n            if (curr_x, curr_y, curr_dir) in target_final_states:\n                return path_actions + [USE] # Add the final USE action and return\n\n            # Explore possible next states by trying all movement actions\n            for action_to_move in MOVE_ACTIONS:\n                new_x, new_y = curr_x + _ACTION_DELTAS[action_to_move]\n                new_dir = _ACTION_TO_FINAL_DIR[action_to_move] # Agent's direction changes based on move action\n\n                # Check bounds\n                if not (0 <= new_x < width and 0 <= new_y < height):\n                    continue\n\n                # Check if the new cell is walkable\n                is_walkable = True\n                for kind_idx in current_state.world.non_grabbable_indices:\n                    if grid[new_x, new_y, kind_idx] > 0:\n                        is_walkable = False\n                        break\n                if not is_walkable:\n                    continue\n\n                # If this state (pos, dir) has not been visited, add it to queue\n                if (new_x, new_y, new_dir) not in visited:\n                    visited.add((new_x, new_y, new_dir))\n                    q.append(((new_x, new_y), new_dir, path_actions + [action_to_move]))\n        \n        return None # No path found to any target_final_state\n\n    def _recursive_plan(target_item_idx, current_state, visited_goals):\n        # type: (int, CraftState, set[int]) -> tuple[bool, list[int]]\n        \"\"\"\n        Recursively plans actions to achieve a target item.\n        Uses a depth-first search approach combined with BFS for movement.\n        Returns a tuple: (success_boolean, list_of_actions).\n        `visited_goals` is used for cycle detection in recipe dependencies.\n        \"\"\"\n        # Base Case 1: The item is already in the inventory.\n        if current_state.inventory[target_item_idx] > 0:\n            return True, []\n\n        # Base Case 2: Cycle detection. If we are trying to get an item that is\n        # already in the current recursion stack, it indicates a cyclic dependency\n        # or an impossible goal given current resources.\n        if target_item_idx in visited_goals:\n            return False, []\n        \n        # Add current target to visited set for this recursion branch\n        new_visited_goals = visited_goals.union({target_item_idx})\n        \n        cookbook = env.world.cookbook # Access the cookbook for recipes and primitives\n\n        # Option 1: The target item is a primitive (can be picked up from the grid).\n        if target_item_idx in cookbook.primitives:\n            actions_to_pickup = _get_path_and_use_actions(current_state, target_item_idx)\n            if actions_to_pickup is not None:\n                # Simulate the pickup to update inventory for subsequent planning steps\n                next_state = _simulate_actions(current_state, actions_to_pickup)\n                if next_state.inventory[target_item_idx] > 0: # Verify pickup was successful\n                    return True, actions_to_pickup\n        \n        # Option 2: The target item can be crafted via a recipe.\n        if target_item_idx in cookbook.recipes:\n            recipe = cookbook.recipes[target_item_idx]\n            \n            all_ingredient_actions = []\n            temp_state = current_state # State that updates as ingredients are acquired\n            \n            # Sub-goal: Acquire all required ingredients\n            ingredients_satisfied = True\n            for ingr_idx_or_key, count in recipe.items():\n                if ingr_idx_or_key == \"_key\": # Skip the workshop key for now\n                    continue\n                \n                # Determine how many more of this ingredient are needed\n                needed_count = max(0, int(count) - temp_state.inventory[int(ingr_idx_or_key)])\n\n                # Recursively plan to get each needed instance of the ingredient\n                for _ in range(needed_count):\n                    success, actions_for_ingr = _recursive_plan(int(ingr_idx_or_key), temp_state, new_visited_goals)\n                    if not success:\n                        ingredients_satisfied = False\n                        break # Cannot get this ingredient, so this recipe path fails\n                    \n                    all_ingredient_actions.extend(actions_for_ingr)\n                    # Update the temporary state after successfully acquiring an ingredient\n                    temp_state = _simulate_actions(temp_state, actions_for_ingr)\n                \n                if not ingredients_satisfied:\n                    break # Break the ingredient collection loop if any ingredient failed\n\n            # If all ingredients are acquired, proceed to use the workshop\n            if ingredients_satisfied:\n                workshop_name = recipe[\"_key\"]\n                workshop_kind_idx = cookbook.index.contents.get(workshop_name) # Get int ID of workshop\n                \n                if workshop_kind_idx is None:\n                    # This indicates an invalid workshop name in the recipe\n                    return False, []\n\n                actions_to_use_workshop = _get_path_and_use_actions(temp_state, workshop_kind_idx)\n                if actions_to_use_workshop is not None:\n                    # Simulate using the workshop to see if the item is crafted\n                    final_state = _simulate_actions(temp_state, actions_to_use_workshop)\n                    if final_state.inventory[target_item_idx] > 0: # Verify crafting was successful\n                        return True, all_ingredient_actions + actions_to_use_workshop\n        \n        # If neither primitive pickup nor recipe crafting succeeded\n        return False, []\n\n    # Start the planning process from the current environment state\n    initial_state = env._current_state\n    success, actions = _recursive_plan(item, initial_state, set())\n    \n    if success:\n        return actions\n    return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-29T21:02:25.668004", "function_name": "craft", "function_body": "", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-29T21:02:26.633791", "function_name": "craft", "function_body": "  _ACTION_DOWN = 0\n  _ACTION_UP = 1\n  _ACTION_LEFT = 2\n  _ACTION_RIGHT = 3\n  _ACTION_USE = 4\n  _ALL_ACTIONS = [_ACTION_DOWN, _ACTION_UP, _ACTION_LEFT, _ACTION_RIGHT, _ACTION_USE]\n\n  def _get_state_hash(state):\n      \"\"\"Generates a hashable representation of a CraftState.\n\n      This is crucial for the visited set to detect previously explored states.\n      The state is defined by agent's position, direction, inventory, and the grid layout.\n      \"\"\"\n      return (\n          state.pos,\n          state.dir,\n          tuple(state.inventory),\n          state.grid.tobytes()  # Converts numpy array to bytes for hashing\n      )\n\n  # Start with the current state of the environment.\n  # CraftLab stores the active state in its _current_state attribute.\n  initial_state = env._current_state\n  \n  # Queue for Breadth-First Search (BFS): stores (CraftState, list_of_actions_taken_to_reach_this_state)\n  # A deque is used for efficient append and pop operations from both ends.\n  q = collections.deque([(initial_state, [])])\n  \n  # Set to keep track of visited states to avoid cycles and redundant work.\n  # Each state is represented by a hashable tuple generated by _get_state_hash.\n  visited = {_get_state_hash(initial_state)}\n  \n  # Maximum number of states to explore to prevent excessive computation for complex or unreachable goals.\n  # This limit can be adjusted based on expected problem complexity and performance requirements.\n  _MAX_SEARCH_NODES = 5000 \n  states_explored = 0\n\n  while q:\n      current_state, actions_taken = q.popleft()\n      states_explored += 1\n\n      # Check if the search budget has been exceeded.\n      if states_explored > _MAX_SEARCH_NODES:\n          # If the goal is not found within the allowed search depth, return an empty list.\n          return [] \n          \n      # Check if the current state satisfies the goal.\n      # The 'goal_name' argument for satisfies is ignored in this context, so None is passed.\n      if current_state.satisfies(None, item):\n          return actions_taken  # Goal achieved, return the sequence of actions.\n      \n      # Explore all possible next actions from the current state.\n      for action in _ALL_ACTIONS:\n          # CraftState.step creates and returns a new CraftState object without modifying the current one.\n          # This purity is essential for BFS to explore different paths independently.\n          _, next_state = current_state.step(action)\n          \n          # Get the hashable representation for the next state to check if it has been visited.\n          next_state_hash = _get_state_hash(next_state)\n          \n          if next_state_hash not in visited:\n              visited.add(next_state_hash)  # Mark the new state as visited.\n              # Add the new state and the extended action sequence to the queue for further exploration.\n              q.append((next_state, actions_taken + [action]))\n              \n  # If the queue becomes empty and the goal was not reached, it means the goal is unreachable\n  # within the defined search space or constraints.\n  return []", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-29T21:04:17.118776", "function_name": "craft", "function_body": "    # Action constants as per CraftLab.action_specs()\n    # These integer values correspond to the actions defined in the CraftLab environment.\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n    ALL_ACTIONS = [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE]\n\n    def _get_hashable_state(craft_state):\n        \"\"\"Internal helper to convert a CraftState object into a hashable tuple.\n        This allows us to store states in a set for efficient lookup during BFS.\n        NumPy arrays are converted to bytes for a unique and hashable representation.\"\"\"\n        return (\n            craft_state.grid.tobytes(),  # Convert grid (ndarray) to bytes\n            craft_state.pos,             # Agent's position (tuple, already hashable)\n            craft_state.dir,             # Agent's direction (int, already hashable)\n            craft_state.inventory.tobytes() # Convert inventory (ndarray) to bytes\n        )\n\n    # Reset the environment to a clean, deterministic initial state for the search.\n    # This ensures that the generated action sequence is always valid from a consistent starting point.\n    env.reset(seed=0)\n    initial_craft_state = env._current_state\n\n    # Immediate goal check: If the item is already present in the inventory at the start,\n    # no actions are needed.\n    if initial_craft_state.inventory[item] > 0:\n        return []\n\n    # Initialize a queue for Breadth-First Search (BFS) and a set to keep track of visited states.\n    # `deque` from `collections` module provides efficient append and pop operations from both ends.\n    # It is assumed that `deque` and `numpy` (for `tobytes`) are available in the global scope.\n    q = deque()\n    visited = set()\n\n    # Add the initial state to the queue along with an empty path (no actions taken yet).\n    initial_hashable_state = _get_hashable_state(initial_craft_state)\n    q.append((initial_craft_state, []))  # Store (CraftState object, list of actions to reach it)\n    visited.add(initial_hashable_state)\n\n    # Define a maximum search depth to prevent excessively long searches or memory exhaustion.\n    # This value is a heuristic; complex recipes might require a deeper search.\n    MAX_SEARCH_DEPTH = 500\n\n    # Start the BFS exploration.\n    while q:\n        current_craft_state, current_path = q.popleft()\n\n        # If the current path length exceeds the maximum allowed search depth,\n        # prune this branch to avoid infinite loops or highly inefficient searches.\n        if len(current_path) >= MAX_SEARCH_DEPTH:\n            continue\n\n        # Goal check: If the desired item has been successfully crafted (i.e., its count\n        # in the inventory is greater than zero) in the current state, we've found a path.\n        if current_craft_state.inventory[item] > 0:\n            return current_path  # Return the sequence of actions that led to this state.\n\n        # Explore all possible actions from the current state.\n        for action in ALL_ACTIONS:\n            # Simulate taking an action using CraftState.step(). This method returns\n            # a *new* CraftState object, which is crucial for BFS as it avoids modifying\n            # states already in the queue or visited set.\n            _, next_craft_state = current_craft_state.step(action)\n\n            # Get the hashable representation of the next state.\n            next_hashable_state = _get_hashable_state(next_craft_state)\n\n            # If this state has not been visited before, add it to the visited set and the queue.\n            if next_hashable_state not in visited:\n                visited.add(next_hashable_state)\n                # Append the new state along with the updated path (current path + the action just taken).\n                q.append((next_craft_state, current_path + [action]))\n\n    # If the queue becomes empty and the goal has not been reached, it means no path\n    # to craft the item was found within the defined search limits from the initial state.\n    return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-29T21:04:17.200892", "function_name": "craft", "function_body": "    # Constants for actions\n    ACTIONS_MOVE = {\n        0: (1, 0),  # DOWN (dr, dc)\n        1: (-1, 0), # UP\n        2: (0, -1), # LEFT\n        3: (0, 1)   # RIGHT\n    }\n    N_ACTIONS = 5 # DOWN, UP, LEFT, RIGHT, USE\n\n    def _find_path_to_adjacent_target(state, target_kind_idx=None, target_pos=None):\n        \"\"\"\n        Finds a path of actions for the agent to move to a cell adjacent to\n        a target (either a specific kind or a specific position).\n\n        Args:\n            state (CraftState): The current state of the agent.\n            target_kind_idx (int, optional): The index of the item kind to find.\n            target_pos (tuple, optional): The (row, col) of a specific target cell.\n\n        Returns:\n            tuple: (list of actions, target_cell_pos_found) if a path is found,\n                   else (None, None).\n            target_cell_pos_found is the (r,c) of the actual item/workshop.\n        \"\"\"\n        start_pos = state.pos\n        grid = state.grid\n        grid_height, grid_width = grid.shape[0], grid.shape[1]\n\n        queue = deque([(start_pos, [])]) # (current_pos, path_actions)\n        visited = {start_pos}\n\n        while queue:\n            (r, c), path = queue.popleft()\n\n            # Check if any neighbor of (r, c) is the target\n            for dr_adj, dc_adj in [(0, 1), (0, -1), (1, 0), (-1, 0)]: # Neighbors\n                nr_target, nc_target = r + dr_adj, c + dc_adj\n\n                if not (0 <= nr_target < grid_height and 0 <= nc_target < grid_width):\n                    continue\n\n                is_target = False\n                found_target_pos = None\n\n                if target_kind_idx is not None:\n                    if grid[nr_target, nc_target, target_kind_idx] == 1:\n                        is_target = True\n                        found_target_pos = (nr_target, nc_target)\n                elif target_pos is not None:\n                    if (nr_target, nc_target) == target_pos:\n                        is_target = True\n                        found_target_pos = (nr_target, nc_target)\n\n                if is_target:\n                    # We found a target cell (nr_target, nc_target)\n                    # and (r,c) is adjacent to it.\n                    # So, the path `path` leads to (r,c).\n                    return path, found_target_pos\n\n            # If not adjacent to target, explore neighbors of (r,c) for further movement\n            for action, (dr, dc) in ACTIONS_MOVE.items():\n                nr, nc = r + dr, c + dc\n                new_pos = (nr, nc)\n\n                if 0 <= nr < grid_height and 0 <= nc < grid_width and new_pos not in visited:\n                    visited.add(new_pos)\n                    queue.append((new_pos, path + [action]))\n\n        return None, None # No path found\n\n    def _plan_to_get_item(current_state, target_item_idx, desired_count=1):\n        \"\"\"\n        Plans actions to obtain desired_count of target_item_idx, starting from current_state.\n        This function uses the 'env' from its outer scope (closure) to access world data.\n        Returns (success, actions, final_state_after_plan).\n        \"\"\"\n        total_actions = []\n\n        # Base case: If we already have enough, we're done\n        if current_state.inventory[target_item_idx] >= desired_count:\n            return True, [], current_state\n\n        cookbook = env.world.cookbook\n        primitives = cookbook.primitives\n        recipes = cookbook.recipes\n\n        # Case 1: Primitive item (can be picked up directly from the grid)\n        if target_item_idx in primitives:\n            # Loop until desired_count is met\n            while current_state.inventory[target_item_idx] < desired_count:\n                # Find closest instance of target_item_idx on the grid\n                path_to_adj, target_cell_pos = _find_path_to_adjacent_target(current_state, target_kind_idx=target_item_idx)\n\n                if path_to_adj is None:\n                    return False, [], current_state # Cannot find the primitive or path to it\n\n                # Execute movement actions\n                for action in path_to_adj:\n                    total_actions.append(action)\n                    _, current_state = current_state.step(action) # Update current_state\n\n                # Now agent is adjacent to the item. Execute USE action.\n                total_actions.append(N_ACTIONS - 1) # N_ACTIONS = 5, USE = 4\n                _, current_state = current_state.step(N_ACTIONS - 1)\n\n                if current_state.inventory[target_item_idx] >= desired_count:\n                    break # Acquired enough of this primitive\n\n            return True, total_actions, current_state\n\n        # Case 2: Craftable item (requires a recipe and workshop)\n        elif target_item_idx in recipes:\n            recipe = recipes[target_item_idx]\n\n            # Check again if we already have the item before collecting ingredients.\n            # This handles scenarios where recursive calls fulfill the need.\n            if current_state.inventory[target_item_idx] >= desired_count:\n                 return True, [], current_state\n\n            ingredients_to_get = {}\n            # Determine how many of each ingredient are truly needed\n            for ing_idx_or_key, count_required_by_recipe in recipe.items():\n                if ing_idx_or_key == \"_key\":\n                    continue # Special key for workshop type\n                # We need 'count_required_by_recipe' but might already have some\n                if current_state.inventory[ing_idx_or_key] < count_required_by_recipe:\n                    ingredients_to_get[ing_idx_or_key] = count_required_by_recipe\n\n            # Recursively get all required ingredients\n            for ing_idx, ing_count_needed_for_recipe in ingredients_to_get.items():\n                # Calculate how many more of this ingredient we still need to fetch\n                actual_needed = ing_count_needed_for_recipe - current_state.inventory[ing_idx]\n                if actual_needed > 0:\n                    success, ing_actions, current_state = _plan_to_get_item(current_state, ing_idx, actual_needed)\n                    if not success:\n                        return False, [], current_state\n                    total_actions.extend(ing_actions)\n            \n            # After gathering ingredients, check if we now satisfy the target item count\n            if current_state.inventory[target_item_idx] >= desired_count:\n                 return True, total_actions, current_state # Already got it (e.g., a byproduct)\n\n            # Now all ingredients should be in inventory (or we failed earlier).\n            # Time to craft at a workshop.\n            workshop_kind_idx = None\n            if \"_key\" in recipe:\n                # Get the actual index for the specific workshop type (e.g., 'table')\n                workshop_name = recipe[\"_key\"]\n                workshop_kind_idx = cookbook.index.get(workshop_name)\n                if workshop_kind_idx is None:\n                    return False, [], current_state # Workshop not found in index\n            else:\n                # Default workshop if no _key specified.\n                # `env.world.workshop_indices` is a list of workshop indices. Pick the first available.\n                if env.world.workshop_indices:\n                    workshop_kind_idx = env.world.workshop_indices[0] # Assume the first one is suitable/default\n                else:\n                    return False, [], current_state # No workshops in the world\n\n            # Path to workshop\n            path_to_adj, target_cell_pos = _find_path_to_adjacent_target(current_state, target_kind_idx=workshop_kind_idx)\n            if path_to_adj is None:\n                return False, [], current_state # Cannot find workshop or path to it\n\n            # Move to workshop\n            for action in path_to_adj:\n                total_actions.append(action)\n                _, current_state = current_state.step(action)\n\n            # Use workshop to craft\n            total_actions.append(N_ACTIONS - 1) # USE action\n            _, current_state = current_state.step(N_ACTIONS - 1)\n\n            # Check if crafting was successful\n            if current_state.inventory[target_item_idx] >= desired_count:\n                return True, total_actions, current_state\n            else:\n                return False, [], current_state # Crafting failed\n\n        # Item is neither primitive nor craftable (e.g., an invalid item index or unknown)\n        else:\n            return False, [], current_state\n\n    # Main logic of craft_v1\n    initial_state = env._current_state # Get the current state from the environment\n\n    success, actions, _ = _plan_to_get_item(initial_state, item, desired_count=1)\n\n    if success:\n        return actions\n    else:\n        return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-29T21:06:48.465625", "function_name": "craft", "function_body": "    import collections\n    import numpy as np\n\n    # Constants for actions based on CraftLab.action_specs\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Helper function 1: BFS on grid to find shortest path to any target coordinate\n    # Returns (list of (x,y) coordinates in path, or None)\n    def bfs_grid_path(start_coord, target_coords_list, current_grid):\n        q = collections.deque([(start_coord, [])])  # (coord, path_list_of_coords)\n        visited = {start_coord}\n        \n        WIDTH, HEIGHT, _ = current_grid.shape\n\n        while q:\n            (cx, cy), path = q.popleft()\n\n            if (cx, cy) in target_coords_list:\n                return path + [(cx, cy)]  # Return full path from start to target\n\n            # Explore 4-directional neighbors (North, South, East, West)\n            for dx, dy in [(0, -1), (0, 1), (1, 0), (-1, 0)]:\n                nx, ny = cx + dx, cy + dy\n\n                # Check bounds and if already visited\n                if 0 <= nx < WIDTH and 0 <= ny < HEIGHT and (nx, ny) not in visited:\n                    # Assuming all non-agent cells are traversable for movement.\n                    visited.add((nx, ny))\n                    q.append(((nx, ny), path + [(cx, cy)]))\n        return None  # No path found\n\n    # Helper function 2: Convert a path of (x,y) coordinates to action sequence (move + turn)\n    # Assumes agent's ACTION_UP moves it forward in its current direction.\n    # LEFT/RIGHT actions change current_dir.\n    def get_actions_for_path(start_pos, start_dir, path_coords):\n        if not path_coords or len(path_coords) < 2:\n            return [], list(start_pos), start_dir # No movement needed, return current state\n\n        current_pos = list(start_pos) # Make mutable\n        current_dir = start_dir\n        actions = []\n\n        # Map for calculating desired direction from relative movement (dx, dy)\n        # Directions: 0=N, 1=E, 2=S, 3=W\n        DELTA_TO_DIR = {\n            (0, -1): 0,  # North\n            (1, 0): 1,   # East\n            (0, 1): 2,   # South\n            (-1, 0): 3   # West\n        }\n\n        for i in range(1, len(path_coords)):\n            target_x, target_y = path_coords[i]\n            prev_x, prev_y = path_coords[i-1]\n\n            dx = target_x - prev_x\n            dy = target_y - prev_y\n\n            desired_dir = DELTA_TO_DIR.get((dx, dy))\n\n            # Turn actions if needed to face the next step\n            if desired_dir is not None and desired_dir != current_dir:\n                # Calculate shortest turn (clockwise/counter-clockwise)\n                diff = (desired_dir - current_dir + 4) % 4\n                if diff == 1:  # Turn right (e.g., N->E)\n                    actions.append(ACTION_RIGHT)\n                elif diff == 2:  # Turn 180 (e.g., N->S)\n                    actions.append(ACTION_LEFT)\n                    actions.append(ACTION_LEFT) # Two LEFTs or two RIGHTs\n                elif diff == 3:  # Turn left (e.g., N->W)\n                    actions.append(ACTION_LEFT)\n                current_dir = desired_dir\n            \n            # Move forward action (ACTION_UP always moves forward)\n            actions.append(ACTION_UP)\n            current_pos[0], current_pos[1] = target_x, target_y # Update simulated position\n\n        return actions, current_pos, current_dir\n\n\n    # Recursive helper to gather ingredients or craft an item\n    # Returns (list of actions, updated_grid, updated_pos, updated_dir, updated_inventory) or (None, ...) on failure\n    def get_item_actions(target_item_idx, current_sim_grid, current_sim_pos, current_sim_dir, current_sim_inventory):\n        current_item_actions = []\n\n        # Base case: item is already in inventory\n        if current_sim_inventory[target_item_idx] > 0:\n            return [], current_sim_grid, current_sim_pos, current_sim_dir, current_sim_inventory\n\n        # Get world and cookbook references (from outer scope)\n        world = env.world\n        cookbook = world.cookbook\n        WIDTH, HEIGHT, _ = current_sim_grid.shape\n\n        # Case 1: Item is a primitive (can be picked up)\n        if target_item_idx in world.primitives:\n            # Find all grid locations containing this primitive\n            primitive_locations = []\n            for x in range(WIDTH):\n                for y in range(HEIGHT):\n                    if current_sim_grid[x, y, target_item_idx] > 0:\n                        primitive_locations.append((x, y))\n            \n            if not primitive_locations:\n                return None, None, None, None, None # Primitive not found on grid\n\n            # For picking up, the agent needs to be adjacent to the item (within 3x3 neighborhood).\n            # So, the BFS target is any cell that is a cardinal neighbor of any primitive location.\n            bfs_target_adj_coords = set()\n            for px, py in primitive_locations:\n                for dx_adj, dy_adj in [(0, -1), (0, 1), (1, 0), (-1, 0)]: # Cardinal neighbors\n                    adj_x, adj_y = px + dx_adj, py + dy_adj\n                    if 0 <= adj_x < WIDTH and 0 <= adj_y < HEIGHT:\n                        bfs_target_adj_coords.add((adj_x, adj_y))\n            \n            if not bfs_target_adj_coords: # No reachable adjacent cells\n                return None, None, None, None, None\n\n            path_to_adj_cell = bfs_grid_path(tuple(current_sim_pos), list(bfs_target_adj_coords), current_sim_grid)\n\n            if not path_to_adj_cell:\n                return None, None, None, None, None\n\n            # Get actions to reach the adjacent cell\n            move_actions, final_pos_move, final_dir_move = get_actions_for_path(\n                tuple(current_sim_pos), current_sim_dir, path_to_adj_cell\n            )\n            current_item_actions.extend(move_actions)\n            \n            # Update simulated state after movement\n            current_sim_pos = final_pos_move\n            current_sim_dir = final_dir_move\n            \n            # Add USE action to pick up the item\n            current_item_actions.append(ACTION_USE)\n\n            # Simulate the effect: one item removed from grid, one added to inventory\n            # This is a simplification: assumes USE picks up one item of type target_item_idx\n            # from an adjacent tile. We decrement a count on the closest instance on the grid.\n            closest_item_pos = None\n            min_dist_sq = float('inf') # Using squared Euclidean distance for simplicity\n            for px, py in primitive_locations:\n                dist_sq = (current_sim_pos[0] - px)**2 + (current_sim_pos[1] - py)**2\n                if dist_sq < min_dist_sq:\n                    min_dist_sq = dist_sq\n                    closest_item_pos = (px, py)\n            \n            if closest_item_pos and current_sim_grid[closest_item_pos[0], closest_item_pos[1], target_item_idx] > 0:\n                current_sim_grid[closest_item_pos[0], closest_item_pos[1], target_item_idx] -= 1\n            \n            current_sim_inventory[target_item_idx] += 1\n\n            return current_item_actions, current_sim_grid, current_sim_pos, current_sim_dir, current_sim_inventory\n\n        # Case 2: Item is craftable (has a recipe)\n        if target_item_idx in cookbook.recipes:\n            recipe = cookbook.recipes[target_item_idx]\n            \n            requires_workshop_kind = None\n            \n            # Gather all ingredients recursively\n            for ingredient_name, count_needed_value in recipe.items():\n                if ingredient_name == \"_key\":\n                    requires_workshop_kind = count_needed_value # The value for \"_key\" is the workshop kind index\n                    continue\n\n                ingredient_idx = cookbook.index[ingredient_name]\n                \n                # Recursively get actions for each unit of the ingredient still needed\n                needed = int(count_needed_value) - int(current_sim_inventory[ingredient_idx])\n                for _ in range(needed):\n                    ing_actions, current_sim_grid, current_sim_pos, current_sim_dir, current_sim_inventory = \\\n                        get_item_actions(ingredient_idx, current_sim_grid, current_sim_pos, current_sim_dir, current_sim_inventory)\n                    \n                    if ing_actions is None: # Cannot obtain ingredient, so cannot craft target\n                        return None, None, None, None, None\n                    current_item_actions.extend(ing_actions)\n            \n            # After gathering all ingredients, move to workshop if required\n            if requires_workshop_kind is not None:\n                workshop_locations = []\n                for x in range(WIDTH):\n                    for y in range(HEIGHT):\n                        # Find cells that are the required workshop kind\n                        if current_sim_grid[x, y, requires_workshop_kind] > 0:\n                            workshop_locations.append((x, y))\n                \n                if not workshop_locations:\n                    return None, None, None, None, None # Required workshop not found\n\n                # For crafting, the agent typically needs to be ON the workshop tile itself.\n                path_to_workshop = bfs_grid_path(tuple(current_sim_pos), workshop_locations, current_sim_grid)\n                \n                if not path_to_workshop:\n                    return None, None, None, None, None\n\n                move_actions, final_pos_move, final_dir_move = get_actions_for_path(\n                    tuple(current_sim_pos), current_sim_dir, path_to_workshop\n                )\n                current_item_actions.extend(move_actions)\n\n                # Update simulated state after movement\n                current_sim_pos = final_pos_move\n                current_sim_dir = final_dir_move\n\n            # Add USE action to craft the item\n            current_item_actions.append(ACTION_USE)\n\n            # Simulate the effect of crafting: consume ingredients, produce one target item\n            for ingredient_name, count_consumed_value in recipe.items():\n                if ingredient_name != \"_key\":\n                    ingredient_idx = cookbook.index[ingredient_name]\n                    current_sim_inventory[ingredient_idx] -= count_consumed_value # Consume required amount\n            current_sim_inventory[target_item_idx] += 1 # Produce one unit of target item\n\n            return current_item_actions, current_sim_grid, current_sim_pos, current_sim_dir, current_sim_inventory\n        \n        # Item is neither primitive nor craftable (e.g., an environment item not meant for pickup)\n        return None, None, None, None, None\n\n\n    # Start the planning process from the initial state\n    # We make initial copies of the state attributes to avoid modifying the actual env state during planning.\n    sim_grid = np.copy(env._current_state.grid)\n    sim_pos = list(env._current_state.pos)\n    sim_dir = env._current_state.dir\n    sim_inventory = np.copy(env._current_state.inventory)\n\n    # Call the recursive helper to get the actions for the target item\n    final_planned_actions, _, _, _, _ = \\\n        get_item_actions(item, sim_grid, sim_pos, sim_dir, sim_inventory)\n\n    if final_planned_actions is None:\n        # If the item cannot be crafted or obtained, return an empty list as per `craft_v0` output\n        return []\n    \n    return final_planned_actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-29T21:06:49.448602", "function_name": "craft", "function_body": "  import numpy as np\n  import collections\n\n  # Helper function to identify all craftable items (intermediates + final goal)\n  # that need to be produced to achieve the goal.\n  # Returns a set of indices of craftable items.\n  def _get_needed_craftables_recursive(goal_idx, cookbook, memo=None):\n      if memo is None:\n          memo = {}\n      if goal_idx in memo:\n          return memo[goal_idx]\n\n      needed_craftables = set()\n      # If the goal_idx is craftable (i.e., has a recipe)\n      if goal_idx in cookbook.recipes:\n          needed_craftables.add(goal_idx)  # Add self to needed craftables\n          recipe = cookbook.recipes[goal_idx]\n          for ing_idx, _ in recipe.items():\n              if ing_idx == '_key':\n                  continue\n              # Recursively add ingredients that are also craftable\n              if ing_idx in cookbook.recipes:\n                  needed_craftables.update(_get_needed_craftables_recursive(ing_idx, cookbook, memo))\n\n      memo[goal_idx] = needed_craftables\n      return needed_craftables\n\n  current_state = env._current_state\n  cookbook = env.world.cookbook\n  current_inventory = current_state.inventory\n  actions = []\n\n  # Get action constants from the environment's action_specs\n  ACTION_DOWN = env.action_specs()[\"DOWN\"]\n  ACTION_UP = env.action_specs()[\"UP\"]\n  ACTION_LEFT = env.action_specs()[\"LEFT\"]\n  ACTION_RIGHT = env.action_specs()[\"RIGHT\"]\n  ACTION_USE = env.action_specs()[\"USE\"]\n  ACTIONS_MOVE = [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT]\n\n  # 1. Check if goal is already satisfied\n  if current_state.satisfies(None, item):\n      return []\n\n  # 2. Calculate primitives still needed (total, for any step of crafting)\n  required_primitives_total = cookbook.primitives_for(item)\n  missing_primitives = {\n      k: v - current_inventory[k]\n      for k, v in required_primitives_total.items()\n      if current_inventory[k] < v\n  }\n\n  # 3. Get all craftable items (intermediates + final goal) that need to be made\n  all_needed_craftables = _get_needed_craftables_recursive(item, cookbook)\n\n  # Action Priority 1: Craft an item if possible and needed\n  # Iterate through all needed craftables. This simple iteration implies a greedy \"craft if possible\" strategy.\n  for craft_target_idx in all_needed_craftables:\n      # If this is not the final item AND we already have at least one,\n      # assume we have enough for now to proceed to higher-level crafts.\n      # This prevents over-crafting intermediates.\n      if craft_target_idx != item and current_inventory[craft_target_idx] > 0:\n          continue\n\n      recipe = cookbook.recipes.get(craft_target_idx)\n      if recipe is None:  # Should not happen if _get_needed_craftables_recursive is correct\n          continue\n\n      has_all_ingredients = True\n      workshop_needed_idx = None\n      for ing_idx, count in recipe.items():\n          if ing_idx == '_key':\n              workshop_needed_idx = count\n              continue\n          if current_inventory[ing_idx] < count:\n              has_all_ingredients = False\n              break\n\n      if has_all_ingredients:\n          # We have all ingredients, now check workshop availability\n          if workshop_needed_idx is None or current_state.next_to(workshop_needed_idx):\n              actions.append(ACTION_USE)\n              return actions  # Perform craft action immediately\n\n  # Action Priority 2: Pick up/Mine Missing Primitives if Next To\n  for m_idx, count_needed in missing_primitives.items():\n      if count_needed > 0 and current_state.next_to(m_idx):\n          # Check if it's a primitive resource or a mineable resource (stone/water)\n          if m_idx in cookbook.primitives or m_idx == env.world.stone_index or m_idx == env.world.water_index:\n              actions.append(ACTION_USE)\n              return actions  # Pick up / mine this missing primitive\n\n  # Action Priority 3: Move towards a missing primitive or workshop\n  current_pos = current_state.pos\n  grid = current_state.grid\n  min_dist = float('inf')\n  target_coords = None\n\n  # First, look for missing primitive resources on the map\n  for m_idx in missing_primitives.keys():\n      # Only consider primitives that are explicitly placed on the map\n      if m_idx in cookbook.primitives or m_idx == env.world.stone_index or m_idx == env.world.water_index:\n          ys, xs = np.where(grid[:, :, m_idx] > 0)\n          for y, x in zip(ys, xs):\n              # Don't target the agent's current position if there are other options\n              if (x, y) == current_pos:\n                  continue\n              dist = abs(x - current_pos[0]) + abs(y - current_pos[1])\n              if dist < min_dist:\n                  min_dist = dist\n                  target_coords = (x, y)\n\n  # If no missing primitives found on map, look for workshops needed for crafting\n  # where we have ingredients but are not at the workshop.\n  if target_coords is None:\n      for craft_target_idx in all_needed_craftables:\n          # Skip if we already have enough of this intermediate, or if it's the final item already satisfied\n          if craft_target_idx != item and current_inventory[craft_target_idx] > 0:\n              continue\n\n          recipe = cookbook.recipes.get(craft_target_idx)\n          if recipe is None:\n              continue\n\n          has_all_ingredients_for_this_recipe = True\n          workshop_for_this_recipe = None\n          for ing_idx, count in recipe.items():\n              if ing_idx == '_key':\n                  workshop_for_this_recipe = count\n                  continue\n              if current_inventory[ing_idx] < count:\n                  has_all_ingredients_for_this_recipe = False\n                  break\n\n          # If we have ingredients and need a workshop, and are not next to it\n          if has_all_ingredients_for_this_recipe and workshop_for_this_recipe is not None and \\\n             not current_state.next_to(workshop_for_this_recipe):\n              ys, xs = np.where(grid[:, :, workshop_for_this_recipe] > 0)\n              for y, x in zip(ys, xs):\n                  # Don't target the agent's current position if there are other options\n                  if (x, y) == current_pos:\n                      continue\n                  dist = abs(x - current_pos[0]) + abs(y - current_pos[1])\n                  if dist < min_dist:\n                      min_dist = dist\n                      target_coords = (x, y)\n\n  if target_coords:\n      tx, ty = target_coords\n      px, py = current_pos\n\n      # Simple greedy movement towards target (prioritizing X then Y)\n      if px < tx:\n          actions.append(ACTION_RIGHT)\n      elif px > tx:\n          actions.append(ACTION_LEFT)\n      elif py < ty:\n          actions.append(ACTION_DOWN)\n      elif py > ty:\n          actions.append(ACTION_UP)\n\n      if actions:  # If a movement action was chosen\n          return actions\n\n  # Action Priority 4: Random movement (fallback if no specific target or action found)\n  actions.append(env.world.random.choice(ACTIONS_MOVE))\n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-07-29T21:07:50.212454", "function_name": "craft", "function_body": "  # Define action mapping constants (as per CraftLab.action_specs)\n  _ACTION_DOWN = 0\n  _ACTION_UP = 1\n  _ACTION_LEFT = 2\n  _ACTION_RIGHT = 3\n  _ACTION_USE = 4\n  _ALL_ACTIONS = [_ACTION_DOWN, _ACTION_UP, _ACTION_LEFT, _ACTION_RIGHT, _ACTION_USE]\n\n  # Helper to create a hashable key for a CraftState\n  # This is crucial for the 'visited' set to avoid redundant exploration\n  def _get_state_key(state):\n    # Combines agent's position, direction, inventory, and grid state\n    # numpy arrays are converted to bytes for hashing efficiency and correctness\n    # Assumes numpy is available in the environment's scope.\n    return (state.pos, state.dir, state.inventory.tobytes(), state.grid.tobytes())\n\n  initial_state = env._current_state\n  goal_idx = item\n\n  # Initialize BFS queue with the initial state and an empty list of actions\n  # Each element in the queue is (current_CraftState, list_of_actions_to_reach_this_state)\n  # Assumes `collections.deque` is available in the environment's scope (standard library).\n  q = collections.deque()\n  q.append((initial_state, []))\n\n  # Initialize a set to keep track of visited states to prevent cycles and redundant work\n  visited = set()\n  visited.add(_get_state_key(initial_state))\n\n  # Limit the search depth/complexity to prevent excessively long runtimes\n  # This value may need tuning based on environment size and task complexity\n  MAX_NODES_TO_EXPLORE = 20000\n  nodes_explored = 0\n\n  while q and nodes_explored < MAX_NODES_TO_EXPLORE:\n    current_state, current_actions = q.popleft()\n    nodes_explored += 1\n\n    # Check if the goal item is in the inventory of the current state\n    if current_state.satisfies(None, goal_idx):\n      return current_actions # Goal reached! Return the sequence of actions\n\n    # Explore all possible next states by applying each action\n    for action_int in _ALL_ACTIONS:\n      # CraftState.step returns (reward, new_state). Reward is not used in this planner.\n      _, next_state = current_state.step(action_int)\n\n      next_state_key = _get_state_key(next_state)\n\n      # If this next state has not been visited before, add it to the queue\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, current_actions + [action_int]))\n\n  # If the loop finishes (queue is empty or max nodes explored) and the goal was not met,\n  # it means no path was found within the defined limits.\n  return []", "island_id": 5, "scores": {"3": -1}}
