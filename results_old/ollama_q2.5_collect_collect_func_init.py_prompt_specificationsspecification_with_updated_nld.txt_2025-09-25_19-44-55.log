pt to clear obstacles using available tools.\n  for neighbor in get_neighbors(current_state.pos):\n      nx, ny = neighbor\n\n      if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n          if any(current_state.inventory[tool_index] > 0 and current_state.grid[ny, nx, tool_index] > 0 for tool_index in current_state.world.grabbable_indices):\n              return actions_taken + [actions[\"USE\"]]\n\n      # Check if there's an obstacle that can be cleared.\n      if any(current_state.grid[ny, nx, env_index] > 0 for env_index in current_state.world.non_grabbable_indices):\n          for tool_index in current_state.world.grabbable_indices:\n              if current_state.inventory[tool_index] > 0 and current_state.grid[ny, nx, tool_index] > 0:\n                  return actions_taken + [actions[\"USE\"]]\n\n  return []", "island_id": 1, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T02:45:08.100065", "function_name": "collect", "function_body": "  def get_primitive_index(primitive_name):\n      return current_state.world.cookbook.index[primitive_name]\n\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  actions = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  current_state = env._current_state\n  target_primitive_index = get_primitive_index(primitive)\n  \n  queue = collections.deque([(current_state.pos, [], current_state.dir)])\n  visited = set([current_state.pos])\n\n  while queue:\n      pos, actions_taken, direction = queue.popleft()\n\n      if current_state.grid[pos[1], pos[0], target_primitive_index] > 0:\n          return actions_taken + [actions[\"USE\"]]\n\n      for neighbor in get_neighbors(pos):\n          nx, ny = neighbor\n\n          if (0 <= nx < current_state.grid.shape[1]) and (0 <= ny < current_state.grid.shape[0]):\n              if all(current_state.grid[ny, nx, env_index] == 0 for env_index in current_state.world.non_grabbable_indices) and (neighbor not in visited):\n                  visited.add(neighbor)\n\n                  dx, dy = nx - pos[0], ny - pos[1]\n                  if dx == 1:\n                      action = actions[\"RIGHT\"]\n                      new_direction = 3\n                  elif dx == -1:\n                      action = actions[\"LEFT\"]\n                      new_direction = 2\n                  elif dy == 1:\n                      action = actions[\"DOWN\"]\n                      new_direction = 0\n                  else:  # dy == -1\n                      action = actions[\"UP\"]\n                      new_direction = 1\n\n                  if direction != new_direction:\n                      queue.append((pos, actions_taken + [action], new_direction))\n                  else:\n                      queue.append((neighbor, actions_taken + [action], new_direction))\n\n  return []", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-09-26T02:45:09.183114", "function_name": "collect", "function_body": "  actions = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  # Helper function to find neighboring positions.\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  # Get the current state of the environment.\n  current_state = env._current_state\n\n  # Define a queue for BFS and a set to track visited positions.\n  queue = collections.deque([(current_state.pos, [], current_state.dir)])\n  visited = set([(current_state.pos, current_state.dir)])\n\n  # Helper function to get the index of a primitive name.\n  def get_primitive_index(primitive_name):\n      return current_state.world.cookbook.index[primitive_name]\n\n  # Get the index for the target primitive.\n  target_primitive_index = get_primitive_index(primitive)\n\n  # Perform BFS to find a path to collect the primitive.\n  while queue:\n      pos, actions_taken, direction = queue.popleft()\n\n      # Check if we are at a cell with the desired primitive.\n      if current_state.grid[pos[0], pos[1], target_primitive_index] > 0:\n          return actions_taken + [actions[\"USE\"]]\n\n      # Get neighboring positions and filter out invalid ones.\n      neighbors = get_neighbors(pos)\n      for neighbor in neighbors:\n          nx, ny = neighbor\n\n          # Ensure the neighbor is within bounds.\n          if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n              # Check if the cell is not blocked by non-grabbable entities.\n              if all(current_state.grid[ny, nx, env_index] == 0 for env_index in current_state.world.non_grabbable_indices):\n                  # If the cell is visited for the first time with this direction, add it to the queue.\n                  if (neighbor, direction) not in visited:\n                      visited.add((neighbor, direction))\n\n                      # Determine the direction to move towards the neighbor.\n                      dx, dy = nx - pos[0], ny - pos[1]\n                      action = None\n                      new_direction = None\n\n                      if dx == 1:\n                          action = actions[\"RIGHT\"]\n                          new_direction = 3\n                      elif dx == -1:\n                          action = actions[\"LEFT\"]\n                          new_direction = 2\n                      elif dy == 1:\n                          action = actions[\"DOWN\"]\n                          new_direction = 0\n                      else:  # dy == -1\n                          action = actions[\"UP\"]\n                          new_direction = 1\n\n                      if direction != new_direction:\n                          # If the current direction is not the target direction, turn first.\n                          queue.append((pos, actions_taken + [action], new_direction))\n                      else:\n                          # Otherwise, move towards the neighbor.\n                          queue.append((neighbor, actions_taken + [action], new_direction))\n\n  # If no path is found to collect the primitive, return an empty list.\n  return []", "island_id": 2, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T02:46:54.706099", "function_name": "collect", "function_body": "  def get_available_tools(state):\n    tools = {}\n    for tool_index in state.inventory.nonzero()[0]:\n      tool_name = env.world.cookbook.index.get(tool_index)\n      if tool_name:\n        tools[tool_index] = state.inventory[tool_index]\n    return tools\n\n  def find_path(start, goal, grid, blocked_indices):\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([start])\n    came_from = {start: None}\n    \n    while queue:\n      current = queue.popleft()\n      \n      if current == goal:\n        break\n      \n      for direction in directions:\n        next_pos = tuple(np.add(current, direction))\n        \n        # Check if the next position is within bounds and not blocked\n        if 0 <= next_pos[0] < grid.shape[0] and\\\n           0 <= next_pos[1] < grid.shape[1]:\n          grid_val = grid[next_pos[0], next_pos[1]]\n          \n          # Check for obstacles using the environment's grid\n          if np.all(grid_val == 0) or (next_pos in blocked_indices and np.all(grid[next_pos[0], next_pos[1]] == 0)):\n            if next_pos not in came_from:\n              queue.append(next_pos)\n              came_from[next_pos] = current\n    \n    # Reconstruct the path from start to goal\n    path = []\n    while current != start:\n      path.append(current)\n      current = came_from[current]\n    path.reverse()\n    \n    return path\n\n  def get_direction_to_target(current_dir, dx, dy):\n    if dx == 1:  \n      return craft.RIGHT if current_dir != 2 else craft.USE\n    elif dx == -1:  \n      return craft.LEFT if current_dir != 0 else craft.USE\n    elif dy == 1:  \n      return craft.DOWN if current_dir != 3 else craft.USE\n    elif dy == -1:  \n      return craft.UP if current_dir != 1 else craft.USE\n\n  def use_tool_if_needed(state, target_index):\n    tool_actions = []\n    for tool_index in state.inventory.nonzero()[0]:\n      tool_name = env.world.cookbook.index.get(tool_index)\n      if tool_name and can_break_with_tool(env, tool_name, target_index):\n        tool_actions.append((tool_index, craft.USE))\n    return tool_actions\n\n  def can_break_with_tool(env, tool_name, target_index):\n    # Placeholder function to determine if a tool can break a target\n    if tool_name == 'AXE' and env.world.cookbook.index['WOOD'] == target_index:\n      return True\n    elif tool_name == 'PICKAXE' and (env.world.cookbook.index['STONE'] == target_index or env.world.cookbook.index['GEM'] == target_index):\n      return True\n    # Add more cases as needed\n    return False\n\n  index = env.world.cookbook.index[primitive]\n  pos_x, pos_y = env._current_state.pos\n  dir = env._current_state.dir\n\n  target_positions = np.argwhere(env._current_state.grid[:, :, index] == 1)\n\n  if len(target_positions) == 0:\n    return [craft.USE]\n\n  distances = [(abs(pos_x - tx) + abs(pos_y - ty), (tx, ty)) for tx, ty in target_positions]\n  closest_target_pos = min(distances, key=lambda x: x[0])[1]\n\n  # Consider blocked indices based on tools available\n  state = env._current_state\n  available_tools = get_available_tools(state)\n  blocked_indices = set()\n\n  if 'AXE' in available_tools:\n    wood_index = env.world.cookbook.index['WOOD']\n    blocked_indices.update(np.argwhere(env._current_state.grid[:, :, wood_index] == 1))\n\n  path = find_path((pos_x, pos_y), closest_target_pos, env._current_state.grid, blocked_indices)\n  actions = []\n\n  if not path:\n    return [craft.USE]\n\n  for i in range(len(path)):\n    current_pos = path[i]\n    \n    if i + 1 < len(path):\n      next_pos = path[i + 1]\n    else:\n      break\n\n    delta_x = next_pos[0] - current_pos[0]\n    delta_y = next_pos[1] - current_pos[1]\n    \n    action = get_direction_to_target(dir, delta_x, delta_y)\n    actions.append(action)\n\n    # Update the agent's direction\n    if action in [craft.RIGHT, craft.LEFT, craft.UP, craft.DOWN]:\n      dir = {craft.RIGHT: 2, craft.LEFT: 0, craft.DOWN: 3, craft.UP: 1}[action]\n    \n    # If we are at the last position in the path, use the action to collect the primitive\n    if i == len(path) - 1:\n      tool_actions = use_tool_if_needed(state, index)\n      actions.extend([action for _, action in tool_actions])\n      actions.append(craft.USE)\n\n  return actions", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-09-26T02:46:55.787730", "function_name": "collect", "function_body": "  def get_available_tools(state):\n    tools = {}\n    for tool_index in state.inventory.nonzero()[0]:\n      tool_name = env.world.cookbook.index.get(tool_index)\n      if tool_name:\n        tools[tool_index] = state.inventory[tool_index]\n    return tools\n\n  index = env.world.cookbook.index[primitive]\n  pos_x, pos_y = env._current_state.pos\n  dir = env._current_state.dir\n\n  target_positions = np.argwhere(env._current_state.grid[:, :, index] == 1)\n\n  if len(target_positions) == 0:\n    return []\n\n  distances = [(abs(pos_x - tx) + abs(pos_y - ty), (tx, ty)) for tx, ty in target_positions]\n  closest_target_pos = min(distances, key=lambda x: x[0])[1]\n\n  def find_path(start, goal):\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([start])\n    came_from = {start: None}\n    \n    while queue:\n      current = queue.popleft()\n      \n      if current == goal:\n        break\n      \n      for direction in directions:\n        next_pos = tuple(np.add(current, direction))\n        \n        # Check if the next position is within bounds and not blocked\n        if 0 <= next_pos[0] < env._current_state.grid.shape[0] and\\\n           0 <= next_pos[1] < env._current_state.grid.shape[1]:\n          grid_val = env._current_state.grid[next_pos[0], next_pos[1]]\n          # Check for obstacles using the environment's grid\n          if np.all(grid_val == 0):\n            if next_pos not in came_from:\n              queue.append(next_pos)\n              came_from[next_pos] = current\n    \n    # Reconstruct the path from start to goal\n    path = []\n    while current != start:\n      path.append(current)\n      current = came_from[current]\n    path.reverse()\n    \n    return path\n\n  def get_direction_to_target(current_dir, dx, dy):\n    if dx == 1:  \n      return craft.RIGHT if current_dir != 2 else craft.USE\n    elif dx == -1:  \n      return craft.LEFT if current_dir != 0 else craft.USE\n    elif dy == 1:  \n      return craft.DOWN if current_dir != 3 else craft.USE\n    elif dy == -1:  \n      return craft.UP if current_dir != 1 else craft.USE\n\n  # Consider blocked indices based on tools available\n  state = env._current_state\n  available_tools = get_available_tools(state)\n  blocked_indices = set()\n\n  # Example: If a tool like AXE is available, consider WOOD as passable\n  if 'AXE' in available_tools:\n    wood_index = env.world.cookbook.index['WOOD']\n    blocked_indices.update(np.argwhere(env._current_state.grid[:, :, wood_index] == 1))\n\n  path = find_path((pos_x, pos_y), closest_target_pos)\n  actions = []\n\n  for i in range(len(path)):\n    current_pos = path[i]\n\n    # Determine the direction to move\n    if i < len(path) - 1:\n        next_pos = path[i + 1]\n        delta_x = next_pos[0] - current_pos[0]\n        delta_y = next_pos[1] - current_pos[1]\n        \n        action = get_direction_to_target(dir, delta_x, delta_y)\n    else:\n        # If at the target position, use to collect\n        action = craft.USE\n\n    actions.append(action)\n\n    # Update the agent's direction if a movement action was taken\n    if action in [craft.RIGHT, craft.LEFT, craft.UP, craft.DOWN]:\n      dir = {craft.RIGHT: 2, craft.LEFT: 0, craft.DOWN: 3, craft.UP: 1}[action]\n\n  return actions", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-09-26T02:47:55.138000", "function_name": "collect", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Get the index of the target primitive\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Helper function to check if a cell is blocked by obstacles or other items, except for the target primitive itself\n  def is_blocked(x, y):\n    return any(env._current_state.grid[x, y] > 0) and not env._current_state.grid[x, y][primitive_index] > 0\n\n  # Directions and their corresponding actions\n  directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n  action_map = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, \n                (0, -1): craft.DOWN, (0, 1): craft.UP}\n\n  # BFS to find the shortest path to a cell containing the primitive\n  start_x, start_y = env._current_state.pos\n  visited = set()\n  queue = deque([(start_x, start_y, [])])  # (x, y, path)\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    if (x, y) in visited:\n      continue\n\n    visited.add((x, y))\n\n    for dx, dy in directions:\n      nx, ny = x + dx, y + dy\n      \n      # Check bounds\n      if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n        # If the cell contains the primitive, return the path to it\n        if env._current_state.grid[nx, ny][primitive_index] > 0:\n          move_action = action_map[(dx, dy)]\n          use_action = craft.USE\n          return path + [move_action, use_action]\n        \n        # If the cell is not blocked and hasn't been visited, add to queue\n        if not is_blocked(nx, ny):\n          move_action = action_map[(dx, dy)]\n          queue.append((nx, ny, path + [move_action]))\n  \n  return []  # Return an empty list if no path found", "island_id": 4, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T02:47:56.253891", "function_name": "collect", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Get the index of the target primitive\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Helper function to check if a cell is blocked by obstacles or other items, except for the target primitive itself\n  def is_blocked(x, y):\n    return any(env._current_state.grid[x, y] > 0) and not env._current_state.grid[x, y][primitive_index] > 0\n\n  # Directions and their corresponding actions\n  directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n  actions = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, \n             (0, -1): craft.DOWN, (0, 1): craft.UP}\n\n  # BFS to find the shortest path to a cell containing the primitive\n  start_x, start_y = env._current_state.pos\n  visited = set()\n  queue = deque([(start_x, start_y, [])])  # (x, y, path)\n  \n  while queue:\n    x, y, path = queue.popleft()\n    \n    if (x, y) in visited:\n      continue\n    \n    visited.add((x, y))\n    \n    for dx, dy in directions:\n      nx, ny = x + dx, y + dy\n      \n      # Check bounds\n      if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n        # If the cell contains the primitive, return the path to it\n        if env._current_state.grid[nx, ny][primitive_index] > 0:\n          move_action = actions[(dx, dy)]\n          use_action = craft.USE\n          return path + [move_action, use_action]\n        \n        # If the cell is not blocked and hasn't been visited, add to queue\n        if not is_blocked(nx, ny):\n          move_action = actions[(dx, dy)]\n          queue.append((nx, ny, path + [move_action]))\n  \n  # Try using available tools in inventory to clear obstacles\n  for tool_index in range(env._current_state.inventory.shape[0]):\n    if env._current_state.inventory[tool_index] > 0:\n      # Use the tool\n      use_tool = craft.USE\n      return [use_tool]\n\n  return []  # Return an empty list if no path found and no tools to clear obstacles", "island_id": 4, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T02:49:23.474056", "function_name": "collect", "function_body": "  def can_use_tool_on_obstacle(tool_index: int, obstacle_index: int):\n    tools = {\n        'AXE': {'WOOD'},\n        'HAMMER': {'ROCK'}\n    }\n    for tool_name, usable_primitives in tools.items():\n      if tool_index == env.world.cookbook.index[tool_name]:\n        return any(obstacle_index == env.world.cookbook.index[p] \n                   for p in usable_primitives)\n    return False\n\n  def is_blocked(x: int, y: int) -> bool:\n    for kind_index in env.world.non_grabbable_indices:\n      if env._current_state.grid[x, y, kind_index] > 0 and\\\n         not any(can_use_tool_on_obstacle(tool_index, kind_index) \n                 for tool_index in env._current_state.inventory):\n        return True\n    return False\n\n  def get_move_actions(dx: int, dy: int) -> list[int]:\n    move_action_map = {\n        (-1, 0): craft.LEFT,\n        (1, 0): craft.RIGHT,\n        (0, -1): craft.DOWN,\n        (0, 1): craft.UP\n    }\n    return [move_action_map[(dx, dy)]]\n\n  # Determine the target primitive index from its name\n  target_primitive_index = env.world.cookbook.index[primitive]\n\n  # Initialize an empty list to store the actions needed\n  actions_to_take = []\n\n  # Current position of the agent\n  current_x, current_y = env._current_state.pos\n\n  # Get the grid dimensions\n  width, height, _ = env._current_state.grid.shape\n\n  # Use BFS to find the shortest path to the target primitive\n  queue = collections.deque([(current_x, current_y, actions_to_take)])\n  visited = set()\n  visited.add((current_x, current_y))\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    # Check if we are next to a cell containing the target primitive\n    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n      nx, ny = x + dx, y + dy\n\n      # Ensure within bounds and not visited\n      if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n        if env._current_state.grid[nx, ny, target_primitive_index] > 0:\n          # Move to the adjacent cell containing the primitive\n          move_actions = get_move_actions(dx, dy)\n          actions_to_take.extend(path + move_actions)\n\n          # Collect the primitive\n          actions_to_take.append(craft.USE)\n          return actions_to_take\n\n        # Mark as visited and add to queue if not blocked\n        if not is_blocked(nx, ny):\n          visited.add((nx, ny))\n          new_path = path.copy()\n          move_actions = get_move_actions(dx, dy)\n          new_path.extend(move_actions)\n          queue.append((nx, ny, new_path))\n\n        # Check for tools in inventory to use on obstacles\n        if is_blocked(nx, ny):\n          for tool_index in env._current_state.inventory:\n            for obstacle_index in env.world.non_grabbable_indices:\n              if can_use_tool_on_obstacle(tool_index, obstacle_index) and\\\n                 env._current_state.grid[nx, ny, obstacle_index] > 0:\n                  actions_to_take.append(craft.USE)\n                  break\n\n  # If no path is found, return an empty list of actions\n  return []", "island_id": 7, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T02:49:24.577237", "function_name": "collect", "function_body": "  def can_use_tool_on_obstacle(tool_index: int, obstacle_index: int):\n    tools = {\n        'AXE': {'WOOD'},\n        'HAMMER': {'ROCK'}\n    }\n    for tool_name, usable_primitives in tools.items():\n      if tool_index == env.world.cookbook.index[tool_name]:\n        return any(obstacle_index == env.world.cookbook.index[p] \n                   for p in usable_primitives)\n    return False\n\n  def is_blocked(x: int, y: int) -> bool:\n    \"\"\"Check if a cell is blocked by an obstacle that can't be bypassed with available tools.\"\"\"\n    for kind_index in env.world.non_grabbable_indices:\n      if env._current_state.grid[x, y, kind_index] > 0 and\\\n         not any(can_use_tool_on_obstacle(tool_index, kind_index) \n                 for tool_index in env._current_state.inventory):\n        return True\n    return False\n\n  def move_towards_target(target_x: int, target_y: int) -> list[int]:\n    \"\"\"Generate actions to move towards a target cell.\"\"\"\n    current_x, current_y = env._current_state.pos\n    # Simple BFS for shortest path to the target\n    queue = collections.deque([(current_x, current_y, [])])\n    visited = set()\n    visited.add((current_x, current_y))\n\n    while queue:\n      x, y, path = queue.popleft()\n      if (x, y) == (target_x, target_y):\n        return path\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = x + dx, y + dy\n        width, height, _ = env._current_state.grid.shape\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          if is_blocked(nx, ny):\n            for tool_index in env._current_state.inventory:\n              if can_use_tool_on_obstacle(tool_index, \n                                         env.world.cookbook.index['WOOD']) or\\\n                 can_use_tool_on_obstacle(tool_index, \n                                         env.world.cookbook.index['ROCK']):\n                  path.append(craft.USE)\n                  break\n            else:\n              continue  # Skip this direction if no tool can clear the obstacle\n          visited.add((nx, ny))\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          queue.append((nx, ny, path + [move_action]))\n\n    return []  # No path found\n\n  def find_target_cells(primitive_index: int) -> list[tuple[int, int]]:\n    \"\"\"Find all cells containing the target primitive.\"\"\"\n    width, height, _ = env._current_state.grid.shape\n    target_cells = []\n    for x in range(width):\n      for y in range(height):\n        if env._current_state.grid[x, y, primitive_index] > 0:\n          target_cells.append((x, y))\n    return target_cells\n\n  # Determine the target primitive index from its name\n  target_primitive_index = env.world.cookbook.index[primitive]\n\n  # Find all cells containing the target primitive\n  target_cells = find_target_cells(target_primitive_index)\n\n  # Initialize an empty list to store the actions needed\n  actions_to_take = []\n\n  for target_x, target_y in target_cells:\n    path = move_towards_target(target_x, target_y)\n    if path:\n      actions_to_take.extend(path + [craft.USE])\n      return actions_to_take\n\n  # If no target primitive is found or reachable, return an empty list of actions\n  return []", "island_id": 7, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T02:50:31.413238", "function_name": "collect", "function_body": "  actions = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  # Helper function to find neighboring positions.\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  # Get the current state of the environment.\n  current_state = env._current_state\n\n  # Define a queue for BFS and a set to track visited positions.\n  queue = collections.deque([(current_state.pos, [], current_state.dir)])\n  visited = set([current_state.pos])\n\n  # Helper function to get the index of a primitive name.\n  def get_primitive_index(primitive_name):\n      return current_state.world.cookbook.index[primitive_name]\n\n  # Get the index for the target primitive.\n  target_primitive_index = get_primitive_index(primitive)\n\n  # Perform BFS to find a path to collect the primitive.\n  while queue:\n      pos, actions_taken, direction = queue.popleft()\n\n      # Check if we are at a cell with the desired primitive.\n      if current_state.grid[pos[0], pos[1], target_primitive_index] > 0:\n          return actions_taken + [actions[\"USE\"]]\n\n      # Get neighboring positions and filter out invalid ones.\n      neighbors = get_neighbors(pos)\n      for neighbor in neighbors:\n          nx, ny = neighbor\n\n          # Ensure the neighbor is within bounds.\n          if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n              # Check if the cell is not blocked by non-grabbable entities.\n              if all(current_state.grid[ny, nx, env_index] == 0 for env_index in current_state.world.non_grabbable_indices):\n                  # If the cell is visited for the first time with this direction, add it to the queue.\n                  if neighbor not in visited:\n                      visited.add(neighbor)\n\n                      # Determine the direction to move towards the neighbor.\n                      dx, dy = nx - pos[0], ny - pos[1]\n                      action_sequence = []\n                      new_direction = None\n\n                      if dx == 1:\n                          new_direction = 3\n                      elif dx == -1:\n                          new_direction = 2\n                      elif dy == 1:\n                          new_direction = 0\n                      else:  # dy == -1\n                          new_direction = 1\n\n                      if direction != new_direction:\n                          # If the current direction is not the target direction, turn first.\n                          action_sequence.append(actions[\"USE\"])  # Turn action placeholder\n                      else:\n                          # Otherwise, move towards the neighbor.\n                          if dx == 1:\n                              action_sequence.append(actions[\"RIGHT\"])\n                          elif dx == -1:\n                              action_sequence.append(actions[\"LEFT\"])\n                          elif dy == 1:\n                              action_sequence.append(actions[\"DOWN\"])\n                          else:  # dy == -1\n                              action_sequence.append(actions[\"UP\"])\n\n                      queue.append((neighbor, actions_taken + action_sequence, new_direction))\n\n  # If no path is found to collect the primitive, return an empty list.\n  return []", "island_id": 2, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T02:50:32.455396", "function_name": "collect", "function_body": "  def get_neighbors(pos):\n    x, y = pos\n    neighbors = []\n    if x > 0:\n      neighbors.append((x - 1, y))\n    if x < env._current_state.grid.shape[1] - 1:\n      neighbors.append((x + 1, y))\n    if y > 0:\n      neighbors.append((x, y - 1))\n    if y < env._current_state.grid.shape[0] - 1:\n      neighbors.append((x, y + 1))\n    return neighbors\n\n  def get_primitive_index(primitive_name):\n    return env._current_state.world.cookbook.index[primitive_name]\n\n  target_primitive_index = get_primitive_index(primitive)\n\n  actions = {\n    \"UP\": 0,\n    \"DOWN\": 1,\n    \"LEFT\": 2,\n    \"RIGHT\": 3,\n    \"USE\": 4\n  }\n\n  queue = collections.deque([(env._current_state.pos, [])])\n  visited = set([env._current_state.pos])\n\n  while queue:\n    pos, actions_taken = queue.popleft()\n\n    if env._current_state.grid[pos[0], pos[1], target_primitive_index] > 0:\n      return actions_taken + [actions[\"USE\"]]\n\n    for neighbor in get_neighbors(pos):\n      nx, ny = neighbor\n      if (nx, ny) not in visited and all(env._current_state.grid[ny, nx, env_index] == 0 for env_index in env._current_state.world.non_grabbable_indices):\n        visited.add((nx, ny))\n        dx, dy = nx - pos[0], ny - pos[1]\n        if dx == -1:\n          queue.append(((nx, ny), actions_taken + [actions[\"LEFT\"]]))\n        elif dx == 1:\n          queue.append(((nx, ny), actions_taken + [actions[\"RIGHT\"]]))\n        elif dy == -1:\n          queue.append(((nx, ny), actions_taken + [actions[\"UP\"]]))\n        else:  # dy == 1\n          queue.append(((nx, ny), actions_taken + [actions[\"DOWN\"]]))\n\n  return []", "island_id": 2, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T02:51:32.182030", "function_name": "collect", "function_body": "  def _find_shortest_path(grid, start_pos, target_kind, inventory):\n    width, height = grid.shape[:2]\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n\n      # Skip the starting position if not already in visited\n      if (x, y) == start_pos and path:\n          continue\n      \n      if grid[x, y].argmax() == target_kind:\n        return path\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          can_move = True\n          \n          # Check if there are obstacles and if the agent has tools to clear them\n          for tool in inventory:\n            if grid[nx, ny][tool]:\n              can_move = False\n              break\n          \n          if can_move or grid[nx, ny].sum() == 1:\n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))\n    \n    return None\n\n  def _get_action_index_from_direction(direction):\n    mapping = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, (0, -1): craft.DOWN, (0, 1): craft.UP}\n    return mapping.get(direction)\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  inventory = [i for i in range(len(current_state.inventory)) if current_state.inventory[i] > 0]\n  \n  primitive_index = current_state.world.cookbook.index.index(primitive)\n  \n  path_to_primitive = _find_shortest_path(grid, pos, primitive_index, inventory)\n\n  actions = []\n  \n  if not path_to_primitive:\n    return []\n\n  for step in path_to_primitive:\n      action_index = _get_action_index_from_direction(step)\n      if action_index is None:\n          continue\n      actions.append(action_index)\n  \n  # Append the USE action to collect the primitive at the target position\n  actions.append(craft.USE)\n\n  return actions", "island_id": 5, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T02:51:33.277700", "function_name": "collect", "function_body": "  def _find_shortest_path(grid, start_pos, target_kind, inventory):\n    width, height = grid.shape[:2]\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n\n      # Skip the starting position if not already in visited\n      if (x, y) == start_pos and path:\n          continue\n      \n      if grid[x, y].argmax() == target_kind:\n        return path\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          can_move = True\n\n          # Check if there are obstacles and if the agent has tools to clear them\n          for tool in inventory:\n              if grid[nx, ny][tool]:\n                  can_move = False\n                  break\n\n          if can_move or grid[nx, ny].sum() == 1:\n              visited.add((nx, ny))\n              queue.append((nx, ny, path + [(dx, dy)]))\n    \n    return None\n\n  def _get_action_index_from_direction(direction):\n    mapping = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, (0, -1): craft.DOWN, (0, 1): craft.UP}\n    return mapping.get(direction)\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  inventory = [i for i in range(len(current_state.inventory)) if current_state.inventory[i] > 0]\n  \n  primitive_index = current_state.world.cookbook.index.index(primitive)\n  \n  path_to_primitive = _find_shortest_path(grid, pos, primitive_index, inventory)\n\n  actions = []\n  \n  if not path_to_primitive:\n    return []\n\n  for step in path_to_primitive:\n      action_index = _get_action_index_from_direction(step)\n      if action_index is None:\n          continue\n      actions.append(action_index)\n  \n  # Append the USE action to collect the primitive at the target position\n  actions.append(craft.USE)\n\n  return actions", "island_id": 5, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T02:53:14.812034", "function_name": "collect", "function_body": "  # Constants for directions\n  RIGHT = craft.RIGHT\n  LEFT = craft.LEFT\n  DOWN = craft.DOWN\n  UP = craft.UP\n  USE = craft.USE\n\n  # Map direction indices to action constants\n  direction_map = {\n      (0, 1): RIGHT,\n      (1, 0): DOWN,\n      (0, -1): LEFT,\n      (-1, 0): UP\n  }\n\n  # Get the index of the primitive from the cookbook index\n  target_index = env.world.cookbook.index[primitive]\n\n  # Current state grid and agent's position/direction\n  grid = env._current_state.grid\n  pos_x, pos_y = env._current_state.pos\n  current_direction = env._current_state.dir\n\n  # Find all positions containing the primitive in the environment\n  target_positions = np.argwhere(grid[:, :, target_index] == 1)\n\n  if not target_positions.size:\n    return []\n\n  def manhattan_distance(p1, p2):\n      \"\"\"Calculate the Manhattan distance between two points.\"\"\"\n      return abs(p1[0] - p2[0]) + abs(p1[1] - p2[1])\n\n  # Determine the closest primitive based on Manhattan distance\n  current_position = (pos_x, pos_y)\n  closest_target = min(target_positions, key=lambda pos: manhattan_distance(current_position, tuple(pos)))\n\n  def find_path_bfs(start, goal):\n      \"\"\"Find a path from start to goal using BFS.\"\"\"\n      queue = collections.deque([start])\n      came_from = {start: None}\n\n      while queue:\n          current = queue.popleft()\n          if current == goal:\n              break\n\n          # Explore neighbors in the order of RIGHT, DOWN, LEFT, UP\n          for direction in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n              next_pos = tuple(np.add(current, direction))\n              \n              # Ensure the position is within grid bounds and not blocked by any primitive\n              if 0 <= next_pos[0] < grid.shape[0] and\\\n                 0 <= next_pos[1] < grid.shape[1]:\n                  if np.all(grid[next_pos[0], next_pos[1]] == 0):\n                      if next_pos not in came_from:\n                          queue.append(next_pos)\n                          came_from[next_pos] = current\n\n      # Reconstruct the path from start to goal\n      path = []\n      while current != start:\n          path.append(current)\n          current = came_from[current]\n      path.reverse()\n      return path\n\n  def get_action_to_move(current_direction, direction_vector):\n      \"\"\"Determine the action needed to move in a given direction.\"\"\"\n      if direction_vector == (0, 1):  # RIGHT\n          return RIGHT if current_direction != LEFT else USE\n      elif direction_vector == (1, 0):  # DOWN\n          return DOWN if current_direction != UP else USE\n      elif direction_vector == (0, -1):  # LEFT\n          return LEFT if current_direction != RIGHT else USE\n      elif direction_vector == (-1, 0):  # UP\n          return UP if current_direction != DOWN else USE\n\n  def update_direction(current_direction, action):\n      \"\"\"Update the agent's direction based on the action taken.\"\"\"\n      direction_to_action = {\n          RIGHT: LEFT,\n          LEFT: RIGHT,\n          DOWN: UP,\n          UP: DOWN\n      }\n      return direction_map.get(direction_vector_from_action(action), current_direction)\n\n  def direction_vector_from_action(action):\n      \"\"\"Convert an action to a direction vector.\"\"\"\n      action_to_direction = {\n          RIGHT: (0, 1),\n          LEFT: (0, -1),\n          DOWN: (1, 0),\n          UP: (-1, 0)\n      }\n      return action_to_direction.get(action, None)\n\n  # Find the shortest path to the closest target\n  start_position = current_position\n  goal_position = tuple(closest_target)\n  path_to_target = find_path_bfs(start_position, goal_position)\n\n  actions = []\n\n  for i in range(len(path_to_target)):\n      current_pos = path_to_target[i]\n      \n      if i < len(path_to_target) - 1:\n          next_pos = path_to_target[i + 1]\n          direction_vector = (next_pos[0] - current_pos[0], next_pos[1] - current_pos[1])\n          \n          action = get_action_to_move(current_direction, direction_vector)\n      else:\n          # At the target position, use the action to collect the primitive\n          action = USE\n\n      actions.append(action)\n\n      # Update agent's direction based on the action taken\n      if i < len(path_to_target) - 1 and action in [RIGHT, LEFT, UP, DOWN]:\n          current_direction = update_direction(current_direction, action)\n\n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-26T02:53:15.804347", "function_name": "collect", "function_body": "  # Define action mapping for movement\n  action_map = {\n      \"RIGHT\": craft.RIGHT,\n      \"LEFT\": craft.LEFT,\n      \"DOWN\": craft.DOWN,\n      \"UP\": craft.UP,\n      \"USE\": craft.USE\n  }\n\n  # Get the index of the primitive from the cookbook index\n  target_index = env.world.cookbook.index[primitive]\n\n  # Current state grid and agent's position/direction\n  grid = env._current_state.grid\n  pos_x, pos_y = env._current_state.pos\n  dir = env._current_state.dir\n\n  # Find all positions containing the primitive in the environment\n  target_positions = np.argwhere(grid[:, :, target_index] == 1)\n\n  if not target_positions.size:\n    return []\n\n  def calculate_manhattan_distance(p1, p2):\n      \"\"\"Calculate the Manhattan distance between two points.\"\"\"\n      return abs(p1[0] - p2[0]) + abs(p1[1] - p2[1])\n\n  # Find the closest primitive using the Manhattan distance\n  closest_target = min(target_positions, key=lambda pos: calculate_manhattan_distance((pos_x, pos_y), tuple(pos)))\n\n  def find_path_bfs(start, goal):\n      \"\"\"Find a path from start to goal using BFS.\"\"\"\n      directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]  # RIGHT, DOWN, LEFT, UP\n      queue = collections.deque([start])\n      came_from = {start: None}\n\n      while queue:\n          current = queue.popleft()\n          if current == goal:\n              break\n\n          for direction in directions:\n              next_pos = tuple(np.add(current, direction))\n              # Ensure the position is within grid bounds and not blocked by any primitive\n              if 0 <= next_pos[0] < grid.shape[0] and\\\n                 0 <= next_pos[1] < grid.shape[1]:\n                  if np.all(grid[next_pos[0], next_pos[1]] == 0):\n                      if next_pos not in came_from:\n                          queue.append(next_pos)\n                          came_from[next_pos] = current\n\n      # Reconstruct the path from start to goal\n      path = []\n      while current != start:\n          path.append(current)\n          current = came_from[current]\n      path.reverse()\n      return path\n\n  def determine_action(current_dir, next_pos):\n      \"\"\"Determine the action needed based on direction differences.\"\"\"\n      dx = next_pos[0] - pos_x\n      dy = next_pos[1] - pos_y\n      \n      if dx == 1:  # Move RIGHT\n          return craft.RIGHT if current_dir != 2 else craft.USE\n      elif dx == -1:  # Move LEFT\n          return craft.LEFT if current_dir != 0 else craft.USE\n      elif dy == 1:  # Move DOWN\n          return craft.DOWN if current_dir != 3 else craft.USE\n      elif dy == -1:  # Move UP\n          return craft.UP if current_dir != 1 else craft.USE\n\n  # Find the path to the closest primitive\n  path_to_target = find_path_bfs((pos_x, pos_y), tuple(closest_target))\n\n  actions = []\n\n  for i in range(len(path_to_target)):\n      next_pos = path_to_target[i]\n      \n      action = determine_action(dir, next_pos)\n\n      actions.append(action)\n\n      # Update agent's direction if an actual move was made\n      if action in [craft.RIGHT, craft.LEFT, craft.UP, craft.DOWN]:\n          dir = {craft.RIGHT: 2, craft.LEFT: 0, craft.DOWN: 3, craft.UP: 1}[action]\n\n      # If at the target position, use the action to collect the primitive\n      if i == len(path_to_target) - 1:\n          actions.append(craft.USE)\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-26T02:54:08.349073", "function_name": "collect", "function_body": "  def _find_shortest_path(grid, start_pos, target_kind, inventory):\n    width, height = grid.shape[:2]\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n      \n      if grid[x, y].argmax() == target_kind and (x, y) != start_pos:\n        return path\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          cell_content_index = grid[nx, ny].argmax()\n          # Allow movement on clear cells or through tools that are available in the inventory\n          if grid[nx, ny].sum() == 1 or inventory[cell_content_index] > 0:  \n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))\n    \n    return None\n\n  def _get_action_index_from_direction(direction):\n    mapping = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, (0, -1): craft.DOWN, (0, 1): craft.UP}\n    return mapping.get(direction)\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  inventory = current_state.inventory\n  \n  primitive_index = current_state.world.cookbook.index.index(primitive)\n  \n  path_to_primitive = _find_shortest_path(grid, pos, primitive_index, inventory)\n  \n  if not path_to_primitive:\n    return []\n  \n  actions = [_get_action_index_from_direction(step) for step in path_to_primitive]\n  actions.append(craft.USE)  # Add action to collect the primitive\n  \n  return actions", "island_id": 9, "scores": {"3": 2.5}}
{"timestamp": "2025-09-26T02:54:09.468050", "function_name": "collect", "function_body": "  def _find_shortest_path(grid, start_pos, target_kind, inventory):\n    width, height = grid.shape[:2]\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n      \n      if grid[x, y].argmax() == target_kind and (x, y) != start_pos:\n        return path\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          cell_content_index = grid[nx, ny].argmax()\n          # Allow movement on clear cells or through tools that are available in the inventory\n          if grid[nx, ny].sum() == 1 or inventory[cell_content_index] > 0:  \n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))\n    \n    return None\n\n  def _get_action_index_from_direction(direction):\n    mapping = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, (0, -1): craft.DOWN, (0, 1): craft.UP}\n    return mapping.get(direction)\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  inventory = current_state.inventory\n  \n  primitive_index = current_state.world.cookbook.index.index(primitive)\n  \n  path_to_primitive = _find_shortest_path(grid, pos, primitive_index, inventory)\n  \n  if not path_to_primitive:\n    return []\n  \n  actions = [_get_action_index_from_direction(step) for step in path_to_primitive]\n  actions.append(craft.USE)  # Add action to collect the primitive\n  \n  return actions", "island_id": 9, "scores": {"3": 2.5}}
{"timestamp": "2025-09-26T02:55:31.237366", "function_name": "collect", "function_body": "  def get_primitive_index(primitive_name):\n      return env._current_state.world.cookbook.index[primitive_name]\n\n  actions = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  current_state = env._current_state\n\n  queue = collections.deque([(current_state.pos, [])])\n  visited = set([current_state.pos])\n\n  target_primitive_index = get_primitive_index(primitive)\n\n  while queue:\n      pos, actions_taken = queue.popleft()\n\n      if current_state.grid[pos[0], pos[1], target_primitive_index] > 0:\n          return actions_taken + [actions[\"USE\"]]\n\n      neighbors = get_neighbors(pos)\n      for neighbor in neighbors:\n          nx, ny = neighbor\n\n          if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n              if all(current_state.grid[ny, nx, env_index] == 0 for env_index in current_state.world.non_grabbable_indices):\n                  if neighbor not in visited:\n                      visited.add(neighbor)\n\n                      dx, dy = nx - pos[0], ny - pos[1]\n                      if dx == 1:\n                          action = actions[\"RIGHT\"]\n                      elif dx == -1:\n                          action = actions[\"LEFT\"]\n                      elif dy == 1:\n                          action = actions[\"DOWN\"]\n                      else:  # dy == -1\n                          action = actions[\"UP\"]\n\n                      queue.append((neighbor, actions_taken + [action]))\n\n      if any(current_state.inventory[tool_index] > 0 and current_state.grid[pos[0], pos[1], tool_index] > 0 for tool_index in current_state.world.grabbable_indices):\n          return actions_taken + [actions[\"USE\"]]\n\n  # Attempt to clear obstacles using available tools.\n  for neighbor in get_neighbors(current_state.pos):\n      nx, ny = neighbor\n\n      if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n          if any(current_state.inventory[tool_index] > 0 and current_state.grid[ny, nx, tool_index] > 0 for tool_index in current_state.world.grabbable_indices):\n              return actions_taken + [actions[\"USE\"]]\n\n      # Check if there's an obstacle that can be cleared.\n      if any(current_state.grid[ny, nx, env_index] > 0 for env_index in current_state.world.non_grabbable_indices):\n          for tool_index in current_state.world.grabbable_indices:\n              if current_state.inventory[tool_index] > 0 and current_state.grid[ny, nx, tool_index] > 0:\n                  return actions_taken + [actions[\"USE\"]]\n\n  # If no path is found to collect the primitive, try moving randomly.\n  random_actions = [np.random.choice([0, 1, 2, 3]) for _ in range(5)]\n  return actions_taken + random_actions", "island_id": 1, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T02:55:32.343403", "function_name": "collect", "function_body": "  def get_primitive_index(primitive_name):\n      return env._current_state.world.cookbook.index[primitive_name]\n\n  actions = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  current_state = env._current_state\n\n  queue = collections.deque([(current_state.pos, [])])\n  visited = set([current_state.pos])\n\n  target_primitive_index = get_primitive_index(primitive)\n\n  while queue:\n      pos, actions_taken = queue.popleft()\n\n      if current_state.grid[pos[0], pos[1], target_primitive_index] > 0:\n          return actions_taken + [actions[\"USE\"]]\n\n      neighbors = get_neighbors(pos)\n      for neighbor in neighbors:\n          nx, ny = neighbor\n\n          if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n              if all(current_state.grid[ny, nx, env_index] == 0 for env_index in current_state.world.non_grabbable_indices):\n                  if neighbor not in visited:\n                      visited.add(neighbor)\n\n                      dx, dy = nx - pos[0], ny - pos[1]\n                      if dx == 1:\n                          action = actions[\"RIGHT\"]\n                      elif dx == -1:\n                          action = actions[\"LEFT\"]\n                      elif dy == 1:\n                          action = actions[\"DOWN\"]\n                      else:  # dy == -1\n                          action = actions[\"UP\"]\n\n                      queue.append((neighbor, actions_taken + [action]))\n\n              if any(current_state.inventory[tool_index] > 0 and current_state.grid[ny, nx, tool_index] > 0 for tool_index in current_state.world.grabbable_indices):\n                  return actions_taken + [actions[\"USE\"]]\n\n      # Check if there's an obstacle that can be cleared.\n      if any(current_state.grid[pos[0], pos[1], env_index] > 0 for env_index in current_state.world.non_grabbable_indices):\n          for tool_index in current_state.world.grabbable_indices:\n              if current_state.inventory[tool_index] > 0 and current_state.grid[pos[0], pos[1], tool_index] > 0:\n                  return actions_taken + [actions[\"USE\"]]\n\n  # If the primitive is not directly reachable, attempt to clear obstacles.\n  for neighbor in get_neighbors(current_state.pos):\n      nx, ny = neighbor\n\n      if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n          if any(current_state.inventory[tool_index] > 0 and current_state.grid[ny, nx, tool_index] > 0 for tool_index in current_state.world.grabbable_indices):\n              return actions_taken + [actions[\"USE\"]]\n\n      # Check if there's an obstacle that can be cleared.\n      if any(current_state.grid[ny, nx, env_index] > 0 for env_index in current_state.world.non_grabbable_indices):\n          for tool_index in current_state.world.grabbable_indices:\n              if current_state.inventory[tool_index] > 0 and current_state.grid[ny, nx, tool_index] > 0:\n                  return actions_taken + [actions[\"USE\"]]\n\n  return []", "island_id": 1, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T02:56:24.114924", "function_name": "collect", "function_body": "  def _find_shortest_path(grid, start_pos, target_kind):\n    width, height = grid.shape[:2]\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n      \n      if grid[x, y].argmax() == target_kind and (x, y) != start_pos:\n        return path\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          # Allow movement on clear cells or through tools that are available in the inventory\n          cell_kind = grid[nx, ny].argmax()\n          if grid[nx, ny].sum() == 1 or inventory[cell_kind] > 0:  \n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))\n    \n    return None\n\n  def _get_action_index_from_direction(direction):\n    mapping = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, (0, -1): craft.DOWN, (0, 1): craft.UP}\n    return mapping.get(direction)\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  inventory = current_state.inventory\n  \n  primitive_index = current_state.world.cookbook.index.index(primitive)\n  \n  path_to_primitive = _find_shortest_path(grid, pos, primitive_index)\n  \n  if not path_to_primitive:\n    return []\n  \n  actions = [_get_action_index_from_direction(step) for step in path_to_primitive]\n  actions.append(craft.USE)  # Add action to collect the primitive\n  \n  return actions", "island_id": 9, "scores": {"3": 2.5}}
