{"timestamp": "2025-09-26T01:13:58.221471", "function_name": "collect", "function_body": "  def _find_shortest_path(grid, start_pos, target_kind, inventory):\n    width, height = grid.shape[:2]\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n      \n      if grid[x, y].argmax() == target_kind and (x, y) != start_pos:\n        return path\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          can_move = True\n          \n          # Check if there are obstacles and if the agent has tools to clear them\n          for tool in inventory:\n            if grid[nx, ny][tool]:\n              can_move = False\n              break\n          \n          if can_move or grid[nx, ny].sum() == 1:\n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))\n    \n    return None\n\n  def _get_action_index_from_direction(direction):\n    mapping = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, (0, -1): craft.DOWN, (0, 1): craft.UP}\n    return mapping.get(direction)\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  inventory = [i for i in range(len(current_state.inventory)) if current_state.inventory[i] > 0]\n  \n  primitive_index = current_state.world.cookbook.index.index(primitive)\n  \n  path_to_primitive = _find_shortest_path(grid, pos, primitive_index, inventory)\n  \n  if not path_to_primitive:\n    return []\n  \n  actions = [_get_action_index_from_direction(step) for step in path_to_primitive]\n  actions.append(craft.USE)  # Add action to collect the primitive\n  \n  return actions", "island_id": 5, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T01:13:59.361325", "function_name": "collect", "function_body": "  def _find_shortest_path(grid, start_pos, target_kind, inventory):\n    width, height = grid.shape[:2]\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n      \n      if grid[x, y].argmax() == target_kind and (x, y) != start_pos:\n        return path\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          can_move = True\n          \n          # Check if there are obstacles and if the agent has tools to clear them\n          for tool in inventory:\n            if grid[nx, ny][tool]:\n              can_move = False\n              break\n          \n          if can_move or grid[nx, ny].sum() == 1:\n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))\n    \n    return None\n\n  def _get_action_index_from_direction(direction):\n    mapping = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, (0, -1): craft.DOWN, (0, 1): craft.UP}\n    return mapping.get(direction)\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  inventory = [i for i in range(len(current_state.inventory)) if current_state.inventory[i] > 0]\n  \n  primitive_index = current_state.world.cookbook.index.index(primitive)\n  \n  path_to_primitive = _find_shortest_path(grid, pos, primitive_index, inventory)\n  \n  if not path_to_primitive:\n    return []\n  \n  actions = [_get_action_index_from_direction(step) for step in path_to_primitive]\n  actions.append(craft.USE)  # Add action to collect the primitive\n  \n  return actions", "island_id": 5, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T01:15:21.105210", "function_name": "collect", "function_body": "  def is_blocked(x, y):\n    for kind_index in env.world.non_grabbable_indices:\n      if env._current_state.grid[x, y, kind_index] > 0 and\\\n         not env.world.cookbook.primitives[kind_index].can_use_on(primitive):\n        return True\n    return False\n\n  def can_use_tool(tool_index, obstacle_index):\n    # Check if the tool can be used on the obstacle\n    for use_case in env.world.cookbook.primitives[tool_index].use_cases:\n      if use_case == obstacle_index:\n        return True\n    return False\n\n  # Determine the target primitive index from its name\n  target_primitive_index = env.world.cookbook.index[primitive]\n\n  # Initialize an empty list to store the actions needed\n  actions_to_take = []\n\n  # Current position of the agent\n  current_x, current_y = env._current_state.pos\n\n  # Get the grid dimensions\n  width, height, _ = env._current_state.grid.shape\n\n  # Use BFS to find the shortest path to the target primitive\n  queue = collections.deque([(current_x, current_y, actions_to_take)])\n  visited = set()\n  visited.add((current_x, current_y))\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    # Check if we are next to a cell containing the target primitive\n    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n      nx, ny = x + dx, y + dy\n\n      # Ensure within bounds and not visited\n      if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n        if env._current_state.grid[nx, ny, target_primitive_index] > 0:\n          # Move to the adjacent cell containing the primitive\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          actions_to_take.extend(path + [move_action])\n\n          # Collect the primitive\n          actions_to_take.append(craft.USE)\n          return actions_to_take\n\n        # Mark as visited and add to queue if not blocked\n        if not is_blocked(nx, ny):\n          visited.add((nx, ny))\n          new_path = path.copy()\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          new_path.append(move_action)\n          queue.append((nx, ny, new_path))\n\n        # Check for tools in inventory to use on obstacles\n        if is_blocked(nx, ny):\n          for tool_index in env._current_state.inventory:\n            for obstacle_index in range(len(env.world.non_grabbable_indices)):\n              if can_use_tool(tool_index, obstacle_index) and\\\n                 env._current_state.grid[nx, ny, obstacle_index] > 0:\n                actions_to_take.append(craft.USE)\n                break\n\n  # If no path is found, return an empty list of actions\n  return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-26T01:15:22.172414", "function_name": "collect", "function_body": "  def can_use_tool_on_obstacle(tool_index: int, obstacle_index: int):\n    # Mock function to determine if a tool can be used on an obstacle\n    tools = {\n        'AXE': {'WOOD'},\n        'HAMMER': {'ROCK'}\n    }\n    for tool_name, usable_primitives in tools.items():\n      if tool_index == env.world.cookbook.index[tool_name]:\n        return any(obstacle_index == env.world.cookbook.index[p] for p in usable_primitives)\n    return False\n\n  def is_blocked(x: int, y: int) -> bool:\n    for kind_index in env.world.non_grabbable_indices:\n      if env._current_state.grid[x, y, kind_index] > 0:\n        return True\n    return False\n\n  # Determine the target primitive index from its name\n  target_primitive_index = env.world.cookbook.index[primitive]\n\n  # Initialize an empty list to store the actions needed\n  actions_to_take = []\n\n  # Current position of the agent\n  current_x, current_y = env._current_state.pos\n\n  # Get the grid dimensions\n  width, height, _ = env._current_state.grid.shape\n\n  # Use BFS to find the shortest path to the target primitive\n  queue = collections.deque([(current_x, current_y, actions_to_take)])\n  visited = set()\n  visited.add((current_x, current_y))\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    # Check if we are next to a cell containing the target primitive\n    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n      nx, ny = x + dx, y + dy\n\n      # Ensure within bounds and not visited\n      if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n        if env._current_state.grid[nx, ny, target_primitive_index] > 0:\n          # Move to the adjacent cell containing the primitive\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          actions_to_take.extend(path + [move_action])\n\n          # Collect the primitive\n          actions_to_take.append(craft.USE)\n          return actions_to_take\n\n        # Mark as visited and add to queue if not blocked\n        if not is_blocked(nx, ny):\n          visited.add((nx, ny))\n          new_path = path.copy()\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          new_path.append(move_action)\n          queue.append((nx, ny, new_path))\n\n        # Check for tools in inventory to use on obstacles\n        if is_blocked(nx, ny):\n          for tool_index in env._current_state.inventory:\n            for obstacle_index in env.world.non_grabbable_indices:\n              if can_use_tool_on_obstacle(tool_index, obstacle_index) and\\\n                 env._current_state.grid[nx, ny, obstacle_index] > 0:\n                  actions_to_take.append(craft.USE)\n                  break\n\n  # If no path is found, return an empty list of actions\n  return []", "island_id": 7, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T01:16:31.093872", "function_name": "collect", "function_body": "  actions = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  # Helper function to find neighboring positions.\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  # Get the current state of the environment.\n  current_state = env._current_state\n\n  # Define a queue for BFS and a set to track visited positions.\n  queue = collections.deque([(current_state.pos, [])])\n  visited = set([current_state.pos])\n\n  # Helper function to get the index of a primitive name.\n  def get_primitive_index(primitive_name):\n      return current_state.world.cookbook.index[primitive_name]\n\n  # Get the index for the target primitive.\n  target_primitive_index = get_primitive_index(primitive)\n\n  # Perform BFS to find a path to collect the primitive.\n  while queue:\n      pos, actions_taken = queue.popleft()\n\n      # Check if we are at a cell with the desired primitive.\n      if current_state.grid[pos[0], pos[1], target_primitive_index] > 0:\n          return actions_taken + [actions[\"USE\"]]\n\n      # Get neighboring positions and filter out invalid ones.\n      neighbors = get_neighbors(pos)\n      for neighbor in neighbors:\n          nx, ny = neighbor\n\n          # Ensure the neighbor is within bounds.\n          if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n              # Check if the cell is not blocked by non-grabbable entities.\n              if all(current_state.grid[ny, nx, env_index] == 0 for env_index in current_state.world.non_grabbable_indices):\n                  # If the cell is visited for the first time, add it to the queue.\n                  if neighbor not in visited:\n                      visited.add(neighbor)\n\n                      # Determine the direction to move towards the neighbor.\n                      dx, dy = nx - pos[0], ny - pos[1]\n                      action = None\n                      if dx == 1:\n                          action = actions[\"RIGHT\"]\n                      elif dx == -1:\n                          action = actions[\"LEFT\"]\n                      elif dy == 1:\n                          action = actions[\"DOWN\"]\n                      else:  # dy == -1\n                          action = actions[\"UP\"]\n\n                      queue.append((neighbor, actions_taken + [action]))\n\n  # If no path is found to collect the primitive, return an empty list.\n  return []", "island_id": 2, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T01:16:32.144234", "function_name": "collect", "function_body": "  actions = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  # Helper function to find neighboring positions.\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  # Get the current state of the environment.\n  current_state = env._current_state\n\n  # Define a queue for BFS and a set to track visited positions.\n  queue = collections.deque([(current_state.pos, [], None)])\n  visited = set([current_state.pos])\n\n  # Helper function to get the index of a primitive name.\n  def get_primitive_index(primitive_name):\n      return current_state.world.cookbook.index[primitive_name]\n\n  # Get the index for the target primitive.\n  target_primitive_index = get_primitive_index(primitive)\n\n  # Perform BFS to find a path to collect the primitive.\n  while queue:\n      pos, actions_taken, last_action = queue.popleft()\n\n      # Check if we are at a cell with the desired primitive.\n      if current_state.grid[pos[0], pos[1], target_primitive_index] > 0:\n          return actions_taken + [actions[\"USE\"]]\n\n      # Get neighboring positions and filter out invalid ones.\n      neighbors = get_neighbors(pos)\n      for neighbor in neighbors:\n          nx, ny = neighbor\n\n          # Ensure the neighbor is within bounds.\n          if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n              # Check if the cell is not blocked by non-grabbable entities.\n              if all(current_state.grid[ny, nx, env_index] == 0 for env_index in current_state.world.non_grabbable_indices):\n                  # If the cell is visited for the first time, add it to the queue.\n                  if neighbor not in visited:\n                      visited.add(neighbor)\n\n                      # Determine the direction to move towards the neighbor.\n                      dx, dy = nx - pos[0], ny - pos[1]\n                      if dx == 1:\n                          action = actions[\"RIGHT\"]\n                      elif dx == -1:\n                          action = actions[\"LEFT\"]\n                      elif dy == 1:\n                          action = actions[\"DOWN\"]\n                      else:  # dy == -1\n                          action = actions[\"UP\"]\n\n                      # Avoid oscillation by not going back in the same direction.\n                      if last_action is None or (action != last_action and (actions[\"RIGHT\"] + actions[\"LEFT\"] != action + last_action) and (actions[\"UP\"] + actions[\"DOWN\"] != action + last_action)):\n                          queue.append((neighbor, actions_taken + [action], action))\n\n  # If no path is found to collect the primitive, return an empty list.\n  return []", "island_id": 2, "scores": {"3": 2.0}}
{"timestamp": "2025-09-26T01:17:42.527978", "function_name": "collect", "function_body": "  def bfs(current_state, target_primitive_index):\n      actions = {\n          \"UP\": 0,\n          \"DOWN\": 1,\n          \"LEFT\": 2,\n          \"RIGHT\": 3,\n          \"USE\": 4\n      }\n\n      # Helper function to find neighboring positions.\n      def get_neighbors(pos):\n          x, y = pos\n          return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n      # Define a queue for BFS and a set to track visited positions.\n      queue = collections.deque([(current_state.pos, [], current_state.dir)])\n      visited = set([current_state.pos])\n\n      while queue:\n          pos, actions_taken, direction = queue.popleft()\n\n          # Check if we are at a cell with the desired primitive.\n          if current_state.grid[pos[1], pos[0], target_primitive_index] > 0:\n              return actions_taken + [actions[\"USE\"]]\n\n          # Get neighboring positions and filter out invalid ones.\n          neighbors = get_neighbors(pos)\n          for neighbor in neighbors:\n              nx, ny = neighbor\n\n              # Ensure the neighbor is within bounds.\n              if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n                  # Check if the cell is not blocked by non-grabbable entities.\n                  if all(current_state.grid[ny, nx, env_index] == 0 for env_index in current_state.world.non_grabbable_indices):\n                      # If the cell is visited for the first time, add it to the queue.\n                      if neighbor not in visited:\n                          visited.add(neighbor)\n\n                          # Determine the direction to move towards the neighbor.\n                          dx, dy = nx - pos[0], ny - pos[1]\n                          if dx == 1:\n                              action = actions[\"RIGHT\"]\n                              new_direction = 3\n                          elif dx == -1:\n                              action = actions[\"LEFT\"]\n                              new_direction = 2\n                          elif dy == 1:\n                              action = actions[\"DOWN\"]\n                              new_direction = 0\n                          else:  # dy == -1\n                              action = actions[\"UP\"]\n                              new_direction = 1\n\n                          if direction != new_direction:\n                              # If the current direction is not the target direction, turn first.\n                              queue.append((neighbor, actions_taken + [action], new_direction))\n                          else:\n                              # Otherwise, move towards the neighbor.\n                              queue.append((neighbor, actions_taken + [action], new_direction))\n\n      return []\n\n  # Get the current state of the environment.\n  current_state = env._current_state\n\n  # Helper function to get the index of a primitive name.\n  def get_primitive_index(primitive_name):\n      return current_state.world.cookbook.index[primitive_name]\n\n  # Get the index for the target primitive.\n  target_primitive_index = get_primitive_index(primitive)\n\n  # Perform BFS to find a path to collect the primitive.\n  actions_to_take = bfs(current_state, target_primitive_index)\n  \n  return actions_to_take", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-09-26T01:17:43.588459", "function_name": "collect", "function_body": "  actions = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  # Helper function to find neighboring positions.\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  # Get the current state of the environment.\n  current_state = env._current_state\n\n  # Define a queue for BFS and a set to track visited positions.\n  queue = collections.deque([(current_state.pos, [], current_state.dir)])\n  visited = set()\n\n  # Helper function to get the index of a primitive name.\n  def get_primitive_index(primitive_name):\n      return current_state.world.cookbook.index[primitive_name]\n\n  # Get the index for the target primitive.\n  target_primitive_index = get_primitive_index(primitive)\n\n  while queue:\n      pos, actions_taken, direction = queue.popleft()\n\n      if (pos, direction) in visited:\n          continue\n      visited.add((pos, direction))\n\n      # Check if we are at a cell with the desired primitive.\n      if current_state.grid[pos[0], pos[1], target_primitive_index] > 0:\n          return actions_taken + [actions[\"USE\"]]\n\n      neighbors = get_neighbors(pos)\n      for neighbor in neighbors:\n          nx, ny = neighbor\n\n          # Ensure the neighbor is within bounds.\n          if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n              # Check if the cell is not blocked by non-grabbable entities.\n              if all(current_state.grid[ny, nx, env_index] == 0 for env_index in current_state.world.non_grabbable_indices):\n                  # Determine the direction to move towards the neighbor.\n                  dx, dy = nx - pos[0], ny - pos[1]\n                  if dx == 1:\n                      action = actions[\"RIGHT\"]\n                      new_direction = 3\n                  elif dx == -1:\n                      action = actions[\"LEFT\"]\n                      new_direction = 2\n                  elif dy == 1:\n                      action = actions[\"DOWN\"]\n                      new_direction = 0\n                  else:  # dy == -1\n                      action = actions[\"UP\"]\n                      new_direction = 1\n\n                  if direction != new_direction:\n                      queue.append((pos, actions_taken + [action], new_direction))\n                  else:\n                      queue.append((neighbor, actions_taken + [action], new_direction))\n\n  return []", "island_id": 2, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T01:19:05.503743", "function_name": "collect", "function_body": "  actions = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  # Helper function to find neighboring positions.\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  # Get the current state of the environment.\n  current_state = env._current_state\n\n  # Define a queue for BFS and a set to track visited positions.\n  queue = collections.deque([(current_state.pos, [])])\n  visited = set([current_state.pos])\n\n  # Helper function to get the index of a primitive name.\n  def get_primitive_index(primitive_name):\n      return current_state.world.cookbook.index[primitive_name]\n\n  # Get the index for the target primitive.\n  target_primitive_index = get_primitive_index(primitive)\n\n  # Perform BFS to find a path to collect the primitive.\n  while queue:\n      pos, actions_taken = queue.popleft()\n\n      # Check if we are at a cell with the desired primitive.\n      if current_state.grid[pos[0], pos[1], target_primitive_index] > 0:\n          return actions_taken + [actions[\"USE\"]]\n\n      # Get neighboring positions and filter out invalid ones.\n      neighbors = get_neighbors(pos)\n      for neighbor in neighbors:\n          nx, ny = neighbor\n\n          # Ensure the neighbor is within bounds.\n          if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n              # Check if the cell is not blocked by non-grabbable entities or tools in inventory can be used to clear the path.\n              if all(current_state.grid[ny, nx, env_index] == 0 for env_index in current_state.world.non_grabbable_indices):\n                  # If the cell is visited for the first time, add it to the queue.\n                  if neighbor not in visited:\n                      visited.add(neighbor)\n\n                      # Determine the direction to move towards the neighbor.\n                      dx, dy = nx - pos[0], ny - pos[1]\n                      if dx == 1:\n                          action = actions[\"RIGHT\"]\n                      elif dx == -1:\n                          action = actions[\"LEFT\"]\n                      elif dy == 1:\n                          action = actions[\"DOWN\"]\n                      else:  # dy == -1\n                          action = actions[\"UP\"]\n\n                      queue.append((neighbor, actions_taken + [action]))\n              else:\n                  # Check if any tool in inventory can be used to clear the path.\n                  for tool_index in current_state.world.grabbable_indices:\n                      if current_state.inventory[tool_index] > 0 and current_state.grid[ny, nx, tool_index] > 0:\n                          # Use the tool to clear the obstacle.\n                          return actions_taken + [actions[\"USE\"]]\n                  else:\n                      # If no tools can be used, continue searching.\n                      pass\n  \n  # If no path is found to collect the primitive, return an empty list.\n  return []", "island_id": 1, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T01:19:06.593204", "function_name": "collect", "function_body": "  actions = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  # Helper function to find neighboring positions.\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  # Get the current state of the environment.\n  current_state = env._current_state\n\n  # Define a queue for BFS and a set to track visited positions.\n  queue = collections.deque([(current_state.pos, [])])\n  visited = set([current_state.pos])\n\n  # Helper function to get the index of a primitive name.\n  def get_primitive_index(primitive_name):\n      return current_state.world.cookbook.index[primitive_name]\n\n  # Get the index for the target primitive.\n  target_primitive_index = get_primitive_index(primitive)\n\n  # Perform BFS to find a path to collect the primitive.\n  while queue:\n      pos, actions_taken = queue.popleft()\n\n      # Check if we are at a cell with the desired primitive.\n      if current_state.grid[pos[0], pos[1], target_primitive_index] > 0:\n          return actions_taken + [actions[\"USE\"]]\n\n      # Get neighboring positions and filter out invalid ones.\n      neighbors = get_neighbors(pos)\n      for neighbor in neighbors:\n          nx, ny = neighbor\n\n          # Ensure the neighbor is within bounds.\n          if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n              # Check if the cell is not blocked by non-grabbable entities or tools in inventory can be used to clear the path.\n              if all(current_state.grid[ny, nx, env_index] == 0 for env_index in current_state.world.non_grabbable_indices):\n                  # If the cell is visited for the first time, add it to the queue.\n                  if neighbor not in visited:\n                      visited.add(neighbor)\n\n                      # Determine the direction to move towards the neighbor.\n                      dx, dy = nx - pos[0], ny - pos[1]\n                      if dx == 1:\n                          action = actions[\"RIGHT\"]\n                      elif dx == -1:\n                          action = actions[\"LEFT\"]\n                      elif dy == 1:\n                          action = actions[\"DOWN\"]\n                      else:  # dy == -1\n                          action = actions[\"UP\"]\n\n                      queue.append((neighbor, actions_taken + [action]))\n              else:\n                  # Check if any tool in inventory can be used to clear the path.\n                  for tool_index in current_state.world.grabbable_indices:\n                      if current_state.inventory[tool_index] > 0 and current_state.grid[ny, nx, tool_index] > 0:\n                          # Use the tool to clear the obstacle.\n                          return actions_taken + [actions[\"USE\"]]\n  \n      # Check for tools that can be used to clear obstacles dynamically.\n      for tool_index in current_state.world.grabbable_indices:\n          if current_state.inventory[tool_index] > 0:\n              for nx, ny in get_neighbors(pos):\n                  if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n                      if current_state.grid[ny, nx, env_index] == 0 and current_state.grid[ny, nx, tool_index] > 0:\n                          # Use the tool to clear the obstacle.\n                          return actions_taken + [actions[\"USE\"]]\n  \n  # If no path is found to collect the primitive, return an empty list.\n  return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-26T01:20:10.481350", "function_name": "collect", "function_body": "  def is_blocked(x, y):\n    for kind_index in env.world.non_grabbable_indices:\n      if env._current_state.grid[x, y, kind_index] > 0 and kind_index not in env._current_state.inventory:\n        return True\n    return False\n\n  # Determine the target primitive index from its name\n  target_primitive_index = env.world.cookbook.index[primitive]\n\n  # Initialize an empty list to store the actions needed\n  actions_to_take = []\n\n  # Current position of the agent\n  current_x, current_y = env._current_state.pos\n\n  # Get the grid dimensions\n  width, height, _ = env._current_state.grid.shape\n\n  # Use BFS to find the shortest path to the target primitive\n  queue = collections.deque([(current_x, current_y, actions_to_take)])\n  visited = set()\n  visited.add((current_x, current_y))\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    # Check if we are next to a cell containing the target primitive\n    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n      nx, ny = x + dx, y + dy\n\n      # Ensure within bounds and not visited\n      if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n        if env._current_state.grid[nx, ny, target_primitive_index] > 0:\n          # Move to the adjacent cell containing the primitive\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          actions_to_take.extend(path + [move_action])\n\n          # Collect the primitive\n          actions_to_take.append(craft.USE)\n          return actions_to_take\n\n        # Mark as visited and add to queue if not blocked\n        if not is_blocked(nx, ny):\n          visited.add((nx, ny))\n          new_path = path.copy()\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          new_path.append(move_action)\n          queue.append((nx, ny, new_path))\n\n  # If no path is found, return an empty list of actions\n  return []", "island_id": 6, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T01:20:11.574697", "function_name": "collect", "function_body": "  def is_blocked(x, y):\n    for kind_index in env.world.non_grabbable_indices:\n      if env._current_state.grid[x, y, kind_index] > 0 and \\\n         kind_index not in env._current_state.inventory:\n        return True\n    return False\n\n  # Determine the target primitive index from its name\n  target_primitive_index = env.world.cookbook.index[primitive]\n\n  # Initialize an empty list to store the actions needed\n  actions_to_take = []\n\n  # Current position of the agent\n  current_x, current_y = env._current_state.pos\n\n  # Get the grid dimensions\n  width, height, _ = env._current_state.grid.shape\n\n  # Use BFS to find the shortest path to the target primitive\n  queue = collections.deque([(current_x, current_y, actions_to_take)])\n  visited = set()\n  visited.add((current_x, current_y))\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    # Check if we are next to a cell containing the target primitive\n    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n      nx, ny = x + dx, y + dy\n\n      # Ensure within bounds and not visited\n      if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n        if env._current_state.grid[nx, ny, target_primitive_index] > 0:\n          # Move to the adjacent cell containing the primitive\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          actions_to_take.extend(path + [move_action])\n\n          # Collect the primitive\n          actions_to_take.append(craft.USE)\n          return actions_to_take\n\n        # Mark as visited and add to queue if not blocked\n        if not is_blocked(nx, ny):\n          visited.add((nx, ny))\n          new_path = path.copy()\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          new_path.append(move_action)\n          queue.append((nx, ny, new_path))\n\n  # If no path is found, return an empty list of actions\n  return []", "island_id": 6, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T01:21:32.692908", "function_name": "collect", "function_body": "  index = env.world.cookbook.index[primitive]\n  grid = env._current_state.grid\n  pos_x, pos_y = env._current_state.pos\n  dir = env._current_state.dir\n\n  target_positions = np.argwhere(grid[:, :, index] == 1)\n\n  if len(target_positions) == 0:\n    return []\n\n  distances = [(pos_x - tx, pos_y - ty) for tx, ty in target_positions]\n  distances = [abs(dx) + abs(dy) for dx, dy in distances]\n\n  min_distance_index = np.argmin(distances)\n  closest_target_pos = tuple(target_positions[min_distance_index])\n\n  def find_path(start, goal):\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]  # RIGHT, DOWN, LEFT, UP\n    queue = collections.deque([start])\n    came_from = {start: None}\n    \n    while queue:\n      current = queue.popleft()\n      \n      if current == goal:\n        break\n      \n      for direction in directions:\n        next_pos = tuple(np.add(current, direction))\n        \n        # Check if the next position is within bounds and not blocked\n        if 0 <= next_pos[0] < grid.shape[0] and\\\n           0 <= next_pos[1] < grid.shape[1]:\n          if np.all(grid[next_pos[0], next_pos[1]] == 0):\n            if next_pos not in came_from:\n              queue.append(next_pos)\n              came_from[next_pos] = current\n    \n    # Reconstruct the path from start to goal\n    path = []\n    while current != start:\n      path.append(current)\n      current = came_from[current]\n    path.reverse()\n    \n    return path\n\n  def get_direction_to_target(current_dir, dx, dy):\n    if dx == 1:  # Move RIGHT\n      return craft.RIGHT if current_dir != 2 else craft.USE\n    elif dx == -1:  # Move LEFT\n      return craft.LEFT if current_dir != 0 else craft.USE\n    elif dy == 1:  # Move DOWN\n      return craft.DOWN if current_dir != 3 else craft.USE\n    elif dy == -1:  # Move UP\n      return craft.UP if current_dir != 1 else craft.USE\n\n  path = find_path((pos_x, pos_y), closest_target_pos)\n  actions = []\n\n  for i in range(len(path)):\n    current_pos = path[i]\n    \n    # Calculate the direction to move from the current position to the next position\n    if i < len(path) - 1:\n      next_pos = path[i + 1]\n      delta_x = next_pos[0] - current_pos[0]\n      delta_y = next_pos[1] - current_pos[1]\n      \n      action = get_direction_to_target(dir, delta_x, delta_y)\n    else:\n      # If we are at the target position, use the action to collect the primitive\n      action = craft.USE\n\n    actions.append(action)\n\n  return actions", "island_id": 3, "scores": {"3": 0.2}}
{"timestamp": "2025-09-26T01:21:33.781285", "function_name": "collect", "function_body": "  def is_walkable(pos):\n    x, y = pos\n    # Check if the position is within bounds and walkable (no obstacles)\n    return (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1] and\n            np.all(grid[x, y] == 0))\n\n  def heuristic(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def find_path(start, goal):\n    open_set = set([start])\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, goal)}\n\n    while open_set:\n      current = min(open_set, key=lambda k: f_score[k])\n\n      if current == goal:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        return path[::-1]\n\n      open_set.remove(current)\n\n      for direction in [(0, 1), (1, 0), (0, -1), (-1, 0)]:  # RIGHT, DOWN, LEFT, UP\n        neighbor = tuple(np.add(current, direction))\n\n        if is_walkable(neighbor):\n          tentative_g_score = g_score[current] + heuristic(current, neighbor)\n\n          if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n            came_from[neighbor] = current\n            g_score[neighbor] = tentative_g_score\n            f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n            open_set.add(neighbor)\n\n    return None  # No path found\n\n  def get_direction_to_target(current_dir, dx, dy):\n    if dx == 1:  # Move RIGHT\n      return craft.RIGHT if current_dir != 2 else craft.USE\n    elif dx == -1:  # Move LEFT\n      return craft.LEFT if current_dir != 0 else craft.USE\n    elif dy == 1:  # Move DOWN\n      return craft.DOWN if current_dir != 3 else craft.USE\n    elif dy == -1:  # Move UP\n      return craft.UP if current_dir != 1 else craft.USE\n\n  index = env.world.cookbook.index[primitive]\n  grid = env._current_state.grid\n  pos_x, pos_y = env._current_state.pos\n  dir = env._current_state.dir\n\n  target_positions = np.argwhere(grid[:, :, index] == 1)\n\n  if len(target_positions) == 0:\n    return []\n\n  distances = [(pos_x - tx, pos_y - ty) for tx, ty in target_positions]\n  distances = [abs(dx) + abs(dy) for dx, dy in distances]\n\n  min_distance_index = np.argmin(distances)\n  closest_target_pos = tuple(target_positions[min_distance_index])\n\n  path = find_path((pos_x, pos_y), closest_target_pos)\n\n  if not path:\n    return []\n\n  actions = []\n  current_pos = (pos_x, pos_y)\n\n  for next_pos in path:\n    dx = next_pos[0] - current_pos[0]\n    dy = next_pos[1] - current_pos[1]\n\n    action = get_direction_to_target(dir, dx, dy)\n    actions.append(action)\n\n    if action == craft.RIGHT:\n      dir = 2\n    elif action == craft.LEFT:\n      dir = 0\n    elif action == craft.DOWN:\n      dir = 3\n    elif action == craft.UP:\n      dir = 1\n\n    current_pos = next_pos\n\n  # Add the USE action to collect the primitive at the target position\n  actions.append(craft.USE)\n\n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-26T01:22:28.480700", "function_name": "collect", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Get the index of the target primitive\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Helper function to check if a cell is blocked\n  def is_blocked(x, y):\n    return any(env._current_state.grid[x, y] > 0) and not env._current_state.grid[x, y][primitive_index]\n\n  # Directions and their corresponding actions\n  directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n  action_map = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, \n                (0, -1): craft.DOWN, (0, 1): craft.UP}\n\n  # BFS to find the shortest path to a cell containing the primitive\n  start_x, start_y = env._current_state.pos\n  visited = set()\n  queue = deque([(start_x, start_y, [])])  # (x, y, path)\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    if (x, y) in visited:\n      continue\n\n    visited.add((x, y))\n\n    for dx, dy in directions:\n      nx, ny = x + dx, y + dy\n      \n      # Check bounds\n      if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n        # If the cell contains the primitive, return the path to it\n        if env._current_state.grid[nx, ny][primitive_index] > 0:\n          move_action = action_map[(dx, dy)]\n          use_action = craft.USE\n          return path + [move_action, use_action]\n        \n        # If the cell is not blocked and hasn't been visited, add to queue\n        if not is_blocked(nx, ny):\n          move_action = action_map[(dx, dy)]\n          queue.append((nx, ny, path + [move_action]))\n  \n  return []  # Return an empty list if no path found", "island_id": 4, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T01:22:29.608846", "function_name": "collect", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Get the index of the target primitive\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Helper function to check if a cell is blocked by obstacles or other items\n  def is_blocked(x, y):\n    return any(env._current_state.grid[x, y] > 0) and not env._current_state.grid[x, y][primitive_index]\n\n  # Directions and their corresponding actions\n  directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n  action_map = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, \n                (0, -1): craft.DOWN, (0, 1): craft.UP}\n\n  # BFS to find the shortest path to a cell containing the primitive\n  start_x, start_y = env._current_state.pos\n  visited = set()\n  queue = deque([(start_x, start_y, [])])  # (x, y, path)\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    if (x, y) in visited:\n      continue\n\n    visited.add((x, y))\n\n    for dx, dy in directions:\n      nx, ny = x + dx, y + dy\n      \n      # Check bounds\n      if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n        # If the cell contains the primitive, return the path to it\n        if env._current_state.grid[nx, ny][primitive_index] > 0:\n          move_action = action_map[(dx, dy)]\n          use_action = craft.USE\n          return path + [move_action, use_action]\n        \n        # If the cell is not blocked and hasn't been visited, add to queue\n        if not is_blocked(nx, ny):\n          move_action = action_map[(dx, dy)]\n          queue.append((nx, ny, path + [move_action]))\n  \n  return []  # Return an empty list if no path found", "island_id": 4, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T01:23:40.627665", "function_name": "collect", "function_body": "  actions = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  current_state = env._current_state\n\n  queue = collections.deque([(current_state.pos, [])])\n  visited = set([current_state.pos])\n\n  def get_primitive_index(primitive_name):\n      return current_state.world.cookbook.index[primitive_name]\n\n  target_primitive_index = get_primitive_index(primitive)\n\n  while queue:\n      pos, actions_taken = queue.popleft()\n\n      if current_state.grid[pos[0], pos[1], target_primitive_index] > 0:\n          return actions_taken + [actions[\"USE\"]]\n\n      neighbors = get_neighbors(pos)\n      for neighbor in neighbors:\n          nx, ny = neighbor\n\n          # Ensure the neighbor is within bounds.\n          if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n              # Check if the cell is not blocked by non-grabbable entities or can be cleared with tools.\n              if all(current_state.grid[ny, nx, env_index] == 0 for env_index in current_state.world.non_grabbable_indices):\n                  if neighbor not in visited:\n                      visited.add(neighbor)\n\n                      dx, dy = nx - pos[0], ny - pos[1]\n                      if dx == 1:\n                          action = actions[\"RIGHT\"]\n                      elif dx == -1:\n                          action = actions[\"LEFT\"]\n                      elif dy == 1:\n                          action = actions[\"DOWN\"]\n                      else:  # dy == -1\n                          action = actions[\"UP\"]\n\n                      queue.append((neighbor, actions_taken + [action]))\n              else:\n                  # Check if any tool in inventory can be used to clear the path.\n                  for tool_index in current_state.world.grabbable_indices:\n                      if current_state.inventory[tool_index] > 0 and current_state.grid[ny, nx, tool_index] == 1:\n                          return actions_taken + [actions[\"USE\"]]\n\n      # Check if any tool in inventory can be used to clear the path.\n      for neighbor in get_neighbors(pos):\n          nx, ny = neighbor\n\n          if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n              for tool_index in current_state.world.grabbable_indices:\n                  if current_state.inventory[tool_index] > 0 and current_state.grid[ny, nx, tool_index] == 1:\n                      return actions_taken + [actions[\"USE\"]]\n\n  return []", "island_id": 1, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T01:23:41.674768", "function_name": "collect", "function_body": "  def get_primitive_index(primitive_name):\n      return env._current_state.world.cookbook.index[primitive_name]\n\n  actions = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  current_state = env._current_state\n\n  queue = collections.deque([(current_state.pos, [])])\n  visited = set([current_state.pos])\n\n  target_primitive_index = get_primitive_index(primitive)\n\n  while queue:\n      pos, actions_taken = queue.popleft()\n\n      if current_state.grid[pos[0], pos[1], target_primitive_index] > 0:\n          return actions_taken + [actions[\"USE\"]]\n\n      neighbors = get_neighbors(pos)\n      for neighbor in neighbors:\n          nx, ny = neighbor\n\n          # Ensure the neighbor is within bounds.\n          if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n              # Check if the cell is not blocked by non-grabbable entities or can be cleared with tools.\n              if all(current_state.grid[ny, nx, env_index] == 0 for env_index in current_state.world.non_grabbable_indices):\n                  if neighbor not in visited:\n                      visited.add(neighbor)\n\n                      dx, dy = nx - pos[0], ny - pos[1]\n                      action = {\n                          (1, 0): actions[\"RIGHT\"],\n                          (-1, 0): actions[\"LEFT\"],\n                          (0, 1): actions[\"DOWN\"],\n                          (0, -1): actions[\"UP\"]\n                      }[(dx, dy)]\n\n                      queue.append((neighbor, actions_taken + [action]))\n              else:\n                  # Check if any tool in inventory can be used to clear the path.\n                  for tool_index in current_state.world.grabbable_indices:\n                      if current_state.inventory[tool_index] > 0 and current_state.grid[ny, nx, tool_index] > 0:\n                          return actions_taken + [actions[\"USE\"]]\n\n  # Attempt to clear obstacles using available tools if we reach a dead end.\n  for neighbor in get_neighbors(current_state.pos):\n      nx, ny = neighbor\n\n      # Ensure the neighbor is within bounds.\n      if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n          # Check if any tool in inventory can be used to clear the path.\n          for tool_index in current_state.world.grabbable_indices:\n              if current_state.inventory[tool_index] > 0 and current_state.grid[ny, nx, tool_index] > 0:\n                  return [actions[\"USE\"]]\n\n  return []", "island_id": 1, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T01:24:37.776130", "function_name": "collect", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Get the index of the target primitive\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Helper function to check if a cell is blocked by obstacles or other items, except for the target primitive itself\n  def is_blocked(x, y):\n    return any(env._current_state.grid[x, y] > 0) and env._current_state.grid[x, y][primitive_index] == 0\n\n  # Directions and their corresponding actions\n  directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n  action_map = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, \n                (0, -1): craft.DOWN, (0, 1): craft.UP}\n\n  # BFS to find the shortest path to a cell containing the primitive\n  start_x, start_y = env._current_state.pos\n  visited = set()\n  queue = deque([(start_x, start_y, [])])  # (x, y, path)\n  \n  while queue:\n    x, y, path = queue.popleft()\n\n    if (x, y) in visited:\n      continue\n\n    visited.add((x, y))\n\n    for dx, dy in directions:\n      nx, ny = x + dx, y + dy\n      \n      # Check bounds\n      if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n        # If the cell contains the primitive, return the path to it\n        if env._current_state.grid[nx, ny][primitive_index] > 0:\n          move_action = action_map[(dx, dy)]\n          use_action = craft.USE\n          return path + [move_action, use_action]\n        \n        # If the cell is not blocked and hasn't been visited, add to queue\n        if not is_blocked(nx, ny):\n          move_action = action_map[(dx, dy)]\n          queue.append((nx, ny, path + [move_action]))\n  \n  return []  # Return an empty list if no path found", "island_id": 4, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T01:24:38.842326", "function_name": "collect", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Get the index of the target primitive\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Helper function to check if a cell is blocked by obstacles or other items, except for the target primitive itself\n  def is_blocked(x, y):\n    return any(env._current_state.grid[x, y] > 0) and not (env._current_state.grid[x, y][primitive_index] > 0)\n\n  # Directions and their corresponding actions\n  directions = [(0, -1), (0, 1), (-1, 0), (1, 0)]\n  action_map = {(0, -1): craft.DOWN, (0, 1): craft.UP, \n                (-1, 0): craft.LEFT, (1, 0): craft.RIGHT}\n\n  # BFS to find the shortest path to a cell containing the primitive\n  start_x, start_y = env._current_state.pos\n  visited = set()\n  queue = deque([(start_x, start_y, [])])  # (x, y, path)\n  \n  while queue:\n    x, y, path = queue.popleft()\n\n    if (x, y) in visited:\n      continue\n\n    visited.add((x, y))\n\n    for dx, dy in directions:\n      nx, ny = x + dx, y + dy\n      \n      # Check bounds\n      if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n        # If the cell contains the primitive, return the path to it\n        if env._current_state.grid[nx, ny][primitive_index] > 0:\n          move_action = action_map[(dx, dy)]\n          use_action = craft.USE\n          return path + [move_action, use_action]\n        \n        # If the cell is not blocked and hasn't been visited, add to queue\n        if not is_blocked(nx, ny):\n          move_action = action_map[(dx, dy)]\n          queue.append((nx, ny, path + [move_action]))\n  \n  return []  # Return an empty list if no path found", "island_id": 4, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T01:26:04.803869", "function_name": "collect", "function_body": "  def can_use_tool_on_obstacle(tool_index: int, obstacle_index: int):\n    # Mock function to determine if a tool can be used on an obstacle\n    tools = {\n        'AXE': {'WOOD'},\n        'HAMMER': {'ROCK'}\n    }\n    for tool_name, usable_primitives in tools.items():\n      if tool_index == env.world.cookbook.index[tool_name]:\n        return any(obstacle_index == env.world.cookbook.index[p] for p in usable_primitives)\n    return False\n\n  def is_blocked(x: int, y: int) -> bool:\n    for kind_index in env.world.non_grabbable_indices:\n      if env._current_state.grid[x, y, kind_index] > 0 and\\\n         not any(can_use_tool_on_obstacle(tool_index, kind_index) \n                 for tool_index in env._current_state.inventory):\n        return True\n    return False\n\n  # Determine the target primitive index from its name\n  target_primitive_index = env.world.cookbook.index[primitive]\n\n  # Initialize an empty list to store the actions needed\n  actions_to_take = []\n\n  # Current position of the agent\n  current_x, current_y = env._current_state.pos\n\n  # Get the grid dimensions\n  width, height, _ = env._current_state.grid.shape\n\n  # Use BFS to find the shortest path to the target primitive\n  queue = collections.deque([(current_x, current_y, actions_to_take)])\n  visited = set()\n  visited.add((current_x, current_y))\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    # Check if we are next to a cell containing the target primitive\n    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n      nx, ny = x + dx, y + dy\n\n      # Ensure within bounds and not visited\n      if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n        if env._current_state.grid[nx, ny, target_primitive_index] > 0:\n          # Move to the adjacent cell containing the primitive\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          actions_to_take.extend(path + [move_action])\n\n          # Collect the primitive\n          actions_to_take.append(craft.USE)\n          return actions_to_take\n\n        # Mark as visited and add to queue if not blocked\n        if not is_blocked(nx, ny):\n          visited.add((nx, ny))\n          new_path = path.copy()\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          new_path.append(move_action)\n          queue.append((nx, ny, new_path))\n\n        # Check for tools in inventory to use on obstacles\n        if is_blocked(nx, ny):\n          for tool_index in env._current_state.inventory:\n            for obstacle_index in env.world.non_grabbable_indices:\n              if can_use_tool_on_obstacle(tool_index, obstacle_index) and\\\n                 env._current_state.grid[nx, ny, obstacle_index] > 0:\n                  actions_to_take.append(craft.USE)\n                  break\n\n  # If no path is found, return an empty list of actions\n  return []", "island_id": 7, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T01:26:05.811212", "function_name": "collect", "function_body": "  def can_use_tool_on_obstacle(tool_index: int, obstacle_index: int):\n    # Mock function to determine if a tool can be used on an obstacle\n    tools = {\n        'AXE': {'WOOD'},\n        'HAMMER': {'ROCK'}\n    }\n    for tool_name, usable_primitives in tools.items():\n      if tool_index == env.world.cookbook.index[tool_name]:\n        return any(obstacle_index == env.world.cookbook.index[p] for p in usable_primitives)\n    return False\n\n  def is_blocked(x: int, y: int) -> bool:\n    for kind_index in env.world.non_grabbable_indices:\n      if env._current_state.grid[x, y, kind_index] > 0 and not can_use_tool_on_obstacle(env._current_state.inventory, kind_index):\n        return True\n    return False\n\n  # Determine the target primitive index from its name\n  target_primitive_index = env.world.cookbook.index[primitive]\n\n  # Initialize an empty list to store the actions needed\n  actions_to_take = []\n\n  # Current position of the agent\n  current_x, current_y = env._current_state.pos\n\n  # Get the grid dimensions\n  width, height, _ = env._current_state.grid.shape\n\n  # Use BFS to find the shortest path to the target primitive\n  queue = collections.deque([(current_x, current_y, actions_to_take)])\n  visited = set()\n  visited.add((current_x, current_y))\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    # Check if we are next to a cell containing the target primitive\n    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n      nx, ny = x + dx, y + dy\n\n      # Ensure within bounds and not visited\n      if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n        if env._current_state.grid[nx, ny, target_primitive_index] > 0:\n          # Move to the adjacent cell containing the primitive\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          actions_to_take.extend(path + [move_action])\n\n          # Collect the primitive\n          actions_to_take.append(craft.USE)\n          return actions_to_take\n\n        # Mark as visited and add to queue if not blocked\n        if not is_blocked(nx, ny):\n          visited.add((nx, ny))\n          new_path = path.copy()\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          new_path.append(move_action)\n          queue.append((nx, ny, new_path))\n\n        # Check for tools in inventory to use on obstacles\n        if is_blocked(nx, ny):\n          for tool_index in env._current_state.inventory:\n            for obstacle_index in env.world.non_grabbable_indices:\n              if can_use_tool_on_obstacle(tool_index, obstacle_index) and\\\n                 env._current_state.grid[nx, ny, obstacle_index] > 0:\n                  actions_to_take.append(craft.USE)\n                  break\n\n  # If no path is found, return an empty list of actions\n  return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-26T01:27:32.036064", "function_name": "collect", "function_body": "  index = env.world.cookbook.index[primitive]\n\n  # Get the current position and direction of the agent\n  pos_x, pos_y = env._current_state.pos\n  dir = env._current_state.dir\n\n  # Find all positions in the grid that contain the desired primitive\n  target_positions = np.argwhere(env._current_state.grid[:, :, index] == 1)\n\n  if len(target_positions) == 0:\n    return []  # No targets found, no actions to take\n\n  # Calculate Manhattan distances from the agent's position to each target\n  distances = [(abs(pos_x - tx) + abs(pos_y - ty), (tx, ty)) for tx, ty in target_positions]\n  closest_target_pos = min(distances, key=lambda x: x[0])[1]\n\n  def find_path(start, goal):\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]  # RIGHT, DOWN, LEFT, UP\n    queue = collections.deque([start])\n    came_from = {start: None}\n    \n    while queue:\n      current = queue.popleft()\n      \n      if current == goal:\n        break\n      \n      for direction in directions:\n        next_pos = tuple(np.add(current, direction))\n        \n        # Check if the next position is within bounds and not blocked\n        if 0 <= next_pos[0] < env._current_state.grid.shape[0] and\\\n           0 <= next_pos[1] < env._current_state.grid.shape[1]:\n          if np.all(env._current_state.grid[next_pos[0], next_pos[1]] == 0):\n            if next_pos not in came_from:\n              queue.append(next_pos)\n              came_from[next_pos] = current\n    \n    # Reconstruct the path from start to goal\n    path = []\n    while current != start:\n      path.append(current)\n      current = came_from[current]\n    path.reverse()\n    \n    return path\n\n  def get_direction_to_target(current_dir, dx, dy):\n    if dx == 1:  # Move RIGHT\n      return craft.RIGHT if current_dir != 2 else craft.USE\n    elif dx == -1:  # Move LEFT\n      return craft.LEFT if current_dir != 0 else craft.USE\n    elif dy == 1:  # Move DOWN\n      return craft.DOWN if current_dir != 3 else craft.USE\n    elif dy == -1:  # Move UP\n      return craft.UP if current_dir != 1 else craft.USE\n\n  path = find_path((pos_x, pos_y), closest_target_pos)\n  actions = []\n\n  for i in range(len(path)):\n    current_pos = path[i]\n    \n    if i > 0:\n        previous_pos = path[i-1]\n        delta_x = current_pos[0] - previous_pos[0]\n        delta_y = current_pos[1] - previous_pos[1]\n        \n        action = get_direction_to_target(dir, delta_x, delta_y)\n        actions.append(action)\n\n    # Update the agent's direction\n    if i > 0:\n        action = actions[-1]\n        if action in [craft.RIGHT, craft.LEFT, craft.UP, craft.DOWN]:\n            dir = {craft.RIGHT: 2, craft.LEFT: 0, craft.DOWN: 3, craft.UP: 1}[action]\n\n    # If we are at the target position, use the action to collect the primitive\n    if i == len(path) - 1:\n        actions.append(craft.USE)\n\n  return actions", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-09-26T01:27:33.016853", "function_name": "collect", "function_body": "  index = env.world.cookbook.index[primitive]\n\n  # Get the current position and direction of the agent\n  pos_x, pos_y = env._current_state.pos\n  dir = env._current_state.dir\n\n  # Find all positions in the grid that contain the desired primitive\n  target_positions = np.argwhere(env._current_state.grid[:, :, index] == 1)\n\n  if len(target_positions) == 0:\n    return []  # No targets found, no actions to take\n\n  def find_path(start, goal):\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]  # RIGHT, DOWN, LEFT, UP\n    queue = collections.deque([start])\n    came_from = {start: None}\n    \n    while queue:\n      current = queue.popleft()\n      \n      if current == goal:\n        break\n      \n      for direction in directions:\n        next_pos = tuple(np.add(current, direction))\n        \n        # Check if the next position is within bounds and not blocked\n        if 0 <= next_pos[0] < env._current_state.grid.shape[0] and\\\n           0 <= next_pos[1] < env._current_state.grid.shape[1]:\n          if np.all(env._current_state.grid[next_pos[0], next_pos[1]] == 0):\n            if next_pos not in came_from:\n              queue.append(next_pos)\n              came_from[next_pos] = current\n    \n    # Reconstruct the path from start to goal\n    path = []\n    while current != start:\n      path.append(current)\n      current = came_from[current]\n    path.reverse()\n    \n    return path\n\n  def get_direction_to_target(current_dir, dx, dy):\n    if dx == 1:  # Move RIGHT\n      return craft.RIGHT if current_dir != 2 else craft.USE\n    elif dx == -1:  # Move LEFT\n      return craft.LEFT if current_dir != 0 else craft.USE\n    elif dy == 1:  # Move DOWN\n      return craft.DOWN if current_dir != 3 else craft.USE\n    elif dy == -1:  # Move UP\n      return craft.UP if current_dir != 1 else craft.USE\n\n  def calculate_distance(p1, p2):\n    return abs(p1[0] - p2[0]) + abs(p1[1] - p2[1])\n\n  # Calculate Manhattan distances from the agent's position to each target\n  closest_target_pos = min(target_positions, key=lambda pos: calculate_distance((pos_x, pos_y), pos))\n\n  path = find_path((pos_x, pos_y), closest_target_pos)\n  actions = []\n\n  for i in range(len(path)):\n    current_pos = path[i]\n    \n    # If it's the first step, no need to calculate deltas\n    if i > 0:\n        previous_pos = path[i-1]\n        delta_x = current_pos[0] - previous_pos[0]\n        delta_y = current_pos[1] - previous_pos[1]\n        \n        action = get_direction_to_target(dir, delta_x, delta_y)\n        actions.append(action)\n\n    # Update the agent's direction\n    if i > 0:\n        action = actions[-1]\n        if action in [craft.RIGHT, craft.LEFT, craft.UP, craft.DOWN]:\n            dir = {craft.RIGHT: 2, craft.LEFT: 0, craft.DOWN: 3, craft.UP: 1}[action]\n\n    # If we are at the target position, use the action to collect the primitive\n    if i == len(path) - 1:\n        actions.append(craft.USE)\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-26T01:29:15.967412", "function_name": "collect", "function_body": "  index = env.world.cookbook.index[primitive]\n  grid = env._current_state.grid\n  pos_x, pos_y = env._current_state.pos\n  dir = env._current_state.dir\n\n  target_positions = np.argwhere(grid[:, :, index] == 1)\n\n  if len(target_positions) == 0:\n    return []\n\n  distances = [(pos_x - tx, pos_y - ty) for tx, ty in target_positions]\n  distances = [abs(dx) + abs(dy) for dx, dy in distances]\n\n  min_distance_index = np.argmin(distances)\n  closest_target_pos = tuple(target_positions[min_distance_index])\n\n  def find_path(start, goal):\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]  # RIGHT, DOWN, LEFT, UP\n    queue = collections.deque([start])\n    came_from = {start: None}\n    \n    while queue:\n      current = queue.popleft()\n      \n      if current == goal:\n        break\n      \n      for direction in directions:\n        next_pos = tuple(np.add(current, direction))\n        \n        # Check if the next position is within bounds and not blocked\n        if 0 <= next_pos[0] < grid.shape[0] and\\\n           0 <= next_pos[1] < grid.shape[1]:\n          if np.all(grid[next_pos[0], next_pos[1]] == 0):\n            if next_pos not in came_from:\n              queue.append(next_pos)\n              came_from[next_pos] = current\n    \n    # Reconstruct the path from start to goal\n    path = []\n    while current != start:\n      path.append(current)\n      current = came_from[current]\n    path.reverse()\n    \n    return path\n\n  def get_direction_to_target(current_dir, dx, dy):\n    if dx == 1:  # Move RIGHT\n      return craft.RIGHT if current_dir != 2 else craft.USE\n    elif dx == -1:  # Move LEFT\n      return craft.LEFT if current_dir != 0 else craft.USE\n    elif dy == 1:  # Move DOWN\n      return craft.DOWN if current_dir != 3 else craft.USE\n    elif dy == -1:  # Move UP\n      return craft.UP if current_dir != 1 else craft.USE\n\n  path = find_path((pos_x, pos_y), closest_target_pos)\n  actions = []\n\n  for i in range(len(path)):\n    current_pos = path[i]\n    \n    # Calculate the direction to move from the current position to the next position\n    if i < len(path) - 1:\n      next_pos = path[i + 1]\n      delta_x = next_pos[0] - current_pos[0]\n      delta_y = next_pos[1] - current_pos[1]\n      \n      action = get_direction_to_target(dir, delta_x, delta_y)\n    else:\n      # If we are at the target position, use the action to collect the primitive\n      action = craft.USE\n\n    actions.append(action)\n\n    # Update the agent's direction if an actual move was made\n    if i < len(path) - 1 and action in [craft.RIGHT, craft.LEFT, craft.UP, craft.DOWN]:\n      dir = {craft.RIGHT: 2, craft.LEFT: 0, craft.DOWN: 3, craft.UP: 1}[action]\n\n    # Check for obstacles and update path if necessary\n    if i < len(path) - 1:\n      next_pos = path[i + 1]\n      if not np.all(grid[next_pos[0], next_pos[1]] == 0):\n        # Recalculate the path to avoid the obstacle\n        path = find_path(current_pos, closest_target_pos)\n        actions.append(craft.USE)  # Try using any tool that might help\n\n    # Collect primitive if it is reachable and available\n    if i == len(path) - 1:\n      # Check if the primitive is collectible (not blocked by obstacles)\n      if np.all(grid[next_pos[0], next_pos[1]] == 0):\n        actions.append(craft.USE)\n\n  return actions", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-09-26T01:29:17.054705", "function_name": "collect", "function_body": "  def get_direction_to_target(current_dir, dx, dy):\n    if dx == 1:  # Move RIGHT\n      return craft.RIGHT if current_dir != 2 else craft.USE\n    elif dx == -1:  # Move LEFT\n      return craft.LEFT if current_dir != 0 else craft.USE\n    elif dy == 1:  # Move DOWN\n      return craft.DOWN if current_dir != 3 else craft.USE\n    elif dy == -1:  # Move UP\n      return craft.UP if current_dir != 1 else craft.USE\n\n  index = env.world.cookbook.index[primitive]\n  grid = env._current_state.grid\n  pos_x, pos_y = env._current_state.pos\n  dir = env._current_state.dir\n\n  target_positions = np.argwhere(grid[:, :, index] == 1)\n\n  if len(target_positions) == 0:\n    return []\n\n  distances = [(pos_x - tx, pos_y - ty) for tx, ty in target_positions]\n  distances = [abs(dx) + abs(dy) for dx, dy in distances]\n\n  min_distance_index = np.argmin(distances)\n  closest_target_pos = tuple(target_positions[min_distance_index])\n\n  def find_path(start, goal):\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]  # RIGHT, DOWN, LEFT, UP\n    queue = collections.deque([start])\n    came_from = {start: None}\n    \n    while queue:\n      current = queue.popleft()\n      \n      if current == goal:\n        break\n      \n      for direction in directions:\n        next_pos = tuple(np.add(current, direction))\n        \n        # Check if the next position is within bounds and not blocked\n        if 0 <= next_pos[0] < grid.shape[0] and\\\n           0 <= next_pos[1] < grid.shape[1]:\n          if np.all(grid[next_pos[0], next_pos[1]] == 0):\n            if next_pos not in came_from:\n              queue.append(next_pos)\n              came_from[next_pos] = current\n    \n    # Reconstruct the path from start to goal\n    path = []\n    while current != start:\n      path.append(current)\n      current = came_from[current]\n    path.reverse()\n    \n    return path\n\n  path = find_path((pos_x, pos_y), closest_target_pos)\n  actions = []\n\n  for i in range(len(path)):\n    current_pos = path[i]\n    \n    # Calculate the direction to move from the current position to the next position\n    if i < len(path) - 1:\n      next_pos = path[i + 1]\n      delta_x = next_pos[0] - current_pos[0]\n      delta_y = next_pos[1] - current_pos[1]\n      \n      action = get_direction_to_target(dir, delta_x, delta_y)\n    else:\n      # If we are at the target position, use the action to collect the primitive\n      action = craft.USE\n\n    actions.append(action)\n\n    # Update the agent's direction if an actual move was made\n    if i < len(path) - 1 and action in [craft.RIGHT, craft.LEFT, craft.UP, craft.DOWN]:\n      dir = {craft.RIGHT: 2, craft.LEFT: 0, craft.DOWN: 3, craft.UP: 1}[action]\n\n    # Check for obstacles and update path if necessary\n    if i < len(path) - 1:\n      next_pos = path[i + 1]\n      if not np.all(grid[next_pos[0], next_pos[1]] == 0):\n        # Recalculate the path to avoid the obstacle\n        path = find_path(current_pos, closest_target_pos)\n        actions.append(craft.USE)  # Try using any tool that might help\n\n    # If we reach a target position, collect it and recalculate the path\n    if grid[next_pos[0], next_pos[1], index] == 1:\n      actions.append(craft.USE)\n      pos_x, pos_y = next_pos  # Update the agent's position\n      target_positions = np.argwhere(grid[:, :, index] == 1)  # Re-find targets\n\n      if len(target_positions) == 0:\n        return actions\n\n      distances = [(pos_x - tx, pos_y - ty) for tx, ty in target_positions]\n      distances = [abs(dx) + abs(dy) for dx, dy in distances]\n\n      min_distance_index = np.argmin(distances)\n      closest_target_pos = tuple(target_positions[min_distance_index])\n      path = find_path((pos_x, pos_y), closest_target_pos)\n\n  return actions", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-09-26T01:30:13.026206", "function_name": "collect", "function_body": "  def _find_shortest_path(grid, start_pos, target_kind, inventory):\n    width, height = grid.shape[:2]\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n      \n      if grid[x, y].argmax() == target_kind and (x, y) != start_pos:\n        return path\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          if grid[nx, ny].sum() == 1:  # Allow moving through empty cells\n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))\n          elif inventory[grid[nx, ny].argmax()] > 0:  # Allow moving through obstacles if tool is available\n            tool_index = grid[nx, ny].argmax()\n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))  # Use the tool and move\n    \n    return None\n\n  def _get_action_index_from_direction(direction):\n    mapping = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, (0, -1): craft.DOWN, (0, 1): craft.UP}\n    return mapping.get(direction)\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  inventory = current_state.inventory\n  \n  primitive_index = current_state.world.cookbook.index.index(primitive)\n  \n  path_to_primitive = _find_shortest_path(grid, pos, primitive_index, inventory)\n  \n  if not path_to_primitive:\n    return []\n  \n  actions = [_get_action_index_from_direction(step) for step in path_to_primitive]\n  actions.append(craft.USE)  # Add action to collect the primitive\n  \n  return actions", "island_id": 8, "scores": {"3": 2.5}}
{"timestamp": "2025-09-26T01:30:14.072057", "function_name": "collect", "function_body": "  def _find_shortest_path(grid, start_pos, target_kind):\n    width, height = grid.shape[:2]\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n      \n      if grid[x, y].argmax() == target_kind and (x, y) != start_pos:\n        return path\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          cell_content_index = grid[nx, ny].argmax()\n          if inventory[cell_content_index] > 0:  # Allow moving through obstacles if tool is available\n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))  # Use the tool and move\n          elif grid[nx, ny].sum() == 1:  # Allow moving through empty cells\n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))\n    \n    return None\n\n  def _get_action_index_from_direction(direction):\n    mapping = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, (0, -1): craft.DOWN, (0, 1): craft.UP}\n    return mapping.get(direction)\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  inventory = current_state.inventory\n  \n  primitive_index = current_state.world.cookbook.index.index(primitive)\n  \n  path_to_primitive = _find_shortest_path(grid, pos, primitive_index)\n  \n  if not path_to_primitive:\n    return []\n  \n  actions = [_get_action_index_from_direction(step) for step in path_to_primitive]\n  actions.append(craft.USE)  # Add action to collect the primitive\n  \n  return actions", "island_id": 8, "scores": {"3": 2.5}}
{"timestamp": "2025-09-26T01:31:20.312306", "function_name": "collect", "function_body": "  def get_primitive_index(primitive_name):\n      return env._current_state.world.cookbook.index[primitive_name]\n\n  actions = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  current_state = env._current_state\n\n  queue = collections.deque([(current_state.pos, [])])\n  visited = set([current_state.pos])\n\n  target_primitive_index = get_primitive_index(primitive)\n\n  while queue:\n      pos, actions_taken = queue.popleft()\n\n      if current_state.grid[pos[0], pos[1], target_primitive_index] > 0:\n          return actions_taken + [actions[\"USE\"]]\n\n      neighbors = get_neighbors(pos)\n      for neighbor in neighbors:\n          nx, ny = neighbor\n\n          if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n              # Check if the cell is not blocked by non-grabbable entities.\n              if all(current_state.grid[ny, nx, env_index] == 0 for env_index in current_state.world.non_grabbable_indices):\n                  if neighbor not in visited:\n                      visited.add(neighbor)\n\n                      dx, dy = nx - pos[0], ny - pos[1]\n                      if dx == 1:\n                          action = actions[\"RIGHT\"]\n                      elif dx == -1:\n                          action = actions[\"LEFT\"]\n                      elif dy == 1:\n                          action = actions[\"DOWN\"]\n                      else:  # dy == -1\n                          action = actions[\"UP\"]\n\n                      queue.append((neighbor, actions_taken + [action]))\n\n              # Check if the cell can be cleared using available tools.\n              if any(current_state.inventory[tool_index] > 0 and current_state.grid[ny, nx, tool_index] > 0 for tool_index in current_state.world.grabbable_indices):\n                  return actions_taken + [actions[\"USE\"]]\n\n  # Attempt to clear obstacles using available tools around the current position.\n  for neighbor in get_neighbors(current_state.pos):\n      nx, ny = neighbor\n\n      if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n          if any(current_state.inventory[tool_index] > 0 and current_state.grid[ny, nx, tool_index] > 0 for tool_index in current_state.world.grabbable_indices):\n              return [actions[\"USE\"]]\n\n  return []", "island_id": 1, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T01:31:21.373806", "function_name": "collect", "function_body": "  def get_primitive_index(primitive_name):\n      return env._current_state.world.cookbook.index[primitive_name]\n\n  actions = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  current_state = env._current_state\n\n  queue = collections.deque([(current_state.pos, [])])\n  visited = set([current_state.pos])\n\n  target_primitive_index = get_primitive_index(primitive)\n\n  while queue:\n      pos, actions_taken = queue.popleft()\n\n      if current_state.grid[pos[0], pos[1], target_primitive_index] > 0:\n          return actions_taken + [actions[\"USE\"]]\n\n      neighbors = get_neighbors(pos)\n      for neighbor in neighbors:\n          nx, ny = neighbor\n\n          if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n              # Check if the cell is not blocked by non-grabbable entities.\n              if all(current_state.grid[ny, nx, env_index] == 0 for env_index in current_state.world.non_grabbable_indices):\n                  if neighbor not in visited:\n                      visited.add(neighbor)\n\n                      dx, dy = nx - pos[0], ny - pos[1]\n                      action = actions[\"UP\" if dy == -1 else \"DOWN\" if dy == 1 else \"LEFT\" if dx == -1 else \"RIGHT\"]\n                      queue.append((neighbor, actions_taken + [action]))\n\n              # If the neighbor has tools and we have inventory to use them.\n              elif any(current_state.inventory[tool_index] > 0 for tool_index in current_state.world.grabbable_indices if current_state.grid[ny, nx, tool_index] > 0):\n                  return actions_taken + [actions[\"USE\"]]\n\n  # Attempt to clear obstacles using available tools.\n  for neighbor in get_neighbors(current_state.pos):\n      nx, ny = neighbor\n\n      if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n          if any(current_state.inventory[tool_index] > 0 for tool_index in current_state.world.grabbable_indices if current_state.grid[ny, nx, tool_index] > 0):\n              return [actions[\"USE\"]]\n\n  return []", "island_id": 1, "scores": {"3": 4.0}}
