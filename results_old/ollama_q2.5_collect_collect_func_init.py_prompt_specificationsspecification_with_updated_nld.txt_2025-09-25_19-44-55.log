{"timestamp": "2025-09-26T03:55:51.284508", "function_name": "collect", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Get the index of the target primitive\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Helper function to check if a cell is blocked\n  def is_blocked(x, y):\n    return any(env._current_state.grid[x, y] > 0)\n\n  # Directions and their corresponding actions\n  directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n  actions = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, \n             (0, -1): craft.DOWN, (0, 1): craft.UP}\n\n  # BFS to find the shortest path to a cell containing the primitive\n  start_x, start_y = env._current_state.pos\n  visited = set()\n  queue = deque([(start_x, start_y, [])])  # (x, y, path)\n  \n  while queue:\n    x, y, path = queue.popleft()\n    \n    if (x, y) in visited:\n      continue\n    \n    visited.add((x, y))\n    \n    for dx, dy in directions:\n      nx, ny = x + dx, y + dy\n      \n      # Check bounds\n      if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n        # If the cell contains the primitive, return the path to it\n        if env._current_state.grid[nx, ny][primitive_index] > 0:\n          move_action = actions[(dx, dy)]\n          use_action = craft.USE\n          return path + [move_action, use_action]\n        \n        # Check for obstacles and find tools in inventory that can remove them\n        blocked_tools_needed = []\n        cell_contents = env._current_state.grid[nx, ny]\n        if is_blocked(nx, ny):\n            # Determine which tool can break the obstacle\n            for tool_index, count in enumerate(env._current_state.inventory):\n                if count > 0:\n                    tool_name = env.world.cookbook.index.get(tool_index)\n                    # Add logic to determine if the tool can break the obstacle\n                    # For simplicity, assume that any non-zero inventory item is a potential tool\n                    blocked_tools_needed.append(tool_name)\n\n        # If no tools needed or tools available, move to the cell\n        if not blocked_tools_needed or any(tool in env._current_state.inventory for tool in blocked_tools_needed):\n            move_action = actions[(dx, dy)]\n            queue.append((nx, ny, path + [move_action]))\n  \n  # If no path found, return an empty list (though this should not happen in a valid scenario)\n  return []", "island_id": 9, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T03:57:40.511089", "function_name": "collect", "function_body": "  def can_use_tool_on_obstacle(tool_index: int, obstacle_index: int) -> bool:\n    tools = {\n        'AXE': {'WOOD'},\n        'HAMMER': {'ROCK'}\n    }\n    for tool_name, usable_primitives in tools.items():\n      if tool_index == env.world.cookbook.index[tool_name]:\n        return any(obstacle_index == env.world.cookbook.index[p] \n                   for p in usable_primitives)\n    return False\n\n  def is_blocked(x: int, y: int) -> bool:\n    \"\"\"Check if a cell is blocked by an obstacle that can't be bypassed with available tools.\"\"\"\n    for kind_index in env.world.non_grabbable_indices:\n      if env._current_state.grid[x, y, kind_index] > 0 and\\\n         not any(can_use_tool_on_obstacle(tool_index, kind_index) \n                 for tool_index in env._current_state.inventory):\n        return True\n    return False\n\n  def move_towards_target(target_x: int, target_y: int) -> list[int]:\n    \"\"\"Generate actions to move towards a target cell using BFS.\"\"\"\n    current_x, current_y = env._current_state.pos\n    queue = collections.deque([(current_x, current_y, [])])\n    visited = set()\n    visited.add((current_x, current_y))\n\n    while queue:\n      x, y, path = queue.popleft()\n\n      if (x, y) == (target_x, target_y):\n        return path\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = x + dx, y + dy\n        width, height, _ = env._current_state.grid.shape\n\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          # Check if the cell is blocked by an obstacle that can be bypassed with available tools\n          if is_blocked(nx, ny):\n            for tool_index in env._current_state.inventory:\n              if can_use_tool_on_obstacle(tool_index, \n                                         env.world.cookbook.index['WOOD']) or\\\n                 can_use_tool_on_obstacle(tool_index, \n                                         env.world.cookbook.index['ROCK']):\n                  path.append(craft.USE)\n                  break\n            else:\n              continue  # Skip this direction if no tool can clear the obstacle\n\n          visited.add((nx, ny))\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          queue.append((nx, ny, path + [move_action]))\n\n    return []  # No path found\n\n  def find_target_cells(primitive_index: int) -> list[tuple[int, int]]:\n    \"\"\"Find all cells containing the target primitive.\"\"\"\n    width, height, _ = env._current_state.grid.shape\n    target_cells = []\n    for x in range(width):\n      for y in range(height):\n        if env._current_state.grid[x, y, primitive_index] > 0:\n          target_cells.append((x, y))\n    return target_cells\n\n  def find_closest_target_cell(target_cells: list[tuple[int, int]]) -> tuple[int, int]:\n    \"\"\"Find the closest target cell to the current agent position using BFS.\"\"\"\n    current_x, current_y = env._current_state.pos\n    queue = collections.deque([(current_x, current_y, [])])\n    visited = set()\n    visited.add((current_x, current_y))\n\n    while queue:\n      x, y, path = queue.popleft()\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = x + dx, y + dy\n        width, height, _ = env._current_state.grid.shape\n\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          visited.add((nx, ny))\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          new_path = path + [move_action]\n\n          if (nx, ny) in target_cells:\n            return nx, ny\n\n          queue.append((nx, ny, new_path))\n\n    return None, None  # No reachable target cell found\n\n  # Determine the target primitive index from its name\n  target_primitive_index = env.world.cookbook.index[primitive]\n\n  # Find all cells containing the target primitive\n  target_cells = find_target_cells(target_primitive_index)\n\n  if not target_cells:\n    return []  # No target primitives found\n\n  # Find the closest target cell to the current agent position\n  closest_x, closest_y = find_closest_target_cell(target_cells)\n  if closest_x is None or closest_y is None:\n    return []  # No reachable target cells found\n\n  # Generate actions to move towards the closest target cell\n  path_to_target = move_towards_target(closest_x, closest_y)\n\n  # Collect the primitive once reaching it\n  actions_to_take = path_to_target + [craft.USE]\n  \n  return actions_to_take", "island_id": 7, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T03:57:41.623305", "function_name": "collect", "function_body": "  def can_use_tool_on_obstacle(tool_index: int, obstacle_index: int):\n    tools = {\n        'AXE': {'WOOD'},\n        'HAMMER': {'ROCK'}\n    }\n    for tool_name, usable_primitives in tools.items():\n      if tool_index == env.world.cookbook.index[tool_name]:\n        return any(obstacle_index == env.world.cookbook.index[p] \n                   for p in usable_primitives)\n    return False\n\n  def is_blocked(x: int, y: int) -> bool:\n    \"\"\"Check if a cell is blocked by an obstacle that can't be bypassed with available tools.\"\"\"\n    for kind_index in env.world.non_grabbable_indices:\n      if env._current_state.grid[x, y, kind_index] > 0 and\\\n         not any(can_use_tool_on_obstacle(tool_index, kind_index) \n                 for tool_index in env._current_state.inventory):\n        return True\n    return False\n\n  def move_towards_target(target_x: int, target_y: int) -> list[int]:\n    \"\"\"Generate actions to move towards a target cell using A* algorithm.\"\"\"\n    current_x, current_y = env._current_state.pos\n    width, height, _ = env._current_state.grid.shape\n    # Priority queue for A*\n    queue = collections.deque([(0, 0, current_x, current_y, [])])\n    visited = set()\n    visited.add((current_x, current_y))\n\n    while queue:\n      _, cost, x, y, path = queue.popleft()\n      if (x, y) == (target_x, target_y):\n        return path\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          if is_blocked(nx, ny):\n            for tool_index in env._current_state.inventory:\n              if can_use_tool_on_obstacle(tool_index, \n                                         env.world.cookbook.index['WOOD']) or\\\n                 can_use_tool_on_obstacle(tool_index, \n                                         env.world.cookbook.index['ROCK']):\n                  path.append(craft.USE)\n                  break\n            else:\n              continue  # Skip this direction if no tool can clear the obstacle\n          visited.add((nx, ny))\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          new_cost = cost + 1\n          queue.append((new_cost + abs(target_x - nx) + abs(target_y - ny), \n                        new_cost, nx, ny, path + [move_action]))\n      queue = collections.deque(sorted(queue))\n\n    return []  # No path found\n\n  def find_target_cells(primitive_index: int) -> list[tuple[int, int]]:\n    \"\"\"Find all cells containing the target primitive.\"\"\"\n    width, height, _ = env._current_state.grid.shape\n    target_cells = []\n    for x in range(width):\n      for y in range(height):\n        if env._current_state.grid[x, y, primitive_index] > 0:\n          target_cells.append((x, y))\n    return target_cells\n\n  # Determine the target primitive index from its name\n  target_primitive_index = env.world.cookbook.index[primitive]\n\n  # Find all cells containing the target primitive\n  target_cells = find_target_cells(target_primitive_index)\n\n  # Initialize an empty list to store the actions needed\n  actions_to_take = []\n\n  for target_x, target_y in target_cells:\n    path = move_towards_target(target_x, target_y)\n    if path:\n      actions_to_take.extend(path + [craft.USE])\n      return actions_to_take\n\n  # If no target primitive is found or reachable, return an empty list of actions\n  return []", "island_id": 7, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T03:58:35.142137", "function_name": "collect", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Get the index of the target primitive\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Helper function to check if a cell is blocked\n  def is_blocked(x, y):\n    return any(env._current_state.grid[x, y] > 0)\n\n  # Directions and their corresponding actions\n  directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n  actions = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, \n             (0, -1): craft.DOWN, (0, 1): craft.UP}\n\n  # BFS to find the shortest path to a cell containing the primitive\n  start_x, start_y = env._current_state.pos\n  visited = set()\n  queue = deque([(start_x, start_y, [])])  # (x, y, path)\n  \n  while queue:\n    x, y, path = queue.popleft()\n    \n    if (x, y) in visited:\n      continue\n    \n    visited.add((x, y))\n    \n    for dx, dy in directions:\n      nx, ny = x + dx, y + dy\n      \n      # Check bounds\n      if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n        # If the cell contains the primitive, return the path to it\n        if env._current_state.grid[nx, ny][primitive_index] > 0:\n          move_action = actions[(dx, dy)]\n          use_action = craft.USE\n          return path + [move_action, use_action]\n        \n        # If the cell is not blocked and hasn't been visited, add to queue\n        if not is_blocked(nx, ny):\n          move_action = actions[(dx, dy)]\n          queue.append((nx, ny, path + [move_action]))\n  \n  # If no path found, return an empty list (though this should not happen in a valid scenario)\n  return []", "island_id": 3, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T03:58:36.227078", "function_name": "collect", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Get the index of the target primitive\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Helper function to check if a cell is blocked\n  def is_blocked(x, y):\n    return any(env._current_state.grid[x, y] > 0)\n\n  # Directions and their corresponding actions\n  directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n  actions = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, \n             (0, -1): craft.DOWN, (0, 1): craft.UP}\n\n  # BFS to find the shortest path to a cell containing the primitive\n  start_x, start_y = env._current_state.pos\n  visited = set()\n  queue = deque([(start_x, start_y, [])])  # (x, y, path)\n  \n  while queue:\n    x, y, path = queue.popleft()\n    \n    if (x, y) in visited:\n      continue\n    \n    visited.add((x, y))\n    \n    for dx, dy in directions:\n      nx, ny = x + dx, y + dy\n      \n      # Check bounds\n      if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n        # If the cell contains the primitive, return the path to it\n        if env._current_state.grid[nx, ny][primitive_index] > 0:\n          move_action = actions[(dx, dy)]\n          use_action = craft.USE\n          return path + [move_action, use_action]\n        \n        # If the cell is not blocked and hasn't been visited, add to queue\n        if not is_blocked(nx, ny):\n          move_action = actions[(dx, dy)]\n          queue.append((nx, ny, path + [move_action]))\n  \n  # If no path found, return an empty list (though this should not happen in a valid scenario)\n  return []", "island_id": 3, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T03:59:26.977709", "function_name": "collect", "function_body": "  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  current_state = env._current_state\n\n  actions = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  queue = collections.deque([(current_state.pos, [])])\n  visited = set([current_state.pos])\n\n  def get_primitive_index(primitive_name):\n      return current_state.world.cookbook.index[primitive_name]\n\n  target_primitive_index = get_primitive_index(primitive)\n\n  while queue:\n      pos, actions_taken = queue.popleft()\n\n      if current_state.grid[pos[0], pos[1], target_primitive_index] > 0:\n          # Check for potential obstacles and use tools if necessary.\n          if any(current_state.grid[pos[0], pos[1], tool_index] > 0 for tool_index in current_state.world.grabbable_indices):\n              return actions_taken + [actions[\"USE\"]] * 2\n          else:\n              return actions_taken + [actions[\"USE\"]]\n\n      neighbors = get_neighbors(pos)\n      for neighbor in neighbors:\n          nx, ny = neighbor\n\n          if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n              if all(current_state.grid[ny, nx, env_index] == 0 for env_index in current_state.world.non_grabbable_indices):\n                  if neighbor not in visited:\n                      visited.add(neighbor)\n\n                      dx, dy = nx - pos[0], ny - pos[1]\n                      if dx == 1:\n                          action = actions[\"RIGHT\"]\n                      elif dx == -1:\n                          action = actions[\"LEFT\"]\n                      elif dy == 1:\n                          action = actions[\"DOWN\"]\n                      else:  # dy == -1\n                          action = actions[\"UP\"]\n\n                      queue.append((neighbor, actions_taken + [action]))\n\n  return []", "island_id": 1, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T03:59:28.038281", "function_name": "collect", "function_body": "  def bfs(start_pos, target_index):\n    actions = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n    }\n\n    # Directions corresponding to actions.\n    directions = [(0, -1), (0, 1), (-1, 0), (1, 0)]\n\n    queue = collections.deque([(start_pos, [])])\n    visited = set([start_pos])\n\n    while queue:\n      pos, path = queue.popleft()\n      \n      # Check if we are at a cell with the desired primitive.\n      if current_state.grid[pos[0], pos[1], target_index] > 0:\n        return path + [actions[\"USE\"]]\n      \n      for direction, action in zip(directions, actions.values()):\n        nx, ny = pos[0] + direction[0], pos[1] + direction[1]\n        \n        # Ensure the neighbor is within bounds.\n        if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n          # Check if the cell is not blocked by non-grabbable entities.\n          if all(current_state.grid[ny, nx, env_index] == 0 for env_index in current_state.world.non_grabbable_indices):\n            # If the cell is visited for the first time, add it to the queue.\n            if (nx, ny) not in visited:\n              visited.add((nx, ny))\n              queue.append(((nx, ny), path + [action]))\n    return []\n\n  current_state = env._current_state\n  target_index = current_state.world.cookbook.index[primitive]\n\n  return bfs(current_state.pos, target_index)", "island_id": 1, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T04:00:23.821855", "function_name": "collect", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Get the index of the target primitive\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Helper function to check if a cell is blocked by obstacles or other items, except for the target primitive itself\n  def is_blocked(x, y):\n    return any(env._current_state.grid[x, y] > 0) and env._current_state.grid[x, y][primitive_index] == 0\n\n  # Directions and their corresponding actions\n  directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n  action_map = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, \n                (0, -1): craft.DOWN, (0, 1): craft.UP}\n\n  # BFS to find the shortest path to a cell containing the primitive\n  start_x, start_y = env._current_state.pos\n  visited = set()\n  queue = deque([(start_x, start_y, [])])  # (x, y, path)\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    if (x, y) in visited:\n      continue\n\n    visited.add((x, y))\n\n    for dx, dy in directions:\n      nx, ny = x + dx, y + dy\n      \n      # Check bounds\n      if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n        # If the cell contains the primitive, return the path to it\n        if env._current_state.grid[nx, ny][primitive_index] > 0:\n          move_action = action_map[(dx, dy)]\n          use_action = craft.USE\n          return path + [move_action, use_action]\n        \n        # If the cell is not blocked and hasn't been visited, add to queue\n        if not is_blocked(nx, ny):\n          move_action = action_map[(dx, dy)]\n          queue.append((nx, ny, path + [move_action]))\n  \n  return []  # Return an empty list if no path found", "island_id": 4, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T04:00:24.867178", "function_name": "collect", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Get the index of the target primitive\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Helper function to check if a cell is blocked by obstacles or other items, except for the target primitive itself\n  def is_blocked(x, y):\n    return any(env._current_state.grid[x, y] > 0) and env._current_state.grid[x, y][primitive_index] == 0\n\n  # Directions and their corresponding actions\n  directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n  action_map = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, \n                (0, -1): craft.DOWN, (0, 1): craft.UP}\n\n  # BFS to find the shortest path to a cell containing the primitive\n  start_x, start_y = env._current_state.pos\n  visited = set()\n  queue = deque([(start_x, start_y, [])])  # (x, y, path)\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    if (x, y) in visited:\n      continue\n\n    visited.add((x, y))\n\n    for dx, dy in directions:\n      nx, ny = x + dx, y + dy\n      \n      # Check bounds\n      if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n        # If the cell contains the primitive, return the path to it\n        if env._current_state.grid[nx, ny][primitive_index] > 0:\n          move_action = action_map[(dx, dy)]\n          use_action = craft.USE\n          return path + [move_action, use_action]\n        \n        # If the cell is not blocked and hasn't been visited, add to queue\n        if not is_blocked(nx, ny):\n          move_action = action_map[(dx, dy)]\n          queue.append((nx, ny, path + [move_action]))\n  \n  return []  # Return an empty list if no path found", "island_id": 4, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T04:01:30.012833", "function_name": "collect", "function_body": "  actions = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  # Helper function to find neighboring positions.\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  # Get the current state of the environment.\n  current_state = env._current_state\n\n  # Define a queue for BFS and a set to track visited positions.\n  queue = collections.deque([(current_state.pos, [])])\n  visited = set([current_state.pos])\n\n  # Helper function to get the index of a primitive name.\n  def get_primitive_index(primitive_name):\n      return current_state.world.cookbook.index[primitive_name]\n\n  # Get the index for the target primitive.\n  target_primitive_index = get_primitive_index(primitive)\n\n  # Perform BFS to find a path to collect the primitive.\n  while queue:\n      pos, actions_taken = queue.popleft()\n\n      # Check if we are at a cell with the desired primitive.\n      if current_state.grid[pos[0], pos[1], target_primitive_index] > 0:\n          return actions_taken + [actions[\"USE\"]]\n\n      # Get neighboring positions and filter out invalid ones.\n      neighbors = get_neighbors(pos)\n      for neighbor in neighbors:\n          nx, ny = neighbor\n\n          # Ensure the neighbor is within bounds.\n          if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n              # Check if the cell is not blocked by non-grabbable entities.\n              if all(current_state.grid[ny, nx, env_index] == 0 for env_index in current_state.world.non_grabbable_indices):\n                  # If the cell is visited for the first time, add it to the queue.\n                  if neighbor not in visited:\n                      visited.add(neighbor)\n\n                      # Determine the direction to move towards the neighbor.\n                      dx, dy = nx - pos[0], ny - pos[1]\n                      if dx == 1:\n                          action = actions[\"RIGHT\"]\n                      elif dx == -1:\n                          action = actions[\"LEFT\"]\n                      elif dy == 1:\n                          action = actions[\"DOWN\"]\n                      else:  # dy == -1\n                          action = actions[\"UP\"]\n\n                      queue.append((neighbor, actions_taken + [action]))\n\n  # If no path is found to collect the primitive, return an empty list.\n  return []", "island_id": 8, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T04:01:31.113711", "function_name": "collect", "function_body": "  actions = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  # Helper function to find neighboring positions.\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  # Get the current state of the environment.\n  current_state = env._current_state\n\n  # Define a queue for BFS and a set to track visited positions.\n  queue = collections.deque([(current_state.pos, [])])\n  visited = set([current_state.pos])\n\n  # Helper function to get the index of a primitive name.\n  def get_primitive_index(primitive_name):\n      return current_state.world.cookbook.index[primitive_name]\n\n  # Get the index for the target primitive.\n  target_primitive_index = get_primitive_index(primitive)\n\n  # Perform BFS to find a path to collect the primitive.\n  while queue:\n      pos, actions_taken = queue.popleft()\n\n      # Check if we are at a cell with the desired primitive.\n      if current_state.grid[pos[0], pos[1], target_primitive_index] > 0:\n          return actions_taken + [actions[\"USE\"]]\n\n      # Get neighboring positions and filter out invalid ones.\n      neighbors = get_neighbors(pos)\n      for neighbor in neighbors:\n          nx, ny = neighbor\n\n          # Ensure the neighbor is within bounds.\n          if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n              # Check if the cell is not blocked by non-grabbable entities.\n              if all(current_state.grid[ny, nx, env_index] == 0 for env_index in current_state.world.non_grabbable_indices):\n                  # If the cell is visited for the first time, add it to the queue.\n                  if neighbor not in visited:\n                      visited.add(neighbor)\n\n                      # Determine the direction to move towards the neighbor.\n                      dx, dy = nx - pos[0], ny - pos[1]\n                      if dx == 1:\n                          action = actions[\"RIGHT\"]\n                      elif dx == -1:\n                          action = actions[\"LEFT\"]\n                      elif dy == 1:\n                          action = actions[\"DOWN\"]\n                      else:  # dy == -1\n                          action = actions[\"UP\"]\n\n                      queue.append((neighbor, actions_taken + [action]))\n\n  # If no path is found to collect the primitive, return an empty list.\n  return []", "island_id": 8, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T04:02:50.042147", "function_name": "collect", "function_body": "  def is_blocked(x, y):\n    for kind_index in env.world.non_grabbable_indices:\n      if env._current_state.grid[x, y, kind_index] > 0 and not can_use_tool_on(kind_index, x, y):\n        return True\n    return False\n\n  def can_use_tool_on(obstacle_kind_index, x, y):\n    for tool_index in env._current_state.inventory:\n      tool_name = env.world.cookbook.index.get_by_value(tool_index)\n      if tool_name == 'AXE' and obstacle_kind_index == env.world.cookbook.index['WOOD']:\n        return True\n    return False\n\n  # Determine the target primitive index from its name\n  target_primitive_index = env.world.cookbook.index[primitive]\n\n  # Initialize an empty list to store the actions needed\n  actions_to_take = []\n\n  # Current position of the agent\n  current_x, current_y = env._current_state.pos\n\n  # Get the grid dimensions\n  width, height, _ = env._current_state.grid.shape\n\n  # Use BFS to find the shortest path to the target primitive\n  queue = collections.deque([(current_x, current_y, actions_to_take)])\n  visited = set()\n  visited.add((current_x, current_y))\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    # Check if we are next to a cell containing the target primitive\n    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n      nx, ny = x + dx, y + dy\n\n      # Ensure within bounds and not visited\n      if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n        if env._current_state.grid[nx, ny, target_primitive_index] > 0:\n          # Move to the adjacent cell containing the primitive\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          actions_to_take.extend(path + [move_action])\n\n          # Collect the primitive\n          actions_to_take.append(craft.USE)\n          return actions_to_take\n\n        # Mark as visited and add to queue if not blocked\n        if not is_blocked(nx, ny):\n          visited.add((nx, ny))\n          new_path = path.copy()\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          new_path.append(move_action)\n          queue.append((nx, ny, new_path))\n        else:\n          # Try to use a tool if blocked by an obstacle\n          for tool_index in env._current_state.inventory:\n            tool_name = env.world.cookbook.index.get_by_value(tool_index)\n            obstacle_kind_index = next(kind_index for kind_index in env.world.non_grabbable_indices \n                                      if env._current_state.grid[nx, ny, kind_index] > 0)\n            if can_use_tool_on(obstacle_kind_index, nx, ny):\n              actions_to_take.append(craft.USE)\n              # Re-check the same position after using tool\n              queue.appendleft((nx, ny, new_path))\n              break\n\n  # If no path is found, return an empty list of actions\n  return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-26T04:02:51.122302", "function_name": "collect", "function_body": "  def is_blocked(x, y):\n    for kind_index in env.world.non_grabbable_indices:\n      if env._current_state.grid[x, y, kind_index] > 0 and\\\n         not env._current_state.inventory[env.world.cookbook.index['AXE']] > 0 and\\\n         kind_index == env.world.cookbook.index['WOOD']:\n        return True\n    return False\n\n  # Determine the target primitive index from its name\n  target_primitive_index = env.world.cookbook.index[primitive]\n\n  # Initialize an empty list to store the actions needed\n  actions_to_take = []\n\n  # Current position of the agent\n  current_x, current_y = env._current_state.pos\n\n  # Get the grid dimensions\n  width, height, _ = env._current_state.grid.shape\n\n  # Use BFS to find the shortest path to the target primitive\n  queue = collections.deque([(current_x, current_y, actions_to_take)])\n  visited = set()\n  visited.add((current_x, current_y))\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    # Check if we are next to a cell containing the target primitive\n    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n      nx, ny = x + dx, y + dy\n\n      # Ensure within bounds and not visited\n      if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n        if env._current_state.grid[nx, ny, target_primitive_index] > 0:\n          # Move to the adjacent cell containing the primitive\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          actions_to_take.extend(path + [move_action])\n\n          # Collect the primitive\n          actions_to_take.append(craft.USE)\n          return actions_to_take\n\n        # Mark as visited and add to queue if not blocked\n        if not is_blocked(nx, ny):\n          visited.add((nx, ny))\n          new_path = path.copy()\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          new_path.append(move_action)\n          queue.append((nx, ny, new_path))\n\n        # Check for tools in inventory to use on obstacles\n        if is_blocked(nx, ny):\n          axe_index = env.world.cookbook.index['AXE']\n          if env._current_state.inventory[axe_index] > 0:\n            actions_to_take.append(craft.USE)\n            return actions_to_take\n\n  # If no path is found, return an empty list of actions\n  return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-26T04:04:03.656262", "function_name": "collect", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Get the index of the target primitive\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Helper function to check if a cell is blocked and can be broken by tools in inventory\n  def is_blocked_and_can_break(x, y):\n    cell_contents = env._current_state.grid[x, y]\n    blocking_indices = np.nonzero(cell_contents)[0]\n    \n    for index in blocking_indices:\n        tool_name = env.world.cookbook.index.get(index)\n        # Add logic to determine if the tool can break the obstacle\n        # For simplicity, assume that any non-zero inventory item is a potential tool\n        if env._current_state.inventory[index] > 0:\n            return False, None\n    \n    return True, blocking_indices\n\n  # Directions and their corresponding actions\n  directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n  actions = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, \n             (0, -1): craft.DOWN, (0, 1): craft.UP}\n\n  # BFS to find the shortest path to a cell containing the primitive\n  start_x, start_y = env._current_state.pos\n  visited = set()\n  queue = deque([(start_x, start_y, [])])  # (x, y, path)\n  \n  while queue:\n    x, y, path = queue.popleft()\n    \n    if (x, y) in visited:\n      continue\n    \n    visited.add((x, y))\n    \n    for dx, dy in directions:\n      nx, ny = x + dx, y + dy\n      \n      # Check bounds\n      if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n        # If the cell contains the primitive, return the path to it\n        if env._current_state.grid[nx, ny][primitive_index] > 0:\n          move_action = actions[(dx, dy)]\n          use_action = craft.USE\n          return path + [move_action, use_action]\n        \n        # Check for obstacles and find tools in inventory that can remove them\n        blocked, blocking_indices = is_blocked_and_can_break(nx, ny)\n        if not blocked:\n            move_action = actions[(dx, dy)]\n            queue.append((nx, ny, path + [move_action]))\n        else:\n            # Attempt to break the obstacle using available tools\n            for index in blocking_indices:\n                tool_name = env.world.cookbook.index.get(index)\n                if env._current_state.inventory[index] > 0:\n                    move_action = actions[(dx, dy)]\n                    use_tool_action = craft.USE\n                    return path + [move_action, use_tool_action]\n  \n  # If no path found, return an empty list (though this should not happen in a valid scenario)\n  return []", "island_id": 9, "scores": {"3": 2.0}}
{"timestamp": "2025-09-26T04:04:04.623289", "function_name": "collect", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Get the index of the target primitive\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Helper function to check if a cell is blocked and what tool might be needed\n  def is_blocked(x, y):\n      obstacles = []\n      for obstacle_name in [\"BOUNDARY\", \"WATER\", \"ROCK\"]:\n          obstacle_index = env.world.cookbook.index.get(obstacle_name)\n          if obstacle_index is not None and env._current_state.grid[x, y][obstacle_index] > 0:\n              obstacles.append(obstacle_name)\n      return obstacles\n\n  # Directions and their corresponding actions\n  directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n  actions = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, \n             (0, -1): craft.DOWN, (0, 1): craft.UP}\n\n  # Mapping of obstacles to tools\n  obstacle_to_tool = {\n      \"BOUNDARY\": None,\n      \"WATER\": \"GOLDARROW\",\n      \"ROCK\": \"HAMMER\"\n  }\n\n  # BFS to find the shortest path to a cell containing the primitive\n  start_x, start_y = env._current_state.pos\n  visited = set()\n  queue = deque([(start_x, start_y, [])])  # (x, y, path)\n\n  while queue:\n      x, y, path = queue.popleft()\n\n      if (x, y) in visited:\n          continue\n\n      visited.add((x, y))\n\n      for dx, dy in directions:\n          nx, ny = x + dx, y + dy\n\n          # Check bounds\n          if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n              # If the cell contains the primitive, return the path to it\n              if env._current_state.grid[nx, ny][primitive_index] > 0:\n                  move_action = actions[(dx, dy)]\n                  use_action = craft.USE\n                  return path + [move_action, use_action]\n\n              # Check for obstacles and determine if they can be overcome with tools in inventory\n              obstacles = is_blocked(nx, ny)\n              if obstacles:\n                  tool_available = False\n                  for obstacle in obstacles:\n                      required_tool = obstacle_to_tool[obstacle]\n                      if required_tool is not None and env._current_state.inventory[env.world.cookbook.index[required_tool]] > 0:\n                          tool_available = True\n                          break\n\n                  if not tool_available:\n                      continue  # Skip this path as it cannot be overcome without a needed tool\n\n              move_action = actions[(dx, dy)]\n              queue.append((nx, ny, path + [move_action]))\n\n  # If no path found, return an empty list (though this should not happen in a valid scenario)\n  return []", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-26T04:05:40.706573", "function_name": "collect", "function_body": "  def can_use_tool_on_obstacle(tool_index: int, obstacle_index: int):\n    # Mock function to determine if a tool can be used on an obstacle\n    tools = {\n        'AXE': {'WOOD'},\n        'HAMMER': {'ROCK'}\n    }\n    for tool_name, usable_primitives in tools.items():\n      if tool_index == env.world.cookbook.index[tool_name]:\n        return any(obstacle_index == env.world.cookbook.index[p] for p in usable_primitives)\n    return False\n\n  def is_blocked(x: int, y: int) -> bool:\n    for kind_index in env.world.non_grabbable_indices:\n      if env._current_state.grid[x, y, kind_index] > 0 and not can_use_tool_on_obstacle(\n          any(env._current_state.inventory), kind_index):\n        return True\n    return False\n\n  # Determine the target primitive index from its name\n  target_primitive_index = env.world.cookbook.index[primitive]\n\n  # Initialize an empty list to store the actions needed\n  actions_to_take = []\n\n  # Current position of the agent\n  current_x, current_y = env._current_state.pos\n\n  # Get the grid dimensions\n  width, height, _ = env._current_state.grid.shape\n\n  # Use BFS with priority queue for shortest path\n  queue = collections.deque([(0, current_x, current_y, actions_to_take)])\n  visited = set()\n  visited.add((current_x, current_y))\n\n  while queue:\n    steps, x, y, path = queue.popleft()\n\n    # Check if we are next to a cell containing the target primitive\n    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n      nx, ny = x + dx, y + dy\n\n      # Ensure within bounds and not visited\n      if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n        if env._current_state.grid[nx, ny, target_primitive_index] > 0:\n          # Move to the adjacent cell containing the primitive\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          actions_to_take.extend(path + [move_action])\n\n          # Collect the primitive\n          actions_to_take.append(craft.USE)\n          return actions_to_take\n\n        # Mark as visited and add to queue if not blocked or can be used with tools\n        if not is_blocked(nx, ny):\n          visited.add((nx, ny))\n          new_path = path.copy()\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          new_path.append(move_action)\n          queue.append((steps + 1, nx, ny, new_path))\n\n        # Check for tools in inventory to use on obstacles\n        elif is_blocked(nx, ny):\n          tool_used = False\n          for tool_index in env._current_state.inventory:\n            for obstacle_index in env.world.non_grabbable_indices:\n              if can_use_tool_on_obstacle(tool_index, obstacle_index) and\\\n                 env._current_state.grid[nx, ny, obstacle_index] > 0:\n                  actions_to_take.append(craft.USE)\n                  tool_used = True\n                  break\n            if tool_used:\n                visited.add((nx, ny))\n                queue.append((steps + 1, nx, ny, path.copy()))\n                break\n\n  # If no path is found, return an empty list of actions\n  return []", "island_id": 7, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T04:05:41.681043", "function_name": "collect", "function_body": "  def can_use_tool_on_obstacle(tool_index: int, obstacle_index: int):\n    # Mock function to determine if a tool can be used on an obstacle\n    tools = {\n        'AXE': {'WOOD'},\n        'HAMMER': {'ROCK'}\n    }\n    for tool_name, usable_primitives in tools.items():\n      if tool_index == env.world.cookbook.index[tool_name]:\n        return any(obstacle_index == env.world.cookbook.index[p] for p in usable_primitives)\n    return False\n\n  def is_blocked(x: int, y: int) -> bool:\n    for kind_index in env.world.non_grabbable_indices:\n      if env._current_state.grid[x, y, kind_index] > 0 and not can_use_tool_on_obstacle(\n          any(env._current_state.inventory), kind_index):\n        return True\n    return False\n\n  # Determine the target primitive index from its name\n  target_primitive_index = env.world.cookbook.index[primitive]\n\n  # Initialize an empty list to store the actions needed\n  actions_to_take = []\n\n  # Current position of the agent\n  current_x, current_y = env._current_state.pos\n\n  # Get the grid dimensions\n  width, height, _ = env._current_state.grid.shape\n\n  # Use A* search to find the shortest path to the target primitive\n  def heuristic(x1: int, y1: int, x2: int, y2: int) -> float:\n    return abs(x1 - x2) + abs(y1 - y2)\n\n  queue = []\n  visited = set()\n  heapq.heappush(queue, (0, current_x, current_y, actions_to_take))\n  visited.add((current_x, current_y))\n\n  while queue:\n    _, x, y, path = heapq.heappop(queue)\n\n    # Check if we are next to a cell containing the target primitive\n    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n      nx, ny = x + dx, y + dy\n\n      # Ensure within bounds and not visited\n      if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n        if env._current_state.grid[nx, ny, target_primitive_index] > 0:\n          # Move to the adjacent cell containing the primitive\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          actions_to_take.extend(path + [move_action])\n\n          # Collect the primitive\n          actions_to_take.append(craft.USE)\n          return actions_to_take\n\n        # Mark as visited and add to queue if not blocked or can be used with tools\n        if not is_blocked(nx, ny):\n          visited.add((nx, ny))\n          new_path = path.copy()\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          new_path.append(move_action)\n          cost = len(new_path) + heuristic(nx, ny, target_primitive_index, target_primitive_index)\n          heapq.heappush(queue, (cost, nx, ny, new_path))\n\n        # Check for tools in inventory to use on obstacles\n        elif is_blocked(nx, ny):\n          tool_used = False\n          for tool_index in env._current_state.inventory:\n            for obstacle_index in env.world.non_grabbable_indices:\n              if can_use_tool_on_obstacle(tool_index, obstacle_index) and\\\n                 env._current_state.grid[nx, ny, obstacle_index] > 0:\n                  actions_to_take.append(craft.USE)\n                  tool_used = True\n                  break\n            if tool_used:\n                visited.add((nx, ny))\n                cost = len(actions_to_take) + heuristic(nx, ny, target_primitive_index, target_primitive_index)\n                heapq.heappush(queue, (cost, nx, ny, actions_to_take))\n                break\n\n  # If no path is found, return an empty list of actions\n  return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-26T04:06:41.518821", "function_name": "collect", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Get the index of the target primitive\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Helper function to check if a cell is blocked\n  def is_blocked(x, y):\n    return any(env._current_state.grid[x, y] > 0)\n\n  # Directions and their corresponding actions\n  directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n  actions = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, \n             (0, -1): craft.DOWN, (0, 1): craft.UP}\n\n  # BFS to find the shortest path to a cell containing the primitive\n  start_x, start_y = env._current_state.pos\n  visited = set()\n  queue = deque([(start_x, start_y, [])])  # (x, y, path)\n  \n  while queue:\n    x, y, path = queue.popleft()\n    \n    if (x, y) in visited:\n      continue\n    \n    visited.add((x, y))\n    \n    for dx, dy in directions:\n      nx, ny = x + dx, y + dy\n      \n      # Check bounds\n      if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n        # If the cell contains the primitive, return the path to it\n        if env._current_state.grid[nx, ny][primitive_index] > 0:\n          move_action = actions[(dx, dy)]\n          use_action = craft.USE\n          return path + [move_action, use_action]\n        \n        # If the cell is not blocked and hasn't been visited, add to queue\n        if not is_blocked(nx, ny):\n          move_action = actions[(dx, dy)]\n          queue.append((nx, ny, path + [move_action]))\n  \n  # If no path found, return an empty list (though this should not happen in a valid scenario)\n  return []", "island_id": 0, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T04:06:42.664120", "function_name": "collect", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Get the index of the target primitive\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Helper function to check if a cell is blocked\n  def is_blocked(x, y):\n    return any(env._current_state.grid[x, y] > 0)\n\n  # Directions and their corresponding actions\n  directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n  action_map = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, \n                (0, -1): craft.DOWN, (0, 1): craft.UP}\n\n  # BFS to find the shortest path to a cell containing the primitive\n  start_x, start_y = env._current_state.pos\n  visited = set()\n  queue = deque([(start_x, start_y, [])])  # (x, y, path)\n  \n  while queue:\n    x, y, path = queue.popleft()\n\n    if (x, y) in visited:\n      continue\n\n    visited.add((x, y))\n\n    for dx, dy in directions:\n      nx, ny = x + dx, y + dy\n\n      # Check bounds\n      if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n        # If the cell contains the primitive, return the path to it\n        if env._current_state.grid[nx, ny][primitive_index] > 0:\n          move_action = action_map[(dx, dy)]\n          use_action = craft.USE\n          return path + [move_action, use_action]\n\n        # Check for tools in inventory that can clear obstacles\n        tool_used = False\n        for tool_idx in range(len(env._current_state.inventory)):\n            if env._current_state.inventory[tool_idx] > 0:\n                tool_name = env.world.cookbook.index.reverse()[tool_idx]\n                if can_use_tool(tool_name, x + dx, y + dy):\n                    move_action = action_map[(dx, dy)]\n                    use_tool_action = craft.USE  # Assuming USE activates the tool\n                    queue.append((nx, ny, path + [move_action, use_tool_action]))\n                    tool_used = True\n                    break\n\n        if not is_blocked(nx, ny) and not tool_used:\n            move_action = action_map[(dx, dy)]\n            queue.append((nx, ny, path + [move_action]))\n\n  # If no path found, return an empty list (though this should not happen in a valid scenario)\n  return []", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-26T04:08:04.021558", "function_name": "collect", "function_body": "  actions = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  # Helper function to find neighboring positions.\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  # Get the current state of the environment.\n  current_state = env._current_state\n\n  # Define a queue for BFS and a set to track visited positions with direction.\n  queue = collections.deque([(current_state.pos, [], current_state.dir)])\n  visited = set()\n\n  # Helper function to get the index of a primitive name.\n  def get_primitive_index(primitive_name):\n      return current_state.world.cookbook.index[primitive_name]\n\n  # Get the index for the target primitive.\n  target_primitive_index = get_primitive_index(primitive)\n\n  while queue:\n      pos, actions_taken, direction = queue.popleft()\n\n      if (pos, direction) in visited:\n          continue\n      visited.add((pos, direction))\n\n      # Check if we are at a cell with the desired primitive.\n      if current_state.grid[pos[0], pos[1], target_primitive_index] > 0:\n          return actions_taken + [actions[\"USE\"]]\n\n      neighbors = get_neighbors(pos)\n      for neighbor in neighbors:\n          nx, ny = neighbor\n\n          # Ensure the neighbor is within bounds.\n          if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n              # Check if the cell is not blocked by non-grabbable entities.\n              if all(current_state.grid[ny, nx, env_index] == 0 for env_index in current_state.world.non_grabbable_indices):\n                  # Determine the direction to move towards the neighbor.\n                  dx, dy = nx - pos[0], ny - pos[1]\n                  if dx == 1:\n                      action = actions[\"RIGHT\"]\n                      new_direction = 3\n                  elif dx == -1:\n                      action = actions[\"LEFT\"]\n                      new_direction = 2\n                  elif dy == 1:\n                      action = actions[\"DOWN\"]\n                      new_direction = 0\n                  else:  # dy == -1\n                      action = actions[\"UP\"]\n                      new_direction = 1\n\n                  if direction != new_direction:\n                      # If the current direction is not the target direction, turn first.\n                      queue.append((pos, actions_taken + [action], new_direction))\n                  else:\n                      # Otherwise, move towards the neighbor.\n                      queue.append((neighbor, actions_taken + [action], new_direction))\n\n  return []", "island_id": 2, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T04:08:05.072232", "function_name": "collect", "function_body": "  actions = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  # Helper function to find neighboring positions.\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  # Get the current state of the environment.\n  current_state = env._current_state\n\n  # Define a queue for BFS and a set to track visited positions with direction.\n  queue = collections.deque([(current_state.pos, [], current_state.dir)])\n  visited = set([(current_state.pos, current_state.dir)])\n\n  # Helper function to get the index of a primitive name.\n  def get_primitive_index(primitive_name):\n      return current_state.world.cookbook.index[primitive_name]\n\n  # Get the index for the target primitive.\n  target_primitive_index = get_primitive_index(primitive)\n\n  # Perform BFS to find a path to collect the primitive.\n  while queue:\n      pos, actions_taken, direction = queue.popleft()\n\n      # Check if we are at a cell with the desired primitive.\n      if current_state.grid[pos[0], pos[1], target_primitive_index] > 0:\n          return actions_taken + [actions[\"USE\"]]\n\n      # Get neighboring positions and filter out invalid ones.\n      neighbors = get_neighbors(pos)\n      for neighbor in neighbors:\n          nx, ny = neighbor\n\n          # Ensure the neighbor is within bounds.\n          if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n              # Check if the cell is not blocked by non-grabbable entities.\n              if all(current_state.grid[ny, nx, env_index] == 0 for env_index in current_state.world.non_grabbable_indices):\n                  # If the cell is visited for the first time with this direction, add it to the queue.\n                  if (neighbor, direction) not in visited:\n                      visited.add((neighbor, direction))\n\n                      # Determine the direction to move towards the neighbor.\n                      dx, dy = nx - pos[0], ny - pos[1]\n                      if dx == 1:\n                          action = actions[\"RIGHT\"]\n                          new_direction = 3\n                      elif dx == -1:\n                          action = actions[\"LEFT\"]\n                          new_direction = 2\n                      elif dy == 1:\n                          action = actions[\"DOWN\"]\n                          new_direction = 0\n                      else:  # dy == -1\n                          action = actions[\"UP\"]\n                          new_direction = 1\n\n                      if direction != new_direction:\n                          # If the current direction is not the target direction, turn first.\n                          queue.append((pos, actions_taken + [action], new_direction))\n                      else:\n                          # Otherwise, move towards the neighbor.\n                          queue.append((neighbor, actions_taken + [action], new_direction))\n\n  # If no path is found to collect the primitive, return an empty list.\n  return []", "island_id": 2, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T04:09:11.675923", "function_name": "collect", "function_body": "  actions = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  # Helper function to find neighboring positions.\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  # Get the current state of the environment.\n  current_state = env._current_state\n\n  # Define a queue for BFS and a set to track visited positions.\n  queue = collections.deque([(current_state.pos, [], current_state.dir)])\n  visited = set()\n\n  # Helper function to get the index of a primitive name.\n  def get_primitive_index(primitive_name):\n      return current_state.world.cookbook.index[primitive_name]\n\n  # Get the index for the target primitive.\n  target_primitive_index = get_primitive_index(primitive)\n\n  while queue:\n      pos, actions_taken, direction = queue.popleft()\n\n      if (pos, direction) in visited:\n          continue\n      visited.add((pos, direction))\n\n      # Check if we are at a cell with the desired primitive.\n      if current_state.grid[pos[0], pos[1], target_primitive_index] > 0:\n          return actions_taken + [actions[\"USE\"]]\n\n      neighbors = get_neighbors(pos)\n      for neighbor in neighbors:\n          nx, ny = neighbor\n\n          # Ensure the neighbor is within bounds.\n          if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n              # Check if the cell is not blocked by non-grabbable entities.\n              if all(current_state.grid[ny, nx, env_index] == 0 for env_index in current_state.world.non_grabbable_indices):\n                  # Determine the direction to move towards the neighbor.\n                  dx, dy = nx - pos[0], ny - pos[1]\n                  if dx == 1:\n                      action = actions[\"RIGHT\"]\n                      new_direction = 3\n                  elif dx == -1:\n                      action = actions[\"LEFT\"]\n                      new_direction = 2\n                  elif dy == 1:\n                      action = actions[\"DOWN\"]\n                      new_direction = 0\n                  else:  # dy == -1\n                      action = actions[\"UP\"]\n                      new_direction = 1\n\n                  if direction != new_direction:\n                      queue.append((pos, actions_taken + [action], new_direction))\n                  else:\n                      queue.append((neighbor, actions_taken + [action], new_direction))\n\n  return []", "island_id": 2, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T04:09:12.657092", "function_name": "collect", "function_body": "  actions = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  # Helper function to find neighboring positions.\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  # Get the current state of the environment.\n  current_state = env._current_state\n\n  # Define a queue for BFS and a set to track visited positions.\n  queue = collections.deque([(current_state.pos, [], current_state.dir)])\n  visited = set()\n\n  # Helper function to get the index of a primitive name.\n  def get_primitive_index(primitive_name):\n      return current_state.world.cookbook.index[primitive_name]\n\n  # Get the index for the target primitive.\n  target_primitive_index = get_primitive_index(primitive)\n\n  while queue:\n      pos, actions_taken, direction = queue.popleft()\n\n      if (pos, direction) in visited:\n          continue\n      visited.add((pos, direction))\n\n      # Check if we are at a cell with the desired primitive.\n      if current_state.grid[pos[0], pos[1], target_primitive_index] > 0:\n          return actions_taken + [actions[\"USE\"]]\n\n      neighbors = get_neighbors(pos)\n      for neighbor in neighbors:\n          nx, ny = neighbor\n\n          # Ensure the neighbor is within bounds.\n          if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n              # Check if the cell is not blocked by non-grabbable entities.\n              if all(current_state.grid[ny, nx, env_index] == 0 for env_index in current_state.world.non_grabbable_indices):\n                  # Determine the direction to move towards the neighbor.\n                  dx, dy = nx - pos[0], ny - pos[1]\n                  action_sequence = []\n                  if dx == 1:\n                      action_sequence.append(actions[\"RIGHT\"])\n                      new_direction = 3\n                  elif dx == -1:\n                      action_sequence.append(actions[\"LEFT\"])\n                      new_direction = 2\n                  elif dy == 1:\n                      action_sequence.append(actions[\"DOWN\"])\n                      new_direction = 0\n                  else:  # dy == -1\n                      action_sequence.append(actions[\"UP\"])\n                      new_direction = 1\n\n                  if direction != new_direction:\n                      queue.append((pos, actions_taken + [action], new_direction))\n                  else:\n                      queue.append((neighbor, actions_taken + action_sequence, new_direction))\n\n  return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-26T04:10:10.590023", "function_name": "collect", "function_body": "  def _find_shortest_path(grid, start_pos, target_kind, inventory):\n    width, height = grid.shape[:2]\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n      \n      if grid[x, y].argmax() == target_kind and (x, y) != start_pos:\n        return path\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          can_move = True\n          \n          # Check if there are obstacles and if the agent has tools to clear them\n          for tool in inventory:\n            if grid[nx, ny][tool] > 0:  # Ensure the cell is blocked by a tool-able obstacle\n              can_move = False\n              break\n          \n          if can_move or grid[nx, ny].sum() == 1:\n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))\n    \n    return None\n\n  def _get_action_index_from_direction(direction):\n    mapping = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, (0, -1): craft.DOWN, (0, 1): craft.UP}\n    return mapping.get(direction)\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  inventory = [i for i in range(len(current_state.inventory)) if current_state.inventory[i] > 0]\n  \n  primitive_index = current_state.world.cookbook.index.index(primitive)\n  \n  path_to_primitive = _find_shortest_path(grid, pos, primitive_index, inventory)\n  \n  if not path_to_primitive:\n    return []\n  \n  actions = [_get_action_index_from_direction(step) for step in path_to_primitive]\n  actions.append(craft.USE)  # Add action to collect the primitive\n  \n  return actions", "island_id": 5, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T04:10:11.696322", "function_name": "collect", "function_body": "  def _find_shortest_path(grid, start_pos, target_kind, inventory):\n    width, height = grid.shape[:2]\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n      \n      if grid[x, y].argmax() == target_kind and (x, y) != start_pos:\n        return path\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          can_move = True\n          \n          # Check if there are obstacles and if the agent has tools to clear them\n          for tool in inventory:\n            if grid[nx, ny][tool]:\n              can_move = False\n              break\n          \n          if can_move or grid[nx, ny].sum() == 1:\n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))\n    \n    return None\n\n  def _get_action_index_from_direction(direction):\n    mapping = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, (0, -1): craft.DOWN, (0, 1): craft.UP}\n    return mapping.get(direction)\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  inventory = [i for i in range(len(current_state.inventory)) if current_state.inventory[i] > 0]\n  \n  primitive_index = current_state.world.cookbook.index.index(primitive)\n  \n  path_to_primitive = _find_shortest_path(grid, pos, primitive_index, inventory)\n\n  actions = []\n  if not path_to_primitive:\n    return actions\n\n  for step in path_to_primitive:\n      action_index = _get_action_index_from_direction(step)\n      if action_index is None:\n          continue\n      actions.append(action_index)\n  \n  # Append the USE action to collect the primitive at the target position\n  actions.append(craft.USE)\n\n  return actions", "island_id": 5, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T04:11:17.271578", "function_name": "collect", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Get the index of the target primitive and the agent's current position\n  primitive_index = env.world.cookbook.index[primitive]\n  start_x, start_y = env._current_state.pos\n\n  # Directions and their corresponding actions\n  directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n  action_map = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, \n                (0, -1): craft.DOWN, (0, 1): craft.UP}\n\n  # Helper function to check if a cell is blocked by obstacles other than the primitive itself\n  def is_blocked(x, y):\n    workshop_indices = [\n        env.world.cookbook.index['WORKSHOP0'],\n        env.world.cookbook.index['WORKSHOP1'],\n        env.world.cookbook.index['WORKSHOP2']\n    ]\n    return any(env._current_state.grid[x, y][i] > 0 for i in range(len(env._current_state.grid[x, y]))\n               if i != primitive_index and i not in workshop_indices)\n\n  # BFS to find the shortest path to a cell containing the primitive\n  visited = set()\n  queue = deque([(start_x, start_y, [])])  # (x, y, path)\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    if (x, y) in visited:\n      continue\n\n    visited.add((x, y))\n\n    for dx, dy in directions:\n      nx, ny = x + dx, y + dy\n      \n      # Check bounds\n      if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n        # If the cell contains the primitive, return the path to it\n        if env._current_state.grid[nx, ny][primitive_index] > 0:\n          move_action = action_map[(dx, dy)]\n          use_action = craft.USE\n          return path + [move_action, use_action]\n        \n        # If the cell is not blocked and hasn't been visited, add to queue\n        if not is_blocked(nx, ny):\n          move_action = action_map[(dx, dy)]\n          queue.append((nx, ny, path + [move_action]))\n\n  return []  # Return an empty list if no path found", "island_id": 4, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T04:11:18.259580", "function_name": "collect", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Get the index of the target primitive and the agent's current position\n  primitive_index = env.world.cookbook.index[primitive]\n  start_x, start_y = env._current_state.pos\n\n  # Directions and their corresponding actions\n  directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n  action_map = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, \n                (0, -1): craft.DOWN, (0, 1): craft.UP}\n\n  # Helper function to check if a cell is blocked by obstacles other than the primitive itself\n  def is_blocked(x, y):\n    workshop_indices = [\n        env.world.cookbook.index['WORKSHOP0'],\n        env.world.cookbook.index['WORKSHOP1'],\n        env.world.cookbook.index['WORKSHOP2']\n    ]\n    return any(env._current_state.grid[x, y][i] > 0 for i in range(len(env._current_state.grid[x, y]))\n               if i != primitive_index and i not in workshop_indices)\n\n  # Helper function to check if the agent can use a tool from its inventory\n  def can_use_tool():\n    for item_name, count in env._current_state.inventory.items():\n        if item_name in ['HAMMER', 'KNIFE', 'SHEARS']:\n            return True\n    return False\n\n  # BFS to find the shortest path to a cell containing the primitive\n  visited = set()\n  queue = deque([(start_x, start_y, [])])  # (x, y, path)\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    if (x, y) in visited:\n      continue\n\n    visited.add((x, y))\n\n    for dx, dy in directions:\n      nx, ny = x + dx, y + dy\n      \n      # Check bounds\n      if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n        # If the cell contains the primitive, return the path to it\n        if env._current_state.grid[nx, ny][primitive_index] > 0:\n          move_action = action_map[(dx, dy)]\n          use_action = craft.USE\n          if can_use_tool():\n              return path + [move_action, use_action]\n          else:\n              return path + [move_action]\n        \n        # If the cell is not blocked and hasn't been visited, add to queue\n        if not is_blocked(nx, ny):\n          move_action = action_map[(dx, dy)]\n          queue.append((nx, ny, path + [move_action]))\n\n  return []  # Return an empty list if no path found", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-26T04:12:24.273463", "function_name": "collect", "function_body": "  actions = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  # Helper function to find neighboring positions.\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  # Get the current state of the environment.\n  current_state = env._current_state\n\n  # Define a queue for BFS and a set to track visited positions.\n  queue = collections.deque([(current_state.pos, [])])\n  visited = set([current_state.pos])\n\n  # Helper function to get the index of a primitive name.\n  def get_primitive_index(primitive_name):\n      return current_state.world.cookbook.index[primitive_name]\n\n  # Get the index for the target primitive.\n  target_primitive_index = get_primitive_index(primitive)\n\n  # Perform BFS to find a path to collect the primitive.\n  while queue:\n      pos, actions_taken = queue.popleft()\n\n      # Check if we are at a cell with the desired primitive.\n      if current_state.grid[pos[0], pos[1], target_primitive_index] > 0:\n          return actions_taken + [actions[\"USE\"]]\n\n      # Get neighboring positions and filter out invalid ones.\n      neighbors = get_neighbors(pos)\n      for neighbor in neighbors:\n          nx, ny = neighbor\n\n          # Ensure the neighbor is within bounds.\n          if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n              # Check if the cell is not blocked by non-grabbable entities.\n              if all(current_state.grid[ny, nx, env_index] == 0 for env_index in current_state.world.non_grabbable_indices):\n                  # If the cell is visited for the first time, add it to the queue.\n                  if neighbor not in visited:\n                      visited.add(neighbor)\n\n                      # Determine the direction to move towards the neighbor.\n                      dx, dy = nx - pos[0], ny - pos[1]\n                      action_sequence = []\n\n                      if dx == 1:\n                          action_sequence.append(actions[\"RIGHT\"])\n                      elif dx == -1:\n                          action_sequence.append(actions[\"LEFT\"])\n                      elif dy == 1:\n                          action_sequence.append(actions[\"DOWN\"])\n                      else:  # dy == -1\n                          action_sequence.append(actions[\"UP\"])\n\n                      queue.append((neighbor, actions_taken + action_sequence))\n\n  # If no path is found to collect the primitive, return an empty list.\n  return []", "island_id": 2, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T04:12:25.362194", "function_name": "collect", "function_body": "  actions = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  # Helper function to find neighboring positions.\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  # Get the current state of the environment.\n  current_state = env._current_state\n\n  # Define a queue for BFS and a set to track visited positions.\n  queue = collections.deque([(current_state.pos, [])])\n  visited = set([current_state.pos])\n\n  # Helper function to get the index of a primitive name.\n  def get_primitive_index(primitive_name):\n      return current_state.world.cookbook.index[primitive_name]\n\n  # Get the index for the target primitive.\n  target_primitive_index = get_primitive_index(primitive)\n\n  # Perform BFS to find a path to collect the primitive.\n  while queue:\n      pos, actions_taken = queue.popleft()\n\n      # Check if we are at a cell with the desired primitive.\n      if current_state.grid[pos[0], pos[1], target_primitive_index] > 0:\n          return actions_taken + [actions[\"USE\"]]\n\n      # Get neighboring positions and filter out invalid ones.\n      neighbors = get_neighbors(pos)\n      for neighbor in neighbors:\n          nx, ny = neighbor\n\n          # Ensure the neighbor is within bounds.\n          if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n              # Check if the cell is not blocked by non-grabbable entities.\n              if all(current_state.grid[ny, nx, env_index] == 0 for env_index in current_state.world.non_grabbable_indices):\n                  # If the cell is visited for the first time, add it to the queue.\n                  if neighbor not in visited:\n                      visited.add(neighbor)\n\n                      # Determine the direction to move towards the neighbor.\n                      dx, dy = nx - pos[0], ny - pos[1]\n                      action = None\n                      if dx == 1:\n                          action = actions[\"RIGHT\"]\n                      elif dx == -1:\n                          action = actions[\"LEFT\"]\n                      elif dy == 1:\n                          action = actions[\"DOWN\"]\n                      else:  # dy == -1\n                          action = actions[\"UP\"]\n\n                      queue.append((neighbor, actions_taken + [action]))\n\n  # If no path is found to collect the primitive, return an empty list.\n  return []", "island_id": 2, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T04:14:48.731376", "function_name": "collect", "function_body": "  def can_use_tool_on_obstacle(tool_index: int, obstacle_index: int) -> bool:\n    \"\"\"Check if a tool can be used on an obstacle.\"\"\"\n    tools = {\n        'AXE': {'WOOD'},\n        'HAMMER': {'ROCK'}\n    }\n    for tool_name, usable_primitives in tools.items():\n      if tool_index == env.world.cookbook.index[tool_name]:\n        return any(obstacle_index == env.world.cookbook.index[p] \n                   for p in usable_primitives)\n    return False\n\n  def is_blocked(x: int, y: int) -> bool:\n    \"\"\"Check if a cell is blocked by an obstacle that can't be bypassed with available tools.\"\"\"\n    for kind_index in env.world.non_grabbable_indices:\n      if env._current_state.grid[x, y, kind_index] > 0 and\\\n         not any(can_use_tool_on_obstacle(tool_index, kind_index) \n                 for tool_index in env._current_state.inventory):\n        return True\n    return False\n\n  def move_towards_target(target_x: int, target_y: int) -> list[int]:\n    \"\"\"Generate actions to move towards a target cell using BFS.\"\"\"\n    current_x, current_y = env._current_state.pos\n    queue = collections.deque([(current_x, current_y, [])])\n    visited = set()\n    visited.add((current_x, current_y))\n\n    while queue:\n      x, y, path = queue.popleft()\n\n      if (x, y) == (target_x, target_y):\n        return path\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = x + dx, y + dy\n        width, height, _ = env._current_state.grid.shape\n\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          # Check if the cell is blocked by an obstacle that can be bypassed with available tools\n          if is_blocked(nx, ny):\n            for tool_index in env._current_state.inventory:\n              if can_use_tool_on_obstacle(tool_index, \n                                         env.world.cookbook.index['WOOD']) or\\\n                 can_use_tool_on_obstacle(tool_index, \n                                         env.world.cookbook.index['ROCK']):\n                  path.append(craft.USE)\n                  break\n            else:\n              continue  # Skip this direction if no tool can clear the obstacle\n\n          visited.add((nx, ny))\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          queue.append((nx, ny, path + [move_action]))\n\n    return []  # No path found\n\n  def find_target_cells(primitive_index: int) -> list[tuple[int, int]]:\n    \"\"\"Find all cells containing the target primitive.\"\"\"\n    width, height, _ = env._current_state.grid.shape\n    target_cells = []\n    for x in range(width):\n      for y in range(height):\n        if env._current_state.grid[x, y, primitive_index] > 0:\n          target_cells.append((x, y))\n    return target_cells\n\n  def find_closest_target_cell(target_cells: list[tuple[int, int]]) -> tuple[int, int]:\n    \"\"\"Find the closest target cell to the current agent position using BFS.\"\"\"\n    current_x, current_y = env._current_state.pos\n    queue = collections.deque([(current_x, current_y, [])])\n    visited = set()\n    visited.add((current_x, current_y))\n\n    while queue:\n      x, y, path = queue.popleft()\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = x + dx, y + dy\n        width, height, _ = env._current_state.grid.shape\n\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          visited.add((nx, ny))\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          new_path = path + [move_action]\n\n          if (nx, ny) in target_cells:\n            return nx, ny\n\n          queue.append((nx, ny, new_path))\n\n    return None, None  # No reachable target cell found\n\n  def clear_obstacles_around_target(target_x: int, target_y: int) -> list[int]:\n      \"\"\"Clear obstacles around the target cell using available tools.\"\"\"\n      actions = []\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          nx, ny = target_x + dx, target_y + dy\n          width, height, _ = env._current_state.grid.shape\n\n          if 0 <= nx < width and 0 <= ny < height:\n              for obstacle_index in env.world.non_grabbable_indices:\n                  if env._current_state.grid[nx, ny, obstacle_index] > 0:\n                      # Check if the tool can be used to clear this obstacle\n                      for tool_index in env._current_state.inventory:\n                          if can_use_tool_on_obstacle(tool_index, obstacle_index):\n                              move_action = {\n                                  (-1, 0): craft.LEFT,\n                                  (1, 0): craft.RIGHT,\n                                  (0, -1): craft.DOWN,\n                                  (0, 1): craft.UP\n                              }[(dx, dy)]\n                              actions.append(move_action)\n                              actions.append(craft.USE)\n                              break\n\n      return actions\n\n  # Determine the target primitive index from its name\n  target_primitive_index = env.world.cookbook.index[primitive]\n\n  # Find all cells containing the target primitive\n  target_cells = find_target_cells(target_primitive_index)\n\n  if not target_cells:\n    return []  # No target primitives found\n\n  # Find the closest target cell to the current agent position\n  closest_x, closest_y = find_closest_target_cell(target_cells)\n  if closest_x is None or closest_y is None:\n    return []  # No reachable target cells found\n\n  # Clear obstacles around the closest target cell\n  clear_actions = clear_obstacles_around_target(closest_x, closest_y)\n\n  # Generate actions to move towards the closest target cell\n  path_to_target = move_towards_target(closest_x, closest_y)\n\n  # Collect the primitive once reaching it\n  actions_to_take = clear_actions + path_to_target + [craft.USE]\n  \n  return actions_to_take", "island_id": 7, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T04:14:49.854844", "function_name": "collect", "function_body": "  def can_use_tool_on_obstacle(tool_index: int, obstacle_index: int) -> bool:\n    tools = {\n        'AXE': {'WOOD'},\n        'HAMMER': {'ROCK'}\n    }\n    for tool_name, usable_primitives in tools.items():\n      if tool_index == env.world.cookbook.index[tool_name]:\n        return any(obstacle_index == env.world.cookbook.index[p] \n                   for p in usable_primitives)\n    return False\n\n  def is_blocked(x: int, y: int) -> bool:\n    \"\"\"Check if a cell is blocked by an obstacle that can't be bypassed with available tools.\"\"\"\n    for kind_index in env.world.non_grabbable_indices:\n      if env._current_state.grid[x, y, kind_index] > 0 and\\\n         not any(can_use_tool_on_obstacle(tool_index, kind_index) \n                 for tool_index in env._current_state.inventory):\n        return True\n    return False\n\n  def move_towards_target(target_x: int, target_y: int) -> list[int]:\n    \"\"\"Generate actions to move towards a target cell using BFS.\"\"\"\n    current_x, current_y = env._current_state.pos\n    queue = collections.deque([(current_x, current_y, [])])\n    visited = set()\n    visited.add((current_x, current_y))\n\n    while queue:\n      x, y, path = queue.popleft()\n\n      if (x, y) == (target_x, target_y):\n        return path\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = x + dx, y + dy\n        width, height, _ = env._current_state.grid.shape\n\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          # Check if the cell is blocked by an obstacle that can be bypassed with available tools\n          if is_blocked(nx, ny):\n            for tool_index in env._current_state.inventory:\n              if can_use_tool_on_obstacle(tool_index, \n                                         env.world.cookbook.index['WOOD']) or\\\n                 can_use_tool_on_obstacle(tool_index, \n                                         env.world.cookbook.index['ROCK']):\n                  path.append(craft.USE)\n                  break\n            else:\n              continue  # Skip this direction if no tool can clear the obstacle\n\n          visited.add((nx, ny))\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          queue.append((nx, ny, path + [move_action]))\n\n    return []  # No path found\n\n  def find_target_cells(primitive_index: int) -> list[tuple[int, int]]:\n    \"\"\"Find all cells containing the target primitive.\"\"\"\n    width, height, _ = env._current_state.grid.shape\n    target_cells = []\n    for x in range(width):\n      for y in range(height):\n        if env._current_state.grid[x, y, primitive_index] > 0:\n          target_cells.append((x, y))\n    return target_cells\n\n  def find_closest_target_cell(target_cells: list[tuple[int, int]]) -> tuple[int, int]:\n    \"\"\"Find the closest target cell to the current agent position using BFS.\"\"\"\n    current_x, current_y = env._current_state.pos\n    queue = collections.deque([(current_x, current_y, [])])\n    visited = set()\n    visited.add((current_x, current_y))\n\n    while queue:\n      x, y, path = queue.popleft()\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = x + dx, y + dy\n        width, height, _ = env._current_state.grid.shape\n\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          visited.add((nx, ny))\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          new_path = path + [move_action]\n\n          if (nx, ny) in target_cells:\n            return nx, ny\n\n          queue.append((nx, ny, new_path))\n\n    return None, None  # No reachable target cell found\n\n  def prioritize_actions(actions: list[int]) -> list[int]:\n    \"\"\"Prioritize actions to move towards the target cell efficiently.\"\"\"\n    # This function can be enhanced with heuristics or other strategies\n    return actions\n\n  # Determine the target primitive index from its name\n  target_primitive_index = env.world.cookbook.index[primitive]\n\n  # Find all cells containing the target primitive\n  target_cells = find_target_cells(target_primitive_index)\n\n  if not target_cells:\n    return []  # No target primitives found\n\n  # Find the closest target cell to the current agent position\n  closest_x, closest_y = find_closest_target_cell(target_cells)\n  if closest_x is None or closest_y is None:\n    return []  # No reachable target cells found\n\n  # Generate actions to move towards the closest target cell\n  path_to_target = move_towards_target(closest_x, closest_y)\n\n  # Prioritize actions for efficiency (this step can be optimized further)\n  prioritized_path = prioritize_actions(path_to_target)\n\n  # Collect the primitive once reaching it\n  actions_to_take = prioritized_path + [craft.USE]\n  \n  return actions_to_take", "island_id": 7, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T04:15:51.779937", "function_name": "collect", "function_body": "  def _find_shortest_path(grid, start_pos, target_kind, inventory):\n    width, height = grid.shape[:2]\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n\n      if grid[x, y].argmax() == target_kind and (x, y) != start_pos:\n        return path\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          can_move = True\n\n          # Check if there are obstacles and if the agent has tools to clear them\n          for tool in inventory:\n            if grid[nx, ny][tool] > 0:\n              can_move = False\n              break\n          \n          if can_move or grid[nx, ny].sum() == 1:\n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))\n    \n    return None\n\n  def _get_action_index_from_direction(direction):\n    mapping = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, (0, -1): craft.DOWN, (0, 1): craft.UP}\n    return mapping.get(direction)\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  inventory = [i for i in range(len(current_state.inventory)) if current_state.inventory[i] > 0]\n  \n  primitive_index = current_state.world.cookbook.index.index(primitive)\n  \n  path_to_primitive = _find_shortest_path(grid, pos, primitive_index, inventory)\n\n  actions = []\n\n  if not path_to_primitive:\n    return actions\n\n  for step in path_to_primitive:\n      action_index = _get_action_index_from_direction(step)\n      if action_index is None:\n          continue\n      actions.append(action_index)\n  \n  # Append the USE action to collect the primitive at the target position\n  actions.append(craft.USE)\n\n  return actions", "island_id": 5, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T04:15:52.755941", "function_name": "collect", "function_body": "  def _find_shortest_path(grid, start_pos, target_kind, inventory):\n    width, height = grid.shape[:2]\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n\n      # Check if the current cell is the target and not the starting position\n      if grid[x, y].argmax() == target_kind and (x, y) != start_pos:\n        return path\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          can_move = True\n\n          # Check obstacles and available tools to clear them\n          for tool_index, _ in enumerate(grid[nx, ny]):\n            if grid[nx, ny][tool_index] > 0 and inventory[tool_index] > 0:\n              can_move = False\n              break\n          \n          # If the cell is empty or a tool can be used, add to queue\n          if can_move or grid[nx, ny].sum() == 1:\n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))\n\n    return None\n\n  def _get_action_index_from_direction(direction):\n    mapping = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, (0, -1): craft.DOWN, (0, 1): craft.UP}\n    return mapping.get(direction)\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n\n  # Update inventory to reflect tool availability\n  inventory = {tool: count for tool, count in enumerate(current_state.inventory) if count > 0}\n\n  primitive_index = current_state.world.cookbook.index.index(primitive)\n\n  path_to_primitive = _find_shortest_path(grid, pos, primitive_index, inventory)\n  \n  actions = []\n\n  # Generate the action sequence to move to the target position\n  if not path_to_primitive:\n    return actions\n\n  for step in path_to_primitive:\n      action_index = _get_action_index_from_direction(step)\n      if action_index is None:\n          continue\n      actions.append(action_index)\n\n  # Append the USE action to collect the primitive at the target position\n  actions.append(craft.USE)\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-26T04:17:07.054420", "function_name": "collect", "function_body": "  def is_blocked(x, y):\n    for kind_index in env.world.non_grabbable_indices:\n      if env._current_state.grid[x, y, kind_index] > 0:\n        return True\n    return False\n\n  # Determine the target primitive index from its name\n  target_primitive_index = env.world.cookbook.index[primitive]\n\n  # Initialize an empty list to store the actions needed\n  actions_to_take = []\n\n  # Current position of the agent\n  current_x, current_y = env._current_state.pos\n\n  # Get the grid dimensions\n  width, height, _ = env._current_state.grid.shape\n\n  # Use BFS to find the shortest path to the target primitive\n  queue = collections.deque([(current_x, current_y, actions_to_take)])\n  visited = set()\n  visited.add((current_x, current_y))\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    # Check if we are next to a cell containing the target primitive\n    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n      nx, ny = x + dx, y + dy\n\n      # Ensure within bounds and not visited\n      if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n        if env._current_state.grid[nx, ny, target_primitive_index] > 0:\n          # Move to the adjacent cell containing the primitive\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          actions_to_take.extend(path + [move_action])\n\n          # Collect the primitive\n          actions_to_take.append(craft.USE)\n          return actions_to_take\n\n        # Mark as visited and add to queue if not blocked\n        if not is_blocked(nx, ny):\n          visited.add((nx, ny))\n          new_path = path.copy()\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          new_path.append(move_action)\n          queue.append((nx, ny, new_path))\n\n        # Check for tools in inventory to use on obstacles\n        if is_blocked(nx, ny):\n          for tool_index in env._current_state.inventory:\n            if tool_index == env.world.cookbook.index['AXE'] and\\\n               env.world.cookbook.primitives[tool_index].can_use_on('WOOD'):\n              actions_to_take.append(craft.USE)\n              break\n\n        # Check for other tools that can be used on obstacles\n        elif is_blocked(nx, ny):\n          for tool_name in ['HAMMER', 'SHEARS']:\n            tool_index = env.world.cookbook.index[tool_name]\n            if tool_index in env._current_state.inventory:\n              actions_to_take.append(craft.USE)\n              break\n\n  # If no path is found, return an empty list of actions\n  return []", "island_id": 7, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T04:17:08.126800", "function_name": "collect", "function_body": "  def is_blocked(x, y):\n    for kind_index in env.world.non_grabbable_indices:\n      if env._current_state.grid[x, y, kind_index] > 0:\n        return True\n    return False\n\n  # Determine the target primitive index from its name\n  target_primitive_index = env.world.cookbook.index[primitive]\n\n  # Initialize an empty list to store the actions needed\n  actions_to_take = []\n\n  # Current position of the agent\n  current_x, current_y = env._current_state.pos\n\n  # Get the grid dimensions\n  width, height, _ = env._current_state.grid.shape\n\n  # Use BFS to find the shortest path to the target primitive\n  queue = collections.deque([(current_x, current_y, actions_to_take)])\n  visited = set()\n  visited.add((current_x, current_y))\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    # Check if we are next to a cell containing the target primitive\n    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n      nx, ny = x + dx, y + dy\n\n      # Ensure within bounds and not visited\n      if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n        if env._current_state.grid[nx, ny, target_primitive_index] > 0:\n          # Move to the adjacent cell containing the primitive\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          actions_to_take.extend(path + [move_action])\n\n          # Collect the primitive\n          actions_to_take.append(craft.USE)\n          return actions_to_take\n\n        # Mark as visited and add to queue if not blocked\n        if not is_blocked(nx, ny):\n          visited.add((nx, ny))\n          new_path = path.copy()\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          new_path.append(move_action)\n          queue.append((nx, ny, new_path))\n\n        # Check for tools in inventory to use on obstacles\n        if is_blocked(nx, ny):\n          for tool_index in env._current_state.inventory:\n            if tool_index == env.world.cookbook.index['AXE'] and\\\n               env.world.cookbook.primitives[tool_index].can_use_on('WOOD'):\n              actions_to_take.append(craft.USE)\n              break\n\n  # If no path is found, return an empty list of actions\n  return []", "island_id": 7, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T04:18:13.388261", "function_name": "collect", "function_body": "  actions = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  # Helper function to find neighboring positions.\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  # Get the current state of the environment.\n  current_state = env._current_state\n\n  # Define a queue for BFS and a set to track visited positions with direction.\n  queue = collections.deque([(current_state.pos, [], current_state.dir)])\n  visited = set()\n\n  # Helper function to get the index of a primitive name.\n  def get_primitive_index(primitive_name):\n      return current_state.world.cookbook.index[primitive_name]\n\n  # Get the index for the target primitive.\n  target_primitive_index = get_primitive_index(primitive)\n\n  while queue:\n      pos, actions_taken, direction = queue.popleft()\n\n      if (pos, direction) in visited:\n          continue\n      visited.add((pos, direction))\n\n      # Check if we are at a cell with the desired primitive.\n      if current_state.grid[pos[0], pos[1], target_primitive_index] > 0:\n          return actions_taken + [actions[\"USE\"]]\n\n      neighbors = get_neighbors(pos)\n      for neighbor in neighbors:\n          nx, ny = neighbor\n\n          # Ensure the neighbor is within bounds.\n          if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n              # Check if the cell is not blocked by non-grabbable entities.\n              if all(current_state.grid[ny, nx, env_index] == 0 for env_index in current_state.world.non_grabbable_indices):\n                  # Determine the direction to move towards the neighbor.\n                  dx, dy = nx - pos[0], ny - pos[1]\n                  if dx == 1:\n                      action = actions[\"RIGHT\"]\n                      new_direction = 3\n                  elif dx == -1:\n                      action = actions[\"LEFT\"]\n                      new_direction = 2\n                  elif dy == 1:\n                      action = actions[\"DOWN\"]\n                      new_direction = 0\n                  else:  # dy == -1\n                      action = actions[\"UP\"]\n                      new_direction = 1\n\n                  if direction != new_direction:\n                      # If the current direction is not the target direction, turn first.\n                      queue.append((pos, actions_taken + [action], new_direction))\n                  else:\n                      # Otherwise, move towards the neighbor.\n                      queue.append((neighbor, actions_taken + [action], new_direction))\n\n  return []", "island_id": 2, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T04:18:14.488642", "function_name": "collect", "function_body": "  actions = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  current_state = env._current_state\n\n  # Define a queue for BFS and a set to track visited positions with direction.\n  queue = collections.deque([(current_state.pos, [], current_state.dir)])\n  visited = set()\n\n  def get_primitive_index(primitive_name):\n      return current_state.world.cookbook.index[primitive_name]\n\n  target_primitive_index = get_primitive_index(primitive)\n\n  while queue:\n      pos, actions_taken, direction = queue.popleft()\n      \n      if (pos, direction) in visited:\n          continue\n      visited.add((pos, direction))\n\n      # Check if we are at a cell with the desired primitive.\n      if current_state.grid[pos[0], pos[1], target_primitive_index] > 0:\n          return actions_taken + [actions[\"USE\"]]\n\n      neighbors = get_neighbors(pos)\n      for neighbor in neighbors:\n          nx, ny = neighbor\n\n          # Ensure the neighbor is within bounds.\n          if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n              # Check if the cell is not blocked by non-grabbable entities.\n              if all(current_state.grid[ny, nx, env_index] == 0 for env_index in current_state.world.non_grabbable_indices):\n                  dx, dy = nx - pos[0], ny - pos[1]\n                  new_direction = None\n                  \n                  if dx == 1:\n                      action = actions[\"RIGHT\"]\n                      new_direction = 3\n                  elif dx == -1:\n                      action = actions[\"LEFT\"]\n                      new_direction = 2\n                  elif dy == 1:\n                      action = actions[\"DOWN\"]\n                      new_direction = 0\n                  else:  # dy == -1\n                      action = actions[\"UP\"]\n                      new_direction = 1\n\n                  if direction != new_direction:\n                      queue.append((pos, actions_taken + [action], new_direction))\n                  else:\n                      queue.append((neighbor, actions_taken + [action], new_direction))\n\n  return []", "island_id": 2, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T04:19:09.310391", "function_name": "collect", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Get the index of the target primitive\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Helper function to check if a cell is blocked\n  def is_blocked(x, y):\n    return any(env._current_state.grid[x, y] > 0) and not (env._current_state.grid[x, y][primitive_index] > 0)\n\n  # Directions and their corresponding actions\n  directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n  actions = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, \n             (0, -1): craft.DOWN, (0, 1): craft.UP}\n\n  # BFS to find the shortest path to a cell containing the primitive\n  start_x, start_y = env._current_state.pos\n  visited = set()\n  queue = deque([(start_x, start_y, [])])  # (x, y, path)\n  \n  while queue:\n    x, y, path = queue.popleft()\n    \n    if (x, y) in visited:\n      continue\n    \n    visited.add((x, y))\n    \n    for dx, dy in directions:\n      nx, ny = x + dx, y + dy\n      \n      # Check bounds\n      if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n        # If the cell contains the primitive, return the path to it\n        if env._current_state.grid[nx, ny][primitive_index] > 0:\n          move_action = actions[(dx, dy)]\n          use_action = craft.USE\n          return path + [move_action, use_action]\n        \n        # If the cell is not blocked and hasn't been visited, add to queue\n        if not is_blocked(nx, ny):\n          move_action = actions[(dx, dy)]\n          queue.append((nx, ny, path + [move_action]))\n  \n  # If no path found, return an empty list (though this should not happen in a valid scenario)\n  return []", "island_id": 3, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T04:19:10.391692", "function_name": "collect", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Get the index of the target primitive\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Helper function to check if a cell is blocked\n  def is_blocked(x, y):\n    return any(env._current_state.grid[x, y] > 0)\n\n  # Directions and their corresponding actions\n  directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n  actions = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, \n             (0, -1): craft.DOWN, (0, 1): craft.UP}\n\n  # BFS to find the shortest path to a cell containing the primitive\n  start_x, start_y = env._current_state.pos\n  visited = set()\n  queue = deque([(start_x, start_y, [])])  # (x, y, path)\n  \n  while queue:\n    x, y, path = queue.popleft()\n    \n    if (x, y) in visited:\n      continue\n    \n    visited.add((x, y))\n    \n    for dx, dy in directions:\n      nx, ny = x + dx, y + dy\n      \n      # Check bounds\n      if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n        # If the cell contains the primitive, return the path to it\n        if env._current_state.grid[nx, ny][primitive_index] > 0:\n          move_action = actions[(dx, dy)]\n          use_action = craft.USE\n          return path + [move_action, use_action]\n        \n        # If the cell is not blocked and hasn't been visited, add to queue\n        if not is_blocked(nx, ny):\n          move_action = actions[(dx, dy)]\n          queue.append((nx, ny, path + [move_action]))\n  \n  # If no path found, return an empty list (though this should not happen in a valid scenario)\n  return []", "island_id": 3, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T04:20:39.407360", "function_name": "collect", "function_body": "  def _find_shortest_path(grid, start_pos, target_kind, inventory):\n    width, height = grid.shape[:2]\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n      \n      if grid[x, y].argmax() == target_kind and (x, y) != start_pos:\n        return path\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          can_move = True\n          \n          # Check if there are obstacles and if the agent has tools to clear them\n          for tool in inventory:\n            if grid[nx, ny][tool]:\n              can_move = False\n              break\n          \n          if can_move or grid[nx, ny].sum() == 1:\n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))\n    \n    return None\n\n  def _get_action_index_from_direction(direction):\n    mapping = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, (0, -1): craft.DOWN, (0, 1): craft.UP}\n    return mapping.get(direction)\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  inventory = [i for i in range(len(current_state.inventory)) if current_state.inventory[i] > 0]\n  \n  primitive_index = current_state.world.cookbook.index.index(primitive)\n  \n  path_to_primitive = _find_shortest_path(grid, pos, primitive_index, inventory)\n  \n  if not path_to_primitive:\n    return []\n  \n  actions = [_get_action_index_from_direction(step) for step in path_to_primitive]\n  actions.append(craft.USE)  # Add action to collect the primitive\n  \n  return actions", "island_id": 6, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T04:20:40.459764", "function_name": "collect", "function_body": "  def _find_shortest_path(grid, start_pos, target_kind, inventory):\n    width, height = grid.shape[:2]\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n      \n      if grid[x, y].argmax() == target_kind and (x, y) != start_pos:\n        return path\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          can_move = True\n          \n          # Check if there are obstacles and if the agent has tools to clear them\n          for tool_index in inventory:\n            if grid[nx, ny][tool_index] > 0:  # If obstacle is present and tool is available\n              can_move = False\n              break\n          \n          if can_move or grid[nx, ny].sum() == 1:\n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))\n    \n    return None\n\n  def _get_action_index_from_direction(direction):\n    mapping = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, (0, -1): craft.DOWN, (0, 1): craft.UP}\n    return mapping.get(direction)\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  \n  # Convert inventory to a list of indices where the agent has tools\n  inventory_indices = [i for i in range(len(current_state.inventory)) if current_state.inventory[i] > 0]\n  \n  primitive_index = current_state.world.cookbook.index.index(primitive)\n  \n  path_to_primitive = _find_shortest_path(grid, pos, primitive_index, inventory_indices)\n  \n  if not path_to_primitive:\n    return []\n  \n  actions = [_get_action_index_from_direction(step) for step in path_to_primitive]\n  actions.append(craft.USE)  # Add action to collect the primitive\n  \n  return actions", "island_id": 6, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T04:21:42.780433", "function_name": "collect", "function_body": "  def _find_shortest_path(grid, start_pos, target_kind, inventory):\n    width, height = grid.shape[:2]\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n\n      # Skip the starting position if not already in visited\n      if (x, y) == start_pos and path:\n          continue\n      \n      if grid[x, y].argmax() == target_kind:\n        return path\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          can_move = True\n\n          # Check if there are obstacles and if the agent has tools to clear them\n          for tool in inventory:\n            if grid[nx, ny][tool]:\n              if tool == current_state.world.cookbook.index.index('WORKSHOP1') or tool == current_state.world.cookbook.index.index('WORKSHOP2'):\n                can_move = True  # Workshops are passable\n              else:\n                can_move = False\n                break\n\n          if can_move or grid[nx, ny].sum() == 1:\n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))\n    \n    return None\n\n  def _get_action_index_from_direction(direction):\n    mapping = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, (0, -1): craft.DOWN, (0, 1): craft.UP}\n    return mapping.get(direction)\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  inventory = [i for i in range(len(current_state.inventory)) if current_state.inventory[i] > 0]\n  \n  primitive_index = current_state.world.cookbook.index.index(primitive)\n  \n  path_to_primitive = _find_shortest_path(grid, pos, primitive_index, inventory)\n\n  actions = []\n  \n  if not path_to_primitive:\n    return []\n\n  for step in path_to_primitive:\n      action_index = _get_action_index_from_direction(step)\n      if action_index is None:\n          continue\n      actions.append(action_index)\n  \n  # Append the USE action to collect the primitive at the target position\n  actions.append(craft.USE)\n\n  return actions", "island_id": 5, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T04:21:43.888794", "function_name": "collect", "function_body": "  def _find_shortest_path(grid, start_pos, target_kind, inventory):\n    width, height = grid.shape[:2]\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n\n      # Skip the starting position if not already in visited\n      if (x, y) == start_pos and path:\n          continue\n      \n      if grid[x, y].argmax() == target_kind:\n        return path\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          can_move = True\n\n          # Check if there are obstacles and if the agent has tools to clear them\n          for tool in inventory:\n              if grid[nx, ny][tool]:\n                  can_move = False\n                  break\n\n          if can_move or grid[nx, ny].sum() == 1:\n              visited.add((nx, ny))\n              queue.append((nx, ny, path + [(dx, dy)]))\n    \n    return None\n\n  def _get_action_index_from_direction(direction):\n    mapping = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, (0, -1): craft.DOWN, (0, 1): craft.UP}\n    return mapping.get(direction)\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  inventory = [i for i in range(len(current_state.inventory)) if current_state.inventory[i] > 0]\n  \n  primitive_index = current_state.world.cookbook.index.index(primitive)\n  \n  path_to_primitive = _find_shortest_path(grid, pos, primitive_index, inventory)\n\n  actions = []\n  \n  if not path_to_primitive:\n    return []\n\n  for step in path_to_primitive:\n      action_index = _get_action_index_from_direction(step)\n      if action_index is None:\n          continue\n      actions.append(action_index)\n  \n  # Append the USE action to collect the primitive at the target position\n  actions.append(craft.USE)\n\n  return actions", "island_id": 5, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T04:22:43.394240", "function_name": "collect", "function_body": "  def _find_shortest_path(grid, start_pos, target_kind, inventory):\n    width, height = grid.shape[:2]\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n      \n      if grid[x, y].argmax() == target_kind and (x, y) != start_pos:\n        return path\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          can_move = True\n          \n          # Check for obstacles and if the agent has tools to clear them\n          obstacle_index = grid[nx, ny].argmax()\n          if obstacle_index != target_kind:\n            tool_needed = None\n            for tool, _ in env.world.cookbook.primitives_for(obstacle_index).items():\n              if inventory[tool] > 0:\n                tool_needed = tool\n                break\n            \n            if tool_needed is not None:\n              can_move = True\n            else:\n              can_move = False\n          \n          if can_move or grid[nx, ny].sum() == 1:\n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))\n    \n    return None\n\n  def _get_action_index_from_direction(direction):\n    mapping = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, (0, -1): craft.DOWN, (0, 1): craft.UP}\n    return mapping.get(direction)\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  inventory = [i for i in range(len(current_state.inventory)) if current_state.inventory[i] > 0]\n  \n  primitive_index = current_state.world.cookbook.index.index(primitive)\n  \n  path_to_primitive = _find_shortest_path(grid, pos, primitive_index, inventory)\n  \n  if not path_to_primitive:\n    return []\n  \n  actions = [_get_action_index_from_direction(step) for step in path_to_primitive]\n  actions.append(craft.USE)  # Add action to collect the primitive\n  \n  return actions", "island_id": 6, "scores": {"3": 2.5}}
{"timestamp": "2025-09-26T04:22:44.494392", "function_name": "collect", "function_body": "  def _find_shortest_path(grid, start_pos, target_kind, inventory):\n    width, height = grid.shape[:2]\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n      \n      if grid[x, y].argmax() == target_kind and (x, y) != start_pos:\n        return path\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          can_move = True\n          \n          # Check if there are obstacles and if the agent has tools to clear them\n          for tool_idx in range(len(inventory)):\n            tool_kind = inventory[tool_idx]\n            if grid[nx, ny][tool_kind]:\n              can_move = False\n              break\n          \n          if can_move or grid[nx, ny].sum() == 1:\n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))\n    \n    return None\n\n  def _get_action_index_from_direction(direction):\n    mapping = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, (0, -1): craft.DOWN, (0, 1): craft.UP}\n    return mapping.get(direction)\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  \n  # Convert inventory from counts to list of tool indices\n  inventory = [i for i in range(len(current_state.inventory)) if current_state.inventory[i] > 0]\n  \n  primitive_index = current_state.world.cookbook.index.index(primitive)\n  \n  path_to_primitive = _find_shortest_path(grid, pos, primitive_index, inventory)\n  \n  if not path_to_primitive:\n    return []\n  \n  actions = [_get_action_index_from_direction(step) for step in path_to_primitive]\n  actions.append(craft.USE)  # Add action to collect the primitive\n  \n  return actions", "island_id": 6, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T04:24:00.757175", "function_name": "collect", "function_body": "  def is_blocked(x, y):\n    for kind_index in env.world.non_grabbable_indices:\n      if env._current_state.grid[x, y, kind_index] > 0 and\\\n         not (kind_index == env.world.cookbook.index['WORKSHOP0'] or\n              kind_index == env.world.cookbook.index['WORKSHOP1'] or\n              kind_index == env.world.cookbook.index['WORKSHOP2']):\n        return True\n    return False\n\n  # Determine the target primitive index from its name\n  target_primitive_index = env.world.cookbook.index[primitive]\n\n  # Initialize an empty list to store the actions needed\n  actions_to_take = []\n\n  # Current position of the agent\n  current_x, current_y = env._current_state.pos\n\n  # Get the grid dimensions\n  width, height, _ = env._current_state.grid.shape\n\n  # Use BFS to find the shortest path to the target primitive\n  queue = collections.deque([(current_x, current_y, actions_to_take)])\n  visited = set()\n  visited.add((current_x, current_y))\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    # Check if we are next to a cell containing the target primitive\n    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n      nx, ny = x + dx, y + dy\n\n      # Ensure within bounds and not visited\n      if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n        if env._current_state.grid[nx, ny, target_primitive_index] > 0:\n          # Move to the adjacent cell containing the primitive\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          actions_to_take.extend(path + [move_action])\n\n          # Collect the primitive\n          actions_to_take.append(craft.USE)\n          return actions_to_take\n\n        # Mark as visited and add to queue if not blocked\n        if not is_blocked(nx, ny):\n          visited.add((nx, ny))\n          new_path = path.copy()\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          new_path.append(move_action)\n          queue.append((nx, ny, new_path))\n\n        # Check for tools in inventory to use on obstacles\n        if is_blocked(nx, ny):\n          for tool_index in env._current_state.inventory:\n            if (tool_index == env.world.cookbook.index['AXE'] and\n                env.world.cookbook.primitives[tool_index].can_use_on('WOOD')) or\\\n               (tool_index == env.world.cookbook.index['KNIFE'] and\n                env.world.cookbook.primitives[tool_index].can_use_on('GRASS')):\n              actions_to_take.append(craft.USE)\n              break\n\n  # If no path is found, return an empty list of actions\n  return []", "island_id": 7, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T04:24:01.804171", "function_name": "collect", "function_body": "  def is_blocked(x, y):\n    for kind_index in env.world.non_grabbable_indices:\n      if env._current_state.grid[x, y, kind_index] > 0:\n        return True\n    return False\n\n  # Determine the target primitive index from its name\n  target_primitive_index = env.world.cookbook.index[primitive]\n\n  # Initialize an empty list to store the actions needed\n  actions_to_take = []\n\n  # Current position of the agent\n  current_x, current_y = env._current_state.pos\n\n  # Get the grid dimensions\n  width, height, _ = env._current_state.grid.shape\n\n  # Use BFS to find the shortest path to the target primitive\n  queue = collections.deque([(current_x, current_y, actions_to_take)])\n  visited = set()\n  visited.add((current_x, current_y))\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    # Check if we are next to a cell containing the target primitive\n    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n      nx, ny = x + dx, y + dy\n\n      # Ensure within bounds and not visited\n      if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n        if env._current_state.grid[nx, ny, target_primitive_index] > 0:\n          # Move to the adjacent cell containing the primitive\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          actions_to_take.extend(path + [move_action])\n\n          # Collect the primitive\n          actions_to_take.append(craft.USE)\n          return actions_to_take\n\n        # Mark as visited and add to queue if not blocked\n        if not is_blocked(nx, ny):\n          visited.add((nx, ny))\n          new_path = path.copy()\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          new_path.append(move_action)\n          queue.append((nx, ny, new_path))\n\n        # Check for tools in inventory to use on obstacles\n        if is_blocked(nx, ny):\n          for tool_index, quantity in enumerate(env._current_state.inventory):\n            if quantity > 0:\n              tool_name = env.world.cookbook.index[tool_index]\n              if tool_name == 'AXE' and\\\n                 env.world.cookbook.primitives[tool_index].can_use_on('WOOD'):\n                actions_to_take.append(craft.USE)\n                break\n\n  # If no path is found, return an empty list of actions\n  return []", "island_id": 7, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T04:25:26.064661", "function_name": "collect", "function_body": "  def is_blocked(x, y):\n    for kind_index in env.world.non_grabbable_indices:\n      if env._current_state.grid[x, y, kind_index] > 0 and\\\n         not (kind_index == env.world.cookbook.index['WORKSHOP0'] or\n              kind_index == env.world.cookbook.index['WORKSHOP1'] or\n              kind_index == env.world.cookbook.index['WORKSHOP2']):\n        return True\n    return False\n\n  # Determine the target primitive index from its name\n  target_primitive_index = env.world.cookbook.index[primitive]\n\n  # Initialize an empty list to store the actions needed\n  actions_to_take = []\n\n  # Current position of the agent\n  current_x, current_y = env._current_state.pos\n\n  # Get the grid dimensions\n  width, height, _ = env._current_state.grid.shape\n\n  # Use BFS to find the shortest path to the target primitive\n  queue = collections.deque([(current_x, current_y, actions_to_take)])\n  visited = set()\n  visited.add((current_x, current_y))\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    # Check if we are next to a cell containing the target primitive\n    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n      nx, ny = x + dx, y + dy\n\n      # Ensure within bounds and not visited\n      if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n        if env._current_state.grid[nx, ny, target_primitive_index] > 0:\n          # Move to the adjacent cell containing the primitive\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          actions_to_take.extend(path + [move_action])\n\n          # Collect the primitive\n          actions_to_take.append(craft.USE)\n          return actions_to_take\n\n        # Mark as visited and add to queue if not blocked\n        if not is_blocked(nx, ny):\n          visited.add((nx, ny))\n          new_path = path.copy()\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          new_path.append(move_action)\n          queue.append((nx, ny, new_path))\n\n        # Check for tools in inventory to use on obstacles\n        elif is_blocked(nx, ny):\n          for tool_index, count in enumerate(env._current_state.inventory):\n            if count > 0:\n              tool_name = env.world.cookbook.index.get(tool_index)\n              can_use_on = {\n                  'AXE': ['WOOD'],\n                  'KNIFE': ['GRASS']\n              }\n              obstacle_kind_index = None\n              for obstacle_index in env.world.non_grabbable_indices:\n                if env._current_state.grid[nx, ny, obstacle_index] > 0:\n                  obstacle_kind_index = obstacle_index\n                  break\n\n              if obstacle_kind_index and tool_name:\n                obstacle_name = [k for k, v in env.world.cookbook.index.items() if v == obstacle_kind_index]\n                if obstacle_name and can_use_on.get(tool_name) and any(material in can_use_on[tool_name] for material in obstacle_name):\n                  actions_to_take.append(craft.USE)\n                  break\n\n  # If no path is found, return an empty list of actions\n  return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-26T04:25:27.123727", "function_name": "collect", "function_body": "  def is_blocked(x, y):\n    for kind_index in env.world.non_grabbable_indices:\n      if env._current_state.grid[x, y, kind_index] > 0 and\\\n         not (kind_index == env.world.cookbook.index['WORKSHOP0'] or\n              kind_index == env.world.cookbook.index['WORKSHOP1'] or\n              kind_index == env.world.cookbook.index['WORKSHOP2']):\n        return True\n    return False\n\n  # Determine the target primitive index from its name\n  target_primitive_index = env.world.cookbook.index[primitive]\n\n  # Initialize an empty list to store the actions needed\n  actions_to_take = []\n\n  # Current position of the agent\n  current_x, current_y = env._current_state.pos\n\n  # Get the grid dimensions\n  width, height, _ = env._current_state.grid.shape\n\n  # Use BFS to find the shortest path to the target primitive\n  queue = collections.deque([(current_x, current_y, actions_to_take)])\n  visited = set()\n  visited.add((current_x, current_y))\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    # Check if we are next to a cell containing the target primitive\n    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n      nx, ny = x + dx, y + dy\n\n      # Ensure within bounds and not visited\n      if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n        if env._current_state.grid[nx, ny, target_primitive_index] > 0:\n          # Move to the adjacent cell containing the primitive\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          actions_to_take.extend(path + [move_action])\n\n          # Collect the primitive\n          actions_to_take.append(craft.USE)\n          return actions_to_take\n\n        # Mark as visited and add to queue if not blocked\n        if not is_blocked(nx, ny):\n          visited.add((nx, ny))\n          new_path = path.copy()\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          new_path.append(move_action)\n          queue.append((nx, ny, new_path))\n\n        # Check for tools in inventory to use on obstacles\n        if is_blocked(nx, ny):\n          for tool_index in env._current_state.inventory:\n            if (tool_index == env.world.cookbook.index['AXE'] and\n                env.world.cookbook.primitives[tool_index].can_use_on('WOOD')) or\\\n               (tool_index == env.world.cookbook.index['KNIFE'] and\n                env.world.cookbook.primitives[tool_index].can_use_on('GRASS')):\n              actions_to_take.append(craft.USE)\n              break\n\n  # If no path is found, return an empty list of actions\n  return []", "island_id": 7, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T04:26:44.673441", "function_name": "collect", "function_body": "  def bfs(start_pos, target_index):\n    actions = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n    }\n\n    # Directions corresponding to actions.\n    directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n    queue = collections.deque([(start_pos, [])])\n    visited = set([start_pos])\n\n    while queue:\n      pos, path = queue.popleft()\n      \n      # Check if we are at a cell with the desired primitive.\n      if current_state.grid[pos[1], pos[0], target_index] > 0:\n        return path + [actions[\"USE\"]]\n      \n      for direction in directions:\n        nx, ny = pos[0] + direction[0], pos[1] + direction[1]\n        \n        # Ensure the neighbor is within bounds.\n        if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n          # Check if the cell is not blocked by non-grabbable entities.\n          if all(current_state.grid[ny, nx, env_index] == 0 for env_index in current_state.world.non_grabbable_indices):\n            # If the cell is visited for the first time, add it to the queue.\n            if (nx, ny) not in visited:\n              visited.add((nx, ny))\n              \n              action = actions[\"UP\" if direction[1] == -1 else \"DOWN\" if direction[1] == 1 else \"LEFT\" if direction[0] == -1 else \"RIGHT\"]\n              queue.append(((nx, ny), path + [action]))\n    return []\n\n  current_state = env._current_state\n  target_index = current_state.world.cookbook.index[primitive]\n  \n  # Check for tools in inventory that can be used to clear obstacles.\n  tool_indices = [current_state.world.cookbook.index.get(tool) for tool in [\"AXE\", \"SHOVEL\", \"PICKAXE\"] if current_state.world.cookbook.index.get(tool) is not None and current_state.inventory[tool] > 0]\n  \n  # If tools are available, attempt to clear obstacles.\n  if tool_indices:\n    obstacle_indices = [current_state.world.cookbook.index.get(obstacle) for obstacle in [\"TREE\", \"ROCK\"] if current_state.world.cookbook.index.get(obstacle) is not None]\n    \n    # Clear all obstacles that can be cleared with available tools.\n    while True:\n      found_obstacle = False\n      for tool_index, obstacle_index in zip(tool_indices, obstacle_indices):\n        for y in range(current_state.grid.shape[0]):\n          for x in range(current_state.grid.shape[1]):\n            if current_state.grid[y, x, obstacle_index] > 0 and all(current_state.grid[y, x, env_index] == 0 for env_index in current_state.world.non_grabbable_indices if env_index != obstacle_index):\n              # Find a path to the obstacle.\n              obstacle_path = bfs(start_pos=current_state.pos, target_index=obstacle_index)\n              if obstacle_path:\n                found_obstacle = True\n                return obstacle_path + [actions[\"USE\"]]\n      if not found_obstacle:\n        break\n\n  return bfs(current_state.pos, target_index)", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-26T04:26:45.660565", "function_name": "collect", "function_body": "  actions = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  # Helper function to find neighboring positions.\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  # Get the current state of the environment.\n  current_state = env._current_state\n\n  # Define a queue for BFS and a set to track visited positions.\n  queue = collections.deque([(current_state.pos, [])])\n  visited = set([current_state.pos])\n\n  # Helper function to get the index of a primitive name.\n  def get_primitive_index(primitive_name):\n      return current_state.world.cookbook.index[primitive_name]\n\n  # Get the index for the target primitive.\n  target_primitive_index = get_primitive_index(primitive)\n\n  # Perform BFS to find a path to collect the primitive.\n  while queue:\n      pos, actions_taken = queue.popleft()\n\n      # Check if we are at a cell with the desired primitive.\n      if current_state.grid[pos[0], pos[1], target_primitive_index] > 0:\n          return actions_taken + [actions[\"USE\"]]\n\n      # Get neighboring positions and filter out invalid ones.\n      neighbors = get_neighbors(pos)\n      for neighbor in neighbors:\n          nx, ny = neighbor\n\n          # Ensure the neighbor is within bounds.\n          if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n              # Check if the cell is not blocked by non-grabbable entities.\n              if all(current_state.grid[ny, nx, env_index] == 0 for env_index in current_state.world.non_grabbable_indices):\n                  # If the cell is visited for the first time, add it to the queue.\n                  if neighbor not in visited:\n                      visited.add(neighbor)\n\n                      # Determine the direction to move towards the neighbor.\n                      dx, dy = nx - pos[0], ny - pos[1]\n                      action = None\n                      if dx == 1:\n                          action = actions[\"RIGHT\"]\n                      elif dx == -1:\n                          action = actions[\"LEFT\"]\n                      elif dy == 1:\n                          action = actions[\"DOWN\"]\n                      else:  # dy == -1\n                          action = actions[\"UP\"]\n\n                      # Check if the agent has tools in its inventory that can be used.\n                      use_action = None\n                      for tool, index in current_state.world.cookbook.primitives.items():\n                          if current_state.inventory[index] > 0:\n                              use_action = actions[\"USE\"]\n                              break\n\n                      if use_action is not None:\n                          return actions_taken + [action, use_action]\n                      else:\n                          queue.append((neighbor, actions_taken + [action]))\n\n  # If no path is found to collect the primitive, return an empty list.\n  return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-26T04:28:01.173448", "function_name": "collect", "function_body": "  def get_primitive_index(primitive_name):\n      return env._current_state.world.cookbook.index[primitive_name]\n\n  # Mapping from action names to indices.\n  actions = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  # Current state of the environment.\n  current_state = env._current_state\n\n  # Initialize BFS queue and visited set.\n  queue = collections.deque([(current_state.pos, [])])\n  visited = set([current_state.pos])\n\n  target_primitive_index = get_primitive_index(primitive)\n\n  while queue:\n      pos, actions_taken = queue.popleft()\n\n      if current_state.grid[pos[0], pos[1], target_primitive_index] > 0:\n          return actions_taken + [actions[\"USE\"]]\n\n      neighbors = get_neighbors(pos)\n      for neighbor in neighbors:\n          nx, ny = neighbor\n\n          # Ensure the neighbor is within bounds.\n          if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n              # Check if the cell is not blocked by non-grabbable entities.\n              if all(current_state.grid[ny, nx, env_index] == 0 for env_index in current_state.world.non_grabbable_indices):\n                  if neighbor not in visited:\n                      visited.add(neighbor)\n\n                      dx, dy = nx - pos[0], ny - pos[1]\n                      if dx == 1:\n                          action = actions[\"RIGHT\"]\n                      elif dx == -1:\n                          action = actions[\"LEFT\"]\n                      elif dy == 1:\n                          action = actions[\"DOWN\"]\n                      else:  # dy == -1\n                          action = actions[\"UP\"]\n\n                      queue.append((neighbor, actions_taken + [action]))\n\n              # Check if any tool in inventory can be used to clear the path.\n              for tool_index in current_state.world.grabbable_indices:\n                  if current_state.inventory[tool_index] > 0 and current_state.grid[ny, nx, tool_index] > 0:\n                      # Use the tool to clear the obstacle.\n                      return actions_taken + [actions[\"USE\"]]\n\n      # Check if there are obstacles that can be cleared using available tools.\n      for neighbor in neighbors:\n          nx, ny = neighbor\n          if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n              for tool_index in current_state.world.grabbable_indices:\n                  if current_state.inventory[tool_index] > 0 and any(current_state.grid[ny, nx, env_index] > 0 for env_index in current_state.world.non_grabbable_indices):\n                      return actions_taken + [actions[\"USE\"]]\n\n  # If no path is found to collect the primitive, try moving randomly.\n  random_actions = [np.random.choice([0, 1, 2, 3]) for _ in range(5)]\n  return actions_taken + random_actions", "island_id": 1, "scores": {"3": 4.0}}
