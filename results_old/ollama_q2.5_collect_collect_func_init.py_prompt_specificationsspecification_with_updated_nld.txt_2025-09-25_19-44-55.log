{"timestamp": "2025-09-26T02:57:17.692907", "function_name": "collect", "function_body": "  def _find_shortest_path(grid, start_pos, target_kind, inventory):\n    width, height = grid.shape[:2]\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n      \n      if grid[x, y].argmax() == target_kind and (x, y) != start_pos:\n        return path\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          cell_content_index = grid[nx, ny].argmax()\n          # Allow movement on clear cells or through tools that are available in the inventory\n          if grid[nx, ny].sum() == 1 or inventory[cell_content_index] > 0:  \n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))\n    \n    return None\n\n  def _get_action_index_from_direction(direction):\n    mapping = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, (0, -1): craft.DOWN, (0, 1): craft.UP}\n    return mapping.get(direction)\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  inventory = current_state.inventory\n  \n  primitive_index = current_state.world.cookbook.index.index(primitive)\n  \n  path_to_primitive = _find_shortest_path(grid, pos, primitive_index, inventory)\n  \n  if not path_to_primitive:\n    return []\n  \n  actions = [_get_action_index_from_direction(step) for step in path_to_primitive]\n  actions.append(craft.USE)  # Add action to collect the primitive\n  \n  return actions", "island_id": 9, "scores": {"3": 2.5}}
{"timestamp": "2025-09-26T02:57:18.768384", "function_name": "collect", "function_body": "  def _find_shortest_path(grid, start_pos, target_kind, inventory):\n    width, height = grid.shape[:2]\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n      \n      if grid[x, y].argmax() == target_kind and (x, y) != start_pos:\n        return path\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          cell_content_index = grid[nx, ny].argmax()\n          # Allow movement on clear cells or through tools that are available in the inventory\n          if grid[nx, ny].sum() == 1 or inventory[cell_content_index] > 0:  \n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))\n    \n    return None\n\n  def _get_action_index_from_direction(direction):\n    mapping = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, (0, -1): craft.DOWN, (0, 1): craft.UP}\n    return mapping.get(direction)\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  inventory = current_state.inventory\n  \n  primitive_index = current_state.world.cookbook.index.index(primitive)\n  \n  path_to_primitive = _find_shortest_path(grid, pos, primitive_index, inventory)\n  \n  if not path_to_primitive:\n    return []\n  \n  actions = [_get_action_index_from_direction(step) for step in path_to_primitive]\n  actions.append(craft.USE)  # Add action to collect the primitive\n  \n  return actions", "island_id": 9, "scores": {"3": 2.5}}
{"timestamp": "2025-09-26T02:58:17.600273", "function_name": "collect", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Get the index of the target primitive\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Helper function to check if a cell is blocked by obstacles other than the primitive itself\n  def is_blocked(x, y):\n    # Check if any item is present except the target primitive and workshops\n    workshop_indices = [\n        env.world.cookbook.index['WORKSHOP0'],\n        env.world.cookbook.index['WORKSHOP1'],\n        env.world.cookbook.index['WORKSHOP2']\n    ]\n    return any(env._current_state.grid[x, y][i] > 0 for i in range(len(env._current_state.grid[x, y]))\n               if i != primitive_index and i not in workshop_indices)\n\n  # Directions and their corresponding actions\n  directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n  action_map = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, \n                (0, -1): craft.DOWN, (0, 1): craft.UP}\n\n  # BFS to find the shortest path to a cell containing the primitive\n  start_x, start_y = env._current_state.pos\n  visited = set()\n  queue = deque([(start_x, start_y, [])])  # (x, y, path)\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    if (x, y) in visited:\n      continue\n\n    visited.add((x, y))\n\n    for dx, dy in directions:\n      nx, ny = x + dx, y + dy\n      \n      # Check bounds\n      if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n        # If the cell contains the primitive, return the path to it\n        if env._current_state.grid[nx, ny][primitive_index] > 0:\n          move_action = action_map[(dx, dy)]\n          use_action = craft.USE\n          return path + [move_action, use_action]\n        \n        # If the cell is not blocked and hasn't been visited, add to queue\n        if not is_blocked(nx, ny):\n          move_action = action_map[(dx, dy)]\n          queue.append((nx, ny, path + [move_action]))\n  \n  return []  # Return an empty list if no path found", "island_id": 4, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T02:58:18.711104", "function_name": "collect", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Get the index of the target primitive\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Helper function to check if a cell is blocked by obstacles other than the primitive itself\n  def is_blocked(x, y):\n    return any(env._current_state.grid[x, y] > 0) and env._current_state.grid[x, y][primitive_index] == 0\n\n  # Directions and their corresponding actions\n  directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n  action_map = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, \n                (0, -1): craft.DOWN, (0, 1): craft.UP}\n\n  # BFS to find the shortest path to a cell containing the primitive\n  start_x, start_y = env._current_state.pos\n  visited = set()\n  queue = deque([(start_x, start_y, [])])  # (x, y, path)\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    if (x, y) in visited:\n      continue\n\n    visited.add((x, y))\n\n    for dx, dy in directions:\n      nx, ny = x + dx, y + dy\n      \n      # Check bounds\n      if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n        # If the cell contains the primitive, return the path to it\n        if env._current_state.grid[nx, ny][primitive_index] > 0:\n          move_action = action_map[(dx, dy)]\n          use_action = craft.USE\n          return path + [move_action, use_action]\n        \n        # If the cell is not blocked and hasn't been visited, add to queue\n        if not is_blocked(nx, ny):\n          move_action = action_map[(dx, dy)]\n          queue.append((nx, ny, path + [move_action]))\n  \n  return []  # Return an empty list if no path found", "island_id": 4, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T02:59:11.290617", "function_name": "collect", "function_body": "  def _find_shortest_path(grid, start_pos, target_kind, inventory):\n    width, height = grid.shape[:2]\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n      \n      if grid[x, y].argmax() == target_kind and (x, y) != start_pos:\n        return path\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          cell_content_index = grid[nx, ny].argmax()\n          # Allow movement on clear cells or through tools that are available in the inventory\n          if grid[nx, ny].sum() == 1 or inventory[cell_content_index] > 0:  \n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))\n    \n    return None\n\n  def _get_action_index_from_direction(direction):\n    mapping = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, (0, -1): craft.DOWN, (0, 1): craft.UP}\n    return mapping.get(direction)\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  inventory = current_state.inventory\n  \n  primitive_index = current_state.world.cookbook.index.index(primitive)\n  \n  path_to_primitive = _find_shortest_path(grid, pos, primitive_index, inventory)\n  \n  if not path_to_primitive:\n    return []\n  \n  actions = [_get_action_index_from_direction(step) for step in path_to_primitive]\n  actions.append(craft.USE)  # Add action to collect the primitive\n  \n  return actions", "island_id": 9, "scores": {"3": 2.5}}
{"timestamp": "2025-09-26T02:59:12.377427", "function_name": "collect", "function_body": "  def _find_shortest_path(grid, start_pos, target_kind, inventory):\n    width, height = grid.shape[:2]\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n      \n      if grid[x, y].argmax() == target_kind and (x, y) != start_pos:\n        return path\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          cell_content_index = grid[nx, ny].argmax()\n          # Allow movement on clear cells or through tools that are available in the inventory\n          if grid[nx, ny].sum() == 1 or inventory[cell_content_index] > 0:  \n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))\n    \n    return None\n\n  def _get_action_index_from_direction(direction):\n    mapping = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, (0, -1): craft.DOWN, (0, 1): craft.UP}\n    return mapping.get(direction)\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  inventory = current_state.inventory\n  \n  primitive_index = current_state.world.cookbook.index.index(primitive)\n  \n  path_to_primitive = _find_shortest_path(grid, pos, primitive_index, inventory)\n  \n  if not path_to_primitive:\n    return []\n  \n  actions = [_get_action_index_from_direction(step) for step in path_to_primitive]\n  actions.append(craft.USE)  # Add action to collect the primitive\n  \n  return actions", "island_id": 9, "scores": {"3": 2.5}}
{"timestamp": "2025-09-26T03:00:31.169168", "function_name": "collect", "function_body": "  actions = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  # Helper function to find neighboring positions.\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  # Get the current state of the environment.\n  current_state = env._current_state\n\n  # Define a priority queue for A* search and a set to track visited positions with direction.\n  import heapq\n  queue = []\n  heapq.heappush(queue, (0, current_state.pos, [], current_state.dir))\n  visited = set([(current_state.pos, current_state.dir)])\n\n  # Helper function to get the index of a primitive name.\n  def get_primitive_index(primitive_name):\n      return current_state.world.cookbook.index[primitive_name]\n\n  # Get the index for the target primitive.\n  target_primitive_index = get_primitive_index(primitive)\n\n  # Heuristic function: Manhattan distance.\n  def heuristic(pos1, pos2):\n      return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n\n  # Perform A* search to find a path to collect the primitive.\n  while queue:\n      _, pos, actions_taken, direction = heapq.heappop(queue)\n\n      # Check if we are at a cell with the desired primitive.\n      if current_state.grid[pos[0], pos[1], target_primitive_index] > 0:\n          return actions_taken + [actions[\"USE\"]]\n\n      # Get neighboring positions and filter out invalid ones.\n      neighbors = get_neighbors(pos)\n      for neighbor in neighbors:\n          nx, ny = neighbor\n\n          # Ensure the neighbor is within bounds.\n          if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n              # Check if the cell is not blocked by non-grabbable entities.\n              if all(current_state.grid[ny, nx, env_index] == 0 for env_index in current_state.world.non_grabbable_indices):\n                  # If the cell is visited for the first time with this direction, add it to the queue.\n                  if (neighbor, direction) not in visited:\n                      visited.add((neighbor, direction))\n\n                      # Determine the direction to move towards the neighbor.\n                      dx, dy = nx - pos[0], ny - pos[1]\n                      if dx == 1:\n                          action = actions[\"RIGHT\"]\n                          new_direction = 3\n                      elif dx == -1:\n                          action = actions[\"LEFT\"]\n                          new_direction = 2\n                      elif dy == 1:\n                          action = actions[\"DOWN\"]\n                          new_direction = 0\n                      else:  # dy == -1\n                          action = actions[\"UP\"]\n                          new_direction = 1\n\n                      if direction != new_direction:\n                          # If the current direction is not the target direction, turn first.\n                          heapq.heappush(queue, (len(actions_taken) + heuristic((nx, ny), pos), neighbor, actions_taken + [action], new_direction))\n                      else:\n                          # Otherwise, move towards the neighbor.\n                          heapq.heappush(queue, (len(actions_taken) + heuristic(neighbor, pos), neighbor, actions_taken + [action], new_direction))\n\n  # If no path is found to collect the primitive, return an empty list.\n  return []", "island_id": 2, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T03:00:32.251521", "function_name": "collect", "function_body": "  actions = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  # Helper function to find neighboring positions.\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  current_state = env._current_state\n\n  # Define a priority queue for A* search and a set to track visited positions with direction.\n  import heapq\n  queue = []\n  heapq.heappush(queue, (0, current_state.pos, [], current_state.dir))\n  visited = set([(current_state.pos, current_state.dir)])\n\n  def get_primitive_index(primitive_name):\n      return current_state.world.cookbook.index[primitive_name]\n\n  target_primitive_index = get_primitive_index(primitive)\n\n  # Heuristic function: Manhattan distance.\n  def heuristic(pos1, pos2):\n      return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n\n  while queue:\n      _, pos, actions_taken, direction = heapq.heappop(queue)\n\n      if current_state.grid[pos[0], pos[1], target_primitive_index] > 0:\n          return actions_taken + [actions[\"USE\"]]\n\n      neighbors = get_neighbors(pos)\n      for neighbor in neighbors:\n          nx, ny = neighbor\n\n          if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n              # Check if the cell is not blocked by non-grabbable entities.\n              if all(current_state.grid[ny, nx, env_index] == 0 for env_index in current_state.world.non_grabbable_indices):\n                  if (neighbor, direction) not in visited:\n                      visited.add((neighbor, direction))\n\n                      # Determine the direction to move towards the neighbor.\n                      dx, dy = nx - pos[0], ny - pos[1]\n                      if dx == 1:\n                          action = actions[\"RIGHT\"]\n                          new_direction = 3\n                      elif dx == -1:\n                          action = actions[\"LEFT\"]\n                          new_direction = 2\n                      elif dy == 1:\n                          action = actions[\"DOWN\"]\n                          new_direction = 0\n                      else:  # dy == -1\n                          action = actions[\"UP\"]\n                          new_direction = 1\n\n                      if direction != new_direction:\n                          # If the current direction is not the target direction, turn first.\n                          heapq.heappush(queue, (len(actions_taken) + heuristic((nx, ny), pos), neighbor, actions_taken + [action], new_direction))\n                      else:\n                          # Otherwise, move towards the neighbor.\n                          heapq.heappush(queue, (len(actions_taken) + heuristic(neighbor, pos), neighbor, actions_taken + [action], new_direction))\n\n  return []", "island_id": 2, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T03:01:38.924444", "function_name": "collect", "function_body": "  def get_primitive_index(primitive_name):\n      try:\n          return env.world.cookbook.index[primitive_name]\n      except KeyError:\n          raise ValueError(f\"Primitive {primitive_name} not found in cookbook.\")\n\n  def is_blocked(x, y):\n    for kind_index in env.world.non_grabbable_indices:\n      if env._current_state.grid[x, y, kind_index] > 0:\n        return True\n    return False\n\n  # Determine the target primitive index from its name\n  target_primitive_index = get_primitive_index(primitive)\n\n  # Initialize an empty list to store the actions needed\n  actions_to_take = []\n\n  # Current position of the agent\n  current_x, current_y = env._current_state.pos\n\n  # Get the grid dimensions\n  width, height, _ = env._current_state.grid.shape\n\n  # Use BFS to find the shortest path to the target primitive\n  queue = collections.deque([(current_x, current_y, actions_to_take)])\n  visited = set()\n  visited.add((current_x, current_y))\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    # Check if we are next to a cell containing the target primitive\n    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n      nx, ny = x + dx, y + dy\n\n      # Ensure within bounds and not visited\n      if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n        if env._current_state.grid[nx, ny, target_primitive_index] > 0:\n          # Move to the adjacent cell containing the primitive\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          actions_to_take.extend(path + [move_action])\n\n          # Collect the primitive\n          actions_to_take.append(craft.USE)\n          return actions_to_take\n\n        # Mark as visited and add to queue if not blocked\n        if not is_blocked(nx, ny):\n          visited.add((nx, ny))\n          new_path = path.copy()\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          new_path.append(move_action)\n          queue.append((nx, ny, new_path))\n\n  # If no path is found, return an empty list of actions\n  return []", "island_id": 6, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T03:01:39.969015", "function_name": "collect", "function_body": "  def get_primitive_index(primitive_name):\n      try:\n          return env.world.cookbook.index[primitive_name]\n      except KeyError:\n          raise ValueError(f\"Primitive {primitive_name} not found in cookbook.\")\n\n  def is_blocked(x, y):\n    for kind_index in env.world.non_grabbable_indices:\n      if env._current_state.grid[x, y, kind_index] > 0:\n        return True\n    return False\n\n  # Determine the target primitive index from its name\n  target_primitive_index = get_primitive_index(primitive)\n\n  # Initialize an empty list to store the actions needed\n  actions_to_take = []\n\n  # Current position of the agent\n  current_x, current_y = env._current_state.pos\n\n  # Get the grid dimensions\n  width, height, _ = env._current_state.grid.shape\n\n  # Use BFS to find the shortest path to the target primitive\n  queue = collections.deque([(current_x, current_y, actions_to_take)])\n  visited = set()\n  visited.add((current_x, current_y))\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    # Check if we are next to a cell containing the target primitive\n    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n      nx, ny = x + dx, y + dy\n\n      # Ensure within bounds and not visited\n      if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n        if env._current_state.grid[nx, ny, target_primitive_index] > 0:\n          # Move to the adjacent cell containing the primitive\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          actions_to_take.extend(path + [move_action])\n\n          # Collect the primitive\n          actions_to_take.append(craft.USE)\n          return actions_to_take\n\n        # Mark as visited and add to queue if not blocked\n        if not is_blocked(nx, ny):\n          visited.add((nx, ny))\n          new_path = path.copy()\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          new_path.append(move_action)\n          queue.append((nx, ny, new_path))\n\n  # If no path is found, return an empty list of actions\n  return []", "island_id": 6, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T03:02:35.923695", "function_name": "collect", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Get the index of the target primitive\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Helper function to check if a cell is blocked by obstacles other than the primitive itself\n  def is_blocked(x, y):\n    return any(env._current_state.grid[x, y][idx] > 0 for idx in range(len(env.world.cookbook.index)) if idx != primitive_index)\n\n  # Directions and their corresponding actions\n  directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n  actions = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, \n             (0, -1): craft.DOWN, (0, 1): craft.UP}\n\n  # BFS to find the shortest path to a cell containing the primitive\n  start_x, start_y = env._current_state.pos\n  visited = set()\n  queue = deque([(start_x, start_y, [])])  # (x, y, path)\n  \n  while queue:\n    x, y, path = queue.popleft()\n\n    if (x, y) in visited:\n      continue\n\n    visited.add((x, y))\n\n    for dx, dy in directions:\n      nx, ny = x + dx, y + dy\n      \n      # Check bounds\n      if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n        # If the cell contains the primitive, return the path to it\n        if env._current_state.grid[nx, ny][primitive_index] > 0:\n          move_action = actions[(dx, dy)]\n          use_action = craft.USE\n          return path + [move_action, use_action]\n        \n        # If the cell is not blocked and hasn't been visited, add to queue\n        if not is_blocked(nx, ny):\n          move_action = actions[(dx, dy)]\n          queue.append((nx, ny, path + [move_action]))\n  \n  return []  # Return an empty list if no path found", "island_id": 4, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T03:02:36.984380", "function_name": "collect", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Get the index of the target primitive\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Helper function to check if a cell is blocked by obstacles other than the primitive itself, \n  # considering the agent's current position and direction.\n  def is_blocked(x, y):\n    return any(env._current_state.grid[x, y] > 0) and not env._current_state.grid[x, y][primitive_index] > 0\n\n  # Directions and their corresponding actions\n  directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n  action_map = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, \n                (0, -1): craft.DOWN, (0, 1): craft.UP}\n\n  # BFS to find the shortest path to a cell containing the primitive\n  start_x, start_y = env._current_state.pos\n  visited = set()\n  queue = deque([(start_x, start_y, [])])  # (x, y, path)\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    if (x, y) in visited:\n      continue\n\n    visited.add((x, y))\n\n    for dx, dy in directions:\n      nx, ny = x + dx, y + dy\n      \n      # Check bounds\n      if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n        # If the cell contains the primitive, return the path to it\n        if env._current_state.grid[nx, ny][primitive_index] > 0:\n          move_action = action_map[(dx, dy)]\n          use_action = craft.USE\n          return path + [move_action, use_action]\n        \n        # If the cell is not blocked and hasn't been visited, add to queue\n        if not is_blocked(nx, ny):\n          move_action = action_map[(dx, dy)]\n          queue.append((nx, ny, path + [move_action]))\n  \n  return []  # Return an empty list if no path found", "island_id": 4, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T03:03:28.952607", "function_name": "collect", "function_body": "  def _find_shortest_path(grid, start_pos, target_kind):\n    width, height = grid.shape[:2]\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n      \n      if grid[x, y].argmax() == target_kind and (x, y) != start_pos:\n        return path\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          # Allow movement on clear cells or through tools that are available in the inventory\n          cell_kind = grid[nx, ny].argmax()\n          if grid[nx, ny].sum() == 1 or inventory[cell_kind] > 0:  \n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))\n    \n    return None\n\n  def _get_action_index_from_direction(direction):\n    mapping = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, (0, -1): craft.DOWN, (0, 1): craft.UP}\n    return mapping.get(direction)\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  inventory = current_state.inventory\n  \n  primitive_index = current_state.world.cookbook.index.index(primitive)\n  \n  path_to_primitive = _find_shortest_path(grid, pos, primitive_index)\n  \n  if not path_to_primitive:\n    return []\n  \n  actions = [_get_action_index_from_direction(step) for step in path_to_primitive]\n  actions.append(craft.USE)  # Add action to collect the primitive\n  \n  return actions", "island_id": 9, "scores": {"3": 2.5}}
{"timestamp": "2025-09-26T03:03:30.002853", "function_name": "collect", "function_body": "  def _find_shortest_path(grid, start_pos, target_kind):\n    width, height = grid.shape[:2]\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n      \n      if grid[x, y].argmax() == target_kind and (x, y) != start_pos:\n        return path\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          # Allow movement on clear cells or through tools that are available in the inventory\n          cell_kind = grid[nx, ny].argmax()\n          if grid[nx, ny].sum() == 1 or inventory[cell_kind] > 0:  \n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))\n    \n    return None\n\n  def _get_action_index_from_direction(direction):\n    mapping = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, (0, -1): craft.DOWN, (0, 1): craft.UP}\n    return mapping.get(direction)\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  inventory = current_state.inventory\n  \n  primitive_index = current_state.world.cookbook.index.index(primitive)\n  \n  path_to_primitive = _find_shortest_path(grid, pos, primitive_index)\n  \n  if not path_to_primitive:\n    return []\n  \n  actions = [_get_action_index_from_direction(step) for step in path_to_primitive]\n  actions.append(craft.USE)  # Add action to collect the primitive\n  \n  return actions", "island_id": 9, "scores": {"3": 2.5}}
{"timestamp": "2025-09-26T03:04:22.373587", "function_name": "collect", "function_body": "  def _find_shortest_path(grid, start_pos, target_kind, inventory):\n    width, height = grid.shape[:2]\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n      \n      if grid[x, y].argmax() == target_kind and (x, y) != start_pos:\n        return path\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          cell_content_index = grid[nx, ny].argmax()\n          # Allow movement on clear cells or through tools that are available in the inventory\n          if grid[nx, ny].sum() == 1 or inventory[cell_content_index] > 0:  \n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))\n    \n    return None\n\n  def _get_action_index_from_direction(direction):\n    mapping = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, (0, -1): craft.DOWN, (0, 1): craft.UP}\n    return mapping.get(direction)\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  inventory = current_state.inventory\n  \n  primitive_index = current_state.world.cookbook.index.index(primitive)\n  \n  path_to_primitive = _find_shortest_path(grid, pos, primitive_index, inventory)\n  \n  if not path_to_primitive:\n    return []\n  \n  actions = [_get_action_index_from_direction(step) for step in path_to_primitive]\n  actions.append(craft.USE)  # Add action to collect the primitive\n  \n  return actions", "island_id": 9, "scores": {"3": 2.5}}
{"timestamp": "2025-09-26T03:04:23.419229", "function_name": "collect", "function_body": "  def _find_shortest_path(grid, start_pos, target_kind, inventory):\n    width, height = grid.shape[:2]\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n      \n      if grid[x, y].argmax() == target_kind and (x, y) != start_pos:\n        return path\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          # Allow movement on clear cells or through tools that are available in the inventory\n          cell_content_index = grid[nx, ny].argmax()\n          if grid[nx, ny].sum() == 1 or inventory[cell_content_index] > 0:  \n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))\n    \n    return None\n\n  def _get_action_index_from_direction(direction):\n    mapping = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, (0, -1): craft.DOWN, (0, 1): craft.UP}\n    return mapping.get(direction)\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  inventory = current_state.inventory\n  \n  primitive_index = current_state.world.cookbook.index.index(primitive)\n  \n  path_to_primitive = _find_shortest_path(grid, pos, primitive_index, inventory)\n  \n  if not path_to_primitive:\n    return []\n  \n  actions = [_get_action_index_from_direction(step) for step in path_to_primitive]\n  actions.append(craft.USE)  # Add action to collect the primitive\n  \n  return actions", "island_id": 9, "scores": {"3": 2.5}}
{"timestamp": "2025-09-26T03:05:36.607643", "function_name": "collect", "function_body": "  actions = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  # Helper function to find neighboring positions.\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  # Get the current state of the environment.\n  current_state = env._current_state\n\n  # Define a queue for BFS and a set to track visited positions with direction.\n  queue = collections.deque([(current_state.pos, [], current_state.dir)])\n  visited = set([(current_state.pos, current_state.dir)])\n\n  # Helper function to get the index of a primitive name.\n  def get_primitive_index(primitive_name):\n      return current_state.world.cookbook.index[primitive_name]\n\n  # Get the index for the target primitive.\n  target_primitive_index = get_primitive_index(primitive)\n\n  # Perform BFS to find a path to collect the primitive.\n  while queue:\n      pos, actions_taken, direction = queue.popleft()\n\n      # Check if we are at a cell with the desired primitive.\n      if current_state.grid[pos[0], pos[1], target_primitive_index] > 0:\n          return actions_taken + [actions[\"USE\"]]\n\n      # Get neighboring positions and filter out invalid ones.\n      neighbors = get_neighbors(pos)\n      for neighbor in neighbors:\n          nx, ny = neighbor\n\n          # Ensure the neighbor is within bounds.\n          if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n              # Check if the cell is not blocked by non-grabbable entities.\n              if all(current_state.grid[ny, nx, env_index] == 0 for env_index in current_state.world.non_grabbable_indices):\n                  # If the cell is visited for the first time with this direction, add it to the queue.\n                  if (neighbor, direction) not in visited:\n                      visited.add((neighbor, direction))\n\n                      # Determine the direction to move towards the neighbor.\n                      dx, dy = nx - pos[0], ny - pos[1]\n                      if dx == 1:\n                          action = actions[\"RIGHT\"]\n                          new_direction = 3\n                      elif dx == -1:\n                          action = actions[\"LEFT\"]\n                          new_direction = 2\n                      elif dy == 1:\n                          action = actions[\"DOWN\"]\n                          new_direction = 0\n                      else:  # dy == -1\n                          action = actions[\"UP\"]\n                          new_direction = 1\n\n                      if direction != new_direction:\n                          # If the current direction is not the target direction, turn first.\n                          queue.append((pos, actions_taken + [action], new_direction))\n                      else:\n                          # Otherwise, move towards the neighbor.\n                          queue.append((neighbor, actions_taken + [action], new_direction))\n\n  # If no path is found to collect the primitive, return an empty list.\n  return []", "island_id": 2, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T03:05:37.678757", "function_name": "collect", "function_body": "  actions = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  # Helper function to find neighboring positions.\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  # Get the current state of the environment.\n  current_state = env._current_state\n\n  # Define a queue for BFS and a set to track visited positions with direction.\n  queue = collections.deque([(current_state.pos, [], current_state.dir)])\n  visited = set([(current_state.pos, current_state.dir)])\n\n  # Helper function to get the index of a primitive name.\n  def get_primitive_index(primitive_name):\n      return current_state.world.cookbook.index[primitive_name]\n\n  # Get the index for the target primitive.\n  target_primitive_index = get_primitive_index(primitive)\n\n  # Perform BFS to find a path to collect the primitive.\n  while queue:\n      pos, actions_taken, direction = queue.popleft()\n\n      # Check if we are at a cell with the desired primitive.\n      if current_state.grid[pos[0], pos[1], target_primitive_index] > 0:\n          return actions_taken + [actions[\"USE\"]]\n\n      # Get neighboring positions and filter out invalid ones.\n      neighbors = get_neighbors(pos)\n      for neighbor in neighbors:\n          nx, ny = neighbor\n\n          # Ensure the neighbor is within bounds.\n          if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n              # Check if the cell is not blocked by non-grabbable entities.\n              if all(current_state.grid[ny, nx, env_index] == 0 for env_index in current_state.world.non_grabbable_indices):\n                  # If the cell is visited for the first time with this direction, add it to the queue.\n                  if (neighbor, direction) not in visited:\n                      visited.add((neighbor, direction))\n\n                      # Determine the direction to move towards the neighbor.\n                      dx, dy = nx - pos[0], ny - pos[1]\n                      if dx == 1 and direction == 3:  # Right\n                          action = actions[\"RIGHT\"]\n                      elif dx == -1 and direction == 2:  # Left\n                          action = actions[\"LEFT\"]\n                      elif dy == 1 and direction == 0:  # Down\n                          action = actions[\"DOWN\"]\n                      elif dy == -1 and direction == 1:  # Up\n                          action = actions[\"UP\"]\n                      else:\n                          continue\n\n                      queue.append((neighbor, actions_taken + [action], direction))\n\n  # If no path is found to collect the primitive, return an empty list.\n  return []", "island_id": 2, "scores": {"3": 2.5}}
{"timestamp": "2025-09-26T03:06:45.344150", "function_name": "collect", "function_body": "  def get_primitive_index(primitive_name):\n      try:\n          return env.world.cookbook.index[primitive_name]\n      except KeyError:\n          raise ValueError(f\"Primitive {primitive_name} not found in cookbook.\")\n\n  def is_blocked(x, y):\n    for kind_index in env.world.non_grabbable_indices:\n      if env._current_state.grid[x, y, kind_index] > 0 and kind_index != env.world.cookbook.index['WORKSHOP0']:\n        return True\n    return False\n\n  # Determine the target primitive index from its name\n  target_primitive_index = get_primitive_index(primitive)\n\n  # Initialize an empty list to store the actions needed\n  actions_to_take = []\n\n  # Current position of the agent\n  current_x, current_y = env._current_state.pos\n\n  # Get the grid dimensions\n  width, height, _ = env._current_state.grid.shape\n\n  # Use BFS to find the shortest path to the target primitive\n  queue = collections.deque([(current_x, current_y, actions_to_take)])\n  visited = set()\n  visited.add((current_x, current_y))\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    # Check if we are next to a cell containing the target primitive\n    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n      nx, ny = x + dx, y + dy\n\n      # Ensure within bounds and not visited\n      if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n        if env._current_state.grid[nx, ny, target_primitive_index] > 0:\n          # Move to the adjacent cell containing the primitive\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          actions_to_take.extend(path + [move_action])\n\n          # Collect the primitive\n          actions_to_take.append(craft.USE)\n          return actions_to_take\n\n        # Mark as visited and add to queue if not blocked\n        if not is_blocked(nx, ny):\n          visited.add((nx, ny))\n          new_path = path.copy()\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          new_path.append(move_action)\n          queue.append((nx, ny, new_path))\n\n  # If no path is found, return an empty list of actions\n  return []", "island_id": 6, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T03:06:46.458581", "function_name": "collect", "function_body": "  def get_primitive_index(primitive_name):\n      try:\n          return env.world.cookbook.index[primitive_name]\n      except KeyError:\n          raise ValueError(f\"Primitive {primitive_name} not found in cookbook.\")\n\n  def is_blocked(x, y):\n    for kind_index in env.world.non_grabbable_indices:\n      if env._current_state.grid[x, y, kind_index] > 0:\n        return True\n    return False\n\n  # Determine the target primitive index from its name\n  target_primitive_index = get_primitive_index(primitive)\n\n  # Initialize an empty list to store the actions needed\n  actions_to_take = []\n\n  # Current position of the agent\n  current_x, current_y = env._current_state.pos\n\n  # Get the grid dimensions\n  width, height, _ = env._current_state.grid.shape\n\n  # Use BFS to find the shortest path to the target primitive\n  queue = collections.deque([(current_x, current_y, actions_to_take)])\n  visited = set()\n  visited.add((current_x, current_y))\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    # Check if we are next to a cell containing the target primitive\n    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n      nx, ny = x + dx, y + dy\n\n      # Ensure within bounds and not visited\n      if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n        if env._current_state.grid[nx, ny, target_primitive_index] > 0:\n          # Move to the adjacent cell containing the primitive\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          actions_to_take.extend(path + [move_action])\n\n          # Collect the primitive\n          actions_to_take.append(craft.USE)\n          return actions_to_take\n\n        # Mark as visited and add to queue if not blocked\n        if not is_blocked(nx, ny):\n          visited.add((nx, ny))\n          new_path = path.copy()\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          new_path.append(move_action)\n          queue.append((nx, ny, new_path))\n\n  # If no path is found, return an empty list of actions\n  return []", "island_id": 6, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T03:07:51.645685", "function_name": "collect", "function_body": "  actions = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  current_state = env._current_state\n\n  queue = collections.deque([(current_state.pos, [])])\n  visited = set([current_state.pos])\n\n  target_primitive_index = current_state.world.cookbook.index[primitive]\n\n  while queue:\n      pos, actions_taken = queue.popleft()\n\n      if current_state.grid[pos[0], pos[1], target_primitive_index] > 0:\n          return actions_taken + [actions[\"USE\"]]\n\n      neighbors = get_neighbors(pos)\n      for neighbor in neighbors:\n          nx, ny = neighbor\n\n          if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n              # Check if the cell is not blocked by non-grabbable entities.\n              if all(current_state.grid[ny, nx, env_index] == 0 for env_index in current_state.world.non_grabbable_indices):\n                  if neighbor not in visited:\n                      visited.add(neighbor)\n\n                      dx, dy = nx - pos[0], ny - pos[1]\n                      if dx == 1:\n                          action = actions[\"RIGHT\"]\n                      elif dx == -1:\n                          action = actions[\"LEFT\"]\n                      elif dy == 1:\n                          action = actions[\"DOWN\"]\n                      else:  # dy == -1\n                          action = actions[\"UP\"]\n\n                      queue.append((neighbor, actions_taken + [action]))\n\n              # Check if the cell can be cleared using available tools.\n              for tool_index in current_state.world.grabbable_indices:\n                  if current_state.inventory[tool_index] > 0 and current_state.grid[ny, nx, tool_index] > 0:\n                      return actions_taken + [actions[\"USE\"]]\n\n      # Check if the current position can be cleared using available tools.\n      for tool_index in current_state.world.grabbable_indices:\n          if current_state.inventory[tool_index] > 0 and any(current_state.grid[pos[1], pos[0], tool_index] > 0):\n              return actions_taken + [actions[\"USE\"]]\n\n  return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-26T03:07:52.757201", "function_name": "collect", "function_body": "  def get_primitive_index(primitive_name):\n      return env._current_state.world.cookbook.index[primitive_name]\n\n  actions = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  current_state = env._current_state\n\n  queue = collections.deque([(current_state.pos, [])])\n  visited = set([current_state.pos])\n\n  target_primitive_index = get_primitive_index(primitive)\n\n  while queue:\n      pos, actions_taken = queue.popleft()\n\n      if current_state.grid[pos[0], pos[1], target_primitive_index] > 0:\n          return actions_taken + [actions[\"USE\"]]\n\n      neighbors = get_neighbors(pos)\n      for neighbor in neighbors:\n          nx, ny = neighbor\n\n          # Check bounds\n          if not (0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]):\n              continue\n\n          # If the cell is not visited and not blocked by non-grabbable entities\n          if neighbor not in visited:\n              if all(current_state.grid[ny, nx, env_index] == 0 for env_index in current_state.world.non_grabbable_indices):\n                  visited.add(neighbor)\n\n                  dx, dy = nx - pos[0], ny - pos[1]\n                  action = actions[\"RIGHT\"] if dx == 1 else \\\n                             actions[\"LEFT\"] if dx == -1 else \\\n                             actions[\"DOWN\"] if dy == 1 else \\\n                             actions[\"UP\"]\n\n                  queue.append((neighbor, actions_taken + [action]))\n\n          # Check if the cell can be cleared using available tools\n          for tool_index in current_state.world.grabbable_indices:\n              if (current_state.inventory[tool_index] > 0 and \n                  current_state.grid[ny, nx, tool_index] > 0):\n                  return actions_taken + [actions[\"USE\"]]\n\n  # Attempt to clear obstacles using available tools around the current position\n  for neighbor in get_neighbors(current_state.pos):\n      nx, ny = neighbor\n\n      if not (0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]):\n          continue\n\n      for tool_index in current_state.world.grabbable_indices:\n          if (current_state.inventory[tool_index] > 0 and \n              current_state.grid[ny, nx, tool_index] > 0):\n              return [actions[\"USE\"]]\n\n  return []", "island_id": 1, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T03:08:44.858094", "function_name": "collect", "function_body": "  def _find_shortest_path(grid, start_pos, target_kind, inventory):\n    width, height = grid.shape[:2]\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n      \n      if grid[x, y].argmax() == target_kind and (x, y) != start_pos:\n        return path\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          cell_content_index = grid[nx, ny].argmax()\n          # Allow movement on clear cells or through tools that are available in the inventory\n          if grid[nx, ny].sum() == 1 or inventory[cell_content_index] > 0:  \n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))\n    \n    return None\n\n  def _get_action_index_from_direction(direction):\n    mapping = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, (0, -1): craft.DOWN, (0, 1): craft.UP}\n    return mapping.get(direction)\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  inventory = current_state.inventory\n  \n  primitive_index = current_state.world.cookbook.index.index(primitive)\n  \n  path_to_primitive = _find_shortest_path(grid, pos, primitive_index, inventory)\n  \n  if not path_to_primitive:\n    return []\n  \n  actions = [_get_action_index_from_direction(step) for step in path_to_primitive]\n  actions.append(craft.USE)  # Add action to collect the primitive\n  \n  return actions", "island_id": 9, "scores": {"3": 2.5}}
{"timestamp": "2025-09-26T03:08:45.909539", "function_name": "collect", "function_body": "  def _find_shortest_path(grid, start_pos, target_kind):\n    width, height = grid.shape[:2]\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n      \n      if grid[x, y].argmax() == target_kind and (x, y) != start_pos:\n        return path\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          # Allow movement on clear cells or through tools that are available in the inventory\n          cell_kind = grid[nx, ny].argmax()\n          if grid[nx, ny].sum() == 1 or inventory[cell_kind] > 0:  \n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))\n    \n    return None\n\n  def _get_action_index_from_direction(direction):\n    mapping = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, (0, -1): craft.DOWN, (0, 1): craft.UP}\n    return mapping.get(direction)\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  inventory = current_state.inventory\n  \n  primitive_index = current_state.world.cookbook.index.index(primitive)\n  \n  path_to_primitive = _find_shortest_path(grid, pos, primitive_index)\n  \n  if not path_to_primitive:\n    return []\n  \n  actions = [_get_action_index_from_direction(step) for step in path_to_primitive]\n  actions.append(craft.USE)  # Add action to collect the primitive\n  \n  return actions", "island_id": 9, "scores": {"3": 2.5}}
{"timestamp": "2025-09-26T03:10:00.103378", "function_name": "collect", "function_body": "  def get_primitive_index(primitive_name):\n      return env._current_state.world.cookbook.index[primitive_name]\n\n  actions = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  current_state = env._current_state\n\n  queue = collections.deque([(current_state.pos, [])])\n  visited = set([current_state.pos])\n\n  target_primitive_index = get_primitive_index(primitive)\n\n  while queue:\n      pos, actions_taken = queue.popleft()\n\n      if current_state.grid[pos[0], pos[1], target_primitive_index] > 0:\n          return actions_taken + [actions[\"USE\"]]\n\n      neighbors = get_neighbors(pos)\n      for neighbor in neighbors:\n          nx, ny = neighbor\n\n          if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n              blocked_by_environment = False\n              for env_index in current_state.world.non_grabbable_indices:\n                  if current_state.grid[ny, nx, env_index] > 0:\n                      blocked_by_environment = True\n                      break\n\n              if not blocked_by_environment:\n                  if neighbor not in visited:\n                      visited.add(neighbor)\n\n                      dx, dy = nx - pos[0], ny - pos[1]\n                      if dx == 1:\n                          action = actions[\"RIGHT\"]\n                      elif dx == -1:\n                          action = actions[\"LEFT\"]\n                      elif dy == 1:\n                          action = actions[\"DOWN\"]\n                      else:  # dy == -1\n                          action = actions[\"UP\"]\n\n                      queue.append((neighbor, actions_taken + [action]))\n              else:\n                  for tool_index in current_state.world.grabbable_indices:\n                      if current_state.inventory[tool_index] > 0 and current_state.grid[ny, nx, tool_index] > 0:\n                          return actions_taken + [actions[\"USE\"]]\n\n                  for env_index in current_state.world.non_grabbable_indices:\n                      if current_state.grid[ny, nx, env_index] > 0:\n                          for tool_index in current_state.world.grabbable_indices:\n                              if current_state.inventory[tool_index] > 0 and can_use_tool_on_env(tool_index, env_index):\n                                  return actions_taken + [actions[\"USE\"]]\n\n  return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-26T03:10:01.166816", "function_name": "collect", "function_body": "  def get_primitive_index(primitive_name):\n      return env._current_state.world.cookbook.index[primitive_name]\n\n  actions = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  current_state = env._current_state\n\n  queue = collections.deque([(current_state.pos, [])])\n  visited = set([current_state.pos])\n\n  target_primitive_index = get_primitive_index(primitive)\n\n  while queue:\n      pos, actions_taken = queue.popleft()\n\n      if current_state.grid[pos[0], pos[1], target_primitive_index] > 0:\n          return actions_taken + [actions[\"USE\"]]\n\n      neighbors = get_neighbors(pos)\n      for neighbor in neighbors:\n          nx, ny = neighbor\n\n          # Ensure the neighbor is within bounds.\n          if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n              blocked_by_environment = False\n              for env_index in current_state.world.non_grabbable_indices:\n                  if current_state.grid[ny, nx, env_index] > 0:\n                      blocked_by_environment = True\n                      break\n\n              if not blocked_by_environment:\n                  if neighbor not in visited:\n                      visited.add(neighbor)\n\n                      dx, dy = nx - pos[0], ny - pos[1]\n                      if dx == 1:\n                          action = actions[\"RIGHT\"]\n                      elif dx == -1:\n                          action = actions[\"LEFT\"]\n                      elif dy == 1:\n                          action = actions[\"DOWN\"]\n                      else:  # dy == -1\n                          action = actions[\"UP\"]\n\n                      queue.append((neighbor, actions_taken + [action]))\n              else:\n                  # Check if any tool in inventory can be used to clear the path.\n                  for tool_index in current_state.world.grabbable_indices:\n                      if current_state.inventory[tool_index] > 0 and current_state.grid[ny, nx, tool_index] > 0:\n                          return actions_taken + [actions[\"USE\"]]\n\n                  # Check if any non-grabbable entity can be cleared by using a tool.\n                  for env_index in current_state.world.non_grabbable_indices:\n                      if current_state.grid[ny, nx, env_index] > 0:\n                          for tool_index in current_state.world.grabbable_indices:\n                              if current_state.inventory[tool_index] > 0:\n                                  return actions_taken + [actions[\"USE\"]]\n\n                  # If no tools can clear the path, attempt to move around obstacles.\n                  for direction in get_neighbors(pos):\n                      dx, dy = direction\n                      if (nx != dx or ny != dy) and (0 <= dx < current_state.grid.shape[1] and 0 <= dy < current_state.grid.shape[0]):\n                          if all(current_state.grid[dy, dx, env_index] == 0 for env_index in current_state.world.non_grabbable_indices):\n                              if neighbor not in visited:\n                                  visited.add(neighbor)\n\n                                  action = actions[\"UP\"] if ny > dy else actions[\"DOWN\"] if ny < dy else actions[\"LEFT\"] if nx > dx else actions[\"RIGHT\"]\n                                  queue.append((direction, actions_taken + [action]))\n\n  return []", "island_id": 1, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T03:10:49.835095", "function_name": "collect", "function_body": "  def _find_shortest_path(grid, start_pos, target_kind):\n    width, height = grid.shape[:2]\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n      \n      if grid[x, y].argmax() == target_kind and (x, y) != start_pos:\n        return path\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited and grid[nx, ny].sum() == 1:\n          visited.add((nx, ny))\n          queue.append((nx, ny, path + [(dx, dy)]))\n    \n    return None\n\n  def _get_action_index_from_direction(direction):\n    mapping = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, (0, -1): craft.DOWN, (0, 1): craft.UP}\n    return mapping.get(direction)\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  \n  primitive_index = current_state.world.cookbook.index.index(primitive)\n  \n  path_to_primitive = _find_shortest_path(grid, pos, primitive_index)\n  \n  if not path_to_primitive:\n    return []\n  \n  actions = [_get_action_index_from_direction(step) for step in path_to_primitive]\n  actions.append(craft.USE)  # Add action to collect the primitive\n  \n  return actions", "island_id": 8, "scores": {"3": 2.5}}
{"timestamp": "2025-09-26T03:10:50.882361", "function_name": "collect", "function_body": "  def _find_shortest_path(grid, start_pos, target_kind):\n    width, height = grid.shape[:2]\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n      \n      if grid[x, y].argmax() == target_kind and (x, y) != start_pos:\n        return path\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          cell_contents = grid[nx, ny].argmax()\n          if cell_contents == target_kind or cell_contents in current_state.world.cookbook.primitives:  # Allow moving through primitives\n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))\n    \n    return None\n\n  def _get_action_index_from_direction(direction):\n    mapping = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, (0, -1): craft.DOWN, (0, 1): craft.UP}\n    return mapping.get(direction)\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  inventory = current_state.inventory\n  \n  primitive_index = current_state.world.cookbook.index.index(primitive)\n  \n  path_to_primitive = _find_shortest_path(grid, pos, primitive_index)\n  \n  if not path_to_primitive:\n    return []\n  \n  actions = [_get_action_index_from_direction(step) for step in path_to_primitive]\n  actions.append(craft.USE)  # Add action to collect the primitive\n  \n  return actions", "island_id": 8, "scores": {"3": 2.5}}
{"timestamp": "2025-09-26T03:11:42.873011", "function_name": "collect", "function_body": "  def _find_shortest_path(grid, start_pos, target_kind):\n    width, height = grid.shape[:2]\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n      \n      if grid[x, y].argmax() == target_kind and (x, y) != start_pos:\n        return path\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          cell_content_index = grid[nx, ny].argmax()\n          # Allow movement on clear cells or through tools that are available in the inventory\n          if grid[nx, ny].sum() == 1 or inventory[cell_content_index] > 0:  \n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))\n    \n    return None\n\n  def _get_action_index_from_direction(direction):\n    mapping = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, (0, -1): craft.DOWN, (0, 1): craft.UP}\n    return mapping.get(direction)\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  inventory = current_state.inventory\n  \n  primitive_index = current_state.world.cookbook.index.index(primitive)\n  \n  path_to_primitive = _find_shortest_path(grid, pos, primitive_index)\n  \n  if not path_to_primitive:\n    return []\n  \n  actions = [_get_action_index_from_direction(step) for step in path_to_primitive]\n  actions.append(craft.USE)  # Add action to collect the primitive\n  \n  return actions", "island_id": 9, "scores": {"3": 2.5}}
{"timestamp": "2025-09-26T03:11:43.924365", "function_name": "collect", "function_body": "  def _find_shortest_path(grid, start_pos, target_kind):\n    width, height = grid.shape[:2]\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n      \n      if grid[x, y].argmax() == target_kind and (x, y) != start_pos:\n        return path\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          cell_content_index = grid[nx, ny].argmax()\n          # Allow movement on clear cells or through tools that are available in the inventory\n          if grid[nx, ny].sum() == 1 or inventory[cell_content_index] > 0:  \n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))\n    \n    return None\n\n  def _get_action_index_from_direction(direction):\n    mapping = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, (0, -1): craft.DOWN, (0, 1): craft.UP}\n    return mapping.get(direction)\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  inventory = current_state.inventory\n  \n  primitive_index = current_state.world.cookbook.index.index(primitive)\n  \n  path_to_primitive = _find_shortest_path(grid, pos, primitive_index)\n  \n  if not path_to_primitive:\n    return []\n  \n  actions = [_get_action_index_from_direction(step) for step in path_to_primitive]\n  actions.append(craft.USE)  # Add action to collect the primitive\n  \n  return actions", "island_id": 9, "scores": {"3": 2.5}}
{"timestamp": "2025-09-26T03:13:11.858058", "function_name": "collect", "function_body": "  index = env.world.cookbook.index[primitive]\n  \n  # Get the current position and direction of the agent\n  pos_x, pos_y = env._current_state.pos\n  dir = env._current_state.dir\n\n  # Find all positions in the grid that contain the desired primitive\n  target_positions = np.argwhere(env._current_state.grid[:, :, index] == 1)\n\n  if len(target_positions) == 0:\n    return []  # No targets found, no actions to take\n  \n  # Calculate Manhattan distances from the agent's position to each target\n  distances = [(pos_x - tx, pos_y - ty) for tx, ty in target_positions]\n  distances = [abs(dx) + abs(dy) for dx, dy in distances]\n\n  # Find the closest target position\n  min_distance_index = np.argmin(distances)\n  closest_target_pos = tuple(target_positions[min_distance_index])\n\n  def find_path(start, goal):\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]  # RIGHT, DOWN, LEFT, UP\n    queue = collections.deque([start])\n    came_from = {start: None}\n    \n    while queue:\n      current = queue.popleft()\n      \n      if current == goal:\n        break\n      \n      for direction in directions:\n        next_pos = tuple(np.add(current, direction))\n        \n        # Check if the next position is within bounds and not blocked\n        if 0 <= next_pos[0] < env._current_state.grid.shape[0] and\\\n           0 <= next_pos[1] < env._current_state.grid.shape[1]:\n          if np.all(env._current_state.grid[next_pos[0], next_pos[1]] == 0):\n            if next_pos not in came_from:\n              queue.append(next_pos)\n              came_from[next_pos] = current\n    \n    # Reconstruct the path from start to goal\n    path = []\n    while current != start:\n      path.append(current)\n      current = came_from[current]\n    path.reverse()\n    \n    return path\n\n  def get_direction_to_target(current_dir, dx, dy):\n    if dx == 1:  # Move RIGHT\n      return craft.RIGHT if current_dir != 2 else craft.USE\n    elif dx == -1:  # Move LEFT\n      return craft.LEFT if current_dir != 0 else craft.USE\n    elif dy == 1:  # Move DOWN\n      return craft.DOWN if current_dir != 3 else craft.USE\n    elif dy == -1:  # Move UP\n      return craft.UP if current_dir != 1 else craft.USE\n\n  path = find_path((pos_x, pos_y), closest_target_pos)\n  actions = []\n\n  for i in range(len(path)):\n    current_pos = path[i]\n\n    # Calculate the delta to the next position or target position\n    if i < len(path) - 1:\n      next_pos = path[i + 1]\n      delta_x = next_pos[0] - current_pos[0]\n      delta_y = next_pos[1] - current_pos[1]\n    else:  # If this is the last step, move to the target directly\n      delta_x = closest_target_pos[0] - current_pos[0]\n      delta_y = closest_target_pos[1] - current_pos[1]\n\n    action = get_direction_to_target(dir, delta_x, delta_y)\n    actions.append(action)\n\n    # Update the agent's direction\n    if action in [craft.RIGHT, craft.LEFT, craft.UP, craft.DOWN]:\n      dir = {craft.RIGHT: 2, craft.LEFT: 0, craft.DOWN: 3, craft.UP: 1}[action]\n    \n    # If we are at the target position, use the action to collect the primitive\n    if i == len(path) - 1:\n      actions.append(craft.USE)\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-26T03:13:12.989276", "function_name": "collect", "function_body": "  index = env.world.cookbook.index[primitive]\n  pos_x, pos_y = env._current_state.pos\n  dir = env._current_state.dir\n\n  # Find all positions in the grid that contain the desired primitive\n  target_positions = np.argwhere(env._current_state.grid[:, :, index] == 1)\n\n  if len(target_positions) == 0:\n    return []  # No targets found, no actions to take\n\n  # Calculate Manhattan distances from the agent's position to each target\n  distances = [(pos_x - tx, pos_y - ty) for tx, ty in target_positions]\n  distances = [abs(dx) + abs(dy) for dx, dy in distances]\n\n  # Find the closest target position\n  min_distance_index = np.argmin(distances)\n  closest_target_pos = tuple(target_positions[min_distance_index])\n\n  def find_path(start, goal):\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]  # RIGHT, DOWN, LEFT, UP\n    queue = collections.deque([start])\n    came_from = {start: None}\n    \n    while queue:\n      current = queue.popleft()\n      \n      if current == goal:\n        break\n      \n      for direction in directions:\n        next_pos = tuple(np.add(current, direction))\n        \n        # Check if the next position is within bounds and not blocked\n        if 0 <= next_pos[0] < env._current_state.grid.shape[0] and\\\n           0 <= next_pos[1] < env._current_state.grid.shape[1]:\n          if np.all(env._current_state.grid[next_pos[0], next_pos[1]] == 0):\n            if next_pos not in came_from:\n              queue.append(next_pos)\n              came_from[next_pos] = current\n    \n    # Reconstruct the path from start to goal\n    path = []\n    while current != start:\n      path.append(current)\n      current = came_from[current]\n    path.reverse()\n    \n    return path\n\n  def get_direction_to_target(current_dir, dx, dy):\n    if dx == 1:  # Move RIGHT\n      return craft.RIGHT if current_dir != 2 else craft.USE\n    elif dx == -1:  # Move LEFT\n      return craft.LEFT if current_dir != 0 else craft.USE\n    elif dy == 1:  # Move DOWN\n      return craft.DOWN if current_dir != 3 else craft.USE\n    elif dy == -1:  # Move UP\n      return craft.UP if current_dir != 1 else craft.USE\n\n  path = find_path((pos_x, pos_y), closest_target_pos)\n  actions = []\n\n  for i in range(len(path) - 1):\n    current_pos = path[i]\n    next_pos = path[i + 1]\n\n    delta_x = next_pos[0] - current_pos[0]\n    delta_y = next_pos[1] - current_pos[1]\n    \n    action = get_direction_to_target(dir, delta_x, delta_y)\n    actions.append(action)\n\n    # Update the agent's direction\n    if action in [craft.RIGHT, craft.LEFT, craft.UP, craft.DOWN]:\n      dir = {craft.RIGHT: 2, craft.LEFT: 0, craft.DOWN: 3, craft.UP: 1}[action]\n    \n    # If we are at the target position, use the action to collect the primitive\n    if i == len(path) - 2:\n      actions.append(craft.USE)\n\n  return actions", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-09-26T03:14:44.078266", "function_name": "collect", "function_body": "  index = env.world.cookbook.index[primitive]\n  grid = env._current_state.grid\n  pos_x, pos_y = env._current_state.pos\n  dir = env._current_state.dir\n\n  target_positions = np.argwhere(grid[:, :, index] == 1)\n\n  if len(target_positions) == 0:\n    return []\n\n  distances = [(pos_x - tx, pos_y - ty) for tx, ty in target_positions]\n  distances = [abs(dx) + abs(dy) for dx, dy in distances]\n\n  min_distance_index = np.argmin(distances)\n  closest_target_pos = tuple(target_positions[min_distance_index])\n\n  def find_path(start, goal):\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]  # RIGHT, DOWN, LEFT, UP\n    queue = collections.deque([start])\n    came_from = {start: None}\n    \n    while queue:\n      current = queue.popleft()\n      \n      if current == goal:\n        break\n      \n      for direction in directions:\n        next_pos = tuple(np.add(current, direction))\n        \n        # Check if the next position is within bounds and not blocked\n        if 0 <= next_pos[0] < grid.shape[0] and\\\n           0 <= next_pos[1] < grid.shape[1]:\n          # Allow movement to positions that are either empty or contain the target primitive\n          if np.all(grid[next_pos[0], next_pos[1]] == 0) or grid[next_pos[0], next_pos[1]][index] == 1:\n            if next_pos not in came_from:\n              queue.append(next_pos)\n              came_from[next_pos] = current\n    \n    # Reconstruct the path from start to goal\n    path = []\n    while current != start:\n      path.append(current)\n      current = came_from[current]\n    path.reverse()\n    \n    return path\n\n  def get_direction_to_target(current_dir, dx, dy):\n    if dx == 1:  # Move RIGHT\n      return craft.RIGHT if current_dir != 2 else craft.USE\n    elif dx == -1:  # Move LEFT\n      return craft.LEFT if current_dir != 0 else craft.USE\n    elif dy == 1:  # Move DOWN\n      return craft.DOWN if current_dir != 3 else craft.USE\n    elif dy == -1:  # Move UP\n      return craft.UP if current_dir != 1 else craft.USE\n\n  path = find_path((pos_x, pos_y), closest_target_pos)\n  actions = []\n\n  for i in range(len(path)):\n    current_pos = path[i]\n    \n    # Calculate the direction to move from the current position to the next position\n    if i < len(path) - 1:\n      next_pos = path[i + 1]\n      delta_x = next_pos[0] - current_pos[0]\n      delta_y = next_pos[1] - current_pos[1]\n      \n      action = get_direction_to_target(dir, delta_x, delta_y)\n    else:\n      # If we are at the target position, use the action to collect the primitive\n      action = craft.USE\n\n    actions.append(action)\n\n    # Update the agent's direction if an actual move was made\n    if i < len(path) - 1 and action in [craft.RIGHT, craft.LEFT, craft.UP, craft.DOWN]:\n      dir = {craft.RIGHT: 2, craft.LEFT: 0, craft.DOWN: 3, craft.UP: 1}[action]\n\n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-26T03:14:45.163132", "function_name": "collect", "function_body": "  index = env.world.cookbook.index[primitive]\n  grid = env._current_state.grid\n  pos_x, pos_y = env._current_state.pos\n  dir = env._current_state.dir\n\n  target_positions = np.argwhere(grid[:, :, index] == 1)\n\n  if len(target_positions) == 0:\n    return []\n\n  # Calculate Manhattan distance to each target position from the current position\n  distances = [abs(pos_x - tx) + abs(pos_y - ty) for tx, ty in target_positions]\n\n  # Find the closest target position\n  min_distance_index = np.argmin(distances)\n  closest_target_pos = tuple(target_positions[min_distance_index])\n\n  def find_path(start, goal):\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]  # RIGHT, DOWN, LEFT, UP\n    queue = collections.deque([start])\n    came_from = {start: None}\n\n    while queue:\n      current = queue.popleft()\n\n      if current == goal:\n        break\n\n      for direction in directions:\n        next_pos = tuple(np.add(current, direction))\n\n        # Check if the next position is within bounds and not blocked\n        if 0 <= next_pos[0] < grid.shape[0] and \\\n           0 <= next_pos[1] < grid.shape[1]:\n          # Ensure no obstacles (except primitive) are blocking the path\n          if np.all(grid[next_pos[0], next_pos[1]] == 0):\n            if next_pos not in came_from:\n              queue.append(next_pos)\n              came_from[next_pos] = current\n\n    # Reconstruct the path from start to goal\n    path = []\n    while current != start:\n      path.append(current)\n      current = came_from[current]\n    path.reverse()\n\n    return path\n\n  def get_direction_to_target(current_dir, dx, dy):\n    if dx == 1:  # Move RIGHT\n      return craft.RIGHT if current_dir != 2 else craft.USE\n    elif dx == -1:  # Move LEFT\n      return craft.LEFT if current_dir != 0 else craft.USE\n    elif dy == 1:  # Move DOWN\n      return craft.DOWN if current_dir != 3 else craft.USE\n    elif dy == -1:  # Move UP\n      return craft.UP if current_dir != 1 else craft.USE\n\n  path = find_path((pos_x, pos_y), closest_target_pos)\n  actions = []\n\n  for i in range(len(path)):\n    current_pos = path[i]\n\n    if i < len(path) - 1:\n      next_pos = path[i + 1]\n      delta_x = next_pos[0] - current_pos[0]\n      delta_y = next_pos[1] - current_pos[1]\n\n      action = get_direction_to_target(dir, delta_x, delta_y)\n    else:\n      # If we are at the target position, use the action to collect the primitive\n      action = craft.USE\n\n    actions.append(action)\n\n    # Update the agent's direction if an actual move was made\n    if i < len(path) - 1 and action in [craft.RIGHT, craft.LEFT, craft.UP, craft.DOWN]:\n      dir = {craft.RIGHT: 2, craft.LEFT: 0, craft.DOWN: 3, craft.UP: 1}[action]\n\n    # Check for obstacles and update path if necessary\n    if i < len(path) - 1:\n      next_pos = path[i + 1]\n      if not np.all(grid[next_pos[0], next_pos[1]] == 0):\n        # Recalculate the path to avoid the obstacle\n        path = find_path(current_pos, closest_target_pos)\n        actions.append(craft.USE)  # Try using any tool that might help\n\n    # Collect primitive if it is reachable and available\n    if i == len(path) - 1:\n      # Check if the primitive is collectible (not blocked by obstacles)\n      if np.all(grid[next_pos[0], next_pos[1]] == 0):\n        actions.append(craft.USE)\n\n  return actions", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-09-26T03:16:10.176860", "function_name": "collect", "function_body": "  def can_use_tool_on_obstacle(tool_index, obstacle_index):\n    tools = {\n        'AXE': {'WOOD'},\n        'HAMMER': {'ROCK'}\n    }\n    for tool_name, usable_primitives in tools.items():\n      if tool_index == env.world.cookbook.index[tool_name]:\n        return any(obstacle_index == env.world.cookbook.index[p] \n                   for p in usable_primitives)\n    return False\n\n  def is_blocked(x, y):\n    blocked = set()\n    for kind_index in env.world.non_grabbable_indices:\n      if env._current_state.grid[x, y, kind_index] > 0:\n        blocked.add(kind_index)\n\n    # Check if any tool can clear the obstacle\n    for kind_index in blocked:\n      if not any(can_use_tool_on_obstacle(tool_index, kind_index) \n                 for tool_index in env._current_state.inventory):\n        return True\n    return False\n\n  # Determine the target primitive index from its name\n  target_primitive_index = env.world.cookbook.index[primitive]\n\n  # Initialize an empty list to store the actions needed\n  actions_to_take = []\n\n  # Current position of the agent\n  current_x, current_y = env._current_state.pos\n\n  # Get the grid dimensions\n  width, height, _ = env._current_state.grid.shape\n\n  # Use BFS to find the shortest path to the target primitive\n  queue = collections.deque([(current_x, current_y, actions_to_take)])\n  visited = set()\n  visited.add((current_x, current_y))\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    # Check if we are next to a cell containing the target primitive\n    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n      nx, ny = x + dx, y + dy\n\n      # Ensure within bounds and not visited\n      if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n        if env._current_state.grid[nx, ny, target_primitive_index] > 0:\n          # Move to the adjacent cell containing the primitive\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          actions_to_take.extend(path + [move_action])\n\n          # Collect the primitive\n          actions_to_take.append(craft.USE)\n          return actions_to_take\n\n        # Mark as visited and add to queue if not blocked\n        if not is_blocked(nx, ny):\n          visited.add((nx, ny))\n          new_path = path.copy()\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          new_path.append(move_action)\n          queue.append((nx, ny, new_path))\n\n        # Check for tools in inventory to use on obstacles\n        elif is_blocked(nx, ny):\n          for tool_index in env._current_state.inventory:\n            if can_use_tool_on_obstacle(tool_index, \n                                       env.world.cookbook.index['WOOD']) or\\\n               can_use_tool_on_obstacle(tool_index, \n                                       env.world.cookbook.index['ROCK']):\n              actions_to_take.append(craft.USE)\n              break\n\n  # If no path is found, return an empty list of actions\n  return []", "island_id": 7, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T03:16:11.305755", "function_name": "collect", "function_body": "  def can_use_tool_on_obstacle(tool_index, obstacle_index):\n    tools = {\n        'AXE': {'WOOD'},\n        'HAMMER': {'ROCK'}\n    }\n    for tool_name, usable_primitives in tools.items():\n      if tool_index == env.world.cookbook.index[tool_name]:\n        return any(obstacle_index == env.world.cookbook.index[p] \n                   for p in usable_primitives)\n    return False\n\n  def is_blocked(x, y):\n    for kind_index in env.world.non_grabbable_indices:\n      if env._current_state.grid[x, y, kind_index] > 0 and\\\n         not any(can_use_tool_on_obstacle(tool_index, kind_index) \n                 for tool_index in env._current_state.inventory):\n        return True\n    return False\n\n  # Determine the target primitive index from its name\n  target_primitive_index = env.world.cookbook.index[primitive]\n\n  # Initialize an empty list to store the actions needed\n  actions_to_take = []\n\n  # Current position of the agent\n  current_x, current_y = env._current_state.pos\n\n  # Get the grid dimensions\n  width, height, _ = env._current_state.grid.shape\n\n  # Use BFS to find the shortest path to the target primitive\n  queue = collections.deque([(current_x, current_y, actions_to_take)])\n  visited = set()\n  visited.add((current_x, current_y))\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    # Check if we are next to a cell containing the target primitive\n    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n      nx, ny = x + dx, y + dy\n\n      # Ensure within bounds and not visited\n      if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n        if env._current_state.grid[nx, ny, target_primitive_index] > 0:\n          # Move to the adjacent cell containing the primitive\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          actions_to_take.extend(path + [move_action])\n\n          # Collect the primitive\n          actions_to_take.append(craft.USE)\n          return actions_to_take\n\n        # Mark as visited and add to queue if not blocked\n        if not is_blocked(nx, ny):\n          visited.add((nx, ny))\n          new_path = path.copy()\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          new_path.append(move_action)\n          queue.append((nx, ny, new_path))\n\n        # Check for tools in inventory to use on obstacles\n        if is_blocked(nx, ny):\n          for tool_index in env._current_state.inventory:\n            if can_use_tool_on_obstacle(tool_index, \n                                       env.world.cookbook.index['WOOD']) or\\\n               can_use_tool_on_obstacle(tool_index, \n                                       env.world.cookbook.index['ROCK']):\n              actions_to_take.append(craft.USE)\n              break\n\n  # If no path is found, return an empty list of actions\n  return []", "island_id": 7, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T03:17:08.022364", "function_name": "collect", "function_body": "  def _find_shortest_path(grid, start_pos, target_kind):\n    width, height = grid.shape[:2]\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n      \n      if grid[x, y].argmax() == target_kind and (x, y) != start_pos:\n        return path\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          if grid[nx, ny].sum() == 1:  # Allow moving through empty cells\n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))\n          elif inventory[grid[nx, ny].argmax()] > 0:  # Allow moving through obstacles if tool is available\n            tool_index = grid[nx, ny].argmax()\n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))  # Use the tool and move\n    \n    return None\n\n  def _get_action_index_from_direction(direction):\n    mapping = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, (0, -1): craft.DOWN, (0, 1): craft.UP}\n    return mapping.get(direction)\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  inventory = current_state.inventory\n  \n  primitive_index = current_state.world.cookbook.index.index(primitive)\n  \n  path_to_primitive = _find_shortest_path(grid, pos, primitive_index)\n  \n  if not path_to_primitive:\n    return []\n  \n  actions = [_get_action_index_from_direction(step) for step in path_to_primitive]\n  actions.append(craft.USE)  # Add action to collect the primitive\n  \n  return actions", "island_id": 8, "scores": {"3": 2.5}}
{"timestamp": "2025-09-26T03:17:09.072742", "function_name": "collect", "function_body": "  def _find_shortest_path(grid, start_pos, target_kind):\n    width, height = grid.shape[:2]\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n      \n      if grid[x, y].argmax() == target_kind and (x, y) != start_pos:\n        return path\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          cell_content = grid[nx, ny].argmax()\n          \n          if cell_content == target_kind:\n            return path + [(dx, dy)]\n          \n          if grid[nx, ny].sum() == 1:  # Allow moving through empty cells\n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))\n          elif inventory[cell_content] > 0:  # Allow moving through obstacles if tool is available\n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))  # Use the tool and move\n    \n    return None\n\n  def _get_action_index_from_direction(direction):\n    mapping = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, (0, -1): craft.DOWN, (0, 1): craft.UP}\n    return mapping.get(direction)\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  inventory = current_state.inventory\n  \n  primitive_index = current_state.world.cookbook.index.index(primitive)\n  \n  path_to_primitive = _find_shortest_path(grid, pos, primitive_index)\n  \n  if not path_to_primitive:\n    return []\n  \n  actions = [_get_action_index_from_direction(step) for step in path_to_primitive]\n  actions.append(craft.USE)  # Add action to collect the primitive\n  \n  return actions", "island_id": 8, "scores": {"3": 2.5}}
{"timestamp": "2025-09-26T03:18:32.252146", "function_name": "collect", "function_body": "  # Define possible movement directions and their corresponding actions.\n  actions = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  # Function to determine the next action based on the current direction.\n  def get_directional_action(direction, target):\n      dx, dy = target[0] - env._current_state.pos[0], target[1] - env._current_state.pos[1]\n      if dx == 1 and direction == \"RIGHT\":\n          return actions[\"USE\"]\n      elif dx == -1 and direction == \"LEFT\":\n          return actions[\"USE\"]\n      elif dy == 1 and direction == \"DOWN\":\n          return actions[\"USE\"]\n      elif dy == -1 and direction == \"UP\":\n          return actions[\"USE\"]\n      else:\n          if dx > 0:\n              return actions[\"RIGHT\"]\n          elif dx < 0:\n              return actions[\"LEFT\"]\n          elif dy > 0:\n              return actions[\"DOWN\"]\n          elif dy < 0:\n              return actions[\"UP\"]\n\n  # Function to check if the target cell is reachable and contains the primitive.\n  def is_valid_target(pos, primitive_index):\n      x, y = pos\n      return (0 <= x < env._current_state.grid.shape[1] and \n              0 <= y < env._current_state.grid.shape[0] and\n              env._current_state.grid[y, x, primitive_index] > 0 and\n              all(env._current_state.grid[y, x, non_grabbable] == 0 for non_grabbable in env._current_state.world.non_grabbable_indices))\n\n  # Helper function to find neighboring positions.\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  # Get the current state of the environment.\n  current_state = env._current_state\n\n  # Define a queue for BFS and a set to track visited positions.\n  queue = collections.deque([(current_state.pos, [], \"UP\")])  # Start with an arbitrary direction\n  visited = set([current_state.pos])\n\n  # Helper function to get the index of a primitive name.\n  def get_primitive_index(primitive_name):\n      return current_state.world.cookbook.index[primitive_name]\n\n  # Get the index for the target primitive.\n  target_primitive_index = get_primitive_index(primitive)\n\n  # Perform BFS to find a path to collect the primitive.\n  while queue:\n      pos, actions_taken, direction = queue.popleft()\n\n      # Check if we are at a cell with the desired primitive.\n      if is_valid_target(pos, target_primitive_index):\n          return actions_taken + [actions[\"USE\"]]\n\n      # Get neighboring positions and filter out invalid ones.\n      neighbors = get_neighbors(pos)\n      for neighbor in neighbors:\n          nx, ny = neighbor\n\n          # Ensure the neighbor is within bounds.\n          if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n              # Check if the cell is not blocked by non-grabbable entities.\n              if all(current_state.grid[ny, nx, env_index] == 0 for env_index in current_state.world.non_grabbable_indices):\n                  # If the cell is visited for the first time, add it to the queue.\n                  if neighbor not in visited:\n                      visited.add(neighbor)\n                      \n                      action = get_directional_action(direction, neighbor)\n                      new_direction = [\"UP\", \"DOWN\", \"LEFT\", \"RIGHT\"][action]\n                      queue.append((neighbor, actions_taken + [action], new_direction))\n\n  # If no path is found to collect the primitive, return an empty list.\n  return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-26T03:18:33.348077", "function_name": "collect", "function_body": "  actions = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  # Helper function to find neighboring positions.\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  # Get the current state of the environment.\n  current_state = env._current_state\n\n  # Define a queue for BFS and a set to track visited positions.\n  queue = collections.deque([(current_state.pos, [], current_state.dir)])\n  visited = set([current_state.pos])\n\n  # Helper function to get the index of a primitive name.\n  def get_primitive_index(primitive_name):\n      return current_state.world.cookbook.index[primitive_name]\n\n  # Get the index for the target primitive.\n  target_primitive_index = get_primitive_index(primitive)\n\n  # Perform BFS to find a path to collect the primitive.\n  while queue:\n      pos, actions_taken, direction = queue.popleft()\n\n      # Check if we are at a cell with the desired primitive.\n      if current_state.grid[pos[0], pos[1], target_primitive_index] > 0:\n          return actions_taken + [actions[\"USE\"]]\n\n      # Get neighboring positions and filter out invalid ones.\n      neighbors = get_neighbors(pos)\n      for neighbor in neighbors:\n          nx, ny = neighbor\n\n          # Ensure the neighbor is within bounds.\n          if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n              # Check if the cell is not blocked by non-grabbable entities.\n              if all(current_state.grid[ny, nx, env_index] == 0 for env_index in current_state.world.non_grabbable_indices):\n                  # If the cell is visited for the first time with this direction, add it to the queue.\n                  if (neighbor, direction) not in visited:\n                      visited.add((neighbor, direction))\n\n                      # Determine the direction to move towards the neighbor.\n                      dx, dy = nx - pos[0], ny - pos[1]\n                      target_direction = None\n                      if dx == 1:\n                          action = actions[\"RIGHT\"]\n                          target_direction = 3\n                      elif dx == -1:\n                          action = actions[\"LEFT\"]\n                          target_direction = 2\n                      elif dy == 1:\n                          action = actions[\"DOWN\"]\n                          target_direction = 0\n                      else:  # dy == -1\n                          action = actions[\"UP\"]\n                          target_direction = 1\n\n                      if direction != target_direction:\n                          # If the current direction is not the target direction, turn first.\n                          queue.append((pos, actions_taken + [action], target_direction))\n                      else:\n                          # Otherwise, move towards the neighbor.\n                          queue.append((neighbor, actions_taken + [action], target_direction))\n\n  # If no path is found to collect the primitive, return an empty list.\n  return []", "island_id": 2, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T03:19:29.416429", "function_name": "collect", "function_body": "  def _find_shortest_path(grid, start_pos, target_kind):\n    width, height = grid.shape[:2]\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n      \n      if grid[x, y].argmax() == target_kind and (x, y) != start_pos:\n        return path\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          cell = grid[nx, ny]\n          # Allow moving through empty cells or obstacles with available tools\n          if cell.sum() == 1 or _can_use_tool(cell, inventory):\n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))\n    \n    return None\n\n  def _get_action_index_from_direction(direction):\n    mapping = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, (0, -1): craft.DOWN, (0, 1): craft.UP}\n    return mapping.get(direction)\n\n  def _can_use_tool(cell, inventory):\n    # Check if any tool in the inventory can be used to navigate this cell\n    for item_index in np.where(cell > 0)[0]:\n      if inventory[item_index] > 0:\n        return True\n    return False\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  inventory = current_state.inventory\n  \n  primitive_index = current_state.world.cookbook.index.index(primitive)\n  \n  path_to_primitive = _find_shortest_path(grid, pos, primitive_index)\n  \n  if not path_to_primitive:\n    return []\n  \n  actions = [_get_action_index_from_direction(step) for step in path_to_primitive]\n  actions.append(craft.USE)  # Add action to collect the primitive\n  \n  return actions", "island_id": 8, "scores": {"3": 2.5}}
{"timestamp": "2025-09-26T03:19:30.527848", "function_name": "collect", "function_body": "  def _find_shortest_path(grid, start_pos, target_kind):\n    width, height = grid.shape[:2]\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n      \n      if grid[x, y].argmax() == target_kind and (x, y) != start_pos:\n        return path\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          if grid[nx, ny].sum() == 1:  # Allow moving through empty cells\n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))\n          else:\n            tool_index = grid[nx, ny].argmax()\n            if inventory[tool_index] > 0 and (nx, ny) not in visited:  # Allow moving through obstacles if tool is available\n              visited.add((nx, ny))\n              queue.append((nx, ny, path + [(dx, dy)]))\n\n    return None\n\n  def _get_action_index_from_direction(direction):\n    mapping = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, (0, -1): craft.DOWN, (0, 1): craft.UP}\n    return mapping.get(direction)\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  inventory = current_state.inventory\n  \n  primitive_index = current_state.world.cookbook.index.index(primitive)\n  \n  path_to_primitive = _find_shortest_path(grid, pos, primitive_index)\n  \n  if not path_to_primitive:\n    return []\n  \n  actions = [_get_action_index_from_direction(step) for step in path_to_primitive]\n  actions.append(craft.USE)  # Add action to collect the primitive\n  \n  return actions", "island_id": 8, "scores": {"3": 2.5}}
