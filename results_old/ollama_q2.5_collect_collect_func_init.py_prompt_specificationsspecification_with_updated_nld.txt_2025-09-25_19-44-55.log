{"timestamp": "2025-09-26T03:20:27.496622", "function_name": "collect", "function_body": "  def _find_shortest_path(grid, start_pos, target_kind):\n    width, height = grid.shape[:2]\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n      \n      if grid[x, y].argmax() == target_kind and (x, y) != start_pos:\n        return path\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          if grid[nx, ny].sum() == 1:  # Allow moving through empty cells\n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))\n          else:\n            tool_index = grid[nx, ny].argmax()\n            if inventory[tool_index] > 0 and (nx, ny) not in visited:  # Allow moving through obstacles if tool is available\n              visited.add((nx, ny))\n              queue.append((nx, ny, path + [(dx, dy)]))\n    \n    return None\n\n  def _get_action_index_from_direction(direction):\n    mapping = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, (0, -1): craft.DOWN, (0, 1): craft.UP}\n    return mapping.get(direction)\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  inventory = current_state.inventory\n  \n  primitive_index = current_state.world.cookbook.index.index(primitive)\n  \n  path_to_primitive = _find_shortest_path(grid, pos, primitive_index)\n  \n  if not path_to_primitive:\n    return []\n  \n  actions = [_get_action_index_from_direction(step) for step in path_to_primitive]\n  actions.append(craft.USE)  # Add action to collect the primitive\n  \n  return actions", "island_id": 8, "scores": {"3": 2.5}}
{"timestamp": "2025-09-26T03:21:46.054301", "function_name": "collect", "function_body": "  def can_use_tool_on_obstacle(tool_index: int, obstacle_index: int):\n    tools = {\n        'AXE': {'WOOD'},\n        'HAMMER': {'ROCK'}\n    }\n    tool_name = env.world.cookbook.get(primitive=tool_index)\n    if tool_name in tools:\n        return any(obstacle_index == env.world.cookbook.index[p] for p in tools[tool_name])\n    return False\n\n  def is_blocked(x: int, y: int) -> bool:\n    for kind_index in env.world.non_grabbable_indices:\n      if env._current_state.grid[x, y, kind_index] > 0:\n        return True\n    return False\n\n  # Determine the target primitive index from its name\n  target_primitive_index = env.world.cookbook.index[primitive]\n\n  # Initialize an empty list to store the actions needed\n  actions_to_take = []\n\n  # Current position of the agent\n  current_x, current_y = env._current_state.pos\n\n  # Get the grid dimensions\n  width, height, _ = env._current_state.grid.shape\n\n  # Use BFS to find the shortest path to the target primitive\n  queue = collections.deque([(current_x, current_y, actions_to_take)])\n  visited = set()\n  visited.add((current_x, current_y))\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    # Check if we are next to a cell containing the target primitive\n    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n      nx, ny = x + dx, y + dy\n\n      # Ensure within bounds and not visited\n      if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n        if env._current_state.grid[nx, ny, target_primitive_index] > 0:\n          # Move to the adjacent cell containing the primitive\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          actions_to_take.extend(path + [move_action])\n\n          # Collect the primitive\n          actions_to_take.append(craft.USE)\n          return actions_to_take\n\n        # Mark as visited and add to queue if not blocked\n        if not is_blocked(nx, ny):\n          visited.add((nx, ny))\n          new_path = path.copy()\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          new_path.append(move_action)\n          queue.append((nx, ny, new_path))\n\n        # Check for tools in inventory to use on obstacles\n        if is_blocked(nx, ny):\n            tool_used = False\n            for tool_index in env._current_state.inventory:\n                for obstacle_index in env.world.non_grabbable_indices:\n                    if can_use_tool_on_obstacle(tool_index, obstacle_index) and\\\n                       env._current_state.grid[nx, ny, obstacle_index] > 0:\n                        actions_to_take.append(craft.USE)\n                        tool_used = True\n                        break\n                if tool_used:\n                    visited.add((nx, ny))\n                    queue.append((nx, ny, path.copy()))\n                    break\n\n  # If no path is found, return an empty list of actions\n  return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-26T03:21:47.114349", "function_name": "collect", "function_body": "  def can_use_tool_on_obstacle(tool_index, obstacle_index):\n    tools = {\n        'AXE': {'WOOD'},\n        'HAMMER': {'ROCK'}\n    }\n    for tool_name, usable_primitives in tools.items():\n      if tool_index == env.world.cookbook.index[tool_name]:\n        return any(obstacle_index == env.world.cookbook.index[p] for p in usable_primitives)\n    return False\n\n  def is_blocked(x: int, y: int) -> bool:\n    for kind_index in env.world.non_grabbable_indices:\n      if env._current_state.grid[x, y, kind_index] > 0:\n        return True\n    return False\n\n  target_primitive_index = env.world.cookbook.index[primitive]\n  actions_to_take = []\n  current_x, current_y = env._current_state.pos\n  width, height, _ = env._current_state.grid.shape\n  queue = collections.deque([(current_x, current_y, actions_to_take)])\n  visited = set()\n  visited.add((current_x, current_y))\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n      nx, ny = x + dx, y + dy\n\n      if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n        if env._current_state.grid[nx, ny, target_primitive_index] > 0:\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          actions_to_take.extend(path + [move_action])\n          actions_to_take.append(craft.USE)\n          return actions_to_take\n\n        if not is_blocked(nx, ny):\n          visited.add((nx, ny))\n          new_path = path.copy()\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          new_path.append(move_action)\n          queue.append((nx, ny, new_path))\n\n        if is_blocked(nx, ny):\n          tool_used = False\n          for tool_index in env._current_state.inventory:\n            for obstacle_index in env.world.non_grabbable_indices:\n              if can_use_tool_on_obstacle(tool_index, obstacle_index) and\\\n                 env._current_state.grid[nx, ny, obstacle_index] > 0:\n                  actions_to_take.append(craft.USE)\n                  tool_used = True\n                  break\n            if tool_used:\n                visited.add((nx, ny))\n                queue.append((nx, ny, path.copy()))\n                break\n\n  return []", "island_id": 7, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T03:22:56.949720", "function_name": "collect", "function_body": "  def get_primitive_index(primitive_name):\n      return env._current_state.world.cookbook.index[primitive_name]\n\n  # Mapping from action names to indices.\n  actions = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  # Current state of the environment.\n  current_state = env._current_state\n\n  # Initialize BFS queue and visited set.\n  queue = collections.deque([(current_state.pos, [])])\n  visited = set([current_state.pos])\n\n  target_primitive_index = get_primitive_index(primitive)\n\n  while queue:\n      pos, actions_taken = queue.popleft()\n\n      if current_state.grid[pos[0], pos[1], target_primitive_index] > 0:\n          return actions_taken + [actions[\"USE\"]]\n\n      neighbors = get_neighbors(pos)\n      for neighbor in neighbors:\n          nx, ny = neighbor\n\n          # Ensure the neighbor is within bounds.\n          if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n              # Check if the cell is not blocked by non-grabbable entities.\n              if all(current_state.grid[ny, nx, env_index] == 0 for env_index in current_state.world.non_grabbable_indices):\n                  if neighbor not in visited:\n                      visited.add(neighbor)\n\n                      dx, dy = nx - pos[0], ny - pos[1]\n                      if dx == 1:\n                          action = actions[\"RIGHT\"]\n                      elif dx == -1:\n                          action = actions[\"LEFT\"]\n                      elif dy == 1:\n                          action = actions[\"DOWN\"]\n                      else:  # dy == -1\n                          action = actions[\"UP\"]\n\n                      queue.append((neighbor, actions_taken + [action]))\n              else:\n                  # Check if any tool in inventory can be used to clear the path.\n                  for tool_index in current_state.world.grabbable_indices:\n                      if current_state.inventory[tool_index] > 0 and current_state.grid[ny, nx, tool_index] > 0:\n                          return actions_taken + [actions[\"USE\"]]\n\n      # Check if there are obstacles that can be cleared with available tools.\n      for tool_index in current_state.world.grabbable_indices:\n          if current_state.inventory[tool_index] > 0 and any(current_state.grid[pos[0], pos[1], env_index] > 0 for env_index in current_state.world.non_grabbable_indices):\n              return actions_taken + [actions[\"USE\"]]\n\n  return []", "island_id": 1, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T03:22:58.050252", "function_name": "collect", "function_body": "  def get_primitive_index(primitive_name):\n      return env._current_state.world.cookbook.index[primitive_name]\n\n  # Mapping from action names to indices.\n  actions = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  # Current state of the environment.\n  current_state = env._current_state\n\n  # Initialize BFS queue and visited set.\n  queue = collections.deque([(current_state.pos, [])])\n  visited = set([current_state.pos])\n\n  target_primitive_index = get_primitive_index(primitive)\n\n  while queue:\n      pos, actions_taken = queue.popleft()\n\n      if current_state.grid[pos[0], pos[1], target_primitive_index] > 0:\n          return actions_taken + [actions[\"USE\"]]\n\n      neighbors = get_neighbors(pos)\n      for neighbor in neighbors:\n          nx, ny = neighbor\n\n          # Ensure the neighbor is within bounds.\n          if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n              # Check if the cell is not blocked by non-grabbable entities or can be cleared with tools.\n              if all(current_state.grid[ny, nx, env_index] == 0 for env_index in current_state.world.non_grabbable_indices):\n                  if neighbor not in visited:\n                      visited.add(neighbor)\n\n                      dx, dy = nx - pos[0], ny - pos[1]\n                      if dx == 1:\n                          action = actions[\"RIGHT\"]\n                      elif dx == -1:\n                          action = actions[\"LEFT\"]\n                      elif dy == 1:\n                          action = actions[\"DOWN\"]\n                      else:  # dy == -1\n                          action = actions[\"UP\"]\n\n                      queue.append((neighbor, actions_taken + [action]))\n              else:\n                  # Check if any tool in inventory can be used to clear the path.\n                  for tool_index in current_state.world.grabbable_indices:\n                      if current_state.inventory[tool_index] > 0 and current_state.grid[ny, nx, tool_index] > 0:\n                          return actions_taken + [actions[\"USE\"]]\n\n      # Check if there are obstacles that can be cleared with available tools.\n      for tool_index in current_state.world.grabbable_indices:\n          if current_state.inventory[tool_index] > 0 and any(current_state.grid[pos[0], pos[1], env_index] > 0 for env_index in current_state.world.non_grabbable_indices):\n              return actions_taken + [actions[\"USE\"]]\n\n  return []", "island_id": 1, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T03:24:22.541860", "function_name": "collect", "function_body": "  def get_primitive_index(primitive_name):\n      try:\n          return env.world.cookbook.index[primitive_name]\n      except KeyError:\n          raise ValueError(f\"Primitive {primitive_name} not found in cookbook.\")\n\n  def is_blocked(x, y):\n    for kind_index in env.world.non_grabbable_indices:\n      if env._current_state.grid[x, y, kind_index] > 0 and kind_index != env.world.cookbook.index['WORKSHOP0'] and kind_index != env.world.cookbook.index['WORKSHOP1'] and kind_index != env.world.cookbook.index['WORKSHOP2']:\n        return True\n    return False\n\n  def find_path(start_x, start_y, target_x, target_y):\n      \"\"\"Finds the shortest path from (start_x, start_y) to (target_x, target_y) using BFS.\"\"\"\n      queue = collections.deque([(start_x, start_y, [])])\n      visited = set()\n      visited.add((start_x, start_y))\n      \n      while queue:\n          x, y, path = queue.popleft()\n          \n          if (x, y) == (target_x, target_y):\n              return path\n          \n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              \n              if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited and not is_blocked(nx, ny):\n                  new_path = path.copy()\n                  move_action = {\n                      (-1, 0): craft.LEFT,\n                      (1, 0): craft.RIGHT,\n                      (0, -1): craft.DOWN,\n                      (0, 1): craft.UP\n                  }[(dx, dy)]\n                  new_path.append(move_action)\n                  queue.append((nx, ny, new_path))\n                  visited.add((nx, ny))\n      \n      return None\n\n  # Determine the target primitive index from its name\n  target_primitive_index = get_primitive_index(primitive)\n\n  # Initialize an empty list to store the actions needed\n  actions_to_take = []\n\n  # Current position of the agent\n  current_x, current_y = env._current_state.pos\n\n  # Get the grid dimensions\n  width, height, _ = env._current_state.grid.shape\n\n  # Find all positions of the target primitive in the environment\n  target_positions = []\n  for x in range(width):\n      for y in range(height):\n          if env._current_state.grid[x, y, target_primitive_index] > 0:\n              target_positions.append((x, y))\n\n  # If no target primitives are found, return an empty list of actions\n  if not target_positions:\n      return []\n\n  # Find the shortest path to the nearest target primitive\n  for target_x, target_y in target_positions:\n      path = find_path(current_x, current_y, target_x, target_y)\n      \n      if path is not None:\n          actions_to_take.extend(path)\n\n          # Collect the primitive\n          actions_to_take.append(craft.USE)\n          return actions_to_take\n\n  # If no path to any target primitives is found, return an empty list of actions\n  return []", "island_id": 6, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T03:24:23.600925", "function_name": "collect", "function_body": "  def get_primitive_index(primitive_name):\n    try:\n      return env.world.cookbook.index[primitive_name]\n    except KeyError:\n      raise ValueError(f\"Primitive {primitive_name} not found in cookbook.\")\n\n  def is_blocked(x, y):\n    for kind_index in env.world.non_grabbable_indices:\n      if env._current_state.grid[x, y, kind_index] > 0 and kind_index != env.world.cookbook.index['WORKSHOP0'] and kind_index != env.world.cookbook.index['WORKSHOP1'] and kind_index != env.world.cookbook.index['WORKSHOP2']:\n        return True\n    return False\n\n  # Determine the target primitive index from its name\n  target_primitive_index = get_primitive_index(primitive)\n\n  # Initialize an empty list to store the actions needed\n  actions_to_take = []\n\n  # Current position of the agent\n  current_x, current_y = env._current_state.pos\n\n  # Get the grid dimensions\n  width, height, _ = env._current_state.grid.shape\n\n  # Use BFS to find the shortest path to the target primitive\n  queue = collections.deque([(current_x, current_y, actions_to_take)])\n  visited = set()\n  visited.add((current_x, current_y))\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    # Check if we are next to a cell containing the target primitive\n    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n      nx, ny = x + dx, y + dy\n\n      # Ensure within bounds and not visited\n      if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n        if env._current_state.grid[nx, ny, target_primitive_index] > 0:\n          # Determine the direction to move towards the primitive\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n\n          # Plan the sequence of actions to reach and collect the primitive\n          path_to_primitive = path + [move_action]\n\n          # Check if the agent can use a tool in its inventory to clear obstacles\n          for tool_name in env._current_state.inventory:\n              tool_index = get_primitive_index(tool_name)\n              if tool_index in env.world.cookbook.primitives and tool_name not in ['BOUNDARY', 'WORKSHOP0', 'WORKSHOP1', 'WORKSHOP2']:\n                  # Determine the action to use the tool\n                  use_tool_action = craft.USE\n\n                  # Plan the sequence of actions to reach, use the tool, and collect the primitive\n                  path_with_tool = path_to_primitive + [use_tool_action] + [move_action]\n\n                  # Check if using the tool clears any blocks in the way\n                  if not is_blocked(nx, ny):\n                      actions_to_take = path_with_tool\n                      return actions_to_take\n\n          # If no tool is needed or available, move directly to collect the primitive\n          actions_to_take = path_to_primitive + [craft.USE]\n          return actions_to_take\n\n        # Mark as visited and add to queue if not blocked\n        if not is_blocked(nx, ny):\n          visited.add((nx, ny))\n          new_path = path.copy()\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          new_path.append(move_action)\n          queue.append((nx, ny, new_path))\n\n  # If no path is found, return an empty list of actions\n  return []", "island_id": 6, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T03:25:39.591405", "function_name": "collect", "function_body": "  def get_primitive_index(primitive_name):\n      try:\n          return env.world.cookbook.index[primitive_name]\n      except KeyError:\n          raise ValueError(f\"Primitive {primitive_name} not found in cookbook.\")\n\n  def is_blocked(x, y):\n    for kind_index in env.world.non_grabbable_indices:\n      if env._current_state.grid[x, y, kind_index] > 0:\n        return True\n    return False\n\n  # Determine the target primitive index from its name\n  target_primitive_index = get_primitive_index(primitive)\n\n  # Initialize an empty list to store the actions needed\n  actions_to_take = []\n\n  # Current position of the agent\n  current_x, current_y = env._current_state.pos\n\n  # Get the grid dimensions\n  width, height, _ = env._current_state.grid.shape\n\n  # Use BFS to find the shortest path to the target primitive\n  queue = collections.deque([(current_x, current_y, actions_to_take)])\n  visited = set()\n  visited.add((current_x, current_y))\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    # Check if we are next to a cell containing the target primitive\n    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n      nx, ny = x + dx, y + dy\n\n      # Ensure within bounds and not visited\n      if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n        if env._current_state.grid[nx, ny, target_primitive_index] > 0:\n          # Move to the adjacent cell containing the primitive\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          actions_to_take.extend(path + [move_action])\n\n          # Collect the primitive\n          actions_to_take.append(craft.USE)\n          return actions_to_take\n\n        # Mark as visited and add to queue if not blocked\n        if not is_blocked(nx, ny):\n          visited.add((nx, ny))\n          new_path = path.copy()\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          new_path.append(move_action)\n          queue.append((nx, ny, new_path))\n\n    # Check if the current cell contains a tool that can be used to clear an obstacle\n    for kind_index in env.world.grabbable_indices:\n      if env._current_state.grid[x, y, kind_index] > 0 and kind_index in env._current_state.inventory:\n        # Use the tool to clear obstacles around the agent\n        actions_to_take.extend(path + [craft.USE])\n        return actions_to_take\n\n  # If no path is found, return an empty list of actions\n  return []", "island_id": 6, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T03:25:40.632044", "function_name": "collect", "function_body": "  def get_primitive_index(primitive_name):\n      try:\n          return env.world.cookbook.index[primitive_name]\n      except KeyError:\n          raise ValueError(f\"Primitive {primitive_name} not found in cookbook.\")\n\n  def is_blocked(x, y):\n    for kind_index in env.world.non_grabbable_indices:\n      if env._current_state.grid[x, y, kind_index] > 0:\n        return True\n    return False\n\n  # Determine the target primitive index from its name\n  target_primitive_index = get_primitive_index(primitive)\n\n  # Initialize an empty list to store the actions needed\n  actions_to_take = []\n\n  # Current position of the agent\n  current_x, current_y = env._current_state.pos\n\n  # Get the grid dimensions\n  width, height, _ = env._current_state.grid.shape\n\n  # Use BFS to find the shortest path to the target primitive\n  queue = collections.deque([(current_x, current_y, actions_to_take)])\n  visited = set()\n  visited.add((current_x, current_y))\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    # Check if we are next to a cell containing the target primitive\n    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n      nx, ny = x + dx, y + dy\n\n      # Ensure within bounds and not visited\n      if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n        if env._current_state.grid[nx, ny, target_primitive_index] > 0:\n          # Move to the adjacent cell containing the primitive\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          actions_to_take.extend(path + [move_action])\n\n          # Check if the path is blocked by obstacles that require tools\n          tool_needed = False\n          for ddx, ddy in [(0, -1), (0, 1)]:\n            mx, my = nx + ddx, ny + ddy\n            if 0 <= mx < width and 0 <= my < height and is_blocked(mx, my):\n              tool_needed = True\n\n          # If no tools are needed to clear the path, collect the primitive\n          if not tool_needed:\n            actions_to_take.append(craft.USE)\n            return actions_to_take\n\n        # Mark as visited and add to queue if not blocked\n        if not is_blocked(nx, ny):\n          visited.add((nx, ny))\n          new_path = path.copy()\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          new_path.append(move_action)\n          queue.append((nx, ny, new_path))\n\n  # If no path is found, return an empty list of actions\n  return []", "island_id": 6, "scores": {"3": 3.0}}
{"timestamp": "2025-09-26T03:26:50.566971", "function_name": "collect", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Get the index of the target primitive\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Helper function to check if a cell is blocked by obstacles or other items, except for the target primitive itself\n  def is_blocked(x, y):\n    return any(env._current_state.grid[x, y][idx] > 0 and idx != primitive_index for idx in range(len(env.world.cookbook.index)))\n\n  # Directions and their corresponding actions\n  directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n  actions = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, \n             (0, -1): craft.DOWN, (0, 1): craft.UP}\n\n  # BFS to find the shortest path to a cell containing the primitive\n  start_x, start_y = env._current_state.pos\n  visited = set()\n  queue = deque([(start_x, start_y, [])])  # (x, y, path)\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    if (x, y) in visited:\n      continue\n\n    visited.add((x, y))\n\n    for dx, dy in directions:\n      nx, ny = x + dx, y + dy\n\n      # Check bounds\n      if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n        # If the cell contains the primitive, return the path to it\n        if env._current_state.grid[nx, ny][primitive_index] > 0:\n          move_action = actions[(dx, dy)]\n          use_action = craft.USE\n          return path + [move_action, use_action]\n\n        # If the cell is not blocked and hasn't been visited, add to queue\n        if not is_blocked(nx, ny):\n          move_action = actions[(dx, dy)]\n          queue.append((nx, ny, path + [move_action]))\n\n  # Try using available tools in inventory to clear obstacles\n  for tool_index in range(env._current_state.inventory.shape[0]):\n    if env._current_state.inventory[tool_index] > 0:\n      # Check if the tool can be used at the current position\n      if not is_blocked(start_x, start_y):\n        use_tool = craft.USE\n        return [use_tool]\n  \n  return []  # Return an empty list if no path found and no tools to clear obstacles", "island_id": 4, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T03:26:51.582870", "function_name": "collect", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Get the index of the target primitive\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Helper function to check if a cell is blocked by obstacles or other items, except for the target primitive itself\n  def is_blocked(x, y):\n    return any(env._current_state.grid[x, y][idx] > 0 for idx in range(len(env.world.cookbook.index)) if idx != primitive_index)\n\n  # Directions and their corresponding actions\n  directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n  actions = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, \n             (0, -1): craft.DOWN, (0, 1): craft.UP}\n\n  # BFS to find the shortest path to a cell containing the primitive\n  start_x, start_y = env._current_state.pos\n  visited = set()\n  queue = deque([(start_x, start_y, [])])  # (x, y, path)\n  \n  while queue:\n    x, y, path = queue.popleft()\n    \n    if (x, y) in visited:\n      continue\n    \n    visited.add((x, y))\n    \n    for dx, dy in directions:\n      nx, ny = x + dx, y + dy\n      \n      # Check bounds\n      if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n        # If the cell contains the primitive, return the path to it\n        if env._current_state.grid[nx, ny][primitive_index] > 0:\n          move_action = actions[(dx, dy)]\n          use_action = craft.USE\n          return path + [move_action, use_action]\n        \n        # If the cell is not blocked and hasn't been visited, add to queue\n        if not is_blocked(nx, ny):\n          move_action = actions[(dx, dy)]\n          queue.append((nx, ny, path + [move_action]))\n  \n  # Try using available tools in inventory to clear obstacles\n  for tool_index in range(env._current_state.inventory.shape[0]):\n    if env._current_state.inventory[tool_index] > 0:\n      # Use the tool\n      use_tool = craft.USE\n      return [use_tool]\n    \n    # If no specific cell is found, check if using the tool can clear an obstacle path to the target primitive\n    for dx, dy in directions:\n      nx, ny = start_x + dx, start_y + dy\n      \n      # Check bounds\n      if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n        # If the cell is blocked, attempt to use a tool to clear it\n        if is_blocked(nx, ny):\n          move_action = actions[(dx, dy)]\n          return [move_action, use_tool]\n\n  return []  # Return an empty list if no path found and no tools can clear obstacles", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-26T03:28:08.982119", "function_name": "collect", "function_body": "  def is_blocked(x, y):\n    for kind_index in env.world.non_grabbable_indices:\n      if env._current_state.grid[x, y, kind_index] > 0 and kind_index not in env._current_state.inventory:\n        return True\n    return False\n\n  # Determine the target primitive index from its name\n  target_primitive_index = env.world.cookbook.index[primitive]\n\n  # Initialize an empty list to store the actions needed\n  actions_to_take = []\n\n  # Current position of the agent\n  current_x, current_y = env._current_state.pos\n\n  # Get the grid dimensions\n  width, height, _ = env._current_state.grid.shape\n\n  # Use BFS to find the shortest path to the target primitive\n  queue = collections.deque([(current_x, current_y, actions_to_take)])\n  visited = set()\n  visited.add((current_x, current_y))\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    # Check if we are next to a cell containing the target primitive\n    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n      nx, ny = x + dx, y + dy\n\n      # Ensure within bounds and not visited\n      if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n        if env._current_state.grid[nx, ny, target_primitive_index] > 0:\n          # Move to the adjacent cell containing the primitive\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          actions_to_take.extend(path + [move_action])\n\n          # Collect the primitive\n          actions_to_take.append(craft.USE)\n          return actions_to_take\n\n        # Check if there's a tool in the inventory that can be used to clear obstacles\n        for tool_index in env._current_state.inventory:\n          if env.world.cookbook.primitives[tool_index].can_use_on(kind_index):\n            move_action = {\n                (-1, 0): craft.LEFT,\n                (1, 0): craft.RIGHT,\n                (0, -1): craft.DOWN,\n                (0, 1): craft.UP\n            }[(dx, dy)]\n            actions_to_take.extend(path + [move_action])\n            actions_to_take.append(tool_index)  # Use the tool on the obstacle\n            visited.add((nx, ny))\n            queue.append((nx, ny, actions_to_take))\n\n        # Mark as visited and add to queue if not blocked\n        if not is_blocked(nx, ny):\n          visited.add((nx, ny))\n          new_path = path.copy()\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          new_path.append(move_action)\n          queue.append((nx, ny, new_path))\n\n  # If no path is found, return an empty list of actions\n  return []", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-26T03:28:10.015673", "function_name": "collect", "function_body": "  def is_blocked(x, y):\n    for kind_index in env.world.non_grabbable_indices:\n      if env._current_state.grid[x, y, kind_index] > 0 and kind_index not in env._current_state.inventory:\n        # Check if the blocking object can be used as a tool\n        blocking_object = env.world.cookbook.index.get(env.world.cookbook.reverse_index[kind_index], None)\n        if blocking_object is None or blocking_object not in env._current_state.inventory:\n          return True\n    return False\n\n  def use_tool(tool):\n      actions_to_take.append(craft.USE)  # Assume USE action uses the tool appropriately\n\n  # Determine the target primitive index from its name\n  target_primitive_index = env.world.cookbook.index[primitive]\n\n  # Initialize an empty list to store the actions needed\n  actions_to_take = []\n\n  # Current position of the agent\n  current_x, current_y = env._current_state.pos\n\n  # Get the grid dimensions\n  width, height, _ = env._current_state.grid.shape\n\n  # Use BFS to find the shortest path to the target primitive\n  queue = collections.deque([(current_x, current_y, actions_to_take)])\n  visited = set()\n  visited.add((current_x, current_y))\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    # Check if we are next to a cell containing the target primitive\n    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n      nx, ny = x + dx, y + dy\n\n      # Ensure within bounds and not visited\n      if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n        if env._current_state.grid[nx, ny, target_primitive_index] > 0:\n          # Move to the adjacent cell containing the primitive\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          actions_to_take.extend(path + [move_action])\n\n          # Collect the primitive\n          actions_to_take.append(craft.USE)\n          return actions_to_take\n\n        # Mark as visited and add to queue if not blocked\n        if not is_blocked(nx, ny):\n          visited.add((nx, ny))\n          new_path = path.copy()\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          new_path.append(move_action)\n          queue.append((nx, ny, new_path))\n\n        # If blocked, check if a tool is available to clear the blockage\n        else:\n          for tool in env._current_state.inventory:\n            use_tool(tool)  # Attempt to use each tool in inventory\n\n  # If no path is found, return an empty list of actions\n  return []", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-26T03:29:01.853338", "function_name": "collect", "function_body": "  def _find_shortest_path(grid, start_pos, target_kind):\n    width, height = grid.shape[:2]\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n      \n      if grid[x, y].argmax() == target_kind and (x, y) != start_pos:\n        return path\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          cell_content = grid[nx, ny].argmax()\n          # Allow movement on clear cells or through tools that are available in the inventory\n          if grid[nx, ny].sum() == 1 or inventory[cell_content] > 0: \n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))\n    \n    return None\n\n  def _get_action_index_from_direction(direction):\n    mapping = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, (0, -1): craft.DOWN, (0, 1): craft.UP}\n    return mapping.get(direction)\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  inventory = current_state.inventory\n  \n  primitive_index = current_state.world.cookbook.index.index(primitive)\n  \n  path_to_primitive = _find_shortest_path(grid, pos, primitive_index)\n  \n  if not path_to_primitive:\n    return []\n  \n  actions = [_get_action_index_from_direction(step) for step in path_to_primitive]\n  actions.append(craft.USE)  # Add action to collect the primitive\n  \n  return actions", "island_id": 9, "scores": {"3": 2.5}}
{"timestamp": "2025-09-26T03:29:02.921419", "function_name": "collect", "function_body": "  def _find_shortest_path(grid, start_pos, target_kind):\n    width, height = grid.shape[:2]\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n      \n      if grid[x, y].argmax() == target_kind and (x, y) != start_pos:\n        return path\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          cell_content = grid[nx, ny].argmax()\n          # Allow movement on clear cells or through tools that are available in the inventory\n          if grid[nx, ny].sum() == 1 or inventory[cell_content] > 0: \n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))\n    \n    return None\n\n  def _get_action_index_from_direction(direction):\n    mapping = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, (0, -1): craft.DOWN, (0, 1): craft.UP}\n    return mapping.get(direction)\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  inventory = current_state.inventory\n  \n  primitive_index = current_state.world.cookbook.index.index(primitive)\n  \n  path_to_primitive = _find_shortest_path(grid, pos, primitive_index)\n  \n  if not path_to_primitive:\n    return []\n  \n  actions = [_get_action_index_from_direction(step) for step in path_to_primitive]\n  actions.append(craft.USE)  # Add action to collect the primitive\n  \n  return actions", "island_id": 9, "scores": {"3": 2.5}}
{"timestamp": "2025-09-26T03:29:55.030931", "function_name": "collect", "function_body": "  def _find_shortest_path(grid, start_pos, target_kind):\n    width, height = grid.shape[:2]\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n      \n      if grid[x, y].argmax() == target_kind and (x, y) != start_pos:\n        return path\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          cell_content_index = grid[nx, ny].argmax()\n          # Allow movement on clear cells or through tools that are available in the inventory\n          if grid[nx, ny].sum() == 1 or inventory[cell_content_index] > 0:  \n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))\n    \n    return None\n\n  def _get_action_index_from_direction(direction):\n    mapping = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, (0, -1): craft.DOWN, (0, 1): craft.UP}\n    return mapping.get(direction)\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  inventory = current_state.inventory\n  \n  primitive_index = current_state.world.cookbook.index.index(primitive)\n  \n  path_to_primitive = _find_shortest_path(grid, pos, primitive_index)\n  \n  if not path_to_primitive:\n    return []\n  \n  actions = [_get_action_index_from_direction(step) for step in path_to_primitive]\n  actions.append(craft.USE)  # Add action to collect the primitive\n  \n  return actions", "island_id": 9, "scores": {"3": 2.5}}
{"timestamp": "2025-09-26T03:29:56.139792", "function_name": "collect", "function_body": "  def _find_shortest_path(grid, start_pos, target_kind, inventory):\n    width, height = grid.shape[:2]\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n      \n      if grid[x, y].argmax() == target_kind and (x, y) != start_pos:\n        return path\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          cell_content_index = grid[nx, ny].argmax()\n          # Allow movement on clear cells or through tools that are available in the inventory\n          if grid[nx, ny].sum() == 1 or inventory[cell_content_index] > 0:  \n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))\n    \n    return None\n\n  def _get_action_index_from_direction(direction):\n    mapping = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, (0, -1): craft.DOWN, (0, 1): craft.UP}\n    return mapping.get(direction)\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  inventory = current_state.inventory\n  \n  primitive_index = current_state.world.cookbook.index.index(primitive)\n  \n  path_to_primitive = _find_shortest_path(grid, pos, primitive_index, inventory)\n  \n  if not path_to_primitive:\n    return []\n  \n  actions = [_get_action_index_from_direction(step) for step in path_to_primitive]\n  actions.append(craft.USE)  # Add action to collect the primitive\n  \n  return actions", "island_id": 9, "scores": {"3": 2.5}}
{"timestamp": "2025-09-26T03:30:51.979011", "function_name": "collect", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Get the index of the target primitive and the agent's current position\n  primitive_index = env.world.cookbook.index[primitive]\n  start_x, start_y = env._current_state.pos\n\n  # Directions and their corresponding actions\n  directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n  action_map = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, \n                (0, -1): craft.DOWN, (0, 1): craft.UP}\n\n  # Helper function to check if a cell is blocked by obstacles other than the primitive itself\n  def is_blocked(x, y):\n    return any(env._current_state.grid[x, y] > 0) and env._current_state.grid[x, y][primitive_index] == 0\n\n  # BFS to find the shortest path to a cell containing the primitive\n  visited = set()\n  queue = deque([(start_x, start_y, [])])  # (x, y, path)\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    if (x, y) in visited:\n      continue\n\n    visited.add((x, y))\n\n    for dx, dy in directions:\n      nx, ny = x + dx, y + dy\n      \n      # Check bounds\n      if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n        # If the cell contains the primitive, return the path to it\n        if env._current_state.grid[nx, ny][primitive_index] > 0:\n          move_action = action_map[(dx, dy)]\n          use_action = craft.USE\n          return path + [move_action, use_action]\n        \n        # If the cell is not blocked and hasn't been visited, add to queue\n        if not is_blocked(nx, ny):\n          move_action = action_map[(dx, dy)]\n          queue.append((nx, ny, path + [move_action]))\n\n  return []  # Return an empty list if no path found", "island_id": 4, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T03:30:53.029741", "function_name": "collect", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Get the index of the target primitive and the agent's current position\n  primitive_index = env.world.cookbook.index[primitive]\n  start_x, start_y = env._current_state.pos\n\n  # Directions and their corresponding actions\n  directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n  action_map = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, \n                (0, -1): craft.DOWN, (0, 1): craft.UP}\n\n  # Helper function to check if a cell is blocked by obstacles other than the primitive itself\n  def is_blocked(x, y):\n    return any(env._current_state.grid[x, y] > 0) and env._current_state.grid[x, y][primitive_index] == 0\n\n  # BFS to find the shortest path to a cell containing the primitive\n  visited = set()\n  queue = deque([(start_x, start_y, [])])  # (x, y, path)\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    if (x, y) in visited:\n      continue\n\n    visited.add((x, y))\n\n    for dx, dy in directions:\n      nx, ny = x + dx, y + dy\n      \n      # Check bounds\n      if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n        # If the cell contains the primitive, return the path to it\n        if env._current_state.grid[nx, ny][primitive_index] > 0:\n          move_action = action_map[(dx, dy)]\n          use_action = craft.USE\n          return path + [move_action, use_action]\n        \n        # If the cell is not blocked and hasn't been visited, add to queue\n        if not is_blocked(nx, ny):\n          move_action = action_map[(dx, dy)]\n          queue.append((nx, ny, path + [move_action]))\n\n  return []  # Return an empty list if no path found", "island_id": 4, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T03:32:17.249484", "function_name": "collect", "function_body": "  index = env.world.cookbook.index[primitive]\n  \n  # Get current position and direction of the agent\n  pos_x, pos_y = env._current_state.pos\n  dir = env._current_state.dir\n  \n  # Find all positions in the grid that contain the desired primitive\n  target_positions = np.argwhere(env._current_state.grid[:, :, index] == 1)\n\n  if len(target_positions) == 0:\n    return []  # No targets found, no actions to take\n\n  def find_path(start, goal):\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]  # RIGHT, DOWN, LEFT, UP\n    queue = collections.deque([start])\n    came_from = {start: None}\n    \n    while queue:\n      current = queue.popleft()\n      \n      if current == goal:\n        break\n      \n      for direction in directions:\n        next_pos = tuple(np.add(current, direction))\n        \n        # Check if the next position is within bounds and not blocked\n        if 0 <= next_pos[0] < env._current_state.grid.shape[0] and\\\n           0 <= next_pos[1] < env._current_state.grid.shape[1]:\n          if np.all(env._current_state.grid[next_pos[0], next_pos[1]] == 0):\n            if next_pos not in came_from:\n              queue.append(next_pos)\n              came_from[next_pos] = current\n    \n    # Reconstruct the path from start to goal\n    path = []\n    while current != start:\n      path.append(current)\n      current = came_from[current]\n    path.reverse()\n    \n    return path\n\n  def get_direction_to_target(current_dir, dx, dy):\n    if dx == 1:  # Move RIGHT\n      return craft.RIGHT if current_dir != 2 else craft.USE\n    elif dx == -1:  # Move LEFT\n      return craft.LEFT if current_dir != 0 else craft.USE\n    elif dy == 1:  # Move DOWN\n      return craft.DOWN if current_dir != 3 else craft.USE\n    elif dy == -1:  # Move UP\n      return craft.UP if current_dir != 1 else craft.USE\n\n  # Calculate Manhattan distances from the agent's position to each target\n  closest_target_pos = min(target_positions, key=lambda pos: abs(pos_x - pos[0]) + abs(pos_y - pos[1]))\n  \n  path = find_path((pos_x, pos_y), tuple(closest_target_pos))\n  actions = []\n\n  for i in range(len(path)):\n    current_pos = path[i]\n    \n    if i > 0:\n        previous_pos = path[i-1]\n        delta_x = current_pos[0] - previous_pos[0]\n        delta_y = current_pos[1] - previous_pos[1]\n        \n        action = get_direction_to_target(dir, delta_x, delta_y)\n        actions.append(action)\n\n    # Update the agent's direction\n    if i > 0:\n        action = actions[-1]\n        if action in [craft.RIGHT, craft.LEFT, craft.UP, craft.DOWN]:\n            dir = {craft.RIGHT: 2, craft.LEFT: 0, craft.DOWN: 3, craft.UP: 1}[action]\n\n    # If we are at the target position, use the action to collect the primitive\n    if i == len(path) - 1:\n        actions.append(craft.USE)\n\n  return actions", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-09-26T03:32:18.331951", "function_name": "collect", "function_body": "  # Get the index for the desired primitive\n  index = env.world.cookbook.index[primitive]\n\n  # Get the current position and direction of the agent\n  pos_x, pos_y = env._current_state.pos\n  dir = env._current_state.dir\n\n  # Find all positions in the grid that contain the desired primitive\n  target_positions = np.argwhere(env._current_state.grid[:, :, index] == 1)\n\n  if len(target_positions) == 0:\n    return []  # No targets found, no actions to take\n\n  # Calculate Manhattan distances from the agent's position to each target\n  closest_target_pos = min(\n      ((abs(pos_x - tx) + abs(pos_y - ty), (tx, ty)) for tx, ty in target_positions),\n      key=lambda x: x[0]\n  )[1]\n\n  def find_path(start, goal):\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]  # RIGHT, DOWN, LEFT, UP\n    queue = collections.deque([start])\n    came_from = {start: None}\n    \n    while queue:\n      current = queue.popleft()\n      \n      if current == goal:\n        break\n      \n      for direction in directions:\n        next_pos = tuple(np.add(current, direction))\n        \n        # Check if the next position is within bounds and not blocked\n        if 0 <= next_pos[0] < env._current_state.grid.shape[0] and\\\n           0 <= next_pos[1] < env._current_state.grid.shape[1]:\n          if np.all(env._current_state.grid[next_pos[0], next_pos[1]] == 0):\n            if next_pos not in came_from:\n              queue.append(next_pos)\n              came_from[next_pos] = current\n    \n    # Reconstruct the path from start to goal\n    path = []\n    while current != start:\n      path.append(current)\n      current = came_from[current]\n    path.reverse()\n    \n    return path\n\n  def get_direction_to_target(current_dir, dx, dy):\n    if dx == 1:  # Move RIGHT\n      return craft.RIGHT if current_dir != 2 else craft.USE\n    elif dx == -1:  # Move LEFT\n      return craft.LEFT if current_dir != 0 else craft.USE\n    elif dy == 1:  # Move DOWN\n      return craft.DOWN if current_dir != 3 else craft.USE\n    elif dy == -1:  # Move UP\n      return craft.UP if current_dir != 1 else craft.USE\n\n  path = find_path((pos_x, pos_y), closest_target_pos)\n  actions = []\n\n  for i in range(len(path)):\n    current_pos = path[i]\n    \n    if i > 0:\n        previous_pos = path[i-1]\n        delta_x = current_pos[0] - previous_pos[0]\n        delta_y = current_pos[1] - previous_pos[1]\n        \n        action = get_direction_to_target(dir, delta_x, delta_y)\n        actions.append(action)\n\n    # Update the agent's direction\n    if i > 0:\n        action = actions[-1]\n        if action in [craft.RIGHT, craft.LEFT, craft.UP, craft.DOWN]:\n            dir = {craft.RIGHT: 2, craft.LEFT: 0, craft.DOWN: 3, craft.UP: 1}[action]\n\n    # If we are at the target position, use the action to collect the primitive\n    if i == len(path) - 1:\n        actions.append(craft.USE)\n\n  return actions", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-09-26T03:33:52.613521", "function_name": "collect", "function_body": "  action_map = {\n      \"RIGHT\": craft.RIGHT,\n      \"LEFT\": craft.LEFT,\n      \"DOWN\": craft.DOWN,\n      \"UP\": craft.UP,\n      \"USE\": craft.USE\n  }\n\n  # Get the index of the primitive from the cookbook index\n  target_index = env.world.cookbook.index[primitive]\n\n  # Current state grid and agent's position/direction\n  grid = env._current_state.grid\n  pos_x, pos_y = env._current_state.pos\n  dir = env._current_state.dir\n\n  # Find all positions containing the primitive in the environment\n  target_positions = np.argwhere(grid[:, :, target_index] == 1)\n\n  if not target_positions.size:\n    return []\n\n  def manhattan_distance(p1, p2):\n      \"\"\"Calculate the Manhattan distance between two points.\"\"\"\n      return abs(p1[0] - p2[0]) + abs(p1[1] - p2[1])\n\n  # Find the closest primitive using the Manhattan distance\n  closest_target = min(target_positions, key=lambda pos: manhattan_distance((pos_x, pos_y), tuple(pos)))\n\n  def bfs(start, goal):\n      \"\"\"Find a path from start to goal using BFS.\"\"\"\n      directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]  # RIGHT, DOWN, LEFT, UP\n      queue = collections.deque([start])\n      came_from = {start: None}\n\n      while queue:\n          current = queue.popleft()\n          if current == goal:\n              break\n\n          for direction in directions:\n              next_pos = tuple(np.add(current, direction))\n              # Ensure the position is within grid bounds and not blocked by any primitive\n              if 0 <= next_pos[0] < grid.shape[0] and\\\n                 0 <= next_pos[1] < grid.shape[1]:\n                  if np.all(grid[next_pos[0], next_pos[1]] == 0):\n                      if next_pos not in came_from:\n                          queue.append(next_pos)\n                          came_from[next_pos] = current\n\n      # Reconstruct the path from start to goal\n      path = []\n      while current != start:\n          path.append(current)\n          current = came_from[current]\n      path.reverse()\n      return path\n\n  def action_to_move(current_dir, dx, dy):\n      \"\"\"Determine the action needed based on direction differences.\"\"\"\n      if dx == 1:  # Move RIGHT\n          return craft.RIGHT if current_dir != 2 else craft.USE\n      elif dx == -1:  # Move LEFT\n          return craft.LEFT if current_dir != 0 else craft.USE\n      elif dy == 1:  # Move DOWN\n          return craft.DOWN if current_dir != 3 else craft.USE\n      elif dy == -1:  # Move UP\n          return craft.UP if current_dir != 1 else craft.USE\n\n  # Find the path to the closest primitive\n  path_to_target = bfs((pos_x, pos_y), tuple(closest_target))\n\n  actions = []\n\n  for i in range(len(path_to_target)):\n      current_pos = path_to_target[i]\n      \n      if i < len(path_to_target) - 1:\n          next_pos = path_to_target[i + 1]\n          delta_x = next_pos[0] - current_pos[0]\n          delta_y = next_pos[1] - current_pos[1]\n          \n          action = action_to_move(dir, delta_x, delta_y)\n      else:\n          # If at the target position, use the action to collect the primitive\n          action = craft.USE\n\n      actions.append(action)\n\n      # Update agent's direction if an actual move was made\n      if i < len(path_to_target) - 1 and action in [craft.RIGHT, craft.LEFT, craft.UP, craft.DOWN]:\n          dir = {craft.RIGHT: 2, craft.LEFT: 0, craft.DOWN: 3, craft.UP: 1}[action]\n\n  return actions", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-09-26T03:33:53.695333", "function_name": "collect", "function_body": "  action_map = {\n      \"RIGHT\": craft.RIGHT,\n      \"LEFT\": craft.LEFT,\n      \"DOWN\": craft.DOWN,\n      \"UP\": craft.UP,\n      \"USE\": craft.USE\n  }\n\n  # Get the index of the primitive from the cookbook index\n  target_index = env.world.cookbook.index[primitive]\n\n  # Current state grid and agent's position/direction\n  grid = env._current_state.grid\n  pos_x, pos_y = env._current_state.pos\n  dir = env._current_state.dir\n\n  # Find all positions containing the primitive in the environment\n  target_positions = np.argwhere(grid[:, :, target_index] == 1)\n\n  if not target_positions.size:\n    return []\n\n  def calculate_manhattan_distance(p1, p2):\n      \"\"\"Calculate the Manhattan distance between two points.\"\"\"\n      return abs(p1[0] - p2[0]) + abs(p1[1] - p2[1])\n\n  # Find the closest primitive using the Manhattan distance\n  closest_target = min(target_positions, key=lambda pos: calculate_manhattan_distance((pos_x, pos_y), tuple(pos)))\n\n  def find_path_bfs(start, goal):\n      \"\"\"Find a path from start to goal using BFS.\"\"\"\n      directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]  # RIGHT, DOWN, LEFT, UP\n      queue = collections.deque([start])\n      came_from = {start: None}\n\n      while queue:\n          current = queue.popleft()\n          if current == goal:\n              break\n\n          for direction in directions:\n              next_pos = tuple(np.add(current, direction))\n              # Ensure the position is within grid bounds and not blocked by any primitive\n              if 0 <= next_pos[0] < grid.shape[0] and\\\n                 0 <= next_pos[1] < grid.shape[1]:\n                  if np.all(grid[next_pos[0], next_pos[1]] == 0):\n                      if next_pos not in came_from:\n                          queue.append(next_pos)\n                          came_from[next_pos] = current\n\n      # Reconstruct the path from start to goal\n      path = []\n      while current != start:\n          path.append(current)\n          current = came_from[current]\n      path.reverse()\n      return path\n\n  def determine_action(current_dir, dx, dy):\n      \"\"\"Determine the action needed based on direction differences.\"\"\"\n      if dx == 1:  # Move RIGHT\n          return craft.RIGHT if current_dir != 2 else craft.USE\n      elif dx == -1:  # Move LEFT\n          return craft.LEFT if current_dir != 0 else craft.USE\n      elif dy == 1:  # Move DOWN\n          return craft.DOWN if current_dir != 3 else craft.USE\n      elif dy == -1:  # Move UP\n          return craft.UP if current_dir != 1 else craft.USE\n\n  # Find the path to the closest primitive\n  path_to_target = find_path_bfs((pos_x, pos_y), tuple(closest_target))\n\n  actions = []\n\n  for i in range(len(path_to_target)):\n      current_pos = path_to_target[i]\n      \n      if i < len(path_to_target) - 1:\n          next_pos = path_to_target[i + 1]\n          delta_x = next_pos[0] - current_pos[0]\n          delta_y = next_pos[1] - current_pos[1]\n          \n          action = determine_action(dir, delta_x, delta_y)\n      else:\n          # If at the target position, use the action to collect the primitive\n          action = craft.USE\n\n      actions.append(action)\n\n      # Update agent's direction if an actual move was made\n      if i < len(path_to_target) - 1 and action in [craft.RIGHT, craft.LEFT, craft.UP, craft.DOWN]:\n          dir = {craft.RIGHT: 2, craft.LEFT: 0, craft.DOWN: 3, craft.UP: 1}[action]\n\n  return actions", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-09-26T03:35:00.300375", "function_name": "collect", "function_body": "  def is_blocked(x, y):\n    for kind_index in env.world.non_grabbable_indices:\n      if env._current_state.grid[x, y, kind_index] > 0:\n        return True\n    return False\n\n  # Determine the target primitive index from its name\n  target_primitive_index = env.world.cookbook.index[primitive]\n\n  # Initialize an empty list to store the actions needed\n  actions_to_take = []\n\n  # Current position of the agent\n  current_x, current_y = env._current_state.pos\n\n  # Get the grid dimensions\n  width, height, _ = env._current_state.grid.shape\n\n  # Use A* algorithm to find the shortest path to the target primitive\n  queue = collections.deque([(current_x, current_y, actions_to_take)])\n  visited = set()\n  visited.add((current_x, current_y))\n  cost_so_far = {}\n  cost_so_far[(current_x, current_y)] = 0\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    # Check if we are next to a cell containing the target primitive\n    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n      nx, ny = x + dx, y + dy\n\n      # Ensure within bounds and not visited\n      if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n        if env._current_state.grid[nx, ny, target_primitive_index] > 0:\n          # Move to the adjacent cell containing the primitive\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          actions_to_take.extend(path + [move_action])\n\n          # Collect the primitive\n          actions_to_take.append(craft.USE)\n          return actions_to_take\n\n        # Mark as visited and add to queue if not blocked\n        if not is_blocked(nx, ny):\n          visited.add((nx, ny))\n          new_path = path.copy()\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          new_cost = cost_so_far[(x, y)] + 1  # Assuming uniform cost for each move\n          if (nx, ny) not in cost_so_far or new_cost < cost_so_far[(nx, ny)]:\n            cost_so_far[(nx, ny)] = new_cost\n            queue.append((nx, ny, new_path))\n\n  # If no path is found, return an empty list of actions\n  return []", "island_id": 6, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T03:35:01.362758", "function_name": "collect", "function_body": "  def is_blocked(x, y):\n    for kind_index in env.world.non_grabbable_indices:\n      if env._current_state.grid[x, y, kind_index] > 0:\n        return True\n    return False\n\n  # Determine the target primitive index from its name\n  target_primitive_index = env.world.cookbook.index[primitive]\n\n  # Initialize an empty list to store the actions needed\n  actions_to_take = []\n\n  # Current position of the agent\n  current_x, current_y = env._current_state.pos\n\n  # Get the grid dimensions\n  width, height, _ = env._current_state.grid.shape\n\n  # Use BFS to find the shortest path to the target primitive\n  queue = collections.deque([(current_x, current_y, actions_to_take)])\n  visited = set()\n  visited.add((current_x, current_y))\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    # Check if we are next to a cell containing the target primitive\n    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n      nx, ny = x + dx, y + dy\n\n      # Ensure within bounds and not visited\n      if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n        if env._current_state.grid[nx, ny, target_primitive_index] > 0:\n          # Move to the adjacent cell containing the primitive\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          actions_to_take.extend(path + [move_action])\n\n          # Collect the primitive\n          actions_to_take.append(craft.USE)\n          return actions_to_take\n\n        # Mark as visited and add to queue if not blocked\n        if not is_blocked(nx, ny):\n          visited.add((nx, ny))\n          new_path = path.copy()\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          new_path.append(move_action)\n          queue.append((nx, ny, new_path))\n\n  # If no path is found, return an empty list of actions\n  return []", "island_id": 6, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T03:35:58.760212", "function_name": "collect", "function_body": "  def _find_shortest_path(grid, start_pos, target_kind, inventory):\n    width, height = grid.shape[:2]\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n      \n      if grid[x, y].argmax() == target_kind and (x, y) != start_pos:\n        return path\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          cell_content_index = grid[nx, ny].argmax()\n          # Allow movement on clear cells or through tools that are available in the inventory\n          if grid[nx, ny].sum() == 1 or inventory[cell_content_index] > 0:  \n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))\n    \n    return None\n\n  def _get_action_index_from_direction(direction):\n    mapping = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, (0, -1): craft.DOWN, (0, 1): craft.UP}\n    return mapping.get(direction)\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  inventory = current_state.inventory\n  \n  primitive_index = current_state.world.cookbook.index.index(primitive)\n  \n  path_to_primitive = _find_shortest_path(grid, pos, primitive_index, inventory)\n  \n  if not path_to_primitive:\n    return []\n  \n  actions = [_get_action_index_from_direction(step) for step in path_to_primitive]\n  actions.append(craft.USE)  # Add action to collect the primitive\n  \n  return actions", "island_id": 9, "scores": {"3": 2.5}}
{"timestamp": "2025-09-26T03:35:59.869786", "function_name": "collect", "function_body": "  def _find_shortest_path(grid, start_pos, target_kind, inventory):\n    width, height = grid.shape[:2]\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n      \n      if grid[x, y].argmax() == target_kind and (x, y) != start_pos:\n        return path\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          cell_content_index = grid[nx, ny].argmax()\n          # Allow movement on clear cells or through tools that are available in the inventory\n          if grid[nx, ny].sum() == 1 or inventory[cell_content_index] > 0:  \n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))\n    \n    return None\n\n  def _get_action_index_from_direction(direction):\n    mapping = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, (0, -1): craft.DOWN, (0, 1): craft.UP}\n    return mapping.get(direction)\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  inventory = current_state.inventory\n  \n  primitive_index = current_state.world.cookbook.index.index(primitive)\n  \n  path_to_primitive = _find_shortest_path(grid, pos, primitive_index, inventory)\n\n  if not path_to_primitive:\n    return []\n\n  actions = []\n  for step in path_to_primitive:\n      action = _get_action_index_from_direction(step)\n      actions.append(action)\n      \n      # Simulate the step to check if we need to use a tool\n      new_pos = (pos[0] + step[0], pos[1] + step[1])\n      cell_content_index = grid[new_pos].argmax()\n      if inventory[cell_content_index] > 0:\n          actions.append(craft.USE)  # Use the tool\n\n      pos = new_pos  # Update position for the next iteration\n  \n  actions.append(craft.USE)  # Add action to collect the primitive\n\n  return actions", "island_id": 9, "scores": {"3": 2.5}}
{"timestamp": "2025-09-26T03:37:09.855342", "function_name": "collect", "function_body": "  def get_primitive_index(primitive_name):\n      return env._current_state.world.cookbook.index[primitive_name]\n\n  actions = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  current_state = env._current_state\n\n  queue = collections.deque([(current_state.pos, [])])\n  visited = set([current_state.pos])\n\n  target_primitive_index = get_primitive_index(primitive)\n\n  while queue:\n      pos, actions_taken = queue.popleft()\n\n      if current_state.grid[pos[0], pos[1], target_primitive_index] > 0:\n          return actions_taken + [actions[\"USE\"]]\n\n      neighbors = get_neighbors(pos)\n      for neighbor in neighbors:\n          nx, ny = neighbor\n\n          if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n              # Check if the cell is not blocked by non-grabbable entities.\n              if all(current_state.grid[ny, nx, env_index] == 0 for env_index in current_state.world.non_grabbable_indices):\n                  if neighbor not in visited:\n                      visited.add(neighbor)\n\n                      dx, dy = nx - pos[0], ny - pos[1]\n                      action = None\n                      if dx == 1:\n                          action = actions[\"RIGHT\"]\n                      elif dx == -1:\n                          action = actions[\"LEFT\"]\n                      elif dy == 1:\n                          action = actions[\"DOWN\"]\n                      else:  # dy == -1\n                          action = actions[\"UP\"]\n\n                      queue.append((neighbor, actions_taken + [action]))\n\n              # Check if the cell can be cleared using available tools.\n              tool_action_needed = False\n              for tool_index in current_state.world.grabbable_indices:\n                  if current_state.inventory[tool_index] > 0 and current_state.grid[ny, nx, tool_index] > 0:\n                      tool_action_needed = True\n\n              if tool_action_needed:\n                  return actions_taken + [actions[\"USE\"]]\n\n      # Check if the cell can be cleared using available tools around the current position.\n      for neighbor in get_neighbors(current_state.pos):\n          nx, ny = neighbor\n          if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n              tool_action_needed = False\n              for tool_index in current_state.world.grabbable_indices:\n                  if current_state.inventory[tool_index] > 0 and current_state.grid[ny, nx, tool_index] > 0:\n                      tool_action_needed = True\n\n              if tool_action_needed:\n                  return [actions[\"USE\"]]\n\n  return []", "island_id": 1, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T03:37:10.963855", "function_name": "collect", "function_body": "  def get_primitive_index(primitive_name):\n      return env._current_state.world.cookbook.index[primitive_name]\n\n  actions = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  current_state = env._current_state\n\n  queue = collections.deque([(current_state.pos, [])])\n  visited = set([current_state.pos])\n\n  target_primitive_index = get_primitive_index(primitive)\n\n  while queue:\n      pos, actions_taken = queue.popleft()\n\n      if current_state.grid[pos[0], pos[1], target_primitive_index] > 0:\n          return actions_taken + [actions[\"USE\"]]\n\n      neighbors = get_neighbors(pos)\n      for neighbor in neighbors:\n          nx, ny = neighbor\n\n          if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n              # Check if the cell is not blocked by non-grabbable entities.\n              if all(current_state.grid[ny, nx, env_index] == 0 for env_index in current_state.world.non_grabbable_indices):\n                  if neighbor not in visited:\n                      visited.add(neighbor)\n\n                      dx, dy = nx - pos[0], ny - pos[1]\n                      if dx == 1:\n                          action = actions[\"RIGHT\"]\n                      elif dx == -1:\n                          action = actions[\"LEFT\"]\n                      elif dy == 1:\n                          action = actions[\"DOWN\"]\n                      else:  # dy == -1\n                          action = actions[\"UP\"]\n\n                      queue.append((neighbor, actions_taken + [action]))\n\n              # Check if the cell can be cleared using available tools.\n              for tool_index in current_state.world.grabbable_indices:\n                  if current_state.inventory[tool_index] > 0 and current_state.grid[ny, nx, tool_index] > 0:\n                      return actions_taken + [actions[\"USE\"]]\n\n      # Check if the cell can be cleared using available tools around the current position.\n      for neighbor in get_neighbors(pos):\n          nx, ny = neighbor\n\n          if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n              if any(current_state.inventory[tool_index] > 0 and current_state.grid[ny, nx, tool_index] > 0 for tool_index in current_state.world.grabbable_indices):\n                  return [actions[\"USE\"]]\n\n  return []", "island_id": 1, "scores": {"3": 4.0}}
