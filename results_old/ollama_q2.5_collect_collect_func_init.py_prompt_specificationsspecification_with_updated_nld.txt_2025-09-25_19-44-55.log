{"timestamp": "2025-09-26T03:54:39.455945", "function_name": "collect", "function_body": "  actions = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  # Get the current state of the environment.\n  current_state = env._current_state\n\n  # Helper function to find neighboring positions, considering obstacles and tools.\n  def get_neighbors(pos):\n      x, y = pos\n      neighbors = [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n      \n      # Filter out invalid positions and positions blocked by non-grabbable entities.\n      valid_neighbors = []\n      for nx, ny in neighbors:\n          if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n              # Check if the cell is not blocked by non-grabbable entities.\n              if all(current_state.grid[ny, nx, env_index] == 0 for env_index in current_state.world.non_grabbable_indices):\n                  valid_neighbors.append((nx, ny))\n      return valid_neighbors\n\n  # Define a queue for BFS and a set to track visited positions.\n  queue = collections.deque([(current_state.pos, [])])\n  visited = set([current_state.pos])\n\n  # Helper function to get the index of a primitive name.\n  def get_primitive_index(primitive_name):\n      return current_state.world.cookbook.index[primitive_name]\n\n  # Get the index for the target primitive.\n  target_primitive_index = get_primitive_index(primitive)\n\n  # Perform BFS to find a path to collect the primitive.\n  while queue:\n      pos, actions_taken = queue.popleft()\n\n      # Check if we are at a cell with the desired primitive.\n      if current_state.grid[pos[0], pos[1], target_primitive_index] > 0:\n          return actions_taken + [actions[\"USE\"]]\n\n      # Get neighboring positions and filter out invalid ones.\n      neighbors = get_neighbors(pos)\n      for neighbor in neighbors:\n          nx, ny = neighbor\n\n          # Determine the direction to move towards the neighbor.\n          dx, dy = nx - pos[0], ny - pos[1]\n          if dx == 1:\n              action = actions[\"RIGHT\"]\n          elif dx == -1:\n              action = actions[\"LEFT\"]\n          elif dy == 1:\n              action = actions[\"DOWN\"]\n          else:  # dy == -1\n              action = actions[\"UP\"]\n\n          # If the cell is visited for the first time, add it to the queue.\n          if neighbor not in visited:\n              visited.add(neighbor)\n              queue.append((neighbor, actions_taken + [action]))\n\n  # If no path is found to collect the primitive, return an empty list.\n  return []", "island_id": 8, "scores": {"3": 4.0}}
