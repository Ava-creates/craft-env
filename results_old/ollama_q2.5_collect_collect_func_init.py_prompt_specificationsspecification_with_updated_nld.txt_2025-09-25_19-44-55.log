rrent_dir != 2 else craft.USE\n    elif dx == -1:  # Move LEFT\n      return craft.LEFT if current_dir != 0 else craft.USE\n    elif dy == 1:  # Move DOWN\n      return craft.DOWN if current_dir != 3 else craft.USE\n    elif dy == -1:  # Move UP\n      return craft.UP if current_dir != 1 else craft.USE\n\n  path = find_path((pos_x, pos_y), closest_target_pos)\n  actions = []\n\n  for i in range(len(path)):\n    current_pos = path[i]\n\n    # Determine the target position based on the current index and the next one\n    next_pos = path[i + 1] if i < len(path) - 1 else closest_target_pos\n\n    delta_x = next_pos[0] - current_pos[0]\n    delta_y = next_pos[1] - current_pos[1]\n\n    action = get_direction_to_target(dir, delta_x, delta_y)\n    actions.append(action)\n\n    # Update the agent's direction\n    if action in [craft.RIGHT, craft.LEFT, craft.UP, craft.DOWN]:\n      dir = {craft.RIGHT: 2, craft.LEFT: 0, craft.DOWN: 3, craft.UP: 1}[action]\n\n  # Add a USE action to collect the primitive at the target position\n  actions.append(craft.USE)\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-26T00:59:23.703388", "function_name": "collect", "function_body": "  def is_blocked(x, y):\n    for kind_index in env.world.non_grabbable_indices:\n      if env._current_state.grid[x, y, kind_index] > 0:\n        return True\n    return False\n\n  # Determine the target primitive index from its name\n  target_primitive_index = env.world.cookbook.index[primitive]\n\n  # Initialize an empty list to store the actions needed\n  actions_to_take = []\n\n  # Current position of the agent\n  current_x, current_y = env._current_state.pos\n\n  # Get the grid dimensions\n  width, height, _ = env._current_state.grid.shape\n\n  # Use BFS to find the shortest path to the target primitive\n  queue = collections.deque([(current_x, current_y, actions_to_take)])\n  visited = set()\n  visited.add((current_x, current_y))\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    # Check if we are next to a cell containing the target primitive\n    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n      nx, ny = x + dx, y + dy\n\n      # Ensure within bounds and not visited\n      if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n        if env._current_state.grid[nx, ny, target_primitive_index] > 0:\n          # Move to the adjacent cell containing the primitive\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          actions_to_take.extend(path + [move_action])\n\n          # Collect the primitive\n          actions_to_take.append(craft.USE)\n          return actions_to_take\n\n        # Mark as visited and add to queue if not blocked\n        if not is_blocked(nx, ny):\n          visited.add((nx, ny))\n          new_path = path.copy()\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          new_path.append(move_action)\n          queue.append((nx, ny, new_path))\n\n        # Check for tools in inventory to use on obstacles\n        elif is_blocked(nx, ny):\n          tool_to_use = None\n          if env.world.cookbook.primitives[env.world.cookbook.index['AXE']].can_use_on('WOOD') and\\\n             'AXE' in env._current_state.inventory:\n            tool_to_use = craft.USE\n          # Add more tool checks here if necessary\n\n          if tool_to_use is not None:\n            actions_to_take.append(tool_to_use)\n            break\n\n  # If no path is found, return an empty list of actions\n  return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-26T00:59:24.762940", "function_name": "collect", "function_body": "  def is_blocked(x, y):\n    for kind_index in env.world.non_grabbable_indices:\n      if env._current_state.grid[x, y, kind_index] > 0:\n        return True\n    return False\n\n  # Determine the target primitive index from its name\n  target_primitive_index = env.world.cookbook.index[primitive]\n\n  # Initialize an empty list to store the actions needed\n  actions_to_take = []\n\n  # Current position of the agent\n  current_x, current_y = env._current_state.pos\n\n  # Get the grid dimensions\n  width, height, _ = env._current_state.grid.shape\n\n  # Use BFS to find the shortest path to the target primitive\n  queue = collections.deque([(current_x, current_y, actions_to_take)])\n  visited = set()\n  visited.add((current_x, current_y))\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    # Check if we are next to a cell containing the target primitive\n    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n      nx, ny = x + dx, y + dy\n\n      # Ensure within bounds and not visited\n      if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n        if env._current_state.grid[nx, ny, target_primitive_index] > 0:\n          # Move to the adjacent cell containing the primitive\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          actions_to_take.extend(path + [move_action])\n\n          # Collect the primitive\n          actions_to_take.append(craft.USE)\n          return actions_to_take\n\n        # Mark as visited and add to queue if not blocked\n        if not is_blocked(nx, ny):\n          visited.add((nx, ny))\n          new_path = path.copy()\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          new_path.append(move_action)\n          queue.append((nx, ny, new_path))\n\n        # Check for tools in inventory to use on obstacles\n        if is_blocked(nx, ny):\n          for tool_index in env._current_state.inventory:\n            if tool_index == env.world.cookbook.index['AXE'] and\\\n               env.world.cookbook.primitives[tool_index].can_use_on('WOOD'):\n              actions_to_take.append(craft.USE)\n              break\n\n  # If no path is found, return an empty list of actions\n  return []", "island_id": 7, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T01:00:39.238135", "function_name": "collect", "function_body": "  def get_primitive_index(primitive_name):\n      return env._current_state.world.cookbook.index[primitive_name]\n\n  def is_clear_path(pos, target_pos):\n      x, y = pos\n      tx, ty = target_pos\n\n      queue = collections.deque([pos])\n      visited = set([pos])\n\n      while queue:\n          current = queue.popleft()\n          if current == target_pos:\n              return True\n\n          neighbors = [(current[0] + dx, current[1] + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n          for nx, ny in neighbors:\n              if 0 <= nx < env._current_state.grid.shape[1] and 0 <= ny < env._current_state.grid.shape[0]:\n                  if all(env._current_state.grid[ny, nx, env_index] == 0 for env_index in env._current_state.world.non_grabbable_indices) and (nx, ny) not in visited:\n                      queue.append((nx, ny))\n                      visited.add((nx, ny))\n\n      return False\n\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  actions = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  current_state = env._current_state\n  queue = collections.deque([(current_state.pos, [])])\n  visited = set([current_state.pos])\n\n  target_primitive_index = get_primitive_index(primitive)\n\n  while queue:\n      pos, actions_taken = queue.popleft()\n\n      if current_state.grid[pos[0], pos[1], target_primitive_index] > 0:\n          return actions_taken + [actions[\"USE\"]]\n\n      neighbors = get_neighbors(pos)\n      for neighbor in neighbors:\n          nx, ny = neighbor\n\n          # Ensure the neighbor is within bounds.\n          if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n              # Check if the cell is not blocked by non-grabbable entities or can be cleared with tools.\n              if all(current_state.grid[ny, nx, env_index] == 0 for env_index in current_state.world.non_grabbable_indices):\n                  if neighbor not in visited:\n                      visited.add(neighbor)\n\n                      dx, dy = nx - pos[0], ny - pos[1]\n                      if dx == 1:\n                          action = actions[\"RIGHT\"]\n                      elif dx == -1:\n                          action = actions[\"LEFT\"]\n                      elif dy == 1:\n                          action = actions[\"DOWN\"]\n                      else:  # dy == -1\n                          action = actions[\"UP\"]\n\n                      queue.append((neighbor, actions_taken + [action]))\n              else:\n                  # Check if any tool in inventory can be used to clear the path.\n                  for tool_index in current_state.world.grabbable_indices:\n                      if current_state.inventory[tool_index] > 0 and current_state.grid[ny, nx, tool_index] > 0:\n                          return actions_taken + [actions[\"USE\"]]\n\n  return []", "island_id": 1, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T01:00:40.380117", "function_name": "collect", "function_body": "  def get_primitive_index(primitive_name):\n      return env._current_state.world.cookbook.index[primitive_name]\n\n  actions = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  current_state = env._current_state\n  queue = collections.deque([(current_state.pos, [])])\n  visited = set([current_state.pos])\n\n  target_primitive_index = get_primitive_index(primitive)\n\n  while queue:\n      pos, actions_taken = queue.popleft()\n\n      if current_state.grid[pos[0], pos[1], target_primitive_index] > 0:\n          return actions_taken + [actions[\"USE\"]]\n\n      neighbors = get_neighbors(pos)\n      for neighbor in neighbors:\n          nx, ny = neighbor\n\n          # Ensure the neighbor is within bounds.\n          if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n              # Check if the cell is not blocked by non-grabbable entities or can be cleared with tools.\n              if all(current_state.grid[ny, nx, env_index] == 0 for env_index in current_state.world.non_grabbable_indices):\n                  if neighbor not in visited:\n                      visited.add(neighbor)\n\n                      dx, dy = nx - pos[0], ny - pos[1]\n                      if dx == 1:\n                          action = actions[\"RIGHT\"]\n                      elif dx == -1:\n                          action = actions[\"LEFT\"]\n                      elif dy == 1:\n                          action = actions[\"DOWN\"]\n                      else:  # dy == -1\n                          action = actions[\"UP\"]\n\n                      queue.append((neighbor, actions_taken + [action]))\n              else:\n                  # Check if any tool in inventory can be used to clear the path.\n                  for tool_index in current_state.world.grabbable_indices:\n                      if current_state.inventory[tool_index] > 0 and current_state.grid[ny, nx, env_index] > 0:\n                          return actions_taken + [actions[\"USE\"]]\n\n              # Check if there is any obstacle that needs to be cleared.\n              for env_index in current_state.world.non_grabbable_indices:\n                  if current_state.grid[ny, nx, env_index] > 0:\n                      # Use the tool if available and applicable.\n                      for tool_index in current_state.world.grabbable_indices:\n                          if current_state.inventory[tool_index] > 0:\n                              return actions_taken + [actions[\"USE\"]]\n\n  return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-26T01:01:35.782250", "function_name": "collect", "function_body": "  def _find_shortest_path(grid, start_pos, target_kind, inventory):\n    width, height = grid.shape[:2]\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n      \n      if grid[x, y].argmax() == target_kind and (x, y) != start_pos:\n        return path\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          can_move = True\n          \n          # Check if there are obstacles and if the agent has tools to clear them\n          for tool in inventory:\n            if grid[nx, ny][tool]:\n              can_move = False\n              break\n          \n          if can_move or grid[nx, ny].sum() == 1:\n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))\n    \n    return None\n\n  def _get_action_index_from_direction(direction):\n    mapping = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, (0, -1): craft.DOWN, (0, 1): craft.UP}\n    return mapping.get(direction)\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  inventory = [i for i in range(len(current_state.inventory)) if current_state.inventory[i] > 0]\n  \n  primitive_index = current_state.world.cookbook.index.index(primitive)\n  \n  path_to_primitive = _find_shortest_path(grid, pos, primitive_index, inventory)\n  \n  if not path_to_primitive:\n    return []\n  \n  actions = [_get_action_index_from_direction(step) for step in path_to_primitive]\n  actions.append(craft.USE)  # Add action to collect the primitive\n  \n  return actions", "island_id": 5, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T01:01:36.828902", "function_name": "collect", "function_body": "  def _find_shortest_path(grid, start_pos, target_kind, inventory):\n    width, height = grid.shape[:2]\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n      \n      if grid[x, y].argmax() == target_kind and (x, y) != start_pos:\n        return path\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          can_move = True\n          \n          # Check if there are obstacles and if the agent has tools to clear them\n          for tool in inventory:\n            if grid[nx, ny][tool]:\n              can_move = False\n              break\n          \n          if can_move or grid[nx, ny].sum() == 1:\n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))\n    \n    return None\n\n  def _get_action_index_from_direction(direction):\n    mapping = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, (0, -1): craft.DOWN, (0, 1): craft.UP}\n    return mapping.get(direction)\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  inventory = [i for i in range(len(current_state.inventory)) if current_state.inventory[i] > 0]\n  \n  primitive_index = current_state.world.cookbook.index.index(primitive)\n  \n  path_to_primitive = _find_shortest_path(grid, pos, primitive_index, inventory)\n  \n  if not path_to_primitive:\n    return []\n  \n  actions = [_get_action_index_from_direction(step) for step in path_to_primitive]\n  actions.append(craft.USE)  # Add action to collect the primitive\n  \n  return actions", "island_id": 5, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T01:02:47.655285", "function_name": "collect", "function_body": "  def is_blocked(x, y):\n    for kind_index in env.world.non_grabbable_indices:\n      if env._current_state.grid[x, y, kind_index] > 0:\n        return True\n    return False\n\n  # Determine the target primitive index from its name\n  target_primitive_index = env.world.cookbook.index[primitive]\n\n  # Initialize an empty list to store the actions needed\n  actions_to_take = []\n\n  # Current position of the agent\n  current_x, current_y = env._current_state.pos\n\n  # Get the grid dimensions\n  width, height, _ = env._current_state.grid.shape\n\n  # Use BFS to find the shortest path to the target primitive\n  queue = collections.deque([(current_x, current_y, actions_to_take)])\n  visited = set()\n  visited.add((current_x, current_y))\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    # Check if we are next to a cell containing the target primitive\n    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n      nx, ny = x + dx, y + dy\n\n      # Ensure within bounds and not visited\n      if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n        if env._current_state.grid[nx, ny, target_primitive_index] > 0:\n          # Move to the adjacent cell containing the primitive\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          actions_to_take.extend(path + [move_action])\n\n          # Collect the primitive\n          actions_to_take.append(craft.USE)\n          return actions_to_take\n\n        # Mark as visited and add to queue if not blocked\n        if not is_blocked(nx, ny):\n          visited.add((nx, ny))\n          new_path = path.copy()\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          new_path.append(move_action)\n          queue.append((nx, ny, new_path))\n\n        # Check for tools in inventory to use on obstacles\n        if is_blocked(nx, ny):\n          for tool_index in env._current_state.inventory:\n            if tool_index == env.world.cookbook.index['AXE'] and\\\n               env.world.cookbook.primitives[tool_index].can_use_on('WOOD'):\n              actions_to_take.append(craft.USE)\n              break\n\n  # If no path is found, return an empty list of actions\n  return []", "island_id": 7, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T01:02:48.704475", "function_name": "collect", "function_body": "  def is_blocked(x, y):\n    for kind_index in env.world.non_grabbable_indices:\n      if env._current_state.grid[x, y, kind_index] > 0:\n        return True\n    return False\n\n  # Determine the target primitive index from its name\n  target_primitive_index = env.world.cookbook.index[primitive]\n\n  # Initialize an empty list to store the actions needed\n  actions_to_take = []\n\n  # Current position of the agent\n  current_x, current_y = env._current_state.pos\n\n  # Get the grid dimensions\n  width, height, _ = env._current_state.grid.shape\n\n  # Use BFS to find the shortest path to the target primitive\n  queue = collections.deque([(current_x, current_y, actions_to_take)])\n  visited = set()\n  visited.add((current_x, current_y))\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    # Check if we are next to a cell containing the target primitive\n    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n      nx, ny = x + dx, y + dy\n\n      # Ensure within bounds and not visited\n      if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n        if env._current_state.grid[nx, ny, target_primitive_index] > 0:\n          # Move to the adjacent cell containing the primitive\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          actions_to_take.extend(path + [move_action])\n\n          # Collect the primitive\n          actions_to_take.append(craft.USE)\n          return actions_to_take\n\n        # Mark as visited and add to queue if not blocked\n        if not is_blocked(nx, ny):\n          visited.add((nx, ny))\n          new_path = path.copy()\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          new_path.append(move_action)\n          queue.append((nx, ny, new_path))\n\n        # Check for tools in inventory to use on obstacles\n        if is_blocked(nx, ny):\n          for tool_index in env._current_state.inventory:\n            if tool_index == env.world.cookbook.index['AXE'] and\\\n               env.world.cookbook.primitives[tool_index].can_use_on('WOOD'):\n              actions_to_take.append(craft.USE)\n              break\n\n  # If no path is found, return an empty list of actions\n  return []", "island_id": 7, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T01:04:25.627833", "function_name": "collect", "function_body": "  # Get the index for the specified primitive\n  index = env.world.cookbook.index[primitive]\n  \n  # Extract the current state's grid and position/direction data\n  grid = env._current_state.grid\n  pos_x, pos_y = env._current_state.pos\n  dir = env._current_state.dir\n\n  # Find all positions in the grid that contain the target primitive\n  target_positions = np.argwhere(grid[:, :, index] == 1)\n\n  # If no targets found, return an empty list of actions\n  if len(target_positions) == 0:\n    return []\n\n  # Calculate Manhattan distances from current position to all targets\n  distances = [(abs(pos_x - tx), abs(pos_y - ty)) for tx, ty in target_positions]\n  distances = [dx + dy for dx, dy in distances]\n\n  # Find the index of the closest target based on the calculated distances\n  min_distance_index = np.argmin(distances)\n  closest_target_pos = tuple(target_positions[min_distance_index])\n\n  def find_path(start, goal):\n    \"\"\"Find a path from start to goal using BFS.\"\"\"\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]  # RIGHT, DOWN, LEFT, UP\n    queue = collections.deque([start])\n    came_from = {start: None}\n    \n    while queue:\n      current = queue.popleft()\n      \n      if current == goal:\n        break\n      \n      for direction in directions:\n        next_pos = tuple(np.add(current, direction))\n        \n        # Ensure the next position is within grid bounds\n        if 0 <= next_pos[0] < grid.shape[0] and\\\n           0 <= next_pos[1] < grid.shape[1]:\n          # Check if the next position is not blocked by any primitives\n          if all(grid[next_pos[0], next_pos[1]] == 0):\n            if next_pos not in came_from:\n              queue.append(next_pos)\n              came_from[next_pos] = current\n    \n    # Reconstruct path from start to goal\n    path = []\n    while current != start:\n      path.append(current)\n      current = came_from[current]\n    path.reverse()\n    \n    return path\n\n  def get_direction_to_target(current_dir, dx, dy):\n    \"\"\"Determine the action needed to move in a given direction.\"\"\"\n    if dx == 1:  # Move RIGHT\n      return craft.RIGHT if current_dir != 2 else craft.USE\n    elif dx == -1:  # Move LEFT\n      return craft.LEFT if current_dir != 0 else craft.USE\n    elif dy == 1:  # Move DOWN\n      return craft.DOWN if current_dir != 3 else craft.USE\n    elif dy == -1:  # Move UP\n      return craft.UP if current_dir != 1 else craft.USE\n\n  def update_direction(current_dir, action):\n    \"\"\"Update the agent's direction based on the taken action.\"\"\"\n    direction_map = {\n        craft.RIGHT: 2,\n        craft.LEFT: 0,\n        craft.DOWN: 3,\n        craft.UP: 1\n    }\n    \n    return direction_map.get(action, current_dir)\n\n  # Find the shortest path to the closest target position\n  path = find_path((pos_x, pos_y), closest_target_pos)\n  \n  # Initialize an empty list to store actions\n  actions = []\n\n  for i in range(len(path)):\n    current_pos = path[i]\n    \n    if i < len(path) - 1:\n      next_pos = path[i + 1]\n      delta_x = next_pos[0] - current_pos[0]\n      delta_y = next_pos[1] - current_pos[1]\n      \n      action = get_direction_to_target(dir, delta_x, delta_y)\n    else:\n      # If the agent is at the target position, use the action to collect the primitive\n      action = craft.USE\n\n    actions.append(action)\n\n    # Update the agent's direction if an actual move was made\n    if i < len(path) - 1 and action in [craft.RIGHT, craft.LEFT, craft.UP, craft.DOWN]:\n      dir = update_direction(dir, action)\n\n  return actions", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-09-26T01:04:26.696402", "function_name": "collect", "function_body": "  # Map action names to their corresponding indices\n  action_map = {\n      \"RIGHT\": craft.RIGHT,\n      \"LEFT\": craft.LEFT,\n      \"DOWN\": craft.DOWN,\n      \"UP\": craft.UP,\n      \"USE\": craft.USE\n  }\n\n  # Get the index of the primitive from the cookbook index\n  target_index = env.world.cookbook.index[primitive]\n\n  # Current state grid and agent's position/direction\n  grid = env._current_state.grid\n  pos_x, pos_y = env._current_state.pos\n  dir = env._current_state.dir\n\n  # Find all positions containing the primitive in the environment\n  target_positions = np.argwhere(grid[:, :, target_index] == 1)\n\n  if not target_positions.size:\n    return []\n\n  def calculate_manhattan_distance(p1, p2):\n      \"\"\"Calculate the Manhattan distance between two points.\"\"\"\n      return abs(p1[0] - p2[0]) + abs(p1[1] - p2[1])\n\n  # Find the closest primitive using the Manhattan distance\n  closest_target = min(target_positions, key=lambda pos: calculate_manhattan_distance((pos_x, pos_y), tuple(pos)))\n\n  def find_path_bfs(start, goal):\n      \"\"\"Find a path from start to goal using BFS.\"\"\"\n      directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]  # RIGHT, DOWN, LEFT, UP\n      queue = collections.deque([start])\n      came_from = {start: None}\n\n      while queue:\n          current = queue.popleft()\n          if current == goal:\n              break\n\n          for direction in directions:\n              next_pos = tuple(np.add(current, direction))\n              # Ensure the position is within grid bounds and not blocked by any primitive\n              if 0 <= next_pos[0] < grid.shape[0] and\\\n                 0 <= next_pos[1] < grid.shape[1]:\n                  if np.all(grid[next_pos[0], next_pos[1]] == 0):\n                      if next_pos not in came_from:\n                          queue.append(next_pos)\n                          came_from[next_pos] = current\n\n      # Reconstruct the path from start to goal\n      path = []\n      while current != start:\n          path.append(current)\n          current = came_from[current]\n      path.reverse()\n      return path\n\n  def determine_action(current_dir, dx, dy):\n      \"\"\"Determine the action needed based on direction differences.\"\"\"\n      if dx == 1:  # Move RIGHT\n          return craft.RIGHT if current_dir != 2 else craft.USE\n      elif dx == -1:  # Move LEFT\n          return craft.LEFT if current_dir != 0 else craft.USE\n      elif dy == 1:  # Move DOWN\n          return craft.DOWN if current_dir != 3 else craft.USE\n      elif dy == -1:  # Move UP\n          return craft.UP if current_dir != 1 else craft.USE\n\n  # Find the path to the closest primitive\n  path_to_target = find_path_bfs((pos_x, pos_y), tuple(closest_target))\n\n  actions = []\n\n  for i in range(len(path_to_target)):\n      current_pos = path_to_target[i]\n      \n      if i < len(path_to_target) - 1:\n          next_pos = path_to_target[i + 1]\n          delta_x = next_pos[0] - current_pos[0]\n          delta_y = next_pos[1] - current_pos[1]\n          \n          action = determine_action(dir, delta_x, delta_y)\n      else:\n          # If at the target position, use the action to collect the primitive\n          action = craft.USE\n\n      actions.append(action)\n\n      # Update agent's direction if an actual move was made\n      if i < len(path_to_target) - 1 and action in [craft.RIGHT, craft.LEFT, craft.UP, craft.DOWN]:\n          dir = {craft.RIGHT: 2, craft.LEFT: 0, craft.DOWN: 3, craft.UP: 1}[action]\n\n  return actions", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-09-26T01:05:22.715346", "function_name": "collect", "function_body": "  def _find_shortest_path(grid, start_pos, target_kind):\n    width, height = grid.shape[:2]\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n      \n      if grid[x, y].argmax() == target_kind and (x, y) != start_pos:\n        return path\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          if grid[nx, ny].sum() == 1:  # Allow moving through empty cells\n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))\n          elif inventory[grid[nx, ny].argmax()] > 0:  # Allow moving through obstacles if tool is available\n            tool_index = grid[nx, ny].argmax()\n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))  # Use the tool and move\n    \n    return None\n\n  def _get_action_index_from_direction(direction):\n    mapping = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, (0, -1): craft.DOWN, (0, 1): craft.UP}\n    return mapping.get(direction)\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  inventory = current_state.inventory\n  \n  primitive_index = current_state.world.cookbook.index.index(primitive)\n  \n  path_to_primitive = _find_shortest_path(grid, pos, primitive_index)\n  \n  if not path_to_primitive:\n    return []\n  \n  actions = [_get_action_index_from_direction(step) for step in path_to_primitive]\n  actions.append(craft.USE)  # Add action to collect the primitive\n  \n  return actions", "island_id": 8, "scores": {"3": 2.5}}
{"timestamp": "2025-09-26T01:05:23.746067", "function_name": "collect", "function_body": "  def _find_shortest_path(grid, start_pos, target_kind):\n    width, height = grid.shape[:2]\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n      \n      if grid[x, y].argmax() == target_kind and (x, y) != start_pos:\n        return path\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          if grid[nx, ny].sum() == 1:  # Allow moving through empty cells\n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))\n          elif inventory[grid[nx, ny].argmax()] > 0:  # Allow moving through obstacles if tool is available\n            tool_index = grid[nx, ny].argmax()\n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))  # Use the tool and move\n    \n    return None\n\n  def _get_action_index_from_direction(direction):\n    mapping = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, (0, -1): craft.DOWN, (0, 1): craft.UP}\n    return mapping.get(direction)\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  inventory = current_state.inventory\n  \n  primitive_index = current_state.world.cookbook.index.index(primitive)\n  \n  path_to_primitive = _find_shortest_path(grid, pos, primitive_index)\n  \n  if not path_to_primitive:\n    return []\n  \n  actions = [_get_action_index_from_direction(step) for step in path_to_primitive]\n  actions.append(craft.USE)  # Add action to collect the primitive\n  \n  return actions", "island_id": 8, "scores": {"3": 2.5}}
{"timestamp": "2025-09-26T01:06:55.629841", "function_name": "collect", "function_body": "  def get_available_tools(state):\n    # This function should return a dictionary of tools available in the inventory\n    tool_dict = {}\n    for i, count in enumerate(state.inventory):\n      tool_index = env.world.cookbook.index[i]\n      tool_name = [k for k, v in env.world.cookbook.index.items() if v == tool_index][0]\n      tool_dict[tool_name] = count\n    return tool_dict\n\n  def get_move_action(current_dir, dx, dy):\n    # Determine the action to move towards the target based on current direction and deltas\n    if dx == 1:  # Move RIGHT\n      return craft.RIGHT if current_dir != 2 else craft.USE\n    elif dx == -1:  # Move LEFT\n      return craft.LEFT if current_dir != 0 else craft.USE\n    elif dy == 1:  # Move DOWN\n      return craft.DOWN if current_dir != 3 else craft.USE\n    elif dy == -1:  # Move UP\n      return craft.UP if current_dir != 1 else craft.USE\n\n  index = env.world.cookbook.index[primitive]\n\n  # Get the current position and direction of the agent\n  pos_x, pos_y = env._current_state.pos\n  dir = env._current_state.dir\n\n  # Find all positions in the grid that contain the desired primitive\n  target_positions = np.argwhere(env._current_state.grid[:, :, index] == 1)\n\n  if len(target_positions) == 0:\n    return []  # No targets found, no actions to take\n\n  # Calculate Manhattan distances from the agent's position to each target\n  distances = [(abs(pos_x - tx), abs(pos_y - ty)) for tx, ty in target_positions]\n  distances = [sum(d) for d in distances]\n\n  # Find the closest target position\n  min_distance_index = np.argmin(distances)\n  closest_target_pos = tuple(target_positions[min_distance_index])\n\n  def find_path(start, goal):\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]  # RIGHT, DOWN, LEFT, UP\n    queue = collections.deque([start])\n    came_from = {start: None}\n    \n    while queue:\n      current = queue.popleft()\n      \n      if current == goal:\n        break\n      \n      for direction in directions:\n        next_pos = tuple(np.add(current, direction))\n        \n        # Check if the next position is within bounds and not blocked\n        grid_at_next_pos = env._current_state.grid[next_pos[0], next_pos[1]]\n        \n        # Ensure that the next position does not contain any non-traversable elements\n        if 0 <= next_pos[0] < env._current_state.grid.shape[0] and\\\n           0 <= next_pos[1] < env._current_state.grid.shape[1]:\n          if np.all(grid_at_next_pos == 0):\n            if next_pos not in came_from:\n              queue.append(next_pos)\n              came_from[next_pos] = current\n    \n    # Reconstruct the path from start to goal\n    path = []\n    while current != start:\n      path.append(current)\n      current = came_from[current]\n    path.reverse()\n    \n    return path\n\n  path = find_path((pos_x, pos_y), closest_target_pos)\n  actions = []\n\n  for i in range(len(path) - 1):\n    current_pos = path[i]\n    next_pos = path[i + 1]\n\n    delta_x = next_pos[0] - current_pos[0]\n    delta_y = next_pos[1] - current_pos[1]\n    \n    action = get_move_action(dir, delta_x, delta_y)\n    actions.append(action)\n\n    # Update the agent's direction\n    if action in [craft.RIGHT, craft.LEFT, craft.UP, craft.DOWN]:\n      dir = {craft.RIGHT: 2, craft.LEFT: 0, craft.DOWN: 3, craft.UP: 1}[action]\n    \n    # If we are at the target position, use the action to collect the primitive\n    if i == len(path) - 2:\n      actions.append(craft.USE)\n\n  return actions", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-09-26T01:06:56.742083", "function_name": "collect", "function_body": "  def get_available_tools(state):\n    # This function should return a dictionary of tools available in the inventory\n    tool_dict = {\n      'AXE': state.inventory.get('AXE', 0),\n      'KNIFE': state.inventory.get('KNIFE', 0)\n    }\n    return tool_dict\n\n  index = env.world.cookbook.index[primitive]\n\n  # Get the current position and direction of the agent\n  pos_x, pos_y = env._current_state.pos\n  dir = env._current_state.dir\n\n  # Find all positions in the grid that contain the desired primitive\n  target_positions = np.argwhere(env._current_state.grid[:, :, index] == 1)\n\n  if len(target_positions) == 0:\n    return []  # No targets found, no actions to take\n\n  def find_closest_target(start):\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]  # RIGHT, DOWN, LEFT, UP\n    queue = collections.deque([start])\n    came_from = {start: None}\n    closest_target = None\n    \n    while queue:\n      current = queue.popleft()\n      \n      if env._current_state.grid[current[0], current[1], index] == 1:\n        closest_target = current\n        break\n      \n      for direction in directions:\n        next_pos = tuple(np.add(current, direction))\n        \n        # Check if the next position is within bounds and not blocked\n        if 0 <= next_pos[0] < env._current_state.grid.shape[0] and\\\n           0 <= next_pos[1] < env._current_state.grid.shape[1]:\n          if np.all(env._current_state.grid[next_pos[0], next_pos[1]] == 0):\n            if next_pos not in came_from:\n              queue.append(next_pos)\n              came_from[next_pos] = current\n    \n    return closest_target\n\n  def get_direction_to_target(current_dir, dx, dy):\n    if dx == 1:  # Move RIGHT\n      return craft.RIGHT if current_dir != 2 else craft.USE\n    elif dx == -1:  # Move LEFT\n      return craft.LEFT if current_dir != 0 else craft.USE\n    elif dy == 1:  # Move DOWN\n      return craft.DOWN if current_dir != 3 else craft.USE\n    elif dy == -1:  # Move UP\n      return craft.UP if current_dir != 1 else craft.USE\n\n  closest_target_pos = find_closest_target((pos_x, pos_y))\n\n  if closest_target_pos is None:\n    return []  # No reachable target found, no actions to take\n\n  path = find_path((pos_x, pos_y), closest_target_pos)\n  actions = []\n\n  for i in range(len(path) - 1):\n    current_pos = path[i]\n    next_pos = path[i + 1]\n\n    delta_x = next_pos[0] - current_pos[0]\n    delta_y = next_pos[1] - current_pos[1]\n    \n    action = get_direction_to_target(dir, delta_x, delta_y)\n    actions.append(action)\n\n    # Update the agent's direction\n    if action in [craft.RIGHT, craft.LEFT, craft.UP, craft.DOWN]:\n      dir = {craft.RIGHT: 2, craft.LEFT: 0, craft.DOWN: 3, craft.UP: 1}[action]\n    \n    # If we are at the target position, use the action to collect the primitive\n    if i == len(path) - 2:\n      actions.append(craft.USE)\n\n  return actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-09-26T01:08:00.319056", "function_name": "collect", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Get the index of the target primitive\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Helper function to check if a cell is blocked by obstacles other than the primitive itself\n  def is_blocked(x, y):\n    return any(env._current_state.grid[x, y] > 0) and env._current_state.grid[x, y][primitive_index] == 0\n\n  # Directions and their corresponding actions\n  directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n  action_map = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, \n                (0, -1): craft.DOWN, (0, 1): craft.UP}\n\n  # Get indices of tools in the inventory\n  tool_indices = set()\n  for tool_name in ['AXE', 'KNIFE', 'HAMMER']:\n    if tool_name in env.world.cookbook.index:\n      tool_indices.add(env.world.cookbook.index[tool_name])\n\n  # BFS to find the shortest path to a cell containing the primitive\n  start_x, start_y = env._current_state.pos\n  visited = set()\n  queue = deque([(start_x, start_y, [])])  # (x, y, path)\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    if (x, y) in visited:\n      continue\n\n    visited.add((x, y))\n\n    for dx, dy in directions:\n      nx, ny = x + dx, y + dy\n      \n      # Check bounds\n      if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n        # If the cell contains the primitive, return the path to it\n        if env._current_state.grid[nx, ny][primitive_index] > 0:\n          move_action = action_map[(dx, dy)]\n          use_action = craft.USE\n          return path + [move_action, use_action]\n        \n        # If the cell is blocked by an obstacle and has a tool to break it, add to queue with USE action\n        if is_blocked(nx, ny) and any(env._current_state.inventory[tool_index] > 0 for tool_index in tool_indices):\n          move_action = action_map[(dx, dy)]\n          use_action = craft.USE\n          queue.append((nx, ny, path + [move_action, use_action]))\n        \n        # If the cell is not blocked and hasn't been visited, add to queue\n        elif not is_blocked(nx, ny):\n          move_action = action_map[(dx, dy)]\n          queue.append((nx, ny, path + [move_action]))\n  \n  return []  # Return an empty list if no path found", "island_id": 4, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T01:08:01.363223", "function_name": "collect", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Get the index of the target primitive\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Helper function to check if a cell is blocked by obstacles other than the primitive itself\n  def is_blocked(x, y):\n    for i in range(len(env._current_state.grid[x, y])):\n      if i != primitive_index and env._current_state.grid[x, y][i] > 0:\n        return True\n    return False\n\n  # Directions and their corresponding actions\n  directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n  action_map = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, \n                (0, -1): craft.DOWN, (0, 1): craft.UP}\n\n  # BFS to find the shortest path to a cell containing the primitive\n  start_x, start_y = env._current_state.pos\n  visited = set()\n  queue = deque([(start_x, start_y, [])])  # (x, y, path)\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    if (x, y) in visited:\n      continue\n\n    visited.add((x, y))\n\n    for dx, dy in directions:\n      nx, ny = x + dx, y + dy\n      \n      # Check bounds\n      if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n        # If the cell contains the primitive, return the path to it\n        if env._current_state.grid[nx, ny][primitive_index] > 0:\n          move_action = action_map[(dx, dy)]\n          use_action = craft.USE\n          return path + [move_action, use_action]\n        \n        # If the cell is not blocked and hasn't been visited, add to queue\n        if not is_blocked(nx, ny):\n          move_action = action_map[(dx, dy)]\n          queue.append((nx, ny, path + [move_action]))\n  \n  return []  # Return an empty list if no path found", "island_id": 4, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T01:09:12.633650", "function_name": "collect", "function_body": "  def get_primitive_index(primitive_name):\n    try:\n      return env.world.cookbook.index[primitive_name]\n    except KeyError:\n      raise ValueError(f\"Primitive {primitive_name} not found in cookbook.\")\n\n  def is_blocked(x, y):\n    for kind_index in env.world.non_grabbable_indices:\n      if env._current_state.grid[x, y, kind_index] > 0 and kind_index != env.world.cookbook.index['WORKSHOP0'] and kind_index != env.world.cookbook.index['WORKSHOP1'] and kind_index != env.world.cookbook.index['WORKSHOP2']:\n        return True\n    return False\n\n  # Determine the target primitive index from its name\n  target_primitive_index = get_primitive_index(primitive)\n\n  # Initialize an empty list to store the actions needed\n  actions_to_take = []\n\n  # Current position of the agent\n  current_x, current_y = env._current_state.pos\n\n  # Get the grid dimensions\n  width, height, _ = env._current_state.grid.shape\n\n  # Use BFS to find the shortest path to the target primitive\n  queue = collections.deque([(current_x, current_y, actions_to_take)])\n  visited = set()\n  visited.add((current_x, current_y))\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    # Check if we are next to a cell containing the target primitive\n    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n      nx, ny = x + dx, y + dy\n\n      # Ensure within bounds and not visited\n      if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n        if env._current_state.grid[nx, ny, target_primitive_index] > 0:\n          # Move to the adjacent cell containing the primitive\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          actions_to_take.extend(path + [move_action])\n\n          # Collect the primitive\n          actions_to_take.append(craft.USE)\n          return actions_to_take\n\n        # Mark as visited and add to queue if not blocked\n        if not is_blocked(nx, ny):\n          visited.add((nx, ny))\n          new_path = path.copy()\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          new_path.append(move_action)\n          queue.append((nx, ny, new_path))\n\n  # If no path is found, return an empty list of actions\n  return []", "island_id": 6, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T01:09:13.610442", "function_name": "collect", "function_body": "  def get_primitive_index(primitive_name):\n      try:\n          return env.world.cookbook.index[primitive_name]\n      except KeyError:\n          raise ValueError(f\"Primitive {primitive_name} not found in cookbook.\")\n\n  def is_blocked(x, y, inventory_tools=None):\n    for kind_index in env.world.non_grabbable_indices:\n      if env._current_state.grid[x, y, kind_index] > 0 and (inventory_tools is None or kind_index not in inventory_tools):\n        return True\n    return False\n\n  # Determine the target primitive index from its name\n  target_primitive_index = get_primitive_index(primitive)\n\n  # Initialize an empty list to store the actions needed\n  actions_to_take = []\n\n  # Current position of the agent\n  current_x, current_y = env._current_state.pos\n\n  # Get the grid dimensions\n  width, height, _ = env._current_state.grid.shape\n\n  # Use BFS to find the shortest path to the target primitive\n  queue = collections.deque([(current_x, current_y, actions_to_take)])\n  visited = set()\n  visited.add((current_x, current_y))\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    # Check if we are next to a cell containing the target primitive\n    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n      nx, ny = x + dx, y + dy\n\n      # Ensure within bounds and not visited\n      if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n        if env._current_state.grid[nx, ny, target_primitive_index] > 0:\n          # Move to the adjacent cell containing the primitive\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          actions_to_take.extend(path + [move_action])\n\n          # Collect the primitive\n          actions_to_take.append(craft.USE)\n          return actions_to_take\n\n        # Mark as visited and add to queue if not blocked\n        inventory_tools = {env.world.cookbook.index[tool]: 1 for tool in env._current_state.inventory.keys()}\n        if not is_blocked(nx, ny, inventory_tools):\n          visited.add((nx, ny))\n          new_path = path.copy()\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          new_path.append(move_action)\n          queue.append((nx, ny, new_path))\n\n  # If no path is found, return an empty list of actions\n  return []", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-26T01:10:54.431222", "function_name": "collect", "function_body": "  def get_available_tools(state):\n    tools = {}\n    for tool_index in state.inventory.nonzero()[0]:\n      tool_name = env.world.cookbook.index.get(tool_index)\n      if tool_name:\n        tools[tool_index] = state.inventory[tool_index]\n    return tools\n\n  def find_path(start, goal):\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]  \n    queue = collections.deque([start])\n    came_from = {start: None}\n    \n    while queue:\n      current = queue.popleft()\n      \n      if current == goal:\n        break\n      \n      for direction in directions:\n        next_pos = tuple(np.add(current, direction))\n        \n        # Check if the next position is within bounds and not blocked\n        grid_val = env._current_state.grid[next_pos[0], next_pos[1]]\n        if 0 <= next_pos[0] < env._current_state.grid.shape[0] and\\\n           0 <= next_pos[1] < env._current_state.grid.shape[1]:\n          # Check for obstacles using the environment's grid\n          if np.all(grid_val == 0):\n            if next_pos not in came_from:\n              queue.append(next_pos)\n              came_from[next_pos] = current\n    \n    # Reconstruct the path from start to goal\n    path = []\n    while current != start:\n      path.append(current)\n      current = came_from[current]\n    path.reverse()\n    \n    return path\n\n  def turn_to_direction(current_dir, target_dir):\n    # Define the direction mapping: RIGHT=2, DOWN=3, LEFT=0, UP=1\n    direction_mapping = {2: 'RIGHT', 3: 'DOWN', 0: 'LEFT', 1: 'UP'}\n    \n    current_dir_str = direction_mapping[current_dir]\n    target_dir_str = direction_mapping[target_dir]\n\n    # Calculate the number of turns needed\n    if current_dir_str == target_dir_str:\n      return []\n    elif (current_dir_str, target_dir_str) in [('RIGHT', 'DOWN'), ('DOWN', 'LEFT'), ('LEFT', 'UP'), ('UP', 'RIGHT')]:\n      return [craft.RIGHT]\n    elif (current_dir_str, target_dir_str) in [('RIGHT', 'UP'), ('UP', 'LEFT'), ('LEFT', 'DOWN'), ('DOWN', 'RIGHT')]:\n      return [craft.LEFT]\n    else:\n      # Turn 180 degrees\n      return [craft.RIGHT, craft.RIGHT]\n\n  def get_direction_to_target(current_pos, next_pos):\n    delta_x = next_pos[0] - current_pos[0]\n    delta_y = next_pos[1] - current_pos[1]\n\n    if delta_x > 0:\n      return craft.RIGHT\n    elif delta_x < 0:\n      return craft.LEFT\n    elif delta_y > 0:\n      return craft.DOWN\n    elif delta_y < 0:\n      return craft.UP\n\n  index = env.world.cookbook.index[primitive]\n  pos_x, pos_y = env._current_state.pos\n  dir = env._current_state.dir\n\n  target_positions = np.argwhere(env._current_state.grid[:, :, index] == 1)\n\n  if len(target_positions) == 0:\n    return []\n\n  distances = [(pos_x - tx, pos_y - ty) for tx, ty in target_positions]\n  distances = [abs(dx) + abs(dy) for dx, dy in distances]\n\n  min_distance_index = np.argmin(distances)\n  closest_target_pos = tuple(target_positions[min_distance_index])\n\n  path = find_path((pos_x, pos_y), closest_target_pos)\n  actions = []\n\n  if not path:\n    return [craft.USE]  # Try to collect what's directly under the agent\n\n  for i in range(len(path)):\n    current_pos = path[i]\n    \n    if i + 1 < len(path):\n      next_pos = path[i + 1]\n    else:\n      # If we are at the last position, target is reached\n      break\n\n    action = get_direction_to_target(current_pos, next_pos)\n    actions.extend(turn_to_direction(dir, action))\n    \n    # Update the agent's direction\n    dir = action\n    \n    # Move in the correct direction\n    actions.append(action)\n\n    # If we are at the last position in the path, use the action to collect the primitive\n    if i == len(path) - 1:\n      actions.append(craft.USE)\n\n  return actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-09-26T01:10:55.506839", "function_name": "collect", "function_body": "  def get_available_tools(state):\n    tools = {}\n    for tool_index in state.inventory.nonzero()[0]:\n      tool_name = env.world.cookbook.index.get(tool_index)\n      if tool_name:\n        tools[tool_index] = state.inventory[tool_index]\n    return tools\n\n  def find_path(start, goal):\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]  \n    queue = collections.deque([start])\n    came_from = {start: None}\n    \n    while queue:\n      current = queue.popleft()\n      \n      if current == goal:\n        break\n      \n      for direction in directions:\n        next_pos = tuple(np.add(current, direction))\n        \n        # Check if the next position is within bounds and not blocked\n        grid_val = env._current_state.grid[next_pos[0], next_pos[1]]\n        if 0 <= next_pos[0] < env._current_state.grid.shape[0] and\\\n           0 <= next_pos[1] < env._current_state.grid.shape[1]:\n          # Check for obstacles using the environment's grid\n          if np.all(grid_val == 0):\n            if next_pos not in came_from:\n              queue.append(next_pos)\n              came_from[next_pos] = current\n    \n    # Reconstruct the path from start to goal\n    path = []\n    while current != start:\n      path.append(current)\n      current = came_from[current]\n    path.reverse()\n    \n    return path\n\n  def get_direction_to_target(current_dir, dx, dy):\n    if dx == 1:  \n      return craft.RIGHT\n    elif dx == -1:  \n      return craft.LEFT\n    elif dy == 1:  \n      return craft.DOWN\n    elif dy == -1:  \n      return craft.UP\n\n  def turn_to_direction(current_dir, target_dir):\n    direction_mapping = {craft.RIGHT: 2, craft.DOWN: 3, craft.LEFT: 0, craft.UP: 1}\n    \n    current_dir_str = direction_mapping[current_dir]\n    target_dir_str = direction_mapping[target_dir]\n\n    if current_dir_str == target_dir_str:\n      return []\n    elif (current_dir_str, target_dir_str) in [('RIGHT', 'DOWN'), ('DOWN', 'LEFT'), ('LEFT', 'UP'), ('UP', 'RIGHT')]:\n      return [craft.RIGHT]\n    elif (current_dir_str, target_dir_str) in [('RIGHT', 'UP'), ('UP', 'LEFT'), ('LEFT', 'DOWN'), ('DOWN', 'RIGHT')]:\n      return [craft.LEFT]\n    else:\n      # Turn 180 degrees\n      return [craft.RIGHT, craft.RIGHT]\n\n  index = env.world.cookbook.index[primitive]\n  pos_x, pos_y = env._current_state.pos\n  dir = env._current_state.dir\n\n  target_positions = np.argwhere(env._current_state.grid[:, :, index] == 1)\n\n  if len(target_positions) == 0:\n    return []\n\n  distances = [(pos_x - tx, pos_y - ty) for tx, ty in target_positions]\n  distances = [abs(dx) + abs(dy) for dx, dy in distances]\n\n  min_distance_index = np.argmin(distances)\n  closest_target_pos = tuple(target_positions[min_distance_index])\n\n  path = find_path((pos_x, pos_y), closest_target_pos)\n  actions = []\n\n  if not path:\n    return [craft.USE]  # Try to collect what's directly under the agent\n\n  for i in range(len(path)):\n    current_pos = path[i]\n    \n    if i + 1 < len(path):\n      next_pos = path[i + 1]\n    else:\n      break\n    \n    delta_x = next_pos[0] - current_pos[0]\n    delta_y = next_pos[1] - current_pos[1]\n    \n    action = get_direction_to_target(dir, delta_x, delta_y)\n    actions.extend(turn_to_direction(dir, action))\n    actions.append(action)\n\n    # Update the agent's direction\n    dir = action\n\n  # Collect the primitive at the last position\n  actions.append(craft.USE)\n\n  return actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-09-26T01:12:05.278978", "function_name": "collect", "function_body": "  def _find_shortest_path(grid, start_pos, target_kind, inventory):\n    width, height = grid.shape[:2]\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n      \n      if grid[x, y].argmax() == target_kind and (x, y) != start_pos:\n        return path\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          current_cell = grid[nx, ny].argmax()\n          if current_cell == target_kind or grid[nx, ny].sum() == 1:  # Allow moving through empty cells\n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))\n          elif inventory[current_cell] > 0:  # Allow moving through obstacles if tool is available\n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))\n    \n    return None\n\n  def _get_action_index_from_direction(direction):\n    mapping = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, (0, -1): craft.DOWN, (0, 1): craft.UP}\n    return mapping.get(direction)\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  inventory = current_state.inventory\n  \n  primitive_index = current_state.world.cookbook.index.index(primitive)\n  \n  path_to_primitive = _find_shortest_path(grid, pos, primitive_index, inventory)\n  \n  if not path_to_primitive:\n    return []\n  \n  actions = [_get_action_index_from_direction(step) for step in path_to_primitive]\n  actions.append(craft.USE)  # Add action to collect the primitive\n  \n  return actions", "island_id": 8, "scores": {"3": 2.5}}
{"timestamp": "2025-09-26T01:12:06.268491", "function_name": "collect", "function_body": "  def _find_shortest_path(grid, start_pos, target_kind):\n    width, height = grid.shape[:2]\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n      \n      if grid[x, y].argmax() == target_kind and (x, y) != start_pos:\n        return path\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          if grid[nx, ny].sum() == 1:  # Allow moving through empty cells\n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))\n          else:\n            tool_index = grid[nx, ny].argmax()\n            if inventory[tool_index] > 0 and (nx, ny) not in visited:  # Allow moving through obstacles if tool is available\n              visited.add((nx, ny))\n              queue.append((nx, ny, path + [(dx, dy)]))\n    \n    return None\n\n  def _get_action_index_from_direction(direction):\n    mapping = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, (0, -1): craft.DOWN, (0, 1): craft.UP}\n    return mapping.get(direction)\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  inventory = current_state.inventory\n  \n  primitive_index = current_state.world.cookbook.index.index(primitive)\n  \n  # Prioritize the use of available tools to break through obstacles\n  prioritized_tools = {\n    craft.WATER: craft.BUCKET,\n    craft.STONE: craft.PICKAXE,\n    craft.ROCK: craft.HAMMER,\n    craft.GOLD: craft.GEMSTONE_TOOL,\n    craft.GEM: craft.GEMSTONE_TOOL,\n  }\n  \n  def _can_use_tool(target_kind, inventory):\n    for tool in prioritized_tools:\n      if target_kind == current_state.world.cookbook.index.index(tool) and inventory[prioritized_tools[tool]] > 0:\n        return True\n    return False\n  \n  path_to_primitive = None\n  while not path_to_primitive:\n    # Try to find a path without using tools first\n    path_to_primitive = _find_shortest_path(grid, pos, primitive_index)\n    \n    if not path_to_primitive:\n      # If no path is found, try to use available tools to break through obstacles\n      for x in range(width):\n        for y in range(height):\n          target_kind = grid[x, y].argmax()\n          if _can_use_tool(target_kind, inventory) and (x, y) not in visited:\n            # Simulate using the tool on the obstacle\n            grid[x, y] = np.zeros_like(grid[x, y])\n            grid[x, y][craft.EMPTY] = 1\n            break\n      else:\n        # If no obstacles can be removed, return an empty path\n        return []\n  \n  actions = [_get_action_index_from_direction(step) for step in path_to_primitive]\n  actions.append(craft.USE)  # Add action to collect the primitive\n  \n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-26T01:13:01.706347", "function_name": "collect", "function_body": "  def _find_shortest_path(grid, start_pos, target_kind, inventory):\n    width, height = grid.shape[:2]\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n      \n      if grid[x, y].argmax() == target_kind and (x, y) != start_pos:\n        return path\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          can_move = True\n          \n          # Check if there are obstacles and if the agent has tools to clear them\n          for tool in inventory:\n            if grid[nx, ny][tool]:\n              can_move = False\n              break\n          \n          if can_move or grid[nx, ny].sum() == 1:\n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))\n    \n    return None\n\n  def _get_action_index_from_direction(direction):\n    mapping = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, (0, -1): craft.DOWN, (0, 1): craft.UP}\n    return mapping.get(direction)\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  inventory = [i for i in range(len(current_state.inventory)) if current_state.inventory[i] > 0]\n  \n  primitive_index = current_state.world.cookbook.index.index(primitive)\n  \n  path_to_primitive = _find_shortest_path(grid, pos, primitive_index, inventory)\n  \n  if not path_to_primitive:\n    return []\n  \n  actions = [_get_action_index_from_direction(step) for step in path_to_primitive]\n  actions.append(craft.USE)  # Add action to collect the primitive\n  \n  return actions", "island_id": 5, "scores": {"3": 4.0}}
