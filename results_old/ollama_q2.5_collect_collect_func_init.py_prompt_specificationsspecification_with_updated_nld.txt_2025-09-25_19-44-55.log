ition to each target\n  distances = [(abs(pos_x - tx) + abs(pos_y - ty), (tx, ty)) for tx, ty in target_positions]\n  closest_target_pos = min(distances)[1]\n\n  path = find_path((pos_x, pos_y), closest_target_pos)\n  actions = []\n\n  for i in range(len(path) - 1):\n    current_pos = path[i]\n    next_pos = path[i + 1]\n\n    delta_x = next_pos[0] - current_pos[0]\n    delta_y = next_pos[1] - current_pos[1]\n    \n    action = get_direction_to_target(dir, delta_x, delta_y)\n    actions.append(action)\n\n    # Update the agent's direction\n    if action in [craft.RIGHT, craft.LEFT, craft.UP, craft.DOWN]:\n      dir = {craft.RIGHT: 2, craft.LEFT: 0, craft.DOWN: 3, craft.UP: 1}[action]\n    \n    # If we are at the target position, use the action to collect the primitive\n    if i == len(path) - 2:\n      actions.append(craft.USE)\n\n  return actions", "island_id": 0, "scores": {"3": 1.5}}
