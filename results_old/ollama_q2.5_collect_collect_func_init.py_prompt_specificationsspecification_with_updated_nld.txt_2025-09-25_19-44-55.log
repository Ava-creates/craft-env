{"timestamp": "2025-09-26T03:39:55.802075", "function_name": "collect", "function_body": "  def _find_shortest_path(grid, start_pos, target_kind):\n    width, height = grid.shape[:2]\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n      \n      if grid[x, y].argmax() == target_kind and (x, y) != start_pos:\n        return path\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          current_cell_index = grid[nx, ny].argmax()\n          \n          # Allow moving through empty cells or clearing obstacles with tools\n          if grid[nx, ny].sum() == 1 or inventory[current_cell_index] > 0:\n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))\n    \n    return None\n\n  def _get_action_index_from_direction(direction):\n    mapping = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, (0, -1): craft.DOWN, (0, 1): craft.UP}\n    return mapping.get(direction)\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  inventory = current_state.inventory\n  \n  primitive_index = current_state.world.cookbook.index.index(primitive)\n  \n  path_to_primitive = _find_shortest_path(grid, pos, primitive_index)\n  \n  if not path_to_primitive:\n    return []\n  \n  actions = [_get_action_index_from_direction(step) for step in path_to_primitive]\n  actions.append(craft.USE)  # Add action to collect the primitive\n  \n  return actions", "island_id": 8, "scores": {"3": 2.5}}
{"timestamp": "2025-09-26T03:39:56.858892", "function_name": "collect", "function_body": "  def _find_shortest_path(grid, start_pos, target_kind):\n    width, height = grid.shape[:2]\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n      \n      if grid[x, y].argmax() == target_kind and (x, y) != start_pos:\n        return path\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          # Check if the cell is passable or can be cleared with a tool\n          current_cell_index = grid[nx, ny].argmax()\n          if grid[nx, ny].sum() == 1 or inventory[current_cell_index] > 0: \n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))\n    \n    return None\n\n  def _get_action_index_from_direction(direction):\n    mapping = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, (0, -1): craft.DOWN, (0, 1): craft.UP}\n    return mapping.get(direction)\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  inventory = current_state.inventory\n  \n  primitive_index = current_state.world.cookbook.index.index(primitive)\n  \n  path_to_primitive = _find_shortest_path(grid, pos, primitive_index)\n  \n  if not path_to_primitive:\n    return []\n  \n  actions = [_get_action_index_from_direction(step) for step in path_to_primitive]\n  actions.append(craft.USE)  # Add action to collect the primitive\n  \n  return actions", "island_id": 8, "scores": {"3": 2.5}}
{"timestamp": "2025-09-26T03:40:55.655477", "function_name": "collect", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Get the index of the target primitive and the agent's current position\n  primitive_index = env.world.cookbook.index[primitive]\n  start_x, start_y = env._current_state.pos\n\n  # Directions and their corresponding actions\n  directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n  action_map = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, \n                (0, -1): craft.DOWN, (0, 1): craft.UP}\n\n  # Helper function to check if a cell is blocked by obstacles other than the primitive itself\n  def is_blocked(x, y):\n    return any(env._current_state.grid[x, y][i] > 0 for i in range(len(env._current_state.grid[x, y]))\n               if i != primitive_index)\n\n  # BFS to find the shortest path to a cell containing the primitive\n  visited = set()\n  queue = deque([(start_x, start_y, [])])  # (x, y, path)\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    if (x, y) in visited:\n      continue\n\n    visited.add((x, y))\n\n    for dx, dy in directions:\n      nx, ny = x + dx, y + dy\n      \n      # Check bounds\n      if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n        # If the cell contains the primitive, return the path to it\n        if env._current_state.grid[nx, ny][primitive_index] > 0:\n          move_action = action_map[(dx, dy)]\n          use_action = craft.USE\n          return path + [move_action, use_action]\n        \n        # If the cell is not blocked and hasn't been visited, add to queue\n        if not is_blocked(nx, ny):\n          move_action = action_map[(dx, dy)]\n          queue.append((nx, ny, path + [move_action]))\n\n  return []  # Return an empty list if no path found", "island_id": 4, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T03:40:56.711022", "function_name": "collect", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Get the index of the target primitive and the agent's current position\n  primitive_index = env.world.cookbook.index[primitive]\n  start_x, start_y = env._current_state.pos\n\n  # Directions and their corresponding actions\n  directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n  action_map = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, \n                (0, -1): craft.DOWN, (0, 1): craft.UP}\n\n  # Helper function to check if a cell is blocked by obstacles other than the primitive itself\n  def is_blocked(x, y):\n    workshop_indices = [\n        env.world.cookbook.index['WORKSHOP0'],\n        env.world.cookbook.index['WORKSHOP1'],\n        env.world.cookbook.index['WORKSHOP2']\n    ]\n    return any(env._current_state.grid[x, y][i] > 0 for i in range(len(env._current_state.grid[x, y]))\n               if i != primitive_index and i not in workshop_indices)\n\n  # BFS to find the shortest path to a cell containing the primitive\n  visited = set()\n  queue = deque([(start_x, start_y, [])])  # (x, y, path)\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    if (x, y) in visited:\n      continue\n\n    visited.add((x, y))\n\n    for dx, dy in directions:\n      nx, ny = x + dx, y + dy\n      \n      # Check bounds\n      if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n        # If the cell contains the primitive, return the path to it\n        if env._current_state.grid[nx, ny][primitive_index] > 0:\n          move_action = action_map[(dx, dy)]\n          use_action = craft.USE\n          return path + [move_action, use_action]\n        \n        # If the cell is not blocked and hasn't been visited, add to queue\n        if not is_blocked(nx, ny):\n          move_action = action_map[(dx, dy)]\n          queue.append((nx, ny, path + [move_action]))\n\n  return []  # Return an empty list if no path found", "island_id": 4, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T03:42:05.436419", "function_name": "collect", "function_body": "  actions = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  # Helper function to find neighboring positions.\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  # Get the current state of the environment.\n  current_state = env._current_state\n\n  # Define a queue for BFS and a set to track visited positions.\n  queue = collections.deque([(current_state.pos, [], current_state.dir)])\n  visited = set()\n\n  # Helper function to get the index of a primitive name.\n  def get_primitive_index(primitive_name):\n      return current_state.world.cookbook.index[primitive_name]\n\n  # Get the index for the target primitive.\n  target_primitive_index = get_primitive_index(primitive)\n\n  while queue:\n      pos, actions_taken, direction = queue.popleft()\n\n      if (pos, direction) in visited:\n          continue\n      visited.add((pos, direction))\n\n      # Check if we are at a cell with the desired primitive.\n      if current_state.grid[pos[0], pos[1], target_primitive_index] > 0:\n          return actions_taken + [actions[\"USE\"]]\n\n      neighbors = get_neighbors(pos)\n      for neighbor in neighbors:\n          nx, ny = neighbor\n\n          # Ensure the neighbor is within bounds.\n          if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n              # Check if the cell is not blocked by non-grabbable entities.\n              if all(current_state.grid[ny, nx, env_index] == 0 for env_index in current_state.world.non_grabbable_indices):\n                  # Determine the direction to move towards the neighbor.\n                  dx, dy = nx - pos[0], ny - pos[1]\n                  if dx == 1:\n                      action = actions[\"RIGHT\"]\n                      new_direction = 3\n                  elif dx == -1:\n                      action = actions[\"LEFT\"]\n                      new_direction = 2\n                  elif dy == 1:\n                      action = actions[\"DOWN\"]\n                      new_direction = 0\n                  else:  # dy == -1\n                      action = actions[\"UP\"]\n                      new_direction = 1\n\n                  if direction != new_direction:\n                      queue.append((pos, actions_taken + [action], new_direction))\n                  else:\n                      if current_state.grid[ny, nx, target_primitive_index] > 0:\n                          return actions_taken + [actions[\"USE\"]]\n                      queue.append((neighbor, actions_taken + [action], new_direction))\n\n  return []", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-09-26T03:42:06.540001", "function_name": "collect", "function_body": "  actions = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  # Helper function to find neighboring positions.\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  # Get the current state of the environment.\n  current_state = env._current_state\n\n  # Define a queue for BFS and a set to track visited positions.\n  queue = collections.deque([(current_state.pos, [], current_state.dir)])\n  visited = set()\n\n  # Helper function to get the index of a primitive name.\n  def get_primitive_index(primitive_name):\n      return current_state.world.cookbook.index[primitive_name]\n\n  # Get the index for the target primitive.\n  target_primitive_index = get_primitive_index(primitive)\n\n  while queue:\n      pos, actions_taken, direction = queue.popleft()\n\n      if (pos, direction) in visited:\n          continue\n      visited.add((pos, direction))\n\n      # Check if we are at a cell with the desired primitive.\n      if current_state.grid[pos[0], pos[1], target_primitive_index] > 0:\n          return actions_taken + [actions[\"USE\"]]\n\n      neighbors = get_neighbors(pos)\n      for neighbor in neighbors:\n          nx, ny = neighbor\n\n          # Ensure the neighbor is within bounds.\n          if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n              # Check if the cell is not blocked by non-grabbable entities.\n              if all(current_state.grid[ny, nx, env_index] == 0 for env_index in current_state.world.non_grabbable_indices):\n                  # Determine the direction to move towards the neighbor.\n                  dx, dy = nx - pos[0], ny - pos[1]\n                  if dx == 1:\n                      action = actions[\"RIGHT\"]\n                      new_direction = 3\n                  elif dx == -1:\n                      action = actions[\"LEFT\"]\n                      new_direction = 2\n                  elif dy == 1:\n                      action = actions[\"DOWN\"]\n                      new_direction = 0\n                  else:  # dy == -1\n                      action = actions[\"UP\"]\n                      new_direction = 1\n\n                  if direction != new_direction:\n                      queue.append((pos, actions_taken + [action], new_direction))\n                  elif current_state.grid[ny, nx, target_primitive_index] > 0:\n                      return actions_taken + [action, actions[\"USE\"]]\n                  else:\n                      queue.append((neighbor, actions_taken + [action], new_direction))\n\n  return []", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-09-26T03:43:04.784015", "function_name": "collect", "function_body": "  def _find_shortest_path(grid, start_pos, target_kind, inventory):\n    width, height = grid.shape[:2]\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n      \n      if grid[x, y].argmax() == target_kind and (x, y) != start_pos:\n        return path\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          can_move = True\n          \n          # Check if there are obstacles and if the agent has tools to clear them\n          for tool in inventory:\n            if grid[nx, ny][tool]:\n              can_move = False\n              break\n          \n          if can_move or grid[nx, ny].sum() == 1:\n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))\n    \n    return None\n\n  def _get_action_index_from_direction(direction):\n    mapping = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, (0, -1): craft.DOWN, (0, 1): craft.UP}\n    return mapping.get(direction)\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  inventory = [i for i in range(len(current_state.inventory)) if current_state.inventory[i] > 0]\n  \n  primitive_index = current_state.world.cookbook.index.index(primitive)\n  \n  path_to_primitive = _find_shortest_path(grid, pos, primitive_index, inventory)\n\n  actions = []\n\n  if not path_to_primitive:\n    return actions\n\n  for step in path_to_primitive:\n      action_index = _get_action_index_from_direction(step)\n      if action_index is None:\n          continue\n      actions.append(action_index)\n  \n  # Append the USE action to collect the primitive at the target position\n  actions.append(craft.USE)\n\n  return actions", "island_id": 5, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T03:43:05.829860", "function_name": "collect", "function_body": "  def _find_shortest_path(grid, start_pos, target_kind, inventory):\n    width, height = grid.shape[:2]\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n      \n      if grid[x, y].argmax() == target_kind and (x, y) != start_pos:\n        return path\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          can_move = True\n          \n          # Check if there are obstacles and if the agent has tools to clear them\n          for tool in inventory:\n            if grid[nx, ny][tool]:\n              can_move = False\n              break\n          \n          if can_move or grid[nx, ny].sum() == 1:\n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))\n    \n    return None\n\n  def _get_action_index_from_direction(direction):\n    mapping = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, (0, -1): craft.DOWN, (0, 1): craft.UP}\n    return mapping.get(direction)\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  inventory = [i for i in range(len(current_state.inventory)) if current_state.inventory[i] > 0]\n  \n  primitive_index = current_state.world.cookbook.index.index(primitive)\n  \n  path_to_primitive = _find_shortest_path(grid, pos, primitive_index, inventory)\n\n  actions = []\n  \n  if not path_to_primitive:\n    return []\n\n  for step in path_to_primitive:\n      action_index = _get_action_index_from_direction(step)\n      if action_index is None:\n          continue\n      actions.append(action_index)\n  \n  # Append the USE action to collect the primitive at the target position\n  actions.append(craft.USE)\n\n  return actions", "island_id": 5, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T03:44:10.252827", "function_name": "collect", "function_body": "  def _find_shortest_path(grid, start_pos, target_kind, inventory):\n    width, height = grid.shape[:2]\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n      \n      if grid[x, y].argmax() == target_kind and (x, y) != start_pos:\n        return path\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          can_move = True\n          \n          # Check if there are obstacles and if the agent has tools to clear them\n          for tool in inventory:\n            if grid[nx, ny][tool]:\n              can_move = False\n              break\n          \n          if can_move or grid[nx, ny].sum() == 1:\n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))\n    \n    return None\n\n  def _get_action_index_from_direction(direction):\n    mapping = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, (0, -1): craft.DOWN, (0, 1): craft.UP}\n    return mapping.get(direction)\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  \n  # Convert inventory to dictionary format for easier access\n  inventory_dict = {i: count for i, count in enumerate(current_state.inventory) if count > 0}\n\n  primitive_index = current_state.world.cookbook.index.index(primitive)\n  \n  path_to_primitive = _find_shortest_path(grid, pos, primitive_index, inventory_dict)\n\n  actions = []\n  \n  if not path_to_primitive:\n    return []\n\n  for step in path_to_primitive:\n      action_index = _get_action_index_from_direction(step)\n      if action_index is None:\n          continue\n      actions.append(action_index)\n  \n  # Append the USE action to collect the primitive at the target position\n  actions.append(craft.USE)\n\n  # Check and handle obstacles with available tools in inventory\n  for x, y in visited:\n    cell = grid[x, y]\n    for tool_id, tool_count in inventory_dict.items():\n      if tool_count > 0 and cell[tool_id] > 0:\n          actions.insert(0, _get_action_index_from_direction((start_pos[0] - x, start_pos[1] - y)))\n          actions.insert(1, craft.USE)\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-26T03:44:11.304991", "function_name": "collect", "function_body": "  def _find_shortest_path(grid, start_pos, target_kind, inventory_dict):\n    width, height = grid.shape[:2]\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n      \n      if grid[x, y].argmax() == target_kind and (x, y) != start_pos:\n        return path\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          can_move = True\n          \n          # Check if there are obstacles and if the agent has tools to clear them\n          for tool, count in inventory_dict.items():\n            if grid[nx, ny][tool] and count > 0:\n              can_move = False\n              break\n          \n          if can_move or grid[nx, ny].sum() == 1:\n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))\n    \n    return None\n\n  def _get_action_index_from_direction(direction):\n    mapping = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, (0, -1): craft.DOWN, (0, 1): craft.UP}\n    return mapping.get(direction)\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  \n  # Convert inventory to dictionary format for easier access\n  inventory_dict = {i: count for i, count in enumerate(current_state.inventory) if count > 0}\n\n  primitive_index = current_state.world.cookbook.index.index(primitive)\n  \n  path_to_primitive = _find_shortest_path(grid, pos, primitive_index, inventory_dict)\n\n  actions = []\n  \n  if not path_to_primitive:\n    return []\n\n  for step in path_to_primitive:\n      action_index = _get_action_index_from_direction(step)\n      if action_index is None:\n          continue\n      actions.append(action_index)\n  \n  # Append the USE action to collect the primitive at the target position\n  actions.append(craft.USE)\n\n  return actions", "island_id": 5, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T03:45:44.916438", "function_name": "collect", "function_body": "  index = env.world.cookbook.index[primitive]\n  pos_x, pos_y = env._current_state.pos\n  dir = env._current_state.dir\n\n  target_positions = np.argwhere(env._current_state.grid[:, :, index] == 1)\n\n  if len(target_positions) == 0:\n    return []\n\n  distances = [(abs(pos_x - tx) + abs(pos_y - ty), (tx, ty)) for tx, ty in target_positions]\n  closest_target_pos = min(distances, key=lambda x: x[0])[1]\n\n  def find_path(start, goal):\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([start])\n    came_from = {start: None}\n    \n    while queue:\n      current = queue.popleft()\n      \n      if current == goal:\n        break\n      \n      for direction in directions:\n        next_pos = tuple(np.add(current, direction))\n        \n        # Check if the next position is within bounds and not blocked\n        if 0 <= next_pos[0] < env._current_state.grid.shape[0] and\\\n           0 <= next_pos[1] < env._current_state.grid.shape[1]:\n          if np.all(env._current_state.grid[next_pos[0], next_pos[1]] == 0):\n            if next_pos not in came_from:\n              queue.append(next_pos)\n              came_from[next_pos] = current\n    \n    # Reconstruct the path from start to goal\n    path = []\n    while current != start:\n      path.append(current)\n      current = came_from[current]\n    path.reverse()\n    \n    return path\n\n  def get_direction_to_target(current_dir, dx, dy):\n    if dx > 0:  \n      target_dir = craft.RIGHT\n    elif dx < 0:  \n      target_dir = craft.LEFT\n    elif dy > 0:  \n      target_dir = craft.DOWN\n    elif dy < 0:  \n      target_dir = craft.UP\n    \n    direction_mapping = {craft.RIGHT: 2, craft.DOWN: 3, craft.LEFT: 0, craft.UP: 1}\n    \n    current_dir_str = direction_mapping[current_dir]\n    target_dir_str = direction_mapping[target_dir]\n\n    if current_dir_str == target_dir_str:\n      return []\n    elif (current_dir_str, target_dir_str) in [('RIGHT', 'DOWN'), ('DOWN', 'LEFT'), ('LEFT', 'UP'), ('UP', 'RIGHT')]:\n      return [craft.RIGHT]\n    elif (current_dir_str, target_dir_str) in [('RIGHT', 'UP'), ('UP', 'LEFT'), ('LEFT', 'DOWN'), ('DOWN', 'RIGHT')]:\n      return [craft.LEFT]\n    else:\n      # Turn 180 degrees\n      return [craft.RIGHT, craft.RIGHT]\n\n  path = find_path((pos_x, pos_y), closest_target_pos)\n  actions = []\n\n  for i in range(len(path)):\n    current_pos = path[i]\n\n    if i < len(path) - 1:\n        next_pos = path[i + 1]\n        delta_x = next_pos[0] - current_pos[0]\n        delta_y = next_pos[1] - current_pos[1]\n        \n        turn_actions = get_direction_to_target(dir, delta_x, delta_y)\n        actions.extend(turn_actions)\n\n        # Determine the direction to move\n        action = {craft.RIGHT: 2, craft.LEFT: 0, craft.DOWN: 3, craft.UP: 1}[turn_actions[-1]] if turn_actions else dir\n    else:\n        # If at the target position, use to collect\n        action = craft.USE\n\n    actions.append(action)\n\n    # Update the agent's direction if a movement action was taken\n    if action in [craft.RIGHT, craft.LEFT, craft.UP, craft.DOWN]:\n      dir = {craft.RIGHT: 2, craft.LEFT: 0, craft.DOWN: 3, craft.UP: 1}[action]\n\n  return actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-09-26T03:45:46.024208", "function_name": "collect", "function_body": "  index = env.world.cookbook.index[primitive]\n  pos_x, pos_y = env._current_state.pos\n  dir = env._current_state.dir\n\n  target_positions = np.argwhere(env._current_state.grid[:, :, index] == 1)\n\n  if len(target_positions) == 0:\n    return []\n\n  distances = [(abs(pos_x - tx) + abs(pos_y - ty), (tx, ty)) for tx, ty in target_positions]\n  closest_target_pos = min(distances, key=lambda x: x[0])[1]\n\n  def find_path(start, goal):\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([start])\n    came_from = {start: None}\n    \n    while queue:\n      current = queue.popleft()\n      \n      if current == goal:\n        break\n      \n      for direction in directions:\n        next_pos = tuple(np.add(current, direction))\n        \n        # Check if the next position is within bounds and not blocked\n        if 0 <= next_pos[0] < env._current_state.grid.shape[0] and\\\n           0 <= next_pos[1] < env._current_state.grid.shape[1]:\n          # Allow movement through the target cell since it's what we want to collect\n          if np.all(env._current_state.grid[next_pos[0], next_pos[1]] == 0) or next_pos == goal:\n            if next_pos not in came_from:\n              queue.append(next_pos)\n              came_from[next_pos] = current\n    \n    # Reconstruct the path from start to goal\n    path = []\n    while current != start:\n      path.append(current)\n      current = came_from[current]\n    path.reverse()\n    \n    return path\n\n  def turn_to_direction(current_dir, target_dir):\n    direction_mapping = {2: 'RIGHT', 3: 'DOWN', 0: 'LEFT', 1: 'UP'}\n    turn_actions = {\n        ('RIGHT', 'DOWN'): [craft.RIGHT],\n        ('DOWN', 'LEFT'): [craft.LEFT],\n        ('LEFT', 'UP'): [craft.UP],\n        ('UP', 'RIGHT'): [craft.RIGHT, craft.RIGHT],\n        ('RIGHT', 'UP'): [craft.LEFT],\n        ('UP', 'LEFT'): [craft.LEFT, craft.LEFT],\n        ('LEFT', 'DOWN'): [craft.DOWN],\n        ('DOWN', 'RIGHT'): [craft.RIGHT]\n    }\n    \n    current_dir_str = direction_mapping[current_dir]\n    target_dir_str = direction_mapping[target_dir]\n\n    if current_dir_str == target_dir_str:\n      return []\n    else:\n      return turn_actions[(current_dir_str, target_dir_str)]\n\n  def get_direction_to_target(current_pos, next_pos):\n    delta_x = next_pos[0] - current_pos[0]\n    delta_y = next_pos[1] - current_pos[1]\n\n    if delta_x > 0:  \n        return craft.RIGHT\n    elif delta_x < 0:  \n        return craft.LEFT\n    elif delta_y > 0:  \n        return craft.DOWN\n    elif delta_y < 0:  \n        return craft.UP\n\n  path = find_path((pos_x, pos_y), closest_target_pos)\n  actions = []\n\n  for i in range(len(path) - 1):\n    current_pos = path[i]\n    next_pos = path[i + 1]\n\n    # Determine the direction to move\n    target_dir = get_direction_to_target(current_pos, next_pos)\n\n    # Turn towards the correct direction if necessary\n    actions.extend(turn_to_direction(dir, target_dir))\n\n    # Move in the correct direction\n    actions.append(target_dir)\n    \n    # Update the agent's direction\n    dir = {craft.RIGHT: 2, craft.LEFT: 0, craft.DOWN: 3, craft.UP: 1}[target_dir]\n\n  # Use action to collect the primitive at the final position\n  actions.append(craft.USE)\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-26T03:47:18.482327", "function_name": "collect", "function_body": "  index = env.world.cookbook.index[primitive]\n  pos_x, pos_y = env._current_state.pos\n  dir = env._current_state.dir\n\n  target_positions = np.argwhere(env._current_state.grid[:, :, index] == 1)\n\n  if len(target_positions) == 0:\n    return []\n\n  # Use Manhattan distance to find the closest target position\n  distances = [(abs(pos_x - tx) + abs(pos_y - ty), (tx, ty)) for tx, ty in target_positions]\n  closest_target_pos = min(distances, key=lambda x: x[0])[1]\n\n  def find_path(start, goal):\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([start])\n    came_from = {start: None}\n    \n    while queue:\n      current = queue.popleft()\n      \n      if current == goal:\n        break\n      \n      for direction in directions:\n        next_pos = tuple(np.add(current, direction))\n        \n        # Check if the next position is within bounds and not blocked\n        grid_height, grid_width = env._current_state.grid.shape[:2]\n        if 0 <= next_pos[0] < grid_height and 0 <= next_pos[1] < grid_width:\n          if np.all(env._current_state.grid[next_pos[0], next_pos[1]] == 0):\n            if next_pos not in came_from:\n              queue.append(next_pos)\n              came_from[next_pos] = current\n    \n    # Reconstruct the path from start to goal\n    path = []\n    while current != start:\n      path.append(current)\n      current = came_from[current]\n    path.reverse()\n    \n    return path\n\n  def get_direction_to_target(current_dir, dx, dy):\n    if dx == 1:  \n      return craft.RIGHT if current_dir != 2 else craft.USE\n    elif dx == -1:  \n      return craft.LEFT if current_dir != 0 else craft.USE\n    elif dy == 1:  \n      return craft.DOWN if current_dir != 3 else craft.USE\n    elif dy == -1:  \n      return craft.UP if current_dir != 1 else craft.USE\n\n  def rotate_to_direction(current_dir, target_dir):\n      \"\"\"Returns the sequence of rotations needed to face a target direction.\"\"\"\n      directions = [craft.DOWN, craft.RIGHT, craft.UP, craft.LEFT]\n      current_index = directions.index(current_dir)\n      target_index = directions.index(target_dir)\n\n      if (target_index - current_index) % 4 == 1:\n          return [craft.RIGHT]\n      elif (target_index - current_index) % 4 == 2:\n          return [craft.RIGHT, craft.RIGHT]\n      elif (target_index - current_index) % 4 == 3:\n          return [craft.LEFT]\n      else:\n          return []\n\n  path = find_path((pos_x, pos_y), closest_target_pos)\n  actions = []\n\n  for i in range(len(path)):\n    current_pos = path[i]\n\n    # Determine the direction to move\n    if i < len(path) - 1:\n        next_pos = path[i + 1]\n        delta_x = next_pos[0] - current_pos[0]\n        delta_y = next_pos[1] - current_pos[1]\n        \n        # Calculate target direction\n        if dx == 1:  \n          target_dir = craft.RIGHT\n        elif dx == -1:  \n          target_dir = craft.LEFT\n        elif dy == 1:  \n          target_dir = craft.DOWN\n        elif dy == -1:  \n          target_dir = craft.UP\n\n        # Add rotation actions to face the target direction\n        actions.extend(rotate_to_direction(dir, target_dir))\n        action = get_direction_to_target(dir, delta_x, delta_y)\n    else:\n        # If at the target position, use to collect\n        action = craft.USE\n\n    actions.append(action)\n\n    # Update the agent's direction if a movement action was taken\n    if action in [craft.RIGHT, craft.LEFT, craft.UP, craft.DOWN]:\n      dir = {craft.RIGHT: 2, craft.LEFT: 0, craft.DOWN: 3, craft.UP: 1}[action]\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-26T03:47:19.567448", "function_name": "collect", "function_body": "  # Get the index of the primitive from the cookbook\n  index = env.world.cookbook.index[primitive]\n  \n  # Current position and direction of the agent\n  pos_x, pos_y = env._current_state.pos\n  current_dir = env._current_state.dir\n\n  # Find all positions in the grid that contain the desired primitive\n  target_positions = np.argwhere(env._current_state.grid[:, :, index] == 1)\n\n  if len(target_positions) == 0:\n    return []  # No targets found, no actions to take\n\n  # Calculate Manhattan distances from the agent's position to each target\n  distances = [(pos_x - tx, pos_y - ty) for tx, ty in target_positions]\n  distances = [abs(dx) + abs(dy) for dx, dy in distances]\n\n  # Find the closest target position\n  min_distance_index = np.argmin(distances)\n  closest_target_pos = tuple(target_positions[min_distance_index])\n\n  def find_path(start, goal):\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]  # RIGHT, DOWN, LEFT, UP\n    queue = collections.deque([start])\n    came_from = {start: None}\n    \n    while queue:\n      current = queue.popleft()\n      \n      if current == goal:\n        break\n      \n      for direction in directions:\n        next_pos = tuple(np.add(current, direction))\n        \n        # Check if the next position is within bounds and not blocked\n        grid_height, grid_width = env._current_state.grid.shape[:2]\n        if 0 <= next_pos[0] < grid_height and 0 <= next_pos[1] < grid_width:\n          if np.all(env._current_state.grid[next_pos[0], next_pos[1]] == 0):\n            if next_pos not in came_from:\n              queue.append(next_pos)\n              came_from[next_pos] = current\n    \n    # Reconstruct the path from start to goal\n    path = []\n    while current != start:\n      path.append(current)\n      current = came_from[current]\n    path.reverse()\n    \n    return path\n\n  def get_direction_to_target(current_dir, dx, dy):\n    if dx == 1:  \n      return craft.RIGHT if current_dir != 2 else craft.USE\n    elif dx == -1:  \n      return craft.LEFT if current_dir != 0 else craft.USE\n    elif dy == 1:  \n      return craft.DOWN if current_dir != 3 else craft.USE\n    elif dy == -1:  \n      return craft.UP if current_dir != 1 else craft.USE\n\n  path = find_path((pos_x, pos_y), closest_target_pos)\n  actions = []\n\n  for i in range(len(path)):\n    current_pos = path[i]\n\n    # Determine the direction to move\n    if i < len(path) - 1:\n        next_pos = path[i + 1]\n        delta_x = next_pos[0] - current_pos[0]\n        delta_y = next_pos[1] - current_pos[1]\n        \n        action = get_direction_to_target(current_dir, delta_x, delta_y)\n    else:\n        # If at the target position, use to collect\n        action = craft.USE\n\n    actions.append(action)\n\n    # Update the agent's direction if a movement action was taken\n    if action in [craft.RIGHT, craft.LEFT, craft.UP, craft.DOWN]:\n      current_dir = {craft.RIGHT: 2, craft.LEFT: 0, craft.DOWN: 3, craft.UP: 1}[action]\n\n  return actions", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-09-26T03:48:26.563748", "function_name": "collect", "function_body": "  actions = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  current_state = env._current_state\n\n  queue = collections.deque([(current_state.pos, [])])\n  visited = set([current_state.pos])\n\n  def get_primitive_index(primitive_name):\n      return current_state.world.cookbook.index[primitive_name]\n\n  target_primitive_index = get_primitive_index(primitive)\n\n  while queue:\n      pos, actions_taken = queue.popleft()\n\n      if current_state.grid[pos[0], pos[1], target_primitive_index] > 0:\n          return actions_taken + [actions[\"USE\"]]\n\n      neighbors = get_neighbors(pos)\n      for neighbor in neighbors:\n          nx, ny = neighbor\n\n          if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n              # Check if the cell is not blocked by non-grabbable entities or can be cleared with tools.\n              blocked_by_environment = any(current_state.grid[ny, nx, env_index] > 0 for env_index in current_state.world.non_grabbable_indices)\n              if blocked_by_environment:\n                  # Try to clear the blockage using available tools.\n                  for tool_index in current_state.world.grabbable_indices:\n                      if current_state.inventory[tool_index] > 0 and current_state.grid[ny, nx, tool_index] > 0:\n                          return actions_taken + [actions[\"USE\"]]\n              else:\n                  if neighbor not in visited:\n                      visited.add(neighbor)\n\n                      dx, dy = nx - pos[0], ny - pos[1]\n                      action = actions.get({(-1, 0): \"LEFT\", (1, 0): \"RIGHT\", (0, -1): \"UP\", (0, 1): \"DOWN\"}[(dx, dy)])\n                      if action is not None:\n                          queue.append((neighbor, actions_taken + [action]))\n\n  return []", "island_id": 1, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T03:48:27.606409", "function_name": "collect", "function_body": "  def get_primitive_index(primitive_name):\n      return env._current_state.world.cookbook.index[primitive_name]\n\n  # Mapping from action names to indices.\n  actions = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  # Current state of the environment.\n  current_state = env._current_state\n\n  # Initialize BFS queue and visited set.\n  queue = collections.deque([(current_state.pos, [])])\n  visited = set([current_state.pos])\n\n  target_primitive_index = get_primitive_index(primitive)\n\n  while queue:\n      pos, actions_taken = queue.popleft()\n\n      if current_state.grid[pos[0], pos[1], target_primitive_index] > 0:\n          return actions_taken + [actions[\"USE\"]]\n\n      neighbors = get_neighbors(pos)\n      for neighbor in neighbors:\n          nx, ny = neighbor\n\n          # Ensure the neighbor is within bounds.\n          if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n              # Check if the cell is not blocked by non-grabbable entities or can be cleared with tools.\n              blocked_by_environment = False\n              for env_index in current_state.world.non_grabbable_indices:\n                  if current_state.grid[ny, nx, env_index] > 0 and not any(current_state.inventory[tool_index] > 0 for tool_index in current_state.world.grabbable_indices):\n                      blocked_by_environment = True\n                      break\n\n              if not blocked_by_environment:\n                  if neighbor not in visited:\n                      visited.add(neighbor)\n\n                      dx, dy = nx - pos[0], ny - pos[1]\n                      if dx == 1:\n                          action = actions[\"RIGHT\"]\n                      elif dx == -1:\n                          action = actions[\"LEFT\"]\n                      elif dy == 1:\n                          action = actions[\"DOWN\"]\n                      else:  # dy == -1\n                          action = actions[\"UP\"]\n\n                      queue.append((neighbor, actions_taken + [action]))\n              else:\n                  # Check if any tool in inventory can be used to clear the path.\n                  for tool_index in current_state.world.grabbable_indices:\n                      if current_state.inventory[tool_index] > 0 and current_state.grid[ny, nx, tool_index] > 0:\n                          return actions_taken + [actions[\"USE\"]]\n\n                  # Check if any non-grabbable entity can be cleared by using a tool.\n                  for env_index in current_state.world.non_grabbable_indices:\n                      if current_state.grid[ny, nx, env_index] > 0:\n                          # Use the tool if available and applicable.\n                          for tool_index in current_state.world.grabbable_indices:\n                              if current_state.inventory[tool_index] > 0:\n                                  return actions_taken + [actions[\"USE\"]]\n\n  return []", "island_id": 1, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T03:49:39.687086", "function_name": "collect", "function_body": "  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  actions = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def is_valid_position(pos):\n      x, y = pos\n      return 0 <= x < env._current_state.grid.shape[1] and 0 <= y < env._current_state.grid.shape[0]\n\n  def is_clear_of_non_grabbable_entities(grid, pos):\n      x, y = pos\n      for env_index in env._current_state.world.non_grabbable_indices:\n          if grid[y, x, env_index] > 0:\n              return False\n      return True\n\n  def get_primitive_index(primitive_name):\n      return env._current_state.world.cookbook.index[primitive_name]\n\n  target_primitive_index = get_primitive_index(primitive)\n  start_pos = env._current_state.pos\n  start_dir = env._current_state.dir\n\n  queue = collections.deque([(start_pos, [], start_dir)])\n  visited = set([(start_pos, start_dir)])\n\n  while queue:\n      pos, actions_taken, direction = queue.popleft()\n\n      if is_valid_position(pos) and is_clear_of_non_grabbable_entities(env._current_state.grid, pos):\n          if env._current_state.grid[pos[1], pos[0], target_primitive_index] > 0:\n              return actions_taken + [actions[\"USE\"]]\n\n          neighbors = get_neighbors(pos)\n          for neighbor in neighbors:\n              nx, ny = neighbor\n\n              if is_valid_position((nx, ny)) and is_clear_of_non_grabbable_entities(env._current_state.grid, (nx, ny)):\n                  if (neighbor, direction) not in visited:\n                      visited.add((neighbor, direction))\n\n                      dx, dy = nx - pos[0], ny - pos[1]\n                      action = None\n                      new_direction = None\n\n                      if dx == 1:\n                          action = actions[\"RIGHT\"]\n                          new_direction = 3\n                      elif dx == -1:\n                          action = actions[\"LEFT\"]\n                          new_direction = 2\n                      elif dy == 1:\n                          action = actions[\"DOWN\"]\n                          new_direction = 0\n                      else:  # dy == -1\n                          action = actions[\"UP\"]\n                          new_direction = 1\n\n                      if direction != new_direction:\n                          queue.append((pos, actions_taken + [action], new_direction))\n                      else:\n                          queue.append((neighbor, actions_taken + [action], new_direction))\n\n  return []", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-09-26T03:49:40.754657", "function_name": "collect", "function_body": "  actions = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  # Helper function to find neighboring positions.\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  # Get the current state of the environment.\n  current_state = env._current_state\n\n  # Define a queue for BFS and a set to track visited positions.\n  queue = collections.deque([(current_state.pos, [], current_state.dir)])\n  visited = set([(current_state.pos, current_state.dir)])\n\n  # Helper function to get the index of a primitive name.\n  def get_primitive_index(primitive_name):\n      return current_state.world.cookbook.index[primitive_name]\n\n  # Get the index for the target primitive.\n  target_primitive_index = get_primitive_index(primitive)\n\n  # Perform BFS to find a path to collect the primitive.\n  while queue:\n      pos, actions_taken, direction = queue.popleft()\n\n      # Check if we are at a cell with the desired primitive.\n      if current_state.grid[pos[0], pos[1], target_primitive_index] > 0:\n          return actions_taken + [actions[\"USE\"]]\n\n      # Get neighboring positions and filter out invalid ones.\n      neighbors = get_neighbors(pos)\n      for neighbor in neighbors:\n          nx, ny = neighbor\n\n          # Ensure the neighbor is within bounds.\n          if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n              # Check if the cell is not blocked by non-grabbable entities.\n              if all(current_state.grid[ny, nx, env_index] == 0 for env_index in current_state.world.non_grabbable_indices):\n                  # If the cell is visited for the first time with this direction, add it to the queue.\n                  if (neighbor, direction) not in visited:\n                      visited.add((neighbor, direction))\n\n                      # Determine the direction to move towards the neighbor.\n                      dx, dy = nx - pos[0], ny - pos[1]\n                      action = None\n                      new_direction = None\n\n                      if dx == 1:\n                          action = actions[\"RIGHT\"]\n                          new_direction = 3\n                      elif dx == -1:\n                          action = actions[\"LEFT\"]\n                          new_direction = 2\n                      elif dy == 1:\n                          action = actions[\"DOWN\"]\n                          new_direction = 0\n                      else:  # dy == -1\n                          action = actions[\"UP\"]\n                          new_direction = 1\n\n                      if direction != new_direction:\n                          # If the current direction is not the target direction, turn first.\n                          queue.append((pos, actions_taken + [action], new_direction))\n                      else:\n                          # Otherwise, move towards the neighbor.\n                          queue.append((neighbor, actions_taken + [action], new_direction))\n\n  # If no path is found to collect the primitive, return an empty list.\n  return []", "island_id": 2, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T03:50:34.389357", "function_name": "collect", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Get the index of the target primitive\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Helper function to check if a cell is blocked\n  def is_blocked(x, y):\n    return any(env._current_state.grid[x, y] > 0)\n\n  # Directions and their corresponding actions\n  directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n  actions = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, \n             (0, -1): craft.DOWN, (0, 1): craft.UP}\n\n  # BFS to find the shortest path to a cell containing the primitive\n  start_x, start_y = env._current_state.pos\n  visited = set()\n  queue = deque([(start_x, start_y, [])])  # (x, y, path)\n  \n  while queue:\n    x, y, path = queue.popleft()\n    \n    if (x, y) in visited:\n      continue\n    \n    visited.add((x, y))\n    \n    for dx, dy in directions:\n      nx, ny = x + dx, y + dy\n      \n      # Check bounds\n      if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n        # If the cell contains the primitive, return the path to it\n        if env._current_state.grid[nx, ny][primitive_index] > 0:\n          move_action = actions[(dx, dy)]\n          use_action = craft.USE\n          return path + [move_action, use_action]\n        \n        # If the cell is not blocked and hasn't been visited, add to queue\n        if not is_blocked(nx, ny):\n          move_action = actions[(dx, dy)]\n          queue.append((nx, ny, path + [move_action]))\n  \n  # If no path found, return an empty list (though this should not happen in a valid scenario)\n  return []", "island_id": 9, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T03:50:35.499643", "function_name": "collect", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Get the index of the target primitive\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Helper function to check if a cell is blocked\n  def is_blocked(x, y):\n    return any(env._current_state.grid[x, y] > 0)\n\n  # Directions and their corresponding actions\n  directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n  actions = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, \n             (0, -1): craft.DOWN, (0, 1): craft.UP}\n\n  # BFS to find the shortest path to a cell containing the primitive\n  start_x, start_y = env._current_state.pos\n  visited = set()\n  queue = deque([(start_x, start_y, [])])  # (x, y, path)\n  \n  while queue:\n    x, y, path = queue.popleft()\n    \n    if (x, y) in visited:\n      continue\n    \n    visited.add((x, y))\n    \n    for dx, dy in directions:\n      nx, ny = x + dx, y + dy\n      \n      # Check bounds\n      if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n        # If the cell contains the primitive, return the path to it\n        if env._current_state.grid[nx, ny][primitive_index] > 0:\n          move_action = actions[(dx, dy)]\n          use_action = craft.USE\n          return path + [move_action, use_action]\n        \n        # If the cell is not blocked and hasn't been visited, add to queue\n        if not is_blocked(nx, ny):\n          move_action = actions[(dx, dy)]\n          queue.append((nx, ny, path + [move_action]))\n  \n  # If no path found, return an empty list (though this should not happen in a valid scenario)\n  return []", "island_id": 9, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T03:51:39.365081", "function_name": "collect", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Get the index of the target primitive\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Helper function to check if a cell is blocked by obstacles or other items, except for the target primitive itself\n  def is_blocked(x, y):\n    return any(env._current_state.grid[x, y] > 0) and not env._current_state.grid[x, ny][primitive_index] > 0\n\n  # Directions and their corresponding actions\n  directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n  action_map = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, \n                (0, -1): craft.DOWN, (0, 1): craft.UP}\n\n  # BFS to find the shortest path to a cell containing the primitive\n  start_x, start_y = env._current_state.pos\n  visited = set()\n  queue = deque([(start_x, start_y, [])])  # (x, y, path)\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    if (x, y) in visited:\n      continue\n\n    visited.add((x, y))\n\n    for dx, dy in directions:\n      nx, ny = x + dx, y + dy\n      \n      # Check bounds\n      if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n        # If the cell contains the primitive, return the path to it\n        if env._current_state.grid[nx, ny][primitive_index] > 0:\n          move_action = action_map[(dx, dy)]\n          use_action = craft.USE\n          return path + [move_action, use_action]\n        \n        # If the cell is not blocked and hasn't been visited, add to queue\n        if not is_blocked(nx, ny):\n          move_action = action_map[(dx, dy)]\n          queue.append((nx, ny, path + [move_action]))\n  \n  return []  # Return an empty list if no path found", "island_id": 4, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T03:51:40.345962", "function_name": "collect", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Get the index of the target primitive\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Helper function to check if a cell is blocked by obstacles or other items, except for the target primitive itself\n  def is_blocked(x, y):\n    return any(env._current_state.grid[x, y] > 0) and not env._current_state.grid[x, y][primitive_index] > 0\n\n  # Directions and their corresponding actions\n  directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n  action_map = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, \n                (0, -1): craft.DOWN, (0, 1): craft.UP}\n\n  # Tools and their actions\n  tools = {\n    'AXE': env.world.cookbook.index['AXE'],\n    'HAMMER': env.world.cookbook.index['HAMMER']\n    # Add more tools as needed\n  }\n\n  # BFS to find the shortest path to a cell containing the primitive\n  start_x, start_y = env._current_state.pos\n  visited = set()\n  queue = deque([(start_x, start_y, [])])  # (x, y, path)\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    if (x, y) in visited:\n      continue\n\n    visited.add((x, y))\n\n    for dx, dy in directions:\n      nx, ny = x + dx, y + dy\n      \n      # Check bounds\n      if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n        # If the cell contains the primitive, return the path to it\n        if env._current_state.grid[nx, ny][primitive_index] > 0:\n          move_action = action_map[(dx, dy)]\n          use_action = craft.USE\n          return path + [move_action, use_action]\n        \n        # If the cell contains an obstacle that can be removed with a tool in inventory, remove it and continue\n        if is_blocked(nx, ny):\n          for tool_name, tool_index in tools.items():\n            if env._current_state.inventory[tool_index] > 0:\n              move_action = action_map[(dx, dy)]\n              use_tool_action = craft.USE  # This should correspond to using the tool to remove the obstacle\n              queue.append((nx, ny, path + [move_action, use_tool_action]))\n        \n        # If the cell is not blocked and hasn't been visited, add to queue\n        if not is_blocked(nx, ny):\n          move_action = action_map[(dx, dy)]\n          queue.append((nx, ny, path + [move_action]))\n\n  return []  # Return an empty list if no path found", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-26T03:52:36.177362", "function_name": "collect", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Get the index of the target primitive and the agent's current position\n  primitive_index = env.world.cookbook.index[primitive]\n  start_x, start_y = env._current_state.pos\n\n  # Directions and their corresponding actions\n  directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n  action_map = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, \n                (0, -1): craft.DOWN, (0, 1): craft.UP}\n\n  # Helper function to check if a cell is blocked by obstacles other than the primitive itself\n  def is_blocked(x, y):\n    return any(env._current_state.grid[x, y] > 0) and env._current_state.grid[x, y][primitive_index] == 0\n\n  # BFS to find the shortest path to a cell containing the primitive\n  visited = set()\n  queue = deque([(start_x, start_y, [])])  # (x, y, path)\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    if (x, y) in visited:\n      continue\n\n    visited.add((x, y))\n\n    for dx, dy in directions:\n      nx, ny = x + dx, y + dy\n      \n      # Check bounds\n      if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n        # If the cell contains the primitive, return the path to it\n        if env._current_state.grid[nx, ny][primitive_index] > 0:\n          move_action = action_map[(dx, dy)]\n          use_action = craft.USE\n          return path + [move_action, use_action]\n        \n        # If the cell is not blocked and hasn't been visited, add to queue\n        if not is_blocked(nx, ny):\n          move_action = action_map[(dx, dy)]\n          queue.append((nx, ny, path + [move_action]))\n\n  return []  # Return an empty list if no path found", "island_id": 4, "scores": {"3": 4.0}}
