{"timestamp": "2025-09-26T02:32:04.567822", "function_name": "collect", "function_body": "  def _find_shortest_path(grid, start_pos, target_kind, inventory):\n    width, height = grid.shape[:2]\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n      \n      if grid[x, y].argmax() == target_kind and (x, y) != start_pos:\n        return path\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          can_move = True\n          \n          # Check if there are obstacles and if the agent has tools to clear them\n          for tool in inventory:\n            if grid[nx, ny][tool]:\n              can_move = False\n              break\n          \n          if can_move or grid[nx, ny].sum() == 1:\n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))\n    \n    return None\n\n  def _get_action_index_from_direction(direction):\n    mapping = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, (0, -1): craft.DOWN, (0, 1): craft.UP}\n    return mapping.get(direction)\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  \n  # Convert inventory to dictionary format for easier access\n  inventory_dict = {i: count for i, count in enumerate(current_state.inventory) if count > 0}\n\n  primitive_index = current_state.world.cookbook.index.index(primitive)\n  \n  path_to_primitive = _find_shortest_path(grid, pos, primitive_index, inventory_dict)\n\n  actions = []\n  \n  if not path_to_primitive:\n    return []\n\n  for step in path_to_primitive:\n      action_index = _get_action_index_from_direction(step)\n      if action_index is None:\n          continue\n      actions.append(action_index)\n  \n  # Append the USE action to collect the primitive at the target position\n  actions.append(craft.USE)\n\n  return actions", "island_id": 5, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T02:33:31.675372", "function_name": "collect", "function_body": "  # Get the index of the primitive from the cookbook\n  index = env.world.cookbook.index[primitive]\n  \n  # Current grid state and agent's position/direction\n  grid = env._current_state.grid\n  pos_x, pos_y = env._current_state.pos\n  dir = env._current_state.dir\n\n  # Find all positions of the primitive in the grid\n  target_positions = np.argwhere(grid[:, :, index] == 1)\n\n  if len(target_positions) == 0:\n    return []\n\n  # Calculate Manhattan distances from the agent's position to each target\n  distances = [(pos_x - tx, pos_y - ty) for tx, ty in target_positions]\n  distances = [abs(dx) + abs(dy) for dx, dy in distances]\n\n  # Find the closest target position\n  min_distance_index = np.argmin(distances)\n  closest_target_pos = tuple(target_positions[min_distance_index])\n\n  def find_path(start, goal):\n    \"\"\"Finds a path from start to goal using BFS.\"\"\"\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]  # RIGHT, DOWN, LEFT, UP\n    queue = collections.deque([start])\n    came_from = {start: None}\n    \n    while queue:\n      current = queue.popleft()\n      \n      if current == goal:\n        break\n      \n      for direction in directions:\n        next_pos = tuple(np.add(current, direction))\n        \n        # Check if the next position is within bounds and not blocked\n        if 0 <= next_pos[0] < grid.shape[0] and\\\n           0 <= next_pos[1] < grid.shape[1]:\n          # Ensure the path does not pass through obstacles (non-empty cells)\n          if np.all(grid[next_pos[0], next_pos[1]] == 0):\n            if next_pos not in came_from:\n              queue.append(next_pos)\n              came_from[next_pos] = current\n    \n    # Reconstruct the path from start to goal\n    path = []\n    while current != start:\n      path.append(current)\n      current = came_from[current]\n    path.reverse()\n    \n    return path\n\n  def get_direction_to_target(current_dir, dx, dy):\n    \"\"\"Determines the direction to move based on the difference in coordinates.\"\"\"\n    if dx == 1:  # Move RIGHT\n      return craft.RIGHT if current_dir != 2 else craft.USE\n    elif dx == -1:  # Move LEFT\n      return craft.LEFT if current_dir != 0 else craft.USE\n    elif dy == 1:  # Move DOWN\n      return craft.DOWN if current_dir != 3 else craft.USE\n    elif dy == -1:  # Move UP\n      return craft.UP if current_dir != 1 else craft.USE\n\n  # Find the path to the closest target\n  path = find_path((pos_x, pos_y), closest_target_pos)\n  actions = []\n\n  for i in range(len(path)):\n    current_pos = path[i]\n    \n    # Calculate the direction to move from the current position to the next position\n    if i < len(path) - 1:\n      next_pos = path[i + 1]\n      delta_x = next_pos[0] - current_pos[0]\n      delta_y = next_pos[1] - current_pos[1]\n      \n      action = get_direction_to_target(dir, delta_x, delta_y)\n    else:\n      # If we are at the target position, use the action to collect the primitive\n      action = craft.USE\n\n    actions.append(action)\n\n    # Update the agent's direction if an actual move was made\n    if i < len(path) - 1 and action in [craft.RIGHT, craft.LEFT, craft.UP, craft.DOWN]:\n      dir = {craft.RIGHT: 2, craft.LEFT: 0, craft.DOWN: 3, craft.UP: 1}[action]\n\n  return actions", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-09-26T02:33:32.758809", "function_name": "collect", "function_body": "  index = env.world.cookbook.index[primitive]\n  grid = env._current_state.grid\n  pos_x, pos_y = env._current_state.pos\n  dir = env._current_state.dir\n\n  target_positions = np.argwhere(grid[:, :, index] == 1)\n\n  if len(target_positions) == 0:\n    return []\n\n  distances = [(pos_x - tx, pos_y - ty) for tx, ty in target_positions]\n  distances = [abs(dx) + abs(dy) for dx, dy in distances]\n\n  min_distance_index = np.argmin(distances)\n  closest_target_pos = tuple(target_positions[min_distance_index])\n\n  def find_path(start, goal):\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]  # RIGHT, DOWN, LEFT, UP\n    queue = collections.deque([start])\n    came_from = {start: None}\n    \n    while queue:\n      current = queue.popleft()\n      \n      if current == goal:\n        break\n      \n      for direction in directions:\n        next_pos = tuple(np.add(current, direction))\n        \n        # Check if the next position is within bounds and not blocked\n        if 0 <= next_pos[0] < grid.shape[0] and\\\n           0 <= next_pos[1] < grid.shape[1]:\n          if np.all(grid[next_pos[0], next_pos[1]] == 0):\n            if next_pos not in came_from:\n              queue.append(next_pos)\n              came_from[next_pos] = current\n    \n    # Reconstruct the path from start to goal\n    path = []\n    while current != start:\n      path.append(current)\n      current = came_from[current]\n    path.reverse()\n    \n    return path\n\n  def get_direction_to_target(current_dir, dx, dy):\n    if dx == 1:  # Move RIGHT\n      return craft.RIGHT if current_dir != 2 else craft.USE\n    elif dx == -1:  # Move LEFT\n      return craft.LEFT if current_dir != 0 else craft.USE\n    elif dy == 1:  # Move DOWN\n      return craft.DOWN if current_dir != 3 else craft.USE\n    elif dy == -1:  # Move UP\n      return craft.UP if current_dir != 1 else craft.USE\n\n  path = find_path((pos_x, pos_y), closest_target_pos)\n  actions = []\n\n  for i in range(len(path)):\n    current_pos = path[i]\n    \n    # Calculate the direction to move from the current position to the next position\n    if i < len(path) - 1:\n      next_pos = path[i + 1]\n      delta_x = next_pos[0] - current_pos[0]\n      delta_y = next_pos[1] - current_pos[1]\n      \n      action = get_direction_to_target(dir, delta_x, delta_y)\n    else:\n      # If we are at the target position, use the action to collect the primitive\n      action = craft.USE\n\n    actions.append(action)\n\n    # Update the agent's direction if an actual move was made\n    if i < len(path) - 1 and action in [craft.RIGHT, craft.LEFT, craft.UP, craft.DOWN]:\n      dir = {craft.RIGHT: 2, craft.LEFT: 0, craft.DOWN: 3, craft.UP: 1}[action]\n\n  return actions", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-09-26T02:34:33.705096", "function_name": "collect", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Get the index of the target primitive and tools in inventory\n  primitive_index = env.world.cookbook.index[primitive]\n  available_tools_indices = [env.world.cookbook.index[name] for name in [\"HAMMER\", \"KNIFE\"] \n                             if env._current_state.inventory[env.world.cookbook.index[name]] > 0]\n\n  # Helper function to check if a cell is blocked or contains only the primitive\n  def is_blocked(x, y):\n    cell_contents = env._current_state.grid[x, y]\n    return any(cell_contents) and not (cell_contents == 1).all() and primitive_index not in np.where(cell_contents > 0)[0]\n\n  # Directions and their corresponding actions\n  directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n  action_map = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, \n                (0, -1): craft.DOWN, (0, 1): craft.UP}\n\n  # BFS to find the shortest path to a cell containing the primitive\n  start_x, start_y = env._current_state.pos\n  visited = set()\n  queue = deque([(start_x, start_y, [])])  # (x, y, path)\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    if (x, y) in visited:\n      continue\n\n    visited.add((x, y))\n\n    for dx, dy in directions:\n      nx, ny = x + dx, y + dy\n      \n      # Check bounds\n      if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n        # If the cell contains the primitive, return the path to it\n        if env._current_state.grid[nx, ny][primitive_index] > 0:\n          move_action = action_map[(dx, dy)]\n          use_action = craft.USE\n          return path + [move_action, use_action]\n        \n        # If the cell is not blocked and hasn't been visited, add to queue\n        if not is_blocked(nx, ny):\n          move_action = action_map[(dx, dy)]\n          queue.append((nx, ny, path + [move_action]))\n  \n  return []  # Return an empty list if no path found", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-26T02:34:34.712443", "function_name": "collect", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Get the index of the target primitive and tools in inventory\n  primitive_index = env.world.cookbook.index[primitive]\n  tool_indices = [env.world.cookbook.index.get(tool, -1) for tool in ['AXE', 'KNIFE'] if env._current_state.inventory[env.world.cookbook.index[tool]] > 0]\n\n  # Helper function to check if a cell is blocked\n  def is_blocked(x, y):\n    return any(env._current_state.grid[x, y][index] > 0 for index in env.world.cookbook.index.values() \n               if index not in [primitive_index] + tool_indices)\n\n  # Directions and their corresponding actions\n  directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n  action_map = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, \n                (0, -1): craft.DOWN, (0, 1): craft.UP}\n\n  # BFS to find the shortest path to a cell containing the primitive\n  start_x, start_y = env._current_state.pos\n  visited = set()\n  queue = deque([(start_x, start_y, [])])  # (x, y, path)\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    if (x, y) in visited:\n      continue\n\n    visited.add((x, y))\n\n    for dx, dy in directions:\n      nx, ny = x + dx, y + dy\n      \n      # Check bounds\n      if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n        # If the cell contains the primitive, return the path to it\n        if env._current_state.grid[nx, ny][primitive_index] > 0:\n          move_action = action_map[(dx, dy)]\n          use_action = craft.USE\n          return path + [move_action, use_action]\n        \n        # If the cell is not blocked and hasn't been visited, add to queue\n        if not is_blocked(nx, ny):\n          move_action = action_map[(dx, dy)]\n          queue.append((nx, ny, path + [move_action]))\n  \n  return []  # Return an empty list if no path found", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-26T02:35:59.839563", "function_name": "collect", "function_body": "  index = env.world.cookbook.index[primitive]\n  grid = env._current_state.grid\n  pos_x, pos_y = env._current_state.pos\n  dir = env._current_state.dir\n\n  # Find all positions of the primitive in the grid\n  target_positions = np.argwhere(grid[:, :, index] == 1)\n\n  if len(target_positions) == 0:\n    return []\n\n  # Calculate Manhattan distances from current position to each target position\n  distances = [(pos_x - tx, pos_y - ty) for tx, ty in target_positions]\n  distances = [abs(dx) + abs(dy) for dx, dy in distances]\n\n  # Find the closest target position\n  min_distance_index = np.argmin(distances)\n  closest_target_pos = tuple(target_positions[min_distance_index])\n\n  def find_path(start, goal):\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]  # RIGHT, DOWN, LEFT, UP\n    queue = collections.deque([start])\n    came_from = {start: None}\n    \n    while queue:\n      current = queue.popleft()\n      \n      if current == goal:\n        break\n      \n      for direction in directions:\n        next_pos = tuple(np.add(current, direction))\n        \n        # Check if the next position is within bounds and not blocked\n        if 0 <= next_pos[0] < grid.shape[0] and\\\n           0 <= next_pos[1] < grid.shape[1]:\n          if np.all(grid[next_pos[0], next_pos[1]] == 0) or index in [craft.WATER, craft.STONE, craft.GRASS, craft.ROCK, craft.BOUNDARY]:\n            if next_pos not in came_from:\n              queue.append(next_pos)\n              came_from[next_pos] = current\n    \n    # Reconstruct the path from start to goal\n    path = []\n    while current != start:\n      path.append(current)\n      current = came_from[current]\n    path.reverse()\n    \n    return path\n\n  def get_direction_to_target(current_dir, dx, dy):\n    if dx == 1:  # Move RIGHT\n      return craft.RIGHT if current_dir != 2 else craft.USE\n    elif dx == -1:  # Move LEFT\n      return craft.LEFT if current_dir != 0 else craft.USE\n    elif dy == 1:  # Move DOWN\n      return craft.DOWN if current_dir != 3 else craft.USE\n    elif dy == -1:  # Move UP\n      return craft.UP if current_dir != 1 else craft.USE\n\n  path = find_path((pos_x, pos_y), closest_target_pos)\n  actions = []\n\n  for i in range(len(path)):\n    current_pos = path[i]\n    \n    # Calculate the direction to move from the current position to the next position\n    if i < len(path) - 1:\n      next_pos = path[i + 1]\n      delta_x = next_pos[0] - current_pos[0]\n      delta_y = next_pos[1] - current_pos[1]\n      \n      action = get_direction_to_target(dir, delta_x, delta_y)\n    else:\n      # If we are at the target position, use the action to collect the primitive\n      action = craft.USE\n\n    actions.append(action)\n\n    # Update the agent's direction if an actual move was made\n    if i < len(path) - 1 and action in [craft.RIGHT, craft.LEFT, craft.UP, craft.DOWN]:\n      dir = {craft.RIGHT: 2, craft.LEFT: 0, craft.DOWN: 3, craft.UP: 1}[action]\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-26T02:36:00.941521", "function_name": "collect", "function_body": "  index = env.world.cookbook.index[primitive]\n  grid = env._current_state.grid\n  pos_x, pos_y = env._current_state.pos\n  dir = env._current_state.dir\n\n  target_positions = np.argwhere(grid[:, :, index] == 1)\n\n  if len(target_positions) == 0:\n    return []\n\n  # Calculate Manhattan distances from the current position to each target position\n  distances = [(pos_x - tx, pos_y - ty) for tx, ty in target_positions]\n  distances = [abs(dx) + abs(dy) for dx, dy in distances]\n\n  min_distance_index = np.argmin(distances)\n  closest_target_pos = tuple(target_positions[min_distance_index])\n\n  def find_path(start, goal):\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]  # RIGHT, DOWN, LEFT, UP\n    queue = collections.deque([start])\n    came_from = {start: None}\n    \n    while queue:\n      current = queue.popleft()\n      \n      if current == goal:\n        break\n      \n      for direction in directions:\n        next_pos = tuple(np.add(current, direction))\n        \n        # Check if the next position is within bounds and not blocked\n        if 0 <= next_pos[0] < grid.shape[0] and\\\n           0 <= next_pos[1] < grid.shape[1]:\n          if np.all(grid[next_pos[0], next_pos[1]] == 0):\n            if next_pos not in came_from:\n              queue.append(next_pos)\n              came_from[next_pos] = current\n    \n    # Reconstruct the path from start to goal\n    path = []\n    while current != start:\n      path.append(current)\n      current = came_from[current]\n    path.reverse()\n    \n    return path\n\n  def get_direction_to_target(current_dir, dx, dy):\n    if dx == 1:  # Move RIGHT\n      return craft.RIGHT if current_dir != craft.LEFT else craft.USE\n    elif dx == -1:  # Move LEFT\n      return craft.LEFT if current_dir != craft.RIGHT else craft.USE\n    elif dy == 1:  # Move DOWN\n      return craft.DOWN if current_dir != craft.UP else craft.USE\n    elif dy == -1:  # Move UP\n      return craft.UP if current_dir != craft.DOWN else craft.USE\n\n  path = find_path((pos_x, pos_y), closest_target_pos)\n  actions = []\n\n  for i in range(len(path)):\n    current_pos = path[i]\n    \n    # Calculate the direction to move from the current position to the next position\n    if i < len(path) - 1:\n      next_pos = path[i + 1]\n      delta_x = next_pos[0] - current_pos[0]\n      delta_y = next_pos[1] - current_pos[1]\n      \n      action = get_direction_to_target(dir, delta_x, delta_y)\n    else:\n      # If we are at the target position, use the action to collect the primitive\n      action = craft.USE\n\n    actions.append(action)\n\n    # Update the agent's direction if an actual move was made\n    if i < len(path) - 1 and action in [craft.RIGHT, craft.LEFT, craft.UP, craft.DOWN]:\n      dir = {craft.RIGHT: craft.LEFT, craft.LEFT: craft.RIGHT, \n             craft.DOWN: craft.UP, craft.UP: craft.DOWN}[action]\n\n  return actions", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-09-26T02:36:56.281083", "function_name": "collect", "function_body": "  def _find_shortest_path(grid, start_pos, target_kind):\n    width, height = grid.shape[:2]\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n      \n      if grid[x, y].argmax() == target_kind and (x, y) != start_pos:\n        return path\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          if grid[nx, ny].sum() == 1:  # Allow moving through empty cells\n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))\n          elif env._current_state.world.cookbook.index.index(grid[x, y].argmax()) in inventory and (nx, ny) not in visited:\n            tool_index = grid[nx, ny].argmax()\n            if inventory[tool_index] > 0:  # Allow moving through obstacles if tool is available\n              visited.add((nx, ny))\n              queue.append((nx, ny, path + [(dx, dy)]))\n    \n    return None\n\n  def _get_action_index_from_direction(direction):\n    mapping = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, (0, -1): craft.DOWN, (0, 1): craft.UP}\n    return mapping.get(direction)\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  inventory = {i: count for i, count in enumerate(current_state.inventory) if count > 0}\n  \n  primitive_index = current_state.world.cookbook.index.index(primitive)\n  \n  path_to_primitive = _find_shortest_path(grid, pos, primitive_index)\n  \n  if not path_to_primitive:\n    return []\n  \n  actions = [_get_action_index_from_direction(step) for step in path_to_primitive]\n  actions.append(craft.USE)  # Add action to collect the primitive\n  \n  return actions", "island_id": 8, "scores": {"3": 2.5}}
{"timestamp": "2025-09-26T02:36:57.394670", "function_name": "collect", "function_body": "  def _find_shortest_path(grid, start_pos, target_kind, inventory):\n    width, height = grid.shape[:2]\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n      \n      if grid[x, y].argmax() == target_kind and (x, y) != start_pos:\n        return path\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          cell_content_index = grid[nx, ny].argmax()\n          \n          if inventory[cell_content_index] > 0 or grid[nx, ny].sum() == 1:  # Allow moving through empty cells\n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))\n    \n    return None\n\n  def _get_action_index_from_direction(direction):\n    mapping = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, (0, -1): craft.DOWN, (0, 1): craft.UP}\n    return mapping.get(direction)\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  inventory = current_state.inventory\n  \n  primitive_index = current_state.world.cookbook.index.index(primitive)\n  \n  path_to_primitive = _find_shortest_path(grid, pos, primitive_index, inventory)\n  \n  if not path_to_primitive:\n    return []\n  \n  actions = [_get_action_index_from_direction(step) for step in path_to_primitive]\n  actions.append(craft.USE)  # Add action to collect the primitive\n  \n  return actions", "island_id": 8, "scores": {"3": 2.5}}
{"timestamp": "2025-09-26T02:38:06.143454", "function_name": "collect", "function_body": "  def get_primitive_index(primitive_name):\n      return env._current_state.world.cookbook.index[primitive_name]\n\n  actions = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  current_state = env._current_state\n\n  queue = collections.deque([(current_state.pos, [])])\n  visited = set([current_state.pos])\n\n  target_primitive_index = get_primitive_index(primitive)\n\n  while queue:\n      pos, actions_taken = queue.popleft()\n\n      if current_state.grid[pos[0], pos[1], target_primitive_index] > 0:\n          return actions_taken + [actions[\"USE\"]]\n\n      neighbors = get_neighbors(pos)\n      for neighbor in neighbors:\n          nx, ny = neighbor\n\n          # Check bounds.\n          if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n              if all(current_state.grid[ny, nx, env_index] == 0 for env_index in current_state.world.non_grabbable_indices):\n                  if neighbor not in visited:\n                      visited.add(neighbor)\n\n                      dx, dy = nx - pos[0], ny - pos[1]\n                      if dx == 1:\n                          action = actions[\"RIGHT\"]\n                      elif dx == -1:\n                          action = actions[\"LEFT\"]\n                      elif dy == 1:\n                          action = actions[\"DOWN\"]\n                      else:  # dy == -1\n                          action = actions[\"UP\"]\n\n                      queue.append((neighbor, actions_taken + [action]))\n\n              # Check if the cell can be cleared using available tools.\n              for tool_index in current_state.world.grabbable_indices:\n                  if current_state.inventory[tool_index] > 0 and current_state.grid[ny, nx, tool_index] > 0:\n                      return actions_taken + [actions[\"USE\"]]\n\n      # Check around the current position to clear obstacles using available tools.\n      for neighbor in get_neighbors(pos):\n          nx, ny = neighbor\n\n          if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n              for tool_index in current_state.world.grabbable_indices:\n                  if current_state.inventory[tool_index] > 0 and current_state.grid[ny, nx, tool_index] > 0:\n                      return actions_taken + [actions[\"USE\"]]\n\n  return []", "island_id": 1, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T02:38:07.184268", "function_name": "collect", "function_body": "  def get_primitive_index(primitive_name):\n      return env._current_state.world.cookbook.index[primitive_name]\n\n  actions = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  current_state = env._current_state\n\n  queue = collections.deque([(current_state.pos, [])])\n  visited = set([current_state.pos])\n\n  target_primitive_index = get_primitive_index(primitive)\n\n  while queue:\n      pos, actions_taken = queue.popleft()\n\n      if current_state.grid[pos[0], pos[1], target_primitive_index] > 0:\n          return actions_taken + [actions[\"USE\"]]\n\n      neighbors = get_neighbors(pos)\n      for neighbor in neighbors:\n          nx, ny = neighbor\n\n          if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n              # Check if the cell is not blocked by non-grabbable entities.\n              if all(current_state.grid[ny, nx, env_index] == 0 for env_index in current_state.world.non_grabbable_indices):\n                  if neighbor not in visited:\n                      visited.add(neighbor)\n\n                      dx, dy = nx - pos[0], ny - pos[1]\n                      if dx == 1:\n                          action = actions[\"RIGHT\"]\n                      elif dx == -1:\n                          action = actions[\"LEFT\"]\n                      elif dy == 1:\n                          action = actions[\"DOWN\"]\n                      else:  # dy == -1\n                          action = actions[\"UP\"]\n\n                      queue.append((neighbor, actions_taken + [action]))\n\n              # Check if the cell can be cleared using available tools.\n              for tool_index in current_state.world.grabbable_indices:\n                  if current_state.inventory[tool_index] > 0 and current_state.grid[ny, nx, tool_index] > 0:\n                      return actions_taken + [actions[\"USE\"]]\n\n  # Attempt to clear obstacles around the agent's position using available tools.\n  for neighbor in get_neighbors(current_state.pos):\n      nx, ny = neighbor\n\n      if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n          for tool_index in current_state.world.grabbable_indices:\n              if current_state.inventory[tool_index] > 0 and current_state.grid[ny, nx, tool_index] > 0:\n                  return [actions[\"USE\"]]\n\n  # Fallback: If no immediate clear action is possible, move randomly to explore.\n  random_direction = np.random.choice(list(actions.values()))\n  return [random_direction]", "island_id": 1, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T02:39:35.703121", "function_name": "collect", "function_body": "  def can_use_tool_on_obstacle(tool_index: int, obstacle_index: int):\n    # Mock function to determine if a tool can be used on an obstacle\n    tools = {\n        'AXE': {'WOOD'},\n        'HAMMER': {'ROCK'}\n    }\n    for tool_name, usable_primitives in tools.items():\n      if tool_index == env.world.cookbook.index[tool_name]:\n        return any(obstacle_index == env.world.cookbook.index[p] for p in usable_primitives)\n    return False\n\n  def is_blocked(x: int, y: int) -> bool:\n    for kind_index in env.world.non_grabbable_indices:\n      if env._current_state.grid[x, y, kind_index] > 0 and not can_use_tool_on_obstacle(\n          any(env._current_state.inventory), kind_index):\n        return True\n    return False\n\n  # Determine the target primitive index from its name\n  target_primitive_index = env.world.cookbook.index[primitive]\n\n  # Initialize an empty list to store the actions needed\n  actions_to_take = []\n\n  # Current position of the agent\n  current_x, current_y = env._current_state.pos\n\n  # Get the grid dimensions\n  width, height, _ = env._current_state.grid.shape\n\n  # Use BFS to find the shortest path to the target primitive\n  queue = collections.deque([(current_x, current_y, actions_to_take)])\n  visited = set()\n  visited.add((current_x, current_y))\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    # Check if we are next to a cell containing the target primitive\n    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n      nx, ny = x + dx, y + dy\n\n      # Ensure within bounds and not visited\n      if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n        if env._current_state.grid[nx, ny, target_primitive_index] > 0:\n          # Move to the adjacent cell containing the primitive\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          actions_to_take.extend(path + [move_action])\n\n          # Collect the primitive\n          actions_to_take.append(craft.USE)\n          return actions_to_take\n\n        # Mark as visited and add to queue if not blocked or can be used with tools\n        if not is_blocked(nx, ny):\n          visited.add((nx, ny))\n          new_path = path.copy()\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          new_path.append(move_action)\n          queue.append((nx, ny, new_path))\n\n        # Check for tools in inventory to use on obstacles\n        elif is_blocked(nx, ny):\n          tool_used = False\n          for tool_index in env._current_state.inventory:\n            for obstacle_index in env.world.non_grabbable_indices:\n              if can_use_tool_on_obstacle(tool_index, obstacle_index) and\\\n                 env._current_state.grid[nx, ny, obstacle_index] > 0:\n                  actions_to_take.append(craft.USE)\n                  tool_used = True\n                  break\n            if tool_used:\n                visited.add((nx, ny))\n                queue.append((nx, ny, path.copy()))\n                break\n\n  # If no path is found, return an empty list of actions\n  return []", "island_id": 7, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T02:39:36.757764", "function_name": "collect", "function_body": "  def can_use_tool_on_obstacle(tool_index: int, obstacle_index: int):\n    # Mock function to determine if a tool can be used on an obstacle\n    tools = {\n        'AXE': {'WOOD'},\n        'HAMMER': {'ROCK'}\n    }\n    for tool_name, usable_primitives in tools.items():\n      if tool_index == env.world.cookbook.index[tool_name]:\n        return any(obstacle_index == env.world.cookbook.index[p] for p in usable_primitives)\n    return False\n\n  def is_blocked(x: int, y: int) -> bool:\n    for kind_index in env.world.non_grabbable_indices:\n      if env._current_state.grid[x, y, kind_index] > 0:\n        return True\n    return False\n\n  # Determine the target primitive index from its name\n  target_primitive_index = env.world.cookbook.index[primitive]\n\n  # Initialize an empty list to store the actions needed\n  actions_to_take = []\n\n  # Current position of the agent\n  current_x, current_y = env._current_state.pos\n\n  # Get the grid dimensions\n  width, height, _ = env._current_state.grid.shape\n\n  # Use BFS to find the shortest path to the target primitive\n  queue = collections.deque([(current_x, current_y, actions_to_take)])\n  visited = set()\n  visited.add((current_x, current_y))\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    # Check if we are next to a cell containing the target primitive\n    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n      nx, ny = x + dx, y + dy\n\n      # Ensure within bounds and not visited\n      if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n        if env._current_state.grid[nx, ny, target_primitive_index] > 0:\n          # Move to the adjacent cell containing the primitive\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          actions_to_take.extend(path + [move_action])\n\n          # Collect the primitive\n          actions_to_take.append(craft.USE)\n          return actions_to_take\n\n        # Mark as visited and add to queue if not blocked\n        if not is_blocked(nx, ny):\n          visited.add((nx, ny))\n          new_path = path.copy()\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          new_path.append(move_action)\n          queue.append((nx, ny, new_path))\n\n        # Check for tools in inventory to use on obstacles\n        if is_blocked(nx, ny):\n          tool_used = False\n          for tool_index in env._current_state.inventory:\n            for obstacle_index in env.world.non_grabbable_indices:\n              if can_use_tool_on_obstacle(tool_index, obstacle_index) and\\\n                 env._current_state.grid[nx, ny, obstacle_index] > 0:\n                  actions_to_take.append(craft.USE)\n                  tool_used = True\n                  break\n            if tool_used:\n                visited.add((nx, ny))\n                queue.append((nx, ny, path.copy()))\n                break\n\n  # If no path is found, return an empty list of actions\n  return []", "island_id": 7, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T02:40:46.688853", "function_name": "collect", "function_body": "  def is_blocked(x, y):\n    for kind_index in env.world.non_grabbable_indices:\n      if env._current_state.grid[x, y, kind_index] > 0:\n        return True\n    return False\n\n  # Determine the target primitive index from its name\n  target_primitive_index = env.world.cookbook.index[primitive]\n\n  # Initialize an empty list to store the actions needed\n  actions_to_take = []\n\n  # Current position of the agent\n  current_x, current_y = env._current_state.pos\n\n  # Get the grid dimensions\n  width, height, _ = env._current_state.grid.shape\n\n  # Use BFS with priority queue (heuristic) to find the shortest path\n  queue = collections.deque([(current_x, current_y, actions_to_take)])\n  visited = set()\n  visited.add((current_x, current_y))\n\n  def heuristic(x1, y1, x2, y2):\n    return abs(x1 - x2) + abs(y1 - y2)\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    # Check if we are next to a cell containing the target primitive\n    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n      nx, ny = x + dx, y + dy\n\n      # Ensure within bounds and not visited\n      if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n        if env._current_state.grid[nx, ny, target_primitive_index] > 0:\n          # Move to the adjacent cell containing the primitive\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          actions_to_take.extend(path + [move_action])\n\n          # Collect the primitive\n          actions_to_take.append(craft.USE)\n          return actions_to_take\n\n        # Mark as visited and add to queue if not blocked\n        if not is_blocked(nx, ny):\n          visited.add((nx, ny))\n          new_path = path.copy()\n          move_action = {\n              (-1, 0): craft.LEFT,\n              (1, 0): craft.RIGHT,\n              (0, -1): craft.DOWN,\n              (0, 1): craft.UP\n          }[(dx, dy)]\n          new_path.append(move_action)\n          # Insert based on heuristic distance to target primitive\n          queue.append((nx, ny, new_path))\n          queue = sorted(queue, key=lambda p: heuristic(p[0], p[1], current_x, current_y))\n\n  # If no path is found, return an empty list of actions\n  return []", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-26T02:40:47.745994", "function_name": "collect", "function_body": "  def is_blocked(x, y):\n    for kind_index in env.world.non_grabbable_indices:\n      if env._current_state.grid[x, y, kind_index] > 0:\n        return True\n    return False\n\n  def get_adjacent_cells(x, y):\n    width, height, _ = env._current_state.grid.shape\n    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n      nx, ny = x + dx, y + dy\n      if 0 <= nx < width and 0 <= ny < height and not is_blocked(nx, ny):\n        yield nx, ny\n\n  # Determine the target primitive index from its name\n  target_primitive_index = env.world.cookbook.index[primitive]\n\n  # Initialize an empty list to store the actions needed\n  actions_to_take = []\n\n  # Current position of the agent\n  current_x, current_y = env._current_state.pos\n\n  # Get the grid dimensions\n  width, height, _ = env._current_state.grid.shape\n\n  # Use BFS to find the shortest path to the target primitive\n  queue = collections.deque([(current_x, current_y, actions_to_take)])\n  visited = set()\n  visited.add((current_x, current_y))\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    # Check if we are next to a cell containing the target primitive\n    for nx, ny in get_adjacent_cells(x, y):\n      if env._current_state.grid[nx, ny, target_primitive_index] > 0:\n        # Move to the adjacent cell containing the primitive\n        move_action = {\n            (nx - x, ny - y): craft.LEFT if (nx - x) == -1 else \n                              craft.RIGHT if (nx - x) == 1 else \n                              craft.DOWN if (ny - y) == -1 else \n                              craft.UP\n        }[(nx - x, ny - y)]\n        actions_to_take.extend(path + [move_action])\n\n        # Collect the primitive\n        actions_to_take.append(craft.USE)\n        return actions_to_take\n\n      # Mark as visited and add to queue if not blocked\n      if (nx, ny) not in visited:\n        visited.add((nx, ny))\n        new_path = path.copy()\n        move_action = {\n            (nx - x, ny - y): craft.LEFT if (nx - x) == -1 else \n                              craft.RIGHT if (nx - x) == 1 else \n                              craft.DOWN if (ny - y) == -1 else \n                              craft.UP\n        }[(nx - x, ny - y)]\n        new_path.append(move_action)\n        queue.append((nx, ny, new_path))\n\n  # If no path is found, return an empty list of actions\n  return []", "island_id": 6, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T02:42:00.613797", "function_name": "collect", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Get the index of the target primitive\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Helper function to check if a cell is blocked by obstacles other than the primitive itself\n  def is_blocked(x, y):\n    return any(env._current_state.grid[x, y] > 0) and env._current_state.grid[x, y][primitive_index] == 0\n\n  # Directions and their corresponding actions\n  directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n  action_map = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, \n                (0, -1): craft.DOWN, (0, 1): craft.UP}\n\n  # Get indices of tools in the inventory\n  tool_indices = set()\n  for tool_name in ['AXE', 'KNIFE', 'HAMMER']:\n    if tool_name in env.world.cookbook.index:\n      tool_indices.add(env.world.cookbook.index[tool_name])\n\n  # BFS to find the shortest path to a cell containing the primitive\n  start_x, start_y = env._current_state.pos\n  visited = set()\n  queue = deque([(start_x, start_y, [])])  # (x, y, path)\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    if (x, y) in visited:\n      continue\n\n    visited.add((x, y))\n\n    for dx, dy in directions:\n      nx, ny = x + dx, y + dy\n      \n      # Check bounds\n      if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n        # If the cell contains the primitive, return the path to it\n        if env._current_state.grid[nx, ny][primitive_index] > 0:\n          move_action = action_map[(dx, dy)]\n          use_action = craft.USE\n          return path + [move_action, use_action]\n        \n        # If the cell is blocked by an obstacle and has a tool to break it, add to queue with USE action\n        if is_blocked(nx, ny):\n          for tool_index in tool_indices:\n            if env._current_state.inventory[tool_index] > 0:\n              move_action = action_map[(dx, dy)]\n              use_action = craft.USE\n              queue.append((nx, ny, path + [move_action, use_action]))\n        \n        # If the cell is not blocked and hasn't been visited, add to queue\n        elif not is_blocked(nx, ny):\n          move_action = action_map[(dx, dy)]\n          queue.append((nx, ny, path + [move_action]))\n  \n  return []  # Return an empty list if no path found", "island_id": 4, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T02:42:01.659354", "function_name": "collect", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Get the index of the target primitive\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Helper function to check if a cell is blocked by obstacles other than the primitive itself\n  def is_blocked(x, y):\n    return any(env._current_state.grid[x, y] > 0) and env._current_state.grid[x, y][primitive_index] == 0\n\n  # Get indices of tools in the inventory\n  tool_indices = set()\n  for tool_name in ['AXE', 'KNIFE', 'HAMMER']:\n    if tool_name in env.world.cookbook.index:\n      tool_indices.add(env.world.cookbook.index[tool_name])\n\n  # Directions and their corresponding actions\n  directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n  action_map = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, \n                (0, -1): craft.DOWN, (0, 1): craft.UP}\n\n  # BFS to find the shortest path to a cell containing the primitive\n  start_x, start_y = env._current_state.pos\n  visited = set()\n  queue = deque([(start_x, start_y, [])])  # (x, y, path)\n\n  while queue:\n    x, y, path = queue.popleft()\n\n    if (x, y) in visited:\n      continue\n\n    visited.add((x, y))\n\n    for dx, dy in directions:\n      nx, ny = x + dx, y + dy\n      \n      # Check bounds\n      if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n        # If the cell contains the primitive, return the path to it\n        if env._current_state.grid[nx, ny][primitive_index] > 0:\n          move_action = action_map[(dx, dy)]\n          use_action = craft.USE\n          return path + [move_action, use_action]\n        \n        # If the cell is blocked by an obstacle and has a tool to break it, add to queue with USE action\n        if is_blocked(nx, ny) and any(env._current_state.inventory[tool_index] > 0 for tool_index in tool_indices):\n          move_action = action_map[(dx, dy)]\n          use_action = craft.USE\n          # Check the cell's contents to determine which tool to use (if necessary)\n          for tool_index in tool_indices:\n            if env._current_state.grid[nx, ny][tool_index] > 0 and env._current_state.inventory[tool_index] > 0:\n              queue.append((nx, ny, path + [move_action, use_action]))\n              break\n        else:\n          # If the cell is not blocked and hasn't been visited, add to queue\n          move_action = action_map[(dx, dy)]\n          queue.append((nx, ny, path + [move_action]))\n  \n  return []  # Return an empty list if no path found", "island_id": 4, "scores": {"3": 4.0}}
{"timestamp": "2025-09-26T02:42:53.346319", "function_name": "collect", "function_body": "  def _find_shortest_path(grid, start_pos, target_kind):\n    width, height = grid.shape[:2]\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n      \n      if grid[x, y].argmax() == target_kind and (x, y) != start_pos:\n        return path\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          # Allow movement on clear cells or through tools that are available in the inventory\n          cell_kind = grid[nx, ny].argmax()\n          if grid[nx, ny].sum() == 1 or inventory[cell_kind] > 0:  \n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))\n    \n    return None\n\n  def _get_action_index_from_direction(direction):\n    mapping = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, (0, -1): craft.DOWN, (0, 1): craft.UP}\n    return mapping.get(direction)\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  inventory = current_state.inventory\n  \n  primitive_index = current_state.world.cookbook.index.index(primitive)\n  \n  path_to_primitive = _find_shortest_path(grid, pos, primitive_index)\n  \n  if not path_to_primitive:\n    return []\n  \n  actions = [_get_action_index_from_direction(step) for step in path_to_primitive]\n  actions.append(craft.USE)  # Add action to collect the primitive\n  \n  return actions", "island_id": 9, "scores": {"3": 2.5}}
{"timestamp": "2025-09-26T02:42:54.384215", "function_name": "collect", "function_body": "  def _find_shortest_path(grid, start_pos, target_kind):\n    width, height = grid.shape[:2]\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n      \n      if grid[x, y].argmax() == target_kind and (x, y) != start_pos:\n        return path\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n          # Allow movement on clear cells or through tools that are available in the inventory\n          cell_kind = grid[nx, ny].argmax()\n          if grid[nx, ny].sum() == 1 or inventory[cell_kind] > 0:  \n            visited.add((nx, ny))\n            queue.append((nx, ny, path + [(dx, dy)]))\n    \n    return None\n\n  def _get_action_index_from_direction(direction):\n    mapping = {(-1, 0): craft.LEFT, (1, 0): craft.RIGHT, (0, -1): craft.DOWN, (0, 1): craft.UP}\n    return mapping.get(direction)\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  inventory = current_state.inventory\n  \n  primitive_index = current_state.world.cookbook.index.index(primitive)\n  \n  path_to_primitive = _find_shortest_path(grid, pos, primitive_index)\n  \n  if not path_to_primitive:\n    return []\n  \n  actions = [_get_action_index_from_direction(step) for step in path_to_primitive]\n  actions.append(craft.USE)  # Add action to collect the primitive\n  \n  return actions", "island_id": 9, "scores": {"3": 2.5}}
{"timestamp": "2025-09-26T02:44:01.792340", "function_name": "collect", "function_body": "  def get_primitive_index(primitive_name):\n      return env._current_state.world.cookbook.index[primitive_name]\n\n  actions = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  current_state = env._current_state\n\n  queue = collections.deque([(current_state.pos, [])])\n  visited = set([current_state.pos])\n\n  target_primitive_index = get_primitive_index(primitive)\n\n  while queue:\n      pos, actions_taken = queue.popleft()\n\n      if current_state.grid[pos[0], pos[1], target_primitive_index] > 0:\n          return actions_taken + [actions[\"USE\"]]\n\n      neighbors = get_neighbors(pos)\n      for neighbor in neighbors:\n          nx, ny = neighbor\n\n          if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n              if all(current_state.grid[ny, nx, env_index] == 0 for env_index in current_state.world.non_grabbable_indices):\n                  if neighbor not in visited:\n                      visited.add(neighbor)\n\n                      dx, dy = nx - pos[0], ny - pos[1]\n                      if dx == 1:\n                          action = actions[\"RIGHT\"]\n                      elif dx == -1:\n                          action = actions[\"LEFT\"]\n                      elif dy == 1:\n                          action = actions[\"DOWN\"]\n                      else:  # dy == -1\n                          action = actions[\"UP\"]\n\n                      queue.append((neighbor, actions_taken + [action]))\n\n              if any(current_state.inventory[tool_index] > 0 and current_state.grid[ny, nx, tool_index] > 0 for tool_index in current_state.world.grabbable_indices):\n                  return actions_taken + [actions[\"USE\"]]\n\n      # Check if there are obstacles that can be cleared with available tools.\n      if any(current_state.inventory[tool_index] > 0 and current_state.grid[pos[0], pos[1], tool_index] > 0 for tool_index in current_state.world.grabbable_indices):\n          return actions_taken + [actions[\"USE\"]]\n\n  return []", "island_id": 1, "scores": {"3": 4.0}}
