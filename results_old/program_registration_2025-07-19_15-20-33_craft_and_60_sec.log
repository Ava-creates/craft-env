{"timestamp": "2025-07-19T19:37:45.836977", "function_name": "craft", "function_body": "  # Define the mapping from item names to their corresponding indices in the inventory\n  item_to_index = {\n      'PLANK': 0,\n      'STICK': 1,\n      'CLOTH': 2,\n      'ROPE': 3,\n      'BRIDGE': 4,\n      'BUNDLE': 5,\n      'HAMMER': 6,\n      'KNIFE': 7,\n      'BED': 8,\n      'AXE': 9,\n      'SHEARS': 10,\n      'LADDER': 11,\n      'SLINGSHOT': 12,\n      'ARROW': 13,\n      'BOW': 14,\n      'BENCH': 15,\n      'FLAG': 16,\n      'GOLDARROW': 17,\n      'GOLD': 18,\n      'GEM': 19\n  }\n\n  # Define the mapping from item indices to their corresponding names\n  index_to_item = {v: k for k, v in item_to_index.items()}", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-19T19:37:47.152865", "function_name": "craft", "function_body": "  # Initialize a variable to keep track of the total reward\n  total_reward = 0.0\n\n  # Iterate through each step in the environment\n  for step in range(env.max_steps):\n    # Get the current state of the environment\n    state = env.observations()['features_dict']\n\n    # Check if the current state satisfies the goal of the task\n    if env._is_done():\n      break\n\n    # Choose an action based on the current state\n    if env._current_state.next_to(env.world.cookbook.index[item]):\n      action = env.action_specs()['USE']\n    else:\n      # Choose a random action\n      action = np.random.choice(list(env.action_specs().values()))\n\n    # Step the environment and get the reward\n    reward, done, observations = env.step(action)\n\n    # Add the reward to the total reward\n    total_reward += reward\n\n    # Check if the environment is done\n    if done:\n      break\n\n  # Return the total reward\n  return total_reward", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-19T19:41:52.164346", "function_name": "craft", "function_body": "  if item == \"iron\":\n    return craft_v1(env, \"iron\")\n\n  # collect iron\n  while not env._current_state.inventory[env.world.cookbook.index[\"iron\"]]:\n    reward, done, obs = env.step(3, 1)\n    if done:\n      return reward\n\n  # collect rock\n  while not env._current_state.inventory[env.world.cookbook.index[\"rock\"]]:\n    reward, done, obs = env.step(3, 1)\n    if done:\n      return reward\n\n  # craft axe\n  while not env._current_state.inventory[env.world.cookbook.index[\"axe\"]]:\n    reward, done, obs = env.step(4, 1)\n    if done:\n      return reward\n\n  return reward", "island_id": 9, "scores": {}}
{"timestamp": "2025-07-19T19:41:53.460315", "function_name": "craft", "function_body": "  def collect_item(env, item):\n      # Get item index from environment's cookbook\n      item_index = env.world.cookbook.index[item]\n      \n      # Check if the item is in the environment\n      if item_index not in env.world.cookbook.kinds:\n          print(f\"Item {item} not found in the environment.\")\n          return\n      \n      # Find the item in the environment's grid\n      item_positions = np.argwhere(env._current_state.grid == item_index)\n      \n      # If the item is not found, return\n      if len(item_positions) == 0:\n          print(f\"Item {item} not found in the environment's grid.\")\n          return\n      \n      # Get the position of the item\n      item_pos = item_positions[0]\n      \n      # Move the agent to the item\n      env.step(env.action_specs()['LEFT'] if item_pos[0] < env._current_state.pos[0] else env.action_specs()['RIGHT'])\n      env.step(env.action_specs()['UP'] if item_pos[1] < env._current_state.pos[1] else env.action_specs()['DOWN'])\n      \n      # Collect the item\n      env.step(env.action_specs()['USE'])\n      \n  def craft_item(env, item):\n      # Get item index from environment's cookbook\n      item_index = env.world.cookbook.index[item]\n      \n      # Check if the item is in the environment\n      if item_index not in env.world.cookbook.kinds:\n          print(f\"Item {item} not found in the environment.\")\n          return\n      \n      # Check if the item can be crafted\n      if item_index not in env.world.cookbook.recipes:\n          print(f\"Item {item} cannot be crafted.\")\n          return\n      \n      # Get the recipe for the item\n      recipe = env.world.cookbook.recipes[item_index]\n      \n      # Check if the agent has all the ingredients to craft the item\n      for ingredient, count in recipe.items():\n          if ingredient not in env._current_state.inventory or env._current_state.inventory[ingredient] < count:\n              # If not, collect the ingredient\n              collect_item(env, env.world.cookbook.index.get(ingredient))\n      \n      # Craft the item\n      env.step(env.action_specs()['USE'])\n  \n  # Craft the specified item\n  craft_item(env, item)", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-19T19:47:25.075694", "function_name": "craft", "function_body": "  # Some helper functions\n  def move(env, direction):\n    action = env.action_specs()[direction]\n    reward, done, _ = env.step(action)\n    return reward\n\n  def craft(env, item):\n    action = env.action_specs()[f\"CRAFT_{item}\"]\n    reward, done, _ = env.step(action)\n    return reward\n\n  def collect(env, kind):\n    action = env.action_specs()[f\"COLLECT_{kind}\"]\n    reward, done, _ = env.step(action)\n    return reward\n\n  # Main logic\n  reward = 0.0\n  done = False\n\n  while not done:\n    # Move to the nearest resource\n    resource = find_nearest_resource(env, kind)\n    while env.get_position() != resource:\n      direction = get_direction(env.get_position(), resource)\n      reward += move(env, direction)\n\n    # Collect the resource\n    reward += collect(env, kind)\n\n    # Check if we have all the resources needed to craft the item\n    if have_all_resources(env, item):\n      # Craft the item\n      reward += craft(env, item)\n      done = True\n\n  return reward", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-19T19:47:26.385367", "function_name": "craft", "function_body": "  if env.world.cookbook.primitives_for(item) == {}:\n    # this means that the item is already a primitive and doesn't require any crafting\n    # collect it and return the reward\n    reward, done, obs = env.step(env.action_specs()['COLLECT_FUNC'])\n    return reward\n\n  # collect the ingredients required for crafting the item\n  ingredients = env.world.cookbook.primitives_for(item)\n  for ingredient in ingredients:\n    reward, done, obs = env.step(env.action_specs()['COLLECT_FUNC'])\n    if done:\n      return reward\n\n  # craft the item\n  reward, done, obs = env.step(env.action_specs()['CRAFT_FUNC'])\n  if done:\n    return reward\n\n  # return the total reward gathered from the env\n  return reward", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-19T19:49:43.590418", "function_name": "craft", "function_body": "  def move(dir):\n    env.step(dir)\n    # time.sleep(0.1)\n\n  def use():\n    env.step(env.action_specs()[\"USE\"])\n    # time.sleep(0.1)\n\n  if (item == \"PLANK\"):\n    move(env.action_specs()[\"LEFT\"])\n    move(env.action_specs()[\"LEFT\"])\n    move(env.action_specs()[\"LEFT\"])\n    move(env.action_specs()[\"LEFT\"])\n    move(env.action_specs()[\"DOWN\"])\n    move(env.action_specs()[\"DOWN\"])\n    use()\n    move(env.action_specs()[\"UP\"])\n    move(env.action_specs()[\"UP\"])\n    move(env.action_specs()[\"UP\"])\n    move(env.action_specs()[\"UP\"])\n    move(env.action_specs()[\"RIGHT\"])\n    move(env.action_specs()[\"RIGHT\"])\n    move(env.action_specs()[\"RIGHT\"])\n    move(env.action_specs()[\"RIGHT\"])\n    move(env.action_specs()[\"RIGHT\"])\n    use()\n  elif (item == \"STICK\"):\n    move(env.action_specs()[\"LEFT\"])\n    move(env.action_specs()[\"LEFT\"])\n    move(env.action_specs()[\"LEFT\"])\n    move(env.action_specs()[\"LEFT\"])\n    move(env.action_specs()[\"DOWN\"])\n    move(env.action_specs()[\"DOWN\"])\n    move(env.action_specs()[\"DOWN\"])\n    use()\n    move(env.action_specs()[\"UP\"])\n    move(env.action_specs()[\"UP\"])\n    move(env.action_specs()[\"UP\"])\n    move(env.action_specs()[\"UP\"])\n    move(env.action_specs()[\"UP\"])\n    move(env.action_specs()[\"RIGHT\"])\n    move(env.action_specs()[\"RIGHT\"])\n    move(env.action_specs()[\"RIGHT\"])\n    move(env.action_specs()[\"RIGHT\"])\n    move(env.action_specs()[\"RIGHT\"])\n    use()\n  elif (item == \"CLOTH\"):\n    move(env.action_specs()[\"LEFT\"])\n    move(env.action_specs()[\"LEFT\"])\n    move(env.action_specs()[\"LEFT\"])\n    move(env.action_specs()[\"LEFT\"])\n    move(env.action_specs()[\"LEFT\"])\n    move(env.action_specs()[\"LEFT\"])\n    move(env.action_specs()[\"LEFT\"])\n    move(env.action_specs()[\"LEFT\"])\n    move(env.action_specs()[\"LEFT\"])\n    move(env.action_specs()[\"LEFT\"])\n    move(env.action_specs()[\"LEFT\"])\n    move(env.action_specs()[\"LEFT\"])\n    move(env.action_specs()[\"DOWN\"])\n    move(env.action_specs()[\"DOWN\"])\n    use()\n    move(env.action_specs()[\"UP\"])\n    move(env.action_specs()[\"UP\"])\n    move(env.action_specs()[\"UP\"])\n    move(env.action_specs()[\"UP\"])\n    move(env.action_specs()[\"RIGHT\"])\n    move(env.action_specs()[\"RIGHT\"])\n    move(env.action_specs()[\"RIGHT\"])", "island_id": 7, "scores": {"3": -1}}
