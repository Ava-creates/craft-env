{"timestamp": "2025-07-19T19:52:08.060472", "function_name": "craft", "function_body": "  # Move up\n  env.step(1)  # UP\n  time.sleep(1)\n\n  # Move left\n  env.step(2)  # LEFT\n  time.sleep(1)\n\n  # Craft the item\n  reward, _, _ = env.step(4)  # USE\n  time.sleep(1)\n\n  return reward", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-07-19T20:05:18.528947", "function_name": "craft", "function_body": "  def collect(env, kind):\n    while not env._current_state.next_to(env.world.cookbook.index[kind]):\n      if env._current_state.dir != env.world.cookbook.index[\"LEFT\"]:\n        env.step(env.world.cookbook.index[\"LEFT\"])\n      else:\n        env.step(env.world.cookbook.index[\"UP\"])\n    env.step(env.world.cookbook.index[\"USE\"])\n\n  def move(env, dir):\n    if env._current_state.dir != dir:\n      env.step(dir)\n    env.step(env.world.cookbook.index[\"USE\"])\n\n  def craft(env, item):\n    for ingredient in env.world.cookbook.primitives_for(item):\n      if env._current_state.inventory[ingredient] == 0:\n        collect(env, env.world.cookbook.index.get(ingredient))\n    while env._current_state.inventory[item] == 0:\n      move(env, env.world.cookbook.index[\"UP\"])\n    env.step(env.world.cookbook.index[\"USE\"])\n\n  def collect_and_craft(env, kind, item):\n    collect(env, kind)\n    craft(env, item)\n\n  def collect_craft_and_craft(env, kind, item1, item2):\n    collect_and_craft(env, kind, item1)\n    craft(env, item2)\n\n  def collect_and_collect_and_craft(env, kind1, kind2, item):\n    collect(env, kind1)\n    collect(env, kind2)\n    craft(env, item)\n\n  def collect_craft_and_collect_and_craft(env, kind1, kind2, item1, item2):\n    collect_and_craft(env, kind1, item1)\n    collect(env, kind2)\n    craft(env, item2)\n\n  def collect_craft_and_collect_craft_and_craft(env, kind1, kind2, kind3, item1, item2, item3):\n    collect_and_craft(env, kind1, item1)\n    collect(env, kind2)\n    collect_and_craft(env, kind3, item3)\n    craft(env, item2)\n\n  def collect_and_collect_craft_and_craft(env, kind1, kind2, kind3, item1, item2):\n    collect(env, kind1)\n    collect(env, kind2)\n    collect_and_craft(env, kind3, item3)\n    craft(env, item2)", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-19T20:05:19.839705", "function_name": "craft", "function_body": "  # Define the sequence of actions required for each item\n  action_sequences = {\n    \"PLANK\": [env.action_specs()[\"LEFT\"], env.action_specs()[\"USE\"]],\n    \"STICK\": [env.action_specs()[\"LEFT\"], env.action_specs()[\"USE\"]],\n    \"CLOTH\": [env.action_specs()[\"LEFT\"], env.action_specs()[\"USE\"]],\n    \"ROPE\": [env.action_specs()[\"LEFT\"], env.action_specs()[\"USE\"]],\n    \"BRIDGE\": [env.action_specs()[\"LEFT\"], env.action_specs()[\"USE\"]],\n    \"BUNDLE\": [env.action_specs()[\"LEFT\"], env.action_specs()[\"USE\"]],\n    \"HAMMER\": [env.action_specs()[\"LEFT\"], env.action_specs()[\"USE\"]],\n    \"KNIFE\": [env.action_specs()[\"LEFT\"], env.action_specs()[\"USE\"]],\n    \"BED\": [env.action_specs()[\"LEFT\"], env.action_specs()[\"USE\"]],\n    \"AXE\": [env.action_specs()[\"LEFT\"], env.action_specs()[\"USE\"]],\n    \"SHEARS\": [env.action_specs()[\"LEFT\"], env.action_specs()[\"USE\"]],\n    \"LADDER\": [env.action_specs()[\"LEFT\"], env.action_specs()[\"USE\"]],\n    \"SLINGSHOT\": [env.action_specs()[\"LEFT\"], env.action_specs()[\"USE\"]],\n    \"ARROW\": [env.action_specs()[\"LEFT\"], env.action_specs()[\"USE\"]],\n    \"BOW\": [env.action_specs()[\"LEFT\"], env.action_specs()[\"USE\"]],\n    \"BENCH\": [env.action_specs()[\"LEFT\"], env.action_specs()[\"USE\"]],\n    \"FLAG\": [env.action_specs()[\"LEFT\"], env.action_specs()[\"USE\"]],\n    \"GOLDARROW\": [env.action_specs()[\"LEFT\"], env.action_specs()[\"USE\"]],\n  }\n\n  # Get the sequence of actions for the desired item\n  actions = action_sequences[item]\n\n  # Initialize total reward\n  total_reward = 0.0\n\n  # Perform each action and accumulate the reward\n  for action in actions:\n    reward, done, _ = env.step(action)\n    total_reward += reward\n\n    # If the environment is done, reset the environment\n    if done:\n      env.reset()\n\n  return total_reward", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-19T20:15:16.031849", "function_name": "craft", "function_body": "  # Implementing the `CRAFT_FUNC` function\n\n  # Define a dictionary mapping item names to their corresponding indices in the environment\n  item_index_map = {\n    \"PLANK\": env.world.cookbook.index[\"plank\"],\n    \"STICK\": env.world.cookbook.index[\"stick\"],\n    \"CLOTH\": env.world.cookbook.index[\"cloth\"],\n    \"ROPE\": env.world.cookbook.index[\"rope\"],\n    \"BRIDGE\": env.world.cookbook.index[\"bridge\"],\n    \"BUNDLE\": env.world.cookbook.index[\"bundle\"],\n    \"HAMMER\": env.world.cookbook.index[\"hammer\"],\n    \"KNIFE\": env.world.cookbook.index[\"knife\"],\n    \"BED\": env.world.cookbook.index[\"bed\"],\n    \"AXE\": env.world.cookbook.index[\"axe\"],\n    \"SHEARS\": env.world.cookbook.index[\"shears\"],\n    \"LADDER\": env.world.cookbook.index[\"ladder\"],\n    \"SLINGSHOT\": env.world.cookbook.index[\"slingshot\"],\n    \"ARROW\": env.world.cookbook.index[\"arrow\"],\n    \"BOW\": env.world.cookbook.index[\"bow\"],\n    \"BENCH\": env.world.cookbook.index[\"bench\"],\n    \"FLAG\": env.world.cookbook.index[\"flag\"],\n    \"GOLDARROW\": env.world.cookbook.index[\"goldarrow\"],\n    \"GOLD\": env.world.cookbook.index[\"gold\"],\n    \"GEM\": env.world.cookbook.index[\"gem\"],\n    \"WOOD\": env.world.cookbook.index[\"wood\"],\n    \"IRON\": env.world.cookbook.index[\"iron\"],\n    \"GRASS\": env.world.cookbook.index[\"grass\"],\n    \"ROCK\": env.world.cookbook.index[\"rock\"],\n  }\n\n  # Check if the item is in the item_index_map\n  if item not in item_index_map:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  # Get the item index\n  item_index = item_index_map[item]\n\n  # Initialize the reward\n  reward = 0.0\n\n  # Check if the item is already in the inventory\n  if env._current_state.inventory[item_index] > 0:\n    # If the item is already in the inventory, return the current reward\n    return reward", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-19T20:15:17.346298", "function_name": "craft", "function_body": "  def _navigate(env, target_pos):\n    current_pos = env._current_state.pos\n    if current_pos == target_pos:\n      return\n\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n    if dx > 0:\n      action = env.action_specs()['RIGHT']\n    elif dx < 0:\n      action = env.action_specs()['LEFT']\n    elif dy > 0:\n      action = env.action_specs()['UP']\n    else:\n      action = env.action_specs()['DOWN']\n\n    _, _, _ = env.step(action)\n\n  def _pick_up(env, item_index):\n    while env._current_state.inventory[item_index] == 0:\n      _, _, _ = env.step(env.action_specs()['USE'])\n\n  def _craft(env, output_index, input_indices, input_counts):\n    for i, input_index in enumerate(input_indices):\n      while env._current_state.inventory[input_index] < input_counts[i]:\n        _pick_up(env, input_index)\n\n    _, _, _ = env.step(env.action_specs()['USE'])\n    while env._current_state.inventory[output_index] == 0:\n      _, _, _ = env.step(env.action_specs()['USE'])\n\n  def _build_recipe_tree(env, output_index, tree=None):\n    if tree is None:\n      tree = {}\n\n    if output_index in tree:\n      return\n\n    recipe = env.world.cookbook.recipes.get(output_index)\n    if recipe is None:\n      tree[output_index] = None\n      return\n\n    input_indices = [i for i in recipe if isinstance(i, int)]\n    input_counts = [recipe[i] for i in input_indices]\n    tree[output_index] = (input_indices, input_counts)\n\n    for input_index in input_indices:\n      _build_recipe_tree(env, input_index, tree)\n\n  def _craft_recursively(env, output_index, tree):\n    if output_index in tree and tree[output_index] is not None:\n      input_indices, input_counts = tree[output_index]\n      for i, input_index in enumerate(input_indices):\n        _craft_recursively(env, input_index, tree)\n      _craft(env, output_index, input_indices, input_counts)\n\n  # Get the index of the item to craft\n  item_index = env.world.cookbook.index[item]\n\n  # Build the recipe tree\n  recipe_tree = {}\n  _build_recipe_tree(env, item_index, recipe_tree)", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-19T20:25:53.224555", "function_name": "craft", "function_body": "  # Get the primitives needed to craft the item\n  primitives = env.world.cookbook.primitives_for(item)\n  # print(\"primitives\", primitives)\n  # print(\"item\", item)\n\n  # Iterate through each primitive and collect it\n  for primitive, _ in primitives.items():\n    # print(primitive)\n    # print(env.world.cookbook.index.get(primitive))\n    collect(env, primitive)\n\n  # Craft the item\n  return craft(env, item)", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-19T20:25:54.532451", "function_name": "craft", "function_body": "  def collect(item):\n    obs = env.observations()\n    inventory = obs['features_dict']['inventory']\n    if inventory[item] > 0:\n      return\n    for x in range(env._width):\n      for y in range(env._height):\n        if obs['features_dict']['features_global'][x, y, item] > 0:\n          env._current_state.pos = (x, y)\n          obs = env.observations()\n          if obs['features_dict']['features_global'][x, y, item] > 0:\n            env.step(4)  # Use action\n            break\n    return\n\n  # Collect required items\n  if item == 'BRIDGE':\n    collect('PLANK')\n  elif item == 'STICK':\n    collect('WOOD')\n  elif item == 'CLOTH':\n    collect('GRASS')\n  elif item == 'ROPE':\n    collect('GRASS')\n  elif item == 'BUNDLE':\n    collect('GRASS')\n  elif item == 'HAMMER':\n    collect('PLANK')\n    collect('ROPE')\n  elif item == 'KNIFE':\n    collect('PLANK')\n    collect('ROPE')\n  elif item == 'BED':\n    collect('PLANK')\n    collect('CLOTH')\n  elif item == 'AXE':\n    collect('PLANK')\n    collect('STONE')\n  elif item == 'SHEARS':\n    collect('PLANK')\n    collect('STONE')\n  elif item == 'LADDER':\n    collect('PLANK')\n  elif item == 'SLINGSHOT':\n    collect('PLANK')\n    collect('ROCK')\n  elif item == 'ARROW':\n    collect('ROPE')\n    collect('STONE')\n  elif item == 'BOW':\n    collect('ROPE')\n    collect('WOOD')\n  elif item == 'BENCH':\n    collect('PLANK')\n    collect('PLANK')\n  elif item == 'FLAG':\n    collect('ROPE')\n    collect('CLOTH')\n\n  # Craft the item\n  obs = env.observations()\n  inventory = obs['features_dict']['inventory']\n  if inventory[item] > 0:\n    return", "island_id": 9, "scores": {"3": -1}}
