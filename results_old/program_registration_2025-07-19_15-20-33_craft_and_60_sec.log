{"timestamp": "2025-07-19T20:59:16.584274", "function_name": "craft", "function_body": "  def get_goal_name(item):\n    return f\"CRAFT_{item}\"\n\n  def get_goal_arg(item):\n    if item == \"PLANK\":\n      return env.world.cookbook.index[\"plank\"]\n    elif item == \"STICK\":\n      return env.world.cookbook.index[\"stick\"]\n    elif item == \"CLOTH\":\n      return env.world.cookbook.index[\"cloth\"]\n    elif item == \"ROPE\":\n      return env.world.cookbook.index[\"rope\"]\n    elif item == \"BRIDGE\":\n      return env.world.cookbook.index[\"bridge\"]\n    elif item == \"BUNDLE\":\n      return env.world.cookbook.index[\"bundle\"]\n    elif item == \"HAMMER\":\n      return env.world.cookbook.index[\"hammer\"]\n    elif item == \"KNIFE\":\n      return env.world.cookbook.index[\"knife\"]\n    elif item == \"BED\":\n      return env.world.cookbook.index[\"bed\"]\n    elif item == \"AXE\":\n      return env.world.cookbook.index[\"axe\"]\n    elif item == \"SHEARS\":\n      return env.world.cookbook.index[\"shears\"]\n    elif item == \"LADDER\":\n      return env.world.cookbook.index[\"ladder\"]\n    elif item == \"SLINGSHOT\":\n      return env.world.cookbook.index[\"slingshot\"]\n    elif item == \"ARROW\":\n      return env.world.cookbook.index[\"arrow\"]\n    elif item == \"BOW\":\n      return env.world.cookbook.index[\"bow\"]\n    elif item == \"BENCH\":\n      return env.world.cookbook.index[\"bench\"]\n    elif item == \"FLAG\":\n      return env.world.cookbook.index[\"flag\"]\n    elif item == \"GOLDARROW\":\n      return env.world.cookbook.index[\"goldarrow\"]\n    else:\n      raise ValueError(f\"Unknown item: {item}\")\n\n  goal_name = get_goal_name(item)\n  goal_arg = get_goal_arg(item)\n\n  while not env._is_done():\n    action = 4  # Use action\n    env.step(action)\n\n  return env._get_reward()", "island_id": 8, "scores": {"3": -1}}
