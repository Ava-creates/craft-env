{"timestamp": "2025-07-19T17:52:12.400766", "function_name": "craft", "function_body": "  # Calculate reward based on new pickups of needed items\n  reward = 0.0\n\n  # Get all items needed in the recipe for the goal\n  needed_items = env.world.cookbook.primitives_for(item)\n\n  # Check for new pickups by comparing current inventory with last inventory\n  if env._last_inventory is not None:\n    for item, needed_count in needed_items.items():\n      # If we have more of this item than before, it was just picked up\n      if env._current_state.inventory[item] > env._last_inventory[item]:\n        reward += 0.5  # Give reward for picking up a needed item\n\n    # Check for goal item pickup\n    if env._current_state.inventory[item] > env._last_inventory[item]:\n      reward = 1.0  # Give full reward for picking up goal item\n\n  # Update last inventory for next step\n  env._last_inventory = env._current_state.inventory.copy()\n\n  # Penalize picking up items not needed for the recipe\n  items_index = np.arange(env._current_state.inventory.size)\n  # Create mask for items that aren't needed (not in needed_items and not the goal)\n  not_needed_mask = np.ones_like(items_index, dtype=bool)\n  for item in needed_items:\n    not_needed_mask[item] = False\n  not_needed_mask[item] = False\n\n  # Only penalize items that aren't needed for the recipe\n  reward -= env._extra_pickup_penalty * np.sum(\n      env._current_state.inventory[not_needed_mask])\n  reward = np.maximum(reward, 0)", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-19T17:58:43.306924", "function_name": "craft", "function_body": "  # Get the needed items for the recipe\n  needed_items = env.world.cookbook.primitives_for(item)\n\n  # Initialize a dictionary to keep track of the picked up counts\n  picked_up_counts = {}\n\n  # Initialize a variable to store the total reward\n  total_reward = 0.0\n\n  # Main loop: continue until all needed items are gathered\n  while not all(picked_up_counts.get(item, 0) >= count for item, count in needed_items.items()):\n    # Step the environment and get the new state\n    _, _, new_state = env.step(action)\n\n    # Check for new pickups of needed items\n    for item, count in needed_items.items():\n      if new_state.inventory[item] > picked_up_counts.get(item, 0):\n        picked_up_counts[item] = new_state.inventory[item]\n        total_reward += 0.5  # Give reward for picking up a needed item\n\n    # Check for goal item pickup\n    if new_state.inventory[item] > picked_up_counts.get(item, 0):\n      picked_up_counts[item] = new_state.inventory[item]\n      total_reward = 1.0  # Give full reward for picking up goal item\n\n  return total_reward", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-19T17:58:44.406771", "function_name": "craft", "function_body": "  def _get_goal(task_name):\n    if task_name == \"find_gold\":\n      goal_name = \"find\"\n      goal_arg = env.world.cookbook.index[\"gold\"]\n    elif task_name == \"find_gem\":\n      goal_name = \"find\"\n      goal_arg = env.world.cookbook.index[\"gem\"]\n    elif task_name == \"craft_goldarrow\":\n      goal_name = \"craft\"\n      goal_arg = env.world.cookbook.index[\"goldarrow\"]\n    elif task_name == \"craft_sling\":\n      goal_name = \"craft\"\n      goal_arg = env.world.cookbook.index[\"slingshot\"]\n    else:\n      raise Exception(\"Unrecognised task name: %s\" % task_name)\n    return (goal_name, goal_arg)\n\n  def _move_dir(env, d):\n    if d == \"left\":\n      return env.step(env.action_specs()[\"LEFT\"])\n    if d == \"right\":\n      return env.step(env.action_specs()[\"RIGHT\"])\n    if d == \"up\":\n      return env.step(env.action_specs()[\"UP\"])\n    if d == \"down\":\n      return env.step(env.action_specs()[\"DOWN\"])\n    raise Exception(\"Unrecognised direction: %s\" % d)\n\n  def _find(env, d):\n    reward, _, _ = _move_dir(env, d)\n    return reward\n\n  def _craft(env, item):\n    return env.step(env.action_specs()[\"USE\"])[0]\n\n  def _collect(env, kind):\n    reward = 0.0\n    while True:\n      if env._current_state.next_to(kind):\n        reward += env.step(env.action_specs()[\"USE\"])[0]\n      else:\n        break\n    return reward\n\n  def _ifhas(env, item, do):\n    if env._current_state.inventory[item] > 0:\n      return do(env)\n    else:\n      return 0.0\n\n  def _then(env, task):\n    return task(env)\n\n  goal_name, goal_arg = _get_goal(env.task_name)\n\n  def _do(env):\n    if goal_name == \"find\":\n      reward = 0.0\n      while not env._is_done():\n        reward += _find(env, \"up\")\n        if env._is_done():\n          break\n        reward += _find(env, \"right\")\n        if env._is_done():\n          break\n        reward += _find(env, \"down\")\n        if env._is_done():\n          break", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-19T18:07:23.119466", "function_name": "craft", "function_body": "  # Step the environment with the \"USE\" action to craft the item\n  reward, done, _ = env.step(env.action_specs()[\"USE\"])\n\n  # Return the reward gathered in the process of crafting the item\n  return reward", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-07-19T18:07:24.217720", "function_name": "craft", "function_body": "  def move(env, direction):\n    action = env.action_specs()[direction]\n    _, _, _ = env.step(action)\n    return env\n\n  def has_item(env, item):\n    current_state = env._current_state\n    # Check if the specified item is present in the inventory\n    item_index = env.world.cookbook.index[item]\n    return current_state.inventory[item_index] > 0\n\n  # Check if the item is already in the inventory\n  if has_item(env, item):\n    print(f\"You already have the {item} in your inventory.\")\n    return env._get_reward()\n\n  # Calculate the reward based on the current state\n  reward = env._get_reward()\n\n  # Implement the logic for crafting the item here\n  # ...\n\n  # Return the updated reward after crafting the item\n  return env._get_reward()", "island_id": 1, "scores": {"3": -1}}
