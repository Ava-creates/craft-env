{"timestamp": "2025-07-19T15:58:13.628127", "function_name": "craft", "function_body": "  goal_name, goal_arg = env.task.goal\n\n  # Get all items needed in the recipe for the goal\n  needed_items = env.world.cookbook.primitives_for(goal_arg)\n\n  # Calculate reward based on new pickups of needed items\n  reward = 0.0\n\n  # Check for new pickups by comparing current inventory with last inventory\n  if env._last_inventory is not None:\n    for item, needed_count in needed_items.items():\n      # If we have more of this item than before, it was just picked up\n      if env._current_state.inventory[item] > env._last_inventory[item]:\n        reward += 0.5  # Give reward for picking up a needed item\n\n    # Check for goal item pickup\n    if env._current_state.inventory[goal_arg] > env._last_inventory[goal_arg]:\n      reward = 1.0  # Give full reward for picking up goal item\n\n  # Update last inventory for next step\n  env._last_inventory = env._current_state.inventory.copy()\n\n  # Penalize picking up items not needed for the recipe\n  items_index = np.arange(env._current_state.inventory.size)\n  # Create mask for items that aren't needed (not in needed_items and not the goal)\n  not_needed_mask = np.ones_like(items_index, dtype=bool)\n  for item in needed_items:\n    not_needed_mask[item] = False\n  not_needed_mask[goal_arg] = False\n\n  # Only penalize items that aren't needed for the recipe\n  reward -= env._extra_pickup_penalty * np.sum(\n      env._current_state.inventory[not_needed_mask])\n  reward = np.maximum(reward, 0)\n  return reward", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-19T16:03:47.791637", "function_name": "craft", "function_body": "  # Define a mapping of items to their crafting recipes\n  recipes = {\n      \"PLANK\": [\"WOOD\", \"WORKSHOP0\"],\n      \"STICK\": [\"WOOD\", \"WORKSHOP0\"],\n      \"CLOTH\": [\"GRASS\", \"WORKSHOP0\"],\n      \"ROPE\": [\"GRASS\", \"WORKSHOP0\"],\n      \"BRIDGE\": [\"WORKSHOP0\", \"WOOD\"],\n      \"BUNDLE\": [\"WORKSHOP0\", \"WOOD\"],\n      \"HAMMER\": [\"WORKSHOP0\", \"WOOD\"],\n      \"KNIFE\": [\"WORKSHOP0\", \"WOOD\"],\n      \"BED\": [\"WORKSHOP0\", \"WOOD\"],\n      \"AXE\": [\"WORKSHOP0\", \"WOOD\"],\n      \"SHEARS\": [\"WORKSHOP0\", \"WOOD\"],\n      \"LADDER\": [\"WORKSHOP0\", \"WOOD\"],\n      \"SLINGSHOT\": [\"WORKSHOP0\", \"WOOD\"],\n      \"ARROW\": [\"WORKSHOP0\", \"WOOD\"],\n      \"BOW\": [\"WORKSHOP0\", \"WOOD\"],\n      \"BENCH\": [\"WORKSHOP0\", \"WOOD\"],\n      \"FLAG\": [\"WORKSHOP0\", \"WOOD\"],\n      \"GOLDARROW\": [\"WORKSHOP0\", \"WOOD\"],\n      \"GOLD\": [\"WORKSHOP0\", \"WOOD\"],\n      \"GEM\": [\"WORKSHOP0\", \"WOOD\"],\n  }\n\n  # Define a mapping of items to their collection actions\n  collect_actions = {\n      \"BOUNDARY\": \"UP\",\n      \"WATER\": \"DOWN\",\n      \"STONE\": \"LEFT\",\n      \"WORKSHOP0\": \"RIGHT\",\n      \"WORKSHOP1\": \"UP\",\n      \"WORKSHOP2\": \"DOWN\",\n      \"WOOD\": \"LEFT\",\n      \"IRON\": \"RIGHT\",\n      \"GRASS\": \"UP\",\n      \"ROCK\": \"DOWN\",\n      \"GOLD\": \"LEFT\",\n      \"GEM\": \"RIGHT\",\n  }\n\n  # Define a function to perform the collection action for a given item\n  def collect_item(env, item):\n    action = collect_actions[item]\n    env.step(action)\n\n  # Define a function to perform the crafting action for a given item\n  def craft_item(env, item):\n    recipe = recipes[item]\n    for ingredient in recipe:\n      collect_item(env, ingredient)\n    env.step(\"CRAFT_FUNC\")\n\n  # Define a function to perform the main crafting loop\n  def craft(env, item):\n    reward = 0.0", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-19T16:03:48.894869", "function_name": "craft", "function_body": "  def collect(kind):\n    reward, done, obs = env.step(env.action_specs()['COLLECT_FUNC'](kind))\n    return reward, done, obs\n\n  def move(dir):\n    reward, done, obs = env.step(env.action_specs()['MOVE_FUNC'](dir))\n    return reward, done, obs\n\n  def craft(item):\n    reward, done, obs = env.step(env.action_specs()['CRAFT_FUNC'](item))\n    return reward, done, obs\n\n  def has(item):\n    return env.obs()['inventory'][item] > 0\n\n  def ifhas(item, func):\n    if has(item):\n      return func()\n\n  def whilehas(item, func):\n    while has(item):\n      func()\n\n  def while_not_has(item, func):\n    while not has(item):\n      func()\n\n  def then(func1, func2):\n    func1()\n    func2()\n\n  def sequence(funcs):\n    for func in funcs:\n      func()\n\n  def repeat(func, n):\n    for i in range(n):\n      func()\n\n  def repeat_until(func, condition):\n    while not condition():\n      func()\n\n  def repeat_until_has(func, item):\n    while not has(item):\n      func()\n\n  def repeat_until_not_has(func, item):\n    while has(item):\n      func()\n\n  def repeat_until_done(func):\n    while not env.is_done():\n      func()\n\n  def repeat_until_not_done(func):\n    while env.is_done():\n      func()\n\n  def repeat_until_reward(func, reward):\n    while env.get_reward() != reward:\n      func()\n\n  def repeat_until_not_reward(func, reward):\n    while env.get_reward() == reward:\n      func()\n\n  def repeat_until_done_or_reward(func, reward):\n    while not env.is_done() and env.get_reward() != reward:\n      func()\n\n  def repeat_until_not_done_or_reward(func, reward):\n    while env.is_done() or env.get_reward() == reward:\n      func()\n\n  def repeat_until_done_or_not_reward(func, reward):\n    while not env.is_done() or env.get_reward() == reward:\n      func()\n\n  def repeat_until_not_done_or_not_reward(func, reward):\n    while env.is_done() and env.get_reward() == reward:\n      func()\n\n  def repeat_until_done_or_not_reward_or_has(func, reward, item):\n    while not env.is_done() and env.get_reward() != reward and not has(item):\n      func()", "island_id": 4, "scores": {"3": -1}}
