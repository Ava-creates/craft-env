{"timestamp": "2025-07-19T17:34:52.879547", "function_name": "craft", "function_body": "  def _move_in_direction(direction: str):\n    if direction == \"UP\":\n      return env.step(env.action_specs()[\"UP\"])\n    elif direction == \"DOWN\":\n      return env.step(env.action_specs()[\"DOWN\"])\n    elif direction == \"LEFT\":\n      return env.step(env.action_specs()[\"LEFT\"])\n    elif direction == \"RIGHT\":\n      return env.step(env.action_specs()[\"RIGHT\"])\n\n  def _move_towards_goal(goal: tuple):\n    current_position = env.observations()['features_dict']['pos']\n    if current_position[0] < goal[0]:\n      return _move_in_direction(\"RIGHT\")\n    elif current_position[0] > goal[0]:\n      return _move_in_direction(\"LEFT\")\n    elif current_position[1] < goal[1]:\n      return _move_in_direction(\"UP\")\n    elif current_position[1] > goal[1]:\n      return _move_in_direction(\"DOWN\")\n\n  def _craft_item(item):\n    if item == \"PLANK\":\n      return env.step(env.action_specs()[\"CRAFT\"])\n    elif item == \"STICK\":\n      return env.step(env.action_specs()[\"CRAFT\"])\n    elif item == \"CLOTH\":\n      return env.step(env.action_specs()[\"CRAFT\"])\n    elif item == \"ROPE\":\n      return env.step(env.action_specs()[\"CRAFT\"])\n    elif item == \"BRIDGE\":\n      return env.step(env.action_specs()[\"CRAFT\"])\n    elif item == \"BUNDLE\":\n      return env.step(env.action_specs()[\"CRAFT\"])\n    elif item == \"HAMMER\":\n      return env.step(env.action_specs()[\"CRAFT\"])\n    elif item == \"KNIFE\":\n      return env.step(env.action_specs()[\"CRAFT\"])\n    elif item == \"BED\":\n      return env.step(env.action_specs()[\"CRAFT\"])\n    elif item == \"AXE\":\n      return env.step(env.action_specs()[\"CRAFT\"])\n    elif item == \"SHEARS\":\n      return env.step(env.action_specs()[\"CRAFT\"])\n    elif item == \"LADDER\":\n      return env.step(env.action_specs()[\"CRAFT\"])\n    elif item == \"SLINGSHOT\":\n      return env.step(env.action_specs()[\"CRAFT\"])\n    elif item == \"ARROW\":\n      return env.step(env.action_specs()[\"CRAFT\"])\n    elif item == \"BOW\":\n      return env.step(env.action_specs()[\"CRAFT\"])\n    elif item == \"BENCH\":\n      return env.step(env.action_specs()[\"CRAFT\"])", "island_id": 5, "scores": {"3": -1}}
