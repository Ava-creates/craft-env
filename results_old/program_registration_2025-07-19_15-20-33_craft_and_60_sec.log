{"timestamp": "2025-07-19T21:41:31.428246", "function_name": "craft", "function_body": "  def collect_item(env, item) -> float:\n    total_reward = 0.0\n    while env._current_state.inventory[item] == 0:\n      for _ in range(10):\n        _, done, obs = env.step(2)\n        total_reward += obs[\"features\"][0]\n        if done:\n          break\n    return total_reward\n\n  def use_crafting_station(env, station_index) -> float:\n    total_reward = 0.0\n    for _ in range(5):\n      _, done, obs = env.step(4)\n      total_reward += obs[\"features\"][0]\n      if done:\n        break\n    return total_reward\n\n  total_reward = 0.0\n  if item == \"plank\":\n    # Collect wood\n    total_reward += collect_item(env, env.world.cookbook.index[\"wood\"])\n    # Use workshop0\n    total_reward += use_crafting_station(env, env.world.cookbook.index[\"workshop0\"])\n  elif item == \"stick\":\n    # Collect wood\n    total_reward += collect_item(env, env.world.cookbook.index[\"wood\"])\n    # Use workshop1\n    total_reward += use_crafting_station(env, env.world.cookbook.index[\"workshop1\"])\n  elif item == \"cloth\":\n    # Collect grass\n    total_reward += collect_item(env, env.world.cookbook.index[\"grass\"])\n    # Use workshop2\n    total_reward += use_crafting_station(env, env.world.cookbook.index[\"workshop2\"])\n  elif item == \"rope\":\n    # Collect wood\n    total_reward += collect_item(env, env.world.cookbook.index[\"wood\"])\n    # Use workshop0\n    total_reward += use_crafting_station(env, env.world.cookbook.index[\"workshop0\"])\n  elif item == \"bridge\":\n    # Collect wood\n    total_reward += collect_item(env, env.world.cookbook.index[\"wood\"])\n    # Use workshop0\n    total_reward += use_crafting_station(env, env.world.cookbook.index[\"workshop0\"])\n  elif item == \"bundle\":\n    # Collect grass\n    total_reward += collect_item(env, env.world.cookbook.index[\"grass\"])\n    # Use workshop2\n    total_reward += use_crafting_station(env, env.world.cookbook.index[\"workshop2\"])", "island_id": 0, "scores": {"3": -1}}
