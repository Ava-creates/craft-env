{"timestamp": "2025-07-19T16:52:37.627849", "function_name": "craft", "function_body": "  # Get the index of the item to craft\n  item_index = env.world.cookbook.index[item]\n\n  # Find the position of the item\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      if env._current_state.grid[x, y, item_index] == 1:\n        item_pos = (x, y)\n        break\n\n  # Calculate the direction to move towards the item\n  dx = item_pos[0] - env._current_state.pos[0]\n  dy = item_pos[1] - env._current_state.pos[1]\n  if abs(dx) > abs(dy):\n    if dx > 0:\n      direction = 3  # RIGHT\n    else:\n      direction = 2  # LEFT\n  else:\n    if dy > 0:\n      direction = 1  # UP\n    else:\n      direction = 0  # DOWN\n\n  # Move towards the item\n  env.step(direction)\n  time.sleep(1)\n\n  # Craft the item\n  reward, _, _ = env.step(4)  # USE\n  time.sleep(1)\n\n  return reward", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-19T16:52:42.753129", "function_name": "craft", "function_body": "  # Move right\n  env.step(3)  # RIGHT\n  time.sleep(1)\n\n  # Move up\n  env.step(1)  # UP\n  time.sleep(1)\n\n  # Move left\n  env.step(2)  # LEFT\n  time.sleep(1)\n\n  # Craft the item\n  reward, _, _ = env.step(4)  # USE\n  time.sleep(1)\n\n  return reward", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-07-19T17:01:07.011414", "function_name": "craft", "function_body": "  def move_to_next_to(item):\n    if item in env.world.workshop_indices:\n      for workshop_index in env.world.workshop_indices:\n        if env._current_state.next_to(workshop_index):\n          return\n      for i in range(3):\n        env.step(2)\n        env.step(0)\n        env.step(3)\n        env.step(1)\n        env.step(0)\n        env.step(3)\n        env.step(1)\n    elif item == env.world.water_index:\n      for x in range(env.world._width):\n        for y in range(env.world._height):\n          if env._current_state.grid[x, y, env.world.water_index]:\n            while env._current_state.pos[0] != x:\n              if env._current_state.pos[0] < x:\n                env.step(3)\n              else:\n                env.step(2)\n            while env._current_state.pos[1] != y:\n              if env._current_state.pos[1] < y:\n                env.step(1)\n              else:\n                env.step(0)\n            return\n    elif item == env.world.stone_index:\n      for x in range(env.world._width):\n        for y in range(env.world._height):\n          if env._current_state.grid[x, y, env.world.stone_index]:\n            while env._current_state.pos[0] != x:\n              if env._current_state.pos[0] < x:\n                env.step(3)\n              else:\n                env.step(2)\n            while env._current_state.pos[1] != y:\n              if env._current_state.pos[1] < y:\n                env.step(1)\n              else:\n                env.step(0)\n            return\n    else:\n      for x in range(env.world._width):\n        for y in range(env.world._height):\n          if env._current_state.grid[x, y, item]:\n            while env._current_state.pos[0] != x:\n              if env._current_state.pos[0] < x:\n                env.step(3)\n              else:\n                env.step(2)\n            while env._current_state.pos[1] != y:\n              if env._current_state.pos[1] < y:\n                env.step(1)\n              else:\n                env.step(0)\n            return\n\n  move_to_next_to(item)\n  reward, _, _ = env.step(4)\n  return reward", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-19T17:01:08.110382", "function_name": "craft", "function_body": "  # Get the needed items to craft the given item\n  needed_items = env.world.cookbook.primitives_for(item)\n\n  # Initialize the total reward\n  total_reward = 0.0\n\n  # Loop through the needed items and collect each one\n  for needed_item, count in needed_items.items():\n    for _ in range(count):\n      # Collect the needed item\n      env.step(env.action_specs()[\"COLLECT_FUNC\"], needed_item)\n      total_reward += env._get_reward()\n\n  # Craft the item\n  env.step(env.action_specs()[\"CRAFT_FUNC\"], item)\n  total_reward += env._get_reward()\n\n  return total_reward", "island_id": 5, "scores": {"3": -1}}
