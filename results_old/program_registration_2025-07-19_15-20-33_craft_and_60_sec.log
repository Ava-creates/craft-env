{"timestamp": "2025-07-19T20:30:11.662294", "function_name": "craft", "function_body": "  # Get the index of the goal item in the CraftWorld\n  goal_index = env.world.cookbook.index[item]\n\n  # Calculate the number of steps needed to craft the goal item\n  steps_needed = env.task.steps\n\n  # Start the timer\n  start_time = time.time()\n\n  # Loop until the task is done or the time limit is reached\n  while not env._is_done() and time.time() - start_time < steps_needed:\n    # Get the current state's inventory\n    current_inventory = env._current_state.inventory.copy()\n\n    # Determine the action to take\n    action = None\n    if env._current_state.next_to(env.world.water_index):\n      action = env.action_specs()['USE']\n    elif env._current_state.next_to(env.world.stone_index):\n      action = env.action_specs()['USE']\n    elif env._current_state.next_to(env.world.workshop_indices[0]):\n      action = env.action_specs()['USE']\n    elif env._current_state.next_to(env.world.workshop_indices[1]):\n      action = env.action_specs()['USE']\n    elif env._current_state.next_to(env.world.workshop_indices[2]):\n      action = env.action_specs()['USE']\n    elif env._current_state.next_to(goal_index):\n      action = env.action_specs()['USE']\n    else:\n      # Move towards the goal item\n      goal_pos = np.argwhere(env._current_state.grid[:, :, goal_index])[0]\n      agent_pos = np.array(env._current_state.pos)\n      diff = goal_pos - agent_pos\n      if diff[0] < 0:\n        action = env.action_specs()['LEFT']\n      elif diff[0] > 0:\n        action = env.action_specs()['RIGHT']\n      elif diff[1] < 0:\n        action = env.action_specs()['DOWN']\n      else:\n        action = env.action_specs()['UP']\n\n    # Step the environment\n    reward, done, observations = env.step(action)\n\n  # Calculate the reward gathered from the env\n  reward_gathered = np.sum(env._current_state.inventory)\n\n  return reward_gathered", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-19T20:33:31.239296", "function_name": "craft", "function_body": "  # Define a mapping from item names to their corresponding indices in the Craft environment\n  item_indices = {\n      'PLANK': env.world.cookbook.index[\"plank\"],\n      'STICK': env.world.cookbook.index[\"stick\"],\n      'CLOTH': env.world.cookbook.index[\"cloth\"],\n      'ROPE': env.world.cookbook.index[\"rope\"],\n      'BRIDGE': env.world.cookbook.index[\"bridge\"],\n      'BUNDLE': env.world.cookbook.index[\"bundle\"],\n      'HAMMER': env.world.cookbook.index[\"hammer\"],\n      'KNIFE': env.world.cookbook.index[\"knife\"],\n      'BED': env.world.cookbook.index[\"bed\"],\n      'AXE': env.world.cookbook.index[\"axe\"],\n      'SHEARS': env.world.cookbook.index[\"shears\"],\n      'LADDER': env.world.cookbook.index[\"ladder\"],\n      'SLINGSHOT': env.world.cookbook.index[\"slingshot\"],\n      'ARROW': env.world.cookbook.index[\"arrow\"],\n      'BOW': env.world.cookbook.index[\"bow\"],\n      'BENCH': env.world.cookbook.index[\"bench\"],\n      'FLAG': env.world.cookbook.index[\"flag\"],\n      'GOLDARROW': env.world.cookbook.index[\"goldarrow\"]\n  }\n\n  # Convert the item name to its corresponding index\n  item_index = item_indices.get(item)\n\n  # Check if the item is valid\n  if item_index is None:\n    raise ValueError(f\"Invalid item: {item}\")\n\n  # Get the list of items required to craft the desired item\n  required_items = env.world.cookbook.primitives_for(item_index)\n\n  # Initialize variables to keep track of the crafting process\n  reward = 0.0\n  crafted_item = False\n\n  # Iterate until the desired item is crafted or the maximum number of steps is reached\n  while not crafted_item and env.steps < env.max_steps:\n    # Check if the agent has all the required items to craft the desired item\n    has_all_required_items = True\n    for required_item, required_count in required_items.items():\n      if env._current_state.inventory[required_item] < required_count:\n        has_all_required_items = False\n        break", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-19T20:33:32.538434", "function_name": "craft", "function_body": "  # First, collect all items needed to craft the desired item.\n  needed_items = env.world.cookbook.primitives_for(item)\n  for item, count in needed_items.items():\n    # Collect the item from the environment.\n    while env._current_state.inventory[item] < count:\n      env._current_state = env._current_state.step(env.action_specs()[\"COLLECT_FUNC\"])\n  \n  # Then, craft the desired item.\n  env._current_state = env._current_state.step(env.action_specs()[\"CRAFT_FUNC\"])\n\n  return env._get_reward()", "island_id": 6, "scores": {"3": -1}}
