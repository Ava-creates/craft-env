ory_items:\n          tool_name = state.world.cookbook.index.get(item_idx)\n          if tool_name:\n              resource_name = None\n\n              if primitive == 'GOLD':\n                  if tool_name == 'BRIDGE' and state.next_to(state.world.cookbook.index['WATER']):\n                      resource_name = 'WATER'\n              elif primitive == 'GEM':\n                  if tool_name == 'PICKAXE' and state.next_to(state.world.cookbook.index['ROCK']):\n                      resource_name = 'ROCK'\n              elif primitive == 'WOOD':\n                  if tool_name == 'AXE' and state.next_to(state.world.cookbook.index['TREE']):\n                      resource_name = 'TREE'\n\n              if resource_name:\n                  # Use the tool on the adjacent resource\n                  resource_index = state.world.cookbook.index[resource_name]\n                  adjacent_cells = [\n                      (pos[0], pos[1] - 1),  # UP\n                      (pos[0], pos[1] + 1),  # DOWN\n                      (pos[0] - 1, pos[1]),  # LEFT\n                      (pos[0] + 1, pos[1])   # RIGHT\n                  ]\n                  for adj_pos in adjacent_cells:\n                      if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                          cell_index = np.argmax(state.grid[adj_pos])\n                          if cell_index == resource_index:\n                              new_inv = inv.copy()\n                              new_inv[item_idx] -= 1  # Consume the tool\n                              queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                              break\n\n  return [], -1, []  # Return empty list and negative reward if target is unreachable", "island_id": 6, "scores": {"3": 0.5}}
