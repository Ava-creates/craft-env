\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['DIRT']:\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n          elif primitive == 'ROCK' and state.world.cookbook.index.get('AXE') == item_idx:\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['TREE']:\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n  return [], -1, []  # Return empty list and negative reward if target is unreachable", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-12T19:55:17.142486", "function_name": "collect", "function_body": "  MAX_STEPS = 100\n  UP, DOWN, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  action_list = []\n  state = env._current_state\n  target_index = state.world.cookbook.index[primitive]\n\n  # Priority queue for BFS (position, steps, inventory, actions)\n  queue = collections.deque([(state.pos, 0, np.copy(state.inventory), [])])\n  visited = set()\n\n  while queue:\n      pos, steps, inv, actions = queue.popleft()\n\n      if steps >= MAX_STEPS:\n          continue\n\n      # Check if the position and inventory have been visited\n      state_key = (tuple(pos), tuple(inv))\n      if state_key in visited:\n          continue\n      visited.add(state_key)\n\n      # Create a new state object for the current BFS step\n      state = craft.CraftState(\n          scenario=state.scenario,\n          grid=np.copy(state.grid),\n          pos=pos,\n          dir=state.dir,\n          inventory=np.copy(inv)\n      )\n\n      # Check if the target primitive is next to the agent\n      if state.next_to(target_index):\n          action_list = actions + [USE]\n          return action_list, 0, action_list\n\n      # Generate possible moves and use of tools\n      new_positions = [\n          (pos[0], pos[1] - 1),  # UP\n          (pos[0], pos[1] + 1),  # DOWN\n          (pos[0] - 1, pos[1]),  # LEFT\n          (pos[0] + 1, pos[1])   # RIGHT\n      ]\n\n      for i, new_pos in enumerate(new_positions):\n          if 0 <= new_pos[0] < state.grid.shape[0] and 0 <= new_pos[1] < state.grid.shape[1]:\n              # Check if the move is valid (not a boundary or non-grabbable entity)\n              cell_index = np.argmax(state.grid[new_pos])\n              if cell_index not in state.world.non_grabbable_indices:\n                  queue.append((new_pos, steps + 1, inv, actions + [i]))\n\n      # Check for tool usage\n      inventory_items = np.where(inv > 0)[0]\n      for item_idx in inventory_items:\n          tool_effect = None\n\n          if primitive == 'GOLD':\n              if state.world.cookbook.index.get('BRIDGE') == item_idx:\n                  tool_effect = 'WATER'\n              elif state.world.cookbook.index.get('BOAT') == item_idx:\n                  tool_effect = 'WATER'  # Alternative tool for WATER\n          elif primitive == 'GEM':\n              if state.world.cookbook.index.get('PICKAXE') == item_idx:\n                  tool_effect = 'ROCK'\n              elif state.world.cookbook.index.get('HAMMER') == item_idx:\n                  tool_effect = 'ROCK'  # Alternative tool for ROCK\n\n          if tool_effect:\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index[tool_effect]:\n                          # Use tool to interact with the environment\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the tool\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n      # Consider using BRIDGE or BOAT to cross WATER if not adjacent to target\n      if primitive == 'GOLD':\n          bridge_index = state.world.cookbook.index.get('BRIDGE')\n          boat_index = state.world.cookbook.index.get('BOAT')\n\n          if inv[bridge_index] > 0:\n              # Find the nearest water cell and attempt to place a bridge\n              for i in range(state.grid.shape[0]):\n                  for j in range(state.grid.shape[1]):\n                      if np.argmax(state.grid[(i, j)]) == state.world.cookbook.index['WATER']:\n                          path_to_water = find_path_bfs(state.pos, (i, j), state.grid, state.world.non_grabbable_indices)\n                          if path_to_water:\n                              action_list = actions + [USE] + path_to_water\n                              queue.append((path_to_water[-1], steps + len(path_to_water) + 1, inv, action_list))\n                              break\n\n          if inv[boat_index] > 0:\n              # Find the nearest water cell and attempt to use a boat\n              for i in range(state.grid.shape[0]):\n                  for j in range(state.grid.shape[1]):\n                      if np.argmax(state.grid[(i, j)]) == state.world.cookbook.index['WATER']:\n                          path_to_water = find_path_bfs(state.pos, (i, j), state.grid, state.world.non_grabbable_indices)\n                          if path_to_water:\n                              action_list = actions + [USE] + path_to_water\n                              queue.append((path_to_water[-1], steps + len(path_to_water) + 1, inv, action_list))\n                              break\n\n      # Consider using PICKAXE or HAMMER to mine ROCK if not adjacent to target\n      if primitive == 'GEM':\n          pickaxe_index = state.world.cookbook.index.get('PICKAXE')\n          hammer_index = state.world.cookbook.index.get('HAMMER')\n\n          if inv[pickaxe_index] > 0:\n              # Find the nearest rock cell and attempt to mine a gem\n              for i in range(state.grid.shape[0]):\n                  for j in range(state.grid.shape[1]):\n                      if np.argmax(state.grid[(i, j)]) == state.world.cookbook.index['ROCK']:\n                          path_to_rock = find_path_bfs(state.pos, (i, j), state.grid, state.world.non_grabbable_indices)\n                          if path_to_rock:\n                              action_list = actions + [USE] + path_to_rock\n                              queue.append((path_to_rock[-1], steps + len(path_to_rock) + 1, inv, action_list))\n                              break\n\n          if inv[hammer_index] > 0:\n              # Find the nearest rock cell and attempt to mine a gem\n              for i in range(state.grid.shape[0]):\n                  for j in range(state.grid.shape[1]):\n                      if np.argmax(state.grid[(i, j)]) == state.world.cookbook.index['ROCK']:\n                          path_to_rock = find_path_bfs(state.pos, (i, j), state.grid, state.world.non_grabbable_indices)\n                          if path_to_rock:\n                              action_list = actions + [USE] + path_to_rock\n                              queue.append((path_to_rock[-1], steps + len(path_to_rock) + 1, inv, action_list))\n                              break\n\n      # Consider using other tools for different obstacles or target primitives\n      if primitive == 'WOOD':\n          axe_index = state.world.cookbook.index.get('AXE')\n\n          if inv[axe_index] > 0:\n              # Find the nearest tree cell and attempt to chop wood\n              for i in range(state.grid.shape[0]):\n                  for j in range(state.grid.shape[1]):\n                      if np.argmax(state.grid[(i, j)]) == state.world.cookbook.index['TREE']:\n                          path_to_tree = find_path_bfs(state.pos, (i, j), state.grid, state.world.non_grabbable_indices)\n                          if path_to_tree:\n                              action_list = actions + [USE] + path_to_tree\n                              queue.append((path_to_tree[-1], steps + len(path_to_tree) + 1, inv, action_list))\n                              break\n\n      # Add more tool and obstacle handling as needed...\n\n  return [], -1, []  # Return empty list and negative reward if target is unreachable", "island_id": 0, "scores": {"3": 0.5}}
