{"timestamp": "2025-08-13T00:50:06.633830", "function_name": "collect", "function_body": "  MAX_STEPS = 50\n  UP, DOWN, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  target_index = env._current_state.world.cookbook.index[primitive]\n  initial_state = env._current_state\n\n  # Priority queue for BFS (position, steps, inventory, actions)\n  queue = collections.deque([(initial_state.pos, 0, np.copy(initial_state.inventory), [])])\n  visited = set()\n\n  while queue:\n      pos, steps, inv, action_list = queue.popleft()\n\n      if steps >= MAX_STEPS:\n          continue\n\n      # Check if the position and inventory have been visited\n      state_key = (tuple(pos), tuple(inv))\n      if state_key in visited:\n          continue\n      visited.add(state_key)\n\n      # Create a new state object for the current BFS step\n      state = craft.CraftState(\n          scenario=initial_state.scenario,\n          grid=np.copy(initial_state.grid),\n          pos=pos,\n          dir=initial_state.dir,\n          inventory=np.copy(inv)\n      )\n\n      # Check if the target primitive is next to the agent\n      if state.next_to(target_index):\n          return action_list + [USE], 0, action_list + [USE]\n\n      # Generate possible moves and use of tools\n      for direction in [(UP, 0), (DOWN, 1), (LEFT, 2), (RIGHT, 3)]:\n          new_pos = (pos[0] + (-1 if direction[0] == LEFT else 1 if direction[0] == RIGHT else 0),\n                     pos[1] + (-1 if direction[0] == UP else 1 if direction[0] == DOWN else 0))\n\n          # Check if the move is within bounds\n          if 0 <= new_pos[0] < state.grid.shape[0] and 0 <= new_pos[1] < state.grid.shape[1]:\n              cell_index = np.argmax(state.grid[new_pos])\n\n              # Check if the move is valid (not a boundary or non-grabbable entity)\n              if cell_index not in state.world.non_grabbable_indices:\n                  queue.append((new_pos, steps + 1, inv, action_list + [direction[1]]))\n\n      # Check for tool usage\n      inventory_items = np.where(inv > 0)[0]\n      for item_idx in inventory_items:\n          tool_use_action = None\n\n          if primitive == 'GOLD' and state.world.cookbook.index.get('BRIDGE') == item_idx:\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['WATER']:\n                          tool_use_action = USE\n                          break\n\n          elif primitive in ['GEM', 'WOOD'] and item_idx in [\n              state.world.cookbook.index.get('PICKAXE'),\n              state.world.cookbook.index.get('AXE')\n          ]:\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if (primitive == 'GEM' and cell_index == state.world.cookbook.index['ROCK']) or\\\n                         (primitive == 'WOOD' and cell_index == state.world.cookbook.index['TREE']):\n                          tool_use_action = USE\n                          break\n\n          elif primitive in ['IRON'] and item_idx in [\n              state.world.cookbook.index.get('PICKAXE'),\n              state.world.cookbook.index.get('HAMMER')\n          ]:\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if (primitive == 'IRON' and cell_index == state.world.cookbook.index['IRON_ORE']):\n                          tool_use_action = USE\n                          break\n\n          if tool_use_action is not None:\n              new_inv = inv.copy()\n              new_inv[item_idx] -= 1  # Consume the tool\n              queue.append((pos, steps + 2, new_inv, action_list + [tool_use_action]))\n\n  return [], -1, []  # Return empty list and negative reward if target is unreachable", "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-08-13T00:50:07.616914", "function_name": "collect", "function_body": "  MAX_STEPS = 50\n  UP, DOWN, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  target_index = env._current_state.world.cookbook.index[primitive]\n  initial_state = env._current_state\n\n  # Priority queue for BFS (position, steps, inventory, actions)\n  queue = collections.deque([(initial_state.pos, 0, np.copy(initial_state.inventory), [])])\n  visited = set()\n\n  while queue:\n      pos, steps, inv, action_list = queue.popleft()\n\n      if steps >= MAX_STEPS:\n          continue\n\n      # Check if the position and inventory have been visited\n      state_key = (tuple(pos), tuple(inv))\n      if state_key in visited:\n          continue\n      visited.add(state_key)\n\n      # Create a new state object for the current BFS step\n      state = craft.CraftState(\n          scenario=initial_state.scenario,\n          grid=np.copy(initial_state.grid),\n          pos=pos,\n          dir=initial_state.dir,\n          inventory=np.copy(inv)\n      )\n\n      # Check if the target primitive is next to the agent\n      if state.next_to(target_index):\n          return action_list + [USE], 0, action_list + [USE]\n\n      # Generate possible moves and use of tools\n      for direction in [(UP, 0), (DOWN, 1), (LEFT, 2), (RIGHT, 3)]:\n          new_pos = (pos[0] + (-1 if direction[0] == LEFT else 1 if direction[0] == RIGHT else 0),\n                     pos[1] + (-1 if direction[0] == UP else 1 if direction[0] == DOWN else 0))\n\n          # Check if the move is within bounds\n          if 0 <= new_pos[0] < state.grid.shape[0] and 0 <= new_pos[1] < state.grid.shape[1]:\n              cell_index = np.argmax(state.grid[new_pos])\n\n              # Check if the move is valid (not a boundary or non-grabbable entity)\n              if cell_index not in state.world.non_grabbable_indices:\n                  queue.append((new_pos, steps + 1, inv, action_list + [direction[1]]))\n\n      # Check for tool usage\n      inventory_items = np.where(inv > 0)[0]\n      for item_idx in inventory_items:\n          if primitive == 'GOLD' and state.world.cookbook.index.get('BRIDGE') == item_idx:\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['WATER']:\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the tool\n                          queue.append((adj_pos, steps + 2, new_inv, action_list + [USE]))\n                          break\n\n          elif primitive in ['GEM', 'WOOD'] and item_idx in [\n              state.world.cookbook.index.get('PICKAXE'),\n              state.world.cookbook.index.get('AXE')\n          ]:\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if (primitive == 'GEM' and cell_index == state.world.cookbook.index['ROCK']) or\\\n                         (primitive == 'WOOD' and cell_index == state.world.cookbook.index['TREE']):\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the tool\n                          queue.append((adj_pos, steps + 2, 