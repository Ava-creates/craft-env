  # Check for tool usage\n      inventory_items = np.where(inv > 0)[0]\n      \n      for adj_pos in adjacent_cells:\n          if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n              cell_index = np.argmax(state.grid[adj_pos])\n              \n              tool_usage = {\n                  'BRIDGE': ('WATER', USE),\n                  'PICKAXE': ('ROCK', USE),\n                  'AXE': ('WOOD', USE)\n              }\n              \n              for tool, (target, action) in tool_usage.items():\n                  if state.world.cookbook.index.get(tool) == cell_index:\n                      adjacent_cells_tool = [\n                          (adj_pos[0], adj_pos[1] - 1),  # UP\n                          (adj_pos[0], adj_pos[1] + 1),  # DOWN\n                          (adj_pos[0] - 1, adj_pos[1]),  # LEFT\n                          (adj_pos[0] + 1, adj_pos[1])   # RIGHT\n                      ]\n                      \n                      for next_adj_pos in adjacent_cells_tool:\n                          if 0 <= next_adj_pos[0] < state.grid.shape[0] and 0 <= next_adj_pos[1] < state.grid.shape[1]:\n                              next_cell_index = np.argmax(state.grid[next_adj_pos])\n                              if state.world.cookbook.index.get(target) == next_cell_index:\n                                  new_inv = inv.copy()\n                                  new_inv[state.world.cookbook.index[tool]] -= 1  # Consume the tool\n                                  queue.append((next_adj_pos, steps + 2, new_inv, actions + [action]))\n                                  break\n\n  return [], -1, []  # Return empty list and negative reward if target is unreachable", "island_id": 1, "scores": {"3": -1}}
