tory_items = np.where(state.inventory > 0)[0]\n          tool_index = state.world.cookbook.index.get(tool_name)\n          resource_index = state.world.cookbook.index.get(resource_name)\n\n          if tool_index is not None and resource_index is not None:\n              adjacent_cells = [\n                  (state.pos[0], state.pos[1] - 1),  # UP\n                  (state.pos[0], state.pos[1] + 1),  # DOWN\n                  (state.pos[0] - 1, state.pos[1]),  # LEFT\n                  (state.pos[0] + 1, state.pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == resource_index:\n                          new_inv = state.inventory.copy()\n                          new_inv[tool_index] -= 1  # Consume the tool\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n      # Check for BRIDGE usage for WATER when collecting GOLD\n      if primitive == 'GOLD':\n          use_tool(state, target_index, 'BRIDGE', 'WATER')\n\n      # Check for PICKAXE usage for GEM\n      if primitive == 'GEM':\n          use_tool(state, target_index, 'PICKAXE', 'ROCK')\n\n      # Check for AXE usage for WOOD\n      if primitive == 'WOOD':\n          use_tool(state, target_index, 'AXE', 'TREE')\n\n      # General tool usage logic (e.g., using SHEARS for LEAVES)\n      if primitive == 'LEAVES':\n          adjacent_cells = [\n              (pos[0], pos[1] - 1),  # UP\n              (pos[0], pos[1] + 1),  # DOWN\n              (pos[0] - 1, pos[1]),  # LEFT\n              (pos[0] + 1, pos[1])   # RIGHT\n          ]\n          for adj_pos in adjacent_cells:\n              if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                  cell_index = np.argmax(state.grid[adj_pos])\n                  if cell_index == state.world.cookbook.index['LEAVES']:\n                      # Check for SHEARS in inventory\n                      shears_idx = state.world.cookbook.index.get('SHEARS')\n                      if shears_idx is not None and inv[shears_idx] > 0:\n                          new_inv = inv.copy()\n                          new_inv[shears_idx] -= 1  # Consume the shears\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n      # Add additional tool usage logic for other primitives if needed\n\n  return [], -1, []  # Return empty list and negative reward if target is unreachable", "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-08-12T15:03:33.320894", "function_name": "collect", "function_body": "  # Extract the current grid and position from the environment.\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n\n  # Map the string primitive to its corresponding index in the world.\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Use a Breadth-First Search (BFS) algorithm to find the shortest path to the nearest primitive.\n  action_list, reward = bfs_search_for_primitive(env, pos, primitive_index)\n\n  return action_list, reward", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-08-12T15:03:34.305778", "function_name": "collect", "function_body": "  from collections import deque\n  import heapq\n\n  class ActionNode:\n    def __init__(self, pos, dir, inventory, actions_taken, cost):\n      self.pos = pos\n      self.dir = dir\n      self.inventory = inventory.copy()\n      self.actions_taken = actions_taken[:]\n      self.cost = cost\n    \n    def __lt__(self, other):  # For priority queue usage\n      return self.cost < other.cost\n\n  start_state = env._current_state\n  target_primitive_idx = start_state.world.cookbook.index[primitive]\n  \n  visited_states = set()\n  pq = []\n  heapq.heappush(pq, ActionNode(start_state.pos, start_state.dir, start_state.inventory, [], 0))\n\n  while pq:\n    current_node = heapq.heappop(pq)\n\n    # If we already have the target primitive in our inventory\n    if current_node.inventory[target_primitive_idx] > 0:\n      return current_node.actions_taken\n\n    state_tuple = (tuple(current_node.pos), current_node.dir, tuple(current_node.inventory))\n    \n    if state_tuple in visited_states:\n      continue\n    \n    visited_states.add(state_tuple)\n\n    for action in range(start_state.world.n_actions):\n      next_reward, next_state = start_state.step(action)\n      \n      # Create a new node representing the resulting state\n      next_node = ActionNode(next_state.pos, next_state.dir, next_state.inventory, current_node.actions_taken + [action], current_node.cost - next_reward)\n\n      if action == 4:  # USE action\n        if next_state.grid[current_node.pos] == target_primitive_idx:\n          heapq.heappush(pq, next_node)\n      \n      else:  # MOVEMENT actions\n        heapq.heappush(pq, next_node)\n\n  return []  # Return empty list if no path is found", "island_id": 4, "scores": {"3": -1}}
