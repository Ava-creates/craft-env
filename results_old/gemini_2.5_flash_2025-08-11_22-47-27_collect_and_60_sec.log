m_name = state.world.cookbook.get(item_idx)\n          if item_name == 'BRIDGE' and target_index == state.world.cookbook.index['GOLD']:\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['WATER']:\n                          # Use BRIDGE to cross WATER\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the bridge\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n          elif item_name == 'PICKAXE' and target_index in [state.world.cookbook.index['GEM'], state.world.cookbook.index['STONE']]:\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['ROCK']:\n                          # Use PICKAXE to mine ROCK\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the pickaxe\n                          new_inv[cell_index] += 1  # Gain STONE\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n  return [], -1, []  # Return empty list and negative reward if target is unreachable", "island_id": 1, "scores": {"3": -1}}
