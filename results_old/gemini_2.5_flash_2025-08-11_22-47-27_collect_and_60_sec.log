)\n          \n          # Check if the move is valid (not a boundary or non-grabbable entity)\n          if cell_index not in state.world.non_grabbable_indices:\n              queue.append((new_pos, steps + 1, inv, actions + [get_action(pos, new_pos)]))\n      \n      # Check for tool usage\n      inventory_items = np.where(inv > 0)[0]\n      for item_idx in inventory_items:\n          # Determine the type of tool and its effect (e.g., BRIDGE for WATER)\n          if primitive == 'GOLD' and state.world.cookbook.index.get('BRIDGE') == item_idx:\n              # Check if there's water next to the agent\n              for adj_pos in adjacent_cells:\n                  if not (0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]):\n                      continue\n\n                  cell_index = np.argmax(state.grid[adj_pos])\n                  \n                  if cell_index == state.world.cookbook.index['WATER']:\n                      # Use BRIDGE to cross WATER\n                      new_inv = inv.copy()\n                      new_inv[item_idx] -= 1  # Consume the bridge\n                      queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                      break\n\n          elif primitive == 'GEM' and state.world.cookbook.index.get('PICKAXE') == item_idx:\n              # Check if there's rock next to the agent\n              for adj_pos in adjacent_cells:\n                  if not (0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]):\n                      continue\n\n                  cell_index = np.argmax(state.grid[adj_pos])\n                  \n                  if cell_index == state.world.cookbook.index['ROCK']:\n                      # Use PICKAXE to mine GEM\n                      new_inv = inv.copy()\n                      new_inv[item_idx] -= 1  # Consume the pickaxe\n                      queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                      break\n\n          elif primitive == 'WOOD' and state.world.cookbook.index.get('AXE') == item_idx:\n              # Check if there's tree next to the agent\n              for adj_pos in adjacent_cells:\n                  if not (0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]):\n                      continue\n\n                  cell_index = np.argmax(state.grid[adj_pos])\n                  \n                  if cell_index == state.world.cookbook.index['TREE']:\n                      # Use AXE to cut down TREE\n                      new_inv = inv.copy()\n                      new_inv[item_idx] -= 1  # Consume the axe\n                      queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                      break\n\n          elif primitive == 'CLAY' and state.world.cookbook.index.get('SHOVEL') == item_idx:\n              # Check if there's clay next to the agent\n              for adj_pos in adjacent_cells:\n                  if not (0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]):\n                      continue\n\n                  cell_index = np.argmax(state.grid[adj_pos])\n                  \n                  if cell_index == state.world.cookbook.index['CLAY']:\n                      # Use SHOVEL to dig up CLAY\n                      new_inv = inv.copy()\n                      new_inv[item_idx] -= 1  # Consume the shovel\n                      queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                      break\n\n          elif primitive == 'IRON' and state.world.cookbook.index.get('PICKAXE') == item_idx:\n              # Check if there's iron ore next to the agent\n              for adj_pos in adjacent_cells:\n                  if not (0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]):\n                      continue\n\n                  cell_index = np.argmax(state.grid[adj_pos])\n                  \n                  if cell_index == state.world.cookbook.index['IRON_ORE']:\n                      # Use PICKAXE to mine IRON\n                      new_inv = inv.copy()\n                      new_inv[item_idx] -= 1  # Consume the pickaxe\n                      queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                      break\n\n          elif primitive == 'COAL' and state.world.cookbook.index.get('PICKAXE') == item_idx:\n              # Check if there's coal next to the agent\n              for adj_pos in adjacent_cells:\n                  if not (0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]):\n                      continue\n\n                  cell_index = np.argmax(state.grid[adj_pos])\n                  \n                  if cell_index == state.world.cookbook.index['COAL']:\n                      # Use PICKAXE to mine COAL\n                      new_inv = inv.copy()\n                      new_inv[item_idx] -= 1  # Consume the pickaxe\n                      queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                      break\n\n  return [], -1, []  # Return empty list and negative reward if target is unreachable", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-08-12T16:43:36.372180", "function_name": "collect", "function_body": "  # Initialize the pathfinding queue and visited set\n  from collections import deque\n  q = deque([(state.grid, state.pos, state.dir, [], 0)])\n  visited = set()\n  \n  # Get the index for the primitive we are looking for\n  target_index = env.world.cookbook.index[primitive]\n  \n  while q:\n      grid, pos, dir, actions, steps_taken = q.popleft()\n      \n      if (tuple(grid.tobytes()), pos, dir) in visited:\n          continue\n      \n      # Mark this state as visited\n      visited.add((tuple(grid.tobytes()), pos, dir))\n      \n      # Check if we are next to the target primitive\n      if state.next_to(target_index):\n          action_list = actions + [env.action_specs()['USE']]\n          return env._current_state, 0.0, action_list\n      \n      # Generate possible moves (UP, DOWN, LEFT, RIGHT)\n      for move_action in range(4):  # Assuming actions are indexed from 0 to 3 for UP, DOWN, LEFT, RIGHT\n          new_state = state.step(move_action)[1]\n          q.append((new_state.grid, new_state.pos, new_state.dir, actions + [move_action], steps_taken + 1))\n      \n      # Generate possible tool usage actions (USE)\n      if state.inventory[target_index] > 0:\n          new_state = state.step(env.action_specs()['USE'])[1]\n          q.append((new_state.grid, new_state.pos, new_state.dir, actions + [env.action_specs()['USE']], steps_taken + 1))\n      \n      # Generate possible crafting actions (if applicable)\n      # This part is not yet implemented and would require additional logic to determine if crafting can be done with current inventory.\n  \n  return state, 0.0, action_list", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-08-12T16:43:37.334170", "function_name": "collect", "function_body": "  # Get the index for the desired primitive\n  i_primitive = env.world.cookbook.index(primitive)\n  \n  if i_primitive is None:\n      raise ValueError(f\"Primitive '{primitive}' not found in cookbook.\")\n\n  action_list = []\n  reward = 0.0\n  state = env._current_state\n\n  # Breadth-first search (BFS) to find the shortest path to collect the primitive\n  queue = collections.deque([(state, [])])  # (current_state, actions_taken)\n  visited_states = set()\n  \n  while queue:\n      current_state, actions_taken = queue.popleft()\n      \n      if current_state.next_to(i_primitive):\n          action_list = actions_taken + [env.action_specs()[env.world.cookbook.index('USE')]]\n          break\n      \n      for direction in ['UP', 'DOWN', 'LEFT', 'RIGHT']:\n          next_action = env.action_specs()[direction]\n          _, new_state = current_state.step(next_action)\n          \n          if new_state not in visited_states:\n              queue.append((new_state, actions_taken + [next_action]))\n              visited_states.add(new_state)\n\n  # Execute the actions\n  for a in action_list:\n      r, state = env.step(state, a)\n      reward += r\n\n  return state, reward, action_list", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-08-12T16:46:04.488867", "function_name": "collect", "function_body": "  MAX_STEPS = 100\n  UP, DOWN, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  action_list = []\n  state = env._current_state\n  target_index = state.world.cookbook.index[primitive]\n\n  # Priority queue for BFS (position, steps, inventory, actions)\n  queue = collections.deque([(state.pos, 0, np.copy(state.inventory), [])])\n  visited = set()\n\n  while queue:\n      pos, steps, inv, actions = queue.popleft()\n\n      if steps >= MAX_STEPS:\n          continue\n\n      # Check if the position and inventory have been visited\n      state_key = (tuple(pos), tuple(inv))\n      if state_key in visited:\n          continue\n      visited.add(state_key)\n\n      # Create a new state object for the current BFS step\n      state = craft.CraftState(\n          scenario=state.scenario,\n          grid=np.copy(state.grid),\n          pos=pos,\n          dir=state.dir,\n          inventory=np.copy(inv)\n      )\n\n      # Check if the target primitive is next to the agent\n      adjacent_cells = [\n          (pos[0], pos[1] - 1),  # UP\n          (pos[0], pos[1] + 1),  # DOWN\n          (pos[0] - 1, pos[1]),  # LEFT\n          (pos[0] + 1, pos[1])   # RIGHT\n      ]\n      \n      for adj_pos in adjacent_cells:\n          if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n              cell_index = np.argmax(state.grid[adj_pos])\n              if cell_index == target_index:\n                  # Found the primitive next to the agent\n                  direction = actions[-1] if actions else None\n                  move_to_target_directions = {\n                      (pos[0], pos[1] - 1): UP,   # Target is above\n                      (pos[0], pos[1] + 1): DOWN, # Target is below\n                      (pos[0] - 1, pos[1]): LEFT, # Target is to the left\n                      (pos[0] + 1, pos[1]): RIGHT  # Target is to the right\n                  }\n                  \n                  move_to_target = move_to_target_directions.get(adj_pos)\n                  if direction == move_to_target:\n                      action_list = actions + [USE]\n                      return action_list, 0, action_list\n\n      # Generate possible moves and use of tools\n      new_positions = [\n          (pos[0], pos[1] - 1),  # UP\n          (pos[0], pos[1] + 1),  # DOWN\n          (pos[0] - 1, pos[1]),  # LEFT\n          (pos[0] + 1, pos[1])   # RIGHT\n      ]\n\n      for i, new_pos in enumerate(new_positions):\n          if 0 <= new_pos[0] < state.grid.shape[0] and 0 <= new_pos[1] < state.grid.shape[1]:\n              cell_index = np.argmax(state.grid[new_pos])\n              if cell_index not in state.world.non_grabbable_indices:\n                  queue.append((new_pos, steps + 1, inv, actions + [i]))\n\n      # Check for tool usage\n      inventory_items = np.where(inv > 0)[0]\n      for item_idx in inventory_items:\n          # Determine the type of tool and its effect (e.g., BRIDGE for WATER)\n          if primitive == 'GOLD' and state.world.cookbook.index.get('BRIDGE') == item_idx:\n              # Check if there's water next to the agent\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['WATER']:\n                          # Use BRIDGE to cross WATER\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the bridge\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n          elif primitive == 'GEM' and state.world.cookbook.index.get('PICKAXE') == item_idx:\n              # Check if there's a rock next to the agent\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['ROCK']:\n                          # Use PICKAXE to mine GEM\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the pickaxe\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n          elif primitive == 'IRON' and state.world.cookbook.index.get('PICKAXE') == item_idx:\n              # Check if there's an iron deposit next to the agent\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['IRON']:\n                          # Use PICKAXE to mine IRON\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the pickaxe\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n          elif primitive == 'WOOD' and state.world.cookbook.index.get('AXE') == item_idx:\n              # Check if there's wood next to the agent\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['WOOD']:\n                          # Use AXE to collect WOOD\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the axe\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n  return [], -1, []  # Return empty list and negative reward if target is unreachable", "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-08-12T16:46:05.483982", "function_name": "collect", "function_body": "  def get_adjacent_cells(pos):\n      x, y = pos\n      return [(x-1, y), (x+1, y), (x, y-1), (x, y+1)]\n\n  MAX_STEPS = 100\n  UP, DOWN, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  action_list = []\n  state = env._current_state\n  target_index = state.world.cookbook.index[primitive]\n\n  # Priority queue for BFS (position, steps, inventory, actions)\n  queue = collections.deque([(state.pos, 0, np.copy(state.inventory), [])])\n  visited = set()\n\n  while queue:\n      pos, steps, inv, actions = queue.popleft()\n\n      if steps >= MAX_STEPS:\n          continue\n\n      # Check if the position and inventory have been visited\n      state_key = (tuple(pos), tuple(inv))\n      if state_key in visited:\n          continue\n      visited.add(state_key)\n\n      # Create a new state object for the current BFS step\n      state = craft.CraftState(\n          scenario=state.scenario,\n          grid=np.copy(state.grid),\n          pos=pos,\n          dir=state.dir,\n          inventory=np.copy(inv)\n      )\n\n      # Check if the target primitive is next to the agent\n      adjacent_cells = get_adjacent_cells(pos)\n      for adj_pos in adjacent_cells:\n          if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n              cell_index = np.argmax(state.grid[adj_pos])\n              if cell_index == target_index:\n                  action_list = actions + [USE]\n                  return action_list, 0, action_list\n\n      # Generate possible moves and use of tools\n      for i, new_pos in enumerate(get_adjacent_cells(pos)):\n          if 0 <= new_pos[0] < state.grid.shape[0] and 0 <= new_pos[1] < state.grid.shape[1]:\n              cell_index = np.argmax(state.grid[new_pos])\n              if cell_index not in state.world.non_grabbable_indices:\n                  queue.append((new_pos, steps + 1, inv, actions + [i]))\n\n      # Check for tool usage\n      inventory_items = np.where(inv > 0)[0]\n      for item_idx in inventory_items:\n          tool_actions = {\n              'BRIDGE': (state.world.cookbook.index['WATER'], USE),\n              'PICKAXE': (state.world.cookbook.index['ROCK'], USE),\n              'PICKAXE': (state.world.cookbook.index['IRON'], USE),\n              'AXE': (state.world.cookbook.index['WOOD'], USE)\n          }\n          if state.world.cookbook[item_idx] in tool_actions:\n              target_cell_index, use_action = tool_actions[state.world.cookbook[item_idx]]\n              adjacent_cells = get_adjacent_cells(pos)\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == target_cell_index:\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the tool\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [use_action]))\n                          break\n\n  return [], -1, []  # Return empty list and negative reward if target is unreachable", "island_id": 8, "scores": {"3": -1}}
