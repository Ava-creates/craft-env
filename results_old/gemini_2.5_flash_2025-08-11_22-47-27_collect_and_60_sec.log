{"timestamp": "2025-08-12T16:49:26.726632", "function_name": "collect", "function_body": "  MAX_STEPS = 100\n  UP, DOWN, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  action_list = []\n  state = env._current_state\n  target_index = state.world.cookbook.index[primitive]\n\n  # Priority queue for BFS (position, steps, inventory, actions)\n  queue = collections.deque([(state.pos, 0, np.copy(state.inventory), [])])\n  visited = set()\n\n  while queue:\n      pos, steps, inv, actions = queue.popleft()\n\n      if steps >= MAX_STEPS:\n          continue\n\n      # Check if the position and inventory have been visited\n      state_key = (tuple(pos), tuple(inv))\n      if state_key in visited:\n          continue\n      visited.add(state_key)\n\n      # Create a new state object for the current BFS step\n      state = craft.CraftState(\n          scenario=state.scenario,\n          grid=np.copy(state.grid),\n          pos=pos,\n          dir=state.dir,\n          inventory=np.copy(inv)\n      )\n\n      # Check if the target primitive is next to the agent\n      if state.next_to(target_index):\n          action_list = actions + [USE]\n          return action_list, 0, action_list\n\n      # Generate possible moves and use of tools\n      new_positions = [\n          (pos[0], pos[1] - 1),  # UP\n          (pos[0], pos[1] + 1),  # DOWN\n          (pos[0] - 1, pos[1]),  # LEFT\n          (pos[0] + 1, pos[1])   # RIGHT\n      ]\n\n      for i, new_pos in enumerate(new_positions):\n          if 0 <= new_pos[0] < state.grid.shape[0] and 0 <= new_pos[1] < state.grid.shape[1]:\n              # Check if the move is valid (not a boundary or non-grabbable entity)\n              cell_index = np.argmax(state.grid[new_pos])\n              if cell_index not in state.world.non_grabbable_indices:\n                  queue.append((new_pos, steps + 1, inv, actions + [i]))\n\n      # Check for tool usage\n      inventory_items = np.where(inv > 0)[0]\n      for item_idx in inventory_items:\n          # Determine the type of tool and its effect (e.g., BRIDGE for WATER)\n          if primitive == 'GOLD' and state.world.cookbook.index.get('BRIDGE') == item_idx:\n              target_indices = [state.world.cookbook.index['WATER']]\n          elif primitive in ['GEM', 'IRON'] and state.world.cookbook.index.get('PICKAXE') == item_idx:\n              target_indices = [state.world.cookbook.index['ROCK']]\n          else:\n              continue\n\n          # Check if the target entity is next to the agent\n          adjacent_cells = [\n              (pos[0], pos[1] - 1),  # UP\n              (pos[0], pos[1] + 1),  # DOWN\n              (pos[0] - 1, pos[1]),  # LEFT\n              (pos[0] + 1, pos[1])   # RIGHT\n          ]\n          for adj_pos in adjacent_cells:\n              if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                  cell_index = np.argmax(state.grid[adj_pos])\n                  if cell_index in target_indices:\n                      # Use the tool on the target entity\n                      new_inv = inv.copy()\n                      new_inv[item_idx] -= 1  # Consume the tool\n                      queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                      break\n\n  return [], -1, []  # Return empty list and negative reward if target is unreachable", "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-08-12T16:50:47.341564", "function_name": "collect", "function_body": "  def is_adjacent(pos, target):\n    x, y = pos\n    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n      nx, ny = x + dx, y + dy\n      if 0 <= nx < env.grid.shape[0] and 0 <= ny < env.grid.shape[1]:\n        if np.argmax(env.grid[nx, ny]) == target:\n          return True, (nx, ny)\n    return False, None\n\n  def bfs(start, goal):\n    queue = deque([(start, [])])\n    visited = set()\n    while queue:\n      pos, path = queue.popleft()\n      if pos in visited:\n        continue\n      visited.add(pos)\n      x, y = pos\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < env.grid.shape[0] and 0 <= ny < env.grid.shape[1]:\n          if np.argmax(env.grid[nx, ny]) not in env.world.non_grabbable_indices:\n            queue.append(((nx, ny), path + [(dx, dy)]))\n          elif np.argmax(env.grid[nx, ny]) == goal:\n            return path + [(dx, dy)]\n    return None\n\n  def use_tool(pos, tool_idx):\n    adjacent, target_pos = is_adjacent(pos, tool_idx)\n    if adjacent:\n      env.step([0] * len(env.action_space))\n      return [USE_TOOL], True\n    else:\n      path = bfs(pos, tool_idx)\n      if path:\n        actions = []\n        for dx, dy in path:\n          if (dx, dy) == (-1, 0):\n            actions.append(MOVE_UP)\n          elif (dx, dy) == (1, 0):\n            actions.append(MOVE_DOWN)\n          elif (dx, dy) == (0, -1):\n            actions.append(MOVE_LEFT)\n          elif (dx, dy) == (0, 1):\n            actions.append(MOVE_RIGHT)\n        return actions + [USE_TOOL], True\n      else:\n        return [], False\n\n  target_idx = env.world.crafting_table[primitive]\n  pos = tuple(env.agent_pos)\n\n  # Check if the agent is already next to the target\n  adjacent, _ = is_adjacent(pos, target_idx)\n  if adjacent:\n    return [USE_TOOL], 0, [USE_TOOL]\n\n  # Find a path to the target\n  path = bfs(pos, target_idx)\n  if not path:\n    return [], -1, []\n\n  actions = []\n  for dx, dy in path:\n    if (dx, dy) == (-1, 0):\n      actions.append(MOVE_UP)\n    elif (dx, dy) == (1, 0):\n      actions.append(MOVE_DOWN)\n    elif (dx, dy) == (0, -1):\n      actions.append(MOVE_LEFT)\n    elif (dx, dy) == (0, 1):\n      actions.append(MOVE_RIGHT)\n\n  # Add the action to collect the target\n  return actions + [USE_TOOL], len(actions), actions + [USE_TOOL]", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-08-12T16:50:48.320351", "function_name": "collect", "function_body": "  # Define the actions for moving in four directions\n  MOVES = [(0, -1), (0, 1), (-1, 0), (1, 0)]  # UP, DOWN, LEFT, RIGHT\n\n  def is_valid(pos):\n      return (0 <= pos[0] < env.grid.shape[0]) and (0 <= pos[1] < env.grid.shape[1])\n\n  def can_use_tool(primitive, tool, cell_index):\n      if primitive == 'GOLD' and tool == 'BRIDGE' and cell_index == env.world.cookbook.index('WATER'):\n          return True\n      elif primitive in ['GEM', 'IRON_ORE'] and tool == 'PICKAXE':\n          return cell_index in [env.world.cookbook.index('ROCK'), env.world.cookbook.index('IRON_ORE')]\n      elif primitive == 'WOOD' and tool == 'AXE' and cell_index == env.world.cookbook.index('TREE'):\n          return True\n      return False\n\n  # BFS to find the shortest path to collect the primitive\n  from collections import deque\n  queue = deque([(env.state.pos, [], env.state.inventory.copy())])\n  visited = set()\n\n  while queue:\n      pos, actions, inventory = queue.popleft()\n      if (pos, tuple(inventory.items())) in visited:\n          continue\n      visited.add((pos, tuple(inventory.items())))\n      \n      # Check if the current position has the desired primitive\n      cell_index = np.argmax(env.grid[pos])\n      if env.world.cookbook[cell_index] == primitive and inventory.get(primitive, 0) == 0:\n          return actions + [env.actions.index('USE')], 0, actions + [env.actions.index('USE')]\n\n      # Explore neighbors\n      for move in MOVES:\n          new_pos = (pos[0] + move[0], pos[1] + move[1])\n          if is_valid(new_pos):\n              new_cell_index = np.argmax(env.grid[new_pos])\n              if new_cell_index not in env.world.non_grabbable_indices:\n                  queue.append((new_pos, actions + [env.actions.index(move)], inventory.copy()))\n              else:\n                  # Check if we can use a tool to interact with this cell\n                  for tool in inventory.keys():\n                      if can_use_tool(primitive, tool, new_cell_index):\n                          new_inventory = inventory.copy()\n                          new_inventory[tool] -= 1\n                          queue.append((new_pos, actions + [env.actions.index('USE')], new_inventory))\n\n  return [], -1, []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-08-12T16:52:29.345109", "function_name": "collect", "function_body": "  def can_use_tool(state, tool_index):\n      adjacent_cells = [\n          (state.pos[0], state.pos[1] - 1),  # UP\n          (state.pos[0], state.pos[1] + 1),  # DOWN\n          (state.pos[0] - 1, state.pos[1]),  # LEFT\n          (state.pos[0] + 1, state.pos[1])   # RIGHT\n      ]\n      tool_name = state.world.cookbook.index.get(tool_index)\n      \n      for adj_pos in adjacent_cells:\n          if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n              cell_index = np.argmax(state.grid[adj_pos])\n              cell_name = state.world.cookbook.index.get(cell_index)\n              \n              # Define tool-target pairs\n              if (tool_name == 'BRIDGE' and cell_name == 'WATER') or \\\n                 (tool_name == 'PICKAXE' and cell_name == 'ROCK') or \\\n                 (tool_name == 'AXE' and cell_name == 'GRASS') or \\\n                 (tool_name == 'HAMMER' and cell_name == 'STONE') or \\\n                 (tool_name == 'SHOVEL' and cell_name == 'CLAY'):\n                  return True, adj_pos\n      return False, None\n\n  MAX_STEPS = 300\n  UP, DOWN, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  action_list = []\n  state = env._current_state\n  target_index = state.world.cookbook.index[primitive]\n\n  # Priority queue for BFS (position, steps, inventory, actions)\n  queue = collections.deque([(state.pos, 0, np.copy(state.inventory), [])])\n  visited = set()\n\n  while queue:\n      pos, steps, inv, actions = queue.popleft()\n\n      if steps >= MAX_STEPS:\n          continue\n\n      # Check if the position and inventory have been visited\n      state_key = (tuple(pos), tuple(inv))\n      if state_key in visited:\n          continue\n      visited.add(state_key)\n\n      # Create a new state object for the current BFS step\n      state = craft.CraftState(\n          scenario=state.scenario,\n          grid=np.copy(state.grid),\n          pos=pos,\n          dir=state.dir,\n          inventory=np.copy(inv)\n      )\n\n      # Check if the target primitive is next to the agent\n      if state.next_to(target_index):\n          action_list = actions + [USE]\n          return action_list, 0, action_list\n\n      # Generate possible moves and use of tools\n      new_positions = [\n          (pos[0], pos[1] - 1),  # UP\n          (pos[0], pos[1] + 1),  # DOWN\n          (pos[0] - 1, state.pos[1]),  # LEFT\n          (pos[0] + 1, state.pos[1])   # RIGHT\n      ]\n\n      for i, new_pos in enumerate(new_positions):\n          if 0 <= new_pos[0] < state.grid.shape[0] and 0 <= new_pos[1] < state.grid.shape[1]:\n              # Check if the move is valid (not a boundary or non-grabbable entity)\n              cell_index = np.argmax(state.grid[new_pos])\n              if cell_index not in state.world.non_grabbable_indices:\n                  queue.append((new_pos, steps + 1, inv, actions + [i]))\n\n      # Check for tool usage\n      inventory_items = np.where(inv > 0)[0]\n      for item_idx in inventory_items:\n          can_use, adj_pos = can_use_tool(state, item_idx)\n          if can_use:\n              new_inv = inv.copy()\n              new_inv[item_idx] -= 1  # Consume the tool\n              queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n\n  return [], -1, []  # Return empty list and negative reward if target is unreachable", "island_id": 7, "scores": {"3": 0.5}}
