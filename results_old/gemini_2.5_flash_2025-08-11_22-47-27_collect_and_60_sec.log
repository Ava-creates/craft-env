           (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['WATER']:\n                          new_inv = inv.copy()\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n          elif primitive == 'ROCK' and state.world.cookbook.index.get('PICKAXE') == item_idx:\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['ROCK']:\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the pickaxe\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n  return [], -1, []  # Return empty list and negative reward if target is unreachable", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-08-12T20:56:20.950701", "function_name": "collect", "function_body": "  MAX_STEPS = 50\n  UP, DOWN, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  action_list = []\n  state = env._current_state\n  target_index = state.world.cookbook.index[primitive]\n\n  # Priority queue for BFS (position, steps, inventory, actions)\n  queue = collections.deque([(state.pos, 0, np.copy(state.inventory), [])])\n  visited = set()\n\n  while queue:\n      pos, steps, inv, actions = queue.popleft()\n\n      if steps >= MAX_STEPS:\n          continue\n\n      # Check if the position and inventory have been visited\n      state_key = (tuple(pos), tuple(inv))\n      if state_key in visited:\n          continue\n      visited.add(state_key)\n\n      # Create a new state object for the current BFS step\n      state = craft.CraftState(\n          scenario=state.scenario,\n          grid=np.copy(state.grid),\n          pos=pos,\n          dir=state.dir,\n          inventory=np.copy(inv)\n      )\n\n      # Check if the target primitive is next to the agent\n      if state.next_to(target_index):\n          action_list = actions + [USE]\n          return action_list, 0, action_list\n\n      # Generate possible moves and use of tools\n      new_positions = [\n          (pos[0], pos[1] - 1),  # UP\n          (pos[0], pos[1] + 1),  # DOWN\n          (pos[0] - 1, pos[1]),  # LEFT\n          (pos[0] + 1, pos[1])   # RIGHT\n      ]\n\n      for i, new_pos in enumerate(new_positions):\n          if 0 <= new_pos[0] < state.grid.shape[0] and 0 <= new_pos[1] < state.grid.shape[1]:\n              # Check if the move is valid (not a boundary or non-grabbable entity)\n              cell_index = np.argmax(state.grid[new_pos])\n              if cell_index not in state.world.non_grabbable_indices:\n                  queue.append((new_pos, steps + 1, inv, actions + [i]))\n\n      # Define tool usage functions\n      def use_tool(state, target, tool, resource):\n          inventory_items = np.where(state.inventory > 0)[0]\n          for item_idx in inventory_items:\n              if state.world.cookbook.index.get(tool) == item_idx:\n                  adjacent_cells = [\n                      (state.pos[0], state.pos[1] - 1),  # UP\n                      (state.pos[0], state.pos[1] + 1),  # DOWN\n                      (state.pos[0] - 1, state.pos[1]),  # LEFT\n                      (state.pos[0] + 1, state.pos[1])   # RIGHT\n                  ]\n                  for adj_pos in adjacent_cells:\n                      if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                          cell_index = np.argmax(state.grid[adj_pos])\n                          if cell_index == state.world.cookbook.index[resource]:\n                              new_inv = state.inventory.copy()\n                              new_inv[item_idx] -= 1  # Consume the tool\n                              queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                              break\n\n      # Check for BRIDGE usage for WATER\n      if primitive == 'GOLD':\n          use_tool(state, target_index, 'BRIDGE', 'WATER')\n\n      # Check for PICKAXE usage for GEM\n      if primitive == 'GEM':\n          use_tool(state, target_index, 'PICKAXE', 'ROCK')\n\n      # Check for AXE usage for WOOD\n      if primitive == 'WOOD':\n          use_tool(state, target_index, 'AXE', 'TREE')\n\n      # Check for SHEARS usage for SAPLING\n      if primitive in ['SAPLING', 'LEAVES']:\n          use_tool(state, target_index, 'SHEARS', primitive)\n\n      # Check for HAMMER usage for COBBLESTONE\n      if primitive == 'COBBLESTONE':\n          use_tool(state, target_index, 'HAMMER', 'STONE_BLOCK')\n\n      # Check for SHOVEL usage for SAND\n      if primitive == 'SAND':\n          use_tool(state, target_index, 'SHOVEL', 'SAND_BLOCK')\n\n      # Check for PICKAXE usage for CLAY\n      if primitive == 'CLAY':\n          use_tool(state, target_index, 'PICKAXE', 'CLAY_BLOCK')\n\n      # Check for AXE usage for GRASS\n      if primitive == 'GRASS':\n          use_tool(state, target_index, 'AXE', 'GRASS_BLOCK')\n\n  return [], -1, []  # Return empty list and negative reward if target is unreachable", "island_id": 6, "scores": {"3": 0.5}}
