{"timestamp": "2025-08-12T22:11:28.829020", "function_name": "collect", "function_body": "  MAX_STEPS = 100\n  UP, DOWN, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  action_list = []\n  state = env._current_state\n  target_index = state.world.cookbook.index[primitive]\n\n  # Priority queue for BFS (position, steps, inventory, actions)\n  queue = collections.deque([(state.pos, 0, np.copy(state.inventory), [])])\n  visited = set()\n\n  while queue:\n      pos, steps, inv, actions = queue.popleft()\n\n      if steps >= MAX_STEPS:\n          continue\n\n      # Check if the position and inventory have been visited\n      state_key = (tuple(pos), tuple(inv))\n      if state_key in visited:\n          continue\n      visited.add(state_key)\n\n      # Create a new state object for the current BFS step\n      state = craft.CraftState(\n          scenario=state.scenario,\n          grid=np.copy(state.grid),\n          pos=pos,\n          dir=state.dir,\n          inventory=np.copy(inv)\n      )\n\n      # Check if the target primitive is next to the agent\n      adjacent_cells = [\n          (pos[0], pos[1] - 1),  # UP\n          (pos[0], pos[1] + 1),  # DOWN\n          (pos[0] - 1, pos[1]),  # LEFT\n          (pos[0] + 1, pos[1])   # RIGHT\n      ]\n\n      for adj_pos in adjacent_cells:\n          if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n              cell_index = np.argmax(state.grid[adj_pos])\n              if cell_index == target_index:\n                  # Determine the direction to move\n                  move_action = None\n                  if adj_pos[1] < pos[1]:\n                      move_action = UP\n                  elif adj_pos[1] > pos[1]:\n                      move_action = DOWN\n                  elif adj_pos[0] < pos[0]:\n                      move_action = LEFT\n                  else:\n                      move_action = RIGHT\n\n                  action_list = actions + [move_action, USE]\n                  return action_list, 0, action_list\n\n      # Generate possible moves and check for tool usage\n      inventory_items = np.where(inv > 0)[0]\n\n      for direction in range(4):\n          new_pos = adjacent_cells[direction]\n\n          if 0 <= new_pos[0] < state.grid.shape[0] and 0 <= new_pos[1] < state.grid.shape[1]:\n              cell_index = np.argmax(state.grid[new_pos])\n\n              # Check if the cell is a non-grabbable item\n              if cell_index in state.world.non_grabbable_indices:\n                  for item_idx in inventory_items:\n                      required_tool, required_target = None, None\n\n                      # Determine the tool and target based on the primitive\n                      if primitive == 'GOLD' and item_idx == state.world.cookbook.index['BRIDGE']:\n                          required_tool = 'BRIDGE'\n                          required_target = 'WATER'\n                      elif primitive == 'GEM' and item_idx == state.world.cookbook.index['PICKAXE']:\n                          required_tool = 'PICKAXE'\n                          required_target = 'ROCK'\n                      elif primitive in ['TREE', 'WOOD'] and item_idx == state.world.cookbook.index['AXE']:\n                          required_tool = 'AXE'\n                          required_target = 'TREE'\n                      elif primitive == 'BOULDER' and item_idx == state.world.cookbook.index['HAMMER']:\n                          required_tool = 'HAMMER'\n                          required_target = 'BOULDER'\n                      elif primitive == 'IRON_ORE' and item_idx == state.world.cookbook.index['DRILL']:\n                          required_tool = 'DRILL'\n                          required_target = 'IRON_ORE'\n                      elif primitive in ['BUSH', 'CLOTH'] and item_idx == state.world.cookbook.index['SHEARS']:\n                          required_tool = 'SHEARS'\n                          required_target = 'BUSH'\n\n                      if required_tool and required_target:\n                          if state.world.cookbook[cell_index] == required_target:\n                              new_inv = inv.copy()\n                              new_inv[item_idx] -= 1\n                              action_list = actions + [direction, USE]\n                              return action_list, 0, action_list\n\n              # If the cell is grabbable, add to queue for further exploration\n              elif cell_index not in state.world.non_grabbable_indices:\n                  queue.append((new_pos, steps + 1, inv, actions + [direction]))\n\n  return [], -1, []  # Return empty list and negative reward if target is unreachable", "island_id": 2, "scores": {"3": 1.0}}
