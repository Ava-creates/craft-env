eps + 1, inv, actions + [i]))\n\n      # Check for tool usage\n      inventory_items = np.where(inv > 0)[0]\n      for item_idx in inventory_items:\n          tool_effect = None\n\n          if primitive == 'GOLD' and state.world.cookbook.index.get('BRIDGE') == item_idx:\n              tool_effect = state.world.cookbook.index['WATER']\n\n          elif primitive == 'GEM' and state.world.cookbook.index.get('PICKAXE') == item_idx:\n              tool_effect = state.world.cookbook.index['ROCK']\n\n          elif primitive == 'WOOD' and state.world.cookbook.index.get('AXE') == item_idx:\n              tool_effect = state.world.cookbook.index['TREE']\n\n          elif primitive == 'IRON' and state.world.cookbook.index.get('PICKAXE') == item_idx:\n              tool_effect = state.world.cookbook.index['ORE']\n\n          elif primitive == 'CLAY' and state.world.cookbook.index.get('SHOVEL') == item_idx:\n              tool_effect = state.world.cookbook.index['CLAY']\n\n          elif primitive == 'STONE' and state.world.cookbook.index.get('HAMMER') == item_idx:\n              tool_effect = state.world.cookbook.index['STONE']\n\n          if tool_effect is not None:\n              for adj_pos in adjacent_cells:\n                  if not (0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]):\n                      continue\n                  cell_index = np.argmax(state.grid[adj_pos])\n                  if cell_index == tool_effect:\n                      new_inv = inv.copy()\n                      new_inv[item_idx] -= 1  # Consume the tool\n                      queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                      break\n\n  return [], -1, []  # Return empty list and negative reward if target is unreachable", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-12T17:52:08.989298", "function_name": "collect", "function_body": "  MAX_STEPS = 100\n  UP, DOWN, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  action_list = []\n  state = env._current_state\n  target_index = state.world.cookbook.index[primitive]\n\n  # Priority queue for BFS (position, steps, inventory, actions)\n  queue = collections.deque([(state.pos, 0, np.copy(state.inventory), [])])\n  visited = set()\n\n  while queue:\n      pos, steps, inv, actions = queue.popleft()\n\n      if steps >= MAX_STEPS:\n          continue\n\n      # Check if the position and inventory have been visited\n      state_key = (tuple(pos), tuple(inv))\n      if state_key in visited:\n          continue\n      visited.add(state_key)\n\n      # Create a new state object for the current BFS step\n      state = craft.CraftState(\n          scenario=state.scenario,\n          grid=np.copy(state.grid),\n          pos=pos,\n          dir=state.dir,\n          inventory=np.copy(inv)\n      )\n\n      # Check if the target primitive is next to the agent\n      adjacent_cells = [\n          (pos[0], pos[1] - 1),  # UP\n          (pos[0], pos[1] + 1),  # DOWN\n          (pos[0] - 1, pos[1]),  # LEFT\n          (pos[0] + 1, pos[1])   # RIGHT\n      ]\n      for adj_pos in adjacent_cells:\n          if not (0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]):\n              continue\n          cell_index = np.argmax(state.grid[adj_pos])\n          if cell_index == target_index:\n              action_list = actions + [USE]\n              return action_list, steps + 1, action_list\n\n      # Generate possible moves and use of tools\n      for i, new_pos in enumerate(adjacent_cells):\n          if not (0 <= new_pos[0] < state.grid.shape[0] and 0 <= new_pos[1] < state.grid.shape[1]):\n              continue\n          cell_index = np.argmax(state.grid[new_pos])\n          if cell_index not in state.world.non_grabbable_indices:\n              queue.append((new_pos, steps + 1, inv, actions + [i]))\n\n      # Check for tool usage\n      inventory_items = np.where(inv > 0)[0]\n      for item_idx in inventory_items:\n          # Determine the type of tool and its effect (e.g., BRIDGE for WATER)\n          tool_effect = state.world.tool_effects.get(item_idx)\n          if tool_effect is not None:\n              for adj_pos in adjacent_cells:\n                  if not (0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]):\n                      continue\n                  cell_index = np.argmax(state.grid[adj_pos])\n                  if cell_index in tool_effect:\n                      new_inv = inv.copy()\n                      new_inv[item_idx] -= 1  # Consume the tool\n                      queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                      break\n\n  return [], -1, []  # Return empty list and negative reward if target is unreachable", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-08-12T17:52:59.189452", "function_name": "collect", "function_body": "  UP, DOWN, LEFT, RIGHT, USE = range(5)\n\n  # Get the index of the primitive to collect\n  cookbook = env.world.cookbook\n  primitive_index = cookbook.index[primitive]\n\n  action_list = []\n  reward = 0.0\n  state = env._current_state\n\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x-1, y), (x+1, y), (x, y-1), (x, y+1)]\n\n  # BFS to find the shortest path to the primitive\n  queue = collections.deque([(state.pos, [])])\n  visited = set([state.pos])\n\n  while queue:\n      current_pos, path = queue.popleft()\n\n      if state.next_to(primitive_index):\n          action_list.extend(path)\n          break\n\n      for neighbor in get_neighbors(current_pos):\n          nx, ny = neighbor\n          if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n              if neighbor not in visited:\n                  dx, dy = nx - current_pos[0], ny - current_pos[1]\n                  direction = RIGHT if dx > 0 else\\\n                              LEFT if dx < 0 else\\\n                              DOWN if dy > 0 else\\\n                              UP\n                  new_path = path + [direction]\n                  queue.append((neighbor, new_path))\n                  visited.add(neighbor)\n\n  # Execute the actions to collect the primitive\n  for a in action_list:\n      r, done, _ = env.step(a)\n      reward += r\n\n  return state, reward, action_list", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-08-12T17:53:00.164265", "function_name": "collect", "function_body": "  UP, DOWN, LEFT, RIGHT, USE = range(5)\n\n  # Get the index of the primitive to collect\n  cookbook = env.world.cookbook\n  primitive_index = cookbook.index[primitive]\n\n  action_list = []\n  reward = 0.0\n  state = env._current_state\n\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x-1, y), (x+1, y), (x, y-1), (x, y+1)]\n\n  # Use a priority queue to find the shortest path considering obstacles and tools in inventory\n  import heapq\n\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  open_set = []\n  heapq.heappush(open_set, (0, state.pos, []))\n  came_from = {}\n  g_score = {state.pos: 0}\n  f_score = {state.pos: heuristic(state.pos, goal_pos)}\n\n  while open_set:\n      current_fscore, current_pos, path = heapq.heappop(open_set)\n\n      if state.next_to(primitive_index):\n          action_list.extend(path)\n          break\n\n      for neighbor in get_neighbors(current_pos):\n          nx, ny = neighbor\n          if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n              dx, dy = nx - current_pos[0], ny - current_pos[1]\n              direction = RIGHT if dx > 0 else\\\n                          LEFT if dx < 0 else\\\n                          DOWN if dy > 0 else\\\n                          UP\n              new_path = path + [direction]\n\n              tentative_g_score = g_score[current_pos] + 1\n\n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = (current_pos, direction)\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal_pos)\n                  heapq.heappush(open_set, (f_score[neighbor], neighbor, new_path))\n\n  # Execute the actions to collect the primitive\n  for a in action_list:\n      r, done, _ = env.step(a)\n      reward += r\n\n  return state, reward, action_list", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-08-12T17:58:51.875628", "function_name": "collect", "function_body": "  MAX_STEPS = 50\n  UP, DOWN, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  action_list = []\n  state = env._current_state\n  target_index = state.world.cookbook.index[primitive]\n\n  # Priority queue for BFS (position, steps, inventory, actions)\n  queue = collections.deque([(state.pos, 0, np.copy(state.inventory), [])])\n  visited = set()\n\n  while queue:\n      pos, steps, inv, actions = queue.popleft()\n\n      if steps >= MAX_STEPS:\n          continue\n\n      # Check if the position and inventory have been visited\n      state_key = (tuple(pos), tuple(inv))\n      if state_key in visited:\n          continue\n      visited.add(state_key)\n\n      # Create a new state object for the current BFS step\n      state = craft.CraftState(\n          scenario=state.scenario,\n          pos=pos,\n          dir=state.dir,\n          inventory=np.copy(inv)\n      )\n\n      # Check if the target primitive is next to the agent\n      if state.next_to(target_index):\n          action_list = actions + [USE]\n          return action_list, 0, action_list\n\n      # Generate possible moves and use of tools\n      new_positions = [\n          (pos[0], pos[1] - 1),  # UP\n          (pos[0], pos[1] + 1),  # DOWN\n          (pos[0] - 1, pos[1]),  # LEFT\n          (pos[0] + 1, pos[1])   # RIGHT\n      ]\n\n      for i, new_pos in enumerate(new_positions):\n          if 0 <= new_pos[0] < state.grid.shape[0] and 0 <= new_pos[1] < state.grid.shape[1]:\n              # Check if the move is valid (not a boundary or non-grabbable entity)\n              cell_index = np.argmax(state.grid[new_pos])\n              if cell_index not in state.world.non_grabbable_indices:\n                  queue.append((new_pos, steps + 1, inv, actions + [i]))\n\n      def use_tool(tool_name, resource_name):\n          tool_index = state.world.cookbook.index.get(tool_name)\n          resource_index = state.world.cookbook.index.get(resource_name)\n          if tool_index is not None and resource_index is not None:\n              for adj_pos in [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if inv[tool_index] > 0 and cell_index == resource_index:\n                          new_inv = inv.copy()\n                          new_inv[tool_index] -= 1  # Consume the tool\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n      # Define tool usage based on target primitive\n      if primitive == 'GOLD':\n          use_tool('BRIDGE', 'WATER')\n\n      elif primitive in ['IRON_ORE', 'COAL']:\n          use_tool('PICKAXE', 'ROCK')\n\n      elif primitive == 'WOOD':\n          use_tool('AXE', 'TREE')\n\n      elif primitive == 'GRASS':\n          use_tool('SHEARS', 'GRASS')\n\n      elif primitive == 'FISH':\n          use_tool('FISHING_ROD', 'WATER')\n\n  return [], -1, []  # Return empty list and negative reward if target is unreachable", "island_id": 6, "scores": {"3": -1}}
