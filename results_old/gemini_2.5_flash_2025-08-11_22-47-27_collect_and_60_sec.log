etermine the type of tool and its effect (e.g., BRIDGE for WATER)\n          if primitive == 'GOLD' and state.world.cookbook.index.get('BRIDGE') == item_idx:\n              # Check if there's water next to the agent\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['WATER']:\n                          # Use BRIDGE to cross WATER\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the bridge\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n          elif primitive == 'GEM' and state.world.cookbook.index.get('PICKAXE') == item_idx:\n              # Check if there's rock next to the agent\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['ROCK']:\n                          # Use PICKAXE to mine GEM\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the pickaxe\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n          elif primitive == 'WOOD' and state.world.cookbook.index.get('AXE') == item_idx:\n              # Check if there's tree next to the agent (assuming tree is GRASS for now)\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['GRASS']:\n                          # Use AXE to chop WOOD\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the axe\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n          elif primitive == 'IRON' and state.world.cookbook.index.get('HAMMER') == item_idx:\n              # Check if there's ore next to the agent (assuming ore is IRON for now)\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['IRON']:\n                          # Use HAMMER to mine IRON\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the hammer\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n          elif primitive == 'STONE' and state.world.cookbook.index.get('PICKAXE') == item_idx:\n              # Check if there's stone next to the agent (assuming stone is STONE for now)\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['STONE']:\n                          # Use PICKAXE to mine STONE\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the pickaxe\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n  return [], -1, []  # Return empty list and negative reward if target is unreachable", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-12T14:39:28.106213", "function_name": "collect", "function_body": "  def find_nearest_primitive(state, primitive):\n    # Locate the nearest occurrence of the specified primitive in the grid.\n    primitive_index = state.world.cookbook.index.index(primitive)\n    min_dist = float('inf')\n    nearest_pos = None\n    for y in range(state.grid.shape[0]):\n      for x in range(state.grid.shape[1]):\n        if state.grid[y, x, primitive_index] > 0:\n          dist = abs(y - state.pos[0]) + abs(x - state.pos[1])\n          if dist < min_dist:\n            min_dist = dist\n            nearest_pos = (y, x)\n    return nearest_pos\n\n  def path_to(state, target_pos):\n    # Implement A* search to find the shortest path from current position to target.\n    start = state.pos\n    open_set = collections.PriorityQueue()\n    open_set.put((0, start))\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: abs(start[0] - target_pos[0]) + abs(start[1] - target_pos[1])}\n\n    while not open_set.empty():\n      _, current = open_set.get()\n      if current == target_pos:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        return path[::-1]\n\n      for dy, dx in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor = (current[0] + dy, current[1] + dx)\n        tentative_g_score = g_score[current] + 1\n        if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n          came_from[neighbor] = current\n          g_score[neighbor] = tentative_g_score\n          f_score[neighbor] = tentative_g_score + abs(neighbor[0] - target_pos[0]) + abs(neighbor[1] - target_pos[1])\n          open_set.put((f_score[neighbor], neighbor))\n\n    return []\n\n  def actions_to_path(state, path):\n    # Convert a sequence of positions to a sequence of action indices.\n    actions = []\n    for i in range(1, len(path)):\n      dy = path[i][0] - path[i-1][0]\n      dx = path[i][1] - path[i-1][1]\n      if dy == 1:\n          actions.append(env.action_specs()[env.DOWN])\n      elif dy == -1:\n          actions.append(env.action_specs()[env.UP])\n      elif dx == 1:\n          actions.append(env.action_specs()[env.RIGHT])\n      elif dx == -1:\n          actions.append(env.action_specs()[env.LEFT])\n    return actions\n\n  action_list = []\n  state = env._current_state\n  nearest_primitive_pos = find_nearest_primitive(state, primitive)\n  \n  if nearest_primitive_pos:\n    path = path_to(state, nearest_primitive_pos)\n    if path:\n      action_list.extend(actions_to_path(state, path))\n      # Assuming the target primitive is directly next to us after moving.\n      action_list.append(env.action_specs()[env.USE])\n\n  for a in action_list:\n      r, state, _ = env.step(a)\n  \n  return action_list", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-08-12T14:39:29.076329", "function_name": "collect", "function_body": "  def find_nearest_primitive(state, primitive):\n    # Assuming the world has a method to get positions of all primitives\n    grid = state.grid\n    kind_index = state.world.cookbook.index.get(primitive)\n    \n    nearest_pos = None\n    min_dist = float('inf')\n    for y in range(grid.shape[0]):\n      for x in range(grid.shape[1]):\n        if grid[y, x, kind_index] > 0:\n          dist = abs(y - state.pos[0]) + abs(x - state.pos[1])\n          if dist < min_dist:\n            min_dist = dist\n            nearest_pos = (y, x)\n    return nearest_pos\n\n  def path_to(state, target_pos):\n    # Implementing a simple BFS to find the shortest path.\n    grid = state.grid\n    queue = collections.deque([state.pos])\n    visited = set()\n    parent = {state.pos: None}\n    \n    while queue:\n      current_pos = queue.popleft()\n      if current_pos == target_pos:\n        break\n      for dy, dx in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        new_pos = (current_pos[0] + dy, current_pos[1] + dx)\n        if 0 <= new_pos[0] < grid.shape[0] and 0 <= new_pos[1] < grid.shape[1] and new_pos not in visited:\n          visited.add(new_pos)\n          parent[new_pos] = current_pos\n          queue.append(new_pos)\n\n    path_actions = []\n    while target_pos is not None:\n      prev_pos = parent[target_pos]\n      if prev_pos is None:\n        break\n      dy, dx = target_pos[0] - prev_pos[0], target_pos[1] - prev_pos[1]\n      if dy == 1:\n          path_actions.append(env.action_specs()[env.DOWN])\n      elif dy == -1:\n          path_actions.append(env.action_specs()[env.UP])\n      elif dx == 1:\n          path_actions.append(env.action_specs()[env.RIGHT])\n      elif dx == -1:\n          path_actions.append(env.action_specs()[env.LEFT])\n      target_pos = prev_pos\n    return reversed(path_actions)\n\n  def move_to(state, action_list):\n      reward = 0\n      for a in action_list:\n          r, state = env.step(a)\n          reward += r\n      return state, reward\n\n  action_list = []\n  reward = 0\n  state = env._current_state\n\n  nearest_primitive_pos = find_nearest_primitive(state, primitive)\n  if nearest_primitive_pos:\n    path_actions = path_to(state, nearest_primitive_pos)\n    action_list.extend(path_actions)\n\n    # Assuming the target primitive is directly next to us after moving.\n    action_list.append(env.action_specs()[env.USE])\n\n    state, reward = move_to(state, action_list)\n\n  return state, reward, action_list", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-08-12T14:41:53.898948", "function_name": "collect", "function_body": "  MAX_STEPS = 200\n  UP, DOWN, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  action_list = []\n  state = env._current_state\n  target_index = state.world.cookbook.index[primitive]\n\n  # Priority queue for BFS (position, steps, inventory, actions)\n  queue = collections.deque([(state.pos, 0, np.copy(state.inventory), [])])\n  visited = set()\n\n  while queue:\n      pos, steps, inv, actions = queue.popleft()\n\n      if steps >= MAX_STEPS:\n          continue\n\n      # Check if the position and inventory have been visited\n      state_key = (tuple(pos), tuple(inv))\n      if state_key in visited:\n          continue\n      visited.add(state_key)\n\n      # Create a new state object for the current BFS step\n      state = craft.CraftState(\n          scenario=state.scenario,\n          grid=np.copy(state.grid),\n          pos=pos,\n          dir=state.dir,\n          inventory=np.copy(inv)\n      )\n\n      # Check if the target primitive is next to the agent\n      if state.next_to(target_index):\n          action_list = actions + [USE]\n          return action_list, 0, action_list\n\n      # Generate possible moves and use of tools\n      new_positions = [\n          (pos[0], pos[1] - 1),  # UP\n          (pos[0], pos[1] + 1),  # DOWN\n          (pos[0] - 1, pos[1]),  # LEFT\n          (pos[0] + 1, pos[1])   # RIGHT\n      ]\n\n      for i, new_pos in enumerate(new_positions):\n          if 0 <= new_pos[0] < state.grid.shape[0] and 0 <= new_pos[1] < state.grid.shape[1]:\n              # Check if the move is valid (not a boundary or non-grabbable entity)\n              cell_index = np.argmax(state.grid[new_pos])\n              if cell_index not in state.world.non_grabbable_indices:\n                  queue.append((new_pos, steps + 1, inv, actions + [i]))\n\n      # Check for tool usage\n      inventory_items = np.where(inv > 0)[0]\n      for item_idx in inventory_items:\n          # Determine the type of tool and its effect (e.g., BRIDGE for WATER)\n          if primitive == 'GOLD' and state.world.cookbook.index.get('BRIDGE') == item_idx:\n              # Check if there's water next to the agent\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['WATER']:\n                          # Use BRIDGE to cross WATER\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the bridge\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n          elif primitive == 'GEM' and state.world.cookbook.index.get('PICKAXE') == item_idx:\n              # Check if there's rock next to the agent\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['ROCK']:\n                          # Use PICKAXE to mine GEM\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the pickaxe\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n          elif primitive == 'WOOD' and state.world.cookbook.index.get('AXE') == item_idx:\n              # Check if there's tree next to the agent (assuming tree is GRASS for now)\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['GRASS']:\n                          # Use AXE to chop WOOD\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the axe\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n          elif primitive == 'IRON' and state.world.cookbook.index.get('HAMMER') == item_idx:\n              # Check if there's stone next to the agent (assuming stone is GRASS for now)\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['GRASS']:\n                          # Use HAMMER to extract IRON\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the hammer\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n      # Add logic for other tools and their effects here (e.g., PICKAXE for GEM)\n\n  return [], -1, []  # Return empty list and negative reward if target is unreachable", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-12T14:41:54.892123", "function_name": "collect", "function_body": "  def can_use_tool(tool_idx, state):\n      adjacent_cells = [\n          (state.pos[0], state.pos[1] - 1),  # UP\n          (state.pos[0], state.pos[1] + 1),  # DOWN\n          (state.pos[0] - 1, state.pos[1]),  # LEFT\n          (state.pos[0] + 1, state.pos[1])   # RIGHT\n      ]\n      for adj_pos in adjacent_cells:\n          if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n              cell_index = np.argmax(state.grid[adj_pos])\n              if (tool_idx == state.world.cookbook.index.get('BRIDGE') and\n                  cell_index == state.world.cookbook.index['WATER']) or \\\n                 (tool_idx == state.world.cookbook.index.get('PICKAXE') and\n                  cell_index == state.world.cookbook.index['ROCK']) or \\\n                 (tool_idx == state.world.cookbook.index.get('AXE') and\n                  cell_index == state.world.cookbook.index['GRASS']):\n                  return True, adj_pos\n      return False, None\n\n  MAX_STEPS = 200\n  UP, DOWN, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  action_list = []\n  state = env._current_state\n  target_index = state.world.cookbook.index[primitive]\n\n  # Priority queue for BFS (position, steps, inventory, actions)\n  queue = collections.deque([(state.pos, 0, np.copy(state.inventory), [])])\n  visited = set()\n\n  while queue:\n      pos, steps, inv, actions = queue.popleft()\n\n      if steps >= MAX_STEPS:\n          continue\n\n      # Check if the position and inventory have been visited\n      state_key = (tuple(pos), tuple(inv))\n      if state_key in visited:\n          continue\n      visited.add(state_key)\n\n      # Create a new state object for the current BFS step\n      state = craft.CraftState(\n          scenario=state.scenario,\n          grid=np.copy(state.grid),\n          pos=pos,\n          dir=state.dir,\n          inventory=np.copy(inv)\n      )\n\n      # Check if the target primitive is next to the agent\n      if state.next_to(target_index):\n          action_list = actions + [USE]\n          return action_list, 0, action_list\n\n      # Generate possible moves and use of tools\n      new_positions = [\n          (pos[0], pos[1] - 1),  # UP\n          (pos[0], pos[1] + 1),  # DOWN\n          (pos[0] - 1, pos[1]),  # LEFT\n          (pos[0] + 1, pos[1])   # RIGHT\n      ]\n\n      for i, new_pos in enumerate(new_positions):\n          if 0 <= new_pos[0] < state.grid.shape[0] and 0 <= new_pos[1] < state.grid.shape[1]:\n              # Check if the move is valid (not a boundary or non-grabbable entity)\n              cell_index = np.argmax(state.grid[new_pos])\n              if cell_index not in state.world.non_grabbable_indices:\n                  queue.append((new_pos, steps + 1, inv, actions + [i]))\n\n      # Check for tool usage\n      inventory_items = np.where(inv > 0)[0]\n      for item_idx in inventory_items:\n          can_use, adj_pos = can_use_tool(item_idx, state)\n          if can_use:\n              new_inv = inv.copy()\n              new_inv[item_idx] -= 1  # Consume the tool\n              queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n\n      # Add logic for other tools and their effects here (e.g., PICKAXE for GEM)\n\n  return [], -1, []  # Return empty list and negative reward if target is unreachable", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-08-12T14:43:51.146802", "function_name": "collect", "function_body": "  def get_primitive_positions(grid, primitive_index):\n      return np.argwhere(grid[:, :, primitive_index] > 0)\n\n  def bfs(start, targets, grid, inventory, world):\n      queue = collections.deque([(start, [], dir)])\n      visited = set()\n      visited.add((tuple(start), dir))\n\n      while queue:\n          current, path, current_dir = queue.popleft()\n\n          if tuple(current) in targets:\n              return path\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n                  if neighbor not in visited:\n                      can_move = True\n                      action_path = path.copy()\n                      \n                      # Determine the target direction\n                      target_dir = direction_to_action(current, neighbor)\n                      \n                      # Turn to the correct direction if necessary\n                      turn_action = direction_to_action(dir, target_dir)\n                      if turn_action is not None:\n                          action_path.append(turn_action)\n                          \n                      # Check for obstacles and use tools from inventory\n                      if world.cookbook.index[\"WATER\"] in grid[neighbor].nonzero()[0] and inventory[world.cookbook.index[\"BRIDGE\"]] > 0:\n                          action_path.append(env.world.N_ACTIONS - 1)  # USE to place BRIDGE\n                          can_move = True\n                          \n                      elif world.cookbook.index[\"STONE\"] in grid[neighbor].nonzero()[0] and inventory[world.cookbook.index[\"PICKAXE\"]] > 0:\n                          action_path.append(env.world.N_ACTIONS - 1)  # USE to mine STONE\n                          can_move = True\n\n                      if can_move:\n                          queue.append((neighbor, action_path, target_dir))\n                          visited.add((tuple(neighbor), target_dir))\n\n      return None  # No path found\n\n  def direction_to_action(current_pos, next_pos):\n      dx = next_pos[0] - current_pos[0]\n      dy = next_pos[1] - current_pos[1]\n      if dx == 1:\n          return 0\n      elif dx == -1:\n          return 1\n      elif dy == -1:\n          return 2\n      elif dy == 1:\n          return 3\n\n  def direction_difference(current_dir, target_dir):\n      if current_dir == target_dir:\n          return None\n      elif (current_dir + 1) % 4 == target_dir:\n          return env.world.N_ACTIONS - 2  # Turn right\n      else:\n          return env.world.N_ACTIONS - 3  # Turn left\n\n  action_list = []\n  reward = 0\n  state = env._current_state\n  grid = state.grid\n  inventory = state.inventory\n  pos = state.pos\n  dir = state.dir\n\n  primitive_index = state.world.cookbook.index[primitive]\n  primitive_positions = get_primitive_positions(grid, primitive_index)\n\n  if len(primitive_positions) == 0:\n      return [], reward, action_list\n\n  primitive_positions_set = {tuple(pos) for pos in primitive_positions}\n  path_to_primitive = bfs(pos, primitive_positions_set, grid, inventory, state.world)\n\n  if not path_to_primitive:\n      return [], reward, action_list\n\n  # Create actions to follow the path\n  current_dir = dir\n  for i in range(len(path_to_primitive) - 1):\n      next_pos = path_to_primitive[i + 1]\n      \n      target_dir = direction_to_action(pos, next_pos)\n      turn_action = direction_difference(current_dir, target_dir)\n      if turn_action is not None:\n          action_list.append(turn_action)\n          r, state = env.step(state, turn_action)\n          reward += r\n          current_dir = (current_dir + (turn_action == env.world.N_ACTIONS - 2) - (turn_action == env.world.N_ACTIONS - 3)) % 4\n\n      move_action = target_dir\n      action_list.append(move_action)\n      r, state = env.step(state, move_action)\n      reward += r\n      pos = next_pos\n\n  if state.next_to(primitive_index):\n      action_list.append(env.world.N_ACTIONS - 1)  # Assuming USE is the last action\n      r, state = env.step(state, env.world.N_ACTIONS - 1)\n      reward += r\n\n  return action_list, reward, state", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-08-12T14:43:52.122800", "function_name": "collect", "function_body": "  def get_primitive_positions(grid, primitive_index):\n      return np.argwhere(grid[:, :, primitive_index] > 0)\n\n  def bfs(start, targets, grid, inventory, world, actions_taken=[]):\n      queue = collections.deque([(start, [])])\n      visited = set()\n      visited.add(start)\n\n      while queue:\n          current, path = queue.popleft()\n\n          if tuple(current) in targets:\n              return path\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n                  if neighbor not in visited:\n                      can_move = True\n                      action_path = path.copy()\n                      \n                      # Check for water and use bridge if available\n                      if world.cookbook.index[\"WATER\"] in grid[neighbor].nonzero()[0] and inventory[world.cookbook.index[\"BRIDGE\"]] > 0:\n                          action_path.append(env.world.N_ACTIONS - 1)  # USE to place BRIDGE\n                          can_move = True\n\n                      # Check for stone and use pickaxe if available\n                      elif world.cookbook.index[\"STONE\"] in grid[neighbor].nonzero()[0] and inventory[world.cookbook.index[\"PICKAXE\"]] > 0:\n                          action_path.append(env.world.N_ACTIONS - 1)  # USE to mine STONE\n                          can_move = True\n\n                      # Check for iron and use axe if available\n                      elif world.cookbook.index[\"IRON\"] in grid[neighbor].nonzero()[0] and inventory[world.cookbook.index[\"AXE\"]] > 0:\n                          action_path.append(env.world.N_ACTIONS - 1)  # USE to mine IRON\n                          can_move = True\n\n                      if can_move:\n                          queue.append((neighbor, action_path))\n                          visited.add(neighbor)\n\n      return None  # No path found\n\n  def direction_to_action(current_dir, target_dir):\n      if current_dir == target_dir:\n          return None\n      elif (current_dir + 1) % 4 == target_dir:\n          return env.world.N_ACTIONS - 2  # Turn right\n      else:\n          return env.world.N_ACTIONS - 3  # Turn left\n\n  action_list = []\n  reward = 0\n  state = env._current_state\n  grid = state.grid\n  inventory = state.inventory\n  pos = state.pos\n  dir = state.dir\n\n  primitive_index = state.world.cookbook.index[primitive]\n  primitive_positions = get_primitive_positions(grid, primitive_index)\n\n  if len(primitive_positions) == 0:\n      return [], reward, action_list\n\n  primitive_positions_set = {tuple(pos) for pos in primitive_positions}\n  path_to_primitive = bfs(pos, primitive_positions_set, grid, inventory, state.world)\n\n  if not path_to_primitive:\n      return [], reward, action_list\n\n  # Create actions to follow the path\n  current_pos = pos\n  for action in path_to_primitive:\n      action_list.append(action)\n      r, state = env.step(state, action)\n      reward += r\n      \n      # Update position and direction based on action\n      if action < 4:  # Move action\n          dx, dy = [(1, 0), (-1, 0), (0, -1), (0, 1)][action]\n          current_pos = (current_pos[0] + dx, current_pos[1] + dy)\n          \n      elif action == env.world.N_ACTIONS - 2:  # Turn right\n          dir = (dir + 1) % 4\n          \n      elif action == env.world.N_ACTIONS - 3:  # Turn left\n          dir = (dir - 1) % 4\n\n  if state.next_to(primitive_index):\n      action_list.append(env.world.N_ACTIONS - 1)  # Assuming USE is the last action\n      r, state = env.step(state, env.world.N_ACTIONS - 1)\n      reward += r\n\n  return action_list, reward, state", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-08-12T14:46:04.273910", "function_name": "collect", "function_body": "  import heapq\n  from collections import defaultdict\n  \n  def heuristic(pos1, pos2):\n    return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n  \n  def is_valid_position(x, y, grid_width, grid_height):\n    return 0 <= x < grid_width and 0 <= y < grid_height\n  \n  def get_neighbors(position, grid_width, grid_height):\n    x, y = position\n    neighbors = [(x-1, y), (x+1, y), (x, y-1), (x, y+1)]\n    return [n for n in neighbors if is_valid_position(n[0], n[1], grid_width, grid_height)]\n\n  def get_primitive_indices(primitive, grid):\n    primitive_index = env.world.cookbook.index.index(primitive)\n    positions = []\n    for x in range(grid.shape[0]):\n        for y in range(grid.shape[1]):\n            if np.any(grid[x, y] == primitive_index):\n                positions.append((x, y))\n    return positions\n  \n  def use_tool(state, tool_name):\n      tool_index = env.world.cookbook.index.index(tool_name)\n      if state.inventory[tool_index] > 0:\n          return True\n      return False\n\n  # Define the action mapping\n  actions = {\n      'UP': 1,\n      'DOWN': 0,\n      'LEFT': 2,\n      'RIGHT': 3,\n      'USE': 4\n  }\n  \n  # Retrieve the current state and grid\n  state = env._current_state\n  grid = state.grid\n  \n  # Get the initial position and all positions of the primitive to be collected\n  start_position = state.pos\n  goal_positions = get_primitive_indices(primitive, grid)\n  \n  if not goal_positions:\n      return [], 0, []  # No goals found, no actions needed\n\n  # Check for tools that might be required to cross water or mine gems\n  tool_required_for_water = 'BRIDGE'\n  tool_required_for_gem = 'PICKAXE'\n\n  tool_needed = None\n  if any(grid[pos[0], pos[1], env.world.cookbook.index.index('WATER')] > 0 for pos in goal_positions):\n      tool_needed = tool_required_for_water\n  elif primitive == 'GEM':\n      tool_needed = tool_required_for_gem\n\n  # If a tool is needed and not available, try to collect it first\n  if tool_needed and not use_tool(state, tool_needed):\n      actions_to_collect_tool, reward_collected_tool, _ = collect_v1(env, tool_needed)\n      state = env._current_state\n      grid = state.grid\n      start_position = state.pos\n\n  # Initialize the priority queue for A* search\n  open_set = []\n  heapq.heappush(open_set, (0, start_position))\n  came_from = {}\n  g_score = defaultdict(lambda: float('inf'))\n  g_score[start_position] = 0\n  f_score = defaultdict(lambda: float('inf'))\n  f_score[start_position] = heuristic(start_position, goal_positions[0]) # Just take the first goal as target for simplicity\n  \n  while open_set:\n      _, current = heapq.heappop(open_set)\n      \n      if current in goal_positions:\n          path = []\n          while current in came_from:\n              path.append(current)\n              current = came_from[current]\n          path.reverse()\n          break\n      \n      neighbors = get_neighbors(current, grid.shape[0], grid.shape[1])\n      for neighbor in neighbors:\n          tentative_g_score = g_score[current] + 1\n          \n          # Check if the agent needs to use a bridge or pickaxe\n          if tool_needed and grid[neighbor[0], neighbor[1], env.world.cookbook.index.index(tool_needed)] > 0:\n              if not use_tool(state, tool_needed):\n                  continue\n\n          if tentative_g_score < g_score[neighbor]:\n              came_from[neighbor] = current\n              g_score[neighbor] = tentative_g_score\n              f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal_positions[0])\n              heapq.heappush(open_set, (f_score[neighbor], neighbor))\n  \n  else:\n      return [], 0, []  # No path found\n  \n  # Convert the path into actions\n  action_list = []\n  for i in range(len(path) - 1):\n      current_pos, next_pos = path[i], path[i + 1]\n      dx = next_pos[0] - current_pos[0]\n      dy = next_pos[1] - current_pos[1]\n      \n      if dx == 1:\n          action_list.append(actions['RIGHT'])\n      elif dx == -1:\n          action_list.append(actions['LEFT'])\n      elif dy == 1:\n          action_list.append(actions['DOWN'])\n      elif dy == -1:\n          action_list.append(actions['UP'])\n  \n  # Append the USE action to collect the primitive\n  action_list.append(actions['USE'])\n\n  reward = 0\n  for a in action_list:\n    r, state = env.step(state, a)\n    reward += r\n\n  return state, reward, action_list", "island_id": 8, "scores": {}}
{"timestamp": "2025-08-12T14:46:05.263599", "function_name": "collect", "function_body": "  import heapq\n  from collections import defaultdict\n  \n  def heuristic(pos1, pos2):\n    return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n  \n  def is_valid_position(x, y, grid_width, grid_height):\n    return 0 <= x < grid_width and 0 <= y < grid_height\n  \n  def get_neighbors(position, grid_width, grid_height):\n    x, y = position\n    neighbors = [(x-1, y), (x+1, y), (x, y-1), (x, y+1)]\n    return [n for n in neighbors if is_valid_position(n[0], n[1], grid_width, grid_height)]\n\n  def get_primitive_indices(primitive, grid):\n    primitive_index = env.world.cookbook.index.index(primitive)\n    positions = []\n    for x in range(grid.shape[0]):\n        for y in range(grid.shape[1]):\n            if np.any(grid[x, y] == primitive_index):\n                positions.append((x, y))\n    return positions\n\n  def is_primitive_reachable(position, grid, inventory):\n      # Check if the primitive at the position can be reached with available tools\n      x, y = position\n      cell_inventory = set(np.where(grid[x, y])[0])\n      \n      for item in cell_inventory:\n          item_name = env.world.cookbook.index.inverse[item]\n          if (item_name.startswith('WORKSHOP') and 'AXE' not in inventory) or \\\n             (item_name == 'GEM' and 'PICKAXE' not in inventory):\n              return False\n      return True\n  \n  # Define the action mapping\n  actions = {\n    'UP': 1,\n    'DOWN': 0,\n    'LEFT': 2,\n    'RIGHT': 3,\n    'USE': 4\n  }\n  \n  # Retrieve the current state and grid\n  current_state = env._current_state\n  grid = current_state.grid\n  \n  # Get the initial position, inventory, and all positions of the primitive to be collected\n  start_position = current_state.pos\n  inventory = [env.world.cookbook.index.inverse[idx] for idx in np.where(current_state.inventory)[0]]\n  goal_positions = get_primitive_indices(primitive, grid)\n  \n  if not goal_positions:\n    return [], 0, []  # No goals found, no actions needed\n  \n  # Filter out unreachable primitive positions\n  reachable_goal_positions = [pos for pos in goal_positions if is_primitive_reachable(pos, grid, inventory)]\n  \n  if not reachable_goal_positions:\n    return [], 0, []  # No reachable goals found, no actions needed\n  \n  # Initialize the priority queue for A* search\n  open_set = []\n  heapq.heappush(open_set, (0, start_position))\n  came_from = {}\n  g_score = defaultdict(lambda: float('inf'))\n  g_score[start_position] = 0\n  f_score = defaultdict(lambda: float('inf'))\n  f_score[start_position] = heuristic(start_position, reachable_goal_positions[0]) # Just take the first goal as target for simplicity\n  \n  while open_set:\n    _, current = heapq.heappop(open_set)\n    \n    if current in reachable_goal_positions:\n      path = []\n      while current in came_from:\n        path.append(current)\n        current = came_from[current]\n      path.reverse()\n      break\n    \n    neighbors = get_neighbors(current, grid.shape[0], grid.shape[1])\n    for neighbor in neighbors:\n      tentative_g_score = g_score[current] + 1\n      \n      if tentative_g_score < g_score[neighbor]:\n        came_from[neighbor] = current\n        g_score[neighbor] = tentative_g_score\n        f_score[neighbor] = tentative_g_score + heuristic(neighbor, reachable_goal_positions[0])\n        heapq.heappush(open_set, (f_score[neighbor], neighbor))\n  \n  else:\n    return [], 0, []  # No path found\n  \n  # Convert the path into actions\n  action_list = []\n  for i in range(len(path) - 1):\n    current_pos, next_pos = path[i], path[i + 1]\n    dx = next_pos[0] - current_pos[0]\n    dy = next_pos[1] - current_pos[1]\n    \n    if dx == 1:\n      action_list.append(actions['RIGHT'])\n    elif dx == -1:\n      action_list.append(actions['LEFT'])\n    elif dy == 1:\n      action_list.append(actions['DOWN'])\n    elif dy == -1:\n      action_list.append(actions['UP'])\n  \n  # Append the USE action to collect the primitive\n  action_list.append(actions['USE'])\n\n  reward = 0\n  state = current_state\n  for a in action_list:\n      r, state = env.step(state, a)\n      reward += r\n\n  return state, reward, action_list", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-08-12T14:46:44.898777", "function_name": "collect", "function_body": "  # Get the index of the target primitive\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Initialize a queue for BFS and a set to track visited states\n  queue = collections.deque([(state.grid, state.pos, state.dir, state.inventory)])\n  visited = set()\n  \n  # Define action mapping from directions to indices\n  actions = {\n      'UP': env.action_specs()[env.DOWN],\n      'DOWN': env.action_specs()[env.UP],\n      'LEFT': env.action_specs()[env.LEFT],\n      'RIGHT': env.action_specs()[env.RIGHT]\n  }\n\n  while queue:\n      grid, pos, dir, inventory = queue.popleft()\n      \n      # Check if the current position has the target primitive\n      if state.next_to(primitive_index):\n          # Collect the primitive\n          action_list.append(env.action_specs()['USE'])\n          return action_list\n\n      # Explore neighboring positions\n      for move_action in actions.values():\n          new_state, _ = state.step(move_action)\n          new_grid, new_pos, new_dir, new_inventory = new_state.grid, new_state.pos, new_state.dir, new_state.inventory\n          \n          if (new_grid.tobytes(), new_pos, new_dir, tuple(new_inventory)) not in visited:\n              visited.add((new_grid.tobytes(), new_pos, new_dir, tuple(new_inventory)))\n              queue.append((new_grid, new_pos, new_dir, new_inventory))\n              action_list.append(move_action)\n\n  return state, reward, action_list", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-08-12T14:46:45.868865", "function_name": "collect", "function_body": "  def find_primitive(primitive_name):\n    for i in range(env.world.grid.shape[0]):\n        for j in range(env.world.grid.shape[1]):\n            if state.grid[i, j, env.world.index.get(primitive_name)] > 0:\n                return (i, j)\n    return None\n\n  action_list = []\n  reward = 0\n  state = env._current_state\n  goal_pos = find_primitive(primitive)\n\n  # A simple BFS to find the shortest path to the primitive\n  if goal_pos is not None:\n      queue = collections.deque([(state.pos, [])])\n      visited = set()\n      while queue:\n          current_pos, actions = queue.popleft()\n          if current_pos == goal_pos:\n              action_list = actions\n              break\n          if current_pos in visited:\n              continue\n          visited.add(current_pos)\n          for move_action in [0, 1, 2, 3]:  # Assuming DOWN, UP, LEFT, RIGHT are mapped to these indices\n              new_pos = state._move(state.pos, move_action)\n              if env.world.grid[new_pos[0], new_pos[1]].sum() == 0:  # Check if the cell is empty or accessible\n                  queue.append((new_pos, actions + [move_action]))\n\n      for a in action_list:\n          r, state = env.step(state, a)\n          reward += r\n\n  return state, reward, action_list", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-08-12T14:47:55.594884", "function_name": "collect", "function_body": "  # Define constants for directions\n  UP, DOWN, LEFT, RIGHT = range(4)\n  \n  def get_neighbors(pos):\n      x, y = pos\n      return [(x+1, y), (x-1, y), (x, y+1), (x, y-1)]\n      \n  def is_valid_pos(pos, grid):\n      x, y = pos\n      return 0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]\n  \n  def find_path(grid, start, end):\n      queue = collections.deque([(start, [])])\n      visited = set()\n      \n      while queue:\n          (x, y), path = queue.popleft()\n          \n          if (x, y) == end:\n              return path\n          \n          for nx, ny in get_neighbors((x, y)):\n              if is_valid_pos((nx, ny), grid) and grid[nx, ny] != env.world.water_index and (nx, ny) not in visited:\n                  queue.append(((nx, ny), path + [(nx, ny)]))\n                  visited.add((nx, ny))\n                  \n      return None\n  \n  def can_cross_water(grid, pos):\n      x, y = pos\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          nx, ny = x + dx, y + dy\n          if is_valid_pos((nx, ny), grid) and grid[nx, ny] == env.world.water_index:\n              return True\n      return False\n  \n  def place_bridge(env, pos):\n      action_list.append(craft.CRAFT_FUNC('BRIDGE'))\n      env.step(action_list[-1])\n      \n  state = env._current_state\n  grid = state.grid\n  start_pos = state.pos\n  target_kind = env.world.cookbook.index[primitive]\n  \n  for x in range(grid.shape[0]):\n      for y in range(grid.shape[1]):\n          if grid[x, y] == target_kind:\n              end_pos = (x, y)\n              break\n  \n  path = find_path(grid, start_pos, end_pos)\n  if path:\n      for nx, ny in path:\n          if can_cross_water(grid, state.pos):\n              place_bridge(env)\n          dx, dy = nx - state.pos[0], ny - state.pos[1]\n          \n          if dx == 1:\n              action_list.append(UP)\n          elif dx == -1:\n              action_list.append(DOWN)\n          elif dy == 1:\n              action_list.append(RIGHT)\n          elif dy == -1:\n              action_list.append(LEFT)\n          \n          env.step(action_list[-1])\n  \n  # Collect the target primitive\n  action_list.append(craft.CRAFT_FUNC(primitive))\n  env.step(action_list[-1])\n\n  return state, reward, action_list", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-08-12T14:47:56.564311", "function_name": "collect", "function_body": "  # Define the target primitive index\n  target_primitive_index = env.world.cookbook.index[primitive]\n\n  # Check if the target primitive is in the environment (can be picked up)\n  if target_primitive_index not in env.world.grabbable_indices:\n      raise ValueError(f\"Primitive '{primitive}' cannot be picked up in this environment.\")\n\n  action_list = []\n  reward = 0\n  state = env._current_state\n\n  # Use BFS to find a path to the closest instance of the target primitive\n  from collections import deque\n\n  def bfs_find_target(state):\n      visited = set()\n      queue = deque([(state, [])])  # (current_state, actions_taken)\n\n      while queue:\n          current_state, actions = queue.popleft()\n\n          if current_state.next_to(target_primitive_index):\n              return actions\n\n          for action in range(5):  # Assuming actions are indexed from 0 to 4\n              r, new_state = env.step(current_state, action)\n              reward += r\n              if new_state.pos not in visited:\n                  visited.add(new_state.pos)\n                  queue.append((new_state, actions + [action]))\n\n      return None\n\n  path_to_primitive = bfs_find_target(state)\n\n  if path_to_primitive is None:\n      raise ValueError(f\"No path found to collect '{primitive}'.\")\n\n  # Add the path actions to the action list\n  action_list.extend(path_to_primitive)\n\n  # Collect the primitive (USE action)\n  use_action = env.world.cookbook.index[\"USE\"]\n  if use_action not in range(5):\n      raise ValueError(\"USE action index is out of the expected range.\")\n  \n  action_list.append(use_action)\n\n  return state, reward, action_list", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-08-12T14:50:02.750497", "function_name": "collect", "function_body": "  import heapq\n  from collections import defaultdict\n  \n  def heuristic(pos1, pos2):\n      return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n  \n  def is_valid_position(x, y, grid_width, grid_height):\n      return 0 <= x < grid_width and 0 <= y < grid_height\n  \n  def get_neighbors(position, grid_width, grid_height):\n      x, y = position\n      neighbors = [(x-1, y), (x+1, y), (x, y-1), (x, y+1)]\n      return [n for n in neighbors if is_valid_position(n[0], n[1], grid_width, grid_height)]\n\n  def get_primitive_indices(primitive, grid):\n      primitive_index = env.world.cookbook.index.index(primitive)\n      positions = []\n      for x in range(grid.shape[0]):\n          for y in range(grid.shape[1]):\n              if np.any(grid[x, y] == primitive_index):\n                  positions.append((x, y))\n      return positions\n  \n  def is_primitive_reachable(position, primitive_index, grid):\n      reachable_tools = {\n          'BRIDGE': env.world.cookbook.index.index('WATER'),\n          'PICKAXE': env.world.cookbook.index.index('GEM')\n      }\n      \n      for x in range(grid.shape[0]):\n          for y in range(grid.shape[1]):\n              if grid[x, y] == primitive_index:\n                  return True\n              for tool, target_primitive in reachable_tools.items():\n                  if grid[x, y] == env.world.cookbook.index.index(tool) and grid[position] == target_primitive:\n                      return True\n      return False\n  \n  # Define the action mapping\n  actions = {\n      'UP': 1,\n      'DOWN': 0,\n      'LEFT': 2,\n      'RIGHT': 3,\n      'USE': 4\n  }\n  \n  # Retrieve the current state and grid\n  current_state = env._current_state\n  grid = current_state.grid\n  \n  # Get the initial position and all positions of the primitive to be collected\n  start_position = current_state.pos\n  goal_positions = get_primitive_indices(primitive, grid)\n  \n  if not goal_positions:\n      return [], 0, []  # No goals found, no actions needed\n  \n  # Initialize the priority queue for A* search\n  open_set = []\n  heapq.heappush(open_set, (0, start_position))\n  came_from = {}\n  g_score = defaultdict(lambda: float('inf'))\n  g_score[start_position] = 0\n  f_score = defaultdict(lambda: float('inf'))\n  f_score[start_position] = heuristic(start_position, goal_positions[0]) # Just take the first goal as target for simplicity\n  \n  while open_set:\n      _, current = heapq.heappop(open_set)\n      \n      if is_primitive_reachable(current, env.world.cookbook.index.index(primitive), grid):\n          path = []\n          while current in came_from:\n              path.append(current)\n              current = came_from[current]\n          path.reverse()\n          break\n      \n      neighbors = get_neighbors(current, grid.shape[0], grid.shape[1])\n      for neighbor in neighbors:\n          tentative_g_score = g_score[current] + 1\n          \n          if tentative_g_score < g_score[neighbor]:\n              came_from[neighbor] = current\n              g_score[neighbor] = tentative_g_score\n              f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal_positions[0])\n              heapq.heappush(open_set, (f_score[neighbor], neighbor))\n  \n  else:\n      return [], 0, []  # No path found\n  \n  # Convert the path into actions\n  action_list = []\n  for i in range(len(path) - 1):\n      current_pos, next_pos = path[i], path[i + 1]\n      dx = next_pos[0] - current_pos[0]\n      dy = next_pos[1] - current_pos[1]\n      \n      if dx == 1:\n          action_list.append(actions['RIGHT'])\n      elif dx == -1:\n          action_list.append(actions['LEFT'])\n      elif dy == 1:\n          action_list.append(actions['DOWN'])\n      elif dy == -1:\n          action_list.append(actions['UP'])\n  \n  # Append the USE action to collect the primitive\n  action_list.append(actions['USE'])\n  \n  reward = 0\n  state = current_state\n  for a in action_list:\n      r, state = env.step(state, a)\n      reward += r\n\n  return state, reward, action_list", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-08-12T14:50:03.722950", "function_name": "collect", "function_body": "  import heapq\n  from collections import defaultdict\n\n  def heuristic(pos1, pos2):\n    return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n\n  def is_valid_position(x, y, grid_width, grid_height):\n    return 0 <= x < grid_width and 0 <= y < grid_height\n\n  def get_neighbors(position, grid_width, grid_height):\n    x, y = position\n    neighbors = [(x-1, y), (x+1, y), (x, y-1), (x, y+1)]\n    return [n for n in neighbors if is_valid_position(n[0], n[1], grid_width, grid_height)]\n\n  def get_primitive_indices(primitive, grid):\n    primitive_index = env.world.cookbook.index.index(primitive)\n    positions = []\n    for x in range(grid.shape[0]):\n      for y in range(grid.shape[1]):\n        if np.any(grid[x, y] == primitive_index):\n          positions.append((x, y))\n    return positions\n\n  def can_use_tool(tool, target_primitive, state):\n    tool_index = env.world.cookbook.index.index(tool)\n    target_index = env.world.cookbook.index.index(target_primitive)\n\n    # Check if the agent has the required tool in inventory\n    if not np.any(state.inventory == tool_index):\n      return False\n\n    # Check if there is a path to use the tool on the target primitive\n    for x in range(grid.shape[0]):\n      for y in range(grid.shape[1]):\n        if grid[x, y] == target_index:\n          # Find the shortest path from current position to the target primitive\n          path = astar_search(state.pos, (x, y), state.grid)\n          if path:\n            return True\n    return False\n\n  def astar_search(start, goal, grid):\n    open_set = []\n    heapq.heappush(open_set, (0, start))\n    came_from = {}\n    g_score = defaultdict(lambda: float('inf'))\n    g_score[start] = 0\n    f_score = defaultdict(lambda: float('inf'))\n    f_score[start] = heuristic(start, goal)\n\n    while open_set:\n      _, current = heapq.heappop(open_set)\n      \n      if current == goal:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        path.reverse()\n        return path\n      \n      neighbors = get_neighbors(current, grid.shape[0], grid.shape[1])\n      for neighbor in neighbors:\n        tentative_g_score = g_score[current] + 1\n        \n        if tentative_g_score < g_score[neighbor]:\n          came_from[neighbor] = current\n          g_score[neighbor] = tentative_g_score\n          f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n          heapq.heappush(open_set, (f_score[neighbor], neighbor))\n    \n    return None  # No path found\n\n  # Define the action mapping\n  actions = {\n      'UP': 1,\n      'DOWN': 0,\n      'LEFT': 2,\n      'RIGHT': 3,\n      'USE': 4\n  }\n  \n  # Retrieve the current state and grid\n  current_state = env._current_state\n  grid = current_state.grid\n  \n  # Get the initial position and all positions of the primitive to be collected\n  start_position = current_state.pos\n  goal_positions = get_primitive_indices(primitive, grid)\n  \n  if not goal_positions:\n      return [], 0, []  # No goals found, no actions needed\n\n  reachable_goals = []\n  for goal in goal_positions:\n    path = astar_search(start_position, goal, grid)\n    if path:\n      reachable_goals.append((goal, path))\n\n  if not reachable_goals:\n      return [], 0, []  # No reachable goals found\n\n  # Find the closest reachable goal\n  target_goal, shortest_path = min(reachable_goals, key=lambda x: len(x[1]))\n\n  # Convert the path into actions\n  action_list = []\n  for i in range(len(shortest_path) - 1):\n      current_pos, next_pos = shortest_path[i], shortest_path[i + 1]\n      dx = next_pos[0] - current_pos[0]\n      dy = next_pos[1] - current_pos[1]\n\n      if dx == 1:\n          action_list.append(actions['RIGHT'])\n      elif dx == -1:\n          action_list.append(actions['LEFT'])\n      elif dy == 1:\n          action_list.append(actions['DOWN'])\n      elif dy == -1:\n          action_list.append(actions['UP'])\n\n  # Append the USE action to collect the primitive\n  action_list.append(actions['USE'])\n\n  reward = 0\n  state = current_state\n  for a in action_list:\n      r, state = env.step(state, a)\n      reward += r\n\n  return state, reward, action_list", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-08-12T14:52:01.610418", "function_name": "collect", "function_body": "  MAX_STEPS = 50\n  UP, DOWN, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  action_list = []\n  state = env._current_state\n  target_index = state.world.cookbook.index[primitive]\n\n  # Priority queue for BFS (position, steps, inventory, actions)\n  queue = collections.deque([(state.pos, 0, np.copy(state.inventory), [])])\n  visited = set()\n\n  while queue:\n      pos, steps, inv, actions = queue.popleft()\n\n      if steps >= MAX_STEPS:\n          continue\n\n      # Check if the position and inventory have been visited\n      state_key = (tuple(pos), tuple(inv))\n      if state_key in visited:\n          continue\n      visited.add(state_key)\n\n      # Create a new state object for the current BFS step\n      state = craft.CraftState(\n          scenario=state.scenario,\n          grid=np.copy(state.grid),\n          pos=pos,\n          dir=state.dir,\n          inventory=np.copy(inv)\n      )\n\n      # Check if the target primitive is next to the agent\n      adjacent_cells = [\n          (pos[0], pos[1] - 1),  # UP\n          (pos[0], pos[1] + 1),  # DOWN\n          (pos[0] - 1, pos[1]),  # LEFT\n          (pos[0] + 1, pos[1])   # RIGHT\n      ]\n\n      for adj_pos in adjacent_cells:\n          if not (0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]):\n              continue\n\n          cell_index = np.argmax(state.grid[adj_pos])\n          if cell_index == target_index:\n              action_list = actions + [USE]\n              return action_list, 0, action_list\n\n      # Generate possible moves\n      for direction in [(0, -1), (0, 1), (-1, 0), (1, 0)]:\n          new_pos = (pos[0] + direction[0], pos[1] + direction[1])\n\n          if not (0 <= new_pos[0] < state.grid.shape[0] and 0 <= new_pos[1] < state.grid.shape[1]):\n              continue\n\n          cell_index = np.argmax(state.grid[new_pos])\n          if cell_index in state.world.non_grabbable_indices:\n              continue\n\n          queue.append((new_pos, steps + 1, inv, actions + [direction_to_action(direction)]))\n\n      # Check for tool usage\n      inventory_items = np.where(inv > 0)[0]\n      for item_idx in inventory_items:\n          tool_effectiveness = state.world.tool_effects.get(item_idx)\n          if not tool_effectiveness:\n              continue\n\n          for adj_pos in adjacent_cells:\n              if not (0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]):\n                  continue\n\n              cell_index = np.argmax(state.grid[adj_pos])\n              if tool_effectiveness.get(cell_index):\n                  new_inv = inv.copy()\n                  new_inv[item_idx] -= 1  # Consume the tool\n                  queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n\n  return [], -1, []  # Return empty list and negative reward if target is unreachable", "island_id": 5, "scores": {"3": -1}}
