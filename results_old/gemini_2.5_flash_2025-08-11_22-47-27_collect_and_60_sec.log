] and state.world.cookbook.index.get('CART') == item_idx:\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['ROUGH_TERRAIN']:\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n  # If no path is found within the maximum number of steps, return an empty action list and a non-zero reward\n  return [], -1", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-08-12T23:16:55.243698", "function_name": "collect", "function_body": "  def can_move(pos: tuple, grid):\n      x, y = pos\n      return (0 <= x < grid.shape[0] and \n              0 <= y < grid.shape[1] and\n              np.argmax(grid[pos]) not in env._current_state.world.non_grabbable_indices)\n\n  def use_tool(state, tool_idx, primitive):\n      adjacent_cells = [\n          (state.pos[0], state.pos[1] - 1),  # UP\n          (state.pos[0], state.pos[1] + 1),  # DOWN\n          (state.pos[0] - 1, state.pos[1]),  # LEFT\n          (state.pos[0] + 1, state.pos[1])   # RIGHT\n      ]\n      \n      for adj_pos in adjacent_cells:\n          if can_move(adj_pos, state.grid):\n              cell_index = np.argmax(state.grid[adj_pos])\n              target_index = state.world.cookbook.index[primitive]\n              tool_effect = state.world.tool_effects.get(tool_idx)\n\n              if cell_index == target_index and primitive in ['GOLD', 'GEM']:\n                  return adj_pos, 2, [USE]\n\n              elif cell_index == state.world.cookbook.index['PLATFORM'] and primitive in ['WOOD', 'GEM']:\n                  return adj_pos, 2, [USE]\n\n              elif tool_effect:\n                  target_cells = [state.world.cookbook.index[target] for target in tool_effect]\n                  if cell_index in target_cells:\n                      return adj_pos, 2, [USE]\n\n      return None, 0, []\n\n  MAX_STEPS = 300\n  UP, DOWN, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  action_list = []\n  state = env._current_state\n  target_index = state.world.cookbook.index[primitive]\n\n  # Priority queue for BFS (position, steps, inventory, actions)\n  queue = collections.deque([(state.pos, 0, np.copy(state.inventory), [])])\n  visited = set()\n\n  while queue:\n      pos, steps, inv, actions = queue.popleft()\n\n      if steps >= MAX_STEPS:\n          continue\n\n      # Check if the position and inventory have been visited\n      state_key = (tuple(pos), tuple(inv))\n      if state_key in visited:\n          continue\n      visited.add(state_key)\n\n      # Create a new state object for the current BFS step\n      state = craft.CraftState(\n          scenario=state.scenario,\n          grid=np.copy(state.grid),\n          pos=pos,\n          dir=state.dir,\n          inventory=np.copy(inv)\n      )\n\n      # Check if the target primitive is next to the agent\n      if state.next_to(target_index):\n          action_list = actions + [USE]\n          return action_list, 0, action_list\n\n      # Generate possible moves\n      new_positions = [\n          (pos[0], pos[1] - 1),  # UP\n          (pos[0], pos[1] + 1),  # DOWN\n          (pos[0] - 1, pos[1]),  # LEFT\n          (pos[0] + 1, pos[1])   # RIGHT\n      ]\n\n      for i, new_pos in enumerate(new_positions):\n          if can_move(new_pos, state.grid):\n              queue.append((new_pos, steps + 1, inv, actions + [i]))\n\n      # Check for tool usage\n      inventory_items = np.where(inv > 0)[0]\n      for item_idx in inventory_items:\n          new_pos, additional_steps, additional_actions = use_tool(state, item_idx, primitive)\n          if new_pos:\n              queue.append((new_pos, steps + additional_steps, inv - 1, actions + additional_actions))\n\n  return [], -1, []  # Return empty list and negative reward if target is unreachable", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-08-12T23:18:48.564008", "function_name": "collect", "function_body": "  MAX_STEPS = 100\n  UP, DOWN, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  state = env._state\n  target_index = state.world.cookbook.index[primitive]\n\n  # Priority queue for BFS (position, steps, inventory, actions)\n  queue = collections.deque([(state.pos, 0, np.copy(state.inventory), [])])\n  visited = set()\n\n  while queue:\n      pos, steps, inv, actions = queue.popleft()\n\n      if steps >= MAX_STEPS:\n          continue\n\n      # Check if the position and inventory have been visited\n      state_key = (tuple(pos), tuple(inv))\n      if state_key in visited:\n          continue\n      visited.add(state_key)\n\n      # Create a new state object for the current BFS step\n      new_state = craft.CraftState(\n          scenario=state.scenario,\n          pos=pos,\n          inventory=np.copy(inv)\n      )\n\n      # Check if the target primitive is next to the agent\n      adjacent_cells = [\n          (pos[0], pos[1] - 1),  # UP\n          (pos[0], pos[1] + 1),  # DOWN\n          (pos[0] - 1, pos[1]),  # LEFT\n          (pos[0] + 1, pos[1])   # RIGHT\n      ]\n\n      for adj_pos in adjacent_cells:\n          if 0 <= adj_pos[0] < new_state.grid.shape[0] and 0 <= adj_pos[1] < new_state.grid.shape[1]:\n              cell_index = np.argmax(new_state.grid[adj_pos])\n              if cell_index == target_index:\n                  action_list = actions + [UP, USE] if adj_pos[1] < pos[1] else \\\n                                actions + [DOWN, USE] if adj_pos[1] > pos[1] else \\\n                                actions + [LEFT, USE] if adj_pos[0] < pos[0] else \\\n                                actions + [RIGHT, USE]\n                  return action_list, 0, action_list\n\n      # Generate possible moves\n      for i, new_pos in enumerate(adjacent_cells):\n          if 0 <= new_pos[0] < new_state.grid.shape[0] and 0 <= new_pos[1] < new_state.grid.shape[1]:\n              cell_index = np.argmax(new_state.grid[new_pos])\n              if cell_index not in state.world.non_grabbable_indices:\n                  queue.append((new_pos, steps + 1, inv, actions + [i]))\n\n      # Check for tool usage\n      inventory_items = np.where(inv > 0)[0]\n      for item_idx in inventory_items:\n          required_target = None\n          if primitive == 'GOLD' and item_idx == state.world.cookbook.index['BRIDGE']:\n              required_target = 'WATER'\n          elif primitive == 'GEM' and item_idx == state.world.cookbook.index['PICKAXE']:\n              required_target = 'ROCK'\n          elif primitive == 'TREE' and item_idx == state.world.cookbook.index['AXE']:\n              required_target = 'TREE'\n          elif primitive == 'BOULDER' and item_idx == state.world.cookbook.index['HAMMER']:\n              required_target = 'BOULDER'\n          elif primitive == 'IRON_ORE' and item_idx == state.world.cookbook.index['DRILL']:\n              required_target = 'IRON_ORE'\n          elif primitive in ['BUSH', 'CLOTH'] and item_idx == state.world.cookbook.index['SHEARS']:\n              required_target = 'BUSH'\n\n          if required_target is not None:\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < new_state.grid.shape[0] and 0 <= adj_pos[1] < new_state.grid.shape[1]:\n                      cell_index = np.argmax(new_state.grid[adj_pos])\n                      if state.world.cookbook[cell_index] == required_target:\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n\n  return [], -1, []  # Return empty list and negative reward if target is unreachable", "island_id": 2, "scores": {"3": -1}}
