]))\n                          break\n\n          elif primitive == 'ROCK' and state.world.cookbook.index.get('AXE') == item_idx:\n              # Check if there's wood next to the agent\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['WOOD']:\n                          # Use AXE to mine ROCK\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the axe\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n          elif primitive == 'WATER' and state.world.cookbook.index.get('BUCKET') == item_idx:\n              # Check if there's water next to the agent (collecting water)\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['WATER']:\n                          # Use BUCKET to collect WATER\n                          new_inv = inv.copy()\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n  return [], -1, []  # Return empty list and negative reward if target is unreachable", "island_id": 2, "scores": {"3": 0.5}}
{"timestamp": "2025-08-12T20:24:45.404000", "function_name": "collect", "function_body": "  def get_adjacent_cells(pos):\n      UP = (pos[0], pos[1] - 1)\n      DOWN = (pos[0], pos[1] + 1)\n      LEFT = (pos[0] - 1, pos[1])\n      RIGHT = (pos[0] + 1, pos[1])\n      return [UP, DOWN, LEFT, RIGHT]\n\n  def is_valid_position(new_pos, grid_shape):\n      x, y = new_pos\n      return 0 <= x < grid_shape[0] and 0 <= y < grid_shape[1]\n\n  MAX_STEPS = 100\n  UP, DOWN, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  action_list = []\n  state = env._current_state\n  target_index = state.world.cookbook.index[primitive]\n  grid_shape = state.grid.shape\n\n  # Priority queue for BFS (position, steps, inventory, actions)\n  queue = collections.deque([(state.pos, 0, np.copy(state.inventory), [])])\n  visited = set()\n\n  while queue:\n      pos, steps, inv, actions = queue.popleft()\n\n      if steps >= MAX_STEPS:\n          continue\n\n      # Check if the position and inventory have been visited\n      state_key = (tuple(pos), tuple(inv))\n      if state_key in visited:\n          continue\n      visited.add(state_key)\n\n      # Create a new state object for the current BFS step\n      state = craft.CraftState(\n          scenario=state.scenario,\n          grid=np.copy(state.grid),\n          pos=pos,\n          dir=state.dir,\n          inventory=np.copy(inv)\n      )\n\n      # Check if the target primitive is next to the agent\n      adjacent_cells = get_adjacent_cells(pos)\n      for adj_pos in adjacent_cells:\n          if not is_valid_position(adj_pos, grid_shape):\n              continue\n          cell_index = np.argmax(state.grid[adj_pos])\n          if cell_index == target_index:\n              action_list = actions + [USE]\n              return action_list, 0, action_list\n\n      # Generate possible moves and use of tools\n      for move_action in range(4):  # UP, DOWN, LEFT, RIGHT\n          new_pos = get_adjacent_cells(pos)[move_action]\n          if is_valid_position(new_pos, grid_shape):\n              cell_index = np.argmax(state.grid[new_pos])\n              if cell_index not in state.world.non_grabbable_indices:\n                  queue.append((new_pos, steps + 1, inv, actions + [move_action]))\n\n      # Check for tool usage\n      inventory_items = np.where(inv > 0)[0]\n      for item_idx in inventory_items:\n          tool_name = state.world.cookbook.index.get_index(item_idx)\n          if tool_name == 'BRIDGE':\n              adjacent_cells = get_adjacent_cells(pos)\n              for adj_pos in adjacent_cells:\n                  if not is_valid_position(adj_pos, grid_shape):\n                      continue\n                  cell_index = np.argmax(state.grid[adj_pos])\n                  if cell_index == state.world.cookbook.index['WATER']:\n                      new_inv = inv.copy()\n                      new_inv[item_idx] -= 1  # Consume the bridge\n                      queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                      break\n\n          elif tool_name == 'PICKAXE':\n              adjacent_cells = get_adjacent_cells(pos)\n              for adj_pos in adjacent_cells:\n                  if not is_valid_position(adj_pos, grid_shape):\n                      continue\n                  cell_index = np.argmax(state.grid[adj_pos])\n                  if cell_index == state.world.cookbook.index['ROCK']:\n                      new_inv = inv.copy()\n                      new_inv[item_idx] -= 1  # Consume the pickaxe\n                      queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                      break\n\n          elif tool_name == 'AXE':\n              adjacent_cells = get_adjacent_cells(pos)\n              for adj_pos in adjacent_cells:\n                  if not is_valid_position(adj_pos, grid_shape):\n                      continue\n                  cell_index = np.argmax(state.grid[adj_pos])\n                  if cell_index == state.world.cookbook.index['TREE']:\n                      new_inv = inv.copy()\n                      new_inv[item_idx] -= 1  # Consume the axe\n                      queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                      break\n\n  return [], -1, []  # Return empty list and negative reward if target is unreachable", "island_id": 4, "scores": {"3": -1}}
