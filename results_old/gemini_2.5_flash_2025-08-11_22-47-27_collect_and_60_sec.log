e.world.cookbook.index['ROCK'],\n              'AXE': state.world.cookbook.index['TREE']\n          }\n          if item_idx in tool_effects.keys():\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == tool_effects[item_idx]:\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n      # Add logic to handle placing tools like BRIDGE in adjacent cells\n      for item_idx in inventory_items:\n          tool_effects = {\n              'BRIDGE': state.world.cookbook.index['WATER']\n          }\n          if item_idx == state.world.cookbook.index.get('BRIDGE'):\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == tool_effects['BRIDGE']:\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1\n                          # Simulate placing the bridge in the adjacent cell\n                          new_grid = np.copy(state.grid)\n                          new_grid[adj_pos, :] = 0\n        