ry_items:\n              if state.world.cookbook.index.get(tool_name) == item_idx:\n                  adjacent_cells = [\n                      (pos[0], pos[1] - 1),  # UP\n                      (pos[0], pos[1] + 1),  # DOWN\n                      (pos[0] - 1, pos[1]),  # LEFT\n                      (pos[0] + 1, pos[1])   # RIGHT\n                  ]\n                  for adj_pos in adjacent_cells:\n                      if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                          cell_index = np.argmax(state.grid[adj_pos])\n                          if cell_index == state.world.cookbook.index.get(resource_name):\n                              new_inv = inv.copy()\n                              new_inv[item_idx] -= 1  # Consume the tool\n                              queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                              break\n\n      def build_structure(structure_name, resource_name):\n          inventory_items = np.where(inv > 0)[0]\n          for item_idx in inventory_items:\n              if state.world.cookbook.index.get(resource_name) == item_idx:\n                  adjacent_cells = [\n                      (pos[0], pos[1] - 1),  # UP\n                      (pos[0], pos[1] + 1),  # DOWN\n                      (pos[0] - 1, pos[1]),  # LEFT\n                      (pos[0] + 1, pos[1])   # RIGHT\n                  ]\n                  for adj_pos in adjacent_cells:\n                      if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                          cell_index = np.argmax(state.grid[adj_pos])\n                          if cell_index == state.world.cookbook.index.get('WORKSHOP'):\n                              new_inv = inv.copy()\n                              new_inv[item_idx] -= 1  # Consume the resource\n                              new_grid = np.copy(state.grid)\n                              new_grid[adj_pos, target_index] += 1  # Place the structure\n                              queue.append((adj_pos, steps + 3, new_inv, actions + [USE]))\n                              break\n\n      # Check for BRIDGE usage for WATER if target is GOLD\n      if primitive == 'GOLD':\n          use_tool('BRIDGE', 'WATER')\n          build_structure('BRIDGE', 'WOOD')\n\n      # Check for PICKAXE usage for GEM\n      elif primitive == 'GEM':\n          use_tool('PICKAXE', 'ROCK')\n          build_structure('PICKAXE', 'IRON')\n\n      # Check for AXE usage for WOOD\n      elif primitive == 'WOOD':\n          use_tool('AXE', 'TREE')\n          build_structure('AXE', 'STONE')\n\n  return [], -1, []  # Return empty list and negative reward if target is unreachable", "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-08-12T20:34:16.201088", "function_name": "collect", "function_body": "  MAX_STEPS = 100\n  UP, DOWN, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  action_list = []\n  state = env._current_state\n  target_index = state.world.cookbook.index[primitive]\n\n  # Priority queue for BFS (position, steps, inventory, actions)\n  queue = collections.deque([(state.pos, 0, np.copy(state.inventory), [])])\n  visited = set()\n\n  while queue:\n      pos, steps, inv, actions = queue.popleft()\n\n      if steps >= MAX_STEPS:\n          continue\n\n      # Check if the position and inventory have been visited\n      state_key = (tuple(pos), tuple(inv))\n      if state_key in visited:\n          continue\n      visited.add(state_key)\n\n      # Create a new state object for the current BFS step\n      state = craft.CraftState(\n          scenario=state.scenario,\n          grid=np.copy(state.grid),\n          pos=pos,\n          dir=state.dir,\n          inventory=np.copy(inv)\n      )\n\n      # Check if the target primitive is next to the agent\n      if state.next_to(target_index):\n          action_list = actions + [USE]\n          return action_list, 0, action_list\n\n      # Generate possible moves and use of tools\n      new_positions = [\n          (pos[0], pos[1] - 1),  # UP\n          (pos[0], pos[1] + 1),  # DOWN\n          (pos[0] - 1, pos[1]),  # LEFT\n          (pos[0] + 1, pos[1])   # RIGHT\n      ]\n\n      for i, new_pos in enumerate(new_positions):\n          if 0 <= new_pos[0] < state.grid.shape[0] and 0 <= new_pos[1] < state.grid.shape[1]:\n              cell_index = np.argmax(state.grid[new_pos])\n              if cell_index not in state.world.non_grabbable_indices:\n                  queue.append((new_pos, steps + 1, inv, actions + [i]))\n\n      # Check for tool usage\n      inventory_items = np.where(inv > 0)[0]\n      for item_idx in inventory_items:\n          tool_effect = None\n\n          if primitive == 'GOLD':\n              if state.world.cookbook.index.get('BRIDGE') == item_idx:\n                  tool_effect = 'WATER'\n              elif state.world.cookbook.index.get('BOAT') == item_idx:\n                  tool_effect = 'WATER'  # Alternative tool for WATER\n          elif primitive == 'GEM':\n              if state.world.cookbook.index.get('PICKAXE') == item_idx:\n                  tool_effect = 'ROCK'\n              elif state.world.cookbook.index.get('HAMMER') == item_idx:\n                  tool_effect = 'ROCK'  # Alternative tool for ROCK\n          elif primitive == 'WOOD':\n              if state.world.cookbook.index.get('AXE') == item_idx:\n                  tool_effect = 'TREE'\n              elif state.world.cookbook.index.get('CHOPPER') == item_idx:\n                  tool_effect = 'TREE'  # Alternative tool for TREE\n          elif primitive == 'STONE':\n              if state.world.cookbook.index.get('HAMMER') == item_idx:\n                  tool_effect = 'ROCK'\n\n          if tool_effect:\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index[tool_effect]:\n                          # Use tool to interact with the environment\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the tool\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n      # Additional logic for dynamic tool usage based on environment conditions\n      if primitive == 'GOLD':\n          for adj_pos in new_positions:\n              if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                  cell_index = np.argmax(state.grid[adj_pos])\n                  if cell_index == state.world.cookbook.index['WATER']:\n                      # If WATER is next to the agent, check for tools in inventory\n                      if inv[state.world.cookbook.index.get('BRIDGE', -1)] > 0:\n                          action_list.extend([USE])  # Place BRIDGE\n                          new_inv = np.copy(inv)\n                          new_inv[state.world.cookbook.index['BRIDGE']] -= 1\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                      elif inv[state.world.cookbook.index.get('BOAT', -1)] > 0:\n                          action_list.extend([USE])  # Use BOAT\n                          new_inv = np.copy(inv)\n                          new_inv[state.world.cookbook.index['BOAT']] -= 1\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n\n      elif primitive == 'GEM':\n          for adj_pos in new_positions:\n              if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                  cell_index = np.argmax(state.grid[adj_pos])\n                  if cell_index == state.world.cookbook.index['ROCK']:\n                      # If ROCK is next to the agent, check for tools in inventory\n                      if inv[state.world.cookbook.index.get('PICKAXE', -1)] > 0:\n                          action_list.extend([USE])  # Use PICKAXE\n                          new_inv = np.copy(inv)\n                          new_inv[state.world.cookbook.index['PICKAXE']] -= 1\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                      elif inv[state.world.cookbook.index.get('HAMMER', -1)] > 0:\n                          action_list.extend([USE])  # Use HAMMER\n                          new_inv = np.copy(inv)\n                          new_inv[state.world.cookbook.index['HAMMER']] -= 1\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n\n      elif primitive == 'WOOD':\n          for adj_pos in new_positions:\n              if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                  cell_index = np.argmax(state.grid[adj_pos])\n                  if cell_index == state.world.cookbook.index['TREE']:\n                      # If TREE is next to the agent, check for tools in inventory\n                      if inv[state.world.cookbook.index.get('AXE', -1)] > 0:\n                          action_list.extend([USE])  # Use AXE\n                          new_inv = np.copy(inv)\n                          new_inv[state.world.cookbook.index['AXE']] -= 1\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                      elif inv[state.world.cookbook.index.get('CHOPPER', -1)] > 0:\n                          action_list.extend([USE])  # Use CHOPPER\n                          new_inv = np.copy(inv)\n                          new_inv[state.world.cookbook.index['CHOPPER']] -= 1\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n\n      elif primitive == 'STONE':\n          for adj_pos in new_positions:\n              if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                  cell_index = np.argmax(state.grid[adj_pos])\n                  if cell_index == state.world.cookbook.index['ROCK']:\n                      # If ROCK is next to the agent, check for tools in inventory\n                      if inv[state.world.cookbook.index.get('HAMMER', -1)] > 0:\n                          action_list.extend([USE])  # Use HAMMER\n                          new_inv = np.copy(inv)\n                          new_inv[state.world.cookbook.index['HAMMER']] -= 1\n                          queue.append((adj_p