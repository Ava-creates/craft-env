{"timestamp": "2025-08-12T20:38:43.391940", "function_name": "collect", "function_body": "  MAX_STEPS = 500\n  UP, DOWN, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  action_list = []\n  state = env._current_state\n  target_index = state.world.cookbook.index[primitive]\n\n  # Priority queue for BFS (steps, position, inventory, actions)\n  queue = collections.deque([(0, tuple(state.pos), tuple(state.inventory), [])])\n  visited = set()\n\n  while queue:\n      steps, pos, inv, actions = queue.popleft()\n\n      if steps >= MAX_STEPS:\n          continue\n\n      # Check if the position and inventory have been visited\n      state_key = (pos, inv)\n      if state_key in visited:\n          continue\n      visited.add(state_key)\n\n      # Create a new state object for the current BFS step\n      grid_copy = np.copy(state.grid)\n      state = craft.CraftState(\n          scenario=state.scenario,\n          world=state.world,\n          pos=np.array(pos),\n          inventory=list(inv),\n          grid=grid_copy\n      )\n\n      # Check if the target primitive is next to the agent\n      adjacent_cells = [\n          (pos[0], pos[1] - 1),  # UP\n          (pos[0], pos[1] + 1),  # DOWN\n          (pos[0] - 1, pos[1]),  # LEFT\n          (pos[0] + 1, pos[1])   # RIGHT\n      ]\n      \n      for adj_pos in adjacent_cells:\n          if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n              cell_index = np.argmax(state.grid[adj_pos])\n              if cell_index == target_index:\n                  action_list = actions + [USE]\n                  return action_list, steps, action_list\n\n      # Generate possible moves\n      for i in range(4):\n          new_pos = tuple(np.array(pos) + np.array(craft.DIR_TO_VEC[i]))\n          if 0 <= new_pos[0] < state.grid.shape[0] and 0 <= new_pos[1] < state.grid.shape[1]:\n              cell_index = np.argmax(state.grid[new_pos])\n              if cell_index not in state.world.non_grabbable_indices:\n                  queue.append((steps + 1, new_pos, inv, actions + [i]))\n\n      # Check for tool usage\n      inventory_items = np.where(np.array(inv) > 0)[0]\n      for item_idx in inventory_items:\n          tool_effect = craft.TOOL_EFFECTS.get(item_idx)\n          if tool_effect and primitive in tool_effect:\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              \n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == tool_effect[primitive][0]:\n                          new_inv = list(inv)\n                          new_inv[item_idx] -= 1\n                          queue.append((steps + 2, tuple(adj_pos), tuple(new_inv), actions + [USE]))\n                          break\n\n  return [], -1, []  # Return empty list and negative reward if target is unreachable", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-08-12T20:38:44.416914", "function_name": "collect", "function_body": "  MAX_STEPS = 500\n  UP, DOWN, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  action_list = []\n  state = env._current_state\n  target_index = state.world.cookbook.index[primitive]\n\n  # Priority queue for BFS (steps, position, inventory, actions)\n  queue = collections.deque([(0, tuple(state.pos), tuple(state.inventory), [])])\n  visited = set()\n\n  while queue:\n      steps, pos, inv, actions = queue.popleft()\n\n      if steps >= MAX_STEPS:\n          continue\n\n      # Check if the position and inventory have been visited\n      state_key = (pos, inv)\n      if state_key in visited:\n          continue\n      visited.add(state_key)\n\n      # Create a new state object for the current BFS step\n      current_state = craft.CraftState(\n          scenario=state.scenario,\n          world=state.world,\n          pos=np.array(pos),\n          inventory=dict(zip(state.world.cookbook.index, inv))\n      )\n\n      # Check if the target primitive is next to the agent\n      if current_state.next_to(target_index):\n          action_list = actions + [USE]\n          return action_list, steps, action_list\n\n      # Generate possible moves and use of tools\n      new_positions = [\n          (pos[0], pos[1] - 1),  # UP\n          (pos[0], pos[1] + 1),  # DOWN\n          (pos[0] - 1, pos[1]),  # LEFT\n          (pos[0] + 1, pos[1])   # RIGHT\n      ]\n\n      for i, new_pos in enumerate(new_positions):\n          if 0 <= new_pos[0] < current_state.world.grid.shape[0] and 0 <= new_pos[1] < current_state.world.grid.shape[1]:\n              cell_index = np.argmax(current_state.world.grid[new_pos])\n              if cell_index not in current_state.world.non_grabbable_indices:\n                  queue.append((steps + 1, new_pos, inv, actions + [i]))\n\n      # Check for tool usage\n      inventory_items = [(item, count) for item, count in current_state.inventory.items() if count > 0]\n      for i