                        new_inv[item_idx] -= 1  # Consume the axe\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n          elif primitive == 'IRON_ORE' and state.world.cookbook.index.get('PICKAXE') == item_idx:\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['IRON_ORE']:\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the pickaxe\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n  return action_list, -1, action_list", "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-08-12T15:35:33.875863", "function_name": "collect", "function_body": "  MAX_STEPS = 100\n  UP, DOWN, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  action_list = []\n  state = env._current_state\n  target_index = state.world.cookbook.index[primitive]\n\n  # Priority queue for BFS (position, steps, inventory, actions)\n  queue = collections.deque([(state.pos, 0, np.copy(state.inventory), [])])\n  visited = set()\n\n  while queue:\n      pos, steps, inv, actions = queue.popleft()\n\n      if steps >= MAX_STEPS:\n          continue\n\n      # Check if the position and inventory have been visited\n      state_key = (tuple(pos), tuple(inv))\n      if state_key in visited:\n          continue\n      visited.add(state_key)\n\n      # Create a new state object for the current BFS step\n      state = craft.CraftState(\n          scenario=state.scenario,\n          grid=np.copy(state.grid),\n          pos=pos,\n          dir=state.dir,\n          inventory=np.copy(inv)\n      )\n\n      # Check if the target primitive is next to the agent\n      adjacent_cells = [\n          (pos[0], pos[1] - 1),  # UP\n          (pos[0], pos[1] + 1),  # DOWN\n          (pos[0] - 1, pos[1]),  # LEFT\n          (pos[0] + 1, pos[1])   # RIGHT\n      ]\n      for adj_pos in adjacent_cells:\n          if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n              cell_index = np.argmax(state.grid[adj_pos])\n              if cell_index == target_index:\n                  action_list = actions + [USE]\n                  return action_list, 0, action_list\n\n      # Generate possible moves\n      for i, new_pos in enumerate(adjacent_cells):\n          if 0 <= new_pos[0] < state.grid.shape[0] and 0 <= new_pos[1] < state.grid.shape[1]:\n              cell_index = np.argmax(state.grid[new_pos])\n              if cell_index not in state.world.non_grabbable_indices:\n                  queue.append((new_pos, steps + 1, inv, actions + [i]))\n\n      # Check for tool usage\n      inventory_items = np.where(inv > 0)[0]\n      for item_idx in inventory_items:\n          if primitive == 'GOLD' and state.world.cookbook.index.get('BRIDGE') == item_idx:\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['WATER']:\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n          elif primitive in ['GEM', 'IRON'] and state.world.cookbook.index.get('PICKAXE') == item_idx:\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if (primitive == 'GEM' and cell_index == state.world.cookbook.index['ROCK']) or \\\n                         (primitive == 'IRON' and cell_index == state.world.cookbook.index['IRON_ORE']):\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n          elif primitive == 'WOOD' and state.world.cookbook.index.get('AXE') == item_idx:\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['TREE']:\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n  return [], -1, []  # Return empty list and negative reward if target is unreachable", "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-08-12T15:36:44.317518", "function_name": "collect", "function_body": "  action_map = {\n      'UP': 0,\n      'DOWN': 1,\n      'LEFT': 2,\n      'RIGHT': 3,\n      'USE': 4\n  }\n\n  # Get the index of the primitive to collect\n  cookbook = env.world.cookbook\n  primitive_index = cookbook.index[primitive]\n\n  # Initialize action list and other variables\n  action_list = []\n  reward = 0.0\n  state = env._current_state\n\n  # Define a helper function to find neighboring cells\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x-1, y), (x+1, y), (x, y-1), (x, y+1)]\n\n  # Use BFS to find the shortest path to the primitive\n  queue = collections.deque([(state.pos, [])])\n  visited = set([state.pos])\n\n  while queue:\n      current_pos, path = queue.popleft()\n\n      if state.next_to(primitive_index):\n          action_list.extend(path)\n          break\n\n      for neighbor in get_neighbors(current_pos):\n          nx, ny = neighbor\n          if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n              if neighbor not in visited:\n                  # Calculate the direction to move towards the neighbor\n                  dx, dy = nx - current_pos[0], ny - current_pos[1]\n                  direction = action_map['RIGHT'] if dx > 0 else\\\n                              action_map['LEFT'] if dx < 0 else\\\n                              action_map['DOWN'] if dy > 0 else\\\n                              action_map['UP']\n                  # Check for obstacles and use tools if necessary\n                  if state.grid[nx, ny, primitive_index] == 1:\n                      # If the primitive is directly reachable, move to it\n                      new_path = path + [direction]\n                      queue.append((neighbor, new_path))\n                      visited.add(neighbor)\n                  else:\n                      # Check for tools in inventory and use them if necessary\n                      for tool in state.inventory:\n                          if tool == 'BRIDGE' and cookbook.index['WATER'] in state.grid[nx, ny]:\n                              action_list.append(action_map['USE'])\n                              reward += env.step(action_map['USE'])[0]\n                          elif tool == 'PICKAXE' and cookbook.index['ROCK'] in state.grid[nx, ny]:\n                              action_list.append(action_map['USE'])\n                              reward += env.step(action_map['USE'])[0]\n                          else:\n                              new_path = path + [direction]\n                              queue.append((neighbor, new_path))\n                              visited.add(neighbor)\n\n  # Execute the actions to collect the primitive\n  for a in action_list:\n      r, state = env.step(a)\n      reward += r\n\n  return state, reward, action_list", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-08-12T15:36:45.287240", "function_name": "collect", "function_body": "  action_map = {\n      'UP': 0,\n      'DOWN': 1,\n      'LEFT': 2,\n      'RIGHT': 3,\n      'USE': 4\n  }\n\n  # Get the index of the primitive to collect\n  cookbook = env.world.cookbook\n  primitive_index = cookbook.index[primitive]\n\n  # Initialize action list and other variables\n  action_list = []\n  reward = 0.0\n  state = env._current_state\n\n  # Define a helper function to find neighboring cells\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x-1, y), (x+1, y), (x, y-1), (x, y+1)]\n\n  # Use BFS to find the shortest path to the primitive\n  queue = collections.deque([(state.pos, [])])\n  visited = set([state.pos])\n\n  while queue:\n      current_pos, path = queue.popleft()\n\n      if state.next_to(primitive_index):\n          action_list.extend(path)\n          break\n\n      for neighbor in get_neighbors(current_pos):\n          nx, ny = neighbor\n          if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n              if neighbor not in visited:\n                  # Calculate the direction to move towards the neighbor\n                  dx, dy = nx - current_pos[0], ny - current_pos[1]\n                  direction = action_map['RIGHT'] if dx > 0 else\\\n                              action_map['LEFT'] if dx < 0 else\\\n                              action_map['DOWN'] if dy > 0 else\\\n                              action_map['UP']\n                  new_path = path + [direction]\n                  queue.append((neighbor, new_path))\n                  visited.add(neighbor)\n\n  # Execute the actions to collect the primitive\n  for a in action_list:\n      r, done, _ = env.step(a)\n      reward += r\n\n      if state.next_to(primitive_index):\n          action_list.append(action_map['USE'])\n          break\n\n  return action_list", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-08-12T15:39:04.619577", "function_name": "collect", "function_body": "  MAX_STEPS = 500\n  UP, DOWN, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  action_list = []\n  state = env._current_state\n  target_index = state.world.cookbook.index[primitive]\n\n  # Priority queue for BFS (steps, position, inventory, actions)\n  queue = collections.deque([(0, state.pos, np.copy(state.inventory), [])])\n  visited = set()\n\n  while queue:\n      steps, pos, inv, actions = queue.popleft()\n\n      if steps >= MAX_STEPS:\n          continue\n\n      # Check if the position and inventory have been visited\n      state_key = (tuple(pos), tuple(inv))\n      if state_key in visited:\n          continue\n      visited.add(state_key)\n\n      # Create a new state object for the current BFS step\n      state = craft.CraftState(\n          scenario=state.scenario,\n          grid=np.copy(state.grid),\n          pos=pos,\n          dir=state.dir,\n          inventory=np.copy(inv)\n      )\n\n      # Check if the target primitive is next to the agent\n      if state.next_to(target_index):\n          action_list = actions + [USE]\n          return action_list, steps, action_list\n\n      # Generate possible moves and use of tools\n      new_positions = [\n          (pos[0], pos[1] - 1),  # UP\n          (pos[0], pos[1] + 1),  # DOWN\n          (pos[0] - 1, pos[1]),  # LEFT\n          (pos[0] + 1, pos[1])   # RIGHT\n      ]\n\n      for i, new_pos in enumerate(new_positions):\n          if 0 <= new_pos[0] < state.grid.shape[0] and 0 <= new_pos[1] < state.grid.shape[1]:\n              # Check if the move is valid (not a boundary or non-grabbable entity)\n              cell_index = np.argmax(state.grid[new_pos])\n              if cell_index not in state.world.non_grabbable_indices:\n                  queue.append((steps + 1, new_pos, inv, actions + [i]))\n\n      # Check for tool usage\n      inventory_items = np.where(inv > 0)[0]\n      for item_idx in inventory_items:\n          # Determine the type of tool and its effect (e.g., BRIDGE for WATER)\n          if primitive == 'GOLD' and state.world.cookbook.index.get('BRIDGE') == item_idx:\n              # Check if there's water next to the agent\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['WATER']:\n                          # Use BRIDGE to cross WATER\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the bridge\n                          queue.append((steps + 2, adj_pos, new_inv, actions + [USE]))\n                          break\n\n          elif primitive == 'GEM' and state.world.cookbook.index.get('PICKAXE') == item_idx:\n              # Check if there's a rock next to the agent\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['ROCK']:\n                          # Use PICKAXE to mine the rock\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the pickaxe (assuming it's used up)\n                          queue.append((steps + 2, adj_pos, new_inv, actions + [USE]))\n                          break\n\n          elif primitive == 'IRON' and state.world.cookbook.index.get('HAMMER') == item_idx:\n              # Check if there's an iron ore next to the agent\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['IRON_ORE']:\n                          # Use HAMMER to mine the iron ore\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the hammer (assuming it's used up)\n                          queue.append((steps + 2, adj_pos, new_inv, actions + [USE]))\n                          break\n\n          elif primitive == 'WOOD' and state.world.cookbook.index.get('AXE') == item_idx:\n              # Check if there's a tree next to the agent\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['TREE']:\n                          # Use AXE to chop down the tree\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the axe (assuming it's used up)\n                          queue.append((steps + 2, adj_pos, new_inv, actions + [USE]))\n                          break\n\n  return [], -1, []  # Return empty list and negative reward if target is unreachable", "island_id": 5, "scores": {"3": 0.5}}
