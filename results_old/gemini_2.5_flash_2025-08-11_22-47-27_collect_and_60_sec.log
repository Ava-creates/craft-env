etermine the type of tool and its effect (e.g., BRIDGE for WATER)\n          if primitive == 'GOLD' and state.world.cookbook.index.get('BRIDGE') == item_idx:\n              # Check if there's water next to the agent\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['WATER']:\n                          # Use BRIDGE to cross WATER\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the bridge\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n          elif primitive == 'GEM' and state.world.cookbook.index.get('PICKAXE') == item_idx:\n              # Check if there's rock next to the agent\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['ROCK']:\n                          # Use PICKAXE to mine GEM\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the pickaxe\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n          elif primitive == 'WOOD' and state.world.cookbook.index.get('AXE') == item_idx:\n              # Check if there's tree next to the agent (assuming tree is GRASS for now)\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['GRASS']:\n                          # Use AXE to chop WOOD\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the axe\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n          elif primitive == 'IRON' and state.world.cookbook.index.get('HAMMER') == item_idx:\n              # Check if there's iron ore next to the agent (assuming iron ore is GRASS for now)\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['GRASS']:\n                          # Use HAMMER to mine IRON\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the hammer\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n  return [], -1, []  # Return empty list and negative reward if target is unreachable", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-12T11:36:21.307201", "function_name": "collect", "function_body": "  # Define the actions\n  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  action_list = []\n  reward = 0.0\n  state = env._current_state\n\n  # Get index of the primitive we want to collect\n  primitive_index = state.world.cookbook.index.primitive(primitive)\n\n  # BFS to find the shortest path to the primitive\n  queue = collections.deque([(state, [])])  # (current_state, path)\n  visited_states = set()\n\n  while queue:\n      current_state, path = queue.popleft()\n      pos = current_state.pos\n\n      if tuple(pos) in visited_states:\n          continue\n      visited_states.add(tuple(pos))\n\n      # Check if the primitive is in the immediate vicinity\n      if current_state.next_to(primitive_index):\n          action_list.extend(path)\n          break\n\n      # Generate possible actions (move UP, DOWN, LEFT, RIGHT, USE)\n      for action in [UP, DOWN, LEFT, RIGHT, USE]:\n          next_reward, next_state = env.step(action)\n\n          if tuple(next_state.pos) not in visited_states:\n              queue.append((next_state, path + [action]))\n\n  return state, reward, action_list", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-08-12T11:36:22.279264", "function_name": "collect", "function_body": "  # Helper function to find the shortest path using BFS\n  def bfs_shortest_path(grid, start_pos, target_index):\n      from collections import deque\n      \n      width, height, _ = grid.shape\n      queue = deque([start_pos])\n      visited = set([start_pos])\n      parent = {start_pos: None}\n      \n      while queue:\n          pos = queue.popleft()\n          x, y = pos\n          \n          # Check all 4 possible directions (UP, DOWN, LEFT, RIGHT)\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              \n              if 0 <= nx < width and 0 <= ny < height:\n                  next_pos = (nx, ny)\n                  \n                  # If the target is found, reconstruct the path\n                  if grid[nx, ny, target_index] > 0:\n                      path = []\n                      while pos != start_pos:\n                          path.append(pos)\n                          pos = parent[pos]\n                      path.append(start_pos)\n                      return list(reversed(path))\n                  \n                  # Check if the next position is walkable and not visited\n                  if grid[nx, ny].sum() == 1 and next_pos not in visited:  # Assuming walkable cells have a sum of 1\n                      queue.append(next_pos)\n                      visited.add(next_pos)\n                      parent[next_pos] = pos\n      \n      return None\n\n  action_list = []\n  reward = 0\n  state = env._current_state\n  \n  # Get the index of the primitive to collect\n  primitive_index = state.world.cookbook.index[primitive]\n  \n  # Find the shortest path to the primitive\n  path = bfs_shortest_path(state.grid, state.pos, primitive_index)\n  \n  if not path:\n      raise ValueError(f\"No path found to {primitive} from position {state.pos}.\")\n  \n  # Convert path to actions (UP, DOWN, LEFT, RIGHT)\n  for i in range(1, len(path)):\n      x1, y1 = path[i - 1]\n      x2, y2 = path[i]\n      \n      if x2 > x1:\n          action_list.append(env.action_specs()['RIGHT'])\n      elif x2 < x1:\n          action_list.append(env.action_specs()['LEFT'])\n      elif y2 > y1:\n          action_list.append(env.action_specs()['DOWN'])\n      elif y2 < y1:\n          action_list.append(env.action_specs()['UP'])\n      \n      # Step the environment\n      r, state = env.step(state, action_list[-1])\n      reward += r\n  \n  return state, reward, action_list", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-08-12T11:37:21.698947", "function_name": "collect", "function_body": "  def find_path(start_pos, end_pos):\n    # A simple BFS implementation to find the shortest path on a grid\n    queue = collections.deque([(start_pos, [])])\n    visited = set()\n    \n    while queue:\n        pos, path = queue.popleft()\n        if pos == end_pos:\n            return path\n        \n        x, y = pos\n        neighbors = [(x-1, y), (x+1, y), (x, y-1), (x, y+1)]\n        \n        for nx, ny in neighbors:\n            if 0 <= nx < env.world.WIDTH and 0 <= ny < env.world.HEIGHT and env._current_state.grid[nx, ny] == 0 and (nx, ny) not in visited:\n                queue.append(((nx, ny), path + [(nx, ny)]))\n                visited.add((nx, ny))\n    return []\n\n  def can_cross_water(state):\n    # Check if the agent has a bridge in inventory\n    bridge_index = state.world.index[\"BRIDGE\"]\n    return state.inventory[bridge_index] > 0\n\n  def use_tool(state, tool_name):\n    # Use the tool and update the grid and inventory accordingly\n    tool_index = state.world.index[tool_name]\n    if state.inventory[tool_index] > 0:\n        # Simulate using the tool (this would involve additional logic to actually modify the grid)\n        state.inventory[tool_index] -= 1\n\n  action_list = []\n  reward = 0\n  state = env._current_state\n  \n  primitive_index = state.world.index[primitive]\n  goal_positions = np.argwhere(state.grid[:, :, primitive_index] > 0).tolist()\n  \n  for gx, gy in goal_positions:\n      if can_cross_water(state):\n          # If water is between the agent and the goal, use a bridge\n          water_indices = [(x, y) for x in range(env.world.WIDTH) for y in range(env.world.HEIGHT) \n                           if state.grid[x, y, state.world.water_index] > 0]\n          path_to_water = find_path(state.pos, water_indices[0])\n          action_list.extend(path_to_water)\n          use_tool(state, \"BRIDGE\")\n          \n      path_to_goal = find_path(state.pos, (gx, gy))\n      action_list.extend(path_to_goal)\n\n      # Simulate collecting the primitive\n      state.inventory[primitive_index] += 1\n\n  for a in action_list:\n      r, state = env.step(state, a)\n      reward += r\n  \n  return state, reward, action_list", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-08-12T11:37:22.686368", "function_name": "collect", "function_body": "  # Fetch the current world and scenario\n  world = env.world\n  scenario = env.scenario\n  state = env._current_state\n  \n  # Get the index for the desired primitive\n  target_index = world.cookbook.index[primitive]\n  \n  # Get the initial position and direction of the agent\n  init_pos = state.pos\n  init_dir = state.dir\n  \n  # Define a queue for BFS traversal\n  from collections import deque\n  bfs_queue = deque([(init_pos, init_dir, [])])\n  \n  # Set to keep track of visited states (position and direction)\n  visited = set()\n  visited.add((init_pos, init_dir))\n  \n  # Direction constants for movement actions\n  DIRECTIONS = [(0, 1), (0, -1), (-1, 0), (1, 0)]  # RIGHT, LEFT, UP, DOWN\n  \n  while bfs_queue:\n      current_pos, current_dir, path = bfs_queue.popleft()\n      \n      # Check if the primitive is in the agent's immediate vicinity\n      for dx, dy in DIRECTIONS:\n          neighbor_pos = (current_pos[0] + dx, current_pos[1] + dy)\n          if world.cookbook.index.get(world.grid[neighbor_pos]) == target_index:\n              # Collect the primitive and return the path to it\n              action_list = path + [craft.ACTIONS['USE']]\n              state, reward = env.step(action_list[-1], 1)  # Simulate collecting the primitive\n              return state, reward, action_list\n      \n      # Explore neighboring positions\n      for i, (dx, dy) in enumerate(DIRECTIONS):\n          new_pos = (current_pos[0] + dx, current_pos[1] + dy)\n          \n          # Check if the move is within bounds and not an obstacle\n          if 0 <= new_pos[0] < world.WIDTH and 0 <= new_pos[1] < world.HEIGHT:\n              if world.grid[new_pos][world.stone_index] == 0:  # Assuming stone is an obstacle for simplicity\n                  new_dir = i\n                  if (new_pos, new_dir) not in visited:\n                      visited.add((new_pos, new_dir))\n                      bfs_queue.append((new_pos, new_dir, path + [craft.ACTIONS['DOWN' if new_dir == 0 else 'UP' if new_dir == 1 else 'LEFT' if new_dir == 2 else 'RIGHT']]))\n  \n  # If the primitive is not found or cannot be reached, return an empty action list\n  return state, reward, []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-08-12T11:38:08.268703", "function_name": "collect", "function_body": "  # Get the index for the desired primitive\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Initialize a queue for BFS\n  from collections import deque\n  q = deque([(state.grid.copy(), state.pos, [], reward)])\n\n  # Set to keep track of visited states\n  visited = set()\n  \n  while q:\n      current_grid, current_pos, actions_taken, current_reward = q.popleft()\n\n      if tuple(current_grid.tobytes()) + (current_pos,) in visited:\n          continue\n\n      visited.add(tuple(current_grid.tobytes()) + (current_pos,))\n      \n      # Check the 3x3 neighborhood around the agent\n      for dx in [-1, 0, 1]:\n          for dy in [-1, 0, 1]:\n              nx, ny = current_pos[0] + dx, current_pos[1] + dy\n              \n              if (0 <= nx < env.world.cookbook.n_kinds and \n                  0 <= ny < env.world.cookbook.n_kinds and \n                  current_grid[nx, ny, primitive_index] > 0):\n                  \n                  # Agent is next to the desired primitive\n                  action_list = actions_taken + [4]  # Action 4 represents USE\n                  state, reward = env.step(state, action_list[-1])\n                  return state, reward, action_list\n\n      # Move in all possible directions\n      for move_action in range(4):  # Assuming actions 0-3 are UP, DOWN, LEFT, RIGHT\n          new_pos = current_pos\n          if move_action == 0:  # UP\n              new_pos = (current_pos[0], current_pos[1] - 1)\n          elif move_action == 1:  # DOWN\n              new_pos = (current_pos[0], current_pos[1] + 1)\n          elif move_action == 2:  # LEFT\n              new_pos = (current_pos[0] - 1, current_pos[1])\n          elif move_action == 3:  # RIGHT\n              new_pos = (current_pos[0] + 1, current_pos[1])\n\n          if (0 <= new_pos[0] < env.world.cookbook.n_kinds and \n              0 <= new_pos[1] < env.world.cookbook.n_kinds):\n              \n              # Check if the move is valid\n              if not env.world.cookbook.environment[next_to(new_pos, state.grid)]:\n                  q.append((current_grid.copy(), new_pos, actions_taken + [move_action], current_reward))\n  \n  return state, reward, action_list", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-08-12T11:38:09.265479", "function_name": "collect", "function_body": "  # Get the index of the desired primitive\n  item_index = env.world.cookbook.index(primitive)\n\n  # If the item is already in inventory, return an empty action list\n  if state.inventory[item_index] > 0:\n      return [], 0.0, []\n\n  # BFS to find the shortest path to collect the primitive\n  from collections import deque\n\n  queue = deque([(state, [])])\n  visited = set()\n  \n  while queue:\n      current_state, actions_taken = queue.popleft()\n\n      # Check if we have collected the item\n      if current_state.inventory[item_index] > 0:\n          return actions_taken, 0.0, actions_taken\n\n      # Mark the current state as visited\n      visited.add(tuple(current_state.grid.flatten()) + tuple(current_state.pos) + (current_state.dir,))\n\n      # Try all possible actions\n      for action in range(env.world.n_actions):\n          reward, next_state = current_state.step(action)\n\n          # Skip if the next state has been visited or if it's an invalid move\n          if tuple(next_state.grid.flatten()) + tuple(next_state.pos) + (next_state.dir,) not in visited:\n              queue.append((next_state, actions_taken + [action]))\n  return [], 0.0, []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-08-12T11:40:38.325468", "function_name": "collect", "function_body": "  def use_tool_if_needed(state, pos, inv, actions):\n      tool_mapping = {\n          'GOLD': ('BRIDGE', state.world.cookbook.index['WATER']),\n          'GEM': ('PICKAXE', state.world.cookbook.index['ROCK']),\n          'WOOD': ('AXE', state.world.cookbook.index['GRASS']),\n          'STONE': ('HAMMER', state.world.cookbook.index['GRASS']),  # Assuming stone is GRASS for now\n          'CLAY': ('SHOVEL', state.world.cookbook.index['GRASS'])    # Assuming clay is GRASS for now\n      }\n\n      if primitive in tool_mapping:\n          tool_name, target_index = tool_mapping[primitive]\n          adjacent_cells = [\n              (pos[0], pos[1] - 1),  # UP\n              (pos[0], pos[1] + 1),  # DOWN\n              (pos[0] - 1, pos[1]),  # LEFT\n              (pos[0] + 1, pos[1])   # RIGHT\n          ]\n          for adj_pos in adjacent_cells:\n              if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                  cell_index = np.argmax(state.grid[adj_pos])\n                  if cell_index == target_index:\n                      tool_index = state.world.cookbook.index.get(tool_name)\n                      if inv[tool_index] > 0:\n                          new_inv = inv.copy()\n                          new_inv[tool_index] -= 1  # Consume the tool\n                          actions.append(USE)  # Add USE action to consume the tool\n                          return adj_pos, new_inv, actions\n\n      return pos, inv, actions\n\n  MAX_STEPS = 50\n  UP, DOWN, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  action_list = []\n  state = env._current_state\n  target_index = state.world.cookbook.index[primitive]\n\n  # Priority queue for BFS (position, steps, inventory, actions)\n  queue = collections.deque([(state.pos, 0, np.copy(state.inventory), [])])\n  visited = set()\n\n  while queue:\n      pos, steps, inv, actions = queue.popleft()\n\n      if steps >= MAX_STEPS:\n          continue\n\n      # Check if the position and inventory have been visited\n      state_key = (tuple(pos), tuple(inv))\n      if state_key in visited:\n          continue\n      visited.add(state_key)\n\n      # Create a new state object for the current BFS step\n      state = craft.CraftState(\n          scenario=state.scenario,\n          pos=pos,\n          dir=state.dir,\n          inventory=np.copy(inv)\n      )\n\n      # Check if the target primitive is next to the agent\n      if state.next_to(target_index):\n          action_list = actions + [USE]\n          return action_list, 0, action_list\n\n      # Generate possible moves and use of tools\n      new_positions = [\n          (pos[0], pos[1] - 1),  # UP\n          (pos[0], pos[1] + 1),  # DOWN\n          (pos[0] - 1, pos[1]),  # LEFT\n          (pos[0] + 1, pos[1])   # RIGHT\n      ]\n\n      for i, new_pos in enumerate(new_positions):\n          if 0 <= new_pos[0] < state.grid.shape[0] and 0 <= new_pos[1] < state.grid.shape[1]:\n              cell_index = np.argmax(state.grid[new_pos])\n              if cell_index not in state.world.non_grabbable_indices:\n                  queue.append((new_pos, steps + 1, inv, actions + [i]))\n\n      # Use tool if needed\n      new_pos, new_inv, new_actions = use_tool_if_needed(state, pos, inv, actions)\n      if new_pos != pos:\n          queue.append((new_pos, steps + 2, new_inv, new_actions))\n\n  return [], -1, []  # Return empty list and negative reward if target is unreachable", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-08-12T11:40:39.300611", "function_name": "collect", "function_body": "  MAX_STEPS = 50\n  UP, DOWN, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  action_list = []\n  state = env._current_state\n  target_index = state.world.cookbook.index[primitive]\n\n  # Priority queue for BFS (position, steps, inventory, actions)\n  queue = collections.deque([(state.pos, 0, np.copy(state.inventory), [])])\n  visited = set()\n\n  while queue:\n      pos, steps, inv, actions = queue.popleft()\n\n      if steps >= MAX_STEPS:\n          continue\n\n      # Check if the position and inventory have been visited\n      state_key = (tuple(pos), tuple(inv))\n      if state_key in visited:\n          continue\n      visited.add(state_key)\n\n      # Create a new state object for the current BFS step\n      state = craft.CraftState(\n          scenario=state.scenario,\n          pos=pos,\n          dir=state.dir,\n          inventory=list(inv),\n          grid=np.copy(state.grid)\n      )\n\n      # Check if the target primitive is next to the agent\n      if state.next_to(target_index):\n          action_list = actions + [USE]\n          return action_list, 0, action_list\n\n      # Generate possible moves and use of tools\n      new_positions = [\n          (pos[0], pos[1] - 1),  # UP\n          (pos[0], pos[1] + 1),  # DOWN\n          (pos[0] - 1, pos[1]),  # LEFT\n          (pos[0] + 1, pos[1])   # RIGHT\n      ]\n\n      for i, new_pos in enumerate(new_positions):\n          if 0 <= new_pos[0] < state.grid.shape[0] and 0 <= new_pos[1] < state.grid.shape[1]:\n              # Check if the move is valid (not a boundary or non-grabbable entity)\n              cell_index = np.argmax(state.grid[new_pos])\n              if cell_index not in state.world.non_grabbable_indices:\n                  queue.append((new_pos, steps + 1, inv, actions + [i]))\n\n      # Check for tool usage\n      inventory_items = np.where(inv > 0)[0]\n      for item_idx in inventory_items:\n          # Determine the type of tool and its effect (e.g., BRIDGE for WATER)\n          if primitive == 'GOLD' and state.world.cookbook.index.get('BRIDGE') == item_idx:\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['WATER']:\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the bridge\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n          elif primitive == 'GEM' and state.world.cookbook.index.get('PICKAXE') == item_idx:\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['ROCK']:\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the pickaxe\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n          elif primitive == 'WOOD' and state.world.cookbook.index.get('AXE') == item_idx:\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['TREE']:\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the axe\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n          elif primitive == 'STONE' and state.world.cookbook.index.get('HAMMER') == item_idx:\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['ROCK']:\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the hammer\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n          elif primitive == 'CLAY' and state.world.cookbook.index.get('SHOVEL') == item_idx:\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['CLAY']:\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the shovel\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n  return [], -1, []  # Return empty list and negative reward if target is unreachable", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-12T11:43:31.896371", "function_name": "collect", "function_body": "  MAX_STEPS = 100\n  UP, DOWN, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  action_list = []\n  state = env._current_state\n  target_index = state.world.cookbook.index[primitive]\n\n  # Priority queue for BFS (position, steps, inventory, actions)\n  queue = collections.deque([(state.pos, 0, np.copy(state.inventory), [])])\n  visited = set()\n\n  while queue:\n      pos, steps, inv, actions = queue.popleft()\n\n      if steps >= MAX_STEPS:\n          continue\n\n      # Check if the position and inventory have been visited\n      state_key = (tuple(pos), tuple(inv))\n      if state_key in visited:\n          continue\n      visited.add(state_key)\n\n      # Create a new state object for the current BFS step\n      state = craft.CraftState(\n          scenario=state.scenario,\n          grid=np.copy(state.grid),\n          pos=pos,\n          dir=state.dir,\n          inventory=np.copy(inv)\n      )\n\n      # Check if the target primitive is next to the agent\n      if state.next_to(target_index):\n          action_list = actions + [USE]\n          return action_list, 0, action_list\n\n      # Generate possible moves and use of tools\n      new_positions = [\n          (pos[0], pos[1] - 1),  # UP\n          (pos[0], pos[1] + 1),  # DOWN\n          (pos[0] - 1, pos[1]),  # LEFT\n          (pos[0] + 1, pos[1])   # RIGHT\n      ]\n\n      for i, new_pos in enumerate(new_positions):\n          if 0 <= new_pos[0] < state.grid.shape[0] and 0 <= new_pos[1] < state.grid.shape[1]:\n              cell_index = np.argmax(state.grid[new_pos])\n              if cell_index not in state.world.non_grabbable_indices:\n                  queue.append((new_pos, steps + 1, inv, actions + [i]))\n\n      # Check for tool usage\n      inventory_items = np.where(inv > 0)[0]\n      for item_idx in inventory_items:\n          tool_name = state.world.cookbook.names[item_idx]\n\n          if primitive == 'GOLD':\n 