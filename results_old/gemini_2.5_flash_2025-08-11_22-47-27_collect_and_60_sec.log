{"timestamp": "2025-08-12T16:02:49.791612", "function_name": "collect", "function_body": "  MAX_STEPS = 100\n  UP, DOWN, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  action_list = []\n  state = env._current_state\n  target_index = state.world.cookbook.index[primitive]\n\n  # Priority queue for BFS (position, steps, inventory, actions)\n  queue = collections.deque([(state.pos, 0, np.copy(state.inventory), [])])\n  visited = set()\n\n  while queue:\n      pos, steps, inv, actions = queue.popleft()\n\n      if steps >= MAX_STEPS:\n          continue\n\n      # Check if the position and inventory have been visited\n      state_key = (tuple(pos), tuple(inv))\n      if state_key in visited:\n          continue\n      visited.add(state_key)\n\n      # Create a new state object for the current BFS step\n      state = craft.CraftState(\n          scenario=state.scenario,\n          grid=np.copy(state.grid),\n          pos=pos,\n          dir=state.dir,\n          inventory=np.copy(inv)\n      )\n\n      # Check if the target primitive is next to the agent\n      if state.next_to(target_index):\n          action_list = actions + [USE]\n          return action_list, 0, action_list\n\n      # Generate possible moves and use of tools\n      new_positions = [\n          (pos[0], pos[1] - 1),  # UP\n          (pos[0], pos[1] + 1),  # DOWN\n          (pos[0] - 1, pos[1]),  # LEFT\n          (pos[0] + 1, pos[1])   # RIGHT\n      ]\n\n      for i, new_pos in enumerate(new_positions):\n          if 0 <= new_pos[0] < state.grid.shape[0] and 0 <= new_pos[1] < state.grid.shape[1]:\n              # Check if the move is valid (not a boundary or non-grabbable entity)\n              cell_index = np.argmax(state.grid[new_pos])\n              if cell_index not in state.world.non_grabbable_indices:\n                  queue.append((new_pos, steps + 1, inv, actions + [i]))\n\n      # Check for tool usage\n      inventory_items = np.where(inv > 0)[0]\n      for item_idx in inventory_items:\n          # Determine the type of tool and its effect (e.g., BRIDGE for WATER)\n          if primitive == 'GOLD' and state.world.cookbook.index.get('BRIDGE') == item_idx:\n              # Check if there's water next to the agent\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['WATER']:\n                          # Use BRIDGE to cross WATER\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the bridge\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n          elif primitive == 'GEM' and state.world.cookbook.index.get('PICKAXE') == item_idx:\n              # Check if there's a rock next to the agent\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['ROCK']:\n                          # Use PICKAXE to mine GEM\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the pickaxe\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n          elif primitive == 'WOOD' and state.world.cookbook.index.get('AXE') == item_idx:\n              # Check if there's a tree next to the agent\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['TREE']:\n                          # Use AXE to cut WOOD\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the axe\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n          elif primitive == 'IRON' and state.world.cookbook.index.get('HAMMER') == item_idx:\n              # Check if there's an iron ore next to the agent\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['IRON_ORE']:\n                          # Use HAMMER to mine IRON\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the hammer\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n  return [], -1, []  # Return empty list and negative reward if target is unreachable", "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-08-12T16:03:45.289552", "function_name": "collect", "function_body": "  def find_closest_primitive(grid, pos, target_index):\n    queue = collections.deque([pos])\n    visited = set()\n    directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n    \n    while queue:\n      x, y = queue.popleft()\n      \n      if (x, y) in visited:\n        continue\n      visited.add((x, y))\n      \n      if grid[x, y, target_index] > 0:\n        return x, y\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n          queue.append((nx, ny))\n    \n    return None\n\n  def find_path_to(grid, start_pos, end_pos):\n    queue = collections.deque([(start_pos, [])])\n    visited = set()\n    directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n    action_mapping = {(-1, 0): 1, (1, 0): 0, (0, -1): 2, (0, 1): 3}\n    \n    while queue:\n      (x, y), path = queue.popleft()\n      \n      if (x, y) in visited:\n        continue\n      visited.add((x, y))\n      \n      if (x, y) == end_pos:\n        return path\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n          if grid[nx, ny, env.world.water_index] == 0:  # Avoid water\n            queue.append(((nx, ny), path + [action_mapping[(dx, dy)]]))\n    \n    return None\n\n  action_list = []\n  reward = 0\n  state = env._current_state\n  grid = state.grid\n  pos = state.pos\n  \n  target_index = env.world.cookbook.index(primitive)\n  closest_primitive_pos = find_closest_primitive(grid, pos, target_index)\n  \n  if closest_primitive_pos:\n    path_to_primitive = find_path_to(grid, pos, closest_primitive_pos)\n    action_list.extend(path_to_primitive)\n    \n    for a in action_list:\n      r, state = env.step(a)\n      reward += r\n  \n  return action_list", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-08-12T16:03:46.261945", "function_name": "collect", "function_body": "  # Initialize the search queue and visited set\n  from collections import deque\n  from typing import NamedTuple, Optional\n\n  class Node(NamedTuple):\n      pos: tuple[int, int]\n      dir: int\n      inventory: np.ndarray\n      path: list[int]  # List of actions to reach this node\n\n  start_node = Node(\n      pos=state.pos,\n      dir=state.dir,\n      inventory=np.copy(state.inventory),\n      path=[]\n  )\n  \n  queue = deque([start_node])\n  visited = set()\n\n  # Dictionary mapping primitive names to their indices\n  primitive_index = env.world.cookbook.index[primitive]\n\n  while queue:\n      current_node = queue.popleft()\n      \n      if (current_node.pos, tuple(current_node.inventory)) in visited:\n          continue\n      \n      visited.add((current_node.pos, tuple(current_node.inventory)))\n      \n      # Check if the desired primitive is next to the agent\n      if state.next_to(primitive_index):\n          # If found, append the action to pick up the primitive and return the path\n          pickup_action = 4  # Assuming USE action is index 4 for picking up items\n          current_node.path.append(pickup_action)\n          return current_node.path\n      \n      # Generate possible next actions (move and use if applicable)\n      possible_actions = [0, 1, 2, 3]  # Assuming DOWN, UP, LEFT, RIGHT are indices 0-3\n\n      for action in possible_actions:\n          new_state, _ = state.step(action)\n          \n          new_node = Node(\n              pos=new_state.pos,\n              dir=new_state.dir,\n              inventory=np.copy(new_state.inventory),\n              path=current_node.path + [action]\n          )\n          \n          queue.append(new_node)\n\n  # If no path to the primitive is found, return an empty list or raise an error\n  return []", "island_id": 4, "scores": {"3": -1}}
