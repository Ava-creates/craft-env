cent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['IRON_ORE']:\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n\n          elif primitive == 'BUSH' and item_idx == state.world.cookbook.index['SHEARS']:\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['BUSH']:\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n\n          elif primitive == 'STONE' and item_idx == state.world.cookbook.index['HAMMER']:\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['STONE']:\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n\n          elif primitive == 'IRON' and item_idx == state.world.cookbook.index['DRILL']:\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['IRON']:\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n\n          elif primitive == 'CLOTH' and item_idx == state.world.cookbook.index['LOOM']:\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['WOOL']:\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n\n          elif primitive == 'GLASS' and item_idx == state.world.cookbook.index['FORGE']:\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                