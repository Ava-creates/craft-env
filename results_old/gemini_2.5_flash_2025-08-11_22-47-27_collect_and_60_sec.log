ate(new_positions):\n          if 0 <= new_pos[0] < state.world.grid.shape[0] and 0 <= new_pos[1] < state.world.grid.shape[1]:\n              # Check if the move is valid (not a boundary or non-grabbable entity)\n              cell_index = np.argmax(state.world.grid[new_pos])\n              if cell_index not in state.world.non_grabbable_indices:\n                  queue.append((new_pos, steps + 1, inv, actions + [i]))\n\n      # Check for tool usage\n      inventory_items = np.where(inv > 0)[0]\n      for item_idx in inventory_items:\n          tool_name = state.world.cookbook.name[item_idx]\n\n          if primitive == 'GOLD' and tool_name == 'BRIDGE':\n              # Check if there's water next to the agent\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.world.grid.shape[0] and 0 <= adj_pos[1] < state.world.grid.shape[1]:\n                      cell_index = np.argmax(state.world.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['WATER']:\n                          # Use BRIDGE to cross WATER\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the bridge\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n          elif primitive == 'GEM' and tool_name == 'PICKAXE':\n              # Check if there's rock next to the agent\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.world.grid.shape[0] and 0 <= adj_pos[1] < state.world.grid.shape[1]:\n                      cell_index = np.argmax(state.world.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['ROCK']:\n                          # Use PICKAXE to mine GEM\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the pickaxe\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n          elif primitive == 'WOOD' and tool_name == 'AXE':\n              # Check if there's tree next to the agent (assuming tree is GRASS for now)\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.world.grid.shape[0] and 0 <= adj_pos[1] < state.world.grid.shape[1]:\n                      cell_index = np.argmax(state.world.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['GRASS']:\n                          # Use AXE to chop WOOD\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the axe\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n          elif primitive == 'IRON' and tool_name == 'HAMMER':\n              # Check if there's ore next to the agent (assuming ore is IRON for now)\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.world.grid.shape[0] and 0 <= adj_pos[1] < state.world.grid.shape[1]:\n                      cell_index = np.argmax(state.world.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['IRON']:\n                          # Use HAMMER to mine IRON\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the hammer\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n          elif primitive == 'STONE' and tool_name == 'PICKAXE':\n              # Check if there's stone next to the agent (assuming stone is STONE for now)\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.world.grid.shape[0] and 0 <= adj_pos[1] < state.world.grid.shape[1]:\n                      cell_index = np.argmax(state.world.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['STONE']:\n                          # Use PICKAXE to mine STONE\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the pickaxe\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n  return [], -1, []  # Return empty list and negative reward if target is unreachable", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-08-12T16:13:08.775666", "function_name": "collect", "function_body": "  def get_nearest_primitive_index(primitive_name):\n    # Find the nearest instance of the specified primitive on the grid.\n    world = state.world\n    index = world.cookbook.index\n    primitive_id = index[primitive_name]\n    grid = state.grid\n\n    pos_x, pos_y = state.pos\n    min_distance = float('inf')\n    nearest_pos = None\n\n    for x in range(grid.shape[0]):\n      for y in range(grid.shape[1]):\n        if grid[x, y, primitive_id] > 0:\n          distance = abs(x - pos_x) + abs(y - pos_y)\n          if distance < min_distance:\n            min_distance = distance\n            nearest_pos = (x, y)\n\n    return nearest_pos\n\n  def path_to_position(target_pos):\n    # Compute the shortest path to a target position.\n    from queue import Queue\n\n    grid = state.grid\n    width, height = grid.shape[:2]\n    pos_x, pos_y = state.pos\n    q = Queue()\n    q.put((pos_x, pos_y, []))\n    visited = set()\n    visited.add((pos_x, pos_y))\n\n    while not q.empty():\n      x, y, path = q.get()\n\n      if (x, y) == target_pos:\n        return path\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and grid[nx, ny, world.water_index] == 0 and (nx, ny) not in visited:\n          q.put((nx, ny, path + [(dx, dy)]))\n          visited.add((nx, ny))\n\n    return []\n\n  def move_direction(dx, dy):\n    # Convert direction change to action index.\n    if dx == -1 and dy == 0: return env.action_specs()['LEFT']\n    elif dx == 1 and dy == 0: return env.action_specs()['RIGHT']\n    elif dx == 0 and dy == -1: return env.action_specs()['DOWN']\n    elif dx == 0 and dy == 1: return env.action_specs()['UP']\n\n  def use_tool_if_needed(target_pos):\n    # Check if the agent needs to place a bridge or other tools to reach the target.\n    grid = state.grid\n    width, height = grid.shape[:2]\n    pos_x, pos_y = state.pos\n\n    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n      nx, ny = target_pos[0] + dx, target_pos[1] + dy\n      if 0 <= nx < width and 0 <= ny < height and grid[nx, ny, world.water_index] > 0:\n        bridge_id = state.world.cookbook.index['BRIDGE']\n        if state.inventory[bridge_id] > 0:\n          return env.action_specs()['USE']\n\n    return None\n\n  reward = 0\n  action_list = []\n  while True:\n    nearest_pos = get_nearest_primitive_index(primitive)\n    if not nearest_pos:\n      break\n\n    path = path_to_position(nearest_pos)\n    for dx, dy in path:\n      tool_action = use_tool_if_needed((state.pos[0] + dx, state.pos[1] + dy))\n      if tool_action is not None:\n        action_list.append(tool_action)\n        r, state = env.step(state, tool_action)\n        reward += r\n\n      move_act = move_direction(dx, dy)\n      action_list.append(move_act)\n      r, state = env.step(state, move_act)\n      reward += r\n\n    if nearest_pos == state.pos:\n      # If the agent is at the primitive's position, use it to pick up.\n      action_list.append(env.action_specs()['USE'])\n      r, state = env.step(state, env.action_specs()['USE'])\n      reward += r\n\n  return state, reward, action_list", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-08-12T16:13:09.765761", "function_name": "collect", "function_body": "  # Initialize the action sequence and other necessary variables\n  action_sequence = []\n  current_reward = 0.0\n  current_state = env._current_state\n\n  # Get the index of the target primitive in the environment's cookbook\n  primitive_index = current_state.world.cookbook.index[primitive]\n\n  if primitive_index is None:\n      raise ValueError(f\"Primitive '{primitive}' not found in the cookbook.\")\n\n  # Create a set of non-grabbable indices for quick lookup\n  non_grabbable_indices = current_state.world.non_grabbable_indices\n\n  # Find all positions of the target primitive in the grid\n  target_positions = np.argwhere(current_state.grid[:, :, primitive_index] > 0)\n  if len(target_positions) == 0:\n      raise ValueError(f\"No instances of '{primitive}' found in the environment.\")\n\n  # Define a function to check if a cell is walkable (not occupied by non-grabbable entities or already visited)\n  def is_walkable(x, y, visited):\n      return (x >= 0 and x < current_state.grid.shape[0] and\n              y >= 0 and y < current_state.grid.shape[1] and\n              (current_state.grid[x, y, non_grabbable_indices].sum() == 0) and\n              ((x, y) not in visited))\n\n  # Define a function to perform BFS and find the shortest path to the nearest target position\n  def bfs_shortest_path(start_x, start_y):\n      queue = collections.deque([(start_x, start_y, [])])  # (x, y, path)\n      visited = set()\n      visited.add((start_x, start_y))\n      \n      while queue:\n          x, y, path = queue.popleft()\n          \n          if current_state.grid[x, y, primitive_index] > 0:\n              return path\n          \n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              new_x, new_y = x + dx, y + dy\n              if is_walkable(new_x, new_y, visited):\n                  queue.append((new_x, new_y, path + [env.N_ACTIONS[new_dx_dy(dx, dy)]]))\n                  visited.add((new_x, new_y))\n\n      return None  # No path found\n\n  # Define a helper function to map direction changes to action indices\n  def new_dx_dy(dx, dy):\n      if dx == -1 and dy == 0:\n          return 'LEFT'\n      elif dx == 1 and dy == 0:\n          return 'RIGHT'\n      elif dx == 0 and dy == -1:\n          return 'DOWN'\n      elif dx == 0 and dy == 1:\n          return 'UP'\n\n  # Perform BFS to find the shortest path to each target position\n  for pos in target_positions:\n      start_x, start_y = current_state.pos\n      path_to_target = bfs_shortest_path(start_x, start_y)\n      \n      if path_to_target is not None:\n          action_sequence.extend(path_to_target)\n          # Add the USE action to collect the primitive\n          action_sequence.append(env.N_ACTIONS['USE'])\n          \n          # Execute the actions in the environment\n          for action in action_sequence:\n              reward, current_state = env.step(action)\n              current_reward += reward\n\n  return current_state, current_reward, action_sequence", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-08-12T16:13:56.433029", "function_name": "collect", "function_body": "  action_list = [] \n  reward = 0\n  state = env._current_state\n  # Retrieve the index for the target primitive.\n  primitive_idx = state.world.cookbook.index[primitive]\n\n  # Check if the agent already has the primitive in its inventory.\n  if state.inventory[primitive_idx] > 0:\n      return action_list, reward, state\n\n  # Function to perform BFS to find a path to the nearest instance of the target primitive.\n  def bfs(state):\n      from collections import deque\n      queue = deque([(state.pos, [])])\n      visited = set()\n      \n      while queue:\n          (x, y), actions = queue.popleft()\n\n          if (x, y) in visited:\n              continue\n\n          visited.add((x, y))\n\n          # Check if the current cell contains the target primitive.\n          if state.grid[x, y, primitive_idx] > 0:\n              return actions\n\n          # Define possible moves: down, up, left, right\n          for dx, dy, action in [(-1, 0, env.action_specs()[\"DOWN\"]), (1, 0, env.action_specs()[\"UP\"]),\n                                 (0, -1, env.action_specs()[\"LEFT\"]), (0, 1, env.action_specs()[\"RIGHT\"])]:\n              nx, ny = x + dx, y + dy\n\n              # Ensure the move is within grid bounds.\n              if not (0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]):\n                  continue\n\n              # Check for obstacles (non-grabbable entities).\n              if any(state.grid[nx, ny, idx] > 0 for idx in state.world.non_grabbable_indices):\n                  continue\n\n              queue.append(((nx, ny), actions + [action]))\n\n      return None\n\n  # Perform BFS to find a path to the nearest instance of the target primitive.\n  path = bfs(state)\n  \n  if not path:\n      print(f\"No reachable {primitive} found in the grid.\")\n      return action_list, reward, state\n  \n  # Follow the path and collect the primitive.\n  for action in path:\n      r, state = env.step(action)\n      reward += r\n      action_list.append(action)\n\n  return action_list, reward, state", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-08-12T16:13:57.400040", "function_name": "collect", "function_body": "  # Define possible movements and their corresponding actions\n  MOVEMENTS = {'UP': 0, 'DOWN': 1, 'LEFT': 2, 'RIGHT': 3}\n  \n  # Initialize BFS queue and visited set\n  queue = collections.deque([state])\n  visited = set()\n  parent = {}\n  direction_to_primitive = {}\n\n  # Get the index of the primitive to collect\n  primitive_index = state.world.cookbook.index(primitive)\n\n  while queue:\n      current_state = queue.popleft()\n      \n      if current_state in visited:\n          continue\n      \n      visited.add(current_state)\n      \n      # Check all possible movements (UP, DOWN, LEFT, RIGHT)\n      for move_name, action_id in MOVEMENTS.items():\n          new_state, _ = env.step(action_id)\n          \n          # Check if the new state is valid and not visited\n          if new_state not in visited:\n              queue.append(new_state)\n              parent[new_state] = current_state\n              direction_to_primitive[new_state] = move_name\n\n  # Find a path to a cell containing the primitive\n  target_state = None\n  for state in visited:\n      if state.next_to(primitive_index):\n          target_state = state\n          break\n  \n  # If no such cell is found, return an empty action list\n  if not target_state:\n      return []\n\n  # Backtrack to find the path from initial state to the target state\n  current_state = target_state\n  while current_state != state:\n      action_list.append(MOVEMENTS[direction_to_primitive[current_state]])\n      current_state = parent[current_state]\n\n  # Execute actions and collect rewards\n  final_state = env._current_state\n  for a in action_list:\n      r, final_state = env.step(a)\n      reward += r\n\n  return final_state, reward, action_list", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-08-12T16:16:35.004765", "function_name": "collect", "function_body": "  MAX_STEPS = 100\n  UP, DOWN, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  action_list = []\n  state = env._current_state\n  target_index = state.world.cookbook.index[primitive]\n\n  # Priority queue for BFS (position, steps, inventory, actions)\n  queue = collections.deque([(state.pos, 0, np.copy(state.inventory), [])])\n  visited = set()\n\n  while queue:\n      pos, steps, inv, actions = queue.popleft()\n\n      if steps >= MAX_STEPS:\n          continue\n\n      # Check if the position and inventory have been visited\n      state_key = (tuple(pos), tuple(inv))\n      if state_key in visited:\n          continue\n      visited.add(state_key)\n\n      # Create a new state object for the current BFS step\n      state = craft.CraftState(\n          scenario=state.scenario,\n          grid=np.copy(state.grid),\n          pos=pos,\n          dir=state.dir,\n          inventory=np.copy(inv)\n      )\n\n      # Check if the target primitive is next to the agent\n      adjacent_cells = [\n          (pos[0], pos[1] - 1),  # UP\n          (pos[0], pos[1] + 1),  # DOWN\n          (pos[0] - 1, pos[1]),  # LEFT\n          (pos[0] + 1, pos[1])   # RIGHT\n      ]\n      for adj_pos in adjacent_cells:\n          if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n              cell_index = np.argmax(state.grid[adj_pos])\n              if cell_index == target_index:\n                  action_list = actions + [USE]\n                  return action_list, 0, action_list\n\n      # Generate possible moves\n      for i, new_pos in enumerate(adjacent_cells):\n          if 0 <= new_pos[0] < state.grid.shape[0] and 0 <= new_pos[1] < state.grid.shape[1]:\n              cell_index = np.argmax(state.grid[new_pos])\n              if cell_index not in state.world.non_grabbable_indices:\n                  queue.append((new_pos, steps + 1, inv, actions + [i]))\n\n      # Check for tool usage\n      inventory_items = np.where(inv > 0)[0]\n      for item_idx in inventory_items:\n          tool_name = state.world.cookbook[item_idx]\n          if primitive == 'GOLD' and tool_name == 'BRIDGE':\n              # Check if there's water next to the agent\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['WATER']:\n                          # Use BRIDGE to cross WATER\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the bridge\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n          elif primitive == 'GEM' and tool_name == 'PICKAXE':\n              # Check if there's a rock next to the agent\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['ROCK']:\n                          # Use PICKAXE to mine GEM\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the pickaxe\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n          elif primitive == 'WOOD' and tool_name == 'AXE':\n              # Check if there's a tree next to the agent\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['TREE']:\n                          # Use AXE to cut WOOD\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the axe\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n          elif primitive == 'IRON' and tool_name == 'PICKAXE':\n              # Check if there's ore next to the agent\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['ORE']:\n                          # Use PICKAXE to mine IRON\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the pickaxe\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n          elif primitive == 'SHEEP' and tool_name == 'SPEAR':\n              # Check if there's a sheep next to the agent\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['SHEEP']:\n                          # Use SPEAR to hunt SHEEP\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the spear\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n          elif primitive == 'STONE' and tool_name == 'PICKAXE':\n              # Check if there's a stone next to the agent\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['STONE']:\n                          # Use PICKAXE to mine STONE\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the pickaxe\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n  return [], -1, []  # Return empty list and negative reward if target is unreachable", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-08-12T16:16:36.052291", "function_name": "collect", "function_body": "  MAX_STEPS = 50\n  UP, DOWN, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  action_list = []\n  state = env._current_state\n  target_index = state.world.cookbook.index[primitive]\n\n  # Priority queue for BFS (position, steps, inventory, actions)\n  queue = collections.deque([(state.pos, 0, np.copy(state.inventory), [])])\n  visited = set()\n\n  while queue:\n      pos, steps, inv, actions = queue.popleft()\n\n      if steps >= MAX_STEPS:\n          continue\n\n      # Check if the position and inventory have been visited\n      state_key = (tuple(pos), tuple(inv))\n      if state_key in visited:\n          continue\n      visited.add(state_key)\n\n      # Create a new state object for the current BFS step\n      state = craft.CraftState(\n          scenario=state.scenario,\n          grid=np.copy(state.grid),\n          pos=pos,\n          dir=state.dir,\n          inventory=np.copy(inv)\n      )\n\n      # Check if the target primitive is next to the agent\n      adjacent_cells = [\n          (pos[0], pos[1] - 1),  # UP\n          (pos[0], pos[1] + 1),  # DOWN\n          (pos[0] - 1, pos[1]),  # LEFT\n          (pos[0] + 1, pos[1])   # RIGHT\n      ]\n      for adj_pos in adjacent_cells:\n          if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n              cell_index = np.argmax(state.grid[adj_pos])\n              if cell_index == target_index:\n                  action_list = actions + [USE]\n                  return action_list, steps + 1, action_list\n\n      # Generate possible moves\n      for i, new_pos in enumerate(adjacent_cells):\n          if 0 <= new_pos[0] < state.grid.shape[0] and 0 <= new_pos[1] < state.grid.shape[1]:\n              cell_index = np.argmax(state.grid[new_pos])\n              if cell_index not in state.world.non_grabbable_indices:\n                  queue.append((new_pos, steps + 1, inv, actions + [i]))\n\n      # Check for tool usage\n      inventory_items = np.where(inv > 0)[0]\n      for item_idx in inventory_items:\n          tool_effect = {\n              'BRIDGE': state.world.cookbook.index['WATER'],\n              'PICKAXE': state.world.cookbook.index['ROCK'],\n              'AXE': state.world.cookbook.index['TREE'],\n              'SPEAR': state.world.cookbook.index['SHEEP'],\n          }\n          if primitive in tool_effect and item_idx == state.world.cookbook.index[tool_effect[primitive]]:\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == tool_effect[primitive]:\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n  return [], -1, []  # Return empty list and negative reward if target is unreachable", "island_id": 9, "scores": {"3": 0.5}}
