{"timestamp": "2025-08-12T14:21:56.284067", "function_name": "collect", "function_body": "  # Extract the current state and necessary world information\n  state = env._current_state\n  world = state.world\n  cookbook = world.cookbook\n  index = cookbook.index\n  grid = state.grid\n  pos = state.pos\n  \n  # Get the index for the target primitive\n  i_primitive = index(primitive)\n  \n  # Check if the primitive is already in the inventory\n  if state.inventory[i_primitive] > 0:\n      return [], reward, state\n\n  # Use A* search to find a path to the closest instance of the primitive\n  start_pos = pos\n  goal_pos = None\n  \n  # Function to get neighbors (valid moves)\n  def get_neighbors(pos):\n      x, y = pos\n      neighbors = [(x-1, y), (x+1, y), (x, y-1), (x, y+1)]\n      valid_moves = []\n      \n      for nx, ny in neighbors:\n          if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n              # Check if the cell is walkable\n              if not state.next_to(world.non_grabbable_indices):\n                  valid_moves.append((nx, ny))\n              \n              # Check if the cell contains a bridge or other necessary tool to cross water\n              if world.water_index in grid[nx, ny] and any(tool in state.inventory for tool in [world.bridge_index]):\n                  valid_moves.append((nx, ny))\n\n      return valid_moves\n\n  # A* search function\n  def astar(start, goal):\n      open_set = []\n      heapq.heappush(open_set, (0, start))\n      came_from = {}\n      g_score = {start: 0}\n      f_score = {start: heuristic(start, goal)}\n      \n      while open_set:\n          _, current = heapq.heappop(open_set)\n          \n          if current == goal:\n              path = []\n              while current in came_from:\n                  path.append(current)\n                  current = came_from[current]\n              return path[::-1]\n          \n          for neighbor in get_neighbors(current):\n              tentative_g_score = g_score[current] + 1\n              \n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                  heapq.heappush(open_set, (f_score[neighbor], neighbor))\n      \n      return None\n\n  # Heuristic function (Manhattan distance)\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  # Find the closest instance of the primitive\n  for x in range(grid.shape[0]):\n      for y in range(grid.shape[1]):\n          if grid[x, y, i_primitive] > 0:\n              goal_pos = (x, y)\n              break\n      if goal_pos:\n          break\n\n  if not goal_pos:\n      return [], reward, state\n\n  # Find a path to the primitive using A*\n  path = astar(start_pos, goal_pos)\n  \n  # Convert path to actions\n  for i in range(len(path) - 1):\n      current = path[i]\n      next_ = path[i+1]\n      \n      dx, dy = next_[0] - current[0], next_[1] - current[1]\n      \n      if (dx, dy) == (-1, 0):\n          action_list.append(env.action_specs()['LEFT'])\n      elif (dx, dy) == (1, 0):\n          action_list.append(env.action_specs()['RIGHT'])\n      elif (dx, dy) == (0, -1):\n          action_list.append(env.action_specs()['UP'])\n      elif (dx, dy) == (0, 1):\n          action_list.append(env.action_specs()['DOWN'])\n\n  # Add USE action to pick up the primitive\n  if path:\n      action_list.append(env.action_specs()['USE'])\n\n  return state, reward, action_list", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-08-12T14:21:57.252873", "function_name": "collect", "function_body": "  # Initialize the list to store actions\n  action_list = []\n  \n  # Define direction constants for movement\n  DIRECTIONS = {\"UP\": 1, \"DOWN\": 0, \"LEFT\": 2, \"RIGHT\": 3}\n  \n  # Get the index of the primitive from the world's cookbook\n  primitive_index = env.world.cookbook.index.index(primitive)\n  \n  if primitive_index is None:\n      raise ValueError(f\"Primitive {primitive} not found in the cookbook.\")\n  \n  def move_to_position(x, y):\n      nonlocal state\n      while state.pos[0] != x or state.pos[1] != y:\n          # Determine the direction to move\n          dx = x - state.pos[0]\n          dy = y - state.pos[1]\n          \n          if dx > 0:\n              action_list.append(DIRECTIONS[\"RIGHT\"])\n              r, state = env.step(action_list[-1])\n              reward += r\n          elif dx < 0:\n              action_list.append(DIRECTIONS[\"LEFT\"])\n              r, state = env.step(action_list[-1])\n              reward += r\n          \n          if dy > 0:\n              action_list.append(DIRECTIONS[\"DOWN\"])\n              r, state = env.step(action_list[-1])\n              reward += r\n          elif dy < 0:\n              action_list.append(DIRECTIONS[\"UP\"])\n              r, state = env.step(action_list[-1])\n              reward += r\n  \n  # Get the current state and grid\n  state = env._current_state\n  grid = state.grid\n  \n  # Find all positions of the primitive in the grid\n  positions = np.argwhere(grid[:, :, primitive_index] > 0)\n  \n  if len(positions) == 0:\n      raise ValueError(f\"No {primitive} found in the grid.\")\n  \n  for pos in positions:\n      x, y = pos\n      move_to_position(x, y)\n      \n      # Use action to collect the primitive\n      action_list.append(4)  # Assuming USE is mapped to index 4\n      r, state = env.step(action_list[-1])\n      reward += r\n  \n  return state, reward, action_list", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-08-12T14:24:16.748496", "function_name": "collect", "function_body": "  UP = (-1, 0)\n  DOWN = (1, 0)\n  LEFT = (0, -1)\n  RIGHT = (0, 1)\n\n  def is_valid(pos):\n      return 0 <= pos[0] < env.grid.shape[0] and 0 <= pos[1] < env.grid.shape[1]\n\n  def get_adjacent_cells(pos):\n      return [(pos[0] + d[0], pos[1] + d[1]) for d in [UP, DOWN, LEFT, RIGHT]]\n\n  def can_use_tool(tool_index, target_cell):\n      if tool_index is None:\n          return False\n      cell_type = env.world.cookbook.index.get(target_cell)\n      return cell_type and (cell_type == 'BRIDGE' or \n                            cell_type == 'PICKAXE' or \n                            cell_type == 'AXE' or \n                            cell_type == 'SHEARS' or \n                            cell_type == 'NET' or \n                            cell_type == 'HOE' or \n                            cell_type == 'SWORD' or \n                            cell_type == 'SHOVEL')\n\n  def get_tool_usage_conditions(primitive, target_cell):\n      conditions = {\n          'GOLD': {'tool': 'BRIDGE', 'target': 'WATER'},\n          'GEM': {'tool': 'PICKAXE', 'target': 'ROCK'},\n          'WOOD': {'tool': 'AXE', 'target': 'TREE'},\n          'LEAF': {'tool': 'SHEARS', 'target': 'LEAVES'},\n          'FISH': {'tool': 'NET', 'target': 'WATER'},\n          'CROP': {'tool': 'HOE', 'target': 'DIRT'},\n          'ANIMAL': {'tool': 'SWORD', 'target': 'ANIMAL'},\n          'DIRT': {'tool': 'SHOVEL', 'target': 'DIRT'}\n      }\n      return conditions.get(primitive, {}).get('tool'), conditions.get(primitive, {}).get('target')\n\n  def get_tool_index(tool_name):\n      if tool_name in env.world.cookbook.index:\n          return env.world.cookbook.index[tool_name]\n      return None\n\n  target_cell = primitive\n  inventory_items = np.where(env.grid[pos] > 0)[0]\n\n  for item_idx in inventory_items:\n      tool_name, target_type = get_tool_usage_conditions(primitive, target_cell)\n      if can_use_tool(get_tool_index(tool_name), target_type):\n          adjacent_cells = get_adjacent_cells(pos)\n          for adj_pos in adjacent_cells:\n              if is_valid(adj_pos) and env.world.cookbook.index.get(env.grid[adj_pos]) == target_type:\n                  return [get_action_for_direction(pos, adj_pos)] + [USE_TOOL_ACTION]\n  else:\n      # No tool available or no adjacent cell with the required primitive\n      for direction in [UP, DOWN, LEFT, RIGHT]:\n          next_pos = (pos[0] + direction[0], pos[1] + direction[1])\n          if is_valid(next_pos) and env.world.cookbook.index.get(env.grid[next_pos]) == target_cell:\n              return [get_action_for_direction(pos, next_pos)]\n\n  # If none of the above conditions are met, try to move towards a cell that can be used with a tool\n  for direction in [UP, DOWN, LEFT, RIGHT]:\n      next_pos = (pos[0] + direction[0], pos[1] + direction[1])\n      if is_valid(next_pos) and env.world.cookbook.index.get(env.grid[next_pos]) == target_type:\n          return [get_action_for_direction(pos, next_pos)]\n\n  # If all else fails, just move randomly\n  return [random.choice([UP, DOWN, LEFT, RIGHT])]", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-08-12T14:24:17.756348", "function_name": "collect", "function_body": "  UP = (0, -1)\n  DOWN = (0, 1)\n  LEFT = (-1, 0)\n  RIGHT = (1, 0)\n\n  DIRECTIONS = [UP, DOWN, LEFT, RIGHT]\n\n  def add_tuple(a, b):\n    return tuple(x + y for x, y in zip(a, b))\n\n  def is_valid(pos, grid_width, grid_height):\n    return 0 <= pos[0] < grid_width and 0 <= pos[1] < grid_height\n\n  def bfs(start_pos, target_index, grid_width, grid_height, inv, world_cookbook):\n      queue = collections.deque([(start_pos, [], inv.copy())])\n      visited = set()\n      \n      while queue:\n          current_pos, path, current_inv = queue.popleft()\n          \n          if current_pos in visited:\n              continue\n          visited.add(current_pos)\n          \n          # Check if we are at a target position\n          if world_cookbook[grid[current_pos[0]][current_pos[1]]] == target_index:\n              return path + [USE]\n          \n          for direction in DIRECTIONS:\n              new_pos = add_tuple(current_pos, direction)\n              if is_valid(new_pos, grid_width, grid_height) and grid[new_pos[0]][new_pos[1]] not in non_grabbable_indices:\n                  queue.append((new_pos, path + [direction], current_inv))\n          \n          # Check for tool usage\n          inventory_items = np.where(current_inv > 0)[0]\n          for item_idx in inventory_items:\n              if world_cookbook.get('BRIDGE') == item_idx and target_index == world_cookbook['GOLD']:\n                  adjacent_cells = [add_tuple(current_pos, direction) for direction in DIRECTIONS]\n                  for adj_pos in adjacent_cells:\n                      if is_valid(adj_pos, grid_width, grid_height) and grid[adj_pos[0]][adj_pos[1]] == world_cookbook['WATER']:\n                          new_inv = current_inv.copy()\n                          new_inv[item_idx] -= 1\n                          queue.append((adj_pos, path + [USE], new_inv))\n              \n              if world_cookbook.get('PICKAXE') == item_idx and target_index == world_cookbook['GEM']:\n                  adjacent_cells = [add_tuple(current_pos, direction) for direction in DIRECTIONS]\n                  for adj_pos in adjacent_cells:\n                      if is_valid(adj_pos, grid_width, grid_height) and grid[adj_pos[0]][adj_pos[1]] == world_cookbook['ROCK']:\n                          new_inv = current_inv.copy()\n                          new_inv[item_idx] -= 1\n                          queue.append((adj_pos, path + [USE], new_inv))\n              \n              if world_cookbook.get('AXE') == item_idx and target_index == world_cookbook['WOOD']:\n                  adjacent_cells = [add_tuple(current_pos, direction) for direction in DIRECTIONS]\n                  for adj_pos in adjacent_cells:\n                      if is_valid(adj_pos, grid_width, grid_height) and grid[adj_pos[0]][adj_pos[1]] == world_cookbook['TREE']:\n                          new_inv = current_inv.copy()\n                          new_inv[item_idx] -= 1\n                          queue.append((adj_pos, path + [USE], new_inv))\n              \n              if world_cookbook.get('SHEARS') == item_idx and target_index == world_cookbook['LEAF']:\n                  adjacent_cells = [add_tuple(current_pos, direction) for direction in DIRECTIONS]\n                  for adj_pos in adjacent_cells:\n                      if is_valid(adj_pos, grid_width, grid_height) and grid[adj_pos[0]][adj_pos[1]] == world_cookbook['LEAVES']:\n                          new_inv = current_inv.copy()\n                          new_inv[item_idx] -= 1\n                          queue.append((adj_pos, path + [USE], new_inv))\n              \n              if world_cookbook.get('NET') == item_idx and target_index == world_cookbook['FISH']:\n                  adjacent_cells = [add_tuple(current_pos, direction) for direction in DIRECTIONS]\n                  for adj_pos in adjacent_cells:\n                      if is_valid(adj_pos, grid_width, grid_height) and grid[adj_pos[0]][adj_pos[1]] == world_cookbook['WATER']:\n                          new_inv = current_inv.copy()\n                          new_inv[item_idx] -= 1\n                          queue.append((adj_pos, path + [USE], new_inv))\n              \n              if world_cookbook.get('HOE') == item_idx and target_index == world_cookbook['CROP']:\n                  adjacent_cells = [add_tuple(current_pos, direction) for direction in DIRECTIONS]\n                  for adj_pos in adjacent_cells:\n                      if is_valid(adj_pos, grid_width, grid_height) and grid[adj_pos[0]][adj_pos[1]] == world_cookbook['DIRT']:\n                          new_inv = current_inv.copy()\n                          new_inv[item_idx] -= 1\n                          queue.append((adj_pos, path + [USE], new_inv))\n              \n              if world_cookbook.get('SWORD') == item_idx and target_index == world_cookbook['ANIMAL']:\n                  adjacent_cells = [add_tuple(current_pos, direction) for direction in DIRECTIONS]\n                  for adj_pos in adjacent_cells:\n                      if is_valid(adj_pos, grid_width, grid_height) and grid[adj_pos[0]][adj_pos[1]] == world_cookbook['ANIMAL']:\n                          new_inv = current_inv.copy()\n                          new_inv[item_idx] -= 1\n                          queue.append((adj_pos, path + [USE], new_inv))\n              \n              if world_cookbook.get('SHOVEL') == item_idx and target_index == world_cookbook['DIRT']:\n                  adjacent_cells = [add_tuple(current_pos, direction) for direction in DIRECTIONS]\n                  for adj_pos in adjacent_cells:\n                      if is_valid(adj_pos, grid_width, grid_height) and grid[adj_pos[0]][adj_pos[1]] == world_cookbook['DIRT']:\n                          new_inv = current_inv.copy()\n                          new_inv[item_idx] -= 1\n                          queue.append((adj_pos, path + [USE], new_inv))\n      \n      return None\n\n  grid = env.grid\n  grid_width = len(grid)\n  grid_height = len(grid[0])\n  \n  start_pos = tuple(env.agent_pos)\n  \n  target_index = env.world_cookbook.get(primitive)\n  if not target_index:\n      return [], -1, []\n  \n  non_grabbable_indices = set([env.world_cookbook[x] for x in ['WATER', 'AIR']])\n\n  path = bfs(start_pos, target_index, grid_width, grid_height, env.inv, env.world_cookbook)\n\n  if not path:\n      return [], -1, []\n\n  action_mapping = {\n      UP: 0,\n      DOWN: 1,\n      LEFT: 2,\n      RIGHT: 3,\n      USE: 4\n  }\n\n  actions = [action_mapping[action] for action in path]\n\n  return actions, 1, actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-08-12T14:25:21.317594", "function_name": "collect", "function_body": "  UP, DOWN, LEFT, RIGHT, USE = range(5)\n\n  # Get the index of the primitive to collect\n  cookbook = env.world.cookbook\n  primitive_index = cookbook.index[primitive]\n\n  action_list = []\n  reward = 0.0\n  state = env._current_state\n\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x-1, y), (x+1, y), (x, y-1), (x, y+1)]\n\n  # Function to determine if a cell is traversable based on the agent's inventory\n  def can_traverse(state, cell_pos):\n      cell_kind_index = state.grid[cell_pos[0], cell_pos[1]].argmax()\n      if cell_kind_index == cookbook.water_index:\n          return 'BRIDGE' in env.world.cookbook.get(primitive_index) and state.inventory[cookbook.index['BRIDGE']] > 0\n      elif cell_kind_index == cookbook.stone_index:\n          return 'PICKAXE' in env.world.cookbook.get(primitive_index) and state.inventory[cookbook.index['PICKAXE']] > 0\n      else:\n          return True\n\n  # BFS to find the shortest path to the primitive, considering inventory constraints\n  queue = collections.deque([(state.pos, [])])\n  visited = set([state.pos])\n\n  while queue:\n      current_pos, path = queue.popleft()\n\n      if state.next_to(primitive_index):\n          action_list.extend(path)\n          break\n\n      for neighbor in get_neighbors(current_pos):\n          nx, ny = neighbor\n          if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n              if neighbor not in visited and can_traverse(state, neighbor):\n                  dx, dy = nx - current_pos[0], ny - current_pos[1]\n                  direction = RIGHT if dx > 0 else\\\n                              LEFT if dx < 0 else\\\n                              DOWN if dy > 0 else\\\n                              UP\n                  new_path = path + [direction]\n                  queue.append((neighbor, new_path))\n                  visited.add(neighbor)\n\n  # Execute the actions to collect the primitive\n  for a in action_list:\n      r, done, _ = env.step(a)\n      reward += r\n\n  return state, reward, action_list", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-08-12T14:25:22.300647", "function_name": "collect", "function_body": "  # Get the index of the primitive to collect\n  cookbook = env.world.cookbook\n  primitive_index = cookbook.index[primitive]\n\n  action_list = []\n  reward = 0.0\n  state = env._current_state\n\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x-1, y), (x+1, y), (x, y-1), (x, y+1)]\n\n  # Function to determine if a cell is passable\n  def is_passable(cell):\n      kind_index = np.argmax(cell)\n      if kind_index in state.world.grabbable_indices:\n          return True\n      elif kind_index == state.world.water_index and 'BRIDGE' in state.inventory:\n          return True\n      elif kind_index == state.world.stone_index and 'PICKAXE' in state.inventory:\n          return True\n      else:\n          return False\n\n  # BFS to find the shortest path to the primitive, considering passability\n  queue = collections.deque([(state.pos, [])])\n  visited = set([state.pos])\n\n  while queue:\n      current_pos, path = queue.popleft()\n\n      if state.next_to(primitive_index):\n          action_list.extend(path)\n          break\n\n      for neighbor in get_neighbors(current_pos):\n          nx, ny = neighbor\n          if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n              if neighbor not in visited:\n                  dx, dy = nx - current_pos[0], ny - current_pos[1]\n                  direction = RIGHT if dx > 0 else\\\n                              LEFT if dx < 0 else\\\n                              DOWN if dy > 0 else\\\n                              UP\n                  new_path = path + [direction]\n                  if is_passable(state.grid[nx, ny]):\n                      queue.append((neighbor, new_path))\n                      visited.add(neighbor)\n\n  # Execute the actions to collect the primitive\n  for a in action_list:\n      r, done, _ = env.step(a)\n      reward += r\n\n  return state, reward, action_list", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-08-12T14:26:24.123678", "function_name": "collect", "function_body": "  def find_nearest_primitive(state, primitive):\n    # Use the cookbook to get the index of the primitive\n    primitive_index = state.world.cookbook.index[primitive]\n    \n    # Find all positions of this primitive in the grid\n    positions = np.argwhere(state.grid[:, :, primitive_index] > 0)\n    \n    min_dist = float('inf')\n    nearest_pos = None\n    \n    for pos in positions:\n      dist = abs(pos[0] - state.pos[0]) + abs(pos[1] - state.pos[1])\n      if dist < min_dist:\n        min_dist = dist\n        nearest_pos = (pos[0], pos[1])\n    \n    return nearest_pos\n\n  def path_to(state, target_pos):\n    # Implement a simple BFS to find the shortest path from state.pos to target_pos\n    queue = collections.deque([(state.pos, [])])\n    visited = set()\n    \n    while queue:\n      current_pos, path = queue.popleft()\n      \n      if current_pos == target_pos:\n        return path\n      \n      x, y = current_pos\n      \n      # Possible moves: UP, DOWN, LEFT, RIGHT\n      for dx, dy, action in [(-1, 0, env.action_specs()['UP']), (1, 0, env.action_specs()['DOWN']),\n                             (0, -1, env.action_specs()['LEFT']), (0, 1, env.action_specs()['RIGHT'])]:\n        new_pos = (x + dx, y + dy)\n        \n        if (0 <= new_pos[0] < state.grid.shape[0] and 0 <= new_pos[1] < state.grid.shape[1] and\n            new_pos not in visited and not state.world.cookbook.index.get(state.grid[new_pos][state.dir]) == 'BOUNDARY'):\n          visited.add(new_pos)\n          queue.append((new_pos, path + [action]))\n    \n    return []  # No path found\n\n  action_list = []\n  reward = 0\n  state = env._current_state\n\n  nearest_primitive_pos = find_nearest_primitive(state, primitive)\n  \n  if nearest_primitive_pos:\n    path_actions = path_to(state, nearest_primitive_pos)\n    action_list.extend(path_actions)\n\n    # Assuming the target primitive is directly next to us after moving.\n    action_list.append(env.action_specs()['USE'])\n\n  for a in action_list:\n      r, state = env.step(a)\n      reward += r\n\n  return state, reward, action_list", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-08-12T14:26:25.106406", "function_name": "collect", "function_body": "  def find_nearest_primitive(state, primitive):\n    grid = state.grid\n    n_kinds = state.world.cookbook.n_kinds\n    kind_index = state.world.cookbook.index[primitive]\n    min_dist = float('inf')\n    nearest_pos = None\n\n    for y in range(grid.shape[0]):\n      for x in range(grid.shape[1]):\n        if grid[y, x, kind_index] > 0:\n          dist = abs(y - state.pos[0]) + abs(x - state.pos[1])\n          if dist < min_dist:\n            min_dist = dist\n            nearest_pos = (y, x)\n\n    return nearest_pos\n\n  def path_to(state, target_pos):\n    from queue import Queue\n    \n    grid = state.grid\n    n_kinds = state.world.cookbook.n_kinds\n    directions = [(1, 0), (-1, 0), (0, 1), (0, -1)]\n    width, height = grid.shape[0], grid.shape[1]\n    \n    start_pos = state.pos\n    queue = Queue()\n    queue.put((start_pos, []))\n    visited = set([start_pos])\n    \n    while not queue.empty():\n      pos, path = queue.get()\n      \n      if pos == target_pos:\n        return path\n      \n      for dy, dx in directions:\n        new_y, new_x = pos[0] + dy, pos[1] + dx\n        if 0 <= new_y < width and 0 <= new_x < height:\n          if grid[new_y, new_x].sum() == 0 or (new_y, new_x) in visited:  # Assuming empty cell or visited\n            continue\n            \n          new_path = path + [env.action_specs()[env.MOVE_FUNC(dy, dx)]]\n          queue.put(((new_y, new_x), new_path))\n          visited.add((new_y, new_x))\n    \n    return []  # No path found\n\n  action_list = []\n  reward = 0\n  state = env._current_state\n\n  nearest_primitive_pos = find_nearest_primitive(state, primitive)\n  if nearest_primitive_pos:\n    path_actions = path_to(state, nearest_primitive_pos)\n    action_list.extend(path_actions)\n\n    # Assuming the target primitive is directly next to us after moving.\n    action_list.append(env.action_specs()[env.USE])\n\n  for a in action_list:\n      r, state = env.step(a)\n      reward += r\n\n  return state, reward, action_list", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-08-12T14:28:10.268067", "function_name": "collect", "function_body": "  MAX_STEPS = 50\n  UP, DOWN, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  action_list = []\n  state = env._current_state\n  target_index = state.world.cookbook.index[primitive]\n\n  # Priority queue for BFS (position, steps, inventory, actions)\n  queue = collections.deque([(state.pos, 0, np.copy(state.inventory), [])])\n  visited = set()\n\n  while queue:\n      pos, steps, inv, actions = queue.popleft()\n\n      if steps >= MAX_STEPS:\n          continue\n\n      # Check if the position and inventory have been visited\n      state_key = (tuple(pos), tuple(inv))\n      if state_key in visited:\n          continue\n      visited.add(state_key)\n\n      # Create a new state object for the current BFS step\n      state = craft.CraftState(\n          scenario=state.scenario,\n          grid=np.copy(state.grid),\n          pos=pos,\n          dir=state.dir,\n          inventory=np.copy(inv)\n      )\n\n      # Check if the target primitive is next to the agent\n      if state.next_to(target_index):\n          action_list = actions + [USE]\n          return action_list, 0, action_list\n\n      # Generate possible moves and use of tools\n      new_positions = [\n          (pos[0], pos[1] - 1),  # UP\n          (pos[0], pos[1] + 1),  # DOWN\n          (pos[0] - 1, pos[1]),  # LEFT\n          (pos[0] + 1, pos[1])   # RIGHT\n      ]\n\n      for i, new_pos in enumerate(new_positions):\n          if 0 <= new_pos[0] < state.grid.shape[0] and 0 <= new_pos[1] < state.grid.shape[1]:\n              # Check if the move is valid (not a boundary or non-grabbable entity)\n              cell_index = np.argmax(state.grid[new_pos])\n              if cell_index not in state.world.non_grabbable_indices:\n                  queue.append((new_pos, steps + 1, inv, actions + [i]))\n\n      # Define tool usage functions\n      def use_tool(state, target, tool, resource):\n          inventory_items = np.where(state.inventory > 0)[0]\n          for item_idx in inventory_items:\n              if state.world.cookbook.index.get(tool) == item_idx:\n                  adjacent_cells = [\n                      (state.pos[0], state.pos[1] - 1),  # UP\n                      (state.pos[0], state.pos[1] + 1),  # DOWN\n                      (state.pos[0] - 1, state.pos[1]),  # LEFT\n                      (state.pos[0] + 1, state.pos[1])   # RIGHT\n                  ]\n                  for adj_pos in adjacent_cells:\n                      if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                          cell_index = np.argmax(state.grid[adj_pos])\n                          if cell_index == state.world.cookbook.index[resource]:\n                              new_inv = state.inventory.copy()\n                              new_inv[item_idx] -= 1  # Consume the tool\n                              queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                              break\n\n      # Check for BRIDGE usage for WATER\n      if primitive == 'GOLD':\n          use_tool(state, target_index, 'BRIDGE', 'WATER')\n\n      # Check for PICKAXE usage for GEM\n      if primitive == 'GEM':\n          use_tool(state, target_index, 'PICKAXE', 'ROCK')\n\n      # Check for AXE usage for WOOD\n      if primitive == 'WOOD':\n          use_tool(state, target_index, 'AXE', 'TREE')\n\n  return [], -1, []  # Return empty list and negative reward if target is unreachable", "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-08-12T14:28:11.255884", "function_name": "collect", "function_body": "  MAX_STEPS = 50\n  UP, DOWN, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  action_list = []\n  state = env._current_state\n  target_index = state.world.cookbook.index[primitive]\n\n  # Priority queue for BFS (position, steps, inventory, actions)\n  queue = collections.deque([(state.pos, 0, np.copy(state.inventory), [])])\n  visited = set()\n\n  while queue:\n      pos, steps, inv, actions = queue.popleft()\n\n      if steps >= MAX_STEPS:\n          continue\n\n      # Check if the position and inventory have been visited\n      state_key = (tuple(pos), tuple(inv))\n      if state_key in visited:\n          continue\n      visited.add(state_key)\n\n      # Create a new state object for the current BFS step\n      state = craft.CraftState(\n          scenario=state.scenario,\n          grid=np.copy(state.grid),\n          pos=pos,\n          dir=state.dir,\n          inventory=np.copy(inv)\n      )\n\n      # Check if the target primitive is next to the agent\n      if state.next_to(target_index):\n          action_list = actions + [USE]\n          return action_list, 0, action_list\n\n      # Generate possible moves and use of tools\n      new_positions = [\n          (pos[0], pos[1] - 1),  # UP\n          (pos[0], pos[1] + 1),  # DOWN\n          (pos[0] - 1, pos[1]),  # LEFT\n          (pos[0] + 1, pos[1])   # RIGHT\n      ]\n\n      for i, new_pos in enumerate(new_positions):\n          if 0 <= new_pos[0] < state.grid.shape[0] and 0 <= new_pos[1] < state.grid.shape[1]:\n              # Check if the move is valid (not a boundary or non-grabbable entity)\n              cell_index = np.argmax(state.grid[new_pos])\n              if cell_index not in state.world.non_grabbable_indices:\n                  queue.append((new_pos, steps + 1, inv, actions + [i]))\n\n      # Define tool usage function\n      def use_tool(target, tool, resource):\n          inventory_items = np.where(inv > 0)[0]\n          for item_idx in inventory_items:\n              if state.world.cookbook.index.get(tool) == item_idx:\n                  adjacent_cells = [\n                      (pos[0], pos[1] - 1),  # UP\n                      (pos[0], pos[1] + 1),  # DOWN\n                      (pos[0] - 1, pos[1]),  # LEFT\n                      (pos[0] + 1, pos[1])   # RIGHT\n                  ]\n                  for adj_pos in adjacent_cells:\n                      if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                          cell_index = np.argmax(state.grid[adj_pos])\n                          if cell_index == state.world.cookbook.index[resource]:\n                              new_inv = inv.copy()\n                              new_inv[item_idx] -= 1  # Consume the tool\n                              queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                              break\n\n      # Check for BRIDGE usage for WATER\n      if primitive == 'GOLD':\n          use_tool(target_index, 'BRIDGE', 'WATER')\n\n      # Check for PICKAXE usage for GEM\n      if primitive == 'GEM':\n          use_tool(target_index, 'PICKAXE', 'ROCK')\n\n      # Check for AXE usage for WOOD\n      if primitive == 'WOOD':\n          use_tool(target_index, 'AXE', 'TREE')\n\n  return [], -1, []  # Return empty list and negative reward if target is unreachable", "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-08-12T14:32:47.982549", "function_name": "collect", "function_body": "  action_list = []\n  reward = 0\n  state = env._current_state\n  grid = state.grid\n  inventory = state.inventory\n  pos = state.pos\n  dir = state.dir\n\n  # Get the index of the primitive we want to collect\n  primitive_index = state.world.cookbook.index[primitive]\n\n  # Find all positions of the primitive in the grid\n  primitive_positions = np.argwhere(grid[:, :, primitive_index] > 0)\n\n  # If no primitives are found, return empty action list\n  if len(primitive_positions) == 0:\n      return [], reward, state\n\n  # Define a simple BFS to find the shortest path from pos to any of the primitive positions\n  def bfs(start, targets):\n      queue = collections.deque([start])\n      visited = set()\n      parent = {start: None}\n\n      while queue:\n          current = queue.popleft()\n          if current in targets:\n              # Reconstruct path\n              path = []\n              while current is not None:\n                  path.append(current)\n                  current = parent[current]\n              return path[::-1]  # Reverse to get correct order\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n                  if neighbor not in visited:\n                      queue.append(neighbor)\n                      visited.add(neighbor)\n                      parent[neighbor] = current\n\n      return None  # No path found\n\n  # Convert positions to tuple set for faster lookup\n  primitive_positions_set = {tuple(pos) for pos in primitive_positions}\n\n  # Find the shortest path to any of the primitives\n  path_to_primitive = bfs(pos, primitive_positions_set)\n\n  if not path_to_primitive:\n      return [], reward, state\n\n  # Function to determine if a cell is traversable considering current inventory\n  def is_traversable(cell_pos):\n      nonlocal inventory, grid\n      for item in state.world.cookbook.index.keys():\n          item_index = state.world.cookbook.index[item]\n          if grid[cell_pos][item_index] > 0 and inventory[state.world.cookbook.index[item]] == 0:\n              return False  # If the cell has an obstacle that requires a tool not in inventory, it's not traversable\n      return True\n\n  # Filter out non-traversable cells from path_to_primitive\n  filtered_path = [pos for pos in path_to_primitive if is_traversable(pos)]\n\n  # Convert directions to actions (0: DOWN, 1: UP, 2: LEFT, 3: RIGHT)\n  def direction_to_action(current_pos, next_pos):\n      dx = next_pos[0] - current_pos[0]\n      dy = next_pos[1] - current_pos[1]\n      if dx == 1:\n          return 0\n      elif dx == -1:\n          return 1\n      elif dy == -1:\n          return 2\n      elif dy == 1:\n          return 3\n\n  # Create actions to follow the path\n  for i in range(len(filtered_path) - 1):\n      action = direction_to_action(filtered_path[i], filtered_path[i + 1])\n      action_list.append(action)\n      r, state = env.step(state, action)\n      reward += r\n\n  # Once at the primitive, collect it\n  if state.next_to(primitive_index):\n      action_list.append(env.world.N_ACTIONS - 1)  # Assuming USE is the last action\n      r, state = env.step(state, env.world.N_ACTIONS - 1)\n      reward += r\n\n  return action_list, reward, state", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-08-12T14:32:48.959891", "function_name": "collect", "function_body": "  def get_primitive_positions(grid, primitive_index):\n      return np.argwhere(grid[:, :, primitive_index] > 0)\n\n  def bfs(start, targets, grid, inventory, world):\n      queue = collections.deque([(start, [])])\n      visited = set()\n      visited.add(start)\n\n      while queue:\n          current, path = queue.popleft()\n\n          if tuple(current) in targets:\n              return path\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n                  if neighbor not in visited:\n                      # Check for obstacles and use tools from inventory\n                      can_move = True\n                      action_path = path.copy()\n                      \n                      # Check for water and use bridge if available\n                      if world.cookbook.index[\"WATER\"] in grid[neighbor].nonzero()[0] and inventory[world.cookbook.index[\"BRIDGE\"]] > 0:\n                          action_path.append(env.world.N_ACTIONS - 1)  # USE to place BRIDGE\n                          can_move = True\n                          \n                      elif world.cookbook.index[\"STONE\"] in grid[neighbor].nonzero()[0] and inventory[world.cookbook.index[\"PICKAXE\"]] > 0:\n                          action_path.append(env.world.N_ACTIONS - 1)  # USE to mine STONE\n                          can_move = True\n\n                      if can_move:\n                          queue.append((neighbor, action_path))\n                          visited.add(neighbor)\n\n      return None  # No path found\n\n  def direction_to_action(current_pos, next_pos):\n      dx = next_pos[0] - current_pos[0]\n      dy = next_pos[1] - current_pos[1]\n      if dx == 1:\n          return 0\n      elif dx == -1:\n          return 1\n      elif dy == -1:\n          return 2\n      elif dy == 1:\n          return 3\n\n  action_list = []\n  reward = 0\n  state = env._current_state\n  grid = state.grid\n  inventory = state.inventory\n  pos = state.pos\n  dir = state.dir\n\n  primitive_index = state.world.cookbook.index[primitive]\n  primitive_positions = get_primitive_positions(grid, primitive_index)\n\n  if len(primitive_positions) == 0:\n      return [], reward, action_list\n\n  primitive_positions_set = {tuple(pos) for pos in primitive_positions}\n  path_to_primitive = bfs(pos, primitive_positions_set, grid, inventory, state.world)\n\n  if not path_to_primitive:\n      return [], reward, action_list\n\n  # Create actions to follow the path\n  for i in range(len(path_to_primitive) - 1):\n      action = direction_to_action(path_to_primitive[i], path_to_primitive[i + 1])\n      action_list.append(action)\n      r, state = env.step(state, action)\n      reward += r\n\n  if state.next_to(primitive_index):\n      action_list.append(env.world.N_ACTIONS - 1)  # Assuming USE is the last action\n      r, state = env.step(state, env.world.N_ACTIONS - 1)\n      reward += r\n\n  return action_list, reward, state", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-08-12T14:35:08.828936", "function_name": "collect", "function_body": "  def find_path_to_primitive(primitive_index):\n    # Implement A* or BFS to find the shortest path to the nearest primitive\n    start = env._current_state.pos\n    grid = env._current_state.grid\n    \n    # Define a priority queue for A*\n    pq = collections.PriorityQueue()\n    pq.put((0, start))\n    \n    # Dictionary to store the cost of reaching each position\n    g_cost = {start: 0}\n    \n    # Dictionary to store the path taken to reach each position\n    came_from = {}\n    \n    while not pq.empty():\n        current_cost, current_pos = pq.get()\n        \n        if grid[current_pos[0], current_pos[1]].nonzero()[0] == primitive_index:\n            break\n        \n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            neighbor = (current_pos[0] + dx, current_pos[1] + dy)\n            \n            if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n                tentative_g_cost = g_cost[current_pos] + 1\n                \n                if neighbor not in g_cost or tentative_g_cost < g_cost[neighbor]:\n                    came_from[neighbor] = current_pos\n                    g_cost[neighbor] = tentative_g_cost\n                    f_cost = tentative_g_cost + heuristic(neighbor, primitive_index)\n                    pq.put((f_cost, neighbor))\n    \n    path = []\n    while current_pos in came_from:\n        path.append(current_pos)\n        current_pos = came_from[current_pos]\n    path.reverse()\n    \n    return path\n\n  def heuristic(pos, primitive_index):\n    # Implement a heuristic function for A* (e.g., Manhattan distance to the nearest primitive)\n    grid = env._current_state.grid\n    target_positions = np.argwhere(grid[:, :, primitive_index] > 0)\n    if len(target_positions) == 0:\n        return float('inf')\n    \n    min_distance = float('inf')\n    for target in target_positions:\n        distance = abs(pos[0] - target[0]) + abs(pos[1] - target[1])\n        min_distance = min(min_distance, distance)\n    \n    return min_distance\n\n  def use_tools_in_inventory(path):\n    # Logic for using tools already in inventory to interact with environment\n    actions = []\n    state = env._current_state\n    \n    for pos in path:\n        if pos == state.pos:\n            continue\n        \n        direction = get_direction(state.pos, pos)\n        \n        # Check if there are any obstacles that require tool use\n        obstacle_index = check_for_obstacles(pos, direction)\n        if obstacle_index is not None and obstacle_index in state.inventory:\n            actions.append(tool_use_action(obstacle_index))\n        \n        # Move to the next position\n        actions.extend(movement_actions(state.pos, pos))\n    \n    return actions\n\n  def get_direction(current_pos, target_pos):\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n    \n    if dx == -1:\n        return env.action_specs()['LEFT']\n    elif dx == 1:\n        return env.action_specs()['RIGHT']\n    elif dy == -1:\n        return env.action_specs()['UP']\n    elif dy == 1:\n        return env.action_specs()['DOWN']\n\n  def check_for_obstacles(pos, direction):\n    # Check if there are any obstacles that require tool use\n    state = env._current_state\n    grid = state.grid\n    \n    # Determine the position in front of the agent\n    if direction == env.action_specs()['LEFT']:\n        next_pos = (pos[0] - 1, pos[1])\n    elif direction == env.action_specs()['RIGHT']:\n        next_pos = (pos[0] + 1, pos[1])\n    elif direction == env.action_specs()['UP']:\n        next_pos = (pos[0], pos[1] - 1)\n    elif direction == env.action_specs()['DOWN']:\n        next_pos = (pos[0], pos[1] + 1)\n    \n    if grid[next_pos[0], next_pos[1]].nonzero()[0][0] in state.world.non_grabbable_indices:\n        return grid[next_pos[0], next_pos[1]].nonzero()[0][0]\n    \n    return None\n\n  def tool_use_action(obstacle_index):\n      # Return the action to use a tool to interact with an obstacle\n      index = env.action_specs()['USE']\n      return index\n\n  def movement_actions(current_pos, target_pos):\n      actions = []\n      \n      if current_pos[0] < target_pos[0]:\n          actions.append(env.action_specs()['RIGHT'])\n      elif current_pos[0] > target_pos[0]:\n          actions.append(env.action_specs()['LEFT'])\n      \n      if current_pos[1] < target_pos[1]:\n          actions.append(env.action_specs()['DOWN'])\n      elif current_pos[1] > target_pos[1]:\n          actions.append(env.action_specs()['UP'])\n      \n      return actions\n\n  action_list = []\n  reward = 0\n  state = env._current_state\n\n  # Convert the primitive name to its index in the world's primitives\n  primitive_index = env.world.scenario.primitive_name_to_idx[primitive]\n  \n  # Find the shortest path to the nearest primitive\n  path_to_primitive = find_path_to_primitive(primitive_index)\n\n  if path_to_primitive:\n      # Use tools in inventory as needed along the path\n      action_list.extend(use_tools_in_inventory(path_to_primitive))\n      \n      # Add actions to move along the path to the primitive\n      for pos in path_to_primitive:\n          direction = get_direction(state.pos, pos)\n          action_list.append(direction)\n\n  for a in action_list:\n      r, state = env.step(state, a)\n      reward += r\n\n  return state, reward, action_list", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-08-12T14:35:09.798735", "function_name": "collect", "function_body": "  # Define possible actions\n  ACTIONS = {\n    'UP': 0,\n    'DOWN': 1,\n    'LEFT': 2,\n    'RIGHT': 3,\n    'USE': 4\n  }\n\n  def is_valid_position(x, y):\n      \"\"\"Check if the position (x, y) is within bounds.\"\"\"\n      width, height = env.world.scenario.init_grid.shape[0], env.world.scenario.init_grid.shape[1]\n      return 0 <= x < width and 0 <= y < height\n\n  def get_neighbors(pos):\n      \"\"\"Get valid neighboring positions for a given position.\"\"\"\n      x, y = pos\n      neighbors = [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n      return [(nx, ny) for nx, ny in neighbors if is_valid_position(nx, ny)]\n\n  def heuristic(pos, goal):\n      \"\"\"Heuristic function for A* algorithm.\"\"\"\n      x1, y1 = pos\n      x2, y2 = goal\n      return abs(x1 - x2) + abs(y1 - y2)\n\n  def a_star(start, goal):\n      \"\"\"A* search to find the shortest path from start to goal.\"\"\"\n      open_set = collections.PriorityQueue()\n      open_set.put((0, start))\n      came_from = {}\n      g_score = {start: 0}\n      f_score = {start: heuristic(start, goal)}\n\n      while not open_set.empty():\n          _, current = open_set.get()\n\n          if current == goal:\n              path = []\n              while current in came_from:\n                  path.append(current)\n                  current = came_from[current]\n              return path[::-1]\n\n          for neighbor in get_neighbors(current):\n              tentative_g_score = g_score[current] + 1\n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                  open_set.put((f_score[neighbor], neighbor))\n\n      return None  # Goal not reachable\n\n  def find_closest_primitive():\n      \"\"\"Find the closest primitive in the grid.\"\"\"\n      pos = env._current_state.pos\n      min_distance = float('inf')\n      closest_primitive_pos = None\n      width, height = env.world.scenario.init_grid.shape[0], env.world.scenario.init_grid.shape[1]\n      \n      for x in range(width):\n          for y in range(height):\n              if primitive_index == np.argmax(env.world.scenario.init_grid[x, y]):\n                  distance = abs(x - pos[0]) + abs(y - pos[1])\n                  if distance < min_distance:\n                      min_distance = distance\n                      closest_primitive_pos = (x, y)\n                      \n      return closest_primitive_pos\n\n  def get_required_tools(path):\n      \"\"\"Determine the required tools to navigate the path.\"\"\"\n      required_tools = set()\n      \n      for (x, y) in path:\n          if env._current_state.grid[x, y][env.world.water_index] > 0 and 'BRIDGE' not in env._current_state.inventory:\n              required_tools.add('BRIDGE')\n          elif env._current_state.grid[x, y][env.world.stone_index] > 0 and 'PICKAXE' not in env._current_state.inventory:\n              required_tools.add('PICKAXE')\n      \n      return required_tools\n\n  def use_tool(tool):\n      \"\"\"Simulate using a tool.\"\"\"\n      if tool == 'BRIDGE':\n          # Logic to place a bridge\n          pass\n      elif tool == 'PICKAXE':\n          # Logic to mine stone or gem\n          pass\n      \n      # Update inventory after using the tool\n      env._current_state.inventory[env.world.index.index(tool)] -= 1\n\n  def convert_position_to_actions(path):\n      \"\"\"Convert a list of positions into a sequence of actions.\"\"\"\n      pos = env._current_state.pos\n      actions = []\n      \n      for (x, y) in path:\n          if x < pos[0]:\n              actions.append(ACTIONS['UP'])\n          elif x > pos[0]:\n              actions.append(ACTIONS['DOWN'])\n          elif y < pos[1]:\n              actions.append(ACTIONS['LEFT'])\n          elif y > pos[1]:\n              actions.append(ACTIONS['RIGHT'])\n          \n          # Use tool if required\n          tools = get_required_tools([(x, y)])\n          for tool in tools:\n              use_tool(tool)\n              actions.append(ACTIONS['USE'])\n          \n          pos = (x, y)\n      \n      return actions\n\n  primitive_index = env.world.index.index(primitive)\n  closest_primitive_pos = find_closest_primitive()\n  \n  if closest_primitive_pos is None:\n      return [], 0, []  # No primitive found\n\n  path_to_primitive = a_star(env._current_state.pos, closest_primitive_pos)\n  \n  if not path_to_primitive:\n      return [], 0, []  # Path to primitive not reachable\n  \n  action_list = convert_position_to_actions(path_to_primitive)\n\n  reward = 0\n  state = env._current_state\n\n  for a in action_list:\n      r, state = env.step(state, a)\n      reward += r\n\n  return state, reward, action_list", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-08-12T14:38:10.471553", "function_name": "collect", "function_body": "  MAX_STEPS = 200\n  UP, DOWN, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  action_list = []\n  state = env._current_state\n  target_index = state.world.cookbook.index[primitive]\n\n  # Priority queue for BFS (position, steps, inventory, actions)\n  queue = collections.deque([(state.pos, 0, np.copy(state.inventory), [])])\n  visited = set()\n\n  while queue:\n      pos, steps, inv, actions = queue.popleft()\n\n      if steps >= MAX_STEPS:\n          continue\n\n      # Check if the position and inventory have been visited\n      state_key = (tuple(pos), tuple(inv))\n      if state_key in visited:\n          continue\n      visited.add(state_key)\n\n      # Create a new state object for the current BFS step\n      state = craft.CraftState(\n          scenario=state.scenario,\n          grid=np.copy(state.grid),\n          pos=pos,\n          dir=state.dir,\n          inventory=np.copy(inv)\n      )\n\n      # Check if the target primitive is next to the agent\n      if state.next_to(target_index):\n          action_list = actions + [USE]\n          return action_list, 0, action_list\n\n      # Generate possible moves and use of tools\n      new_positions = [\n          (pos[0], pos[1] - 1),  # UP\n          (pos[0], pos[1] + 1),  # DOWN\n          (pos[0] - 1, pos[1]),  # LEFT\n          (pos[0] + 1, pos[1])   # RIGHT\n      ]\n\n      for i, new_pos in enumerate(new_positions):\n          if 0 <= new_pos[0] < state.grid.shape[0] and 0 <= new_pos[1] < state.grid.shape[1]:\n              # Check if the move is valid (not a boundary or non-grabbable entity)\n              cell_index = np.argmax(state.grid[new_pos])\n              if cell_index not in state.world.non_grabbable_indices:\n                  queue.append((new_pos, steps + 1, inv, actions + [i]))\n\n      # Check for tool usage\n      inventory_items = np.where(inv > 0)[0]\n      for item_idx in inventory_items:\n          # Determine the type of tool and its effect (e.g., BRIDGE for WATER)\n          if primitive == 'GOLD' and state.world.cookbook.index.get('BRIDGE') == item_idx:\n              # Check if there's water next to the agent\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['WATER']:\n                          # Use BRIDGE to cross WATER\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the bridge\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n          elif primitive == 'GEM' and state.world.cookbook.index.get('PICKAXE') == item_idx:\n              # Check if there's rock next to the agent\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['ROCK']:\n                          # Use PICKAXE to mine GEM\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the pickaxe\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n          elif primitive == 'WOOD' and state.world.cookbook.index.get('AXE') == item_idx:\n              # Check if there's tree next to the agent (assuming tree is GRASS for now)\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['GRASS']:\n                          # Use AXE to chop WOOD\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the axe\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n      # Add logic for other tools and their effects here (e.g., PICKAXE for GEM)\n\n  return [], -1, []  # Return empty list and negative reward if target is unreachable", "island_id": 7, "scores": {"3": 0.5}}
