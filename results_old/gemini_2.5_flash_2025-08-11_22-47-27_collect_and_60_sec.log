SE]))\n                          break\n\n          elif primitive == 'WOOD' and state.world.cookbook.index.get('AXE') == item_idx:\n              # Check if there's a tree next to the agent\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['TREE']:\n                          # Use AXE to cut WOOD\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the axe\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n          elif primitive == 'SAND' and state.world.cookbook.index.get('SHOVEL') == item_idx:\n              # Check if there's sand next to the agent\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['SAND']:\n                          # Use SHOVEL to collect SAND\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the shovel\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n          elif primitive == 'STONE' and state.world.cookbook.index.get('HAMMER') == item_idx:\n              # Check if there's a rock next to the agent\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['ROCK']:\n                          # Use HAMMER to collect STONE\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the hammer\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n          elif primitive == 'CLAY' and state.world.cookbook.index.get('SPADE') == item_idx:\n              # Check if there's clay next to the agent\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['CLAY']:\n                          # Use SPADE to collect CLAY\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the spade\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n  return [], -1,