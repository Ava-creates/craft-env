ue.append((new_pos, steps + 5, inv.copy(), actions + [USE]))\n\n      # Check for bridge usage to move over water\n      if 'BRIDGE' in inv:\n          bridge_idx = state.world.cookbook.index['BRIDGE']\n          if inv[bridge_idx] > 0 and cell_index == state.world.cookbook.index['WATER']:\n              queue.append((adj_pos, steps + 1, inv.copy(), actions + [USE]))\n\n  return [], -1, []  # Return empty list and negative reward if target is unreachable", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-12T23:57:07.441538", "function_name": "collect", "function_body": "  def get_valid_neighbors(pos, grid_shape):\n      x, y = pos\n      neighbors = []\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < grid_shape[0] and 0 <= ny < grid_shape[1]:\n              neighbors.append((nx, ny))\n      return neighbors\n\n  MAX_STEPS = 50\n  UP, DOWN, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  action_list = []\n  state = env._current_state\n  target_index = state.world.cookbook.index[primitive]\n\n  # Priority queue for BFS (position, steps, inventory, actions)\n  queue = collections.deque([(state.pos, 0, np.copy(state.inventory), [])])\n  visited = set()\n\n  while queue:\n      pos, steps, inv, actions = queue.popleft()\n\n      if steps >= MAX_STEPS:\n          continue\n\n      # Check if the position and inventory have been visited\n      state_key = (tuple(pos), tuple(inv))\n      if state_key in visited:\n          continue\n      visited.add(state_key)\n\n      # Create a new state object for the current BFS step\n      state = craft.CraftState(\n          scenario=state.scenario,\n          grid=np.copy(state.grid),\n          pos=pos,\n          dir=state.dir,\n          inventory=np.copy(inv)\n      )\n\n      # Check if the target primitive is next to the agent\n      if state.next_to(target_index):\n          action_list = actions + [USE]\n          return action_list, 0, action_list\n\n      # Generate possible moves and use of tools\n      valid_neighbors = get_valid_neighbors(pos, state.grid.shape)\n      for i, new_pos in enumerate(valid_neighbors):\n          dx, dy = new_pos[0] - pos[0], new_pos[1] - pos[1]\n          move_action = None\n          if dx == 0 and dy == -1:\n              move_action = UP\n          elif dx == 0 and dy == 1:\n              move_action = DOWN\n          elif dx == -1 and dy == 0:\n              move_action = LEFT\n          elif dx == 1 and dy == 0:\n              move_action = RIGHT\n\n          if move_action is not None:\n              cell_index = np.argmax(state.grid[new_pos])\n              if cell_index not in state.world.non_grabbable_indices:\n                  queue.append((new_pos, steps + 1, inv, actions + [move_action]))\n\n      # Define tool usage function\n      def use_tool(state, target_idx, tool_name, resource_name):\n          inventory_items = np.where(state.inventory > 0)[0]\n          tool_index = state.world.cookbook.index.get(tool_name)\n          resource_index = state.world.cookbook.index.get(resource_name)\n\n          if tool_index is not None and resource_index is not None:\n              adjacent_cells = get_valid_neighbors(state.pos, state.grid.shape)\n              for adj_pos in adjacent_cells:\n                  cell_index = np.argmax(state.grid[adj_pos])\n                  if cell_index == resource_index:\n                      new_inv = state.inventory.copy()\n                      new_inv[tool_index] -= 1  # Consume the tool\n                      queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                      break\n\n      # Define a more general way to handle different tools and resources\n      tool_usages = {\n          'GOLD': ('BRIDGE', 'WATER'),\n          'GEM': ('PICKAXE', 'ROCK'),\n          'WOOD': ('AXE', 'TREE')\n      }\n\n      if primitive in tool_usages:\n          use_tool(state, target_index, *tool_usages[primitive])\n\n      # Directly collect the target primitive if it's available\n      current_cell_index = np.argmax(state.grid[state.pos])\n      if current_cell_index == target_index and inv[target_index] > 0:\n          action_list = actions + [USE]\n          return action_list, 0, action_list\n\n  return [], -1, []  # Return empty list and negative reward if target is unreachable", "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-08-12T23:57:08.423564", "function_name": "collect", "function_body": "  def get_valid_neighbors(pos, grid_shape):\n      x, y = pos\n      neighbors = []\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < grid_shape[0] and 0 <= ny < grid_shape[1]:\n              neighbors.append((nx, ny))\n      return neighbors\n\n  MAX_STEPS = 50\n  UP, DOWN, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  action_list = []\n  state = env._current_state\n  target_index = state.world.cookbook.index[primitive]\n\n  # Priority queue for BFS (position, steps, inventory, actions)\n  queue = collections.deque([(state.pos, 0, np.copy(state.inventory), [])])\n  visited = set()\n\n  while queue:\n      pos, steps, inv, actions = queue.popleft()\n\n      if steps >= MAX_STEPS:\n          continue\n\n      # Check if the position and inventory have been visited\n      state_key = (tuple(pos), tuple(inv))\n      if state_key in visited:\n          continue\n      visited.add(state_key)\n\n      # Create a new state object for the current BFS step\n      state = craft.CraftState(\n          scenario=state.scenario,\n          grid=np.copy(state.grid),\n          pos=pos,\n          dir=state.dir,\n          inventory=np.copy(inv)\n      )\n\n      # Check if the target primitive is next to the agent\n      adjacent_cells = get_valid_neighbors(pos, state.grid.shape)\n      for adj_pos in adjacent_cells:\n          cell_index = np.argmax(state.grid[adj_pos])\n          if cell_index == target_index:\n              action_list = actions + [get_action_from_positions(pos, adj_pos)]\n              return action_list, 0, action_list\n\n      # Generate possible moves and use of tools\n      valid_neighbors = get_valid_neighbors(pos, state.grid.shape)\n      for i, new_pos in enumerate(valid_neighbors):\n          dx, dy = new_pos[0] - pos[0], new_pos[1] - pos[1]\n          move_action = None\n          if dx == 0 and dy == -1:\n              move_action = UP\n          elif dx == 0 and dy == 1:\n              move_action = DOWN\n          elif dx == -1 and dy == 0:\n              move_action = LEFT\n          elif dx == 1 and dy == 0:\n              move_action = RIGHT\n\n          if move_action is not None:\n              cell_index = np.argmax(state.grid[new_pos])\n              if cell_index not in state.world.non_grabbable_indices:\n                  queue.append((new_pos, steps + 1, inv, actions + [move_action]))\n\n      # Define tool usage function\n      def use_tool(state, target_idx, tool_name, resource_name):\n          inventory_items = np.where(state.inventory > 0)[0]\n          tool_index = state.world.cookbook.index.get(tool_name)\n          resource_index = state.world.cookbook.index.get(resource_name)\n\n          if tool_index is not None and resource_index is not None:\n              adjacent_cells = get_valid_neighbors(state.pos, state.grid.shape)\n              for adj_pos in adjacent_cells:\n                  cell_index = np.argmax(state.grid[adj_pos])\n                  if cell_index == resource_index:\n                      new_inv = state.inventory.copy()\n                      new_inv[tool_index] -= 1  # Consume the tool\n                      queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                      break\n\n      # Define a more general way to handle different tools and resources\n      tool_usages = {\n          'GOLD': ('BRIDGE', 'WATER'),\n          'GEM': ('PICKAXE', 'ROCK'),\n          'WOOD': ('AXE', 'TREE')\n      }\n\n      if primitive in tool_usages:\n          use_tool(state, target_index, *tool_usages[primitive])\n\n      # Directly collect the target primitive if it's available\n      current_cell_index = np.argmax(state.grid[state.pos])\n      if current_cell_index == target_index:\n          action_list = actions + [USE]\n          return action_list, 0, action_list\n\n  return [], -1, []  # Return empty list and negative reward if target is unreachable", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-08-12T23:59:53.210911", "function_name": "collect", "function_body": "  MAX_STEPS = 300\n  UP, DOWN, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  action_list = []\n  state = env._current_state\n  target_index = state.world.cookbook.index[primitive]\n\n  # Priority queue for BFS (position, steps, inventory, actions)\n  queue = collections.deque([(state.pos, 0, np.copy(state.inventory), [])])\n  visited = set()\n\n  while queue:\n      pos, steps, inv, actions = queue.popleft()\n\n      if steps >= MAX_STEPS:\n          continue\n\n      # Check if the position and inventory have been visited\n      state_key = (tuple(pos), tuple(inv))\n      if state_key in visited:\n          continue\n      visited.add(state_key)\n\n      # Create a new state object for the current BFS step\n      state = craft.CraftState(\n          scenario=state.scenario,\n          grid=np.copy(state.grid),\n          pos=pos,\n          dir=state.dir,\n          inventory=np.copy(inv)\n      )\n\n      # Check if the target primitive is next to the agent\n      if state.next_to(target_index):\n          action_list = actions + [USE]\n          return action_list, 0, action_list\n\n      # Generate possible moves and use of tools\n      new_positions = [\n          (pos[0], pos[1] - 1),  # UP\n          (pos[0], pos[1] + 1),  # DOWN\n          (pos[0] - 1, pos[1]),  # LEFT\n          (pos[0] + 1, pos[1])   # RIGHT\n      ]\n\n      for i, new_pos in enumerate(new_positions):\n          if 0 <= new_pos[0] < state.grid.shape[0] and 0 <= new_pos[1] < state.grid.shape[1]:\n              cell_index = np.argmax(state.grid[new_pos])\n              if cell_index not in state.world.non_grabbable_indices:\n                  queue.append((new_pos, steps + 1, inv, actions + [i]))\n\n      # Check for tool usage\n      inventory_items = np.where(inv > 0)[0]\n      for item_idx in inventory_items:\n          tool_use_action = None\n\n          if primitive == 'GOLD' and state.world.cookbook.inde