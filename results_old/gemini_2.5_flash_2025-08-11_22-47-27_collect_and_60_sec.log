nd((new_pos, steps + 1, inv, actions + [move_action]))\n\n      # Check for tool usage\n      inventory_items = np.where(inv > 0)[0]\n      for item_idx in inventory_items:\n          tool_action = state.use_tool(item_idx)\n          if tool_action is not None:\n              queue.append((pos, steps + 1, inv - np.eye(len(state.world.cookbook))[item_idx], actions + [USE]))\n\n  return [], -1, []  # Return empty list and negative reward if target is unreachable", "island_id": 8, "scores": {"3": -1}}
