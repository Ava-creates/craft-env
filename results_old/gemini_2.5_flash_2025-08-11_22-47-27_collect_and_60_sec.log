l:\n          tool_index = state.world.cookbook.index.get(tool_name)\n          return tool_index is not None and inv[tool_index] > 0\n      \n      def use_tool(tool_name: str, resource_name: str):\n          tool_index = state.world.cookbook.index[tool_name]\n          resource_index = state.world.cookbook.index[resource_name]\n          \n          adjacent_cells = [\n              (pos[0], pos[1] - 1),  # UP\n              (pos[0], pos[1] + 1),  # DOWN\n              (pos[0] - 1, pos[1]),  # LEFT\n              (pos[0] + 1, pos[1])   # RIGHT\n          ]\n          \n          for adj_pos in adjacent_cells:\n              if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                  cell_index = np.argmax(state.grid[adj_pos])\n                  if cell_index == resource_index:\n                      # Use tool to gather resource\n                      new_inv = inv.copy()\n                      new_inv[tool_index] -= 1  # Consume the tool\n                      queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                      break\n\n      # Check if BRIDGE can be used for WATER\n      if primitive == 'GOLD' and can_use_tool('BRIDGE'):\n          use_tool('BRIDGE', 'WATER')\n      \n      # Check if PICKAXE can be used for GEM\n      if primitive == 'GEM' and can_use_tool('PICKAXE'):\n          use_tool('PICKAXE', 'ROCK')\n\n      # Check if AXE can be used for WOOD\n      if primitive == 'WOOD' and can_use_tool('AXE'):\n          use_tool('AXE', 'TREE')\n          \n  return [], -1, []  # Return empty list and negative reward if target is unreachable", "island_id": 2, "scores": {"3": 0.5}}
