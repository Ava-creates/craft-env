l_name = state.world.cookbook.index.get(item_idx)\n          if not tool_name:\n              continue\n\n          # Determine the type of tool and its effect (e.g., BRIDGE for WATER, PICKAXE for GEM)\n          if primitive == 'GOLD' and tool_name == 'BRIDGE':\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['WATER']:\n                          # Use BRIDGE to cross WATER\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the bridge\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n          elif primitive == 'GEM' and tool_name == 'PICKAXE':\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['ROCK']:\n                          # Use PICKAXE to mine GEM\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the pickaxe\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n          elif primitive == 'STONE' and tool_name == 'PICKAXE':\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['ROCK']:\n                          # Use PICKAXE to mine STONE\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the pickaxe\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n          elif primitive == 'WOOD' and tool_name in ['AXE', 'SHOVEL']:\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['TREE']:\n                          # Use AXE or SHOVEL to collect WOOD\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the tool\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n  return [], -1, []  # Return empty list and negative reward if target is unreachable", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-12T23:53:01.969315", "function_name": "collect", "function_body": "  MAX_STEPS = 100\n  UP, DOWN, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  action_list = []\n  state = env._current_state\n  target_index = state.world.cookbook.index[primitive]\n\n  # Priority queue for BFS (position, steps, inventory, actions)\n  queue = collections.deque([(state.pos, 0, np.copy(state.inventory), [])])\n  visited = set()\n\n  while queue:\n      pos, steps, inv, actions = queue.popleft()\n\n      if steps >= MAX_STEPS:\n          continue\n\n      # Check if the position and inventory have been visited\n      state_key = (tuple(pos), tuple(inv))\n      if state_key in visited:\n          continue\n      visited.add(state_key)\n\n      # Create a new state object for the current BFS step\n      state = craft.CraftState(\n          scenario=state.scenario,\n          grid=np.copy(state.grid),\n          pos=pos,\n          dir=state.dir,\n          inventory=np.copy(inv)\n      )\n\n      # Check if the target primitive is next to the agent\n      adjacent_cells = [\n          (pos[0], pos[1] - 1),  # UP\n          (pos[0], pos[1] + 1),  # DOWN\n          (pos[0] - 1, pos[1]),  # LEFT\n          (pos[0] + 1, pos[1])   # RIGHT\n      ]\n\n      for adj_pos in adjacent_cells:\n          if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n              cell_index = np.argmax(state.grid[adj_pos])\n              if cell_index == target_index:\n                  action_list = actions + [UP, USE] if adj_pos[1] < pos[1] else\\\n                                actions + [DOWN, USE] if adj_pos[1] > pos[1] else\\\n                                actions + [LEFT, USE] if adj_pos[0] < pos[0] else\\\n                                actions + [RIGHT, USE]\n                  return action_list, 0, action_list\n\n      # Generate possible moves\n      for i, new_pos in enumerate(adjacent_cells):\n          if 0 <= new_pos[0] < state.grid.shape[0] and 0 <= new_pos[1] < state.grid.shape[1]:\n              cell_index = np.argmax(state.grid[new_pos])\n              if cell_index not in state.world.non_grabbable_indices:\n                  queue.append((new_pos, steps + 1, inv, actions + [i]))\n\n      # Check for tool usage\n      inventory_items = np.where(inv > 0)[0]\n      for item_idx in inventory_items:\n          required_target = None\n          if primitive == 'GOLD' and item_idx == state.world.cookbook.index['BRIDGE']:\n              required_target = 'WATER'\n          elif primitive == 'GEM' and item_idx == state.world.cookbook.index['PICKAXE']:\n              required_target = 'ROCK'\n          elif primitive in ['TREE', 'WOOD'] and item_idx == state.world.cookbook.index['AXE']:\n              required_target = 'TREE'\n          elif primitive == 'BOULDER' and item_idx == state.world.cookbook.index['HAMMER']:\n              required_target = 'BOULDER'\n          elif primitive == 'IRON_ORE' and item_idx == state.world.cookbook.index['DRILL']:\n              required_target = 'IRON_ORE'\n          elif primitive in ['BUSH', 'CLOTH'] and item_idx == state.world.cookbook.index['SHEARS']:\n              required_target = 'BUSH'\n\n          if required_target is not None:\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if state.world.cookbook[cell_index] == required_target:\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n\n      # Check for tool usage with movement towards the target\n      for item_idx in inventory_items:\n          tool_actions = {\n              'GOLD': ('WATER', USE),\n              'GEM': ('ROCK', USE),\n              'TREE': ('TREE', USE),\n              'BOULDER': ('BOULDER', USE),\n              'IRON_ORE': ('IRON_ORE', USE),\n              'BUSH': ('BUSH', USE),\n          }\n          \n          tool_target, action = tool_actions.get(primitive, (None, None))\n          if tool_target and item_idx == state.world.cookbook.index[tool_target]:\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if state.world.cookbook[cell_index] == tool_target:\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [action]))\n\n      # Check for adjacent cells with required tools\n      for i, adj_pos in enumerate(adjacent_cells):\n          if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n              cell_index = np.argmax(state.grid[adj_pos])\n              tool_needed = None\n\n              if primitive == 'GOLD' and cell_index == state.world.cookbook.index['WATER']:\n                  tool_needed = 'BRIDGE'\n              elif primitive == 'GEM' and cell_index == state.world.cookbook.index['ROCK']:\n                  tool_needed = 'PICKAXE'\n              elif primitive in ['TREE', 'WOOD'] and cell_index == state.world.cookbook.index['TREE']:\n                  tool_needed = 'AXE'\n              elif primitive == 'BOULDER' and cell_index == state.world.cookbook.index['BOULDER']:\n                  tool_needed = 'HAMMER'\n              elif primitive == 'IRON_ORE' and cell_index == state.world.cookbook.index['IRON_ORE']:\n                  tool_needed = 'DRILL'\n              elif primitive in ['BUSH', 'CLOTH'] and cell_index == state.world.cookbook.index['BUSH']:\n                  tool_needed = 'SHEARS'\n\n              if tool_needed:\n                  tool_index = state.world.cookbook.i