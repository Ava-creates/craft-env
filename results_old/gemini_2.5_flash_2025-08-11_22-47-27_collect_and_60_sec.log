 # LEFT\n          (pos[0] + 1, pos[1])   # RIGHT\n      ]\n      for adj_pos in adjacent_cells:\n          if not (0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]):\n              continue\n\n          cell_index = np.argmax(state.grid[adj_pos])\n          tool_usage_conditions = {\n              'GOLD': ('BRIDGE', 'WATER'),\n              'GEM': ('PICKAXE', 'ROCK'),\n              'GRASS': ('HOE', 'DIRT'),\n              'WOOD': ('AXE', 'TREE')\n          }\n\n          for target, (tool_name, resource) in tool_usage_conditions.items():\n              if primitive == target and state.world.cookbook.index.get(tool_name) in inventory_items:\n                  required_resource_index = state.world.cookbook.index[resource]\n                  if cell_index == required_resource_index:\n                      new_inv = inv.copy()\n                      tool_index = state.world.cookbook.index[tool_name]\n                      new_inv[tool_index] -= 1\n                      queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                      break\n\n  return [], -1, []  # Return empty list and negative reward if target is unreachable", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-12T22:49:51.248873", "function_name": "collect", "function_body": "  def get_adjacent_cells(pos):\n      return [\n          (pos[0], pos[1] - 1),  # UP\n          (pos[0], pos[1] + 1),  # DOWN\n          (pos[0] - 1, pos[1]),  # LEFT\n          (pos[0] + 1, pos[1])   # RIGHT\n      ]\n\n  def is_valid_move(pos):\n      return (\n          0 <= pos[0] < env._current_state.grid.shape[0] and\n          0 <= pos[1] < env._current_state.grid.shape[1]\n      )\n\n  def can_grab(primitive, cell_index):\n      target_index = env._current_state.world.primitives.index(primitive)\n      return cell_index == target_index\n\n  def tool_usage_action(tool, primitive, pos):\n      if (tool == 'BRIDGE' and primitive == 'GOLD') or \\\n         (tool == 'PICKAXE' and primitive == 'GEM') or \\\n         (tool == 'AXE' and primitive == 'WOOD') or \\\n         (tool == 'HAMMER' and primitive == 'IRON') or \\\n         (tool == 'SHOVEL' and primitive in ['SAND', 'CLAY']) or \\\n         (tool == 'PICKAXE' and primitive == 'STONE'):\n          adjacent_cells = get_adjacent_cells(pos)\n          for adj_pos in adjacent_cells:\n              if is_valid_move(adj_pos):\n                  cell_index = np.argmax(env._current_state.grid[adj_pos])\n                  target_index = env._current_state.world.primitives.index(primitive)\n                  if cell_index == target_index:\n                      return True, adj_pos\n      return False, None\n\n  def move_action(pos):\n      for direction in range(4):  # UP, DOWN, LEFT, RIGHT\n          new_pos = get_adjacent_cells(pos)[direction]\n          if is_valid_move(new_pos):\n              cell_index = np.argmax(env._current_state.grid[new_pos])\n              if cell_index not in env._current_state.world.non_grabbable_indices:\n                  return direction, new_pos\n      return None, None\n\n  target_index = env._current_state.world.primitives.index(primitive)\n  current_pos = tuple(env._current_state.pos)\n\n  queue = deque([(current_pos, [])])  # (position, path_to_position)\n  visited = set()\n\n  while queue:\n      pos, actions = queue.popleft()\n      if pos in visited:\n          continue\n      visited.add(pos)\n\n      # Check if the target primitive is next to the current position\n      adjacent_cells = get_adjacent_cells(pos)\n      for adj_pos in adjacent_cells:\n          if is_valid_move(adj_pos):\n              cell_index = np.argmax(env._current_state.grid[adj_pos])\n              if can_grab(primitive, cell_index):\n                  return actions + [4], 0, actions + [4]  # Assuming USE action is indexed as 4\n\n      # Check for tool usage\n      inventory_items = np.where(env._current_state.inv > 0)[0]\n      for item_idx in inventory_items:\n          tool_name = env._current_state.world.primitives[item_idx]\n          can_use, new_pos = tool_usage_action(tool_name, primitive, pos)\n          if can_use:\n              return actions + [item_idx], 0, actions + [item_idx]  # Assuming tool usage action is indexed as item_idx\n\n      # Generate possible moves\n      direction, new_pos = move_action(pos)\n      if direction is not None and new_pos not in visited:\n          queue.append((new_pos, actions + [direction]))\n\n  return [], -1, []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-08-12T22:49:52.216917", "function_name": "collect", "function_body": "  MAX_STEPS = 50  # Limit the number of steps to prevent infinite loops in complex scenarios\n  UP, DOWN, LEFT, RIGHT, USE = range(5)\n\n  def bfs(start_pos, target_index):\n      queue = [(start_pos, [], env._current_state.inventory.copy())]\n      visited = set()\n      \n      while queue:\n          (x, y), path, inventory = queue.pop(0)\n          \n          if (x, y) in visited or len(path) >= MAX_STEPS:\n              continue\n          visited.add((x, y))\n          \n          state = env._current_state.copy_with_new_pos(x, y, inventory)\n          # Check if the target is next to the current position\n          if any(np.argmax(state.grid[x + dx][y + dy]) == target_index for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]):\n              return path + [USE]\n          \n          # Generate possible moves and use of tools\n          new_positions = [\n              ((x, y - 1), UP),\n              ((x, y + 1), DOWN),\n              ((x - 1, y), LEFT),\n              ((x + 1, y), RIGHT)\n          ]\n          \n          for (nx, ny), action in new_positions:\n              if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                  cell_index = np.argmax(state.grid[nx][ny])\n                  if cell_index not in state.world.non_grabbable_indices:\n                      queue.append(((nx, ny), path + [action], inventory))\n          \n          # Check for tool usage\n          inventory_items = np.where(inventory > 0)[0]\n          adjacent_cells = [\n              (x, y - 1),  # UP\n              (x, y + 1),  # DOWN\n              (x - 1, y),  # LEFT\n              (x + 1, y)   # RIGHT\n          ]\n          \n          for adj_pos in adjacent_cells:\n              ax, ay = adj_pos\n              if 0 <= ax < state.grid.shape[0] and 0 <= ay < state.grid.shape[1]:\n                  cell_index = np.argmax(state.grid[ax][ay])\n                  \n                  for item_idx in inventory_items:\n                      # Determine the type of tool and its effect\n                      if primitive == 'GOLD' and state.world.cookbook.index.get('BRIDGE') == item_idx:\n                          if cell_index == state.world.cookbook.index['WATER']:\n                              new_inv = inventory.copy()\n                              new_inv[item_idx] -= 1\n                              queue.append((adj_pos, path + [USE], new_inv))\n                              break\n                      \n                      elif primitive == 'GEM' and state.world.cookbook.index.get('PICKAXE') == item_idx:\n                          if cell_index == state.world.cookbook.index['ROCK']:\n                              new_inv = inventory.copy()\n                              new_inv[item_idx] -= 1\n                              queue.append((adj_pos, path + [USE], new_inv))\n                              break\n                      \n                      elif primitive == 'WOOD' and state.world.cookbook.index.get('AXE') == item_idx:\n                          if cell_index == state.world.cookbook.index['TREE']:\n                              new_inv = inventory.copy()\n                              new_inv[item_idx] -= 1\n                              queue.append((adj_pos, path + [USE], new_inv))\n                              break\n                      \n                      elif primitive == 'IRON' and state.world.cookbook.index.get('HAMMER') == item_idx:\n                          if cell_index == state.world.cookbook.index['IRON_ORE']:\n                              new_inv = inventory.copy()\n                              new_inv[item_idx] -= 1\n                              queue.append((adj_pos, path + [USE], new_inv))\n                              break\n                      \n                      elif primitive == 'SAND' and state.world.cookbook.index.get('SHOVEL') == item_idx:\n                          if cell_index == state.world.cookbook.index['SAND']:\n                              new_inv = inventory.copy()\n                              new_inv[item_idx] -= 1\n                              queue.append((adj_pos, path + [USE], new_inv))\n                              break\n                      \n                      elif primitive == 'STONE' and state.world.cookbook.index.get('PICKAXE') == item_idx:\n                          if cell_index == state.world.cookbook.index['STONE']:\n                              new_inv = inventory.copy()\n                              new_inv[item_idx] -= 1\n                              queue.append((adj_pos, path + [USE], new_inv))\n                              break\n                      \n                      elif primitive == 'CLAY' and state.world.cookbook.index.get('SHOVEL') == item_idx:\n                          if cell_index == state.world.cookbook.index['CLAY']:\n                              new_inv = inventory.copy()\n                              new_inv[item_idx] -= 1\n                              queue.append((adj_pos, path + [USE], new_inv))\n                              break\n      \n      return []\n\n  start_pos = env._current_state.agent_position\n  target_index = env._current_state.world.cookbook.index[primitive]\n  \n  action_list = bfs(start_pos, target_index)\n  if action_list:\n      return action_list, 0, action_list\n  \n  return [], -1, []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-08-12T22:52:00.991640", "function_name": "collect", "function_body": "  MAX_STEPS = 100\n  UP, DOWN, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  action_list = []\n  state = env._current_state\n  target_index = state.world.cookbook.index[primitive]\n\n  # Priority queue for BFS (position, steps, inventory, actions)\n  queue = collections.deque([(state.pos, 0, np.copy(state.inventory), [])])\n  visited = set()\n\n  while queue:\n      pos, steps, inv, actions = queue.popleft()\n\n      if steps >= MAX_STEPS:\n          continue\n\n      # Check if the position and inventory have been visited\n      state_key = (tuple(pos), tuple(inv))\n      if state_key in visited:\n          continue\n      visited.add(state_key)\n\n      # Create a new state object for the current BFS step\n      state = craft.CraftState(\n          scenario=state.scenario,\n          grid=np.copy(state.grid),\n          pos=pos,\n          dir=state.dir,\n          inventory=np.copy(inv)\n      )\n\n      # Check if the target primitive is next to the agent\n      if state.next_to(target_index):\n          action_list = actions + [USE]\n          return action_list, 0, action_list\n\n      # Generate possible moves and use of tools\n      new_positions = [\n          (pos[0], pos[1] - 1),  # UP\n          (pos[0], pos[1] + 1),  # DOWN\n          (pos[0] - 1, pos[1]),  # LEFT\n          (pos[0] + 1, pos[1])   # RIGHT\n      ]\n\n      for i, new_pos in enumerate(new_positions):\n          if 0 <= new_pos[0] < state.grid.shape[0] and 0 <= new_pos[1] < state.grid.shape[1]:\n              cell_index = np.argmax(state.grid[new_pos])\n              if cell_index not in state.world.non_grabbable_indices:\n                  queue.append((new_pos, steps + 1, inv, actions + [i]))\n\n      # Check for tool usage\n      inventory_items = np.where(inv > 0)[0]\n      tool_effects = {\n          'BRIDGE': state.world.cookbook.index['WATER'],\n          'PICKAXE': state.world.cookbook.index['ROCK'],\n          'AXE': state.world.cookbook.index['TREE']\n      }\n\n      for item_idx in inventory_items:\n          if item_idx in tool_effects.values():\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == tool_effects.get(item_idx):\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n          elif item_idx == state.world.cookbook.index.get('BRIDGE'):\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == tool_effects['BRIDGE']:\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n  return [], -1, []  # Return empty list and negative reward if target is unreachable", "island_id": 9, "scores": {"3": -1}}
