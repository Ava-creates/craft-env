etermine the type of tool and its effect (e.g., BRIDGE for WATER)\n          if primitive == 'GOLD' and state.world.cookbook.index.get('BRIDGE') == item_idx:\n              # Check if there's water next to the agent\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['WATER']:\n                          # Use BRIDGE to cross WATER\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the bridge\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n          elif primitive == 'GEM' and state.world.cookbook.index.get('PICKAXE') == item_idx:\n              # Check if there's a rock next to the agent\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['ROCK']:\n                          # Use PICKAXE to mine GEM\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the pickaxe\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n          elif primitive == 'WOOD' and state.world.cookbook.index.get('AXE') == item_idx:\n              # Check if there's a tree next to the agent\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['TREE']:\n                          # Use AXE to chop WOOD\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the axe\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n          elif primitive == 'STONE' and state.world.cookbook.index.get('HAMMER') == item_idx:\n              # Check if there's a rock next to the agent\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['ROCK']:\n                          # Use HAMMER to mine STONE\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the hammer\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n  return [], -1, []  # Return empty list and negative reward if target is unreachable", "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-08-12T16:58:33.066171", "function_name": "collect", "function_body": "  # Retrieve the index of the target primitive\n  primitive_index = env.world.cookbook.index(primitive)\n  \n  if primitive_index is None:\n    raise ValueError(f\"Primitive '{primitive}' not found in cookbook.\")\n  \n  state = env._current_state\n  \n  while not state.next_to(primitive_index):\n    \n    # Check for nearby obstacles and use tools if necessary\n    if state.next_to(env.world.water_index) and \"BRIDGE\" in state.inventory:\n      action_list.append(4)  # Assuming USE action places the bridge\n    elif state.next_to(env.world.stone_index) and \"PICKAXE\" in state.inventory:\n      action_list.append(4)  # Assuming USE action mines the stone\n  \n    # Move towards the primitive if no obstacles are blocking\n    else:\n      action = move_towards_primitive(state, primitive_index)\n      if action is not None:\n        action_list.append(action)\n  \n    # Perform the action and update the state\n    reward, state = env.step(action_list[-1])\n    reward += reward\n  \n  # Collect the primitive once it's within reach\n  action_list.append(4)  # Assuming USE action collects the primitive\n  \n  return state, reward, action_list", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-08-12T16:58:34.050311", "function_name": "collect", "function_body": "  def find_primitive_positions(primitive_index):\n    positions = []\n    for i in range(state.grid.shape[0]):\n      for j in range(state.grid.shape[1]):\n        if state.grid[i, j, primitive_index] > 0:\n          positions.append((i, j))\n    return positions\n\n  def heuristic(pos1, pos2):\n    # Manhattan distance\n    return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n\n  def a_star_search(start_pos, goal_positions):\n    open_set = collections.PriorityQueue()\n    open_set.put((0, start_pos))\n    came_from = {}\n    g_score = {start_pos: 0}\n    f_score = {start_pos: heuristic(start_pos, goal_positions[0])}\n\n    while not open_set.empty():\n      _, current = open_set.get()\n\n      if current in goal_positions:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        path.reverse()\n        return path\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        tentative_g_score = g_score[current] + 1\n\n        if 0 <= neighbor[0] < state.grid.shape[0] and 0 <= neighbor[1] < state.grid.shape[1]:\n          if tentative_g_score < g_score.get(neighbor, float('inf')):\n            came_from[neighbor] = current\n            g_score[neighbor] = tentative_g_score\n            f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal_positions[0])\n            open_set.put((f_score[neighbor], neighbor))\n\n    return None\n\n  state = env._current_state\n  cookbook = state.world.cookbook\n  primitive_index = cookbook.index.get(primitive)\n  if primitive_index is None:\n    raise ValueError(f\"Primitive {primitive} not found in the cookbook.\")\n\n  # Find all positions of the target primitive\n  goal_positions = find_primitive_positions(primitive_index)\n\n  if not goal_positions:\n    return [], 0, []\n\n  # Perform A* search to find a path to the nearest primitive\n  start_pos = state.pos\n  path_to_primitive = a_star_search(start_pos, goal_positions)\n  \n  if not path_to_primitive:\n    return [], 0, []\n\n  action_list = []\n  for (x, y) in path_to_primitive:\n      # Determine direction and move towards the next position\n      dx, dy = x - state.pos[0], y - state.pos[1]\n      if dx == 1: action_list.append(env.action_specs()['RIGHT'])\n      elif dx == -1: action_list.append(env.action_specs()['LEFT'])\n      elif dy == 1: action_list.append(env.action_specs()['DOWN'])\n      elif dy == -1: action_list.append(env.action_specs()['UP'])\n\n      # Execute the move\n      reward, state = env.step(action_list[-1])\n      if state.grid[x, y, primitive_index] > 0:\n          # Collect the primitive\n          action_list.append(env.action_specs()['USE'])\n          _, state = env.step(action_list[-1])\n\n  return state, sum(reward for _ in range(len(action_list))), action_list", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-08-12T17:00:03.652366", "function_name": "collect", "function_body": "  MAX_STEPS = 50  # Define a maximum number of steps to prevent infinite loops\n  UP, DOWN, LEFT, RIGHT = 0, 1, 2, 3\n\n  def is_valid_move(pos):\n      x, y = pos\n      return (0 <= x < env.grid.shape[0] and \n              0 <= y < env.grid.shape[1] and \n              np.argmax(env.grid[pos]) not in env.world.non_grabbable_indices)\n\n  def adjacent_positions(pos):\n      x, y = pos\n      positions = [(x - 1, y), (x + 1, y), (x, y - 1), (x, y + 1)]\n      return [p for p in positions if is_valid_move(p)]\n\n  def tool_effect(item_idx, cell_index):\n      tools_effects = {\n          env.world.cookbook.index.get('BRIDGE'): [env.world.cookbook.index['WATER']],\n          env.world.cookbook.index.get('PICKAXE'): [env.world.cookbook.index['ROCK'], \n                                                    env.world.cookbook.index['IRON_ORE']],\n          env.world.cookbook.index.get('AXE'): [env.world.cookbook.index['TREE']]\n      }\n      return cell_index in tools_effects.get(item_idx, [])\n\n  def bfs(start_pos):\n      queue = [(start_pos, [], [])]  # (current position, path, used tools)\n      visited = set()\n      \n      while queue:\n          pos, actions, used_tools = queue.pop(0)\n          \n          if len(actions) > MAX_STEPS:\n              continue\n          \n          if np.argmax(env.grid[pos]) == env.world.cookbook.index[primitive]:\n              return actions + [USE], 0, actions + [USE]\n          \n          visited.add(pos)\n\n          for i, new_pos in enumerate(adjacent_positions(pos)):\n              if new_pos not in visited:\n                  queue.append((new_pos, actions + [i], used_tools))\n          \n          inventory_items = np.where(env._state.inventory > 0)[0]\n          for item_idx in inventory_items:\n              adjacent_cells = adjacent_positions(pos)\n              for adj_pos in adjacent_cells:\n                  cell_index = np.argmax(env.grid[adj_pos])\n                  if tool_effect(item_idx, cell_index) and (adj_pos not in visited):\n                      new_inv = env._state.inventory.copy()\n                      new_inv[item_idx] -= 1\n                      queue.append((adj_pos, actions + [USE], used_tools + [item_idx]))\n      \n      return [], -1, []\n\n  start_position = tuple(env._state.position)\n  action_sequence, reward, executed_actions = bfs(start_position)\n\n  return action_sequence, reward, executed_actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-08-12T17:00:04.652226", "function_name": "collect", "function_body": "  MAX_STEPS = 100\n  UP, DOWN, LEFT, RIGHT, USE = range(5)\n  \n  # Helper function to get valid adjacent positions\n  def get_valid_moves(pos):\n    x, y = pos\n    moves = []\n    if x > 0: \n        moves.append((x - 1, y))  # LEFT\n    if x < env.grid.shape[0] - 1:\n        moves.append((x + 1, y))  # RIGHT\n    if y > 0: \n        moves.append((x, y - 1))  # UP\n    if y < env.grid.shape[1] - 1:\n        moves.append((x, y + 1))  # DOWN\n    return moves\n\n  # Initialize BFS queue and visited set\n  queue = [(env.state.pos, [], 0)]  # (position, action sequence, steps)\n  visited = set()\n  visited.add(env.state.pos)\n\n  while queue:\n      current_pos, actions, steps = queue.pop(0)\n      \n      if steps >= MAX_STEPS:  # Early termination to avoid infinite loops\n          return actions, -1, actions\n\n      # Check adjacent cells for the target primitive or tools needed\n      for move in get_valid_moves(current_pos):\n          new_actions = actions.copy()\n          \n          # Determine direction of movement\n          if move[0] < current_pos[0]:\n              direction = LEFT\n          elif move[0] > current_pos[0]:\n              direction = RIGHT\n          elif move[1] < current_pos[1]:\n              direction = UP\n          else:\n              direction = DOWN\n\n          new_actions.append(direction)\n          x, y = move\n          cell_index = np.argmax(env.grid[x, y])\n          \n          # Check if the target primitive is found\n          if env.world.cookbook.index.get(primitive) == cell_index:\n              return new_actions + [USE], 0, new_actions\n\n          # If not, check for tools and use them if available\n          inventory_items = np.where(env.state.inv > 0)[0]\n          tool_used = False\n          \n          for item_idx in inventory_items:\n              if primitive == 'GOLD' and env.world.cookbook.index.get('BRIDGE') == item_idx and cell_index == env.world.cookbook.index['WATER']:\n                  new_actions.append(USE)\n                  new_state_inv = env.state.inv.copy()\n                  new_state_inv[item_idx] -= 1\n                  queue.append((move, new_actions, steps + 2))\n                  tool_used = True\n                  break\n\n              elif primitive == 'GEM' and env.world.cookbook.index.get('PICKAXE') == item_idx and cell_index == env.world.cookbook.index['ROCK']:\n                  new_actions.append(USE)\n                  new_state_inv = env.state.inv.copy()\n                  new_state_inv[item_idx] -= 1\n                  queue.append((move, new_actions, steps + 2))\n                  tool_used = True\n                  break\n\n              elif primitive == 'WOOD' and env.world.cookbook.index.get('AXE') == item_idx and cell_index == env.world.cookbook.index['TREE']:\n                  new_actions.append(USE)\n                  new_state_inv = env.state.inv.copy()\n                  new_state_inv[item_idx] -= 1\n                  queue.append((move, new_actions, steps + 2))\n                  tool_used = True\n                  break\n\n              elif primitive == 'IRON' and env.world.cookbook.index.get('PICKAXE') == item_idx and cell_index == env.world.cookbook.index['IRON_ORE']:\n                  new_actions.append(USE)\n                  new_state_inv = env.state.inv.copy()\n                  new_state_inv[item_idx] -= 1\n                  queue.append((move, new_actions, steps + 2))\n                  tool_used = True\n                  break\n\n          # If no tools were used, just move to the cell\n          if not tool_used:\n              queue.append((move, new_actions, steps + 1))\n              \n      visited.add(current_pos)\n\n  return actions, -1, actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-08-12T17:03:25.456370", "function_name": "collect", "function_body": "  MAX_STEPS = 100\n  UP, DOWN, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  action_list = []\n  state = env._current_state\n  target_index = state.world.cookbook.index[primitive]\n\n  # Priority queue for BFS (position, steps, inventory, actions)\n  queue = collections.deque([(state.pos, 0, np.copy(state.inventory), [])])\n  visited = set()\n\n  while queue:\n      pos, steps, inv, actions = queue.popleft()\n\n      if steps >= MAX_STEPS:\n          continue\n\n      # Check if the position and inventory have been visited\n      state_key = (tuple(pos), tuple(inv))\n      if state_key in visited:\n          continue\n      visited.add(state_key)\n\n      # Create a new state object for the current BFS step\n      state = craft.CraftState(\n          scenario=state.scenario,\n          grid=np.copy(state.grid),\n          pos=pos,\n          dir=state.dir,\n          inventory=np.copy(inv)\n      )\n\n      # Check if the target primitive is next to the agent\n      if state.next_to(target_index):\n          action_list = actions + [USE]\n          return action_list, 0, action_list\n\n      # Generate possible moves and use of tools\n      new_positions = [\n          (pos[0], pos[1] - 1),  # UP\n          (pos[0], pos[1] + 1),  # DOWN\n          (pos[0] - 1, pos[1]),  # LEFT\n          (pos[0] + 1, pos[1])   # RIGHT\n      ]\n\n      for i, new_pos in enumerate(new_positions):\n          if 0 <= new_pos[0] < state.grid.shape[0] and 0 <= new_pos[1] < state.grid.shape[1]:\n              # Check if the move is valid (not a boundary or non-grabbable entity)\n              cell_index = np.argmax(state.grid[new_pos])\n              if cell_index not in state.world.non_grabbable_indices:\n                  queue.append((new_pos, steps + 1, inv, actions + [i]))\n\n      # Check for tool usage\n      inventory_items = np.where(inv > 0)[0]\n      for item_idx in inventory_items:\n          # Determine the type of tool and its effect (e.g., BRIDGE for WATER)\n          if primitive == 'GOLD' and state.world.cookbook.index.get('BRIDGE') == item_idx:\n              # Check if there's water next to the agent\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['WATER']:\n                          # Use BRIDGE to cross WATER\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the bridge\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n          elif primitive == 'GEM' and state.world.cookbook.index.get('PICKAXE') == item_idx:\n              # Check if there's a rock next to the agent\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['ROCK']:\n                          # Use PICKAXE to mine GEM\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the pickaxe\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n          elif primitive == 'WATER' and state.world.cookbook.index.get('BRIDGE') == item_idx:\n              # Check if there's water next to the agent (useless in this case)\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['WATER']:\n                          # Use BRIDGE to cross WATER\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the bridge\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n          elif primitive == 'ROCK' and state.world.cookbook.index.get('PICKAXE') == item_idx:\n              # Check if there's a rock next to the agent (useless in this case)\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['ROCK']:\n                          # Use PICKAXE to mine GEM\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the pickaxe\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n          elif primitive == 'GRASS' and state.world.cookbook.index.get('SHOVEL') == item_idx:\n              # Check if there's grass next to the agent\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['GRASS']:\n                          # Use SHOVEL to dig GRASS\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the shovel\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n          elif primitive == 'TREE' and state.world.cookbook.index.get('AXE') == item_idx:\n              # Check if there's a tree next to the agent\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['TREE']:\n                          # Use AXE to cut TREE\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the axe\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n          elif primitive == 'SAND' and state.world.cookbook.index.get('SHOVEL') == item_idx:\n              # Check if there's sand next to the agent\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['SAND']:\n                          # Use SHOVEL to dig SAND\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the shovel\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n          elif primitive == 'SNOW' and state.world.cookbook.index.get('SHOVEL') == item_idx:\n              # Check if there's snow next to the agent\n              adjacent_cells = [\n                  (pos[0], pos[1] - 1),  # UP\n                  (pos[0], pos[1] + 1),  # DOWN\n                  (pos[0] - 1, pos[1]),  # LEFT\n                  (pos[0] + 1, pos[1])   # RIGHT\n              ]\n              for adj_pos in adjacent_cells:\n                  if 0 <= adj_pos[0] < state.grid.shape[0] and 0 <= adj_pos[1] < state.grid.shape[1]:\n                      cell_index = np.argmax(state.grid[adj_pos])\n                      if cell_index == state.world.cookbook.index['SNOW']:\n                          # Use SHOVEL to dig SNOW\n                          new_inv = inv.copy()\n                          new_inv[item_idx] -= 1  # Consume the shovel\n                          queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                          break\n\n  return action_list, -1, action_list", "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-08-12T17:03:26.434665", "function_name": "collect", "function_body": "  MAX_STEPS = 50\n  UP, DOWN, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  action_list = []\n  state = env._current_state\n  target_index = state.world.cookbook.index[primitive]\n\n  # Priority queue for BFS (position, steps, inventory, actions)\n  queue = collections.deque([(state.pos, 0, np.copy(state.inventory), [])])\n  visited = set()\n\n  while queue:\n      pos, steps, inv, actions = queue.popleft()\n\n      if steps >= MAX_STEPS:\n          continue\n\n      # Check if the position and inventory have been visited\n      state_key = (tuple(pos), tuple(inv))\n      if state_key in visited:\n          continue\n      visited.add(state_key)\n\n      # Create a new state object for the current BFS step\n      state = craft.CraftState(\n          scenario=state.scenario,\n          grid=np.copy(state.grid),\n          pos=pos,\n          dir=state.dir,\n          inventory=np.copy(inv)\n      )\n\n      # Check if the target primitive is next to the agent\n      if state.next_to(target_index):\n          action_list = actions + [USE]\n          return action_list, 0, action_list\n\n      # Generate possible moves and use of tools\n      new_positions = [\n          (pos[0], pos[1] - 1),  # UP\n          (pos[0], pos[1] + 1),  # DOWN\n          (pos[0] - 1, pos[1]),  # LEFT\n          (pos[0] + 1, pos[1])   # RIGHT\n      ]\n\n      for i, new_pos in enumerate(new_positions):\n          if 0 <= new_pos[0] < state.grid.shape[0] and 0 <= new_pos[1] < state.grid.shape[1]:\n              # Check if the move is valid (not a boundary or non-grabbable entity)\n              cell_index = np.argmax(state.grid[new_pos])\n              if cell_index not in state.world.non_grabbable_indices:\n                  queue.append((new_pos, steps + 1, inv, actions + [i]))\n\n      # Check for tool usage\n      inventory_items = np.where(inv > 0)[0]\n      for item_idx in inventory_items:\n          # De