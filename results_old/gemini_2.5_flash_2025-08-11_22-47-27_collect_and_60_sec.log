 not tool_effect:\n              continue\n\n          adjacent_cells = [\n              (pos[0], pos[1] - 1),  # UP\n              (pos[0], pos[1] + 1),  # DOWN\n              (pos[0] - 1, pos[1]),  # LEFT\n              (pos[0] + 1, pos[1])   # RIGHT\n          ]\n          \n          for adj_pos in adjacent_cells:\n              if (0 <= adj_pos[0] < current_state.grid.shape[0] and \n                  0 <= adj_pos[1] < current_state.grid.shape[1]):\n                  cell_index = np.argmax(current_state.grid[adj_pos])\n                  if tool_effect.get(cell_index) == target_index:\n                      new_inv = inv.copy()\n                      new_inv[item_idx] -= 1  # Consume the tool\n                      queue.append((adj_pos, steps + 2, new_inv, actions + [USE]))\n                      break\n\n  return [], -1, []  # Return empty list and negative reward if target is unreachable", "island_id": 4, "scores": {"3": -1}}
