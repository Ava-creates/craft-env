ith_tools((x, y), primitive_index)\n                          return path + [action] + [4] + actions_to_cross  # Move, USE (cross water), continue\n\n                  new_path = path + [action]\n                  # Check if the target primitive is found at this cell\n                  if kind_index == target_kind:\n                      return new_path\n                  queue.append(((nx, ny), new_path, tools_used | set(obstacle_actions)))\n      return []\n\n  # Step 4: Use the BFS with tool handling to find a path to any cell containing the primitive\n  actions = bfs_with_tools(current_state.pos, primitive_index)\n\n  # Step 5: Append the USE action to collect the primitive\n  if actions:\n      actions.append(4)  # The index for the USE action\n\n  return actions", "island_id": 2, "scores": {"3": 4.0}}
{"timestamp": "2025-09-24T08:04:39.534969", "function_name": "collect", "function_body": "  current_state = env._current_state\n  cookbook = current_state.world.cookbook\n  \n  # Identify the index of the primitive to collect\n  primitive_index = cookbook.index[primitive]\n\n  def bfs(start_pos, target_kind):\n      \"\"\"Performs Breadth-First Search (BFS) to find the shortest path to a cell with the target kind.\n      \n      This version accounts for available tools in the inventory and uses them if necessary.\"\"\"\n      queue = collections.deque([(start_pos, [], current_state.inventory.copy(), [])])\n      visited = set()\n      while queue:\n          (x, y), path, inventory, used_tools = queue.popleft()\n          if (x, y) in visited:\n              continue\n          visited.add((x, y))\n          \n          # Check all four possible directions: UP, DOWN, LEFT, RIGHT\n          for dx, dy, action in [(-1, 0, 2), (1, 0, 3), (0, -1, 0), (0, 1, 1)]:\n              nx, ny = x + dx, y + dy\n              # Ensure the new position is within bounds and not blocked by non-grabbable entities\n              if 0 <= nx < current_state.grid.shape[0] and 0 <= ny < current_state.grid.shape[1]:\n                  kind_index = np.argmax(current_state.grid[nx, ny])\n                  \n                  # Check if there's an obstacle that requires a tool\n                  if kind_index in current_state.world.non_grabbable_indices:\n                      for tool_index, count in enumerate(inventory):\n                          if count > 0 and is_tool_useful(tool_index, kind_index) and tool_index not in used_tools:\n                              path_with_tool = path + [4]  # Use the tool action (assuming USE is always 4)\n                              new_inventory = inventory.copy()\n                              new_inventory[tool_index] -= 1  # Decrease the tool count in inventory\n                              queue.append(((nx, ny), path_with_tool, new_inventory, used_tools + [tool_index]))\n                              break\n                  else:\n                      new_path = path + [action]\n                      queue.append(((nx, ny), new_path, inventory, used_tools))\n\n                  # Check if the target primitive is found at this cell\n                  if kind_index == target_kind:\n                      return new_path\n      return []\n\n  def is_tool_useful(tool_index: int, obstacle_index: int) -> bool:\n      \"\"\"Determines if a tool can be used to remove an obstacle.\"\"\"\n      tool_name = cookbook.index.get(tool_index)\n      obstacle_name = cookbook.index.get(obstacle_index)\n\n      # Define mappings of tools to obstacles they can clear\n      tool_to_obstacle_map = {\n          'BRIDGE': ['WATER'],\n          'HAMMER': ['STONE'],\n          'AXE': ['WOOD', 'ROCK'],\n          'SHEARS': ['GRASS'],\n          'SLINGSHOT': ['GEM'],\n          'BOW': ['GOLD']\n      }\n\n      if tool_name in tool_to_obstacle_map and obstacle_name in tool_to_obstacle_map[tool_name]:\n          return True\n      return False\n\n  # Use the BFS to find a path to any cell containing the primitive\n  actions = bfs(current_state.pos, primitive_index)\n\n  # Append the USE action to collect the primitive if found\n  if actions:\n      actions.append(4)  # The index for the USE action\n\n  return actions", "island_id": 1, "scores": {"3": 4.0}}
{"timestamp": "2025-09-24T08:04:40.548424", "function_name": "collect", "function_body": "  current_state = env._current_state\n  cookbook = current_state.world.cookbook\n  grid_shape = current_state.grid.shape\n  non_grabbable_indices = current_state.world.non_grabbable_indices\n\n  # Identify the index of the primitive to collect\n  primitive_index = cookbook.index[primitive]\n\n  def bfs(start_pos, target_kind):\n      \"\"\"Performs Breadth-First Search (BFS) to find the shortest path to a cell with the target kind.\n      \n      This version accounts for available tools in the inventory and uses them if necessary.\"\"\"\n      queue = collections.deque([(start_pos, [], current_state.inventory.copy())])\n      visited = set()\n      while queue:\n          (x, y), path, inventory = queue.popleft()\n          if (x, y) in visited:\n              continue\n          visited.add((x, y))\n          \n          # Check all four possible directions: UP, DOWN, LEFT, RIGHT\n          for dx, dy, action in [(-1, 0, 2), (1, 0, 3), (0, -1, 0), (0, 1, 1)]:\n              nx, ny = x + dx, y + dy\n              # Ensure the new position is within bounds and not blocked by non-grabbable entities\n              if 0 <= nx < grid_shape[0] and 0 <= ny < grid_shape[1]:\n                  kind_index = np.argmax(current_state.grid[nx, ny])\n                  \n                  # Check if there's an obstacle that requires a tool\n                  if kind_index in non_grabbable_indices:\n                      for tool_name, tool_index in cookbook.index.items():\n                          if inventory[tool_index] > 0 and can_use_tool(tool_index, kind_index):\n                              path_with_tool = path + [4]  # Use the tool action (assuming USE is always 4)\n                              new_inventory = inventory.copy()\n                              new_inventory[tool_index] -= 1  # Decrease the tool count in inventory\n                              queue.append(((nx, ny), path_with_tool, new_inventory))\n                              break\n                  else:\n                      new_path = path + [action]\n                      queue.append(((nx, ny), new_path, inventory))\n\n                  # Check if the target primitive is found at this cell\n                  if kind_index == target_kind:\n                      return new_path\n      return []\n\n  def can_use_tool(tool_index: int, obstacle_index: int) -> bool:\n      \"\"\"Determines if a tool can be used to remove an obstacle.\"\"\"\n      # Define mappings of tools to obstacles they can clear\n      tool_to_obstacle_map = {\n          'BRIDGE': ['WATER'],\n          'HAMMER': ['STONE'],\n          'AXE': ['WOOD', 'ROCK'],\n          'SHEARS': ['GRASS'],\n          'SLINGSHOT': ['GEM'],\n          'BOW': ['GOLD']\n      }\n\n      tool_name = cookbook.index.get(tool_index)\n      obstacle_name = cookbook.index.get(obstacle_index)\n\n      if tool_name in tool_to_obstacle_map and obstacle_name in tool_to_obstacle_map[tool_name]:\n          return True\n      return False\n\n  # Use the BFS to find a path to any cell containing the primitive\n  actions = bfs(current_state.pos, primitive_index)\n\n  # Append the USE action to collect the primitive if found\n  if actions:\n      actions.append(4)  # The index for the USE action\n\n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-24T08:06:10.038491", "function_name": "collect", "function_body": "  def bfs_path(start, goals):\n      queue = collections.deque([(start, [])])\n      visited = set()\n      visited.add(start)\n      \n      while queue:\n          (x, y), path = queue.popleft()\n\n          if (x, y) in goals:\n              return path\n\n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              new_pos = (nx, ny)\n\n              # Check bounds and obstacles\n              if 0 <= nx < grid.shape[1] and 0 <= ny < grid.shape[0]:\n                  # If the cell is empty or contains a primitive\n                  if np.sum(grid[nx, ny, :]) == 0 or any(grid[nx, ny, goal_primitive_index] == 1 for goal_primitive_index in goals_indices):\n                      if new_pos not in visited:\n                          queue.append((new_pos, path + [(dx, dy)]))\n                          visited.add(new_pos)\n\n      return None\n\n  def get_valid_tools(inventory: np.ndarray) -> list[int]:\n    \"\"\"Identify tools that can be used to break boundaries or other obstacles.\"\"\"\n    tool_indices = []\n    for primitive in ['AXE', 'PICKAXE']:\n        if world_config.cookbook.index.primitive(primitive) < len(inventory):\n            if inventory[world_config.cookbook.index.primitive(primitive)] > 0:\n                tool_indices.append(world_config.cookbook.index.primitive(primitive))\n    return tool_indices\n\n  current_state = env._current_state\n  world_config = current_state.world\n\n  # Fetch index for the specified primitive\n  goal_primitive_index = world_config.cookbook.index[primitive]\n\n  # Check if the agent already has the required primitive in its inventory\n  if current_state.inventory[goal_primitive_index] > 0:\n    return []  # No need to collect if already available\n\n  # Find all locations of the specified primitive on the grid\n  primitive_locations = np.argwhere(current_state.grid[:, :, goal_primitive_index] == 1)\n\n  # If no locations are found, return an empty list or handle accordingly\n  if len(primitive_locations) == 0:\n    return []  # Primitive not found\n\n  # Define the four possible directions (UP, DOWN, LEFT, RIGHT)\n  directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n  # Map directions from path to action indices\n  direction_map = {\n      (-1, 0): craft.DOWN,\n      (1, 0): craft.UP,\n      (0, -1): craft.RIGHT,\n      (0, 1): craft.LEFT\n  }\n\n  grid = current_state.grid\n\n  # Initialize actions list\n  actions = []\n\n  goals_indices = [goal_primitive_index]\n  goals_locations = [(loc[1], loc[0]) for loc in primitive_locations]\n\n  valid_tools = get_valid_tools(current_state.inventory)\n\n  def can_use_tool(pos, tool_index):\n    # Check if the cell can be broken by using a tool\n    return any(grid[pos[0], pos[1], i] > 0 for i in [world_config.cookbook.index['BOUNDARY'], world_config.cookbook.index['ROCK']] if i != tool_index)\n\n  while goals_locations:\n      # Re-evaluate the path considering available tools\n      path = bfs_path(current_state.pos, set(goals_locations))\n      \n      if path is None:\n          break  # No valid path found\n\n      actions.extend(direction_map[dx_dy] for dx_dy in path)\n      current_pos = current_state.pos\n      next_action = craft.USE\n      \n      while goals_locations and next_action == craft.USE:\n          next_pos = (current_pos[0] + directions[path[-1][0]][0], \n                      current_pos[1] + directions[path[-1][1]][1])\n\n          if can_use_tool(next_pos, valid_tools):\n              # Use a tool to clear the path\n              for tool_index in valid_tools:\n                  if grid[next_pos[0], next_pos[1], tool_index] > 0:\n                      actions.append(tool_index)  # Select the tool\n                      break\n\n              actions.append(craft.USE)  # Use the selected tool\n\n              # Update the grid and state after using the tool\n              current_state.grid = np.copy(grid)\n              current_state.grid[next_pos[0], next_pos[1]] -= grid[next_pos[0], next_pos[1]]\n              current_state.pos = next_pos\n              \n              path = bfs_path(current_state.pos, set(goals_locations))\n              if path is None:\n                  break  # No valid path found after using the tool\n\n          else:\n              # Collect the primitive at the goal location\n              actions.append(craft.USE)\n              goals_locations.remove(next_pos)\n\n      current_pos = next_pos\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-24T08:06:11.145061", "function_name": "collect", "function_body": "  def bfs_path(start, goals):\n      queue = collections.deque([(start, [])])\n      visited = set()\n      visited.add(start)\n      \n      while queue:\n          (x, y), path = queue.popleft()\n\n          if (x, y) in goals:\n              return path\n\n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              new_pos = (nx, ny)\n\n              # Check bounds and obstacles\n              if 0 <= nx < grid.shape[1] and 0 <= ny < grid.shape[0]:\n                  # If the cell is empty or contains a primitive\n                  if np.sum(grid[nx, ny, :]) == 0 or any(grid[nx, ny, goal_primitive_index] == 1 for goal_primitive_index in goals_indices):\n                      if new_pos not in visited:\n                          queue.append((new_pos, path + [(dx, dy)]))\n                          visited.add(new_pos)\n\n      return None\n\n  current_state = env._current_state\n  world_config = current_state.world\n\n  # Fetch index for the specified primitive\n  goal_primitive_index = world_config.cookbook.index[primitive]\n\n  # Check if the agent already has the required primitive in its inventory\n  if current_state.inventory[goal_primitive_index] > 0:\n    return []  # No need to collect if already available\n\n  # Find all locations of the specified primitive on the grid\n  primitive_locations = np.argwhere(current_state.grid[:, :, goal_primitive_index] == 1)\n\n  # If no locations are found, return an empty list or handle accordingly\n  if len(primitive_locations) == 0:\n    return []  # Primitive not found\n\n  # Define the four possible directions (UP, DOWN, LEFT, RIGHT)\n  directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n  # Map directions from path to action indices\n  direction_map = {\n      (-1, 0): craft.DOWN,\n      (1, 0): craft.UP,\n      (0, -1): craft.RIGHT,\n      (0, 1): craft.LEFT\n  }\n\n  grid = current_state.grid\n\n  # Initialize actions list\n  actions = []\n\n  goals_indices = [goal_primitive_index]\n  goals_locations = [(loc[1], loc[0]) for loc in primitive_locations]\n\n  path = bfs_path(current_state.pos, set(goals_locations))\n  \n  if path is None:\n    return []  # No valid path found\n\n  actions.extend(direction_map[dx_dy] for dx_dy in path)\n  actions.append(craft.USE)  # Collect the primitive at the goal location\n  \n  return actions", "island_id": 9, "scores": {"3": 4.0}}
{"timestamp": "2025-09-24T08:07:43.608367", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = current_state.world\n  cookbook = world.cookbook\n  \n  # Step 1: Identify the index of the primitive to collect\n  primitive_index = cookbook.index[primitive]\n  \n  def bfs(start_pos, target_kind):\n      \"\"\"Performs Breadth-First Search (BFS) to find the shortest path to a cell with the target kind.\n      \n      This version accounts for available tools in the inventory and uses them if necessary.\"\"\"\n      queue = collections.deque([(start_pos, [], current_state.inventory.copy())])\n      visited = set()\n      while queue:\n          (x, y), path, inventory = queue.popleft()\n          if (x, y) in visited:\n              continue\n          visited.add((x, y))\n          \n          # Check all four possible directions: UP, DOWN, LEFT, RIGHT\n          for dx, dy, action in [(-1, 0, 2), (1, 0, 3), (0, -1, 0), (0, 1, 1)]:\n              nx, ny = x + dx, y + dy\n              # Ensure the new position is within bounds and not blocked by non-grabbable entities\n              if 0 <= nx < current_state.grid.shape[0] and 0 <= ny < current_state.grid.shape[1]:\n                  kind_index = np.argmax(current_state.grid[nx, ny])\n                  \n                  # Check if there's an obstacle that requires a tool\n                  if kind_index in world.non_grabbable_indices:\n                      for tool_index, count in enumerate(inventory):\n                          if count > 0 and is_tool_useful(tool_index, kind_index) and tool_index not in used_tools:\n                              path_with_tool = path + [4]  # Use the tool action (assuming USE is always 4)\n                              new_inventory = inventory.copy()\n                              new_inventory[tool_index] -= 1  # Decrease the tool count in inventory\n                              queue.append(((nx, ny), path_with_tool, new_inventory, used_tools + [tool_index]))\n                              break\n                  else:\n                      new_path = path + [action]\n                      queue.append(((nx, ny), new_path, inventory))\n                  \n                  # Check if the target primitive is found at this cell\n                  if kind_index == target_kind:\n                      return new_path\n      return []\n\n  def is_tool_useful(tool_index: int, obstacle_index: int) -> bool:\n      \"\"\"Determines if a tool can be used to remove an obstacle.\"\"\"\n      tool_name = cookbook.index.get(tool_index)\n      obstacle_name = cookbook.index.get(obstacle_index)\n\n      # Define mappings of tools to obstacles they can clear\n      tool_to_obstacle_map = {\n          'BRIDGE': ['WATER'],\n          'HAMMER': ['STONE'],\n          'AXE': ['WOOD', 'ROCK'],\n          'SHEARS': ['GRASS'],\n          'SLINGSHOT': ['GEM'],\n          'BOW': ['GOLD']\n      }\n\n      if tool_name in tool_to_obstacle_map and obstacle_name in tool_to_obstacle_map[tool_name]:\n          return True\n      return False\n\n  # Step 3: Use the BFS to find a path to any cell containing the primitive\n  actions = bfs(current_state.pos, primitive_index)\n\n  # Step 4: Append the USE action to collect the primitive if found\n  if actions:\n      actions.append(4)  # The index for the USE action\n\n  return actions", "island_id": 1, "scores": {"3": 4.0}}
{"timestamp": "2025-09-24T08:07:44.650447", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = current_state.world\n  cookbook = world.cookbook\n\n  # Step 2: Identify the index of the primitive to collect\n  primitive_index = cookbook.index[primitive]\n\n  def bfs(start_pos, target_kind):\n      \"\"\"Performs Breadth-First Search (BFS) to find the shortest path to a cell with the target kind.\n      \n      This version accounts for available tools in the inventory and uses them if necessary.\"\"\"\n      queue = collections.deque([(start_pos, [], current_state.inventory.copy())])\n      visited = set()\n      while queue:\n          (x, y), path, inventory = queue.popleft()\n          if (x, y) in visited:\n              continue\n          visited.add((x, y))\n          \n          # Check all four possible directions: UP, DOWN, LEFT, RIGHT\n          for dx, dy, action in [(-1, 0, 2), (1, 0, 3), (0, -1, 0), (0, 1, 1)]:\n              nx, ny = x + dx, y + dy\n              # Ensure the new position is within bounds and not blocked by non-grabbable entities\n              if 0 <= nx < current_state.grid.shape[0] and 0 <= ny < current_state.grid.shape[1]:\n                  kind_index = np.argmax(current_state.grid[nx, ny])\n\n                  # Check if there's an obstacle that requires a tool\n                  if kind_index in world.non_grabbable_indices:\n                      for tool_name, tool_count in cookbook.primitives.items():\n                          tool_index = cookbook.index.get(tool_name)\n                          if (tool_count > 0 and \n                              inventory[tool_index] > 0 and \n                              is_tool_useful(tool_index, kind_index)):\n                              path_with_tool = path + [4]  # Use the tool action (assuming USE is always 4)\n                              new_inventory = inventory.copy()\n                              new_inventory[tool_index] -= 1  # Decrease the tool count in inventory\n                              queue.append(((nx, ny), path_with_tool, new_inventory))\n                              break\n                  else:\n                      new_path = path + [action]\n                      queue.append(((nx, ny), new_path, inventory))\n\n                  # Check if the target primitive is found at this cell\n                  if kind_index == target_kind:\n                      return new_path\n      return []\n\n  def is_tool_useful(tool_index: int, obstacle_index: int) -> bool:\n      \"\"\"Determines if a tool can be used to remove an obstacle.\"\"\"\n      tool_name = cookbook.index.get(tool_index)\n      obstacle_name = cookbook.index.get(obstacle_index)\n\n      # Define mappings of tools to obstacles they can clear\n      tool_to_obstacle_map = {\n          'BRIDGE': ['WATER'],\n          'HAMMER': ['STONE'],\n          'AXE': ['WOOD', 'ROCK'],\n          'SHEARS': ['GRASS'],\n          'SLINGSHOT': ['GEM'],\n          'BOW': ['GOLD']\n      }\n\n      if tool_name in tool_to_obstacle_map and obstacle_name in tool_to_obstacle_map[tool_name]:\n          return True\n      return False\n\n  # Step 4: Use the BFS to find a path to any cell containing the primitive\n  actions = bfs(current_state.pos, primitive_index)\n\n  # Step 5: Append the USE action to collect the primitive if found\n  if actions:\n      actions.append(4)  # The index for the USE action\n\n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-24T08:08:58.678248", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world_config = current_state.world\n\n  # Fetch index for the specified primitive\n  primitive_index = world_config.cookbook.index[primitive]\n\n  # Check if the agent already has the required primitive in its inventory\n  if current_state.inventory[primitive_index] > 0:\n    return []  # No need to collect if already available\n\n  # Find all locations of the specified primitive on the grid\n  primitive_locations = np.argwhere(current_state.grid[:, :, primitive_index] == 1)\n\n  # If no locations are found, return an empty list or handle accordingly\n  if len(primitive_locations) == 0:\n    return []  # Primitive not found\n\n  def heuristic(pos, goal):\n      return abs(pos[0] - goal[0]) + abs(pos[1] - goal[1])\n\n  # Initialize a priority queue for A* and a visited set to avoid revisiting cells\n  open_set = collections.deque([(0, current_state.pos[0], current_state.pos[1], [])])\n  closed_set = set()\n\n  while open_set:\n      _, x, y, path = open_set.popleft()\n\n      if np.any(current_state.grid[y, x, primitive_index] == 1):\n          break\n\n      for dx, dy in directions:\n          nx, ny = x + dx, y + dy\n          new_pos = (nx, ny)\n\n          # Check bounds and if the cell is empty or contains the primitive\n          if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n              if np.sum(current_state.grid[nx, ny, :]) == 0:\n                  if new_pos not in closed_set:\n                      g_score = len(path) + 1\n                      h_score = heuristic(new_pos, (primitive_locations[0][1], primitive_locations[0][0]))\n                      f_score = g_score + h_score\n                      open_set.append((f_score, nx, ny, path + [(dx, dy)]))\n                      closed_set.add(new_pos)\n              elif current_state.grid[nx, ny, primitive_index] == 1 and new_pos not in closed_set:\n                  g_score = len(path) + 1\n                  h_score = heuristic(new_pos, (primitive_locations[0][1], primitive_locations[0][0]))\n                  f_score = g_score + h_score\n                  open_set.append((f_score, nx, ny, path + [(dx, dy)]))\n                  closed_set.add(new_pos)\n\n      # Sort the open set based on f_score for A* algorithm\n      open_set = collections.deque(sorted(open_set))\n\n  if not np.any(current_state.grid[y, x, primitive_index] == 1):\n      return []  # Path not found\n\n  direction_map = {\n      (-1, 0): craft.DOWN,\n      (1, 0): craft.UP,\n      (0, -1): craft.RIGHT,\n      (0, 1): craft.LEFT\n  }\n\n  actions = [direction_map[dx_dy] for dx_dy in path]\n  actions.append(craft.USE)\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-24T08:08:59.779617", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world_config = current_state.world\n\n  # Fetch index for the specified primitive\n  primitive_index = world_config.cookbook.index[primitive]\n\n  # Check if the agent already has the required primitive in its inventory\n  if current_state.inventory[primitive_index] > 0:\n    return []  # No need to collect if already available\n\n  # Find all locations of the specified primitive on the grid\n  primitive_locations = np.argwhere(current_state.grid[:, :, primitive_index] == 1)\n\n  # If no locations are found, return an empty list or handle accordingly\n  if len(primitive_locations) == 0:\n    return []  # Primitive not found\n\n  # Initialize a queue for BFS and a visited set to avoid revisiting cells\n  queue = collections.deque([(current_state.pos[0], current_state.pos[1], [])])\n  visited = set()\n  visited.add((current_state.pos[0], current_state.pos[1]))\n\n  # Define the four possible directions (UP, DOWN, LEFT, RIGHT)\n  directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n  while queue:\n      x, y, path = queue.popleft()\n\n      # Check if we have reached any of the primitive locations\n      if np.any(current_state.grid[y, x, primitive_index] == 1):\n          break\n\n      # Explore neighbors\n      for dx, dy in directions:\n          nx, ny = x + dx, y + dy\n          new_pos = (nx, ny)\n\n          # Check bounds and if the cell is empty or contains the primitive\n          if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n              if np.sum(current_state.grid[nx, ny, :]) == 0:\n                  if new_pos not in visited:\n                      queue.append((nx, ny, path + [(dx, dy)]))\n                      visited.add(new_pos)\n              elif current_state.grid[nx, ny, primitive_index] == 1 and new_pos not in visited:\n                  queue.append((nx, ny, path + [(dx, dy)]))\n                  visited.add(new_pos)\n\n  # If we did not find a path to any of the primitive locations\n  if not np.any(current_state.grid[y, x, primitive_index] == 1):\n      return []  # Path not found\n\n  # Map directions from path to action indices\n  direction_map = {\n      (-1, 0): craft.DOWN,\n      (1, 0): craft.UP,\n      (0, -1): craft.RIGHT,\n      (0, 1): craft.LEFT\n  }\n\n  # Generate actions from the path\n  actions = [direction_map[dx_dy] for dx_dy in path]\n\n  # Add the USE action to collect the primitive\n  actions.append(craft.USE)\n\n  return actions", "island_id": 9, "scores": {"3": 4.0}}
