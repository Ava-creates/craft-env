                  visited.add(new_pos)\n\n  # If we did not find a path to any of the primitive locations\n  if not np.any(current_state.grid[y, x, primitive_index] == 1):\n      return []  # Path not found\n\n  # Map directions from path to action indices\n  direction_map = {\n      (-1, 0): craft.DOWN,\n      (1, 0): craft.UP,\n      (0, -1): craft.RIGHT,\n      (0, 1): craft.LEFT\n  }\n\n  # Generate actions from the path\n  actions = [direction_map[dx_dy] for dx_dy in path]\n\n  # Add the USE action to collect the primitive\n  actions.append(craft.USE)\n\n  return actions", "island_id": 3, "scores": {"3": 4.0}}
{"timestamp": "2025-09-24T06:59:37.117050", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world_config = current_state.world\n\n  # Fetch index for the specified primitive\n  primitive_index = world_config.cookbook.index[primitive]\n\n  # Check if the agent already has the required primitive in its inventory\n  if current_state.inventory[primitive_index] > 0:\n    return []  # No need to collect if already available\n\n  # Find all locations of the specified primitive on the grid\n  primitive_locations = np.argwhere(current_state.grid[:, :, primitive_index] == 1)\n\n  # If no locations are found, return an empty list or handle accordingly\n  if len(primitive_locations) == 0:\n    return []  # Primitive not found\n\n  # Initialize a queue for BFS and a visited set to avoid revisiting cells\n  queue = collections.deque([(current_state.pos[0], current_state.pos[1], [])])\n  visited = set()\n  visited.add((current_state.pos[0], current_state.pos[1]))\n\n  # Define the four possible directions (UP, DOWN, LEFT, RIGHT)\n  directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n  while queue:\n      x, y, path = queue.popleft()\n\n      # Check if we have reached any of the primitive locations\n      if np.any(current_state.grid[y, x, primitive_index] == 1):\n          break\n\n      # Explore neighbors\n      for dx, dy in directions:\n          nx, ny = x + dx, y + dy\n          new_pos = (nx, ny)\n\n          # Check bounds and if the cell is empty or contains the primitive\n          if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n              if np.sum(current_state.grid[nx, ny, :]) == 0:\n                  if new_pos not in visited:\n                      queue.append((nx, ny, path + [(dx, dy)]))\n                      visited.add(new_pos)\n              elif current_state.grid[nx, ny, primitive_index] == 1 and new_pos not in visited:\n                  queue.append((nx, ny, path + [(dx, dy)]))\n                  visited.add(new_pos)\n\n  # If we did not find a path to any of the primitive locations\n  if not np.any(current_state.grid[y, x, primitive_index] == 1):\n      return []  # Path not found\n\n  # Map directions from path to action indices\n  direction_map = {\n      (-1, 0): craft.DOWN,\n      (1, 0): craft.UP,\n      (0, -1): craft.RIGHT,\n      (0, 1): craft.LEFT\n  }\n\n  # Generate actions from the path\n  actions = [direction_map[dx_dy] for dx_dy in path]\n\n  # Add the USE action to collect the primitive\n  actions.append(craft.USE)\n\n  return actions", "island_id": 3, "scores": {"3": 4.0}}
{"timestamp": "2025-09-24T07:00:34.075719", "function_name": "collect", "function_body": "  current_state = env._current_state\n  grid_shape = current_state.grid.shape\n  cookbook = current_state.world.cookbook\n  \n  # Step 2: Identify the index of the primitive to collect\n  primitive_index = cookbook.index[primitive]\n\n  # Step 3: Define a more sophisticated BFS (Breadth-First Search) algorithm \n  def bfs(start_pos, target_kind):\n    \"\"\"Performs Breadth-First Search to find the shortest path to a cell with the target kind.\"\"\"\n    queue = collections.deque([(start_pos, [], set())])\n    visited = set()\n    \n    while queue:\n      (x, y), path, tools_used = queue.popleft()\n      \n      if (x, y) in visited:\n        continue\n      visited.add((x, y))\n      \n      # Check all four possible directions: UP, DOWN, LEFT, RIGHT\n      for dx, dy, action in [(-1, 0, 2), (1, 0, 3), (0, -1, 0), (0, 1, 1)]:\n        nx, ny = x + dx, y + dy\n        \n        # Ensure the new position is within bounds\n        if 0 <= nx < grid_shape[0] and 0 <= ny < grid_shape[1]:\n          kind_index = np.argmax(current_state.grid[nx, ny])\n          \n          # Check for obstacles and non-grabbable entities\n          if kind_index in current_state.world.non_grabbable_indices:\n            # If it's a boundary or water, skip unless the agent has the appropriate tool\n            if kind_index == cookbook.index['BOUNDARY'] or kind_index == cookbook.index['WATER']:\n              if action == 0 and 'bridge' not in tools_used:  # Up (requires bridge)\n                continue\n              elif action == 1 and 'ladder' not in tools_used:  # Down (requires ladder)\n                continue\n            else:\n              continue\n          \n          new_path = path + [action]\n          new_tools_used = set(tools_used)\n          \n          # Check if the target primitive is found at this cell\n          if kind_index == target_kind:\n            return new_path\n          \n          queue.append(((nx, ny), new_path, new_tools_used))\n    return []\n\n  # Step 4: Use the BFS to find a path to any cell containing the primitive\n  actions = bfs(current_state.pos, primitive_index)\n\n  # Step 5: Append the USE action to collect the primitive\n  if actions:\n    actions.append(4)  # The index for the USE action\n\n  return actions", "island_id": 7, "scores": {"3": 4.0}}
{"timestamp": "2025-09-24T07:00:35.131902", "function_name": "collect", "function_body": "  current_state = env._current_state\n  grid_shape = current_state.grid.shape\n  cookbook = current_state.world.cookbook\n  \n  # Identify the index of the primitive to collect\n  primitive_index = cookbook.index[primitive]\n\n  def bfs(start_pos, target_kind):\n    \"\"\"Performs Breadth-First Search to find the shortest path to a cell with the target kind.\"\"\"\n    queue = collections.deque([(start_pos, [])])\n    visited = set()\n    \n    while queue:\n      (x, y), path = queue.popleft()\n      \n      if (x, y) in visited:\n        continue\n      visited.add((x, y))\n      \n      # Check all four possible directions: UP, DOWN, LEFT, RIGHT\n      for dx, dy, action in [(-1, 0, 2), (1, 0, 3), (0, -1, 0), (0, 1, 1)]:\n        nx, ny = x + dx, y + dy\n        \n        # Ensure the new position is within bounds\n        if 0 <= nx < grid_shape[0] and 0 <= ny < grid_shape[1]:\n          kind_index = np.argmax(current_state.grid[nx, ny])\n          \n          # Check for obstacles and non-grabbable entities\n          if kind_index in current_state.world.non_grabbable_indices:\n            continue\n          \n          new_path = path + [action]\n          \n          # Check if the target primitive is found at this cell\n          if kind_index == target_kind:\n            return new_path\n          \n          queue.append(((nx, ny), new_path))\n    return []\n\n  # Use the BFS to find a path to any cell containing the primitive\n  actions = bfs(current_state.pos, primitive_index)\n\n  # Append the USE action to collect the primitive\n  if actions:\n    actions.append(4)  # The index for the USE action\n\n  return actions", "island_id": 7, "scores": {"3": 4.0}}
{"timestamp": "2025-09-24T07:01:42.795955", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world_config = current_state.world\n\n  # Fetch index for the specified primitive\n  primitive_index = world_config.cookbook.index[primitive]\n\n  # Check if the agent already has the required primitive in its inventory\n  if current_state.inventory[primitive_index] > 0:\n    return []  # No need to collect if already available\n\n  # Find all locations of the specified primitive on the grid\n  primitive_locations = np.argwhere(current_state.grid[:, :, primitive_index] == 1)\n\n  # If no locations are found, return an empty list or handle accordingly\n  if len(primitive_locations) == 0:\n    return []  # Primitive not found\n\n  def bfs(start_pos):\n      queue = collections.deque([(start_pos[0], start_pos[1], [])])\n      visited = set()\n      visited.add((start_pos[0], start_pos[1]))\n\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n      while queue:\n          x, y, path = queue.popleft()\n\n          # Check if we have reached any of the primitive locations\n          for loc in primitive_locations:\n              if x == loc[1] and y == loc[0]:\n                  return path\n\n          # Explore neighbors\n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              new_pos = (nx, ny)\n\n              # Check bounds and if the cell is empty or contains the primitive\n              if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n                  if np.sum(current_state.grid[nx, ny, :]) == 0:\n                      if new_pos not in visited:\n                          queue.append((nx, ny, path + [(dx, dy)]))\n                          visited.add(new_pos)\n                  elif current_state.grid[nx, ny, primitive_index] == 1 and new_pos not in visited:\n                      queue.append((nx, ny, path + [(dx, dy)]))\n                      visited.add(new_pos)\n\n      return None\n\n  # Use BFS to find the shortest path to any of the primitive locations\n  path = bfs(current_state.pos)\n  if not path:\n      return []  # Path not found\n\n  direction_map = {\n      (-1, 0): craft.DOWN,\n      (1, 0): craft.UP,\n      (0, -1): craft.RIGHT,\n      (0, 1): craft.LEFT\n  }\n\n  # Generate actions from the path\n  actions = [direction_map[dx_dy] for dx_dy in path]\n\n  # Add the USE action to collect the primitive\n  actions.append(craft.USE)\n\n  return actions", "island_id": 5, "scores": {"3": 4.0}}
{"timestamp": "2025-09-24T07:01:43.847736", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world_config = current_state.world\n\n  # Fetch index for the specified primitive\n  primitive_index = world_config.cookbook.index[primitive]\n\n  # Check if the agent already has the required primitive in its inventory\n  if current_state.inventory[primitive_index] > 0:\n    return []  # No need to collect if already available\n\n  # Find all locations of the specified primitive on the grid\n  primitive_locations = np.argwhere(current_state.grid[:, :, primitive_index] == 1)\n\n  # If no locations are found, return an empty list or handle accordingly\n  if len(primitive_locations) == 0:\n    return []  # Primitive not found\n\n  def bfs(start_pos):\n      queue = collections.deque([(start_pos[0], start_pos[1], [])])\n      visited = set()\n      visited.add((start_pos[0], start_pos[1]))\n\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n      while queue:\n          x, y, path = queue.popleft()\n\n          # Check if we have reached any of the primitive locations\n          for px, py in primitive_locations:\n              if x == px and y == py:\n                  return path\n\n          # Explore neighbors\n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              new_pos = (nx, ny)\n\n              # Check bounds and if the cell is empty or contains the primitive\n              if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n                  if np.sum(current_state.grid[nx, ny, :]) == 0:\n                      if new_pos not in visited:\n                          queue.append((nx, ny, path + [(dx, dy)]))\n                          visited.add(new_pos)\n                  elif current_state.grid[nx, ny, primitive_index] == 1 and new_pos not in visited:\n                      queue.append((nx, ny, path + [(dx, dy)]))\n                      visited.add(new_pos)\n\n      return None\n\n  # Use BFS to find the shortest path to any of the primitive locations\n  path = bfs(current_state.pos)\n  if not path:\n      return []  # Path not found\n\n  direction_map = {\n      (-1, 0): craft.DOWN,\n      (1, 0): craft.UP,\n      (0, -1): craft.RIGHT,\n      (0, 1): craft.LEFT\n  }\n\n  # Generate actions from the path\n  actions = [direction_map[dx_dy] for dx_dy in path]\n\n  # Add the USE action to collect the primitive\n  actions.append(craft.USE)\n\n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-24T07:03:18.308401", "function_name": "collect", "function_body": "  current_state = env._current_state\n\n  # Step 2: Identify the index of the primitive to collect\n  if primitive not in current_state.world.cookbook.index:\n      raise ValueError(f\"Primitive '{primitive}' not found in cookbook.\")\n  \n  primitive_index = current_state.world.cookbook.index[primitive]\n\n  # Define a BFS algorithm that uses available tools from inventory.\n  def bfs_with_tools(start_pos, target_kind):\n      \"\"\"Performs Breadth-First Search to find the shortest path to a cell with the target kind using available tools.\"\"\"\n      queue = collections.deque([(start_pos, [])])\n      visited = set()\n      while queue:\n          (x, y), path = queue.popleft()\n          if (x, y) in visited:\n              continue\n          visited.add((x, y))\n          \n          # Check all four possible directions: UP, DOWN, LEFT, RIGHT\n          for dx, dy, action in [(-1, 0, 2), (1, 0, 3), (0, -1, 0), (0, 1, 1)]:\n              nx, ny = x + dx, y + dy\n\n              # Ensure the new position is within bounds\n              if 0 <= nx < current_state.grid.shape[0] and 0 <= ny < current_state.grid.shape[1]:\n                  kind_index = np.argmax(current_state.grid[nx, ny])\n                  \n                  # Handle obstacles based on available tools in inventory\n                  if kind_index == current_state.world.cookbook.index['WATER']:\n                      tool_name = 'BRIDGE'\n                  elif kind_index == current_state.world.cookbook.index['ROCK']:\n                      tool_name = 'HAMMER'\n                  else:\n                      tool_name = None\n\n                  if tool_name and tool_name in current_state.world.cookbook.index:\n                      tool_index = current_state.world.cookbook.index[tool_name]\n                      # Check if the required tool is available\n                      if current_state.inventory[tool_index] > 0:\n                          new_path = path + [4]  # USE action to use the tool\n                          kind_index = None  # Clear the obstacle after using the tool\n                          if len(path) == 0 or path[-1] != 4:  # Avoid consecutive USE actions\n                              queue.append(((nx, ny), new_path))\n                      else:\n                          continue  # Skip this direction if no suitable tool is available\n                  elif kind_index in current_state.world.non_grabbable_indices:\n                      continue  # Non-grabbable entities cannot be crossed\n\n                  if kind_index is not None:  # Proceed only if there are no remaining obstacles\n                      new_path = path + [action]\n                      if kind_index == target_kind:\n                          return new_path\n                      queue.append(((nx, ny), new_path))\n      return []\n\n  def use_tool_if_needed(action_sequence):\n      \"\"\"Modifies the action sequence to use tools appropriately before collecting primitives.\"\"\"\n      modified_actions = []\n      i = 0\n      while i < len(action_sequence) - 1:\n          current_action = action_sequence[i]\n          next_action = action_sequence[i + 1]\n          \n          # Check if moving towards an obstacle that requires a tool\n          nx, ny = move_in_direction(current_state.pos, next_action)\n          kind_index = np.argmax(current_state.grid[nx, ny])\n          \n          if kind_index == current_state.world.cookbook.index['WATER']:\n              tool_name = 'BRIDGE'\n          elif kind_index == current_state.world.cookbook.index['ROCK']:\n              tool_name = 'HAMMER'\n          else:\n              tool_name = None\n\n          if tool_name and tool_name in current_state.world.cookbook.index:\n              tool_index = current_state.world.cookbook.index[tool_name]\n              if current_state.inventory[tool_index] > 0:\n                  modified_actions.append(4)  # USE action to use the tool\n          \n          modified_actions.append(current_action)\n          i += 1\n      \n      # Append the final USE action to collect the primitive\n      modified_actions.append(action_sequence[-1])\n      return modified_actions\n\n  def move_in_direction(position, direction):\n      \"\"\"Computes the new position after moving in a given direction.\"\"\"\n      x, y = position\n      if direction == 0:  # UP\n          y -= 1\n      elif direction == 1:  # DOWN\n          y += 1\n      elif direction == 2:  # LEFT\n          x -= 1\n      elif direction == 3:  # RIGHT\n          x += 1\n      return (x, y)\n\n  # Step 4: Use the BFS to find a path to any cell containing the primitive\n  actions = bfs_with_tools(current_state.pos, primitive_index)\n\n  if not actions:\n      return []\n\n  # Step 5: Modify the action sequence to use tools appropriately\n  modified_actions = use_tool_if_needed(actions)\n\n  return modified_actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-09-24T07:03:19.422171", "function_name": "collect", "function_body": "  current_state = env._current_state\n\n  # Step 2: Identify the index of the primitive to collect\n  if primitive not in current_state.world.cookbook.index:\n      raise ValueError(f\"Primitive '{primitive}' not found in cookbook.\")\n  \n  primitive_index = current_state.world.cookbook.index[primitive]\n\n  # Define a BFS algorithm that uses available tools from inventory and avoids loops.\n  def bfs_with_tools_avoid_loops(start_pos, target_kind):\n      \"\"\"Performs Breadth-First Search to find the shortest path to a cell with the target kind using available tools while avoiding loops.\"\"\"\n      queue = collections.deque([(start_pos, [])])\n      visited = set()\n      while queue:\n          (x, y), path = queue.popleft()\n          if (x, y) in visited:\n              continue\n          visited.add((x, y))\n          \n          # Check all four possible directions: UP, DOWN, LEFT, RIGHT\n          for dx, dy, action in [(-1, 0, 2), (1, 0, 3), (0, -1, 0), (0, 1, 1)]:\n              nx, ny = x + dx, y + dy\n\n              # Ensure the new position is within bounds\n              if 0 <= nx < current_state.grid.shape[0] and 0 <= ny < current_state.grid.shape[1]:\n                  kind_index = np.argmax(current_state.grid[nx, ny])\n                  \n                  # Handle obstacles based on available tools in inventory\n                  if kind_index == current_state.world.cookbook.index['WATER']:\n                      tool_name = 'BRIDGE'\n                  elif kind_index == current_state.world.cookbook.index['ROCK']:\n                      tool_name = 'HAMMER'\n                  else:\n                      tool_name = None\n\n                  if tool_name and tool_name in current_state.world.cookbook.index:\n                      tool_index = current_state.world.cookbook.index[tool_name]\n                      # Check if the required tool is available\n                      if current_state.inventory[tool_index] > 0:\n                          new_path = path + [4]  # USE action to use the tool\n                          kind_index = None  # Clear the obstacle after using the tool\n                          if len(path) == 0 or path[-1] != 4:  # Avoid consecutive USE actions\n                              queue.append(((nx, ny), new_path))\n                      else:\n                          continue  # Skip this direction if no suitable tool is available\n                  elif kind_index in current_state.world.non_grabbable_indices:\n                      continue  # Non-grabbable entities cannot be crossed\n\n                  if kind_index is not None:  # Proceed only if there are no remaining obstacles\n                      new_path = path + [action]\n                      if kind_index == target_kind:\n                          return new_path\n                      queue.append(((nx, ny), new_path))\n      return []\n\n  # Step 4: Use the BFS to find a path to any cell containing the primitive\n  actions = bfs_with_tools_avoid_loops(current_state.pos, primitive_index)\n\n  # Step 5: Append the USE action to collect the primitive\n  if actions:\n      actions.append(4)  # The index for the USE action\n\n  return actions", "island_id": 6, "scores": {"3": 4.0}}
{"timestamp": "2025-09-24T07:04:11.091093", "function_name": "collect", "function_body": "  current_state = env._current_state\n\n  # Step 2: Identify the index of the primitive to collect\n  primitive_index = current_state.world.cookbook.index[primitive]\n\n  # Step 3: Define a simple BFS (Breadth-First Search) algorithm to find the shortest path\n  def bfs(start_pos, target_kind):\n      \"\"\"Performs Breadth-First Search to find the shortest path to a cell with the target kind.\"\"\"\n      queue = collections.deque([(start_pos, [])])\n      visited = set()\n      while queue:\n          (x, y), path = queue.popleft()\n          if (x, y) in visited:\n              continue\n          visited.add((x, y))\n          # Check all four possible directions: UP, DOWN, LEFT, RIGHT\n          for dx, dy, action in [(-1, 0, 2), (1, 0, 3), (0, -1, 0), (0, 1, 1)]:\n              nx, ny = x + dx, y + dy\n              # Ensure the new position is within bounds and not blocked by non-grabbable entities\n              if 0 <= nx < current_state.grid.shape[0] and 0 <= ny < current_state.grid.shape[1]:\n                  kind_index = np.argmax(current_state.grid[nx, ny])\n                  if kind_index in current_state.world.non_grabbable_indices:\n                      continue\n                  new_path = path + [action]\n                  # Check if the target primitive is found at this cell\n                  if kind_index == target_kind:\n                      return new_path\n                  queue.append(((nx, ny), new_path))\n      return []\n\n  # Step 4: Use the BFS to find a path to any cell containing the primitive\n  actions = bfs(current_state.pos, primitive_index)\n\n  # Step 5: Append the USE action to collect the primitive\n  if actions:\n      actions.append(4)  # The index for the USE action\n\n  return actions", "island_id": 6, "scores": {"3": 4.0}}
{"timestamp": "2025-09-24T07:04:12.199733", "function_name": "collect", "function_body": "  current_state = env._current_state\n\n  # Step 2: Identify the index of the primitive to collect\n  primitive_index = current_state.world.cookbook.index[primitive]\n\n  # Step 3: Define a BFS (Breadth-First Search) algorithm to find the shortest path\n  def bfs(start_pos, target_kind):\n      \"\"\"Performs Breadth-First Search to find the shortest path to a cell with the target kind.\"\"\"\n      queue = collections.deque([(start_pos, [])])\n      visited = set()\n      while queue:\n          (x, y), path = queue.popleft()\n          if (x, y) in visited:\n              continue\n          visited.add((x, y))\n          # Check all four possible directions: UP, DOWN, LEFT, RIGHT\n          for dx, dy, action in [(-1, 0, 2), (1, 0, 3), (0, -1, 0), (0, 1, 1)]:\n              nx, ny = x + dx, y + dy\n              # Ensure the new position is within bounds and not blocked by non-grabbable entities\n              if 0 <= nx < current_state.grid.shape[0] and 0 <= ny < current_state.grid.shape[1]:\n                  kind_index = np.argmax(current_state.grid[nx, ny])\n                  if kind_index in current_state.world.non_grabbable_indices:\n                      continue\n                  new_path = path + [action]\n                  # Check if the target primitive is found at this cell\n                  if kind_index == target_kind:\n                      return new_path\n                  queue.append(((nx, ny), new_path))\n      return []\n\n  # Step 4: Use the BFS to find a path to any cell containing the primitive\n  actions = bfs(current_state.pos, primitive_index)\n\n  # Step 5: Append the USE action to collect the primitive\n  if actions:\n      actions.append(4)  # The index for the USE action\n\n  return actions", "island_id": 6, "scores": {"3": 4.0}}
{"timestamp": "2025-09-24T07:05:23.986835", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world_config = current_state.world\n\n  # Fetch index for the specified primitive\n  primitive_index = world_config.cookbook.index[primitive]\n\n  # Check if the agent already has the required primitive in its inventory\n  if current_state.inventory[primitive_index] > 0:\n    return []  # No need to collect if already available\n\n  # Find all locations of the specified primitive on the grid\n  primitive_locations = np.argwhere(current_state.grid[:, :, primitive_index] == 1)\n\n  # If no locations are found, return an empty list or handle accordingly\n  if len(primitive_locations) == 0:\n    return []  # Primitive not found\n\n  # Initialize a queue for BFS and a visited set to avoid revisiting cells\n  queue = collections.deque([(current_state.pos[0], current_state.pos[1], [])])\n  visited = set()\n  visited.add((current_state.pos[0], current_state.pos[1]))\n\n  # Define the four possible directions (UP, DOWN, LEFT, RIGHT)\n  directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n  while queue:\n      x, y, path = queue.popleft()\n\n      # Check if we have reached any of the primitive locations\n      if np.any(current_state.grid[y, x, primitive_index] == 1):\n          break\n\n      # Explore neighbors\n      for dx, dy in directions:\n          nx, ny = x + dx, y + dy\n          new_pos = (nx, ny)\n\n          # Check bounds and if the cell is empty or contains the primitive\n          if 0 <= nx < current_state.grid.shape[1] and 0 <= ny < current_state.grid.shape[0]:\n              if np.sum(current_state.grid[nx, ny, :]) == 0:\n                  if new_pos not in visited:\n                      queue.append((nx, ny, path + [(dx, dy)]))\n                      visited.add(new_pos)\n              elif current_state.grid[nx, ny, primitive_index] == 1 and new_pos not in visited:\n                  queue.append((nx, ny, path + [(dx, dy)]))\n                  visited.add(new_pos)\n\n  # If we did not find a path to any of the primitive locations\n  if not np.any(current_state.grid[y, x, primitive_index] == 1):\n      return []  # Path not found\n\n  # Map directions from path to action indices\n  direction_map = {\n      (-1, 0): craft.DOWN,\n      (1, 0): craft.UP,\n      (0, -1): craft.RIGHT,\n      (0, 1): craft.LEFT\n  }\n\n  # Generate actions from the path\n  actions = [direction_map[dx_dy] for dx_dy in path]\n\n  # Add the USE action to collect the primitive\n  actions.append(craft.USE)\n\n  return actions", "island_id": 5, "scores": {"3": 4.0}}
