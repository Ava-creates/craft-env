{"timestamp": "2025-07-28T10:37:25.421955", "function_name": "collect", "function_body": "  import collections\n\n  action_map = env.action_specs()\n  ACTION_USE = action_map[\"USE\"]\n  ACTION_UP = action_map[\"UP\"]\n  ACTION_DOWN = action_map[\"DOWN\"]\n  ACTION_LEFT = action_map[\"LEFT\"]\n  ACTION_RIGHT = action_map[\"RIGHT\"]\n\n  current_state = env._current_state\n  primitive_idx = env.world.cookbook.index[primitive] # Get integer ID for the primitive\n\n  # If the agent is already next to the primitive, simply use it.\n  if current_state.next_to(primitive_idx):\n    return [ACTION_USE]\n\n  grid = current_state.grid\n  # Grid dimensions are (height, width, n_kinds) in numpy, but often referred as (WIDTH, HEIGHT) in problems.\n  # Let's use (rows, cols) to avoid confusion with WIDTH/HEIGHT definitions.\n  ROWS, COLS, _ = grid.shape\n  start_pos = current_state.pos\n\n  # BFS setup: queue stores (current_coordinates, full_path_of_coordinates_to_reach_here)\n  q = collections.deque([(start_pos, [start_pos])])\n  visited = {start_pos}\n\n  # This will store the shortest path of coordinates (including start_pos)\n  # to a cell from which the primitive can be 'USE'd.\n  path_to_adjacent_cell = None\n\n  # Possible movements (dr, dc) for UP, DOWN, LEFT, RIGHT\n  move_deltas = [(-1, 0), (1, 0), (0, -1), (0, 1)] # (row_change, col_change)\n\n  while q:\n    (r, c), path_coords = q.popleft()\n\n    # Check if the current cell (r, c) is adjacent to the primitive\n    for dr, dc in move_deltas:\n      nr, nc = r + dr, c + dc # Neighboring cell\n      if 0 <= nr < ROWS and 0 <= nc < COLS:\n        # If the neighboring cell contains the primitive\n        if grid[nr, nc, primitive_idx] > 0:\n          # We found a primitive at (nr, nc) and (r, c) is adjacent to it.\n          # The path_coords already contains (r, c) as its last element.\n          # This is the path we need for the agent to reach a position to 'USE'.\n          path_to_adjacent_cell = path_coords\n          break # Found the target, stop exploring this node's neighbors\n    \n    if path_to_adjacent_cell:\n      break # Found the shortest path to an adjacent cell, exit BFS\n\n    # If not adjacent to primitive yet, explore neighbors for further BFS\n    for dr, dc in move_deltas:\n      next_r, next_c = r + dr, c + dc\n      next_pos = (next_r, next_c)\n\n      if 0 <= next_r < ROWS and 0 <= next_c < COLS and next_pos not in visited:\n        visited.add(next_pos)\n        # Add next_pos to the path and enqueue it\n        q.append((next_pos, path_coords + [next_pos]))\n\n  # If no path was found (e.g., primitive not on grid or unreachable)\n  if not path_to_adjacent_cell:\n    return []\n\n  # Convert the coordinate path into a list of actions\n  actions = []\n  # Iterate through the path to generate movement actions\n  # path_to_adjacent_cell[0] is start_pos, path_to_adjacent_cell[-1] is the target adjacent cell.\n  for i in range(len(path_to_adjacent_cell) - 1):\n    current_agent_r, current_agent_c = path_to_adjacent_cell[i]\n    next_agent_r, next_agent_c = path_to_adjacent_cell[i+1]\n\n    if next_agent_r > current_agent_r:\n      actions.append(ACTION_DOWN)\n    elif next_agent_r < current_agent_r:\n      actions.append(ACTION_UP)\n    elif next_agent_c > current_agent_c:\n      actions.append(ACTION_RIGHT)\n    elif next_agent_c < current_agent_c:\n      actions.append(ACTION_LEFT)\n  \n  # After moving to the cell adjacent to the primitive, perform the USE action\n  actions.append(ACTION_USE)\n\n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T10:37:27.414296", "function_name": "collect", "function_body": "  # Get current state from the environment\n  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # Get indices for the primitive and boundary\n  i_primitive = cookbook.index(primitive)\n  i_boundary = cookbook.index(\"BOUNDARY\")\n\n  # Get grid dimensions and current position\n  grid = state.grid\n  WIDTH, HEIGHT, _ = grid.shape\n  start_pos = state.pos\n\n  # Get action mappings\n  actions = env.action_specs()\n  ACTION_UP = actions[\"UP\"]\n  ACTION_DOWN = actions[\"DOWN\"]\n  ACTION_LEFT = actions[\"LEFT\"]\n  ACTION_RIGHT = actions[\"RIGHT\"]\n  ACTION_USE = actions[\"USE\"]\n\n  # Determine if the primitive is grabbable\n  is_primitive_grabbable = i_primitive in world.grabbable_indices\n\n  # BFS queue: stores (current_position (tuple), list_of_actions_to_reach_here)\n  # Assuming `collections.deque` is available in the execution environment.\n  q = collections.deque([(start_pos, [])])\n  # Visited set: stores (x, y) coordinates to avoid cycles and redundant paths\n  visited = {start_pos}\n\n  # Possible movement directions (dx, dy) and corresponding actions\n  # (dx, dy, action_id)\n  move_dirs_and_actions = [\n      (0, -1, ACTION_UP),    # Move up (decreases y)\n      (0, 1, ACTION_DOWN),   # Move down (increases y)\n      (-1, 0, ACTION_LEFT),  # Move left (decreases x)\n      (1, 0, ACTION_RIGHT)   # Move right (increases x)\n  ]\n\n  # Helper function to check if a kind is present in the 3x3 neighborhood (including center)\n  # This mimics the behavior of CraftState.next_to(i_kind)\n  def _is_kind_present_in_neighborhood(check_pos, target_kind_idx, current_grid):\n      cx, cy = check_pos\n      grid_width, grid_height, _ = current_grid.shape\n      \n      for dx_adj in [-1, 0, 1]:\n          for dy_adj in [-1, 0, 1]:\n              nx_adj, ny_adj = cx + dx_adj, cy + dy_adj\n              if 0 <= nx_adj < grid_width and 0 <= ny_adj < grid_height:\n                  if current_grid[nx_adj, ny_adj, target_kind_idx] == 1:\n                      return True\n      return False\n\n  # Perform BFS\n  while q:\n      current_pos, current_actions = q.popleft()\n      cx, cy = current_pos\n\n      # Check if the current position is within interaction range of the primitive\n      if _is_kind_present_in_neighborhood(current_pos, i_primitive, grid):\n          if is_primitive_grabbable:\n              # If the primitive is grabbable, add a USE action to collect it\n              return current_actions + [ACTION_USE]\n          else:\n              # If not grabbable (e.g., workshop, water), just reaching vicinity is enough\n              return current_actions\n      \n      # Explore neighbors\n      for dx, dy, action in move_dirs_and_actions:\n          next_x, next_y = cx + dx, cy + dy\n          next_pos = (next_x, next_y)\n\n          # Check if the next position is within grid bounds\n          if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n              continue\n          \n          # Check walkability: cannot walk through a boundary\n          # grid[x, y, i_boundary] == 1 means there's a boundary block\n          if grid[next_x, next_y, i_boundary] == 1:\n              continue # Impassable terrain\n          \n          # If the next position has not been visited, add it to the queue\n          if next_pos not in visited:\n              visited.add(next_pos)\n              q.append((next_pos, current_actions + [action]))\n\n  # If the queue is exhausted and no path to the primitive was found\n  return []", "island_id": 6, "scores": {"3": -1}}
