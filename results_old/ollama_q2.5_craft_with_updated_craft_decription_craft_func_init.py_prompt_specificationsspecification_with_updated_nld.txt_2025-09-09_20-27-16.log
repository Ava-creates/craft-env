{"timestamp": "2025-09-10T17:26:48.415691", "function_name": "craft", "function_body": "  # Get index from item name\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the goal has a recipe in the cookbook\n  if item_index not in env.world.cookbook.recipes:\n    print(f\"No recipe found for {item}\")\n    return []\n\n  # Get the required ingredients and workshop from the recipe\n  recipe = env.world.cookbook.recipes[item_index]\n  required_ingredients = {k: v for k, v in recipe.items() if k != \"_at\"}\n  workshop_name = recipe[\"_at\"]\n\n  # Find the index of the workshop\n  workshop_indices = [env.world.cookbook.index[workshop] for workshop in env.world.workshop_indices]\n  try:\n    workshop_index = env.world.cookbook.index[workshop_name]\n  except KeyError:\n    print(f\"Workshop {workshop_name} not found.\")\n    return []\n\n  # Check if the agent has all required ingredients\n  current_inventory = env._current_state.inventory\n  for ingredient, count in required_ingredients.items():\n    if current_inventory[ingredient] < count:\n      print(f\"Not enough {env.world.cookbook.index.get(ingredient)} to craft {item}\")\n      return []\n\n  # Find the position of the workshop on the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n  if workshop_positions.size == 0:\n    print(f\"No {workshop_name} found on the grid.\")\n    return []\n\n  # Choose a random available workshop position to go to\n  target_workshop_position = tuple(workshop_positions[env.world.random.randint(workshop_positions.shape[0])])\n\n  # Plan the path to reach the workshop\n  actions_to_reach_workshop = navigate_to(env, target_workshop_position)\n\n  # Navigate to the chosen workshop and face it\n  if not actions_to_reach_workshop:\n    print(\"Could not find a path to the workshop.\")\n    return []\n\n  actions_to_face_workshop = orient_towards(env._current_state.pos, target_workshop_position, env._current_state.dir)\n  \n  # Craft the item by using the USE action at the workshop\n  craft_action = [craft.env.ACTIONS[\"USE\"]]\n\n  # Combine all actions into a list\n  return actions_to_reach_workshop + actions_to_face_workshop + craft_action", "island_id": 9, "scores": {"3": -1}}
