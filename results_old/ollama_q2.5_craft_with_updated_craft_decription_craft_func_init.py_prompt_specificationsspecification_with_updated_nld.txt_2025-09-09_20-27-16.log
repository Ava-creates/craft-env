ions.append(env.world.cookbook.index[\"MOVE_FUNC_\" + direction])\n\n  # Then move vertically\n  while env._current_state.pos[0] != target_x:\n    direction = \"DOWN\" if env._current_state.pos[0] < target_x else \"UP\"\n    actions.append(env.world.cookbook.index[\"MOVE_FUNC_\" + direction])\n\n  # Now face the workshop and use it to craft the item\n  final_direction = (target_y - env._current_state.pos[1], target_x - env._current_state.pos[0])\n  if final_direction == (0, 1):\n    actions.append(env.world.cookbook.index[\"MOVE_FUNC_RIGHT\"])\n  elif final_direction == (0, -1):\n    actions.append(env.world.cookbook.index[\"MOVE_FUNC_LEFT\"])\n  elif final_direction == (1, 0):\n    actions.append(env.world.cookbook.index[\"MOVE_FUNC_DOWN\"])\n  elif final_direction == (-1, 0):\n    actions.append(env.world.cookbook.index[\"MOVE_FUNC_UP\"])\n\n  # Finally, use the workshop to craft the item\n  actions.append(env.world.cookbook.index[\"USE_FUNC\"])\n  \n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T03:00:47.453493", "function_name": "craft", "function_body": "  # Get the index for the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Retrieve the recipe for the item\n  recipe = env.world.cookbook.recipes[item_index]\n  \n  # Calculate the primitives required to craft the item\n  required_primitives = {}\n  for ingredient, count in recipe.items():\n      if ingredient != \"_key\":\n          required_primitives[ingredient] = count\n\n  # Check if we have all the required primitives in our inventory\n  current_inventory = env._current_state.inventory\n  for ingredient_index, count in required_primitives.items():\n    if current_inventory[ingredient_index] < count:\n        return []\n\n  # Determine which workshop to go to based on the recipe key\n  workshop_key = recipe[\"_key\"]\n  \n  # Find all workshops of the required type in the grid\n  workshop_indices = env.world.workshop_indices\n  target_workshop_index = None\n\n  for idx, workshop_type in enumerate(env.world.cookbook.index.get):\n      if workshop_key == workshop_type:\n          target_workshop_index = workshop_indices[idx]\n          break\n\n  if target_workshop_index is None:\n    return []\n\n  # Convert target_workshop_index to coordinates\n  grid_shape = env._current_state.grid.shape[:2]\n  target_workshop_coords = np.unravel_index(target_workshop_index, grid_shape)\n\n  # Calculate the actions needed to move to the workshop\n  actions_to_move_to_workshop = move_towards(env._current_state.pos, target_workshop_coords)\n  \n  # Add USE action to craft the item at the workshop\n  actions_to_craft_item = [env.world.cookbook.index[\"USE\"]]\n  \n  return actions_to_move_to_workshop + actions_to_craft_item", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-10T03:00:48.449673", "function_name": "craft", "function_body": "  actions = []\n\n  # Convert the item name to its index in the cookbook\n  item_index = env.world.cookbook.index[item]\n\n  # Get the recipe for the item (the ingredients required and where to craft it)\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Check if we have all the ingredients needed to craft the item\n  inventory = env._current_state.inventory\n  workshop_index = None\n\n  # Find out which workshop is required for crafting\n  for ingredient, count in recipe.items():\n      if ingredient == \"_key\":\n          workshop_index = env.world.cookbook.index[recipe[\"_key\"]]\n          continue\n      \n      if inventory[env.world.cookbook.index[ingredient]] < count:\n          return []  # Not enough ingredients to craft the item\n\n  # If we have all the ingredients, proceed to the workshop and use the USE action\n  target_workshop_position = None\n  for pos in env._current_state.grid.nonzero()[0:2]:\n      if env._current_state.grid[pos[0], pos[1]][workshop_index] > 0:\n          target_workshop_position = (pos[0], pos[1])\n          break\n\n  # If we found the workshop, move to it and use the USE action\n  if target_workshop_position is not None:\n      actions.extend(move_to_target(env._current_state, target_workshop_position))\n      actions.append(craft.USE)  # Craft the item at the workshop\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-10T03:02:30.829037", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = env._current_state.inventory.copy()\n\n  # Check if all ingredients are available\n  required_ingredients = {cookbook.index[k]: v for k, v in recipe.items()}\n\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if not can_craft:\n    return []\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No available workshop to craft item\")\n\n  # Select the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n  # Calculate actions to move the agent to the nearest workshop\n  target_position = np.array(nearest_workshop_pos)\n  current_position = np.array(env._current_state.pos)\n  \n  delta = target_position - current_position\n\n  actions_to_take = []\n\n  def add_move_actions(dx, dy):\n    if dx > 0:\n      actions_to_take.extend([craft.MOVE_RIGHT for _ in range(dx)])\n    elif dx < 0:\n      actions_to_take.extend([craft.MOVE_LEFT for _ in range(-dx)])\n\n    if dy > 0:\n      actions_to_take.extend([craft.MOVE_DOWN for _ in range(dy)])", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T03:02:31.894071", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = env._current_state.inventory.copy()\n\n  # Check if all ingredients are available\n  required_ingredients = {cookbook.index[k]: v for k, v in recipe.items()}\n\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if not can_craft:\n    return []\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No available workshop to craft item\")\n\n  # Select the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n  # Calculate actions to move the agent to the nearest workshop\n  dx = nearest_workshop_pos[0] - current_position[0]\n  dy = nearest_workshop_pos[1] - current_position[1]\n\n  actions_to_take = []\n\n  if dx > 0:\n    actions_to_take.extend([craft.MOVE_RIGHT for _ in range(dx)])\n  elif dx < 0:\n    actions_to_take.extend([craft.MOVE_LEFT for _ in range(-dx)])\n\n  if dy > 0:\n    actions_to_take.extend([craft.MOVE_DOWN for _ in range(dy)])\n  elif dy < 0:\n    actions_to_take.extend([craft.MOVE_UP for _ in range(-dy)])\n\n  # Calculate the target direction to face the workshop\n  current_direction = env._current_state.dir\n\n  if dx == 0 and dy == 0:  # Already at the workshop\n      pass\n  elif abs(dx) >= abs(dy):\n      target_direction = craft.RIGHT if dx > 0 else craft.LEFT\n  else:\n      target_direction = craft.DOWN if dy > 0 else craft.UP\n\n  while current_direction != target_direction:\n    actions_to_take.append(craft.TURN_RIGHT)\n    current_direction = (current_direction + 1) % 4\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T03:04:23.798733", "function_name": "craft", "function_body": "  def get_workshop_position(state, workshop_index):\n      workshop_indices = state.world.workshop_indices\n      if workshop_index >= len(workshop_indices):\n          return None\n      \n      for y in range(state.grid.shape[1]):\n          for x in range(state.grid.shape[0]):\n              if state.grid[x, y, workshop_indices[workshop_index]] == 1:\n                  return (x, y)\n      return None\n\n  def check_and_collect_primitives(state, recipe):\n      actions = []\n      for ingredient_idx, count in recipe.items():\n          while state.inventory[ingredient_idx] < count:\n              collect_actions = collect(env, state.world.cookbook.index.get(ingredient_idx))\n              if not collect_actions:\n                  return [], False\n              actions.extend(collect_actions)\n          \n          if state.inventory[ingredient_idx] < count:\n              return [], False  # Could not collect all required primitives\n      return actions, True\n\n  def move_to(state, target_position):\n      actions = []\n      # Simple BFS to find the path to the target position\n      queue = collections.deque([(state.pos, [])])\n      visited = set()\n      directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n      \n      while queue:\n          current_pos, path = queue.popleft()\n          \n          if current_pos == target_position:\n              return path\n          \n          if current_pos in visited:\n              continue\n          visited.add(current_pos)\n          \n          for dx, dy in directions:\n              next_x, next_y = current_pos[0] + dx, current_pos[1] + dy\n              \n              if (0 <= next_x < state.grid.shape[0]) and (0 <= next_y < state.grid.shape[1]):\n                  queue.append(((next_x, next_y), path + [move_to_direction(current_pos, (next_x, next_y))]))\n      \n      return []  # No path found\n\n  def move_to_direction(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n      \n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      else:\n          return 0  # DOWN\n\n  actions = []\n  \n  # Get the index for the desired item from the cookbook\n  item_idx = env.world.cookbook.index[item]\n  \n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_idx, {})\n  \n  if not recipe:\n    return []  # No recipe found\n  \n  # Determine the workshop where the crafting should happen\n  workshop_key = \"_key\"\n  workshop_index = int(recipe.pop(workshop_key, -1))\n  \n  if workshop_index == -1:\n    return []  # Workshop not specified in the recipe\n\n  # Get the target position for the workshop\n  target_workshop_pos = get_workshop_position(env._current_state, workshop_index)\n  \n  if target_workshop_pos is None:\n    return []  # Workshop position not found in the grid\n\n  # Check and collect all required primitives\n  actions, success = check_and_collect_primitives(env._current_state, recipe)\n  \n  if not success:\n    return []  # Could not collect all required primitives\n  \n  # Move to the target workshop\n  actions.extend(move_to(env._current_state, target_workshop_pos))\n  \n  # Perform the USE action at the workshop\n  actions.append(4)  # USE action index\n\n  # Verify if item is crafted by checking inventory\n  if env._current_state.inventory[item_idx] == 0:\n    return []  # Crafting failed\n  \n  return actions", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T03:04:24.832241", "function_name": "craft", "function_body": "  def get_workshop_position(state, workshop_index):\n      workshop_indices = state.world.workshop_indices\n      if workshop_index >= len(workshop_indices):\n          return None\n      \n      for y in range(state.grid.shape[1]):\n          for x in range(state.grid.shape[0]):\n              if state.grid[x, y, workshop_indices[workshop_index]] == 1:\n                  return (x, y)\n      return None\n\n  def check_and_collect_primitives(state, recipe):\n      actions = []\n      for ingredient_idx, count in recipe.items():\n          while state.inventory[ingredient_idx] < count:\n              collect_actions = collect(env, state.world.cookbook.index.get(ingredient_idx))\n              if not collect_actions:\n                  return [], False  # Could not collect the required primitive\n              actions.extend(collect_actions)\n          \n          if state.inventory[ingredient_idx] < count:\n              return [], False  # Could not collect all required primitives\n      return actions, True\n\n  def move_to(state, target_position):\n      actions = []\n      # Simple BFS to find the path to the target position\n      queue = collections.deque([(state.pos, [])])\n      visited = set()\n      directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n      \n      while queue:\n          current_pos, path = queue.popleft()\n          \n          if current_pos == target_position:\n              return path\n          \n          if current_pos in visited:\n              continue\n          visited.add(current_pos)\n          \n          for dx, dy in directions:\n              next_x, next_y = current_pos[0] + dx, current_pos[1] + dy\n              \n              if (0 <= next_x < state.grid.shape[0]) and (0 <= next_y < state.grid.shape[1]):\n                  queue.append(((next_x, next_y), path + [move_to_direction(current_pos, (next_x, next_y))]))\n      \n      return []  # No path found\n\n  def move_to_direction(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n      \n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      else:\n          return 0  # DOWN\n\n  actions = []\n  \n  # Get the index for the desired item from the cookbook\n  item_idx = env.world.cookbook.index[item]\n  \n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_idx, {})\n  \n  if not recipe:\n    return []  # No recipe found\n  \n  # Determine the workshop where the crafting should happen\n  workshop_key = \"_key\"\n  workshop_index = int(recipe.pop(workshop_key, -1))\n  \n  if workshop_index == -1:\n    return []  # Workshop not specified in the recipe\n\n  # Get the target position for the workshop\n  target_workshop_pos = get_workshop_position(env._current_state, workshop_index)\n  \n  if target_workshop_pos is None:\n    return []  # Workshop position not found in the grid\n\n  # Check and collect all required primitives\n  actions, success = check_and_collect_primitives(env._current_state, recipe)\n  \n  if not success:\n    return []  # Could not collect all required primitives\n  \n  # Move to the target workshop\n  actions.extend(move_to(env._current_state, target_workshop_pos))\n  \n  # Perform the USE action at the workshop\n  actions.append(4)  # USE action index\n\n  # Verify if item is crafted by checking inventory\n  if env._current_state.inventory[item_idx] == 0:\n    return []  # Crafting failed\n  \n  return actions", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T03:06:32.685489", "function_name": "craft", "function_body": "  def move_to_workshop(state, workshop_index):\n    pos = state.pos\n    grid = state.grid\n\n    # Find the closest workshop in the grid.\n    workshops = [(x, y) for x in range(grid.shape[0]) \n                 for y in range(grid.shape[1]) if grid[x, y, workshop_index] > 0]\n    if not workshops:\n      return []\n\n    # Choose the nearest workshop.\n    target_x, target_y = min(workshops, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n    return move_to_position(pos, (target_x, target_y))\n\n  def move_to_position(current_pos, target_pos):\n    actions = []\n    cx, cy = current_pos\n    tx, ty = target_pos\n\n    # Calculate the difference in position.\n    dx = tx - cx\n    dy = ty - cy\n\n    # Determine direction of movement.\n    if dx > 0:\n      actions.extend([craft.ACTION_RIGHT] * abs(dx))\n    elif dx < 0:\n      actions.extend([craft.ACTION_LEFT] * abs(dx))\n\n    if dy > 0:\n      actions.extend([craft.ACTION_DOWN] * abs(dy))\n    elif dy < 0:\n      actions.extend([craft.ACTION_UP] * abs(dy))\n\n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the desired item is a primitive; primitives cannot be crafted.\n  if item_index in env.world.cookbook.primitives:\n    return []\n\n  # Fetch the recipe for crafting the specified item.\n  recipe = env.world.cookbook.recipes.get(item_index)\n\n  # If no valid recipe exists or \"_key\" not specified, return an empty action list.\n  if not recipe or \"_key\" not in recipe:\n    return []\n\n  workshop_key = recipe[\"_key\"]\n  workshop_index = env.world.cookbook.index[workshop_key]\n\n  actions = []\n  state = env._current_state\n\n  # Check inventory for sufficient primitives.\n  missing_ingredients = {}\n  for ingredient, count in recipe.items():\n    if ingredient == \"_key\":\n      continue\n    ingredient_index = env.world.cookbook.index[ingredient]\n    current_count = state.inventory[ingredient_index]\n    if current_count < count:\n      missing_ingredients[ingredient] = count - current_count\n\n  # If any ingredients are missing, attempt to collect them.\n  for ingredient, required_count in missing_ingredients.items():\n    ingredient_index = env.world.cookbook.index[ingredient]\n    actions.extend(collect_v4(env, ingredient, required_count))\n\n  # Move to a workshop that can craft the item.\n  actions.extend(move_to_workshop(state, workshop_index))\n\n  # Use the USE action at the correct location.\n  actions.append(craft.ACTION_USE)\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T03:06:33.823898", "function_name": "craft", "function_body": "  def move_to_position(current_pos, target_pos):\n    current_x, current_y = current_pos\n    target_x, target_y = target_pos\n\n    # Compute the steps needed to reach the target position.\n    if current_x < target_x:\n      actions.extend([craft.ACTION_RIGHT] * (target_x - current_x))\n    elif current_x > target_x:\n      actions.extend([craft.ACTION_LEFT] * (current_x - target_x))\n\n    if current_y < target_y:\n      actions.extend([craft.ACTION_DOWN] * (target_y - current_y))\n    elif current_y > target_y:\n      actions.extend([craft.ACTION_UP] * (current_y - target_y))\n\n  def move_to_workshop(state, workshop_index):\n    pos = state.pos\n    grid = state.grid\n\n    # Find the closest workshop in the grid.\n    workshops = [(x, y) for x in range(grid.shape[0]) \n                 for y in range(grid.shape[1]) if grid[x, y, workshop_index] > 0]\n    if not workshops:\n      return []\n\n    # Choose the nearest workshop.\n    target_x, target_y = min(workshops, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n\n    # Move to the position adjacent to the workshop where the agent can face it and perform USE action.\n    move_to_position(pos, (target_x, target_y))\n\n    # Turn to face the workshop.\n    if state.pos == (target_x - 1, target_y):\n      actions.append(craft.ACTION_RIGHT)\n    elif state.pos == (target_x + 1, target_y):\n      actions.append(craft.ACTION_LEFT)\n    elif state.pos == (target_x, target_y - 1):\n      actions.append(craft.ACTION_DOWN)\n    elif state.pos == (target_x, target_y + 1):\n      actions.append(craft.ACTION_UP)\n\n  def collect_v4(env, primitive, count) -> list[int]:\n    \"\"\"Collects the specified amount of primitives.\"\"\"\n    actions = []\n    item_index = env.world.cookbook.index[primitive]\n    while state.inventory[item_index] < count:\n      # Find the closest available primitive in the grid.\n      items = [(x, y) for x in range(grid.shape[0]) \n               for y in range(grid.shape[1]) if grid[x, y, item_index] > 0]\n      if not items:\n        return []  # No more primitives of this type are available.\n\n      # Choose the nearest primitive.\n      target_x, target_y = min(items, key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))\n\n      # Move to and collect the primitive.\n      move_to_position(state.pos, (target_x, target_y))\n      actions.append(craft.ACTION_USE)\n\n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the desired item is a primitive; primitives cannot be crafted.\n  if item_index in env.world.cookbook.primitives:\n    return []\n\n  # Fetch the recipe for crafting the specified item.\n  recipe = env.world.cookbook.recipes.get(item_index)\n\n  # If no valid recipe exists or \"_key\" not specified, return an empty action list.\n  if not recipe or \"_key\" not in recipe:\n    return []\n\n  workshop_key = recipe[\"_key\"]\n  workshop_index = env.world.cookbook.index[workshop_key]\n\n  actions = []\n  state = env._current_state\n  grid = state.grid\n\n  # Check inventory for sufficient primitives.\n  missing_ingredients = {}\n  for ingredient, count in recipe.items():\n    if ingredient == \"_key\":\n      continue\n    ingredient_index = env.world.cookbook.index[ingredient]\n    current_count = state.inventory[ingredient_index]\n    if current_count < count:\n      missing_ingredients[ingredient] = count - current_count\n\n  # If any ingredients are missing, attempt to collect them.\n  for ingredient, required_count in missing_ingredients.items():\n    ingredient_index = env.world.cookbook.index[ingredient]\n    actions.extend(collect_v4(env, ingredient, required_count))\n\n  # Move to a workshop that can craft the item.\n  actions.extend(move_to_workshop(state, workshop_index))\n\n  # Use the USE action at the correct location.\n  actions.append(craft.ACTION_USE)\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T03:08:09.462982", "function_name": "craft", "function_body": "  # Get the index of the desired item from the cookbook's index\n  item_idx = env.world.cookbook.index[item]\n\n  # Check if the desired item has a recipe in the cookbook.\n  if item_idx not in env.world.cookbook.recipes:\n    print(f\"No recipe found for {item}.\")\n    return []\n\n  # Get the required ingredients and workshop from the recipe\n  recipe = env.world.cookbook.recipes[item_idx]\n  required_ingredients = {ingredient: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n\n  # Check if we have all the required primitives or items already in our inventory.\n  missing_items = {}\n  for ingredient, count in required_ingredients.items():\n    ingredient_idx = env.world.cookbook.index.get(ingredient)\n    if ingredient_idx is not None:\n      if env._current_state.inventory[ingredient_idx] < count:\n        missing_items[ingredient] = count - env._current_state.inventory[ingredient_idx]\n    else:\n      print(f\"Ingredient {ingredient} not found in cookbook index.\")\n      return []\n\n  # If we have all the required items, proceed to craft the item.\n  if not missing_items:\n    # Get the workshop name and its corresponding index\n    workshop_name = recipe[\"_at\"]\n    workshop_idx = env.world.cookbook.index.get(workshop_name)\n    \n    # Find the nearest available workshop of the specified type in the grid.\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx] > 0)\n\n    if workshop_positions.size == 0:\n      print(f\"No {workshop_name} found on the map.\")\n      return []\n\n    # Sort workshops by distance to the agent's current position\n    distances = np.linalg.norm(workshop_positions - env._current_state.pos, axis=1)\n    nearest_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n\n    actions_to_take = []\n    \n    # Navigate to the nearest workshop.\n    while env._current_state.pos != nearest_workshop_pos:\n      # Calculate the direction to move towards the workshop\n      dx, dy = nearest_workshop_pos[0] - env._current_state.pos[0], nearest_workshop_pos[1] - env._current_state.pos[1]\n      if abs(dx) > abs(dy):\n          action = 2 if dx < 0 else 3\n      else:\n          action = 1 if dy < 0 else 0\n      actions_to_take.append(action)\n      \n      # Perform the action and update the state\n      reward, done, observations = env.step(action)\n      env._current_state = observations[\"state\"]\n\n    # Turn to face the workshop before using it.\n    direction_to_workshop = (nearest_workshop_pos[0] - env._current_state.pos[0], nearest_workshop_pos[1] - env._current_state.pos[1])\n    if direction_to_workshop == (-1, 0):\n        actions_to_take.append(2)  # LEFT\n    elif direction_to_workshop == (1, 0):\n        actions_to_take.append(3)  # RIGHT\n    elif direction_to_workshop == (0, -1):\n        actions_to_take.append(1)  # UP\n    elif direction_to_workshop == (0, 1):\n        actions_to_take.append(0)  # DOWN\n\n    # Use the workshop to craft the item.\n    actions_to_take.append(4)  # USE\n    \n    return actions_to_take\n  \n  else:\n    print(f\"Missing items: {missing_items}\")\n    return []", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-10T03:08:10.449244", "function_name": "craft", "function_body": "  actions = []\n\n  # Get the index of the item to craft\n  goal_index = env.world.cookbook.index[item]\n\n  # Check if we have all required primitives for crafting\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n\n  if not required_primitives:\n    return []  # No recipe found for this item\n\n  # Collect the required primitives if not already in inventory\n  for primitive_index, count in required_primitives.items():\n    while env._current_state.inventory[primitive_index] < count:\n      actions.extend(collect_v2(env, primitive_index))\n\n  # Find the workshop that can craft this item\n  workshop_index = None\n  recipe = env.world.cookbook.recipes[goal_index]\n  for key in recipe.keys():\n    if key.startswith(\"_at\"):\n      workshop_index = getattr(env.world, key.split('_')[1] + \"_index\")\n      break\n\n  if not workshop_index:\n    return []  # No valid workshop found\n\n  # Move to the workshop\n  actions.extend(move_to_workshop_v2(env, workshop_index))\n\n  # Craft the item at the workshop\n  actions.append(env.world.n_actions - 1)  # Assuming USE action is the last one\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-10T03:09:50.027563", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  index_dict = cookbook.index.reverse_contents\n  item_index = cookbook.index[item]\n  \n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = env._current_state.inventory.copy()\n\n  # Check if all ingredients are available\n  required_ingredients = {cookbook.index[k]: v for k, v in recipe.items()}\n\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if not can_craft:\n    return []\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No available workshop to craft item\")\n\n  # Select the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n  # Calculate actions to move the agent to the nearest workshop\n  dx = nearest_workshop_pos[0] - current_position[0]\n  dy = nearest_workshop_pos[1] - current_position[1]\n\n  actions_to_take = []\n\n  if dx > 0:\n    actions_to_take.extend([craft.MOVE_RIGHT for _ in range(dx)])\n  elif dx < 0:\n    actions_to_take.extend([craft.MOVE_LEFT for _ in range(-dx)])\n\n  if dy > 0:\n    actions_to_take.extend([craft.MOVE_DOWN for _ in range(dy)])\n  elif dy < 0:\n    actions_to_take.extend([craft.MOVE_UP for _ in range(-dy)])\n\n  # Calculate the target direction to face the workshop\n  current_direction = env._current_state.dir\n\n  if dx == 0 and dy == 0:  # Already at the workshop\n      pass\n  elif dx > 0:\n      while current_direction != craft.RIGHT:\n          actions_to_take.append(craft.TURN_RIGHT)\n          current_direction = (current_direction + 1) % 4\n  elif dx < 0:\n      while current_direction != craft.LEFT:\n          actions_to_take.append(craft.TURN_LEFT)\n          current_direction = (current_direction - 1) % 4\n  elif dy > 0:\n      while current_direction != craft.DOWN:\n          actions_to_take.append(craft.TURN_RIGHT)\n          current_direction = (current_direction + 1) % 4\n  elif dy < 0:\n      while current_direction != craft.UP:\n          actions_to_take.append(craft.TURN_LEFT)\n          current_direction = (current_direction - 1) % 4\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T03:09:51.078909", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = env._current_state.inventory.copy()\n\n  # Check if all ingredients are available\n  required_ingredients = {cookbook.index[k]: v for k, v in recipe.items()}\n\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if not can_craft:\n    return []\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No available workshop to craft item\")\n\n  # Select the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n  # Calculate actions to move the agent to the nearest workshop\n  dx = nearest_workshop_pos[0] - current_position[0]\n  dy = nearest_workshop_pos[1] - current_position[1]\n\n  actions_to_take = []\n\n  if dx > 0:\n    actions_to_take.extend([craft.MOVE_RIGHT for _ in range(dx)])\n  elif dx < 0:\n    actions_to_take.extend([craft.MOVE_LEFT for _ in range(-dx)])\n\n  if dy > 0:\n    actions_to_take.extend([craft.MOVE_DOWN for _ in range(dy)])\n  elif dy < 0:\n    actions_to_take.extend([craft.MOVE_UP for _ in range(-dy)])\n\n  # Calculate the target direction to face the workshop\n  current_direction = env._current_state.dir\n\n  if dx == 0 and dy == 0:  # Already at the workshop\n      pass\n  else:\n      # Determine the desired direction based on the position difference\n      if abs(dx) > abs(dy):\n          target_direction = craft.RIGHT if dx > 0 else craft.LEFT\n      else:\n          target_direction = craft.DOWN if dy > 0 else craft.UP\n\n      # Turn to face the workshop\n      while current_direction != target_direction:\n          if (current_direction + 1) % 4 == target_direction:\n              actions_to_take.append(craft.TURN_RIGHT)\n          elif (current_direction - 1) % 4 == target_direction:\n              actions_to_take.append(craft.TURN_LEFT)\n          current_direction = (current_direction + 1) % 4 if actions_to_take[-1] == craft.TURN_RIGHT else (current_direction - 1) % 4\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T03:10:35.622389", "function_name": "craft", "function_body": "  # Convert item name to index\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the recipe for the desired item\n  recipe = env.world.cookbook.recipes.get(item_index)\n  \n  if not recipe:\n    print(f\"No recipe found for {item}.\")\n    return []\n  \n  actions = []\n  \n  # Check if we have all the ingredients in our inventory\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  current_inventory = env._current_state.inventory\n  \n  for prim, count in required_primitives.items():\n    while current_inventory[prim] < count:\n      # Find where to collect primitives\n      actions.extend(collect(env, env.world.cookbook.index.get(prim)))\n      \n      # Update inventory after collecting\n      current_inventory = env._current_state.inventory\n  \n  # Move to the correct workshop and use it to craft the item\n  for ingredient, _ in recipe.items():\n    if \"_at\" in ingredient:\n      workshop_name = recipe[ingredient]\n      break\n  \n  workshop_index = env.world.cookbook.index.get(workshop_name)\n  \n  if not workshop_index or workshop_index not in env.world.workshop_indices:\n    print(f\"No valid workshop found for {item}.\")\n    return []\n  \n  # Actions to move to the workshop\n  actions.extend(move(env, workshop_index))\n  \n  # Action to use the workshop\n  actions.append(craft.USE)\n  \n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-10T03:10:36.598725", "function_name": "craft", "function_body": "  # Initialize actions list\n  actions = []\n\n  # Get the index of the goal item\n  goal_index = env.world.cookbook.index[item]\n\n  # Check if we already have the item in inventory\n  if env._current_state.inventory[goal_index] > 0:\n    return actions\n\n  # Get the primitives required for crafting the goal item\n  primitives_required = env.world.cookbook.primitives_for(goal_index)\n\n  # Collect all primitives required\n  for primitive, count in primitives_required.items():\n    for _ in range(count):\n      primitive_name = env.world.cookbook.index.get(primitive)\n      actions.extend(collect(env, primitive_name))\n\n  # Find the workshop index and position where crafting can occur\n  workshop_index = None\n  recipe = env.world.cookbook.recipes[goal_index]\n  for key in recipe:\n    if key.startswith(\"_at\"):\n      workshop_index = env.world.cookbook.index[recipe[key]]\n\n  if workshop_index is None:\n    raise ValueError(\"Workshop index not found in the recipe.\")\n\n  # Find the position of the workshop\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(\"No valid workshop position found on the grid.\")\n  \n  closest_workshop_position = min(workshop_positions, key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1]))\n\n  # Move to the workshop\n  actions.extend(move_to(env, closest_workshop_position))\n\n  # Rotate to face the workshop\n  actions.append(4)  # USE action to craft\n\n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-10T03:12:30.773535", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = env._current_state.inventory.copy()\n\n  # Check if all ingredients are available\n  required_ingredients = {cookbook.index[k]: v for k, v in recipe.items()}\n\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if not can_craft:\n    return []\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No available workshop to craft item\")\n\n  # Select the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n  # Calculate actions to move the agent to the nearest workshop\n  dx = nearest_workshop_pos[0] - current_position[0]\n  dy = nearest_workshop_pos[1] - current_position[1]\n\n  actions_to_take = []\n\n  if abs(dx) > abs(dy):\n      # Move along X axis first\n      if dx > 0:\n          actions_to_take.extend([craft.MOVE_RIGHT for _ in range(dx)])\n      else:\n          actions_to_take.extend([craft.MOVE_LEFT for _ in range(-dx)])\n      \n      # Then move along Y axis\n      if dy > 0:\n          actions_to_take.extend([craft.MOVE_DOWN for _ in range(dy)])\n      elif dy < 0:\n          actions_to_take.extend([craft.MOVE_UP for _ in range(-dy)])\n  else:\n      # Move along Y axis first\n      if dy > 0:\n          actions_to_take.extend([craft.MOVE_DOWN for _ in range(dy)])\n      elif dy < 0:\n          actions_to_take.extend([craft.MOVE_UP for _ in range(-dy)])\n      \n      # Then move along X axis\n      if dx > 0:\n          actions_to_take.extend([craft.MOVE_RIGHT for _ in range(dx)])\n      else:\n          actions_to_take.extend([craft.MOVE_LEFT for _ in range(-dx)])\n\n  # Calculate the target direction to face the workshop\n  current_direction = env._current_state.dir\n\n  # Determine the final direction needed based on the relative position of the workshop\n  if dx > 0 and dy == 0:    # Workshop is directly to the right\n      final_direction = craft.RIGHT\n  elif dx < 0 and dy == 0:  # Workshop is directly to the left\n      final_direction = craft.LEFT\n  elif dx == 0 and dy > 0:  # Workshop is directly below\n      final_direction = craft.DOWN\n  elif dx == 0 and dy < 0:  # Workshop is directly above\n      final_direction = craft.UP\n  else:\n      if abs(dx) >= abs(dy):\n          final_direction = (craft.RIGHT if dx > 0 else craft.LEFT)\n      else:\n          final_direction = (craft.DOWN if dy > 0 else craft.UP)\n\n  # Calculate the number of turns needed to reach the final direction\n  turns_needed = (final_direction - current_direction) % 4\n\n  if turns_needed == 1:\n      actions_to_take.append(craft.TURN_RIGHT)\n  elif turns_needed == 2:\n      actions_to_take.extend([craft.TURN_RIGHT, craft.TURN_RIGHT])\n  elif turns_needed == 3:\n      actions_to_take.append(craft.TURN_LEFT)\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T03:12:31.823532", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n\n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = env._current_state.inventory.copy()\n\n  # Check if all ingredients are available\n  required_ingredients = {cookbook.index[k]: v for k, v in recipe.items()}\n\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if not can_craft:\n    return []\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No available workshop to craft item\")\n\n  # Select the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n  # Calculate actions to move the agent to the nearest workshop\n  dx = nearest_workshop_pos[0] - current_position[0]\n  dy = nearest_workshop_pos[1] - current_position[1]\n\n  actions_to_take = []\n\n  if dx > 0:\n    actions_to_take.extend([craft.MOVE_RIGHT for _ in range(dx)])\n  elif dx < 0:\n    actions_to_take.extend([craft.MOVE_LEFT for _ in range(-dx)])\n\n  if dy > 0:\n    actions_to_take.extend([craft.MOVE_DOWN for _ in range(dy)])\n  elif dy < 0:\n    actions_to_take.extend([craft.MOVE_UP for _ in range(-dy)])\n\n  # Calculate the target direction to face the workshop\n  current_direction = env._current_state.dir\n\n  if dx == 0 and dy == 0:  # Already at the workshop\n      pass\n  else:\n      # Calculate the angle between current direction and target direction\n      current_angle = {craft.UP: 0, craft.RIGHT: 90, craft.DOWN: 180, craft.LEFT: 270}[current_direction]\n      target_angle = {craft.UP: 0, craft.RIGHT: 90, craft.DOWN: 180, craft.LEFT: 270}[(dx > 0) * craft.RIGHT + (dx < 0) * craft.LEFT + (dy > 0) * craft.DOWN + (dy < 0) * craft.UP]\n\n      # Calculate the difference in angles\n      angle_diff = target_angle - current_angle\n\n      if angle_diff % 180 == 0:\n          pass\n      elif angle_diff % 90 == 0:\n          actions_to_take.extend([craft.TURN_RIGHT for _ in range(angle_diff // 90)])\n          actions_to_take.extend([craft.TURN_LEFT for _ in range(-angle_diff // 90)])\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T03:14:24.746402", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  goal_idx = env.world.cookbook.index[item]\n\n  # Check if we have all required primitives for crafting\n  required_primitives = env.world.cookbook.primitives_for(goal_idx)\n\n  # Collect the required primitives\n  actions_to_take = []\n  current_inventory = {i: 0 for i in range(env.world.n_kinds)}\n\n  # Add logic to collect missing items\n  for primitive, count in required_primitives.items():\n    while current_inventory[primitive] < count:\n      # Find the position of the primitive on the grid\n      positions = np.argwhere(env._current_state.grid[..., primitive] == 1)\n      \n      if len(positions) > 0:\n        closest_pos = min(positions, key=lambda x: np.linalg.norm(np.array(x) - np.array(env._current_state.pos)))\n        \n        # Calculate actions to reach the closest position\n        actions_to_take.extend(move_actions(env._current_state.pos, tuple(closest_pos), env._current_state.dir))\n        \n        # Add action to collect the primitive\n        actions_to_take.append(craft.CRAFT_FUNC(primitive))\n        current_inventory[primitive] += 1\n\n      else:\n        print(f\"No more {env.world.cookbook.index.get(primitive)} found on the grid.\")\n        break\n  \n  # Determine workshop index from recipe\n  workshop_index = None\n  for output, ingredients in env.world.cookbook.recipes.items():\n    if \"_at\" in ingredients and ingredients[\"_at\"] in env.world.workshop_indices:\n      workshop_index = ingredients[\"_at\"]\n      break\n\n  # Check if we have the correct workshop available\n  if workshop_index is not None and any(env._current_state.grid[..., idx] for idx in env.world.workshop_indices):\n    # Find the position of the workshop on the grid\n    positions = np.argwhere(env._current_state.grid[..., workshop_index] == 1)\n    \n    if len(positions) > 0:\n      closest_workshop_pos = min(positions, key=lambda x: np.linalg.norm(np.array(x) - np.array(env._current_state.pos)))\n      \n      # Calculate actions to reach the workshop\n      actions_to_take.extend(move_actions(env._current_state.pos, tuple(closest_workshop_pos), env._current_state.dir))\n      \n      # Add action to craft the item at the workshop\n      actions_to_take.append(craft.CRAFT_FUNC(workshop_index))\n  else:\n    print(\"No suitable workshop found on the grid.\")\n\n  return actions_to_take", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-10T03:14:25.726729", "function_name": "craft", "function_body": "  # Extract the index for the desired goal item\n  goal_index = env.world.cookbook.index[item]\n\n  # Get the primitives required to make the goal item\n  primitives_needed = env.world.cookbook.primitives_for(goal_index)\n\n  # Initialize a list to hold the actions needed to craft the item\n  actions = []\n\n  # Check if we have all the necessary primitives in our inventory\n  for primitive, count_required in primitives_needed.items():\n    primitive_name = env.world.cookbook.index.get(primitive)\n    while env._current_state.inventory[primitive] < count_required:\n      # Find the location of the required primitive on the grid\n      locations = np.argwhere(env._current_state.grid[:, :, primitive])\n      if not locations.size:\n        print(f\"Primitive {primitive_name} not found on the grid.\")\n        return []  # Return empty list if the required primitives are not available\n\n      # Navigate to the closest location of the required primitive\n      x, y = env._current_state.pos\n      min_distance = float('inf')\n      target_location = None\n      for loc in locations:\n          distance = np.linalg.norm(np.array(loc) - np.array([x, y]))\n          if distance < min_distance:\n              min_distance = distance\n              target_location = (loc[0], loc[1])\n\n      # Calculate the sequence of actions needed to move to the target location\n      path_to_primitive = calculate_path(env._current_state.pos, target_location)\n      actions.extend(path_to_primitive)\n\n      # Add action to collect the primitive\n      actions.append(env.world.n_actions - 2)  # Assuming COLLECT_FUNC is mapped to n_actions - 2\n\n      # Turn towards the direction of collection (if required)\n      if not env._current_state.next_to(primitive):\n          actions.append(turn_towards_primitive(env._current_state, target_location))\n\n      # Perform the collect action\n      actions.append(env.world.n_actions - 1)  # Assuming USE action is mapped to n_actions - 1\n\n      # Update the current state after collecting the primitive\n      _, env._current_state = env._current_state.step(env.world.n_actions - 1)\n\n  # Navigate to the correct workshop for crafting\n  workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n    if goal_index in recipe:\n      workshop_index = list(recipe[\"_key\"].values())[0]\n      break\n\n  if workshop_index is None:\n    print(f\"No workshop found for item {item}.\")\n    return []\n\n  # Find the location of the required workshop on the grid\n  workshop_locations = np.argwhere(env._current_state.grid[:, :, workshop_index])\n  if not workshop_locations.size:\n    print(f\"Workshop not found on the grid.\")\n    return []  # Return empty list if the workshop is not available\n\n  # Navigate to the closest location of the required workshop\n  x, y = env._current_state.pos\n  min_distance = float('inf')\n  target_workshop_location = None\n  for loc in workshop_locations:\n      distance = np.linalg.norm(np.array(loc) - np.array([x, y]))\n      if distance < min_distance:\n          min_distance = distance\n          target_workshop_location = (loc[0], loc[1])\n\n  # Calculate the sequence of actions needed to move to the target location\n  path_to_workshop = calculate_path(env._current_state.pos, target_workshop_location)\n  actions.extend(path_to_workshop)\n\n  # Turn towards the direction of the workshop (if required)\n  if not env._current_state.next_to(workshop_index):\n      actions.append(turn_towards_workshop(env._current_state, target_workshop_location))\n\n  # Perform the craft action\n  actions.append(env.world.n_actions - 1)  # Assuming USE action is mapped to n_actions - 1\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-10T03:16:54.013059", "function_name": "craft", "function_body": "  def find_workshop_for_item(item_idx):\n    # Find the workshop that can craft the item\n    for recipe in env.world.cookbook.recipes.values():\n      if \"_key\" in recipe and recipe[\"_key\"] == item_idx:\n        return recipe.get(\"_at\", None)\n    return None\n\n  def get_primitive_counts(primitive_indices, inventory):\n    # Get the counts of primitives in the inventory\n    return {i: inventory[i] for i in primitive_indices}\n\n  def collect_primitives(primitive_indices, required_counts):\n    actions = []\n    inventory = env._current_state.inventory.copy()  # Start with a copy of the current inventory\n\n    for i in primitive_indices:\n      while inventory[i] < required_counts[i]:\n        primitive_name = env.world.cookbook.index.get(i)\n        if not primitive_name:  # If the primitive name is not found, return an empty list\n          return []\n        \n        collect_actions = collect(env, primitive_name)\n        if not collect_actions:  # If no actions are returned to collect the item, return an empty list\n          return []\n\n        actions.extend(collect_actions)\n\n        # Simulate collecting the item by updating the inventory\n        # In a real scenario, this would be based on the environment's response after executing the actions\n        inventory[i] += 1\n\n    return actions\n\n  def find_closest_workshop(env, workshop_idx):\n    from collections import deque\n    \n    directions = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n    queue = deque([(env._current_state.pos, [])])\n    visited = set()\n    \n    while queue:\n        (x, y), path = queue.popleft()\n        if env._current_state.grid[x, y, workshop_idx] > 0:\n            return x, y, path\n        for dx, dy in directions:\n            nx, ny = x + dx, y + dy\n            if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n                if (nx, ny) not in visited:\n                    visited.add((nx, ny))\n                    queue.append(((nx, ny), path + [(dx, dy)]))\n    return None\n\n  def navigate_to_position(path):\n      actions = []\n      for dx, dy in path:\n          if dx > 0:\n              actions.append(env.ACTIONS.index(\"DOWN\"))\n          elif dx < 0:\n              actions.append(env.ACTIONS.index(\"UP\"))\n          if dy > 0:\n              actions.append(env.ACTIONS.index(\"RIGHT\"))\n          elif dy < 0:\n              actions.append(env.ACTIONS.index(\"LEFT\"))\n      return actions\n\n  def use_action():\n      return env.ACTIONS.index(\"USE\")\n\n  # Get the index of the item to craft\n  item_idx = env.world.cookbook.index[item]\n  \n  # Check if we have a recipe for this item\n  if item_idx not in env.world.cookbook.recipes:\n    return []\n  \n  # Get the ingredients required and their counts\n  ingredients = {k: v for k, v in env.world.cookbook.recipes[item_idx].items() if k != \"_at\"}\n  \n  # Find the workshop for crafting the item\n  workshop_name = find_workshop_for_item(item_idx)\n  if workshop_name is None:\n    return []\n  \n  # Find the index of the workshop in the environment\n  workshop_idx = env.world.workshop_indices[workshop_name]\n  \n  # Collect primitives required for crafting\n  actions = collect_primitives(list(ingredients.keys()), ingredients)\n\n  # Check if we have collected enough primitives\n  inventory = env._current_state.inventory.copy()\n  for i, count in ingredients.items():\n    if inventory[i] < count:\n        return []  # If we can't collect enough primitives, return an empty action list\n  \n  workshop_info = find_closest_workshop(env, workshop_idx)\n  if not workshop_info:\n    return []\n  \n  _, _, path_to_workshop = workshop_info\n  actions.extend(navigate_to_position(path_to_workshop))\n  actions.append(use_action())\n  \n  return actions", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T03:16:55.133068", "function_name": "craft", "function_body": "  def find_workshop_for_item(item_idx):\n    for recipe in env.world.cookbook.recipes.values():\n      if \"_key\" in recipe and recipe[\"_key\"] == item_idx:\n        return recipe.get(\"_at\", None)\n    return None\n\n  def collect_primitives(primitive_indices, required_counts, inventory):\n    actions = []\n    for i in primitive_indices:\n      while inventory[i] < required_counts[i]:\n        primitive_name = env.world.cookbook.index.get(i)\n        collect_actions = collect(env, primitive_name)\n        if not collect_actions:\n          return [], False  # If we can't collect the required primitives, return an empty action list and failure flag\n        actions.extend(collect_actions)\n        inventory[i] += 1\n    return actions, True\n\n  def find_closest_workshop(env, workshop_idx):\n    from collections import deque\n    \n    directions = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n    queue = deque([(env._current_state.pos, [])])\n    visited = set()\n    \n    while queue:\n        (x, y), path = queue.popleft()\n        if env._current_state.grid[x, y, workshop_idx] > 0 and env._current_state.next_to(workshop_idx):\n            return x, y\n        for dx, dy in directions:\n            nx, ny = x + dx, y + dy\n            if (nx, ny) not in visited and 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n                visited.add((nx, ny))\n                queue.append(((nx, ny), path + [(dx, dy)]))\n    return None\n\n  def navigate_to_position(path):\n      actions = []\n      for dx, dy in path:\n          if dx > 0:\n              actions.append(env.ACTIONS.index(\"DOWN\"))\n          elif dx < 0:\n              actions.append(env.ACTIONS.index(\"UP\"))\n          if dy > 0:\n              actions.append(env.ACTIONS.index(\"RIGHT\"))\n          elif dy < 0:\n              actions.append(env.ACTIONS.index(\"LEFT\"))\n      return actions\n\n  def use_action():\n      return env.ACTIONS.index(\"USE\")\n\n  item_idx = env.world.cookbook.index[item]\n  \n  if item_idx not in env.world.cookbook.recipes:\n    return []\n  \n  ingredients = {k: v for k, v in env.world.cookbook.recipes[item_idx].items() if k != \"_at\"}\n  \n  workshop_name = find_workshop_for_item(item_idx)\n  if workshop_name is None:\n    return []\n  \n  workshop_idx = env.world.workshop_indices[workshop_name]\n  \n  actions = []\n  inventory = collections.defaultdict(int)\n\n  # Collect primitives required for crafting\n  collect_actions, success = collect_primitives(list(ingredients.keys()), ingredients, inventory)\n  if not success:\n      return []\n\n  # Check if the agent has all required primitives\n  for i, count in ingredients.items():\n    if inventory[i] < count:\n        return []  # If we can't collect enough primitives, return an empty action list\n\n  workshop_pos = find_closest_workshop(env, workshop_idx)\n  if not workshop_pos:\n      return []\n\n  actions.extend(navigate_to_position(workshop_pos))\n  actions.append(use_action())\n  \n  return actions", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T03:17:53.079557", "function_name": "craft", "function_body": "  actions = []\n  cookbook = env.world.cookbook\n  index = cookbook.index\n\n  # Get the goal index from the recipe name\n  goal_index = index[item]\n\n  # Get the primitives required to craft the goal\n  primitives_needed = cookbook.primitives_for(goal_index)\n\n  # Check if we have all the primitives needed in our inventory\n  for primitive, count in primitives_needed.items():\n    if env._current_state.inventory[primitive] < count:\n      return []  # We don't have enough primitives\n\n  # Now that we have all the required primitives, we need to find the workshop to craft the item\n  # The workshop is specified in the recipe as \"_at\"\n  recipe = cookbook.recipes[goal_index]\n  workshop_name = recipe[\"_at\"]\n\n  # Get the index of the workshop\n  workshop_index = index[workshop_name]\n\n  # Find the position of the nearest workshop\n  grid = env._current_state.grid\n  pos = np.argwhere(grid[:, :, workshop_index] > 0)\n  if pos.size == 0:\n    return []  # No workshop found\n\n  # Convert to a list of positions\n  positions = [(x, y) for x, y in pos]\n\n  # Find the nearest position to the current position\n  current_pos = env._current_state.pos\n  nearest_workshop = min(positions, key=lambda p: abs(p[0] - current_pos[0]) + abs(p[1] - current_pos[1]))\n\n  # Calculate actions to move to the workshop\n  actions.extend(move_to(env, nearest_workshop))\n\n  # Add action to use the workshop\n  actions.append(env.world.n_actions - 1)  # Assuming USE is the last action\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-10T03:17:54.040482", "function_name": "craft", "function_body": "  # Convert the item name to its corresponding index\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index)\n  \n  if not recipe:\n    print(f\"No recipe found for {item}.\")\n    return []\n\n  # Check if we have all the required primitives in our inventory\n  required_primitives = recipe.copy()\n  del required_primitives['_at']  # Remove the workshop information\n\n  actions = []\n  state = env._current_state\n  \n  # Collect missing primitives\n  for primitive, count in required_primitives.items():\n    primitive_index = env.world.cookbook.index[primitive]\n    if state.inventory[primitive_index] < count:\n      # Find positions of the primitive on the grid\n      primitive_positions = np.argwhere(state.grid[:, :, primitive_index] == 1)\n      \n      if not primitive_positions.size:\n        print(f\"No {primitive} found on the grid.\")\n        return []\n      \n      # Move to the nearest primitive position and collect it\n      nearest_pos = min(primitive_positions, key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))\n      \n      actions.extend(move_to_position(state, nearest_pos))\n      actions.append(env.world.cookbook.index[\"COLLECT_FUNC\"])\n      \n  # Move to the workshop and craft the item\n  workshop_index = env.world.cookbook.index[recipe['_at']]\n  workshop_positions = np.argwhere(state.grid[:, :, workshop_index] == 1)\n  \n  if not workshop_positions.size:\n    print(f\"No {recipe['_at']} found on the grid.\")\n    return []\n  \n  nearest_workshop = min(workshop_positions, key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))\n  actions.extend(move_to_position(state, nearest_workshop))\n  actions.append(env.world.cookbook.index[\"USE_FUNC\"])\n  \n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-10T03:20:09.773479", "function_name": "craft", "function_body": "  def get_closest_workshop_pos(workshop_idx):\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    for y in range(env._current_state.grid.shape[0]):\n        for x in range(env._current_state.grid.shape[1]):\n            if np.any(env._current_state.grid[y, x, workshop_idx] > 0):\n                distance = abs(y - env._current_state.pos[0]) + abs(x - env._current_state.pos[1])\n                if distance < min_distance:\n                    min_distance = distance\n                    closest_workshop_pos = (y, x)\n    return closest_workshop_pos\n\n  def move_to_target(target_x, target_y):\n      actions = []\n      current_x, current_y = env._current_state.pos\n      \n      # Move horizontally first\n      while current_y != target_y:\n          direction = \"RIGHT\" if current_y < target_y else \"LEFT\"\n          actions.append(env.world.cookbook.index[\"MOVE_FUNC_\" + direction])\n          current_y += 1 if direction == \"RIGHT\" else -1\n      \n      # Then move vertically\n      while current_x != target_x:\n          direction = \"DOWN\" if current_x < target_x else \"UP\"\n          actions.append(env.world.cookbook.index[\"MOVE_FUNC_\" + direction])\n          current_x += 1 if direction == \"DOWN\" else -1\n      \n      return actions\n\n  def face_workshop(target_x, target_y):\n      actions = []\n      dx = target_x - env._current_state.pos[0]\n      dy = target_y - env._current_state.pos[1]\n      \n      # Determine the direction to face\n      if dx == 0 and dy > 0:\n          final_direction = 2\n      elif dx == 0 and dy < 0:\n          final_direction = 3\n      elif dx > 0 and dy == 0:\n          final_direction = 1\n      elif dx < 0 and dy == 0:\n          final_direction = 0\n      \n      # Turn to the correct direction if not already facing it\n      current_direction = env._current_state.dir\n      if current_direction != final_direction:\n          actions.append(env.world.cookbook.index[\"MOVE_FUNC_\" + [\"UP\", \"RIGHT\", \"DOWN\", \"LEFT\"][final_direction]])\n      \n      return actions\n\n  # Get the index of the desired item from the cookbook\n  i_goal = env.world.cookbook.index[item]\n  \n  # Get the recipe for the goal item\n  recipe = env.world.cookbook.recipes[i_goal]\n\n  # Check if we have all the ingredients in our inventory to craft the item\n  required_primitives = env.world.cookbook.primitives_for(i_goal)\n  inventory_dict = {env.world.cookbook.index.get(idx): count for idx, count in enumerate(env._current_state.inventory) if count > 0}\n\n  # Check if we have all the primitives needed\n  have_all_primitives = all(primitive in inventory_dict and inventory_dict[primitive] >= required_primitives[idx] for primitive, idx in required_primitives.items())\n\n  if not have_all_primitives:\n      return []  # We can't craft the item as we don't have all ingredients\n\n  # Now that we have all the primitives, let's go to the workshop and use it to craft the item\n  workshop = recipe[\"_key\"]\n  workshop_idx = env.world.cookbook.index[workshop]\n\n  # Get the position of the closest workshop from our current position in the grid\n  closest_workshop_pos = get_closest_workshop_pos(workshop_idx)\n\n  # If no workshop is found, return an empty action list\n  if closest_workshop_pos is None:\n      return []\n\n  target_x, target_y = closest_workshop_pos\n\n  # Calculate actions needed to move to the closest workshop\n  actions.extend(move_to_target(target_x, target_y))\n\n  # Now face the workshop and use it to craft the item\n  actions.extend(face_workshop(target_x, target_y))\n  \n  # Finally, use the workshop to craft the item\n  actions.append(env.world.cookbook.index[\"USE_FUNC\"])\n  \n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T03:20:10.852570", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index of the desired item from the cookbook\n  i_goal = env.world.cookbook.index[item]\n  \n  # Get the recipe for the goal item\n  recipe = env.world.cookbook.recipes[i_goal]\n\n  # Check if we have all the ingredients in our inventory to craft the item\n  required_primitives = env.world.cookbook.primitives_for(i_goal)\n  inventory_dict = {env.world.cookbook.index.get(idx): count for idx, count in enumerate(env._current_state.inventory) if count > 0}\n\n  # Check if we have all the primitives needed\n  have_all_primitives = all(primitive in inventory_dict and inventory_dict[primitive] >= required_primitives[idx] for primitive, idx in required_primitives.items())\n\n  if not have_all_primitives:\n    return []  # We can't craft the item as we don't have all ingredients\n\n  # Now that we have all the primitives, let's go to the workshop and use it to craft the item\n  workshop = recipe[\"_key\"]\n  workshop_idx = env.world.cookbook.index[workshop]\n\n  # Get the position of the closest workshop from our current position in the grid\n  min_distance = float('inf')\n  closest_workshop_pos = None\n\n  for y in range(env._current_state.grid.shape[0]):\n    for x in range(env._current_state.grid.shape[1]):\n      if np.any(env._current_state.grid[y, x, workshop_idx] > 0):\n        distance = abs(y - env._current_state.pos[0]) + abs(x - env._current_state.pos[1])\n        if distance < min_distance:\n          min_distance = distance\n          closest_workshop_pos = (y, x)\n\n  # If no workshop is found, return an empty action list\n  if closest_workshop_pos is None:\n    return []\n\n  # Calculate actions needed to move to the closest workshop\n  target_x, target_y = closest_workshop_pos\n\n  # Use A* algorithm to find the shortest path to the closest workshop\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal):\n      open_set = []\n      heapq.heappush(open_set, (0, start))\n      came_from = {}\n      g_score = {start: 0}\n      f_score = {start: heuristic(start, goal)}\n\n      while open_set:\n          current = heapq.heappop(open_set)[1]\n\n          if current == goal:\n              path = []\n              while current in came_from:\n                  path.append(current)\n                  current = came_from[current]\n              path.reverse()\n              return path\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              if 0 <= neighbor[0] < env._current_state.grid.shape[0] and 0 <= neighbor[1] < env._current_state.grid.shape[1]:\n                  tentative_g_score = g_score[current] + 1\n\n                  if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                      came_from[neighbor] = current\n                      g_score[neighbor] = tentative_g_score\n                      f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                      heapq.heappush(open_set, (f_score[neighbor], neighbor))\n      return []\n\n  path = a_star(env._current_state.pos, closest_workshop_pos)\n\n  if not path:\n      return []  # No path found to the workshop\n\n  for step in path[:-1]:\n    current_x, current_y = env._current_state.pos\n    target_x, target_y = step\n\n    direction = None\n    if current_x < target_x:\n        direction = \"DOWN\"\n    elif current_x > target_x:\n        direction = \"UP\"\n    elif current_y < target_y:\n        direction = \"RIGHT\"\n    elif current_y > target_y:\n        direction = \"LEFT\"\n\n    actions.append(env.world.cookbook.index[\"MOVE_FUNC_\" + direction])\n\n  # Face the workshop and use it to craft the item\n  target_x, target_y = closest_workshop_pos\n\n  dx = target_x - env._current_state.pos[0]\n  dy = target_y - env._current_state.pos[1]\n\n  current_direction = env._current_state.dir\n\n  if dx == 0 and dy > 0:  # Target is directly below\n      if current_direction != 2:\n          actions.append(env.world.cookbook.index[\"MOVE_FUNC_DOWN\"])\n  elif dx == 0 and dy < 0:  # Target is directly above\n      if current_direction != 3:\n          actions.append(env.world.cookbook.index[\"MOVE_FUNC_UP\"])\n  elif dx > 0 and dy == 0:  # Target is to the right\n      if current_direction != 1:\n          actions.append(env.world.cookbook.index[\"MOVE_FUNC_RIGHT\"])\n  elif dx < 0 and dy == 0:  # Target is to the left\n      if current_direction != 0:\n          actions.append(env.world.cookbook.index[\"MOVE_FUNC_LEFT\"])\n\n  # Finally, use the workshop to craft the item\n  actions.append(env.world.cookbook.index[\"USE_FUNC\"])\n  \n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T03:21:45.238736", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = env._current_state.inventory.copy()\n\n  # Check if all ingredients are available\n  required_ingredients = {cookbook.index[k]: v for k, v in recipe.items()}\n\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if not can_craft:\n    return []\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No available workshop to craft item\")\n\n  # Select the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n  # Calculate actions to move the agent to the nearest workshop\n  dx = nearest_workshop_pos[0] - current_position[0]\n  dy = nearest_workshop_pos[1] - current_position[1]\n\n  actions_to_take = []\n\n  if abs(dx) > abs(dy):\n      if dx > 0:\n          actions_to_take.extend([craft.MOVE_RIGHT for _ in range(dx)])\n      else:\n          actions_to_take.extend([craft.MOVE_LEFT for _ in range(-dx)])\n  else:\n      if dy > 0:\n          actions_to_take.extend([craft.MOVE_DOWN for _ in range(dy)])\n      else:\n          actions_to_take.extend([craft.MOVE_UP for _ in range(-dy)])\n\n  # Calculate the target direction to face the workshop\n  current_direction = env._current_state.dir\n\n  if dx == 0 and dy == 0:  # Already at the workshop\n      pass\n  elif abs(dx) > abs(dy):  # Prioritize horizontal movement\n      while current_direction != (craft.RIGHT if dx > 0 else craft.LEFT):\n          actions_to_take.append(craft.TURN_RIGHT)\n          current_direction = (current_direction + 1) % 4\n  else:  # Prioritize vertical movement\n      while current_direction != (craft.DOWN if dy > 0 else craft.UP):\n          actions_to_take.append(craft.TURN_LEFT)\n          current_direction = (current_direction - 3) % 4\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T03:21:46.275383", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = env._current_state.inventory.copy()\n\n  # Check if all ingredients are available\n  required_ingredients = {cookbook.index[k]: v for k, v in recipe.items()}\n\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if not can_craft:\n    return []\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No available workshop to craft item\")\n\n  # Select the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n  # Calculate actions to move the agent to the nearest workshop\n  dx = nearest_workshop_pos[0] - current_position[0]\n  dy = nearest_workshop_pos[1] - current_position[1]\n\n  actions_to_take = []\n\n  while dx != 0 or dy != 0:\n    if abs(dx) > abs(dy):  # Prioritize horizontal movement\n      direction = craft.RIGHT if dx > 0 else craft.LEFT\n    else:  # Prioritize vertical movement\n      direction = craft.DOWN if dy > 0 else craft.UP\n\n    # Turn to face the correct direction\n    current_direction = env._current_state.dir\n    while current_direction != direction:\n      actions_to_take.append(craft.TURN_RIGHT)\n      current_direction = (current_direction + 1) % 4\n\n    # Move in the correct direction\n    if direction == craft.RIGHT:\n      actions_to_take.append(craft.MOVE_RIGHT)\n      dx -= 1\n    elif direction == craft.LEFT:\n      actions_to_take.append(craft.MOVE_LEFT)\n      dx += 1\n    elif direction == craft.DOWN:\n      actions_to_take.append(craft.MOVE_DOWN)\n      dy -= 1\n    elif direction == craft.UP:\n      actions_to_take.append(craft.MOVE_UP)\n      dy += 1\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T03:22:39.942643", "function_name": "craft", "function_body": "  actions = []\n  cookbook = env.world.cookbook\n  index = cookbook.index\n\n  # Get the recipe for the desired item.\n  goal_index = index[item]\n  if goal_index not in cookbook.recipes:\n    print(f\"No recipe found for {item}.\")\n    return []\n\n  # Check and collect all required primitives.\n  primitives_needed = cookbook.primitives_for(goal_index)\n  inventory = env._current_state.inventory.copy()\n  \n  for primitive, count in primitives_needed.items():\n    if inventory[primitive] < count:\n      # Collect the missing primitives\n      actions.extend(collect(env, index.get(primitive)))\n    \n  # Find the workshop to craft the item.\n  recipe = cookbook.recipes[goal_index]\n  workshop = None\n  for ingredient, _ in recipe.items():\n    if ingredient == \"_at\":\n      workshop = recipe[\"_at\"]\n      break\n\n  if not workshop:\n    print(f\"No workshop specified in recipe for {item}.\")\n    return []\n\n  # Move to the workshop and craft the item.\n  workshop_index = index[workshop]\n  workshop_position = find_closest_workshop(env, workshop_index)\n  \n  actions.extend(move_to(env, workshop_position))\n  actions.append(env.world.N_ACTIONS - 1)  # USE action\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-10T03:22:40.909557", "function_name": "craft", "function_body": "  # Get the index of the item to craft\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all primitives required for crafting the item\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n\n  actions = []\n\n  # Collect the required primitives first\n  for primitive, count in required_primitives.items():\n    primitive_name = env.world.cookbook.index.get(primitive)\n    if not env._current_state.inventory[primitive]:\n      actions.extend(collect(env, primitive_name))\n    \n    # If we don't have enough of this primitive, collect more\n    while env._current_state.inventory[primitive] < count:\n      actions.extend(collect(env, primitive_name))\n\n  # Now that we have all the required primitives, find the workshop to craft the item\n  for output, recipe in env.world.cookbook.recipes.items():\n    if \"_at\" in recipe and recipe[\"_at\"] == \"workshop0\":\n        workshop_index = env.world.workshop_indices[0]\n    elif \"_at\" in recipe and recipe[\"_at\"] == \"workshop1\":\n        workshop_index = env.world.workshop_indices[1]\n    elif \"_at\" in recipe and recipe[\"_at\"] == \"workshop2\":\n        workshop_index = env.world.workshop_indices[2]\n    \n    if output == item_index:\n      # Find the position of the workshop\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n      \n      for pos in workshop_positions:\n        # Move to the workshop\n        actions.extend(move_to_position(env, tuple(pos)))\n        \n        # Turn towards the workshop and use it to craft the item\n        actions.append(env.world.cookbook.index[\"USE\"])\n        \n        break\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-10T03:24:25.192033", "function_name": "craft", "function_body": "  def collect_ingredient(name: str):\n    ingredient_idx = env.world.cookbook.index[name]\n    if env._current_state.inventory[ingredient_idx] == 0:\n      # Collect the ingredient if it's not already in inventory\n      return collect_v2(env, name)\n    return []\n\n  actions = []\n  \n  # Get the index for the desired item from the cookbook\n  item_idx = env.world.cookbook.index[item]\n  \n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_idx, {})\n  \n  if not recipe:\n    return []  # No recipe found\n  \n  # Determine the workshop where the crafting should happen\n  workshop_key = \"_key\"\n  workshop_index_str = recipe.pop(workshop_key, \"-1\")\n  \n  try:\n      workshop_index = int(workshop_index_str)\n  except ValueError:\n      return []  # Invalid workshop index in the recipe\n  \n  if workshop_index == -1:\n    return []  # Workshop not specified in the recipe\n  \n  # Get the list of workshops from the world configuration\n  workshop_indices = env.world.workshop_indices\n  \n  if workshop_index >= len(workshop_indices):\n    return []  # Invalid workshop index\n  \n  # Determine the target position for the workshop\n  target_workshop_pos = None\n  for y in range(env._current_state.grid.shape[1]):\n      for x in range(env._current_state.grid.shape[0]):\n          if env._current_state.grid[x, y, workshop_indices[workshop_index]] == 1:\n              target_workshop_pos = (x, y)\n              break\n      if target_workshop_pos is not None:\n          break\n  \n  if target_workshop_pos is None:\n    return []  # Workshop position not found in the grid\n\n  # Check and collect all required primitives\n  for ingredient_name, quantity in recipe.items():\n      ingredient_idx = env.world.cookbook.index[ingredient_name]\n      \n      while env._current_state.inventory[ingredient_idx] < quantity:\n          actions.extend(collect_v2(env, ingredient_name))\n  \n  # Move to the target workshop\n  actions.extend(move_to(env._current_state, target_workshop_pos))\n  \n  # Perform the USE action at the workshop\n  actions.append(4)  # USE action index\n  \n  return actions", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T03:24:26.297103", "function_name": "craft", "function_body": "  def collect_ingredient(name: str):\n    ingredient_idx = env.world.cookbook.index[name]\n    if env._current_state.inventory[ingredient_idx] == 0:\n      # Collect the ingredient if it's not already in inventory\n      return collect_v2(env, name)\n    return []\n\n  actions = []\n  \n  # Get the index for the desired item from the cookbook\n  item_idx = env.world.cookbook.index[item]\n  \n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_idx, {})\n  \n  if not recipe:\n    return []  # No recipe found\n  \n  # Determine the workshop where the crafting should happen\n  workshop_key = \"_key\"\n  workshop_index_str = recipe.pop(workshop_key, \"-1\")\n  \n  try:\n      workshop_index = int(workshop_index_str)\n  except ValueError:\n      return []  # Invalid workshop index in the recipe\n  \n  if workshop_index == -1:\n    return []  # Workshop not specified in the recipe\n  \n  # Get the list of workshops from the world configuration\n  workshop_indices = env.world.workshop_indices\n  \n  if workshop_index >= len(workshop_indices):\n    return []  # Invalid workshop index\n  \n  # Determine the target position for the workshop\n  target_workshop_pos = None\n  for y in range(env._current_state.grid.shape[1]):\n      for x in range(env._current_state.grid.shape[0]):\n          if env._current_state.grid[x, y, workshop_indices[workshop_index]] == 1:\n              target_workshop_pos = (x, y)\n              break\n      if target_workshop_pos is not None:\n          break\n  \n  if target_workshop_pos is None:\n    return []  # Workshop position not found in the grid\n\n  # Check and collect all required primitives\n  for ingredient_name, quantity in recipe.items():\n      ingredient_idx = env.world.cookbook.index[ingredient_name]\n      \n      # If we don't have enough of this ingredient, collect it\n      while env._current_state.inventory[ingredient_idx] < quantity:\n          actions.extend(collect_v2(env, ingredient_name))\n  \n  # Move to the target workshop\n  actions.extend(move_to(env._current_state, target_workshop_pos))\n\n  # Ensure we are facing the correct direction before using the workshop\n  if not is_facing_correct_direction(env._current_state, target_workshop_pos):\n      actions.extend(turn_towards_target(env._current_state, target_workshop_pos))\n  \n  # Perform the USE action at the workshop\n  actions.append(4)  # USE action index\n  \n  return actions", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T03:26:09.023052", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = env._current_state.inventory.copy()\n\n  # Check if all ingredients are available\n  required_ingredients = {cookbook.index[k]: v for k, v in recipe.items()}\n\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if not can_craft:\n    return []\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No available workshop to craft item\")\n\n  # Select the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n  # Calculate actions to move the agent to the nearest workshop\n  dx = nearest_workshop_pos[0] - current_position[0]\n  dy = nearest_workshop_pos[1] - current_position[1]\n\n  actions_to_take = []\n\n  if dx > 0:\n    actions_to_take.extend([craft.MOVE_RIGHT for _ in range(dx)])\n  elif dx < 0:\n    actions_to_take.extend([craft.MOVE_LEFT for _ in range(-dx)])\n\n  if dy > 0:\n    actions_to_take.extend([craft.MOVE_DOWN for _ in range(dy)])\n  elif dy < 0:\n    actions_to_take.extend([craft.MOVE_UP for _ in range(-dy)])\n\n  # Calculate the target direction to face the workshop\n  current_direction = env._current_state.dir\n\n  if dx == 0 and dy == 0:  # Already at the workshop\n      pass\n  elif dx > 0:\n      while current_direction != craft.RIGHT:\n          actions_to_take.append(craft.TURN_RIGHT)\n          current_direction = (current_direction + 1) % 4\n  elif dx < 0:\n      while current_direction != craft.LEFT:\n          actions_to_take.append(craft.TURN_LEFT)\n          current_direction = (current_direction - 1) % 4\n  elif dy > 0:\n      while current_direction != craft.DOWN:\n          actions_to_take.append(craft.TURN_RIGHT)\n          current_direction = (current_direction + 1) % 4\n  elif dy < 0:\n      while current_direction != craft.UP:\n          actions_to_take.append(craft.TURN_LEFT)\n          current_direction = (current_direction - 1) % 4\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T03:26:10.033980", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = env._current_state.inventory.copy()\n\n  # Check if all ingredients are available\n  required_ingredients = {cookbook.index[k]: v for k, v in recipe.items()}\n\n  can_craft = True\n\n  # Collect missing items/primitives\n  actions_to_collect = []\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      needed_count = required_count - (available_inventory.get(ingredient_index, 0))\n      collect_actions = collect(env, cookbook.index.ordered_keys()[ingredient_index], needed_count)\n      actions_to_collect.extend(collect_actions)\n\n  if len(actions_to_collect) > 0:\n    return actions_to_collect\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No available workshop to craft item\")\n\n  # Select the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n  # Calculate actions to move the agent to the nearest workshop\n  dx = nearest_workshop_pos[0] - current_position[0]\n  dy = nearest_workshop_pos[1] - current_position[1]\n\n  actions_to_take = []\n\n  if dx > 0:\n    actions_to_take.extend([craft.MOVE_RIGHT for _ in range(dx)])\n  elif dx < 0:\n    actions_to_take.extend([craft.MOVE_LEFT for _ in range(-dx)])\n\n  if dy > 0:\n    actions_to_take.extend([craft.MOVE_DOWN for _ in range(dy)])\n  elif dy < 0:\n    actions_to_take.extend([craft.MOVE_UP for _ in range(-dy)])\n\n  # Calculate the target direction to face the workshop\n  current_direction = env._current_state.dir\n\n  if dx == 0 and dy == 0:  # Already at the workshop\n      pass\n  elif dx > 0:\n      while current_direction != craft.RIGHT:\n          actions_to_take.append(craft.TURN_RIGHT)\n          current_direction = (current_direction + 1) % 4\n  elif dx < 0:\n      while current_direction != craft.LEFT:\n          actions_to_take.append(craft.TURN_LEFT)\n          current_direction = (current_direction - 1) % 4\n  elif dy > 0:\n      while current_direction != craft.DOWN:\n          actions_to_take.append(craft.TURN_RIGHT)\n          current_direction = (current_direction + 1) % 4\n  elif dy < 0:\n      while current_direction != craft.UP:\n          actions_to_take.append(craft.TURN_LEFT)\n          current_direction = (current_direction - 1) % 4\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-10T03:26:59.401243", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # If the item is a primitive, return an empty action list since primitives cannot be crafted.\n  if item_index in env.world.cookbook.primitives:\n    return []\n\n  # Retrieve the recipe for crafting the specified item\n  recipe = env.world.cookbook.recipes.get(item_index)\n\n  # Ensure that the recipe exists and contains a \"_key\" indicating where to craft the item.\n  if not recipe or \"_key\" not in recipe:\n    return []\n\n  workshop_key = recipe[\"_key\"]\n  workshop_index = env.world.cookbook.index[workshop_key]\n\n  actions = []\n  \n  # Check inventory for missing ingredients\n  missing_ingredients = {}\n  for ingredient, count in recipe.items():\n    if ingredient == \"_key\":\n      continue\n    \n    ingredient_index = env.world.cookbook.index[ingredient]\n    current_count = env._current_state.inventory[ingredient_index]\n    \n    if current_count < count:\n      missing_ingredients[ingredient] = count - current_count\n\n  # If ingredients are required, collect them.\n  for ingredient, required_count in missing_ingredients.items():\n    ingredient_index = env.world.cookbook.index[ingredient]\n    actions.extend(collect_v2(env, ingredient, required_count))\n\n  # Move to the workshop\n  actions.extend(move_to_workshop(env, workshop_index))\n  \n  # Align with the workshop and use it.\n  alignment_action = align_with_workshop(env, workshop_index)\n  if alignment_action:\n    actions.append(alignment_action)\n\n  actions.append(craft.ACTION_USE)\n  \n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T03:27:00.460244", "function_name": "craft", "function_body": "  # Get the index for the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item is a primitive; primitives cannot be crafted.\n  if item_index in env.world.cookbook.primitives:\n    return []\n\n  # Fetch the recipe for crafting the specified item from the cookbook.\n  recipe = env.world.cookbook.recipes.get(item_index)\n\n  # If there's no valid recipe or \"_key\" is missing, we can't craft this item.\n  if not recipe or \"_key\" not in recipe:\n    return []\n\n  workshop_key = recipe[\"_key\"]\n  workshop_index = env.world.cookbook.index[workshop_key]\n\n  actions = []\n\n  # Check the current inventory to see which ingredients are missing for crafting the item.\n  missing_ingredients = {}\n  for ingredient, count in recipe.items():\n    if ingredient == \"_key\":\n      continue\n    ingredient_index = env.world.cookbook.index[ingredient]\n    current_count = env._current_state.inventory[ingredient_index]\n    if current_count < count:\n      missing_ingredients[ingredient] = count - current_count\n\n  # If there are any missing ingredients, plan actions to collect them.\n  for ingredient, required_count in missing_ingredients.items():\n    ingredient_index = env.world.cookbook.index[ingredient]\n    actions.extend(collect_v2(env, ingredient, required_count))\n\n  # Move towards the specified workshop if not already aligned.\n  actions.extend(move_to_workshop(env, workshop_index))\n  \n  # Align with the correct workshop before using it to craft the item.\n  alignment_action = align_with_workshop(env, workshop_index)\n  if alignment_action:\n    actions.append(alignment_action)\n\n  # Perform the USE action at the workshop to craft the desired item.\n  actions.append(craft.ACTION_USE)\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T03:27:47.014842", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index of the desired item\n  goal_index = env.world.cookbook.index[item]\n\n  # Get primitives required for crafting the item and the corresponding counts\n  primitive_requirements = env.world.cookbook.primitives_for(goal_index)\n\n  # Check if we already have enough of each required primitive in our inventory\n  inventory = env._current_state.inventory\n  \n  def has_required_primitives(inventory, primitive_requirements):\n      return all(inventory[primitive] >= count for primitive, count in primitive_requirements.items())\n  \n  # If we don't have the required primitives, then find and collect them\n  if not has_required_primitives(inventory, primitive_requirements):\n    print(\"Collecting Primitives\")\n    for primitive_index, count in primitive_requirements.items():\n        primitive_name = env.world.cookbook.index.get(primitive_index)\n        actions.extend(collect_v0(env, primitive_name, count))\n  \n  # Now that we have the required primitives, find the workshop to craft the item\n  print(\"Crafting Item\")\n  workshop_location = None\n  for pos in range(env.world.grid.shape[0]):\n      for pos_y in range(env.world.grid.shape[1]):\n          if env.world.grid[pos, pos_y, goal_index] == 0:\n              continue\n          for workshop in env.world.workshop_indices:\n              if env.world.grid[pos, pos_y, workshop] > 0:\n                  workshop_location = (pos, pos_y)\n                  break\n      if workshop_location is not None:\n          break\n  \n  # If we found a workshop, navigate to it and perform the USE action\n  if workshop_location is not None:\n      actions.extend(navigate_to(env._current_state.pos, workshop_location))\n      actions.append(env.world.n_actions - 1)  # Append USE action\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-10T03:27:47.981335", "function_name": "craft", "function_body": "  # Step 1: Determine if we have all the required primitives and intermediate items.\n  index = env.world.cookbook.index\n  goal_index = index[item]\n  \n  # Find the recipe for the goal item\n  if goal_index not in env.world.cookbook.recipes:\n    return []  # No recipe available for this item\n\n  # Extract ingredients from the recipe\n  recipe = env.world.cookbook.recipes[goal_index]\n  ingredients = {index[i]: count for i, count in recipe.items() if i != \"_key\"}\n\n  # Check if we have all required items in our inventory\n  missing_ingredients = []\n  for ingredient, count in ingredients.items():\n    if env._current_state.inventory[ingredient] < count:\n      missing_ingredients.append(ingredient)\n\n  # If there are any missing ingredients, return an empty action list\n  if missing_ingredients:\n    return []\n\n  # Step 2: Determine the correct workshop to use based on the recipe.\n  workshop_key = recipe.get(\"_key\", None)\n  if not workshop_key:\n    return []  # No workshop key found in the recipe\n\n  # Get the index for the workshop from the cookbook\n  workshop_index = env.world.cookbook.index[workshop_key]\n  \n  # Step 3: Navigate to the correct workshop.\n  actions_to_workshop = navigate(env, workshop_index)\n\n  # If navigation fails (returns an empty list), return an empty action list\n  if not actions_to_workshop:\n    return []\n\n  # Step 4: Use the USE action to craft the item at the workshop.\n  use_action = env.world.n_actions - 1  # Assuming USE is the last action\n\n  # Combine all actions together and return\n  return actions_to_workshop + [use_action]", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-10T03:28:37.539319", "function_name": "craft", "function_body": "  # Fetching index for the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the item has a recipe in the cookbook\n  if item_index not in env.world.cookbook.recipes:\n    print(f\"No recipe found for {item}\")\n    return []\n\n  # Get the primitives required to craft the item\n  recipe = env.world.cookbook.recipes[item_index]\n  \n  actions = []\n  \n  # Collect all primitives and intermediate items required\n  for ingredient, count in recipe.items():\n    if ingredient == \"_key\":  # Skip the _key which specifies where to craft the item\n      continue\n    \n    # Get index of the ingredient\n    ingredient_index = env.world.cookbook.index[ingredient]\n    \n    # Check if we already have enough in inventory\n    if np.sum(env._current_state.inventory[ingredient_index]) >= count:\n      print(f\"Already have enough {ingredient}\")\n      continue\n      \n    # Find the location of the ingredient and collect it\n    ingredient_pos = find_ingredient_location(env, ingredient_index)\n    \n    if ingredient_pos is None:\n      print(f\"{ingredient} not found in the environment\")\n      return []\n      \n    actions.extend(navigate_and_collect(env, ingredient_pos))\n    \n  # Determine where to craft the item\n  workshop_key = recipe[\"_key\"]\n  workshop_index = env.world.cookbook.index[workshop_key]\n  \n  if workshop_index is None:\n    print(f\"Workshop for {item} not found in the environment\")\n    return []\n  \n  # Find the position of the workshop\n  workshop_pos = find_workshop_location(env, workshop_index)\n  \n  if workshop_pos is None:\n    print(f\"{workshop_key} not found in the environment\")\n    return []\n\n  actions.extend(navigate_to_workshop(env, workshop_pos))\n  actions.append(craft.CRAFT_FUNC(workshop_index))  # Assuming CRAFT_FUNC takes the index of the workshop\n  \n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-10T03:28:38.507277", "function_name": "craft", "function_body": "  actions = []\n  \n  # Convert item name to index\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the recipe exists for the given item\n  if item_index not in env.world.cookbook.recipes:\n    print(f\"No recipe found for {item}\")\n    return actions\n  \n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes[item_index]\n  \n  # Check and collect all required primitives\n  for ingredient, count in recipe.items():\n      if ingredient == \"_key\": continue  # Skip the _key entry which specifies workshop\n    \n      # Find the index of the ingredient\n      ingredient_index = env.world.cookbook.index[ingredient]\n      \n      # Check if we have enough of this ingredient in inventory\n      if env._current_state.inventory[ingredient_index] < count:\n          # Collect the required amount of this ingredient\n          collect_actions = collect_v2(env, ingredient)\n          actions.extend(collect_actions)\n\n  # Determine the workshop for crafting\n  workshop_key = recipe[\"_key\"]\n  workshop_name = workshop_key.split(\":\")[1]\n  workshop_indices = [i for i, name in enumerate(env.world.cookbook.index.get) if \"workshop\" in name and workshop_name in name]\n\n  if not workshop_indices:\n      print(f\"No workshop found for {item}\")\n      return actions\n\n  # Find the nearest workshop\n  nearest_workshop_index = find_nearest_workshop(env._current_state, workshop_indices)\n  \n  # Move to the nearest workshop\n  move_to_workshop_actions = move_to_v2(env._current_state, nearest_workshop_index)\n  actions.extend(move_to_workshop_actions)\n\n  # Turn to face the workshop and use action to craft the item\n  turn_and_craft_actions = turn_and_use_v2(env._current_state, nearest_workshop_index)\n  actions.extend(turn_and_craft_actions)\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-10T03:30:18.924873", "function_name": "craft", "function_body": "  # Define some utility functions\n  def move_to(target_pos):\n    \"\"\"Returns a list of actions to move the agent to target_pos.\"\"\"\n    current_pos = env._current_state.pos\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n    \n    # Calculate the required movements in x and y directions\n    actions = []\n    if dx > 0:\n        actions.extend([env.world.random.choice([2, 3]) for _ in range(abs(dx))])\n    elif dx < 0:\n        actions.extend([env.world.random.choice([2, 3]) for _ in range(-abs(dx))])\n\n    if dy > 0:\n        actions.extend([env.world.random.choice([0, 1]) for _ in range(abs(dy))])\n    elif dy < 0:\n        actions.extend([env.world.random.choice([0, 1]) for _ in range(-abs(dy))])\n\n    return actions\n  \n  def get_workshop_position(workshop_index):\n      \"\"\"Returns the position of the first workshop found with the given index.\"\"\"\n      grid = env._current_state.grid\n      positions = np.argwhere(grid[:, :, workshop_index] > 0)\n      if len(positions) > 0:\n          return tuple(positions[0])\n      return None\n  \n  def turn_towards(target_direction):\n    \"\"\"Returns a list of actions to turn the agent towards target_direction.\"\"\"\n    current_dir = env._current_state.dir\n    required_turns = (target_direction - current_dir) % 4\n    if required_turns == 1:\n        return [env.world.N_ACTIONS]\n    elif required_turns == 2:\n        return [env.world.N_ACTIONS, env.world.N_ACTIONS]\n    elif required_turns == 3:\n        return [env.world.N_ACTIONS, env.world.N_ACTIONS, env.world.N_ACTIONS]\n    return []\n\n  # Get the index of the item to craft\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the primitives required for crafting the item\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  inventory = env._current_state.inventory\n\n  # If not all primitives are available, return an empty action list\n  for primitive, count in required_primitives.items():\n      if inventory[primitive] < count:\n          return []\n\n  # Find the workshop where the item can be crafted\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_key = \"_key\"\n  if workshop_key not in recipe:\n      raise ValueError(f\"Recipe for {item} does not specify a workshop.\")\n\n  workshop_name = recipe[workshop_key].split('_')[0] + '_index'\n  workshop_index = getattr(env.world, workshop_name)\n\n  # Get the position of the workshop\n  workshop_position = get_workshop_position(workshop_index)\n  if workshop_position is None:\n      raise ValueError(f\"No {workshop_name} found in the grid.\")\n\n  # Move to the workshop position\n  actions = move_to(workshop_position)\n\n  # Turn towards the workshop and perform the USE action\n  target_direction = (env._current_state.pos[1] - workshop_position[1]) % 4\n  actions.extend(turn_towards(target_direction))\n  actions.append(env.world.USE_ACTION)\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-10T03:30:19.896382", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index of the desired item from the cookbook\n  goal_index = env.world.cookbook.index[item]\n\n  # Check if we have a recipe for this item. If not return empty list\n  if goal_index not in env.world.cookbook.recipes:\n    print(f\"No recipe found for {item}\")\n    return []\n\n  # Get the required ingredients and their counts from the recipe\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  # Check if we have all the primitives required to craft this item\n  for ingredient, count in recipe.items():\n      if ingredient == \"_at\":\n          continue  # Skip the \"_at\" key which specifies the workshop\n      primitive_index = env.world.cookbook.index.get(ingredient)\n      if primitive_index is None:\n          print(f\"Unknown ingredient {ingredient} in recipe for {item}\")\n          return []\n      \n      # Check if we have enough of this primitive in our inventory\n      if env._current_state.inventory[primitive_index] < count:\n          print(f\"Not enough {ingredient} to craft {item}\")\n          return []\n\n  # If we have all the primitives, proceed to use the correct workshop\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index.get(workshop_name)\n  \n  if workshop_index is None:\n      print(f\"Unknown workshop {workshop_name} in recipe for {item}\")\n      return []\n\n  # Find a position next to the specified workshop on the grid\n  positions_next_to_workshop = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  \n  if len(positions_next_to_workshop) == 0:\n      print(f\"No available workshops for {item}\")\n      return []\n\n  # Choose a position next to the first available workshop (this is a simple strategy)\n  target_pos = positions_next_to_workshop[0]\n  \n  # Compute actions to move to the target position\n  current_pos = env._current_state.pos\n  delta_x = target_pos[1] - current_pos[1]\n  delta_y = target_pos[0] - current_pos[0]\n\n  if delta_x > 0:\n      actions.extend([craft.RIGHT for _ in range(delta_x)])\n  elif delta_x < 0:\n      actions.extend([craft.LEFT for _ in range(-delta_x)])\n\n  if delta_y > 0:\n      actions.extend([craft.DOWN for _ in range(delta_y)])\n  elif delta_y < 0:\n      actions.extend([craft.UP for _ in range(-delta_y)])\n\n  # Add USE action to craft the item at the workshop\n  actions.append(craft.USE)\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-10T03:32:29.187023", "function_name": "craft", "function_body": "  def find_workshop_for_item(item_idx):\n    # Find the workshop that can craft the item\n    for recipe in env.world.cookbook.recipes.values():\n      if \"_key\" in recipe and recipe[\"_key\"] == item_idx:\n        return recipe.get(\"_at\", None)\n    return None\n\n  def get_primitive_counts(primitive_indices, inventory):\n    # Get the counts of primitives in the inventory\n    return {i: inventory[i] for i in primitive_indices}\n\n  def collect_primitives(primitive_indices, required_counts):\n    actions = []\n    for i in primitive_indices:\n      while env._current_state.inventory[i] < required_counts[i]:\n        primitive_name = env.world.cookbook.index.get(i)\n        actions.extend(collect(env, primitive_name))\n    return actions\n\n  def find_closest_workshop(env, workshop_idx):\n      from collections import deque\n      \n      directions = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n      queue = deque([(env._current_state.pos, [])])\n      visited = set()\n      \n      while queue:\n          (x, y), path = queue.popleft()\n          if env._current_state.grid[x, y, workshop_idx] > 0:\n              return x, y, path\n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      queue.append(((nx, ny), path + [(dx, dy)]))\n      return None\n\n  def navigate_to_position(path):\n      actions = []\n      for dx, dy in path:\n          if dx > 0:\n              actions.append(env.ACTIONS.index(\"DOWN\"))\n          elif dx < 0:\n              actions.append(env.ACTIONS.index(\"UP\"))\n          if dy > 0:\n              actions.append(env.ACTIONS.index(\"RIGHT\"))\n          elif dy < 0:\n              actions.append(env.ACTIONS.index(\"LEFT\"))\n      return actions\n\n  def use_action():\n      return env.ACTIONS.index(\"USE\")\n\n  # Get the index of the item to craft\n  item_idx = env.world.cookbook.index[item]\n  \n  # Check if we have a recipe for this item\n  if item_idx not in env.world.cookbook.recipes:\n    return []\n  \n  # Get the ingredients required and their counts\n  ingredients = {k: v for k, v in env.world.cookbook.recipes[item_idx].items() if k != \"_at\"}\n  \n  # Find the workshop for crafting the item\n  workshop_name = find_workshop_for_item(item_idx)\n  if workshop_name is None:\n    return []\n  \n  # Find the index of the workshop in the environment\n  workshop_idx = env.world.workshop_indices[workshop_name]\n  \n  # Collect primitives required for crafting\n  actions = collect_primitives(list(ingredients.keys()), ingredients)\n  \n  # Navigate to the workshop and perform USE action\n  workshop_info = find_closest_workshop(env, workshop_idx)\n  if not workshop_info:\n    return []\n  \n  _, _, path_to_workshop = workshop_info\n  actions.extend(navigate_to_position(path_to_workshop))\n  actions.append(use_action())\n  \n  return actions", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T03:32:30.233780", "function_name": "craft", "function_body": "  def find_workshop_for_item(item_idx):\n      for recipe in env.world.cookbook.recipes.values():\n          if \"_key\" in recipe and recipe[\"_key\"] == item_idx:\n              return recipe.get(\"_at\", None)\n      return None\n\n  def get_primitive_counts(primitive_indices, inventory):\n      return {i: inventory[i] for i in primitive_indices}\n\n  def collect_primitives(primitive_indices, required_counts):\n      actions = []\n      for i in primitive_indices:\n          while env._current_state.inventory[i] < required_counts[i]:\n              primitive_name = env.world.cookbook.index.get(i)\n              actions.extend(collect(env, primitive_name))\n      return actions\n\n  def find_closest_workshop(workshop_idx):\n      # Find the closest workshop using BFS\n      directions = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n      queue = collections.deque([(env._current_state.pos, [])])\n      visited = set()\n      \n      while queue:\n          (x, y), path = queue.popleft()\n          if env._current_state.grid[x, y, workshop_idx] > 0:\n              return x, y, path\n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      queue.append(((nx, ny), path + [(dx, dy)]))\n      return None\n\n  def navigate_to_position(path):\n      actions = []\n      for dx, dy in path:\n          if dx > 0:\n              actions.append(env.ACTIONS.index(\"DOWN\"))\n          elif dx < 0:\n              actions.append(env.ACTIONS.index(\"UP\"))\n          if dy > 0:\n              actions.append(env.ACTIONS.index(\"RIGHT\"))\n          elif dy < 0:\n              actions.append(env.ACTIONS.index(\"LEFT\"))\n      return actions\n\n  def use_action():\n      return env.ACTIONS.index(\"USE\")\n\n  # Get the index of the item to craft\n  item_idx = env.world.cookbook.index[item]\n  \n  # Check if we have a recipe for this item\n  if item_idx not in env.world.cookbook.recipes:\n    return []\n  \n  # Get the ingredients required and their counts\n  ingredients = {k: v for k, v in env.world.cookbook.recipes[item_idx].items() if k != \"_at\"}\n  \n  # Find the workshop for crafting the item\n  workshop_name = find_workshop_for_item(item_idx)\n  if workshop_name is None:\n    return []\n  \n  # Find the index of the workshop in the environment\n  workshop_idx = env.world.workshop_indices[workshop_name]\n  \n  # Collect primitives required for crafting\n  actions = collect_primitives(list(ingredients.keys()), ingredients)\n\n  # Check if we can craft the item with current inventory\n  if all(env._current_state.inventory[i] >= count for i, count in ingredients.items()):\n      workshop_pos = find_closest_workshop(workshop_idx)\n      if not workshop_pos:\n          return []\n      _, _, path_to_workshop = workshop_pos\n      actions.extend(navigate_to_position(path_to_workshop))\n      actions.append(use_action())\n  else:\n      print(\"Not enough primitives to craft the item\")\n  \n  return actions", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T03:33:57.917342", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we already have the item in our inventory\n  if env._current_state.inventory[item_index] > 0:\n    return []\n\n  # Get primitives required for crafting the item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n  \n  actions = []\n  \n  # Collect all required primitives\n  for ingredient, count in recipe.items():\n      if ingredient == \"_key\":\n          continue\n      \n      ingredient_index = env.world.cookbook.index[ingredient]\n      \n      while env._current_state.inventory[ingredient_index] < count:\n          # Find the nearest source of the ingredient\n          nearest_source = find_nearest(env, ingredient_index)\n          \n          # Move to the nearest source and collect it\n          move_actions = get_move_to_position(env, nearest_source)\n          actions.extend(move_actions)\n          \n          # Use action to collect the item\n          actions.append(craft.USE)\n      \n      # Remove \"_key\" if it exists in recipe (it's used for workshop information)\n      if \"_key\" in recipe:\n          workshop_name = recipe[\"_key\"]\n          workshop_index = getattr(env.world, f\"{workshop_name}_index\")\n          \n          # Find the nearest workshop\n          nearest_workshop = find_nearest(env, workshop_index)\n          \n          # Move to the nearest workshop and use it\n          move_actions = get_move_to_position(env, nearest_workshop)\n          actions.extend(move_actions)\n          \n          # Use action to craft the item at the workshop\n          actions.append(craft.USE)\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-10T03:33:58.886635", "function_name": "craft", "function_body": "  def get_required_primitives(index):\n    # Get the primitives required to craft the given item index\n    return env.world.cookbook.primitives_for(index)\n\n  def navigate_to_workshop(workshop_index):\n    # Navigate to the nearest workshop with the given index\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    if len(workshop_positions) == 0:\n      return []\n    \n    target_pos = workshop_positions[0]\n    path_to_workshop = a_star_search(\n        env._current_state.pos, \n        target_pos, \n        env._current_state.grid\n    )\n    return convert_path_to_actions(path_to_workshop)\n\n  def convert_path_to_actions(path):\n    actions = []\n    current_pos = path.pop(0)\n    while path:\n      next_pos = path.pop(0)\n      delta_x, delta_y = next_pos[0] - current_pos[0], next_pos[1] - current_pos[1]\n      if delta_x == 1:\n          actions.append(craft.N_RIGHT)\n      elif delta_x == -1:\n          actions.append(craft.N_LEFT)\n      elif delta_y == 1:\n          actions.append(craft.N_DOWN)\n      elif delta_y == -1:\n          actions.append(craft.N_UP)\n      \n      current_pos = next_pos\n    return actions\n\n  def a_star_search(start, goal, grid):\n      open_set = collections.deque([(0, start)])\n      came_from = {}\n      g_score = {start: 0}\n      f_score = {start: heuristic(start, goal)}\n\n      while open_set:\n          _, current = open_set.popleft()\n\n          if current == goal:\n              return reconstruct_path(came_from, current)\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              if not is_valid_move(grid, current, neighbor):\n                  continue\n\n              tentative_g_score = g_score[current] + 1\n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                  open_set.append((f_score[neighbor], neighbor))\n\n      return []\n\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def is_valid_move(grid, current, neighbor):\n      if not (0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]):\n          return False\n      if np.any(grid[neighbor] != 0):  # Check if the cell is blocked\n          return False\n      if abs(current[0] - neighbor[0]) + abs(current[1] - neighbor[1]) > 1:  # Ensure only adjacent moves\n          return False\n      return True\n\n  def reconstruct_path(came_from, current):\n      total_path = [current]\n      while current in came_from:\n          current = came_from[current]\n          total_path.append(current)\n      return list(reversed(total_path))\n\n  item_index = env.world.cookbook.index[item]\n\n  # Get the primitives required to craft the given item index\n  required_primitives = get_required_primitives(item_index)\n\n  if not required_primitives:\n    return []\n\n  actions = []\n  for primitive, count in required_primitives.items():\n      # Collect the required primitives\n      collect_actions = collect_v2(env, env.world.cookbook.index[primitive])\n      actions.extend(collect_actions)\n      \n      # Check inventory to see if we have enough of this primitive\n      while np.sum(env._current_state.inventory[primitive]) < count:\n          collect_actions = collect_v2(env, env.world.cookbook.index[primitive])\n          actions.extend(collect_actions)\n\n  # Navigate to the workshop and craft the item\n  workshop_index = env.world.cookbook.workshop_for(item_index)\n  if workshop_index is not None:\n      actions.extend(navigate_to_workshop(workshop_index))\n      actions.append(craft.N_USE)  # Perform the USE action to craft the item\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-10T03:36:34.107160", "function_name": "craft", "function_body": "  def find_closest_workshop(workshop_indices):\n    pos = env._current_state.pos\n    closest_workshop = None\n    min_distance = float('inf')\n    for workshop_index in workshop_indices:\n      # We need to iterate over all positions on the grid.\n      for x in range(env.world.grid.shape[0]):\n        for y in range(env.world.grid.shape[1]):\n          if env._current_state.grid[x, y, workshop_index] > 0:\n            distance = abs(x - pos[0]) + abs(y - pos[1])\n            if distance < min_distance:\n              min_distance = distance\n              closest_workshop = (x, y)\n    return closest_workshop\n\n  def move_to_position(current_pos, target_pos):\n    actions = []\n    # Calculate the difference in coordinates.\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    # Move horizontally (LEFT or RIGHT).\n    if dx < 0:\n      actions.extend([craft.ACTION_LEFT] * abs(dx))\n    elif dx > 0:\n      actions.extend([craft.ACTION_RIGHT] * abs(dx))\n\n    # Move vertically (DOWN or UP).\n    if dy < 0:\n      actions.extend([craft.ACTION_DOWN] * abs(dy))\n    elif dy > 0:\n      actions.extend([craft.ACTION_UP] * abs(dy))\n\n    return actions\n\n  def collect_v2(env, primitive, required_count):\n    \"\"\"Function to collect the specified number of primitives.\"\"\"\n    # Get the index of the primitive.\n    primitive_index = env.world.cookbook.index[primitive]\n    actions = []\n\n    # Iterate over all positions on the grid.\n    for x in range(env.world.grid.shape[0]):\n      for y in range(env.world.grid.shape[1]):\n        if env._current_state.grid[x, y, primitive_index] > 0:\n          current_count = np.sum(env._current_state.inventory)\n          if current_count >= required_count:\n            break\n\n          # Move to the position of the primitive.\n          actions.extend(move_to_position(env._current_state.pos, (x, y)))\n\n          # Use the COLLECT action.\n          actions.append(craft.ACTION_COLLECT)\n\n    return actions\n\n  def align_with_workshop(env, workshop_index):\n    \"\"\"Function to align with the specified workshop.\"\"\"\n    pos = env._current_state.pos\n    for x in range(env.world.grid.shape[0]):\n      for y in range(env.world.grid.shape[1]):\n        if env._current_state.grid[x, y, workshop_index] > 0:\n          # Align horizontally.\n          dx = x - pos[0]\n          if dx < 0:\n            return craft.ACTION_LEFT\n          elif dx > 0:\n            return craft.ACTION_RIGHT\n\n          # Align vertically.\n          dy = y - pos[1]\n          if dy < 0:\n            return craft.ACTION_DOWN\n          elif dy > 0:\n            return craft.ACTION_UP\n    return None\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the desired item is a primitive; primitives cannot be crafted.\n  if item_index in env.world.cookbook.primitives:\n    return []\n\n  # Fetch the recipe for crafting the specified item.\n  recipe = env.world.cookbook.recipes.get(item_index)\n\n  # If no valid recipe exists or \"_key\" not specified, return an empty action list.\n  if not recipe or \"_key\" not in recipe:\n    return []\n\n  workshop_key = recipe[\"_key\"]\n  workshop_indices = [env.world.cookbook.index[workshop_key]]\n\n  actions = []\n  # Check inventory for sufficient primitives.\n  missing_ingredients = {}\n  for ingredient, count in recipe.items():\n    if ingredient == \"_key\":\n      continue\n    ingredient_index = env.world.cookbook.index[ingredient]\n    current_count = env._current_state.inventory[ingredient_index]\n    if current_count < count:\n      missing_ingredients[ingredient] = count - current_count\n\n  # If any ingredients are missing, attempt to collect them.\n  for ingredient, required_count in missing_ingredients.items():\n    ingredient_index = env.world.cookbook.index[ingredient]\n    actions.extend(collect_v2(env, ingredient, required_count))\n\n  # Find the closest workshop that can craft the item.\n  closest_workshop_pos = find_closest_workshop(workshop_indices)\n  if closest_workshop_pos is None:\n    return []\n\n  # Move to the closest workshop.\n  target_x, target_y = closest_workshop_pos\n  actions.extend(move_to_position(env._current_state.pos, (target_x, target_y)))\n\n  # Align with the correct workshop before using it to craft the item.\n  alignment_action = align_with_workshop(env, workshop_indices[0])\n  if alignment_action:\n    actions.append(alignment_action)\n\n  # Use the USE action at the correct location.\n  actions.append(craft.ACTION_USE)\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T03:36:35.199243", "function_name": "craft", "function_body": "  def find_closest_workshop(workshop_indices):\n    pos = env._current_state.pos\n    closest_workshop = None\n    min_distance = float('inf')\n    for workshop_index in workshop_indices:\n      # Iterate over all positions on the grid.\n      for x in range(env.world.grid.shape[0]):\n        for y in range(env.world.grid.shape[1]):\n          if env._current_state.grid[x, y, workshop_index] > 0:\n            distance = abs(x - pos[0]) + abs(y - pos[1])\n            if distance < min_distance:\n              min_distance = distance\n              closest_workshop = (x, y)\n    return closest_workshop\n\n  def move_to_position(current_pos, target_pos):\n    actions = []\n    # Calculate the difference in coordinates.\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    # Move horizontally (LEFT or RIGHT).\n    if dx < 0:\n      actions.extend([craft.ACTION_LEFT] * abs(dx))\n    elif dx > 0:\n      actions.extend([craft.ACTION_RIGHT] * abs(dx))\n\n    # Move vertically (DOWN or UP).\n    if dy < 0:\n      actions.extend([craft.ACTION_DOWN] * abs(dy))\n    elif dy > 0:\n      actions.extend([craft.ACTION_UP] * abs(dy))\n\n    return actions\n\n  def collect_v2(env, primitive, required_count):\n    \"\"\"Function to collect the specified number of primitives.\"\"\"\n    # Get the index of the primitive.\n    primitive_index = env.world.cookbook.index[primitive]\n    actions = []\n\n    # Iterate over all positions on the grid.\n    for x in range(env.world.grid.shape[0]):\n      for y in range(env.world.grid.shape[1]):\n        if env._current_state.grid[x, y, primitive_index] > 0:\n          current_count = np.sum(env._current_state.inventory)\n          if current_count >= required_count:\n            break\n\n          # Move to the position of the primitive.\n          actions.extend(move_to_position(env._current_state.pos, (x, y)))\n\n          # Use the COLLECT action.\n          actions.append(craft.ACTION_COLLECT)\n\n    return actions\n\n  def move_to_workshop(env, workshop_index):\n    \"\"\"Function to move towards a workshop.\"\"\"\n    pos = env._current_state.pos\n    closest_workshop_pos = None\n    min_distance = float('inf')\n\n    # Iterate over all positions on the grid.\n    for x in range(env.world.grid.shape[0]):\n      for y in range(env.world.grid.shape[1]):\n        if env._current_state.grid[x, y, workshop_index] > 0:\n          distance = abs(x - pos[0]) + abs(y - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (x, y)\n\n    # If no valid workshop position is found, return an empty action list.\n    if closest_workshop_pos is None:\n      return []\n\n    target_x, target_y = closest_workshop_pos\n\n    actions = move_to_position(env._current_state.pos, (target_x, target_y))\n\n    return actions\n\n  def align_with_workshop(env, workshop_index):\n    \"\"\"Function to align with a workshop before using it.\"\"\"\n    pos = env._current_state.pos\n    closest_workshop_pos = None\n\n    # Iterate over all positions on the grid.\n    for x in range(env.world.grid.shape[0]):\n      for y in range(env.world.grid.shape[1]):\n        if env._current_state.grid[x, y, workshop_index] > 0:\n          closest_workshop_pos = (x, y)\n          break\n\n    # If no valid workshop position is found, return None.\n    if closest_workshop_pos is None:\n      return None\n\n    target_x, target_y = closest_workshop_pos\n    alignment_action = None\n\n    # Check if the agent needs to align horizontally or vertically.\n    if pos[0] != target_x:\n      if pos[0] < target_x:\n        alignment_action = craft.ACTION_RIGHT\n      else:\n        alignment_action = craft.ACTION_LEFT\n    elif pos[1] != target_y:\n      if pos[1] < target_y:\n        alignment_action = craft.ACTION_UP\n      else:\n        alignment_action = craft.ACTION_DOWN\n\n    return alignment_action\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the desired item is a primitive; primitives cannot be crafted.\n  if item_index in env.world.cookbook.primitives:\n    return []\n\n  # Fetch the recipe for crafting the specified item.\n  recipe = env.world.cookbook.recipes.get(item_index)\n\n  # If no valid recipe exists or \"_key\" not specified, return an empty action list.\n  if not recipe or \"_key\" not in recipe:\n    return []\n\n  workshop_key = recipe[\"_key\"]\n  workshop_indices = [env.world.cookbook.index[workshop_key]]\n\n  actions = []\n  # Check inventory for sufficient primitives.\n  missing_ingredients = {}\n  for ingredient, count in recipe.items():\n    if ingredient == \"_key\":\n      continue\n    ingredient_index = env.world.cookbook.index[ingredient]\n    current_count = env._current_state.inventory[ingredient_index]\n    if current_count < count:\n      missing_ingredients[ingredient] = count - current_count\n\n  # If any ingredients are missing, attempt to collect them.\n  for ingredient, required_count in missing_ingredients.items():\n    ingredient_index = env.world.cookbook.index[ingredient]\n    actions.extend(collect_v2(env, ingredient, required_count))\n\n  # Find the closest workshop that can craft the item.\n  closest_workshop_pos = find_closest_workshop(workshop_indices)\n  if closest_workshop_pos is None:\n    return []\n\n  # Move to the closest workshop.\n  target_x, target_y = closest_workshop_pos\n  actions.extend(move_to_position(env._current_state.pos, (target_x, target_y)))\n\n  # Align with the correct workshop before using it to craft the item.\n  alignment_action = align_with_workshop(env, workshop_indices[0])\n  if alignment_action:\n    actions.append(alignment_action)\n\n  # Use the USE action at the correct location.\n  actions.append(craft.ACTION_USE)\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T03:37:30.922433", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the desired item has a recipe in the cookbook\n  if item_index not in env.world.cookbook.recipes:\n    print(f\"No recipe found for {item}.\")\n    return []\n\n  # Get the required ingredients and their counts\n  required_ingredients = env.world.cookbook.recipes[item_index]\n\n  actions = []\n  \n  # Check each ingredient requirement and collect if necessary\n  for ingredient, count in required_ingredients.items():\n    # Skip the _key which contains workshop information\n    if ingredient == \"_key\":\n      continue\n    \n    # Get the index of the current ingredient\n    ingredient_index = env.world.cookbook.index.get(ingredient)\n    \n    # Check if we already have enough of this ingredient in our inventory\n    while env._current_state.inventory[ingredient_index] < count:\n      # Generate actions to collect the required amount of ingredients\n      actions.extend(collect_v2(env, ingredient))\n      \n      # Update state after collecting the item (if needed)\n      # Note: This part is handled by the DSL interpreter, so we just accumulate actions\n      \n    # Check if we have enough of this ingredient in our inventory now\n    if env._current_state.inventory[ingredient_index] < count:\n      print(f\"Could not collect enough {ingredient}.\")\n      return []\n\n  # Get the workshop index from the recipe where the item should be crafted\n  workshop_key = required_ingredients[\"_key\"]\n  workshop_index = env.world.cookbook.index.get(workshop_key)\n  \n  if workshop_index is None:\n    print(f\"No workshop found for crafting {item} at '{workshop_key}'.\")\n    return []\n\n  # Find a path to the workshop\n  actions.extend(move_to_workshop_v2(env, workshop_index))\n\n  # Face the workshop and use it to craft the item\n  actions.append(env.world.cookbook.index[\"USE\"])\n  \n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-10T03:37:31.968483", "function_name": "craft", "function_body": "  # Get the index of the goal item\n  goal_index = env.world.cookbook.index[item]\n\n  # Check if the goal is achievable\n  if goal_index not in env.world.cookbook.recipes:\n    print(f\"No recipe found for {item}.\")\n    return []\n\n  # Get the required ingredients and their counts\n  required_ingredients = env.world.cookbook.recipes[goal_index]\n  workshop_index = None\n\n  # Identify the workshop where the crafting should occur\n  if \"_at\" in required_ingredients:\n      workshop_name = required_ingredients[\"_at\"]\n      workshop_index = env.world.workshop_indices[workshop_name]\n\n  print(f\"Required ingredients for {item}: {required_ingredients}\")\n  print(f\"Workshop index: {workshop_index}\")\n\n  # Check if the agent has all required ingredients\n  current_inventory = env._current_state.inventory\n  actions_to_take = []\n\n  for ingredient, count in required_ingredients.items():\n      if ingredient == \"_at\":\n          continue\n\n      ingredient_index = env.world.cookbook.index[ingredient]\n\n      # If the agent does not have enough of this ingredient, plan to collect more\n      while current_inventory[ingredient_index] < count:\n          # Move towards a cell with the required primitive or item\n          actions_to_take.extend(collect(env, ingredient))\n\n          # Update inventory after collecting\n          _, _, observations = env.step(actions_to_take[-1])\n          env._current_state.inventory = observations['features_dict']['inventory']\n\n  # If we have all ingredients, proceed to the workshop and craft the item\n  if workshop_index is not None:\n      # Add actions to move towards the nearest workshop\n      # For simplicity, assume a direct path to the first workshop found.\n      # A more sophisticated approach could involve pathfinding.\n      actions_to_take.extend(move(env, env.world.workshop_indices[0]))\n\n      # Add the USE action to craft the item\n      actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-10T03:38:43.556070", "function_name": "craft", "function_body": "  # Check if we already have the item in inventory\n  goal_index = env.world.cookbook.index[item]\n  if env._current_state.inventory[goal_index] > 0:\n    return []\n\n  actions = []\n  \n  # Get the recipe for the item and required primitives\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  # Iterate over the ingredients in the recipe\n  for ingredient, count in recipe.items():\n      if ingredient == \"_at\":\n          workshop = recipe[\"_at\"]\n          workshop_index = env.world.cookbook.index[workshop]\n          workshop_pos = find_closest_workshop(env._current_state.grid, workshop_index)\n          actions.extend(move_to_position(env._current_state, workshop_pos))\n          continue\n      else:\n          ingredient_index = env.world.cookbook.index[ingredient]\n          # Collect the required amount of the ingredient\n          if env._current_state.inventory[ingredient_index] < count:\n              collect_actions = collect_v2(env, ingredient)\n              actions.extend(collect_actions)\n\n  # Once all ingredients are collected, use the USE action at the workshop to craft the item\n  actions.append(4)  # Use action\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-10T03:38:44.537110", "function_name": "craft", "function_body": "  def get_recipe(item_index):\n    # Get the recipe for the specified item\n    if item_index in env.world.cookbook.recipes:\n      return env.world.cookbook.recipes[item_index]\n    else:\n      raise ValueError(f\"No recipe found for item index {item_index}\")\n\n  def has_primitives(primitive_indices, counts):\n    # Check if we have enough primitives to satisfy the recipe\n    inventory = env._current_state.inventory\n    for primitive_index, count in zip(primitive_indices, counts):\n      if inventory[primitive_index] < count:\n        return False\n    return True\n\n  def find_workshop(workshop_index):\n    # Find the nearest workshop that matches the specified index\n    grid = env._current_state.grid\n    pos = env._current_state.pos\n    for dx in range(-10, 11):  # Arbitrary search radius\n      for dy in range(-10, 11):\n        nx, ny = pos[0] + dx, pos[1] + dy\n        if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n          if grid[nx, ny, workshop_index] > 0:\n            return (nx, ny)\n    raise ValueError(f\"No workshop found for index {workshop_index}\")\n\n  def move_to_position(target_pos):\n    # Generate actions to move the agent to a specific position\n    current_pos = env._current_state.pos\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n    actions = []\n    if dx > 0:\n      actions.extend([craft.RIGHT] * abs(dx))\n    elif dx < 0:\n      actions.extend([craft.LEFT] * abs(dx))\n    if dy > 0:\n      actions.extend([craft.DOWN] * abs(dy))\n    elif dy < 0:\n      actions.extend([craft.UP] * abs(dy))\n    return actions\n\n  def face_workshop(workshop_pos):\n    # Generate action to face the workshop\n    current_pos = env._current_state.pos\n    dx = workshop_pos[0] - current_pos[0]\n    dy = workshop_pos[1] - current_pos[1]\n    if dx > 0:\n      return craft.RIGHT\n    elif dx < 0:\n      return craft.LEFT\n    elif dy > 0:\n      return craft.DOWN\n    elif dy < 0:\n      return craft.UP\n\n  # Get the index of the item from its name\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the primitives needed for crafting the item\n  recipe = get_recipe(item_index)\n  primitive_indices, counts = [], []\n  workshop_index = None\n  \n  for ingredient_index, count in recipe.items():\n    if ingredient_index == \"_key\":\n      workshop_index = env.world.cookbook.index[count]\n    else:\n      primitive_indices.append(ingredient_index)\n      counts.append(count)\n\n  if not has_primitives(primitive_indices, counts):\n    return []  # We don't have all the required primitives\n  \n  # Find the nearest workshop\n  workshop_pos = find_workshop(workshop_index)\n  \n  # Generate actions to move to the workshop and face it\n  actions = []\n  actions.extend(move_to_position(workshop_pos))\n  actions.append(face_workshop(workshop_pos))\n  actions.append(craft.USE)  # Use action to craft the item\n  \n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-10T03:40:01.378871", "function_name": "craft", "function_body": "  actions = []\n\n  # Get the goal index from the item name\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  # Get the primitives required for crafting the item\n  required_primitives = cookbook.primitives_for(goal_index)\n\n  # Collect all required primitives if not already in inventory\n  for primitive, count in required_primitives.items():\n    while np.sum(env._current_state.inventory[primitive]) < count:\n      actions.extend(collect_v2(env, primitive))\n\n  # Find the workshop where the item can be crafted\n  recipe = cookbook.recipes[goal_index]\n  workshop_name = list(recipe.keys())[-1] if \"_key\" in recipe else \"_at\"\n  workshop_index = cookbook.index.get(workshop_name)\n\n  # Move to the nearest workshop\n  actions.extend(move_to_workshop(env, workshop_index))\n\n  # Craft the item by using the USE action at the workshop\n  actions.append(craft.CRAFT_FUNC(\"USE\"))\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-10T03:40:02.376311", "function_name": "craft", "function_body": "  # Get the index of the desired item from the cookbook\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item has a recipe\n  if item_index not in env.world.cookbook.recipes:\n    print(f\"No recipe found for {item}.\")\n    return []\n\n  # Get the ingredients required and the workshop index (if specified)\n  recipe = env.world.cookbook.recipes[item_index]\n  ingredients = recipe.copy()\n  workshop_index = None\n\n  if \"_at\" in recipe:\n      workshop_name = recipe.pop(\"_at\")\n      workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Check if we have all the required primitives or items\n  for ingredient, count in ingredients.items():\n    needed_count = count - env._current_state.inventory[ingredient]\n    if needed_count > 0:\n      return []\n\n  # If we have all ingredients, proceed to use the workshop\n  actions = []\n  if workshop_index is not None:\n      # Move to the workshop and face it\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n      if len(workshop_positions) == 0:\n          print(f\"No {workshop_name} found in the grid.\")\n          return []\n\n      target_workshop_pos = tuple(workshop_positions[0])\n      \n      # Calculate actions to move to the target workshop position\n      while env._current_state.pos != target_workshop_pos:\n          delta_x = target_workshop_pos[1] - env._current_state.pos[1]\n          delta_y = target_workshop_pos[0] - env._current_state.pos[0]\n\n          if delta_x > 0:\n              actions.append(env.world.cookbook.index[\"RIGHT\"])\n          elif delta_x < 0:\n              actions.append(env.world.cookbook.index[\"LEFT\"])\n\n          if delta_y > 0:\n              actions.append(env.world.cookbook.index[\"DOWN\"])\n          elif delta_y < 0:\n              actions.append(env.world.cookbook.index[\"UP\"])\n\n      # Ensure the agent is facing the correct direction to use the workshop\n      correct_dir = (target_workshop_pos[1] - env._current_state.pos[1], target_workshop_pos[0] - env._current_state.pos[0])\n      current_dir = (env.world.cookbook.index[\"RIGHT\"], env.world.cookbook.index[\"DOWN\"])\n\n      if correct_dir == (1, 0):\n          actions.append(env.world.cookbook.index[\"RIGHT\"])\n      elif correct_dir == (-1, 0):\n          actions.append(env.world.cookbook.index[\"LEFT\"])\n      elif correct_dir == (0, 1):\n          actions.append(env.world.cookbook.index[\"DOWN\"])\n      elif correct_dir == (0, -1):\n          actions.append(env.world.cookbook.index[\"UP\"])\n\n      # Perform the USE action to craft the item\n      actions.append(env.world.cookbook.index[\"USE\"])\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-10T03:42:32.308923", "function_name": "craft", "function_body": "  def find_workshop_for_item(item_idx):\n      for recipe in env.world.cookbook.recipes.values():\n          if \"_key\" in recipe and recipe[\"_key\"] == item_idx:\n              return recipe.get(\"_at\", None)\n      return None\n\n  def collect_primitives(primitive_indices, required_counts):\n      actions = []\n      inventory = env._current_state.inventory\n      for i in primitive_indices:\n          while inventory[i] < required_counts[i]:\n              primitive_name = env.world.cookbook.index.get(i)\n              actions.extend(collect(env, primitive_name))\n      return actions\n\n  def find_closest_workshop(env, workshop_idx):\n      directions = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n      queue = collections.deque([(env._current_state.pos, [])])\n      visited = set()\n      \n      while queue:\n          (x, y), path = queue.popleft()\n          if env._current_state.grid[x, y, workshop_idx] > 0:\n              return x, y\n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n                  if (nx, ny) not in visited and env._current_state.grid[nx, ny].sum() == 0:\n                      visited.add((nx, ny))\n                      queue.append(((nx, ny), path + [(dx, dy)]))\n      return None\n\n  def navigate_to_position(position):\n      target_x, target_y = position\n      start_x, start_y = env._current_state.pos\n      \n      actions = []\n      \n      while start_x != target_x or start_y != target_y:\n          if start_x < target_x and env._current_state.grid[start_x + 1, start_y].sum() == 0:\n              actions.append(env.world.DOWN)\n              start_x += 1\n          elif start_x > target_x and env._current_state.grid[start_x - 1, start_y].sum() == 0:\n              actions.append(env.world.UP)\n              start_x -= 1\n          elif start_y < target_y and env._current_state.grid[start_x, start_y + 1].sum() == 0:\n              actions.append(env.world.RIGHT)\n              start_y += 1\n          elif start_y > target_y and env._current_state.grid[start_x, start_y - 1].sum() == 0:\n              actions.append(env.world.LEFT)\n              start_y -= 1\n      \n      return [action for action in actions]\n\n  def use_action():\n      return env.world.USE\n\n  # Get the index of the item to craft\n  item_idx = env.world.cookbook.index[item]\n  \n  # Check if we have a recipe for this item\n  if item_idx not in env.world.cookbook.recipes:\n      return []\n  \n  # Get the ingredients required and their counts\n  ingredients = {k: v for k, v in env.world.cookbook.recipes[item_idx].items() if k != \"_at\"}\n  \n  # Find the workshop for crafting the item\n  workshop_name = find_workshop_for_item(item_idx)\n  if workshop_name is None:\n      return []\n  \n  # Find the index of the workshop in the environment\n  workshop_idx = env.world.cookbook.index[workshop_name]\n  \n  # Collect primitives required for crafting\n  actions = collect_primitives(list(ingredients.keys()), ingredients)\n  \n  # Navigate to the workshop and perform USE action\n  workshop_pos = find_closest_workshop(env, workshop_idx)\n  if not workshop_pos:\n      return []\n  \n  actions.extend(navigate_to_position(workshop_pos))\n  actions.append(use_action())\n  \n  return actions", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T03:42:33.385901", "function_name": "craft", "function_body": "  def find_workshop_for_item(item_idx):\n    for recipe in env.world.cookbook.recipes.values():\n        if \"_key\" in recipe and recipe[\"_key\"] == item_idx:\n            return recipe.get(\"_at\", None)\n    return None\n\n  def collect_primitives(primitive_indices, required_counts):\n      actions = []\n      inventory = env._current_state.inventory\n      for i in primitive_indices:\n          while inventory[i] < required_counts[i]:\n              primitive_name = env.world.cookbook.index.get(i)\n              actions.extend(collect(env, primitive_name))\n      return actions\n\n  def find_closest_workshop(env, workshop_idx):\n      directions = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n      queue = collections.deque([(env._current_state.pos, [])])\n      visited = set()\n      \n      while queue:\n          (x, y), path = queue.popleft()\n          if env._current_state.grid[x, y, workshop_idx] > 0:\n              return x, y\n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n                  if (nx, ny) not in visited and env._current_state.grid[nx, ny].sum() == 0:\n                      visited.add((nx, ny))\n                      queue.append(((nx, ny), path + [(dx, dy)]))\n      return None\n\n  def navigate_to_position(position):\n      target_x, target_y = position\n      start_x, start_y = env._current_state.pos\n      \n      actions = []\n      \n      while start_x != target_x or start_y != target_y:\n          if start_x < target_x and env._current_state.grid[start_x + 1, start_y].sum() == 0:\n              actions.append(env.world.DOWN)\n              start_x += 1\n          elif start_x > target_x and env._current_state.grid[start_x - 1, start_y].sum() == 0:\n              actions.append(env.world.UP)\n              start_x -= 1\n          elif start_y < target_y and env._current_state.grid[start_x, start_y + 1].sum() == 0:\n              actions.append(env.world.RIGHT)\n              start_y += 1\n          elif start_y > target_y and env._current_state.grid[start_x, start_y - 1].sum() == 0:\n              actions.append(env.world.LEFT)\n              start_y -= 1\n      \n      return [action for action in actions]\n\n  def use_action():\n      return env.world.USE\n\n  # Get the index of the item to craft\n  item_idx = env.world.cookbook.index[item]\n  \n  # Check if we have a recipe for this item\n  if item_idx not in env.world.cookbook.recipes:\n      return []\n  \n  # Get the ingredients required and their counts\n  ingredients = {k: v for k, v in env.world.cookbook.recipes[item_idx].items() if k != \"_at\"}\n  \n  # Find the workshop for crafting the item\n  workshop_name = find_workshop_for_item(item_idx)\n  if workshop_name is None:\n      return []\n  \n  # Find the index of the workshop in the environment\n  workshop_idx = env.world.workshop_indices[workshop_name]\n  \n  # Collect primitives required for crafting\n  actions = collect_primitives(list(ingredients.keys()), ingredients)\n  \n  # Navigate to the workshop and perform USE action\n  workshop_pos = find_closest_workshop(env, workshop_idx)\n  if not workshop_pos:\n      return []\n  \n  actions.extend(navigate_to_position(workshop_pos))\n  actions.append(use_action())\n  \n  return actions", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T03:45:37.045691", "function_name": "craft", "function_body": "  def find_path(start, end, grid):\n    queue = collections.deque([(start, [])])\n    visited = set([start])\n    while queue:\n        (x, y), path = queue.popleft()\n        if (x, y) == end:\n            return path + [(x, y)]\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            nx, ny = x + dx, y + dy\n            if 0 <= nx < grid.shape[1] and 0 <= ny < grid.shape[0] and grid[ny, nx].sum() == 0 and (nx, ny) not in visited:\n                queue.append(((nx, ny), path + [(x, y)]))\n                visited.add((nx, ny))\n    return None\n\n  def move_towards(current_pos, target_pos):\n      cx, cy = current_pos\n      tx, ty = target_pos\n      actions = []\n      while (cx, cy) != (tx, ty):\n          if cx < tx:\n              actions.append(craft.CraftLab.ACTIONS['RIGHT'])\n              cx += 1\n          elif cx > tx:\n              actions.append(craft.CraftLab.ACTIONS['LEFT'])\n              cx -= 1\n          elif cy < ty:\n              actions.append(craft.CraftLab.ACTIONS['DOWN'])\n              cy += 1\n          else:\n              actions.append(craft.CraftLab.ACTIONS['UP'])\n              cy -= 1\n      return actions\n\n  def face_direction(current_pos, target_pos):\n      cx, cy = current_pos\n      tx, ty = target_pos\n      if cx < tx:\n          direction = craft.CraftLab.DIRECTIONS['RIGHT']\n      elif cx > tx:\n          direction = craft.CraftLab.DIRECTIONS['LEFT']\n      elif cy < ty:\n          direction = craft.CraftLab.DIRECTIONS['DOWN']\n      else:\n          direction = craft.CraftLab.DIRECTIONS['UP']\n      \n      # Calculate the current direction based on pos history\n      dx, dy = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n      if dx > 0 and env._current_state.direction != 'RIGHT':\n          actions.append(craft.CraftLab.ACTIONS['TURN_RIGHT'])\n      elif dx < 0 and env._current_state.direction != 'LEFT':\n          actions.append(craft.CraftLab.ACTIONS['TURN_LEFT'])\n      elif dy > 0 and env._current_state.direction != 'DOWN':\n          actions.append(craft.CraftLab.ACTIONS['TURN_DOWN'])\n      else:\n          actions.append(craft.CraftLab.ACTIONS['TURN_UP'])\n\n      return actions\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the primitives required to craft the desired item\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n  \n  actions = []\n  \n  for primitive_index, count in primitives_required.items():\n    if env._current_state.inventory[primitive_index] < count:\n      return []  # Return empty action list if any primitive is not sufficient\n\n  workshop_index = None\n  \n  # Find out which workshop is needed for crafting the desired item\n  for output_item, recipe in env.world.cookbook.recipes.items():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n      workshop_index = recipe.get(\"_at\", None)\n      break\n\n  if workshop_index is None:\n    return []  # Return empty action list if no workshop found for the desired item\n\n  # Find the position of the workshop on the grid\n  workshop_position = None\n  for y in range(env._current_state.grid.shape[0]):\n    for x in range(env._current_state.grid.shape[1]):\n      if env._current_state.grid[y, x, workshop_index] == 1:\n        workshop_position = (x, y)\n        break\n    if workshop_position:\n      break\n\n  if workshop_position is None:\n    return []  # Return empty action list if the workshop position not found\n\n  # Generate actions to move to the workshop\n  path_to_workshop = find_path(env._current_state.pos, workshop_position, env._current_state.grid)\n  \n  for pos in path_to_workshop[:-1]:\n      actions.extend(move_towards(env._current_state.pos, pos))\n      # Update the current state position after each move\n      env._current_state.pos = pos\n\n  # Turn to face the workshop\n  actions.extend(face_direction(env._current_state.pos, workshop_position))\n\n  # Perform the USE action to craft the item\n  actions.append(craft.CraftLab.ACTIONS['USE'])\n  \n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T03:45:38.089534", "function_name": "craft", "function_body": "  def find_path(start, end, grid):\n    queue = collections.deque([(start, [])])\n    visited = set([start])\n    while queue:\n        (x, y), path = queue.popleft()\n        if (x, y) == end:\n            return path + [(x, y)]\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            nx, ny = x + dx, y + dy\n            if 0 <= nx < grid.shape[1] and 0 <= ny < grid.shape[0]:\n                if grid[ny, nx].sum() == 0 and (nx, ny) not in visited:\n                    queue.append(((nx, ny), path + [(x, y)]))\n                    visited.add((nx, ny))\n    return None\n\n  def move_towards(current_pos, target_pos):\n      cx, cy = current_pos\n      tx, ty = target_pos\n      actions = []\n      while (cx, cy) != (tx, ty):\n          if cx < tx:\n              actions.append(craft.CraftLab.ACTIONS['RIGHT'])\n              cx += 1\n          elif cx > tx:\n              actions.append(craft.CraftLab.ACTIONS['LEFT'])\n              cx -= 1\n          elif cy < ty:\n              actions.append(craft.CraftLab.ACTIONS['DOWN'])\n              cy += 1\n          else:\n              actions.append(craft.CraftLab.ACTIONS['UP'])\n              cy -= 1\n      return actions\n\n  def face_direction(current_pos, target_pos):\n      cx, cy = current_pos\n      tx, ty = target_pos\n      if cx < tx:\n          direction = craft.CraftLab.DIRECTIONS['RIGHT']\n      elif cx > tx:\n          direction = craft.CraftLab.DIRECTIONS['LEFT']\n      elif cy < ty:\n          direction = craft.CraftLab.DIRECTIONS['DOWN']\n      else:\n          direction = craft.CraftLab.DIRECTIONS['UP']\n      \n      # Generate actions to face the correct direction\n      current_direction = env._current_state.pos\n      if current_direction == 'RIGHT' and direction != 'RIGHT':\n          actions.append(craft.CraftLab.ACTIONS['LEFT'])\n      elif current_direction == 'LEFT' and direction != 'LEFT':\n          actions.append(craft.CraftLab.ACTIONS['RIGHT'])\n      elif current_direction == 'UP' and direction != 'UP':\n          actions.append(craft.CraftLab.ACTIONS['DOWN'])\n      elif current_direction == 'DOWN' and direction != 'DOWN':\n          actions.append(craft.CraftLab.ACTIONS['UP'])\n\n      return actions\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the primitives required to craft the desired item\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n  \n  actions = []\n  \n  for primitive_index, count in primitives_required.items():\n    if env._current_state.inventory[primitive_index] < count:\n      return []  # Return empty action list if any primitive is not sufficient\n\n  workshop_index = None\n  \n  # Find out which workshop is needed for crafting the desired item\n  for output_item, recipe in env.world.cookbook.recipes.items():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n      workshop_index = recipe.get(\"_at\", None)\n      break\n\n  if workshop_index is None:\n    return []  # Return empty action list if no workshop found for the desired item\n\n  # Find the position of the workshop on the grid\n  workshop_position = None\n  for y in range(env._current_state.grid.shape[0]):\n    for x in range(env._current_state.grid.shape[1]):\n      if env._current_state.grid[y, x, workshop_index] == 1:\n        workshop_position = (x, y)\n        break\n    if workshop_position:\n      break\n\n  if workshop_position is None:\n    return []  # Return empty action list if the workshop position not found\n\n  # Generate actions to move to the workshop\n  path_to_workshop = find_path(env._current_state.pos, workshop_position, env._current_state.grid)\n  \n  for pos in path_to_workshop[:-1]:\n      actions.extend(move_towards(env._current_state.pos, pos))\n      # Update the current state position after each move\n      env._current_state.pos = pos\n\n  # Turn to face the workshop\n  actions.extend(face_direction(env._current_state.pos, workshop_position))\n\n  # Perform the USE action to craft the item\n  actions.append(craft.CraftLab.ACTIONS['USE'])\n  \n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T03:47:49.022842", "function_name": "craft", "function_body": "  def calculate_path(start_pos, target_pos, grid):\n    \"\"\"A simple BFS implementation to find a path from start_pos to target_pos.\"\"\"\n    queue = collections.deque([(start_pos, [])])\n    visited = set()\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]  # RIGHT, DOWN, LEFT, UP\n\n    while queue:\n        (x, y), path = queue.popleft()\n\n        if (x, y) == target_pos:\n            return path\n\n        if (x, y) in visited:\n            continue\n        visited.add((x, y))\n\n        for dx, dy in directions:\n            nx, ny = x + dx, y + dy\n            if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and grid[nx, ny, -1] == 0:  # Assuming the last layer is walkable\n                queue.append(((nx, ny), path + [(dx, dy)]))\n\n    return None\n\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = env._current_state.inventory.copy()\n\n  # Check if all ingredients are available\n  required_ingredients = {cookbook.index[k]: v for k, v in recipe.items()}\n\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if not can_craft:\n    return []\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No available workshop to craft item\")\n\n  # Select the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n  # Calculate the path to the nearest workshop\n  path = calculate_path(tuple(current_position), nearest_workshop_pos, env._current_state.grid)\n\n  if not path:\n    raise ValueError(\"No valid path found to reach the workshop\")\n\n  actions_to_take = []\n\n  current_direction = env._current_state.dir\n\n  for (dx, dy) in path:\n      target_direction = None\n      if dx == 1 and dy == 0:\n          target_direction = craft.RIGHT\n      elif dx == -1 and dy == 0:\n          target_direction = craft.LEFT\n      elif dx == 0 and dy == 1:\n          target_direction = craft.DOWN\n      elif dx == 0 and dy == -1:\n          target_direction = craft.UP\n\n      while current_direction != target_direction:\n          actions_to_take.append(craft.TURN_RIGHT)\n          current_direction = (current_direction + 1) % 4\n\n      actions_to_take.append(craft.MOVE_FORWARD)\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T03:47:50.074254", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = env._current_state.inventory.copy()\n\n  # Check if all ingredients are available\n  required_ingredients = {cookbook.index[k]: v for k, v in recipe.items()}\n\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if not can_craft:\n    return []\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No available workshop to craft item\")\n\n  # Select the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n  # Calculate actions to move the agent to the nearest workshop\n  dx = nearest_workshop_pos[0] - current_position[0]\n  dy = nearest_workshop_pos[1] - current_position[1]\n\n  actions_to_take = []\n\n  if dx > 0:\n    actions_to_take.extend([craft.MOVE_RIGHT for _ in range(dx)])\n  elif dx < 0:\n    actions_to_take.extend([craft.MOVE_LEFT for _ in range(-dx)])\n\n  if dy > 0:\n    actions_to_take.extend([craft.MOVE_DOWN for _ in range(dy)])\n  elif dy < 0:\n    actions_to_take.extend([craft.MOVE_UP for _ in range(-dy)])\n\n  # Calculate the target direction to face the workshop\n  current_direction = env._current_state.dir\n\n  if dx > 0:\n      while current_direction != craft.RIGHT:\n          actions_to_take.append(craft.TURN_RIGHT)\n          current_direction = (current_direction + 1) % 4\n  elif dx < 0:\n      while current_direction != craft.LEFT:\n          actions_to_take.append(craft.TURN_LEFT)\n          current_direction = (current_direction - 1) % 4\n  elif dy > 0:\n      while current_direction != craft.DOWN:\n          actions_to_take.append(craft.TURN_RIGHT)\n          current_direction = (current_direction + 1) % 4\n  elif dy < 0:\n      while current_direction != craft.UP:\n          actions_to_take.append(craft.TURN_LEFT)\n          current_direction = (current_direction - 1) % 4\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T03:50:39.699902", "function_name": "craft", "function_body": "  def find_closest_workshop(workshop_indices):\n    pos = env._current_state.pos\n    closest_workshop = None\n    min_distance = float('inf')\n    for workshop_index in workshop_indices:\n      # Iterate over all positions on the grid to find workshops.\n      for x in range(env.world.grid.shape[0]):\n        for y in range(env.world.grid.shape[1]):\n          if env._current_state.grid[x, y, workshop_index] > 0:\n            distance = abs(x - pos[0]) + abs(y - pos[1])\n            if distance < min_distance:\n              min_distance = distance\n              closest_workshop = (x, y)\n    return closest_workshop\n\n  def move_to_position(current_pos, target_pos):\n    actions = []\n    # Calculate the difference in coordinates.\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    # Move horizontally (LEFT or RIGHT).\n    if dx < 0:\n      actions.extend([craft.ACTION_LEFT] * abs(dx))\n    elif dx > 0:\n      actions.extend([craft.ACTION_RIGHT] * abs(dx))\n\n    # Move vertically (DOWN or UP).\n    if dy < 0:\n      actions.extend([craft.ACTION_DOWN] * abs(dy))\n    elif dy > 0:\n      actions.extend([craft.ACTION_UP] * abs(dy))\n\n    return actions\n\n  def collect_v2(env, primitive, required_count):\n    \"\"\"Function to collect the specified number of primitives.\"\"\"\n    # Get the index of the primitive.\n    primitive_index = env.world.cookbook.index[primitive]\n    actions = []\n\n    while np.sum(env._current_state.inventory) < required_count:\n      found = False\n      for x in range(env.world.grid.shape[0]):\n        for y in range(env.world.grid.shape[1]):\n          if env._current_state.grid[x, y, primitive_index] > 0:\n            # Move to the position of the primitive.\n            actions.extend(move_to_position(env._current_state.pos, (x, y)))\n\n            # Use the COLLECT action.\n            actions.append(craft.ACTION_COLLECT)\n\n            found = True\n            break\n        if found:\n          break\n\n    return actions\n\n  def align_with_workshop(env, workshop_index):\n    \"\"\"Function to align with the specified workshop.\"\"\"\n    pos = env._current_state.pos\n    for x in range(env.world.grid.shape[0]):\n      for y in range(env.world.grid.shape[1]):\n        if env._current_state.grid[x, y, workshop_index] > 0:\n          # Align horizontally.\n          dx = x - pos[0]\n          if dx < 0:\n            return craft.ACTION_LEFT\n          elif dx > 0:\n            return craft.ACTION_RIGHT\n\n          # Align vertically.\n          dy = y - pos[1]\n          if dy < 0:\n            return craft.ACTION_DOWN\n          elif dy > 0:\n            return craft.ACTION_UP\n    return None\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the desired item is a primitive; primitives cannot be crafted.\n  if item_index in env.world.cookbook.primitives:\n    return []\n\n  # Fetch the recipe for crafting the specified item.\n  recipe = env.world.cookbook.recipes.get(item_index)\n\n  # If no valid recipe exists or \"_key\" not specified, return an empty action list.\n  if not recipe or \"_key\" not in recipe:\n    return []\n\n  workshop_key = recipe[\"_key\"]\n  workshop_indices = [env.world.cookbook.index[workshop_key]]\n\n  actions = []\n  # Check inventory for sufficient primitives.\n  missing_ingredients = {}\n  for ingredient, count in recipe.items():\n    if ingredient == \"_key\":\n      continue\n    ingredient_index = env.world.cookbook.index[ingredient]\n    current_count = env._current_state.inventory[ingredient_index]\n    if current_count < count:\n      missing_ingredients[ingredient] = count - current_count\n\n  # If any ingredients are missing, attempt to collect them.\n  for ingredient, required_count in missing_ingredients.items():\n    actions.extend(collect_v2(env, ingredient, required_count))\n\n  # Find the closest workshop that can craft the item.\n  closest_workshop_pos = find_closest_workshop(workshop_indices)\n  if closest_workshop_pos is None:\n    return []\n\n  # Move to the closest workshop.\n  target_x, target_y = closest_workshop_pos\n  actions.extend(move_to_position(env._current_state.pos, (target_x, target_y)))\n\n  # Align with the correct workshop before using it to craft the item.\n  alignment_action = align_with_workshop(env, workshop_indices[0])\n  if alignment_action:\n    actions.append(alignment_action)\n\n  # Use the USE action at the correct location.\n  actions.append(craft.ACTION_USE)\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T03:50:40.784257", "function_name": "craft", "function_body": "  def find_closest_workshop(workshop_indices):\n    pos = env._current_state.pos\n    closest_workshop = None\n    min_distance = float('inf')\n    for workshop_index in workshop_indices:\n      # Iterate over all positions on the grid to find workshops.\n      for x in range(env.world.grid.shape[0]):\n        for y in range(env.world.grid.shape[1]):\n          if env._current_state.grid[x, y, workshop_index] > 0:\n            distance = abs(x - pos[0]) + abs(y - pos[1])\n            if distance < min_distance:\n              min_distance = distance\n              closest_workshop = (x, y)\n    return closest_workshop\n\n  def move_to_position(current_pos, target_pos):\n    actions = []\n    # Calculate the difference in coordinates.\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    # Prioritize vertical movement to align with the grid structure.\n    if dy < 0:\n      actions.extend([craft.ACTION_DOWN] * abs(dy))\n    elif dy > 0:\n      actions.extend([craft.ACTION_UP] * abs(dy))\n\n    # Followed by horizontal movement.\n    if dx < 0:\n      actions.extend([craft.ACTION_LEFT] * abs(dx))\n    elif dx > 0:\n      actions.extend([craft.ACTION_RIGHT] * abs(dx))\n\n    return actions\n\n  def collect_v2(env, primitive, required_count):\n    \"\"\"Collect the specified number of primitives.\"\"\"\n    # Get the index of the primitive.\n    primitive_index = env.world.cookbook.index[primitive]\n    actions = []\n\n    while np.sum(env._current_state.inventory) < required_count:\n      pos = env._current_state.pos\n      closest_primitive_pos = None\n      min_distance = float('inf')\n\n      # Find the closest primitive on the grid.\n      for x in range(env.world.grid.shape[0]):\n        for y in range(env.world.grid.shape[1]):\n          if env._current_state.grid[x, y, primitive_index] > 0:\n            distance = abs(x - pos[0]) + abs(y - pos[1])\n            if distance < min_distance:\n              min_distance = distance\n              closest_primitive_pos = (x, y)\n\n      if closest_primitive_pos is None:\n        break\n\n      # Move to the position of the primitive.\n      actions.extend(move_to_position(pos, closest_primitive_pos))\n\n      # Use the COLLECT action.\n      actions.append(craft.ACTION_COLLECT)\n\n    return actions\n\n  def align_with_workshop(env, workshop_index):\n    \"\"\"Align with the specified workshop.\"\"\"\n    pos = env._current_state.pos\n    for x in range(env.world.grid.shape[0]):\n      for y in range(env.world.grid.shape[1]):\n        if env._current_state.grid[x, y, workshop_index] > 0:\n          # Align horizontally.\n          dx = x - pos[0]\n          if dx < 0:\n            return craft.ACTION_LEFT\n          elif dx > 0:\n            return craft.ACTION_RIGHT\n\n          # Align vertically.\n          dy = y - pos[1]\n          if dy < 0:\n            return craft.ACTION_DOWN\n          elif dy > 0:\n            return craft.ACTION_UP\n    return None\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the desired item is a primitive; primitives cannot be crafted.\n  if item_index in env.world.cookbook.primitives:\n    return []\n\n  # Fetch the recipe for crafting the specified item.\n  recipe = env.world.cookbook.recipes.get(item_index)\n\n  # If no valid recipe exists or \"_key\" not specified, return an empty action list.\n  if not recipe or \"_key\" not in recipe:\n    return []\n\n  workshop_key = recipe[\"_key\"]\n  workshop_indices = [env.world.cookbook.index[workshop_key]]\n\n  actions = []\n  # Check inventory for sufficient primitives.\n  missing_ingredients = {}\n  for ingredient, count in recipe.items():\n    if ingredient == \"_key\":\n      continue\n    ingredient_index = env.world.cookbook.index[ingredient]\n    current_count = env._current_state.inventory[ingredient_index]\n    if current_count < count:\n      missing_ingredients[ingredient] = count - current_count\n\n  # If any ingredients are missing, attempt to collect them.\n  for ingredient, required_count in missing_ingredients.items():\n    actions.extend(collect_v2(env, ingredient, required_count))\n\n  # Find the closest workshop that can craft the item.\n  closest_workshop_pos = find_closest_workshop(workshop_indices)\n  if closest_workshop_pos is None:\n    return []\n\n  # Move to the closest workshop.\n  target_x, target_y = closest_workshop_pos\n  actions.extend(move_to_position(env._current_state.pos, (target_x, target_y)))\n\n  # Align with the correct workshop before using it to craft the item.\n  alignment_action = align_with_workshop(env, workshop_indices[0])\n  if alignment_action:\n    actions.append(alignment_action)\n\n  # Use the USE action at the correct location.\n  actions.append(craft.ACTION_USE)\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T03:51:24.387041", "function_name": "craft", "function_body": "  # Retrieve the index for the item from the cookbook's index.\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the primitives needed to craft the specified item.\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  \n  actions = []\n  for primitive, count in primitives_needed.items():\n      # Find the position of the nearest cell containing this primitive.\n      positions = np.argwhere(env._current_state.grid[..., primitive] == 1)\n\n      if len(positions) == 0:\n          return []  # No available positions for this primitive.\n\n      closest_pos = min(positions, key=lambda x: abs(x[0]-env._current_state.pos[0]) + abs(x[1]-env._current_state.pos[1]))\n      \n      # Move to the closest position.\n      actions.extend(move_to(env, closest_pos))\n      \n      # Collect the primitive.\n      actions.append(craft.COLLECT_FUNC(primitive))\n    \n    # Determine the workshop for crafting the item.\n  workshop_index = env.world.cookbook.recipes[item_index]['_at']\n  \n  # Find positions of the nearest cell containing this workshop.\n  workshop_positions = np.argwhere(env._current_state.grid[..., workshop_index] == 1)\n  \n  if len(workshop_positions) == 0:\n      return []  # No available workshops for crafting.\n\n  closest_workshop_pos = min(workshop_positions, key=lambda x: abs(x[0]-env._current_state.pos[0]) + abs(x[1]-env._current_state.pos[1]))\n  \n  # Move to the closest workshop.\n  actions.extend(move_to(env, closest_workshop_pos))\n  \n  # Craft the item using the USE action at the workshop.\n  actions.append(craft.USE_FUNC)\n  \n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-10T03:51:25.361497", "function_name": "craft", "function_body": "  current_state = env._current_state\n  cookbook = current_state.world.cookbook\n  # Get the index for the desired item to be crafted.\n  goal_index = cookbook.index[item]\n  \n  # Step 1: Check if all primitives required are available in inventory or on grid.\n  primitives_needed = cookbook.primitives_for(goal_index)\n  actions_to_take = []\n  \n  # Step 2: Collect missing primitives from the grid\n  for primitive, count in primitives_needed.items():\n    while current_state.inventory[primitive] < count:\n      if not current_state.next_to(primitive):\n        # Move towards the nearest cell containing the primitive\n        move_actions = find_path_to_nearest_primitive(current_state, primitive)\n        actions_to_take.extend(move_actions)\n        \n      # Once adjacent to the primitive, collect it\n      actions_to_take.append(env.world.actions['USE'])\n  \n  # Step 3: Navigate to the workshop specified in the recipe and craft the item.\n  workshop_index = cookbook.recipes[goal_index][\"_at\"]\n  while not current_state.next_to(workshop_index):\n    move_actions = find_path_to_workshop(current_state, workshop_index)\n    actions_to_take.extend(move_actions)\n\n  # Step 4: Craft the item at the workshop\n  actions_to_take.append(env.world.actions['USE'])\n  \n  return actions_to_take", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-10T03:52:36.539231", "function_name": "craft", "function_body": "  index = env.world.cookbook.index\n  goal_index = index[item]\n\n  if goal_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"No recipe found for item: {item}\")\n\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n\n  # Check inventory for required primitives\n  available_primitives = {\n      index.get(i): count for i, count in enumerate(env._current_state.inventory)\n      if count > 0 and index.get(i) is not None\n  }\n\n  actions = []\n  missing_primitives = {}\n\n  for primitive, count in required_primitives.items():\n    if primitive not in available_primitives or available_primitives[primitive] < count:\n      missing_primitives[primitive] = count - available_primitives.get(primitive, 0)\n\n  # If we have all the primitives, proceed to craft\n  if not missing_primitives:\n    workshop_index = None\n\n    for recipe_ingredients in env.world.cookbook.recipes.values():\n        if goal_index in recipe_ingredients and \"_key\" in recipe_ingredients:\n            workshop_key = recipe_ingredients[\"_key\"]\n            workshop_index = index[workshop_key]\n\n    if workshop_index is None:\n        raise ValueError(f\"No workshop found for item: {item}\")\n\n    # Find the nearest workshop\n    workshops = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    if not workshops.any():\n        raise ValueError(\"No available workshops on the grid.\")\n\n    closest_workshop = min(workshops, key=lambda w: np.linalg.norm(np.array(w) - np.array(env._current_state.pos)))\n\n    # Navigate to the closest workshop\n    path_to_workshop = a_star_search(\n        env._current_state.grid,\n        env._current_state.pos,\n        tuple(closest_workshop),\n        env.world.non_grabbable_indices\n    )\n    actions.extend([env.action_specs()[d] for d in path_to_workshop])\n\n    # Turn towards the workshop (assuming USE action faces the block)\n    direction_to_face = face_towards(\n        env._current_state.pos,\n        closest_workshop,\n        env._current_state.dir\n    )\n    if direction_to_face != env._current_state.dir:\n        actions.append(direction_to_face)\n\n    # Perform USE action to craft\n    actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T03:52:37.581123", "function_name": "craft", "function_body": "  index = env.world.cookbook.index\n  goal_index = index[item]\n\n  if goal_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"No recipe found for item: {item}\")\n\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  \n  actions = []\n  \n  # Check inventory for required primitives\n  available_primitives = {index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0 and index.get(i) is not None}\n  \n  missing_primitives = {}\n  for primitive, count in required_primitives.items():\n    if primitive not in available_primitives or available_primitives[primitive] < count:\n      missing_primitives[primitive] = count - available_primitives.get(primitive, 0)\n\n  # If we have all the primitives, proceed to craft\n  if not missing_primitives:\n    workshop_index = None\n    for recipe_ingredients in env.world.cookbook.recipes.values():\n      if goal_index in recipe_ingredients and \"_key\" in recipe_ingredients:\n        workshop_key = recipe_ingredients[\"_key\"]\n        workshop_index = index[workshop_key]\n    \n    if workshop_index is None:\n      raise ValueError(f\"No workshop found for item: {item}\")\n    \n    # Find the nearest workshop\n    workshops = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    if not workshops.any():\n      raise ValueError(\"No available workshops on the grid.\")\n    \n    closest_workshop = min(workshops, key=lambda w: np.linalg.norm(np.array(w) - np.array(env._current_state.pos)))\n    \n    # Navigate to the closest workshop\n    path_to_workshop = a_star_search(env._current_state.grid, env._current_state.pos, tuple(closest_workshop), env.world.non_grabbable_indices)\n    actions.extend([env.action_specs()[d] for d in path_to_workshop])\n    \n    # Turn towards the workshop (assuming USE action faces the block)\n    direction_to_face = face_towards(env._current_state.pos, closest_workshop, env._current_state.dir)\n    if direction_to_face != env._current_state.dir:\n      actions.append(direction_to_face)\n    \n    # Perform USE action to craft\n    actions.append(env.action_specs()[\"USE\"])\n  \n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T03:53:15.171656", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Retrieve the recipe for crafting the item\n  if item_index not in env.world.cookbook.recipes:\n    print(f\"No recipe found for {item}.\")\n    return []\n\n  recipe = env.world.cookbook.recipes[item_index]\n  required_primitives = recipe.copy()\n  \n  actions = []\n  \n  # Collect all required primitives that are not already in inventory\n  current_inventory = env._current_state.inventory\n  for primitive, count in required_primitives.items():\n    if primitive == \"_at\":\n      workshop = recipe[\"_at\"]\n      continue\n    \n    needed_count = count - current_inventory[primitive]\n    if needed_count > 0:\n      # Actions to collect primitives\n      primitive_name = env.world.cookbook.index.get(primitive)\n      actions.extend(collect(env, primitive_name))\n\n  # Ensure the agent has all required primitives before proceeding\n  for primitive, count in required_primitives.items():\n    if primitive == \"_at\":\n      continue\n    \n    needed_count = count - current_inventory[primitive]\n    if needed_count > 0:\n      print(f\"Failed to collect enough {env.world.cookbook.index.get(primitive)}\")\n      return []\n\n  # Actions to go to the workshop and craft the item\n  workshop_index = env.world.cookbook.index[workshop]\n  actions.extend(go_to_workshop(env, workshop_index))\n  \n  # Use action to craft the item at the workshop\n  actions.append(4)  # Assuming USE is represented by index 4\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-10T03:53:16.135811", "function_name": "craft", "function_body": "  # Find the index of the desired item\n  i_item = env.world.cookbook.index[item]\n  \n  # Get the recipe for the desired item\n  recipe = env.world.cookbook.recipes[i_item]\n\n  # Check if we have all required ingredients in our inventory or not\n  actions = []\n  for ingredient, count in recipe.items():\n    if ingredient == \"_at\":\n      continue\n    \n    i_ingredient = env.world.cookbook.index[ingredient]\n    if env._current_state.inventory[i_ingredient] < count:\n      # We need to collect more of this ingredient\n      actions.extend(collect(env, ingredient))\n    \n  # Check if we have the required workshop to craft the item\n  required_workshop = recipe[\"_at\"]\n  i_workshop = env.world.cookbook.index[required_workshop]\n  \n  # Navigate to the nearest workshop and perform the USE action to craft the item\n  actions.extend(move_to(env, i_workshop))\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-10T03:53:48.523620", "function_name": "craft", "function_body": "  # Step 1: Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  if not item_index in env.world.cookbook.recipes:\n    return []  # No recipe for this item\n\n  # Step 2: Collect all required primitives\n  actions = []\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  current_inventory = np.copy(env._current_state.inventory)\n\n  for primitive, count in required_primitives.items():\n    while current_inventory[primitive] < count:\n      primitive_name = env.world.cookbook.index.get(primitive)\n      \n      # Find the nearest source of the primitive\n      nearest_source_pos = find_nearest_source_of_primitive(env, primitive_name)\n      if nearest_source_pos is None:\n        return []  # Unable to find a source for this primitive\n      \n      # Move towards the source\n      actions.extend(move_to_position(env._current_state.pos, nearest_source_pos))\n      \n      # Collect the primitive\n      actions.append(craft.COLLECT_FUNC(primitive_name))\n      \n      # Update inventory\n      current_inventory[primitive] += 1\n\n  # Step 3: Craft the item at the correct workshop\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop = recipe['_at']\n  workshop_index = env.world.cookbook.index[workshop]\n\n  # Find the nearest workshop of the required type\n  nearest_workshop_pos = find_nearest_workshop(env, workshop_index)\n  if nearest_workshop_pos is None:\n    return []  # Unable to find a workshop for crafting\n\n  # Move towards the workshop\n  actions.extend(move_to_position(env._current_state.pos, nearest_workshop_pos))\n\n  # Face the workshop and use it to craft the item\n  actions.append(craft.MOVE_FUNC(face_direction_for_use(env._current_state.pos, nearest_workshop_pos)))\n  actions.append(craft.USE_FUNC())\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-10T03:53:49.494162", "function_name": "craft", "function_body": "  # Check if the item is in the cookbook\n  goal_index = env.world.cookbook.index.get(item)\n  if goal_index is None:\n      print(f\"Item {item} not found in cookbook.\")\n      return []\n\n  # Get the primitives needed to craft the item\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n\n  actions = []\n  \n  # Collect all required primitives\n  for primitive, count in required_primitives.items():\n    actions.extend(collect_v1(env, env.world.cookbook.index.get(primitive), count))\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-10T03:56:08.462472", "function_name": "craft", "function_body": "  def move_to_position(target_x, target_y):\n    current_x, current_y = env._current_state.pos\n    actions = []\n    \n    # Calculate the direction to move horizontally and vertically\n    dx = target_x - current_x\n    dy = target_y - current_y\n    \n    # Move horizontally first\n    if dy > 0:\n      actions.extend([env.world.cookbook.index[\"MOVE_FUNC_RIGHT\"]] * abs(dy))\n    elif dy < 0:\n      actions.extend([env.world.cookbook.index[\"MOVE_FUNC_LEFT\"]] * abs(dy))\n    \n    # Then move vertically\n    if dx > 0:\n      actions.extend([env.world.cookbook.index[\"MOVE_FUNC_DOWN\"]] * abs(dx))\n    elif dx < 0:\n      actions.extend([env.world.cookbook.index[\"MOVE_FUNC_UP\"]] * abs(dx))\n    \n    return actions\n\n  def face_workshop(target_x, target_y):\n    actions = []\n    dx = target_x - env._current_state.pos[0]\n    dy = target_y - env._current_state.pos[1]\n    \n    # Determine the direction to face\n    if dx == 0 and dy > 0:\n      final_direction = \"RIGHT\"\n    elif dx == 0 and dy < 0:\n      final_direction = \"LEFT\"\n    elif dx > 0 and dy == 0:\n      final_direction = \"DOWN\"\n    elif dx < 0 and dy == 0:\n      final_direction = \"UP\"\n    \n    current_direction_map = [\"UP\", \"RIGHT\", \"DOWN\", \"LEFT\"]\n    current_direction_index = env._current_state.dir\n    \n    # Turn to the correct direction if not already facing it\n    if current_direction_map[current_direction_index] != final_direction:\n      actions.append(env.world.cookbook.index[\"MOVE_FUNC_\" + final_direction])\n    \n    return actions\n\n  actions = []\n  \n  # Get the index of the desired item from the cookbook\n  i_goal = env.world.cookbook.index[item]\n  \n  # Get the recipe for the goal item\n  recipe = env.world.cookbook.recipes[i_goal]\n\n  # Check if we have all the ingredients in our inventory to craft the item\n  required_primitives = env.world.cookbook.primitives_for(i_goal)\n  inventory_dict = {env.world.cookbook.index.get(idx): count for idx, count in enumerate(env._current_state.inventory) if count > 0}\n\n  # Check if we have all the primitives needed\n  have_all_primitives = all(primitive in inventory_dict and inventory_dict[primitive] >= required_primitives[idx] for primitive, idx in required_primitives.items())\n\n  if not have_all_primitives:\n    return []  # We can't craft the item as we don't have all ingredients\n\n  # Now that we have all the primitives, let's go to the workshop and use it to craft the item\n  workshop = recipe[\"_key\"]\n  workshop_idx = env.world.cookbook.index[workshop]\n\n  # Get the position of the closest workshop from our current position in the grid\n  min_distance = float('inf')\n  closest_workshop_pos = None\n\n  for y in range(env._current_state.grid.shape[0]):\n    for x in range(env._current_state.grid.shape[1]):\n      if np.any(env._current_state.grid[y, x, workshop_idx] > 0):\n        distance = abs(y - env._current_state.pos[0]) + abs(x - env._current_state.pos[1])\n        if distance < min_distance:\n          min_distance = distance\n          closest_workshop_pos = (y, x)\n\n  # If no workshop is found, return an empty action list\n  if closest_workshop_pos is None:\n    return []\n\n  target_x, target_y = closest_workshop_pos\n\n  # Calculate actions needed to move to the closest workshop\n  actions.extend(move_to_position(target_x, target_y))\n\n  # Face the workshop direction and use it to craft the item\n  actions.extend(face_workshop(target_x, target_y))\n  \n  actions.append(env.world.cookbook.index[\"USE_FUNC\"])\n  \n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T03:56:09.531643", "function_name": "craft", "function_body": "  def move_to_position(target_x, target_y):\n    current_x, current_y = env._current_state.pos\n    actions = []\n    \n    # Move horizontally first\n    while current_y != target_y:\n      direction = \"RIGHT\" if current_y < target_y else \"LEFT\"\n      actions.append(env.world.cookbook.index[\"MOVE_FUNC_\" + direction])\n      current_y += 1 if current_y < target_y else -1\n    \n    # Then move vertically\n    while current_x != target_x:\n      direction = \"DOWN\" if current_x < target_x else \"UP\"\n      actions.append(env.world.cookbook.index[\"MOVE_FUNC_\" + direction])\n      current_x += 1 if current_x < target_x else -1\n    \n    return actions\n\n  def face_workshop(target_x, target_y):\n    actions = []\n    dx = target_x - env._current_state.pos[0]\n    dy = target_y - env._current_state.pos[1]\n    \n    # Determine the direction to face\n    if dx == 0 and dy > 0:\n      final_direction = 2  # RIGHT\n    elif dx == 0 and dy < 0:\n      final_direction = 3  # LEFT\n    elif dx > 0 and dy == 0:\n      final_direction = 1  # DOWN\n    elif dx < 0 and dy == 0:\n      final_direction = 0  # UP\n    \n    # Turn to the correct direction if not already facing it\n    current_direction = env._current_state.dir\n    if current_direction != final_direction:\n      actions.append(env.world.cookbook.index[\"MOVE_FUNC_\" + [\"UP\", \"DOWN\", \"RIGHT\", \"LEFT\"][final_direction]])\n    \n    return actions\n\n  actions = []\n  \n  # Get the index of the desired item from the cookbook\n  i_goal = env.world.cookbook.index[item]\n  \n  # Get the recipe for the goal item\n  recipe = env.world.cookbook.recipes[i_goal]\n\n  # Check if we have all the ingredients in our inventory to craft the item\n  required_primitives = env.world.cookbook.primitives_for(i_goal)\n  inventory_dict = {env.world.cookbook.index.get(idx): count for idx, count in enumerate(env._current_state.inventory) if count > 0}\n\n  # Check if we have all the primitives needed\n  have_all_primitives = all(primitive in inventory_dict and inventory_dict[primitive] >= required_primitives[idx] for primitive, idx in required_primitives.items())\n\n  if not have_all_primitives:\n    return []  # We can't craft the item as we don't have all ingredients\n\n  # Now that we have all the primitives, let's go to the workshop and use it to craft the item\n  workshop = recipe[\"_key\"]\n  workshop_idx = env.world.cookbook.index[workshop]\n\n  # Get the position of the closest workshop from our current position in the grid\n  min_distance = float('inf')\n  closest_workshop_pos = None\n\n  for y in range(env._current_state.grid.shape[0]):\n    for x in range(env._current_state.grid.shape[1]):\n      if np.any(env._current_state.grid[y, x, workshop_idx] > 0):\n        distance = abs(y - env._current_state.pos[0]) + abs(x - env._current_state.pos[1])\n        if distance < min_distance:\n          min_distance = distance\n          closest_workshop_pos = (y, x)\n\n  # If no workshop is found, return an empty action list\n  if closest_workshop_pos is None:\n    return []\n\n  target_x, target_y = closest_workshop_pos\n\n  # Calculate actions needed to move to the closest workshop\n  actions.extend(move_to_position(target_x, target_y))\n\n  # Face the workshop before using it\n  actions.extend(face_workshop(target_x, target_y))\n  \n  # Finally, use the workshop to craft the item\n  actions.append(env.world.cookbook.index[\"USE_FUNC\"])\n  \n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T03:59:37.315837", "function_name": "craft", "function_body": "  def heuristic(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal):\n    open_set = []\n    heapq.heappush(open_set, (0, start))\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, goal)}\n\n    while open_set:\n        current = heapq.heappop(open_set)[1]\n\n        if current == goal:\n            path = []\n            while current in came_from:\n                path.append(current)\n                current = came_from[current]\n            path.reverse()\n            return path\n\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            neighbor = (current[0] + dx, current[1] + dy)\n            if 0 <= neighbor[0] < env._current_state.grid.shape[0] and 0 <= neighbor[1] < env._current_state.grid.shape[1]:\n                tentative_g_score = g_score[current] + 1\n\n                if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                    came_from[neighbor] = current\n                    g_score[neighbor] = tentative_g_score\n                    f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                    heapq.heappush(open_set, (f_score[neighbor], neighbor))\n    return []\n\n  def move_to_position(path):\n    actions = []\n    for step in path[:-1]:\n        current_x, current_y = env._current_state.pos\n        target_x, target_y = step\n\n        direction = None\n        if current_x < target_x:\n            direction = \"DOWN\"\n        elif current_x > target_x:\n            direction = \"UP\"\n        elif current_y < target_y:\n            direction = \"RIGHT\"\n        elif current_y > target_y:\n            direction = \"LEFT\"\n\n        actions.append(env.world.cookbook.index[\"MOVE_FUNC_\" + direction])\n\n    return actions\n\n  def face_workshop(target_x, target_y):\n    actions = []\n    dx = target_x - env._current_state.pos[0]\n    dy = target_y - env._current_state.pos[1]\n\n    current_direction = env._current_state.dir\n\n    if dx == 0 and dy > 0:  # Target is directly below\n        if current_direction != 2:\n            actions.append(env.world.cookbook.index[\"MOVE_FUNC_DOWN\"])\n    elif dx == 0 and dy < 0:  # Target is directly above\n        if current_direction != 3:\n            actions.append(env.world.cookbook.index[\"MOVE_FUNC_UP\"])\n    elif dx > 0 and dy == 0:  # Target is to the right\n        if current_direction != 1:\n            actions.append(env.world.cookbook.index[\"MOVE_FUNC_RIGHT\"])\n    elif dx < 0 and dy == 0:  # Target is to the left\n        if current_direction != 0:\n            actions.append(env.world.cookbook.index[\"MOVE_FUNC_LEFT\"])\n\n    return actions\n\n  actions = []\n  \n  # Get the index of the desired item from the cookbook\n  i_goal = env.world.cookbook.index[item]\n  \n  # Get the recipe for the goal item\n  recipe = env.world.cookbook.recipes[i_goal]\n\n  # Check if we have all the ingredients in our inventory to craft the item\n  required_primitives = env.world.cookbook.primitives_for(i_goal)\n  inventory_dict = {env.world.cookbook.index.get(idx): count for idx, count in enumerate(env._current_state.inventory) if count > 0}\n\n  # Check if we have all the primitives needed\n  have_all_primitives = all(primitive in inventory_dict and inventory_dict[primitive] >= required_primitives[idx] for primitive, idx in required_primitives.items())\n\n  if not have_all_primitives:\n    return []  # We can't craft the item as we don't have all ingredients\n\n  # Now that we have all the primitives, let's go to the workshop and use it to craft the item\n  workshop = recipe[\"_key\"]\n  workshop_idx = env.world.cookbook.index[workshop]\n\n  # Get the position of the closest workshop from our current position in the grid\n  min_distance = float('inf')\n  closest_workshop_pos = None\n\n  for y in range(env._current_state.grid.shape[0]):\n    for x in range(env._current_state.grid.shape[1]):\n      if np.any(env._current_state.grid[y, x, workshop_idx] > 0):\n        distance = abs(y - env._current_state.pos[0]) + abs(x - env._current_state.pos[1])\n        if distance < min_distance:\n          min_distance = distance\n          closest_workshop_pos = (y, x)\n\n  # If no workshop is found, return an empty action list\n  if closest_workshop_pos is None:\n    return []\n\n  # Calculate actions needed to move to the closest workshop\n  target_x, target_y = closest_workshop_pos\n\n  path = a_star(env._current_state.pos, closest_workshop_pos)\n\n  if not path:\n      return []  # No path found to the workshop\n\n  actions.extend(move_to_position(path))\n\n  # Face the workshop and use it to craft the item\n  actions.extend(face_workshop(target_x, target_y))\n  actions.append(env.world.cookbook.index[\"USE_FUNC\"])\n  \n  return actions", "island_id": 5, "scores": {"3": 0.0}}
