{"timestamp": "2025-09-11T10:04:54.822272", "function_name": "craft", "function_body": "  # Get the index of the item to be crafted\n  item_idx = env.world.cookbook.index[item]\n  \n  # Check if we have all the primitives required for crafting the item\n  primitive_counts_needed = env.world.cookbook.primitives_for(item_idx)\n  \n  actions_to_take = []\n  \n  # Collect missing primitives\n  for primitive, count in primitive_counts_needed.items():\n    while env._current_state.inventory[primitive] < count:\n      collect_actions = collect(env, env.world.cookbook.index.get(primitive))\n      actions_to_take.extend(collect_actions)\n      \n  # Navigate to the correct workshop and craft the item\n  recipe = env.world.cookbook.recipes[item_idx]\n  workshop_required = [k for k in recipe.keys() if isinstance(k, int) and env.world.cookbook.index.get(env.world.cookbook.reverse_contents[k]) is not None][0]\n\n  # Find positions of workshops in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_required] == 1)\n\n  for pos in workshop_positions:\n    actions_to_take.extend(navigate_to_position(env, tuple(pos)))\n    \n    # Check if we are facing the correct direction to use the workshop\n    current_dir = env._current_state.dir\n    target_pos = (env._current_state.pos[0] + DIRECTIONS[current_dir][0], env._current_state.pos[1] + DIRECTIONS[current_dir][1])\n    if target_pos == tuple(pos):\n      actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-11T10:06:17.887642", "function_name": "craft", "function_body": "  def has_all_primitives(required_primitives, inventory_dict):\n    return all(primitive in inventory_dict and inventory_dict[primitive] >= required_primitives[primitive] for primitive in required_primitives)\n\n  actions = []\n  \n  # Get the index of the goal item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  # If not all primitives are available return empty action list\n  if not has_all_primitives(required_primitives, inventory_dict):\n    return []\n  \n  # Find the workshop where we can craft this item\n  workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n      if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n          workshop_index = recipe.get(\"_at\")\n          break\n  \n  if workshop_index is None:\n    return []\n\n  # Find the position of the nearest workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(workshop_positions) == 0:\n    return []\n  \n  # Select the closest workshop (for simplicity, we take the first one found)\n  target_workshop_pos = tuple(workshop_positions[0])\n\n  # Navigate to the selected workshop\n  navigation_actions = navigate(env._current_state, target_workshop_pos)\n  actions.extend(navigation_actions)\n\n  # Turn towards the workshop if not already facing it\n  current_direction = env._current_state.dir\n  direction_to_workshop = get_direction(env._current_state.pos, target_workshop_pos)\n  if current_direction != direction_to_workshop:\n    actions.append(direction_to_workshop)\n\n  # Use the USE action to craft the item at the workshop\n  actions.append(4)  # Assuming 4 is the index for the USE action\n  \n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T10:06:18.931281", "function_name": "craft", "function_body": "  def has_all_primitives(required_primitives, inventory_dict):\n    return all(primitive in inventory_dict and inventory_dict[primitive] >= required_primitives[primitive] for primitive in required_primitives)\n\n  def find_workshop(env, item_index):\n    # Find the workshop where we can craft this item\n    workshop_index = None\n    for recipe in env.world.cookbook.recipes.values():\n        if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n            workshop_index = recipe.get(\"_at\")\n            break\n\n    return workshop_index\n\n  def find_nearest_workshop(env, workshop_index):\n      # Find the position of the nearest workshop in the grid\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n      if len(workshop_positions) == 0:\n          return None\n      \n      # Select the closest workshop\n      distances = [np.linalg.norm(np.array(pos) - np.array(env._current_state.pos)) for pos in workshop_positions]\n      nearest_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n      \n      return nearest_workshop_pos\n\n  actions = []\n  \n  # Get the index of the goal item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  # If not all primitives are available return empty action list\n  if not has_all_primitives(required_primitives, inventory_dict):\n    return []\n  \n  workshop_index = find_workshop(env, item_index)\n  if workshop_index is None:\n    return []\n\n  nearest_workshop_pos = find_nearest_workshop(env, workshop_index)\n  if nearest_workshop_pos is None:\n    return []\n  \n  # Navigate to the selected workshop\n  navigation_actions = navigate(env._current_state, nearest_workshop_pos)\n  actions.extend(navigation_actions)\n\n  # Turn towards the workshop if not already facing it\n  current_direction = env._current_state.dir\n  direction_to_workshop = get_direction(env._current_state.pos, nearest_workshop_pos)\n  if current_direction != direction_to_workshop:\n    actions.append(direction_to_workshop)\n\n  # Use the USE action to craft the item at the workshop\n  actions.append(4)  # Assuming 4 is the index for the USE action\n  \n  return actions", "island_id": 8, "scores": {"3": 0.0}}
