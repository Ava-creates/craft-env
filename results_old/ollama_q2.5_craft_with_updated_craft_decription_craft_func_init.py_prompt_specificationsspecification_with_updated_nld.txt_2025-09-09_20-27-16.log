{"timestamp": "2025-09-10T21:36:25.681798", "function_name": "craft", "function_body": "  # Find the index of the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Get the recipe for the item\n  if item_index not in env.world.cookbook.recipes:\n    print(f\"No recipe found for {item}.\")\n    return []\n\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Collect all the required primitives and items\n  actions = []\n  for ingredient, count in recipe.items():\n    if ingredient == \"_at\":\n      workshop_index = recipe[\"_at\"]\n      workshop_name = env.world.cookbook.index.get(workshop_index)\n      continue\n    elif ingredient == \"_key\":\n      key_item_index = recipe[\"_key\"]\n      key_item_name = env.world.cookbook.index.get(key_item_index)\n      # Collect the key item if required\n      actions.extend(collect(env, key_item_name))\n    else:\n      ingredient_index = env.world.cookbook.index[ingredient]\n      ingredient_name = env.world.cookbook.index.get(ingredient_index)\n\n      for _ in range(count):\n        actions.extend(collect(env, ingredient_name))\n\n  # Move to the required workshop\n  actions.extend(move_to_workshop(env, workshop_name))\n\n  # Use the USE action at the workshop\n  actions.append(craft.USE)\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-10T21:37:28.199433", "function_name": "craft", "function_body": "  actions = []\n  cookbook = env.world.cookbook\n  index = cookbook.index\n\n  # Get the index for the desired item\n  goal_index = index[item]\n\n  # Check if the item has a recipe or is a primitive\n  if goal_index not in cookbook.recipes:\n    return []  # No recipe for this item, so we can't craft it\n\n  # Get the ingredients and workshop information from the recipe\n  recipe = cookbook.recipes[goal_index]\n  ingredients = {k: v for k, v in recipe.items() if k != \"_key\"}\n  workshop_key = recipe.get(\"_at\")\n\n  if workshop_key:\n    workshop_index = index[workshop_key]\n\n  # Function to move towards a specific position\n  def move_to(pos):\n    current_pos = env._current_state.pos\n    x_diff = pos[0] - current_pos[0]\n    y_diff = pos[1] - current_pos[1]\n\n    if x_diff > 0:\n      actions.extend([env.world.N_ACTIONS.RIGHT] * abs(x_diff))\n    elif x_diff < 0:\n      actions.extend([env.world.N_ACTIONS.LEFT] * abs(x_diff))\n\n    if y_diff > 0:\n      actions.extend([env.world.N_ACTIONS.DOWN] * abs(y_diff))\n    elif y_diff < 0:\n      actions.extend([env.world.N_ACTIONS.UP] * abs(y_diff))\n\n  # Function to collect an ingredient\n  def collect_ingredient(ingredient_index):\n    # Find the nearest cell with the ingredient\n    grid = env._current_state.grid\n    positions = np.argwhere(grid[:, :, ingredient_index] > 0)\n\n    if len(positions) == 0:\n      return False  # No available ingredient\n\n    nearest_pos = positions[np.argmin(np.linalg.norm(positions - np.array(env._current_state.pos), axis=1))]\n    move_to(nearest_pos)\n    actions.append(env.world.N_ACTIONS.USE)\n    return True\n\n  # Check if we have all the required ingredients\n  inventory = env._current_state.inventory\n  for ingredient, count in ingredients.items():\n    ingredient_index = index[ingredient]\n    while inventory[ingredient_index] < count:\n      if not collect_ingredient(ingredient_index):\n        return []  # Can't find enough of this ingredient\n\n  # Move to the workshop and use it to craft the item\n  if workshop_key:\n    move_to(env.world.workshop_indices[index[workshop_key]])\n    actions.append(env.world.N_ACTIONS.USE)\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
