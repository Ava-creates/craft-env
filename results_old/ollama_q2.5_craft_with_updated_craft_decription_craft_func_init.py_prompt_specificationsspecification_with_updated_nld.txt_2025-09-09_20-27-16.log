{"timestamp": "2025-09-11T02:26:18.704316", "function_name": "craft", "function_body": "  def find_closest_object(grid, start_pos, target):\n    positions = np.argwhere(grid[:, :, target] == 1)\n    closest_position = None\n    min_distance = float('inf')\n    \n    for pos in positions:\n      distance = np.linalg.norm(pos - start_pos)\n      if distance < min_distance:\n        min_distance = distance\n        closest_position = tuple(pos)\n        \n    return closest_position\n\n  def a_star_search(grid, start, goal):\n    open_set = collections.deque([(start, [])])\n    seen = set([start])\n    \n    while open_set:\n      (x, y), path = open_set.popleft()\n      \n      if (x, y) == goal:\n        return path + [goal]\n      \n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n          if grid[nx, ny].sum() == 0 and (nx, ny) not in seen:\n            open_set.append(((nx, ny), path + [(x, y)]))\n            seen.add((nx, ny))\n            \n    return []\n\n  def move_to_target(grid, start_pos, target_pos):\n    actions = []\n    current_pos = start_pos\n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if dx < 0:\n        actions.append(2)  # LEFT\n        current_pos = (current_pos[0] - 1, current_pos[1])\n      elif dx > 0:\n        actions.append(3)  # RIGHT\n        current_pos = (current_pos[0] + 1, current_pos[1])\n      elif dy < 0:\n        actions.append(1)  # UP\n        current_pos = (current_pos[0], current_pos[1] - 1)\n      elif dy > 0:\n        actions.append(0)  # DOWN\n        current_pos = (current_pos[0], current_pos[1] + 1)\n    return actions\n\n  def rotate_to_face(state, final_pos, target_workshop):\n    workshop_x, workshop_y = np.argwhere(state.grid[:, :, target_workshop] == 1)[0]\n    agent_x, agent_y = final_pos\n    dx, dy = workshop_x - agent_x, workshop_y - agent_y\n\n    if abs(dx) >= abs(dy):\n      return 3 if dx > 0 else 2  # RIGHT or LEFT\n    else:\n      return 0 if dy > 0 else 1  # DOWN or UP\n\n  item_index = env.world.cookbook.index[item]\n  \n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  actions = []\n\n  for primitive, count in required_primitives.items():\n    if env._current_state.inventory[primitive] < count:\n      return []  # Return empty list if any required primitive is not available.\n\n  workshop_key = None\n  for recipe in env.world.cookbook.recipes.values():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n      workshop_key = recipe.get(\"_at\")\n      break\n  \n  if workshop_key is None:\n    return []\n  \n  target_workshop = getattr(env.world, f\"{workshop_key}_index\", None)\n  \n  if target_workshop is None:\n    return []  # No workshop index found for the specified workshop key\n\n  start_pos = env._current_state.pos\n  grid_with_target = env._current_state.grid.copy()\n  grid_with_target[:, :, target_workshop] += 1000  # Marking the target workshop for A* search\n  \n  target_pos = find_closest_object(grid_with_target, start_pos, target_workshop)\n\n  if target_pos is None:\n    return []  # No path to the target workshop\n\n  path_to_workshop = a_star_search(env._current_state.grid, start_pos, target_pos)\n  \n  for pos in path_to_workshop[:-1]:\n      actions.extend(move_to_target(grid_with_target, env._current_state.pos, pos))\n  \n  final_pos = path_to_workshop[-1]\n  actions.append(rotate_to_face(env._current_state, final_pos, target_workshop))\n  actions.append(4)  # Use action\n\n  return actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T02:26:19.678447", "function_name": "craft", "function_body": "  def find_closest_object(grid, start, target_index):\n    queue = collections.deque([[start]])\n    seen = set([start])\n    while queue:\n        path = queue.popleft()\n        x, y = path[-1]\n        if grid[x, y, target_index] > 0:\n            return (x, y)\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            nx, ny = x + dx, y + dy\n            if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n                if grid[nx, ny].sum() == 0 and (nx, ny) not in seen:\n                    queue.append(path + [(nx, ny)])\n                    seen.add((nx, ny))\n    return None\n\n  def a_star_search(grid, start, goal):\n      open_set = collections.deque([start])\n      came_from = {}\n      g_score = {start: 0}\n      f_score = {start: heuristic(start, goal)}\n\n      while open_set:\n          current = min(open_set, key=lambda x: f_score[x])\n          if current == goal:\n              return reconstruct_path(came_from, current)\n          open_set.remove(current)\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              tentative_g_score = g_score[current] + 1\n              if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n                  if grid[neighbor[0], neighbor[1]].sum() == 0:\n                      if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                          came_from[neighbor] = current\n                          g_score[neighbor] = tentative_g_score\n                          f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                          open_set.append(neighbor)\n\n      return []\n\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def reconstruct_path(came_from, current):\n      total_path = [current]\n      while current in came_from:\n          current = came_from[current]\n          total_path.append(current)\n      return total_path[::-1]\n\n  def convert_path_to_actions(path):\n      actions = []\n      for i in range(len(path) - 1):\n          dx = path[i+1][0] - path[i][0]\n          dy = path[i+1][1] - path[i][1]\n          if dx == -1:\n              actions.append(2)  # LEFT\n          elif dx == 1:\n              actions.append(3)  # RIGHT\n          elif dy == -1:\n              actions.append(1)  # UP\n          elif dy == 1:\n              actions.append(0)  # DOWN\n      return actions\n\n  def rotate_to_face(state, target_pos, workshop_index):\n      workshop_direction = np.argwhere(state.grid[:, :, workshop_index] > 0)\n      if not workshop_direction.any():\n          return None\n      \n      closest_workshop = tuple(workshop_direction[np.argmin(np.linalg.norm(workshop_direction - state.pos, axis=1))])\n      \n      dx = closest_workshop[0] - target_pos[0]\n      dy = closest_workshop[1] - target_pos[1]\n\n      if abs(dx) > abs(dy):\n          return 2 if dx < 0 else 3\n      else:\n          return 1 if dy < 0 else 0\n\n  item_index = env.world.cookbook.index[item]\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  actions = []\n\n  for primitive, count in required_primitives.items():\n    while env._current_state.inventory[primitive] < count:\n        target_positions = np.argwhere(env._current_state.grid[:, :, primitive] > 0)\n        if not target_positions.any():\n            return []  # Primitive not found.\n\n        closest_primitive = tuple(target_positions[np.argmin(np.linalg.norm(target_positions - env._current_state.pos, axis=1))])\n        actions.extend(move_to_target(env._current_state.grid, env._current_state.pos, closest_primitive))\n        actions.append(5)  # Collect action (assuming 5 is the COLLECT action)\n\n  workshop_key = None\n  for recipe in env.world.cookbook.recipes.values():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n      workshop_key = recipe.get(\"_at\")\n      break\n  \n  if workshop_key is None:\n    return []\n  \n  target_workshop = getattr(env.world, f\"{workshop_key}_index\", None)\n  \n  if target_workshop is None:\n    return []  # No workshop index found for the specified workshop key\n\n  start_pos = env._current_state.pos\n  grid_with_target = env._current_state.grid.copy()\n  grid_with_target[:, :, target_workshop] += 1000  # Marking the target workshop for A* search\n  \n  target_pos = find_closest_object(grid_with_target, start_pos, target_workshop)\n\n  if target_pos is None:\n    return []  # No path to the target workshop\n\n  path_to_workshop = a_star_search(env._current_state.grid, start_pos, target_pos)\n  \n  for pos in path_to_workshop[:-1]:\n      actions.extend(move_to_target(env._current_state.grid, env._current_state.pos, pos))\n  \n  final_pos = path_to_workshop[-1]\n  actions.append(rotate_to_face(env._current_state, final_pos, target_workshop))\n  actions.append(4)  # Use action\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-11T02:28:52.668844", "function_name": "craft", "function_body": "  def a_star_search(grid, start, goal):\n    open_set = collections.deque([(start, 0)])\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, goal)}\n    \n    while open_set:\n        current, _ = min(open_set, key=lambda x: f_score[x[0]])\n        if current == goal:\n            path = []\n            while current in came_from:\n                path.append(current)\n                current = came_from[current]\n            return path[::-1]\n        \n        open_set.remove((current, g_score[current]))\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            neighbor = (current[0] + dx, current[1] + dy)\n            if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n                tentative_g_score = g_score[current] + 1\n                if grid[neighbor].sum() == 0 or neighbor == goal:\n                    if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                        came_from[neighbor] = current\n                        g_score[neighbor] = tentative_g_score\n                        f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                        open_set.append((neighbor, tentative_g_score))\n    return []\n\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def move_to_target(state, target_pos):\n      actions = []\n      dx = target_pos[0] - state.pos[0]\n      dy = target_pos[1] - state.pos[1]\n      \n      # Move vertically\n      if dy < 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy > 0:\n          actions.extend([0] * abs(dy))  # DOWN\n      \n      # Move horizontally\n      if dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n      elif dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      \n      return actions\n\n  def rotate_to_face(state, target_pos):\n      x, y = state.pos\n      tx, ty = target_pos\n      \n      if tx < x:  # Left of the agent\n          return 2\n      elif tx > x:  # Right of the agent\n          return 3\n      elif ty < y:  # Above the agent\n          return 1\n      elif ty > y:  # Below the agent\n          return 0\n      \n      # If already directly in front, no rotation needed.\n      return None\n\n  item_index = env.world.cookbook.index[item]\n  \n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  \n  actions = []\n  \n  # Check if all required items are available in the inventory. If not, return an empty list.\n  for primitive, count in required_primitives.items():\n    if env._current_state.inventory[primitive] < count:\n      return []  # Return empty list if any required item is not available.\n    \n  target_workshop = None\n  \n  # Determine the workshop where crafting should occur\n  for recipe in env.world.cookbook.recipes.values():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n      workshop_key = recipe.get(\"_at\")\n      if workshop_key is not None:\n        target_workshop = getattr(env.world, f\"{workshop_key}_index\", None)\n        break\n  \n  # If no suitable workshop is found, return an empty list.\n  if target_workshop is None:\n    return []\n  \n  start_pos = env._current_state.pos\n  grid_with_target = env._current_state.grid.copy()\n  \n  # Mark the target workshop for A* search\n  target_positions = np.argwhere(grid_with_target[:, :, target_workshop] == 1)\n  \n  if len(target_positions) == 0:\n    return []  # No target workshops found\n  \n  path_to_workshop = []\n  for target_pos in target_positions:\n    current_path = a_star_search(env._current_state.grid, start_pos, tuple(target_pos))\n    if current_path and (not path_to_workshop or len(current_path) < len(path_to_workshop)):\n      path_to_workshop = current_path\n  \n  if not path_to_workshop:\n    return []  # No valid path to any target workshop\n  \n  for pos in path_to_workshop[:-1]:\n      actions.extend(move_to_target(env._current_state, pos))\n      \n  final_pos = path_to_workshop[-1]\n  rotate_action = rotate_to_face(env._current_state, final_pos)\n  if rotate_action is not None:\n    actions.append(rotate_action)\n\n  # Add the USE action to craft at the workshop\n  actions.append(4)  # Use action\n\n  return actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T02:28:53.735629", "function_name": "craft", "function_body": "  def a_star_search(grid, start, goal):\n    open_set = [(0, start, [])]  # (f_score, position, path)\n    closed_set = set()\n    \n    g_scores = {start: 0}\n    f_scores = {start: heuristic(start, goal)}\n    \n    while open_set:\n      _, current, path = heapq.heappop(open_set)\n      \n      if current == goal:\n        return path + [current]\n      \n      closed_set.add(current)\n      \n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        \n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n          if grid[neighbor].sum() == 0:\n            tentative_g_score = g_scores[current] + 1\n            \n            if neighbor not in g_scores or tentative_g_score < g_scores[neighbor]:\n              came_from[neighbor] = current\n              g_scores[neighbor] = tentative_g_score\n              f_scores[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n              heapq.heappush(open_set, (f_scores[neighbor], neighbor, path + [current]))\n    \n    return []\n\n  def heuristic(a, b):\n    \"\"\"Manhattan distance.\"\"\"\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def move_to_target(grid, start_pos, target_pos):\n    actions = []\n    dx = target_pos[0] - start_pos[0]\n    dy = target_pos[1] - start_pos[1]\n    \n    # Move vertically\n    if dy < 0:\n        actions.extend([1] * abs(dy))  # UP\n    elif dy > 0:\n        actions.extend([0] * abs(dy))  # DOWN\n    \n    # Move horizontally\n    if dx < 0:\n        actions.extend([2] * abs(dx))  # LEFT\n    elif dx > 0:\n        actions.extend([3] * abs(dx))  # RIGHT\n    \n    return actions\n\n  def rotate_to_face(state, target_pos):\n      x, y = state.pos\n      tx, ty = target_pos\n      \n      if tx < x:  # Left of the agent\n          return 2\n      elif tx > x:  # Right of the agent\n          return 3\n      elif ty < y:  # Above the agent\n          return 1\n      elif ty > y:  # Below the agent\n          return 0\n      \n      return None\n\n  def find_closest_object(grid, start_pos, target_index):\n    open_set = collections.deque([(start_pos, [])])\n    closed_set = set()\n    \n    while open_set:\n        (x, y), path = open_set.popleft()\n        \n        if grid[x, y, target_index] == 1:\n            return (x, y)\n        \n        if (x, y) in closed_set:\n            continue\n        \n        closed_set.add((x, y))\n        \n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            nx, ny = x + dx, y + dy\n            \n            if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n                if grid[nx, ny].sum() == 0 or grid[nx, ny, target_index] == 1:\n                    open_set.append(((nx, ny), path + [(x, y)]))\n    \n    return None\n\n  import heapq\n  from collections import defaultdict\n\n  item_index = env.world.cookbook.index[item]\n  \n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  \n  actions = []\n  \n  # Check if all required items are available in the inventory. If not, return an empty list.\n  for primitive, count in required_primitives.items():\n    if env._current_state.inventory[primitive] < count:\n      return []  # Return empty list if any required item is not available.\n\n  target_workshop = None\n  \n  # Determine the workshop where crafting should occur\n  for recipe in env.world.cookbook.recipes.values():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n      workshop_key = recipe.get(\"_at\")\n      if workshop_key is not None:\n        target_workshop = getattr(env.world, f\"{workshop_key}_index\", None)\n        break\n  \n  # If no suitable workshop is found, return an empty list.\n  if target_workshop is None:\n    return []\n  \n  start_pos = env._current_state.pos\n  grid_with_target = env._current_state.grid.copy()\n  \n  # Mark the target workshop for A* search\n  grid_with_target[:, :, target_workshop] += 1000\n\n  target_pos = find_closest_object(grid_with_target, start_pos, target_workshop)\n\n  if target_pos is None:\n    return []  # No path to the target workshop\n  \n  # Calculate the shortest path to the target workshop\n  came_from = {}\n  path_to_workshop = a_star_search(env._current_state.grid, start_pos, target_pos)\n  \n  for pos in path_to_workshop[:-1]:\n      actions.extend(move_to_target(env._current_state.grid, env._current_state.pos, pos))\n      \n  final_pos = path_to_workshop[-1]\n  rotate_action = rotate_to_face(env._current_state, final_pos)\n  if rotate_action is not None:\n    actions.append(rotate_action)\n\n  # Add the USE action to craft at the workshop\n  actions.append(4)  # Use action\n\n  return actions", "island_id": 0, "scores": {"3": 0.0}}
