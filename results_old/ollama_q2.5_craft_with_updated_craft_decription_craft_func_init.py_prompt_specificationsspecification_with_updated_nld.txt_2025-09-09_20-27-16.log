unt in required_primitives.items():\n    if env._current_state.inventory[primitive] < count:\n      return [] # Not enough primitives to start crafting\n\n  # Find the workshop where we need to go to craft this item\n  workshop_key = None\n  for recipe_key, recipe in env.world.cookbook.recipes.items():\n    if \"_at\" in recipe and recipe[\"_at\"] == goal_index:\n      workshop_key = recipe_key\n      break\n\n  # Check if the required workshop exists\n  if workshop_key is None:\n    return [] # No suitable workshop found\n  \n  workshop_index = env.world.cookbook.index[workshop_key]\n\n  # Find coordinates of all workshops on the grid\n  workshop_coords = find_workshops(env._current_state.grid, workshop_index)\n  \n  # Find the closest workshop\n  def closest_workshop(pos, workshops):\n    min_dist = float('inf')\n    closest_ws = None\n    for ws in workshops:\n      dist = abs(ws[0] - pos[0]) + abs(ws[1] - pos[1])\n      if dist < min_dist:\n        min_dist = dist\n        closest_ws = ws\n    return closest_ws\n\n  target_workshop = closest_workshop(env._current_state.pos, workshop_coords)\n  \n  # Navigate to the closest workshop\n  actions.extend(navigate_to(env._current_state.pos, target_workshop))\n\n  # Use action to craft the item at the workshop (this assumes correct orientation)\n  actions.append(env.world.cookbook.index[\"USE\"])\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T11:19:38.984569", "function_name": "craft", "function_body": "  def find_workshops(grid, kind):\n    coords = []\n    for y in range(grid.shape[0]):\n      for x in range(grid.shape[1]):\n        if grid[y, x, kind] > 0:\n          coords.append((x, y))\n    return coords\n\n  def closest_workshop(pos, workshops):\n    min_dist = float('inf')\n    closest_ws = None\n    for ws in workshops:\n      dist = abs(ws[0] - pos[0]) + abs(ws[1] - pos[1])\n      if dist < min_dist:\n        min_dist = dist\n        closest_ws = ws\n    return closest_ws\n\n  def navigate_to(pos, target):\n    actions = []\n    dx = target[0] - pos[0]\n    dy = target[1] - pos[1]\n\n    if dx > 0:\n      actions.extend([env.world.cookbook.index[\"RIGHT\"]] * abs(dx))\n    elif dx < 0:\n      actions.extend([env.world.cookbook.index[\"LEFT\"]] * abs(dx))\n\n    if dy > 0:\n      actions.extend([env.world.cookbook.index[\"DOWN\"]] * abs(dy))\n    elif dy < 0:\n      actions.extend([env.world.cookbook.index[\"UP\"]] * abs(dy))\n    \n    return actions\n\n  goal_index = env.world.cookbook.index[item]\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n\n  if not required_primitives:\n    return [] # No recipe or no primitives needed, can't craft\n\n  current_inventory = env._current_state.inventory.copy()\n\n  # Check if all required primitives are already in inventory\n  for primitive, count in required_primitives.items():\n    if current_inventory[primitive] < count:\n      return [] # Not enough primitives to start crafting\n\n  # Find the workshop where we need to go to craft this item\n  workshop_key = None\n  for recipe_key, recipe in env.world.cookbook.recipes.items():\n    if \"_at\" in recipe and recipe[\"_at\"] == goal_index:\n      workshop_key = recipe_key\n      break\n\n  if workshop_key is None:\n    return [] # No suitable workshop found\n  \n  workshop_index = env.world.cookbook.index[workshop_key]\n\n  # Find coordinates of all workshops on the grid\n  workshop_coords = find_workshops(env._current_state.grid, workshop_index)\n  \n  # Find the closest workshop\n  target_workshop = closest_workshop(env._current_state.pos, workshop_coords)\n\n  if not target_workshop:\n    return [] # No available workshops\n\n  actions.extend(navigate_to(env._current_state.pos, target_workshop))\n\n  # Align with the workshop to face it before using\n  def align_with(pos, target):\n    actions = []\n    dx = target[0] - pos[0]\n    dy = target[1] - pos[1]\n\n    if dx > 0:\n      actions.append(env.world.cookbook.index[\"RIGHT\"])\n    elif dx < 0:\n      actions.append(env.world.cookbook.index[\"LEFT\"])\n\n    if dy > 0:\n      actions.append(env.world.cookbook.index[\"DOWN\"])\n    elif dy < 0:\n      actions.append(env.world.cookbook.index[\"UP\"])\n    \n    return actions\n\n  actions.extend(align_with(env._current_state.pos, target_workshop))\n\n  # Use action to craft the item at the workshop\n  actions.append(env.world.cookbook.index[\"USE\"])\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T11:21:08.359316", "function_name": "craft", "function_body": "  actions = []\n  \n  # Convert the item name to its index using the cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all required primitives for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  current_inventory = {env.world.cookbook.index.get(idx): count for idx, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  # If any required primitive is missing, return empty action list\n  for req_item, req_count in required_primitives.items():\n    if current_inventory.get(req_item, 0) < req_count:\n      return []\n\n  # Find the workshop required to craft this item\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_key = next(key for key in recipe.keys() if key.startswith(\"_at\"))\n  workshop_name = recipe[workshop_key]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n  \n  if len(workshop_positions) == 0:\n    return []\n\n  # Choose a random workshop position to head towards\n  workshop_pos = tuple(workshop_positions[env.world.random.randint(len(workshop_positions))])\n\n  # Calculate the path from the current position to the chosen workshop\n  start_pos = env._current_state.pos\n  path = shortest_path(grid, start_pos, workshop_pos)\n\n  if not path:\n    return []\n\n  # Generate actions to move along the calculated path\n  for target_pos in path[1:]:  # Skip the starting point\n    action = move_towards(env._current_state.pos, env._current_state.dir, target_pos)\n    if action is None:\n      continue  # Handle cases where no valid move exists\n    actions.append(action)\n\n  # Add USE action to craft the item at the workshop\n  actions.append(craft.ACTIONS.USE)\n\n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T11:21:09.397000", "function_name": "craft", "function_body": "  actions = []\n  # Convert the item name to its index using the cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all required primitives for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  current_inventory = {env.world.cookbook.index.get(idx): count for idx, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  # If any required primitive is missing, return empty action list\n  for req_item, req_count in required_primitives.items():\n    if current_inventory.get(req_item, 0) < req_count:\n      return []\n\n  # Find the workshop required to craft this item\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_key = next(key for key in recipe.keys() if key.startswith(\"_at\"))\n  workshop_name = recipe[workshop_key]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n  \n  if len(workshop_positions) == 0:\n    return []\n\n  # Choose a random workshop position to head towards\n  workshop_pos = tuple(workshop_positions[env.world.random.randint(len(workshop_positions))])\n  \n  # Calculate the path from the current position to the chosen workshop\n  start_pos = env._current_state.pos\n  path = shortest_path(grid, start_pos, workshop_pos)\n  \n  if not path:\n    return []\n\n  # Generate actions to move along the calculated path\n  for target_pos in path[1:]:  # Skip the starting point\n    action = move_towards(env._current_state.pos, env._current_state.dir, target_pos)\n    if action is None:\n      continue  # Handle cases where no valid move exists\n    actions.append(action)\n\n  # Add USE action to craft the item at the workshop\n  actions.append(craft.ACTIONS.USE)\n  \n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T11:22:22.601023", "function_name": "craft", "function_body": "  goal_index = env.world.cookbook.index[item]\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n\n  actions = []\n\n  if not required_primitives:\n    return [] # No recipe or no primitives needed, can't craft\n\n  # Check if all required primitives are already in inventory\n  for primitive, count in required_primitives.items():\n    if env._current_state.inventory[primitive] < count:\n      return [] # Not enough primitives to start crafting\n\n  # Find the workshop where we need to go to craft this item\n  workshop_index = None\n  for recipe_key, recipe in env.world.cookbook.recipes.items():\n    if \"_at\" in recipe and recipe[\"_at\"] == goal_index:\n      workshop_index = env.world.cookbook.index[recipe_key]\n      break\n\n  # Check if the required workshop exists\n  if workshop_index is None:\n    return [] # No suitable workshop found\n\n  def move_to_workshop(workshop_index):\n    workshop_pos = find_closest_workshop(env, workshop_index)\n    actions.extend(navigate_to_position(env._current_state.pos, workshop_pos))\n\n  def navigate_to_position(current_pos, target_pos):\n      x1, y1 = current_pos\n      x2, y2 = target_pos\n      actions = []\n      \n      # Calculate the direction to move\n      if x1 < x2:\n          actions.append(env.world.cookbook.index[\"RIGHT\"])\n      elif x1 > x2:\n          actions.append(env.world.cookbook.index[\"LEFT\"])\n\n      if y1 < y2:\n          actions.append(env.world.cookbook.index[\"UP\"])\n      elif y1 > y2:\n          actions.append(env.world.cookbook.index[\"DOWN\"])\n\n      return actions\n\n  def find_closest_workshop(env, workshop_index):\n    # Simple heuristic: assume the first occurrence of the workshop in the grid is closest\n    for i in range(env._current_state.grid.shape[0]):\n        for j in range(env._current_state.grid.shape[1]):\n            if env._current_state.grid[i, j, workshop_index] == 1:\n                return (i, j)\n    return None\n\n  # Navigate to the closest workshop\n  move_to_workshop(workshop_index)\n\n  # Use action to craft the item at the workshop\n  actions.append(env.world.cookbook.index[\"USE\"])\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T11:27:23.189802", "function_name": "craft", "function_body": "  goal_index = env.world.cookbook.index[item]\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n\n  if not required_primitives:\n    return [] # No recipe or no primitives needed, can't craft\n\n  actions = []\n\n  def collect_primitive(primitive_index):\n      nonlocal actions\n      # Navigate to the closest source of the primitive (this part needs more sophisticated logic)\n      # For simplicity, we will just move up and right for demonstration purposes\n      actions.append(env.world.cookbook.index[\"UP\"])\n      actions.append(env.world.cookbook.index[\"RIGHT\"])\n      \n      # Collect the primitive using USE action\n      actions.append(env.world.cookbook.index[\"USE\"])\n\n  def navigate_to_workshop(workshop_index):\n      nonlocal actions\n      # Navigate to the closest workshop (this part needs more sophisticated logic)\n      # For simplicity, we will just move up and right for demonstration purposes\n      actions.append(env.world.cookbook.index[\"UP\"])\n      actions.append(env.world.cookbook.index[\"RIGHT\"])\n\n  # Check if all required primitives are already in inventory or need to be collected\n  for primitive_index, count in required_primitives.items():\n    while env._current_state.inventory[primitive_index] < count:\n        collect_primitive(primitive_index)\n\n  # Find the workshop where we need to go to craft this item\n  workshop_name = None\n  for recipe_key, recipe in env.world.cookbook.recipes.items():\n      if \"_key\" in recipe and recipe[\"_key\"] == goal_index:\n          workshop_name = recipe_key\n          break\n\n  # Check if the required workshop exists\n  if workshop_name is None:\n    return [] # No suitable workshop found\n\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  navigate_to_workshop(workshop_index)\n\n  # Use action to craft the item at the workshop (this assumes correct orientation)\n  actions.append(env.world.cookbook.index[\"USE\"])\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-10T11:29:46.833603", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  # Check if we have all ingredients in inventory to craft this item\n  required_ingredients = {cookbook.index[k]: v for k, v in recipe.items() if k != \"_at\"}\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = env._current_state.inventory.copy()\n\n  # Check if all ingredients are available\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if not can_craft:\n    return []\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No available workshop to craft item\")\n\n  # Select the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n  # Calculate actions to move the agent to the nearest workshop\n  dx = nearest_workshop_pos[0] - current_position[0]\n  dy = nearest_workshop_pos[1] - current_position[1]\n\n  actions_to_take = []\n\n  def add_movement_actions(x_diff, y_diff):\n    if x_diff > 0:\n      actions_to_take.extend([craft.MOVE_RIGHT for _ in range(x_diff)])\n    elif x_diff < 0:\n      actions_to_take.extend([craft.MOVE_LEFT for _ in range(-x_diff)])\n\n    if y_diff > 0:\n      actions_to_take.extend([craft.MOVE_DOWN for _ in range(y_diff)])\n    elif y_diff < 0:\n      actions_to_take.extend([craft.MOVE_UP for _ in range(-y_diff)])\n\n  # Rotate the agent to face the workshop\n  def turn_to_face(target_x, target_y):\n    current_x, current_y = env._current_state.pos\n    dx = target_x - current_x\n    dy = target_y - current_y\n\n    if dx > 0:\n      target_direction = craft.RIGHT\n    elif dx < 0:\n      target_direction = craft.LEFT\n    else:  # No horizontal movement needed\n      if dy > 0:\n        target_direction = craft.DOWN\n      else:\n        target_direction = craft.UP\n\n    while env._current_state.dir != target_direction:\n      actions_to_take.append(craft.TURN_RIGHT)\n      env._current_state.dir = (env._current_state.dir + 1) % 4\n\n  # Move to the workshop\n  add_movement_actions(dx, dy)\n\n  # Turn to face the workshop\n  turn_to_face(nearest_workshop_pos[0], nearest_workshop_pos[1])\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T11:29:47.793921", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  # Check if we have all ingredients in inventory to craft this item\n  required_ingredients = {cookbook.index[k]: v for k, v in recipe.items() if k != \"_at\"}\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = env._current_state.inventory.copy()\n\n  # Check if all ingredients are available\n  can_craft = True\n  actions_to_take = []\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n\n      # Collect the missing items\n      item_name = cookbook.index.inverse[ingredient_index]\n      collect_actions = collect_v1(env, item_name)\n      \n      actions_to_take.extend(collect_actions)\n\n      break\n\n  if not can_craft:\n    return []\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No available workshop to craft item\")\n\n  # Select the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n  # Calculate actions to move the agent to the nearest workshop\n  dx = nearest_workshop_pos[0] - current_position[0]\n  dy = nearest_workshop_pos[1] - current_position[1]\n\n  if dx > 0:\n    actions_to_take.extend([craft.MOVE_RIGHT for _ in range(dx)])\n  elif dx < 0:\n    actions_to_take.extend([craft.MOVE_LEFT for _ in range(-dx)])\n\n  if dy > 0:\n    actions_to_take.extend([craft.MOVE_DOWN for _ in range(dy)])\n  elif dy < 0:\n    actions_to_take.extend([craft.MOVE_UP for _ in range(-dy)])\n\n  # Rotate the agent to face the workshop\n  target_direction = env._current_state.dir\n\n  if dx > 0 and target_direction != craft.RIGHT:\n    while target_direction != craft.RIGHT:\n      actions_to_take.append(craft.TURN_RIGHT)\n      target_direction = (target_direction + 1) % 4\n  elif dx < 0 and target_direction != craft.LEFT:\n    while target_direction != craft.LEFT:\n      actions_to_take.append(craft.TURN_LEFT)\n      target_direction = (target_direction - 1) % 4\n\n  if dy > 0 and target_direction != craft.DOWN:\n    while target_direction != craft.DOWN:\n      actions_to_take.append(craft.TURN_RIGHT)\n      target_direction = (target_direction + 1) % 4\n  elif dy < 0 and target_direction != craft.UP:\n    while target_direction != craft.UP:\n      actions_to_take.append(craft.TURN_LEFT)\n      target_direction = (target_direction - 1) % 4\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-10T11:32:19.169122", "function_name": "craft", "function_body": "  def get_actions_for_movement(start, target, current_direction):\n    dx = target[0] - start[0]\n    dy = target[1] - start[1]\n\n    actions_to_take = []\n\n    if dx > 0:\n        while current_direction != craft.RIGHT:\n            actions_to_take.append(craft.TURN_RIGHT)\n            current_direction = (current_direction + 1) % 4\n        actions_to_take.extend([craft.MOVE_RIGHT for _ in range(dx)])\n    elif dx < 0:\n        while current_direction != craft.LEFT:\n            actions_to_take.append(craft.TURN_LEFT)\n            current_direction = (current_direction - 1) % 4\n        actions_to_take.extend([craft.MOVE_LEFT for _ in range(-dx)])\n\n    if dy > 0:\n        while current_direction != craft.DOWN:\n            actions_to_take.append(craft.TURN_RIGHT)\n            current_direction = (current_direction + 1) % 4\n        actions_to_take.extend([craft.MOVE_DOWN for _ in range(dy)])\n    elif dy < 0:\n        while current_direction != craft.UP:\n            actions_to_take.append(craft.TURN_LEFT)\n            current_direction = (current_direction - 1) % 4\n        actions_to_take.extend([craft.MOVE_UP for _ in range(-dy)])\n\n    return actions_to_take, current_direction\n\n  def get_nearest_workshop(grid, workshop_index, start_position):\n      positions = np.argwhere(grid[:, :, workshop_index] > 0)\n      distances = np.linalg.norm(start_position - positions, axis=1)\n      nearest_index = np.argmin(distances)\n      return tuple(positions[nearest_index])\n\n  def get_actions_to_collect(env, primitive_name):\n    cookbook = env.world.cookbook\n    primitive_index = cookbook.index[primitive_name]\n    \n    if not primitive_index:\n        raise ValueError(\"Unknown primitive\")\n    \n    # Find all positions of the required primitive in the grid\n    primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] > 0)\n    \n    if len(primitive_positions) == 0:\n        return []  # No available primitives to collect\n    \n    # Select the nearest primitive\n    current_position = np.array(env._current_state.pos)\n    distances_to_primitives = np.linalg.norm(current_position - primitive_positions, axis=1)\n    nearest_primitive_index = np.argmin(distances_to_primitives)\n    nearest_primitive_pos = tuple(primitive_positions[nearest_primitive_index])\n    \n    # Calculate actions to move the agent to the nearest primitive\n    actions_to_take, _ = get_actions_for_movement(\n        current_position, nearest_primitive_pos, env._current_state.dir\n    )\n    \n    # Add the COLLECT action to collect the primitive\n    actions_to_take.append(craft.COLLECT)\n    \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = env._current_state.inventory.copy()\n\n  # Check if all ingredients are available\n  required_ingredients = {cookbook.index[k]: v for k, v in recipe.items()}\n\n  actions_to_take = []\n\n  for ingredient_index, required_count in required_ingredients.items():\n    ingredient_name = cookbook.index[ingredient_index]\n    while available_inventory.get(ingredient_index, 0) < required_count:\n        # Collect the missing ingredient\n        collect_actions = get_actions_to_collect(env, ingredient_name)\n        if not collect_actions:  # No primitives to collect\n            return []\n        actions_to_take.extend(collect_actions)\n        \n        # Update inventory after collecting the primitive\n        available_inventory[ingredient_index] = available_inventory.get(ingredient_index, 0) + 1\n\n  # Find the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  nearest_workshop_pos = get_nearest_workshop(\n      env._current_state.grid, workshop_index, current_position\n  )\n\n  # Calculate actions to move the agent to the nearest workshop\n  movement_actions_to_take, _ = get_actions_for_movement(\n      current_position, nearest_workshop_pos, env._current_state.dir\n  )\n  \n  actions_to_take.extend(movement_actions_to_take)\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-10T11:32:20.224673", "function_name": "craft", "function_body": "  def get_actions_for_movement(start, target, current_direction):\n    dx = target[0] - start[0]\n    dy = target[1] - start[1]\n\n    actions_to_take = []\n\n    if abs(dx) > abs(dy):  # Prioritize horizontal movement\n      while current_direction != (craft.RIGHT if dx > 0 else craft.LEFT):\n        actions_to_take.append(craft.TURN_RIGHT)\n        current_direction = (current_direction + 1) % 4\n      actions_to_take.extend([craft.MOVE_RIGHT for _ in range(dx)]) if dx > 0 else actions_to_take.extend([craft.MOVE_LEFT for _ in range(-dx)])\n    else:  # Prioritize vertical movement\n      while current_direction != (craft.DOWN if dy > 0 else craft.UP):\n        actions_to_take.append(craft.TURN_RIGHT)\n        current_direction = (current_direction + 1) % 4\n      actions_to_take.extend([craft.MOVE_DOWN for _ in range(dy)]) if dy > 0 else actions_to_take.extend([craft.MOVE_UP for _ in range(-dy)])\n\n    return actions_to_take, current_direction\n\n  def get_nearest_workshop(grid, workshop_index, start_position):\n      positions = np.argwhere(grid[:, :, workshop_index] > 0)\n      distances = np.linalg.norm(start_position - positions, axis=1)\n      nearest_index = np.argmin(distances)\n      return tuple(positions[nearest_index])\n\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = env._current_state.inventory.copy()\n\n  # Check if all ingredients are available\n  required_ingredients = {cookbook.index[k]: v for k, v in recipe.items()}\n\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if not can_craft:\n    return []\n\n  # Find the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  nearest_workshop_pos = get_nearest_workshop(\n      env._current_state.grid, workshop_index, current_position\n  )\n\n  # Calculate actions to move the agent to the nearest workshop\n  actions_to_take, _ = get_actions_for_movement(\n      current_position, nearest_workshop_pos, env._current_state.dir\n  )\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T11:33:49.706375", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  current_inventory = {env.world.cookbook.index.get(i): env._current_state.inventory[i] for i in range(len(env._current_state.inventory))}\n\n  # Check if we have all the primitives required\n  actions = []\n  for primitive, count in required_primitives.items():\n    if current_inventory.get(primitive, 0) < count:\n      return []  # Return empty list as we do not have enough primitives\n\n  # Determine which workshop to use and navigate there\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_required = None\n  for key in recipe.keys():\n    if \"_at\" in key:\n      workshop_required = key.split(\"_at\")[1].strip()\n      break\n\n  if not workshop_required:\n    return []  # No valid workshop found in the recipe\n\n  # Find all positions of the required workshops in the grid\n  workshop_index = env.world.cookbook.index[workshop_required]\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n  if not workshop_positions.size:\n    return []  # No valid workshops found on the grid\n\n  # Navigate to the closest workshop\n  target_workshop_position = min(\n      [tuple(pos) for pos in workshop_positions],\n      key=lambda x: abs(x[0] - env._current_state.pos[0]) + abs(x[1] - env._current_state.pos[1])\n  )\n\n  actions.extend(navigate_to(env, target_workshop_position))\n\n  # Turn to face the workshop\n  facing_direction = determine_facing_direction(env._current_state.pos, target_workshop_position)\n  if facing_direction is not None:\n    actions.append(facing_direction)\n\n  # Perform USE action to craft the item\n  actions.append(craft.ACTION_USE)\n\n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T11:33:50.784674", "function_name": "craft", "function_body": "  # Get the index of the item we want to craft from the cookbook's index.\n  item_index = env.world.cookbook.index[item]\n\n  # Retrieve required primitives for crafting the item from the cookbook.\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n\n  # Create a dictionary of current inventory based on the cookbook's index mapping.\n  current_inventory = {env.world.cookbook.index.get(i): env._current_state.inventory[i] for i in range(len(env._current_state.inventory))}\n\n  actions = []\n\n  # Check if we have all required primitives. If not, return an empty action list.\n  for primitive, count in required_primitives.items():\n    if current_inventory.get(primitive, 0) < count:\n      return []  # Not enough primitives to craft the item.\n\n  # Determine which workshop is required for crafting and navigate there.\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_required = None\n\n  # Extract workshop information from the recipe.\n  for key in recipe.keys():\n    if \"_at\" in key:\n      workshop_required = key.split(\"_at\")[1].strip()\n      break\n\n  if not workshop_required:\n    return []  # No valid workshop found in the recipe.\n\n  # Find positions of the required workshop on the grid.\n  workshop_index = env.world.cookbook.index[workshop_required]\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n  if not workshop_positions.size:\n    return []  # No valid workshop found on the grid.\n\n  # Select the first available workshop position as the target.\n  target_workshop_position = tuple(workshop_positions[0])\n\n  # Navigate to the workshop by generating a sequence of actions.\n  actions.extend(navigate_to(env, target_workshop_position))\n\n  # Determine the direction needed to face the workshop from the current position.\n  facing_direction = determine_facing_direction(env._current_state.pos, target_workshop_position)\n\n  if facing_direction is not None:\n    actions.append(facing_direction)  # Append the action to turn in the required direction.\n\n  # Perform USE action to craft the item at the workshop.\n  actions.append(craft.ACTION_USE)\n\n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T11:35:18.797990", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index for the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Fetch the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n\n  if \"_at\" not in recipe:\n    raise ValueError(f\"No workshop specified for crafting {item}\")\n\n  workshop_name = recipe[\"_at\"]\n  workshop_indices = [env.world.workshop_indices[i] for i, name in enumerate(env.world.cookbook.index) if name == workshop_name]\n  \n  if len(workshop_indices) == 0:\n    raise ValueError(f\"Workshop {workshop_name} not found in the environment.\")\n\n  # Check inventory to see if we have all required items\n  required_items = {i_kind: count for i_kind, count in recipe.items() if i_kind != \"_at\"}\n\n  # Calculate missing primitives and crafted items needed\n  current_inventory = env._current_state.inventory\n\n  # Collect missing items\n  missing_items = {i_kind: count - current_inventory[i_kind] for i_kind, count in required_items.items() if count > current_inventory[i_kind]}\n  \n  for i_kind, count in missing_items.items():\n      item_name = env.world.cookbook.index.get(i_kind)\n      actions.extend(collect(env, item_name))\n  \n  # Go to the workshop and craft the item\n  workshop_pos = None\n\n  for pos in np.argwhere(env._current_state.grid[:, :, workshop_indices[0]]):\n    if all(env._current_state.next_to(w) for w in workshop_indices):\n      workshop_pos = tuple(pos)\n      break\n  \n  if workshop_pos is not None:\n    actions.extend(navigate(env, workshop_pos))\n    actions.append(craft.USE)\n  else:\n    raise ValueError(f\"No suitable position found to craft {item} at {workshop_name}\")\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-10T11:35:19.776730", "function_name": "craft", "function_body": "  # Fetch the current state and world details\n  current_state = env._current_state\n  world = current_state.world\n  cookbook = world.cookbook\n  \n  # Get the index of the desired item\n  item_index = cookbook.index[item]\n  \n  # Check if we have a recipe for this item\n  if item_index not in cookbook.recipes:\n    return []\n  \n  # Fetch the ingredients needed to craft this item and the workshop required\n  recipe = cookbook.recipes[item_index]\n  ingredients_needed = {ingredient: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n  workshop_required = recipe[\"_at\"]\n  \n  actions = []\n\n  # Collect the necessary primitives/ingredients\n  for ingredient_name, count in ingredients_needed.items():\n    ingredient_index = cookbook.index[ingredient_name]\n    while current_state.inventory[ingredient_index] < count:\n      primitive_actions = collect_v2(env, ingredient_index)\n      if not primitive_actions:\n        return []\n      actions.extend(primitive_actions)\n      _, _, _ = env.step(env.action_specs()[\"USE\"])\n      current_state = env._current_state\n  \n  # Navigate to the required workshop and use it to craft the item\n  workshop_index = world.workshop_indices[world.cookbook.index[workshop_required]]\n  \n  # Determine direction based on relative position of the workshop\n  x_diff = workshop_index[0] - current_state.pos[0]\n  y_diff = workshop_index[1] - current_state.pos[1]\n  \n  if x_diff > 0:\n      actions.append(env.action_specs()[\"RIGHT\"])\n  elif x_diff < 0:\n      actions.append(env.action_specs()[\"LEFT\"])\n  if y_diff > 0:\n      actions.append(env.action_specs()[\"DOWN\"])\n  elif y_diff < 0:\n      actions.append(env.action_specs()[\"UP\"])\n  \n  # Move towards the workshop\n  while current_state.pos != workshop_index:\n    _, _, _ = env.step(actions[-1])\n    current_state = env._current_state\n  \n  # Use the workshop to craft the item\n  actions.append(env.action_specs()[\"USE\"])\n  \n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-10T11:38:28.054527", "function_name": "craft", "function_body": "  def get_workshop_position(state, workshop_index):\n      workshop_indices = state.world.workshop_indices\n      if workshop_index >= len(workshop_indices):\n          return None\n      \n      for y in range(state.grid.shape[1]):\n          for x in range(state.grid.shape[0]):\n              if state.grid[x, y, workshop_indices[workshop_index]] == 1:\n                  return (x, y)\n      return None\n\n  def check_and_collect_primitives(env, recipe):\n      actions = []\n      for ingredient_name, count in recipe.items():\n          if count <= 0: continue\n          \n          ingredient_idx = env.world.cookbook.index.get(ingredient_name)\n          if ingredient_idx is None:\n              return [], False  # Ingredient not found in cookbook\n          \n          while env._current_state.inventory[ingredient_idx] < count:\n              collect_actions = collect_v2(env, ingredient_name)\n              if not collect_actions:\n                  return [], False  # Could not collect the required primitive\n              actions.extend(collect_actions)\n              \n              # Wait for collection to complete (simulated by checking inventory again)\n              if env._current_state.inventory[ingredient_idx] < count:\n                  return [], False  # Could not collect all required primitives\n          \n      return actions, True\n\n  def move_to(state, target_position):\n      actions = []\n      queue = collections.deque([(state.pos, [])])\n      visited = set()\n      directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n      \n      while queue:\n          current_pos, path = queue.popleft()\n          \n          if current_pos == target_position:\n              return path\n          \n          if current_pos in visited:\n              continue\n          visited.add(current_pos)\n          \n          for dx, dy in directions:\n              next_x, next_y = current_pos[0] + dx, current_pos[1] + dy\n              \n              if (0 <= next_x < state.grid.shape[0]) and (0 <= next_y < state.grid.shape[1]):\n                  queue.append(((next_x, next_y), path + [move_to_direction(current_pos, (next_x, next_y))]))\n      \n      return []  # No path found\n\n  def move_to_direction(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n      \n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      else:\n          return 0  # DOWN\n\n  def face_direction(state, target_pos):\n      current_dir = state.dir\n      required_dir = move_to_direction(state.pos, target_pos)\n      \n      if current_dir == required_dir:\n          return []\n      \n      elif (current_dir + 1) % 4 == required_dir:\n          return [0]  # DOWN\n      \n      elif (current_dir - 1) % 4 == required_dir:\n          return [1]  # UP\n      \n      else:\n          return [0, 0] if current_dir == (required_dir + 2) % 4 else [1, 1]\n\n  def is_next_to_workshop(state, workshop_pos):\n      for dx in [-1, 0, 1]:\n          for dy in [-1, 0, 1]:\n              neighbor_x = state.pos[0] + dx\n              neighbor_y = state.pos[1] + dy\n              \n              if (neighbor_x == workshop_pos[0]) and (neighbor_y == workshop_pos[1]):\n                  return True\n      \n      return False\n\n  actions = []\n  \n  # Get the index for the desired item from the cookbook\n  item_idx = env.world.cookbook.index[item]\n  \n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_idx, {})\n  \n  if not recipe:\n    return []  # No recipe found\n  \n  # Determine the workshop where the crafting should happen\n  workshop_key = \"_key\"\n  workshop_index_str = recipe.pop(workshop_key, None)\n  \n  if workshop_index_str is None or not workshop_index_str.isdigit():\n    return []  # Workshop index is not specified correctly in the recipe\n  \n  workshop_index = int(workshop_index_str)\n  \n  if workshop_index < 0 or workshop_index >= len(env.world.workshop_indices):\n    return []  # Invalid workshop index\n\n  target_workshop_pos = get_workshop_position(env._current_state, workshop_index)\n  \n  if target_workshop_pos is None:\n    return []  # Workshop position not found in the grid\n\n  actions, success = check_and_collect_primitives(env, recipe)\n  \n  if not success:\n    return []  # Could not collect all required primitives\n  \n  while not is_next_to_workshop(env._current_state, target_workshop_pos):\n      path_actions = move_to(env._current_state, target_workshop_pos)\n      \n      if not path_actions:\n          break\n      \n      actions.extend(path_actions)\n      face_actions = face_direction(env._current_state, target_workshop_pos)\n      actions.extend(face_actions)\n      \n  # Perform the USE action at the workshop\n  actions.append(4)  # USE action index\n\n  return actions", "island_id": 2, "scores": {"3": 0.0}}
