{"timestamp": "2025-09-10T19:50:01.782068", "function_name": "craft", "function_body": "  def get_actions_to_collect_primitive(primitive_index):\n    actions = []\n    # Navigate to the cell containing the primitive\n    pos = find_closest_item_position(env._current_state.grid, primitive_index)\n    if pos is None:\n      return []  # Primitive not found in the grid\n\n    path = find_path_to_position(env._current_state.pos, pos)\n    actions.extend(path)\n\n    # Add the action to collect the primitive\n    actions.append(env.world.N_ACTIONS - 2)  # Assuming COLLECT action is the second last action\n\n    return actions\n\n  def check_inventory_for_primitives(primitives_required):\n    inventory = env._current_state.inventory\n    for primitive, count in primitives_required.items():\n      if inventory[primitive] < count:\n        return False\n    return True\n\n  def find_closest_item_position(grid, item_index):\n    # Simple BFS to find the closest position of an item\n    start_pos = env._current_state.pos\n    queue = collections.deque([start_pos])\n    visited = set()\n    visited.add(start_pos)\n    directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n    while queue:\n      x, y = queue.popleft()\n      if grid[x, y, item_index] == 1:\n        return (x, y)\n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and (nx, ny) not in visited and grid[nx, ny].sum() == 0:\n          queue.append((nx, ny))\n          visited.add((nx, ny))\n\n    return None\n\n  def find_path_to_position(start_pos, end_pos):\n    # Simple BFS to find the path from start_pos to end_pos\n    queue = collections.deque([(start_pos, [])])\n    visited = set()\n    visited.add(start_pos)\n    directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n    while queue:\n      pos, path = queue.popleft()\n      if pos == end_pos:\n        return path\n\n      for dx, dy in directions:\n        nx, ny = pos[0] + dx, pos[1] + dy\n        if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1] and (nx, ny) not in visited and env._current_state.grid[nx, ny].sum() == 0:\n          queue.append(((nx, ny), path + [move_direction(dx, dy)]))\n          visited.add((nx, ny))\n\n    return []\n\n  def move_direction(dx, dy):\n    if dx == -1 and dy == 0:\n      return env.world.DOWN\n    elif dx == 1 and dy == 0:\n      return env.world.UP\n    elif dx == 0 and dy == -1:\n      return env.world.LEFT\n    elif dx == 0 and dy == 1:\n      return env.world.RIGHT\n\n  def navigate_to_workshop(workshop_index):\n    actions = []\n    # Navigate to the workshop\n    pos = find_closest_item_position(env._current_state.grid, workshop_index)\n    if pos is None:\n      return []  # Workshop not found in the grid\n\n    path = find_path_to_position(env._current_state.pos, pos)\n    actions.extend(path)\n\n    return actions\n\n  def perform_crafting_action(workshop_index):\n    # This function will perform the USE action at the workshop\n    return [env.world.N_ACTIONS - 1]  # Assuming USE action is the last action\n\n  item_index = env.world.cookbook.index[item]\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n\n  if not check_inventory_for_primitives(primitives_required):\n    actions = []\n    for primitive, count in primitives_required.items():\n      for _ in range(count):\n        actions.extend(get_actions_to_collect_primitive(primitive))\n    return actions\n\n  workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n    if \"_at\" in recipe and item_index in recipe:\n      workshop_index = recipe[\"_at\"]\n      break\n\n  if workshop_index is None:\n    raise ValueError(\"No valid workshop found for the given item.\")\n\n  actions_to_workshop = navigate_to_workshop(workshop_index)\n  crafting_action = perform_crafting_action(workshop_index)\n\n  return actions_to_workshop + crafting_action", "island_id": 7, "scores": {"3": -1}}
