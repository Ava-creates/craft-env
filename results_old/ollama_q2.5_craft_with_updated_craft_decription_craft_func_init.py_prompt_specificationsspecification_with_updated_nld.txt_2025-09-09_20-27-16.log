{"timestamp": "2025-09-10T23:55:17.674407", "function_name": "craft", "function_body": "  def has_required_primitives(item_index):\n    required_primitives = env.world.cookbook.primitives_for(item_index)\n    for primitive, count in required_primitives.items():\n      if env._current_state.inventory[primitive] < count:\n        return False\n    return True\n\n  def find_workshop(item_index):\n    workshop_key = None\n    for recipe in env.world.cookbook.recipes.values():\n      if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n        workshop_key = recipe.get(\"_at\")\n        break\n    return getattr(env.world, f\"{workshop_key}_index\", None) if workshop_key else None\n\n  def get_path_to_workshop(target_workshop):\n    start_pos = env._current_state.pos\n    grid_with_target = env._current_state.grid.copy()\n    grid_with_target[:, :, target_workshop] += 1000  # Marking the target workshop for A* search\n\n    target_pos = find_closest_object(grid_with_target, start_pos, target_workshop)\n    if target_pos is None:\n      return []  # No path to the target workshop\n    return a_star_search(env._current_state.grid, start_pos, target_pos)\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all required primitives.\n  if not has_required_primitives(item_index):\n    return []\n\n  # Find the workshop that can be used to craft the item.\n  target_workshop = find_workshop(item_index)\n  \n  if target_workshop is None:\n    return []  # No suitable workshop found.\n\n  # Calculate the shortest path to the target workshop.\n  path_to_workshop = get_path_to_workshop(target_workshop)\n\n  if not path_to_workshop:\n    return []\n\n  actions = []\n  for pos in path_to_workshop[:-1]:\n      actions.extend(move_to_target(env._current_state.grid, env._current_state.pos, pos))\n\n  final_pos = path_to_workshop[-1]\n  actions.append(rotate_to_face(env._current_state, final_pos, target_workshop))\n  actions.append(4)  # Use action\n\n  return actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T23:55:18.751835", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n  \n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  actions = []\n\n  for primitive, count in required_primitives.items():\n    if env._current_state.inventory[primitive] < count:\n      return []  # Return empty list if any required primitive is not available.\n\n  workshop_key = None\n  for recipe in env.world.cookbook.recipes.values():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n      workshop_key = recipe.get(\"_at\")\n      break\n  \n  if workshop_key is None:\n    return []\n  \n  target_workshop = getattr(env.world, f\"{workshop_key}_index\", None)\n  \n  if target_workshop is None:\n    return []  # No workshop index found for the specified workshop key\n\n  start_pos = env._current_state.pos\n  grid_with_target = env._current_state.grid.copy()\n  grid_with_target[:, :, target_workshop] += 1000  # Marking the target workshop for A* search\n  \n  target_pos = find_closest_object(grid_with_target, start_pos, target_workshop)\n\n  if target_pos is None:\n    return []  # No path to the target workshop\n\n  path_to_workshop = a_star_search(env._current_state.grid, start_pos, target_pos)\n  \n  for pos in path_to_workshop[:-1]:\n      actions.extend(move_to_target(env._current_state.grid, env._current_state.pos, pos))\n  \n  final_pos = path_to_workshop[-1]\n  actions.append(rotate_to_face(env._current_state, final_pos, target_workshop))\n  actions.append(4)  # Use action\n\n  return actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T23:56:08.254294", "function_name": "craft", "function_body": "  # Get the goal index for the desired item\n  goal_index = env.world.cookbook.index[item]\n  \n  # Check if we have a recipe for the item\n  if goal_index not in env.world.cookbook.recipes:\n    print(f\"No recipe found for {item}.\")\n    return []\n  \n  # Get the ingredients required and the workshop where crafting should occur\n  recipe = env.world.cookbook.recipes[goal_index]\n  ingredients_required = {env.world.cookbook.index[i]: count for i, count in recipe.items() if i != \"_at\"}\n  workshop_name = recipe[\"_at\"]\n  \n  # Determine the workshop index based on its name\n  if workshop_name not in env.world.cookbook.index:\n    print(f\"Workshop {workshop_name} not found.\")\n    return []\n  \n  workshop_index = env.world.cookbook.index[workshop_name]\n  \n  actions = []\n  \n  # Check inventory for required ingredients\n  missing_ingredients = {}\n  for ingredient, count in ingredients_required.items():\n    if env._current_state.inventory[ingredient] < count:\n      missing_ingredients[ingredient] = count - env._current_state.inventory[ingredient]\n  \n  # If we have all ingredients, proceed to craft the item at the workshop\n  if not missing_ingredients:\n    # Find the nearest path to the workshop and move there\n    actions.extend(find_nearest_path_to_workshop(env, workshop_index))\n    \n    # Use action to craft the item (assuming facing the correct direction)\n    actions.append(4)  # USE action\n    \n    return actions\n  \n  # Otherwise, collect missing ingredients\n  for ingredient, count in missing_ingredients.items():\n    actions.extend(collect_missing_ingredient(env, ingredient, count))\n  \n  # Once all ingredients are collected, move to the workshop and craft the item\n  actions.extend(find_nearest_path_to_workshop(env, workshop_index))\n  actions.append(4)  # USE action\n  \n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-10T23:56:09.238138", "function_name": "craft", "function_body": "  # Step 1: Resolve the index for the goal item\n  goal_index = env.world.cookbook.index[item]\n\n  if goal_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  # Step 2: Check if we have all required primitives and intermediate items in inventory\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  current_inventory = env._current_state.inventory\n\n  for primitive, count in required_primitives.items():\n    if current_inventory[primitive] < count:\n      print(f\"Missing {count - current_inventory[primitive]} of item {env.world.cookbook.index.get(primitive)}\")\n      return []\n\n  # Step 3: If all items are available, proceed to craft the item\n  actions = []\n  \n  recipe = env.world.cookbook.recipes[goal_index]\n  workshop_index = None\n\n  for ingredient in recipe:\n    if \"_at\" in ingredient:\n      workshop_index = env.world.cookbook.index[recipe[ingredient]]\n      break\n\n  if workshop_index is None:\n    raise ValueError(f\"No workshop specified in the recipe for item: {item}\")\n\n  # Navigate to the nearest workshop\n  actions.extend(find_path_to_workshop(env, workshop_index))\n  \n  # Turn towards the workshop (assuming simple grid navigation for now)\n  actions.append(craft.MOVE_FUNC(\"UP\"))  # Placeholder action\n  \n  # Use the USE action to craft the item at the workshop\n  actions.append(craft.USE_ACTION)\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-10T23:58:46.474331", "function_name": "craft", "function_body": "  def get_direction_to_target(pos, target_pos):\n    dy = target_pos[0] - pos[0]\n    dx = target_pos[1] - pos[1]\n\n    if abs(dx) > abs(dy):\n        return craft.RIGHT if dx > 0 else craft.LEFT\n    elif abs(dy) > abs(dx):\n        return craft.DOWN if dy > 0 else craft.UP\n    else:\n        return None\n\n  def find_closest_workshop(pos, workshop_indices):\n      closest_distance = float('inf')\n      closest_index = None\n      \n      for idx in workshop_indices:\n          pos_idx = env.world.workshop_indices[idx]\n          distance = np.linalg.norm(np.array(pos) - np.array(pos_idx))\n          \n          if distance < closest_distance:\n              closest_distance = distance\n              closest_index = idx\n      \n      return closest_distance, closest_index\n\n  def move_to_workshop_and_align_direction(state, workshop_index):\n    target_pos = env.world.workshop_indices[workshop_index]\n    actions = []\n    \n    # Calculate the direction to the workshop\n    direction = get_direction_to_target(state.pos, target_pos)\n    \n    while state.pos != target_pos:\n        if direction is not None and state.dir == direction:\n            actions.append(craft.MOVE_FORWARD)  # Assuming MOVE_FORWARD is defined in craft module\n        else:\n            actions.extend(turn_towards_direction(state.dir, direction))\n        \n        # Update the state after each action\n        _, new_state = state.step(actions[-1])\n        state = new_state\n    \n    return align_direction_with_target(state.pos, target_pos)\n\n  def turn_towards_direction(current_dir, target_dir):\n      directions = [craft.UP, craft.RIGHT, craft.DOWN, craft.LEFT]\n      current_index = directions.index(current_dir)\n      target_index = directions.index(target_dir)\n      \n      # Calculate the shortest path to target direction\n      if (target_index - current_index) % 4 == 1:\n          return [craft.TURN_RIGHT]\n      elif (target_index - current_index) % 4 == 2:\n          return [craft.TURN_AROUND]\n      elif (target_index - current_index) % 4 == 3:\n          return [craft.TURN_LEFT]\n      else:\n          return []\n\n  def align_direction_with_target(pos, target_pos):\n    direction = get_direction_to_target(pos, target_pos)\n    if direction is not None:\n        return [direction]\n    return []\n\n  actions = []\n  \n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we already have the required item in inventory or if it's a primitive\n  if env._current_state.inventory[item_index] > 0 or item_index in env.world.grabbable_indices:\n    return actions\n  \n  # Get all primitives needed to craft this item recursively\n  primitives_needed = get_primitives_recursively(env, item_index)\n  \n  # Collect all the required primitives\n  for primitive, count in primitives_needed.items():\n      actions.extend(collect_v2(env, env.world.cookbook.index.get(primitive)))\n      \n  # Determine the workshop to use based on the recipe\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_name = list(recipe[\"_key\"].split(\"_at=\"))[1] if \"_key\" in recipe else None\n  \n  # If we have a valid workshop, proceed to it\n  if workshop_name:\n      workshop_indices = [idx for idx, name in enumerate(env.world.workshop_indices) \n                          if workshop_name in env.world.cookbook.index.get(name)]\n      \n      # Find the closest workshop of the desired type\n      _, closest_workshop_index = find_closest_workshop(env._current_state.pos, workshop_indices)\n      \n      # Move to the closest workshop and align direction correctly before using\n      actions.extend(move_to_workshop_and_align_direction(env._current_state, closest_workshop_index))\n      \n      # Craft the item at the workshop\n      actions.append(craft.USE)\n  \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T23:58:47.547092", "function_name": "craft", "function_body": "  def get_direction_to_target(pos, target_pos):\n    dy = target_pos[0] - pos[0]\n    dx = target_pos[1] - pos[1]\n\n    if abs(dx) > abs(dy):\n        return craft.RIGHT if dx > 0 else craft.LEFT\n    elif abs(dy) > abs(dx):\n        return craft.DOWN if dy > 0 else craft.UP\n    else:\n        return None\n\n  def find_closest_workshop(pos, workshop_indices):\n      closest_distance = float('inf')\n      closest_index = None\n      \n      for idx in workshop_indices:\n          pos_idx = env.world.workshop_indices[idx]\n          distance = np.linalg.norm(np.array(pos) - np.array(pos_idx))\n          \n          if distance < closest_distance:\n              closest_distance = distance\n              closest_index = idx\n      \n      return closest_distance, closest_index\n\n  def move_to_workshop_and_align_direction(state, workshop_index):\n    target_pos = env.world.workshop_indices[workshop_index]\n    actions = []\n    \n    # Calculate the direction to the workshop\n    direction = get_direction_to_target(state.pos, target_pos)\n    \n    while state.pos != target_pos:\n        if direction is not None and state.dir == direction:\n            actions.append(craft.MOVE_FORWARD)  # Assuming MOVE_FORWARD is defined in craft module\n        else:\n            actions.extend(turn_towards_direction(state.dir, direction))\n        \n        # Update the state after each action\n        _, new_state = state.step(actions[-1])\n        state = new_state\n    \n    return align_direction_with_target(state.pos, target_pos)\n\n  def turn_towards_direction(current_dir, target_dir):\n      directions = [craft.UP, craft.RIGHT, craft.DOWN, craft.LEFT]\n      current_index = directions.index(current_dir)\n      target_index = directions.index(target_dir)\n      \n      # Calculate the shortest path to target direction\n      if (target_index - current_index) % 4 == 1:\n          return [craft.TURN_RIGHT]\n      elif (target_index - current_index) % 4 == 2:\n          return [craft.TURN_AROUND]\n      elif (target_index - current_index) % 4 == 3:\n          return [craft.TURN_LEFT]\n      else:\n          return []\n\n  def align_direction_with_target(pos, target_pos):\n    direction = get_direction_to_target(pos, target_pos)\n    if direction is not None:\n        return [direction]\n    return []\n\n  def collect_v2(env, primitive) -> list[int]:\n    actions = []\n    \n    # Get the index of the desired primitive\n    primitive_index = env.world.cookbook.index[primitive]\n    \n    # Check if we already have the required primitive in inventory\n    if env._current_state.inventory[primitive_index] > 0:\n        return actions\n    \n    # Find all positions of the desired primitive in the environment\n    primitive_positions = np.argwhere(env._current_state.grid == primitive_index)\n    \n    for pos in primitive_positions:\n        # Calculate the direction to the primitive\n        direction = get_direction_to_target(env._current_state.pos, tuple(pos))\n        \n        while env._current_state.pos != tuple(pos):\n            if direction is not None and env._current_state.dir == direction:\n                actions.append(craft.MOVE_FORWARD)\n            else:\n                actions.extend(turn_towards_direction(env._current_state.dir, direction))\n            \n            # Update the state after each action\n            _, new_state = env._current_state.step(actions[-1])\n            env._current_state = new_state\n        \n        # Collect the primitive by using the USE action\n        actions.append(craft.USE)\n    \n    return actions\n\n  def get_primitives_recursively(env, item_idx):\n      nonlocal actions\n      \n      # Check if the item is already in inventory or is a primitive\n      if env._current_state.inventory[item_idx] > 0 or item_idx in env.world.grabbable_indices:\n          return {}\n      \n      primitives = {}\n      recipe = env.world.cookbook.recipes.get(item_idx, {})\n      \n      for ingredient, count in recipe.items():\n          if ingredient != \"_key\":\n              if ingredient.isdigit():  # Assuming ingredient is an index\n                  ingredient_idx = int(ingredient)\n              else:  # Ingredient is a name\n                  ingredient_idx = env.world.cookbook.index[ingredient]\n              \n              # Recursively gather primitives needed for this ingredient\n              sub_primitives = get_primitives_recursively(env, ingredient_idx)\n              for sub_primitive, sub_count in sub_primitives.items():\n                  if sub_primitive in primitives:\n                      primitives[sub_primitive] += sub_count * count\n                  else:\n                      primitives[sub_primitive] = sub_count * count\n              \n              # Add the ingredient itself to the list of needed primitives\n              if ingredient_idx in env.world.grabbable_indices:\n                  if ingredient_idx in primitives:\n                      primitives[ingredient_idx] += count\n                  else:\n                      primitives[ingredient_idx] = count\n      \n      return primitives\n  \n  actions = []\n  \n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we already have the required item in inventory or if it's a primitive\n  if env._current_state.inventory[item_index] > 0:\n      return actions\n  \n  # Get all primitives needed to craft this item recursively\n  primitives_needed = get_primitives_recursively(env, item_index)\n  \n  # Collect all the required primitives\n  for primitive, count in primitives_needed.items():\n      actions.extend(collect_v2(env, env.world.cookbook.index.get(primitive)))\n      \n  # Determine the workshop to use based on the recipe\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_name = list(recipe[\"_key\"].split(\"_at=\"))[1] if \"_key\" in recipe else None\n  \n  # If we have a valid workshop, proceed to it\n  if workshop_name:\n      workshop_indices = [idx for idx, name in enumerate(env.world.workshop_indices) \n                          if workshop_name in env.world.cookbook.index.get(name)]\n      \n      # Find the closest workshop of the desired type\n      _, closest_workshop_index = find_closest_workshop(env._current_state.pos, workshop_indices)\n      \n      # Move to the closest workshop and align direction correctly before using\n      actions.extend(move_to_workshop_and_align_direction(env._current_state, closest_workshop_index))\n      \n      # Craft the item at the workshop\n      actions.append(craft.USE)\n  \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T00:00:06.544888", "function_name": "craft", "function_body": "  # Get the index of the item to be crafted\n  item_index = env.world.cookbook.index[item]\n\n  if not env._current_state.satisfies(\"\", item_index):\n      # Check if we have all the items/primitives required for crafting\n      primitives_needed = env.world.cookbook.primitives_for(item_index)\n\n      actions_to_take = []\n\n      # Collect the required primitives\n      for primitive, count in primitives_needed.items():\n          # Get the name of the primitive from the index\n          primitive_name = env.world.cookbook.index.get(primitive)\n          while env._current_state.inventory[primitive] < count:\n              primitive_actions = collect(env, primitive_name)\n              actions_to_take.extend(primitive_actions)\n\n      # Determine which workshop to go to for crafting\n      recipe = env.world.cookbook.recipes[item_index]\n      workshop_required = None\n\n      for ingredient in recipe.keys():\n          if ingredient == \"_key\":\n              workshop_required = recipe[\"_key\"]\n              break\n\n      if workshop_required:\n          workshop_index = getattr(env.world, f\"{workshop_required}_index\")\n          workshop_actions = move_to_workshop(env._current_state, workshop_index)\n          actions_to_take.extend(workshop_actions)\n\n          # Use the USE action to craft the item\n          actions_to_take.append(4)  # Assuming USE is represented by index 4\n\n      return actions_to_take\n  else:\n      return []  # No need to craft if already in inventory", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-11T00:00:07.694789", "function_name": "craft", "function_body": "  # Initialize an empty list to store the actions.\n  actions = []\n\n  # Get the index of the desired item from the cookbook.\n  goal_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe).\n  if goal_index not in env.world.cookbook.recipes:\n    print(f\"No recipe found for {item}.\")\n    return actions\n\n  # Get the recipe for the desired item.\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  # Collect all required primitives and crafted items.\n  for ingredient, count in recipe.items():\n      if ingredient == \"_key\":\n          continue\n      elif ingredient not in env.world.cookbook.index:\n          print(f\"Unknown ingredient {ingredient} in recipe for {item}.\")\n          return actions\n      \n      ingredient_index = env.world.cookbook.index[ingredient]\n      \n      # If the ingredient is a primitive, we need to collect it.\n      if ingredient_index in env.world.cookbook.primitives:\n          # Generate a list of actions to collect the required amount of this primitive.\n          # For simplicity, let's assume `collect` function exists and returns a list of actions.\n          collect_actions = collect_v2(env, ingredient)\n          actions.extend(collect_actions)\n      \n      # If the ingredient is another crafted item, we need to craft it first.\n      else:\n          # Generate a list of actions to craft this item recursively.\n          craft_actions = craft_v2(env, ingredient)\n          actions.extend(craft_actions)\n\n  # Identify the workshop where the item should be crafted.\n  workshop_name = recipe.get(\"_key\")\n  if workshop_name is None:\n      print(f\"No workshop specified in recipe for {item}.\")\n      return actions\n\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the required workshop on the grid.\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(workshop_positions) == 0:\n      print(f\"No {workshop_name} found on the grid.\")\n      return actions\n\n  # Select the first available position of the required workshop for simplicity.\n  target_workshop_pos = tuple(workshop_positions[0])\n\n  # Generate a list of actions to move to the workshop.\n  move_actions = move_to(env, target_workshop_pos)\n  actions.extend(move_actions)\n\n  # Rotate the agent to face the workshop (assuming facing right for now).\n  rotate_action = env.world.index[\"RIGHT\"]\n  actions.append(rotate_action)\n\n  # Perform the USE action to craft the item at the workshop.\n  use_action = env.world.index[\"USE\"]\n  actions.append(use_action)\n\n  return actions", "island_id": 5, "scores": {}}
{"timestamp": "2025-09-11T00:06:56.547621", "function_name": "craft", "function_body": "  def move_to_target(grid, pos, target):\n    \"\"\"Moves the agent to the nearest cell containing the target item.\"\"\"\n    queue = collections.deque([(pos[0], pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n      \n      if (x, y) in visited or grid[x, y, target] == 1:\n        return path\n      \n      visited.add((x, y))\n      \n      # Explore neighbors\n      for dx, dy, action in [(0, -1, 2), (0, 1, 3), (-1, 0, 0), (1, 0, 1)]:  # LEFT, RIGHT, UP, DOWN\n        nx, ny = x + dx, y + dy\n        \n        if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n          queue.append((nx, ny, path + [action]))\n    \n    return []\n\n  def collect_primitives(env, primitives):\n      \"\"\"Collect all required primitives.\"\"\"\n      actions = []\n      for primitive, count in primitives.items():\n          while env._current_state.inventory[primitive] < count:\n              # Find the nearest primitive in the grid\n              primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive] == 1)\n              if not primitive_positions.any():\n                  return []  # Return empty list if no primitives are available.\n              \n              closest_primitive = tuple(primitive_positions[np.argmin(np.linalg.norm(primitive_positions - env._current_state.pos, axis=1))])\n              actions.extend(move_to_target(env._current_state.grid, env._current_state.pos, primitive))\n              actions.append(4)  # Collect the primitive using USE action.\n      return actions\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Get all the primitives required to craft the item.\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  \n  # Collect all required primitives if they are not in inventory\n  collect_actions = collect_primitives(env, required_primitives)\n  if not collect_actions:\n    return []  # Return empty list if any primitive collection fails.\n\n  # Find the workshop that can be used to craft the item.\n  workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n      workshop_key = recipe.get(\"_at\")\n      if workshop_key is not None:\n        workshop_index = getattr(env.world, f\"{workshop_key}_index\", None)\n        break\n\n  # If no suitable workshop is found, return an empty list.\n  if workshop_index is None:\n    return []\n\n  # Move to the nearest workshop\n  move_actions = move_to_target(env._current_state.grid, env._current_state.pos, workshop_index)\n\n  # Use the USE action at the workshop to craft the item.\n  use_action = [4]  # 4 corresponds to the USE action.\n\n  return collect_actions + move_actions + use_action", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-11T00:11:56.618732", "function_name": "craft", "function_body": "  def move_to_target(grid, pos, target):\n    \"\"\"Moves the agent to the nearest cell containing the target item.\"\"\"\n    queue = collections.deque([(pos[0], pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n      \n      if (x, y) in visited or grid[x, y, target] == 1:\n        return path\n      \n      visited.add((x, y))\n      \n      # Explore neighbors\n      for dx, dy, action in [(0, -1, 2), (0, 1, 3), (-1, 0, 0), (1, 0, 1)]:  # LEFT, RIGHT, UP, DOWN\n        nx, ny = x + dx, y + dy\n        \n        if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n          queue.append((nx, ny, path + [action]))\n    \n    return []\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Get all the primitives required to craft the item.\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  \n  actions = []\n  \n  # Check for each primitive if it's in inventory, otherwise collect them\n  for primitive, count in required_primitives.items():\n    while env._current_state.inventory[primitive] < count:\n      # Find the nearest cell containing the primitive\n      actions.extend(move_to_target(env._current_state.grid, env._current_state.pos, primitive))\n      actions.append(4)  # Collect the primitive\n\n  # Find the workshop that can be used to craft the item.\n  workshop = None\n  for recipe in env.world.cookbook.recipes.values():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n      workshop_key = recipe.get(\"_at\")\n      if workshop_key is not None:\n        workshop = getattr(env.world, f\"{workshop_key}_index\", None)\n        break\n  \n  # If no suitable workshop is found, return an empty list.\n  if workshop is None:\n    return []\n\n  # Move to the nearest workshop\n  actions.extend(move_to_target(env._current_state.grid, env._current_state.pos, workshop))\n  \n  # Use the USE action at the workshop to craft the item.\n  actions.append(4)  # 4 corresponds to the USE action.\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-11T00:13:37.591463", "function_name": "craft", "function_body": "  def get_primitives_recursively(world, item_index):\n    if item_index in world.primitives:\n        return {item_index: 1}\n    \n    recipe = world.cookbook.recipes[item_index]\n    primitives_needed = collections.defaultdict(int)\n    \n    for ingredient, count in recipe.items():\n        if ingredient == \"_key\":\n            continue\n        ingredient_index = world.cookbook.index[ingredient]\n        \n        sub_primitives = get_primitives_recursively(world, ingredient_index)\n        for primitive, sub_count in sub_primitives.items():\n            primitives_needed[primitive] += count * sub_count\n    \n    return primitives_needed\n\n  actions = []\n  \n  item_index = env.world.cookbook.index[item]\n  \n  if env._current_state.inventory[item_index] > 0 or item_index in env.world.grabbable_indices:\n    return []\n\n  primitives_needed = get_primitives_recursively(env.world, item_index)\n\n  for primitive, count in primitives_needed.items():\n      actions.extend(collect_v2(env, primitive))\n      \n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_name = list(recipe[\"_key\"].split(\"_at=\"))[1] if \"_key\" in recipe else None\n  \n  if workshop_name:\n      workshop_indices = [idx for idx, name in enumerate(env.world.workshop_indices) \n                          if f\"{workshop_name}\" in env.world.cookbook.index.get(name)]\n      \n      closest_workshop_index = find_closest_workshop(env._current_state.pos, workshop_indices)\n      \n      actions.extend(move_to_workshop_and_align_direction_v2(env._current_state, closest_workshop_index))\n      \n      # Craft the item at the workshop\n      actions.append(craft.USE)\n\n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T00:13:38.633382", "function_name": "craft", "function_body": "  def get_primitives_recursively(world, goal):\n    cookbook = world.cookbook\n    primitives_needed = collections.defaultdict(int)\n\n    # Base case: if the goal is a primitive, add it to the needed primitives and return\n    if goal in cookbook.primitives:\n      primitives_needed[goal] += 1\n      return primitives_needed\n\n    recipe = cookbook.recipes.get(goal)\n    \n    if not recipe:\n      raise ValueError(f\"No recipe for {cookbook.index.get(goal)}\")\n\n    # If there's a _key, it's a crafting step\n    workshop_step = \"_key\" in recipe and \"at=\" in recipe[\"_key\"]\n    if workshop_step:\n      del recipe[\"_key\"]  # Remove the key to avoid processing it as an ingredient\n\n    for ingredient, count in recipe.items():\n      ingredient_index = cookbook.index[ingredient]\n      primitives_needed.update(get_primitives_recursively(world, ingredient_index))\n\n    return primitives_needed\n\n\n  def find_closest_workshop(pos, workshop_indices):\n    min_distance = float('inf')\n    closest_workshop_index = None\n\n    for idx in workshop_indices:\n      workshop_pos = env.world.workshop_indices[idx]\n      distance = abs(workshop_pos[0] - pos[0]) + abs(workshop_pos[1] - pos[1])\n\n      if distance < min_distance:\n        min_distance = distance\n        closest_workshop_index = idx\n\n    return closest_workshop_index\n\n\n  def move_to_workshop_and_align_direction(state, workshop_index):\n    actions = []\n    target_pos = state.world.workshop_indices[workshop_index]\n\n    # Calculate direction to target position\n    dy = target_pos[0] - state.pos[0]\n    dx = target_pos[1] - state.pos[1]\n\n    while dy != 0 or dx != 0:\n      if dx > 0 and (state.dir == craft.RIGHT or state.dir is None):\n        actions.append(craft.RIGHT)\n        dx -= 1\n      elif dx < 0 and (state.dir == craft.LEFT or state.dir is None):\n        actions.append(craft.LEFT)\n        dx += 1\n      else:\n        # Align direction before moving vertically\n        if dx > 0:\n          actions.append(craft.RIGHT)\n        elif dx < 0:\n          actions.append(craft.LEFT)\n\n      if dy > 0 and (state.dir == craft.DOWN or state.dir is None):\n        actions.append(craft.DOWN)\n        dy -= 1\n      elif dy < 0 and (state.dir == craft.UP or state.dir is None):\n        actions.append(craft.UP)\n        dy += 1\n      else:\n        # Align direction before moving horizontally\n        if dy > 0:\n          actions.append(craft.DOWN)\n        elif dy < 0:\n          actions.append(craft.UP)\n\n    return actions\n\n  actions = []\n  \n  item_index = env.world.cookbook.index[item]\n  \n  if env._current_state.inventory[item_index] > 0 or item_index in env.world.grabbable_indices:\n    return []\n  \n  primitives_needed = get_primitives_recursively(env.world, item_index)\n  \n  for primitive, count in primitives_needed.items():\n      actions.extend(collect_v2(env, env.world.cookbook.index.get(primitive)))\n      \n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_name = list(recipe[\"_key\"].split(\"_at=\"))[1] if \"_key\" in recipe else None\n  \n  if workshop_name:\n      workshop_indices = [idx for idx, name in enumerate(env.world.workshop_indices) \n                          if workshop_name in env.world.cookbook.index.get(name)]\n      \n      closest_workshop_index = find_closest_workshop(state.pos, workshop_indices)\n      \n      actions.extend(move_to_workshop_and_align_direction(state._current_state, closest_workshop_index))\n      \n      # Craft the item at the workshop\n      actions.append(craft.USE)\n  \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T00:15:54.463906", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = env._current_state.inventory.copy()\n\n  # Check if all ingredients are available\n  required_ingredients = {cookbook.index[k]: v for k, v in recipe.items()}\n\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if not can_craft:\n    return []\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No available workshop to craft item\")\n\n  # Select the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n  # Calculate actions to move the agent to the nearest workshop\n  dx = nearest_workshop_pos[0] - current_position[0]\n  dy = nearest_workshop_pos[1] - current_position[1]\n\n  actions_to_take = []\n\n  while abs(dx) + abs(dy) > 0:\n    if abs(dx) >= abs(dy):\n      move_action = craft.MOVE_RIGHT if dx > 0 else craft.MOVE_LEFT\n      dx += -1 if dx > 0 else 1\n    else:\n      move_action = craft.MOVE_DOWN if dy > 0 else craft.MOVE_UP\n      dy += -1 if dy > 0 else 1\n    \n    actions_to_take.append(move_action)\n\n  # Calculate the target direction to face the workshop\n  current_direction = env._current_state.dir\n\n  if dx == 0 and dy == 0:  # Already at the workshop\n      pass\n  elif abs(dx) > abs(dy):  # Prioritize horizontal movement\n      while current_direction != (craft.RIGHT if dx > 0 else craft.LEFT):\n          actions_to_take.append(craft.TURN_RIGHT)\n          current_direction = (current_direction + 1) % 4\n  else:  # Prioritize vertical movement\n      while current_direction != (craft.DOWN if dy > 0 else craft.UP):\n          actions_to_take.append(craft.TURN_LEFT)\n          current_direction = (current_direction - 3) % 4\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T00:15:55.596640", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = env._current_state.inventory.copy()\n\n  # Check if all ingredients are available\n  required_ingredients = {cookbook.index[k]: v for k, v in recipe.items()}\n\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if not can_craft:\n    return []\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No available workshop to craft item\")\n\n  # Select the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n  # Calculate actions to move the agent to the nearest workshop\n  dx = nearest_workshop_pos[0] - current_position[0]\n  dy = nearest_workshop_pos[1] - current_position[1]\n\n  actions_to_take = []\n\n  def add_move_actions(dx, dy):\n    if abs(dx) > abs(dy):  # Prioritize horizontal movement\n      if dx > 0:\n          actions_to_take.extend([craft.MOVE_RIGHT for _ in range(dx)])\n      else:\n          actions_to_take.extend([craft.MOVE_LEFT for _ in range(-dx)])\n    else:  # Prioritize vertical movement\n      if dy > 0:\n          actions_to_take.extend([craft.MOVE_DOWN for _ in range(dy)])\n      else:\n          actions_to_take.extend([craft.MOVE_UP for _ in range(-dy)])\n\n  add_move_actions(dx, dy)\n\n  current_direction = env._current_state.dir\n\n  def calculate_turns(current_direction, target_direction):\n    turn_actions = []\n    while current_direction != target_direction:\n        if (current_direction + 1) % 4 == target_direction:\n            turn_actions.append(craft.TURN_RIGHT)\n            current_direction = (current_direction + 1) % 4\n        else:\n            turn_actions.append(craft.TURN_LEFT)\n            current_direction = (current_direction - 3) % 4\n    return turn_actions\n\n  # Determine the target direction to face the workshop\n  if dx == 0 and dy == 0:  # Already at the workshop\n      pass\n  elif abs(dx) > abs(dy):  # Prioritize horizontal movement\n      target_direction = craft.RIGHT if dx > 0 else craft.LEFT\n  else:  # Prioritize vertical movement\n      target_direction = craft.DOWN if dy > 0 else craft.UP\n\n  actions_to_take.extend(calculate_turns(current_direction, target_direction))\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T00:16:57.594043", "function_name": "craft", "function_body": "  # Get the cookbook from the environment\n  cookbook = env.world.cookbook\n\n  # Convert the item name to its corresponding index in the cookbook\n  item_index = cookbook.index[item]\n\n  # Check if the item has a recipe (if it can be crafted)\n  if item_index not in cookbook.recipes:\n    return []\n\n  # Get the primitives required for crafting the item\n  required_primitives = cookbook.primitives_for(item_index)\n\n  # Initialize the action list\n  actions = []\n\n  # Collect all required primitives if they are not already in inventory\n  for primitive, count in required_primitives.items():\n    # Check how many of this primitive we currently have in our inventory\n    current_count = env._current_state.inventory[primitive]\n    if current_count < count:\n      # We need more of this primitive, so collect the required amount\n      actions.extend(collect_v2(env, cookbook.index.get(primitive)))\n\n  # Find the workshop where the item can be crafted\n  workshop_index = None\n  for recipe in cookbook.recipes.values():\n    if \"_at\" in recipe and recipe[\"_at\"] in env.world.workshop_indices:\n      workshop_index = env.world.workshop_indices[recipe[\"_at\"]]\n      break\n\n  if workshop_index is None:\n    return []\n\n  # Move to the workshop\n  actions.extend(navigate_v2(env, workshop_index))\n\n  # Use the USE action at the workshop to craft the item\n  actions.append(craft.USE)\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-11T00:16:58.605238", "function_name": "craft", "function_body": "  # Initialize actions list\n  actions = []\n  \n  # Get the index for the desired item\n  i_goal = env.world.cookbook.index[item]\n  \n  if i_goal not in env.world.cookbook.recipes:\n    raise ValueError(f\"No recipe found for {item}.\")\n    \n  # Get the primitives required for crafting the goal item\n  recipe = env.world.cookbook.recipes[i_goal]\n  \n  # Check if all primitives are available in inventory or nearby\n  all_primitives_available = True\n  \n  for primitive, count in recipe.items():\n    if primitive == \"_at\":\n      continue\n    \n    i_primitive = env.world.cookbook.index[primitive]\n    \n    # If the primitive is not in inventory and not nearby, we need to collect it\n    if env._current_state.inventory[i_primitive] < count and not env._current_state.next_to(i_primitive):\n      all_primitives_available = False\n      break\n    \n  # If not all primitives are available, return an empty action list for now\n  if not all_primitives_available:\n    return []\n  \n  # Check which workshop is required for crafting the item\n  i_workshop = env.world.cookbook.index[recipe[\"_at\"]]\n  \n  # Move to the nearest workshop of the required type\n  actions.extend(find_path_to(env, i_workshop))\n  \n  # Face the workshop and perform the USE action to craft the item\n  face_action = face_towards(env._current_state, i_workshop)\n  if face_action is not None:\n    actions.append(face_action)\n  actions.append(4)  # USE action\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-11T00:20:43.575020", "function_name": "craft", "function_body": "  def get_primitives_recursively(env, item_index):\n    primitives = {}\n    if item_index in env.world.grabbable_indices:\n        primitives[env.world.cookbook.index.get(item_index)] = 1\n    else:\n        recipe = env.world.cookbook.recipes[item_index]\n        for key, value in recipe.items():\n            if key != \"_key\":\n                primitive_name = list(env.world.cookbook.index.keys())[list(env.world.cookbook.index.values()).index(int(key))]\n                primitives[primitive_name] = value + (primitives.get(primitive_name, 0))\n    return primitives\n\n  def get_direction_to_target(pos, target_pos):\n      dy = target_pos[0] - pos[0]\n      dx = target_pos[1] - pos[1]\n      \n      if dx > 0:\n          return craft.RIGHT\n      elif dx < 0:\n          return craft.LEFT\n      elif dy > 0:\n          return craft.DOWN\n      elif dy < 0:\n          return craft.UP\n      else:\n          return None\n\n  def find_closest_workshop(pos, workshop_indices):\n      distances = [(abs(pos[0] - env.world.workshop_indices[idx][0]) + abs(pos[1] - env.world.workshop_indices[idx][1]), idx) for idx in workshop_indices]\n      return min(distances, key=lambda x: x[0])[1]\n\n  def move_to_workshop_and_align_direction_v2(state, workshop_index):\n    actions = []\n    \n    # Get the target position of the closest workshop\n    workshop_pos = env.world.workshop_indices[workshop_index]\n    \n    # Move to the target position of the closest workshop and align direction correctly before using\n    while state.pos != workshop_pos:\n        target_dir = get_direction_to_target(state.pos, workshop_pos)\n        if target_dir is not None:\n            actions.append(target_dir)\n            state.dir = target_dir  # Update the state's direction\n            current_pos = (current_pos[0] + (1 if env._current_state.dir == craft.DOWN else -1 if env._current_state.dir == craft.UP else 0),\n                         current_pos[1] + (1 if env._current_state.dir == craft.RIGHT else -1 if env._current_state.dir == craft.LEFT else 0))\n    \n    # Align the direction to face the workshop before using\n    target_dir = get_direction_to_target(state.pos, workshop_pos)\n    if target_dir is not None:\n        actions.append(target_dir)\n    \n    return actions\n\n  def collect_v2(env, primitive):\n      actions = []\n      \n      while env._current_state.inventory[primitive] == 0:\n          # Find the closest cell with the required primitive\n          nearest_cell = find_closest_primitive_cell(env._current_state.grid, primitive)\n          \n          if nearest_cell is None:\n              break\n          \n          # Move to the nearest cell containing the primitive\n          actions.extend(move_to_and_align_direction_v2(env._current_state.pos, nearest_cell))\n          \n          # Collect the primitive at the target position\n          actions.append(craft.USE)\n          \n      return actions\n\n  def find_closest_primitive_cell(grid, primitive):\n      positions = np.argwhere(grid[:, :, primitive] > 0)\n      if len(positions) == 0:\n          return None\n      \n      min_distance = float('inf')\n      nearest_cell = None\n      for pos in positions:\n          distance = abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n          if distance < min_distance:\n              min_distance = distance\n              nearest_cell = tuple(pos)\n      \n      return nearest_cell\n\n  def move_to_and_align_direction_v2(current_pos, target_pos):\n      actions = []\n      \n      # Calculate the direction to move towards the target position\n      while current_pos != target_pos:\n          target_dir = get_direction_to_target(current_pos, target_pos)\n          \n          if target_dir is not None:\n              actions.append(target_dir)\n              current_pos = (current_pos[0] + (1 if target_dir == craft.DOWN else -1 if target_dir == craft.UP else 0),\n                             current_pos[1] + (1 if target_dir == craft.RIGHT else -1 if target_dir == craft.LEFT else 0))\n      \n      # Align the direction to face the target position before using\n      target_dir = get_direction_to_target(current_pos, target_pos)\n      if target_dir is not None:\n          actions.append(target_dir)\n      \n      return actions\n  \n  actions = []\n  \n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we already have the required item in inventory or if it's a primitive\n  if env._current_state.inventory[item_index] > 0 or item_index in env.world.grabbable_indices:\n    return []\n  \n  # Get all primitives needed to craft this item\n  primitives_needed = get_primitives_recursively(env, item_index)\n  \n  # Collect all the required primitives\n  for primitive, count in primitives_needed.items():\n      actions.extend(collect_v2(env, env.world.cookbook.index.get(primitive)))\n      \n  # Determine the workshop to use based on the recipe\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_name = list(recipe[\"_key\"].split(\"_at=\"))[1] if \"_key\" in recipe else None\n  \n  if workshop_name:\n      workshop_indices = [idx for idx, name in enumerate(env.world.workshop_indices) \n                          if f\"{workshop_name}\" in env.world.cookbook.index.get(name)]\n      \n      # Find the closest workshop of the desired type\n      closest_workshop_index = find_closest_workshop(env._current_state.pos, workshop_indices)\n      \n      # Move to the closest workshop and align direction correctly before using\n      actions.extend(move_to_workshop_and_align_direction_v2(env._current_state, closest_workshop_index))\n      \n      # Craft the item at the workshop\n      actions.append(craft.USE)\n  \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T00:20:44.642229", "function_name": "craft", "function_body": "  def get_primitives_recursively(env, item_index):\n    primitives = collections.defaultdict(int)\n    \n    queue = [item_index]\n    visited = set()\n    \n    while queue:\n        current_item_index = queue.pop(0)\n        \n        if current_item_index in visited:\n            continue\n        visited.add(current_item_index)\n        \n        if current_item_index in env.world.grabbable_indices:\n            # It's a primitive, add it to the primitives dictionary\n            primitives[current_item_index] += 1\n        else:\n            recipe = env.world.cookbook.recipes.get(current_item_index, {})\n            \n            for key, value in recipe.items():\n                if key != \"_key\":\n                    queue.append(env.world.cookbook.index.get(key))\n    \n    return dict(primitives)\n\n  def get_direction_to_target(pos, target_pos):\n      dy = target_pos[0] - pos[0]\n      dx = target_pos[1] - pos[1]\n      \n      directions = {\n          (dx > 0): craft.RIGHT,\n          (dx < 0): craft.LEFT,\n          (dy > 0): craft.DOWN,\n          (dy < 0): craft.UP\n      }\n      \n      return directions.get(True, None)\n\n  def find_closest_workshop(pos, workshop_indices):\n      distances = [(abs(pos[0] - env.world.workshop_indices[idx][0]) + abs(pos[1] - env.world.workshop_indices[idx][1]), idx) for idx in workshop_indices]\n      return min(distances, key=lambda x: x[0])[1]\n\n  def move_to_workshop_and_align_direction_v2(state, workshop_index):\n    actions = []\n    \n    # Get the target position of the closest workshop\n    workshop_pos = env.world.workshop_indices[workshop_index]\n    \n    while state.pos != workshop_pos:\n        target_dir = get_direction_to_target(state.pos, workshop_pos)\n        \n        if target_dir != state.dir:\n            actions.append(target_dir)\n            state.dir = target_dir  # Update the state's direction\n        else:\n            actions.append(craft.MOVE_FORWARD)  # Move forward in the current direction\n            state.pos = (state.pos[0] + (1 if state.dir == craft.DOWN else -1 if state.dir == craft.UP else 0),\n                         state.pos[1] + (1 if state.dir == craft.RIGHT else -1 if state.dir == craft.LEFT else 0))\n    \n    # Align the direction to face the target position before using\n    target_dir = get_direction_to_target(state.pos, workshop_pos)\n    if target_dir != state.dir:\n        actions.append(target_dir)\n    \n    return actions\n\n  def collect_v2(env, primitive_index):\n      actions = []\n      \n      while env._current_state.inventory[primitive_index] == 0:\n          # Find the closest cell with the required primitive\n          nearest_cell = find_closest_primitive_cell(env._current_state.grid, primitive_index)\n          \n          if nearest_cell is None:\n              break\n          \n          # Move to the nearest cell containing the primitive\n          actions.extend(move_to_and_align_direction(env._current_state.pos, nearest_cell))\n          \n          # Collect the primitive at the target position\n          actions.append(craft.USE)\n      \n      return actions\n\n  def find_closest_primitive_cell(grid, primitive_index):\n      positions = np.argwhere(grid[:, :, primitive_index] > 0)\n      if len(positions) == 0:\n          return None\n      \n      min_distance = float('inf')\n      nearest_cell = None\n      for pos in positions:\n          distance = abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n          if distance < min_distance:\n              min_distance = distance\n              nearest_cell = tuple(pos)\n      \n      return nearest_cell\n\n  def move_to_and_align_direction(current_pos, target_pos):\n      actions = []\n      \n      while current_pos != target_pos:\n          target_dir = get_direction_to_target(current_pos, target_pos)\n          \n          if target_dir != env._current_state.dir:\n              actions.append(target_dir)\n          else:\n              actions.append(craft.MOVE_FORWARD)  # Move forward in the current direction\n              current_pos = (current_pos[0] + (1 if target_dir == craft.DOWN else -1 if target_dir == craft.UP else 0),\n                             current_pos[1] + (1 if target_dir == craft.RIGHT else -1 if target_dir == craft.LEFT else 0))\n      \n      # Align the direction to face the target position before using\n      target_dir = get_direction_to_target(current_pos, target_pos)\n      if target_dir != env._current_state.dir:\n          actions.append(target_dir)\n      \n      return actions\n  \n  actions = []\n  \n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we already have the required item in inventory or if it's a primitive\n  if env._current_state.inventory[item_index] > 0:\n    return []\n  \n  # Get all primitives needed to craft this item\n  primitives_needed = get_primitives_recursively(env, item_index)\n  \n  # Collect all the required primitives\n  for primitive_index, count in primitives_needed.items():\n      actions.extend(collect_v2(env, primitive_index))\n      \n  # Determine the workshop to use based on the recipe\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n  workshop_name = list(recipe[\"_key\"].split(\"_at=\"))[1] if \"_key\" in recipe else None\n  \n  if workshop_name:\n      workshop_indices = [idx for idx, name in enumerate(env.world.workshop_indices) \n                          if workshop_name in env.world.cookbook.index.get(name)]\n      \n      # Find the closest workshop of the desired type\n      closest_workshop_index = find_closest_workshop(env._current_state.pos, workshop_indices)\n      \n      # Move to the closest workshop and align direction correctly before using\n      actions.extend(move_to_workshop_and_align_direction_v2(env._current_state, closest_workshop_index))\n      \n      # Craft the item at the workshop\n      actions.append(craft.USE)\n  \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T00:21:54.198779", "function_name": "craft", "function_body": "  # Step 1: Retrieve the recipe for the desired item\n  index = env.world.cookbook.index\n  item_idx = index.index(item)\n  recipe = env.world.cookbook.recipes[item_idx]\n\n  if not recipe:\n    return []\n\n  actions = []\n  \n  # Step 2: Collect all required ingredients\n  for ingredient, count in recipe.items():\n    if ingredient == \"_key\":\n      continue\n    \n    primitive_idx = index.get(ingredient)\n    \n    while env._current_state.inventory[primitive_idx] < count:\n      collect_actions = collect(env, index.get(primitive_idx))\n      actions.extend(collect_actions)\n\n  # Step 3: Go to the specified workshop and craft the item\n  workshop_key = recipe[\"_key\"]\n  workshop_idx = index.index(workshop_key)\n  \n  # Find path to the workshop\n  # Placeholder for pathfinding logic\n  path_to_workshop = find_path(env._current_state.grid, env._current_state.pos, find_closest_workshop(env._current_state, workshop_idx))\n  actions.extend(path_to_workshop)\n\n  # Step 4: Use the workshop to craft the item\n  actions.append(craft.use_action())\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-11T00:21:55.204441", "function_name": "craft", "function_body": "  # Initialize action list\n  actions = []\n\n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the primitives required for crafting\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  \n  current_inventory = {env.world.cookbook.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n\n  # Check if all primitives are available in inventory\n  for primitive, required_count in primitives_needed.items():\n      if current_inventory.get(primitive, 0) < required_count:\n          print(f\"Missing {primitive}: need {required_count}, have {current_inventory.get(primitive, 0)}\")\n          return []\n\n  # If we have all the primitives, proceed to craft the item\n  workshop_index = None\n  for recipe_input, count in env.world.cookbook.recipes[item_index].items():\n      if recipe_input == \"_at\":\n          workshop_index = env.world.cookbook.index[count]\n          break\n\n  if workshop_index is None:\n      print(\"No workshop specified for crafting.\")\n      return []\n\n  # Find the position of the workshop\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n      print(\"Workshop not found on the grid.\")\n      return []\n\n  # Get the nearest workshop position\n  agent_pos = env._current_state.pos\n  closest_workshop_pos = min(workshop_positions, key=lambda pos: np.linalg.norm(np.array(pos) - np.array(agent_pos)))\n\n  # Calculate actions to move to the closest workshop\n  path_actions = calculate_path_to_position(env, agent_pos, closest_workshop_pos)\n  if not path_actions:\n      print(\"Path to workshop is blocked.\")\n      return []\n\n  actions.extend(path_actions)\n\n  # Face the workshop (assuming simple facing logic for demonstration)\n  face_workshop_action = face_towards_position(env._current_state.pos, closest_workshop_pos)\n  if face_workshop_action:\n      actions.append(face_workshop_action)\n\n  # Use action to craft\n  actions.append(craft.ACTIONS['USE'])\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-11T00:22:49.308729", "function_name": "craft", "function_body": "  actions = []\n\n  # Convert item name to index\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item has a recipe in the cookbook\n  if item_index not in env.world.cookbook.recipes:\n    print(f\"No recipe found for {item}.\")\n    return actions\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Collect all required primitives and crafted items\n  required_items = list(recipe.keys())\n  required_counts = list(recipe.values())\n\n  for i, req_item in enumerate(required_items):\n    if req_item == \"_key\":\n      continue\n\n    req_count = required_counts[i]\n    current_count = env._current_state.inventory[req_item]\n\n    if current_count < req_count:\n      actions.extend(collect_v2(env, env.world.cookbook.index.get(req_item)))\n\n  # Go to the workshop specified in the recipe and perform the USE action\n  workshop_index = env.world.cookbook.index.get(recipe[\"_at\"])\n  if workshop_index is None:\n    print(f\"Workshop not found for {item}.\")\n    return actions\n\n  actions.extend(move_to_workshop(env, workshop_index))\n  actions.append(4)  # USE action\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-11T00:22:50.355540", "function_name": "craft", "function_body": "  actions = []\n  \n  # Convert item name to index\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have the required primitives for crafting the item\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  # If the agent doesn't have all the required primitives, return an empty action list\n  if not all(required_primitive in inventory_dict and inventory_dict[required_primitive] >= amount for required_primitive, amount in required_primitives.items()):\n    return []\n    \n  # Determine which workshop to go to based on the recipe\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_name = list(recipe.values())[0]['_at']\n  \n  # Find the position of the required workshop\n  workshop_index = env.world.cookbook.index[workshop_name]\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  \n  if not workshop_positions.size:\n    return []\n    \n  closest_workshop_position = min(workshop_positions, key=lambda pos: np.linalg.norm(np.array(pos) - np.array(env._current_state.pos)))\n  \n  # Move to the workshop\n  actions.extend(navigate_to(env._current_state.pos, closest_workshop_position))\n  \n  # Turn towards the workshop and use the USE action to craft the item\n  direction = get_direction_to(env._current_state.pos, env._current_state.dir, closest_workshop_position)\n  if direction != env._current_state.dir:\n    actions.append(direction)\n    \n  actions.append(craft.USE)\n\n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T00:25:23.458958", "function_name": "craft", "function_body": "  def get_actions_for_movement(start, target, current_direction):\n    dx = target[0] - start[0]\n    dy = target[1] - start[1]\n\n    actions_to_take = []\n\n    # Determine the direction to move first based on larger distance\n    if abs(dx) >= abs(dy):\n        if dx > 0:\n            while current_direction != craft.RIGHT:\n                actions_to_take.append(craft.TURN_RIGHT)\n                current_direction = (current_direction + 1) % 4\n            actions_to_take.extend([craft.MOVE_RIGHT for _ in range(dx)])\n        elif dx < 0:\n            while current_direction != craft.LEFT:\n                actions_to_take.append(craft.TURN_LEFT)\n                current_direction = (current_direction - 1) % 4\n            actions_to_take.extend([craft.MOVE_LEFT for _ in range(-dx)])\n        \n        if dy > 0:\n            while current_direction != craft.DOWN:\n                actions_to_take.append(craft.TURN_RIGHT)\n                current_direction = (current_direction + 1) % 4\n            actions_to_take.extend([craft.MOVE_DOWN for _ in range(dy)])\n        elif dy < 0:\n            while current_direction != craft.UP:\n                actions_to_take.append(craft.TURN_LEFT)\n                current_direction = (current_direction - 1) % 4", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-11T00:25:24.497791", "function_name": "craft", "function_body": "  def get_actions_for_movement(start, target, current_direction):\n    dx = target[0] - start[0]\n    dy = target[1] - start[1]\n\n    actions_to_take = []\n\n    # Determine the sequence of turns and moves\n    if dx > 0:\n        while current_direction != craft.RIGHT:\n            actions_to_take.append(craft.TURN_RIGHT)\n            current_direction = (current_direction + 1) % 4\n        actions_to_take.extend([craft.MOVE_RIGHT for _ in range(dx)])\n    elif dx < 0:\n        while current_direction != craft.LEFT:\n            actions_to_take.append(craft.TURN_LEFT)\n            current_direction = (current_direction - 1) % 4\n        actions_to_take.extend([craft.MOVE_LEFT for _ in range(-dx)])\n\n    if dy > 0:\n        while current_direction != craft.DOWN:\n            actions_to_take.append(craft.TURN_RIGHT)\n            current_direction = (current_direction + 1) % 4\n        actions_to_take.extend([craft.MOVE_DOWN for _ in range(dy)])\n    elif dy < 0:\n        while current_direction != craft.UP:\n            actions_to_take.append(craft.TURN_LEFT)\n            current_direction = (current_direction - 1) % 4\n        actions_to_take.extend([craft.MOVE_UP for _ in range(-dy)])\n\n    return actions_to_take, current_direction\n\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n\n  if not item_index:\n      raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n      raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n      raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = env._current_state.inventory.copy()\n\n  # Check if all ingredients are available\n  required_ingredients = {cookbook.index[k]: v for k, v in recipe.items()}\n\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n      if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n          can_craft = False\n          break\n\n  if not can_craft:\n      return []\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n      raise ValueError(\"No available workshop to craft item\")\n\n  # Select the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n  # Calculate actions to move the agent to the nearest workshop\n  actions_to_take, current_direction = get_actions_for_movement(\n      current_position, nearest_workshop_pos, env._current_state.dir\n  )\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T00:26:57.136184", "function_name": "craft", "function_body": "  def has_all_primitives(required_primitives, inventory_dict):\n    return all(primitive in inventory_dict and inventory_dict[primitive] >= required_primitives[primitive] for primitive in required_primitives)\n\n  actions = []\n\n  # Get the index of the goal item\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n\n  # If not all primitives are available return empty action list\n  if not has_all_primitives(required_primitives, inventory_dict):\n    return []\n\n  # Find the workshop where we can craft this item\n  workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n      workshop_index = recipe.get(\"_at\")\n      break\n\n  if workshop_index is None:\n    return []\n\n  # Convert workshop index to the actual name of the workshop\n  workshop_name = env.world.cookbook.index.get(workshop_index)\n\n  # Find the position of the nearest workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(workshop_positions) == 0:\n    return []\n\n  # Select the closest workshop (for simplicity, we take the first one found)\n  target_workshop_pos = tuple(workshop_positions[0])\n\n  # Navigate to the selected workshop\n  actions.extend(navigate(env._current_state, target_workshop_pos))\n\n  # Turn towards the workshop if not already facing it\n  current_direction = env._current_state.dir\n  direction_to_workshop = get_direction(env._current_state.pos, target_workshop_pos)\n  if current_direction != direction_to_workshop:\n    actions.append(direction_to_workshop)\n\n  # Use the USE action to craft the item at the workshop\n  actions.append(4)  # Assuming 4 is the index for the USE action\n\n  return actions", "island_id": 8, "scores": {"3": 0.0}}
