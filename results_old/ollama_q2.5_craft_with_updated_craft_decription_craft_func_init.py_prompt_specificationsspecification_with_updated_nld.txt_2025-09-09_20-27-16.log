{"timestamp": "2025-09-10T15:44:36.823174", "function_name": "craft", "function_body": "  def get_actions_to_move(dx: int, dy: int) -> list[int]:\n    actions = []\n    if dx > 0:\n      actions.extend([craft.MOVE_RIGHT for _ in range(dx)])\n    elif dx < 0:\n      actions.extend([craft.MOVE_LEFT for _ in range(-dx)])\n    if dy > 0:\n      actions.extend([craft.MOVE_DOWN for _ in range(dy)])\n    elif dy < 0:\n      actions.extend([craft.MOVE_UP for _ in range(-dy)])\n    return actions\n\n  def get_direction_from_deltas(dx: int, dy: int) -> int:\n    if dx > 0:\n        return craft.RIGHT\n    elif dx < 0:\n        return craft.LEFT\n    elif dy > 0:\n        return craft.DOWN\n    else:  # dy < 0\n        return craft.UP\n\n  def calculate_turns(current_direction: int, target_direction: int) -> list[int]:\n      direction_diff = (target_direction - current_direction) % 4\n      if direction_diff == 1:\n          return [craft.TURN_RIGHT]\n      elif direction_diff == 2:\n          return [craft.TURN_RIGHT, craft.TURN_RIGHT]\n      elif direction_diff == 3:\n          return [craft.TURN_LEFT]\n      else:  # No turn needed\n          return []\n\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n\n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Retrieve the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = env._current_state.inventory.copy()\n\n  # Check if all ingredients are available\n  required_ingredients = {cookbook.index[k]: v for k, v in recipe.items()}\n\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if not can_craft:\n    return []\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No available workshop to craft item\")\n\n  # Select the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n  # Calculate actions to move the agent to the nearest workshop\n  dx = nearest_workshop_pos[0] - current_position[0]\n  dy = nearest_workshop_pos[1] - current_position[1]\n\n  actions_to_take = get_actions_to_move(dx, dy)\n\n  # Rotate the agent to face the workshop\n  current_direction = env._current_state.dir\n\n  target_direction = get_direction_from_deltas(dx, dy)\n\n  turns_needed = calculate_turns(current_direction, target_direction)\n  actions_to_take.extend(turns_needed)\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T15:44:37.874098", "function_name": "craft", "function_body": "  def get_actions_to_move(dx: int, dy: int) -> list[int]:\n    actions = []\n    if dx > 0:\n      actions.extend([craft.MOVE_RIGHT for _ in range(dx)])\n    elif dx < 0:\n      actions.extend([craft.MOVE_LEFT for _ in range(-dx)])\n    if dy > 0:\n      actions.extend([craft.MOVE_DOWN for _ in range(dy)])\n    elif dy < 0:\n      actions.extend([craft.MOVE_UP for _ in range(-dy)])\n    return actions\n\n  def get_direction_from_deltas(dx: int, dy: int) -> int:\n    if dx > 0:\n        return craft.RIGHT\n    elif dx < 0:\n        return craft.LEFT\n    elif dy > 0:\n        return craft.DOWN\n    else:  # dy < 0\n        return craft.UP\n\n  def calculate_turns(current_direction: int, target_direction: int) -> list[int]:\n      direction_diff = (target_direction - current_direction) % 4\n      if direction_diff == 1:\n          return [craft.TURN_RIGHT]\n      elif direction_diff == 2:\n          return [craft.TURN_RIGHT, craft.TURN_RIGHT]\n      elif direction_diff == 3:\n          return [craft.TURN_LEFT]\n      else:  # No turn needed\n          return []\n\n  def move_and_turn(current_position, target_position, current_direction) -> list[int]:\n    actions = []\n    \n    dx = target_position[0] - current_position[0]\n    dy = target_position[1] - current_position[1]\n\n    if dx > 0:\n        actions.extend([craft.MOVE_RIGHT for _ in range(dx)])\n    elif dx < 0:\n        actions.extend([craft.MOVE_LEFT for _ in range(-dx)])\n\n    if dy > 0:\n        actions.extend([craft.MOVE_DOWN for _ in range(dy)])\n    elif dy < 0:\n        actions.extend([craft.MOVE_UP for _ in range(-dy)])\n\n    target_direction = get_direction_from_deltas(dx, dy)\n    \n    if current_direction != target_direction:\n        turns_needed = calculate_turns(current_direction, target_direction)\n        actions.extend(turns_needed)\n\n    return actions\n\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n\n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Retrieve the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = env._current_state.inventory.copy()\n\n  # Check if all ingredients are available\n  required_ingredients = {cookbook.index[k]: v for k, v in recipe.items()}\n\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if not can_craft:\n    return []\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No available workshop to craft item\")\n\n  # Select the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n  actions_to_take = move_and_turn(current_position, nearest_workshop_pos, env._current_state.dir)\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T15:45:47.541697", "function_name": "craft", "function_body": "  # Convert item name to index\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the item has a recipe\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  actions = []\n  workshop_key = \"_at\"\n  workshop_name = recipe[workshop_key]\n  workshop_index = env.world.cookbook.index[workshop_name]\n  \n  # Find the nearest position of the required workshop\n  closest_workshop_pos = find_nearest(env, workshop_index)\n  if closest_workshop_pos is None:\n    return []\n\n  actions.extend(move_to(env, closest_workshop_pos))\n\n  # Check and collect all the required items for crafting\n  for ingredient, count in recipe.items():\n      if ingredient == workshop_key:\n          continue\n      \n      ingredient_index = env.world.cookbook.index[ingredient]\n      \n      for _ in range(count):\n        closest_ingredient_pos = find_nearest(env, ingredient_index)\n        if closest_ingredient_pos is None:\n          return []\n\n        actions.extend(move_to(env, closest_ingredient_pos))\n        actions.append(craft.USE)\n\n  # Finally, use the workshop to craft the item\n  actions.append(craft.USE)\n\n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-10T15:45:48.525006", "function_name": "craft", "function_body": "  # Get the current state\n  current_state = env._current_state\n\n  # Convert the item name to its corresponding index\n  item_index = env.world.cookbook.index[item]\n\n  # Retrieve the recipe for the desired item\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Check if we have all the required items/primitives to craft this item\n  actions_to_take = []\n  for ingredient, count in recipe.items():\n      if ingredient == \"_key\":\n          continue\n\n      ingredient_index = env.world.cookbook.index[ingredient]\n      # Check how many of this ingredient we currently have in our inventory\n      current_count = current_state.inventory[ingredient_index]\n\n      # If the current count is less than required, try to collect more\n      if current_count < count:\n          # Collecting the missing amount of ingredients\n          actions_to_take.extend(collect(env, ingredient))\n\n  # Now that we have all the required ingredients, go to the workshop and craft the item\n  workshop_name = recipe[\"_key\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Check if the agent is next to any of the workshops\n  current_pos = current_state.pos\n  current_direction = current_state.dir\n\n  # Determine which workshop we are closest to\n  nearest_workshop_distance = float('inf')\n  nearest_workshop_position = None\n  for workshop in env.world.workshop_indices:\n      if workshop == workshop_index:\n          workshop_position = np.argwhere(env._current_state.grid[:, :, workshop] > 0)\n          if len(workshop_position) == 0:\n              continue\n\n          workshop_position = tuple(workshop_position[0])\n          distance = abs(current_pos[0] - workshop_position[0]) + abs(current_pos[1] - workshop_position[1])\n\n          if distance < nearest_workshop_distance:\n              nearest_workshop_distance = distance\n              nearest_workshop_position = workshop_position\n\n  # If we found a valid workshop, move to it and craft the item\n  if nearest_workshop_position is not None:\n      actions_to_take.extend(move_towards(env, nearest_workshop_position))\n      actions_to_take.append(craft_v0._USE_ACTION_INDEX)\n\n  return actions_to_take", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-10T15:48:32.122800", "function_name": "craft", "function_body": "  def navigate_to(target_position):\n    start = env._current_state.pos\n    path_finder = PathFinder(env._current_state.grid)\n    path = path_finder.find_path(start, target_position)\n    return path if path else []\n\n  def determine_facing_direction(current_pos, target_pos):\n      current_x, current_y = current_pos\n      target_x, target_y = target_pos\n      \n      dx = target_x - current_x\n      dy = target_y - current_y\n      \n      if abs(dx) > abs(dy):\n          return craft.ACTION_RIGHT if dx > 0 else craft.ACTION_LEFT\n      else:\n          return craft.ACTION_DOWN if dy > 0 else craft.ACTION_UP\n\n  item_index = env.world.cookbook.index[item]\n\n  # Retrieve required primitives for crafting the item from the cookbook.\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n\n  # Create a dictionary of current inventory based on the cookbook's index mapping.\n  current_inventory = {env.world.cookbook.index.get(i): env._current_state.inventory[i] for i in range(len(env._current_state.inventory))}\n\n  actions = []\n\n  # Check if we have all required primitives. If not, return an empty action list.\n  for primitive, count in required_primitives.items():\n    if current_inventory.get(primitive, 0) < count:\n      return []  # Not enough primitives to craft the item.\n\n  # Determine which workshop is required for crafting and navigate there.\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_required = None\n\n  # Extract workshop information from the recipe.\n  for key in recipe.keys():\n    if \"_at\" in key:\n      workshop_required = key.split(\"_at\")[1].strip()\n      break\n\n  if not workshop_required:\n    return []  # No valid workshop found in the recipe.\n\n  # Find positions of the required workshop on the grid.\n  workshop_index = env.world.cookbook.index[workshop_required]\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n  if not workshop_positions.size:\n    return []  # No valid workshop found on the grid.\n\n  # Select the first available workshop position as the target.\n  target_workshop_position = tuple(workshop_positions[0])\n\n  # Navigate to the workshop by generating a sequence of actions.\n  actions.extend(navigate_to(target_workshop_position))\n\n  # Determine the direction needed to face the workshop from the current position.\n  facing_direction = determine_facing_direction(env._current_state.pos, target_workshop_position)\n\n  if facing_direction is not None:\n    actions.append(facing_direction)  # Append the action to turn in the required direction.\n\n  # Perform USE action to craft the item at the workshop.\n  actions.append(craft.ACTION_USE)\n\n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T15:48:33.122420", "function_name": "craft", "function_body": "  def navigate_to(start_pos, goal_pos):\n    open_set = [(0, start_pos)]\n    came_from = {}\n    g_score = {start_pos: 0}\n    f_score = {start_pos: heuristic(start_pos, goal_pos)}\n\n    while open_set:\n      _, current = heapq.heappop(open_set)\n\n      if current == goal_pos:\n        return reconstruct_path(came_from, current)\n\n      for neighbor in neighbors(grid, current):\n        tentative_g_score = g_score[current] + 1\n\n        if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n          came_from[neighbor] = current\n          g_score[neighbor] = tentative_g_score\n          f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal_pos)\n          heapq.heappush(open_set, (f_score[neighbor], neighbor))\n\n    return []\n\n  def heuristic(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def neighbors(grid, pos):\n    x, y = pos\n    results = [(x+1, y), (x-1, y), (x, y+1), (x, y-1)]\n    return [p for p in results if grid[p] == 0]\n\n  def reconstruct_path(came_from, current):\n    total_path = [current]\n    while current in came_from:\n      current = came_from[current]\n      total_path.append(current)\n    return list(reversed(total_path))\n\n  def determine_facing_direction(current_pos, target_pos):\n    if current_pos[0] < target_pos[0]:\n      return craft.ACTION_RIGHT\n    elif current_pos[0] > target_pos[0]:\n      return craft.ACTION_LEFT\n    elif current_pos[1] < target_pos[1]:\n      return craft.ACTION_DOWN\n    elif current_pos[1] > target_pos[1]:\n      return craft.ACTION_UP\n\n  def collect_primitive(env, primitive):\n    # Determine the position of the required primitive on the grid.\n    primitive_index = env.world.cookbook.index[primitive]\n    primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n    if not primitive_positions.size:\n      return []  # No valid primitive found on the grid.\n\n    # Select the first available primitive position as the target.\n    target_primitive_position = tuple(primitive_positions[0])\n\n    # Navigate to the primitive by generating a sequence of actions.\n    actions = navigate_to(env._current_state.pos, target_primitive_position)\n\n    # Determine the direction needed to face the primitive from the current position.\n    facing_direction = determine_facing_direction(env._current_state.pos, target_primitive_position)\n\n    if facing_direction is not None:\n      actions.append(facing_direction)  # Append the action to turn in the required direction.\n\n    # Perform USE action to collect the primitive.\n    actions.append(craft.ACTION_USE)\n\n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Retrieve required primitives for crafting the item from the cookbook.\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n\n  # Create a dictionary of current inventory based on the cookbook's index mapping.\n  current_inventory = {env.world.cookbook.index.get(i): env._current_state.inventory[i] for i in range(len(env._current_state.inventory))}\n\n  actions = []\n\n  # Check if we have all required primitives. If not, collect them.\n  for primitive, count in required_primitives.items():\n    while current_inventory.get(primitive, 0) < count:\n      # Collect the required primitive.\n      collect_actions = collect_primitive(env, primitive)\n      actions.extend(collect_actions)\n\n      # Update the current inventory after collecting the primitive.\n      current_inventory[primitive] = current_inventory.get(primitive, 0) + 1\n\n  # Determine which workshop is required for crafting and navigate there.\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_required = None\n\n  # Extract workshop information from the recipe.\n  for key in recipe.keys():\n    if \"_at\" in key:\n      workshop_required = key.split(\"_at\")[1].strip()\n      break\n\n  if not workshop_required:\n    return []  # No valid workshop found in the recipe.\n\n  # Find positions of the required workshop on the grid.\n  workshop_index = env.world.cookbook.index[workshop_required]\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n  if not workshop_positions.size:\n    return []  # No valid workshop found on the grid.\n\n  # Select the first available workshop position as the target.\n  target_workshop_position = tuple(workshop_positions[0])\n\n  # Navigate to the workshop by generating a sequence of actions.\n  actions.extend(navigate_to(env._current_state.pos, target_workshop_position))\n\n  # Determine the direction needed to face the workshop from the current position.\n  facing_direction = determine_facing_direction(env._current_state.pos, target_workshop_position)\n\n  if facing_direction is not None:\n    actions.append(facing_direction)  # Append the action to turn in the required direction.\n\n  # Perform USE action to craft the item at the workshop.\n  actions.append(craft.ACTION_USE)\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-10T15:49:39.364159", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  item_idx = env.world.cookbook.index.index(item)\n  \n  # Find out what primitives and intermediate items are required to craft the item\n  reqs = env.world.cookbook.primitives_for(item_idx)\n\n  if not reqs:\n    return []  # No recipe for this item\n  \n  actions = []\n\n  # Check if we have all required items in inventory\n  for i_kind, count in reqs.items():\n    while env._current_state.inventory[i_kind] < count:\n      # Find out where to collect primitives (this is a placeholder and needs implementation)\n      collection_actions = collect(env, env.world.cookbook.index.get(i_kind))\n      actions.extend(collection_actions)\n\n  # After collecting all required items, go to the correct workshop\n  workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n    if item_idx == recipe[\"_key\"]:\n      workshop_index = recipe[\"workshop\"]\n      break\n\n  if workshop_index is not None:\n    # Find out where the workshop is (this is a placeholder and needs implementation)\n    workshop_position = find_workshop_position(env, workshop_index)\n    actions.extend(navigate_to(env, workshop_position))\n\n    # Now that we are at the workshop, use it to craft\n    actions.append(craft.USE)\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-10T15:49:40.338366", "function_name": "craft", "function_body": "  actions = []\n  # Get the index of the desired item\n  item_idx = env.world.cookbook.index[item]\n  \n  # Check if the item has a recipe (i.e., can be crafted)\n  if item_idx not in env.world.cookbook.recipes:\n    return []\n\n  # Get the required ingredients for the item from the cookbook\n  recipe = env.world.cookbook.recipes[item_idx]\n\n  # Check inventory for missing ingredients\n  missing_ingredients = {}\n  for ingredient, count in recipe.items():\n      if ingredient == \"_at\":\n          continue\n      ingredient_idx = env.world.cookbook.index[ingredient]\n      if env._current_state.inventory[ingredient_idx] < count:\n          missing_ingredients[ingredient_idx] = count - env._current_state.inventory[ingredient_idx]\n\n  # If there are missing ingredients, return an empty action list for now (we can extend this logic later)\n  if missing_ingredients:\n      return []\n\n  # Find the workshop required for crafting\n  workshop_required = recipe[\"_at\"]\n  workshop_idx = env.world.cookbook.index[workshop_required]\n\n  # Find positions of all workshops in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx] == 1)\n\n  if workshop_positions.size == 0:\n      return []  # No workshop available\n\n  # Choose the closest workshop to the agent's current position\n  agent_pos = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(workshop_positions - agent_pos, axis=1)\n  closest_workshop_idx = np.argmin(distances_to_workshops)\n  closest_workshop_pos = tuple(workshop_positions[closest_workshop_idx])\n\n  # Move to the closest workshop\n  actions.extend(move_to(env, closest_workshop_pos))\n\n  # Face the workshop and use it to craft the item\n  actions.append(face_and_use(env, closest_workshop_pos))\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-10T15:50:29.215041", "function_name": "craft", "function_body": "  # Convert item name to index\n  i_goal = env.world.cookbook.index[item]\n  \n  # Get the primitives required for crafting the item\n  primitives_needed = env.world.cookbook.primitives_for(i_goal)\n  \n  actions = []\n\n  # Check if we have all primitives needed in inventory or on grid\n  for primitive, count in primitives_needed.items():\n    while np.sum(env._current_state.inventory[primitive]) < count:\n      # Find the closest cell with the required primitive on the grid\n      pos = find_closest_primitive_on_grid(env._current_state.grid, primitive)\n      \n      if pos is None:\n        # If no such cell exists, return empty action list\n        print(\"Primitive not found\")\n        return []\n      \n      # Move to the position of the primitive\n      actions.extend(move_to_position(env._current_state.pos, pos))\n      \n      # Collect the primitive\n      actions.append(craft.COLLECT_FUNC(primitive))\n  \n  # Once all primitives are collected, move to the workshop and craft the item\n  workshop_index = get_workshop_for_item(env.world.cookbook.recipes[i_goal])\n  if workshop_index is None:\n    print(\"Workshop not found for item\")\n    return []\n  \n  # Find the closest cell with the required workshop on the grid\n  pos = find_closest_primitive_on_grid(env._current_state.grid, workshop_index)\n  \n  if pos is None:\n    print(\"Workshop not found\")\n    return []\n  \n  # Move to the position of the workshop\n  actions.extend(move_to_position(env._current_state.pos, pos))\n  \n  # Use the workshop to craft the item\n  actions.append(craft.USE_FUNC)\n\n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-10T15:50:30.311437", "function_name": "craft", "function_body": "  actions = []\n  \n  # Convert the item name to its corresponding index\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the required primitives or items in our inventory\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  \n  for primitive, count in required_primitives.items():\n    while env._current_state.inventory[primitive] < count:\n      actions.extend(collect(env, env.world.cookbook.index.get(primitive)))\n  \n  # Now that we have all the primitives, go to the workshop and craft the item\n  workshop_index = next((workshop for workshop in required_primitives.values() if \"_at\" in workshop), None)\n  if workshop_index is not None:\n    actions.extend(move_to_workshop(env, env.world.cookbook.index.get(workshop_index)))\n    actions.append(craft.item)  # This should be the correct action to craft the item\n  \n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-10T15:51:35.868990", "function_name": "craft", "function_body": "  # Convert item name to index\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the recipe for the desired item\n  if item_index not in env.world.cookbook.recipes:\n    print(f\"No recipe found for {item}\")\n    return []\n\n  recipe = env.world.cookbook.recipes[item_index]\n  \n  # Check if we have all ingredients in inventory or need to collect them\n  actions = []\n  current_state = env._current_state\n\n  # Collect required primitives and crafted items from the grid\n  for ingredient, count in recipe.items():\n    if ingredient == \"_at\":\n      workshop_index = env.world.cookbook.index[recipe[\"_at\"]]\n      continue\n    \n    ingredient_index = env.world.cookbook.index[ingredient]\n    \n    # Check if we already have enough of this ingredient in inventory\n    while current_state.inventory[ingredient_index] < count:\n      actions.extend(collect(env, ingredient))\n      current_state = env._current_state\n\n  # Once all ingredients are collected, go to the workshop and craft the item\n  workshop_pos = find_workshop(current_state.grid, workshop_index)\n  if not workshop_pos:\n    print(f\"No workshop found for {recipe['_at']}\")\n    return []\n\n  # Navigate to the workshop\n  path_to_workshop = navigate_to(env._current_state.pos, workshop_pos, env._current_state.dir)\n  actions.extend(path_to_workshop)\n\n  # Face the correct direction and use the USE action to craft\n  final_direction = face_towards(env._current_state.pos, workshop_pos, env._current_state.dir)\n  if final_direction != -1:\n    actions.append(final_direction)\n\n  actions.append(craft.USE)  # Assuming USE is defined in the environment\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-10T15:51:36.843280", "function_name": "craft", "function_body": "  # Convert the item name to its corresponding index\n  item_index = env.world.cookbook.index[item]\n\n  # Get the recipe for the item (if it exists)\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  recipe = env.world.cookbook.recipes[item_index]\n  \n  # Collect all required primitives and crafted items\n  actions_to_take = []\n  \n  # Check if all ingredients are available in the inventory or environment\n  for ingredient, count in recipe.items():\n      if ingredient == \"_at\":\n          workshop_name = recipe[\"_at\"]\n          workshop_index = env.world.cookbook.index[workshop_name]\n          continue\n\n      ingredient_index = env.world.cookbook.index[ingredient]\n      \n      # Check how many of the ingredient we need to collect\n      required_count = count - env._current_state.inventory[ingredient_index]\n      if required_count > 0:\n          # Add actions to collect the required amount of this ingredient\n          primitive_name = env.world.cookbook.index.get(ingredient_index)\n          collect_actions = collect(env, primitive_name)\n          actions_to_take.extend(collect_actions)\n\n  # Move to the workshop and craft the item\n  if \"_at\" in recipe:\n      workshop_name = recipe[\"_at\"]\n      workshop_index = env.world.cookbook.index[workshop_name]\n      \n      # Get the position of the nearest workshop\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n      if workshop_positions.size > 0:\n          nearest_workshop = workshop_positions[np.argmin(np.linalg.norm(workshop_positions - env._current_state.pos, axis=1))]\n          \n          # Add actions to move to the workshop\n          move_actions = move_to(env, nearest_workshop)\n          actions_to_take.extend(move_actions)\n\n          # Add action to use the workshop (face it and perform USE)\n          face_workshop_action = face_and_use(env, nearest_workshop)\n          actions_to_take.append(face_workshop_action)\n\n  return actions_to_take", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-10T15:53:16.701667", "function_name": "craft", "function_body": "  idx = env.world.cookbook.index[item]\n\n  # Check if we have all primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(idx)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n\n  # Verify if the agent has all required items\n  missing_items = []\n  for primitive_idx, required_count in required_primitives.items():\n      if inventory_dict.get(primitive_idx, 0) < required_count:\n          missing_items.append((primitive_idx, required_count))\n\n  if missing_items:\n      return []\n\n  # Proceed to craft the item by going to the workshop specified in the recipe and performing the USE action.\n  # Find the workshop index for the goal item\n  workshop_idx = env.world.cookbook.recipes[idx].get(\"_key\", None)\n  \n  if workshop_idx is not None:\n      # Convert workshop index back to name\n      workshop_name = env.world.cookbook.index.get(workshop_idx)\n      \n      # Find the position of the required workshop in the grid\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx] == 1)\n      \n      if len(workshop_positions) == 0:\n          return []\n      \n      # Assume the closest workshop for now\n      target_pos = tuple(workshop_positions[0])\n      \n      # Compute path to the workshop using a simple heuristic (Manhattan distance)\n      current_pos = env._current_state.pos\n      path_to_workshop = compute_path(current_pos, target_pos, env._current_state.grid)\n\n      if not path_to_workshop:\n          return []\n\n      # Convert path to actions\n      actions_to_workshop = []\n      for next_pos in path_to_workshop[:-1]:  # Exclude the last position as we will face the workshop directly there\n          actions_to_workshop.extend(compute_actions(env._current_state.pos, env._current_state.dir, next_pos))\n          env._current_state.pos = next_pos  # Update position for next step\n\n      # Add final action to face the workshop and perform USE action\n      actions_to_workshop.extend(face_position(env._current_state.pos, env._current_state.dir, target_pos))\n      actions_to_workshop.append(craft.USE)\n\n      return actions_to_workshop\n  \n  return []", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T15:53:17.787941", "function_name": "craft", "function_body": "  idx = env.world.cookbook.index[item]\n\n  # Check if we have all primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(idx)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n\n  # Verify if the agent has all required items\n  missing_items = []\n  for primitive_idx, required_count in required_primitives.items():\n      if inventory_dict.get(primitive_idx, 0) < required_count:\n          missing_items.append((primitive_idx, required_count))\n\n  if missing_items:\n      return []\n\n  # Proceed to craft the item by going to the workshop specified in the recipe and performing the USE action.\n  # Find the workshop index for the goal item\n  workshop_idx = env.world.cookbook.recipes[idx].get(\"_key\", None)\n  \n  if workshop_idx is not None:\n      # Convert workshop index back to name\n      workshop_name = env.world.cookbook.index.get(workshop_idx)\n\n      # Find the position of the required workshop in the grid\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx] == 1)\n      \n      if len(workshop_positions) == 0:\n          return []\n\n      # Assume the closest workshop for now\n      target_pos = tuple(workshop_positions[0])\n      \n      # Compute path to the workshop using a simple heuristic (Manhattan distance)\n      current_pos = env._current_state.pos\n      path_to_workshop = compute_path(current_pos, target_pos, env._current_state.grid)\n\n      if not path_to_workshop:\n          return []\n\n      # Convert path to actions\n      actions_to_workshop = []\n      for next_pos in path_to_workshop:\n          actions_to_workshop.extend(compute_actions(env._current_state.pos, env._current_state.dir, next_pos))\n          env._current_state.pos = next_pos  # Update position for next step\n\n      # Ensure the agent is facing the correct direction to use the workshop\n      final_action = compute_directional_action(env._current_state.pos, env._current_state.dir, target_pos)\n      if final_action:\n          actions_to_workshop.append(final_action)\n\n      # Add USE action to craft the item\n      actions_to_workshop.append(craft.USE)\n\n      return actions_to_workshop\n  \n  return []", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T15:55:19.621902", "function_name": "craft", "function_body": "  def navigate_to(position):\n      x, y = env._current_state.pos\n      target_x, target_y = position\n\n      actions = []\n      if target_x < x:\n          actions.extend([env.ACTION_LEFT] * (x - target_x))\n      elif target_x > x:\n          actions.extend([env.ACTION_RIGHT] * (target_x - x))\n\n      if target_y < y:\n          actions.extend([env.ACTION_DOWN] * (y - target_y))\n      elif target_y > y:\n          actions.extend([env.ACTION_UP] * (target_y - y))\n\n      return actions\n\n  def determine_facing_direction(current_position, target_position):\n      cx, cy = current_position\n      tx, ty = target_position\n      \n      if tx < cx:\n          return env.ACTION_LEFT\n      elif tx > cx:\n          return env.ACTION_RIGHT\n      elif ty < cy:\n          return env.ACTION_DOWN\n      elif ty > cy:\n          return env.ACTION_UP\n\n  def navigate_and_craft(target_workshop_position):\n      nonlocal actions\n      # Navigate to the workshop\n      actions.extend(navigate_to(target_workshop_position))\n\n      # Turn to face the workshop (assuming we can determine the direction needed)\n      facing_direction = determine_facing_direction(env._current_state.pos, target_workshop_position)\n      if facing_direction is not None:\n          actions.append(facing_direction)\n\n      # Perform USE action to craft the item\n      actions.append(craft.ACTION_USE)\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  current_inventory = {env.world.cookbook.index.get(i): env._current_state.inventory[i] for i in range(len(env._current_state.inventory))}\n\n  actions = []\n\n  # Check if we have all the primitives required\n  for primitive, count in required_primitives.items():\n      if current_inventory.get(primitive, 0) < count:\n          return []  # Return empty list as we do not have enough primitives\n\n  # Determine which workshop to use and navigate there\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_required = None\n  for key in recipe.keys():\n      if \"_at\" in key:\n          workshop_required = key.split(\"_at\")[1].strip()\n          break\n\n  if not workshop_required:\n      return []  # No valid workshop found in the recipe\n\n  # Find the position of the required workshop in the grid\n  workshop_index = env.world.cookbook.index[workshop_required]\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n  if not workshop_positions.size:\n      return []  # No valid workshop found on the grid\n\n  target_workshop_position = tuple(workshop_positions[0])\n\n  # Navigate and craft\n  navigate_and_craft(target_workshop_position)\n\n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T15:55:20.720594", "function_name": "craft", "function_body": "  def navigate_to(position):\n      \"\"\"Navigate to a given position.\"\"\"\n      nonlocal actions\n      current_pos = env._current_state.pos\n\n      # Simple pathfinding: Move in the direction needed to reach the target position\n      if position[0] < current_pos[0]:\n          actions.append(craft.ACTION_UP)\n      elif position[0] > current_pos[0]:\n          actions.append(craft.ACTION_DOWN)\n\n      if position[1] < current_pos[1]:\n          actions.append(craft.ACTION_LEFT)\n      elif position[1] > current_pos[1]:\n          actions.append(craft.ACTION_RIGHT)\n\n  def determine_facing_direction(current, target):\n      \"\"\"Determine the direction to face the target position.\"\"\"\n      dx = target[0] - current[0]\n      dy = target[1] - current[1]\n\n      if abs(dx) > abs(dy):\n          return craft.ACTION_DOWN if dx > 0 else craft.ACTION_UP\n      else:\n          return craft.ACTION_RIGHT if dy > 0 else craft.ACTION_LEFT\n\n  def navigate_and_craft(target_workshop_position):\n      nonlocal actions\n      # Navigate to the workshop\n      navigate_to(target_workshop_position)\n\n      # Turn to face the workshop (assuming we can determine the direction needed)\n      facing_direction = determine_facing_direction(env._current_state.pos, target_workshop_position)\n      if facing_direction is not None:\n          actions.append(facing_direction)\n\n      # Perform USE action to craft the item\n      actions.append(craft.ACTION_USE)\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  current_inventory = {env.world.cookbook.index.get(i): env._current_state.inventory[i] for i in range(len(env._current_state.inventory))}\n\n  actions = []\n\n  # Check if we have all the primitives required\n  for primitive, count in required_primitives.items():\n      if current_inventory.get(primitive, 0) < count:\n          return []  # Return empty list as we do not have enough primitives\n\n  # Determine which workshop to use and navigate there\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_required = None\n  for key in recipe.keys():\n      if \"_at\" in key:\n          workshop_required = key.split(\"_at\")[1].strip()\n          break\n\n  if not workshop_required:\n      return []  # No valid workshop found in the recipe\n\n  # Find the position of the required workshop in the grid\n  workshop_index = env.world.cookbook.index[workshop_required]\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n  if not workshop_positions.size:\n      return []  # No valid workshop found on the grid\n\n  target_workshop_position = tuple(workshop_positions[0])\n\n  # Navigate and craft\n  navigate_and_craft(target_workshop_position)\n\n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T15:57:49.771585", "function_name": "craft", "function_body": "  def find_nearest_workshop(workshop_index):\n    pos_x, pos_y = env._current_state.pos\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    \n    if not workshop_positions.size:\n      return None\n\n    # Calculate distances to each workshop and find the closest one\n    distances = [abs(x - pos_x) + abs(y - pos_y) for x, y in workshop_positions]\n    nearest_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n    return nearest_workshop_pos\n\n  def move_to_position(target_pos):\n    actions = []\n    current_pos = env._current_state.pos\n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if abs(dx) > abs(dy):\n        move_dir = \"RIGHT\" if dx > 0 else \"LEFT\"\n      else:\n        move_dir = \"DOWN\" if dy > 0 else \"UP\"\n\n      actions.append(env.world.N_ACTIONS[move_dir])\n      # Simulate the movement to update current_pos\n      if move_dir == \"RIGHT\":\n        current_pos = (current_pos[0] + 1, current_pos[1])\n      elif move_dir == \"LEFT\":\n        current_pos = (current_pos[0] - 1, current_pos[1])\n      elif move_dir == \"DOWN\":\n        current_pos = (current_pos[0], current_pos[1] + 1)\n      elif move_dir == \"UP\":\n        current_pos = (current_pos[0], current_pos[1] - 1)\n\n    return actions\n\n  def collect_primitive(primitive):\n    primitive_index = env.world.cookbook.index.get(primitive, None)\n    if primitive_index is None:\n      return []\n\n    # Find positions of the required primitive in the grid\n    primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n    \n    if not primitive_positions.size:\n      return []\n\n    # Calculate distances to each position and find the closest one\n    pos_x, pos_y = env._current_state.pos\n    distances = [abs(x - pos_x) + abs(y - pos_y) for x, y in primitive_positions]\n    nearest_primitive_pos = tuple(primitive_positions[np.argmin(distances)])\n\n    # Determine actions to move to the nearest primitive position\n    actions_to_move = move_to_position(nearest_primitive_pos)\n\n    # Add COLLECT action (assuming COLLECT is represented by a specific action index)\n    actions_to_move.append(env.world.COLLECT)\n\n    return actions_to_move\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if there's a recipe for this item\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the ingredients required to craft this item\n  recipe = env.world.cookbook.recipes[item_index]\n  ingredients_needed = {ingredient: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n\n  actions = []\n  \n  # Check and collect each needed ingredient\n  for ingredient, count in ingredients_needed.items():\n    while count > 0:\n      primitive_actions = collect_primitive(ingredient)\n      if not primitive_actions:\n        return []  # Cannot find or collect the required primitive\n      actions.extend(primitive_actions)\n\n      # Simulate collecting the primitive to update inventory and decrease needed count\n      current_inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n      if ingredient in current_inventory_dict:\n        ingredients_needed[ingredient] -= 1\n\n  # Get the workshop index where this item needs to be crafted\n  workshop_name = recipe[\"_at\"]\n  workshop_index = getattr(env.world, f\"{workshop_name}_index\")\n\n  # Find the position of the nearest workshop in the grid\n  nearest_workshop_pos = find_nearest_workshop(workshop_index)\n  \n  if not nearest_workshop_pos:\n    return []\n\n  # Determine actions to move to the nearest workshop\n  actions.extend(move_to_position(nearest_workshop_pos))\n\n  # Add USE action to craft the item\n  actions.append(env.world.USE)\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-10T15:57:50.839649", "function_name": "craft", "function_body": "  def find_nearest_workshop(workshop_index):\n    pos_x, pos_y = env._current_state.pos\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    \n    if not workshop_positions.size:\n      return None\n\n    # Calculate distances to each workshop and find the closest one\n    distances = [abs(x - pos_x) + abs(y - pos_y) for x, y in workshop_positions]\n    nearest_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n    return nearest_workshop_pos\n\n  def move_to_position(target_pos):\n    actions = []\n    current_pos = env._current_state.pos\n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if abs(dx) > abs(dy):\n        move_dir = \"RIGHT\" if dx > 0 else \"LEFT\"\n      else:\n        move_dir = \"DOWN\" if dy > 0 else \"UP\"\n\n      actions.append(env.world.N_ACTIONS[move_dir])\n      # Simulate the movement to update current_pos\n      if move_dir == \"RIGHT\":\n        current_pos = (current_pos[0] + 1, current_pos[1])\n      elif move_dir == \"LEFT\":\n        current_pos = (current_pos[0] - 1, current_pos[1])\n      elif move_dir == \"DOWN\":\n        current_pos = (current_pos[0], current_pos[1] + 1)\n      elif move_dir == \"UP\":\n        current_pos = (current_pos[0], current_pos[1] - 1)\n\n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if there's a recipe for this item\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the ingredients required to craft this item\n  recipe = env.world.cookbook.recipes[item_index]\n  ingredients_needed = {ingredient: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n\n  # Check if we have all the ingredients in our inventory\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  # Subtract the ingredients we already have from what's needed\n  for ingredient_index, count in inventory_dict.items():\n    if ingredient_index in ingredients_needed:\n      ingredients_needed[ingredient_index] -= count\n      if ingredients_needed[ingredient_index] <= 0:\n        del ingredients_needed[ingredient_index]\n\n  # If there are still ingredients needed, return an empty action list\n  if ingredients_needed:\n    return []\n\n  # Get the workshop index where this item needs to be crafted\n  workshop_name = recipe[\"_at\"]\n  workshop_index = getattr(env.world, f\"{workshop_name}_index\")\n\n  # Find the position of the nearest workshop in the grid\n  nearest_workshop_pos = find_nearest_workshop(workshop_index)\n  \n  if not nearest_workshop_pos:\n    return []\n\n  # Determine actions to move to the nearest workshop\n  actions_to_move = move_to_position(nearest_workshop_pos)\n\n  # Add USE action to craft the item\n  actions_to_move.append(env.world.USE)\n\n  return actions_to_move", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T15:58:44.750824", "function_name": "craft", "function_body": "  # Get the index of the goal item from the cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Retrieve all primitives required for crafting the goal item\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  \n  actions = []\n  \n  # Check if we already have all required items in inventory\n  all_have_required_items = True\n  for primitive, count in required_primitives.items():\n    if env._current_state.inventory[primitive] < count:\n      all_have_required_items = False\n  \n  # If not all primitives are available, return an empty list of actions\n  if not all_have_required_items:\n    return []\n  \n  # Proceed with crafting the item at the specified workshop\n  workshop_index = required_primitives[\"_key\"]\n  workshop_position = env._current_state.world.workshop_indices[workshop_index]\n  \n  # Calculate path to the workshop\n  path_to_workshop = calculate_path(env._current_state.grid, \n                                    env._current_state.pos, \n                                    workshop_position)\n  \n  actions.extend(path_to_workshop)\n  \n  # Add action to use the workshop\n  actions.append(craft.ACTIONS['USE'])\n  \n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-10T15:58:45.727346", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index for the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the primitives required to craft the item\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  \n  # Collecting the needed primitives\n  for primitive, count in primitives_needed.items():\n    while env._current_state.inventory[primitive] < count:\n      actions.extend(collect_v2(env, env.world.cookbook.index.get(primitive)))\n      \n  # Check where to craft the item (workshop)\n  workshop_index = None\n  for recipe_output, recipe_inputs in env.world.cookbook.recipes.items():\n    if \"_at\" in recipe_inputs and recipe_output == item_index:\n      workshop_name = recipe_inputs[\"_at\"]\n      workshop_index = env.world.workshop_indices[env.world.cookbook.index[workshop_name]]\n      break\n  \n  # If no workshop is found, return an empty action list\n  if workshop_index is None:\n    return []\n  \n  # Navigate to the workshop\n  actions.extend(navigate_to_workshop(env._current_state.grid, env._current_state.pos, workshop_index))\n  \n  # Use the USE action at the workshop to craft the item\n  actions.append(craft.ACTIONS.USE)\n  \n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-10T16:02:06.126122", "function_name": "craft", "function_body": "  def find_nearest_workshop(workshop_index):\n    pos_x, pos_y = env._current_state.pos\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    \n    if not workshop_positions.size:\n      return None\n\n    # Calculate Manhattan distances to each workshop and find the closest one\n    distances = [abs(x - pos_x) + abs(y - pos_y) for x, y in workshop_positions]\n    nearest_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n    return nearest_workshop_pos\n\n  def move_to_position(target_pos):\n      actions = []\n      current_pos = env._current_state.pos\n      direction_order = [\"RIGHT\", \"LEFT\", \"DOWN\", \"UP\"]  # Define a priority order for directions\n\n      while current_pos != target_pos:\n          dx = target_pos[0] - current_pos[0]\n          dy = target_pos[1] - current_pos[1]\n\n          if abs(dx) > abs(dy):\n              move_dir = \"RIGHT\" if dx > 0 else \"LEFT\"\n          else:\n              move_dir = \"DOWN\" if dy > 0 else \"UP\"\n\n          # Check all possible directions to avoid obstacles\n          for direction in direction_order:\n              next_pos, move_action = get_next_position(current_pos, direction)\n              if is_valid_move(next_pos):\n                  actions.append(env.world.N_ACTIONS[direction])\n                  current_pos = next_pos\n                  break\n\n      return actions\n\n  def get_next_position(pos, direction):\n      x, y = pos\n      if direction == \"RIGHT\":\n          return (x + 1, y), env.world.N_ACTIONS[\"RIGHT\"]\n      elif direction == \"LEFT\":\n          return (x - 1, y), env.world.N_ACTIONS[\"LEFT\"]\n      elif direction == \"DOWN\":\n          return (x, y + 1), env.world.N_ACTIONS[\"DOWN\"]\n      elif direction == \"UP\":\n          return (x, y - 1), env.world.N_ACTIONS[\"UP\"]\n\n  def is_valid_move(pos):\n      x, y = pos\n      # Ensure the position is within grid bounds and not an obstacle\n      return (0 <= x < env._current_state.grid.shape[0] and \n              0 <= y < env._current_state.grid.shape[1] and \n              env._current_state.grid[x, y, env.world.cookbook.index[\"BOUNDARY\"]] == 0)\n\n  def collect_ingredients(ingredient_dict):\n      actions = []\n      for ingredient_index, count_needed in ingredient_dict.items():\n          ingredient_name = env.world.cookbook.index.get_by_value(ingredient_index)\n          \n          while count_needed > 0:\n              # Find the nearest source of this ingredient\n              ingredient_positions = np.argwhere(env._current_state.grid[:, :, ingredient_index] == 1)\n\n              if not ingredient_positions.size:\n                  return []  # Ingredient not found in environment\n\n              distances = [abs(x - env._current_state.pos[0]) + abs(y - env._current_state.pos[1]) for x, y in ingredient_positions]\n              nearest_ingredient_pos = tuple(ingredient_positions[np.argmin(distances)])\n\n              actions.extend(move_to_position(nearest_ingredient_pos))\n              actions.append(env.world.USE)\n\n              # Update inventory\n              env._current_state.inventory[ingredient_index] += 1\n              count_needed -= 1\n\n      return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if there's a recipe for this item\n  if item_index not in env.world.cookbook.recipes:\n      return []\n\n  # Get the ingredients required to craft this item\n  recipe = env.world.cookbook.recipes[item_index]\n  ingredients_needed = {ingredient: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n\n  # Check if we have all the ingredients in our inventory\n  inventory_dict = {i: count for i, count in enumerate(env._current_state.inventory) if count > 0}\n\n  # Subtract the ingredients we already have from what's needed\n  for ingredient_index, count in inventory_dict.items():\n      if ingredient_index in ingredients_needed:\n          ingredients_needed[ingredient_index] -= count\n          if ingredients_needed[ingredient_index] <= 0:\n              del ingredients_needed[ingredient_index]\n\n  # Collect missing ingredients\n  actions = collect_ingredients(ingredients_needed)\n\n  if not actions:\n      return []\n\n  # Get the workshop index where this item needs to be crafted\n  workshop_name = recipe[\"_at\"]\n  workshop_index = getattr(env.world, f\"{workshop_name}_index\")\n\n  # Find the position of the nearest workshop in the grid\n  nearest_workshop_pos = find_nearest_workshop(workshop_index)\n  \n  if not nearest_workshop_pos:\n      return []\n\n  # Determine actions to move to the nearest workshop\n  actions.extend(move_to_position(nearest_workshop_pos))\n\n  # Add USE action to craft the item\n  actions.append(env.world.USE)\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-10T16:02:07.096285", "function_name": "craft", "function_body": "  def find_nearest_workshop(workshop_index):\n    pos_x, pos_y = env._current_state.pos\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    \n    if not workshop_positions.size:\n      return None\n\n    # Calculate Manhattan distances to each workshop and find the closest one\n    distances = [abs(x - pos_x) + abs(y - pos_y) for x, y in workshop_positions]\n    nearest_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n    return nearest_workshop_pos\n\n  def move_to_position(target_pos):\n    actions = []\n    current_pos = env._current_state.pos\n    direction_order = [\"RIGHT\", \"LEFT\", \"DOWN\", \"UP\"]  # Define a priority order for directions\n\n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if abs(dx) > abs(dy):\n        move_dir = \"RIGHT\" if dx > 0 else \"LEFT\"\n      else:\n        move_dir = \"DOWN\" if dy > 0 else \"UP\"\n\n      # Check all possible directions to avoid obstacles\n      for direction in direction_order:\n        next_pos, move_action = get_next_position(current_pos, direction)\n        if is_valid_move(next_pos):\n          actions.append(env.world.N_ACTIONS[direction])\n          current_pos = next_pos\n          break\n\n    return actions\n\n  def get_next_position(pos, direction):\n    x, y = pos\n    if direction == \"RIGHT\":\n      return (x + 1, y), env.world.N_ACTIONS[\"RIGHT\"]\n    elif direction == \"LEFT\":\n      return (x - 1, y), env.world.N_ACTIONS[\"LEFT\"]\n    elif direction == \"DOWN\":\n      return (x, y + 1), env.world.N_ACTIONS[\"DOWN\"]\n    elif direction == \"UP\":\n      return (x, y - 1), env.world.N_ACTIONS[\"UP\"]\n\n  def is_valid_move(pos):\n    x, y = pos\n    # Ensure the position is within grid bounds and not an obstacle\n    return (0 <= x < env._current_state.grid.shape[0] and \n            0 <= y < env._current_state.grid.shape[1] and \n            env._current_state.grid[x, y, env.world.cookbook.index[\"BOUNDARY\"]] == 0)\n\n  def collect_ingredient(ingredient_name):\n    ingredient_index = env.world.cookbook.index[ingredient_name]\n    ingredient_positions = np.argwhere(env._current_state.grid[:, :, ingredient_index] == 1)\n    \n    if not ingredient_positions.size:\n      return []\n\n    # Calculate Manhattan distances to each ingredient and find the closest one\n    pos_x, pos_y = env._current_state.pos\n    distances = [abs(x - pos_x) + abs(y - pos_y) for x, y in ingredient_positions]\n    nearest_ingredient_pos = tuple(ingredient_positions[np.argmin(distances)])\n\n    # Determine actions to move to the nearest ingredient\n    actions_to_move = move_to_position(nearest_ingredient_pos)\n\n    # Add COLLECT action (assuming it's an index corresponding to a specific action)\n    actions_to_move.append(env.world.N_ACTIONS[\"COLLECT\"])\n\n    return actions_to_move\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if there's a recipe for this item\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the ingredients required to craft this item\n  recipe = env.world.cookbook.recipes[item_index]\n  ingredients_needed = {ingredient: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n\n  actions = []\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n\n  # Collect all missing ingredients\n  for ingredient_name, count_needed in ingredients_needed.items():\n    if ingredient_name not in inventory_dict or inventory_dict[ingredient_name] < count_needed:\n      actions.extend(collect_ingredient(ingredient_name))\n      # Simulate collecting the ingredient (for demonstration purposes)\n      env._current_state.inventory[inventory_dict.get(env.world.cookbook.index[ingredient_name], 0) + 1]\n\n  # Get the workshop index where this item needs to be crafted\n  workshop_name = recipe[\"_at\"]\n  workshop_index = getattr(env.world, f\"{workshop_name}_index\")\n\n  # Find the position of the nearest workshop in the grid\n  nearest_workshop_pos = find_nearest_workshop(workshop_index)\n  \n  if not nearest_workshop_pos:\n    return []\n\n  # Determine actions to move to the nearest workshop\n  actions.extend(move_to_position(nearest_workshop_pos))\n\n  # Add USE action to craft the item\n  actions.append(env.world.N_ACTIONS[\"USE\"])\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-10T16:04:07.795284", "function_name": "craft", "function_body": "  def get_actions_for_movement(start, target, current_direction):\n    dx = target[0] - start[0]\n    dy = target[1] - start[1]\n\n    actions_to_take = []\n\n    while dx != 0 or dy != 0:\n      if abs(dx) > abs(dy):  # Prioritize horizontal movement\n        direction = craft.RIGHT if dx > 0 else craft.LEFT\n      else:  # Prioritize vertical movement\n        direction = craft.DOWN if dy > 0 else craft.UP\n\n      while current_direction != direction:\n        actions_to_take.append(craft.TURN_RIGHT)\n        current_direction = (current_direction + 1) % 4\n\n      if direction == craft.RIGHT:\n        actions_to_take.append(craft.MOVE_RIGHT)\n        dx -= 1\n      elif direction == craft.LEFT:\n        actions_to_take.append(craft.MOVE_LEFT)\n        dx += 1\n      elif direction == craft.DOWN:\n        actions_to_take.append(craft.MOVE_DOWN)\n        dy -= 1\n      elif direction == craft.UP:\n        actions_to_take.append(craft.MOVE_UP)\n        dy += 1\n\n    return actions_to_take, current_direction\n\n  def find_closest_workshop(grid, workshop_index):\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n    if len(positions) == 0:\n      return None\n    return tuple(positions[0])\n\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = env._current_state.inventory.copy()\n\n  # Check if all ingredients are available\n  required_ingredients = {cookbook.index[k]: v for k, v in recipe.items()}\n\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if not can_craft:\n    return []\n\n  # Find the closest workshop\n  nearest_workshop_pos = find_closest_workshop(env._current_state.grid, workshop_index)\n\n  if not nearest_workshop_pos:\n    raise ValueError(\"No available workshop to craft item\")\n\n  # Calculate actions to move the agent to the nearest workshop\n  current_position = env._current_state.pos\n  actions_to_take, _ = get_actions_for_movement(\n      current_position, nearest_workshop_pos, env._current_state.dir\n  )\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T16:04:08.849856", "function_name": "craft", "function_body": "  def get_actions_for_movement(start, target, current_direction):\n    dx = target[0] - start[0]\n    dy = target[1] - start[1]\n\n    actions_to_take = []\n\n    # Determine the direction to face and move\n    if abs(dx) > abs(dy):  # Prioritize horizontal movement\n      direction = craft.RIGHT if dx > 0 else craft.LEFT\n    else:  # Prioritize vertical movement\n      direction = craft.DOWN if dy > 0 else craft.UP\n\n    while current_direction != direction:\n      actions_to_take.append(craft.TURN_RIGHT)\n      current_direction = (current_direction + 1) % 4\n\n    for _ in range(abs(dx)):\n      actions_to_take.append(direction)\n\n    # Adjust the remaining movement\n    if abs(dy) > 0:  # Now move vertically\n      direction = craft.DOWN if dy > 0 else craft.UP\n      while current_direction != direction:\n        actions_to_take.append(craft.TURN_RIGHT)\n        current_direction = (current_direction + 1) % 4\n\n      for _ in range(abs(dy)):\n        actions_to_take.append(direction)\n\n    return actions_to_take, current_direction\n\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = env._current_state.inventory.copy()\n\n  # Check if all ingredients are available\n  required_ingredients = {cookbook.index[k]: v for k, v in recipe.items()}\n\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if not can_craft:\n    return []\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No available workshop to craft item\")\n\n  # Select the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n  # Calculate actions to move the agent to the nearest workshop\n  actions_to_take, _ = get_actions_for_movement(\n      current_position, nearest_workshop_pos, env._current_state.dir\n  )\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T16:07:08.041067", "function_name": "craft", "function_body": "  def move_towards_position(current_pos, target_pos):\n      actions = []\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      # Prioritize moving vertically if needed\n      if dy != 0:\n          direction = craft.MOVE_DOWN if dy > 0 else craft.MOVE_UP\n          actions.extend([direction for _ in range(abs(dy))])\n\n      # Then move horizontally\n      if dx != 0:\n          direction = craft.MOVE_RIGHT if dx > 0 else craft.MOVE_LEFT\n          actions.extend([direction for _ in range(abs(dx))])\n          \n      return actions\n\n  def rotate_towards_direction(current_dir, target_direction):\n      actions = []\n      while current_dir != target_direction:\n          # Determine the shortest way to turn\n          clockwise_diff = (target_direction - current_dir) % 4\n          counterclockwise_diff = (current_dir - target_direction) % 4\n\n          if clockwise_diff <= counterclockwise_diff:\n              actions.append(craft.TURN_RIGHT)\n              current_dir = (current_dir + 1) % 4\n          else:\n              actions.append(craft.TURN_LEFT)\n              current_dir = (current_dir - 1) % 4\n      \n      return actions\n\n  def get_target_direction(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      # Determine the primary direction based on larger difference\n      if abs(dx) > abs(dy):\n          return craft.RIGHT if dx > 0 else craft.LEFT\n      elif abs(dy) > abs(dx):\n          return craft.DOWN if dy > 0 else craft.UP\n\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = env._current_state.inventory.copy()\n\n  # Check if all ingredients are available\n  required_ingredients = {cookbook.index[k]: v for k, v in recipe.items()}\n\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if not can_craft:\n    return []\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No available workshop to craft item\")\n\n  # Select the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n  # Calculate actions to move the agent to the nearest workshop\n  current_direction = env._current_state.dir\n\n  target_direction = get_target_direction(current_position, nearest_workshop_pos)\n\n  actions_to_take = []\n\n  if current_position != nearest_workshop_pos:\n    actions_to_take.extend(move_towards_position(current_position, nearest_workshop_pos))\n\n    # Calculate the target direction to face the workshop\n    actions_to_take.extend(rotate_towards_direction(current_direction, target_direction))\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T16:07:09.072384", "function_name": "craft", "function_body": "  def move_to_position(current_pos, target_pos):\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    actions = []\n    \n    if dy < 0:  # Move up\n        actions.extend([craft.MOVE_UP for _ in range(-dy)])\n    elif dy > 0:  # Move down\n        actions.extend([craft.MOVE_DOWN for _ in range(dy)])\n\n    if dx < 0:  # Move left\n        actions.extend([craft.MOVE_LEFT for _ in range(-dx)])\n    elif dx > 0:  # Move right\n        actions.extend([craft.MOVE_RIGHT for _ in range(dx)])\n    \n    return actions\n\n  def rotate_to_direction(current_dir, target_dir):\n      actions = []\n      while current_dir != target_dir:\n          if (target_dir - current_dir) % 4 == 1:\n              actions.append(craft.TURN_RIGHT)\n              current_dir = (current_dir + 1) % 4\n          elif (target_dir - current_dir) % 4 == 3:\n              actions.append(craft.TURN_LEFT)\n              current_dir = (current_dir - 1) % 4\n      return actions\n\n  def get_target_direction(current_pos, target_pos):\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    if abs(dx) > abs(dy):\n        return craft.RIGHT if dx > 0 else craft.LEFT\n    elif abs(dy) > abs(dx):\n        return craft.DOWN if dy > 0 else craft.UP\n\n  def collect_primitives(env, primitive_name, required_count):\n      actions = []\n      cookbook = env.world.cookbook\n      primitive_index = cookbook.index[primitive_name]\n      \n      available_inventory = env._current_state.inventory.copy()\n\n      # Check if the primitive is available in inventory\n      if primitive_index in available_inventory and available_inventory[primitive_index] >= required_count:\n          return actions\n\n      # Find all positions of the required primitive in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] > 0)\n\n      if len(primitive_positions) == 0:\n          raise ValueError(f\"No available {primitive_name} to collect\")\n\n      current_position = np.array(env._current_state.pos)\n      current_direction = env._current_state.dir\n\n      for pos in primitive_positions:\n          target_pos = tuple(pos)\n          \n          # Calculate actions to move the agent to the nearest primitive\n          actions.extend(move_to_position(current_position, target_pos))\n\n          # Calculate the target direction to face the primitive\n          target_direction = get_target_direction(current_position, target_pos)\n\n          actions.extend(rotate_to_direction(current_direction, target_direction))\n\n          # Add the COLLECT action to collect the primitive\n          actions.append(craft.COLLECT)\n          current_position = np.array(target_pos)\n          current_direction = target_direction\n\n          # Update available inventory and required count\n          if primitive_index in available_inventory:\n              available_inventory[primitive_index] += 1\n          else:\n              available_inventory[primitive_index] = 1\n\n          if available_inventory[primitive_index] >= required_count:\n              break\n      \n      return actions\n  \n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = env._current_state.inventory.copy()\n\n  # Check if all ingredients are available\n  required_ingredients = {cookbook.index[k]: v for k, v in recipe.items()}\n\n  actions_to_take = []\n\n  for ingredient_index, required_count in required_ingredients.items():\n    ingredient_name = cookbook.index.reverse_contents[ingredient_index]\n    \n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n        actions_to_take.extend(collect_primitives(env, ingredient_name, required_count))\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No available workshop to craft item\")\n\n  # Select the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n  # Calculate actions to move the agent to the nearest workshop\n  current_direction = env._current_state.dir\n\n  target_direction = get_target_direction(current_position, nearest_workshop_pos)\n\n  if current_position != nearest_workshop_pos:\n    actions_to_take.extend(move_to_position(current_position, nearest_workshop_pos))\n\n    # Calculate the target direction to face the workshop\n    actions_to_take.extend(rotate_to_direction(current_direction, target_direction))\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-10T16:10:43.291844", "function_name": "craft", "function_body": "  def _move_to_position(target_pos):\n    start = env._current_state.pos\n\n    def heuristic(a, b):\n        return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n    open_set = collections.PriorityQueue()\n    open_set.put((0, start))\n    came_from = {}\n    g_score = {start: 0}\n\n    while not open_set.empty():\n        _, current = open_set.get()\n\n        if current == target_pos:\n            path = []\n            while current in came_from:\n                path.append(current)\n                current = came_from[current]\n            path.reverse()\n            actions = _convert_path_to_actions(path, start)\n            return actions\n\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            neighbor = (current[0] + dx, current[1] + dy)\n            if 0 <= neighbor[0] < env.world.WIDTH and 0 <= neighbor[1] < env.world.HEIGHT:\n                tentative_g_score = g_score[current] + 1\n                if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                    came_from[neighbor] = current\n                    g_score[neighbor] = tentative_g_score\n                    f_score = tentative_g_score + heuristic(neighbor, target_pos)\n                    open_set.put((f_score, neighbor))\n\n    return []\n\n  def _convert_path_to_actions(path, start):\n      actions = []\n      cx, cy = start\n      \n      for x, y in path:\n          if cx < x:\n              actions.append(craft.RIGHT)\n          elif cx > x:\n              actions.append(craft.LEFT)\n          if cy < y:\n              actions.append(craft.DOWN)\n          elif cy > y:\n              actions.append(craft.UP)\n          cx, cy = x, y\n      \n      return actions\n  \n  def _has_required_primitives(primitive_indices):\n      for i in primitive_indices:\n          if env._current_state.inventory[i] <= 0:\n              return False\n      return True\n\n  index = env.world.cookbook.index\n  item_index = index[item]\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n\n  actions = []\n\n  # Check if the recipe exists and has a key\n  if \"_key\" in recipe:\n      key_index = recipe[\"_key\"]\n      workshop_index = env.world.workshop_indices[key_index]\n\n      required_primitives = [i for i in recipe if i != \"_key\"]\n\n      # Collect all required primitives\n      for primitive_index in required_primitives:\n          if not _has_required_primitives([primitive_index]):\n              target_pos = None\n              for x in range(env.world.WIDTH):\n                  for y in range(env.world.HEIGHT):\n                      if np.any(env._current_state.grid[x, y] == primitive_index):\n                          target_pos = (x, y)\n                          break\n                  if target_pos:\n                      break\n              \n              if not target_pos:\n                  return []  # Primitive not found\n      \n              actions.extend(_move_to_position(target_pos) + [craft.USE])\n      \n      # Ensure we have collected enough of all required primitives\n      if not _has_required_primitives(required_primitives):\n          return []\n\n      # Find all positions of the required workshop\n      workshop_positions = []\n      for x in range(env.world.WIDTH):\n          for y in range(env.world.HEIGHT):\n              if np.any(env._current_state.grid[x, y] == workshop_index):\n                  workshop_positions.append((x, y))\n      \n      if not workshop_positions:\n          return []  # No workshops found\n      \n      # Move to the nearest workshop\n      closest_workshop = min(workshop_positions, key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1]))\n      \n      actions_to_workshop = _move_to_position(closest_workshop)\n      \n      # Ensure the agent is facing the correct direction to use the workshop\n      target_pos = None\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          neighbor_pos = (closest_workshop[0] + dx, closest_workshop[1] + dy)\n          if 0 <= neighbor_pos[0] < env.world.WIDTH and 0 <= neighbor_pos[1] < env.world.HEIGHT:\n              if np.any(env._current_state.grid[neighbor_pos[0], neighbor_pos[1]] == workshop_index):\n                  target_pos = neighbor_pos\n                  break\n      \n      if not target_pos:\n          return []  # No valid target position found\n      \n      direction_to_target = (target_pos[0] - env._current_state.pos[0], target_pos[1] - env._current_state.pos[1])\n      \n      if direction_to_target == (-1, 0):\n          actions_to_workshop.append(craft.LEFT)\n      elif direction_to_target == (1, 0):\n          actions_to_workshop.append(craft.RIGHT)\n      elif direction_to_target == (0, -1):\n          actions_to_workshop.append(craft.UP)\n      elif direction_to_target == (0, 1):\n          actions_to_workshop.append(craft.DOWN)\n      \n      # Finally, add the USE action\n      actions_to_workshop.append(craft.USE)\n      \n      return actions_to_workshop\n  \n  else:\n      return []  # No recipe found for the item", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T16:10:44.393802", "function_name": "craft", "function_body": "  def _move_to_position(target_pos):\n    start = env._current_state.pos\n    goal = target_pos\n\n    def heuristic(a, b):\n        return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n    open_set = collections.PriorityQueue()\n    open_set.put((0, start))\n    came_from = {}\n    g_score = {start: 0}\n\n    while not open_set.empty():\n        _, current = open_set.get()\n\n        if current == goal:\n            path = []\n            while current in came_from:\n                path.append(current)\n                current = came_from[current]\n            path.reverse()\n            actions = _convert_path_to_actions(path, start)\n            return actions\n\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            neighbor = (current[0] + dx, current[1] + dy)\n            if 0 <= neighbor[0] < env.world.WIDTH and 0 <= neighbor[1] < env.world.HEIGHT:\n                tentative_g_score = g_score[current] + 1\n                if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                    came_from[neighbor] = current\n                    g_score[neighbor] = tentative_g_score\n                    f_score = tentative_g_score + heuristic(neighbor, goal)\n                    open_set.put((f_score, neighbor))\n\n    return []\n\n  def _convert_path_to_actions(path, start):\n      actions = []\n      cx, cy = start\n      \n      for x, y in path:\n          if cx < x:\n              actions.append(craft.RIGHT)\n          elif cx > x:\n              actions.append(craft.LEFT)\n          if cy < y:\n              actions.append(craft.DOWN)\n          elif cy > y:\n              actions.append(craft.UP)\n          cx, cy = x, y\n      \n      return actions\n\n  def _has_required_primitives(primitive_indices):\n      for i in primitive_indices:\n          if env._current_state.inventory[i] <= 0:\n              return False\n      return True\n\n  index = env.world.cookbook.index\n  item_index = index[item]\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n\n  actions = []\n\n  # Check if the recipe exists and has a key\n  if \"_key\" in recipe:\n      key_index = recipe[\"_key\"]\n      workshop_index = env.world.workshop_indices[key_index]\n\n      required_primitives = [i for i in recipe if i != \"_key\"]\n\n      # Collect all required primitives\n      for primitive_index in required_primitives:\n          if not _has_required_primitives([primitive_index]):\n              target_pos = None\n              for x in range(env.world.WIDTH):\n                  for y in range(env.world.HEIGHT):\n                      if np.any(env._current_state.grid[x, y] == primitive_index):\n                          target_pos = (x, y)\n                          break\n                  if target_pos:\n                      break\n              \n              if not target_pos:\n                  return []  # Primitive not found\n      \n              actions.extend(_move_to_position(target_pos) + [craft.USE])\n      \n      # Ensure we have collected enough of all required primitives\n      if not _has_required_primitives(required_primitives):\n          return []\n\n      # Find all positions of the required workshop\n      workshop_positions = []\n      for x in range(env.world.WIDTH):\n          for y in range(env.world.HEIGHT):\n              if np.any(env._current_state.grid[x, y] == workshop_index):\n                  workshop_positions.append((x, y))\n      \n      if not workshop_positions:\n          return []  # No workshops found\n      \n      # Move to the nearest workshop\n      closest_workshop = min(workshop_positions, key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1]))\n      \n      actions_to_workshop = _move_to_position(closest_workshop)\n      \n      # Ensure the agent is facing the correct direction to use the workshop\n      target_pos = None