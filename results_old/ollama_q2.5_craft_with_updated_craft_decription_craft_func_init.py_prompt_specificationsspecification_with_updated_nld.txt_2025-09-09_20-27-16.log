arget, start_pos, target_workshop)\n\n    if target_pos is None:\n      return []  # No path to the target workshop\n\n    path_to_workshop = a_star_search(env._current_state.grid, start_pos, target_pos)\n\n    for pos in path_to_workshop[:-1]:  # Exclude the last position as we'll be facing it when we reach\n        actions.extend(move_to_target(env._current_state.grid, env._current_state.pos, pos))\n\n    final_pos = path_to_workshop[-1]\n    actions.append(rotate_to_face(env._current_state, final_pos, target_workshop))\n    actions.append(4)  # Use action\n\n    return actions\n  \n  item_index = env.world.cookbook.index[item]\n\n  return plan_crafting(item_index)", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-11T01:04:40.196034", "function_name": "craft", "function_body": "  # Get the index for the desired item\n  item_index = env.world.cookbook.index.index(item)\n\n  # Check if the item has a recipe\n  if item_index not in env.world.cookbook.recipes:\n    return []  # No recipe found, cannot craft the item\n\n  # Get the primitives required to craft the item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  actions = []\n  \n  # Check if we have all required ingredients in inventory\n  for ingredient, count in recipe.items():\n    if ingredient == \"_at\":\n      continue  # Skip workshop location\n\n    ingredient_index = env.world.cookbook.index.index(ingredient)\n\n    # If the agent does not have enough of this ingredient, collect it\n    if env._current_state.inventory[ingredient_index] < count:\n      actions.extend(collect_v2(env, ingredient))\n\n  # Once all ingredients are collected, go to the workshop and craft the item\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index.index(workshop_name)\n  \n  # Find the position of the workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    return []  # Workshop not found on the map\n\n  # Move to the nearest workshop\n  agent_pos = env._current_state.pos\n  distances = np.linalg.norm(agent_pos - workshop_positions, axis=1)\n  nearest_workshop_pos = workshop_positions[np.argmin(distances)]\n\n  actions.extend(move_to(env, nearest_workshop_pos))\n  \n  # Face the workshop before using it\n  actions.append(turn_towards(env, nearest_workshop_pos))\n\n  # Use the workshop to craft the item\n  actions.append(craft.world.CraftState.USE)\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-11T01:04:41.220248", "function_name": "craft", "function_body": "  # Retrieve the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the recipe for the desired item\n  if item_index not in env.world.cookbook.recipes:\n    print(f\"No recipe found for {item}.\")\n    return []\n\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # List to hold actions to be taken\n  actions = []\n  \n  # Check and collect all required primitives/items\n  required_primitives = {}\n  for ingredient, count in recipe.items():\n      if ingredient != \"_key\":  # Skip the workshop key\n          primitive_name = env.world.cookbook.index.get(ingredient)\n          if not primitive_name:\n              print(f\"Unknown ingredient: {ingredient}.\")\n              return []\n\n          # Find out how many of each primitive are needed\n          required_primitives[primitive_name] = count\n\n  for primitive, count in required_primitives.items():\n      collected = env._current_state.inventory[env.world.cookbook.index[primitive]]\n      if collected < count:\n          # Collect the missing primitives\n          collect_actions = collect_v2(env, primitive)\n          actions.extend(collect_actions)\n\n  # Move to the workshop and craft the item\n  workshop_key = recipe[\"_key\"]\n  workshop_index = env.world.cookbook.index[workshop_key]\n  if workshop_index not in env.world.workshop_indices:\n      print(f\"Unknown workshop: {workshop_key}.\")\n      return []\n\n  # Find the nearest workshop of the required type\n  nearest_workshop_pos = find_nearest_workshop(env, workshop_index)\n  if nearest_workshop_pos is None:\n      print(\"No available workshops found.\")\n      return []\n\n  move_actions = move_to_position(env, nearest_workshop_pos)\n  actions.extend(move_actions)\n\n  # Turn to face the workshop and perform the USE action\n  face_action = turn_to_face(env, nearest_workshop_pos)\n  actions.append(face_action)\n  use_action = craft.world.N_ACTIONS - 1  # Assuming USE is the last action\n  actions.append(use_action)\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-11T01:05:26.852436", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index of the item to be crafted\n  item_idx = env.world.cookbook.index[item]\n  \n  # Check if we have all the required primitives in our inventory\n  primitive_counts = env.world.cookbook.primitives_for(item_idx)\n  current_inventory = env._current_state.inventory\n  \n  # Calculate the missing items based on what is needed and what is currently available\n  missing_items = {}\n  for i, count in primitive_counts.items():\n      if current_inventory[i] < count:\n          missing_items[i] = count - current_inventory[i]\n  \n  # If there are any missing items we cannot craft the item\n  if missing_items:\n      return actions\n  \n  # Otherwise, proceed to craft the item\n  workshop_idx = None\n  for output_index, recipe in env.world.cookbook.recipes.items():\n    if '_key' not in recipe or recipe['_key'] != item_idx:\n        continue\n    for ingredient_key, _ in recipe.items():\n      if ingredient_key == \"_at\":\n          workshop_name = recipe[ingredient_key]\n          workshop_idx = getattr(env.world, f\"{workshop_name}_index\")\n  \n  # If no workshop is found to craft the item we cannot proceed further\n  if workshop_idx is None:\n      return actions\n  \n  # Move to a position adjacent to the workshop (since USE can only be used when facing the block)\n  pos = env._current_state.pos\n  dir = env._current_state.dir\n\n  directions = {\n      \"UP\": (-1, 0),\n      \"DOWN\": (1, 0),\n      \"LEFT\": (0, -1),\n      \"RIGHT\": (0, 1)\n  }\n  \n  # Find the adjacent position to the workshop\n  for d_name, d_vec in directions.items():\n      adj_pos = (pos[0] + d_vec[0], pos[1] + d_vec[1])\n      if env._current_state.grid[adj_pos][workshop_idx] == 1:\n          target_dir = list(directions.keys())[list(directions.values()).index(d_vec)]\n          actions.append(env.world.index[target_dir]) # Move in the direction to face the workshop\n          actions.append(4) # USE action to craft the item\n          break\n\n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T01:05:27.832437", "function_name": "craft", "function_body": "  def get_actions_to_collect_primitive(primitive_index):\n    actions = []\n    # Logic to find the nearest primitive and collect it.\n    # This is a simplified placeholder logic.\n    # In practice, we would use pathfinding to reach the primitive.\n    for y in range(env.world.cookbook.index._len() - 1):  # assuming index starts at 1\n      for x in range(env.world.cookbook.index._len() - 1):\n        if env._current_state.grid[x, y, primitive_index] > 0:\n          actions.append(MOVE_FUNC(\"DOWN\") * (y - env._current_state.pos[1]))\n          actions.append(MOVE_FUNC(\"RIGHT\") * (x - env._current_state.pos[0]))\n          actions.append(COLLECT_FUNC(env.world.cookbook.index.get(primitive_index)))\n          break\n    return actions\n\n  actions = []\n\n  # Get the required primitives for crafting the item.\n  primitive_requirements = env.world.cookbook.primitives_for(\n      env.world.cookbook.index.index(item))\n\n  # Collect all required primitives.\n  for primitive, count in primitive_requirements.items():\n    while env._current_state.inventory[primitive] < count:\n      actions.extend(get_actions_to_collect_primitive(primitive))\n      \n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-11T01:06:09.210541", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the item has a recipe in the cookbook\n  if item_index not in env.world.cookbook.recipes:\n    return actions\n\n  # Get the required primitives for crafting the item\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  \n  # Collect required primitives\n  for primitive, count in required_primitives.items():\n    primitive_name = env.world.cookbook.index.get(primitive)\n    \n    # Check if we already have enough of this primitive in our inventory\n    while env._current_state.inventory[primitive] < count:\n      collect_actions = collect_v1(env, primitive_name)\n      actions.extend(collect_actions)\n\n  # Find the workshop index for crafting the item\n  workshop_index = None\n  recipe = env.world.cookbook.recipes[item_index]\n  if '_at' in recipe:\n    workshop_name = recipe['_at']\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n  if workshop_index is None:\n    return actions\n\n  # Move to the workshop\n  move_actions = move_to_workshop_v1(env, workshop_index)\n  actions.extend(move_actions)\n\n  # Craft the item at the workshop\n  actions.append(4)  # USE action\n\n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-11T01:06:10.171534", "function_name": "craft", "function_body": "  # Get the index for the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the item has a recipe in the cookbook\n  if item_index not in env.world.cookbook.recipes:\n    return []  # No recipe available, cannot craft this item\n\n  # Get the list of required primitives for crafting\n  recipe = env.world.cookbook.recipes[item_index]\n  required_primitives = {env.world.cookbook.index[ingredient]: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n\n  # Check if we have all required primitives in our inventory\n  available_inventory = env._current_state.inventory\n  missing_primitives = []\n  actions_to_take = []\n\n  for primitive_index, required_count in required_primitives.items():\n    current_count = available_inventory[primitive_index]\n    if current_count < required_count:\n      # We need to collect more of this primitive\n      missing_primitives.append((primitive_index, required_count - current_count))\n      \n      # Get the name of the primitive\n      primitive_name = env.world.cookbook.index.get(primitive_index)\n      actions_to_take.extend(collect(env, primitive_name))\n\n  if not missing_primitives:\n    # We have all the primitives, proceed to craft the item\n    workshop_name = recipe[\"_at\"]\n    workshop_indices = [i for i, name in enumerate(env.world.workshop_indices) if env.world.cookbook.index.get(name) == workshop_name]\n    \n    if not workshop_indices:\n      return []  # Workshop not found\n    \n    workshop_index = workshop_indices[0]\n    \n    # Move to the workshop\n    actions_to_take.extend(move_to_workshop(env, workshop_index))\n    \n    # Craft the item by using the USE action\n    actions_to_take.append(craft.env_action_map['USE'])\n  \n  return actions_to_take", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-11T01:06:52.324221", "function_name": "craft", "function_body": "  # Get the index for the target item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the recipe exists\n  if item_index not in env.world.cookbook.recipes:\n    print(f\"No recipe found for {item}.\")\n    return []\n  \n  # Retrieve the recipe\n  recipe = env.world.cookbook.recipes[item_index]\n  \n  # Check for dependencies (primitives or other items)\n  dependencies = {}\n  for ingredient, count in recipe.items():\n      if ingredient == \"_key\":\n          continue  # Skip the workshop key\n      dependencies[ingredient] = count\n  \n  # Check if we have all dependencies\n  missing_dependencies = {item: count for item, count in dependencies.items() \n                          if env._current_state.inventory[item] < count}\n  \n  if missing_dependencies:\n    print(f\"Missing dependencies: {missing_dependencies}.\")\n    return []\n  \n  # Determine the workshop to use\n  workshop_index = recipe[\"_key\"]\n  \n  # Find the nearest workshop of the required type\n  closest_workshop_pos = find_nearest_workshop(env, workshop_index)\n  \n  if closest_workshop_pos is None:\n    print(f\"No workshop found for index {workshop_index}.\")\n    return []\n  \n  actions_to_take = []\n  \n  # Move to the nearest workshop\n  move_actions = move_to_position(env, env._current_state.pos, closest_workshop_pos)\n  if not move_actions:\n    print(\"Could not find a path to the workshop.\")\n    return []\n  \n  actions_to_take.extend(move_actions)\n  \n  # Turn towards the workshop (assuming facing direction is correct for USE action)\n  turn_action = face_direction(env._current_state.pos, closest_workshop_pos)\n  if turn_action:\n    actions_to_take.append(turn_action)\n  \n  # Perform the USE action to craft the item\n  actions_to_take.append(4)  # USE action\n  \n  return actions_to_take", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-11T01:06:53.337738", "function_name": "craft", "function_body": "  actions = []\n\n  # Get the index of the item to craft\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we already have the item in our inventory\n  if env._current_state.inventory[item_index] > 0:\n    return actions\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n  \n  # If no recipe found, return empty action list\n  if not recipe:\n    return actions\n  \n  workshop_index = None\n  \n  # Check if all required primitives are available in the inventory or environment\n  for ingredient, count in recipe.items():\n    if ingredient == \"_at\":\n      workshop_index = env.world.cookbook.index[count]\n    elif ingredient.startswith(\"_\"):\n      continue\n    else:\n      ingredient_index = env.world.cookbook.index[ingredient]\n      if env._current_state.inventory[ingredient_index] < count:\n        # Collect the missing primitives\n        actions.extend(collect_v2(env, ingredient))\n  \n  # If no workshop specified or all ingredients are available in inventory, return empty action list\n  if workshop_index is None:\n    return actions\n  \n  # Move to the workshop and perform the USE action\n  actions.extend(move_to_workshop(env, workshop_index))\n  actions.append(env.world.N_ACTIONS)  # Assuming USE action index is N_ACTIONS\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-11T01:07:30.523524", "function_name": "craft", "function_body": "  # Extract the index of the goal item\n  goal_index = env.world.cookbook.index[item]\n  \n  # Get the recipe for the desired item (if it exists)\n  if goal_index not in env.world.cookbook.recipes:\n    print(f\"No recipe found for {item}.\")\n    return []\n\n  # Extract the required ingredients and workshop from the recipe\n  recipe = env.world.cookbook.recipes[goal_index]\n  \n  actions = []\n  \n  # Check each ingredient requirement\n  for ingredient, count in recipe.items():\n      if ingredient == \"_at\": \n          continue\n      \n      # Get the index of the ingredient\n      ingredient_index = env.world.cookbook.index[ingredient]\n\n      while env._current_state.inventory[ingredient_index] < count:\n          # Actions to collect the required ingredient\n          actions.extend(collect_v2(env, ingredient))\n          \n      # Deduct the collected ingredients from the recipe requirement\n      env._current_state.inventory[ingredient_index] -= count\n  \n  # Determine which workshop to use\n  workshop_name = recipe[\"_at\"]\n  workshop_indices = [i for i in env.world.workshop_indices if env.world.cookbook.index.get(env.world.cookbook.get(i, \"_key\")) == workshop_name]\n  \n  if not workshop_indices:\n      print(f\"No suitable workshop found for crafting {item}.\")\n      return []\n  \n  # Move to and use the workshop\n  actions.extend(move_to_workshop_v2(env, workshop_indices[0]))\n  actions.append(4)  # USE action to craft\n  \n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-11T01:07:31.492954", "function_name": "craft", "function_body": "  # Initialize actions list\n  actions = []\n\n  # Get the index of the goal item from the cookbook index\n  goal_index = env.world.cookbook.index[item]\n\n  # Check if we have all the items/primitives required for crafting\n  primitives_needed = env.world.cookbook.primitives_for(goal_index)\n\n  if not primitives_needed:\n    print(f\"No recipe found for {item}.\")\n    return actions\n\n  # Collect required primitives\n  for primitive, count in primitives_needed.items():\n      primitive_name = env.world.cookbook.index.get(primitive)\n      collect_actions = collect_v2(env, primitive_name, count)\n      actions.extend(collect_actions)\n\n  # Determine the workshop where crafting occurs\n  recipe = env.world.cookbook.recipes[goal_index]\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find and navigate to the workshop\n  workshop_pos = find_workshop(env, workshop_index)\n  \n  if not workshop_pos:\n    print(f\"Workshop {workshop_name} not found.\")\n    return actions\n\n  move_actions = navigate_to_workshop(env, workshop_pos)\n  actions.extend(move_actions)\n\n  # Use the USE action to craft the item\n  use_action = env.world.cookbook.index[\"USE\"]\n  actions.append(use_action)\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-11T01:12:15.735600", "function_name": "craft", "function_body": "  def navigate_to_position_bfs(grid, start, target):\n    width, height = grid.shape[:2]\n    \n    queue = collections.deque([start])\n    visited = set()\n    parent = {tuple(start): None}\n\n    while queue:\n        current_pos = queue.popleft()\n\n        if tuple(current_pos) == tuple(target):\n            # Reconstruct path from start to target\n            path = []\n            while current_pos is not None:\n                path.append(tuple(current_pos))\n                current_pos = parent[tuple(current_pos)]\n            return path[::-1]\n\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n            if 0 <= new_x < width and 0 <= new_y < height and (new_x, new_y) not in visited:\n                queue.append((new_x, new_y))\n                visited.add((new_x, new_y))\n                parent[(new_x, new_y)] = current_pos\n\n    return None\n\n  def navigate_to_item_bfs(grid, start, target_indices):\n      width, height = grid.shape[:2]\n      \n      queue = collections.deque([start])\n      visited = set()\n      parent = {tuple(start): None}\n\n      while queue:\n          current_pos = queue.popleft()\n\n          if any(grid[current_pos[0], current_pos[1], i] > 0 for i in target_indices):\n              # Reconstruct path from start to target\n              path = []\n              while current_pos is not None:\n                  path.append(tuple(current_pos))\n                  current_pos = parent[tuple(current_pos)]\n              return path[::-1]\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n              if 0 <= new_x < width and 0 <= new_y < height and (new_x, new_y) not in visited:\n                  queue.append((new_x, new_y))\n                  visited.add((new_x, new_y))\n                  parent[(new_x, new_y)] = current_pos\n\n      return None\n\n  def navigate_to_position(env, target_pos):\n      path = navigate_to_position_bfs(env._current_state.grid, env._current_state.pos, tuple(target_pos))\n      \n      if path is None:\n          print(\"No valid path found to the position.\")\n          return []\n\n      actions = []\n      for next_pos in path[1:]:\n          # Calculate direction to move towards next_pos\n          dx = next_pos[0] - env._current_state.pos[0]\n          dy = next_pos[1] - env._current_state.pos[1]\n\n          if dx == 1:\n              actions.append(env.world.N_ACTIONS - 3)  # RIGHT action\n          elif dx == -1:\n              actions.append(env.world.N_ACTIONS - 4)  # LEFT action\n          elif dy == 1:\n              actions.append(env.world.N_ACTIONS - 2)  # DOWN action\n          elif dy == -1:\n              actions.append(env.world.N_ACTIONS - 5)  # UP action\n\n      return actions\n\n  def navigate_to_item(env, target_indices):\n      path = navigate_to_item_bfs(env._current_state.grid, env._current_state.pos, target_indices)\n      \n      if path is None:\n          print(\"No valid path found to the item.\")\n          return []\n\n      actions = []\n      for next_pos in path[1:]:\n          # Calculate direction to move towards next_pos\n          dx = next_pos[0] - env._current_state.pos[0]\n          dy = next_pos[1] - env._current_state.pos[1]\n\n          if dx == 1:\n              actions.append(env.world.N_ACTIONS - 3)  # RIGHT action\n          elif dx == -1:\n              actions.append(env.world.N_ACTIONS - 4)  # LEFT action\n          elif dy == 1:\n              actions.append(env.world.N_ACTIONS - 2)  # DOWN action\n          elif dy == -1:\n              actions.append(env.world.N_ACTIONS - 5)  # UP action\n\n      return actions\n\n  def collect_primitive(env, primitive_name):\n      \"\"\"Helper function to collect a primitive.\"\"\"\n      primitive_index = env.world.cookbook.index[primitive_name]\n      \n      if primitive_index not in env.world.grabbable_indices:\n          raise ValueError(f\"{primitive_name} is not a grabbable item.\")\n      \n      # Check if already have the required amount of the primitive\n      if env._current_state.inventory[primitive_index] >= recipe.get(primitive_name, 0):\n          return []\n      \n      actions = []\n\n      while env._current_state.inventory[primitive_index] < recipe.get(primitive_name, 0):\n          positions = find_item_positions(env._current_state.grid, [primitive_index])\n          \n          if not positions:\n              raise ValueError(f\"No available {primitive_name} to collect.\")\n          \n          for pos in positions:\n              actions.extend(navigate_to_position(env, pos))\n              \n              # Check if the agent is next to an item\n              if env._current_state.next_to(primitive_index):\n                  actions.append(env.world.N_ACTIONS - 1)  # USE action\n              \n              if env._current_state.inventory[primitive_index] >= recipe.get(primitive_name, 0):\n                  break\n\n      return actions\n\n  def find_item_positions(grid, target_indices):\n      \"\"\"Find all positions of specific items in the grid.\"\"\"\n      positions = []\n      for idx in target_indices:\n          pos_list = np.argwhere(grid[:, :, idx] > 0).tolist()\n          positions.extend(pos_list)\n      return positions\n\n  def find_workshop_position(env, workshop_name):\n      \"\"\"Find the position of a specific workshop in the grid.\"\"\"\n      workshop_index = env.world.cookbook.index[workshop_name]\n      \n      pos_list = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n      if len(pos_list) == 0:\n          raise ValueError(f\"No available {workshop_name} to navigate to.\")\n      return pos_list[0].tolist()\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the goal item is a primitive or not in the recipes\n  if item_index in env.world.grabbable_indices:\n      return []  # Primitives cannot be crafted\n  \n  # Retrieve the recipe for the desired item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Determine the workshop required for crafting\n  workshop_key = \"_at\"\n  workshop_name = next((k.split('_')[1] for k in recipe if k.startswith(workshop_key)), None)\n  if not workshop_name:\n      raise ValueError(f\"No workshop specified for crafting {item}.\")\n  \n  workshop_index = env.world.cookbook.index[f\"workshop{workshop_name}\"]\n  workshop_pos = find_workshop_position(env, f\"workshop{workshop_name}\")\n\n  actions = []\n\n  # Collect all required primitives or intermediate items\n  for req_item_name, count in recipe.items():\n      if isinstance(req_item_name, str) and not req_item_name.startswith('_'):\n          actions.extend(collect_primitive(env, req_item_name))\n      \n  # Navigate to the workshop and use it to craft the item\n  if env._current_state.next_to(workshop_index):\n      actions.append(env.world.N_ACTIONS - 1)  # USE action\n  else:\n      actions.extend(navigate_to_position(env, workshop_pos))\n      actions.append(env.world.N_ACTIONS - 1)  # USE action\n\n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T01:12:16.810318", "function_name": "craft", "function_body": "  def navigate_to_position_bfs(grid, start, target):\n    width, height = grid.shape[:2]\n    \n    queue = collections.deque([start])\n    visited = set()\n    parent = {start: None}\n\n    while queue:\n        current_pos = queue.popleft()\n\n        if tuple(current_pos) == target:\n            # Reconstruct path from start to target\n            path = []\n            while current_pos is not None:\n                path.append(current_pos)\n                current_pos = parent[current_pos]\n            return path[::-1]\n\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n            if 0 <= new_x < width and 0 <= new_y < height and (new_x, new_y) not in visited:\n                queue.append((new_x, new_y))\n                visited.add((new_x, new_y))\n                parent[(new_x, new_y)] = current_pos\n\n    return None\n\n  def navigate_to_item_bfs(grid, start, target_indices):\n      width, height = grid.shape[:2]\n      \n      queue = collections.deque([start])\n      visited = set()\n      parent = {start: None}\n\n      while queue:\n          current_pos = queue.popleft()\n\n          if any(grid[current_pos[0], current_pos[1], i] > 0 for i in target_indices):\n              # Reconstruct path from start to target\n              path = []\n              while current_pos is not None:\n                  path.append(current_pos)\n                  current_pos = parent[current_pos]\n              return path[::-1]\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n              if 0 <= new_x < width and 0 <= new_y < height and (new_x, new_y) not in visited:\n                  queue.append((new_x, new_y))\n                  visited.add((new_x, new_y))\n                  parent[(new_x, new_y)] = current_pos\n\n      return None\n\n  def navigate_to_position(env, target_pos):\n    path = navigate_to_position_bfs(env._current_state.grid, env._current_state.pos, tuple(target_pos))\n    \n    if path is None:\n        print(\"No valid path found to the position.\")\n        return []\n\n    actions = []\n    for next_pos in path[1:]:\n        # Calculate direction to move towards next_pos\n        dx = next_pos[0] - env._current_state.pos[0]\n        dy = next_pos[1] - env._current_state.pos[1]\n\n        if dx == 1:\n            actions.append(env.world.N_ACTIONS - 3)  # RIGHT action\n        elif dx == -1:\n            actions.append(env.world.N_ACTIONS - 4)  # LEFT action\n        elif dy == 1:\n            actions.append(env.world.N_ACTIONS - 2)  # DOWN action\n        elif dy == -1:\n            actions.append(env.world.N_ACTIONS - 5)  # UP action\n\n    return actions\n\n  def navigate_to_item(env, target_indices):\n    path = navigate_to_item_bfs(env._current_state.grid, env._current_state.pos, target_indices)\n    \n    if path is None:\n        print(\"No valid path found to the item.\")\n        return []\n\n    actions = []\n    for next_pos in path[1:]:\n        # Calculate direction to move towards next_pos\n        dx = next_pos[0] - env._current_state.pos[0]\n        dy = next_pos[1] - env._current_state.pos[1]\n\n        if dx == 1:\n            actions.append(env.world.N_ACTIONS - 3)  # RIGHT action\n        elif dx == -1:\n            actions.append(env.world.N_ACTIONS - 4)  # LEFT action\n        elif dy == 1:\n            actions.append(env.world.N_ACTIONS - 2)  # DOWN action\n        elif dy == -1:\n            actions.append(env.world.N_ACTIONS - 5)  # UP action\n\n    return actions\n\n  def collect_primitive(env, primitive_name):\n      \"\"\"Helper function to collect a primitive.\"\"\"\n      primitive_index = env.world.cookbook.index[primitive_name]\n      \n      if primitive_index not in env.world.grabbable_indices:\n          raise ValueError(f\"{primitive_name} is not a grabbable item.\")\n      \n      # Check if already have the required amount of the primitive\n      if env._current_state.inventory[primitive_index] >= recipe.get(primitive_name, 0):\n          return []\n      \n      actions = []\n\n      while env._current_state.inventory[primitive_index] < recipe.get(primitive_name, 0):\n          positions = find_item_positions(env._current_state.grid, [primitive_index])\n          \n          if not positions:\n              raise ValueError(f\"No available {primitive_name} to collect.\")\n          \n          for pos in positions:\n              actions.extend(navigate_to_item(env, [primitive_index]))\n              \n              # Check if the agent is next to an item\n              if env._current_state.next_to(primitive_index):\n                  actions.append(env.world.N_ACTIONS - 1)  # USE action\n              \n              if env._current_state.inventory[primitive_index] >= recipe.get(primitive_name, 0):\n                  break\n\n      return actions\n\n  def find_item_positions(grid, target_indices):\n      \"\"\"Find all positions of specific items in the grid.\"\"\"\n      positions = []\n      for idx in target_indices:\n          pos_list = np.argwhere(grid[:, :, idx] > 0).tolist()\n          positions.extend(pos_list)\n      return positions\n\n  def find_workshop_position(grid, workshop_name, cookbook_index):\n      \"\"\"Find the position of a specific workshop in the grid.\"\"\"\n      workshop_index = cookbook_index[f\"workshop{workshop_name}\"]\n      \n      pos_list = np.argwhere(grid[:, :, workshop_index] > 0)\n      if len(pos_list) == 0:\n          raise ValueError(f\"No available {workshop_name} to navigate to.\")\n      return pos_list[0].tolist()\n\n  def ensure_correct_facing_direction(env, target_pos):\n      \"\"\"Ensure the agent is facing the correct direction before using the workshop.\"\"\"\n      dx = target_pos[0] - env._current_state.pos[0]\n      dy = target_pos[1] - env._current_state.pos[1]\n\n      if dx == 1:\n          return [env.world.N_ACTIONS - 3]  # RIGHT action\n      elif dx == -1:\n          return [env.world.N_ACTIONS - 4]  # LEFT action\n      elif dy == 1:\n          return [env.world.N_ACTIONS - 2]  # DOWN action\n      elif dy == -1:\n          return [env.world.N_ACTIONS - 5]  # UP action\n      else:\n          return []\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the goal item is a primitive or not in the recipes\n  if item_index in env.world.grabbable_indices:\n      return []  # Primitives cannot be crafted\n  \n  # Retrieve the recipe for the desired item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Determine the workshop required for crafting\n  workshop_key = \"_at\"\n  workshop_name = next((k.split('_')[1] for k in recipe if k.startswith(workshop_key)), None)\n  if not workshop_name:\n      raise ValueError(f\"No workshop specified for crafting {item}.\")\n  \n  workshop_index = env.world.cookbook.index[f\"workshop{workshop_name}\"]\n  workshop_pos = find_workshop_position(env._current_state.grid, f\"workshop{workshop_name}\", env.world.cookbook.index)\n\n  actions = []\n\n  # Collect all required primitives or intermediate items\n  for req_item_name, count in recipe.items():\n      if isinstance(req_item_name, str) and not req_item_name.startswith('_'):\n          actions.extend(collect_primitive(env, req_item_name))\n      \n  # Navigate to the workshop and ensure correct facing direction before using it\n  if env._current_state.next_to(workshop_index):\n      actions.append(env.world.N_ACTIONS - 1)  # USE action\n  else:\n      actions.extend(navigate_to_position(env, workshop_pos))\n      actions.extend(ensure_correct_facing_direction(env, workshop_pos))\n      actions.append(env.world.N_ACTIONS - 1)  # USE action\n\n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T01:13:10.240645", "function_name": "craft", "function_body": "  actions = []\n\n  # Get the index for the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all required primitives in our inventory.\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n\n  # Calculate the number of missing primitives\n  missing_primitives = {p: count - env._current_state.inventory[p] for p, count in required_primitives.items() if count > env._current_state.inventory[p]}\n  \n  # If we have all primitives, then proceed to craft the item.\n  if not missing_primitives:\n    workshop_index = None\n    # Find the workshop that can be used to craft this item\n    for recipe in env.world.cookbook.recipes.values():\n      if item_index in recipe and \"_at\" in recipe:\n        workshop_index = env.world.cookbook.index[recipe[\"_at\"]]\n        break\n    \n    # If we found a valid workshop, navigate to it.\n    if workshop_index is not None:\n      workshop_pos = find_workshop_position(env._current_state.grid, workshop_index)\n      \n      if workshop_pos is not None:\n        actions.extend(navigate_to(env._current_state.pos, env._current_state.dir, workshop_pos))\n        \n        # Face the workshop and use it\n        actions.append(face_towards(env._current_state.pos, env._current_state.dir, workshop_pos))\n        actions.append(craft.ENV.USE)\n\n    else:\n      raise ValueError(\"No valid workshop found for crafting the item.\")\n  else:\n    # Collect missing primitives.\n    print(f\"Missing primitives: {missing_primitives}\")\n    for primitive_index, count in missing_primitives.items():\n      primitive_name = env.world.cookbook.index.get(primitive_index)\n      \n      if primitive_name is None:\n        raise ValueError(\"Primitive name not found.\")\n      \n      actions.extend(collect(env, primitive_name))\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-11T01:13:11.211814", "function_name": "craft", "function_body": "  # Get the index of the goal item from the cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the required primitives in our inventory to craft the item\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  \n  actions = []\n  \n  # Collect missing primitives\n  for primitive, count in required_primitives.items():\n    while env._current_state.inventory[primitive] < count:\n      actions.extend(collect_v2(env, env.world.cookbook.index.get(primitive)))\n    \n  # Determine the workshop to use for crafting the item\n  workshop_index = None\n  for ingredient_or_key, _ in env.world.cookbook.recipes[item_index].items():\n    if isinstance(ingredient_or_key, str) and ingredient_or_key == \"_at\":\n      workshop_name = env.world.cookbook.recipes[item_index][ingredient_or_key]\n      workshop_index = getattr(env.world, f\"{workshop_name}_index\")\n      break\n  \n  # Move to the nearest workshop\n  if workshop_index is not None:\n    actions.extend(move_to_workshop_v2(env, workshop_index))\n    \n    # Use the workshop to craft the item\n    actions.append(craft.USE)\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-11T01:14:32.363892", "function_name": "craft", "function_body": "  actions = []\n  # Convert item name to index\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the recipe for the desired item exists\n  if item_index not in env.world.cookbook.recipes:\n    return []  # No recipe available\n\n  # Get the required ingredients and their counts from the recipe\n  recipe = env.world.cookbook.recipes[item_index]\n  required_ingredients = {ingredient: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n\n  # Check if all required ingredients are available in inventory or can be crafted\n  for ingredient, count in required_ingredients.items():\n    if ingredient not in env.world.cookbook.primitives:\n      continue  # Skip non-primitive ingredients\n\n    ingredient_index = int(ingredient)\n\n    # Collect the required amount of primitives\n    while env._current_state.inventory[ingredient_index] < count:\n      actions.extend(collect_v2(env, ingredient_index))\n\n  # Find the workshop to craft the item\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n  workshop_pos = find_workshop_position(env._current_state.grid, workshop_index)\n\n  if workshop_pos is None:\n    return []  # Workshop not found\n\n  # Move to the workshop position and face it\n  actions.extend(move_to(env._current_state.pos, env._current_state.dir, workshop_pos))\n  actions.append(env.world.cookbook.index[\"USE\"])\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-11T01:14:33.348814", "function_name": "craft", "function_body": "  # Convert the item name to its corresponding index using the cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the item has a recipe\n  if item_index not in env.world.cookbook.recipes:\n    return []  # No recipe for this item\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Extract the workshop where the crafting should be done\n  workshop_name = recipe.get(\"_at\")\n  \n  if not workshop_name:\n    return []  # No workshop specified in the recipe\n\n  # Convert the workshop name to its corresponding index using the cookbook\n  try:\n    workshop_index = env.world.cookbook.index[workshop_name]\n  except KeyError:\n    return []  # Workshop specified in the recipe does not exist\n\n  # Find the location of the workshop on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    return []  # No such workshop found on the grid\n\n  # Pick any one workshop (we can choose the first one for simplicity)\n  target_workshop_position = tuple(workshop_positions[0])\n\n  # Plan a path to the target workshop\n  actions_to_reach_workshop = plan_path(env, env._current_state.pos, target_workshop_position)\n\n  if not actions_to_reach_workshop:\n    return []  # No valid path found to reach the workshop\n\n  # Check if we have all required ingredients in our inventory or need to collect them\n  required_ingredients = {ingredient: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n\n  # Convert ingredient names to their corresponding indices\n  ingredient_indices = {env.world.cookbook.index[ingredient]: count for ingredient, count in required_ingredients.items()}\n\n  # Check if we have all required ingredients in our inventory\n  actions_to_collect_ingredients = []\n  for ingredient_index, count in ingredient_indices.items():\n    if env._current_state.inventory[ingredient_index] < count:\n      # We need to collect this ingredient\n      actions_to_collect_ingredient = collect(env, env.world.cookbook.index.get(ingredient_index))\n      if not actions_to_collect_ingredient:\n        return []  # Could not find a way to collect the required ingredient\n\n      actions_to_collect_ingredients.extend(actions_to_collect_ingredient)\n\n  # Combine all actions: collect ingredients -> move to workshop -> use at workshop\n  final_actions = actions_to_collect_ingredients + actions_to_reach_workshop + [env.world.cookbook.index[\"USE\"]]\n\n  return final_actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-11T01:17:06.568788", "function_name": "craft", "function_body": "  def a_star(grid, start, end):\n    heuristic = lambda pos: np.linalg.norm(np.array(pos) - np.array(end))\n    open_set = [(start, [])]\n    came_from = {}\n    g_score = {tuple(start): 0}\n    f_score = {tuple(start): heuristic(start)}\n\n    while open_set:\n      current, path = min(open_set, key=lambda x: f_score[tuple(x[0])])\n      open_set.remove((current, path))\n\n      if current == end:\n        return path + [end]\n\n      for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        tentative_g_score = g_score[tuple(current)] + 1\n\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n            # Check if the neighboring cell is walkable (i.e., not an obstacle)\n            if np.all(grid[neighbor[0], neighbor[1], :] == 0):\n                continue\n\n            if tuple(neighbor) not in g_score or tentative_g_score < g_score[tuple(neighbor)]:\n                came_from[tuple(neighbor)] = current\n                g_score[tuple(neighbor)] = tentative_g_score\n                f_score[tuple(neighbor)] = tentative_g_score + heuristic(neighbor)\n                open_set.append((neighbor, path + [current]))\n\n    return []\n\n  def get_direction(current_pos, next_pos):\n      if next_pos[0] > current_pos[0]:\n          return 3  # RIGHT\n      elif next_pos[0] < current_pos[0]:\n          return 2  # LEFT\n      elif next_pos[1] > current_pos[1]:\n          return 4  # DOWN\n      else:\n          return 1  # UP\n\n  actions = []\n\n  # Get the index for the goal item\n  goal_index = env.world.cookbook.index[item]\n\n  # Get the primitives required to make the goal item\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n\n  # Check if we have all the required primitives in inventory\n  for prim, count in required_primitives.items():\n    if env._current_state.inventory[prim] < count:\n      return []  # Return empty list if any primitive is not sufficient\n\n  # Identify the workshop where crafting should occur\n  workshop_index = None\n  for recipe_output, ingredients in env.world.cookbook.recipes.items():\n    if recipe_output == goal_index and \"_key\" in ingredients:\n      workshop_key = ingredients[\"_key\"]\n      workshop_index = env.world.cookbook.index[workshop_key]\n      break\n\n  if workshop_index is None:\n    return []  # No valid workshop found\n\n  # Locate the workshop on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    return []  # Workshop not found on the grid\n\n  # Navigate to the nearest workshop using A* search\n  agent_pos = env._current_state.pos\n  closest_workshop = min(workshop_positions, key=lambda x: np.linalg.norm(np.array(x) - np.array(agent_pos)))\n\n  path_to_workshop = a_star(env._current_state.grid, agent_pos, closest_workshop)\n\n  if not path_to_workshop:\n      return []  # No valid path found\n\n  for i in range(len(path_to_workshop) - 1):\n    current_pos = path_to_workshop[i]\n    next_pos = path_to_workshop[i + 1]\n    actions.append(get_direction(current_pos, next_pos))\n\n  # Finally use the workshop\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T01:17:07.671580", "function_name": "craft", "function_body": "  def a_star(grid, start, end):\n    heuristic = lambda pos: np.linalg.norm(np.array(pos) - np.array(end))\n    open_set = [(start, [])]\n    came_from = {}\n    g_score = {tuple(start): 0}\n    f_score = {tuple(start): heuristic(start)}\n\n    while open_set:\n      current, path = min(open_set, key=lambda x: f_score[tuple(x[0])])\n      open_set.remove((current, path))\n\n      if current == end:\n        return path + [end]\n\n      for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        tentative_g_score = g_score[tuple(current)] + 1\n\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n            if np.all(grid[neighbor[0], neighbor[1], :] == 0):\n                continue\n            if tuple(neighbor) not in g_score or tentative_g_score < g_score[tuple(neighbor)]:\n                came_from[tuple(neighbor)] = current\n                g_score[tuple(neighbor)] = tentative_g_score\n                f_score[tuple(neighbor)] = tentative_g_score + heuristic(neighbor)\n                open_set.append((neighbor, path + [current]))\n\n    return []\n\n  actions = []\n  \n  # Get the index for the goal item\n  goal_index = env.world.cookbook.index[item]\n\n  # Get the primitives required to make the goal item\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  \n  # Check if we have all the required primitives in inventory\n  missing_primitives = {}\n  for prim, count in required_primitives.items():\n    if env._current_state.inventory[prim] < count:\n      missing_primitives[prim] = count - env._current_state.inventory[prim]\n  \n  if missing_primitives:\n    return []  # Return empty list if any primitive is not sufficient\n\n  # Identify the workshop where crafting should occur\n  workshop_index = None\n  for recipe_output, ingredients in env.world.cookbook.recipes.items():\n    if recipe_output == goal_index and \"_key\" in ingredients:\n      workshop_key = ingredients[\"_key\"]\n      workshop_index = env.world.cookbook.index[workshop_key]\n      break\n  \n  if workshop_index is None:\n    return []  # No valid workshop found\n\n  # Locate the workshops on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n    return []  # Workshop not found on the grid\n\n  # Navigate to the nearest workshop using A* search\n  agent_pos = env._current_state.pos\n  closest_workshop = min(workshop_positions, key=lambda x: np.linalg.norm(np.array(x) - np.array(agent_pos)))\n  \n  path_to_workshop = a_star(env._current_state.grid, agent_pos, tuple(closest_workshop))\n  \n  if not path_to_workshop:\n    return []  # No valid path found\n\n  for i in range(len(path_to_workshop) - 1):\n    dx, dy = path_to_workshop[i + 1][0] - path_to_workshop[i][0], path_to_workshop[i + 1][1] - path_to_workshop[i][1]\n    \n    if dx > 0:\n      actions.append(3)  # RIGHT\n    elif dx < 0:\n      actions.append(2)  # LEFT\n    elif dy > 0:\n      actions.append(4)  # DOWN\n    elif dy < 0:\n      actions.append(1)  # UP\n\n  # Assuming the agent is facing the correct direction to use the workshop\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
