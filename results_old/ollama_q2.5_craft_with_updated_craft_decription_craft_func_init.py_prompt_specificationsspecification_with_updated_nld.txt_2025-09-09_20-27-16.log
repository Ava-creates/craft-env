tate.grid[new_x, new_y, :]):  # Assuming no obstacles for simplicity\n            next_direction = move[2]\n            turn_actions = get_turn_actions(direction, next_direction)\n            queue.append(((new_x, new_y), next_direction, path + turn_actions + [next_direction]))\n            visited.add(((new_x, new_y), next_direction))\n\n    return []  # No valid path found\n\n  actions = []\n\n  # Get the index for the goal item\n  goal_index = env.world.cookbook.index[item]\n\n  # Check if we have all the required primitives in inventory\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  \n  missing_primitives = {}\n  for prim, count in required_primitives.items():\n      if env._current_state.inventory[prim] < count:\n          missing_primitives[prim] = count - env._current_state.inventory[prim]\n  \n  if missing_primitives:\n      # Collect missing primitives\n      for prim, needed_count in missing_primitives.items():\n          while needed_count > 0:\n              actions.extend(collect_primitive(env, prim))\n              needed_count -= required_primitives[prim]\n\n  # Identify the workshop where crafting should occur\n  for recipe_output, ingredients in env.world.cookbook.recipes.items():\n      if recipe_output == goal_index and \"_key\" in ingredients:\n          workshop_key = ingredients[\"_key\"]\n          break\n  else:\n      return []  # No valid workshop found\n  \n  # Find the index of the workshop\n  workshop_index = env.world.cookbook.index[workshop_key]\n\n  # Locate the workshop on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n      return []  # Workshop not found on the grid\n\n  # Navigate to the nearest workshop\n  agent_pos = env._current_state.pos\n  closest_workshop = min(workshop_positions, key=lambda x: np.linalg.norm(np.array(x) - np.array(agent_pos)))\n\n  # Calculate the path to the nearest workshop\n  actions.extend(navigate_to_position(agent_pos, env._current_state.dir, tuple(closest_workshop)))\n\n  # Ensure the agent is facing the correct direction to use the workshop\n  current_direction = env._current_state.dir\n\n  target_direction = None\n  if closest_workshop[0] == agent_pos[0]:\n    if closest_workshop[1] > agent_pos[1]:\n      target_direction = 4  # DOWN\n    else:\n      target_direction = 1  # UP\n  elif closest_workshop[1] == agent_pos[1]:\n    if closest_workshop[0] > agent_pos[0]:\n      target_direction = 3  # RIGHT\n    else:\n      target_direction = 2  # LEFT\n\n  actions.extend(get_turn_actions(current_direction, target_direction))\n\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-11T07:34:25.722998", "function_name": "craft", "function_body": "  def has_all_primitives(required_primitives, inventory_dict):\n    return all(primitive in inventory_dict and inventory_dict[primitive] >= required_primitives[primitive] for primitive in required_primitives)\n\n  actions = []\n  \n  # Get the index of the goal item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  # If not all primitives are available return empty action list\n  if not has_all_primitives(required_primitives, inventory_dict):\n    return []\n  \n  # Find the workshop where we can craft this item and its position\n  workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n    if \"_key\" in recipe and item_index == recipe[\"_key\"]:\n      workshop_index = recipe.get(\"_at\")\n      break\n  \n  if workshop_index is None:\n    return []\n\n  # Find the positions of all workshops with the same index\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(workshop_positions) == 0:\n    return []\n  \n  # Select the closest workshop\n  current_pos = env._current_state.pos\n  target_workshop_pos = min(workshop_positions, key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1]))\n\n  # Navigate to the selected workshop\n  actions.extend(navigate(env._current_state, target_workshop_pos))\n  \n  # Turn towards the workshop if not already facing it\n  current_direction = env._current_state.dir\n  direction_to_workshop = get_direction(current_pos, target_workshop_pos)\n  if current_direction != direction_to_workshop:\n    actions.append(direction_to_workshop)\n\n  # Ensure the agent is directly in front of the workshop before using USE action\n  while not env._current_state.next_to(target_workshop_pos):\n    actions.extend(navigate(env._current_state, target_workshop_pos))\n  \n  # Use the USE action to craft the item at the workshop\n  actions.append(4)  # Assuming 4 is the index for the USE action\n  \n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T07:34:26.770859", "function_name": "craft", "function_body": "  def has_all_primitives(required_primitives, inventory_dict):\n    return all(primitive in inventory_dict and inventory_dict[primitive] >= required_primitives[primitive] for primitive in required_primitives)\n\n  actions = []\n  \n  # Get the index of the goal item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  # If not all primitives are available return empty action list\n  if not has_all_primitives(required_primitives, inventory_dict):\n    return []\n\n  # Find the workshop where we can craft this item and its position\n  workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n    if \"_key\" in recipe and item_index == recipe[\"_key\"]:\n      workshop_index = recipe.get(\"_at\")\n      break\n  \n  if workshop_index is None:\n    return []\n\n  # Find the positions of all workshops with the same index\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(workshop_positions) == 0:\n    return []\n  \n  # Select the closest workshop\n  current_pos = env._current_state.pos\n  target_workshop_pos = min(workshop_positions, key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1]))\n\n  # Navigate to the selected workshop\n  actions.extend(navigate(env._current_state, target_workshop_pos))\n  \n  # Turn towards the workshop if not already facing it\n  current_direction = env._current_state.dir\n  direction_to_workshop = get_direction(current_pos, target_workshop_pos)\n  if current_direction != direction_to_workshop:\n    actions.append(direction_to_workshop)\n\n  # Check if agent is directly in front of the workshop and use USE action to craft item\n  if (target_workshop_pos[0] == current_pos[0] and abs(target_workshop_pos[1] - current_pos[1]) == 1) or \\\n     (target_workshop_pos[1] == current_pos[1] and abs(target_workshop_pos[0] - current_pos[0]) == 1):\n    actions.append(4)  # Assuming 4 is the index for the USE action\n  else:\n    return []  # Return empty list if not in front of workshop\n\n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T07:35:39.585683", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  index = cookbook.index\n\n  # Get the required ingredients and their counts for the desired item\n  goal_index = index[item]\n  recipe = cookbook.recipes.get(goal_index, {})\n\n  if not recipe:\n    return []  # No recipe found for the item\n\n  actions = []\n  required_primitives = {index[k]: v for k, v in recipe.items() if k != \"_at\"}\n\n  # Check and collect all required primitives\n  for primitive_idx, count in required_primitives.items():\n    primitive_name = index.get(primitive_idx)\n    while env._current_state.inventory[primitive_idx] < count:\n      actions.extend(collect(env, primitive_name))\n\n  # Go to the specified workshop and craft the item\n  workshop_name = recipe[\"_at\"]\n  workshop_index = index[workshop_name]\n\n  # Find a path to the workshop\n  workshop_pos = find_nearest_workshop(env._current_state.grid, workshop_index)\n  if not workshop_pos:\n    return []  # No valid path to the workshop\n\n  actions.extend(navigate_to_position(env._current_state.pos, workshop_pos))\n\n  # Face the workshop and use it to craft the item\n  actions.append(face_direction(env._current_state, workshop_pos))\n  actions.append(craft.world.N_ACTIONS[\"USE\"])\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-11T07:35:40.557318", "function_name": "craft", "function_body": "  # Get the index of the item to be crafted\n  item_idx = env.world.cookbook.index[item]\n  \n  # If the goal is not in the cookbook's recipes, raise an error.\n  if item_idx not in env.world.cookbook.recipes:\n    raise ValueError(f\"No recipe found for {item}\")\n  \n  # Get all primitives required to craft the item\n  prerequisites = env.world.cookbook.primitives_for(item_idx)\n  \n  actions = []\n  \n  # Check if we have all the primitives required in our inventory\n  for primitive, count in prerequisites.items():\n    while env._current_state.inventory[primitive] < count:\n      # Find where the primitive is located on the grid\n      positions = np.argwhere(env._current_state.grid[:, :, primitive] > 0)\n      \n      if len(positions) == 0:\n        raise ValueError(f\"No {env.world.cookbook.index.get(primitive)} available on the grid\")\n      \n      # Move to the nearest position with the required primitive\n      pos = positions[0]\n      current_pos = env._current_state.pos\n      \n      actions.extend(move_to(env, (pos[1], pos[0])))\n      actions.append(craft.MOVE_FUNC(craft.RIGHT))  # Assume right is facing the block for simplicity\n      actions.append(craft.COLLECT_FUNC(primitive))\n      \n      # Pick up the primitive if it's collectible\n      # Note: The agent needs to be adjacent and facing the correct direction to collect an item\n  \n  # After collecting all prerequisites, move to the appropriate workshop\n  recipe = env.world.cookbook.recipes[item_idx]\n  workshop_key = \"_at\" in recipe and recipe[\"_at\"]\n  \n  if not workshop_key:\n    raise ValueError(f\"No workshop specified for crafting {item}\")\n  \n  workshop_idx = env.world.cookbook.index[workshop_key]\n  \n  # Find the position of the required workshop\n  positions = np.argwhere(env._current_state.grid[:, :, workshop_idx] > 0)\n  \n  if len(positions) == 0:\n    raise ValueError(f\"No {workshop_key} available on the grid\")\n  \n  pos = positions[0]\n  actions.extend(move_to(env, (pos[1], pos[0])))\n  actions.append(craft.MOVE_FUNC(craft.RIGHT))  # Assume right is facing the block for simplicity\n  actions.append(craft.USE_FUNC())  # Use action to craft the item\n  \n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-11T07:38:35.511630", "function_name": "craft", "function_body": "  def get_direction(current_pos, target_pos):\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    if abs(dx) > abs(dy):\n      return 3 if dx > 0 else 2\n    elif abs(dx) < abs(dy):\n      return 1 if dy > 0 else 0\n    elif dx > 0:\n      return 3  # RIGHT\n    elif dx < 0:\n      return 2  # LEFT\n    elif dy > 0:\n      return 1  # UP\n    elif dy < 0:\n      return 0  # DOWN\n\n  def navigate(state, target_pos):\n    path = []\n    current_pos = state.pos\n    \n    while current_pos != target_pos:\n      direction = get_direction(current_pos, target_pos)\n      \n      if direction == 0:  # DOWN\n        path.append(0)\n        current_pos = (current_pos[0], current_pos[1] - 1)\n      elif direction == 1:  # UP\n        path.append(1)\n        current_pos = (current_pos[0], current_pos[1] + 1)\n      elif direction == 2:  # LEFT\n        path.append(2)\n        current_pos = (current_pos[0] - 1, current_pos[1])\n      elif direction == 3:  # RIGHT\n        path.append(3)\n        current_pos = (current_pos[0] + 1, current_pos[1])\n    \n    return path\n\n  def turn_to_face(state, target_pos):\n    dx = target_pos[0] - state.pos[0]\n    dy = target_pos[1] - state.pos[1]\n\n    if abs(dx) > abs(dy):\n      return 3 if dx > 0 else 2\n    elif abs(dx) < abs(dy):\n      return 1 if dy > 0 else 0\n    elif dx > 0:\n      return 3  # RIGHT\n    elif dx < 0:\n      return 2  # LEFT\n    elif dy > 0:\n      return 1  # UP\n    elif dy < 0:\n      return 0  # DOWN\n\n  def has_all_primitives(required_primitives, inventory_dict):\n    return all(primitive in inventory_dict and inventory_dict[primitive] >= required_primitives[primitive] for primitive in required_primitives)\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  # If not all primitives are available return empty action list\n  if not has_all_primitives(required_primitives, inventory_dict):\n    return []\n  \n  # Find the workshop where we can craft this item\n  workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n      workshop_index = recipe.get(\"_at\")\n      break\n  \n  if workshop_index is None:\n    return []\n\n  # Find the position of the nearest workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(workshop_positions) == 0:\n    return []\n  \n  # Select the closest workshop (for simplicity, we take the first one found)\n  target_workshop_pos = tuple(min(workshop_positions, key=lambda x: abs(x[0] - env._current_state.pos[0]) + abs(x[1] - env._current_state.pos[1])))\n\n  # Navigate to the selected workshop\n  actions = navigate(env._current_state, target_workshop_pos)\n  \n  # Turn towards the workshop if not already facing it\n  current_direction = env._current_state.dir\n  direction_to_workshop = turn_to_face(env._current_state, target_workshop_pos)\n  \n  # Check if we need to turn\n  if current_direction != direction_to_workshop:\n    actions.append(direction_to_workshop)\n\n  # Use the USE action to craft the item at the workshop\n  actions.append(4)  # Assuming 4 is the index for the USE action\n  \n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T07:38:36.627930", "function_name": "craft", "function_body": "  def get_direction(current_pos, target_pos):\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    if abs(dx) > abs(dy):\n      return 3 if dx > 0 else 2\n    elif abs(dx) < abs(dy):\n      return 1 if dy > 0 else 0\n    elif dx > 0:\n      return 3  # RIGHT\n    elif dx < 0:\n      return 2  # LEFT\n    elif dy > 0:\n      return 1  # UP\n    elif dy < 0:\n      return 0  # DOWN\n\n  def navigate(state, target_pos):\n    path = []\n    current_pos = state.pos\n    \n    while current_pos != target_pos:\n      direction = get_direction(current_pos, target_pos)\n      \n      if direction == 0:  # DOWN\n        path.append(0)\n        current_pos = (current_pos[0], current_pos[1] - 1)\n      elif direction == 1:  # UP\n        path.append(1)\n        current_pos = (current_pos[0], current_pos[1] + 1)\n      elif direction == 2:  # LEFT\n        path.append(2)\n        current_pos = (current_pos[0] - 1, current_pos[1])\n      elif direction == 3:  # RIGHT\n        path.append(3)\n        current_pos = (current_pos[0] + 1, current_pos[1])\n    \n    return path\n\n  def turn_to_face(state, target_pos):\n    dx = target_pos[0] - state.pos[0]\n    dy = target_pos[1] - state.pos[1]\n\n    if abs(dx) > abs(dy):\n      return 3 if dx > 0 else 2\n    elif abs(dx) < abs(dy):\n      return 1 if dy > 0 else 0\n    elif dx > 0:\n      return 3  # RIGHT\n    elif dx < 0:\n      return 2  # LEFT\n    elif dy > 0:\n      return 1  # UP\n    elif dy < 0:\n      return 0  # DOWN\n\n  def has_all_primitives(required_primitives, inventory_dict):\n    return all(primitive in inventory_dict and inventory_dict[primitive] >= required_primitives[primitive] for primitive in required_primitives)\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  # If not all primitives are available return empty action list\n  if not has_all_primitives(required_primitives, inventory_dict):\n    return []\n  \n  # Find the workshop where we can craft this item\n  workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n      workshop_index = recipe.get(\"_at\")\n      break\n  \n  if workshop_index is None:\n    return []\n\n  # Find the position of the nearest workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(workshop_positions) == 0:\n    return []\n  \n  # Select the closest workshop (for simplicity, we take the first one found)\n  target_workshop_pos = tuple(min(workshop_positions, key=lambda x: abs(x[0] - env._current_state.pos[0]) + abs(x[1] - env._current_state.pos[1])))\n\n  # Navigate to the selected workshop\n  actions = navigate(env._current_state, target_workshop_pos)\n\n  # Turn towards the workshop if not already facing it\n  current_direction = env._current_state.dir\n  direction_to_workshop = turn_to_face(env._current_state, target_workshop_pos)\n  \n  # Check if we need to turn\n  if current_direction != direction_to_workshop:\n    actions.append(direction_to_workshop)\n\n  # Use the USE action to craft the item at the workshop\n  actions.append(4)  # Assuming 4 is the index for the USE action\n  \n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T07:40:55.176408", "function_name": "craft", "function_body": "  def get_primitive_actions(primitive_name):\n    # Fetch the index for the primitive\n    primitive_index = env.world.cookbook.index.index(primitive_name)\n    \n    # Check if we already have the primitive in our inventory\n    if env._current_state.inventory[primitive_index] > 0:\n      return []\n    \n    # Find all cells with the required primitive\n    target_cells = np.argwhere(env._current_state.grid[..., primitive_index] == 1)\n    \n    if len(target_cells) == 0:\n      raise ValueError(f\"No source found for {primitive_name}\")\n    \n    # Sort by distance from current position to find nearest source\n    distances = np.linalg.norm(target_cells - np.array(env._current_state.pos), axis=1)\n    closest_cell = target_cells[np.argmin(distances)]\n    \n    # Calculate actions needed to reach the primitive and collect it\n    path_to_primitive = a_star_search(env, env._current_state.pos, tuple(closest_cell))\n    collect_action = [4]  # USE action\n    \n    return path_to_primitive + collect_action\n\n  def get_workshop_actions(workshop_name):\n    # Fetch the index for the workshop\n    workshop_index = env.world.cookbook.index.index(workshop_name)\n    \n    # Find all cells with the required workshop\n    target_cells = np.argwhere(env._current_state.grid[..., workshop_index] == 1)\n    \n    if len(target_cells) == 0:\n      raise ValueError(f\"No {workshop_name} found\")\n    \n    # Sort by distance from current position to find nearest workshop\n    distances = np.linalg.norm(target_cells - np.array(env._current_state.pos), axis=1)\n    closest_cell = target_cells[np.argmin(distances)]\n    \n    # Calculate actions needed to reach the workshop and use it\n    path_to_workshop = a_star_search(env, env._current_state.pos, tuple(closest_cell))\n    use_action = [4]  # USE action\n    \n    return path_to_workshop + use_action\n\n  def a_star_search(grid, start, goal):\n    heuristic = lambda pos: np.linalg.norm(np.array(pos) - np.array(goal), ord=1)\n    open_set = collections.PriorityQueue()\n    open_set.put((0, start))\n    came_from = {}\n    g_score = {start: 0}\n    \n    while not open_set.empty():\n      _, current = open_set.get()\n      \n      if current == goal:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        return path[::-1]  # Reverse the path to get it from start to goal\n        \n      for neighbor in [(current[0] + 1, current[1]), (current[0] - 1, current[1]), \n                      (current[0], current[1] + 1), (current[0], current[1] - 1)]:\n        tentative_g_score = g_score[current] + 1\n        if neighbor in grid and grid[neighbor][env.world.water_index] == 0:  # Ensure not blocked by water\n          if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n            came_from[neighbor] = current\n            g_score[neighbor] = tentative_g_score\n            f_score = tentative_g_score + heuristic(neighbor)\n            open_set.put((f_score, neighbor))\n    \n    return []  # No path found\n\n  item_index = env.world.cookbook.index.index(item)\n  recipe = env.world.cookbook.recipes[item_index]\n  \n  # Collect all primitives needed for crafting\n  actions = []\n  for primitive_name in [env.world.cookbook.index.get_by_value(i) for i, count in enumerate(recipe) if count > 0]:\n    actions.extend(get_primitive_actions(primitive_name))\n    \n  # Go to the workshop specified in the recipe and craft\n  workshop_index = env.world.workshop_indices[env.world.cookbook.recipes[item_index].workshop]\n  workshop_name = env.world.cookbook.index.get_by_value(workshop_index)\n  actions.extend(get_workshop_actions(workshop_name))\n  \n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-11T07:40:56.175628", "function_name": "craft", "function_body": "  actions = []\n\n  # Find the index of the goal item\n  goal_index = env.world.cookbook.index[item]\n\n  # Check if we have all the required primitives for crafting\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  inventory = env._current_state.inventory\n\n  # Check if we have all the required primitives in our inventory\n  has_all_required = True\n  for prim_index, count in required_primitives.items():\n    if inventory[prim_index] < count:\n      has_all_required = False\n      break\n\n  if not has_all_required:\n    return []\n\n  # If we have all the primitives, proceed to craft the item\n  # Find the workshop where this item can be crafted\n  for recipe_output, ingredients in env.world.cookbook.recipes.items():\n    if recipe_output == goal_index:\n      workshop = ingredients.get(\"_key\", None)\n      break\n\n  # Find the index of the workshop in the world\n  workshop_index = None\n  for idx in env.world.workshop_indices:\n    if env.world.cookbook.index.get(env.world.cookbook.get(idx)) == workshop:\n      workshop_index = idx\n      break\n\n  if workshop_index is None:\n    return []\n\n  # Get current position and direction of the agent\n  pos = env._current_state.pos\n  dir = env._current_state.dir\n\n  # Calculate the path to the workshop\n  # This is a simplified version assuming direct line-of-sight movement\n  workshop_pos = np.argwhere(env._current_state.grid[:, :, workshop_index])[0]\n\n  # Add actions to move towards the workshop\n  while not (pos[0] == workshop_pos[0] and pos[1] == workshop_pos[1]):\n    if pos[0] < workshop_pos[0]:\n      actions.append(3)  # RIGHT\n    elif pos[0] > workshop_pos[0]:\n      actions.append(2)  # LEFT\n    elif pos[1] < workshop_pos[1]:\n      actions.append(1)  # UP\n    else:\n      actions.append(0)  # DOWN\n\n    # Update position based on the action taken\n    if actions[-1] == 3:  # RIGHT\n      pos = (pos[0] + 1, pos[1])", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-11T07:44:00.391510", "function_name": "craft", "function_body": "  def get_turn_actions(current_dir: int, target_dir: int) -> list[int]:\n    \"\"\"Calculates the sequence of turn actions to change from current direction to target direction.\"\"\"\n    # Assuming directions are encoded as follows:\n    # UP = 0, RIGHT = 1, DOWN = 2, LEFT = 3\n    turn_actions = []\n    if (current_dir + 1) % 4 == target_dir:\n      turn_actions.append(6)  # Turn right\n    elif (current_dir - 1) % 4 == target_dir:\n      turn_actions.append(5)  # Turn left\n    else:\n      turn_actions.extend([5, 5])  # Turn around\n    return turn_actions\n\n  actions = []\n  \n  # Get the index for the goal item\n  goal_index = env.world.cookbook.index[item]\n\n  # Check if the item is already in inventory\n  if env._current_state.inventory[goal_index] > 0:\n      return []  # No need to craft if already have the item\n\n  # Get the primitives required to make the goal item\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  \n  # Check if we have all the required primitives in inventory\n  for prim, count in required_primitives.items():\n    if env._current_state.inventory[prim] < count:\n      return []  # Return empty list if any primitive is not sufficient\n\n  # Identify the workshop where crafting should occur\n  for recipe_output, ingredients in env.world.cookbook.recipes.items():\n    if recipe_output == goal_index and \"_key\" in ingredients:\n      workshop_key = ingredients[\"_key\"]\n      break\n  else:\n    return []  # No valid workshop found\n  \n  # Find the index of the workshop\n  workshop_index = env.world.cookbook.index[workshop_key]\n\n  # Locate the workshop on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n    return []  # Workshop not found on the grid\n\n  # Navigate to the nearest workshop using BFS (Breadth-First Search)\n  def bfs_path(start, goal):\n    queue = collections.deque([(start, [])])\n    visited = set([start])\n\n    while queue:\n      (x, y), path = queue.popleft()\n      \n      if (x, y) == goal:\n        return path\n      \n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n          if (nx, ny) not in visited and env._current_state.grid[nx, ny, 0] == 0:  # Assuming 0 represents walkable space\n            queue.append(((nx, ny), path + [(dx, dy)]))\n            visited.add((nx, ny))\n\n    return []\n\n  agent_pos = env._current_state.pos\n  closest_workshop = min(workshop_positions, key=lambda x: np.linalg.norm(np.array(x) - np.array(agent_pos)))\n  \n  path = bfs_path(agent_pos, closest_workshop)\n  \n  if not path:\n    return []  # No valid path found\n\n  current_direction = env._current_state.agent_dir  # Assuming this attribute exists\n  for dx, dy in path:\n    direction = None\n    if dx > 0:\n      direction = 3  # RIGHT\n    elif dx < 0:\n      direction = 2  # LEFT\n    elif dy > 0:\n      direction = 4  # DOWN\n    elif dy < 0:\n      direction = 1  # UP\n    \n    actions.append(direction)\n    \n    # Update agent position after each move\n    agent_pos = (agent_pos[0] + dx, agent_pos[1] + dy)\n\n    # Calculate target direction for the next move\n    target_direction = None\n    if dx > 0:\n      target_direction = 3  # RIGHT\n    elif dx < 0:\n      target_direction = 2  # LEFT\n    elif dy > 0:\n      target_direction = 4  # DOWN\n    elif dy < 0:\n      target_direction = 1  # UP\n    \n    if current_direction != target_direction:\n      actions.extend(get_turn_actions(current_direction, target_direction))\n    \n    # Update the current direction after turning\n    current_direction = target_direction\n\n  # Ensure the agent is facing the correct direction to use the workshop\n  target_direction = None\n  if closest_workshop[0] == agent_pos[0]:\n    if closest_workshop[1] > agent_pos[1]:\n      target_direction = 4  # DOWN\n    else:\n      target_direction = 1  # UP\n  elif closest_workshop[1] == agent_pos[1]:\n    if closest_workshop[0] > agent_pos[0]:\n      target_direction = 3  # RIGHT\n    else:\n      target_direction = 2  # LEFT\n  \n  if current_direction != target_direction:\n    actions.extend(get_turn_actions(current_direction, target_direction))\n  \n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T07:44:01.500410", "function_name": "craft", "function_body": "  def get_turn_actions(current_dir: int, target_dir: int) -> list[int]:\n    \"\"\"Calculates the sequence of turn actions to change from current direction to target direction.\"\"\"\n    # Assuming directions are encoded as follows:\n    # UP = 0, RIGHT = 1, DOWN = 2, LEFT = 3\n    turn_actions = []\n    if (current_dir + 1) % 4 == target_dir:\n      turn_actions.append(6)  # Turn right\n    elif (current_dir - 1) % 4 == target_dir:\n      turn_actions.append(5)  # Turn left\n    else:\n      turn_actions.extend([5, 5])  # Turn around\n    return turn_actions\n\n  actions = []\n  \n  # Get the index for the goal item\n  goal_index = env.world.cookbook.index[item]\n\n  # Get the primitives required to make the goal item\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  \n  # Check if we have all the required primitives in inventory\n  for prim, count in required_primitives.items():\n    if env._current_state.inventory[prim] < count:\n      return []  # Return empty list if any primitive is not sufficient\n\n  # Identify the workshop where crafting should occur\n  workshop_index = None\n  workshop_key = None\n  for recipe_output, ingredients in env.world.cookbook.recipes.items():\n    if recipe_output == goal_index and \"_key\" in ingredients:\n      workshop_key = ingredients[\"_key\"]\n      break\n  else:\n    return []  # No valid workshop found\n\n  # Find the index of the workshop\n  workshop_index = env.world.cookbook.index[workshop_key]\n\n  # Locate the workshop on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n    return []  # Workshop not found on the grid\n\n  # Navigate to the nearest workshop\n  agent_pos = env._current_state.pos\n  closest_workshop = min(workshop_positions, key=lambda x: np.linalg.norm(np.array(x) - np.array(agent_pos)))\n\n  # Calculate path to the nearest workshop using BFS (Breadth-First Search)\n  def bfs_path(start, goal):\n    queue = collections.deque([(start, [])])\n    visited = set([start])\n\n    while queue:\n      (x, y), path = queue.popleft()\n      \n      if (x, y) == goal:\n        return path\n      \n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n          if (nx, ny) not in visited and env._current_state.grid[nx, ny, 0] == 0:  # Assuming 0 represents walkable space\n            queue.append(((nx, ny), path + [(dx, dy)]))\n            visited.add((nx, ny))\n\n    return []\n\n  path = bfs_path(agent_pos, closest_workshop)\n  \n  if not path:\n    return []  # No valid path found\n\n  for dx, dy in path:\n    direction = None\n    if dx > 0:\n      direction = 3  # RIGHT\n    elif dx < 0:\n      direction = 2  # LEFT\n    elif dy > 0:\n      direction = 4  # DOWN\n    elif dy < 0:\n      direction = 1  # UP\n    \n    actions.append(direction)\n    agent_pos = (agent_pos[0] + dx, agent_pos[1] + dy)\n\n  # Check if the agent is already facing the correct direction to use the workshop\n  current_direction = env._current_state.agent_dir  # Assuming this attribute exists\n\n  target_direction = None\n  if closest_workshop[0] == agent_pos[0]:\n    if closest_workshop[1] > agent_pos[1]:\n      target_direction = 4  # DOWN\n    else:\n      target_direction = 1  # UP\n  elif closest_workshop[1] == agent_pos[1]:\n    if closest_workshop[0] > agent_pos[0]:\n      target_direction = 3  # RIGHT\n    else:\n      target_direction = 2  # LEFT\n  \n  if current_direction != target_direction:\n    actions.extend(get_turn_actions(current_direction, target_direction))\n  \n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T07:46:23.337780", "function_name": "craft", "function_body": "  # Get the index of the item to craft\n  idx = env.world.cookbook.index[item]\n  \n  # Check if we have all required primitives in our inventory\n  required_primitives = env.world.cookbook.primitives_for(idx)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory)}\n  \n  missing_items = []\n  for primitive, count in required_primitives.items():\n      if primitive not in inventory_dict or inventory_dict[primitive] < count:\n          missing_items.append((primitive, count - (inventory_dict[primitive] if primitive in inventory_dict else 0)))\n\n  if missing_items:\n      return []  # Cannot craft the item because we're missing some items\n\n  # Find all positions of the required workshop in the grid\n  recipe = env.world.cookbook.recipes[idx]\n  workshop_name = list(recipe.keys())[-1]\n  workshop_idx = env.world.cookbook.index[workshop_name]\n\n  workshop_positions = []\n  for i in range(env._current_state.grid.shape[0]):\n      for j in range(env._current_state.grid.shape[1]):\n          if env._current_state.grid[i, j, workshop_idx] == 1:\n              workshop_positions.append((i, j))\n\n  # Plan the path to the closest workshop position using BFS\n  def bfs(start, goals):\n    queue = collections.deque([start])\n    visited = set()\n    parent_map = {}\n\n    while queue:\n      current_pos = queue.popleft()\n\n      if current_pos in goals:\n        path = []\n        while current_pos != start:\n          path.append(current_pos)\n          current_pos = parent_map[current_pos]\n        path.reverse()\n        return path\n\n      if current_pos in visited:\n        continue\n\n      visited.add(current_pos)\n\n      # Check all four possible directions\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        new_x = current_pos[0] + dx\n        new_y = current_pos[1] + dy\n\n        if 0 <= new_x < env._current_state.grid.shape[0] and 0 <= new_y < env._current_state.grid.shape[1]:\n          # Check if the cell is empty (not blocked by any item)\n          if not np.any(env._current_state.grid[new_x, new_y]):\n            queue.append((new_x, new_y))\n            parent_map[(new_x, new_y)] = current_pos\n\n    return None  # No path found\n\n  start_pos = env._current_state.pos\n  closest_path_to_workshop = min([bfs(start_pos, [pos]) for pos in workshop_positions], key=lambda x: len(x) if x else float('inf'))\n\n  if not closest_path_to_workshop:\n    return []  # Could not find a valid path to any workshop\n\n  action_map = {(-1, 0): craft.MOVE_UP, (1, 0): craft.MOVE_DOWN, (0, -1): craft.MOVE_LEFT, (0, 1): craft.MOVE_RIGHT}\n  actions_to_workshop = [action_map[(closest_path_to_workshop[i][0] - closest_path_to_workshop[i-1][0], closest_path_to_workshop[i][1] - closest_path_to_workshop[i-1][1])] for i in range(1, len(closest_path_to_workshop))]\n\n  # Add USE action to actually craft the item\n  actions = actions_to_workshop + [craft.USE_ACTION]\n  \n  return actions", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T07:46:24.376938", "function_name": "craft", "function_body": "  idx = env.world.cookbook.index[item]\n  \n  # Check if we have all the required primitives to craft this item\n  required_primitives = env.world.cookbook.primitives_for(idx)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory)}\n\n  if any(primitive not in inventory_dict or inventory_dict[primitive] < count for primitive, count in required_primitives.items()):\n    return []\n\n  # Determine the workshop index\n  recipe = env.world.cookbook.recipes[idx]\n  workshop_name = list(recipe.keys())[-1]\n  workshop_idx = env.world.cookbook.index[workshop_name]\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = []\n  for i in range(env._current_state.grid.shape[0]):\n    for j in range(env._current_state.grid.shape[1]):\n      if env._current_state.grid[i, j, workshop_idx] == 1:\n        workshop_positions.append((i, j))\n\n  # Plan the path to the closest workshop position\n  def bfs(start, goals):\n    queue = collections.deque([start])\n    visited = set()\n    parent_map = {}\n\n    while queue:\n      current_pos = queue.popleft()\n\n      if current_pos in goals:\n        path = []\n        while current_pos != start:\n          path.append(current_pos)\n          current_pos = parent_map[current_pos]\n        path.reverse()\n        return path\n\n      if current_pos in visited:\n        continue\n\n      visited.add(current_pos)\n\n      # Check all four possible directions\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        new_x = current_pos[0] + dx\n        new_y = current_pos[1] + dy\n\n        if 0 <= new_x < env._current_state.grid.shape[0] and 0 <= new_y < env._current_state.grid.shape[1]:\n          # Check if the cell is empty (not blocked by any item)\n          if not np.any(env._current_state.grid[new_x, new_y]):\n            queue.append((new_x, new_y))\n            parent_map[(new_x, new_y)] = current_pos\n\n    return None  # No path found\n\n  start_pos = env._current_state.pos\n  closest_path_to_workshop = min([bfs(start_pos, [pos]) for pos in workshop_positions], key=lambda x: len(x) if x else float('inf'))\n\n  if not closest_path_to_workshop:\n    return []  # Could not find a valid path to any workshop\n\n  action_map = {(-1, 0): craft.MOVE_UP, (1, 0): craft.MOVE_DOWN, (0, -1): craft.MOVE_LEFT, (0, 1): craft.MOVE_RIGHT}\n  actions_to_workshop = [action_map[(closest_path_to_workshop[i][0] - closest_path_to_workshop[i-1][0], closest_path_to_workshop[i][1] - closest_path_to_workshop[i-1][1])] for i in range(1, len(closest_path_to_workshop))]\n\n  # Check if the agent is already at a workshop\n  if env._current_state.pos in workshop_positions:\n    actions = [craft.USE_ACTION]\n  else:\n    actions = actions_to_workshop + [craft.USE_ACTION]\n  \n  return actions", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T07:51:20.771026", "function_name": "craft", "function_body": "  def navigate(env, target_pos):\n    \"\"\"Navigate the agent to a specific position using BFS.\"\"\"\n    pos = env._current_state.pos\n    grid = env._current_state.grid\n    width, height = grid.shape[:2]\n\n    queue = collections.deque([pos])\n    visited = set()\n    parent = {pos: None}\n\n    while queue:\n        current_pos = queue.popleft()\n\n        if tuple(current_pos) == tuple(target_pos):\n            # Reconstruct path from start to target\n            path = []\n            while current_pos is not None:\n                path.append(current_pos)\n                current_pos = parent[current_pos]\n            return path[::-1]\n\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n            if 0 <= new_x < width and 0 <= new_y < height and grid[new_x, new_y].sum() == 0 and (new_x, new_y) not in visited:\n                queue.append((new_x, new_y))\n                visited.add((new_x, new_y))\n                parent[(new_x, new_y)] = current_pos\n\n    return None\n\n  def navigate_to_item(env, item_index):\n    \"\"\"Navigate the agent to an item using BFS.\"\"\"\n    grid = env._current_state.grid\n    target_positions = np.argwhere(grid[:, :, item_index] > 0).tolist()\n    \n    if not target_positions:\n      return []  # No targets found\n\n    closest_target_pos = min(target_positions, key=lambda x: abs(x[0] - env._current_state.pos[0]) + abs(x[1] - env._current_state.pos[1]))\n    path = navigate(env, closest_target_pos)\n    \n    if not path:\n      return []  # No valid path found\n\n    actions = []\n    for next_pos in path[1:]:\n        dx = next_pos[0] - env._current_state.pos[0]\n        dy = next_pos[1] - env._current_state.pos[1]\n\n        if dx < 0:\n            actions.append(env.world.N_ACTIONS - 4)  # UP action\n        elif dx > 0:\n            actions.append(env.world.N_ACTIONS - 3)  # DOWN action\n        elif dy < 0:\n            actions.append(env.world.N_ACTIONS - 2)  # LEFT action\n        elif dy > 0:\n            actions.append(env.world.N_ACTIONS - 5)  # RIGHT action\n\n    return actions\n\n  def collect_primitive(env, primitive_name):\n    \"\"\"Collect the specified primitive.\"\"\"\n    primitive_index = env.world.cookbook.index[primitive_name]\n    \n    if primitive_index not in env.world.grabbable_indices:\n      raise ValueError(f\"{primitive_name} is not a grabbable item.\")\n    \n    # Check if already have the required amount of the primitive\n    if env._current_state.inventory[primitive_index] >= recipe.get(primitive_name, 0):\n      return []\n    \n    actions = []\n\n    while env._current_state.inventory[primitive_index] < recipe.get(primitive_name, 0):\n      if env._current_state.next_to(primitive_index):\n        actions.append(env.world.N_ACTIONS - 1)  # USE action\n      else:\n        actions.extend(navigate_to_item(env, primitive_index))\n    \n    return actions\n\n  def navigate_to_workshop(env, workshop_name):\n    \"\"\"Navigate the agent to a specific workshop.\"\"\"\n    workshop_index = env.world.cookbook.index[workshop_name]\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n    \n    if len(positions) == 0:\n      raise ValueError(f\"No available {workshop_name} to navigate to.\")\n    \n    closest_workshop_pos = min(positions, key=lambda x: abs(x[0] - env._current_state.pos[0]) + abs(x[1] - env._current_state.pos[1]))\n    path = navigate(env, closest_workshop_pos)\n    \n    if not path:\n      return []  # No valid path found\n\n    actions = []\n    for next_pos in path[1:]:\n        dx = next_pos[0] - env._current_state.pos[0]\n        dy = next_pos[1] - env._current_state.pos[1]\n\n        if dx < 0:\n            actions.append(env.world.N_ACTIONS - 4)  # UP action\n        elif dx > 0:\n            actions.append(env.world.N_ACTIONS - 3)  # DOWN action\n        elif dy < 0:\n            actions.append(env.world.N_ACTIONS - 2)  # LEFT action\n        elif dy > 0:\n            actions.append(env.world.N_ACTIONS - 5)  # RIGHT action\n\n    return actions\n  \n  def craft_item_at_workshop(env, workshop_name):\n    \"\"\"Craft the item at the specified workshop.\"\"\"\n    workshop_index = env.world.cookbook.index[workshop_name]\n    \n    if not env._current_state.next_to(workshop_index):\n      actions = navigate_to_workshop(env, workshop_name)\n    else:\n      actions = []\n      \n    actions.append(env.world.N_ACTIONS - 1)  # USE action\n    \n    return actions\n\n  def get_recipe_for_item(env, item):\n    \"\"\"Retrieve the recipe for the specified item.\"\"\"\n    cookbook = env.world.cookbook\n    item_index = cookbook.index[item]\n    \n    if item_index in cookbook.recipes:\n      return cookbook.recipes[item_index]\n    else:\n      raise ValueError(f\"No recipe available for {item}.\")\n\n  def get_primitives_needed_for_recipe(env, recipe):\n    \"\"\"Extract the primitives needed from a recipe.\"\"\"\n    primitives_needed = {}\n    for req_item_name, count in recipe.items():\n        if isinstance(req_item_name, str) and not req_item_name.startswith('_'):\n            primitives_needed[req_item_name] = count\n    return primitives_needed\n\n  def collect_all_primitives(env, primitives_needed):\n    \"\"\"Collect all required primitives for the recipe.\"\"\"\n    actions = []\n    for primitive_name, count in primitives_needed.items():\n        while env._current_state.inventory[env.world.cookbook.index[primitive_name]] < count:\n            actions.extend(collect_primitive(env, primitive_name))\n    return actions\n\n  def get_workshop_from_recipe(recipe):\n      \"\"\"Determine the workshop required from the recipe.\"\"\"\n      for key in recipe:\n          if key.startswith('_at'):\n              workshop_id = key.split('_')[1]\n              if workshop_id.isdigit():\n                  workshop_key = f\"workshop{workshop_id}\"\n                  return workshop_key\n      raise ValueError(\"No valid workshop specified in the recipe.\")\n\n  def determine_required_items(env, item):\n    \"\"\"Determine all required items (primitives and intermediates) for crafting an item.\"\"\"\n    required_items = set()\n    \n    def dfs(item_name):\n        if item_name not in env.world.cookbook.recipes:\n            return\n        \n        recipe = env.world.cookbook.recipes[env.world.cookbook.index[item_name]]\n        for req_item_name, count in recipe.items():\n            if isinstance(req_item_name, str) and not req_item_name.startswith('_'):\n                required_items.add(req_item_name)\n                dfs(req_item_name)\n\n    dfs(item)\n    return required_items\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the goal item is a primitive or not in the recipes\n  if item_index in env.world.grabbable_indices:\n    return []  # Primitives cannot be crafted\n  \n  # Retrieve the recipe for the desired item\n  recipe = get_recipe_for_item(env, item)\n\n  # Determine all required items (primitives and intermediates) for crafting the item\n  required_items = determine_required_items(env, item)\n  \n  actions = []\n\n  # Collect all required primitives or intermediate items\n  for primitive_name in required_items:\n    actions.extend(collect_primitive(env, primitive_name))\n\n  # Determine the workshop required for crafting\n  workshop_name = get_workshop_from_recipe(recipe)\n\n  # Craft the final item at the workshop\n  actions.extend(craft_item_at_workshop(env, workshop_name))\n\n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T07:51:21.836343", "function_name": "craft", "function_body": "  def navigate_to_position(pos: tuple, current_pos: tuple, grid: np.ndarray) -> list[int]:\n      \"\"\"Navigate the agent to a specific position using BFS.\"\"\"\n      width, height = grid.shape[:2]\n      \n      queue = collections.deque([current_pos])\n      visited = set()\n      parent = {current_pos: None}\n\n      while queue:\n          current_pos = queue.popleft()\n\n          if tuple(current_pos) == tuple(pos):\n              # Reconstruct path from start to target\n              path = []\n              while current_pos is not None:\n                  path.append(current_pos)\n                  current_pos = parent[current_pos]\n              return path[::-1]\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n              if 0 <= new_x < width and 0 <= new_y < height:\n                  if grid[new_x, new_y].sum() == 0 and (new_x, new_y) not in visited:\n                      queue.append((new_x, new_y))\n                      visited.add((new_x, new_y))\n                      parent[(new_x, new_y)] = current_pos\n      return None\n\n  def navigate_to_item(env, item_index: int) -> list[int]:\n    \"\"\"Navigate the agent to an item using BFS.\"\"\"\n    grid = env._current_state.grid\n    target_positions = np.argwhere(grid[:, :, item_index] > 0).tolist()\n    \n    if not target_positions:\n      return []  # No targets found\n\n    closest_target_pos = min(target_positions, key=lambda x: abs(x[0] - env._current_state.pos[0]) + abs(x[1] - env._current_state.pos[1]))\n    path = navigate_to_position(closest_target_pos, env._current_state.pos, grid)\n    \n    if not path:\n      return []  # No valid path found\n\n    actions = []\n    for next_pos in path[1:]:\n        dx = next_pos[0] - env._current_state.pos[0]\n        dy = next_pos[1] - env._current_state.pos[1]\n\n        if dx < 0:\n            actions.append(env.world.N_ACTIONS - 4)  # UP action\n        elif dx > 0:\n            actions.append(env.world.N_ACTIONS - 3)  # DOWN action\n        elif dy < 0:\n            actions.append(env.world.N_ACTIONS - 2)  # LEFT action\n        elif dy > 0:\n            actions.append(env.world.N_ACTIONS - 5)  # RIGHT action\n\n    return actions\n\n  def collect_primitive(env, primitive_name: str) -> list[int]:\n    \"\"\"Collect the specified primitive.\"\"\"\n    primitive_index = env.world.cookbook.index[primitive_name]\n    \n    if primitive_index not in env.world.grabbable_indices:\n      raise ValueError(f\"{primitive_name} is not a grabbable item.\")\n    \n    # Check if already have the required amount of the primitive\n    if env._current_state.inventory[primitive_index] >= recipe.get(primitive_name, 0):\n      return []\n    \n    actions = []\n\n    while env._current_state.inventory[primitive_index] < recipe.get(primitive_name, 0):\n      if env._current_state.next_to(primitive_index):\n        actions.append(env.world.N_ACTIONS - 1)  # USE action\n      else:\n        actions.extend(navigate_to_item(env, primitive_index))\n    \n    return actions\n\n  def navigate_to_workshop(env, workshop_name: str) -> list[int]:\n    \"\"\"Navigate the agent to a specific workshop.\"\"\"\n    workshop_index = env.world.cookbook.index[workshop_name]\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n    \n    if len(positions) == 0:\n      raise ValueError(f\"No available {workshop_name} to navigate to.\")\n    \n    closest_workshop_pos = min(positions, key=lambda x: abs(x[0] - env._current_state.pos[0]) + abs(x[1] - env._current_state.pos[1]))\n    path = navigate_to_position(closest_workshop_pos, env._current_state.pos, env._current_state.grid)\n    \n    if not path:\n      return []  # No valid path found\n\n    actions = []\n    for next_pos in path[1:]:\n        dx = next_pos[0] - env._current_state.pos[0]\n        dy = next_pos[1] - env._current_state.pos[1]\n\n        if dx < 0:\n            actions.append(env.world.N_ACTIONS - 4)  # UP action\n        elif dx > 0:\n            actions.append(env.world.N_ACTIONS - 3)  # DOWN action\n        elif dy < 0:\n            actions.append(env.world.N_ACTIONS - 2)  # LEFT action\n        elif dy > 0:\n            actions.append(env.world.N_ACTIONS - 5)  # RIGHT action\n\n    return actions\n  \n  def craft_item_at_workshop(env, workshop_name: str) -> list[int]:\n    \"\"\"Craft the item at the specified workshop.\"\"\"\n    workshop_index = env.world.cookbook.index[workshop_name]\n    \n    if not env._current_state.next_to(workshop_index):\n      actions = navigate_to_workshop(env, workshop_name)\n    else:\n      actions = []\n      \n    actions.append(env.world.N_ACTIONS - 1)  # USE action\n    \n    return actions\n\n  def get_recipe_for_item(env, item: str):\n    \"\"\"Retrieve the recipe for the specified item.\"\"\"\n    cookbook = env.world.cookbook\n    item_index = cookbook.index[item]\n    \n    if item_index in cookbook.recipes:\n      return cookbook.recipes[item_index]\n    else:\n      raise ValueError(f\"No recipe available for {item}.\")\n\n  def get_primitives_needed_for_recipe(env, recipe: dict):\n    \"\"\"Extract the primitives needed from a recipe.\"\"\"\n    primitives_needed = {}\n    for req_item_name, count in recipe.items():\n        if isinstance(req_item_name, str) and not req_item_name.startswith('_'):\n            primitives_needed[req_item_name] = count\n    return primitives_needed\n\n  def collect_all_primitives(env, primitives_needed: dict):\n    \"\"\"Collect all required primitives for the recipe.\"\"\"\n    actions = []\n    for primitive_name, count in primitives_needed.items():\n        while env._current_state.inventory[env.world.cookbook.index[primitive_name]] < count:\n            actions.extend(collect_primitive(env, primitive_name))\n    return actions\n\n  def get_workshop_from_recipe(recipe: dict):\n      \"\"\"Determine the workshop required from the recipe.\"\"\"\n      for key in recipe:\n          if key.startswith('_at'):\n              workshop_id = key.split('_')[1]\n              if workshop_id.isdigit():\n                  workshop_key = f\"workshop{workshop_id}\"\n                  return workshop_key\n      raise ValueError(\"No valid workshop specified in the recipe.\")\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the goal item is a primitive or not in the recipes\n  if item_index in env.world.grabbable_indices:\n    return []  # Primitives cannot be crafted\n  \n  # Retrieve the recipe for the desired item\n  recipe = get_recipe_for_item(env, item)\n\n  # Determine the workshop required for crafting\n  workshop_name = get_workshop_from_recipe(recipe)\n  \n  primitives_needed = get_primitives_needed_for_recipe(env, recipe)\n\n  actions = []\n\n  # Collect all required primitives or intermediate items\n  actions.extend(collect_all_primitives(env, primitives_needed))\n\n  # Craft the item at the workshop\n  actions.extend(craft_item_at_workshop(env, workshop_name))\n\n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T07:53:20.753458", "function_name": "craft", "function_body": "  idx = env.world.cookbook.index[item]\n  \n  # Check if we have all the required primitives to craft this item\n  required_primitives = env.world.cookbook.primitives_for(idx)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory)}\n\n  # Collect missing items\n  actions = []\n  for primitive, count in required_primitives.items():\n    if primitive not in inventory_dict or inventory_dict[primitive] < count:\n      collect_actions = collect_v2(env, primitive)\n      if collect_actions == []:\n        return []  # Cannot collect the required primitives\n      actions.extend(collect_actions)\n\n  # Determine the workshop index and position\n  recipe = env.world.cookbook.recipes[idx]\n  workshop_name = list(recipe.keys())[-1]\n  workshop_idx = env.world.cookbook.index[workshop_name]\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = []\n  for i in range(env._current_state.grid.shape[0]):\n    for j in range(env._current_state.grid.shape[1]):\n      if env._current_state.grid[i, j, workshop_idx] == 1:\n        workshop_positions.append((i, j))\n\n  # Plan the path to the closest workshop position\n  def bfs(start, goals):\n    queue = collections.deque([start])\n    visited = set()\n    parent_map = {}\n\n    while queue:\n      current_pos = queue.popleft()\n\n      if current_pos in goals:\n        path = []\n        while current_pos != start:\n          path.append(current_pos)\n          current_pos = parent_map[current_pos]\n        path.reverse()\n        return path\n\n      if current_pos in visited:\n        continue\n\n      visited.add(current_pos)\n\n      # Check all four possible directions\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        new_x = current_col + dx\n        new_y = current_row + dy\n\n        if 0 <= new_x < env._current_state.grid.shape[0] and 0 <= new_y < env._current_state.grid.shape[1]:\n          # Check if the cell is empty (not blocked by any item)\n          if not np.any(env._current_state.grid[new_x, new_y]):\n            queue.append((new_x, new_y))\n            parent_map[(new_x, new_y)] = current_pos\n\n    return None  # No path found\n\n  start_pos = env._current_state.pos\n  closest_path_to_workshop = min([bfs(start_pos, [pos]) for pos in workshop_positions], key=lambda x: len(x) if x else float('inf'))\n\n  if not closest_path_to_workshop:\n    return []  # Could not find a valid path to any workshop\n\n  action_map = {(-1, 0): craft.MOVE_UP, (1, 0): craft.MOVE_DOWN, (0, -1): craft.MOVE_LEFT, (0, 1): craft.MOVE_RIGHT}\n  actions_to_workshop = [action_map[(closest_path_to_workshop[i][0] - closest_path_to_workshop[i-1][0], closest_path_to_workshop[i][1] - closest_path_to_workshop[i-1][1])] for i in range(1, len(closest_path_to_workshop))]\n\n  actions.extend(actions_to_workshop + [craft.USE_ACTION])\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-11T07:53:21.797353", "function_name": "craft", "function_body": "  idx = env.world.cookbook.index[item]\n  required_primitives = env.world.cookbook.primitives_for(idx)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory)}\n\n  if any(primitive not in inventory_dict or inventory_dict[primitive] < count for primitive, count in required_primitives.items()):\n    return []\n\n  recipe = env.world.cookbook.recipes[idx]\n  workshop_name = list(recipe.keys())[-1]\n  workshop_idx = env.world.cookbook.index[workshop_name]\n\n  workshop_positions = []\n  for i in range(env._current_state.grid.shape[0]):\n    for j in range(env._current_state.grid.shape[1]):\n      if env._current_state.grid[i, j, workshop_idx] == 1:\n        workshop_positions.append((i, j))\n\n  def bfs(start, goals):\n    queue = collections.deque([start])\n    visited = set()\n    parent_map = {}\n\n    while queue:\n      current_pos = queue.popleft()\n\n      if current_pos in goals:\n        path = []\n        while current_pos != start:\n          path.append(current_pos)\n          current_pos = parent_map[current_pos]\n        path.reverse()\n        return path\n\n      if current_pos in visited:\n        continue\n\n      visited.add(current_pos)\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        new_x = current_pos[0] + dx\n        new_y = current_pos[1] + dy\n\n        if 0 <= new_x < env._current_state.grid.shape[0] and 0 <= new_y < env._current_state.grid.shape[1]:\n          if not np.any(env._current_state.grid[new_x, new_y]):\n            queue.append((new_x, new_y))\n            parent_map[(new_x, new_y)] = current_pos\n\n    return None\n\n  start_pos = env._current_state.pos\n  closest_path_to_workshop = min([bfs(start_pos, [pos]) for pos in workshop_positions], key=lambda x: len(x) if x else float('inf'))\n\n  if not closest_path_to_workshop:\n    return []\n\n  action_map = {(-1, 0): craft.MOVE_UP, (1, 0): craft.MOVE_DOWN, (0, -1): craft.MOVE_LEFT, (0, 1): craft.MOVE_RIGHT}\n  actions_to_workshop = [action_map[(closest_path_to_workshop[i][0] - closest_path_to_workshop[i-1][0], closest_path_to_workshop[i][1] - closest_path_to_workshop[i-1][1])] for i in range(1, len(closest_path_to_workshop))]\n\n  actions = actions_to_workshop + [craft.USE_ACTION]\n  \n  return actions", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T07:55:41.019487", "function_name": "craft", "function_body": "  def has_all_primitives(required_primitives, inventory_dict):\n    return all(primitive in inventory_dict and inventory_dict[primitive] >= required_primitives[primitive] for primitive in required_primitives)\n\n  def get_closest_workshop(grid, workshop_index, pos):\n    workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n    if len(workshop_positions) == 0:\n      return None\n    # Calculate the Manhattan distance to each workshop and choose the closest one\n    distances = [abs(pos[0] - wp[0]) + abs(pos[1] - wp[1]) for wp in workshop_positions]\n    closest_index = np.argmin(distances)\n    return tuple(workshop_positions[closest_index])\n\n  def navigate(state, target_pos):\n    actions = []\n    current_pos = state.pos\n    while current_pos != target_pos:\n      if current_pos[0] < target_pos[0]:\n        actions.append(3)  # RIGHT\n        current_pos = (current_pos[0] + 1, current_pos[1])\n      elif current_pos[0] > target_pos[0]:\n        actions.append(2)  # LEFT\n        current_pos = (current_pos[0] - 1, current_pos[1])\n      if current_pos[1] < target_pos[1]:\n        actions.append(0)  # UP\n        current_pos = (current_pos[0], current_pos[1] + 1)\n      elif current_pos[1] > target_pos[1]:\n        actions.append(1)  # DOWN\n        current_pos = (current_pos[0], current_pos[1] - 1)\n    return actions\n\n  def get_direction(current_pos, target_workshop_pos):\n    if current_pos[0] < target_workshop_pos[0]:\n      return 3  # RIGHT\n    elif current_pos[0] > target_workshop_pos[0]:\n      return 2  # LEFT\n    elif current_pos[1] < target_workshop_pos[1]:\n      return 0  # UP\n    else:\n      return 1  # DOWN\n\n  def update_state(state, action):\n    new_state = state._replace(dir=action) if action in [0, 1, 2, 3] else state\n    if action == 4:  # USE action\n      new_inventory = np.copy(state.inventory)\n      item_index = env.world.cookbook.index[item]\n      required_primitives = env.world.cookbook.primitives_for(item_index)\n      for primitive in required_primitives:\n        index = env.world.cookbook.index[primitive]\n        new_inventory[index] -= required_primitives[primitive]\n      new_inventory[item_index] += 1\n      new_state = state._replace(inventory=new_inventory)\n    return new_state\n\n  actions = []\n  \n  # Get the index of the goal item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  # If not all primitives are available return empty action list\n  if not has_all_primitives(required_primitives, inventory_dict):\n    return []\n  \n  # Find the workshop where we can craft this item\n  workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n      workshop_index = recipe.get(\"_at\")\n      break\n  \n  if workshop_index is None:\n    return []\n\n  # Get the closest workshop position\n  target_workshop_pos = get_closest_workshop(env._current_state.grid, workshop_index, env._current_state.pos)\n  if target_workshop_pos is None:\n    return []\n  \n  # Navigate to the selected workshop\n  actions.extend(navigate(env._current_state, target_workshop_pos))\n  \n  # Turn towards the workshop if not already facing it\n  current_direction = env._current_state.dir\n  direction_to_workshop = get_direction(env._current_state.pos, target_workshop_pos)\n  if current_direction != direction_to_workshop:\n    actions.append(direction_to_workshop)\n\n  # Use the USE action to craft the item at the workshop\n  actions.append(4)  # Assuming 4 is the index for the USE action\n  \n  return actions", "island_id": 8, "scores": {"3": 0.0}}
