{"timestamp": "2025-09-11T01:01:10.151280", "function_name": "craft", "function_body": "  actions = []\n\n  # Get the index for the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the items/primitives required for crafting\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  \n  if not primitives_needed:\n    return actions\n  \n  # Check inventory to see what is available\n  current_inventory = env._current_state.inventory\n\n  # Collect missing primitives\n  for primitive, count in primitives_needed.items():\n    if current_inventory[primitive] < count:\n      # Collect the required number of primitives\n      primitive_name = env.world.cookbook.index.get(primitive)\n      collect_actions = collect(env, primitive_name)\n      actions.extend(collect_actions)\n\n  # Determine the workshop where the item can be crafted\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_key = \"_at\"\n  if workshop_key in recipe:\n    workshop_name = recipe[workshop_key]\n    workshop_index = env.world.cookbook.index[workshop_name]\n    \n    # Navigate to the nearest workshop of the required type\n    move_actions, facing_direction = navigate_to_nearest_workshop(env._current_state.grid, env._current_state.pos, workshop_index)\n    actions.extend(move_actions)\n\n    # Turn to face the workshop if needed\n    if not is_facing_correct_direction(env._current_state.dir, facing_direction):\n      turn_action = get_turn_action(env._current_state.dir, facing_direction)\n      actions.append(turn_action)\n    \n    # Use action to craft the item\n    actions.append(4)  # Assuming USE action index is 4\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-11T01:01:11.204023", "function_name": "craft", "function_body": "  actions = []\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  goal_index = index[item]\n\n  # Check if the agent already has the item in its inventory\n  if env._current_state.inventory[goal_index] > 0:\n    return []\n\n  # Check for the required primitives to craft the item\n  required_primitives = cookbook.primitives_for(goal_index)\n\n  # Collect all required primitives\n  for primitive, count in required_primitives.items():\n    for _ in range(count):\n      actions.extend(collect(env, index.get(primitive)))\n\n  # Find the workshop needed for crafting\n  workshop_key = f\"_at\"\n  if workshop_key not in cookbook.recipes[goal_index]:\n    raise ValueError(f\"No workshop specified for crafting {item}\")\n\n  workshop_name = cookbook.recipes[goal_index][workshop_key]\n  workshop_index = index[workshop_name]\n\n  # Move to the nearest workshop\n  actions.extend(move_to_workshop(env, workshop_index))\n\n  # Craft the item using the USE action\n  actions.append(craft.CRAFT_FUNC(workshop_index))\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-11T01:03:44.663975", "function_name": "craft", "function_body": "  def get_crafting_requirements(item_index):\n      required_primitives = env.world.cookbook.primitives_for(item_index)\n      return required_primitives\n  \n  def find_workshop(item_index):\n      for recipe in env.world.cookbook.recipes.values():\n          if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n              workshop_key = recipe.get(\"_at\")\n              if workshop_key is not None:\n                  return getattr(env.world, f\"{workshop_key}_index\", None)\n      return None\n  \n  def a_star_search(grid, start, goal):\n      open_set = []\n      heapq.heappush(open_set, (0, start))\n      came_from = {}\n      g_score = {start: 0}\n      f_score = {start: heuristic(start, goal)}\n\n      while open_set:\n          _, current = heapq.heappop(open_set)\n          \n          if current == goal:\n              return reconstruct_path(came_from, current)\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              \n              if not (0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]):\n                  continue\n              \n              tentative_g_score = g_score[current] + 1\n\n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                  heapq.heappush(open_set, (f_score[neighbor], neighbor))\n      \n      return []\n\n  def heuristic(a, b):\n      # Manhattan distance\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def reconstruct_path(came_from, current):\n      total_path = [current]\n      while current in came_from:\n          current = came_from[current]\n          total_path.append(current)\n      return total_path[::-1]\n\n  def move_to_target(grid, start_pos, target_pos):\n      path = a_star_search(grid, start_pos, target_pos)\n      actions = []\n      for i in range(len(path) - 1):\n          dx = path[i+1][0] - path[i][0]\n          dy = path[i+1][1] - path[i][1]\n          \n          if dx == -1:\n              actions.append(2)  # LEFT\n          elif dx == 1:\n              actions.append(3)  # RIGHT\n          elif dy == -1:\n              actions.append(1)  # UP\n          elif dy == 1:\n              actions.append(0)  # DOWN\n      \n      return actions\n\n  def rotate_to_face(current_state, target_pos, workshop_index):\n      if current_state.grid[target_pos[0], target_pos[1], workshop_index] == 1:\n          dx = target_pos[0] - current_state.pos[0]\n          dy = target_pos[1] - current_state.pos[1]\n          \n          if dx < 0:  # Workshop is to the left\n              return 2  # LEFT\n          elif dx > 0:  # Workshop is to the right\n              return 3  # RIGHT\n          elif dy < 0:  # Workshop is above\n              return 1  # UP\n          else:  # Workshop is below\n              return 0  # DOWN\n      \n      return None\n  \n  def find_closest_object(grid, start_pos, object_index):\n      target_positions = np.argwhere(grid[:, :, object_index] > 0)\n      \n      if not target_positions.any():\n          return None\n      \n      distances = np.linalg.norm(target_positions - start_pos, axis=1)\n      closest_target = tuple(target_positions[np.argmin(distances)])\n      \n      return closest_target\n  \n  def plan_crafting(item_index):\n      required_primitives = get_crafting_requirements(item_index)\n      actions = []\n      \n      for primitive, count in required_primitives.items():\n          while env._current_state.inventory[primitive] < count:\n              closest_primitive_pos = find_closest_object(env._current_state.grid, env._current_state.pos, primitive)\n              \n              if closest_primitive_pos is None:\n                  return []  # No path to the target primitive\n              \n              path_to_primitive = a_star_search(env._current_state.grid, env._current_state.pos, closest_primitive_pos)\n\n              for pos in path_to_primitive[:-1]:  # Exclude the last position as we'll be facing it when we reach\n                  actions.extend(move_to_target(env._current_state.grid, env._current_state.pos, pos))\n\n              final_pos = path_to_primitive[-1]\n              actions.append(rotate_to_face(env._current_state, final_pos, primitive))\n              actions.append(5)  # Collect action\n\n      target_workshop_index = find_workshop(item_index)\n      \n      if target_workshop_index is None:\n          return []\n      \n      start_pos = env._current_state.pos\n      grid_with_target = env._current_state.grid.copy()\n      grid_with_target[:, :, target_workshop_index] += 1000  # Marking the target workshop for A* search\n\n      closest_workshop_pos = find_closest_object(grid_with_target, start_pos, target_workshop_index)\n      \n      if closest_workshop_pos is None:\n          return []  # No path to the target workshop\n      \n      path_to_workshop = a_star_search(env._current_state.grid, env._current_state.pos, closest_workshop_pos)\n\n      for pos in path_to_workshop[:-1]:  # Exclude the last position as we'll be facing it when we reach\n          actions.extend(move_to_target(env._current_state.grid, env._current_state.pos, pos))\n\n      final_pos = path_to_workshop[-1]\n      actions.append(rotate_to_face(env._current_state, final_pos, target_workshop_index))\n      actions.append(4)  # Use action\n\n      return actions\n  \n  item_index = env.world.cookbook.index[item]\n  \n  return plan_crafting(item_index)", "island_id": 0, "scores": {"3": -1}}
