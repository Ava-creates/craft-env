{"timestamp": "2025-09-10T01:55:32.729294", "function_name": "craft", "function_body": "  actions = []\n  current_state = env._current_state\n\n  # Convert item name to its index\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the recipe for the item exists\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Collect all required items/primitives for crafting\n  for ingredient, count in recipe.items():\n      if ingredient != \"_at\":\n          ingredient_index = env.world.cookbook.index[ingredient]\n          while current_state.inventory[ingredient_index] < count:\n              actions.extend(collect(env, ingredient))\n              current_state = env._current_state\n\n  # Move to the specified workshop for crafting\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the workshop in the grid\n  workshop_positions = np.argwhere(current_state.grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n      return []\n\n  workshop_pos = tuple(workshop_positions[0])\n  actions.extend(move_to(env, workshop_pos))\n\n  # Turn to face the workshop and perform the USE action\n  actions.append(env.world.N_ACTIONS - 1)  # Assuming USE action is the last one\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-10T01:55:33.701310", "function_name": "craft", "function_body": "  # Find the index for the desired item in the cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the recipe for the desired item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n  \n  if not recipe:\n    print(f\"No recipe found for item: {item}\")\n    return []\n  \n  # Check if we have all the primitives required for crafting\n  actions_to_collect_primitives = []\n\n  for ingredient_index, count in recipe.items():\n      if ingredient_index == \"_at\":\n          workshop_name = env.world.cookbook.index.get(count)\n          continue\n      \n      primitive_needed_count = count\n\n      while primitive_needed_count > 0:\n          # Collect the primitive\n          actions = collect_v2(env, env.world.cookbook.index.get(ingredient_index))\n          \n          if not actions:\n              print(f\"Unable to collect required primitives for item: {item}\")\n              return []\n          \n          actions_to_collect_primitives.extend(actions)\n          primitive_needed_count -= 1\n\n  # Now that we have all the primitives, let's go to the workshop and craft the item\n  actions_to_craft_item = []\n\n  if workshop_name:\n      # Move towards the workshop\n      workshop_indices = [i for i, x in enumerate(env.world.workshop_indices) if env.world.cookbook.index.get(x) == workshop_name]\n      \n      if not workshop_indices:\n          print(f\"Workshop {workshop_name} not found.\")\n          return []\n      \n      workshop_index = workshop_indices[0]\n      workshop_pos = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)[0]\n\n      # Add actions to move towards the workshop\n      actions_to_craft_item.extend(move_towards_position(env, workshop_pos))\n\n      # Add action to face the workshop and use it to craft the item\n      actions_to_craft_item.append(craft.CRAFT_FUNC.index('USE'))\n\n  return actions_to_collect_primitives + actions_to_craft_item", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-10T01:57:48.882094", "function_name": "craft", "function_body": "  def collect_ingredient(name: str):\n    ingredient_idx = env.world.cookbook.index[name]\n    if env._current_state.inventory[ingredient_idx] > 0:\n      return []\n    \n    # Find all positions of the ingredient in the grid\n    ingredient_positions = np.argwhere(env._current_state.grid[:, :, ingredient_idx] == 1)\n    if len(ingredient_positions) == 0:\n        return []  # Ingredient not found in the grid\n    \n    # Calculate distances from current position to all ingredient positions\n    current_pos = np.array(env._current_state.pos)\n    distances = np.linalg.norm(current_pos - ingredient_positions, axis=1)\n    \n    # Sort ingredient positions by distance (ascending order)\n    sorted_indices = np.argsort(distances)\n    nearest_position = tuple(ingredient_positions[sorted_indices[0]])\n    \n    # Move to the nearest ingredient position\n    actions = move_to(env._current_state, nearest_position)\n    actions.append(4)  # USE action index\n    \n    return actions\n\n  def move_to(state, target_pos):\n      current_pos = state.pos\n      x_diff = target_pos[0] - current_pos[0]\n      y_diff = target_pos[1] - current_pos[1]\n\n      actions = []\n      if x_diff > 0:\n          actions.extend([3] * x_diff)  # RIGHT\n      elif x_diff < 0:\n          actions.extend([2] * abs(x_diff))  # LEFT\n\n      if y_diff > 0:\n          actions.extend([1] * y_diff)  # UP\n      elif y_diff < 0:\n          actions.extend([0] * abs(y_diff))  # DOWN\n      \n      return actions\n\n  actions = []\n  \n  # Get the index for the desired item from the cookbook\n  item_idx = env.world.cookbook.index[item]\n  \n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_idx, {})\n  \n  if not recipe:\n    return []  # No recipe found\n  \n  # Determine the workshop where the crafting should happen\n  workshop_key = \"_key\"\n  workshop_index = int(recipe.pop(workshop_key, -1))\n  \n  if workshop_index == -1:\n    return []  # Workshop not specified in the recipe\n  \n  # Get the list of workshops from the world configuration\n  workshop_indices = env.world.workshop_indices\n  \n  if workshop_index >= len(workshop_indices):\n    return []  # Invalid workshop index\n\n  # Determine the target position for the workshop\n  target_workshop_pos = None\n  for y in range(env._current_state.grid.shape[1]):\n      for x in range(env._current_state.grid.shape[0]):\n          if env._current_state.grid[x, y, workshop_indices[workshop_index]] == 1:\n              target_workshop_pos = (x, y)\n              break\n      if target_workshop_pos is not None:\n          break\n  \n  if target_workshop_pos is None:\n    return []  # Workshop position not found in the grid\n\n  # Collect all required primitives\n  for ingredient_idx, count in recipe.items():\n      ingredient_name = env.world.cookbook.index.get(ingredient_idx)\n      while env._current_state.inventory[ingredient_idx] < count:\n          actions.extend(collect_ingredient(ingredient_name))\n      \n      if env._current_state.inventory[ingredient_idx] < count:\n        return []  # Could not collect all required primitives\n\n  # Move to the target workshop\n  actions.extend(move_to(env._current_state, target_workshop_pos))\n  \n  # Perform the USE action at the workshop\n  actions.append(4)  # USE action index\n  \n  return actions", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T01:57:49.950645", "function_name": "craft", "function_body": "  def move_to(state, target_pos):\n      current_pos = state.pos\n      x_diff = target_pos[0] - current_pos[0]\n      y_diff = target_pos[1] - current_pos[1]\n\n      actions = []\n      if x_diff > 0:\n          actions.extend([3] * x_diff)  # RIGHT\n      elif x_diff < 0:\n          actions.extend([2] * abs(x_diff))  # LEFT\n\n      if y_diff > 0:\n          actions.extend([1] * y_diff)  # UP\n      elif y_diff < 0:\n          actions.extend([0] * abs(y_diff))  # DOWN\n      \n      return actions\n\n  def collect_ingredient(name: str):\n    ingredient_idx = env.world.cookbook.index[name]\n    if env._current_state.inventory[ingredient_idx] == 0:\n      # Collect the ingredient if it's not already in inventory\n      return collect_v2(env, name)\n    return []\n\n  actions = []\n  \n  # Get the index for the desired item from the cookbook\n  item_idx = env.world.cookbook.index[item]\n  \n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_idx, {})\n  \n  if not recipe:\n    return []  # No recipe found\n  \n  # Determine the workshop where the crafting should happen\n  workshop_key = \"_key\"\n  workshop_index = int(recipe.pop(workshop_key, -1))\n  \n  if workshop_index == -1:\n    return []  # Workshop not specified in the recipe\n  \n  # Get the list of workshops from the world configuration\n  workshop_indices = env.world.workshop_indices\n  \n  if workshop_index >= len(workshop_indices):\n    return []  # Invalid workshop index\n\n  # Determine the target position for the workshop\n  target_workshop_pos = None\n  for y in range(env._current_state.grid.shape[1]):\n      for x in range(env._current_state.grid.shape[0]):\n          if env._current_state.grid[x, y, workshop_indices[workshop_index]] == 1:\n              target_workshop_pos = (x, y)\n              break\n      if target_workshop_pos is not None:\n          break\n  \n  if target_workshop_pos is None:\n    return []  # Workshop position not found in the grid\n\n  # Collect all required primitives\n  for ingredient_idx, count in recipe.items():\n      ingredient_name = env.world.cookbook.index.get(ingredient_idx)\n      while env._current_state.inventory[ingredient_idx] < count:\n          actions.extend(collect_v2(env, ingredient_name))\n      \n      if env._current_state.inventory[ingredient_idx] < count:\n        return []  # Could not collect all required primitives\n\n  # Move to the target workshop\n  actions.extend(move_to(env._current_state, target_workshop_pos))\n  \n  # Perform the USE action at the workshop\n  actions.append(4)  # USE action index\n  \n  return actions", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T02:00:35.669168", "function_name": "craft", "function_body": "  def find_path(start, end, grid):\n    \"\"\"Find a path from start to end on the grid using BFS.\"\"\"\n    queue = collections.deque([(start, [])])\n    visited = set([start])\n    while queue:\n        (x, y), path = queue.popleft()\n        if (x, y) == end:\n            return path + [(x, y)]\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            nx, ny = x + dx, y + dy\n            if 0 <= nx < grid.shape[1] and 0 <= ny < grid.shape[0] and grid[ny, nx].sum() == 0 and (nx, ny) not in visited:\n                queue.append(((nx, ny), path + [(x, y)]))\n                visited.add((nx, ny))\n    return None\n\n  def move_towards(current_pos, target_pos):\n      \"\"\"Generate actions to move from current position to target position.\"\"\"\n      cx, cy = current_pos\n      tx, ty = target_pos\n      actions = []\n      while (cx, cy) != (tx, ty):\n          if cx < tx:\n              actions.append(craft.CraftLab.ACTIONS['RIGHT'])\n              cx += 1\n          elif cx > tx:\n              actions.append(craft.CraftLab.ACTIONS['LEFT'])\n              cx -= 1\n          elif cy < ty:\n              actions.append(craft.CraftLab.ACTIONS['DOWN'])\n              cy += 1\n          elif cy > ty:\n              actions.append(craft.CraftLab.ACTIONS['UP'])\n              cy -= 1\n      return actions\n\n  def face_direction(current_pos, target_pos):\n      \"\"\"Generate action to face the target position from current position.\"\"\"\n      cx, cy = current_pos\n      tx, ty = target_pos\n      if cx < tx:\n          return craft.CraftLab.ACTIONS['RIGHT']\n      elif cx > tx:\n          return craft.CraftLab.ACTIONS['LEFT']\n      elif cy < ty:\n          return craft.CraftLab.ACTIONS['DOWN']\n      elif cy > ty:\n          return craft.CraftLab.ACTIONS['UP']\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the primitives required to craft the desired item\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n  \n  actions = []\n  \n  for primitive_index, count in primitives_required.items():\n    if env._current_state.inventory[primitive_index] < count:\n      return []  # Return empty action list if any primitive is not sufficient\n\n  workshop_index = None\n  \n  # Find out which workshop is needed for crafting the desired item\n  for output_item, recipe in env.world.cookbook.recipes.items():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n      workshop_index = recipe.get(\"_at\", None)\n      break\n\n  if workshop_index is None:\n    return []  # Return empty action list if no workshop found for the desired item\n\n  # Find the position of the workshop on the grid\n  workshop_position = None\n  for y in range(env._current_state.grid.shape[0]):\n    for x in range(env._current_state.grid.shape[1]):\n      if env._current_state.grid[y, x, workshop_index] == 1:\n        workshop_position = (x, y)\n        break\n    if workshop_position:\n      break\n\n  if workshop_position is None:\n    return []  # Return empty action list if the workshop position not found\n\n  # Generate actions to move to the workshop\n  path_to_workshop = find_path(env._current_state.pos, workshop_position, env._current_state.grid)\n  \n  for pos in path_to_workshop[:-1]:\n      actions.extend(move_towards(env._current_state.pos, pos))\n      # Update the current state position after each move\n      env._current_state.pos = pos\n\n  # Turn to face the workshop\n  actions.append(face_direction(env._current_state.pos, workshop_position))\n\n  # Perform the USE action to craft the item\n  actions.append(craft.CraftLab.ACTIONS['USE'])\n  \n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T02:00:36.736443", "function_name": "craft", "function_body": "  def find_path(start, end, grid):\n    \"\"\"Find a path from start to end on the grid using BFS.\"\"\"\n    queue = collections.deque([(start, [])])\n    visited = set([start])\n    while queue:\n        (x, y), path = queue.popleft()\n        if (x, y) == end:\n            return path + [(x, y)]\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            nx, ny = x + dx, y + dy\n            if 0 <= nx < grid.shape[1] and 0 <= ny < grid.shape[0] and grid[ny, nx].sum() == 0 and (nx, ny) not in visited:\n                queue.append(((nx, ny), path + [(x, y)]))\n                visited.add((nx, ny))\n    return None\n\n  def move_towards(current_pos, target_pos):\n      \"\"\"Generate actions to move from current position to target position.\"\"\"\n      cx, cy = current_pos\n      tx, ty = target_pos\n      actions = []\n      while cx != tx or cy != ty:\n          if cx < tx:\n              actions.append(craft.CraftLab.ACTIONS['RIGHT'])\n              cx += 1\n          elif cx > tx:\n              actions.append(craft.CraftLab.ACTIONS['LEFT'])\n              cx -= 1\n          elif cy < ty:\n              actions.append(craft.CraftLab.ACTIONS['DOWN'])\n              cy += 1\n          elif cy > ty:\n              actions.append(craft.CraftLab.ACTIONS['UP'])\n              cy -= 1\n      return actions\n\n  def face_direction(current_pos, target_pos):\n      \"\"\"Generate action to face the target position from current position.\"\"\"\n      cx, cy = current_pos\n      tx, ty = target_pos\n      if cx < tx:\n          return craft.CraftLab.ACTIONS['RIGHT']\n      elif cx > tx:\n          return craft.CraftLab.ACTIONS['LEFT']\n      elif cy < ty:\n          return craft.CraftLab.ACTIONS['DOWN']\n      elif cy > ty:\n          return craft.CraftLab.ACTIONS['UP']\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the primitives required to craft the desired item\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n  \n  actions = []\n  \n  for primitive_index, count in primitives_required.items():\n    if env._current_state.inventory[primitive_index] < count:\n      return []  # Return empty action list if any primitive is not sufficient\n\n  workshop_index = None\n  \n  # Find out which workshop is needed for crafting the desired item\n  for output_item, recipe in env.world.cookbook.recipes.items():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n      workshop_index = recipe.get(\"_at\", None)\n      break\n\n  if workshop_index is None:\n    return []  # Return empty action list if no workshop found for the desired item\n\n  # Find the position of the workshop on the grid\n  workshop_position = None\n  for y in range(env._current_state.grid.shape[0]):\n    for x in range(env._current_state.grid.shape[1]):\n      if env._current_state.grid[y, x, workshop_index] == 1:\n        workshop_position = (x, y)\n        break\n    if workshop_position:\n      break\n\n  if workshop_position is None:\n    return []  # Return empty action list if the workshop position not found\n\n  # Generate actions to move to the workshop\n  path_to_workshop = find_path(env._current_state.pos, workshop_position, env._current_state.grid)\n  \n  for pos in path_to_workshop[:-1]:\n      actions.extend(move_towards(env._current_state.pos, pos))\n      # Update the current state position after each move\n      env._current_state.pos = pos\n\n  # Turn to face the workshop\n  actions.append(face_direction(env._current_state.pos, workshop_position))\n\n  # Perform the USE action to craft the item\n  actions.append(craft.CraftLab.ACTIONS['USE'])\n  \n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T02:03:28.073399", "function_name": "craft", "function_body": "  def collect_ingredient(name: str):\n    ingredient_idx = env.world.cookbook.index[name]\n    required_quantity = recipe.get(name, 0)\n    \n    if env._current_state.inventory[ingredient_idx] >= required_quantity:\n      return []\n    \n    # Find positions of the ingredient in the grid\n    ingredient_positions = []\n    for y in range(env._current_state.grid.shape[1]):\n        for x in range(env._current_state.grid.shape[0]):\n            if env._current_state.grid[x, y, ingredient_idx] == 1:\n                ingredient_positions.append((x, y))\n    \n    actions = []\n    while len(ingredient_positions) > 0 and env._current_state.inventory[ingredient_idx] < required_quantity:\n        ingredient_pos = ingredient_positions.pop()\n        \n        # Move to the ingredient position\n        actions.extend(move_to(env._current_state, ingredient_pos))\n        \n        # Perform the USE action to collect the ingredient\n        actions.append(4)  # USE action index\n    \n    return actions\n\n  def move_to(state: env.CraftState, target_position: tuple):\n      target_x, target_y = target_position\n      current_x, current_y = state.pos\n      \n      actions = []\n      \n      if target_x < current_x:\n          actions.extend([2] * (current_x - target_x))  # LEFT action index\n      elif target_x > current_x:\n          actions.extend([3] * (target_x - current_x))  # RIGHT action index\n      \n      if target_y < current_y:\n          actions.extend([1] * (current_y - target_y))  # UP action index\n      elif target_y > current_y:\n          actions.extend([0] * (target_y - current_y))  # DOWN action index\n      \n      return actions\n\n  actions = []\n  \n  # Get the index for the desired item from the cookbook\n  item_idx = env.world.cookbook.index[item]\n  \n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_idx, {})\n  \n  if not recipe:\n    return []  # No recipe found\n  \n  # Determine the workshop where the crafting should happen\n  workshop_key = \"_key\"\n  workshop_index_str = recipe.pop(workshop_key, \"-1\")\n  \n  try:\n      workshop_index = int(workshop_index_str)\n  except ValueError:\n      return []  # Invalid workshop index in the recipe\n  \n  if workshop_index == -1:\n    return []  # Workshop not specified in the recipe\n  \n  # Get the list of workshops from the world configuration\n  workshop_indices = env.world.workshop_indices\n  \n  if workshop_index >= len(workshop_indices):\n    return []  # Invalid workshop index\n  \n  # Determine the target position for the workshop\n  target_workshop_pos = None\n  for y in range(env._current_state.grid.shape[1]):\n      for x in range(env._current_state.grid.shape[0]):\n          if env._current_state.grid[x, y, workshop_indices[workshop_index]] == 1:\n              target_workshop_pos = (x, y)\n              break\n      if target_workshop_pos is not None:\n          break\n  \n  if target_workshop_pos is None:\n    return []  # Workshop position not found in the grid\n  \n  # Check and collect all required primitives\n  for ingredient_name, quantity in recipe.items():\n      actions.extend(collect_ingredient(ingredient_name))\n  \n  # Move to the target workshop\n  actions.extend(move_to(env._current_state, target_workshop_pos))\n  \n  # Perform the USE action at the workshop\n  actions.append(4)  # USE action index\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-10T02:03:29.105986", "function_name": "craft", "function_body": "  def collect_ingredient(name: str):\n    ingredient_idx = env.world.cookbook.index[name]\n    if env._current_state.inventory[ingredient_idx] >= recipe.get(name, 0):\n      return []\n    \n    # Find positions of the ingredient in the grid\n    ingredient_positions = []\n    for y in range(env._current_state.grid.shape[1]):\n        for x in range(env._current_state.grid.shape[0]):\n            if env._current_state.grid[x, y, ingredient_idx] == 1:\n                ingredient_positions.append((x, y))\n    \n    actions = []\n    while ingredient_positions and env._current_state.inventory[ingredient_idx] < recipe.get(name, 0):\n        # Sort ingredient positions by distance to the current position\n        ingredient_positions.sort(key=lambda pos: np.linalg.norm(np.array(pos) - np.array(env._current_state.pos)))\n        \n        ingredient_pos = ingredient_positions.pop(0)\n        \n        # Move to the ingredient position\n        actions.extend(move_to(env._current_state, ingredient_pos))\n        \n        # Perform the USE action to collect the ingredient\n        actions.append(4)  # USE action index\n    \n    return actions\n\n  def move_to(state, target):\n    \"\"\"Generate a list of actions to move from the current position to the target position.\"\"\"\n    \n    start = state.pos\n    goal = target\n    \n    # Implement a simple pathfinding algorithm (BFS)\n    queue = collections.deque([start])\n    came_from = {start: None}\n    \n    while queue:\n        current = queue.popleft()\n        \n        if current == goal:\n            break\n        \n        for next_pos in neighbors(current):\n            if next_pos not in came_from and is_walkable(state, next_pos):\n                queue.append(next_pos)\n                came_from[next_pos] = current\n    \n    # Reconstruct the path\n    path = []\n    while current != start:\n        path.append(current)\n        current = came_from[current]\n    path.reverse()\n    \n    actions = []\n    for step in path:\n        direction = get_direction(state.pos, step)\n        if direction == 'UP':\n            actions.append(1)  # UP action index\n        elif direction == 'DOWN':\n            actions.append(0)  # DOWN action index\n        elif direction == 'LEFT':\n            actions.append(2)  # LEFT action index\n        elif direction == 'RIGHT':\n            actions.append(3)  # RIGHT action index\n        \n        state.pos = step\n    \n    return actions\n\n  def neighbors(pos):\n      \"\"\"Generate neighboring positions.\"\"\"\n      x, y = pos\n      return [(x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)]\n\n  def is_walkable(state, pos):\n      \"\"\"Check if a position is walkable.\"\"\"\n      x, y = pos\n      grid_size_x, grid_size_y, _ = state.grid.shape\n      \n      # Check bounds\n      if x < 0 or x >= grid_size_x or y < 0 or y >= grid_size_y:\n          return False\n      \n      # Check for boundary and water obstacles (assuming indices are known)\n      boundary_idx = env.world.cookbook.index['BOUNDARY']\n      water_idx = env.world.cookbook.index['WATER']\n      \n      if state.grid[x, y, boundary_idx] == 1 or state.grid[x, y, water_idx] == 1:\n          return False\n      \n      return True\n\n  def get_direction(current_pos, next_pos):\n      \"\"\"Determine the direction to move from current position to next position.\"\"\"\n      x1, y1 = current_pos\n      x2, y2 = next_pos\n      \n      if x2 > x1:\n          return 'RIGHT'\n      elif x2 < x1:\n          return 'LEFT'\n      elif y2 > y1:\n          return 'DOWN'\n      elif y2 < y1:\n          return 'UP'\n      \n      return None\n\n  actions = []\n  \n  # Get the index for the desired item from the cookbook\n  item_idx = env.world.cookbook.index[item]\n  \n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_idx, {})\n  \n  if not recipe:\n    return []  # No recipe found\n  \n  # Determine the workshop where the crafting should happen\n  workshop_key = \"_key\"\n  workshop_index = int(recipe.pop(workshop_key, -1))\n  \n  if workshop_index == -1:\n    return []  # Workshop not specified in the recipe\n  \n  # Get the list of workshops from the world configuration\n  workshop_indices = env.world.workshop_indices\n  \n  if workshop_index >= len(workshop_indices):\n    return []  # Invalid workshop index\n  \n  # Determine the target position for the workshop\n  target_workshop_pos = None\n  for y in range(env._current_state.grid.shape[1]):\n      for x in range(env._current_state.grid.shape[0]):\n          if env._current_state.grid[x, y, workshop_indices[workshop_index]] == 1:\n              target_workshop_pos = (x, y)\n              break\n      if target_workshop_pos is not None:\n          break\n  \n  if target_workshop_pos is None:\n    return []  # Workshop position not found in the grid\n  \n  # Check and collect required primitives\n  for ingredient_name, quantity in recipe.items():\n      if ingredient_name == workshop_key:\n          continue\n      \n      actions.extend(collect_ingredient(ingredient_name))\n  \n  # Move to the target workshop\n  actions.extend(move_to(env._current_state, target_workshop_pos))\n  \n  # Perform the USE action at the workshop\n  actions.append(4)  # USE action index\n  \n  return actions", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T02:05:25.513097", "function_name": "craft", "function_body": "  def find_workshop_for_item(item_idx):\n    for recipe in env.world.cookbook.recipes.values():\n      if \"_key\" in recipe and recipe[\"_key\"] == item_idx:\n        return recipe.get(\"_at\", None)\n    return None\n\n  def collect_primitives(primitive_indices, required_counts):\n    actions = []\n    inventory = env._current_state.inventory.copy()\n    \n    for i in primitive_indices:\n      while inventory[i] < required_counts[i]:\n        primitive_name = env.world.cookbook.index.get(i)\n        primitive_actions = collect(env, primitive_name)\n        actions.extend(primitive_actions)\n        \n        # Update the inventory after collecting\n        new_inventory = env._current_state.inventory.copy()\n        for action in primitive_actions:\n          if action == env.world.USE:\n            reward, done, observations = env.step(action)\n            if done or reward > 0:\n              new_inventory[i] += 1\n              break\n        \n        inventory = new_inventory\n    \n    return actions\n\n  def find_closest_workshop(env, workshop_idx):\n    directions = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n    queue = collections.deque([(env._current_state.pos, [])])\n    visited = set()\n    \n    while queue:\n      (x, y), path = queue.popleft()\n      if env._current_state.grid[x, y, workshop_idx] > 0:\n        return x, y\n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n          if (nx, ny) not in visited and env._current_state.grid[nx, ny].sum() == 0:\n            visited.add((nx, ny))\n            queue.append(((nx, ny), path + [(dx, dy)]))\n    return None\n\n  def navigate_to_position(position):\n    target_x, target_y = position\n    start_x, start_y = env._current_state.pos\n    \n    actions = []\n    \n    while start_x != target_x or start_y != target_y:\n      if start_x < target_x and env._current_state.grid[start_x + 1, start_y].sum() == 0:\n        actions.append(env.world.DOWN)\n        start_x += 1\n      elif start_x > target_x and env._current_state.grid[start_x - 1, start_y].sum() == 0:\n        actions.append(env.world.UP)\n        start_x -= 1\n      elif start_y < target_y and env._current_state.grid[start_x, start_y + 1].sum() == 0:\n        actions.append(env.world.RIGHT)\n        start_y += 1\n      elif start_y > target_y and env._current_state.grid[start_x, start_y - 1].sum() == 0:\n        actions.append(env.world.LEFT)\n        start_y -= 1\n    \n    return [action for action in actions]\n\n  def use_action():\n    return env.world.USE\n\n  # Get the index of the item to craft\n  item_idx = env.world.cookbook.index[item]\n  \n  # Check if we have a recipe for this item\n  if item_idx not in env.world.cookbook.recipes:\n    return []\n  \n  # Get the ingredients required and their counts\n  ingredients = {k: v for k, v in env.world.cookbook.recipes[item_idx].items() if k != \"_at\"}\n  \n  # Find the workshop for crafting the item\n  workshop_name = find_workshop_for_item(item_idx)\n  if workshop_name is None:\n    return []\n  \n  # Find the index of the workshop in the environment\n  workshop_idx = env.world.workshop_indices[workshop_name]\n  \n  # Collect primitives required for crafting\n  actions = collect_primitives(list(ingredients.keys()), ingredients)\n  \n  # Navigate to the workshop and perform USE action\n  workshop_pos = find_closest_workshop(env, workshop_idx)\n  if not workshop_pos:\n    return []\n  \n  actions.extend(navigate_to_position(workshop_pos))\n  actions.append(use_action())\n  \n  return actions", "island_id": 7, "scores": {"3": 0.0}}
