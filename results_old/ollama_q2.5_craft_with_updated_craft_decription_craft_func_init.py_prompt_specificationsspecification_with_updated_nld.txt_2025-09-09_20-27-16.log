ft.TURN_RIGHT]\n      elif (target_index - current_index) % 4 == 2:\n          return [craft.TURN_AROUND]\n      elif (target_index - current_index) % 4 == 3:\n          return [craft.TURN_LEFT]\n      else:\n          return []\n\n  def align_direction_with_target(pos, target_pos):\n    direction = get_direction_to_target(pos, target_pos)\n    if direction is not None:\n        return [direction]\n    return []\n\n  actions = []\n  \n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we already have the required item in inventory or if it's a primitive\n  if env._current_state.inventory[item_index] > 0 or item_index in env.world.grabbable_indices:\n    return actions\n  \n  # Get all primitives needed to craft this item recursively\n  primitives_needed = get_primitives_recursively(env, item_index)\n  \n  # Collect all the required primitives\n  for primitive, count in primitives_needed.items():\n      actions.extend(collect_v2(env, env.world.cookbook.index.get(primitive)))\n      \n  # Determine the workshop to use based on the recipe\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_name = list(recipe[\"_key\"].split(\"_at=\"))[1] if \"_key\" in recipe else None\n  \n  # If we have a valid workshop, proceed to it\n  if workshop_name:\n      workshop_indices = [idx for idx, name in enumerate(env.world.workshop_indices) \n                          if workshop_name in env.world.cookbook.index.get(name)]\n      \n      # Find the closest workshop of the desired type\n      closest_workshop_index = find_closest_workshop(env._current_state.pos, workshop_indices)\n      \n      # Move to the closest workshop and align direction correctly before using\n      actions.extend(move_to_workshop_and_align_direction(env._current_state, closest_workshop_index))\n      \n      # Craft the item at the workshop\n      actions.append(craft.USE)\n  \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T21:16:09.048358", "function_name": "craft", "function_body": "  # Fetch the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the primitives required for crafting the item\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  \n  actions = []\n\n  # Collect all required primitives\n  for primitive, count in required_primitives.items():\n      primitive_name = env.world.cookbook.index.get(primitive)\n      \n      # Find positions of the primitives on the grid\n      positions = np.argwhere(env._current_state.grid[:, :, primitive] == 1)\n      \n      if len(positions) < count:\n          print(f\"Not enough {primitive_name} to craft {item}.\")\n          return []\n      \n      for _ in range(count):\n          pos = tuple(positions[0])\n          \n          # Calculate the direction needed to face the primitive\n          dx, dy = pos[0] - env._current_state.pos[0], pos[1] - env._current_state.pos[1]\n          dir_x = 2 if dx == 0 else (3 if dx < 0 else 1)\n          dir_y = 2 if dy == 0 else (0 if dy < 0 else 1)\n          \n          # Add actions to move towards the primitive\n          if dx != 0:\n              actions.extend([dir_x] * abs(dx))\n          if dy != 0:\n              actions.extend([dir_y] * abs(dy))\n          \n          # Add action to collect the primitive\n          actions.append(4)  # USE action to collect the primitive\n          \n          # Remove collected position from positions list\n          positions = np.delete(positions, 0, axis=0)\n\n  # Determine the workshop index and location for crafting\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  \n  if len(workshop_positions) == 0:\n      print(f\"No available {workshop_name} to craft {item}.\")\n      return []\n  \n  workshop_pos = tuple(workshop_positions[0])\n  \n  # Calculate the direction needed to face the workshop\n  dx, dy = workshop_pos[0] - env._current_state.pos[0], workshop_pos[1] - env._current_state.pos[1]\n  dir_x = 2 if dx == 0 else (3 if dx < 0 else 1)\n  dir_y = 2 if dy == 0 else (0 if dy < 0 else 1)\n  \n  # Add actions to move towards the workshop\n  if dx != 0:\n      actions.extend([dir_x] * abs(dx))\n  if dy != 0:\n      actions.extend([dir_y] * abs(dy))\n  \n  # Add action to use the workshop for crafting\n  actions.append(4)  # USE action to craft the item\n  \n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-10T21:16:09.117540", "function_name": "craft", "function_body": "    # Fetch the index of the desired item\n    i_goal = env.world.cookbook.index[item]\n    \n    # Check if the item can be crafted (has a recipe)\n    if i_goal not in env.world.cookbook.recipes:\n        return []  # No recipe available for this item\n\n    # Get the required ingredients and their counts\n    recipe = env.world.cookbook.recipes[i_goal]\n    required_ingredients = {ingredient: count for ingredient, count in recipe.items() if ingredient != \"_key\"}\n\n    # Check if we already have enough of each required ingredient in our inventory\n    actions = []\n    for ingredient_name, count in required_ingredients.items():\n        i_ingredient = env.world.cookbook.index[ingredient_name]\n        if env._current_state.inventory[i_ingredient] < count:\n            # We don't have enough of this ingredient, so we need to collect it\n            actions.extend(collect_v2(env, ingredient_name))\n\n    # Check if we have all required ingredients now\n    for ingredient_name, count in required_ingredients.items():\n        i_ingredient = env.world.cookbook.index[ingredient_name]\n        if env._current_state.inventory[i_ingredient] < count:\n            return []  # Still don't have enough of one or more ingredients\n\n    # Find the workshop where we can craft the item\n    workshop_name = recipe[\"_key\"]\n    i_workshop = env.world.cookbook.index[workshop_name]\n\n    # Move to the workshop and face it\n    actions.extend(move_to_and_face(env, i_workshop))\n\n    # Perform the USE action to craft the item\n    actions.append(craft.CRAFT_FUNC)\n\n    return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-10T21:19:17.887095", "function_name": "craft", "function_body": "  def find_item_positions(env, target_index):\n    \"\"\"Finds all positions of the target index in the grid.\"\"\"\n    grid = env._current_state.grid\n    return np.argwhere(grid[:, :, target_index] > 0).tolist()\n\n  def navigate_to_position(env, target_pos):\n    \"\"\"Navigates to a specific position on the grid using BFS algorithm for optimal path finding.\"\"\"\n    start_pos = env._current_state.pos\n    directions = [(1, 0), (-1, 0), (0, 1), (0, -1)]\n    \n    # BFS to find shortest path\n    queue = collections.deque([(start_pos, [])])\n    visited = set([start_pos])\n\n    while queue:\n      current_pos, actions_taken = queue.popleft()\n      \n      if current_pos == tuple(target_pos):\n        return actions_taken\n      \n      for dx, dy in directions:\n          new_pos = (current_pos[0] + dx, current_pos[1] + dy)\n          \n          # Check bounds and non-blocked cells\n          if 0 <= new_pos[0] < env._current_state.grid.shape[0] and 0 <= new_pos[1] < env._current_state.grid.shape[1]:\n              grid_cell = env._current_state.grid[new_pos]\n              blocked = any(grid_cell[i_kind] > 0 for i_kind in env.world.cookbook.index if i_kind not in env.world.grabbable_indices)\n              \n              if new_pos not in visited and not blocked:\n                  visited.add(new_pos)\n                  # Determine the action based on the direction\n                  if dx == -1:\n                      actions_taken.append(env.world.N_ACTIONS - 4)  # UP action\n                  elif dx == 1:\n                      actions_taken.append(env.world.N_ACTIONS - 3)  # DOWN action\n                  elif dy == -1:\n                      actions_taken.append(env.world.N_ACTIONS - 2)  # LEFT action\n                  elif dy == 1:\n                      actions_taken.append(env.world.N_ACTIONS - 5)  # RIGHT action\n                  queue.append((new_pos, actions_taken + [env.world.N_ACTIONS - 4]))\n    return []\n\n  def find_workshop_position(env, workshop_index):\n    \"\"\"Finds the position of a workshop in the grid.\"\"\"\n    positions = find_item_positions(env, workshop_index)\n    if not positions:\n      raise ValueError(f\"No available {env.world.cookbook.get(workshop_index)} to collect.\")\n    return positions[0]\n\n  def collect_primitives(env, required_items):\n    \"\"\"Collects all required primitives or intermediate items.\"\"\"\n    actions = []\n    for req_item_index, count in required_items.items():\n      while env._current_state.inventory[req_item_index] < count:\n        item_positions = find_item_positions(env, req_item_index)\n        \n        if not item_positions:\n          raise ValueError(f\"No available {env.world.cookbook.get(req_item_index)} to collect.\")\n        \n        # Navigate and collect each item\n        for pos in item_positions:\n          actions.extend(navigate_to_position(env, pos))\n          \n          # Check if the agent is next to an item\n          if env._current_state.next_to(req_item_index):\n            actions.append(env.world.N_ACTIONS - 1)  # USE action\n          \n          if env._current_state.inventory[req_item_index] >= count:\n            break\n\n    return actions\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the goal item is a primitive or not in the recipes\n  if item_index in env.world.grabbable_indices:\n    return []  # Primitives cannot be crafted\n  \n  # Retrieve the recipe for the desired item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Determine the workshop required for crafting\n  workshop_key = \"_at\"\n  workshop_name = recipe.get(workshop_key)\n  if workshop_name is None:\n    raise ValueError(f\"No workshop specified for crafting {item}.\")\n  \n  workshop_index = env.world.cookbook.index[workshop_name]\n  workshop_pos = find_workshop_position(env, workshop_index)\n\n  # Determine the list of required primitives or intermediate items\n  required_items = {env.world.cookbook.index[key]: value for key, value in recipe.items() if not isinstance(key, str) or not key.startswith('_at')}\n\n  actions = []\n\n  # Collect all required items\n  actions.extend(collect_primitives(env, required_items))\n\n  # Navigate to the workshop and use it to craft the item\n  actions.extend(navigate_to_position(env, workshop_pos))\n  actions.append(env.world.N_ACTIONS - 1)  # USE action\n  \n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T21:19:18.998608", "function_name": "craft", "function_body": "  def find_item_positions(env, target_index):\n    \"\"\"Finds all positions of the target index in the grid.\"\"\"\n    grid = env._current_state.grid\n    return np.argwhere(grid[:, :, target_index] > 0).tolist()\n\n  def navigate_to_position(env, target_pos):\n    \"\"\"Navigates to a specific position on the grid.\"\"\"\n    actions = []\n    current_pos = env._current_state.pos\n\n    while current_pos != tuple(target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if dx < 0:\n          actions.append(env.world.N_ACTIONS - 4)  # UP action\n          current_pos = (current_pos[0] - 1, current_pos[1])\n      elif dx > 0:\n          actions.append(env.world.N_ACTIONS - 3)  # DOWN action\n          current_pos = (current_pos[0] + 1, current_pos[1])\n\n      if dy < 0:\n          actions.append(env.world.N_ACTIONS - 2)  # LEFT action\n          current_pos = (current_pos[0], current_pos[1] - 1)\n      elif dy > 0:\n          actions.append(env.world.N_ACTIONS - 5)  # RIGHT action\n          current_pos = (current_pos[0], current_pos[1] + 1)\n\n    return actions\n\n  def find_workshop_position(env, workshop_index):\n    \"\"\"Finds the position of a workshop in the grid.\"\"\"\n    positions = find_item_positions(env, workshop_index)\n    if not positions:\n      raise ValueError(f\"No available {env.world.cookbook.get(workshop_index)} to collect.\")\n    return positions[0]\n\n  def collect_primitives(env, required_items):\n    \"\"\"Collects all required primitives or intermediate items.\"\"\"\n    actions = []\n    for req_item_index, count in required_items.items():\n      while env._current_state.inventory[req_item_index] < count:\n        item_positions = find_item_positions(env, req_item_index)\n        \n        if not item_positions:\n          raise ValueError(f\"No available {env.world.cookbook.get(req_item_index)} to collect.\")\n        \n        for pos in item_positions:\n          actions.extend(navigate_to_position(env, pos))\n          \n          # Check if the agent is next to an item\n          if env._current_state.next_to(req_item_index):\n            actions.append(env.world.N_ACTIONS - 1)  # USE action\n          \n          if env._current_state.inventory[req_item_index] >= count:\n            break\n\n    return actions\n  \n  def ensure_facing_workshop(env, workshop_pos):\n    \"\"\"Ensures the agent is facing the correct direction towards the workshop.\"\"\"\n    current_pos = env._current_state.pos\n    dx = workshop_pos[0] - current_pos[0]\n    dy = workshop_pos[1] - current_pos[1]\n\n    actions = []\n\n    if dx < 0:          # Workshop is above\n        target_direction = (env.world.N_ACTIONS - 4)  # UP action\n    elif dx > 0:        # Workshop is below\n        target_direction = (env.world.N_ACTIONS - 3)  # DOWN action\n    else:\n        target_direction = env._current_state.dir\n\n    if dy < 0:          # Workshop is to the left\n        target_direction = (env.world.N_ACTIONS - 2)  # LEFT action\n    elif dy > 0:        # Workshop is to the right\n        target_direction = (env.world.N_ACTIONS - 5)  # RIGHT action\n\n    if env._current_state.dir != target_direction:\n      actions.append(target_direction)\n\n    return actions\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the goal item is a primitive or not in the recipes\n  if item_index in env.world.grabbable_indices:\n    return []  # Primitives cannot be crafted\n  \n  # Retrieve the recipe for the desired item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Determine the workshop required for crafting\n  workshop_key = \"_at\"\n  workshop_name = recipe.get(workshop_key)\n  if workshop_name is None:\n    raise ValueError(f\"No workshop specified for crafting {item}.\")\n  \n  workshop_index = env.world.cookbook.index[workshop_name]\n  workshop_pos = find_workshop_position(env, workshop_index)\n\n  # Determine the list of required primitives or intermediate items\n  required_items = {env.world.cookbook.index[key]: value for key, value in recipe.items() if not isinstance(key, str) or not key.startswith('_at')}\n\n  actions = []\n\n  # Collect all required items\n  actions.extend(collect_primitives(env, required_items))\n\n  # Navigate to the workshop and ensure correct facing direction\n  actions.extend(navigate_to_position(env, workshop_pos))\n  actions.extend(ensure_facing_workshop(env, workshop_pos))\n  \n  # Use the workshop to craft the item\n  actions.append(env.world.N_ACTIONS - 1)  # USE action\n  \n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T21:20:49.033516", "function_name": "craft", "function_body": "  # Retrieve the index for the desired item\n  item_idx = env.world.cookbook.index[item]\n  \n  # Retrieve the primitives required to craft the item\n  primitives_needed = env.world.cookbook.primitives_for(item_idx)\n  \n  actions = []\n  \n  # Check if we have all the required primitives in our inventory\n  for primitive, count in primitives_needed.items():\n    while env._current_state.inventory[primitive] < count:\n      # Need to collect more of this primitive\n      # Assuming that the function `collect` will handle the collection logic and return a list of actions\n      collect_actions = collect_v2(env, env.world.cookbook.index.get(env.world.cookbook.kinds[primitive]))\n      actions.extend(collect_actions)\n  \n  # Now we have all the required primitives, proceed to craft the item\n  workshop_idx = None\n  for recipe in env.world.cookbook.recipes.values():\n    if \"_at\" in recipe and recipe[\"_key\"] == item_idx:\n      workshop_name = recipe[\"_at\"]\n      workshop_idx = env.world.workshop_indices[env.world.cookbook.index[workshop_name]]\n      break\n  \n  # If the workshop is found, move to it\n  if workshop_idx is not None:\n    # Assuming that the function `move_to` will handle the movement logic and return a list of actions\n    move_actions = move_to_v2(env, workshop_idx)\n    actions.extend(move_actions)\n    \n    # Finally, perform the USE action at the workshop\n    actions.append(4)  # Assuming USE is represented by index 4\n  \n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-10T21:20:50.060628", "function_name": "craft", "function_body": "  # Step 1: Check if we have all the required primitives or items for crafting.\n  goal_index = env.world.cookbook.index[item]\n  \n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  actions = []\n\n  # Check if we have all the primitives and items in our inventory to craft the item\n  for ingredient, count in recipe.items():\n    if ingredient == '_at':\n      continue  # Skip the workshop information\n    \n    required_count = count\n    available_count = env._current_state.inventory[env.world.cookbook.index[ingredient]]\n    \n    if available_count < required_count:\n      return []  # Return empty list if we don't have all the required items\n\n  # Step 2: If we have all the ingredients, proceed to craft the item.\n  for ingredient, count in recipe.items():\n    if ingredient == '_at':\n      workshop = env.world.cookbook.index[ingredient]\n      continue  # Skip the workshop information\n    \n    required_count = count\n    available_count = env._current_state.inventory[env.world.cookbook.index[ingredient]]\n    \n    if available_count >= required_count:\n      actions.append(craft.CRAFT_FUNC(ingredient))\n  \n  # Step 3: Go to the specified workshop and use it.\n  workshop_index = env.world.cookbook.index[recipe['_at']]\n  workshop_position = None\n\n  # Find the position of the workshop in the grid\n  for x in range(env._current_state.grid.shape[0]):\n    for y in range(env._current_state.grid.shape[1]):\n      if np.any(env._current_state.grid[x, y, workshop_index] == 1):\n        workshop_position = (x, y)\n        break\n\n  if workshop_position is None:\n    return []  # Return empty list if the workshop is not found\n  \n  # Calculate actions to move to the workshop position\n  current_x, current_y = env._current_state.pos\n  target_x, target_y = workshop_position\n\n  while current_x != target_x or current_y != target_y:\n    if current_x < target_x:\n      actions.append(craft.MOVE_FUNC('RIGHT'))\n      current_x += 1\n    elif current_x > target_x:\n      actions.append(craft.MOVE_FUNC('LEFT'))\n      current_x -= 1\n    elif current_y < target_y:\n      actions.append(craft.MOVE_FUNC('DOWN'))\n      current_y += 1\n    elif current_y > target_y:\n      actions.append(craft.MOVE_FUNC('UP'))\n      current_y -= 1\n\n  # Add the USE action to craft the item at the workshop\n  actions.append(craft.USE_FUNC())\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-10T21:21:47.926575", "function_name": "craft", "function_body": "  # Initialize a queue for breadth-first search (BFS)\n  from collections import deque\n  queue = deque()\n  \n  # Get the index of the item to be crafted\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the prerequisites for crafting the item\n  recipe = env.world.cookbook.recipes.get(item_index, None)\n  if not recipe:\n    return []\n  \n  # Initialize actions list\n  actions = []\n  \n  # Check if all prerequisites are available in inventory\n  required_primitives = {env.world.cookbook.index[primitive]: count for primitive, count in recipe.items() if primitive != \"_key\"}\n  for primitive_index, count in required_primitives.items():\n    if env._current_state.inventory[primitive_index] < count:\n      return []\n  \n  # If all prerequisites are available, proceed to the workshop\n  workshop_key = recipe.get(\"_key\", None)\n  if not workshop_key:\n    return []\n  \n  workshop_index = env.world.cookbook.index[workshop_key]\n  workshop_pos = np.argwhere(env._current_state.grid[:, :, workshop_index])[0] # Assuming only one such workshop exists\n  \n  # Add actions to move the agent to the workshop\n  current_pos = np.array(env._current_state.pos)\n  target_pos = np.array(workshop_pos[:2])\n  \n  while not np.array_equal(current_pos, target_pos):\n    direction = np.sign(target_pos - current_pos)\n    \n    if direction[0] < 0:\n      actions.append(env.world.cookbook.index[\"LEFT\"])\n    elif direction[0] > 0:\n      actions.append(env.world.cookbook.index[\"RIGHT\"])\n    else:\n      if direction[1] < 0:\n        actions.append(env.world.cookbook.index[\"DOWN\"])\n      elif direction[1] > 0:\n        actions.append(env.world.cookbook.index[\"UP\"])\n    \n    current_pos += direction\n  \n  # Add action to use the workshop\n  actions.append(env.world.cookbook.index[\"USE\"])\n  \n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-10T21:21:48.906507", "function_name": "craft", "function_body": "  actions = []\n\n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the item has a recipe in the cookbook\n  if item_index not in env.world.cookbook.recipes:\n    print(f\"No recipe found for {item}.\")\n    return actions\n\n  # Get the ingredients required to craft the item\n  recipe = env.world.cookbook.recipes[item_index]\n  \n  # Collect all primitives required for the recipe\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  \n  # Check if we already have enough of each primitive in our inventory\n  for i_primitive, count in primitives_needed.items():\n    while env._current_state.inventory[i_primitive] < count:\n      actions.extend(collect(env, env.world.cookbook.index.get(i_primitive)))\n  \n  # Get the workshop where the item can be crafted\n  workshop_index = recipe[\"_key\"]\n  workshop_name = env.world.cookbook.index.get(workshop_index)\n  \n  # Move to the workshop\n  actions.extend(move_to_workshop(env, workshop_name))\n  \n  # Use action to craft the item\n  actions.append(craft.CRAFT_FUNC[workshop_name])\n  \n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-10T21:22:24.579568", "function_name": "craft", "function_body": "  actions = []\n  cookbook = env.world.cookbook\n  index = cookbook.index\n\n  # Get the recipe for the desired item\n  goal_index = index[item]\n  if goal_index not in cookbook.recipes:\n    return []  # No recipe available for this item\n\n  # Check if we have all primitives required for crafting\n  primitives_needed = cookbook.primitives_for(goal_index)\n  current_inventory = env._current_state.inventory\n  missing_primitives = {k: v - current_inventory[k] for k, v in primitives_needed.items() if v > current_inventory[k]}\n  \n  if missing_primitives:\n    return []  # We are missing some primitives\n\n  # Find the workshop to craft the item at\n  workshop_key = f\"_at\"\n  if workshop_key not in cookbook.recipes[goal_index]:\n    return []  # No specified workshop for this recipe\n  \n  workshop_name = cookbook.recipes[goal_index][workshop_key]\n  workshop_index = index[workshop_name]\n\n  # Move to the nearest workshop\n  actions.extend(move_to_workshop(env, workshop_index))\n\n  # Use action at the workshop\n  actions.append(env.world.cookbook.index[\"USE\"])\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-10T21:22:25.618110", "function_name": "craft", "function_body": "  # Fetch the index of the desired item from the cookbook\n  item_idx = env.world.cookbook.index[item]\n  \n  # Check if the item has a recipe in the cookbook\n  if item_idx not in env.world.cookbook.recipes:\n    return []\n\n  # Get the primitives required for crafting the item\n  primitives_required = env.world.cookbook.primitives_for(item_idx)\n\n  actions = []\n  \n  # Collect all the required primitives\n  for primitive, count in primitives_required.items():\n      actions.extend(collect(env, primitive))\n\n  # Now we have collected all the primitives. We need to go to the workshop specified in the recipe and perform USE action.\n  # Find the workshop index from the recipe.\n  workshop_name = env.world.cookbook.recipes[item_idx][\"_key\"]\n  workshop_idx = env.world.workshop_indices[env.world.cookbook.index[workshop_name]]\n\n  # Navigate to the workshop\n  actions.extend(move_to(env, workshop_idx))\n\n  # Perform USE action to craft the item\n  actions.append(env.world.n_actions - 1)  # Assuming the last action is the USE action\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-10T21:23:23.247916", "function_name": "craft", "function_body": "  # Step 1: Find out what primitives are needed for crafting the item.\n  goal_index = env.world.cookbook.index.index(item)\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n\n  actions_to_take = []\n\n  # Step 2: Collect all the necessary primitives if they are not already in inventory.\n  current_inventory = env._current_state.inventory\n  for primitive, count in required_primitives.items():\n    if current_inventory[primitive] < count:\n      # Need to collect more of this primitive\n      actions_to_take.extend(collect(env, primitive))\n\n  # Step 3: Go to the workshop and craft the item.\n  recipe = env.world.cookbook.recipes[goal_index]\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index.index(workshop_name)\n  \n  # Find the closest available workshop of the required type\n  workshops_of_type = [i for i, val in enumerate(env._current_state.grid[:, :, workshop_index]) if val == 1]\n  if not workshops_of_type:\n    return []  # No workshop found\n\n  # Sort workshops by distance to the current position\n  workshops_of_type.sort(key=lambda pos: np.linalg.norm(np.array(pos) - np.array(env._current_state.pos)))\n  closest_workshop = workshops_of_type[0]\n\n  # Navigate to the closest workshop.\n  path_to_workshop = astar_search(env, env._current_state.pos, closest_workshop)\n  actions_to_take.extend(path_to_workshop)\n\n  # Face the workshop\n  direction = get_direction_to_face(env._current_state.pos, closest_workshop)\n  actions_to_take.append(direction)\n\n  # Craft the item using USE action\n  actions_to_take.append(4)  # Assuming USE is represented by index 4\n\n  return actions_to_take", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-10T21:23:24.218772", "function_name": "craft", "function_body": "  # Initialize actions list\n  actions = []\n\n  # Get the index of the desired item\n  goal_index = env.world.cookbook.index[item]\n\n  # Check if we already have the item in inventory\n  if env._current_state.inventory[goal_index] > 0:\n      return actions\n\n  # Recursively get all primitives required to craft the item\n  def collect_primitives(env, goal_index):\n      primitives_needed = env.world.cookbook.primitives_for(goal_index)\n      for primitive_index, count in primitives_needed.items():\n          if env._current_state.inventory[primitive_index] < count:\n              actions_to_collect_primitive = collect(env, env.world.cookbook.index.get(primitive_index))\n              actions.extend(actions_to_collect_primitive)\n\n  # Collect all required primitives\n  collect_primitives(env, goal_index)\n  \n  # Move to the correct workshop and craft the item\n  recipe = env.world.cookbook.recipes[goal_index]\n  workshop_key = list(recipe.keys())[0] if \"_key\" in recipe else \"_at\"\n  workshop_name = recipe.get(workshop_key)\n  workshop_index = env.world.cookbook.index.get(workshop_name)\n\n  # Find the position of the desired workshop\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No {workshop_name} found in the environment.\")\n      \n  workshop_position = tuple(workshop_positions[0])\n  \n  # Move to the workshop position\n  actions.extend(move_to(env, workshop_position))\n  \n  # Use the USE action to craft the item\n  actions.append(craft.CRAFT_FUNC)\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-10T21:23:54.888578", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index for the goal item\n  item_index = env.world.cookbook.index.get(item)\n  \n  if not item_index:\n    raise ValueError(f\"Unknown item: {item}\")\n  \n  # Check primitives required to craft the goal\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n\n  inventory_dict = {env.world.cookbook.index.get(env.world.cookbook.index.reverse_contents[i]): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  # Check if all primitives are available\n  missing_primitives = []\n  for primitive, required_count in primitives_required.items():\n    if inventory_dict.get(primitive, 0) < required_count:\n      missing_primitives.append((primitive, required_count - inventory_dict.get(primitive, 0)))\n\n  if missing_primitives:\n    print(\"Missing primitives:\", missing_primitives)\n    return actions\n  \n  # Get the workshop where the item should be crafted\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_key = [key for key in recipe.keys() if key.startswith(\"_at\")][0]\n  workshop_name = recipe[workshop_key]\n  \n  # Find the position of the required workshop in the grid\n  workshop_indices = env.world.workshop_indices\n  workshop_index = env.world.cookbook.index.get(workshop_name)\n  \n  if not workshop_index:\n    raise ValueError(f\"Unknown workshop: {workshop_name}\")\n  \n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index])\n  \n  if len(workshop_positions) == 0:\n    print(\"Workshop not found in the grid.\")\n    return actions\n  \n  # Move to the closest workshop\n  current_pos = np.array(env._current_state.pos)\n  distances = np.linalg.norm(workshop_positions - current_pos, axis=1)\n  closest_workshop_position = tuple(workshop_positions[np.argmin(distances)])\n\n  actions.extend(move_to_position(env, closest_workshop_position))\n  \n  # Face the workshop\n  direction = face_direction(env, closest_workshop_position)\n\n  if direction is not None:\n    actions.append(direction)\n\n  # Use action to craft the item\n  actions.append(craft.CRAFT_FUNC(item_index))\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
