{"timestamp": "2025-09-10T19:01:04.927546", "function_name": "craft", "function_body": "  actions = []\n\n  # Get the index of the desired item from the cookbook index\n  goal_index = env.world.cookbook.index[item]\n\n  # Retrieve the primitives required for crafting the goal item\n  primitive_counts = env.world.cookbook.primitives_for(goal_index)\n\n  # Check if all required primitives are available in the inventory\n  have_all_primitives = True\n  for primitive, count in primitive_counts.items():\n    if env._current_state.inventory[primitive] < count:\n      have_all_primitives = False\n      break\n\n  # If not all primitives are available, return an empty action list\n  if not have_all_primitives:\n    return []\n\n  # Determine the workshop index for crafting the item based on the recipe\n  workshop_index = None\n  key_ingredient = env.world.cookbook.recipes[goal_index][\"_key\"]\n  try:\n      workshop_number = int(key_ingredient[-1])\n      workshop_index = env.world.workshop_indices[workshop_number]\n  except (KeyError, IndexError):\n      return []\n\n  # Locate the nearest available workshop of the required type\n  min_distance = float('inf')\n  target_workshop_pos = None\n\n  for y in range(env._current_state.grid.shape[0]):\n    for x in range(env._current_state.grid.shape[1]):\n        if env._current_state.grid[y, x, workshop_index] == 1:\n            distance = abs(y - env._current_state.pos[0]) + abs(x - env._current_state.pos[1])\n            if distance < min_distance:\n                min_distance = distance\n                target_workshop_pos = (y, x)\n\n  # If no suitable workshop is found, return an empty action list\n  if target_workshop_pos is None:\n    return []\n\n  # Navigate to the nearest workshop\n  actions.extend(navigate_to(env._current_state.pos, target_workshop_pos))\n\n  # Calculate and set the direction needed to face the workshop for crafting\n  direction = calculate_direction(env._current_state.pos, target_workshop_pos)\n  actions.append(direction)\n\n  # Perform the USE action to initiate crafting at the workshop\n  actions.append(craft.ACTION_USE)\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-10T19:04:32.292651", "function_name": "craft", "function_body": "  def _move_to_position(target_pos):\n    start = env._current_state.pos\n    open_set = collections.deque([start])\n    came_from = {}\n    direction_costs = {craft.UP: 1, craft.DOWN: 1, craft.LEFT: 1, craft.RIGHT: 1}\n\n    while open_set:\n        current = open_set.popleft()\n\n        if current == target_pos:\n            path = []\n            while current in came_from:\n                path.append(current)\n                current = came_from[current]\n            path.reverse()\n            actions = _convert_path_to_actions(path, start)\n            return actions\n\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            neighbor = (current[0] + dx, current[1] + dy)\n            if 0 <= neighbor[0] < env.world.WIDTH and 0 <= neighbor[1] < env.world.HEIGHT:\n                cost = direction_costs.get(env._current_state.dir, 1)\n                if neighbor not in came_from:\n                    came_from[neighbor] = current\n                    open_set.append(neighbor)\n\n    return []\n\n  def _convert_path_to_actions(path, start):\n      actions = []\n      cx, cy = start\n      \n      for x, y in path:\n          while cx != x or cy != y:\n              if cx < x:\n                  actions.append(craft.RIGHT)\n                  cx += 1\n              elif cx > x:\n                  actions.append(craft.LEFT)\n                  cx -= 1\n              if cy < y:\n                  actions.append(craft.DOWN)\n                  cy += 1\n              elif cy > y:\n                  actions.append(craft.UP)\n                  cy -= 1\n      \n      return actions\n\n  def _has_required_primitives(primitive_indices):\n      for i in primitive_indices:\n          if env._current_state.inventory[i] <= 0:\n              return False\n      return True\n  \n  index = env.world.cookbook.index\n  item_index = index[item]\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n\n  actions = []\n\n  # Check if the recipe exists and has a key\n  if \"_key\" in recipe:\n      key_index = recipe[\"_key\"]\n      workshop_index = env.world.workshop_indices[key_index]\n\n      # Collect all required primitives if not already in inventory\n      for primitive_index in [i for i in recipe if i != \"_key\"]:\n          while env._current_state.inventory[primitive_index] <= 0:\n              actions.extend(collect(env, index.get_by_value(primitive_index)))\n\n      # Find all positions of the required workshop\n      workshop_positions = []\n      for x in range(env.world.WIDTH):\n          for y in range(env.world.HEIGHT):\n              if np.any(env._current_state.grid[x, y] == workshop_index):\n                  workshop_positions.append((x, y))\n\n      if not workshop_positions:\n          return []  # No workshops found\n\n      # Move to the nearest workshop\n      actions_to_workshop = None\n      closest_distance = float('inf')\n\n      for wp in workshop_positions:\n          distance = abs(wp[0] - env._current_state.pos[0]) + abs(wp[1] - env._current_state.pos[1])\n          if distance < closest_distance:\n              actions_to_workshop = _move_to_position(wp)\n              closest_distance = distance\n\n      if not actions_to_workshop:\n          return []  # No path to any workshop found\n\n      # Ensure the agent is facing the correct direction to use the workshop\n      target_pos = None\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          neighbor_pos = (env._current_state.pos[0] + dx, env._current_state.pos[1] + dy)\n          if 0 <= neighbor_pos[0] < env.world.WIDTH and 0 <= neighbor_pos[1] < env.world.HEIGHT:\n              if np.any(env._current_state.grid[neighbor_pos[0], neighbor_pos[1]] == workshop_index):\n                  target_pos = neighbor_pos\n                  break\n\n      if not target_pos:\n          return []  # No valid target position found\n\n      direction_to_target = (target_pos[0] - env._current_state.pos[0], target_pos[1] - env._current_state.pos[1])\n\n      if direction_to_target == (-1, 0):\n          actions.append(craft.LEFT)\n      elif direction_to_target == (1, 0):\n          actions.append(craft.RIGHT)\n      elif direction_to_target == (0, -1):\n          actions.append(craft.UP)\n      elif direction_to_target == (0, 1):\n          actions.append(craft.DOWN)\n\n      # Finally, add the USE action\n      actions.extend(actions_to_workshop + [craft.USE])\n      return actions\n\n  else:\n      return []  # No recipe found for the item", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T19:04:33.420928", "function_name": "craft", "function_body": "  def _move_to_position(target_pos):\n    start = env._current_state.pos\n    open_set = collections.deque([start])\n    came_from = {}\n    direction_costs = {craft.UP: 1, craft.DOWN: 1, craft.LEFT: 1, craft.RIGHT: 1}\n\n    while open_set:\n        current = open_set.popleft()\n\n        if current == target_pos:\n            path = []\n            while current in came_from:\n                path.append(current)\n                current = came_from[current]\n            path.reverse()\n            actions = _convert_path_to_actions(path, start)\n            return actions\n\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            neighbor = (current[0] + dx, current[1] + dy)\n            if 0 <= neighbor[0] < env.world.WIDTH and 0 <= neighbor[1] < env.world.HEIGHT:\n                cost = direction_costs.get(env._current_state.dir, 1)\n                if neighbor not in came_from:\n                    came_from[neighbor] = current\n                    open_set.append(neighbor)\n\n    return []\n\n  def _convert_path_to_actions(path, start):\n      actions = []\n      cx, cy = start\n      \n      for x, y in path:\n          if cx < x:\n              actions.append(craft.RIGHT)\n          elif cx > x:\n              actions.append(craft.LEFT)\n          if cy < y:\n              actions.append(craft.DOWN)\n          elif cy > y:\n              actions.append(craft.UP)\n          cx, cy = x, y\n      \n      return actions\n\n  def _has_required_primitives(primitive_indices):\n      for i in primitive_indices:\n          if env._current_state.inventory[i] <= 0:\n              return False\n      return True\n  \n  index = env.world.cookbook.index\n  item_index = index[item]\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n\n  actions = []\n\n  # Check if the recipe exists and has a key\n  if \"_key\" in recipe:\n      key_index = recipe[\"_key\"]\n      workshop_index = env.world.workshop_indices[key_index]\n\n      # Collect all required primitives if not already in inventory\n      for primitive_index in [i for i in recipe if i != \"_key\"]:\n          while env._current_state.inventory[primitive_index] <= 0:\n              actions.extend(collect(env, index.get_by_value(primitive_index)))\n\n      # Find all positions of the required workshop\n      workshop_positions = []\n      for x in range(env.world.WIDTH):\n          for y in range(env.world.HEIGHT):\n              if np.any(env._current_state.grid[x, y] == workshop_index):\n                  workshop_positions.append((x, y))\n\n      if not workshop_positions:\n          return []  # No workshops found\n\n      # Move to the nearest workshop\n      actions_to_workshop = None\n      closest_distance = float('inf')\n\n      for wp in workshop_positions:\n          distance = abs(wp[0] - env._current_state.pos[0]) + abs(wp[1] - env._current_state.pos[1])\n          if distance < closest_distance:\n              actions_to_workshop = _move_to_position(wp)\n              closest_distance = distance\n\n      if not actions_to_workshop:\n          return []  # No path to any workshop found\n\n      # Ensure the agent is facing the correct direction to use the workshop\n      target_pos = None\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          neighbor_pos = (env._current_state.pos[0] + dx, env._current_state.pos[1] + dy)\n          if 0 <= neighbor_pos[0] < env.world.WIDTH and 0 <= neighbor_pos[1] < env.world.HEIGHT:\n              if np.any(env._current_state.grid[neighbor_pos[0], neighbor_pos[1]] == workshop_index):\n                  target_pos = neighbor_pos\n                  break\n\n      if not target_pos:\n          return []  # No valid target position found\n\n      direction_to_target = (target_pos[0] - env._current_state.pos[0], target_pos[1] - env._current_state.pos[1])\n\n      # Adjust the agent's direction to face the target\n      current_direction = env._current_state.dir\n      if direction_to_target == (-1, 0) and current_direction != craft.LEFT:\n          actions.append(craft.LEFT)\n      elif direction_to_target == (1, 0) and current_direction != craft.RIGHT:\n          actions.append(craft.RIGHT)\n      elif direction_to_target == (0, -1) and current_direction != craft.UP:\n          actions.append(craft.UP)\n      elif direction_to_target == (0, 1) and current_direction != craft.DOWN:\n          actions.append(craft.DOWN)\n\n      # Finally, add the USE action\n      actions.extend(actions_to_workshop + [craft.USE])\n      return actions\n\n  else:\n      return []  # No recipe found for the item", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T19:07:47.682635", "function_name": "craft", "function_body": "  def move_to(env, target_pos):\n    start = env._current_state.pos\n\n    def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n    open_set = collections.PriorityQueue()\n    open_set.put((0, start))\n    came_from = {}\n    g_score = {start: 0}\n\n    while not open_set.empty():\n        _, current = open_set.get()\n\n        if current == target_pos:\n            path = []\n            while current in came_from:\n                path.append(current)\n                current = came_from[current]\n            path.reverse()\n            actions = _convert_path_to_actions(path, start)\n            return actions\n\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            neighbor = (current[0] + dx, current[1] + dy)\n            if 0 <= neighbor[0] < env.world.WIDTH and 0 <= neighbor[1] < env.world.HEIGHT:\n                tentative_g_score = g_score[current] + 1\n                if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                    came_from[neighbor] = current\n                    g_score[neighbor] = tentative_g_score\n                    f_score = tentative_g_score + heuristic(neighbor, target_pos)\n                    open_set.put((f_score, neighbor))\n\n    return []\n\n  def _convert_path_to_actions(path, start):\n      actions = []\n      cx, cy = start\n      \n      for x, y in path:\n          if cx < x:\n              actions.append(craft.RIGHT)\n          elif cx > x:\n              actions.append(craft.LEFT)\n          if cy < y:\n              actions.append(craft.DOWN)\n          elif cy > y:\n              actions.append(craft.UP)\n          cx, cy = x, y\n      \n      return actions\n\n  def face_workshop(env, workshop_pos):\n    dx = workshop_pos[0] - env._current_state.pos[0]\n    dy = workshop_pos[1] - env._current_state.pos[1]\n\n    if abs(dx) > abs(dy):  # Prioritize horizontal movement\n        if dx > 0:\n            return craft.RIGHT\n        else:\n            return craft.LEFT\n    else:  # Vertical movement\n        if dy > 0:\n            return craft.DOWN\n        else:\n            return craft.UP\n\n  def collect(env, primitive):\n      # Get the index of the desired primitive\n      goal_index = env.world.cookbook.index[primitive]\n\n      actions = []\n\n      # Find all positions of the required primitive in the grid\n      pos = None\n      for y in range(env._current_state.grid.shape[0]):\n          for x in range(env._current_state.grid.shape[1]):\n              if np.any(env._current_state.grid[y, x] == goal_index):\n                  pos = (x, y)\n                  break\n          if pos is not None:\n              break\n      \n      # If no position found, return an empty action list\n      if pos is None:\n        return []\n      \n      # Calculate the actions needed to move to the primitive\n      current_pos = env._current_state.pos\n      actions.extend(move_to(env, pos))\n      \n      # Use the USE action to collect the primitive\n      actions.append(craft.USE)\n      \n      return actions\n\n  actions = []\n\n  # Get the index of the desired item\n  goal_index = env.world.cookbook.index[item]\n\n  # Check if we have all primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n\n  # If no recipe is found, return an empty action list\n  if not required_primitives:\n    return actions\n  \n  # Collect any missing primitives\n  for primitive_id, count in required_primitives.items():\n    if env._current_state.inventory[primitive_id] < count:\n      primitive_name = env.world.cookbook.index.get_by_value(primitive_id)\n      actions.extend(collect(env, primitive_name))\n  \n  # If we have all required primitives, proceed to craft the item\n  # Find the workshop where the item can be crafted\n  recipe = env.world.cookbook.recipes.get(goal_index)\n  if not recipe or \"_at\" not in recipe:\n    return []\n\n  workshop_key = recipe[\"_at\"]\n  workshop_id = env.world.cookbook.index[workshop_key]\n\n  # Find the position of the workshop in the grid\n  pos = None\n  for y in range(env._current_state.grid.shape[0]):\n      for x in range(env._current_state.grid.shape[1]):\n          if np.any(env._current_state.grid[y, x] == workshop_id):\n              pos = (x, y)\n              break\n      if pos is not None:\n          break\n  \n  # If no workshop found, return an empty action list\n  if pos is None:\n    return []\n  \n  # Calculate the actions needed to move to the workshop\n  current_pos = env._current_state.pos\n  actions.extend(move_to(env, pos))\n  \n  # Turn the agent to face the correct direction for crafting\n  actions.append(face_workshop(env, pos))\n  \n  # Use the USE action to craft the item at the workshop\n  actions.append(craft.USE)\n  \n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-10T19:07:48.662661", "function_name": "craft", "function_body": "  def _move_to_position(target_pos):\n    start = env._current_state.pos\n\n    def heuristic(a, b):\n        return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n    open_set = collections.PriorityQueue()\n    open_set.put((0, start))\n    came_from = {}\n    g_score = {start: 0}\n\n    while not open_set.empty():\n        _, current = open_set.get()\n\n        if current == target_pos:\n            path = []\n            while current in came_from:\n                path.append(current)\n                current = came_from[current]\n            path.reverse()\n            actions = _convert_path_to_actions(path, start)\n            return actions\n\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            neighbor = (current[0] + dx, current[1] + dy)\n            if 0 <= neighbor[0] < env.world.WIDTH and 0 <= neighbor[1] < env.world.HEIGHT:\n                tentative_g_score = g_score[current] + 1\n                if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                    came_from[neighbor] = current\n                    g_score[neighbor] = tentative_g_score\n                    f_score = tentative_g_score + heuristic(neighbor, target_pos)\n                    open_set.put((f_score, neighbor))\n\n    return []\n\n  def _convert_path_to_actions(path, start):\n      actions = []\n      cx, cy = start\n      \n      for x, y in path:\n          if cx < x:\n              actions.append(craft.RIGHT)\n          elif cx > x:\n              actions.append(craft.LEFT)\n          if cy < y:\n              actions.append(craft.DOWN)\n          elif cy > y:\n              actions.append(craft.UP)\n          cx, cy = x, y\n      \n      return actions\n\n  def face_workshop(env, workshop_pos):\n    dx = workshop_pos[0] - env._current_state.pos[0]\n    dy = workshop_pos[1] - env._current_state.pos[1]\n\n    if abs(dx) > abs(dy):  # Prioritize horizontal movement\n        if dx > 0:\n            return craft.RIGHT\n        else:\n            return craft.LEFT\n    else:  # Vertical movement\n        if dy > 0:\n            return craft.DOWN\n        else:\n            return craft.UP\n\n  def _has_required_primitives(primitive_indices):\n      for i in primitive_indices:\n          if env._current_state.inventory[i] <= 0:\n              return False\n      return True\n  \n  actions = []\n\n  # Get the index of the desired item\n  goal_index = env.world.cookbook.index[item]\n\n  # Check if we have all primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  \n  # If no recipe is found, return an empty action list\n  if not required_primitives:\n    return actions\n  \n  # Collect any missing primitives\n  collected_all_primitives = True\n  for primitive_id, count in required_primitives.items():\n    while env._current_state.inventory[primitive_id] < count:\n      collected_primitive_actions = collect(env, env.world.cookbook.index.get_by_value(primitive_id))\n      if not collected_primitive_actions:\n        collected_all_primitives = False\n        break\n      actions.extend(collected_primitive_actions)\n  \n  # If we couldn't collect all required primitives, return an empty action list\n  if not collected_all_primitives:\n    return []\n  \n  # If we have all required primitives, proceed to craft the item\n  # Find the workshop where the item can be crafted\n  recipe = env.world.cookbook.recipes.get(goal_index)\n  if not recipe or \"_at\" not in recipe:\n    return []\n\n  workshop_key = recipe[\"_at\"]\n  workshop_id = env.world.cookbook.index[workshop_key]\n\n  # Find the position of the workshop in the grid\n  pos = None\n  for y in range(env._current_state.grid.shape[0]):\n      for x in range(env._current_state.grid.shape[1]):\n          if np.any(env._current_state.grid[y, x] == workshop_id):\n              pos = (x, y)\n              break\n      if pos is not None:\n          break\n  \n  # If no workshop found, return an empty action list\n  if pos is None:\n    return []\n  \n  # Calculate the actions needed to move to the workshop\n  current_pos = env._current_state.pos\n  actions.extend(_move_to_position(pos))\n  \n  # Turn the agent to face the correct direction for crafting\n  actions.append(face_workshop(env, pos))\n  \n  # Use the USE action to craft the item at the workshop\n  actions.append(craft.USE)\n  \n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-10T19:08:52.092023", "function_name": "craft", "function_body": "  # Retrieve the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the item has a recipe in the cookbook\n  if item_index not in env.world.cookbook.recipes:\n    return []\n  \n  # Get the required ingredients and their counts for crafting the item\n  recipe = env.world.cookbook.recipes[item_index]\n  required_ingredients = {k: v for k, v in recipe.items() if k != \"_at\"}\n  \n  # Check if we have all the required primitives in our inventory\n  actions = []\n  current_inventory = env._current_state.inventory\n  \n  # Collect missing ingredients\n  for ingredient_index, count in required_ingredients.items():\n    ingredient_name = env.world.cookbook.index.get(ingredient_index)\n    \n    # If the ingredient is not in our inventory or we don't have enough of it, collect more\n    if current_inventory[ingredient_index] < count:\n      actions.extend(collect(env, ingredient_name))\n  \n  # Determine which workshop to go to for crafting\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n  \n  # Find the position of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  if len(workshop_positions) == 0:\n    return []  # No available workshop\n  \n  # Choose the closest workshop\n  current_pos = env._current_state.pos\n  distances = [np.linalg.norm(current_pos - pos, ord=1) for pos in workshop_positions]\n  closest_workshop_pos = workshop_positions[np.argmin(distances)]\n  \n  # Move to the closest workshop and face it\n  actions.extend(move_to_and_face(env, closest_workshop_pos))\n  \n  # Craft the item by using the USE action at the workshop\n  actions.append(craft.CRAFT_FUNC(item_index))\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-10T19:08:53.064548", "function_name": "craft", "function_body": "  # Convert item name to index\n  item_index = env.world.cookbook.index[item]\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n\n  # Check if the item has a recipe and collect required primitives\n  actions = []\n  if not recipe:\n    return actions\n\n  # Collect all required primitives or intermediate items\n  for ingredient, count in recipe.items():\n    if ingredient == \"_key\":  # Skip the key which specifies where to craft\n      continue\n    \n    ingredient_index = env.world.cookbook.index[ingredient]\n    while np.sum(env._current_state.inventory[ingredient_index]) < count:\n      collect_actions = collect_v2(env, ingredient)\n      actions.extend(collect_actions)\n\n  # Get the workshop index from the recipe key \"_key\"\n  workshop_name = recipe[\"_key\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Navigate to the workshop\n  navigate_actions = navigate_to_workshop(env, workshop_index)\n  actions.extend(navigate_actions)\n\n  # Use action at the workshop to craft the item\n  actions.append(craft.ACTION_USE)\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-10T19:11:17.132183", "function_name": "craft", "function_body": "  def navigate_to_position(target_pos):\n    pos = env._current_state.pos\n    actions = []\n    \n    while not np.array_equal(pos, target_pos):\n      dx = target_pos[0] - pos[0]\n      dy = target_pos[1] - pos[1]\n\n      if dx < 0:\n          actions.append(env.world.N_ACTIONS - 4)  # UP action\n          pos = (pos[0] - 1, pos[1])\n      elif dx > 0:\n          actions.append(env.world.N_ACTIONS - 3)  # DOWN action\n          pos = (pos[0] + 1, pos[1])\n\n      if dy < 0:\n          actions.append(env.world.N_ACTIONS - 2)  # LEFT action\n          pos = (pos[0], pos[1] - 1)\n      elif dy > 0:\n          actions.append(env.world.N_ACTIONS - 5)  # RIGHT action\n          pos = (pos[0], pos[1] + 1)\n\n    return actions\n\n  def find_item_positions(item_index):\n    grid = env._current_state.grid\n    return np.argwhere(grid[:, :, item_index] > 0).tolist()\n\n  def find_workshop_position(workshop_name):\n    workshop_index = env.world.cookbook.index[workshop_name]\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n    \n    if len(positions) == 0:\n      raise ValueError(f\"No available {workshop_name} to navigate to.\")\n    \n    return positions[0].tolist()\n\n  def collect_primitive(primitive_name, required_count):\n    primitive_index = env.world.cookbook.index[primitive_name]\n    \n    if primitive_index not in env.world.grabbable_indices:\n      raise ValueError(f\"{primitive_name} is not a grabbable item.\")\n\n    actions = []\n\n    while env._current_state.inventory[primitive_index] < required_count:\n      positions = find_item_positions(primitive_index)\n      \n      if not positions:\n        raise ValueError(f\"No available {primitive_name} to collect.\")\n      \n      closest_position = min(positions, key=lambda x: np.linalg.norm(np.array(x) - np.array(env._current_state.pos)))\n      actions.extend(navigate_to_position(closest_position))\n      \n      if env._current_state.next_to(primitive_index):\n        actions.append(env.world.N_ACTIONS - 1)  # USE action\n    \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n  \n  if item_index in env.world.grabbable_indices:\n    return []  # Primitives cannot be crafted\n  \n  recipe = env.world.cookbook.recipes[item_index]\n\n  workshop_name = None\n  for key, value in recipe.items():\n      if isinstance(key, str) and key.startswith('_at'):\n          workshop_name = value\n\n  if workshop_name is None:\n    raise ValueError(f\"No workshop specified for crafting {item}.\")\n\n  workshop_pos = find_workshop_position(workshop_name)\n\n  actions = []\n\n  for req_item_name, count in recipe.items():\n      if isinstance(req_item_name, str) and not req_item_name.startswith('_'):\n          actions.extend(collect_primitive(req_item_name, count))\n  \n  actions.extend(navigate_to_position(workshop_pos))\n\n  if env._current_state.next_to(workshop_index):\n    actions.append(env.world.N_ACTIONS - 1)  # USE action\n  else:\n    actions.extend(navigate_to_position(workshop_pos))\n\n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T19:11:18.187606", "function_name": "craft", "function_body": "  def navigate_to_position(env, target_pos):\n    pos = env._current_state.pos\n\n    actions = []\n    \n    while tuple(pos) != tuple(target_pos):\n      dx = target_pos[0] - pos[0]\n      dy = target_pos[1] - pos[1]\n\n      if dx < 0:\n          actions.append(env.world.N_ACTIONS - 4)  # UP action\n          pos = (pos[0] - 1, pos[1])\n      elif dx > 0:\n          actions.append(env.world.N_ACTIONS - 3)  # DOWN action\n          pos = (pos[0] + 1, pos[1])\n\n      if dy < 0:\n          actions.append(env.world.N_ACTIONS - 2)  # LEFT action\n          pos = (pos[0], pos[1] - 1)\n      elif dy > 0:\n          actions.append(env.world.N_ACTIONS - 5)  # RIGHT action\n          pos = (pos[0], pos[1] + 1)\n\n    return actions\n\n  def find_item_positions(env, item_index):\n    grid = env._current_state.grid\n    return np.argwhere(grid[:, :, item_index] > 0).tolist()\n\n  def find_workshop_position(env, workshop_name):\n    workshop_index = env.world.cookbook.index[workshop_name]\n    grid = env._current_state.grid\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n    \n    if len(positions) == 0:\n      raise ValueError(f\"No available {workshop_name} to navigate to.\")\n    \n    return positions[0].tolist()\n\n  def collect_primitive(env, primitive):\n    primitive_index = env.world.cookbook.index[primitive]\n    required_count = recipe.get(primitive, 0)\n    \n    while env._current_state.inventory[primitive_index] < required_count:\n      item_positions = find_item_positions(env, primitive_index)\n      \n      if not item_positions:\n        raise ValueError(f\"No available {primitive} to collect.\")\n      \n      closest_position = min(item_positions, key=lambda x: abs(x[0] - env._current_state.pos[0]) + abs(x[1] - env._current_state.pos[1]))\n      \n      actions.extend(navigate_to_position(env, closest_position))\n      if env._current_state.next_to(primitive_index):\n        actions.append(env.world.N_ACTIONS - 1)  # USE action\n    return []\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the goal item is a primitive or not in the recipes\n  if item_index in env.world.grabbable_indices:\n    return []  # Primitives cannot be crafted\n  \n  # Retrieve the recipe for the desired item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  actions = []\n\n  # Collect all required primitives or intermediate items\n  for req_item, count in recipe.items():\n      if isinstance(req_item, str) and not req_item.startswith('_'):\n          actions.extend(collect_primitive(env, req_item))\n      \n  # Determine the workshop required for crafting\n  workshop_key = \"_at\"\n  workshop_name = recipe.get(workshop_key)\n  \n  if workshop_name is None:\n    raise ValueError(f\"No workshop specified for crafting {item}.\")\n  \n  workshop_pos = find_workshop_position(env, workshop_name)\n\n  # Navigate to the workshop and use it to craft the item\n  actions.extend(navigate_to_position(env, workshop_pos))\n  actions.append(env.world.N_ACTIONS - 1)  # USE action\n  \n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T19:12:51.921946", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index of the item to be crafted\n  goal_idx = env.world.cookbook.index[item]\n  \n  # Check if the item can be crafted (has a recipe)\n  if goal_idx not in env.world.cookbook.recipes:\n    return actions\n  \n  # Get the primitives required for crafting the item\n  required_primitives = env.world.cookbook.primitives_for(goal_idx)\n\n  # Collect all required primitives\n  for prim_idx, count in required_primitives.items():\n      primitive_name = env.world.cookbook.index.get(prim_idx)\n      \n      # Find positions of the primitive in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, prim_idx] == 1)\n      \n      if len(primitive_positions) < count:\n          return actions\n      \n      for _ in range(count):\n          for pos in primitive_positions:\n              x, y = pos\n              \n              # Calculate the direction to face the primitive\n              dx, dy = x - env._current_state.pos[0], y - env._current_state.pos[1]\n              if dx == 0 and dy > 0: actions.append(env.N_ACTIONS.RIGHT) # Facing down\n              elif dx == 0 and dy < 0: actions.append(env.N_ACTIONS.LEFT) # Facing up\n              elif dx > 0 and dy == 0: actions.append(env.N_ACTIONS.DOWN) # Facing right\n              elif dx < 0 and dy == 0: actions.append(env.N_ACTIONS.UP) # Facing left\n\n              # Move towards the primitive\n              while env._current_state.pos[0] != x or env._current_state.pos[1] != y:\n                  if dx > 0:\n                      actions.append(env.N_ACTIONS.DOWN)\n                  elif dx < 0:\n                      actions.append(env.N_ACTIONS.UP)\n                  elif dy > 0:\n                      actions.append(env.N_ACTIONS.RIGHT)\n                  elif dy < 0:\n                      actions.append(env.N_ACTIONS.LEFT)\n\n              # Collect the primitive\n              actions.append(env.USE)\n\n  # Get the workshop index for crafting\n  workshop_idx = env.world.cookbook.recipes[goal_idx][\"_key\"]\n\n  # Find positions of the workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx] == 1)\n  \n  if len(workshop_positions) == 0:\n      return actions\n  \n  for pos in workshop_positions:\n      x, y = pos\n      \n      # Calculate the direction to face the workshop\n      dx, dy = x - env._current_state.pos[0], y - env._current_state.pos[1]\n      if dx == 0 and dy > 0: actions.append(env.N_ACTIONS.RIGHT) # Facing down\n      elif dx == 0 and dy < 0: actions.append(env.N_ACTIONS.LEFT) # Facing up\n      elif dx > 0 and dy == 0: actions.append(env.N_ACTIONS.DOWN) # Facing right\n      elif dx < 0 and dy == 0: actions.append(env.N_ACTIONS.UP) # Facing left\n\n      # Move towards the workshop\n      while env._current_state.pos[0] != x or env._current_state.pos[1] != y:\n          if dx > 0:\n              actions.append(env.N_ACTIONS.DOWN)\n          elif dx < 0:\n              actions.append(env.N_ACTIONS.UP)\n          elif dy > 0:\n              actions.append(env.N_ACTIONS.RIGHT)\n          elif dy < 0:\n              actions.append(env.N_ACTIONS.LEFT)\n\n      # Use the workshop to craft the item\n      actions.append(env.USE)\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-10T19:12:52.910015", "function_name": "craft", "function_body": "  index = env.world.cookbook.index\n  goal_index = index[item]\n  \n  # Get the recipe for the desired item\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  # Check if we have all the required ingredients in our inventory\n  actions_to_take = []\n  for ingredient, count in recipe.items():\n    if ingredient == \"_key\": \n      continue\n    ingredient_index = index.get(ingredient)\n    while env._current_state.inventory[ingredient_index] < count:\n      primitive_name = index.get(ingredient_index)\n      # Assuming we have a function `collect` that returns the actions needed to collect an item\n      actions_to_take.extend(collect_v2(env, primitive_name))\n    \n  # Move to the workshop specified in the recipe and perform the USE action\n  workshop_name = recipe[\"_key\"]\n  workshop_index = index[workshop_name]\n  \n  actions_to_take.extend(move_to_item(env, workshop_index))\n  actions_to_take.append(4)  # Assuming USE action is represented by 4\n  \n  return actions_to_take", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-10T19:13:52.755384", "function_name": "craft", "function_body": "  goal_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the required primitives and items for crafting\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n\n  current_inventory = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n\n  missing_items = {i: required_primitives[i] - current_inventory.get(i, 0) for i in required_primitives if required_primitives[i] > current_inventory.get(i, 0)}\n\n  actions = []\n\n  # If we have all the required items\n  if not missing_items:\n      # Find the workshop location\n      workshop_index = env.world.cookbook.recipes[goal_index][\"_key\"][-1]\n      \n      # Navigate to the workshop and face it\n      actions.extend(navigate_to_and_face(env, workshop_index))\n      \n      # Use the USE action to craft the item at the workshop\n      actions.append(craft.ACTION_USE)\n      \n      return actions\n\n  else:\n    # Collect missing items\n    for primitive_index in missing_items:\n        # Find the nearest position of the required primitive\n        target_primitive_pos = find_nearest(env._current_state.grid, primitive_index)\n\n        if target_primitive_pos is not None:\n            # Navigate to the nearest required primitive and face it\n            actions.extend(navigate_to_and_face(env, primitive_index))\n\n            # Use the USE action to collect the item\n            actions.append(craft.ACTION_USE)\n            \n    return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-10T19:13:53.795654", "function_name": "craft", "function_body": "  goal_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the required primitives and items for crafting\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n\n  current_inventory = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n\n  missing_items = {i: required_primitives[i] - current_inventory.get(i, 0) for i in required_primitives if required_primitives[i] > current_inventory.get(i, 0)}\n\n  actions = []\n\n  # If we have all the required items\n  if not missing_items:\n      # Find the workshop location\n      workshop_index = env.world.workshop_indices[env.world.cookbook.recipes[goal_index][\"_key\"][-1]]\n      \n      # Navigate to the workshop and face it\n      actions.extend(navigate_to_and_face(env, workshop_index))\n      \n      # Use the USE action to craft the item at the workshop\n      actions.append(env.ACTION_USE)\n      \n      return actions\n\n  else:\n    return []", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T19:16:35.353578", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n\n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = env._current_state.inventory.copy()\n\n  # Check if all ingredients are available\n  required_ingredients = {cookbook.index[k]: v for k, v in recipe.items()}\n\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if not can_craft:\n    return []\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No available workshop to craft item\")\n\n  # Select the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n  # Calculate actions to move the agent to the nearest workshop\n  dx = nearest_workshop_pos[0] - current_position[0]\n  dy = nearest_workshop_pos[1] - current_position[1]\n\n  actions_to_take = []\n\n  # Handle movement in x and y directions\n  if abs(dx) > abs(dy):\n    # Move along X axis first\n    move_action_x = craft.MOVE_RIGHT if dx > 0 else craft.MOVE_LEFT\n    actions_to_take.extend([move_action_x for _ in range(abs(dx))])\n\n    # Then move along Y axis\n    move_action_y = craft.MOVE_DOWN if dy > 0 else craft.MOVE_UP\n    actions_to_take.extend([move_action_y for _ in range(abs(dy))])\n  else:\n    # Move along Y axis first\n    move_action_y = craft.MOVE_DOWN if dy > 0 else craft.MOVE_UP\n    actions_to_take.extend([move_action_y for _ in range(abs(dy))])\n\n    # Then move along X axis\n    move_action_x = craft.MOVE_RIGHT if dx > 0 else craft.MOVE_LEFT\n    actions_to_take.extend([move_action_x for _ in range(abs(dx))])\n\n  # Determine the final direction needed based on the relative position of the workshop\n  current_direction = env._current_state.dir\n\n  # Calculate the number of turns needed to reach the final direction\n  target_direction = np.arctan2(nearest_workshop_pos[1] - current_position[1], nearest_workshop_pos[0] - current_position[0])\n  target_direction = (target_direction * 4 / (2 * np.pi) + 4) % 4\n\n  turns_needed = int((target_direction - current_direction) % 4)\n\n  if turns_needed == 1:\n    actions_to_take.append(craft.TURN_RIGHT)\n  elif turns_needed == 2:\n    actions_to_take.extend([craft.TURN_RIGHT, craft.TURN_RIGHT])\n  elif turns_needed == 3:\n    actions_to_take.append(craft.TURN_LEFT)\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
