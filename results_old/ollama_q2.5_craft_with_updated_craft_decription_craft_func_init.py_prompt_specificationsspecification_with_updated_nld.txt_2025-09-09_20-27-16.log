{"timestamp": "2025-09-10T20:20:30.194980", "function_name": "craft", "function_body": "  # Helper function to check if inventory contains required items\n  def has_required_items(recipe, inventory):\n      for ingredient, count in recipe.items():\n          if ingredient == '_key':\n              continue\n          if inventory[ingredient] < count:\n              return False\n      return True\n\n  # Fetch the item index from the name\n  item_index = env.world.cookbook.index[item]\n\n  # Get the required recipe\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n\n  # Check if we have all the required items in inventory\n  if not has_required_items(recipe, env._current_state.inventory):\n      return []\n\n  # Identify the workshop index and direction based on the recipe\n  workshop_key = recipe.get('_key')\n  workshop_index = None\n  if workshop_key:\n      workshop_name = workshop_key.split(':')[1]\n      for idx in env.world.workshop_indices:\n          if env.world.cookbook.index.get(env.world.cookbook.reverse_contents[idx]) == workshop_name:\n              workshop_index = idx\n              break\n\n  # If no valid workshop is found, return empty action list\n  if workshop_index is None:\n      return []\n\n  actions = []\n  \n  # Find the position of the nearest workshop\n  grid = env._current_state.grid\n  pos = np.array(env._current_state.pos)\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] > 0)\n  distances = np.linalg.norm(workshop_positions - pos, axis=1)\n  nearest_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n\n  # Add actions to move towards the nearest workshop\n  while tuple(pos) != nearest_workshop_pos:\n      delta_x = nearest_workshop_pos[0] - pos[0]\n      delta_y = nearest_workshop_pos[1] - pos[1]\n\n      if abs(delta_x) > abs(delta_y):\n          direction = env._current_state.dir\n          if delta_x > 0 and (direction == 2 or direction == 3):  # Facing left or right\n              actions.append(craft.LEFT if direction == 2 else craft.RIGHT)\n              actions.append(craft.USE)\n          elif delta_x < 0 and (direction == 2 or direction == 3):\n              actions.append(craft.RIGHT if direction == 2 else craft.LEFT)\n              actions.append(craft.USE)\n          else:\n              actions.append(craft.DOWN if delta_x > 0 else craft.UP)\n      else:\n          direction = env._current_state.dir\n          if delta_y > 0 and (direction == 0 or direction == 1):  # Facing up or down\n              actions.append(craft.UP if direction == 0 else craft.DOWN)\n              actions.append(craft.USE)\n          elif delta_y < 0 and (direction == 0 or direction == 1):\n              actions.append(craft.DOWN if direction == 0 else craft.UP)\n              actions.append(craft.USE)\n          else:\n              actions.append(craft.LEFT if delta_y > 0 else craft.RIGHT)\n\n      pos += np.array([delta_x // abs(delta_x) if delta_x != 0 else 0, \n                       delta_y // abs(delta_y) if delta_y != 0 else 0])\n\n  # Once at the workshop, perform the USE action\n  actions.append(craft.USE)\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-10T20:21:40.932118", "function_name": "craft", "function_body": "", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-10T20:21:41.903662", "function_name": "craft", "function_body": "  # Convert item name to its corresponding index in the cookbook\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the items/primitives required for crafting\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n\n  actions = []\n\n  # Collect missing primitives\n  for primitive, count in primitives_needed.items():\n    while env._current_state.inventory[primitive] < count:\n      collect_actions = collect_v1(env, env.world.cookbook.index.get(primitive))\n      actions.extend(collect_actions)\n      if len(actions) > 0:  # Check if the collected item is actually usable\n        reward, done, observations = env.step(actions[-1])\n        actions_to_take = []\n      else:\n        break\n\n    # Check if we have all primitives needed after collection\n    if not all(env._current_state.inventory[primitive] >= count for primitive in primitives_needed):\n      return []  # Not enough primitives collected, cannot proceed to crafting\n\n  # Move to the workshop and craft the item\n  if \"_at\" in env.world.cookbook.recipes[item_index]:\n    workshop_name = env.world.cookbook.recipes[item_index][\"_at\"]\n    workshop_index = getattr(env.world, f\"{workshop_name}_index\")\n    actions.extend(move_to_v1(env, workshop_index))\n    actions.append(craft.USE)  # Use action to craft the item\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-10T20:23:07.347979", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = env._current_state.inventory.copy()\n\n  # Check if all ingredients are available\n  required_ingredients = {cookbook.index[k]: v for k, v in recipe.items()}\n\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if not can_craft:\n    return []\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No available workshop to craft item\")\n\n  # Select the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n  # Calculate actions to move the agent to the nearest workshop\n  actions_to_take = calculate_movement_actions(env._current_state.pos, nearest_workshop_pos)\n\n  # Ensure facing the correct direction to use the workshop\n  current_direction = env._current_state.dir\n  required_direction = get_required_direction(current_position, nearest_workshop_pos)\n  \n  actions_to_take.extend(turn_towards_direction(current_direction, required_direction))\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T20:23:08.392639", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = env._current_state.inventory.copy()\n\n  # Check if all ingredients are available\n  required_ingredients = {cookbook.index[k]: v for k, v in recipe.items()}\n\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if not can_craft:\n    return []\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No available workshop to craft item\")\n\n  # Select the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n  # Calculate actions to move the agent to the nearest workshop\n  actions_to_take = calculate_movement_actions(env._current_state.pos, nearest_workshop_pos)\n\n  # Ensure facing the correct direction to use the workshop\n  current_direction = env._current_state.dir\n  required_direction = get_required_direction(current_position, nearest_workshop_pos)\n  \n  actions_to_take.extend(turn_towards_direction(current_direction, required_direction))\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T20:26:08.097047", "function_name": "craft", "function_body": "  def move_to(target_pos):\n    start = env._current_state.pos\n\n    def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n    open_set = collections.PriorityQueue()\n    open_set.put((0, start))\n    came_from = {}\n    g_score = {start: 0}\n\n    while not open_set.empty():\n        _, current = open_set.get()\n\n        if current == target_pos:\n            path = []\n            while current in came_from:\n                path.append(current)\n                current = came_from[current]\n            path.reverse()\n            actions = _convert_path_to_actions(path, start)\n            return actions\n\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            neighbor = (current[0] + dx, current[1] + dy)\n            if 0 <= neighbor[0] < env.world.WIDTH and 0 <= neighbor[1] < env.world.HEIGHT:\n                tentative_g_score = g_score[current] + 1\n                if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                    came_from[neighbor] = current\n                    g_score[neighbor] = tentative_g_score\n                    f_score = tentative_g_score + heuristic(neighbor, target_pos)\n                    open_set.put((f_score, neighbor))\n\n    return []\n\n  def _convert_path_to_actions(path, start):\n      actions = []\n      cx, cy = start\n      \n      for x, y in path:\n          if cx < x:\n              actions.append(craft.RIGHT)\n          elif cx > x:\n              actions.append(craft.LEFT)\n          if cy < y:\n              actions.append(craft.DOWN)\n          elif cy > y:\n              actions.append(craft.UP)\n          cx, cy = x, y\n      \n      return actions\n\n  def face_workshop(workshop_pos):\n    dx = workshop_pos[0] - env._current_state.pos[0]\n    dy = workshop_pos[1] - env._current_state.pos[1]\n\n    if abs(dx) > abs(dy):  # Prioritize horizontal movement\n        if dx > 0:\n            return craft.RIGHT\n        else:\n            return craft.LEFT\n    else:  # Vertical movement\n        if dy > 0:\n            return craft.DOWN\n        else:\n            return craft.UP\n\n  def find_workshops(workshop_id):\n      positions = []\n      for y in range(env._current_state.grid.shape[0]):\n          for x in range(env._current_state.grid.shape[1]):\n              if np.any(env._current_state.grid[y, x] == workshop_id):\n                  positions.append((x, y))\n      return positions\n\n  def has_required_primitives(primitive_indices):\n      for i, count in primitive_indices.items():\n          if env._current_state.inventory[i] < count:\n              return False\n      return True\n  \n  actions = []\n\n  # Get the index of the desired item\n  goal_index = env.world.cookbook.index[item]\n\n  # Check if we have all primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  \n  # If no recipe is found, return an empty action list\n  if not required_primitives:\n    return actions\n  \n  # Check the inventory to see if we have all required items\n  if not has_required_primitives(required_primitives):\n      return []\n\n  # Find the workshop where the item can be crafted\n  recipe = env.world.cookbook.recipes.get(goal_index)\n  if not recipe or \"_at\" not in recipe:\n    return []\n\n  workshop_key = recipe[\"_at\"]\n  workshop_id = env.world.cookbook.index[workshop_key]\n\n  # Find all positions of the workshop in the grid\n  workshop_positions = find_workshops(workshop_id)\n\n  # If no workshops found, return an empty action list\n  if not workshop_positions:\n    return []\n\n  # Calculate the actions needed to move to the nearest workshop\n  current_pos = env._current_state.pos\n  closest_workshop = min(workshop_positions, key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1]))\n  \n  # Move to the closest workshop\n  actions.extend(move_to(closest_workshop))\n  \n  # Turn the agent to face the correct direction for crafting\n  actions.append(face_workshop(closest_workshop))\n\n  # Use the USE action to craft the item at the workshop\n  actions.append(craft.USE)\n\n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T20:26:09.204857", "function_name": "craft", "function_body": "  def move_to(target_pos):\n    start = env._current_state.pos\n\n    def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n    open_set = collections.PriorityQueue()\n    open_set.put((0, start))\n    came_from = {}\n    g_score = {start: 0}\n\n    while not open_set.empty():\n        _, current = open_set.get()\n\n        if current == target_pos:\n            path = []\n            while current in came_from:\n                path.append(current)\n                current = came_from[current]\n            path.reverse()\n            actions = _convert_path_to_actions(path, start)\n            return actions\n\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            neighbor = (current[0] + dx, current[1] + dy)\n            if 0 <= neighbor[0] < env.world.WIDTH and 0 <= neighbor[1] < env.world.HEIGHT:\n                tentative_g_score = g_score[current] + 1\n                if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                    came_from[neighbor] = current\n                    g_score[neighbor] = tentative_g_score\n                    f_score = tentative_g_score + heuristic(neighbor, target_pos)\n                    open_set.put((f_score, neighbor))\n\n    return []\n\n  def _convert_path_to_actions(path, start):\n      actions = []\n      cx, cy = start\n      \n      for x, y in path:\n          if cx < x:\n              actions.append(craft.RIGHT)\n          elif cx > x:\n              actions.append(craft.LEFT)\n          if cy < y:\n              actions.append(craft.DOWN)\n          elif cy > y:\n              actions.append(craft.UP)\n          cx, cy = x, y\n      \n      return actions\n\n  def find_workshops(workshop_id):\n      positions = []\n      for y in range(env._current_state.grid.shape[0]):\n          for x in range(env._current_state.grid.shape[1]):\n              if np.any(env._current_state.grid[y, x] == workshop_id):\n                  positions.append((x, y))\n      return positions\n\n  def has_required_primitives(primitive_indices):\n      for i, count in primitive_indices.items():\n          if env._current_state.inventory[i] < count:\n              return False\n      return True\n  \n  actions = []\n\n  # Get the index of the desired item\n  goal_index = env.world.cookbook.index[item]\n\n  # Check if we have all primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  \n  # If no recipe is found, return an empty action list\n  if not required_primitives:\n    return actions\n  \n  # Check the inventory to see if we have all required items\n  if not has_required_primitives(required_primitives):\n      return []\n\n  # Find the workshop where the item can be crafted\n  recipe = env.world.cookbook.recipes.get(goal_index)\n  if not recipe or \"_at\" not in recipe:\n    return []\n\n  workshop_key = recipe[\"_at\"]\n  workshop_id = env.world.cookbook.index[workshop_key]\n\n  # Find all positions of the workshop in the grid\n  workshop_positions = find_workshops(workshop_id)\n\n  # If no workshops found, return an empty action list\n  if not workshop_positions:\n    return []\n\n  # Calculate the actions needed to move to the nearest workshop\n  current_pos = env._current_state.pos\n  closest_workshop = min(workshop_positions, key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1]))\n  \n  # Move to the closest workshop\n  actions.extend(move_to(closest_workshop))\n\n  # Use the USE action to craft the item at the workshop\n  actions.append(craft.USE)\n\n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T20:27:13.090663", "function_name": "craft", "function_body": "  # Get index of the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Get all primitives required to craft the item\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n\n  # Check if inventory has sufficient primitives\n  available_inventory = env._current_state.inventory.copy()\n  for primitive, count in required_primitives.items():\n    if available_inventory[primitive] < count:\n      return []  # Not enough primitives to craft the item\n\n  # Find the workshop that can be used to craft the item\n  workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n        workshop_key = recipe.get(\"_at\")\n        if workshop_key is not None:\n            workshop_index = getattr(env.world, f\"{workshop_key}_index\", None)\n            break\n\n  # If no suitable workshop is found, return an empty list\n  if workshop_index is None:\n      return []\n\n  actions = []\n  while True:\n    # Move to the nearest workshop that can craft the item\n    path_to_workshop = find_path(env._current_state.grid, env._current_state.pos, workshop_index)\n    actions.extend(path_to_workshop)\n\n    # Use the USE action at the workshop to attempt crafting the item\n    actions.append(4)  # Assuming USE is action index 4\n\n    # Check if the item has been crafted successfully\n    new_state = simulate_actions(env._current_state, actions)\n    if new_state.inventory[item_index] > 0:\n        return actions\n    else:\n        print(\"Crafting failed, retrying...\")\n        time.sleep(1)  # Add a delay before retrying", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T20:27:14.087829", "function_name": "craft", "function_body": "  # Convert the item name to its corresponding index\n  item_index = env.world.cookbook.index[item]\n\n  # Get all the primitives required to craft the item.\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n\n  # Check if we have all the required primitives in our inventory.\n  missing_primitives = []\n  for primitive, count in required_primitives.items():\n    if env._current_state.inventory[primitive] < count:\n      missing_primitives.append((primitive, count - env._current_state.inventory[primitive]))\n\n  # If there are any missing primitives, return an empty list or plan to collect them.\n  if missing_primitives:\n    actions_to_collect = []\n    for primitive, count in missing_primitives:\n        # Assuming a function `move_and_collect` exists that returns the path to collect the primitive\n        actions_to_primitive = move_and_collect(env._current_state.grid, env._current_state.pos, primitive)\n        actions_to_collect.extend(actions_to_primitive)\n    return actions_to_collect  # Return the actions to collect the missing primitives\n\n  # Find the workshop that can be used to craft the item.\n  workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n      if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n          workshop_key = recipe.get(\"_at\")\n          if workshop_key is not None:\n              workshop_index = getattr(env.world, f\"{workshop_key}_index\", None)\n              break\n\n  # If no suitable workshop is found, return an empty list.\n  if workshop_index is None:\n      return []\n\n  # Move to the nearest workshop\n  actions_to_workshop = move_and_use(env._current_state.grid, env._current_state.pos, workshop_index)\n\n  return actions_to_workshop", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-10T20:29:10.867001", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  # Check if we have all ingredients in inventory to craft this item\n  required_ingredients = {cookbook.index[k]: v for k, v in recipe.items() if k != \"_at\"}\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = env._current_state.inventory.copy()\n\n  # Check if all ingredients are available\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if not can_craft:\n    return []\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No available workshop to craft item\")\n\n  # Select the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n  # Calculate actions to move the agent to the nearest workshop\n  dx = nearest_workshop_pos[0] - current_position[0]\n  dy = nearest_workshop_pos[1] - current_position[1]\n\n  actions_to_take = []\n\n  def add_movement_actions(x_diff, y_diff):\n    if x_diff > 0:\n      actions_to_take.extend([craft.MOVE_RIGHT for _ in range(x_diff)])\n    elif x_diff < 0:\n      actions_to_take.extend([craft.MOVE_LEFT for _ in range(-x_diff)])\n\n    if y_diff > 0:\n      actions_to_take.extend([craft.MOVE_DOWN for _ in range(y_diff)])\n    elif y_diff < 0:\n      actions_to_take.extend([craft.MOVE_UP for _ in range(-y_diff)])\n\n  # Rotate the agent to face the workshop\n  def turn_to_face(target_x, target_y):\n    current_x, current_y = env._current_state.pos\n    dx = target_x - current_x\n    dy = target_y - current_y\n\n    if dx > 0:\n      target_direction = craft.RIGHT\n    elif dx < 0:\n      target_direction = craft.LEFT\n    else:  # No horizontal movement needed\n      if dy > 0:\n        target_direction = craft.DOWN\n      else:\n        target_direction = craft.UP\n\n    current_dir = env._current_state.dir\n    while current_dir != target_direction:\n      if (target_direction - current_dir) % 4 == 1 or (target_direction - current_dir) % 4 == -3:\n          actions_to_take.append(craft.TURN_RIGHT)\n          current_dir = (current_dir + 1) % 4\n      elif (target_direction - current_dir) % 4 == 2 or (target_direction - current_dir) % 4 == -2:\n          actions_to_take.append(craft.TURN_RIGHT)\n          current_dir = (current_dir + 1) % 4\n          actions_to_take.append(craft.TURN_RIGHT)\n          current_dir = (current_dir + 1) % 4\n      elif (target_direction - current_dir) % 4 == 3 or (target_direction - current_dir) % 4 == -1:\n          actions_to_take.append(craft.TURN_LEFT)\n          current_dir = (current_dir - 1) % 4\n\n  # Move to the workshop\n  add_movement_actions(dx, dy)\n\n  # Turn to face the workshop\n  turn_to_face(nearest_workshop_pos[0], nearest_workshop_pos[1])\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T20:29:11.926917", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n\n  item_index = cookbook.index[item]\n\n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  # Check if we have all ingredients in inventory to craft this item\n  required_ingredients = {cookbook.index[k]: v for k, v in recipe.items() if k != \"_at\"}\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = env._current_state.inventory.copy()\n\n  # Check if all ingredients are available\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if not can_craft:\n    return []\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No available workshop to craft item\")\n\n  # Select the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n  # Calculate actions to move the agent to the nearest workshop\n  def calculate_movement_actions(target_x, target_y):\n    dx = target_x - current_position[0]\n    dy = target_y - current_position[1]\n\n    actions_to_take = []\n\n    if dx > 0:\n      actions_to_take.extend([craft.MOVE_RIGHT for _ in range(dx)])\n    elif dx < 0:\n      actions_to_take.extend([craft.MOVE_LEFT for _ in range(-dx)])\n\n    if dy > 0:\n      actions_to_take.extend([craft.MOVE_DOWN for _ in range(dy)])\n    elif dy < 0:\n      actions_to_take.extend([craft.MOVE_UP for _ in range(-dy)])\n\n    return actions_to_take\n\n  # Rotate the agent to face the workshop\n  def calculate_turn_actions(target_x, target_y):\n    current_x, current_y = env._current_state.pos\n    dx = target_x - current_x\n    dy = target_y - current_y\n\n    if dx > 0:\n      target_direction = craft.RIGHT\n    elif dx < 0:\n      target_direction = craft.LEFT\n    else:  # No horizontal movement needed\n      if dy > 0:\n        target_direction = craft.DOWN\n      else:\n        target_direction = craft.UP\n\n    turn_actions = []\n\n    while env._current_state.dir != target_direction:\n      turn_actions.append(craft.TURN_RIGHT)\n      env._current_state.dir = (env._current_state.dir + 1) % 4\n\n    return turn_actions\n\n  # Calculate and append movement actions\n  actions_to_take.extend(calculate_movement_actions(nearest_workshop_pos[0], nearest_workshop_pos[1]))\n\n  # Calculate and append turn actions\n  actions_to_take.extend(calculate_turn_actions(nearest_workshop_pos[0], nearest_workshop_pos[1]))\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
