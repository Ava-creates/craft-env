{"timestamp": "2025-09-10T05:51:27.100718", "function_name": "craft", "function_body": "  def get_workshop_position(state, workshop_index):\n      workshop_indices = state.world.workshop_indices\n      if workshop_index >= len(workshop_indices):\n          return None\n      \n      for y in range(state.grid.shape[1]):\n          for x in range(state.grid.shape[0]):\n              if state.grid[x, y, workshop_indices[workshop_index]] == 1:\n                  return (x, y)\n      return None\n\n  def check_and_collect_primitives(state, recipe):\n      actions = []\n      for ingredient_name, count in recipe.items():\n          ingredient_idx = env.world.cookbook.index[ingredient_name]\n          while state.inventory[ingredient_idx] < count:\n              collect_actions = collect_v2(env, ingredient_name)\n              if not collect_actions:\n                  return [], False  # Could not collect the required primitive\n              actions.extend(collect_actions)\n          \n          if state.inventory[ingredient_idx] < count:\n              return [], False  # Could not collect all required primitives\n      return actions, True\n\n  def move_to(state, target_position):\n      actions = []\n      \n      def bfs(start, goal):\n          queue = collections.deque([(start, [])])\n          visited = set()\n          directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n          \n          while queue:\n              current_pos, path = queue.popleft()\n              \n              if current_pos == goal:\n                  return path\n              \n              if current_pos in visited:\n                  continue\n              visited.add(current_pos)\n              \n              for dx, dy in directions:\n                  next_x, next_y = current_pos[0] + dx, current_pos[1] + dy\n                  \n                  if (0 <= next_x < state.grid.shape[0]) and (0 <= next_y < state.grid.shape[1]):\n                      queue.append(((next_x, next_y), path + [move_to_direction(current_pos, (next_x, next_y))]))\n          \n          return []  # No path found\n\n      def move_to_direction(current_pos, target_pos):\n          dx = target_pos[0] - current_pos[0]\n          dy = target_pos[1] - current_pos[1]\n          \n          if dx > 0:\n              return 3  # RIGHT\n          elif dx < 0:\n              return 2  # LEFT\n          elif dy > 0:\n              return 1  # UP\n          else:\n              return 0  # DOWN\n\n      path = bfs(state.pos, target_position)\n      actions.extend(path)\n      return actions\n\n  actions = []\n  \n  # Get the index for the desired item from the cookbook\n  item_idx = env.world.cookbook.index[item]\n  \n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_idx, {})\n  \n  if not recipe:\n    return []  # No recipe found\n  \n  # Determine the workshop where the crafting should happen\n  workshop_key = \"_key\"\n  workshop_index = int(recipe.pop(workshop_key, -1))\n  \n  if workshop_index == -1:\n    return []  # Workshop not specified in the recipe\n\n  # Get the target position for the workshop\n  target_workshop_pos = get_workshop_position(env._current_state, workshop_index)\n  \n  if target_workshop_pos is None:\n    return []  # Workshop position not found in the grid\n\n  # Check and collect all required primitives\n  actions, success = check_and_collect_primitives(env._current_state, recipe)\n  \n  if not success:\n    return []  # Could not collect all required primitives\n  \n  # Move to the target workshop\n  actions.extend(move_to(env._current_state, target_workshop_pos))\n  \n  # Perform the USE action at the workshop\n  actions.append(4)  # USE action index\n\n  # Verify if item is crafted by checking inventory\n  if env._current_state.inventory[item_idx] == 0:\n    return []  # Crafting failed\n  \n  return actions", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T05:51:28.165668", "function_name": "craft", "function_body": "  def get_workshop_position(state, workshop_index):\n      workshop_indices = state.world.workshop_indices\n      if workshop_index >= len(workshop_indices):\n          return None\n      \n      for y in range(state.grid.shape[1]):\n          for x in range(state.grid.shape[0]):\n              if state.grid[x, y, workshop_indices[workshop_index]] == 1:\n                  return (x, y)\n      return None\n\n  def check_and_collect_primitives(state, recipe):\n      actions = []\n      for ingredient_name, quantity in recipe.items():\n          ingredient_idx = env.world.cookbook.index.get(ingredient_name, -1)\n          if ingredient_idx == -1:\n              continue\n          \n          while state.inventory[ingredient_idx] < quantity:\n              collect_actions = collect_v2(env, ingredient_name)\n              if not collect_actions:\n                  return [], False  # Could not collect the required primitive\n              actions.extend(collect_actions)\n              \n              # Check again after collecting to ensure we have enough\n              if state.inventory[ingredient_idx] < quantity:\n                  return [], False  # Could not collect all required primitives\n      \n      return actions, True\n\n  def move_to(state, target_position):\n      actions = []\n      # Simple BFS to find the path to the target position\n      queue = collections.deque([(state.pos, [])])\n      visited = set()\n      directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n      \n      while queue:\n          current_pos, path = queue.popleft()\n          \n          if current_pos == target_position:\n              return path\n          \n          if current_pos in visited:\n              continue\n          visited.add(current_pos)\n          \n          for dx, dy in directions:\n              next_x, next_y = current_pos[0] + dx, current_pos[1] + dy\n              \n              if (0 <= next_x < state.grid.shape[0]) and (0 <= next_y < state.grid.shape[1]):\n                  queue.append(((next_x, next_y), path + [move_to_direction(current_pos, (next_x, next_y))]))\n      \n      return []  # No path found\n\n  def move_to_direction(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n      \n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      else:\n          return 0  # DOWN\n\n  actions = []\n  \n  # Get the index for the desired item from the cookbook\n  item_idx = env.world.cookbook.index[item]\n  \n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_idx, {})\n  \n  if not recipe:\n    return []  # No recipe found\n  \n  # Determine the workshop where the crafting should happen\n  workshop_key = \"_key\"\n  workshop_index = int(recipe.pop(workshop_key, -1))\n  \n  if workshop_index == -1:\n    return []  # Workshop not specified in the recipe\n\n  # Get the target position for the workshop\n  target_workshop_pos = get_workshop_position(env._current_state, workshop_index)\n  \n  if target_workshop_pos is None:\n    return []  # Workshop position not found in the grid\n\n  # Check and collect all required primitives\n  actions, success = check_and_collect_primitives(env._current_state, recipe)\n  \n  if not success:\n    return []  # Could not collect all required primitives\n  \n  # Move to the target workshop\n  actions.extend(move_to(env._current_state, target_workshop_pos))\n  \n  # Perform the USE action at the workshop\n  actions.append(4)  # USE action index\n\n  return actions", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T05:53:29.193974", "function_name": "craft", "function_body": "  # Get the index for the desired item\n  i_goal = env.world.cookbook.index[item]\n  \n  if i_goal not in env.world.cookbook.recipes:\n    raise ValueError(f\"No recipe found for {item}.\")\n    \n  actions = []\n  \n  # Check if we have all required primitives and intermediate items\n  required_primitives = env.world.cookbook.primitives_for(i_goal)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory)}\n\n  # Check the availability of primitives\n  missing_items = []\n  for primitive, count_needed in required_primitives.items():\n    if inventory_dict.get(primitive, 0) < count_needed:\n      missing_items.append((primitive, count_needed - inventory_dict.get(primitive, 0)))\n\n  if missing_items:\n    return []  # Return empty list if any required item is missing\n\n  # Go to the workshop and craft the item\n  workshop_key = env.world.cookbook.recipes[i_goal][\"_key\"]\n  workshop_index = env.world.cookbook.index[workshop_key]\n  \n  # Find the position of the nearest workshop in the grid\n  grid_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if not grid_positions.size:\n    return []  # No workshops found\n\n  closest_workshop_pos = min(grid_positions, key=lambda x: np.linalg.norm(np.array(x) - np.array(env._current_state.pos)))\n  \n  # Move to the closest workshop\n  move_actions = move_to_position(env, env._current_state.pos, closest_workshop_pos)\n  actions.extend(move_actions)\n\n  # Orient towards the workshop and use it\n  face_direction = face_towards_position(env, env._current_state.pos, closest_workshop_pos)\n  if face_direction:\n    actions.append(face_direction)\n  \n  actions.append(4)  # USE action\n\n  return actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T05:53:30.208646", "function_name": "craft", "function_body": "  actions = []\n  # Get the index for the desired item\n  i_goal = env.world.cookbook.index[item]\n  \n  # Check if we have all required primitives in inventory\n  required_primitives = env.world.cookbook.primitives_for(i_goal)\n  current_inventory = env._current_state.inventory\n\n  # Verify if we have all necessary ingredients for crafting the item\n  have_all_required = True\n  for primitive_index, required_count in required_primitives.items():\n    if current_inventory[primitive_index] < required_count:\n      have_all_required = False\n      break\n  \n  if not have_all_required:\n    return []\n\n  # If we have all required ingredients, proceed to craft the item.\n  # Find out where this item is crafted (workshop index)\n  workshop_for_item = None\n  for output_index, recipe in env.world.cookbook.recipes.items():\n    if \"_at\" in recipe and output_index == i_goal:\n      workshop_for_item = recipe[\"_at\"]\n      break\n\n  if workshop_for_item is None:\n    return []\n\n  # Convert workshop name to index\n  workshop_index = env.world.cookbook.index[workshop_for_item]\n\n  # Get the position of the closest workshop from current state's grid.\n  # Use a simple BFS to find the nearest workshop\n  def bfs_find_nearest_workshop(grid, pos):\n    queue = collections.deque([pos])\n    visited = set()\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    while queue:\n      current_pos = queue.popleft()\n      if grid[current_pos] > 0 and grid[current_pos][workshop_index] == 1:\n        return current_pos\n      visited.add(current_pos)\n      for direction in directions:\n        new_pos = (current_pos[0] + direction[0], current_pos[1] + direction[1])\n        if 0 <= new_pos[0] < grid.shape[0] and 0 <= new_pos[1] < grid.shape[1]:\n          if new_pos not in visited:\n            queue.append(new_pos)\n    return None\n\n  closest_workshop = bfs_find_nearest_workshop(env._current_state.grid, env._current_state.pos)\n\n  # If no workshop is found, return empty action list\n  if closest_workshop is None:\n    return []\n\n  # Move towards the nearest workshop.\n  def move_towards_target(grid, current_pos, target_pos):\n    nonlocal actions\n    path = []\n    queue = collections.deque([current_pos])\n    visited = set()\n    parent = {}\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    while queue:\n      current = queue.popleft()\n      if current == target_pos:\n        break\n      for direction in directions:\n        new_pos = (current[0] + direction[0], current[1] + direction[1])\n        if grid[new_pos][env.world.non_grabbable_indices].sum() == 0:  # Check if the cell is not blocked by non-grabbables\n          if 0 <= new_pos[0] < grid.shape[0] and 0 <= new_pos[1] < grid.shape[1]:\n            if new_pos not in visited:\n              queue.append(new_pos)\n              visited.add(new_pos)\n              parent[new_pos] = current\n\n    # Trace back the path\n    while target_pos != current_pos:\n      path.append(parent[target_pos])\n      target_pos = parent[target_pos]\n\n    # Convert path to actions\n    for i in range(len(path) - 1):\n      dx, dy = path[i + 1][0] - path[i][0], path[i + 1][1] - path[i][1]\n      if dx == 1:\n        actions.append(env.world.action_specs()[DOWN])\n      elif dx == -1:\n        actions.append(env.world.action_specs()[UP])\n      elif dy == 1:\n        actions.append(env.world.action_specs()[RIGHT])\n      elif dy == -1:\n        actions.append(env.world.action_specs()[LEFT])\n\n  move_towards_target(env._current_state.grid, env._current_state.pos, closest_workshop)\n\n  # Once at the workshop, perform USE action to craft\n  actions.append(env.world.action_specs()[\"USE\"])\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-10T05:56:08.935023", "function_name": "craft", "function_body": "  def find_path(start, end, grid):\n    \"\"\"Find a path from start to end on the grid using BFS.\"\"\"\n    queue = collections.deque([(start, [])])\n    visited = set([start])\n    while queue:\n        (x, y), path = queue.popleft()\n        if (x, y) == end:\n            return path + [(x, y)]\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            nx, ny = x + dx, y + dy\n            if 0 <= nx < grid.shape[1] and 0 <= ny < grid.shape[0] and grid[ny, nx].sum() == 0 and (nx, ny) not in visited:\n                queue.append(((nx, ny), path + [(x, y)]))\n                visited.add((nx, ny))\n    return None\n\n  def move_towards(current_pos, target_pos):\n      \"\"\"Generate actions to move from current position to target position.\"\"\"\n      cx, cy = current_pos\n      tx, ty = target_pos\n      if cx < tx:\n          return [craft.CraftLab.ACTIONS['RIGHT']]\n      elif cx > tx:\n          return [craft.CraftLab.ACTIONS['LEFT']]\n      elif cy < ty:\n          return [craft.CraftLab.ACTIONS['DOWN']]\n      elif cy > ty:\n          return [craft.CraftLab.ACTIONS['UP']]\n      else:\n          return []\n\n  def face_direction(current_pos, target_pos):\n      \"\"\"Generate action to face the target position from current position.\"\"\"\n      cx, cy = current_pos\n      tx, ty = target_pos\n      if cx < tx:\n          return craft.CraftLab.ACTIONS['RIGHT']\n      elif cx > tx:\n          return craft.CraftLab.ACTIONS['LEFT']\n      elif cy < ty:\n          return craft.CraftLab.ACTIONS['DOWN']\n      elif cy > ty:\n          return craft.CraftLab.ACTIONS['UP']\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the primitives required to craft the desired item\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n  \n  # Initialize an empty list to store actions\n  actions = []\n  \n  # Check if we have all the primitives required in our inventory\n  for primitive_index, count in primitives_required.items():\n    if env._current_state.inventory[primitive_index] < count:\n      return []  # Return empty action list if any primitive is not sufficient\n\n  # If we have all primitives, proceed to craft the item\n  workshop_index = None\n  \n  # Find out which workshop is needed for crafting the desired item\n  for output_item, recipe in env.world.cookbook.recipes.items():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n      workshop_index = recipe.get(\"_at\", None)\n      break\n\n  if workshop_index is None:\n    return []  # Return empty action list if no workshop found for the desired item\n\n  # Find the position of the workshop on the grid\n  workshop_position = None\n  for y in range(env._current_state.grid.shape[0]):\n    for x in range(env._current_state.grid.shape[1]):\n      if env._current_state.grid[y, x, workshop_index] == 1:\n        workshop_position = (x, y)\n        break\n    if workshop_position:\n      break\n\n  if workshop_position is None:\n    return []  # Return empty action list if the workshop position not found\n\n  # Generate actions to move to the workshop\n  path_to_workshop = find_path(env._current_state.pos, workshop_position, env._current_state.grid)\n  \n  for pos in path_to_workshop[:-1]:\n      actions.extend(move_towards(env._current_state.pos, pos))\n      env._current_state.pos = pos\n\n  # Turn to face the workshop\n  actions.append(face_direction(env._current_state.pos, workshop_position))\n\n  # Perform the USE action to craft the item\n  actions.append(craft.CraftLab.ACTIONS['USE'])\n  \n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T05:56:10.042261", "function_name": "craft", "function_body": "  def find_path(start, end, grid):\n    \"\"\"Find a path from start to end on the grid using BFS.\"\"\"\n    queue = collections.deque([(start, [])])\n    visited = set()\n    while queue:\n        (x, y), path = queue.popleft()\n        if (x, y) == end:\n            return path + [(x, y)]\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            nx, ny = x + dx, y + dy\n            if 0 <= nx < grid.shape[1] and 0 <= ny < grid.shape[0] and grid[ny, nx].sum() == 0 and (nx, ny) not in visited:\n                queue.append(((nx, ny), path + [(x, y)]))\n                visited.add((nx, ny))\n    return None\n\n  def move_towards(current_pos, target_pos):\n      \"\"\"Generate actions to move from current position to target position.\"\"\"\n      cx, cy = current_pos\n      tx, ty = target_pos\n      actions = []\n      while (cx, cy) != (tx, ty):\n          if cx < tx:\n              actions.append(craft.CraftLab.ACTIONS['RIGHT'])\n              cx += 1\n          elif cx > tx:\n              actions.append(craft.CraftLab.ACTIONS['LEFT'])\n              cx -= 1\n          elif cy < ty:\n              actions.append(craft.CraftLab.ACTIONS['DOWN'])\n              cy += 1\n          elif cy > ty:\n              actions.append(craft.CraftLab.ACTIONS['UP'])\n              cy -= 1\n      return actions\n\n  def face_direction(current_pos, target_pos):\n      \"\"\"Generate action to face the target position from current position.\"\"\"\n      cx, cy = current_pos\n      tx, ty = target_pos\n      if cx < tx:\n          return craft.CraftLab.ACTIONS['RIGHT']\n      elif cx > tx:\n          return craft.CraftLab.ACTIONS['LEFT']\n      elif cy < ty:\n          return craft.CraftLab.ACTIONS['DOWN']\n      elif cy > ty:\n          return craft.CraftLab.ACTIONS['UP']\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the primitives required to craft the desired item\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n  \n  # Initialize an empty list to store actions\n  actions = []\n  \n  # Check if we have all the primitives required in our inventory\n  for primitive_index, count in primitives_required.items():\n    if env._current_state.inventory[primitive_index] < count:\n      return []  # Return empty action list if any primitive is not sufficient\n\n  # If we have all primitives, proceed to craft the item\n  workshop_index = None\n  \n  # Find out which workshop is needed for crafting the desired item\n  for output_item, recipe in env.world.cookbook.recipes.items():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n      workshop_index = recipe.get(\"_at\", None)\n      break\n\n  if workshop_index is None:\n    return []  # Return empty action list if no workshop found for the desired item\n\n  # Find the position of the workshop on the grid\n  workshop_position = None\n  for y in range(env._current_state.grid.shape[0]):\n    for x in range(env._current_state.grid.shape[1]):\n      if env._current_state.grid[y, x, workshop_index] == 1:\n        workshop_position = (x, y)\n        break\n    if workshop_position:\n      break\n\n  if workshop_position is None:\n    return []  # Return empty action list if the workshop position not found\n\n  # Generate actions to move to the workshop\n  path_to_workshop = find_path(env._current_state.pos, workshop_position, env._current_state.grid)\n  for pos in path_to_workshop[:-1]:\n      actions.extend(move_towards(current_pos=env._current_state.pos, target_pos=pos))\n      env._current_state.pos = pos\n\n  # Turn to face the workshop\n  actions.append(face_direction(env._current_state.pos, workshop_position))\n\n  # Perform the USE action to craft the item\n  actions.append(craft.CraftLab.ACTIONS['USE'])\n  \n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T05:57:25.209498", "function_name": "craft", "function_body": "  def find_closest_workshop(workshop_indices):\n    pos = env._current_state.pos\n    closest_workshop = None\n    min_distance = float('inf')\n    for workshop_index in workshop_indices:\n      for x in range(env.world.grid.shape[0]):\n        for y in range(env.world.grid.shape[1]):\n          if env._current_state.grid[x, y, workshop_index] > 0:\n            distance = abs(x - pos[0]) + abs(y - pos[1])\n            if distance < min_distance:\n              min_distance = distance\n              closest_workshop = (x, y)\n    return closest_workshop\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the desired item is a primitive; primitives cannot be crafted.\n  if item_index in env.world.cookbook.primitives:\n    return []\n\n  # Fetch the recipe for crafting the specified item.\n  recipe = env.world.cookbook.recipes.get(item_index)\n\n  # If no valid recipe exists or \"_key\" not specified, return an empty action list.\n  if not recipe or \"_key\" not in recipe:\n    return []\n\n  workshop_key = recipe[\"_key\"]\n  workshop_indices = [env.world.cookbook.index[workshop_key]]\n\n  actions = []\n  # Check inventory for sufficient primitives.\n  missing_ingredients = {}\n  for ingredient, count in recipe.items():\n    if ingredient == \"_key\":\n      continue\n    ingredient_index = env.world.cookbook.index[ingredient]\n    current_count = env._current_state.inventory[ingredient_index]\n    if current_count < count:\n      missing_ingredients[ingredient] = count - current_count\n\n  # If any ingredients are missing, attempt to collect them.\n  for ingredient, required_count in missing_ingredients.items():\n    ingredient_index = env.world.cookbook.index[ingredient]\n    actions.extend(collect_v2(env, ingredient, required_count))\n\n  # Find the closest workshop that can craft the item.\n  closest_workshop_pos = find_closest_workshop(workshop_indices)\n  if closest_workshop_pos is None:\n    return []\n\n  # Move to the closest workshop and align properly.\n  target_x, target_y = closest_workshop_pos\n  actions.extend(move_to_position_and_align(env._current_state.pos, (target_x, target_y), workshop_index))\n\n  # Use the USE action at the correct location.\n  actions.append(craft.ACTION_USE)\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T05:57:26.273398", "function_name": "craft", "function_body": "  def find_closest_workshop(workshop_indices):\n    pos = env._current_state.pos\n    closest_workshop = None\n    min_distance = float('inf')\n    for workshop_index in workshop_indices:\n      for x in range(env.world.grid.shape[0]):\n        for y in range(env.world.grid.shape[1]):\n          if env._current_state.grid[x, y, workshop_index] > 0:\n            distance = abs(x - pos[0]) + abs(y - pos[1])\n            if distance < min_distance:\n              min_distance = distance\n              closest_workshop = (x, y)\n    return closest_workshop\n\n  def move_to_position(current_pos, target_pos):\n    actions = []\n    cx, cy = current_pos\n    tx, ty = target_pos\n    while cx != tx or cy != ty:\n      if cx < tx:\n        actions.append(craft.ACTION_RIGHT)\n        cx += 1\n      elif cx > tx:\n        actions.append(craft.ACTION_LEFT)\n        cx -= 1\n      if cy < ty:\n        actions.append(craft.ACTION_DOWN)\n        cy += 1\n      elif cy > ty:\n        actions.append(craft.ACTION_UP)\n        cy -= 1\n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the target is a primitive resource.\n  if item_index in env.world.cookbook.primitives:\n    return []\n\n  recipe = env.world.cookbook.recipes.get(item_index)\n\n  if not recipe or \"_key\" not in recipe:\n    return []\n\n  workshop_key = recipe[\"_key\"]\n  workshop_indices = [env.world.cookbook.index[workshop_key]]\n\n  actions = []\n  \n  missing_ingredients = {}\n  for ingredient, count in recipe.items():\n    if ingredient == \"_key\":\n      continue\n    ingredient_index = env.world.cookbook.index[ingredient]\n    current_count = env._current_state.inventory[ingredient_index]\n    if current_count < count:\n      missing_ingredients[ingredient] = count - current_count\n\n  for ingredient, required_count in missing_ingredients.items():\n    ingredient_index = env.world.cookbook.index[ingredient]\n    actions.extend(collect_v3(env, ingredient, required_count))\n\n  closest_workshop_pos = find_closest_workshop(workshop_indices)\n  if closest_workshop_pos is None:\n    return []\n\n  target_x, target_y = closest_workshop_pos\n  actions.extend(move_to_position(env._current_state.pos, (target_x, target_y)))\n\n  # Align with the workshop before using it.\n  alignment_action = align_with_workshop(env, workshop_indices[0])\n  if alignment_action:\n    actions.append(alignment_action)\n\n  actions.append(craft.ACTION_USE)\n  \n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T05:58:22.626892", "function_name": "craft", "function_body": "  i_goal = env.world.cookbook.index[item]\n  \n  if i_goal not in env.world.cookbook.recipes:\n    raise ValueError(f\"No recipe found for {item}.\")\n    \n  actions = []\n  \n  # Check if we have all required primitives and intermediate items\n  required_primitives = env.world.cookbook.primitives_for(i_goal)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory)}\n\n  # Check the availability of primitives\n  missing_items = []\n  for primitive, count_needed in required_primitives.items():\n    if inventory_dict.get(primitive, 0) < count_needed:\n      missing_items.append((primitive, count_needed - inventory_dict.get(primitive, 0)))\n\n  if missing_items:\n    return []  # Return empty list if any required item is missing\n\n  # Go to the workshop and craft the item\n  workshop_key = env.world.cookbook.recipes[i_goal][\"_key\"]\n  workshop_index = env.world.cookbook.index[workshop_key]\n  \n  # Find the position of the nearest workshop in the grid\n  grid_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if not grid_positions.size:\n    return []  # No workshops found\n\n  closest_workshop_pos = min(grid_positions, key=lambda x: np.linalg.norm(np.array(x) - np.array(env._current_state.pos)))\n  \n  # Move to the closest workshop\n  move_actions = move_to_position(env, env._current_state.pos, closest_workshop_pos)\n  actions.extend(move_actions)\n\n  # Orient towards the workshop and use it\n  face_direction = face_towards_position(env, env._current_state.pos, closest_workshop_pos)\n  if face_direction:\n    actions.append(face_direction)\n  \n  actions.append(4)  # USE action\n\n  return actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T05:58:23.711990", "function_name": "craft", "function_body": "  i_goal = env.world.cookbook.index[item]\n  \n  if i_goal not in env.world.cookbook.recipes:\n    raise ValueError(f\"No recipe found for {item}.\")\n    \n  actions = []\n  \n  # Check if we have all required primitives and intermediate items\n  required_primitives = env.world.cookbook.primitives_for(i_goal)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory)}\n\n  # Check the availability of primitives\n  missing_items = []\n  for primitive, count_needed in required_primitives.items():\n    if inventory_dict.get(primitive, 0) < count_needed:\n      missing_items.append((primitive, count_needed - inventory_dict.get(primitive, 0)))\n\n  if missing_items:\n    return []  # Return empty list if any required item is missing\n\n  # Go to the workshop and craft the item\n  workshop_key = env.world.cookbook.recipes[i_goal][\"_key\"]\n  workshop_index = env.world.cookbook.index[workshop_key]\n  \n  # Find the position of the nearest workshop in the grid\n  grid_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if not grid_positions.size:\n    return []  # No workshops found\n\n  closest_workshop_pos = min(grid_positions, key=lambda x: np.linalg.norm(np.array(x) - np.array(env._current_state.pos)))\n  \n  # Move to the closest workshop\n  move_actions = move_to_position(env, env._current_state.pos, closest_workshop_pos)\n  actions.extend(move_actions)\n\n  # Orient towards the workshop and use it\n  face_direction = face_towards_position(env, env._current_state.pos, closest_workshop_pos)\n  if face_direction:\n    actions.append(face_direction)\n  \n  actions.append(4)  # USE action\n\n  return actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T05:59:48.664686", "function_name": "craft", "function_body": "  def find_workshop_for_item(item_idx):\n    # Find the workshop that can craft the item\n    for recipe in env.world.cookbook.recipes.values():\n      if \"_key\" in recipe and recipe[\"_key\"] == env.world.cookbook.index[item]:\n        return recipe.get(\"_at\", None)\n    return None\n\n  def get_primitive_counts(primitive_indices, inventory):\n    # Get the counts of primitives in the inventory\n    return {i: inventory[i] for i in primitive_indices}\n\n  def collect_primitives(primitive_indices, required_counts):\n    actions = []\n    for i in primitive_indices:\n      while inventory[i] < required_counts[i]:\n        primitive_name = env.world.cookbook.index.get(i)\n        actions.extend(collect(env, primitive_name))\n    return actions\n\n  def find_closest_workshop(workshop_idx):\n    from collections import deque\n    directions = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n    queue = deque([(env._current_state.pos, [])])\n    visited = set()\n    \n    while queue:\n      (x, y), path = queue.popleft()\n      if env._current_state.grid[x, y, workshop_idx] > 0:\n        return x, y\n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n          if (nx, ny) not in visited and env._current_state.grid[nx, ny].sum() == 0:\n            visited.add((nx, ny))\n            queue.append(((nx, ny), path + [(dx, dy)]))\n    return None\n\n  def navigate_to_position(position):\n    target_x, target_y = position\n    start_x, start_y = env._current_state.pos\n    \n    actions = []\n    while start_x != target_x or start_y != target_y:\n        if start_x < target_x:\n            actions.append(env.world.DOWN)\n        elif start_x > target_x:\n            actions.append(env.world.UP)\n        elif start_y < target_y:\n            actions.append(env.world.RIGHT)\n        elif start_y > target_y:\n            actions.append(env.world.LEFT)\n    \n    return actions\n\n  def use_action():\n    return env.world.USE\n\n  # Get the index of the item to craft\n  item_idx = env.world.cookbook.index[item]\n  \n  # Check if we have a recipe for this item\n  if item_idx not in env.world.cookbook.recipes:\n    return []\n  \n  # Get the ingredients required and their counts\n  ingredients = {k: v for k, v in env.world.cookbook.recipes[item_idx].items() if k != \"_at\"}\n  \n  # Find the workshop for crafting the item\n  workshop_name = find_workshop_for_item(item_idx)\n  if workshop_name is None:\n    return []\n  \n  # Find the index of the workshop in the environment\n  workshop_idx = env.world.workshop_indices[workshop_name]\n  \n  # Collect primitives required for crafting\n  actions = collect_primitives(list(ingredients.keys()), ingredients)\n  \n  # Navigate to the workshop and perform USE action\n  workshop_pos = find_closest_workshop(workshop_idx)\n  if not workshop_pos:\n    return []\n  \n  actions.extend(navigate_to_position(workshop_pos))\n  actions.append(use_action())\n  \n  return actions", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T05:59:49.774147", "function_name": "craft", "function_body": "  def find_workshop_for_item(item_idx):\n    # Find the workshop that can craft the item\n    for recipe in env.world.cookbook.recipes.values():\n      if \"_key\" in recipe and recipe[\"_key\"] == env.world.cookbook.index[item]:\n        return recipe.get(\"_at\", None)\n    return None\n\n  def collect_primitives(primitive_indices, required_counts):\n    actions = []\n    inventory = collections.defaultdict(int)\n    for i in primitive_indices:\n      while inventory[i] < required_counts[i]:\n        primitive_name = env.world.cookbook.index.get(i)\n        actions.extend(collect(env, primitive_name))\n        # Simulate picking up the item (this is a simplification)\n        inventory[i] += 1\n    return actions\n\n  def navigate_to_position(position):\n    target_x, target_y = position\n    start_x, start_y = env._current_state.pos\n    \n    actions = []\n    while start_x != target_x or start_y != target_y:\n        if start_x < target_x:\n            actions.append(env.world.DOWN)\n        elif start_x > target_x:\n            actions.append(env.world.UP)\n        elif start_y < target_y:\n            actions.append(env.world.RIGHT)\n        elif start_y > target_y:\n            actions.append(env.world.LEFT)\n    \n    return actions\n\n  def use_action():\n    return env.world.USE\n\n  # Get the index of the item to craft\n  item_idx = env.world.cookbook.index[item]\n  \n  # Check if we have a recipe for this item\n  if item_idx not in env.world.cookbook.recipes:\n    return []\n  \n  # Get the ingredients required and their counts\n  ingredients = {k: v for k, v in env.world.cookbook.recipes[item_idx].items() if k != \"_at\"}\n  \n  # Find the workshop for crafting the item\n  workshop_name = find_workshop_for_item(item_idx)\n  if workshop_name is None:\n    return []\n  \n  # Find the index of the workshop in the environment\n  workshop_idx = env.world.workshop_indices[workshop_name]\n  \n  # Collect primitives required for crafting\n  actions = collect_primitives(list(ingredients.keys()), ingredients)\n  \n  # Navigate to the workshop and perform USE action\n  workshop_pos = find_closest_workshop(env, workshop_idx)\n  if not workshop_pos:\n    return []\n  \n  actions.extend(navigate_to_position(workshop_pos))\n  actions.append(use_action())\n  \n  return actions", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T06:01:49.516596", "function_name": "craft", "function_body": "  def find_workshop_for_item(item_idx):\n      # Find the workshop that can craft the item\n      for recipe in env.world.cookbook.recipes.values():\n          if \"_key\" in recipe and recipe[\"_key\"] == item_idx:\n              return recipe.get(\"_at\", None)\n      return None\n\n  def collect_primitives(primitive_indices, required_counts):\n      actions = []\n      for i in primitive_indices:\n          while env._current_state.inventory[i] < required_counts[i]:\n              primitive_name = env.world.cookbook.index.get(i)\n              actions.extend(collect(env, primitive_name))\n      return actions\n\n  def find_closest_workshop(env, workshop_idx):\n      from collections import deque\n      \n      directions = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n      queue = deque([(env._current_state.pos, [])])\n      visited = set([env._current_state.pos])\n      \n      while queue:\n          (x, y), path = queue.popleft()\n          if env._current_state.grid[x, y, workshop_idx] > 0:\n              return x, y\n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              if (0 <= nx < env._current_state.grid.shape[0] and \n                  0 <= ny < env._current_state.grid.shape[1] and \n                  (nx, ny) not in visited):\n                  queue.append(((nx, ny), path + [(dx, dy)]))\n                  visited.add((nx, ny))\n      return None\n\n  def navigate_to_position(position):\n      target_x, target_y = position\n      start_x, start_y = env._current_state.pos\n      \n      actions = []\n      while start_x != target_x or start_y != target_y:\n          if start_x < target_x:\n              actions.append(env.ACTIONS.index(\"DOWN\"))\n          elif start_x > target_x:\n              actions.append(env.ACTIONS.index(\"UP\"))\n          if start_y < target_y:\n              actions.append(env.ACTIONS.index(\"RIGHT\"))\n          elif start_y > target_y:\n              actions.append(env.ACTIONS.index(\"LEFT\"))\n      return actions\n\n  def use_action():\n      return env.ACTIONS.index(\"USE\")\n\n  # Get the index of the item to craft\n  item_idx = env.world.cookbook.index[item]\n  \n  # Check if we have a recipe for this item\n  if item_idx not in env.world.cookbook.recipes:\n    return []\n  \n  # Get the ingredients required and their counts\n  ingredients = {k: v for k, v in env.world.cookbook.recipes[item_idx].items() if k != \"_at\"}\n  \n  # Find the workshop for crafting the item\n  workshop_name = find_workshop_for_item(item_idx)\n  if workshop_name is None:\n    return []\n  \n  # Find the index of the workshop in the environment\n  workshop_idx = env.world.workshop_indices[workshop_name]\n  \n  # Collect primitives required for crafting\n  actions = collect_primitives(list(ingredients.keys()), ingredients)\n  \n  # Navigate to the workshop and perform USE action\n  workshop_pos = find_closest_workshop(env, workshop_idx)\n  if not workshop_pos:\n    return []\n  \n  actions.extend(navigate_to_position(workshop_pos))\n  actions.append(use_action())\n  \n  return actions", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T06:01:50.683727", "function_name": "craft", "function_body": "  def find_workshop_for_item(item_idx):\n    # Find the workshop that can craft the item\n    for recipe in env.world.cookbook.recipes.values():\n      if \"_key\" in recipe and recipe[\"_key\"] == item_idx:\n        return recipe.get(\"_at\", None)\n    return None\n\n  def get_primitive_counts(primitive_indices, inventory):\n    # Get the counts of primitives in the inventory\n    return {i: inventory[i] for i in primitive_indices}\n\n  def collect_primitives(primitive_indices, required_counts):\n    actions = []\n    for i in primitive_indices:\n      while env._current_state.inventory[i] < required_counts[i]:\n        primitive_name = env.world.cookbook.index.get(i)\n        actions.extend(collect(env, primitive_name))\n    return actions\n\n  def find_closest_workshop(env, workshop_idx):\n    from collections import deque\n    \n    directions = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n    queue = deque([(env._current_state.pos, [])])\n    visited = set()\n    \n    while queue:\n        (x, y), path = queue.popleft()\n        if env._current_state.grid[x, y, workshop_idx] > 0 and env._current_state.next_to(workshop_idx):\n            return x, y\n        for dx, dy in directions:\n            nx, ny = x + dx, y + dy\n            if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n                if (nx, ny) not in visited and env._current_state.next_to(workshop_idx):\n                    visited.add((nx, ny))\n                    queue.append(((nx, ny), path + [(dx, dy)]))\n    return None\n\n  def navigate_to_position(position):\n      target_x, target_y = position\n      start_x, start_y = env._current_state.pos\n      \n      actions = []\n      while start_x != target_x or start_y != target_y:\n          if start_x < target_x:\n              actions.append(env.ACTIONS.index(\"DOWN\"))\n          elif start_x > target_x:\n              actions.append(env.ACTIONS.index(\"UP\"))\n          if start_y < target_y:\n              actions.append(env.ACTIONS.index(\"RIGHT\"))\n          elif start_y > target_y:\n              actions.append(env.ACTIONS.index(\"LEFT\"))\n      return actions\n\n  def use_action():\n      return env.ACTIONS.index(\"USE\")\n\n  # Get the index of the item to craft\n  item_idx = env.world.cookbook.index[item]\n  \n  # Check if we have a recipe for this item\n  if item_idx not in env.world.cookbook.recipes:\n    return []\n  \n  # Get the ingredients required and their counts\n  ingredients = {k: v for k, v in env.world.cookbook.recipes[item_idx].items() if k != \"_at\"}\n  \n  # Find the workshop for crafting the item\n  workshop_name = find_workshop_for_item(item_idx)\n  if workshop_name is None:\n    return []\n  \n  # Find the index of the workshop in the environment\n  workshop_idx = env.world.workshop_indices[workshop_name]\n  \n  # Collect primitives required for crafting\n  actions = collect_primitives(list(ingredients.keys()), ingredients)\n  \n  # Navigate to the workshop and perform USE action\n  workshop_pos = find_closest_workshop(env, workshop_idx)\n  if not workshop_pos:\n    return []\n  \n  actions.extend(navigate_to_position(workshop_pos))\n  actions.append(use_action())\n  \n  return actions", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T06:02:57.354727", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  index_of_item = env.world.cookbook.index[item]\n\n  # Check if the item has a recipe in the cookbook\n  if index_of_item not in env.world.cookbook.recipes:\n    print(f\"No recipe found for {item}.\")\n    return []\n\n  # Get the required primitives and their counts from the recipe\n  required_primitives = env.world.cookbook.recipes[index_of_item]\n\n  # Check if we have all the required primitives in our inventory\n  has_all_primitives = True\n  for primitive, count in required_primitives.items():\n    if primitive == \"_at\":\n      continue  # Skip the workshop location\n    index_of_primitive = env.world.cookbook.index[primitive]\n    if env._current_state.inventory[index_of_primitive] < count:\n      has_all_primitives = False\n      break\n\n  if not has_all_primitives:\n    print(f\"Missing primitives to craft {item}.\")\n    return []\n\n  # Find the workshop location from the recipe\n  workshop_location_name = required_primitives[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_location_name]\n\n  # Find the position of the workshop on the grid\n  workshop_position = None\n  for x in range(env._current_state.grid.shape[0]):\n    for y in range(env._current_state.grid.shape[1]):\n      if np.any(env._current_state.grid[x, y, :] == workshop_index):\n        workshop_position = (x, y)\n        break\n    if workshop_position:\n      break\n\n  if not workshop_position:\n    print(f\"Workshop {workshop_location_name} not found on the grid.\")\n    return []\n\n  # Calculate the path to the workshop\n  actions_to_workshop = calculate_path(env._current_state.pos, workshop_position)\n\n  # Append the USE action to craft the item at the workshop\n  actions_to_workshop.append(4)  # Use action\n\n  return actions_to_workshop", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-10T06:02:58.421346", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index for the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Retrieve the recipe for the desired item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n  \n  if not recipe:\n    print(f\"No recipe found for {item}.\")\n    return actions\n  \n  # Check if all primitives are available in inventory\n  required_primitives = recipe.copy()\n  del required_primitives[\"_at\"]\n  workshop_index = env.world.cookbook.index[recipe[\"_at\"]]\n  workshop_position = None\n\n  # Find the nearest workshop of the required type\n  for x in range(env._current_state.grid.shape[0]):\n    for y in range(env._current_state.grid.shape[1]):\n      if env._current_state.grid[x, y, workshop_index] == 1:\n        workshop_position = (x, y)\n        break\n    if workshop_position is not None:\n      break\n  \n  if workshop_position is None:\n    print(f\"No {recipe['_at']} found.\")\n    return actions\n\n  # Move to the nearest workshop\n  path_to_workshop = find_path(env._current_state.pos, workshop_position, env._current_state.grid)\n  actions.extend(path_to_workshop)\n\n  # Use action at the workshop\n  actions.append(4)  # USE action\n  \n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-10T06:04:06.974458", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n\n  # If the item is a primitive, return an empty action list since primitives cannot be crafted.\n  if item_index in env.world.cookbook.primitives:\n    return []\n\n  # Retrieve the recipe for crafting the specified item\n  recipe = env.world.cookbook.recipes.get(item_index)\n\n  # Ensure that the recipe exists and contains a \"_key\" indicating where to craft the item.\n  if not recipe or \"_key\" not in recipe:\n    return []\n\n  workshop_key = recipe[\"_key\"]\n  workshop_index = env.world.cookbook.index[workshop_key]\n\n  actions = []\n  \n  # Check inventory for missing ingredients\n  missing_ingredients = {}\n  for ingredient, count in recipe.items():\n    if ingredient == \"_key\":\n      continue\n    \n    ingredient_index = env.world.cookbook.index[ingredient]\n    current_count = env._current_state.inventory[ingredient_index]\n    \n    if current_count < count:\n      missing_ingredients[ingredient] = count - current_count\n\n  # If ingredients are required, collect them.\n  for ingredient, required_count in missing_ingredients.items():\n    ingredient_index = env.world.cookbook.index[ingredient]\n    actions.extend(collect_v3(env, ingredient, required_count))\n\n  # Move to the workshop\n  actions.extend(move_to_workshop(env, workshop_index))\n  \n  # Align with the workshop and use it.\n  alignment_action = align_with_workshop(env, workshop_index)\n  if alignment_action:\n    actions.append(alignment_action)\n\n  actions.append(craft.ACTION_USE)\n  \n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T06:04:08.097030", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n\n  # If the item is a primitive, return an empty action list since primitives cannot be crafted.\n  if item_index in env.world.cookbook.primitives:\n    return []\n\n  # Retrieve the recipe for crafting the specified item\n  recipe = env.world.cookbook.recipes.get(item_index)\n\n  # Ensure that the recipe exists and contains a \"_key\" indicating where to craft the item.\n  if not recipe or \"_key\" not in recipe:\n    return []\n\n  workshop_key = recipe[\"_key\"]\n  workshop_index = env.world.cookbook.index[workshop_key]\n\n  actions = []\n  \n  # Check inventory for missing ingredients\n  missing_ingredients = {}\n  for ingredient, count in recipe.items():\n    if ingredient == \"_key\":\n      continue\n    \n    ingredient_index = env.world.cookbook.index[ingredient]\n    current_count = env._current_state.inventory[ingredient_index]\n    \n    if current_count < count:\n      missing_ingredients[ingredient] = count - current_count\n\n  # If ingredients are required, collect them.\n  for ingredient, required_count in missing_ingredients.items():\n    ingredient_index = env.world.cookbook.index[ingredient]\n    actions.extend(collect_v2(env, ingredient, required_count))\n\n  # Move to the workshop\n  actions.extend(move_to_workshop(env, workshop_index))\n  \n  # Align with the workshop and use it.\n  alignment_action = align_with_workshop(env, workshop_index)\n  if alignment_action:\n    actions.append(alignment_action)\n\n  actions.append(craft.ACTION_USE)\n  \n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T06:06:41.730974", "function_name": "craft", "function_body": "  def move_to(state, target_pos):\n      current_pos = state.pos\n      x_diff = target_pos[0] - current_pos[0]\n      y_diff = target_pos[1] - current_pos[1]\n\n      actions = []\n      if x_diff > 0:\n          actions.extend([3] * x_diff)  # RIGHT\n      elif x_diff < 0:\n          actions.extend([2] * abs(x_diff))  # LEFT\n\n      if y_diff > 0:\n          actions.extend([1] * y_diff)  # UP\n      elif y_diff < 0:\n          actions.extend([0] * abs(y_diff))  # DOWN\n      \n      return actions\n\n  def get_closest_position(state, ingredient_idx):\n      positions = np.argwhere(state.grid[:, :, ingredient_idx] == 1)\n      if len(positions) == 0:\n          return None\n      \n      current_pos = np.array(state.pos)\n      distances = np.linalg.norm(current_pos - positions, axis=1)\n      closest_index = np.argmin(distances)\n      \n      return tuple(positions[closest_index])\n\n  def collect_ingredient(name: str):\n    ingredient_idx = env.world.cookbook.index[name]\n    \n    if env._current_state.inventory[ingredient_idx] > 0:\n        return []\n    \n    closest_position = get_closest_position(env._current_state, ingredient_idx)\n    if closest_position is None:\n        return []  # Ingredient not found in the grid\n    \n    actions = move_to(env._current_state, closest_position)\n    actions.append(4)  # USE action index\n    \n    return actions\n\n  def get_workshop_position(state, workshop_index):\n      workshop_indices = state.world.workshop_indices\n      \n      if workshop_index >= len(workshop_indices):\n          return None\n      \n      for y in range(state.grid.shape[1]):\n          for x in range(state.grid.shape[0]):\n              if state.grid[x, y, workshop_indices[workshop_index]] == 1:\n                  return (x, y)\n      \n      return None\n\n  actions = []\n  \n  # Get the index for the desired item from the cookbook\n  item_idx = env.world.cookbook.index[item]\n  \n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_idx, {})\n  \n  if not recipe:\n    return []  # No recipe found\n  \n  # Determine the workshop where the crafting should happen\n  workshop_key = \"_key\"\n  workshop_index = int(recipe.pop(workshop_key, -1))\n  \n  if workshop_index == -1:\n    return []  # Workshop not specified in the recipe\n\n  # Get the target position for the workshop\n  target_workshop_pos = get_workshop_position(env._current_state, workshop_index)\n  \n  if target_workshop_pos is None:\n    return []  # Workshop position not found in the grid\n\n  # Collect all required primitives\n  for ingredient_idx, count in recipe.items():\n      ingredient_name = env.world.cookbook.index.get(ingredient_idx)\n      \n      while env._current_state.inventory[ingredient_idx] < count:\n          actions.extend(collect_ingredient(ingredient_name))\n          \n          if env._current_state.inventory[ingredient_idx] < count:\n              return []  # Could not collect all required primitives\n  \n  # Move to the target workshop\n  actions.extend(move_to(env._current_state, target_workshop_pos))\n  \n  # Perform the USE action at the workshop\n  actions.append(4)  # USE action index\n  \n  return actions", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T06:06:42.871483", "function_name": "craft", "function_body": "  def get_closest_position(state, ingredient_idx):\n      positions = np.argwhere(state.grid[:, :, ingredient_idx] == 1)\n      if len(positions) == 0:\n          return None\n      \n      current_pos = np.array(state.pos)\n      distances = np.linalg.norm(current_pos - positions, axis=1)\n      closest_index = np.argmin(distances)\n      \n      return tuple(positions[closest_index])\n\n  def collect_ingredient(name: str):\n    ingredient_idx = env.world.cookbook.index[name]\n    \n    if env._current_state.inventory[ingredient_idx] > 0:\n        return []\n    \n    closest_position = get_closest_position(env._current_state, ingredient_idx)\n    if closest_position is None:\n        return []  # Ingredient not found in the grid\n    \n    actions = move_to(env._current_state, closest_position)\n    actions.append(4)  # USE action index\n    \n    return actions\n\n  def move_to(state, target_pos):\n      current_pos = state.pos\n      x_diff = target_pos[0] - current_pos[0]\n      y_diff = target_pos[1] - current_pos[1]\n\n      actions = []\n      if x_diff > 0:\n          actions.extend([3] * x_diff)  # RIGHT\n      elif x_diff < 0:\n          actions.extend([2] * abs(x_diff))  # LEFT\n\n      if y_diff > 0:\n          actions.extend([1] * y_diff)  # UP\n      elif y_diff < 0:\n          actions.extend([0] * abs(y_diff))  # DOWN\n      \n      return actions\n\n  def get_workshop_position(state, workshop_index):\n      workshop_indices = state.world.workshop_indices\n      \n      if workshop_index >= len(workshop_indices):\n          return None\n      \n      for y in range(state.grid.shape[1]):\n          for x in range(state.grid.shape[0]):\n              if state.grid[x, y, workshop_indices[workshop_index]] == 1:\n                  return (x, y)\n      \n      return None\n\n  def check_and_collect_primitives(state, recipe):\n      actions = []\n      for ingredient_idx, count in recipe.items():\n          ingredient_name = env.world.cookbook.index.get(ingredient_idx)\n          \n          while state.inventory[ingredient_idx] < count:\n              collect_actions = collect_ingredient(ingredient_name)\n              if not collect_actions:\n                  return [], False\n              actions.extend(collect_actions)\n              \n              # Update the current state after collecting ingredients\n              _, _, observations = env.step(actions[-1])\n              state.grid = observations['grid']\n              state.inventory = observations['inventory']\n\n          if state.inventory[ingredient_idx] < count:\n              return [], False  # Could not collect all required primitives\n      \n      return actions, True\n\n  actions = []\n  \n  # Get the index for the desired item from the cookbook\n  item_idx = env.world.cookbook.index[item]\n  \n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_idx, {})\n  \n  if not recipe:\n    return []  # No recipe found\n  \n  # Determine the workshop where the crafting should happen\n  workshop_key = \"_key\"\n  workshop_index = int(recipe.pop(workshop_key, -1))\n  \n  if workshop_index == -1:\n    return []  # Workshop not specified in the recipe\n\n  # Get the target position for the workshop\n  target_workshop_pos = get_workshop_position(env._current_state, workshop_index)\n  \n  if target_workshop_pos is None:\n    return []  # Workshop position not found in the grid\n\n  # Collect all required primitives\n  actions, success = check_and_collect_primitives(env._current_state, recipe)\n  \n  if not success:\n    return []  # Could not collect all required primitives\n  \n  # Move to the target workshop\n  actions.extend(move_to(env._current_state, target_workshop_pos))\n  \n  # Perform the USE action at the workshop\n  actions.append(4)  # USE action index\n  \n  return actions", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T06:07:48.860520", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n  \n  # Primitives cannot be crafted; return an empty action list if the item is a primitive.\n  if item_index in env.world.cookbook.primitives:\n    return []\n  \n  # Retrieve the recipe for crafting the specified item from the cookbook.\n  recipe = env.world.cookbook.recipes.get(item_index)\n  \n  # If no valid recipe exists or \"_key\" not specified, return an empty action list.\n  if not recipe or \"_key\" not in recipe:\n    return []\n\n  workshop_key = recipe[\"_key\"]\n  workshop_index = env.world.cookbook.index[workshop_key]\n\n  actions = []\n  \n  # Check the current inventory for required ingredients and identify any missing ones.\n  missing_ingredients = {}\n  for ingredient, count in recipe.items():\n    if ingredient == \"_key\":\n      continue\n    ingredient_index = env.world.cookbook.index[ingredient]\n    current_count = env._current_state.inventory[ingredient_index]\n    if current_count < count:\n      missing_ingredients[ingredient] = count - current_count\n\n  # Collect any required ingredients that are not in the inventory.\n  for ingredient, required_count in missing_ingredients.items():\n    ingredient_index = env.world.cookbook.index[ingredient]\n    actions.extend(collect_v3(env, ingredient, required_count))\n\n  # Move towards a workshop specified in the recipe.\n  actions.extend(move_to_workshop(env, workshop_index))\n  \n  # Ensure correct alignment before using the USE action at the workshop.\n  align_action = align_with_workshop(env, workshop_index)\n  if align_action:\n      actions.append(align_action)\n\n  # Use the USE action at the correct location to craft the item.\n  actions.append(craft.ACTION_USE)\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T06:07:49.952184", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n\n  if item_index in env.world.cookbook.primitives:\n    return []\n\n  recipe = env.world.cookbook.recipes.get(item_index)\n\n  if not recipe or \"_key\" not in recipe:\n    return []\n\n  workshop_key = recipe[\"_key\"]\n  workshop_index = env.world.cookbook.index[workshop_key]\n\n  actions = []\n  \n  missing_ingredients = {}\n  for ingredient, count in recipe.items():\n    if ingredient == \"_key\":\n      continue\n    ingredient_index = env.world.cookbook.index[ingredient]\n    current_count = env._current_state.inventory[ingredient_index]\n    if current_count < count:\n      missing_ingredients[ingredient] = count - current_count\n\n  for ingredient, required_count in missing_ingredients.items():\n    ingredient_index = env.world.cookbook.index[ingredient]\n    actions.extend(collect_v3(env, ingredient, required_count))\n\n  # Move towards the workshop and align with it.\n  workshop_actions = move_and_align_with_workshop(env, workshop_index)\n  if workshop_actions:\n    actions.extend(workshop_actions)\n\n  actions.append(craft.ACTION_USE)\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T06:09:21.713013", "function_name": "craft", "function_body": "  i_goal = env.world.cookbook.index[item]\n  \n  if i_goal not in env.world.cookbook.recipes:\n    raise ValueError(f\"No recipe found for {item}.\")\n    \n  actions = []\n  \n  # Check if we have all required primitives and intermediate items\n  required_primitives = env.world.cookbook.primitives_for(i_goal)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory)}\n\n  # Collect missing primitives\n  missing_items = []\n  for primitive, count_needed in required_primitives.items():\n    if inventory_dict.get(primitive, 0) < count_needed:\n      missing_items.append((primitive, count_needed - inventory_dict.get(primitive, 0)))\n\n  if missing_items:\n    # Attempt to collect each missing item\n    for primitive, count_needed in missing_items:\n        actions.extend(collect(env, primitive, count=count_needed))\n    \n    # Recheck inventory after collecting items\n    inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory)}\n    still_missing = any(inventory_dict.get(primitive, 0) < count_needed for primitive, count_needed in required_primitives.items())\n    \n    if still_missing:\n        return []  # Return empty list if any required item is still missing\n  \n  # Go to the workshop and craft the item\n  workshop_key = env.world.cookbook.recipes[i_goal][\"_key\"]\n  workshop_index = env.world.cookbook.index[workshop_key]\n  \n  # Find the position of the nearest workshop in the grid\n  grid_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if not grid_positions.size:\n    return []  # No workshops found\n\n  closest_workshop_pos = min(grid_positions, key=lambda x: np.linalg.norm(np.array(x) - np.array(env._current_state.pos)))\n  \n  # Move to the closest workshop\n  move_actions = move_to_position(env, env._current_state.pos, closest_workshop_pos)\n  actions.extend(move_actions)\n\n  # Orient towards the workshop and use it\n  face_direction = face_towards_position(env, env._current_state.pos, closest_workshop_pos)\n  if face_direction:\n    actions.append(face_direction)\n  \n  actions.append(4)  # USE action\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-10T06:09:22.707022", "function_name": "craft", "function_body": "  i_goal = env.world.cookbook.index[item]\n  \n  if i_goal not in env.world.cookbook.recipes:\n    raise ValueError(f\"No recipe found for {item}.\")\n    \n  actions = []\n  \n  # Check if we have all required primitives and intermediate items\n  required_primitives = env.world.cookbook.primitives_for(i_goal)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory)}\n\n  # Collect missing primitives\n  missing_items = []\n  for primitive, count_needed in required_primitives.items():\n    if inventory_dict.get(primitive, 0) < count_needed:\n      missing_items.append((primitive, count_needed - inventory_dict.get(primitive, 0)))\n\n  for primitive, count_to_collect in missing_items:\n    actions.extend(collect_v2(env, primitive, count_to_collect))\n\n  # Go to the workshop and craft the item\n  workshop_key = env.world.cookbook.recipes[i_goal][\"_key\"]\n  workshop_index = env.world.cookbook.index[workshop_key]\n  \n  # Find the position of the nearest workshop in the grid\n  grid_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if not grid_positions.size:\n    return []  # No workshops found\n\n  closest_workshop_pos = min(grid_positions, key=lambda x: np.linalg.norm(np.array(x) - np.array(env._current_state.pos)))\n  \n  # Move to the closest workshop\n  move_actions = move_to_position(env, env._current_state.pos, closest_workshop_pos)\n  actions.extend(move_actions)\n\n  # Orient towards the workshop and use it\n  face_direction = face_towards_position(env, env._current_state.pos, closest_workshop_pos)\n  if face_direction:\n    actions.append(face_direction)\n  \n  actions.append(4)  # USE action\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-10T06:12:00.377327", "function_name": "craft", "function_body": "  def find_path(start, end, grid):\n    queue = collections.deque([(start, [])])\n    visited = set([start])\n    while queue:\n        (x, y), path = queue.popleft()\n        if (x, y) == end:\n            return path + [(x, y)]\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            nx, ny = x + dx, y + dy\n            if 0 <= nx < grid.shape[1] and 0 <= ny < grid.shape[0]:\n                if grid[ny, nx].sum() == 0 and (nx, ny) not in visited:\n                    queue.append(((nx, ny), path + [(x, y)]))\n                    visited.add((nx, ny))\n    return None\n\n  def move_towards(current_pos, target_pos):\n      actions = []\n      cx, cy = current_pos\n      tx, ty = target_pos\n      while (cx, cy) != (tx, ty):\n          if cx < tx:\n              actions.append(craft.CraftLab.ACTIONS['RIGHT'])\n              cx += 1\n          elif cx > tx:\n              actions.append(craft.CraftLab.ACTIONS['LEFT'])\n              cx -= 1\n          elif cy < ty:\n              actions.append(craft.CraftLab.ACTIONS['DOWN'])\n              cy += 1\n          else:\n              actions.append(craft.CraftLab.ACTIONS['UP'])\n              cy -= 1\n      return actions\n\n  def face_direction(current_pos, target_pos):\n      cx, cy = current_pos\n      tx, ty = target_pos\n      if cx < tx:\n          direction = craft.CraftLab.DIRECTIONS['RIGHT']\n      elif cx > tx:\n          direction = craft.CraftLab.DIRECTIONS['LEFT']\n      elif cy < ty:\n          direction = craft.CraftLab.DIRECTIONS['DOWN']\n      else:\n          direction = craft.CraftLab.DIRECTIONS['UP']\n\n      # Generate actions to face the correct direction\n      current_direction_index = env._current_state.init_dir\n      target_direction_index = list(craft.CraftLab.DIRECTIONS.values()).index(direction)\n\n      while current_direction_index != target_direction_index:\n          if (current_direction_index + 1) % 4 == target_direction_index:\n              actions.append(craft.CraftLab.ACTIONS['RIGHT'])\n          elif (current_direction_index - 1) % 4 == target_direction_index:\n              actions.append(craft.CraftLab.ACTIONS['LEFT'])\n          current_direction_index = (current_direction_index + 1) % 4 if target_direction_index > current_direction_index else (current_direction_index - 1) % 4\n\n      return actions\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the primitives required to craft the desired item\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n  \n  actions = []\n  \n  for primitive_index, count in primitives_required.items():\n    if env._current_state.inventory[primitive_index] < count:\n      return []  # Return empty action list if any primitive is not sufficient\n\n  workshop_index = None\n  \n  # Find out which workshop is needed for crafting the desired item\n  for output_item, recipe in env.world.cookbook.recipes.items():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n      workshop_index = recipe.get(\"_at\", None)\n      break\n\n  if workshop_index is None:\n    return []  # Return empty action list if no workshop found for the desired item\n\n  # Find the position of the workshop on the grid\n  workshop_position = None\n  for y in range(env._current_state.grid.shape[0]):\n    for x in range(env._current_state.grid.shape[1]):\n      if env._current_state.grid[y, x, workshop_index] == 1:\n        workshop_position = (x, y)\n        break\n    if workshop_position:\n      break\n\n  if workshop_position is None:\n    return []  # Return empty action list if the workshop position not found\n\n  # Generate actions to move to the workshop\n  path_to_workshop = find_path(env._current_state.pos, workshop_position, env._current_state.grid)\n  \n  for pos in path_to_workshop[:-1]:\n      actions.extend(move_towards(env._current_state.pos, pos))\n      # Update the current state position after each move\n      env._current_state.pos = pos\n\n  # Turn to face the workshop\n  actions.extend(face_direction(env._current_state.pos, workshop_position))\n\n  # Perform the USE action to craft the item\n  actions.append(craft.CraftLab.ACTIONS['USE'])\n  \n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T06:12:01.491563", "function_name": "craft", "function_body": "  def find_path(start, end, grid):\n    queue = collections.deque([(start, [])])\n    visited = set([start])\n    while queue:\n        (x, y), path = queue.popleft()\n        if (x, y) == end:\n            return path + [(x, y)]\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            nx, ny = x + dx, y + dy\n            if 0 <= nx < grid.shape[1] and 0 <= ny < grid.shape[0]:\n                if grid[ny, nx].sum() == 0 and (nx, ny) not in visited:\n                    queue.append(((nx, ny), path + [(x, y)]))\n                    visited.add((nx, ny))\n    return None\n\n  def move_towards(current_pos, target_pos):\n      cx, cy = current_pos\n      tx, ty = target_pos\n      actions = []\n      while (cx, cy) != (tx, ty):\n          if cx < tx:\n              actions.append(craft.CraftLab.ACTIONS['RIGHT'])\n              cx += 1\n          elif cx > tx:\n              actions.append(craft.CraftLab.ACTIONS['LEFT'])\n              cx -= 1\n          elif cy < ty:\n              actions.append(craft.CraftLab.ACTIONS['DOWN'])\n              cy += 1\n          else:\n              actions.append(craft.CraftLab.ACTIONS['UP'])\n              cy -= 1\n      return actions\n\n  def face_direction(current_direction, target_pos):\n      cx, cy = current_direction[:2]\n      tx, ty = target_pos\n      if cx < tx:\n          direction = craft.CraftLab.DIRECTIONS['RIGHT']\n      elif cx > tx:\n          direction = craft.CraftLab.DIRECTIONS['LEFT']\n      elif cy < ty:\n          direction = craft.CraftLab.DIRECTIONS['DOWN']\n      else:\n          direction = craft.CraftLab.DIRECTIONS['UP']\n      \n      # Generate actions to face the correct direction\n      current_direction_name = env._current_state.init_directions[env._current_state.pos]\n      if current_direction_name == 'RIGHT' and direction != 'RIGHT':\n          actions.append(craft.CraftLab.ACTIONS['LEFT'])\n      elif current_direction_name == 'LEFT' and direction != 'LEFT':\n          actions.append(craft.CraftLab.ACTIONS['RIGHT'])\n      elif current_direction_name == 'UP' and direction != 'UP':\n          actions.append(craft.CraftLab.ACTIONS['DOWN'])\n      elif current_direction_name == 'DOWN' and direction != 'DOWN':\n          actions.append(craft.CraftLab.ACTIONS['UP'])\n\n      return actions\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the primitives required to craft the desired item\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n  \n  actions = []\n  \n  for primitive_index, count in primitives_required.items():\n    if env._current_state.inventory[primitive_index] < count:\n      return []  # Return empty action list if any primitive is not sufficient\n\n  workshop_index = None\n  \n  # Find out which workshop is needed for crafting the desired item\n  for output_item, recipe in env.world.cookbook.recipes.items():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n      workshop_index = recipe.get(\"_at\", None)\n      break\n\n  if workshop_index is None:\n    return []  # Return empty action list if no workshop found for the desired item\n\n  # Find the position of the workshop on the grid\n  workshop_position = None\n  for y in range(env._current_state.grid.shape[0]):\n    for x in range(env._current_state.grid.shape[1]):\n      if env._current_state.grid[y, x, workshop_index] == 1:\n        workshop_position = (x, y)\n        break\n    if workshop_position:\n      break\n\n  if workshop_position is None:\n    return []  # Return empty action list if the workshop position not found\n\n  # Generate actions to move to the workshop\n  path_to_workshop = find_path(env._current_state.pos, workshop_position, env._current_state.grid)\n  \n  for pos in path_to_workshop[:-1]:\n      actions.extend(move_towards(env._current_state.pos, pos))\n      # Update the current state position after each move\n      env._current_state.pos = pos\n\n  # Turn to face the workshop\n  actions.extend(face_direction(env._current_state.init_directions[env._current_state.pos], workshop_position))\n\n  # Perform the USE action to craft the item\n  actions.append(craft.CraftLab.ACTIONS['USE'])\n  \n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T06:12:49.298613", "function_name": "craft", "function_body": "  # Retrieve the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  if not item_index in env.world.cookbook.recipes:\n    print(f\"No recipe found for {item}.\")\n    return []\n\n  # Determine the primitives required to craft the item\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n\n  # Check if we have all required primitives in our inventory\n  for primitive, count in required_primitives.items():\n    if env._current_state.inventory[primitive] < count:\n      print(f\"Missing {count} of {env.world.cookbook.index.get(primitive)}.\")\n      return []\n\n  # Retrieve the workshop index for crafting the item\n  workshop_key = \"_at\"\n  workshop_name = env.world.cookbook.recipes[item_index][workshop_key]\n  workshop_index = env.world.workshop_indices[env.world.cookbook.index[workshop_name]]\n\n  # Get the current position of the agent and the direction it is facing\n  current_pos, current_dir = env._current_state.pos, env._current_state.dir\n\n  # Calculate the relative position of the workshop from the agent's current position\n  workshop_pos = (workshop_index % env.world.grid.shape[1], workshop_index // env.world.grid.shape[0])\n  \n  # Determine the direction to move towards the workshop\n  actions_to_take = []\n\n  if current_pos[0] < workshop_pos[0]:\n      actions_to_take.append(env.action_specs()[\"RIGHT\"])\n  elif current_pos[0] > workshop_pos[0]:\n      actions_to_take.append(env.action_specs()[\"LEFT\"])\n\n  if current_pos[1] < workshop_pos[1]:\n      actions_to_take.append(env.action_specs()[\"DOWN\"])\n  elif current_pos[1] > workshop_pos[1]:\n      actions_to_take.append(env.action_specs()[\"UP\"])\n\n  # Add the USE action to craft the item at the workshop\n  actions_to_take.append(env.action_specs()[\"USE\"])\n\n  return actions_to_take", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-10T06:12:50.307356", "function_name": "craft", "function_body": "  def get_primitive_actions(primitive):\n    # Placeholder for the function that generates actions to collect primitives\n    return []\n\n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[env.world.cookbook.index.get(item)]\n  \n  # Check if the goal is achievable with the current setup\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Goal {item} unknown or uncraftable\")\n\n  # Get primitives needed for crafting\n  primitive_counts = env.world.cookbook.primitives_for(item_index)\n  \n  actions = []\n  \n  # Collect all required primitives\n  for primitive, count in primitive_counts.items():\n    actions.extend(get_primitive_actions(primitive))\n  \n  # Go to the workshop and craft the item\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_key = recipe.get(\"_at\", None)\n  if workshop_key:\n    workshop_index = env.world.cookbook.index[workshop_key]\n    \n    # Placeholder for moving to the workshop\n    actions.extend(move_to_workshop(workshop_index))\n    \n    # Use action at the workshop\n    actions.append(env.world.N_ACTIONS - 1)  # Assuming USE is the last action\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-10T06:13:33.670184", "function_name": "craft", "function_body": "  actions = []\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  # Check if the item has a recipe\n  if item_index not in cookbook.recipes:\n    return actions\n  \n  # Get the primitives required for the item\n  primitives_needed = cookbook.primitives_for(item_index)\n  current_inventory = env._current_state.inventory.copy()\n  \n  # Check if we have all the primitives needed\n  missing_primitives = {}\n  for primitive, count in primitives_needed.items():\n    if current_inventory[primitive] < count:\n      missing_primitives[primitive] = count - current_inventory[primitive]\n  \n  if not missing_primitives:\n    # If no primitives are missing, proceed to craft the item\n    workshop_index = cookbook.recipes[item_index][\"_key\"]\n    workshop_pos = get_workshop_position(env._current_state.grid, workshop_index)\n    \n    if workshop_pos is None:\n      return actions\n    \n    actions.extend(navigate_to_position(env._current_state.pos, env._current_state.dir, workshop_pos))\n    actions.append(4)  # USE action to craft the item\n  else:\n    # If primitives are missing, collect them first\n    for primitive_index, count in missing_primitives.items():\n      primitive_name = cookbook.index.get(primitive_index)\n      actions.extend(collect_v2(env, primitive_name, count))\n      \n      if not all(current_inventory[primitive] >= needed_count for primitive, needed_count in primitives_needed.items()):\n        # If we still don't have all the required primitives, continue collecting\n        return actions\n    \n    # Once we have all primitives, navigate to the workshop and craft the item\n    workshop_index = cookbook.recipes[item_index][\"_key\"]\n    workshop_pos = get_workshop_position(env._current_state.grid, workshop_index)\n    \n    if workshop_pos is None:\n      return actions\n    \n    actions.extend(navigate_to_position(env._current_state.pos, env._current_state.dir, workshop_pos))\n    actions.append(4)  # USE action to craft the item\n  \n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-10T06:13:34.649162", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  item_idx = env.world.cookbook.index[item]\n  \n  # Check if we have all primitives required for crafting the item\n  required_primitives = env.world.cookbook.primitives_for(item_idx)\n  \n  actions = []\n  \n  # Collect required primitives if not already in inventory\n  current_inventory = env._current_state.inventory\n  for primitive, count in required_primitives.items():\n    if current_inventory[primitive] < count:\n      # Find the nearest source of the primitive and collect it\n      primitive_name = env.world.cookbook.index.get(primitive)\n      collect_actions = collect_v2(env, primitive_name)\n      actions.extend(collect_actions)\n\n  # Move to the correct workshop and craft the item\n  recipe = env.world.cookbook.recipes[item_idx]\n  workshop_index_str = recipe[\"_at\"]\n  workshop_index = getattr(env.world, f\"{workshop_index_str}_indices\")[0]\n  \n  move_to_workshop_actions = move_to_v2(env, workshop_index)\n  actions.extend(move_to_workshop_actions)\n\n  # Use action to craft the item\n  actions.append(craft.env.N_ACTIONS - 1)  # Assuming USE is the last action\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-10T06:16:53.570611", "function_name": "craft", "function_body": "  def find_path(start, end, grid):\n    queue = collections.deque([(start, [])])\n    visited = set([start])\n    while queue:\n        (x, y), path = queue.popleft()\n        if (x, y) == end:\n            return path + [(x, y)]\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            nx, ny = x + dx, y + dy\n            if 0 <= nx < grid.shape[1] and 0 <= ny < grid.shape[0]:\n                if grid[ny, nx].sum() == 0 and (nx, ny) not in visited:\n                    queue.append(((nx, ny), path + [(x, y)]))\n                    visited.add((nx, ny))\n    return None\n\n  def move_towards(current_pos, target_pos):\n      actions = []\n      cx, cy = current_pos\n      tx, ty = target_pos\n      while (cx, cy) != (tx, ty):\n          if cx < tx:\n              actions.append(craft.CraftLab.ACTIONS['RIGHT'])\n              cx += 1\n          elif cx > tx:\n              actions.append(craft.CraftLab.ACTIONS['LEFT'])\n              cx -= 1\n          elif cy < ty:\n              actions.append(craft.CraftLab.ACTIONS['DOWN'])\n              cy += 1\n          else:\n              actions.append(craft.CraftLab.ACTIONS['UP'])\n              cy -= 1\n      return actions\n\n  def face_direction(current_pos, target_pos):\n      cx, cy = current_pos\n      tx, ty = target_pos\n      \n      # Determine the direction to face based on relative positions\n      if cx < tx:\n          direction = craft.CraftLab.DIRECTIONS['RIGHT']\n      elif cx > tx:\n          direction = craft.CraftLab.DIRECTIONS['LEFT']\n      elif cy < ty:\n          direction = craft.CraftLab.DIRECTIONS['DOWN']\n      else:\n          direction = craft.CraftLab.DIRECTIONS['UP']\n\n      # Calculate the number of turns needed to face the correct direction\n      current_direction_index = env._current_state.init_dir\n      target_direction_index = list(craft.CraftLab.DIRECTIONS.values()).index(direction)\n\n      while current_direction_index != target_direction_index:\n          if (current_direction_index + 1) % 4 == target_direction_index:\n              actions.append(craft.CraftLab.ACTIONS['RIGHT'])\n          elif (current_direction_index - 1) % 4 == target_direction_index:\n              actions.append(craft.CraftLab.ACTIONS['LEFT'])\n          current_direction_index = (current_direction_index + 1) % 4 if target_direction_index > current_direction_index else (current_direction_index - 1) % 4\n\n      return actions\n  \n  def collect_primitives(env, primitives_required):\n    actions = []\n    \n    # Iterate through each required primitive and collect them\n    for primitive_index, count in primitives_required.items():\n        while env._current_state.inventory[primitive_index] < count:\n            # Find positions of the primitive on the grid\n            primitive_positions = []\n            for y in range(env._current_state.grid.shape[0]):\n                for x in range(env._current_state.grid.shape[1]):\n                    if env._current_state.grid[y, x, primitive_index] == 1:\n                        primitive_positions.append((x, y))\n            \n            # If no positions found, return empty action list\n            if not primitive_positions:\n                return []\n            \n            # Calculate the closest primitive position to collect\n            closest_position = min(primitive_positions, key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1]))\n            \n            # Find path to the closest primitive position\n            path_to_primitive = find_path(env._current_state.pos, closest_position, env._current_state.grid)\n            \n            if path_to_primitive is None:\n                return []\n            \n            for pos in path_to_primitive[:-1]:\n                actions.extend(move_towards(env._current_state.pos, pos))\n                # Update the current state position after each move\n                env._current_state.pos = pos\n            \n            # Turn to face the primitive\n            actions.extend(face_direction(env._current_state.pos, closest_position))\n\n            # Perform the USE action to collect the primitive\n            actions.append(craft.CraftLab.ACTIONS['USE'])\n            \n            # Update inventory count (this should be handled by the environment)\n            env._current_state.inventory[primitive_index] += 1\n    \n    return actions\n  \n  item_index = env.world.cookbook.index[item]\n  \n  # Get the primitives required to craft the desired item\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n  \n  actions = []\n  \n  # Collect all required primitives\n  collect_actions = collect_primitives(env, primitives_required)\n  if not collect_actions:\n    return []  # Return empty action list if any primitive cannot be collected\n  \n  actions.extend(collect_actions)\n\n  workshop_index = None\n  \n  # Find out which workshop is needed for crafting the desired item\n  for output_item, recipe in env.world.cookbook.recipes.items():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n      workshop_index = recipe.get(\"_at\", None)\n      break\n\n  if workshop_index is None:\n    return []  # Return empty action list if no workshop found for the desired item\n\n  # Find the position of the workshop on the grid\n  workshop_position = None\n  for y in range(env._current_state.grid.shape[0]):\n    for x in range(env._current_state.grid.shape[1]):\n      if env._current_state.grid[y, x, workshop_index] == 1:\n        workshop_position = (x, y)\n        break\n    if workshop_position:\n      break\n\n  if workshop_position is None:\n    return []  # Return empty action list if the workshop position not found\n\n  # Generate actions to move to the workshop\n  path_to_workshop = find_path(env._current_state.pos, workshop_position, env._current_state.grid)\n  \n  for pos in path_to_workshop[:-1]:\n      actions.extend(move_towards(env._current_state.pos, pos))\n      # Update the current state position after each move\n      env._current_state.pos = pos\n\n  # Turn to face the workshop\n  actions.extend(face_direction(env._current_state.pos, workshop_position))\n\n  # Perform the USE action to craft the item\n  actions.append(craft.CraftLab.ACTIONS['USE'])\n  \n  return actions", "island_id": 1, "scores": {"3": 0.0}}
