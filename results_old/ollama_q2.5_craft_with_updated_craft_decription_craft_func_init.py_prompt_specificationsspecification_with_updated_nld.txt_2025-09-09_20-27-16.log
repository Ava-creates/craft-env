 target_workshop_pos is not None:\n          break\n  \n  if target_workshop_pos is None:\n    return []  # Workshop position not found in the grid\n\n  # Check and collect all required primitives\n  for ingredient_idx, count in recipe.items():\n      if env._current_state.inventory[ingredient_idx] < count:\n          actions.extend(collect_ingredient(env.world.cookbook.index.get(ingredient_idx)))\n      \n      if env._current_state.inventory[ingredient_idx] < count:\n        return []  # Could not collect all required primitives\n  \n  # Move to the target workshop\n  actions.extend(move_to(env._current_state, target_workshop_pos))\n  \n  # Perform the USE action at the workshop\n  actions.append(4)  # USE action index\n\n  # Verify if item is crafted by checking inventory\n  if env._current_state.inventory[item_idx] == 0:\n    return []  # Crafting failed\n  \n  return actions", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T04:13:37.049750", "function_name": "craft", "function_body": "  def collect_ingredient(name: str):\n    ingredient_idx = env.world.cookbook.index[name]\n    \n    if env._current_state.inventory[ingredient_idx] > 0:\n      return []\n    \n    # Find positions of the ingredient in the grid\n    ingredient_positions = [(x, y) for y in range(env._current_state.grid.shape[1])\n                            for x in range(env._current_state.grid.shape[0])\n                            if env._current_state.grid[x, y, ingredient_idx] == 1]\n    \n    actions = []\n    while ingredient_positions:\n        ingredient_pos = ingredient_positions.pop()\n        \n        # Move to the ingredient position\n        actions.extend(move_to(env._current_state, ingredient_pos))\n        \n        # Perform the USE action to collect the ingredient\n        actions.append(4)  # USE action index\n    \n    return actions\n\n  def move_to(state: craft.CraftState, target_pos: tuple[int, int]):\n    current_pos = state.pos\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    actions = []\n    \n    # Move horizontally\n    if dx > 0:\n        actions.extend([3] * abs(dx))  # RIGHT\n    elif dx < 0:\n        actions.extend([2] * abs(dx))  # LEFT\n    \n    # Move vertically\n    if dy > 0:\n        actions.extend([1] * abs(dy))  # UP\n    elif dy < 0:\n        actions.extend([0] * abs(dy))  # DOWN\n\n    return actions\n\n  actions = []\n  \n  # Get the index for the desired item from the cookbook\n  item_idx = env.world.cookbook.index[item]\n  \n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_idx, {})\n  \n  if not recipe:\n    return []  # No recipe found\n  \n  # Determine the workshop where the crafting should happen\n  workshop_key = \"_key\"\n  workshop_index = int(recipe.pop(workshop_key, -1))\n  \n  if workshop_index == -1:\n    return []  # Workshop not specified in the recipe\n  \n  # Get the list of workshops from the world configuration\n  workshop_indices = env.world.workshop_indices\n  \n  if workshop_index >= len(workshop_indices):\n    return []  # Invalid workshop index\n\n  # Determine the target position for the workshop\n  target_workshop_pos = None\n  for y in range(env._current_state.grid.shape[1]):\n      for x in range(env._current_state.grid.shape[0]):\n          if env._current_state.grid[x, y, workshop_indices[workshop_index]] == 1:\n              target_workshop_pos = (x, y)\n              break\n      if target_workshop_pos is not None:\n          break\n\n  if target_workshop_pos is None:\n    return []  # Workshop position not found in the grid\n  \n  # Collect all required primitives\n  for ingredient_idx, count in recipe.items():\n    ingredient_name = env.world.cookbook.index.get(ingredient_idx)\n    \n    while env._current_state.inventory[ingredient_idx] < count:\n      actions.extend(collect_ingredient(ingredient_name))\n      \n    if env._current_state.inventory[ingredient_idx] < count:\n        return []  # Could not collect all required primitives\n  \n  # Move to the target workshop\n  actions.extend(move_to(env._current_state, target_workshop_pos))\n  \n  # Perform the USE action at the workshop\n  actions.append(4)  # USE action index\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-10T04:14:55.445072", "function_name": "craft", "function_body": "  def move_to_position(target_x, target_y):\n    current_x, current_y = env._current_state.pos\n    actions = []\n\n    # Calculate the direction to move horizontally and vertically\n    dx = target_x - current_x\n    dy = target_y - current_y\n\n    # Determine the sequence of moves to reach the target position\n    if dx > 0:\n      actions.extend([env.world.cookbook.index[\"MOVE_FUNC_DOWN\"]] * abs(dx))\n    elif dx < 0:\n      actions.extend([env.world.cookbook.index[\"MOVE_FUNC_UP\"]] * abs(dx))\n\n    if dy > 0:\n      actions.extend([env.world.cookbook.index[\"MOVE_FUNC_RIGHT\"]] * abs(dy))\n    elif dy < 0:\n      actions.extend([env.world.cookbook.index[\"MOVE_FUNC_LEFT\"]] * abs(dy))\n\n    return actions\n\n  def face_workshop(target_x, target_y):\n    actions = []\n    current_x, current_y = env._current_state.pos\n    dx = target_x - current_x\n    dy = target_y - current_y\n\n    # Determine the direction to face\n    if dx > 0:\n      final_direction = \"DOWN\"\n    elif dx < 0:\n      final_direction = \"UP\"\n    elif dy > 0:\n      final_direction = \"RIGHT\"\n    elif dy < 0:\n      final_direction = \"LEFT\"\n\n    current_direction_map = [\"UP\", \"RIGHT\", \"DOWN\", \"LEFT\"]\n    current_direction_index = env._current_state.dir\n\n    # Turn to the correct direction if not already facing it\n    if current_direction_map[current_direction_index] != final_direction:\n        actions.append(env.world.cookbook.index[\"MOVE_FUNC_\" + final_direction])\n\n    return actions\n\n  def collect_primitives(primitive, required_amount):\n      primitive_actions = []\n      \n      # Get the index of the primitive from the cookbook\n      i_primitive = env.world.cookbook.index[primitive]\n      \n      # Search for the closest source of the primitive in the grid\n      min_distance = float('inf')\n      closest_source_pos = None\n      \n      for y in range(env._current_state.grid.shape[0]):\n          for x in range(env._current_state.grid.shape[1]):\n              if np.any(env._current_state.grid[y, x, i_primitive] > 0):\n                  distance = abs(y - env._current_state.pos[0]) + abs(x - env._current_state.pos[1])\n                  if distance < min_distance:\n                      min_distance = distance\n                      closest_source_pos = (y, x)\n      \n      # If no source is found, return an empty action list for this primitive\n      if closest_source_pos is None:\n          return []\n      \n      target_x, target_y = closest_source_pos\n      \n      # Calculate actions needed to move to the closest source of the primitive\n      primitive_actions.extend(move_to_position(target_x, target_y))\n      \n      # Collect the required amount of the primitive\n      for _ in range(required_amount):\n          if env._current_state.next_to(i_primitive):\n              primitive_actions.append(env.world.cookbook.index[\"USE_FUNC\"])\n      \n      return primitive_actions\n\n  actions = []\n  \n  # Get the index of the desired item from the cookbook\n  i_goal = env.world.cookbook.index[item]\n  \n  # Get the recipe for the goal item\n  recipe = env.world.cookbook.recipes[i_goal]\n\n  # Check if we have all the ingredients in our inventory to craft the item\n  required_primitives = env.world.cookbook.primitives_for(i_goal)\n  inventory_dict = {env.world.cookbook.index.get(idx): count for idx, count in enumerate(env._current_state.inventory) if count > 0}\n\n  # Collect missing primitives\n  for primitive, required_amount in required_primitives.items():\n      if primitive not in inventory_dict or inventory_dict[primitive] < required_amount:\n          actions.extend(collect_primitives(primitive, required_amount - inventory_dict.get(primitive, 0)))\n\n  # Now that we have all the primitives, let's go to the workshop and use it to craft the item\n  workshop = recipe[\"_key\"]\n  workshop_idx = env.world.cookbook.index[workshop]\n\n  # Get the position of the closest workshop from our current position in the grid\n  min_distance = float('inf')\n  closest_workshop_pos = None\n\n  for y in range(env._current_state.grid.shape[0]):\n      for x in range(env._current_state.grid.shape[1]):\n          if np.any(env._current_state.grid[y, x, workshop_idx] > 0):\n              distance = abs(y - env._current_state.pos[0]) + abs(x - env._current_state.pos[1])\n              if distance < min_distance:\n                  min_distance = distance\n                  closest_workshop_pos = (y, x)\n\n  # If no workshop is found, return an empty action list\n  if closest_workshop_pos is None:\n      return []\n\n  target_x, target_y = closest_workshop_pos\n\n  # Calculate actions needed to move to the closest workshop\n  actions.extend(move_to_position(target_x, target_y))\n\n  # Face the workshop direction and use it to craft the item\n  actions.extend(face_workshop(target_x, target_y))\n  \n  actions.append(env.world.cookbook.index[\"USE_FUNC\"])\n  \n  return actions", "island_id": 5, "scores": {"3": -1}}
