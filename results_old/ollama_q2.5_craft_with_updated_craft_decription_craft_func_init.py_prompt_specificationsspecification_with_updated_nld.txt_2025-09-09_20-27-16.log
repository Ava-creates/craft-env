irectly below\n      if current_direction != 2:\n          actions.append(env.world.cookbook.index[\"MOVE_FUNC_DOWN\"])\n  elif dx == 0 and dy < 0:  # Target is directly above\n      if current_direction != 3:\n          actions.append(env.world.cookbook.index[\"MOVE_FUNC_UP\"])\n  elif dx > 0 and dy == 0:  # Target is to the right\n      if current_direction != 1:\n          actions.append(env.world.cookbook.index[\"MOVE_FUNC_RIGHT\"])\n  elif dx < 0 and dy == 0:  # Target is to the left\n      if current_direction != 0:\n          actions.append(env.world.cookbook.index[\"MOVE_FUNC_LEFT\"])\n\n  # Finally, use the workshop to craft the item\n  actions.append(env.world.cookbook.index[\"USE_FUNC\"])\n  \n  return actions", "island_id": 5, "scores": {"3": 0.0}}
