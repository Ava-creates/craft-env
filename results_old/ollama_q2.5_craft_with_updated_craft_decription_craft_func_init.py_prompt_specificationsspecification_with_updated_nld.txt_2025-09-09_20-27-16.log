{"timestamp": "2025-09-10T20:49:43.212203", "function_name": "craft", "function_body": "  def find_primitives(primitive_indices):\n    primitives = {}\n    for primitive in primitive_indices:\n        recipe = env.world.cookbook.recipes.get(primitive)\n        if recipe is None:  # No further crafting required; it's a basic resource\n            primitives[primitive] = 1\n        else:\n            key = list(recipe.keys())[-1]\n            workshop = list(key.split(\"_at=\"))[1] if \"_key\" in key else None\n            if workshop is None:\n                raise ValueError(f\"No workshop specified for recipe: {recipe}\")\n            # Recursively find the primitives needed to craft this primitive\n            nested_primitives = find_primitives([idx for idx, name in enumerate(env.world.workshop_indices) \n                                                 if workshop in env.world.cookbook.index.get(name)])\n            for nested_primitive, count in nested_primitives.items():\n                primitives[nested_primitive] = primitives.get(nested_primitive, 0) + count\n    return primitives\n\n  actions = []\n  item_index = env.world.cookbook.index[item]\n  \n  if env._current_state.inventory[item_index] > 0 or item_index in env.world.grabbable_indices:\n    return actions\n  \n  # Find all primitives needed to craft this item recursively\n  primitives_needed = find_primitives([item_index])\n  \n  for primitive, count in primitives_needed.items():\n      actions.extend(collect_v2(env, env.world.cookbook.index.get(primitive)))\n      \n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_name = list(recipe.keys())[-1].split(\"_at=\")[1] if \"_key\" in recipe else None\n  \n  if workshop_name:\n      workshop_indices = [idx for idx, name in enumerate(env.world.workshop_indices) \n                          if workshop_name in env.world.cookbook.index.get(name)]\n      \n      closest_workshop_index = find_closest_workshop(env._current_state.pos, workshop_indices)\n      \n      actions.extend(move_to_workshop_and_align_direction(env._current_state, closest_workshop_index))\n      \n      # Craft the item at the workshop\n      actions.append(craft.USE)\n  \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
