eturn []\n\n  # Determine the workshop where crafting should occur\n  workshop = recipe.get(\"_at\", None)\n  if not workshop:\n    return []\n\n  workshop_index = env.world.cookbook.index[workshop]\n\n  # Find the closest position next to the workshop\n  closest_workshop_pos = find_closest_workshop(workshop_index)\n\n  if not closest_workshop_pos:\n    return []\n\n  # Calculate the direction to move towards the closest workshop\n  agent_pos = env._current_state.pos\n  actions_to_take = move_towards_position(agent_pos, closest_workshop_pos)\n\n  # Append USE action to craft the item\n  actions_to_take.append(4)  # USE action\n\n  return actions_to_take", "island_id": 7, "scores": {"3": 5.0}}
{"timestamp": "2025-09-11T14:03:22.551803", "function_name": "craft", "function_body": "  def has_all_primitives(required_primitives, inventory_dict):\n    return all(primitive in inventory_dict and inventory_dict[primitive] >= required_primitives[primitive] for primitive in required_primitives)\n\n  actions = []\n  \n  # Get the index of the goal item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  # If not all primitives are available return empty action list\n  if not has_all_primitives(required_primitives, inventory_dict):\n    return []\n  \n  # Find the workshop where we can craft this item and its position\n  workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n      if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n          workshop_index = recipe.get(\"_at\")\n          break\n  \n  if workshop_index is None:\n    return []\n\n  # Convert workshop index to the actual name of the workshop\n  workshop_name = env.world.cookbook.index.get(workshop_index)\n  \n  # Find the position of the nearest workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(workshop_positions) == 0:\n    return []\n  \n  # Select the closest workshop based on Manhattan distance\n  current_pos = env._current_state.pos\n  target_workshop_pos = min(workshop_positions, key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1]))\n\n  # Navigate to the selected workshop\n  actions.extend(navigate(env._current_state, target_workshop_pos))\n  \n  # Turn towards the workshop if not already facing it\n  current_direction = env._current_state.dir\n  direction_to_workshop = get_direction(current_pos, target_workshop_pos)\n  \n  # Move one step forward to face the workshop directly\n  next_pos = move_in_direction(target_workshop_pos, opposite_direction(direction_to_workshop))\n  if env._current_state.grid[next_pos[0], next_pos[1], workshop_index] == 1:\n      actions.append(direction_to_workshop)\n  else:\n      # Turn towards and step into the workshop\n      actions.append(direction_to_workshop)\n      actions.append(4)  # Assuming 4 is the index for the USE action\n\n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T14:03:23.614610", "function_name": "craft", "function_body": "  def has_all_primitives(required_primitives, inventory_dict):\n    return all(primitive in inventory_dict and inventory_dict[primitive] >= required_primitives[primitive] for primitive in required_primitives)\n\n  actions = []\n  \n  # Get the index of the goal item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  # If not all primitives are available return empty action list\n  if not has_all_primitives(required_primitives, inventory_dict):\n    return []\n  \n  # Find the workshop where we can craft this item and its position\n  workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n      if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n          workshop_index = recipe.get(\"_at\")\n          break\n  \n  if workshop_index is None:\n    return []\n\n  # Convert workshop index to the actual name of the workshop\n  workshop_name = env.world.cookbook.index.get(workshop_index)\n  \n  # Find the position of the nearest workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(workshop_positions) == 0:\n    return []\n  \n  # Select the closest workshop based on Manhattan distance\n  current_pos = env._current_state.pos\n  target_workshop_pos = min(workshop_positions, key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1]))\n\n  # Navigate to the selected workshop\n  actions.extend(navigate(env._current_state, target_workshop_pos))\n  \n  # Turn towards the workshop if not already facing it\n  current_direction = env._current_state.dir\n  direction_to_workshop = get_direction(current_pos, target_workshop_pos)\n  \n  # Adjust position to face the workshop directly\n  next_pos = move_in_direction(target_workshop_pos, opposite_direction(direction_to_workshop))\n  \n  # Check if we need to adjust our position to align with the workshop\n  if env._current_state.grid[next_pos[0], next_pos[1], workshop_index] == 0:\n      actions.append(direction_to_workshop)\n      next_pos = move_in_direction(target_workshop_pos, opposite_direction(direction_to_workshop))\n  \n  # Ensure we are facing the correct direction before using the workshop\n  if current_direction != direction_to_workshop:\n    actions.append(direction_to_workshop)\n\n  # Use the USE action to craft the item at the workshop\n  actions.append(4)  # Assuming 4 is the index for the USE action\n  \n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T14:04:22.684636", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index for the desired item\n  item_idx = env.world.cookbook.index[item]\n  \n  # Check if we have all the primitives required to craft the item\n  prerequisites = env.world.cookbook.primitives_for(item_idx)\n  \n  # Iterate over each primitive and check if it's available in our inventory\n  for primitive, count in prerequisites.items():\n    primitive_name = env.world.cookbook.index.get(primitive)\n    while env._current_state.inventory[primitive] < count:\n      # Collect the required primitives\n      actions.extend(collect(env, primitive_name))\n  \n  # Find the workshop where we can craft the item\n  for recipe_key, recipe in env.world.cookbook.recipes.items():\n    if \"_at\" in recipe and recipe[\"_key\"] == item_idx:\n      workshop = recipe[\"_at\"]\n      break\n  \n  # Move to the specified workshop and perform the USE action\n  workshop_idx = env.world.cookbook.index[workshop]\n  workshop_location = np.argwhere(env._current_state.grid[:, :, workshop_idx] > 0)\n  \n  if len(workshop_location) == 0:\n    return actions  # No available workshops\n  \n  # Choose one of the available workshop locations\n  target_pos = tuple(workshop_location[0])\n  \n  # Move to the target position\n  move_actions = move_to_position(env._current_state.pos, target_pos, env._current_state.dir)\n  actions.extend(move_actions)\n  \n  # Turn towards the workshop and perform the USE action\n  use_action = craft_item_at_workshop(env._current_state.pos, target_pos, env._current_state.dir)\n  actions.append(use_action)\n  \n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-11T14:04:23.665633", "function_name": "craft", "function_body": "  # Step 1: Get the index for the desired item using env.world.cookbook.index\n  goal_index = env.world.cookbook.index[item]\n  \n  # Step 2: Determine if we have all the required primitives to craft the item.\n  # Check inventory against the primitives required for crafting the specified item.\n  primitives_needed = env.world.cookbook.primitives_for(goal_index)\n  for primitive, count in primitives_needed.items():\n    if env._current_state.inventory[primitive] < count:\n      return []  # Not enough primitives to craft the item.\n\n  # Step 3: If we have all required primitives, proceed with crafting.\n  # We need to locate the appropriate workshop and navigate there.\n  recipe = env.world.cookbook.recipes.get(goal_index)\n  \n  if not recipe or \"_at\" not in recipe:\n    return []  # No recipe found or no workshop specified.\n\n  workshop_type = recipe[\"_at\"]\n  workshop_index = next((i for i, idx in enumerate(env.world.workshop_indices) \n                         if env.world.cookbook.index.get(workshop_type) == idx), None)\n  \n  if workshop_index is None:\n    return []  # Workshop not found.\n\n  # Step 4: Find the nearest workshop of the required type.\n  closest_workshop = find_closest_workshop(env, workshop_index)\n  \n  if closest_workshop is None:\n    return []  # No reachable workshop found.\n\n  # Step 5: Navigate to the closest workshop and face it.\n  navigate_to_position(env._current_state.pos, closest_workshop)\n\n  # Step 6: Perform the USE action to craft the item at the workshop.\n  actions.append(craft.USE)\n  \n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-11T14:05:35.888071", "function_name": "craft", "function_body": "  goal_index = env.world.cookbook.index[item]\n\n  # Check if we have all required primitives in our inventory\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  current_inventory = collections.Counter(env._current_state.inventory)\n\n  for primitive, count in required_primitives.items():\n    if current_inventory[primitive] < count:\n      return []  # Missing required primitives\n\n  # Determine the workshop where crafting should occur\n  recipe_details = env.world.cookbook.recipes[goal_index]\n  workshop_name = recipe_details[\"_key\"]\n\n  # Get the index of the workshop from the world's cookbook\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the closest workshop in the grid\n  positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(positions) == 0:\n    return []  # No available workshops\n\n  closest_workshop_pos = min(\n      positions, key=lambda x: abs(x[0] - env._current_state.pos[0]) + abs(x[1] - env._current_state.pos[1]))\n\n  # Navigate to the closest workshop\n  current_pos = np.array(env._current_state.pos)\n  target_pos = np.array(closest_workshop_pos)\n\n  actions = []\n\n  while not np.array_equal(current_pos, target_pos):\n    delta = target_pos - current_pos\n\n    # Determine the direction with the largest absolute difference and move there first\n    if abs(delta[0]) > abs(delta[1]):\n      actions.extend([craft.RIGHT] * delta[0] if delta[0] > 0 else [craft.LEFT] * (-delta[0]))\n    else:\n      actions.extend([craft.DOWN] * delta[1] if delta[1] > 0 else [craft.UP] * (-delta[1]))\n\n    current_pos = np.array(env._current_state.pos)\n\n  # Orient the agent to face the workshop and use it\n  # Ensure the agent is facing the correct direction before using the workshop\n  target_dir = None\n\n  if closest_workshop_pos[0] > env._current_state.pos[0]:\n      target_dir = craft.RIGHT\n  elif closest_workshop_pos[0] < env._current_state.pos[0]:\n      target_dir = craft.LEFT\n  elif closest_workshop_pos[1] > env._current_state.pos[1]:\n      target_dir = craft.DOWN\n  elif closest_workshop_pos[1] < env._current_state.pos[1]:\n      target_dir = craft.UP\n\n  if target_dir is not None:\n      actions.append(target_dir)\n\n  # Finally, use the workshop to craft the item\n  actions.append(craft.USE)\n\n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T14:05:36.982811", "function_name": "craft", "function_body": "  goal_index = env.world.cookbook.index[item]\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  current_inventory = collections.Counter(env._current_state.inventory)\n\n  for primitive, count in required_primitives.items():\n    if current_inventory[primitive] < count:\n      return []  # Missing required primitives\n\n  recipe_details = env.world.cookbook.recipes[goal_index]\n  workshop_name = recipe_details[\"_key\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(positions) == 0:\n    return []  # No available workshops\n\n  closest_workshop_pos = min(\n      positions, key=lambda x: abs(x[0] - env._current_state.pos[0]) + abs(x[1] - env._current_state.pos[1]))\n\n  current_pos = np.array(env._current_state.pos)\n  target_pos = np.array(closest_workshop_pos)\n\n  actions = []\n\n  # Navigate to the closest workshop\n  while not np.array_equal(current_pos, target_pos):\n    delta = target_pos - current_pos\n\n    if abs(delta[0]) > abs(delta[1]):\n      actions.extend([craft.RIGHT] * delta[0] if delta[0] > 0 else [craft.LEFT] * (-delta[0]))\n    else:\n      actions.extend([craft.DOWN] * delta[1] if delta[1] > 0 else [craft.UP] * (-delta[1]))\n\n    current_pos = np.array(env._current_state.pos)\n\n  # Orient the agent to face the workshop and use it\n  target_workshop_directions = [\n    (craft.RIGHT, (target_pos[0], target_pos[1] + 1)),\n    (craft.DOWN, (target_pos[0] + 1, target_pos[1])),\n    (craft.LEFT, (target_pos[0], target_pos[1] - 1)),\n    (craft.UP, (target_pos[0] - 1, target_pos[1]))\n  ]\n\n  for direction, neighbor_pos in target_workshop_directions:\n      if env._current_state.grid[neighbor_pos[0], neighbor_pos[1], workshop_index] == 1:\n          actions.append(direction)\n          break\n\n  actions.append(craft.USE)\n\n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T14:07:16.551013", "function_name": "craft", "function_body": "  def find_closest_workshop(workshop_index):\n    grid = env._current_state.grid\n    agent_pos = env._current_state.pos\n    closest_distance = float('inf')\n    closest_workshop_pos = None\n\n    for x in range(grid.shape[0]):\n        for y in range(grid.shape[1]):\n            if grid[x, y, workshop_index] > 0:\n                distance = abs(x - agent_pos[0]) + abs(y - agent_pos[1])\n                if distance < closest_distance:\n                    closest_distance = distance\n                    closest_workshop_pos = (x, y)\n\n    return closest_workshop_pos\n\n  def move_towards_position(agent_pos, target_pos):\n      dx, dy = target_pos[0] - agent_pos[0], target_pos[1] - agent_pos[1]\n      actions = []\n      if dx > 0:\n          for _ in range(dx):\n              actions.append(3)  # RIGHT\n      elif dx < 0:\n          for _ in range(-dx):\n              actions.append(2)  # LEFT\n      if dy > 0:\n          for _ in range(dy):\n              actions.append(1)  # UP\n      elif dy < 0:\n          for _ in range(-dy):\n              actions.append(0)  # DOWN\n      return actions\n\n  def collect_primitive(primitive, count):\n    \"\"\"Collects the required amount of a primitive.\"\"\"\n    primitive_index = env.world.cookbook.index[primitive]\n    actions_to_take = []\n\n    while current_inventory[primitive_index] < count:\n        closest_primitive_pos = find_closest_workshop(primitive_index)\n        if not closest_primitive_pos:\n            return []  # Unable to find the required primitive\n        agent_pos = env._current_state.pos\n        move_actions = move_towards_position(agent_pos, closest_primitive_pos)\n        actions_to_take.extend(move_actions)\n        actions_to_take.append(4)  # USE action\n        current_inventory[primitive_index] += 1\n\n    return actions_to_take\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item has a recipe\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the required primitives and their counts for crafting the item\n  recipe = env.world.cookbook.recipes[item_index]\n  required_primitives = {ingredient: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n\n  # Check if we have all the required primitives in our inventory\n  current_inventory = env._current_state.inventory\n\n  actions_to_take = []\n\n  for primitive, count in required_primitives.items():\n    if current_inventory[env.world.cookbook.index[primitive]] < count:\n        collect_actions = collect_primitive(primitive, count)\n        if not collect_actions:\n            return []  # Unable to collect the required primitive\n        actions_to_take.extend(collect_actions)\n\n  # Determine the workshop where crafting should occur\n  workshop = recipe.get(\"_at\", None)\n  if not workshop:\n    return []\n\n  workshop_index = env.world.cookbook.index[workshop]\n\n  # Find the closest position next to the workshop\n  closest_workshop_pos = find_closest_workshop(workshop_index)\n\n  if not closest_workshop_pos:\n    return []\n\n  # Calculate the direction to move towards the closest workshop\n  agent_pos = env._current_state.pos\n  actions_to_take.extend(move_towards_position(agent_pos, closest_workshop_pos))\n\n  # Append USE action to craft the item\n  actions_to_take.append(4)  # USE action\n\n  return actions_to_take", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-11T14:07:17.656418", "function_name": "craft", "function_body": "  def find_closest_position_with_space_for_workshop(workshop_index):\n    grid = env._current_state.grid\n    agent_pos = env._current_state.pos\n    closest_distance = float('inf')\n    closest_position = None\n\n    for x in range(grid.shape[0]):\n        for y in range(grid.shape[1]):\n            if (grid[x, y, workshop_index] > 0 and\n                grid[x + 1, y, 0] == 0 and grid[x - 1, y, 0] == 0 and  # Check adjacent cells are empty\n                grid[x, y + 1, 0] == 0 and grid[x, y - 1, 0] == 0):\n                distance = abs(x - agent_pos[0]) + abs(y - agent_pos[1])\n                if distance < closest_distance:\n                    closest_distance = distance\n                    closest_position = (x, y)\n\n    return closest_position\n\n  def move_towards_position(agent_pos, target_pos):\n      dx, dy = target_pos[0] - agent_pos[0], target_pos[1] - agent_pos[1]\n      actions = []\n      if dx > 0:\n          for _ in range(dx):\n              actions.append(3)  # RIGHT\n      elif dx < 0:\n          for _ in range(-dx):\n              actions.append(2)  # LEFT\n      if dy > 0:\n          for _ in range(dy):\n              actions.append(1)  # UP\n      elif dy < 0:\n          for _ in range(-dy):\n              actions.append(0)  # DOWN\n      return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item has a recipe\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the required primitives and their counts for crafting the item\n  recipe = env.world.cookbook.recipes[item_index]\n  required_primitives = {ingredient: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n\n  # Check if we have all the required primitives in our inventory\n  current_inventory = env._current_state.inventory\n\n  missing_primitives = []\n\n  for primitive, count in required_primitives.items():\n    if current_inventory[primitive] < count:\n      missing_primitives.append((primitive, count))\n\n  # If there are any missing primitives, return an empty action list\n  if missing_primitives:\n    return []\n\n  # Determine the workshop where crafting should occur\n  workshop = recipe.get(\"_at\", None)\n  if not workshop:\n    return []\n\n  workshop_index = env.world.cookbook.index[workshop]\n\n  # Find the closest position next to the workshop\n  closest_workshop_pos = find_closest_position_with_space_for_workshop(workshop_index)\n\n  if not closest_workshop_pos:\n    return []\n\n  # Calculate the direction to move towards the closest workshop\n  agent_pos = env._current_state.pos\n  actions_to_take = move_towards_position(agent_pos, closest_workshop_pos)\n\n  # Append USE action to craft the item\n  actions_to_take.append(4)  # USE action\n\n  return actions_to_take", "island_id": 7, "scores": {"3": 5.0}}
{"timestamp": "2025-09-11T14:09:41.415193", "function_name": "craft", "function_body": "  def generate_path_to_workshop(current_state, workshop_index):\n    grid = env.world.grid\n    queue = collections.deque([current_state.pos])\n    visited = set([current_state.pos])\n    parent = {current_state.pos: None}\n    \n    while queue:\n        x, y = queue.popleft()\n        \n        # Check if we are next to the workshop\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            nx, ny = x + dx, y + dy\n            if grid[nx][ny] == workshop_index:\n                # Backtrack to find the path\n                path = []\n                while (nx, ny) != current_state.pos:\n                    path.append((nx, ny))\n                    nx, ny = parent[(nx, ny)]\n                return path[::-1]\n            \n            if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and grid[nx][ny] not in env.world.cookbook.index and (nx, ny) not in visited:\n                queue.append((nx, ny))\n                visited.add((nx, ny))\n                parent[(nx, ny)] = (x, y)\n    \n    return None\n\n  def generate_actions_from_path(path, current_state):\n      actions = []\n      for next_pos in path:\n          dx, dy = next_pos[0] - current_state.pos[0], next_pos[1] - current_state.pos[1]\n          if (dx, dy) == (-1, 0):\n              actions.append(2)  # LEFT\n          elif (dx, dy) == (1, 0):\n              actions.append(3)  # RIGHT\n          elif (dx, dy) == (0, -1):\n              actions.append(0)  # DOWN\n          elif (dx, dy) == (0, 1):\n              actions.append(1)  # UP\n      \n      return actions\n\n  def is_next_to_workshop(current_state, workshop_index):\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          neighbor_pos = (current_state.pos[0] + dx, current_state.pos[1] + dy)\n          if env.world.grid[neighbor_pos] == workshop_index:\n              return True\n      return False\n\n  item_index = env.world.cookbook.index[item]\n\n  # If the item has no recipe or is not a crafted item, return an empty action list\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the recipe for the desired item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Check if all required ingredients are available in the inventory\n  required_ingredients = {env.world.cookbook.index[ingredient]: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n  available_ingredients = {k: v for k, v in enumerate(env._current_state.inventory) if v > 0}\n\n  # If all ingredients are not available, return an empty action list\n  if any(required_ingredient not in available_ingredients or available_ingredients[required_ingredient] < count \n         for required_ingredient, count in required_ingredients.items()):\n    return []\n\n  # Find the workshop index where the item should be crafted\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Generate the path to the nearest workshop\n  path_to_workshop = generate_path_to_workshop(env._current_state, workshop_index)\n\n  if not path_to_workshop:\n      return []\n\n  actions = generate_actions_from_path(path_to_workshop, env._current_state)\n\n  # Once at the workshop, face it and perform the USE action\n  if is_next_to_workshop(env._current_state, workshop_index):\n      target_dir = ((1, 0), (-1, 0), (0, -1), (0, 1)).index((path_to_workshop[-1][0] - env._current_state.pos[0], path_to_workshop[-1][1] - env._current_state.pos[1]))\n      current_dir = ((1, 0), (-1, 0), (0, -1), (0, 1)).index(env._current_state.dir)\n      \n      if current_dir != target_dir:\n          actions.append((target_dir + 2) % 4)  # Turn to face the workshop\n      \n      actions.append(4)  # USE action to craft at the workshop\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T14:09:42.499822", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n\n  # If the item has no recipe or is not a crafted item, return an empty action list\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the recipe for the desired item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Check if all required ingredients are available in the inventory\n  required_ingredients = {env.world.cookbook.index[ingredient]: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n  available_ingredients = {k: v for k, v in enumerate(env._current_state.inventory) if v > 0}\n\n  # If all ingredients are not available, return an empty action list\n  if any(required_ingredient not in available_ingredients or available_ingredients[required_ingredient] < count \n         for required_ingredient, count in required_ingredients.items()):\n    return []\n\n  # Find the workshop index where the item should be crafted\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  def generate_path_to_workshop(current_state, workshop_index):\n      # This function will implement a simple pathfinding algorithm to move towards the nearest workshop.\n      # For simplicity, we'll use a basic flood fill approach here.\n      queue = collections.deque([current_state.pos])\n      visited = set([current_state.pos])\n      parent = {current_state.pos: None}\n      \n      while queue:\n          x, y = queue.popleft()\n          \n          # Check if we are next to the workshop\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if env.world.grid[nx][ny] == workshop_index:\n                  # Backtrack to find the path\n                  path = []\n                  while (nx, ny) != current_state.pos:\n                      path.append((nx, ny))\n                      nx, ny = parent[(nx, ny)]\n                  return path[::-1]\n              \n              if 0 <= nx < env.world.grid.shape[0] and 0 <= ny < env.world.grid.shape[1] and (nx, ny) not in visited:\n                  queue.append((nx, ny))\n                  visited.add((nx, ny))\n                  parent[(nx, ny)] = (x, y)\n      \n      return None\n\n  def generate_actions_from_path(path, current_state):\n      actions = []\n      for next_pos in path:\n          dx, dy = next_pos[0] - current_state.pos[0], next_pos[1] - current_state.pos[1]\n          if (dx, dy) == (-1, 0):\n              actions.append(2)  # LEFT\n          elif (dx, dy) == (1, 0):\n              actions.append(3)  # RIGHT\n          elif (dx, dy) == (0, -1):\n              actions.append(0)  # DOWN\n          elif (dx, dy) == (0, 1):\n              actions.append(1)  # UP\n      \n      return actions\n\n  def is_next_to_workshop(current_state, workshop_index):\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          neighbor_pos = (current_state.pos[0] + dx, current_state.pos[1] + dy)\n          if env.world.grid[neighbor_pos] == workshop_index:\n              return True\n      return False\n\n  # Generate the path to the nearest workshop\n  path_to_workshop = generate_path_to_workshop(env._current_state, workshop_index)\n\n  if not path_to_workshop:\n      return []\n\n  actions = generate_actions_from_path(path_to_workshop, env._current_state)\n\n  # Once at the workshop, face it and perform the USE action\n  if is_next_to_workshop(env._current_state, workshop_index):\n      target_dir = ((1, 0), (-1, 0), (0, -1), (0, 1)).index((path_to_workshop[-1][0] - env._current_state.pos[0], path_to_workshop[-1][1] - env._current_state.pos[1]))\n      current_dir = ((1, 0), (-1, 0), (0, -1), (0, 1)).index(env._current_state.dir)\n      \n      if current_dir != target_dir:\n          actions.append((target_dir + 2) % 4)  # Turn to face the workshop\n      \n      actions.append(4)  # USE action to craft at the workshop\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T14:11:45.969494", "function_name": "craft", "function_body": "  def find_closest_position_with_space_for_workshop(workshop_index):\n    grid = env._current_state.grid\n    agent_pos = env._current_state.pos\n    closest_distance = float('inf')\n    closest_position = None\n\n    for x in range(grid.shape[0]):\n        for y in range(grid.shape[1]):\n            if (grid[x, y, workshop_index] > 0 and\n                grid[x + 1, y, 0] == 0 and grid[x - 1, y, 0] == 0 and  # Check adjacent cells are empty\n                grid[x, y + 1, 0] == 0 and grid[x, y - 1, 0] == 0):\n                distance = abs(x - agent_pos[0]) + abs(y - agent_pos[1])\n                if distance < closest_distance:\n                    closest_distance = distance\n                    closest_position = (x, y)\n\n    return closest_position\n\n  def move_towards_position(agent_pos, target_pos):\n      dx, dy = target_pos[0] - agent_pos[0], target_pos[1] - agent_pos[1]\n      actions = []\n      if dx > 0:\n          for _ in range(dx):\n              actions.append(3)  # RIGHT\n      elif dx < 0:\n          for _ in range(-dx):\n              actions.append(2)  # LEFT\n      if dy > 0:\n          for _ in range(dy):\n              actions.append(1)  # UP\n      elif dy < 0:\n          for _ in range(-dy):\n              actions.append(0)  # DOWN\n      return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item has a recipe\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the required primitives and their counts for crafting the item\n  recipe = env.world.cookbook.recipes[item_index]\n  required_primitives = {ingredient: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n\n  # Check if we have all the required primitives in our inventory\n  current_inventory = env._current_state.inventory\n\n  missing_primitives = []\n\n  for primitive, count in required_primitives.items():\n    if current_inventory[primitive] < count:\n      missing_primitives.append((primitive, count))\n\n  # If there are any missing primitives, return an empty action list\n  if missing_primitives:\n    return []\n\n  # Determine the workshop where crafting should occur\n  workshop = recipe.get(\"_at\", None)\n  if not workshop:\n    return []\n\n  workshop_index = env.world.cookbook.index[workshop]\n\n  # Find the closest position next to the workshop with enough space around it\n  closest_workshop_pos = find_closest_position_with_space_for_workshop(workshop_index)\n\n  if not closest_workshop_pos:\n    return []\n\n  # Calculate the direction to move towards the closest workshop\n  agent_pos = env._current_state.pos\n  actions_to_take = move_towards_position(agent_pos, closest_workshop_pos)\n\n  # Append USE action to craft the item\n  actions_to_take.append(4)  # USE action\n\n  return actions_to_take", "island_id": 7, "scores": {"3": 5.0}}
{"timestamp": "2025-09-11T14:11:47.036350", "function_name": "craft", "function_body": "  def find_closest_position_with_space_for_workshop(workshop_index):\n    grid = env._current_state.grid\n    agent_pos = env._current_state.pos\n    closest_distance = float('inf')\n    closest_position = None\n\n    for x in range(grid.shape[0]):\n        for y in range(grid.shape[1]):\n            if (grid[x, y, workshop_index] > 0 and\n                grid[x + 1, y, 0] == 0 and grid[x - 1, y, 0] == 0 and  # Check adjacent cells are empty\n                grid[x, y + 1, 0] == 0 and grid[x, y - 1, 0] == 0):\n                distance = abs(x - agent_pos[0]) + abs(y - agent_pos[1])\n                if distance < closest_distance:\n                    closest_distance = distance\n                    closest_position = (x, y)\n\n    return closest_position\n\n  def move_towards_position(agent_pos, target_pos):\n      dx, dy = target_pos[0] - agent_pos[0], target_pos[1] - agent_pos[1]\n      actions = []\n      if dx > 0:\n          for _ in range(dx):\n              actions.append(3)  # RIGHT\n      elif dx < 0:\n          for _ in range(-dx):\n              actions.append(2)  # LEFT\n      if dy > 0:\n          for _ in range(dy):\n              actions.append(1)  # UP\n      elif dy < 0:\n          for _ in range(-dy):\n              actions.append(0)  # DOWN\n      return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item has a recipe\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the required primitives and their counts for crafting the item\n  recipe = env.world.cookbook.recipes[item_index]\n  required_primitives = {ingredient: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n\n  # Check if we have all the required primitives in our inventory\n  current_inventory = env._current_state.inventory\n\n  missing_primitives = []\n\n  for primitive, count in required_primitives.items():\n    if current_inventory[primitive] < count:\n      missing_primitives.append((primitive, count))\n\n  # If there are any missing primitives, return an empty action list\n  if missing_primitives:\n    return []\n\n  # Determine the workshop where crafting should occur\n  workshop = recipe.get(\"_at\", None)\n  if not workshop:\n    return []\n\n  workshop_index = env.world.cookbook.index[workshop]\n\n  # Find the closest position next to the workshop\n  closest_workshop_pos = find_closest_position_with_space_for_workshop(workshop_index)\n\n  if not closest_workshop_pos:\n    return []\n\n  # Calculate the direction to move towards the closest workshop\n  agent_pos = env._current_state.pos\n  actions_to_take = move_towards_position(agent_pos, closest_workshop_pos)\n\n  # Append USE action to craft the item\n  actions_to_take.append(4)  # USE action\n\n  return actions_to_take", "island_id": 7, "scores": {"3": 5.0}}
{"timestamp": "2025-09-11T14:14:07.533056", "function_name": "craft", "function_body": "  def get_direction(current_pos, target_pos):\n    x_diff = target_pos[0] - current_pos[0]\n    y_diff = target_pos[1] - current_pos[1]\n\n    # Determine the direction to face based on the differences\n    if x_diff == 0 and y_diff == 0:\n      return None\n    elif abs(x_diff) > abs(y_diff):\n      return 3 if x_diff > 0 else 2  # RIGHT or LEFT\n    else:\n      return 1 if y_diff > 0 else 0  # UP or DOWN\n\n  def find_path(start, target):\n    actions = []\n    \n    start_x, start_y = divmod(start, env._current_state.grid.shape[1])\n    target_x, target_y = divmod(target, env._current_state.grid.shape[1])\n\n    open_set = []\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, target)}\n\n    heapq.heappush(open_set, (f_score[start], start))\n\n    while open_set:\n      _, current = heapq.heappop(open_set)\n\n      if current == target:\n        reconstruct_path(came_from, current)\n        break\n\n      cx, cy = divmod(current, env._current_state.grid.shape[1])\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = cx + dx, cy + dy\n\n        if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n          neighbor = nx * env._current_state.grid.shape[1] + ny\n          tentative_g_score = g_score[current] + 1\n\n          if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n            came_from[neighbor] = current\n            g_score[neighbor] = tentative_g_score\n            f_score[neighbor] = tentative_g_score + heuristic(neighbor, target)\n            heapq.heappush(open_set, (f_score[neighbor], neighbor))\n\n    def reconstruct_path(came_from, current):\n      total_path = []\n      while current in came_from:\n        cx, cy = divmod(current, env._current_state.grid.shape[1])\n        px, py = divmod(came_from[current], env._current_state.grid.shape[1])\n\n        dx, dy = px - cx, py - cy\n        direction_to_face = get_direction((cx, cy), (px, py))\n        \n        if direction_to_face is not None:\n          total_path.append(direction_to_face)\n        \n        current = came_from[current]\n      \n      actions.extend(reversed(total_path))\n\n    return actions\n\n  def heuristic(a, b):\n    ax, ay = divmod(a, env._current_state.grid.shape[1])\n    bx, by = divmod(b, env._current_state.grid.shape[1])\n\n    # Manhattan distance\n    return abs(ax - bx) + abs(ay - by)\n\n  actions = []\n\n  item_index = env.world.cookbook.index[item]\n\n  if not item_index:\n    return []\n\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  current_inventory = {env.world.cookbook.index.get(i): c for i, c in enumerate(env._current_state.inventory) if c > 0}\n\n  missing_primitives = []\n  for primitive_index, count in primitives_needed.items():\n    if current_inventory.get(primitive_index, 0) < count:\n      missing_primitives.append((primitive_index, count - current_inventory.get(primitive_index, 0)))\n\n  if missing_primitives:\n    return []\n\n  workshop_name = env.world.cookbook.recipes[item_index][\"_at\"]\n  workshop_indices = np.argwhere(env._current_state.grid[:, :, env.world.workshop_indices[0]] == env.world.cookbook.index[workshop_name])\n\n  if not workshop_indices.any():\n    return []\n\n  start_pos_flat = env._current_state.pos[0] * env._current_state.grid.shape[1] + env._current_state.pos[1]\n  target_workshop_position = (workshop_indices[0][0], workshop_indices[0][1])\n  target_pos_flat = target_workshop_position[0] * env._current_state.grid.shape[1] + target_workshop_position[1]\n\n  actions.extend(find_path(start_pos_flat, target_pos_flat))\n\n  direction_to_face = get_direction(env._current_state.pos, target_workshop_position)\n  if direction_to_face is not None:\n      actions.append(direction_to_face)\n\n  # Craft the item by using the USE action\n  actions.append(4)  # USE action\n\n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T14:14:08.577017", "function_name": "craft", "function_body": "  def get_direction(current_pos, target_pos):\n    x_diff = target_pos[0] - current_pos[0]\n    y_diff = target_pos[1] - current_pos[1]\n\n    # Determine the direction to face based on the differences\n    if x_diff == 0 and y_diff == 0:\n      return None\n    elif x_diff > 0:\n      return 3  # RIGHT\n    elif x_diff < 0:\n      return 2  # LEFT\n    elif y_diff > 0:\n      return 1  # UP\n    else:\n      return 0  # DOWN\n\n  def find_path(start, target):\n    actions = []\n    \n    start_x, start_y = divmod(start, env._current_state.grid.shape[1])\n    target_x, target_y = divmod(target, env._current_state.grid.shape[1])\n\n    open_set = []\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, target)}\n\n    heapq.heappush(open_set, (f_score[start], start))\n\n    while open_set:\n      _, current = heapq.heappop(open_set)\n\n      if current == target:\n        reconstruct_path(came_from, current)\n        break\n\n      cx, cy = divmod(current, env._current_state.grid.shape[1])\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = cx + dx, cy + dy\n\n        if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n          neighbor = nx * env._current_state.grid.shape[1] + ny\n          tentative_g_score = g_score[current] + 1\n\n          if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n            came_from[neighbor] = current\n            g_score[neighbor] = tentative_g_score\n            f_score[neighbor] = tentative_g_score + heuristic(neighbor, target)\n            heapq.heappush(open_set, (f_score[neighbor], neighbor))\n\n    def reconstruct_path(came_from, current):\n      total_path = []\n      while current in came_from:\n        cx, cy = divmod(current, env._current_state.grid.shape[1])\n        px, py = divmod(came_from[current], env._current_state.grid.shape[1])\n\n        dx, dy = px - cx, py - cy\n        direction_to_face = get_direction((cx, cy), (px, py))\n        \n        if direction_to_face is not None:\n          total_path.append(direction_to_face)\n        \n        current = came_from[current]\n      \n      actions.extend(reversed(total_path))\n\n    return actions\n\n  def heuristic(a, b):\n    ax, ay = divmod(a, env._current_state.grid.shape[1])\n    bx, by = divmod(b, env._current_state.grid.shape[1])\n\n    # Manhattan distance\n    return abs(ax - bx) + abs(ay - by)\n\n  actions = []\n\n  item_index = env.world.cookbook.index[item]\n\n  if not item_index:\n    return []\n\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  current_inventory = {env.world.cookbook.index.get(i): c for i, c in enumerate(env._current_state.inventory) if c > 0}\n\n  missing_primitives = []\n  for primitive_index, count in primitives_needed.items():\n    if current_inventory.get(primitive_index, 0) < count:\n      missing_primitives.append((primitive_index, count - current_inventory.get(primitive_index, 0)))\n\n  if missing_primitives:\n    return []\n\n  workshop_name = env.world.cookbook.recipes[item_index][\"_at\"]\n  workshop_indices = np.argwhere(env._current_state.grid[:, :, env.world.workshop_indices[0]] == env.world.cookbook.index[workshop_name])\n\n  if not workshop_indices.any():\n    return []\n\n  start_pos_flat = env._current_state.pos[0] * env._current_state.grid.shape[1] + env._current_state.pos[1]\n  target_workshop_position = (workshop_indices[0][0], workshop_indices[0][1])\n  target_pos_flat = target_workshop_position[0] * env._current_state.grid.shape[1] + target_workshop_position[1]\n\n  actions.extend(find_path(start_pos_flat, target_pos_flat))\n\n  direction_to_face = get_direction(env._current_state.pos, target_workshop_position)\n  if direction_to_face is not None:\n      actions.append(direction_to_face)\n\n  # Ensure the agent is directly in front of the workshop\n  while env._current_state.pos != (target_workshop_position[0], target_workshop_position[1]):\n    current_pos = env._current_state.pos\n    direction_to_face = get_direction(current_pos, target_workshop_position)\n    \n    if direction_to_face is not None:\n      actions.append(direction_to_face)\n\n    # Move the agent to the new position\n    env.step(direction_to_face)\n\n  # Craft the item by using the USE action\n  actions.append(4)  # USE action\n\n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T14:15:05.063881", "function_name": "craft", "function_body": "  index = env.world.cookbook.index\n  recipe_index = index[item]\n  \n  # Check if the item can be crafted at all\n  if recipe_index not in env.world.cookbook.recipes:\n    print(f\"No recipe found for {item}.\")\n    return []\n\n  recipe = env.world.cookbook.recipes[recipe_index]\n  required_items = {index.get(i): count for i, count in recipe.items() if i != \"_at\"}\n  workshop_name = recipe[\"_at\"]\n\n  # Check inventory to see if we have all the required items\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory)}\n  \n  actions_to_take = []\n\n  # Collect missing primitives if necessary\n  for primitive, required_count in required_items.items():\n    current_count = inventory_dict.get(primitive, 0)\n    if current_count < required_count:\n      print(f\"Collecting {primitive}...\")\n      collect_actions = collect_v2(env, primitive)\n      actions_to_take.extend(collect_actions)\n\n  # Go to the workshop\n  workshop_index = env.world.cookbook.index[workshop_name]\n  workshop_pos = find_workshop_position(env, workshop_index)\n  \n  if workshop_pos is None:\n    print(f\"No {workshop_name} found on the grid.\")\n    return []\n\n  move_actions = navigate_to_position_v2(env._current_state.pos, workshop_pos, env.world.cookbook.index)\n  actions_to_take.extend(move_actions)\n\n  # Turn towards the workshop\n  final_dir = get_direction_towards(env._current_state.pos, workshop_pos)\n  turn_actions = face_direction_v2(final_dir)\n  actions_to_take.extend(turn_actions)\n\n  # Use the workshop to craft the item\n  actions_to_take.append(craft.ACTION_USE)\n\n  return actions_to_take", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-11T14:15:06.061300", "function_name": "craft", "function_body": "  # Step 1: Find the index of the desired item.\n  item_index = env.world.cookbook.index[item]\n  \n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"No recipe for {item}\")\n    \n  # Step 2: Get the primitives required to craft the item.\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n\n  # Step 3: Check if we have all the required primitives in our inventory.\n  current_inventory = env._current_state.inventory\n  for prim, count in required_primitives.items():\n    if current_inventory[prim] < count:\n      return []  # Not enough items to craft yet.\n\n  # Step 4: Find the workshop where we can craft this item.\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_key = recipe.get('_at', None)\n  \n  if not workshop_key or workshop_key not in env.world.cookbook.index:\n    raise ValueError(f\"No workshop specified for {item}\")\n    \n  workshop_index = env.world.cookbook.index[workshop_key]\n  workshop_indices = [i for i, idx in enumerate(env._current_state.grid) if any(idx == workshop_index)]\n\n  # Assuming there's at least one workshop of the required type.\n  if not workshop_indices:\n    raise ValueError(f\"No {workshop_key} available to craft {item}\")\n\n  # Step 5: Navigate to a workshop and craft the item.\n  actions = []\n  for workshop_pos in workshop_indices:\n    x, y = workshop_pos\n    dx, dy = x - env._current_state.pos[0], y - env._current_state.pos[1]\n    \n    # Move towards the workshop (simple movement logic).\n    while dx != 0 or dy != 0:\n      if dx < 0:\n        actions.append(env.world.N_ACTIONS.DOWN)\n        dx += 1\n      elif dx > 0:\n        actions.append(env.world.N_ACTIONS.UP)\n        dx -= 1\n      \n      if dy < 0:\n        actions.append(env.world.N_ACTIONS.LEFT)\n        dy += 1\n      elif dy > 0:\n        actions.append(env.world.N_ACTIONS.RIGHT)\n        dy -= 1\n    \n    # Face the workshop and use it.\n    actions.extend([env.world.N_ACTIONS.USE])\n  \n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-11T14:16:31.710572", "function_name": "craft", "function_body": "  goal_index = env.world.cookbook.index[item]\n\n  # Check if we have all required primitives in our inventory\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  current_inventory = collections.Counter(env._current_state.inventory)\n\n  for primitive, count in required_primitives.items():\n    if current_inventory[primitive] < count:\n      return []  # Missing required primitives\n\n  # Determine the workshop where crafting should occur\n  recipe_details = env.world.cookbook.recipes[goal_index]\n  workshop_name = recipe_details[\"_key\"]\n\n  # Get the index of the workshop from the world's cookbook\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the closest workshop in the grid\n  positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(positions) == 0:\n    return []  # No available workshops\n\n  closest_workshop_pos = min(\n      positions, key=lambda x: abs(x[0] - env._current_state.pos[0]) + abs(x[1] - env._current_state.pos[1]))\n\n  # Navigate to the closest workshop\n  current_pos = np.array(env._current_state.pos)\n  target_pos = np.array(closest_workshop_pos)\n\n  actions = []\n\n  while not np.array_equal(current_pos, target_pos):\n    delta = target_pos - current_pos\n\n    # Calculate direction based on the largest absolute difference\n    if abs(delta[0]) > abs(delta[1]):\n      if delta[0] > 0:\n        actions.append(craft.RIGHT)  # Move right\n      else:\n        actions.append(craft.LEFT)   # Move left\n    else:\n      if delta[1] > 0:\n        actions.append(craft.DOWN)   # Move down\n      else:\n        actions.append(craft.UP)     # Move up\n\n    current_pos = np.array(env._current_state.pos)\n\n  # Orient the agent to face the workshop and use it\n  if env._current_state.grid[target_pos[0], target_pos[1], workshop_index] == 1:\n    # Ensure the agent is facing the correct direction\n    direction_to_workshop = target_pos - current_pos\n\n    # Calculate the direction based on the relative position of the workshop\n    if direction_to_workshop[0] > 0:  # Workshop is to the right\n      actions.append(craft.RIGHT)\n    elif direction_to_workshop[0] < 0:  # Workshop is to the left\n      actions.append(craft.LEFT)\n    elif direction_to_workshop[1] > 0:  # Workshop is below\n      actions.append(craft.DOWN)\n    else:  # Workshop is above\n      actions.append(craft.UP)\n\n    actions.append(craft.USE)\n\n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T14:16:32.792488", "function_name": "craft", "function_body": "  def navigate_to_position(current_pos, target_pos):\n    delta = target_pos - current_pos\n    actions = []\n\n    # Calculate direction based on the largest absolute difference\n    if abs(delta[0]) > abs(delta[1]):\n      if delta[0] > 0:\n        actions.append(craft.RIGHT)  # Move right\n      else:\n        actions.append(craft.LEFT)   # Move left\n    else:\n      if delta[1] > 0:\n        actions.append(craft.DOWN)   # Move down\n      else:\n        actions.append(craft.UP)     # Move up\n\n    return actions\n\n  goal_index = env.world.cookbook.index[item]\n\n  # Check if we have all required primitives in our inventory\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  current_inventory = collections.Counter(env._current_state.inventory)\n\n  for primitive, count in required_primitives.items():\n    if current_inventory[primitive] < count:\n      return []  # Missing required primitives\n\n  # Determine the workshop where crafting should occur\n  recipe_details = env.world.cookbook.recipes[goal_index]\n  workshop_name = recipe_details[\"_key\"]\n\n  # Get the index of the workshop from the world's cookbook\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the closest workshop in the grid\n  positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(positions) == 0:\n    return []  # No available workshops\n\n  closest_workshop_pos = min(\n      positions, key=lambda x: abs(x[0] - env._current_state.pos[0]) + abs(x[1] - env._current_state.pos[1]))\n\n  # Navigate to the closest workshop\n  current_pos = np.array(env._current_state.pos)\n  target_pos = np.array(closest_workshop_pos)\n\n  actions = []\n\n  while not np.array_equal(current_pos, target_pos):\n    actions.extend(navigate_to_position(current_pos, target_pos))\n    current_pos = np.array(env._current_state.pos)\n\n  # Orient the agent to face the workshop and use it\n  if env._current_state.grid[target_pos[0], target_pos[1], workshop_index] == 1:\n      # Ensure the agent is facing the correct direction\n      direction_to_workshop = target_pos - current_pos\n\n      if direction_to_workshop[0] > 0:  # Workshop is to the right\n          actions.append(craft.RIGHT)\n      elif direction_to_workshop[0] < 0:  # Workshop is to the left\n          actions.append(craft.LEFT)\n      elif direction_to_workshop[1] > 0:  # Workshop is below\n          actions.append(craft.DOWN)\n      else:  # Workshop is above\n          actions.append(craft.UP)\n\n      actions.append(craft.USE)\n\n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T14:19:14.528614", "function_name": "craft", "function_body": "  def get_direction(current_pos, target_pos):\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    if abs(dx) > abs(dy):\n      return 3 if dx > 0 else 2\n    elif abs(dx) < abs(dy):\n      return 1 if dy > 0 else 0\n    elif dx > 0:\n      return 3  # RIGHT\n    elif dx < 0:\n      return 2  # LEFT\n    elif dy > 0:\n      return 1  # UP\n    elif dy < 0:\n      return 0  # DOWN\n\n  def navigate(state, target_pos):\n    path = []\n    current_pos = state.pos\n    \n    while current_pos != target_pos:\n      direction = get_direction(current_pos, target_pos)\n      \n      if direction == 0:  # DOWN\n        path.append(0)\n        current_pos = (current_pos[0], current_pos[1] - 1)\n      elif direction == 1:  # UP\n        path.append(1)\n        current_pos = (current_pos[0], current_pos[1] + 1)\n      elif direction == 2:  # LEFT\n        path.append(2)\n        current_pos = (current_pos[0] - 1, current_pos[1])\n      elif direction == 3:  # RIGHT\n        path.append(3)\n        current_pos = (current_pos[0] + 1, current_pos[1])\n    \n    return path\n\n  def turn_to_face(state, target_pos):\n    dx = target_pos[0] - state.pos[0]\n    dy = target_pos[1] - state.pos[1]\n\n    if abs(dx) > abs(dy):\n      return 3 if dx > 0 else 2\n    elif abs(dx) < abs(dy):\n      return 1 if dy > 0 else 0\n    elif dx > 0:\n      return 3  # RIGHT\n    elif dx < 0:\n      return 2  # LEFT\n    elif dy > 0:\n      return 1  # UP\n    elif dy < 0:\n      return 0  # DOWN\n\n  def has_all_primitives(required_primitives, inventory_dict):\n    return all(primitive in inventory_dict and inventory_dict[primitive] >= required_primitives[primitive] for primitive in required_primitives)\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  # If not all primitives are available return empty action list\n  if not has_all_primitives(required_primitives, inventory_dict):\n    return []\n  \n  # Find the workshop where we can craft this item\n  workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n      workshop_index = recipe.get(\"_at\")\n      break\n  \n  if workshop_index is None:\n    return []\n\n  # Find the position of the nearest workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(workshop_positions) == 0:\n    return []\n  \n  # Select the closest workshop (for simplicity, we take the first one found)\n  target_workshop_pos = tuple(min(workshop_positions, key=lambda x: abs(x[0] - env._current_state.pos[0]) + abs(x[1] - env._current_state.pos[1])))\n\n  # Navigate to the selected workshop\n  actions = navigate(env._current_state, target_workshop_pos)\n\n  # Turn towards the workshop if not already facing it\n  current_direction = env._current_state.dir\n  direction_to_workshop = turn_to_face(env._current_state, target_workshop_pos)\n  \n  # Check if we need to turn\n  if current_direction != direction_to_workshop:\n    actions.append(direction_to_workshop)\n\n  # Use the USE action to craft the item at the workshop\n  actions.append(4)  # Assuming 4 is the index for the USE action\n  \n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T14:19:15.592691", "function_name": "craft", "function_body": "  def get_direction(current_pos, target_pos):\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    if abs(dx) > abs(dy):\n      return 3 if dx > 0 else 2\n    elif abs(dx) < abs(dy):\n      return 1 if dy > 0 else 0\n    elif dx > 0:\n      return 3  # RIGHT\n    elif dx < 0:\n      return 2  # LEFT\n    elif dy > 0:\n      return 1  # UP\n    elif dy < 0:\n      return 0  # DOWN\n\n  def navigate(state, target_pos):\n    path = []\n    current_pos = state.pos\n    \n    while current_pos != target_pos:\n      direction = get_direction(current_pos, target_pos)\n      \n      if direction == 0:  # DOWN\n        path.append(0)\n        current_pos = (current_pos[0], current_pos[1] - 1)\n      elif direction == 1:  # UP\n        path.append(1)\n        current_pos = (current_pos[0], current_pos[1] + 1)\n      elif direction == 2:  # LEFT\n        path.append(2)\n        current_pos = (current_pos[0] - 1, current_pos[1])\n      elif direction == 3:  # RIGHT\n        path.append(3)\n        current_pos = (current_pos[0] + 1, current_pos[1])\n    \n    return path\n\n  def turn_to_face(state, target_pos):\n    dx = target_pos[0] - state.pos[0]\n    dy = target_pos[1] - state.pos[1]\n\n    if abs(dx) > abs(dy):\n      return 3 if dx > 0 else 2\n    elif abs(dx) < abs(dy):\n      return 1 if dy > 0 else 0\n    elif dx > 0:\n      return 3  # RIGHT\n    elif dx < 0:\n      return 2  # LEFT\n    elif dy > 0:\n      return 1  # UP\n    elif dy < 0:\n      return 0  # DOWN\n\n  def has_all_primitives(required_primitives, inventory_dict):\n    return all(primitive in inventory_dict and inventory_dict[primitive] >= required_primitives[primitive] for primitive in required_primitives)\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  # If not all primitives are available return empty action list\n  if not has_all_primitives(required_primitives, inventory_dict):\n    return []\n  \n  # Find the workshop where we can craft this item\n  workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n      workshop_index = recipe.get(\"_at\")\n      break\n  \n  if workshop_index is None:\n    return []\n\n  # Convert workshop index to the actual name of the workshop\n  workshop_name = env.world.cookbook.index.get(workshop_index)\n  \n  # Find the position of the nearest workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(workshop_positions) == 0:\n    return []\n  \n  # Select the closest workshop (for simplicity, we take the first one found)\n  target_workshop_pos = tuple(min(workshop_positions, key=lambda x: abs(x[0] - env._current_state.pos[0]) + abs(x[1] - env._current_state.pos[1])))\n\n  # Navigate to the selected workshop\n  actions = navigate(env._current_state, target_workshop_pos)\n  \n  # Turn towards the workshop if not already facing it\n  current_direction = env._current_state.dir\n  direction_to_workshop = turn_to_face(env._current_state, target_workshop_pos)\n  \n  # Check if we need to turn\n  if current_direction != direction_to_workshop:\n    actions.append(direction_to_workshop)\n\n  # Use the USE action to craft the item at the workshop\n  actions.append(4)  # Assuming 4 is the index for the USE action\n  \n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T14:19:52.571923", "function_name": "craft", "function_body": "  def get_required_primitives(item_index):\n    \"\"\"Get the required primitives for crafting an item by its index.\"\"\"\n    return env.world.cookbook.primitives_for(item_index)\n\n  # Get the item index from the name\n  item_index = env.world.cookbook.index[item]\n  \n  if not item_index:\n    print(f\"Unknown item: {item}\")\n    return []\n  \n  required_primitives = get_required_primitives(item_index)\n  \n  # Check if we have all required primitives in our inventory\n  for primitive, count in required_primitives.items():\n    if env._current_state.inventory[primitive] < count:\n      print(f\"Missing {count} of item {env.world.cookbook.index.get(primitive)}\")\n      return []\n  \n  actions = []\n\n  # If we have all primitives, proceed to craft the item\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_index = env.world.workshop_indices[recipe['_at']]\n  workshop_location = None\n\n  # Find a location near a workshop\n  for x in range(env._current_state.grid.shape[0]):\n    for y in range(env._current_state.grid.shape[1]):\n      if env._current_state.grid[x, y, workshop_index] > 0:\n        workshop_location = (x, y)\n        break\n    if workshop_location:\n      break\n\n  if not workshop_location:\n    print(f\"No available {recipe['_at']} found for crafting {item}\")\n    return []\n\n  # Move to the workshop location\n  actions.extend(move_to(env._current_state, workshop_location))\n\n  # Turn towards the workshop block and perform USE action\n  direction = calculate_direction(env._current_state.pos, workshop_location)\n  actions.append(direction)\n  actions.append(craft.USE)\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
