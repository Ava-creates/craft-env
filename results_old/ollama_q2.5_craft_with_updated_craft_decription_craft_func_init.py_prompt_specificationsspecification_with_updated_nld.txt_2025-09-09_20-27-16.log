grid.shape[1]):\n      if np.any(env._current_state.grid[y, x, workshop_idx] > 0):\n        distance = abs(y - env._current_state.pos[0]) + abs(x - env._current_state.pos[1])\n        if distance < min_distance:\n          min_distance = distance\n          closest_workshop_pos = (y, x)\n\n  # If no workshop is found, return an empty action list\n  if closest_workshop_pos is None:\n    return []\n\n  # Calculate actions needed to move to the closest workshop\n  target_x, target_y = closest_workshop_pos\n\n  while env._current_state.pos[0] != target_x or env._current_state.pos[1] != target_y:\n    actions.extend(move_to_position(target_x, target_y))\n\n  # Finally, use the workshop to craft the item\n  actions.append(env.world.cookbook.index[\"USE_FUNC\"])\n  \n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T04:02:10.143174", "function_name": "craft", "function_body": "  def move_to_position(target_x, target_y):\n    current_x, current_y = env._current_state.pos\n    actions = []\n    \n    # Move horizontally first\n    while current_y != target_y:\n      direction = \"RIGHT\" if current_y < target_y else \"LEFT\"\n      actions.append(env.world.cookbook.index[\"MOVE_FUNC_\" + direction])\n      current_y += 1 if current_y < target_y else -1\n    \n    # Then move vertically\n    while current_x != target_x:\n      direction = \"DOWN\" if current_x < target_x else \"UP\"\n      actions.append(env.world.cookbook.index[\"MOVE_FUNC_\" + direction])\n      current_x += 1 if current_x < target_x else -1\n    \n    return actions\n\n  def face_workshop(target_x, target_y):\n    current_x, current_y = env._current_state.pos\n    actions = []\n    \n    # Determine the final direction needed to face the workshop\n    dx = target_x - current_x\n    dy = target_y - current_y\n    \n    if dx > 0:\n      actions.append(env.world.cookbook.index[\"MOVE_FUNC_DOWN\"])\n    elif dx < 0:\n      actions.append(env.world.cookbook.index[\"MOVE_FUNC_UP\"])\n    \n    if dy > 0:\n      actions.append(env.world.cookbook.index[\"MOVE_FUNC_RIGHT\"])\n    elif dy < 0:\n      actions.append(env.world.cookbook.index[\"MOVE_FUNC_LEFT\"])\n    \n    return actions\n\n  actions = []\n  \n  # Get the index of the desired item from the cookbook\n  i_goal = env.world.cookbook.index[item]\n  \n  # Get the recipe for the goal item\n  recipe = env.world.cookbook.recipes[i_goal]\n\n  # Check if we have all the ingredients in our inventory to craft the item\n  required_primitives = env.world.cookbook.primitives_for(i_goal)\n  inventory_dict = {env.world.cookbook.index.get(idx): count for idx, count in enumerate(env._current_state.inventory) if count > 0}\n\n  # Check if we have all the primitives needed\n  have_all_primitives = all(primitive in inventory_dict and inventory_dict[primitive] >= required_primitives[idx] for primitive, idx in required_primitives.items())\n\n  if not have_all_primitives:\n    return []  # We can't craft the item as we don't have all ingredients\n\n  # Now that we have all the primitives, let's go to the workshop and use it to craft the item\n  workshop = recipe[\"_key\"]\n  workshop_idx = env.world.cookbook.index[workshop]\n\n  # Get the position of the closest workshop from our current position in the grid\n  min_distance = float('inf')\n  closest_workshop_pos = None\n\n  for y in range(env._current_state.grid.shape[0]):\n    for x in range(env._current_state.grid.shape[1]):\n      if np.any(env._current_state.grid[y, x, workshop_idx] > 0):\n        distance = abs(y - env._current_state.pos[0]) + abs(x - env._current_state.pos[1])\n        if distance < min_distance:\n          min_distance = distance\n          closest_workshop_pos = (y, x)\n\n  # If no workshop is found, return an empty action list\n  if closest_workshop_pos is None:\n    return []\n\n  # Calculate actions needed to move to the closest workshop\n  target_x, target_y = closest_workshop_pos\n\n  actions.extend(move_to_position(target_x, target_y))\n\n  # Now face the workshop and use it to craft the item\n  actions.extend(face_workshop(target_x, target_y))\n  actions.append(env.world.cookbook.index[\"USE_FUNC\"])\n  \n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T04:03:27.051203", "function_name": "craft", "function_body": "  index = env.world.cookbook.index\n  goal_index = index[item]\n\n  if goal_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"No recipe found for item: {item}\")\n\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n\n  # Check inventory for required primitives\n  available_primitives = {index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0 and index.get(i) is not None}\n  \n  actions = []\n  missing_primitives = {}\n\n  for primitive, count in required_primitives.items():\n    if primitive not in available_primitives or available_primitives[primitive] < count:\n      missing_primitives[primitive] = count - available_primitives.get(primitive, 0)\n\n  # If we have all the primitives, proceed to craft\n  if not missing_primitives:\n    workshop_index = None\n    for recipe_ingredients in env.world.cookbook.recipes.values():\n      if goal_index in recipe_ingredients and \"_key\" in recipe_ingredients:\n        workshop_key = recipe_ingredients[\"_key\"]\n        workshop_index = index[workshop_key]\n    \n    if workshop_index is None:\n      raise ValueError(f\"No workshop found for item: {item}\")\n    \n    # Find the nearest workshop\n    workshops = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    if not workshops.any():\n      raise ValueError(\"No available workshops on the grid.\")\n    \n    closest_workshop = min(workshops, key=lambda w: np.linalg.norm(np.array(w) - np.array(env._current_state.pos)))\n    \n    # Navigate to the closest workshop\n    path_to_workshop = a_star_search(env._current_state.grid, env._current_state.pos, tuple(closest_workshop), env.world.non_grabbable_indices)\n    actions.extend([env.action_specs()[d] for d in path_to_workshop])\n    \n    # Turn towards the workshop (assuming USE action faces the block)\n    direction_to_face = face_towards(env._current_state.pos, closest_workshop, env._current_state.dir)\n    if direction_to_face != env._current_state.dir:\n      actions.append(direction_to_face)\n    \n    # Perform USE action to craft\n    actions.append(env.action_specs()[\"USE\"])\n  \n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T04:03:28.008698", "function_name": "craft", "function_body": "  index = env.world.cookbook.index\n  goal_index = index[item]\n  \n  if goal_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"No recipe found for item: {item}\")\n\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  \n  actions = []\n  missing_primitives = {}\n\n  # Check inventory for required primitives\n  available_primitives = {index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0 and index.get(i) is not None}\n\n  for primitive, count in required_primitives.items():\n    if primitive not in available_primitives or available_primitives[primitive] < count:\n      missing_primitives[primitive] = count - available_primitives.get(primitive, 0)\n\n  # Collect missing primitives\n  for primitive, count in missing_primitives.items():\n    actions.extend(collect(env, primitive, count))\n  \n  workshop_index = None\n  for recipe_ingredients in env.world.cookbook.recipes.values():\n      if goal_index in recipe_ingredients:\n        workshop_key = recipe_ingredients[\"_key\"]\n        workshop_index = index[workshop_key]\n    \n  if workshop_index is None:\n    raise ValueError(f\"No workshop found for item: {item}\")\n  \n  # Find the nearest workshop\n  workshops = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if not workshops.any():\n    raise ValueError(\"No available workshops on the grid.\")\n  \n  closest_workshop = min(workshops, key=lambda w: np.linalg.norm(np.array(w) - np.array(env._current_state.pos)))\n  \n  # Navigate to the closest workshop\n  path_to_workshop = a_star_search(env._current_state.grid, env._current_state.pos, tuple(closest_workshop), env.world.non_grabbable_indices)\n  actions.extend([env.action_specs()[d] for d in path_to_workshop])\n  \n  # Turn towards the workshop (assuming USE action faces the block)\n  direction_to_face = face_towards(env._current_state.pos, closest_workshop, env._current_state.dir)\n  if direction_to_face != env._current_state.dir:\n    actions.append(direction_to_face)\n  \n  # Perform USE action to craft\n  actions.append(env.action_specs()[\"USE\"])\n  \n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-10T04:05:32.302381", "function_name": "craft", "function_body": "  def find_workshop_for_item(item_idx):\n    # Find the workshop that can craft the item\n    for recipe in env.world.cookbook.recipes.values():\n      if \"_key\" in recipe and recipe[\"_key\"] == item_idx:\n        return recipe.get(\"_at\", None)\n    return None\n\n  def get_primitive_counts(primitive_indices, inventory):\n    # Get the counts of primitives in the inventory\n    return {i: inventory[i] for i in primitive_indices}\n\n  def collect_primitives(env, primitive_indices, required_counts):\n    actions = []\n    for i in primitive_indices:\n      while env._current_state.inventory[i] < required_counts[i]:\n        primitive_name = env.world.cookbook.index.get(i)\n        if not primitive_name:  # If the primitive name is not found, return an empty list\n          print(f\"Primitive {i} not found in cookbook index.\")\n          return []\n        \n        collect_actions = collect(env, primitive_name)\n        if not collect_actions:  # If no actions are returned to collect the item, return an empty list\n          print(f\"No actions returned for collecting {primitive_name}.\")\n          return []\n\n        actions.extend(collect_actions)\n\n        # Execute the collect actions to update the inventory\n        # This simulates the environment's response after executing the actions\n        for action in collect_actions:\n          reward, done, observations = env.step(action)\n          if done:  # If the environment is done after collecting an item, return an empty list\n            print(f\"Environment done while collecting {primitive_name}.\")\n            return []\n\n    return actions\n\n  def find_closest_workshop(env, workshop_idx):\n    from collections import deque\n    \n    directions = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n    queue = deque([(env._current_state.pos, [])])\n    visited = set()\n    \n    while queue:\n        (x, y), path = queue.popleft()\n        if env._current_state.grid[x, y, workshop_idx] > 0:\n            return x, y, path\n        for dx, dy in directions:\n            nx, ny = x + dx, y + dy\n            if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n                if (nx, ny) not in visited:\n                    visited.add((nx, ny))\n                    queue.append(((nx, ny), path + [(dx, dy)]))\n    return None\n\n  def navigate_to_position(path):\n      actions = []\n      for dx, dy in path:\n          if dx > 0:\n              actions.append(env.ACTIONS.index(\"DOWN\"))\n          elif dx < 0:\n              actions.append(env.ACTIONS.index(\"UP\"))\n          if dy > 0:\n              actions.append(env.ACTIONS.index(\"RIGHT\"))\n          elif dy < 0:\n              actions.append(env.ACTIONS.index(\"LEFT\"))\n      return actions\n\n  def use_action():\n      return env.ACTIONS.index(\"USE\")\n\n  # Get the index of the item to craft\n  item_idx = env.world.cookbook.index[item]\n  \n  # Check if we have a recipe for this item\n  if item_idx not in env.world.cookbook.recipes:\n    print(f\"No recipe found for {item}.\")\n    return []\n  \n  # Get the ingredients required and their counts\n  ingredients = {k: v for k, v in env.world.cookbook.recipes[item_idx].items() if k != \"_at\"}\n  \n  # Find the workshop for crafting the item\n  workshop_name = find_workshop_for_item(item_idx)\n  if workshop_name is None:\n    print(f\"No workshop found for crafting {item}.\")\n    return []\n  \n  # Find the index of the workshop in the environment\n  workshop_idx = env.world.workshop_indices[workshop_name]\n  \n  # Collect primitives required for crafting\n  actions = collect_primitives(env, list(ingredients.keys()), ingredients)\n\n  # Check if we have collected enough primitives\n  inventory = env._current_state.inventory.copy()\n  for i, count in ingredients.items():\n    if inventory[i] < count:\n        print(f\"Not enough {env.world.cookbook.index.get(i)} to craft {item}.\")\n        return []  # If we can't collect enough primitives, return an empty action list\n  \n  workshop_info = find_closest_workshop(env, workshop_idx)\n  if not workshop_info:\n    print(\"No path found to the closest workshop.\")\n    return []\n  \n  _, _, path_to_workshop = workshop_info\n  actions.extend(navigate_to_position(path_to_workshop))\n  actions.append(use_action())\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-10T04:05:33.350388", "function_name": "craft", "function_body": "  def find_workshop_for_item(item_idx):\n    # Find the workshop that can craft the item\n    for recipe in env.world.cookbook.recipes.values():\n      if \"_key\" in recipe and recipe[\"_key\"] == item_idx:\n        return recipe.get(\"_at\", None)\n    return None\n\n  def get_primitive_counts(primitive_indices, inventory):\n    # Get the counts of primitives in the inventory\n    return {i: inventory[i] for i in primitive_indices}\n\n  def collect_primitives(env, primitive_indices, required_counts):\n    actions = []\n    inventory = env._current_state.inventory.copy()  # Start with a copy of the current inventory\n\n    for i in primitive_indices:\n      while inventory[i] < required_counts[i]:\n        primitive_name = env.world.cookbook.index.get(i)\n        if not primitive_name:  # If the primitive name is not found, return an empty list\n          return []\n        \n        collect_actions = collect(env, primitive_name)\n        if not collect_actions:  # If no actions are returned to collect the item, return an empty list\n          return []\n\n        for action in collect_actions:\n            reward, done, observations = env.step(action)\n            actions.append(action)\n            inventory = observations['inventory']\n            if done:\n                return []  # If the environment ends before collecting all primitives, return an empty action list\n\n    return actions\n\n  def find_closest_workshop(env, workshop_idx):\n    from collections import deque\n    \n    directions = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n    queue = deque([(env._current_state.pos, [])])\n    visited = set()\n    \n    while queue:\n        (x, y), path = queue.popleft()\n        if env._current_state.grid[x, y, workshop_idx] > 0:\n            return x, y, path\n        for dx, dy in directions:\n            nx, ny = x + dx, y + dy\n            if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n                if (nx, ny) not in visited:\n                    visited.add((nx, ny))\n                    queue.append(((nx, ny), path + [(dx, dy)]))\n    return None\n\n  def navigate_to_position(env, path):\n      actions = []\n      for dx, dy in path:\n          if dx > 0:\n              actions.append(env.ACTIONS.index(\"DOWN\"))\n          elif dx < 0:\n              actions.append(env.ACTIONS.index(\"UP\"))\n          if dy > 0:\n              actions.append(env.ACTIONS.index(\"RIGHT\"))\n          elif dy < 0:\n              actions.append(env.ACTIONS.index(\"LEFT\"))\n      return actions\n\n  def use_action():\n      return env.ACTIONS.index(\"USE\")\n\n  # Get the index of the item to craft\n  item_idx = env.world.cookbook.index[item]\n  \n  # Check if we have a recipe for this item\n  if item_idx not in env.world.cookbook.recipes:\n    return []\n  \n  # Get the ingredients required and their counts\n  ingredients = {k: v for k, v in env.world.cookbook.recipes[item_idx].items() if k != \"_at\"}\n  \n  # Find the workshop for crafting the item\n  workshop_name = find_workshop_for_item(item_idx)\n  if workshop_name is None:\n    return []\n  \n  # Find the index of the workshop in the environment\n  workshop_idx = env.world.workshop_indices[workshop_name]\n  \n  # Collect primitives required for crafting\n  actions = collect_primitives(env, list(ingredients.keys()), ingredients)\n\n  # Check if we have collected enough primitives\n  inventory = env._current_state.inventory.copy()\n  for i, count in ingredients.items():\n    if inventory[i] < count:\n        return []  # If we can't collect enough primitives, return an empty action list\n  \n  workshop_info = find_closest_workshop(env, workshop_idx)\n  if not workshop_info:\n    return []\n  \n  _, _, path_to_workshop = workshop_info\n  actions.extend(navigate_to_position(env, path_to_workshop))\n  actions.append(use_action())\n  \n  return actions", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T04:07:37.128321", "function_name": "craft", "function_body": "  def move_to_position(current_pos, target_pos):\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    actions = []\n    if dy < 0:\n      actions.extend([craft.ACTION_UP] * abs(dy))\n    elif dy > 0:\n      actions.extend([craft.ACTION_DOWN] * abs(dy))\n\n    if dx < 0:\n      actions.extend([craft.ACTION_LEFT] * abs(dx))\n    elif dx > 0:\n      actions.extend([craft.ACTION_RIGHT] * abs(dx))\n\n    return actions\n\n  def move_to_workshop(env, workshop_index):\n    current_pos = env._current_state.pos\n    grid = env._current_state.grid\n\n    # Find the closest workshop in the grid.\n    workshops = [(x, y) for x in range(grid.shape[0]) \n                 for y in range(grid.shape[1]) if grid[x, y, workshop_index] > 0]\n    if not workshops:\n      return []\n\n    # Choose the nearest workshop.\n    target_x, target_y = min(workshops, key=lambda p: abs(p[0] - current_pos[0]) + abs(p[1] - current_pos[1]))\n    return move_to_position(current_pos, (target_x, target_y))\n\n  def align_with_workshop(env, workshop_index):\n    current_pos = env._current_state.pos\n    grid = env._current_state.grid\n\n    # Locate the nearest workshop in a 3x3 neighborhood.\n    for dy in range(-1, 2):\n        for dx in range(-1, 2):\n            x, y = current_pos[0] + dx, current_pos[1] + dy\n            if (0 <= x < grid.shape[0]) and\\\n               (0 <= y < grid.shape[1]):\n                cell = grid[x, y]\n                if workshop_index in cell:\n                    # Determine the direction to align with the workshop.\n                    delta_x = dx\n                    delta_y = dy\n                    if delta_x == 0 and delta_y == -1: return craft.ACTION_UP\n                    if delta_x == 0 and delta_y == 1:  return craft.ACTION_DOWN\n                    if delta_x == -1 and delta_y == 0: return craft.ACTION_LEFT\n                    if delta_x == 1 and delta_y == 0:  return craft.ACTION_RIGHT\n\n    # If no workshop is found in the neighborhood, return None.\n    return None\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the desired item is a primitive; primitives cannot be crafted.\n  if item_index in env.world.cookbook.primitives:\n    return []\n\n  # Fetch the recipe for crafting the specified item.\n  recipe = env.world.cookbook.recipes.get(item_index)\n\n  # If no valid recipe exists or \"_key\" not specified, return an empty action list.\n  if not recipe or \"_key\" not in recipe:\n    return []\n\n  workshop_key = recipe[\"_key\"]\n  workshop_index = env.world.cookbook.index[workshop_key]\n\n  actions = []\n  # Check inventory for sufficient primitives.\n  missing_ingredients = {}\n  for ingredient, count in recipe.items():\n    if ingredient == \"_key\":\n      continue\n    ingredient_index = env.world.cookbook.index[ingredient]\n    current_count = env._current_state.inventory[ingredient_index]\n    if current_count < count:\n      missing_ingredients[ingredient] = count - current_count\n\n  # If any ingredients are missing, attempt to collect them.\n  for ingredient, required_count in missing_ingredients.items():\n    ingredient_index = env.world.cookbook.index[ingredient]\n    actions.extend(collect_v4(env, ingredient, required_count))\n\n  # Move to a workshop that can craft the item.\n  actions.extend(move_to_workshop(env, workshop_index))\n\n  # Align with the nearest workshop and use the USE action.\n  align_action = align_with_workshop(env, workshop_index)\n  if align_action:\n    actions.append(align_action)\n\n  actions.append(craft.ACTION_USE)\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T04:07:38.182389", "function_name": "craft", "function_body": "  def move_to_workshop(env, workshop_index):\n    current_pos = env._current_state.pos\n    grid = env.world.scenario.grid\n\n    # Find the closest workshop in the grid.\n    workshops = [(x, y) for x in range(grid.shape[0]) \n                 for y in range(grid.shape[1]) if grid[x, y, workshop_index] > 0]\n    if not workshops:\n      return []\n\n    # Choose the nearest workshop.\n    target_x, target_y = min(workshops, key=lambda p: abs(p[0] - current_pos[0]) + abs(p[1] - current_pos[1]))\n\n    path = a_star_search(grid, current_pos, (target_x, target_y))\n    actions = []\n    for step in path:\n        x, y = step\n        delta_x = x - current_pos[0]\n        delta_y = y - current_pos[1]\n        if delta_x == 1: actions.append(craft.ACTION_RIGHT)\n        elif delta_x == -1: actions.append(craft.ACTION_LEFT)\n        elif delta_y == 1: actions.append(craft.ACTION_DOWN)\n        elif delta_y == -1: actions.append(craft.ACTION_UP)\n        current_pos = (x, y)\n    return actions\n\n  def a_star_search(grid, start, goal):\n      neighbors = [(0,1), (1,0), (0,-1), (-1,0)]\n      close_set = set()\n      came_from = {}\n      gscore = {start:0}\n      fscore = {start:heuristic(start, goal)}\n      oheap = []\n      heapq.heappush(oheap, (fscore[start], start))\n\n      while oheap:\n          current = heapq.heappop(oheap)[1]\n          if current == goal:\n              data = []\n              while current in came_from:\n                  data.append(current)\n                  current = came_from[current]\n              return data[::-1]\n\n          close_set.add(current)\n          for i, j in neighbors:\n              neighbor = current[0] + i, current[1] + j\n              tentative_g_score = gscore[current] + 1\n\n              if 0 <= neighbor[0] < grid.shape[0]:\n                  if 0 <= neighbor[1] < grid.shape[1]:                \n                      if env.world.scenario.grid[neighbor[0], neighbor[1]].sum() == 0:\n                          continue\n                  else:\n                      # array index out of range\n                      continue\n              else:\n                  # array index out of range\n                  continue\n\n              if neighbor in close_set and tentative_g_score >= gscore.get(neighbor, 0):\n                  continue\n\n              if tentative_g_score < gscore.get(neighbor, 0) or neighbor not in [i[1]for i in oheap]:\n                  came_from[neighbor] = current\n                  gscore[neighbor] = tentative_g_score\n                  fscore[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                  heapq.heappush(oheap, (fscore[neighbor], neighbor))\n\n      return []\n\n  def heuristic(a, b):\n      return abs(b[0] - a[0]) + abs(b[1] - a[1])\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the desired item is a primitive; primitives cannot be crafted.\n  if item_index in env.world.cookbook.primitives:\n    return []\n\n  # Fetch the recipe for crafting the specified item.\n  recipe = env.world.cookbook.recipes.get(item_index)\n\n  # If no valid recipe exists or \"_key\" not specified, return an empty action list.\n  if not recipe or \"_key\" not in recipe:\n    return []\n\n  workshop_key = recipe[\"_key\"]\n  workshop_index = env.world.cookbook.index[workshop_key]\n\n  actions = []\n  # Check inventory for sufficient primitives.\n  missing_ingredients = {}\n  for ingredient, count in recipe.items():\n    if ingredient == \"_key\":\n      continue\n    ingredient_index = env.world.cookbook.index[ingredient]\n    current_count = env._current_state.inventory[ingredient_index]\n    if current_count < count:\n      missing_ingredients[ingredient] = count - current_count\n\n  # If any ingredients are missing, attempt to collect them.\n  for ingredient, required_count in missing_ingredients.items():\n    ingredient_index = env.world.cookbook.index[ingredient]\n    actions.extend(collect_v3(env, ingredient, required_count))\n\n  # Move to a workshop that can craft the item.\n  actions.extend(move_to_workshop(env, workshop_index))\n\n  # Use the USE action at the correct location.\n  align_action = align_with_workshop(env, workshop_index)\n  if align_action:\n    actions.append(align_action)\n\n  actions.append(craft.ACTION_USE)\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T04:10:00.221487", "function_name": "craft", "function_body": "  def get_closest_position(state, ingredient_idx):\n      positions = np.argwhere(state.grid[:, :, ingredient_idx] == 1)\n      if len(positions) == 0:\n          return None\n      \n      current_pos = np.array(state.pos)\n      distances = np.linalg.norm(current_pos - positions, axis=1)\n      closest_index = np.argmin(distances)\n      \n      return tuple(positions[closest_index])\n\n  def collect_ingredient(name: str):\n    ingredient_idx = env.world.cookbook.index[name]\n    \n    if env._current_state.inventory[ingredient_idx] > 0:\n        return []\n    \n    closest_position = get_closest_position(env._current_state, ingredient_idx)\n    if closest_position is None:\n        return []  # Ingredient not found in the grid\n    \n    actions = move_to(env._current_state, closest_position)\n    actions.append(4)  # USE action index\n    \n    return actions\n\n  def move_to(state, target_pos):\n      current_pos = state.pos\n      x_diff = target_pos[0] - current_pos[0]\n      y_diff = target_pos[1] - current_pos[1]\n\n      actions = []\n      if x_diff > 0:\n          actions.extend([3] * x_diff)  # RIGHT\n      elif x_diff < 0:\n          actions.extend([2] * abs(x_diff))  # LEFT\n\n      if y_diff > 0:\n          actions.extend([1] * y_diff)  # UP\n      elif y_diff < 0:\n          actions.extend([0] * abs(y_diff))  # DOWN\n      \n      return actions\n\n  def get_workshop_position(state, workshop_index):\n      workshop_indices = state.world.workshop_indices\n      \n      if workshop_index >= len(workshop_indices):\n          return None\n      \n      for y in range(state.grid.shape[1]):\n          for x in range(state.grid.shape[0]):\n              if state.grid[x, y, workshop_indices[workshop_index]] == 1:\n                  return (x, y)\n      \n      return None\n\n  actions = []\n  \n  # Get the index for the desired item from the cookbook\n  item_idx = env.world.cookbook.index[item]\n  \n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_idx, {})\n  \n  if not recipe:\n    return []  # No recipe found\n  \n  # Determine the workshop where the crafting should happen\n  workshop_key = \"_key\"\n  workshop_index = int(recipe.pop(workshop_key, -1))\n  \n  if workshop_index == -1:\n    return []  # Workshop not specified in the recipe\n\n  # Get the target position for the workshop\n  target_workshop_pos = get_workshop_position(env._current_state, workshop_index)\n  \n  if target_workshop_pos is None:\n    return []  # Workshop position not found in the grid\n\n  # Collect all required primitives\n  for ingredient_idx, count in recipe.items():\n      ingredient_name = env.world.cookbook.index.get(ingredient_idx)\n      \n      while env._current_state.inventory[ingredient_idx] < count:\n          actions.extend(collect_ingredient(ingredient_name))\n          \n          if env._current_state.inventory[ingredient_idx] < count:\n              return []  # Could not collect all required primitives\n  \n  # Move to the target workshop\n  actions.extend(move_to(env._current_state, target_workshop_pos))\n  \n  # Perform the USE action at the workshop\n  actions.append(4)  # USE action index\n  \n  return actions", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T04:10:01.303712", "function_name": "craft", "function_body": "  def move_to(state, target_pos):\n      current_pos = state.pos\n      x_diff = target_pos[0] - current_pos[0]\n      y_diff = target_pos[1] - current_pos[1]\n\n      actions = []\n      if x_diff > 0:\n          actions.extend([3] * x_diff)  # RIGHT\n      elif x_diff < 0:\n          actions.extend([2] * abs(x_diff))  # LEFT\n\n      if y_diff > 0:\n          actions.extend([1] * y_diff)  # UP\n      elif y_diff < 0:\n          actions.extend([0] * abs(y_diff))  # DOWN\n      \n      return actions\n\n  def collect_ingredient(name: str):\n    ingredient_idx = env.world.cookbook.index[name]\n    if env._current_state.inventory[ingredient_idx] > 0:\n      return []\n    \n    # Find all positions of the ingredient in the grid\n    ingredient_positions = np.argwhere(env._current_state.grid[:, :, ingredient_idx] == 1)\n    if len(ingredient_positions) == 0:\n        return []  # Ingredient not found in the grid\n    \n    # Calculate distances from current position to all ingredient positions\n    current_pos = np.array(env._current_state.pos)\n    distances = np.linalg.norm(current_pos - ingredient_positions, axis=1)\n    \n    # Sort ingredient positions by distance (ascending order)\n    sorted_indices = np.argsort(distances)\n    nearest_position = tuple(ingredient_positions[sorted_indices[0]])\n    \n    # Move to the nearest ingredient position\n    actions = move_to(env._current_state, nearest_position)\n    actions.append(4)  # USE action index\n    \n    return actions\n\n  def check_and_collect_primitives(state, recipe):\n      actions = []\n      for ingredient_idx, count in recipe.items():\n          ingredient_name = env.world.cookbook.index.get(ingredient_idx)\n          while state.inventory[ingredient_idx] < count:\n              collect_actions = collect_ingredient(ingredient_name)\n              if not collect_actions:\n                  return [], False\n              actions.extend(collect_actions)\n          \n          if state.inventory[ingredient_idx] < count:\n              return [], False  # Could not collect all required primitives\n      return actions, True\n\n  actions = []\n  \n  # Get the index for the desired item from the cookbook\n  item_idx = env.world.cookbook.index[item]\n  \n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_idx, {})\n  \n  if not recipe:\n    return []  # No recipe found\n  \n  # Determine the workshop where the crafting should happen\n  workshop_key = \"_key\"\n  workshop_index = int(recipe.pop(workshop_key, -1))\n  \n  if workshop_index == -1:\n    return []  # Workshop not specified in the recipe\n\n  # Get the target position for the workshop\n  workshop_indices = env.world.workshop_indices\n  if workshop_index >= len(workshop_indices):\n      return []  # Invalid workshop index\n  \n  target_workshop_pos = None\n  for y in range(env._current_state.grid.shape[1]):\n      for x in range(env._current_state.grid.shape[0]):\n          if env._current_state.grid[x, y, workshop_indices[workshop_index]] == 1:\n              target_workshop_pos = (x, y)\n              break\n      if target_workshop_pos is not None:\n          break\n  \n  if target_workshop_pos is None:\n    return []  # Workshop position not found in the grid\n\n  # Collect all required primitives\n  actions, success = check_and_collect_primitives(env._current_state, recipe)\n  \n  if not success:\n    return []  # Could not collect all required primitives\n  \n  # Move to the target workshop\n  actions.extend(move_to(env._current_state, target_workshop_pos))\n  \n  # Perform the USE action at the workshop\n  actions.append(4)  # USE action index\n  \n  return actions", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T04:12:02.108804", "function_name": "craft", "function_body": "  # Function to calculate Manhattan distance\n  def manhattan_distance(p1, p2):\n    return abs(p1[0] - p2[0]) + abs(p1[1] - p2[1])\n\n  item_index = env.world.cookbook.index[item]\n  \n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n\n  # Check if we have all ingredients in inventory to craft this item\n  required_ingredients = recipe.copy()\n  workshop_name = required_ingredients.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  available_inventory = {env.world.cookbook.index[k]: v for k, v in env.world.cookbook.index.reverse_contents.items() if k in env._current_state.inventory}\n\n  # Check if all ingredients are available\n  can_craft = True\n  actions_to_take = []\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if can_craft and workshop_name is not None:\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find all positions of the required workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n    if len(workshop_positions) == 0:\n      raise ValueError(\"No available workshop to craft item\")\n\n    current_position = np.array(env._current_state.pos)\n    nearest_workshop_pos = min(workshop_positions, key=lambda pos: manhattan_distance(current_position, tuple(pos)))\n\n    # Calculate actions to move the agent to the nearest workshop\n    dx = nearest_workshop_pos[0] - current_position[0]\n    dy = nearest_workshop_pos[1] - current_position[1]\n\n    def add_move_actions(dx, dy):\n        if dx > 0:\n            actions_to_take.extend([craft.MOVE_RIGHT for _ in range(dx)])\n        elif dx < 0:\n            actions_to_take.extend([craft.MOVE_LEFT for _ in range(-dx)])\n\n        if dy > 0:\n            actions_to_take.extend([craft.MOVE_DOWN for _ in range(dy)])\n        elif dy < 0:\n            actions_to_take.extend([craft.MOVE_UP for _ in range(-dy)])\n\n    def align_with_direction(dx, dy):\n        target_direction = env._current_state.dir\n\n        if dx > 0 and target_direction != craft.RIGHT:\n            actions_to_take.append(craft.TURN_RIGHT)\n            target_direction = (target_direction + 1) % 4\n        elif dx < 0 and target_direction != craft.LEFT:\n            actions_to_take.append(craft.TURN_LEFT)\n            target_direction = (target_direction - 1) % 4\n\n        if dy > 0 and target_direction != craft.DOWN:\n            while target_direction != craft.DOWN:\n                actions_to_take.append(craft.TURN_RIGHT)\n                target_direction = (target_direction + 1) % 4\n        elif dy < 0 and target_direction != craft.UP:\n            while target_direction != craft.UP:\n                actions_to_take.append(craft.TURN_LEFT)\n                target_direction = (target_direction - 1) % 4\n\n    add_move_actions(dx, dy)\n    align_with_direction(dx, dy)\n\n    # Add the USE action to craft the item\n    actions_to_take.append(craft.USE)\n\n  else:\n      raise ValueError(\"Ingredients not available or no workshop specified in the recipe\")\n\n  return actions_to_take", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-10T04:12:03.073869", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n  \n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n\n  # Check if we have all ingredients in inventory to craft this item\n  required_ingredients = recipe.copy()\n  workshop_name = required_ingredients.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No available workshop to craft item\")\n\n  # Calculate distances from current position to all workshops\n  current_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n  \n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n  # Calculate actions to move the agent to the nearest workshop\n  dx = nearest_workshop_pos[0] - current_position[0]\n  dy = nearest_workshop_pos[1] - current_position[1]\n\n  actions_to_take = []\n\n  if dx > 0:\n    actions_to_take.extend([craft.MOVE_RIGHT for _ in range(dx)])\n  elif dx < 0:\n    actions_to_take.extend([craft.MOVE_LEFT for _ in range(-dx)])\n\n  if dy > 0:\n    actions_to_take.extend([craft.MOVE_DOWN for _ in range(dy)])\n  elif dy < 0:\n    actions_to_take.extend([craft.MOVE_UP for _ in range(-dy)])\n\n  # Rotate the agent to face the workshop\n  target_direction = env._current_state.dir\n\n  if dx > 0 and target_direction != craft.RIGHT:\n      actions_to_take.append(craft.TURN_RIGHT)\n      target_direction = (target_direction + 1) % 4\n  elif dx < 0 and target_direction != craft.LEFT:\n      actions_to_take.append(craft.TURN_LEFT)\n      target_direction = (target_direction - 1) % 4\n\n  if dy > 0 and target_direction != craft.DOWN:\n      while target_direction != craft.DOWN:\n          actions_to_take.append(craft.TURN_RIGHT)\n          target_direction = (target_direction + 1) % 4\n  elif dy < 0 and target_direction != craft.UP:\n      while target_direction != craft.UP:\n          actions_to_take.append(craft.TURN_LEFT)\n          target_direction = (target_direction - 1) % 4\n\n  # Check if we have all ingredients in inventory to craft this item\n  available_inventory = {env.world.cookbook.index[k]: v for k, v in env._current_state.inventory.items()}\n\n  can_craft = True\n  missing_ingredients = []\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      missing_ingredients.append(ingredient_index)\n\n  if can_craft:\n    # Add the USE action to craft the item\n    actions_to_take.append(craft.USE)\n  else:\n    # Collect missing ingredients\n    for ingredient in missing_ingredients:\n        ingredient_name = env.world.cookbook.index.reverse_contents[ingredient]\n        collect_actions = collect(env, ingredient_name)\n        actions_to_take.extend(collect_actions)\n\n        # After collecting, try crafting again\n        return craft_v2(env, item)  # Recursive call to handle the case after collection\n\n  return actions_to_take", "island_id": 4, "scores": {"3": -1}}
