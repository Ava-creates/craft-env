nv.world.cookbook.index[\"RIGHT\"])\n      elif dx == -1:\n          actions.append(env.world.cookbook.index[\"LEFT\"])\n      elif dy == 1:\n          actions.append(env.world.cookbook.index[\"DOWN\"])\n      elif dy == -1:\n          actions.append(env.world.cookbook.index[\"UP\"])\n\n  # Calculate the direction to face the target workshop\n  dx = target_workshop_pos[0] - env._current_state.pos[0]\n  dy = target_workshop_pos[1] - env._current_state.pos[1]\n\n  if abs(dx) > abs(dy):\n      direction_to_face = \"RIGHT\" if dx > 0 else \"LEFT\"\n  else:\n      direction_to_face = \"DOWN\" if dy > 0 else \"UP\"\n\n  # Move towards the target workshop and face it\n  actions.append(env.world.cookbook.index[direction_to_face])\n\n  # Add USE action to craft the item\n  actions.append(env.world.cookbook.index[\"USE\"])\n\n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T14:48:00.974873", "function_name": "craft", "function_body": "  def navigate_to_position(current_pos, target_pos):\n    delta = target_pos - current_pos\n    actions = []\n\n    # Calculate the shortest path to the target position\n    while not np.array_equal(current_pos, target_pos):\n      if abs(delta[0]) > abs(delta[1]):\n        if delta[0] > 0:\n          actions.append(craft.RIGHT)\n        else:\n          actions.append(craft.LEFT)\n        current_pos[0] += 1 if delta[0] > 0 else -1\n      else:\n        if delta[1] > 0:\n          actions.append(craft.DOWN)\n        else:\n          actions.append(craft.UP)\n        current_pos[1] += 1 if delta[1] > 0 else -1\n\n    return actions\n\n  goal_index = env.world.cookbook.index[item]\n\n  # Check if we have all required primitives in our inventory\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  current_inventory = collections.Counter(env._current_state.inventory)\n\n  for primitive, count in required_primitives.items():\n    if current_inventory[primitive] < count:\n      return []  # Missing required primitives\n\n  # Determine the workshop where crafting should occur\n  recipe_details = env.world.cookbook.recipes[goal_index]\n  workshop_name = recipe_details[\"_key\"]\n\n  # Get the index of the workshop from the world's cookbook\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the closest workshop in the grid\n  positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(positions) == 0:\n    return []  # No available workshops\n\n  closest_workshop_pos = min(\n      positions, key=lambda x: abs(x[0] - env._current_state.pos[0]) + abs(x[1] - env._current_state.pos[1]))\n\n  # Navigate to the closest workshop\n  current_pos = np.array(env._current_state.pos)\n  target_pos = np.array(closest_workshop_pos)\n\n  actions = navigate_to_position(current_pos, target_pos)\n\n  # Orient the agent to face the workshop and use it\n  if env._current_state.grid[target_pos[0], target_pos[1], workshop_index] == 1:\n    actions.append(craft.USE)\n\n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T14:48:02.080325", "function_name": "craft", "function_body": "  goal_index = env.world.cookbook.index[item]\n\n  # Check if we have all required primitives in our inventory\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  current_inventory = collections.Counter(env._current_state.inventory)\n\n  for primitive, count in required_primitives.items():\n    if current_inventory[primitive] < count:\n      return []  # Missing required primitives\n\n  # Determine the workshop where crafting should occur\n  recipe_details = env.world.cookbook.recipes[goal_index]\n  workshop_name = recipe_details[\"_key\"]\n\n  # Get the index of the workshop from the world's cookbook\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the closest workshop in the grid\n  positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(positions) == 0:\n    return []  # No available workshops\n\n  closest_workshop_pos = min(\n      positions, key=lambda x: abs(x[0] - env._current_state.pos[0]) + abs(x[1] - env._current_state.pos[1]))\n\n  # Navigate to the closest workshop\n  current_pos = np.array(env._current_state.pos)\n  target_pos = np.array(closest_workshop_pos)\n\n  actions = []\n\n  while not np.array_equal(current_pos, target_pos):\n    delta = target_pos - current_pos\n\n    # Calculate direction based on the largest absolute difference\n    if abs(delta[0]) > abs(delta[1]):\n      if delta[0] > 0:\n        actions.append(craft.RIGHT)  # Move right\n      else:\n        actions.append(craft.LEFT)   # Move left\n    else:\n      if delta[1] > 0:\n        actions.append(craft.DOWN)   # Move down\n      else:\n        actions.append(craft.UP)     # Move up\n\n    current_pos = np.array(env._current_state.pos)\n\n  # Orient the agent to face the workshop and use it\n  if env._current_state.grid[target_pos[0], target_pos[1], workshop_index] == 1:\n    actions.append(craft.USE)\n    \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T14:51:23.154837", "function_name": "craft", "function_body": "  def get_direction(current_pos, target_pos):\n    x_diff = target_pos[0] - current_pos[0]\n    y_diff = target_pos[1] - current_pos[1]\n\n    if x_diff > 0:\n      return 3  # RIGHT\n    elif x_diff < 0:\n      return 2  # LEFT\n    elif y_diff > 0:\n      return 1  # UP\n    else:\n      return 0  # DOWN\n\n  def find_path(start, target):\n    actions = []\n\n    start_x, start_y = divmod(start, env._current_state.grid.shape[1])\n    target_x, target_y = divmod(target, env._current_state.grid.shape[1])\n\n    open_set = []\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, target)}\n\n    heapq.heappush(open_set, (f_score[start], start))\n\n    while open_set:\n      _, current = heapq.heappop(open_set)\n\n      if current == target:\n        reconstruct_path(came_from, current)\n        break\n\n      cx, cy = divmod(current, env._current_state.grid.shape[1])\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = cx + dx, cy + dy\n\n        if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n          neighbor = nx * env._current_state.grid.shape[1] + ny\n          tentative_g_score = g_score[current] + 1\n\n          if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n            came_from[neighbor] = current\n            g_score[neighbor] = tentative_g_score\n            f_score[neighbor] = tentative_g_score + heuristic(neighbor, target)\n            heapq.heappush(open_set, (f_score[neighbor], neighbor))\n\n    def reconstruct_path(came_from, current):\n      total_path = []\n      while current in came_from:\n        cx, cy = divmod(current, env._current_state.grid.shape[1])\n        px, py = divmod(came_from[current], env._current_state.grid.shape[1])\n\n        dx, dy = px - cx, py - cy\n        direction_to_face = get_direction((cx, cy), (px, py))\n        total_path.append(direction_to_face)\n        current = came_from[current]\n\n      actions.extend(reversed(total_path))\n\n    return actions\n\n  def heuristic(a, b):\n    ax, ay = divmod(a, env._current_state.grid.shape[1])\n    bx, by = divmod(b, env._current_state.grid.shape[1])\n\n    # Manhattan distance\n    return abs(ax - bx) + abs(ay - by)\n\n  actions = []\n\n  item_index = env.world.cookbook.index[item]\n  \n  if not item_index:\n    return []\n\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  current_inventory = {env.world.cookbook.index.get(i): c for i, c in enumerate(env._current_state.inventory) if c > 0}\n\n  # Check if we have all the required primitives\n  for primitive_index, count in primitives_needed.items():\n    if current_inventory.get(primitive_index, 0) < count:\n      return []\n\n  # Find the workshop to craft the item\n  workshop_name = env.world.cookbook.recipes[item_index][\"_at\"]\n  workshop_indices = np.argwhere(env._current_state.grid[:, :, env.world.workshop_indices[0]] == env.world.cookbook.index[workshop_name])\n\n  if not workshop_indices.any():\n    return []\n\n  # Convert the grid coordinates to a flat list\n  flat_grid = env._current_state.grid.reshape(-1, env.world.n_kinds)\n\n  start_pos_flat = env._current_state.pos[0] * env._current_state.grid.shape[1] + env._current_state.pos[1]\n  target_workshops = []\n\n  for idx in workshop_indices:\n    target_pos_flat = idx[0] * env._current_state.grid.shape[1] + idx[1]\n    target_workshops.append((target_pos_flat, heuristic(start_pos_flat, target_pos_flat)))\n\n  # Sort workshops by distance\n  target_workshops.sort(key=lambda x: x[1])\n\n  for target_pos_flat, _ in target_workshops:\n      actions.extend(find_path(start_pos_flat, target_pos_flat))\n\n      # Ensure we are in front of the workshop\n      target_workshop_position = (workshop_indices[0][0], workshop_indices[0][1])\n      direction_to_face = get_direction(env._current_state.pos, target_workshop_position)\n      if direction_to_face is not None:\n          actions.append(direction_to_face)\n\n      # Craft the item by using the USE action\n      actions.append(4)  # USE action\n\n      return actions  # Return after crafting at the first available workshop\n\n  return []  # No workshops found or crafting failed", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T14:51:24.173992", "function_name": "craft", "function_body": "  def get_direction(current_pos, target_pos):\n    x_diff = target_pos[0] - current_pos[0]\n    y_diff = target_pos[1] - current_pos[1]\n\n    if x_diff > 0:\n      return 3  # RIGHT\n    elif x_diff < 0:\n      return 2  # LEFT\n    elif y_diff > 0:\n      return 1  # UP\n    else:\n      return 0  # DOWN\n\n  def find_path(start, target):\n    actions = []\n\n    start_x, start_y = divmod(start, env._current_state.grid.shape[1])\n    target_x, target_y = divmod(target, env._current_state.grid.shape[1])\n\n    open_set = []\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, target)}\n\n    heapq.heappush(open_set, (f_score[start], start))\n\n    while open_set:\n      _, current = heapq.heappop(open_set)\n\n      if current == target:\n        reconstruct_path(came_from, current)\n        break\n\n      cx, cy = divmod(current, env._current_state.grid.shape[1])\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = cx + dx, cy + dy\n\n        if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n          neighbor = nx * env._current_state.grid.shape[1] + ny\n          tentative_g_score = g_score[current] + 1\n\n          if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n            came_from[neighbor] = current\n            g_score[neighbor] = tentative_g_score\n            f_score[neighbor] = tentative_g_score + heuristic(neighbor, target)\n            heapq.heappush(open_set, (f_score[neighbor], neighbor))\n\n    def reconstruct_path(came_from, current):\n      total_path = []\n      while current in came_from:\n        cx, cy = divmod(current, env._current_state.grid.shape[1])\n        px, py = divmod(came_from[current], env._current_state.grid.shape[1])\n\n        dx, dy = px - cx, py - cy\n        direction_to_face = get_direction((cx, cy), (px, py))\n        total_path.append(direction_to_face)\n        current = came_from[current]\n\n      actions.extend(reversed(total_path))\n\n    return actions\n\n  def heuristic(a, b):\n    ax, ay = divmod(a, env._current_state.grid.shape[1])\n    bx, by = divmod(b, env._current_state.grid.shape[1])\n\n    # Manhattan distance\n    return abs(ax - bx) + abs(ay - by)\n\n  actions = []\n\n  item_index = env.world.cookbook.index[item]\n  \n  if not item_index:\n    return []\n\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  current_inventory = {env.world.cookbook.index.get(i): c for i, c in enumerate(env._current_state.inventory) if c > 0}\n\n  # Check if we have all the required primitives\n  missing_primitives = []\n  for primitive_index, count in primitives_needed.items():\n    if current_inventory.get(primitive_index, 0) < count:\n      missing_primitives.append((primitive_index, count - current_inventory.get(primitive_index)))\n\n  # If there are missing primitives, we need to collect them first\n  if missing_primitives:\n    for primitive_index, count in missing_primitives:\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] > 0)\n\n      if not primitive_positions.any():\n        return []\n\n      for _ in range(count):\n        # Find the nearest primitive\n        closest_primitive_position = min(primitive_positions, key=lambda pos: heuristic(start_pos_flat, pos[0] * env._current_state.grid.shape[1] + pos[1]))\n        \n        start_pos_flat = env._current_state.pos[0] * env._current_state.grid.shape[1] + env._current_state.pos[1]\n        target_pos_flat = closest_primitive_position[0] * env._current_state.grid.shape[1] + closest_primitive_position[1]\n\n        actions.extend(find_path(start_pos_flat, target_pos_flat))\n\n        # Ensure we are in front of the primitive\n        target_primitive_position = (closest_primitive_position[0], closest_primitive_position[1])\n        direction_to_face = get_direction(env._current_state.pos, target_primitive_position)\n        if direction_to_face is not None:\n            actions.append(direction_to_face)\n\n        # Collect the primitive by using the USE action\n        actions.append(4)  # USE action\n\n        # Update inventory\n        current_inventory[primitive_index] += 1\n\n  # Find the workshop to craft the item\n  workshop_name = env.world.cookbook.recipes[item_index][\"_at\"]\n  workshop_indices = np.argwhere(env._current_state.grid[:, :, env.world.workshop_indices[0]] == env.world.cookbook.index[workshop_name])\n\n  if not workshop_indices.any():\n    return []\n\n  # Convert the grid coordinates to a flat list\n  start_pos_flat = env._current_state.pos[0] * env._current_state.grid.shape[1] + env._current_state.pos[1]\n  target_pos_flat = workshop_indices[0][0] * env._current_state.grid.shape[1] + workshop_indices[0][1]\n\n  actions.extend(find_path(start_pos_flat, target_pos_flat))\n\n  # Ensure we are in front of the workshop\n  target_workshop_position = (workshop_indices[0][0], workshop_indices[0][1])\n  direction_to_face = get_direction(env._current_state.pos, target_workshop_position)\n  if direction_to_face is not None:\n      actions.append(direction_to_face)\n\n  # Craft the item by using the USE action\n  actions.append(4)  # USE action\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-11T14:54:12.121050", "function_name": "craft", "function_body": "  def get_required_primitives(i_goal):\n      return env.world.cookbook.primitives_for(i_goal)\n\n  def move_to(position):\n      actions = []\n      agent_pos = np.array(env._current_state.pos)\n      direction_mapping = {\n          (0, -1): craft.LEFT,\n          (0, 1): craft.RIGHT,\n          (-1, 0): craft.UP,\n          (1, 0): craft.DOWN\n      }\n\n      while not np.array_equal(agent_pos, position):\n          delta_x = position[0] - agent_pos[0]\n          delta_y = position[1] - agent_pos[1]\n\n          # Determine the move direction based on the largest difference\n          if abs(delta_x) > abs(delta_y):\n              move_direction = (np.sign(delta_x), 0)\n          else:\n              move_direction = (0, np.sign(delta_y))\n\n          actions.append(craft.MOVE_FUNC(direction_mapping[move_direction]))\n          agent_pos += np.array(move_direction)\n\n      return actions\n\n  def face_workshop(workshop_position):\n      current_direction = env._current_state.dir\n      delta_x = workshop_position[0] - env._current_state.pos[0]\n      delta_y = workshop_position[1] - env._current_state.pos[1]\n\n      target_direction_mapping = {\n          (0, -1): craft.LEFT,\n          (0, 1): craft.RIGHT,\n          (-1, 0): craft.UP,\n          (1, 0): craft.DOWN\n      }\n\n      move_x = np.sign(delta_x)\n      move_y = np.sign(delta_y)\n\n      # Determine the target direction based on the largest difference\n      if abs(delta_x) > abs(delta_y):\n          target_direction = target_direction_mapping[(move_x, 0)]\n      else:\n          target_direction = target_direction_mapping[(0, move_y)]\n\n      actions = []\n      while current_direction != target_direction:\n          # Determine the turn direction to reach the target direction\n          if (current_direction + 1) % 4 == target_direction:\n              actions.append(craft.MOVE_FUNC(craft.RIGHT))\n          elif (current_direction - 1) % 4 == target_direction:\n              actions.append(craft.MOVE_FUNC(craft.LEFT))\n          else:\n              actions.append(craft.MOVE_FUNC(craft.RIGHT))\n              actions.append(craft.MOVE_FUNC(craft.RIGHT))\n\n          current_direction = (current_direction + len(actions)) % 4\n\n      return actions\n\n  def find_workshop_positions(workshop_index):\n      positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n      if not positions.size:\n          raise ValueError(f\"No position found for workshop index: {workshop_index}\")\n      return positions.tolist()\n\n  i_goal = env.world.cookbook.index[item]\n\n  # Get the primitives required to craft this item\n  prim_reqs = get_required_primitives(i_goal)\n\n  # Check if we have all the required primitives in our inventory\n  for i_prim, count in prim_reqs.items():\n      if env._current_state.inventory[i_prim] < count:\n          return []  # If any primitive is missing, return an empty action list\n\n  # Find which workshop to use for crafting\n  workshop_index = None\n  workshop_name = \"_key\"\n\n  # Iterate over the recipes and find the workshop\n  for output_index, recipe in env.world.cookbook.recipes.items():\n      if i_goal == output_index:\n          workshop_name = recipe[\"_at\"]\n          break\n\n  # Get the index of the workshop from the environment's indices\n  try:\n      workshop_index = getattr(env.world, f\"{workshop_name}_index\")\n  except AttributeError:\n      return []  # If the workshop is not found, return an empty action list\n\n  # Now that we have all the requirements and know where to craft, let's move to the workshop\n  workshop_positions = find_workshop_positions(workshop_index)\n\n  actions_list = []\n\n  # Move to the nearest workshop position\n  for pos in workshop_positions:\n      if np.linalg.norm(np.array(pos) - np.array(env._current_state.pos)) == 1:\n          workshop_pos = pos\n          break\n      else:\n          workshop_pos = min(workshop_positions, key=lambda p: np.linalg.norm(np.array(p) - np.array(env._current_state.pos)))\n\n  # Move to the workshop\n  actions_list.extend(move_to(workshop_pos))\n\n  # Face the workshop once we reach there\n  actions_list.extend(face_workshop(workshop_pos))\n\n  # Once facing the workshop, use it to craft the item\n  actions_list.append(craft.USE_FUNC())\n\n  return actions_list", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T14:54:13.175047", "function_name": "craft", "function_body": "  def get_workshop_position(workshop_index):\n      positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n      if len(positions) > 0:\n          return positions[0]\n      else:\n          raise ValueError(f\"No position found for workshop index: {workshop_index}\")\n\n  def get_required_primitives(i_goal):\n      return env.world.cookbook.primitives_for(i_goal)\n\n  def move_to(position, current_position=None):\n      if current_position is None:\n          current_position = np.array(env._current_state.pos)\n      \n      actions = []\n      direction_mapping = {\n          (0, -1): craft.LEFT,\n          (0, 1): craft.RIGHT,\n          (-1, 0): craft.UP,\n          (1, 0): craft.DOWN\n      }\n\n      while not np.array_equal(current_position, position):\n          delta_x = position[0] - current_position[0]\n          delta_y = position[1] - current_position[1]\n\n          # Determine the move direction based on the largest difference\n          if abs(delta_x) > abs(delta_y):\n              move_direction = (np.sign(delta_x), 0)\n          else:\n              move_direction = (0, np.sign(delta_y))\n\n          actions.append(craft.MOVE_FUNC(direction_mapping[move_direction]))\n          current_position += np.array(move_direction)\n\n      return actions\n\n  def face_workshop(workshop_position):\n      current_direction = env._current_state.dir\n      delta_x = workshop_position[0] - env._current_state.pos[0]\n      delta_y = workshop_position[1] - env._current_state.pos[1]\n\n      target_direction_mapping = {\n          (0, -1): craft.LEFT,\n          (0, 1): craft.RIGHT,\n          (-1, 0): craft.UP,\n          (1, 0): craft.DOWN\n      }\n\n      move_x = np.sign(delta_x)\n      move_y = np.sign(delta_y)\n\n      # Determine the target direction based on the largest difference\n      if abs(delta_x) > abs(delta_y):\n          target_direction = target_direction_mapping[(move_x, 0)]\n      else:\n          target_direction = target_direction_mapping[(0, move_y)]\n\n      actions = []\n      while current_direction != target_direction:\n          # Determine the turn direction to reach the target direction\n          if (current_direction + 1) % 4 == target_direction:\n              actions.append(craft.MOVE_FUNC(craft.RIGHT))\n          elif (current_direction - 1) % 4 == target_direction:\n              actions.append(craft.MOVE_FUNC(craft.LEFT))\n          else:\n              actions.append(craft.MOVE_FUNC(craft.RIGHT))\n              actions.append(craft.MOVE_FUNC(craft.RIGHT))\n\n          current_direction = (current_direction + len(actions)) % 4\n\n      return actions\n\n  def ensure_inventory(item):\n      # Implement logic to collect required primitives if not available\n      pass\n\n  i_goal = env.world.cookbook.index[item]\n\n  # Get the primitives required to craft this item\n  prim_reqs = get_required_primitives(i_goal)\n\n  # Check if we have all the required primitives in our inventory\n  for i_prim, count in prim_reqs.items():\n      if env._current_state.inventory[i_prim] < count:\n          return []  # If any primitive is missing, return an empty action list\n\n  # Find which workshop to use for crafting\n  workshop_index = None\n  workshop_name = \"_key\"\n\n  # Iterate over the recipes and find the workshop\n  for output_index, recipe in env.world.cookbook.recipes.items():\n      if i_goal == output_index:\n          workshop_name = recipe[\"_at\"]\n          break\n\n  # Get the index of the workshop from the environment's indices\n  try:\n      workshop_index = getattr(env.world, f\"{workshop_name}_index\")\n  except AttributeError:\n      return []  # If the workshop is not found, return an empty action list\n\n  # Now that we have all the requirements and know where to craft, let's move to the workshop\n  workshop_pos = get_workshop_position(workshop_index)\n\n  actions_list = []\n\n  # Move to the workshop\n  actions_list.extend(move_to(workshop_pos))\n\n  # Face the workshop once we reach there\n  actions_list.extend(face_workshop(workshop_pos))\n\n  # Once facing the workshop, use it to craft the item\n  actions_list.append(craft.USE_FUNC())\n\n  return actions_list", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T14:55:21.737246", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the recipe exists for the item\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the required ingredients and their counts\n  required_ingredients = env.world.cookbook.recipes[item_index]\n  \n  actions = []\n  # Collect all required primitives or intermediate items\n  for ingredient, count in required_ingredients.items():\n      if ingredient == \"_at\":\n          workshop_name = required_ingredients[\"_at\"]\n          workshop_index = env.world.cookbook.index[workshop_name]\n      else:\n          ingredient_index = env.world.cookbook.index[ingredient]\n\n          # If the agent already has enough of this ingredient, skip collecting\n          if env._current_state.inventory[ingredient_index] >= count:\n              continue\n\n          # Collect the required number of primitives or intermediate items\n          actions.extend(collect(env, ingredient))\n\n  # Navigate to the workshop and use it to craft the item\n  if \"_at\" in required_ingredients:\n      workshop_name = required_ingredients[\"_at\"]\n      workshop_index = env.world.cookbook.index[workshop_name]\n\n      # Find the nearest workshop of the correct type\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n      if len(workshop_positions) == 0:\n          return []\n\n      closest_workshop = min(workshop_positions, key=lambda pos: np.linalg.norm(np.array(pos) - np.array(env._current_state.pos)))\n      actions.extend(move_to(env, tuple(closest_workshop)))\n\n      # Rotate to face the workshop\n      current_pos = env._current_state.pos\n      target_dir = (closest_workshop[0] - current_pos[0], closest_workshop[1] - current_pos[1])\n      direction_index = np.argmax(np.abs(target_dir))\n      if target_dir[direction_index] < 0:\n          direction_index += 2\n      actions.append(direction_index)\n\n      # Use the workshop to craft the item\n      actions.append(4)  # USE action\n\n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-11T14:55:22.704822", "function_name": "craft", "function_body": "  # Convert item name to index using the cookbook's index mapping\n  item_idx = env.world.cookbook.index[item]\n  \n  # Get the recipe for the desired item\n  recipe = env.world.cookbook.recipes.get(item_idx, {})\n  \n  # Check if the recipe is valid (exists in the cookbook)\n  if not recipe:\n    return []\n  \n  actions = []\n  \n  # Collect required primitives and intermediate items\n  for ingredient_name, count in recipe.items():\n    if ingredient_name == \"_key\":\n      continue\n    \n    ingredient_index = env.world.cookbook.index[ingredient_name]\n    \n    # If we don't have enough of the ingredient in our inventory, collect more\n    while np.sum(env._current_state.inventory[ingredient_index]) < count:\n      actions.extend(collect_v2(env, ingredient_name))\n  \n  # Determine the workshop index based on \"_key\" in the recipe\n  workshop_index = env.world.cookbook.index[recipe[\"_key\"]]\n  \n  # Move to a position next to the workshop and face it\n  actions.extend(navigate_to_workshop(env._current_state, workshop_index))\n  \n  # Perform the USE action at the workshop to craft the item\n  actions.append(env.world.N_ACTIONS - 1)  # Assuming USE action is always last\n  \n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-11T15:02:31.892572", "function_name": "craft", "function_body": "  def navigate_and_use(target_index):\n    actions = []\n    target_pos = None\n    \n    # Find the position of the target on the grid\n    for x in range(env._current_state.grid.shape[0]):\n        for y in range(env._current_state.grid.shape[1]):\n            if env._current_state.grid[x, y, target_index] == 1:\n                target_pos = (x, y)\n                break\n        if target_pos is not None:\n            break\n\n    # If no valid position found, return an empty action list\n    if target_pos is None:\n      return []\n\n    current_x, current_y = env._current_state.pos\n    target_x, target_y = target_pos\n\n    while (current_x, current_y) != (target_x, target_y):\n        dx = target_x - current_x\n        dy = target_y - current_y\n\n        # Determine the action to move towards the target\n        if abs(dx) > abs(dy):\n            direction_to_move = \"RIGHT\" if dx > 0 else \"LEFT\"\n        else:\n            direction_to_move = \"DOWN\" if dy > 0 else \"UP\"\n\n        actions.append(env.world.cookbook.index[direction_to_move])\n        \n        # Update current position\n        if direction_to_move == \"RIGHT\":\n            current_x += 1\n        elif direction_to_move == \"LEFT\":\n            current_x -= 1\n        elif direction_to_move == \"DOWN\":\n            current_y += 1\n        elif direction_to_move == \"UP\":\n            current_y -= 1\n\n    # Calculate the direction to face the target\n    dx = target_pos[0] - env._current_state.pos[0]\n    dy = target_pos[1] - env._current_state.pos[1]\n\n    if abs(dx) > abs(dy):\n        direction_to_face = \"RIGHT\" if dx > 0 else \"LEFT\"\n    else:\n        direction_to_face = \"DOWN\" if dy > 0 else \"UP\"\n\n    actions.append(env.world.cookbook.index[direction_to_face])\n\n    # Add USE action to interact with the target\n    actions.append(env.world.cookbook.index[\"USE\"])\n\n    return actions\n\n  actions = []\n\n  # Fetch the index for the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Get primitives required to make the item\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n\n  # Collect all required primitives\n  for primitive, count in primitives_required.items():\n    while env._current_state.inventory[primitive] < count:\n      actions.extend(navigate_and_use(primitive))\n\n  # Find the workshop that can craft this item\n  target_workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n    if item_index in recipe.values() and \"_key\" in recipe:\n      target_workshop_index = recipe[\"_key\"]\n      break\n\n  # If no valid workshop is found, return an empty action list\n  if target_workshop_index is None:\n    return []\n\n  # Navigate to the workshop and craft the item\n  actions.extend(navigate_and_use(target_workshop_index))\n\n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-11T15:02:33.070812", "function_name": "craft", "function_body": "  def find_path(start, end):\n    \"\"\"Finds a path from start to end using a simple BFS.\"\"\"\n    queue = collections.deque([start])\n    visited = set()\n    parent = {start: None}\n    \n    while queue:\n      current = queue.popleft()\n      if current == end:\n        break\n      visited.add(current)\n      \n      neighbors = [(current[0] + 1, current[1]), (current[0] - 1, current[1]),\n                   (current[0], current[1] + 1), (current[0], current[1] - 1)]\n      for neighbor in neighbors:\n        if neighbor not in visited and is_valid_move(neighbor):\n          queue.append(neighbor)\n          parent[neighbor] = current\n    \n    # Reconstruct path\n    path = []\n    while end:\n      path.append(end)\n      end = parent[end]\n    return path[::-1]\n\n  def is_valid_move(position):\n    \"\"\"Checks if the position is valid and not blocked.\"\"\"\n    x, y = position\n    return (0 <= x < env._current_state.grid.shape[0] and \n            0 <= y < env._current_state.grid.shape[1] and \n            env._current_state.grid[x, y].sum() == 0)\n\n  actions = []\n\n  # Fetch the index for the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Get primitives required to make the item\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n\n  # Check if we already have all the primitives in our inventory\n  all_primitives_collected = True\n  for primitive, count in primitives_required.items():\n    if env._current_state.inventory[primitive] < count:\n      all_primitives_collected = False\n      break\n\n  # If not all primitives are collected, return an empty action list\n  if not all_primitives_collected:\n    return []\n\n  # Find the workshop that can craft this item\n  target_workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n    if item_index in recipe.values() and \"_key\" in recipe:\n      target_workshop_index = recipe[\"_key\"]\n      break\n\n  # If no valid workshop is found, return an empty action list\n  if target_workshop_index is None:\n    return []\n\n  # Find the position of the target workshop on the grid\n  target_workshop_pos = None\n  for x in range(env._current_state.grid.shape[0]):\n      for y in range(env._current_state.grid.shape[1]):\n          if env._current_state.grid[x, y, target_workshop_index] == 1:\n              target_workshop_pos = (x, y)\n              break\n      if target_workshop_pos is not None:\n          break\n\n  # If no valid workshop position found, return an empty action list\n  if target_workshop_pos is None:\n    return []\n\n  # Calculate the path to the target workshop using BFS\n  current_pos = env._current_state.pos\n  path_to_workshop = find_path(current_pos, target_workshop_pos)\n\n  for next_pos in path_to_workshop[1:]:\n      dx = next_pos[0] - current_pos[0]\n      dy = next_pos[1] - current_pos[1]\n\n      # Determine the action to move towards the next position\n      if dx > 0:\n          actions.append(env.world.cookbook.index[\"RIGHT\"])\n      elif dx < 0:\n          actions.append(env.world.cookbook.index[\"LEFT\"])\n      elif dy > 0:\n          actions.append(env.world.cookbook.index[\"DOWN\"])\n      elif dy < 0:\n          actions.append(env.world.cookbook.index[\"UP\"])\n\n      # Update current position\n      current_pos = next_pos\n\n  # Add USE action to craft the item\n  actions.append(env.world.cookbook.index[\"USE\"])\n\n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T15:03:51.098011", "function_name": "craft", "function_body": "  # Get the index for the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the recipe exists for the item\n  if item_index not in env.world.cookbook.recipes:\n    print(f\"No recipe found for {item}\")\n    return []\n\n  # Retrieve the recipe for the item\n  recipe = env.world.cookbook.recipes[item_index]\n  \n  required_items = {}\n  workshop_index = None\n  \n  # Iterate through the recipe to get required items and workshop location\n  for ingredient, count in recipe.items():\n    if ingredient == \"_at\":\n      workshop_name = recipe[\"_at\"]\n      workshop_index = env.world.cookbook.index[workshop_name]\n    else:\n      required_items[ingredient] = count\n\n  # Check if the agent has all the required items in its inventory\n  missing_items = []\n  for ingredient, count in required_items.items():\n    ingredient_index = env.world.cookbook.index[ingredient]\n    if env._current_state.inventory[ingredient_index] < count:\n      missing_items.append((ingredient, count))\n  \n  # If there are any missing items return empty action list\n  if missing_items:\n    print(f\"Missing items: {missing_items}\")\n    return []\n\n  # Find the position of the workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  \n  if len(workshop_positions) == 0:\n    print(\"Workshop not found on the map.\")\n    return []\n  \n  # Choose a nearby workshop to craft (for simplicity, just pick the first one found)\n  target_workshop_pos = tuple(workshop_positions[0])\n\n  # Generate actions to move towards the chosen workshop\n  actions_to_move = pathfind(env._current_state.grid, env._current_state.pos, target_workshop_pos)\n\n  # Add USE action to craft the item at the workshop\n  actions_to_craft = [env.world.cookbook.index[\"USE\"]]\n\n  # Combine actions: move to workshop + use\n  actions = actions_to_move + actions_to_craft\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-11T15:03:52.099012", "function_name": "craft", "function_body": "  actions = []\n  current_state = env._current_state\n  cookbook = current_state.world.cookbook\n\n  # Get the index of the item to craft\n  item_index = cookbook.index[item]\n\n  if not item_index:\n    return []\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  # Check if we have all the ingredients required in our inventory\n  missing_ingredients = []\n  for ingredient_index, count in recipe.items():\n      if ingredient_index == \"_key\":\n          continue  # Skip the key that specifies the workshop\n\n      # Check if the agent has enough of this ingredient\n      if current_state.inventory[ingredient_index] < count:\n          missing_ingredients.append((ingredient_index, count))\n\n  # If there are any missing ingredients, we need to collect them first\n  for ingredient_index, count in missing_ingredients:\n      ingredient_name = cookbook.index.get(ingredient_index)\n      \n      if not ingredient_name:\n          return []  # Ingredient name is invalid\n\n      while current_state.inventory[ingredient_index] < count:\n          actions.extend(collect(env, ingredient_name))\n          actions.append(craft.CRAFT_FUNC(item))  # Use the USE action to collect\n          reward, done, observations = env.step(actions[-1])\n          \n          if done:\n              return actions\n\n  # If all ingredients are available, go to the workshop and craft the item\n  workshop_index = cookbook.index[recipe[\"_key\"]]\n  workshop_position = find_workshop(env, workshop_index)\n\n  if not workshop_position:\n      return []  # Workshop position is invalid\n\n  actions.extend(navigate_to(env, current_state.pos, workshop_position))\n\n  # Turn to face the workshop before using it\n  actions.append(turn_to_face(env, workshop_position))\n  \n  # Use the USE action to craft the item at the workshop\n  actions.append(craft.CRAFT_FUNC(item))\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-11T15:06:30.889933", "function_name": "craft", "function_body": "  def get_workshop_position(workshop_index):\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    if len(positions) > 0:\n        return positions[0]\n    else:\n        raise ValueError(f\"No position found for workshop index: {workshop_index}\")\n\n  def get_required_primitives(i_goal):\n    return env.world.cookbook.primitives_for(i_goal)\n\n  def move_to(target_position):\n    actions = []\n    agent_pos = np.array(env._current_state.pos)\n    while not np.array_equal(agent_pos, target_position):\n        delta_x = target_position[0] - agent_pos[0]\n        delta_y = target_position[1] - agent_pos[1]\n\n        if abs(delta_x) > abs(delta_y):\n            move_x = np.sign(delta_x)\n            actions.append(craft.MOVE_FUNC(craft.DOWN if move_x == 1 else craft.UP))\n            agent_pos[0] += move_x\n        elif abs(delta_y) > abs(delta_x):\n            move_y = np.sign(delta_y)\n            actions.append(craft.MOVE_FUNC(craft.RIGHT if move_y == 1 else craft.LEFT))\n            agent_pos[1] += move_y\n\n    return actions\n\n  def face_workshop(workshop_position):\n      current_direction = env._current_state.dir\n      delta_x = workshop_position[0] - env._current_state.pos[0]\n      delta_y = workshop_position[1] - env._current_state.pos[1]\n\n      target_direction = None\n      if delta_x > 0:\n          target_direction = craft.DOWN\n      elif delta_x < 0:\n          target_direction = craft.UP\n      elif delta_y > 0:\n          target_direction = craft.RIGHT\n      else:\n          target_direction = craft.LEFT\n\n      actions = []\n      while current_direction != target_direction:\n          if (current_direction + 1) % 4 == target_direction:\n              actions.append(craft.MOVE_FUNC(craft.RIGHT))\n          elif (current_direction - 1) % 4 == target_direction:\n              actions.append(craft.MOVE_FUNC(craft.LEFT))\n          else:\n              actions.append(craft.MOVE_FUNC(craft.RIGHT))\n              actions.append(craft.MOVE_FUNC(craft.RIGHT))\n\n          current_direction = (current_direction + len(actions)) % 4\n\n      return actions\n  \n  i_goal = env.world.cookbook.index[item]\n  \n  # Get the primitives required to craft this item\n  prim_reqs = get_required_primitives(i_goal)\n  \n  # Actions list to be returned\n  actions_list = []\n\n  # Check if we have all the required primitives in our inventory\n  for i_prim, count in prim_reqs.items():\n      if env._current_state.inventory[i_prim] < count:\n          return []  # If any primitive is missing, return an empty action list\n  \n  # Find which workshop to use for crafting\n  workshop_index = None\n  workshop_name = \"_key\"\n  \n  # Iterate over the recipes and find the workshop\n  for output_index, recipe in env.world.cookbook.recipes.items():\n      if i_goal == output_index:\n          workshop_name = recipe[\"_at\"]\n          break\n  \n  # Get the index of the workshop from the environment's indices\n  try:\n      workshop_index = getattr(env.world, f\"{workshop_name}_index\")\n  except AttributeError:\n      return []  # If the workshop is not found, return an empty action list\n  \n  # Now that we have all the requirements and know where to craft, let's move to the workshop\n  workshop_pos = get_workshop_position(workshop_index)\n  \n  # Calculate the direction towards the workshop\n  agent_pos = env._current_state.pos\n\n  actions_list.extend(move_to(workshop_pos))\n  \n  # Face the workshop once we reach there\n  actions_list.extend(face_workshop(workshop_pos))\n\n  # Once facing the workshop, use it to craft the item\n  actions_list.append(craft.USE_FUNC())\n  \n  return actions_list", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T15:06:31.975964", "function_name": "craft", "function_body": "  def get_workshop_position(workshop_index):\n      positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n      if len(positions) > 0:\n          return positions[0]\n      else:\n          raise ValueError(f\"No position found for workshop index: {workshop_index}\")\n  \n  def move_to(target_pos):\n      current_pos = env._current_state.pos\n      actions = []\n      \n      # Calculate the direction to move\n      delta_x = target_pos[0] - current_pos[0]\n      delta_y = target_pos[1] - current_pos[1]\n      \n      while not (delta_x == 0 and delta_y == 0):\n          if abs(delta_x) > abs(delta_y):\n              move_x = np.sign(delta_x)\n              actions.append(craft.MOVE_FUNC(craft.DOWN if move_x == 1 else craft.UP))\n              delta_x -= move_x\n          elif abs(delta_y) > abs(delta_x):\n              move_y = np.sign(delta_y)\n              actions.append(craft.MOVE_FUNC(craft.RIGHT if move_y == 1 else craft.LEFT))\n              delta_y -= move_y\n          # Handle the case where both deltas are equal (diagonal movement)\n          else:\n              move_x, move_y = np.random.choice([(0, 1), (0, -1), (1, 0), (-1, 0)])\n              action = craft.MOVE_FUNC(craft.RIGHT if move_x == 1 else \n                                        craft.LEFT if move_x == -1 else \n                                        craft.DOWN if move_y == 1 else \n                                        craft.UP)\n              actions.append(action)\n      \n      return actions\n\n  def face_workshop(workshop_position):\n      current_direction = env._current_state.dir\n      delta_x = workshop_position[0] - env._current_state.pos[0]\n      delta_y = workshop_position[1] - env._current_state.pos[1]\n\n      target_direction = None\n      if delta_x > 0:\n          target_direction = craft.DOWN\n      elif delta_x < 0:\n          target_direction = craft.UP\n      elif delta_y > 0:\n          target_direction = craft.RIGHT\n      else:\n          target_direction = craft.LEFT\n\n      actions = []\n      while current_direction != target_direction:\n          if (current_direction + 1) % 4 == target_direction:\n              actions.append(craft.MOVE_FUNC(craft.RIGHT))\n          elif (current_direction - 1) % 4 == target_direction:\n              actions.append(craft.MOVE_FUNC(craft.LEFT))\n          else:\n              actions.append(craft.MOVE_FUNC(craft.RIGHT))\n              actions.append(craft.MOVE_FUNC(craft.RIGHT))\n\n          current_direction = (current_direction + len(actions)) % 4\n\n      return actions\n\n  i_goal = env.world.cookbook.index[item]\n  \n  # Get the primitives required to craft this item\n  prim_reqs = env.world.cookbook.primitives_for(i_goal)\n  \n  # Check if we have all the required primitives in our inventory\n  for i_prim, count in prim_reqs.items():\n      if env._current_state.inventory[i_prim] < count:\n          return []  # If any primitive is missing, return an empty action list\n  \n  # Find which workshop to use for crafting\n  workshop_index = None\n  workshop_name = \"_key\"\n  \n  # Iterate over the recipes and find the workshop\n  for output_index, recipe in env.world.cookbook.recipes.items():\n      if i_goal == output_index:\n          workshop_name = recipe[\"_at\"]\n          break\n  \n  # Get the index of the workshop from the environment's indices\n  try:\n      workshop_index = getattr(env.world, f\"{workshop_name}_index\")\n  except AttributeError:\n      return []  # If the workshop is not found, return an empty action list\n  \n  # Now that we have all the requirements and know where to craft, let's move to the workshop\n  workshop_pos = get_workshop_position(workshop_index)\n  \n  actions_list = []\n  \n  # Move to the workshop\n  actions_list.extend(move_to(workshop_pos))\n  \n  # Face the workshop once we reach there\n  actions_list.extend(face_workshop(workshop_pos))\n  \n  # Once facing the workshop, use it to craft the item\n  actions_list.append(craft.USE_FUNC())\n  \n  return actions_list", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T15:08:31.807650", "function_name": "craft", "function_body": "  def generate_path_to_workshop(current_state, workshop_index):\n    grid = env.world.grid\n    queue = collections.deque([current_state.pos])\n    visited = set([current_state.pos])\n    parent = {current_state.pos: None}\n    \n    while queue:\n        x, y = queue.popleft()\n        \n        # Check if we are next to the workshop\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            nx, ny = x + dx, y + dy\n            if grid[nx][ny] == workshop_index:\n                # Backtrack to find the path\n                path = []\n                while (nx, ny) != current_state.pos:\n                    path.append((nx, ny))\n                    nx, ny = parent[(nx, ny)]\n                return path[::-1]\n            \n            if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and grid[nx][ny] not in env.world.cookbook.index and (nx, ny) not in visited:\n                queue.append((nx, ny))\n                visited.add((nx, ny))\n                parent[(nx, ny)] = (x, y)\n    \n    return None\n\n  def generate_actions_from_path(path, current_state):\n      actions = []\n      for next_pos in path:\n          dx, dy = next_pos[0] - current_state.pos[0], next_pos[1] - current_state.pos[1]\n          if (dx, dy) == (-1, 0):\n              actions.append(2)  # LEFT\n          elif (dx, dy) == (1, 0):\n              actions.append(3)  # RIGHT\n          elif (dx, dy) == (0, -1):\n              actions.append(0)  # DOWN\n          elif (dx, dy) == (0, 1):\n              actions.append(1)  # UP\n      \n      return actions\n\n  def is_next_to_workshop_and_facing(current_state, workshop_index):\n    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n      neighbor_pos = (current_state.pos[0] + dx, current_state.pos[1] + dy)\n      if env.world.grid[neighbor_pos] == workshop_index and current_state.dir == ((dx, dy), (-dx, -dy)):\n        return True\n    return False\n\n  def generate_actions_to_move_and_face(current_state, workshop_index):\n    actions = []\n    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n      neighbor_pos = (current_state.pos[0] + dx, current_state.pos[1] + dy)\n      if env.world.grid[neighbor_pos] == workshop_index:\n        target_dir = ((dx, dy), (-dx, -dy))\n        current_dir = current_state.dir\n        \n        # Turn to face the correct direction\n        if current_dir != target_dir:\n          actions.append((target_dir.index(current_state.dir) + 2) % 4)  # Turn to face the workshop\n        actions.append(4)  # Use action to craft at the workshop\n        return actions\n    return []\n\n  item_index = env.world.cookbook.index[item]\n\n  # If the item has no recipe or is not a crafted item, return an empty action list\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the recipe for the desired item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Check if all required ingredients are available in the inventory\n  required_ingredients = {env.world.cookbook.index[ingredient]: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n  available_ingredients = {k: v for k, v in enumerate(env._current_state.inventory) if v > 0}\n\n  # If all ingredients are not available, return an empty action list\n  if any(required_ingredient not in available_ingredients or available_ingredients[required_ingredient] < count \n         for required_ingredient, count in required_ingredients.items()):\n    return []\n\n  # Find the workshop index where the item should be crafted\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n  \n  # If we are already next to and facing the correct workshop, perform the USE action\n  if is_next_to_workshop_and_facing(env._current_state, workshop_index):\n    return [4]  # USE action\n\n  # Generate path to workshop\n  path_to_workshop = generate_path_to_workshop(env._current_state, workshop_index)\n\n  if not path_to_workshop:\n      return []\n\n  actions = generate_actions_from_path(path_to_workshop, env._current_state)\n\n  # Add actions to face the workshop and perform the USE action\n  actions.extend(generate_actions_to_move_and_face(env._current_state, workshop_index))\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T15:08:32.904549", "function_name": "craft", "function_body": "  def is_next_to_workshop(current_state, workshop_index):\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          neighbor_pos = (current_state.pos[0] + dx, current_state.pos[1] + dy)\n          if env.world.grid[neighbor_pos] == workshop_index:\n              return True\n      return False\n\n  def generate_actions_from_path(path, current_state):\n      actions = []\n      for next_pos in path:\n          dx, dy = next_pos[0] - current_state.pos[0], next_pos[1] - current_state.pos[1]\n          if (dx, dy) == (-1, 0):\n              actions.append(2)  # LEFT\n          elif (dx, dy) == (1, 0):\n              actions.append(3)  # RIGHT\n          elif (dx, dy) == (0, -1):\n              actions.append(0)  # DOWN\n          elif (dx, dy) == (0, 1):\n              actions.append(1)  # UP\n      \n      return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # If the item has no recipe or is not a crafted item, return an empty action list\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the recipe for the desired item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Check if all required ingredients are available in the inventory\n  required_ingredients = {env.world.cookbook.index[ingredient]: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n  available_ingredients = {k: v for k, v in enumerate(env._current_state.inventory) if v > 0}\n\n  # If all ingredients are not available, return an empty action list\n  if any(required_ingredient not in available_ingredients or available_ingredients[required_ingredient] < count \n         for required_ingredient, count in required_ingredients.items()):\n    return []\n\n  # Find the workshop index where the item should be crafted\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  if is_next_to_workshop(env._current_state, workshop_index):\n      target_dir = ((1, 0), (-1, 0), (0, -1), (0, 1)).index((path_to_workshop[-1][0] - env._current_state.pos[0], path_to_workshop[-1][1] - env._current_state.pos[1]))\n      current_dir = ((1, 0), (-1, 0), (0, -1), (0, 1)).index(env._current_state.dir)\n      \n      if current_dir != target_dir:\n          actions.append((target_dir + 2) % 4)  # Turn to face the workshop\n      \n      actions.append(4)  # USE action to craft at the workshop\n\n  # Generate the path to the nearest workshop\n  path_to_workshop = generate_path_to_workshop(env._current_state, workshop_index)\n\n  if not path_to_workshop:\n    return []\n\n  actions = generate_actions_from_path(path_to_workshop, env._current_state)\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T15:10:16.924743", "function_name": "craft", "function_body": "  def has_all_primitives(required_primitives, inventory_dict):\n    return all(primitive in inventory_dict and inventory_dict[primitive] >= required_primitives[primitive] for primitive in required_primitives)\n\n  def find_closest_workshop(workshop_index, grid, agent_pos):\n    workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n    if len(workshop_positions) == 0:\n      return None\n    # Calculate the Manhattan distance to each workshop and choose the closest one\n    distances = [abs(agent_pos[0] - pos[0]) + abs(agent_pos[1] - pos[1]) for pos in workshop_positions]\n    closest_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n    return closest_workshop_pos\n\n  def navigate(state, target):\n    actions = []\n    current_x, current_y = state.pos\n    target_x, target_y = target\n\n    # Move horizontally first\n    while current_x < target_x:\n        actions.append(3)  # RIGHT\n        current_x += 1\n    while current_x > target_x:\n        actions.append(2)  # LEFT\n        current_x -= 1\n\n    # Then move vertically\n    while current_y < target_y:\n        actions.append(0)  # DOWN\n        current_y += 1\n    while current_y > target_y:\n        actions.append(1)  # UP\n        current_y -= 1\n\n    return actions\n\n  def get_direction(current_pos, target_pos):\n    current_x, current_y = current_pos\n    target_x, target_y = target_pos\n\n    if current_x < target_x:\n      return 3  # RIGHT\n    elif current_x > target_x:\n      return 2  # LEFT\n    elif current_y < target_y:\n      return 0  # DOWN\n    else:\n      return 1  # UP\n  \n  actions = []\n  \n  # Get the index of the goal item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  # If not all primitives are available return empty action list\n  if not has_all_primitives(required_primitives, inventory_dict):\n    return []\n  \n  # Find the workshop where we can craft this item\n  workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n      if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n          workshop_index = recipe.get(\"_at\")\n          break\n  \n  if workshop_index is None:\n    return []\n\n  # Find the position of the nearest workshop in the grid\n  target_workshop_pos = find_closest_workshop(workshop_index, env._current_state.grid, env._current_state.pos)\n  if target_workshop_pos is None:\n    return []\n  \n  # Navigate to the selected workshop\n  actions.extend(navigate(env._current_state, target_workshop_pos))\n  \n  # Turn towards the workshop if not already facing it\n  current_direction = env._current_state.dir\n  direction_to_workshop = get_direction(env._current_state.pos, target_workshop_pos)\n  if current_direction != direction_to_workshop:\n    actions.append(direction_to_workshop)\n\n  # Use the USE action to craft the item at the workshop\n  actions.append(4)  # Assuming 4 is the index for the USE action\n  \n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T15:10:18.018272", "function_name": "craft", "function_body": "  def has_all_primitives(required_primitives, inventory_dict):\n    return all(primitive in inventory_dict and inventory_dict[primitive] >= required_primitives[primitive] for primitive in required_primitives)\n\n  def find_closest_workshop(workshop_index, grid, agent_pos):\n    workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n    if len(workshop_positions) == 0:\n      return None\n    distances = [np.linalg.norm(np.array(pos) - np.array(agent_pos)) for pos in workshop_positions]\n    closest_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n    return closest_workshop_pos\n\n  def navigate(state, target):\n    actions = []\n    current_x, current_y = state.pos\n    target_x, target_y = target\n\n    # Move horizontally first\n    while current_x < target_x:\n        actions.append(3)  # RIGHT\n        current_x += 1\n    while current_x > target_x:\n        actions.append(2)  # LEFT\n        current_x -= 1\n\n    # Then move vertically\n    while current_y < target_y:\n        actions.append(0)  # DOWN\n        current_y += 1\n    while current_y > target_y:\n        actions.append(1)  # UP\n        current_y -= 1\n\n    return actions\n\n  def get_direction(current_pos, target_pos):\n    current_x, current_y = current_pos\n    target_x, target_y = target_pos\n\n    if current_x < target_x:\n      return 3  # RIGHT\n    elif current_x > target_x:\n      return 2  # LEFT\n    elif current_y < target_y:\n      return 0  # DOWN\n    else:\n      return 1  # UP\n\n  actions = []\n  \n  # Get the index of the goal item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  # If not all primitives are available return empty action list\n  if not has_all_primitives(required_primitives, inventory_dict):\n    return []\n  \n  # Find the workshop where we can craft this item\n  workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n      if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n          workshop_index = recipe.get(\"_at\")\n          break\n  \n  if workshop_index is None:\n    return []\n\n  # Find the position of the nearest workshop in the grid relative to the agent's current position\n  target_workshop_pos = find_closest_workshop(workshop_index, env._current_state.grid, env._current_state.pos)\n  if target_workshop_pos is None:\n    return []\n  \n  # Navigate to the selected workshop\n  actions.extend(navigate(env._current_state, target_workshop_pos))\n  \n  # Turn towards the workshop if not already facing it\n  current_direction = env._current_state.dir\n  direction_to_workshop = get_direction(env._current_state.pos, target_workshop_pos)\n  if current_direction != direction_to_workshop:\n    actions.append(direction_to_workshop)\n\n  # Use the USE action to craft the item at the workshop\n  actions.append(4)  # Assuming 4 is the index for the USE action\n  \n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T15:12:10.541281", "function_name": "craft", "function_body": "  def has_all_primitives(required_primitives, inventory_dict):\n    return all(primitive in inventory_dict and inventory_dict[primitive] >= required_primitives[primitive] for primitive in required_primitives)\n\n  def find_closest_workshop(workshop_index, grid, current_pos):\n    workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n    if len(workshop_positions) == 0:\n      return None\n    distances = [np.linalg.norm(np.array(pos) - np.array(current_pos)) for pos in workshop_positions]\n    closest_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n    return closest_workshop_pos\n\n  def navigate(state, target_position):\n    actions = []\n    current_position = state.pos\n    while current_position != target_position:\n        next_step_action = get_next_step(current_position, target_position)\n        actions.append(next_step_action)\n\n        # Update current position based on action (simple update for demonstration)\n        if next_step_action == 3:  # RIGHT\n            current_position = (current_position[0] + 1, current_position[1])\n        elif next_step_action == 2:  # LEFT\n            current_position = (current_position[0] - 1, current_position[1])\n        elif next_step_action == 1:  # UP\n            current_position = (current_position[0], current_position[1] + 1)\n        else:  # DOWN\n            current_position = (current_position[0], current_position[1] - 1)\n\n    return actions\n\n  def get_next_step(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if abs(dx) > abs(dy):\n          return 3 if dx > 0 else 2\n      else:\n          return 1 if dy > 0 else 0\n\n  def get_direction(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if abs(dx) > abs(dy):\n          return 3 if dx > 0 else 2\n      else:\n          return 1 if dy > 0 else 0\n\n  actions = []\n  \n  # Get the index of the goal item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  # If not all primitives are available return empty action list\n  if not has_all_primitives(required_primitives, inventory_dict):\n    return []\n  \n  # Find the workshop where we can craft this item and its position\n  workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n      workshop_index = recipe.get(\"_at\")\n      break\n  \n  if workshop_index is None:\n    return []\n\n  # Find the positions of all workshops with the same index\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(workshop_positions) == 0:\n    return []\n  \n  # Select the closest workshop\n  current_pos = env._current_state.pos\n  target_workshop_pos = find_closest_workshop(workshop_index, env._current_state.grid, current_pos)\n\n  # Navigate to the selected workshop\n  actions.extend(navigate(env._current_state, target_workshop_pos))\n  \n  # Turn towards the workshop if not already facing it\n  current_direction = env._current_state.dir\n  direction_to_workshop = get_direction(current_pos, target_workshop_pos)\n  if current_direction != direction_to_workshop:\n    actions.append(direction_to_workshop)\n\n  # Use the USE action to craft the item at the workshop\n  actions.append(4)  # Assuming 4 is the index for the USE action\n  \n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T15:12:11.624358", "function_name": "craft", "function_body": "  def has_all_primitives(required_primitives, inventory_dict):\n    return all(primitive in inventory_dict and inventory_dict[primitive] >= required_primitives[primitive] for primitive in required_primitives)\n\n  actions = []\n  \n  # Get the index of the goal item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  # If not all primitives are available return empty action list\n  if not has_all_primitives(required_primitives, inventory_dict):\n    return []\n  \n  # Find the workshop where we can craft this item\n  workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n      workshop_index = recipe.get(\"_at\")\n      break\n  \n  if workshop_index is None:\n    return []\n\n  # Convert workshop index to the actual name of the workshop\n  workshop_name = env.world.cookbook.index.get(workshop_index)\n  \n  # Find the position of the nearest workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(workshop_positions) == 0:\n    return []\n  \n  # Select the closest workshop (for simplicity, we take the first one found)\n  target_workshop_pos = tuple(min(workshop_positions, key=lambda x: np.linalg.norm(np.array(x) - np.array(env._current_state.pos))))\n  \n  # Navigate to the selected workshop\n  actions.extend(navigate(env._current_state, target_workshop_pos))\n  \n  # Turn towards the workshop if not already facing it\n  current_direction = env._current_state.dir\n  direction_to_workshop = get_direction(env._current_state.pos, target_workshop_pos)\n  if current_direction != direction_to_workshop:\n    actions.append(direction_to_workshop)\n\n  # Use the USE action to craft the item at the workshop\n  actions.append(4)  # Assuming 4 is the index for the USE action\n\n  # Check and collect missing primitives if needed\n  for primitive, count in required_primitives.items():\n      if inventory_dict.get(primitive, 0) < count:\n          actions.extend(collect(env, primitive))\n\n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T15:13:56.432456", "function_name": "craft", "function_body": "  # Retrieve the goal index and required primitives\n  goal_index = env.world.cookbook.index[item]\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  \n  # Check if we have all required primitives in our inventory\n  current_inventory = collections.Counter(env._current_state.inventory)\n\n  for primitive, count in required_primitives.items():\n    if current_inventory[primitive] < count:\n      return []  # Missing required primitives\n\n  # Determine the workshop where crafting should occur\n  recipe_details = env.world.cookbook.recipes[goal_index]\n  workshop_name = recipe_details[\"_key\"]\n\n  # Get the index of the workshop from the world's cookbook\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the closest workshop in the grid\n  positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(positions) == 0:\n    return []  # No available workshops\n\n  closest_workshop_pos = min(\n      positions, key=lambda x: abs(x[0] - env._current_state.pos[0]) + abs(x[1] - env._current_state.pos[1]))\n\n  # Navigate to the closest workshop\n  current_pos = np.array(env._current_state.pos)\n  target_pos = np.array(closest_workshop_pos)\n\n  actions = []\n\n  while not np.array_equal(current_pos, target_pos):\n    delta = target_pos - current_pos\n\n    if delta[0] > 0:\n      actions.append(craft.RIGHT)  # Move right\n    elif delta[0] < 0:\n      actions.append(craft.LEFT)   # Move left\n\n    if delta[1] > 0:\n      actions.append(craft.DOWN)   # Move down\n    elif delta[1] < 0:\n      actions.append(craft.UP)     # Move up\n\n    current_pos = np.array(env._current_state.pos)\n\n  # Orient the agent to face the workshop and use it\n  if env._current_state.grid[target_pos[0], target_pos[1], workshop_index] == 1:\n    actions.append(craft.USE)\n\n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T15:13:57.547410", "function_name": "craft", "function_body": "  goal_index = env.world.cookbook.index[item]\n\n  # Check if we have all required primitives in our inventory\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  current_inventory = collections.Counter(env._current_state.inventory)\n\n  for primitive, count in required_primitives.items():\n    if current_inventory[primitive] < count:\n      return []  # Missing required primitives\n\n  # Determine the workshop where crafting should occur\n  recipe_details = env.world.cookbook.recipes[goal_index]\n  workshop_name = recipe_details[\"_key\"]\n\n  # Get the index of the workshop from the world's cookbook\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the closest workshop in the grid\n  positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(positions) == 0:\n    return []  # No available workshops\n\n  closest_workshop_pos = min(\n      positions, key=lambda x: abs(x[0] - env._current_state.pos[0]) + abs(x[1] - env._current_state.pos[1]))\n\n  actions = []\n\n  # Navigate to the closest workshop using A* pathfinding\n  start = np.array(env._current_state.pos)\n  target = np.array(closest_workshop_pos)\n\n  def heuristic(a, b):\n    return np.abs(a[0] - b[0]) + np.abs(a[1] - b[1])\n\n  open_list = []\n  closed_set = set()\n  g_costs = {tuple(start): 0}\n  f_costs = {tuple(start): heuristic(start, target)}\n  came_from = {}\n\n  open_list.append((f_costs[tuple(start)], tuple(start)))\n\n  while open_list:\n    _, current = open_list.pop(0)\n    if current in closed_set:\n      continue\n    if np.array_equal(current, target):\n      break\n\n    for neighbor in [(current[0] + 1, current[1]), (current[0] - 1, current[1]),\n                     (current[0], current[1] + 1), (current[0], current[1] - 1)]:\n      if not (0 <= neighbor[0] < env._current_state.grid.shape[0] and\n              0 <= neighbor[1] < env._current_state.grid.shape[1]):\n          continue\n\n      tentative_g_cost = g_costs[tuple(current)] + heuristic(tuple(current), neighbor)\n\n      if neighbor in closed_set:\n        continue\n      if neighbor not in g_costs or tentative_g_cost < g_costs[neighbor]:\n        came_from[neighbor] = current\n        g_costs[neighbor] = tentative_g_cost\n        f_costs[neighbor] = tentative_g_cost + heuristic(neighbor, target)\n        open_list.append((f_costs[neighbor], neighbor))\n\n    closed_set.add(current)\n\n  # Reconstruct path\n  current = tuple(target)\n  while current in came_from:\n      actions.extend(get_move_action(env._current_state.pos, np.array(current)))\n      env._current_state.pos = np.array(current)\n      current = came_from[current]\n\n  # Orient the agent to face the workshop and use it\n  if env._current_state.grid[target[0], target[1], workshop_index] == 1:\n    actions.append(craft.USE)\n\n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T15:15:17.382923", "function_name": "craft", "function_body": "  goal_index = env.world.cookbook.index[item]\n\n  # Check if we have all required primitives in our inventory\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  current_inventory = collections.Counter(env._current_state.inventory)\n\n  for primitive, count in required_primitives.items():\n    if current_inventory[primitive] < count:\n      return []  # Missing required primitives\n\n  # Determine the workshop where crafting should occur\n  recipe_details = env.world.cookbook.recipes[goal_index]\n  workshop_name = recipe_details[\"_key\"]\n\n  # Get the index of the workshop from the world's cookbook\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the closest workshop in the grid\n  positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(positions) == 0:\n    return []  # No available workshops\n\n  closest_workshop_pos = min(\n      positions, key=lambda x: abs(x[0] - env._current_state.pos[0]) + abs(x[1] - env._current_state.pos[1]))\n\n  # Navigate to the closest workshop\n  current_pos = np.array(env._current_state.pos)\n  target_pos = np.array(closest_workshop_pos)\n\n  actions = []\n\n  while not np.array_equal(current_pos, target_pos):\n    delta = target_pos - current_pos\n\n    if abs(delta[0]) > abs(delta[1]):\n      if delta[0] > 0:\n        actions.append(craft.RIGHT)  # Move right\n      elif delta[0] < 0:\n        actions.append(craft.LEFT)   # Move left\n    else:\n      if delta[1] > 0:\n        actions.append(craft.DOWN)   # Move down\n      elif delta[1] < 0:\n        actions.append(craft.UP)     # Move up\n\n    current_pos = np.array(env._current_state.pos)\n\n  # Orient the agent to face the workshop and use it\n  direction_to_workshop = target_pos - current_pos\n\n  if direction_to_workshop[0] > 0:  # Workshop is to the right\n      actions.append(craft.RIGHT)\n  elif direction_to_workshop[0] < 0:  # Workshop is to the left\n      actions.append(craft.LEFT)\n  elif direction_to_workshop[1] > 0:  # Workshop is below\n      actions.append(craft.DOWN)\n  else:  # Workshop is above\n      actions.append(craft.UP)\n\n  actions.append(craft.USE)  # Use action to start crafting\n\n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T15:15:18.428730", "function_name": "craft", "function_body": "  goal_index = env.world.cookbook.index[item]\n\n  # Check if we have all required primitives in our inventory\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  current_inventory = collections.Counter(env._current_state.inventory)\n\n  for primitive, count in required_primitives.items():\n    if current_inventory[primitive] < count:\n      return []  # Missing required primitives\n\n  # Determine the workshop where crafting should occur\n  recipe_details = env.world.cookbook.recipes[goal_index]\n  workshop_name = recipe_details[\"_key\"]\n\n  # Get the index of the workshop from the world's cookbook\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the closest workshop in the grid\n  positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(positions) == 0:\n    return []  # No available workshops\n\n  closest_workshop_pos = min(\n      positions, key=lambda x: abs(x[0] - env._current_state.pos[0]) + abs(x[1] - env._current_state.pos[1]))\n\n  # Navigate to the closest workshop\n  current_pos = np.array(env._current_state.pos)\n  target_pos = np.array(closest_workshop_pos)\n\n  actions = []\n\n  while not np.array_equal(current_pos, target_pos):\n    delta = target_pos - current_pos\n\n    if abs(delta[0]) > abs(delta[1]):\n      # Prioritize moving horizontally\n      if delta[0] > 0:\n        actions.append(craft.RIGHT)  # Move right\n      else:\n        actions.append(craft.LEFT)   # Move left\n    else:\n      # Prioritize moving vertically\n      if delta[1] > 0:\n        actions.append(craft.DOWN)   # Move down\n      else:\n        actions.append(craft.UP)     # Move up\n\n    current_pos = np.array(env._current_state.pos)\n\n  # Orient the agent to face the workshop and use it\n  direction_to_workshop = target_pos - current_pos\n\n  if direction_to_workshop[0] > 0:  # Workshop is to the right\n      actions.append(craft.RIGHT)\n  elif direction_to_workshop[0] < 0:  # Workshop is to the left\n      actions.append(craft.LEFT)\n  elif direction_to_workshop[1] > 0:  # Workshop is below\n      actions.append(craft.DOWN)\n  else:  # Workshop is above\n      actions.append(craft.UP)\n\n  actions.append(craft.USE)\n\n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T15:16:08.413237", "function_name": "craft", "function_body": "  # Step 1: Determine the recipe and required items\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n  \n  if goal_index not in cookbook.recipes:\n    print(f\"No recipe found for {item}\")\n    return []\n\n  recipe = cookbook.recipes[goal_index]\n\n  # Step 2: Check inventory for required items\n  actions_to_take = []\n  current_inventory = env._current_state.inventory\n\n  # Collecting primitives that are missing from the inventory\n  for ingredient, count in recipe.items():\n      if ingredient == \"_key\": continue\n      ingredient_name = cookbook.index.get(ingredient)\n      while current_inventory[ingredient] < count:\n          actions_to_take.extend(collect(env, ingredient_name))\n          # Update inventory after collecting\n          current_inventory += env._current_state.inventory\n\n  # Step 3: Navigate to the workshop specified in the recipe\n  workshop_key = recipe[\"_key\"]\n  workshop_index = cookbook.index[workshop_key]\n  \n  if workshop_index not in env.world.workshop_indices:\n    print(f\"No valid workshop found for {item}\")\n    return []\n\n  actions_to_take.extend(navigate_to_workshop(env, workshop_index))\n  \n  # Step 4: Perform the USE action to craft the item\n  actions_to_take.append(craft.USE)\n  \n  return actions_to_take", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-11T15:16:09.383745", "function_name": "craft", "function_body": "  # Convert the item name to its index using the cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the item has a recipe\n  if item_index not in env.world.cookbook.recipes:\n    return []  # No recipe for this item\n\n  # Get the required ingredients and their counts from the recipe\n  recipe = env.world.cookbook.recipes[item_index]\n\n  actions = []\n  \n  # Check if we have all the ingredients needed to craft the item\n  # We need to check both primitives and intermediate items\n  for ingredient, count in recipe.items():\n    if ingredient == \"_key\":\n      continue  # Skip the \"_key\" which is the workshop indicator\n    \n    ingredient_index = env.world.cookbook.index[ingredient]\n    \n    # If we don't have enough of this ingredient, try to collect more\n    if env._current_state.inventory[ingredient_index] < count:\n      # Collect the primitive or intermediate item\n      actions.extend(collect(env, ingredient))\n      \n      # Check again after collecting if we have enough now\n      if env._current_state.inventory[ingredient_index] < count:\n        return []  # Still not enough ingredients\n  \n  # If we reach here, we have all ingredients needed to craft the item\n  \n  # Determine which workshop to use based on \"_key\" in the recipe\n  workshop_key = recipe[\"_key\"]\n  workshop_name = parse_fexp(workshop_key)[0]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find a position adjacent to any workshop with the correct index\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  \n  if len(workshop_positions) == 0:\n    return []  # No available workshops\n  \n  # Choose the closest workshop (for simplicity, choose the first one found)\n  target_pos = tuple(workshop_positions[0])\n  \n  # Navigate to a position adjacent to the chosen workshop\n  actions.extend(navigate(env._current_state.pos, target_pos))\n  \n  # Turn to face the workshop and use it to craft the item\n  actions.append(DOWN)  # Assuming DOWN is one of the directions towards the workshop\n  actions.append(USE)\n  \n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-11T15:17:26.748446", "function_name": "craft", "function_body": "    # Get the index of the item we want to craft\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all primitives required for crafting this item\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  \n  actions_to_take = []\n\n  # Check if the inventory already has the required items\n  for primitive, count in required_primitives.items():\n    while env._current_state.inventory[primitive] < count:\n      # Find the location of the primitives we need to collect\n      locations_of_primitive = np.argwhere(env._current_state.grid[:, :, primitive] > 0)\n      \n      if len(locations_of_primitive) == 0:\n        return []  # Cannot find the required primitives\n      \n      # Navigate to a nearby location with the primitive and collect it\n      for loc in locations_of_primitive:\n        actions_to_take.extend(navigate(env._current_state, loc))\n        actions_to_take.append(craft.COLLECT_FUNC(loc[1], loc[0]))\n      \n      # Check if we have collected enough of this primitive\n      if env._current_state.inventory[primitive] < count:\n        return []  # Failed to collect required amount of primitives\n  \n  # Navigate to the workshop where crafting can occur\n  workshop_index = env.world.workshop_indices[item_index]\n  workshop_location = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_location) == 0:\n    return []  # Cannot find the required workshop\n  \n  actions_to_take.extend(navigate(env._current_state, workshop_location[0]))\n  \n  # Face the workshop and perform the USE action\n  actions_to_take.append(craft.USE_ACTION)\n\n  return actions_to_take", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-11T15:17:27.814452", "function_name": "craft", "function_body": "  def find_item_in_grid(grid, item_index):\n    \"\"\"Helper function to find the position of an item in the grid.\"\"\"\n    positions = np.argwhere(grid[:, :, item_index] == 1)\n    return [(x, y) for x, y in positions]\n\n  def move_to_position(current_pos, target_pos, dir) -> list[int]:\n    \"\"\"Helper function to generate actions to move from current position to target position.\"\"\"\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n    actions = []\n    if dx < 0:\n        actions.extend([craft.LEFT for _ in range(abs(dx))])\n    elif dx > 0:\n        actions.extend([craft.RIGHT for _ in range(dx)])\n    if dy < 0:\n        actions.extend([craft.DOWN for _ in range(abs(dy))])\n    elif dy > 0:\n        actions.extend([craft.UP for _ in range(dy)])\n    return actions\n\n  def turn_to_face_use(current_dir, target_dir) -> list[int]:\n      \"\"\"Helper function to generate actions to face the target direction.\"\"\"\n      dir_names = ['DOWN', 'UP', 'LEFT', 'RIGHT']\n      current_index = dir_names.index(current_dir)\n      target_index = dir_names.index(target_dir)\n      diff = (target_index - current_index) % 4\n      if diff == 1:\n          return [craft.RIGHT]\n      elif diff == 2:\n          return [craft.LEFT, craft.LEFT] or [craft.RIGHT, craft.RIGHT]\n      elif diff == 3:\n          return [craft.LEFT]\n      return []\n\n  def collect_primitives(primitive_indices):\n    \"\"\"Helper function to collect all primitives required for crafting.\"\"\"\n    actions = []\n    current_pos = env._current_state.pos\n    current_dir = env._current_state.dir\n    for primitive_index in primitive_indices:\n        positions = find_item_in_grid(env._current_state.grid, primitive_index)\n        if not positions:\n            continue  # If no position found, skip this primitive\n        closest_position = min(positions, key=lambda pos: np.linalg.norm(np.array(pos) - np.array(current_pos)))\n        actions.extend(move_to_position(current_pos, closest_position, current_dir))\n        actions.append(craft.USE)\n        current_pos = closest_position\n    return actions\n\n  def get_primitive_indices(item_index):\n    \"\"\"Helper function to get all primitive indices required for crafting an item.\"\"\"\n    cookbook = env.world.cookbook\n    return [primitive_index for primitive_index in cookbook.primitives_for(item_index)]\n\n  # Get the index of the item from the cookbook.\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the primitives required for crafting.\n  primitive_indices = get_primitive_indices(item_index)\n  actions_to_collect_primitives = collect_primitives(primitive_indices)\n\n  if not all(env._current_state.inventory[primitive_index] > 0 for primitive_index in primitive_indices):\n      return actions_to_collect_primitives  # If not, collect primitives and return.\n\n  # Get the workshop index from the recipe.\n  cookbook = env.world.cookbook\n  recipe = cookbook.recipes[item_index]\n  workshop_name = recipe.get(\"_key\", \"workshop0\")\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find a position of the workshop in the grid.\n  workshop_positions = find_item_in_grid(env._current_state.grid, workshop_index)\n  if not workshop_positions:\n      return []  # If no workshop found, return empty action list.\n\n  closest_workshop_position = min(workshop_positions, key=lambda pos: np.linalg.norm(np.array(pos) - np.array(env._current_state.pos)))\n\n  # Generate actions to move to the closest workshop.\n  actions_to_move_to_workshop = move_to_position(env._current_state.pos, closest_workshop_position, env._current_state.dir)\n  \n  # Turn to face the workshop and perform USE action.\n  target_direction = 'UP' if closest_workshop_position[1] > env._current_state.pos[1] else \\\n                     'DOWN' if closest_workshop_position[1] < env._current_state.pos[1] else \\\n                     'LEFT' if closest_workshop_position[0] < env._current_state.pos[0] else \\\n                     'RIGHT'\n  actions_to_turn_and_use = turn_to_face_use(env._current_state.dir, target_direction)\n  actions_to_turn_and_use.append(craft.USE)\n\n  return actions_to_collect_primitives + actions_to_move_to_workshop + actions_to_turn_and_use", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-11T15:18:41.641183", "function_name": "craft", "function_body": "  def has_all_primitives(required_primitives, inventory_dict):\n    return all(primitive in inventory_dict and inventory_dict[primitive] >= required_primitives[primitive] for primitive in required_primitives)\n\n  def get_workshop_index_for_item(item_index, cookbook):\n      \"\"\"Retrieve the workshop index where an item can be crafted.\"\"\"\n      for recipe in cookbook.recipes.values():\n          if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n              return recipe.get(\"_at\")\n      return None\n\n  actions = []\n\n  # Get the index of the goal item\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n\n  if not has_all_primitives(required_primitives, inventory_dict):\n      return []\n\n  # Find the workshop where we can craft this item\n  workshop_index = get_workshop_index_for_item(item_index, env.world.cookbook)\n  if workshop_index is None:\n      return []\n\n  # Get positions of all workshops with the same index\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n      return []\n\n  # Select the closest workshop\n  current_pos = env._current_state.pos\n  target_workshop_pos = min(workshop_positions, key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1]))\n\n  # Navigate to the selected workshop and face it\n  actions.extend(navigate_and_face(env._current_state, target_workshop_pos))\n\n  # Use the USE action to craft the item at the workshop\n  actions.append(4)  # Assuming 4 is the index for the USE action\n\n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T15:18:42.729270", "function_name": "craft", "function_body": "  def has_all_primitives(required_primitives, inventory_dict):\n    return all(primitive in inventory_dict and inventory_dict[primitive] >= required_primitives[primitive] for primitive in required_primitives)\n\n  def find_workshop_position(item_index, state):\n    # Find the workshop where we can craft this item\n    workshop_index = None\n    for recipe in env.world.cookbook.recipes.values():\n      if item_index == recipe.get(\"_key\"):\n        workshop_index = recipe.get(\"_at\")\n        break\n    \n    if workshop_index is None:\n      return None\n    \n    # Find the positions of all workshops with the same index\n    workshop_positions = np.argwhere(state.grid[:, :, workshop_index] == 1)\n    if len(workshop_positions) == 0:\n      return None\n  \n    # Select the closest workshop\n    current_pos = state.pos\n    target_workshop_pos = min(workshop_positions, key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1]))\n    \n    return target_workshop_pos\n\n  actions = []\n  \n  # Get the index of the goal item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  # If not all primitives are available return empty action list\n  if not has_all_primitives(required_primitives, inventory_dict):\n    return []\n  \n  # Find the closest workshop position\n  target_workshop_pos = find_workshop_position(item_index, env._current_state)\n  if target_workshop_pos is None:\n    return []\n\n  # Navigate to the selected workshop\n  actions.extend(navigate(env._current_state, target_workshop_pos))\n  \n  # Turn towards the workshop if not already facing it\n  current_direction = env._current_state.dir\n  direction_to_workshop = get_direction(env._current_state.pos, target_workshop_pos)\n  if current_direction != direction_to_workshop:\n    actions.append(direction_to_workshop)\n\n  # Verify if we are at the correct position and facing the workshop\n  final_position = (env._current_state.pos[0] + direction_to_workshop[0], env._current_state.pos[1] + direction_to_workshop[1])\n  \n  if final_position != target_workshop_pos:\n    actions.append(get_direction(env._current_state.pos, final_position))\n  \n  # Use the USE action to craft the item at the workshop\n  actions.append(4)  # Assuming 4 is the index for the USE action\n  \n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T15:20:36.350304", "function_name": "craft", "function_body": "  goal_index = env.world.cookbook.index[item]\n\n  # Check if we have all required primitives in our inventory\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  current_inventory = collections.Counter(env._current_state.inventory)\n\n  for primitive, count in required_primitives.items():\n    if current_inventory[primitive] < count:\n      return []  # Missing required primitives\n\n  # Determine the workshop where crafting should occur\n  recipe_details = env.world.cookbook.recipes[goal_index]\n  workshop_name = recipe_details[\"_key\"]\n\n  # Get the index of the workshop from the world's cookbook\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the closest workshop in the grid\n  positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(positions) == 0:\n    return []  # No available workshops\n\n  closest_workshop_pos = min(\n      positions, key=lambda x: abs(x[0] - env._current_state.pos[0]) + abs(x[1] - env._current_state.pos[1]))\n\n  # Navigate to the closest workshop\n  current_pos = np.array(env._current_state.pos)\n  target_pos = np.array(closest_workshop_pos)\n\n  actions = []\n\n  while not np.array_equal(current_pos, target_pos):\n    delta = target_pos - current_pos\n\n    # Calculate direction based on the largest absolute difference\n    if abs(delta[0]) > abs(delta[1]):\n      if delta[0] > 0:\n        actions.append(craft.RIGHT)  # Move right\n      else:\n        actions.append(craft.LEFT)   # Move left\n    else:\n      if delta[1] > 0:\n        actions.append(craft.DOWN)   # Move down\n      else:\n        actions.append(craft.UP)     # Move up\n\n    current_pos = np.array(env._current_state.pos)\n\n  # Orient the agent to face the workshop and use it\n  direction_to_workshop = target_pos - current_pos\n\n  if direction_to_workshop[0] > 0:  # Workshop is to the right\n      actions.append(craft.RIGHT)\n  elif direction_to_workshop[0] < 0:  # Workshop is to the left\n      actions.append(craft.LEFT)\n  elif direction_to_workshop[1] > 0:  # Workshop is below\n      actions.append(craft.DOWN)\n  else:  # Workshop is above\n      actions.append(craft.UP)\n\n  actions.append(craft.USE)  # Use the workshop\n\n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T15:20:37.416759", "function_name": "craft", "function_body": "  def navigate_to(target_pos):\n    current_pos = np.array(env._current_state.pos)\n    actions = []\n\n    while not np.array_equal(current_pos, target_pos):\n      delta = target_pos - current_pos\n\n      # Calculate direction based on the largest absolute difference\n      if abs(delta[0]) > abs(delta[1]):\n        if delta[0] > 0:\n          actions.append(craft.RIGHT)  # Move right\n        else:\n          actions.append(craft.LEFT)   # Move left\n      else:\n        if delta[1] > 0:\n          actions.append(craft.DOWN)   # Move down\n        else:\n          actions.append(craft.UP)     # Move up\n\n      current_pos = np.array(env._current_state.pos)\n\n    return actions\n\n  goal_index = env.world.cookbook.index[item]\n\n  # Check if we have all required primitives in our inventory\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  current_inventory = collections.Counter(env._current_state.inventory)\n\n  for primitive, count in required_primitives.items():\n    if current_inventory[primitive] < count:\n      return []  # Missing required primitives\n\n  # Determine the workshop where crafting should occur\n  recipe_details = env.world.cookbook.recipes[goal_index]\n  workshop_name = recipe_details[\"_key\"]\n\n  # Get the index of the workshop from the world's cookbook\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the closest workshop in the grid\n  positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(positions) == 0:\n    return []  # No available workshops\n\n  closest_workshop_pos = min(\n      positions, key=lambda x: abs(x[0] - env._current_state.pos[0]) + abs(x[1] - env._current_state.pos[1]))\n\n  # Navigate to the closest workshop\n  actions_to_workshop = navigate_to(closest_workshop_pos)\n\n  # Orient the agent to face the workshop and use it\n  direction_to_workshop = np.array(closest_workshop_pos) - np.array(env._current_state.pos)\n  if direction_to_workshop[0] > 0:  # Workshop is to the right\n    actions_to_workshop.append(craft.RIGHT)\n  elif direction_to_workshop[0] < 0:  # Workshop is to the left\n    actions_to_workshop.append(craft.LEFT)\n  elif direction_to_workshop[1] > 0:  # Workshop is below\n    actions_to_workshop.append(craft.DOWN)\n  else:  # Workshop is above\n    actions_to_workshop.append(craft.UP)\n\n  actions_to_workshop.append(craft.USE)  # Use the workshop\n\n  return actions_to_workshop", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T15:22:45.417686", "function_name": "craft", "function_body": "  actions = []\n\n  # Fetch the index for the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Get primitives required to make the item\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n\n  # Check if we already have all the primitives in our inventory\n  all_primitives_collected = True\n  for primitive, count in primitives_required.items():\n    if env._current_state.inventory[primitive] < count:\n      all_primitives_collected = False\n      break\n\n  # If not all primitives are collected, return an empty action list\n  if not all_primitives_collected:\n    return []\n\n  # Find the workshop that can craft this item\n  target_workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n    if \"_key\" in recipe and item_index in recipe.values():\n      target_workshop_index = recipe[\"_key\"]\n      break\n\n  # If no valid workshop is found, return an empty action list\n  if target_workshop_index is None:\n    return []\n\n  # Find the position of the target workshop on the grid\n  target_workshop_pos = None\n  for x in range(env._current_state.grid.shape[0]):\n      for y in range(env._current_state.grid.shape[1]):\n          if env._current_state.grid[x, y, target_workshop_index] == 1:\n              target_workshop_pos = (x, y)\n              break\n      if target_workshop_pos is not None:\n          break\n\n  # If no valid workshop position found, return an empty action list\n  if target_workshop_pos is None:\n    return []\n\n  # Calculate the path to the target workshop\n  start = env._current_state.pos\n  goal = target_workshop_pos\n  path = a_star_search(env._current_state.grid, start, goal)\n\n  if not path:\n      return []\n\n  # Convert path to actions\n  for i in range(1, len(path)):\n      dx = path[i][0] - path[i-1][0]\n      dy = path[i][1] - path[i-1][1]\n\n      if dx == 1:\n          actions.append(env.world.cookbook.index[\"RIGHT\"])\n      elif dx == -1:\n          actions.append(env.world.cookbook.index[\"LEFT\"])\n      elif dy == 1:\n          actions.append(env.world.cookbook.index[\"DOWN\"])\n      elif dy == -1:\n          actions.append(env.world.cookbook.index[\"UP\"])\n\n  # Calculate the direction to face the target workshop\n  dx = target_workshop_pos[0] - env._current_state.pos[0]\n  dy = target_workshop_pos[1] - env._current_state.pos[1]\n\n  if abs(dx) > abs(dy):\n      direction_to_face = \"RIGHT\" if dx > 0 else \"LEFT\"\n  else:\n      direction_to_face = \"DOWN\" if dy > 0 else \"UP\"\n\n  # Move towards the target workshop and face it\n  actions.append(env.world.cookbook.index[direction_to_face])\n\n  # Add USE action to craft the item\n  actions.append(env.world.cookbook.index[\"USE\"])\n\n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T15:22:46.518515", "function_name": "craft", "function_body": "  actions = []\n  \n  # Fetch the index for the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Get primitives required to make the item\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n\n  # Check if we already have all the primitives in our inventory\n  all_primitives_collected = True\n  for primitive, count in primitives_required.items():\n    if env._current_state.inventory[primitive] < count:\n      all_primitives_collected = False\n      break\n\n  # If not all primitives are collected, return an empty action list\n  if not all_primitives_collected:\n    return []\n\n  # Find the workshop that can craft this item\n  target_workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n      target_workshop_index = recipe[\"key\"]\n      break\n\n  # If no valid workshop is found, return an empty action list\n  if target_workshop_index is None:\n    return []\n\n  # Find the position of the target workshop on the grid\n  target_workshop_pos = None\n  for x in range(env._current_state.grid.shape[0]):\n      for y in range(env._current_state.grid.shape[1]):\n          if env._current_state.grid[x, y, target_workshop_index] == 1:\n              target_workshop_pos = (x, y)\n              break\n      if target_workshop_pos is not None:\n          break\n\n  # If no valid workshop position found, return an empty action list\n  if target_workshop_pos is None:\n    return []\n\n  # Calculate the path to the target workshop\n  start = env._current_state.pos\n  goal = target_workshop_pos\n  path = a_star_search(env._current_state.grid, start, goal)\n\n  if not path:\n      return []\n\n  # Convert path to actions\n  for i in range(1, len(path)):\n      dx = path[i][0] - path[i-1][0]\n      dy = path[i][1] - path[i-1][1]\n\n      if dx == 1:\n          actions.append(env.world.cookbook.index[\"RIGHT\"])\n      elif dx == -1:\n          actions.append(env.world.cookbook.index[\"LEFT\"])\n      elif dy == 1:\n          actions.append(env.world.cookbook.index[\"DOWN\"])\n      elif dy == -1:\n          actions.append(env.world.cookbook.index[\"UP\"])\n\n  # Calculate the direction to face the target workshop\n  dx = target_workshop_pos[0] - env._current_state.pos[0]\n  dy = target_workshop_pos[1] - env._current_state.pos[1]\n\n  if abs(dx) > abs(dy):\n      direction_to_face = \"RIGHT\" if dx > 0 else \"LEFT\"\n  else:\n      direction_to_face = \"DOWN\" if dy > 0 else \"UP\"\n\n  # Move towards the target workshop and face it\n  actions.append(env.world.cookbook.index[direction_to_face])\n\n  # Add USE action to craft the item\n  actions.append(env.world.cookbook.index[\"USE\"])\n\n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T15:25:58.750544", "function_name": "craft", "function_body": "  def get_direction(current_pos, target_pos):\n    x_diff = target_pos[0] - current_pos[0]\n    y_diff = target_pos[1] - current_pos[1]\n\n    if x_diff == 0 and y_diff == 0:\n      return None\n    elif abs(x_diff) > abs(y_diff):\n      return (2, 3) if x_diff < 0 else (3, 2)\n    else:\n      return (0, 1) if y_diff < 0 else (1, 0)\n\n  def move_to_pos(current_pos, target_pos):\n    actions = []\n    current_x, current_y = current_pos\n    target_x, target_y = target_pos\n\n    while current_x != target_x or current_y != target_y:\n      direction_primary, _ = get_direction((current_x, current_y), (target_x, target_y))\n      if direction_primary is not None:\n        actions.append(direction_primary)\n        if direction_primary == 0:  # UP\n          current_y -= 1\n        elif direction_primary == 1:  # DOWN\n          current_y += 1\n        elif direction_primary == 2:  # LEFT\n          current_x -= 1\n        elif direction_primary == 3:  # RIGHT\n          current_x += 1\n\n    return actions\n\n  def find_path(start, target):\n    actions = []\n    \n    start_x, start_y = divmod(start, env._current_state.grid.shape[1])\n    target_x, target_y = divmod(target, env._current_state.grid.shape[1])\n\n    open_set = []\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, target)}\n\n    heapq.heappush(open_set, (f_score[start], start))\n\n    while open_set:\n      _, current = heapq.heappop(open_set)\n\n      if current == target:\n        reconstruct_path(came_from, current)\n        break\n\n      cx, cy = divmod(current, env._current_state.grid.shape[1])\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = cx + dx, cy + dy\n\n        if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n          neighbor = nx * env._current_state.grid.shape[1] + ny\n          tentative_g_score = g_score[current] + 1\n\n          if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n            came_from[neighbor] = current\n            g_score[neighbor] = tentative_g_score\n            f_score[neighbor] = tentative_g_score + heuristic(neighbor, target)\n            heapq.heappush(open_set, (f_score[neighbor], neighbor))\n\n    def reconstruct_path(came_from, current):\n      total_path = []\n      while current in came_from:\n        cx, cy = divmod(current, env._current_state.grid.shape[1])\n        px, py = divmod(came_from[current], env._current_state.grid.shape[1])\n\n        dx, dy = px - cx, py - cy\n        action_primary, _ = get_direction((cx, cy), (px, py))\n        total_path.append(action_primary)\n        current = came_from[current]\n\n      actions.extend(reversed(total_path))\n\n    return actions\n\n  def heuristic(a, b):\n    ax, ay = divmod(a, env._current_state.grid.shape[1])\n    bx, by = divmod(b, env._current_state.grid.shape[1])\n\n    # Manhattan distance\n    return abs(ax - bx) + abs(ay - by)\n\n  actions = []\n\n  item_index = env.world.cookbook.index[item]\n  \n  if not item_index:\n    return []\n\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  current_inventory = {env.world.cookbook.index.get(i): c for i, c in enumerate(env._current_state.inventory) if c > 0}\n\n  # Check if we have all the required primitives\n  for primitive_index, count in primitives_needed.items():\n    if current_inventory.get(primitive_index, 0) < count:\n      return []\n\n  workshop_name = env.world.cookbook.recipes[item_index][\"_at\"]\n  workshop_indices = [i for i, idx in enumerate(env._current_state.grid[:, :, env.world.workshop_indices[0]]) if idx == env.world.cookbook.index[workshop_name]]\n\n  if not workshop_indices:\n    return []\n\n  flat_grid = env._current_state.grid.reshape(-1, env.world.n_kinds)\n\n  start_pos_flat = env._current_state.pos[0] * env._current_state.grid.shape[1] + env._current_state.pos[1]\n  target_pos_flat = workshop_indices[0]\n\n  actions.extend(find_path(start_pos_flat, target_pos_flat))\n\n  target_workshop_position = divmod(workshop_indices[0], env._current_state.grid.shape[1])\n\n  direction_to_face = get_direction(env._current_state.pos, target_workshop_position)\n  \n  # Ensure we are in front of the workshop\n  if direction_to_face:\n    actions.append(direction_to_face[0])  # Move to face the workshop\n\n  actions.append(4)  # USE action to craft the item\n\n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T15:25:59.745740", "function_name": "craft", "function_body": "  def get_direction(current_pos, target_pos):\n    x_diff = target_pos[0] - current_pos[0]\n    y_diff = target_pos[1] - current_pos[1]\n\n    if abs(x_diff) > abs(y_diff):\n      return 3 if x_diff > 0 else 2\n    elif abs(y_diff) > abs(x_diff):\n      return 1 if y_diff > 0 else 0\n    else:\n      # Handle the case when both differences are equal, prioritize moving horizontally first.\n      return 3 if x_diff > 0 else 2\n\n  def move_to_pos(current_pos, target_pos):\n    actions = []\n    current_x, current_y = current_pos\n    target_x, target_y = target_pos\n\n    while (current_x != target_x) or (current_y != target_y):\n      direction = get_direction((current_x, current_y), (target_x, target_y))\n      if direction == 0:  # UP\n        actions.append(0)\n        current_y -= 1\n      elif direction == 1:  # DOWN\n        actions.append(1)\n        current_y += 1\n      elif direction == 2:  # LEFT\n        actions.append(2)\n        current_x -= 1\n      elif direction == 3:  # RIGHT\n        actions.append(3)\n        current_x += 1\n\n    return actions\n\n  def find_path(start, target):\n    actions = []\n    \n    start_pos = (start // env._current_state.grid.shape[1], start % env._current_state.grid.shape[1])\n    target_pos = (target // env._current_state.grid.shape[1], target % env._current_state.grid.shape[1])\n\n    open_set = collections.deque([start_pos])\n    came_from = {}\n\n    while open_set:\n      current = open_set.popleft()\n\n      if current == target_pos:\n        reconstruct_path(came_from, current)\n        break\n\n      current_x, current_y = current\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor_x, neighbor_y = current_x + dx, current_y + dy\n        if (0 <= neighbor_x < env._current_state.grid.shape[0] and \n            0 <= neighbor_y < env._current_state.grid.shape[1]):\n          neighbor = (neighbor_x, neighbor_y)\n          if neighbor not in came_from:\n              came_from[neighbor] = current\n              open_set.append(neighbor)\n\n    def reconstruct_path(came_from, current):\n        total_path = []\n        while current != start_pos:\n            cx, cy = current\n            px, py = came_from[current]\n            direction_to_face = get_direction((cx, cy), (px, py))\n            total_path.append(direction_to_face)\n            current = came_from[current]\n        actions.extend(reversed(total_path))\n\n    return actions\n\n  def heuristic(a, b):\n    ax, ay = a\n    bx, by = b\n\n    # Manhattan distance\n    return abs(ax - bx) + abs(ay - by)\n\n  actions = []\n\n  item_index = env.world.cookbook.index.get(item)\n  \n  if not item_index:\n    return []\n\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  current_inventory = {env.world.cookbook.index.get(i): c for i, c in enumerate(env._current_state.inventory) if c > 0}\n\n  # Check if we have all the required primitives\n  for primitive_index, count in primitives_needed.items():\n    if current_inventory.get(primitive_index, 0) < count:\n      return []\n\n  workshop_name = env.world.cookbook.recipes[item_index][\"_at\"]\n  workshop_indices = np.argwhere(env._current_state.grid[:, :, env.world.workshop_indices[0]] == env.world.cookbook.index[workshop_name])\n\n  if not workshop_indices.any():\n    return []\n\n  start_pos_flat = env._current_state.pos[0] * env._current_state.grid.shape[1] + env._current_state.pos[1]\n  target_workshop_position = (workshop_indices[0][0], workshop_indices[0][1])\n  target_pos_flat = target_workshop_position[0] * env._current_state.grid.shape[1] + target_workshop_position[1]\n\n  actions.extend(find_path(start_pos_flat, target_pos_flat))\n\n  direction_to_face = get_direction(env._current_state.pos, target_workshop_position)\n  if direction_to_face is not None:\n    actions.append(direction_to_face)\n\n  actions.append(4)  # USE action\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-11T15:28:20.124279", "function_name": "craft", "function_body": "  def find_closest_position_with_space_for_workshop(workshop_index):\n    grid = env._current_state.grid\n    agent_pos = env._current_state.pos\n    closest_distance = float('inf')\n    closest_position = None\n\n    for x in range(grid.shape[0]):\n        for y in range(grid.shape[1]):\n            if (grid[x, y, workshop_index] > 0 and\n                grid[x + 1, y, 0] == 0 and grid[x - 1, y, 0] == 0 and  # Check adjacent cells are empty\n                grid[x, y + 1, 0] == 0 and grid[x, y - 1, 0] == 0):\n                distance = abs(x - agent_pos[0]) + abs(y - agent_pos[1])\n                if distance < closest_distance:\n                    closest_distance = distance\n                    closest_position = (x, y)\n\n    return closest_position\n\n  def move_towards_position(agent_pos, target_pos):\n      dx, dy = target_pos[0] - agent_pos[0], target_pos[1] - agent_pos[1]\n      actions = []\n      if dx > 0:\n          for _ in range(dx):\n              actions.append(3)  # RIGHT\n      elif dx < 0:\n          for _ in range(-dx):\n              actions.append(2)  # LEFT\n      if dy > 0:\n          for _ in range(dy):\n              actions.append(1)  # UP\n      elif dy < 0:\n          for _ in range(-dy):\n              actions.append(0)  # DOWN\n      return actions\n\n  def collect_primitives(env, primitives):\n      actions = []\n      current_inventory = env._current_state.inventory.copy()\n\n      for primitive_index, count in primitives.items():\n          if current_inventory[primitive_index] < count:\n              required_count = count - current_inventory[primitive_index]\n              collected_count = 0\n\n              while collected_count < required_count:\n                  # Find the closest source of the primitive\n                  grid = env._current_state.grid\n                  agent_pos = env._current_state.pos\n                  closest_distance = float('inf')\n                  closest_source = None\n\n                  for x in range(grid.shape[0]):\n                      for y in range(grid.shape[1]):\n                          if grid[x, y, primitive_index] > 0:\n                              distance = abs(x - agent_pos[0]) + abs(y - agent_pos[1])\n                              if distance < closest_distance:\n                                  closest_distance = distance\n                                  closest_source = (x, y)\n\n                  if not closest_source:\n                      return []  # No source found for this primitive\n\n                  # Calculate the direction to move towards the closest source\n                  actions.extend(move_towards_position(agent_pos, closest_source))\n\n                  # Append USE action to collect the primitive\n                  actions.append(4)  # USE action\n\n                  # Update inventory and collected count\n                  current_inventory[primitive_index] += 1\n                  collected_count += 1\n\n      return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item has a recipe\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the required primitives and their counts for crafting the item\n  recipe = env.world.cookbook.recipes[item_index]\n  required_primitives = {ingredient: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n\n  # Collect missing primitives\n  actions_to_collect = collect_primitives(env, required_primitives)\n\n  if not actions_to_collect:\n    return []\n\n  # Determine the workshop where crafting should occur\n  workshop = recipe.get(\"_at\", None)\n  if not workshop:\n    return []\n\n  workshop_index = env.world.cookbook.index[workshop]\n\n  # Find the closest position next to the workshop\n  closest_workshop_pos = find_closest_position_with_space_for_workshop(workshop_index)\n\n  if not closest_workshop_pos:\n    return []\n\n  # Calculate the direction to move towards the closest workshop\n  agent_pos = env._current_state.pos\n  actions_to_move = move_towards_position(agent_pos, closest_workshop_pos)\n\n  # Append USE action to craft the item\n  actions_to_craft = [4]  # USE action\n\n  return actions_to_collect + actions_to_move + actions_to_craft", "island_id": 7, "scores": {"3": 0.6}}
{"timestamp": "2025-09-11T15:28:21.187534", "function_name": "craft", "function_body": "  def find_closest_position_with_space_for_workshop(workshop_index):\n    grid = env._current_state.grid\n    agent_pos = env._current_state.pos\n    closest_distance = float('inf')\n    closest_position = None\n\n    for x in range(grid.shape[0]):\n        for y in range(grid.shape[1]):\n            if (grid[x, y, workshop_index] > 0 and\n                grid[x + 1, y, 0] == 0 and grid[x - 1, y, 0] == 0 and  # Check adjacent cells are empty\n                grid[x, y + 1, 0] == 0 and grid[x, y - 1, 0] == 0):\n                distance = abs(x - agent_pos[0]) + abs(y - agent_pos[1])\n                if distance < closest_distance:\n                    closest_distance = distance\n                    closest_position = (x, y)\n\n    return closest_position\n\n  def move_towards_position(agent_pos, target_pos):\n      actions = []\n      dx, dy = target_pos[0] - agent_pos[0], target_pos[1] - agent_pos[1]\n      while dx or dy:\n          if dx > 0:\n              actions.append(3)  # RIGHT\n              dx -= 1\n          elif dx < 0:\n              actions.append(2)  # LEFT\n              dx += 1\n          if dy > 0:\n              actions.append(1)  # UP\n              dy -= 1\n          elif dy < 0:\n              actions.append(0)  # DOWN\n              dy += 1\n      return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item has a recipe\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the required primitives and their counts for crafting the item\n  recipe = env.world.cookbook.recipes[item_index]\n  required_primitives = {ingredient: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n\n  # Check if we have all the required primitives in our inventory\n  current_inventory = env._current_state.inventory\n\n  missing_primitives = []\n\n  for primitive, count in required_primitives.items():\n    if current_inventory[primitive] < count:\n      missing_primitives.append((primitive, count))\n\n  # If there are any missing primitives, return an empty action list\n  if missing_primitives:\n    return []\n\n  # Determine the workshop where crafting should occur\n  workshop = recipe.get(\"_at\", None)\n  if not workshop:\n    return []\n\n  workshop_index = env.world.cookbook.index[workshop]\n\n  # Find the closest position next to the workshop\n  closest_workshop_pos = find_closest_position_with_space_for_workshop(workshop_index)\n\n  if not closest_workshop_pos:\n    return []\n\n  # Calculate the direction to move towards the closest workshop\n  agent_pos = env._current_state.pos\n  actions_to_take = move_towards_position(agent_pos, closest_workshop_pos)\n\n  # Append USE action to craft the item\n  actions_to_take.append(4)  # USE action\n\n  return actions_to_take", "island_id": 7, "scores": {"3": 5.0}}
{"timestamp": "2025-09-11T15:30:59.377625", "function_name": "craft", "function_body": "  actions = []\n\n  # Fetch the index for the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Get primitives required to make the item\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n\n  # Check if we already have all the primitives in our inventory\n  all_primitives_collected = True\n  for primitive, count in primitives_required.items():\n    if env._current_state.inventory[primitive] < count:\n      all_primitives_collected = False\n      break\n\n  # If not all primitives are collected, return an empty action list\n  if not all_primitives_collected:\n    return []\n\n  # Find the workshop that can craft this item\n  target_workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n      target_workshop_index = recipe[\"key\"]\n      break\n\n  # If no valid workshop is found, return an empty action list\n  if target_workshop_index is None:\n    return []\n\n  # Find the position of the target workshop on the grid\n  target_workshop_pos = None\n  for x in range(env._current_state.grid.shape[0]):\n      for y in range(env._current_state.grid.shape[1]):\n          if env._current_state.grid[x, y, target_workshop_index] == 1:\n              target_workshop_pos = (x, y)\n              break\n      if target_workshop_pos is not None:\n          break\n\n  # If no valid workshop position found, return an empty action list\n  if target_workshop_pos is None:\n    return []\n\n  # Calculate the path to the target workshop using A* search\n  start = env._current_state.pos\n  goal = target_workshop_pos\n  path = a_star_search(env._current_state.grid, start, goal)\n\n  if not path:\n      return []\n\n  # Convert path to actions\n  for i in range(1, len(path)):\n      dx = path[i][0] - path[i-1][0]\n      dy = path[i][1] - path[i-1][1]\n\n      if dx == 1:\n          actions.append(env.world.cookbook.index[\"RIGHT\"])\n      elif dx == -1:\n          actions.append(env.world.cookbook.index[\"LEFT\"])\n      elif dy == 1:\n          actions.append(env.world.cookbook.index[\"DOWN\"])\n      elif dy == -1:\n          actions.append(env.world.cookbook.index[\"UP\"])\n\n  # Calculate the direction to face the target workshop\n  dx = target_workshop_pos[0] - env._current_state.pos[0]\n  dy = target_workshop_pos[1] - env._current_state.pos[1]\n\n  if abs(dx) > abs(dy):\n      direction_to_face = \"RIGHT\" if dx > 0 else \"LEFT\"\n  else:\n      direction_to_face = \"DOWN\" if dy > 0 else \"UP\"\n\n  actions.append(env.world.cookbook.index[direction_to_face])\n\n  # Add USE action to craft the item\n  actions.append(env.world.cookbook.index[\"USE\"])\n\n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T15:31:00.435943", "function_name": "craft", "function_body": "  def a_star_search(grid, start, goal):\n      neighbors = [(0,1),(0,-1),(1,0),(-1,0)]\n      \n      close_set = set()\n      came_from = {}\n      gscore = {start:0}\n      fscore = {start:heuristic(start, goal)}\n      oheap = []\n\n      heappush(oheap, (fscore[start], start))\n      \n      while oheap:\n          current = heappop(oheap)[1]\n\n          if current == goal:\n              data = []\n              while current in came_from:\n                  data.append(current)\n                  current = came_from[current]\n              return data[::-1]\n          \n          close_set.add(current)\n          for i, j in neighbors:\n              neighbor = current[0] + i, current[1] + j\n              tentative_g_score = gscore[current] + 1\n\n              if 0 <= neighbor[0] < grid.shape[0]:\n                  if 0 <= neighbor[1] < grid.shape[1]:                \n                      if grid[neighbor[0]][neighbor[1]] == 0:\n                          continue\n                  else:\n                      # array bound y walls\n                      continue\n              else:\n                  # array bound x walls\n                  continue\n                \n              if neighbor in close_set and tentative_g_score >= gscore.get(neighbor, 0):\n                  continue\n                \n              if  tentative_g_score < gscore.get(neighbor, 0) or neighbor not in [i[1]for i in oheap]:\n                  came_from[neighbor] = current\n                  gscore[neighbor] = tentative_g_score\n                  fscore[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                  heappush(oheap, (fscore[neighbor], neighbor))\n      return False\n\n  def heuristic(a, b):\n      return abs(b[0] - a[0]) + abs(b[1] - a[1])\n\n  actions = []\n\n  # Fetch the index for the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Get primitives required to make the item\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n\n  # Check if we already have all the primitives in our inventory\n  all_primitives_collected = True\n  for primitive, count in primitives_required.items():\n    if env._current_state.inventory[primitive] < count:\n      all_primitives_collected = False\n      break\n\n  # If not all primitives are collected, return an empty action list\n  if not all_primitives_collected:\n    return []\n\n  # Find the workshop that can craft this item\n  target_workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n      target_workshop_index = recipe[\"key\"]\n      break\n\n  # If no valid workshop is found, return an empty action list\n  if target_workshop_index is None:\n    return []\n\n  # Find the position of the target workshop on the grid\n  target_workshop_pos = None\n  for x in range(env._current_state.grid.shape[0]):\n      for y in range(env._current_state.grid.shape[1]):\n          if env._current_state.grid[x, y, target_workshop_index] == 1:\n              target_workshop_pos = (x, y)\n              break\n      if target_workshop_pos is not None:\n          break\n\n  # If no valid workshop position found, return an empty action list\n  if target_workshop_pos is None:\n    return []\n\n  # Calculate the path to the target workshop using A* search\n  start = env._current_state.pos\n  goal = target_workshop_pos\n  path = a_star_search(env._current_state.grid, start, goal)\n\n  if not path:\n      return []\n\n  # Convert path to actions\n  for i in range(1, len(path)):\n      dx = path[i][0] - path[i-1][0]\n      dy = path[i][1] - path[i-1][1]\n\n      if dx == 1:\n          actions.append(env.world.cookbook.index[\"RIGHT\"])\n      elif dx == -1:\n          actions.append(env.world.cookbook.index[\"LEFT\"])\n      elif dy == 1:\n          actions.append(env.world.cookbook.index[\"DOWN\"])\n      elif dy == -1:\n          actions.append(env.world.cookbook.index[\"UP\"])\n\n  # Calculate the direction to face the target workshop\n  dx = target_workshop_pos[0] - env._current_state.pos[0]\n  dy = target_workshop_pos[1] - env._current_state.pos[1]\n\n  if abs(dx) > abs(dy):\n      direction_to_face = \"RIGHT\" if dx > 0 else \"LEFT\"\n  else:\n      direction_to_face = \"DOWN\" if dy > 0 else \"UP\"\n\n  # Move towards the target workshop and face it\n  actions.append(env.world.cookbook.index[direction_to_face])\n\n  # Add USE action to craft the item\n  actions.append(env.world.cookbook.index[\"USE\"])\n\n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T15:32:41.972853", "function_name": "craft", "function_body": "  def find_closest_workshop(workshop_index):\n    grid = env._current_state.grid\n    agent_pos = env._current_state.pos\n    closest_distance = float('inf')\n    closest_workshop_pos = None\n\n    for x in range(grid.shape[0]):\n        for y in range(grid.shape[1]):\n            if grid[x, y, workshop_index] > 0:\n                distance = abs(x - agent_pos[0]) + abs(y - agent_pos[1])\n                if distance < closest_distance:\n                    closest_distance = distance\n                    closest_workshop_pos = (x, y)\n\n    return closest_workshop_pos\n\n  def move_towards_position(agent_pos, target_pos):\n      actions = []\n      dx = target_pos[0] - agent_pos[0]\n      dy = target_pos[1] - agent_pos[1]\n\n      if abs(dx) > abs(dy):\n          # Move horizontally first\n          if dx > 0:\n              for _ in range(dx):\n                  actions.append(3)  # RIGHT\n          else:\n              for _ in range(-dx):\n                  actions.append(2)  # LEFT\n\n          # Then move vertically\n          if dy > 0:\n              for _ in range(dy):\n                  actions.append(1)  # UP\n          else:\n              for _ in range(-dy):\n                  actions.append(0)  # DOWN\n      else:\n          # Move vertically first\n          if dy > 0:\n              for _ in range(dy):\n                  actions.append(1)  # UP\n          else:\n              for _ in range(-dy):\n                  actions.append(0)  # DOWN\n\n          # Then move horizontally\n          if dx > 0:\n              for _ in range(dx):\n                  actions.append(3)  # RIGHT\n          else:\n              for _ in range(-dx):\n                  actions.append(2)  # LEFT\n\n      return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item has a recipe\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the required primitives and their counts for crafting the item\n  recipe = env.world.cookbook.recipes[item_index]\n  required_primitives = {ingredient: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n\n  # Check if we have all the required primitives in our inventory\n  current_inventory = env._current_state.inventory\n\n  missing_primitives = []\n\n  for primitive, count in required_primitives.items():\n    if current_inventory[primitive] < count:\n      missing_primitives.append((primitive, count))\n\n  # If there are any missing primitives, return an empty action list\n  if missing_primitives:\n    return []\n\n  # Determine the workshop where crafting should occur\n  workshop = recipe.get(\"_at\", None)\n  if not workshop:\n    return []\n\n  workshop_index = env.world.cookbook.index[workshop]\n\n  # Find the closest position next to the workshop\n  closest_workshop_pos = find_closest_workshop(workshop_index)\n\n  if not closest_workshop_pos:\n    return []\n\n  # Calculate the direction to move towards the closest workshop\n  agent_pos = env._current_state.pos\n  actions_to_take = move_towards_position(agent_pos, closest_workshop_pos)\n\n  # Append USE action to craft the item\n  actions_to_take.append(4)  # USE action\n\n  return actions_to_take", "island_id": 7, "scores": {"3": 5.0}}
{"timestamp": "2025-09-11T15:32:42.965793", "function_name": "craft", "function_body": "  def find_closest_workshop(workshop_index):\n    grid = env._current_state.grid\n    agent_pos = env._current_state.pos\n    closest_distance = float('inf')\n    closest_workshop_pos = None\n\n    for x in range(grid.shape[0]):\n        for y in range(grid.shape[1]):\n            if grid[x, y, workshop_index] > 0:\n                distance = abs(x - agent_pos[0]) + abs(y - agent_pos[1])\n                if distance < closest_distance:\n                    closest_distance = distance\n                    closest_workshop_pos = (x, y)\n\n    return closest_workshop_pos\n\n  def move_towards_position(agent_pos, target_pos):\n      dx, dy = target_pos[0] - agent_pos[0], target_pos[1] - agent_pos[1]\n      actions = []\n      if dx > 0:\n          for _ in range(dx):\n              actions.append(3)  # RIGHT\n      elif dx < 0:\n          for _ in range(-dx):\n              actions.append(2)  # LEFT\n      if dy > 0:\n          for _ in range(dy):\n              actions.append(1)  # UP\n      elif dy < 0:\n          for _ in range(-dy):\n              actions.append(0)  # DOWN\n      return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item has a recipe\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the required primitives and their counts for crafting the item\n  recipe = env.world.cookbook.recipes[item_index]\n  required_primitives = {ingredient: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n\n  # Check if we have all the required primitives in our inventory\n  current_inventory = env._current_state.inventory\n\n  missing_primitives = []\n\n  for primitive, count in required_primitives.items():\n    if current_inventory[primitive] < count:\n      missing_primitives.append((primitive, count))\n\n  # If there are any missing primitives, try to collect them first\n  if missing_primitives:\n    actions_to_take = []\n    for primitive, count in missing_primitives:\n        item_name = env.world.cookbook.index.get(primitive, None)\n        if not item_name:\n            return []  # If the index does not match any known item, return an empty action list\n        collect_actions = collect(env, item_name)  # Assuming `collect` function exists to collect primitives\n        actions_to_take.extend(collect_actions)\n    return actions_to_take\n\n  # Determine the workshop where crafting should occur\n  workshop = recipe.get(\"_at\", None)\n  if not workshop:\n    return []\n\n  workshop_index = env.world.cookbook.index[workshop]\n\n  # Find the closest position next to the workshop\n  closest_workshop_pos = find_closest_workshop(workshop_index)\n\n  if not closest_workshop_pos:\n    return []\n\n  # Calculate the direction to move towards the closest workshop\n  agent_pos = env._current_state.pos\n  actions_to_take = move_towards_position(agent_pos, closest_workshop_pos)\n\n  # Append USE action to craft the item\n  actions_to_take.append(4)  # USE action\n\n  return actions_to_take", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-11T15:33:49.271868", "function_name": "craft", "function_body": "  # Fetch the required primitives from the cookbook for the given item\n  goal_index = env.world.cookbook.index[item]\n  if goal_index is None:\n      raise ValueError(f\"Unknown item: {item}\")\n  \n  # Get the prerequisites and the workshop requirement\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  # Dictionary to keep track of primitives needed to craft the item\n  required_primitives = {}\n  for ingredient, count in recipe.items():\n      if ingredient == \"_at\":\n          workshop = recipe[\"_at\"]\n          continue\n      elif ingredient != \"_key\":\n          required_primitives[ingredient] = count\n\n  actions = []\n  \n  # Check inventory and collect missing primitives\n  current_inventory = env._current_state.inventory.copy()\n  for primitive, count in required_primitives.items():\n    primitive_index = env.world.cookbook.index.get(primitive)\n    if primitive_index is None:\n      raise ValueError(f\"Unknown primitive: {primitive}\")\n    if current_inventory[primitive_index] < count:\n      # We need to collect more of this primitive\n      actions.extend(collect(env, primitive))\n      current_inventory = env._current_state.inventory.copy()\n  \n  # Move to the workshop and use it to craft the item\n  workshop_index = env.world.cookbook.index.get(workshop)\n  if workshop_index is None:\n      raise ValueError(f\"Unknown workshop: {workshop}\")\n  \n  # Find the position of the workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found on the map\")\n  \n  # Assuming we just go to the first occurrence of the workshop (there can be multiple)\n  target_pos = tuple(workshop_positions[0])\n  actions.extend(move_to(env, target_pos))\n\n  # Rotate to face the workshop\n  actions.append(face_target(env._current_state.pos, env._current_state.dir, target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(craft.world.N_ACTIONS - 1)  # Assuming USE action is the last action\n\n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-11T15:33:50.260538", "function_name": "craft", "function_body": "  def get_workshop_index(workshop_name):\n    for idx, name in enumerate(env.world.cookbook.index.get(idx) for idx in range(1, len(env.world.cookbook.index))):\n      if name == workshop_name:\n        return idx\n    return None\n\n  def can_craft(item_idx):\n    # Check if we have all the required ingredients in inventory.\n    recipe = env.world.cookbook.recipes[item_idx]\n    for ingredient, count in recipe.items():\n        if ingredient != \"_key\" and env._current_state.inventory[ingredient] < count:\n            return False\n    return True\n\n  def navigate_to_workshop(workshop_idx):\n      # Navigate to the workshop.\n      target_pos = None\n      grid = env._current_state.grid\n      for y in range(grid.shape[0]):\n          for x in range(grid.shape[1]):\n              if grid[y, x, workshop_idx] == 1:\n                  target_pos = (x, y)\n                  break\n          if target_pos:\n              break\n\n      actions = []\n      current_pos = env._current_state.pos\n      direction = env._current_state.dir\n\n      while current_pos != target_pos:\n          dx, dy = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n          if dx < 0 and (direction == 2 or direction == 3):\n              actions.append(env.world.cookbook.index[\"LEFT\"])\n          elif dx > 0 and (direction == 2 or direction == 3):\n              actions.append(env.world.cookbook.index[\"RIGHT\"])\n          elif dy < 0:\n              if direction != 1:\n                  actions.extend([env.world.cookbook.index[\"UP\"], env.world.cookbook.index[\"USE\"]])\n              else:\n                  actions.append(env.world.cookbook.index[\"USE\"])\n          elif dy > 0:\n              if direction != 0:\n                  actions.extend([env.world.cookbook.index[\"DOWN\"], env.world.cookbook.index[\"USE\"]])\n              else:\n                  actions.append(env.world.cookbook.index[\"USE\"])\n          \n      return actions\n\n  item_idx = env.world.cookbook.index[item]\n  if not can_craft(item_idx):\n      return []\n\n  workshop_name = env.world.cookbook.recipes[item_idx][\"_key\"]\n  workshop_idx = get_workshop_index(workshop_name)\n  \n  if workshop_idx is None:\n      return []\n  \n  actions = navigate_to_workshop(workshop_idx)\n\n  # Once at the workshop, perform USE action to craft item.\n  actions.append(env.world.cookbook.index[\"USE\"])\n\n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-11T15:35:40.658219", "function_name": "craft", "function_body": "  i_goal = env.world.cookbook.index[item]\n  prim_reqs = env.world.cookbook.primitives_for(i_goal)\n  actions_list = []\n\n  # Check if we have all the required primitives in our inventory\n  for i_prim, count in prim_reqs.items():\n      if env._current_state.inventory[i_prim] < count:\n          return []  # If any primitive is missing, return an empty action list\n\n  # Find which workshop to use for crafting\n  workshop_index = None\n  workshop_name = \"_key\"\n  \n  for output_index, recipe in env.world.cookbook.recipes.items():\n      if i_goal == output_index:\n          workshop_name = recipe[\"_at\"]\n          break\n  \n  try:\n      workshop_index = getattr(env.world, f\"{workshop_name}_index\")\n  except AttributeError:\n      return []  # If the workshop is not found, return an empty action list\n\n  # Now that we have all the requirements and know where to craft, let's move to the workshop\n  workshop_pos = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  \n  if len(workshop_pos) == 0:\n      return []  # If no workshop is found, return an empty action list\n\n  # We assume we can go to any of these workshops and use the first one\n  workshop_pos = workshop_pos[0]\n  \n  # Calculate the direction towards the workshop\n  agent_pos = env._current_state.pos\n\n  # Define action mappings\n  actions = {\n      (1, 0): craft.MOVE_FUNC(craft.DOWN),   # Move down\n      (-1, 0): craft.MOVE_FUNC(craft.UP),     # Move up\n      (0, 1): craft.MOVE_FUNC(craft.RIGHT),  # Move right\n      (0, -1): craft.MOVE_FUNC(craft.LEFT)    # Move left\n  }\n\n  # BFS to find the shortest path\n  def bfs(start, goal):\n      queue = collections.deque([start])\n      visited = set()\n      came_from = {}\n      \n      while queue:\n          current = queue.popleft()\n          \n          if np.array_equal(current, goal):\n              break\n          \n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              \n              if 0 <= neighbor[0] < env._current_state.grid.shape[0] and\\\n                 0 <= neighbor[1] < env._current_state.grid.shape[1] and\\\n                 not env._current_state.grid[neighbor[0], neighbor[1]].any() and\\\n                 neighbor not in visited:\n                  queue.append(neighbor)\n                  visited.add(neighbor)\n                  came_from[neighbor] = current\n      \n      # Reconstruct path\n      path = []\n      while np.array_equal(current, goal):\n          path.append(current)\n          current = came_from[current]\n      \n      return path[::-1]\n\n  path = bfs(agent_pos, workshop_pos)\n\n  if not path:\n      return []  # If no path is found, return an empty action list\n\n  for next_pos in path[1:]:  # Skip the starting position\n      delta_x = next_pos[0] - agent_pos[0]\n      delta_y = next_pos[1] - agent_pos[1]\n      \n      action = actions.get((np.sign(delta_x), np.sign(delta_y)))\n      \n      if action:\n          actions_list.append(action)\n      \n      # Simulate the step to update the agent's position\n      env.step(action)\n      agent_pos = next_pos\n\n  # Once we reach the workshop, use it to craft the item\n  actions_list.append(craft.USE_FUNC())\n  \n  return actions_list", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T15:35:41.708623", "function_name": "craft", "function_body": "  i_goal = env.world.cookbook.index[item]\n  prim_reqs = env.world.cookbook.primitives_for(i_goal)\n  actions_list = []\n\n  # Check if we have all the required primitives in our inventory\n  for i_prim, count in prim_reqs.items():\n      if env._current_state.inventory[i_prim] < count:\n          return []  # If any primitive is missing, return an empty action list\n\n  # Find which workshop to use for crafting\n  workshop_index = None\n  workshop_name = \"_key\"\n  \n  for output_index, recipe in env.world.cookbook.recipes.items():\n      if i_goal == output_index:\n          workshop_name = recipe[\"_at\"]\n          break\n  \n  try:\n      workshop_index = getattr(env.world, f\"{workshop_name}_index\")\n  except AttributeError:\n      return []  # If the workshop is not found, return an empty action list\n\n  # Now that we have all the requirements and know where to craft, let's move to the workshop\n  workshop_pos = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)[0]\n  \n  # Calculate the direction towards the workshop\n  agent_pos = env._current_state.pos\n\n  # Define action mappings\n  actions = {\n      (1, 0): craft.MOVE_FUNC(craft.DOWN),   # Move down\n      (-1, 0): craft.MOVE_FUNC(craft.UP),     # Move up\n      (0, 1): craft.MOVE_FUNC(craft.RIGHT),  # Move right\n      (0, -1): craft.MOVE_FUNC(craft.LEFT)    # Move left\n  }\n\n  # BFS to find the shortest path\n  def bfs(start, goal):\n      queue = collections.deque([start])\n      visited = set()\n      came_from = {}\n      \n      while queue:\n          current = queue.popleft()\n          \n          if np.array_equal(current, goal):\n              break\n          \n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              \n              if 0 <= neighbor[0] < env._current_state.grid.shape[0] and\\\n                 0 <= neighbor[1] < env._current_state.grid.shape[1] and\\\n                 not env._current_state.grid[neighbor[0], neighbor[1]].any() and\\\n                 neighbor not in visited:\n                  queue.append(neighbor)\n                  visited.add(neighbor)\n                  came_from[neighbor] = current\n      \n      # Reconstruct path\n      path = []\n      while np.array_equal(current, goal):\n          path.append(current)\n          current = came_from[current]\n      \n      return path[::-1]\n\n  path = bfs(agent_pos, workshop_pos)\n\n  if not path:\n      return []  # If no path is found, return an empty action list\n\n  for next_pos in path[1:]:  # Skip the starting position\n      delta_x = next_pos[0] - agent_pos[0]\n      delta_y = next_pos[1] - agent_pos[1]\n      \n      action = actions.get((np.sign(delta_x), np.sign(delta_y)))\n      \n      if action:\n          actions_list.append(action)\n      \n      # Simulate the step to update the agent's position\n      env.step(action)\n      agent_pos = next_pos\n\n  # Once we reach the workshop, use it to craft the item\n  actions_list.append(craft.USE_FUNC())\n  \n  return actions_list", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T15:38:42.515232", "function_name": "craft", "function_body": "  def get_workshop_position(grid, workshop_index):\n      positions = np.argwhere(grid == workshop_index)\n      if positions.size > 0:\n          return tuple(positions[0])\n      return None\n\n  def generate_path(start_pos, target_pos, grid, obstacle_indices):\n      queue = collections.deque([start_pos])\n      visited = set()\n      parent = {start_pos: None}\n\n      while queue:\n          current_pos = queue.popleft()\n          if current_pos == target_pos:\n              break\n          \n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor_pos = (current_pos[0] + dx, current_pos[1] + dy)\n              if (neighbor_pos not in visited and \n                  grid[neighbor_pos] not in obstacle_indices):\n                  visited.add(neighbor_pos)\n                  parent[neighbor_pos] = current_pos\n                  queue.append(neighbor_pos)\n\n      path = []\n      while target_pos:\n          path.append(target_pos)\n          target_pos = parent[target_pos]\n      return path[::-1]\n\n  item_index = env.world.cookbook.index[item]\n\n  # If the item has no recipe or is not a crafted item, return an empty action list\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the recipe for the desired item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Check if all required ingredients are available in the inventory\n  required_ingredients = {env.world.cookbook.index[ingredient]: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n  available_ingredients = {k: v for k, v in enumerate(env._current_state.inventory) if v > 0}\n\n  # If all ingredients are not available, return an empty action list\n  if any(required_ingredient not in available_ingredients or available_ingredients[required_ingredient] < count \n         for required_ingredient, count in required_ingredients.items()):\n    return []\n\n  # Find the workshop index where the item should be crafted\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Get the position of the workshop\n  workshop_position = get_workshop_position(env.world.grid, workshop_index)\n  if not workshop_position:\n    return []\n\n  # Generate a path to the workshop\n  current_position = env._current_state.pos\n  obstacle_indices = set([env.world.cookbook.index[obstacle] for obstacle in ['BOUNDARY']])\n  path_to_workshop = generate_path(current_position, workshop_position, env.world.grid, obstacle_indices)\n\n  actions = []\n  # Convert the path to a list of actions (MOVE_FUNC)\n  for i in range(1, len(path_to_workshop)):\n      dx = path_to_workshop[i][0] - path_to_workshop[i-1][0]\n      dy = path_to_workshop[i][1] - path_to_workshop[i-1][1]\n      if dx == -1:\n          actions.append(2)  # LEFT\n      elif dx == 1:\n          actions.append(3)  # RIGHT\n      elif dy == -1:\n          actions.append(0)  # UP\n      elif dy == 1:\n          actions.append(1)  # DOWN\n\n  # Determine if we are next to the correct workshop and facing it\n  target_direction = (workshop_position[0] - current_position[0], workshop_position[1] - current_position[1])\n  current_dir = env._current_state.dir\n  target_dir_idx = ((-1, 0), (1, 0), (0, -1), (0, 1)).index(target_direction)\n  \n  if current_dir != target_dir_idx:\n      actions.append((target_dir_idx + 2) % 4)  # Turn to face the workshop\n\n  # Append USE action\n  actions.append(4)\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T15:38:43.557060", "function_name": "craft", "function_body": "  def get_workshop_position(grid, workshop_index):\n    # Assuming grid is a numpy array for efficient searching\n    positions = np.argwhere(grid == workshop_index)\n    if positions.size > 0:\n        return tuple(positions[0])\n    return None\n\n  def generate_path(start_pos, target_pos, grid, obstacle_indices):\n      queue = collections.deque([start_pos])\n      visited = set()\n      parent = {start_pos: None}\n\n      while queue:\n          current_pos = queue.popleft()\n          if current_pos == target_pos:\n              break\n          \n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor_pos = (current_pos[0] + dx, current_pos[1] + dy)\n              if (neighbor_pos not in visited and \n                  grid[neighbor_pos] not in obstacle_indices):\n                  visited.add(neighbor_pos)\n                  parent[neighbor_pos] = current_pos\n                  queue.append(neighbor_pos)\n\n      path = []\n      while target_pos:\n          path.append(target_pos)\n          target_pos = parent[target_pos]\n      return path[::-1]\n\n  def is_next_to_workshop(current_state, workshop_position):\n    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor_pos = (current_state.pos[0] + dx, current_state.pos[1] + dy)\n        if neighbor_pos == workshop_position:\n            return True\n    return False\n\n  item_index = env.world.cookbook.index[item]\n\n  # If the item has no recipe or is not a crafted item, return an empty action list\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the recipe for the desired item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Check if all required ingredients are available in the inventory\n  required_ingredients = {env.world.cookbook.index[ingredient]: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n  available_ingredients = {k: v for k, v in enumerate(env._current_state.inventory) if v > 0}\n\n  # If all ingredients are not available, return an empty action list\n  if any(required_ingredient not in available_ingredients or available_ingredients[required_ingredient] < count \n         for required_ingredient, count in required_ingredients.items()):\n    return []\n\n  # Find the workshop index where the item should be crafted\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Get the position of the workshop\n  workshop_position = get_workshop_position(env.world.grid, workshop_index)\n  if not workshop_position:\n    return []\n\n  # Generate a path to the workshop\n  current_position = env._current_state.pos\n  obstacle_indices = set([env.world.cookbook.index[obstacle] for obstacle in ['BOUNDARY']])\n  path_to_workshop = generate_path(current_position, workshop_position, env.world.grid, obstacle_indices)\n\n  actions = []\n  # Convert the path to a list of actions (MOVE_FUNC)\n  for i in range(1, len(path_to_workshop)):\n      dx = path_to_workshop[i][0] - path_to_workshop[i-1][0]\n      dy = path_to_workshop[i][1] - path_to_workshop[i-1][1]\n      if dx == -1:\n          actions.append(2)  # LEFT\n      elif dx == 1:\n          actions.append(3)  # RIGHT\n      elif dy == -1:\n          actions.append(0)  # UP\n      elif dy == 1:\n          actions.append(1)  # DOWN\n\n  # Check if we are already next to the workshop\n  if is_next_to_workshop(env._current_state, workshop_position):\n    target_direction = (workshop_position[0] - current_position[0], workshop_position[1] - current_position[1])\n    current_dir = env._current_state.dir\n    target_dir_idx = ((-1, 0), (1, 0), (0, -1), (0, 1)).index(target_direction)\n    \n    if current_dir != target_dir_idx:\n        actions.append((target_dir_idx + 2) % 4)  # Turn to face the workshop\n  else:\n    # Determine if we are next to the correct workshop and facing it\n    target_direction = (workshop_position[0] - path_to_workshop[-1][0], workshop_position[1] - path_to_workshop[-1][1])\n    current_dir = env._current_state.dir\n    target_dir_idx = ((-1, 0), (1, 0), (0, -1), (0, 1)).index(target_direction)\n    \n    if current_dir != target_dir_idx:\n        actions.append((target_dir_idx + 2) % 4)  # Turn to face the workshop\n\n  # Append USE action\n  actions.append(4)\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T15:40:03.503067", "function_name": "craft", "function_body": "", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-11T15:40:04.463795", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index of the goal item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we already have the item in our inventory\n  if env._current_state.inventory[item_index] > 0:\n    return actions\n  \n  # Fetch the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n  \n  # If there's no recipe, we can't craft it\n  if not recipe or \"_at\" not in recipe:\n    return []\n  \n  # Determine the workshop needed to craft the item\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n  \n  # Find the positions of all workshops of this type in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n    return []\n  \n  # Pick the closest workshop (for simplicity, just take the first one found)\n  target_workshop_pos = tuple(workshop_positions[0])\n  \n  # Calculate the relative direction to the workshop\n  rel_x = target_workshop_pos[0] - env._current_state.pos[0]\n  rel_y = target_workshop_pos[1] - env._current_state.pos[1]\n  \n  # Move towards the workshop (simplest version)\n  if rel_x > 0:\n    actions.extend([craft.N_DOWN]*rel_x)\n  elif rel_x < 0:\n    actions.extend([craft.N_UP]*abs(rel_x))\n  \n  if rel_y > 0:\n    actions.extend([craft.N_RIGHT]*rel_y)\n  elif rel_y < 0:\n    actions.extend([craft.N_LEFT]*abs(rel_y))\n  \n  # Turn towards the workshop and use USE action\n  target_direction = (np.argmax(np.abs((rel_x, rel_y))), np.sign(rel_x) + 2*np.sign(rel_y))[(rel_x != 0, rel_y != 0)]\n  if env._current_state.dir != target_direction:\n    actions.append(target_direction)\n  \n  actions.append(craft.N_USE)\n  \n  # Check if we have the required primitives\n  for ingredient_index, count in recipe.items():\n      if ingredient_index == \"_at\":\n          continue\n      if env._current_state.inventory[ingredient_index] < count:\n          return []\n      \n  # Use the USE action again to craft the item\n  actions.append(craft.N_USE)\n  \n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-11T15:42:46.941777", "function_name": "craft", "function_body": "  def get_direction(current_pos, target_pos):\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    if abs(dx) > abs(dy):\n      return 3 if dx > 0 else 2\n    elif abs(dx) < abs(dy):\n      return 1 if dy > 0 else 0\n    else: # dx == dy\n      # Choose the direction that is closer to being aligned with the target\n      if current_pos[0] < target_pos[0]:\n        if current_pos[1] < target_pos[1]: return 3  # RIGHT\n        else: return 1  # UP\n      else:\n        if current_pos[1] < target_pos[1]: return 2  # LEFT\n        else: return 0  # DOWN\n\n  def navigate(state, target_pos):\n    path = []\n    current_pos = state.pos\n    \n    while current_pos != target_pos:\n      direction = get_direction(current_pos, target_pos)\n      \n      if direction == 0:  # DOWN\n        path.append(0)\n        current_pos = (current_pos[0], current_pos[1] - 1)\n      elif direction == 1:  # UP\n        path.append(1)\n        current_pos = (current_pos[0], current_pos[1] + 1)\n      elif direction == 2:  # LEFT\n        path.append(2)\n        current_pos = (current_pos[0] - 1, current_pos[1])\n      elif direction == 3:  # RIGHT\n        path.append(3)\n        current_pos = (current_pos[0] + 1, current_pos[1])\n    \n    return path\n\n  def has_all_primitives(required_primitives, inventory_dict):\n    return all(primitive in inventory_dict and inventory_dict[primitive] >= required_primitives[primitive] for primitive in required_primitives)\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  # If not all primitives are available return empty action list\n  if not has_all_primitives(required_primitives, inventory_dict):\n    return []\n  \n  # Find the workshop where we can craft this item and its position\n  workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n      workshop_index = recipe.get(\"_at\")\n      break\n  \n  if workshop_index is None:\n    return []\n\n  # Find the positions of all workshops with the same index\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(workshop_positions) == 0:\n    return []\n  \n  # Select the closest workshop\n  current_pos = env._current_state.pos\n  target_workshop_pos = tuple(min(workshop_positions, key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])))\n\n  # Navigate to the selected workshop\n  actions = navigate(env._current_state, target_workshop_pos)\n  \n  # Turn towards the workshop if not already facing it\n  current_direction = env._current_state.dir\n  direction_to_workshop = get_direction(current_pos, target_workshop_pos)\n  \n  # Check if we need to turn\n  if current_direction != direction_to_workshop:\n    actions.append(direction_to_workshop)\n\n  # Use the USE action to craft the item at the workshop\n  actions.append(4)  # Assuming 4 is the index for the USE action\n  \n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T15:42:48.050798", "function_name": "craft", "function_body": "  def get_direction(current_pos, target_pos):\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    if abs(dx) > abs(dy):\n      return 3 if dx > 0 else 2\n    elif abs(dx) < abs(dy):\n      return 1 if dy > 0 else 0\n    elif dx > 0:\n      return 3  # RIGHT\n    elif dx < 0:\n      return 2  # LEFT\n    elif dy > 0:\n      return 1  # UP\n    elif dy < 0:\n      return 0  # DOWN\n\n  def navigate(state, target_pos):\n    path = []\n    current_pos = state.pos\n    \n    while current_pos != target_pos:\n      direction = get_direction(current_pos, target_pos)\n      \n      if direction == 0:  # DOWN\n        path.append(0)\n        current_pos = (current_pos[0], current_pos[1] - 1)\n      elif direction == 1:  # UP\n        path.append(1)\n        current_pos = (current_pos[0], current_pos[1] + 1)\n      elif direction == 2:  # LEFT\n        path.append(2)\n        current_pos = (current_pos[0] - 1, current_pos[1])\n      elif direction == 3:  # RIGHT\n        path.append(3)\n        current_pos = (current_pos[0] + 1, current_pos[1])\n    \n    return path\n\n  def turn_to_face(state, target_pos):\n    dx = target_pos[0] - state.pos[0]\n    dy = target_pos[1] - state.pos[1]\n\n    if abs(dx) > abs(dy):\n      return 3 if dx > 0 else 2\n    elif abs(dx) < abs(dy):\n      return 1 if dy > 0 else 0\n    elif dx > 0:\n      return 3  # RIGHT\n    elif dx < 0:\n      return 2  # LEFT\n    elif dy > 0:\n      return 1  # UP\n    elif dy < 0:\n      return 0  # DOWN\n\n  def has_all_primitives(required_primitives, inventory_dict):\n    return all(primitive in inventory_dict and inventory_dict[primitive] >= required_primitives[primitive] for primitive in required_primitives)\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  # If not all primitives are available return empty action list\n  if not has_all_primitives(required_primitives, inventory_dict):\n    return []\n  \n  # Find the workshop where we can craft this item\n  workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n      workshop_index = recipe.get(\"_at\")\n      break\n  \n  if workshop_index is None:\n    return []\n\n  # Find the position of the nearest workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(workshop_positions) == 0:\n    return []\n  \n  # Select the closest workshop (for simplicity, we take the first one found)\n  target_workshop_pos = tuple(min(workshop_positions, key=lambda x: abs(x[0] - env._current_state.pos[0]) + abs(x[1] - env._current_state.pos[1])))\n\n  # Navigate to the selected workshop\n  actions = navigate(env._current_state, target_workshop_pos)\n  \n  # Turn towards the workshop if not already facing it\n  current_direction = env._current_state.dir\n  direction_to_workshop = turn_to_face(env._current_state, target_workshop_pos)\n  \n  # Check if we need to turn\n  if current_direction != direction_to_workshop:\n    actions.append(direction_to_workshop)\n\n  # Use the USE action to craft the item at the workshop\n  actions.append(4)  # Assuming 4 is the index for the USE action\n  \n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T15:44:51.002694", "function_name": "craft", "function_body": "  goal_index = env.world.cookbook.index[item]\n\n  # Check if we have all required primitives in our inventory\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  current_inventory = collections.Counter(env._current_state.inventory)\n\n  for primitive, count in required_primitives.items():\n    if current_inventory[primitive] < count:\n      return []  # Missing required primitives\n\n  # Determine the workshop where crafting should occur\n  recipe_details = env.world.cookbook.recipes[goal_index]\n  workshop_name = recipe_details[\"_key\"]\n\n  # Get the index of the workshop from the world's cookbook\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the closest workshop in the grid\n  positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(positions) == 0:\n    return []  # No available workshops\n\n  closest_workshop_pos = min(\n      positions, key=lambda x: abs(x[0] - env._current_state.pos[0]) + abs(x[1] - env._current_state.pos[1]))\n\n  # Navigate to the closest workshop\n  current_pos = np.array(env._current_state.pos)\n  target_pos = np.array(closest_workshop_pos)\n\n  actions = []\n  \n  def navigate_to_target(current, target):\n    delta = target - current\n    if abs(delta[0]) > abs(delta[1]):\n        if delta[0] > 0:\n            return craft.RIGHT\n        else:\n            return craft.LEFT\n    else:\n        if delta[1] > 0:\n            return craft.DOWN\n        else:\n            return craft.UP\n\n  while not np.array_equal(current_pos, target_pos):\n      action = navigate_to_target(current_pos, target_pos)\n      actions.append(action)\n      \n      # Simulate the move in current_pos for next iteration\n      if action == craft.RIGHT:\n          current_pos[0] += 1\n      elif action == craft.LEFT:\n          current_pos[0] -= 1\n      elif action == craft.DOWN:\n          current_pos[1] += 1\n      else:  # action == craft.UP\n          current_pos[1] -= 1\n\n  # Orient the agent to face the workshop and use it\n  direction_to_workshop = target_pos - current_pos\n\n  if direction_to_workshop[0] > 0:  # Workshop is to the right\n      actions.append(craft.RIGHT)\n  elif direction_to_workshop[0] < 0:  # Workshop is to the left\n      actions.append(craft.LEFT)\n  elif direction_to_workshop[1] > 0:  # Workshop is below\n      actions.append(craft.DOWN)\n  else:  # Workshop is above\n      actions.append(craft.UP)\n\n  actions.append(craft.USE)  # Use the workshop\n\n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T15:44:52.151012", "function_name": "craft", "function_body": "  goal_index = env.world.cookbook.index[item]\n\n  # Check if we have all required primitives in our inventory\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  current_inventory = collections.Counter(env._current_state.inventory)\n\n  for primitive, count in required_primitives.items():\n    if current_inventory[primitive] < count:\n      return []  # Missing required primitives\n\n  # Determine the workshop where crafting should occur\n  recipe_details = env.world.cookbook.recipes[goal_index]\n  workshop_name = recipe_details[\"_key\"]\n\n  # Get the index of the workshop from the world's cookbook\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the closest workshop in the grid\n  positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(positions) == 0:\n    return []  # No available workshops\n\n  closest_workshop_pos = min(\n      positions, key=lambda x: abs(x[0] - env._current_state.pos[0]) + abs(x[1] - env._current_state.pos[1]))\n\n  # Navigate to the closest workshop\n  current_pos = np.array(env._current_state.pos)\n  target_pos = np.array(closest_workshop_pos)\n\n  actions = []\n\n  while not np.array_equal(current_pos, target_pos):\n    delta = target_pos - current_pos\n\n    # Calculate direction based on the largest absolute difference\n    if abs(delta[0]) > abs(delta[1]):\n      if delta[0] > 0:\n        actions.append(craft.RIGHT)  # Move right\n      else:\n        actions.append(craft.LEFT)   # Move left\n    else:\n      if delta[1] > 0:\n        actions.append(craft.DOWN)   # Move down\n      else:\n        actions.append(craft.UP)     # Move up\n\n    current_pos = np.array(env._current_state.pos)\n\n  # Orient the agent to face the workshop and use it\n  direction_to_workshop = target_pos - current_pos\n\n  if direction_to_workshop[0] > 0:  # Workshop is to the right\n      actions.append(craft.RIGHT)\n  elif direction_to_workshop[0] < 0:  # Workshop is to the left\n      actions.append(craft.LEFT)\n  elif direction_to_workshop[1] > 0:  # Workshop is below\n      actions.append(craft.DOWN)\n  else:  # Workshop is above\n      actions.append(craft.UP)\n\n  # Check if already facing the workshop and then use it\n  current_direction = env._current_state.agent_dir\n  target_direction = np.sign(direction_to_workshop)\n\n  direction_map = {\n    (1, 0): craft.RIGHT,\n    (-1, 0): craft.LEFT,\n    (0, 1): craft.DOWN,\n    (0, -1): craft.UP\n  }\n\n  if current_direction != target_direction:\n    actions.append(direction_map[target_direction])\n\n  actions.append(craft.USE)  # Use the workshop\n\n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T15:47:16.291810", "function_name": "craft", "function_body": "  def has_all_primitives(required_primitives, inventory_dict):\n    return all(primitive in inventory_dict and inventory_dict[primitive] >= required_primitives[primitive] for primitive in required_primitives)\n\n  def get_closest_workshop(grid, workshop_index):\n    agent_pos = env._current_state.pos\n    workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n    if len(workshop_positions) == 0:\n      return None\n    \n    # Calculate the Manhattan distance to each workshop and choose the closest one\n    distances = [abs(agent_pos[0] - pos[0]) + abs(agent_pos[1] - pos[1]) for pos in workshop_positions]\n    closest_index = np.argmin(distances)\n    return tuple(workshop_positions[closest_index])\n\n  def navigate(state, target):\n    actions = []\n    current_x, current_y = state.pos\n    target_x, target_y = target\n\n    # Move horizontally first\n    while current_x < target_x:\n        actions.append(3)  # RIGHT\n        current_x += 1\n    while current_x > target_x:\n        actions.append(2)  # LEFT\n        current_x -= 1\n\n    # Then move vertically\n    while current_y < target_y:\n        actions.append(0)  # DOWN\n        current_y += 1\n    while current_y > target_y:\n        actions.append(1)  # UP\n        current_y -= 1\n\n    return actions\n\n  def get_direction(current_pos, target_pos):\n    current_x, current_y = current_pos\n    target_x, target_y = target_pos\n\n    if current_x < target_x:\n      return 3  # RIGHT\n    elif current_x > target_x:\n      return 2  # LEFT\n    elif current_y < target_y:\n      return 0  # DOWN\n    else:\n      return 1  # UP\n\n  actions = []\n  \n  # Get the index of the goal item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  # If not all primitives are available return empty action list\n  if not has_all_primitives(required_primitives, inventory_dict):\n    return []\n  \n  # Find the workshop where we can craft this item\n  workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n      workshop_index = recipe.get(\"_at\")\n      break\n  \n  if workshop_index is None:\n    return []\n\n  # Get the closest workshop position\n  target_workshop_pos = get_closest_workshop(env._current_state.grid, workshop_index)\n  if target_workshop_pos is None:\n    return []\n  \n  # Navigate to the selected workshop\n  actions.extend(navigate(env._current_state, target_workshop_pos))\n  \n  # Turn towards the workshop if not already facing it\n  current_direction = env._current_state.dir\n  direction_to_workshop = get_direction(env._current_state.pos, target_workshop_pos)\n  if current_direction != direction_to_workshop:\n    actions.append(direction_to_workshop)\n\n  # Use the USE action to craft the item at the workshop\n  actions.append(4)  # Assuming 4 is the index for the USE action\n  \n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T15:47:17.396059", "function_name": "craft", "function_body": "  def has_all_primitives(required_primitives, inventory_dict):\n    return all(primitive in inventory_dict and inventory_dict[primitive] >= required_primitives[primitive] for primitive in required_primitives)\n\n  def get_closest_workshop(grid, workshop_index):\n    workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n    if len(workshop_positions) == 0:\n      return None\n    # Calculate the Manhattan distance to each workshop and choose the closest one\n    agent_pos = env._current_state.pos\n    distances = [abs(agent_pos[0] - pos[0]) + abs(agent_pos[1] - pos[1]) for pos in workshop_positions]\n    closest_index = np.argmin(distances)\n    return tuple(workshop_positions[closest_index])\n\n  def navigate(state, target):\n    actions = []\n    current_x, current_y = state.pos\n    target_x, target_y = target\n\n    # Calculate the direction to move first (horizontal or vertical)\n    if abs(current_x - target_x) > abs(current_y - target_y):\n        # Move horizontally first\n        while current_x < target_x:\n            actions.append(3)  # RIGHT\n            current_x += 1\n        while current_x > target_x:\n            actions.append(2)  # LEFT\n            current_x -= 1\n    else:\n        # Move vertically first\n        while current_y < target_y:\n            actions.append(0)  # DOWN\n            current_y += 1\n        while current_y > target_y:\n            actions.append(1)  # UP\n            current_y -= 1\n\n    return actions\n\n  def get_direction(current_pos, target_pos):\n    current_x, current_y = current_pos\n    target_x, target_y = target_pos\n\n    if current_x < target_x:\n      return 3  # RIGHT\n    elif current_x > target_x:\n      return 2  # LEFT\n    elif current_y < target_y:\n      return 0  # DOWN\n    else:\n      return 1  # UP\n\n  actions = []\n  \n  # Get the index of the goal item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  # If not all primitives are available return empty action list\n  if not has_all_primitives(required_primitives, inventory_dict):\n    return []\n  \n  # Find the workshop where we can craft this item\n  workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n    if item_index == recipe.get(\"_key\"):\n      workshop_index = recipe.get(\"_at\")\n      break\n  \n  if workshop_index is None:\n    return []\n\n  # Get the closest workshop position\n  target_workshop_pos = get_closest_workshop(env._current_state.grid, workshop_index)\n  if target_workshop_pos is None:\n    return []\n  \n  # Navigate to the selected workshop\n  actions.extend(navigate(env._current_state, target_workshop_pos))\n  \n  # Turn towards the workshop if not already facing it\n  current_direction = env._current_state.dir\n  direction_to_workshop = get_direction(env._current_state.pos, target_workshop_pos)\n  if current_direction != direction_to_workshop:\n    actions.append(direction_to_workshop)\n\n  # Use the USE action to craft the item at the workshop\n  actions.append(4)  # Assuming 4 is the index for the USE action\n  \n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T15:48:10.387176", "function_name": "craft", "function_body": "  actions = []\n\n  # Get the index for the desired item\n  goal_index = env.world.cookbook.index[item]\n\n  # Check if the item has a recipe and get its requirements\n  recipe = env.world.cookbook.recipes.get(goal_index, None)\n\n  if not recipe:\n    print(f\"No recipe found for {item}.\")\n    return []\n\n  # Collect primitives required by the recipe\n  for ingredient, count in recipe.items():\n    if ingredient == \"_key\":\n      continue  # Skip _key as it's not an ingredient\n    primitive_name = env.world.cookbook.index.get(ingredient)\n    if not primitive_name:\n      print(f\"Unknown ingredient {ingredient} in recipe for {item}.\")\n      return []\n    \n    actions.extend(collect_v2(env, primitive_name, count))\n\n  # Determine the workshop index required to craft the item\n  workshop_index = env.world.workshop_indices[recipe.get(\"_at\", -1)]\n\n  if workshop_index == -1:\n    print(f\"No workshop specified for crafting {item}.\")\n    return []\n\n  actions.extend(navigate_to_workshop_v2(env, workshop_index))\n\n  # Use action to craft the item\n  actions.append(craft.USE)\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
