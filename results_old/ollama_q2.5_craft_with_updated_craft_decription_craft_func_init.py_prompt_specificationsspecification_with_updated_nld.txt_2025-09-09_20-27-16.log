{"timestamp": "2025-09-11T02:15:34.286645", "function_name": "craft", "function_body": "    # Get the index of the desired item\n    item_index = env.world.cookbook.index[item]\n    \n    # Check if the recipe exists for this item in the cookbook\n    if item_index not in env.world.cookbook.recipes:\n        return []\n\n    # Get the required ingredients and their counts from the recipe\n    recipe = env.world.cookbook.recipes[item_index]\n\n    # Initialize actions list\n    actions = []\n    \n    # Collect all the necessary primitives for crafting the item\n    for ingredient, count in recipe.items():\n        if ingredient == \"_key\":\n            continue  # Skip workshop key\n\n        ingredient_name = env.world.cookbook.index.get(ingredient)\n        \n        # Check if we already have enough of this ingredient in our inventory\n        if env._current_state.inventory[ingredient] < count:\n            # Collect the required primitives\n            collect_actions = collect(env, ingredient_name)\n            actions.extend(collect_actions)\n\n    # Determine the workshop to use based on \"_at\" key in the recipe\n    workshop_key = next((key for key in recipe.keys() if key.startswith(\"_\")), None)\n    workshop_index = env.world.cookbook.index.get(recipe[workshop_key]) if workshop_key else None\n\n    # Move to and use the appropriate workshop\n    if workshop_index is not None:\n        move_to_workshop_actions = move(env, workshop_index)\n        actions.extend(move_to_workshop_actions)\n\n        # Perform the USE action at the workshop to craft the item\n        actions.append(4)  # Assuming 4 corresponds to the USE action\n\n    return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-11T02:15:35.342379", "function_name": "craft", "function_body": "  actions = []\n  goal_idx = env.world.cookbook.index[item]\n  \n  # Check if the goal is a primitive or has a recipe\n  if goal_idx in env.world.grabbable_indices:\n      print(f\"{item} is a primitive, no crafting needed.\")\n      return []\n\n  # If the item is not grabbable and doesn't have a recipe, return an empty list\n  if goal_idx not in env.world.cookbook.recipes:\n      print(f\"No recipe for {item}.\")\n      return []\n  \n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes[goal_idx]\n  \n  # Check if we have all the required ingredients and go to the corresponding workshops\n  for ingredient, count in recipe.items():\n    if ingredient == \"_key\":\n        continue\n    ingredient_idx = env.world.cookbook.index.get(ingredient)\n    if ingredient_idx is None:\n      print(f\"Unknown ingredient: {ingredient}\")\n      return []\n    \n    # Check if we have enough of this ingredient in our inventory\n    if env._current_state.inventory[ingredient_idx] < count:\n        # Find the nearest source or workshop for the ingredient\n        actions.extend(find_and_collect(env, ingredient))\n    \n    # Move to the corresponding workshop if needed\n    if recipe[\"_key\"] == \"workshop0\":\n      actions.extend(move_to_workshop(env, 0))\n    elif recipe[\"_key\"] == \"workshop1\":\n      actions.extend(move_to_workshop(env, 1))\n    elif recipe[\"_key\"] == \"workshop2\":\n      actions.extend(move_to_workshop(env, 2))\n  \n  # Finally use the USE action to craft the item\n  actions.append(craft.world.N_ACTIONS - 1)  # Assuming USE is the last action\n  \n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-11T02:18:41.481920", "function_name": "craft", "function_body": "  def find_item_positions(env, target_index):\n    grid = env._current_state.grid\n    return np.argwhere(grid[:, :, target_index] > 0).tolist()\n\n  def navigate_to_position(env, target_pos):\n    directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n    current_pos = env._current_state.pos\n    queue = collections.deque([(current_pos, [])])\n    visited = set([current_pos])\n\n    while queue:\n        pos, path = queue.popleft()\n        if tuple(pos) == tuple(target_pos):\n            return path\n        \n        for dx, dy in directions:\n            new_pos = (pos[0] + dx, pos[1] + dy)\n            if 0 <= new_pos[0] < env._current_state.grid.shape[0] and\\\n               0 <= new_pos[1] < env._current_state.grid.shape[1]:\n                if tuple(new_pos) not in visited:\n                    visited.add(tuple(new_pos))\n                    queue.append((tuple(new_pos), path + [directions.index((dx, dy))]))\n\n    return []  # No path found\n\n  def find_workshop_position(env, workshop_index):\n    positions = find_item_positions(env, workshop_index)\n    if not positions:\n      raise ValueError(f\"No available {env.world.cookbook.get(workshop_index)} to collect.\")\n    return positions[0]\n\n  def ensure_facing_workshop(env, workshop_pos):\n    current_dir = env._current_state.dir\n    target_direction = (workshop_pos[0] - env._current_state.pos[0], workshop_pos[1] - env._current_state.pos[1])\n\n    if target_direction == (-1, 0):\n        return [(env.world.N_ACTIONS - 4)]  # UP action\n    elif target_direction == (1, 0):\n        return [(env.world.N_ACTIONS - 3)]  # DOWN action\n    elif target_direction == (0, -1):\n        return [(env.world.N_ACTIONS - 2)]  # LEFT action\n    elif target_direction == (0, 1):\n        return [(env.world.N_ACTIONS - 5)]  # RIGHT action\n    else:\n        return []  # No direction change needed\n\n  def collect_primitives(env, required_items):\n    actions = []\n    for req_item_index, count in required_items.items():\n      while env._current_state.inventory[req_item_index] < count:\n        item_positions = find_item_positions(env, req_item_index)\n        \n        if not item_positions:\n          raise ValueError(f\"No available {env.world.cookbook.get(req_item_index)} to collect.\")\n        \n        for pos in item_positions:\n          actions.extend(navigate_to_position(env, pos))\n          \n          # Check if the agent is next to an item\n          if env._current_state.next_to(req_item_index):\n            actions.append(env.world.N_ACTIONS - 1)  # USE action\n          \n          if env._current_state.inventory[req_item_index] >= count:\n            break\n\n    return actions\n  \n  def use_workshop_to_craft(env, workshop_pos):\n    actions = []\n    \n    actions.extend(navigate_to_position(env, workshop_pos))\n    \n    current_dir = env._current_state.dir\n    target_direction = (workshop_pos[0] - env._current_state.pos[0], workshop_pos[1] - env._current_state.pos[1])\n    \n    if target_direction == (-1, 0) and current_dir != 0:\n        actions.append(env.world.N_ACTIONS - 4)  # UP action\n    elif target_direction == (1, 0) and current_dir != 1:\n        actions.append(env.world.N_ACTIONS - 3)  # DOWN action\n    elif target_direction == (0, -1) and current_dir != 2:\n        actions.append(env.world.N_ACTIONS - 2)  # LEFT action\n    elif target_direction == (0, 1) and current_dir != 3:\n        actions.append(env.world.N_ACTIONS - 5)  # RIGHT action\n    \n    actions.append(env.world.N_ACTIONS - 1)  # USE action\n    \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n  \n  if item_index in env.world.grabbable_indices:\n    return []  # Primitives cannot be crafted\n  \n  recipe = env.world.cookbook.recipes[item_index]\n\n  workshop_key = \"_at\"\n  workshop_name = recipe.get(workshop_key)\n  if workshop_name is None:\n    raise ValueError(f\"No workshop specified for crafting {item}.\")\n  \n  workshop_index = env.world.cookbook.index[workshop_name]\n  workshop_pos = find_workshop_position(env, workshop_index)\n\n  required_items = {env.world.cookbook.index[key]: value for key, value in recipe.items() if not isinstance(key, str) or not key.startswith('_at')}\n\n  actions = []\n\n  # Collect all required items\n  actions.extend(collect_primitives(env, required_items))\n\n  # Use the workshop to craft the item\n  actions.extend(use_workshop_to_craft(env, workshop_pos))\n  \n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T02:18:42.620613", "function_name": "craft", "function_body": "  def find_item_positions(env, target_index):\n    grid = env._current_state.grid\n    return np.argwhere(grid[:, :, target_index] > 0).tolist()\n\n  def navigate_to_position(env, target_pos):\n    directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n    current_pos = env._current_state.pos\n    queue = collections.deque([(current_pos, [])])\n    visited = set([current_pos])\n\n    while queue:\n        pos, path = queue.popleft()\n        if pos == tuple(target_pos):\n            return path\n        \n        for dx, dy in directions:\n            new_pos = (pos[0] + dx, pos[1] + dy)\n            if 0 <= new_pos[0] < env._current_state.grid.shape[0] and\\\n               0 <= new_pos[1] < env._current_state.grid.shape[1]:\n                if new_pos not in visited:\n                    visited.add(new_pos)\n                    queue.append((new_pos, path + [directions.index((dx, dy))]))\n\n    return []  # No path found\n\n  def find_workshop_position(env, workshop_index):\n    positions = find_item_positions(env, workshop_index)\n    if not positions:\n      raise ValueError(f\"No available {env.world.cookbook.get(workshop_index)} to collect.\")\n    return positions[0]\n\n  def collect_primitives(env, required_items):\n    actions = []\n    for req_item_index, count in required_items.items():\n      while env._current_state.inventory[req_item_index] < count:\n        item_positions = find_item_positions(env, req_item_index)\n        \n        if not item_positions:\n          raise ValueError(f\"No available {env.world.cookbook.get(req_item_index)} to collect.\")\n        \n        for pos in item_positions:\n          actions.extend(navigate_to_position(env, pos))\n          \n          # Check if the agent is next to an item\n          if env._current_state.next_to(req_item_index):\n            actions.append(env.world.N_ACTIONS - 1)  # USE action\n          \n          if env._current_state.inventory[req_item_index] >= count:\n            break\n\n    return actions\n  \n  def ensure_facing_workshop(env, workshop_pos):\n    current_dir = env._current_state.dir\n    target_direction = (workshop_pos[0] - env._current_state.pos[0], workshop_pos[1] - env._current_state.pos[1])\n\n    # Determine the direction index based on the difference in coordinates\n    if target_direction == (-1, 0):\n        return [(env.world.N_ACTIONS - 4)]  # UP action\n    elif target_direction == (1, 0):\n        return [(env.world.N_ACTIONS - 3)]  # DOWN action\n    elif target_direction == (0, -1):\n        return [(env.world.N_ACTIONS - 2)]  # LEFT action\n    elif target_direction == (0, 1):\n        return [(env.world.N_ACTIONS - 5)]  # RIGHT action\n    else:\n        return []  # No direction change needed\n\n  item_index = env.world.cookbook.index[item]\n  \n  if item_index in env.world.grabbable_indices:\n    return []  # Primitives cannot be crafted\n  \n  recipe = env.world.cookbook.recipes[item_index]\n\n  workshop_key = \"_at\"\n  workshop_name = recipe.get(workshop_key)\n  if workshop_name is None:\n    raise ValueError(f\"No workshop specified for crafting {item}.\")\n  \n  workshop_index = env.world.cookbook.index[workshop_name]\n  workshop_pos = find_workshop_position(env, workshop_index)\n\n  required_items = {env.world.cookbook.index[key]: value for key, value in recipe.items() if not isinstance(key, str) or not key.startswith('_at')}\n\n  actions = []\n\n  # Collect all required items\n  actions.extend(collect_primitives(env, required_items))\n\n  # Navigate to the workshop and ensure correct facing direction\n  actions.extend(navigate_to_position(env, workshop_pos))\n  actions.extend(ensure_facing_workshop(env, workshop_pos))\n  \n  # Use the workshop to craft the item\n  actions.append(env.world.N_ACTIONS - 1)  # USE action\n  \n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T02:19:09.145467", "function_name": "craft", "function_body": "  actions = []\n\n  # Convert item name to its index\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the goal is achievable and get the recipe\n  if item_index not in env.world.cookbook.recipes:\n    return actions\n\n  recipe = env.world.cookbook.recipes[item_index]\n  \n  # Collect all necessary primitives for crafting the item\n  for ingredient, count in recipe.items():\n    if ingredient == \"_at\":\n      continue\n    primitive_index = env.world.cookbook.index[ingredient]\n    while np.sum(env._current_state.inventory[primitive_index]) < count:\n      actions.extend(collect_v2(env, ingredient))\n\n  # Find the workshop where the item can be crafted\n  workshop = recipe[\"_at\"]\n  workshop_index = env.world.workshop_indices[env.world.cookbook.index[workshop]]\n\n  # Move to the workshop and craft the item\n  actions.extend(navigate_to_workshop_v2(env, workshop))\n  actions.append(craft.ACTION_USE)\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
