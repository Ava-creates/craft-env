{"timestamp": "2025-09-11T17:07:22.027557", "function_name": "craft", "function_body": "  def get_direction(current_pos, target_pos):\n    x_diff = target_pos[0] - current_pos[0]\n    y_diff = target_pos[1] - current_pos[1]\n\n    if x_diff > 0:\n      return 3  # RIGHT\n    elif x_diff < 0:\n      return 2  # LEFT\n    elif y_diff > 0:\n      return 1  # UP\n    else:\n      return 0  # DOWN\n\n  def find_path(start, target):\n    actions = []\n\n    start_x, start_y = divmod(start, env._current_state.grid.shape[1])\n    target_x, target_y = divmod(target, env._current_state.grid.shape[1])\n\n    open_set = []\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, target)}\n\n    heapq.heappush(open_set, (f_score[start], start))\n\n    while open_set:\n      _, current = heapq.heappop(open_set)\n\n      if current == target:\n        reconstruct_path(came_from, current)\n        break\n\n      cx, cy = divmod(current, env._current_state.grid.shape[1])\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = cx + dx, cy + dy\n\n        if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n          neighbor = nx * env._current_state.grid.shape[1] + ny\n          tentative_g_score = g_score[current] + 1\n\n          if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n            came_from[neighbor] = current\n            g_score[neighbor] = tentative_g_score\n            f_score[neighbor] = tentative_g_score + heuristic(neighbor, target)\n            heapq.heappush(open_set, (f_score[neighbor], neighbor))\n\n    def reconstruct_path(came_from, current):\n      total_path = []\n      while current in came_from:\n        cx, cy = divmod(current, env._current_state.grid.shape[1])\n        px, py = divmod(came_from[current], env._current_state.grid.shape[1])\n\n        dx, dy = px - cx, py - cy\n        direction_to_face = get_direction((cx, cy), (px, py))\n        total_path.append(direction_to_face)\n        current = came_from[current]\n\n      actions.extend(reversed(total_path))\n\n    return actions\n\n  def heuristic(a, b):\n    ax, ay = divmod(a, env._current_state.grid.shape[1])\n    bx, by = divmod(b, env._current_state.grid.shape[1])\n\n    # Manhattan distance\n    return abs(ax - bx) + abs(ay - by)\n\n  actions = []\n\n  item_index = env.world.cookbook.index[item]\n  \n  if not item_index:\n    return []\n\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  current_inventory = {env.world.cookbook.index.get(i): c for i, c in enumerate(env._current_state.inventory) if c > 0}\n\n  # Check if we have all the required primitives\n  missing_primitives = []\n  for primitive_index, count in primitives_needed.items():\n    if current_inventory.get(primitive_index, 0) < count:\n      missing_primitives.append((primitive_index, count - current_inventory.get(primitive_index, 0)))\n\n  if missing_primitives:\n    # Collect the missing primitives\n    for primitive_index, needed_count in missing_primitives:\n      primitive_name = env.world.cookbook.index_by_id[primitive_index]\n      primitive_indices = np.argwhere(env._current_state.grid[:, :, primitive_index] > 0)\n\n      if not primitive_indices.any():\n        return []\n\n      start_pos_flat = env._current_state.pos[0] * env._current_state.grid.shape[1] + env._current_state.pos[1]\n      target_pos_flat = primitive_indices[0][0] * env._current_state.grid.shape[1] + primitive_indices[0][1]\n\n      actions.extend(find_path(start_pos_flat, target_pos_flat))\n\n      # Pick up the primitive by using the USE action\n      actions.append(4)  # USE action\n\n      current_inventory[primitive_index] = current_inventory.get(primitive_index, 0) + 1\n\n    if not all(current_inventory.get(primitive_index, 0) >= count for primitive_index, count in primitives_needed.items()):\n        return []\n\n  # Find the workshop to craft the item\n  workshop_name = env.world.cookbook.recipes[item_index][\"_at\"]\n  workshop_indices = np.argwhere(env._current_state.grid[:, :, env.world.workshop_indices[0]] == env.world.cookbook.index[workshop_name])\n\n  if not workshop_indices.any():\n    return []\n\n  # Convert the grid coordinates to a flat list\n  start_pos_flat = env._current_state.pos[0] * env._current_state.grid.shape[1] + env._current_state.pos[1]\n  target_pos_flat = workshop_indices[0][0] * env._current_state.grid.shape[1] + workshop_indices[0][1]\n\n  actions.extend(find_path(start_pos_flat, target_pos_flat))\n\n  # Ensure we are in front of the workshop\n  target_workshop_position = (workshop_indices[0][0], workshop_indices[0][1])\n  direction_to_face = get_direction(env._current_state.pos, target_workshop_position)\n  if direction_to_face is not None:\n      actions.append(direction_to_face)\n\n  # Craft the item by using the USE action\n  actions.append(4)  # USE action\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-11T17:07:23.111640", "function_name": "craft", "function_body": "  def get_direction(current_pos, target_pos):\n    x_diff = target_pos[0] - current_pos[0]\n    y_diff = target_pos[1] - current_pos[1]\n\n    if x_diff > 0:\n      return 3  # RIGHT\n    elif x_diff < 0:\n      return 2  # LEFT\n    elif y_diff > 0:\n      return 1  # UP\n    else:\n      return 0  # DOWN\n\n  def find_path(start, target):\n    actions = []\n    start_x, start_y = divmod(start, env._current_state.grid.shape[1])\n    target_x, target_y = divmod(target, env._current_state.grid.shape[1])\n\n    open_set = []\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, target)}\n\n    heapq.heappush(open_set, (f_score[start], start))\n\n    while open_set:\n      _, current = heapq.heappop(open_set)\n\n      if current == target:\n        reconstruct_path(came_from, current)\n        break\n\n      cx, cy = divmod(current, env._current_state.grid.shape[1])\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = cx + dx, cy + dy\n        if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n          neighbor = nx * env._current_state.grid.shape[1] + ny\n          tentative_g_score = g_score[current] + 1\n\n          if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n            came_from[neighbor] = current\n            g_score[neighbor] = tentative_g_score\n            f_score[neighbor] = tentative_g_score + heuristic(neighbor, target)\n            heapq.heappush(open_set, (f_score[neighbor], neighbor))\n\n    def reconstruct_path(came_from, current):\n      total_path = []\n      while current in came_from:\n        cx, cy = divmod(current, env._current_state.grid.shape[1])\n        px, py = divmod(came_from[current], env._current_state.grid.shape[1])\n\n        dx, dy = px - cx, py - cy\n        direction_to_face = get_direction((cx, cy), (px, py))\n        \n        if direction_to_face is not None:\n            total_path.append(direction_to_face)\n        \n        current = came_from[current]\n\n      actions.extend(reversed(total_path))\n\n    return actions\n\n  def heuristic(a, b):\n    ax, ay = divmod(a, env._current_state.grid.shape[1])\n    bx, by = divmod(b, env._current_state.grid.shape[1])\n\n    # Manhattan distance\n    return abs(ax - bx) + abs(ay - by)\n\n  actions = []\n\n  item_index = env.world.cookbook.index[item]\n\n  if not item_index:\n    return []\n\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  current_inventory = {env.world.cookbook.index.get(i): c for i, c in enumerate(env._current_state.inventory) if c > 0}\n\n  # Check if we have all the required primitives\n  for primitive_index, count in primitives_needed.items():\n    if current_inventory.get(primitive_index, 0) < count:\n      return []\n\n  # Find the workshop to craft the item\n  workshop_name = env.world.cookbook.recipes[item_index][\"_at\"]\n  workshop_indices = np.argwhere(env._current_state.grid[:, :, env.world.workshop_indices[0]] == env.world.cookbook.index[workshop_name])\n\n  if not workshop_indices.any():\n    return []\n\n  # Convert the grid coordinates to a flat list\n  start_pos_flat = env._current_state.pos[0] * env._current_state.grid.shape[1] + env._current_state.pos[1]\n\n  for workshop_index in workshop_indices:\n      target_pos_flat = workshop_index[0] * env._current_state.grid.shape[1] + workshop_index[1]\n      path_to_workshop = find_path(start_pos_flat, target_pos_flat)\n\n      if path_to_workshop:\n          actions.extend(path_to_workshop)\n          \n          # Ensure we are in front of the workshop\n          target_workshop_position = (workshop_index[0], workshop_index[1])\n          direction_to_face = get_direction(env._current_state.pos, target_workshop_position)\n          if direction_to_face is not None:\n              actions.append(direction_to_face)\n\n          # Craft the item by using the USE action\n          actions.append(4)  # USE action\n\n          return actions\n\n  return []", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T17:08:10.110276", "function_name": "craft", "function_body": "  # Retrieve the index of the goal item from the cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the item has a recipe in the cookbook\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Collect all primitives required by the recipe\n  actions = []\n  current_state = env._current_state\n  inventory = current_state.inventory\n\n  # Check if we have all the primitives required in our inventory\n  for ingredient, count in recipe.items():\n    if ingredient == \"_at\":\n      continue  # Skip the \"_at\" key which specifies the workshop\n    \n    ingredient_index = env.world.cookbook.index[ingredient]\n    while inventory[ingredient_index] < count:\n      actions.extend(collect(env, ingredient))\n      current_state = env._current_state\n      inventory = current_state.inventory\n  \n  # Now that we have all primitives, go to the specified workshop and craft the item\n  workshop_name = recipe[\"_at\"]\n  workshop_index = getattr(env.world, f\"{workshop_name}_index\")\n\n  # Move to the workshop and face it\n  workshop_pos = find_nearest_workshop(current_state.grid, current_state.pos, workshop_index)\n  if not workshop_pos:\n    return []  # No valid path found\n\n  actions.extend(move_to_position_and_face(env._current_state, workshop_pos, workshop_index))\n\n  # Perform the USE action to craft the item\n  actions.append(env.world.N_ACTIONS - 1)  # Assuming USE is the last action index\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-11T17:08:11.093407", "function_name": "craft", "function_body": "  actions = []\n  \n  # Convert item name to index using the cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n  \n  if not recipe:\n    print(f\"No recipe found for {item}\")\n    return actions\n  \n  # Check and collect all prerequisites (primitives and other crafted items)\n  for ingredient, count in recipe.items():\n    if ingredient == \"_key\":\n      continue\n    ingredient_index = env.world.cookbook.index[ingredient]\n    while env._current_state.inventory[ingredient_index] < count:\n      actions.extend(collect(env, ingredient))\n    \n  # Determine the workshop where crafting should happen\n  workshop = recipe.get(\"_at\", None)\n  if workshop is None:\n    print(f\"No workshop specified for {item}\")\n    return actions\n  \n  # Find all workshops of the required type in the grid\n  workshop_index = env.world.cookbook.index[workshop]\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  \n  if len(workshop_positions) == 0:\n    print(f\"No {workshop} found in the environment\")\n    return actions\n  \n  # Move to the nearest workshop\n  current_pos = env._current_state.pos\n  nearest_workshop = min(workshop_positions, key=lambda pos: np.linalg.norm(np.array(pos) - np.array(current_pos)))\n  actions.extend(move_to(env, tuple(nearest_workshop)))\n\n  # Use the workshop to craft the item (the agent must be facing the block)\n  actions.append(env.world.N_ACTIONS[\"USE\"])\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-11T17:10:48.275638", "function_name": "craft", "function_body": "  def get_direction(current_pos, target_pos):\n    x_diff = target_pos[0] - current_pos[0]\n    y_diff = target_pos[1] - current_pos[1]\n\n    if x_diff > 0:\n      return 3  # RIGHT\n    elif x_diff < 0:\n      return 2  # LEFT\n    elif y_diff > 0:\n      return 1  # UP\n    elif y_diff < 0:\n      return 0  # DOWN\n    else:\n      return None\n\n  def find_path(start, target):\n    actions = []\n\n    start_x, start_y = divmod(start, env._current_state.grid.shape[1])\n    target_x, target_y = divmod(target, env._current_state.grid.shape[1])\n\n    open_set = []\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, target)}\n\n    heapq.heappush(open_set, (f_score[start], start))\n\n    while open_set:\n      _, current = heapq.heappop(open_set)\n\n      if current == target:\n        reconstruct_path(came_from, current)\n        break\n\n      cx, cy = divmod(current, env._current_state.grid.shape[1])\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = cx + dx, cy + dy\n\n        if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n          neighbor = nx * env._current_state.grid.shape[1] + ny\n          tentative_g_score = g_score[current] + 1\n\n          if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n            came_from[neighbor] = current\n            g_score[neighbor] = tentative_g_score\n            f_score[neighbor] = tentative_g_score + heuristic(neighbor, target)\n            heapq.heappush(open_set, (f_score[neighbor], neighbor))\n\n    def reconstruct_path(came_from, current):\n      total_path = []\n      while current in came_from:\n        cx, cy = divmod(current, env._current_state.grid.shape[1])\n        px, py = divmod(came_from[current], env._current_state.grid.shape[1])\n\n        dx, dy = px - cx, py - cy\n        direction_to_face = get_direction((cx, cy), (px, py))\n\n        if direction_to_face is not None:\n          total_path.append(direction_to_face)\n\n        current = came_from[current]\n\n      actions.extend(reversed(total_path))\n\n    return actions\n\n  def heuristic(a, b):\n    ax, ay = divmod(a, env._current_state.grid.shape[1])\n    bx, by = divmod(b, env._current_state.grid.shape[1])\n\n    # Manhattan distance\n    return abs(ax - bx) + abs(ay - by)\n\n  actions = []\n\n  item_index = env.world.cookbook.index.get(item)\n  \n  if item_index is None:\n    return []\n\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  current_inventory = {env.world.cookbook.index[i]: count for i, count in enumerate(env._current_state.inventory) if count > 0}\n\n  missing_primitives = []\n  for primitive_index, count in primitives_needed.items():\n    if current_inventory.get(primitive_index, 0) < count:\n      missing_primitives.append((primitive_index, count - current_inventory.get(primitive_index, 0)))\n\n  if missing_primitives:\n    return []\n\n  workshop_name = env.world.cookbook.recipes[item_index][\"_at\"]\n  workshop_indices = np.argwhere(env._current_state.grid[:, :, env.world.workshop_indices[0]] == env.world.cookbook.index[workshop_name])\n\n  if not workshop_indices.any():\n    return []\n\n  start_pos_flat = env._current_state.pos[0] * env._current_state.grid.shape[1] + env._current_state.pos[1]\n  target_workshop_position = (workshop_indices[0][0], workshop_indices[0][1])\n  target_pos_flat = target_workshop_position[0] * env._current_state.grid.shape[1] + target_workshop_position[1]\n\n  actions.extend(find_path(start_pos_flat, target_pos_flat))\n\n  direction_to_face = get_direction(env._current_state.pos, target_workshop_position)\n  \n  if direction_to_face is not None:\n    actions.append(direction_to_face)\n\n  # Ensure the agent is directly in front of the workshop\n  while env._current_state.pos != (target_workshop_position[0], target_workshop_position[1]):\n    current_pos = env._current_state.pos\n    direction_to_face = get_direction(current_pos, target_workshop_position)\n    \n    if direction_to_face is not None:\n      actions.append(direction_to_face)\n\n  # Craft the item by using the USE action\n  actions.append(4)  # USE action\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
