{"timestamp": "2025-09-11T03:39:44.027792", "function_name": "craft", "function_body": "  # Improved logic to handle more complex recipes with intermediate items\n  def collect_primitives(primitive_indices):\n    actions = []\n    for i_kind in primitive_indices:\n      block_name = env.world.cookbook.index.get(i_kind)\n      if not block_name:\n        return []\n      \n      primitive_path = find_path_to_block(i_kind)\n      if not primitive_path:\n        return []\n\n      actions.extend(primitive_path) # Move to the required primitive\n\n      # Assume we pick up the item by facing it\n      pickup_action = 4  # Assuming USE is action index 4 for picking up items\n      actions.append(pickup_action)\n\n    return actions\n  \n  def find_path_to_block(i_kind):\n    pos = env._current_state.pos\n    grid = env._current_state.grid\n    directions = [(0,1), (1,0), (0,-1), (-1,0)]\n    \n    # Simple BFS to find the nearest block of type i_kind\n    queue = collections.deque([(pos, [])])\n    visited = set([pos])\n    while queue:\n      current_pos, path = queue.popleft()\n      x, y = current_pos\n      \n      if grid[x,y,i_kind] == 1:\n        return path\n      \n      for dx, dy in directions:\n        new_x, new_y = x + dx, y + dy\n        if (0 <= new_x < grid.shape[0]) and (0 <= new_y < grid.shape[1]) and (grid[new_x,new_y].sum() == 0) and ((new_x, new_y) not in visited):\n          visited.add((new_x, new_y))\n          queue.append(((new_x, new_y), path + [directions.index((dx, dy))]))\n    \n    return None\n\n  def craft_item(item_index):\n    recipe_info = env.world.cookbook.recipes[item_index]\n    if \"_at\" in recipe_info:\n      workshop_name = recipe_info[\"_at\"]\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      \n      workshop_path = find_path_to_block(workshop_idx)\n      if not workshop_path:\n        return []\n\n      actions.extend(workshop_path) # Move to the required workshop\n\n      # Assume we craft the item by facing it\n      crafting_action = 4  # Assuming USE is action index 4 for crafting items\n      actions.append(crafting_action)\n\n    return actions\n  \n  item_index = env.world.cookbook.index[item]\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n  \n  if not primitives_required:\n    return []\n\n  actions = []\n  \n  # Collect all required primitives\n  primitive_indices = [i_kind for i_kind, count in primitives_required.items() for _ in range(count)]\n  actions.extend(collect_primitives(primitive_indices))\n\n  # Craft the item at the specified workshop\n  actions.extend(craft_item(item_index))\n  \n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T03:39:45.089408", "function_name": "craft", "function_body": "  # More efficient pathfinding and better resource management can be added here.\n  # For example, using A* search instead of BFS for finding paths to resources and workshops.\n  return []", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T03:41:15.032247", "function_name": "craft", "function_body": "  def has_all_primitives(required_primitives, inventory_dict):\n    return all(primitive in inventory_dict and inventory_dict[primitive] >= required_primitives[primitive] for primitive in required_primitives)\n\n  actions = []\n  \n  # Get the index of the goal item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  # If not all primitives are available return empty action list\n  if not has_all_primitives(required_primitives, inventory_dict):\n    return []\n  \n  # Find the workshop where we can craft this item\n  workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n      workshop_index = recipe.get(\"_at\")\n      break\n  \n  if workshop_index is None:\n    return []\n\n  # Convert workshop index to the actual name of the workshop\n  workshop_name = env.world.cookbook.index.get(workshop_index)\n  \n  # Find the position of the nearest workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(workshop_positions) == 0:\n    return []\n  \n  # Select the closest workshop (for simplicity, we take the first one found)\n  target_workshop_pos = tuple(workshop_positions[0])\n\n  # Navigate to the selected workshop\n  actions.extend(navigate(env._current_state, target_workshop_pos))\n  \n  # Turn towards the workshop if not already facing it\n  current_direction = env._current_state.dir\n  direction_to_workshop = get_direction(env._current_state.pos, target_workshop_pos)\n  if current_direction != direction_to_workshop:\n    actions.append(direction_to_workshop)\n\n  # Use the USE action to craft the item at the workshop\n  actions.append(4)  # Assuming 4 is the index for the USE action\n  \n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T03:41:16.088102", "function_name": "craft", "function_body": "  def has_all_primitives(required_primitives, inventory_dict):\n    return all(primitive in inventory_dict and inventory_dict[primitive] >= required_primitives[primitive] for primitive in required_primitives)\n\n  actions = []\n\n  # Get the index of the goal item\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n\n  # If not all primitives are available return empty action list\n  if not has_all_primitives(required_primitives, inventory_dict):\n    return []\n\n  # Find the workshop where we can craft this item and its position\n  workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n      workshop_index = recipe.get(\"_at\")\n      break\n\n  if workshop_index is None:\n    return []\n\n  # Find the positions of all workshops with the same index\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(workshop_positions) == 0:\n    return []\n\n  # Select the closest workshop\n  current_pos = env._current_state.pos\n  target_workshop_pos = min(workshop_positions, key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1]))\n\n  # Navigate to the selected workshop\n  actions.extend(navigate(env._current_state, target_workshop_pos))\n\n  # Turn towards the workshop if not already facing it\n  current_direction = env._current_state.dir\n  direction_to_workshop = get_direction(current_pos, target_workshop_pos)\n  if current_direction != direction_to_workshop:\n    actions.append(direction_to_workshop)\n\n  # Use the USE action to craft the item at the workshop\n  actions.append(4)  # Assuming 4 is the index for the USE action\n\n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T03:42:48.523641", "function_name": "craft", "function_body": "  def has_all_primitives(required_primitives, inventory_dict):\n    return all(primitive in inventory_dict and inventory_dict[primitive] >= required_primitives[primitive] for primitive in required_primitives)\n\n  actions = []\n\n  # Get the index of the goal item\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n\n  # If not all primitives are available return empty action list\n  if not has_all_primitives(required_primitives, inventory_dict):\n    return []\n\n  # Find the workshop where we can craft this item\n  workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n      workshop_index = recipe.get(\"_at\")\n      break\n\n  if workshop_index is None:\n    return []\n\n  # Convert workshop index to the actual name of the workshop\n  workshop_name = env.world.cookbook.index.get(workshop_index)\n\n  # Find the position of the nearest workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(workshop_positions) == 0:\n    return []\n\n  # Select the closest workshop (for simplicity, we take the first one found)\n  target_workshop_pos = tuple(workshop_positions[0])\n\n  # Navigate to the selected workshop\n  actions.extend(navigate(env._current_state, target_workshop_pos))\n\n  # Turn towards the workshop if not already facing it\n  current_direction = env._current_state.dir\n  direction_to_workshop = get_direction(env._current_state.pos, target_workshop_pos)\n  if current_direction != direction_to_workshop:\n    actions.append(direction_to_workshop)\n\n  # Use the USE action to craft the item at the workshop\n  actions.append(4)  # Assuming 4 is the index for the USE action\n\n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T03:42:49.555661", "function_name": "craft", "function_body": "  def has_all_primitives(required_primitives, inventory_dict):\n    return all(primitive in inventory_dict and inventory_dict[primitive] >= required_primitives[primitive] for primitive in required_primitives)\n\n  actions = []\n  \n  # Get the index of the goal item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  # If not all primitives are available return empty action list\n  if not has_all_primitives(required_primitives, inventory_dict):\n    return []\n  \n  # Find the workshop where we can craft this item\n  workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n      workshop_index = recipe.get(\"_at\")\n      break\n  \n  if workshop_index is None:\n    return []\n\n  # Convert workshop index to the actual name of the workshop\n  workshop_name = env.world.cookbook.index.get(workshop_index)\n  \n  # Find the position of the nearest workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(workshop_positions) == 0:\n    return []\n  \n  # Select the closest workshop (for simplicity, we take the first one found)\n  target_workshop_pos = tuple(min(workshop_positions, key=lambda x: np.linalg.norm(np.array(x) - np.array(env._current_state.pos))))\n  \n  # Navigate to the selected workshop\n  actions.extend(navigate(env._current_state, target_workshop_pos))\n  \n  # Turn towards the workshop if not already facing it\n  current_direction = env._current_state.dir\n  direction_to_workshop = get_direction(env._current_state.pos, target_workshop_pos)\n  if current_direction != direction_to_workshop:\n    actions.append(direction_to_workshop)\n\n  # Use the USE action to craft the item at the workshop\n  actions.append(4)  # Assuming 4 is the index for the USE action\n  \n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T03:44:51.807822", "function_name": "craft", "function_body": "  def find_item_positions(env, target_index):\n    grid = env._current_state.grid\n    return np.argwhere(grid[:, :, target_index] > 0).tolist()\n\n  def navigate_to_position_bfs(env, start_pos, target_pos):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n      queue = collections.deque([(start_pos, [])])\n      visited = set([start_pos])\n\n      while queue:\n          pos, path = queue.popleft()\n          if pos == tuple(target_pos):\n              return path\n\n          for dx, dy in directions:\n              new_pos = (pos[0] + dx, pos[1] + dy)\n              if 0 <= new_pos[0] < env._current_state.grid.shape[0] and\\\n                 0 <= new_pos[1] < env._current_state.grid.shape[1]:\n                  if new_pos not in visited:\n                      visited.add(new_pos)\n                      queue.append((new_pos, path + [directions.index((dx, dy))]))\n\n      return []  # No path found\n\n  def collect_primitives_bfs(env, required_items):\n    actions = []\n    for req_item_index, count in required_items.items():\n        while env._current_state.inventory[req_item_index] < count:\n            item_positions = find_item_positions(env, req_item_index)\n            \n            if not item_positions:\n                raise ValueError(f\"No available {env.world.cookbook.get(req_item_index)} to collect.\")\n            \n            # Find the closest item\n            start_pos = env._current_state.pos\n            closest_path = None\n            for pos in item_positions:\n                path = navigate_to_position_bfs(env, start_pos, tuple(pos))\n                if not closest_path or len(path) < len(closest_path):\n                    closest_path = path\n\n            actions.extend(closest_path)\n            \n            # Check if the agent is next to an item\n            if env._current_state.next_to(req_item_index):\n                actions.append(env.world.N_ACTIONS - 1)  # USE action\n            \n            if env._current_state.inventory[req_item_index] >= count:\n                break\n\n    return actions\n\n  def find_workshop_position(env, workshop_index):\n      positions = find_item_positions(env, workshop_index)\n      if not positions:\n          raise ValueError(f\"No available {env.world.cookbook.get(workshop_index)} to collect.\")\n      return positions[0]\n\n  def ensure_facing_workshop(env, workshop_pos):\n      current_dir = env._current_state.dir\n      target_direction = (workshop_pos[0] - env._current_state.pos[0], workshop_pos[1] - env._current_state.pos[1])\n\n      if target_direction == (-1, 0):\n          return [(env.world.N_ACTIONS - 4)]  # UP action\n      elif target_direction == (1, 0):\n          return [(env.world.N_ACTIONS - 3)]  # DOWN action\n      elif target_direction == (0, -1):\n          return [(env.world.N_ACTIONS - 2)]  # LEFT action\n      elif target_direction == (0, 1):\n          return [(env.world.N_ACTIONS - 5)]  # RIGHT action\n      else:\n          return []  # No direction change needed\n\n  item_index = env.world.cookbook.index[item]\n  \n  if item_index in env.world.grabbable_indices:\n      return []  # Primitives cannot be crafted\n  \n  recipe = env.world.cookbook.recipes[item_index]\n\n  workshop_key = \"_at\"\n  workshop_name = recipe.get(workshop_key)\n  if workshop_name is None:\n      raise ValueError(f\"No workshop specified for crafting {item}.\")\n  \n  workshop_index = env.world.cookbook.index[workshop_name]\n  workshop_pos = find_workshop_position(env, workshop_index)\n\n  required_items = {env.world.cookbook.index[key]: value for key, value in recipe.items() if not isinstance(key, str) or not key.startswith('_at')}\n\n  actions = []\n\n  # Collect all required items\n  actions.extend(collect_primitives_bfs(env, required_items))\n\n  # Navigate to the workshop and ensure correct facing direction\n  actions.extend(navigate_to_position_bfs(env, env._current_state.pos, workshop_pos))\n  actions.extend(ensure_facing_workshop(env, workshop_pos))\n  \n  # Use the workshop to craft the item\n  actions.append(env.world.N_ACTIONS - 1)  # USE action\n\n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T03:44:52.861631", "function_name": "craft", "function_body": "  def find_item_positions(env, target_index):\n    grid = env._current_state.grid\n    return np.argwhere(grid[:, :, target_index] > 0).tolist()\n\n  def navigate_to_position(env, target_pos):\n    directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n    current_pos = env._current_state.pos\n    queue = collections.deque([(current_pos, [])])\n    visited = set([current_pos])\n\n    while queue:\n        pos, path = queue.popleft()\n        if pos == tuple(target_pos):\n            return path\n        \n        for dx, dy in directions:\n            new_pos = (pos[0] + dx, pos[1] + dy)\n            if 0 <= new_pos[0] < env._current_state.grid.shape[0] and\\\n               0 <= new_pos[1] < env._current_state.grid.shape[1]:\n                if new_pos not in visited:\n                    visited.add(new_pos)\n                    queue.append((new_pos, path + [directions.index((dx, dy))]))\n\n    return []  # No path found\n\n  def find_workshop_position(env, workshop_index):\n    positions = find_item_positions(env, workshop_index)\n    if not positions:\n      raise ValueError(f\"No available {env.world.cookbook.get(workshop_index)} to collect.\")\n    return positions[0]\n\n  def collect_primitives(env, required_items):\n    actions = []\n    for req_item_index, count in required_items.items():\n      while env._current_state.inventory[req_item_index] < count:\n        item_positions = find_item_positions(env, req_item_index)\n        \n        if not item_positions:\n          raise ValueError(f\"No available {env.world.cookbook.get(req_item_index)} to collect.\")\n        \n        for pos in item_positions:\n          actions.extend(navigate_to_position(env, pos))\n          \n          # Check if the agent is next to an item\n          if env._current_state.next_to(req_item_index):\n            actions.append(env.world.N_ACTIONS - 1)  # USE action\n          \n          if env._current_state.inventory[req_item_index] >= count:\n            break\n\n    return actions\n  \n  def ensure_facing_workshop(env, workshop_pos):\n    current_dir = env._current_state.dir\n    target_direction = (workshop_pos[0] - env._current_state.pos[0], workshop_pos[1] - env._current_state.pos[1])\n\n    # Determine the direction index based on the difference in coordinates\n    if target_direction == (-1, 0):\n        return [(env.world.N_ACTIONS - 4)]  # UP action\n    elif target_direction == (1, 0):\n        return [(env.world.N_ACTIONS - 3)]  # DOWN action\n    elif target_direction == (0, -1):\n        return [(env.world.N_ACTIONS - 2)]  # LEFT action\n    elif target_direction == (0, 1):\n        return [(env.world.N_ACTIONS - 5)]  # RIGHT action\n    else:\n        return []  # No direction change needed\n\n  item_index = env.world.cookbook.index[item]\n  \n  if item_index in env.world.grabbable_indices:\n    return []  # Primitives cannot be crafted\n  \n  recipe = env.world.cookbook.recipes[item_index]\n\n  workshop_key = \"_at\"\n  workshop_name = recipe.get(workshop_key)\n  if workshop_name is None:\n    raise ValueError(f\"No workshop specified for crafting {item}.\")\n  \n  workshop_index = env.world.cookbook.index[workshop_name]\n  workshop_pos = find_workshop_position(env, workshop_index)\n\n  required_items = {env.world.cookbook.index[key]: value for key, value in recipe.items() if not isinstance(key, str) or not key.startswith('_at')}\n\n  actions = []\n\n  # Collect all required items\n  actions.extend(collect_primitives(env, required_items))\n\n  # Navigate to the workshop and ensure correct facing direction\n  actions.extend(navigate_to_position(env, workshop_pos))\n  actions.extend(ensure_facing_workshop(env, workshop_pos))\n  \n  # Use the workshop to craft the item\n  actions.append(env.world.N_ACTIONS - 1)  # USE action\n  \n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T03:46:52.535541", "function_name": "craft", "function_body": "  def get_turn_actions(current_dir: int, target_dir: int) -> list[int]:\n    \"\"\"Calculates the sequence of turn actions to change from current direction to target direction.\"\"\"\n    # Assuming directions are encoded as follows:\n    # UP = 0, RIGHT = 1, DOWN = 2, LEFT = 3\n    turn_actions = []\n    if (current_dir + 1) % 4 == target_dir:\n      turn_actions.append(6)  # Turn right\n    elif (current_dir - 1) % 4 == target_dir:\n      turn_actions.append(5)  # Turn left\n    else:\n      turn_actions.extend([5, 5])  # Turn around\n    return turn_actions\n\n  actions = []\n  \n  # Get the index for the goal item\n  goal_index = env.world.cookbook.index[item]\n\n  # Get the primitives required to make the goal item\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  \n  # Check if we have all the required primitives in inventory\n  for prim, count in required_primitives.items():\n    if env._current_state.inventory[prim] < count:\n      return []  # Return empty list if any primitive is not sufficient\n\n  # Identify the workshop where crafting should occur\n  for recipe_output, ingredients in env.world.cookbook.recipes.items():\n    if recipe_output == goal_index and \"_key\" in ingredients:\n      workshop_key = ingredients[\"_key\"]\n      break\n  else:\n    return []  # No valid workshop found\n  \n  # Find the index of the workshop\n  workshop_index = env.world.cookbook.index[workshop_key]\n\n  # Locate the workshop on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n    return []  # Workshop not found on the grid\n\n  # Navigate to the nearest workshop\n  agent_pos = env._current_state.pos\n  closest_workshop = min(workshop_positions, key=lambda x: np.linalg.norm(np.array(x) - np.array(agent_pos)))\n\n  # Calculate path to the nearest workshop using BFS (Breadth-First Search)\n  def bfs_path(start, goal):\n    queue = collections.deque([(start, [])])\n    visited = set([start])\n\n    while queue:\n      (x, y), path = queue.popleft()\n      \n      if (x, y) == goal:\n        return path\n      \n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n          if (nx, ny) not in visited and env._current_state.grid[nx, ny, 0] == 0:  # Assuming 0 represents walkable space\n            queue.append(((nx, ny), path + [(dx, dy)]))\n            visited.add((nx, ny))\n\n    return []\n\n  path = bfs_path(agent_pos, closest_workshop)\n  \n  if not path:\n    return []  # No valid path found\n\n  for dx, dy in path:\n    direction = None\n    if dx > 0:\n      direction = 3  # RIGHT\n    elif dx < 0:\n      direction = 2  # LEFT\n    elif dy > 0:\n      direction = 4  # DOWN\n    elif dy < 0:\n      direction = 1  # UP\n    \n    actions.append(direction)\n    agent_pos = (agent_pos[0] + dx, agent_pos[1] + dy)\n\n  # Check if the agent is already facing the correct direction to use the workshop\n  current_direction = env._current_state.agent_dir  # Assuming this attribute exists\n\n  target_direction = None\n  if closest_workshop[0] == agent_pos[0]:\n    if closest_workshop[1] > agent_pos[1]:\n      target_direction = 4  # DOWN\n    else:\n      target_direction = 1  # UP\n  elif closest_workshop[1] == agent_pos[1]:\n    if closest_workshop[0] > agent_pos[0]:\n      target_direction = 3  # RIGHT\n    else:\n      target_direction = 2  # LEFT\n  \n  if current_direction != target_direction:\n    actions.extend(get_turn_actions(current_direction, target_direction))\n  \n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T03:46:53.647695", "function_name": "craft", "function_body": "  def get_turn_actions(current_dir: int, target_dir: int) -> list[int]:\n    \"\"\"Calculates the sequence of turn actions to change from current direction to target direction.\"\"\"\n    # Assuming directions are encoded as follows:\n    # UP = 0, RIGHT = 1, DOWN = 2, LEFT = 3\n    turn_actions = []\n    if (current_dir + 1) % 4 == target_dir:\n      turn_actions.append(6)  # Turn right\n    elif (current_dir - 1) % 4 == target_dir:\n      turn_actions.append(5)  # Turn left\n    else:\n      turn_actions.extend([5, 5])  # Turn around\n    return turn_actions\n\n  def calculate_direction(current_pos: tuple, target_pos: tuple) -> int:\n    \"\"\"Calculates the direction to move from current position to target position.\"\"\"\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n    \n    if abs(dx) > abs(dy):\n      return 3 if dx > 0 else 2  # RIGHT or LEFT\n    else:\n      return 4 if dy > 0 else 1  # DOWN or UP\n\n  def is_next_to_workshop(current_pos: tuple, workshop_positions: np.ndarray) -> bool:\n    \"\"\"Checks if the agent is next to any of the workshops.\"\"\"\n    for pos in workshop_positions:\n        if np.linalg.norm(np.array(pos) - np.array(current_pos)) == 1:\n            return True\n    return False\n\n  actions = []\n  \n  # Get the index for the goal item\n  goal_index = env.world.cookbook.index[item]\n\n  # Get the primitives required to make the goal item\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  \n  # Check if we have all the required primitives in inventory\n  for prim, count in required_primitives.items():\n    if env._current_state.inventory[prim] < count:\n      return []  # Return empty list if any primitive is not sufficient\n\n  # Identify the workshop where crafting should occur\n  for recipe_output, ingredients in env.world.cookbook.recipes.items():\n    if recipe_output == goal_index and \"_key\" in ingredients:\n      workshop_key = ingredients[\"_key\"]\n      break\n  else:\n    return []  # No valid workshop found\n  \n  # Find the index of the workshop\n  workshop_index = env.world.cookbook.index[workshop_key]\n\n  # Locate the workshop on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n    return []  # Workshop not found on the grid\n\n  # Navigate to the nearest workshop\n  agent_pos = env._current_state.pos\n  closest_workshop = min(workshop_positions, key=lambda x: np.linalg.norm(np.array(x) - np.array(agent_pos)))\n\n  while not is_next_to_workshop(agent_pos, workshop_positions):\n    target_direction = calculate_direction(agent_pos, closest_workshop)\n    \n    # Turn towards the target direction if necessary\n    current_direction = env._current_state.agent_dir\n    turn_actions = get_turn_actions(current_direction, target_direction)\n    actions.extend(turn_actions)\n    \n    # Move in the target direction\n    actions.append(target_direction)\n    \n    # Update agent position and direction\n    dx, dy = 0, 0\n    if target_direction == 3:\n      dx += 1\n    elif target_direction == 2:\n      dx -= 1\n    elif target_direction == 4:\n      dy += 1\n    elif target_direction == 1:\n      dy -= 1\n    \n    agent_pos = (agent_pos[0] + dx, agent_pos[1] + dy)\n\n  # Assuming the agent is facing the correct direction to use the workshop\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T03:48:38.210263", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n\n  if not primitives_required:\n    return []\n\n  actions = []\n  \n  # Helper function to find a path to a specific type of block (primitive or workshop)\n  def find_path_to_block(i_kind):\n    pos = env._current_state.pos\n    grid = env._current_state.grid\n    directions = [(0,1), (1,0), (0,-1), (-1,0)]\n    \n    # Simple BFS to find the nearest block of type i_kind\n    queue = collections.deque([(pos, [])])\n    visited = set([pos])\n    while queue:\n      current_pos, path = queue.popleft()\n      x, y = current_pos\n      \n      if grid[x,y,i_kind] == 1:\n        return path\n      \n      for dx, dy in directions:\n        new_x, new_y = x + dx, y + dy\n        if (0 <= new_x < grid.shape[0]) and (0 <= new_y < grid.shape[1]) and (grid[new_x,new_y].sum() == 0) or ((new_x, new_y) in env.world.cookbook.workshop_positions):\n          visited.add((new_x, new_y))\n          queue.append(((new_x, new_y), path + [directions.index((dx, dy))]))\n    \n    return None\n  \n  # Collect all required primitives\n  for i_kind, count in primitives_required.items():\n    block_name = env.world.cookbook.index.get(i_kind)\n    if not block_name:\n      return []\n      \n    primitive_path = find_path_to_block(i_kind)\n    if not primitive_path:\n      return []\n\n    actions.extend(primitive_path) # Move to the required primitive\n\n    # Assume we pick up the item by facing it\n    pickup_action = 4  # Assuming USE is action index 4 for picking up items\n    actions.append(pickup_action)\n\n  # Now find and move to the correct workshop\n  recipe_info = env.world.cookbook.recipes[item_index]\n  if \"_at\" in recipe_info:\n    workshop_name = recipe_info[\"_at\"]\n    workshop_idx = env.world.cookbook.index[workshop_name]\n    \n    workshop_path = find_path_to_block(workshop_idx)\n    if not workshop_path:\n      return []\n\n    actions.extend(workshop_path) # Move to the required workshop\n\n    # Assume we craft the item by facing it\n    crafting_action = 4  # Assuming USE is action index 4 for crafting items\n    actions.append(crafting_action)\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-11T03:48:39.258917", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n\n  if not primitives_required:\n    return []\n\n  actions = []\n  \n  # Helper function to find a path to a specific type of block (primitive or workshop)\n  def find_path_to_block(i_kind, facing_dir=None):\n    pos = env._current_state.pos\n    grid = env._current_state.grid\n    directions = [(0,1), (1,0), (0,-1), (-1,0)]\n    \n    # Simple BFS to find the nearest block of type i_kind\n    queue = collections.deque([(pos, [], facing_dir)])\n    visited = set([pos])\n    while queue:\n      current_pos, path, dir_ = queue.popleft()\n      x, y = current_pos\n      \n      if grid[x,y,i_kind] == 1:\n        # Check if the agent is already facing the correct direction\n        if facing_dir is None or (dir_ is not None and dir_ % 2 == facing_dir % 2):\n          return path, dir_\n      \n      for dx, dy in directions:\n        new_x, new_y = x + dx, y + dy\n        new_facing_dir = directions.index((dx, dy))\n        \n        if (0 <= new_x < grid.shape[0]) and (0 <= new_y < grid.shape[1]) and (grid[new_x,new_y].sum() == 0) and ((new_x, new_y) not in visited):\n          visited.add((new_x, new_y))\n          queue.append(((new_x, new_y), path + [directions.index((dx, dy))], new_facing_dir))\n    \n    return None, None\n  \n  # Helper function to rotate the agent to face the correct direction\n  def rotate_to_face(dir_):\n    current_dir = env._current_state.dir\n    diff = (dir_ - current_dir) % 4\n    \n    if diff == 1:\n      actions.append(3)  # RIGHT\n    elif diff == 2:\n      actions.extend([3, 3])  # RIGHT, RIGHT or LEFT, LEFT\n    elif diff == 3:\n      actions.append(2)  # LEFT\n\n  # Collect all required primitives\n  for i_kind, count in primitives_required.items():\n    block_name = env.world.cookbook.index.get(i_kind)\n    if not block_name:\n      return []\n      \n    primitive_path, facing_dir = find_path_to_block(i_kind)\n    if not primitive_path:\n      return []\n\n    actions.extend(primitive_path) # Move to the required primitive\n\n    rotate_to_face(facing_dir)\n\n    pickup_action = 4  # Assuming USE is action index 4 for picking up items\n    actions.append(pickup_action)\n\n  # Now find and move to the correct workshop\n  recipe_info = env.world.cookbook.recipes[item_index]\n  if \"_at\" in recipe_info:\n    workshop_name = recipe_info[\"_at\"]\n    workshop_idx = env.world.cookbook.index[workshop_name]\n    \n    workshop_path, facing_dir = find_path_to_block(workshop_idx)\n    if not workshop_path:\n      return []\n\n    actions.extend(workshop_path) # Move to the required workshop\n\n    rotate_to_face(facing_dir)\n\n    crafting_action = 4  # Assuming USE is action index 4 for crafting items\n    actions.append(crafting_action)\n\n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T03:51:27.099159", "function_name": "craft", "function_body": "  def has_all_primitives(required_primitives, inventory_dict):\n    return all(primitive in inventory_dict and inventory_dict[primitive] >= required_primitives[primitive] for primitive in required_primitives)\n\n  def get_closest_workshop(grid, workshop_index, pos):\n    workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n    if len(workshop_positions) == 0:\n      return None\n    # Calculate the Manhattan distance to each workshop and choose the closest one\n    distances = [abs(pos[0] - wp[0]) + abs(pos[1] - wp[1]) for wp in workshop_positions]\n    closest_index = np.argmin(distances)\n    return tuple(workshop_positions[closest_index])\n\n  def navigate(state, target_pos):\n    actions = []\n    current_pos = state.pos\n    while current_pos != target_pos:\n      if current_pos[0] < target_pos[0]:\n        actions.append(3)  # RIGHT\n        current_pos = (current_pos[0] + 1, current_pos[1])\n      elif current_pos[0] > target_pos[0]:\n        actions.append(2)  # LEFT\n        current_pos = (current_pos[0] - 1, current_pos[1])\n      if current_pos[1] < target_pos[1]:\n        actions.append(0)  # UP\n        current_pos = (current_pos[0], current_pos[1] + 1)\n      elif current_pos[1] > target_pos[1]:\n        actions.append(1)  # DOWN\n        current_pos = (current_pos[0], current_pos[1] - 1)\n    return actions\n\n  def get_direction(current_pos, target_workshop_pos):\n    if current_pos[0] < target_workshop_pos[0]:\n      return 3  # RIGHT\n    elif current_pos[0] > target_workshop_pos[0]:\n      return 2  # LEFT\n    elif current_pos[1] < target_workshop_pos[1]:\n      return 0  # UP\n    else:\n      return 1  # DOWN\n\n  actions = []\n  \n  # Get the index of the goal item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  # If not all primitives are available return empty action list\n  if not has_all_primitives(required_primitives, inventory_dict):\n    return []\n  \n  # Find the workshop where we can craft this item\n  workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n    if item_index == recipe.get(\"_key\"):\n      workshop_index = recipe.get(\"_at\")\n      break\n  \n  if workshop_index is None:\n    return []\n\n  # Get the closest workshop position\n  target_workshop_pos = get_closest_workshop(env._current_state.grid, workshop_index, env._current_state.pos)\n  if target_workshop_pos is None:\n    return []\n  \n  # Navigate to the selected workshop\n  actions.extend(navigate(env._current_state, target_workshop_pos))\n  \n  # Turn towards the workshop if not already facing it\n  current_direction = env._current_state.dir\n  direction_to_workshop = get_direction(env._current_state.pos, target_workshop_pos)\n  if current_direction != direction_to_workshop:\n    actions.append(direction_to_workshop)\n\n  # Use the USE action to craft the item at the workshop\n  actions.append(4)  # Assuming 4 is the index for the USE action\n  \n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T03:51:28.147661", "function_name": "craft", "function_body": "  def has_all_primitives(required_primitives, inventory_dict):\n    return all(primitive in inventory_dict and inventory_dict[primitive] >= required_primitives[primitive] for primitive in required_primitives)\n\n  def get_closest_workshop(grid, workshop_index, pos):\n    workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n    if len(workshop_positions) == 0:\n      return None\n    # Calculate the Manhattan distance to each workshop and choose the closest one\n    distances = [abs(pos[0] - wp[0]) + abs(pos[1] - wp[1]) for wp in workshop_positions]\n    closest_index = np.argmin(distances)\n    return tuple(workshop_positions[closest_index])\n\n  def navigate(state, target_pos):\n    actions = []\n    current_pos = state.pos\n    while current_pos != target_pos:\n      if current_pos[0] < target_pos[0]:\n        actions.append(3)  # RIGHT\n        current_pos = (current_pos[0] + 1, current_pos[1])\n      elif current_pos[0] > target_pos[0]:\n        actions.append(2)  # LEFT\n        current_pos = (current_pos[0] - 1, current_pos[1])\n      if current_pos[1] < target_pos[1]:\n        actions.append(0)  # UP\n        current_pos = (current_pos[0], current_pos[1] + 1)\n      elif current_pos[1] > target_pos[1]:\n        actions.append(1)  # DOWN\n        current_pos = (current_pos[0], current_pos[1] - 1)\n    return actions\n\n  def get_direction(current_pos, target_workshop_pos):\n    if current_pos[0] < target_workshop_pos[0]:\n      return 3  # RIGHT\n    elif current_pos[0] > target_workshop_pos[0]:\n      return 2  # LEFT\n    elif current_pos[1] < target_workshop_pos[1]:\n      return 0  # UP\n    else:\n      return 1  # DOWN\n\n  def update_state(state, action):\n    new_state = state._replace(dir=action) if action in [0, 1, 2, 3] else state\n    if action == 4:  # USE action\n      new_inventory = np.copy(state.inventory)\n      item_index = env.world.cookbook.index[item]\n      required_primitives = env.world.cookbook.primitives_for(item_index)\n      for primitive in required_primitives:\n        index = env.world.cookbook.index[primitive]\n        new_inventory[index] -= required_primitives[primitive]\n      new_inventory[item_index] += 1\n      new_state = state._replace(inventory=new_inventory)\n    return new_state\n\n  actions = []\n  \n  # Get the index of the goal item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  # If not all primitives are available return empty action list\n  if not has_all_primitives(required_primitives, inventory_dict):\n    return []\n  \n  # Find the workshop where we can craft this item\n  workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n    if item_index == recipe.get(\"_key\"):\n      workshop_index = recipe.get(\"_at\")\n      break\n  \n  if workshop_index is None:\n    return []\n\n  # Get the closest workshop position\n  target_workshop_pos = get_closest_workshop(env._current_state.grid, workshop_index, env._current_state.pos)\n  if target_workshop_pos is None:\n    return []\n  \n  # Navigate to the selected workshop\n  actions.extend(navigate(env._current_state, target_workshop_pos))\n  \n  # Turn towards the workshop if not already facing it\n  current_direction = env._current_state.dir\n  direction_to_workshop = get_direction(env._current_state.pos, target_workshop_pos)\n  if current_direction != direction_to_workshop:\n    actions.append(direction_to_workshop)\n\n  # Use the USE action to craft the item at the workshop\n  actions.append(4)  # Assuming 4 is the index for the USE action\n  \n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T03:54:27.366869", "function_name": "craft", "function_body": "  def find_item_positions(env, target_index):\n    grid = env._current_state.grid\n    return np.argwhere(grid[:, :, target_index] > 0).tolist()\n\n  def navigate_to_position(env, target_pos):\n    start_pos = env._current_state.pos\n    directions = [(1, 0), (-1, 0), (0, 1), (0, -1)]\n    \n    # BFS to find shortest path\n    queue = collections.deque([(start_pos, [])])\n    visited = set([start_pos])\n\n    while queue:\n      current_pos, actions_taken = queue.popleft()\n      \n      if current_pos == tuple(target_pos):\n        return actions_taken\n      \n      for dx, dy in directions:\n          new_pos = (current_pos[0] + dx, current_pos[1] + dy)\n          \n          # Check bounds and non-blocked cells\n          if 0 <= new_pos[0] < env._current_state.grid.shape[0] and 0 <= new_pos[1] < env._current_state.grid.shape[1]:\n              grid_cell = env._current_state.grid[new_pos]\n              blocked = any(grid_cell[i_kind] > 0 for i_kind in env.world.cookbook.index if i_kind not in env.world.grabbable_indices)\n              \n              if new_pos not in visited and not blocked:\n                  visited.add(new_pos)\n                  # Determine the action based on the direction\n                  if dx == -1:\n                      actions_taken.append(env.world.N_ACTIONS - 4)  # UP action\n                  elif dx == 1:\n                      actions_taken.append(env.world.N_ACTIONS - 3)  # DOWN action\n                  elif dy == -1:\n                      actions_taken.append(env.world.N_ACTIONS - 2)  # LEFT action\n                  elif dy == 1:\n                      actions_taken.append(env.world.N_ACTIONS - 5)  # RIGHT action\n                  queue.append((new_pos, actions_taken + [env.world.N_ACTIONS - 4]))\n    return []\n\n  def find_workshop_position(env, workshop_index):\n    positions = find_item_positions(env, workshop_index)\n    if not positions:\n      raise ValueError(f\"No available {env.world.cookbook.get(workshop_index)} to collect.\")\n    return positions[0]\n\n  def collect_primitives(env, required_items):\n    actions = []\n    for req_item_index, count in required_items.items():\n      while env._current_state.inventory[req_item_index] < count:\n        item_positions = find_item_positions(env, req_item_index)\n        \n        if not item_positions:\n          raise ValueError(f\"No available {env.world.cookbook.get(req_item_index)} to collect.\")\n        \n        # Navigate and collect each item\n        for pos in item_positions:\n          actions.extend(navigate_to_position(env, pos))\n          \n          # Check if the agent is next to an item\n          if env._current_state.next_to(req_item_index):\n            actions.append(env.world.N_ACTIONS - 1)  # USE action\n          \n          if env._current_state.inventory[req_item_index] >= count:\n            break\n\n    return actions\n\n  def determine_workshop_and_recipe(env, item_index):\n      recipe = env.world.cookbook.recipes[item_index]\n      \n      # Determine the workshop required for crafting\n      workshop_key = \"_at\"\n      workshop_name = recipe.get(workshop_key)\n      if workshop_name is None:\n          raise ValueError(f\"No workshop specified for crafting {item}.\")\n      \n      workshop_index = env.world.cookbook.index[workshop_name]\n      return workshop_index, recipe\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the goal item is a primitive or not in the recipes\n  if item_index in env.world.grabbable_indices:\n    return []  # Primitives cannot be crafted\n  \n  workshop_index, recipe = determine_workshop_and_recipe(env, item_index)\n\n  required_items = {env.world.cookbook.index[key]: value for key, value in recipe.items() if not isinstance(key, str) or not key.startswith('_at')}\n\n  actions = []\n\n  # Collect all required items\n  actions.extend(collect_primitives(env, required_items))\n\n  # Navigate to the workshop and use it to craft the item\n  workshop_pos = find_workshop_position(env, workshop_index)\n  actions.extend(navigate_to_position(env, workshop_pos))\n  \n  if env._current_state.next_to(workshop_index):\n    actions.append(env.world.N_ACTIONS - 1)  # USE action\n  \n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T03:54:28.440592", "function_name": "craft", "function_body": "  def find_item_positions(env, target_index):\n    \"\"\"Finds all positions of the target index in the grid.\"\"\"\n    grid = env._current_state.grid\n    return np.argwhere(grid[:, :, target_index] > 0).tolist()\n\n  def navigate_to_position(env, target_pos):\n    \"\"\"Navigates to a specific position on the grid using BFS algorithm for optimal path finding.\"\"\"\n    start_pos = env._current_state.pos\n    directions = [(1, 0), (-1, 0), (0, 1), (0, -1)]\n    \n    # BFS to find shortest path\n    queue = collections.deque([(start_pos, [])])\n    visited = set([start_pos])\n\n    while queue:\n      current_pos, actions_taken = queue.popleft()\n      \n      if current_pos == tuple(target_pos):\n        return actions_taken\n      \n      for dx, dy in directions:\n          new_pos = (current_pos[0] + dx, current_pos[1] + dy)\n          \n          # Check bounds and non-blocked cells\n          if 0 <= new_pos[0] < env._current_state.grid.shape[0] and 0 <= new_pos[1] < env._current_state.grid.shape[1]:\n              grid_cell = env._current_state.grid[new_pos]\n              blocked = any(grid_cell[i_kind] > 0 for i_kind in env.world.cookbook.index if i_kind not in env.world.grabbable_indices)\n              \n              if new_pos not in visited and not blocked:\n                  visited.add(new_pos)\n                  # Determine the action based on the direction\n                  action = None\n                  if dx == -1:\n                      action = env.world.N_ACTIONS - 4  # UP action\n                  elif dx == 1:\n                      action = env.world.N_ACTIONS - 3  # DOWN action\n                  elif dy == -1:\n                      action = env.world.N_ACTIONS - 2  # LEFT action\n                  elif dy == 1:\n                      action = env.world.N_ACTIONS - 5  # RIGHT action\n                  queue.append((new_pos, actions_taken + [action]))\n    return []\n\n  def find_workshop_position(env, workshop_index):\n    \"\"\"Finds the position of a workshop in the grid.\"\"\"\n    positions = find_item_positions(env, workshop_index)\n    if not positions:\n      raise ValueError(f\"No available {env.world.cookbook.get(workshop_index)} to collect.\")\n    return positions[0]\n\n  def collect_primitives(env, required_items):\n    \"\"\"Collects all required primitives or intermediate items.\"\"\"\n    actions = []\n    for req_item_index, count in required_items.items():\n      while env._current_state.inventory[req_item_index] < count:\n        item_positions = find_item_positions(env, req_item_index)\n        \n        if not item_positions:\n          raise ValueError(f\"No available {env.world.cookbook.get(req_item_index)} to collect.\")\n        \n        # Navigate and collect each item\n        for pos in item_positions:\n          actions.extend(navigate_to_position(env, pos))\n          \n          # Check if the agent is next to an item\n          if env._current_state.next_to(req_item_index):\n            actions.append(env.world.N_ACTIONS - 1)  # USE action\n          \n          if env._current_state.inventory[req_item_index] >= count:\n            break\n\n    return actions\n\n  def check_inventory(env, required_items):\n    \"\"\"Check if the agent already has all required items in the inventory.\"\"\"\n    for item_name, count in required_items.items():\n        if isinstance(item_name, str) and not item_name.startswith('_'):\n            index = env.world.cookbook.index[item_name]\n            if env._current_state.inventory[index] < count:\n                return False\n    return True\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the goal item is a primitive or not in the recipes\n  if item_index in env.world.grabbable_indices:\n    return []  # Primitives cannot be crafted\n  \n  # Retrieve the recipe for the desired item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Determine the workshop required for crafting\n  workshop_key = \"_at\"\n  workshop_name = recipe.get(workshop_key)\n  if workshop_name is None:\n    raise ValueError(f\"No workshop specified for crafting {item}.\")\n  \n  workshop_index = env.world.cookbook.index[workshop_name]\n  workshop_pos = find_workshop_position(env, workshop_index)\n\n  # Determine the list of required primitives or intermediate items\n  required_items = {env.world.cookbook.index[key]: value for key, value in recipe.items() if not isinstance(key, str) or not key.startswith('_at')}\n\n  actions = []\n\n  # Check if we already have all the required items\n  if not check_inventory(env, required_items):\n      # Collect all required primitives or intermediate items\n      actions.extend(collect_primitives(env, required_items))\n  \n  # Navigate to the workshop and use it to craft the item\n  actions.extend(navigate_to_position(env, workshop_pos))\n  if env._current_state.next_to(workshop_index):\n    actions.append(env.world.N_ACTIONS - 1)  # USE action\n  \n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T03:56:53.000595", "function_name": "craft", "function_body": "  def get_direction(current_pos, target_pos):\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    if abs(dx) > abs(dy):\n      return (3 if dx > 0 else 2)  # RIGHT or LEFT\n    else:\n      return (1 if dy > 0 else 0)  # UP or DOWN\n\n  def navigate(state, target_pos):\n    path = []\n    current_pos = state.pos\n\n    while current_pos != target_pos:\n      direction = get_direction(current_pos, target_pos)\n\n      if direction == 0:  # DOWN\n        path.append(0)\n        current_pos = (current_pos[0], current_pos[1] - 1)\n      elif direction == 1:  # UP\n        path.append(1)\n        current_pos = (current_pos[0], current_pos[1] + 1)\n      elif direction == 2:  # LEFT\n        path.append(2)\n        current_pos = (current_pos[0] - 1, current_pos[1])\n      elif direction == 3:  # RIGHT\n        path.append(3)\n        current_pos = (current_pos[0] + 1, current_pos[1])\n\n    return path\n\n  def turn_towards(state, target_direction):\n    current_direction = state.dir\n    if target_direction != current_direction:\n      return [target_direction]\n    return []\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n\n  # If not all primitives are available return empty action list\n  if not all(primitive in inventory_dict and inventory_dict[primitive] >= required_primitives[primitive] for primitive in required_primitives):\n    return []\n\n  # Find the workshop where we can craft this item\n  workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n      workshop_index = recipe.get(\"_at\")\n      break\n\n  if workshop_index is None:\n    return []\n\n  # Convert workshop index to the actual name of the workshop\n  workshop_name = env.world.cookbook.index.get(workshop_index)\n\n  # Find the position of the nearest workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(workshop_positions) == 0:\n    return []\n\n  # Select the closest workshop (for simplicity, we take the first one found)\n  target_workshop_pos = tuple(workshop_positions[0])\n\n  # Navigate to the selected workshop\n  actions = navigate(env._current_state, target_workshop_pos)\n\n  # Turn towards the workshop if not already facing it\n  direction_to_workshop = get_direction(env._current_state.pos, target_workshop_pos)\n  actions.extend(turn_towards(env._current_state, direction_to_workshop))\n\n  # Use the USE action to craft the item at the workshop\n  actions.append(4)  # Assuming 4 is the index for the USE action\n\n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T03:56:54.050449", "function_name": "craft", "function_body": "  def get_direction(current_pos, target_pos):\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n    \n    if dx > 0:\n      return 3  # RIGHT\n    elif dx < 0:\n      return 2  # LEFT\n    elif dy > 0:\n      return 1  # UP\n    elif dy < 0:\n      return 0  # DOWN\n\n  def navigate(state, target_pos):\n    \"\"\"Returns a list of actions to navigate from current position to target position.\"\"\"\n    path = []\n    current_pos = state.pos\n    \n    while current_pos != target_pos:\n      direction = get_direction(current_pos, target_pos)\n      \n      if direction == 0:  # DOWN\n        path.append(0)\n        current_pos = (current_pos[0], current_pos[1] - 1)\n      elif direction == 1:  # UP\n        path.append(1)\n        current_pos = (current_pos[0], current_pos[1] + 1)\n      elif direction == 2:  # LEFT\n        path.append(2)\n        current_pos = (current_pos[0] - 1, current_pos[1])\n      elif direction == 3:  # RIGHT\n        path.append(3)\n        current_pos = (current_pos[0] + 1, current_pos[1])\n    \n    return path\n\n  def turn_towards(state, target_direction):\n    \"\"\"Returns a list of actions to turn the agent towards the target direction.\"\"\"\n    current_direction = state.dir\n    if target_direction != current_direction:\n      return [target_direction]\n    return []\n\n  def has_all_primitives(required_primitives, inventory_dict):\n    \"\"\"Checks if all required primitives are available in the inventory.\"\"\"\n    for primitive in required_primitives:\n        if primitive not in inventory_dict or inventory_dict[primitive] < required_primitives[primitive]:\n            return False\n    return True\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  # If not all primitives are available return empty action list\n  if not has_all_primitives(required_primitives, inventory_dict):\n    return []\n  \n  # Find the workshop where we can craft this item\n  workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n      workshop_index = recipe.get(\"_at\")\n      break\n  \n  if workshop_index is None:\n    return []\n\n  # Convert workshop index to the actual name of the workshop\n  workshop_name = env.world.cookbook.index.get(workshop_index)\n  \n  # Find the position of the nearest workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(workshop_positions) == 0:\n    return []\n  \n  # Select the closest workshop (for simplicity, we take the first one found)\n  target_workshop_pos = tuple(workshop_positions[0])\n\n  # Navigate to the selected workshop\n  actions = navigate(env._current_state, target_workshop_pos)\n\n  # Turn towards the workshop if not already facing it\n  direction_to_workshop = get_direction(env._current_state.pos, target_workshop_pos)\n  actions.extend(turn_towards(env._current_state, direction_to_workshop))\n\n  # Use the USE action to craft the item at the workshop\n  actions.append(4)  # Assuming 4 is the index for the USE action\n  \n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T04:00:10.732749", "function_name": "craft", "function_body": "  def find_workshop_position(grid, workshop_name, cookbook_index):\n    \"\"\"Find the position of a specific workshop in the grid.\"\"\"\n    workshop_index = cookbook_index[workshop_name]\n    pos_list = np.argwhere(grid[:, :, workshop_index] > 0)\n    if len(pos_list) == 0:\n      raise ValueError(f\"No available {workshop_name} to navigate to.\")\n    return tuple(pos_list[0])\n\n  def find_item_positions(grid, target_indices):\n    \"\"\"Find all positions of specific items in the grid.\"\"\"\n    positions = []\n    for idx in target_indices:\n      pos_list = np.argwhere(grid[:, :, idx] > 0).tolist()\n      positions.extend(pos_list)\n    return positions\n\n  def navigate_to_position(env, target_pos):\n    \"\"\"Navigate to a given position on the grid.\"\"\"\n    actions = []\n    current_x, current_y = env._current_state.pos\n    target_x, target_y = target_pos\n    \n    # Calculate the direction to move\n    dx = target_x - current_x\n    dy = target_y - current_y\n    \n    if dy < 0:\n      actions.extend([env.world.N_ACTIONS - 5] * abs(dy))  # UP action\n    elif dy > 0:\n      actions.extend([env.world.N_ACTIONS - 4] * abs(dy))  # DOWN action\n    \n    if dx < 0:\n      actions.extend([env.world.N_ACTIONS - 6] * abs(dx))  # LEFT action\n    elif dx > 0:\n      actions.extend([env.world.N_ACTIONS - 3] * abs(dx))  # RIGHT action\n    \n    return actions\n\n  def ensure_correct_facing_direction(env, target_pos):\n    \"\"\"Ensure the agent is facing the correct direction before using the workshop.\"\"\"\n    actions = []\n    current_x, current_y = env._current_state.pos\n    target_x, target_y = target_pos\n    \n    if target_x > current_x:\n      actions.append(env.world.N_ACTIONS - 3)  # RIGHT action\n    elif target_x < current_x:\n      actions.append(env.world.N_ACTIONS - 6)  # LEFT action\n    elif target_y > current_y:\n      actions.append(env.world.N_ACTIONS - 4)  # DOWN action\n    elif target_y < current_y:\n      actions.append(env.world.N_ACTIONS - 5)  # UP action\n    \n    return actions\n\n  def collect_items(env, required_items):\n    \"\"\"Collect all required items to craft the item.\"\"\"\n    grid = env._current_state.grid\n    actions = []\n    \n    for req_item_index, count in required_items.items():\n      while env._current_state.inventory[req_item_index] < count:\n        item_positions = find_item_positions(grid, [req_item_index])\n        \n        if not item_positions:\n          raise ValueError(f\"No available {env.world.cookbook.get(req_item_index)} to collect.\")\n        \n        for pos in item_positions:\n          actions.extend(navigate_to_position(env, tuple(pos)))\n          \n          # Check if the agent is next to an item\n          if env._current_state.next_to(req_item_index):\n            actions.append(env.world.N_ACTIONS - 1)  # USE action\n          \n          if env._current_state.inventory[req_item_index] >= count:\n            break\n    \n    return actions\n\n  def navigate_and_use_workshop(env, workshop_pos):\n    \"\"\"Navigate to the workshop and use it.\"\"\"\n    actions = []\n    \n    actions.extend(navigate_to_position(env, workshop_pos))\n    actions.extend(ensure_correct_facing_direction(env, workshop_pos))\n    actions.append(env.world.N_ACTIONS - 1)  # USE action\n    \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the goal item is a primitive or not in the recipes\n  if item_index in env.world.grabbable_indices:\n    return []  # Primitives cannot be crafted\n  \n  # Retrieve the recipe for the desired item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Determine the workshop required for crafting\n  workshop_key = \"_at\"\n  workshop_name = recipe.get(workshop_key)\n  if workshop_name is None:\n    raise ValueError(f\"No workshop specified for crafting {item}.\")\n  \n  workshop_index = env.world.cookbook.index[workshop_name]\n  workshop_pos = find_workshop_position(env._current_state.grid, workshop_name, env.world.cookbook.index)\n\n  # Determine the list of required primitives or intermediate items\n  required_items = {env.world.cookbook.index[key]: value for key, value in recipe.items() if isinstance(key, str)}\n\n  actions = []\n\n  # Collect all required items\n  actions.extend(collect_items(env, required_items))\n\n  # Navigate to the workshop and use it to craft the item\n  actions.extend(navigate_and_use_workshop(env, workshop_pos))\n  \n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T04:00:11.822062", "function_name": "craft", "function_body": "  def find_workshop_position(grid, workshop_name, cookbook_index):\n    \"\"\"Find the position of a specific workshop in the grid.\"\"\"\n    workshop_index = cookbook_index[workshop_name]\n    pos_list = np.argwhere(grid[:, :, workshop_index] > 0)\n    if len(pos_list) == 0:\n      raise ValueError(f\"No available {workshop_name} to navigate to.\")\n    return tuple(pos_list[0])\n\n  def find_item_positions(grid, target_indices):\n    \"\"\"Find all positions of specific items in the grid.\"\"\"\n    positions = []\n    for idx in target_indices:\n      pos_list = np.argwhere(grid[:, :, idx] > 0).tolist()\n      positions.extend(pos_list)\n    return positions\n\n  def navigate_to_position(env, target_pos):\n    \"\"\"Navigate to a given position on the grid.\"\"\"\n    actions = []\n    current_x, current_y = env._current_state.pos\n    target_x, target_y = target_pos\n    \n    # Calculate the direction to move\n    dx = target_x - current_x\n    dy = target_y - current_y\n    \n    if dy < 0:\n      actions.extend([env.world.N_ACTIONS - 5] * abs(dy))  # UP action\n    elif dy > 0:\n      actions.extend([env.world.N_ACTIONS - 4] * abs(dy))  # DOWN action\n    \n    if dx < 0:\n      actions.extend([env.world.N_ACTIONS - 6] * abs(dx))  # LEFT action\n    elif dx > 0:\n      actions.extend([env.world.N_ACTIONS - 3] * abs(dx))  # RIGHT action\n    \n    return actions\n\n  def ensure_correct_facing_direction(env, target_pos):\n    \"\"\"Ensure the agent is facing the correct direction before using the workshop.\"\"\"\n    actions = []\n    current_x, current_y = env._current_state.pos\n    target_x, target_y = target_pos\n    \n    if target_x > current_x:\n      actions.append(env.world.N_ACTIONS - 3)  # RIGHT action\n    elif target_x < current_x:\n      actions.append(env.world.N_ACTIONS - 6)  # LEFT action\n    elif target_y > current_y:\n      actions.append(env.world.N_ACTIONS - 4)  # DOWN action\n    elif target_y < current_y:\n      actions.append(env.world.N_ACTIONS - 5)  # UP action\n    \n    return actions\n\n  def collect_primitives(env, required_items):\n    \"\"\"Collect all the primitives required for crafting.\"\"\"\n    actions = []\n    for req_item_index, count in required_items.items():\n      while env._current_state.inventory[req_item_index] < count:\n        item_positions = find_item_positions(env._current_state.grid, [req_item_index])\n        \n        if not item_positions:\n          raise ValueError(f\"No available {env.world.cookbook.get(req_item_index)} to collect.\")\n        \n        for pos in item_positions:\n          actions.extend(navigate_to_position(env, tuple(pos)))\n          \n          # Check if the agent is next to an item\n          if env._current_state.next_to(req_item_index):\n            actions.append(env.world.N_ACTIONS - 1)  # USE action\n          \n          if env._current_state.inventory[req_item_index] >= count:\n            break\n    return actions\n\n  def navigate_and_use_workshop(env, workshop_pos):\n    \"\"\"Navigate to the workshop and use it.\"\"\"\n    actions = []\n    actions.extend(navigate_to_position(env, workshop_pos))\n    actions.extend(ensure_correct_facing_direction(env, workshop_pos))\n    actions.append(env.world.N_ACTIONS - 1)  # USE action\n    return actions\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the goal item is a primitive or not in the recipes\n  if item_index in env.world.grabbable_indices:\n    return []  # Primitives cannot be crafted\n  \n  # Retrieve the recipe for the desired item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Determine the workshop required for crafting\n  workshop_key = \"_at\"\n  workshop_name = recipe.get(workshop_key)\n  if workshop_name is None:\n    raise ValueError(f\"No workshop specified for crafting {item}.\")\n  \n  workshop_index = env.world.cookbook.index[workshop_name]\n  workshop_pos = find_workshop_position(env._current_state.grid, workshop_name, env.world.cookbook.index)\n\n  # Determine the list of required primitives or intermediate items\n  required_items = {env.world.cookbook.index[key]: value for key, value in recipe.items() if isinstance(key, str)}\n\n  actions = []\n\n  # Collect all required items\n  actions.extend(collect_primitives(env, required_items))\n\n  # Navigate to the workshop and use it to craft the item\n  actions.extend(navigate_and_use_workshop(env, workshop_pos))\n  \n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T04:03:41.547158", "function_name": "craft", "function_body": "  def a_star(grid, start, goal):\n      open_list = []\n      closed_set = set()\n      g_costs = {start: 0}\n      f_costs = {start: heuristic(start, goal)}\n      came_from = {}\n\n      heapq.heappush(open_list, (f_costs[start], start))\n\n      while open_list:\n          _, current = heapq.heappop(open_list)\n\n          if current == goal:\n              return reconstruct_path(came_from, current)\n\n          closed_set.add(current)\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n                  if np.all(grid[neighbor[0], neighbor[1], :] == 0):  # Check if the cell is empty\n                      continue\n\n                  tentative_g_cost = g_costs[current] + 1\n\n                  if neighbor not in g_costs or tentative_g_cost < g_costs[neighbor]:\n                      came_from[neighbor] = current\n                      g_costs[neighbor] = tentative_g_cost\n                      f_costs[neighbor] = tentative_g_cost + heuristic(neighbor, goal)\n                      heapq.heappush(open_list, (f_costs[neighbor], neighbor))\n\n      return []\n\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def reconstruct_path(came_from, current):\n      path = [current]\n      while current in came_from:\n          current = came_from[current]\n          path.append(current)\n      path.reverse()\n      return path\n\n  actions = []\n\n  # Get the index for the goal item\n  goal_index = env.world.cookbook.index[item]\n\n  # Check if we have all the required primitives in inventory\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n\n  missing_primitives = {}\n  for prim, count in required_primitives.items():\n      if env._current_state.inventory[prim] < count:\n          missing_primitives[prim] = count - env._current_state.inventory[prim]\n\n  if missing_primitives:\n      # Collect missing primitives\n      for prim, needed_count in missing_primitives.items():\n          primitive_name = [k for k, v in env.world.cookbook.index.items() if v == prim][0]\n          gather_actions = collect(env, primitive_name, needed_count)\n          actions.extend(gather_actions)\n\n  # Identify the workshop where crafting should occur\n  workshop_index = None\n  for recipe_output, ingredients in env.world.cookbook.recipes.items():\n      if recipe_output == goal_index and \"_key\" in ingredients:\n          workshop_key = ingredients[\"_key\"]\n          workshop_index = env.world.cookbook.index[workshop_key]\n          break\n\n  if workshop_index is None:\n      return []  # No valid workshop found\n\n  # Locate the workshops on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n      return []  # Workshop not found on the grid\n\n  # Navigate to the nearest workshop using A* search\n  agent_pos = env._current_state.pos\n  closest_workshop = min(workshop_positions, key=lambda x: np.linalg.norm(np.array(x) - np.array(agent_pos)))\n\n  path_to_workshop = a_star(env._current_state.grid, agent_pos, tuple(closest_workshop))\n\n  if not path_to_workshop:\n      return []  # No valid path found\n\n  for point in path_to_workshop[:-1]:\n      dx, dy = point[0] - env._current_state.pos[0], point[1] - env._current_state.pos[1]\n\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      elif dy > 0:\n          actions.append(4)  # DOWN\n      elif dy < 0:\n          actions.append(1)  # UP\n\n  # Final step to the workshop\n  final_point = path_to_workshop[-1]\n  dx, dy = final_point[0] - env._current_state.pos[0], final_point[1] - env._current_state.pos[1]\n\n  if dx > 0:\n      actions.append(3)  # RIGHT\n  elif dx < 0:\n      actions.append(2)  # LEFT\n  elif dy > 0:\n      actions.append(4)  # DOWN\n  elif dy < 0:\n      actions.append(1)  # UP\n\n  # Determine the direction to face the workshop and use it\n  current_pos = path_to_workshop[-1]\n  target_dir = None\n\n  if closest_workshop[0] == current_pos[0]:\n      if closest_workshop[1] > current_pos[1]:\n          target_dir = 4  # DOWN\n      else:\n          target_dir = 1  # UP\n  elif closest_workshop[1] == current_pos[1]:\n      if closest_workshop[0] > current_pos[0]:\n          target_dir = 3  # RIGHT\n      else:\n          target_dir = 2  # LEFT\n\n  # Change direction if necessary\n  if env._current_state.dir != target_dir:\n      actions.append(target_dir)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
