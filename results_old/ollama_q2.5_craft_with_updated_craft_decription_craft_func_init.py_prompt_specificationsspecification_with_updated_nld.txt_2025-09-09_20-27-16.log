   total_path.append(direction_to_face)\n        current = came_from[current]\n\n      actions.extend(reversed(total_path))\n\n    return actions\n\n  def heuristic(a, b):\n    ax, ay = divmod(a, env._current_state.grid.shape[1])\n    bx, by = divmod(b, env._current_state.grid.shape[1])\n\n    # Manhattan distance\n    return abs(ax - bx) + abs(ay - by)\n\n  actions = []\n\n  item_index = env.world.cookbook.index.get(item)\n  \n  if item_index is None:\n    print(f\"Item '{item}' not found in cookbook.\")\n    return []\n\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  current_inventory = {env.world.cookbook.index.get(i): c for i, c in enumerate(env._current_state.inventory) if c > 0}\n\n  # Check if we have all the required primitives\n  missing_primitives = []\n  for primitive_index, count in primitives_needed.items():\n    if current_inventory.get(primitive_index, 0) < count:\n      missing_primitives.append((primitive_index, count - current_inventory.get(primitive_index, 0)))\n\n  if missing_primitives:\n    print(f\"Missing primitives: {missing_primitives}\")\n    return []\n\n  workshop_name = env.world.cookbook.recipes[item_index][\"_at\"]\n  workshop_indices = np.argwhere(env._current_state.grid[:, :, env.world.workshop_indices[0]] == env.world.cookbook.index.get(workshop_name))\n\n  if not workshop_indices.size:\n    print(f\"No workshop found for '{workshop_name}'.\")\n    return []\n\n  start_pos_flat = env._current_state.pos[0] * env._current_state.grid.shape[1] + env._current_state.pos[1]\n  target_workshop_position = (workshop_indices[0][0], workshop_indices[0][1])\n  target_pos_flat = target_workshop_position[0] * env._current_state.grid.shape[1] + target_workshop_position[1]\n\n  actions.extend(find_path(start_pos_flat, target_pos_flat))\n\n  direction_to_face = get_direction(env._current_state.pos, target_workshop_position)\n  if direction_to_face is not None:\n      actions.append(direction_to_face)\n\n  # Craft the item by using the USE action\n  actions.append(4)  # USE action\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-11T16:39:40.365463", "function_name": "craft", "function_body": "  def find_closest_position_with_space_for_workshop(workshop_index):\n    grid = env._current_state.grid\n    agent_pos = env._current_state.pos\n    closest_distance = float('inf')\n    closest_position = None\n\n    for x in range(grid.shape[0]):\n        for y in range(grid.shape[1]):\n            if (grid[x, y, workshop_index] > 0 and\n                grid[x + 1, y, 0] == 0 and grid[x - 1, y, 0] == 0 and  # Check adjacent cells are empty\n                grid[x, y + 1, 0] == 0 and grid[x, y - 1, 0] == 0):\n                distance = abs(x - agent_pos[0]) + abs(y - agent_pos[1])\n                if distance < closest_distance:\n                    closest_distance = distance\n                    closest_position = (x, y)\n\n    return closest_position\n\n  def move_towards_position(agent_pos, target_pos):\n      dx, dy = target_pos[0] - agent_pos[0], target_pos[1] - agent_pos[1]\n      actions = []\n      if dx > 0:\n          for _ in range(dx):\n              actions.append(3)  # RIGHT\n      elif dx < 0:\n          for _ in range(-dx):\n              actions.append(2)  # LEFT\n      if dy > 0:\n          for _ in range(dy):\n              actions.append(1)  # UP\n      elif dy < 0:\n          for _ in range(-dy):\n              actions.append(0)  # DOWN\n      return actions\n\n  def collect_primitives(primitive, count):\n      primitive_index = env.world.cookbook.index[primitive]\n      current_inventory = env._current_state.inventory\n      \n      if current_inventory[primitive_index] >= count:\n          return []\n\n      grid = env._current_state.grid\n      agent_pos = env._current_state.pos\n      closest_distance = float('inf')\n      closest_position = None\n\n      # Find the nearest position with the required primitive\n      for x in range(grid.shape[0]):\n          for y in range(grid.shape[1]):\n              if grid[x, y, primitive_index] > 0:\n                  distance = abs(x - agent_pos[0]) + abs(y - agent_pos[1])\n                  if distance < closest_distance:\n                      closest_distance = distance\n                      closest_position = (x, y)\n\n      if not closest_position:\n          return []  # No position found to collect the primitive\n\n      actions_to_take = move_towards_position(agent_pos, closest_position)\n      actions_to_take.append(4)  # USE action to collect the primitive\n      \n      return actions_to_take\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item has a recipe\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the required primitives and their counts for crafting the item\n  recipe = env.world.cookbook.recipes[item_index]\n  required_primitives = {ingredient: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n\n  actions_to_take = []\n  \n  for primitive, count in required_primitives.items():\n      primitive_actions = collect_primitives(primitive, count)\n      actions_to_take.extend(primitive_actions)\n\n  # Determine the workshop where crafting should occur\n  workshop = recipe.get(\"_at\", None)\n  if not workshop:\n    return []\n\n  workshop_index = env.world.cookbook.index[workshop]\n\n  # Find the closest position next to the workshop with enough space around it\n  closest_workshop_pos = find_closest_position_with_space_for_workshop(workshop_index)\n\n  if not closest_workshop_pos:\n    return []\n\n  # Calculate the direction to move towards the closest workshop\n  agent_pos = env._current_state.pos\n  actions_to_take.extend(move_towards_position(agent_pos, closest_workshop_pos))\n\n  # Append USE action to craft the item\n  actions_to_take.append(4)  # USE action\n\n  return actions_to_take", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-11T16:39:41.475113", "function_name": "craft", "function_body": "  def find_closest_position_with_space_for_workshop(workshop_index):\n    grid = env._current_state.grid\n    agent_pos = env._current_state.pos\n    closest_distance = float('inf')\n    closest_position = None\n\n    for x in range(grid.shape[0]):\n        for y in range(grid.shape[1]):\n            if (grid[x, y, workshop_index] > 0 and\n                grid[x + 1, y, 0] == 0 and grid[x - 1, y, 0] == 0 and  # Check adjacent cells are empty\n                grid[x, y + 1, 0] == 0 and grid[x, y - 1, 0] == 0):\n                distance = abs(x - agent_pos[0]) + abs(y - agent_pos[1])\n                if distance < closest_distance:\n                    closest_distance = distance\n                    closest_position = (x, y)\n\n    return closest_position\n\n  def move_towards_position(agent_pos, target_pos):\n      dx, dy = target_pos[0] - agent_pos[0], target_pos[1] - agent_pos[1]\n      actions = []\n      if dx > 0:\n          for _ in range(dx):\n              actions.append(3)  # RIGHT\n      elif dx < 0:\n          for _ in range(-dx):\n              actions.append(2)  # LEFT\n      if dy > 0:\n          for _ in range(dy):\n              actions.append(1)  # UP\n      elif dy < 0:\n          for _ in range(-dy):\n              actions.append(0)  # DOWN\n      return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item has a recipe\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the required primitives and their counts for crafting the item\n  recipe = env.world.cookbook.recipes[item_index]\n  required_primitives = {ingredient: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n\n  # Check if we have all the required primitives in our inventory\n  current_inventory = env._current_state.inventory\n\n  missing_primitives = []\n\n  for primitive, count in required_primitives.items():\n    if current_inventory[primitive] < count:\n      missing_primitives.append((primitive, count))\n\n  # If there are any missing primitives, return an empty action list\n  if missing_primitives:\n    return []\n\n  # Determine the workshop where crafting should occur\n  workshop = recipe.get(\"_at\", None)\n  if not workshop:\n    return []\n\n  workshop_index = env.world.cookbook.index[workshop]\n\n  # Find the closest position next to the workshop with enough space around it\n  closest_workshop_pos = find_closest_position_with_space_for_workshop(workshop_index)\n\n  if not closest_workshop_pos:\n    return []\n\n  # Calculate the direction to move towards the closest workshop\n  agent_pos = env._current_state.pos\n  actions_to_take = move_towards_position(agent_pos, closest_workshop_pos)\n\n  # Append USE action to craft the item\n  actions_to_take.append(4)  # USE action\n\n  return actions_to_take", "island_id": 7, "scores": {"3": 5.0}}
{"timestamp": "2025-09-11T16:40:44.661943", "function_name": "craft", "function_body": "  # Get the index of the item from the cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all required primitives to craft the item\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  \n  # Initialize action list\n  actions = []\n  \n  # Collect all required primitives if not already in inventory\n  for primitive, count in required_primitives.items():\n    while env._current_state.inventory[primitive] < count:\n      collect_actions = collect_v0(env, primitive)\n      actions.extend(collect_actions)\n\n  # Find the workshop where crafting is possible\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop = None\n  \n  for ingredient, _ in recipe.items():\n    if ingredient == \"_key\":\n      workshop = env.world.cookbook.index[recipe[\"_key\"]]\n      break\n\n  if workshop is not None:\n    # Navigate to the workshop\n    workshop_actions = navigate_to(env._current_state.grid, env._current_state.pos, workshop)\n    actions.extend(workshop_actions)\n\n    # Perform USE action at the workshop\n    actions.append(craft.USE_ACTION)\n\n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-11T16:40:45.650758", "function_name": "craft", "function_body": "  # Convert the item name to its corresponding index\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the goal is a known item in the cookbook\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Unknown crafting item: {item}\")\n\n  # Get the recipe for the desired item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Collect all required primitives and intermediate items\n  actions = []\n  \n  # Iterate over each ingredient in the recipe\n  for ingredient, count in recipe.items():\n    if ingredient == \"_at\":\n      continue  # Skip the workshop location\n\n    # Get the index of the current ingredient\n    ingredient_index = env.world.cookbook.index[ingredient]\n\n    # Check if we have enough of this ingredient in our inventory already\n    while env._current_state.inventory[ingredient_index] < count:\n      # Collect the required amount of this ingredient\n      actions.extend(collect(env, ingredient))\n\n  # Find the workshop where the item should be crafted\n  workshop = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop]\n\n  # Move to the nearest workshop and face it\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available {workshop} to craft {item}\")\n\n  closest_workshop_pos, _ = min(\n      ((pos, np.linalg.norm(np.array(pos) - np.array(env._current_state.pos)))\n       for pos in workshop_positions),\n      key=lambda x: x[1]\n  )\n\n  # Actions to move to the closest workshop\n  actions.extend(move_to_position(env, tuple(closest_workshop_pos)))\n\n  # Turn to face the workshop before using it\n  actions.append(face_towards(env, tuple(closest_workshop_pos)))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE action\n\n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-11T16:43:09.617545", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index of the item we want to craft\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the required primitives for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  \n  # Check if the agent has all the required items in its inventory\n  missing_items = {i: count for i, count in required_primitives.items() if env._current_state.inventory[i] < count}\n  \n  if missing_items:\n      return []  # Return empty action list as we don't have all required items\n  \n  # Find the workshop index from the recipe\n  workshop_index = None\n  for ingredient, details in env.world.cookbook.recipes[item_index].items():\n    if \"_at\" in details:\n        workshop_index = env.world.cookbook.index[details[\"_at\"]]\n  \n  if workshop_index is None:\n      return []  # Return empty action list as we don't know where to craft the item\n  \n  # Find a position of the workshop on the grid\n  workshops_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  if not workshops_positions.size:\n      return []  # Return empty action list as there's no available workshop\n  \n  # Move to the nearest workshop\n  nearest_workshop_pos = min(workshops_positions, key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1]))\n  \n  # Calculate path to the nearest workshop (using simple BFS)\n  def bfs_shortest_path(grid, start, target):\n    queue = collections.deque([(start, [])])\n    visited = set([start])\n    \n    while queue:\n        current_pos, path = queue.popleft()\n        \n        if current_pos == tuple(target):\n            return path\n        \n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            next_pos = (current_pos[0] + dx, current_pos[1] + dy)\n            \n            if grid[next_pos[0], next_pos[1]].sum() == 0 and next_pos not in visited:  # Check if the cell is empty\n                queue.append((next_pos, path + [(dx, dy)]))\n                visited.add(next_pos)\n    \n    return None\n  \n  path_to_workshop = bfs_shortest_path(env._current_state.grid, env._current_state.pos, nearest_workshop_pos)\n  \n  if not path_to_workshop:\n      return []  # Return empty action list as there's no available path to the workshop\n  \n  # Convert path to actions\n  direction_map = {(-1, 0): craft.UP, (1, 0): craft.DOWN, (0, -1): craft.LEFT, (0, 1): craft.RIGHT}\n  \n  for dx, dy in path_to_workshop:\n      actions.append(direction_map[(dx, dy)])\n  \n  # Move to the position facing the workshop\n  final_direction = None\n  \n  if nearest_workshop_pos[0] == env._current_state.pos[0]:\n    if nearest_workshop_pos[1] < env._current_state.pos[1]:\n        final_direction = craft.LEFT\n    else:\n        final_direction = craft.RIGHT\n  elif nearest_workshop_pos[1] == env._current_state.pos[1]:\n    if nearest_workshop_pos[0] < env._current_state.pos[0]:\n        final_direction = craft.UP\n    else:\n        final_direction = craft.DOWN\n  \n  if final_direction is not None:\n      actions.append(final_direction)\n  \n  # Perform the USE action to craft the item\n  actions.append(craft.USE)\n  \n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-11T16:43:10.594133", "function_name": "craft", "function_body": "  def get_required_primitives(item_index):\n    # Get the primitives required for crafting the given item\n    cookbook = env.world.cookbook\n    if item_index in cookbook.recipes:\n      recipe = cookbook.recipes[item_index]\n      primitives_needed = {}\n      for ingredient, count in recipe.items():\n        if ingredient != \"_at\":\n          ingredient_index = cookbook.index[ingredient]\n          if ingredient_index is not None and ingredient_index in cookbook.primitives:\n            primitives_needed[ingredient_index] = count\n      return primitives_needed\n    else:\n      return {}\n\n  def find_workshop(item_index):\n    # Find the workshop index where the given item can be crafted\n    cookbook = env.world.cookbook\n    if item_index in cookbook.recipes and \"_at\" in cookbook.recipes[item_index]:\n      workshop_name = cookbook.recipes[item_index][\"_at\"]\n      workshop_index = cookbook.index[workshop_name]\n      return workshop_index\n    else:\n      return None\n\n  def navigate_to_position(env, position):\n    # Generate actions to move the agent to the specified position\n    actions = []\n    current_pos = env._current_state.pos\n    delta_x = position[0] - current_pos[0]\n    delta_y = position[1] - current_pos[1]\n\n    if delta_x > 0:\n      actions.extend([env.world.world.index[\"RIGHT\"]] * abs(delta_x))\n    elif delta_x < 0:\n      actions.extend([env.world.world.index[\"LEFT\"]] * abs(delta_x))\n\n    if delta_y > 0:\n      actions.extend([env.world.world.index[\"DOWN\"]] * abs(delta_y))\n    elif delta_y < 0:\n      actions.extend([env.world.world.index[\"UP\"]] * abs(delta_y))\n\n    return actions\n\n  def turn_to_face(env, direction):\n    # Generate actions to turn the agent to face the specified direction\n    current_dir = env._current_state.dir\n    directions = [\"UP\", \"RIGHT\", \"DOWN\", \"LEFT\"]\n    target_index = directions.index(direction)\n\n    while (target_index - current_dir) % 4 != 0:\n      if (target_index - current_dir) % 4 == 1 or (target_index - current_dir) % 4 == -3:\n        actions.append(env.world.world.index[\"RIGHT\"])\n      else:\n        actions.append(env.world.world.index[\"LEFT\"])\n      current_dir = (current_dir + 1) % 4\n\n    return actions\n\n  def use_workshop(env):\n    # Generate action to use the workshop\n    return [env.world.world.index[\"USE\"]]\n\n  def collect_primitives(env, primitives_needed):\n    # Collect all required primitives\n    actions = []\n    cookbook = env.world.cookbook\n\n    for primitive_index, count in primitives_needed.items():\n      while env._current_state.inventory[primitive_index] < count:\n        primitive_name = cookbook.index.get(primitive_index)\n        if primitive_name is not None:\n          actions.extend(collect(env, primitive_name))\n        else:\n          raise ValueError(f\"Unknown primitive index: {primitive_index}\")\n\n    return actions\n\n  # Main logic for crafting the item\n  item_index = env.world.cookbook.index[item]\n  primitives_needed = get_required_primitives(item_index)\n  workshop_index = find_workshop(item_index)\n\n  if not primitives_needed:\n    raise ValueError(f\"No recipe found for item: {item}\")\n  if workshop_index is None:\n    raise ValueError(f\"No workshop specified for item: {item}\")\n\n  actions = []\n\n  # Collect all required primitives\n  actions.extend(collect_primitives(env, primitives_needed))\n\n  # Navigate to the workshop\n  workshop_position = np.argwhere(env._current_state.grid[:, :, workshop_index])[0]\n  actions.extend(navigate_to_position(env, workshop_position))\n\n  # Turn to face the workshop (assuming it's always facing a specific direction)\n  target_direction = \"UP\"  # This should be determined based on the actual position of the workshop\n  actions.extend(turn_to_face(env, target_direction))\n\n  # Use the workshop to craft the item\n  actions.extend(use_workshop(env))\n\n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-11T16:46:27.875273", "function_name": "craft", "function_body": "  def get_direction(current_pos, target_pos):\n    x_diff = target_pos[0] - current_pos[0]\n    y_diff = target_pos[1] - current_pos[1]\n\n    if x_diff == 0 and y_diff == 0:\n      return None\n    elif abs(x_diff) > abs(y_diff):\n      return 2 if x_diff < 0 else 3  # LEFT or RIGHT\n    else:\n      return 0 if y_diff < 0 else 1  # DOWN or UP\n\n  def find_path(start, target):\n    actions = []\n\n    start_x, start_y = divmod(start, env._current_state.grid.shape[1])\n    target_x, target_y = divmod(target, env._current_state.grid.shape[1])\n\n    open_set = []\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, target)}\n\n    heapq.heappush(open_set, (f_score[start], start))\n\n    while open_set:\n      _, current = heapq.heappop(open_set)\n\n      if current == target:\n        reconstruct_path(came_from, current)\n        break\n\n      cx, cy = divmod(current, env._current_state.grid.shape[1])\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = cx + dx, cy + dy\n\n        if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n          neighbor = nx * env._current_state.grid.shape[1] + ny\n          tentative_g_score = g_score[current] + 1\n\n          if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n            came_from[neighbor] = current\n            g_score[neighbor] = tentative_g_score\n            f_score[neighbor] = tentative_g_score + heuristic(neighbor, target)\n            heapq.heappush(open_set, (f_score[neighbor], neighbor))\n\n    def reconstruct_path(came_from, current):\n      total_path = []\n      while current in came_from:\n        cx, cy = divmod(current, env._current_state.grid.shape[1])\n        px, py = divmod(came_from[current], env._current_state.grid.shape[1])\n\n        dx, dy = px - cx, py - cy\n        direction_to_face = get_direction((cx, cy), (px, py))\n        \n        if direction_to_face is not None:\n          total_path.append(direction_to_face)\n        \n        current = came_from[current]\n      \n      actions.extend(reversed(total_path))\n\n    return actions\n\n  def heuristic(a, b):\n    ax, ay = divmod(a, env._current_state.grid.shape[1])\n    bx, by = divmod(b, env._current_state.grid.shape[1])\n\n    # Manhattan distance\n    return abs(ax - bx) + abs(ay - by)\n\n  actions = []\n\n  item_index = env.world.cookbook.index[item]\n\n  if not item_index:\n    return []\n\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  current_inventory = {env.world.cookbook.index.get(i): c for i, c in enumerate(env._current_state.inventory) if c > 0}\n\n  missing_primitives = []\n  for primitive_index, count in primitives_needed.items():\n    if current_inventory.get(primitive_index, 0) < count:\n      missing_primitives.append((primitive_index, count - current_inventory.get(primitive_index, 0)))\n\n  if missing_primitives:\n    return []\n\n  workshop_name = env.world.cookbook.recipes[item_index][\"_at\"]\n  workshop_indices = np.argwhere(env._current_state.grid[:, :, env.world.workshop_indices[0]] == env.world.cookbook.index[workshop_name])\n\n  if not workshop_indices.any():\n    return []\n\n  start_pos_flat = env._current_state.pos[0] * env._current_state.grid.shape[1] + env._current_state.pos[1]\n  target_workshop_position = (workshop_indices[0][0], workshop_indices[0][1])\n  target_pos_flat = target_workshop_position[0] * env._current_state.grid.shape[1] + target_workshop_position[1]\n\n  actions.extend(find_path(start_pos_flat, target_pos_flat))\n\n  # Align the agent directly in front of the workshop\n  current_direction = None\n\n  while env._current_state.pos != (target_workshop_position[0], target_workshop_position[1]):\n    direction_to_face = get_direction(env._current_state.pos, target_workshop_position)\n    \n    if direction_to_face is not None and direction_to_face != current_direction:\n      actions.append(direction_to_face)\n      current_direction = direction_to_face\n\n    # Move the agent to the new position\n    env.step(direction_to_face)\n\n  # Use the USE action to craft the item\n  actions.append(4)  # USE action\n\n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T16:46:29.034214", "function_name": "craft", "function_body": "  def get_direction(current_pos, target_pos):\n    x_diff = target_pos[0] - current_pos[0]\n    y_diff = target_pos[1] - current_pos[1]\n\n    if x_diff > 0:\n      return 3  # RIGHT\n    elif x_diff < 0:\n      return 2  # LEFT\n    elif y_diff > 0:\n      return 1  # UP\n    elif y_diff < 0:\n      return 0  # DOWN\n    else:\n      return None\n\n  def find_path(start, target):\n    actions = []\n    \n    start_x, start_y = divmod(start, env._current_state.grid.shape[1])\n    target_x, target_y = divmod(target, env._current_state.grid.shape[1])\n\n    open_set = []\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, target)}\n\n    heapq.heappush(open_set, (f_score[start], start))\n\n    while open_set:\n      _, current = heapq.heappop(open_set)\n\n      if current == target:\n        reconstruct_path(came_from, current)\n        break\n\n      cx, cy = divmod(current, env._current_state.grid.shape[1])\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = cx + dx, cy + dy\n\n        if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n          neighbor = nx * env._current_state.grid.shape[1] + ny\n          tentative_g_score = g_score[current] + 1\n\n          if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n            came_from[neighbor] = current\n            g_score[neighbor] = tentative_g_score\n            f_score[neighbor] = tentative_g_score + heuristic(neighbor, target)\n            heapq.heappush(open_set, (f_score[neighbor], neighbor))\n\n    def reconstruct_path(came_from, current):\n      total_path = []\n      while current in came_from:\n        cx, cy = divmod(current, env._current_state.grid.shape[1])\n        px, py = divmod(came_from[current], env._current_state.grid.shape[1])\n\n        dx, dy = px - cx, py - cy\n        direction_to_face = get_direction((cx, cy), (px, py))\n        \n        if direction_to_face is not None:\n          total_path.append(direction_to_face)\n        \n        current = came_from[current]\n      \n      actions.extend(reversed(total_path))\n\n    return actions\n\n  def heuristic(a, b):\n    ax, ay = divmod(a, env._current_state.grid.shape[1])\n    bx, by = divmod(b, env._current_state.grid.shape[1])\n\n    # Manhattan distance\n    return abs(ax - bx) + abs(ay - by)\n\n  actions = []\n\n  item_index = env.world.cookbook.index[item]\n\n  if not item_index:\n    return []\n\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  current_inventory = {env.world.cookbook.index.get(i): c for i, c in enumerate(env._current_state.inventory) if c > 0}\n\n  missing_primitives = []\n  for primitive_index, count in primitives_needed.items():\n    if current_inventory.get(primitive_index, 0) < count:\n      missing_primitives.append((primitive_index, count - current_inventory.get(primitive_index, 0)))\n\n  if missing_primitives:\n    return []\n\n  workshop_name = env.world.cookbook.recipes[item_index][\"_at\"]\n  workshop_indices = np.argwhere(env._current_state.grid[:, :, env.world.workshop_indices[0]] == env.world.cookbook.index[workshop_name])\n\n  if not workshop_indices.any():\n    return []\n\n  start_pos_flat = env._current_state.pos[0] * env._current_state.grid.shape[1] + env._current_state.pos[1]\n  target_workshop_position = (workshop_indices[0][0], workshop_indices[0][1])\n  target_pos_flat = target_workshop_position[0] * env._current_state.grid.shape[1] + target_workshop_position[1]\n\n  actions.extend(find_path(start_pos_flat, target_pos_flat))\n\n  direction_to_face = get_direction(env._current_state.pos, target_workshop_position)\n  \n  if direction_to_face is not None:\n    actions.append(direction_to_face)\n\n  # Ensure the agent is directly in front of the workshop\n  while env._current_state.pos != (target_workshop_position[0], target_workshop_position[1]):\n    current_pos = env._current_state.pos\n    direction_to_face = get_direction(current_pos, target_workshop_position)\n    \n    if direction_to_face is not None:\n      actions.append(direction_to_face)\n\n  # Craft the item by using the USE action\n  actions.append(4)  # USE action\n\n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T16:49:20.262753", "function_name": "craft", "function_body": "  def generate_path_to_workshop(current_state, workshop_index):\n    queue = collections.deque([current_state.pos])\n    visited = set([current_state.pos])\n    parent = {current_state.pos: None}\n    \n    while queue:\n        x, y = queue.popleft()\n        \n        # Check if we are next to the workshop\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            nx, ny = x + dx, y + dy\n            if env.world.grid[nx][ny] == workshop_index:\n                # Backtrack to find the path\n                path = []\n                while (nx, ny) != current_state.pos:\n                    path.append((nx, ny))\n                    nx, ny = parent[(nx, ny)]\n                return path[::-1]\n            \n            if 0 <= nx < env.world.grid.shape[0] and 0 <= ny < env.world.grid.shape[1] and (nx, ny) not in visited:\n                queue.append((nx, ny))\n                visited.add((nx, ny))\n                parent[(nx, ny)] = (x, y)\n    \n    return None\n\n  def generate_actions_from_path(path, current_state):\n      actions = []\n      for next_pos in path:\n          dx, dy = next_pos[0] - current_state.pos[0], next_pos[1] - current_state.pos[1]\n          if (dx, dy) == (-1, 0):\n              actions.append(2)  # LEFT\n          elif (dx, dy) == (1, 0):\n              actions.append(3)  # RIGHT\n          elif (dx, dy) == (0, -1):\n              actions.append(0)  # DOWN\n          elif (dx, dy) == (0, 1):\n              actions.append(1)  # UP\n      \n      return actions\n\n  def is_next_to_workshop(current_state, workshop_index):\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          neighbor_pos = (current_state.pos[0] + dx, current_state.pos[1] + dy)\n          if env.world.grid[neighbor_pos] == workshop_index:\n              return True\n      return False\n\n  item_index = env.world.cookbook.index[item]\n\n  # If the item has no recipe or is not a crafted item, return an empty action list\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the recipe for the desired item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Check if all required ingredients are available in the inventory\n  required_ingredients = {env.world.cookbook.index[ingredient]: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n  available_ingredients = {k: v for k, v in enumerate(env._current_state.inventory) if v > 0}\n\n  # If all ingredients are not available, return an empty action list\n  if any(required_ingredient not in available_ingredients or available_ingredients[required_ingredient] < count \n         for required_ingredient, count in required_ingredients.items()):\n    return []\n\n  # Find the workshop index where the item should be crafted\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Generate the path to the nearest workshop\n  path_to_workshop = generate_path_to_workshop(env._current_state, workshop_index)\n\n  if not path_to_workshop:\n      return []\n\n  actions = generate_actions_from_path(path_to_workshop, env._current_state)\n\n  # Once at the workshop, face it and perform the USE action\n  if is_next_to_workshop(env._current_state, workshop_index):\n      target_dir = ((1, 0), (-1, 0), (0, -1), (0, 1)).index((path_to_workshop[-1][0] - env._current_state.pos[0], path_to_workshop[-1][1] - env._current_state.pos[1]))\n      current_dir = ((1, 0), (-1, 0), (0, -1), (0, 1)).index(env._current_state.dir)\n      \n      if current_dir != target_dir:\n          actions.append((target_dir + 2) % 4)  # Turn to face the workshop\n      \n      actions.append(4)  # USE action to craft at the workshop\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T16:49:21.384535", "function_name": "craft", "function_body": "  def generate_path_to_workshop(current_state, workshop_index):\n    queue = collections.deque([current_state.pos])\n    visited = set([current_state.pos])\n    parent = {current_state.pos: None}\n    \n    while queue:\n        x, y = queue.popleft()\n        \n        # Check if we are next to the workshop\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            nx, ny = x + dx, y + dy\n            if env.world.grid[nx][ny] == workshop_index:\n                # Backtrack to find the path\n                path = []\n                while (nx, ny) != current_state.pos:\n                    path.append((nx, ny))\n                    nx, ny = parent[(nx, ny)]\n                return path[::-1]\n            \n            if 0 <= nx < env.world.grid.shape[0] and 0 <= ny < env.world.grid.shape[1] and (nx, ny) not in visited:\n                queue.append((nx, ny))\n                visited.add((nx, ny))\n                parent[(nx, ny)] = (x, y)\n    \n    return None\n\n  def generate_actions_from_path(path, current_state):\n      actions = []\n      for next_pos in path:\n          dx, dy = next_pos[0] - current_state.pos[0], next_pos[1] - current_state.pos[1]\n          if (dx, dy) == (-1, 0):\n              actions.append(2)  # LEFT\n          elif (dx, dy) == (1, 0):\n              actions.append(3)  # RIGHT\n          elif (dx, dy) == (0, -1):\n              actions.append(0)  # DOWN\n          elif (dx, dy) == (0, 1):\n              actions.append(1)  # UP\n      \n      return actions\n\n  def is_next_to_workshop(current_state, workshop_index):\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          neighbor_pos = (current_state.pos[0] + dx, current_state.pos[1] + dy)\n          if env.world.grid[neighbor_pos] == workshop_index:\n              return True\n      return False\n\n  item_index = env.world.cookbook.index[item]\n\n  # If the item has no recipe or is not a crafted item, return an empty action list\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the recipe for the desired item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Check if all required ingredients are available in the inventory\n  required_ingredients = {env.world.cookbook.index[ingredient]: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n  available_ingredients = {k: v for k, v in enumerate(env._current_state.inventory) if v > 0}\n\n  # If all ingredients are not available, return an empty action list\n  if any(required_ingredient not in available_ingredients or available_ingredients[required_ingredient] < count \n         for required_ingredient, count in required_ingredients.items()):\n    return []\n\n  # Find the workshop index where the item should be crafted\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Generate the path to the nearest workshop\n  path_to_workshop = generate_path_to_workshop(env._current_state, workshop_index)\n\n  if not path_to_workshop:\n      return []\n\n  actions = generate_actions_from_path(path_to_workshop, env._current_state)\n\n  # Once at the workshop, face it and perform the USE action\n  if is_next_to_workshop(env._current_state, workshop_index):\n      target_dir = ((1, 0), (-1, 0), (0, -1), (0, 1)).index((path_to_workshop[-1][0] - env._current_state.pos[0], path_to_workshop[-1][1] - env._current_state.pos[1]))\n      current_dir = ((1, 0), (-1, 0), (0, -1), (0, 1)).index(env._current_state.dir)\n      \n      if current_dir != target_dir:\n          actions.append((target_dir + 2) % 4)  # Turn to face the workshop\n      \n      actions.append(4)  # USE action to craft at the workshop\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T16:51:00.982889", "function_name": "craft", "function_body": "  def find_closest_workshop(workshop_index):\n    grid = env._current_state.grid\n    agent_pos = env._current_state.pos\n    closest_distance = float('inf')\n    closest_workshop_pos = None\n\n    for x in range(grid.shape[0]):\n        for y in range(grid.shape[1]):\n            if grid[x, y, workshop_index] > 0:\n                distance = abs(x - agent_pos[0]) + abs(y - agent_pos[1])\n                if distance < closest_distance:\n                    closest_distance = distance\n                    closest_workshop_pos = (x, y)\n\n    return closest_workshop_pos\n\n  def move_towards_position(agent_pos, target_pos):\n      dx, dy = target_pos[0] - agent_pos[0], target_pos[1] - agent_pos[1]\n      actions = []\n      if dx > 0:\n          for _ in range(dx):\n              actions.append(3)  # RIGHT\n      elif dx < 0:\n          for _ in range(-dx):\n              actions.append(2)  # LEFT\n      if dy > 0:\n          for _ in range(dy):\n              actions.append(1)  # UP\n      elif dy < 0:\n          for _ in range(-dy):\n              actions.append(0)  # DOWN\n      return actions\n\n  def get_required_primitives(item_index):\n    recipe = env.world.cookbook.recipes[item_index]\n    required_primitives = {ingredient: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n    return required_primitives\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item has a recipe\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  required_primitives = get_required_primitives(item_index)\n\n  current_inventory = env._current_state.inventory\n\n  actions_to_take = []\n\n  # Collect all missing primitives\n  for primitive, count in required_primitives.items():\n      while current_inventory[primitive] < count:\n          actions_to_take.extend(collect(env, primitive))\n          current_inventory = env._current_state.inventory\n\n  # Determine the workshop where crafting should occur\n  workshop = env.world.cookbook.recipes[item_index].get(\"_at\", None)\n  if not workshop:\n    return []\n\n  workshop_index = env.world.cookbook.index[workshop]\n\n  # Find the closest position next to the workshop\n  closest_workshop_pos = find_closest_workshop(workshop_index)\n\n  if not closest_workshop_pos:\n    return []\n\n  # Calculate the direction to move towards the closest workshop\n  agent_pos = env._current_state.pos\n  actions_to_take.extend(move_towards_position(agent_pos, closest_workshop_pos))\n\n  # Append USE action to craft the item\n  actions_to_take.append(4)  # USE action\n\n  return actions_to_take", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-11T16:51:02.060941", "function_name": "craft", "function_body": "  def find_closest_workshop(workshop_index):\n    grid = env._current_state.grid\n    agent_pos = env._current_state.pos\n    closest_distance = float('inf')\n    closest_workshop_pos = None\n\n    for x in range(grid.shape[0]):\n        for y in range(grid.shape[1]):\n            if grid[x, y, workshop_index] > 0:\n                distance = abs(x - agent_pos[0]) + abs(y - agent_pos[1])\n                if distance < closest_distance:\n                    closest_distance = distance\n                    closest_workshop_pos = (x, y)\n\n    return closest_workshop_pos\n\n  def move_towards_position(agent_pos, target_pos):\n      dx, dy = target_pos[0] - agent_pos[0], target_pos[1] - agent_pos[1]\n      actions = []\n      if dx > 0:\n          for _ in range(dx):\n              actions.append(3)  # RIGHT\n      elif dx < 0:\n          for _ in range(-dx):\n              actions.append(2)  # LEFT\n      if dy > 0:\n          for _ in range(dy):\n              actions.append(1)  # UP\n      elif dy < 0:\n          for _ in range(-dy):\n              actions.append(0)  # DOWN\n      return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item has a recipe\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the required primitives and their counts for crafting the item\n  recipe = env.world.cookbook.recipes[item_index]\n  required_primitives = {ingredient: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n\n  # Check if we have all the required primitives in our inventory\n  current_inventory = env._current_state.inventory\n\n  missing_primitives = []\n\n  for primitive, count in required_primitives.items():\n    if current_inventory[primitive] < count:\n      missing_primitives.append((primitive, count))\n\n  # If there are any missing primitives, return an empty action list\n  if missing_primitives:\n    return []\n\n  # Determine the workshop where crafting should occur\n  workshop = recipe.get(\"_at\", None)\n  if not workshop:\n    return []\n\n  workshop_index = env.world.cookbook.index[workshop]\n\n  # Find the closest position next to the workshop\n  closest_workshop_pos = find_closest_workshop(workshop_index)\n\n  if not closest_workshop_pos:\n    return []\n\n  # Calculate the direction to move towards the closest workshop\n  agent_pos = env._current_state.pos\n\n  actions_to_take = []\n  while not (agent_pos[0] == closest_workshop_pos[0] and agent_pos[1] == closest_workshop_pos[1]):\n      dx, dy = closest_workshop_pos[0] - agent_pos[0], closest_workshop_pos[1] - agent_pos[1]\n      if dx > 0:\n          actions_to_take.append(3)  # RIGHT\n          agent_pos = (agent_pos[0] + 1, agent_pos[1])\n      elif dx < 0:\n          actions_to_take.append(2)  # LEFT\n          agent_pos = (agent_pos[0] - 1, agent_pos[1])\n      if dy > 0:\n          actions_to_take.append(1)  # UP\n          agent_pos = (agent_pos[0], agent_pos[1] + 1)\n      elif dy < 0:\n          actions_to_take.append(0)  # DOWN\n          agent_pos = (agent_pos[0], agent_pos[1] - 1)\n\n  # Append USE action to craft the item\n  actions_to_take.append(4)  # USE action\n\n  return actions_to_take", "island_id": 6, "scores": {"3": 5.0}}
{"timestamp": "2025-09-11T16:54:06.112820", "function_name": "craft", "function_body": "  def collect_primitive(primitive_name):\n    primitive_index = env.world.cookbook.index[primitive_name]\n    \n    if primitive_index not in env.world.cookbook.primitives:\n      return []\n\n    # Find positions of the required primitive in the environment\n    primitive_positions = np.argwhere(env.world.grid == primitive_index)\n    \n    # If no primitives are available, return an empty action list\n    if len(primitive_positions) == 0:\n      return []\n\n    def generate_path_to_primitive(current_state, target_pos):\n        queue = collections.deque([current_state.pos])\n        visited = set([current_state.pos])\n        parent = {current_state.pos: None}\n        \n        while queue:\n            x, y = queue.popleft()\n            \n            # Check if we are next to the primitive\n            for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                nx, ny = x + dx, y + dy\n                if (nx, ny) == target_pos:\n                    path = []\n                    while (nx, ny) != current_state.pos:\n                        path.append((nx, ny))\n                        nx, ny = parent[(nx, ny)]\n                    return path[::-1]\n                \n                if 0 <= nx < env.world.grid.shape[0] and 0 <= ny < env.world.grid.shape[1] and (nx, ny) not in visited:\n                    queue.append((nx, ny))\n                    visited.add((nx, ny))\n                    parent[(nx, ny)] = (x, y)\n        \n        return None\n\n    def generate_actions_from_path(path, current_state):\n        actions = []\n        for next_pos in path:\n            dx, dy = next_pos[0] - current_state.pos[0], next_pos[1] - current_state.pos[1]\n            if (dx, dy) == (-1, 0):\n                actions.append(2)  # LEFT\n            elif (dx, dy) == (1, 0):\n                actions.append(3)  # RIGHT\n            elif (dx, dy) == (0, -1):\n                actions.append(0)  # DOWN\n            elif (dx, dy) == (0, 1):\n                actions.append(1)  # UP\n        \n        return actions\n\n    path_to_primitive = generate_path_to_primitive(env._current_state, tuple(primitive_positions[0]))\n    \n    if not path_to_primitive:\n      return []\n\n    actions = generate_actions_from_path(path_to_primitive, env._current_state)\n    \n    # Once at the primitive, face it and perform the USE action to collect it\n    target_dir = ((1, 0), (-1, 0), (0, -1), (0, 1)).index((path_to_primitive[-1][0] - env._current_state.pos[0], path_to_primitive[-1][1] - env._current_state.pos[1]))\n    current_dir = ((1, 0), (-1, 0), (0, -1), (0, 1)).index(env._current_state.dir)\n    \n    if current_dir != target_dir:\n      actions.append((target_dir + 2) % 4)  # Turn to face the primitive\n    \n    actions.append(4)  # USE action to collect the primitive\n\n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # If the item has no recipe or is not a crafted item, return an empty action list\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the recipe for the desired item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Check if all required ingredients are available in the inventory\n  required_ingredients = {env.world.cookbook.index[ingredient]: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n  available_ingredients = {k: v for k, v in enumerate(env._current_state.inventory) if v > 0}\n\n  # Collect missing ingredients from the environment\n  actions = []\n  for required_ingredient, count in required_ingredients.items():\n    if required_ingredient not in available_ingredients or available_ingredients[required_ingredient] < count:\n      ingredient_name = [name for name, idx in env.world.cookbook.index.items() if idx == required_ingredient][0]\n      actions.extend(collect_primitive(ingredient_name))\n\n  # Find the workshop index where the item should be crafted\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  def generate_path_to_workshop(current_state, workshop_index):\n    queue = collections.deque([current_state.pos])\n    visited = set([current_state.pos])\n    parent = {current_state.pos: None}\n    \n    while queue:\n        x, y = queue.popleft()\n        \n        # Check if we are next to the workshop\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            nx, ny = x + dx, y + dy\n            if env.world.grid[nx][ny] == workshop_index:\n                path = []\n                while (nx, ny) != current_state.pos:\n                    path.append((nx, ny))\n                    nx, ny = parent[(nx, ny)]\n                return path[::-1]\n            \n            if 0 <= nx < env.world.grid.shape[0] and 0 <= ny < env.world.grid.shape[1] and (nx, ny) not in visited:\n                queue.append((nx, ny))\n                visited.add((nx, ny))\n                parent[(nx, ny)] = (x, y)\n    \n    return None\n\n  def generate_actions_from_path(path, current_state):\n      actions = []\n      for next_pos in path:\n          dx, dy = next_pos[0] - current_state.pos[0], next_pos[1] - current_state.pos[1]\n          if (dx, dy) == (-1, 0):\n              actions.append(2)  # LEFT\n          elif (dx, dy) == (1, 0):\n              actions.append(3)  # RIGHT\n          elif (dx, dy) == (0, -1):\n              actions.append(0)  # DOWN\n          elif (dx, dy) == (0, 1):\n              actions.append(1)  # UP\n      \n      return actions\n\n  def is_next_to_workshop(current_state, workshop_index):\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          neighbor_pos = (current_state.pos[0] + dx, current_state.pos[1] + dy)\n          if env.world.grid[neighbor_pos] == workshop_index:\n              return True\n      return False\n\n  # Generate the path to the nearest workshop\n  path_to_workshop = generate_path_to_workshop(env._current_state, workshop_index)\n\n  if not path_to_workshop:\n    return []\n\n  actions.extend(generate_actions_from_path(path_to_workshop, env._current_state))\n\n  # Once at the workshop, face it and perform the USE action\n  if is_next_to_workshop(env._current_state, workshop_index):\n      target_dir = ((1, 0), (-1, 0), (0, -1), (0, 1)).index((path_to_workshop[-1][0] - env._current_state.pos[0], path_to_workshop[-1][1] - env._current_state.pos[1]))\n      current_dir = ((1, 0), (-1, 0), (0, -1), (0, 1)).index(env._current_state.dir)\n      \n      if current_dir != target_dir:\n          actions.append((target_dir + 2) % 4)  # Turn to face the workshop\n      \n      actions.append(4)  # USE action to craft at the workshop\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-11T16:54:07.200715", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n\n  # If the item has no recipe or is not a crafted item, return an empty action list\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the recipe for the desired item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Check if all required ingredients are available in the inventory\n  required_ingredients = {env.world.cookbook.index[ingredient]: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n  available_ingredients = {k: v for k, v in enumerate(env._current_state.inventory) if v > 0}\n\n  # If all ingredients are not available, return an empty action list\n  if any(required_ingredient not in available_ingredients or available_ingredients[required_ingredient] < count \n         for required_ingredient, count in required_ingredients.items()):\n    return []\n\n  # Find the workshop index where the item should be crafted\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  def generate_path_to_workshop(current_state, workshop_index):\n      \"\"\"Generates a path to the nearest workshop using A* algorithm.\"\"\"\n      start_pos = current_state.pos\n      grid = env.world.grid\n      width, height = grid.shape\n      \n      # Define heuristic (Manhattan distance)\n      def heuristic(a, b):\n          return abs(a[0] - b[0]) + abs(a[1] - b[1])\n      \n      open_set = []\n      closed_set = set()\n      g_costs = {start_pos: 0}\n      f_costs = {start_pos: heuristic(start_pos, (workshop_index // width, workshop_index % width))}\n      parent = {}\n      \n      # Push start position to the open set\n      open_set.append((f_costs[start_pos], start_pos))\n      \n      while open_set:\n          _, current_pos = open_set.pop(0)\n          \n          if grid[current_pos] == workshop_index:\n              path = []\n              while current_pos in parent:\n                  path.append(current_pos)\n                  current_pos = parent[current_pos]\n              return path[::-1]\n          \n          closed_set.add(current_pos)\n          \n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor_pos = (current_pos[0] + dx, current_pos[1] + dy)\n              \n              if 0 <= neighbor_pos[0] < width and 0 <= neighbor_pos[1] < height and grid[neighbor_pos] != env.world.cookbook.index[\"BOUNDARY\"]:\n                  tentative_g_cost = g_costs[current_pos] + 1\n                  \n                  if neighbor_pos in closed_set:\n                      continue\n                  \n                  if neighbor_pos not in open_set or tentative_g_cost < g_costs[neighbor_pos]:\n                      parent[neighbor_pos] = current_pos\n                      g_costs[neighbor_pos] = tentative_g_cost\n                      f_costs[neighbor_pos] = tentative_g_cost + heuristic(neighbor_pos, (workshop_index // width, workshop_index % width))\n                      \n                      if neighbor_pos not in open_set:\n                          open_set.append((f_costs[neighbor_pos], neighbor_pos))\n                          # Sort the open set based on f-costs\n                          open_set.sort(key=lambda x: x[0])\n      \n      return None\n\n  def generate_actions_from_path(path, current_state):\n      actions = []\n      for next_pos in path:\n          dx, dy = next_pos[0] - current_state.pos[0], next_pos[1] - current_state.pos[1]\n          if (dx, dy) == (-1, 0):\n              actions.append(2)  # LEFT\n          elif (dx, dy) == (1, 0):\n              actions.append(3)  # RIGHT\n          elif (dx, dy) == (0, -1):\n              actions.append(0)  # DOWN\n          elif (dx, dy) == (0, 1):\n              actions.append(1)  # UP\n      \n      return actions\n\n  def is_next_to_workshop(current_state, workshop_index):\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          neighbor_pos = (current_state.pos[0] + dx, current_state.pos[1] + dy)\n          if env.world.grid[neighbor_pos] == workshop_index:\n              return True\n      return False\n\n  # Generate the path to the nearest workshop using A* algorithm\n  path_to_workshop = generate_path_to_workshop(env._current_state, workshop_index)\n\n  if not path_to_workshop:\n      return []\n\n  actions = generate_actions_from_path(path_to_workshop, env._current_state)\n\n  # Once at the workshop, face it and perform the USE action\n  target_dir = ((1, 0), (-1, 0), (0, -1), (0, 1)).index((path_to_workshop[-1][0] - env._current_state.pos[0], path_to_workshop[-1][1] - env._current_state.pos[1]))\n  current_dir = ((1, 0), (-1, 0), (0, -1), (0, 1)).index(env._current_state.dir)\n  \n  if current_dir != target_dir:\n      actions.append((target_dir + 2) % 4)  # Turn to face the workshop\n  \n  actions.append(4)  # USE action to craft at the workshop\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T16:55:18.767012", "function_name": "craft", "function_body": "  # Convert item name to index\n  item_index = env.world.cookbook.index[item]\n  \n  # Get primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  \n  actions = []\n  \n  # Check if we have all the primitives in inventory\n  for i, count in required_primitives.items():\n    if env._current_state.inventory[i] < count:\n      return []  # Missing some primitives\n  \n  # Move to the correct workshop and craft the item\n  workshop_index = next(key for key, value in env.world.cookbook.recipes[item_index].items() if key.startswith(\"_at\"))\n  \n  # Get position of all workshops\n  grid_with_workshops = np.any(env._current_state.grid[:, :, workshop_index], axis=2)\n  \n  # Find the nearest workshop\n  pos = env._current_state.pos\n  min_distance = float('inf')\n  nearest_workshop_pos = None\n  \n  for y in range(grid_with_workshops.shape[0]):\n    for x in range(grid_with_workshops.shape[1]):\n      if grid_with_workshops[y, x]:\n        distance = abs(y - pos[0]) + abs(x - pos[1])\n        if distance < min_distance:\n          min_distance = distance\n          nearest_workshop_pos = (y, x)\n  \n  # Navigate to the nearest workshop\n  while env._current_state.pos != nearest_workshop_pos:\n    dy = nearest_workshop_pos[0] - env._current_state.pos[0]\n    dx = nearest_workshop_pos[1] - env._current_state.pos[1]\n    \n    if dx > 0:\n      actions.append(env.world.cookbook.index[\"RIGHT\"])\n    elif dx < 0:\n      actions.append(env.world.cookbook.index[\"LEFT\"])\n    else:\n      if dy > 0:\n        actions.append(env.world.cookbook.index[\"DOWN\"])\n      elif dy < 0:\n        actions.append(env.world.cookbook.index[\"UP\"])\n  \n  # Add USE action to craft the item\n  actions.append(env.world.cookbook.index[\"USE\"])\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-11T16:55:19.814380", "function_name": "craft", "function_body": "  # Initialize an empty list to store actions\n  actions = []\n\n  # Convert the item name to its corresponding index using the cookbook's index\n  i_goal = env.world.cookbook.index[item]\n\n  # Get the primitives required for crafting the item\n  required_primitives = env.world.cookbook.primitives_for(i_goal)\n\n  # If no recipe is found, return an empty action list\n  if not required_primitives:\n    return []\n\n  # Check if the agent already has all the required primitives in its inventory\n  for i_primitive, count in required_primitives.items():\n    if env._current_state.inventory[i_primitive] < count:\n      # If any primitive is missing, return an empty action list\n      return []\n\n  # Find the workshop where the item can be crafted\n  workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n    if i_goal in recipe and \"_at\" in recipe:\n      workshop_index = env.world.cookbook.index[recipe[\"_at\"]]\n      break\n\n  # If no workshop is found, return an empty action list\n  if workshop_index is None:\n    return []\n\n  # Find the position of the workshop on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  \n  if workshop_positions.size == 0:\n    return []\n    \n  # Choose a random workshop from the available positions\n  workshop_pos = tuple(workshop_positions[env.world.random.randint(0, len(workshop_positions))])\n\n  # Calculate the direction to face the workshop\n  direction_to_workshop = (np.array(workshop_pos) - np.array(env._current_state.pos)).tolist()\n  \n  if direction_to_workshop == [1, 0]:\n    actions.append(craft.DOWN)\n  elif direction_to_workshop == [-1, 0]:\n    actions.append(craft.UP)\n  elif direction_to_workshop == [0, 1]:\n    actions.append(craft.RIGHT)\n  elif direction_to_workshop == [0, -1]:\n    actions.append(craft.LEFT)\n\n  # Add the USE action to craft the item\n  actions.append(craft.USE)\n\n  return actions", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T16:56:55.131089", "function_name": "craft", "function_body": "  goal_index = env.world.cookbook.index[item]\n\n  # Check if we have all required primitives in our inventory\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  current_inventory = collections.Counter(env._current_state.inventory)\n\n  for primitive, count in required_primitives.items():\n    if current_inventory[primitive] < count:\n      return []  # Missing required primitives\n\n  # Determine the workshop where crafting should occur\n  recipe_details = env.world.cookbook.recipes[goal_index]\n  workshop_name = recipe_details[\"_key\"]\n\n  # Get the index of the workshop from the world's cookbook\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find all positions of workshops in the grid\n  positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(positions) == 0:\n    return []  # No available workshops\n\n  # Calculate distances to all workshops and find the closest one\n  current_pos = np.array(env._current_state.pos)\n  distances = [np.linalg.norm(current_pos - pos, ord=1) for pos in positions]\n  closest_workshop_idx = np.argmin(distances)\n  closest_workshop_pos = positions[closest_workshop_idx]\n\n  # Determine the direction to move based on the position of the workshop\n  target_pos = np.array(closest_workshop_pos)\n\n  actions = []\n\n  while not np.array_equal(current_pos, target_pos):\n    delta = target_pos - current_pos\n\n    if delta[0] > 0:\n      actions.append(craft.RIGHT)  # Move right\n    elif delta[0] < 0:\n      actions.append(craft.LEFT)   # Move left\n\n    if delta[1] > 0:\n      actions.append(craft.DOWN)   # Move down\n    elif delta[1] < 0:\n      actions.append(craft.UP)     # Move up\n\n    current_pos = np.array(env._current_state.pos)\n\n  # Orient the agent to face the workshop and use it\n  if env._current_state.grid[target_pos[0], target_pos[1], workshop_index] == 1:\n    actions.append(craft.USE)\n\n  return actions", "island_id": 3, "scores": {"3": 0.0}}
