s = [idx for idx, name in enumerate(env.world.workshop_indices) \n                          if workshop_name in env.world.cookbook.index.get(name)]\n      \n      # Find the closest workshop of the desired type\n      closest_workshop_index = find_closest_workshop(env._current_state.pos, workshop_indices)\n      \n      # Move to the closest workshop and align direction correctly before using\n      actions.extend(move_to_workshop_and_align_direction(env._current_state, closest_workshop_index))\n      \n      # Craft the item at the workshop\n      actions.append(craft.USE)\n  \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T23:03:52.459662", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index of the goal item\n  goal_index = env.world.cookbook.index[item]\n  \n  # Check if we have all primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  \n  for prim, count in required_primitives.items():\n    while env._current_state.inventory[prim] < count:\n      actions.extend(collect(env, env.world.cookbook.index.get(prim)))\n  \n  # Navigate to the correct workshop and perform USE action\n  recipe = env.world.cookbook.recipes[goal_index]\n  workshop = None\n  \n  for key in recipe.keys():\n    if key.startswith(\"_at\"):\n      workshop = key.split(\":\")[1].strip()\n      break\n  \n  # Get the index of the workshop\n  workshop_index = env.world.cookbook.index[workshop]\n  \n  # Navigate to the workshop and use it\n  actions.extend(move_to_workshop(env, workshop_index))\n  actions.append(craft.USE)\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-10T23:03:53.489671", "function_name": "craft", "function_body": "  actions = []\n\n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the required primitives for crafting the item\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  available_inventory = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n\n  # Calculate missing primitives\n  missing_primitives = {}\n  for primitive_index, required_count in required_primitives.items():\n      available_count = available_inventory.get(primitive_index, 0)\n      if available_count < required_count:\n          missing_primitives[primitive_index] = required_count - available_count\n\n  if not missing_primitives:\n    # If we have all the required primitives, proceed to craft the item\n    workshop_index = None\n    for ingredient, count in env.world.cookbook.recipes[item_index].items():\n        if ingredient != \"_key\" and ingredient != \"_at\":\n            continue\n        if ingredient == \"_at\":\n            workshop_index = env.world.workshop_indices[env.world.cookbook.index[count]]\n    if workshop_index is not None:\n      # Find the position of the required workshop in the grid\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n      \n      if len(workshop_positions) == 0:\n        print(f\"No workshop found for {item}\")\n        return actions\n      \n      workshop_pos = tuple(workshop_positions[0])\n      \n      # Calculate the path to the workshop\n      path_to_workshop = a_star_search(env._current_state.grid, env._current_state.pos, workshop_pos)\n      \n      if not path_to_workshop:\n        print(f\"No path found to the workshop for {item}\")\n        return actions\n      \n      actions.extend(path_to_workshop)\n      \n      # Append USE action to craft the item\n      actions.append(4)  # Assuming 4 is the index of the USE action in the environment\n\n    else:\n      print(\"No workshop specified in the recipe\")\n      return actions\n\n  else:\n    print(f\"Missing primitives: {missing_primitives}\")\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-10T23:06:32.995711", "function_name": "craft", "function_body": "  def pathfinding(grid, start, goal):\n    \"\"\"Performs A* search to find a path from start to goal.\"\"\"\n    queue = collections.deque([[start]])\n    seen = set([start])\n    while queue:\n        path = queue.popleft()\n        x, y = path[-1]\n        if (x, y) == goal:\n            return convert_path_to_actions(path)\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            nx, ny = x + dx, y + dy\n            if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n                if grid[nx, ny].sum() == 0 and (nx, ny) not in seen:\n                    queue.append(path + [(nx, ny)])\n                    seen.add((nx, ny))\n    return []\n\n  def convert_path_to_actions(path):\n      \"\"\"Converts a path of coordinates to actions.\"\"\"\n      actions = []\n      for i in range(len(path) - 1):\n          dx = path[i+1][0] - path[i][0]\n          dy = path[i+1][1] - path[i][1]\n          if dx == -1:\n              actions.append(2)  # LEFT\n          elif dx == 1:\n              actions.append(3)  # RIGHT\n          elif dy == -1:\n              actions.append(1)  # UP\n          elif dy == 1:\n              actions.append(0)  # DOWN\n      return actions\n\n  def collect_primitives(env, required_primitives):\n    \"\"\"Collects all required primitives.\"\"\"\n    actions = []\n    for primitive, count in required_primitives.items():\n        while env._current_state.inventory[primitive] < count:\n            # Find nearest cell containing the primitive.\n            target_positions = np.argwhere(env._current_state.grid[:, :, primitive] == 1)\n            if not target_positions.any():\n                return []  # Primitive not found.\n\n            closest_primitive = tuple(target_positions[np.argmin(np.linalg.norm(target_positions - env._current_state.pos, axis=1))])\n\n            # Generate actions to move the agent to the closest primitive.\n            actions_to_primitive = pathfinding(env._current_state.grid, env._current_state.pos, closest_primitive)\n            \n            if not actions_to_primitive:\n                return []  # No path found.\n\n            # Append the COLLECT action (assuming COLLECT is represented by a specific action index, e.g., 5).\n            actions.extend(actions_to_primitive + [5])\n\n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Retrieve all required primitives to craft the item.\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n\n  # Collect all required primitives if not already in inventory.\n  collect_actions = collect_primitives(env, required_primitives)\n  \n  # If unable to collect all required primitives, return an empty list.\n  if not collect_actions:\n    return []\n\n  # Identify the workshop needed to craft the item.\n  workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n        workshop_key = recipe.get(\"_at\")\n        if workshop_key is not None:\n            workshop_index = getattr(env.world, f\"{workshop_key}_index\", None)\n            break\n\n  # If no suitable workshop is found, return an empty list.\n  if workshop_index is None:\n    return []\n\n  # Locate the nearest workshop in the grid.\n  workshops = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n  # If no workshops are available, return an empty list.\n  if not workshops.any():\n    return []\n\n  # Find the closest workshop to the current agent's position.\n  distances = np.linalg.norm(workshops - env._current_state.pos, axis=1)\n  closest_workshop = tuple(workshops[np.argmin(distances)])\n\n  # Generate actions to move the agent to the closest workshop.\n  actions_to_workshop = pathfinding(env._current_state.grid, env._current_state.pos, closest_workshop)\n\n  # Append the USE action at the workshop to craft the item.\n  actions_to_workshop.append(4)  # Assuming 4 is the USE action.\n\n  return collect_actions + actions_to_workshop", "island_id": 0, "scores": {"3": 0.0}}
