world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  # If not all primitives are available return empty action list\n  if not all(primitive in inventory_dict and inventory_dict[primitive] >= required_primitives[primitive] for primitive in required_primitives):\n    return []\n  \n  # Find the workshop where we can craft this item\n  workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n      workshop_index = recipe.get(\"_at\")\n      break\n  \n  if workshop_index is None:\n    return []\n\n  # Find the position of the nearest workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(workshop_positions) == 0:\n    return []\n  \n  # Select the closest workshop (for simplicity, we take the first one found)\n  target_workshop_pos = tuple(min(workshop_positions, key=lambda x: abs(x[0] - env._current_state.pos[0]) + abs(x[1] - env._current_state.pos[1])))\n\n  # Navigate to the selected workshop\n  actions = navigate(env._current_state, target_workshop_pos)\n\n  # Turn towards the workshop if not already facing it\n  current_direction = env._current_state.dir\n  direction_to_workshop = turn_to_face(env._current_state, target_workshop_pos)\n  \n  # Check if we need to turn\n  if current_direction != direction_to_workshop:\n    actions.append(direction_to_workshop)\n\n  # Use the USE action to craft the item at the workshop\n  actions.append(4)  # Assuming 4 is the index for the USE action\n  \n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T01:48:03.898006", "function_name": "craft", "function_body": "  def navigate_to_position(grid: np.ndarray, agent_pos: tuple, target_pos: tuple) -> list[tuple[int, int]]:\n      \"\"\"Calculates the sequence of grid movements to move from agent's position to the target position using A*.\"\"\"\n      open_set = []\n      closed_set = set()\n      start_node = (agent_pos[0], agent_pos[1])\n      end_node = (target_pos[0], target_pos[1])\n\n      g_costs = {start_node: 0}\n      f_costs = {start_node: heuristic(start_node, end_node)}\n      came_from = {}\n\n      heapq.heappush(open_set, (f_costs[start_node], start_node))\n\n      while open_set:\n          _, current = heapq.heappop(open_set)\n\n          if current == end_node:\n              path = []\n              while current in came_from:\n                  path.append(current)\n                  current = came_from[current]\n              return path[::-1]\n\n          closed_set.add(current)\n\n          for neighbor in get_neighbors(grid, current):\n              tentative_g_cost = g_costs[current] + 1\n\n              if neighbor in closed_set and tentative_g_cost >= g_costs.get(neighbor, float('inf')):\n                  continue\n\n              if neighbor not in open_set or tentative_g_cost < g_costs.get(neighbor, float('inf')):\n                  came_from[neighbor] = current\n                  g_costs[neighbor] = tentative_g_cost\n                  f_costs[neighbor] = tentative_g_cost + heuristic(neighbor, end_node)\n                  heapq.heappush(open_set, (f_costs[neighbor], neighbor))\n\n      return []\n\n  def get_neighbors(grid: np.ndarray, position: tuple) -> list[tuple[int, int]]:\n      \"\"\"Returns the valid neighboring positions on the grid.\"\"\"\n      x, y = position\n      neighbors = [(x-1, y), (x+1, y), (x, y-1), (x, y+1)]\n      return [n for n in neighbors if 0 <= n[0] < grid.shape[0] and 0 <= n[1] < grid.shape[1] and grid[n[0], n[1]] > 0]\n\n  def heuristic(node: tuple, goal: tuple) -> int:\n      \"\"\"Calculates the Manhattan distance between two nodes.\"\"\"\n      return abs(node[0] - goal[0]) + abs(node[1] - goal[1])\n\n  actions = []\n\n  # Get the index for the goal item\n  goal_index = env.world.cookbook.index[item]\n\n  # Get the primitives required to make the goal item\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n\n  # Check if we have all the required primitives in inventory\n  for prim, count in required_primitives.items():\n    if env._current_state.inventory[prim] < count:\n      return []  # Return empty list if any primitive is not sufficient\n\n  # Identify the workshop where crafting should occur\n  workshop_index = None\n  for recipe_output, ingredients in env.world.cookbook.recipes.items():\n    if recipe_output == goal_index and \"_key\" in ingredients:\n      workshop_key = ingredients[\"_key\"]\n      workshop_index = env.world.cookbook.index[workshop_key]\n      break\n\n  if workshop_index is None:\n    return []  # No valid workshop found\n\n  # Locate the workshop on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    return []  # Workshop not found on the grid\n\n  # Navigate to the nearest workshop\n  agent_pos = env._current_state.pos\n  closest_workshop = min(workshop_positions, key=lambda x: np.linalg.norm(np.array(x) - np.array(agent_pos)))\n\n  path_to_workshop = navigate_to_position(env._current_state.grid, agent_pos, closest_workshop)\n  \n  if not path_to_workshop:\n      return []  # No valid path found\n\n  for dx, dy in path_to_workshop[1:]:  # Skip the first node as it's the current position\n    actions.append(direction_to_action(dx - agent_pos[0], dy - agent_pos[1]))\n    agent_pos = (dx, dy)\n\n  # Ensure the agent is facing the workshop before using it\n  final_directions = direction_to_action(closest_workshop[0] - agent_pos[0], closest_workshop[1] - agent_pos[1])\n\n  actions.extend(final_directions)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T01:48:04.979952", "function_name": "craft", "function_body": "  def navigate_to_position(agent_pos: tuple, target_pos: tuple, grid: np.ndarray):\n      \"\"\"Calculates the sequence of actions to move from agent's position to the target position using A* algorithm.\"\"\"\n      path = a_star(grid, agent_pos, target_pos)\n      if not path:\n          return []\n      \n      actions = []\n      for dx, dy in path:\n          if dx > 0:\n              actions.append(3)  # RIGHT\n          elif dx < 0:\n              actions.append(2)  # LEFT\n          elif dy > 0:\n              actions.append(4)  # DOWN\n          elif dy < 0:\n              actions.append(1)  # UP\n      \n      return actions\n\n  actions = []\n\n  # Get the index for the goal item\n  goal_index = env.world.cookbook.index[item]\n\n  # Get the primitives required to make the goal item\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n\n  # Check if we have all the required primitives in inventory\n  for prim, count in required_primitives.items():\n    if env._current_state.inventory[prim] < count:\n      return []  # Return empty list if any primitive is not sufficient\n\n  # Identify the workshop where crafting should occur\n  workshop_index = None\n  for recipe_output, ingredients in env.world.cookbook.recipes.items():\n    if recipe_output == goal_index and \"_key\" in ingredients:\n      workshop_key = ingredients[\"_key\"]\n      workshop_index = env.world.cookbook.index[workshop_key]\n      break\n\n  if workshop_index is None:\n    return []  # No valid workshop found\n\n  # Locate the workshop on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    return []  # Workshop not found on the grid\n\n  # Navigate to the nearest workshop\n  agent_pos = env._current_state.pos\n  closest_workshop = min(workshop_positions, key=lambda x: np.linalg.norm(np.array(x) - np.array(agent_pos)))\n\n  actions.extend(navigate_to_position(agent_pos, closest_workshop, env._current_state.grid))\n\n  # Ensure the agent is facing the workshop before using it\n  final_directions = []\n  if closest_workshop[0] == agent_pos[0]:\n    if closest_workshop[1] > agent_pos[1]:\n      final_directions.append(4)  # DOWN\n    else:\n      final_directions.append(1)  # UP\n  elif closest_workshop[1] == agent_pos[1]:\n    if closest_workshop[0] > agent_pos[0]:\n      final_directions.append(3)  # RIGHT\n    else:\n      final_directions.append(2)  # LEFT\n\n  actions.extend(final_directions)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T01:49:05.557685", "function_name": "craft", "function_body": "  # Fetching the index for the desired item\n  item_idx = env.world.cookbook.index[item]\n\n  # Fetching the recipe for the desired item\n  recipe = env.world.cookbook.recipes.get(item_idx, {})\n\n  if not recipe:\n    return []  # No recipe found for this item\n\n  # Check if the agent has all required primitives in its inventory\n  primitives_needed = env.world.cookbook.primitives_for(item_idx)\n  inventory = env._current_state.inventory\n\n  # Verify that we have enough of each primitive needed\n  for prim, count in primitives_needed.items():\n    if inventory[prim] < count:\n      return []  # Not enough primitives to craft the item\n\n  # Determine the workshop where crafting should occur\n  workshop_idx = None\n  for ingred, _ in recipe.items():\n    if ingred == \"_at\":\n      workshop_name = recipe[\"_at\"]\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      break\n\n  if workshop_idx is None:\n    return []  # Workshop not found in the recipe\n\n  # Find the location of the workshop on the grid\n  pos = env._current_state.pos\n  workshop_pos = None\n  for y in range(env.world.WIDTH):\n    for x in range(env.world.HEIGHT):\n      if env._current_state.grid[x, y, workshop_idx] > 0:\n        workshop_pos = (x, y)\n        break\n    if workshop_pos:\n      break\n\n  if workshop_pos is None:\n    return []  # Workshop not found on the grid\n\n  # Navigate to the workshop position\n  actions_to_workshop = navigate(env._current_state.pos, workshop_pos, env._current_state.grid)\n\n  # Face the correct direction towards the workshop\n  face_direction_action = face_towards(env._current_state.pos, workshop_pos, env._current_state.dir)\n\n  # Use action to craft the item at the workshop\n  use_action = env.world.N_ACTIONS - 1  # Assuming USE is the last defined action\n\n  # Combine all actions into a list\n  return actions_to_workshop + [face_direction_action] + [use_action]", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-11T01:49:06.557279", "function_name": "craft", "function_body": "  # Get the index of the item we want to craft\n  i_goal = env.world.cookbook.index[item]\n\n  # Check if the goal is a known primitive or can be crafted\n  if i_goal not in env.world.cookbook.recipes:\n    raise ValueError(f\"Unknown item {item}\")\n\n  # Dictionary to hold counts of required primitives/items\n  required_items = env.world.cookbook.primitives_for(i_goal)\n\n  actions_to_take = []\n\n  # Check inventory for the required items and collect if missing\n  for i_primitive, count in required_items.items():\n    while np.sum(env._current_state.inventory[i_primitive]) < count:\n      # Collect the primitive if it's not already in the inventory in sufficient quantity\n      collection_actions = collect_v2(env, env.world.cookbook.index.get(i_primitive))\n      actions_to_take.extend(collection_actions)\n\n  # Now that we have all the required primitives, proceed to craft the item\n  workshop_index = None\n  for recipe in env.world.cookbook.recipes[i_goal].items():\n    if \"_at\" in recipe:\n      workshop_name = recipe[\"_at\"]\n      workshop_index = getattr(env.world, f\"{workshop_name}_index\")\n      break\n\n  # Move to the nearest workshop and craft the item\n  # First find the nearest position of the required workshop\n  min_distance = float('inf')\n  target_pos = None\n  for x in range(env._current_state.grid.shape[0]):\n    for y in range(env._current_state.grid.shape[1]):\n      if env._current_state.grid[x, y, workshop_index] > 0:\n        distance = abs(x - env._current_state.pos[0]) + abs(y - env._current_state.pos[1])\n        if distance < min_distance:\n          min_distance = distance\n          target_pos = (x, y)\n\n  # Move to the nearest workshop position\n  move_actions = find_path(env._current_state, target_pos)\n  actions_to_take.extend(move_actions)\n\n  # Turn to face the workshop and use the USE action\n  turn_action = calculate_turn_action(env._current_state.pos, env._current_state.dir, target_pos)\n  if turn_action is not None:\n    actions_to_take.append(turn_action)\n\n  actions_to_take.append(craft.N_USE)\n\n  return actions_to_take", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-11T01:51:03.209884", "function_name": "craft", "function_body": "  def find_closest_entity(grid, pos, entity_index):\n    entities = np.argwhere(grid[:, :, entity_index] == 1)\n    if not entities.any():\n        return None\n    distances = np.linalg.norm(entities - pos, axis=1)\n    closest_entity = tuple(entities[np.argmin(distances)])\n    return closest_entity\n\n  def pathfinding(grid, start, end):\n    \"\"\"Basic A* pathfinding algorithm.\"\"\"\n    open_set = collections.deque([start])\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: np.linalg.norm(np.array(end) - np.array(start))}\n\n    while open_set:\n        current = min(open_set, key=lambda x: f_score[x])\n\n        if current == end:\n            path = []\n            while current in came_from:\n                path.append(current)\n                current = came_from[current]\n            return [move_towards(s[0], s[1], e[0], e[1]) for s, e in zip(path[::-1], path[1:])]\n\n        open_set.remove(current)\n\n        # Explore neighbors\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            neighbor = (current[0] + dx, current[1] + dy)\n            if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n                tentative_g_score = g_score[current] + np.linalg.norm(np.array(neighbor) - np.array(current))\n                if grid[neighbor] == 0 or (grid[neighbor] == env._current_state.grid[neighbor] == 1):\n                    continue\n                if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                    came_from[neighbor] = current\n                    g_score[neighbor] = tentative_g_score\n                    f_score[neighbor] = tentative_g_score + np.linalg.norm(np.array(end) - np.array(neighbor))\n                    open_set.append(neighbor)\n\n    return []\n\n  def move_towards(start_x, start_y, end_x, end_y):\n      \"\"\"Converts direction to action index.\"\"\"\n      if start_x < end_x:\n          return 3  # RIGHT\n      elif start_x > end_x:\n          return 2  # LEFT\n      elif start_y < end_y:\n          return 0  # DOWN\n      elif start_y > end_y:\n          return 1  # UP\n\n  item_index = env.world.cookbook.index[item]\n\n  # Retrieve all required primitives to craft the item.\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n\n  # Check if we have all the required primitives in our inventory.\n  missing_primitives = []\n  for primitive, count in required_primitives.items():\n    if env._current_state.inventory[primitive] < count:\n      missing_primitives.append(primitive)  # Collect missing primitives.\n\n  # If there are any missing primitives, return an empty list.\n  if missing_primitives:\n    return []\n\n  # Identify the workshop needed to craft the item.\n  workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n        workshop_key = recipe.get(\"_at\")\n        if workshop_key is not None:\n            workshop_index = getattr(env.world, f\"{workshop_key}_index\", None)\n            break\n\n  # If no suitable workshop is found, return an empty list.\n  if workshop_index is None:\n    return []\n\n  # Locate the nearest workshop in the grid.\n  closest_workshop = find_closest_entity(env._current_state.grid, env._current_state.pos, workshop_index)\n\n  # If no workshops are available, return an empty list.\n  if not closest_workshop:\n    return []\n\n  # Generate actions to move the agent to the closest workshop.\n  actions_to_workshop = pathfinding(env._current_state.grid, env._current_state.pos, closest_workshop)\n\n  # Append the USE action at the workshop to craft the item.\n  actions_to_workshop.append(4)  # Assuming 4 is the USE action.\n\n  return actions_to_workshop", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T01:51:04.286630", "function_name": "craft", "function_body": "  def pathfinding(grid, start, end):\n    \"\"\"Simple BFS to find a path from start to end in a grid.\"\"\"\n    queue = collections.deque([(start, [])])\n    visited = set([start])\n\n    while queue:\n        (x, y), path = queue.popleft()\n        if (x, y) == end:\n            return path\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            nx, ny = x + dx, y + dy\n            if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and (nx, ny) not in visited and np.all(grid[nx, ny] == 0):\n                queue.append(((nx, ny), path + [convert_direction(dx, dy)]))\n                visited.add((nx, ny))\n\n    return []  # No path found\n\n  def convert_direction(dx, dy):\n      \"\"\"Converts a direction vector to an action index.\"\"\"\n      if dx == -1: return 2  # LEFT\n      elif dx == 1: return 3  # RIGHT\n      elif dy == -1: return 0  # DOWN\n      elif dy == 1: return 1  # UP\n\n  item_index = env.world.cookbook.index[item]\n\n  # Retrieve all required primitives to craft the item.\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n\n  # Check if we have all the required primitives in our inventory.\n  missing_primitives = []\n  for primitive, count in required_primitives.items():\n    if env._current_state.inventory[primitive] < count:\n      missing_primitives.append(primitive)  # Collect missing primitives.\n\n  # If there are any missing primitives, return an empty list.\n  if missing_primitives:\n    return []\n\n  # Identify the workshop needed to craft the item.\n  workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n        workshop_key = recipe.get(\"_at\")\n        if workshop_key is not None:\n            workshop_index = getattr(env.world, f\"{workshop_key}_index\", None)\n            break\n\n  # If no suitable workshop is found, return an empty list.\n  if workshop_index is None:\n    return []\n\n  # Locate the nearest workshop in the grid.\n  workshops = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n  # If no workshops are available, return an empty list.\n  if not workshops.any():\n    return []\n\n  # Find the closest workshop to the current agent's position.\n  distances = np.linalg.norm(workshops - env._current_state.pos, axis=1)\n  closest_workshop = tuple(workshops[np.argmin(distances)])\n\n  # Generate actions to move the agent to the closest workshop.\n  actions_to_workshop = pathfinding(env._current_state.grid, env._current_state.pos, closest_workshop)\n\n  # Append the USE action at the workshop to craft the item.\n  actions_to_workshop.append(4)  # Assuming 4 is the USE action.\n\n  return actions_to_workshop", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T01:53:15.587571", "function_name": "craft", "function_body": "  def move_to_target(grid, pos, target):\n    \"\"\"Moves the agent to the nearest cell containing the target item.\"\"\"\n    queue = collections.deque([(pos[0], pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n      \n      if (x, y) in visited or grid[x, y, target] == 1:\n        return path\n      \n      visited.add((x, y))\n      \n      # Explore neighbors\n      for dx, dy, action in [(0, -1, 2), (0, 1, 3), (-1, 0, 0), (1, 0, 1)]:  # LEFT, RIGHT, UP, DOWN\n        nx, ny = x + dx, y + dy\n        \n        if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n          queue.append((nx, ny, path + [action]))\n    \n    return []\n\n  def collect_primitives(env, required_primitives):\n    \"\"\"Collects all required primitives from the environment.\"\"\"\n    actions = []\n    for primitive, count in required_primitives.items():\n      while env._current_state.inventory[primitive] < count:\n        # Find the nearest cell containing the primitive\n        primitive_pos = move_to_target(env._current_state.grid, env._current_state.pos, primitive)\n        if not primitive_pos:\n          return []  # Return empty list if no primitive is found.\n        \n        actions.extend(primitive_pos + [4])  # Move to the primitive and collect it\n        \n        # Update the state after collecting the primitive\n        _, env._current_state = env.step(4)  # Assuming USE action is 4\n    \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Get all the primitives required to craft the item.\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  \n  # Collect all required primitives\n  collect_actions = collect_primitives(env, required_primitives)\n  if not collect_actions:\n    return []  # Return empty list if collecting any primitive fails.\n\n  # Find the workshop that can be used to craft the item.\n  workshop = None\n  for recipe in env.world.cookbook.recipes.values():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n      workshop_key = recipe.get(\"_at\")\n      if workshop_key is not None:\n        workshop = getattr(env.world, f\"{workshop_key}_index\", None)\n        break\n  \n  # If no suitable workshop is found, return an empty list.\n  if workshop is None:\n    return []\n\n  # Move to the nearest workshop\n  actions_to_workshop = move_to_target(env._current_state.grid, env._current_state.pos, workshop)\n  \n  # Use the USE action at the workshop to craft the item.\n  actions_to_workshop.append(4)  # 4 corresponds to the USE action.\n  \n  return collect_actions + actions_to_workshop", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-11T01:53:16.583652", "function_name": "craft", "function_body": "  def move_to_target(grid, pos, target):\n    \"\"\"Moves the agent to the nearest cell containing the target item.\"\"\"\n    queue = collections.deque([(pos[0], pos[1], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n      \n      if (x, y) in visited or grid[x, y, target] == 1:\n        return path\n      \n      visited.add((x, y))\n      \n      # Explore neighbors\n      for dx, dy, action in [(0, -1, 2), (0, 1, 3), (-1, 0, 0), (1, 0, 1)]:  # LEFT, RIGHT, UP, DOWN\n        nx, ny = x + dx, y + dy\n        \n        if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n          queue.append((nx, ny, path + [action]))\n    \n    return []\n\n  def collect_primitives(env, required_primitives):\n    actions = []\n    for primitive, count in required_primitives.items():\n      while env._current_state.inventory[primitive] < count:\n        # Find the nearest source of the required primitive\n        actions_to_primitive = move_to_target(env._current_state.grid, env._current_state.pos, primitive)\n        \n        if not actions_to_primitive:\n          return []  # Return empty list if no path to the required primitive is found.\n        \n        # Collect the primitive by using the USE action at its location\n        actions += actions_to_primitive + [4]  # Append USE action\n        \n        # Update the environment state after collecting the primitive\n        env._current_state = CraftState.step(env._current_state, 4)\n    \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Get all the primitives required to craft the item.\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  \n  # Collect any missing primitives\n  actions_to_collect_primitives = collect_primitives(env, required_primitives)\n  \n  if not actions_to_collect_primitives:\n    return []  # Return empty list if no path to the required primitives is found.\n  \n  # Find the workshop that can be used to craft the item.\n  workshop = None\n  for recipe in env.world.cookbook.recipes.values():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n      workshop_key = recipe.get(\"_at\")\n      if workshop_key is not None:\n        workshop = getattr(env.world, f\"{workshop_key}_index\", None)\n        break\n  \n  # If no suitable workshop is found, return an empty list.\n  if workshop is None:\n    return []\n\n  # Move to the nearest workshop\n  actions_to_workshop = move_to_target(env._current_state.grid, env._current_state.pos, workshop)\n  \n  # Use the USE action at the workshop to craft the item.\n  actions_to_workshop.append(4)  # 4 corresponds to the USE action.\n\n  return actions_to_collect_primitives + actions_to_workshop", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-11T01:54:31.420547", "function_name": "craft", "function_body": "  # Extract the current state from the environment\n  current_state = env._current_state\n\n  # Get the index of the desired item\n  goal_index = env.world.cookbook.index[item]\n\n  # Check if we have all required primitives for crafting the item\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n\n  actions = []\n\n  # Collect missing primitives\n  for primitive, count in required_primitives.items():\n    while current_state.inventory[primitive] < count:\n      actions.extend(collect_v2(env, env.world.cookbook.index.get(primitive)))\n\n  # Determine the workshop to craft the item\n  workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n    if goal_index == recipe.get('_key'):\n      workshop_index = list(recipe.keys())[0]\n      break\n\n  if workshop_index is not None:\n    actions.extend(navigate_to_v2(env, workshop_index))\n    actions.append(4)  # USE action to craft the item at the workshop\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-11T01:54:32.425786", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  goal_index = env.world.cookbook.index[item]\n\n  # Check if there is a recipe for the desired item\n  if goal_index not in env.world.cookbook.recipes:\n    print(f\"No recipe found for {item}.\")\n    return []\n\n  # Collect all required primitives and intermediate items\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  actions = []\n  \n  def collect_primitive(primitive_name):\n      primitive_index = env.world.cookbook.index[primitive_name]\n      if env._current_state.inventory[primitive_index] == 0:\n          # Find the nearest cell with this primitive\n          x, y = env._current_state.pos\n          grid = env._current_state.grid\n          found = False\n          for dx in range(-3, 4):\n              for dy in range(-3, 4):\n                  nx, ny = x + dx, y + dy\n                  if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n                      if grid[nx, ny, primitive_index] == 1:\n                          # Move to the cell with this primitive\n                          actions.extend(move_towards(env._current_state.pos, (nx, ny)))\n                          actions.append(4)  # USE action to collect the primitive\n                          found = True\n                          break\n              if found:\n                  break\n\n  for primitive_name, count in required_primitives.items():\n      while env._current_state.inventory[env.world.cookbook.index[primitive_name]] < count:\n          collect_primitive(primitive_name)\n  \n  # Find and move to the workshop specified in the recipe\n  workshop_index = None\n  recipe = env.world.cookbook.recipes[goal_index]\n  for key, value in recipe.items():\n      if key == \"_key\":\n          workshop_index = env.world.workshop_indices[value]\n\n  if workshop_index is None:\n      print(\"No valid workshop specified in the recipe.\")\n      return actions\n  \n  # Move to the nearest cell with the specified workshop\n  x, y = env._current_state.pos\n  grid = env._current_state.grid\n  found_workshop = False\n  for dx in range(-3, 4):\n      for dy in range(-3, 4):\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n              if grid[nx, ny, workshop_index] == 1:\n                  actions.extend(move_towards(env._current_state.pos, (nx, ny)))\n                  found_workshop = True\n                  break\n      if found_workshop:\n          break\n\n  # If a workshop is found, perform the USE action to craft the item\n  if found_workshop:\n      actions.append(4)  # USE action to craft the item\n  \n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-11T01:56:17.297062", "function_name": "craft", "function_body": "  def has_all_primitives(required_primitives, inventory_dict):\n    return all(primitive in inventory_dict and inventory_dict[primitive] >= required_primitives[primitive] for primitive in required_primitives)\n\n  actions = []\n  \n  # Get the index of the goal item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  # If not all primitives are available return empty action list\n  if not has_all_primitives(required_primitives, inventory_dict):\n    return []\n  \n  # Find the workshop where we can craft this item\n  workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n      workshop_index = recipe.get(\"_at\")\n      break\n  \n  if workshop_index is None:\n    return []\n\n  # Convert workshop index to the actual name of the workshop\n  workshop_name = env.world.cookbook.index.get(workshop_index)\n  \n  # Find the position of the nearest workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(workshop_positions) == 0:\n    return []\n  \n  # Select the closest workshop (for simplicity, we take the first one found)\n  target_workshop_pos = tuple(workshop_positions[0])\n\n  # Navigate to the selected workshop\n  actions.extend(navigate(env._current_state, target_workshop_pos))\n  \n  # Turn towards the workshop if not already facing it\n  current_direction = env._current_state.dir\n  direction_to_workshop = get_direction(env._current_state.pos, target_workshop_pos)\n  if current_direction != direction_to_workshop:\n    actions.append(direction_to_workshop)\n\n  # Use the USE action to craft the item at the workshop\n  actions.append(4)  # Assuming 4 is the index for the USE action\n  \n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T01:56:18.396211", "function_name": "craft", "function_body": "  def has_all_primitives(required_primitives, inventory_dict):\n    return all(primitive in inventory_dict and inventory_dict[primitive] >= required_primitives[primitive] for primitive in required_primitives)\n\n  actions = []\n  \n  # Get the index of the goal item\n  try:\n    item_index = env.world.cookbook.index[item]\n  except KeyError:\n    print(f\"Item {item} not found in cookbook.\")\n    return []\n\n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  # If not all primitives are available return empty action list\n  if not has_all_primitives(required_primitives, inventory_dict):\n    print(f\"Not enough primitives to craft {item}.\")\n    return []\n  \n  # Find the workshop where we can craft this item\n  workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n      workshop_index = recipe.get(\"_at\")\n      break\n  \n  if workshop_index is None:\n    print(f\"No workshop found to craft {item}.\")\n    return []\n\n  # Convert workshop index to the actual name of the workshop\n  workshop_name = env.world.cookbook.index.get(workshop_index)\n  \n  # Find the position of the nearest workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(workshop_positions) == 0:\n    print(f\"No {workshop_name} found in the grid.\")\n    return []\n  \n  # Select the closest workshop (for simplicity, we take the first one found)\n  target_workshop_pos = tuple(workshop_positions[0])\n\n  # Navigate to the selected workshop\n  navigation_actions = navigate(env._current_state, target_workshop_pos)\n  if not navigation_actions:\n    print(f\"Could not find a path to {workshop_name}.\")\n    return []\n  \n  actions.extend(navigation_actions)\n  \n  # Turn towards the workshop if not already facing it\n  current_direction = env._current_state.dir\n  direction_to_workshop = get_direction(env._current_state.pos, target_workshop_pos)\n  if current_direction != direction_to_workshop:\n    actions.append(direction_to_workshop)\n\n  # Use the USE action to craft the item at the workshop\n  actions.append(4)  # Assuming 4 is the index for the USE action\n  \n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-11T01:58:41.338186", "function_name": "craft", "function_body": "  def find_workshop_position(grid, workshop_name, cookbook_index):\n    \"\"\"Find the position of a specific workshop in the grid.\"\"\"\n    workshop_index = cookbook_index[workshop_name]\n    pos_list = np.argwhere(grid[:, :, workshop_index] > 0)\n    if len(pos_list) == 0:\n      raise ValueError(f\"No available {workshop_name} to navigate to.\")\n    return tuple(pos_list[0])\n\n  def find_item_positions(grid, target_indices):\n    \"\"\"Find all positions of specific items in the grid.\"\"\"\n    positions = []\n    for idx in target_indices:\n      pos_list = np.argwhere(grid[:, :, idx] > 0).tolist()\n      positions.extend(pos_list)\n    return positions\n\n  def navigate_to_position(env, target_pos):\n    \"\"\"Navigate to a given position on the grid.\"\"\"\n    actions = []\n    current_x, current_y = env._current_state.pos\n    target_x, target_y = target_pos\n    \n    # Calculate the direction to move\n    dx = target_x - current_x\n    dy = target_y - current_y\n    \n    if dy < 0:\n      actions.extend([env.world.N_ACTIONS - 5] * abs(dy))  # UP action\n    elif dy > 0:\n      actions.extend([env.world.N_ACTIONS - 4] * abs(dy))  # DOWN action\n    \n    if dx < 0:\n      actions.extend([env.world.N_ACTIONS - 6] * abs(dx))  # LEFT action\n    elif dx > 0:\n      actions.extend([env.world.N_ACTIONS - 3] * abs(dx))  # RIGHT action\n    \n    return actions\n\n  def ensure_correct_facing_direction(env, target_pos):\n    \"\"\"Ensure the agent is facing the correct direction before using the workshop.\"\"\"\n    actions = []\n    current_x, current_y = env._current_state.pos\n    target_x, target_y = target_pos\n    \n    if target_x > current_x:\n      actions.append(env.world.N_ACTIONS - 3)  # RIGHT action\n    elif target_x < current_x:\n      actions.append(env.world.N_ACTIONS - 6)  # LEFT action\n    elif target_y > current_y:\n      actions.append(env.world.N_ACTIONS - 4)  # DOWN action\n    elif target_y < current_y:\n      actions.append(env.world.N_ACTIONS - 5)  # UP action\n    \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the goal item is a primitive or not in the recipes\n  if item_index in env.world.grabbable_indices:\n    return []  # Primitives cannot be crafted\n  \n  # Retrieve the recipe for the desired item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Determine the workshop required for crafting\n  workshop_key = \"_at\"\n  workshop_name = recipe.get(workshop_key)\n  if workshop_name is None:\n    raise ValueError(f\"No workshop specified for crafting {item}.\")\n  \n  workshop_index = env.world.cookbook.index[workshop_name]\n  workshop_pos = find_workshop_position(env._current_state.grid, workshop_name, env.world.cookbook.index)\n\n  # Determine the list of required primitives or intermediate items\n  required_items = {env.world.cookbook.index[key]: value for key, value in recipe.items() if isinstance(key, str)}\n\n  actions = []\n\n  # Collect all required items\n  for req_item_index, count in required_items.items():\n    while env._current_state.inventory[req_item_index] < count:\n      item_positions = find_item_positions(env._current_state.grid, [req_item_index])\n      \n      if not item_positions:\n        raise ValueError(f\"No available {env.world.cookbook.get(req_item_index)} to collect.\")\n      \n      for pos in item_positions:\n        actions.extend(navigate_to_position(env, tuple(pos)))\n        \n        # Check if the agent is next to an item\n        if env._current_state.next_to(req_item_index):\n          actions.append(env.world.N_ACTIONS - 1)  # USE action\n        \n        if env._current_state.inventory[req_item_index] >= count:\n          break\n\n  # Navigate to the workshop and use it to craft the item\n  actions.extend(navigate_to_position(env, workshop_pos))\n  actions.extend(ensure_correct_facing_direction(env, workshop_pos))\n  actions.append(env.world.N_ACTIONS - 1)  # USE action\n  \n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T01:58:42.392945", "function_name": "craft", "function_body": "  def find_workshop_position(env, workshop_name):\n    \"\"\"Find the position of a specific workshop in the grid.\"\"\"\n    workshop_index = env.world.cookbook.index[workshop_name]\n    pos_list = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n    if len(pos_list) == 0:\n      raise ValueError(f\"No available {workshop_name} to navigate to.\")\n    return tuple(pos_list[0])\n\n  def find_item_positions(env, item_index):\n    \"\"\"Find all positions of specific items in the grid.\"\"\"\n    return np.argwhere(env._current_state.grid[:, :, item_index] > 0).tolist()\n\n  def navigate_to_position(env, target_pos):\n    \"\"\"Generate actions to move the agent to a target position.\"\"\"\n    actions = []\n    current_x, current_y = env._current_state.pos\n    target_x, target_y = target_pos\n    \n    # Calculate the direction to move\n    dx = target_x - current_x\n    dy = target_y - current_y\n\n    if dy < 0:\n      actions.extend([env.world.N_ACTIONS - 5] * abs(dy))  # UP action\n    elif dy > 0:\n      actions.extend([env.world.N_ACTIONS - 2] * abs(dy))  # DOWN action\n    \n    if dx < 0:\n      actions.extend([env.world.N_ACTIONS - 6] * abs(dx))  # LEFT action\n    elif dx > 0:\n      actions.extend([env.world.N_ACTIONS - 3] * abs(dx))  # RIGHT action\n    \n    return actions\n\n  def ensure_correct_facing_direction(env, target_pos):\n    \"\"\"Ensure the agent is facing the correct direction before using the workshop.\"\"\"\n    dx = target_pos[0] - env._current_state.pos[0]\n    dy = target_pos[1] - env._current_state.pos[1]\n\n    if dx == 1:\n      return [env.world.N_ACTIONS - 3]  # RIGHT action\n    elif dx == -1:\n      return [env.world.N_ACTIONS - 6]  # LEFT action\n    elif dy == 1:\n      return [env.world.N_ACTIONS - 2]  # DOWN action\n    elif dy == -1:\n      return [env.world.N_ACTIONS - 5]  # UP action\n    else:\n      return []\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the goal item is a primitive or not in the recipes\n  if item_index in env.world.grabbable_indices:\n    return []  # Primitives cannot be crafted\n  \n  # Retrieve the recipe for the desired item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Determine the workshop required for crafting\n  workshop_key = \"_at\"\n  workshop_name = next((k.split('_')[1] for k in recipe if k.startswith(workshop_key)), None)\n  if not workshop_name:\n    raise ValueError(f\"No workshop specified for crafting {item}.\")\n  \n  workshop_pos = find_workshop_position(env, f\"workshop{workshop_name}\")\n\n  actions = []\n\n  # Collect all required primitives or intermediate items\n  for req_item_name, count in recipe.items():\n      if isinstance(req_item_name, str) and not req_item_name.startswith('_'):\n          while env._current_state.inventory[env.world.cookbook.index[req_item_name]] < count:\n              item_positions = find_item_positions(env, env.world.cookbook.index[req_item_name])\n              \n              if not item_positions:\n                  raise ValueError(f\"No available {req_item_name} to collect.\")\n              \n              for pos in item_positions:\n                  actions.extend(navigate_to_position(env, tuple(pos)))\n                  \n                  # Check if the agent is next to an item\n                  if env._current_state.next_to(env.world.cookbook.index[req_item_name]):\n                      actions.append(env.world.N_ACTIONS - 1)  # USE action\n                  \n                  if env._current_state.inventory[env.world.cookbook.index[req_item_name]] >= count:\n                      break\n\n  # Navigate to the workshop and ensure correct facing direction before using it\n  actions.extend(navigate_to_position(env, workshop_pos))\n  actions.extend(ensure_correct_facing_direction(env, workshop_pos))\n  actions.append(env.world.N_ACTIONS - 1)  # USE action\n\n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T02:01:45.204349", "function_name": "craft", "function_body": "  def bfs_navigation(start, goal, grid):\n    \"\"\"Navigate using BFS and return the path.\"\"\"\n    queue = collections.deque([start])\n    visited = set()\n    parent = {start: None}\n\n    while queue:\n        current_pos = queue.popleft()\n\n        if tuple(current_pos) == tuple(goal):\n            path = []\n            while current_pos is not None:\n                path.append(current_pos)\n                current_pos = parent[current_pos]\n            return path[::-1]\n\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n            width, height = grid.shape[:2]\n            if 0 <= new_x < width and 0 <= new_y < height and grid[new_x, new_y].sum() == 0 and (new_x, new_y) not in visited:\n                queue.append((new_x, new_y))\n                visited.add((new_x, new_y))\n                parent[(new_x, new_y)] = current_pos\n    return None\n\n  def navigate(env, target):\n    \"\"\"Navigate the agent to a specific position.\"\"\"\n    pos = env._current_state.pos\n    grid = env._current_state.grid\n    path = bfs_navigation(pos, target, grid)\n    \n    if not path:\n      return []  # No valid path found\n\n    actions = []\n    for next_pos in path[1:]:\n        dx = next_pos[0] - pos[0]\n        dy = next_pos[1] - pos[1]\n\n        if dx < 0:\n            actions.append(env.world.N_ACTIONS - 4)  # UP action\n        elif dx > 0:\n            actions.append(env.world.N_ACTIONS - 3)  # DOWN action\n        elif dy < 0:\n            actions.append(env.world.N_ACTIONS - 2)  # LEFT action\n        elif dy > 0:\n            actions.append(env.world.N_ACTIONS - 5)  # RIGHT action\n\n        pos = next_pos\n    \n    return actions\n  \n  def collect_primitive(env, primitive_name):\n    \"\"\"Collect the specified primitive.\"\"\"\n    primitive_index = env.world.cookbook.index[primitive_name]\n    \n    if primitive_index not in env.world.grabbable_indices:\n      raise ValueError(f\"{primitive_name} is not a grabbable item.\")\n    \n    # Check if already have the required amount of the primitive\n    required_amount = recipe.get(primitive_name, 0)\n    current_amount = env._current_state.inventory[primitive_index]\n    \n    if current_amount >= required_amount:\n      return []\n\n    actions = []\n    grid = env._current_state.grid\n\n    while current_amount < required_amount:\n      if env._current_state.next_to(primitive_index):\n        actions.append(env.world.N_ACTIONS - 1)  # USE action\n        current_amount += 1\n      else:\n        target_positions = np.argwhere(grid[:, :, primitive_index] > 0).tolist()\n        \n        if not target_positions:\n          raise ValueError(f\"No available {primitive_name} to collect.\")\n        \n        closest_target_pos = min(target_positions, key=lambda x: abs(x[0] - env._current_state.pos[0]) + abs(x[1] - env._current_state.pos[1]))\n        actions.extend(navigate(env, closest_target_pos))\n    \n    return actions\n\n  def craft_item_at_workshop(env, workshop_name):\n    \"\"\"Craft the item at the specified workshop.\"\"\"\n    workshop_index = env.world.cookbook.index[workshop_name]\n    \n    if not env._current_state.next_to(workshop_index):\n      target_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0).tolist()\n      \n      if not target_positions:\n        raise ValueError(f\"No available {workshop_name} to navigate to.\")\n      \n      closest_workshop_pos = min(target_positions, key=lambda x: abs(x[0] - env._current_state.pos[0]) + abs(x[1] - env._current_state.pos[1]))\n      actions = navigate(env, closest_workshop_pos)\n    else:\n      actions = []\n      \n    actions.append(env.world.N_ACTIONS - 1)  # USE action\n    \n    return actions\n\n  def get_recipe_for_item(env, item):\n    \"\"\"Retrieve the recipe for the specified item.\"\"\"\n    cookbook = env.world.cookbook\n    item_index = cookbook.index[item]\n    \n    if item_index in cookbook.recipes:\n      return cookbook.recipes[item_index]\n    else:\n      raise ValueError(f\"No recipe available for {item}.\")\n\n  def get_primitives_needed_for_recipe(env, recipe):\n    \"\"\"Extract the primitives needed from a recipe.\"\"\"\n    primitives_needed = {}\n    for req_item_name, count in recipe.items():\n        if isinstance(req_item_name, str) and not req_item_name.startswith('_'):\n            primitives_needed[req_item_name] = count\n    return primitives_needed\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the goal item is a primitive or not in the recipes\n  if item_index in env.world.grabbable_indices:\n    return []  # Primitives cannot be crafted\n  \n  # Retrieve the recipe for the desired item\n  recipe = get_recipe_for_item(env, item)\n\n  # Determine the workshop required for crafting\n  workshop_key = \"_at\"\n  workshop_name = next((k.split('_')[1] for k in recipe if k.startswith(workshop_key)), None)\n  \n  if not workshop_name:\n    raise ValueError(f\"No workshop specified for crafting {item}.\")\n  \n  primitives_needed = get_primitives_needed_for_recipe(env, recipe)\n\n  actions = []\n\n  # Collect all required primitives or intermediate items\n  for req_item_name, count in primitives_needed.items():\n      while env._current_state.inventory[env.world.cookbook.index[req_item_name]] < count:\n          actions.extend(collect_primitive(env, req_item_name))\n\n  # Craft the item at the workshop\n  actions.extend(craft_item_at_workshop(env, f\"workshop{workshop_name}\"))\n\n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T02:01:46.269579", "function_name": "craft", "function_body": "  def navigate(env, target_pos):\n      \"\"\"Navigate the agent to a specific position using BFS.\"\"\"\n      pos = env._current_state.pos\n      dir_ = env._current_state.dir\n\n      grid = env._current_state.grid\n      width, height = grid.shape[:2]\n      \n      queue = collections.deque([pos])\n      visited = set()\n      parent = {pos: None}\n\n      while queue:\n          current_pos = queue.popleft()\n\n          if tuple(current_pos) == tuple(target_pos):\n              # Reconstruct path from start to target\n              path = []\n              while current_pos is not None:\n                  path.append(current_pos)\n                  current_pos = parent[current_pos]\n              return path[::-1]\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n              if 0 <= new_x < width and 0 <= new_y < height:\n                  if grid[new_x, new_y].sum() == 0 and (new_x, new_y) not in visited:\n                      queue.append((new_x, new_y))\n                      visited.add((new_x, new_y))\n                      parent[(new_x, new_y)] = current_pos\n      return None\n\n  def navigate_to_item(env, item_index):\n    \"\"\"Navigate the agent to an item using BFS.\"\"\"\n    grid = env._current_state.grid\n    target_positions = np.argwhere(grid[:, :, item_index] > 0).tolist()\n    \n    if not target_positions:\n      return []  # No targets found\n\n    closest_target_pos = min(target_positions, key=lambda x: abs(x[0] - env._current_state.pos[0]) + abs(x[1] - env._current_state.pos[1]))\n    path = navigate(env, closest_target_pos)\n    \n    if not path:\n      return []  # No valid path found\n\n    actions = []\n    for next_pos in path[1:]:\n        dx = next_pos[0] - env._current_state.pos[0]\n        dy = next_pos[1] - env._current_state.pos[1]\n\n        if dx < 0:\n            actions.append(env.world.N_ACTIONS - 4)  # UP action\n        elif dx > 0:\n            actions.append(env.world.N_ACTIONS - 3)  # DOWN action\n        elif dy < 0:\n            actions.append(env.world.N_ACTIONS - 2)  # LEFT action\n        elif dy > 0:\n            actions.append(env.world.N_ACTIONS - 5)  # RIGHT action\n\n    return actions\n\n  def collect_primitive(env, primitive_name):\n    \"\"\"Collect the specified primitive.\"\"\"\n    primitive_index = env.world.cookbook.index[primitive_name]\n    \n    if primitive_index not in env.world.grabbable_indices:\n      raise ValueError(f\"{primitive_name} is not a grabbable item.\")\n    \n    # Check if already have the required amount of the primitive\n    if env._current_state.inventory[primitive_index] >= recipe.get(primitive_name, 0):\n      return []\n    \n    actions = []\n\n    while env._current_state.inventory[primitive_index] < recipe.get(primitive_name, 0):\n      if env._current_state.next_to(primitive_index):\n        actions.append(env.world.N_ACTIONS - 1)  # USE action\n      else:\n        actions.extend(navigate_to_item(env, primitive_index))\n    \n    return actions\n\n  def navigate_to_workshop(env, workshop_name):\n    \"\"\"Navigate the agent to a specific workshop.\"\"\"\n    workshop_index = env.world.cookbook.index[workshop_name]\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n    \n    if len(positions) == 0:\n      raise ValueError(f\"No available {workshop_name} to navigate to.\")\n    \n    closest_workshop_pos = min(positions, key=lambda x: abs(x[0] - env._current_state.pos[0]) + abs(x[1] - env._current_state.pos[1]))\n    path = navigate(env, closest_workshop_pos)\n    \n    if not path:\n      return []  # No valid path found\n\n    actions = []\n    for next_pos in path[1:]:\n        dx = next_pos[0] - env._current_state.pos[0]\n        dy = next_pos[1] - env._current_state.pos[1]\n\n        if dx < 0:\n            actions.append(env.world.N_ACTIONS - 4)  # UP action\n        elif dx > 0:\n            actions.append(env.world.N_ACTIONS - 3)  # DOWN action\n        elif dy < 0:\n            actions.append(env.world.N_ACTIONS - 2)  # LEFT action\n        elif dy > 0:\n            actions.append(env.world.N_ACTIONS - 5)  # RIGHT action\n\n    return actions\n  \n  def craft_item_at_workshop(env, workshop_name):\n    \"\"\"Craft the item at the specified workshop.\"\"\"\n    workshop_index = env.world.cookbook.index[workshop_name]\n    \n    if not env._current_state.next_to(workshop_index):\n      actions = navigate_to_workshop(env, workshop_name)\n    else:\n      actions = []\n      \n    actions.append(env.world.N_ACTIONS - 1)  # USE action\n    \n    return actions\n\n  def get_recipe_for_item(env, item):\n    \"\"\"Retrieve the recipe for the specified item.\"\"\"\n    cookbook = env.world.cookbook\n    item_index = cookbook.index[item]\n    \n    if item_index in cookbook.recipes:\n      return cookbook.recipes[item_index]\n    else:\n      raise ValueError(f\"No recipe available for {item}.\")\n\n  def get_primitives_needed_for_recipe(env, recipe):\n    \"\"\"Extract the primitives needed from a recipe.\"\"\"\n    primitives_needed = {}\n    for req_item_name, count in recipe.items():\n        if isinstance(req_item_name, str) and not req_item_name.startswith('_'):\n            primitives_needed[req_item_name] = count\n    return primitives_needed\n\n  def collect_all_primitives(env, primitives_needed):\n    \"\"\"Collect all required primitives for the recipe.\"\"\"\n    actions = []\n    for primitive_name, count in primitives_needed.items():\n        while env._current_state.inventory[env.world.cookbook.index[primitive_name]] < count:\n            actions.extend(collect_primitive(env, primitive_name))\n    return actions\n\n  def get_workshop_from_recipe(recipe):\n      \"\"\"Determine the workshop required from the recipe.\"\"\"\n      for key in recipe:\n          if key.startswith('_at'):\n              workshop_id = key.split('_')[1]\n              if workshop_id.isdigit():\n                  workshop_key = f\"workshop{workshop_id}\"\n                  return workshop_key\n      raise ValueError(\"No valid workshop specified in the recipe.\")\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the goal item is a primitive or not in the recipes\n  if item_index in env.world.grabbable_indices:\n    return []  # Primitives cannot be crafted\n  \n  # Retrieve the recipe for the desired item\n  recipe = get_recipe_for_item(env, item)\n\n  # Determine the workshop required for crafting\n  workshop_name = get_workshop_from_recipe(recipe)\n  \n  primitives_needed = get_primitives_needed_for_recipe(env, recipe)\n\n  actions = []\n\n  # Collect all required primitives or intermediate items\n  actions.extend(collect_all_primitives(env, primitives_needed))\n\n  # Craft the item at the workshop\n  actions.extend(craft_item_at_workshop(env, workshop_name))\n\n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T02:02:22.552761", "function_name": "craft", "function_body": "  def find_required_primitives(item_index):\n    required_primitives = env.world.cookbook.primitives_for(item_index)\n    for primitive, count in required_primitives.items():\n      if not check_inventory(primitive, count):\n        return False\n    return True\n\n  def check_inventory(primitive, required_count):\n    current_count = env._current_state.inventory[primitive]\n    return current_count >= required_count\n\n  item_index = env.world.cookbook.index[item]\n  if not find_required_primitives(item_index):\n    return []\n\n  # Find the workshop index where the item should be crafted\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_key = \"_key\" if \"_key\" in recipe else list(recipe.keys())[0]  # Assuming _key is used for specifying location or some other key is used\n  workshop_name = parse_fexp(workshop_key)[1]\n  workshop_index = getattr(env.world, f\"{workshop_name}_index\")\n\n  # Navigate to the nearest workshop and perform USE action\n  actions_to_workshop = navigate_to_nearest(env, workshop_index)\n  actions_to_use = [craft.USE]\n\n  return actions_to_workshop + actions_to_use", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-11T02:02:23.517741", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the items/primitives required for crafting\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  actions = []\n\n  # Collect missing primitives\n  for primitive, count in primitives_needed.items():\n    while env._current_state.inventory[primitive] < count:\n      primitive_name = env.world.cookbook.index.get(primitive)\n      collect_actions = collect(env, primitive_name)\n      actions.extend(collect_actions)\n\n  # Determine the workshop and perform crafting\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_index = None\n\n  for ingredient, count in recipe.items():\n    if ingredient.startswith(\"_at\"):\n      workshop_index = int(ingredient.split(\"_at\")[1])\n      break\n\n  if workshop_index is not None:\n    # Navigate to the specified workshop\n    workshop_name = f\"workshop{workshop_index}\"\n    workshop_idx = env.world.cookbook.index[workshop_name]\n    move_actions = navigate_to(env, workshop_idx)\n    actions.extend(move_actions)\n\n    # Use action at the workshop to craft the item\n    use_action = 4  # Assuming USE action is represented by index 4\n    actions.append(use_action)\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-11T02:05:07.664981", "function_name": "craft", "function_body": "  def get_turn_actions(current_dir: int, target_dir: int) -> list[int]:\n    \"\"\"Calculates the sequence of turn actions to change from current direction to target direction.\"\"\"\n    # Assuming directions are encoded as follows:\n    # UP = 0, RIGHT = 1, DOWN = 2, LEFT = 3\n    turn_actions = []\n    if (current_dir + 1) % 4 == target_dir:\n      turn_actions.append(6)  # Turn right\n    elif (current_dir - 1) % 4 == target_dir:\n      turn_actions.append(5)  # Turn left\n    else:\n      turn_actions.extend([5, 5])  # Turn around\n    return turn_actions\n\n  actions = []\n  \n  # Get the index for the goal item\n  goal_index = env.world.cookbook.index[item]\n\n  # Get the primitives required to make the goal item\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  \n  # Check if we have all the required primitives in inventory\n  for prim, count in required_primitives.items():\n    if env._current_state.inventory[prim] < count:\n      return []  # Return empty list if any primitive is not sufficient\n\n  # Identify the workshop where crafting should occur\n  for recipe_output, ingredients in env.world.cookbook.recipes.items():\n    if recipe_output == goal_index and \"_key\" in ingredients:\n      workshop_key = ingredients[\"_key\"]\n      break\n  else:\n    return []  # No valid workshop found\n  \n  # Find the index of the workshop\n  workshop_index = env.world.cookbook.index[workshop_key]\n\n  # Locate the workshop on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n    return []  # Workshop not found on the grid\n\n  # Navigate to the nearest workshop\n  agent_pos = env._current_state.pos\n  closest_workshop = min(workshop_positions, key=lambda x: np.linalg.norm(np.array(x) - np.array(agent_pos)))\n\n  # Calculate relative positions and directions\n  dx, dy = closest_workshop[0] - agent_pos[0], closest_workshop[1] - agent_pos[1]\n  \n  while tuple(agent_pos) != tuple(closest_workshop):\n    direction = None\n    \n    if dx > 0:\n      direction = (3, (agent_pos[0] + 1, agent_pos[1]))  # RIGHT\n    elif dx < 0:\n      direction = (2, (agent_pos[0] - 1, agent_pos[1]))  # LEFT\n    elif dy > 0:\n      direction = (4, (agent_pos[0], agent_pos[1] + 1))  # DOWN\n    elif dy < 0:\n      direction = (1, (agent_pos[0], agent_pos[1] - 1))  # UP\n    \n    actions.append(direction[0])\n    agent_pos = direction[1]\n\n  # Check if the agent is already facing the correct direction to use the workshop\n  current_direction = env._current_state.agent_dir  # Assuming this attribute exists\n\n  target_direction = None\n  if closest_workshop[0] == agent_pos[0]:\n    if closest_workshop[1] > agent_pos[1]:\n      target_direction = 4  # DOWN\n    else:\n      target_direction = 1  # UP\n  elif closest_workshop[1] == agent_pos[1]:\n    if closest_workshop[0] > agent_pos[0]:\n      target_direction = 3  # RIGHT\n    else:\n      target_direction = 2  # LEFT\n  \n  if current_direction != target_direction:\n    actions.extend(get_turn_actions(current_direction, target_direction))\n  \n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T02:05:08.739011", "function_name": "craft", "function_body": "  def get_turn_actions(current_dir: int, target_dir: int) -> list[int]:\n    \"\"\"Calculate the sequence of turn actions to reach the target direction.\"\"\"\n    if current_dir == target_dir:\n      return []\n    \n    # Define a mapping from current direction to target direction and corresponding turn actions\n    turn_mapping = {\n        (1, 2): [2],       # UP to LEFT\n        (1, 3): [3, 3],     # UP to RIGHT\n        (1, 4): [3],        # UP to DOWN\n        (2, 1): [3, 3],     # LEFT to UP\n        (2, 3): [3],        # LEFT to RIGHT\n        (2, 4): [4],        # LEFT to DOWN\n        (3, 1): [2],        # RIGHT to UP\n        (3, 2): [2, 2],     # RIGHT to LEFT\n        (3, 4): [2, 4],     # RIGHT to DOWN\n        (4, 1): [2],        # DOWN to UP\n        (4, 2): [4],        # DOWN to LEFT\n        (4, 3): [3]         # DOWN to RIGHT\n    }\n    \n    return turn_mapping.get((current_dir, target_dir), [])\n\n  def navigate_to_position(agent_pos: tuple, target_pos: tuple) -> list[int]:\n    \"\"\"Calculates the sequence of actions to move from agent's position to the target position.\"\"\"\n    actions = []\n    dx, dy = target_pos[0] - agent_pos[0], target_pos[1] - agent_pos[1]\n    \n    while dx != 0 or dy != 0:\n      if abs(dx) >= abs(dy):\n        direction_x = 3 if dx > 0 else 2\n        actions.append(direction_x)\n        agent_pos = (agent_pos[0] + (1 if dx > 0 else -1), agent_pos[1])\n        dx -= (1 if dx > 0 else -1)\n      else:\n        direction_y = 4 if dy > 0 else 1\n        actions.append(direction_y)\n        agent_pos = (agent_pos[0], agent_pos[1] + (1 if dy > 0 else -1))\n        dy -= (1 if dy > 0 else -1)\n    \n    return actions\n\n  actions = []\n\n  # Get the index for the goal item\n  goal_index = env.world.cookbook.index[item]\n\n  # Get the primitives required to make the goal item\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n\n  # Check if we have all the required primitives in inventory\n  for prim, count in required_primitives.items():\n    if env._current_state.inventory[prim] < count:\n      return []  # Return empty list if any primitive is not sufficient\n\n  # Identify the workshop where crafting should occur\n  for recipe_output, ingredients in env.world.cookbook.recipes.items():\n    if recipe_output == goal_index and \"_key\" in ingredients:\n      workshop_key = ingredients[\"_key\"]\n      break\n  else:\n    return []  # No valid workshop found\n\n  # Find the index of the workshop\n  workshop_index = env.world.cookbook.index[workshop_key]\n\n  # Locate the workshop on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    return []  # Workshop not found on the grid\n\n  # Navigate to the nearest workshop\n  agent_pos = env._current_state.pos\n  closest_workshop = min(workshop_positions, key=lambda x: np.linalg.norm(np.array(x) - np.array(agent_pos)))\n\n  # Calculate the path to the nearest workshop\n  actions.extend(navigate_to_position(agent_pos, tuple(closest_workshop)))\n\n  # Ensure the agent is facing the correct direction to use the workshop\n  current_direction = env._current_state.agent_dir  # Assuming this attribute exists\n\n  target_direction = None\n  if closest_workshop[0] == agent_pos[0]:\n    if closest_workshop[1] > agent_pos[1]:\n      target_direction = 4  # DOWN\n    else:\n      target_direction = 1  # UP\n  elif closest_workshop[1] == agent_pos[1]:\n    if closest_workshop[0] > agent_pos[0]:\n      target_direction = 3  # RIGHT\n    else:\n      target_direction = 2  # LEFT\n\n  actions.extend(get_turn_actions(current_direction, target_direction))\n\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T02:06:37.661539", "function_name": "craft", "function_body": "  actions = []\n  # Get the index of the desired item\n  item_idx = env.world.cookbook.index[item]\n  \n  if not item_idx:\n    print(f\"Item {item} not found in cookbook.\")\n    return actions\n\n  # Find out what primitives are needed to craft the item\n  required_primitives = env.world.cookbook.primitives_for(item_idx)\n\n  # Check if we already have all the required primitives in our inventory\n  for primitive_idx, count in required_primitives.items():\n      if env._current_state.inventory[primitive_idx] < count:\n          # If not, we need to collect more of this primitive\n          actions.extend(collect(env, primitive_idx))\n  \n  # Once we have all the required primitives, we can proceed with crafting\n  workshop_index = None\n  \n  for recipe in env.world.cookbook.recipes.values():\n      if item_idx in recipe:\n          workshop_index = env.world.cookbook.index[recipe[\"_key\"]]\n          break\n\n  if not workshop_index:\n    print(f\"No workshop found to craft {item}.\")\n    return actions\n\n  # Find the position of the required workshop\n  workshop_pos = None\n  for x in range(env._current_state.grid.shape[0]):\n      for y in range(env._current_state.grid.shape[1]):\n          if env._current_state.grid[x, y, workshop_index] == 1:\n              workshop_pos = (x, y)\n              break\n      if workshop_pos:\n          break\n  \n  if not workshop_pos:\n    print(f\"Workshop {workshop_index} not found on the grid.\")\n    return actions\n\n  # Move to the workshop position\n  actions.extend(move_to(env, workshop_pos))\n\n  # Turn to face the correct direction to use the workshop\n  actions.append(craft.FACE_FUNC(workshop_pos[0] - env._current_state.pos[0], \n                                 workshop_pos[1] - env._current_state.pos[1]))\n  \n  # Use the USE action to craft the item\n  actions.append(craft.USE_FUNC)\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-11T02:06:38.706964", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  goal_idx = env.world.cookbook.index[item]\n\n  # Check if the goal is achievable (i.e., it has a recipe)\n  if goal_idx not in env.world.cookbook.recipes:\n    return []\n\n  # Collect primitives required for crafting\n  actions_to_take = []\n  \n  # Get the required ingredients and their counts for the desired item\n  ingredients = env.world.cookbook.recipes[goal_idx]\n\n  for ingredient, count in ingredients.items():\n      if ingredient == \"_key\":\n          continue  # Skip _key as it's not a primitive but an indicator of where to craft\n      \n      # Get the index of the current ingredient\n      ingredient_idx = env.world.cookbook.index.get(ingredient)\n      \n      # Check if the agent has enough of this ingredient in its inventory\n      if env._current_state.inventory[ingredient_idx] < count:\n          # If not, collect the required amount of primitives\n          primitive_actions = collect(env, ingredient)\n          \n          # Append these actions to the list of actions to take\n          actions_to_take.extend(primitive_actions)\n\n  # Get the workshop where the item should be crafted\n  workshop_key = ingredients.get(\"_key\")\n  if workshop_key:\n      # Assuming _key is a string indicating which workshop to use, get its index\n      workshop_name = workshop_key.split('_')[1]  # Extract 'workshop0', 'workshop1', etc.\n      workshop_idx = getattr(env.world, f\"{workshop_name}_indices\")[0]\n      \n      # Find the position of the nearest workshop in the grid\n      workshop_pos = find_nearest_workshop(env._current_state.grid, workshop_idx)\n      \n      if workshop_pos:\n          # Move to the position of the nearest workshop\n          move_actions = move_to_position(env._current_state.pos, workshop_pos, env._current_state.dir)\n          \n          # Append these actions to the list of actions to take\n          actions_to_take.extend(move_actions)\n          \n          # Turn to face the workshop (assuming we need to be directly facing it to USE)\n          turn_action = turn_towards_workshop(env._current_state.pos, workshop_pos, env._current_state.dir)\n          \n          if turn_action:\n              actions_to_take.append(turn_action)\n          \n          # Perform the USE action to craft the item\n          use_action = 4  # Assuming USE is action index 4\n          actions_to_take.append(use_action)\n\n  return actions_to_take", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-11T02:08:49.570055", "function_name": "craft", "function_body": "  def navigate_to_position(agent_pos, target_pos):\n    actions = []\n    while tuple(agent_pos) != tuple(target_pos):\n      dx, dy = target_pos[0] - agent_pos[0], target_pos[1] - agent_pos[1]\n      \n      # Prioritize movement along the x-axis if the difference is greater\n      if abs(dx) > abs(dy):\n          if dx > 0:\n              actions.append(3)  # RIGHT\n              agent_pos = (agent_pos[0] + 1, agent_pos[1])\n          else:\n              actions.append(2)  # LEFT\n              agent_pos = (agent_pos[0] - 1, agent_pos[1])\n      else:\n          if dy > 0:\n              actions.append(4)  # DOWN\n              agent_pos = (agent_pos[0], agent_pos[1] + 1)\n          else:\n              actions.append(1)  # UP\n              agent_pos = (agent_pos[0], agent_pos[1] - 1)\n    return actions\n\n  def face_workshop(agent_pos, workshop_pos):\n      actions = []\n      dx, dy = workshop_pos[0] - agent_pos[0], workshop_pos[1] - agent_pos[1]\n      \n      # Adjust direction to face the workshop\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      \n      if dy > 0:\n          actions.append(4)  # DOWN\n      elif dy < 0:\n          actions.append(1)  # UP\n      \n      return actions\n\n  actions = []\n  \n  # Get the index for the goal item\n  goal_index = env.world.cookbook.index[item]\n\n  # Get the primitives required to make the goal item\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  \n  # Check if we have all the required primitives in inventory\n  for prim, count in required_primitives.items():\n    if env._current_state.inventory[prim] < count:\n      return []  # Return empty list if any primitive is not sufficient\n\n  # Identify the workshop where crafting should occur\n  workshop_index = None\n  for recipe_output, ingredients in env.world.cookbook.recipes.items():\n    if recipe_output == goal_index and \"_key\" in ingredients:\n      workshop_key = ingredients[\"_key\"]\n      workshop_index = env.world.cookbook.index[workshop_key]\n      break\n\n  if workshop_index is None:\n    return []  # No valid workshop found\n\n  # Locate the workshop on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    return []  # Workshop not found on the grid\n\n  # Navigate to the nearest workshop\n  agent_pos = env._current_state.pos\n  closest_workshop = min(workshop_positions, key=lambda x: np.linalg.norm(np.array(x) - np.array(agent_pos)))\n  \n  actions.extend(navigate_to_position(agent_pos, closest_workshop))\n  \n  # Ensure the agent is facing the workshop before using it\n  actions.extend(face_workshop(closest_workshop, agent_pos))\n  \n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T02:08:50.680376", "function_name": "craft", "function_body": "  def navigate_to_position(agent_pos, target_pos):\n    actions = []\n    while tuple(agent_pos) != tuple(target_pos):\n      dx, dy = target_pos[0] - agent_pos[0], target_pos[1] - agent_pos[1]\n      \n      if abs(dx) > abs(dy):\n          if dx > 0:\n              actions.append(3)  # RIGHT\n              agent_pos = (agent_pos[0] + 1, agent_pos[1])\n          else:\n              actions.append(2)  # LEFT\n              agent_pos = (agent_pos[0] - 1, agent_pos[1])\n      else:\n          if dy > 0:\n              actions.append(4)  # DOWN\n              agent_pos = (agent_pos[0], agent_pos[1] + 1)\n          else:\n              actions.append(1)  # UP\n              agent_pos = (agent_pos[0], agent_pos[1] - 1)\n    return actions\n\n  def face_workshop(agent_pos, workshop_pos):\n      actions = []\n      if workshop_pos[0] > agent_pos[0]:\n          actions.append(3)  # RIGHT\n      elif workshop_pos[0] < agent_pos[0]:\n          actions.append(2)  # LEFT\n      \n      if workshop_pos[1] > agent_pos[1]:\n          actions.append(4)  # DOWN\n      elif workshop_pos[1] < agent_pos[1]:\n          actions.append(1)  # UP\n\n      return actions\n\n  actions = []\n\n  # Get the index for the goal item\n  goal_index = env.world.cookbook.index[item]\n\n  # Check if we have all the required primitives in inventory\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  \n  for prim, count in required_primitives.items():\n    if env._current_state.inventory[prim] < count:\n      return []  # Return empty list if any primitive is not sufficient\n\n  # Identify the workshop where crafting should occur\n  workshop_key = None\n  workshop_index = None\n  for recipe_output, ingredients in env.world.cookbook.recipes.items():\n    if recipe_output == goal_index and \"_key\" in ingredients:\n      workshop_key = ingredients[\"_key\"]\n      workshop_index = env.world.cookbook.index[workshop_key]\n      break\n\n  if workshop_index is None:\n    return []  # No valid workshop found\n  \n  # Locate the workshop on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    return []  # Workshop not found on the grid\n\n  # Navigate to the nearest workshop\n  agent_pos = env._current_state.pos\n  closest_workshop = min(workshop_positions, key=lambda x: np.linalg.norm(np.array(x) - np.array(agent_pos)))\n\n  actions.extend(navigate_to_position(agent_pos, closest_workshop))\n  \n  # Face the workshop before using it\n  actions.extend(face_workshop(agent_pos, closest_workshop))\n\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T02:12:04.337536", "function_name": "craft", "function_body": "  def find_closest_object(grid, start_pos, target_index):\n    \"\"\"\n    Find the closest object of a specific index in the grid using BFS.\n    \n    Args:\n        grid (numpy.ndarray): The grid representing the environment.\n        start_pos (tuple): Starting position (x, y) for the search.\n        target_index (int): The index of the target object to find.\n\n    Returns:\n        tuple: Coordinates (x, y) of the closest target object or None if not found.\n    \"\"\"\n    from collections import deque\n    \n    directions = [(1, 0), (-1, 0), (0, 1), (0, -1)]\n    queue = deque([start_pos])\n    visited = set([start_pos])\n    \n    while queue:\n        current_pos = queue.popleft()\n        \n        # Check if the current position contains the target object\n        if grid[current_pos] == target_index:\n            return current_pos\n        \n        # Explore neighbors\n        for dx, dy in directions:\n            new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n            \n            # Ensure the new position is within bounds and not blocked by any item\n            if 0 <= new_x < grid.shape[0] and 0 <= new_y < grid.shape[1] and np.all(grid[new_x, new_y] == 0):\n                if (new_x, new_y) not in visited:\n                    visited.add((new_x, new_y))\n                    queue.append((new_x, new_y))\n    \n    return None\n\n  def a_star_search(grid, start_pos, target_pos):\n      \"\"\"\n      Perform A* search to find the shortest path from start to target position.\n      \n      Args:\n          grid (numpy.ndarray): The grid representing the environment.\n          start_pos (tuple): Starting position (x, y) for the search.\n          target_pos (tuple): Target position (x, y) to reach.\n\n      Returns:\n          list[tuple]: A list of coordinates [(x1, y1), (x2, y2), ...] representing the shortest path.\n      \"\"\"\n      from heapq import heappop, heappush\n      \n      def heuristic(pos1, pos2):\n          return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n      \n      open_set = []\n      heappush(open_set, (0, start_pos))\n      came_from = {}\n      g_score = {start_pos: 0}\n      f_score = {start_pos: heuristic(start_pos, target_pos)}\n      \n      while open_set:\n          current_f, current_pos = heappop(open_set)\n          \n          if current_pos == target_pos:\n              path = []\n              while current_pos in came_from:\n                  path.append(current_pos)\n                  current_pos = came_from[current_pos]\n              path.reverse()\n              return path\n          \n          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              neighbor_pos = (current_pos[0] + dx, current_pos[1] + dy)\n              \n              if 0 <= neighbor_pos[0] < grid.shape[0] and 0 <= neighbor_pos[1] < grid.shape[1]:\n                  tentative_g_score = g_score[current_pos] + 1\n                  \n                  if grid[neighbor_pos].any() == 1:  # Check if the cell is blocked by any item\n                      continue\n                  \n                  if neighbor_pos not in g_score or tentative_g_score < g_score[neighbor_pos]:\n                      came_from[neighbor_pos] = current_pos\n                      g_score[neighbor_pos] = tentative_g_score\n                      f_score[neighbor_pos] = tentative_g_score + heuristic(neighbor_pos, target_pos)\n                      heappush(open_set, (f_score[neighbor_pos], neighbor_pos))\n      \n      return []\n\n  def move_to_target(grid, start_pos, target_pos):\n      \"\"\"\n      Generate actions to move from start position to target position.\n      \n      Args:\n          grid (numpy.ndarray): The grid representing the environment.\n          start_pos (tuple): Starting position (x, y).\n          target_pos (tuple): Target position (x, y).\n\n      Returns:\n          list[int]: A list of action indices corresponding to movements.\n      \"\"\"\n      path = a_star_search(grid, start_pos, target_pos)\n      actions = []\n      \n      for pos in path[:-1]:\n          direction = get_direction(start_pos, pos)\n          if direction == \"UP\":\n              actions.append(1)\n          elif direction == \"DOWN\":\n              actions.append(0)\n          elif direction == \"LEFT\":\n              actions.append(2)\n          elif direction == \"RIGHT\":\n              actions.append(3)\n          \n          start_pos = pos\n      \n      return actions\n\n  def rotate_to_face(state, target_pos, target_index):\n      \"\"\"\n      Generate the action to rotate the agent to face the target position.\n      \n      Args:\n          state (CraftState): The current state of the environment.\n          target_pos (tuple): Target position (x, y).\n          target_index (int): Index of the target object.\n\n      Returns:\n          int: Action index corresponding to rotation.\n      \"\"\"\n      direction = get_direction(state.pos, target_pos)\n      \n      if direction == \"UP\":\n          return 1\n      elif direction == \"DOWN\":\n          return 0\n      elif direction == \"LEFT\":\n          return 2\n      elif direction == \"RIGHT\":\n          return 3\n      \n      # Check the specific orientation needed to face the target object\n      current_direction = state.dir\n      \n      if (direction == \"UP\" and current_direction != 1) or \\\n         (direction == \"DOWN\" and current_direction != 0) or \\\n         (direction == \"LEFT\" and current_direction != 2) or \\\n         (direction == \"RIGHT\" and current_direction != 3):\n          # Rotate to the correct direction\n          if state.next_to(target_index):\n              return state.dir\n      \n      return state.dir\n\n  def get_direction(start_pos, target_pos):\n      \"\"\"\n      Determine the direction to move from start position to target position.\n      \n      Args:\n          start_pos (tuple): Starting position (x, y).\n          target_pos (tuple): Target position (x, y).\n\n      Returns:\n          str: Direction (\"UP\", \"DOWN\", \"LEFT\", \"RIGHT\").\n      \"\"\"\n      if start_pos[0] < target_pos[0]:\n          return \"RIGHT\"\n      elif start_pos[0] > target_pos[0]:\n          return \"LEFT\"\n      elif start_pos[1] < target_pos[1]:\n          return \"UP\"\n      elif start_pos[1] > target_pos[1]:\n          return \"DOWN\"\n      \n      return None\n\n  item_index = env.world.cookbook.index[item]\n  \n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  \n  actions = []\n  \n  # Check if all required items are available in the inventory. If not, return an empty list.\n  for primitive, count in required_primitives.items():\n    if env._current_state.inventory[primitive] < count:\n      return []  # Return empty list if any required item is not available.\n    \n  target_workshop = None\n  \n  # Determine the workshop where crafting should occur\n  for recipe in env.world.cookbook.recipes.values():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n      workshop_key = recipe.get(\"_at\")\n      if workshop_key is not None:\n        target_workshop = getattr(env.world, f\"{workshop_key}_index\", None)\n        break\n  \n  # If no suitable workshop is found, return an empty list.\n  if target_workshop is None:\n    return []\n  \n  start_pos = env._current_state.pos\n  grid_with_target = env._current_state.grid.copy()\n  \n  # Mark the target workshop for A* search\n  grid_with_target[:, :, target_workshop] += 1000\n\n  target_pos = find_closest_object(grid_with_target, start_pos, target_workshop)\n\n  if target_pos is None:\n    return []  # No path to the target workshop\n  \n  # Calculate the shortest path to the target workshop\n  path_to_workshop = a_star_search(env._current_state.grid, start_pos, target_pos)\n  \n  for pos in path_to_workshop[:-1]:\n      actions.extend(move_to_target(env._current_state.grid, env._current_state.pos, pos))\n      \n  final_pos = path_to_workshop[-1]\n  actions.append(rotate_to_face(env._current_state, final_pos, target_workshop))\n  actions.append(4)  # Use action\n\n  return actions", "island_id": 0, "scores": {"3": 0.0}}
