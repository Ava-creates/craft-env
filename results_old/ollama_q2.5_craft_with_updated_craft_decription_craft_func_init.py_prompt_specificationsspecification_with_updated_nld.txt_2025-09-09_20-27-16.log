{"timestamp": "2025-09-09T23:39:18.153680", "function_name": "craft", "function_body": "  # Get index for the target item\n  i_item = env.world.cookbook.index[item]\n\n  # Check if we have all primitives required for crafting the item\n  primitives_needed = env.world.cookbook.primitives_for(i_item)\n  \n  # Check inventory to see if we already have all required primitives \n  actions_to_take = []\n  for primitive, count in primitives_needed.items():\n    current_count = env._current_state.inventory[primitive]\n    if current_count < count:\n      # Collect the missing primitives\n      primitive_name = env.world.cookbook.index.get(primitive)\n      \n      # Find the nearest location of this primitive\n      locations = np.argwhere(env._current_state.grid[:, :, primitive] > 0)\n\n      # Sort locations by distance to agent's current position\n      locations_sorted_by_distance = sorted(locations, key=lambda loc: abs(loc[0]-env._current_state.pos[0])+abs(loc[1]-env._current_state.pos[1]))\n      \n      if len(locations_sorted_by_distance) == 0:\n        return [] # primitive not found in the environment\n      \n      target_location = locations_sorted_by_distance[0]\n      \n      # Navigate to the nearest location of this primitive\n      actions_to_take.extend(navigate(env, target_location))\n      \n      # Collect the primitive\n      actions_to_take.append(env.action_map['USE'])\n      \n  # Now that we have all required primitives, go to the workshop and craft the item\n  recipe = env.world.cookbook.recipes[i_item]\n  \n  workshop_key = \"_key\" if \"_at\" not in recipe else \"_at\"\n  workshop_name = recipe[workshop_key]\n\n  i_workshop = env.world.cookbook.index[workshop_name]\n  \n  # Find the nearest location of this workshop\n  locations = np.argwhere(env._current_state.grid[:, :, i_workshop] > 0)\n\n  if len(locations) == 0:\n    return [] # Workshop not found in the environment\n  \n  target_location = sorted(locations, key=lambda loc: abs(loc[0]-env._current_state.pos[0])+abs(loc[1]-env._current_state.pos[1]))[0]\n\n  # Navigate to the nearest location of this workshop\n  actions_to_take.extend(navigate(env, target_location))\n  \n  # Craft the item (face the workshop and use)\n  face_workshop_action = face_target(env, target_location)\n  if face_workshop_action:\n    actions_to_take.append(face_workshop_action)\n  actions_to_take.append(env.action_map['USE'])\n  \n  return actions_to_take", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-09T23:40:02.882246", "function_name": "craft", "function_body": "  actions = []\n  \n  # Convert item name to index using the cookbook\n  goal_index = env.world.cookbook.index[item]\n  \n  # Check if we have all primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  \n  current_inventory = collections.Counter(env._current_state.inventory)\n  missing_primitives = {prim: count - current_inventory[prim] for prim, count in required_primitives.items() if count > current_inventory[prim]}\n  \n  if not missing_primitives:\n    # We have all the primitives, proceed to craft the item at the correct workshop\n    actions.extend(find_workshop_and_craft(env, goal_index))\n  else:\n    # Collect missing primitives\n    for prim, count in missing_primitives.items():\n      actions.extend(collect_primitive(env, prim, count))\n      \n      # Check if we have all primitives after collecting\n      current_inventory = collections.Counter(env._current_state.inventory)\n      missing_primitives_after_collect = {prim: count - current_inventory[prim] for prim, count in required_primitives.items() if count > current_inventory[prim]}\n      \n      if not missing_primitives_after_collect:\n        actions.extend(find_workshop_and_craft(env, goal_index))\n        break\n  \n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-09T23:40:03.869948", "function_name": "craft", "function_body": "  # Convert item name to index using the cookbook\n  goal_index = env.world.cookbook.index[item]\n\n  # Check if we have all primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n\n  current_inventory = collections.Counter(env._current_state.inventory)\n  missing_primitives = {prim: count - current_inventory[prim] for prim, count in required_primitives.items() if count > current_inventory[prim]}\n  \n  # If we have all primitives and no missing ones, proceed to craft the item at the correct workshop\n  if not missing_primitives:\n    actions = find_workshop_and_craft(env, goal_index)\n  else:\n    # Otherwise, collect the missing primitives before crafting\n    actions = collect_missing_primitives(env, missing_primitives)\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-09T23:41:44.670043", "function_name": "craft", "function_body": "  def find_item_on_grid(kind_index):\n    grid = env._current_state.grid\n    for y in range(grid.shape[0]):\n      for x in range(grid.shape[1]):\n        if grid[y, x, kind_index] == 1:\n          return (x, y)\n    return None\n\n  def move_to_position(target_pos):\n    actions = []\n    current_pos = env._current_state.pos\n    while current_pos != target_pos:\n      # Simple heuristic: move horizontally first, then vertically.\n      if current_pos[0] < target_pos[0]:\n        actions.append(env.world.N_RIGHT)\n        current_pos = (current_pos[0] + 1, current_pos[1])\n      elif current_pos[0] > target_pos[0]:\n        actions.append(env.world.N_LEFT)\n        current_pos = (current_pos[0] - 1, current_pos[1])\n      elif current_pos[1] < target_pos[1]:\n        actions.append(env.world.N_DOWN)\n        current_pos = (current_pos[0], current_pos[1] + 1)\n      elif current_pos[1] > target_pos[1]:\n        actions.append(env.world.N_UP)\n        current_pos = (current_pos[0], current_pos[1] - 1)\n    return actions\n\n  def collect_primitive(primitive_name):\n    kind_index = env.world.cookbook.index.get(primitive_name)\n    if kind_index is None:\n      raise ValueError(f\"Primitive {primitive_name} not found.\")\n    \n    target_pos = find_item_on_grid(kind_index)\n    if target_pos is None:\n      return []  # No primitive available on the grid.\n    \n    actions = move_to_position(target_pos) + [env.world.N_USE]\n    return actions\n\n  def go_to_workshop(workshop_index):\n    target_pos = None\n    for idx in env.world.workshop_indices:\n      if env.world.cookbook.index.get(idx) == workshop_index:\n        target_pos = find_item_on_grid(idx)\n        break\n    \n    if target_pos is None:\n      return []  # No such workshop available on the grid.\n    \n    actions = move_to_position(target_pos) + [env.world.N_USE]\n    return actions\n\n  def craft_item(item_name):\n    item_index = env.world.cookbook.index.get(item_name)\n    if item_index is None:\n      raise ValueError(f\"Item {item_name} not found in cookbook.\")\n    \n    recipe = env.world.cookbook.recipes.get(item_index, {})\n    if \"_at\" not in recipe or \"workshop0\" not in env.world.cookbook.index:\n      return []  # No workshop specified for crafting.\n    \n    workshop_name = recipe[\"_at\"]\n    workshop_index = env.world.cookbook.index.get(workshop_name)\n    actions = []\n    \n    # Collect all required primitives.\n    for ingredient, count in recipe.items():\n      if ingredient == \"_at\":\n        continue\n      primitive_index = env.world.cookbook.index.get(ingredient)\n      while count > 0:\n        actions += collect_primitive(primitive_name=env.world.cookbook.index.get(primitive_index))\n        count -= 1\n    \n    # Go to the specified workshop.\n    actions += go_to_workshop(workshop_index=workshop_index)\n    \n    return actions\n\n  return craft_item(item)", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-09T23:41:45.645336", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index for the goal item\n  i_goal = env.world.cookbook.index.index(item)\n  \n  # Get primitives required to craft the item and their counts\n  required_primitives = env.world.cookbook.primitives_for(i_goal)\n\n  # Check if we have all the required primitives in our inventory already\n  all_requirements_met = True\n  for primitive, count in required_primitives.items():\n    if env._current_state.inventory[primitive] < count:\n      all_requirements_met = False\n      break\n  \n  # If not, return empty list as we cannot craft it yet\n  if not all_requirements_met:\n    return []\n\n  # Get the recipe to determine the workshop where crafting should occur\n  recipe = env.world.cookbook.recipes[i_goal]\n\n  # Check where crafting can happen (which workshop)\n  _key = \"_at\"\n  if _key in recipe:\n      workshop = recipe[_key]\n  else:\n    raise ValueError(f\"Workshop for crafting {item} not specified in the recipe.\")\n\n  # Get the index of the workshop\n  i_workshop = env.world.cookbook.index.index(workshop)\n  \n  # Find all positions of this workshop on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, i_workshop] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No {workshop} found in the environment.\")\n  \n  # Choose the closest workshop to move to (manhattan distance)\n  current_pos = env._current_state.pos\n  closest_workshop_idx = np.argmin([abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1]) for pos in workshop_positions])\n  closest_workshop = workshop_positions[closest_workshop_idx]\n\n  # Calculate the actions needed to move to the closest workshop\n  actions.extend(move_to(env, closest_workshop))\n\n  # Rotate to face the correct direction to use the workshop (Assuming facing up initially)\n  # This is a simplified assumption and needs proper implementation\n  actions.append(craft.DIR_UP)\n\n  # Perform the crafting action\n  actions.append(craft.USE_ACTION)\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-09T23:43:58.699266", "function_name": "craft", "function_body": "  def get_primitive_actions(primitive_index):\n    \"\"\"Returns a list of actions required to collect a primitive.\"\"\"\n    # Find all locations of the primitive in the grid\n    primitive_locations = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n    \n    if len(primitive_locations) == 0:\n      return []\n\n    target_location = primitive_locations[np.random.choice(len(primitive_locations))]\n    \n    actions = []\n    while env._current_state.pos != tuple(target_location):\n      dx, dy = target_location - np.array(env._current_state.pos)\n      if dx < 0:\n        actions.append(env.world.N_ACTIONS.DOWN)\n      elif dx > 0:\n        actions.append(env.world.N_ACTIONS.UP)\n      elif dy < 0:\n        actions.append(env.world.N_ACTIONS.LEFT)\n      elif dy > 0:\n        actions.append(env.world.N_ACTIONS.RIGHT)\n\n    # Add the USE action to collect the primitive\n    actions.append(env.world.N_ACTIONS.USE)\n    \n    return actions\n\n  def get_workshop_actions(workshop_index):\n    \"\"\"Returns a list of actions required to move to and use the workshop.\"\"\"\n    # Find all locations of the workshop in the grid\n    workshop_locations = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_locations) == 0:\n      return []\n\n    target_location = workshop_locations[np.random.choice(len(workshop_locations))]\n    \n    actions = []\n    while env._current_state.pos != tuple(target_location):\n      dx, dy = target_location - np.array(env._current_state.pos)\n      if dx < 0:\n        actions.append(env.world.N_ACTIONS.DOWN)\n      elif dx > 0:\n        actions.append(env.world.N_ACTIONS.UP)\n      elif dy < 0:\n        actions.append(env.world.N_ACTIONS.LEFT)\n      elif dy > 0:\n        actions.append(env.world.N_ACTIONS.RIGHT)\n\n    # Add the USE action to use the workshop\n    actions.append(env.world.N_ACTIONS.USE)\n    \n    return actions\n\n  def has_all_primitives(primitive_counts):\n    \"\"\"Check if the agent's inventory has all required primitives.\"\"\"\n    for primitive_index, count in primitive_counts.items():\n      if env._current_state.inventory[primitive_index] < count:\n        return False\n    return True\n\n  # Get the index of the item to craft\n  item_index = env.world.cookbook.index[item]\n\n  # Get the primitive counts required to craft the item\n  primitive_counts = env.world.cookbook.primitives_for(item_index)\n\n  actions = []\n\n  if not has_all_primitives(primitive_counts):\n    return []\n\n  # Collect all required primitives\n  for primitive, count in primitive_counts.items():\n    while env._current_state.inventory[primitive] < count:\n      actions.extend(get_primitive_actions(primitive))\n  \n  # Move to the workshop and use it to craft the item\n  if \"_key\" in env.world.cookbook.recipes[item_index]:\n    workshop_key = env.world.cookbook.recipes[item_index][\"_key\"]\n    workshop_index = env.world.cookbook.index[workshop_key]\n    actions.extend(get_workshop_actions(workshop_index))\n  \n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-09-09T23:43:59.729323", "function_name": "craft", "function_body": "  def get_primitive_actions(primitive_index):\n    \"\"\"Returns a list of actions required to collect a primitive.\"\"\"\n    # Find all locations of the primitive in the grid\n    primitive_locations = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n    \n    if len(primitive_locations) == 0:\n      return []\n\n    target_location = primitive_locations[np.random.choice(len(primitive_locations))]\n    \n    actions = []\n    while env._current_state.pos != tuple(target_location):\n      dx, dy = target_location - np.array(env._current_state.pos)\n      if dx < 0:\n        actions.append(env.world.N_ACTIONS.DOWN)\n      elif dx > 0:\n        actions.append(env.world.N_ACTIONS.UP)\n      elif dy < 0:\n        actions.append(env.world.N_ACTIONS.LEFT)\n      elif dy > 0:\n        actions.append(env.world.N_ACTIONS.RIGHT)\n\n    # Add the USE action to collect the primitive\n    actions.append(env.world.N_ACTIONS.USE)\n    \n    return actions\n\n  def get_workshop_actions(workshop_index):\n    \"\"\"Returns a list of actions required to move to and use the workshop.\"\"\"\n    # Find all locations of the workshop in the grid\n    workshop_locations = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_locations) == 0:\n      return []\n\n    target_location = workshop_locations[np.random.choice(len(workshop_locations))]\n    \n    actions = []\n    while env._current_state.pos != tuple(target_location):\n      dx, dy = target_location - np.array(env._current_state.pos)\n      if dx < 0:\n        actions.append(env.world.N_ACTIONS.DOWN)\n      elif dx > 0:\n        actions.append(env.world.N_ACTIONS.UP)\n      elif dy < 0:\n        actions.append(env.world.N_ACTIONS.LEFT)\n      elif dy > 0:\n        actions.append(env.world.N_ACTIONS.RIGHT)\n\n    # Add the USE action to use the workshop\n    actions.append(env.world.N_ACTIONS.USE)\n    \n    return actions\n\n  def has_all_primitives(primitive_counts):\n    \"\"\"Check if the agent's inventory has all required primitives.\"\"\"\n    for primitive_index, count in primitive_counts.items():\n      if env._current_state.inventory[primitive_index] < count:\n        return False\n    return True\n  \n  def plan_crafting_sequence(item_index):\n    \"\"\"Plan a sequence of actions to craft an item.\"\"\"\n    actions = []\n    \n    # Get the primitive counts required to craft the item\n    primitive_counts = env.world.cookbook.primitives_for(item_index)\n\n    while not has_all_primitives(primitive_counts):\n      for primitive, count in primitive_counts.items():\n        if env._current_state.inventory[primitive] < count:\n          actions.extend(get_primitive_actions(primitive))\n      \n    # Move to the workshop and use it to craft the item\n    if \"_key\" in env.world.cookbook.recipes[item_index]:\n      workshop_key = env.world.cookbook.recipes[item_index][\"_key\"]\n      workshop_index = env.world.cookbook.index[workshop_key]\n      actions.extend(get_workshop_actions(workshop_index))\n    \n    return actions\n\n  # Get the index of the item to craft\n  item_index = env.world.cookbook.index[item]\n\n  actions = plan_crafting_sequence(item_index)\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-09T23:45:20.651798", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n\n  # Check if the desired item is a primitive; primitives cannot be crafted.\n  if item_index in env.world.cookbook.primitives:\n    return []\n\n  # Fetch the recipe for crafting the specified item.\n  recipe = env.world.cookbook.recipes.get(item_index)\n\n  # If no valid recipe exists or \"_key\" not specified, return an empty action list.\n  if not recipe or \"_key\" not in recipe:\n    return []\n\n  workshop_key = recipe[\"_key\"]\n  workshop_indices = [env.world.cookbook.index[workshop_key]]\n\n  actions = []\n  # Check inventory for sufficient primitives.\n  missing_ingredients = {}\n  for ingredient, count in recipe.items():\n    if ingredient == \"_key\":\n      continue\n    ingredient_index = env.world.cookbook.index[ingredient]\n    current_count = env._current_state.inventory[ingredient_index]\n    if current_count < count:\n      missing_ingredients[ingredient] = count - current_count\n\n  # If any ingredients are missing, attempt to collect them.\n  for ingredient, required_count in missing_ingredients.items():\n    ingredient_index = env.world.cookbook.index[ingredient]\n    actions.extend(collect_v3(env, ingredient, required_count))\n\n  # Find the closest workshop that can craft the item.\n  closest_workshop_pos = find_closest_workshop(workshop_indices)\n  if closest_workshop_pos is None:\n    return []\n\n  # Move to the closest workshop.\n  target_x, target_y = closest_workshop_pos\n  actions.extend(move_to_position(env._current_state.pos, (target_x, target_y)))\n\n  # Adjust facing direction before using the USE action.\n  actions.append(turn_to_direction(env._current_state.dir, craft.DIR_UP))\n\n  # Use the USE action at the correct location.\n  actions.append(craft.ACTION_USE)\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-09T23:45:21.799069", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n\n  if item_index in env.world.cookbook.primitives:\n    return []\n\n  recipe = env.world.cookbook.recipes.get(item_index)\n\n  if not recipe or \"_key\" not in recipe:\n    return []\n\n  workshop_key = recipe[\"_key\"]\n  workshop_index = env.world.cookbook.index[workshop_key]\n\n  actions = []\n  missing_ingredients = {}\n  for ingredient, count in recipe.items():\n    if ingredient == \"_key\":\n      continue\n    ingredient_index = env.world.cookbook.index[ingredient]\n    current_count = env._current_state.inventory[ingredient_index]\n    if current_count < count:\n      missing_ingredients[ingredient] = count - current_count\n\n  for ingredient, required_count in missing_ingredients.items():\n    ingredient_index = env.world.cookbook.index[ingredient]\n    actions.extend(collect_v3(env, ingredient, required_count))\n\n  # Find the closest workshop.\n  closest_workshop_pos = find_closest_workshop([workshop_index])\n  if closest_workshop_pos is None:\n    return []\n\n  target_x, target_y = closest_workshop_pos\n  actions.extend(move_to_position(env._current_state.pos, (target_x, target_y)))\n\n  # Face the correct direction to use the workshop.\n  actions.extend(face_workshop_direction(env._current_state.pos, closest_workshop_pos))\n\n  # Use the USE action at the correct location.\n  actions.append(craft.ACTION_USE)\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-09T23:46:28.479655", "function_name": "craft", "function_body": "  # Find the index of the desired item\n  goal_index = env.world.cookbook.index[item]\n  \n  # Get the primitives required for crafting the item\n  primitives_required = env.world.cookbook.primitives_for(goal_index)\n  \n  actions = []\n  \n  # Check if we have all the required primitives in our inventory\n  have_all_primitives = True\n  for primitive, count in primitives_required.items():\n    if env._current_state.inventory[primitive] < count:\n      have_all_primitives = False\n      break\n  \n  if not have_all_primitives:\n    return actions  # Return empty list as we can't craft the item\n\n  # Find the workshop required to craft the item\n  recipe = env.world.cookbook.recipes[goal_index]\n  workshop_key = [key for key in recipe.keys() if key.startswith('_at')][0]\n  workshop_name = recipe[workshop_key]\n  \n  # Get the index of the workshop\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the workshop in the grid\n  pos_x, pos_y = np.where(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(pos_x) == 0 or len(pos_y) == 0:\n    return actions  # Return empty list as we can't find the workshop\n\n  workshop_pos = (pos_x[0], pos_y[0])\n\n  # Calculate the actions required to move to the workshop\n  move_actions = calculate_move_to(env._current_state.pos, workshop_pos)\n  \n  # Add the calculated move actions to the action list\n  actions.extend(move_actions)\n\n  # Turn the agent to face the workshop\n  turn_action = calculate_turn_to_face(env._current_state.dir, workshop_pos, env._current_state.pos)\n  if turn_action is not None:\n    actions.append(turn_action)\n\n  # Add USE action to craft the item at the workshop\n  actions.append(4)  # USE action\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-09T23:46:29.474039", "function_name": "craft", "function_body": "  actions = []\n\n  # Convert item name to index\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item has a recipe in the cookbook\n  if item_index not in env.world.cookbook.recipes:\n    return []  # No recipe for this item\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Check if all required primitives are available\n  for ingredient, count in recipe.items():\n    if ingredient == \"_at\":\n      continue  # Skip the workshop information\n    ingredient_index = env.world.cookbook.index[ingredient]\n    if env._current_state.inventory[ingredient_index] < count:\n      return []  # Missing required primitives\n\n  # Get the workshop index\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the workshop on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(workshop_positions) == 0:\n    return []  # Workshop not found\n\n  # Assume we take the first occurrence of the workshop for simplicity\n  workshop_pos = tuple(workshop_positions[0])\n\n  # Calculate actions to move to the workshop\n  path_to_workshop = pathfinding(env._current_state.pos, workshop_pos)\n  actions.extend(path_to_workshop)\n\n  # Add USE action to craft the item at the workshop\n  actions.append(craft.USE)\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-09T23:48:10.540919", "function_name": "craft", "function_body": "  def find_closest_workshop(workshops):\n    x, y = env._current_state.pos\n    min_distance = float('inf')\n    closest_workshop = None\n    for workshop in workshops:\n      wx, wy = workshop\n      distance = abs(wx - x) + abs(wy - y)\n      if distance < min_distance:\n        min_distance = distance\n        closest_workshop = (wx, wy, workshop)\n    return closest_workshop\n\n  def get_required_primitives(item_index):\n    recipe = env.world.cookbook.recipes[item_index]\n    required_primitives = {}\n    for ingredient, count in recipe.items():\n      if ingredient != \"_key\":\n        required_primitives[ingredient] = count\n    return required_primitives\n\n  def check_inventory(primitives):\n    current_inventory = env._current_state.inventory\n    missing_items = []\n    for primitive_index, count in primitives.items():\n      if current_inventory[primitive_index] < count:\n        missing_items.append((primitive_index, count - current_inventory[primitive_index]))\n    return missing_items\n\n  def move_to_workshop(workshop_pos):\n    x, y = env._current_state.pos\n    wx, wy = workshop_pos\n    actions = []\n    if x < wx:\n      actions.extend([craft.N_RIGHT] * (wx - x))\n    elif x > wx:\n      actions.extend([craft.N_LEFT] * (x - wx))\n    if y < wy:\n      actions.extend([craft.N_DOWN] * (wy - y))\n    elif y > wy:\n      actions.extend([craft.N_UP] * (y - wx))\n    return actions\n\n  def move_to_target(target_pos):\n    x, y = env._current_state.pos\n    tx, ty = target_pos\n    actions = []\n    if x < tx:\n      actions.extend([craft.N_RIGHT] * (tx - x))\n    elif x > tx:\n      actions.extend([craft.N_LEFT] * (x - tx))\n    if y < ty:\n      actions.extend([craft.N_DOWN] * (ty - y))\n    elif y > ty:\n      actions.extend([craft.N_UP] * (y - ty))\n    return actions\n\n  def collect_primitives(missing_items):\n    actions = []\n    for primitive_index, count in missing_items:\n      if primitive_index not in env.world.grabbable_indices:\n        continue\n      primitive_name = env.world.cookbook.index.get(primitive_index)\n      while current_inventory[primitive_index] < count:\n        # Find the nearest cell containing the required primitive\n        positions = np.argwhere(env._current_state.grid[:, :, primitive_index] > 0)\n        if len(positions) == 0:\n          break\n        closest_position = min(positions, key=lambda p: abs(p[0] - env._current_state.pos[0]) + abs(p[1] - env._current_state.pos[1]))\n        actions.extend(move_to_target(closest_position))\n        actions.append(craft.N_USE)\n    return actions\n\n  item_index = env.world.cookbook.index[craft.parse_fexp(item)[1]]\n  required_primitives = get_required_primitives(item_index)\n  missing_items = check_inventory(required_primitives)\n\n  if missing_items:\n    # Collect missing primitives\n    collect_actions = collect_primitives(missing_items)\n    if not collect_actions:\n      return []  # If no actions to collect, return empty list\n\n  # Find the closest workshop that can craft the item\n  workshops = env.world.workshop_indices\n  required_workshop_key = get_required_primitives(item_index)[\"_key\"]\n  required_workshop_name = f\"WORKSHOP{required_workshop_key}\"\n  required_workshop_index = env.world.cookbook.index[craft.parse_fexp(required_workshop_name)[1]]\n  closest_workshop = find_closest_workshop([pos for pos, value in np.ndenumerate(env._current_state.grid[:, :, required_workshop_index]) if value > 0])\n\n  if not closest_workshop:\n    return []  # If no workshop found, return empty list\n\n  workshop_pos = closest_workshop[0:2]\n  move_to_workshop_actions = move_to_workshop(workshop_pos)\n  actions = collect_actions + move_to_workshop_actions + [craft.N_USE]\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-09T23:48:11.510729", "function_name": "craft", "function_body": "  index = env.world.cookbook.index\n  recipe = env.world.cookbook.recipes[index[item]]\n\n  # Check if the required ingredients are available in inventory.\n  inventory = env._current_state.inventory\n\n  # Check which primitives are needed and how many.\n  required_primitives = env.world.cookbook.primitives_for(index[item])\n\n  actions = []\n\n  # Collect missing primitives\n  for primitive, count in required_primitives.items():\n    while inventory[primitive] < count:\n      actions.extend(collect(env, index.get(primitive)))\n\n  # Check which workshop is needed\n  workshop_index = None\n  for ingredient_key, _ in recipe.items():\n    if \"_at\" in ingredient_key:\n      workshop_name = recipe[ingredient_key]\n      workshop_index = env.world.cookbook.index[index(workshop_name)]\n\n  # Navigate to the required workshop\n  workshop_position = find_workshop(env._current_state.grid, workshop_index)\n  actions.extend(navigate_to(env._current_state, workshop_position))\n\n  # Use action at the workshop\n  actions.append(4)  # Assuming USE action is represented by index 4\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-09T23:50:57.314079", "function_name": "craft", "function_body": "  def get_primitive_actions(primitive_index):\n    \"\"\"Returns a list of actions required to collect a primitive.\"\"\"\n    # Find all locations of the primitive in the grid\n    primitive_locations = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n    if len(primitive_locations) == 0:\n      return []\n\n    target_location = primitive_locations[np.random.choice(len(primitive_locations))]\n\n    actions = []\n    while env._current_state.pos != tuple(target_location):\n      dx, dy = target_location - np.array(env._current_state.pos)\n      direction = None\n      if dx < 0 and not env._current_state.next_to(env.world.cookbook.index['BOUNDARY']):\n        direction = env.world.N_ACTIONS.DOWN\n      elif dx > 0 and not env._current_state.next_to(env.world.cookbook.index['BOUNDARY']):\n        direction = env.world.N_ACTIONS.UP\n      elif dy < 0 and not env._current_state.next_to(env.world.cookbook.index['BOUNDARY']):\n        direction = env.world.N_ACTIONS.LEFT\n      elif dy > 0 and not env._current_state.next_to(env.world.cookbook.index['BOUNDARY']):\n        direction = env.world.N_ACTIONS.RIGHT\n\n      if direction is not None:\n        actions.append(direction)\n\n    # Add the USE action to collect the primitive\n    actions.append(env.world.N_ACTIONS.USE)\n    \n    return actions\n\n  def get_workshop_actions(workshop_index):\n    \"\"\"Returns a list of actions required to move to and use the workshop.\"\"\"\n    # Find all locations of the workshop in the grid\n    workshop_locations = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_locations) == 0:\n      return []\n\n    target_location = workshop_locations[np.random.choice(len(workshop_locations))]\n\n    actions = []\n    while env._current_state.pos != tuple(target_location):\n      dx, dy = target_location - np.array(env._current_state.pos)\n      direction = None\n      if dx < 0 and not env._current_state.next_to(env.world.cookbook.index['BOUNDARY']):\n        direction = env.world.N_ACTIONS.DOWN\n      elif dx > 0 and not env._current_state.next_to(env.world.cookbook.index['BOUNDARY']):\n        direction = env.world.N_ACTIONS.UP\n      elif dy < 0 and not env._current_state.next_to(env.world.cookbook.index['BOUNDARY']):\n        direction = env.world.N_ACTIONS.LEFT\n      elif dy > 0 and not env._current_state.next_to(env.world.cookbook.index['BOUNDARY']):\n        direction = env.world.N_ACTIONS.RIGHT\n\n      if direction is not None:\n        actions.append(direction)\n\n    # Add the USE action to use the workshop\n    actions.append(env.world.N_ACTIONS.USE)\n    \n    return actions\n\n  def has_all_primitives(primitive_counts):\n    \"\"\"Check if the agent's inventory has all required primitives.\"\"\"\n    for primitive_index, count in primitive_counts.items():\n      if env._current_state.inventory[primitive_index] < count:\n        return False\n    return True\n\n  # Get the index of the item to craft\n  item_index = env.world.cookbook.index[item]\n\n  # Get the primitive counts required to craft the item\n  primitive_counts = env.world.cookbook.primitives_for(item_index)\n\n  if not has_all_primitives(primitive_counts):\n    return []\n\n  actions = []\n  \n  # Collect all required primitives\n  for primitive, count in primitive_counts.items():\n    for _ in range(count):\n      actions.extend(get_primitive_actions(primitive))\n  \n  # Move to the workshop and use it to craft the item\n  if \"_key\" in env.world.cookbook.recipes[item_index]:\n    workshop_key = env.world.cookbook.recipes[item_index][\"_key\"]\n    workshop_index = env.world.cookbook.index[workshop_key]\n    actions.extend(get_workshop_actions(workshop_index))\n  \n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-09-09T23:55:57.375810", "function_name": "craft", "function_body": "  def get_primitive_actions(primitive_index):\n    \"\"\"Returns a list of actions required to collect a primitive.\"\"\"\n    # Find all locations of the primitive in the grid\n    primitive_locations = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n    if len(primitive_locations) == 0:\n      return []\n\n    target_location = primitive_locations[np.random.choice(len(primitive_locations))]\n\n    actions = []\n    while env._current_state.pos != tuple(target_location):\n      dx, dy = target_location - np.array(env._current_state.pos)\n      direction = None\n      if dx < 0 and not env._current_state.next_to(env.world.cookbook.index['BOUNDARY']):\n        direction = env.world.N_ACTIONS.DOWN\n      elif dx > 0 and not env._current_state.next_to(env.world.cookbook.index['BOUNDARY']):\n        direction = env.world.N_ACTIONS.UP\n      elif dy < 0 and not env._current_state.next_to(env.world.cookbook.index['BOUNDARY']):\n        direction = env.world.N_ACTIONS.LEFT\n      elif dy > 0 and not env._current_state.next_to(env.world.cookbook.index['BOUNDARY']):\n        direction = env.world.N_ACTIONS.RIGHT\n\n      if direction is not None:\n        actions.append(direction)\n\n    # Add the USE action to collect the primitive\n    actions.append(env.world.N_ACTIONS.USE)\n    \n    return actions\n\n  def get_workshop_actions(workshop_index):\n    \"\"\"Returns a list of actions required to move to and use the workshop.\"\"\"\n    # Find all locations of the workshop in the grid\n    workshop_locations = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_locations) == 0:\n      return []\n\n    target_location = workshop_locations[np.random.choice(len(workshop_locations))]\n\n    actions = []\n    while env._current_state.pos != tuple(target_location):\n      dx, dy = target_location - np.array(env._current_state.pos)\n      direction = None\n      if dx < 0 and not env._current_state.next_to(env.world.cookbook.index['BOUNDARY']):\n        direction = env.world.N_ACTIONS.DOWN\n      elif dx > 0 and not env._current_state.next_to(env.world.cookbook.index['BOUNDARY']):\n        direction = env.world.N_ACTIONS.UP\n      elif dy < 0 and not env._current_state.next_to(env.world.cookbook.index['BOUNDARY']):\n        direction = env.world.N_ACTIONS.LEFT\n      elif dy > 0 and not env._current_state.next_to(env.world.cookbook.index['BOUNDARY']):\n        direction = env.world.N_ACTIONS.RIGHT\n\n      if direction is not None:\n        actions.append(direction)\n\n    # Add the USE action to use the workshop\n    actions.append(env.world.N_ACTIONS.USE)\n    \n    return actions\n\n  def has_all_primitives(primitive_counts):\n    \"\"\"Check if the agent's inventory has all required primitives.\"\"\"\n    for primitive_index, count in primitive_counts.items():\n      if env._current_state.inventory[primitive_index] < count:\n        return False\n    return True\n\n  # Get the index of the item to craft\n  item_index = env.world.cookbook.index[item]\n\n  # Get the primitive counts required to craft the item\n  primitive_counts = env.world.cookbook.primitives_for(item_index)\n\n  actions = []\n  \n  # Collect all required primitives if not already in inventory\n  for primitive, count in primitive_counts.items():\n    while env._current_state.inventory[primitive] < count:\n      actions.extend(get_primitive_actions(primitive))\n  \n  # Move to the workshop and use it to craft the item\n  if \"_key\" in env.world.cookbook.recipes[item_index]:\n    workshop_key = env.world.cookbook.recipes[item_index][\"_key\"]\n    workshop_index = env.world.cookbook.index[workshop_key]\n    actions.extend(get_workshop_actions(workshop_index))\n  \n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-09T23:56:50.079053", "function_name": "craft", "function_body": "  def move_to_workshop(env, workshop_index):\n    target_pos = find_nearest_workshop(env._current_state.grid, workshop_index)\n    if target_pos:\n      path_actions = a_star_search(\n          env._current_state.pos, target_pos, env._current_state.grid\n      )\n      return path_actions + [turn_towards(env._current_state.dir, target_pos)]\n    else:\n      return []\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the desired item is a primitive; primitives cannot be crafted.\n  if item_index in env.world.cookbook.primitives:\n    return []\n\n  # Fetch the recipe for crafting the specified item.\n  recipe = env.world.cookbook.recipes.get(item_index)\n\n  # If no valid recipe exists or \"_key\" not specified, return an empty action list.\n  if not recipe or \"_key\" not in recipe:\n    return []\n\n  workshop_key = recipe[\"_key\"]\n  workshop_index = env.world.cookbook.index[workshop_key]\n\n  actions = []\n  # Check inventory for sufficient primitives.\n  missing_ingredients = {}\n  for ingredient, count in recipe.items():\n    if ingredient == \"_key\":\n      continue\n    ingredient_index = env.world.cookbook.index[ingredient]\n    current_count = env._current_state.inventory[ingredient_index]\n    if current_count < count:\n      missing_ingredients[ingredient] = count - current_count\n\n  # If any ingredients are missing, attempt to collect them.\n  for ingredient, required_count in missing_ingredients.items():\n    ingredient_index = env.world.cookbook.index[ingredient]\n    actions.extend(collect_v4(env, ingredient, required_count))\n\n  # Move to a workshop that can craft the item.\n  actions.extend(move_to_workshop(env, workshop_index))\n\n  # Use the USE action at the correct location.\n  actions.append(craft.ACTION_USE)\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-09T23:56:51.154928", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n\n  if item_index in env.world.cookbook.primitives:\n    return []\n\n  recipe = env.world.cookbook.recipes.get(item_index)\n\n  if not recipe or \"_key\" not in recipe:\n    return []\n\n  workshop_key = recipe[\"_key\"]\n  workshop_index = env.world.cookbook.index[workshop_key]\n\n  actions = []\n  missing_ingredients = {}\n  for ingredient, count in recipe.items():\n    if ingredient == \"_key\":\n      continue\n    ingredient_index = env.world.cookbook.index[ingredient]\n    current_count = env._current_state.inventory[ingredient_index]\n    if current_count < count:\n      missing_ingredients[ingredient] = count - current_count\n\n  for ingredient, required_count in missing_ingredients.items():\n    ingredient_index = env.world.cookbook.index[ingredient]\n    actions.extend(collect_v4(env, ingredient, required_count))\n\n  # Ensure the agent is next to the workshop before using it.\n  if not env._current_state.next_to(workshop_index):\n    actions.extend(move_to_workshop(env, workshop_index))\n\n  actions.append(craft.ACTION_USE)\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-09T23:58:45.976836", "function_name": "craft", "function_body": "  def collect_ingredient(name: str):\n    ingredient_idx = env.world.cookbook.index[name]\n    if env._current_state.inventory[ingredient_idx] >= recipe.get(name, 0):\n      return []\n    \n    # Find positions of the ingredient in the grid\n    ingredient_positions = []\n    for y in range(env._current_state.grid.shape[1]):\n        for x in range(env._current_state.grid.shape[0]):\n            if env._current_state.grid[x, y, ingredient_idx] == 1:\n                ingredient_positions.append((x, y))\n    \n    actions = []\n    while ingredient_positions and env._current_state.inventory[ingredient_idx] < recipe.get(name, 0):\n        ingredient_pos = ingredient_positions.pop()\n        \n        # Move to the ingredient position\n        actions.extend(move_to(env._current_state, ingredient_pos))\n        \n        # Perform the USE action to collect the ingredient\n        actions.append(4)  # USE action index\n    \n    return actions\n\n  actions = []\n  \n  # Get the index for the desired item from the cookbook\n  item_idx = env.world.cookbook.index[item]\n  \n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_idx, {})\n  \n  if not recipe:\n    return []  # No recipe found\n  \n  # Determine the workshop where the crafting should happen\n  workshop_key = \"_key\"\n  workshop_index = int(recipe.get(workshop_key, -1))\n  \n  if workshop_index == -1:\n    return []  # Workshop not specified in the recipe\n  \n  # Get the list of workshops from the world configuration\n  workshop_indices = env.world.workshop_indices\n  \n  if workshop_index >= len(workshop_indices):\n    return []  # Invalid workshop index\n  \n  # Determine the target position for the workshop\n  target_workshop_pos = None\n  for y in range(env._current_state.grid.shape[1]):\n      for x in range(env._current_state.grid.shape[0]):\n          if env._current_state.grid[x, y, workshop_indices[workshop_index]] == 1:\n              target_workshop_pos = (x, y)\n              break\n      if target_workshop_pos is not None:\n          break\n  \n  if target_workshop_pos is None:\n    return []  # Workshop position not found in the grid\n  \n  # Check and collect required primitives\n  for ingredient_name, quantity in recipe.items():\n      if ingredient_name == workshop_key:\n          continue\n      \n      actions.extend(collect_ingredient(ingredient_name))\n  \n  # Move to the target workshop\n  actions.extend(move_to(env._current_state, target_workshop_pos))\n  \n  # Perform the USE action at the workshop\n  actions.append(4)  # USE action index\n  \n  return actions", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-09-09T23:58:47.144956", "function_name": "craft", "function_body": "  def collect_ingredient(name: str):\n    ingredient_idx = env.world.cookbook.index[name]\n    if env._current_state.inventory[ingredient_idx] > 0:\n      return []\n    \n    # Find positions of the ingredient in the grid\n    ingredient_positions = [(x, y) for y in range(env._current_state.grid.shape[1])\n                            for x in range(env._current_state.grid.shape[0])\n                            if env._current_state.grid[x, y, ingredient_idx] == 1]\n    \n    actions = []\n    while ingredient_positions:\n        ingredient_pos = ingredient_positions.pop()\n        \n        # Move to the ingredient position\n        actions.extend(move_to(env._current_state, ingredient_pos))\n        \n        # Perform the USE action to collect the ingredient\n        actions.append(4)  # USE action index\n    \n    return actions\n\n  actions = []\n  \n  # Get the index for the desired item from the cookbook\n  item_idx = env.world.cookbook.index[item]\n  \n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_idx, {})\n  \n  if not recipe:\n    return []  # No recipe found\n  \n  # Determine the workshop where the crafting should happen\n  workshop_key = \"_key\"\n  workshop_index = int(recipe.get(workshop_key, -1))\n  \n  if workshop_index == -1:\n    return []  # Workshop not specified in the recipe\n  \n  # Get the list of workshops from the world configuration\n  workshop_indices = env.world.workshop_indices\n  \n  if workshop_index >= len(workshop_indices):\n    return []  # Invalid workshop index\n  \n  # Determine the target position for the workshop\n  target_workshop_pos = None\n  for y in range(env._current_state.grid.shape[1]):\n      for x in range(env._current_state.grid.shape[0]):\n          if env._current_state.grid[x, y, workshop_indices[workshop_index]] == 1:\n              target_workshop_pos = (x, y)\n              break\n      if target_workshop_pos is not None:\n          break\n  \n  if target_workshop_pos is None:\n    return []  # Workshop position not found in the grid\n  \n  # Check and collect required primitives\n  for ingredient_name, quantity in recipe.items():\n      if ingredient_name == workshop_key:\n          continue\n      \n      actions.extend(collect_ingredient(ingredient_name))\n  \n  # Move to the target workshop\n  actions.extend(move_to(env._current_state, target_workshop_pos))\n  \n  # Perform the USE action at the workshop\n  actions.append(4)  # USE action index\n  \n  return actions", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-09-09T23:59:32.853732", "function_name": "craft", "function_body": "  # Convert item name to index using the cookbook\n  goal_index = env.world.cookbook.index[item]\n\n  # Check if we have all primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n\n  current_inventory = collections.Counter(env._current_state.inventory)\n  missing_primitives = {prim: count - current_inventory[prim] for prim, count in required_primitives.items() if count > current_inventory[prim]}\n  \n  actions = []\n\n  # If we have all the primitives, proceed to craft the item at the correct workshop\n  if not missing_primitives:\n    actions.extend(find_workshop_and_craft(env, goal_index))\n  else:\n    # Collect missing primitives\n    for prim, count in missing_primitives.items():\n      actions.extend(collect_primitive_v2(env, env.world.cookbook.index.get(prim), count))\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-09T23:59:33.837342", "function_name": "craft", "function_body": "  # Convert item name to index using the cookbook\n  goal_index = env.world.cookbook.index[item]\n\n  # Check if we have all primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n\n  current_inventory = collections.Counter(env._current_state.inventory)\n  missing_primitives = {prim: count - current_inventory[prim] for prim, count in required_primitives.items() if count > current_inventory[prim]}\n  \n  actions = []\n\n  if not missing_primitives:\n    # We have all the primitives, proceed to craft the item at the correct workshop\n    actions.extend(find_workshop_and_craft(env, goal_index))\n  else:\n    # Collect missing primitives\n    for prim, count in missing_primitives.items():\n      actions.extend(collect_primitive_v2(env, prim, count))\n\n    # After collecting all primitives, proceed to craft the item at the correct workshop\n    actions.extend(find_workshop_and_craft(env, goal_index))\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-10T00:00:22.138958", "function_name": "craft", "function_body": "  # Convert item name to index using the cookbook\n  goal_index = env.world.cookbook.index[item]\n\n  # Check if we have all primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n\n  current_inventory = collections.Counter(env._current_state.inventory)\n  missing_primitives = {prim: count - current_inventory[prim] for prim, count in required_primitives.items() if count > current_inventory[prim]}\n  \n  actions = []\n\n  # If we are missing any primitives, collect them first\n  if missing_primitives:\n    for primitive_index, needed_count in missing_primitives.items():\n      primitive_name = env.world.cookbook.index.get(primitive_index)\n      actions.extend(collect_primitive(env, primitive_name, needed_count))\n  \n  # Proceed to craft the item at the correct workshop\n  actions.extend(find_workshop_and_craft(env, goal_index))\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-10T00:00:23.174652", "function_name": "craft", "function_body": "  def find_closest_block_of_kind(grid, pos, kind):\n      width, height = grid.shape[:2]\n      directions = [(0, 1), (1, 0), (-1, 0), (0, -1)]\n      for d in range(1, max(width, height)):\n          for dx, dy in directions:\n              x, y = pos[0] + dx * d, pos[1] + dy * d\n              if 0 <= x < width and 0 <= y < height:\n                  if grid[x, y, kind]:\n                      return (x, y)\n      return None\n\n  actions = []\n  \n  # Convert item name to index using the cookbook\n  goal_index = env.world.cookbook.index[item]\n\n  # Check if we have all primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n\n  current_inventory = collections.Counter(env._current_state.inventory)\n  missing_primitives = {prim: count - current_inventory[prim] for prim, count in required_primitives.items() if count > current_inventory[prim]}\n  \n  # Collecting all missing primitives\n  for primitive, count in missing_primitives.items():\n      for _ in range(count):\n          block_pos = find_closest_block_of_kind(env._current_state.grid, env._current_state.pos, primitive)\n          if block_pos:\n              actions.extend(move_to_position(env._current_state.pos, block_pos))\n              actions.append(craft.ACTIONS['USE'])\n          else:\n              return []\n\n  # After collecting all primitives, proceed to craft the item at the correct workshop\n  actions.extend(find_workshop_and_craft(env, goal_index))\n  \n  return actions", "island_id": 3, "scores": {"3": -1}}
