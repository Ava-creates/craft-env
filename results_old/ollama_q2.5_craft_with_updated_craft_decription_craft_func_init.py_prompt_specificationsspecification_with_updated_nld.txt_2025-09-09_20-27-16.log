{"timestamp": "2025-09-10T13:32:49.068464", "function_name": "craft", "function_body": "  def _move_to_position(target_pos):\n      # Find the path to the target position using A* search\n      start = env._current_state.pos\n      \n      def heuristic(a, b):\n          return abs(a[0] - b[0]) + abs(a[1] - b[1])\n      \n      open_set = collections.PriorityQueue()\n      open_set.put((0, start))\n      came_from = {}\n      g_score = {start: 0}\n      \n      while not open_set.empty():\n          _, current = open_set.get()\n          \n          if current == target_pos:\n              path = []\n              while current in came_from:\n                  path.append(current)\n                  current = came_from[current]\n              path.reverse()\n              actions = _convert_path_to_actions(path, start)\n              return actions\n          \n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              if 0 <= neighbor[0] < env.world.WIDTH and 0 <= neighbor[1] < env.world.HEIGHT:\n                  tentative_g_score = g_score[current] + 1\n                  if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                      came_from[neighbor] = current\n                      g_score[neighbor] = tentative_g_score\n                      f_score = tentative_g_score + heuristic(neighbor, target_pos)\n                      open_set.put((f_score, neighbor))\n      \n      return []\n  \n  def _convert_path_to_actions(path, start):\n      actions = []\n      cx, cy = start\n      \n      for x, y in path:\n          if cx < x:\n              actions.append(craft.RIGHT)\n          elif cx > x:\n              actions.append(craft.LEFT)\n          if cy < y:\n              actions.append(craft.DOWN)\n          elif cy > y:\n              actions.append(craft.UP)\n          cx, cy = x, y\n      \n      return actions\n  \n  def _has_required_primitives(primitive_indices):\n      for i in primitive_indices:\n          if env._current_state.inventory[i] <= 0:\n              return False\n      return True\n\n  index = env.world.cookbook.index\n  item_index = index[item]\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n\n  actions = []\n\n  # Check if the item is directly craftable without a workshop\n  if \"_key\" not in recipe:\n      for ingredient, count in recipe.items():\n          if env._current_state.inventory[ingredient] < count:\n              return []\n      return [craft.USE]\n\n  key_index = recipe[\"_key\"]\n  workshop_index = env.world.workshop_indices[key_index]\n  \n  # Collect all required primitives\n  missing_primitives = {i: max(count - env._current_state.inventory[i], 0) for i in recipe if i != \"_key\"}\n  \n  # Find and collect the required primitives\n  primitive_positions = {}\n  for x in range(env.world.WIDTH):\n      for y in range(env.world.HEIGHT):\n          for i in missing_primitives:\n              if np.any(env._current_state.grid[x, y] == i) and missing_primitives[i] > 0:\n                  if i not in primitive_positions:\n                      primitive_positions[i] = []\n                  primitive_positions[i].append((x, y))\n  \n  # Collect each required primitive\n  for ingredient in missing_primitives:\n      if missing_primitives[ingredient] > 0:\n          for _ in range(missing_primitives[ingredient]):\n              nearest_primitive_position = None\n              closest_distance = float('inf')\n              \n              for pos in primitive_positions.get(ingredient, []):\n                  distance = abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n                  if distance < closest_distance:\n                      nearest_primitive_position = pos\n                      closest_distance = distance\n              \n              if nearest_primitive_position is not None:\n                  actions.extend(_move_to_position(nearest_primitive_position))\n                  actions.append(craft.USE)  # Pick up the primitive\n  \n  # Check again if all required primitives are collected\n  if not _has_required_primitives([i for i in recipe if i != \"_key\"]):\n      return []\n  \n  # Find all positions of the required workshop\n  workshop_positions = []\n  for x in range(env.world.WIDTH):\n      for y in range(env.world.HEIGHT):\n          if np.any(env._current_state.grid[x, y] == workshop_index):\n              workshop_positions.append((x, y))\n  \n  # Move to the nearest workshop\n  actions_to_workshop = None\n  closest_distance = float('inf')\n  \n  for wp in workshop_positions:\n      distance = abs(wp[0] - env._current_state.pos[0]) + abs(wp[1] - env._current_state.pos[1])\n      if distance < closest_distance:\n          actions_to_workshop = _move_to_position(wp)\n          closest_distance = distance\n  \n  # Ensure the agent is facing the correct direction to use the workshop\n  target_pos = None\n  for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n      neighbor_pos = (env._current_state.pos[0] + dx, env._current_state.pos[1] + dy)\n      if 0 <= neighbor_pos[0] < env.world.WIDTH and 0 <= neighbor_pos[1] < env.world.HEIGHT:\n          if np.any(env._current_state.grid[neighbor_pos[0], neighbor_pos[1]] == workshop_index):\n              target_pos = neighbor_pos\n              break\n  \n  if target_pos is not None:\n      direction_to_target = (target_pos[0] - env._current_state.pos[0], target_pos[1] - env._current_state.pos[1])\n      \n      if direction_to_target == (-1, 0):\n          actions_to_workshop.append(craft.LEFT)\n      elif direction_to_target == (1, 0):\n          actions_to_workshop.append(craft.RIGHT)\n      elif direction_to_target == (0, -1):\n          actions_to_workshop.append(craft.UP)\n      elif direction_to_target == (0, 1):\n          actions_to_workshop.append(craft.DOWN)\n  \n  # Finally, add the USE action\n  if actions_to_workshop is not None:\n      actions.extend(actions_to_workshop)\n      actions.append(craft.USE)\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-10T13:33:46.005208", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  item_idx = env.world.cookbook.index[item]\n  \n  # Get the primitives required to craft the item\n  primitive_counts = env.world.cookbook.primitives_for(item_idx)\n  \n  actions = []\n  \n  # Collect each required primitive\n  for primitive, count in primitive_counts.items():\n    primitive_name = env.world.cookbook.index.get(primitive)\n    \n    if not env._current_state.inventory[primitive]:\n      actions.extend(collect_v2(env, primitive_name))\n      \n  # Find the workshop specified in the recipe\n  workshop_idx = None\n  for ingredient, _ in env.world.cookbook.recipes[item_idx].items():\n    if ingredient == \"_at\":\n      workshop_idx = env.world.cookbook.index[env.world.cookbook.recipes[item_idx][ingredient]]\n  \n  if workshop_idx is None:\n    raise ValueError(f\"No workshop specified for crafting {item}.\")\n    \n  # Navigate to the workshop\n  actions.extend(navigate_to_v2(env, workshop_idx))\n      \n  # Use action at the workshop\n  actions.append(craft.USE)\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-10T13:33:46.988895", "function_name": "craft", "function_body": "  index = env.world.cookbook.index\n  item_index = index.index(item)\n  if item_index not in env.world.cookbook.recipes:\n    print(f\"No recipe found for {item}.\")\n    return []\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  required_items = {}\n  workshop_index = None\n\n  # Parse the recipe to get required items and the workshop index\n  for ingredient, count in recipe.items():\n    if ingredient == \"_at\":\n      workshop_name = recipe[\"_at\"]\n      workshop_index = index.index(workshop_name)\n    else:\n      required_items[index.index(ingredient)] = count\n\n  # Check if we have all required primitives or intermediate items in the inventory\n  missing_items = {item: count for item, count in required_items.items() \n                   if env._current_state.inventory[item] < count}\n  \n  if missing_items:\n    print(f\"Missing items for crafting {item}: {missing_items}\")\n    return []\n\n  # If we have all items, proceed to craft the item\n  actions = []\n  \n  # Move to the workshop\n  # Placeholder: need a function to navigate to the nearest workshop with index `workshop_index`\n  # For simplicity, let's assume the agent can magically move to the workshop\n  actions.append(craft.MOVE_FUNC(\"UP\"))  # Example action, replace with actual navigation\n\n  # Use the USE action at the workshop\n  actions.append(craft.USE_FUNC)\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-10T13:35:28.562230", "function_name": "craft", "function_body": "  # Resolve the index for the target item.\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the recipe exists.\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Extract the recipe details, separating ingredients and workshop location.\n  recipe = env.world.cookbook.recipes[item_index]\n  ingredients_needed = {ingredient: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n  workshop_name = recipe[\"_at\"]\n  workshop_index = getattr(env.world, f\"{workshop_name}_index\")\n\n  # Retrieve the current inventory and convert it into a dictionary mapping indices to counts.\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n\n  # Calculate the difference between required ingredients and available inventory.\n  ingredients_needed = {ingredient: ingredients_needed[ingredient] - inventory_dict.get(ingredient, 0)\n                          for ingredient in ingredients_needed}\n  \n  # Filter out ingredients that are already fully satisfied by the current inventory.\n  ingredients_needed = {ingredient: count for ingredient, count in ingredients_needed.items() if count > 0}\n\n  # If there are still ingredients needed, attempt to collect them first.\n  actions_to_take = []\n  if ingredients_needed:\n    for ingredient_index, required_count in ingredients_needed.items():\n      primitive_name = env.world.cookbook.index.get(ingredient_index)\n      if not primitive_name:\n        return []  # Invalid ingredient index\n\n      # Collect the necessary amount of each required ingredient.\n      collect_actions = collect(env, primitive_name)\n      if not collect_actions:\n        return []  # Unable to collect the required ingredient\n      \n      actions_to_take.extend(collect_actions)\n\n  # Find the nearest workshop for crafting.\n  pos_x, pos_y = env._current_state.pos\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  \n  if not workshop_positions.size:\n    return []\n\n  # Calculate distances to each workshop and determine the closest one.\n  distances = [abs(x - pos_x) + abs(y - pos_y) for x, y in workshop_positions]\n  nearest_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n\n  # Determine actions required to move to the nearest workshop.\n  while (pos_x, pos_y) != nearest_workshop_pos:\n    dx = nearest_workshop_pos[0] - pos_x\n    dy = nearest_workshop_pos[1] - pos_y\n\n    if abs(dx) > abs(dy):\n      move_dir = \"RIGHT\" if dx > 0 else \"LEFT\"\n    else:\n      move_dir = \"DOWN\" if dy > 0 else \"UP\"\n\n    actions_to_take.append(env.world.N_ACTIONS[move_dir])\n    # Update the agent's position for the next iteration.\n    pos_x, pos_y = env._current_state.pos\n\n  # Add the USE action to perform crafting at the workshop.\n  actions_to_take.append(env.world.USE)\n\n  return actions_to_take", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-10T13:35:29.550565", "function_name": "craft", "function_body": "  # Check if the goal is already satisfied\n  if env._current_state.satisfies(\"\", env.world.cookbook.index[item]):\n    return []\n\n  # Check if there's a recipe for this item\n  item_index = env.world.cookbook.index[item]\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the ingredients required to craft this item and the workshop location\n  recipe = env.world.cookbook.recipes[item_index]\n  ingredients_needed = {ingredient: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n  workshop_name = recipe[\"_at\"]\n  workshop_index = getattr(env.world, f\"{workshop_name}_index\")\n\n  # Check and collect missing ingredients\n  actions_to_take = []\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n\n  # Calculate the difference between required and available ingredients\n  for ingredient_name, required_count in ingredients_needed.items():\n    available_count = inventory_dict.get(ingredient_name, 0)\n    missing_count = required_count - available_count\n\n    # If there are missing ingredients, collect them\n    if missing_count > 0:\n      actions_to_take.extend(collect(env, ingredient_name, missing_count))\n\n  # Find the nearest workshop position\n  pos_x, pos_y = env._current_state.pos\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n  if not workshop_positions.size:\n    return []\n\n  # Calculate distances to each workshop and find the closest one\n  distances = [abs(x - pos_x) + abs(y - pos_y) for x, y in workshop_positions]\n  nearest_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n\n  # Determine actions to move to the nearest workshop\n  while (pos_x, pos_y) != nearest_workshop_pos:\n    dx = nearest_workshop_pos[0] - pos_x\n    dy = nearest_workshop_pos[1] - pos_y\n\n    if abs(dx) > abs(dy):\n      move_dir = \"RIGHT\" if dx > 0 else \"LEFT\"\n    else:\n      move_dir = \"DOWN\" if dy > 0 else \"UP\"\n\n    actions_to_take.append(env.world.N_ACTIONS[move_dir])\n    pos_x, pos_y = env._current_state.pos\n\n  # Add USE action to craft the item\n  actions_to_take.append(env.world.USE)\n\n  return actions_to_take", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-10T13:36:24.718504", "function_name": "craft", "function_body": "  def get_required_primitives(item_index):\n    \"\"\"Get the primitives required to make an item\"\"\"\n    # This function will take the index of the desired item and return a dictionary\n    # mapping primitive-kind indices (int) to counts (int) required to craft one goal.\n    return env.world.cookbook.primitives_for(item_index)\n\n  def find_workshop_for_item(item_index):\n      \"\"\"Finds the workshop index for crafting an item.\"\"\"\n      recipe = env.world.cookbook.recipes.get(item_index, {})\n      if \"_at\" in recipe:\n          workshop_name = recipe[\"_at\"]\n          return env.world.workshop_indices[env.world.cookbook.index[workshop_name]]\n      else:\n          raise ValueError(f\"No workshop specified for crafting {item_index}\")\n\n  def navigate_to_workshop(workshop_index):\n    \"\"\"Navigates the agent to the nearest workshop.\"\"\"\n    # Placeholder function for navigation\n    # This should return a list of actions to move the agent to the given workshop index.\n    pass\n\n  def perform_crafting_action():\n      \"\"\"Performs the crafting action at the workshop.\"\"\"\n      return [craft.CRAFT_FUNC(item)]\n\n  item_index = env.world.cookbook.index[item]\n  primitives_needed = get_required_primitives(item_index)\n  actions = []\n\n  # Check if all primitives are available in inventory\n  for primitive, count in primitives_needed.items():\n    if env._current_state.inventory[primitive] < count:\n      # If not, we need to collect the missing primitives\n      return []  # Placeholder: return an empty list or plan collection logic\n\n  workshop_index = find_workshop_for_item(item_index)\n  actions.extend(navigate_to_workshop(workshop_index))\n  actions.append(craft.CRAFT_FUNC(item))\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-10T13:36:25.685114", "function_name": "craft", "function_body": "  # Retrieve the index of the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item has a recipe; if not, return an empty action list\n  if item_index not in env.world.cookbook.recipes:\n    print(f\"No recipe found for {item}.\")\n    return []\n\n  # Get the recipe for the desired item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Collect all required primitives and intermediate items\n  actions = []\n  for ingredient, count in recipe.items():\n      if ingredient == \"_at\":\n          workshop_name = recipe[\"_at\"]\n          continue\n      elif ingredient == \"_key\": \n          continue  # _key is used to specify the key ingredient that must be crafted last\n      else:\n          required_count = count - env._current_state.inventory[ingredient]\n          if required_count > 0:\n              actions.extend(collect_v2(env, ingredient, required_count))\n\n  # Move to the specified workshop and use the USE action to craft the item\n  workshop_index = env.world.cookbook.index[workshop_name]\n  workshop_position = find_closest_workshop(env._current_state, workshop_index)\n  \n  if workshop_position:\n      actions.extend(move_to_and_use_workshop(env._current_state, workshop_position))\n  else:\n      print(f\"No available {workshop_name} found.\")\n      return []\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-10T13:37:25.422175", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Check if there is a recipe for the item\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Collect all required primitives and crafted items\n  actions = []\n  for ingredient, count in recipe.items():\n    if ingredient == \"_key\":  # This refers to the workshop type\n      continue\n\n    # Check if we already have enough of this ingredient in our inventory\n    ingredient_index = env.world.cookbook.index[ingredient]\n    needed_count = max(0, count - env._current_state.inventory[ingredient_index])\n\n    for _ in range(needed_count):\n      actions.extend(collect_v2(env, ingredient))\n\n  # Check if we have all the required primitives and crafted items\n  for ingredient, count in recipe.items():\n    if ingredient == \"_key\":  # This refers to the workshop type\n      continue\n\n    ingredient_index = env.world.cookbook.index[ingredient]\n    if env._current_state.inventory[ingredient_index] < count:\n      return []\n\n  # Get the workshop type\n  workshop_type = recipe[\"_key\"]\n\n  # Find a nearby workshop of the required type\n  for workshop_index in env.world.workshop_indices:\n    workshop_name = env.world.cookbook.index.get(workshop_index, \"\")\n    if workshop_type in workshop_name:\n      # Move to the workshop\n      actions.extend(move_to_workshop(env, workshop_index))\n\n      # Use the workshop to craft the item\n      actions.append(craft.ACTIONS[\"USE\"])\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-10T13:37:26.468120", "function_name": "craft", "function_body": "  actions = []\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n  \n  if goal_index not in cookbook.recipes:\n    print(f\"No recipe found for {item}.\")\n    return []\n\n  required_primitives = cookbook.primitives_for(goal_index)\n  # Check if we have all the primitives required to craft the item\n  for primitive, count in required_primitives.items():\n      if env._current_state.inventory[primitive] < count:\n          print(f\"Missing {count} of {cookbook.index.get(primitive)}\")\n          return []\n\n  # Find the workshop index where this item can be crafted\n  workshop_index = None\n  for recipe_key, recipe_value in cookbook.recipes.items():\n      if \"_at\" in recipe_value and recipe_value[\"_at\"] == item:\n          workshop_index = cookbook.index[recipe_value[\"_at\"]]\n          break\n\n  if workshop_index is None:\n      print(f\"No workshop found to craft {item}.\")\n      return []\n\n  # Find the nearest workshop location\n  workshops = env.world.workshop_indices\n  closest_workshop_pos = None\n  min_distance = float('inf')\n  for workshop in workshops:\n      distance = np.linalg.norm(np.array(workshop) - np.array(env._current_state.pos))\n      if distance < min_distance:\n          min_distance = distance\n          closest_workshop_pos = workshop\n\n  # Move to the closest workshop\n  actions.extend(move_to_position(env, closest_workshop_pos))\n\n  # Use action at the workshop to craft the item\n  actions.append(env.world.N_ACTIONS - 1)  # Assuming USE is the last action index\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-10T13:40:58.387185", "function_name": "craft", "function_body": "  def _get_neighbors(pos):\n    x, y = pos\n    neighbors = []\n    if x > 0:\n      neighbors.append((x - 1, y))\n    if x < env.world.WIDTH - 1:\n      neighbors.append((x + 1, y))\n    if y > 0:\n      neighbors.append((x, y - 1))\n    if y < env.world.HEIGHT - 1:\n      neighbors.append((x, y + 1))\n    return neighbors\n\n  def _move_to_position(target_pos):\n    # Implement A* pathfinding algorithm to move towards the target position\n    start = env._current_state.pos\n    open_set = collections.PriorityQueue()\n    open_set.put((0, start))\n    came_from = {}\n    g_score = {start: 0}\n    \n    while not open_set.empty():\n      _, current = open_set.get()\n      \n      if current == target_pos:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        path.reverse()\n        actions = _convert_path_to_actions(path, start)\n        return actions\n      \n      for neighbor in _get_neighbors(current):\n        tentative_g_score = g_score[current] + 1\n        if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n          came_from[neighbor] = current\n          g_score[neighbor] = tentative_g_score\n          f_score = tentative_g_score + abs(neighbor[0] - target_pos[0]) + abs(neighbor[1] - target_pos[1])\n          open_set.put((f_score, neighbor))\n    \n    return []\n\n  def _convert_path_to_actions(path, start):\n    actions = []\n    cx, cy = start\n    for x, y in path:\n      if cx < x:\n        actions.append(craft.RIGHT)\n      elif cx > x:\n        actions.append(craft.LEFT)\n      if cy < y:\n        actions.append(craft.DOWN)\n      elif cy > y:\n        actions.append(craft.UP)\n      cx, cy = x, y\n    return actions\n\n  def _has_required_primitives(primitive_indices):\n    for i in primitive_indices:\n      if env._current_state.inventory[i] <= 0:\n        return False\n    return True\n\n  index = env.world.cookbook.index\n  item_index = index[item]\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n\n  if \"_key\" in recipe:\n    key_index = recipe[\"_key\"]\n    workshop_index = env.world.workshop_indices[key_index]\n    \n    # Collect all required primitives\n    actions = []\n    for primitive_index in [i for i in recipe if i != \"_key\"]:\n      if not _has_required_primitives([primitive_index]):\n        target_pos = None\n        for dx in range(-env.world.WIDTH, env.world.WIDTH + 1):\n          for dy in range(-env.world.HEIGHT, env.world.HEIGHT + 1):\n            pos = (env._current_state.pos[0] + dx, env._current_state.pos[1] + dy)\n            if 0 <= pos[0] < env.world.WIDTH and 0 <= pos[1] < env.world.HEIGHT:\n              if np.any(env._current_state.grid[pos[0], pos[1]] == primitive_index):\n                target_pos = pos\n                break\n          if target_pos is not None:\n            break\n        \n        if target_pos is None:\n          return []  # Primitive not found, return failure\n\n        actions.extend(_move_to_position(target_pos) + [craft.USE])\n        \n        # Check again after collecting to ensure we have enough\n        if not _has_required_primitives([primitive_index]):\n          return []  # If still missing, return failure\n    \n    # Move to the workshop and use it\n    target_workshop = None\n    for dx in range(-env.world.WIDTH, env.world.WIDTH + 1):\n      for dy in range(-env.world.HEIGHT, env.world.HEIGHT + 1):\n        pos = (env._current_state.pos[0] + dx, env._current_state.pos[1] + dy)\n        if 0 <= pos[0] < env.world.WIDTH and 0 <= pos[1] < env.world.HEIGHT:\n          if np.any(env._current_state.grid[pos[0], pos[1]] == workshop_index):\n            target_workshop = pos\n            break\n      if target_workshop is not None:\n        break\n    \n    if target_workshop is None:\n      return []  # Workshop not found, return failure\n\n    actions.extend(_move_to_position(target_workshop) + [craft.USE])\n    return actions\n  \n  else:\n    return []", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T13:40:59.503687", "function_name": "craft", "function_body": "  def _move_to_position(target_pos):\n      cx, cy = env._current_state.pos\n      actions = []\n      \n      # Calculate the path using A* search\n      def heuristic(a, b):\n          return abs(a[0] - b[0]) + abs(a[1] - b[1])\n      \n      open_set = collections.PriorityQueue()\n      open_set.put((0, (cx, cy)))\n      came_from = {}\n      g_score = {(cx, cy): 0}\n      \n      while not open_set.empty():\n          _, current = open_set.get()\n          \n          if current == target_pos:\n              path = []\n              while current in came_from:\n                  path.append(current)\n                  current = came_from[current]\n              path.reverse()\n              actions = _convert_path_to_actions(path, (cx, cy))\n              return actions\n          \n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              if 0 <= neighbor[0] < env.world.WIDTH and 0 <= neighbor[1] < env.world.HEIGHT:\n                  tentative_g_score = g_score[current] + 1\n                  if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                      came_from[neighbor] = current\n                      g_score[neighbor] = tentative_g_score\n                      f_score = tentative_g_score + heuristic(neighbor, target_pos)\n                      open_set.put((f_score, neighbor))\n      \n      return []\n\n  def _convert_path_to_actions(path, start):\n      actions = []\n      cx, cy = start\n      \n      for x, y in path:\n          if cx < x:\n              actions.append(craft.RIGHT)\n          elif cx > x:\n              actions.append(craft.LEFT)\n          if cy < y:\n              actions.append(craft.DOWN)\n          elif cy > y:\n              actions.append(craft.UP)\n          cx, cy = x, y\n      \n      return actions\n\n  def _move_to_workshop(workshop_index):\n      start = env._current_state.pos\n      goal = None\n      \n      # Find the nearest workshop\n      for dx in range(-env.world.WIDTH, env.world.WIDTH + 1):\n          for dy in range(-env.world.HEIGHT, env.world.HEIGHT + 1):\n              target_pos = (start[0] + dx, start[1] + dy)\n              if 0 <= target_pos[0] < env.world.WIDTH and 0 <= target_pos[1] < env.world.HEIGHT:\n                  if np.any(env._current_state.grid[target_pos[0], target_pos[1]] == workshop_index):\n                      goal = target_pos\n                      break\n          if goal is not None:\n              break\n      \n      if goal is None:\n          return []\n      \n      # Move to the nearest workshop using A* search\n      actions_to_workshop = _move_to_position(goal)\n      return actions_to_workshop\n\n  def _has_required_primitives(primitive_indices):\n      for i in primitive_indices:\n          if env._current_state.inventory[i] <= 0:\n              return False\n      return True\n\n  def _collect_primitive(primitive_index):\n      start = env._current_state.pos\n      goal = None\n      \n      # Find the nearest primitive\n      for dx in range(-env.world.WIDTH, env.world.WIDTH + 1):\n          for dy in range(-env.world.HEIGHT, env.world.HEIGHT + 1):\n              target_pos = (start[0] + dx, start[1] + dy)\n              if 0 <= target_pos[0] < env.world.WIDTH and 0 <= target_pos[1] < env.world.HEIGHT:\n                  if np.any(env._current_state.grid[target_pos[0], target_pos[1]] == primitive_index):\n                      goal = target_pos\n                      break\n          if goal is not None:\n              break\n      \n      if goal is None:\n          return []\n      \n      # Move to the nearest primitive using A* search\n      actions_to_primitive = _move_to_position(goal)\n      actions_to_primitive.append(craft.USE)  # Add USE action to collect the primitive\n      return actions_to_primitive\n\n  index = env.world.cookbook.index\n  item_index = index[item]\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n\n  if \"_key\" in recipe:\n      key_index = recipe[\"_key\"]\n      workshop_index = env.world.workshop_indices[key_index]\n      \n      # Collect all required primitives\n      actions = []\n      for primitive_index in [i for i in recipe if i != \"_key\"]:\n          if not _has_required_primitives([primitive_index]):\n              actions.extend(_collect_primitive(primitive_index))\n          \n          # Check again after collecting to ensure we have enough\n          if not _has_required_primitives([primitive_index]):\n              return []  # If still missing, return failure\n\n      # Move to the workshop and use it\n      actions_to_workshop = _move_to_workshop(workshop_index)\n      \n      # Ensure the agent is facing the correct direction to use the workshop\n      target_pos = None\n      \n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          neighbor_pos = (env._current_state.pos[0] + dx, env._current_state.pos[1] + dy)\n          if 0 <= neighbor_pos[0] < env.world.WIDTH and 0 <= neighbor_pos[1] < env.world.HEIGHT:\n              if np.any(env._current_state.grid[neighbor_pos[0], neighbor_pos[1]] == workshop_index):\n                  target_pos = neighbor_pos\n                  break\n      \n      if target_pos is not None:\n          direction_to_target = (target_pos[0] - env._current_state.pos[0], target_pos[1] - env._current_state.pos[1])\n          \n          if direction_to_target == (-1, 0):\n              actions_to_workshop.append(craft.LEFT)\n          elif direction_to_target == (1, 0):\n              actions_to_workshop.append(craft.RIGHT)\n          elif direction_to_target == (0, -1):\n              actions_to_workshop.append(craft.UP)\n          elif direction_to_target == (0, 1):\n              actions_to_workshop.append(craft.DOWN)\n      \n      # Finally, add the USE action\n      actions.extend(actions_to_workshop + [craft.USE])\n      return actions\n  \n  else:\n      return []", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T13:42:21.090516", "function_name": "craft", "function_body": "  actions = []\n  \n  # Convert item name to index using the cookbook\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all required primitives for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  \n  # Function to get actions to collect a specific primitive\n  def collect_primitive(primitive):\n    primitive_index = env.world.cookbook.index[primitive]\n    # Find nearest cell with the primitive\n    x, y = find_nearest(env._current_state.grid, primitive_index)\n    if (x, y) == (-1, -1):\n      return []  # Primitive not found on the grid\n\n    # Calculate actions to move to the primitive\n    path_to_primitive = get_path(env._current_state.pos, (x, y), env._current_state.dir)\n    actions.extend(path_to_primitive)\n\n    # Add action to collect the primitive\n    actions.append(env.world.n_actions - 1)  # Assuming USE is the last action\n\n    return actions\n  \n  # Collect all required primitives\n  for primitive in required_primitives:\n    actions.extend(collect_primitive(primitive))\n  \n  if not actions:\n    return []  # No actions collected, required items not found on grid\n\n  # Find the workshop needed to craft the item\n  workshop_index = None\n  for recipe_key in env.world.cookbook.recipes[item_index]:\n    if \"_at\" in recipe_key:\n      workshop_name = env.world.cookbook.recipes[item_index][recipe_key]\n      workshop_index = env.world.cookbook.index[workshop_name]\n      break\n\n  # Find nearest cell with the workshop\n  x, y = find_nearest(env._current_state.grid, workshop_index)\n  if (x, y) == (-1, -1):\n    return []  # Workshop not found on the grid\n\n  # Calculate actions to move to the workshop\n  path_to_workshop = get_path(env._current_state.pos, (x, y), env._current_state.dir)\n  actions.extend(path_to_workshop)\n\n  # Add action to craft the item at the workshop\n  actions.append(env.world.n_actions - 1)  # Assuming USE is the last action\n\n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-10T13:42:22.083392", "function_name": "craft", "function_body": "  index = env.world.cookbook.index\n  actions = []\n  \n  # Convert the item name to its corresponding index.\n  if item not in index:\n    raise ValueError(f\"Unknown item: {item}\")\n    \n  goal_index = index[item]\n  \n  # Check if we have all the required primitives for crafting.\n  recipe = env.world.cookbook.recipes.get(goal_index, {})\n  \n  if \"_key\" in recipe:\n    workshop_key = recipe[\"_key\"]\n    del recipe[\"_key\"]\n\n  workshop_indices = [env.world.workshop_indices[i] for i in range(len(env.world.workshop_indices))]\n  \n  # Check all primitives are available\n  required_primitives = {index[kind]: count for kind, count in recipe.items()}\n  inventory = env._current_state.inventory\n  \n  if any(inventory[primitive] < count for primitive, count in required_primitives.items()):\n    return actions  # Return empty list since we don't have enough primitives.\n  \n  # Proceed to craft the item\n  for workshop_index in workshop_indices:\n      if index.get(workshop_key) == workshop_index:\n          target_workshop_pos = None\n          \n          # Find the position of the required workshop\n          grid = env._current_state.grid\n          for y, row in enumerate(grid):\n              for x, cell in enumerate(row):\n                  if np.any(cell[workshop_index]):\n                      target_workshop_pos = (x, y)\n                      break\n              if target_workshop_pos:\n                  break\n          \n          if not target_workshop_pos:\n              return actions  # Return empty list since we couldn't find the workshop.\n          \n          current_pos = env._current_state.pos\n          direction = env._current_state.dir\n\n          # Calculate path to the workshop\n          path_actions = calculate_path(current_pos, target_workshop_pos)\n          actions.extend(path_actions)\n\n          # Turn towards the workshop if necessary\n          turn_action = calculate_turn(direction, target_workshop_pos)\n          if turn_action:\n              actions.append(turn_action)\n\n          # Use action to craft the item at the workshop.\n          actions.append(4)  # Assuming USE is action index 4\n\n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-10T13:44:34.825125", "function_name": "craft", "function_body": "  def calculate_turns(current_dir_index: int, target_dir_index: int) -> tuple[list[int], int]:\n      turns_right = (target_dir_index - current_dir_index) % 4\n      turns_left = (current_dir_index - target_dir_index) % 4\n\n      if turns_right < turns_left:\n          return [craft.TURN_RIGHT for _ in range(turns_right)], turns_right\n      else:\n          return [craft.TURN_LEFT for _ in range(turns_left)], turns_left\n\n  def calculate_direction(dx: int, dy: int) -> int:\n      if dx > 0:\n          return craft.RIGHT\n      elif dx < 0:\n          return craft.LEFT\n      elif dy > 0:\n          return craft.DOWN\n      else: # dy < 0\n          return craft.UP\n\n  def find_nearest_workshop(grid, workshop_index, current_position):\n      workshop_positions = np.argwhere(grid[:, :, workshop_index] > 0)\n      if len(workshop_positions) == 0:\n          raise ValueError(\"No available workshop to craft item\")\n      \n      distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n      nearest_workshop_index = np.argmin(distances_to_workshops)\n      return tuple(workshop_positions[nearest_workshop_index])\n\n  def get_inventory(env):\n      cookbook = env.world.cookbook\n      inventory_contents = {cookbook.index.reverse_contents[i]: count for i, count in enumerate(env._current_state.inventory) if count > 0}\n      return inventory_contents\n\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = get_inventory(env)\n\n  # Check if all ingredients are available\n  required_ingredients = {cookbook.index[k]: v for k, v in recipe.items()}\n\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n    ingredient_name = cookbook.index.reverse_contents[ingredient_index]\n    if ingredient_name not in available_inventory or available_inventory[ingredient_name] < required_count:\n      can_craft = False\n      break\n\n  if not can_craft:\n    return []\n\n  # Find the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  nearest_workshop_pos = find_nearest_workshop(env._current_state.grid, workshop_index, current_position)\n\n  # Calculate actions to move the agent to the nearest workshop\n  dx = nearest_workshop_pos[0] - current_position[0]\n  dy = nearest_workshop_pos[1] - current_position[1]\n\n  actions_to_take = []\n\n  if dx > 0:\n    actions_to_take.extend([craft.MOVE_RIGHT for _ in range(dx)])\n  elif dx < 0:\n    actions_to_take.extend([craft.MOVE_LEFT for _ in range(-dx)])\n\n  if dy > 0:\n    actions_to_take.extend([craft.MOVE_DOWN for _ in range(dy)])\n  elif dy < 0:\n    actions_to_take.extend([craft.MOVE_UP for _ in range(-dy)])\n\n  # Calculate the target direction to face the workshop\n  current_direction = env._current_state.dir\n\n  if dx == 0 and dy == 0:  # Already at the workshop\n      pass\n  else:\n      target_direction = calculate_direction(dx, dy)\n      current_dir_index = {craft.RIGHT: 0, craft.DOWN: 1, craft.LEFT: 2, craft.UP: 3}[current_direction]\n      target_dir_index = {craft.RIGHT: 0, craft.DOWN: 1, craft.LEFT: 2, craft.UP: 3}[target_direction]\n\n      turns, _ = calculate_turns(current_dir_index, target_dir_index)\n      actions_to_take.extend(turns)\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-10T13:44:35.811229", "function_name": "craft", "function_body": "  def calculate_turns(current_dir_index: int, target_dir_index: int) -> tuple[list[int], int]:\n      turns_right = (target_dir_index - current_dir_index) % 4\n      turns_left = (current_dir_index - target_dir_index) % 4\n\n      if turns_right < turns_left:\n          return [craft.TURN_RIGHT for _ in range(turns_right)], turns_right\n      else:\n          return [craft.TURN_LEFT for _ in range(turns_left)], turns_left\n\n  def calculate_direction(dx: int, dy: int) -> int:\n      if dx > 0:\n          return craft.RIGHT\n      elif dx < 0:\n          return craft.LEFT\n      elif dy > 0:\n          return craft.DOWN\n      else: # dy < 0\n          return craft.UP\n\n  def find_nearest_workshop(grid, workshop_index, current_position):\n      workshop_positions = np.argwhere(grid[:, :, workshop_index] > 0)\n      if len(workshop_positions) == 0:\n          raise ValueError(\"No available workshop to craft item\")\n      \n      distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n      nearest_workshop_index = np.argmin(distances_to_workshops)\n      return tuple(workshop_positions[nearest_workshop_index])\n\n  def get_required_ingredients(recipe: dict) -> dict:\n      required_ingredients = {}\n      for ingredient_name, count in recipe.items():\n          if ingredient_name != \"_at\":\n              ingredient_index = env.world.cookbook.index.get(ingredient_name, None)\n              if ingredient_index is not None:\n                  required_ingredients[ingredient_index] = count\n              else:\n                  raise ValueError(f\"Unknown ingredient: {ingredient_name}\")\n      return required_ingredients\n\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index.get(workshop_name, None)\n\n  if workshop_index is None:\n      raise ValueError(f\"Unknown workshop: {workshop_name}\")\n\n  available_inventory = env._current_state.inventory.copy()\n\n  # Check if all ingredients are available\n  required_ingredients = get_required_ingredient(recipe)\n\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if not can_craft:\n    return []\n\n  # Find the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  nearest_workshop_pos = find_nearest_workshop(env._current_state.grid, workshop_index, current_position)\n\n  # Calculate actions to move the agent to the nearest workshop\n  dx = nearest_workshop_pos[0] - current_position[0]\n  dy = nearest_workshop_pos[1] - current_position[1]\n\n  actions_to_take = []\n\n  if dx > 0:\n    actions_to_take.extend([craft.MOVE_RIGHT for _ in range(dx)])\n  elif dx < 0:\n    actions_to_take.extend([craft.MOVE_LEFT for _ in range(-dx)])\n\n  if dy > 0:\n    actions_to_take.extend([craft.MOVE_DOWN for _ in range(dy)])\n  elif dy < 0:\n    actions_to_take.extend([craft.MOVE_UP for _ in range(-dy)])\n\n  # Calculate the target direction to face the workshop\n  current_direction = env._current_state.dir\n\n  if dx == 0 and dy == 0:  # Already at the workshop\n      pass\n  else:\n      target_direction = calculate_direction(dx, dy)\n      current_dir_index = {craft.RIGHT: 0, craft.DOWN: 1, craft.LEFT: 2, craft.UP: 3}[current_direction]\n      target_dir_index = {craft.RIGHT: 0, craft.DOWN: 1, craft.LEFT: 2, craft.UP: 3}[target_direction]\n\n      turns, _ = calculate_turns(current_dir_index, target_dir_index)\n      actions_to_take.extend(turns)\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-10T13:46:16.670568", "function_name": "craft", "function_body": "  def get_actions_for_movement(start, target, current_direction):\n    dx = target[0] - start[0]\n    dy = target[1] - start[1]\n\n    actions_to_take = []\n\n    while dx != 0 or dy != 0:\n      if abs(dx) > abs(dy):  # Prioritize horizontal movement\n        direction = craft.RIGHT if dx > 0 else craft.LEFT\n      else:  # Prioritize vertical movement\n        direction = craft.DOWN if dy > 0 else craft.UP\n\n      # Turn to face the correct direction\n      while current_direction != direction:\n        actions_to_take.append(craft.TURN_RIGHT)\n        current_direction = (current_direction + 1) % 4\n\n      # Move in the correct direction\n      if direction == craft.RIGHT:\n        actions_to_take.append(craft.MOVE_RIGHT)\n        dx -= 1\n      elif direction == craft.LEFT:\n        actions_to_take.append(craft.MOVE_LEFT)\n        dx += 1\n      elif direction == craft.DOWN:\n        actions_to_take.append(craft.MOVE_DOWN)\n        dy -= 1\n      elif direction == craft.UP:\n        actions_to_take.append(craft.MOVE_UP)\n        dy += 1\n\n    return actions_to_take, current_direction\n\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = env._current_state.inventory.copy()\n\n  # Check if all ingredients are available\n  required_ingredients = {cookbook.index[k]: v for k, v in recipe.items()}\n\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if not can_craft:\n    return []\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No available workshop to craft item\")\n\n  # Select the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n  # Calculate actions to move the agent to the nearest workshop\n  actions_to_take, _ = get_actions_for_movement(\n      current_position, nearest_workshop_pos, env._current_state.dir\n  )\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T13:46:17.709786", "function_name": "craft", "function_body": "  def get_actions_for_movement(start, target, current_direction):\n    dx = target[0] - start[0]\n    dy = target[1] - start[1]\n\n    actions_to_take = []\n\n    while dx != 0 or dy != 0:\n      if abs(dx) > abs(dy):  # Prioritize horizontal movement\n        direction = craft.RIGHT if dx > 0 else craft.LEFT\n      else:  # Prioritize vertical movement\n        direction = craft.DOWN if dy > 0 else craft.UP\n\n      while current_direction != direction:\n        actions_to_take.append(craft.TURN_RIGHT)\n        current_direction = (current_direction + 1) % 4\n\n      if direction == craft.RIGHT:\n        actions_to_take.append(craft.MOVE_RIGHT)\n        dx -= 1\n      elif direction == craft.LEFT:\n        actions_to_take.append(craft.MOVE_LEFT)\n        dx += 1\n      elif direction == craft.DOWN:\n        actions_to_take.append(craft.MOVE_DOWN)\n        dy -= 1\n      elif direction == craft.UP:\n        actions_to_take.append(craft.MOVE_UP)\n        dy += 1\n\n    return actions_to_take, current_direction\n\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = env._current_state.inventory.copy()\n\n  # Check if all ingredients are available\n  required_ingredients = {cookbook.index[k]: v for k, v in recipe.items()}\n\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if not can_craft:\n    return []\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No available workshop to craft item\")\n\n  # Select the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n  # Calculate actions to move the agent to the nearest workshop\n  actions_to_take, _ = get_actions_for_movement(\n      current_position, nearest_workshop_pos, env._current_state.dir\n  )\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T13:47:06.088937", "function_name": "craft", "function_body": "  # Convert item name to index using the cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Get all primitives required for crafting this item\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  \n  actions = []\n  \n  # Check if we have all necessary primitives in our inventory\n  has_primitives = True\n  for primitive, count in primitives_needed.items():\n    if env._current_state.inventory[primitive] < count:\n      has_primitives = False\n      break\n  \n  if not has_primitives:\n    return []  # We don't have enough primitives to craft the item\n  \n  # Now we need to go to the workshop and use it to craft the item\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_name = recipe[\"_at\"]\n  \n  # Find all locations of the required workshop in the grid\n  workshop_indices = np.argwhere(env._current_state.grid[:, :, env.world.workshop_indices[workshop_name]])\n  if len(workshop_indices) == 0:\n    return []  # No workshops found for this item\n  \n  # Choose the nearest workshop to go to\n  agent_pos = np.array(env._current_state.pos)\n  distances = np.linalg.norm(workshop_indices - agent_pos, axis=1)\n  closest_workshop = tuple(workshop_indices[np.argmin(distances)])\n  \n  # Calculate actions to move to the closest workshop\n  path_to_workshop = find_path(env, agent_pos, closest_workshop)\n  actions.extend(path_to_workshop)\n  \n  # Add USE action to craft the item at the workshop\n  actions.append(4)  # Assuming 4 is the index for the USE action\n  \n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-10T13:47:07.078956", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the item has a recipe or is a primitive\n  if item_index not in env.world.cookbook.recipes:\n    print(f\"No recipe found for {item}. Assuming it's a primitive.\")\n    return actions\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes[item_index]\n  \n  # Collect all required ingredients\n  for ingredient, count in recipe.items():\n    if ingredient == \"_key\": \n      continue  # Skip the _key which specifies the workshop\n    \n    ingredient_index = env.world.cookbook.index.get(ingredient)\n    \n    if not ingredient_index:\n      print(f\"Ingredient {ingredient} not found in cookbook.\")\n      return actions\n    \n    required_count = count\n    current_count = env._current_state.inventory[ingredient_index]\n    \n    # If we already have enough of the ingredient, skip to the next one\n    if current_count >= required_count:\n      continue\n    \n    # Determine how many more of this ingredient are needed\n    missing_count = required_count - current_count\n    \n    # Collect the missing ingredients\n    actions.extend(collect(env, env.world.cookbook.index.get(ingredient), missing_count))\n  \n  # Go to the workshop and craft the item\n  workshop_index = recipe[\"_key\"]\n  workshop_name = env.world.cookbook.index.get(workshop_index)\n  \n  if not workshop_name:\n    print(f\"Workshop index {workshop_index} not found in cookbook.\")\n    return actions\n  \n  workshop_pos = find_workshop(env, workshop_name)\n  \n  if workshop_pos is None:\n    print(f\"Workshop {workshop_name} not found on the grid.\")\n    return actions\n\n  # Navigate to the workshop\n  actions.extend(navigate_to(env, workshop_pos))\n  \n  # Face the workshop and use the USE action to craft the item\n  actions.append(craft_action(workshop_name))\n\n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-10T13:49:29.369743", "function_name": "craft", "function_body": "  def astar(start, goal, grid_shape):\n      open_set = collections.PriorityQueue()\n      came_from = {}\n      g_score = {start: 0}\n      f_score = {start: heuristic(start, goal)}\n\n      open_set.put((f_score[start], start))\n\n      while not open_set.empty():\n          _, current = open_set.get()\n\n          if current == goal:\n              return reconstruct_path(came_from, current)\n\n          for neighbor in neighbors(current, grid_shape):\n              tentative_g_score = g_score[current] + 1\n\n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                  open_set.put((f_score[neighbor], neighbor))\n\n      return []\n\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def neighbors(pos, grid_shape):\n      x, y = pos\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < grid_shape[0] and 0 <= ny < grid_shape[1]:\n              yield (nx, ny)\n\n  def reconstruct_path(came_from, current):\n      total_path = [current]\n      while current in came_from:\n          current = came_from[current]\n          total_path.append(current)\n      return total_path[::-1]\n\n  def is_facing_correct_direction(current_dir, target_dir):\n      direction_map = {\n          (0, -1): \"UP\",\n          (0, 1): \"DOWN\",\n          (-1, 0): \"LEFT\",\n          (1, 0): \"RIGHT\"\n      }\n      return direction_map[current_dir] == env.world.cookbook.index[direction_map[tuple(target_dir)]]\n\n  def rotate_towards_target_direction(current_dir, target_dir):\n      direction_map = {\n          \"UP\": 0,\n          \"DOWN\": 1,\n          \"LEFT\": 2,\n          \"RIGHT\": 3\n      }\n      current_index = direction_map[env.world.cookbook.index[tuple(current_dir)]]\n      target_index = direction_map[direction_map[tuple(target_dir)]]\n\n      if (current_index + 1) % 4 == target_index:\n          return env.world.cookbook.index[\"RIGHT\"]\n      elif (current_index - 1) % 4 == target_index:\n          return env.world.cookbook.index[\"LEFT\"]\n      else:\n          return env.world.cookbook.index[\"LEFT\"] if current_index < target_index else env.world.cookbook.index[\"RIGHT\"]\n\n  def get_rotated_direction(current_dir, rotation_action):\n      direction_map = {\n          \"UP\": (0, -1),\n          \"DOWN\": (0, 1),\n          \"LEFT\": (-1, 0),\n          \"RIGHT\": (1, 0)\n      }\n      current_index = [\"UP\", \"DOWN\", \"LEFT\", \"RIGHT\"].index(env.world.cookbook.index[tuple(current_dir)])\n      rotation_index = [\"RIGHT\", \"LEFT\"].index(rotation_action)\n\n      if rotation_index == 0:\n          return direction_map[[\"RIGHT\", \"DOWN\", \"LEFT\", \"UP\"][current_index]]\n      else:\n          return direction_map[[\"LEFT\", \"UP\", \"RIGHT\", \"DOWN\"][current_index]]\n\n  def get_current_direction_from_state(state):\n      current_pos = state.pos\n      for x in range(state.grid.shape[0]):\n          for y in range(state.grid.shape[1]):\n              if (x, y) != current_pos and state.grid[x, y, env.world.cookbook.index[\"UP\"]] > 0:\n                  return np.array((current_pos[0] - x, current_pos[1] - y))\n      return np.array((0, 0))\n\n  goal_index = env.world.cookbook.index[item]\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n\n  actions = []\n\n  if not required_primitives:\n    return [] # No recipe or no primitives needed, can't craft\n\n  # Check if all required primitives are already in inventory\n  for primitive, count in required_primitives.items():\n    if env._current_state.inventory[primitive] < count:\n      return [] # Not enough primitives to start crafting\n\n  # Find the workshop where we need to go to craft this item\n  workshop_index = None\n  for recipe_key, recipe in env.world.cookbook.recipes.items():\n    if \"_at\" in recipe and recipe[\"_at\"] == goal_index:\n      workshop_index = env.world.cookbook.index[recipe_key]\n      break\n\n  # Check if the required workshop exists\n  if workshop_index is None:\n    return [] # No suitable workshop found\n  \n  # Navigate to the closest workshop\n  target_pos = None\n  for x in range(env._current_state.grid.shape[0]):\n    for y in range(env._current_state.grid.shape[1]):\n      if env._current_state.grid[x, y, workshop_index] > 0:\n        target_pos = (x, y)\n        break\n    if target_pos is not None:\n      break\n  \n  # If no workshop is found, return an empty list\n  if target_pos is None:\n    return []\n\n  # Simple pathfinding to the workshop using A* algorithm\n  start_pos = env._current_state.pos\n  path = astar(start_pos, target_pos, env._current_state.grid.shape)\n\n  # Convert path into actions\n  if path:\n      for i in range(len(path) - 1):\n          dx = path[i + 1][0] - path[i][0]\n          dy = path[i + 1][1] - path[i][1]\n\n          if dx == 0 and dy == -1:\n              actions.append(env.world.cookbook.index[\"UP\"])\n          elif dx == 0 and dy == 1:\n              actions.append(env.world.cookbook.index[\"DOWN\"])\n          elif dx == -1 and dy == 0:\n              actions.append(env.world.cookbook.index[\"LEFT\"])\n          elif dx == 1 and dy == 0:\n              actions.append(env.world.cookbook.index[\"RIGHT\"])\n\n      # Orient the agent towards the workshop before using it\n      target_direction = np.array(target_pos) - np.array(path[-2])\n      current_direction = get_current_direction_from_state(env._current_state)\n\n      while not is_facing_correct_direction(current_direction, target_direction):\n          actions.append(rotate_towards_target_direction(current_direction, target_direction))\n          current_direction = get_rotated_direction(current_direction, rotate_towards_target_direction(current_direction, target_direction))\n\n  # Use action to craft the item at the workshop\n  actions.append(env.world.cookbook.index[\"USE\"])\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T13:49:30.344040", "function_name": "craft", "function_body": "", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-10T13:50:29.732903", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index for the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the recipe exists and get required primitives and counts\n  if item_index in env.world.cookbook.recipes:\n    recipe = env.world.cookbook.recipes[item_index]\n    \n    # Collect all necessary items/primitives for crafting\n    for ingredient, count in recipe.items():\n      if ingredient == \"_key\":\n        continue  # Ignore the workshop key\n      primitive_name = env.world.cookbook.index.get(ingredient)\n      \n      # Collect the required amount of each primitive\n      while np.sum(env._current_state.inventory[ingredient]) < count:\n        actions.extend(collect(env, primitive_name))\n    \n    # Determine which workshop to use based on the recipe\n    workshop_index = None\n    if \"_key\" in recipe:\n      workshop_key = recipe[\"_key\"]\n      workshop_prefix = f\"{workshop_key}_\"\n      for idx, name in enumerate(env.world.cookbook.index):\n        if name.startswith(workshop_prefix):\n          workshop_index = idx\n          break\n    \n    # Move to the workshop and use it to craft the item\n    if workshop_index is not None:\n      actions.extend(move_to_workshop(env, workshop_index))\n      actions.append(4)  # USE action\n    \n    else:\n      raise ValueError(f\"No workshop specified for crafting {item}\")\n  \n  else:\n    raise ValueError(f\"Recipe for {item} not found\")\n  \n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-10T13:50:30.691739", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the required primitives for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  current_inventory = env._current_state.inventory\n\n  actions_to_take = []\n\n  # Check if we have enough of each primitive\n  for prim, count in required_primitives.items():\n      if current_inventory[prim] < count:\n          return []  # Return empty list if any primitive is missing\n\n  # Determine the workshop to go to based on the recipe\n  workshop_name = env.world.cookbook.recipes[item_index].get(\"_at\", None)\n  \n  if not workshop_name:\n      return []  # Return empty list if no workshop specified in the recipe\n  \n  # Get the index of the required workshop\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find positions of all workshops of the required type on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n      return []  # Return empty list if no such workshop exists\n\n  # Choose one workshop to go to (we can choose the closest one, for simplicity we pick the first one)\n  target_workshop_pos = tuple(workshop_positions[0])\n  \n  # Get current position and direction of the agent\n  current_pos = env._current_state.pos\n  current_dir = env._current_state.dir\n\n  # Calculate the movement actions required to reach the workshop\n  move_actions = calculate_movement_actions(current_pos, target_workshop_pos, current_dir)\n\n  if not move_actions:\n      return []  # Return empty list if no path is found\n\n  actions_to_take.extend(move_actions)\n\n  # Once at the workshop, face it and use the USE action to craft the item\n  final_direction = calculate_final_direction(current_pos, target_workshop_pos, current_dir)\n  \n  if final_direction != current_dir:\n      actions_to_take.append(final_direction)  # Change direction if needed\n\n  actions_to_take.append(env.world.N_ACTIONS - 1)  # Use action (assuming USE is the last defined action)\n\n  return actions_to_take", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-10T13:51:12.055442", "function_name": "craft", "function_body": "  actions = []\n\n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we already have the required item in inventory or if it's a primitive\n  if env._current_state.inventory[item_index] > 0:\n    return actions\n\n  # Get all primitives needed to craft this item\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n\n  # Collect all the required primitives\n  for primitive, count in primitives_needed.items():\n      actions.extend(collect_v2(env, primitive))\n\n  # Now that we have collected all the necessary primitives, go to the appropriate workshop and craft the item\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_name = list(recipe[\"_key\"].split(\"_at=\"))[1] if \"_key\" in recipe else None\n\n  if workshop_name:\n    workshop_indices = [idx for idx, name in enumerate(env.world.workshop_indices) \n                        if f\"{workshop_name}\" in env.world.cookbook.index.get(name)]\n    closest_workshop = find_closest_workshop(env._current_state.pos, workshop_indices)\n    actions.extend(move_to_workshop(env._current_state, closest_workshop))\n    \n    # Facing the correct direction before using\n    for _ in range(3):  # assuming the agent can rotate up to 3 times to face the correct direction\n      actions.append(craft.LEFT)  # or RIGHT\n    \n    actions.append(craft.USE)\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-10T13:51:13.038094", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we already have the required item in inventory or if it's a primitive\n  if env._current_state.inventory[item_index] > 0:\n    return []\n  \n  # Get all primitives needed to craft this item\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  \n  # Collect all the required primitives\n  for primitive, count in primitives_needed.items():\n    actions.extend(collect_v2(env, primitive))\n  \n  # Now that we have collected all the necessary primitives, go to the appropriate workshop and craft the item\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_name = list(recipe[\"_key\"].split(\"_at=\"))[1] if \"_key\" in recipe else None\n  \n  if workshop_name:\n    workshop_indices = [idx for idx, name in enumerate(env.world.workshop_indices) \n                        if f\"{workshop_name}\" in env.world.cookbook.index.get(name)]\n    closest_workshop = find_closest_workshop(env._current_state.pos, workshop_indices)\n    \n    # Move to the closest workshop\n    actions.extend(move_to_workshop(env._current_state, closest_workshop))\n  \n    # Rotate to face the workshop\n    if not env._current_state.next_to(closest_workshop):\n      actions.append(craft.ROTATE_RIGHT)  # or ROTATE_LEFT\n    \n    # Use action to craft the item\n    actions.append(craft.USE)\n  \n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-10T13:53:44.627551", "function_name": "craft", "function_body": "  def _move_to_position(target_pos):\n    # Use A* search to move to the target position\n    start = env._current_state.pos\n\n    def heuristic(a, b):\n        return abs(a[0] - b[0]) + abs(a[1] - b[1])\n    \n    open_set = collections.PriorityQueue()\n    open_set.put((0, start))\n    came_from = {}\n    g_score = {start: 0}\n    \n    while not open_set.empty():\n        _, current = open_set.get()\n        \n        if current == target_pos:\n            path = []\n            while current in came_from:\n                path.append(current)\n                current = came_from[current]\n            path.reverse()\n            actions = _convert_path_to_actions(path, start)\n            return actions\n        \n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            neighbor = (current[0] + dx, current[1] + dy)\n            if 0 <= neighbor[0] < env.world.WIDTH and 0 <= neighbor[1] < env.world.HEIGHT:\n                tentative_g_score = g_score[current] + 1\n                if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                    came_from[neighbor] = current\n                    g_score[neighbor] = tentative_g_score\n                    f_score = tentative_g_score + heuristic(neighbor, target_pos)\n                    open_set.put((f_score, neighbor))\n    \n    return []\n\n  def _convert_path_to_actions(path, start):\n      actions = []\n      cx, cy = start\n      \n      for x, y in path:\n          if cx < x:\n              actions.append(craft.RIGHT)\n          elif cx > x:\n              actions.append(craft.LEFT)\n          if cy < y:\n              actions.append(craft.DOWN)\n          elif cy > y:\n              actions.append(craft.UP)\n          cx, cy = x, y\n      \n      return actions\n\n  def _has_required_primitives(primitive_indices):\n      for i in primitive_indices:\n          if env._current_state.inventory[i] <= 0:\n              return False\n      return True\n\n  def _collect_primitive(primitive_index):\n    # Find the nearest primitive and move there using A* search\n    start = env._current_state.pos\n    goal = None\n    \n    for dx in range(-env.world.WIDTH, env.world.WIDTH + 1):\n        for dy in range(-env.world.HEIGHT, env.world.HEIGHT + 1):\n            target_pos = (start[0] + dx, start[1] + dy)\n            if 0 <= target_pos[0] < env.world.WIDTH and 0 <= target_pos[1] < env.world.HEIGHT:\n                if np.any(env._current_state.grid[target_pos[0], target_pos[1]] == primitive_index):\n                    goal = target_pos\n                    break\n        if goal is not None:\n            break\n    \n    if goal is None:\n        return []\n    \n    actions_to_primitive = _move_to_position(goal)\n    # Finally, add the USE action to collect the primitive\n    actions_to_primitive.append(craft.USE)\n    return actions_to_primitive\n\n  index = env.world.cookbook.index\n  item_index = index[item]\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n\n  if \"_key\" in recipe:\n      key_index = recipe[\"_key\"]\n      workshop_index = env.world.workshop_indices[key_index]\n      \n      # Collect all required primitives\n      actions = []\n      for primitive_index in [i for i in recipe if i != \"_key\"]:\n          if not _has_required_primitives([primitive_index]):\n              actions.extend(_collect_primitive(primitive_index))\n          \n          # Check again after collecting to ensure we have enough\n          if not _has_required_primitives([primitive_index]):\n              return []  # If still missing, return failure\n\n      # Move to the workshop and use it\n      target_pos = None\n      \n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          neighbor_pos = (env._current_state.pos[0] + dx, env._current_state.pos[1] + dy)\n          if 0 <= neighbor_pos[0] < env.world.WIDTH and 0 <= neighbor_pos[1] < env.world.HEIGHT:\n              if np.any(env._current_state.grid[neighbor_pos[0], neighbor_pos[1]] == workshop_index):\n                  target_pos = neighbor_pos\n                  break\n      \n      if target_pos is not None:\n          actions_to_workshop = _move_to_position(target_pos)\n          \n          # Ensure the agent is facing the correct direction to use the workshop\n          direction_to_target = (target_pos[0] - env._current_state.pos[0], target_pos[1] - env._current_state.pos[1])\n          \n          if direction_to_target == (-1, 0):\n              actions_to_workshop.append(craft.LEFT)\n          elif direction_to_target == (1, 0):\n              actions_to_workshop.append(craft.RIGHT)\n          elif direction_to_target == (0, -1):\n              actions_to_workshop.append(craft.UP)\n          elif direction_to_target == (0, 1):\n              actions_to_workshop.append(craft.DOWN)\n      \n          # Finally, add the USE action\n          actions.extend(actions_to_workshop + [craft.USE])\n      else:\n          return []  # If no workshop found, return failure\n      \n      return actions\n  \n  else:\n      return []", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T13:53:45.714776", "function_name": "craft", "function_body": "  def _move_to_target(target_index):\n    # Find the nearest target and move there using A* search\n    start = env._current_state.pos\n    goal = None\n    \n    for dx in range(-env.world.WIDTH, env.world.WIDTH + 1):\n        for dy in range(-env.world.HEIGHT, env.world.HEIGHT + 1):\n            target_pos = (start[0] + dx, start[1] + dy)\n            if 0 <= target_pos[0] < env.world.WIDTH and 0 <= target_pos[1] < env.world.HEIGHT:\n                if np.any(env._current_state.grid[target_pos[0], target_pos[1]] == target_index):\n                    goal = target_pos\n                    break\n        if goal is not None:\n            break\n    \n    if goal is None:\n        return []\n    \n    def heuristic(a, b):\n        return abs(a[0] - b[0]) + abs(a[1] - b[1])\n    \n    open_set = collections.PriorityQueue()\n    open_set.put((0, start))\n    came_from = {}\n    g_score = {start: 0}\n    \n    while not open_set.empty():\n        _, current = open_set.get()\n        \n        if current == goal:\n            path = []\n            while current in came_from:\n                path.append(current)\n                current = came_from[current]\n            path.reverse()\n            actions = _convert_path_to_actions(path, start)\n            return actions\n        \n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            neighbor = (current[0] + dx, current[1] + dy)\n            if 0 <= neighbor[0] < env.world.WIDTH and 0 <= neighbor[1] < env.world.HEIGHT:\n                tentative_g_score = g_score[current] + 1\n                if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                    came_from[neighbor] = current\n                    g_score[neighbor] = tentative_g_score\n                    f_score = tentative_g_score + heuristic(neighbor, goal)\n                    open_set.put((f_score, neighbor))\n    \n    return []\n\n  def _convert_path_to_actions(path, start):\n      actions = []\n      cx, cy = start\n      \n      for x, y in path:\n          if cx < x:\n              actions.append(craft.RIGHT)\n          elif cx > x:\n              actions.append(craft.LEFT)\n          if cy < y:\n              actions.append(craft.DOWN)\n          elif cy > y:\n              actions.append(craft.UP)\n          cx, cy = x, y\n      \n      return actions\n\n  def _has_required_primitives(primitive_indices):\n      for i in primitive_indices:\n          if env._current_state.inventory[i] <= 0:\n              return False\n      return True\n  \n  index = env.world.cookbook.index\n  item_index = index[item]\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n\n  if \"_key\" in recipe:\n      key_index = recipe[\"_key\"]\n      workshop_index = env.world.workshop_indices[key_index]\n\n      # Collect all required primitives\n      actions = []\n      for primitive_index in [i for i in recipe if i != \"_key\"]:\n          if not _has_required_primitives([primitive_index]):\n              actions.extend(_move_to_target(primitive_index) + [craft.USE])\n          \n          # Check again after collecting to ensure we have enough\n          if not _has_required_primitives([primitive_index]):\n              return []  # If still missing, return failure\n\n      # Move to the workshop and use it\n      actions_to_workshop = _move_to_target(workshop_index)\n      \n      # Ensure the agent is facing the correct direction to use the workshop\n      target_pos = None\n      \n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          neighbor_pos = (env._current_state.pos[0] + dx, env._current_state.pos[1] + dy)\n          if 0 <= neighbor_pos[0] < env.world.WIDTH and 0 <= neighbor_pos[1] < env.world.HEIGHT:\n              if np.any(env._current_state.grid[neighbor_pos[0], neighbor_pos[1]] == workshop_index):\n                  target_pos = neighbor_pos\n                  break\n      \n      if target_pos is not None:\n          direction_to_target = (target_pos[0] - env._current_state.pos[0], target_pos[1] - env._current_state.pos[1])\n          \n          if direction_to_target == (-1, 0):\n              actions_to_workshop.append(craft.LEFT)\n          elif direction_to_target == (1, 0):\n              actions_to_workshop.append(craft.RIGHT)\n          elif direction_to_target == (0, -1):\n              actions_to_workshop.append(craft.UP)\n          elif direction_to_target == (0, 1):\n              actions_to_workshop.append(craft.DOWN)\n      \n      # Finally, add the USE action\n      actions.extend(actions_to_workshop + [craft.USE])\n      return actions\n  \n  else:\n      return []", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T13:55:54.949833", "function_name": "craft", "function_body": "  def get_direction_from_deltas(dx: int, dy: int) -> int:\n      if dx > 0:\n          return craft.RIGHT\n      elif dx < 0:\n          return craft.LEFT\n      elif dy > 0:\n          return craft.DOWN\n      else:  # dy < 0\n          return craft.UP\n\n  def calculate_turns(current_direction: int, target_direction: int) -> list[int]:\n      direction_diff = (target_direction - current_direction) % 4\n      if direction_diff == 1:\n          return [craft.TURN_RIGHT]\n      elif direction_diff == 2:\n          return [craft.TURN_RIGHT, craft.TURN_RIGHT]\n      elif direction_diff == 3:\n          return [craft.TURN_LEFT]\n      else:  # No turn needed\n          return []\n\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n\n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = env._current_state.inventory.copy()\n\n  # Check if all ingredients are available\n  required_ingredients = {cookbook.index[k]: v for k, v in recipe.items()}\n\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if not can_craft:\n    return []\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No available workshop to craft item\")\n\n  # Select the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n  # Calculate actions to move the agent to the nearest workshop\n  dx = nearest_workshop_pos[0] - current_position[0]\n  dy = nearest_workshop_pos[1] - current_position[1]\n\n  actions_to_take = []\n\n  if dx != 0:\n    direction_x = get_direction_from_deltas(dx, 0)\n    actions_to_take.extend([direction_x for _ in range(abs(dx))])\n\n  if dy != 0:\n    direction_y = get_direction_from_deltas(0, dy)\n    actions_to_take.extend([direction_y for _ in range(abs(dy))])\n\n  # Calculate the target direction to face the workshop\n  current_direction = env._current_state.dir\n  target_direction = get_direction_from_deltas(dx, dy)\n\n  if current_direction != target_direction:\n      turns_needed = calculate_turns(current_direction, target_direction)\n      actions_to_take.extend(turns_needed)\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T13:55:56.035425", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n\n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = env._current_state.inventory.copy()\n\n  # Check if all ingredients are available\n  required_ingredients = {cookbook.index[k]: v for k, v in recipe.items()}\n\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if not can_craft:\n    return []\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No available workshop to craft item\")\n\n  # Select the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n  # Calculate actions to move the agent to the nearest workshop\n  dx = nearest_workshop_pos[0] - current_position[0]\n  dy = nearest_workshop_pos[1] - current_position[1]\n\n  actions_to_take = []\n\n  if dx > 0:\n    actions_to_take.extend([craft.MOVE_RIGHT for _ in range(dx)])\n  elif dx < 0:\n    actions_to_take.extend([craft.MOVE_LEFT for _ in range(-dx)])\n\n  if dy > 0:\n    actions_to_take.extend([craft.MOVE_DOWN for _ in range(dy)])", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T13:57:09.042667", "function_name": "craft", "function_body": "  # Step 1: Resolve the index for the desired item\n  goal_index = env.world.cookbook.index[item]\n\n  if not goal_index:\n      print(\"Unknown item:\", item)\n      return []\n\n  # Step 2: Check if we already have the item in our inventory. If yes, return an empty list.\n  if env._current_state.inventory[goal_index] > 0:\n      return []\n\n  # Step 3: Get the recipe for the desired item\n  recipe = env.world.cookbook.recipes.get(goal_index)\n\n  # Check if there's a recipe available for the goal item\n  if not recipe:\n      print(\"No recipe found for:\", item)\n      return []\n\n  actions = []\n  \n  # Step 4: Collect all required primitives (or intermediate items) for crafting.\n  # Iterate over each ingredient in the recipe and collect them first.\n  for ingredient, count in recipe.items():\n    if ingredient == \"_at\": \n        continue\n\n    ingredient_index = env.world.cookbook.index[ingredient]\n    \n    # Check if we already have enough of this ingredient\n    if env._current_state.inventory[ingredient_index] >= count:\n        continue\n    \n    # If not, collect the required amount of ingredients.\n    actions.extend(collect(env, ingredient))\n  \n  # Step 5: Go to the workshop specified in the recipe and craft the item.\n  workshop = recipe.get(\"_at\")\n  if not workshop:\n      print(\"No workshop specified for crafting:\", item)\n      return []\n  \n  workshop_index = env.world.cookbook.index[workshop]\n\n  # Navigate to the nearest cell containing the required workshop\n  actions.extend(move_to(env, workshop_index))\n  \n  # Turn to face the workshop\n  actions.append(4)  # Assuming USE is action index 4\n  \n  # Craft the item\n  actions.append(4)  # Perform the USE action again to craft the item\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-10T13:57:10.018918", "function_name": "craft", "function_body": "  # Fetch the index for the desired item from the cookbook\n  i_item = env.world.cookbook.index[item]\n  \n  # Check if the item has a recipe in the cookbook\n  if i_item not in env.world.cookbook.recipes:\n    return []  # No recipe available, cannot craft\n  \n  # Fetch the recipe for the desired item\n  recipe = env.world.cookbook.recipes[i_item]\n\n  actions = []\n  \n  # Collect required primitives and intermediate items\n  for ingredient, count in recipe.items():\n      if ingredient == \"_at\":\n          continue  # Skip _at key which specifies the workshop\n      \n      i_ingredient = env.world.cookbook.index[ingredient]\n      \n      # Check if the agent has enough of this ingredient already\n      if env._current_state.inventory[i_ingredient] >= count:\n          continue  # No need to collect, skip\n      \n      # Collect the required number of ingredients\n      actions.extend(collect(env, ingredient, count))\n\n  \n  # Determine the workshop location for crafting\n  workshop = recipe.get(\"_at\")\n  if workshop is None:\n    return []  # No workshop specified in the recipe, cannot craft\n\n  i_workshop = env.world.cookbook.index[workshop]\n  workshop_positions = np.argwhere(env._current_state.grid[:,:,i_workshop] > 0)\n  \n  if len(workshop_positions) == 0:\n    return []  # Workshop not found on the grid, cannot craft\n  \n  # Navigate to the nearest workshop\n  closest_workshop_pos = min(workshop_positions, key=lambda pos: np.linalg.norm(np.array(pos) - np.array(env._current_state.pos)))\n  \n  actions.extend(navigate_to(env, closest_workshop_pos))\n  \n  # Use the USE action at the workshop\n  actions.append(craft.USE)\n  \n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-10T14:01:17.281287", "function_name": "craft", "function_body": "  def astar(start, goal, grid_shape):\n    open_set = collections.PriorityQueue()\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, goal)}\n\n    open_set.put((f_score[start], start))\n\n    while not open_set.empty():\n        _, current = open_set.get()\n\n        if current == goal:\n            return reconstruct_path(came_from, current)\n\n        for neighbor in neighbors(current, grid_shape):\n            tentative_g_score = g_score[current] + 1\n\n            if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                came_from[neighbor] = current\n                g_score[neighbor] = tentative_g_score\n                f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                open_set.put((f_score[neighbor], neighbor))\n\n    return []\n\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def neighbors(pos, grid_shape):\n      x, y = pos\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < grid_shape[0] and 0 <= ny < grid_shape[1]:\n              yield (nx, ny)\n\n  def reconstruct_path(came_from, current):\n      total_path = [current]\n      while current in came_from:\n          current = came_from[current]\n          total_path.append(current)\n      return total_path[::-1]\n\n  def get_current_direction_from_state(state):\n    # This function should determine the current direction of the agent based on the state\n    # Placeholder implementation assuming a fixed direction (e.g., UP)\n    return np.array([0, -1])\n\n  def is_facing_correct_direction(current_direction, target_direction):\n      # Check if the current direction matches the target direction\n      return np.array_equal(current_direction, target_direction)\n\n  def rotate_towards_target_direction(current_direction, target_direction):\n      # Determine the rotation action needed to face the target direction\n      if np.array_equal(target_direction, np.array([0, -1])):  # UP\n          return env.world.cookbook.index[\"UP\"]\n      elif np.array_equal(target_direction, np.array([0, 1])):   # DOWN\n          return env.world.cookbook.index[\"DOWN\"]\n      elif np.array_equal(target_direction, np.array([-1, 0])): # LEFT\n          return env.world.cookbook.index[\"LEFT\"]\n      elif np.array_equal(target_direction, np.array([1, 0])):  # RIGHT\n          return env.world.cookbook.index[\"RIGHT\"]\n\n  def get_rotated_direction(current_direction, action):\n    # Update the current direction based on the rotation action taken\n    if action == env.world.cookbook.index[\"UP\"]:\n        return np.array([0, -1])\n    elif action == env.world.cookbook.index[\"DOWN\"]:\n        return np.array([0, 1])\n    elif action == env.world.cookbook.index[\"LEFT\"]:\n        return np.array([-1, 0])\n    elif action == env.world.cookbook.index[\"RIGHT\"]:\n        return np.array([1, 0])\n\n  def find_workshop_positions(grid, workshop_index):\n      \"\"\"Find all positions of the specified workshop in the grid.\"\"\"\n      positions = []\n      for x in range(grid.shape[0]):\n          for y in range(grid.shape[1]):\n              if grid[x, y, workshop_index] > 0:\n                  positions.append((x, y))\n      return positions\n\n  goal_index = env.world.cookbook.index[item]\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n\n  actions = []\n\n  if not required_primitives:\n    return [] # No recipe or no primitives needed, can't craft\n\n  # Check if all required primitives are already in inventory\n  for primitive, count in required_primitives.items():\n    if env._current_state.inventory[primitive] < count:\n      return [] # Not enough primitives to start crafting\n\n  # Find the workshop where we need to go to craft this item\n  workshop_index = None\n  for recipe_key, recipe in env.world.cookbook.recipes.items():\n    if \"_at\" in recipe and recipe[\"_at\"] == goal_index:\n      workshop_index = env.world.cookbook.index[recipe_key]\n      break\n\n  # Check if the required workshop exists\n  if workshop_index is None:\n    return [] # No suitable workshop found\n  \n  # Find all positions of the workshop in the grid\n  workshop_positions = find_workshop_positions(env._current_state.grid, workshop_index)\n\n  # If no workshops are found, return an empty list\n  if not workshop_positions:\n    return []\n\n  # Sort workshops by proximity to the current position\n  start_pos = env._current_state.pos\n  workshop_positions.sort(key=lambda pos: heuristic(start_pos, pos))\n\n  # Navigate to the closest workshop\n  target_pos = workshop_positions[0]\n  \n  # Simple pathfinding to the workshop using A* algorithm\n  path = astar(start_pos, target_pos, env._current_state.grid.shape)\n\n  # Convert path into actions\n  if path:\n      for i in range(len(path) - 1):\n          dx = path[i + 1][0] - path[i][0]\n          dy = path[i + 1][1] - path[i][1]\n\n          if dx == 0 and dy == -1:\n              actions.append(env.world.cookbook.index[\"UP\"])\n          elif dx == 0 and dy == 1:\n              actions.append(env.world.cookbook.index[\"DOWN\"])\n          elif dx == -1 and dy == 0:\n              actions.append(env.world.cookbook.index[\"LEFT\"])\n          elif dx == 1 and dy == 0:\n              actions.append(env.world.cookbook.index[\"RIGHT\"])\n\n      # Orient the agent towards the workshop before using it\n      target_direction = np.array(target_pos) - np.array(path[-2])\n      current_direction = get_current_direction_from_state(env._current_state)\n\n      while not is_facing_correct_direction(current_direction, target_direction):\n          actions.append(rotate_towards_target_direction(current_direction, target_direction))\n          current_direction = get_rotated_direction(current_direction, rotate_towards_target_direction(current_direction, target_direction))\n\n  # Use action to craft the item at the workshop\n  actions.append(env.world.cookbook.index[\"USE\"])\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T14:01:18.339176", "function_name": "craft", "function_body": "  def astar(start, goal, grid_shape):\n    open_set = collections.PriorityQueue()\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, goal)}\n\n    open_set.put((f_score[start], start))\n\n    while not open_set.empty():\n        _, current = open_set.get()\n\n        if current == goal:\n            return reconstruct_path(came_from, current)\n\n        for neighbor in neighbors(current, grid_shape):\n            tentative_g_score = g_score[current] + 1\n\n            if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                came_from[neighbor] = current\n                g_score[neighbor] = tentative_g_score\n                f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                open_set.put((f_score[neighbor], neighbor))\n\n    return []\n\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def neighbors(pos, grid_shape):\n      x, y = pos\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < grid_shape[0] and 0 <= ny < grid_shape[1]:\n              yield (nx, ny)\n\n  def reconstruct_path(came_from, current):\n      total_path = [current]\n      while current in came_from:\n          current = came_from[current]\n          total_path.append(current)\n      return total_path[::-1]\n\n  def get_current_direction_from_state(state):\n    # Assuming the agent's direction is part of the state\n    # Placeholder implementation assuming a fixed direction (e.g., UP)\n    # In reality, this should be derived from the actual state\n    return np.array([0, -1])\n\n  def is_facing_correct_direction(current_direction, target_direction):\n      # Check if the current direction matches the target direction\n      return np.array_equal(current_direction, target_direction)\n\n  def rotate_towards_target_direction(current_direction, target_direction):\n      # Determine the rotation action needed to face the target direction\n      directions = {\n          (0, -1): \"UP\",\n          (0, 1): \"DOWN\",\n          (-1, 0): \"LEFT\",\n          (1, 0): \"RIGHT\"\n      }\n      \n      current_tuple = tuple(current_direction)\n      target_tuple = tuple(target_direction)\n\n      if current_tuple == target_tuple:\n          return None\n      \n      # Calculate the rotation needed\n      rotations = {\n          (\"UP\", \"DOWN\"): [\"RIGHT\", \"RIGHT\"],\n          (\"UP\", \"LEFT\"): [\"LEFT\"],\n          (\"UP\", \"RIGHT\"): [\"RIGHT\"],\n          (\"DOWN\", \"UP\"): [\"RIGHT\", \"RIGHT\"],\n          (\"DOWN\", \"LEFT\"): [\"RIGHT\"],\n          (\"DOWN\", \"RIGHT\"): [\"LEFT\"],\n          (\"LEFT\", \"UP\"): [\"RIGHT\"],\n          (\"LEFT\", \"DOWN\"): [\"LEFT\"],\n          (\"LEFT\", \"RIGHT\"): [\"RIGHT\", \"RIGHT\"],\n          (\"RIGHT\", \"UP\"): [\"LEFT\"],\n          (\"RIGHT\", \"DOWN\"): [\"RIGHT\"],\n          (\"RIGHT\", \"LEFT\"): [\"LEFT\", \"LEFT\"]\n      }\n\n      return rotations.get((directions[current_tuple], directions[target_tuple]), [])\n\n  def get_rotated_direction(current_direction, action):\n    # Update the current direction based on the rotation action taken\n    actions = {\n        \"UP\": np.array([0, -1]),\n        \"DOWN\": np.array([0, 1]),\n        \"LEFT\": np.array([-1, 0]),\n        \"RIGHT\": np.array([1, 0])\n    }\n    \n    return actions.get(action)\n\n  goal_index = env.world.cookbook.index[item]\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n\n  actions = []\n\n  if not required_primitives:\n    return [] # No recipe or no primitives needed, can't craft\n\n  # Check if all required primitives are already in inventory\n  for primitive, count in required_primitives.items():\n    if env._current_state.inventory[primitive] < count:\n      return [] # Not enough primitives to start crafting\n\n  # Find the workshop where we need to go to craft this item\n  workshop_index = None\n  for recipe_key, recipe in env.world.cookbook.recipes.items():\n    if \"_at\" in recipe and recipe[\"_at\"] == goal_index:\n      workshop_index = env.world.cookbook.index[recipe_key]\n      break\n\n  # Check if the required workshop exists\n  if workshop_index is None:\n    return [] # No suitable workshop found\n  \n  # Navigate to the closest workshop\n  target_pos = None\n  for x in range(env._current_state.grid.shape[0]):\n    for y in range(env._current_state.grid.shape[1]):\n      if env._current_state.grid[x, y, workshop_index] > 0:\n        target_pos = (x, y)\n        break\n    if target_pos is not None:\n      break\n  \n  # If no workshop is found, return an empty list\n  if target_pos is None:\n    return []\n\n  # Simple pathfinding to the workshop using A* algorithm\n  start_pos = env._current_state.pos\n  path = astar(start_pos, target_pos, env._current_state.grid.shape)\n\n  # Convert path into actions\n  if path:\n      for i in range(len(path) - 1):\n          dx = path[i + 1][0] - path[i][0]\n          dy = path[i + 1][1] - path[i][1]\n\n          if dx == 0 and dy == -1:\n              actions.append(env.world.cookbook.index[\"UP\"])\n          elif dx == 0 and dy == 1:\n              actions.append(env.world.cookbook.index[\"DOWN\"])\n          elif dx == -1 and dy == 0:\n              actions.append(env.world.cookbook.index[\"LEFT\"])\n          elif dx == 1 and dy == 0:\n              actions.append(env.world.cookbook.index[\"RIGHT\"])\n\n      # Orient the agent towards the workshop before using it\n      target_direction = np.array(target_pos) - np.array(path[-2])\n      current_direction = get_current_direction_from_state(env._current_state)\n\n      while not is_facing_correct_direction(current_direction, target_direction):\n          rotations_needed = rotate_towards_target_direction(current_direction, target_direction)\n          if rotations_needed:\n              for rotation in rotations_needed:\n                  actions.append(env.world.cookbook.index[rotation])\n                  current_direction = get_rotated_direction(current_direction, rotation)\n\n  # Use action to craft the item at the workshop\n  actions.append(env.world.cookbook.index[\"USE\"])\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T14:04:01.081374", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n  \n  # Check if there's a recipe for this item\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the ingredients required to craft this item\n  recipe = env.world.cookbook.recipes[item_index]\n  ingredients_needed = {ingredient: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n\n  actions_to_take = []\n  \n  # Check if we have all the ingredients in our inventory\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n\n  # Calculate missing ingredients and collect them\n  missing_ingredients = {}\n  for ingredient_index, count in ingredients_needed.items():\n    required_count = count\n    if ingredient_index in inventory_dict:\n      required_count -= inventory_dict[ingredient_index]\n    if required_count > 0:\n      missing_ingredients[ingredient_index] = required_count\n\n  # Collect each missing ingredient before proceeding to craft the item\n  for ingredient_index, required_count in missing_ingredients.items():\n    ingredient_name = env.world.cookbook.index.get(ingredient_index)\n    while required_count > 0:\n      ingredient_positions = np.argwhere(env._current_state.grid[:, :, ingredient_index] == 1)\n      \n      if not ingredient_positions.size:\n        # If there are no more ingredients of this type in the grid, return an empty action list\n        return []\n      \n      # Calculate distances to each ingredient and find the closest one\n      pos_x, pos_y = env._current_state.pos\n      distances = [abs(x - pos_x) + abs(y - pos_y) for x, y in ingredient_positions]\n      nearest_ingredient_pos = tuple(ingredient_positions[np.argmin(distances)])\n      \n      # Determine actions to move to the nearest ingredient\n      while (pos_x, pos_y) != nearest_ingredient_pos:\n        dx = nearest_ingredient_pos[0] - pos_x\n        dy = nearest_ingredient_pos[1] - pos_y\n\n        if abs(dx) > abs(dy):\n          move_dir = \"RIGHT\" if dx > 0 else \"LEFT\"\n        else:\n          move_dir = \"DOWN\" if dy > 0 else \"UP\"\n\n        actions_to_take.append(env.world.N_ACTIONS[move_dir])\n        # Update the position after each action (simulated step)\n        pos_x, pos_y = env._current_state.pos\n\n      # Add USE action to collect the ingredient\n      actions_to_take.append(env.world.USE)\n      \n      # Simulate the inventory update for demonstration purposes\n      required_count -= 1\n      if ingredient_index in inventory_dict:\n        inventory_dict[ingredient_index] += 1\n      else:\n        inventory_dict[ingredient_index] = 1\n\n  # Get the workshop index where this item needs to be crafted\n  workshop_name = recipe[\"_at\"]\n  workshop_index = getattr(env.world, f\"{workshop_name}_index\")\n\n  # Find the position of the nearest workshop in the grid\n  pos_x, pos_y = env._current_state.pos\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  \n  if not workshop_positions.size:\n    return []\n\n  # Calculate distances to each workshop and find the closest one\n  distances = [abs(x - pos_x) + abs(y - pos_y) for x, y in workshop_positions]\n  nearest_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n\n  # Determine actions to move to the nearest workshop\n  while (pos_x, pos_y) != nearest_workshop_pos:\n    dx = nearest_workshop_pos[0] - pos_x\n    dy = nearest_workshop_pos[1] - pos_y\n\n    if abs(dx) > abs(dy):\n      move_dir = \"RIGHT\" if dx > 0 else \"LEFT\"\n    else:\n      move_dir = \"DOWN\" if dy > 0 else \"UP\"\n\n    actions_to_take.append(env.world.N_ACTIONS[move_dir])\n    # Update the position after each action (simulated step)\n    pos_x, pos_y = env._current_state.pos\n\n  # Add USE action to craft the item\n  actions_to_take.append(env.world.USE)\n\n  return actions_to_take", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-10T14:04:02.159795", "function_name": "craft", "function_body": "  def find_nearest_workshop(workshop_index):\n    pos_x, pos_y = env._current_state.pos\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    \n    if not workshop_positions.size:\n      return None\n\n    # Calculate distances to each workshop and find the closest one\n    distances = [abs(x - pos_x) + abs(y - pos_y) for x, y in workshop_positions]\n    nearest_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n    return nearest_workshop_pos\n\n  def move_to_position(target_pos):\n    actions = []\n    current_pos = env._current_state.pos\n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if abs(dx) > abs(dy):\n        move_dir = \"RIGHT\" if dx > 0 else \"LEFT\"\n      else:\n        move_dir = \"DOWN\" if dy > 0 else \"UP\"\n\n      actions.append(env.world.N_ACTIONS[move_dir])\n      # Simulate the movement to update current_pos\n      if move_dir == \"RIGHT\":\n        current_pos = (current_pos[0] + 1, current_pos[1])\n      elif move_dir == \"LEFT\":\n        current_pos = (current_pos[0] - 1, current_pos[1])\n      elif move_dir == \"DOWN\":\n        current_pos = (current_pos[0], current_pos[1] + 1)\n      elif move_dir == \"UP\":\n        current_pos = (current_pos[0], current_pos[1] - 1)\n\n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if there's a recipe for this item\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the ingredients required to craft this item\n  recipe = env.world.cookbook.recipes[item_index]\n  ingredients_needed = {ingredient: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n\n  # Check if we have all the ingredients in our inventory\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  # Subtract the ingredients we already have from what's needed\n  for ingredient_index, count in inventory_dict.items():\n    if ingredient_index in ingredients_needed:\n      ingredients_needed[ingredient_index] -= count\n      if ingredients_needed[ingredient_index] <= 0:\n        del ingredients_needed[ingredient_index]\n\n  # If there are still ingredients needed, return an empty action list\n  if ingredients_needed:\n    return []\n\n  # Get the workshop index where this item needs to be crafted\n  workshop_name = recipe[\"_at\"]\n  workshop_index = getattr(env.world, f\"{workshop_name}_index\")\n\n  # Find the position of the nearest workshop in the grid\n  nearest_workshop_pos = find_nearest_workshop(workshop_index)\n  \n  if not nearest_workshop_pos:\n    return []\n\n  # Determine actions to move to the nearest workshop\n  actions_to_move = move_to_position(nearest_workshop_pos)\n\n  # Add USE action to craft the item\n  actions_to_move.append(env.world.USE)\n\n  return actions_to_move", "island_id": 2, "scores": {"3": 0.0}}
