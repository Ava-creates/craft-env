nt_state.inventory) if count > 0}\n  \n  # Subtract the ingredients we already have from what's needed\n  for ingredient_index, count in inventory_dict.items():\n    if ingredient_index in ingredients_needed:\n      ingredients_needed[ingredient_index] -= count\n      if ingredients_needed[ingredient_index] <= 0:\n        del ingredients_needed[ingredient_index]\n\n  # If there are still ingredients needed, return an empty action list\n  if ingredients_needed:\n    actions = []\n    for ingredient, count in ingredients_needed.items():\n      primitive_name = env.world.cookbook.index.get(ingredient)\n      if not primitive_name:\n        continue\n\n      collect_actions = collect_v2(env, primitive_name)\n      actions.extend(collect_actions)\n\n      # Check if we have collected enough after collecting\n      inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n      if ingredient in inventory_dict and inventory_dict[ingredient] >= count:\n        continue\n\n    return []\n\n  # Get the workshop index where this item needs to be crafted\n  workshop_name = recipe[\"_at\"]\n  workshop_index = getattr(env.world, f\"{workshop_name}_index\")\n\n  # Find the position of the nearest workshop in the grid\n  nearest_workshop_pos = find_nearest_workshop(workshop_index)\n  \n  if not nearest_workshop_pos:\n    return []\n\n  # Determine actions to move to the nearest workshop\n  actions_to_move = move_to_position(nearest_workshop_pos)\n\n  # Add USE action to craft the item\n  actions_to_move.append(env.world.USE)\n\n  return actions_to_move", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-10T15:12:47.321360", "function_name": "craft", "function_body": "  def determine_facing_direction(pos1, pos2):\n      dx = pos2[0] - pos1[0]\n      dy = pos2[1] - pos1[1]\n\n      if abs(dx) > abs(dy):\n          return craft.ACTION_DOWN if dx > 0 else craft.ACTION_UP\n      elif abs(dy) > abs(dx):\n          return craft.ACTION_RIGHT if dy > 0 else craft.ACTION_LEFT\n      else:\n          return None\n\n  def navigate_to(env, target_position):\n      path = a_star_search(env._current_state.grid, env._current_state.pos, target_position)\n      actions = []\n      for step in path:\n          if step[0] > env._current_state.pos[0]:\n              actions.append(craft.ACTION_DOWN)\n          elif step[0] < env._current_state.pos[0]:\n              actions.append(craft.ACTION_UP)\n          elif step[1] > env._current_state.pos[1]:\n              actions.append(craft.ACTION_RIGHT)\n          elif step[1] < env._current_state.pos[1]:\n              actions.append(craft.ACTION_LEFT)\n      return actions\n\n  def a_star_search(grid, start, goal):\n      open_set = collections.deque([(0, start)])\n      came_from = {}\n      g_score = {start: 0}\n      f_score = {start: heuristic(start, goal)}\n\n      while open_set:\n          _, current = open_set.popleft()\n          if current == goal:\n              return reconstruct_path(came_from, current)\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n                  tentative_g_score = g_score[current] + 1\n                  if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                      came_from[neighbor] = current\n                      g_score[neighbor] = tentative_g_score\n                      f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                      open_set.append((f_score[neighbor], neighbor))\n\n      return []\n\n  def heuristic(a, b):\n      return abs(b[0] - a[0]) + abs(b[1] - a[1])\n\n  def reconstruct_path(came_from, current):\n      total_path = [current]\n      while current in came_from:\n          current = came_from[current]\n          total_path.append(current)\n      total_path.reverse()\n      return total_path[1:]  # Exclude the start position\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  current_inventory = {env.world.cookbook.index.get(i): env._current_state.inventory[i] for i in range(len(env._current_state.inventory))}\n\n  actions = []\n\n  # Check if we have all the primitives required\n  for primitive, count in required_primitives.items():\n    if current_inventory.get(primitive, 0) < count:\n      return []  # Return empty list as we do not have enough primitives\n\n  # Determine which workshop to use and navigate there\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_required = None\n  for key in recipe.keys():\n    if \"_at\" in key:\n      workshop_required = key.split(\"_at\")[1].strip()\n      break\n\n  if not workshop_required:\n    return []  # No valid workshop found in the recipe\n\n  # Find the position of the required workshop in the grid\n  workshop_index = env.world.cookbook.index[workshop_required]\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n  if not workshop_positions.size:\n    return []  # No valid workshop found on the grid\n\n  target_workshop_position = tuple(workshop_positions[0])\n\n  # Navigate to the workshop\n  actions.extend(navigate_to(env, target_workshop_position))\n\n  # Turn to face the workshop (assuming we can determine the direction needed)\n  facing_direction = determine_facing_direction(env._current_state.pos, target_workshop_position)\n  if facing_direction is not None:\n    actions.append(facing_direction)\n\n  # Perform USE action to craft the item\n  actions.append(craft.ACTION_USE)\n\n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T15:12:48.421392", "function_name": "craft", "function_body": "  def determine_facing_direction(pos1, pos2):\n      dx = pos2[0] - pos1[0]\n      dy = pos2[1] - pos1[1]\n\n      if abs(dx) > abs(dy):\n          return craft.ACTION_DOWN if dx > 0 else craft.ACTION_UP\n      elif abs(dy) > abs(dx):\n          return craft.ACTION_RIGHT if dy > 0 else craft.ACTION_LEFT\n      else:\n          return None\n\n  def navigate_to(env, target_position):\n      path = a_star_search(env._current_state.grid, env._current_state.pos, target_position)\n      actions = []\n      for step in path:\n          direction = determine_facing_direction(env._current_state.pos, step)\n          if direction is not None:\n              actions.append(direction)\n              env._current_state = env._current_state.step(actions[-1])[1]\n      return actions\n\n  def a_star_search(grid, start, goal):\n      open_set = collections.deque([(0, start)])\n      came_from = {}\n      g_score = {start: 0}\n      f_score = {start: heuristic(start, goal)}\n\n      while open_set:\n          _, current = open_set.popleft()\n          if current == goal:\n              return reconstruct_path(came_from, current)\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n                  tentative_g_score = g_score[current] + 1\n                  if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                      came_from[neighbor] = current\n                      g_score[neighbor] = tentative_g_score\n                      f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                      open_set.append((f_score[neighbor], neighbor))\n\n      return []\n\n  def heuristic(a, b):\n      return abs(b[0] - a[0]) + abs(b[1] - a[1])\n\n  def reconstruct_path(came_from, current):\n      total_path = [current]\n      while current in came_from:\n          current = came_from[current]\n          total_path.append(current)\n      total_path.reverse()\n      return total_path[1:]  # Exclude the start position\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  current_inventory = {env.world.cookbook.index.get(i): env._current_state.inventory[i] for i in range(len(env._current_state.inventory))}\n\n  actions = []\n\n  # Check if we have all the primitives required\n  for primitive, count in required_primitives.items():\n    if current_inventory.get(primitive, 0) < count:\n      return []  # Return empty list as we do not have enough primitives\n\n  # Determine which workshop to use and navigate there\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_required = None\n  for key in recipe.keys():\n    if \"_at\" in key:\n      workshop_required = key.split(\"_at\")[1].strip()\n      break\n\n  if not workshop_required:\n    return []  # No valid workshop found in the recipe\n\n  # Find the position of the required workshop in the grid\n  workshop_index = env.world.cookbook.index[workshop_required]\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n  if not workshop_positions.size:\n    return []  # No valid workshop found on the grid\n\n  target_workshop_position = tuple(workshop_positions[0])\n\n  # Navigate to the workshop\n  actions.extend(navigate_to(env, target_workshop_position))\n\n  # Turn to face the workshop (assuming we can determine the direction needed)\n  facing_direction = determine_facing_direction(env._current_state.pos, target_workshop_position)\n  if facing_direction is not None:\n    actions.append(facing_direction)\n\n  # Perform USE action to craft the item\n  actions.append(craft.ACTION_USE)\n\n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T15:14:16.348826", "function_name": "craft", "function_body": "  # Get the index of the goal item\n  idx = env.world.cookbook.index[item]\n\n  # Check if we have all primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(idx)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n\n  # Verify if the agent has all required items\n  missing_items = []\n  for primitive_idx, required_count in required_primitives.items():\n      if inventory_dict.get(primitive_idx, 0) < required_count:\n          missing_items.append((primitive_idx, required_count))\n\n  if missing_items:\n      return []\n\n  # Proceed to craft the item by going to the workshop specified in the recipe and performing the USE action.\n  # Find the workshop index for the goal item\n  workshop_idx = env.world.cookbook.recipes[idx].get(\"_key\", None)\n  \n  if workshop_idx is not None:\n      # Convert workshop index back to name\n      workshop_name = env.world.cookbook.index.get(workshop_idx)\n      \n      # Find the position of the required workshop in the grid\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx] == 1)\n      \n      if len(workshop_positions) == 0:\n          return []\n      \n      # Assume the closest workshop for now\n      target_pos = tuple(workshop_positions[0])\n      \n      # Compute path to the workshop using a simple heuristic (Manhattan distance)\n      current_pos = env._current_state.pos\n      path_to_workshop = compute_path(current_pos, target_pos, env._current_state.grid)\n\n      if not path_to_workshop:\n          return []\n\n      # Convert path to actions\n      actions_to_workshop = []\n      for next_pos in path_to_workshop:\n          actions_to_workshop.extend(compute_actions(env._current_state.pos, env._current_state.dir, next_pos))\n          env._current_state.pos = next_pos  # Update position for next step\n\n      # Add USE action to craft the item\n      actions_to_workshop.append(craft.USE)\n\n      return actions_to_workshop\n  \n  return []", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T15:14:17.408588", "function_name": "craft", "function_body": "  # Convert the item name to its index\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Initialize an empty list to store actions\n  actions = []\n  \n  # Check if we have all the ingredients in the inventory\n  for ingredient, count in recipe.items():\n      if ingredient == \"_at\":\n          continue  # Skip the workshop information\n      \n      ingredient_index = env.world.cookbook.index[ingredient]\n      \n      # If the ingredient is not in the inventory, return an empty action list\n      if env._current_state.inventory[ingredient_index] < count:\n          return []\n  \n  # If we have all ingredients, proceed to the workshop specified in the recipe\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n  \n  # Find the position of the nearest workshop\n  grid_shape = env._current_state.grid.shape[:2]  # Get the shape of the grid (WIDTH, HEIGHT)\n  min_distance = float('inf')\n  nearest_workshop_pos = None\n  \n  for x in range(grid_shape[0]):\n      for y in range(grid_shape[1]):\n          if env._current_state.grid[x, y, workshop_index] == 1:\n              distance = np.linalg.norm(np.array(env._current_state.pos) - np.array((x, y)))\n              if distance < min_distance:\n                  min_distance = distance\n                  nearest_workshop_pos = (x, y)\n  \n  if nearest_workshop_pos is None:\n      return []  # No workshop found\n  \n  # Move to the nearest workshop\n  target_x, target_y = nearest_workshop_pos\n  current_x, current_y = env._current_state.pos\n\n  actions.extend(move_to_target(env, (target_x, target_y)))\n  \n  # Check if we are facing the workshop\n  workshop_direction = get_direction_to_face(env, nearest_workshop_pos)\n  \n  if env._current_state.dir != workshop_direction:\n      actions.append(workshop_direction)\n\n  # Perform USE action to craft the item\n  actions.append(craft.USE)\n  \n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-10T15:15:01.672755", "function_name": "craft", "function_body": "  # Convert the item name to its index using the cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the recipe for the desired item exists\n  if item_index not in env.world.cookbook.recipes:\n    return []\n  \n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Check if all primitives are available in inventory\n  required_primitives = recipe.copy()\n  del required_primitives['_at']\n  workshop_index = env.world.cookbook.index[recipe['_at']]\n\n  # Check if all required items are already available in inventory\n  for primitive, count in required_primitives.items():\n    primitive_index = env.world.cookbook.index[primitive]\n    if env._current_state.inventory[primitive_index] < count:\n      return []\n  \n  # If all prerequisites are met, proceed to the workshop and craft the item\n  actions_to_take = []\n\n  # Move towards the workshop\n  workshop_position = None\n  for idx, position in enumerate(env.world.workshop_indices):\n    if position == workshop_index:\n      workshop_position = env.world.workshop_indices[idx]\n      break\n\n  if workshop_position is None:\n    return []\n  \n  target_pos = (workshop_position % env.world.grid.shape[1], workshop_position // env.world.grid.shape[1])\n  current_pos = env._current_state.pos\n\n  # Calculate the path to the workshop\n  path_to_workshop = astar_pathfinding(env, current_pos, target_pos)\n  actions_to_take.extend(path_to_workshop)\n\n  # Add USE action to craft the item at the workshop\n  actions_to_take.append(4)  # Assuming USE action is indexed as 4\n\n  return actions_to_take", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-10T15:15:02.643595", "function_name": "craft", "function_body": "  actions = []\n\n  # Check if the item can be crafted\n  index = env.world.cookbook.index.get(item)\n  if index is None:\n    print(f\"Item {item} not found in cookbook.\")\n    return []\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes[index]\n  required_items = recipe.copy()\n\n  # Check if we have all the primitives required to craft the item\n  inventory = env._current_state.inventory\n  for primitive, count in required_items.items():\n    if primitive != \"_key\" and inventory[primitive] < count:\n      print(f\"Not enough {env.world.cookbook.index.get(primitive)} in inventory.\")\n      return []\n\n  # Get the workshop index from the recipe\n  workshop_index = env.world.cookbook.index.get(recipe[\"_key\"])\n  if workshop_index is None:\n    print(f\"Workshop for {item} not found in cookbook.\")\n    return []\n\n  # Move to the nearest workshop\n  actions.extend(move_to_workshop(env, workshop_index))\n\n  # Craft the item using the USE action\n  actions.append(craft.USE)\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-10T15:18:04.043374", "function_name": "craft", "function_body": "  def find_nearest_workshop(workshop_index):\n    pos_x, pos_y = env._current_state.pos\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    \n    if not workshop_positions.size:\n      return None\n\n    # Calculate Manhattan distances to each workshop and find the closest one\n    distances = [abs(x - pos_x) + abs(y - pos_y) for x, y in workshop_positions]\n    nearest_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n    return nearest_workshop_pos\n\n  def move_to_position(target_pos):\n    actions = []\n    current_pos = env._current_state.pos\n    direction_order = [\"RIGHT\", \"LEFT\", \"DOWN\", \"UP\"]  # Define a priority order for directions\n\n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if abs(dx) > abs(dy):\n        move_dir = \"RIGHT\" if dx > 0 else \"LEFT\"\n      else:\n        move_dir = \"DOWN\" if dy > 0 else \"UP\"\n\n      # Check all possible directions to avoid obstacles\n      for direction in direction_order:\n        next_pos, move_action = get_next_position(current_pos, direction)\n        if is_valid_move(next_pos):\n          actions.append(env.world.N_ACTIONS[direction])\n          current_pos = next_pos\n          break\n\n    return actions\n\n  def get_next_position(pos, direction):\n    x, y = pos\n    if direction == \"RIGHT\":\n      return (x + 1, y), env.world.N_ACTIONS[\"RIGHT\"]\n    elif direction == \"LEFT\":\n      return (x - 1, y), env.world.N_ACTIONS[\"LEFT\"]\n    elif direction == \"DOWN\":\n      return (x, y + 1), env.world.N_ACTIONS[\"DOWN\"]\n    elif direction == \"UP\":\n      return (x, y - 1), env.world.N_ACTIONS[\"UP\"]\n\n  def is_valid_move(pos):\n    x, y = pos\n    # Ensure the position is within grid bounds and not an obstacle\n    return 0 <= x < env._current_state.grid.shape[0] and 0 <= y < env._current_state.grid.shape[1] and env._current_state.grid[x, y, env.world.cookbook.index[\"BOUNDARY\"]] == 0\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if there's a recipe for this item\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the ingredients required to craft this item\n  recipe = env.world.cookbook.recipes[item_index]\n  ingredients_needed = {ingredient: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n\n  # Check if we have all the ingredients in our inventory\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  # Subtract the ingredients we already have from what's needed\n  for ingredient_index, count in inventory_dict.items():\n    if ingredient_index in ingredients_needed:\n      ingredients_needed[ingredient_index] -= count\n      if ingredients_needed[ingredient_index] <= 0:\n        del ingredients_needed[ingredient_index]\n\n  # If there are still ingredients needed, return an empty action list\n  if ingredients_needed:\n    return []\n\n  # Get the workshop index where this item needs to be crafted\n  workshop_name = recipe[\"_at\"]\n  workshop_index = getattr(env.world, f\"{workshop_name}_index\")\n\n  # Find the position of the nearest workshop in the grid\n  nearest_workshop_pos = find_nearest_workshop(workshop_index)\n  \n  if not nearest_workshop_pos:\n    return []\n\n  # Determine actions to move to the nearest workshop\n  actions_to_move = move_to_position(nearest_workshop_pos)\n\n  # Add USE action to craft the item\n  actions_to_move.append(env.world.USE)\n\n  return actions_to_move", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T15:18:05.032203", "function_name": "craft", "function_body": "  def find_nearest_workshop(workshop_index):\n    pos_x, pos_y = env._current_state.pos\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    \n    if not workshop_positions.size:\n      return None\n\n    # Calculate distances to each workshop and find the closest one\n    distances = [abs(x - pos_x) + abs(y - pos_y) for x, y in workshop_positions]\n    nearest_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n    return nearest_workshop_pos\n\n  def move_to_position(target_pos):\n    actions = []\n    current_pos = env._current_state.pos\n    direction_order = [\"RIGHT\", \"LEFT\", \"DOWN\", \"UP\"]  # Define a priority order for directions\n\n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if abs(dx) > abs(dy):\n        move_dir = \"RIGHT\" if dx > 0 else \"LEFT\"\n      else:\n        move_dir = \"DOWN\" if dy > 0 else \"UP\"\n\n      # Check all possible directions to avoid obstacles\n      for direction in direction_order:\n        next_pos, move_action = get_next_position(current_pos, direction)\n        if is_valid_move(next_pos):\n          actions.append(env.world.N_ACTIONS[direction])\n          current_pos = next_pos\n          break\n\n    return actions\n\n  def get_next_position(pos, direction):\n    x, y = pos\n    if direction == \"RIGHT\":\n      return (x + 1, y), env.world.N_ACTIONS[\"RIGHT\"]\n    elif direction == \"LEFT\":\n      return (x - 1, y), env.world.N_ACTIONS[\"LEFT\"]\n    elif direction == \"DOWN\":\n      return (x, y + 1), env.world.N_ACTIONS[\"DOWN\"]\n    elif direction == \"UP\":\n      return (x, y - 1), env.world.N_ACTIONS[\"UP\"]\n\n  def is_valid_move(pos):\n    x, y = pos\n    # Ensure the position is within grid bounds and not an obstacle\n    return 0 <= x < env._current_state.grid.shape[0] and 0 <= y < env._current_state.grid.shape[1] and env._current_state.grid[x, y, env.world.cookbook.index[\"BOUNDARY\"]] == 0\n\n  def collect_missing_ingredients(env, ingredients_needed):\n    actions = []\n    \n    for ingredient_index, count in ingredients_needed.items():\n      ingredient_name = list(env.world.cookbook.index.keys())[list(env.world.cookbook.index.values()).index(ingredient_index)]\n      \n      # Find the nearest source of this ingredient\n      source_positions = np.argwhere(env._current_state.grid[:, :, ingredient_index] == 1)\n      \n      if not source_positions.size:\n        continue\n      \n      # Calculate distances to each source and find the closest one\n      pos_x, pos_y = env._current_state.pos\n      distances = [abs(x - pos_x) + abs(y - pos_y) for x, y in source_positions]\n      nearest_source_pos = tuple(source_positions[np.argmin(distances)])\n      \n      # Determine actions to move to the nearest source\n      actions.extend(move_to_position(nearest_source_pos))\n      \n      # Add USE action to collect the ingredient\n      for _ in range(count):\n        actions.append(env.world.USE)\n    \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if there's a recipe for this item\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the ingredients required to craft this item\n  recipe = env.world.cookbook.recipes[item_index]\n  ingredients_needed = {ingredient: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n\n  # Check if we have all the ingredients in our inventory\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  # Subtract the ingredients we already have from what's needed\n  for ingredient_index, count in inventory_dict.items():\n    if ingredient_index in ingredients_needed:\n      ingredients_needed[ingredient_index] -= count\n      if ingredients_needed[ingredient_index] <= 0:\n        del ingredients_needed[ingredient_index]\n\n  # If there are still ingredients needed, collect them\n  if ingredients_needed:\n    actions_to_collect = collect_missing_ingredients(env, ingredients_needed)\n  else:\n    actions_to_collect = []\n\n  # Get the workshop index where this item needs to be crafted\n  workshop_name = recipe[\"_at\"]\n  workshop_index = getattr(env.world, f\"{workshop_name}_index\")\n\n  # Find the position of the nearest workshop in the grid\n  nearest_workshop_pos = find_nearest_workshop(workshop_index)\n  \n  if not nearest_workshop_pos:\n    return []\n\n  # Determine actions to move to the nearest workshop\n  actions_to_move = actions_to_collect + move_to_position(nearest_workshop_pos)\n\n  # Add USE action to craft the item\n  actions_to_move.append(env.world.USE)\n\n  return actions_to_move", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-10T15:19:20.727311", "function_name": "craft", "function_body": "  # Get the index for the desired item from the cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the item has a recipe\n  if item_index not in env.world.cookbook.recipes:\n    return []\n  \n  # Retrieve the recipe for the item\n  recipe = env.world.cookbook.recipes[item_index]\n  \n  # Extract the required ingredients and their counts\n  ingredient_counts = {ingredient: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n  \n  # Check if the agent has all the required ingredients in its inventory\n  missing_ingredients = []\n  for ingredient, count in ingredient_counts.items():\n    if env._current_state.inventory[env.world.cookbook.index.get(ingredient, -1)] < count:\n      missing_ingredients.append((ingredient, count))\n  \n  # If there are missing ingredients, return an empty action list\n  if missing_ingredients:\n    return []\n  \n  # Determine the workshop where the item can be crafted\n  workshop = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop]\n  \n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  \n  if not workshop_positions.size:\n    return []\n  \n  # Choose the closest workshop to the agent's current position\n  distances_to_workshops = np.linalg.norm(workshop_positions - env._current_state.pos, axis=1)\n  closest_workshop_pos = tuple(workshop_positions[np.argmin(distances_to_workshops)])\n  \n  # Generate actions to move the agent to the closest workshop\n  actions_to_move = move_towards(env, closest_workshop_pos)\n  \n  # Add the USE action to craft the item at the workshop\n  actions_to_craft = [craft.CRAFT_FUNC(craft.parse_fexp(f\"{item}[0]\")[1])]\n  \n  return actions_to_move + actions_to_craft", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-10T15:19:21.716429", "function_name": "craft", "function_body": "  # Initialize an empty list to store actions\n  actions = []\n\n  # Get the index for the desired item from the cookbook\n  index = env.world.cookbook.index[item]\n\n  # Get the recipe for the item (if it exists)\n  if index not in env.world.cookbook.recipes:\n    return actions\n\n  recipe = env.world.cookbook.recipes[index]\n\n  # Check if we have all the required primitives/ingredients\n  missing_items = []\n  for ingredient, count in recipe.items():\n      if ingredient == \"_key\":\n          continue  # Skip _key which indicates the workshop index\n      if env._current_state.inventory[ingredient] < count:\n          missing_items.append((ingredient, count))\n\n  # If we are missing items, return an empty action list\n  if missing_items:\n    return actions\n\n  # Get the required workshop for crafting\n  workshop_index = recipe[\"_key\"]\n\n  # Find the position of the workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  \n  # If no workshops are available, return an empty action list\n  if len(workshop_positions) == 0:\n    return actions\n\n  # Choose one of the workshop positions randomly (for simplicity, we can choose the first one in this example)\n  workshop_pos = tuple(workshop_positions[0])\n\n  # Calculate the path to the workshop from the current position\n  path_to_workshop = calculate_path(env._current_state.pos, workshop_pos)\n\n  # Add actions to move to the workshop\n  actions.extend(path_to_workshop)\n\n  # Add an action to face the correct direction and use the workshop\n  facing_direction = determine_facing_direction(env._current_state.pos, workshop_pos)\n  actions.append(facing_direction)\n\n  # Use action at the workshop\n  actions.append(4)  # Assuming USE is represented by index 4\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-10T15:21:40.488698", "function_name": "craft", "function_body": "  def navigate_to(target_position):\n      \"\"\"Helper function to navigate from current position to target position.\"\"\"\n      x_diff = target_position[0] - env._current_state.pos[0]\n      y_diff = target_position[1] - env._current_state.pos[1]\n\n      actions = []\n\n      # Navigate in the X direction\n      if x_diff > 0:\n          actions.extend([craft.ACTION_RIGHT] * abs(x_diff))\n      elif x_diff < 0:\n          actions.extend([craft.ACTION_LEFT] * abs(x_diff))\n\n      # Navigate in the Y direction\n      if y_diff > 0:\n          actions.extend([craft.ACTION_DOWN] * abs(y_diff))\n      elif y_diff < 0:\n          actions.extend([craft.ACTION_UP] * abs(y_diff))\n\n      return actions\n\n  def determine_facing_direction(current_position, target_position):\n      \"\"\"Helper function to determine the direction needed to face the target.\"\"\"\n      x_diff = target_position[0] - current_position[0]\n      y_diff = target_position[1] - current_position[1]\n\n      if x_diff > 0:\n          return craft.ACTION_RIGHT\n      elif x_diff < 0:\n          return craft.ACTION_LEFT\n      elif y_diff > 0:\n          return craft.ACTION_DOWN\n      elif y_diff < 0:\n          return craft.ACTION_UP\n\n      return None\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  current_inventory = {env.world.cookbook.index.get(i): env._current_state.inventory[i] for i in range(len(env._current_state.inventory))}\n\n  actions = []\n\n  # Check if we have all the primitives required\n  for primitive, count in required_primitives.items():\n    if current_inventory.get(primitive, 0) < count:\n      return []  # Return empty list as we do not have enough primitives\n\n  # Determine which workshop to use and navigate there\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_required = None\n  for key in recipe.keys():\n    if \"_at\" in key:\n      workshop_required = key.split(\"_at\")[1].strip()\n      break\n\n  if not workshop_required:\n    return []  # No valid workshop found in the recipe\n\n  # Find the position of the required workshop in the grid\n  workshop_index = env.world.cookbook.index[workshop_required]\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n  if not workshop_positions.size:\n    return []  # No valid workshop found on the grid\n\n  target_workshop_position = tuple(workshop_positions[0])\n\n  # Navigate to the workshop\n  actions.extend(navigate_to(target_workshop_position))\n\n  # Turn to face the workshop (assuming we can determine the direction needed)\n  facing_direction = determine_facing_direction(env._current_state.pos, target_workshop_position)\n\n  if facing_direction is not None:\n    actions.append(facing_direction)\n\n  # Perform USE action to craft the item\n  actions.append(craft.ACTION_USE)\n\n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T15:21:41.575508", "function_name": "craft", "function_body": "  def navigate_to(target_position):\n      \"\"\"Helper function to navigate from current position to target position.\"\"\"\n      x_diff = target_position[0] - env._current_state.pos[0]\n      y_diff = target_position[1] - env._current_state.pos[1]\n\n      actions = []\n\n      # Navigate in the X direction\n      if x_diff > 0:\n          actions.extend([craft.ACTION_RIGHT] * abs(x_diff))\n      elif x_diff < 0:\n          actions.extend([craft.ACTION_LEFT] * abs(x_diff))\n\n      # Navigate in the Y direction\n      if y_diff > 0:\n          actions.extend([craft.ACTION_DOWN] * abs(y_diff))\n      elif y_diff < 0:\n          actions.extend([craft.ACTION_UP] * abs(y_diff))\n\n      return actions\n\n  def determine_facing_direction(current_position, target_position):\n      \"\"\"Helper function to determine the direction needed to face the target.\"\"\"\n      x_diff = target_position[0] - current_position[0]\n      y_diff = target_position[1] - current_position[1]\n\n      if abs(x_diff) > abs(y_diff):\n          return craft.ACTION_RIGHT if x_diff > 0 else craft.ACTION_LEFT\n      elif abs(y_diff) > abs(x_diff):\n          return craft.ACTION_DOWN if y_diff > 0 else craft.ACTION_UP\n\n      return None\n\n  def face_direction(target_direction, current_state):\n      \"\"\"Helper function to ensure the agent is facing the correct direction.\"\"\"\n      actions = []\n      current_direction = current_state.pos  # Assuming pos holds direction info (incorrect assumption)\n      \n      if target_direction == craft.ACTION_RIGHT and current_direction != craft.ACTION_RIGHT:\n          actions.append(craft.ACTION_RIGHT)\n      elif target_direction == craft.ACTION_LEFT and current_direction != craft.ACTION_LEFT:\n          actions.append(craft.ACTION_LEFT)\n      elif target_direction == craft.ACTION_DOWN and current_direction != craft.ACTION_DOWN:\n          actions.append(craft.ACTION_DOWN)\n      elif target_direction == craft.ACTION_UP and current_direction != craft.ACTION_UP:\n          actions.append(craft.ACTION_UP)\n\n      return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  current_inventory = {env.world.cookbook.index.get(i): env._current_state.inventory[i] for i in range(len(env._current_state.inventory))}\n\n  actions = []\n\n  # Check if we have all the primitives required\n  for primitive, count in required_primitives.items():\n    if current_inventory.get(primitive, 0) < count:\n      return []  # Return empty list as we do not have enough primitives\n\n  # Determine which workshop to use and navigate there\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_required = None\n  for key in recipe.keys():\n    if \"_at\" in key:\n      workshop_required = key.split(\"_at\")[1].strip()\n      break\n\n  if not workshop_required:\n    return []  # No valid workshop found in the recipe\n\n  # Find the position of the required workshop in the grid\n  workshop_index = env.world.cookbook.index[workshop_required]\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n  if not workshop_positions.size:\n    return []  # No valid workshop found on the grid\n\n  target_workshop_position = tuple(workshop_positions[0])\n\n  # Navigate to the workshop\n  actions.extend(navigate_to(target_workshop_position))\n\n  # Turn to face the workshop (assuming we can determine the direction needed)\n  facing_direction = determine_facing_direction(env._current_state.pos, target_workshop_position)\n  if facing_direction is not None:\n      actions.extend(face_direction(facing_direction, env._current_state))\n\n  # Perform USE action to craft the item\n  actions.append(craft.ACTION_USE)\n\n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T15:25:52.002802", "function_name": "craft", "function_body": "  def _move_to_position(target_pos):\n    start = env._current_state.pos\n\n    def heuristic(a, b):\n        return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n    open_set = collections.PriorityQueue()\n    open_set.put((0, start))\n    came_from = {}\n    g_score = {start: 0}\n\n    while not open_set.empty():\n        _, current = open_set.get()\n\n        if current == target_pos:\n            path = []\n            while current in came_from:\n                path.append(current)\n                current = came_from[current]\n            path.reverse()\n            actions = _convert_path_to_actions(path, start)\n            return actions\n\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            neighbor = (current[0] + dx, current[1] + dy)\n            if 0 <= neighbor[0] < env.world.WIDTH and 0 <= neighbor[1] < env.world.HEIGHT:\n                tentative_g_score = g_score[current] + 1\n                if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                    came_from[neighbor] = current\n                    g_score[neighbor] = tentative_g_score\n                    f_score = tentative_g_score + heuristic(neighbor, target_pos)\n                    open_set.put((f_score, neighbor))\n\n    return []\n\n  def _convert_path_to_actions(path, start):\n      actions = []\n      cx, cy = start\n      \n      for x, y in path:\n          if cx < x:\n              actions.append(craft.RIGHT)\n          elif cx > x:\n              actions.append(craft.LEFT)\n          if cy < y:\n              actions.append(craft.DOWN)\n          elif cy > y:\n              actions.append(craft.UP)\n          cx, cy = x, y\n      \n      return actions\n\n  def _has_required_primitives(primitive_indices):\n      for i in primitive_indices:\n          if env._current_state.inventory[i] <= 0:\n              return False\n      return True\n\n  def _collect_primitive(primitive_index):\n    start = env._current_state.pos\n    goal = None\n    \n    # Find the nearest primitive position\n    for dx in range(-env.world.WIDTH, env.world.WIDTH + 1):\n        for dy in range(-env.world.HEIGHT, env.world.HEIGHT + 1):\n            target_pos = (start[0] + dx, start[1] + dy)\n            if 0 <= target_pos[0] < env.world.WIDTH and 0 <= target_pos[1] < env.world.HEIGHT:\n                if np.any(env._current_state.grid[target_pos[0], target_pos[1]] == primitive_index):\n                    goal = target_pos\n                    break\n        if goal is not None:\n            break\n    \n    if goal is None:\n        return []\n    \n    # Move to the nearest primitive and collect it\n    actions_to_primitive = _move_to_position(goal)\n    actions_to_primitive.append(craft.USE)  # Add USE action to collect the primitive\n    return actions_to_primitive\n\n  index = env.world.cookbook.index\n  item_index = index[item]\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n\n  if \"_key\" in recipe:\n      key_index = recipe[\"_key\"]\n      workshop_index = env.world.workshop_indices[key_index]\n      \n      # Collect all required primitives\n      actions = []\n      for primitive_index in [i for i in recipe if i != \"_key\"]:\n          while not _has_required_primitives([primitive_index]):\n              actions.extend(_collect_primitive(primitive_index))\n          \n          # Check again after collecting to ensure we have enough\n          if not _has_required_primitives([primitive_index]):\n              return []  # If still missing, return failure\n\n      # Find all positions of the required workshop\n      workshop_positions = []\n      for x in range(env.world.WIDTH):\n          for y in range(env.world.HEIGHT):\n              if np.any(env._current_state.grid[x, y] == workshop_index):\n                  workshop_positions.append((x, y))\n      \n      if not workshop_positions:\n          return []  # No workshops found\n      \n      # Move to the nearest workshop\n      actions_to_workshop = None\n      closest_distance = float('inf')\n      \n      for wp in workshop_positions:\n          distance = abs(wp[0] - env._current_state.pos[0]) + abs(wp[1] - env._current_state.pos[1])\n          if distance < closest_distance:\n              actions_to_workshop = _move_to_position(wp)\n              closest_distance = distance\n      \n      # Ensure the agent is facing the correct direction to use the workshop\n      target_pos = None\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          neighbor_pos = (env._current_state.pos[0] + dx, env._current_state.pos[1] + dy)\n          if 0 <= neighbor_pos[0] < env.world.WIDTH and 0 <= neighbor_pos[1] < env.world.HEIGHT:\n              if np.any(env._current_state.grid[neighbor_pos[0], neighbor_pos[1]] == workshop_index):\n                  target_pos = neighbor_pos\n                  break\n      \n      if not target_pos:\n          return []  # No valid target position found\n      \n      direction_to_target = (target_pos[0] - env._current_state.pos[0], target_pos[1] - env._current_state.pos[1])\n      \n      if direction_to_target == (-1, 0):\n          actions_to_workshop.append(craft.LEFT)\n      elif direction_to_target == (1, 0):\n          actions_to_workshop.append(craft.RIGHT)\n      elif direction_to_target == (0, -1):\n          actions_to_workshop.append(craft.UP)\n      elif direction_to_target == (0, 1):\n          actions_to_workshop.append(craft.DOWN)\n      \n      # Finally, add the USE action\n      actions.extend(actions_to_workshop + [craft.USE])\n      return actions\n  \n  else:\n      return []  # No recipe found for the item", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T15:25:53.088917", "function_name": "craft", "function_body": "  def _move_to_position(target_pos):\n    start = env._current_state.pos\n\n    def heuristic(a, b):\n        return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n    open_set = collections.PriorityQueue()\n    open_set.put((0, start))\n    came_from = {}\n    g_score = {start: 0}\n\n    while not open_set.empty():\n        _, current = open_set.get()\n\n        if current == target_pos:\n            path = []\n            while current in came_from:\n                path.append(current)\n                current = came_from[current]\n            path.reverse()\n            actions = _convert_path_to_actions(path, start)\n            return actions\n\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            neighbor = (current[0] + dx, current[1] + dy)\n            if 0 <= neighbor[0] < env.world.WIDTH and 0 <= neighbor[1] < env.world.HEIGHT:\n                tentative_g_score = g_score[current] + 1\n                if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                    came_from[neighbor] = current\n                    g_score[neighbor] = tentative_g_score\n                    f_score = tentative_g_score + heuristic(neighbor, target_pos)\n                    open_set.put((f_score, neighbor))\n\n    return []\n\n  def _convert_path_to_actions(path, start):\n    actions = []\n    cx, cy = start\n\n    for x, y in path:\n        if cx < x:\n            actions.append(craft.RIGHT)\n        elif cx > x:\n            actions.append(craft.LEFT)\n        if cy < y:\n            actions.append(craft.DOWN)\n        elif cy > y:\n            actions.append(craft.UP)\n        cx, cy = x, y\n\n    return actions\n\n  def _collect_primitive(primitive_index):\n    start = env._current_state.pos\n    goal = None\n\n    # Find the nearest primitive\n    for dx in range(-env.world.WIDTH, env.world.WIDTH + 1):\n        for dy in range(-env.world.HEIGHT, env.world.HEIGHT + 1):\n            target_pos = (start[0] + dx, start[1] + dy)\n            if 0 <= target_pos[0] < env.world.WIDTH and 0 <= target_pos[1] < env.world.HEIGHT:\n                if np.any(env._current_state.grid[target_pos[0], target_pos[1]] == primitive_index):\n                    goal = target_pos\n                    break\n        if goal is not None:\n            break\n\n    if goal is None:\n        return []\n\n    # Move to the nearest primitive using A* search\n    actions_to_primitive = _move_to_position(goal)\n    \n    # Ensure the agent is facing the correct direction to use the primitive\n    target_pos = (goal[0], goal[1])\n    direction_to_target = (target_pos[0] - env._current_state.pos[0], target_pos[1] - env._current_state.pos[1])\n\n    if direction_to_target == (-1, 0):\n        actions_to_primitive.append(craft.LEFT)\n    elif direction_to_target == (1, 0):\n        actions_to_primitive.append(craft.RIGHT)\n    elif direction_to_target == (0, -1):\n        actions_to_primitive.append(craft.UP)\n    elif direction_to_target == (0, 1):\n        actions_to_primitive.append(craft.DOWN)\n\n    # Finally, add the USE action\n    actions_to_primitive.append(craft.USE)\n    return actions_to_primitive\n\n  def _has_required_primitives(primitive_indices):\n      for i in primitive_indices:\n          if env._current_state.inventory[i] <= 0:\n              return False\n      return True\n\n  index = env.world.cookbook.index\n  item_index = index[item]\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n\n  actions = []\n\n  # Check if the recipe exists and has a key\n  if \"_key\" in recipe:\n    key_index = recipe[\"_key\"]\n    workshop_index = env.world.workshop_indices[key_index]\n\n    # Collect all required primitives\n    for primitive_index in [i for i in recipe if i != \"_key\"]:\n        while not _has_required_primitives([primitive_index]):\n            actions.extend(_collect_primitive(primitive_index))\n        \n        # Check again after collecting to ensure we have enough\n        if not _has_required_primitives([primitive_index]):\n            return []  # If still missing, return failure\n\n    # Find all positions of the required workshop\n    workshop_positions = []\n    for x in range(env.world.WIDTH):\n        for y in range(env.world.HEIGHT):\n            if np.any(env._current_state.grid[x, y] == workshop_index):\n                workshop_positions.append((x, y))\n\n    if not workshop_positions:\n        return []  # No workshops found\n\n    # Move to the nearest workshop\n    actions_to_workshop = None\n    closest_distance = float('inf')\n\n    for wp in workshop_positions:\n        distance = abs(wp[0] - env._current_state.pos[0]) + abs(wp[1] - env._current_state.pos[1])\n        if distance < closest_distance:\n            actions_to_workshop = _move_to_position(wp)\n            closest_distance = distance\n\n    # Ensure the agent is facing the correct direction to use the workshop\n    target_pos = None\n    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor_pos = (env._current_state.pos[0] + dx, env._current_state.pos[1] + dy)\n        if 0 <= neighbor_pos[0] < env.world.WIDTH and 0 <= neighbor_pos[1] < env.world.HEIGHT:\n            if np.any(env._current_state.grid[neighbor_pos[0], neighbor_pos[1]] == workshop_index):\n                target_pos = neighbor_pos\n                break\n\n    if not target_pos:\n        return []  # No valid target position found\n\n    direction_to_target = (target_pos[0] - env._current_state.pos[0], target_pos[1] - env._current_state.pos[1])\n\n    if direction_to_target == (-1, 0):\n        actions_to_workshop.append(craft.LEFT)\n    elif direction_to_target == (1, 0):\n        actions_to_workshop.append(craft.RIGHT)\n    elif direction_to_target == (0, -1):\n        actions_to_workshop.append(craft.UP)\n    elif direction_to_target == (0, 1):\n        actions_to_workshop.append(craft.DOWN)\n\n    # Finally, add the USE action\n    actions_to_workshop.append(craft.USE)\n    return actions_to_workshop\n\n  else:\n      return []  # No recipe found for the item", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T15:29:41.865320", "function_name": "craft", "function_body": "  def astar(start, goal, grid_shape):\n    open_set = collections.PriorityQueue()\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, goal)}\n\n    open_set.put((f_score[start], start))\n\n    while not open_set.empty():\n        _, current = open_set.get()\n\n        if current == goal:\n            return reconstruct_path(came_from, current)\n\n        for neighbor in neighbors(current, grid_shape):\n            tentative_g_score = g_score[current] + 1\n\n            if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                came_from[neighbor] = current\n                g_score[neighbor] = tentative_g_score\n                f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                open_set.put((f_score[neighbor], neighbor))\n\n    return []\n\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def neighbors(pos, grid_shape):\n      x, y = pos\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < grid_shape[0] and 0 <= ny < grid_shape[1]:\n              yield (nx, ny)\n\n  def reconstruct_path(came_from, current):\n      total_path = [current]\n      while current in came_from:\n          current = came_from[current]\n          total_path.append(current)\n      return total_path[::-1]\n\n  def get_current_direction(state):\n      # Assuming direction is represented as an integer (0: UP, 1: RIGHT, 2: DOWN, 3: LEFT)\n      directions = [(0, -1), (1, 0), (0, 1), (-1, 0)]\n      return directions[state.direction]\n\n  def rotate_towards(state, target_direction):\n      # Determine the action to rotate towards the target direction\n      current_direction = get_current_direction(state)\n\n      if current_direction == target_direction:\n          return None\n\n      clockwise_directions = [(0, -1), (1, 0), (0, 1), (-1, 0)]\n      counterclockwise_directions = [(0, -1), (-1, 0), (0, 1), (1, 0)]\n\n      if (clockwise_directions.index(target_direction) - clockwise_directions.index(current_direction)) % 4 == 1:\n          return env.world.cookbook.index[\"RIGHT\"]\n      else:\n          return env.world.cookbook.index[\"LEFT\"]\n\n  def move_towards(state, target_position):\n      current_position = state.pos\n      if current_position[0] < target_position[0]:\n          return env.world.cookbook.index[\"RIGHT\"]\n      elif current_position[0] > target_position[0]:\n          return env.world.cookbook.index[\"LEFT\"]\n      elif current_position[1] < target_position[1]:\n          return env.world.cookbook.index[\"DOWN\"]\n      else:\n          return env.world.cookbook.index[\"UP\"]\n\n  def navigate(state, target_position):\n      actions = []\n      while state.pos != target_position:\n          next_action = move_towards(state, target_position)\n          if next_action is not None:\n              actions.append(next_action)\n\n          # Rotate towards the target direction\n          current_direction = get_current_direction(state)\n          target_direction = np.array(target_position) - np.array(state.pos)\n          rotation_action = rotate_towards(state, tuple(target_direction))\n          if rotation_action is not None:\n              actions.append(rotation_action)\n\n          # Perform the move action to update the state's position\n          env.step(next_action)\n          state = env._current_state\n\n      return actions\n\n  goal_index = env.world.cookbook.index[item]\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n\n  if not required_primitives:\n      return [] # No recipe or no primitives needed, can't craft\n\n  for primitive, count in required_primitives.items():\n      if env._current_state.inventory[primitive] < count:\n          return [] # Not enough primitives to start crafting\n\n  workshop_index = None\n  for recipe_key, recipe in env.world.cookbook.recipes.items():\n      if \"_at\" in recipe and recipe[\"_at\"] == goal_index:\n          workshop_index = env.world.cookbook.index[recipe_key]\n          break\n\n  if workshop_index is None:\n      return [] # No suitable workshop found\n\n  target_pos = None\n  for x in range(env._current_state.grid.shape[0]):\n      for y in range(env._current_state.grid.shape[1]):\n          if env._current_state.grid[x, y, workshop_index] > 0:\n              target_pos = (x, y)\n              break\n      if target_pos is not None:\n          break\n\n  if target_pos is None:\n      return [] # No workshop is found\n\n  actions = []\n  path_to_workshop = astar(env._current_state.pos, target_pos, env._current_state.grid.shape)\n\n  for point in path_to_workshop[1:]: # Skip the starting point\n      actions.extend(navigate(env._current_state, point))\n\n  final_direction = tuple(np.array(target_pos) - np.array(path_to_workshop[-2]))\n  rotation_action = rotate_towards(env._current_state, final_direction)\n  if rotation_action is not None:\n      actions.append(rotation_action)\n\n  actions.append(env.world.cookbook.index[\"USE\"])\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T15:29:42.947787", "function_name": "craft", "function_body": "  def astar(start, goal, grid_shape):\n    # A* algorithm implementation\n    open_set = collections.PriorityQueue()\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, goal)}\n\n    open_set.put((f_score[start], start))\n\n    while not open_set.empty():\n        _, current = open_set.get()\n\n        if current == goal:\n            return reconstruct_path(came_from, current)\n\n        for neighbor in neighbors(current, grid_shape):\n            tentative_g_score = g_score[current] + 1\n\n            if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                came_from[neighbor] = current\n                g_score[neighbor] = tentative_g_score\n                f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                open_set.put((f_score[neighbor], neighbor))\n\n    return []\n\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def neighbors(pos, grid_shape):\n      x, y = pos\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < grid_shape[0] and 0 <= ny < grid_shape[1]:\n              yield (nx, ny)\n\n  def reconstruct_path(came_from, current):\n      total_path = [current]\n      while current in came_from:\n          current = came_from[current]\n          total_path.append(current)\n      return total_path[::-1]\n\n  def get_current_direction_from_state(state):\n    # Assuming we have a method to determine the agent's direction from state\n    return np.array([state.pos[0], state.pos[1]])\n\n  def is_facing_correct_direction(current_direction, target_direction):\n      return current_direction == target_direction\n\n  def rotate_towards_target_direction(current_direction, target_direction):\n      # Determine the rotation action to face the target direction\n      if current_direction == (0, -1) and target_direction == (-1, 0):\n          return env.world.cookbook.index[\"LEFT\"]\n      elif current_direction == (0, -1) and target_direction == (1, 0):\n          return env.world.cookbook.index[\"RIGHT\"]\n      elif current_direction == (0, 1) and target_direction == (-1, 0):\n          return env.world.cookbook.index[\"RIGHT\"]\n      elif current_direction == (0, 1) and target_direction == (1, 0):\n          return env.world.cookbook.index[\"LEFT\"]\n      elif current_direction == (-1, 0) and target_direction == (0, -1):\n          return env.world.cookbook.index[\"RIGHT\"]\n      elif current_direction == (-1, 0) and target_direction == (0, 1):\n          return env.world.cookbook.index[\"LEFT\"]\n      elif current_direction == (1, 0) and target_direction == (0, -1):\n          return env.world.cookbook.index[\"LEFT\"]\n      elif current_direction == (1, 0) and target_direction == (0, 1):\n          return env.world.cookbook.index[\"RIGHT\"]\n\n      # If already facing the correct direction\n      return None\n\n  def get_rotated_direction(current_direction, rotation_action):\n      if rotation_action == env.world.cookbook.index[\"RIGHT\"]:\n          directions = [(0, -1), (1, 0), (0, 1), (-1, 0)]\n      elif rotation_action == env.world.cookbook.index[\"LEFT\"]:\n          directions = [(0, -1), (-1, 0), (0, 1), (1, 0)]\n\n      current_index = directions.index(current_direction)\n      new_index = (current_index + 1) % len(directions)\n\n      return directions[new_index]\n\n  goal_index = env.world.cookbook.index[item]\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n\n  actions = []\n\n  if not required_primitives:\n    return [] # No recipe or no primitives needed, can't craft\n\n  # Check if all required primitives are already in inventory\n  for primitive, count in required_primitives.items():\n    if env._current_state.inventory[primitive] < count:\n      return [] # Not enough primitives to start crafting\n\n  # Find the workshop where we need to go to craft this item\n  workshop_index = None\n  for recipe_key, recipe in env.world.cookbook.recipes.items():\n    if \"_at\" in recipe and recipe[\"_at\"] == goal_index:\n      workshop_index = env.world.cookbook.index[recipe_key]\n      break\n\n  # Check if the required workshop exists\n  if workshop_index is None:\n    return [] # No suitable workshop found\n  \n  # Navigate to the closest workshop\n  target_pos = None\n  for x in range(env._current_state.grid.shape[0]):\n    for y in range(env._current_state.grid.shape[1]):\n      if env._current_state.grid[x, y, workshop_index] > 0:\n        target_pos = (x, y)\n        break\n    if target_pos is not None:\n      break\n  \n  # If no workshop is found, return an empty list\n  if target_pos is None:\n    return []\n\n  # Simple pathfinding to the workshop using A* algorithm\n  start_pos = env._current_state.pos\n  path = astar(start_pos, target_pos, env._current_state.grid.shape)\n\n  # Convert path into actions\n  if path:\n      for i in range(len(path) - 1):\n          dx = path[i + 1][0] - path[i][0]\n          dy = path[i + 1][1] - path[i][1]\n\n          if dx == 0 and dy == -1:\n              actions.append(env.world.cookbook.index[\"UP\"])\n          elif dx == 0 and dy == 1:\n              actions.append(env.world.cookbook.index[\"DOWN\"])\n          elif dx == -1 and dy == 0:\n              actions.append(env.world.cookbook.index[\"LEFT\"])\n          elif dx == 1 and dy == 0:\n              actions.append(env.world.cookbook.index[\"RIGHT\"])\n\n      # Orient the agent towards the workshop before using it\n      target_direction = np.array(target_pos) - np.array(path[-2])\n      current_direction = get_current_direction_from_state(env._current_state)\n\n      while not is_facing_correct_direction(current_direction, target_direction):\n          rotation_action = rotate_towards_target_direction(current_direction, target_direction)\n          if rotation_action:\n              actions.append(rotation_action)\n              current_direction = get_rotated_direction(current_direction, rotation_action)\n\n  # Use action to craft the item at the workshop\n  actions.append(env.world.cookbook.index[\"USE\"])\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T15:32:26.429273", "function_name": "craft", "function_body": "  def move_to_position(target_pos):\n    current_pos = np.array(env._current_state.pos)\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    actions = []\n    if dx > 0:\n      actions.extend([craft.MOVE_RIGHT for _ in range(dx)])\n    elif dx < 0:\n      actions.extend([craft.MOVE_LEFT for _ in range(-dx)])\n\n    if dy > 0:\n      actions.extend([craft.MOVE_DOWN for _ in range(dy)])\n    elif dy < 0:\n      actions.extend([craft.MOVE_UP for _ in range(-dy)])\n\n    return actions\n\n  def rotate_to_direction(target_dir):\n    current_dir = env._current_state.dir\n    actions = []\n\n    while current_dir != target_dir:\n        if (target_dir - current_dir) % 4 == 1:\n            actions.append(craft.TURN_RIGHT)\n            current_dir = (current_dir + 1) % 4\n        elif (target_dir - current_dir) % 4 == 2:\n            actions.extend([craft.TURN_RIGHT, craft.TURN_RIGHT])\n            current_dir = (current_dir + 2) % 4\n        elif (target_dir - current_dir) % 4 == 3:\n            actions.append(craft.TURN_LEFT)\n            current_dir = (current_dir - 1) % 4\n\n    return actions\n\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = env._current_state.inventory.copy()\n\n  # Check if all ingredients are available\n  required_ingredients = {cookbook.index[k]: v for k, v in recipe.items()}\n\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if not can_craft:\n    return []\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No available workshop to craft item\")\n\n  # Select the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n  # Calculate actions to move the agent to the nearest workshop\n  actions_to_take = move_to_position(nearest_workshop_pos)\n\n  # Rotate the agent to face the workshop\n  target_direction = None\n  dx, dy = nearest_workshop_pos[0] - current_position[0], nearest_workshop_pos[1] - current_position[1]\n\n  if abs(dx) > abs(dy):\n      target_direction = craft.RIGHT if dx > 0 else craft.LEFT\n  elif abs(dy) > abs(dx):\n      target_direction = craft.DOWN if dy > 0 else craft.UP\n\n  actions_to_take.extend(rotate_to_direction(target_direction))\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T15:32:27.516247", "function_name": "craft", "function_body": "  def move_to_position(current_pos, target_pos):\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    actions = []\n    \n    if dy < 0:  # Move up\n        actions.extend([craft.MOVE_UP for _ in range(-dy)])\n    elif dy > 0:  # Move down\n        actions.extend([craft.MOVE_DOWN for _ in range(dy)])\n\n    if dx < 0:  # Move left\n        actions.extend([craft.MOVE_LEFT for _ in range(-dx)])\n    elif dx > 0:  # Move right\n        actions.extend([craft.MOVE_RIGHT for _ in range(dx)])\n    \n    return actions\n\n  def rotate_to_direction(current_dir, target_dir):\n    actions = []\n    while current_dir != target_dir:\n        if (target_dir - current_dir) % 4 == 1:\n            actions.append(craft.TURN_RIGHT)\n            current_dir = (current_dir + 1) % 4\n        elif (target_dir - current_dir) % 4 == 2:\n            actions.extend([craft.TURN_RIGHT, craft.TURN_RIGHT])\n            current_dir = (current_dir + 2) % 4\n        elif (target_dir - current_dir) % 4 == 3:\n            actions.append(craft.TURN_LEFT)\n            current_dir = (current_dir - 1) % 4\n\n    return actions\n\n  def get_target_direction(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if abs(dx) > abs(dy):\n          return craft.RIGHT if dx > 0 else craft.LEFT\n      elif abs(dy) > abs(dx):\n          return craft.DOWN if dy > 0 else craft.UP\n\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = env._current_state.inventory.copy()\n\n  # Check if all ingredients are available\n  required_ingredients = {cookbook.index[k]: v for k, v in recipe.items()}\n\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if not can_craft:\n    return []\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No available workshop to craft item\")\n\n  # Select the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n  # Calculate actions to move the agent to the nearest workshop\n  current_direction = env._current_state.dir\n\n  target_direction = get_target_direction(current_position, nearest_workshop_pos)\n\n  actions_to_take = []\n\n  if current_position != nearest_workshop_pos:\n    actions_to_take.extend(move_to_position(current_position, nearest_workshop_pos))\n\n    # Calculate the target direction to face the workshop\n    actions_to_take.extend(rotate_to_direction(current_direction, target_direction))\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T15:33:50.829340", "function_name": "craft", "function_body": "  def get_actions_to_collect_primitive(primitive):\n    actions = []\n    # Find position of the primitive on the grid\n    positions = np.argwhere(env._current_state.grid[:, :, primitive] == 1)\n    if len(positions) == 0:\n      return None  # No primitive found, cannot collect\n\n    # Navigate to the closest primitive\n    pos_agent = env._current_state.pos\n    distances = np.linalg.norm(positions - pos_agent, axis=1)\n    closest_primitive_pos = positions[np.argmin(distances)]\n    \n    actions += navigate_to(env._current_state, closest_primitive_pos)\n\n    # Collect the primitive (USE action facing it)\n    actions.append(craft.USE)\n    return actions\n\n  def get_actions_to_craft_item(item):\n    actions = []\n    # Check if we have all required ingredients and navigate to collect them\n    goal_index = env.world.cookbook.index[item]\n    recipe = env.world.cookbook.recipes[goal_index]\n    \n    for ingredient, count in recipe.items():\n      if ingredient == \"_at\":\n        continue  # Skip workshop location information\n\n      ingredient_index = env.world.cookbook.index.get(ingredient)\n      if ingredient_index is None:\n        return None  # Required primitive not found in the cookbook\n      \n      while np.sum(env._current_state.inventory[ingredient_index]) < count:\n        actions_for_primitive = get_actions_to_collect_primitive(ingredient_index)\n        if actions_for_primitive is None:\n          return None\n        actions += actions_for_primitive\n\n    # Navigate to the workshop specified in the recipe\n    workshop_name = recipe[\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n    positions_workshops = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    \n    if len(positions_workshops) == 0:\n      return None  # Workshop not found in the grid\n    \n    closest_workshop_pos = positions_workshops[np.argmin(np.linalg.norm(positions_workshops - env._current_state.pos, axis=1))]\n    \n    actions += navigate_to(env._current_state, closest_workshop_pos)\n\n    # Craft the item (USE action facing it)\n    actions.append(craft.USE)\n    return actions\n\n  def navigate_to(current_state, target_pos):\n    pos_agent = current_state.pos\n    actions = []\n    if pos_agent[0] < target_pos[0]:\n      actions.extend([craft.RIGHT] * (target_pos[0] - pos_agent[0]))\n    elif pos_agent[0] > target_pos[0]:\n      actions.extend([craft.LEFT] * (pos_agent[0] - target_pos[0]))\n\n    if pos_agent[1] < target_pos[1]:\n      actions.extend([craft.DOWN] * (target_pos[1] - pos_agent[1]))\n    elif pos_agent[1] > target_pos[1]:\n      actions.extend([craft.UP] * (pos_agent[1] - target_pos[1]))\n\n    return actions\n\n  item_index = env.world.cookbook.index.get(item)\n  if item_index is None:\n    return []  # Item not found in the cookbook\n\n  actions_to_craft = get_actions_to_craft_item(item_index)\n  if actions_to_craft is None:\n    return []  # Cannot craft due to missing ingredients or workshop\n\n  return actions_to_craft", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-10T15:33:51.805690", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index for the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the ingredients required to craft the item\n  ingredients_needed = env.world.cookbook.primitives_for(item_index)\n  \n  for ingredient, count in ingredients_needed.items():\n    while env._current_state.inventory[ingredient] < count:\n      actions.extend(collect_v2(env, ingredient))\n    \n    # Check if we can craft the item now that we have all the ingredients\n    workshop_index = None\n    for recipe_output, recipe_info in env.world.cookbook.recipes.items():\n      if recipe_output == item_index:\n        workshop_index = recipe_info[\"_key\"]\n        break\n    \n    if workshop_index is not None:\n      # Find a nearby workshop of the required type and move to it\n      actions.extend(find_workshop_v2(env, workshop_index))\n      \n      # Perform USE action at the workshop\n      actions.append(4)  # Assuming USE action index is 4\n      \n      break\n  \n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-10T15:34:50.413199", "function_name": "craft", "function_body": "  # Convert item name to index using the cookbook's index\n  goal_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the primitives needed for crafting\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  current_inventory = env._current_state.inventory\n\n  # Calculate missing primitives\n  actions_to_take = []\n  for primitive, count in required_primitives.items():\n    if current_inventory[primitive] < count:\n      # Collect the needed number of primitives\n      actions_to_take.extend(collect_v2(env, env.world.cookbook.index.get(env.world.cookbook.index.get(primitive))))\n  \n  # Find workshop index and position for crafting\n  recipe = env.world.cookbook.recipes[goal_index]\n  workshop_index = None\n  for ingredient in recipe:\n      if ingredient == \"_at\":\n          workshop_name = recipe[ingredient]\n          workshop_index = env.world.workshop_indices[env.world.cookbook.index.get(workshop_name)]\n  \n  # Navigate to the workshop position and craft the item\n  workshop_position = find_workshop_position(env, workshop_index)\n  navigate_to(env, workshop_position)\n\n  # Use action at the workshop to craft the item\n  actions_to_take.append(craft.CRAFT_FUNC[env.world.cookbook.index.get(item)])\n\n  return actions_to_take", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-10T15:34:51.419596", "function_name": "craft", "function_body": "  # Initialize actions list\n  actions = []\n\n  # Get the index of the desired item from the cookbook\n  goal_index = env.world.cookbook.index[item]\n\n  # Check if the goal item can be crafted (i.e., it has a recipe)\n  if goal_index not in env.world.cookbook.recipes:\n    return actions  # No recipe for this item, return empty list\n\n  # Get the recipe for the desired item\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  # Collect all required primitives and intermediate items\n  for ingredient, count in recipe.items():\n    if ingredient == \"_key\":  # Skip the key field which specifies the workshop\n      continue\n\n    ingredient_index = env.world.cookbook.index.get(ingredient)\n    while np.sum(env._current_state.inventory[ingredient_index]) < count:\n      actions.extend(collect_v2(env, ingredient))\n\n  # Once all ingredients are collected, proceed to craft the item\n  workshop = recipe[\"_key\"]\n  workshop_index = env.world.cookbook.index.get(workshop)\n\n  if not workshop_index or workshop_index not in env.world.workshop_indices:\n    return actions  # Invalid workshop specified, return empty list\n\n  # Find a position adjacent to the workshop and face it\n  workshop_pos = None\n  for pos in env.world.workshop_indices:\n    if env._current_state.grid[pos].nonzero()[0][0] == workshop_index:\n      workshop_pos = pos\n      break\n\n  if not workshop_pos:\n    return actions  # Workshop position not found, return empty list\n\n  # Navigate to the workshop\n  path_to_workshop = find_path(env._current_state, workshop_pos)\n  actions.extend(path_to_workshop)\n\n  # Face the workshop and use the USE action to craft the item\n  direction = get_direction(env._current_state.pos, workshop_pos)\n  actions.append(direction)\n  actions.append(craft.USE)\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-10T15:35:28.367428", "function_name": "craft", "function_body": "  actions = []\n\n  # Get the index of the goal item\n  i_goal = env.world.cookbook.index[item]\n\n  # Check if the inventory already has the required item\n  if env._current_state.inventory[i_goal] > 0:\n    return actions\n\n  # Find out what primitives are needed to craft this item\n  required_primitives = env.world.cookbook.primitives_for(i_goal)\n\n  for primitive, count in required_primitives.items():\n    while env._current_state.inventory[primitive] < count:\n      # Collect the required primitive\n      actions.extend(collect(env, env.world.cookbook.index.get(primitive)))\n\n  # Get workshop info for the item\n  recipe = env.world.cookbook.recipes[i_goal]\n  workshop_index = None\n  if \"_at\" in recipe:\n    workshop_name = recipe[\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Navigate to the workshop and use it to craft the item\n  if workshop_index is not None:\n      actions.extend(navigate_to_workshop(env, workshop_index))\n      actions.append(craft.ACTION_USE)\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-10T15:35:29.326073", "function_name": "craft", "function_body": "  # Get the cookbook and index from the environment\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  \n  # Convert item name to its corresponding index\n  goal_index = index[item]\n  \n  # Check if the goal is a primitive or an environment object, which cannot be crafted\n  if goal_index in cookbook.environment:\n    return []\n\n  # Get the list of primitives needed for crafting the item\n  required_primitives = cookbook.primitives_for(goal_index)\n  \n  actions = []\n  \n  # Collect all required primitives\n  for primitive_index, count in required_primitives.items():\n    primitive_name = index.get(primitive_index)\n    if not primitive_name:\n      continue\n    \n    # Find the position of the primitive on the grid\n    pos = find_primitive_position(env._current_state.grid, primitive_index)\n    \n    # If the primitive is not found, return an empty action list\n    if pos is None:\n      return []\n    \n    # Get actions to move to the primitive and collect it\n    move_actions = get_move_to_position_actions(env._current_state, pos)\n    actions.extend(move_actions + [craft.COLLECT_FUNC(primitive_index)])\n  \n  # Move to the workshop specified in the recipe for crafting the item\n  workshop_index = cookbook.recipes[goal_index][\"_key\"]\n  workshop_pos = find_workshop_position(env._current_state.grid, workshop_index)\n\n  if workshop_pos is None:\n    return []\n  \n  move_actions = get_move_to_position_actions(env._current_state, workshop_pos)\n  actions.extend(move_actions + [craft.USE_FUNC()])\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-10T15:38:48.663727", "function_name": "craft", "function_body": "  def astar(start, goal, grid_shape):\n    # A* algorithm implementation\n    open_set = collections.PriorityQueue()\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, goal)}\n\n    open_set.put((f_score[start], start))\n\n    while not open_set.empty():\n        _, current = open_set.get()\n\n        if current == goal:\n            return reconstruct_path(came_from, current)\n\n        for neighbor in neighbors(current, grid_shape):\n            tentative_g_score = g_score[current] + 1\n\n            if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                came_from[neighbor] = current\n                g_score[neighbor] = tentative_g_score\n                f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                open_set.put((f_score[neighbor], neighbor))\n\n    return []\n\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def neighbors(pos, grid_shape):\n      x, y = pos\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < grid_shape[0] and 0 <= ny < grid_shape[1]:\n              yield (nx, ny)\n\n  def reconstruct_path(came_from, current):\n      total_path = [current]\n      while current in came_from:\n          current = came_from[current]\n          total_path.append(current)\n      return total_path[::-1]\n\n  def get_current_direction(state):\n    return state.dir\n\n  def rotate_towards_target_direction(current_dir, target_dir):\n      if current_dir == (0, -1) and target_dir == (-1, 0):\n          return env.world.cookbook.index[\"LEFT\"]\n      elif current_dir == (0, -1) and target_dir == (1, 0):\n          return env.world.cookbook.index[\"RIGHT\"]\n      elif current_dir == (0, 1) and target_dir == (-1, 0):\n          return env.world.cookbook.index[\"RIGHT\"]\n      elif current_dir == (0, 1) and target_dir == (1, 0):\n          return env.world.cookbook.index[\"LEFT\"]\n      elif current_dir == (-1, 0) and target_dir == (0, -1):\n          return env.world.cookbook.index[\"RIGHT\"]\n      elif current_dir == (-1, 0) and target_dir == (0, 1):\n          return env.world.cookbook.index[\"LEFT\"]\n      elif current_dir == (1, 0) and target_dir == (0, -1):\n          return env.world.cookbook.index[\"LEFT\"]\n      elif current_dir == (1, 0) and target_dir == (0, 1):\n          return env.world.cookbook.index[\"RIGHT\"]\n\n      # If already facing the correct direction\n      return None\n\n  def get_rotated_direction(current_dir, rotation_action):\n      if rotation_action == env.world.cookbook.index[\"RIGHT\"]:\n          directions = [(0, -1), (1, 0), (0, 1), (-1, 0)]\n      elif rotation_action == env.world.cookbook.index[\"LEFT\"]:\n          directions = [(0, -1), (-1, 0), (0, 1), (1, 0)]\n\n      current_index = directions.index(current_dir)\n      new_index = (current_index + 1) % len(directions)\n\n      return directions[new_index]\n\n  goal_index = env.world.cookbook.index[item]\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n\n  actions = []\n\n  if not required_primitives:\n    return [] # No recipe or no primitives needed, can't craft\n\n  # Check if all required primitives are already in inventory\n  for primitive, count in required_primitives.items():\n    if env._current_state.inventory[primitive] < count:\n      return [] # Not enough primitives to start crafting\n  \n  # Find the workshop where we need to go to craft this item\n  workshop_index = None\n  for recipe_key, recipe in env.world.cookbook.recipes.items():\n    if \"_at\" in recipe and recipe[\"_at\"] == goal_index:\n      workshop_index = env.world.cookbook.index[recipe_key]\n      break\n\n  # Check if the required workshop exists\n  if workshop_index is None:\n    return [] # No suitable workshop found\n  \n  # Navigate to the closest workshop\n  target_pos = None\n  for x in range(env._current_state.grid.shape[0]):\n    for y in range(env._current_state.grid.shape[1]):\n      if env._current_state.grid[x, y, workshop_index] > 0:\n        target_pos = (x, y)\n        break\n    if target_pos is not None:\n      break\n  \n  # If no workshop is found, return an empty list\n  if target_pos is None:\n    return []\n\n  # Simple pathfinding to the workshop using A* algorithm\n  start_pos = env._current_state.pos\n  path = astar(start_pos, target_pos, env._current_state.grid.shape)\n\n  # Convert path into actions\n  if path:\n      for i in range(len(path) - 1):\n          dx = path[i + 1][0] - path[i][0]\n          dy = path[i + 1][1] - path[i][1]\n\n          if dx == 0 and dy == -1:\n              actions.append(env.world.cookbook.index[\"UP\"])\n          elif dx == 0 and dy == 1:\n              actions.append(env.world.cookbook.index[\"DOWN\"])\n          elif dx == -1 and dy == 0:\n              actions.append(env.world.cookbook.index[\"LEFT\"])\n          elif dx == 1 and dy == 0:\n              actions.append(env.world.cookbook.index[\"RIGHT\"])\n\n      # Orient the agent towards the workshop before using it\n      target_direction = np.array(target_pos) - np.array(path[-2])\n      current_direction = get_current_direction(env._current_state)\n\n      while not is_facing_correct_direction(current_direction, target_direction):\n          rotation_action = rotate_towards_target_direction(current_direction, target_direction)\n          if rotation_action:\n              actions.append(rotation_action)\n              current_direction = get_rotated_direction(current_direction, rotation_action)\n\n  # Use action to craft the item at the workshop\n  actions.append(env.world.cookbook.index[\"USE\"])\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T15:38:49.722254", "function_name": "craft", "function_body": "  # Helper functions\n  def astar(start, goal, grid_shape):\n      open_set = collections.PriorityQueue()\n      came_from = {}\n      g_score = {start: 0}\n      f_score = {start: heuristic(start, goal)}\n\n      open_set.put((f_score[start], start))\n\n      while not open_set.empty():\n          _, current = open_set.get()\n\n          if current == goal:\n              return reconstruct_path(came_from, current)\n\n          for neighbor in neighbors(current, grid_shape):\n              tentative_g_score = g_score[current] + 1\n\n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                  open_set.put((f_score[neighbor], neighbor))\n\n      return []\n\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def neighbors(pos, grid_shape):\n      x, y = pos\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < grid_shape[0] and 0 <= ny < grid_shape[1]:\n              yield (nx, ny)\n\n  def reconstruct_path(came_from, current):\n      total_path = [current]\n      while current in came_from:\n          current = came_from[current]\n          total_path.append(current)\n      return total_path[::-1]\n\n  def get_current_direction(state):\n      # Assuming state has a direction attribute or can be inferred\n      return state.dir\n\n  def rotate_towards_target(current_dir, target_dir):\n      if current_dir == (0, -1) and target_dir == (-1, 0):  # UP -> LEFT\n          return env.world.cookbook.index[\"LEFT\"]\n      elif current_dir == (0, -1) and target_dir == (1, 0):  # UP -> RIGHT\n          return env.world.cookbook.index[\"RIGHT\"]\n      elif current_dir == (0, 1) and target_dir == (-1, 0):   # DOWN -> LEFT\n          return env.world.cookbook.index[\"LEFT\"]\n      elif current_dir == (0, 1) and target_dir == (1, 0):    # DOWN -> RIGHT\n          return env.world.cookbook.index[\"RIGHT\"]\n      elif current_dir == (-1, 0) and target_dir == (0, -1):  # LEFT -> UP\n          return env.world.cookbook.index[\"UP\"]\n      elif current_dir == (-1, 0) and target_dir == (0, 1):   # LEFT -> DOWN\n          return env.world.cookbook.index[\"DOWN\"]\n      elif current_dir == (1, 0) and target_dir == (0, -1):   # RIGHT -> UP\n          return env.world.cookbook.index[\"UP\"]\n      elif current_dir == (1, 0) and target_dir == (0, 1):    # RIGHT -> DOWN\n          return env.world.cookbook.index[\"DOWN\"]\n      else:\n          return None\n\n  def move_to_target(state, target_pos):\n      actions = []\n      path = astar(state.pos, target_pos, state.grid.shape)\n      \n      if not path:\n          return []\n\n      for i in range(len(path) - 1):\n          dx = path[i + 1][0] - path[i][0]\n          dy = path[i + 1][1] - path[i][1]\n\n          if dx == 0 and dy == -1:  # Move UP\n              actions.append(env.world.cookbook.index[\"UP\"])\n          elif dx == 0 and dy == 1:   # Move DOWN\n              actions.append(env.world.cookbook.index[\"DOWN\"])\n          elif dx == -1 and dy == 0:  # Move LEFT\n              actions.append(env.world.cookbook.index[\"LEFT\"])\n          elif dx == 1 and dy == 0:   # Move RIGHT\n              actions.append(env.world.cookbook.index[\"RIGHT\"])\n\n      return actions\n\n  def orient_towards_target(state, target_pos):\n      current_dir = get_current_direction(state)\n      target_dir = tuple(np.array(target_pos) - np.array(state.pos))\n      \n      rotations = []\n      while not is_facing_correct_direction(current_dir, target_dir):\n          rotation_action = rotate_towards_target(current_dir, target_dir)\n          if rotation_action:\n              rotations.append(rotation_action)\n              current_dir = get_rotated_direction(current_dir, rotation_action)\n\n      return rotations\n\n  def is_facing_correct_direction(current_dir, target_dir):\n      # Assuming target_dir is a unit vector\n      return current_dir == target_dir\n\n  def get_rotated_direction(current_dir, rotation_action):\n      if rotation_action == env.world.cookbook.index[\"UP\"]:\n          directions = [(0, -1), (-1, 0), (0, 1), (1, 0)]\n      elif rotation_action == env.world.cookbook.index[\"DOWN\"]:\n          directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n      elif rotation_action == env.world.cookbook.index[\"LEFT\"]:\n          directions = [(-1, 0), (0, -1), (1, 0), (0, 1)]\n      elif rotation_action == env.world.cookbook.index[\"RIGHT\"]:\n          directions = [(1, 0), (0, 1), (-1, 0), (0, -1)]\n\n      current_index = directions.index(current_dir)\n      new_index = (current_index + 1) % len(directions)\n\n      return directions[new_index]\n\n  # Main logic\n  goal_index = env.world.cookbook.index[item]\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n\n  actions = []\n\n  if not required_primitives:\n      return []  # No recipe or no primitives needed, can't craft\n\n  # Check if all required primitives are already in inventory\n  for primitive, count in required_primitives.items():\n      if env._current_state.inventory[primitive] < count:\n          return []  # Not enough primitives to start crafting\n\n  # Find the workshop where we need to go to craft this item\n  workshop_index = None\n  for recipe_key, recipe in env.world.cookbook.recipes.items():\n      if \"_at\" in recipe and recipe[\"_at\"] == goal_index:\n          workshop_index = env.world.cookbook.index[recipe_key]\n          break\n\n  # Check if the required workshop exists\n  if workshop_index is None:\n      return []  # No suitable workshop found\n  \n  # Navigate to the closest workshop\n  target_pos = None\n  for x in range(env._current_state.grid.shape[0]):\n      for y in range(env._current_state.grid.shape[1]):\n          if env._current_state.grid[x, y, workshop_index] > 0:\n              target_pos = (x, y)\n              break\n      if target_pos is not None:\n          break\n  \n  # If no workshop is found, return an empty list\n  if target_pos is None:\n      return []\n\n  # Move to the target position\n  actions.extend(move_to_target(env._current_state, target_pos))\n\n  # Orient towards the target direction before using it\n  rotations = orient_towards_target(env._current_state, target_pos)\n  actions.extend(rotations)\n\n  # Use action to craft the item at the workshop\n  actions.append(env.world.cookbook.index[\"USE\"])\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T15:40:36.819881", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n\n  # Check if there's a recipe for this item\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the ingredients required to craft this item\n  recipe = env.world.cookbook.recipes[item_index]\n  ingredients_needed = {ingredient: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n\n  # Check if we have all the ingredients in our inventory\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  # Subtract the ingredients we already have from what's needed\n  for ingredient_index, count in inventory_dict.items():\n    if ingredient_index in ingredients_needed:\n      ingredients_needed[ingredient_index] -= count\n      if ingredients_needed[ingredient_index] <= 0:\n        del ingredients_needed[ingredient_index]\n\n  # If there are still ingredients needed, return an empty action list\n  if ingredients_needed:\n    return []\n\n  # Get the workshop index where this item needs to be crafted\n  workshop_name = recipe[\"_at\"]\n  workshop_index = getattr(env.world, f\"{workshop_name}_index\")\n\n  # Find the position of the nearest workshop in the grid\n  pos_x, pos_y = env._current_state.pos\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  \n  if not workshop_positions.size:\n    return []\n\n  # Calculate distances to each workshop and find the closest one\n  distances = [abs(x - pos_x) + abs(y - pos_y) for x, y in workshop_positions]\n  nearest_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n\n  # Determine actions to move to the nearest workshop\n  actions_to_move = []\n  target_x, target_y = nearest_workshop_pos\n\n  while (pos_x != target_x or pos_y != target_y):\n    if abs(target_x - pos_x) > abs(target_y - pos_y):\n      move_dir = \"RIGHT\" if target_x > pos_x else \"LEFT\"\n    else:\n      move_dir = \"DOWN\" if target_y > pos_y else \"UP\"\n\n    actions_to_move.append(env.world.N_ACTIONS[move_dir])\n    \n    # Simulate the movement to update current position\n    pos_x += 1 if move_dir == \"RIGHT\" else (-1 if move_dir == \"LEFT\" else 0)\n    pos_y += 1 if move_dir == \"DOWN\" else (-1 if move_dir == \"UP\" else 0)\n\n  # Add USE action to craft the item\n  actions_to_move.append(env.world.USE)\n\n  return actions_to_move", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T15:40:37.873348", "function_name": "craft", "function_body": "  def find_nearest_workshop(workshop_index):\n    pos_x, pos_y = env._current_state.pos\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    \n    if not workshop_positions.size:\n      return None\n\n    # Calculate distances to each workshop and find the closest one\n    distances = [abs(x - pos_x) + abs(y - pos_y) for x, y in workshop_positions]\n    nearest_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n    return nearest_workshop_pos\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if there's a recipe for this item\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the ingredients required to craft this item\n  recipe = env.world.cookbook.recipes[item_index]\n  ingredients_needed = {ingredient: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n\n  # Check if we have all the ingredients in our inventory\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  # Subtract the ingredients we already have from what's needed\n  for ingredient_index, count in inventory_dict.items():\n    if ingredient_index in ingredients_needed:\n      ingredients_needed[ingredient_index] -= count\n      if ingredients_needed[ingredient_index] <= 0:\n        del ingredients_needed[ingredient_index]\n\n  # If there are still ingredients needed, return an empty action list\n  if ingredients_needed:\n    return []\n\n  # Get the workshop index where this item needs to be crafted\n  workshop_name = recipe[\"_at\"]\n  workshop_index = getattr(env.world, f\"{workshop_name}_index\")\n\n  # Find the position of the nearest workshop in the grid\n  nearest_workshop_pos = find_nearest_workshop(workshop_index)\n  \n  if not nearest_workshop_pos:\n    return []\n\n  # Determine actions to move to the nearest workshop\n  actions_to_move = []\n  current_pos = env._current_state.pos\n\n  while current_pos != nearest_workshop_pos:\n    dx = nearest_workshop_pos[0] - current_pos[0]\n    dy = nearest_workshop_pos[1] - current_pos[1]\n\n    if abs(dx) > abs(dy):\n      move_dir = \"RIGHT\" if dx > 0 else \"LEFT\"\n    else:\n      move_dir = \"DOWN\" if dy > 0 else \"UP\"\n\n    actions_to_move.append(env.world.N_ACTIONS[move_dir])\n\n    # Simulate the movement to update current_pos\n    if move_dir == \"RIGHT\":\n      current_pos = (current_pos[0] + 1, current_pos[1])\n    elif move_dir == \"LEFT\":\n      current_pos = (current_pos[0] - 1, current_pos[1])\n    elif move_dir == \"DOWN\":\n      current_pos = (current_pos[0], current_pos[1] + 1)\n    elif move_dir == \"UP\":\n      current_pos = (current_pos[0], current_pos[1] - 1)\n\n  # Add USE action to craft the item\n  actions_to_move.append(env.world.USE)\n\n  return actions_to_move", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T15:41:11.481852", "function_name": "craft", "function_body": "  # Get the index for the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the recipe for the item\n  if item_index not in env.world.cookbook.recipes:\n    return []\n  \n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Check if we have all the required primitives\n  missing_primitives = {}\n  for ingredient, count in recipe.items():\n      if ingredient != \"_key\":\n          primitive_index = env.world.cookbook.index[ingredient]\n          if env._current_state.inventory[primitive_index] < count:\n              missing_primitives[ingredient] = count - env._current_state.inventory[primitive_index]\n\n  # If there are missing primitives, return an empty list\n  if missing_primitives:\n    return []\n  \n  # Otherwise, proceed to the workshop and craft the item\n  workshop_key = recipe[\"_key\"]\n  workshop_index = env.world.cookbook.index[workshop_key]\n  workshop_position = None\n\n  # Find the position of the required workshop in the grid\n  for i in range(env._current_state.grid.shape[0]):\n      for j in range(env._current_state.grid.shape[1]):\n          if env._current_state.grid[i, j, workshop_index] == 1:\n              workshop_position = (i, j)\n              break\n      if workshop_position is not None:\n          break\n\n  # If the workshop is not found, return an empty list\n  if workshop_position is None:\n    return []\n\n  # Calculate the actions to reach the workshop\n  actions_to_workshop = navigate(env, env._current_state.pos, workshop_position)\n\n  # Add the USE action at the workshop\n  actions_to_workshop.append(4)  # Assuming USE action index is 4\n\n  return actions_to_workshop", "island_id": 7, "scores": {"3": -1}}
