or(item_index)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  # If not all primitives are available return empty action list\n  if not has_all_primitives(required_primitives, inventory_dict):\n    return []\n  \n  # Find the workshop where we can craft this item\n  workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n      workshop_index = recipe.get(\"_at\")\n      break\n  \n  if workshop_index is None:\n    return []\n\n  # Find the position of the nearest workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(workshop_positions) == 0:\n    return []\n  \n  # Select the closest workshop (for simplicity, we take the first one found)\n  target_workshop_pos = tuple(min(workshop_positions, key=lambda x: abs(x[0] - env._current_state.pos[0]) + abs(x[1] - env._current_state.pos[1])))\n\n  # Navigate to the selected workshop\n  actions = navigate(env._current_state, target_workshop_pos)\n\n  # Turn towards the workshop if not already facing it\n  current_direction = env._current_state.dir\n  direction_to_workshop = turn_to_face(env._current_state, target_workshop_pos)\n  \n  # Check if we need to turn\n  while current_direction != direction_to_workshop:\n    actions.append(direction_to_workshop)\n    current_direction = (current_direction + 1) % 4\n\n  # Use the USE action to craft the item at the workshop\n  actions.append(4)  # Assuming 4 is the index for the USE action\n  \n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T13:21:19.547867", "function_name": "craft", "function_body": "  def navigate_to_workshop(workshop_pos):\n    agent_pos = env._current_state.pos\n    dx, dy = workshop_pos[0] - agent_pos[0], workshop_pos[1] - agent_pos[1]\n    actions = []\n    if dx < 0:\n      actions.append(2)  # LEFT\n    elif dx > 0:\n      actions.append(3)  # RIGHT\n    if dy < 0:\n      actions.append(0)  # DOWN\n    elif dy > 0:\n      actions.append(1)  # UP\n    return actions\n\n  def collect_primitives(missing_primitives):\n    actions = []\n    for primitive, count in missing_primitives:\n      while current_inventory[primitive] < count:\n        # Find a position with the required primitive\n        for x in range(env._current_state.grid.shape[0]):\n            for y in range(env._current_state.grid.shape[1]):\n                if env._current_state.grid[x, y, primitive] > 0:\n                    primitive_pos = (x, y)\n                    break\n        # Navigate to the position of the primitive and collect it\n        actions.extend(navigate_to_workshop(primitive_pos))\n        actions.append(4)  # USE action to collect the primitive\n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item has a recipe\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the required primitives and their counts for crafting the item\n  recipe = env.world.cookbook.recipes[item_index]\n  required_primitives = {ingredient: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n\n  # Check if we have all the required primitives in our inventory\n  current_inventory = env._current_state.inventory\n  missing_primitives = []\n\n  for primitive, count in required_primitives.items():\n    # If the primitive is not in the inventory, add it to the list of missing primitives\n    if current_inventory[primitive] < count:\n      missing_primitives.append((primitive, count))\n\n  actions_to_take = []\n\n  # If there are any missing primitives, collect them first\n  if missing_primitives:\n    actions_to_take.extend(collect_primitives(missing_primitives))\n\n  # Determine the workshop where crafting should occur\n  workshop = recipe.get(\"_at\", None)\n  if not workshop:\n    return []\n\n  workshop_index = env.world.cookbook.index[workshop]\n\n  # Find a position next to the workshop\n  for x in range(env._current_state.grid.shape[0]):\n      for y in range(env._current_state.grid.shape[1]):\n          if env._current_state.grid[x, y, workshop_index] > 0:\n              workshop_pos = (x, y)\n              break\n\n  # Navigate to the workshop\n  actions_to_take.extend(navigate_to_workshop(workshop_pos))\n\n  # Append USE action to craft the item\n  actions_to_take.append(4)  # USE action\n\n  return actions_to_take", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-11T13:26:20.166744", "function_name": "craft", "function_body": "  def find_workshop_position(workshop_index):\n    for x in range(env._current_state.grid.shape[0]):\n      for y in range(env._current_state.grid.shape[1]):\n        if env._current_state.grid[x, y, workshop_index] > 0:\n          return (x, y)\n    return None\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item has a recipe\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the required primitives and their counts for crafting the item\n  recipe = env.world.cookbook.recipes[item_index]\n  required_primitives = {ingredient: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n\n  # Check if we have all the required primitives in our inventory\n  current_inventory = env._current_state.inventory\n  missing_primitives = []\n\n  for primitive, count in required_primitives.items():\n    if current_inventory[primitive] < count:\n      missing_primitives.append((primitive, count))\n\n  if missing_primitives:\n    return []\n\n  # Determine the workshop where crafting should occur\n  workshop = recipe.get(\"_at\", None)\n  if not workshop:\n    return []\n  \n  workshop_index = env.world.cookbook.index[workshop]\n  workshop_pos = find_workshop_position(workshop_index)\n\n  if not workshop_pos:\n    return []\n\n  agent_pos = env._current_state.pos\n\n  # Calculate the direction to move towards the workshop\n  dx, dy = workshop_pos[0] - agent_pos[0], workshop_pos[1] - agent_pos[1]\n  actions_to_take = []\n\n  while dx != 0 or dy != 0:\n    if abs(dx) > abs(dy):\n      dir_action = 2 if dx < 0 else 3  # LEFT or RIGHT\n      dx += -1 if dx < 0 else 1\n    else:\n      dir_action = 0 if dy < 0 else 1  # DOWN or UP\n      dy += -1 if dy < 0 else 1\n\n    actions_to_take.append(dir_action)\n\n  # Append USE action to craft the item\n  actions_to_take.append(4)  # USE action\n\n  return actions_to_take", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-11T13:28:51.293447", "function_name": "craft", "function_body": "  i_goal = env.world.cookbook.index[item]\n\n  # Get the primitives required to craft this item\n  prim_reqs = env.world.cookbook.primitives_for(i_goal)\n\n  actions_list = []\n\n  # Check if we have all the required primitives in our inventory\n  for i_prim, count in prim_reqs.items():\n      if env._current_state.inventory[i_prim] < count:\n          return []  # If any primitive is missing, return an empty action list\n\n  # Find which workshop to use for crafting\n  workshop_index = None\n  workshop_name = \"_key\"\n\n  # Iterate over the recipes and find the workshop\n  for output_index, recipe in env.world.cookbook.recipes.items():\n      if i_goal == output_index:\n          workshop_name = recipe[\"_at\"]\n          break\n\n  try:\n      workshop_index = getattr(env.world, f\"{workshop_name}_index\")\n  except AttributeError:\n      return []  # If the workshop is not found, return an empty action list\n\n  # Get positions of all workshops in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n  if not workshop_positions.any():\n      return []  # No workshops found, return an empty action list\n\n  # Choose the closest workshop to the agent's current position\n  agent_pos = env._current_state.pos\n  distances = np.linalg.norm(workshop_positions - agent_pos, axis=1)\n  closest_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n\n  # Function to perform BFS and return a path from start to goal\n  def bfs(start, goal):\n      queue = collections.deque([start])\n      visited = set()\n      parent_map = {}\n\n      while queue:\n          current = queue.popleft()\n\n          if np.array_equal(current, goal):\n              break\n\n          # Explore neighbors (up, down, left, right)\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n\n              if 0 <= neighbor[0] < env._current_state.grid.shape[0] and\\\n                 0 <= neighbor[1] < env._current_state.grid.shape[1]:\n                  # Check if the neighbor is walkable\n                  if not env._current_state.grid[neighbor[0], neighbor[1]].any():\n                      if neighbor not in visited:\n                          queue.append(neighbor)\n                          visited.add(neighbor)\n                          parent_map[neighbor] = current\n\n      # Reconstruct path from start to goal using parent map\n      path = []\n      while np.array_equal(goal, start) == False:\n          path.append(goal)\n          goal = parent_map[goal]\n\n      return path[::-1]\n\n  # Calculate actions to move the agent to the closest workshop\n  path = bfs(agent_pos, closest_workshop_pos)\n\n  if not path:\n      return []  # If no path is found, return an empty action list\n\n  # Map each step in the path to a corresponding action\n  for next_pos in path[1:]:  # Skip the starting position\n      delta_x = next_pos[0] - agent_pos[0]\n      delta_y = next_pos[1] - agent_pos[1]\n\n      if delta_x > 0:\n          actions_list.append(craft.N_DOWN)\n      elif delta_x < 0:\n          actions_list.append(craft.N_UP)\n      elif delta_y > 0:\n          actions_list.append(craft.N_RIGHT)\n      elif delta_y < 0:\n          actions_list.append(craft.N_LEFT)\n\n      # Simulate the step to update the agent's position\n      env.step(actions_list[-1])\n      agent_pos = next_pos\n\n  # Once we reach the workshop, use it to craft the item\n  actions_list.append(craft.N_USE)\n\n  return actions_list", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T13:28:52.365655", "function_name": "craft", "function_body": "  i_goal = env.world.cookbook.index[item]\n  \n  # Get the primitives required for crafting this item\n  prim_reqs = env.world.cookbook.primitives_for(i_goal)\n\n  actions_list = []\n\n  # Check if we have all the required primitives in our inventory\n  missing_prims = {prim: count - env._current_state.inventory[prim] for prim, count in prim_reqs.items() if env._current_state.inventory[prim] < count}\n\n  if missing_prims:\n      return []  # If any primitive is missing, return an empty action list\n\n  # Find which workshop to use for crafting\n  workshop_index = None\n  workshop_name = \"_key\"\n\n  # Iterate over the recipes and find the workshop\n  for output_index, recipe in env.world.cookbook.recipes.items():\n      if i_goal == output_index:\n          workshop_name = recipe[\"_at\"]\n          break\n\n  try:\n      workshop_index = getattr(env.world, f\"{workshop_name}_index\")\n  except AttributeError:\n      return []  # If the workshop is not found, return an empty action list\n\n  # Get positions of all workshops in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n  if not workshop_positions.any():\n      return []  # No workshops found, return an empty action list\n\n  # Choose the closest workshop to the agent's current position\n  agent_pos = env._current_state.pos\n  distances = np.linalg.norm(workshop_positions - agent_pos, axis=1)\n  closest_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n\n  # Function to perform BFS and return a path from start to goal\n  def bfs(start, goal):\n      queue = collections.deque([start])\n      visited = set()\n      parent_map = {}\n\n      while queue:\n          current = queue.popleft()\n\n          if np.array_equal(current, goal):\n              break\n\n          # Explore neighbors (up, down, left, right)\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n\n              if 0 <= neighbor[0] < env._current_state.grid.shape[0] and\\\n                 0 <= neighbor[1] < env._current_state.grid.shape[1]:\n                  # Check if the neighbor is walkable\n                  if not env._current_state.grid[neighbor[0], neighbor[1]].any():\n                      if neighbor not in visited:\n                          queue.append(neighbor)\n                          visited.add(neighbor)\n                          parent_map[neighbor] = current\n\n      # Reconstruct path from start to goal using parent map\n      path = []\n      while np.array_equal(goal, start) == False:\n          path.append(goal)\n          goal = parent_map[goal]\n\n      return path[::-1]\n\n  # Calculate actions to move the agent to the closest workshop\n  path = bfs(agent_pos, closest_workshop_pos)\n\n  if not path:\n      return []  # If no path is found, return an empty action list\n\n  # Map each step in the path to a corresponding action\n  for next_pos in path[1:]:  # Skip the starting position\n      delta_x = next_pos[0] - agent_pos[0]\n      delta_y = next_pos[1] - agent_pos[1]\n\n      if delta_x > 0:\n          actions_list.append(craft.N_DOWN)\n      elif delta_x < 0:\n          actions_list.append(craft.N_UP)\n      elif delta_y > 0:\n          actions_list.append(craft.N_RIGHT)\n      elif delta_y < 0:\n          actions_list.append(craft.N_LEFT)\n\n      agent_pos = next_pos\n\n  # Once we reach the workshop, use it to craft the item\n  actions_list.append(craft.N_USE)\n\n  return actions_list", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T13:30:37.575442", "function_name": "craft", "function_body": "  goal_index = env.world.cookbook.index[item]\n\n  # Check if we have all required primitives in our inventory\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  current_inventory = collections.Counter(env._current_state.inventory)\n\n  for primitive, count in required_primitives.items():\n    if current_inventory[primitive] < count:\n      return []  # Missing required primitives\n\n  # Determine the workshop where crafting should occur\n  recipe_details = env.world.cookbook.recipes[goal_index]\n  workshop_name = recipe_details[\"_key\"]\n\n  # Get the index of the workshop from the world's cookbook\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the closest workshop in the grid\n  positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(positions) == 0:\n    return []  # No available workshops\n\n  closest_workshop_pos = min(\n      positions, key=lambda x: abs(x[0] - env._current_state.pos[0]) + abs(x[1] - env._current_state.pos[1]))\n\n  # Navigate to the closest workshop\n  current_pos = np.array(env._current_state.pos)\n  target_pos = np.array(closest_workshop_pos)\n\n  actions = []\n\n  while not np.array_equal(current_pos, target_pos):\n    delta = target_pos - current_pos\n\n    if delta[0] > 0:\n      actions.append(craft.RIGHT)  # Move right\n    elif delta[0] < 0:\n      actions.append(craft.LEFT)   # Move left\n\n    if delta[1] > 0:\n      actions.append(craft.DOWN)   # Move down\n    elif delta[1] < 0:\n      actions.append(craft.UP)     # Move up\n\n    current_pos = np.array(env._current_state.pos)\n\n  # Orient the agent to face the workshop and use it\n  direction_to_workshop = target_pos - current_pos\n\n  if direction_to_workshop[0] > 0:  # Workshop is to the right\n      actions.append(craft.RIGHT)\n  elif direction_to_workshop[0] < 0:  # Workshop is to the left\n      actions.append(craft.LEFT)\n  elif direction_to_workshop[1] > 0:  # Workshop is below\n      actions.append(craft.DOWN)\n  else:  # Workshop is above\n      actions.append(craft.UP)\n\n  actions.append(craft.USE)  # Use action to start crafting\n\n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T13:30:38.625265", "function_name": "craft", "function_body": "  goal_index = env.world.cookbook.index[item]\n\n  # Check if we have all required primitives in our inventory\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  current_inventory = collections.Counter(env._current_state.inventory)\n\n  for primitive, count in required_primitives.items():\n    if current_inventory[primitive] < count:\n      return []  # Missing required primitives\n\n  # Determine the workshop where crafting should occur\n  recipe_details = env.world.cookbook.recipes[goal_index]\n  workshop_name = recipe_details[\"_key\"]\n\n  # Get the index of the workshop from the world's cookbook\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the closest workshop in the grid\n  positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(positions) == 0:\n    return []  # No available workshops\n\n  closest_workshop_pos = min(\n      positions, key=lambda x: abs(x[0] - env._current_state.pos[0]) + abs(x[1] - env._current_state.pos[1]))\n\n  # Navigate to the closest workshop\n  current_pos = np.array(env._current_state.pos)\n  target_pos = np.array(closest_workshop_pos)\n\n  actions = []\n\n  while not np.array_equal(current_pos, target_pos):\n    delta = target_pos - current_pos\n\n    if delta[0] > 0:\n      actions.append(craft.RIGHT)  # Move right\n    elif delta[0] < 0:\n      actions.append(craft.LEFT)   # Move left\n\n    if delta[1] > 0:\n      actions.append(craft.DOWN)   # Move down\n    elif delta[1] < 0:\n      actions.append(craft.UP)     # Move up\n\n    current_pos = np.array(env._current_state.pos)\n\n  # Orient the agent to face the workshop and use it\n  if env._current_state.grid[target_pos[0], target_pos[1], workshop_index] == 1:\n    actions.append(craft.USE)\n    \n    # Check if the crafting was successful, otherwise return empty action list\n    reward, done, observations = env.step(actions[-1])\n    if not observations['features_dict']['inventory'][goal_index]:\n      return []\n      \n    # Add the crafted item to our inventory count in memory\n    current_inventory[goal_index] += 1\n\n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T13:32:53.399838", "function_name": "craft", "function_body": "  idx = env.world.cookbook.index[item]\n\n  # Check if we have all the required primitives to craft this item\n  required_primitives = env.world.cookbook.primitives_for(idx)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory)}\n\n  if any(primitive not in inventory_dict or inventory_dict[primitive] < count for primitive, count in required_primitives.items()):\n    return []\n\n  # Determine the workshop index\n  recipe = env.world.cookbook.recipes[idx]\n  workshop_name = [key for key in recipe.keys() if \"WORKSHOP\" in key][0]\n  workshop_idx = env.world.cookbook.index[workshop_name]\n\n  # Find all positions of the required workshops in the grid\n  workshop_positions = []\n  for i in range(env._current_state.grid.shape[0]):\n    for j in range(env._current_state.grid.shape[1]):\n      if env._current_state.grid[i, j, workshop_idx] == 1:\n        workshop_positions.append((i, j))\n\n  # Plan the path to the closest workshop\n  def bfs(start, goals):\n    queue = collections.deque([start])\n    visited = set()\n    parent_map = {}\n\n    while queue:\n      current_pos = queue.popleft()\n\n      if current_pos in goals:\n        path = []\n        while current_pos != start:\n          path.append(current_pos)\n          current_pos = parent_map[current_pos]\n        path.reverse()\n        return path\n\n      if current_pos in visited:\n        continue\n\n      visited.add(current_pos)\n\n      # Check all four possible directions\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        new_x = current_pos[0] + dx\n        new_y = current_pos[1] + dy\n\n        if 0 <= new_x < env._current_state.grid.shape[0] and 0 <= new_y < env._current_state.grid.shape[1]:\n          # Check if the cell is empty (not blocked by any item)\n          if not np.any(env._current_state.grid[new_x, new_y]):\n            queue.append((new_x, new_y))\n            parent_map[(new_x, new_y)] = current_pos\n\n    return None  # No path found\n\n  start_pos = env._current_state.pos\n  closest_workshop_path = min([bfs(start_pos, [goal]) for goal in workshop_positions], key=len)\n\n  if not closest_workshop_path:\n    return []  # Could not find a valid path to any workshop\n\n  action_map = {(-1, 0): craft.MOVE_UP, (1, 0): craft.MOVE_DOWN, (0, -1): craft.MOVE_LEFT, (0, 1): craft.MOVE_RIGHT}\n  actions_to_workshop = [action_map[(closest_workshop_path[i][0] - closest_workshop_path[i-1][0], closest_workshop_path[i][1] - closest_workshop_path[i-1][1])] for i in range(1, len(closest_workshop_path))]\n\n  # Move to the workshop and perform the USE action\n  actions = actions_to_workshop + [craft.USE_ACTION]\n  \n  return actions", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T13:32:54.442045", "function_name": "craft", "function_body": "  # Step 1: Get the index of the desired item from the cookbook\n  idx = env.world.cookbook.index[item]\n\n  # Step 2: Check if we have all the required primitives to craft this item\n  required_primitives = env.world.cookbook.primitives_for(idx)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory)}\n\n  if any(primitive not in inventory_dict or inventory_dict[primitive] < count for primitive, count in required_primitives.items()):\n    return []\n\n  # Step 3: Determine the workshop index\n  recipe = env.world.cookbook.recipes[idx]\n  workshop_name = list(recipe.keys())[-1]\n  workshop_idx = env.world.cookbook.index[workshop_name]\n\n  # Step 4: Find all positions of the required workshops in the grid\n  workshop_positions = []\n  for i in range(env._current_state.grid.shape[0]):\n    for j in range(env._current_state.grid.shape[1]):\n      if env._current_state.grid[i, j, workshop_idx] == 1:\n        workshop_positions.append((i, j))\n\n  # Step 5: Plan the path to the closest workshop\n  def bfs(start, goals):\n    queue = collections.deque([start])\n    visited = set()\n    parent_map = {}\n\n    while queue:\n      current_pos = queue.popleft()\n\n      if current_pos in goals:\n        path = []\n        while current_pos != start:\n          path.append(current_pos)\n          current_pos = parent_map[current_pos]\n        path.reverse()\n        return path\n\n      if current_pos in visited:\n        continue\n\n      visited.add(current_pos)\n\n      # Check all four possible directions\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        new_x = current_pos[0] + dx\n        new_y = current_pos[1] + dy\n\n        if 0 <= new_x < env._current_state.grid.shape[0] and 0 <= new_y < env._current_state.grid.shape[1]:\n          # Check if the cell is empty (not blocked by any item)\n          if not np.any(env._current_state.grid[new_x, new_y]):\n            queue.append((new_x, new_y))\n            parent_map[(new_x, new_y)] = current_pos\n\n    return None  # No path found\n\n  start_pos = env._current_state.pos\n  closest_workshop_path = min([bfs(start_pos, [goal]) for goal in workshop_positions], key=len)\n\n  if not closest_workshop_path:\n    return []  # Could not find a valid path to any workshop\n\n  action_map = {(-1, 0): craft.MOVE_UP, (1, 0): craft.MOVE_DOWN, (0, -1): craft.MOVE_LEFT, (0, 1): craft.MOVE_RIGHT}\n  actions_to_workshop = [action_map[(closest_workshop_path[i][0] - closest_workshop_path[i-1][0], closest_workshop_path[i][1] - closest_workshop_path[i-1][1])] for i in range(1, len(closest_workshop_path))]\n\n  # Step 6: Move to the workshop and perform the USE action\n  actions = actions_to_workshop + [craft.USE_ACTION]\n  \n  return actions", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T13:34:40.197846", "function_name": "craft", "function_body": "  def get_actions_to_collect_primitive(primitive, count):\n    primitive_index = env.world.cookbook.index[primitive]\n    for x in range(env._current_state.grid.shape[0]):\n        for y in range(env._current_state.grid.shape[1]):\n            if env._current_state.grid[x, y, primitive_index] > 0:\n                target_pos = (x, y)\n                break\n    agent_pos = env._current_state.pos\n    dx, dy = target_pos[0] - agent_pos[0], target_pos[1] - agent_pos[1]\n    actions = []\n    if abs(dx) > abs(dy):\n        dir_action = 2 if dx < 0 else 3  # LEFT or RIGHT\n    else:\n        dir_action = 0 if dy < 0 else 1  # DOWN or UP\n    actions.append(dir_action)\n    actions.append(4)  # USE action\n    return actions * count\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item has a recipe\n  if item_index not in env.world.cookbook.recipes:\n      return []\n\n  # Get the required primitives and their counts for crafting the item\n  recipe = env.world.cookbook.recipes[item_index]\n  required_primitives = {ingredient: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n\n  actions_to_take = []\n  current_inventory = env._current_state.inventory\n\n  # Collect all missing primitives\n  for primitive, count in required_primitives.items():\n      if current_inventory[primitive] < count:\n          actions_to_take.extend(get_actions_to_collect_primitive(primitive, count - current_inventory[primitive]))\n\n  # Determine the workshop where crafting should occur\n  workshop = recipe.get(\"_at\", None)\n  if not workshop:\n      return []\n\n  workshop_index = env.world.cookbook.index[workshop]\n\n  # Find a position next to the workshop\n  for x in range(env._current_state.grid.shape[0]):\n      for y in range(env._current_state.grid.shape[1]):\n          if env._current_state.grid[x, y, workshop_index] > 0:\n              workshop_pos = (x, y)\n              break\n\n  # Calculate the direction to move towards the workshop\n  agent_pos = env._current_state.pos\n  dx, dy = workshop_pos[0] - agent_pos[0], workshop_pos[1] - agent_pos[1]\n  if abs(dx) > abs(dy):\n      dir_action = 2 if dx < 0 else 3  # LEFT or RIGHT\n  else:\n      dir_action = 0 if dy < 0 else 1  # DOWN or UP\n\n  # Add the move action to the list of actions to take\n  actions_to_take.append(dir_action)  # Assuming direction is already set correctly\n\n  # Append USE action to craft the item\n  actions_to_take.append(4)  # USE action\n\n  return actions_to_take", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-11T13:34:41.278083", "function_name": "craft", "function_body": "  def move_towards_position(agent_pos, target_pos):\n      dx, dy = target_pos[0] - agent_pos[0], target_pos[1] - agent_pos[1]\n      actions = []\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      if dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n      return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item has a recipe\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the required primitives and their counts for crafting the item\n  recipe = env.world.cookbook.recipes[item_index]\n  required_primitives = {ingredient: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n\n  # Check if we have all the required primitives in our inventory\n  current_inventory = env._current_state.inventory\n  missing_primitives = []\n\n  for primitive, count in required_primitives.items():\n    # If the primitive is not in the inventory, add it to the list of missing primitives\n    if current_inventory[primitive] < count:\n      missing_primitives.append((primitive, count))\n\n  # If there are any missing primitives, return an empty action list\n  if missing_primitives:\n    return []\n\n  # Determine the workshop where crafting should occur\n  workshop = recipe.get(\"_at\", None)\n  if not workshop:\n    return []\n\n  workshop_index = env.world.cookbook.index[workshop]\n\n  # Find a position next to the workshop\n  for x in range(env._current_state.grid.shape[0]):\n      for y in range(env._current_state.grid.shape[1]):\n          if env._current_state.grid[x, y, workshop_index] > 0:\n              workshop_pos = (x, y)\n              break\n\n  # Calculate the direction to move towards the workshop\n  agent_pos = env._current_state.pos\n  actions_to_take = move_towards_position(agent_pos, workshop_pos)\n\n  # Append USE action to craft the item\n  actions_to_take.append(4)  # USE action\n\n  return actions_to_take", "island_id": 7, "scores": {"3": 2.0}}
{"timestamp": "2025-09-11T13:37:54.907996", "function_name": "craft", "function_body": "  def get_direction(current_pos, target_pos):\n    x_diff = target_pos[0] - current_pos[0]\n    y_diff = target_pos[1] - current_pos[1]\n\n    if x_diff == 0 and y_diff == 0:\n      return None\n\n    directions = [\n        (0, 1, 3),   # RIGHT\n        (0, -1, 2),  # LEFT\n        (-1, 0, 0),  # UP\n        (1, 0, 1)    # DOWN\n    ]\n\n    for dx, dy, direction in directions:\n      if x_diff == dx and y_diff == dy:\n        return direction\n\n    return None\n\n  def find_path(start, target):\n    actions = []\n    \n    start_x, start_y = divmod(start, env._current_state.grid.shape[1])\n    target_x, target_y = divmod(target, env._current_state.grid.shape[1])\n\n    open_set = []\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, target)}\n\n    heapq.heappush(open_set, (f_score[start], start))\n\n    while open_set:\n      _, current = heapq.heappop(open_set)\n\n      if current == target:\n        reconstruct_path(came_from, current)\n        break\n\n      cx, cy = divmod(current, env._current_state.grid.shape[1])\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = cx + dx, cy + dy\n\n        if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n          neighbor = nx * env._current_state.grid.shape[1] + ny\n          tentative_g_score = g_score[current] + 1\n\n          if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n            came_from[neighbor] = current\n            g_score[neighbor] = tentative_g_score\n            f_score[neighbor] = tentative_g_score + heuristic(neighbor, target)\n            heapq.heappush(open_set, (f_score[neighbor], neighbor))\n\n    def reconstruct_path(came_from, current):\n      total_path = []\n      while current in came_from:\n        cx, cy = divmod(current, env._current_state.grid.shape[1])\n        px, py = divmod(came_from[current], env._current_state.grid.shape[1])\n\n        dx, dy = px - cx, py - cy\n        total_path.append(get_direction((cx, cy), (px, py)))\n        current = came_from[current]\n      \n      actions.extend(reversed(total_path))\n\n    return actions\n\n  def heuristic(a, b):\n    ax, ay = divmod(a, env._current_state.grid.shape[1])\n    bx, by = divmod(b, env._current_state.grid.shape[1])\n\n    return abs(ax - bx) + abs(ay - by)\n\n  item_index = env.world.cookbook.index[item]\n  \n  if not item_index:\n    return []\n\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  current_inventory = {env.world.cookbook.index.get(i): c for i, c in enumerate(env._current_state.inventory) if c > 0}\n\n  for primitive_index, count in primitives_needed.items():\n    if current_inventory.get(primitive_index, 0) < count:\n      return []\n\n  workshop_name = env.world.cookbook.recipes[item_index][\"_at\"]\n  workshop_indices = [(x, y) for x in range(env._current_state.grid.shape[0]) for y in range(env._current_state.grid.shape[1])\n                      if env._current_state.grid[x, y, env.world.workshop_indices[0]] == env.world.cookbook.index[workshop_name]]\n\n  if not workshop_indices:\n    return []\n\n  # Choose the closest workshop\n  start_pos = env._current_state.pos\n  closest_workshop = min(workshop_indices, key=lambda p: heuristic(start_pos[0] * env._current_state.grid.shape[1] + start_pos[1], \n                                                                   p[0] * env._current_state.grid.shape[1] + p[1]))\n\n  start_pos_flat = start_pos[0] * env._current_state.grid.shape[1] + start_pos[1]\n  target_pos_flat = closest_workshop[0] * env._current_state.grid.shape[1] + closest_workshop[1]\n\n  actions.extend(find_path(start_pos_flat, target_pos_flat))\n\n  # Ensure we are in front of the workshop\n  direction_to_face = get_direction(env._current_state.pos, closest_workshop)\n  if direction_to_face is not None:\n      actions.append(direction_to_face)\n\n  # Craft the item by using the USE action\n  actions.append(4)  # USE action\n\n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T13:37:55.956987", "function_name": "craft", "function_body": "  def get_direction(current_pos, target_pos):\n    x_diff = target_pos[0] - current_pos[0]\n    y_diff = target_pos[1] - current_pos[1]\n\n    # Determine the direction to face based on the differences\n    if x_diff == 0 and y_diff == 0:\n      return None\n    elif x_diff > 0:\n      return 3  # RIGHT\n    elif x_diff < 0:\n      return 2  # LEFT\n    elif y_diff > 0:\n      return 1  # UP\n    else:\n      return 0  # DOWN\n\n  def find_path(start, target):\n    actions = []\n    \n    start_x, start_y = divmod(start, env._current_state.grid.shape[1])\n    target_x, target_y = divmod(target, env._current_state.grid.shape[1])\n\n    open_set = []\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, target)}\n\n    heapq.heappush(open_set, (f_score[start], start))\n\n    while open_set:\n      _, current = heapq.heappop(open_set)\n\n      if current == target:\n        reconstruct_path(came_from, current)\n        break\n\n      cx, cy = divmod(current, env._current_state.grid.shape[1])\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = cx + dx, cy + dy\n\n        if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n          neighbor = nx * env._current_state.grid.shape[1] + ny\n          tentative_g_score = g_score[current] + 1\n\n          if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n            came_from[neighbor] = current\n            g_score[neighbor] = tentative_g_score\n            f_score[neighbor] = tentative_g_score + heuristic(neighbor, target)\n            heapq.heappush(open_set, (f_score[neighbor], neighbor))\n\n    def reconstruct_path(came_from, current):\n      total_path = []\n      while current in came_from:\n        cx, cy = divmod(current, env._current_state.grid.shape[1])\n        px, py = divmod(came_from[current], env._current_state.grid.shape[1])\n\n        dx, dy = px - cx, py - cy\n        direction_to_face = get_direction((cx, cy), (px, py))\n        \n        if direction_to_face is not None:\n          total_path.append(direction_to_face)\n        \n        current = came_from[current]\n      \n      actions.extend(reversed(total_path))\n\n    return actions\n\n  def heuristic(a, b):\n    ax, ay = divmod(a, env._current_state.grid.shape[1])\n    bx, by = divmod(b, env._current_state.grid.shape[1])\n\n    # Manhattan distance\n    return abs(ax - bx) + abs(ay - by)\n\n  actions = []\n\n  item_index = env.world.cookbook.index[item]\n\n  if not item_index:\n    return []\n\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  current_inventory = {env.world.cookbook.index.get(i): c for i, c in enumerate(env._current_state.inventory) if c > 0}\n\n  missing_primitives = []\n  for primitive_index, count in primitives_needed.items():\n    if current_inventory.get(primitive_index, 0) < count:\n      missing_primitives.append((primitive_index, count - current_inventory.get(primitive_index, 0)))\n\n  if missing_primitives:\n    return []\n\n  workshop_name = env.world.cookbook.recipes[item_index][\"_at\"]\n  workshop_indices = np.argwhere(env._current_state.grid[:, :, env.world.workshop_indices[0]] == env.world.cookbook.index[workshop_name])\n\n  if not workshop_indices.any():\n    return []\n\n  start_pos_flat = env._current_state.pos[0] * env._current_state.grid.shape[1] + env._current_state.pos[1]\n  target_workshop_position = (workshop_indices[0][0], workshop_indices[0][1])\n  target_pos_flat = target_workshop_position[0] * env._current_state.grid.shape[1] + target_workshop_position[1]\n\n  actions.extend(find_path(start_pos_flat, target_pos_flat))\n\n  direction_to_face = get_direction(env._current_state.pos, target_workshop_position)\n  if direction_to_face is not None:\n      actions.append(direction_to_face)\n\n  # Craft the item by using the USE action\n  actions.append(4)  # USE action\n\n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T13:39:22.172208", "function_name": "craft", "function_body": "  goal_index = env.world.cookbook.index[item]\n\n  # Check if we have all required primitives in our inventory\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  current_inventory = collections.Counter(env._current_state.inventory)\n\n  for primitive, count in required_primitives.items():\n    if current_inventory[primitive] < count:\n      return []  # Missing required primitives\n\n  # Determine the workshop where crafting should occur\n  recipe_details = env.world.cookbook.recipes[goal_index]\n  workshop_name = recipe_details[\"_key\"]\n\n  # Get the index of the workshop from the world's cookbook\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the closest workshop in the grid\n  positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(positions) == 0:\n    return []  # No available workshops\n\n  closest_workshop_pos = min(\n      positions, key=lambda x: abs(x[0] - env._current_state.pos[0]) + abs(x[1] - env._current_state.pos[1]))\n\n  # Navigate to the closest workshop\n  current_pos = np.array(env._current_state.pos)\n  target_pos = np.array(closest_workshop_pos)\n\n  actions = []\n\n  while not np.array_equal(current_pos, target_pos):\n    delta = target_pos - current_pos\n\n    # Calculate direction based on the largest absolute difference\n    if abs(delta[0]) > abs(delta[1]):\n      if delta[0] > 0:\n        actions.append(craft.RIGHT)  # Move right\n      else:\n        actions.append(craft.LEFT)   # Move left\n    else:\n      if delta[1] > 0:\n        actions.append(craft.DOWN)   # Move down\n      else:\n        actions.append(craft.UP)     # Move up\n\n    current_pos = np.array(env._current_state.pos)\n\n  # Orient the agent to face the workshop and use it\n  if env._current_state.grid[target_pos[0], target_pos[1], workshop_index] == 1:\n\n    # Determine the correct direction to face the workshop\n    delta = target_pos - current_pos\n    actions_to_face_workshop = []\n    if delta[0] > 0:\n      actions_to_face_workshop.append(craft.RIGHT)  # Face right\n    elif delta[0] < 0:\n      actions_to_face_workshop.append(craft.LEFT)   # Face left\n    elif delta[1] > 0:\n      actions_to_face_workshop.append(craft.DOWN)   # Face down\n    else:\n      actions_to_face_workshop.append(craft.UP)     # Face up\n\n    # Check if the agent is already facing the correct direction\n    current_direction = env._current_state.pos - np.array(env._current_state.grid[:, :, workshop_index] == 1).nonzero()[0:2][::-1]\n    target_direction = delta / abs(delta)\n    if not np.array_equal(current_direction, target_direction):\n      actions.extend(actions_to_face_workshop)\n\n    actions.append(craft.USE)\n\n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T13:39:23.229593", "function_name": "craft", "function_body": "  goal_index = env.world.cookbook.index[item]\n\n  # Check if we have all required primitives in our inventory\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  current_inventory = collections.Counter(env._current_state.inventory)\n\n  for primitive, count in required_primitives.items():\n    if current_inventory[primitive] < count:\n      return []  # Missing required primitives\n\n  # Determine the workshop where crafting should occur\n  recipe_details = env.world.cookbook.recipes[goal_index]\n  workshop_name = recipe_details[\"_key\"]\n\n  # Get the index of the workshop from the world's cookbook\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the closest workshop in the grid\n  positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(positions) == 0:\n    return []  # No available workshops\n\n  closest_workshop_pos = min(\n      positions, key=lambda x: abs(x[0] - env._current_state.pos[0]) + abs(x[1] - env._current_state.pos[1]))\n\n  # Navigate to the closest workshop\n  current_pos = np.array(env._current_state.pos)\n  target_pos = np.array(closest_workshop_pos)\n\n  actions = []\n\n  while not np.array_equal(current_pos, target_pos):\n    delta = target_pos - current_pos\n\n    # Determine the direction with the largest absolute difference and move there first\n    if abs(delta[0]) > abs(delta[1]):\n      actions.extend([craft.RIGHT] * delta[0] if delta[0] > 0 else [craft.LEFT] * (-delta[0]))\n    else:\n      actions.extend([craft.DOWN] * delta[1] if delta[1] > 0 else [craft.UP] * (-delta[1]))\n\n    current_pos = np.array(env._current_state.pos)\n\n  # Orient the agent to face the workshop and use it\n  if env._current_state.grid[target_pos[0], target_pos[1], workshop_index] == 1:\n      actions.append(craft.USE)\n    \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T13:40:02.367895", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Fetch the primitives required for crafting the item\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  \n  actions_to_take = []\n  \n  # Check if we have all the items/primitives required for crafting\n  if not required_primitives:\n    print(f\"No recipe found for {item}.\")\n    return []\n\n  for primitive, count in required_primitives.items():\n    while env._current_state.inventory[primitive] < count:\n      actions_to_take.extend(collect_v2(env, env.world.cookbook.index.get(primitive)))\n      \n  # Find the workshop specified in the recipe\n  workshop_index = -1\n  for key, value in env.world.cookbook.recipes[item_index].items():\n    if \"_at\" in key:\n      workshop_index = env.world.cookbook.index[value]\n      break\n  \n  if workshop_index == -1:\n    print(f\"No workshop specified for crafting {item}.\")\n    return []\n  \n  # Navigate to the nearest workshop\n  actions_to_take.extend(navigate_to_workshop(env, workshop_index))\n  \n  # Use the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-11T13:40:03.371414", "function_name": "craft", "function_body": "  # Convert the item name to its corresponding index using the cookbook.\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the recipe for the desired item.\n  recipe = env.world.cookbook.recipes.get(item_index, None)\n  \n  if not recipe:\n    print(f\"No recipe found for {item}.\")\n    return []\n\n  actions = []\n\n  # Check and collect required primitives\n  for ingredient_index, count in recipe.items():\n    if ingredient_index == \"_key\":\n      continue  # Skip the workshop key\n\n    ingredient_name = env.world.cookbook.index.get(ingredient_index)\n    \n    if ingredient_name is None:\n      print(f\"Unknown ingredient index: {ingredient_index}.\")\n      return []\n    \n    # Collect required amount of each ingredient\n    for _ in range(count):\n      actions.extend(collect(env, ingredient_name))\n\n  # Determine the workshop and move there\n  workshop = recipe[\"_key\"]\n  workshop_index = env.world.cookbook.index[workshop]\n  \n  if workshop_index not in env.world.workshop_indices:\n    print(f\"Invalid workshop index: {workshop}.\")\n    return []\n    \n  actions.extend(move_to_workshop(env, workshop_index))\n  \n  # Use the workshop to craft the item\n  actions.append(env.world.N_ACTIONS - 1)  # Assuming USE action is the last action\n  \n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-11T13:40:47.499434", "function_name": "craft", "function_body": "  actions = []\n\n  # Fetch the index for the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Get primitives required to make the item\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n\n  # Check if we already have all the primitives in our inventory\n  all_primitives_collected = True\n  for primitive, count in primitives_required.items():\n    if env._current_state.inventory[primitive] < count:\n      all_primitives_collected = False\n      break\n\n  # If not all primitives are collected, return an empty action list\n  if not all_primitives_collected:\n    return []\n\n  # Find the workshop that can craft this item\n  target_workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n    if item_index in recipe.values():\n      target_workshop_index = recipe[\"_key\"]\n      break\n\n  # If no valid workshop is found, return an empty action list\n  if target_workshop_index is None:\n    return []\n\n  # Find the position of the target workshop on the grid\n  target_workshop_pos = None\n  for x in range(env._current_state.grid.shape[0]):\n      for y in range(env._current_state.grid.shape[1]):\n          if env._current_state.grid[x, y, target_workshop_index] == 1:\n              target_workshop_pos = (x, y)\n              break\n      if target_workshop_pos is not None:\n          break\n\n  # If no valid workshop position found, return an empty action list\n  if target_workshop_pos is None:\n    return []\n\n  # Calculate the direction to face the target workshop\n  dx = target_workshop_pos[0] - env._current_state.pos[0]\n  dy = target_workshop_pos[1] - env._current_state.pos[1]\n\n  # Determine the action to face the target workshop\n  if abs(dx) > abs(dy):\n      direction_to_face = \"RIGHT\" if dx > 0 else \"LEFT\"\n  else:\n      direction_to_face = \"DOWN\" if dy > 0 else \"UP\"\n\n  # Move towards the target workshop and face it\n  actions.append(env.world.cookbook.index[direction_to_face])\n  \n  # Add USE action to craft the item\n  actions.append(env.world.cookbook.index[\"USE\"])\n\n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T13:40:48.496957", "function_name": "craft", "function_body": "  # Get the index of the desired item using the cookbook's index mapping\n  goal_index = env.world.cookbook.index[item]\n  \n  if not goal_index:\n    raise ValueError(\"Unknown goal item\")\n    \n  # Get the recipe for the goal item\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  required_primitives = {env.world.cookbook.index[name]: count for name, count in recipe.items() if name != \"_at\"}\n  workshop_required = env.world.cookbook.index[recipe[\"_at\"]]\n\n  # Check if we have all the primitives in inventory\n  missing_primitives = [item_idx for item_idx, required_count in required_primitives.items() \n                        if env._current_state.inventory[item_idx] < required_count]\n  \n  if missing_primitives:\n    return []\n\n  # Navigate to the required workshop\n  actions_to_workshop = navigate_to(env, workshop_required)\n\n  # Perform USE action at the workshop to craft the item\n  use_action = [craft.USE]\n\n  return actions_to_workshop + use_action", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-11T13:42:37.045425", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # If the item has no recipe or is not a crafted item, return an empty action list\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the recipe for the desired item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Check if all required ingredients are available in the inventory\n  required_ingredients = {env.world.cookbook.index[ingredient]: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n  available_ingredients = {k: v for k, v in enumerate(env._current_state.inventory) if v > 0}\n\n  # If all ingredients are not available, return an empty action list\n  if any(required_ingredient not in available_ingredients or available_ingredients[required_ingredient] < count \n         for required_ingredient, count in required_ingredients.items()):\n    return []\n\n  # Find the workshop index where the item should be crafted\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  def generate_path_to_workshop(current_state, workshop_index):\n      # This function will implement a simple pathfinding algorithm to move towards the nearest workshop.\n      # For simplicity, we'll use a basic flood fill approach here.\n      queue = collections.deque([current_state.pos])\n      visited = set([current_state.pos])\n      parent = {current_state.pos: None}\n      \n      while queue:\n          x, y = queue.popleft()\n          \n          # Check if we are next to the workshop\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if env.world.grid[nx][ny] == workshop_index:\n                  # Backtrack to find the path\n                  path = []\n                  while (nx, ny) != current_state.pos:\n                      path.append((nx, ny))\n                      nx, ny = parent[(nx, ny)]\n                  return path[::-1]\n              \n              if 0 <= nx < env.world.grid.shape[0] and 0 <= ny < env.world.grid.shape[1] and (nx, ny) not in visited:\n                  queue.append((nx, ny))\n                  visited.add((nx, ny))\n                  parent[(nx, ny)] = (x, y)\n      \n      return None\n\n  def generate_actions_from_path(path, current_state):\n      actions = []\n      for next_pos in path:\n          dx, dy = next_pos[0] - current_state.pos[0], next_pos[1] - current_state.pos[1]\n          if (dx, dy) == (-1, 0):\n              actions.append(2)  # LEFT\n          elif (dx, dy) == (1, 0):\n              actions.append(3)  # RIGHT\n          elif (dx, dy) == (0, -1):\n              actions.append(0)  # DOWN\n          elif (dx, dy) == (0, 1):\n              actions.append(1)  # UP\n      \n      return actions\n\n  def is_next_to_workshop(current_state, workshop_index):\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          neighbor_pos = (current_state.pos[0] + dx, current_state.pos[1] + dy)\n          if env.world.grid[neighbor_pos] == workshop_index:\n              return True\n      return False\n\n  # Generate the path to the nearest workshop\n  path_to_workshop = generate_path_to_workshop(env._current_state, workshop_index)\n\n  if not path_to_workshop:\n      return []\n\n  actions = generate_actions_from_path(path_to_workshop, env._current_state)\n\n  # Once at the workshop, face it and perform the USE action\n  if is_next_to_workshop(env._current_state, workshop_index):\n      target_dir = ((1, 0), (-1, 0), (0, -1), (0, 1)).index((path_to_workshop[-1][0] - env._current_state.pos[0], path_to_workshop[-1][1] - env._current_state.pos[1]))\n      current_dir = ((1, 0), (-1, 0), (0, -1), (0, 1)).index(env._current_state.dir)\n      \n      if current_dir != target_dir:\n          actions.append((target_dir + 2) % 4)  # Turn to face the workshop\n      \n      actions.append(4)  # USE action to craft at the workshop\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T13:42:38.098198", "function_name": "craft", "function_body": "  # Get the index for the item to be crafted\n  item_index = env.world.cookbook.index[item]\n\n  # If the item has no recipe or is not a crafted item, return an empty action list\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the recipe for the desired item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Extract ingredients and workshop information from the recipe\n  required_ingredients = {env.world.cookbook.index[ingredient]: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Check if all ingredients are available in the inventory\n  available_ingredients = {k: v for k, v in enumerate(env._current_state.inventory) if v > 0}\n  \n  # If all ingredients are not available, return an empty action list\n  if any(required_ingredient not in available_ingredients or available_ingredients[required_ingredient] < count \n         for required_ingredient, count in required_ingredients.items()):\n    return []\n\n  # Function to generate actions to move to the workshop and face it\n  def generate_actions_to_move_and_face(current_state, workshop_index):\n    actions = []\n    directions = [(1, 0), (-1, 0), (0, -1), (0, 1)]  # RIGHT, LEFT, DOWN, UP\n    \n    for dx, dy in directions:\n      neighbor_pos = (current_state.pos[0] + dx, current_state.pos[1] + dy)\n      \n      if env.world.grid[neighbor_pos] == workshop_index:\n        target_dir = (dx, dy)\n        current_dir = ((1, 0), (-1, 0), (0, -1), (0, 1)).index(current_state.dir)\n        target_dir_idx = directions.index(target_dir)\n        \n        if current_dir != target_dir_idx:\n          actions.append((target_dir_idx + 2) % 4)  # Turn to face the workshop\n        actions.append(4)  # Use action to craft at the workshop\n        return actions\n    \n    return []\n\n  # Function to check if we are next to and facing the correct workshop\n  def is_next_to_workshop_and_facing(current_state, workshop_index):\n    directions = [(1, 0), (-1, 0), (0, -1), (0, 1)]  # RIGHT, LEFT, DOWN, UP\n    \n    for dx, dy in directions:\n      neighbor_pos = (current_state.pos[0] + dx, current_state.pos[1] + dy)\n      \n      if env.world.grid[neighbor_pos] == workshop_index and current_state.dir == (dx, dy):\n        return True\n    \n    return False\n\n  # If we are already next to and facing the correct workshop, perform the USE action\n  if is_next_to_workshop_and_facing(env._current_state, workshop_index):\n    return [4]  # USE action\n\n  # Otherwise, generate actions to move next to and face the correct workshop\n  return generate_actions_to_move_and_face(env._current_state, workshop_index)", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T13:45:18.176979", "function_name": "craft", "function_body": "  # Get the index of the item in the cookbook\n  idx = env.world.cookbook.index[item]\n\n  # Check if we have all the required primitives to craft this item\n  required_primitives = env.world.cookbook.primitives_for(idx)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory)}\n\n  if any(primitive not in inventory_dict or inventory_dict[primitive] < count for primitive, count in required_primitives.items()):\n    return []\n\n  # Determine the workshop index\n  recipe = env.world.cookbook.recipes[idx]\n  workshop_name = [key for key in recipe.keys() if 'WORKSHOP' in key][0]\n  workshop_idx = env.world.cookbook.index[workshop_name]\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = []\n  for i in range(env._current_state.grid.shape[0]):\n    for j in range(env._current_state.grid.shape[1]):\n      if env._current_state.grid[i, j, workshop_idx] == 1:\n        workshop_positions.append((i, j))\n\n  # Plan the path to the closest workshop position\n  start_pos = env._current_state.pos\n\n  def bfs(start_pos, goals):\n    queue = collections.deque([start_pos])\n    visited = set()\n    parent_map = {}\n\n    while queue:\n      current_pos = queue.popleft()\n\n      if current_pos in goals:\n        path = []\n        while current_pos != start_pos:\n          path.append(current_pos)\n          current_pos = parent_map[current_pos]\n        path.reverse()\n        return path\n\n      if current_pos in visited:\n        continue\n\n      visited.add(current_pos)\n\n      # Check all four possible directions\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        new_x = current_pos[0] + dx\n        new_y = current_pos[1] + dy\n\n        if 0 <= new_x < env._current_state.grid.shape[0] and 0 <= new_y < env._current_state.grid.shape[1]:\n          # Check if the cell is empty (not blocked by any item)\n          if not np.any(env._current_state.grid[new_x, new_y]):\n            queue.append((new_x, new_y))\n            parent_map[(new_x, new_y)] = current_pos\n\n    return None  # No path found\n  \n  def get_actions_to_move(from_pos, to_pos):\n    path = bfs(from_pos, [to_pos])\n    if not path:\n      return []\n    \n    action_map = {(-1, 0): craft.MOVE_UP, (1, 0): craft.MOVE_DOWN, (0, -1): craft.MOVE_LEFT, (0, 1): craft.MOVE_RIGHT}\n    actions = [action_map[(path[i][0] - path[i-1][0], path[i][1] - path[i-1][1])] for i in range(1, len(path))]\n    \n    return actions\n\n  closest_workshop_path = min([bfs(start_pos, [pos]) for pos in workshop_positions], key=lambda x: len(x) if x else float('inf'))\n\n  if not closest_workshop_path:\n    return []  # Could not find a valid path to any workshop\n\n  actions_to_workshop = get_actions_to_move(start_pos, closest_workshop_path[-1])\n\n  # Check the direction of the workshop relative to the agent's position\n  dx = closest_workshop_path[-1][0] - env._current_state.pos[0]\n  dy = closest_workshop_path[-1][1] - env._current_state.pos[1]\n\n  # Adjust the direction based on where the workshop is located\n  if dx > 0:\n    turn_actions = [craft.MOVE_RIGHT] * abs(dx)\n  elif dx < 0:\n    turn_actions = [craft.MOVE_LEFT] * abs(dx)\n  else:\n    turn_actions = []\n\n  if dy > 0:\n    turn_actions += [craft.MOVE_DOWN] * abs(dy)\n  elif dy < 0:\n    turn_actions += [craft.MOVE_UP] * abs(dy)\n\n  actions = actions_to_workshop + turn_actions + [craft.USE_ACTION]\n  \n  return actions", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T13:45:19.152776", "function_name": "craft", "function_body": "  def bfs(start_pos, goals):\n    queue = collections.deque([start_pos])\n    visited = set()\n    parent_map = {}\n\n    while queue:\n      current_pos = queue.popleft()\n\n      if current_pos in goals:\n        path = []\n        while current_pos != start_pos:\n          path.append(current_pos)\n          current_pos = parent_map[current_pos]\n        path.reverse()\n        return path\n\n      if current_pos in visited:\n        continue\n\n      visited.add(current_pos)\n\n      # Check all four possible directions\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        new_x = current_pos[0] + dx\n        new_y = current_pos[1] + dy\n\n        if 0 <= new_x < env._current_state.grid.shape[0] and 0 <= new_y < env._current_state.grid.shape[1]:\n          # Check if the cell is empty (not blocked by any item)\n          if not np.any(env._current_state.grid[new_x, new_y]):\n            queue.append((new_x, new_y))\n            parent_map[(new_x, new_y)] = current_pos\n\n    return None  # No path found\n  \n  def get_actions_to_move(from_pos, to_pos):\n    path = bfs(from_pos, [to_pos])\n    if not path:\n      return []\n    \n    action_map = {(-1, 0): craft.MOVE_UP, (1, 0): craft.MOVE_DOWN, (0, -1): craft.MOVE_LEFT, (0, 1): craft.MOVE_RIGHT}\n    actions = [action_map[(path[i][0] - path[i-1][0], path[i][1] - path[i-1][1])] for i in range(1, len(path))]\n    \n    return actions\n\n  idx = env.world.cookbook.index[item]\n\n  # Check if we have all the required primitives to craft this item\n  required_primitives = env.world.cookbook.primitives_for(idx)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory)}\n\n  missing_primitives = [(primitive, count - inventory_dict[primitive]) for primitive, count in required_primitives.items() if primitive not in inventory_dict or inventory_dict[primitive] < count]\n\n  # If we are missing any primitives, we need to collect them first\n  if missing_primitives:\n    actions = []\n    for primitive, amount_needed in missing_primitives:\n      primitive_idx = env.world.cookbook.index[primitive]\n      locations = [(i, j) for i in range(env._current_state.grid.shape[0]) for j in range(env._current_state.grid.shape[1]) if env._current_state.grid[i, j, primitive_idx] == 1]\n\n      # Find the closest location of this primitive\n      start_pos = env._current_state.pos\n      closest_location_path = min([bfs(start_pos, [loc]) for loc in locations], key=lambda x: len(x) if x else float('inf'))\n\n      if not closest_location_path:\n        return []  # Could not find a valid path to this primitive\n\n      actions_to_primitive = get_actions_to_move(start_pos, closest_location_path[-1])\n      actions.extend(actions_to_primitive + [craft.PICKUP_ACTION])\n\n      # Update the inventory and start position for the next primitive\n      inventory_dict[primitive] += 1\n      start_pos = closest_location_path[-1]\n    \n    return actions\n\n  # Determine the workshop index\n  recipe = env.world.cookbook.recipes[idx]\n  workshop_name = [key for key in recipe.keys() if 'WORKSHOP' in key][0]\n  workshop_idx = env.world.cookbook.index[workshop_name]\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = []\n  for i in range(env._current_state.grid.shape[0]):\n    for j in range(env._current_state.grid.shape[1]):\n      if env._current_state.grid[i, j, workshop_idx] == 1:\n        workshop_positions.append((i, j))\n\n  # Plan the path to the closest workshop position\n  start_pos = env._current_state.pos\n  closest_workshop_path = min([bfs(start_pos, [pos]) for pos in workshop_positions], key=lambda x: len(x) if x else float('inf'))\n\n  if not closest_workshop_path:\n    return []  # Could not find a valid path to any workshop\n\n  actions_to_workshop = get_actions_to_move(start_pos, closest_workshop_path[-1])\n\n  # Move to the workshop and perform the USE action\n  actions = actions_to_workshop + [craft.USE_ACTION]\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-11T13:46:44.577243", "function_name": "craft", "function_body": "  actions = []\n  index = env.world.cookbook.index.index(item)\n  if not env._current_state.satisfies(\"dummy\", index):\n    print(f\"Crafting {item} requires checking and collecting ingredients...\")\n    # Check if we have all the required primitives for crafting\n    recipe = env.world.cookbook.recipes[index]\n    current_inventory = env._current_state.inventory.copy()\n\n    # Calculate missing items\n    missing_items = {}\n    for i_kind, count in recipe.items():\n      if i_kind == \"_at\":\n        continue  # Skip workshop location\n      primitive_name = env.world.cookbook.index.get(i_kind)\n      required_count = count\n      current_count = current_inventory[i_kind]\n      if current_count < required_count:\n        missing_items[primitive_name] = required_count - current_count\n\n    if missing_items:\n      print(f\"Missing items: {missing_items}\")\n      # Collect missing primitives\n      for primitive, needed in missing_items.items():\n        collect_actions = collect(env, primitive)\n        actions.extend(collect_actions)\n\n    # Check again after collection\n    current_inventory = env._current_state.inventory.copy()\n    all_available = True\n    for i_kind, count in recipe.items():\n      if i_kind == \"_at\":\n        continue  # Skip workshop location\n      if current_inventory[i_kind] < count:\n        all_available = False\n        break\n\n    if not all_available:\n      print(\"Still missing items after collection. Cannot proceed with crafting.\")\n      return []\n\n  # Proceed to the workshop and craft the item\n  recipe = env.world.cookbook.recipes[index]\n  workshop_index = recipe[\"_at\"]\n  workshop_name = env.world.craftbook.index.get(workshop_index)\n  workshop_indices = [i for i, x in enumerate(env._current_state.grid) if np.any(x == workshop_index)]\n\n  # Find the nearest workshop\n  if not workshop_indices:\n    print(\"No available workshops.\")\n    return []\n\n  nearest_workshop_idx = None\n  min_distance = float('inf')\n  current_pos = env._current_state.pos\n\n  for idx in range(len(workshop_indices)):\n    x, y = np.argwhere(env._current_state.grid == workshop_index)[idx]\n    distance = abs(x - current_pos[0]) + abs(y - current_pos[1])\n    if distance < min_distance:\n      min_distance = distance\n      nearest_workshop_idx = idx\n\n  if nearest_workshop_idx is None:\n    print(\"Failed to find a nearest workshop.\")\n    return []\n\n  x, y = np.argwhere(env._current_state.grid == workshop_index)[nearest_workshop_idx]\n  path_to_workshop = pathfinding_a_star(current_pos, (x, y), env._current_state)\n\n  if not path_to_workshop:\n    print(\"No path to the nearest workshop.\")\n    return []\n\n  # Move towards the workshop\n  actions.extend(path_to_workshop)\n\n  # Face the correct direction to use the workshop\n  target_direction = determine_target_direction(env._current_state.pos, (x, y), env._current_state.dir)\n  turn_actions = turn_towards(env._current_state.dir, target_direction)\n  actions.extend(turn_actions)\n\n  # Use the workshop to craft the item\n  actions.append(craft.USE)\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-11T13:46:45.545125", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index of the desired item\n  i_item = env.world.cookbook.index[item]\n  \n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(i_item)\n  \n  # Collect primitives and intermediate items as needed\n  for primitive, count in required_primitives.items():\n    if env._current_state.inventory[primitive] < count:\n      actions.extend(collect_v2(env, primitive))\n      \n  # Determine the workshop where crafting needs to occur\n  recipe = env.world.cookbook.recipes[i_item]\n  workshop_name = list(recipe[\"_key\"])[0].split(\"_at\")[1].strip()\n  \n  # Find the position of the workshop in the grid\n  for y in range(env._current_state.grid.shape[1]):\n    for x in range(env._current_state.grid.shape[0]):\n      if env._current_state.grid[y, x, getattr(env.world, f\"{workshop_name}_index\")] == 1:\n        target_pos = (x, y)\n        break\n    else:\n      continue\n    break\n  \n  # Move towards the workshop\n  actions.extend(move_towards(env, target_pos))\n  \n  # Turn to face the workshop and use it to craft the item\n  actions.append(env.world.n_actions)  # Use action index\n  \n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-11T13:48:04.093577", "function_name": "craft", "function_body": "  # Get the index for the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item has a recipe in the cookbook\n  if item_index not in env.world.cookbook.recipes:\n    return []  # No recipe available for this item\n\n  # Get the required ingredients and workshop from the recipe\n  recipe = env.world.cookbook.recipes[item_index]\n  required_ingredients = {env.world.cookbook.index[i]: count for i, count in recipe.items() if i != \"_at\"}\n  workshop_name = recipe[\"_at\"]\n\n  # Find the index of the workshop needed for crafting this item\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Check if we already have all required ingredients in inventory\n  for ingredient, count in required_ingredients.items():\n    if env._current_state.inventory[ingredient] < count:\n      return []  # Missing some required ingredients\n\n  actions = []\n\n  # Find the workshop position in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    return []  # No workshop available for crafting this item\n\n  closest_workshop_pos = None\n  min_distance = float('inf')\n\n  # Find the closest workshop to the current position\n  for pos in workshop_positions:\n      distance = np.linalg.norm(np.array(pos) - np.array(env._current_state.pos))\n      if distance < min_distance:\n          min_distance = distance\n          closest_workshop_pos = tuple(pos)\n\n  # Calculate actions to move towards the closest workshop\n  actions.extend(move_towards(env, closest_workshop_pos))\n\n  # Rotate to face the workshop before using it\n  actions.append(face_direction(env, closest_workshop_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE action\n\n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-11T13:48:05.108920", "function_name": "craft", "function_body": "  # Find the index of the desired item\n  item_idx = env.world.cookbook.index[item]\n  \n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_idx)\n  \n  if not recipe:\n    print(f\"No recipe found for {item}\")\n    return []\n  \n  # Check if all ingredients are available in inventory or can be collected\n  required_ingredients = {}\n  actions_to_take = []\n\n  # Collect all primitives needed for the crafting item\n  primitives_needed = env.world.cookbook.primitives_for(item_idx)\n  for i_kind, count in primitives_needed.items():\n    primitive_name = env.world.cookbook.index.get(i_kind)\n    \n    if not primitive_name:\n      continue\n    \n    # Check if we already have enough of this primitive in our inventory\n    if env._current_state.inventory[i_kind] < count:\n      \n      # If not, generate actions to collect the required amount\n      for _ in range(count - env._current_state.inventory[i_kind]):\n        actions_to_take.extend(collect(env, primitive_name))\n  \n  # Check if we have all ingredients needed for crafting (including intermediate items)\n  for i_kind, count in recipe.items():\n    if i_kind == \"_key\": continue\n    \n    if i_kind not in primitives_needed:\n      required_ingredients[i_kind] = count\n  \n  # Collect all non-primitive ingredients needed for the crafting item\n  for i_kind, count in required_ingredients.items():\n    intermediate_item_name = env.world.cookbook.index.get(i_kind)\n    \n    if not intermediate_item_name:\n      continue\n    \n    # Check if we already have enough of this intermediate item in our inventory\n    if env._current_state.inventory[i_kind] < count:\n      \n      # If not, generate actions to craft the required amount (recursive call)\n      for _ in range(count - env._current_state.inventory[i_kind]):\n        actions_to_take.extend(craft_v1(env, intermediate_item_name))\n  \n  # After collecting all ingredients, go to the specified workshop and use it\n  workshop = recipe.get(\"_key\")\n  if not workshop:\n    print(f\"No workshop specified for crafting {item}\")\n    return []\n  \n  workshop_idx = env.world.cookbook.index[workshop]\n  actions_to_take.extend(move(env, workshop))\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-11T13:50:27.377574", "function_name": "craft", "function_body": "  idx = env.world.cookbook.index[item]\n\n  # Step 2: Check if we have all the required primitives to craft this item\n  # If not, return an empty action list\n  required_primitives = env.world.cookbook.primitives_for(idx)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory)}\n\n  if any(primitive not in inventory_dict or inventory_dict[primitive] < count for primitive, count in required_primitives.items()):\n    return []\n\n  # Step 3: Determine the workshop index\n  recipe = env.world.cookbook.recipes[idx]\n  workshop_name = list(recipe.keys())[-1]\n  workshop_idx = env.world.cookbook.index[workshop_name]\n\n  # Step 4: Find the position of the required workshop in the grid\n  # We need to find a cell with index equal to workshop_idx\n  workshop_pos_list = []\n  for i in range(env._current_state.grid.shape[0]):\n    for j in range(env._current_state.grid.shape[1]):\n      if env._current_state.grid[i, j, workshop_idx] == 1:\n        workshop_pos_list.append((i, j))\n\n  # Step 5: Plan the path to the closest workshop position\n  def bfs(start, goals):\n    queue = collections.deque([start])\n    visited = set()\n    parent_map = {}\n\n    while queue:\n      current_pos = queue.popleft()\n\n      if current_pos in goals:\n        path = []\n        while current_pos != start:\n          path.append(current_pos)\n          current_pos = parent_map[current_pos]\n        path.reverse()\n        return path\n\n      if current_pos in visited:\n        continue\n\n      visited.add(current_pos)\n\n      # Check all four possible directions\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        new_x = current_pos[0] + dx\n        new_y = current_pos[1] + dy\n\n        if 0 <= new_x < env._current_state.grid.shape[0] and 0 <= new_y < env._current_state.grid.shape[1]:\n          # Check if the cell is empty (not blocked by any item)\n          if not np.any(env._current_state.grid[new_x, new_y]):\n            queue.append((new_x, new_y))\n            parent_map[(new_x, new_y)] = current_pos\n\n    return None  # No path found\n\n  # Plan the path to the closest workshop\n  start_pos = env._current_state.pos\n  closest_workshop_path = min([bfs(start_pos, [workshop]) for workshop in workshop_pos_list], key=lambda x: len(x) if x else float('inf'))\n\n  if not closest_workshop_path:\n    return []  # Could not find a valid path to the workshop\n\n  # Step 6: Generate actions to move along the planned path\n  action_map = {(-1, 0): craft.MOVE_UP, (1, 0): craft.MOVE_DOWN, (0, -1): craft.MOVE_LEFT, (0, 1): craft.MOVE_RIGHT}\n  actions_to_workshop = [action_map[(closest_workshop_path[i][0] - closest_workshop_path[i-1][0], closest_workshop_path[i][1] - closest_workshop_path[i-1][1])] for i in range(1, len(closest_workshop_path))]\n\n  # Step 7: Move to the workshop and perform the USE action\n  actions = actions_to_workshop + [craft.USE_ACTION]\n  \n  return actions", "island_id": 2, "scores": {"3": 0.0}}
