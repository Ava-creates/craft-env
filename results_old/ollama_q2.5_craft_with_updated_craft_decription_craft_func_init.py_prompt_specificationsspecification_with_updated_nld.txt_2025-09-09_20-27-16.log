{"timestamp": "2025-09-10T11:40:19.630626", "function_name": "craft", "function_body": "  def collect_ingredient(name: str):\n    ingredient_idx = env.world.cookbook.index[name]\n    if env._current_state.inventory[ingredient_idx] == 0:\n      # Collect the ingredient if it's not already in inventory\n      return collect_v2(env, name)\n    return []\n\n  actions = []\n  \n  # Get the index for the desired item from the cookbook\n  item_idx = env.world.cookbook.index[item]\n  \n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_idx, {})\n  \n  if not recipe:\n    return []  # No recipe found\n  \n  # Determine the workshop where the crafting should happen\n  workshop_key = \"_key\"\n  workshop_index_str = recipe.pop(workshop_key, \"-1\")\n  \n  try:\n      workshop_index = int(workshop_index_str)\n  except ValueError:\n      return []  # Invalid workshop index in the recipe\n  \n  if workshop_index == -1:\n    return []  # Workshop not specified in the recipe\n  \n  # Get the list of workshops from the world configuration\n  workshop_indices = env.world.workshop_indices\n  \n  if workshop_index >= len(workshop_indices):\n    return []  # Invalid workshop index\n  \n  # Determine the target position for the workshop\n  target_workshop_pos = None\n  for y in range(env._current_state.grid.shape[1]):\n      for x in range(env._current_state.grid.shape[0]):\n          if env._current_state.grid[x, y, workshop_indices[workshop_index]] == 1:\n              target_workshop_pos = (x, y)\n              break\n      if target_workshop_pos is not None:\n          break\n  \n  if target_workshop_pos is None:\n    return []  # Workshop position not found in the grid\n\n  # Check and collect all required primitives\n  for ingredient_name, quantity in recipe.items():\n      ingredient_idx = env.world.cookbook.index[ingredient_name]\n      \n      # If we don't have enough of this ingredient, collect it\n      while env._current_state.inventory[ingredient_idx] < quantity:\n          actions.extend(collect_v2(env, ingredient_name))\n  \n  # Move to the target workshop\n  actions.extend(move_to(env._current_state, target_workshop_pos))\n\n  # Ensure we are facing the correct direction before using the workshop\n  if not is_facing_correct_direction(env._current_state, target_workshop_pos):\n      actions.extend(turn_towards_target(env._current_state, target_workshop_pos))\n  \n  # Perform the USE action at the workshop\n  actions.append(4)  # USE action index\n  \n  return actions", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T11:40:20.707116", "function_name": "craft", "function_body": "  def collect_ingredient(name: str):\n    ingredient_idx = env.world.cookbook.index[name]\n    if env._current_state.inventory[ingredient_idx] == 0:\n      # Collect the ingredient if it's not already in inventory\n      return collect_v2(env, name)\n    return []\n\n  actions = []\n  \n  item_idx = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes.get(item_idx, {})\n  \n  if not recipe:\n    return []  # No recipe found\n  \n  workshop_key = \"_key\"\n  workshop_index_str = recipe.pop(workshop_key, \"-1\")\n  \n  try:\n      workshop_index = int(workshop_index_str)\n  except ValueError:\n      return []  # Invalid workshop index in the recipe\n  \n  if workshop_index == -1:\n    return []  # Workshop not specified in the recipe\n  \n  workshop_indices = env.world.workshop_indices\n  \n  if workshop_index >= len(workshop_indices):\n    return []  # Invalid workshop index\n  \n  target_workshop_pos = None\n  for y in range(env._current_state.grid.shape[1]):\n      for x in range(env._current_state.grid.shape[0]):\n          if env._current_state.grid[x, y, workshop_indices[workshop_index]] == 1:\n              target_workshop_pos = (x, y)\n              break\n      if target_workshop_pos is not None:\n          break\n  \n  if target_workshop_pos is None:\n    return []  # Workshop position not found in the grid\n\n  for ingredient_name, quantity in recipe.items():\n      actions.extend(collect_ingredient(ingredient_name))\n  \n  # Collecting ingredients\n  for ingredient_name, quantity in recipe.items():\n      ingredient_idx = env.world.cookbook.index[ingredient_name]\n      \n      # If we don't have enough of this ingredient, collect it\n      while env._current_state.inventory[ingredient_idx] < quantity:\n          actions.extend(collect_v2(env, ingredient_name))\n\n  # Move to the target workshop\n  actions.extend(move_to(env._current_state, target_workshop_pos))\n  \n  if not is_facing_correct_direction(env._current_state, target_workshop_pos):\n      actions.extend(turn_towards_target(env._current_state, target_workshop_pos))\n  \n  # Perform the USE action at the workshop\n  actions.append(4)  # USE action index\n  \n  return actions", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T11:43:15.151547", "function_name": "craft", "function_body": "  def navigate_to(start_pos, goal_pos):\n      open_set = []\n      heapq.heappush(open_set, (0, start_pos))\n      came_from = {}\n      g_score = {start_pos: 0}\n      f_score = {start_pos: heuristic(start_pos, goal_pos)}\n\n      while open_set:\n          _, current = heapq.heappop(open_set)\n\n          if current == goal_pos:\n              return reconstruct_path(came_from, current)\n\n          for neighbor in neighbors(grid, current):\n              tentative_g_score = g_score[current] + 1\n\n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal_pos)\n                  heapq.heappush(open_set, (f_score[neighbor], neighbor))\n\n      return []\n\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def neighbors(grid, pos):\n      x, y = pos\n      results = [(x+1, y), (x-1, y), (x, y+1), (x, y-1)]\n      return [p for p in results if grid[p] == 0]\n\n  def reconstruct_path(came_from, current):\n      total_path = [current]\n      while current in came_from:\n          current = came_from[current]\n          total_path.append(current)\n      return list(reversed(total_path))\n\n  def determine_facing_direction(current_pos, target_pos):\n      if current_pos[0] < target_pos[0]:\n          return craft.ACTION_RIGHT\n      elif current_pos[0] > target_pos[0]:\n          return craft.ACTION_LEFT\n      elif current_pos[1] < target_pos[1]:\n          return craft.ACTION_DOWN\n      elif current_pos[1] > target_pos[1]:\n          return craft.ACTION_UP\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  current_inventory = {env.world.cookbook.index.get(i): env._current_state.inventory[i] for i in range(len(env._current_state.inventory))}\n\n  actions = []\n\n  # Check if we have all the primitives required\n  for primitive, count in required_primitives.items():\n      if current_inventory.get(primitive, 0) < count:\n          return []  # Return empty list as we do not have enough primitives\n\n  # Determine which workshop to use and navigate there\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_required = None\n  for key in recipe.keys():\n      if \"_at\" in key:\n          workshop_required = key.split(\"_at\")[1].strip()\n          break\n\n  if not workshop_required:\n      return []  # No valid workshop found in the recipe\n\n  # Find the position of the required workshop in the grid\n  workshop_index = env.world.cookbook.index[workshop_required]\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n  if not workshop_positions.size:\n      return []  # No valid workshop found on the grid\n\n  target_workshop_position = tuple(workshop_positions[0])\n\n  # Navigate to the workshop\n  path = navigate_to(env._current_state.pos, target_workshop_position)\n  actions.extend(path)\n\n  # Turn to face the workshop (assuming we can determine the direction needed)\n  facing_direction = determine_facing_direction(env._current_state.pos, target_workshop_position)\n  if facing_direction is not None:\n      actions.append(facing_direction)\n\n  # Perform USE action to craft the item\n  actions.append(craft.ACTION_USE)\n\n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T11:43:16.132836", "function_name": "craft", "function_body": "  def navigate_to(target_pos):\n      path = a_star_search(env._current_state.grid, env._current_state.pos, target_pos)\n      return path\n\n  def a_star_search(grid, start, goal):\n      open_set = []\n      heapq.heappush(open_set, (0, start))\n      came_from = {}\n      g_score = {start: 0}\n      f_score = {start: heuristic(start, goal)}\n\n      while open_set:\n          _, current = heapq.heappop(open_set)\n\n          if current == goal:\n              return reconstruct_path(came_from, current)\n\n          for neighbor in neighbors(grid, current):\n              tentative_g_score = g_score[current] + 1\n\n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                  heapq.heappush(open_set, (f_score[neighbor], neighbor))\n\n      return []\n\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def neighbors(grid, pos):\n      x, y = pos\n      results = [(x+1, y), (x-1, y), (x, y+1), (x, y-1)]\n      return [p for p in results if grid[p] == 0]\n\n  def determine_facing_direction(current_pos, target_pos):\n      cx, cy = current_pos\n      tx, ty = target_pos\n\n      if tx > cx:\n          return craft.ACTION_RIGHT\n      elif tx < cx:\n          return craft.ACTION_LEFT\n      elif ty > cy:\n          return craft.ACTION_DOWN\n      elif ty < cy:\n          return craft.ACTION_UP\n\n  def navigate_and_craft(target_workshop_position):\n      path = navigate_to(target_workshop_position)\n      actions.extend(path)\n\n      # Turn to face the workshop (assuming we can determine the direction needed)\n      facing_direction = determine_facing_direction(env._current_state.pos, target_workshop_position)\n      if facing_direction is not None:\n          actions.append(facing_direction)\n\n      # Perform USE action to craft the item\n      actions.append(craft.ACTION_USE)\n\n  def collect_primitive(primitive):\n      nonlocal actions\n\n      primitive_index = env.world.cookbook.index[primitive]\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if not primitive_positions.size:\n          return False\n\n      closest_primitive_position = tuple(min(primitive_positions, key=lambda p: heuristic(env._current_state.pos, p)))\n\n      path = navigate_to(closest_primitive_position)\n      actions.extend(path)\n\n      # Turn to face the primitive (assuming we can determine the direction needed)\n      facing_direction = determine_facing_direction(env._current_state.pos, closest_primitive_position)\n      if facing_direction is not None:\n          actions.append(facing_direction)\n\n      # Perform USE action to collect the primitive\n      actions.append(craft.ACTION_USE)\n\n      return True\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  current_inventory = {env.world.cookbook.index.get(i): env._current_state.inventory[i] for i in range(len(env._current_state.inventory))}\n\n  actions = []\n\n  # Collect missing primitives\n  for primitive, count in required_primitives.items():\n      while current_inventory.get(primitive, 0) < count:\n          if not collect_primitive(env.world.cookbook.index[primitive]):\n              return []  # Return empty list as we cannot find the required primitives\n\n          # Update inventory after collecting\n          current_inventory = {env.world.cookbook.index.get(i): env._current_state.inventory[i] for i in range(len(env._current_state.inventory))}\n\n  # Determine which workshop to use and navigate there\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_required = None\n  for key in recipe.keys():\n      if \"_at\" in key:\n          workshop_required = key.split(\"_at\")[1].strip()\n          break\n\n  if not workshop_required:\n      return []  # No valid workshop found in the recipe\n\n  # Find the position of the required workshop in the grid\n  workshop_index = env.world.cookbook.index[workshop_required]\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n  if not workshop_positions.size:\n      return []  # No valid workshop found on the grid\n\n  target_workshop_position = tuple(workshop_positions[0])\n\n  # Navigate and craft\n  navigate_and_craft(target_workshop_position)\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-10T11:45:09.073430", "function_name": "craft", "function_body": "  def navigate_to(current_pos, target_pos):\n      actions = []\n      current_x, current_y = current_pos\n      target_x, target_y = target_pos\n\n      # Determine direction to move horizontally\n      if current_x < target_x:\n          actions.extend([env.world.cookbook.index[\"RIGHT\"]] * (target_x - current_x))\n      elif current_x > target_x:\n          actions.extend([env.world.cookbook.index[\"LEFT\"]] * (current_x - target_x))\n\n      # Determine direction to move vertically\n      if current_y < target_y:\n          actions.extend([env.world.cookbook.index[\"DOWN\"]] * (target_y - current_y))\n      elif current_y > target_y:\n          actions.extend([env.world.cookbook.index[\"UP\"]] * (current_y - target_y))\n\n      return actions\n\n  goal_index = env.world.cookbook.index[item]\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n\n  actions = []\n\n  if not required_primitives:\n    return [] # No recipe or no primitives needed, can't craft\n\n  # Check if all required primitives are already in inventory\n  for primitive, count in required_primitives.items():\n    if env._current_state.inventory[primitive] < count:\n      return [] # Not enough primitives to start crafting\n\n  # Find the workshop where we need to go to craft this item\n  workshop_index = None\n  for recipe_key, recipe in env.world.cookbook.recipes.items():\n    if \"_at\" in recipe and recipe[\"_at\"] == goal_index:\n      workshop_index = env.world.cookbook.index[recipe_key]\n      break\n\n  # Check if the required workshop exists\n  if workshop_index is None:\n    return [] # No suitable workshop found\n\n  # Find all workshops of that type in the grid\n  workshop_positions = []\n  for y in range(env._current_state.grid.shape[0]):\n    for x in range(env._current_state.grid.shape[1]):\n      if env._current_state.grid[y, x, workshop_index] == 1:\n        workshop_positions.append((x, y))\n\n  # Find the closest workshop\n  current_pos = env._current_state.pos\n  closest_workshop = min(workshop_positions, key=lambda pos: abs(pos[0]-current_pos[0]) + abs(pos[1]-current_pos[1]), default=None)\n\n  if closest_workshop is None:\n    return [] # No workshops found\n\n  # Navigate to the closest workshop\n  actions.extend(navigate_to(current_pos, closest_workshop))\n\n  # Use action to craft the item at the workshop (this assumes correct orientation)\n  actions.append(env.world.cookbook.index[\"USE\"])\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T11:45:10.127963", "function_name": "craft", "function_body": "  goal_index = env.world.cookbook.index[item]\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n\n  actions = []\n\n  if not required_primitives:\n    return [] # No recipe or no primitives needed, can't craft\n\n  # Check if all required primitives are already in inventory\n  for primitive, count in required_primitives.items():\n    if env._current_state.inventory[primitive] < count:\n      return [] # Not enough primitives to start crafting\n\n  # Find the workshop where we need to go to craft this item\n  workshop_index = None\n  for recipe_key, recipe in env.world.cookbook.recipes.items():\n    if \"_at\" in recipe and recipe[\"_at\"] == goal_index:\n      workshop_index = env.world.cookbook.index[recipe_key]\n      break\n\n  # Check if the required workshop exists\n  if workshop_index is None:\n    return [] # No suitable workshop found\n\n  # Find all workshops of that type in the grid\n  workshop_positions = []\n  for y in range(env._current_state.grid.shape[0]):\n    for x in range(env._current_state.grid.shape[1]):\n      if env._current_state.grid[y, x, workshop_index] == 1:\n        workshop_positions.append((x, y))\n\n  # Find the closest workshop\n  current_x, current_y = env._current_state.pos\n  closest_workshop = min(workshop_positions, key=lambda pos: abs(pos[0]-current_x) + abs(pos[1]-current_y), default=None)\n\n  if closest_workshop is None:\n    return [] # No workshops found\n\n  # Navigate to the closest workshop\n  target_x, target_y = closest_workshop\n  while current_x < target_x:\n      actions.append(env.world.cookbook.index[\"RIGHT\"])\n      current_x += 1\n  while current_x > target_x:\n      actions.append(env.world.cookbook.index[\"LEFT\"])\n      current_x -= 1\n  while current_y < target_y:\n      actions.append(env.world.cookbook.index[\"DOWN\"])\n      current_y += 1\n  while current_y > target_y:\n      actions.append(env.world.cookbook.index[\"UP\"])\n      current_y -= 1\n\n  # Use action to craft the item at the workshop (this assumes correct orientation)\n  actions.append(env.world.cookbook.index[\"USE\"])\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T11:48:22.840293", "function_name": "craft", "function_body": "  def shortest_path(grid, start_pos, target_pos):\n      \"\"\"Finds the shortest path from start_pos to target_pos using BFS.\"\"\"\n      width, height = grid.shape[:2]\n      queue = collections.deque([start_pos])\n      visited = set()\n      parent_map = {start_pos: None}\n      \n      while queue:\n          current = queue.popleft()\n          if current == target_pos:\n              break\n          x, y = current\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height and grid[nx, ny].sum() == 0 and (nx, ny) not in visited:\n                  queue.append((nx, ny))\n                  visited.add((nx, ny))\n                  parent_map[(nx, ny)] = current\n      \n      path = []\n      while target_pos is not None:\n          path.append(target_pos)\n          target_pos = parent_map[target_pos]\n      \n      return path[::-1]\n\n  def move_towards(current_pos, current_dir, target_pos):\n      \"\"\"Determines the action to move towards target_pos from current_pos.\"\"\"\n      x_diff, y_diff = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n      \n      if x_diff < 0:\n          if current_dir == craft.DIRECTIONS.RIGHT:\n              actions.append(craft.ACTIONS.LEFT)\n              return\n          elif current_dir != craft.DIRECTIONS.LEFT:\n              actions.append(craft.ACTIONS.LEFT)\n              return\n      \n      elif x_diff > 0:\n          if current_dir == craft.DIRECTIONS.LEFT:\n              actions.append(craft.ACTIONS.RIGHT)\n              return\n          elif current_dir != craft.DIRECTIONS.RIGHT:\n              actions.append(craft.ACTIONS.RIGHT)\n              return\n      \n      elif y_diff < 0:\n          if current_dir == craft.DIRECTIONS.UP:\n              actions.append(craft.ACTIONS.DOWN)\n              return\n          elif current_dir != craft.DIRECTIONS.DOWN:\n              actions.append(craft.ACTIONS.DOWN)\n              return\n      \n      elif y_diff > 0:\n          if current_dir == craft.DIRECTIONS.DOWN:\n              actions.append(craft.ACTIONS.UP)\n              return\n          elif current_dir != craft.DIRECTIONS.UP:\n              actions.append(craft.ACTIONS.UP)\n              return\n\n  def direction_to(current_pos, target_pos):\n      \"\"\"Determines the direction to face towards target_pos from current_pos.\"\"\"\n      x_diff, y_diff = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n      \n      if x_diff < 0:\n          return craft.DIRECTIONS.LEFT\n      elif x_diff > 0:\n          return craft.DIRECTIONS.RIGHT\n      elif y_diff < 0:\n          return craft.DIRECTIONS.DOWN\n      elif y_diff > 0:\n          return craft.DIRECTIONS.UP\n      return current_dir\n\n  def turn_towards(target_dir):\n      \"\"\"Determines the action to turn towards target_dir.\"\"\"\n      if target_dir == craft.DIRECTIONS.LEFT:\n          actions.append(craft.ACTIONS.LEFT)\n      elif target_dir == craft.DIRECTIONS.RIGHT:\n          actions.append(craft.ACTIONS.RIGHT)\n      elif target_dir == craft.DIRECTIONS.DOWN:\n          actions.append(craft.ACTIONS.DOWN)\n      elif target_dir == craft.DIRECTIONS.UP:\n          actions.append(craft.ACTIONS.UP)\n\n  actions = []\n  \n  # Convert the item name to its index using the cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all required primitives for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  current_inventory = {env.world.cookbook.index.get(idx): count for idx, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  # If any required primitive is missing, return empty action list\n  for req_item, req_count in required_primitives.items():\n    if current_inventory.get(req_item, 0) < req_count:\n      return []\n\n  # Find the workshop required to craft this item\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_key = next(key for key in recipe.keys() if key.startswith(\"_at\"))\n  workshop_name = recipe[workshop_key]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n  \n  if len(workshop_positions) == 0:\n    return []\n\n  # Choose a random workshop position to head towards\n  workshop_pos = tuple(workshop_positions[env.world.random.randint(len(workshop_positions))])\n  \n  # Calculate the path from the current position to the chosen workshop\n  start_pos = env._current_state.pos\n  path = shortest_path(grid, start_pos, workshop_pos)\n  \n  if not path:\n    return []\n\n  # Generate actions to move along the calculated path\n  for target_pos in path[1:]:  # Skip the starting point\n      current_dir = env._current_state.dir\n      move_towards(env._current_state.pos, current_dir, target_pos)\n\n  # Turn towards the workshop to face it\n  workshop_dir = direction_to(env._current_state.pos, workshop_pos)\n  \n  while env._current_state.dir != workshop_dir:\n    turn_towards(workshop_dir)\n\n  # Add USE action to craft the item at the workshop\n  actions.append(craft.ACTIONS.USE)\n  \n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T11:48:23.901380", "function_name": "craft", "function_body": "  def shortest_path(grid, start_pos, target_pos):\n      width, height = grid.shape[:2]\n      queue = collections.deque([start_pos])\n      visited = set()\n      parent_map = {start_pos: None}\n      \n      while queue:\n          current = queue.popleft()\n          if current == target_pos:\n              break\n          x, y = current\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height and grid[nx, ny].sum() == 0 and (nx, ny) not in visited:\n                  queue.append((nx, ny))\n                  visited.add((nx, ny))\n                  parent_map[(nx, ny)] = current\n      \n      path = []\n      while target_pos is not None:\n          path.append(target_pos)\n          target_pos = parent_map[target_pos]\n      \n      return path[::-1]\n\n  def move_towards(current_pos, current_dir, target_pos):\n      x_diff, y_diff = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n      if x_diff < 0:\n          return craft.ACTIONS.LEFT if current_dir != craft.DIRECTIONS.LEFT else None\n      elif x_diff > 0:\n          return craft.ACTIONS.RIGHT if current_dir != craft.DIRECTIONS.RIGHT else None\n      elif y_diff < 0:\n          return craft.ACTIONS.DOWN if current_dir != craft.DIRECTIONS.DOWN else None\n      elif y_diff > 0:\n          return craft.ACTIONS.UP if current_dir != craft.DIRECTIONS.UP else None\n      return None\n\n  def direction_to(current_pos, target_pos):\n      x_diff, y_diff = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n      if x_diff < 0:\n          return craft.DIRECTIONS.LEFT\n      elif x_diff > 0:\n          return craft.DIRECTIONS.RIGHT\n      elif y_diff < 0:\n          return craft.DIRECTIONS.DOWN\n      elif y_diff > 0:\n          return craft.DIRECTIONS.UP\n      return current_dir\n\n  def turn_towards(target_dir):\n      if target_dir == craft.DIRECTIONS.LEFT:\n          return craft.ACTIONS.LEFT\n      elif target_dir == craft.DIRECTIONS.RIGHT:\n          return craft.ACTIONS.RIGHT\n      elif target_dir == craft.DIRECTIONS.DOWN:\n          return craft.ACTIONS.DOWN\n      elif target_dir == craft.DIRECTIONS.UP:\n          return craft.ACTIONS.UP\n      return None\n\n  actions = []\n  \n  # Convert the item name to its index using the cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all required primitives for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  current_inventory = {env.world.cookbook.index.get(idx): count for idx, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  # If any required primitive is missing, return empty action list\n  for req_item, req_count in required_primitives.items():\n    if current_inventory.get(req_item, 0) < req_count:\n      return []\n\n  # Find the workshop required to craft this item\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_key = next(key for key in recipe.keys() if key.startswith(\"_at\"))\n  workshop_name = recipe[workshop_key]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n  \n  if len(workshop_positions) == 0:\n    return []\n\n  # Choose a random workshop position to head towards\n  workshop_pos = tuple(workshop_positions[env.world.random.randint(len(workshop_positions))])\n  \n  # Calculate the path from the current position to the chosen workshop\n  start_pos = env._current_state.pos\n  path = shortest_path(grid, start_pos, workshop_pos)\n  \n  if not path:\n    return []\n\n  # Generate actions to move along the calculated path\n  for target_pos in path[1:]:  # Skip the starting point\n    action = move_towards(env._current_state.pos, env._current_state.dir, target_pos)\n    if action is None:\n      continue  # Handle cases where no valid move exists\n    actions.append(action)\n\n  # Turn towards the workshop to face it\n  workshop_dir = direction_to(env._current_state.pos, workshop_pos)\n  while env._current_state.dir != workshop_dir:\n    actions.append(turn_towards(workshop_dir))\n  \n  # Add USE action to craft the item at the workshop\n  actions.append(craft.ACTIONS.USE)\n  \n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T11:50:50.056676", "function_name": "craft", "function_body": "  def get_actions_for_movement(start, target, current_direction):\n    dx = target[0] - start[0]\n    dy = target[1] - start[1]\n\n    actions_to_take = []\n\n    # Determine the optimal path based on the absolute values of dx and dy\n    if abs(dx) >= abs(dy):  # Prioritize horizontal movement\n        while current_direction != (craft.RIGHT if dx > 0 else craft.LEFT):\n            actions_to_take.append(craft.TURN_RIGHT)\n            current_direction = (current_direction + 1) % 4\n        actions_to_take.extend([craft.MOVE_RIGHT for _ in range(dx)]) if dx > 0 else actions_to_take.extend([craft.MOVE_LEFT for _ in range(-dx)])\n    else:  # Prioritize vertical movement\n        while current_direction != (craft.DOWN if dy > 0 else craft.UP):\n            actions_to_take.append(craft.TURN_RIGHT)\n            current_direction = (current_direction + 1) % 4\n        actions_to_take.extend([craft.MOVE_DOWN for _ in range(dy)]) if dy > 0 else actions_to_take.extend([craft.MOVE_UP for _ in range(-dy)])\n\n    return actions_to_take, current_direction\n\n  def get_nearest_workshop(grid, workshop_index, start_position):\n      positions = np.argwhere(grid[:, :, workshop_index] > 0)\n      distances = np.linalg.norm(positions - start_position, axis=1)\n      nearest_index = np.argmin(distances)\n      return tuple(positions[nearest_index])\n\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n\n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  recipe = cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = env._current_state.inventory.copy()\n\n  required_ingredients = {cookbook.index[k]: v for k, v in recipe.items()}\n\n  can_craft = True\n\n  # Check if all ingredients are available\n  for ingredient_index, required_count in required_ingredients.items():\n    if available_inventory.get(ingredient_index, 0) < required_count:\n      can_craft = False\n      break\n\n  if not can_craft:\n    return []\n\n  current_position = np.array(env._current_state.pos)\n  nearest_workshop_pos = get_nearest_workshop(\n      env._current_state.grid, workshop_index, current_position\n  )\n\n  actions_to_take, _ = get_actions_for_movement(\n      current_position, nearest_workshop_pos, env._current_state.dir\n  )\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-10T11:50:51.095372", "function_name": "craft", "function_body": "  def get_actions_for_movement(start, target, current_direction):\n    dx = target[0] - start[0]\n    dy = target[1] - start[1]\n\n    actions_to_take = []\n\n    # Determine the optimal path\n    if abs(dx) > abs(dy):\n      # Horizontal movement first\n      if dx > 0:\n          while current_direction != craft.RIGHT:\n              actions_to_take.append(craft.TURN_RIGHT)\n              current_direction = (current_direction + 1) % 4\n          actions_to_take.extend([craft.MOVE_RIGHT for _ in range(dx)])\n      elif dx < 0:\n          while current_direction != craft.LEFT:\n              actions_to_take.append(craft.TURN_RIGHT)\n              current_direction = (current_direction + 1) % 4\n          actions_to_take.extend([craft.MOVE_LEFT for _ in range(-dx)])\n\n      if dy > 0:\n          while current_direction != craft.DOWN:\n              actions_to_take.append(craft.TURN_RIGHT)\n              current_direction = (current_direction + 1) % 4\n          actions_to_take.extend([craft.MOVE_DOWN for _ in range(dy)])\n      elif dy < 0:\n          while current_direction != craft.UP:\n              actions_to_take.append(craft.TURN_RIGHT)\n              current_direction = (current_direction + 1) % 4\n          actions_to_take.extend([craft.MOVE_UP for _ in range(-dy)])\n\n    else:\n      # Vertical movement first\n      if dy > 0:\n          while current_direction != craft.DOWN:\n              actions_to_take.append(craft.TURN_RIGHT)\n              current_direction = (current_direction + 1) % 4\n          actions_to_take.extend([craft.MOVE_DOWN for _ in range(dy)])\n      elif dy < 0:\n          while current_direction != craft.UP:\n              actions_to_take.append(craft.TURN_RIGHT)\n              current_direction = (current_direction + 1) % 4\n          actions_to_take.extend([craft.MOVE_UP for _ in range(-dy)])\n\n      if dx > 0:\n          while current_direction != craft.RIGHT:\n              actions_to_take.append(craft.TURN_RIGHT)\n              current_direction = (current_direction + 1) % 4\n          actions_to_take.extend([craft.MOVE_RIGHT for _ in range(dx)])\n      elif dx < 0:\n          while current_direction != craft.LEFT:\n              actions_to_take.append(craft.TURN_RIGHT)\n              current_direction = (current_direction + 1) % 4\n          actions_to_take.extend([craft.MOVE_LEFT for _ in range(-dx)])\n\n    return actions_to_take, current_direction\n\n  def get_nearest_workshop(grid, workshop_index, start_position):\n      positions = np.argwhere(grid[:, :, workshop_index] > 0)\n      distances = np.linalg.norm(start_position - positions, axis=1)\n      nearest_index = np.argmin(distances)\n      return tuple(positions[nearest_index])\n\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = env._current_state.inventory.copy()\n\n  # Check if all ingredients are available\n  required_ingredients = {cookbook.index[k]: v for k, v in recipe.items()}\n\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if not can_craft:\n    return []\n\n  # Find the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  nearest_workshop_pos = get_nearest_workshop(\n      env._current_state.grid, workshop_index, current_position\n  )\n\n  # Calculate actions to move the agent to the nearest workshop\n  actions_to_take, _ = get_actions_for_movement(\n      current_position, nearest_workshop_pos, env._current_state.dir\n  )\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T11:53:12.405481", "function_name": "craft", "function_body": "  def move_towards(current_pos, current_dir, target_pos):\n    delta_x = target_pos[0] - current_pos[0]\n    delta_y = target_pos[1] - current_pos[1]\n\n    # Determine the direction to move based on deltas\n    if delta_x > 0:\n      return craft.ACTIONS.RIGHT\n    elif delta_x < 0:\n      return craft.ACTIONS.LEFT\n    elif delta_y > 0:\n      return craft.ACTIONS.DOWN\n    else:\n      return craft.ACTIONS.UP\n\n  def turn_towards(target_dir):\n    current_dir = env._current_state.dir\n    if target_dir == (current_dir + 1) % 4:  # Turn right\n      return craft.ACTIONS.RIGHT\n    elif target_dir == (current_dir - 1) % 4:  # Turn left\n      return craft.ACTIONS.LEFT\n    else:  # Turn around\n      return craft.ACTIONS.RIGHT, craft.ACTIONS.RIGHT\n\n  def direction_to(current_pos, target_pos):\n    delta_x = target_pos[0] - current_pos[0]\n    delta_y = target_pos[1] - current_pos[1]\n\n    if abs(delta_x) > abs(delta_y):\n        # Horizontal movement dominates\n        return craft.DIRECTIONS.RIGHT if delta_x > 0 else craft.DIRECTIONS.LEFT\n    else:\n        # Vertical movement dominates\n        return craft.DIRECTIONS.DOWN if delta_y > 0 else craft.DIRECTIONS.UP\n\n  def shortest_path(grid, start, goal):\n      directions = [(1, 0), (-1, 0), (0, 1), (0, -1)]\n      queue = collections.deque([(start, [])])\n      visited = set([start])\n\n      while queue:\n          current_pos, path = queue.popleft()\n          if current_pos == goal:\n              return path + [goal]\n\n          for dx, dy in directions:\n              new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n              new_pos = (new_x, new_y)\n              if 0 <= new_x < grid.shape[0] and 0 <= new_y < grid.shape[1] and grid[new_x, new_y].sum() == 0 and new_pos not in visited:\n                  queue.append((new_pos, path + [current_pos]))\n                  visited.add(new_pos)\n\n      return None\n\n  actions = []\n  # Convert the item name to its index using the cookbook\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all required primitives for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  current_inventory = {env.world.cookbook.index.get(idx): count for idx, count in enumerate(env._current_state.inventory) if count > 0}\n\n  # If any required primitive is missing, return empty action list\n  for req_item, req_count in required_primitives.items():\n    if current_inventory.get(req_item, 0) < req_count:\n      return []\n\n  # Find the workshop required to craft this item\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_key = next(key for key in recipe.keys() if key.startswith(\"_at\"))\n  workshop_name = recipe[workshop_key]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    return []\n\n  # Choose a random workshop position to head towards\n  workshop_pos = tuple(workshop_positions[env.world.random.randint(len(workshop_positions))])\n\n  # Calculate the path from the current position to the chosen workshop\n  start_pos = env._current_state.pos\n  path = shortest_path(grid, start_pos, workshop_pos)\n\n  if not path:\n    return []\n\n  # Generate actions to move along the calculated path\n  for target_pos in path[1:]:  # Skip the starting point\n    action = move_towards(env._current_state.pos, env._current_state.dir, target_pos)\n    if action is None:\n      continue  # Handle cases where no valid move exists\n    actions.append(action)\n\n  # Turn towards the workshop to face it\n  workshop_dir = direction_to(env._current_state.pos, workshop_pos)\n  while env._current_state.dir != workshop_dir:\n    actions.append(turn_towards(workshop_dir))\n\n  # Add USE action to craft the item at the workshop\n  actions.append(craft.ACTIONS.USE)\n\n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T11:53:13.558066", "function_name": "craft", "function_body": "  actions = []\n  # Convert the item name to its index using the cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all required primitives for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  current_inventory = {env.world.cookbook.index.get(idx): count for idx, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  # If any required primitive is missing, return empty action list\n  for req_item, req_count in required_primitives.items():\n    if current_inventory.get(req_item, 0) < req_count:\n      return []\n\n  # Find the workshop required to craft this item\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_key = next(key for key in recipe.keys() if key.startswith(\"_at\"))\n  workshop_name = recipe[workshop_key]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n  \n  if len(workshop_positions) == 0:\n    return []\n\n  # Choose a random workshop position to head towards\n  workshop_pos = tuple(workshop_positions[env.world.random.randint(len(workshop_positions))])\n  \n  # Calculate the path from the current position to the chosen workshop\n  start_pos = env._current_state.pos\n  path = shortest_path(grid, start_pos, workshop_pos)\n  \n  if not path:\n    return []\n\n  # Generate actions to move along the calculated path\n  for target_pos in path[1:]:  # Skip the starting point\n    action = move_towards(env._current_state.pos, env._current_state.dir, target_pos)\n    if action is None:\n      continue  # Handle cases where no valid move exists\n    actions.append(action)\n\n  # Turn towards the workshop to face it\n  workshop_dir = direction_to(env._current_state.pos, workshop_pos)\n  while env._current_state.dir != workshop_dir:\n    actions.append(turn_towards(workshop_dir))\n  \n  # Add USE action to craft the item at the workshop\n  actions.append(craft.ACTIONS.USE)\n\n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T11:56:14.761279", "function_name": "craft", "function_body": "  def calculate_turns(current_dir_index: int, target_dir_index: int) -> tuple[list[int], int]:\n      turns_right = (target_dir_index - current_dir_index) % 4\n      turns_left = (current_dir_index - target_dir_index) % 4\n\n      if turns_right < turns_left:\n          return [craft.TURN_RIGHT for _ in range(turns_right)], turns_right\n      else:\n          return [craft.TURN_LEFT for _ in range(turns_left)], turns_left\n\n  def calculate_direction(dx: int, dy: int) -> int:\n      \"\"\"Determine the direction to move based on dx and dy.\"\"\"\n      if abs(dx) > abs(dy):\n          return craft.RIGHT if dx > 0 else craft.LEFT\n      else:\n          return craft.DOWN if dy > 0 else craft.UP\n\n  def calculate_moves(current_position: np.ndarray, target_position: tuple) -> list[int]:\n      \"\"\"Calculate the sequence of moves to reach the target position.\"\"\"\n      actions = []\n      current_x, current_y = current_position\n      target_x, target_y = target_position\n      \n      # Determine primary and secondary directions based on dx and dy\n      dx = target_x - current_x\n      dy = target_y - current_y\n\n      primary_direction = calculate_direction(dx, dy)\n      \n      if primary_direction in (craft.RIGHT, craft.LEFT):\n          secondary_direction = craft.DOWN if dy > 0 else craft.UP\n      else:\n          secondary_direction = craft.RIGHT if dx > 0 else craft.LEFT\n      \n      # Calculate the number of moves required for each direction\n      steps_primary = abs(dx) if primary_direction in (craft.RIGHT, craft.LEFT) else abs(dy)\n      steps_secondary = abs(dy) if primary_direction in (craft.RIGHT, craft.LEFT) else abs(dx)\n      \n      # Determine the current and target direction indices\n      dir_map = {craft.RIGHT: 0, craft.DOWN: 1, craft.LEFT: 2, craft.UP: 3}\n      current_dir_index = dir_map[env._current_state.dir]\n      primary_dir_index = dir_map[primary_direction]\n      \n      # Calculate turns to reach the primary direction\n      turns_primary, _ = calculate_turns(current_dir_index, primary_dir_index)\n      actions.extend(turns_primary)\n      \n      # Add moves in the primary direction\n      for _ in range(steps_primary):\n          actions.append(primary_direction)\n          \n      # Determine the current direction after moving in the primary direction\n      new_current_dir_index = dir_map[primary_direction]\n      \n      # Calculate turns to reach the secondary direction\n      secondary_dir_index = dir_map[secondary_direction]\n      turns_secondary, _ = calculate_turns(new_current_dir_index, secondary_dir_index)\n      actions.extend(turns_secondary)\n      \n      # Add moves in the secondary direction\n      for _ in range(steps_secondary):\n          actions.append(secondary_direction)\n          \n      return actions\n\n  def navigate_to_position(env, current_position: np.ndarray, target_position: tuple) -> list[int]:\n      \"\"\"Navigate the agent to the target position.\"\"\"\n      actions = calculate_moves(current_position, target_position)\n      return actions\n\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = env._current_state.inventory.copy()\n\n  # Check if all ingredients are available\n  required_ingredients = {cookbook.index[k]: v for k, v in recipe.items()}\n\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if not can_craft:\n    return []\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No available workshop to craft item\")\n\n  # Select the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n  # Navigate to the nearest workshop\n  actions_to_take = navigate_to_position(env, current_position, nearest_workshop_pos)\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T11:56:15.835437", "function_name": "craft", "function_body": "  def calculate_turns(current_dir_index: int, target_dir_index: int) -> tuple[list[int], int]:\n      turns_right = (target_dir_index - current_dir_index) % 4\n      turns_left = (current_dir_index - target_dir_index) % 4\n\n      if turns_right < turns_left:\n          return [craft.TURN_RIGHT for _ in range(turns_right)], turns_right\n      else:\n          return [craft.TURN_LEFT for _ in range(turns_left)], turns_left\n\n  def calculate_direction(dx: int, dy: int) -> int:\n      if dx > 0:\n          return craft.RIGHT\n      elif dx < 0:\n          return craft.LEFT\n      elif dy > 0:\n          return craft.DOWN\n      else: # dy < 0\n          return craft.UP\n\n  def calculate_moves(current_position: np.ndarray, target_position: tuple) -> list[int]:\n      actions = []\n      dx = target_position[0] - current_position[0]\n      dy = target_position[1] - current_position[1]\n\n      if abs(dx) >= abs(dy):\n          # Move horizontally first\n          if dx > 0:\n              actions.extend([craft.MOVE_RIGHT for _ in range(dx)])\n          elif dx < 0:\n              actions.extend([craft.MOVE_LEFT for _ in range(-dx)])\n          \n          if dy > 0:\n              actions.extend([craft.MOVE_DOWN for _ in range(dy)])\n          elif dy < 0:\n              actions.extend([craft.MOVE_UP for _ in range(-dy)])\n      else:\n          # Move vertically first\n          if dy > 0:\n              actions.extend([craft.MOVE_DOWN for _ in range(dy)])\n          elif dy < 0:\n              actions.extend([craft.MOVE_UP for _ in range(-dy)])\n\n          if dx > 0:\n              actions.extend([craft.MOVE_RIGHT for _ in range(dx)])\n          elif dx < 0:\n              actions.extend([craft.MOVE_LEFT for _ in range(-dx)])\n\n      return actions\n\n  def navigate_to_position(env, current_position: np.ndarray, target_position: tuple) -> list[int]:\n      actions = []\n      dx = target_position[0] - current_position[0]\n      dy = target_position[1] - current_position[1]\n\n      if dx == 0 and dy == 0:  # Already at the target position\n          return []\n\n      target_direction = calculate_direction(dx, dy)\n      current_dir_index = {craft.RIGHT: 0, craft.DOWN: 1, craft.LEFT: 2, craft.UP: 3}[env._current_state.dir]\n      target_dir_index = {craft.RIGHT: 0, craft.DOWN: 1, craft.LEFT: 2, craft.UP: 3}[target_direction]\n\n      turns, _ = calculate_turns(current_dir_index, target_dir_index)\n      actions.extend(turns)\n\n      moves = calculate_moves(current_position, target_position)\n      actions.extend(moves)\n\n      return actions\n\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = env._current_state.inventory.copy()\n\n  # Check if all ingredients are available\n  required_ingredients = {cookbook.index[k]: v for k, v in recipe.items()}\n\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if not can_craft:\n    return []\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No available workshop to craft item\")\n\n  # Select the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n  # Navigate to the nearest workshop\n  actions_to_take = navigate_to_position(env, current_position, nearest_workshop_pos)\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T11:58:07.437020", "function_name": "craft", "function_body": "  def collect_ingredient(name: str):\n    ingredient_idx = env.world.cookbook.index[name]\n    if env._current_state.inventory[ingredient_idx] >= recipe.get(ingredient_idx, 0):\n      return []\n    # Collect the ingredient if it's not already in inventory\n    return collect_v2(env, name)\n\n  actions = []\n\n  # Get the index for the desired item from the cookbook\n  item_idx = env.world.cookbook.index[item]\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_idx, {})\n\n  if not recipe:\n    return []  # No recipe found\n\n  # Determine the workshop where the crafting should happen\n  workshop_key = \"_key\"\n  workshop_index_str = recipe.pop(workshop_key, \"-1\")\n\n  try:\n      workshop_index = int(workshop_index_str)\n  except ValueError:\n      return []  # Invalid workshop index in the recipe\n\n  if workshop_index == -1:\n    return []  # Workshop not specified in the recipe\n\n  # Get the list of workshops from the world configuration\n  workshop_indices = env.world.workshop_indices\n\n  if workshop_index >= len(workshop_indices):\n    return []  # Invalid workshop index\n\n  # Determine the target position for the workshop\n  target_workshop_pos = None\n  for y in range(env._current_state.grid.shape[1]):\n      for x in range(env._current_state.grid.shape[0]):\n          if env._current_state.grid[x, y, workshop_indices[workshop_index]] == 1:\n              target_workshop_pos = (x, y)\n              break\n      if target_workshop_pos is not None:\n          break\n\n  if target_workshop_pos is None:\n    return []  # Workshop position not found in the grid\n\n  # Check and collect all required primitives\n  for ingredient_name, quantity in recipe.items():\n      ingredient_idx = env.world.cookbook.index[ingredient_name]\n\n      # If we don't have enough of this ingredient, collect it\n      if env._current_state.inventory[ingredient_idx] < quantity:\n          actions.extend(collect_ingredient(ingredient_name))\n\n  # Move to the target workshop\n  actions.extend(move_to(env._current_state, target_workshop_pos))\n\n  # Perform the USE action at the workshop\n  actions.append(4)  # USE action index\n\n  return actions", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T11:58:08.485293", "function_name": "craft", "function_body": "  def collect_ingredient(name: str):\n    ingredient_idx = env.world.cookbook.index[name]\n    if env._current_state.inventory[ingredient_idx] >= recipe[ingredient_idx]:\n      return []\n    # Collect the ingredient if it's not already in inventory\n    return collect_v2(env, name)\n\n  actions = []\n\n  # Get the index for the desired item from the cookbook\n  item_idx = env.world.cookbook.index[item]\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_idx, {})\n\n  if not recipe:\n    return []  # No recipe found\n\n  # Determine the workshop where the crafting should happen\n  workshop_key = \"_key\"\n  workshop_index_str = recipe.pop(workshop_key, \"-1\")\n\n  try:\n      workshop_index = int(workshop_index_str)\n  except ValueError:\n      return []  # Invalid workshop index in the recipe\n\n  if workshop_index == -1:\n    return []  # Workshop not specified in the recipe\n\n  # Get the list of workshops from the world configuration\n  workshop_indices = env.world.workshop_indices\n\n  if workshop_index >= len(workshop_indices):\n    return []  # Invalid workshop index\n\n  # Determine the target position for the workshop\n  target_workshop_pos = None\n  for y in range(env._current_state.grid.shape[1]):\n      for x in range(env._current_state.grid.shape[0]):\n          if env._current_state.grid[x, y, workshop_indices[workshop_index]] == 1:\n              target_workshop_pos = (x, y)\n              break\n      if target_workshop_pos is not None:\n          break\n\n  if target_workshop_pos is None:\n    return []  # Workshop position not found in the grid\n\n  # Check and collect all required primitives\n  for ingredient_name, quantity in recipe.items():\n      ingredient_idx = env.world.cookbook.index[ingredient_name]\n\n      # If we don't have enough of this ingredient, collect it\n      while env._current_state.inventory[ingredient_idx] < quantity:\n          actions.extend(collect_ingredient(ingredient_name))\n\n  # Move to the target workshop\n  actions.extend(move_to(env._current_state, target_workshop_pos))\n\n  # Perform the USE action at the workshop\n  actions.append(4)  # USE action index\n\n  return actions", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T11:59:01.804887", "function_name": "craft", "function_body": "  # Check if the goal is a primitive\n  if item in env.world.cookbook.primitives:\n      print(f\"{item} is a primitive and cannot be crafted.\")\n      return []\n\n  # Get the index for the desired item\n  goal_index = env.world.cookbook.index[item]\n  \n  # If no recipe exists, return empty list\n  if goal_index not in env.world.cookbook.recipes:\n      print(f\"No recipe found for {item}.\")\n      return []\n\n  # Fetch the required primitives and their counts from the recipe\n  recipe = env.world.cookbook.recipes[goal_index]\n  workshop_index = None\n  \n  # Determine which workshop is needed based on the \"_at\" key in the recipe\n  if '_at' in recipe:\n      workshop_name = recipe['_at']\n      workshop_index = env.world.cookbook.index[workshop_name]\n\n      # Remove the \"_at\" entry from the recipe as it's not an ingredient\n      del recipe['_at']\n\n  # Check if we have all required primitives in our inventory\n  for primitive, count in recipe.items():\n      primitive_index = env.world.cookbook.index[primitive]\n      if env._current_state.inventory[primitive_index] < count:\n          print(f\"Missing {count} of {primitive}.\")\n          return []\n\n  # Navigate to the workshop and perform the USE action\n  actions_to_take = []\n  \n  # Assuming we have a function `navigate` that returns actions needed to reach a position\n  # For simplicity, let's assume it exists here\n  if workshop_index:\n      workshop_position = find_workshop_position(env._current_state.grid, workshop_index)\n      actions_to_take.extend(navigate(env._current_state, workshop_position))\n      \n      # Add USE action once we are at the workshop\n      actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-10T11:59:02.788247", "function_name": "craft", "function_body": "  actions = []\n  \n  # Check if the agent has all required primitives and intermediate items\n  goal_index = env.world.cookbook.index[item]\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  \n  # Check inventory for required primitives\n  for primitive, count in required_primitives.items():\n    while env._current_state.inventory[primitive] < count:\n      # Collect the missing primitive if not enough is present in inventory\n      actions.extend(collect(env, env.world.cookbook.index.get(primitive)))\n      \n  # Once all required items are collected, go to the workshop and craft the item\n  workshop_index = next((i for i, w in enumerate(env.world.workshop_indices) \n                          if f\"workshop{i}\" in env.world.cookbook.recipes[goal_index][\"_key\"]), None)\n  \n  if workshop_index is not None:\n    # Navigate to the workshop and face it\n    actions.extend(navigate_to_workshop(env, workshop_index))\n    \n    # Perform USE action at the workshop\n    actions.append(env.world.N_ACTIONS - 1)  # Assuming USE is the last action index\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-10T12:00:11.142098", "function_name": "craft", "function_body": "  actions = []\n  cookbook = env.world.cookbook\n  index = cookbook.index\n\n  # Convert the item name to its corresponding index\n  item_index = index[item]\n\n  # Check if the item has a recipe in the cookbook\n  if item_index not in cookbook.recipes:\n    return actions  # No recipe for this item, return empty list\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes[item_index]\n  \n  # Determine which workshop is needed to craft the item\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      raise ValueError(f\"No workshop specified in the recipe for {item}\")\n\n  workshop_index = index[workshop_name]\n\n  # Get the list of workshops from the environment\n  workshop_indices = env.world.workshop_indices\n\n  # Find the correct workshop's position on the grid\n  workshop_pos = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_pos) == 0:\n    raise ValueError(f\"No {workshop_name} found in the environment\")\n\n  # Assume we take the first occurrence of the workshop (assuming there might be multiple)\n  target_workshop = tuple(workshop_pos[0])\n\n  # Get the required ingredients for the item from the recipe\n  required_ingredients = {ingredient: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n\n  # Check if we have all required ingredients in inventory\n  have_all_ingredients = True\n  actions_to_collect_ingredients = []\n\n  for ingredient_name, required_count in required_ingredients.items():\n    ingredient_index = index[ingredient_name]\n    current_count = env._current_state.inventory[ingredient_index]\n\n    if current_count < required_count:\n      # We need to collect more of this ingredient\n      have_all_ingredients = False\n\n      # Get the positions of the ingredient on the grid\n      ingredient_pos = np.argwhere(env._current_state.grid[:, :, ingredient_index] > 0)\n      \n      if len(ingredient_pos) == 0:\n        raise ValueError(f\"No {ingredient_name} found in the environment\")\n\n      # Assume we take the first occurrence of the ingredient (assuming there might be multiple)\n      target_ingredient = tuple(ingredient_pos[0])\n\n      # Calculate actions to move to the ingredient and collect it\n      path_to_ingredient = get_path(env._current_state, target_ingredient)\n      \n      if path_to_ingredient is None:\n        raise ValueError(f\"No valid path to {ingredient_name} found\")\n\n      actions_to_collect_ingredients.extend(path_to_ingredient)\n      actions_to_collect_ingredients.append(4)  # USE action to collect the ingredient\n\n  # If we don't have all ingredients, return the actions needed to collect them\n  if not have_all_ingredients:\n    return actions_to_collect_ingredients\n\n  # If we have all ingredients, calculate the path to the workshop and craft the item\n  path_to_workshop = get_path(env._current_state, target_workshop)\n  \n  if path_to_workshop is None:\n    raise ValueError(f\"No valid path to {workshop_name} found\")\n\n  actions.extend(path_to_workshop)\n\n  # Add actions to face the correct direction before using the workshop\n  facing_direction = calculate_facing_direction(env._current_state, target_workshop)\n  actions.extend(facing_direction)\n\n  actions.append(4)  # USE action to craft the item\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-10T12:00:12.110513", "function_name": "craft", "function_body": "  # Convert item name to index\n  item_idx = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_idx not in env.world.cookbook.recipes:\n    return []\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes[item_idx]\n  \n  # Collect all required primitives and intermediate items\n  actions_to_take = []\n  for ingredient, count in recipe.items():\n      if ingredient == \"_key\":\n          continue  # Skip the \"_key\" entry which specifies the workshop\n      ingredient_idx = env.world.cookbook.index[ingredient]\n\n      # Check how many of this ingredient we already have\n      current_count = env._current_state.inventory[ingredient_idx]\n      \n      # Calculate the number of additional items needed\n      additional_needed = count - current_count\n      \n      if additional_needed > 0:\n          # Collect the required primitives/intermediate items\n          collect_actions = collect(env, ingredient)\n          actions_to_take.extend(collect_actions)\n\n  # Move to the correct workshop and craft the item\n  workshop_key = recipe[\"_key\"]\n  workshop_idx = env.world.cookbook.index[workshop_key]\n  \n  # Find the position of the workshop on the grid\n  workshop_pos = np.argwhere(env._current_state.grid[:, :, workshop_idx] == 1)\n  if len(workshop_pos) == 0:\n      return []  # Workshop not found, cannot craft item\n\n  # Move to the workshop\n  move_actions = move_to_position(env, tuple(workshop_pos[0]))\n  actions_to_take.extend(move_actions)\n\n  # Face the workshop and use the USE action to craft the item\n  face_workshop_action = face_direction(env, workshop_pos[0])\n  actions_to_take.append(face_workshop_action)\n  \n  actions_to_take.append(craft.ACTION_USE)\n\n  return actions_to_take", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-10T12:01:27.333333", "function_name": "craft", "function_body": "  actions = []\n  # Convert the item name to its index using the cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all required primitives for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  current_inventory = {env.world.cookbook.index.get(idx): count for idx, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  # If any required primitive is missing, return empty action list\n  for req_item, req_count in required_primitives.items():\n    if current_inventory.get(req_item, 0) < req_count:\n      return []\n\n  # Find the workshop required to craft this item\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_key = next(key for key in recipe.keys() if key.startswith(\"_at\"))\n  workshop_name = recipe[workshop_key]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n  \n  if len(workshop_positions) == 0:\n    return []\n\n  # Choose a random workshop position to head towards\n  workshop_pos = tuple(workshop_positions[env.world.random.randint(len(workshop_positions))])\n\n  # Calculate the path from the current position to the chosen workshop\n  start_pos = env._current_state.pos\n  path = shortest_path(grid, start_pos, workshop_pos)\n\n  if not path:\n    return []\n\n  # Generate actions to move along the calculated path\n  for target_pos in path[1:]:  # Skip the starting point\n    action = move_towards(env._current_state.pos, env._current_state.dir, target_pos)\n    if action is None:\n      continue  # Handle cases where no valid move exists\n    actions.append(action)\n\n  # Turn towards the workshop to face it\n  workshop_dir = direction_to(env._current_state.pos, workshop_pos)\n  while env._current_state.dir != workshop_dir:\n    actions.append(turn_towards(workshop_dir))\n\n  # Add USE action to craft the item at the workshop\n  actions.append(craft.ACTIONS.USE)\n\n  return actions", "island_id": 1, "scores": {"3": 0.0}}
