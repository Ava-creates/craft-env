> 0 else craft.MOVE_LEFT\n    actions_to_take.extend([move_action_x for _ in range(abs(dx))])\n\n    # Then move along Y axis\n    move_action_y = craft.MOVE_DOWN if dy > 0 else craft.MOVE_UP\n    actions_to_take.extend([move_action_y for _ in range(abs(dy))])\n  else:\n    # Move along Y axis first\n    move_action_y = craft.MOVE_DOWN if dy > 0 else craft.MOVE_UP\n    actions_to_take.extend([move_action_y for _ in range(abs(dy))])\n\n    # Then move along X axis\n    move_action_x = craft.MOVE_RIGHT if dx > 0 else craft.MOVE_LEFT\n    actions_to_take.extend([move_action_x for _ in range(abs(dx))])\n\n  # Determine the final direction needed based on the relative position of the workshop\n  current_direction = env._current_state.dir\n\n  # Calculate the number of turns needed to reach the final direction\n  target_direction = np.arctan2(nearest_workshop_pos[1] - current_position[1], nearest_workshop_pos[0] - current_position[0])\n  target_direction = (target_direction * 4 / (2 * np.pi) + 4) % 4\n\n  turns_needed = (target_direction - current_direction) % 4\n\n  # Add turn actions based on the number of turns needed\n  if turns_needed == 1:\n    actions_to_take.append(craft.TURN_RIGHT)\n  elif turns_needed == 2:\n    actions_to_take.extend([craft.TURN_RIGHT, craft.TURN_RIGHT])\n  elif turns_needed == 3:\n    actions_to_take.append(craft.TURN_LEFT)\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T19:18:36.004898", "function_name": "craft", "function_body": "  actions = []\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  item_index = index.index(item)\n\n  # Check if the goal is a primitive or not in the recipes\n  if item_index in cookbook.primitives:\n    return []\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes[item_index]\n\n  def collect_primitive(primitive_name):\n    nonlocal actions\n    primitive_index = index.index(primitive_name)\n    if env._current_state.inventory[primitive_index] == 0:\n      # Find a cell with the primitive\n      target_pos = find_nearest(env, primitive_index)\n      if target_pos is None:\n        return False\n      actions.extend(move_to(env, target_pos))\n      actions.append(craft.COLLECT_FUNC(primitive_name))\n    return True\n\n  def move_to(state, pos):\n    # Simple BFS to find a path to the target position\n    from collections import deque\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    start_pos = state.pos\n    queue = deque([(start_pos, [])])\n    visited = set([start_pos])\n\n    while queue:\n      current_pos, path = queue.popleft()\n      if current_pos == pos:\n        return [craft.MOVE_FUNC(dir) for dir in path]\n      for d in directions:\n        next_pos = (current_pos[0] + d[0], current_pos[1] + d[1])\n        if 0 <= next_pos[0] < state.grid.shape[0] and 0 <= next_pos[1] < state.grid.shape[1]:\n          if next_pos not in visited and not any(state.grid[next_pos]):\n            visited.add(next_pos)\n            queue.append((next_pos, path + [d]))\n\n    return []\n\n  def find_nearest(env, kind_index):\n    # Simple BFS to find the nearest cell with the specified kind\n    from collections import deque\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = deque([env._current_state.pos])\n    visited = set([env._current_state.pos])\n\n    while queue:\n      current_pos = queue.popleft()\n      if env._current_state.grid[current_pos][kind_index]:\n        return current_pos\n      for d in directions:\n        next_pos = (current_pos[0] + d[0], current_pos[1] + d[1])\n        if 0 <= next_pos[0] < env._current_state.grid.shape[0] and 0 <= next_pos[1] < env._current_state.grid.shape[1]:\n          if next_pos not in visited and not any(env._current_state.grid[next_pos]):\n            visited.add(next_pos)\n            queue.append(next_pos)\n\n    return None\n\n  # Collect all required primitives for the recipe\n  for ingredient, count in recipe.items():\n    if ingredient == \"_key\":\n      continue\n    for _ in range(count):\n      if not collect_primitive(ingredient):\n        return []\n\n  # Go to the workshop and use it\n  workshop_index = index.index(recipe[\"_key\"])\n  workshop_pos = find_nearest(env, workshop_index)\n  if workshop_pos is None:\n    return []\n  actions.extend(move_to(env._current_state, workshop_pos))\n  actions.append(craft.USE_FUNC())\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-10T19:18:36.994395", "function_name": "craft", "function_body": "  # Initialize actions list\n  actions = []\n\n  # Get the index of the desired item using the cookbook's index\n  i_goal = env.world.cookbook.index[item]\n  \n  # Check if we have all the primitives required for crafting the item\n  primitives_required = env.world.cookbook.primitives_for(i_goal)\n  \n  # Get the current inventory from the state\n  inventory = np.copy(env._current_state.inventory)\n\n  # Verify if all required primitives are present in the inventory\n  missing_primitives = {i_kind: count for i_kind, count in primitives_required.items() if inventory[i_kind] < count}\n  \n  # If any primitives are missing, return an empty action list\n  if missing_primitives:\n    print(f\"Missing primitives: {missing_primitives}\")\n    return actions\n  \n  # Determine the workshop required to craft the item\n  recipe = env.world.cookbook.recipes[i_goal]\n  workshop_required = recipe[\"_at\"]\n  \n  # Find the nearest workshop of the required type in the grid\n  workshop_index = env.world.cookbook.index[workshop_required]\n  \n  # Get the current position and direction of the agent\n  current_pos = env._current_state.pos\n  current_dir = env._current_state.dir\n  \n  # Placeholder: Implement logic to find the nearest workshop of the required type in the grid\n  def find_nearest_workshop(grid, pos, workshop_index):\n    # Use BFS to find the nearest workshop of the required type in the grid\n    queue = collections.deque([(pos, [])])\n    visited = set()\n    \n    while queue:\n      (x, y), path = queue.popleft()\n      \n      if (x, y) in visited:\n        continue\n      \n      visited.add((x, y))\n      \n      # Check if the current cell is the workshop\n      if grid[x, y, workshop_index] == 1:\n        return path\n      \n      # Explore neighbors (UP, DOWN, LEFT, RIGHT)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and (nx, ny) not in visited:\n          queue.append(((nx, ny), path + [(dx, dy)]))\n    \n    return None\n  \n  # Find the path to the nearest workshop\n  path_to_workshop = find_nearest_workshop(env._current_state.grid, current_pos, workshop_index)\n  \n  if path_to_workshop is None:\n    print(\"No path found to the required workshop.\")\n    return actions\n  \n  # Convert the path into a sequence of actions (LEFT, RIGHT, UP, DOWN) and move towards the workshop\n  action_map = {(-1, 0): craft.UP, (1, 0): craft.DOWN, (0, -1): craft.LEFT, (0, 1): craft.RIGHT}\n  \n  for dx, dy in path_to_workshop:\n    direction = action_map[(dx, dy)]\n    actions.append(direction)\n  \n  # Once at the workshop, turn to face it\n  # Placeholder: Implement logic to determine the correct direction to face the workshop\n  \n  # Placeholder: Implement logic to perform the USE action to craft the item\n  # Placeholder: Implement logic to check if crafting was successful and return the appropriate actions\n\n  # Example: Add the USE action after reaching the workshop (assuming facing the correct direction)\n  actions.append(craft.USE)\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-10T19:21:33.749892", "function_name": "craft", "function_body": "  def navigate_to(position):\n    \"\"\"Helper function to navigate to a given position.\"\"\"\n    current_pos = env._current_state.pos\n    x_diff = position[0] - current_pos[0]\n    y_diff = position[1] - current_pos[1]\n\n    actions = []\n\n    # Move vertically first\n    if y_diff > 0:\n      actions.extend([craft.ACTION_DOWN] * y_diff)\n    elif y_diff < 0:\n      actions.extend([craft.ACTION_UP] * abs(y_diff))\n\n    # Then move horizontally\n    if x_diff > 0:\n      actions.extend([craft.ACTION_RIGHT] * x_diff)\n    elif x_diff < 0:\n      actions.extend([craft.ACTION_LEFT] * abs(x_diff))\n    \n    return actions\n\n  def determine_facing_direction(current_position, target_position):\n    \"\"\"Helper function to determine the direction to face the target position.\"\"\"\n    current_x, current_y = current_position\n    target_x, target_y = target_position\n\n    if target_x > current_x:\n      return craft.ACTION_RIGHT\n    elif target_x < current_x:\n      return craft.ACTION_LEFT\n    elif target_y > current_y:\n      return craft.ACTION_DOWN\n    elif target_y < current_y:\n      return craft.ACTION_UP\n    \n    return None  # Already facing the target position\n\n  def find_closest_workshop():\n    \"\"\"Helper function to find the closest workshop.\"\"\"\n    recipe = env.world.cookbook.recipes[item_index]\n    workshop_required = None\n    for key in recipe.keys():\n        if \"_at\" in key:\n            workshop_required = key.split(\"_at\")[1].strip()\n            break\n\n    if not workshop_required:\n        return None  # No valid workshop found in the recipe\n\n    workshop_index = env.world.cookbook.index[workshop_required]\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if not workshop_positions.size:\n        return None  # No valid workshops found on the grid\n\n    target_workshop_position = min(\n        [tuple(pos) for pos in workshop_positions],\n        key=lambda x: abs(x[0] - env._current_state.pos[0]) + abs(x[1] - env._current_state.pos[1])\n    )\n    \n    return target_workshop_position\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  current_inventory = {env.world.cookbook.index.get(i): env._current_state.inventory[i] for i in range(len(env._current_state.inventory))}\n\n  actions = []\n\n  # Check if we have all the primitives required\n  for primitive, count in required_primitives.items():\n    if current_inventory.get(primitive, 0) < count:\n      return []  # Return empty list as we do not have enough primitives\n\n  # Find the closest workshop\n  target_workshop_position = find_closest_workshop()\n  if not target_workshop_position:\n    return []  # No valid workshop found on the grid\n\n  # Navigate and face the workshop\n  actions.extend(navigate_to(target_workshop_position))\n\n  # Determine facing direction to ensure we are directly in front of the workshop\n  facing_direction = determine_facing_direction(env._current_state.pos, target_workshop_position)\n  if facing_direction is not None:\n      actions.append(facing_direction)\n\n  # Perform USE action to craft the item\n  actions.append(craft.ACTION_USE)\n\n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T19:21:34.812980", "function_name": "craft", "function_body": "  def navigate_to(target_position):\n      \"\"\"Helper function to navigate to the target position.\"\"\"\n      path = a_star_search(env._current_state.grid, env._current_state.pos, target_position)\n      actions = []\n      for step in path:\n          current_pos = env._current_state.pos\n          if step[0] > current_pos[0]:\n              actions.append(craft.ACTION_DOWN)\n          elif step[0] < current_pos[0]:\n              actions.append(craft.ACTION_UP)\n          if step[1] > current_pos[1]:\n              actions.append(craft.ACTION_RIGHT)\n          elif step[1] < current_pos[1]:\n              actions.append(craft.ACTION_LEFT)\n      return actions\n\n  def a_star_search(grid, start, goal):\n      \"\"\"A* search algorithm to find the shortest path from start to goal.\"\"\"\n      open_set = []\n      heapq.heappush(open_set, (0, start))\n      came_from = {}\n      g_score = {start: 0}\n      f_score = {start: heuristic(start, goal)}\n\n      while open_set:\n          current = heapq.heappop(open_set)[1]\n          if current == goal:\n              return reconstruct_path(came_from, current)\n          \n          for neighbor in neighbors(grid, current):\n              tentative_g_score = g_score[current] + 1\n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                  heapq.heappush(open_set, (f_score[neighbor], neighbor))\n      return []\n\n  def heuristic(a, b):\n      \"\"\"Heuristic function for A* search.\"\"\"\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def neighbors(grid, position):\n      \"\"\"Returns the valid neighboring positions.\"\"\"\n      x, y = position\n      directions = [(x-1, y), (x+1, y), (x, y-1), (x, y+1)]\n      return [p for p in directions if is_valid_move(grid, env._current_state.pos, p)]\n\n  def is_valid_move(grid, current_pos, target_pos):\n      \"\"\"Checks if the move from current_pos to target_pos is valid.\"\"\"\n      x, y = target_pos\n      width, height, _ = grid.shape\n      return 0 <= x < width and 0 <= y < height and grid[x, y].sum() == 0\n\n  def determine_facing_direction(current_position, target_position):\n      \"\"\"Determine the direction to face the target position.\"\"\"\n      dx = target_position[0] - current_position[0]\n      dy = target_position[1] - current_position[1]\n\n      if abs(dx) > abs(dy):\n          return craft.ACTION_DOWN if dx > 0 else craft.ACTION_UP\n      else:\n          return craft.ACTION_RIGHT if dy > 0 else craft.ACTION_LEFT\n\n  def find_closest_workshop(item_index):\n      \"\"\"Helper function to find the closest workshop.\"\"\"\n      # Determine which workshop to use\n      recipe = env.world.cookbook.recipes[item_index]\n      workshop_required = None\n      for key in recipe.keys():\n          if \"_at\" in key:\n              workshop_required = key.split(\"_at\")[1].strip()\n              break\n\n      if not workshop_required:\n          return None  # No valid workshop found in the recipe\n\n      # Find all positions of the required workshops in the grid\n      workshop_index = env.world.cookbook.index[workshop_required]\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n      if not workshop_positions.size:\n          return None  # No valid workshops found on the grid\n\n      # Find the closest workshop to the current position\n      target_workshop_position = min(\n          [tuple(pos) for pos in workshop_positions],\n          key=lambda x: abs(x[0] - env._current_state.pos[0]) + abs(x[1] - env._current_state.pos[1])\n      )\n      return target_workshop_position\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  current_inventory = {env.world.cookbook.index.get(i): env._current_state.inventory[i] for i in range(len(env._current_state.inventory))}\n\n  actions = []\n\n  # Check if we have all the primitives required\n  for primitive, count in required_primitives.items():\n    if current_inventory.get(primitive, 0) < count:\n      return []  # Return empty list as we do not have enough primitives\n\n  # Find the closest workshop\n  target_workshop_position = find_closest_workshop(item_index)\n  if not target_workshop_position:\n    return []  # No valid workshop found on the grid\n\n  # Navigate and face the workshop\n  actions.extend(navigate_to(target_workshop_position))\n\n  # Perform USE action to craft the item\n  actions.append(craft.ACTION_USE)\n\n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T19:24:31.873516", "function_name": "craft", "function_body": "  def navigate_to_position(env, target_pos):\n    \"\"\"Helper function to navigate the agent towards a specific position.\"\"\"\n    grid = env._current_state.grid\n    pos = env._current_state.pos\n\n    actions = []\n    while pos != target_pos:\n      dx = target_pos[0] - pos[0]\n      dy = target_pos[1] - pos[1]\n\n      if dx < 0:\n        actions.append(env.world.N_ACTIONS - 4)  # UP action\n        pos = (pos[0] - 1, pos[1])\n      elif dx > 0:\n        actions.append(env.world.N_ACTIONS - 3)  # DOWN action\n        pos = (pos[0] + 1, pos[1])\n\n      if dy < 0:\n        actions.append(env.world.N_ACTIONS - 2)  # LEFT action\n        pos = (pos[0], pos[1] - 1)\n      elif dy > 0:\n        actions.append(env.world.N_ACTIONS - 5)  # RIGHT action\n        pos = (pos[0], pos[1] + 1)\n\n    return actions\n\n  def rotate_towards(env, target_pos):\n    \"\"\"Helper function to ensure the agent is facing the correct direction before using a workshop.\"\"\"\n    pos = env._current_state.pos\n    dx = target_pos[0] - pos[0]\n    dy = target_pos[1] - pos[1]\n\n    if dx < 0:\n      return env.world.N_ACTIONS - 4  # UP action\n    elif dx > 0:\n      return env.world.N_ACTIONS - 3  # DOWN action\n    elif dy < 0:\n      return env.world.N_ACTIONS - 2  # LEFT action\n    elif dy > 0:\n      return env.world.N_ACTIONS - 5  # RIGHT action\n\n    return None  # Already facing the correct direction\n\n  def collect_primitive(env, primitive_index):\n    \"\"\"Helper function to collect a primitive.\"\"\"\n    actions = []\n    grid = env._current_state.grid\n    pos = env._current_state.pos\n\n    while env._current_state.inventory[primitive_index] < 1:\n      # Find all positions of the target item in the grid\n      target_positions = np.argwhere(grid[:, :, primitive_index] > 0)\n\n      if len(target_positions) == 0:\n        return actions  # No more primitives found, stop collecting\n\n      closest_target_pos = min(target_positions, key=lambda x: abs(x[0] - pos[0]) + abs(x[1] - pos[1]))\n\n      if not env._current_state.next_to(primitive_index):\n        actions.extend(navigate_to_position(env, closest_target_pos))\n      \n      # Check if the agent is next to an item\n      if env._current_state.next_to(primitive_index):\n        actions.append(env.world.N_ACTIONS - 1)  # USE action\n    \n    return actions\n\n  def find_workshop_position(env, workshop_index):\n    \"\"\"Helper function to find the position of a workshop.\"\"\"\n    grid = env._current_state.grid\n    target_positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if len(target_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n    return tuple(target_positions[0])\n\n  def find_item_positions(env, item_index):\n    \"\"\"Helper function to find all positions of a specific item in the grid.\"\"\"\n    grid = env._current_state.grid\n    target_positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if len(target_positions) == 0:\n      return []\n\n    return [tuple(pos) for pos in target_positions]\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the goal item is a primitive or not in the recipes\n  if item_index in env.world.grabbable_indices:\n    return []  # Primitives cannot be crafted\n  \n  # Retrieve the recipe for the desired item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Determine the workshop required for crafting\n  workshop = None\n  for key, value in recipe.items():\n      if isinstance(key, str) and key.startswith('_at'):\n          workshop = value\n\n  if workshop is None:\n    raise ValueError(f\"No workshop specified for crafting {item}.\")\n\n  # Convert workshop name to index\n  workshop_index = env.world.cookbook.index[workshop]\n\n  # Determine the list of required primitives or intermediate items\n  required_items = {}\n  for key, value in recipe.items():\n      if isinstance(key, str) and not key.startswith('_at'):\n          required_items[key] = value\n\n  actions = []\n\n  # Collect all required items\n  for req_item_name, count in required_items.items():\n    req_item_index = env.world.cookbook.index[req_item_name]\n    \n    while env._current_state.inventory[req_item_index] < count:\n      if not env._current_state.next_to(req_item_index):\n        actions.extend(collect_primitive(env, req_item_index))\n      \n      # Check if the agent is next to an item\n      if env._current_state.next_to(req_item_index):\n        actions.append(env.world.N_ACTIONS - 1)  # USE action\n\n  # Navigate to the workshop and use it to craft the item\n  workshop_pos = find_workshop_position(env, workshop_index)\n\n  if not env._current_state.next_to(workshop_index):\n    actions.extend(navigate_to_position(env, workshop_pos))\n  \n  # Rotate to face the workshop properly before using it\n  rotate_action = rotate_towards(env, workshop_pos)\n  if rotate_action is not None:\n    actions.append(rotate_action)\n\n  actions.append(env.world.N_ACTIONS - 1)  # USE action\n\n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T19:24:32.937849", "function_name": "craft", "function_body": "  def navigate_and_collect(env, target_index):\n    \"\"\"Helper function to navigate and collect a target item.\"\"\"\n    grid = env._current_state.grid\n    pos = env._current_state.pos\n\n    # Find all positions of the target item in the grid\n    target_positions = np.argwhere(grid[:, :, target_index] > 0)\n    \n    if len(target_positions) == 0:\n      return []  # No target found, cannot navigate\n\n    actions = []\n    for target_pos in target_positions:\n      while pos != tuple(target_pos):\n        dx = target_pos[0] - pos[0]\n        dy = target_pos[1] - target_pos[1]\n\n        if dx < 0:\n          actions.append(env.world.N_ACTIONS - 4)  # UP action\n          pos = (pos[0] - 1, pos[1])\n        elif dx > 0:\n          actions.append(env.world.N_ACTIONS - 3)  # DOWN action\n          pos = (pos[0] + 1, pos[1])\n\n        if dy < 0:\n          actions.append(env.world.N_ACTIONS - 2)  # LEFT action\n          pos = (pos[0], pos[1] - 1)\n        elif dy > 0:\n          actions.append(env.world.N_ACTIONS - 5)  # RIGHT action\n          pos = (pos[0], pos[1] + 1)\n\n      if env._current_state.next_to(target_index):\n        actions.append(env.world.N_ACTIONS - 1)  # USE action\n      \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the goal item is a primitive or not in the recipes\n  if item_index in env.world.grabbable_indices:\n    return []  # Primitives cannot be crafted\n  \n  # Retrieve the recipe for the desired item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Determine the workshop required for crafting\n  workshop_key = \"_at\"\n  workshop_name = recipe.get(workshop_key)\n  if workshop_name is None:\n    raise ValueError(f\"No workshop specified for crafting {item}.\")\n  \n  workshop_index = env.world.cookbook.index[workshop_name]\n  \n  # Determine the list of required primitives or intermediate items\n  required_items = {env.world.cookbook.index[key]: value for key, value in recipe.items() if not isinstance(key, str) or not key.startswith('_at')}\n\n  actions = []\n\n  # Collect all required items\n  for req_item_index, count in required_items.items():\n    while env._current_state.inventory[req_item_index] < count:\n      actions.extend(navigate_and_collect(env, req_item_index))\n\n  # Navigate to the workshop and use it to craft the item\n  actions.extend(navigate_and_collect(env, workshop_index))\n  \n  actions.append(env.world.N_ACTIONS - 1)  # USE action\n\n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T19:28:13.731416", "function_name": "craft", "function_body": "  def a_star_search(grid, start, goal):\n    neighbors = [(0,1), (1,0), (0,-1), (-1,0)]\n    close_set = set()\n    came_from = {}\n    gscore = {start:0}\n    fscore = {start:_distance(start, goal)}\n    oheap = []\n\n    heapq.heappush(oheap, (fscore[start], start))\n\n    while oheap:\n        current = heapq.heappop(oheap)[1]\n\n        if current == goal:\n            data = []\n            while current in came_from:\n                data.append(current)\n                current = came_from[current]\n            return data[::-1] + [start]\n\n        close_set.add(current)\n        for i, j in neighbors:\n            neighbor = (current[0] + i, current[1] + j)\n            tentative_g_score = gscore[current] + _distance(current, neighbor)\n\n            if 0 <= neighbor[0] < grid.shape[0]:\n                if 0 <= neighbor[1] < grid.shape[1]:                \n                    if any(grid[neighbor[0], neighbor[1], :]): \n                        continue\n                else:\n                    # array index out of range\n                    continue\n            else:\n                # array index out of range\n                continue\n\n            if neighbor in close_set and tentative_g_score >= gscore.get(neighbor, 0):\n                continue\n\n            if  tentative_g_score < gscore.get(neighbor, 0) or neighbor not in [i[1]for i in oheap]:\n                came_from[neighbor] = current\n                gscore[neighbor] = tentative_g_score\n                fscore[neighbor] = tentative_g_score + _distance(neighbor, goal)\n                heapq.heappush(oheap, (fscore[neighbor], neighbor))\n    return False\n\n  def _distance(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def navigate_to(pos):\n      path = a_star_search(env._current_state.grid, env._current_state.pos, pos)\n      if not path:\n          return []\n      \n      actions = []\n      for next_pos in path[1:]:\n          # Determine the direction to move\n          dx, dy = next_pos[0] - env._current_state.pos[0], next_pos[1] - env._current_state.pos[1]\n          \n          if dx == 1:\n              actions.append(craft.ACTION_DOWN)\n          elif dx == -1:\n              actions.append(craft.ACTION_UP)\n          elif dy == 1:\n              actions.append(craft.ACTION_RIGHT)\n          elif dy == -1:\n              actions.append(craft.ACTION_LEFT)\n\n      return actions\n\n  def determine_facing_direction(pos, target):\n      dx, dy = target[0] - pos[0], target[1] - pos[1]\n      \n      if dx > 0:\n          return craft.ACTION_DOWN\n      elif dx < 0:\n          return craft.ACTION_UP\n      elif dy > 0:\n          return craft.ACTION_RIGHT\n      elif dy < 0:\n          return craft.ACTION_LEFT\n      \n      return None\n\n  def collect_primitives(required_primitives, current_inventory):\n      actions = []\n      for primitive, count in required_primitives.items():\n          if current_inventory.get(primitive, 0) >= count:\n              continue\n\n          # Find positions of the required primitives on the grid\n          primitive_index = env.world.cookbook.index[primitive]\n          primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n          if not primitive_positions.size:\n              return []  # No valid primitive found on the grid\n\n          for position in primitive_positions:\n              actions.extend(navigate_to(tuple(position)))\n\n              # Determine the direction to face the primitive\n              facing_direction = determine_facing_direction(env._current_state.pos, tuple(position))\n              if facing_direction is not None:\n                  actions.append(facing_direction)\n\n              # Perform USE action to collect the item\n              actions.append(craft.ACTION_USE)\n              \n              current_inventory[primitive] = current_inventory.get(primitive, 0) + 1\n\n              if current_inventory[primitive] >= count:\n                  break\n\n      return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  current_inventory = {env.world.cookbook.index.get(i): env._current_state.inventory[i] for i in range(len(env._current_state.inventory))}\n\n  actions = []\n\n  # Collect missing primitives\n  actions.extend(collect_primitives(required_primitives, current_inventory))\n\n  # Determine which workshop to use and navigate there\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_required = None\n  for key in recipe.keys():\n      if \"_at\" in key:\n          workshop_required = key.split(\"_at\")[1].strip()\n          break\n\n  if not workshop_required:\n      return []  # No valid workshop found in the recipe\n\n  # Find the position of the required workshop in the grid\n  workshop_index = env.world.cookbook.index[workshop_required]\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n  if not workshop_positions.size:\n      return []  # No valid workshop found on the grid\n\n  target_workshop_position = tuple(workshop_positions[0])\n\n  # Navigate and craft\n  actions.extend(navigate_to(target_workshop_position))\n\n  # Turn to face the workshop (assuming we can determine the direction needed)\n  facing_direction = determine_facing_direction(env._current_state.pos, target_workshop_position)\n  if facing_direction is not None:\n      actions.append(facing_direction)\n\n  # Perform USE action to craft the item\n  actions.append(craft.ACTION_USE)\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-10T19:28:14.745523", "function_name": "craft", "function_body": "  def a_star_search(grid, start, goal):\n    neighbors = [(0,1), (1,0), (0,-1), (-1,0)]\n    close_set = set()\n    came_from = {}\n    gscore = {start:0}\n    fscore = {start:_distance(start, goal)}\n    oheap = []\n\n    heapq.heappush(oheap, (fscore[start], start))\n\n    while oheap:\n        current = heapq.heappop(oheap)[1]\n\n        if current == goal:\n            data = []\n            while current in came_from:\n                data.append(current)\n                current = came_from[current]\n            return data[::-1] + [start]\n\n        close_set.add(current)\n        for i, j in neighbors:\n            neighbor = (current[0] + i, current[1] + j)\n\n            if 0 <= neighbor[0] < grid.shape[0]:\n                if 0 <= neighbor[1] < grid.shape[1]:                \n                    if any(grid[neighbor[0], neighbor[1], :]): \n                        continue\n                else:\n                    # array index out of range\n                    continue\n            else:\n                # array index out of range\n                continue\n\n            tentative_g_score = gscore[current] + _distance(current, neighbor)\n\n            if neighbor in close_set and tentative_g_score >= gscore.get(neighbor, 0):\n                continue\n\n            if  tentative_g_score < gscore.get(neighbor, 0) or neighbor not in [i[1]for i in oheap]:\n                came_from[neighbor] = current\n                gscore[neighbor] = tentative_g_score\n                fscore[neighbor] = tentative_g_score + _distance(neighbor, goal)\n                heapq.heappush(oheap, (fscore[neighbor], neighbor))\n    return False\n\n  def _distance(a, b):\n      \"\"\"Calculate Manhattan distance between two points.\"\"\"\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def navigate_to(pos):\n      \"\"\"Navigate from the current position to a target position using A* search.\"\"\"\n      path = a_star_search(env._current_state.grid, env._current_state.pos, pos)\n      if not path:\n          return []\n\n      actions = []\n      for next_pos in path[1:]:\n          # Determine the direction to move\n          dx, dy = next_pos[0] - env._current_state.pos[0], next_pos[1] - env._current_state.pos[1]\n          \n          if dx == 1:\n              actions.append(craft.ACTION_DOWN)\n          elif dx == -1:\n              actions.append(craft.ACTION_UP)\n          elif dy == 1:\n              actions.append(craft.ACTION_RIGHT)\n          elif dy == -1:\n              actions.append(craft.ACTION_LEFT)\n\n          # Update the current position\n          env._current_state.pos = next_pos\n\n      return actions\n\n  def determine_facing_direction(pos, target):\n      \"\"\"Determine the direction needed to face a target.\"\"\"\n      dx, dy = target[0] - pos[0], target[1] - pos[1]\n      \n      if dx == 1:\n          return craft.ACTION_DOWN\n      elif dx == -1:\n          return craft.ACTION_UP\n      elif dy == 1:\n          return craft.ACTION_RIGHT\n      elif dy == -1:\n          return craft.ACTION_LEFT\n      \n      return None\n\n  def collect_primitives(primitives):\n      \"\"\"Collect all required primitives.\"\"\"\n      actions = []\n      for primitive, count in primitives.items():\n          while current_inventory.get(primitive, 0) < count:\n              # Find the position of the required primitive\n              primitive_index = env.world.cookbook.index[primitive]\n              primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n              if not primitive_positions.size:\n                  return []  # No valid primitive found on the grid\n\n              target_primitive_position = tuple(primitive_positions[0])\n\n              # Navigate to the primitive\n              actions.extend(navigate_to(target_primitive_position))\n\n              # Perform USE action to collect the primitive\n              actions.append(craft.ACTION_USE)\n\n              # Update current inventory\n              current_inventory[primitive] = current_inventory.get(primitive, 0) + 1\n\n      return actions\n\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  current_inventory = {env.world.cookbook.index.get(i): env._current_state.inventory[i] for i in range(len(env._current_state.inventory))}\n\n  actions = []\n\n  # Collect all the primitives required\n  actions.extend(collect_primitives(required_primitives))\n  \n  # Determine which workshop to use and navigate there\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_required = None\n  for key in recipe.keys():\n      if \"_at\" in key:\n          workshop_required = key.split(\"_at\")[1].strip()\n          break\n\n  if not workshop_required:\n      return []  # No valid workshop found in the recipe\n\n  # Find the position of the required workshop in the grid\n  workshop_index = env.world.cookbook.index[workshop_required]\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n  if not workshop_positions.size:\n      return []  # No valid workshop found on the grid\n\n  target_workshop_position = tuple(workshop_positions[0])\n\n  # Navigate and craft\n  actions.extend(navigate_to(target_workshop_position))\n\n  # Turn to face the workshop (assuming we can determine the direction needed)\n  facing_direction = determine_facing_direction(env._current_state.pos, target_workshop_position)\n  if facing_direction is not None:\n      actions.append(facing_direction)\n\n  # Perform USE action to craft the item\n  actions.append(craft.ACTION_USE)\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-10T19:29:31.915011", "function_name": "craft", "function_body": "  goal_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the required primitives and items for crafting\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n\n  current_inventory = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n\n  missing_items = {i: required_primitives[i] - current_inventory.get(i, 0) for i in required_primitives if required_primitives[i] > current_inventory.get(i, 0)}\n\n  actions = []\n\n  # Collect missing items\n  for primitive_index, quantity in missing_items.items():\n    actions.extend(collect_v2(env, env.world.cookbook.index.get(primitive_index), quantity))\n\n  # Find the workshop location\n  workshop_key = env.world.cookbook.recipes[goal_index][\"_key\"]\n  workshop_index = int(workshop_key.split('_')[-1])\n\n  # Navigate to the workshop and face it\n  actions.extend(navigate_to_and_face(env, env.world.workshop_indices[workshop_index]))\n  \n  # Use the USE action to craft the item at the workshop\n  actions.append(env.ACTION_USE)\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-10T19:29:32.885219", "function_name": "craft", "function_body": "  def navigate_and_collect_primitives():\n    actions = []\n    for primitive_index, count in missing_items.items():\n        # Find the location of the primitive\n        locations = np.argwhere(env._current_state.grid[..., primitive_index] == 1)\n        \n        if not locations.size:\n            continue  # Skip if no such primitive is available\n\n        # Navigate to each location and collect the required number of primitives\n        for _ in range(count):\n            loc = tuple(locations[0])  # Choose any one location (for now, can be optimized)\n            actions.extend(navigate_to_and_face(env, loc))\n            \n            # Collect the primitive using USE action\n            actions.append(env.ACTION_USE)\n\n    return actions\n\n  goal_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the required primitives and items for crafting\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  current_inventory = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n  missing_items = {i: required_primitives[i] - current_inventory.get(i, 0) for i in required_primes if required_primitives[i] > current_inventory.get(i, 0)}\n\n  actions = []\n\n  # If we have all the required items\n  if not missing_items:\n      # Find the workshop location\n      workshop_index = env.world.workshop_indices[env.world.cookbook.recipes[goal_index][\"_key\"][-1]]\n      \n      # Navigate to the workshop and face it\n      actions.extend(navigate_to_and_face(env, workshop_index))\n      \n      # Use the USE action to craft the item at the workshop\n      actions.append(env.ACTION_USE)\n      \n  else:\n    actions.extend(navigate_and_collect_primitives())\n    \n    # Recheck after collecting primitives if we still have any missing items\n    current_inventory = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n    missing_items = {i: required_primitives[i] - current_inventory.get(i, 0) for i in required_primitives if required_primitives[i] > current_inventory.get(i, 0)}\n    \n    # If all items are collected\n    if not missing_items:\n        workshop_index = env.world.workshop_indices[env.world.cookbook.recipes[goal_index][\"_key\"][-1]]\n        actions.extend(navigate_to_and_face(env, workshop_index))\n        actions.append(env.ACTION_USE)\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-10T19:31:54.793028", "function_name": "craft", "function_body": "  # Helper function to collect primitives\n  def get_actions_to_collect_primitive(primitive_index):\n    actions = []\n    primitive_name = env.world.cookbook.index.get(primitive_index)\n    while not env._current_state.inventory[primitive_index] > 0:\n      # Find positions of the primitive on the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] > 0)\n      \n      if primitive_positions.size == 0:\n        raise ValueError(f\"No {primitive_name} found on the grid.\")\n      \n      # Navigate to the closest primitive\n      target_pos = min(primitive_positions, key=lambda p: sum(abs(np.array(p) - np.array(env._current_state.pos))))\n      actions.extend(navigate_to_target(target_pos))\n      actions.append(env.world.N_ACTIONS - 2)  # Assuming COLLECT action is second last\n      \n    return actions\n\n  # Helper function to check if inventory has all required primitives\n  def check_inventory_for_primitives(primitives_required):\n    for primitive, count in primitives_required.items():\n      if env._current_state.inventory[primitive] < count:\n        return False\n    return True\n\n  # Helper function to navigate the agent to a target position\n  def navigate_to_target(target_pos):\n    actions = []\n    current_pos = np.array(env._current_state.pos)\n    delta = target_pos - current_pos\n    \n    if delta[0] > 0:\n      actions.extend([env.world.N_ACTIONS - 5] * abs(delta[0]))  # Assuming DOWN action is index 1\n    elif delta[0] < 0:\n      actions.extend([env.world.N_ACTIONS - 6] * abs(delta[0]))  # Assuming UP action is index 0\n    \n    if delta[1] > 0:\n      actions.extend([env.world.N_ACTIONS - 4] * abs(delta[1]))  # Assuming RIGHT action is index 3\n    elif delta[1] < 0:\n      actions.extend([env.world.N_ACTIONS - 7] * abs(delta[1]))  # Assuming LEFT action is index 2\n    \n    return actions\n\n  # Helper function to navigate the agent to the workshop\n  def navigate_to_workshop(workshop_index):\n    workshop_name = env.world.cookbook.index.get(workshop_index)\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n    \n    if workshop_positions.size == 0:\n      raise ValueError(f\"No {workshop_name} found on the grid.\")\n    \n    # Navigate to the closest workshop\n    target_pos = min(workshop_positions, key=lambda p: sum(abs(np.array(p) - np.array(env._current_state.pos))))\n    return navigate_to_target(target_pos)\n\n  def perform_crafting_action(workshop_index):\n    return [env.world.N_ACTIONS - 1]  # Assuming USE action is the last action\n\n  item_index = env.world.cookbook.index[item]\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n\n  if not check_inventory_for_primitives(primitives_required):\n    actions = []\n    for primitive, count in primitives_required.items():\n      for _ in range(count):  # Collect the required number of each primitive\n        actions.extend(get_actions_to_collect_primitive(primitive))\n    return actions\n\n  workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n    if item_index in recipe:\n      workshop_index = recipe[\"_at\"]\n      break\n\n  if workshop_index is None:\n    raise ValueError(\"No valid workshop found for the given item.\")\n\n  actions_to_workshop = navigate_to_workshop(workshop_index)\n  crafting_action = perform_crafting_action(workshop_index)\n\n  return actions_to_workshop + crafting_action", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-10T19:31:55.774916", "function_name": "craft", "function_body": "  def get_actions_to_collect_primitive(primitive_index):\n    # Find positions of the primitive in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, primitive_index] > 0)\n    \n    if len(positions) == 0:\n      return []  # No primitives available\n\n    actions = []\n    for pos in positions:\n      # Calculate relative direction to move towards the primitive\n      rel_pos = (pos - env._current_state.pos).astype(int)\n      \n      # Determine the sequence of moves needed to reach the position\n      if rel_pos[0] > 0: actions.extend([env.world.RIGHT]*rel_pos[0])\n      elif rel_pos[0] < 0: actions.extend([env.world.LEFT]*abs(rel_pos[0]))\n      \n      if rel_pos[1] > 0: actions.extend([env.world.DOWN]*rel_pos[1])\n      elif rel_pos[1] < 0: actions.extend([env.world.UP]*abs(rel_pos[1]))\n\n      # Add USE action to collect the primitive\n      actions.append(env.world.N_ACTIONS - 2)  # Assuming COLLECT action is second last\n      \n    return actions\n\n  def check_inventory_for_primitives(primitives_required):\n    for primitive, count in primitives_required.items():\n      if env._current_state.inventory[primitive] < count:\n        return False\n    return True\n\n  def navigate_to_workshop(workshop_index):\n    # Find positions of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n    \n    if len(positions) == 0:\n      return []  # No workshops available\n\n    actions = []\n    for pos in positions:\n      # Calculate relative direction to move towards the workshop\n      rel_pos = (pos - env._current_state.pos).astype(int)\n      \n      # Determine the sequence of moves needed to reach the position\n      if rel_pos[0] > 0: actions.extend([env.world.RIGHT]*rel_pos[0])\n      elif rel_pos[0] < 0: actions.extend([env.world.LEFT]*abs(rel_pos[0]))\n      \n      if rel_pos[1] > 0: actions.extend([env.world.DOWN]*rel_pos[1])\n      elif rel_pos[1] < 0: actions.extend([env._current_state.UP]*abs(rel_pos[1]))\n\n    return actions\n\n  def perform_crafting_action(workshop_index):\n    # This function will perform the USE action at the workshop\n    return [env.world.N_ACTIONS - 1]  # Assuming USE action is the last action\n\n  item_index = env.world.cookbook.index[item]\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n\n  if not check_inventory_for_primitives(primitives_required):\n    actions = []\n    for primitive, count in primitives_required.items():\n      actions.extend(get_actions_to_collect_primitive(primitive))\n    return actions\n\n  workshop_index = None\n  for recipe in env.world.craftbook.recipes.values():  # Corrected from cookbook to craftbook\n    if item_index in recipe:\n      workshop_index = recipe[\"_at\"]\n      break\n\n  if workshop_index is None:\n    raise ValueError(\"No valid workshop found for the given item.\")\n\n  actions_to_workshop = navigate_to_workshop(workshop_index)\n  crafting_action = perform_crafting_action(workshop_index)\n\n  return actions_to_workshop + crafting_action", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-10T19:32:52.723407", "function_name": "craft", "function_body": "  goal_index = env.world.cookbook.index[item]\n\n  # Check if we have all the required primitives and items for crafting\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  \n  current_inventory = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n\n  missing_items = {i: required_primitives[i] - current_inventory.get(i, 0) for i in required_primitives if required_primitives[i] > current_inventory.get(i, 0)}\n\n  actions = []\n\n  # If we have all the required items\n  if not missing_items:\n      # Find the workshop location\n      workshop_key = env.world.cookbook.recipes[goal_index][\"_key\"]\n      workshop_index = int(workshop_key[-1])\n      \n      # Navigate to the workshop and face it\n      actions.extend(navigate_to_and_face(env, workshop_index))\n      \n      # Use the USE action to craft the item at the workshop\n      actions.append(env.world.n_actions)  # Assuming USE is represented by n_actions\n      \n      return actions\n\n  else:\n    for missing_item_index, count in missing_items.items():\n        # Find the location of the missing primitive\n        missing_item_name = env.world.cookbook.index.reverse[missing_item_index]\n        if missing_item_name not in env.world.cookbook.primitives_for(goal_index):\n            continue\n        \n        actions.extend(collect(env._current_state, missing_item_index))\n    \n    return []", "island_id": 2, "scores": {"3": -1}}
