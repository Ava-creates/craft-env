{"timestamp": "2025-09-09T21:36:19.428092", "function_name": "craft", "function_body": "  # Extracting necessary information\n  cookbook = env.world.cookbook\n  index = cookbook.index\n\n  # Get the recipe for the desired item\n  goal_index = index[item]\n  if goal_index not in cookbook.recipes:\n    print(f\"No recipe found for {item}\")\n    return []\n\n  # Check if all primitives required are in inventory\n  required_primitives = cookbook.primitives_for(goal_index)\n  current_inventory = env._current_state.inventory\n\n  missing_primitives = []\n  for prim_index, count in required_primitives.items():\n      if current_inventory[prim_index] < count:\n          missing_primitives.append((index.get(prim_index), count - current_inventory[prim_index]))\n\n  # If we are missing primitives, return an empty action list\n  if missing_primitives:\n    print(f\"Missing primitives: {missing_primitives}\")\n    return []\n\n  # Get the workshop where crafting should happen\n  recipe = cookbook.recipes[goal_index]\n  workshop_key = next(key for key in recipe.keys() if \"_at\" in key)\n  workshop_name = recipe[workshop_key][:-1]  # Remove trailing '_'\n  workshop_index = index[workshop_name]\n\n  # Find the positions of all workshops\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    print(f\"No {workshop_name} found on the grid.\")\n    return []\n\n  # Calculate Manhattan distance from current position to each workshop and choose the closest one\n  agent_position = env._current_state.pos\n  distances = np.sum(np.abs(agent_position - workshop_positions), axis=1)\n  closest_workshop_position = tuple(workshop_positions[np.argmin(distances)])\n\n  # Move to the closest workshop and face it\n  actions_to_move = move_to_and_face(env, closest_workshop_position)\n\n  if not actions_to_move:\n    print(f\"Failed to find a path to {workshop_name} at {closest_workshop_position}\")\n    return []\n\n  # Add USE action to craft the item\n  use_action = craft.USE\n  actions_to_take = actions_to_move + [use_action]\n\n  return actions_to_take", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-09T21:36:44.854184", "function_name": "craft", "function_body": "  def find_workshop_for_item(item_idx):\n    # Find the workshop that can craft the item\n    for recipe in env.world.cookbook.recipes.values():\n      if \"_key\" in recipe and recipe[\"_key\"] == env.world.cookbook.index[item]:\n        return recipe[\"workspace\"]\n    return None\n\n  def get_primitive_counts(primitive_indices, inventory):\n    # Get the counts of primitives in the inventory\n    return {i: inventory[i] for i in primitive_indices}\n\n  def collect_primitives(primitive_indices, required_counts):\n    actions = []\n    for i in primitive_indices:\n      while inventory[i] < required_counts[i]:\n        actions.extend(collect(env.world.cookbook.index.get(i)))\n    return actions\n\n  # Get the index of the item to craft\n  item_idx = env.world.cookbook.index[item]\n  \n  # Check if we have a recipe for this item\n  if item_idx not in env.world.cookbook.recipes:\n    return []\n  \n  # Get the ingredients required and their counts\n  ingredients = env.world.cookbook.recipes[item_idx]\n  \n  # Find the workshop for crafting the item\n  workshop_name = find_workshop_for_item(item_idx)\n  if workshop_name is None:\n    return []\n  \n  # Find the index of the workshop in the environment\n  workshop_idx = env.world.workshop_indices[workshop_name]\n  \n  # Collect primitives required for crafting\n  actions = collect_primitives(list(ingredients.keys()), ingredients)\n  \n  # Navigate to the workshop and perform USE action\n  actions.append(move(env, workshop_name))\n  actions.append(use_action())\n  \n  return actions", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-09-09T21:36:45.974074", "function_name": "craft", "function_body": "  return []", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-09-09T21:37:56.542381", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index for the item we want to craft\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all primitives and intermediate items required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  \n  # Collect missing primitives and intermediate items\n  for primitive, count in required_primitives.items():\n    while env._current_state.inventory[primitive] < count:\n      actions.extend(collect(env, primitive))\n      \n  # Go to the workshop specified in the recipe and use it to craft the item\n  workshop_index = required_primitives.get(\"_at\")\n  \n  if not workshop_index:\n    print(f\"No workshop specified for crafting {item}. Using default logic.\")\n    workshop_index = find_nearest_workshop(env, item_index)\n    \n  actions.extend(move_to_workshop(env, workshop_index))\n  actions.append(4) # USE action to craft the item\n  \n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-09T21:37:57.514631", "function_name": "craft", "function_body": "  # Get the index of the desired item using the cookbook's index\n  item_index = env.world.cookbook.index[item]\n  \n  if not item_index in env.world.cookbook.recipes:\n    return []\n\n  # Determine the primitives required to craft the item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Check if we have all the required ingredients in our inventory\n  current_inventory = env._current_state.inventory\n  has_required_ingredients = True\n  for ingredient, count in recipe.items():\n    if ingredient == \"_at\":\n      continue\n    if current_inventory[ingredient] < count:\n      has_required_ingredients = False\n      break\n\n  if not has_required_ingredients:\n    return []\n\n  # Identify the workshop where crafting should occur\n  workshop_index = env.world.cookbook.index[recipe[\"_at\"]]\n\n  # Check if we are already at the correct workshop and facing it\n  current_pos = env._current_state.pos\n  current_dir = env._current_state.dir\n\n  # Determine the direction to face the workshop from our current position\n  nearest_workshop_pos = None\n  for x in range(env.world.scenario.init_grid.shape[0]):\n    for y in range(env.world.scenario.init_grid.shape[1]):\n      if env._current_state.grid[x, y, workshop_index] > 0:\n        nearest_workshop_pos = (x, y)\n        break\n    if nearest_workshop_pos is not None:\n      break\n\n  if nearest_workshop_pos is None:\n    return []\n\n  # Calculate the direction to move to reach and face the workshop\n  dx = nearest_workshop_pos[0] - current_pos[0]\n  dy = nearest_workshop_pos[1] - current_pos[1]\n\n  actions = []\n\n  # Move towards the workshop\n  if dx < 0:\n    actions.append(env.world.scenario.world.DIR_UP)\n  elif dx > 0:\n    actions.append(env.world.scenario.world.DIR_DOWN)\n\n  if dy < 0:\n    actions.append(env.world.scenario.world.DIR_LEFT)\n  elif dy > 0:\n    actions.append(env.world.scenario.world.DIR_RIGHT)\n\n  # Adjust direction to face the workshop\n  facing_workshop = False\n  while not facing_workshop:\n      new_pos = (current_pos[0] + dx, current_pos[1] + dy)\n      if env._current_state.grid[new_pos[0], new_pos[1], workshop_index] > 0:\n          facing_workshop = True\n\n  # Craft the item\n  actions.append(env.world.scenario.world.ACTION_USE)\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-09T21:38:53.682633", "function_name": "craft", "function_body": "  # Get the index of the item from the cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the item has a recipe in the cookbook\n  if item_index not in env.world.cookbook.recipes:\n    return []\n    \n  # Fetch the recipe for the item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Initialize actions list\n  actions = []\n\n  # Collect required primitives or intermediate items first\n  for ingredient, count in recipe.items():\n      if ingredient == \"_key\":\n          continue\n      ingredient_index = env.world.cookbook.index[ingredient]\n      \n      # Check if the agent already has enough of this ingredient\n      if env._current_state.inventory[ingredient_index] >= count:\n          continue\n      \n      required_count = count - env._current_state.inventory[ingredient_index]\n      \n      # Collect required amount of primitives/intermediate items\n      actions.extend(collect_v2(env, ingredient, required_count))\n      \n  # Move to the specified workshop and craft the item\n  workshop_key = recipe[\"_key\"]\n  workshop_index = env.world.cookbook.index[workshop_key]\n\n  # Find the position of the workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n    return []\n  \n  # Choose the first available workshop position (could be improved to choose the closest one)\n  workshop_pos = tuple(workshop_positions[0])\n\n  actions.extend(move_to_position(env, workshop_pos))\n  actions.append(craft_item_action(workshop_index))\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-09T21:38:54.647231", "function_name": "craft", "function_body": "  index = env.world.cookbook.index\n  item_index = index[item]\n\n  # Check if the item has a recipe\n  if item_index not in env.world.cookbook.recipes:\n    print(f\"No recipe for {item}\")\n    return []\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes[item_index]\n  print(f\"Recipe for {item}: {recipe}\")\n\n  # Check if we have all the ingredients in the inventory\n  actions_to_take = []\n  current_state = env._current_state\n\n  # Collect missing ingredients\n  for ingredient, count in recipe.items():\n    if ingredient == \"_key\":  # This specifies the workshop index\n      continue\n\n    ingredient_index = index[ingredient]\n    required_count = count - current_state.inventory[ingredient_index]\n\n    if required_count > 0:\n      actions_to_take.extend(collect_v1(env, ingredient, required_count))\n\n  # Go to the correct workshop and use it\n  workshop_key = recipe[\"_key\"]\n  workshop_index = int(workshop_key.split(\"workshop\")[1]) - 1\n  workshop_pos = np.argwhere(current_state.grid[:, :, env.world.workshop_indices[workshop_index]] == 1)[0]\n\n  # Move to the workshop position (this is a simplified version and doesn't consider obstacles)\n  actions_to_take.extend(move_to_position(env, tuple(workshop_pos)))\n\n  # Use the workshop\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-09T21:41:29.863182", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = env._current_state.inventory.copy()\n\n  # Check if all ingredients are available\n  required_ingredients = {cookbook.index[k]: v for k, v in recipe.items()}\n\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if not can_craft:\n    return []\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No available workshop to craft item\")\n\n  # Select the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n  # Calculate actions to move the agent to the nearest workshop\n  dx = nearest_workshop_pos[0] - current_position[0]\n  dy = nearest_workshop_pos[1] - current_position[1]\n\n  actions_to_take = []\n\n  if dx > 0:\n    actions_to_take.extend([craft.MOVE_RIGHT for _ in range(dx)])\n  elif dx < 0:\n    actions_to_take.extend([craft.MOVE_LEFT for _ in range(-dx)])\n\n  if dy > 0:\n    actions_to_take.extend([craft.MOVE_DOWN for _ in range(dy)])\n  elif dy < 0:\n    actions_to_take.extend([craft.MOVE_UP for _ in range(-dy)])\n\n  # Calculate the target direction to face the workshop\n  current_direction = env._current_state.dir\n\n  if dx == 0 and dy == 0:  # Already at the workshop\n      pass\n  elif dx > 0:\n      while current_direction != craft.RIGHT:\n          actions_to_take.append(craft.TURN_RIGHT)\n          current_direction = (current_direction + 1) % 4\n  elif dx < 0:\n      while current_direction != craft.LEFT:\n          actions_to_take.append(craft.TURN_LEFT)\n          current_direction = (current_direction - 1) % 4\n  elif dy > 0:\n      while current_direction != craft.DOWN:\n          actions_to_take.append(craft.TURN_RIGHT)\n          current_direction = (current_direction + 1) % 4\n  elif dy < 0:\n      while current_direction != craft.UP:\n          actions_to_take.append(craft.TURN_LEFT)\n          current_direction = (current_direction - 1) % 4\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-09T21:41:30.940329", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n  \n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n\n  # Check if we have all ingredients in inventory to craft this item\n  required_ingredients = recipe.copy()\n  workshop_name = required_ingredients.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  available_inventory = {env.world.cookbook.index[k]: v for k, v in env.world.cookbook.index.reverse_contents.items() if k in env._current_state.inventory}\n\n  # Check if all ingredients are available\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if not can_craft:\n    return []\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No available workshop to craft item\")\n\n  # Select the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n  # Calculate actions to move the agent to the nearest workshop\n  dx = nearest_workshop_pos[0] - current_position[0]\n  dy = nearest_workshop_pos[1] - current_position[1]\n\n  actions_to_take = []\n\n  if dx > 0:\n    actions_to_take.extend([craft.MOVE_RIGHT for _ in range(dx)])\n  elif dx < 0:\n    actions_to_take.extend([craft.MOVE_LEFT for _ in range(-dx)])\n\n  if dy > 0:\n    actions_to_take.extend([craft.MOVE_DOWN for _ in range(dy)])\n  elif dy < 0:\n    actions_to_take.extend([craft.MOVE_UP for _ in range(-dy)])\n\n  # Rotate the agent to face the workshop\n  target_direction = env._current_state.dir\n\n  if dx > 0 and target_direction != craft.RIGHT:\n    while target_direction != craft.RIGHT:\n      actions_to_take.append(craft.TURN_RIGHT)\n      target_direction = (target_direction + 1) % 4\n  elif dx < 0 and target_direction != craft.LEFT:\n    while target_direction != craft.LEFT:\n      actions_to_take.append(craft.TURN_LEFT)\n      target_direction = (target_direction - 1) % 4\n\n  if dy > 0 and target_direction != craft.DOWN:\n    while target_direction != craft.DOWN:\n      actions_to_take.append(craft.TURN_RIGHT)\n      target_direction = (target_direction + 1) % 4\n  elif dy < 0 and target_direction != craft.UP:\n    while target_direction != craft.UP:\n      actions_to_take.append(craft.TURN_LEFT)\n      target_direction = (target_direction - 1) % 4\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-09T21:42:33.318925", "function_name": "craft", "function_body": "  # Convert item name to its corresponding index\n  item_index = env.world.cookbook.index[item]\n\n  # If the item has no recipe, return an empty action list\n  if not env.world.cookbook.recipes.get(item_index):\n    return []\n\n  # Get the required ingredients and their counts for crafting the item\n  recipe = env.world.cookbook.recipes[item_index]\n  required_ingredients = {ingredient: count for ingredient, count in recipe.items() if ingredient != \"_key\"}\n\n  # Check inventory to see which ingredients are already available\n  available_inventory = collections.Counter(env._current_state.inventory)\n\n  actions_to_take = []\n\n  # Collect missing ingredients\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index == \"_key\":\n      continue\n\n    missing_count = required_count - available_inventory.get(ingredient_index, 0)\n    if missing_count > 0:\n      # Determine the primitive name from its index\n      primitive_name = env.world.cookbook.index.get(ingredient_index)\n\n      # Collect the required primitives\n      actions_to_take.extend(collect_v2(env, primitive_name, count=missing_count))\n\n  # Craft the item at the specified workshop\n  workshop_key = recipe[\"_key\"]\n  workshop_index = env.world.workshop_indices[workshop_key]\n\n  # Find a path to the workshop\n  actions_to_take.extend(navigate_to_workshop_v2(env, workshop_index))\n\n  # Use the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-09T21:42:34.291901", "function_name": "craft", "function_body": "  # Extracting the index for the required item\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Check if we have all ingredients\n  actions = []\n  for ingredient, count in recipe.items():\n    if ingredient == \"_at\":\n      continue\n    \n    ingredient_index = env.world.cookbook.index[ingredient]\n    if env._current_state.inventory[ingredient_index] < count:\n      return []  # Not enough ingredients\n\n  # If we have all ingredients, find the workshop\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.workshop_indices[env.world.cookbook.index[workshop_name]]\n\n  # Find the position of the nearest workshop\n  workshop_pos = None\n  for x in range(env._current_state.grid.shape[0]):\n    for y in range(env._current_state.grid.shape[1]):\n      if np.argmax(env._current_state.grid[x, y]) == workshop_index:\n        workshop_pos = (x, y)\n        break\n    if workshop_pos is not None:\n      break\n\n  if workshop_pos is None:\n    return []  # Workshop not found\n\n  # Move to the nearest workshop\n  path_to_workshop = find_path(env._current_state.pos, workshop_pos, env._current_state.grid)\n  actions.extend(path_to_workshop)\n\n  # Use action at the workshop\n  actions.append(craft.USE_ACTION)\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-09T21:44:15.289173", "function_name": "craft", "function_body": "  # Get the index for the desired item from the cookbook\n  item_idx = env.world.cookbook.index[item]\n  \n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_idx, {})\n  \n  if not recipe:\n    return []  # No recipe found\n  \n  # Determine the workshop where the crafting should happen\n  workshop_key = \"_key\"\n  workshop_index = int(recipe.get(workshop_key, -1))\n  \n  if workshop_index == -1:\n    return []  # Workshop not specified in the recipe\n  \n  # Get the list of workshops from the world configuration\n  workshop_indices = env.world.workshop_indices\n  \n  if workshop_index >= len(workshop_indices):\n    return []  # Invalid workshop index\n\n  # Determine the target position for the workshop\n  target_workshop_pos = None\n  for y in range(env._current_state.grid.shape[1]):\n      for x in range(env._current_state.grid.shape[0]):\n          if env._current_state.grid[x, y, workshop_indices[workshop_index]] == 1:\n              target_workshop_pos = (x, y)\n              break\n      if target_workshop_pos is not None:\n          break\n  \n  if target_workshop_pos is None:\n    return []  # Workshop position not found in the grid\n\n  # Function to check if we have all required primitives and items for crafting\n  def check_inventory(recipe):\n    current_inventory = env._current_state.inventory\n    for ingredient, count in recipe.items():\n      if ingredient != \"_key\":\n        ingredient_idx = env.world.cookbook.index.get(ingredient, -1)\n        if ingredient_idx == -1 or current_inventory[ingredient_idx] < count:\n          return False\n    return True\n\n  # Check if we have all required items in our inventory to craft the item\n  if not check_inventory(recipe):\n    return []  # Missing ingredients\n  \n  # Collect missing ingredients\n  actions = []\n  for ingredient_name, quantity in recipe.items():\n      if ingredient_name != workshop_key and quantity > 0:\n          ingredient_idx = env.world.cookbook.index[ingredient_name]\n          \n          # If we don't have enough of this ingredient, collect it\n          if env._current_state.inventory[ingredient_idx] < quantity:\n              actions.extend(collect_v2(env, ingredient_name))\n  \n  # Move to the target workshop\n  actions.extend(move_to(env._current_state, target_workshop_pos))\n  \n  # Perform the USE action at the workshop\n  actions.append(4)  # USE action index\n  \n  return actions", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-09-09T21:44:16.388588", "function_name": "craft", "function_body": "  item_idx = env.world.cookbook.index[item]\n  \n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_idx, {})\n  \n  if not recipe:\n    return []  # No recipe found\n  \n  # Determine the workshop where the crafting should happen\n  workshop_key = \"_key\"\n  workshop_index = int(recipe.get(workshop_key, -1))\n  \n  if workshop_index == -1:\n    return []  # Workshop not specified in the recipe\n  \n  # Get the list of workshops from the world configuration\n  workshop_indices = env.world.workshop_indices\n  \n  if workshop_index >= len(workshop_indices):\n    return []  # Invalid workshop index\n\n  # Determine the target position for the workshop\n  target_workshop_pos = None\n  for y in range(env._current_state.grid.shape[1]):\n      for x in range(env._current_state.grid.shape[0]):\n          if env._current_state.grid[x, y, workshop_indices[workshop_index]] == 1:\n              target_workshop_pos = (x, y)\n              break\n      if target_workshop_pos is not None:\n          break\n\n  if target_workshop_pos is None:\n    return []  # Workshop position not found in the grid\n  \n  # Function to check if we have all required primitives and items for crafting\n  def check_inventory(recipe):\n    current_inventory = env._current_state.inventory\n    missing_ingredients = []\n    for ingredient, count in recipe.items():\n      if ingredient != \"_key\":\n        ingredient_idx = env.world.cookbook.index.get(ingredient)\n        if ingredient_idx is not None:\n          if current_inventory[ingredient_idx] < count:\n            missing_ingredients.append((ingredient, count - current_inventory[ingredient_idx]))\n    return missing_ingredients\n\n  # Collect missing ingredients\n  missing_ingredients = check_inventory(recipe)\n  for ingredient_name, quantity in missing_ingredients:\n      actions.extend(collect_v2(env, ingredient_name, quantity))\n  \n  # Move to the target workshop\n  actions = move_to(env._current_state, target_workshop_pos)\n\n  # Perform the USE action at the workshop\n  actions.append(4)  # USE action index\n  \n  return actions", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-09-09T21:45:33.488428", "function_name": "craft", "function_body": "  # Convert item name to index\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the recipe for the desired item\n  recipe = env.world.cookbook.recipes.get(item_index)\n  \n  if not recipe:\n    return []\n\n  actions = []\n  # Check and collect all required primitives\n  for ingredient, count in recipe.items():\n      if ingredient == \"_key\": continue  # Skip the _key which indicates the workshop index\n      \n      ingredient_name = env.world.cookbook.index.get(ingredient)\n      \n      if not ingredient_name:\n        return []  # Ingredient not recognized\n\n      while env._current_state.inventory[ingredient] < count:\n          # Collect the required primitive\n          actions.extend(collect_v2(env, ingredient_name))\n          \n          # Check if we still need more of this ingredient after collecting\n          if env._current_state.inventory[ingredient] >= count:\n              break\n  \n  # Determine which workshop to use for crafting based on \"_key\"\n  workshop_index = recipe.get(\"_key\")\n  if not workshop_index:\n    return []  # No workshop specified in the recipe\n\n  workshop_name = env.world.cookbook.index.get(workshop_index)\n  \n  if not workshop_name:\n    return []  # Workshop name not recognized\n  \n  # Find the position of the nearest workshop\n  workshop_pos = find_nearest_workshop(env._current_state, workshop_name)\n\n  if not workshop_pos:\n    return []  # No valid workshop found\n\n  # Move to the nearest workshop and face it\n  actions.extend(move_to_and_face(env._current_state, workshop_pos))\n  \n  # Craft the item by using the USE action at the workshop\n  actions.append(craft.USE)\n  \n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-09T21:45:34.490485", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the current state\n  state = env._current_state\n  \n  # Convert item name to index using cookbook index\n  goal_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the items/primitives required for crafting\n  primitives_needed = env.world.cookbook.primitives_for(goal_index)\n  inventory = state.inventory\n\n  # Check if inventory satisfies all primitives needed\n  can_craft = True\n  for primitive_index, count in primitives_needed.items():\n    if inventory[primitive_index] < count:\n      can_craft = False\n      break\n  \n  if not can_craft:\n    return []  # Return empty list as we cannot craft the item yet\n\n  # Get the workshop index from the recipe\n  workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n  \n  # Find the position of the workshop in the grid\n  workshop_positions = np.argwhere(state.grid[:, :, workshop_index] == 1)\n  if len(workshop_positions) == 0:\n    return []  # Return empty list as we cannot find the workshop\n\n  # Select the closest workshop\n  pos_x, pos_y = state.pos\n  distances = np.linalg.norm(workshop_positions - [pos_x, pos_y], axis=1)\n  closest_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n\n  # Move to the workshop position\n  actions.extend(move_to_position(state, closest_workshop_pos))\n\n  # Turn towards the workshop and perform USE action\n  direction_index = state.dir\n  target_direction = compute_target_direction(state.pos, closest_workshop_pos)\n  \n  if direction_index != target_direction:\n    actions.append(turn_towards(target_direction))\n  \n  actions.append(env.world.cookbook.index[\"USE\"])\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-09T21:46:34.074262", "function_name": "craft", "function_body": "  # Get the index for the desired item\n  i_goal = env.world.cookbook.index[item]\n  \n  # Check if we have all required primitives to craft the item\n  required_primitives = env.world.cookbook.primitives_for(i_goal)\n  if not can_craft(required_primitives, env._current_state.inventory):\n    return []\n  \n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes[i_goal]\n  \n  actions = []\n  \n  # Collect required primitives\n  for primitive_index, count in required_primitives.items():\n      primitive_name = env.world.cookbook.index.get(primitive_index)\n      actions.extend(collect(env._current_state, primitive_name))\n      \n  # Move to the specified workshop and craft the item\n  workshop_key = \"_at\"\n  workshop_name = recipe[workshop_key]\n  workshop_index = env.world.workshop_indices[env.world.cookbook.index[workshop_name]]\n  \n  # Find a path to the workshop\n  path_to_workshop = find_path(env._current_state, workshop_index)\n  actions.extend(path_to_workshop)\n  \n  # Craft the item at the workshop by using it\n  actions.append(craft.use_action)  # Assuming USE action is defined somewhere\n  \n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-09T21:46:35.058990", "function_name": "craft", "function_body": "  # Get the goal index from the cookbook\n  goal_index = env.world.cookbook.index[item]\n\n  if goal_index not in env.world.cookbook.recipes:\n    print(f\"No recipe found for {item}.\")\n    return []\n\n  # Determine the primitives required to craft the item\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n\n  # Check if we have all the required primitives in our inventory\n  for i_kind, count in required_primitives.items():\n      if env._current_state.inventory[i_kind] < count:\n          print(f\"Not enough {env.world.cookbook.index.get(i_kind)} to craft {item}.\")\n          return []\n\n  # Get the workshop index from the recipe\n  workshop_index = None\n  for key, value in env.world.cookbook.recipes[goal_index].items():\n      if key.startswith(\"_at\"):\n          workshop_index = env.world.cookbook.index[value]\n          break\n\n  if not workshop_index:\n      print(f\"No workshop specified in the recipe for {item}.\")\n      return []\n\n  # Find a position next to the workshop\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  if workshop_positions.size == 0:\n      print(f\"No positions found for workshop {workshop_index} to craft {item}.\")\n      return []\n\n  target_workshop_position = tuple(workshop_positions[0])\n\n  # Get the current position and direction of the agent\n  current_pos = env._current_state.pos\n  current_dir = env._current_state.dir\n\n  # Generate actions to move to the workshop\n  actions_to_move_to_workshop = move_towards(env, target_workshop_position)\n\n  # Add action to face the workshop before using it\n  direction_to_face_workshop = calculate_direction(current_pos, target_workshop_position)\n  if current_dir != direction_to_face_workshop:\n      turn_action = craft.DIR_TO_ACTION[direction_to_face_workshop]\n      actions_to_move_to_workshop.append(turn_action)\n\n  # Add USE action to craft the item\n  actions_to_move_to_workshop.append(craft.USE)\n\n  return actions_to_move_to_workshop", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-09T21:48:56.889936", "function_name": "craft", "function_body": "  def get_primitive_actions(primitive_index):\n    \"\"\"Returns a list of actions required to collect a primitive.\"\"\"\n    # Find all locations of the primitive in the grid\n    primitive_locations = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n    if len(primitive_locations) == 0:\n      return []\n\n    target_location = primitive_locations[np.random.choice(len(primitive_locations))]\n\n    actions = []\n    while env._current_state.pos != tuple(target_location):\n      dx, dy = target_location - np.array(env._current_state.pos)\n      direction = None\n\n      if dx < 0 and not env._current_state.next_to(env.world.cookbook.index['BOUNDARY']):\n        direction = env.world.N_ACTIONS.DOWN\n      elif dx > 0 and not env._current_state.next_to(env.world.cookbook.index['BOUNDARY']):\n        direction = env.world.N_ACTIONS.UP\n      elif dy < 0 and not env._current_state.next_to(env.world.cookbook.index['BOUNDARY']):\n        direction = env.world.N_ACTIONS.LEFT\n      elif dy > 0 and not env._current_state.next_to(env.world.cookbook.index['BOUNDARY']):\n        direction = env.world.N_ACTIONS.RIGHT\n\n      if direction is not None:\n        actions.append(direction)\n\n    # Add the USE action to collect the primitive\n    actions.append(env.world.N_ACTIONS.USE)\n    \n    return actions\n\n  def get_workshop_actions(workshop_index):\n    \"\"\"Returns a list of actions required to move to and use the workshop.\"\"\"\n    # Find all locations of the workshop in the grid\n    workshop_locations = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_locations) == 0:\n      return []\n\n    target_location = workshop_locations[np.random.choice(len(workshop_locations))]\n\n    actions = []\n    while env._current_state.pos != tuple(target_location):\n      dx, dy = target_location - np.array(env._current_state.pos)\n      direction = None\n\n      if dx < 0 and not env._current_state.next_to(env.world.cookbook.index['BOUNDARY']):\n        direction = env.world.N_ACTIONS.DOWN\n      elif dx > 0 and not env._current_state.next_to(env.world.cookbook.index['BOUNDARY']):\n        direction = env.world.N_ACTIONS.UP\n      elif dy < 0 and not env._current_state.next_to(env.world.cookbook.index['BOUNDARY']):\n        direction = env.world.N_ACTIONS.LEFT\n      elif dy > 0 and not env._current_state.next_to(env.world.cookbook.index['BOUNDARY']):\n        direction = env.world.N_ACTIONS.RIGHT\n\n      if direction is not None:\n        actions.append(direction)\n\n    # Add the USE action to use the workshop\n    actions.append(env.world.N_ACTIONS.USE)\n    \n    return actions\n\n  def has_all_primitives(primitive_counts):\n    \"\"\"Check if the agent's inventory has all required primitives.\"\"\"\n    for primitive_index, count in primitive_counts.items():\n      if env._current_state.inventory[primitive_index] < count:\n        return False\n    return True\n\n  # Get the index of the item to craft\n  item_index = env.world.cookbook.index[item]\n\n  # Get the primitive counts required to craft the item\n  primitive_counts = env.world.cookbook.primitives_for(item_index)\n\n  if not has_all_primitives(primitive_counts):\n    return []\n\n  actions = []\n  \n  # Collect all required primitives\n  for primitive, count in primitive_counts.items():\n    for _ in range(count):\n      actions.extend(get_primitive_actions(primitive))\n  \n  # Move to the workshop and use it to craft the item\n  if \"_key\" in env.world.cookbook.recipes[item_index]:\n    workshop_key = env.world.cookbook.recipes[item_index][\"_key\"]\n    workshop_index = env.world.cookbook.index[workshop_key]\n    actions.extend(get_workshop_actions(workshop_index))\n  \n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-09-09T21:48:57.892682", "function_name": "craft", "function_body": "  def get_primitive_actions(primitive_index):\n    \"\"\"Returns a list of actions required to collect a primitive.\"\"\"\n    # Find all locations of the primitive in the grid\n    primitive_locations = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n    if len(primitive_locations) == 0:\n      return []\n\n    target_location = primitive_locations[np.random.choice(len(primitive_locations))]\n\n    actions = []\n    \n    while env._current_state.pos != tuple(target_location):\n      dx, dy = target_location - np.array(env._current_state.pos)\n      \n      # Determine the direction to move\n      if dx < 0:\n        actions.append(env.world.N_ACTIONS.DOWN)\n      elif dx > 0:\n        actions.append(env.world.N_ACTIONS.UP)\n      elif dy < 0:\n        actions.append(env.world.N_ACTIONS.LEFT)\n      elif dy > 0:\n        actions.append(env.world.N_ACTIONS.RIGHT)\n\n    # Add the USE action to collect the primitive\n    actions.append(env.world.N_ACTIONS.USE)\n    \n    return actions\n\n  def get_workshop_actions(workshop_index):\n    \"\"\"Returns a list of actions required to move to and use the workshop.\"\"\"\n    # Find all locations of the workshop in the grid\n    workshop_locations = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_locations) == 0:\n      return []\n\n    target_location = workshop_locations[np.random.choice(len(workshop_locations))]\n\n    actions = []\n    \n    while env._current_state.pos != tuple(target_location):\n      dx, dy = target_location - np.array(env._current_state.pos)\n      \n      # Determine the direction to move\n      if dx < 0:\n        actions.append(env.world.N_ACTIONS.DOWN)\n      elif dx > 0:\n        actions.append(env.world.N_ACTIONS.UP)\n      elif dy < 0:\n        actions.append(env.world.N_ACTIONS.LEFT)\n      elif dy > 0:\n        actions.append(env.world.N_ACTIONS.RIGHT)\n\n    # Add the USE action to use the workshop\n    actions.append(env.world.N_ACTIONS.USE)\n    \n    return actions\n\n  def has_all_primitives(primitive_counts):\n    \"\"\"Check if the agent's inventory has all required primitives.\"\"\"\n    for primitive_index, count in primitive_counts.items():\n      if env._current_state.inventory[primitive_index] < count:\n        return False\n    return True\n\n  # Get the index of the item to craft\n  item_index = env.world.cookbook.index[item]\n\n  # Get the primitive counts required to craft the item\n  primitive_counts = env.world.cookbook.primitives_for(item_index)\n\n  actions = []\n\n  if not has_all_primitives(primitive_counts):\n    # Collect all required primitives\n    for primitive, count in primitive_counts.items():\n      for _ in range(count):\n        actions.extend(get_primitive_actions(primitive))\n    \n    if not has_all_primitives(primitive_counts):\n      return []\n\n  # Move to the workshop and use it to craft the item\n  if \"_key\" in env.world.cookbook.recipes[item_index]:\n    workshop_key = env.world.cookbook.recipes[item_index][\"_key\"]\n    workshop_index = env.world.cookbook.index[workshop_key]\n    actions.extend(get_workshop_actions(workshop_index))\n  \n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-09T21:50:39.943234", "function_name": "craft", "function_body": "  # Step 1: Determine the recipe for the desired item\n  item_index = env.world.cookbook.index[item]\n  if item_index not in env.world.cookbook.recipes:\n    return []  # No recipe for this item, return empty action list\n\n  # Step 2: Check if we already have the item in inventory\n  if env._current_state.inventory[item_index] > 0:\n    return []\n\n  # Step 3: Get the required primitives and their counts from the recipe\n  recipe = env.world.cookbook.recipes[item_index]\n  required_primitives = {env.world.cookbook.index[ingredient]: count for ingredient, count in recipe.items() if ingredient != \"_key\"}\n\n  # Step 4: Check if we have all the required primitives in our inventory\n  actions_to_take = []\n  for primitive, count in required_primitives.items():\n    while env._current_state.inventory[primitive] < count:\n      actions_to_collect_primitive = collect(env, env.world.cookbook.index.get(primitive))\n      actions_to_take.extend(actions_to_collect_primitive)\n\n  # Step 5: Determine the workshop where the item can be crafted\n  workshop_key = recipe[\"_key\"]\n  workshop_index = env.world.workshop_indices[workshop_key]\n\n  # Step 6: Find the position of the nearest workshop on the grid\n  nearest_workshop_pos = find_nearest_workshop(env._current_state.grid, workshop_index)\n\n  if nearest_workshop_pos is None:\n    return []  # No available workshop found\n\n  # Step 7: Navigate to the workshop\n  actions_to_workshop = navigate_to(env._current_state.pos, nearest_workshop_pos)\n  actions_to_take.extend(actions_to_workshop)\n\n  # Step 8: Orient the agent towards the workshop and use it to craft the item\n  action_to_face_workshop = face_towards(env._current_state.dir, nearest_workshop_pos)\n  actions_to_take.append(action_to_face_workshop)\n  actions_to_take.append(craft.CRAFT_FUNC(workshop_index))\n\n  return actions_to_take", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-09T21:50:40.903706", "function_name": "craft", "function_body": "  index = env.world.cookbook.index\n  recipe = env.world.cookbook.recipes[index[item]]\n  \n  # Check if the current inventory has all required items\n  required_items = {k: v for k, v in recipe.items() if k != \"_at\"}\n  inventory = {env.world.cookbook.index.get(k): env._current_state.inventory[k] for k in required_items}\n  if any(inventory[i] < count for i, count in required_items.items()):\n    return []\n\n  # Find the workshop to craft at\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.workshop_indices[env.world.cookbook.index.get(workshop_name)]\n\n  actions = []\n  \n  # Move towards the workshop if not already adjacent\n  current_pos = env._current_state.pos\n  target_pos = None\n  for dx in range(-1, 2):\n      for dy in range(-1, 2):\n          x, y = current_pos[0] + dx, current_pos[1] + dy\n          if (x >= 0 and x < env._current_state.grid.shape[0] and \n              y >= 0 and y < env._current_state.grid.shape[1] and \n              env._current_state.grid[x, y, workshop_index] == 1):\n              target_pos = (x, y)\n              break\n      if target_pos:\n          break\n\n  if not target_pos:\n      return []\n\n  # Calculate the path to the workshop (simple greedy approach for demonstration)\n  while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n      \n      if abs(dx) > abs(dy):\n          action = craft.DOWN if dx > 0 else craft.UP\n      else:\n          action = craft.RIGHT if dy > 0 else craft.LEFT\n      \n      actions.append(action)\n      current_pos = (current_pos[0] + (action == craft.DOWN) - (action == craft.UP), \n                     current_pos[1] + (action == craft.RIGHT) - (action == craft.LEFT))\n  \n  # Turn to face the workshop\n  target_direction = None\n  for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n      if current_pos[0] + dx == target_pos[0] and current_pos[1] + dy == target_pos[1]:\n          target_direction = craft.LEFT if dx < 0 else craft.RIGHT if dx > 0 else craft.DOWN if dy > 0 else craft.UP\n          break\n\n  if not target_direction:\n      return []\n  \n  # Rotate to face the workshop\n  current_direction = env._current_state.dir\n  while current_direction != target_direction:\n      action = (current_direction + 1) % 4 if current_direction < target_direction else (current_direction - 1) % 4\n      actions.append(action)\n      current_direction = (current_direction + 1) % 4 if action == craft.LEFT else (current_direction - 1) % 4\n  \n  # Craft the item by using the USE action\n  actions.append(craft.USE)\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-09T21:51:29.594712", "function_name": "craft", "function_body": "  # Fetch the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the primitives required to craft the desired item\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n  \n  # Initialize an empty list to store actions\n  actions = []\n  \n  # Check if we have all the primitives required in our inventory\n  for primitive_index, count in primitives_required.items():\n    if env._current_state.inventory[primitive_index] < count:\n      return []  # Return empty action list if any primitive is not sufficient\n\n  # If we have all primitives, proceed to craft the item\n  workshop_index = None\n  \n  # Find out which workshop is needed for crafting the desired item\n  for output_item, recipe in env.world.cookbook.recipes.items():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n      workshop_index = recipe.get(\"_at\", None)\n      break\n\n  if workshop_index is None:\n    return []  # Return empty action list if no workshop found for the desired item\n\n  # Find the position of the workshop on the grid\n  workshop_position = None\n  for y in range(env._current_state.grid.shape[0]):\n    for x in range(env._current_state.grid.shape[1]):\n      if env._current_state.grid[y, x, workshop_index] == 1:\n        workshop_position = (x, y)\n        break\n    if workshop_position:\n      break\n\n  if workshop_position is None:\n    return []  # Return empty action list if the workshop position not found\n\n  # Generate actions to move to the workshop\n  path_to_workshop = find_path(env._current_state.pos, workshop_position, env._current_state.grid)\n  for pos in path_to_workshop[:-1]:\n      actions.extend(move_towards(env._current_state.pos, pos))\n      env._current_state.pos = pos\n\n  # Turn to face the workshop\n  actions.append(face_direction(env._current_state.pos, workshop_position))\n\n  # Perform the USE action to craft the item\n  actions.append(craft.CraftLab.ACTIONS['USE'])\n  \n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-09T21:51:30.554540", "function_name": "craft", "function_body": "  # Get the index for the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the goal has a recipe\n  if item_index not in env.world.cookbook.recipes:\n    return []\n  \n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Initialize actions list\n  actions = []\n\n  # Collect all required primitives and crafted items for the recipe\n  for ingredient, count in recipe.items():\n      if ingredient == \"_key\":\n          continue  # Skip workshop information\n\n      # Get the index of the ingredient\n      ingredient_index = env.world.cookbook.index[ingredient]\n\n      # Collect the required number of this ingredient\n      while np.sum(env._current_state.inventory[ingredient_index]) < count:\n          collect_actions = collect_v2(env, ingredient)\n          actions.extend(collect_actions)\n\n  # Find and move to the workshop specified in the recipe\n  workshop_key = next(key for key in recipe.keys() if key.startswith(\"_key\"))\n  workshop_name = recipe[workshop_key]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Move to the nearest workshop with the correct name\n  move_actions, _ = find_nearest_workshop(env._current_state, workshop_index)\n  actions.extend(move_actions)\n\n  # Face the workshop and use it to craft the item\n  face_workshop_actions = face_direction_towards_target(env._current_state, workshop_index)\n  actions.extend(face_workshop_actions)\n\n  # Use action to craft the item\n  actions.append(craft.ACTIONS['USE'])\n\n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-09T21:52:24.431520", "function_name": "craft", "function_body": "  actions = []\n  cookbook = env.world.cookbook\n  index = cookbook.index\n\n  # Get the required primitives for the item\n  goal_index = index[item]\n  if goal_index not in cookbook.recipes:\n    return []\n\n  # Check if we have all the primitives required to craft the item\n  required_primitives = cookbook.primitives_for(goal_index)\n  available_primitives = {index.get(i): env._current_state.inventory[i] for i in range(len(env._current_state.inventory))}\n\n  # Verify if all required primitives are available in the inventory\n  for primitive, count in required_primitives.items():\n    if available_primitives.get(index.get(primitive), 0) < count:\n      return []\n\n  # Find the workshop where the item can be crafted\n  workshop = cookbook.recipes[goal_index]['_key']\n  workshop_index = index[workshop]\n\n  # Get the position of all workshops in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    return []\n\n  # Choose the nearest workshop to move to\n  agent_position = env._current_state.pos\n  closest_workshop_position = min(workshop_positions, key=lambda p: np.linalg.norm(np.array(p) - np.array(agent_position)))\n\n  # Calculate the actions required to reach the nearest workshop\n  path_to_workshop = a_star_search(env._current_state.grid, agent_position, tuple(closest_workshop_position))\n  \n  if not path_to_workshop:\n    return []\n\n  # Convert path to actions (UP, DOWN, LEFT, RIGHT)\n  for i in range(len(path_to_workshop) - 1):\n      current_pos = path_to_workshop[i]\n      next_pos = path_to_workshop[i + 1]\n\n      if next_pos[0] > current_pos[0]:\n          actions.append(env.world.N_ACTIONS.DOWN)\n      elif next_pos[0] < current_pos[0]:\n          actions.append(env.world.N_ACTIONS.UP)\n      elif next_pos[1] > current_pos[1]:\n          actions.append(env.world.N_ACTIONS.RIGHT)\n      elif next_pos[1] < current_pos[1]:\n          actions.append(env.world.N_ACTIONS.LEFT)\n\n  # Face the workshop before using it\n  last_pos = path_to_workshop[-1]\n  workshop_direction = calculate_direction(agent_position, tuple(last_pos))\n\n  if workshop_direction == env._current_state.dir:\n      actions.append(env.world.N_ACTIONS.USE)\n  else:\n      # Turn to face the workshop\n      actions.extend(turn_towards(env._current_state.dir, workshop_direction))\n      actions.append(env.world.N_ACTIONS.USE)\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-09T21:52:25.388122", "function_name": "craft", "function_body": "  # Extracting necessary information from the environment\n  cookbook = env.world.cookbook\n  current_inventory = env._current_state.inventory.copy()\n  index = cookbook.index\n\n  # Find the index for the desired item to craft\n  goal_index = index[item]\n  \n  if goal_index is None:\n    print(f\"Unknown item: {item}\")\n    return []\n\n  # Get primitives required to craft the item\n  primitives_required = cookbook.primitives_for(goal_index)\n\n  actions = []\n  # Check if all required primitives are in inventory or can be collected from the environment\n  for primitive, count in primitives_required.items():\n    primitive_name = index.get(primitive)\n    \n    if current_inventory[primitive] >= count:\n      continue\n\n    # If not enough primitives, collect them\n    actions.extend(collect(env, primitive_name))\n\n    # Check again after collecting to ensure we have enough\n    if env._current_state.inventory[primitive] < count:\n      return []  # Failed to collect enough primitives\n\n  # Move to the correct workshop and perform USE action to craft the item\n  workshop_index = cookbook.recipes[goal_index].get(\"_key\")\n  workshop_name = index.get(workshop_index)\n  \n  if not workshop_name.startswith(\"workshop\"):\n    print(f\"Invalid workshop: {workshop_name}\")\n    return []\n\n  # Navigate to the workshop and face it for USE action\n  actions.extend(navigate_and_face(env, workshop_name))\n\n  # Use action at the correct workshop\n  actions.append(craft.USE)\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-09T21:53:24.189219", "function_name": "craft", "function_body": "  def get_primitive_indices_and_counts(item_idx):\n    # Get the primitives required and their counts for the given item index\n    recipe = env.world.cookbook.recipes[item_idx]\n    primitive_indices = [env.world.cookbook.index[name] for name in recipe if name != \"_key\"]\n    return {i: recipe[env.world.cookbook.index.get_name(i)] for i in primitive_indices}\n\n  def collect_primitives(primitive_counts):\n    actions = []\n    inventory = env._current_state.inventory\n    for i, count in primitive_counts.items():\n      while inventory[i] < count:\n        primitive_name = env.world.cookbook.index.get(i)\n        actions.extend(collect(env, primitive_name))\n    return actions\n\n  def find_workshop(item_idx):\n    # Find the workshop that can craft the item based on the recipe\n    for recipe in env.world.cookbook.recipes.values():\n      if \"_key\" in recipe and recipe[\"_key\"] == env.world.cookbook.index[item]:\n        return recipe.get(\"_at\", None)\n    return None\n\n  def move_to_workshop(workshop_name):\n    # Move to the specified workshop\n    for workshop_idx in env.world.workshop_indices:\n      if env.world.cookbook.index[workshop_name] == workshop_idx:\n        pos = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n        if len(pos) > 0:\n          target_pos = tuple(pos[0])\n          actions = move_to_position(target_pos)\n          return actions\n    return []\n\n  def move_to_position(target_pos):\n    # Move to the specified position (not implemented in detail here)\n    current_pos = env._current_state.pos\n    path = astar_pathfinding(current_pos, target_pos, env._current_state.grid)\n    actions = [move(env, direction) for direction in path]\n    return actions\n\n  def use_action():\n    # Perform the USE action\n    return [craft.USE]\n\n  item_idx = env.world.cookbook.index[item]\n  if item_idx not in env.world.cookbook.recipes:\n    return []\n\n  primitive_counts = get_primitive_indices_and_counts(item_idx)\n  actions = collect_primitives(primitive_counts)\n\n  workshop_name = find_workshop(item_idx)\n  if workshop_name is None:\n    return []\n\n  actions.extend(move_to_workshop(workshop_name))\n  actions.append(use_action())\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-09T21:53:25.229172", "function_name": "craft", "function_body": "  def find_workshop_for_item(item_idx):\n    # Find the workshop that can craft the item\n    for recipe in env.world.cookbook.recipes.values():\n      if \"_key\" in recipe and recipe[\"_key\"] == item_idx:\n        return recipe.get(\"_at\", None)\n    return None\n\n  def get_primitive_counts(primitive_indices, inventory):\n    # Get the counts of primitives in the inventory\n    return {i: inventory[i] for i in primitive_indices}\n\n  def collect_primitives(primitive_indices, required_counts):\n    actions = []\n    for i in primitive_indices:\n      while inventory[i] < required_counts[i]:\n        primitive_name = env.world.cookbook.index.get(i)\n        actions.extend(collect(env, primitive_name))\n    return actions\n\n  # Get the index of the item to craft\n  item_idx = env.world.cookbook.index[item]\n  \n  # Check if we have a recipe for this item\n  if item_idx not in env.world.cookbook.recipes:\n    return []\n  \n  # Get the ingredients required and their counts\n  ingredients = {k: v for k, v in env.world.cookbook.recipes[item_idx].items() if k != \"_at\"}\n  \n  # Find the workshop for crafting the item\n  workshop_name = find_workshop_for_item(item_idx)\n  if workshop_name is None:\n    return []\n  \n  # Find the index of the workshop in the environment\n  workshop_idx = env.world.workshop_indices[workshop_name]\n  \n  # Collect primitives required for crafting\n  actions = collect_primitives(list(ingredients.keys()), ingredients)\n  \n  # Navigate to the workshop and perform USE action\n  workshop_pos = find_closest_workshop(env, workshop_idx)\n  if not workshop_pos:\n    return []\n  \n  actions.extend(navigate_to_position(workshop_pos))\n  actions.append(use_action())\n  \n  return actions", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-09-09T21:54:55.485907", "function_name": "craft", "function_body": "  def get_actions_to_move(pos1, pos2):\n    dx = pos2[0] - pos1[0]\n    dy = pos2[1] - pos1[1]\n\n    actions = []\n    if dx > 0:\n      actions.extend([craft.MOVE_RIGHT for _ in range(dx)])\n    elif dx < 0:\n      actions.extend([craft.MOVE_LEFT for _ in range(-dx)])\n\n    if dy > 0:\n      actions.extend([craft.MOVE_DOWN for _ in range(dy)])\n    elif dy < 0:\n      actions.extend([craft.MOVE_UP for _ in range(-dy)])\n\n    return actions\n\n  def get_actions_to_turn(current_direction, target_direction):\n    directions = [\"UP\", \"RIGHT\", \"DOWN\", \"LEFT\"]\n    current_index = directions.index(current_direction)\n    target_index = directions.index(target_direction)\n\n    if (current_index - target_index) % 4 == 1:\n      return [craft.TURN_RIGHT]\n    elif (current_index - target_index) % 4 == 3:\n      return [craft.TURN_LEFT]\n    elif current_index != target_index:\n      return [craft.TURN_RIGHT, craft.TURN_RIGHT]\n    else:\n      return []\n\n  item_index = env.world.cookbook.index[item]\n\n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n\n  required_ingredients = recipe.copy()\n  workshop_name = required_ingredients.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  available_inventory = {env.world.cookbook.index[k]: v for k, v in env._current_state.inventory.items()}\n\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if not can_craft:\n    return []\n\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No available workshop to craft item\")\n\n  current_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n  actions_to_take = get_actions_to_move(tuple(current_position), nearest_workshop_pos)\n\n  current_direction = env._current_state.dir\n  target_direction = \"RIGHT\" if nearest_workshop_pos[0] > current_position[0] else \\\n                    \"LEFT\" if nearest_workshop_pos[0] < current_position[0] else \\\n                    \"DOWN\" if nearest_workshop_pos[1] > current_position[1] else \\\n                    \"UP\"\n\n  actions_to_take.extend(get_actions_to_turn(current_direction, target_direction))\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-09T21:54:56.459617", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n\n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n\n  # Check if we have all ingredients in inventory to craft this item\n  required_ingredients = recipe.copy()\n  workshop_name = required_ingredients.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  available_inventory = {env.world.cookbook.index[k]: v for k, v in env._current_state.inventory.items()}\n\n  # Check if all ingredients are available\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if not can_craft:\n    return []\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No available workshop to craft item\")\n\n  # Select the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n  # Calculate actions to move the agent to the nearest workshop\n  dx = nearest_workshop_pos[0] - current_position[0]\n  dy = nearest_workshop_pos[1] - current_position[1]\n\n  actions_to_take = []\n\n  if dx > 0:\n    actions_to_take.extend([craft.MOVE_RIGHT for _ in range(dx)])\n  elif dx < 0:\n    actions_to_take.extend([craft.MOVE_LEFT for _ in range(-dx)])\n\n  if dy > 0:\n    actions_to_take.extend([craft.MOVE_DOWN for _ in range(dy)])\n  elif dy < 0:\n    actions_to_take.extend([craft.MOVE_UP for _ in range(-dy)])\n\n  # Rotate the agent to face the workshop\n  target_direction = env._current_state.dir\n\n  if dx > 0 and target_direction != craft.RIGHT:\n    while target_direction != craft.RIGHT:\n      actions_to_take.append(craft.TURN_RIGHT)\n      target_direction = (target_direction + 1) % 4\n  elif dx < 0 and target_direction != craft.LEFT:\n    while target_direction != craft.LEFT:\n      actions_to_take.append(craft.TURN_LEFT)\n      target_direction = (target_direction - 1) % 4\n\n  if dy > 0 and target_direction != craft.DOWN:\n    while target_direction != craft.DOWN:\n      actions_to_take.append(craft.TURN_RIGHT)\n      target_direction = (target_direction + 1) % 4\n  elif dy < 0 and target_direction != craft.UP:\n    while target_direction != craft.UP:\n      actions_to_take.append(craft.TURN_LEFT)\n      target_direction = (target_direction - 1) % 4\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-09T21:55:42.164874", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  item_idx = env.world.cookbook.index[item]\n  \n  # Check if we have all the primitives required for crafting\n  primitives_needed = env.world.cookbook.primitives_for(item_idx)\n  actions = []\n\n  # Collect primitives if not already in inventory\n  for primitive_idx, count in primitives_needed.items():\n    while env._current_state.inventory[primitive_idx] < count:\n      actions.extend(collect_v2(env, primitive_idx))\n  \n  # Determine which workshop to go to and craft the item\n  recipe = env.world.cookbook.recipes[item_idx]\n  workshop_name = recipe['_key']\n  workshop_idx = env.world.cookbook.index[workshop_name]\n\n  # Find position of the workshop in the grid\n  positions = np.argwhere(env._current_state.grid[:, :, workshop_idx] > 0)\n  if len(positions) == 0:\n    raise ValueError(f\"No {workshop_name} found on the map.\")\n\n  workshop_pos = tuple(positions[0])\n\n  # Move to the workshop position and face it\n  actions.extend(move_to(env, workshop_pos))\n  actions.append(face_direction_for_use(env._current_state.pos, workshop_pos))\n\n  # Craft the item by using the USE action\n  actions.append(4)  # Use action\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-09T21:55:43.173217", "function_name": "craft", "function_body": "  actions = []\n  # Convert item name to index\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the recipe exists for the item\n  if item_index not in env.world.cookbook.recipes:\n    return actions\n\n  # Get the recipe\n  recipe = env.world.cookbook.recipes[item_index]\n  \n  # List of primitives needed and their counts\n  needed_primitives = {env.world.cookbook.index[primitive]: count for primitive, count in recipe.items() if primitive != \"_at\"}\n\n  # Check inventory to see what we already have\n  current_inventory = env._current_state.inventory\n\n  # Calculate the primitives we need to collect\n  missing_primitives = {i_kind: needed - current_inventory[i_kind] for i_kind, needed in needed_primitives.items()}\n\n  # If any primitive is negative, set it to zero as we don't need more than required\n  missing_primitives = {i_kind: max(count, 0) for i_kind, count in missing_primitives.items()}\n  \n  # Collect the primitives that are missing\n  for i_kind, count in missing_primitives.items():\n    actions.extend(collect_v2(env, env.world.cookbook.index.get(i_kind)))\n\n  # Now we have all primitives needed, go to the workshop to craft the item\n  workshop = recipe[\"_at\"]\n  workshop_index = env.world.workshop_indices[workshop]\n  \n  # Find a path to the workshop\n  path_to_workshop = find_path(env._current_state.grid, env._current_state.pos, env._current_state.dir, workshop_index)\n  actions.extend(path_to_workshop)\n\n  # Turn to face the workshop block\n  actions.append(faceto_block(env._current_state.grid, env._current_state.pos, workshop_index))\n\n  # Use the action at the workshop to craft the item\n  actions.append(env.world.N_ACTIONS)  # Assuming USE is the last action in N_ACTIONS\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-09T21:56:31.295791", "function_name": "craft", "function_body": "  actions = []\n\n  # Get the index of the item to craft\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the item can be crafted\n  if item_index not in env.world.cookbook.recipes:\n    return []\n  \n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Collect all required primitives and items\n  for ingredient, count in recipe.items():\n    if ingredient != \"_at\":\n      actions.extend(collect(env, ingredient))\n      \n      # Check inventory to see if we have enough of the ingredient\n      while sum(env._current_state.inventory[env.world.cookbook.index[i]]) < count:\n        actions.extend(collect(env, ingredient))\n\n  # Determine which workshop to use for crafting\n  workshop = recipe.get(\"_at\", None)\n  \n  if workshop is None:\n    return []\n\n  workshop_index = env.world.workshop_indices[env.world.cookbook.index[workshop]]\n\n  # Find the position of the nearest workshop\n  closest_workshop_pos = find_closest_workshop(env._current_state, workshop_index)\n\n  # Move to the nearest workshop\n  actions.extend(move_to_position(env._current_state.pos, closest_workshop_pos))\n\n  # Face the workshop and use it\n  actions.append(4)  # USE action\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-09T21:56:32.250767", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  index = cookbook.index\n\n  # Get the goal index from the item name\n  goal_index = index[item]\n\n  # Check if there is a recipe for the goal item\n  if goal_index not in cookbook.recipes:\n    print(f\"No recipe found for {item}\")\n    return []\n\n  # Get the required ingredients and their counts for the goal item\n  recipe = cookbook.recipes[goal_index]\n  ingredients_needed = {index[i]: count for i, count in recipe.items() if i != \"_key\"}\n\n  # Check if we have all the ingredients in our inventory\n  current_inventory = env._current_state.inventory\n  actions_to_take = []\n\n  # Collect missing ingredients\n  for ingredient_index, required_count in ingredients_needed.items():\n    # Get the item name from its index\n    ingredient_name = cookbook.index.get(ingredient_index)\n\n    # Calculate how many more of this ingredient we need\n    current_count = current_inventory[ingredient_index]\n    additional_required = required_count - current_count\n\n    if additional_required > 0:\n      actions_to_take.extend(collect_v2(env, ingredient_name, additional_required))\n\n  # After collecting all the ingredients, go to the workshop and craft the item\n  workshop_name = recipe[\"_key\"]\n  workshop_index = index[workshop_name]\n\n  # Find a cell next to the workshop\n  for x in range(env.world.grid.shape[0]):\n    for y in range(env.world.grid.shape[1]):\n      if env._current_state.grid[x, y, workshop_index] > 0:\n        target_pos = (x, y)\n        break\n\n  actions_to_take.extend(move_to_v2(env, target_pos))\n\n  # The agent must face the block to use it. We need to determine the correct direction.\n  current_pos = env._current_state.pos\n  dx = target_pos[0] - current_pos[0]\n  dy = target_pos[1] - current_pos[1]\n\n  if dx > 0:\n      actions_to_take.append(env.world.world.index[\"RIGHT\"])\n  elif dx < 0:\n      actions_to_take.append(env.world.world.index[\"LEFT\"])\n  elif dy > 0:\n      actions_to_take.append(env.world.world.index[\"DOWN\"])\n  elif dy < 0:\n      actions_to_take.append(env.world.world.index[\"UP\"])\n\n  # Perform the USE action to craft the item\n  actions_to_take.append(env.world.world.index[\"USE\"])\n\n  return actions_to_take", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-09T21:58:26.715514", "function_name": "craft", "function_body": "  def move_to_position(x, y):\n    current_x, current_y = env._current_state.pos\n    dx = x - current_x\n    dy = y - current_y\n\n    # Move horizontally first\n    if dx > 0:\n        actions.extend([craft.MOVE_RIGHT for _ in range(dx)])\n    elif dx < 0:\n        actions.extend([craft.MOVE_LEFT for _ in range(-dx)])\n\n    # Then move vertically\n    if dy > 0:\n        actions.extend([craft.MOVE_DOWN for _ in range(dy)])\n    elif dy < 0:\n        actions.extend([craft.MOVE_UP for _ in range(-dy)])\n\n    return\n\n  def rotate_to_direction(target_dir):\n    current_dir = env._current_state.dir\n    while current_dir != target_dir:\n        if (target_dir - current_dir) % 4 == 1 or (target_dir - current_dir) % 4 == -3:\n            actions.append(craft.TURN_RIGHT)\n            current_dir = (current_dir + 1) % 4\n        elif (target_dir - current_dir) % 4 == 2 or (target_dir - current_dir) % 4 == -2:\n            actions.append(craft.TURN_RIGHT)\n            current_dir = (current_dir + 1) % 4\n            actions.append(craft.TURN_RIGHT)\n            current_dir = (current_dir + 1) % 4\n        elif (target_dir - current_dir) % 4 == 3 or (target_dir - current_dir) % 4 == -1:\n            actions.append(craft.TURN_LEFT)\n            current_dir = (current_dir - 1) % 4\n\n    return\n\n  item_index = env.world.cookbook.index[item]\n\n  if not item_index:\n      raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n\n  # Check if we have all ingredients in inventory to craft this item\n  required_ingredients = recipe.copy()\n  required_ingredients.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  available_inventory = {env.world.cookbook.index[k]: v for k, v in env.world.cookbook.index.reverse_contents.items() if k in env._current_state.inventory}\n\n  # Check if all ingredients are available\n  can_craft = True\n  actions = []\n\n  for ingredient_index, required_count in required_ingredients.items():\n      if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n          can_craft = False\n          break\n\n  if can_craft:\n      # Determine the workshop to use based on the \"_at\" field of the recipe\n      workshop_name = recipe.get(\"_at\", None)\n      if workshop_name is not None:\n          workshop_index = env.world.cookbook.index[workshop_name]\n\n          # Find all positions of the required workshop in the grid\n          workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n          if len(workshop_positions) == 0:\n              raise ValueError(\"No available workshop to craft item\")\n\n          # Select the nearest workshop\n          current_position = np.array(env._current_state.pos)\n          distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n          nearest_workshop_index = np.argmin(distances_to_workshops)\n          nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n          # Calculate actions to move the agent to the nearest workshop\n          move_to_position(nearest_workshop_pos[0], nearest_workshop_pos[1])\n          \n          # Rotate the agent to face the workshop\n          target_direction = env._current_state.dir\n          if nearest_workshop_pos[0] > current_position[0]:\n              target_direction = craft.RIGHT\n          elif nearest_workshop_pos[0] < current_position[0]:\n              target_direction = craft.LEFT\n\n          if nearest_workshop_pos[1] > current_position[1]:\n              target_direction = craft.DOWN\n          elif nearest_workshop_pos[1] < current_position[1]:\n              target_direction = craft.UP\n\n          rotate_to_direction(target_direction)\n\n          # Add the USE action to craft the item\n          actions.append(craft.USE)\n          \n      else:\n          raise ValueError(\"No workshop specified in the recipe\")\n\n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-09T21:58:27.738093", "function_name": "craft", "function_body": "  def move_towards_position(current_pos, target_pos):\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    actions = []\n    if dx > 0:\n      actions.extend([craft.MOVE_RIGHT for _ in range(dx)])\n    elif dx < 0:\n      actions.extend([craft.MOVE_LEFT for _ in range(-dx)])\n\n    if dy > 0:\n      actions.extend([craft.MOVE_DOWN for _ in range(dy)])\n    elif dy < 0:\n      actions.extend([craft.MOVE_UP for _ in range(-dy)])\n\n    return actions\n\n  def rotate_to_direction(current_dir, target_dir):\n    actions = []\n    while current_dir != target_dir:\n        if (current_dir + 1) % 4 == target_dir or (current_dir - 3) % 4 == target_dir:\n            actions.append(craft.TURN_RIGHT)\n            current_dir = (current_dir + 1) % 4\n        else:\n            actions.append(craft.TURN_LEFT)\n            current_dir = (current_dir - 1) % 4\n    return actions\n\n  item_index = env.world.cookbook.index[item]\n  \n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n\n  # Check if we have all ingredients in inventory to craft this item\n  required_ingredients = recipe.copy()\n  workshop_name = required_ingredients.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  available_inventory = {env.world.cookbook.index[k]: v for k, v in env._current_state.inventory.items()}\n\n  can_craft = True\n  actions_to_take = []\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if can_craft and workshop_name is not None:\n    # Determine the workshop to use based on the \"_at\" field of the recipe\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find all positions of the required workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n    if len(workshop_positions) == 0:\n      raise ValueError(\"No available workshop to craft item\")\n\n    # Select the nearest workshop\n    current_position = np.array(env._current_state.pos)\n    distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n    nearest_workshop_index = np.argmin(distances_to_workshops)\n    nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n    # Calculate actions to move the agent to the nearest workshop\n    actions_to_take.extend(move_towards_position(current_position, nearest_workshop_pos))\n\n    # Rotate the agent to face the workshop\n    target_direction = env._current_state.dir  # Assuming the agent should face the direction it's moving towards\n\n    # Check if the target position is directly in front of the agent after movement\n    current_dir = env._current_state.dir\n    if nearest_workshop_pos[0] > current_position[0]:  # Moving right\n        target_direction = craft.RIGHT\n    elif nearest_workshop_pos[0] < current_position[0]:  # Moving left\n        target_direction = craft.LEFT\n    elif nearest_workshop_pos[1] > current_position[1]:  # Moving down\n        target_direction = craft.DOWN\n    elif nearest_workshop_pos[1] < current_position[1]:  # Moving up\n        target_direction = craft.UP\n\n    actions_to_take.extend(rotate_to_direction(current_dir, target_direction))\n\n    # Add the USE action to craft the item\n    actions_to_take.append(craft.USE)\n\n  else:\n    raise ValueError(\"Missing ingredients or no workshop specified in the recipe\")\n\n  return actions_to_take", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-09T21:59:26.614625", "function_name": "craft", "function_body": "  index = env.world.cookbook.index\n  goal_index = index[item]\n  \n  def get_required_primitives(item_idx):\n    recipe = env.world.cookbook.recipes.get(item_idx)\n    if not recipe:\n      return {}\n\n    required_primitives = {}\n    for ingredient, count in recipe.items():\n        if ingredient == \"_at\":\n            continue\n        ingredient_idx = index[ingredient]\n        required_primitives[ingredient_idx] = count\n\n    return required_primitives\n  \n  # Get the required primitives and their counts to craft the item\n  required_primitives = get_required_primitives(goal_index)\n\n  def has_all_primitives(required_primitives):\n      for primitive, count in required_primitives.items():\n          if env._current_state.inventory[primitive] < count:\n              return False\n      return True\n  \n  # Check if we have all the primitives needed to craft the item\n  if not has_all_primitives(required_primitives):\n      return []\n\n  def find_workshop(workshop_name):\n    for idx, i_kind in enumerate(env.world.workshop_indices):\n        if env._current_state.next_to(i_kind):\n            workshop_index = idx\n            break\n    else:\n        return None\n\n    if index.get(workshop_name) == i_kind:\n        return (workshop_index, i_kind)\n    \n    return None\n  \n  # Get the workshop location specified in the recipe\n  workshop_location = env.world.cookbook.recipes[goal_index][\"_at\"]\n  workshop_info = find_workshop(workshop_location)\n\n  if not workshop_info:\n      return []\n\n  def actions_to_go_to_workshop(workshop_index, i_kind):\n    path = a_star_search(env._current_state.pos, workshop_position_from_index(workshop_index, i_kind), env._current_state.grid)\n    actions = []\n    for next_pos in path[1:]:  # Skip the current position\n        direction = get_direction_from_positions(env._current_state.pos, next_pos)\n        actions.append(direction_to_action(direction))\n        env._current_state.pos = next_pos\n    return actions\n\n  def workshop_position_from_index(workshop_index, i_kind):\n      for y in range(env._current_state.grid.shape[0]):\n          for x in range(env._current_state.grid.shape[1]):\n              if env._current_state.grid[y, x, i_kind] > 0:\n                  return (x, y)\n      return None\n\n  def get_direction_from_positions(current_pos, next_pos):\n    x_diff = next_pos[0] - current_pos[0]\n    y_diff = next_pos[1] - current_pos[1]\n    if x_diff == 1:\n        return 3  # RIGHT\n    elif x_diff == -1:\n        return 2  # LEFT\n    elif y_diff == 1:\n        return 0  # DOWN\n    elif y_diff == -1:\n        return 1  # UP\n    else:\n        return None\n\n  def direction_to_action(direction):\n      action_map = {0: 0, 1: 1, 2: 2, 3: 3}\n      return action_map.get(direction)\n\n  workshop_index, i_kind = workshop_info\n  actions = actions_to_go_to_workshop(workshop_index, i_kind)\n  actions.append(4)  # USE action to craft the item\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-09T21:59:27.702929", "function_name": "craft", "function_body": "  # Retrieve the index for the desired item from the cookbook.\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item is a primitive; primitives cannot be crafted.\n  if item_index in env.world.cookbook.primitives:\n    return []\n\n  # Obtain the recipe for crafting the specified item.\n  recipe = env.world.cookbook.recipes.get(item_index)\n\n  if not recipe or \"_key\" not in recipe:\n    return []\n\n  workshop_key = recipe[\"_key\"]\n  workshop_index = env.world.cookbook.index[workshop_key]\n\n  actions = []\n  # Check if the required items are available in the inventory.\n  for ingredient, count in recipe.items():\n    if ingredient == \"_key\":\n      continue\n    ingredient_index = env.world.cookbook.index[ingredient]\n    if env._current_state.inventory[ingredient_index] < count:\n      return []\n\n  # Move to a workshop that can craft the item.\n  actions.extend(move_to_workshop(env, workshop_index))\n\n  # Use the USE action at the correct location.\n  actions.append(craft.ACTION_USE)\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-09T22:00:13.619830", "function_name": "craft", "function_body": "  # Get the index of the desired item from the cookbook.\n  item_index = env.world.cookbook.index[item]\n  \n  # Retrieve the recipe for the desired item.\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n  \n  if not recipe:\n    print(f\"No recipe found for {item}.\")\n    return []\n\n  # Check if all required primitives are available in the inventory.\n  primitives_needed = {}\n  workshop_needed = None\n  for key, value in recipe.items():\n    if key == \"_at\":\n      workshop_needed = value\n    else:\n      primitives_needed[env.world.cookbook.index[key]] = value\n\n  # Find the index of the required workshop.\n  workshop_index = env.world.cookbook.index.get(workshop_needed)\n  \n  if not workshop_index:\n    print(f\"Workshop {workshop_needed} not found.\")\n    return []\n\n  # Check inventory for required primitives.\n  inventory = env._current_state.inventory\n  actions = []\n  \n  # Collect missing primitives.\n  for primitive, count in primitives_needed.items():\n    if inventory[primitive] < count:\n      # Find position of the primitive on the grid.\n      positions = np.argwhere(env._current_state.grid[:, :, primitive] > 0)\n      \n      if len(positions) == 0:\n        print(f\"Primitive {env.world.cookbook.get(primitive)} not found on the grid.\")\n        return []\n      \n      # Move to and collect the nearest primitive.\n      target_pos = positions[0]\n      actions.extend(move_to(env, target_pos))\n      actions.append(craft.COLLECT_FUNC(primitive))\n  \n  # Move to the required workshop.\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n    print(f\"Workshop {workshop_needed} not found on the grid.\")\n    return []\n  \n  target_workshop_pos = workshop_positions[0]\n  actions.extend(move_to(env, target_workshop_pos))\n  \n  # Use the USE action to craft the item.\n  actions.append(craft.USE_FUNC())\n  \n  return actions", "island_id": 3, "scores": {"3": -1}}
