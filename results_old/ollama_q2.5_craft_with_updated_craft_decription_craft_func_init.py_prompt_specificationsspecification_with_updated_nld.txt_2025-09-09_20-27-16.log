   total_path.append(direction_to_face)\n        current = came_from[current]\n\n      actions.extend(reversed(total_path))\n\n    return actions\n\n  def heuristic(a, b):\n    ax, ay = divmod(a, env._current_state.grid.shape[1])\n    bx, by = divmod(b, env._current_state.grid.shape[1])\n\n    # Manhattan distance\n    return abs(ax - bx) + abs(ay - by)\n\n  actions = []\n\n  item_index = env.world.cookbook.index[item]\n  \n  if not item_index:\n    return []\n\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  current_inventory = {env.world.cookbook.index.get(i): c for i, c in enumerate(env._current_state.inventory) if c > 0}\n\n  # Check if we have all the required primitives\n  for primitive_index, count in primitives_needed.items():\n    if current_inventory.get(primitive_index, 0) < count:\n      return []\n\n  # Find the workshop to craft the item\n  workshop_name = env.world.cookbook.recipes[item_index][\"_at\"]\n  workshop_indices = np.argwhere(env._current_state.grid[:, :, env.world.workshop_indices[0]] == env.world.cookbook.index[workshop_name])\n\n  if not workshop_indices.any():\n    return []\n\n  # Convert the grid coordinates to a flat list\n  flat_grid = env._current_state.grid.reshape(-1, env.world.n_kinds)\n\n  start_pos_flat = env._current_state.pos[0] * env._current_state.grid.shape[1] + env._current_state.pos[1]\n  target_pos_flat = workshop_indices[0][0] * env._current_state.grid.shape[1] + workshop_indices[0][1]\n\n  actions.extend(find_path(start_pos_flat, target_pos_flat))\n\n  # Ensure we are in front of the workshop\n  target_workshop_position = (workshop_indices[0][0], workshop_indices[0][1])\n  direction_to_face = get_direction(env._current_state.pos, target_workshop_position)\n  if direction_to_face is not None:\n      actions.append(direction_to_face)\n\n  # Craft the item by using the USE action\n  actions.append(4)  # USE action\n\n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T12:56:15.646162", "function_name": "craft", "function_body": "  def get_direction(current_pos, target_pos):\n    x_diff = target_pos[0] - current_pos[0]\n    y_diff = target_pos[1] - current_pos[1]\n\n    if x_diff > 0:\n      return 3  # RIGHT\n    elif x_diff < 0:\n      return 2  # LEFT\n    elif y_diff > 0:\n      return 1  # UP\n    else:\n      return 0  # DOWN\n\n  def find_path(start, target):\n    actions = []\n\n    start_x, start_y = divmod(start, env._current_state.grid.shape[1])\n    target_x, target_y = divmod(target, env._current_state.grid.shape[1])\n\n    open_set = []\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, target)}\n\n    heapq.heappush(open_set, (f_score[start], start))\n\n    while open_set:\n      _, current = heapq.heappop(open_set)\n\n      if current == target:\n        reconstruct_path(came_from, current)\n        break\n\n      cx, cy = divmod(current, env._current_state.grid.shape[1])\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = cx + dx, cy + dy\n\n        if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n          neighbor = nx * env._current_state.grid.shape[1] + ny\n          tentative_g_score = g_score[current] + 1\n\n          if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n            came_from[neighbor] = current\n            g_score[neighbor] = tentative_g_score\n            f_score[neighbor] = tentative_g_score + heuristic(neighbor, target)\n            heapq.heappush(open_set, (f_score[neighbor], neighbor))\n\n    def reconstruct_path(came_from, current):\n      total_path = []\n      while current in came_from:\n        cx, cy = divmod(current, env._current_state.grid.shape[1])\n        px, py = divmod(came_from[current], env._current_state.grid.shape[1])\n\n        dx, dy = px - cx, py - cy\n        direction_to_face = get_direction((cx, cy), (px, py))\n        total_path.append(direction_to_face)\n        current = came_from[current]\n\n      actions.extend(reversed(total_path))\n\n    return actions\n\n  def heuristic(a, b):\n    ax, ay = divmod(a, env._current_state.grid.shape[1])\n    bx, by = divmod(b, env._current_state.grid.shape[1])\n\n    # Manhattan distance\n    return abs(ax - bx) + abs(ay - by)\n\n  actions = []\n\n  item_index = env.world.cookbook.index[item]\n  \n  if not item_index:\n    return []\n\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  current_inventory = {env.world.cookbook.index.get(i): c for i, c in enumerate(env._current_state.inventory) if c > 0}\n\n  # Check if we have all the required primitives\n  for primitive_index, count in primitives_needed.items():\n    if current_inventory.get(primitive_index, 0) < count:\n      return []\n\n  # Find the workshop to craft the item\n  workshop_name = env.world.cookbook.recipes[item_index][\"_at\"]\n  workshop_indices = np.argwhere(env._current_state.grid[:, :, env.world.workshop_indices[0]] == env.world.cookbook.index[workshop_name])\n\n  if not workshop_indices.any():\n    return []\n\n  # Convert the grid coordinates to a flat list\n  flat_grid = env._current_state.grid.reshape(-1, env.world.n_kinds)\n\n  start_pos_flat = env._current_state.pos[0] * env._current_state.grid.shape[1] + env._current_state.pos[1]\n  target_pos_flat = workshop_indices[0][0] * env._current_state.grid.shape[1] + workshop_indices[0][1]\n\n  actions.extend(find_path(start_pos_flat, target_pos_flat))\n\n  # Ensure we are in front of the workshop\n  target_workshop_position = (workshop_indices[0][0], workshop_indices[0][1])\n  direction_to_face = get_direction(env._current_state.pos, target_workshop_position)\n  if direction_to_face is not None:\n      actions.append(direction_to_face)\n\n  # Craft the item by using the USE action\n  actions.append(4)  # USE action\n\n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T12:58:00.775746", "function_name": "craft", "function_body": "  goal_index = env.world.cookbook.index[item]\n\n  # Check if we have all required primitives in our inventory\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  current_inventory = collections.Counter(env._current_state.inventory)\n\n  for primitive, count in required_primitives.items():\n    if current_inventory[primitive] < count:\n      return []  # Missing required primitives\n\n  # Determine the workshop where crafting should occur\n  recipe_details = env.world.cookbook.recipes[goal_index]\n  workshop_name = recipe_details[\"_key\"]\n\n  # Get the index of the workshop from the world's cookbook\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the closest workshop in the grid\n  positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(positions) == 0:\n    return []  # No available workshops\n\n  closest_workshop_pos = min(\n      positions, key=lambda x: abs(x[0] - env._current_state.pos[0]) + abs(x[1] - env._current_state.pos[1]))\n\n  # Navigate to the closest workshop\n  current_pos = np.array(env._current_state.pos)\n  target_pos = np.array(closest_workshop_pos)\n\n  actions = []\n\n  while not np.array_equal(current_pos, target_pos):\n    delta = target_pos - current_pos\n\n    # Calculate direction based on the largest absolute difference\n    if abs(delta[0]) > abs(delta[1]):\n      if delta[0] > 0:\n        actions.append(craft.RIGHT)  # Move right\n      else:\n        actions.append(craft.LEFT)   # Move left\n    else:\n      if delta[1] > 0:\n        actions.append(craft.DOWN)   # Move down\n      else:\n        actions.append(craft.UP)     # Move up\n\n    current_pos = np.array(env._current_state.pos)\n\n  # Orient the agent to face the workshop and use it\n  direction_to_workshop = target_pos - current_pos\n\n  if direction_to_workshop[0] > 0:  # Workshop is to the right\n      actions.append(craft.RIGHT)\n  elif direction_to_workshop[0] < 0:  # Workshop is to the left\n      actions.append(craft.LEFT)\n  elif direction_to_workshop[1] > 0:  # Workshop is below\n      actions.append(craft.DOWN)\n  else:  # Workshop is above\n      actions.append(craft.UP)\n\n  actions.append(craft.USE)\n\n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T12:58:01.822292", "function_name": "craft", "function_body": "  goal_index = env.world.cookbook.index[item]\n\n  # Check if we have all required primitives in our inventory\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  current_inventory = collections.Counter(env._current_state.inventory)\n\n  for primitive, count in required_primitives.items():\n    if current_inventory[primitive] < count:\n      return []  # Missing required primitives\n\n  # Determine the workshop where crafting should occur\n  recipe_details = env.world.cookbook.recipes[goal_index]\n  workshop_name = recipe_details[\"_key\"]\n\n  # Get the index of the workshop from the world's cookbook\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the closest workshop in the grid\n  positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(positions) == 0:\n    return []  # No available workshops\n\n  closest_workshop_pos = min(\n      positions, key=lambda x: abs(x[0] - env._current_state.pos[0]) + abs(x[1] - env._current_state.pos[1]))\n\n  # Navigate to the closest workshop\n  current_pos = np.array(env._current_state.pos)\n  target_pos = np.array(closest_workshop_pos)\n\n  actions = []\n\n  while not np.array_equal(current_pos, target_pos):\n    delta = target_pos - current_pos\n\n    if delta[0] > 0:\n      actions.append(craft.RIGHT)  # Move right\n    elif delta[0] < 0:\n      actions.append(craft.LEFT)   # Move left\n\n    if delta[1] > 0:\n      actions.append(craft.DOWN)   # Move down\n    elif delta[1] < 0:\n      actions.append(craft.UP)     # Move up\n\n    current_pos = np.array(env._current_state.pos)\n\n  # Orient the agent to face the workshop and use it\n  direction_to_workshop = target_pos - current_pos\n\n  if direction_to_workshop[0] > 0:  # Workshop is to the right\n      actions.append(craft.RIGHT)\n  elif direction_to_workshop[0] < 0:  # Workshop is to the left\n      actions.append(craft.LEFT)\n  elif direction_to_workshop[1] > 0:  # Workshop is below\n      actions.append(craft.DOWN)\n  else:  # Workshop is above\n      actions.append(craft.UP)\n\n  actions.append(craft.USE)\n\n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T12:58:51.452014", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the goal is known in the cookbook\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Goal {item} unknown in the recipe book.\")\n\n  # Get the primitives needed for crafting the item\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  \n  actions = []\n  \n  # Check if we have all the primitives required to craft the item\n  for primitive, count in required_primitives.items():\n    if env._current_state.inventory[primitive] < count:\n      return []  # We don't have enough primitives, so we can't craft\n\n  # Find the workshop where the item should be crafted\n  workshop = None\n  for recipe in env.world.cookbook.recipes.values():\n    if \"_at\" in recipe and recipe[\"_key\"] == item_index:\n      workshop = recipe[\"_at\"]\n      break\n  \n  if not workshop:\n    raise ValueError(f\"No workshop found for crafting {item}.\")\n\n  # Get the index of the workshop\n  workshop_index = env.world.cookbook.index[workshop]\n  \n  # Navigate to the workshop (This is a simplified version and assumes we can find the workshop)\n  actions.extend(navigate_to_workshop(env, workshop_index))\n  \n  # Use the USE action at the workshop\n  actions.append(4)  # Assuming 4 corresponds to the USE action\n  \n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-11T12:58:52.411897", "function_name": "craft", "function_body": "  # Get index for the desired item\n  item_idx = env.world.cookbook.index[item]\n\n  if not env._current_state.inventory[item_idx] > 0:\n    required_primitives = env.world.cookbook.primitives_for(item_idx)\n  \n    actions = []\n    collected = False\n\n    for primitive, count in required_primitives.items():\n      # Collect the primitives needed\n      while env._current_state.inventory[primitive] < count and not collected:\n        action_list = collect(env, env.world.cookbook.index.get(primitive))\n        if action_list:\n          actions.extend(action_list)\n        else:\n          return []  # Return empty list if we can't find required primitive\n\n    # If all primitives are collected\n    if all(env._current_state.inventory[primitive] >= count for primitive, count in required_primitives.items()):\n      collected = True\n    \n    if collected:\n      workshop_index = env.world.cookbook.recipes[item_idx][\"_key\"]\n      \n      # Navigate to the workshop and perform USE action\n      move_actions = move_to_workshop(env, workshop_index)\n      actions.extend(move_actions)\n      actions.append(craft.USE)  # Perform USE action at the workshop\n      \n    return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-11T13:01:08.899054", "function_name": "craft", "function_body": "  i_goal = env.world.cookbook.index[item]\n  \n  # Get the primitives required to craft this item\n  prim_reqs = env.world.cookbook.primitives_for(i_goal)\n  \n  actions_list = []\n\n  # Check if we have all the required primitives in our inventory\n  for i_prim, count in prim_reqs.items():\n      if env._current_state.inventory[i_prim] < count:\n          return []  # If any primitive is missing, return an empty action list\n  \n  # Find which workshop to use for crafting\n  workshop_index = None\n  workshop_name = \"_key\"\n  \n  # Iterate over the recipes and find the workshop\n  for output_index, recipe in env.world.cookbook.recipes.items():\n      if i_goal == output_index:\n          workshop_name = recipe[\"_at\"]\n          break\n  \n  # Get the index of the workshop from the environment's indices\n  try:\n      workshop_index = getattr(env.world, f\"{workshop_name}_index\")\n  except AttributeError:\n      return []  # If the workshop is not found, return an empty action list\n\n  # Now that we have all the requirements and know where to craft, let's move to the workshop\n  workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n  if workshop_pos_list.size == 0:\n      return []  # If no workshops are found, return an empty action list\n\n  # Choose the closest workshop (or any available)\n  agent_pos = np.array(env._current_state.pos)\n  distances = np.linalg.norm(agent_pos - workshop_pos_list, axis=1)\n  closest_workshop_pos = tuple(workshop_pos_list[np.argmin(distances)])\n\n  # Calculate path to the closest workshop\n  def bfs(start, goal):\n      queue = collections.deque([start])\n      visited = set()\n      came_from = {}\n      \n      while queue:\n          current = queue.popleft()\n          \n          if np.array_equal(current, goal):\n              break\n          \n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              \n              if 0 <= neighbor[0] < env._current_state.grid.shape[0] and\\\n                 0 <= neighbor[1] < env._current_state.grid.shape[1] and\\\n                 not env._current_state.grid[neighbor[0], neighbor[1]].any() and\\\n                 neighbor not in visited:\n                  queue.append(neighbor)\n                  visited.add(neighbor)\n                  came_from[neighbor] = current\n      \n      # Reconstruct path\n      path = []\n      while np.array_equal(current, goal):\n          path.append(current)\n          current = came_from[current]\n      \n      return path[::-1]\n\n  path = bfs(agent_pos, closest_workshop_pos)\n\n  if not path:\n      return []  # If no path is found, return an empty action list\n\n  for next_pos in path[1:]:  # Skip the starting position\n      delta_x = next_pos[0] - agent_pos[0]\n      delta_y = next_pos[1] - agent_pos[1]\n      \n      action_mapping = {\n          (1, 0): craft.N_DOWN,\n          (-1, 0): craft.N_UP,\n          (0, 1): craft.N_RIGHT,\n          (0, -1): craft.N_LEFT\n      }\n\n      action = action_mapping.get((np.sign(delta_x), np.sign(delta_y)))\n      \n      if action:\n          actions_list.append(action)\n      \n      # Simulate the step to update the agent's position\n      env.step(action)\n      agent_pos = next_pos\n\n  # Once we reach the workshop, use it to craft the item\n  actions_list.append(craft.N_USE)\n\n  return actions_list", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T13:01:09.958991", "function_name": "craft", "function_body": "  i_goal = env.world.cookbook.index[item]\n  \n  # Get the primitives required to craft this item\n  prim_reqs = env.world.cookbook.primitives_for(i_goal)\n  \n  actions_list = []\n\n  # Check if we have all the required primitives in our inventory\n  for i_prim, count in prim_reqs.items():\n      if env._current_state.inventory[i_prim] < count:\n          return []  # If any primitive is missing, return an empty action list\n  \n  # Find which workshop to use for crafting\n  workshop_index = None\n  workshop_name = \"_key\"\n  \n  for output_index, recipe in env.world.cookbook.recipes.items():\n      if i_goal == output_index:\n          workshop_name = recipe[\"_at\"]\n          break\n\n  try:\n      workshop_index = getattr(env.world, f\"{workshop_name}_index\")\n  except AttributeError:\n      return []  # If the workshop is not found, return an empty action list\n\n  # Now that we have all the requirements and know where to craft, let's move to the workshop\n  workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n  if workshop_pos_list.size == 0:\n      return []  # If no workshops are found, return an empty action list\n\n  # Choose the closest workshop (or any available)\n  agent_pos = np.array(env._current_state.pos)\n  distances = np.linalg.norm(agent_pos - workshop_pos_list, axis=1)\n  closest_workshop_pos = tuple(workshop_pos_list[np.argmin(distances)])\n\n  # Calculate the direction towards the workshop\n  delta_x = closest_workshop_pos[0] - agent_pos[0]\n  delta_y = closest_workshop_pos[1] - agent_pos[1]\n\n  # Define action mappings\n  action_mapping = {\n      (1, 0): craft.N_DOWN,\n      (-1, 0): craft.N_UP,\n      (0, 1): craft.N_RIGHT,\n      (0, -1): craft.N_LEFT\n  }\n\n  # Move to the position next to the workshop\n  while not (delta_x == 0 and delta_y == 0):\n      move_x = np.sign(delta_x) if abs(delta_x) > abs(delta_y) else 0\n      move_y = np.sign(delta_y) if abs(delta_y) >= abs(delta_x) else 0\n      \n      action = action_mapping[(move_x, move_y)]\n      \n      actions_list.append(action)\n\n      # Simulate the step to update the agent's position (This is a placeholder for actual environment stepping)\n      env.step(action)\n      delta_x -= move_x\n      delta_y -= move_y\n\n  # Once we reach the workshop, use it to craft the item\n  actions_list.append(craft.N_USE)\n\n  return actions_list", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T13:02:36.158761", "function_name": "craft", "function_body": "  # Get the cookbook and index\n  cookbook = env.world.cookbook\n  index = cookbook.index\n\n  # Get the goal index for the desired item\n  goal_index = index[item]\n\n  # Check if the goal item has a recipe\n  if goal_index not in cookbook.recipes:\n    print(f\"No recipe found for {item}.\")\n    return []\n\n  # Function to find path to nearest cell containing required kind\n  def find_path_to_kind(kind):\n      # Perform BFS to find shortest path to kind\n      queue = collections.deque([(env._current_state.pos, [])])\n      visited = set([env._current_state.pos])\n\n      while queue:\n          pos, path = queue.popleft()\n          x, y = pos\n\n          # Check adjacent cells (up, down, left, right)\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < env.world.scenario.init_grid.shape[0] and 0 <= ny < env.world.scenario.init_grid.shape[1]:\n                  new_pos = (nx, ny)\n                  if index.get(env._current_state.grid[nx, ny].argmax()) == kind:\n                      return path + [craft.N_ACTIONS + [\"UP\", \"DOWN\", \"LEFT\", \"RIGHT\"].index([\"UP\" if dy < 0 else \"DOWN\" if dy > 0 else \"LEFT\" if dx < 0 else \"RIGHT\"][0])]\n                  if new_pos not in visited and env._current_state.grid[nx, ny].sum() == 0:\n                      visited.add(new_pos)\n                      queue.append((new_pos, path + [craft.N_ACTIONS + [\"UP\", \"DOWN\", \"LEFT\", \"RIGHT\"].index([\"UP\" if dy < 0 else \"DOWN\" if dy > 0 else \"LEFT\" if dx < 0 else \"RIGHT\"][0])]))\n      return []\n\n  # Function to check if we have all primitives required\n  def has_all_primitives(primitives):\n      for primitive, count in primitives.items():\n          if env._current_state.inventory[primitive] < count:\n              return False\n      return True\n\n  # Get the list of prerequisites and their counts\n  primitives = cookbook.primitives_for(goal_index)\n\n  # Check if we have all required primitives\n  if not has_all_primitives(primitives):\n      print(f\"Missing primitives to craft {item}.\")\n      return []\n\n  # Determine which workshop is needed based on the recipe\n  workshop_kind = cookbook.recipes[goal_index][\"_key\"]\n\n  # Find path to the nearest workshop of the required type\n  path_to_workshop = find_path_to_kind(workshop_kind)\n\n  # Add USE action to craft item at workshop\n  path_to_workshop.append(craft.USE)\n\n  return path_to_workshop", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-11T13:02:37.167356", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  index = cookbook.index\n\n  # Convert the item name to its corresponding index\n  item_index = index[item]\n\n  # If the item is a primitive, return an empty action list as primitives cannot be crafted.\n  if item_index in cookbook.primitives:\n      return []\n\n  # Get the recipe for the item.\n  recipe = cookbook.recipes.get(item_index)\n  actions = []\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  # Check and collect all required items/primitives to craft the specified item\n  for ingredient, count in recipe.items():\n      if ingredient == \"_key\":\n          continue  # Skip the \"_key\" entry which specifies the workshop\n\n      ingredient_index = index[ingredient]\n      \n      while env._current_state.inventory[ingredient_index] < count:\n          actions.extend(collect(env, ingredient))\n\n  # Move to the correct workshop\n  workshop_index = recipe[\"_key\"]\n  workshop_name = cookbook.index.get(workshop_index)\n  \n  actions.extend(move_to_workshop(env, workshop_name))\n  actions.append(craft.USE)  # Use action to craft the item at the workshop\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-11T13:04:30.054482", "function_name": "craft", "function_body": "  goal_index = env.world.cookbook.index[item]\n\n  # Check if we have all required primitives in our inventory\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  current_inventory = collections.Counter(env._current_state.inventory)\n\n  for primitive, count in required_primitives.items():\n    if current_inventory[primitive] < count:\n      return []  # Missing required primitives\n\n  # Determine the workshop where crafting should occur\n  recipe_details = env.world.cookbook.recipes[goal_index]\n  workshop_name = recipe_details[\"_key\"]\n\n  # Get the index of the workshop from the world's cookbook\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the closest workshop in the grid\n  positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(positions) == 0:\n    return []  # No available workshops\n\n  closest_workshop_pos = min(\n      positions, key=lambda x: abs(x[0] - env._current_state.pos[0]) + abs(x[1] - env._current_state.pos[1]))\n\n  # Navigate to the closest workshop\n  current_pos = np.array(env._current_state.pos)\n  target_pos = np.array(closest_workshop_pos)\n\n  actions = []\n\n  while not np.array_equal(current_pos, target_pos):\n    delta = target_pos - current_pos\n\n    # Calculate direction based on the largest absolute difference\n    if abs(delta[0]) > abs(delta[1]):\n      if delta[0] > 0:\n        actions.append(craft.RIGHT)  # Move right\n      else:\n        actions.append(craft.LEFT)   # Move left\n    else:\n      if delta[1] > 0:\n        actions.append(craft.DOWN)   # Move down\n      else:\n        actions.append(craft.UP)     # Move up\n\n    current_pos = np.array(env._current_state.pos)\n\n  # Orient the agent to face the workshop and use it\n  # Check if the agent is already facing the workshop before using it\n  delta = target_pos - current_pos\n  direction_to_workshop = None\n  if abs(delta[0]) > abs(delta[1]):\n    if delta[0] > 0:\n      direction_to_workshop = craft.RIGHT  # Move right\n    else:\n      direction_to_workshop = craft.LEFT   # Move left\n  else:\n    if delta[1] > 0:\n      direction_to_workshop = craft.DOWN   # Move down\n    else:\n      direction_to_workshop = craft.UP     # Move up\n\n  current_direction = env._current_state.dir\n  directions = [craft.RIGHT, craft.LEFT, craft.DOWN, craft.UP]\n  index_current_direction = directions.index(current_direction)\n  index_target_direction = directions.index(direction_to_workshop)\n\n  if index_current_direction != index_target_direction:\n    actions.append(directions[index_target_direction])\n\n  actions.append(craft.USE)\n\n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T13:04:31.137869", "function_name": "craft", "function_body": "  goal_index = env.world.cookbook.index[item]\n\n  # Check if we have all required primitives in our inventory\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  current_inventory = collections.Counter(env._current_state.inventory)\n\n  for primitive, count in required_primitives.items():\n    if current_inventory[primitive] < count:\n      return []  # Missing required primitives\n\n  # Determine the workshop where crafting should occur\n  recipe_details = env.world.cookbook.recipes[goal_index]\n  workshop_name = recipe_details[\"_key\"]\n\n  # Get the index of the workshop from the world's cookbook\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the closest workshop in the grid\n  positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(positions) == 0:\n    return []  # No available workshops\n\n  closest_workshop_pos = min(\n      positions, key=lambda x: abs(x[0] - env._current_state.pos[0]) + abs(x[1] - env._current_state.pos[1]))\n\n  # Navigate to the closest workshop\n  current_pos = np.array(env._current_state.pos)\n  target_pos = np.array(closest_workshop_pos)\n\n  actions = []\n\n  while not np.array_equal(current_pos, target_pos):\n    delta = target_pos - current_pos\n\n    # Calculate direction based on the largest absolute difference\n    if abs(delta[0]) > abs(delta[1]):\n      if delta[0] > 0:\n        actions.append(craft.RIGHT)  # Move right\n      else:\n        actions.append(craft.LEFT)   # Move left\n    else:\n      if delta[1] > 0:\n        actions.append(craft.DOWN)   # Move down\n      else:\n        actions.append(craft.UP)     # Move up\n\n    current_pos = np.array(env._current_state.pos)\n\n  # Ensure the agent is facing the correct direction to use the workshop\n  face_direction_action = calculate_face_direction(current_pos, target_pos)\n  if face_direction_action:\n    actions.append(face_direction_action)\n\n  # Orient the agent to face the workshop and use it\n  if env._current_state.grid[target_pos[0], target_pos[1], workshop_index] == 1:\n    actions.append(craft.USE)\n\n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T13:08:00.478444", "function_name": "craft", "function_body": "  def get_direction(current_pos, target_pos):\n    x_diff = target_pos[0] - current_pos[0]\n    y_diff = target_pos[1] - current_pos[1]\n\n    if x_diff > 0:\n      return 3  # RIGHT\n    elif x_diff < 0:\n      return 2  # LEFT\n    elif y_diff > 0:\n      return 1  # UP\n    else:\n      return 0  # DOWN\n\n  def find_path(start, target):\n    actions = []\n\n    start_x, start_y = divmod(start, env._current_state.grid.shape[1])\n    target_x, target_y = divmod(target, env._current_state.grid.shape[1])\n\n    open_set = []\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, target)}\n\n    heapq.heappush(open_set, (f_score[start], start))\n\n    while open_set:\n      _, current = heapq.heappop(open_set)\n\n      if current == target:\n        reconstruct_path(came_from, current)\n        break\n\n      cx, cy = divmod(current, env._current_state.grid.shape[1])\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = cx + dx, cy + dy\n\n        if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n          neighbor = nx * env._current_state.grid.shape[1] + ny\n          tentative_g_score = g_score[current] + 1\n\n          if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n            came_from[neighbor] = current\n            g_score[neighbor] = tentative_g_score\n            f_score[neighbor] = tentative_g_score + heuristic(neighbor, target)\n            heapq.heappush(open_set, (f_score[neighbor], neighbor))\n\n    def reconstruct_path(came_from, current):\n      total_path = []\n      while current in came_from:\n        cx, cy = divmod(current, env._current_state.grid.shape[1])\n        px, py = divmod(came_from[current], env._current_state.grid.shape[1])\n\n        dx, dy = px - cx, py - cy\n        direction_to_face = get_direction((cx, cy), (px, py))\n        total_path.append(direction_to_face)\n        current = came_from[current]\n\n      actions.extend(reversed(total_path))\n\n    return actions\n\n  def heuristic(a, b):\n    ax, ay = divmod(a, env._current_state.grid.shape[1])\n    bx, by = divmod(b, env._current_state.grid.shape[1])\n\n    # Manhattan distance\n    return abs(ax - bx) + abs(ay - by)\n\n  actions = []\n\n  item_index = env.world.cookbook.index[item]\n  \n  if not item_index:\n    return []\n\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  current_inventory = {env.world.cookbook.index.get(i): c for i, c in enumerate(env._current_state.inventory) if c > 0}\n\n  # Check if we have all the required primitives\n  missing_primitives = []\n  for primitive_index, count in primitives_needed.items():\n    if current_inventory.get(primitive_index, 0) < count:\n      missing_primitives.append((primitive_index, count - current_inventory.get(primitive_index, 0)))\n\n  if missing_primitives:\n    # Collect the missing primitives\n    for primitive_index, needed_count in missing_primitives:\n      while needed_count > 0:\n        # Find the position of the primitive\n        primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n        \n        if not primitive_positions.any():\n          return []\n\n        # Choose the closest one\n        closest_primitive = min(primitive_positions, key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1]))\n        start_pos_flat = env._current_state.pos[0] * env._current_state.grid.shape[1] + env._current_state.pos[1]\n        target_pos_flat = closest_primitive[0] * env._current_state.grid.shape[1] + closest_primitive[1]\n\n        actions.extend(find_path(start_pos_flat, target_pos_flat))\n\n        # Ensure we are in front of the primitive\n        direction_to_face = get_direction(env._current_state.pos, closest_primitive)\n        if direction_to_face is not None:\n            actions.append(direction_to_face)\n\n        # Collect the primitive by using the USE action\n        actions.append(4)  # USE action\n\n        needed_count -= 1\n\n  # Find the workshop to craft the item\n  workshop_name = env.world.cookbook.recipes[item_index][\"_at\"]\n  workshop_indices = np.argwhere(env._current_state.grid[:, :, env.world.workshop_indices[0]] == env.world.cookbook.index[workshop_name])\n\n  if not workshop_indices.any():\n    return []\n\n  # Convert the grid coordinates to a flat list\n  start_pos_flat = env._current_state.pos[0] * env._current_state.grid.shape[1] + env._current_state.pos[1]\n  target_pos_flat = workshop_indices[0][0] * env._current_state.grid.shape[1] + workshop_indices[0][1]\n\n  actions.extend(find_path(start_pos_flat, target_pos_flat))\n\n  # Ensure we are in front of the workshop\n  target_workshop_position = (workshop_indices[0][0], workshop_indices[0][1])\n  direction_to_face = get_direction(env._current_state.pos, target_workshop_position)\n  if direction_to_face is not None:\n      actions.append(direction_to_face)\n\n  # Craft the item by using the USE action\n  actions.append(4)  # USE action\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
