   queue.append((new_x, new_y))\n            parent_map[(new_x, new_y)] = current_pos\n\n    return None  # No path found\n\n  start_pos = env._current_state.pos\n  closest_workshop_path = min([bfs(start_pos, {wp}) for wp in workshop_positions], key=lambda x: len(x) if x else float('inf'))\n\n  if not closest_workshop_path:\n    return []  # Could not find a valid path to any of the workshops\n\n  # Step 5: Generate actions to move along the planned path\n  action_map = {(-1, 0): craft.MOVE_UP, (1, 0): craft.MOVE_DOWN, (0, -1): craft.MOVE_LEFT, (0, 1): craft.MOVE_RIGHT}\n  actions_to_workshop = [action_map[(closest_workshop_path[i][0] - closest_workshop_path[i-1][0], closest_workshop_path[i][1] - closest_workshop_path[i-1][1])] for i in range(1, len(closest_workshop_path))]\n\n  # Step 6: Move to the workshop and perform the USE action\n  actions = actions_to_workshop + [craft.USE_ACTION]\n  \n  return actions", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T13:53:01.044610", "function_name": "craft", "function_body": "  # Step 1: Resolve the item index from the provided item name.\n  idx = env.world.cookbook.index[item]\n\n  # Step 2: Verify if the inventory contains all necessary primitives for crafting the specified item.\n  required_primitives = env.world.cookbook.primitives_for(idx)\n  current_inventory = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory)}\n\n  missing_items = [(primitive, count - (current_inventory[primitive] if primitive in current_inventory else 0)) \n                   for primitive, count in required_primitives.items() \n                   if primitive not in current_inventory or current_inventory[primitive] < count]\n\n  if missing_items:\n    return []  # Not enough primitives to craft the item\n\n  # Step 3: Determine the workshop that can be used to craft the item.\n  recipe = env.world.cookbook.recipes[idx]\n  workshop_name = list(recipe.keys())[-1]\n  workshop_idx = env.world.cookbook.index[workshop_name]\n\n  # Step 4: Locate all positions of the required workshop on the grid.\n  workshop_positions = []\n  for i in range(env._current_state.grid.shape[0]):\n    for j in range(env._current_state.grid.shape[1]):\n      if env._current_state.grid[i, j, workshop_idx] == 1:\n        workshop_positions.append((i, j))\n\n  # Step 5: Plan a path to the nearest workshop using BFS.\n  def bfs(start, goals):\n    queue = collections.deque([start])\n    visited = set()\n    parent_map = {}\n\n    while queue:\n      current_pos = queue.popleft()\n\n      if current_pos in goals:\n        path = []\n        while current_pos != start:\n          path.append(current_pos)\n          current_pos = parent_map[current_pos]\n        path.reverse()\n        return path\n\n      if current_pos in visited:\n        continue\n\n      visited.add(current_pos)\n\n      # Explore all four possible directions\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        new_x = current_pos[0] + dx\n        new_y = current_pos[1] + dy\n\n        if 0 <= new_x < env._current_state.grid.shape[0] and 0 <= new_y < env._current_state.grid.shape[1]:\n          # Ensure the cell is not blocked by any item\n          if not np.any(env._current_state.grid[new_x, new_y]):\n            queue.append((new_x, new_y))\n            parent_map[(new_x, new_y)] = current_pos\n\n    return None  # No path found\n\n  start_pos = env._current_state.pos\n  closest_path_to_workshop = min([bfs(start_pos, [pos]) for pos in workshop_positions], key=lambda x: len(x) if x else float('inf'))\n\n  if not closest_path_to_workshop:\n    return []  # Could not find a valid path to any workshop\n\n  # Step 6: Map the planned path into movement actions.\n  action_map = {(-1, 0): craft.MOVE_UP, (1, 0): craft.MOVE_DOWN, (0, -1): craft.MOVE_LEFT, (0, 1): craft.MOVE_RIGHT}\n  actions_to_workshop = [action_map[(closest_path_to_workshop[i][0] - closest_path_to_workshop[i-1][0], closest_path_to_workshop[i][1] - closest_path_to_workshop[i-1][1])] for i in range(1, len(closest_path_to_workshop))]\n\n  # Step 7: Check if the agent is already at a workshop.\n  current_pos = env._current_state.pos\n  if current_pos in workshop_positions:\n    actions = [craft.USE_ACTION]  # Use action to start crafting immediately\n  else:\n    actions = actions_to_workshop + [craft.USE_ACTION]  # Move to the workshop and then use\n\n  return actions", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T13:53:02.016619", "function_name": "craft", "function_body": "  idx = env.world.cookbook.index[item]\n\n  # Check if we have all the required primitives to craft this item\n  required_primitives = env.world.cookbook.primitives_for(idx)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory)}\n\n  # Calculate missing items\n  missing_items = []\n  for primitive, count in required_primitives.items():\n      if primitive not in inventory_dict or inventory_dict[primitive] < count:\n          missing_items.append((primitive, count - (inventory_dict[primitive] if primitive in inventory_dict else 0)))\n\n  if missing_items:\n      # Attempt to collect each missing item\n      actions = []\n      for primitive, required_count in missing_items:\n          # Collect the required primitives\n          while inventory_dict.get(primitive, 0) < required_count:\n              actions.extend(collect(env, primitive))\n              if not actions:  # If collect function returns an empty list (failed to find or collect)\n                  return []\n      return actions\n  \n  # Determine the workshop index\n  recipe = env.world.cookbook.recipes[idx]\n  workshop_name = list(recipe.keys())[-1]\n  workshop_idx = env.world.cookbook.index[workshop_name]\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = []\n  for i in range(env._current_state.grid.shape[0]):\n    for j in range(env._current_state.grid.shape[1]):\n      if env._current_state.grid[i, j, workshop_idx] == 1:\n        workshop_positions.append((i, j))\n\n  # Plan the path to the closest workshop position\n  def bfs(start, goals):\n    queue = collections.deque([start])\n    visited = set()\n    parent_map = {}\n\n    while queue:\n      current_pos = queue.popleft()\n\n      if current_pos in goals:\n        path = []\n        while current_pos != start:\n          path.append(current_pos)\n          current_pos = parent_map[current_pos]\n        path.reverse()\n        return path\n\n      if current_pos in visited:\n        continue\n\n      visited.add(current_pos)\n\n      # Check all four possible directions\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        new_x = current_pos[0] + dx\n        new_y = current_pos[1] + dy\n\n        if 0 <= new_x < env._current_state.grid.shape[0] and 0 <= new_y < env._current_state.grid.shape[1]:\n          # Check if the cell is empty (not blocked by any item)\n          if not np.any(env._current_state.grid[new_x, new_y]):\n            queue.append((new_x, new_y))\n            parent_map[(new_x, new_y)] = current_pos\n\n    return None  # No path found\n\n  start_pos = env._current_state.pos\n  closest_path_to_workshop = min([bfs(start_pos, [pos]) for pos in workshop_positions], key=lambda x: len(x) if x else float('inf'))\n\n  if not closest_path_to_workshop:\n    return []  # Could not find a valid path to any workshop\n\n  action_map = {(-1, 0): craft.MOVE_UP, (1, 0): craft.MOVE_DOWN, (0, -1): craft.MOVE_LEFT, (0, 1): craft.MOVE_RIGHT}\n  actions_to_workshop = [action_map[(closest_path_to_workshop[i][0] - closest_path_to_workshop[i-1][0], closest_path_to_workshop[i][1] - closest_path_to_workshop[i-1][1])] for i in range(1, len(closest_path_to_workshop))]\n\n  # Check if the agent is already at a workshop\n  if env._current_state.pos in workshop_positions:\n    actions = [craft.USE_ACTION]\n  else:\n    actions = actions_to_workshop + [craft.USE_ACTION]\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-11T13:53:59.591029", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  item_idx = env.world.cookbook.index[item]\n  \n  # Check if we have all the primitives required to craft the item\n  required_primitives = env.world.cookbook.primitives_for(item_idx)\n  \n  actions = []\n  \n  # Collect all required primitives\n  for primitive, count in required_primitives.items():\n    for _ in range(count):\n      actions.extend(collect(env, env.world.cookbook.index.get(primitive)))\n\n  # Navigate to the correct workshop and use the USE action to craft the item\n  workshop_idx = None\n  for ingredient, details in env.world.cookbook.recipes[item_idx].items():\n    if ingredient == \"_key\":\n      continue\n    if \"_at\" in details:\n      workshop_idx = env.world.cookbook.index[details[\"_at\"]]\n      break\n\n  if workshop_idx is not None:\n    # Find the position of the required workshop\n    workshop_pos = find_workshop_position(env, workshop_idx)\n    \n    if workshop_pos is not None:\n      # Navigate to the workshop\n      actions.extend(navigate_to_position(env, workshop_pos))\n      \n      # Turn to face the workshop and use the USE action\n      actions.append(use_action(env, workshop_pos))\n\n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-11T13:54:00.551048", "function_name": "craft", "function_body": "  # Get the current state\n  current_state = env._current_state\n  \n  # Convert item name to index using cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the items/primitives required for crafting\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n  inventory_dict = dict(zip(env.world.world.grabbable_indices, current_state.inventory))\n  \n  # Check if all required primitives are available in the inventory\n  can_craft = True\n  for primitive_index, count in primitives_required.items():\n    if inventory_dict.get(primitive_index, 0) < count:\n      can_craft = False\n      break\n  \n  if not can_craft:\n    return []\n\n  # Find the required workshop index from the recipe\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_name = [key for key in recipe.keys() if key.startswith('_at')][0]\n  workshop_index = getattr(env.world, workshop_name)\n\n  actions = []\n  \n  # Move to the closest workshop and face it\n  target_workshop_position = find_closest_workshop(current_state, workshop_index)\n  move_actions_to_workshop = move_to_target(current_state, target_workshop_position)\n  actions.extend(move_actions_to_workshop)\n\n  # Add USE action to craft the item at the workshop\n  actions.append(env.world.world.N_ACTIONS - 1)  # Assuming USE is the last action\n\n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-11T13:55:27.405192", "function_name": "craft", "function_body": "  def move_towards_position(agent_pos, target_pos):\n      dx, dy = target_pos[0] - agent_pos[0], target_pos[1] - agent_pos[1]\n      actions = []\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      if dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n      return actions\n\n  def find_next_to_workshop(workshop_index):\n      for x in range(env._current_state.grid.shape[0]):\n          for y in range(env._current_state.grid.shape[1]):\n              if env._current_state.grid[x, y, workshop_index] > 0:\n                  return (x, y)\n      return None\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item has a recipe\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the required primitives and their counts for crafting the item\n  recipe = env.world.cookbook.recipes[item_index]\n  required_primitives = {ingredient: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n\n  # Check if we have all the required primitives in our inventory\n  current_inventory = env._current_state.inventory\n  missing_primitives = []\n\n  for primitive, count in required_primitives.items():\n    # If the primitive is not in the inventory, add it to the list of missing primitives\n    if current_inventory[primitive] < count:\n      missing_primitives.append((primitive, count))\n\n  # If there are any missing primitives, return an empty action list\n  if missing_primitives:\n    return []\n\n  # Determine the workshop where crafting should occur\n  workshop = recipe.get(\"_at\", None)\n  if not workshop:\n    return []\n\n  workshop_index = env.world.cookbook.index[workshop]\n\n  # Find a position next to the workshop\n  workshop_pos = find_next_to_workshop(workshop_index)\n\n  # Calculate the direction to move towards the workshop\n  agent_pos = env._current_state.pos\n  actions_to_take = move_towards_position(agent_pos, workshop_pos)\n\n  # Append USE action to craft the item\n  actions_to_take.append(4)  # USE action\n\n  return actions_to_take", "island_id": 7, "scores": {"3": 2.0}}
{"timestamp": "2025-09-11T13:55:28.513093", "function_name": "craft", "function_body": "  def find_closest_workshop(workshop_index):\n    grid = env._current_state.grid\n    agent_pos = env._current_state.pos\n    closest_distance = float('inf')\n    closest_workshop_pos = None\n\n    for x in range(grid.shape[0]):\n        for y in range(grid.shape[1]):\n            if grid[x, y, workshop_index] > 0:\n                distance = abs(x - agent_pos[0]) + abs(y - agent_pos[1])\n                if distance < closest_distance:\n                    closest_distance = distance\n                    closest_workshop_pos = (x, y)\n\n    return closest_workshop_pos\n\n  def move_towards_position(agent_pos, target_pos):\n      dx, dy = target_pos[0] - agent_pos[0], target_pos[1] - agent_pos[1]\n      actions = []\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      if dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n      return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item has a recipe\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the required primitives and their counts for crafting the item\n  recipe = env.world.cookbook.recipes[item_index]\n  required_primitives = {ingredient: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n\n  # Check if we have all the required primitives in our inventory\n  current_inventory = env._current_state.inventory\n\n  missing_primitives = []\n\n  for primitive, count in required_primitives.items():\n    if current_inventory[primitive] < count:\n      missing_primitives.append((primitive, count))\n\n  # If there are any missing primitives, return an empty action list\n  if missing_primitives:\n    return []\n\n  # Determine the workshop where crafting should occur\n  workshop = recipe.get(\"_at\", None)\n  if not workshop:\n    return []\n\n  workshop_index = env.world.cookbook.index[workshop]\n\n  # Find the closest position next to the workshop\n  closest_workshop_pos = find_closest_workshop(workshop_index)\n\n  if not closest_workshop_pos:\n    return []\n\n  # Calculate the direction to move towards the closest workshop\n  agent_pos = env._current_state.pos\n  actions_to_take = move_towards_position(agent_pos, closest_workshop_pos)\n\n  # Append USE action to craft the item\n  actions_to_take.append(4)  # USE action\n\n  return actions_to_take", "island_id": 7, "scores": {"3": 2.0}}
{"timestamp": "2025-09-11T13:57:42.793185", "function_name": "craft", "function_body": "  def get_direction(current_pos, target_pos):\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    if abs(dx) > abs(dy):\n        return 3 if dx > 0 else 2\n    else:\n        return 1 if dy > 0 else 0\n\n  def navigate_to(env_state, target_pos):\n      actions = []\n      path = a_star_pathfinding(env_state.grid, env_state.pos, target_pos)\n      for next_pos in path[1:]:  # Skip the start position\n          action = get_direction(env_state.pos, next_pos)\n          actions.append(action)\n          # Update current position based on action (simple update for demonstration)\n          if action == 3:  # RIGHT\n              env_state.pos = (env_state.pos[0] + 1, env_state.pos[1])\n          elif action == 2:  # LEFT\n              env_state.pos = (env_state.pos[0] - 1, env_state.pos[1])\n          elif action == 1:  # UP\n              env_state.pos = (env_state.pos[0], env_state.pos[1] + 1)\n          else:  # DOWN\n              env_state.pos = (env_state.pos[0], env_state.pos[1] - 1)\n      return actions\n\n  def a_star_pathfinding(grid, start, goal):\n      open_set = collections.deque([start])\n      came_from = {}\n      g_score = {start: 0}\n      f_score = {start: heuristic(start, goal)}\n\n      while open_set:\n          current = min(open_set, key=lambda p: f_score[p])\n\n          if current == goal:\n              return reconstruct_path(came_from, current)\n\n          open_set.remove(current)\n          for neighbor in get_neighbors(grid, current):\n              tentative_g_score = g_score[current] + 1\n\n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                  if neighbor not in open_set:\n                      open_set.append(neighbor)\n\n      return []\n\n  def get_neighbors(grid, pos):\n      x, y = pos\n      neighbors = []\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n              neighbors.append((nx, ny))\n      return neighbors\n\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  actions = []\n  \n  # Get the index of the goal item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  # If not all primitives are available return empty action list\n  if not has_all_primitives(required_primitives, inventory_dict):\n    return []\n  \n  # Find the workshop where we can craft this item\n  workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n      if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n          workshop_index = recipe.get(\"_at\")\n          break\n  \n  if workshop_index is None:\n    return []\n\n  # Find the position of the nearest workshop in the grid\n  target_workshop_pos = find_closest_workshop(workshop_index, env._current_state.grid, env._current_state.pos)\n  if target_workshop_pos is None:\n    return []\n  \n  # Navigate to the selected workshop\n  actions.extend(navigate_to(env._current_state.copy(), target_workshop_pos))\n  \n  # Use the USE action to craft the item at the workshop\n  actions.append(4)  # Assuming 4 is the index for the USE action\n  \n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-11T13:57:43.882207", "function_name": "craft", "function_body": "  def has_all_primitives(required_primitives, inventory_dict):\n    return all(primitive in inventory_dict and inventory_dict[primitive] >= required_primitives[primitive] for primitive in required_primitives)\n\n  def find_closest_workshop(workshop_index, grid, current_pos):\n    workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n    if len(workshop_positions) == 0:\n      return None\n    distances = [np.linalg.norm(np.array(pos) - np.array(current_pos)) for pos in workshop_positions]\n    closest_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n    return closest_workshop_pos\n\n  def navigate_to(env_state, target_pos):\n    actions = []\n    current_pos = env_state.pos\n    path = a_star_pathfinding(env_state.grid, current_pos, target_pos)\n    \n    # Follow the path to reach the target position\n    for next_pos in path:\n        next_step_action = get_next_step(current_pos, next_pos)\n        actions.append(next_step_action)\n        current_pos = tuple((current_pos[0] + (next_step_action == 3) - (next_step_action == 2),\n                             current_pos[1] + (next_step_action == 1) - (next_step_action == 0)))\n    return actions\n\n  def a_star_pathfinding(grid, start, goal):\n      open_set = collections.deque([start])\n      came_from = {}\n      g_score = {start: 0}\n      f_score = {start: heuristic(start, goal)}\n\n      while open_set:\n          current = min(open_set, key=lambda p: f_score[p])\n\n          if current == goal:\n              return reconstruct_path(came_from, current)\n\n          open_set.remove(current)\n          for neighbor in get_neighbors(grid, current):\n              tentative_g_score = g_score[current] + 1\n\n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                  if neighbor not in open_set:\n                      open_set.append(neighbor)\n\n      return []\n\n  def get_neighbors(grid, pos):\n      x, y = pos\n      neighbors = []\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n              neighbors.append((nx, ny))\n      return neighbors\n\n  def heuristic(a, b):\n      return np.linalg.norm(np.array(a) - np.array(b))\n\n  def get_next_step(current_pos, next_pos):\n    dx = next_pos[0] - current_pos[0]\n    dy = next_pos[1] - current_pos[1]\n\n    if dx > 0:\n        return 3  # RIGHT\n    elif dx < 0:\n        return 2  # LEFT\n    elif dy > 0:\n        return 1  # UP\n    else:\n        return 0  # DOWN\n\n  def reconstruct_path(came_from, current):\n      total_path = [current]\n      while current in came_from:\n          current = came_from[current]\n          total_path.append(current)\n      return list(reversed(total_path))\n\n  actions = []\n  \n  # Get the index of the goal item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  # If not all primitives are available return empty action list\n  if not has_all_primitives(required_primitives, inventory_dict):\n    return []\n  \n  # Find the workshop where we can craft this item\n  workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n      if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n          workshop_index = recipe.get(\"_at\")\n          break\n  \n  if workshop_index is None:\n    return []\n\n  # Find the position of the nearest workshop in the grid\n  target_workshop_pos = find_closest_workshop(workshop_index, env._current_state.grid, env._current_state.pos)\n  if target_workshop_pos is None:\n    return []\n  \n  # Navigate to the selected workshop\n  actions.extend(navigate_to(env._current_state, target_workshop_pos))\n  \n  # Turn towards the workshop if not already facing it\n  current_direction = env._current_state.dir\n  direction_to_workshop = get_next_step(env._current_state.pos, target_workshop_pos)\n  if current_direction != direction_to_workshop:\n    actions.append(direction_to_workshop)\n\n  # Use the USE action to craft the item at the workshop\n  actions.append(4)  # Assuming 4 is the index for the USE action\n  \n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T13:59:23.568543", "function_name": "craft", "function_body": "  idx = env.world.cookbook.index[item]\n\n  # Step 1: Check if we have all the required primitives to craft this item\n  required_primitives = env.world.cookbook.primitives_for(idx)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory)}\n\n  if any(primitive not in inventory_dict or inventory_dict[primitive] < count for primitive, count in required_primitives.items()):\n    return []\n\n  # Step 2: Determine the workshop index\n  recipe = env.world.cookbook.recipes[idx]\n  workshop_name = list(recipe.keys())[-1]\n  workshop_idx = env.world.cookbook.index[workshop_name]\n\n  # Step 3: Find all positions of the required workshops in the grid\n  workshop_positions = []\n  for i in range(env._current_state.grid.shape[0]):\n    for j in range(env._current_state.grid.shape[1]):\n      if env._current_state.grid[i, j, workshop_idx] == 1:\n        workshop_positions.append((i, j))\n\n  # Step 4: Plan the path to the closest workshop\n  def bfs(start, goals):\n    queue = collections.deque([start])\n    visited = set()\n    parent_map = {}\n\n    while queue:\n      current_pos = queue.popleft()\n\n      if current_pos in goals:\n        path = []\n        while current_pos != start:\n          path.append(current_pos)\n          current_pos = parent_map[current_pos]\n        path.reverse()\n        return path\n\n      if current_pos in visited:\n        continue\n\n      visited.add(current_pos)\n\n      # Check all four possible directions\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        new_x = current_pos[0] + dx\n        new_y = current_pos[1] + dy\n\n        if 0 <= new_x < env._current_state.grid.shape[0] and 0 <= new_y < env._current_state.grid.shape[1]:\n          # Check if the cell is empty (not blocked by any item)\n          if not np.any(env._current_state.grid[new_x, new_y]):\n            queue.append((new_x, new_y))\n            parent_map[(new_x, new_y)] = current_pos\n\n    return None  # No path found\n\n  start_pos = env._current_state.pos\n  closest_workshop_path = min([bfs(start_pos, [goal]) for goal in workshop_positions], key=len, default=None)\n\n  if not closest_workshop_path:\n    return []  # Could not find a valid path to any workshop\n\n  action_map = {(-1, 0): craft.MOVE_UP, (1, 0): craft.MOVE_DOWN, (0, -1): craft.MOVE_LEFT, (0, 1): craft.MOVE_RIGHT}\n  actions_to_workshop = [action_map[(closest_workshop_path[i][0] - closest_workshop_path[i-1][0], closest_workshop_path[i][1] - closest_workshop_path[i-1][1])] for i in range(1, len(closest_workshop_path))]\n\n  # Step 5: Move to the workshop and perform the USE action\n  actions = actions_to_workshop + [craft.USE_ACTION]\n  \n  return actions", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T13:59:24.535287", "function_name": "craft", "function_body": "  def get_required_primitives(item_idx):\n    required_primitives = env.world.cookbook.primitives_for(item_idx)\n    inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory)}\n    return [primitive for primitive, count in required_primitives.items() if inventory_dict.get(primitive, 0) < count]\n\n  idx = env.world.cookbook.index[item]\n  missing_primitives = get_required_primitives(idx)\n\n  # If we have all the primitives, proceed to craft\n  if not missing_primitives:\n    workshop_name = list(env.world.cookbook.recipes[idx].keys())[-1]\n    workshop_idx = env.world.cookbook.index[workshop_name]\n    workshop_positions = [(i, j) for i in range(env._current_state.grid.shape[0]) \n                            for j in range(env._current_state.grid.shape[1]) \n                            if env._current_state.grid[i, j, workshop_idx] == 1]\n\n    # Find the closest workshop\n    def bfs(start, goals):\n      queue = collections.deque([start])\n      visited = set()\n      parent_map = {}\n\n      while queue:\n        current_pos = queue.popleft()\n\n        if current_pos in goals:\n          path = []\n          while current_pos != start:\n            path.append(current_pos)\n            current_pos = parent_map[current_pos]\n          path.reverse()\n          return path\n\n        if current_pos in visited:\n          continue\n        visited.add(current_pos)\n\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          new_x = current_pos[0] + dx\n          new_y = current_pos[1] + dy\n\n          if 0 <= new_x < env._current_state.grid.shape[0] and 0 <= new_y < env._current_state.grid.shape[1]:\n            if not np.any(env._current_state.grid[new_x, new_y]):\n              queue.append((new_x, new_y))\n              parent_map[(new_x, new_y)] = current_pos\n\n      return None\n\n    start_pos = env._current_state.pos\n    closest_workshop_path = min([bfs(start_pos, [goal]) for goal in workshop_positions], key=len)\n\n    if not closest_workshop_path:\n      return []\n\n    action_map = {(-1, 0): craft.MOVE_UP, (1, 0): craft.MOVE_DOWN, (0, -1): craft.MOVE_LEFT, (0, 1): craft.MOVE_RIGHT}\n    actions_to_workshop = [action_map[(closest_workshop_path[i][0] - closest_workshop_path[i-1][0], \n                                        closest_workshop_path[i][1] - closest_workshop_path[i-1][1])] for i in range(1, len(closest_workshop_path))]\n\n    actions = actions_to_workshop + [craft.USE_ACTION]\n    return actions\n\n  # If we are missing primitives, collect them first\n  actions = []\n  for primitive in missing_primitives:\n    actions.extend(collect(env, primitive))\n  \n  # Now craft the item after collecting all required primitives\n  actions.extend(craft_v2(env, item))  # Recursive call to craft the item\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-11T14:01:33.635680", "function_name": "craft", "function_body": "  def find_closest_workshop(workshop_index):\n    grid = env._current_state.grid\n    agent_pos = env._current_state.pos\n    closest_distance = float('inf')\n    closest_workshop_pos = None\n\n    for x in range(grid.shape[0]):\n        for y in range(grid.shape[1]):\n            if grid[x, y, workshop_index] > 0:\n                distance = abs(x - agent_pos[0]) + abs(y - agent_pos[1])\n                if distance < closest_distance:\n                    closest_distance = distance\n                    closest_workshop_pos = (x, y)\n\n    return closest_workshop_pos\n\n  def move_towards_position(agent_pos, target_pos):\n      dx, dy = target_pos[0] - agent_pos[0], target_pos[1] - agent_pos[1]\n      actions = []\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      if dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n      return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item has a recipe\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the required primitives and their counts for crafting the item\n  recipe = env.world.cookbook.recipes[item_index]\n  required_primitives = {ingredient: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n\n  # Check if we have all the required primitives in our inventory\n  current_inventory = env._current_state.inventory\n\n  missing_primitives = []\n\n  for primitive, count in required_primitives.items():\n    if current_inventory[primitive] < count:\n      missing_primitives.append((primitive, count))\n\n  # If there are any missing primitives, return an empty action list\n  if missing_primitives:\n    return []\n\n  # Determine the workshop where crafting should occur\n  workshop = recipe.get(\"_at\", None)\n  if not workshop:\n    return []\n\n  workshop_index = env.world.cookbook.index[workshop]\n\n  # Find the closest position next to the workshop\n  closest_workshop_pos = find_closest_workshop(workshop_index)\n\n  if not closest_workshop_pos:\n    return []\n\n  # Calculate the direction to move towards the closest workshop\n  agent_pos = env._current_state.pos\n  actions_to_take = move_towards_position(agent_pos, closest_workshop_pos)\n\n  # Ensure the agent is next to the workshop before using it\n  final_action = None\n\n  if agent_pos[0] == closest_workshop_pos[0]:\n    if agent_pos[1] < closest_workshop_pos[1]:\n      actions_to_take.append(1)  # UP\n      final_action = 4  # USE action\n    elif agent_pos[1] > closest_workshop_pos[1]:\n      actions_to_take.append(0)  # DOWN\n      final_action = 4  # USE action\n\n  if agent_pos[1] == closest_workshop_pos[1]:\n    if agent_pos[0] < closest_workshop_pos[0]:\n      actions_to_take.append(3)  # RIGHT\n      final_action = 4  # USE action\n    elif agent_pos[0] > closest_workshop_pos[0]:\n      actions_to_take.append(2)  # LEFT\n      final_action = 4  # USE action\n\n  if final_action is not None:\n      actions_to_take.append(final_action)\n\n  return actions_to_take", "island_id": 7, "scores": {"3": 1.0}}
