   total_path.append(direction_to_face)\n        current = came_from[current]\n\n      actions.extend(reversed(total_path))\n\n    return actions\n\n  def heuristic(a, b):\n    ax, ay = divmod(a, env._current_state.grid.shape[1])\n    bx, by = divmod(b, env._current_state.grid.shape[1])\n\n    # Manhattan distance\n    return abs(ax - bx) + abs(ay - by)\n\n  actions = []\n\n  item_index = env.world.cookbook.index[item]\n  \n  if not item_index:\n    return []\n\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  current_inventory = {env.world.cookbook.index.get(i): c for i, c in enumerate(env._current_state.inventory) if c > 0}\n\n  # Check if we have all the required primitives\n  for primitive_index, count in primitives_needed.items():\n    if current_inventory.get(primitive_index, 0) < count:\n      return []\n\n  # Find the workshop to craft the item\n  workshop_name = env.world.cookbook.recipes[item_index][\"_at\"]\n  workshop_indices = np.argwhere(env._current_state.grid[:, :, env.world.workshop_indices[0]] == env.world.cookbook.index[workshop_name])\n\n  if not workshop_indices.any():\n    return []\n\n  # Convert the grid coordinates to a flat list\n  flat_grid = env._current_state.grid.reshape(-1, env.world.n_kinds)\n\n  start_pos_flat = env._current_state.pos[0] * env._current_state.grid.shape[1] + env._current_state.pos[1]\n  target_pos_flat = workshop_indices[0][0] * env._current_state.grid.shape[1] + workshop_indices[0][1]\n\n  actions.extend(find_path(start_pos_flat, target_pos_flat))\n\n  # Ensure we are in front of the workshop\n  target_workshop_position = (workshop_indices[0][0], workshop_indices[0][1])\n  direction_to_face = get_direction(env._current_state.pos, target_workshop_position)\n  if direction_to_face is not None:\n      actions.append(direction_to_face)\n\n  # Craft the item by using the USE action\n  actions.append(4)  # USE action\n\n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T13:08:50.640620", "function_name": "craft", "function_body": "  # Convert item name to index using the cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Retrieve the recipe for the item\n  if item_index not in env.world.cookbook.recipes:\n    print(f\"No recipe found for {item}\")\n    return []\n  \n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Collect all primitives required by the recipe, but only if they are not already in inventory\n  actions = []\n  for ingredient, count in recipe.items():\n    if ingredient != \"_at\":\n      ingredient_index = env.world.cookbook.index[ingredient]\n      \n      # Check if we have enough of this primitive in our inventory\n      if env._current_state.inventory[ingredient_index] < count:\n        # Collect the primitive\n        collect_actions = collect(env, ingredient)\n        actions.extend(collect_actions)\n\n  # Find the workshop where the item can be crafted\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Move to the workshop and use it to craft the item\n  move_to_workshop_actions = move(env, workshop_index)\n  actions.extend(move_to_workshop_actions)\n\n  # Craft the item by using the workshop\n  actions.append(env.world.n_actions - 1)  # Assuming USE action is the last one\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-11T13:08:51.677539", "function_name": "craft", "function_body": "  actions = []\n  \n  # Convert item name to index\n  item_idx = env.world.cookbook.index[item]\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_idx, {})\n\n  if not recipe:\n    return []\n\n  # Check if we already have the item in our inventory\n  if env._current_state.inventory[item_idx] > 0:\n    return []\n\n  # Collect all required primitives and intermediate items\n  for ingredient, count in recipe.items():\n    if ingredient == \"_at\":\n      continue\n\n    needed = count - env._current_state.inventory[ingredient]\n    if needed > 0:\n      actions.extend(collect(env, env.world.cookbook.index.get(ingredient)))\n\n  # Determine the workshop to use\n  workshop_name = recipe[\"_at\"]\n  workshop_idx = env.world.cookbook.index[workshop_name]\n\n  # Find the nearest workshop of the required type\n  workshop_pos = find_nearest_workshop(env._current_state, workshop_idx)\n  \n  if not workshop_pos:\n    return []\n\n  # Move to the workshop\n  actions.extend(move_to_position(env._current_state, workshop_pos))\n  \n  # Turn to face the workshop\n  actions.append(turn_to_face_workshop(env._current_state, workshop_pos))\n\n  # Use the workshop to craft the item\n  actions.append(craft.ACTION_USE)\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-11T13:10:08.822300", "function_name": "craft", "function_body": "  actions = []\n\n  # Convert item name to index using the cookbook\n  item_index = env.world.cookbook.index[item]\n\n  # Get recipe for the desired item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n\n  if \"_at\" in recipe:\n    workshop_name = recipe[\"_at\"]\n  else:\n    return []\n\n  # Check if we have all the required items/primitives in our inventory\n  primitives_needed = {}\n  for ingredient, count in recipe.items():\n      if ingredient != \"_at\":\n          ingredient_index = env.world.cookbook.index[ingredient]\n          primitives_needed[ingredient_index] = count\n\n  # Verify if the agent has enough primitives to craft the item\n  missing_primitives = []\n  for primitive_index, count in primitives_needed.items():\n      if env._current_state.inventory[primitive_index] < count:\n          missing_primitives.append(env.world.cookbook.index.get(primitive_index))\n\n  if missing_primitives:\n      return []\n\n  # Find the workshop index based on its name\n  workshop_indices = {env.world.cookbook.index[name]: i for i, name in enumerate(env.world.workshop_indices)}\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  if workshop_index not in workshop_indices:\n      return []\n\n  # Get the position of the workshop\n  workshop_pos = None\n  grid = env._current_state.grid\n  for y in range(grid.shape[0]):\n      for x in range(grid.shape[1]):\n          if grid[y, x, workshop_index] == 1:\n              workshop_pos = (x, y)\n              break\n\n  if not workshop_pos:\n      return []\n\n  # Move the agent to the workshop position\n  current_pos = env._current_state.pos\n  actions.extend(move_to(env, current_pos, workshop_pos))\n\n  # Rotate the agent to face the workshop\n  direction_to_workshop = calculate_direction(current_pos, workshop_pos)\n  if direction_to_workshop is not None:\n      actions.append(direction_to_workshop)\n\n  # Use the USE action to craft the item at the workshop\n  actions.append(craft.USE)\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-11T13:10:09.885171", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item has a recipe\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the required primitives and their counts for crafting the item\n  recipe = env.world.cookbook.recipes[item_index]\n  required_primitives = {ingredient: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n\n  # Check if we have all the required primitives in our inventory\n  current_inventory = env._current_state.inventory\n  missing_primitives = []\n  actions_to_take = []\n\n  for primitive, count in required_primitives.items():\n    # If the primitive is not in the inventory, add it to the list of missing primitives\n    if current_inventory[primitive] < count:\n      missing_primitives.append((primitive, count))\n\n  # If there are any missing primitives, return an empty action list\n  if missing_primitives:\n    return []\n\n  # Determine the workshop where crafting should occur\n  workshop = recipe.get(\"_at\", None)\n  if not workshop:\n    return []\n\n  workshop_index = env.world.cookbook.index[workshop]\n\n  # Find a position next to the workshop\n  for x in range(env._current_state.grid.shape[0]):\n      for y in range(env._current_state.grid.shape[1]):\n          if env._current_state.grid[x, y, workshop_index] > 0:\n              workshop_pos = (x, y)\n              break\n\n  # Calculate the direction to move towards the workshop\n  agent_pos = env._current_state.pos\n  dx, dy = workshop_pos[0] - agent_pos[0], workshop_pos[1] - agent_pos[1]\n  if abs(dx) > abs(dy):\n      dir_action = 2 if dx < 0 else 3  # LEFT or RIGHT\n  else:\n      dir_action = 0 if dy < 0 else 1  # DOWN or UP\n\n  # Add the move action to the list of actions to take\n  actions_to_take.append(dir_action)  # Assuming direction is already set correctly\n\n  # Append USE action to craft the item\n  actions_to_take.append(4)  # USE action\n\n  return actions_to_take", "island_id": 7, "scores": {"3": 1.0}}
{"timestamp": "2025-09-11T13:11:38.841715", "function_name": "craft", "function_body": "  # Fetching the index of the desired item from the cookbook\n  item_index = env.world.cookbook.index[item]\n\n  # If the item has no recipe or is not a crafted item, return an empty action list\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the recipe for the desired item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Check if all required ingredients are available in the inventory\n  required_ingredients = {env.world.cookbook.index[ingredient]: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n  available_ingredients = {k: v for k, v in enumerate(env._current_state.inventory) if v > 0}\n\n  # If all ingredients are not available, return an empty action list\n  if any(required_ingredient not in available_ingredients or available_ingredients[required_ingredient] < count \n         for required_ingredient, count in required_ingredients.items()):\n    return []\n\n  # Find the workshop index where the item should be crafted\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n  \n  # Determine if we are next to the correct workshop and facing it\n  def is_next_to_workshop_and_facing(current_state, workshop_index):\n    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n      neighbor_pos = (current_state.pos[0] + dx, current_state.pos[1] + dy)\n      if env.world.grid[neighbor_pos] == workshop_index and current_state.dir == (dx, dy):\n        return True\n    return False\n\n  # Generate actions to move next to the correct workshop and face it\n  def generate_actions_to_move_and_face(current_state, workshop_index):\n    actions = []\n    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n      neighbor_pos = (current_state.pos[0] + dx, current_state.pos[1] + dy)\n      if env.world.grid[neighbor_pos] == workshop_index:\n        target_dir = (dx, dy)\n        current_dir = ((1, 0), (-1, 0), (0, -1), (0, 1)).index(current_state.dir)\n        target_dir_idx = ((1, 0), (-1, 0), (0, -1), (0, 1)).index(target_dir)\n        \n        if current_dir != target_dir_idx:\n          actions.append((target_dir_idx + 2) % 4)  # Turn to face the workshop\n        actions.append(4)  # Use action to craft at the workshop\n        return actions\n    return []\n\n  # If we are already next to and facing the correct workshop, perform the USE action\n  if is_next_to_workshop_and_facing(env._current_state, workshop_index):\n    return [4]  # USE action\n\n  # Otherwise, generate actions to move next to and face the correct workshop\n  return generate_actions_to_move_and_face(env._current_state, workshop_index)", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T13:11:39.831217", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  i_goal = env.world.cookbook.index[item]\n  \n  # Check if the goal is a primitive\n  if i_goal in env.world.grabbable_indices:\n    return [env.action_specs()[\"COLLECT_FUNC\"][item]]\n  \n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes[i_goal]\n  \n  # Initialize an action list to accumulate steps to craft the item\n  actions = []\n  \n  # Collect all required primitives and intermediate items\n  for ingredient, count in recipe.items():\n    if ingredient == \"_at\":\n      continue\n    \n    i_ingredient = env.world.cookbook.index[ingredient]\n    \n    # Check if the agent already has enough of this ingredient\n    if env._current_state.inventory[i_ingredient] < count:\n      # Find and collect the required primitives/intermediate items\n      actions.extend(collect(env, ingredient))\n      \n  # Once all ingredients are collected, go to the specified workshop\n  workshop = recipe[\"_at\"]\n  i_workshop = env.world.cookbook.index[workshop]\n  \n  # Move to the workshop\n  actions.extend(move_to_workshop(env, workshop))\n  \n  # Use action at the workshop to craft the item\n  actions.append(env.action_specs()[\"USE\"])\n  \n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-11T13:14:32.869131", "function_name": "craft", "function_body": "  def get_direction(current_pos, target_pos):\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    if abs(dx) > abs(dy):\n      return 3 if dx > 0 else 2\n    elif abs(dx) < abs(dy):\n      return 1 if dy > 0 else 0\n    elif dx > 0:\n      return 3  # RIGHT\n    elif dx < 0:\n      return 2  # LEFT\n    elif dy > 0:\n      return 1  # UP\n    elif dy < 0:\n      return 0  # DOWN\n\n  def navigate(state, target_pos):\n    path = []\n    current_pos = state.pos\n    \n    while current_pos != target_pos:\n      direction = get_direction(current_pos, target_pos)\n      \n      if direction == 0:  # DOWN\n        path.append(0)\n        current_pos = (current_pos[0], current_pos[1] - 1)\n      elif direction == 1:  # UP\n        path.append(1)\n        current_pos = (current_pos[0], current_pos[1] + 1)\n      elif direction == 2:  # LEFT\n        path.append(2)\n        current_pos = (current_pos[0] - 1, current_pos[1])\n      elif direction == 3:  # RIGHT\n        path.append(3)\n        current_pos = (current_pos[0] + 1, current_pos[1])\n    \n    return path\n\n  def turn_to_face(state, target_pos):\n    dx = target_pos[0] - state.pos[0]\n    dy = target_pos[1] - state.pos[1]\n\n    if abs(dx) > abs(dy):\n      return 3 if dx > 0 else 2\n    elif abs(dx) < abs(dy):\n      return 1 if dy > 0 else 0\n\n    # If the agent is directly in front or behind the target, choose an appropriate direction\n    elif dx == 0 and dy > 0:\n      return 1  # UP\n    elif dx == 0 and dy < 0:\n      return 0  # DOWN\n    elif dy == 0 and dx > 0:\n      return 3  # RIGHT\n    elif dy == 0 and dx < 0:\n      return 2  # LEFT\n\n  def has_all_primitives(required_primitives, inventory_dict):\n    return all(primitive in inventory_dict and inventory_dict[primitive] >= required_primitives[primitive] for primitive in required_primitives)\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  # If not all primitives are available return empty action list\n  if not has_all_primitives(required_primitives, inventory_dict):\n    return []\n  \n  # Find the workshop where we can craft this item\n  workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n      workshop_index = recipe.get(\"_at\")\n      break\n  \n  if workshop_index is None:\n    return []\n\n  # Find the position of the nearest workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(workshop_positions) == 0:\n    return []\n  \n  # Select the closest workshop (for simplicity, we take the first one found)\n  target_workshop_pos = tuple(min(workshop_positions, key=lambda x: abs(x[0] - env._current_state.pos[0]) + abs(x[1] - env._current_state.pos[1])))\n\n  # Navigate to the selected workshop\n  actions = navigate(env._current_state, target_workshop_pos)\n\n  # Turn towards the workshop if not already facing it\n  current_direction = env._current_state.dir\n  direction_to_workshop = turn_to_face(env._current_state, target_workshop_pos)\n  \n  # Check if we need to turn\n  while current_direction != direction_to_workshop:\n    actions.append(direction_to_workshop)\n    current_direction = (current_direction + 1) % 4\n\n  # Use the USE action to craft the item at the workshop\n  actions.append(4)  # Assuming 4 is the index for the USE action\n  \n  return actions", "island_id": 8, "scores": {"3": 0.0}}
