actions.append(craft.USE)\n\n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T16:59:21.763562", "function_name": "craft", "function_body": "  def find_closest_position_with_space_for_workshop(workshop_index):\n    grid = env._current_state.grid\n    agent_pos = env._current_state.pos\n    closest_distance = float('inf')\n    closest_position = None\n\n    for x in range(grid.shape[0]):\n        for y in range(grid.shape[1]):\n            if (grid[x, y, workshop_index] > 0 and\n                grid[x + 1, y, 0] == 0 and grid[x - 1, y, 0] == 0 and  # Check adjacent cells are empty\n                grid[x, y + 1, 0] == 0 and grid[x, y - 1, 0] == 0):\n                distance = abs(x - agent_pos[0]) + abs(y - agent_pos[1])\n                if distance < closest_distance:\n                    closest_distance = distance\n                    closest_position = (x, y)\n\n    return closest_position\n\n  def move_towards_position(agent_pos, target_pos):\n      actions = []\n      dx, dy = target_pos[0] - agent_pos[0], target_pos[1] - agent_pos[1]\n\n      if abs(dx) > abs(dy):\n          # Move horizontally first\n          if dx > 0:\n              for _ in range(dx):\n                  actions.append(3)  # RIGHT\n          else:\n              for _ in range(-dx):\n                  actions.append(2)  # LEFT\n\n          # Then move vertically\n          if dy > 0:\n              for _ in range(dy):\n                  actions.append(1)  # UP\n          else:\n              for _ in range(-dy):\n                  actions.append(0)  # DOWN\n      else:\n          # Move vertically first\n          if dy > 0:\n              for _ in range(dy):\n                  actions.append(1)  # UP\n          else:\n              for _ in range(-dy):\n                  actions.append(0)  # DOWN\n\n          # Then move horizontally\n          if dx > 0:\n              for _ in range(dx):\n                  actions.append(3)  # RIGHT\n          else:\n              for _ in range(-dx):\n                  actions.append(2)  # LEFT\n\n      return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item has a recipe\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the required primitives and their counts for crafting the item\n  recipe = env.world.cookbook.recipes[item_index]\n  required_primitives = {ingredient: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n\n  # Check if we have all the required primitives in our inventory\n  current_inventory = env._current_state.inventory\n\n  missing_primitives = []\n\n  for primitive, count in required_primitives.items():\n    if current_inventory[primitive] < count:\n      missing_primitives.append((primitive, count))\n\n  # If there are any missing primitives, return an empty action list\n  if missing_primitives:\n    return []\n\n  # Determine the workshop where crafting should occur\n  workshop = recipe.get(\"_at\", None)\n  if not workshop:\n    return []\n\n  workshop_index = env.world.cookbook.index[workshop]\n\n  # Find the closest position next to the workshop\n  closest_workshop_pos = find_closest_position_with_space_for_workshop(workshop_index)\n\n  if not closest_workshop_pos:\n    return []\n\n  # Calculate the direction to move towards the closest workshop\n  agent_pos = env._current_state.pos\n  actions_to_take = move_towards_position(agent_pos, closest_workshop_pos)\n\n  # Append USE action to craft the item\n  actions_to_take.append(4)  # USE action\n\n  return actions_to_take", "island_id": 7, "scores": {"3": 5.0}}
{"timestamp": "2025-09-11T16:59:22.731592", "function_name": "craft", "function_body": "  def find_closest_workshop(workshop_index):\n    grid = env._current_state.grid\n    agent_pos = env._current_state.pos\n    closest_distance = float('inf')\n    closest_workshop_pos = None\n\n    for x in range(grid.shape[0]):\n        for y in range(grid.shape[1]):\n            if grid[x, y, workshop_index] > 0:\n                distance = abs(x - agent_pos[0]) + abs(y - agent_pos[1])\n                if distance < closest_distance and env._current_state.next_to((x, y), workshop_index):\n                    closest_distance = distance\n                    closest_workshop_pos = (x, y)\n\n    return closest_workshop_pos\n\n  def move_towards_position(agent_pos, target_pos):\n      actions = []\n      dx = target_pos[0] - agent_pos[0]\n      dy = target_pos[1] - agent_pos[1]\n\n      if abs(dx) > abs(dy):\n          # Move horizontally first\n          if dx > 0:\n              for _ in range(dx):\n                  actions.append(3)  # RIGHT\n          else:\n              for _ in range(-dx):\n                  actions.append(2)  # LEFT\n\n          # Then move vertically\n          if dy > 0:\n              for _ in range(dy):\n                  actions.append(1)  # UP\n          else:\n              for _ in range(-dy):\n                  actions.append(0)  # DOWN\n      else:\n          # Move vertically first\n          if dy > 0:\n              for _ in range(dy):\n                  actions.append(1)  # UP\n          else:\n              for _ in range(-dy):\n                  actions.append(0)  # DOWN\n\n          # Then move horizontally\n          if dx > 0:\n              for _ in range(dx):\n                  actions.append(3)  # RIGHT\n          else:\n              for _ in range(-dx):\n                  actions.append(2)  # LEFT\n\n      return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item has a recipe\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the required primitives and their counts for crafting the item\n  recipe = env.world.cookbook.recipes[item_index]\n  required_primitives = {ingredient: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n\n  # Check if we have all the required primitives in our inventory\n  current_inventory = env._current_state.inventory\n\n  missing_primitives = []\n\n  for primitive, count in required_primitives.items():\n    if current_inventory[primitive] < count:\n      missing_primitives.append((primitive, count))\n\n  # If there are any missing primitives, return an empty action list\n  if missing_primitives:\n    return []\n\n  # Determine the workshop where crafting should occur\n  workshop = recipe.get(\"_at\", None)\n  if not workshop:\n    return []\n\n  workshop_index = env.world.cookbook.index[workshop]\n\n  # Find the closest position next to the workshop\n  closest_workshop_pos = find_closest_workshop(workshop_index)\n\n  if not closest_workshop_pos:\n    return []\n\n  # Calculate the direction to move towards the closest workshop\n  agent_pos = env._current_state.pos\n  actions_to_take = move_towards_position(agent_pos, closest_workshop_pos)\n\n  # Append USE action to craft the item\n  actions_to_take.append(4)  # USE action\n\n  return actions_to_take", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-11T17:00:45.694369", "function_name": "craft", "function_body": "  # Get the index of the item\n  item_index = env.world.cookbook.index[item]\n  \n  if item_index is None:\n    print(f\"Item '{item}' not found in the cookbook.\")\n    return []\n  \n  # Check if we have all required primitives for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  current_inventory = {i: count for i, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  for prim, needed_count in required_primitives.items():\n    if current_inventory.get(prim, 0) < needed_count:\n      print(f\"Missing primitive '{env.world.cookbook.index.get(prim)}' (required: {needed_count}, found: {current_inventory.get(prim, 0)})\")\n      return []\n\n  # Determine the workshop for crafting\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_key = [k for k in recipe if k.startswith(\"_at\")][0]  # Assuming only one _at key per recipe\n  workshop_name = recipe[workshop_key]\n  \n  # Get the index of the workshop\n  workshop_indices = [idx for idx, name in enumerate(env.world.workshop_indices) \n                      if env.world.cookbook.index.get(name) == workshop_name]\n\n  if not workshop_indices:\n    print(f\"No workshop found for '{item}' with _at key: {workshop_key}\")\n    return []\n\n  # Find the closest workshop\n  workshop_idx = workshop_indices[0]\n  closest_workshop_pos = None\n  min_distance = float('inf')\n  \n  for x in range(env.world.scenario.grid.shape[0]):\n    for y in range(env.world.scenario.grid.shape[1]):\n      if env._current_state.grid[x, y, workshop_idx] > 0:\n        distance = np.linalg.norm(np.array(env._current_state.pos) - np.array([x, y]))\n        if distance < min_distance:\n          closest_workshop_pos = (x, y)\n          min_distance = distance\n\n  if not closest_workshop_pos:\n    print(f\"No valid position found for workshop '{workshop_name}'\")\n    return []\n\n  # Calculate actions to move towards the closest workshop\n  path_to_workshop = a_star_search(env._current_state.grid, env._current_state.pos, closest_workshop_pos)\n  \n  if not path_to_workshop:\n    print(\"No path found to reach the workshop.\")\n    return []\n\n  # Convert path into actions\n  actions = []\n  current_pos = env._current_state.pos\n  \n  for next_pos in path_to_workshop[1:]:  # Skip the first position as it's the starting point\n    direction = get_direction(current_pos, next_pos)\n    if direction is not None:\n      actions.append(direction)\n    current_pos = next_pos\n\n  # Add USE action to craft the item\n  actions.append(env.world.N_ACTIONS)  # Assuming N_ACTIONS is the index for USE action\n\n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-11T17:00:46.737353", "function_name": "craft", "function_body": "  current_state = env._current_state\n  cookbook = current_state.world.cookbook\n\n  # Get the index for the item to craft\n  goal_idx = cookbook.index[item]\n\n  if goal_idx not in cookbook.recipes:\n    return []\n\n  recipe = cookbook.recipes[goal_idx]\n  \n  actions_to_take = []\n  \n  # First, collect all necessary ingredients and primitives\n  required_primitives = {k: v for k, v in recipe.items() if k != \"_at\"}\n  \n  for primitive_name, count in required_primitives.items():\n    primitive_index = cookbook.index[primitive_name]\n    \n    while current_state.inventory[primitive_index] < count:\n      # Generate actions to collect the primitive\n      actions_to_take.extend(collect(env, primitive_name))\n      \n      # Execute the collected actions and update the state\n      for action in actions_to_take:\n        reward, done, observations = env.step(action)\n        \n        if done:\n          return actions_to_take\n        \n        current_state = observations['current_state']\n  \n  # Now that we have all the required ingredients, let's go to the workshop\n  workshop_name = recipe[\"_at\"]\n  workshop_index = cookbook.index[workshop_name]\n  \n  actions_to_take.extend(go_to_workshop(env, workshop_index))\n  \n  # Turn the agent towards the workshop for the USE action\n  actions_to_take.append(craft.DIR_TO_ACTION_MAP[current_state.dir])\n  \n  # Finally, use the workshop to craft the item\n  actions_to_take.append(craft.USE)\n  \n  return actions_to_take", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-11T17:03:58.515214", "function_name": "craft", "function_body": "  def get_direction(current_pos, target_pos):\n    x_diff = target_pos[0] - current_pos[0]\n    y_diff = target_pos[1] - current_pos[1]\n\n    if x_diff > 0:\n      return 3  # RIGHT\n    elif x_diff < 0:\n      return 2  # LEFT\n    elif y_diff > 0:\n      return 1  # UP\n    elif y_diff < 0:\n      return 0  # DOWN\n    else:\n      return None\n\n  def find_path(start, target):\n    actions = []\n    \n    start_x, start_y = divmod(start, env._current_state.grid.shape[1])\n    target_x, target_y = divmod(target, env._current_state.grid.shape[1])\n\n    open_set = []\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, target)}\n\n    heapq.heappush(open_set, (f_score[start], start))\n\n    while open_set:\n      _, current = heapq.heappop(open_set)\n\n      if current == target:\n        reconstruct_path(came_from, current)\n        break\n\n      cx, cy = divmod(current, env._current_state.grid.shape[1])\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = cx + dx, cy + dy\n\n        if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n          neighbor = nx * env._current_state.grid.shape[1] + ny\n          tentative_g_score = g_score[current] + 1\n\n          if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n            came_from[neighbor] = current\n            g_score[neighbor] = tentative_g_score\n            f_score[neighbor] = tentative_g_score + heuristic(neighbor, target)\n            heapq.heappush(open_set, (f_score[neighbor], neighbor))\n\n    def reconstruct_path(came_from, current):\n      total_path = []\n      while current in came_from:\n        cx, cy = divmod(current, env._current_state.grid.shape[1])\n        px, py = divmod(came_from[current], env._current_state.grid.shape[1])\n\n        dx, dy = px - cx, py - cy\n        direction_to_face = get_direction((cx, cy), (px, py))\n        \n        if direction_to_face is not None:\n          total_path.append(direction_to_face)\n        \n        current = came_from[current]\n      \n      actions.extend(reversed(total_path))\n\n    return actions\n\n  def heuristic(a, b):\n    ax, ay = divmod(a, env._current_state.grid.shape[1])\n    bx, by = divmod(b, env._current_state.grid.shape[1])\n\n    # Manhattan distance\n    return abs(ax - bx) + abs(ay - by)\n\n  actions = []\n\n  item_index = env.world.cookbook.index[item]\n\n  if not item_index:\n    return []\n\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  current_inventory = {env.world.cookbook.index.get(i): c for i, c in enumerate(env._current_state.inventory) if c > 0}\n\n  missing_primitives = []\n  for primitive_index, count in primitives_needed.items():\n    if current_inventory.get(primitive_index, 0) < count:\n      missing_primitives.append((primitive_index, count - current_inventory.get(primitive_index, 0)))\n\n  if missing_primitives:\n    return []\n\n  workshop_name = env.world.cookbook.recipes[item_index][\"_at\"]\n  workshop_indices = np.argwhere(env._current_state.grid[:, :, env.world.workshop_indices[0]] == env.world.cookbook.index[workshop_name])\n\n  if not workshop_indices.any():\n    return []\n\n  start_pos_flat = env._current_state.pos[0] * env._current_state.grid.shape[1] + env._current_state.pos[1]\n  target_workshop_position = (workshop_indices[0][0], workshop_indices[0][1])\n  target_pos_flat = target_workshop_position[0] * env._current_state.grid.shape[1] + target_workshop_position[1]\n\n  actions.extend(find_path(start_pos_flat, target_pos_flat))\n\n  # Ensure the agent is directly in front of the workshop\n  while env._current_state.pos != (target_workshop_position[0], target_workshop_position[1]):\n    current_pos = env._current_state.pos\n    direction_to_face = get_direction(current_pos, target_workshop_position)\n    \n    if direction_to_face is not None:\n      actions.append(direction_to_face)\n\n  # Craft the item by using the USE action\n  actions.append(4)  # USE action\n\n  return actions", "island_id": 5, "scores": {"3": 0.0}}
