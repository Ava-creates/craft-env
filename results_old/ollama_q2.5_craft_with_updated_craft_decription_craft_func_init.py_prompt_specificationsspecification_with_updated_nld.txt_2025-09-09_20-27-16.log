{"timestamp": "2025-09-11T10:07:33.766259", "function_name": "craft", "function_body": "  # Get the index of the desired item from the cookbook.\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the goal is achievable (i.e., it's in the recipes or primitives).\n  if item_index not in env.world.cookbook.recipes and item_index not in env.world.cookbook.primitives:\n    return []\n  \n  actions = []\n\n  # Get all the ingredients required for crafting the item.\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Check if we have all the necessary primitives in our inventory.\n  def check_inventory(item_index, inventory):\n    # Base case: If the item is a primitive and is available in the inventory\n    if item_index in env.world.cookbook.primitives and inventory[item_index] > 0:\n      return True\n\n    # Check if we have all ingredients for crafting the item.\n    recipe = env.world.cookbook.recipes.get(item_index, {})\n    for ingredient_index, count in recipe.items():\n      if ingredient_index == \"_key\":\n        continue\n      if not check_inventory(ingredient_index, inventory):\n        return False\n    return True\n  \n  # If we don't have all the necessary ingredients, collect them.\n  def collect_primitives(recipe, actions):\n    for ingredient_index, count in recipe.items():\n      if ingredient_index == \"_key\":\n        continue\n      ingredient_name = env.world.cookbook.index.get(ingredient_index)\n      if ingredient_index in env.world.cookbook.primitives:\n        # Collect the primitive if it's not already in inventory.\n        actions.extend(collect(env, ingredient_name))\n      else:\n        # Recursively collect ingredients needed for this intermediate item.\n        actions.extend(collect_primitives(env.world.cookbook.recipes[ingredient_index], actions))\n    return actions\n\n  current_inventory = env._current_state.inventory\n  if not check_inventory(item_index, current_inventory):\n    actions.extend(collect_primitives(recipe, actions))\n\n  # Get the workshop index from the recipe.\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n    workshop_index = getattr(env.world, f\"{workshop_name}_index\", None)\n    if workshop_index is not None:\n      # Find a path to the workshop.\n      path_to_workshop = find_path(env._current_state.grid, env._current_state.pos, workshop_index)\n      actions.extend(path_to_workshop)\n\n  # Add USE action to craft the item once at the workshop.\n  actions.append(4)  # Assuming USE action is represented by 4\n\n  return actions", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T10:08:55.053952", "function_name": "craft", "function_body": "  def get_actions_to_collect_primitive(primitive):\n    # Find the primitive index\n    primitive_index = env.world.cookbook.index[primitive]\n    actions = []\n    \n    # Search for the primitive in the grid and collect it\n    # Here we assume a simple search strategy, which is not optimal but functional\n    grid = env._current_state.grid\n    for x in range(grid.shape[0]):\n      for y in range(grid.shape[1]):\n        if grid[x, y, primitive_index] == 1:\n          # Move to the position of the primitive\n          actions.extend(move_to_position(env, (x, y)))\n          actions.append(env.world.cookbook.index[\"USE\"])\n          return actions\n    return []\n\n  def move_to_position(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    # Calculate the difference in positions\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n    \n    if dy > 0:\n      actions.extend([env.world.cookbook.index[\"DOWN\"]] * abs(dy))\n    elif dy < 0:\n      actions.extend([env.world.cookbook.index[\"UP\"]] * abs(dy))\n    \n    if dx > 0:\n      actions.extend([env.world.cookbook.index[\"RIGHT\"]] * abs(dx))\n    elif dx < 0:\n      actions.extend([env.world.cookbook.index[\"LEFT\"]] * abs(dx))\n    \n    return actions\n\n  def get_workshop_for_item(item):\n    # Find the workshop index for the item\n    recipe = env.world.cookbook.recipes[env.world.cookbook.index[item]]\n    return recipe[\"_at\"]\n\n  def move_to_workshop(workshop_name):\n    # Get the index of the workshop\n    workshop_index = env.world.cookbook.index[workshop_name]\n    \n    grid = env._current_state.grid\n    actions = []\n    \n    # Search for the workshop in the grid and move to it\n    for x in range(grid.shape[0]):\n      for y in range(grid.shape[1]):\n        if grid[x, y, workshop_index] == 1:\n          actions.extend(move_to_position(env, (x, y)))\n          return actions\n    return []\n\n  def check_inventory_for_item(item):\n    # Check if the item is already in inventory\n    item_index = env.world.cookbook.index[item]\n    return env._current_state.inventory[item_index] > 0\n\n  def get_primitives_needed(item):\n    # Get primitives needed for crafting the item\n    recipe = env.world.cookbook.recipes[env.world.cookbook.index[item]]\n    primitives_needed = {key: value for key, value in recipe.items() if key != \"_at\"}\n    return primitives_needed\n\n  actions = []\n  # Check if we already have the item in inventory\n  if check_inventory_for_item(item):\n    return []\n\n  # Get primitives needed to craft the item\n  primitives_needed = get_primitives_needed(item)\n\n  # Collect all required primitives\n  for primitive, count in primitives_needed.items():\n    while env._current_state.inventory[env.world.cookbook.index[primitive]] < count:\n      actions.extend(get_actions_to_collect_primitive(primitive))\n\n  # Move to the workshop specified in the recipe and perform USE action\n  workshop = get_workshop_for_item(item)\n  actions.extend(move_to_workshop(workshop))\n  actions.append(env.world.cookbook.index[\"USE\"])\n\n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-11T10:08:56.028330", "function_name": "craft", "function_body": "  # Extract the index for the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the recipe for crafting the item\n  recipe = env.world.cookbook.recipes.get(item_index)\n  \n  if not recipe:\n    print(f\"No recipe found for {item}\")\n    return []\n\n  actions = []\n  \n  # Check and collect all required primitives for crafting\n  for ingredient, count in recipe.items():\n    if ingredient == \"_key\": \n      continue\n    primitive_index = env.world.cookbook.index[ingredient]\n    \n    # Ensure the agent has enough of each required primitive\n    while np.sum(env._current_state.inventory[primitive_index]) < count:\n      actions.extend(collect_v2(env, ingredient))\n      \n  # Go to the workshop specified in the recipe and perform USE action\n  if \"_key\" in recipe:\n    workshop = recipe[\"_key\"]\n    workshop_index = env.world.cookbook.index[workshop]\n    workshop_pos = find_nearest_workshop(env._current_state.grid, workshop_index)\n    \n    # Move to the nearest workshop position\n    actions.extend(move_to_position(env._current_state, workshop_pos))\n    \n    # Turn to face the workshop and perform USE action\n    direction = get_direction_facing_workshop(env._current_state.pos, workshop_pos)\n    actions.append(direction)\n    actions.append(env.world.N_ACTIONS)  # Assuming N_ACTIONS is for USE\n    \n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-11T10:09:35.825820", "function_name": "craft", "function_body": "  # Retrieve the index of the item to be crafted\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n  \n  # Extract primitives needed and their counts from the recipe\n  primitives_needed = {env.world.cookbook.index[name]: count for name, count in recipe.items() if name != \"_at\"}\n  \n  # Check if all required primitives are available in inventory\n  available_primitives = env._current_state.inventory[primitives_needed.keys()]\n  \n  # If any primitive is not available return empty action list\n  if np.any(available_primitives < list(primitives_needed.values())):\n    return []\n  \n  # Extract the workshop index from the recipe\n  workshop_name = recipe.get(\"_at\", None)\n  if not workshop_name:\n    return []  # No workshop specified in the recipe\n  \n  # Retrieve all indices of workshops from the world configuration\n  workshop_indices = [getattr(env.world, f\"{workshop_name}_index\")]\n  \n  # Find the closest workshop to the agent's current position\n  closest_workshop_pos = min(workshop_indices, key=lambda idx: np.linalg.norm(np.array(env._current_state.pos) - np.argwhere(env._current_state.grid[:, :, idx]).mean(axis=0)))\n  \n  # Calculate actions to move towards the closest workshop\n  move_actions = calculate_move_actions_to_target(env, closest_workshop_pos)\n  \n  # Add USE action to craft the item at the workshop\n  use_action = [craft.USE]\n  \n  return move_actions + use_action", "island_id": 9, "scores": {"3": -1}}
