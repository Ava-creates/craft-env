{"timestamp": "2025-09-11T12:26:26.793050", "function_name": "craft", "function_body": "  def get_workshop_position(workshop_index):\n      positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n      if len(positions) > 0:\n          return positions[0]\n      else:\n          raise ValueError(f\"No position found for workshop index: {workshop_index}\")\n\n  def get_required_primitives(i_goal):\n      return env.world.cookbook.primitives_for(i_goal)\n\n  def move_to(target_position):\n      actions = []\n      agent_pos = np.array(env._current_state.pos)\n      \n      path = find_path(agent_pos, target_position, env)\n      \n      if not path:\n          return []  # No valid path to the workshop\n\n      for pos in path:\n          delta_x = pos[0] - agent_pos[0]\n          delta_y = pos[1] - agent_pos[1]\n\n          action = None\n          if delta_x > 0:\n              action = craft.DOWN\n          elif delta_x < 0:\n              action = craft.UP\n          if delta_y > 0:\n              action = craft.RIGHT\n          elif delta_y < 0:\n              action = craft.LEFT\n\n          actions.append(action)\n          \n          # Simulate the step to update the agent's position\n          env.step(action)\n          agent_pos = env._current_state.pos\n\n      return actions\n\n  def face_workshop(workshop_position):\n      current_direction = env._current_state.dir\n      delta_x = workshop_position[0] - env._current_state.pos[0]\n      delta_y = workshop_position[1] - env._current_state.pos[1]\n\n      target_direction_mapping = {\n          (0, -1): craft.LEFT,\n          (0, 1): craft.RIGHT,\n          (-1, 0): craft.UP,\n          (1, 0): craft.DOWN\n      }\n\n      # Determine the target direction based on the largest difference\n      if abs(delta_x) > abs(delta_y):\n          target_direction = target_direction_mapping[(np.sign(delta_x), 0)]\n      else:\n          target_direction = target_direction_mapping[(0, np.sign(delta_y))]\n\n      actions = []\n      while current_direction != target_direction:\n          # Determine the turn direction to reach the target direction\n          if (current_direction + 1) % 4 == target_direction:\n              actions.append(target_direction_mapping[(np.sign(delta_x), 0)])\n          elif (current_direction - 1) % 4 == target_direction:\n              actions.append(target_direction_mapping[(0, np.sign(delta_y))])\n          else:\n              actions.append(craft.MOVE_FUNC(craft.RIGHT))\n              actions.append(craft.MOVE_FUNC(craft.RIGHT))\n\n          current_direction = (current_direction + len(actions)) % 4\n\n      return actions\n\n  i_goal = env.world.cookbook.index[item]\n  \n  # Get the primitives required to craft this item\n  prim_reqs = get_required_primitives(i_goal)\n  \n  actions_list = []\n\n  # Check if we have all the required primitives in our inventory\n  for i_prim, count in prim_reqs.items():\n      if env._current_state.inventory[i_prim] < count:\n          return []  # If any primitive is missing, return an empty action list\n  \n  # Find which workshop to use for crafting\n  workshop_index = None\n  workshop_name = \"_key\"\n  \n  # Iterate over the recipes and find the workshop\n  for output_index, recipe in env.world.cookbook.recipes.items():\n      if i_goal == output_index:\n          workshop_name = recipe[\"_at\"]\n          break\n  \n  # Get the index of the workshop from the environment's indices\n  try:\n      workshop_index = getattr(env.world, f\"{workshop_name}_index\")\n  except AttributeError:\n      return []  # If the workshop is not found, return an empty action list\n  \n  # Now that we have all the requirements and know where to craft, let's move to the workshop\n  workshop_pos = get_workshop_position(workshop_index)\n\n  actions_list.extend(move_to(workshop_pos))\n  \n  # Once we reach the workshop, face it\n  actions_list.extend(face_workshop(workshop_pos))\n\n  # Once facing the workshop, use it to craft the item\n  actions_list.append(craft.USE_FUNC())\n  \n  return actions_list", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T12:26:27.909355", "function_name": "craft", "function_body": "  def get_required_primitives(i_goal):\n      return env.world.cookbook.primitives_for(i_goal)\n\n  def get_workshop_position(workshop_index):\n      positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n      if len(positions) > 0:\n          return positions[0]\n      else:\n          raise ValueError(f\"No position found for workshop index: {workshop_index}\")\n\n  def move_to(target_position):\n      actions = []\n      agent_pos = np.array(env._current_state.pos)\n\n      # Define a simple heuristic function (Manhattan distance)\n      def heuristic(pos1, pos2):\n          return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n\n      # A* pathfinding algorithm\n      open_set = collections.PriorityQueue()\n      open_set.put((0, agent_pos))\n      came_from = {}\n      g_score = {tuple(agent_pos): 0}\n      f_score = {tuple(agent_pos): heuristic(agent_pos, target_position)}\n\n      while not open_set.empty():\n          _, current = open_set.get()\n\n          if np.array_equal(current, target_position):\n              path = []\n              while tuple(current) in came_from:\n                  path.append(tuple(current))\n                  current = came_from[tuple(current)]\n              path.reverse()\n              return actions + [craft.MOVE_FUNC(craft.UP)] * (target_position[0] - agent_pos[0]) + \\\n                     [craft.MOVE_FUNC(craft.RIGHT)] * (target_position[1] - agent_pos[1])\n\n          for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n              neighbor = np.array([current[0] + dx, current[1] + dy])\n              tentative_g_score = g_score[tuple(current)] + heuristic(current, neighbor)\n\n              if tuple(neighbor) not in g_score or tentative_g_score < g_score[tuple(neighbor)]:\n                  came_from[tuple(neighbor)] = current\n                  g_score[tuple(neighbor)] = tentative_g_score\n                  f_score[tuple(neighbor)] = tentative_g_score + heuristic(neighbor, target_position)\n                  open_set.put((f_score[tuple(neighbor)], neighbor))\n\n      return []  # No valid path found\n\n  def face_workshop(workshop_position):\n      current_direction = env._current_state.dir\n      delta_x = workshop_position[0] - env._current_state.pos[0]\n      delta_y = workshop_position[1] - env._current_state.pos[1]\n\n      target_direction_mapping = {\n          (0, -1): craft.LEFT,\n          (0, 1): craft.RIGHT,\n          (-1, 0): craft.UP,\n          (1, 0): craft.DOWN\n      }\n\n      # Determine the target direction based on the largest difference\n      if abs(delta_x) > abs(delta_y):\n          target_direction = target_direction_mapping[(np.sign(delta_x), 0)]\n      else:\n          target_direction = target_direction_mapping[(0, np.sign(delta_y))]\n\n      actions = []\n      while current_direction != target_direction:\n          # Determine the turn direction to reach the target direction\n          if (current_direction + 1) % 4 == target_direction:\n              actions.append(craft.MOVE_FUNC(craft.RIGHT))\n          elif (current_direction - 1) % 4 == target_direction:\n              actions.append(craft.MOVE_FUNC(craft.LEFT))\n          else:\n              actions.append(craft.MOVE_FUNC(craft.RIGHT))\n              actions.append(craft.MOVE_FUNC(craft.RIGHT))\n\n          current_direction = (current_direction + len(actions)) % 4\n\n      return actions\n\n  i_goal = env.world.cookbook.index[item]\n\n  # Get the primitives required to craft this item\n  prim_reqs = get_required_primitives(i_goal)\n\n  actions_list = []\n\n  # Check if we have all the required primitives in our inventory\n  for i_prim, count in prim_reqs.items():\n      if env._current_state.inventory[i_prim] < count:\n          return []  # If any primitive is missing, return an empty action list\n\n  # Find which workshop to use for crafting\n  workshop_index = None\n  workshop_name = \"_key\"\n\n  # Iterate over the recipes and find the workshop\n  for output_index, recipe in env.world.cookbook.recipes.items():\n      if i_goal == output_index:\n          workshop_name = recipe[\"_at\"]\n          break\n\n  # Get the index of the workshop from the environment's indices\n  try:\n      workshop_index = getattr(env.world, f\"{workshop_name}_index\")\n  except AttributeError:\n      return []  # If the workshop is not found, return an empty action list\n\n  # Now that we have all the requirements and know where to craft, let's move to the workshop\n  workshop_pos = get_workshop_position(workshop_index)\n\n  actions_list.extend(move_to(workshop_pos))\n\n  # Face the workshop once we reach there\n  actions_list.extend(face_workshop(workshop_pos))\n\n  # Once facing the workshop, use it to craft the item\n  actions_list.append(craft.USE_FUNC())\n\n  return actions_list", "island_id": 6, "scores": {"3": 0.0}}
