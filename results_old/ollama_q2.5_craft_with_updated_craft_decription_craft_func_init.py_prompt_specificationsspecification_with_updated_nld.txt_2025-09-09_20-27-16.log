rent_state.pos, closest_workshop, env._current_state.dir)\n    if direction_to_face != env._current_state.dir:\n      actions.append(direction_to_face)\n    \n    # Perform USE action to craft\n    actions.append(env.action_specs()[\"USE\"])\n  \n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T02:26:16.535311", "function_name": "craft", "function_body": "  actions = []\n  \n  # Fetch the index of the goal item\n  goal_index = env.world.cookbook.index[item]\n  \n  # Get the primitives needed to craft this item and their counts\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  \n  # Check if we already have all required items in inventory\n  for i_primitive, count in required_primitives.items():\n    if env._current_state.inventory[i_primitive] < count:\n      return []  # We don't have enough primitives to craft this item\n  \n  # Find the workshop where the item can be crafted\n  workshop_index = None\n  for recipe_output, recipe_inputs in env.world.cookbook.recipes.items():\n    if \"_at\" in recipe_inputs and recipe_output == goal_index:\n      workshop_index = env.world.cookbook.index[recipe_inputs[\"_at\"]]\n  \n  # If no valid workshop found, return empty actions list\n  if workshop_index is None:\n    return []\n\n  # Find the position of a nearby workshop of the required type\n  grid_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(grid_positions) == 0:\n    return []  # No available workshops\n\n  # Sort positions by proximity to current agent's position\n  distances = np.sum((grid_positions - env._current_state.pos)**2, axis=1)\n  closest_workshop_pos = grid_positions[np.argmin(distances)]\n\n  # Calculate actions needed to move the agent to the closest workshop\n  while tuple(env._current_state.pos) != (closest_workshop_pos[0], closest_workshop_pos[1]):\n    dx, dy = closest_workshop_pos - env._current_state.pos\n\n    if abs(dx) > abs(dy):\n      direction = craft.LEFT if dx < 0 else craft.RIGHT\n    else:\n      direction = craft.UP if dy > 0 else craft.DOWN\n    \n    actions.append(direction)\n\n  # Add the USE action to start crafting at the workshop\n  actions.append(craft.USE)\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-10T02:26:17.518453", "function_name": "craft", "function_body": "  # Get the index for the desired item\n  item_idx = env.world.cookbook.index[item]\n\n  # Check if there is a recipe for the item\n  if item_idx not in env.world.cookbook.recipes:\n    print(f\"No recipe found for {item}.\")\n    return []\n\n  # Retrieve the recipe for the item\n  recipe = env.world.cookbook.recipes[item_idx]\n  required_items = recipe.copy()\n\n  # Remove '_key' entry from the recipe if present\n  _key = required_items.pop(\"_key\", None)\n\n  # Check if all required items are available in the inventory\n  missing_items = []\n  for required_item, count in required_items.items():\n    if env._current_state.inventory[required_item] < count:\n      missing_items.append(env.world.cookbook.index.get(required_item))\n\n  if missing_items:\n    print(f\"Missing items: {missing_items}\")\n    return []\n\n  # Determine the workshop where crafting should occur\n  workshop_index = None\n  for key in recipe.keys():\n    if \"_at\" in key:\n      workshop_name = recipe[key]\n      workshop_index = env.world.cookbook.index[workshop_name]\n      break\n\n  if workshop_index is None:\n    print(\"Workshop not specified in the recipe.\")\n    return []\n\n  # Find a position adjacent to the workshop\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  closest_workshop_pos = min(workshop_positions, key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1]))\n\n  # Calculate actions to move to the closest workshop\n  actions_to_workshop = calculate_moves(env._current_state.pos, closest_workshop_pos)\n\n  # Add the USE action to craft the item at the workshop\n  actions_to_craft = actions_to_workshop + [craft.USE]\n\n  return actions_to_craft", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-10T02:29:03.640648", "function_name": "craft", "function_body": "  def find_path(start, end, grid):\n    queue = collections.deque([(start, [])])\n    visited = set([start])\n    while queue:\n        (x, y), path = queue.popleft()\n        if (x, y) == end:\n            return path + [(x, y)]\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            nx, ny = x + dx, y + dy\n            if 0 <= nx < grid.shape[1] and 0 <= ny < grid.shape[0] and grid[ny, nx].sum() == 0 and (nx, ny) not in visited:\n                queue.append(((nx, ny), path + [(x, y)]))\n                visited.add((nx, ny))\n    return None\n\n  def move_towards(current_pos, target_pos):\n      cx, cy = current_pos\n      tx, ty = target_pos\n      actions = []\n      while (cx != tx) or (cy != ty):\n          if cx < tx:\n              actions.append(craft.CraftLab.ACTIONS['RIGHT'])\n              cx += 1\n          elif cx > tx:\n              actions.append(craft.CraftLab.ACTIONS['LEFT'])\n              cx -= 1\n          elif cy < ty:\n              actions.append(craft.CraftLab.ACTIONS['DOWN'])\n              cy += 1\n          elif cy > ty:\n              actions.append(craft.CraftLab.ACTIONS['UP'])\n              cy -= 1\n      return actions\n\n  def face_direction(current_pos, target_pos):\n      cx, cy = current_pos\n      tx, ty = target_pos\n      if cx < tx:\n          return craft.CraftLab.ACTIONS['RIGHT']\n      elif cx > tx:\n          return craft.CraftLab.ACTIONS['LEFT']\n      elif cy < ty:\n          return craft.CraftLab.ACTIONS['DOWN']\n      elif cy > ty:\n          return craft.CraftLab.ACTIONS['UP']\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the primitives required to craft the desired item\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n  \n  actions = []\n  \n  for primitive_index, count in primitives_required.items():\n    if env._current_state.inventory[primitive_index] < count:\n      return []  # Return empty action list if any primitive is not sufficient\n\n  workshop_index = None\n  \n  # Find out which workshop is needed for crafting the desired item\n  for output_item, recipe in env.world.cookbook.recipes.items():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n      workshop_index = recipe.get(\"_at\", None)\n      break\n\n  if workshop_index is None:\n    return []  # Return empty action list if no workshop found for the desired item\n\n  # Find the position of the workshop on the grid\n  workshop_position = None\n  for y in range(env._current_state.grid.shape[0]):\n    for x in range(env._current_state.grid.shape[1]):\n      if env._current_state.grid[y, x, workshop_index] == 1:\n        workshop_position = (x, y)\n        break\n    if workshop_position:\n      break\n\n  if workshop_position is None:\n    return []  # Return empty action list if the workshop position not found\n\n  # Generate actions to move to the workshop\n  path_to_workshop = find_path(env._current_state.pos, workshop_position, env._current_state.grid)\n  \n  for pos in path_to_workshop[:-1]:\n      actions.extend(move_towards(env._current_state.pos, pos))\n      # Update the current state position after each move\n      env._current_state.pos = pos\n\n  # Turn to face the workshop\n  actions.append(face_direction(env._current_state.pos, workshop_position))\n\n  # Perform the USE action to craft the item\n  actions.append(craft.CraftLab.ACTIONS['USE'])\n  \n  return actions", "island_id": 1, "scores": {"3": 0.0}}
