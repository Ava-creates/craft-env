{"timestamp": "2025-09-10T06:47:03.862498", "function_name": "craft", "function_body": "  actions = []\n  cookbook = env.world.cookbook\n  index = cookbook.index\n\n  # Get the index for the desired item using the cookbook's index mapping\n  target_index = index[item]\n  \n  if target_index is None:\n    return []\n\n  # Check if we have all primitives required for crafting the target item\n  primitives_needed = cookbook.primitives_for(target_index)\n  inventory = env._current_state.inventory\n\n  # Collect primitives if they are not in inventory\n  for primitive, count in primitives_needed.items():\n    while inventory[primitive] < count:\n      actions.extend(collect(env, index.get(primitive)))\n\n  # Find the workshop and craft the item\n  recipe = cookbook.recipes[target_index]\n  workshop_id = None\n\n  # Determine which workshop to use\n  for key, value in recipe.items():\n    if key == \"_at\":\n      workshop_id = index[value]\n  \n  if workshop_id is None:\n    return []\n\n  # Find a position next to the workshop where we can face it and USE action\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_id] > 0)\n\n  for pos in workshop_positions:\n    direction_to_workshop, use_action_required = find_direction_and_use(env._current_state.pos, tuple(pos), index)\n    \n    if use_action_required:\n      actions.append(direction_to_workshop)\n      actions.append(craft.USE)\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-10T06:47:56.470145", "function_name": "craft", "function_body": "  # Step 1: Determine the recipe for the target item\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  if item_index not in cookbook.recipes:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  # Extracting ingredients and workshop information from the recipe\n  recipe = cookbook.recipes[item_index]\n  ingredients_needed = {\n      cookbook.index.get(ingredient): count\n      for ingredient, count in recipe.items() if ingredient != \"_at\"\n  }\n  workshop_name = recipe[\"_at\"]\n\n  # Step 2: Check inventory to see if we have all the required items\n  current_inventory = env._current_state.inventory\n  missing_ingredients = {\n      i_kind: needed - current_inventory[i_kind]\n      for i_kind, needed in ingredients_needed.items()\n      if current_inventory[i_kind] < needed\n  }\n\n  # If there are any missing ingredients, return an empty action list\n  if missing_ingredients:\n    return []\n\n  # Step 3: Determine the position of the required workshop and navigate to it\n  workshop_index = cookbook.index[workshop_name]\n  workshops = env.world.workshop_indices\n\n  # Find the correct workshop index that matches the type needed\n  target_workshop_pos = None\n  for pos in np.argwhere(env._current_state.grid[:, :, workshop_index]):\n      target_workshop_pos = tuple(pos)\n      break\n\n  if not target_workshop_pos:\n    raise ValueError(f\"No {workshop_name} found on the map\")\n\n  # Generate actions to move towards the workshop\n  actions_to_reach_workshop = move_towards(env, target_workshop_pos)\n\n  # Step 4: Perform the USE action at the workshop to craft the item\n  use_action = [craft.CraftState.USE]\n\n  return actions_to_reach_workshop + use_action", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-10T06:47:57.450256", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index of the item to be crafted\n  item_idx = env.world.cookbook.index[item]\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes[item_idx]\n\n  # Collect all required ingredients in the recipe\n  for ingredient, count in recipe.items():\n    if ingredient == \"_key\":  # Skip the workshop key\n      continue\n\n    ingredient_idx = int(ingredient)\n    ingredient_name = env.world.cookbook.index.get(ingredient_idx)\n\n    # Check if we have enough of this ingredient in our inventory\n    while env._current_state.inventory[ingredient_idx] < count:\n      actions.extend(collect(env, ingredient_name))\n\n  # Move to the workshop and craft the item\n  workshop_key = recipe[\"_key\"]\n  workshop_idx = env.world.cookbook.index[workshop_key]\n  workshop_name = env.world.cookbook.index.get(workshop_idx)\n\n  actions.append(move_to_workshop(env, workshop_name))\n  actions.append(craft_item_at_workshop(env))\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-10T06:50:30.495400", "function_name": "craft", "function_body": "  def get_workshop_position(state, workshop_index):\n      workshop_indices = state.world.workshop_indices\n      if workshop_index >= len(workshop_indices):\n          return None\n      \n      for y in range(state.grid.shape[1]):\n          for x in range(state.grid.shape[0]):\n              if state.grid[x, y, workshop_indices[workshop_index]] == 1:\n                  return (x, y)\n      return None\n\n  def check_and_collect_primitives(state, recipe):\n      actions = []\n      for ingredient_idx, count in recipe.items():\n          while state.inventory[ingredient_idx] < count:\n              collect_actions = collect(env, state.world.cookbook.index.get(ingredient_idx))\n              if not collect_actions:\n                  return [], False  # Could not collect the required primitive\n              actions.extend(collect_actions)\n          \n          if state.inventory[ingredient_idx] < count:\n              return [], False  # Could not collect all required primitives\n      return actions, True\n\n  def move_to(state, target_position):\n      actions = []\n      # Simple BFS to find the path to the target position\n      queue = collections.deque([(state.pos, [])])\n      visited = set()\n      directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n      \n      while queue:\n          current_pos, path = queue.popleft()\n          \n          if current_pos == target_position:\n              return path\n          \n          if current_pos in visited:\n              continue\n          visited.add(current_pos)\n          \n          for dx, dy in directions:\n              next_x, next_y = current_pos[0] + dx, current_pos[1] + dy\n              \n              if (0 <= next_x < state.grid.shape[0]) and (0 <= next_y < state.grid.shape[1]):\n                  queue.append(((next_x, next_y), path + [move_to_direction(current_pos, (next_x, next_y))]))\n      \n      return []  # No path found\n\n  def move_to_direction(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n      \n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      else:\n          return 0  # DOWN\n\n  def verify_crafting(state, item_idx):\n      if state.inventory[item_idx] == 0:\n          return False  # Crafting failed\n      return True\n\n  actions = []\n  \n  # Get the index for the desired item from the cookbook\n  item_idx = env.world.cookbook.index[item]\n  \n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_idx, {})\n  \n  if not recipe:\n    return []  # No recipe found\n  \n  # Determine the workshop where the crafting should happen\n  workshop_key = \"_key\"\n  workshop_index = int(recipe.pop(workshop_key, -1))\n  \n  if workshop_index == -1:\n    return []  # Workshop not specified in the recipe\n\n  # Get the target position for the workshop\n  target_workshop_pos = get_workshop_position(env._current_state, workshop_index)\n  \n  if target_workshop_pos is None:\n    return []  # Workshop position not found in the grid\n\n  # Check and collect all required primitives\n  actions, success = check_and_collect_primitives(env._current_state, recipe)\n  \n  if not success:\n    return []  # Could not collect all required primitives\n  \n  # Move to the target workshop\n  actions.extend(move_to(env._current_state, target_workshop_pos))\n  \n  # Perform the USE action at the workshop\n  actions.append(4)  # USE action index\n\n  # Verify if item is crafted by checking inventory\n  if not verify_crafting(env._current_state, item_idx):\n    return []  # Crafting failed\n  \n  return actions", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T06:50:31.558065", "function_name": "craft", "function_body": "  def get_workshop_position(state, workshop_index):\n      workshop_indices = state.world.workshop_indices\n      if workshop_index >= len(workshop_indices):\n          return None\n      \n      for y in range(state.grid.shape[1]):\n          for x in range(state.grid.shape[0]):\n              if state.grid[x, y, workshop_indices[workshop_index]] == 1:\n                  return (x, y)\n      return None\n\n  def check_and_collect_primitives(env, recipe):\n      actions = []\n      for ingredient_idx, count in recipe.items():\n          while env._current_state.inventory[ingredient_idx] < count:\n              collect_actions = collect_v2(env, env.world.cookbook.index.get(ingredient_idx))\n              if not collect_actions:\n                  return [], False  # Could not collect the required primitive\n              actions.extend(collect_actions)\n          \n          if env._current_state.inventory[ingredient_idx] < count:\n              return [], False  # Could not collect all required primitives\n      return actions, True\n\n  def move_to(state, target_position):\n      actions = []\n      # Simple BFS to find the path to the target position\n      queue = collections.deque([(state.pos, [])])\n      visited = set()\n      directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n      \n      while queue:\n          current_pos, path = queue.popleft()\n          \n          if current_pos == target_position:\n              return path\n          \n          if current_pos in visited:\n              continue\n          visited.add(current_pos)\n          \n          for dx, dy in directions:\n              next_x, next_y = current_pos[0] + dx, current_pos[1] + dy\n              \n              if (0 <= next_x < state.grid.shape[0]) and (0 <= next_y < state.grid.shape[1]):\n                  queue.append(((next_x, next_y), path + [move_to_direction(current_pos, (next_x, next_y))]))\n      \n      return []  # No path found\n\n  def move_to_direction(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n      \n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      else:\n          return 0  # DOWN\n\n  actions = []\n  \n  # Get the index for the desired item from the cookbook\n  item_idx = env.world.cookbook.index[item]\n  \n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_idx, {})\n  \n  if not recipe:\n    return []  # No recipe found\n  \n  # Determine the workshop where the crafting should happen\n  workshop_key = \"_key\"\n  workshop_index = int(recipe.pop(workshop_key, -1))\n  \n  if workshop_index == -1:\n    return []  # Workshop not specified in the recipe\n\n  # Get the target position for the workshop\n  target_workshop_pos = get_workshop_position(env._current_state, workshop_index)\n  \n  if target_workshop_pos is None:\n    return []  # Workshop position not found in the grid\n\n  # Check and collect all required primitives\n  actions, success = check_and_collect_primitives(env, recipe)\n  \n  if not success:\n    return []  # Could not collect all required primitives\n  \n  # Move to the target workshop\n  actions.extend(move_to(env._current_state, target_workshop_pos))\n  \n  # Perform the USE action at the workshop\n  actions.append(4)  # USE action index\n\n  # Verify if item is crafted by checking inventory\n  if env._current_state.inventory[item_idx] == 0:\n    return []  # Crafting failed\n  \n  return actions", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T06:51:46.330746", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n\n  # Check if the desired item is a primitive; primitives cannot be crafted.\n  if item_index in env.world.cookbook.primitives:\n    return []\n\n  # Fetch the recipe for crafting the specified item.\n  recipe = env.world.cookbook.recipes.get(item_index)\n\n  # If no valid recipe exists or \"_key\" not specified, return an empty action list.\n  if not recipe or \"_key\" not in recipe:\n    return []\n\n  workshop_key = recipe[\"_key\"]\n  workshop_index = env.world.cookbook.index[workshop_key]\n\n  actions = []\n  # Check inventory for sufficient primitives.\n  missing_ingredients = {}\n  for ingredient, count in recipe.items():\n    if ingredient == \"_key\":\n      continue\n    ingredient_index = env.world.cookbook.index[ingredient]\n    current_count = env._current_state.inventory[ingredient_index]\n    if current_count < count:\n      missing_ingredients[ingredient] = count - current_count\n\n  # If any ingredients are missing, attempt to collect them.\n  for ingredient, required_count in missing_ingredients.items():\n    ingredient_index = env.world.cookbook.index[ingredient]\n    actions.extend(collect_v5(env, ingredient, required_count))\n\n  # Move to a workshop that can craft the item.\n  actions.extend(move_to_workshop(env, workshop_index))\n\n  # Use the USE action at the correct location.\n  actions.append(craft.ACTION_USE)\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T06:51:47.405515", "function_name": "craft", "function_body": "  def gather_ingredients(item):\n    nonlocal actions\n    recipe = env.world.cookbook.recipes.get(item)\n    if not recipe:\n      return\n\n    for ingredient, count in recipe.items():\n      if ingredient == \"_key\":\n        continue\n      ingredient_index = env.world.cookbook.index[ingredient]\n      current_count = env._current_state.inventory[ingredient_index]\n      if current_count < count:\n        actions.extend(collect_v4(env, ingredient, count - current_count))\n      elif ingredient_index in env.world.cookbook.recipes:\n        gather_ingredients(ingredient)\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the desired item is a primitive; primitives cannot be crafted.\n  if item_index in env.world.cookbook.primitives:\n    return []\n\n  # Fetch the recipe for crafting the specified item.\n  recipe = env.world.cookbook.recipes.get(item_index)\n\n  # If no valid recipe exists or \"_key\" not specified, return an empty action list.\n  if not recipe or \"_key\" not in recipe:\n    return []\n\n  actions = []\n  gather_ingredients(item)\n  \n  workshop_key = recipe[\"_key\"]\n  workshop_index = env.world.cookbook.index[workshop_key]\n\n  # Move to a workshop that can craft the item.\n  actions.extend(move_to_workshop(env, workshop_index))\n\n  # Use the USE action at the correct location.\n  actions.append(craft.ACTION_USE)\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T06:54:51.440544", "function_name": "craft", "function_body": "  def find_path(start, end, grid):\n    \"\"\"Find a path from start to end on the grid using BFS.\"\"\"\n    queue = collections.deque([(start, [])])\n    visited = set([start])\n    while queue:\n        (x, y), path = queue.popleft()\n        if (x, y) == end:\n            return path + [(x, y)]\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            nx, ny = x + dx, y + dy\n            if 0 <= nx < grid.shape[1] and 0 <= ny < grid.shape[0]:\n                if grid[ny, nx].sum() == 0 and (nx, ny) not in visited:\n                    queue.append(((nx, ny), path + [(x, y)]))\n                    visited.add((nx, ny))\n    return None\n\n  def move_towards(current_pos, target_pos):\n      \"\"\"Generate actions to move from current position to target position.\"\"\"\n      cx, cy = current_pos\n      tx, ty = target_pos\n      actions = []\n      \n      while (cx, cy) != (tx, ty):\n          if cx < tx:\n              actions.append(craft.CraftLab.ACTIONS['RIGHT'])\n              cx += 1\n          elif cx > tx:\n              actions.append(craft.CraftLab.ACTIONS['LEFT'])\n              cx -= 1\n          elif cy < ty:\n              actions.append(craft.CraftLab.ACTIONS['DOWN'])\n              cy += 1\n          else:\n              actions.append(craft.CraftLab.ACTIONS['UP'])\n              cy -= 1\n      \n      return actions\n\n  def face_direction(current_pos, target_pos):\n      \"\"\"Generate action to face the target position from current position.\"\"\"\n      cx, cy = current_pos\n      tx, ty = target_pos\n      \n      if tx > cx:\n          direction = craft.CraftLab.DIRECTIONS['RIGHT']\n      elif tx < cx:\n          direction = craft.CraftLab.DIRECTIONS['LEFT']\n      elif ty > cy:\n          direction = craft.CraftLab.DIRECTIONS['DOWN']\n      else:\n          direction = craft.CraftLab.DIRECTIONS['UP']\n      \n      return direction\n\n  def collect_primitive(env, primitive_index, count):\n    \"\"\"Generate actions to collect the required primitives.\"\"\"\n    grid = env._current_state.grid\n    positions = []\n    \n    for y in range(grid.shape[0]):\n        for x in range(grid.shape[1]):\n            if grid[y, x, primitive_index] == 1:\n                positions.append((x, y))\n                \n    actions = []\n    \n    for pos in positions[:count]:\n        path_to_primitive = find_path(env._current_state.pos, pos, grid)\n        \n        for p in path_to_primitive[:-1]:\n            actions.extend(move_towards(env._current_state.pos, p))\n            # Update the current state position after each move\n            env._current_state.pos = p\n        \n        # Turn to face the primitive\n        actions.append(face_direction(env._current_state.pos, pos))\n        \n        # Perform the USE action to collect the primitive\n        actions.append(craft.CraftLab.ACTIONS['USE'])\n    \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the primitives required to craft the desired item\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n  \n  actions = []\n  \n  for primitive_index, count in primitives_required.items():\n      if env._current_state.inventory[primitive_index] < count:\n          actions.extend(collect_primitive(env, primitive_index, count))\n      \n      # Check if we have collected enough primitives\n      if env._current_state.inventory[primitive_index] < count:\n          return []  # Return empty action list if any primitive is not sufficient\n  \n  workshop_index = None\n  \n  # Find out which workshop is needed for crafting the desired item\n  for output_item, recipe in env.world.cookbook.recipes.items():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n      workshop_index = recipe.get(\"_at\", None)\n      break\n\n  if workshop_index is None:\n    return []  # Return empty action list if no workshop found for the desired item\n\n  # Find the position of the workshop on the grid\n  workshop_position = None\n  for y in range(env._current_state.grid.shape[0]):\n    for x in range(env._current_state.grid.shape[1]):\n      if env._current_state.grid[y, x, workshop_index] == 1:\n        workshop_position = (x, y)\n        break\n    if workshop_position:\n      break\n\n  if workshop_position is None:\n    return []  # Return empty action list if the workshop position not found\n\n  # Generate actions to move to the workshop\n  path_to_workshop = find_path(env._current_state.pos, workshop_position, env._current_state.grid)\n  \n  for pos in path_to_workshop[:-1]:\n      actions.extend(move_towards(env._current_state.pos, pos))\n      # Update the current state position after each move\n      env._current_state.pos = pos\n\n  # Turn to face the workshop\n  actions.append(face_direction(env._current_state.pos, workshop_position))\n\n  # Perform the USE action to craft the item\n  actions.append(craft.CraftLab.ACTIONS['USE'])\n  \n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-10T06:54:52.589174", "function_name": "craft", "function_body": "  def find_path(start, end, grid):\n    \"\"\"Find a path from start to end on the grid using BFS.\"\"\"\n    queue = collections.deque([(start, [])])\n    visited = set([start])\n    while queue:\n        (x, y), path = queue.popleft()\n        if (x, y) == end:\n            return path + [(x, y)]\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            nx, ny = x + dx, y + dy\n            if 0 <= nx < grid.shape[1] and 0 <= ny < grid.shape[0]:\n                if grid[ny, nx].sum() == 0 and (nx, ny) not in visited:\n                    queue.append(((nx, ny), path + [(x, y)]))\n                    visited.add((nx, ny))\n    return None\n\n  def move_towards(current_pos, target_pos):\n      \"\"\"Generate actions to move from current position to target position.\"\"\"\n      cx, cy = current_pos\n      tx, ty = target_pos\n      actions = []\n      \n      while (cx, cy) != (tx, ty):\n          if cx < tx:\n              actions.append(craft.CraftLab.ACTIONS['RIGHT'])\n              cx += 1\n          elif cx > tx:\n              actions.append(craft.CraftLab.ACTIONS['LEFT'])\n              cx -= 1\n          elif cy < ty:\n              actions.append(craft.CraftLab.ACTIONS['DOWN'])\n              cy += 1\n          else:\n              actions.append(craft.CraftLab.ACTIONS['UP'])\n              cy -= 1\n      \n      return actions\n\n  def face_direction(current_pos, target_pos):\n      \"\"\"Generate action to face the target position from current position.\"\"\"\n      cx, cy = current_pos\n      tx, ty = target_pos\n      \n      if tx > cx:\n          direction = craft.CraftLab.ACTIONS['RIGHT']\n      elif tx < cx:\n          direction = craft.CraftLab.ACTIONS['LEFT']\n      elif ty > cy:\n          direction = craft.CraftLab.ACTIONS['DOWN']\n      else:\n          direction = craft.CraftLab.ACTIONS['UP']\n      \n      return direction\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the primitives required to craft the desired item\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n  \n  actions = []\n  \n  for primitive_index, count in primitives_required.items():\n    if env._current_state.inventory[primitive_index] < count:\n      return []  # Return empty action list if any primitive is not sufficient\n\n  workshop_index = None\n  \n  # Find out which workshop is needed for crafting the desired item\n  for output_item, recipe in env.world.cookbook.recipes.items():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n      workshop_index = recipe.get(\"_at\", None)\n      break\n\n  if workshop_index is None:\n    return []  # Return empty action list if no workshop found for the desired item\n\n  # Find the position of the workshop on the grid\n  workshop_position = None\n  for y in range(env._current_state.grid.shape[0]):\n    for x in range(env._current_state.grid.shape[1]):\n      if env._current_state.grid[y, x, workshop_index] == 1:\n        workshop_position = (x, y)\n        break\n    if workshop_position:\n      break\n\n  if workshop_position is None:\n    return []  # Return empty action list if the workshop position not found\n\n  # Generate actions to move to the workshop\n  path_to_workshop = find_path(env._current_state.pos, workshop_position, env._current_state.grid)\n  \n  for pos in path_to_workshop[:-1]:\n      actions.extend(move_towards(env._current_state.pos, pos))\n      # Update the current state position after each move\n      env._current_state.pos = pos\n\n  # Turn to face the workshop\n  actions.append(face_direction(env._current_state.pos, workshop_position))\n\n  # Perform the USE action to craft the item\n  actions.append(craft.CraftLab.ACTIONS['USE'])\n  \n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T06:56:39.266522", "function_name": "craft", "function_body": "  i_goal = env.world.cookbook.index[item]\n  \n  if i_goal not in env.world.cookbook.recipes:\n    raise ValueError(f\"No recipe found for {item}.\")\n    \n  actions = []\n  \n  # Check if we have all required primitives and intermediate items\n  required_primitives = env.world.cookbook.primitives_for(i_goal)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory)}\n\n  missing_items = []\n  for primitive, count_needed in required_primitives.items():\n    if inventory_dict.get(primitive, 0) < count_needed:\n      missing_items.append((primitive, count_needed - inventory_dict.get(primitive, 0)))\n\n  # If we have all required items proceed to craft\n  if not missing_items:\n    \n    # Get the nearest workshop of the specified type from the cookbook recipe key.\n    workshop_key = env.world.cookbook.recipes[i_goal][\"_key\"]\n    workshop_index = env.world.cookbook.index[workshop_key]\n\n    grid_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    \n    if not grid_positions.size:\n      return []  # No workshops found\n\n    closest_workshop_pos = min(grid_positions, key=lambda x: np.linalg.norm(np.array(x) - np.array(env._current_state.pos)))\n\n    # Move to the nearest workshop\n    move_actions = move_to_position(env, env._current_state.pos, closest_workshop_pos)\n    actions.extend(move_actions)\n\n    # Orient towards the workshop and use it\n    face_direction = face_towards_position(env, env._current_state.pos, closest_workshop_pos)\n    if face_direction:\n      actions.append(face_direction)\n    \n    actions.append(4)  # USE action\n\n  else:\n    # Handle the case where some items are missing.\n    for primitive, count_needed in missing_items:\n        required_count = inventory_dict.get(primitive, 0) + count_needed\n        collect_actions = collect(env, primitive, required_count - inventory_dict.get(primitive, 0))\n        actions.extend(collect_actions)\n    \n    # After collecting all the items, proceed to craft.\n    workshop_key = env.world.cookbook.recipes[i_goal][\"_key\"]\n    workshop_index = env.world.cookbook.index[workshop_key]\n\n    grid_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    \n    if not grid_positions.size:\n      return []  # No workshops found\n\n    closest_workshop_pos = min(grid_positions, key=lambda x: np.linalg.norm(np.array(x) - np.array(env._current_state.pos)))\n\n    # Move to the nearest workshop\n    move_actions = move_to_position(env, env._current_state.pos, closest_workshop_pos)\n    actions.extend(move_actions)\n\n    # Orient towards the workshop and use it\n    face_direction = face_towards_position(env, env._current_state.pos, closest_workshop_pos)\n    if face_direction:\n      actions.append(face_direction)\n    \n    actions.append(4)  # USE action\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-10T06:56:40.345434", "function_name": "craft", "function_body": "  i_goal = env.world.cookbook.index[item]\n  \n  if i_goal not in env.world.cookbook.recipes:\n    raise ValueError(f\"No recipe found for {item}.\")\n    \n  actions = []\n  \n  # Check if we have all required primitives and intermediate items\n  required_primitives = env.world.cookbook.primitives_for(i_goal)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory)}\n\n  # Check the availability of primitives\n  missing_items = []\n  for primitive, count_needed in required_primitives.items():\n    if inventory_dict.get(primitive, 0) < count_needed:\n      missing_items.append((primitive, count_needed - inventory_dict.get(primitive, 0)))\n\n  if missing_items:\n    return []  # Return empty list if any required item is missing\n\n  # Go to the workshop and craft the item\n  workshop_key = env.world.cookbook.recipes[i_goal][\"_key\"]\n  workshop_index = env.world.cookbook.index[workshop_key]\n  \n  # Find the position of the nearest workshop in the grid\n  grid_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if not grid_positions.size:\n    return []  # No workshops found\n\n  closest_workshop_pos = min(grid_positions, key=lambda x: np.linalg.norm(np.array(x) - np.array(env._current_state.pos)))\n\n  # Check if already at the workshop\n  if env._current_state.pos == tuple(closest_workshop_pos):\n    face_direction = face_towards_position(env, env._current_state.pos, closest_workshop_pos)\n    if face_direction:\n      actions.append(face_direction)\n    actions.append(4)  # USE action\n    return actions\n\n  # Move to the closest workshop\n  move_actions = move_to_position(env, env._current_state.pos, closest_workshop_pos)\n  actions.extend(move_actions)\n\n  # Orient towards the workshop and use it\n  face_direction = face_towards_position(env, env._current_state.pos, closest_workshop_pos)\n  if face_direction:\n    actions.append(face_direction)\n  \n  actions.append(4)  # USE action\n\n  return actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T06:59:48.238164", "function_name": "craft", "function_body": "  def find_path(start, end, grid):\n    queue = collections.deque([(start, [])])\n    visited = set([start])\n    \n    while queue:\n        (x, y), path = queue.popleft()\n        if (x, y) == end:\n            return path + [(x, y)]\n        \n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            nx, ny = x + dx, y + dy\n            if 0 <= nx < grid.shape[1] and 0 <= ny < grid.shape[0] and grid[ny, nx].sum() == 0 and (nx, ny) not in visited:\n                queue.append(((nx, ny), path + [(x, y)]))\n                visited.add((nx, ny))\n    \n    return None\n\n  def move_towards(current_pos, target_pos):\n      cx, cy = current_pos\n      tx, ty = target_pos\n      actions = []\n      \n      while (cx, cy) != (tx, ty):\n          if cx < tx:\n              actions.append(craft.CraftLab.ACTIONS['RIGHT'])\n              cx += 1\n          elif cx > tx:\n              actions.append(craft.CraftLab.ACTIONS['LEFT'])\n              cx -= 1\n          elif cy < ty:\n              actions.append(craft.CraftLab.ACTIONS['DOWN'])\n              cy += 1\n          else:\n              actions.append(craft.CraftLab.ACTIONS['UP'])\n              cy -= 1\n      \n      return actions\n\n  def face_direction(current_pos, target_pos):\n      cx, cy = current_pos\n      tx, ty = target_pos\n      actions = []\n\n      if tx > cx:\n          while env._current_state.direction != 'RIGHT':\n              actions.append(craft.CraftLab.ACTIONS['TURN_RIGHT'])\n              env._current_state.direction = ('LEFT' if env._current_state.direction == 'UP'\n                                            else 'DOWN' if env._current_state.direction == 'LEFT'\n                                            else 'UP')\n      elif tx < cx:\n          while env._current_state.direction != 'LEFT':\n              actions.append(craft.CraftLab.ACTIONS['TURN_LEFT'])\n              env._current_state.direction = ('RIGHT' if env._current_state.direction == 'UP'\n                                            else 'UP' if env._current_state.direction == 'LEFT'\n                                            else 'DOWN')\n      elif ty > cy:\n          while env._current_state.direction != 'DOWN':\n              actions.append(craft.CraftLab.ACTIONS['TURN_DOWN'])\n              env._current_state.direction = ('RIGHT' if env._current_state.direction == 'UP'\n                                            else 'LEFT' if env._current_state.direction == 'DOWN'\n                                            else 'UP')\n      else:\n          while env._current_state.direction != 'UP':\n              actions.append(craft.CraftLab.ACTIONS['TURN_UP'])\n              env._current_state.direction = ('RIGHT' if env._current_state.direction == 'DOWN'\n                                            else 'LEFT' if env._current_state.direction == 'UP'\n                                            else 'DOWN')\n\n      return actions\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the primitives required to craft the desired item\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n  \n  actions = []\n  \n  for primitive_index, count in primitives_required.items():\n    if env._current_state.inventory[primitive_index] < count:\n      return []  # Return empty action list if any primitive is not sufficient\n\n  workshop_index = None\n  \n  # Find out which workshop is needed for crafting the desired item\n  for output_item, recipe in env.world.cookbook.recipes.items():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n      workshop_index = recipe.get(\"_at\", None)\n      break\n\n  if workshop_index is None:\n    return []  # Return empty action list if no workshop found for the desired item\n\n  # Find the position of the workshop on the grid\n  workshop_position = None\n  for y in range(env._current_state.grid.shape[0]):\n    for x in range(env._current_state.grid.shape[1]):\n      if env._current_state.grid[y, x, workshop_index] == 1:\n        workshop_position = (x, y)\n        break\n    if workshop_position:\n      break\n\n  if workshop_position is None:\n    return []  # Return empty action list if the workshop position not found\n\n  # Generate actions to move to the workshop\n  path_to_workshop = find_path(env._current_state.pos, workshop_position, env._current_state.grid)\n  \n  for pos in path_to_workshop[:-1]:\n      actions.extend(move_towards(env._current_state.pos, pos))\n      # Update the current state position after each move\n      env._current_state.pos = pos\n\n  # Turn to face the workshop\n  actions.extend(face_direction(env._current_state.pos, workshop_position))\n\n  # Perform the USE action to craft the item\n  actions.append(craft.CraftLab.ACTIONS['USE'])\n  \n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T06:59:49.386589", "function_name": "craft", "function_body": "  def find_path(start, end, grid):\n    queue = collections.deque([(start, [])])\n    visited = set([start])\n    while queue:\n        (x, y), path = queue.popleft()\n        if (x, y) == end:\n            return path + [(x, y)]\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            nx, ny = x + dx, y + dy\n            if 0 <= nx < grid.shape[1] and 0 <= ny < grid.shape[0] and grid[ny, nx].sum() == 0 and (nx, ny) not in visited:\n                queue.append(((nx, ny), path + [(x, y)]))\n                visited.add((nx, ny))\n    return None\n\n  def move_towards(current_pos, target_pos):\n      cx, cy = current_pos\n      tx, ty = target_pos\n      actions = []\n      while (cx, cy) != (tx, ty):\n          if cx < tx:\n              actions.append(craft.CraftLab.ACTIONS['RIGHT'])\n              cx += 1\n          elif cx > tx:\n              actions.append(craft.CraftLab.ACTIONS['LEFT'])\n              cx -= 1\n          elif cy < ty:\n              actions.append(craft.CraftLab.ACTIONS['DOWN'])\n              cy += 1\n          else:\n              actions.append(craft.CraftLab.ACTIONS['UP'])\n              cy -= 1\n      return actions\n\n  def face_direction(current_pos, target_pos):\n      cx, cy = current_pos\n      tx, ty = target_pos\n      \n      # Calculate the direction needed to face the target position\n      dx, dy = tx - cx, ty - cy\n      \n      if abs(dx) > abs(dy):  # Horizontal move is more significant\n          if dx > 0:\n              return craft.CraftLab.ACTIONS['RIGHT']\n          else:\n              return craft.CraftLab.ACTIONS['LEFT']\n      else:  # Vertical move is more significant or equal\n          if dy > 0:\n              return craft.CraftLab.ACTIONS['DOWN']\n          else:\n              return craft.CraftLab.ACTIONS['UP']\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the primitives required to craft the desired item\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n  \n  actions = []\n  \n  for primitive_index, count in primitives_required.items():\n    if env._current_state.inventory[primitive_index] < count:\n      return []  # Return empty action list if any primitive is not sufficient\n\n  workshop_index = None\n  \n  # Find out which workshop is needed for crafting the desired item\n  for output_item, recipe in env.world.cookbook.recipes.items():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n      workshop_index = recipe.get(\"_at\", None)\n      break\n\n  if workshop_index is None:\n    return []  # Return empty action list if no workshop found for the desired item\n\n  # Find the position of the workshop on the grid\n  workshop_position = None\n  for y in range(env._current_state.grid.shape[0]):\n    for x in range(env._current_state.grid.shape[1]):\n      if env._current_state.grid[y, x, workshop_index] == 1:\n        workshop_position = (x, y)\n        break\n    if workshop_position:\n      break\n\n  if workshop_position is None:\n    return []  # Return empty action list if the workshop position not found\n\n  # Generate actions to move to the workshop\n  path_to_workshop = find_path(env._current_state.pos, workshop_position, env._current_state.grid)\n  \n  for pos in path_to_workshop[:-1]:\n      actions.extend(move_towards(env._current_state.pos, pos))\n      # Update the current state position after each move\n      env._current_state.pos = pos\n\n  # Turn to face the workshop\n  actions.append(face_direction(env._current_state.pos, workshop_position))\n\n  # Perform the USE action to craft the item\n  actions.append(craft.CraftLab.ACTIONS['USE'])\n  \n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T07:03:44.614738", "function_name": "craft", "function_body": "  def move_to_position(pos: tuple, target_pos: tuple):\n    \"\"\"\n      Returns a series of movement actions to navigate from pos to target_pos.\n      \n      Args:\n        pos (tuple): Current position (x, y).\n        target_pos (tuple): Target position (x, y).\n\n      Returns:\n        List[int]: Movement actions to reach the target position.\n    \"\"\"\n    x, y = pos\n    tx, ty = target_pos\n    actions = []\n    \n    # Calculate the difference in coordinates\n    dx = tx - x\n    dy = ty - y\n\n    # Determine movement direction based on coordinate differences\n    if dx > 0:\n      actions.extend([craft.ACTION_RIGHT] * abs(dx))\n    elif dx < 0:\n      actions.extend([craft.ACTION_LEFT] * abs(dx))\n\n    if dy > 0:\n      actions.extend([craft.ACTION_UP] * abs(dy))\n    elif dy < 0:\n      actions.extend([craft.ACTION_DOWN] * abs(dy))\n    \n    return actions\n\n  def move_to_workshop(state, workshop_index):\n    pos = state.pos\n    grid = state.grid\n\n    # Find the closest workshop in the grid.\n    workshops = [(x, y) for x in range(grid.shape[0]) \n                 for y in range(grid.shape[1]) if grid[x, y, workshop_index] > 0]\n    if not workshops:\n      return []\n\n    # Choose the nearest workshop.\n    target_x, target_y = min(workshops, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n    \n    # Move to the position adjacent to the workshop for use action\n    adjacent_positions = [(target_x-1, target_y), (target_x+1, target_y),\n                          (target_x, target_y-1), (target_x, target_y+1)]\n    reachable_adjacent = [p for p in adjacent_positions if 0 <= p[0] < grid.shape[0] and 0 <= p[1] < grid.shape[1]]\n    \n    # Find the closest reachable adjacent position\n    target_adjacent_pos = min(reachable_adjacent, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n    \n    return move_to_position(pos, target_adjacent_pos)\n\n  def collect_v4(env, primitive, required_count):\n    \"\"\"Collects the specified number of primitives.\n    \n      Args:\n        env (env.CraftLab): The CraftLab environment instance.\n        primitive (str): The name of the primitive to collect.\n        required_count (int): The count of the primitive needed.\n\n      Returns:\n        List[int]: A list of actions to collect the required primitives.\n    \"\"\"\n    state = env._current_state\n    primitive_index = env.world.cookbook.index[primitive]\n    actions = []\n    \n    while np.sum(state.grid[:, :, primitive_index]) < required_count:\n      # Find all positions of the primitive in the grid.\n      primitive_positions = [(x, y) for x in range(state.grid.shape[0]) \n                             for y in range(state.grid.shape[1]) if state.grid[x, y, primitive_index] > 0]\n      \n      if not primitive_positions:\n        break\n      \n      # Choose the nearest primitive to collect.\n      target_x, target_y = min(primitive_positions, key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))\n      \n      # Move to and collect the primitive\n      actions.extend(move_to_position(state.pos, (target_x, target_y)))\n      actions.append(craft.ACTION_USE)\n      \n      # Update state after each collection.\n      _, state = env._current_state.step(craft.ACTION_USE)\n    \n    return actions\n\n  def get_required_primitives(recipe):\n    \"\"\"\n      Returns a list of primitives required for the recipe.\n      \n      Args:\n        recipe (dict): The crafting recipe.\n\n      Returns:\n        List[tuple]: A list of tuples where each tuple contains the primitive name and count.\n    \"\"\"\n    required_primitives = []\n    for ingredient, count in recipe.items():\n        if ingredient == \"_key\":\n            continue\n        required_primitives.append((ingredient, count))\n    return required_primitives\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the desired item is a primitive; primitives cannot be crafted.\n  if item_index in env.world.cookbook.primitives:\n    return []\n\n  # Fetch the recipe for crafting the specified item.\n  recipe = env.world.cookbook.recipes.get(item_index)\n\n  # If no valid recipe exists or \"_key\" not specified, return an empty action list.\n  if not recipe or \"_key\" not in recipe:\n    return []\n\n  workshop_key = recipe[\"_key\"]\n  workshop_index = env.world.cookbook.index[workshop_key]\n\n  actions = []\n  state = env._current_state\n  required_primitives = get_required_primitives(recipe)\n\n  # If any ingredients are missing, attempt to collect them.\n  for primitive, required_count in required_primitives:\n    ingredient_index = env.world.cookbook.index[primitive]\n    current_count = state.inventory[ingredient_index]\n    \n    if current_count < required_count:\n      actions.extend(collect_v4(env, primitive, required_count - current_count))\n\n  # Move to a workshop that can craft the item.\n  actions.extend(move_to_workshop(state, workshop_index))\n  \n  # Use the USE action at the correct location (adjacent to the workshop).\n  actions.append(craft.ACTION_USE)\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T07:03:45.713742", "function_name": "craft", "function_body": "  def move_to_position(pos: tuple, target_pos: tuple):\n    \"\"\"\n      Returns a series of movement actions to navigate from pos to target_pos.\n      \n      Args:\n        pos (tuple): Current position (x, y).\n        target_pos (tuple): Target position (x, y).\n\n      Returns:\n        List[int]: Movement actions to reach the target position.\n    \"\"\"\n    x, y = pos\n    tx, ty = target_pos\n    actions = []\n    \n    # Calculate the difference in coordinates\n    dx = tx - x\n    dy = ty - y\n\n    # Determine movement direction based on coordinate differences\n    if dx > 0:\n      actions.extend([craft.ACTION_RIGHT] * abs(dx))\n    elif dx < 0:\n      actions.extend([craft.ACTION_LEFT] * abs(dx))\n\n    if dy > 0:\n      actions.extend([craft.ACTION_UP] * abs(dy))\n    elif dy < 0:\n      actions.extend([craft.ACTION_DOWN] * abs(dy))\n    \n    return actions\n\n  def move_to_workshop(state, workshop_index):\n    pos = state.pos\n    grid = state.grid\n\n    # Find the closest workshop in the grid.\n    workshops = [(x, y) for x in range(grid.shape[0]) \n                 for y in range(grid.shape[1]) if grid[x, y, workshop_index] > 0]\n    if not workshops:\n      return []\n\n    # Choose the nearest workshop.\n    target_x, target_y = min(workshops, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n    \n    # Move to the position adjacent to the workshop for use action\n    adjacent_positions = [(target_x-1, target_y), (target_x+1, target_y),\n                          (target_x, target_y-1), (target_x, target_y+1)]\n    reachable_adjacent = [p for p in adjacent_positions if 0 <= p[0] < grid.shape[0] and 0 <= p[1] < grid.shape[1]]\n    \n    # Find the closest reachable adjacent position\n    target_adjacent_pos = min(reachable_adjacent, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n    \n    return move_to_position(pos, target_adjacent_pos)\n\n  def collect_v4(env, primitive, required_count):\n    \"\"\"Collects the specified number of primitives.\n    \n      Args:\n        env (env.CraftLab): The CraftLab environment instance.\n        primitive (str): The name of the primitive to collect.\n        required_count (int): The count of the primitive needed.\n\n      Returns:\n        List[int]: A list of actions to collect the required primitives.\n    \"\"\"\n    state = env._current_state\n    primitive_index = env.world.cookbook.index[primitive]\n    actions = []\n    \n    while np.sum(state.grid[:, :, primitive_index]) < required_count:\n      # Find all positions of the primitive in the grid.\n      primitive_positions = [(x, y) for x in range(state.grid.shape[0]) \n                             for y in range(state.grid.shape[1]) if state.grid[x, y, primitive_index] > 0]\n      \n      if not primitive_positions:\n        break\n      \n      # Choose the nearest primitive to collect.\n      target_x, target_y = min(primitive_positions, key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))\n      \n      # Move to and collect the primitive\n      actions.extend(move_to_position(state.pos, (target_x, target_y)))\n      actions.append(craft.ACTION_USE)\n      \n      # Update state after each collection.\n      _, state = env._current_state.step(craft.ACTION_USE)\n    \n    return actions\n\n  def check_inventory_and_collect_missing_primitives(env, recipe):\n    \"\"\"Checks the inventory for required primitives and collects any missing ones.\n    \n      Args:\n        env (env.CraftLab): The CraftLab environment instance.\n        recipe (dict): Recipe dictionary containing ingredients and their counts.\n\n      Returns:\n        List[int]: A list of actions to collect missing primitives.\n    \"\"\"\n    state = env._current_state\n    actions = []\n    for ingredient, count in recipe.items():\n      if ingredient == \"_key\":\n        continue\n      ingredient_index = env.world.cookbook.index[ingredient]\n      current_count = state.inventory[ingredient_index]\n      required_count = count\n      missing_count = required_count - current_count\n\n      # If any ingredients are missing, attempt to collect them.\n      if missing_count > 0:\n        actions.extend(collect_v4(env, ingredient, missing_count))\n    \n    return actions\n\n  def find_closest_workshop(state, workshop_index):\n    \"\"\"Finds the closest workshop that can craft the item.\n    \n      Args:\n        state (craft.CraftState): Current CraftState instance.\n        workshop_index (int): Index of the required workshop.\n\n      Returns:\n        Tuple[int, int]: Coordinates of the closest reachable adjacent position to the workshop.\n    \"\"\"\n    pos = state.pos\n    grid = state.grid\n\n    # Find all workshops in the grid.\n    workshops = [(x, y) for x in range(grid.shape[0]) \n                 for y in range(grid.shape[1]) if grid[x, y, workshop_index] > 0]\n    \n    if not workshops:\n      return None\n    \n    # Choose the nearest workshop.\n    target_x, target_y = min(workshops, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n    \n    # Find adjacent positions to the workshop\n    adjacent_positions = [(target_x-1, target_y), (target_x+1, target_y),\n                          (target_x, target_y-1), (target_x, target_y+1)]\n    reachable_adjacent = [p for p in adjacent_positions if 0 <= p[0] < grid.shape[0] and 0 <= p[1] < grid.shape[1]]\n    \n    # Find the closest reachable adjacent position\n    target_adjacent_pos = min(reachable_adjacent, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n    \n    return target_adjacent_pos\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the desired item is a primitive; primitives cannot be crafted.\n  if item_index in env.world.cookbook.primitives:\n    return []\n\n  # Fetch the recipe for crafting the specified item.\n  recipe = env.world.cookbook.recipes.get(item_index)\n\n  # If no valid recipe exists or \"_key\" not specified, return an empty action list.\n  if not recipe or \"_key\" not in recipe:\n    return []\n\n  workshop_key = recipe[\"_key\"]\n  workshop_index = env.world.cookbook.index[workshop_key]\n\n  actions = []\n  state = env._current_state\n\n  # Check inventory for sufficient primitives and collect missing ones.\n  actions.extend(check_inventory_and_collect_missing_primitives(env, recipe))\n\n  # Find the closest reachable adjacent position to the nearest workshop.\n  target_adjacent_pos = find_closest_workshop(state, workshop_index)\n  \n  if not target_adjacent_pos:\n    return []\n\n  # Move to the adjacent position of the workshop.\n  actions.extend(move_to_position(state.pos, target_adjacent_pos))\n  \n  # Use the USE action at the correct location (adjacent to the workshop).\n  actions.append(craft.ACTION_USE)\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T07:04:45.605347", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  current_inventory = {env.world.cookbook.index.get(i): env._current_state.inventory[i] for i in range(len(env._current_state.inventory))}\n\n  actions = []\n\n  # Check if we have all the primitives required\n  for primitive, count in required_primitives.items():\n    if current_inventory.get(primitive, 0) < count:\n      return []  # Return empty list as we do not have enough primitives\n\n  # Determine which workshop to use and navigate there\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_required = None\n  for key in recipe.keys():\n    if \"_at\" in key:\n      workshop_required = key.split(\"_at\")[1].strip()\n      break\n\n  if not workshop_required:\n    return []  # No valid workshop found in the recipe\n\n  # Find the position of the required workshop in the grid\n  workshop_index = env.world.cookbook.index[workshop_required]\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n  if not workshop_positions.size:\n    return []  # No valid workshop found on the grid\n\n  target_workshop_position = tuple(workshop_positions[0])\n\n  # Navigate to the workshop\n  actions.extend(navigate_to(env, target_workshop_position))\n\n  # Turn to face the workshop (assuming we can determine the direction needed)\n  facing_direction = determine_facing_direction(env._current_state.pos, target_workshop_position)\n  if facing_direction is not None:\n    actions.append(facing_direction)\n\n  # Perform USE action to craft the item\n  actions.append(craft.ACTION_USE)\n\n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T07:04:46.679487", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  current_inventory = {env.world.cookbook.index.get(i): env._current_state.inventory[i] for i in range(len(env._current_state.inventory))}\n\n  actions = []\n\n  # Check if we have all the primitives required\n  for primitive, count in required_primitives.items():\n    if current_inventory.get(primitive, 0) < count:\n      return []  # Return empty list as we do not have enough primitives\n\n  # Determine which workshop to use and navigate there\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_required = None\n  for key in recipe.keys():\n    if \"_at\" in key:\n      workshop_required = key.split(\"_at\")[1].strip()\n      break\n\n  if not workshop_required:\n    return []  # No valid workshop found in the recipe\n\n  # Find the position of the required workshop in the grid\n  workshop_index = env.world.cookbook.index[workshop_required]\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n  if not workshop_positions.size:\n    return []  # No valid workshop found on the grid\n\n  target_workshop_position = tuple(workshop_positions[0])\n\n  # Navigate to the workshop\n  actions.extend(navigate_to(env, target_workshop_position))\n\n  # Turn to face the workshop (assuming we can determine the direction needed)\n  facing_direction = determine_facing_direction(env._current_state.pos, target_workshop_position)\n  if facing_direction is not None:\n    actions.append(facing_direction)\n\n  # Perform USE action to craft the item\n  actions.append(craft.ACTION_USE)\n\n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T07:05:45.339255", "function_name": "craft", "function_body": "  # Get the cookbook and find the index of the desired item\n  cookbook = env.world.cookbook\n  item_index = cookbook.index(item)\n  \n  # Check if the recipe for the item exists\n  if item_index not in cookbook.recipes:\n    print(f\"No recipe found for {item}.\")\n    return []\n\n  # Get the ingredients required to craft the item\n  ingredients = cookbook.recipes[item_index]\n  \n  actions = []\n  \n  # Collect all the primitives needed to craft the item\n  for ingredient, count in ingredients.items():\n      if ingredient != \"_key\":  # Skip the _key which indicates the workshop index\n          primitive_name = cookbook.get(ingredient)\n          required_count = count\n          while env._current_state.inventory[ingredient] < required_count:\n              actions.extend(collect(env, primitive_name))\n  \n  # Move to the correct workshop and craft the item\n  workshop_index = int(ingredients[\"_key\"])\n  workshop_location = find_workshop_location(env.world.workshop_indices[workshop_index], env)\n  \n  if not workshop_location:\n      print(\"Workshop location not found.\")\n      return []\n\n  actions.extend(move_to(env, workshop_location))\n  actions.append(craft.USE)  # Use the action to craft the item\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-10T07:05:46.299389", "function_name": "craft", "function_body": "  actions = []\n\n  # Get the index for the item we want to craft\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the recipe for the item\n  if item_index not in env.world.cookbook.recipes:\n      return []  # No recipe found for this item\n  \n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Check if all required primitives are available in inventory\n  required_primitives = {i: count for i, count in recipe.items() if i != \"_at\"}\n  available_in_inventory = {i: env._current_state.inventory[i] for i in required_primitives}\n\n  # Calculate the difference between required and available\n  missing_primitives = {i: max(0, required - available) for i, (required, available) in zip(required_primitives.keys(), zip(required_primitives.values(), available_in_inventory.values()))}\n  \n  if any(missing_primitives.values()):\n      return []  # Not all primitives are available\n\n  # Get the workshop index\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n  workshop_pos = None\n  \n  for y in range(env._current_state.grid.shape[0]):\n      for x in range(env._current_state.grid.shape[1]):\n          if env._current_state.grid[y, x, workshop_index] == 1:\n              workshop_pos = (x, y)\n              break\n      if workshop_pos is not None:\n          break\n  \n  if workshop_pos is None:\n      return []  # Workshop not found on the grid\n\n  # Get current position and direction of the agent\n  current_pos = env._current_state.pos\n  current_dir = env._current_state.dir\n\n  # Calculate actions to move to the workshop\n  # Simple pathfinding (BFS) can be used here, but for simplicity we will use a direct movement towards the workshop\n  x_diff = workshop_pos[0] - current_pos[0]\n  y_diff = workshop_pos[1] - current_pos[1]\n\n  if x_diff > 0:\n      actions.extend([env.world.N_RIGHT] * abs(x_diff))\n  elif x_diff < 0:\n      actions.extend([env.world.N_LEFT] * abs(x_diff))\n\n  if y_diff > 0:\n      actions.extend([env.world.N_DOWN] * abs(y_diff))\n  elif y_diff < 0:\n      actions.extend([env.world.N_UP] * abs(y_diff))\n\n  # After reaching the workshop, turn to face it and perform USE action\n  target_dir = np.arctan2(workshop_pos[1] - current_pos[1], workshop_pos[0] - current_pos[0]) * (4 / (2 * np.pi)) % 4\n  while current_dir != target_dir:\n      actions.append(env.world.N_TURN)\n      current_dir = (current_dir + 1) % 4\n\n  # Use action to craft the item at the workshop\n  actions.append(env.world.N_USE)\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-10T07:07:42.631776", "function_name": "craft", "function_body": "  def find_workshop_for_item(item_idx):\n      for recipe in env.world.cookbook.recipes.values():\n          if \"_key\" in recipe and recipe[\"_key\"] == item_idx:\n              return recipe.get(\"_at\", None)\n      return None\n\n  def get_primitive_counts(primitive_indices, inventory):\n      return {i: inventory[i] for i in primitive_indices}\n\n  def collect_primitives(primitive_indices, required_counts):\n      actions = []\n      current_inventory = env._current_state.inventory.copy()\n      for i in primitive_indices:\n          while current_inventory[i] < required_counts[i]:\n              primitive_name = env.world.cookbook.index.get(i)\n              additional_actions = collect(env, primitive_name)\n              actions.extend(additional_actions)\n              \n              # Update the current inventory after collecting primitives\n              for action in additional_actions:\n                  _, _, observations = env.step(action)  # Execute each action and update state\n                  current_inventory = observations['inventory']\n      return actions\n\n  def find_closest_workshop(env, workshop_idx):\n      directions = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n      queue = collections.deque([(env._current_state.pos, [])])\n      visited = set()\n      \n      while queue:\n          (x, y), path = queue.popleft()\n          if env._current_state.grid[x, y, workshop_idx] > 0 and env._current_state.next_to(workshop_idx):\n              return x, y\n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n                  if (nx, ny) not in visited and env._current_state.grid[nx, ny].sum() == 0:\n                      visited.add((nx, ny))\n                      queue.append(((nx, ny), path + [(dx, dy)]))\n      return None\n\n  def navigate_to_position(position):\n      target_x, target_y = position\n      start_x, start_y = env._current_state.pos\n      \n      actions = []\n      while start_x != target_x or start_y != target_y:\n          if start_x < target_x:\n              actions.append(env.ACTIONS.index(\"DOWN\"))\n          elif start_x > target_x:\n              actions.append(env.ACTIONS.index(\"UP\"))\n          if start_y < target_y:\n              actions.append(env.ACTIONS.index(\"RIGHT\"))\n          elif start_y > target_y:\n              actions.append(env.ACTIONS.index(\"LEFT\"))\n          \n          # Update position based on current state\n          next_action = choose_best_direction((start_x, start_y), (target_x, target_y))\n          actions.append(next_action)\n      return [env.ACTIONS.index(d) for d in actions]  # Map direction names to action indices\n\n  def choose_best_direction(start_pos, target_pos):\n      directions = {\n          (0, 1): \"RIGHT\",\n          (0, -1): \"LEFT\",\n          (1, 0): \"DOWN\",\n          (-1, 0): \"UP\"\n      }\n      \n      start_x, start_y = start_pos\n      target_x, target_y = target_pos\n      \n      dx = np.sign(target_x - start_x)\n      dy = np.sign(target_y - start_y)\n      \n      return directions.get((dx, dy), None)\n\n  def use_action():\n      return env.ACTIONS.index(\"USE\")\n\n  # Get the index of the item to craft\n  item_idx = env.world.cookbook.index[item]\n  \n  # Check if we have a recipe for this item\n  if item_idx not in env.world.cookbook.recipes:\n    return []\n  \n  # Get the ingredients required and their counts\n  ingredients = {k: v for k, v in env.world.cookbook.recipes[item_idx].items() if k != \"_at\"}\n  \n  # Find the workshop for crafting the item\n  workshop_name = find_workshop_for_item(item_idx)\n  if workshop_name is None:\n    return []\n  \n  # Find the index of the workshop in the environment\n  workshop_idx = env.world.workshop_indices[workshop_name]\n  \n  # Collect primitives required for crafting\n  actions = collect_primitives(list(ingredients.keys()), ingredients)\n  \n  # Navigate to the workshop and perform USE action\n  workshop_pos = find_closest_workshop(env, workshop_idx)\n  if not workshop_pos:\n    return []\n  \n  actions.extend(navigate_to_position(workshop_pos))\n  actions.append(use_action())\n  \n  return actions", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T07:07:43.729264", "function_name": "craft", "function_body": "  def find_workshop_for_item(item_idx):\n      for recipe in env.world.cookbook.recipes.values():\n          if \"_key\" in recipe and recipe[\"_key\"] == item_idx:\n              return recipe.get(\"_at\", None)\n      return None\n\n  def get_primitive_counts(primitive_indices, inventory):\n      return {i: inventory[i] for i in primitive_indices}\n\n  def collect_primitives(primitive_indices, required_counts):\n      actions = []\n      for i in primitive_indices:\n          while env._current_state.inventory[i] < required_counts[i]:\n              primitive_name = env.world.cookbook.index.get(i)\n              actions.extend(collect(env, primitive_name))\n      return actions\n\n  def find_closest_workshop(env, workshop_idx):\n      directions = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n      queue = collections.deque([(env._current_state.pos, [])])\n      visited = set()\n      \n      while queue:\n          (x, y), path = queue.popleft()\n          if env._current_state.grid[x, y, workshop_idx] > 0 and env._current_state.next_to(workshop_idx):\n              return x, y\n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n                  if (nx, ny) not in visited and env._current_state.grid[nx, ny].sum() == 0:\n                      visited.add((nx, ny))\n                      queue.append(((nx, ny), path + [(dx, dy)]))\n      return None\n\n  def navigate_to_position(position):\n      target_x, target_y = position\n      start_x, start_y = env._current_state.pos\n      \n      actions = []\n      while start_x != target_x or start_y != target_y:\n          dx = np.sign(target_x - start_x)\n          dy = np.sign(target_y - start_y)\n          \n          if dx == 1:\n              actions.append(env.ACTIONS.index(\"DOWN\"))\n          elif dx == -1:\n              actions.append(env.ACTIONS.index(\"UP\"))\n          if dy == 1:\n              actions.append(env.ACTIONS.index(\"RIGHT\"))\n          elif dy == -1:\n              actions.append(env.ACTIONS.index(\"LEFT\"))\n          \n          start_x += dx\n          start_y += dy\n      \n      return actions\n\n  def use_action():\n      return env.ACTIONS.index(\"USE\")\n\n  # Get the index of the item to craft\n  item_idx = env.world.cookbook.index[item]\n  \n  # Check if we have a recipe for this item\n  if item_idx not in env.world.cookbook.recipes:\n      return []\n  \n  # Get the ingredients required and their counts\n  ingredients = {k: v for k, v in env.world.cookbook.recipes[item_idx].items() if k != \"_at\"}\n  \n  # Find the workshop for crafting the item\n  workshop_name = find_workshop_for_item(item_idx)\n  if workshop_name is None:\n      return []\n  \n  # Find the index of the workshop in the environment\n  workshop_idx = env.world.workshop_indices[workshop_name]\n  \n  # Collect primitives required for crafting\n  actions = collect_primitives(list(ingredients.keys()), ingredients)\n  \n  # Navigate to the workshop and perform USE action\n  workshop_pos = find_closest_workshop(env, workshop_idx)\n  if not workshop_pos:\n      return []\n  \n  actions.extend(navigate_to_position(workshop_pos))\n  actions.append(use_action())\n  \n  return actions", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T07:08:25.669716", "function_name": "craft", "function_body": "  # Convert item name to index using the cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Get required primitives for crafting the item\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  \n  # Initialize actions list\n  actions = []\n  \n  # Check if we have all the required primitives in inventory\n  for primitive_index, count in required_primitives.items():\n    primitive_name = env.world.cookbook.index.get(primitive_index)\n    while env._current_state.inventory[primitive_index] < count:\n      # Collect the required primitive\n      collect_actions = collect(env, primitive_name)\n      actions.extend(collect_actions)\n      \n      # Check if collection was successful (not empty action list)\n      if not collect_actions:\n        return []\n  \n  # If we have all required primitives, proceed to craft the item\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_index = recipe[\"_at\"]\n  workshop_name = env.world.cookbook.index.get(workshop_index)\n\n  # Find position of the required workshop in the grid\n  workshop_pos = find_workshop_position(env._current_state.grid, workshop_index)\n  \n  if not workshop_pos:\n    return []\n\n  # Move to the required workshop\n  move_actions = move_to(env._current_state, workshop_pos[0], workshop_pos[1])\n  actions.extend(move_actions)\n\n  # Turn to face the workshop and perform USE action to craft item\n  face_workshop_action = face_direction(env._current_state, workshop_pos)\n  use_action = env.world.cookbook.index[\"USE\"]\n  \n  actions.append(face_workshop_action)\n  actions.append(use_action)\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-10T07:08:26.646861", "function_name": "craft", "function_body": "  # Get the index of the item from the cookbook\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the ingredients required to craft the item\n  required_ingredients = env.world.cookbook.primitives_for(item_index)\n\n  actions = []\n\n  # Collect primitives first\n  for primitive, count in required_ingredients.items():\n    while env._current_state.inventory[primitive] < count:\n      collect_actions = collect_v2(env, env.world.cookbook.index.get(primitive))\n      actions.extend(collect_actions)\n      \n  # Now craft the item at the correct workshop\n  recipe = env.world.cookbook.recipes[item_index]\n  \n  if \"_at\" in recipe:\n    workshop_name = recipe[\"_at\"]\n    workshop_index = env.world.workshop_indices[env.world.cookbook.index[workshop_name]]\n    \n    # Find the position of the nearest workshop\n    nearest_workshop_pos = find_nearest(env, workshop_index)\n    actions.extend(move_to(env, nearest_workshop_pos))\n    \n    # Face the workshop and use it to craft the item\n    face_actions = face_towards(env, workshop_index)\n    actions.extend(face_actions)\n    actions.append(env.world.cookbook.index[\"USE\"])\n  \n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-10T07:09:14.475281", "function_name": "craft", "function_body": "  # Retrieve the index for the desired crafted item.\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item is a primitive. Primitives cannot be crafted, so return an empty action list.\n  if item_index in env.world.cookbook.primitives:\n    return []\n\n  # Fetch the recipe for the specified item from the cookbook.\n  recipe = env.world.cookbook.recipes.get(item_index)\n\n  # If there's no valid recipe or \"_key\" isn't specified, return an empty action list.\n  if not recipe or \"_key\" not in recipe:\n    return []\n\n  # Determine the workshop key and its corresponding index from the recipe.\n  workshop_key = recipe[\"_key\"]\n  workshop_index = env.world.cookbook.index[workshop_key]\n\n  actions = []\n  \n  # Identify missing ingredients by comparing current inventory against the recipe.\n  missing_ingredients = {}\n  for ingredient, count in recipe.items():\n    if ingredient == \"_key\":\n      continue\n    ingredient_index = env.world.cookbook.index[ingredient]\n    current_count = env._current_state.inventory[ingredient_index]\n    if current_count < count:\n      missing_ingredients[ingredient] = count - current_count\n\n  # Collect any required ingredients that are not in the inventory.\n  for ingredient, required_count in missing_ingredients.items():\n    ingredient_index = env.world.cookbook.index[ingredient]\n    actions.extend(collect_v3(env, ingredient, required_count))\n\n  # Move towards a workshop specified in the recipe.\n  actions.extend(move_to_workshop(env, workshop_index))\n  \n  # Align correctly before using USE action at the workshop.\n  align_action = align_with_workshop(env, workshop_index)\n  if align_action:\n      actions.append(align_action)\n\n  # Craft the item by performing the USE action.\n  actions.append(craft.ACTION_USE)\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
