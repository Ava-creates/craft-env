t_idx] < quantity:\n          actions.extend(collect_v2(env, ingredient_name))\n  \n  # Move to the target workshop\n  actions.extend(move_to(env._current_state, target_workshop_pos))\n\n  # Ensure we are facing the correct direction before using the workshop\n  if not is_facing_correct_direction(env._current_state, target_workshop_pos):\n      actions.extend(turn_towards_target(env._current_state, target_workshop_pos))\n  \n  # Perform the USE action at the workshop\n  actions.append(4)  # USE action index\n  \n  return actions", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T05:10:06.304281", "function_name": "craft", "function_body": "  def get_actions_for_movement(start, target, current_direction):\n    dx = target[0] - start[0]\n    dy = target[1] - start[1]\n\n    actions_to_take = []\n\n    if dx > 0:\n        while current_direction != craft.RIGHT:\n            actions_to_take.append(craft.TURN_RIGHT)\n            current_direction = (current_direction + 1) % 4\n        actions_to_take.extend([craft.MOVE_RIGHT for _ in range(dx)])\n    elif dx < 0:\n        while current_direction != craft.LEFT:\n            actions_to_take.append(craft.TURN_LEFT)\n            current_direction = (current_direction - 1) % 4\n        actions_to_take.extend([craft.MOVE_LEFT for _ in range(-dx)])\n\n    if dy > 0:\n        while current_direction != craft.DOWN:\n            actions_to_take.append(craft.TURN_RIGHT)\n            current_direction = (current_direction + 1) % 4\n        actions_to_take.extend([craft.MOVE_DOWN for _ in range(dy)])\n    elif dy < 0:\n        while current_direction != craft.UP:\n            actions_to_take.append(craft.TURN_LEFT)\n            current_direction = (current_direction - 1) % 4\n        actions_to_take.extend([craft.MOVE_UP for _ in range(-dy)])\n\n    return actions_to_take, current_direction\n\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = env._current_state.inventory.copy()\n\n  # Check if all ingredients are available\n  required_ingredients = {cookbook.index[k]: v for k, v in recipe.items()}\n\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if not can_craft:\n    return []\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No available workshop to craft item\")\n\n  # Select the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n  # Calculate actions to move the agent to the nearest workshop\n  actions_to_take, current_direction = get_actions_for_movement(\n      current_position, nearest_workshop_pos, env._current_state.dir\n  )\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T05:10:07.367108", "function_name": "craft", "function_body": "  def get_actions_for_movement(start, target, current_direction):\n    dx = target[0] - start[0]\n    dy = target[1] - start[1]\n\n    actions_to_take = []\n\n    if dx > 0:\n      actions_to_take.extend([craft.MOVE_RIGHT for _ in range(dx)])\n    elif dx < 0:\n      actions_to_take.extend([craft.MOVE_LEFT for _ in range(-dx)])\n\n    if dy > 0:\n      actions_to_take.extend([craft.MOVE_DOWN for _ in range(dy)])\n    elif dy < 0:\n      actions_to_take.extend([craft.MOVE_UP for _ in range(-dy)])\n\n    target_direction = None\n    if dx > 0:\n        target_direction = craft.RIGHT\n    elif dx < 0:\n        target_direction = craft.LEFT\n    elif dy > 0:\n        target_direction = craft.DOWN\n    elif dy < 0:\n        target_direction = craft.UP\n\n    if target_direction is not None and current_direction != target_direction:\n      while current_direction != target_direction:\n          actions_to_take.append(craft.TURN_RIGHT)\n          current_direction = (current_direction + 1) % 4\n\n    return actions_to_take, current_direction\n\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = env._current_state.inventory.copy()\n\n  # Check if all ingredients are available\n  required_ingredients = {cookbook.index[k]: v for k, v in recipe.items()}\n\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if not can_craft:\n    return []\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No available workshop to craft item\")\n\n  # Select the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n  actions_to_take, current_direction = get_actions_for_movement(\n      current_position, nearest_workshop_pos, env._current_state.dir\n  )\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T05:10:54.477272", "function_name": "craft", "function_body": "  # Get the index of the item to craft\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the items/primitives required for crafting\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  \n  actions = []\n\n  # If no recipe is found or no primitives are needed, return an empty list\n  if not primitives_needed:\n    return actions\n  \n  # Gather each required primitive\n  for primitive_index, count in primitives_needed.items():\n    \n    primitive_name = env.world.cookbook.index.get(primitive_index)\n    while np.sum(env._current_state.inventory[primitive_index]) < count:\n      # Collect the required primitive by moving to it and collecting it.\n      collect_actions = collect_v1(env, primitive_name)\n      actions.extend(collect_actions)\n\n  # Now that all primitives are collected, proceed to the workshop for crafting\n  workshop_index = None\n\n  # Determine the workshop required for crafting\n  for recipe in env.world.cookbook.recipes.values():\n    if item_index in recipe:\n      workshop_index = list(recipe.keys())[0]  # Assuming the first key is the workshop index\n      \n  # If no workshop found, return an empty list (this should not happen if recipes are correct)\n  if workshop_index is None:\n    return actions\n\n  workshop_name = env.world.cookbook.index.get(workshop_index)\n\n  # Move to the workshop\n  move_actions = move_to(env, workshop_name)\n  actions.extend(move_actions)\n\n  # Use the USE action to craft the item (assuming the agent is already facing the workshop)\n  use_action = craft.env.N_ACTIONS - 1  # Assuming USE action is the last one in N_ACTIONS\n  actions.append(use_action)\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-10T05:10:55.469710", "function_name": "craft", "function_body": "  # Get the index for the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the required primitives and intermediate items\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n\n  actions = []\n\n  # Collecting required primitives if not in inventory\n  for primitive, count in required_primitives.items():\n    while np.sum(env._current_state.inventory[primitive]) < count:\n      actions.extend(collect_v2(env, env.world.cookbook.index.get(primitive)))\n\n  # Go to the specified workshop and craft the item\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_name = recipe['_at']\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  actions.extend(navigate_to_workshop(env, workshop_index))\n  \n  # Use action at the workshop to craft the item\n  actions.append(env._current_state.world.n_actions - 1)  # USE action\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-10T05:12:03.170132", "function_name": "craft", "function_body": "  # Get the index of the item to craft\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  \n  actions_to_take = []\n  \n  # If we don't have all the primitives, return an empty action list\n  if not all(env._current_state.inventory[kind] >= count for kind, count in required_primitives.items()):\n      print(\"Missing some primitives\")\n      return []\n\n  # Navigate to the workshop specified in the recipe and perform the USE action\n  recipe = env.world.cookbook.recipes[item_index]\n  \n  # Determine which workshop to go to based on \"_at\" field in recipe\n  workshop_name = recipe['_at']\n  workshop_idx = env.world.workshop_indices[env.world.cookbook.index[workshop_name]]\n  \n  # Get the current position of the agent and the position of the target workshop\n  current_pos = np.array(env._current_state.pos)\n  target_workshop_pos = None\n\n  for i in range(env.world.scenario.grid.shape[0]):\n      for j in range(env.world.scenario.grid.shape[1]):\n          if env.world.scenario.grid[i, j, workshop_idx] == 1:\n              target_workshop_pos = np.array((i, j))\n              break\n      if target_workshop_pos is not None:\n          break\n\n  # If the target workshop position was not found, return an empty action list\n  if target_workshop_pos is None:\n      print(\"Target workshop not found\")\n      return []\n\n  # Calculate the direction to move towards the workshop\n  relative_pos = target_workshop_pos - current_pos\n  if relative_pos[0] > 0:\n      actions_to_take.append(env.world.N_DOWN)\n  elif relative_pos[0] < 0:\n      actions_to_take.append(env.world.N_UP)\n  elif relative_pos[1] > 0:\n      actions_to_take.append(env.world.N_RIGHT)\n  elif relative_pos[1] < 0:\n      actions_to_take.append(env.world.N_LEFT)\n\n  # Add the USE action to craft the item at the workshop\n  actions_to_take.append(env.world.USE)\n\n  return actions_to_take", "island_id": 3, "scores": {"3": -1}}
