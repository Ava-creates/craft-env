{"timestamp": "2025-09-10T10:46:12.935384", "function_name": "craft", "function_body": "  def shortest_path(grid, start, goal):\n    from collections import deque\n\n    queue = deque([start])\n    parent_map = {start: None}\n    directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n    while queue:\n        current = queue.popleft()\n        if current == goal:\n            path = []\n            while current is not None:\n                path.append(current)\n                current = parent_map[current]\n            return path[::-1]\n\n        for direction in directions:\n            neighbor = (current[0] + direction[0], current[1] + direction[1])\n            if (0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]) and\\\n               np.all(grid[neighbor] == 0) and neighbor not in parent_map:\n                parent_map[neighbor] = current\n                queue.append(neighbor)\n\n    return []\n\n  def move_towards(current_pos, target_pos):\n      delta_x = target_pos[1] - current_pos[1]\n      delta_y = target_pos[0] - current_pos[0]\n\n      if delta_x < 0:\n          return craft.ACTIONS.LEFT\n      elif delta_x > 0:\n          return craft.ACTIONS.RIGHT\n      elif delta_y < 0:\n          return craft.ACTIONS.UP\n      elif delta_y > 0:\n          return craft.ACTIONS.DOWN\n\n      return None\n\n  def direction_to(current_pos, target_pos):\n      delta_x = target_pos[1] - current_pos[1]\n      delta_y = target_pos[0] - current_pos[0]\n\n      if delta_y < 0:\n          return craft.DIRECTIONS.UP\n      elif delta_y > 0:\n          return craft.DIRECTIONS.DOWN\n      elif delta_x < 0:\n          return craft.DIRECTIONS.LEFT\n      elif delta_x > 0:\n          return craft.DIRECTIONS.RIGHT\n\n      return current_dir\n\n  def turn_towards(target_direction, current_direction):\n      if target_direction == craft.DIRECTIONS.UP and current_direction != craft.DIRECTIONS.UP:\n          if current_direction == craft.DIRECTIONS.DOWN:\n              return [craft.ACTIONS.TURN_UP]\n          elif current_direction == craft.DIRECTIONS.LEFT:\n              return [craft.ACTIONS.TURN_RIGHT, craft.ACTIONS.TURN_UP]\n          elif current_direction == craft.DIRECTIONS.RIGHT:\n              return [craft.ACTIONS.TURN_LEFT, craft.ACTIONS.TURN_UP]\n      elif target_direction == craft.DIRECTIONS.DOWN and current_direction != craft.DIRECTIONS.DOWN:\n          if current_direction == craft.DIRECTIONS.UP:\n              return [craft.ACTIONS.TURN_DOWN]\n          elif current_direction == craft.DIRECTIONS.LEFT:\n              return [craft.ACTIONS.TURN_LEFT, craft.ACTIONS.TURN_DOWN]\n          elif current_direction == craft.DIRECTIONS.RIGHT:\n              return [craft.ACTIONS.TURN_RIGHT, craft.ACTIONS.TURN_DOWN]\n      elif target_direction == craft.DIRECTIONS.LEFT and current_direction != craft.DIRECTIONS.LEFT:\n          if current_direction == craft.DIRECTIONS.UP:\n              return [craft.ACTIONS.TURN_LEFT]\n          elif current_direction == craft.DIRECTIONS.DOWN:\n              return [craft.ACTIONS.TURN_RIGHT, craft.ACTIONS.TURN_LEFT]\n          elif current_direction == craft.DIRECTIONS.RIGHT:\n              return [craft.ACTIONS.TURN_DOWN, craft.ACTIONS.TURN_LEFT]\n      elif target_direction == craft.DIRECTIONS.RIGHT and current_direction != craft.DIRECTIONS.RIGHT:\n          if current_direction == craft.DIRECTIONS.UP:\n              return [craft.ACTIONS.TURN_RIGHT]\n          elif current_direction == craft.DIRECTIONS.DOWN:\n              return [craft.ACTIONS.TURN_LEFT, craft.ACTIONS.TURN_RIGHT]\n          elif current_direction == craft.DIRECTIONS.LEFT:\n              return [craft.ACTIONS.TURN_DOWN, craft.ACTIONS.TURN_RIGHT]\n\n      return []\n\n  actions = []\n  \n  # Convert the item name to its index using the cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all required primitives for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  current_inventory = {env.world.cookbook.index.get(idx): count for idx, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  # If any required primitive is missing, return empty action list\n  for req_item, req_count in required_primitives.items():\n    if current_inventory.get(req_item, 0) < req_count:\n      return []\n\n  # Find the workshop required to craft this item\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_key = next(key for key in recipe.keys() if key.startswith(\"_at\"))\n  workshop_name = recipe[workshop_key]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n  \n  if len(workshop_positions) == 0:\n    return []\n\n  # Choose a random workshop position to head towards\n  workshop_pos = tuple(workshop_positions[env.world.random.randint(len(workshop_positions))])\n  \n  # Calculate the path from the current position to the chosen workshop\n  start_pos = env._current_state.pos\n  path = shortest_path(grid, start_pos, workshop_pos)\n  \n  if not path:\n    return []\n\n  # Generate actions to move along the calculated path\n  for target_pos in path[1:]:  # Skip the starting point\n    action = move_towards(env._current_state.pos, target_pos)\n    if action is None:\n      continue  # Handle cases where no valid move exists\n    actions.append(action)\n\n  # Turn towards the workshop to face it\n  workshop_dir = direction_to(env._current_state.pos, workshop_pos)\n  actions.extend(turn_towards(workshop_dir, env._current_state.dir))\n  \n  # Add USE action to craft the item at the workshop\n  actions.append(craft.ACTIONS.USE)\n\n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T10:46:14.012709", "function_name": "craft", "function_body": "  def shortest_path(grid, start, goal):\n    from collections import deque\n\n    queue = deque([start])\n    parent_map = {start: None}\n    directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n    while queue:\n        current = queue.popleft()\n        if current == goal:\n            path = []\n            while current is not None:\n                path.append(current)\n                current = parent_map[current]\n            return path[::-1]\n\n        for direction in directions:\n            neighbor = (current[0] + direction[0], current[1] + direction[1])\n            if (0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]) and\\\n               np.all(grid[neighbor] == 0) and neighbor not in parent_map:\n                parent_map[neighbor] = current\n                queue.append(neighbor)\n\n    return []\n\n  def move_towards(current_pos, current_dir, target_pos):\n      delta_x = target_pos[1] - current_pos[1]\n      delta_y = target_pos[0] - current_pos[0]\n\n      if delta_x < 0:\n          return craft.ACTIONS.LEFT if current_dir == 3 else (craft.ACTIONS.RIGHT if current_dir == 2 else None)\n      elif delta_x > 0:\n          return craft.ACTIONS.RIGHT if current_dir == 2 else (craft.ACTIONS.LEFT if current_dir == 3 else None)\n      elif delta_y < 0:\n          return craft.ACTIONS.UP if current_dir == 1 else (craft.ACTIONS.DOWN if current_dir == 0 else None)\n      elif delta_y > 0:\n          return craft.ACTIONS.DOWN if current_dir == 0 else (craft.ACTIONS.UP if current_dir == 1 else None)\n\n      return None\n\n  def direction_to(current_pos, target_pos):\n      delta_x = target_pos[1] - current_pos[1]\n      delta_y = target_pos[0] - current_pos[0]\n\n      if delta_y < 0:\n          return craft.DIRECTIONS.UP\n      elif delta_y > 0:\n          return craft.DIRECTIONS.DOWN\n      elif delta_x < 0:\n          return craft.DIRECTIONS.LEFT\n      elif delta_x > 0:\n          return craft.DIRECTIONS.RIGHT\n\n      return current_dir\n\n  def turn_towards(target_direction):\n      if target_direction == craft.DIRECTIONS.UP:\n          return craft.ACTIONS.TURN_UP\n      elif target_direction == craft.DIRECTIONS.DOWN:\n          return craft.ACTIONS.TURN_DOWN\n      elif target_direction == craft.DIRECTIONS.LEFT:\n          return craft.ACTIONS.TURN_LEFT\n      elif target_direction == craft.DIRECTIONS.RIGHT:\n          return craft.ACTIONS.TURN_RIGHT\n\n  actions = []\n  \n  # Convert the item name to its index using the cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all required primitives for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  current_inventory = {env.world.cookbook.index.get(idx): count for idx, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  # If any required primitive is missing, return empty action list\n  for req_item, req_count in required_primitives.items():\n    if current_inventory.get(req_item, 0) < req_count:\n      return []\n\n  # Find the workshop required to craft this item\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_key = next(key for key in recipe.keys() if key.startswith(\"_at\"))\n  workshop_name = recipe[workshop_key]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n  \n  if len(workshop_positions) == 0:\n    return []\n\n  # Choose a random workshop position to head towards\n  workshop_pos = tuple(workshop_positions[env.world.random.randint(len(workshop_positions))])\n  \n  # Calculate the path from the current position to the chosen workshop\n  start_pos = env._current_state.pos\n  path = shortest_path(grid, start_pos, workshop_pos)\n  \n  if not path:\n    return []\n\n  # Generate actions to move along the calculated path\n  for target_pos in path[1:]:  # Skip the starting point\n    action = move_towards(env._current_state.pos, env._current_state.dir, target_pos)\n    if action is None:\n      continue  # Handle cases where no valid move exists\n    actions.append(action)\n\n  # Turn towards the workshop to face it\n  workshop_dir = direction_to(env._current_state.pos, workshop_pos)\n  while env._current_state.dir != workshop_dir:\n    actions.append(turn_towards(workshop_dir))\n  \n  # Add USE action to craft the item at the workshop\n  actions.append(craft.ACTIONS.USE)\n\n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T10:47:32.422677", "function_name": "craft", "function_body": "  def move_to_position(pos):\n    current_pos = env._current_state.pos\n    actions = []\n    while current_pos != pos:\n      delta_x = pos[0] - current_pos[0]\n      delta_y = pos[1] - current_pos[1]\n\n      if delta_x < 0:\n          actions.append(2)  # LEFT\n      elif delta_x > 0:\n          actions.append(3)  # RIGHT\n\n      if delta_y < 0:\n          actions.append(0)  # DOWN\n      elif delta_y > 0:\n          actions.append(1)  # UP\n      \n      # Execute the action to move one step closer\n      reward, done, observations = env.step(actions[-1])\n      current_pos = observations['features_dict']['pos'] * env.world.WIDTH, observations['features_dict']['pos'] * env.world.HEIGHT\n\n    return actions\n\n\n  actions = []\n\n  # Convert item name to its index in the cookbook\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the required primitives for crafting the item\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n\n  # Check if we have all the required primitives in our inventory\n  missing_primitives = []\n  for primitive, required_count in required_primitives.items():\n    if inventory_dict.get(primitive, 0) < required_count:\n      missing_primitives.append((primitive, required_count))\n\n  # If there are any missing primitives, return an empty list of actions\n  if missing_primitives:\n    return []\n\n  # Determine the workshop where crafting should occur\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_required_key = [k for k, v in recipe.items() if \"_at\" in k][0]\n  workshop_required_name = recipe[workshop_required_key]\n\n  # Find the nearest workshop of the required type\n  closest_workshop_pos = None\n  min_distance = float('inf')\n\n  for pos in env.world.workshop_indices:\n    if env.world.cookbook.index.get(pos[0]) == workshop_required_name:  # Check if it's the correct workshop type\n      distance = abs(pos[1] - env._current_state.pos[0]) + abs(pos[2] - env._current_state.pos[1])\n      if distance < min_distance:\n        closest_workshop_pos = (pos[1], pos[2])\n        min_distance = distance\n\n  # Add actions to move to the nearest workshop\n  actions.extend(move_to_position(closest_workshop_pos))\n\n  # Add USE action to craft the item\n  actions.append(4)  # Assuming USE action is 4\n\n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T10:47:33.469990", "function_name": "craft", "function_body": "  actions = []\n  \n  # Convert the item name to its index in the cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the required primitives for crafting the item\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  # Check if we have all the required primitives in our inventory\n  missing_primitives = []\n  for primitive, required_count in required_primitives.items():\n    if inventory_dict.get(primitive, 0) < required_count:\n      missing_primitives.append((primitive, required_count))\n      \n  # If there are any missing primitives, return an empty list of actions\n  if missing_primitives:\n    return []\n\n  # Determine the workshop where crafting should occur\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_required_key = [k for k in recipe.keys() if \"_at\" in k][0]\n  workshop_required_value = recipe[workshop_required_key].split(\"_\")[-1]\n  \n  # Find the nearest workshop of the required type\n  target_workshop_type = env.world.cookbook.index.get(workshop_required_value)\n  closest_workshop_pos = None\n  min_distance = float('inf')\n  \n  for pos in env.world.workshop_indices:\n    if pos[0] == target_workshop_type:  # Check if it's the correct workshop type\n      distance = abs(pos[1] - env._current_state.pos[0]) + abs(pos[2] - env._current_state.pos[1])\n      if distance < min_distance:\n        closest_workshop_pos = (pos[1], pos[2])\n        min_distance = distance\n  \n  # Add actions to move to the nearest workshop\n  actions.extend(move_to(env, closest_workshop_pos))\n  \n  # Add USE action to craft the item\n  actions.append(4)  # Assuming USE action is 4\n\n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T10:48:33.473669", "function_name": "craft", "function_body": "  goal_index = env.world.cookbook.index[item]\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n\n  actions = []\n\n  if not required_primitives:\n    return [] # No recipe or no primitives needed, can't craft\n\n  # Check if all required primitives are already in inventory\n  for primitive, count in required_primitives.items():\n    if env._current_state.inventory[primitive] < count:\n      return [] # Not enough primitives to start crafting\n\n  # Find the workshop where we need to go to craft this item\n  workshop_index = None\n  for recipe_key, recipe in env.world.cookbook.recipes.items():\n    if \"_at\" in recipe and recipe[\"_at\"] == goal_index:\n      workshop_index = env.world.cookbook.index[recipe_key]\n      break\n\n  # Check if the required workshop exists\n  if workshop_index is None:\n    return [] # No suitable workshop found\n\n  # Navigate to the closest workshop (this part needs more sophisticated logic)\n  # For simplicity, we will just move up and right for demonstration purposes\n  actions.append(env.world.cookbook.index[\"UP\"])\n  actions.append(env.world.cookbook.index[\"RIGHT\"])\n\n  # Use action to craft the item at the workshop (this assumes correct orientation)\n  actions.append(env.world.cookbook.index[\"USE\"])\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T10:48:34.446324", "function_name": "craft", "function_body": "  goal_index = env.world.cookbook.index[item]\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n\n  actions = []\n\n  if not required_primitives:\n    return [] # No recipe or no primitives needed, can't craft\n\n  # Check if all required primitives are already in inventory\n  for primitive, count in required_primitives.items():\n    if env._current_state.inventory[primitive] < count:\n      return [] # Not enough primitives to start crafting\n\n  # Find the workshop where we need to go to craft this item\n  workshop_index = None\n  for recipe_key, recipe in env.world.cookbook.recipes.items():\n    if \"_at\" in recipe and env.world.cookbook.index.get(recipe[\"_at\"]) == goal_index:\n      workshop_name = recipe_key.split(\"_\")[0]  # Assuming the workshop name is before \"_\"\n      workshop_index = env.world.cookbook.index[workshop_name]\n      break\n\n  # Check if the required workshop exists\n  if workshop_index is None:\n    return [] # No suitable workshop found\n\n  # Navigate to the closest workshop (this part needs more sophisticated logic)\n  # For demonstration, we will find the nearest workshop of the correct type using a simple heuristic\n  grid = env._current_state.grid\n  agent_pos = np.array(env._current_state.pos)\n\n  closest_workshop_distance = float('inf')\n  closest_workshop_pos = None\n\n  for i in range(grid.shape[0]):\n    for j in range(grid.shape[1]):\n      if grid[i, j, workshop_index] == 1:\n        distance = np.linalg.norm(agent_pos - np.array([i, j]))\n        if distance < closest_workshop_distance:\n          closest_workshop_distance = distance\n          closest_workshop_pos = (i, j)\n\n  # If no workshop is found, return an empty list of actions\n  if closest_workshop_pos is None:\n    return []\n\n  # Navigate to the closest workshop (this part needs more sophisticated logic)\n  target_x, target_y = closest_workshop_pos\n\n  while env._current_state.pos[0] != target_x or env._current_state.pos[1] != target_y:\n    delta_x = target_x - env._current_state.pos[0]\n    delta_y = target_y - env._current_state.pos[1]\n\n    if abs(delta_x) > abs(delta_y):\n      # Move horizontally\n      actions.append(env.world.cookbook.index[\"RIGHT\"] if delta_x > 0 else env.world.cookbook.index[\"LEFT\"])\n    elif abs(delta_y) >= abs(delta_x):\n      # Move vertically\n      actions.append(env.world.cookbook.index[\"DOWN\"] if delta_y > 0 else env.world.cookbook.index[\"UP\"])\n\n  # Use action to craft the item at the workshop (this assumes correct orientation)\n  actions.append(env.world.cookbook.index[\"USE\"])\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-10T10:49:40.340611", "function_name": "craft", "function_body": "  i_goal = env.world.cookbook.index[item]\n  \n  if i_goal not in env.world.cookbook.recipes:\n    raise ValueError(f\"No recipe found for {item}.\")\n    \n  actions = []\n  \n  # Check if we have all required primitives and intermediate items\n  required_primitives = env.world.cookbook.primitives_for(i_goal)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory)}\n\n  missing_items = []\n  for primitive, count_needed in required_primitives.items():\n    if inventory_dict.get(primitive, 0) < count_needed:\n      missing_items.append((primitive, count_needed - inventory_dict.get(primitive, 0)))\n\n  if missing_items:\n    # Collect the missing primitives\n    collect_actions = []\n    for primitive, count_needed in missing_items:\n      primitive_index = env.world.cookbook.index[primitive]\n      primitive_name = list(env.world.cookbook.index)[list(env.world.cookbook.index.values()).index(primitive)]\n      \n      collect_primitive_actions = collect(env, primitive_name)\n      if not collect_primitive_actions:\n        return []  # Return empty list if we cannot find the required primitive\n\n      collect_actions.extend(collect_primitive_actions)\n\n    actions.extend(collect_actions)\n\n  # Go to the workshop and craft the item\n  workshop_key = env.world.cookbook.recipes[i_goal][\"_key\"]\n  workshop_index = env.world.cookbook.index[workshop_key]\n  \n  grid_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if not grid_positions.size:\n    return []  # No workshops found\n\n  closest_workshop_pos = min(grid_positions, key=lambda x: np.linalg.norm(np.array(x) - np.array(env._current_state.pos)))\n\n  move_actions = move_to_position_with_orientation(env, env._current_state.pos, closest_workshop_pos)\n  actions.extend(move_actions)\n\n  face_direction = face_towards_position(env, env._current_state.pos, closest_workshop_pos)\n  if face_direction:\n    actions.append(face_direction)\n  \n  actions.append(4)  # USE action\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-10T10:49:41.435254", "function_name": "craft", "function_body": "  i_goal = env.world.cookbook.index[item]\n  \n  if i_goal not in env.world.cookbook.recipes:\n    raise ValueError(f\"No recipe found for {item}.\")\n    \n  actions = []\n  \n  # Check if we have all required primitives and intermediate items\n  required_primitives = env.world.cookbook.primitives_for(i_goal)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory)}\n\n  missing_items = []\n  for primitive, count_needed in required_primitives.items():\n    if inventory_dict.get(primitive, 0) < count_needed:\n      missing_items.append((primitive, count_needed - inventory_dict.get(primitive, 0)))\n\n  if missing_items:\n    return []  # Return empty list if any required item is missing\n\n  # Get the workshop where the item can be crafted\n  workshop_key = env.world.cookbook.recipes[i_goal][\"_key\"]\n  workshop_index = env.world.cookbook.index[workshop_key]\n\n  # Find positions of all workshops in the grid\n  grid_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if not grid_positions.size:\n    return []  # No workshops found\n\n  closest_workshop_pos = min(grid_positions, key=lambda x: np.linalg.norm(np.array(x) - np.array(env._current_state.pos)))\n\n  # Generate actions to move towards the nearest workshop\n  move_actions = move_to_position_with_orientation(env, env._current_state.pos, closest_workshop_pos)\n  actions.extend(move_actions)\n\n  # Orient towards the workshop and use it\n  face_direction = face_towards_position(env, env._current_state.pos, closest_workshop_pos)\n  if face_direction:\n    actions.append(face_direction)\n  \n  actions.append(4)  # USE action\n\n  return actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T10:50:38.073931", "function_name": "craft", "function_body": "  # Get the current state of the environment\n  current_state = env._current_state\n\n  # Convert item name to index using the cookbook's index map\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the recipe for the item exists\n  if item_index not in env.world.cookbook.recipes:\n    print(f\"No recipe found for {item}.\")\n    return []\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes[item_index]\n  required_items = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  # Check if all required items are available in the inventory\n  missing_items = []\n  for i_kind, count in required_items.items():\n    if current_state.inventory[i_kind] < count:\n      missing_items.append((i_kind, count - current_state.inventory[i_kind]))\n\n  if missing_items:\n    print(f\"Missing items: {missing_items}\")\n    return []\n\n  # If all items are available, proceed to the crafting workshop\n  workshop_index = env.world.cookbook.index[recipe[\"_at\"]]\n\n  # Find the closest workshop of the required type\n  workshop_positions = np.argwhere(current_state.grid[:, :, workshop_index])\n  if len(workshop_positions) == 0:\n    print(f\"No workshop found for {item}.\")\n    return []\n\n  closest_workshop_pos = min(\n      workshop_positions, key=lambda p: abs(p[0] - current_state.pos[0]) + abs(p[1] - current_state.pos[1]))\n\n  # Calculate the path to the closest workshop\n  path_to_workshop = a_star(current_state.grid, current_state.pos, tuple(closest_workshop_pos), env.world.non_grabbable_indices)\n\n  if not path_to_workshop:\n    print(\"No valid path to the workshop.\")\n    return []\n\n  actions_to_reach_workshop = []\n  for next_pos in path_to_workshop[1:]:\n    actions_to_reach_workshop.extend(movement_actions(current_state.pos, next_pos))\n    current_state.pos = tuple(next_pos)\n\n  # Add action to face the workshop and use it\n  final_action = turn_towards(current_state.pos, closest_workshop_pos) + [4]  # USE action\n\n  return actions_to_reach_workshop + final_action", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-10T10:50:39.060626", "function_name": "craft", "function_body": "  # Extract the index for the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the recipe for the desired item\n  recipe = env.world.cookbook.recipes.get(item_index)\n  \n  # If there's no recipe, return an empty action list\n  if not recipe:\n      return []\n      \n  # Initialize a list to store actions needed to craft the item\n  actions = []\n\n  # Check if all required primitives are available in the inventory\n  # and collect them if necessary\n  for ingredient_index, count in recipe.items():\n      if ingredient_index == \"_at\": \n          continue  # Skip the workshop location\n      \n      primitive_name = env.world.cookbook.index.get(ingredient_index)\n      \n      # Check if we have enough of this primitive\n      if env._current_state.inventory[ingredient_index] < count:\n          # If not, collect the required amount of the primitive\n          actions.extend(collect_v2(env, primitive_name))\n          \n  # Determine the workshop location from the recipe\n  workshop_location = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_location]\n  \n  # Find the position of the nearest workshop in the grid\n  workshop_pos = find_nearest_workshop(env._current_state, workshop_index)\n  \n  if workshop_pos is None:\n      return []  # If no workshop found, return an empty action list\n  \n  # Navigate to the workshop position\n  actions.extend(navigate_to_position(env._current_state, workshop_pos))\n  \n  # Ensure we are facing the workshop before using it\n  actions.append(orient_towards_workshop(env._current_state, workshop_pos))\n  \n  # Use the workshop to craft the item\n  actions.append(craft.USE)\n  \n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-10T10:52:01.903981", "function_name": "craft", "function_body": "  goal_index = env.world.cookbook.index[item]\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n\n  if not required_primitives:\n    return [] # No recipe or no primitives needed, can't craft\n\n  # Check if all required primitives are already in inventory\n  for primitive, count in required_primitives.items():\n    if env._current_state.inventory[primitive] < count:\n      return [] # Not enough primitives to start crafting\n\n  # Find the workshop where we need to go to craft this item\n  workshop_index = None\n  for recipe_key, recipe in env.world.cookbook.recipes.items():\n    if \"_at\" in recipe and recipe[\"_at\"] == goal_index:\n      workshop_name = recipe_key.split('_')[0]\n      workshop_index = env.world.cookbook.index[workshop_name]\n      break\n\n  # Check if the required workshop exists\n  if workshop_index is None:\n    return [] # No suitable workshop found\n  \n  # Find coordinates of the closest workshop\n  workshop_coords = None\n  for y in range(env._current_state.grid.shape[0]):\n    for x in range(env._current_state.grid.shape[1]):\n      if env._current_state.grid[y, x, workshop_index] == 1:\n        workshop_coords = (y, x)\n        break\n\n  # Check if the workshop coordinates were found\n  if workshop_coords is None:\n    return [] # No suitable workshop found on the grid\n\n  # Navigate to the closest workshop (this part needs more sophisticated logic)\n  current_y, current_x = env._current_state.pos\n  target_y, target_x = workshop_coords\n\n  while current_y < target_y:\n    actions.append(env.world.cookbook.index[\"DOWN\"])\n    current_y += 1\n\n  while current_y > target_y:\n    actions.append(env.world.cookbook.index[\"UP\"])\n    current_y -= 1\n\n  while current_x < target_x:\n    actions.append(env.world.cookbook.index[\"RIGHT\"])\n    current_x += 1\n\n  while current_x > target_x:\n    actions.append(env.world.cookbook.index[\"LEFT\"])\n    current_x -= 1\n\n  # Use action to craft the item at the workshop (this assumes correct orientation)\n  actions.append(env.world.cookbook.index[\"USE\"])\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T10:52:02.942172", "function_name": "craft", "function_body": "  goal_index = env.world.cookbook.index[item]\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n\n  actions = []\n\n  if not required_primitives:\n    return [] # No recipe or no primitives needed, can't craft\n\n  # Check if all required primitives are already in inventory\n  for primitive, count in required_primitives.items():\n    if env._current_state.inventory[primitive] < count:\n      return [] # Not enough primitives to start crafting\n\n  # Find the workshop where we need to go to craft this item\n  workshop_index = None\n  for recipe_key, recipe in env.world.cookbook.recipes.items():\n    if \"_at\" in recipe and recipe[\"_at\"] == goal_index:\n      workshop_index = env.world.cookbook.index[recipe_key]\n      break\n\n  # Check if the required workshop exists\n  if workshop_index is None:\n    return [] # No suitable workshop found\n  \n  # Navigate to the closest workshop\n  target_pos = None\n  for x in range(env._current_state.grid.shape[0]):\n    for y in range(env._current_state.grid.shape[1]):\n      if env._current_state.grid[x, y, workshop_index] > 0:\n        target_pos = (x, y)\n        break\n    if target_pos is not None:\n      break\n  \n  # If no workshop is found, return an empty list\n  if target_pos is None:\n    return []\n\n  # Simple pathfinding to the workshop (A* algorithm could be used here for more efficiency)\n  start_pos = env._current_state.pos\n  path = astar(start_pos, target_pos, env._current_state.grid.shape)\n\n  # Convert path into actions\n  if path:\n      for i in range(len(path) - 1):\n          dx = path[i + 1][0] - path[i][0]\n          dy = path[i + 1][1] - path[i][1]\n          \n          if dx == 0 and dy == -1:\n              actions.append(env.world.cookbook.index[\"UP\"])\n          elif dx == 0 and dy == 1:\n              actions.append(env.world.cookbook.index[\"DOWN\"])\n          elif dx == -1 and dy == 0:\n              actions.append(env.world.cookbook.index[\"LEFT\"])\n          elif dx == 1 and dy == 0:\n              actions.append(env.world.cookbook.index[\"RIGHT\"])\n\n  # Use action to craft the item at the workshop (this assumes correct orientation)\n  actions.append(env.world.cookbook.index[\"USE\"])\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T10:54:14.843363", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n\n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = env._current_state.inventory.copy()\n\n  # Check if all ingredients are available\n  required_ingredients = {cookbook.index[k]: v for k, v in recipe.items()}\n\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if not can_craft:\n    return []\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No available workshop to craft item\")\n\n  # Select the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n  # Calculate actions to move the agent to the nearest workshop\n  dx = nearest_workshop_pos[0] - current_position[0]\n  dy = nearest_workshop_pos[1] - current_position[1]\n\n  actions_to_take = []\n\n  if dx > 0:\n    actions_to_take.extend([craft.MOVE_RIGHT for _ in range(dx)])\n  elif dx < 0:\n    actions_to_take.extend([craft.MOVE_LEFT for _ in range(-dx)])\n\n  if dy > 0:\n    actions_to_take.extend([craft.MOVE_DOWN for _ in range(dy)])\n  elif dy < 0:\n    actions_to_take.extend([craft.MOVE_UP for _ in range(-dy)])\n\n  # Calculate the target direction to face the workshop\n  current_direction = env._current_state.dir\n\n  if dx == 0 and dy == 0:  # Already at the workshop\n      pass\n  elif abs(dx) > abs(dy):  # Prioritize horizontal movement\n      while current_direction != (craft.RIGHT if dx > 0 else craft.LEFT):\n          actions_to_take.append(craft.TURN_RIGHT)\n          current_direction = (current_direction + 1) % 4\n  else:  # Prioritize vertical movement\n      while current_direction != (craft.DOWN if dy > 0 else craft.UP):\n          actions_to_take.append(craft.TURN_LEFT)\n          current_direction = (current_direction - 1) % 4\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T10:54:15.906591", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n\n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = env._current_state.inventory.copy()\n\n  # Check if all ingredients are available\n  required_ingredients = {cookbook.index[k]: v for k, v in recipe.items()}\n\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if not can_craft:\n    return []\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No available workshop to craft item\")\n\n  # Select the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n  # Calculate actions to move the agent to the nearest workshop\n  dx = nearest_workshop_pos[0] - current_position[0]\n  dy = nearest_workshop_pos[1] - current_position[1]\n\n  actions_to_take = []\n\n  if dx > 0:\n    actions_to_take.extend([craft.MOVE_RIGHT for _ in range(dx)])\n  elif dx < 0:\n    actions_to_take.extend([craft.MOVE_LEFT for _ in range(-dx)])\n\n  if dy > 0:\n    actions_to_take.extend([craft.MOVE_DOWN for _ in range(dy)])\n  elif dy < 0:\n    actions_to_take.extend([craft.MOVE_UP for _ in range(-dy)])\n\n  # Calculate the target direction to face the workshop\n  current_direction = env._current_state.dir\n\n  if dx == 0 and dy == 0:  # Already at the workshop\n      pass\n  elif abs(dx) > abs(dy):  # Prioritize horizontal movement\n      while current_direction != (craft.RIGHT if dx > 0 else craft.LEFT):\n          actions_to_take.append(craft.TURN_RIGHT)\n          current_direction = (current_direction + 1) % 4\n  else:  # Prioritize vertical movement\n      while current_direction != (craft.DOWN if dy > 0 else craft.UP):\n          actions_to_take.append(craft.TURN_LEFT)\n          current_direction = (current_direction - 1) % 4\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T10:56:33.340250", "function_name": "craft", "function_body": "  def move_to_position(pos):\n    current_pos = env._current_state.pos\n    actions = []\n    while current_pos != pos:\n      delta_x = pos[0] - current_pos[0]\n      delta_y = pos[1] - current_pos[1]\n\n      if delta_x < 0:\n          actions.append(2)  # LEFT\n      elif delta_x > 0:\n          actions.append(3)  # RIGHT\n\n      if delta_y < 0:\n          actions.append(0)  # DOWN\n      elif delta_y > 0:\n          actions.append(1)  # UP\n      \n      # Execute the action to move one step closer\n      reward, done, observations = env.step(actions[-1])\n      current_pos = (int(observations['features_dict']['pos'][0] * env.world.WIDTH), \n                     int(observations['features_dict']['pos'][1] * env.world.HEIGHT))\n\n    return actions\n\n  def collect_primitive(primitive):\n    primitive_index = env.world.cookbook.index[primitive]\n    nearest_position = None\n    min_distance = float('inf')\n\n    # Find the nearest position of the required primitive in the grid\n    for x in range(env.world.WIDTH):\n        for y in range(env.world.HEIGHT):\n            if env._current_state.grid[x, y, primitive_index] > 0:\n                distance = abs(x - env._current_state.pos[0]) + abs(y - env._current_state.pos[1])\n                if distance < min_distance:\n                    nearest_position = (x, y)\n                    min_distance = distance\n\n    # If no primitive is found, return an empty list\n    if nearest_position is None:\n        return []\n\n    # Move to the nearest position of the required primitive\n    actions_to_primitive = move_to_position(nearest_position)\n\n    # Collect the primitive using USE action (assuming USE action is 4)\n    actions_to_primitive.append(4)  # Assuming USE action is 4\n\n    return actions_to_primitive\n\n  actions = []\n\n  # Convert item name to its index in the cookbook\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the required primitives for crafting the item\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n\n  missing_primitives = []\n  for primitive, required_count in required_primitives.items():\n    if inventory_dict.get(primitive, 0) < required_count:\n      missing_primitives.append((primitive, required_count))\n\n  # Collect all missing primitives\n  for primitive, required_count in missing_primitives:\n    while required_count > 0:\n      actions.extend(collect_primitive(primitive))\n      required_count -= 1\n\n  # Determine the workshop where crafting should occur\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_required_key = [k for k, v in recipe.items() if \"_at\" in k][0]\n  workshop_required_name = recipe[workshop_required_key]\n\n  # Find the nearest workshop of the required type\n  closest_workshop_pos = None\n  min_distance = float('inf')\n\n  for pos in env.world.workshop_indices:\n    if env.world.cookbook.index.get(pos) == workshop_required_name:  # Check if it's the correct workshop type\n      distance = abs(pos[1] - env._current_state.pos[0]) + abs(pos[2] - env._current_state.pos[1])\n      if distance < min_distance:\n        closest_workshop_pos = (pos[1], pos[2])\n        min_distance = distance\n\n  # Add actions to move to the nearest workshop\n  actions.extend(move_to_position(closest_workshop_pos))\n\n  # Add USE action to craft the item\n  actions.append(4)  # Assuming USE action is 4\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-10T10:56:34.438213", "function_name": "craft", "function_body": "  def move_to_position(pos):\n    current_pos = env._current_state.pos\n    actions = []\n    while current_pos != pos:\n      delta_x = pos[0] - current_pos[0]\n      delta_y = pos[1] - current_pos[1]\n\n      if delta_x < 0:\n          actions.append(2)  # LEFT\n      elif delta_x > 0:\n          actions.append(3)  # RIGHT\n\n      if delta_y < 0:\n          actions.append(0)  # DOWN\n      elif delta_y > 0:\n          actions.append(1)  # UP\n      \n      # Execute the action to move one step closer\n      reward, done, observations = env.step(actions[-1])\n      current_pos = (observations['features_dict']['pos'] * env.world.WIDTH).astype(int), (observations['features_dict']['pos'] * env.world.HEIGHT).astype(int)\n\n    return actions\n\n  def face_workshop(workshop_pos):\n      current_pos = env._current_state.pos\n      delta_x = workshop_pos[0] - current_pos[0]\n      delta_y = workshop_pos[1] - current_pos[1]\n\n      direction_actions = []\n      if delta_x < 0:\n          direction_actions.append(2)  # LEFT\n      elif delta_x > 0:\n          direction_actions.append(3)  # RIGHT\n\n      if delta_y < 0:\n          direction_actions.append(0)  # DOWN\n      elif delta_y > 0:\n          direction_actions.append(1)  # UP\n      \n      return direction_actions[-1]  # Only the last action is needed to face the workshop\n\n  actions = []\n\n  # Convert item name to its index in the cookbook\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the required primitives for crafting the item\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n\n  # Check if we have all the required primitives in our inventory\n  missing_primitives = []\n  for primitive, required_count in required_primitives.items():\n    if inventory_dict.get(primitive, 0) < required_count:\n      missing_primitives.append((primitive, required_count))\n\n  # If there are any missing primitives, return an empty list of actions\n  if missing_primitives:\n    return []\n\n  # Determine the workshop where crafting should occur\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_required_key = [k for k, v in recipe.items() if \"_at\" in k][0]\n  workshop_required_name = recipe[workshop_required_key]\n\n  # Find the nearest workshop of the required type\n  closest_workshop_pos = None\n  min_distance = float('inf')\n\n  for pos in env.world.workshop_indices:\n    if env.world.cookbook.index.get(pos[2]) == workshop_required_name:  # Check if it's the correct workshop type\n      distance = abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n      if distance < min_distance:\n        closest_workshop_pos = (pos[0], pos[1])\n        min_distance = distance\n\n  # Add actions to move to the nearest workshop\n  actions.extend(move_to_position(closest_workshop_pos))\n\n  # Face the workshop before using it\n  face_direction_action = face_workshop(closest_workshop_pos)\n  actions.append(face_direction_action)\n\n  # Add USE action to craft the item\n  actions.append(4)  # Assuming USE action is 4\n\n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T10:57:47.204094", "function_name": "craft", "function_body": "  def collect_ingredient(name: str):\n    ingredient_idx = env.world.cookbook.index[name]\n    if env._current_state.inventory[ingredient_idx] == 0:\n      # Collect the ingredient if it's not already in inventory\n      return collect_v2(env, name)\n    return []\n\n  def has_required_primitives():\n    for ingredient_name, quantity in recipe.items():\n        if quantity > 0:\n            ingredient_idx = env.world.cookbook.index[ingredient_name]\n            if env._current_state.inventory[ingredient_idx] < quantity:\n                return False\n    return True\n\n  actions = []\n  \n  # Get the index for the desired item from the cookbook\n  item_idx = env.world.cookbook.index[item]\n  \n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_idx, {})\n  \n  if not recipe:\n    return []  # No recipe found\n  \n  # Determine the workshop where the crafting should happen\n  workshop_key = \"_key\"\n  workshop_index_str = recipe.pop(workshop_key, None)\n  \n  if workshop_index_str is None or not workshop_index_str.isdigit():\n    return []  # Workshop index is not specified correctly in the recipe\n  \n  workshop_index = int(workshop_index_str)\n  \n  if workshop_index < 0 or workshop_index >= len(env.world.workshop_indices):\n    return []  # Invalid workshop index\n\n  target_workshop_pos = None\n  for y in range(env._current_state.grid.shape[1]):\n      for x in range(env._current_state.grid.shape[0]):\n          if env._current_state.grid[x, y, env.world.workshop_indices[workshop_index]] == 1:\n              target_workshop_pos = (x, y)\n              break\n      if target_workshop_pos is not None:\n          break\n  \n  if target_workshop_pos is None:\n    return []  # Workshop position not found in the grid\n\n  # Check and collect all required primitives\n  while not has_required_primitives():\n      for ingredient_name, quantity in recipe.items():\n          if quantity > 0:  # Ensure we only collect required quantities\n              ingredient_idx = env.world.cookbook.index[ingredient_name]\n              \n              # If we don't have enough of this ingredient, collect it\n              if env._current_state.inventory[ingredient_idx] < quantity:\n                  actions.extend(collect_ingredient(ingredient_name))\n\n  # Move to the target workshop\n  actions.extend(move_to(env._current_state, target_workshop_pos))\n  \n  # Perform the USE action at the workshop\n  actions.append(4)  # USE action index\n\n  return actions", "island_id": 2, "scores": {"3": 0.0}}
