        actions_to_primitive = pathfinding(env._current_state.grid, env._current_state.pos, closest_primitive)\n            \n            if not actions_to_primitive:\n                return []  # No path found.\n\n            # Append the COLLECT action (assuming COLLECT is represented by a specific action index, e.g., 5).\n            actions.extend(actions_to_primitive + [5])\n\n    return actions\n\n  def update_environment(env):\n    \"\"\"Simulate one step in the environment to update the state.\"\"\"\n    dummy_action = 0  # Assuming 0 (DOWN) is a valid but dummy action.\n    _, _, _ = env.step(dummy_action)\n    time.sleep(0.1)  # Small delay to simulate time.\n\n  item_index = env.world.cookbook.index[item]\n\n  # Retrieve all required primitives to craft the item.\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n\n  # Collect all required primitives if not already in inventory.\n  collect_actions = collect_primitives(env, required_primitives)\n  \n  # If unable to collect all required primitives, return an empty list.\n  if not collect_actions:\n    return []\n\n  # Update the environment state after collecting primitives.\n  update_environment(env)\n\n  # Identify the workshop needed to craft the item.\n  workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n        workshop_key = recipe.get(\"_at\")\n        if workshop_key is not None:\n            workshop_index = getattr(env.world, f\"{workshop_key}_index\", None)\n            break\n\n  # If no suitable workshop is found, return an empty list.\n  if workshop_index is None:\n    return []\n\n  # Locate the nearest workshop in the grid.\n  workshops = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n  # If no workshops are available, return an empty list.\n  if not workshops.any():\n    return []\n\n  # Find the closest workshop to the current agent's position.\n  distances = np.linalg.norm(workshops - env._current_state.pos, axis=1)\n  closest_workshop = tuple(workshops[np.argmin(distances)])\n\n  # Generate actions to move the agent to the closest workshop.\n  actions_to_workshop = pathfinding(env._current_state.grid, env._current_state.pos, closest_workshop)\n\n  # Append the USE action at the workshop to craft the item.\n  actions_to_workshop.append(4)  # Assuming 4 is the USE action.\n\n  return collect_actions + actions_to_workshop", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T23:08:00.211142", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index of the goal item\n  goal_index = env.world.cookbook.index[item]\n  if goal_index is None:\n    print(f\"Item {item} not found in cookbook.\")\n    return []\n\n  # Get the primitives required for crafting the goal item\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  \n  # Check if we have all the primitives in our inventory\n  inventory_has_all_primitives = True\n  for primitive_index, count_required in required_primitives.items():\n    if env._current_state.inventory[primitive_index] < count_required:\n      inventory_has_all_primitives = False\n      break\n  \n  if not inventory_has_all_primitives:\n    print(f\"Inventory does not have all the required primitives to craft {item}.\")\n    return []\n\n  # Get the workshop where the goal item can be crafted\n  for recipe, ingredients in env.world.cookbook.recipes.items():\n    if \"_at\" in ingredients and ingredients[\"_key\"] == goal_index:\n      workshop_name = ingredients[\"_at\"]\n      break\n  \n  workshop_index = env.world.cookbook.index[workshop_name]\n  \n  # Find the position of the required workshop\n  workshop_pos = None\n  for x in range(env._current_state.grid.shape[0]):\n    for y in range(env._current_state.grid.shape[1]):\n      if np.any(env._current_state.grid[x, y, :]) == workshop_index:\n        workshop_pos = (x, y)\n        break\n    if workshop_pos is not None:\n      break\n  \n  if workshop_pos is None:\n    print(f\"Workshop {workshop_name} not found in the environment.\")\n    return []\n\n  # Calculate the path to the workshop\n  start_pos = env._current_state.pos\n  path_to_workshop = a_star_search(env, start_pos, workshop_pos)\n\n  if not path_to_workshop:\n    print(f\"No valid path to workshop {workshop_name} found.\")\n    return []\n\n  actions.extend(path_to_workshop)\n  \n  # Add action to face the workshop and use it\n  final_direction = calculate_direction(env._current_state.pos, workshop_pos)\n  actions.append(final_direction)\n  actions.append(4)  # USE action\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-10T23:08:01.169962", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  index = cookbook.index\n  actions = []\n  \n  # Get the index of the item to craft\n  goal_index = index[item]\n  \n  # Check if the item has a recipe in the cookbook\n  if goal_index not in cookbook.recipes:\n    print(f\"No recipe found for {item}\")\n    return []\n\n  # Get the required ingredients and their counts from the recipe\n  recipe = cookbook.recipes[goal_index]\n\n  # Collect all required primitives or intermediate items\n  for ingredient, count in recipe.items():\n      if ingredient == \"_key\":\n          continue\n\n      ingredient_name = index.get(ingredient)\n      # Check if we already have enough of this ingredient\n      if env._current_state.inventory[ingredient] >= count:\n          continue\n      \n      # Collect the required amount of the ingredient\n      collect_actions = collect(env, ingredient_name)\n      actions.extend(collect_actions)\n\n  # Determine the workshop where the item can be crafted\n  workshop_key = recipe.get(\"_key\")\n  workshop_index = None\n\n  if workshop_key is not None:\n      workshop_name = index.get(workshop_key)\n      workshop_indices = env.world.workshop_indices\n      for idx in workshop_indices:\n          if env.world.cookbook.index.get(idx) == workshop_name:\n              workshop_index = idx\n              break\n  \n  # Navigate to the workshop and craft the item\n  if workshop_index is not None:\n      # Find the position of a nearby cell containing the workshop\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n      \n      for wp in workshop_positions:\n          # Check if we are already next to a workshop\n          if env._current_state.next_to(workshop_index):\n              actions.append(4)  # USE action to craft the item\n              break\n\n          # Calculate the direction to move towards the nearest workshop cell\n          dx = wp[0] - env._current_state.pos[0]\n          dy = wp[1] - env._current_state.pos[1]\n\n          if abs(dx) > abs(dy):\n              actions.append(2 if dx < 0 else 3)  # LEFT or RIGHT\n          else:\n              actions.append(0 if dy < 0 else 1)  # DOWN or UP\n      \n      # Add the USE action to craft the item\n      actions.append(4)\n  else:\n      print(f\"No workshop specified for crafting {item}\")\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-10T23:10:11.795488", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index for the goal item\n  goal_index = env.world.cookbook.index[item]\n\n  # Get the primitives required to make the goal item\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  \n  # Check if we have all the required primitives in inventory\n  for prim, count in required_primitives.items():\n    if env._current_state.inventory[prim] < count:\n      return []  # Return empty list if any primitive is not sufficient\n\n  # Identify the workshop where crafting should occur\n  for recipe_output, ingredients in env.world.cookbook.recipes.items():\n    if recipe_output == goal_index and \"_key\" in ingredients:\n      workshop_key = ingredients[\"_key\"]\n      break\n  else:\n    return []  # No valid workshop found\n  \n  # Find the index of the workshop\n  workshop_index = env.world.cookbook.index[workshop_key]\n\n  # Locate the workshop on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n    return []  # Workshop not found on the grid\n\n  # Navigate to the nearest workshop\n  agent_pos = env._current_state.pos\n  closest_workshop = min(workshop_positions, key=lambda x: np.linalg.norm(np.array(x) - np.array(agent_pos)))\n\n  # Calculate relative positions and directions\n  dx, dy = closest_workshop[0] - agent_pos[0], closest_workshop[1] - agent_pos[1]\n  \n  while tuple(agent_pos) != tuple(closest_workshop):\n    direction = None\n    \n    if dx > 0:\n      direction = (3, (agent_pos[0] + 1, agent_pos[1]))  # RIGHT\n    elif dx < 0:\n      direction = (2, (agent_pos[0] - 1, agent_pos[1]))  # LEFT\n    elif dy > 0:\n      direction = (4, (agent_pos[0], agent_pos[1] + 1))  # DOWN\n    elif dy < 0:\n      direction = (1, (agent_pos[0], agent_pos[1] - 1))  # UP\n    \n    actions.append(direction[0])\n    agent_pos = direction[1]\n\n  # Check if the agent is already facing the correct direction to use the workshop\n  current_direction = env._current_state.agent_dir  # Assuming this attribute exists\n\n  target_direction = None\n  if closest_workshop[0] == agent_pos[0]:\n    if closest_workshop[1] > agent_pos[1]:\n      target_direction = 4  # DOWN\n    else:\n      target_direction = 1  # UP\n  elif closest_workshop[1] == agent_pos[1]:\n    if closest_workshop[0] > agent_pos[0]:\n      target_direction = 3  # RIGHT\n    else:\n      target_direction = 2  # LEFT\n  \n  if current_direction != target_direction:\n    actions.extend(get_turn_actions(current_direction, target_direction))\n  \n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T23:10:12.860082", "function_name": "craft", "function_body": "  actions = []\n\n  # Get the index for the goal item\n  goal_index = env.world.cookbook.index[item]\n\n  # Check if we have all the required primitives in inventory\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n\n  # Verify that all primitives are available in sufficient quantities\n  for prim, count in required_primitives.items():\n    if env._current_state.inventory[prim] < count:\n      return []  # Return empty list if any primitive is not sufficient\n\n  # Identify the workshop where crafting should occur\n  workshop_index = None\n  for recipe_output, ingredients in env.world.cookbook.recipes.items():\n    if recipe_output == goal_index and \"_key\" in ingredients:\n      workshop_key = ingredients[\"_key\"]\n      workshop_index = env.world.cookbook.index[workshop_key]\n      break\n\n  if workshop_index is None:\n    return []  # No valid workshop found\n\n  # Locate the workshops on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    return []  # Workshop not found on the grid\n\n  # Navigate to the nearest workshop using BFS\n  agent_pos = env._current_state.pos\n  closest_workshop = min(workshop_positions, key=lambda x: np.linalg.norm(np.array(x) - np.array(agent_pos)))\n\n  from collections import deque\n\n  def bfs(start, end):\n    q = deque([(start, [])])\n    visited = set()\n    while q:\n      (x, y), path = q.popleft()\n      if (x, y) in visited:\n          continue\n      visited.add((x, y))\n      if (x, y) == end:\n          return path\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n            if np.all(env._current_state.grid[nx, ny, :] == 0):  # Check if the cell is empty\n                q.append(((nx, ny), path + [(dx, dy)]))\n    return []\n\n  path_to_workshop = bfs(agent_pos, closest_workshop)\n\n  if not path_to_workshop:\n      return []  # No valid path found\n\n  for dx, dy in path_to_workshop:\n    if dx > 0:\n        actions.append(3)  # RIGHT\n    elif dx < 0:\n        actions.append(2)  # LEFT\n    elif dy > 0:\n        actions.append(4)  # DOWN\n    elif dy < 0:\n        actions.append(1)  # UP\n\n  # Ensure the agent is facing the correct direction to use the workshop\n  final_directions = []\n  if closest_workshop[0] == agent_pos[0]:\n    if closest_workshop[1] > agent_pos[1]:\n      final_directions.append(4)  # DOWN\n    else:\n      final_directions.append(1)  # UP\n  elif closest_workshop[1] == agent_pos[1]:\n    if closest_workshop[0] > agent_pos[0]:\n      final_directions.append(3)  # RIGHT\n    else:\n      final_directions.append(2)  # LEFT\n\n  actions.extend(final_directions)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T23:12:34.171872", "function_name": "craft", "function_body": "  def get_direction_to_target(pos, target_pos):\n    dy = target_pos[0] - pos[0]\n    dx = target_pos[1] - pos[1]\n\n    if dx > 0:\n        return craft.RIGHT\n    elif dx < 0:\n        return craft.LEFT\n    elif dy > 0:\n        return craft.DOWN\n    elif dy < 0:\n        return craft.UP\n    else:\n        return None\n\n  def find_closest_workshop(pos, workshop_indices):\n      closest_distance = float('inf')\n      closest_index = None\n      \n      for idx in workshop_indices:\n          pos_idx = env.world.workshop_indices[idx]\n          distance = np.linalg.norm(np.array(pos) - np.array(pos_idx))\n          \n          if distance < closest_distance:\n              closest_distance = distance\n              closest_index = idx\n      \n      return closest_index\n\n  def move_to_workshop_and_align_direction(state, workshop_index):\n    target_pos = env.world.workshop_indices[workshop_index]\n    actions = []\n    \n    # Calculate the direction to the workshop\n    while state.pos != target_pos:\n        direction = get_direction_to_target(state.pos, target_pos)\n        if direction is not None and state.dir == direction:\n            actions.append(craft.MOVE_FORWARD)  # Assuming MOVE_FORWARD is defined in craft module\n        else:\n            actions.extend(turn_towards_direction(state.dir, direction))\n        \n        # Update the state after each action\n        _, new_state = state.step(actions[-1])\n        state = new_state\n    \n    return align_direction_with_target(state.pos, target_pos)\n\n  def turn_towards_direction(current_dir, target_dir):\n      directions = [craft.UP, craft.RIGHT, craft.DOWN, craft.LEFT]\n      current_index = directions.index(current_dir)\n      target_index = directions.index(target_dir)\n      \n      # Calculate the shortest path to target direction\n      if (target_index - current_index) % 4 == 1:\n          return [craft.TURN_RIGHT]\n      elif (target_index - current_index) % 4 == 2:\n          return [craft.TURN_AROUND]\n      elif (target_index - current_index) % 4 == 3:\n          return [craft.TURN_LEFT]\n      else:\n          return []\n\n  def align_direction_with_target(pos, target_pos):\n    direction = get_direction_to_target(pos, target_pos)\n    if direction is not None:\n        return [direction]\n    return []\n\n  def collect_v2(env, primitive_index) -> list[int]:\n    actions = []\n    \n    # Search for the primitive in the environment\n    grid = env._current_state.features_dict['grid']\n    positions = np.argwhere(grid == primitive_index)\n    \n    if len(positions) > 0:\n        closest_primitive_pos = find_closest_target(env._current_state.pos, positions)\n        \n        # Move to the closest primitive and collect it\n        actions.extend(move_to_workshop_and_align_direction(env._current_state, closest_primitive_pos))\n        actions.append(craft.USE)\n    \n    return actions\n\n  def get_primitives_recursively(env, item_index) -> dict[str, int]:\n      cookbook = env.world.cookbook\n      primitives_needed = collections.defaultdict(int)\n      \n      # Recursive function to get all primitives needed\n      def get_primitives(item_index):\n          if item_index in cookbook.recipes:\n              recipe = cookbook.recipes[item_index]\n              for primitive, count in recipe.items():\n                  if primitive != \"_key\":\n                      get_primitives(cookbook.index[primitive])\n                      primitives_needed[primitive] += count\n      \n      get_primitives(item_index)\n      \n      return dict(primitives_needed)\n\n  def find_closest_target(pos, positions):\n    closest_distance = float('inf')\n    closest_position = None\n    \n    for position in positions:\n        distance = np.linalg.norm(np.array(pos) - np.array(position))\n        \n        if distance < closest_distance:\n            closest_distance = distance\n            closest_position = tuple(position)\n    \n    return closest_position\n\n  actions = []\n  \n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we already have the required item in inventory or if it's a primitive\n  if env._current_state.inventory[item_index] > 0 or item_index in env.world.grabbable_indices:\n    return actions\n  \n  # Get all primitives needed to craft this item recursively\n  primitives_needed = get_primitives_recursively(env, item_index)\n  \n  # Collect all the required primitives\n  for primitive, count in primitives_needed.items():\n      actions.extend(collect_v2(env, env.world.cookbook.index.get(primitive)))\n      \n  # Determine the workshop to use based on the recipe\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_name = list(recipe[\"_key\"].split(\"_at=\"))[1] if \"_key\" in recipe else None\n  \n  # If we have a valid workshop, proceed to it\n  if workshop_name:\n      workshop_indices = [idx for idx, name in enumerate(env.world.workshop_indices) \n                          if workshop_name in env.world.cookbook.index.get(name)]\n      \n      # Find the closest workshop of the desired type\n      closest_workshop_index = find_closest_workshop(env._current_state.pos, workshop_indices)\n      \n      # Move to the closest workshop and align direction correctly before using\n      actions.extend(move_to_workshop_and_align_direction(env._current_state, closest_workshop_index))\n      \n      # Craft the item at the workshop\n      actions.append(craft.USE)\n  \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T23:12:35.280655", "function_name": "craft", "function_body": "  def get_direction_to_target(pos, target_pos):\n    dy = target_pos[0] - pos[0]\n    dx = target_pos[1] - pos[1]\n\n    if abs(dx) > abs(dy):\n        return craft.RIGHT if dx > 0 else craft.LEFT\n    elif abs(dy) > abs(dx):\n        return craft.DOWN if dy > 0 else craft.UP\n    else:\n        return None\n\n  def find_closest_workshop(pos, workshop_indices):\n      closest_distance = float('inf')\n      closest_index = None\n      \n      for idx in workshop_indices:\n          pos_idx = env.world.workshop_indices[idx]\n          distance = np.linalg.norm(np.array(pos) - np.array(pos_idx))\n          \n          if distance < closest_distance:\n              closest_distance = distance\n              closest_index = idx\n      \n      return closest_distance, closest_index\n\n  def move_to_workshop_and_align_direction(state, workshop_index):\n    target_pos = env.world.workshop_indices[workshop_index]\n    actions = []\n    \n    # Calculate the direction to the workshop\n    direction = get_direction_to_target(state.pos, target_pos)\n    \n    while state.pos != target_pos:\n        if direction is not None and state.dir == direction:\n            actions.append(craft.MOVE_FORWARD)  # Assuming MOVE_FORWARD is defined in craft module\n        else:\n            actions.extend(turn_towards_direction(state.dir, direction))\n        \n        # Update the state after each action\n        _, new_state = state.step(actions[-1])\n        state = new_state\n    \n    return align_direction_with_target(state.pos, target_pos)\n\n  def turn_towards_direction(current_dir, target_dir):\n      directions = [craft.UP, craft.RIGHT, craft.DOWN, craft.LEFT]\n      current_index = directions.index(current_dir)\n      target_index = directions.index(target_dir)\n      \n      # Calculate the shortest path to target direction\n      if (target_index - current_index) % 4 == 1:\n          return [craft.TURN_RIGHT]\n      elif (target_index - current_index) % 4 == 2:\n          return [craft.TURN_AROUND]\n      elif (target_index - current_index) % 4 == 3:\n          return [craft.TURN_LEFT]\n      else:\n          return []\n\n  def align_direction_with_target(pos, target_pos):\n    direction = get_direction_to_target(pos, target_pos)\n    if direction is not None:\n        return [direction]\n    return []\n\n  actions = []\n  \n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we already have the required item in inventory or if it's a primitive\n  if env._current_state.inventory[item_index] > 0 or item_index in env.world.grabbable_indices:\n    return actions\n  \n  # Get all primitives needed to craft this item recursively\n  primitives_needed = get_primitives_recursively(env, item_index)\n  \n  # Collect all the required primitives\n  for primitive, count in primitives_needed.items():\n      actions.extend(collect_v2(env, env.world.cookbook.index.get(primitive)))\n      \n  # Determine the workshop to use based on the recipe\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_name = list(recipe[\"_key\"].split(\"_at=\"))[1] if \"_key\" in recipe else None\n  \n  # If we have a valid workshop, proceed to it\n  if workshop_name:\n      workshop_indices = [idx for idx, name in enumerate(env.world.workshop_indices) \n                          if workshop_name in env.world.cookbook.index.get(name)]\n      \n      # Find the closest workshop of the desired type\n      _, closest_workshop_index = find_closest_workshop(env._current_state.pos, workshop_indices)\n      \n      # Move to the closest workshop and align direction correctly before using\n      actions.extend(move_to_workshop_and_align_direction(env._current_state, closest_workshop_index))\n      \n      # Craft the item at the workshop\n      actions.append(craft.USE)\n  \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T23:13:43.030847", "function_name": "craft", "function_body": "  # Get the current state\n  state = env._current_state\n\n  # Check if the goal item is already in the inventory\n  goal_index = env.world.cookbook.index[item]\n  if state.inventory[goal_index] > 0:\n    return []\n\n  # Get the primitives required for crafting the goal item\n  primitives_needed = env.world.cookbook.primitives_for(goal_index)\n\n  # Collect all the needed primitives\n  actions_to_collect_primitives = []\n  for primitive_name, count in primitives_needed.items():\n    primitive_index = env.world.cookbook.index[primitive_name]\n    while state.inventory[primitive_index] < count:\n      # Find the positions of the required primitives on the grid\n      positions_of_primitive = np.argwhere(state.grid[:, :, primitive_index] > 0)\n      if len(positions_of_primitive) == 0:\n        raise ValueError(f\"Could not find any {primitive_name} to collect.\")\n      \n      # Move towards one of these positions (we'll choose the first one for simplicity)\n      target_pos = tuple(positions_of_primitive[0])\n      while state.pos != target_pos:\n        direction_to_move = calculate_direction(state.pos, target_pos)\n        actions_to_collect_primitives.append(direction_to_move)\n        _, state = env.step(direction_to_move)\n      \n      # Collect the primitive\n      actions_to_collect_primitives.append(craft.USE)\n      _, state = env.step(craft.USE)\n\n  # Now that we have all the primitives, move to the correct workshop and craft the item\n  workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n    if goal_index in recipe:\n      workshop_key = next(key for key in recipe if \"_at\" in key)\n      workshop_name = recipe[workshop_key]\n      workshop_index = env.world.cookbook.index[workshop_name]\n      break\n\n  if workshop_index is None:\n    raise ValueError(\"Could not find a suitable workshop to craft the item.\")\n\n  # Find the positions of the workshop\n  positions_of_workshop = np.argwhere(state.grid[:, :, workshop_index] > 0)\n  if len(positions_of_workshop) == 0:\n    raise ValueError(f\"Could not find the {workshop_name}.\")\n\n  # Move towards one of these positions (we'll choose the first one for simplicity)\n  target_pos = tuple(positions_of_workshop[0])\n  while state.pos != target_pos:\n    direction_to_move = calculate_direction(state.pos, target_pos)\n    actions_to_collect_primitives.append(direction_to_move)\n    _, state = env.step(direction_to_move)\n\n  # Craft the item\n  actions_to_collect_primitives.append(craft.USE)\n  _, state = env.step(craft.USE)\n\n  return actions_to_collect_primitives", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-10T23:13:43.990306", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index for the item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the primitives required to craft the item\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  \n  # If no recipe is found, return an empty action list\n  if not required_primitives:\n    print(f\"No recipe for {item}\")\n    return []\n  \n  # Collect missing primitives\n  current_inventory = {env.world.cookbook.index.get(i_kind): count for i_kind, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  # Calculate the missing primitives needed to craft the item\n  missing_primitives = {i_kind: required - current for i_kind, required in required_primitives.items() \n                        for current in [current_inventory.get(i_kind, 0)] \n                        if required - current > 0}\n  \n  # Collect the missing primitives\n  for primitive_index, quantity_needed in missing_primitives.items():\n    primitive_name = env.world.cookbook.index.get(primitive_index)\n    actions.extend(collect(env, primitive_name))\n    \n  # Find the workshop where the item can be crafted\n  recipe = env.world.cookbook.recipes[item_index]\n  if \"_at\" not in recipe:\n    print(f\"No specified workshop for {item}\")\n    return []\n  \n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the nearest position to the workshop\n  nearest_workshop_pos = find_nearest_position(env._current_state.grid, workshop_index)\n  if not nearest_workshop_pos:\n    print(f\"No path to {workshop_name}\")\n    return []\n\n  # Move to the nearest position of the workshop\n  actions.extend(move_to_position(env._current_state.pos, nearest_workshop_pos))\n\n  # Use the USE action to craft the item (assuming facing the correct direction)\n  actions.append(4)  # USE action\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-10T23:14:54.247830", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index of the item to be crafted from the cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    print(f\"No recipe found for {item}.\")\n    return actions\n  \n  # Get the required ingredients and their counts from the recipe\n  recipe = env.world.cookbook.recipes[item_index]\n  \n  # Check if all ingredients are available in the inventory\n  missing_ingredients = []\n  for ingredient, count in recipe.items():\n    if ingredient == \"_key\":\n      continue\n    ingredient_index = env.world.cookbook.index[ingredient]\n    if env._current_state.inventory[ingredient_index] < count:\n      missing_ingredients.append(ingredient)\n  \n  # If there are any missing ingredients, we cannot craft the item yet\n  if missing_ingredients:\n    print(f\"Missing ingredients: {missing_ingredients}. Cannot craft {item} at this time.\")\n    return actions\n  \n  # Determine the workshop where crafting needs to be done\n  workshop_key = \"_key\"\n  workshop_index = None\n  for ingredient, count in recipe.items():\n    if ingredient == workshop_key:\n      workshop_name = recipe[ingredient]\n      workshop_index = env.world.cookbook.index[workshop_name]\n      break\n  \n  # If no workshop is specified in the recipe, crafting cannot be done\n  if workshop_index is None:\n    print(f\"No workshop found for crafting {item}.\")\n    return actions\n  \n  # Find the position of the workshop on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  \n  # If there are no workshops available, we cannot craft the item\n  if len(workshop_positions) == 0:\n    print(f\"No available {workshop_name} found.\")\n    return actions\n  \n  # Choose one of the available workshops to go to\n  target_workshop = tuple(workshop_positions[0])\n  \n  # Navigate to the workshop\n  navigation_actions = navigate_to(env, target_workshop)\n  if not navigation_actions:\n    print(f\"Could not find a path to {workshop_name}.\")\n    return actions\n  \n  actions.extend(navigation_actions)\n  \n  # Turn to face the workshop and use the USE action to craft the item\n  facing_direction = calculate_facing_direction(env._current_state.pos, target_workshop)\n  if facing_direction != env._current_state.dir:\n    turn_action = [facing_direction]\n    actions.extend(turn_action)\n  \n  use_action = [env.world.n_actions - 1]  # Assuming USE is the last action\n  actions.append(use_action[0])\n  \n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-10T23:14:55.201855", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index for the desired item using the cookbook index\n  goal_index = env.world.cookbook.index[item]\n  \n  # Check if we have all primitives required to craft the goal\n  primitive_counts = env.world.cookbook.primitives_for(goal_index)\n  current_inventory = env._current_state.inventory\n  \n  # Check if the agent has all necessary primitives in inventory\n  for prim, count in primitive_counts.items():\n    if current_inventory[prim] < count:\n      return []  # Return empty action list if any primitive is insufficient\n\n  # Get workshop index from recipe\n  workshop_index = None\n  for key, value in env.world.cookbook.recipes[goal_index].items():\n    if \"_at\" in key:\n      workshop_index = env.world.cookbook.index[value]\n      break\n  \n  if workshop_index is None:\n    return []  # Return empty action list if no workshop is specified\n\n  # Find the nearest workshop\n  def manhattan_distance(pos1, pos2):\n    return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n\n  grid = env._current_state.grid\n  agent_pos = env._current_state.pos\n  nearest_workshop_pos = None\n  min_distance = float('inf')\n\n  for y in range(grid.shape[0]):\n    for x in range(grid.shape[1]):\n      if grid[y, x, workshop_index] == 1:\n        distance = manhattan_distance(agent_pos, (x, y))\n        if distance < min_distance:\n          min_distance = distance\n          nearest_workshop_pos = (x, y)\n\n  if nearest_workshop_pos is None:\n    return []  # Return empty action list if no workshop of the required type is found\n\n  # Calculate actions to move to the nearest workshop\n  path_to_workshop = get_path(env._current_state.grid, agent_pos, nearest_workshop_pos)\n  \n  for step in path_to_workshop:\n    if step[0] == agent_pos[0]:\n      if step[1] > agent_pos[1]: # Move down\n        actions.append(1)\n      elif step[1] < agent_pos[1]: # Move up\n        actions.append(0)\n    else: \n      if step[0] > agent_pos[0]: # Move right\n        actions.append(3)\n      elif step[0] < agent_pos[0]: # Move left\n        actions.append(2)\n\n  # Add USE action to craft the item at the workshop\n  actions.append(4) # Assuming USE is represented by 4\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-10T23:16:30.149286", "function_name": "craft", "function_body": "  def get_crafting_requirements(item_index):\n    required_primitives = env.world.cookbook.primitives_for(item_index)\n    return required_primitives\n  \n  def find_workshop(item_index):\n    for recipe in env.world.cookbook.recipes.values():\n      if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n        workshop_key = recipe.get(\"_at\")\n        if workshop_key is not None:\n          return getattr(env.world, f\"{workshop_key}_index\", None)\n    return None\n  \n  def plan_crafting(item_index):\n    required_primitives = get_crafting_requirements(item_index)\n    actions = []\n    \n    for primitive, count in required_primitives.items():\n      if env._current_state.inventory[primitive] < count:\n        # Collect the missing primitives\n        actions.extend(collect(env, env.world.cookbook.index.get(get_name_from_index(primitive), \"\")))\n        if not check_inventory(env, primitive, count):\n          return []  # If we still don't have enough after collection, return empty list\n\n    target_workshop = find_workshop(item_index)\n    if target_workshop is None:\n      return []\n\n    start_pos = env._current_state.pos\n    grid_with_target = env._current_state.grid.copy()\n    grid_with_target[:, :, target_workshop] += 1000  # Marking the target workshop for A* search\n\n    target_pos = find_closest_object(grid_with_target, start_pos, target_workshop)\n    \n    if target_pos is None:\n      return []  # No path to the target workshop\n    \n    path_to_workshop = a_star_search(env._current_state.grid, start_pos, target_pos)\n\n    for pos in path_to_workshop[:-1]:  # Exclude the last position as we'll be facing it when we reach\n        actions.extend(move_to_target(env._current_state.grid, env._current_state.pos, pos))\n\n    final_pos = path_to_workshop[-1]\n    actions.append(rotate_to_face(env._current_state, final_pos, target_workshop))\n    actions.append(4)  # Use action\n\n    return actions\n  \n  item_index = env.world.cookbook.index[item]\n  \n  def check_inventory(env, primitive, count):\n      \"\"\"Check if the inventory has enough of a specific primitive.\"\"\"\n      return env._current_state.inventory[primitive] >= count\n\n  def get_name_from_index(index):\n    \"\"\"Get the name of the primitive from its index in the cookbook.\"\"\"\n    for key, value in env.world.cookbook.index.items():\n        if value == index:\n            return key\n    return None\n  \n  return plan_crafting(item_index)", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-10T23:16:31.183839", "function_name": "craft", "function_body": "  def get_crafting_requirements(item_index):\n    required_primitives = env.world.cookbook.primitives_for(item_index)\n    return required_primitives\n  \n  def find_workshop(item_index):\n    for recipe in env.world.cookbook.recipes.values():\n      if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n        workshop_key = recipe.get(\"_at\")\n        if workshop_key is not None:\n          return getattr(env.world, f\"{workshop_key}_index\", None)\n    return None\n  \n  def plan_crafting(item_index):\n    required_primitives = get_crafting_requirements(item_index)\n    actions = []\n    \n    for primitive, count in required_primitives.items():\n      if env._current_state.inventory[primitive] < count:\n        collect_actions = collect(env, env.world.cookbook.index.get(primitive))\n        actions.extend(collect_actions)\n        while env._current_state.inventory[primitive] < count:\n          collect_actions = collect(env, env.world.cookbook.index.get(primitive))\n          actions.extend(collect_actions)\n    \n    target_workshop = find_workshop(item_index)\n    if target_workshop is None:\n      return []\n    \n    start_pos = env._current_state.pos\n    grid_with_target = env._current_state.grid.copy()\n    grid_with_target[:, :, target_workshop] += 1000  # Marking the target workshop for A* search\n\n    target_pos = find_closest_object(grid_with_target, start_pos, target_workshop)\n    \n    if target_pos is None:\n      return []  # No path to the target workshop\n    \n    path_to_workshop = a_star_search(env._current_state.grid, start_pos, target_pos)\n\n    for pos in path_to_workshop[:-1]:  # Exclude the last position as we'll be facing it when we reach\n        actions.extend(move_to_target(env._current_state.grid, env._current_state.pos, pos))\n\n    final_pos = path_to_workshop[-1]\n    actions.append(rotate_to_face(env._current_state, final_pos, target_workshop))\n    actions.append(4)  # Use action\n\n    return actions\n  \n  item_index = env.world.cookbook.index[item]\n  \n  return plan_crafting(item_index)", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-10T23:19:05.283990", "function_name": "craft", "function_body": "  def bfs(start, end):\n    q = collections.deque([(start, [])])\n    visited = set()\n    while q:\n      (x, y), path = q.popleft()\n      if (x, y) in visited:\n          continue\n      visited.add((x, y))\n      if (x, y) == end:\n          return path\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n            if np.all(env._current_state.grid[nx, ny, :] == 0):  # Check if the cell is empty\n                q.append(((nx, ny), path + [(dx, dy)]))\n    return []\n\n  actions = []\n\n  # Get the index for the goal item\n  goal_index = env.world.cookbook.index[item]\n\n  # Get the primitives required to make the goal item\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n\n  # Check if we have all the required primitives in inventory\n  for prim, count in required_primitives.items():\n    if env._current_state.inventory[prim] < count:\n      return []  # Return empty list if any primitive is not sufficient\n\n  # Identify the workshop where crafting should occur\n  workshop_index = None\n  for recipe_output, ingredients in env.world.cookbook.recipes.items():\n    if recipe_output == goal_index and \"_key\" in ingredients:\n      workshop_key = ingredients[\"_key\"]\n      workshop_index = env.world.cookbook.index[workshop_key]\n      break\n\n  if workshop_index is None:\n    return []  # No valid workshop found\n\n  # Locate the workshop on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    return []  # Workshop not found on the grid\n\n  # Navigate to the nearest workshop using BFS\n  agent_pos = env._current_state.pos\n  closest_workshop = min(workshop_positions, key=lambda x: np.linalg.norm(np.array(x) - np.array(agent_pos)))\n\n  path_to_workshop = bfs(agent_pos, closest_workshop)\n  \n  if not path_to_workshop:\n      return []  # No valid path found\n\n  for dx, dy in path_to_workshop:\n    if dx > 0:\n        actions.append(3)  # RIGHT\n    elif dx < 0:\n        actions.append(2)  # LEFT\n    elif dy > 0:\n        actions.append(4)  # DOWN\n    elif dy < 0:\n        actions.append(1)  # UP\n\n  # Ensure the agent is facing the workshop before using it\n  final_directions = []\n  if closest_workshop[0] == agent_pos[0]:\n    if closest_workshop[1] > agent_pos[1]:\n      final_directions.append(4)  # DOWN\n    else:\n      final_directions.append(1)  # UP\n  elif closest_workshop[1] == agent_pos[1]:\n    if closest_workshop[0] > agent_pos[0]:\n      final_directions.append(3)  # RIGHT\n    else:\n      final_directions.append(2)  # LEFT\n\n  actions.extend(final_directions)\n  \n  # Check if the agent is already facing the workshop before using it\n  current_dir = env._current_state.dir\n  target_dir = None\n  if closest_workshop[0] == agent_pos[0]:\n    if closest_workshop[1] > agent_pos[1]:\n      target_dir = 4  # DOWN\n    else:\n      target_dir = 1  # UP\n  elif closest_workshop[1] == agent_pos[1]:\n    if closest_workshop[0] > agent_pos[0]:\n      target_dir = 3  # RIGHT\n    else:\n      target_dir = 2  # LEFT\n\n  if current_dir != target_dir:\n      actions.append(target_dir)  # Change direction to face the workshop\n  \n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T23:19:06.342436", "function_name": "craft", "function_body": "  def bfs(start, end):\n    q = collections.deque([(start, [])])\n    visited = set()\n    while q:\n      (x, y), path = q.popleft()\n      if (x, y) in visited:\n          continue\n      visited.add((x, y))\n      if (x, y) == end:\n          return path\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n            if np.all(env._current_state.grid[nx, ny, :] == 0):  # Check if the cell is empty\n                q.append(((nx, ny), path + [(dx, dy)]))\n    return []\n\n  def get_directions_to_face(x1, y1, x2, y2):\n      directions = []\n      if y2 > y1:\n          directions.append(4)  # DOWN\n      elif y2 < y1:\n          directions.append(1)  # UP\n      if x2 > x1:\n          directions.append(3)  # RIGHT\n      elif x2 < x1:\n          directions.append(2)  # LEFT\n      return directions\n\n  actions = []\n\n  # Get the index for the goal item\n  goal_index = env.world.cookbook.index[item]\n\n  # Get the primitives required to make the goal item\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n\n  # Check if we have all the required primitives in inventory\n  for prim, count in required_primitives.items():\n    if env._current_state.inventory[prim] < count:\n      return []  # Return empty list if any primitive is not sufficient\n\n  # Identify the workshop where crafting should occur\n  workshop_index = None\n  for recipe_output, ingredients in env.world.cookbook.recipes.items():\n    if recipe_output == goal_index and \"_key\" in ingredients:\n      workshop_key = ingredients[\"_key\"]\n      workshop_index = env.world.cookbook.index[workshop_key]\n      break\n\n  if workshop_index is None:\n    return []  # No valid workshop found\n\n  # Locate the workshop on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    return []  # Workshop not found on the grid\n\n  # Navigate to the nearest workshop using BFS\n  agent_pos = env._current_state.pos\n  closest_workshop = min(workshop_positions, key=lambda x: np.linalg.norm(np.array(x) - np.array(agent_pos)))\n\n  path_to_workshop = bfs(agent_pos, closest_workshop)\n  \n  if not path_to_workshop:\n      return []  # No valid path found\n\n  for dx, dy in path_to_workshop:\n    if dx > 0:\n        actions.append(3)  # RIGHT\n    elif dx < 0:\n        actions.append(2)  # LEFT\n    elif dy > 0:\n        actions.append(4)  # DOWN\n    elif dy < 0:\n        actions.append(1)  # UP\n\n  # Ensure the agent is facing the workshop before using it\n  final_directions = get_directions_to_face(agent_pos[0], agent_pos[1], closest_workshop[0], closest_workshop[1])\n  actions.extend(final_directions)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T23:21:57.247209", "function_name": "craft", "function_body": "  def get_primitives_recursively(env, goal_index):\n    \"\"\"Helper function to recursively find all primitives needed for crafting an item.\"\"\"\n    if goal_index in env.world.primitives:\n      return {goal_index: 1}\n    \n    primitives = {}\n    recipe = env.world.cookbook.recipes[goal_index]\n    for ingredient, count in recipe.items():\n        if ingredient == \"_key\":\n            continue\n        ingredient_index = env.world.cookbook.index[ingredient]\n        if ingredient_index in env.world.primitives:\n          if ingredient_index not in primitives:\n              primitives[ingredient_index] = 0\n          primitives[ingredient_index] += count\n        else:\n          sub_primitives = get_primitives_recursively(env, ingredient_index)\n          for p, c in sub_primitives.items():\n            if p not in primitives:\n                primitives[p] = 0\n            primitives[p] += c * count\n    \n    return primitives\n\n  def find_closest_workshop(pos, workshop_indices):\n      closest_distance = float('inf')\n      closest_index = None\n      \n      for idx in workshop_indices:\n          pos_idx = env.world.workshop_indices[idx]\n          distance = np.linalg.norm(np.array(pos) - np.array(pos_idx))\n          \n          if distance < closest_distance:\n              closest_distance = distance\n              closest_index = idx\n      \n      return closest_index\n\n  def move_to_workshop_and_align_direction(state, workshop_index):\n    target_pos = env.world.workshop_indices[workshop_index]\n    actions = []\n    \n    # Calculate the direction to the workshop\n    direction = get_direction_to_target(state.pos, target_pos)\n    \n    while state.pos != target_pos:\n        if direction is not None and state.dir == direction:\n            actions.append(craft.MOVE_FORWARD)  # Assuming MOVE_FORWARD is defined in craft module\n        else:\n            actions.extend(turn_towards_direction(state.dir, direction))\n        \n        # Update the state after each action\n        _, new_state = state.step(actions[-1])\n        state = new_state\n    \n    return align_direction_with_target(state.pos, target_pos)\n\n  def turn_towards_direction(current_dir, target_dir):\n      directions = [craft.UP, craft.RIGHT, craft.DOWN, craft.LEFT]\n      current_index = directions.index(current_dir)\n      target_index = directions.index(target_dir)\n      \n      # Calculate the shortest path to target direction\n      if (target_index - current_index) % 4 == 1:\n          return [craft.TURN_RIGHT]\n      elif (target_index - current_index) % 4 == 2:\n          return [craft.TURN_AROUND]\n      elif (target_index - current_index) % 4 == 3:\n          return [craft.TURN_LEFT]\n      else:\n          return []\n\n  def align_direction_with_target(pos, target_pos):\n    direction = get_direction_to_target(pos, target_pos)\n    if direction is not None:\n        return [direction]\n    return []\n\n  actions = []\n  \n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we already have the required item in inventory or if it's a primitive\n  if env._current_state.inventory[item_index] > 0:\n    return actions\n  \n  # Get all primitives needed to craft this item recursively\n  primitives_needed = get_primitives_recursively(env, item_index)\n  \n  # Collect all the required primitives\n  for primitive, count in primitives_needed.items():\n      for _ in range(count):\n          actions.extend(collect_v2(env, env.world.cookbook.index.get(primitive)))\n      \n  # Determine the workshop to use based on the recipe\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_name = list(recipe[\"_key\"].split(\"_at=\"))[1] if \"_key\" in recipe else None\n  \n  # If we have a valid workshop, proceed to it\n  if workshop_name:\n      workshop_indices = [idx for idx, name in enumerate(env.world.workshop_indices) \n                          if workshop_name in env.world.cookbook.index.get(name)]\n      \n      # Find the closest workshop of the desired type\n      closest_workshop_index = find_closest_workshop(env._current_state.pos, workshop_indices)\n      \n      # Move to the closest workshop and align direction correctly before using\n      actions.extend(move_to_workshop_and_align_direction(env._current_state, closest_workshop_index))\n      \n      # Craft the item at the workshop\n      actions.append(craft.USE)\n  \n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-10T23:21:58.316488", "function_name": "craft", "function_body": "  def get_primitives_recursively(env, goal_index):\n    \"\"\"Helper function to recursively find all primitives needed for crafting an item.\"\"\"\n    if goal_index in env.world.primitives:\n      return {goal_index: 1}\n    \n    primitives = {}\n    recipe = env.world.cookbook.recipes[goal_index]\n    for ingredient, count in recipe.items():\n        if ingredient == \"_key\":\n            continue\n        ingredient_index = env.world.cookbook.index[ingredient]\n        if ingredient_index in env.world.primitives:\n          if ingredient_index not in primitives:\n              primitives[ingredient_index] = 0\n          primitives[ingredient_index] += count\n        else:\n          sub_primitives = get_primitives_recursively(env, ingredient_index)\n          for p, c in sub_primitives.items():\n            if p not in primitives:\n                primitives[p] = 0\n            primitives[p] += c * count\n    \n    return primitives\n\n  def find_closest_workshop(pos, workshop_indices):\n      closest_distance = float('inf')\n      closest_index = None\n      \n      for idx in workshop_indices:\n          pos_idx = env.world.workshop_indices[idx]\n          distance = np.linalg.norm(np.array(pos) - np.array(pos_idx))\n          \n          if distance < closest_distance:\n              closest_distance = distance\n              closest_index = idx\n      \n      return closest_index\n\n  def move_to_workshop_and_align_direction(state, workshop_index):\n    target_pos = env.world.workshop_indices[workshop_index]\n    actions = []\n    \n    # Calculate the direction to the workshop\n    direction = get_direction_to_target(state.pos, target_pos)\n    \n    while state.pos != target_pos:\n        if direction is not None and state.dir == direction:\n            actions.append(craft.MOVE_FORWARD)  # Assuming MOVE_FORWARD is defined in craft module\n        else:\n            actions.extend(turn_towards_direction(state.dir, direction))\n        \n        # Update the state after each action\n        _, new_state = state.step(actions[-1])\n        state = new_state\n    \n    return align_direction_with_target(state.pos, target_pos)\n\n  def turn_towards_direction(current_dir, target_dir):\n      directions = [craft.UP, craft.RIGHT, craft.DOWN, craft.LEFT]\n      current_index = directions.index(current_dir)\n      target_index = directions.index(target_dir)\n      \n      # Calculate the shortest path to target direction\n      if (target_index - current_index) % 4 == 1:\n          return [craft.TURN_RIGHT]\n      elif (target_index - current_index) % 4 == 2:\n          return [craft.TURN_AROUND]\n      elif (target_index - current_index) % 4 == 3:\n          return [craft.TURN_LEFT]\n      else:\n          return []\n\n  def align_direction_with_target(pos, target_pos):\n    direction = get_direction_to_target(pos, target_pos)\n    if direction is not None:\n        return [direction]\n    return []\n\n  actions = []\n  \n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we already have the required item in inventory or if it's a primitive\n  if env._current_state.inventory[item_index] > 0 or item_index in env.world.grabbable_indices:\n    return actions\n  \n  # Get all primitives needed to craft this item recursively\n  primitives_needed = get_primitives_recursively(env, item_index)\n  \n  # Collect all the required primitives\n  for primitive, count in primitives_needed.items():\n      for _ in range(count):\n          actions.extend(collect_v2(env, env.world.cookbook.index.get(primitive)))\n      \n  # Determine the workshop to use based on the recipe\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_name = list(recipe[\"_key\"].split(\"_at=\"))[1] if \"_key\" in recipe else None\n  \n  # If we have a valid workshop, proceed to it\n  if workshop_name:\n      workshop_indices = [idx for idx, name in enumerate(env.world.workshop_indices) \n                          if workshop_name in env.world.cookbook.index.get(name)]\n      \n      # Find the closest workshop of the desired type\n      closest_workshop_index = find_closest_workshop(env._current_state.pos, workshop_indices)\n      \n      # Move to the closest workshop and align direction correctly before using\n      actions.extend(move_to_workshop_and_align_direction(env._current_state, closest_workshop_index))\n      \n      # Craft the item at the workshop\n      actions.append(craft.USE)\n  \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T23:23:22.081595", "function_name": "craft", "function_body": "  # Translate item name to index\n  item_index = env.world.cookbook.index[item]\n\n  # Get primitives required for the item\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n\n  actions = []\n  \n  # Check if all required primitives are in inventory\n  have_all_prerequisites = True\n  for primitive, count in required_primitives.items():\n      if env._current_state.inventory[primitive] < count:\n          have_all_prerequisites = False\n\n  if not have_all_prerequisites:\n      return []  # Return empty action list if prerequisites are not met\n  \n  # Determine the workshop to use based on the recipe\n  workshop_key = None\n  for ingredient, _ in env.world.cookbook.recipes[item_index].items():\n      if isinstance(ingredient, str) and ingredient.startswith(\"_key\"):\n          workshop_key = ingredient\n          break\n\n  if workshop_key is None:\n      return []  # Return empty action list if no workshop key is found\n  \n  workshop_name = env.world.cookbook.recipes[item_index][workshop_key]\n  \n  # Get the index of the workshop in the cookbook's index\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find all positions of the workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  \n  if len(workshop_positions) == 0:\n      return []  # Return empty action list if no workshops are found\n  \n  # Choose the closest workshop (for simplicity, we choose the first one in the list)\n  target_workshop_pos = tuple(workshop_positions[0])\n\n  # Move to the position next to the chosen workshop\n  actions.extend(find_path(env._current_state, target_workshop_pos))\n  \n  # Turn towards the workshop and use it\n  actions.append(direction_action_towards_target(env._current_state, target_workshop_pos))\n  actions.append(craft.ACTION_USE)\n  \n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T23:23:23.056043", "function_name": "craft", "function_body": "  # Convert the item name to its corresponding index in the cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the item has a recipe in the cookbook\n  if item_index not in env.world.cookbook.recipes:\n    print(f\"No recipe found for {item}.\")\n    return []\n  \n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes[item_index]\n  \n  # Determine which workshop is required to craft the item\n  required_workshop = None\n  for key in recipe.keys():\n      if \"_at\" in key:\n          required_workshop = key.split(\"_\")[1]\n          break\n  \n  if not required_workshop:\n    print(f\"No workshop found in the recipe for {item}.\")\n    return []\n  \n  # Convert the workshop name to its corresponding index in the world\n  workshop_index = env.world.cookbook.index[required_workshop]\n  \n  # Find all positions of the required workshop on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  \n  if len(workshop_positions) == 0:\n    print(f\"No {required_workshop} found on the grid.\")\n    return []\n  \n  # Choose the first available workshop position (could be improved to find the closest one)\n  workshop_pos = tuple(workshop_positions[0])\n  \n  # Get the list of ingredients required for the item\n  ingredients_needed = {}\n  for key, value in recipe.items():\n      if \"_at\" not in key:\n          ingredient_index = env.world.cookbook.index[key]\n          ingredients_needed[ingredient_index] = value\n  \n  # Collect the ingredients needed to craft the item\n  actions_to_collect_ingredients = []\n  for ingredient_index, count in ingredients_needed.items():\n      while env._current_state.inventory[ingredient_index] < count:\n          actions_to_collect_ingredient = collect(env, ingredient_index)\n          actions_to_collect_ingredients.extend(actions_to_collect_ingredient)\n  \n  # Move to the workshop\n  move_actions = move_to_position(env._current_state.pos, workshop_pos)\n  actions_to_move_to_workshop = [env.world.N_ACTIONS[action] for action in move_actions]\n  \n  # Face the workshop and use it to craft the item\n  face_workshop_action = face_direction(env._current_state.pos, workshop_pos)\n  actions_to_face_and_use = [face_workshop_action, env.world.USE]\n  \n  # Combine all actions into one list\n  all_actions = actions_to_collect_ingredients + actions_to_move_to_workshop + actions_to_face_and_use\n  \n  return all_actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-10T23:25:29.093468", "function_name": "craft", "function_body": "  def get_primitives_recursively(env, item_index):\n    primitives_needed = collections.defaultdict(int)\n\n    # Base case: if the item is a primitive\n    if item_index in env.world.grabbable_indices:\n      return {env.world.cookbook.index.get(item_index): 1}\n\n    # Recursive case: find primitives for each required item\n    recipe = env.world.cookbook.recipes[item_index]\n    for ingredient, count in recipe.items():\n        if ingredient == \"_key\":\n            continue\n\n        ingredient_index = env.world.cookbook.index[ingredient]\n        sub_primitives = get_primitives_recursively(env, ingredient_index)\n\n        # Accumulate the primitives needed\n        for primitive, sub_count in sub_primitives.items():\n            primitives_needed[primitive] += count * sub_count\n\n    return dict(primitives_needed)\n\n  actions = []\n  \n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we already have the required item in inventory or if it's a primitive\n  if env._current_state.inventory[item_index] > 0 or item_index in env.world.grabbable_indices:\n    return actions\n  \n  # Get all primitives needed to craft this item recursively\n  primitives_needed = get_primitives_recursively(env, item_index)\n  \n  # Collect all the required primitives\n  for primitive, count in primitives_needed.items():\n      actions.extend(collect_v2(env, env.world.cookbook.index.get(primitive)))\n      \n  # Determine the workshop to use based on the recipe\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_name = list(recipe[\"_key\"].split(\"_at=\"))[1] if \"_key\" in recipe else None\n  \n  # If we have a valid workshop, proceed to it\n  if workshop_name:\n      workshop_indices = [idx for idx, name in enumerate(env.world.workshop_indices) \n                          if workshop_name in env.world.cookbook.index.get(name)]\n      \n      # Find the closest workshop of the desired type\n      closest_workshop_index = find_closest_workshop(env._current_state.pos, workshop_indices)\n      \n      # Move to the closest workshop and align direction correctly before using\n      actions.extend(move_to_workshop_and_align_direction(env._current_state, closest_workshop_index))\n      \n      # Craft the item at the workshop\n      actions.append(craft.USE)\n  \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T23:25:30.158006", "function_name": "craft", "function_body": "  def get_primitives_recursively(env, item_index):\n    primitives_needed = collections.defaultdict(int)\n\n    # Base case: if the item is a primitive\n    if item_index in env.world.grabbable_indices:\n      return {env.world.cookbook.index.get(item_index): 1}\n\n    # Recursive case: find primitives for each required item\n    recipe = env.world.cookbook.recipes[item_index]\n    for ingredient, count in recipe.items():\n        if ingredient == \"_key\":\n            continue\n\n        ingredient_index = env.world.cookbook.index[ingredient]\n        sub_primitives = get_primitives_recursively(env, ingredient_index)\n\n        # Accumulate the primitives needed\n        for primitive, sub_count in sub_primitives.items():\n            primitives_needed[primitive] += count * sub_count\n\n    return dict(primitives_needed)\n  \n  def find_closest_workshop(pos, workshop_indices):\n    min_distance = float('inf')\n    closest_workshop_index = None\n    \n    # Find the closest workshop to the current position\n    for idx in workshop_indices:\n      x1, y1 = pos\n      x2, y2 = env.world.workshop_indices[idx]\n      distance = abs(x2 - x1) + abs(y2 - y1)\n      \n      if distance < min_distance:\n        min_distance = distance\n        closest_workshop_index = idx\n    \n    return closest_workshop_index\n  \n  def move_to_workshop_and_align_direction(state, workshop_idx):\n    actions = []\n    \n    # Get the position of the workshop and current position\n    workshop_pos = env.world.workshop_indices[workshop_idx]\n    current_pos = state.pos\n    \n    # Calculate direction to move towards the workshop\n    x_diff = workshop_pos[0] - current_pos[0]\n    y_diff = workshop_pos[1] - current_pos[1]\n    \n    if x_diff > 0:\n      actions.extend([craft.RIGHT] * abs(x_diff))\n    elif x_diff < 0:\n      actions.extend([craft.LEFT] * abs(x_diff))\n      \n    if y_diff > 0:\n      actions.extend([craft.DOWN] * abs(y_diff))\n    elif y_diff < 0:\n      actions.extend([craft.UP] * abs(y_diff))\n    \n    # Align direction correctly before using\n    target_dir = None\n    if x_diff == 0 and y_diff == 1: target_dir = craft.DOWN\n    elif x_diff == 0 and y_diff == -1: target_dir = craft.UP\n    elif x_diff == 1 and y_diff == 0: target_dir = craft.RIGHT\n    elif x_diff == -1 and y_diff == 0: target_dir = craft.LEFT\n    \n    if target_dir is not None:\n      actions.append(target_dir)\n    \n    return actions\n\n  def move_to_primitive_and_align_direction(state, primitive_idx):\n    actions = []\n    \n    # Find the positions of all cells containing the primitive\n    grid = state.grid\n    primitive_positions = [(x, y) for x in range(grid.shape[0]) for y in range(grid.shape[1]) if grid[x, y, primitive_idx] > 0]\n    \n    if not primitive_positions:\n      return actions\n    \n    # Calculate Manhattan distances from current position to all possible primitives\n    current_pos = state.pos\n    min_distance = float('inf')\n    closest_primitive_pos = None\n    \n    for pos in primitive_positions:\n      x1, y1 = current_pos\n      x2, y2 = pos\n      distance = abs(x2 - x1) + abs(y2 - y1)\n      \n      if distance < min_distance:\n        min_distance = distance\n        closest_primitive_pos = pos\n    \n    # Calculate direction to move towards the closest primitive\n    x_diff = closest_primitive_pos[0] - current_pos[0]\n    y_diff = closest_primitive_pos[1] - current_pos[1]\n    \n    if x_diff > 0:\n      actions.extend([craft.RIGHT] * abs(x_diff))\n    elif x_diff < 0:\n      actions.extend([craft.LEFT] * abs(x_diff))\n      \n    if y_diff > 0:\n      actions.extend([craft.DOWN] * abs(y_diff))\n    elif y_diff < 0:\n      actions.extend([craft.UP] * abs(y_diff))\n    \n    # Align direction correctly before using\n    target_dir = None\n    if x_diff == 0 and y_diff == 1: target_dir = craft.DOWN\n    elif x_diff == 0 and y_diff == -1: target_dir = craft.UP\n    elif x_diff == 1 and y_diff == 0: target_dir = craft.RIGHT\n    elif x_diff == -1 and y_diff == 0: target_dir = craft.LEFT\n    \n    if target_dir is not None:\n      actions.append(target_dir)\n    \n    return actions\n\n  def collect_v2(env, primitive):\n    \"\"\"Function to collect a given type of primitive.\"\"\"\n    actions = []\n    \n    # Get the index of the desired primitive\n    primitive_index = env.world.cookbook.index[primitive]\n    \n    if not env._current_state.next_to(primitive_index):\n      actions.extend(move_to_primitive_and_align_direction(env._current_state, primitive_index))\n    \n    actions.append(craft.USE)\n    \n    return actions\n\n  actions = []\n  \n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we already have the required item in inventory or if it's a primitive\n  if env._current_state.inventory[item_index] > 0 or item_index in env.world.grabbable_indices:\n    return actions\n  \n  # Get all primitives needed to craft this item recursively\n  primitives_needed = get_primitives_recursively(env, item_index)\n  \n  # Collect all the required primitives\n  for primitive, count in primitives_needed.items():\n      actions.extend(collect_v2(env, env.world.cookbook.index.get(primitive)))\n      \n  # Determine the workshop to use based on the recipe\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_name = list(recipe[\"_key\"].split(\"_at=\"))[1] if \"_key\" in recipe else None\n  \n  # If we have a valid workshop, proceed to it\n  if workshop_name:\n      workshop_indices = [idx for idx, name in enumerate(env.world.workshop_indices) \n                          if workshop_name in env.world.cookbook.index.get(name)]\n      \n      # Find the closest workshop of the desired type\n      closest_workshop_index = find_closest_workshop(env._current_state.pos, workshop_indices)\n      \n      # Move to the closest workshop and align direction correctly before using\n      actions.extend(move_to_workshop_and_align_direction(env._current_state, closest_workshop_index))\n      \n      # Craft the item at the workshop\n      actions.append(craft.USE)\n  \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T23:27:03.728269", "function_name": "craft", "function_body": "  def move_and_use(target_position):\n    current_position = np.array(env._current_state.pos)\n    dx = target_position[0] - current_position[0]\n    dy = target_position[1] - current_position[1]\n\n    actions_to_take = []\n\n    # Calculate the necessary movements\n    if dx > 0:\n      actions_to_take.extend([craft.MOVE_RIGHT for _ in range(dx)])\n    elif dx < 0:\n      actions_to_take.extend([craft.MOVE_LEFT for _ in range(-dx)])\n\n    if dy > 0:\n      actions_to_take.extend([craft.MOVE_DOWN for _ in range(dy)])\n    elif dy < 0:\n      actions_to_take.extend([craft.MOVE_UP for _ in range(-dy)])\n\n    # Calculate the target direction to face the workshop\n    current_direction = env._current_state.dir\n\n    if dx == 0 and dy == 0:  # Already at the target position\n        pass\n    elif abs(dx) >= abs(dy):\n        target_direction = craft.RIGHT if dx > 0 else craft.LEFT\n    else:\n        target_direction = craft.DOWN if dy > 0 else craft.UP\n\n    while current_direction != target_direction:\n      actions_to_take.append(craft.TURN_RIGHT)\n      current_direction = (current_direction + 1) % 4\n\n    # Add the USE action to interact with the object at the target position\n    actions_to_take.append(craft.USE)\n\n    return actions_to_take\n\n\n  item_index = env.world.cookbook.index[item]\n  \n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n\n  # Check if we have all ingredients in inventory to craft this item\n  required_ingredients = {env.world.cookbook.index[k]: v for k, v in recipe.items() if k != \"_at\"}\n\n  available_inventory = {k: count for k, count in enumerate(env._current_state.inventory)}\n\n  # Check if all ingredients are available\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if available_inventory.get(ingredient_index, 0) < required_count:\n      can_craft = False\n      break\n\n  actions_to_take = []\n\n  if not can_craft:\n    return actions_to_take\n\n  # Determine the workshop to use based on the \"_at\" field of the recipe\n  workshop_name = recipe.get(\"_at\", None)\n  if workshop_name is not None:\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find all positions of the required workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n    if len(workshop_positions) == 0:\n      raise ValueError(\"No available workshop to craft item\")\n\n    # Select the nearest workshop\n    current_position = np.array(env._current_state.pos)\n    distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n    nearest_workshop_index = np.argmin(distances_to_workshops)\n    nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n    # Move to and use the workshop\n    actions_to_take.extend(move_and_use(nearest_workshop_pos))\n\n  else:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T23:27:04.712380", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  if not item_index:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  required_ingredients = recipe.copy()\n\n  available_inventory = {cookbook.index[k]: v for k, v in env._current_state.inventory.items()}\n\n  # Check if all ingredients are available\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if not can_craft:\n    return []\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No available workshop to craft item\")\n\n  # Select the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n  # Calculate actions to move the agent to the nearest workshop\n  dx = nearest_workshop_pos[0] - current_position[0]\n  dy = nearest_workshop_pos[1] - current_position[1]\n\n  actions_to_take = []\n\n  if dx > 0:\n    actions_to_take.extend([craft.MOVE_RIGHT for _ in range(dx)])\n  elif dx < 0:\n    actions_to_take.extend([craft.MOVE_LEFT for _ in range(-dx)])\n\n  if dy > 0:\n    actions_to_take.extend([craft.MOVE_DOWN for _ in range(dy)])\n  elif dy < 0:\n    actions_to_take.extend([craft.MOVE_UP for _ in range(-dy)])\n\n  # Calculate the target direction to face the workshop\n  current_direction = env._current_state.dir\n\n  if dx == 0 and dy == 0:  # Already at the workshop\n      pass\n  elif abs(dx) >= abs(dy):\n      target_direction = craft.RIGHT if dx > 0 else craft.LEFT\n  else:\n      target_direction = craft.DOWN if dy > 0 else craft.UP\n\n  while current_direction != target_direction:\n    actions_to_take.append(craft.TURN_RIGHT)\n    current_direction = (current_direction + 1) % 4\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-10T23:28:06.496288", "function_name": "craft", "function_body": "  # Step 1: Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Step 2: Check if we have all required primitives for crafting\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  actions = []\n\n  for primitive, count in primitives_needed.items():\n    while env._current_state.inventory[primitive] < count:\n      # Find the position of the primitive on the grid\n      pos = np.argwhere(env._current_state.grid[:, :, primitive] > 0)\n\n      if len(pos) == 0:\n        return []  # Primitive not found\n\n      # Step towards the first occurrence of the primitive\n      target_pos = tuple(pos[0])\n\n      while env._current_state.pos != target_pos:\n        # Calculate direction to move\n        dx, dy = target_pos[0] - env._current_state.pos[0], target_pos[1] - env._current_state.pos[1]\n        if dx > 0:\n          actions.append(env.world.N_ACTIONS.DOWN)\n        elif dx < 0:\n          actions.append(env.world.N_ACTIONS.UP)\n        elif dy > 0:\n          actions.append(env.world.N_ACTIONS.RIGHT)\n        else:\n          actions.append(env.world.N_ACTIONS.LEFT)\n\n        # Move the agent\n        env._current_state = env.step(actions[-1])[1]\n\n      # Collect the primitive\n      actions.append(env.world.N_ACTIONS.USE)\n      env._current_state = env.step(actions[-1])[1]\n\n  # Step 3: Go to the workshop specified in the recipe and perform USE action\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_key = \"_at\"\n  if workshop_key not in recipe:\n    return []  # Workshop not specified in recipe\n\n  workshop_name = recipe[workshop_key]\n\n  # Get the index of the workshop\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the workshop on the grid\n  pos = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(pos) == 0:\n    return []  # Workshop not found\n\n  # Step towards the first occurrence of the workshop\n  target_pos = tuple(pos[0])\n\n  while env._current_state.pos != target_pos:\n    # Calculate direction to move\n    dx, dy = target_pos[0] - env._current_state.pos[0], target_pos[1] - env._current_state.pos[1]\n    if dx > 0:\n      actions.append(env.world.N_ACTIONS.DOWN)\n    elif dx < 0:\n      actions.append(env.world.N_ACTIONS.UP)\n    elif dy > 0:\n      actions.append(env.world.N_ACTIONS.RIGHT)\n    else:\n      actions.append(env.world.N_ACTIONS.LEFT)\n\n    # Move the agent\n    env._current_state = env.step(actions[-1])[1]\n\n  # Craft the item by performing USE action at the workshop\n  actions.append(env.world.N_ACTIONS.USE)\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-10T23:28:07.475366", "function_name": "craft", "function_body": "  actions = []\n  \n  # Check if we have the required primitives for crafting\n  item_index = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes.get(item_index)\n  \n  if not recipe:\n    print(f\"No recipe found for {item}.\")\n    return []\n\n  # Get the required primitives and their counts\n  required_primitives = {}\n  workshop = None\n  \n  for ingredient, count in recipe.items():\n    if ingredient == \"_at\":\n      workshop = env.world.cookbook.index[count]\n    else:\n      primitive_index = env.world.cookbook.index[ingredient]\n      required_primitives[primitive_index] = count\n\n  # Check if we have all the required primitives\n  for primitive, count in required_primitives.items():\n    if env._current_state.inventory[primitive_index] < count:\n      print(f\"Not enough {env.world.cookbook.index.get(primitive)} to craft {item}.\")\n      return []\n  \n  # If we have all required primitives, proceed to the workshop\n  current_pos = env._current_state.pos\n  \n  # Find a path to the workshop\n  path_to_workshop = find_path(env._current_state.grid, current_pos, workshop)\n  \n  if not path_to_workshop:\n    print(f\"No path found to {workshop}.\")\n    return []\n  \n  actions.extend(path_to_workshop)\n  \n  # Once at the workshop, use the USE action\n  actions.append(craft.USE)\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-10T23:31:21.282406", "function_name": "craft", "function_body": "  def get_primitives_recursively(env, item_index):\n    primitives = {}\n    if item_index in env.world.grabbable_indices:\n        primitives[env.world.cookbook.index.get(item_index)] = 1\n    else:\n        recipe = env.world.cookbook.recipes[item_index]\n        for key, value in recipe.items():\n            if key != \"_key\":\n                primitive_name = list(env.world.cookbook.index.keys())[list(env.world.cookbook.index.values()).index(int(key))]\n                primitives[primitive_name] = value + (primitives.get(primitive_name, 0))\n    return primitives\n\n  def get_direction_to_target(pos, target_pos):\n      dy = target_pos[0] - pos[0]\n      dx = target_pos[1] - pos[1]\n      \n      if dx > 0:\n          return craft.RIGHT\n      elif dx < 0:\n          return craft.LEFT\n      elif dy > 0:\n          return craft.DOWN\n      elif dy < 0:\n          return craft.UP\n      else:\n          return None\n\n  def find_closest_workshop(pos, workshop_indices):\n      distances = [(abs(pos[0] - env.world.workshop_indices[idx][0]) + abs(pos[1] - env.world.workshop_indices[idx][1]), idx) for idx in workshop_indices]\n      return min(distances, key=lambda x: x[0])[1]\n\n  def move_to_workshop_and_align_direction_v2(state, workshop_index):\n    actions = []\n    \n    # Get the target position of the closest workshop\n    workshop_pos = env.world.workshop_indices[workshop_index]\n    \n    # Calculate the direction to move towards the workshop\n    while state.pos != workshop_pos:\n        target_dir = get_direction_to_target(state.pos, workshop_pos)\n        if target_dir != state.dir:\n            actions.append(target_dir)\n        else:\n            actions.append(craft.USE)  # Incorrect action, should be a move\n        state = craft.CraftState(step=state.step + 1, pos=workshop_pos, dir=target_dir, grid=state.grid, inventory=state.inventory)\n    \n    # Align the direction to face the workshop before using\n    target_dir = get_direction_to_target(state.pos, workshop_pos)\n    if target_dir != state.dir:\n        actions.append(target_dir)\n    \n    return actions\n\n  def collect_v2(env, primitive):\n      actions = []\n      \n      while env._current_state.inventory[primitive] == 0:\n          # Find the closest cell with the required primitive\n          nearest_cell = find_closest_primitive_cell(env._current_state.grid, primitive)\n          \n          if nearest_cell is None:\n              break\n          \n          # Move to the nearest cell containing the primitive\n          actions.extend(move_to_and_align_direction(env._current_state.pos, nearest_cell))\n          \n          # Collect the primitive at the target position\n          actions.append(craft.USE)\n          \n      return actions\n\n  def find_closest_primitive_cell(grid, primitive):\n      positions = np.argwhere(grid[:, :, primitive] > 0)\n      if len(positions) == 0:\n          return None\n      \n      min_distance = float('inf')\n      nearest_cell = None\n      for pos in positions:\n          distance = abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n          if distance < min_distance:\n              min_distance = distance\n              nearest_cell = tuple(pos)\n      \n      return nearest_cell\n\n  def move_to_and_align_direction(current_pos, target_pos):\n      actions = []\n      \n      # Calculate the direction to move towards the target position\n      while current_pos != target_pos:\n          target_dir = get_direction_to_target(current_pos, target_pos)\n          \n          if target_dir != env._current_state.dir:\n              actions.append(target_dir)\n              env._current_state.dir = target_dir  # Update the state's direction\n          else:\n              actions.append(craft.MOVE_FORWARD)  # Move forward in the current direction\n              current_pos = (current_pos[0] + (1 if env._current_state.dir == craft.DOWN else -1 if env._current_state.dir == craft.UP else 0),\n                             current_pos[1] + (1 if env._current_state.dir == craft.RIGHT else -1 if env._current_state.dir == craft.LEFT else 0))\n      \n      # Align the direction to face the target position before using\n      target_dir = get_direction_to_target(current_pos, target_pos)\n      if target_dir != env._current_state.dir:\n          actions.append(target_dir)\n      \n      return actions\n  \n  actions = []\n  \n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we already have the required item in inventory or if it's a primitive\n  if env._current_state.inventory[item_index] > 0 or item_index in env.world.grabbable_indices:\n    return []\n  \n  # Get all primitives needed to craft this item\n  primitives_needed = get_primitives_recursively(env, item_index)\n  \n  # Collect all the required primitives\n  for primitive, count in primitives_needed.items():\n      actions.extend(collect_v2(env, env.world.cookbook.index.get(primitive)))\n      \n  # Determine the workshop to use based on the recipe\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_name = list(recipe[\"_key\"].split(\"_at=\"))[1] if \"_key\" in recipe else None\n  \n  if workshop_name:\n      workshop_indices = [idx for idx, name in enumerate(env.world.workshop_indices) \n                          if f\"{workshop_name}\" in env.world.cookbook.index.get(name)]\n      \n      # Find the closest workshop of the desired type\n      closest_workshop_index = find_closest_workshop(env._current_state.pos, workshop_indices)\n      \n      # Move to the closest workshop and align direction correctly before using\n      actions.extend(move_to_workshop_and_align_direction_v2(env._current_state, closest_workshop_index))\n      \n      # Craft the item at the workshop\n      actions.append(craft.USE)\n  \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T23:31:22.330878", "function_name": "craft", "function_body": "  def get_primitives_recursively(env, item_index):\n    primitives_needed = collections.defaultdict(int)\n    if item_index in env.world.grabbable_indices:\n        primitives_needed[env.world.cookbook.index.get(item_index)] += 1\n        return primitives_needed\n\n    recipe = env.world.cookbook.recipes[item_index]\n    for primitive, count in recipe.items():\n      if primitive == \"_key\":\n          continue\n      primitive_index = env.world.cookbook.index.get(primitive)\n      primitives_needed.update(get_primitives_recursively(env, primitive_index))\n      primitives_needed[primitive] += count\n\n    return primitives_needed\n  \n  def get_direction_to_target(pos, target_pos):\n      dy = target_pos[0] - pos[0]\n      dx = target_pos[1] - pos[1]\n      \n      if dx > 0:\n          return craft.RIGHT\n      elif dx < 0:\n          return craft.LEFT\n      elif dy > 0:\n          return craft.DOWN\n      elif dy < 0:\n          return craft.UP\n      else:\n          return None\n  \n  def find_closest_workshop(pos, workshop_indices):\n    closest_distance = float('inf')\n    closest_index = None\n    for index in workshop_indices:\n        workshop_pos = env.world.cookbook.index.get(env.world.workshop_indices[index])\n        distance = abs(workshop_pos[0] - pos[0]) + abs(workshop_pos[1] - pos[1])\n        if distance < closest_distance:\n            closest_distance = distance\n            closest_index = index\n    return closest_index\n  \n  def move_to_workshop_and_align_direction_v2(state, workshop_index):\n      actions = []\n      \n      # Get the target position of the workshop\n      workshop_pos = env.world.cookbook.index.get(env.world.workshop_indices[workshop_index])\n      \n      while state.pos != workshop_pos:\n          direction = get_direction_to_target(state.pos, workshop_pos)\n          \n          if direction == craft.RIGHT:\n              actions.append(craft.RIGHT)\n              state.pos = (state.pos[0], state.pos[1] + 1)\n          elif direction == craft.LEFT:\n              actions.append(craft.LEFT)\n              state.pos = (state.pos[0], state.pos[1] - 1)\n          elif direction == craft.DOWN:\n              actions.append(craft.DOWN)\n              state.pos = (state.pos[0] + 1, state.pos[1])\n          elif direction == craft.UP:\n              actions.append(craft.UP)\n              state.pos = (state.pos[0] - 1, state.pos[1])\n      \n      # Align the agent's direction to face the workshop\n      final_direction = get_direction_to_target(state.pos, workshop_pos)\n      if final_direction is not None and final_direction != state.dir:\n          actions.append(final_direction)\n          state.dir = final_direction\n      \n      return actions\n  \n  actions = []\n  \n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we already have the required item in inventory or if it's a primitive\n  if env._current_state.inventory[item_index] > 0 or item_index in env.world.grabbable_indices:\n    return []\n  \n  # Get all primitives needed to craft this item recursively\n  primitives_needed = get_primitives_recursively(env, item_index)\n  \n  # Collect all the required primitives\n  for primitive, count in primitives_needed.items():\n      actions.extend(collect_v2(env, env.world.cookbook.index.get(primitive)))\n      \n  # Determine the workshop to use based on the recipe\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_name = list(recipe[\"_key\"].split(\"_at=\"))[1] if \"_key\" in recipe else None\n  \n  if workshop_name:\n      workshop_indices = [idx for idx, name in enumerate(env.world.workshop_indices) \n                          if f\"{workshop_name}\" in env.world.cookbook.index.get(name)]\n      \n      # Find the closest workshop of the desired type\n      closest_workshop_index = find_closest_workshop(env._current_state.pos, workshop_indices)\n      \n      # Move to the closest workshop and align direction correctly before using\n      actions.extend(move_to_workshop_and_align_direction_v2(env._current_state, closest_workshop_index))\n      \n      # Craft the item at the workshop\n      actions.append(craft.USE)\n  \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T23:34:48.065299", "function_name": "craft", "function_body": "  def navigate_bfs(grid, start_pos, target_indices):\n    \"\"\"Navigate the agent towards an item using BFS.\"\"\"\n    width, height = grid.shape[:2]\n    queue = collections.deque([start_pos])\n    visited = set()\n    parent = {start_pos: None}\n\n    while queue:\n        current_pos = queue.popleft()\n\n        if any(grid[current_pos[0], current_pos[1], i] > 0 for i in target_indices):\n            # Reconstruct path from start to target\n            path = []\n            while current_pos is not None:\n                path.append(current_pos)\n                current_pos = parent[current_pos]\n            return path[::-1]\n\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n            if 0 <= new_x < width and 0 <= new_y < height and (new_x, new_y) not in visited:\n                queue.append((new_x, new_y))\n                visited.add((new_x, new_y))\n                parent[(new_x, new_y)] = current_pos\n\n    return None\n\n  def navigate_to_item(env, target_indices):\n    \"\"\"Navigate the agent towards an item using BFS.\"\"\"\n    grid = env._current_state.grid\n    start_pos = env._current_state.pos\n    path = navigate_bfs(grid, start_pos, target_indices)\n    \n    if not path:\n      print(\"No valid path found to the items.\")\n      return []\n\n    actions = []\n    for next_pos in path[1:]:\n        dx = next_pos[0] - env._current_state.pos[0]\n        dy = next_pos[1] - env._current_state.pos[1]\n\n        if dx == 1:\n            actions.append(env.world.N_ACTIONS - 3)  # RIGHT action\n        elif dx == -1:\n            actions.append(env.world.N_ACTIONS - 4)  # LEFT action\n        elif dy == 1:\n            actions.append(env.world.N_ACTIONS - 2)  # DOWN action\n        elif dy == -1:\n            actions.append(env.world.N_ACTIONS - 5)  # UP action\n\n    return actions\n\n  def collect_primitive(env, primitive_name):\n    \"\"\"Helper function to collect a primitive.\"\"\"\n    primitive_index = env.world.cookbook.index[primitive_name]\n    \n    if primitive_index not in env.world.grabbable_indices:\n      raise ValueError(f\"{primitive_name} is not a grabbable item.\")\n    \n    actions = []\n    required_count = recipe.get(primitive_name, 0)\n    current_count = env._current_state.inventory[primitive_index]\n\n    while current_count < required_count:\n        target_indices = [primitive_index]\n        positions = navigate_to_item(env, target_indices)\n        \n        if not positions:\n          raise ValueError(f\"No available {primitive_name} to collect.\")\n        \n        actions.extend(positions)\n        actions.append(env.world.N_ACTIONS - 1)  # USE action\n        \n        current_count += 1\n\n    return actions\n\n  def find_workshop_position(env, workshop_name):\n    \"\"\"Find the position of a specific workshop in the grid.\"\"\"\n    grid = env._current_state.grid\n    workshop_index = env.world.cookbook.index[f\"workshop{workshop_name}\"]\n    \n    pos_list = np.argwhere(grid[:, :, workshop_index] > 0)\n    if len(pos_list) == 0:\n        raise ValueError(f\"No available {workshop_name} to navigate to.\")\n    return pos_list[0].tolist()\n\n  def check_inventory(env, required_items):\n    \"\"\"Check if the agent already has all required items in the inventory.\"\"\"\n    for item_name, count in required_items.items():\n        if isinstance(item_name, str) and not item_name.startswith('_'):\n            index = env.world.cookbook.index[item_name]\n            if env._current_state.inventory[index] < count:\n                return False\n    return True\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the goal item is a primitive or not in the recipes\n  if item_index in env.world.grabbable_indices:\n      return []  # Primitives cannot be crafted\n  \n  # Retrieve the recipe for the desired item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Determine the workshop required for crafting\n  workshop_key = \"_at\"\n  workshop_name = next((k.split('_')[1] for k in recipe if k.startswith(workshop_key)), None)\n  if not workshop_name:\n      raise ValueError(f\"No workshop specified for crafting {item}.\")\n  \n  workshop_index = env.world.cookbook.index[f\"workshop{workshop_name}\"]\n  workshop_pos = find_workshop_position(env, f\"workshop{workshop_name}\")\n\n  actions = []\n\n  # Check if we already have all the required items\n  if not check_inventory(env, recipe):\n      # Collect all required primitives or intermediate items\n      for req_item_name, count in recipe.items():\n          if isinstance(req_item_name, str) and not req_item_name.startswith('_'):\n              actions.extend(collect_primitive(env, req_item_name))\n      \n  # Navigate to the workshop and use it to craft the item\n  actions.extend(navigate_to_item(env, [workshop_index]))\n  \n  if env._current_state.next_to(workshop_index):\n    actions.append(env.world.N_ACTIONS - 1)  # USE action\n\n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T23:34:49.130412", "function_name": "craft", "function_body": "  def navigate_bfs(grid, start_pos, target_indices):\n    \"\"\"Navigate the agent towards an item using BFS.\"\"\"\n    width, height = grid.shape[:2]\n    queue = collections.deque([start_pos])\n    visited = set()\n    parent = {start_pos: None}\n\n    while queue:\n        current_pos = queue.popleft()\n\n        if any(grid[current_pos[0], current_pos[1], i] > 0 for i in target_indices):\n            # Reconstruct path from start to target\n            path = []\n            while current_pos is not None:\n                path.append(current_pos)\n                current_pos = parent[current_pos]\n            return path[::-1]\n\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n            if 0 <= new_x < width and 0 <= new_y < height and (new_x, new_y) not in visited:\n                queue.append((new_x, new_y))\n                visited.add((new_x, new_y))\n                parent[(new_x, new_y)] = current_pos\n\n    return None\n\n  def navigate_to_item(env, target_indices):\n    \"\"\"Navigate the agent towards an item using BFS.\"\"\"\n    grid = env._current_state.grid\n    start_pos = env._current_state.pos\n    path = navigate_bfs(grid, start_pos, target_indices)\n    \n    if not path:\n      print(\"No valid path found to the items.\")\n      return []\n\n    actions = []\n    for next_pos in path[1:]:\n        dx = next_pos[0] - env._current_state.pos[0]\n        dy = next_pos[1] - env._current_state.pos[1]\n\n        if dx == 1:\n            actions.append(env.world.N_ACTIONS - 3)  # RIGHT action\n        elif dx == -1:\n            actions.append(env.world.N_ACTIONS - 4)  # LEFT action\n        elif dy == 1:\n            actions.append(env.world.N_ACTIONS - 2)  # DOWN action\n        elif dy == -1:\n            actions.append(env.world.N_ACTIONS - 5)  # UP action\n\n    return actions\n\n  def collect_primitive(env, primitive_name):\n    \"\"\"Helper function to collect a primitive.\"\"\"\n    primitive_index = env.world.cookbook.index[primitive_name]\n    \n    if primitive_index not in env.world.grabbable_indices:\n      raise ValueError(f\"{primitive_name} is not a grabbable item.\")\n    \n    actions = []\n\n    # Check if already have the required amount of the primitive\n    if env._current_state.inventory[primitive_index] >= recipe.get(primitive_name, 0):\n      return actions\n    \n    target_indices = [primitive_index]\n    while env._current_state.inventory[primitive_index] < recipe.get(primitive_name, 0):\n        positions = navigate_to_item(env, target_indices)\n        \n        if not positions:\n          raise ValueError(f\"No available {primitive_name} to collect.\")\n        \n        for pos in positions:\n            actions.extend(navigate_to_item(env, [primitive_index]))\n            \n            # Check if the agent is next to an item\n            if env._current_state.next_to(primitive_index):\n                actions.append(env.world.N_ACTIONS - 1)  # USE action\n            \n            if env._current_state.inventory[primitive_index] >= recipe.get(primitive_name, 0):\n                break\n\n    return actions\n\n  def find_workshop_position(env, workshop_name):\n    \"\"\"Find the position of a specific workshop in the grid.\"\"\"\n    grid = env._current_state.grid\n    workshop_index = env.world.cookbook.index[f\"workshop{workshop_name}\"]\n    \n    pos_list = np.argwhere(grid[:, :, workshop_index] > 0)\n    if len(pos_list) == 0:\n        raise ValueError(f\"No available {workshop_name} to navigate to.\")\n    return pos_list[0].tolist()\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the goal item is a primitive or not in the recipes\n  if item_index in env.world.grabbable_indices:\n      return []  # Primitives cannot be crafted\n  \n  # Retrieve the recipe for the desired item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Determine the workshop required for crafting\n  workshop_key = \"_at\"\n  workshop_name = next((k.split('_')[1] for k in recipe if k.startswith(workshop_key)), None)\n  if not workshop_name:\n      raise ValueError(f\"No workshop specified for crafting {item}.\")\n  \n  workshop_index = env.world.cookbook.index[f\"workshop{workshop_name}\"]\n  workshop_pos = find_workshop_position(env, f\"workshop{workshop_name}\")\n\n  actions = []\n\n  # Collect all required primitives or intermediate items\n  for req_item_name, count in recipe.items():\n      if isinstance(req_item_name, str) and not req_item_name.startswith('_'):\n          actions.extend(collect_primitive(env, req_item_name))\n      \n  # Navigate to the workshop and use it to craft the item\n  actions.extend(navigate_to_item(env, [workshop_index]))\n  \n  if env._current_state.next_to(workshop_index):\n    actions.append(env.world.N_ACTIONS - 1)  # USE action\n\n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T23:36:31.360527", "function_name": "craft", "function_body": "  def has_all_primitives(required_primitives, inventory_dict):\n    return all(primitive in inventory_dict and inventory_dict[primitive] >= required_primitives[primitive] for primitive in required_primitives)\n\n  def get_closest_workshop(grid, workshop_index):\n    workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n    if len(workshop_positions) == 0:\n      return None\n    # Calculate the Manhattan distance to each workshop and choose the closest one\n    agent_pos = env._current_state.pos\n    distances = [abs(agent_pos[0] - pos[0]) + abs(agent_pos[1] - pos[1]) for pos in workshop_positions]\n    closest_index = np.argmin(distances)\n    return tuple(workshop_positions[closest_index])\n\n  actions = []\n  \n  # Get the index of the goal item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  # If not all primitives are available return empty action list\n  if not has_all_primitives(required_primitives, inventory_dict):\n    return []\n  \n  # Find the workshop where we can craft this item\n  workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n    if item_index == recipe.get(\"_key\"):\n      workshop_index = recipe.get(\"_at\")\n      break\n  \n  if workshop_index is None:\n    return []\n\n  # Get the closest workshop position\n  target_workshop_pos = get_closest_workshop(env._current_state.grid, workshop_index)\n  if target_workshop_pos is None:\n    return []\n  \n  # Navigate to the selected workshop\n  actions.extend(navigate(env._current_state, target_workshop_pos))\n  \n  # Turn towards the workshop if not already facing it\n  current_direction = env._current_state.dir\n  direction_to_workshop = get_direction(env._current_state.pos, target_workshop_pos)\n  if current_direction != direction_to_workshop:\n    actions.append(direction_to_workshop)\n\n  # Use the USE action to craft the item at the workshop\n  actions.append(4)  # Assuming 4 is the index for the USE action\n  \n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T23:36:32.427491", "function_name": "craft", "function_body": "  def has_all_primitives(required_primitives, inventory_dict):\n    return all(primitive in inventory_dict and inventory_dict[primitive] >= required_primitives[primitive] for primitive in required_primitives)\n\n  actions = []\n  \n  # Get the index of the goal item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  # If not all primitives are available return empty action list\n  if not has_all_primitives(required_primitives, inventory_dict):\n    return []\n  \n  # Find the workshop where we can craft this item and its position\n  workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n    if item_index == recipe.get(\"_key\"):\n      workshop_index = recipe.get(\"_at\")\n      break\n  \n  if workshop_index is None:\n    return []\n\n  # Find the positions of all workshops with the same index\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(workshop_positions) == 0:\n    return []\n  \n  # Select the closest workshop\n  current_pos = env._current_state.pos\n  target_workshop_pos = min(workshop_positions, key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1]))\n\n  # Navigate to the selected workshop\n  actions.extend(navigate(env._current_state, target_workshop_pos))\n  \n  # Turn towards the workshop if not already facing it\n  current_direction = env._current_state.dir\n  direction_to_workshop = get_direction(current_pos, target_workshop_pos)\n  if current_direction != direction_to_workshop:\n    actions.append(direction_to_workshop)\n\n  # Use the USE action to craft the item at the workshop\n  actions.append(4)  # Assuming 4 is the index for the USE action\n  \n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T23:39:18.605342", "function_name": "craft", "function_body": "  def navigate_to_position(env, target_pos):\n    pos = env._current_state.pos\n    dir = env._current_state.dir\n\n    actions = []\n    \n    # Determine direction to move based on current and target positions\n    while tuple(pos) != tuple(target_pos):\n      dx = target_pos[0] - pos[0]\n      dy = target_pos[1] - pos[1]\n\n      if dx < 0:\n          actions.append(env.world.N_ACTIONS - 4)  # UP action\n          pos = (pos[0] - 1, pos[1])\n      elif dx > 0:\n          actions.append(env.world.N_ACTIONS - 3)  # DOWN action\n          pos = (pos[0] + 1, pos[1])\n\n      if dy < 0:\n          actions.append(env.world.N_ACTIONS - 2)  # LEFT action\n          pos = (pos[0], pos[1] - 1)\n      elif dy > 0:\n          actions.append(env.world.N_ACTIONS - 5)  # RIGHT action\n          pos = (pos[0], pos[1] + 1)\n\n    return actions\n\n  def find_item_positions(env, item_index):\n    grid = env._current_state.grid\n    return np.argwhere(grid[:, :, item_index] > 0).tolist()\n\n  def find_workshop_position(env, workshop_name):\n    workshop_index = env.world.cookbook.index[workshop_name]\n    grid = env._current_state.grid\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n    \n    if len(positions) == 0:\n      raise ValueError(f\"No available {workshop_name} to navigate to.\")\n    \n    return positions[0].tolist()\n\n  def navigate_and_collect(env, target_index):\n    \"\"\"Helper function to navigate and collect a target item.\"\"\"\n    grid = env._current_state.grid\n    pos = env._current_state.pos\n\n    # Find all positions of the target item in the grid\n    target_positions = np.argwhere(grid[:, :, target_index] > 0)\n    \n    if len(target_positions) == 0:\n      return []  # No target found, cannot navigate\n\n    actions = []\n    for target_pos in target_positions:\n      while pos != tuple(target_pos):\n        dx = target_pos[0] - pos[0]\n        dy = target_pos[1] - pos[1]\n\n        if dx < 0:\n          actions.append(env.world.N_ACTIONS - 4)  # UP action\n          pos = (pos[0] - 1, pos[1])\n        elif dx > 0:\n          actions.append(env.world.N_ACTIONS - 3)  # DOWN action\n          pos = (pos[0] + 1, pos[1])\n\n        if dy < 0:\n          actions.append(env.world.N_ACTIONS - 2)  # LEFT action\n          pos = (pos[0], pos[1] - 1)\n        elif dy > 0:\n          actions.append(env.world.N_ACTIONS - 5)  # RIGHT action\n          pos = (pos[0], pos[1] + 1)\n\n      if env._current_state.next_to(target_index):\n        actions.append(env.world.N_ACTIONS - 1)  # USE action\n      \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the goal item is a primitive or not in the recipes\n  if item_index in env.world.grabbable_indices:\n    return []  # Primitives cannot be crafted\n  \n  # Retrieve the recipe for the desired item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Determine the workshop required for crafting\n  workshop_key = \"_at\"\n  workshop_name = recipe.get(workshop_key)\n  if workshop_name is None:\n    raise ValueError(f\"No workshop specified for crafting {item}.\")\n  \n  workshop_pos = find_workshop_position(env, workshop_name)\n\n  # Determine the list of required primitives or intermediate items\n  required_items = {env.world.cookbook.index[key]: value for key, value in recipe.items() if not isinstance(key, str) or not key.startswith('_at')}\n\n  actions = []\n\n  # Collect all required items\n  for req_item_index, count in required_items.items():\n    while env._current_state.inventory[req_item_index] < count:\n      actions.extend(navigate_and_collect(env, req_item_index))\n\n  # Navigate to the workshop and use it to craft the item\n  actions.extend(navigate_to_position(env, workshop_pos))\n  \n  actions.append(env.world.N_ACTIONS - 1)  # USE action\n\n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T23:39:19.730611", "function_name": "craft", "function_body": "  def navigate_to_position(env, target_pos):\n    pos = env._current_state.pos\n    dir = env._current_state.dir\n\n    actions = []\n    \n    # Determine direction to move based on current and target positions\n    while tuple(pos) != tuple(target_pos):\n      dx = target_pos[0] - pos[0]\n      dy = target_pos[1] - pos[1]\n\n      if dx < 0:\n          actions.append(env.world.N_ACTIONS - 4)  # UP action\n          pos = (pos[0] - 1, pos[1])\n      elif dx > 0:\n          actions.append(env.world.N_ACTIONS - 3)  # DOWN action\n          pos = (pos[0] + 1, pos[1])\n\n      if dy < 0:\n          actions.append(env.world.N_ACTIONS - 2)  # LEFT action\n          pos = (pos[0], pos[1] - 1)\n      elif dy > 0:\n          actions.append(env.world.N_ACTIONS - 5)  # RIGHT action\n          pos = (pos[0], pos[1] + 1)\n\n    return actions\n\n  def find_item_positions(env, item_index):\n    grid = env._current_state.grid\n    return np.argwhere(grid[:, :, item_index] > 0).tolist()\n\n  def find_workshop_position(env, workshop_name):\n    workshop_index = env.world.cookbook.index[workshop_name]\n    grid = env._current_state.grid\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n    \n    if len(positions) == 0:\n      raise ValueError(f\"No available {workshop_name} to navigate to.\")\n    \n    return positions[0].tolist()\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the goal item is a primitive or not in the recipes\n  if item_index in env.world.grabbable_indices:\n    return []  # Primitives cannot be crafted\n  \n  # Retrieve the recipe for the desired item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Determine the workshop required for crafting\n  workshop_key = \"_at\"\n  workshop_name = recipe.get(workshop_key)\n  if workshop_name is None:\n    raise ValueError(f\"No workshop specified for crafting {item}.\")\n  \n  workshop_pos = find_workshop_position(env, workshop_name)\n\n  # Determine the list of required primitives or intermediate items\n  required_items = {env.world.cookbook.index[key]: value for key, value in recipe.items() if not isinstance(key, str) or not key.startswith('_at')}\n\n  actions = []\n\n  # Collect all required items\n  for req_item_index, count in required_items.items():\n    while env._current_state.inventory[req_item_index] < count:\n      item_positions = find_item_positions(env, req_item_index)\n      \n      if not item_positions:\n        raise ValueError(f\"No available {env.world.cookbook.get(req_item_index)} to collect.\")\n      \n      for pos in item_positions:\n        actions.extend(navigate_to_position(env, pos))\n        \n        # Check if the agent is next to an item\n        if env._current_state.next_to(req_item_index):\n          actions.append(env.world.N_ACTIONS - 1)  # USE action\n        \n        if env._current_state.inventory[req_item_index] >= count:\n          break\n\n  # Navigate to the workshop and use it to craft the item\n  actions.extend(navigate_to_position(env, workshop_pos))\n  actions.append(env.world.N_ACTIONS - 1)  # USE action\n  \n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T23:41:15.703083", "function_name": "craft", "function_body": "  goal_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the primitives required to craft the item\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  current_inventory = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  # Check if we have all the required primitives\n  for primitive, required_count in required_primitives.items():\n      if current_inventory.get(primitive, 0) < required_count:\n          return []  # Not enough primitives to craft the item\n  \n  # Find the workshop index from the recipe where the item can be crafted\n  workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n  workshop_indices = [idx for idx in env.world.workshop_indices if env.world.cookbook.index.get(idx) == workshop_name]\n  \n  if not workshop_indices:\n      return []  # No suitable workshop found\n  \n  # Choose the first available workshop\n  workshop_index = workshop_indices[0]\n\n  actions_to_take = []\n\n  # Navigate to the chosen workshop and face it\n\n  workshop_position = None\n  for x in range(env._current_state.grid.shape[0]):\n      for y in range(env._current_state.grid.shape[1]):\n          if env._current_state.grid[x, y, workshop_index] > 0:\n              workshop_position = (x, y)\n              break\n      if workshop_position:\n          break\n\n  if not workshop_position:\n      return []  # Workshop position not found\n  \n  current_pos = np.array(env._current_state.pos)\n  target_pos = np.array(workshop_position)\n\n  # Calculate the direction to move to reach the workshop\n  delta_pos = target_pos - current_pos\n\n  # Define movement directions based on the differences in positions\n  if delta_pos[0] < 0:\n      actions_to_take.extend([craft.LEFT] * abs(delta_pos[0]))\n  elif delta_pos[0] > 0:\n      actions_to_take.extend([craft.RIGHT] * abs(delta_pos[0]))\n\n  if delta_pos[1] < 0:\n      actions_to_take.extend([craft.DOWN] * abs(delta_pos[1]))\n  elif delta_pos[1] > 0:\n      actions_to_take.extend([craft.UP] * abs(delta_pos[1])) # Corrected here\n\n  # Determine the final direction to face after reaching the workshop\n  if target_pos[0] < current_pos[0]:\n      actions_to_take.append(craft.LEFT)\n  elif target_pos[0] > current_pos[0]:\n      actions_to_take.append(craft.RIGHT)\n\n  if target_pos[1] < current_pos[1]:\n      actions_to_take.append(craft.DOWN)\n  elif target_pos[1] > current_pos[1]:\n      actions_to_take.append(craft.UP)\n\n  # Use the workshop to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 6, "scores": {"3": 0.0}}
