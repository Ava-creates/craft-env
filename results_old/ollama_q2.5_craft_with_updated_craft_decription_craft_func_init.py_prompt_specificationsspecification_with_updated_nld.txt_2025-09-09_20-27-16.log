rkshop_dir:\n    actions.append(turn_towards(workshop_dir))\n  \n  # Add USE action to craft the item at the workshop\n  actions.append(craft.ACTIONS.USE)\n\n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T12:20:46.415257", "function_name": "craft", "function_body": "  actions = []\n  \n  # Convert the item name to its index using the cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all required primitives for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  current_inventory = {env.world.cookbook.index.get(idx): count for idx, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  # If any required primitive is missing, return empty action list\n  for req_item, req_count in required_primitives.items():\n    if current_inventory.get(req_item, 0) < req_count:\n      return []\n\n  # Find the workshop required to craft this item\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_key = next(key for key in recipe.keys() if key.startswith(\"_at\"))\n  workshop_name = recipe[workshop_key]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    return []\n\n  # Choose a random workshop position to head towards\n  workshop_pos = tuple(workshop_positions[env.world.random.randint(len(workshop_positions))])\n\n  # Calculate the path from the current position to the chosen workshop\n  start_pos = env._current_state.pos\n  path = shortest_path(grid, start_pos, workshop_pos)\n\n  if not path:\n    return []\n\n  # Generate actions to move along the calculated path\n  for target_pos in path[1:]:  # Skip the starting point\n    action = move_towards(env._current_state.pos, env._current_state.dir, target_pos)\n    if action is None:\n      continue  # Handle cases where no valid move exists\n    actions.append(action)\n\n  # Turn towards the workshop to face it\n  workshop_dir = direction_to(env._current_state.pos, workshop_pos)\n  while env._current_state.dir != workshop_dir:\n    actions.append(turn_towards(workshop_dir))\n  \n  # Add USE action to craft the item at the workshop\n  actions.append(craft.ACTIONS.USE)\n\n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T12:20:47.499726", "function_name": "craft", "function_body": "  actions = []\n  # Convert the item name to its index using the cookbook\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all required primitives for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  current_inventory = {env.world.cookbook.index.get(idx): count for idx, count in enumerate(env._current_state.inventory) if count > 0}\n\n  # If any required primitive is missing, return empty action list\n  for req_item, req_count in required_primitives.items():\n    if current_inventory.get(req_item, 0) < req_count:\n      return []\n\n  # Find the workshop required to craft this item\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_key = next(key for key in recipe.keys() if key.startswith(\"_at\"))\n  workshop_name = recipe[workshop_key]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    return []\n\n  # Choose a random workshop position to head towards\n  workshop_pos = tuple(workshop_positions[env.world.random.randint(len(workshop_positions))])\n\n  # Calculate the path from the current position to the chosen workshop\n  start_pos = env._current_state.pos\n  path = shortest_path(grid, start_pos, workshop_pos)\n\n  if not path:\n    return []\n\n  # Generate actions to move along the calculated path\n  for target_pos in path[1:]:  # Skip the starting point\n    action = move_towards(env._current_state.pos, env._current_state.dir, target_pos)\n    if action is None:\n      continue  # Handle cases where no valid move exists\n    actions.append(action)\n\n  # Turn towards the workshop to face it before using the USE action\n  workshop_dir = direction_to(env._current_state.pos, workshop_pos)\n  while env._current_state.dir != workshop_dir:\n    actions.append(turn_towards(workshop_dir))\n\n  # Add USE action to craft the item at the workshop\n  actions.append(craft.ACTIONS.USE)\n\n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T12:25:01.037250", "function_name": "craft", "function_body": "  def collect_ingredient(name: str):\n    ingredient_idx = env.world.cookbook.index[name]\n    if env._current_state.inventory[ingredient_idx] >= recipe.get(ingredient_idx, 0):\n      return []\n    \n    # Find positions of the ingredient in the grid\n    ingredient_positions = np.argwhere(env._current_state.grid[:, :, ingredient_idx] == 1)\n    \n    actions = []\n    while len(ingredient_positions) > 0 and env._current_state.inventory[ingredient_idx] < recipe.get(ingredient_idx, 0):\n        # Sort ingredient positions by distance to the current position\n        distances = np.linalg.norm(ingredient_positions - np.array(env._current_state.pos), axis=1)\n        nearest_pos = tuple(ingredient_positions[np.argmin(distances)])\n        \n        # Move to the ingredient position\n        actions.extend(move_to(env, nearest_pos))\n        \n        # Perform the USE action to collect the ingredient\n        actions.append(4)  # USE action index\n        \n        # Update ingredient positions after collecting one\n        _, _, _ = env.step(actions[-1])  # Execute the last collected action\n        ingredient_positions = np.argwhere(env._current_state.grid[:, :, ingredient_idx] == 1)\n    \n    return actions\n\n  def move_to(state, target):\n    \"\"\"Generate a list of actions to move from the current position to the target position using A* algorithm.\"\"\"\n    \n    start = state.pos\n    goal = target\n    \n    open_set = []\n    heapq.heappush(open_set, (0, start))\n    came_from = {start: None}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, goal)}\n    \n    while open_set:\n        _, current = heapq.heappop(open_set)\n        \n        if current == goal:\n            break\n        \n        for next_pos in neighbors(current):\n            if not is_walkable(state, next_pos):\n                continue\n            \n            tentative_g_score = g_score[current] + 1\n            \n            if tentative_g_score < g_score.get(next_pos, float('inf')):\n                came_from[next_pos] = current\n                g_score[next_pos] = tentative_g_score\n                f_score[next_pos] = tentative_g_score + heuristic(next_pos, goal)\n                heapq.heappush(open_set, (f_score[next_pos], next_pos))\n    \n    # Reconstruct the path\n    path = []\n    while current != start:\n        path.append(current)\n        current = came_from[current]\n    path.reverse()\n    \n    actions = []\n    for step in path:\n        direction = get_direction(state.pos, step)\n        if direction == 'UP':\n            actions.append(1)  # UP action index\n        elif direction == 'DOWN':\n            actions.append(0)  # DOWN action index\n        elif direction == 'LEFT':\n            actions.append(2)  # LEFT action index\n        elif direction == 'RIGHT':\n            actions.append(3)  # RIGHT action index\n        \n        state.pos = step\n    \n    return actions\n\n  def heuristic(a, b):\n      \"\"\"Heuristic function for A* algorithm.\"\"\"\n      return np.linalg.norm(np.array(a) - np.array(b))\n\n  def neighbors(pos):\n      \"\"\"Generate neighboring positions.\"\"\"\n      x, y = pos\n      return [(x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)]\n\n  def is_walkable(state, pos):\n      \"\"\"Check if a position is walkable.\"\"\"\n      x, y = pos\n      grid_size_x, grid_size_y, _ = state.grid.shape\n      \n      # Check bounds\n      if x < 0 or x >= grid_size_x or y < 0 or y >= grid_size_y:\n          return False\n      \n      # Check for boundary and water obstacles (assuming indices are known)\n      boundary_idx = env.world.cookbook.index['BOUNDARY']\n      water_idx = env.world.cookbook.index['WATER']\n      \n      if state.grid[x, y, boundary_idx] == 1 or state.grid[x, y, water_idx] == 1:\n          return False\n      \n      return True\n\n  def get_direction(current_pos, next_pos):\n      \"\"\"Determine the direction to move from current position to next position.\"\"\"\n      x1, y1 = current_pos\n      x2, y2 = next_pos\n      \n      if x2 > x1:\n          return 'RIGHT'\n      elif x2 < x1:\n          return 'LEFT'\n      elif y2 > y1:\n          return 'DOWN'\n      elif y2 < y1:\n          return 'UP'\n      \n      return None\n\n  actions = []\n  \n  # Get the index for the desired item from the cookbook\n  item_idx = env.world.cookbook.index[item]\n  \n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_idx, {})\n  \n  if not recipe:\n    return []  # No recipe found\n  \n  # Determine the workshop where the crafting should happen\n  workshop_key = \"_key\"\n  workshop_index_str = recipe.pop(workshop_key, \"-1\")\n  \n  try:\n      workshop_index = int(workshop_index_str)\n  except ValueError:\n      return []  # Invalid workshop index in the recipe\n  \n  if workshop_index == -1:\n    return []  # Workshop not specified in the recipe\n  \n  # Get the list of workshops from the world configuration\n  workshop_indices = env.world.workshop_indices\n  \n  if workshop_index >= len(workshop_indices):\n    return []  # Invalid workshop index\n  \n  # Determine the target position for the workshop\n  target_workshop_pos = None\n  for y in range(env._current_state.grid.shape[1]):\n      for x in range(env._current_state.grid.shape[0]):\n          if env._current_state.grid[x, y, workshop_indices[workshop_index]] == 1:\n              target_workshop_pos = (x, y)\n              break\n      if target_workshop_pos is not None:\n          break\n  \n  if target_workshop_pos is None:\n    return []  # Workshop position not found in the grid\n\n  # Collect all required primitives\n  for ingredient_idx, count in recipe.items():\n      while env._current_state.inventory[ingredient_idx] < count:\n          actions.extend(collect_ingredient(env.world.cookbook.index.get(ingredient_idx)))\n      \n      if env._current_state.inventory[ingredient_idx] < count:\n        return []  # Could not collect all required primitives\n  \n  # Move to the target workshop\n  actions.extend(move_to(env._current_state, target_workshop_pos))\n  \n  # Perform the USE action at the workshop\n  actions.append(4)  # USE action index\n\n  return actions", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T12:25:02.180741", "function_name": "craft", "function_body": "  def collect_ingredient(name: str):\n    ingredient_idx = env.world.cookbook.index[name]\n    if env._current_state.inventory[ingredient_idx] > 0:\n      return []  # Already have the required amount in inventory\n\n    # Find positions of the ingredient in the grid\n    ingredient_positions = np.argwhere(env._current_state.grid[:, :, ingredient_idx] == 1)\n    \n    actions = []\n    while len(ingredient_positions) > 0 and env._current_state.inventory[ingredient_idx] == 0:\n      # Sort ingredient positions by distance to the current position\n      distances = np.linalg.norm(ingredient_positions - np.array(env._current_state.pos), axis=1)\n      nearest_pos = tuple(ingredient_positions[np.argmin(distances)])\n      \n      # Move to the ingredient position\n      actions.extend(move_to(env, nearest_pos))\n      \n      # Perform the USE action to collect the ingredient\n      actions.append(4)  # USE action index\n      \n      # Update ingredient positions after collecting one\n      _, _, _ = env.step(actions[-1])  # Execute the last collected action\n      ingredient_positions = np.argwhere(env._current_state.grid[:, :, ingredient_idx] == 1)\n    \n    return actions\n\n  def move_to(state, target):\n    \"\"\"Generate a list of actions to move from the current position to the target position using A* algorithm.\"\"\"\n    \n    start = state.pos\n    goal = target\n    \n    open_set = []\n    heapq.heappush(open_set, (0, start))\n    came_from = {start: None}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, goal)}\n    \n    while open_set:\n        _, current = heapq.heappop(open_set)\n        \n        if current == goal:\n            break\n        \n        for next_pos in neighbors(current):\n            if not is_walkable(state, next_pos):\n                continue\n            \n            tentative_g_score = g_score[current] + 1\n            \n            if tentative_g_score < g_score.get(next_pos, float('inf')):\n                came_from[next_pos] = current\n                g_score[next_pos] = tentative_g_score\n                f_score[next_pos] = tentative_g_score + heuristic(next_pos, goal)\n                heapq.heappush(open_set, (f_score[next_pos], next_pos))\n    \n    # Reconstruct the path\n    path = []\n    while current != start:\n        path.append(current)\n        current = came_from[current]\n    path.reverse()\n    \n    actions = []\n    for step in path:\n        direction = get_direction(state.pos, step)\n        if direction == 'UP':\n            actions.append(1)  # UP action index\n        elif direction == 'DOWN':\n            actions.append(0)  # DOWN action index\n        elif direction == 'LEFT':\n            actions.append(2)  # LEFT action index\n        elif direction == 'RIGHT':\n            actions.append(3)  # RIGHT action index\n        \n        state.pos = step\n    \n    return actions\n\n  def heuristic(a, b):\n      \"\"\"Heuristic function for A* algorithm.\"\"\"\n      return np.linalg.norm(np.array(a) - np.array(b))\n\n  def neighbors(pos):\n      \"\"\"Generate neighboring positions.\"\"\"\n      x, y = pos\n      return [(x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)]\n\n  def is_walkable(state, pos):\n      \"\"\"Check if a position is walkable.\"\"\"\n      x, y = pos\n      grid_size_x, grid_size_y, _ = state.grid.shape\n      \n      # Check bounds\n      if x < 0 or x >= grid_size_x or y < 0 or y >= grid_size_y:\n          return False\n      \n      # Check for boundary and water obstacles (assuming indices are known)\n      boundary_idx = env.world.cookbook.index['BOUNDARY']\n      water_idx = env.world.cookbook.index['WATER']\n      \n      if state.grid[x, y, boundary_idx] == 1 or state.grid[x, y, water_idx] == 1:\n          return False\n      \n      return True\n\n  def get_direction(current_pos, next_pos):\n      \"\"\"Determine the direction to move from current position to next position.\"\"\"\n      x1, y1 = current_pos\n      x2, y2 = next_pos\n      \n      if x2 > x1:\n          return 'RIGHT'\n      elif x2 < x1:\n          return 'LEFT'\n      elif y2 > y1:\n          return 'DOWN'\n      elif y2 < y1:\n          return 'UP'\n      \n      return None\n\n  actions = []\n  \n  # Get the index for the desired item from the cookbook\n  item_idx = env.world.cookbook.index[item]\n  \n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_idx, {})\n  \n  if not recipe:\n    return []  # No recipe found\n  \n  # Determine the workshop where the crafting should happen\n  workshop_key = \"_key\"\n  workshop_index_str = recipe.pop(workshop_key, \"-1\")\n  \n  try:\n      workshop_index = int(workshop_index_str)\n  except ValueError:\n      return []  # Invalid workshop index in the recipe\n  \n  if workshop_index == -1:\n    return []  # Workshop not specified in the recipe\n  \n  # Get the list of workshops from the world configuration\n  workshop_indices = env.world.workshop_indices\n  \n  if workshop_index >= len(workshop_indices):\n    return []  # Invalid workshop index\n  \n  # Determine the target position for the workshop\n  target_workshop_pos = None\n  for y in range(env._current_state.grid.shape[1]):\n      for x in range(env._current_state.grid.shape[0]):\n          if env._current_state.grid[x, y, workshop_indices[workshop_index]] == 1:\n              target_workshop_pos = (x, y)\n              break\n      if target_workshop_pos is not None:\n          break\n  \n  if target_workshop_pos is None:\n    return []  # Workshop position not found in the grid\n\n  # Collect all required primitives\n  for ingredient_idx, count in recipe.items():\n      ingredient_name = env.world.cookbook.index.get(ingredient_idx)\n      \n      while env._current_state.inventory[ingredient_idx] < count:\n          collect_actions = collect_ingredient(ingredient_name)\n          \n          if not collect_actions:  # If no actions are returned, we couldn't find the ingredient\n              return []\n          \n          actions.extend(collect_actions)\n\n      if env._current_state.inventory[ingredient_idx] < count:\n        return []  # Could not collect all required primitives\n\n  # Move to the target workshop\n  actions.extend(move_to(env._current_state, target_workshop_pos))\n  \n  # Perform the USE action at the workshop\n  actions.append(4)  # USE action index\n  \n  return actions", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T12:27:25.248890", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index for the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have a recipe for this item\n  if item_index not in env.world.cookbook.recipes:\n    print(f\"No recipe found for {item}\")\n    return actions\n  \n  # Retrieve the recipe\n  recipe = env.world.cookbook.recipes[item_index]\n  \n  # Calculate the required primitives and their counts\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  \n  # Check if we already have all the primitives in our inventory\n  current_inventory = {i: env._current_state.inventory[i] for i in required_primitives}\n  missing_primitives = {k: v - current_inventory.get(k, 0) for k, v in required_primitives.items() if v > current_inventory.get(k, 0)}\n  \n  # If we are missing any primitives, return an empty action list\n  if missing_primitives:\n    print(f\"Missing primitives: {missing_primitives}\")\n    return actions\n  \n  # Otherwise, proceed to craft the item at the specified workshop\n  workshop_index = env.world.cookbook.index[recipe[\"_at\"]]\n  \n  # Find all positions of the workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  \n  if len(workshop_positions) == 0:\n    print(f\"No workshops found for {item}\")\n    return actions\n  \n  # For simplicity, choose the closest workshop\n  agent_position = np.array(env._current_state.pos)\n  distances = np.linalg.norm(agent_position - workshop_positions, axis=1)\n  nearest_workshop_position = tuple(workshop_positions[np.argmin(distances)])\n  \n  # Calculate path to the nearest workshop (simple BFS for demonstration purposes)\n  def bfs_path(grid, start, goal):\n    queue = collections.deque([(start, [])])\n    visited = set([start])\n    while queue:\n      pos, path = queue.popleft()\n      if pos == goal:\n        return path\n      x, y = pos\n      for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n          if grid[nx, ny].sum() == 0:  # Only move to empty cells\n            queue.append(((nx, ny), path + [(dx, dy)]))\n            visited.add((nx, ny))\n    return []\n  \n  # Calculate the path to the nearest workshop\n  path_to_workshop = bfs_path(env._current_state.grid[:, :, :env.world.cookbook.n_kinds].sum(axis=2) == 0, agent_position, nearest_workshop_position)\n  \n  if not path_to_workshop:\n    print(\"No valid path to the workshop found.\")\n    return actions\n  \n  # Translate path into actions (DOWN, UP, LEFT, RIGHT)\n  action_map = {(0, 1): env.world.N_ACTIONS['RIGHT'], (1, 0): env.world.N_ACTIONS['DOWN'], (0, -1): env.world.N_ACTIONS['LEFT'], (-1, 0): env.world.N_ACTIONS['UP']}\n  actions.extend([action_map[move] for move in path_to_workshop])\n  \n  # Turn to face the workshop and perform USE action\n  target_direction = np.arctan2(nearest_workshop_position[1] - agent_position[1], nearest_workshop_position[0] - agent_position[0]) * 180 / np.pi + 90\n  current_direction = env._current_state.dir * 90\n  \n  # Calculate the shortest way to turn\n  turn_angle = (target_direction - current_direction) % 360\n  if turn_angle <= 180:\n    turns = int(np.round(turn_angle / 90))\n  else:\n    turns = int(np.round((360 - turn_angle) / 90)) * -1\n  \n  # Perform the necessary turns (not implemented in detail here)\n  for _ in range(abs(turns)):\n    if turns > 0:\n      actions.append(env.world.N_ACTIONS['RIGHT'])\n    else:\n      actions.append(env.world.N_ACTIONS['LEFT'])\n  \n  # Add USE action to craft the item\n  actions.append(env.world.N_ACTIONS['USE'])\n  \n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-10T12:27:26.236524", "function_name": "craft", "function_body": "  # Fetch the cookbook and resolve the item index\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n  \n  if goal_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  actions = []\n  \n  def gather_primitives(primitive_indices):\n    \"\"\"Helper function to gather required primitives.\"\"\"\n    for primitive in primitive_indices:\n      # Check if the agent already has the required primitive\n      if env._current_state.inventory[primitive] > 0:\n        continue\n      \n      # Find the closest cell containing the required primitive\n      grid = env._current_state.grid\n      pos = np.argwhere(grid[:, :, primitive] == 1)\n      \n      if len(pos) == 0:\n        return False, []\n      \n      target_pos = tuple(pos[0])\n      \n      # Calculate actions to move to the target position\n      move_actions = get_move_actions_to(env._current_state.pos, target_pos)\n      if not move_actions:\n        return False, []\n      \n      actions.extend(move_actions)\n      \n      # Add action to collect the primitive\n      actions.append(env.world.cookbook.index[\"USE\"])\n      \n    return True, actions\n\n  def get_move_actions_to(current_pos, target_pos):\n    \"\"\"Helper function to calculate movement actions from current to target position.\"\"\"\n    # This is a simple implementation; a more advanced pathfinding algorithm can be used here.\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n    \n    move_actions = []\n    if dx > 0:\n      move_actions.extend([env.world.cookbook.index[\"RIGHT\"]] * dx)\n    elif dx < 0:\n      move_actions.extend([env.world.cookbook.index[\"LEFT\"]] * abs(dx))\n    \n    if dy > 0:\n      move_actions.extend([env.world.cookbook.index[\"DOWN\"]] * dy)\n    elif dy < 0:\n      move_actions.extend([env.world.cookbook.index[\"UP\"]] * abs(dy))\n    \n    return move_actions\n\n  # Collect all primitives required for the item\n  primitives_needed = cookbook.primitives_for(goal_index)\n  if not primitives_needed:\n    raise ValueError(f\"No recipe found for item: {item}\")\n\n  success, actions = gather_primitives(primitives_needed.keys())\n  if not success:\n    return []\n\n  # Find and move to the appropriate workshop\n  workshop_index = None\n  for ingredient, _ in cookbook.recipes[goal_index].items():\n      if ingredient == \"_key\":\n          workshop_index = cookbook.index[cookbook.recipes[goal_index][ingredient]]\n          break\n\n  if workshop_index is None:\n    raise ValueError(f\"No workshop specified for item: {item}\")\n\n  # Find the closest cell containing the required workshop\n  grid = env._current_state.grid\n  pos = np.argwhere(grid[:, :, workshop_index] == 1)\n  \n  if len(pos) == 0:\n    return []\n\n  target_pos = tuple(pos[0])\n  move_actions_to_workshop = get_move_actions_to(env._current_state.pos, target_pos)\n  actions.extend(move_actions_to_workshop)\n\n  # Add action to use the workshop\n  actions.append(env.world.cookbook.index[\"USE\"])\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-10T12:29:22.148534", "function_name": "craft", "function_body": "  def find_workshops(grid, kind):\n    coords = []\n    for y in range(grid.shape[0]):\n      for x in range(grid.shape[1]):\n        if grid[y, x, kind] > 0:\n          coords.append((x, y))\n    return coords\n\n  def astar(start, goal, grid_shape):\n    open_set = set([start])\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, goal)}\n\n    while open_set:\n      current = min(open_set, key=lambda x: f_score[x])\n\n      if current == goal:\n        return reconstruct_path(came_from, current)\n\n      open_set.remove(current)\n      neighbors = get_neighbors(current, grid_shape)\n\n      for neighbor in neighbors:\n        tentative_g_score = g_score[current] + 1\n\n        if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n          came_from[neighbor] = current\n          g_score[neighbor] = tentative_g_score\n          f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n          if neighbor not in open_set:\n            open_set.add(neighbor)\n\n    return None\n\n  def heuristic(a, b):\n      return abs(b[0] - a[0]) + abs(b[1] - a[1])\n\n  def reconstruct_path(came_from, current):\n      total_path = [current]\n      while current in came_from:\n          current = came_from[current]\n          total_path.append(current)\n      return total_path[::-1]\n\n  def get_neighbors(pos, grid_shape):\n      neighbors = []\n      x, y = pos\n      if x > 0: neighbors.append((x - 1, y))\n      if x < grid_shape[0] - 1: neighbors.append((x + 1, y))\n      if y > 0: neighbors.append((x, y - 1))\n      if y < grid_shape[1] - 1: neighbors.append((x, y + 1))\n      return neighbors\n\n  goal_index = env.world.cookbook.index[item]\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n\n  actions = []\n\n  if not required_primitives:\n    return [] # No recipe or no primitives needed, can't craft\n\n  # Check if all required primitives are already in inventory\n  for primitive, count in required_primitives.items():\n    if env._current_state.inventory[primitive] < count:\n      return [] # Not enough primitives to start crafting\n\n  # Find the workshop where we need to go to craft this item\n  workshop_key = None\n  for recipe_key, recipe in env.world.cookbook.recipes.items():\n    if \"_at\" in recipe and recipe[\"_at\"] == goal_index:\n      workshop_key = recipe_key\n      break\n\n  # Check if the required workshop exists\n  if workshop_key is None:\n    return [] # No suitable workshop found\n  \n  workshop_index = env.world.cookbook.index[workshop_key]\n\n  # Find coordinates of all workshops on the grid\n  workshop_coords = find_workshops(env._current_state.grid, workshop_index)\n  \n  # Find the closest workshop\n  def closest_workshop(pos, workshops):\n    min_dist = float('inf')\n    closest_ws = None\n    for ws in workshops:\n      dist = abs(ws[0] - pos[0]) + abs(ws[1] - pos[1])\n      if dist < min_dist:\n        min_dist = dist\n        closest_ws = ws\n    return closest_ws\n\n  target_workshop = closest_workshop(env._current_state.pos, workshop_coords)\n  \n  # Navigate to the closest workshop using A*\n  start_pos = env._current_state.pos\n  path = astar(start_pos, target_workshop, env._current_state.grid.shape)\n\n  # Convert path into actions\n  if path:\n      for i in range(len(path) - 1):\n          dx = path[i + 1][0] - path[i][0]\n          dy = path[i + 1][1] - path[i][1]\n          \n          if dx == 0 and dy == -1:\n              actions.append(env.world.cookbook.index[\"UP\"])\n          elif dx == 0 and dy == 1:\n              actions.append(env.world.cookbook.index[\"DOWN\"])\n          elif dx == -1 and dy == 0:\n              actions.append(env.world.cookbook.index[\"LEFT\"])\n          elif dx == 1 and dy == 0:\n              actions.append(env.world.cookbook.index[\"RIGHT\"])\n\n  # Use action to craft the item at the workshop (this assumes correct orientation)\n  actions.append(env.world.cookbook.index[\"USE\"])\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T12:29:23.203295", "function_name": "craft", "function_body": "  goal_index = env.world.cookbook.index[item]\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n\n  actions = []\n\n  if not required_primitives:\n    return [] # No recipe or no primitives needed, can't craft\n\n  # Check if all required primitives are already in inventory\n  for primitive, count in required_primitives.items():\n    if env._current_state.inventory[primitive] < count:\n      return [] # Not enough primitives to start crafting\n\n  # Find the workshop where we need to go to craft this item\n  workshop_index = None\n  for recipe_key, recipe in env.world.cookbook.recipes.items():\n    if \"_at\" in recipe and recipe[\"_at\"] == goal_index:\n      workshop_index = env.world.cookbook.index[recipe_key]\n      break\n\n  # Check if the required workshop exists\n  if workshop_index is None:\n    return [] # No suitable workshop found\n  \n  # Navigate to the closest workshop\n  target_pos = None\n  for x in range(env._current_state.grid.shape[0]):\n    for y in range(env._current_state.grid.shape[1]):\n      if env._current_state.grid[x, y, workshop_index] > 0:\n        target_pos = (x, y)\n        break\n    if target_pos is not None:\n      break\n  \n  # If no workshop is found, return an empty list\n  if target_pos is None:\n    return []\n\n  # Simple pathfinding to the workshop (A* algorithm could be used here for more efficiency)\n  start_pos = env._current_state.pos\n  path = astar(start_pos, target_pos, env._current_state.grid.shape)\n\n  # Convert path into actions\n  if path:\n      for i in range(len(path) - 1):\n          dx = path[i + 1][0] - path[i][0]\n          dy = path[i + 1][1] - path[i][1]\n\n          if dx == 0 and dy == -1:\n              actions.append(env.world.cookbook.index[\"UP\"])\n          elif dx == 0 and dy == 1:\n              actions.append(env.world.cookbook.index[\"DOWN\"])\n          elif dx == -1 and dy == 0:\n              actions.append(env.world.cookbook.index[\"LEFT\"])\n          elif dx == 1 and dy == 0:\n              actions.append(env.world.cookbook.index[\"RIGHT\"])\n\n  # Use action to craft the item at the workshop (this assumes correct orientation)\n  actions.append(env.world.cookbook.index[\"USE\"])\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T12:30:19.317726", "function_name": "craft", "function_body": "  # Get the index of the item to be crafted from the cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Retrieve the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n  \n  if not recipe:\n    print(f\"No recipe found for {item}.\")\n    return []\n  \n  # Check if all primitives required are in the inventory or available on the grid\n  actions = []\n  \n  # Collect primitives that are not already in inventory\n  for ingredient, count in recipe.items():\n      if ingredient != \"_at\":  # Skip the \"_at\" key which specifies the workshop\n          primitive_index = env.world.cookbook.index[ingredient]\n          while np.sum(env._current_state.inventory[primitive_index]) < count:\n              actions.extend(collect_v2(env, ingredient))\n  \n  # After collecting all primitives, move to the specified workshop and craft the item\n  workshop = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop]\n  \n  # Find a position next to the workshop\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index])\n  if not workshop_positions.size:\n      print(f\"No {workshop} found on the grid.\")\n      return []\n  \n  closest_workshop_pos = min(workshop_positions, key=lambda pos: np.linalg.norm(np.array(pos) - np.array(env._current_state.pos)))\n  \n  # Move to a position next to the workshop\n  actions.extend(move_to_v2(env, tuple(closest_workshop_pos)))\n  \n  # Turn to face the workshop\n  direction = get_direction_to_face(env, closest_workshop_pos)\n  actions.append(direction)\n  \n  # Use the workshop to craft the item\n  actions.append(4)  # Assuming USE action is represented by index 4\n  \n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-10T12:30:20.301653", "function_name": "craft", "function_body": "  # Convert item name to its corresponding index\n  item_index = env.world.cookbook.index[item]\n  \n  if not item_index:\n    print(f\"Item '{item}' not found in the cookbook.\")\n    return []\n  \n  # Check if the agent has all required primitives for crafting the item\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  inventory_dict = {i: count for i, count in enumerate(env._current_state.inventory)}\n\n  missing_primitives = [primitive for primitive, count in primitives_needed.items() if inventory_dict.get(primitive, 0) < count]\n  \n  # If any primitives are missing, return an empty action list\n  if missing_primitives:\n    print(f\"Missing primitives: {missing_primitives}\")\n    return []\n  \n  # Find the workshop required for crafting\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_name = recipe[\"_key\"].split(\"_at\")[1].strip().lower()\n  workshop_index = None\n\n  # Find the index of the workshop in the grid\n  for i, idx in enumerate(env.world.workshop_indices):\n    if f\"workshop{i}\" == workshop_name:\n      workshop_index = idx\n      break\n  \n  if not workshop_index:\n    print(f\"No workshop found for item '{item}'.\")\n    return []\n  \n  # Get the position of the workshop in the grid\n  workshop_pos = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_pos) == 0:\n    print(\"Workshop not found in the grid.\")\n    return []\n\n  workshop_pos = tuple(workshop_pos[0])\n\n  # Calculate actions needed to move to the workshop\n  current_pos = env._current_state.pos\n  actions_to_workshop = calculate_actions_to_position(current_pos, workshop_pos)\n\n  # Add USE action to craft the item at the workshop\n  actions_to_workshop.append(craft.USE)\n  \n  return actions_to_workshop", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-10T12:31:48.406652", "function_name": "craft", "function_body": "  # Step 1: Determine the recipe for the desired item\n  if item not in env.world.cookbook.index:\n    print(f\"Item {item} is not known in the cookbook.\")\n    return []\n\n  # Retrieve index and recipe for the item\n  goal_index = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  # Step 2: Check if all required ingredients are available in inventory or can be collected\n\n  # Initialize action list\n  actions = []\n\n  # Iterate over each ingredient in the recipe\n  for ingredient, count_required in recipe.items():\n      if ingredient == \"_key\":\n          continue  # Skip if it's a workshop key\n\n      # Get the index of the ingredient\n      ingredient_index = env.world.cookbook.index[ingredient]\n\n      # Check if the ingredient is already available in inventory\n      current_count = env._current_state.inventory[ingredient_index]\n      count_to_collect = max(0, count_required - current_count)\n\n      # If we need more ingredients, collect them\n      if count_to_collect > 0:\n          # Collect primitives only (non-grabbable items should not be collected)\n          if ingredient_index in env.world.non_grabbable_indices:\n              print(f\"Ingredient {ingredient} is non-grabbable and cannot be collected.\")\n              return []\n\n          # Find the closest instance of the ingredient on the grid\n          positions = np.argwhere(env._current_state.grid[:, :, ingredient_index] > 0)\n          if len(positions) == 0:\n              print(f\"No instances of {ingredient} found on the grid.\")\n              return []\n\n          closest_position = positions[np.linalg.norm(positions - env._current_state.pos, axis=1).argmin()]\n\n          # Move to the closest position and collect it\n          actions.extend(move_to(env, closest_position))\n          actions.append(craft.USE)  # Assume USE action collects items\n\n      # If we have enough ingredients, check if we can craft the item at a workshop\n      if ingredient_index not in env.world.primitives:\n          continue  # Skip non-primitive ingredients (e.g., intermediate products)\n\n  # Step 3: Craft the item at the correct workshop\n  workshop_key = recipe[\"_key\"]\n  workshop_indices = [env.world.cookbook.index[workshop] for workshop in env.world.workshop_indices if workshop.endswith(workshop_key)]\n\n  if not workshop_indices:\n      print(f\"No suitable workshop found for crafting {item}.\")\n      return []\n\n  # Find the closest workshop\n  positions = np.argwhere(np.any([env._current_state.grid[:, :, idx] > 0 for idx in workshop_indices], axis=0))\n  if len(positions) == 0:\n      print(f\"No instances of suitable workshops found on the grid.\")\n      return []\n\n  closest_position = positions[np.linalg.norm(positions - env._current_state.pos, axis=1).argmin()]\n\n  # Move to the closest position and face it\n  actions.extend(move_to(env, closest_position))\n  \n  # Check if we are facing the correct direction (Assuming USE action crafts items when facing a workshop)\n  actions.append(craft.USE)\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-10T12:31:49.364358", "function_name": "craft", "function_body": "  def get_workshop_index(item):\n    recipe = env.world.cookbook.recipes[env.world.cookbook.index[item]]\n    workshop_name = recipe.get(\"_at\")\n    if workshop_name:\n      return getattr(env.world, f\"{workshop_name}_index\")\n    return None\n\n  # Check if the agent has all the required items to craft the item\n  def has_required_items(item):\n    goal_index = env.world.cookbook.index[item]\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    for primitive, count in primitives_needed.items():\n      if env._current_state.inventory[primitive] < count:\n        return False\n    return True\n\n  actions = []\n  if not has_required_items(item):\n    print(f\"Missing required items to craft {item}.\")\n    return actions\n\n  # Find the workshop where the item can be crafted\n  workshop_index = get_workshop_index(item)\n  if not workshop_index:\n    print(f\"No workshop found for crafting {item}.\")\n    return actions\n\n  # Move to the nearest instance of the workshop\n  def find_nearest_workshop(workshop_index):\n    grid = env._current_state.grid\n    pos = env._current_state.pos\n    directions = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n    queue = collections.deque([pos])\n    visited = set()\n    while queue:\n      x, y = queue.popleft()\n      if grid[x, y, workshop_index] > 0:\n        return (x, y)\n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and (nx, ny) not in visited and grid[nx, ny].sum() == 0:\n          queue.append((nx, ny))\n          visited.add((nx, ny))\n    return None\n\n  nearest_workshop = find_nearest_workshop(workshop_index)\n  if not nearest_workshop:\n    print(f\"No path to the workshop for crafting {item}.\")\n    return actions\n\n  # Navigate to the nearest workshop\n  def navigate_to_workshop(target_pos):\n    pos = env._current_state.pos\n    directions = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n    queue = collections.deque([(pos, [])])\n    visited = set()\n    while queue:\n      (x, y), path = queue.popleft()\n      if (x, y) == target_pos:\n        return path\n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1] and (nx, ny) not in visited and env._current_state.grid[nx, ny].sum() == 0:\n          queue.append(((nx, ny), path + [craft.ACTIONS.index((dx, dy))]))\n          visited.add((nx, ny))\n    return None\n\n  path_to_workshop = navigate_to_workshop(nearest_workshop)\n  if not path_to_workshop:\n    print(f\"Could not find a path to the workshop for crafting {item}.\")\n    return actions\n\n  # Add navigation actions\n  actions.extend(path_to_workshop)\n\n  # Perform USE action at the workshop\n  actions.append(craft.ACTIONS.index((0, 0)))\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-10T12:32:47.775833", "function_name": "craft", "function_body": "  actions = []\n\n  # Fetch the index of the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have a recipe for this item\n  if item_index not in env.world.cookbook.recipes:\n    print(f\"No recipe found for {item}.\")\n    return actions\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Collect all required primitives or intermediate items\n  for ingredient, count in recipe.items():\n      if ingredient == \"_at\":\n          continue\n      required_count = count\n      available_count = env._current_state.inventory[ingredient]\n      missing_count = required_count - available_count\n\n      # If we need more of this item, collect it\n      if missing_count > 0:\n          ingredient_name = env.world.cookbook.index.get(ingredient)\n          actions.extend(collect(env, ingredient_name, count=missing_count))\n\n  # Find the workshop to craft the item\n  workshop_index = recipe[\"_at\"]\n  workshop_position = None\n\n  # Search for a position of the specified workshop in the grid\n  for y in range(env._current_state.grid.shape[0]):\n      for x in range(env._current_state.grid.shape[1]):\n          if env._current_state.grid[y, x, workshop_index] > 0:\n              workshop_position = (x, y)\n              break\n      if workshop_position is not None:\n          break\n\n  if workshop_position is None:\n      print(f\"Workshop for {item} not found in the grid.\")\n      return actions\n\n  # Move to the workshop\n  move_to_workshop_actions = move_to(env._current_state.pos, workshop_position, env)\n  actions.extend(move_to_workshop_actions)\n\n  # Check if we are already facing the workshop\n  if not is_facing(env._current_state.dir, workshop_position):\n      turn_action = turn_towards(env._current_state.pos, workshop_position, env._current_state.dir)\n      actions.append(turn_action)\n\n  # Use the USE action to craft the item at the workshop\n  actions.append(craft.ACTION_USE)\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-10T12:32:48.808044", "function_name": "craft", "function_body": "  # Get the index for the goal item using the cookbook\n  goal_index = env.world.cookbook.index[item]\n  \n  # Retrieve the recipe for the goal item from the cookbook\n  recipe = env.world.cookbook.recipes.get(goal_index, {})\n\n  # Check if there's a valid recipe for the desired item\n  if not recipe:\n    print(f\"No recipe found for {item}.\")\n    return []\n\n  # Calculate the required primitives and their counts\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  \n  # Extract the workshop index from the recipe\n  workshop_index = recipe.get(\"_key\", None)\n\n  if workshop_index is None:\n    print(f\"No workshop specified in the recipe for {item}.\")\n    return []\n\n  # Check if we have all the required primitives and their counts in our inventory\n  current_inventory = env._current_state.inventory.copy()\n  \n  missing_primitives = {}\n  for primitive, count in required_primitives.items():\n    if current_inventory[primitive] < count:\n      missing_primitives[primitive] = count - current_inventory[primitive]\n\n  # If there are any missing primitives, return an empty action list\n  if missing_primitives:\n    print(f\"Missing primitives: {missing_primitives}.\")\n    return []\n\n  # Generate actions to move to the workshop and perform the USE action\n  actions = []\n  \n  # Get the position of the nearest available workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if not workshop_positions.size:\n    print(f\"No available workshops for {item}.\")\n    return []\n\n  closest_workshop_pos = min(workshop_positions, key=lambda pos: np.linalg.norm(np.array(pos) - np.array(env._current_state.pos)))\n  \n  # Generate actions to move to the closest workshop\n  target_pos = tuple(closest_workshop_pos)\n  actions.extend(generate_move_actions(env._current_state.pos, target_pos, env._current_state.dir))\n\n  # Add action to face the workshop and perform USE action\n  final_dir = direction_towards(env._current_state.pos, target_pos, env._current_state.dir)\n  if final_dir != env._current_state.dir:\n    actions.append(final_dir)\n\n  actions.append(craft.USE)\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-10T12:35:53.216008", "function_name": "craft", "function_body": "  def determine_facing_direction(pos1, pos2):\n      dx = pos2[0] - pos1[0]\n      dy = pos2[1] - pos1[1]\n\n      if abs(dx) > abs(dy):\n          return craft.ACTION_DOWN if dx > 0 else craft.ACTION_UP\n      else:\n          return craft.ACTION_RIGHT if dy > 0 else craft.ACTION_LEFT\n\n  def navigate_to(env, target_position):\n      path = a_star_search(env._current_state.grid, env._current_state.pos, target_position)\n      actions = []\n      for step in path:\n          if step[0] > env._current_state.pos[0]:\n              actions.append(craft.ACTION_DOWN)\n          elif step[0] < env._current_state.pos[0]:\n              actions.append(craft.ACTION_UP)\n          elif step[1] > env._current_state.pos[1]:\n              actions.append(craft.ACTION_RIGHT)\n          elif step[1] < env._current_state.pos[1]:\n              actions.append(craft.ACTION_LEFT)\n          # Update the state after each action\n          _, env._current_state = env._current_state.step(actions[-1])\n      return actions\n\n  def a_star_search(grid, start, goal):\n      open_set = collections.deque([(0, start)])\n      came_from = {}\n      g_score = {start: 0}\n      f_score = {start: heuristic(start, goal)}\n\n      while open_set:\n          _, current = open_set.popleft()\n          if current == goal:\n              return reconstruct_path(came_from, current)\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n                  tentative_g_score = g_score[current] + 1\n                  if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                      came_from[neighbor] = current\n                      g_score[neighbor] = tentative_g_score\n                      f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                      open_set.append((f_score[neighbor], neighbor))\n\n      return []\n\n  def heuristic(a, b):\n      return abs(b[0] - a[0]) + abs(b[1] - a[1])\n\n  def reconstruct_path(came_from, current):\n      total_path = [current]\n      while current in came_from:\n          current = came_from[current]\n          total_path.append(current)\n      total_path.reverse()\n      return total_path[1:]  # Exclude the start position\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  current_inventory = {env.world.cookbook.index.get(i): env._current_state.inventory[i] for i in range(len(env._current_state.inventory))}\n\n  actions = []\n\n  # Check if we have all the primitives required\n  for primitive, count in required_primitives.items():\n    if current_inventory.get(primitive, 0) < count:\n      return []  # Return empty list as we do not have enough primitives\n\n  # Determine which workshop to use and navigate there\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_required = None\n  for key in recipe.keys():\n    if \"_at\" in key:\n      workshop_required = key.split(\"_at\")[1].strip()\n      break\n\n  if not workshop_required:\n    return []  # No valid workshop found in the recipe\n\n  # Find the position of the required workshop in the grid\n  workshop_index = env.world.cookbook.index[workshop_required]\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n  if not workshop_positions.size:\n    return []  # No valid workshop found on the grid\n\n  target_workshop_position = tuple(workshop_positions[0])\n\n  # Navigate to the workshop\n  actions.extend(navigate_to(env, target_workshop_position))\n\n  # Turn to face the workshop (assuming we can determine the direction needed)\n  facing_direction = determine_facing_direction(env._current_state.pos, target_workshop_position)\n  if facing_direction is not None:\n    actions.append(facing_direction)\n\n  # Perform USE action to craft the item\n  actions.append(craft.ACTION_USE)\n\n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T12:35:54.296366", "function_name": "craft", "function_body": "  def determine_facing_direction(pos1, pos2):\n      dx = pos2[0] - pos1[0]\n      dy = pos2[1] - pos1[1]\n\n      if abs(dx) > abs(dy):\n          return craft.ACTION_DOWN if dx > 0 else craft.ACTION_UP\n      elif abs(dy) > abs(dx):\n          return craft.ACTION_RIGHT if dy > 0 else craft.ACTION_LEFT\n      else:\n          return None\n\n  def navigate_to(env, target_position):\n      path = a_star_search(env._current_state.grid, env._current_state.pos, target_position)\n      actions = []\n      for step in path:\n          if step[0] > env._current_state.pos[0]:\n              actions.append(craft.ACTION_DOWN)\n          elif step[0] < env._current_state.pos[0]:\n              actions.append(craft.ACTION_UP)\n          elif step[1] > env._current_state.pos[1]:\n              actions.append(craft.ACTION_RIGHT)\n          elif step[1] < env._current_state.pos[1]:\n              actions.append(craft.ACTION_LEFT)\n          env._current_state = env._current_state.step(actions[-1])[1]\n      return actions\n\n  def a_star_search(grid, start, goal):\n      open_set = collections.deque([(0, start)])\n      came_from = {}\n      g_score = {start: 0}\n      f_score = {start: heuristic(start, goal)}\n\n      while open_set:\n          _, current = open_set.popleft()\n          if current == goal:\n              return reconstruct_path(came_from, current)\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n                  tentative_g_score = g_score[current] + 1\n                  if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                      came_from[neighbor] = current\n                      g_score[neighbor] = tentative_g_score\n                      f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                      open_set.append((f_score[neighbor], neighbor))\n\n      return []\n\n  def heuristic(a, b):\n      return abs(b[0] - a[0]) + abs(b[1] - a[1])\n\n  def reconstruct_path(came_from, current):\n      total_path = [current]\n      while current in came_from:\n          current = came_from[current]\n          total_path.append(current)\n      total_path.reverse()\n      return total_path[1:]  # Exclude the start position\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  current_inventory = {env.world.cookbook.index.get(i): env._current_state.inventory[i] for i in range(len(env._current_state.inventory))}\n\n  actions = []\n\n  # Check if we have all the primitives required\n  for primitive, count in required_primitives.items():\n    if current_inventory.get(primitive, 0) < count:\n      return []  # Return empty list as we do not have enough primitives\n\n  # Determine which workshop to use and navigate there\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_required = None\n  for key in recipe.keys():\n    if \"_at\" in key:\n      workshop_required = key.split(\"_at\")[1].strip()\n      break\n\n  if not workshop_required:\n    return []  # No valid workshop found in the recipe\n\n  # Find the position of the required workshop in the grid\n  workshop_index = env.world.cookbook.index[workshop_required]\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n  if not workshop_positions.size:\n    return []  # No valid workshop found on the grid\n\n  target_workshop_position = tuple(workshop_positions[0])\n\n  # Navigate to the workshop\n  actions.extend(navigate_to(env, target_workshop_position))\n\n  # Turn to face the workshop (assuming we can determine the direction needed)\n  facing_direction = determine_facing_direction(env._current_state.pos, target_workshop_position)\n  if facing_direction is not None:\n    actions.append(facing_direction)\n\n  # Perform USE action to craft the item\n  actions.append(craft.ACTION_USE)\n\n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T12:36:48.670467", "function_name": "craft", "function_body": "    # Find out if we have all the items/primitives required for crafting\n    actions = []\n    goal_index = env.world.cookbook.index[item]\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    for primitive, count in primitives_needed.items():\n        primitive_name = env.world.cookbook.index.get(primitive)\n        if not env._current_state.inventory[primitive] >= count:\n            # If we don't have enough of a required primitive, collect it first\n            actions.extend(collect(env, primitive_name))\n    \n    # Once all the primitives are collected, proceed to craft the item\n    workshop_index = None\n    for output, recipe in env.world.cookbook.recipes.items():\n        if output == goal_index:\n            workshop_key = \"_at\"\n            if workshop_key in recipe:\n                workshop_name = recipe[workshop_key]\n                workshop_index = env.world.cookbook.index[workshop_name]\n    \n    if workshop_index is not None:\n        # Move to the workshop and craft the item\n        actions.extend(move_to_workshop(env, workshop_index))\n        actions.append(4)  # Use action to craft the item\n    \n    return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-10T12:36:49.633939", "function_name": "craft", "function_body": "  actions = []\n  cookbook = env.world.cookbook\n  index = cookbook.index\n\n  # Get the goal index for the item we want to craft\n  goal_index = index[item]\n\n  # Check if the goal has a recipe in the cookbook\n  if goal_index not in cookbook.recipes:\n    return []\n\n  # Collect all primitives required for crafting\n  primitives_required = cookbook.primitives_for(goal_index)\n\n  for primitive, count in primitives_required.items():\n    # Find the name of the primitive from its index\n    primitive_name = index.get(primitive)\n\n    # Check if we already have enough primitives in our inventory\n    if env._current_state.inventory[primitive] >= count:\n      continue\n\n    # Collect the required number of primitives\n    actions.extend(collect(env, primitive_name))\n\n  # After collecting all primitives, find the workshop for crafting\n  recipe = cookbook.recipes[goal_index]\n  workshop_key = \"_at\"\n  if workshop_key not in recipe:\n    return []\n\n  workshop_name = recipe[workshop_key]\n\n  # Find the index of the workshop\n  workshop_index = index[workshop_name]\n\n  # Navigate to the workshop and use it\n  actions.extend(navigate_to_workshop(env, workshop_index))\n  actions.append(env.world.N_ACTIONS)  # Assuming USE action is at N_ACTIONS\n\n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-10T12:39:04.932245", "function_name": "craft", "function_body": "  # Get the cookbook and index\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n\n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Retrieve the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = env._current_state.inventory.copy()\n\n  # Check if all ingredients are available\n  required_ingredients = {cookbook.index[k]: v for k, v in recipe.items()}\n\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if not can_craft:\n    return []\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No available workshop to craft item\")\n\n  # Select the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n  # Calculate actions to move the agent to the nearest workshop\n  dx = nearest_workshop_pos[0] - current_position[0]\n  dy = nearest_workshop_pos[1] - current_position[1]\n\n  actions_to_take = []\n\n  if dx > 0:\n    actions_to_take.extend([craft.MOVE_RIGHT for _ in range(dx)])\n  elif dx < 0:\n    actions_to_take.extend([craft.MOVE_LEFT for _ in range(-dx)])\n\n  if dy > 0:\n    actions_to_take.extend([craft.MOVE_DOWN for _ in range(dy)])\n  elif dy < 0:\n    actions_to_take.extend([craft.MOVE_UP for _ in range(-dy)])\n\n  # Calculate the target direction to face the workshop\n  current_direction = env._current_state.dir\n\n  if dx == 0 and dy == 0:  # Already at the workshop\n      pass\n  elif abs(dx) > abs(dy):  # Prioritize horizontal movement\n      while current_direction != (craft.RIGHT if dx > 0 else craft.LEFT):\n          actions_to_take.append(craft.TURN_RIGHT)\n          current_direction = (current_direction + 1) % 4\n  else:  # Prioritize vertical movement\n      while current_direction != (craft.DOWN if dy > 0 else craft.UP):\n          actions_to_take.append(craft.TURN_LEFT)\n          current_direction = (current_direction - 1) % 4\n\n  # Ensure the agent is facing the workshop cell\n  if dx == 0 and dy < 0:\n      target_direction = craft.UP\n  elif dx == 0 and dy > 0:\n      target_direction = craft.DOWN\n  elif dx > 0 and dy == 0:\n      target_direction = craft.RIGHT\n  elif dx < 0 and dy == 0:\n      target_direction = craft.LEFT\n\n  while current_direction != target_direction:\n      if (current_direction - target_direction) % 4 in [1, -3]:\n          actions_to_take.append(craft.TURN_RIGHT)\n          current_direction = (current_direction + 1) % 4\n      else:\n          actions_to_take.append(craft.TURN_LEFT)\n          current_direction = (current_direction - 1) % 4\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T12:39:06.050804", "function_name": "craft", "function_body": "  # Implement the improved logic here\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n\n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = env._current_state.inventory.copy()\n\n  # Check if all ingredients are available\n  required_ingredients = {cookbook.index[k]: v for k, v in recipe.items()}\n\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if not can_craft:\n    return []\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No available workshop to craft item\")\n\n  # Select the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n  # Calculate actions to move the agent to the nearest workshop\n  dx = nearest_workshop_pos[0] - current_position[0]\n  dy = nearest_workshop_pos[1] - current_position[1]\n\n  actions_to_take = []\n\n  if dx > 0:\n    actions_to_take.extend([craft.MOVE_RIGHT for _ in range(dx)])\n  elif dx < 0:\n    actions_to_take.extend([craft.MOVE_LEFT for _ in range(-dx)])\n\n  if dy > 0:\n    actions_to_take.extend([craft.MOVE_DOWN for _ in range(dy)])\n  elif dy < 0:\n    actions_to_take.extend([craft.MOVE_UP for _ in range(-dy)])\n\n  # Calculate the target direction to face the workshop\n  current_direction = env._current_state.dir\n\n  if dx == 0 and dy == 0:  # Already at the workshop\n      pass\n  elif abs(dx) > abs(dy):  # Prioritize horizontal movement\n      while current_direction != (craft.RIGHT if dx > 0 else craft.LEFT):\n          actions_to_take.append(craft.TURN_RIGHT)\n          current_direction = (current_direction + 1) % 4\n  else:  # Prioritize vertical movement\n      while current_direction != (craft.DOWN if dy > 0 else craft.UP):\n          actions_to_take.append(craft.TURN_LEFT)\n          current_direction = (current_direction - 1) % 4\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T12:40:02.048291", "function_name": "craft", "function_body": "  # Get the index of the item to craft\n  i_goal = env.world.cookbook.index[item]\n\n  # Get the primitives needed for crafting\n  required_primitives = env.world.cookbook.primitives_for(i_goal)\n  \n  # If no recipe, return empty list\n  if not required_primitives:\n    return []\n\n  # Collect the necessary primitives\n  actions = []\n  inventory = env._current_state.inventory.copy()\n  \n  for i_primitive, count in required_primitives.items():\n    primitive_name = env.world.cookbook.index.get(i_primitive)\n    \n    while inventory[i_primitive] < count:\n      actions.extend(collect(env, primitive_name))\n      new_inventory = env._current_state.inventory.copy()\n      \n      # Update the local copy of the inventory\n      inventory += new_inventory - inventory\n\n  # Check if we have all primitives needed\n  for i_primitive, count in required_primitives.items():\n    if inventory[i_primitive] < count:\n      return []\n\n  # Find workshop and go there to craft the item\n  recipe = env.world.cookbook.recipes[i_goal]\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.workshop_indices[env.world.cookbook.index[workshop_name]]\n\n  actions.extend(navigate_to_workshop(env, workshop_index))\n\n  # Use action to craft the item at the workshop\n  actions.append(4)  # USE action\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-10T12:40:03.046468", "function_name": "craft", "function_body": "  # Get the index for the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the recipe for the desired item\n  if item_index not in env.world.cookbook.recipes:\n    return []  # No recipe available for this item\n  \n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Check if we have all the required items/primitives to craft\n  actions_to_collect = []\n  \n  # Calculate which primitives are needed and how much of each\n  required_primitives = {ingredient: count for ingredient, count in recipe.items() if \"_key\" not in ingredient}\n  \n  # Convert these primitive names into indices\n  required_indices = {env.world.cookbook.index[primitive]: required_primitives[primitive] for primitive in required_primitives}\n\n  # Check current inventory and collect missing items\n  for index, needed_count in required_indices.items():\n    if env._current_state.inventory[index] < needed_count:\n      actions_to_collect.extend(collect(env, env.world.cookbook.index.get(index)))\n  \n  # If there are no actions to collect, we have all the required primitives\n  if not actions_to_collect:\n    return [env.action_specs()[\"USE\"]]\n\n  return actions_to_collect", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-10T12:41:04.508525", "function_name": "craft", "function_body": "  # Get the index for the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have a recipe for this item. If not, return an empty action list.\n  if item_index not in env.world.cookbook.recipes:\n    print(f\"No recipe found for {item}.\")\n    return []\n\n  # Get the list of required primitives and their counts to craft this item\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  \n  # Check inventory for missing primitives\n  actions_to_take = []\n  for primitive, count in required_primitives.items():\n    if env._current_state.inventory[primitive] < count:\n      # Find the nearest cell with the required primitive and collect it.\n      actions_to_collect_primitive = find_and_collect(env, primitive)\n      if not actions_to_collect_primitive:\n        print(f\"Cannot find {env.world.cookbook.index.get(primitive, 'unknown')} to craft {item}.\")\n        return []\n      actions_to_take.extend(actions_to_collect_primitive)\n\n  # Check for the workshop where this item can be crafted\n  workshop_index = None\n  for ingredient, count in env.world.cookbook.recipes[item_index].items():\n    if ingredient == \"_at\":\n      workshop_name = env.world.cookbook.recipes[item_index][ingredient]\n      workshop_index = getattr(env.world, f\"{workshop_name}_index\")\n      break\n\n  # Ensure we found a valid workshop\n  if workshop_index is None:\n    print(f\"No valid workshop found to craft {item}.\")\n    return []\n\n  # Find the nearest cell with the required workshop and go there.\n  actions_to_go_to_workshop = find_and_navigate(env, workshop_index)\n  if not actions_to_go_to_workshop:\n    print(f\"Cannot find a path to the workshop {workshop_name} to craft {item}.\")\n    return []\n  actions_to_take.extend(actions_to_go_to_workshop)\n\n  # Add USE action to craft the item\n  actions_to_take.append(env.world.cookbook.index[\"USE\"])\n\n  return actions_to_take", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-10T12:41:05.497115", "function_name": "craft", "function_body": "  # Get the index of the goal item\n  i_goal = env.world.cookbook.index[item]\n  \n  # If the item is not in the cookbook, return an empty action list\n  if i_goal not in env.world.cookbook.recipes:\n    return []\n  \n  # Check if we already have the item in our inventory\n  if env._current_state.inventory[i_goal] > 0:\n    return []\n\n  actions = []\n  # Get the recipe for the goal item\n  recipe = env.world.cookbook.recipes[i_goal]\n\n  # Gather all required ingredients\n  for ingredient, count in recipe.items():\n    if ingredient == \"_key\":\n      continue\n    \n    i_ingredient = env.world.cookbook.index[ingredient]\n    \n    while env._current_state.inventory[i_ingredient] < count:\n      actions.extend(collect(env, ingredient))\n  \n  # Get the workshop index and direction to face it\n  workshop_key = recipe[\"_key\"]\n  workshop_index = env.world.workshop_indices[env.world.cookbook.index[workshop_key]]\n\n  # Navigate to the workshop\n  actions.extend(navigate_to(env, workshop_index))\n\n  # Face the correct direction (this step might require more logic)\n  # Assuming the agent faces right after navigation\n  actions.append(craft.DIR_RIGHT)\n\n  # Use action to craft the item\n  actions.append(craft.USE)\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-10T12:43:38.419717", "function_name": "craft", "function_body": "  # Define action indices based on the DSL\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  def navigate_to_position(start, goal):\n      \"\"\"A* search to find a path from start to goal.\"\"\"\n      open_set = [(0, start)]\n      came_from = {}\n      g_score = {start: 0}\n      f_score = {start: heuristic(start, goal)}\n\n      while open_set:\n          _, current = min(open_set, key=lambda x: x[0])\n          open_set.remove((f_score[current], current))\n\n          if current == goal:\n              return reconstruct_path(came_from, current)\n\n          for neighbor in neighbors(env._current_state.grid, current):\n              tentative_g_score = g_score[current] + 1\n\n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                  open_set.append((f_score[neighbor], neighbor))\n\n      return []\n\n  def heuristic(a, b):\n      \"\"\"Manhattan distance heuristic.\"\"\"\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def neighbors(grid, pos):\n      \"\"\"Get walkable neighbors of a position.\"\"\"\n      x, y = pos\n      results = [(x+1, y), (x-1, y), (x, y+1), (x, y-1)]\n      return [p for p in results if grid[p[0], p[1]] == 0]\n\n  def reconstruct_path(came_from, current):\n      \"\"\"Reconstruct path from start to goal.\"\"\"\n      total_path = [current]\n      while current in came_from:\n          current = came_from[current]\n          total_path.append(current)\n      return total_path[::-1]\n\n  def determine_direction(start, end):\n      \"\"\"Determine the direction to move from start to end.\"\"\"\n      dx = end[0] - start[0]\n      dy = end[1] - start[1]\n\n      if abs(dx) > abs(dy):\n          return ACTION_RIGHT if dx > 0 else ACTION_LEFT\n      else:\n          return ACTION_DOWN if dy > 0 else ACTION_UP\n\n  def navigate_and_craft(target_workshop_position):\n      \"\"\"Navigate to the workshop and craft the item.\"\"\"\n      path = navigate_to_position(env._current_state.pos, target_workshop_position)\n      actions.extend(path)\n\n      # Turn to face the workshop\n      facing_direction = determine_direction(env._current_state.pos, target_workshop_position)\n      if facing_direction is not None:\n          actions.append(facing_direction)\n\n      # Perform USE action to craft the item\n      actions.append(ACTION_USE)\n\n  # Get the index of the item in the cookbook\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  current_inventory = {env.world.cookbook.index.get(i): env._current_state.inventory[i] for i in range(len(env._current_state.inventory))}\n\n  actions = []\n\n  # Check if we have all the primitives required\n  for primitive, count in required_primitives.items():\n      if current_inventory.get(primitive, 0) < count:\n          return []  # Return empty list as we do not have enough primitives\n\n  # Determine which workshop to use and navigate there\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_required = None\n  for key in recipe.keys():\n      if \"_at\" in key:\n          workshop_required = key.split(\"_at\")[1].strip()\n          break\n\n  if not workshop_required:\n      return []  # No valid workshop found in the recipe\n\n  # Find the position of the required workshop in the grid\n  workshop_index = env.world.cookbook.index[workshop_required]\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n  if not workshop_positions.size:\n      return []  # No valid workshop found on the grid\n\n  target_workshop_position = tuple(workshop_positions[0])\n\n  # Navigate and craft\n  navigate_and_craft(target_workshop_position)\n\n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T12:43:39.410080", "function_name": "craft", "function_body": "  def navigate(pos, target):\n    path = a_star_search(env._current_state.grid, pos, target)\n    actions.extend(path)\n\n  def a_star_search(grid, start, goal):\n      open_set = []\n      heapq.heappush(open_set, (0, start))\n      came_from = {}\n      g_score = {start: 0}\n      f_score = {start: heuristic(start, goal)}\n\n      while open_set:\n          _, current = heapq.heappop(open_set)\n\n          if current == goal:\n              return reconstruct_path(came_from, current)\n\n          for neighbor in neighbors(grid, current):\n              tentative_g_score = g_score[current] + 1\n\n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                  heapq.heappush(open_set, (f_score[neighbor], neighbor))\n\n      return []\n\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def neighbors(grid, pos):\n      x, y = pos\n      results = [(x+1, y), (x-1, y), (x, y+1), (x, y-1)]\n      return [p for p in results if grid[p].sum() == 0]\n\n  def determine_facing_direction(current_pos, target_pos):\n    \"\"\"Determine the direction to face the target position from the current position.\"\"\"\n    cx, cy = current_pos\n    tx, ty = target_pos\n\n    if tx > cx:\n        return craft.ACTION_RIGHT\n    elif tx < cx:\n        return craft.ACTION_LEFT\n    elif ty > cy:\n        return craft.ACTION_DOWN\n    elif ty < cy:\n        return craft.ACTION_UP\n    else:\n        return None  # Already facing the target\n\n  def collect_primitives(primitive_indices, primitive_counts):\n      for primitive_index, count in zip(primitive_indices, primitive_counts):\n          primitive_name = env.world.cookbook.index.get_by_value(primitive_index)\n          actions.extend(collect(env, primitive_name))\n\n  item_index = env.world.cookbook.index[item]\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n\n  current_inventory = {env.world.cookbook.index[primitive]: count for primitive, count in enumerate(env._current_state.inventory)}\n\n  actions = []\n\n  # Check and collect all the primitives required\n  for primitive, count in required_primitives.items():\n      if current_inventory.get(primitive, 0) < count:\n          primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive] == 1)\n          if not primitive_positions.size:\n              return []  # No valid position found on the grid\n          target_primitive_position = tuple(primitive_positions[0])\n          navigate(env._current_state.pos, target_primitive_position)\n          actions.append(craft.ACTION_USE)\n          time.sleep(0.5)  # Simulate some delay\n\n  # Determine which workshop to use and navigate there\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_required = None\n  for key in recipe.keys():\n      if \"_at\" in key:\n          workshop_required = key.split(\"_at\")[1].strip()\n          break\n\n  if not workshop_required:\n      return []  # No valid workshop found in the recipe\n\n  workshop_index = env.world.cookbook.index[workshop_required]\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n  if not workshop_positions.size:\n      return []  # No valid workshop found on the grid\n\n  target_workshop_position = tuple(workshop_positions[0])\n\n  navigate(env._current_state.pos, target_workshop_position)\n  facing_direction = determine_facing_direction(env._current_state.pos, target_workshop_position)\n  if facing_direction is not None:\n      actions.append(facing_direction)\n\n  actions.append(craft.ACTION_USE)\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-10T12:45:34.846235", "function_name": "craft", "function_body": "  # Initialize actions list\n  actions = []\n\n  # Get the index for the goal item\n  goal_index = env.world.cookbook.index.get(item)\n  \n  if goal_index is None:\n      print(f\"Item {item} not found in cookbook.\")\n      return actions\n  \n  # Check if we already have the required item in inventory\n  if env._current_state.inventory[goal_index] > 0:\n      return actions\n\n  # Get the recipe for the goal item\n  recipe = env.world.cookbook.recipes.get(goal_index)\n\n  if recipe is None:\n      print(f\"No recipe found for item {item}.\")\n      return actions\n\n  # Collect all required primitives and crafted items\n  for ingredient, count in recipe.items():\n      if ingredient == \"_key\":\n          continue\n      \n      ingredient_index = env.world.cookbook.index.get(ingredient)\n      \n      while env._current_state.inventory[ingredient_index] < count:\n          actions.extend(collect(env, ingredient))\n          \n          # Check if the agent has collected enough of the current primitive\n          if env._current_state.inventory[ingredient_index] >= count:\n              break\n\n  # Find the workshop specified in the recipe\n  workshop = recipe.get(\"_at\")\n  \n  if workshop is None:\n      print(f\"No workshop specified for item {item}.\")\n      return actions\n  \n  workshop_index = env.world.cookbook.index.get(workshop)\n  \n  if workshop_index is None:\n      print(f\"Workshop {workshop} not found in cookbook.\")\n      return actions\n\n  # Get the position of the closest workshop\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  if workshop_positions.size == 0:\n      print(f\"No workshops of type {workshop} found on the grid.\")\n      return actions\n  \n  closest_workshop_pos = min(workshop_positions, key=lambda x: abs(x[0] - env._current_state.pos[0]) + abs(x[1] - env._current_state.pos[1]))\n  \n  # Move to the workshop\n  actions.extend(move(env, (closest_workshop_pos[0], closest_workshop_pos[1])))\n\n  # Add USE action to craft the item at the workshop\n  actions.append(env.world.cookbook.index[\"USE\"])\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
