{"timestamp": "2025-09-11T12:18:10.309149", "function_name": "craft", "function_body": "  i_goal = env.world.cookbook.index[item]\n  \n  # Get the primitives required for crafting this item\n  prim_reqs = env.world.cookbook.primitives_for(i_goal)\n  \n  actions_list = []\n\n  # Check if we have all the required primitives in our inventory\n  for i_prim, count in prim_reqs.items():\n      if env._current_state.inventory[i_prim] < count:\n          return []  # If any primitive is missing, return an empty action list\n\n  # Find which workshop to use for crafting\n  workshop_index = None\n  workshop_name = \"_key\"\n\n  # Iterate over the recipes and find the workshop\n  for output_index, recipe in env.world.cookbook.recipes.items():\n      if i_goal == output_index:\n          workshop_name = recipe[\"_at\"]\n          break\n\n  # Get the index of the workshop from the environment's indices\n  try:\n      workshop_index = getattr(env.world, f\"{workshop_name}_index\")\n  except AttributeError:\n      return []  # If the workshop is not found, return an empty action list\n\n  # Now that we have all the requirements and know where to craft, let's move to the workshop\n  workshop_pos = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n  if len(workshop_pos) == 0:\n      return []  # No workshop found in the grid\n\n  # Choose the nearest workshop (assuming we only have one for simplicity)\n  closest_workshop = workshop_pos[0]\n\n  agent_pos = env._current_state.pos\n  path = find_path(agent_pos, closest_workshop, env)\n\n  if not path:\n      return []  # No valid path to the workshop\n\n  for pos in path[:-1]:  # Exclude the last position as we need to face the workshop there\n      delta_x = pos[0] - agent_pos[0]\n      delta_y = pos[1] - agent_pos[1]\n\n      action = get_move_action(delta_x, delta_y)\n\n      if action:\n          actions_list.append(action)\n          env.step(action)  # Simulate the step to update the agent's position\n          agent_pos = env._current_state.pos\n\n  # Calculate the final move to face the workshop and use it\n  final_pos = path[-1]\n  delta_x = final_pos[0] - agent_pos[0]\n  delta_y = final_pos[1] - agent_pos[1]\n\n  if delta_x == 0:\n      if delta_y > 0:\n          actions_list.append(craft.MOVE_FUNC(craft.RIGHT))\n      else:\n          actions_list.append(craft.MOVE_FUNC(craft.LEFT))\n  elif delta_y == 0:\n      if delta_x > 0:\n          actions_list.append(craft.MOVE_FUNC(craft.DOWN))\n      else:\n          actions_list.append(craft.MOVE_FUNC(craft.UP))\n\n  # Use the workshop\n  actions_list.append(craft.USE_FUNC())\n\n  return actions_list", "island_id": 6, "scores": {"3": 0.0}}
