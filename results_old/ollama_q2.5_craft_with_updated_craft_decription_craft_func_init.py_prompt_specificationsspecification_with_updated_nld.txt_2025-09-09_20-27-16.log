{"timestamp": "2025-09-11T15:50:09.008277", "function_name": "craft", "function_body": "  def navigate_to(target_pos):\n    current_pos = np.array(env._current_state.pos)\n    actions = []\n\n    while not np.array_equal(current_pos, target_pos):\n      delta = target_pos - current_pos\n\n      # Calculate direction based on the largest absolute difference\n      if abs(delta[0]) > abs(delta[1]):\n        if delta[0] > 0:\n          actions.append(craft.RIGHT)  # Move right\n        else:\n          actions.append(craft.LEFT)   # Move left\n      else:\n        if delta[1] > 0:\n          actions.append(craft.DOWN)   # Move down\n        else:\n          actions.append(craft.UP)     # Move up\n\n      current_pos = np.array(env._current_state.pos)\n\n    return actions\n\n  def orient_towards(target_pos):\n    current_dir = env._current_state.dir\n    delta = target_pos - np.array(env._current_state.pos)\n    \n    # Calculate the direction needed to face the target position\n    if delta[0] > 0:\n      required_dir = craft.RIGHT\n    elif delta[0] < 0:\n      required_dir = craft.LEFT\n    elif delta[1] > 0:\n      required_dir = craft.DOWN\n    else:\n      required_dir = craft.UP\n    \n    # Calculate the difference between current and required direction\n    dir_diff = (required_dir - current_dir) % 4\n    \n    if dir_diff == 1:\n      actions = [craft.RIGHT]\n    elif dir_diff == 2:\n      actions = [craft.LEFT, craft.LEFT] or [craft.RIGHT, craft.RIGHT]\n    elif dir_diff == 3:\n      actions = [craft.LEFT]\n    else:\n      actions = []\n    \n    return actions\n\n  goal_index = env.world.cookbook.index[item]\n\n  # Check if we have all required primitives in our inventory\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  current_inventory = collections.Counter(env._current_state.inventory)\n\n  for primitive, count in required_primitives.items():\n    if current_inventory[primitive] < count:\n      return []  # Missing required primitives\n\n  # Determine the workshop where crafting should occur\n  recipe_details = env.world.cookbook.recipes[goal_index]\n  workshop_name = recipe_details[\"_key\"]\n\n  # Get the index of the workshop from the world's cookbook\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the closest workshop in the grid\n  positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(positions) == 0:\n    return []  # No available workshops\n\n  closest_workshop_pos = min(\n      positions, key=lambda x: abs(x[0] - env._current_state.pos[0]) + abs(x[1] - env._current_state.pos[1]))\n\n  # Navigate to the closest workshop\n  actions_to_workshop = navigate_to(closest_workshop_pos)\n\n  # Orient the agent to face the workshop and use it\n  orient_actions = orient_towards(closest_workshop_pos)\n  \n  actions_to_workshop.extend(orient_actions)\n  actions_to_workshop.append(craft.USE)  # Use the workshop\n\n  return actions_to_workshop", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T15:50:10.075174", "function_name": "craft", "function_body": "  def navigate_to(target_pos):\n    current_pos = np.array(env._current_state.pos)\n    actions = []\n\n    while not np.array_equal(current_pos, target_pos):\n      delta = target_pos - current_pos\n\n      # Calculate direction based on the largest absolute difference\n      if abs(delta[0]) > abs(delta[1]):\n        if delta[0] > 0:\n          actions.append(craft.RIGHT)  # Move right\n        else:\n          actions.append(craft.LEFT)   # Move left\n      else:\n        if delta[1] > 0:\n          actions.append(craft.DOWN)   # Move down\n        else:\n          actions.append(craft.UP)     # Move up\n\n      current_pos = np.array(env._current_state.pos)\n\n    return actions\n\n  goal_index = env.world.cookbook.index[item]\n\n  # Check if we have all required primitives in our inventory\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  current_inventory = collections.Counter(env._current_state.inventory)\n\n  for primitive, count in required_primitives.items():\n    if current_inventory[primitive] < count:\n      return []  # Missing required primitives\n\n  # Determine the workshop where crafting should occur\n  recipe_details = env.world.cookbook.recipes[goal_index]\n  workshop_name = recipe_details[\"_key\"]\n\n  # Get the index of the workshop from the world's cookbook\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the closest workshop in the grid\n  positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(positions) == 0:\n    return []  # No available workshops\n\n  closest_workshop_pos = min(\n      positions, key=lambda x: abs(x[0] - env._current_state.pos[0]) + abs(x[1] - env._current_state.pos[1]))\n\n  # Navigate to the closest workshop\n  actions_to_workshop = navigate_to(closest_workshop_pos)\n\n  # Orient the agent to face the workshop and use it\n  direction_to_workshop = np.array(closest_workshop_pos) - np.array(env._current_state.pos)\n  if direction_to_workshop[0] > 0:  # Workshop is to the right\n    actions_to_workshop.append(craft.RIGHT)\n  elif direction_to_workshop[0] < 0:  # Workshop is to the left\n    actions_to_workshop.append(craft.LEFT)\n  elif direction_to_workshop[1] > 0:  # Workshop is below\n    actions_to_workshop.append(craft.DOWN)\n  else:  # Workshop is above\n    actions_to_workshop.append(craft.UP)\n\n  actions_to_workshop.append(craft.USE)  # Use the workshop\n\n  return actions_to_workshop", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T15:51:23.956652", "function_name": "craft", "function_body": "  # Get the index of the desired item using the cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we already have the item in our inventory\n  if env._current_state.inventory[item_index] > 0:\n    return []\n  \n  # Retrieve the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index, None)\n  if recipe is None:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  actions = []\n\n  # Collect all required primitives and intermediate items for crafting\n  def collect_primitives(recipe):\n      for ingredient, count in recipe.items():\n          if ingredient == \"_key\":\n              continue\n          if ingredient.startswith(\"workshop\"):\n              workshop_index = env.world.cookbook.index[ingredient]\n              if not env._current_state.next_to(workshop_index):\n                  # Move to the correct workshop\n                  actions.extend(move_to_workshop(env, workshop_index))\n              continue\n\n          ingredient_index = env.world.cookbook.index[ingredient]\n          while env._current_state.inventory[ingredient_index] < count:\n              if not env._current_state.next_to(ingredient_index):\n                  # Move to the cell containing the required primitive\n                  actions.extend(move_to_primitive(env, ingredient_index))\n              else:\n                  # Collect the primitive\n                  actions.append(craft.USE)\n                  env._current_state.inventory[ingredient_index] += 1\n\n      return actions\n  \n  actions.extend(collect_primitives(recipe))\n\n  # Craft the item at the correct workshop\n  workshop_key = recipe.get(\"_key\", None)\n  if workshop_key is not None:\n      workshop_index = env.world.cookbook.index[workshop_key]\n      if not env._current_state.next_to(workshop_index):\n          # Move to the correct workshop\n          actions.extend(move_to_workshop(env, workshop_index))\n      actions.append(craft.USE)  # Craft the item\n\n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-11T15:51:24.944205", "function_name": "craft", "function_body": "  actions = []\n\n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Collect all required primitives and intermediate items\n  for ingredient, count in recipe.items():\n    if ingredient == \"_at\":\n      continue\n\n    ingredient_index = env.world.cookbook.index[ingredient]\n    actions.extend(collect(env, ingredient_index))\n\n  # Move to the workshop specified in the recipe\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.workshop_indices[workshop_name]\n\n  # Find the position of the workshop\n  workshop_pos = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)[0]\n  \n  # Navigate to the workshop\n  actions.extend(navigate_to_position(env, workshop_pos))\n  \n  # Use the USE action at the workshop to craft the item\n  actions.append(4)  # Assuming USE is represented by index 4\n\n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-11T15:53:56.460275", "function_name": "craft", "function_body": "  def bfs(start, goals):\n    queue = collections.deque([start])\n    visited = set()\n    parent_map = {}\n\n    while queue:\n      current_pos = queue.popleft()\n\n      if current_pos in goals:\n        path = []\n        while current_pos != start:\n          path.append(current_pos)\n          current_pos = parent_map[current_pos]\n        path.reverse()\n        return path\n\n      if current_pos in visited:\n        continue\n\n      visited.add(current_pos)\n\n      # Check all four possible directions\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        new_x = current_pos[0] + dx\n        new_y = current_pos[1] + dy\n\n        if 0 <= new_x < env._current_state.grid.shape[0] and 0 <= new_y < env._current_state.grid.shape[1]:\n          # Check if the cell is empty (not blocked by any item)\n          if not np.any(env._current_state.grid[new_x, new_y]):\n            queue.append((new_x, new_y))\n            parent_map[(new_x, new_y)] = current_pos\n\n    return None  # No path found\n  \n  def get_actions_to_move(from_pos, to_pos):\n    path = bfs(from_pos, [to_pos])\n    if not path:\n      return []\n    \n    action_map = {(-1, 0): craft.MOVE_UP, (1, 0): craft.MOVE_DOWN, (0, -1): craft.MOVE_LEFT, (0, 1): craft.MOVE_RIGHT}\n    actions = [action_map[(path[i][0] - path[i-1][0], path[i][1] - path[i-1][1])] for i in range(1, len(path))]\n    \n    return actions\n  \n  idx = env.world.cookbook.index[item]\n\n  # Check if we have all required primitives in our inventory\n  required_primitives = env.world.cookbook.primitives_for(idx)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory)}\n\n  missing_items = []\n  for primitive, count in required_primitives.items():\n      if primitive not in inventory_dict or inventory_dict[primitive] < count:\n          missing_items.append((primitive, count - (inventory_dict[primitive] if primitive in inventory_dict else 0)))\n\n  if missing_items:\n    # Try to collect the missing items first\n    actions = []\n    for primitive_name, required_count in missing_items:\n        primitive_idx = env.world.cookbook.index[primitive_name]\n        primitive_positions = []\n\n        # Find all positions of the required primitive in the grid\n        for i in range(env._current_state.grid.shape[0]):\n            for j in range(env._current_state.grid.shape[1]):\n                if env._current_state.grid[i, j, primitive_idx] == 1:\n                    primitive_positions.append((i, j))\n        \n        # Plan the path to the closest primitive position using BFS\n        start_pos = env._current_state.pos\n        closest_primitive_path = min([bfs(start_pos, [pos]) for pos in primitive_positions], key=lambda x: len(x) if x else float('inf'))\n\n        if not closest_primitive_path:\n            return []  # Could not find a valid path to the required primitives\n\n        actions_to_primitive = get_actions_to_move(start_pos, closest_primitive_path[-1])\n        actions += actions_to_primitive + [craft.COLLECT_ACTION]  # Add COLLECT action\n        \n        # Update inventory\n        if primitive_name in inventory_dict:\n            inventory_dict[primitive_name] += 1\n        else:\n            inventory_dict[primitive_name] = 1\n\n    return actions\n\n  # Find all positions of the required workshop in the grid\n  recipe = env.world.cookbook.recipes[idx]\n  workshop_name = [key for key in recipe.keys() if 'WORKSHOP' in key][0]\n  workshop_idx = env.world.cookbook.index[workshop_name]\n\n  workshop_positions = []\n  for i in range(env._current_state.grid.shape[0]):\n      for j in range(env._current_state.grid.shape[1]):\n          if env._current_state.grid[i, j, workshop_idx] == 1:\n              workshop_positions.append((i, j))\n\n  # Plan the path to the closest workshop position using BFS\n  start_pos = env._current_state.pos\n  closest_workshop_path = min([bfs(start_pos, [pos]) for pos in workshop_positions], key=lambda x: len(x) if x else float('inf'))\n\n  if not closest_workshop_path:\n    return []  # Could not find a valid path to any workshop\n\n  actions_to_workshop = get_actions_to_move(start_pos, closest_workshop_path[-1])\n\n  # Add USE action to actually craft the item\n  actions = actions_to_workshop + [craft.USE_ACTION]\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-11T15:53:57.531889", "function_name": "craft", "function_body": "  def bfs(start, goals):\n    queue = collections.deque([start])\n    visited = set()\n    parent_map = {}\n\n    while queue:\n      current_pos = queue.popleft()\n\n      if current_pos in goals:\n        path = []\n        while current_pos != start:\n          path.append(current_pos)\n          current_pos = parent_map[current_pos]\n        path.reverse()\n        return path\n\n      if current_pos in visited:\n        continue\n\n      visited.add(current_pos)\n\n      # Check all four possible directions\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        new_x = current_pos[0] + dx\n        new_y = current_pos[1] + dy\n\n        if 0 <= new_x < env._current_state.grid.shape[0] and 0 <= new_y < env._current_state.grid.shape[1]:\n          # Check if the cell is empty (not blocked by any item)\n          if not np.any(env._current_state.grid[new_x, new_y]):\n            queue.append((new_x, new_y))\n            parent_map[(new_x, new_y)] = current_pos\n\n    return None  # No path found\n  \n  def get_actions_to_move(from_pos, to_pos):\n    path = bfs(from_pos, [to_pos])\n    if not path:\n      return []\n    \n    action_map = {(-1, 0): craft.MOVE_UP, (1, 0): craft.MOVE_DOWN, (0, -1): craft.MOVE_LEFT, (0, 1): craft.MOVE_RIGHT}\n    actions = [action_map[(path[i][0] - path[i-1][0], path[i][1] - path[i-1][1])] for i in range(1, len(path))]\n    \n    return actions\n  \n  idx = env.world.cookbook.index[item]\n\n  # Check if we have all required primitives in our inventory\n  required_primitives = env.world.cookbook.primitives_for(idx)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory)}\n\n  missing_items = []\n  for primitive, count in required_primitives.items():\n      if primitive not in inventory_dict or inventory_dict[primitive] < count:\n          missing_items.append((primitive, count - (inventory_dict[primitive] if primitive in inventory_dict else 0)))\n\n  if missing_items:\n    return []  # Cannot craft the item because we're missing some items\n\n  # Find all positions of the required workshop in the grid\n  recipe = env.world.cookbook.recipes[idx]\n  workshop_name = [key for key in recipe.keys() if 'WORKSHOP' in key][0]\n  workshop_idx = env.world.cookbook.index[workshop_name]\n\n  workshop_positions = []\n  for i in range(env._current_state.grid.shape[0]):\n      for j in range(env._current_state.grid.shape[1]):\n          if env._current_state.grid[i, j, workshop_idx] == 1:\n              workshop_positions.append((i, j))\n\n  # Plan the path to the closest workshop position using BFS\n  start_pos = env._current_state.pos\n  closest_workshop_path = min([bfs(start_pos, [pos]) for pos in workshop_positions], key=lambda x: len(x) if x else float('inf'))\n\n  if not closest_workshop_path:\n    return []  # Could not find a valid path to any workshop\n\n  actions_to_workshop = get_actions_to_move(start_pos, closest_workshop_path[-1])\n\n  # Add USE action to actually craft the item\n  actions = actions_to_workshop + [craft.USE_ACTION]\n\n  return actions", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T15:56:13.916288", "function_name": "craft", "function_body": "  def a_star_search(grid, start, goal):\n      # Define heuristic function for A*\n      def heuristic(a, b):\n          return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n      # Initialize the open and closed sets\n      open_set = []\n      heapq.heappush(open_set, (0, start))\n      came_from = {}\n      g_score = {start: 0}\n      f_score = {start: heuristic(start, goal)}\n\n      while open_set:\n          _, current = heapq.heappop(open_set)\n\n          if current == goal:\n              path = []\n              while current in came_from:\n                  path.append(current)\n                  current = came_from[current]\n              path.reverse()\n              return path\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1] and grid[neighbor].sum() == 0:\n                  tentative_g_score = g_score[current] + 1\n\n                  if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                      came_from[neighbor] = current\n                      g_score[neighbor] = tentative_g_score\n                      f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                      heapq.heappush(open_set, (f_score[neighbor], neighbor))\n\n      return []\n\n  actions = []\n  \n  # Fetch the index for the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Get primitives required to make the item\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n\n  # Check if we already have all the primitives in our inventory\n  all_primitives_collected = True\n  for primitive, count in primitives_required.items():\n    if env._current_state.inventory[primitive] < count:\n      all_primitives_collected = False\n      break\n\n  # If not all primitives are collected, return an empty action list\n  if not all_primitives_collected:\n    return []\n\n  # Find the workshop that can craft this item\n  target_workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n      target_workshop_index = recipe[\"key\"]\n      break\n\n  # If no valid workshop is found, return an empty action list\n  if target_workshop_index is None:\n    return []\n\n  # Find the position of the target workshop on the grid\n  target_workshop_pos = None\n  for x in range(env._current_state.grid.shape[0]):\n      for y in range(env._current_state.grid.shape[1]):\n          if env._current_state.grid[x, y, target_workshop_index] == 1:\n              target_workshop_pos = (x, y)\n              break\n      if target_workshop_pos is not None:\n          break\n\n  # If no valid workshop position found, return an empty action list\n  if target_workshop_pos is None:\n    return []\n\n  # Calculate the path to the target workshop\n  start = env._current_state.pos\n  goal = target_workshop_pos\n  path = a_star_search(env._current_state.grid, start, goal)\n\n  if not path:\n      return []\n\n  # Convert path to actions\n  for i in range(1, len(path)):\n      dx = path[i][0] - path[i-1][0]\n      dy = path[i][1] - path[i-1][1]\n\n      if dx == 1:\n          actions.append(env.world.cookbook.index[\"RIGHT\"])\n      elif dx == -1:\n          actions.append(env.world.cookbook.index[\"LEFT\"])\n      elif dy == 1:\n          actions.append(env.world.cookbook.index[\"DOWN\"])\n      elif dy == -1:\n          actions.append(env.world.cookbook.index[\"UP\"])\n\n  # Calculate the direction to face the target workshop\n  dx = target_workshop_pos[0] - env._current_state.pos[0]\n  dy = target_workshop_pos[1] - env._current_state.pos[1]\n\n  if abs(dx) > abs(dy):\n      direction_to_face = \"RIGHT\" if dx > 0 else \"LEFT\"\n  else:\n      direction_to_face = \"DOWN\" if dy > 0 else \"UP\"\n\n  # Move towards the target workshop and face it\n  actions.append(env.world.cookbook.index[direction_to_face])\n\n  # Add USE action to craft the item\n  actions.append(env.world.cookbook.index[\"USE\"])\n\n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T15:56:14.989918", "function_name": "craft", "function_body": "  def a_star_search(grid, start, goal):\n      neighbors = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n      close_set = set()\n      came_from = {}\n      gscore = {start: 0}\n      fscore = {start: heuristic(start, goal)}\n      oheap = []\n\n      heapq.heappush(oheap, (fscore[start], start))\n      \n      while oheap:\n          current = heapq.heappop(oheap)[1]\n\n          if current == goal:\n              data = []\n              while current in came_from:\n                  data.append(current)\n                  current = came_from[current]\n              return data[::-1] + [goal]\n\n          close_set.add(current)\n          for i, j in neighbors:\n              neighbor = current[0] + i, current[1] + j\n              tentative_g_score = gscore[current] + 1\n\n              if not is_valid_move(grid, neighbor):\n                  continue\n                  \n              if neighbor in close_set and tentative_g_score >= gscore.get(neighbor, 0):\n                  continue\n                \n              if tentative_g_score < gscore.get(neighbor, 0) or neighbor not in [i[1]for i in oheap]:\n                  came_from[neighbor] = current\n                  gscore[neighbor] = tentative_g_score\n                  fscore[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                  heapq.heappush(oheap, (fscore[neighbor], neighbor))\n      return []\n\n  def heuristic(a, b):\n      return abs(b[0] - a[0]) + abs(b[1] - a[1])\n\n  def is_valid_move(grid, position):\n      x, y = position\n      return (0 <= x < grid.shape[0] and \n              0 <= y < grid.shape[1] and \n              grid[x, y].sum() == 0)\n\n  actions = []\n\n  # Fetch the index for the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Get primitives required to make the item\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n\n  # Check if we already have all the primitives in our inventory\n  all_primitives_collected = True\n  for primitive, count in primitives_required.items():\n    if env._current_state.inventory[primitive] < count:\n      all_primitives_collected = False\n      break\n\n  # If not all primitives are collected, return an empty action list\n  if not all_primitives_collected:\n    return []\n\n  # Find the workshop that can craft this item\n  target_workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n      target_workshop_index = recipe[\"key\"]\n      break\n\n  # If no valid workshop is found, return an empty action list\n  if target_workshop_index is None:\n    return []\n\n  # Find the position of the target workshop on the grid\n  target_workshop_pos = None\n  for x in range(env._current_state.grid.shape[0]):\n      for y in range(env._current_state.grid.shape[1]):\n          if env._current_state.grid[x, y, target_workshop_index] == 1:\n              target_workshop_pos = (x, y)\n              break\n      if target_workshop_pos is not None:\n          break\n\n  # If no valid workshop position found, return an empty action list\n  if target_workshop_pos is None:\n    return []\n\n  # Calculate the path to the target workshop using A* search\n  start = env._current_state.pos\n  goal = target_workshop_pos\n  path = a_star_search(env._current_state.grid, start, goal)\n\n  if not path:\n      return []\n\n  # Convert path to actions\n  for i in range(1, len(path)):\n      dx = path[i][0] - path[i-1][0]\n      dy = path[i][1] - path[i-1][1]\n\n      if dx == 1:\n          actions.append(env.world.cookbook.index[\"RIGHT\"])\n      elif dx == -1:\n          actions.append(env.world.cookbook.index[\"LEFT\"])\n      elif dy == 1:\n          actions.append(env.world.cookbook.index[\"DOWN\"])\n      elif dy == -1:\n          actions.append(env.world.cookbook.index[\"UP\"])\n\n  # Calculate the direction to face the target workshop\n  dx = target_workshop_pos[0] - env._current_state.pos[0]\n  dy = target_workshop_pos[1] - env._current_state.pos[1]\n\n  if abs(dx) > abs(dy):\n      direction_to_face = \"RIGHT\" if dx > 0 else \"LEFT\"\n  else:\n      direction_to_face = \"DOWN\" if dy > 0 else \"UP\"\n\n  # Move towards the target workshop and face it\n  actions.append(env.world.cookbook.index[direction_to_face])\n\n  # Add USE action to craft the item\n  actions.append(env.world.cookbook.index[\"USE\"])\n\n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T15:58:24.028925", "function_name": "craft", "function_body": "  def generate_path_to_workshop(current_state, workshop_index):\n    queue = collections.deque([current_state.pos])\n    visited = set([current_state.pos])\n    parent = {current_state.pos: None}\n    \n    while queue:\n        x, y = queue.popleft()\n        \n        # Check if we are next to the workshop\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            nx, ny = x + dx, y + dy\n            if env.world.grid[nx][ny] == workshop_index:\n                # Backtrack to find the path\n                path = []\n                while (nx, ny) != current_state.pos:\n                    path.append((nx, ny))\n                    nx, ny = parent[(nx, ny)]\n                return path[::-1]\n            \n            if 0 <= nx < env.world.grid.shape[0] and 0 <= ny < env.world.grid.shape[1] and (nx, ny) not in visited:\n                queue.append((nx, ny))\n                visited.add((nx, ny))\n                parent[(nx, ny)] = (x, y)\n    \n    return None\n\n  def generate_actions_from_path(path, current_state):\n      actions = []\n      for next_pos in path:\n          dx, dy = next_pos[0] - current_state.pos[0], next_pos[1] - current_state.pos[1]\n          if (dx, dy) == (-1, 0):\n              actions.append(2)  # LEFT\n          elif (dx, dy) == (1, 0):\n              actions.append(3)  # RIGHT\n          elif (dx, dy) == (0, -1):\n              actions.append(0)  # DOWN\n          elif (dx, dy) == (0, 1):\n              actions.append(1)  # UP\n      \n      return actions\n\n  def is_next_to_workshop(current_state, workshop_index):\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          neighbor_pos = (current_state.pos[0] + dx, current_state.pos[1] + dy)\n          if env.world.grid[neighbor_pos] == workshop_index:\n              return True\n      return False\n\n  item_index = env.world.cookbook.index[item]\n\n  # If the item has no recipe or is not a crafted item, return an empty action list\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the recipe for the desired item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Check if all required ingredients are available in the inventory\n  required_ingredients = {env.world.cookbook.index[ingredient]: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n  available_ingredients = {k: v for k, v in enumerate(env._current_state.inventory) if v > 0}\n\n  # If all ingredients are not available, return an empty action list\n  if any(required_ingredient not in available_ingredients or available_ingredients[required_ingredient] < count \n         for required_ingredient, count in required_ingredients.items()):\n    return []\n\n  # Find the workshop index where the item should be crafted\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Generate the path to the nearest workshop\n  path_to_workshop = generate_path_to_workshop(env._current_state, workshop_index)\n\n  if not path_to_workshop:\n      return []\n\n  actions = generate_actions_from_path(path_to_workshop, env._current_state)\n\n  # Once at the workshop, face it and perform the USE action\n  if is_next_to_workshop(env._current_state, workshop_index):\n      target_dir = ((1, 0), (-1, 0), (0, -1), (0, 1)).index((path_to_workshop[-1][0] - env._current_state.pos[0], path_to_workshop[-1][1] - env._current_state.pos[1]))\n      current_dir = ((1, 0), (-1, 0), (0, -1), (0, 1)).index(env._current_state.dir)\n      \n      if current_dir != target_dir:\n          actions.append((target_dir + 2) % 4)  # Turn to face the workshop\n      \n      actions.append(4)  # USE action to craft at the workshop\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T15:58:25.093083", "function_name": "craft", "function_body": "  def generate_path_to_workshop(current_state, workshop_index):\n    grid = env.world.grid\n    queue = collections.deque([current_state.pos])\n    visited = set([current_state.pos])\n    parent = {current_state.pos: None}\n    \n    while queue:\n        x, y = queue.popleft()\n        \n        # Check if we are next to the workshop\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            nx, ny = x + dx, y + dy\n            if grid[nx][ny] == workshop_index:\n                # Backtrack to find the path\n                path = []\n                while (nx, ny) != current_state.pos:\n                    path.append((nx, ny))\n                    nx, ny = parent[(nx, ny)]\n                return path[::-1]\n            \n            if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and grid[nx][ny] not in env.world.cookbook.index and (nx, ny) not in visited:\n                queue.append((nx, ny))\n                visited.add((nx, ny))\n                parent[(nx, ny)] = (x, y)\n    \n    return None\n\n  def generate_actions_from_path(path, current_state):\n      actions = []\n      for next_pos in path:\n          dx, dy = next_pos[0] - current_state.pos[0], next_pos[1] - current_state.pos[1]\n          if (dx, dy) == (-1, 0):\n              actions.append(2)  # LEFT\n          elif (dx, dy) == (1, 0):\n              actions.append(3)  # RIGHT\n          elif (dx, dy) == (0, -1):\n              actions.append(0)  # DOWN\n          elif (dx, dy) == (0, 1):\n              actions.append(1)  # UP\n      \n      return actions\n\n  def is_next_to_workshop(current_state, workshop_index):\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          neighbor_pos = (current_state.pos[0] + dx, current_state.pos[1] + dy)\n          if env.world.grid[neighbor_pos] == workshop_index:\n              return True\n      return False\n\n  item_index = env.world.cookbook.index[item]\n\n  # If the item has no recipe or is not a crafted item, return an empty action list\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the recipe for the desired item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Check if all required ingredients are available in the inventory\n  required_ingredients = {env.world.cookbook.index[ingredient]: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n  available_ingredients = {k: v for k, v in enumerate(env._current_state.inventory) if v > 0}\n\n  # If all ingredients are not available, return an empty action list\n  if any(required_ingredient not in available_ingredients or available_ingredients[required_ingredient] < count \n         for required_ingredient, count in required_ingredients.items()):\n    return []\n\n  # Find the workshop index where the item should be crafted\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Generate the path to the nearest workshop\n  path_to_workshop = generate_path_to_workshop(env._current_state, workshop_index)\n\n  if not path_to_workshop:\n      return []\n\n  actions = generate_actions_from_path(path_to_workshop, env._current_state)\n\n  # Once at the workshop, face it and perform the USE action\n  if is_next_to_workshop(env._current_state, workshop_index):\n      target_dir = ((1, 0), (-1, 0), (0, -1), (0, 1)).index((path_to_workshop[-1][0] - env._current_state.pos[0], path_to_workshop[-1][1] - env._current_state.pos[1]))\n      current_dir = ((1, 0), (-1, 0), (0, -1), (0, 1)).index(env._current_state.dir)\n      \n      if current_dir != target_dir:\n          actions.append((target_dir + 2) % 4)  # Turn to face the workshop\n      \n      actions.append(4)  # USE action to craft at the workshop\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T16:01:12.598984", "function_name": "craft", "function_body": "  def get_workshop_position(grid, workshop_index):\n      positions = np.argwhere(grid == workshop_index)\n      if positions.size > 0:\n          return tuple(positions[0])\n      return None\n\n  def generate_path(start_pos, target_pos, grid, obstacle_indices):\n      queue = collections.deque([start_pos])\n      visited = set()\n      parent = {start_pos: None}\n\n      while queue:\n          current_pos = queue.popleft()\n          if current_pos == target_pos:\n              break\n          \n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor_pos = (current_pos[0] + dx, current_pos[1] + dy)\n              if (neighbor_pos not in visited and \n                  grid[neighbor_pos] not in obstacle_indices):\n                  visited.add(neighbor_pos)\n                  parent[neighbor_pos] = current_pos\n                  queue.append(neighbor_pos)\n\n      path = []\n      while target_pos:\n          path.append(target_pos)\n          target_pos = parent[target_pos]\n      return path[::-1]\n\n  def is_next_to_workshop_and_facing(current_state, workshop_index):\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          neighbor_pos = (current_state.pos[0] + dx, current_state.pos[1] + dy)\n          if env.world.grid[neighbor_pos] == workshop_index and current_state.dir == ((dx, 0) if dx else (0, dy)):\n              return True\n      return False\n\n  def generate_actions_to_move_and_face(current_state, target_position):\n      actions = []\n      path = generate_path(current_state.pos, target_position, env.world.grid, set([env.world.cookbook.index[obstacle] for obstacle in ['BOUNDARY']]))\n      \n      for i in range(1, len(path)):\n          dx = path[i][0] - path[i-1][0]\n          dy = path[i][1] - path[i-1][1]\n          if dx == -1:\n              actions.append(2)  # LEFT\n          elif dx == 1:\n              actions.append(3)  # RIGHT\n          elif dy == -1:\n              actions.append(0)  # UP\n          elif dy == 1:\n              actions.append(1)  # DOWN\n      \n      current_dir = current_state.dir\n      target_direction = (target_position[0] - current_state.pos[0], target_position[1] - current_state.pos[1])\n      target_dir_idx = ((-1, 0), (1, 0), (0, -1), (0, 1)).index(target_direction)\n      \n      if current_dir != target_dir_idx:\n          actions.append((target_dir_idx + 2) % 4)  # Turn to face the workshop\n      \n      return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # If the item has no recipe or is not a crafted item, return an empty action list\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the recipe for the desired item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Check if all required ingredients are available in the inventory\n  required_ingredients = {env.world.cookbook.index[ingredient]: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n  available_ingredients = {k: v for k, v in enumerate(env._current_state.inventory) if v > 0}\n\n  # If all ingredients are not available, return an empty action list\n  if any(required_ingredient not in available_ingredients or available_ingredients[required_ingredient] < count \n         for required_ingredient, count in required_ingredients.items()):\n    return []\n\n  # Find the workshop index where the item should be crafted\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Get the position of the workshop\n  workshop_position = get_workshop_position(env.world.grid, workshop_index)\n  if not workshop_position:\n    return []\n\n  # If we are already next to and facing the correct workshop, perform the USE action\n  if is_next_to_workshop_and_facing(env._current_state, workshop_index):\n    return [4]  # USE action\n\n  # Generate actions to move next to and face the correct workshop\n  actions = generate_actions_to_move_and_face(env._current_state, workshop_position)\n\n  # Append USE action\n  actions.append(4)\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T16:01:13.580249", "function_name": "craft", "function_body": "  def get_workshop_position(grid, workshop_index):\n      positions = np.argwhere(grid == workshop_index)\n      if positions.size > 0:\n          return tuple(positions[0])\n      return None\n\n  def generate_path(start_pos, target_pos, grid, obstacle_indices):\n      queue = collections.deque([start_pos])\n      visited = set()\n      parent = {start_pos: None}\n\n      while queue:\n          current_pos = queue.popleft()\n          if current_pos == target_pos:\n              break\n          \n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor_pos = (current_pos[0] + dx, current_pos[1] + dy)\n              if (neighbor_pos not in visited and \n                  grid[neighbor_pos] not in obstacle_indices):\n                  visited.add(neighbor_pos)\n                  parent[neighbor_pos] = current_pos\n                  queue.append(neighbor_pos)\n\n      path = []\n      while target_pos:\n          path.append(target_pos)\n          target_pos = parent[target_pos]\n      return path[::-1]\n\n  def collect_primitives(env, primitives):\n      actions = []\n      for primitive in primitives:\n          primitive_index = env.world.cookbook.index[primitive]\n          \n          # Check if the primitive is already collected\n          if env._current_state.inventory[primitive_index] > 0:\n              continue\n\n          # Find all positions of the primitive on the grid\n          primitive_positions = np.argwhere(env.world.grid == primitive_index)\n          for position in primitive_positions:\n              # Generate a path to the primitive\n              current_position = env._current_state.pos\n              obstacle_indices = set([env.world.cookbook.index[obstacle] for obstacle in ['BOUNDARY']])\n              path_to_primitive = generate_path(current_position, tuple(position), env.world.grid, obstacle_indices)\n\n              actions += convert_path_to_actions(path_to_primitive)\n              \n              # Collect the primitive (USE action)\n              actions.append(4)\n\n      return actions\n\n  def convert_path_to_actions(path):\n      actions = []\n      for i in range(1, len(path)):\n          dx = path[i][0] - path[i-1][0]\n          dy = path[i][1] - path[i-1][1]\n          if dx == -1:\n              actions.append(2)  # LEFT\n          elif dx == 1:\n              actions.append(3)  # RIGHT\n          elif dy == -1:\n              actions.append(0)  # UP\n          elif dy == 1:\n              actions.append(1)  # DOWN\n      return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # If the item has no recipe or is not a crafted item, return an empty action list\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the recipe for the desired item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Identify required primitives and check inventory\n  required_primitives = [ingredient for ingredient, count in recipe.items() if ingredient != \"_at\"]\n  \n  # Collect primitives that are not already collected\n  actions_to_collect_primitives = collect_primitives(env, required_primitives)\n  if not actions_to_collect_primitives:\n      return []\n\n  # Find the workshop index where the item should be crafted\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Get the position of the workshop\n  workshop_position = get_workshop_position(env.world.grid, workshop_index)\n  if not workshop_position:\n    return []\n\n  # Generate a path to the workshop\n  current_position = env._current_state.pos\n  obstacle_indices = set([env.world.cookbook.index[obstacle] for obstacle in ['BOUNDARY']])\n  path_to_workshop = generate_path(current_position, workshop_position, env.world.grid, obstacle_indices)\n\n  actions = actions_to_collect_primitives + convert_path_to_actions(path_to_workshop)\n  \n  # Determine if we are next to the correct workshop and facing it\n  target_direction = (workshop_position[0] - current_position[0], workshop_position[1] - current_position[1])\n  current_dir = env._current_state.dir\n  target_dir_idx = ((-1, 0), (1, 0), (0, -1), (0, 1)).index(target_direction)\n  \n  if current_dir != target_dir_idx:\n      actions.append((target_dir_idx + 2) % 4)  # Turn to face the workshop\n\n  # Append USE action\n  actions.append(4)\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-11T16:03:14.350746", "function_name": "craft", "function_body": "  def get_workshop_position(workshop_index):\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    if len(positions) > 0:\n        return positions[0]\n    else:\n        raise ValueError(f\"No position found for workshop index: {workshop_index}\")\n\n  def get_required_primitives(i_goal):\n    prim_reqs = env.world.cookbook.primitives_for(i_goal)\n    # Convert the dictionary to a list of tuples (item, count)\n    return [(i_prim, count) for i_prim, count in prim_reqs.items()]\n\n  def move_to(target_position):\n    actions = []\n    agent_pos = np.array(env._current_state.pos)\n    while not np.array_equal(agent_pos, target_position):\n        delta_x = target_position[0] - agent_pos[0]\n        delta_y = target_position[1] - agent_pos[1]\n\n        if abs(delta_x) > abs(delta_y):\n            move_x = np.sign(delta_x)\n            actions.append(craft.MOVE_FUNC(craft.DOWN if move_x == 1 else craft.UP))\n            agent_pos[0] += move_x\n        elif abs(delta_y) > abs(delta_x):\n            move_y = np.sign(delta_y)\n            actions.append(craft.MOVE_FUNC(craft.RIGHT if move_y == 1 else craft.LEFT))\n            agent_pos[1] += move_y\n\n    return actions\n\n  def face_workshop(workshop_position):\n      current_direction = env._current_state.dir\n      delta_x = workshop_position[0] - env._current_state.pos[0]\n      delta_y = workshop_position[1] - env._current_state.pos[1]\n\n      target_direction = None\n      if delta_x > 0:\n          target_direction = craft.DOWN\n      elif delta_x < 0:\n          target_direction = craft.UP\n      elif delta_y > 0:\n          target_direction = craft.RIGHT\n      else:\n          target_direction = craft.LEFT\n\n      actions = []\n      while current_direction != target_direction:\n          if (current_direction + 1) % 4 == target_direction:\n              actions.append(craft.MOVE_FUNC(craft.RIGHT))\n          elif (current_direction - 1) % 4 == target_direction:\n              actions.append(craft.MOVE_FUNC(craft.LEFT))\n          else:\n              actions.append(craft.MOVE_FUNC(craft.RIGHT))\n              actions.append(craft.MOVE_FUNC(craft.RIGHT))\n\n          current_direction = (current_direction + len(actions)) % 4\n\n      return actions\n  \n  i_goal = env.world.cookbook.index[item]\n  \n  # Get the primitives required to craft this item\n  prim_reqs = get_required_primitives(i_goal)\n  \n  # Actions list to be returned\n  actions_list = []\n\n  # Check if we have all the required primitives in our inventory\n  for i_prim, count in prim_reqs:\n      if env._current_state.inventory[i_prim] < count:\n          return []  # If any primitive is missing, return an empty action list\n  \n  # Find which workshop to use for crafting\n  workshop_index = None\n  workshop_name = \"_key\"\n  \n  # Iterate over the recipes and find the workshop\n  for output_index, recipe in env.world.cookbook.recipes.items():\n      if i_goal == output_index:\n          workshop_name = recipe[\"_at\"]\n          break\n  \n  # Get the index of the workshop from the environment's indices\n  try:\n      workshop_index = getattr(env.world, f\"{workshop_name}_index\")\n  except AttributeError:\n      return []  # If the workshop is not found, return an empty action list\n  \n  # Now that we have all the requirements and know where to craft, let's move to the workshop\n  workshop_pos = get_workshop_position(workshop_index)\n  \n  # Calculate the direction towards the workshop\n  agent_pos = env._current_state.pos\n\n  actions_list.extend(move_to(workshop_pos))\n  \n  # Face the workshop once we reach there\n  actions_list.extend(face_workshop(workshop_pos))\n\n  # Once facing the workshop, use it to craft the item\n  actions_list.append(craft.USE_FUNC())\n  \n  return actions_list", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T16:03:15.419124", "function_name": "craft", "function_body": "  def get_workshop_position(workshop_index):\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    if len(positions) > 0:\n        return positions[0]\n    else:\n        raise ValueError(f\"No position found for workshop index: {workshop_index}\")\n\n  def get_required_primitives(i_goal):\n      prim_reqs = env.world.cookbook.primitives_for(i_goal)\n      \n      # Filter out primitives that are already in inventory\n      filtered_prim_reqs = {}\n      for i_prim, count in prim_reqs.items():\n          if env._current_state.inventory[i_prim] < count:\n              filtered_prim_reqs[i_prim] = count - env._current_state.inventory[i_prim]\n          \n      return filtered_prim_reqs\n\n  def move_to(target_position):\n    actions = []\n    agent_pos = np.array(env._current_state.pos)\n    while not np.array_equal(agent_pos, target_position):\n        delta_x = target_position[0] - agent_pos[0]\n        delta_y = target_position[1] - agent_pos[1]\n\n        if abs(delta_x) > abs(delta_y):\n            move_x = np.sign(delta_x)\n            actions.append(craft.MOVE_FUNC(craft.DOWN if move_x == 1 else craft.UP))\n            agent_pos[0] += move_x\n        elif abs(delta_y) > abs(delta_x):\n            move_y = np.sign(delta_y)\n            actions.append(craft.MOVE_FUNC(craft.RIGHT if move_y == 1 else craft.LEFT))\n            agent_pos[1] += move_y\n\n    return actions\n\n  def face_workshop(workshop_position):\n      current_direction = env._current_state.dir\n      delta_x = workshop_position[0] - env._current_state.pos[0]\n      delta_y = workshop_position[1] - env._current_state.pos[1]\n\n      target_direction = None\n      if delta_x > 0:\n          target_direction = craft.DOWN\n      elif delta_x < 0:\n          target_direction = craft.UP\n      elif delta_y > 0:\n          target_direction = craft.RIGHT\n      else:\n          target_direction = craft.LEFT\n\n      actions = []\n      while current_direction != target_direction:\n          if (current_direction + 1) % 4 == target_direction:\n              actions.append(craft.MOVE_FUNC(craft.RIGHT))\n          elif (current_direction - 1) % 4 == target_direction:\n              actions.append(craft.MOVE_FUNC(craft.LEFT))\n          else:\n              actions.append(craft.MOVE_FUNC(craft.RIGHT))\n              actions.append(craft.MOVE_FUNC(craft.RIGHT))\n\n          current_direction = (current_direction + len(actions)) % 4\n\n      return actions\n  \n  i_goal = env.world.cookbook.index[item]\n  \n  # Get the primitives required to craft this item\n  prim_reqs = get_required_primitives(i_goal)\n  \n  # Actions list to be returned\n  actions_list = []\n\n  # Check if we have all the required primitives in our inventory\n  for i_prim, count in prim_reqs.items():\n      if env._current_state.inventory[i_prim] < count:\n          return []  # If any primitive is missing, return an empty action list\n  \n  # Find which workshop to use for crafting\n  workshop_index = None\n  workshop_name = \"_key\"\n  \n  # Iterate over the recipes and find the workshop\n  for output_index, recipe in env.world.cookbook.recipes.items():\n      if i_goal == output_index:\n          workshop_name = recipe[\"_at\"]\n          break\n  \n  # Get the index of the workshop from the environment's indices\n  try:\n      workshop_index = getattr(env.world, f\"{workshop_name}_index\")\n  except AttributeError:\n      return []  # If the workshop is not found, return an empty action list\n  \n  # Now that we have all the requirements and know where to craft, let's move to the workshop\n  workshop_pos = get_workshop_position(workshop_index)\n  \n  # Calculate the direction towards the workshop\n  agent_pos = env._current_state.pos\n\n  actions_list.extend(move_to(workshop_pos))\n  \n  # Face the workshop once we reach there\n  actions_list.extend(face_workshop(workshop_pos))\n\n  # Once facing the workshop, use it to craft the item\n  actions_list.append(craft.USE_FUNC())\n  \n  return actions_list", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T16:04:27.119775", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index of the goal item\n  goal_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  inventory = env._current_state.inventory\n  \n  if not required_primitives:\n    print(f\"No recipe found for item {item}\")\n    return actions\n\n  # Check if we already have enough of each required primitive in our inventory\n  has_all_required = all(inventory[kind] >= count for kind, count in required_primitives.items())\n  \n  if not has_all_required:\n    print(f\"Missing some primitives to craft {item}.\")\n    return actions\n  \n  # Find the workshop where the item can be crafted\n  recipe = env.world.cookbook.recipes[goal_index]\n  workshop_name = next(key for key in recipe.keys() if key.startswith('_at'))\n  \n  # Get the index of the workshop from the cookbook's environment set\n  workshop_index = env.world.cookbook.index.get(workshop_name)\n  if workshop_index is None:\n    print(f\"Workshop {workshop_name} not found in the environment.\")\n    return actions\n  \n  # Find a position next to the workshop where we can move to face it\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  dir = env._current_state.dir\n\n  # Define possible directions (UP, DOWN, LEFT, RIGHT)\n  DIRECTIONS = [(0, -1), (0, 1), (-1, 0), (1, 0)]\n  \n  # Try to find a position next to the workshop that we can move to\n  workshop_pos = None\n  for x in range(grid.shape[0]):\n      for y in range(grid.shape[1]):\n          if grid[x, y, workshop_index] == 1:\n              workshop_pos = (x, y)\n              break\n      if workshop_pos is not None:\n          break\n\n  if workshop_pos is None:\n    print(f\"No position found next to the workshop {workshop_name}.\")\n    return actions\n  \n  # Calculate relative positions and directions to face the workshop\n  target_dir = None\n  for i, (dx, dy) in enumerate(DIRECTIONS):\n      nx, ny = pos[0] + dx, pos[1] + dy\n      if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n          if grid[nx, ny, workshop_index] == 1:\n              target_dir = i\n              break\n  \n  if target_dir is None:\n    print(f\"No direction found to face the workshop {workshop_name}.\")\n    return actions\n\n  # Add actions to move next to and face the workshop\n  for dx, dy in DIRECTIONS[target_dir]:\n      nx, ny = pos[0] + dx, pos[1] + dy\n      if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n          actions.append(env.world.cookbook.index[\"RIGHT\"] if dir == 0 else \n                         env.world.cookbook.index[\"UP\"] if dir == 1 else \n                         env.world.cookbook.index[\"LEFT\"] if dir == 2 else \n                         env.world.cookbook.index[\"DOWN\"])\n          pos = (nx, ny)\n          dir = target_dir\n  \n  # Add action to USE the workshop\n  actions.append(env.world.cookbook.index[\"USE\"])\n\n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-11T16:04:28.127948", "function_name": "craft", "function_body": "  # Convert item name to index using the cookbook\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(item_index)\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}.\")\n\n  # Check if we have all required ingredients in our inventory or nearby\n  required_ingredients = {}\n  workshop_required = None\n\n  for ingredient, count in recipe.items():\n    if ingredient == \"_at\":\n      workshop_required = cookbook.index[count]\n    else:\n      required_ingredients[ingredient] = count\n\n  actions = []\n\n  # Collect missing ingredients if necessary\n  for ingredient_index, count in required_ingredients.items():\n    ingredient_name = cookbook.get(ingredient_index)\n    while np.sum(env._current_state.inventory[ingredient_index]) < count:\n      collect_actions = collect_v2(env, ingredient_name)\n      actions.extend(collect_actions)\n\n  # Navigate to the workshop\n  if workshop_required is not None:\n    workshop_name = cookbook.get(workshop_required)\n    navigate_actions = navigate_to_workshop(env, workshop_name)\n    actions.extend(navigate_actions)\n\n  # Use action to craft the item at the workshop\n  actions.append(4)  # Assuming USE action is represented by index 4\n\n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-11T16:05:11.091064", "function_name": "craft", "function_body": "  actions = []\n  goal_index = env.world.cookbook.index[item]\n  \n  # Check if we have the necessary primitives\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  available_inventory = env._current_state.inventory\n  \n  for primitive, count in required_primitives.items():\n    if available_inventory[primitive] < count:\n      return []  # Not enough primitives to craft the item\n\n  # Find the workshop where we can craft the item\n  recipe = env.world.cookbook.recipes.get(goal_index)\n  workshop_required = recipe.get(\"_at\")\n  \n  if not workshop_required:\n    return []  # No workshop specified in the recipe\n  \n  workshop_index = env.world.cookbook.index[workshop_required]\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    return []  # No available workshops\n\n  # Assuming we move to the first available workshop\n  workshop_position = tuple(workshop_positions[0])\n  \n  # Calculate actions to reach the workshop\n  path_to_workshop = find_path(env._current_state.pos, workshop_position)\n  if not path_to_workshop:\n    return []  # No valid path to the workshop\n\n  actions.extend(path_to_workshop)\n\n  # Add action to face the workshop and use it\n  direction = calculate_direction(env._current_state.pos, workshop_position)\n  actions.append(direction)  # Turn to face the workshop\n  actions.append(craft.USE)  # Use the workshop to craft the item\n\n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-11T16:05:12.051940", "function_name": "craft", "function_body": "  # Get the cookbook and the required primitives for the item\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n  \n  # Get the primitive requirements for the desired item\n  primitive_requirements = cookbook.primitives_for(goal_index)\n  \n  # Initialize an empty list to store actions\n  actions = []\n  \n  # Collect all required primitives if not already in inventory\n  for primitive, count in primitive_requirements.items():\n    # Check if we have enough of this primitive in our inventory\n    while env._current_state.inventory[primitive] < count:\n      # Generate actions to collect the primitive\n      actions.extend(collect(env, cookbook.index.get(primitive)))\n  \n  # Now that all primitives are collected, go to the correct workshop and craft the item\n  workshop_index = None\n  for recipe_output, recipe in cookbook.recipes.items():\n    if goal_index == recipe_output:\n      workshop_index = cookbook.index[recipe['_at']]\n      break\n  \n  if workshop_index is not None:\n    # Find the position of the workshop on the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n    \n    if len(workshop_positions) == 0:\n      return []  # No available workshop for this item\n    \n    # Choose the first available workshop (closest one could be implemented here)\n    target_workshop_pos = tuple(workshop_positions[0])\n    \n    # Generate actions to move to the workshop\n    actions.extend(move_to(env._current_state, target_workshop_pos))\n    \n    # Turn towards the workshop and perform USE action\n    actions.append(craft.USE)\n  else:\n    return []  # No recipe for this item\n  \n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-11T16:07:15.394611", "function_name": "craft", "function_body": "  # Fetch the index for the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Get primitives required to make the item\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n\n  # Check if we already have all the primitives in our inventory\n  actions_to_collect_primitives = []\n  for primitive, count in primitives_required.items():\n      while env._current_state.inventory[primitive] < count:\n          actions = collect(env, primitive)\n          actions_to_collect_primitives.extend(actions)\n          # Execute these actions to update the environment state\n          for action in actions:\n              _, done, _ = env.step(action)\n              if done:\n                  return []\n\n  # If primitives are collected, now find the workshop that can craft this item\n  target_workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n      if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n          target_workshop_index = recipe[\"key\"]\n          break\n\n  # If no valid workshop is found, return an empty action list\n  if target_workshop_index is None:\n      return []\n\n  # Find the position of the target workshop on the grid\n  target_workshop_pos = None\n  for x in range(env._current_state.grid.shape[0]):\n      for y in range(env._current_state.grid.shape[1]):\n          if env._current_state.grid[x, y, target_workshop_index] == 1:\n              target_workshop_pos = (x, y)\n              break\n      if target_workshop_pos is not None:\n          break\n\n  # If no valid workshop position found, return an empty action list\n  if target_workshop_pos is None:\n      return []\n\n  # Calculate the path to the target workshop using A* search\n  start = env._current_state.pos\n  goal = target_workshop_pos\n  path = a_star_search(env._current_state.grid, start, goal)\n\n  if not path:\n      return []\n\n  # Convert path to actions\n  for i in range(1, len(path)):\n      dx = path[i][0] - path[i-1][0]\n      dy = path[i][1] - path[i-1][1]\n\n      if dx == 1:\n          actions.append(env.world.cookbook.index[\"RIGHT\"])\n      elif dx == -1:\n          actions.append(env.world.cookbook.index[\"LEFT\"])\n      elif dy == 1:\n          actions.append(env.world.cookbook.index[\"DOWN\"])\n      elif dy == -1:\n          actions.append(env.world.cookbook.index[\"UP\"])\n\n  # Calculate the direction to face the target workshop\n  dx = target_workshop_pos[0] - env._current_state.pos[0]\n  dy = target_workshop_pos[1] - env._current_state.pos[1]\n\n  if abs(dx) > abs(dy):\n      direction_to_face = \"RIGHT\" if dx > 0 else \"LEFT\"\n  else:\n      direction_to_face = \"DOWN\" if dy > 0 else \"UP\"\n\n  actions.append(env.world.cookbook.index[direction_to_face])\n\n  # Add USE action to craft the item\n  actions.append(env.world.cookbook.index[\"USE\"])\n\n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-11T16:07:16.442045", "function_name": "craft", "function_body": "  actions = []\n  \n  # Fetch the index for the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Get primitives required to make the item\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n  \n  # Check if we already have all the primitives in our inventory\n  all_primitives_collected = True\n  for primitive, count in primitives_required.items():\n      if env._current_state.inventory[primitive] < count:\n          all_primitives_collected = False\n          break\n  \n  # If not all primitives are collected, return an empty action list\n  if not all_primitives_collected:\n      return []\n  \n  # Find the workshop that can craft this item\n  target_workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n      if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n          target_workshop_index = recipe[\"key\"]\n          break\n  \n  # If no valid workshop is found, return an empty action list\n  if target_workshop_index is None:\n      return []\n  \n  # Find the position of the target workshop on the grid\n  target_workshop_pos = None\n  for x in range(env._current_state.grid.shape[0]):\n      for y in range(env._current_state.grid.shape[1]):\n          if env._current_state.grid[x, y, target_workshop_index] == 1:\n              target_workshop_pos = (x, y)\n              break\n      if target_workshop_pos is not None:\n          break\n  \n  # If no valid workshop position found, return an empty action list\n  if target_workshop_pos is None:\n      return []\n  \n  # Calculate the path to the target workshop using A* search\n  start = env._current_state.pos\n  goal = target_workshop_pos\n  path = a_star_search(env._current_state.grid, start, goal)\n  \n  if not path:\n      return []\n  \n  # Convert path to actions\n  for i in range(1, len(path)):\n      dx = path[i][0] - path[i-1][0]\n      dy = path[i][1] - path[i-1][1]\n\n      if dx == 1:\n          actions.append(env.world.cookbook.index[\"RIGHT\"])\n      elif dx == -1:\n          actions.append(env.world.cookbook.index[\"LEFT\"])\n      elif dy == 1:\n          actions.append(env.world.cookbook.index[\"DOWN\"])\n      elif dy == -1:\n          actions.append(env.world.cookbook.index[\"UP\"])\n\n  # Calculate the direction to face the target workshop\n  dx = target_workshop_pos[0] - env._current_state.pos[0]\n  dy = target_workshop_pos[1] - env._current_state.pos[1]\n\n  if abs(dx) > abs(dy):\n      direction_to_face = \"RIGHT\" if dx > 0 else \"LEFT\"\n  else:\n      direction_to_face = \"DOWN\" if dy > 0 else \"UP\"\n\n  actions.append(env.world.cookbook.index[direction_to_face])\n\n  # Add USE action to craft the item\n  actions.append(env.world.cookbook.index[\"USE\"])\n\n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T16:09:22.355470", "function_name": "craft", "function_body": "  def find_closest_cell(kind_index):\n    positions = np.argwhere(env._current_state.grid[:, :, kind_index] == 1)\n    if len(positions) == 0:\n      return None\n\n    closest_pos = min(\n        positions, key=lambda x: abs(x[0] - env._current_state.pos[0]) + abs(x[1] - env._current_state.pos[1]))\n    return tuple(closest_pos)\n\n  # Helper function to navigate to a target position\n  def navigate_to(target_pos):\n    actions = []\n    current_pos = np.array(env._current_state.pos)\n    while not np.array_equal(current_pos, target_pos):\n      delta = target_pos - current_pos\n\n      if delta[0] > 0:\n        actions.append(craft.RIGHT)  # Move right\n      elif delta[0] < 0:\n        actions.append(craft.LEFT)   # Move left\n\n      if delta[1] > 0:\n        actions.append(craft.DOWN)   # Move down\n      elif delta[1] < 0:\n        actions.append(craft.UP)     # Move up\n\n      current_pos = np.array(env._current_state.pos)\n\n    return actions\n\n  def orient_towards(target_pos):\n    current_direction = env._current_state.dir\n    target_direction = (np.arctan2(target_pos[1] - env._current_state.pos[1], \n                                  target_pos[0] - env._current_state.pos[0]) * 180 / np.pi) % 360\n\n    if target_direction < 90:\n      return [craft.RIGHT]\n    elif target_direction >= 90 and target_direction < 180:\n      return [craft.DOWN]\n    elif target_direction >= 180 and target_direction < 270:\n      return [craft.LEFT]\n    else:\n      return [craft.UP]\n\n  goal_index = env.world.cookbook.index[item]\n  \n  # Check if we have all required primitives in our inventory\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  current_inventory = collections.Counter(env._current_state.inventory)\n\n  for primitive, count in required_primitives.items():\n    if current_inventory[primitive] < count:\n      return []  # Missing required primitives\n\n  # Determine the workshop where crafting should occur\n  recipe_details = env.world.cookbook.recipes[goal_index]\n  workshop_name = recipe_details[\"_key\"]\n\n  # Get the index of the workshop from the world's cookbook\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the closest workshop in the grid\n  closest_workshop_pos = find_closest_cell(workshop_index)\n  if not closest_workshop_pos:\n    return []  # No available workshops\n\n  # Navigate to the closest workshop\n  actions = navigate_to(closest_workshop_pos)\n\n  # Orient the agent to face the workshop and use it\n  actions.extend(orient_towards(closest_workshop_pos))\n  actions.append(craft.USE)\n\n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T16:09:23.417045", "function_name": "craft", "function_body": "  def find_closest_cell(kind_index):\n    positions = np.argwhere(env._current_state.grid[:, :, kind_index] == 1)\n    if len(positions) == 0:\n      return None\n\n    closest_pos = min(\n        positions, key=lambda x: abs(x[0] - env._current_state.pos[0]) + abs(x[1] - env._current_state.pos[1]))\n    return tuple(closest_pos)\n\n  # Helper function to navigate to a target position\n  def navigate_to(target_pos):\n    actions = []\n    current_pos = np.array(env._current_state.pos)\n    while not np.array_equal(current_pos, target_pos):\n      delta = target_pos - current_pos\n\n      if delta[0] > 0:\n        actions.append(craft.RIGHT)  # Move right\n      elif delta[0] < 0:\n        actions.append(craft.LEFT)   # Move left\n\n      if delta[1] > 0:\n        actions.append(craft.DOWN)   # Move down\n      elif delta[1] < 0:\n        actions.append(craft.UP)     # Move up\n\n      current_pos = np.array(env._current_state.pos)\n\n    return actions\n\n  def align_to(target_pos):\n    \"\"\"Aligns the agent to face the target position.\"\"\"\n    actions = []\n    current_pos = np.array(env._current_state.pos)\n    delta = target_pos - current_pos\n    current_direction = env._current_state.dir\n\n    if delta[0] > 0:\n      target_direction = craft.RIGHT\n    elif delta[0] < 0:\n      target_direction = craft.LEFT\n    elif delta[1] > 0:\n      target_direction = craft.DOWN\n    else:  # delta[1] < 0\n      target_direction = craft.UP\n\n    if current_direction != target_direction:\n      actions.append(target_direction)\n\n    return actions\n\n  goal_index = env.world.cookbook.index[item]\n  \n  # Check if we have all required primitives in our inventory\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  current_inventory = collections.Counter(env._current_state.inventory)\n\n  for primitive, count in required_primitives.items():\n    if current_inventory[primitive] < count:\n      return []  # Missing required primitives\n\n  # Determine the workshop where crafting should occur\n  recipe_details = env.world.cookbook.recipes[goal_index]\n  workshop_name = recipe_details[\"_key\"]\n\n  # Get the index of the workshop from the world's cookbook\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the closest workshop in the grid\n  closest_workshop_pos = find_closest_cell(workshop_index)\n  if not closest_workshop_pos:\n    return []  # No available workshops\n\n  # Navigate to the closest workshop\n  actions = navigate_to(closest_workshop_pos)\n\n  # Align the agent to face the workshop and use it\n  actions.extend(align_to(closest_workshop_pos))\n  actions.append(craft.USE)\n\n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T16:12:24.783490", "function_name": "craft", "function_body": "  def generate_path_to_workshop(current_state, workshop_index):\n    grid = env.world.grid\n    queue = collections.deque([current_state.pos])\n    visited = set([current_state.pos])\n    parent = {current_state.pos: None}\n    \n    while queue:\n        x, y = queue.popleft()\n        \n        # Check if we are next to the workshop\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            nx, ny = x + dx, y + dy\n            if grid[nx][ny] == workshop_index:\n                # Backtrack to find the path\n                path = []\n                while (nx, ny) != current_state.pos:\n                    path.append((nx, ny))\n                    nx, ny = parent[(nx, ny)]\n                return path[::-1]\n            \n            if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and grid[nx][ny] not in env.world.cookbook.index and (nx, ny) not in visited:\n                queue.append((nx, ny))\n                visited.add((nx, ny))\n                parent[(nx, ny)] = (x, y)\n    \n    return None\n\n  def generate_actions_from_path(path, current_state):\n      actions = []\n      for next_pos in path:\n          dx, dy = next_pos[0] - current_state.pos[0], next_pos[1] - current_state.pos[1]\n          if (dx, dy) == (-1, 0):\n              actions.append(2)  # LEFT\n          elif (dx, dy) == (1, 0):\n              actions.append(3)  # RIGHT\n          elif (dx, dy) == (0, -1):\n              actions.append(0)  # DOWN\n          elif (dx, dy) == (0, 1):\n              actions.append(1)  # UP\n      \n      return actions\n\n  def is_next_to_workshop(current_state, workshop_index):\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          neighbor_pos = (current_state.pos[0] + dx, current_state.pos[1] + dy)\n          if env.world.grid[neighbor_pos] == workshop_index:\n              return True\n      return False\n\n  def face_direction(current_state, target_dir):\n      current_dir = ((1, 0), (-1, 0), (0, -1), (0, 1)).index(current_state.dir)\n      target_dir_idx = ((1, 0), (-1, 0), (0, -1), (0, 1)).index(target_dir)\n\n      if current_dir != target_dir_idx:\n          return [(target_dir_idx + 2) % 4]\n      else:\n          return []\n\n  item_index = env.world.cookbook.index[item]\n\n  # If the item has no recipe or is not a crafted item, return an empty action list\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the recipe for the desired item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Check if all required ingredients are available in the inventory\n  required_ingredients = {env.world.cookbook.index[ingredient]: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n  available_ingredients = {k: v for k, v in enumerate(env._current_state.inventory) if v > 0}\n\n  # If all ingredients are not available, return an empty action list\n  if any(required_ingredient not in available_ingredients or available_ingredients[required_ingredient] < count \n         for required_ingredient, count in required_ingredients.items()):\n    return []\n\n  # Find the workshop index where the item should be crafted\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Generate the path to the nearest workshop\n  path_to_workshop = generate_path_to_workshop(env._current_state, workshop_index)\n\n  if not path_to_workshop:\n      return []\n\n  actions = generate_actions_from_path(path_to_workshop, env._current_state)\n\n  # Once at the workshop, face it and perform the USE action\n  target_dir = ((1, 0), (-1, 0), (0, -1), (0, 1)).index((path_to_workshop[-1][0] - env._current_state.pos[0], path_to_workshop[-1][1] - env._current_state.pos[1]))\n  current_dir = ((1, 0), (-1, 0), (0, -1), (0, 1)).index(env._current_state.dir)\n\n  actions.extend(face_direction(current_state, target_dir))\n  actions.append(4)  # USE action to craft at the workshop\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T16:12:25.840193", "function_name": "craft", "function_body": "  def generate_path_to_workshop(current_state, workshop_index):\n    grid = env.world.grid\n    queue = collections.deque([current_state.pos])\n    visited = set([current_state.pos])\n    parent = {current_state.pos: None}\n    \n    while queue:\n        x, y = queue.popleft()\n        \n        # Check if we are next to the workshop\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            nx, ny = x + dx, y + dy\n            if grid[nx][ny] == workshop_index:\n                # Backtrack to find the path\n                path = []\n                while (nx, ny) != current_state.pos:\n                    path.append((nx, ny))\n                    nx, ny = parent[(nx, ny)]\n                return path[::-1]\n            \n            if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and grid[nx][ny] not in env.world.cookbook.index and (nx, ny) not in visited:\n                queue.append((nx, ny))\n                visited.add((nx, ny))\n                parent[(nx, ny)] = (x, y)\n    \n    return None\n\n  def generate_actions_from_path(path, current_state):\n      actions = []\n      for next_pos in path:\n          dx, dy = next_pos[0] - current_state.pos[0], next_pos[1] - current_state.pos[1]\n          if (dx, dy) == (-1, 0):\n              actions.append(2)  # LEFT\n          elif (dx, dy) == (1, 0):\n              actions.append(3)  # RIGHT\n          elif (dx, dy) == (0, -1):\n              actions.append(0)  # DOWN\n          elif (dx, dy) == (0, 1):\n              actions.append(1)  # UP\n      \n      return actions\n\n  def is_next_to_workshop(current_state, workshop_index):\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          neighbor_pos = (current_state.pos[0] + dx, current_state.pos[1] + dy)\n          if env.world.grid[neighbor_pos] == workshop_index:\n              return True\n      return False\n\n  def turn_to_face_direction(current_dir, target_dir):\n      direction_map = {(1, 0): 3, (-1, 0): 2, (0, -1): 0, (0, 1): 1}\n      current_idx = ((1, 0), (-1, 0), (0, -1), (0, 1)).index(current_dir)\n      target_idx = ((1, 0), (-1, 0), (0, -1), (0, 1)).index(target_dir)\n\n      if current_idx != target_idx:\n          return [(target_idx + 2) % 4]  # Turn to face the workshop\n      else:\n          return []\n\n  item_index = env.world.cookbook.index[item]\n\n  # If the item has no recipe or is not a crafted item, return an empty action list\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the recipe for the desired item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Check if all required ingredients are available in the inventory\n  required_ingredients = {env.world.cookbook.index[ingredient]: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n  available_ingredients = {k: v for k, v in enumerate(env._current_state.inventory) if v > 0}\n\n  # If all ingredients are not available, return an empty action list\n  if any(required_ingredient not in available_ingredients or available_ingredients[required_ingredient] < count \n         for required_ingredient, count in required_ingredients.items()):\n    return []\n\n  # Find the workshop index where the item should be crafted\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Generate the path to the nearest workshop\n  path_to_workshop = generate_path_to_workshop(env._current_state, workshop_index)\n\n  if not path_to_workshop:\n      return []\n\n  actions = generate_actions_from_path(path_to_workshop, env._current_state)\n\n  # Once at the workshop, face it and perform the USE action\n  target_dir = (path_to_workshop[-1][0] - env._current_state.pos[0], path_to_workshop[-1][1] - env._current_state.pos[1])\n  actions.extend(turn_to_face_direction(env._current_state.dir, target_dir))\n  \n  # Use the workshop to craft the item\n  actions.append(4)  # USE action to craft at the workshop\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T16:14:09.957115", "function_name": "craft", "function_body": "  goal_index = env.world.cookbook.index[item]\n\n  # Check if we have all required primitives in our inventory\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  current_inventory = collections.Counter(env._current_state.inventory)\n\n  for primitive, count in required_primitives.items():\n    if current_inventory[primitive] < count:\n      return []  # Missing required primitives\n\n  # Determine the workshop where crafting should occur\n  recipe_details = env.world.cookbook.recipes[goal_index]\n  workshop_name = recipe_details[\"_key\"]\n\n  # Get the index of the workshop from the world's cookbook\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find all positions of workshops in the grid\n  positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(positions) == 0:\n    return []  # No available workshops\n\n  # Calculate distances to all workshops and find the closest one\n  current_pos = np.array(env._current_state.pos)\n  distances = [np.linalg.norm(current_pos - pos, ord=1) for pos in positions]\n  closest_workshop_idx = np.argmin(distances)\n  closest_workshop_pos = positions[closest_workshop_idx]\n\n  # Determine the direction to move based on the position of the workshop\n  target_pos = np.array(closest_workshop_pos)\n\n  actions = []\n\n  while not np.array_equal(current_pos, target_pos):\n    delta = target_pos - current_pos\n\n    if delta[0] > 0:\n      actions.append(craft.RIGHT)  # Move right\n    elif delta[0] < 0:\n      actions.append(craft.LEFT)   # Move left\n\n    if delta[1] > 0:\n      actions.append(craft.DOWN)   # Move down\n    elif delta[1] < 0:\n      actions.append(craft.UP)     # Move up\n\n    current_pos = np.array(env._current_state.pos)\n\n  # Orient the agent to face the workshop and use it\n  if env._current_state.grid[target_pos[0], target_pos[1], workshop_index] == 1:\n    actions.append(craft.USE)\n\n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T16:14:11.050234", "function_name": "craft", "function_body": "  goal_index = env.world.cookbook.index[item]\n  \n  # Check if we have all required primitives in our inventory\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  current_inventory = collections.Counter(env._current_state.inventory)\n\n  for primitive, count in required_primitives.items():\n    if current_inventory[primitive] < count:\n      return []  # Missing required primitives\n\n  # Determine the workshop where crafting should occur\n  recipe_details = env.world.cookbook.recipes[goal_index]\n  workshop_name = recipe_details[\"_key\"]\n\n  # Get the index of the workshop from the world's cookbook\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find all positions of workshops in the grid\n  positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(positions) == 0:\n    return []  # No available workshops\n\n  # Calculate distances to all workshops and find the closest one\n  current_pos = np.array(env._current_state.pos)\n  distances = [np.linalg.norm(current_pos - pos, ord=1) for pos in positions]\n  closest_workshop_idx = np.argmin(distances)\n  closest_workshop_pos = positions[closest_workshop_idx]\n\n  # Determine the direction to move based on the position of the workshop\n  target_pos = np.array(closest_workshop_pos)\n\n  actions = []\n\n  while not np.array_equal(current_pos, target_pos):\n    delta = target_pos - current_pos\n\n    if delta[0] > 0:\n      actions.append(craft.RIGHT)  # Move right\n    elif delta[0] < 0:\n      actions.append(craft.LEFT)   # Move left\n\n    if delta[1] > 0:\n      actions.append(craft.DOWN)   # Move down\n    elif delta[1] < 0:\n      actions.append(craft.UP)     # Move up\n\n    current_pos = np.array(env._current_state.pos)\n\n  # Orient the agent to face the workshop and use it\n  if env._current_state.grid[target_pos[0], target_pos[1], workshop_index] == 1:\n    actions.append(craft.USE)\n\n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T16:17:03.961444", "function_name": "craft", "function_body": "  def get_direction(current_pos, target_pos):\n    x_diff = target_pos[0] - current_pos[0]\n    y_diff = target_pos[1] - current_pos[1]\n\n    if x_diff > 0:\n      return 3  # RIGHT\n    elif x_diff < 0:\n      return 2  # LEFT\n    elif y_diff > 0:\n      return 1  # UP\n    else:\n      return 0  # DOWN\n\n  def find_path(start, target):\n    actions = []\n\n    start_x, start_y = divmod(start, env._current_state.grid.shape[1])\n    target_x, target_y = divmod(target, env._current_state.grid.shape[1])\n\n    open_set = []\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, target)}\n\n    heapq.heappush(open_set, (f_score[start], start))\n\n    while open_set:\n      _, current = heapq.heappop(open_set)\n\n      if current == target:\n        reconstruct_path(came_from, current)\n        break\n\n      cx, cy = divmod(current, env._current_state.grid.shape[1])\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = cx + dx, cy + dy\n\n        if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n          neighbor = nx * env._current_state.grid.shape[1] + ny\n          tentative_g_score = g_score[current] + 1\n\n          if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n            came_from[neighbor] = current\n            g_score[neighbor] = tentative_g_score\n            f_score[neighbor] = tentative_g_score + heuristic(neighbor, target)\n            heapq.heappush(open_set, (f_score[neighbor], neighbor))\n\n    def reconstruct_path(came_from, current):\n      total_path = []\n      while current in came_from:\n        cx, cy = divmod(current, env._current_state.grid.shape[1])\n        px, py = divmod(came_from[current], env._current_state.grid.shape[1])\n\n        dx, dy = px - cx, py - cy\n        direction_to_face = get_direction((cx, cy), (px, py))\n        \n        # Add direction to face if it's not the same as the current direction\n        if direction_to_face is not None:\n            total_path.append(direction_to_face)\n        \n        current = came_from[current]\n\n      actions.extend(reversed(total_path))\n\n    return actions\n\n  def heuristic(a, b):\n    ax, ay = divmod(a, env._current_state.grid.shape[1])\n    bx, by = divmod(b, env._current_state.grid.shape[1])\n\n    # Manhattan distance\n    return abs(ax - bx) + abs(ay - by)\n\n  actions = []\n\n  item_index = env.world.cookbook.index[item]\n\n  if not item_index:\n    return []\n\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  current_inventory = {env.world.cookbook.index.get(i): c for i, c in enumerate(env._current_state.inventory) if c > 0}\n\n  # Check if we have all the required primitives\n  for primitive_index, count in primitives_needed.items():\n    if current_inventory.get(primitive_index, 0) < count:\n      return []\n\n  # Find the workshop to craft the item\n  workshop_name = env.world.cookbook.recipes[item_index][\"_at\"]\n  workshop_indices = np.argwhere(env._current_state.grid[:, :, env.world.workshop_indices[0]] == env.world.cookbook.index[workshop_name])\n\n  if not workshop_indices.any():\n    return []\n\n  # Convert the grid coordinates to a flat list\n  flat_grid = env._current_state.grid.reshape(-1, env.world.n_kinds)\n\n  start_pos_flat = env._current_state.pos[0] * env._current_state.grid.shape[1] + env._current_state.pos[1]\n  target_pos_flat = workshop_indices[0][0] * env._current_state.grid.shape[1] + workshop_indices[0][1]\n\n  actions.extend(find_path(start_pos_flat, target_pos_flat))\n\n  # Ensure we are in front of the workshop\n  target_workshop_position = (workshop_indices[0][0], workshop_indices[0][1])\n  direction_to_face = get_direction(env._current_state.pos, target_workshop_position)\n  \n  if direction_to_face is not None:\n      actions.append(direction_to_face)\n\n  # Craft the item by using the USE action\n  actions.append(4)  # USE action\n\n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T16:17:05.080696", "function_name": "craft", "function_body": "  def get_direction(current_pos, target_pos):\n    x_diff = target_pos[0] - current_pos[0]\n    y_diff = target_pos[1] - current_pos[1]\n\n    if x_diff > 0:\n      return 3  # RIGHT\n    elif x_diff < 0:\n      return 2  # LEFT\n    elif y_diff > 0:\n      return 1  # UP\n    else:\n      return 0  # DOWN\n\n  def find_path(start, target):\n    actions = []\n\n    start_x, start_y = divmod(start, env._current_state.grid.shape[1])\n    target_x, target_y = divmod(target, env._current_state.grid.shape[1])\n\n    open_set = []\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, target)}\n\n    heapq.heappush(open_set, (f_score[start], start))\n\n    while open_set:\n      _, current = heapq.heappop(open_set)\n\n      if current == target:\n        reconstruct_path(came_from, current)\n        break\n\n      cx, cy = divmod(current, env._current_state.grid.shape[1])\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = cx + dx, cy + dy\n\n        if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n          neighbor = nx * env._current_state.grid.shape[1] + ny\n          tentative_g_score = g_score[current] + 1\n\n          if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n            came_from[neighbor] = current\n            g_score[neighbor] = tentative_g_score\n            f_score[neighbor] = tentative_g_score + heuristic(neighbor, target)\n            heapq.heappush(open_set, (f_score[neighbor], neighbor))\n\n    def reconstruct_path(came_from, current):\n      total_path = []\n      while current in came_from:\n        cx, cy = divmod(current, env._current_state.grid.shape[1])\n        px, py = divmod(came_from[current], env._current_state.grid.shape[1])\n\n        dx, dy = px - cx, py - cy\n        direction_to_face = get_direction((cx, cy), (px, py))\n        total_path.append(direction_to_face)\n        current = came_from[current]\n\n      actions.extend(reversed(total_path))\n\n    return actions\n\n  def heuristic(a, b):\n    ax, ay = divmod(a, env._current_state.grid.shape[1])\n    bx, by = divmod(b, env._current_state.grid.shape[1])\n\n    # Manhattan distance\n    return abs(ax - bx) + abs(ay - by)\n\n  actions = []\n\n  item_index = env.world.cookbook.index[item]\n\n  if not item_index:\n    return []\n\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  current_inventory = {env.world.cookbook.index.get(i): c for i, c in enumerate(env._current_state.inventory) if c > 0}\n\n  # Check if we have all the required primitives\n  missing_primitives = []\n  for primitive_index, count in primitives_needed.items():\n    if current_inventory.get(primitive_index, 0) < count:\n      missing_primitives.append((primitive_index, count - current_inventory.get(primitive_index, 0)))\n\n  if missing_primitives:\n    return []\n\n  workshop_name = env.world.cookbook.recipes[item_index][\"_at\"]\n  workshop_indices = np.argwhere(env._current_state.grid[:, :, env.world.workshop_indices[0]] == env.world.cookbook.index[workshop_name])\n\n  if not workshop_indices.any():\n    return []\n\n  start_pos_flat = env._current_state.pos[0] * env._current_state.grid.shape[1] + env._current_state.pos[1]\n  target_workshop_position = (workshop_indices[0][0], workshop_indices[0][1])\n  target_pos_flat = target_workshop_position[0] * env._current_state.grid.shape[1] + target_workshop_position[1]\n\n  actions.extend(find_path(start_pos_flat, target_pos_flat))\n\n  direction_to_face = get_direction(env._current_state.pos, target_workshop_position)\n  if direction_to_face is not None:\n      actions.append(direction_to_face)\n\n  # Craft the item by using the USE action\n  actions.append(4)  # USE action\n\n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T16:19:35.315124", "function_name": "craft", "function_body": "  def bfs(start, goals):\n    queue = collections.deque([start])\n    visited = set()\n    parent_map = {}\n\n    while queue:\n      current_pos = queue.popleft()\n\n      if current_pos in goals:\n        path = []\n        while current_pos != start:\n          path.append(current_pos)\n          current_pos = parent_map[current_pos]\n        path.reverse()\n        return path\n\n      if current_pos in visited:\n        continue\n\n      visited.add(current_pos)\n\n      # Check all four possible directions\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        new_x = current_pos[0] + dx\n        new_y = current_pos[1] + dy\n\n        if 0 <= new_x < env._current_state.grid.shape[0] and 0 <= new_y < env._current_state.grid.shape[1]:\n          # Check if the cell is empty (not blocked by any item)\n          if not np.any(env._current_state.grid[new_x, new_y]):\n            queue.append((new_x, new_y))\n            parent_map[(new_x, new_y)] = current_pos\n\n    return None  # No path found\n  \n  def get_actions_to_move(from_pos, to_pos):\n    path = bfs(from_pos, [to_pos])\n    if not path:\n      return []\n    \n    action_map = {(-1, 0): craft.MOVE_UP, (1, 0): craft.MOVE_DOWN, (0, -1): craft.MOVE_LEFT, (0, 1): craft.MOVE_RIGHT}\n    actions = [action_map[(path[i][0] - path[i-1][0], path[i][1] - path[i-1][1])] for i in range(1, len(path))]\n    \n    return actions\n  \n  idx = env.world.cookbook.index[item]\n\n  # Check if we have all required primitives in our inventory\n  required_primitives = env.world.cookbook.primitives_for(idx)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory)}\n\n  missing_items = []\n  for primitive, count in required_primitives.items():\n      if primitive not in inventory_dict or inventory_dict[primitive] < count:\n          missing_items.append((primitive, count - (inventory_dict[primitive] if primitive in inventory_dict else 0)))\n\n  if missing_items:\n    return []  # Cannot craft the item because we're missing some items\n\n  # Find all positions of the required workshop in the grid\n  recipe = env.world.cookbook.recipes[idx]\n  workshop_name = [key for key in recipe.keys() if 'WORKSHOP' in key][0]\n  workshop_idx = env.world.cookbook.index[workshop_name]\n\n  workshop_positions = []\n  for i in range(env._current_state.grid.shape[0]):\n      for j in range(env._current_state.grid.shape[1]):\n          if env._current_state.grid[i, j, workshop_idx] == 1:\n              workshop_positions.append((i, j))\n\n  # Plan the path to the closest workshop position using BFS\n  start_pos = env._current_state.pos\n  closest_workshop_path = min([bfs(start_pos, [pos]) for pos in workshop_positions], key=lambda x: len(x) if x else float('inf'))\n\n  if not closest_workshop_path:\n    return []  # Could not find a valid path to any workshop\n\n  actions_to_workshop = get_actions_to_move(start_pos, closest_workshop_path[-1])\n\n  # Add USE action to actually craft the item\n  actions = actions_to_workshop + [craft.USE_ACTION]\n\n  return actions", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T16:19:36.296758", "function_name": "craft", "function_body": "  idx = env.world.cookbook.index[item]\n\n  # Step 2: Check if we have all the required primitives to craft this item\n  required_primitives = env.world.cookbook.primitives_for(idx)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory)}\n\n  missing_items = [(primitive, count - (inventory_dict[primitive] if primitive in inventory_dict else 0))\n                   for primitive, count in required_primitives.items()\n                   if primitive not in inventory_dict or inventory_dict[primitive] < count]\n\n  if missing_items:\n    # Try to collect the missing items\n    actions = []\n    for primitive, count in missing_items:\n      actions += collect(env, primitive)\n      if len(actions) >= env._max_steps:  # Avoid infinite loop\n        return []\n    return actions\n\n  # Step 3: Determine the workshop index\n  recipe = env.world.cookbook.recipes[idx]\n  workshop_name = [key for key in recipe.keys() if 'WORKSHOP' in key][0]\n  workshop_idx = env.world.cookbook.index[workshop_name]\n\n  # Step 4: Find all positions of the required workshop in the grid\n  workshop_positions = []\n  for i in range(env._current_state.grid.shape[0]):\n    for j in range(env._current_state.grid.shape[1]):\n      if env._current_state.grid[i, j, workshop_idx] == 1:\n        workshop_positions.append((i, j))\n\n  # Step 5: Plan the path to the closest workshop position using BFS\n  def bfs(start, goals):\n    queue = collections.deque([start])\n    visited = set()\n    parent_map = {}\n\n    while queue:\n      current_pos = queue.popleft()\n\n      if current_pos in goals:\n        path = []\n        while current_pos != start:\n          path.append(current_pos)\n          current_pos = parent_map[current_pos]\n        path.reverse()\n        return path\n\n      if current_pos in visited:\n        continue\n\n      visited.add(current_pos)\n\n      # Check all four possible directions\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        new_x = current_pos[0] + dx\n        new_y = current_pos[1] + dy\n\n        if 0 <= new_x < env._current_state.grid.shape[0] and 0 <= new_y < env._current_state.grid.shape[1]:\n          # Check if the cell is empty (not blocked by any item)\n          if not np.any(env._current_state.grid[new_x, new_y]):\n            queue.append((new_x, new_y))\n            parent_map[(new_x, new_y)] = current_pos\n\n    return None  # No path found\n\n  start_pos = env._current_state.pos\n  closest_workshop_path = min([bfs(start_pos, [pos]) for pos in workshop_positions], key=lambda x: len(x) if x else float('inf'))\n\n  if not closest_workshop_path:\n    return []  # Could not find a valid path to any workshop\n\n  actions_to_workshop = []\n  action_map = {(-1, 0): craft.MOVE_UP, (1, 0): craft.MOVE_DOWN, (0, -1): craft.MOVE_LEFT, (0, 1): craft.MOVE_RIGHT}\n\n  for i in range(1, len(closest_workshop_path)):\n    dx, dy = closest_workshop_path[i][0] - closest_workshop_path[i-1][0], closest_workshop_path[i][1] - closest_workshop_path[i-1][1]\n    actions_to_workshop.append(action_map[(dx, dy)])\n\n  # Step 6: Move to the workshop and perform the USE action\n  return actions_to_workshop + [craft.USE_ACTION]", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-11T16:21:26.989982", "function_name": "craft", "function_body": "  def has_all_primitives(required_primitives, inventory_dict):\n    return all(primitive in inventory_dict and inventory_dict[primitive] >= required_primitives[primitive] for primitive in required_primitives)\n\n  actions = []\n  \n  # Get the index of the goal item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  # If not all primitives are available return empty action list\n  if not has_all_primitives(required_primitives, inventory_dict):\n    return []\n  \n  # Find the workshop where we can craft this item and its position\n  workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n      if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n          workshop_index = recipe.get(\"_at\")\n          break\n  \n  if workshop_index is None:\n    return []\n\n  # Find the positions of all workshops with the same index\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(workshop_positions) == 0:\n    return []\n  \n  # Select the closest workshop\n  current_pos = env._current_state.pos\n  target_workshop_pos = min(workshop_positions, key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1]))\n\n  # Navigate to the selected workshop\n  actions.extend(navigate(env._current_state, target_workshop_pos))\n  \n  # Turn towards the workshop if not already facing it\n  current_direction = env._current_state.dir\n  direction_to_workshop = get_direction(current_pos, target_workshop_pos)\n  if current_direction != direction_to_workshop:\n    actions.append(direction_to_workshop)\n\n  # Check if we are in front of the workshop\n  next_pos = move_in_direction(target_workshop_pos, opposite_direction(direction_to_workshop))\n  if env._current_state.grid[next_pos[0], next_pos[1], workshop_index] == 0:\n      # Move one step forward to face the workshop\n      actions.append(direction_to_workshop)\n  \n  # Use the USE action to craft the item at the workshop\n  actions.append(4)  # Assuming 4 is the index for the USE action\n  \n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T16:21:28.109116", "function_name": "craft", "function_body": "  def has_all_primitives(required_primitives, inventory_dict):\n    return all(primitive in inventory_dict and inventory_dict[primitive] >= required_primitives[primitive] for primitive in required_primitives)\n\n  actions = []\n  \n  # Get the index of the goal item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  # If not all primitives are available return empty action list\n  if not has_all_primitives(required_primitives, inventory_dict):\n    return []\n  \n  # Find the workshop where we can craft this item\n  workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n      if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n          workshop_index = recipe.get(\"_at\")\n          break\n  \n  if workshop_index is None:\n    return []\n\n  # Convert workshop index to the actual name of the workshop\n  workshop_name = env.world.cookbook.index.get(workshop_index)\n  \n  # Find the position of all workshops in the grid and choose the nearest one\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(workshop_positions) == 0:\n    return []\n  \n  current_pos = env._current_state.pos\n  target_workshop_pos = min(workshop_positions, key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1]))\n\n  # Navigate to the selected workshop\n  actions.extend(navigate(env._current_state, target_workshop_pos))\n  \n  # Turn towards the workshop if not already facing it\n  current_direction = env._current_state.dir\n  direction_to_workshop = get_direction(current_pos, target_workshop_pos)\n  if current_direction != direction_to_workshop:\n    actions.append(direction_to_workshop)\n\n  # Check if we are directly in front of the workshop\n  next_pos = move_in_direction(target_workshop_pos, opposite_direction(direction_to_workshop))\n  if env._current_state.grid[next_pos[0], next_pos[1], workshop_index] == 0:\n      # Move one step forward to face the workshop\n      actions.append(direction_to_workshop)\n\n  # Use the USE action to craft the item at the workshop\n  actions.append(4)  # Assuming 4 is the index for the USE action\n  \n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T16:23:41.677200", "function_name": "craft", "function_body": "  def move_to_position(target_pos):\n      \"\"\"Generates a list of actions to move from current position to target position.\"\"\"\n      actions = []\n      agent_pos = np.array(env._current_state.pos)\n      delta = target_pos - agent_pos\n      \n      while not np.all(delta == 0):\n          if abs(delta[0]) > abs(delta[1]):\n              if delta[0] > 0:\n                  actions.append(craft.N_DOWN)  # Move down\n                  delta[0] -= 1\n              else:\n                  actions.append(craft.N_UP)    # Move up\n                  delta[0] += 1\n          elif abs(delta[1]) > abs(delta[0]):\n              if delta[1] > 0:\n                  actions.append(craft.N_RIGHT) # Move right\n                  delta[1] -= 1\n              else:\n                  actions.append(craft.N_LEFT)  # Move left\n                  delta[1] += 1\n          elif np.all(delta != 0):\n              move_x, move_y = np.random.choice([(0, 1), (0, -1), (1, 0), (-1, 0)])\n              if move_x == 1:\n                  actions.append(craft.N_DOWN)\n                  delta[0] -= 1\n              elif move_x == -1:\n                  actions.append(craft.N_UP)\n                  delta[0] += 1\n              elif move_y == 1:\n                  actions.append(craft.N_RIGHT)\n                  delta[1] -= 1\n              else:\n                  actions.append(craft.N_LEFT)\n                  delta[1] += 1\n      \n      return actions\n\n  i_goal = env.world.cookbook.index[item]\n  \n  # Get the primitives required to craft this item\n  prim_reqs = env.world.cookbook.primitives_for(i_goal)\n  \n  actions_list = []\n\n  # Check if we have all the required primitives in our inventory\n  for i_prim, count in prim_reqs.items():\n      if env._current_state.inventory[i_prim] < count:\n          return []  # If any primitive is missing, return an empty action list\n\n  # Find which workshop to use for crafting\n  workshop_index = None\n  workshop_name = \"_key\"\n\n  # Iterate over the recipes and find the workshop\n  for output_index, recipe in env.world.cookbook.recipes.items():\n      if i_goal == output_index:\n          workshop_name = recipe[\"_at\"]\n          break\n\n  # Get the index of the workshop from the environment's indices\n  try:\n      workshop_index = getattr(env.world, f\"{workshop_name}_index\")\n  except AttributeError:\n      return []  # If the workshop is not found, return an empty action list\n\n  # Now that we have all the requirements and know where to craft, let's move to the workshop\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n  if not workshop_positions.any():\n      return []  # If no workshops are found, return an empty action list\n\n  # Choose the closest workshop (or any available)\n  agent_pos = np.array(env._current_state.pos)\n  distances = np.linalg.norm(agent_pos - workshop_positions, axis=1)\n  closest_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n\n  # Move to the position next to the workshop\n  actions_to_workshop = move_to_position(np.array(closest_workshop_pos))\n  \n  # Add action to use the workshop\n  actions_to_workshop.append(craft.N_USE)\n\n  return actions_to_workshop", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T16:23:42.766870", "function_name": "craft", "function_body": "  i_goal = env.world.cookbook.index[item]\n  \n  # Get the primitives required to craft this item\n  prim_reqs = env.world.cookbook.primitives_for(i_goal)\n  \n  # Actions list to be returned\n  actions_list = []\n\n  # Check if we have all the required primitives in our inventory\n  for i_prim, count in prim_reqs.items():\n      if env._current_state.inventory[i_prim] < count:\n          return []  # If any primitive is missing, return an empty action list\n  \n  # Find which workshop to use for crafting\n  workshop_index = None\n  workshop_name = \"_key\"\n  \n  # Iterate over the recipes and find the workshop\n  for output_index, recipe in env.world.cookbook.recipes.items():\n      if i_goal == output_index:\n          workshop_name = recipe[\"_at\"]\n          break\n  \n  # Get the index of the workshop from the environment's indices\n  try:\n      workshop_index = getattr(env.world, f\"{workshop_name}_index\")\n  except AttributeError:\n      return []  # If the workshop is not found, return an empty action list\n\n  # Now that we have all the requirements and know where to craft, let's move to the workshop\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) > 0:\n      closest_workshop_pos = workshop_positions[0]\n\n      # Calculate the direction towards the workshop\n      agent_pos = env._current_state.pos\n      delta_x = closest_workshop_pos[0] - agent_pos[0]\n      delta_y = closest_workshop_pos[1] - agent_pos[1]\n\n      # Move to the position next to the workshop\n      while not (delta_x == 0 and delta_y == 0):\n          action = None\n      \n          if abs(delta_x) > abs(delta_y):\n              move_x = np.sign(delta_x)\n              actions_list.append(craft.MOVE_FUNC(craft.DOWN if move_x == 1 else craft.UP))\n              delta_x -= move_x\n          elif abs(delta_y) > abs(delta_x):\n              move_y = np.sign(delta_y)\n              actions_list.append(craft.MOVE_FUNC(craft.RIGHT if move_y == 1 else craft.LEFT))\n              delta_y -= move_y\n      \n          # Handle the case where both deltas are equal (diagonal movement)\n          else:\n              move_x, move_y = np.random.choice([(0, 1), (0, -1), (1, 0), (-1, 0)])\n              actions_list.append(craft.MOVE_FUNC(craft.RIGHT if move_x == 1 else \n                                                    craft.LEFT if move_x == -1 else \n                                                    craft.DOWN if move_y == 1 else \n                                                    craft.UP))\n      \n      # Once we reach the workshop, use it to craft the item\n      actions_list.append(craft.USE_FUNC())\n  \n  return actions_list", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T16:26:16.806490", "function_name": "craft", "function_body": "  idx = env.world.cookbook.index[item]\n\n  # Step 1: Check if we have all the required primitives in our inventory\n  required_primitives = env.world.cookbook.primitives_for(idx)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory)}\n\n  missing_items = []\n  for primitive, count in required_primitives.items():\n      if primitive not in inventory_dict or inventory_dict[primitive] < count:\n          missing_items.append((primitive, count - (inventory_dict[primitive] if primitive in inventory_dict else 0)))\n\n  if missing_items:\n      # If there are missing items, collect them first\n      actions = []\n      for primitive, additional_needed in missing_items:\n          primitive_name = list(env.world.cookbook.index.keys())[list(env.world.cookbook.index.values()).index(primitive)]\n          actions.extend(collect_v2(env, primitive_name, additional_needed))\n      return actions\n\n  # Step 2: Find the positions of all workshops that can craft this item\n  recipe = env.world.cookbook.recipes[idx]\n  workshop_name = list(recipe.keys())[-1]\n  workshop_idx = env.world.cookbook.index[workshop_name]\n\n  workshop_positions = []\n  for i in range(env._current_state.grid.shape[0]):\n      for j in range(env._current_state.grid.shape[1]):\n          if env._current_state.grid[i, j, workshop_idx] == 1:\n              workshop_positions.append((i, j))\n\n  # Step 3: Plan the path to the closest workshop using BFS\n  def bfs(start, goals):\n    queue = collections.deque([start])\n    visited = set()\n    parent_map = {}\n\n    while queue:\n      current_pos = queue.popleft()\n\n      if current_pos in goals:\n        path = []\n        while current_pos != start:\n          path.append(current_pos)\n          current_pos = parent_map[current_pos]\n        path.reverse()\n        return path\n\n      if current_pos in visited:\n        continue\n\n      visited.add(current_pos)\n\n      # Check all four possible directions\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        new_x = current_pos[0] + dx\n        new_y = current_pos[1] + dy\n\n        if 0 <= new_x < env._current_state.grid.shape[0] and 0 <= new_y < env._current_state.grid.shape[1]:\n          # Check if the cell is empty (not blocked by any item)\n          if not np.any(env._current_state.grid[new_x, new_y]):\n            queue.append((new_x, new_y))\n            parent_map[(new_x, new_y)] = current_pos\n\n    return None  # No path found\n\n  start_pos = env._current_state.pos\n  closest_path_to_workshop = min([bfs(start_pos, [pos]) for pos in workshop_positions], key=lambda x: len(x) if x else float('inf'))\n\n  if not closest_path_to_workshop:\n    return []\n\n  # Step 4: Generate actions to move along the planned path\n  action_map = {(-1, 0): craft.MOVE_UP, (1, 0): craft.MOVE_DOWN, (0, -1): craft.MOVE_LEFT, (0, 1): craft.MOVE_RIGHT}\n  actions_to_workshop = [action_map[(closest_path_to_workshop[i][0] - closest_path_to_workshop[i-1][0], closest_path_to_workshop[i][1] - closest_path_to_workshop[i-1][1])] for i in range(1, len(closest_path_to_workshop))]\n\n  # Step 5: Add USE action to actually craft the item\n  actions = actions_to_workshop + [craft.USE_ACTION]\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-11T16:26:17.857086", "function_name": "craft", "function_body": "  idx = env.world.cookbook.index[item]\n\n  # Step 1: Check if we have all the required primitives in our inventory\n  required_primitives = env.world.cookbook.primitives_for(idx)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory)}\n\n  missing_items = []\n  for primitive, count in required_primitives.items():\n      if primitive not in inventory_dict or inventory_dict[primitive] < count:\n          missing_items.append((primitive, count - (inventory_dict[primitive] if primitive in inventory_dict else 0)))\n\n  if missing_items:\n      return []\n\n  # Step 2: Find the positions of all workshops that can craft this item\n  recipe = env.world.cookbook.recipes[idx]\n  workshop_name = list(recipe.keys())[-1]\n  workshop_idx = env.world.cookbook.index[workshop_name]\n\n  workshop_positions = []\n  for i in range(env._current_state.grid.shape[0]):\n      for j in range(env._current_state.grid.shape[1]):\n          if env._current_state.grid[i, j, workshop_idx] == 1:\n              workshop_positions.append((i, j))\n\n  # Step 3: Plan the path to the closest workshop using BFS\n  def bfs(start, goals):\n    queue = collections.deque([start])\n    visited = set()\n    parent_map = {}\n\n    while queue:\n      current_pos = queue.popleft()\n\n      if current_pos in goals:\n        path = []\n        while current_pos != start:\n          path.append(current_pos)\n          current_pos = parent_map[current_pos]\n        path.reverse()\n        return path\n\n      if current_pos in visited:\n        continue\n\n      visited.add(current_pos)\n\n      # Check all four possible directions\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        new_x = current_pos[0] + dx\n        new_y = current_pos[1] + dy\n\n        if 0 <= new_x < env._current_state.grid.shape[0] and 0 <= new_y < env._current_state.grid.shape[1]:\n          # Check if the cell is empty (not blocked by any item)\n          if not np.any(env._current_state.grid[new_x, new_y]):\n            queue.append((new_x, new_y))\n            parent_map[(new_x, new_y)] = current_pos\n\n    return None  # No path found\n\n  start_pos = env._current_state.pos\n  closest_path_to_workshop = min([bfs(start_pos, [pos]) for pos in workshop_positions], key=lambda x: len(x) if x else float('inf'))\n\n  if not closest_path_to_workshop:\n    return []\n\n  # Step 4: Generate actions to move along the planned path\n  action_map = {(-1, 0): craft.MOVE_UP, (1, 0): craft.MOVE_DOWN, (0, -1): craft.MOVE_LEFT, (0, 1): craft.MOVE_RIGHT}\n  actions_to_workshop = [action_map[(closest_path_to_workshop[i][0] - closest_path_to_workshop[i-1][0], closest_path_to_workshop[i][1] - closest_path_to_workshop[i-1][1])] for i in range(1, len(closest_path_to_workshop))]\n\n  # Step 5: Add USE action to actually craft the item\n  actions = actions_to_workshop + [craft.USE_ACTION]\n  \n  return actions", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T16:28:14.436177", "function_name": "craft", "function_body": "  # Fetch the index for the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Get primitives required to make the item\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n\n  # Check if we already have all the primitives in our inventory\n  all_primitives_collected = True\n  for primitive, count in primitives_required.items():\n    if env._current_state.inventory[primitive] < count:\n      all_primitives_collected = False\n      break\n\n  # If not all primitives are collected, return an empty action list\n  if not all_primitives_collected:\n    return []\n\n  # Find the workshop that can craft this item\n  target_workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n    if \"_key\" in recipe and item_index in recipe.values():\n      target_workshop_index = recipe[\"_key\"]\n      break\n\n  # If no valid workshop is found, return an empty action list\n  if target_workshop_index is None:\n    return []\n\n  # Find the position of the target workshop on the grid\n  target_workshop_pos = None\n  for x in range(env._current_state.grid.shape[0]):\n      for y in range(env._current_state.grid.shape[1]):\n          if env._current_state.grid[x, y, target_workshop_index] == 1:\n              target_workshop_pos = (x, y)\n              break\n      if target_workshop_pos is not None:\n          break\n\n  # If no valid workshop position found, return an empty action list\n  if target_workshop_pos is None:\n    return []\n\n  # Calculate the path to the target workshop\n  start = env._current_state.pos\n  goal = target_workshop_pos\n  path = a_star_search(env._current_state.grid, start, goal)\n\n  if not path:\n      return []\n\n  # Convert path to actions\n  actions = convert_path_to_actions(path, start)\n  \n  # Calculate the direction to face the target workshop\n  dx = target_workshop_pos[0] - env._current_state.pos[0]\n  dy = target_workshop_pos[1] - env._current_state.pos[1]\n\n  if abs(dx) > abs(dy):\n      direction_to_face = \"RIGHT\" if dx > 0 else \"LEFT\"\n  else:\n      direction_to_face = \"DOWN\" if dy > 0 else \"UP\"\n\n  # Move towards the target workshop and face it\n  actions.append(env.world.cookbook.index[direction_to_face])\n\n  # Add USE action to craft the item\n  actions.append(env.world.cookbook.index[\"USE\"])\n\n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T16:28:15.486214", "function_name": "craft", "function_body": "  def get_workshop_position(grid, workshop_index):\n      for x in range(grid.shape[0]):\n          for y in range(grid.shape[1]):\n              if grid[x, y, workshop_index] == 1:\n                  return (x, y)\n      return None\n\n  actions = []\n\n  # Fetch the index for the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Get primitives required to make the item\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n\n  # Check if we already have all the primitives in our inventory\n  all_primitives_collected = True\n  for primitive, count in primitives_required.items():\n      if env._current_state.inventory[primitive] < count:\n          all_primitives_collected = False\n          break\n\n  # If not all primitives are collected, return an empty action list\n  if not all_primitives_collected:\n      return []\n\n  # Find the workshop that can craft this item\n  target_workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n      if \"_key\" in recipe and item_index in recipe.values():\n          target_workshop_index = recipe[\"_key\"]\n          break\n\n  # If no valid workshop is found, return an empty action list\n  if target_workshop_index is None:\n      return []\n\n  # Find the position of the target workshop on the grid\n  target_workshop_pos = get_workshop_position(env._current_state.grid, target_workshop_index)\n\n  # If no valid workshop position found, return an empty action list\n  if target_workshop_pos is None:\n      return []\n\n  # Calculate the path to the target workshop\n  start = env._current_state.pos\n  goal = target_workshop_pos\n  path = a_star_search(env._current_state.grid, start, goal)\n\n  if not path:\n      return []\n\n  # Convert path to actions\n  for i in range(1, len(path)):\n      dx = path[i][0] - path[i-1][0]\n      dy = path[i][1] - path[i-1][1]\n\n      if dx == 1:\n          actions.append(env.world.cookbook.index[\"RIGHT\"])\n      elif dx == -1:\n          actions.append(env.world.cookbook.index[\"LEFT\"])\n      elif dy == 1:\n          actions.append(env.world.cookbook.index[\"DOWN\"])\n      elif dy == -1:\n          actions.append(env.world.cookbook.index[\"UP\"])\n\n  # Calculate the direction to face the target workshop\n  dx = target_workshop_pos[0] - env._current_state.pos[0]\n  dy = target_workshop_pos[1] - env._current_state.pos[1]\n\n  if abs(dx) > abs(dy):\n      direction_to_face = \"RIGHT\" if dx > 0 else \"LEFT\"\n  else:\n      direction_to_face = \"DOWN\" if dy > 0 else \"UP\"\n\n  # Move towards the target workshop and face it\n  actions.append(env.world.cookbook.index[direction_to_face])\n\n  # Add USE action to craft the item\n  actions.append(env.world.cookbook.index[\"USE\"])\n\n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T16:31:05.751395", "function_name": "craft", "function_body": "  def get_direction(current_pos, target_pos):\n    x_diff = target_pos[0] - current_pos[0]\n    y_diff = target_pos[1] - current_pos[1]\n\n    if x_diff == 0 and y_diff == 0:\n      return None\n\n    directions = [\n        (0, 1, 3),   # RIGHT\n        (0, -1, 2),  # LEFT\n        (-1, 0, 0),  # UP\n        (1, 0, 1)    # DOWN\n    ]\n\n    for dx, dy, direction in directions:\n      if x_diff == dx and y_diff == dy:\n        return direction\n\n    return None\n\n  def find_path(start, target):\n    actions = []\n    \n    start_x, start_y = divmod(start, env._current_state.grid.shape[1])\n    target_x, target_y = divmod(target, env._current_state.grid.shape[1])\n\n    open_set = set()\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, target)}\n\n    heapq.heappush(open_set, (f_score[start], start))\n\n    while open_set:\n      _, current = heapq.heappop(open_set)\n\n      if current == target:\n        reconstruct_path(came_from, current)\n        break\n\n      cx, cy = divmod(current, env._current_state.grid.shape[1])\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = cx + dx, cy + dy\n\n        if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n          neighbor = nx * env._current_state.grid.shape[1] + ny\n          tentative_g_score = g_score[current] + 1\n\n          if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n            came_from[neighbor] = current\n            g_score[neighbor] = tentative_g_score\n            f_score[neighbor] = tentative_g_score + heuristic(neighbor, target)\n            heapq.heappush(open_set, (f_score[neighbor], neighbor))\n\n    def reconstruct_path(came_from, current):\n      total_path = []\n      while current in came_from:\n        cx, cy = divmod(current, env._current_state.grid.shape[1])\n        px, py = divmod(came_from[current], env._current_state.grid.shape[1])\n\n        dx, dy = px - cx, py - cy\n        direction = get_direction((cx, cy), (px, py))\n        if direction is not None:\n          total_path.append(direction)\n        current = came_from[current]\n      \n      actions.extend(reversed(total_path))\n\n    return actions\n\n  def heuristic(a, b):\n    ax, ay = divmod(a, env._current_state.grid.shape[1])\n    bx, by = divmod(b, env._current_state.grid.shape[1])\n\n    return abs(ax - bx) + abs(ay - by)\n\n  item_index = env.world.cookbook.index.get(item)\n  \n  if not item_index:\n    return []\n\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  current_inventory = {env.world.cookbook.index.get(i): c for i, c in enumerate(env._current_state.inventory) if c > 0}\n\n  missing_primitives = []\n  for primitive_index, count in primitives_needed.items():\n    if current_inventory.get(primitive_index, 0) < count:\n      missing_primitives.append((primitive_index, count - current_inventory.get(primitive_index, 0)))\n\n  if missing_primitives:\n    # Attempt to collect missing primitives\n    actions = []\n    for primitive_index, count in missing_primitives:\n      primitive_name = env.world.cookbook.reverse_index[primitive_index]\n      primitive_actions = collect_v2(env, primitive_name)\n      if not primitive_actions:\n        return []\n      actions.extend(primitive_actions)\n\n      # Check again after collecting primitives\n      current_inventory[primitive_index] = count\n    else:\n      return []\n\n  workshop_name = env.world.cookbook.recipes[item_index][\"_at\"]\n  workshop_indices = [(x, y) for x in range(env._current_state.grid.shape[0]) \n                      for y in range(env._current_state.grid.shape[1])\n                      if env._current_state.grid[x, y, env.world.workshop_indices[0]] == env.world.cookbook.index[workshop_name]]\n\n  if not workshop_indices:\n    return []\n\n  closest_workshop = min(workshop_indices, key=lambda p: heuristic(start_pos_flat, \n                                                                   p[0] * env._current_state.grid.shape[1] + p[1]))\n\n  start_pos_flat = env._current_state.pos[0] * env._current_state.grid.shape[1] + env._current_state.pos[1]\n  target_pos_flat = closest_workshop[0] * env._current_state.grid.shape[1] + closest_workshop[1]\n\n  actions.extend(find_path(start_pos_flat, target_pos_flat))\n\n  direction_to_face = get_direction(env._current_state.pos, closest_workshop)\n  if direction_to_face is not None:\n      actions.append(direction_to_face)\n\n  actions.append(4)  # USE action\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-11T16:31:06.723342", "function_name": "craft", "function_body": "  def get_direction(current_pos, target_pos):\n    x_diff = target_pos[0] - current_pos[0]\n    y_diff = target_pos[1] - current_pos[1]\n\n    if x_diff == 0 and y_diff == 0:\n      return None\n\n    directions = [\n        (0, 1, 3),   # RIGHT\n        (0, -1, 2),  # LEFT\n        (-1, 0, 0),  # UP\n        (1, 0, 1)    # DOWN\n    ]\n\n    for dx, dy, direction in directions:\n      if x_diff == dx and y_diff == dy:\n        return direction\n\n    return None\n\n  def find_path(start, target):\n    actions = []\n    \n    start_x, start_y = divmod(start, env._current_state.grid.shape[1])\n    target_x, target_y = divmod(target, env._current_state.grid.shape[1])\n\n    open_set = []\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, target)}\n\n    heapq.heappush(open_set, (f_score[start], start))\n\n    while open_set:\n      _, current = heapq.heappop(open_set)\n\n      if current == target:\n        reconstruct_path(came_from, current)\n        break\n\n      cx, cy = divmod(current, env._current_state.grid.shape[1])\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = cx + dx, cy + dy\n\n        if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n          neighbor = nx * env._current_state.grid.shape[1] + ny\n          tentative_g_score = g_score[current] + 1\n\n          if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n            came_from[neighbor] = current\n            g_score[neighbor] = tentative_g_score\n            f_score[neighbor] = tentative_g_score + heuristic(neighbor, target)\n            heapq.heappush(open_set, (f_score[neighbor], neighbor))\n\n    def reconstruct_path(came_from, current):\n      total_path = []\n      while current in came_from:\n        cx, cy = divmod(current, env._current_state.grid.shape[1])\n        px, py = divmod(came_from[current], env._current_state.grid.shape[1])\n\n        dx, dy = px - cx, py - cy\n        direction_to_face = get_direction((cx, cy), (px, py))\n        if direction_to_face is not None:\n            total_path.append(direction_to_face)\n        current = came_from[current]\n      \n      actions.extend(reversed(total_path))\n\n    return actions\n\n  def heuristic(a, b):\n    ax, ay = divmod(a, env._current_state.grid.shape[1])\n    bx, by = divmod(b, env._current_state.grid.shape[1])\n\n    return abs(ax - bx) + abs(ay - by)\n\n  item_index = env.world.cookbook.index[item]\n  \n  if not item_index:\n    return []\n\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  current_inventory = {env.world.cookbook.index.get(i): c for i, c in enumerate(env._current_state.inventory) if c > 0}\n\n  missing_primitives = []\n  for primitive_index, count in primitives_needed.items():\n    if current_inventory.get(primitive_index, 0) < count:\n      missing_primitives.append((primitive_index, count - current_inventory.get(primitive_index, 0)))\n\n  # Collect missing primitives\n  for primitive_index, needed_count in missing_primitives:\n    primitive_name = next(name for name, index in env.world.cookbook.index.items() if index == primitive_index)\n    \n    primitive_indices = [(x, y) for x in range(env._current_state.grid.shape[0]) \n                         for y in range(env._current_state.grid.shape[1])\n                         if env._current_state.grid[x, y, primitive_index] > 0]\n\n    if not primitive_indices:\n      return []\n\n    closest_primitive = min(primitive_indices, key=lambda p: heuristic(start_pos[0] * env._current_state.grid.shape[1] + start_pos[1], \n                                                                       p[0] * env._current_state.grid.shape[1] + p[1]))\n\n    start_pos_flat = start_pos[0] * env._current_state.grid.shape[1] + start_pos[1]\n    target_pos_flat = closest_primitive[0] * env._current_state.grid.shape[1] + closest_primitive[1]\n\n    actions.extend(find_path(start_pos_flat, target_pos_flat))\n\n    # Ensure we are in front of the primitive\n    direction_to_face = get_direction(env._current_state.pos, closest_primitive)\n    if direction_to_face is not None:\n        actions.append(direction_to_face)\n\n    # Collect the primitive by using the USE action\n    actions.append(4)  # USE action\n\n    start_pos = closest_primitive  # Update the starting position for the next iteration\n\n  workshop_name = env.world.cookbook.recipes[item_index][\"_at\"]\n  workshop_indices = [(x, y) for x in range(env._current_state.grid.shape[0]) \n                      for y in range(env._current_state.grid.shape[1])\n                      if env._current_state.grid[x, y, env.world.workshop_indices[0]] == env.world.cookbook.index[workshop_name]]\n\n  if not workshop_indices:\n    return []\n\n  closest_workshop = min(workshop_indices, key=lambda p: heuristic(start_pos[0] * env._current_state.grid.shape[1] + start_pos[1], \n                                                                   p[0] * env._current_state.grid.shape[1] + p[1]))\n\n  start_pos_flat = start_pos[0] * env._current_state.grid.shape[1] + start_pos[1]\n  target_pos_flat = closest_workshop[0] * env._current_state.grid.shape[1] + closest_workshop[1]\n\n  actions.extend(find_path(start_pos_flat, target_pos_flat))\n\n  # Ensure we are in front of the workshop\n  direction_to_face = get_direction(env._current_state.pos, closest_workshop)\n  if direction_to_face is not None:\n      actions.append(direction_to_face)\n\n  # Craft the item by using the USE action\n  actions.append(4)  # USE action\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-11T16:32:18.033554", "function_name": "craft", "function_body": "  def move_to(pos):\n    current_pos = np.array(env._current_state.pos)\n    target_pos = np.array(pos)\n    actions = []\n\n    while not np.array_equal(current_pos, target_pos):\n        delta = target_pos - current_pos\n\n        # Determine the direction with the largest absolute difference and move there first\n        if abs(delta[0]) > abs(delta[1]):\n            actions.extend([craft.RIGHT] * delta[0] if delta[0] > 0 else [craft.LEFT] * (-delta[0]))\n        else:\n            actions.extend([craft.DOWN] * delta[1] if delta[1] > 0 else [craft.UP] * (-delta[1]))\n\n        current_pos = np.array(env._current_state.pos)\n    return actions\n\n  def use_workshop(workshop_index, workshop_pos):\n      # Orient the agent to face the workshop and use it\n      if env._current_state.grid[workshop_pos[0], workshop_pos[1], workshop_index] == 1:\n          return [craft.USE]\n      return []\n\n  goal_index = env.world.cookbook.index[item]\n\n  # Check if we have all required primitives in our inventory\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  current_inventory = collections.Counter(env._current_state.inventory)\n\n  for primitive, count in required_primitives.items():\n      if current_inventory[primitive] < count:\n          return []  # Missing required primitives\n\n  # Determine the workshop where crafting should occur\n  recipe_details = env.world.cookbook.recipes[goal_index]\n  workshop_name = recipe_details[\"_key\"]\n\n  # Get the index of the workshop from the world's cookbook\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the closest workshop in the grid\n  positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(positions) == 0:\n      return []  # No available workshops\n\n  closest_workshop_pos = min(\n      positions, key=lambda x: abs(x[0] - env._current_state.pos[0]) + abs(x[1] - env._current_state.pos[1]))\n\n  # Navigate to the closest workshop\n  actions_to_workshop = move_to(closest_workshop_pos)\n\n  # Use the workshop once there\n  actions_to_use = use_workshop(workshop_index, closest_workshop_pos)\n\n  return actions_to_workshop + actions_to_use", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T16:32:19.134898", "function_name": "craft", "function_body": "  goal_index = env.world.cookbook.index[item]\n\n  # Check if we have all required primitives in our inventory\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  current_inventory = collections.Counter(env._current_state.inventory)\n\n  for primitive, count in required_primitives.items():\n    if current_inventory[primitive] < count:\n      return []  # Missing required primitives\n\n  # Determine the workshop where crafting should occur\n  recipe_details = env.world.cookbook.recipes[goal_index]\n  workshop_name = recipe_details[\"_key\"]\n\n  # Get the index of the workshop from the world's cookbook\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the closest workshop in the grid\n  positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(positions) == 0:\n    return []  # No available workshops\n\n  closest_workshop_pos = min(\n      positions, key=lambda x: abs(x[0] - env._current_state.pos[0]) + abs(x[1] - env._current_state.pos[1]))\n\n  # Navigate to the closest workshop\n  current_pos = np.array(env._current_state.pos)\n  target_pos = np.array(closest_workshop_pos)\n\n  actions = []\n\n  while not np.array_equal(current_pos, target_pos):\n    delta = target_pos - current_pos\n\n    # Determine the direction with the largest absolute difference and move there first\n    if abs(delta[0]) > abs(delta[1]):\n      actions.extend([craft.RIGHT] * delta[0] if delta[0] > 0 else [craft.LEFT] * (-delta[0]))\n    else:\n      actions.extend([craft.DOWN] * delta[1] if delta[1] > 0 else [craft.UP] * (-delta[1]))\n\n    current_pos = np.array(env._current_state.pos)\n\n  # Orient the agent to face the workshop and use it\n  if env._current_state.grid[target_pos[0], target_pos[1], workshop_index] == 1:\n      actions.append(craft.USE)\n    \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T16:34:10.848350", "function_name": "craft", "function_body": "  def has_all_primitives(required_primitives, inventory_dict):\n    return all(primitive in inventory_dict and inventory_dict[primitive] >= required_primitives[primitive] for primitive in required_primitives)\n\n  def get_closest_workshop(grid, workshop_index):\n    workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n    if len(workshop_positions) == 0:\n      return None\n    # Calculate the Manhattan distance to each workshop and choose the closest one\n    agent_pos = env._current_state.pos\n    distances = [abs(agent_pos[0] - pos[0]) + abs(agent_pos[1] - pos[1]) for pos in workshop_positions]\n    closest_index = np.argmin(distances)\n    return tuple(workshop_positions[closest_index])\n\n  def navigate(state, target):\n    actions = []\n    current_x, current_y = state.pos\n    target_x, target_y = target\n\n    while current_x < target_x:\n        actions.append(3)  # RIGHT\n        current_x += 1\n    while current_x > target_x:\n        actions.append(2)  # LEFT\n        current_x -= 1\n    while current_y < target_y:\n        actions.append(0)  # DOWN\n        current_y += 1\n    while current_y > target_y:\n        actions.append(1)  # UP\n        current_y -= 1\n\n    return actions\n\n  def get_direction(current_pos, target_pos):\n    current_x, current_y = current_pos\n    target_x, target_y = target_pos\n\n    if current_x < target_x:\n      return 3  # RIGHT\n    elif current_x > target_x:\n      return 2  # LEFT\n    elif current_y < target_y:\n      return 0  # DOWN\n    else:\n      return 1  # UP\n\n  actions = []\n  \n  # Get the index of the goal item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  # If not all primitives are available return empty action list\n  if not has_all_primitives(required_primitives, inventory_dict):\n    return []\n  \n  # Find the workshop where we can craft this item\n  workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n      workshop_index = recipe.get(\"_at\")\n      break\n  \n  if workshop_index is None:\n    return []\n\n  # Get the closest workshop position\n  target_workshop_pos = get_closest_workshop(env._current_state.grid, workshop_index)\n  if target_workshop_pos is None:\n    return []\n  \n  # Navigate to the selected workshop\n  actions.extend(navigate(env._current_state, target_workshop_pos))\n  \n  # Turn towards the workshop if not already facing it\n  current_direction = env._current_state.dir\n  direction_to_workshop = get_direction(env._current_state.pos, target_workshop_pos)\n  if current_direction != direction_to_workshop:\n    actions.append(direction_to_workshop)\n\n  # Use the USE action to craft the item at the workshop\n  actions.append(4)  # Assuming 4 is the index for the USE action\n  \n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T16:34:11.981482", "function_name": "craft", "function_body": "  def has_all_primitives(required_primitives, inventory_dict):\n    return all(primitive in inventory_dict and inventory_dict[primitive] >= required_primitives[primitive] for primitive in required_primitives)\n\n  def get_closest_workshop(grid, workshop_index):\n    workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n    if len(workshop_positions) == 0:\n      return None\n    # Calculate the Manhattan distance to each workshop and choose the closest one\n    agent_pos = env._current_state.pos\n    distances = [abs(agent_pos[0] - pos[0]) + abs(agent_pos[1] - pos[1]) for pos in workshop_positions]\n    closest_index = np.argmin(distances)\n    return tuple(workshop_positions[closest_index])\n\n  def navigate(state, target):\n    actions = []\n    current_x, current_y = state.pos\n    target_x, target_y = target\n\n    # Move horizontally first if needed\n    while current_x < target_x:\n      actions.append(3)  # RIGHT\n      current_x += 1\n    while current_x > target_x:\n      actions.append(2)  # LEFT\n      current_x -= 1\n    \n    # Move vertically first if needed\n    while current_y < target_y:\n      actions.append(0)  # DOWN\n      current_y += 1\n    while current_y > target_y:\n      actions.append(1)  # UP\n      current_y -= 1\n\n    return actions\n\n  def get_direction(current_pos, target_pos):\n    current_x, current_y = current_pos\n    target_x, target_y = target_pos\n\n    if current_x < target_x:\n      return 3  # RIGHT\n    elif current_x > target_x:\n      return 2  # LEFT\n    elif current_y < target_y:\n      return 0  # DOWN\n    else:\n      return 1  # UP\n\n  actions = []\n  \n  # Get the index of the goal item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  # If not all primitives are available return empty action list\n  if not has_all_primitives(required_primitives, inventory_dict):\n    return []\n  \n  # Find the workshop where we can craft this item\n  workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n      workshop_index = recipe.get(\"_at\")\n      break\n  \n  if workshop_index is None:\n    return []\n\n  # Get the closest workshop position\n  target_workshop_pos = get_closest_workshop(env._current_state.grid, workshop_index)\n  if target_workshop_pos is None:\n    return []\n  \n  # Navigate to the selected workshop\n  actions.extend(navigate(env._current_state, target_workshop_pos))\n  \n  # Turn towards the workshop if not already facing it\n  current_direction = env._current_state.dir\n  direction_to_workshop = get_direction(env._current_state.pos, target_workshop_pos)\n  if current_direction != direction_to_workshop:\n    actions.append(direction_to_workshop)\n\n  # Use the USE action to craft the item at the workshop\n  actions.append(4)  # Assuming 4 is the index for the USE action\n  \n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T16:37:14.455053", "function_name": "craft", "function_body": "  def get_direction(current_pos, target_pos):\n    x_diff = target_pos[0] - current_pos[0]\n    y_diff = target_pos[1] - current_pos[1]\n\n    if abs(x_diff) > abs(y_diff):\n        return 3 if x_diff > 0 else 2  # RIGHT or LEFT\n    else:\n        return 1 if y_diff > 0 else 0  # UP or DOWN\n\n  def find_path(start, target):\n    actions = []\n\n    start_x, start_y = divmod(start, env._current_state.grid.shape[1])\n    target_x, target_y = divmod(target, env._current_state.grid.shape[1])\n\n    open_set = []\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, target)}\n\n    heapq.heappush(open_set, (f_score[start], start))\n\n    while open_set:\n      _, current = heapq.heappop(open_set)\n\n      if current == target:\n        reconstruct_path(came_from, current)\n        break\n\n      cx, cy = divmod(current, env._current_state.grid.shape[1])\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = cx + dx, cy + dy\n\n        if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n          neighbor = nx * env._current_state.grid.shape[1] + ny\n          tentative_g_score = g_score[current] + 1\n\n          if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n            came_from[neighbor] = current\n            g_score[neighbor] = tentative_g_score\n            f_score[neighbor] = tentative_g_score + heuristic(neighbor, target)\n            heapq.heappush(open_set, (f_score[neighbor], neighbor))\n\n    def reconstruct_path(came_from, current):\n      total_path = []\n      while current in came_from:\n        cx, cy = divmod(current, env._current_state.grid.shape[1])\n        px, py = divmod(came_from[current], env._current_state.grid.shape[1])\n\n        dx, dy = px - cx, py - cy\n        direction_to_face = get_direction((cx, cy), (px, py))\n        total_path.append(direction_to_face)\n        current = came_from[current]\n\n      actions.extend(reversed(total_path))\n\n    return actions\n\n  def heuristic(a, b):\n    ax, ay = divmod(a, env._current_state.grid.shape[1])\n    bx, by = divmod(b, env._current_state.grid.shape[1])\n\n    # Manhattan distance\n    return abs(ax - bx) + abs(ay - by)\n\n  actions = []\n\n  item_index = env.world.cookbook.index[item]\n\n  if not item_index:\n    return []\n\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  current_inventory = {env.world.cookbook.index.get(i): c for i, c in enumerate(env._current_state.inventory) if c > 0}\n\n  # Check if we have all the required primitives\n  missing_primitives = []\n  for primitive_index, count in primitives_needed.items():\n    if current_inventory.get(primitive_index, 0) < count:\n      missing_primitives.append((primitive_index, count - current_inventory.get(primitive_index, 0)))\n\n  if missing_primitives:\n    return []\n\n  workshop_name = env.world.cookbook.recipes[item_index][\"_at\"]\n  workshop_indices = np.argwhere(env._current_state.grid[:, :, env.world.workshop_indices[0]] == env.world.cookbook.index[workshop_name])\n\n  if not workshop_indices.any():\n    return []\n\n  start_pos_flat = env._current_state.pos[0] * env._current_state.grid.shape[1] + env._current_state.pos[1]\n  target_workshop_position = (workshop_indices[0][0], workshop_indices[0][1])\n  target_pos_flat = target_workshop_position[0] * env._current_state.grid.shape[1] + target_workshop_position[1]\n\n  actions.extend(find_path(start_pos_flat, target_pos_flat))\n\n  direction_to_face = get_direction(env._current_state.pos, target_workshop_position)\n  if direction_to_face is not None:\n      actions.append(direction_to_face)\n\n  # Craft the item by using the USE action\n  actions.append(4)  # USE action\n\n  return actions", "island_id": 5, "scores": {"3": 0.0}}
