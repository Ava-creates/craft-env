rkshop_dir:\n    actions.append(turn_towards(workshop_dir))\n  \n  # Add USE action to craft the item at the workshop\n  actions.append(craft.ACTIONS.USE)\n\n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T12:02:00.163183", "function_name": "craft", "function_body": "  i_goal = env.world.cookbook.index[item]\n\n  if i_goal not in env.world.cookbook.recipes:\n    raise ValueError(f\"No recipe found for {item}.\")\n\n  actions = []\n  \n  # Check if we have all required primitives and intermediate items\n  required_primitives = env.world.cookbook.primitives_for(i_goal)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory)}\n\n  missing_items = []\n  for primitive, count_needed in required_primitives.items():\n    if inventory_dict.get(primitive, 0) < count_needed:\n      missing_items.append((primitive, count_needed - inventory_dict.get(primitive, 0)))\n\n  if missing_items:\n    return []  # Return empty list if any required item is missing\n\n  # Find the closest workshop\n  workshop_key = env.world.cookbook.recipes[i_goal][\"_key\"]\n  workshop_index = env.world.cookbook.index[workshop_key]\n  \n  grid_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if not grid_positions.size:\n    return []  # No workshops found\n\n  closest_workshop_pos = min(grid_positions, key=lambda x: np.linalg.norm(np.array(x) - np.array(env._current_state.pos)))\n\n  # Move to the closest workshop\n  move_actions = move_to_position_v2(env, env._current_state.pos, closest_workshop_pos)\n  actions.extend(move_actions)\n\n  # Orient towards the workshop and use it\n  face_direction = face_towards_position_v2(env, env._current_state.pos, closest_workshop_pos)\n  if face_direction:\n    actions.append(face_direction)\n\n  actions.append(4)  # USE action\n\n  return actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T12:02:01.264694", "function_name": "craft", "function_body": "  return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T12:02:40.274876", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the primitives required to craft the item\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  for primitive, count in primitives_needed.items():\n      if env._current_state.inventory[primitive] < count:\n          return []  # Not enough primitives, cannot craft\n\n  # Check which workshop is needed for crafting\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n      return []  # No workshop found, cannot craft\n\n  # Choose the closest workshop\n  agent_pos = np.array(env._current_state.pos)\n  distances = np.linalg.norm(agent_pos - workshop_positions, axis=1)\n  closest_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n\n  # Calculate actions to move to the workshop\n  actions.extend(move_to_position(env, closest_workshop_pos))\n\n  # Turn towards the workshop and use the USE action to craft\n  direction = calculate_direction(env._current_state.pos, closest_workshop_pos)\n  actions.append(direction)\n  actions.append(4)  # USE action\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-10T12:02:41.232412", "function_name": "craft", "function_body": "  actions = []\n  cookbook = env.world.cookbook\n  index = cookbook.index\n\n  # Get the index of the desired item\n  item_index = index[item]\n\n  # Get the recipe for the item\n  if item_index not in cookbook.recipes:\n    return []  # No recipe found for this item\n\n  recipe = cookbook.recipes[item_index]\n  required_primitives = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  # Check if all required primitives are available in the inventory\n  for primitive, count in required_primitives.items():\n    if env._current_state.inventory[primitive] < count:\n      return []  # Required primitive not available\n\n  # Get the workshop index where the item should be crafted\n  workshop_name = recipe[\"_at\"]\n  workshop_index = index[workshop_name]\n\n  # Find a position next to the workshop on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(workshop_positions) == 0:\n    return []  # Workshop not found on the grid\n\n  target_workshop_pos = tuple(workshop_positions[0])\n\n  # Move to a position next to the workshop\n  actions.extend(move_to_position(env, target_workshop_pos))\n\n  # Rotate to face the workshop and use the USE action to craft the item\n  actions.append(face_direction_towards(env, target_workshop_pos))\n  actions.append(4)  # Use action\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-10T12:04:37.189782", "function_name": "craft", "function_body": "  actions = []\n  \n  # Step 1: Determine the recipe for the item.\n  goal_index = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  # Step 2: Check if we have all required primitives in inventory or nearby\n  required_primitives = {env.world.cookbook.index[k]: v for k, v in recipe.items() if k != \"_at\"}\n  \n  # Check current inventory and nearby cells for each required primitive\n  for prim_index, count in required_primitives.items():\n    # Check if we have enough primitives in the inventory\n    if env._current_state.inventory[prim_index] >= count:\n      continue\n    \n    # Otherwise, find primitives around nearby cells\n    found = False\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    for dx, dy in directions:\n        nx, ny = env._current_state.pos[0] + dx, env._current_state.pos[1] + dy\n        if 0 <= nx < env.world.cookbook.n_kinds and 0 <= ny < env.world.cookbook.n_kinds:\n            if env._current_state.grid[nx, ny, prim_index] > 0:\n                # Move to the nearby cell with the primitive\n                actions.append(craft.COLLECT_FUNC(prim_index))\n                found = True\n                break\n    \n    if not found:\n        return []  # If a required primitive is not found, we cannot craft the item\n\n  # Step 3: Go to the workshop specified in the recipe and use it.\n  workshop_name = recipe[\"_at\"]\n  workshop_indices = [i for i, name in enumerate(env.world.cookbook.index) if \"workshop\" in name and workshop_name in name]\n  \n  if not workshop_indices:\n      return []  # If no valid workshop is found, we cannot craft the item\n\n  # Find the nearest workshop\n  nearest_workshop = min(workshop_indices, key=lambda idx: np.linalg.norm(np.array(env._current_state.pos) - np.argwhere(env._current_state.grid[:, :, idx])[0]))\n  \n  # Move to the nearest workshop\n  target_pos = np.argwhere(env._current_state.grid[:, :, nearest_workshop])[0]\n  dx, dy = target_pos[0] - env._current_state.pos[0], target_pos[1] - env._current_state.pos[1]\n  \n  while dx != 0 or dy != 0:\n      if dx > 0:\n          actions.append(craft.MOVE_FUNC(\"DOWN\"))\n          dx -= 1\n      elif dx < 0:\n          actions.append(craft.MOVE_FUNC(\"UP\"))\n          dx += 1\n      \n      if dy > 0:\n          actions.append(craft.MOVE_FUNC(\"RIGHT\"))\n          dy -= 1\n      elif dy < 0:\n          actions.append(craft.MOVE_FUNC(\"LEFT\"))\n          dy += 1\n\n  # Step 4: Use the workshop to craft the item.\n  actions.append(craft.USE_FUNC())\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-10T12:04:38.161015", "function_name": "craft", "function_body": "  # Convert item name to its index\n  item_index = env.world.cookbook.index[item]\n\n  # If the goal is a primitive or environment object, no crafting can be done.\n  if item_index in env.world.non_grabbable_indices:\n    return []\n\n  # Get the recipe for the item we want to craft\n  recipe = env._current_state.world.cookbook.recipes.get(item_index)\n\n  if not recipe:\n    print(f\"No recipe found for {item}\")\n    return []\n\n  required_items = {}\n  workshop_index = None\n\n  # Separate the items from the workshop location in the recipe\n  for ingredient, count in recipe.items():\n      if ingredient == \"_key\":\n          workshop_index = env.world.cookbook.index[recipe[\"_key\"]]\n      else:\n          required_items[ingredient] = count\n\n  # Check if we have all the required primitives and items already in our inventory\n  def has_all_required_items(inventory, required_items):\n    for kind, count in required_items.items():\n        if inventory[kind] < count:\n            return False\n    return True\n\n  # If not all items are available, return an empty list\n  current_inventory = env._current_state.inventory\n  if not has_all_required_items(current_inventory, required_items):\n      print(f\"Missing items: {required_items}\")\n      return []\n\n  # Find the position of the workshop\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n  \n  if len(workshop_positions) == 0:\n    print(\"No workshop found.\")\n    return []\n    \n  target_workshop_pos = tuple(workshop_positions[0])\n\n  # Plan the path to the nearest workshop (assuming a simple BFS for now)\n\n  def bfs(grid, start, target):\n      queue = collections.deque([start])\n      visited = set()\n      parent = {start: None}\n      \n      while queue:\n          pos = queue.popleft()\n          \n          if pos == target:\n              break\n          \n          if pos in visited:\n              continue\n          \n          visited.add(pos)\n          \n          for direction in [(0, 1), (0, -1), (1, 0), (-1, 0)]:\n              new_pos = tuple(p + d for p, d in zip(pos, direction))\n              \n              if not (0 <= new_pos[0] < grid.shape[0] and 0 <= new_pos[1] < grid.shape[1]):\n                  continue\n                  \n              if grid[new_pos][workshop_index] == 1 or grid[new_pos].sum() == 0:\n                  queue.append(new_pos)\n                  parent[new_pos] = pos\n      \n      path = []\n      while target is not None:\n          path.append(target)\n          target = parent[target]\n      \n      return path[::-1]\n\n  start_pos = env._current_state.pos\n  path_to_workshop = bfs(grid, start_pos, target_workshop_pos)\n\n  if not path_to_workshop:\n    print(\"No path to the workshop found.\")\n    return []\n\n  actions = []\n  current_dir = env._current_state.dir\n\n  # Move towards the nearest workshop\n  for i in range(1, len(path_to_workshop)):\n      current_pos = path_to_workshop[i - 1]\n      target_pos = path_to_workshop[i]\n\n      if target_pos[0] > current_pos[0]:\n          actions.append(env.world.cookbook.index[\"DOWN\"])\n      elif target_pos[0] < current_pos[0]:\n          actions.append(env.world.cookbook.index[\"UP\"])\n      elif target_pos[1] > current_pos[1]:\n          actions.append(env.world.cookbook.index[\"RIGHT\"])\n      elif target_pos[1] < current_pos[1]:\n          actions.append(env.world.cookbook.index[\"LEFT\"])\n\n  # Assume the agent has reached the workshop. Now, it needs to face the workshop and perform USE action.\n  # For simplicity, let's assume the agent can always face the correct direction.\n\n  actions.append(env.world.cookbook.index[\"USE\"])\n  \n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-10T12:05:37.417434", "function_name": "craft", "function_body": "  # Step 1: Obtain the goal index from the item name\n  item_index = env.world.cookbook.index.get(item)\n  if item_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  # Step 2: Check if the current inventory satisfies the recipe requirements for the item\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n\n  # Collecting primitives if they are not already in the inventory\n  actions = []\n  for primitive, count in required_primitives.items():\n    while np.sum(env._current_state.inventory[primitive]) < count:\n      actions.extend(collect_v2(env, env.world.cookbook.index.get(env.world.cookbook.index.get(primitive))))\n\n  # Step 3: Move to the correct workshop and perform the USE action\n  # Find the required workshop from the recipe\n  workshop_index = None\n  for ingredient_key, value in env.world.cookbook.recipes[item_index].items():\n      if ingredient_key.startswith('_at'):\n          workshop_name = value\n          workshop_index = env.world.workshop_indices[workshop_name]\n          break\n\n  # Move to the nearest workshop and face it\n  nearest_workshop_pos = find_nearest(env, workshop_index)\n  actions.extend(move_to_and_face(env, nearest_workshop_pos))\n\n  # Step 4: Craft the item by performing the USE action\n  actions.append(craft.USE)\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-10T12:05:38.412352", "function_name": "craft", "function_body": "  actions = []\n  world = env.world\n  cookbook = world.cookbook\n  index = cookbook.index\n\n  # Get the index for the target item\n  goal_index = index[item]\n\n  # Check if we have all the required ingredients in our inventory\n  required_ingredients = cookbook.primitives_for(goal_index)\n  current_inventory = env._current_state.inventory\n\n  # Collect missing primitives\n  for primitive, count in required_ingredients.items():\n    while current_inventory[primitive] < count:\n      actions.extend(collect(env, index.get(primitive)))\n\n  # Determine the workshop where we need to craft the item\n  workshop_index = None\n  for recipe in cookbook.recipes.values():\n    if goal_index in recipe and \"_at\" in recipe:\n      workshop_index = cookbook.index[recipe[\"_at\"]]\n      break\n\n  if workshop_index is None:\n    return []  # No valid workshop found\n\n  # Move to the nearest available workshop\n  actions.extend(move_to_workshop(env, workshop_index))\n\n  # Craft the item by using the USE action\n  actions.append(craft.USE)\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-10T12:07:13.124884", "function_name": "craft", "function_body": "  actions = []\n\n  # Convert the item name to its corresponding index\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the recipe for the desired item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n    print(f\"No recipe found for {item}\")\n    return actions\n\n  # Check if all primitives are available in the inventory\n  required_primitives = {env.world.cookbook.index[k]: v for k, v in recipe.items() if k != \"_key\" and env.world.cookbook.primitives_for(k)}\n\n  if not required_primitives:\n    print(f\"No primitives found for {item}\")\n    return actions\n\n  # Collect the primitives if they are not available in the inventory\n  for primitive_index, count in required_primitives.items():\n    while env._current_state.inventory[primitive_index] < count:\n      primitive_name = env.world.cookbook.index.get(primitive_index)\n      collect_actions = collect_v2(env, primitive_name)\n      actions.extend(collect_actions)\n\n  # Go to the workshop specified in the recipe and perform the USE action\n  workshop_key = recipe[\"_key\"]\n  workshop_index = env.world.workshop_indices[workshop_key]\n\n  # Find the path to the nearest workshop of the required type\n  move_to_workshop_actions = move_to_v2(env, workshop_index)\n  actions.extend(move_to_workshop_actions)\n\n  # Use action to craft the item at the workshop\n  actions.append(craft.ACTION_USE)\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-10T12:07:14.119931", "function_name": "craft", "function_body": "  # Get the current state\n  current_state = env._current_state\n  \n  # Retrieve the recipe for the desired item\n  cookbook = env.world.cookbook\n  item_index = cookbook.index(item)\n  \n  if item_index not in cookbook.recipes:\n    print(f\"No recipe found for {item}.\")\n    return []\n  \n  recipe = cookbook.recipes[item_index]\n  \n  # Check if all ingredients are available in the inventory or nearby\n  actions_to_take = []\n\n  # Collect missing ingredients if needed\n  for ingredient, count in recipe.items():\n    if ingredient == \"_at\":\n      continue  # Skip the workshop specification\n    \n    ingredient_index = cookbook.index(ingredient)\n    \n    # If ingredient is already in inventory, skip collecting it\n    if current_state.inventory[ingredient_index] >= count:\n      continue\n\n    # Find positions of the ingredient on the grid\n    ingredient_positions = np.argwhere(current_state.grid[:, :, ingredient_index]).tolist()\n    \n    for pos in ingredient_positions:\n      x, y = pos\n      \n      # Calculate relative direction to move towards the ingredient\n      dx = x - current_state.pos[0]\n      dy = y - current_state.pos[1]\n      \n      # Adjust direction based on agent's orientation\n      if dx > 0 and current_state.dir == 3:\n        actions_to_take.append(env.world.cookbook.index(\"RIGHT\"))\n      elif dx < 0 and current_state.dir == 2:\n        actions_to_take.append(env.world.cookbook.index(\"LEFT\"))\n      elif dy > 0 and current_state.dir == 1:\n        actions_to_take.append(env.world.cookbook.index(\"UP\"))\n      elif dy < 0 and current_state.dir == 0:\n        actions_to_take.append(env.world.cookbook.index(\"DOWN\"))\n\n      # Move to the ingredient position\n      while current_state.pos != (x, y):\n        reward, done, observations = env.step(actions_to_take[-1])\n        if done:\n          return []\n        current_state = env._current_state\n      \n      # Collect the ingredient\n      actions_to_take.append(env.world.cookbook.index(\"USE\"))\n      \n      # Check if enough ingredients are collected\n      if current_state.inventory[ingredient_index] >= count:\n        break\n  \n  # Find the workshop specified in the recipe\n  workshop_name = recipe[\"_at\"]\n  workshop_index = cookbook.index(workshop_name)\n  \n  # Find positions of the workshop on the grid\n  workshop_positions = np.argwhere(current_state.grid[:, :, workshop_index]).tolist()\n  \n  if not workshop_positions:\n    print(f\"Workshop {workshop_name} for item {item} not found.\")\n    return []\n  \n  for pos in workshop_positions:\n    x, y = pos\n    \n    # Calculate relative direction to move towards the workshop\n    dx = x - current_state.pos[0]\n    dy = y - current_state.pos[1]\n    \n    # Adjust direction based on agent's orientation\n    if dx > 0 and current_state.dir == 3:\n      actions_to_take.append(env.world.cookbook.index(\"RIGHT\"))\n    elif dx < 0 and current_state.dir == 2:\n      actions_to_take.append(env.world.cookbook.index(\"LEFT\"))\n    elif dy > 0 and current_state.dir == 1:\n      actions_to_take.append(env.world.cookbook.index(\"UP\"))\n    elif dy < 0 and current_state.dir == 0:\n      actions_to_take.append(env.world.cookbook.index(\"DOWN\"))\n\n    # Move to the workshop position\n    while current_state.pos != (x, y):\n      reward, done, observations = env.step(actions_to_take[-1])\n      if done:\n        return []\n      current_state = env._current_state\n    \n    # Check if facing the correct direction to use the workshop\n    if not current_state.next_to(workshop_index):\n      print(f\"Workshop {workshop_name} is not next to the agent.\")\n      continue\n    \n    # Craft the item at the workshop\n    actions_to_take.append(env.world.cookbook.index(\"USE\"))\n    \n    return actions_to_take\n  \n  return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-10T12:10:33.853111", "function_name": "craft", "function_body": "  def move_to_position(pos):\n    current_pos = env._current_state.pos\n    actions = []\n    while current_pos != pos:\n      delta_x = pos[0] - current_pos[0]\n      delta_y = pos[1] - current_pos[1]\n\n      if delta_x < 0:\n          actions.append(2)  # LEFT\n      elif delta_x > 0:\n          actions.append(3)  # RIGHT\n\n      if delta_y < 0:\n          actions.append(0)  # DOWN\n      elif delta_y > 0:\n          actions.append(1)  # UP\n      \n      # Execute the action to move one step closer\n      reward, done, observations = env.step(actions[-1])\n      current_pos = tuple(map(int, (observations['features_dict']['pos'] * np.array([env.world.WIDTH, env.world.HEIGHT])).tolist()))\n\n    return actions\n\n\n  def face_workshop(workshop_pos):\n    current_pos = env._current_state.pos\n    delta_x = workshop_pos[0] - current_pos[0]\n    delta_y = workshop_pos[1] - current_pos[1]\n\n    direction_actions = []\n    if delta_y < 0:\n        direction_actions.append(0)  # DOWN\n    elif delta_y > 0:\n        direction_actions.append(1)  # UP\n\n    if delta_x < 0:\n        direction_actions.append(2)  # LEFT\n    elif delta_x > 0:\n        direction_actions.append(3)  # RIGHT\n    \n    return direction_actions[-1]  # Only the last action is needed to face the workshop\n\n\n  actions = []\n\n  # Convert item name to its index in the cookbook\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the required primitives for crafting the item\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n\n  # Check if we have all the required primitives in our inventory\n  missing_primitives = []\n  for primitive, required_count in required_primitives.items():\n    if inventory_dict.get(primitive, 0) < required_count:\n      missing_primitives.append((primitive, required_count))\n\n  # If there are any missing primitives, return an empty list of actions\n  if missing_primitives:\n    return []\n\n  # Determine the workshop where crafting should occur\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_required_key = [k for k, v in recipe.items() if \"_at\" in k][0]\n  workshop_required_name = recipe[workshop_required_key]\n\n  # Find the nearest workshop of the required type\n  closest_workshop_pos = None\n  min_distance = float('inf')\n\n  for pos in env.world.workshop_indices:\n    if env.world.cookbook.index.get(pos[2]) == workshop_required_name:  # Check if it's the correct workshop type\n      distance = abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n      if distance < min_distance:\n        closest_workshop_pos = (pos[0], pos[1])\n        min_distance = distance\n\n  # Add actions to move to the nearest workshop\n  actions.extend(move_to_position(closest_workshop_pos))\n\n  # Face the workshop before using it\n  face_direction_action = face_workshop(closest_workshop_pos)\n  actions.append(face_direction_action)\n\n  # Add USE action to craft the item\n  actions.append(4)  # Assuming USE action is 4\n\n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T12:10:34.942801", "function_name": "craft", "function_body": "  def move_to_position(pos):\n    current_pos = env._current_state.pos\n    actions = []\n    while current_pos != pos:\n      delta_x = pos[0] - current_pos[0]\n      delta_y = pos[1] - current_pos[1]\n\n      if delta_x < 0:\n          actions.append(2)  # LEFT\n      elif delta_x > 0:\n          actions.append(3)  # RIGHT\n\n      if delta_y < 0:\n          actions.append(0)  # DOWN\n      elif delta_y > 0:\n          actions.append(1)  # UP\n      \n      # Execute the action to move one step closer\n      reward, done, observations = env.step(actions[-1])\n      current_pos = (observations['features_dict']['pos'] * env.world.WIDTH).astype(int), (observations['features_dict']['pos'] * env.world.HEIGHT).astype(int)\n\n    return actions\n\n  def face_workshop(workshop_pos):\n    current_direction = env._current_state.features_dict['dir']\n    delta_x = workshop_pos[0] - env._current_state.pos[0]\n    delta_y = workshop_pos[1] - env._current_state.pos[1]\n\n    direction_actions = []\n    if delta_y < 0:\n        direction_actions.append(0)  # DOWN\n    elif delta_y > 0:\n        direction_actions.append(1)  # UP\n\n    if delta_x < 0:\n        direction_actions.append(2)  # LEFT\n    elif delta_x > 0:\n        direction_actions.append(3)  # RIGHT\n    \n    return direction_actions[-1]  # Only the last action is needed to face the workshop\n\n  actions = []\n\n  # Convert item name to its index in the cookbook\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the required primitives for crafting the item\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n\n  # Check if we have all the required primitives in our inventory\n  missing_primitives = []\n  for primitive, required_count in required_primitives.items():\n    if inventory_dict.get(primitive, 0) < required_count:\n      missing_primitives.append((primitive, required_count))\n\n  # If there are any missing primitives, return an empty list of actions\n  if missing_primitives:\n    return []\n\n  # Determine the workshop where crafting should occur\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_required_key = [k for k, v in recipe.items() if \"_at\" in k][0]\n  workshop_required_name = recipe[workshop_required_key]\n\n  # Find the nearest workshop of the required type\n  closest_workshop_pos = None\n  min_distance = float('inf')\n\n  for pos in env.world.workshop_indices:\n    workshop_index = pos[2]  # The workshop index is stored at the third position in the tuple\n    if env.world.cookbook.index.get(workshop_index) == workshop_required_name:  # Check if it's the correct workshop type\n      distance = abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n      if distance < min_distance:\n        closest_workshop_pos = (pos[0], pos[1])\n        min_distance = distance\n\n  # Add actions to move to the nearest workshop\n  actions.extend(move_to_position(closest_workshop_pos))\n\n  # Face the workshop before using it\n  face_direction_action = face_workshop(closest_workshop_pos)\n  if face_direction_action != env._current_state.features_dict['dir']:\n      actions.append(face_direction_action)\n\n  # Add USE action to craft the item\n  actions.append(4)  # Assuming USE action is 4\n\n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T12:13:22.463233", "function_name": "craft", "function_body": "  def move_to_position(pos):\n    current_pos = env._current_state.pos\n    actions = []\n    while current_pos != pos:\n      delta_x = pos[0] - current_pos[0]\n      delta_y = pos[1] - current_pos[1]\n\n      if delta_x < 0:\n          actions.append(2)  # LEFT\n      elif delta_x > 0:\n          actions.append(3)  # RIGHT\n\n      if delta_y < 0:\n          actions.append(0)  # DOWN\n      elif delta_y > 0:\n          actions.append(1)  # UP\n      \n      # Execute the action to move one step closer\n      reward, done, observations = env.step(actions[-1])\n      current_pos = tuple(map(int, (observations['features_dict']['pos'] * [env.world.WIDTH, env.world.HEIGHT])))\n\n    return actions\n\n  def face_workshop(workshop_pos):\n      current_direction = env._current_state.direction\n      delta_x = workshop_pos[0] - env._current_state.pos[0]\n      delta_y = workshop_pos[1] - env._current_state.pos[1]\n\n      if delta_x < 0 and current_direction != 2:  # LEFT\n          return [2]\n      elif delta_x > 0 and current_direction != 3:  # RIGHT\n          return [3]\n      elif delta_y < 0 and current_direction != 0:  # DOWN\n          return [0]\n      elif delta_y > 0 and current_direction != 1:  # UP\n          return [1]\n\n      return []  # Already facing the workshop\n\n  actions = []\n\n  # Convert item name to its index in the cookbook\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the required primitives for crafting the item\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n\n  # Check if we have all the required primitives in our inventory\n  missing_primitives = []\n  for primitive, required_count in required_primitives.items():\n    if inventory_dict.get(primitive, 0) < required_count:\n      missing_primitives.append((primitive, required_count))\n\n  # If there are any missing primitives, return an empty list of actions\n  if missing_primitives:\n    return []\n\n  # Determine the workshop where crafting should occur\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_required_key = [k for k in recipe.keys() if \"_at\" in k][0]\n  workshop_required_name = recipe[workshop_required_key]\n\n  # Find the nearest workshop of the required type\n  closest_workshop_pos = None\n  min_distance = float('inf')\n\n  for pos_tuple in env.world.workshop_indices:\n      pos, i_kind = pos_tuple[:2], pos_tuple[2]\n      if env.world.cookbook.index.get(i_kind) == workshop_required_name:  # Check if it's the correct workshop type\n          distance = abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n          if distance < min_distance:\n              closest_workshop_pos = pos\n              min_distance = distance\n\n  # Add actions to move to the nearest workshop\n  actions.extend(move_to_position(closest_workshop_pos))\n\n  # Face the workshop before using it\n  face_direction_actions = face_workshop(closest_workshop_pos)\n  actions.extend(face_direction_actions)\n\n  # Add USE action to craft the item\n  actions.append(4)  # Assuming USE action is 4\n\n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T12:13:23.606027", "function_name": "craft", "function_body": "  def move_to_position(pos):\n    current_pos = env._current_state.pos\n    actions = []\n    while current_pos != pos:\n      delta_x = pos[0] - current_pos[0]\n      delta_y = pos[1] - current_pos[1]\n\n      if delta_x < 0:\n          actions.append(2)  # LEFT\n      elif delta_x > 0:\n          actions.append(3)  # RIGHT\n\n      if delta_y < 0:\n          actions.append(0)  # DOWN\n      elif delta_y > 0:\n          actions.append(1)  # UP\n      \n      # Execute the action to move one step closer\n      reward, done, observations = env.step(actions[-1])\n      current_pos = (observations['features_dict']['pos'] * env.world.WIDTH).astype(int), (observations['features_dict']['pos'] * env.world.HEIGHT).astype(int)\n\n    return actions\n\n  def face_workshop(workshop_pos):\n      current_direction = env._current_state.direction\n      delta_x = workshop_pos[0] - env._current_state.pos[0]\n      delta_y = workshop_pos[1] - env._current_state.pos[1]\n\n      # Determine the direction to turn\n      if delta_x < 0:\n          target_direction = 2  # LEFT\n      elif delta_x > 0:\n          target_direction = 3  # RIGHT\n      elif delta_y < 0:\n          target_direction = 0  # DOWN\n      else:\n          target_direction = 1  # UP\n\n      # Calculate the number of turns needed to face the workshop\n      num_turns = (target_direction - current_direction) % 4\n      if num_turns == 3:  # Turn left instead of turning right twice\n          return [2]\n      elif num_turns == 1:\n          return [3]\n      elif num_turns == 2:\n          return [3, 3]\n\n      return []  # Already facing the workshop\n\n  actions = []\n\n  # Convert item name to its index in the cookbook\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the required primitives for crafting the item\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n\n  # Check if we have all the required primitives in our inventory\n  missing_primitives = []\n  for primitive, required_count in required_primitives.items():\n    if inventory_dict.get(primitive, 0) < required_count:\n      missing_primitives.append((primitive, required_count))\n\n  # If there are any missing primitives, return an empty list of actions\n  if missing_primitives:\n    return []\n\n  # Determine the workshop where crafting should occur\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_required_key = [k for k, v in recipe.items() if \"_at\" in k][0]\n  workshop_required_name = recipe[workshop_required_key]\n\n  # Find the nearest workshop of the required type\n  closest_workshop_pos = None\n  min_distance = float('inf')\n\n  for pos in env.world.workshop_indices:\n    if env.world.cookbook.index.get(pos[2]) == workshop_required_name:  # Check if it's the correct workshop type\n      distance = abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n      if distance < min_distance:\n        closest_workshop_pos = (pos[0], pos[1])\n        min_distance = distance\n\n  # Add actions to move to the nearest workshop\n  actions.extend(move_to_position(closest_workshop_pos))\n\n  # Face the workshop before using it\n  face_direction_actions = face_workshop(closest_workshop_pos)\n  actions.extend(face_direction_actions)\n\n  # Add USE action to craft the item\n  actions.append(4)  # Assuming USE action is 4\n\n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T12:14:45.387908", "function_name": "craft", "function_body": "  def navigate_to(target_position):\n      \"\"\"Helper function to navigate to the target position.\"\"\"\n      actions = []\n      current_pos = env._current_state.pos\n      while current_pos != target_position:\n          # Determine the direction to move\n          direction = None\n          if target_position[0] > current_pos[0]:\n              direction = craft.ACTION_RIGHT\n          elif target_position[0] < current_pos[0]:\n              direction = craft.ACTION_LEFT\n          elif target_position[1] > current_pos[1]:\n              direction = craft.ACTION_DOWN\n          elif target_position[1] < current_pos[1]:\n              direction = craft.ACTION_UP\n\n          if direction is not None:\n              actions.append(direction)\n              # Execute the action to move\n              _, done, _ = env.step(direction)\n              if done:\n                  return []  # Episode ended prematurely\n              current_pos = env._current_state.pos\n      return actions\n\n  def determine_facing_direction(current_position, target_position):\n      \"\"\"Helper function to determine the direction needed to face the target position.\"\"\"\n      x_diff = target_position[0] - current_position[0]\n      y_diff = target_position[1] - current_position[1]\n\n      if x_diff > 0:\n          return craft.ACTION_RIGHT\n      elif x_diff < 0:\n          return craft.ACTION_LEFT\n      elif y_diff > 0:\n          return craft.ACTION_DOWN\n      elif y_diff < 0:\n          return craft.ACTION_UP\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  current_inventory = {env.world.cookbook.index.get(i): env._current_state.inventory[i] for i in range(len(env._current_state.inventory))}\n\n  actions = []\n\n  # Check if we have all the primitives required\n  for primitive, count in required_primitives.items():\n    if current_inventory.get(primitive, 0) < count:\n      return []  # Return empty list as we do not have enough primitives\n\n  # Determine which workshop to use and navigate there\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_required = None\n  for key in recipe.keys():\n    if \"_at\" in key:\n      workshop_required = key.split(\"_at\")[1].strip()\n      break\n\n  if not workshop_required:\n    return []  # No valid workshop found in the recipe\n\n  # Find the position of the required workshop in the grid\n  workshop_index = env.world.cookbook.index[workshop_required]\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n  if not workshop_positions.size:\n    return []  # No valid workshop found on the grid\n\n  target_workshop_position = tuple(workshop_positions[0])\n\n  # Navigate to the workshop\n  actions.extend(navigate_to(target_workshop_position))\n\n  # Turn to face the workshop (assuming we can determine the direction needed)\n  facing_direction = determine_facing_direction(env._current_state.pos, target_workshop_position)\n  if facing_direction is not None:\n      actions.append(facing_direction)\n\n  # Perform USE action to craft the item\n  actions.append(craft.ACTION_USE)\n\n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T12:14:46.426174", "function_name": "craft", "function_body": "  def navigate_and_face(target_position):\n      \"\"\"Helper function to navigate and face the target position.\"\"\"\n      actions = []\n      \n      # Navigate to the workshop\n      while env._current_state.pos != target_position:\n          actions.extend(navigate_to(env, target_position))\n          \n      # Turn to face the workshop (assuming we can determine the direction needed)\n      facing_direction = determine_facing_direction(env._current_state.pos, target_position)\n      if facing_direction is not None:\n          actions.append(facing_direction)\n      return actions\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  current_inventory = {env.world.cookbook.index.get(i): env._current_state.inventory[i] for i in range(len(env._current_state.inventory))}\n  \n  actions = []\n  \n  # Check if we have all the primitives required\n  for primitive, count in required_primitives.items():\n      if current_inventory.get(primitive, 0) < count:\n          return []  # Return empty list as we do not have enough primitives\n  \n  # Determine which workshop to use and navigate there\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_required = None\n  for key in recipe.keys():\n      if \"_at\" in key:\n          workshop_required = key.split(\"_at\")[1].strip()\n          break\n  \n  if not workshop_required:\n      return []  # No valid workshop found in the recipe\n  \n  # Find the position of the required workshop in the grid\n  workshop_index = env.world.cookbook.index[workshop_required]\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  \n  if not workshop_positions.size:\n      return []  # No valid workshop found on the grid\n  \n  target_workshop_position = tuple(workshop_positions[0])\n  \n  # Navigate and face the workshop\n  actions.extend(navigate_and_face(target_workshop_position))\n  \n  # Perform USE action to craft the item\n  actions.append(craft.ACTION_USE)\n  \n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T12:15:48.480225", "function_name": "craft", "function_body": "  # Convert item name to index\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the recipe for the item\n  if item_index not in env.world.cookbook.recipes:\n    print(f\"No recipe found for {item}\")\n    return []\n\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Check if all ingredients are available in inventory or can be collected from the environment\n  actions = []\n  for ingredient, count in recipe.items():\n      if ingredient == \"_key\":\n          continue\n\n      ingredient_index = env.world.cookbook.index[ingredient]\n      required_count = count\n\n      while env._current_state.inventory[ingredient_index] < required_count:\n          # Find the location of the ingredient in the environment\n          locations = np.argwhere(env._current_state.grid[..., ingredient_index] > 0)\n          if len(locations) == 0:\n              print(f\"Ingredient {ingredient} not found in the environment.\")\n              return []\n\n          # Move to the closest ingredient location and collect it\n          closest_location = min(locations, key=lambda loc: np.linalg.norm(np.array(loc) - np.array(env._current_state.pos)))\n          actions.extend(move_to(env, closest_location))\n          actions.append(craft.USE)\n          env._current_state.inventory[ingredient_index] += 1\n\n  # Move to the workshop and craft the item\n  workshop = recipe.get(\"_at\", None)\n  if workshop:\n      workshop_index = env.world.cookbook.index[workshop]\n      workshop_location = np.argwhere(env._current_state.grid[..., workshop_index] > 0)[0]\n      actions.extend(move_to(env, workshop_location))\n  \n  # Use the USE action to craft the item\n  actions.append(craft.USE)\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-10T12:15:49.442521", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index of the item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the item can be crafted (has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Extract the recipe for the item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Determine required primitives and their counts\n  required_primitives = {ingredient: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n  \n  # Check if we have all required primitives in our inventory\n  missing_primitives = []\n  for ingredient, count in required_primitives.items():\n    ingredient_index = env.world.cookbook.index.get(ingredient)\n    if ingredient_index is None or env._current_state.inventory[ingredient_index] < count:\n      missing_primitives.append((ingredient, count))\n\n  # If we are missing any primitives, return an empty action list\n  if missing_primitives:\n    print(f\"Missing primitives: {missing_primitives}\")\n    return []\n\n  # Determine the workshop to use\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n  \n  # Find positions of all workshops in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  # If no workshops found, return an empty action list\n  if workshop_positions.size == 0:\n    print(f\"No {workshop_name} found.\")\n    return []\n\n  # Choose the closest workshop (heuristic: Euclidean distance to the nearest workshop)\n  current_pos = np.array(env._current_state.pos)\n  distances = np.linalg.norm(workshop_positions - current_pos, axis=1)\n  closest_workshop_index = np.argmin(distances)\n  closest_workshop_pos = tuple(workshop_positions[closest_workshop_index])\n\n  # Generate actions to move towards the nearest workshop\n  path_actions = generate_path_actions(env._current_state.pos, closest_workshop_pos)\n  if not path_actions:\n    print(f\"No valid path to {workshop_name} at position {closest_workshop_pos}.\")\n    return []\n\n  actions.extend(path_actions)\n\n  # Add action to face the workshop (assuming facing up is index 0, right is 1, down is 2, left is 3)\n  # This is a placeholder and needs to be calculated based on actual positions\n  direction_to_face_workshop = calculate_direction(env._current_state.pos, closest_workshop_pos)\n  if direction_to_face_workshop != env._current_state.dir:\n    actions.append(direction_to_face_workshop)\n\n  # Add action to use the workshop for crafting\n  actions.append(4)  # USE action\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-10T12:16:35.724988", "function_name": "craft", "function_body": "  # Helper function to generate actions for moving in a specific direction\n  def move_direction(direction):\n      if direction == \"UP\":\n          return env.world.DOWN\n      elif direction == \"DOWN\":\n          return env.world.UP\n      elif direction == \"LEFT\":\n          return env.world.RIGHT\n      elif direction == \"RIGHT\":\n          return env.world.LEFT\n\n  # Get the index of the item to craft from the cookbook\n  i_item = env.world.cookbook.index[item]\n\n  # Check if we already have the item in our inventory\n  if env._current_state.inventory[i_item] > 0:\n      return []\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(i_item, None)\n  \n  # If no recipe exists, return an empty list of actions\n  if not recipe:\n      return []\n\n  # List to store all the actions required to craft the item\n  actions = []\n  \n  # Collecting primitives required for crafting\n  for ingredient, count in recipe.items():\n      if ingredient == \"_at\":\n          continue\n\n      i_ingredient = env.world.cookbook.index[ingredient]\n\n      # Check if we already have enough of this primitive\n      while env._current_state.inventory[i_ingredient] < count:\n          actions.extend(collect_v2(env, ingredient))\n  \n  # Move to the workshop specified in the recipe and use it\n  workshop_name = recipe.get(\"_at\", None)\n  if not workshop_name:\n      return []\n\n  i_workshop = env.world.cookbook.index[workshop_name]\n  workshop_indices = [i for i in range(len(env._current_state.grid)) \n                      for j in range(len(env._current_state.grid[0])) \n                      if env._current_state.grid[i, j, i_workshop] == 1]\n\n  if not workshop_indices:\n      return []\n\n  # Move to the nearest workshop\n  nearest_workshop = min(workshop_indices, key=lambda pos: np.linalg.norm(np.array(pos) - np.array(env._current_state.pos)))\n  \n  path_to_workshop = astar(env._current_state.grid, env._current_state.pos, nearest_workshop)\n  if not path_to_workshop:\n      return []\n\n  actions.extend([move_direction(direction) for direction in path_to_workshop])\n\n  # Turn to face the workshop\n  final_direction = calculate_final_direction(env._current_state.pos, nearest_workshop, env._current_state.dir)\n  turn_actions = turn_to_direction(final_direction, env._current_state.dir)\n  actions.extend(turn_actions)\n\n  # Use the workshop to craft the item\n  actions.append(env.world.USE)\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-10T12:16:36.702185", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index of the item to craft\n  i_goal = env.world.cookbook.index.index(item)\n  \n  # Check if the item has a recipe and get its primitives\n  if i_goal in env.world.cookbook.recipes:\n    recipe = env.world.cookbook.recipes[i_goal]\n    \n    # Get required primitives for the item\n    required_primitives = {k: v for k, v in recipe.items() if k != \"_key\"}\n    \n    # Collect the required primitives\n    for primitive, count in required_primitives.items():\n      while env._current_state.inventory[primitive] < count:\n        actions.extend(collect(env, env.world.cookbook.index.get(primitive)))\n        \n    # Get the workshop index from the recipe\n    workshop_index = env.world.workshop_indices[int(recipe[\"_key\"])]\n    \n    # Move to the nearest workshop that matches the required workshop type\n    actions.extend(move_to_workshop(env, workshop_index))\n    \n    # Use action at the workshop\n    actions.append(craft.USE)\n  \n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-10T12:17:44.338249", "function_name": "craft", "function_body": "  actions = []\n  # Convert the item name to its index using the cookbook\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all required primitives for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  current_inventory = {env.world.cookbook.index.get(idx): count for idx, count in enumerate(env._current_state.inventory) if count > 0}\n\n  # If any required primitive is missing, return empty action list\n  for req_item, req_count in required_primitives.items():\n    if current_inventory.get(req_item, 0) < req_count:\n      return []\n\n  # Find the workshop required to craft this item\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_key = next(key for key in recipe.keys() if key.startswith(\"_at\"))\n  workshop_name = recipe[workshop_key]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    return []\n\n  # Choose a random workshop position to head towards\n  workshop_pos = tuple(workshop_positions[env.world.random.randint(len(workshop_positions))])\n\n  # Calculate the path from the current position to the chosen workshop\n  start_pos = env._current_state.pos\n  path = shortest_path(grid, start_pos, workshop_pos)\n\n  if not path:\n    return []\n\n  # Generate actions to move along the calculated path\n  for target_pos in path[1:]:  # Skip the starting point\n    action = move_towards(env._current_state.pos, env._current_state.dir, target_pos)\n    if action is None:\n      continue  # Handle cases where no valid move exists\n    actions.append(action)\n\n  # Add USE action to craft the item at the workshop\n  actions.append(craft.ACTIONS.USE)\n  \n  return actions", "island_id": 1, "scores": {"3": 0.0}}
