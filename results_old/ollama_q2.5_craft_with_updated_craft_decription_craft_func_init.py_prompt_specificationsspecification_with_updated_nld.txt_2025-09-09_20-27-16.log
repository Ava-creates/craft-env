{"timestamp": "2025-09-09T22:01:28.556323", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the cookbook and index mappings\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  # Check if we already have this item in our inventory\n  if env._current_state.inventory[item_index] > 0:\n    return actions\n  \n  # Determine the primitives required to craft the item\n  recipe = cookbook.recipes.get(item_index, {})\n  if \"_key\" not in recipe:\n    raise ValueError(f\"No recipe found for {item} or no key specified.\")\n  \n  workshop = recipe[\"_key\"]\n  workshop_index = cookbook.index[workshop]\n  \n  # Find all required primitives and their counts\n  required_primitives = {}\n  for primitive, count in recipe.items():\n      if primitive != \"_key\":\n          primitive_index = cookbook.index[primitive]\n          required_primitives[primitive_index] = count\n  \n  # Collect the necessary primitives if not already in inventory\n  current_inventory = env._current_state.inventory.copy()\n  \n  # Check if we have all required items in our inventory\n  for primitive_index, needed_count in required_primitives.items():\n      if current_inventory[primitive_index] < needed_count:\n          actions.extend(collect_v2(env, cookbook.index.get(primitive_index)))\n  \n  # Navigate to the correct workshop and use it to craft the item\n  workshop_position = find_workshop_position(env, workshop_index)\n  \n  if workshop_position is None:\n      raise ValueError(f\"Workshop {workshop} not found in the grid.\")\n  \n  path_to_workshop = get_path(env._current_state.grid, env._current_state.pos, workshop_position, env.world.non_grabbable_indices)\n  \n  if not path_to_workshop:\n      raise ValueError(\"No valid path to the workshop found.\")\n  \n  # Convert path into actions\n  actions.extend(path_to_actions(env._current_state.pos, path_to_workshop, env._current_state.dir))\n  actions.append(4)  # Action for USE\n  \n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-09T22:01:29.536476", "function_name": "craft", "function_body": "  # Get the index of the item we want to craft\n  i_item = env.world.cookbook.index[item]\n\n  # Check if the item has a recipe in the cookbook\n  if i_item not in env.world.cookbook.recipes:\n    return []\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes[i_item]\n\n  # List to store actions needed to craft the item\n  actions = []\n\n  # Check if all primitives required by the recipe are in the inventory\n  for ingredient, count in recipe.items():\n    if ingredient == \"_key\":\n      continue\n\n    i_ingredient = env.world.cookbook.index[ingredient]\n    if env._current_state.inventory[i_ingredient] < count:\n      return []\n\n  # If we have all ingredients, proceed to craft\n  workshop_name = recipe[\"_key\"]\n  workshop_idx = env.world.workshop_indices[env.world.cookbook.index[workshop_name]]\n\n  # Find the position of the nearest workshop\n  grid = env._current_state.grid\n  pos = np.argwhere(grid[:, :, workshop_idx] == 1)\n  if pos.size == 0:\n    return []\n\n  closest_workshop_pos = min(pos, key=lambda p: abs(p[0] - env._current_state.pos[0]) + abs(p[1] - env._current_state.pos[1]))\n\n  # Generate actions to move to the closest workshop\n  dx = closest_workshop_pos[1] - env._current_state.pos[1]\n  dy = closest_workshop_pos[0] - env._current_state.pos[0]\n\n  if dx > 0:\n    actions.extend([env.world.cookbook.index[\"RIGHT\"]] * abs(dx))\n  elif dx < 0:\n    actions.extend([env.world.cookbook.index[\"LEFT\"]] * abs(dx))\n\n  if dy > 0:\n    actions.extend([env.world.cookbook.index[\"DOWN\"]] * abs(dy))\n  elif dy < 0:\n    actions.extend([env.world.cookbook.index[\"UP\"]] * abs(dy))\n\n  # Turn to face the workshop\n  actions.append(env.world.cookbook.index[\"USE\"])\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
