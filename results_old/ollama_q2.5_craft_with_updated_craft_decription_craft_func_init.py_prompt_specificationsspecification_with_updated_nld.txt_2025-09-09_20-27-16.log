else:\n      if dy > 0:\n          actions_to_take.extend([craft.MOVE_DOWN for _ in range(dy)])\n      else:\n          actions_to_take.extend([craft.MOVE_UP for _ in range(-dy)])\n\n  # Determine the target direction to face the workshop\n  current_direction = env._current_state.dir\n\n  if dx == 0 and dy == 0:  # Already at the workshop\n      pass\n  elif abs(dx) > abs(dy):  # Prioritize horizontal movement\n      while current_direction != (craft.RIGHT if dx > 0 else craft.LEFT):\n          actions_to_take.append(craft.TURN_RIGHT)\n          current_direction = (current_direction + 1) % 4\n  else:  # Prioritize vertical movement\n      while current_direction != (craft.DOWN if dy > 0 else craft.UP):\n          actions_to_take.append(craft.TURN_LEFT)\n          current_direction = (current_direction - 3) % 4\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T22:45:58.926174", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  index_item = cookbook.index[item]\n\n  if not index_item:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  recipe = cookbook.recipes.get(index_item)\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = env._current_state.inventory.copy()\n\n  required_ingredients = {cookbook.index[k]: v for k, v in recipe.items()}\n\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if available_inventory.get(ingredient_index, 0) < required_count:\n      can_craft = False\n      break\n\n  if not can_craft:\n    return []\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No available workshop to craft item\")\n\n  current_position = np.array(env._current_state.pos)\n  \n  nearest_workshop_pos, _ = min(\n      [(tuple(pos), np.linalg.norm(current_position - pos)) for pos in workshop_positions],\n      key=lambda x: x[1]\n  )\n\n  # Calculate actions to move the agent to the nearest workshop\n  dx = nearest_workshop_pos[0] - current_position[0]\n  dy = nearest_workshop_pos[1] - current_position[1]\n\n  actions_to_take = []\n\n  if dx > 0:\n    actions_to_take.extend([craft.MOVE_RIGHT for _ in range(dx)])\n  elif dx < 0:\n    actions_to_take.extend([craft.MOVE_LEFT for _ in range(-dx)])\n\n  if dy > 0:\n    actions_to_take.extend([craft.MOVE_DOWN for _ in range(dy)])\n  elif dy < 0:\n    actions_to_take.extend([craft.MOVE_UP for _ in range(-dy)])\n\n  # Determine the target direction to face the workshop\n  current_direction = env._current_state.dir\n\n  if dx > 0:\n      target_direction = craft.RIGHT\n  elif dx < 0:\n      target_direction = craft.LEFT\n  elif dy > 0:\n      target_direction = craft.DOWN\n  else: # dy < 0\n      target_direction = craft.UP\n\n  # Calculate the required turns to face the target direction\n  current_dir_index = {craft.RIGHT: 0, craft.DOWN: 1, craft.LEFT: 2, craft.UP: 3}[current_direction]\n  target_dir_index = {craft.RIGHT: 0, craft.DOWN: 1, craft.LEFT: 2, craft.UP: 3}[target_direction]\n\n  turns_right = (target_dir_index - current_dir_index) % 4\n  turns_left = (current_dir_index - target_dir_index) % 4\n\n  # Choose the minimum number of turns\n  if turns_right < turns_left:\n      actions_to_take.extend([craft.TURN_RIGHT for _ in range(turns_right)])\n  else:\n      actions_to_take.extend([craft.TURN_LEFT for _ in range(turns_left)])\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-10T22:47:10.627385", "function_name": "craft", "function_body": "  # Get the index of the item to be crafted\n  item_index = env.world.cookbook.index[item]\n\n  # Get the primitives required for crafting the item\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n\n  actions = []\n  \n  # Check if we have all the required primitives in our inventory\n  if all(env._current_state.inventory[prim] >= count for prim, count in primitives_required.items()):\n    # Get the recipe for the item\n    recipe = env.world.cookbook.recipes[item_index]\n\n    # Find the workshop where the item can be crafted\n    for ingredient, count in recipe.items():\n        if ingredient == \"_at\":\n            workshop_name = count\n            break\n\n    workshop_index = getattr(env.world, f\"{workshop_name}_index\")\n\n    # Move to the nearest workshop\n    actions.extend(find_path_to_workshop(env._current_state.grid, env._current_state.pos, workshop_index))\n\n    # Use the workshop to craft the item\n    actions.append(4)  # Assuming USE action is index 4\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-10T22:47:11.600905", "function_name": "craft", "function_body": "  # Convert item name to its corresponding index in the cookbook\n  item_index = env.world.cookbook.index.index(item)\n  \n  # If no recipe for the item exists, return an empty action list\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the primitives required for crafting the item and their counts\n  recipe = env.world.cookbook.recipes[item_index]\n  \n  # Initialize a list to store actions needed for crafting\n  actions = []\n  \n  # Collect all primitives required by the recipe\n  for primitive, count in recipe.items():\n    if primitive == '_at':\n      continue  # Skip the workshop specification\n\n    # Convert primitive name to its corresponding index in the cookbook\n    primitive_index = env.world.cookbook.index.index(primitive)\n\n    # Check how many of this primitive we already have in our inventory\n    current_count = env._current_state.inventory[primitive_index]\n    \n    # Calculate how many more of this primitive we need\n    needed_count = count - current_count\n    \n    if needed_count > 0:\n      # Collect the needed amount of primitives\n      collect_actions = collect_v2(env, primitive)\n      \n      # If collecting primitives fails (returns an empty list), return an empty action list\n      if not collect_actions:\n        return []\n      \n      # Add these actions to our main action list\n      actions.extend(collect_actions)\n\n  # Determine which workshop is required for crafting the item\n  workshop_name = recipe['_at']\n  workshop_index = env.world.cookbook.index.index(workshop_name)\n  \n  # Find a position next to the specified workshop\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n    return []  # No valid workshop found\n  \n  # Choose the nearest workshop position (simplest heuristic for now)\n  agent_pos = env._current_state.pos\n  nearest_workshop = min(workshop_positions, key=lambda wp: np.sum(np.abs(wp - agent_pos)))\n\n  # Move to the chosen workshop position\n  move_actions = move_to(env, nearest_workshop)\n\n  if not move_actions:\n    return []  # Failed to find a valid path to the workshop\n  \n  actions.extend(move_actions)\n  \n  # Turn to face the workshop (assuming facing down is default and workshops are at fixed positions)\n  turn_action = turn_towards_workshop(env._current_state, nearest_workshop)\n\n  if turn_action is not None:\n    actions.append(turn_action)\n\n  # Perform the USE action to craft the item\n  actions.append(craft.world.CRAFT_FUNC)\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-10T22:48:21.864326", "function_name": "craft", "function_body": "  # Get the index of the desired item from the cookbook\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the recipe exists for the item\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Retrieve the recipe details\n  recipe_details = env.world.cookbook.recipes[item_index]\n\n  # List to store actions needed to craft the item\n  actions_needed = []\n\n  # Check if all ingredients are available in the inventory or environment\n  for ingredient, count in recipe_details.items():\n    if ingredient == \"_at\":\n      workshop_name = recipe_details[\"_at\"]\n      continue\n\n    ingredient_index = env.world.cookbook.index[ingredient]\n    required_count = count\n\n    while env._current_state.inventory[ingredient_index] < required_count:\n      # Find the nearest cell containing the ingredient\n      nearest_cell = find_nearest(env, ingredient_index)\n\n      if nearest_cell is None:\n        return []  # Cannot find ingredient in environment\n\n      # Move to the nearest cell\n      actions_needed.extend(move_to(env._current_state.pos, nearest_cell))\n\n      # Collect the ingredient\n      actions_needed.append(craft.COLLECT_FUNC(ingredient))\n\n    # Subtract the collected ingredients from required count\n    env._current_state.inventory[ingredient_index] -= required_count\n\n  # Move to the workshop where the item can be crafted\n  workshop_name = recipe_details[\"_at\"]\n  workshop_index = env.world.workshop_indices[workshop_name]\n\n  nearest_workshop_cell = find_nearest(env, workshop_index)\n\n  if nearest_workshop_cell is None:\n    return []  # Cannot find workshop in environment\n\n  actions_needed.extend(move_to(env._current_state.pos, nearest_workshop_cell))\n\n  # Use the USE action to craft the item\n  actions_needed.append(craft.USE_FUNC())\n\n  return actions_needed", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-10T22:48:22.830704", "function_name": "craft", "function_body": "  def find_workshop_index(workshop_name):\n    for i, workshop in enumerate(env.world.workshop_indices):\n      if env.world.cookbook.index.get(workshop) == workshop_name:\n        return workshop\n    return None\n\n  def navigate_to_position(pos_x, pos_y):\n    actions = []\n    current_pos = env._current_state.pos\n    delta_x = pos_x - current_pos[0]\n    delta_y = pos_y - current_pos[1]\n\n    # Determine the direction to move in X-axis\n    if delta_x > 0:\n        actions.extend([craft.RIGHT] * delta_x)\n    elif delta_x < 0:\n        actions.extend([craft.LEFT] * abs(delta_x))\n\n    # Determine the direction to move in Y-axis\n    if delta_y > 0:\n        actions.extend([craft.DOWN] * delta_y)\n    elif delta_y < 0:\n        actions.extend([craft.UP] * abs(delta_y))\n    \n    return actions\n\n  def craft_item_at_workshop(workshop_index):\n      workshop_pos = np.argwhere(env._current_state.grid[:, :, workshop_index])\n      if not workshop_pos.size > 0:\n          return []\n      \n      # Assuming the workshop is a single cell\n      workshop_pos = tuple(workshop_pos[0])\n\n      actions = navigate_to_position(workshop_pos[1], workshop_pos[0])\n      actions.append(craft.USE)\n      return actions\n\n  item_index = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n  \n  if not recipe:\n      return []\n  \n  # Check and collect all required primitives\n  actions = []\n  for ingredient, count in recipe.items():\n      if ingredient == \"_at\":\n          workshop_name = recipe[\"_at\"]\n          continue\n      \n      # If the ingredient is a primitive, we need to collect it\n      if ingredient in env.world.primitives:\n          actions.extend(collect(env, ingredient))\n  \n  # Navigate to the specified workshop and craft the item\n  workshop_index = find_workshop_index(workshop_name)\n  if workshop_index:\n      actions.extend(craft_item_at_workshop(workshop_index))\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-10T22:49:08.409505", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all required primitives for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  \n  actions = []\n  \n  # First, collect all required primitives if not in inventory\n  for primitive_index, count in required_primitives.items():\n    while env._current_state.inventory[primitive_index] < count:\n      # Find the location of this primitive on the grid\n      locations = np.argwhere(env._current_state.grid[:, :, primitive_index])\n      \n      # If no locations are found, return an empty list (not enough primitives)\n      if len(locations) == 0:\n        return []\n      \n      # Choose a random location to go and collect the primitive\n      target_location = tuple(locations[np.random.choice(len(locations))])\n      \n      # Calculate the path to the target location\n      path_actions = move_to_target(env, target_location)\n      \n      # Add the collected actions (path + USE) to the main list of actions\n      actions.extend(path_actions + [craft.USE])\n  \n  # Once we have all required primitives, find and go to the workshop specified in the recipe\n  workshop_index = env.world.cookbook.recipes[item_index][\"_key\"]\n  workshop_location = find_workshop(env, workshop_index)\n  \n  if not workshop_location:\n    return []\n  \n  path_to_workshop_actions = move_to_target(env, workshop_location)\n  actions.extend(path_to_workshop_actions + [craft.USE])\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-10T22:49:09.417524", "function_name": "craft", "function_body": "  # Convert item name to index using the cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Get primitives required for crafting the item\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  \n  actions = []\n  \n  # Collect all required primitives if not already in inventory\n  for primitive, count in primitives_needed.items():\n    primitive_name = env.world.cookbook.index.get(primitive)\n    \n    # Check how many of the primitive we currently have in inventory\n    current_count = env._current_state.inventory[primitive]\n    \n    if current_count < count:\n      # Collect the required amount of primitives\n      actions.extend(collect_v2(env, primitive_name, count - current_count))\n      \n  # Determine which workshop to go to for crafting\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_key = \"_at\"\n  workshop_name = recipe[workshop_key]\n  \n  if workshop_name in [\"workshop0\", \"workshop1\", \"workshop2\"]:\n    workshop_index = getattr(env.world, f\"{workshop_name}_index\")\n    \n    # Navigate to the closest workshop\n    actions.extend(navigate_to_workshop_v2(env._current_state, workshop_index))\n    \n    # Craft the item by performing USE action at the workshop\n    actions.append(env.action_specs()[\"USE\"])\n  else:\n    raise ValueError(\"Unknown workshop specified in recipe.\")\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-10T22:51:23.953347", "function_name": "craft", "function_body": "  def calculate_path(start_pos, target_pos, grid):\n    \"\"\"A simple BFS implementation to find a path from start_pos to target_pos.\"\"\"\n    queue = collections.deque([(start_pos, [])])\n    visited = set()\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]  # RIGHT, DOWN, LEFT, UP\n\n    while queue:\n        (x, y), path = queue.popleft()\n\n        if (x, y) == target_pos:\n            return path\n\n        if (x, y) in visited:\n            continue\n        visited.add((x, y))\n\n        for dx, dy in directions:\n            nx, ny = x + dx, y + dy\n            if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and grid[nx, ny, -1] == 0:  # Assuming the last layer is walkable\n                queue.append(((nx, ny), path + [(dx, dy)]))\n\n    return None\n\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n\n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = env._current_state.inventory.copy()\n\n  # Check if all ingredients are available\n  required_ingredients = {cookbook.index[k]: v for k, v in recipe.items()}\n\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if not can_craft:\n    return []\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No available workshop to craft item\")\n\n  # Select the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n  # Calculate the path to the nearest workshop\n  path = calculate_path(tuple(current_position), nearest_workshop_pos, env._current_state.grid)\n\n  if not path:\n    raise ValueError(\"No valid path found to reach the workshop\")\n\n  actions_to_take = []\n\n  current_direction = env._current_state.dir\n\n  for (dx, dy) in path:\n      target_direction = None\n      if dx == 1 and dy == 0:\n          target_direction = craft.RIGHT\n      elif dx == -1 and dy == 0:\n          target_direction = craft.LEFT\n      elif dx == 0 and dy == 1:\n          target_direction = craft.DOWN\n      elif dx == 0 and dy == -1:\n          target_direction = craft.UP\n\n      while current_direction != target_direction:\n          actions_to_take.append(craft.TURN_RIGHT)\n          current_direction = (current_direction + 1) % 4\n\n      actions_to_take.append(craft.MOVE_FORWARD)\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
