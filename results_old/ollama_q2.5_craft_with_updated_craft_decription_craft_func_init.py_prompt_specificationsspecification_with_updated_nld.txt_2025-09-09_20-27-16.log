{"timestamp": "2025-09-10T16:12:54.313390", "function_name": "craft", "function_body": "  def astar(start, goal, grid_shape):\n    # A* algorithm implementation\n    open_set = collections.PriorityQueue()\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, goal)}\n\n    open_set.put((f_score[start], start))\n\n    while not open_set.empty():\n        _, current = open_set.get()\n\n        if current == goal:\n            return reconstruct_path(came_from, current)\n\n        for neighbor in neighbors(current, grid_shape):\n            tentative_g_score = g_score[current] + 1\n\n            if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                came_from[neighbor] = current\n                g_score[neighbor] = tentative_g_score\n                f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                open_set.put((f_score[neighbor], neighbor))\n\n    return []\n\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def neighbors(pos, grid_shape):\n      x, y = pos\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < grid_shape[0] and 0 <= ny < grid_shape[1]:\n              yield (nx, ny)\n\n  def reconstruct_path(came_from, current):\n      total_path = [current]\n      while current in came_from:\n          current = came_from[current]\n          total_path.append(current)\n      return total_path[::-1]\n\n  goal_index = env.world.cookbook.index[item]\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n\n  actions = []\n\n  if not required_primitives:\n    return [] # No recipe or no primitives needed, can't craft\n\n  # Check if all required primitives are already in inventory\n  for primitive, count in required_primitives.items():\n    if env._current_state.inventory[primitive] < count:\n      return [] # Not enough primitives to start crafting\n\n  # Find the workshop where we need to go to craft this item\n  workshop_index = None\n  for recipe_key, recipe in env.world.cookbook.recipes.items():\n    if \"_at\" in recipe and recipe[\"_at\"] == goal_index:\n      workshop_index = env.world.cookbook.index[recipe_key]\n      break\n\n  # Check if the required workshop exists\n  if workshop_index is None:\n    return [] # No suitable workshop found\n  \n  # Navigate to the closest workshop\n  target_pos = None\n  for x in range(env._current_state.grid.shape[0]):\n    for y in range(env._current_state.grid.shape[1]):\n      if env._current_state.grid[x, y, workshop_index] > 0:\n        target_pos = (x, y)\n        break\n    if target_pos is not None:\n      break\n  \n  # If no workshop is found, return an empty list\n  if target_pos is None:\n    return []\n\n  # Simple pathfinding to the workshop using A* algorithm\n  start_pos = env._current_state.pos\n  path = astar(start_pos, target_pos, env._current_state.grid.shape)\n\n  # Convert path into actions\n  if path:\n      for i in range(len(path) - 1):\n          dx = path[i + 1][0] - path[i][0]\n          dy = path[i + 1][1] - path[i][1]\n\n          if dx == 0 and dy == -1:\n              actions.append(env.world.cookbook.index[\"UP\"])\n          elif dx == 0 and dy == 1:\n              actions.append(env.world.cookbook.index[\"DOWN\"])\n          elif dx == -1 and dy == 0:\n              actions.append(env.world.cookbook.index[\"LEFT\"])\n          elif dx == 1 and dy == 0:\n              actions.append(env.world.cookbook.index[\"RIGHT\"])\n\n      # Orient the agent towards the workshop before using it\n      target_direction = np.array(target_pos) - np.array(path[-2])\n      current_direction = get_current_direction_from_state(env._current_state)\n\n      while not is_facing_correct_direction(current_direction, target_direction):\n          actions.append(rotate_towards_target_direction(current_direction, target_direction))\n          current_direction = get_rotated_direction(current_direction, rotate_towards_target_direction(current_direction, target_direction))\n\n  # Use action to craft the item at the workshop\n  actions.append(env.world.cookbook.index[\"USE\"])\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T16:12:55.305672", "function_name": "craft", "function_body": "  goal_index = env.world.cookbook.index[item]\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n\n  if not required_primitives:\n    return [] # No recipe or no primitives needed\n\n  actions = []\n\n  # Check inventory for required primitives\n  missing_primitives = {primitive: count - env._current_state.inventory[primitive] \n                        for primitive, count in required_primitives.items() \n                        if count > env._current_state.inventory[primitive]}\n  \n  # If we are missing any primitives, collect them first\n  if missing_primitives:\n    for primitive_index, count in missing_primitives.items():\n      primitive_name = env.world.cookbook.index.get_by_value(primitive_index)\n      actions.extend(collect(env, primitive_name))\n      \n      # Check again after collection (in case we collected more than needed)\n      if env._current_state.inventory[primitive_index] >= required_primitives[primitive_index]:\n          continue\n\n  # Find the workshop where we need to go to craft this item\n  workshop_key = next((k for k, v in env.world.cookbook.recipes.items() if \"_at\" in v and v[\"_at\"] == goal_index), None)\n  if not workshop_key:\n    return [] # No suitable workshop found\n  \n  workshop_index = env.world.cookbook.index[workshop_key]\n\n  # Navigate to the closest workshop\n  target_pos = find_closest_workshop(env._current_state.grid, workshop_index)\n\n  if not target_pos:\n    return [] # No available workshops\n\n  # Pathfind to the workshop using A* algorithm\n  start_pos = env._current_state.pos\n  path = astar(start_pos, target_pos, env._current_state.grid.shape)\n  \n  if not path:\n    return [] # No valid path found\n\n  actions.extend(navigate_path(path))\n\n  # Use action to craft the item at the workshop\n  actions.append(env.world.cookbook.index[\"USE\"])\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-10T16:15:42.155574", "function_name": "craft", "function_body": "  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def neighbors(grid, pos, blocked_indices):\n      x, y = pos\n      results = [(x+1, y), (x-1, y), (x, y+1), (x, y-1)]\n      return [p for p in results if grid[p] == 0 and p not in blocked_indices]\n\n  def reconstruct_path(came_from, current):\n      total_path = [current]\n      while current in came_from:\n          current = came_from[current]\n          total_path.append(current)\n      return list(reversed(total_path))\n\n  def navigate_to(start_pos, goal_pos, grid, blocked_indices):\n      open_set = []\n      heapq.heappush(open_set, (0, start_pos))\n      came_from = {}\n      g_score = {start_pos: 0}\n      f_score = {start_pos: heuristic(start_pos, goal_pos)}\n\n      while open_set:\n          _, current = heapq.heappop(open_set)\n\n          if current == goal_pos:\n              return reconstruct_path(came_from, current)\n\n          for neighbor in neighbors(grid, current, blocked_indices):\n              tentative_g_score = g_score[current] + 1\n\n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal_pos)\n                  heapq.heappush(open_set, (f_score[neighbor], neighbor))\n\n      return []\n\n  def determine_facing_direction(current_pos, target_pos):\n      if current_pos[0] < target_pos[0]:\n          return craft.ACTION_RIGHT\n      elif current_pos[0] > target_pos[0]:\n          return craft.ACTION_LEFT\n      elif current_pos[1] < target_pos[1]:\n          return craft.ACTION_DOWN\n      elif current_pos[1] > target_pos[1]:\n          return craft.ACTION_UP\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  current_inventory = {env.world.cookbook.index.get(i): env._current_state.inventory[i] for i in range(len(env._current_state.inventory))}\n\n  actions = []\n\n  # Check if we have all the primitives required\n  for primitive, count in required_primitives.items():\n      if current_inventory.get(primitive, 0) < count:\n          return []  # Return empty list as we do not have enough primitives\n\n  # Determine which workshop to use and navigate there\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_required = None\n  for key in recipe.keys():\n      if \"_at\" in key:\n          workshop_required = key.split(\"_at\")[1].strip()\n          break\n\n  if not workshop_required:\n      return []  # No valid workshop found in the recipe\n\n  # Find the position of the required workshop in the grid\n  workshop_index = env.world.cookbook.index[workshop_required]\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n  if not workshop_positions.size:\n      return []  # No valid workshop found on the grid\n\n  target_workshop_position = tuple(workshop_positions[0])\n\n  # Navigate to the workshop\n  blocked_indices = set([(x, y) for x in range(env._current_state.grid.shape[0]) for y in range(env._current_state.grid.shape[1]) if any(env._current_state.grid[x, y] == 1)])\n  path = navigate_to(env._current_state.pos, target_workshop_position, env._current_state.grid, blocked_indices)\n  actions.extend(path)\n\n  # Turn to face the workshop (assuming we can determine the direction needed)\n  facing_direction = determine_facing_direction(env._current_state.pos, target_workshop_position)\n  if facing_direction is not None:\n      actions.append(facing_direction)\n\n  # Perform USE action to craft the item\n  actions.append(craft.ACTION_USE)\n\n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T16:15:43.110644", "function_name": "craft", "function_body": "  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def reconstruct_path(came_from, current):\n      total_path = [current]\n      while current in came_from:\n          current = came_from[current]\n          total_path.append(current)\n      return list(reversed(total_path))\n\n  def determine_facing_direction(current_pos, target_pos):\n      if current_pos[0] < target_pos[0]:\n          return craft.ACTION_RIGHT\n      elif current_pos[0] > target_pos[0]:\n          return craft.ACTION_LEFT\n      elif current_pos[1] < target_pos[1]:\n          return craft.ACTION_DOWN\n      elif current_pos[1] > target_pos[1]:\n          return craft.ACTION_UP\n\n  def navigate(start_pos, goal_pos):\n      \"\"\"A* search algorithm to find the shortest path from start_pos to goal_pos.\"\"\"\n      open_set = []\n      heapq.heappush(open_set, (0, start_pos))\n      came_from = {}\n      g_score = {start_pos: 0}\n      f_score = {start_pos: heuristic(start_pos, goal_pos)}\n\n      while open_set:\n          _, current = heapq.heappop(open_set)\n\n          if current == goal_pos:\n              return reconstruct_path(came_from, current)\n\n          for neighbor in neighbors(current):\n              tentative_g_score = g_score[current] + 1\n\n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal_pos)\n                  heapq.heappush(open_set, (f_score[neighbor], neighbor))\n\n      return []\n\n  def neighbors(pos):\n      \"\"\"Returns all valid neighboring positions that the agent can move to.\"\"\"\n      x, y = pos\n      results = [(x+1, y), (x-1, y), (x, y+1), (x, y-1)]\n      grid_size_x, grid_size_y = env._current_state.grid.shape[:2]\n      valid_neighbors = [p for p in results if 0 <= p[0] < grid_size_x and 0 <= p[1] < grid_size_y and env._current_state.grid[p][0] == 0]\n      return valid_neighbors\n\n  def check_inventory(required_primitives, current_inventory):\n      \"\"\"Check if the agent has all required primitives in the inventory.\"\"\"\n      for primitive, count in required_primitives.items():\n          if current_inventory.get(primitive, 0) < count:\n              return False\n      return True\n\n  def collect_primitive(env, primitive_name):\n      \"\"\"Return actions to collect a specific primitive.\"\"\"\n      # Find positions of the primitive on the grid\n      primitive_index = env.world.cookbook.index[primitive_name]\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if not primitive_positions.size:\n          return []  # No valid position found for the primitive\n\n      target_primitive_position = tuple(primitive_positions[0])\n      \n      # Navigate to the primitive\n      path_to_primitive = navigate(env._current_state.pos, target_primitive_position)\n      actions = path_to_primitive.copy()\n      \n      if not path_to_primitive:\n          return []  # No valid path found to the primitive\n\n      # Turn to face the primitive (assuming we can determine the direction needed)\n      facing_direction = determine_facing_direction(env._current_state.pos, target_primitive_position)\n      if facing_direction is not None:\n          actions.append(facing_direction)\n\n      # Perform USE action to collect the primitive\n      actions.append(craft.ACTION_USE)\n\n      return actions\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  current_inventory = {env.world.cookbook.index.get(i): env._current_state.inventory[i] for i in range(len(env._current_state.inventory))}\n  \n  actions = []\n\n  # If not all primitives are available, collect them\n  if not check_inventory(required_primitives, current_inventory):\n      for primitive, count in required_primitives.items():\n          while current_inventory.get(primitive, 0) < count:\n              primitive_name = env.world.cookbook.index.reverse[primitive]\n              actions.extend(collect_primitive(env, primitive_name))\n              current_inventory = {env.world.cookbook.index.get(i): env._current_state.inventory[i] for i in range(len(env._current_state.inventory))}\n      # Re-check inventory after collecting primitives\n      if not check_inventory(required_primitives, current_inventory):\n          return []  # Failed to collect all required primitives\n\n  # Determine which workshop to use and navigate there\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_required = None\n  for key in recipe.keys():\n      if \"_at\" in key:\n          workshop_required = key.split(\"_at\")[1].strip()\n          break\n\n  if not workshop_required:\n      return []  # No valid workshop found in the recipe\n\n  # Find the position of the required workshop in the grid\n  workshop_index = env.world.cookbook.index[workshop_required]\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n  if not workshop_positions.size:\n      return []  # No valid workshop found on the grid\n\n  target_workshop_position = tuple(workshop_positions[0])\n\n  # Navigate to the workshop\n  path_to_workshop = navigate(env._current_state.pos, target_workshop_position)\n  actions.extend(path_to_workshop)\n\n  # Turn to face the workshop (assuming we can determine the direction needed)\n  facing_direction = determine_facing_direction(env._current_state.pos, target_workshop_position)\n  if facing_direction is not None:\n      actions.append(facing_direction)\n\n  # Perform USE action to craft the item\n  actions.append(craft.ACTION_USE)\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-10T16:16:44.247568", "function_name": "craft", "function_body": "  actions = []\n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # If we already have the required item in inventory or if it's a primitive\n  if env._current_state.inventory[item_index] > 0:\n    return []\n\n  # Recursively get all primitives needed to craft this item and their dependencies\n  def gather_primitives(item_idx):\n      primitives = {}\n      recipe = env.world.cookbook.recipes.get(item_idx, {})\n      \n      for ingredient_idx, count in recipe.items():\n          if ingredient_idx == \"_key\":\n              continue\n          \n          # Check if the ingredient is a primitive or another item that needs to be crafted\n          if ingredient_idx in env.world.primitives:\n              primitives[ingredient_idx] = count\n          else:\n              # Recursively gather dependencies for this non-primitive ingredient\n              sub_primitives = gather_primitives(ingredient_idx)\n              \n              # Aggregate the counts of required primitives from sub-dependencies\n              for sub_ingredient_idx, sub_count in sub_primitives.items():\n                  if sub_ingredient_idx not in primitives:\n                      primitives[sub_ingredient_idx] = 0\n                  primitives[sub_ingredient_idx] += count * sub_count\n      \n      return primitives\n  \n  # Gather all primitives needed to craft the target item and its dependencies\n  primitives_needed = gather_primitives(item_index)\n  \n  # Collect all the required primitives\n  for primitive, count in primitives_needed.items():\n    actions.extend(collect_v2(env, primitive))\n  \n  # Now that we have collected all the necessary primitives, go to the appropriate workshop and craft the item\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_name = recipe[\"_key\"].split(\"_at=\")[1] if \"_key\" in recipe else None\n  \n  if workshop_name:\n    workshop_indices = [idx for idx, name in enumerate(env.world.workshop_indices) \n                        if f\"{workshop_name}\" in env.world.cookbook.index.get(name)]\n    closest_workshop = find_closest_workshop(env._current_state.pos, workshop_indices)\n    actions.extend(move_to_workshop(env._current_state, closest_workshop))\n    \n    # Facing the correct direction before using\n    for _ in range(3):  # assuming the agent can rotate up to 3 times to face the correct direction\n      actions.append(craft.LEFT)  # or RIGHT\n    \n    actions.append(craft.USE)\n  \n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-10T16:16:45.322453", "function_name": "craft", "function_body": "  actions = []\n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we already have the required item in inventory or if it's a primitive\n  if env._current_state.inventory[item_index] > 0 or item_index in env.world.grabbable_indices:\n    return actions\n  \n  # Get all primitives needed to craft this item\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  \n  # Collect all the required primitives\n  for primitive, count in primitives_needed.items():\n      actions.extend(collect_v2(env, env.world.cookbook.index.get(primitive)))\n      \n  # Determine the workshop to use based on the recipe\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_name = list(recipe[\"_key\"].split(\"_at=\"))[1] if \"_key\" in recipe else None\n  \n  # If we have a valid workshop, proceed to it\n  if workshop_name:\n      workshop_indices = [idx for idx, name in enumerate(env.world.workshop_indices) \n                          if workshop_name in env.world.cookbook.index.get(name)]\n      \n      # Find the closest workshop of the desired type\n      closest_workshop_index = find_closest_workshop(env._current_state.pos, workshop_indices)\n      \n      # Move to the closest workshop and align direction correctly before using\n      actions.extend(move_to_workshop_and_align_direction(env._current_state, closest_workshop_index))\n      \n      # Craft the item at the workshop\n      actions.append(craft.USE)\n  \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T16:18:59.158623", "function_name": "craft", "function_body": "  def find_nearest_workshop(workshop_index):\n    pos_x, pos_y = env._current_state.pos\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    \n    if not workshop_positions.size:\n      return None\n\n    # Calculate distances to each workshop and find the closest one\n    distances = [abs(x - pos_x) + abs(y - pos_y) for x, y in workshop_positions]\n    nearest_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n    return nearest_workshop_pos\n\n  def move_to_position(target_pos):\n    actions = []\n    current_pos = env._current_state.pos\n    direction_order = [\"RIGHT\", \"LEFT\", \"DOWN\", \"UP\"]  # Define a priority order for directions\n\n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if abs(dx) > abs(dy):\n        move_dir = \"RIGHT\" if dx > 0 else \"LEFT\"\n      else:\n        move_dir = \"DOWN\" if dy > 0 else \"UP\"\n\n      # Check all possible directions to avoid obstacles\n      for direction in direction_order:\n        next_pos, move_action = get_next_position(current_pos, direction)\n        if is_valid_move(next_pos):\n          actions.append(env.world.N_ACTIONS[direction])\n          current_pos = next_pos\n          break\n\n    return actions\n\n  def get_next_position(pos, direction):\n    x, y = pos\n    if direction == \"RIGHT\":\n      return (x + 1, y), env.world.N_ACTIONS[\"RIGHT\"]\n    elif direction == \"LEFT\":\n      return (x - 1, y), env.world.N_ACTIONS[\"LEFT\"]\n    elif direction == \"DOWN\":\n      return (x, y + 1), env.world.N_ACTIONS[\"DOWN\"]\n    elif direction == \"UP\":\n      return (x, y - 1), env.world.N_ACTIONS[\"UP\"]\n\n  def is_valid_move(pos):\n    x, y = pos\n    # Ensure the position is within grid bounds and not an obstacle\n    return 0 <= x < env._current_state.grid.shape[0] and 0 <= y < env._current_state.grid.shape[1] and env._current_state.grid[x, y, env.world.cookbook.index[\"BOUNDARY\"]] == 0\n\n  def collect_ingredients(ingredients_needed):\n    actions = []\n    for ingredient_index, count in ingredients_needed.items():\n      ingredient_name = env.world.cookbook.index.get_key(ingredient_index)\n      \n      # Find the nearest cell with the required ingredient\n      ingredient_positions = np.argwhere(env._current_state.grid[:, :, ingredient_index] == 1)\n      if not ingredient_positions.size:\n        continue\n\n      for _ in range(count):\n        nearest_ingredient_pos = find_nearest_position(ingredient_positions, env._current_state.pos)\n        actions.extend(move_to_position(nearest_ingredient_pos))\n        actions.append(env.world.N_ACTIONS[\"USE\"])\n    \n    return actions\n\n  def find_nearest_position(positions, current_pos):\n    pos_x, pos_y = current_pos\n    distances = [abs(x - pos_x) + abs(y - pos_y) for x, y in positions]\n    nearest_pos = tuple(positions[np.argmin(distances)])\n    return nearest_pos\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if there's a recipe for this item\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the ingredients required to craft this item\n  recipe = env.world.cookbook.recipes[item_index]\n  ingredients_needed = {ingredient: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n\n  # Check if we have all the ingredients in our inventory\n  inventory_dict = {env.world.cookbook.index.get_key(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  # Subtract the ingredients we already have from what's needed\n  for ingredient_index, count in inventory_dict.items():\n    if ingredient_index in ingredients_needed:\n      ingredients_needed[ingredient_index] -= count\n      if ingredients_needed[ingredient_index] <= 0:\n        del ingredients_needed[ingredient_index]\n\n  # If there are still ingredients needed, collect them\n  actions_to_collect = collect_ingredients(ingredients_needed)\n\n  # Get the workshop index where this item needs to be crafted\n  workshop_name = recipe[\"_at\"]\n  workshop_index = getattr(env.world, f\"{workshop_name}_index\")\n\n  # Find the position of the nearest workshop in the grid\n  nearest_workshop_pos = find_nearest_workshop(workshop_index)\n  \n  if not nearest_workshop_pos:\n    return []\n\n  # Determine actions to move to the nearest workshop\n  actions_to_move = move_to_position(nearest_workshop_pos)\n\n  # Add USE action to craft the item\n  actions_to_move.append(env.world.USE)\n\n  # Combine all actions: collect ingredients, move to workshop, and craft\n  return actions_to_collect + actions_to_move", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-10T16:19:00.130121", "function_name": "craft", "function_body": "  def find_nearest_workshop(workshop_index):\n    pos_x, pos_y = env._current_state.pos\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    \n    if not workshop_positions.size:\n      return None\n\n    # Calculate distances to each workshop and find the closest one\n    distances = [abs(x - pos_x) + abs(y - pos_y) for x, y in workshop_positions]\n    nearest_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n    return nearest_workshop_pos\n\n  def move_to_position(target_pos):\n    actions = []\n    current_pos = env._current_state.pos\n    direction_order = [\"RIGHT\", \"LEFT\", \"DOWN\", \"UP\"]  # Define a priority order for directions\n\n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if abs(dx) > abs(dy):\n        move_dir = \"RIGHT\" if dx > 0 else \"LEFT\"\n      else:\n        move_dir = \"DOWN\" if dy > 0 else \"UP\"\n\n      # Check all possible directions to avoid obstacles\n      for direction in direction_order:\n        next_pos, move_action = get_next_position(current_pos, direction)\n        if is_valid_move(next_pos):\n          actions.append(env.world.N_ACTIONS[direction])\n          current_pos = next_pos\n          break\n\n    return actions\n\n  def get_next_position(pos, direction):\n    x, y = pos\n    if direction == \"RIGHT\":\n      return (x + 1, y), env.world.N_ACTIONS[\"RIGHT\"]\n    elif direction == \"LEFT\":\n      return (x - 1, y), env.world.N_ACTIONS[\"LEFT\"]\n    elif direction == \"DOWN\":\n      return (x, y + 1), env.world.N_ACTIONS[\"DOWN\"]\n    elif direction == \"UP\":\n      return (x, y - 1), env.world.N_ACTIONS[\"UP\"]\n\n  def is_valid_move(pos):\n    x, y = pos\n    # Ensure the position is within grid bounds and not an obstacle\n    return 0 <= x < env._current_state.grid.shape[0] and 0 <= y < env._current_state.grid.shape[1] and env._current_state.grid[x, y, env.world.cookbook.index[\"BOUNDARY\"]] == 0\n\n  def find_nearest_primitive(primitive_index):\n    pos_x, pos_y = env._current_state.pos\n    primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n    \n    if not primitive_positions.size:\n      return None\n\n    # Calculate distances to each primitive and find the closest one\n    distances = [abs(x - pos_x) + abs(y - pos_y) for x, y in primitive_positions]\n    nearest_primitive_pos = tuple(primitive_positions[np.argmin(distances)])\n    return nearest_primitive_pos\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if there's a recipe for this item\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the ingredients required to craft this item\n  recipe = env.world.cookbook.recipes[item_index]\n  ingredients_needed = {ingredient: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n\n  actions = []\n  \n  # Collect each ingredient needed\n  for ingredient_index, count in ingredients_needed.items():\n    primitive_name = env.world.cookbook.index.get_name(ingredient_index)\n    \n    while count > 0:\n      nearest_primitive_pos = find_nearest_primitive(ingredient_index)\n      \n      if not nearest_primitive_pos:\n        return []\n\n      # Determine actions to move to the nearest primitive\n      actions.extend(move_to_position(nearest_primitive_pos))\n\n      # Add USE action to collect the primitive\n      actions.append(env.world.USE)\n\n      count -= 1\n\n  # Get the workshop index where this item needs to be crafted\n  workshop_name = recipe[\"_at\"]\n  workshop_index = getattr(env.world, f\"{workshop_name}_index\")\n\n  # Find the position of the nearest workshop in the grid\n  nearest_workshop_pos = find_nearest_workshop(workshop_index)\n  \n  if not nearest_workshop_pos:\n    return []\n\n  # Determine actions to move to the nearest workshop\n  actions.extend(move_to_position(nearest_workshop_pos))\n\n  # Add USE action to craft the item\n  actions.append(env.world.USE)\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-10T16:20:34.438494", "function_name": "craft", "function_body": "  # Fetch the cookbook and determine the index for the target item\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n\n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Retrieve the recipe for crafting the specified item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  # Extract the workshop name where the item should be crafted\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = env._current_state.inventory.copy()\n\n  # Check if all ingredients are available\n  required_ingredients = {cookbook.index[k]: v for k, v in recipe.items()}\n\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if not can_craft:\n    return []\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No available workshop to craft item\")\n\n  # Select the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n  # Calculate actions to move the agent to the nearest workshop\n  dx = nearest_workshop_pos[0] - current_position[0]\n  dy = nearest_workshop_pos[1] - current_position[1]\n\n  actions_to_take = []\n\n  if dx > 0:\n    actions_to_take.extend([craft.MOVE_RIGHT for _ in range(dx)])\n  elif dx < 0:\n    actions_to_take.extend([craft.MOVE_LEFT for _ in range(-dx)])\n\n  if dy > 0:\n    actions_to_take.extend([craft.MOVE_DOWN for _ in range(dy)])\n  elif dy < 0:\n    actions_to_take.extend([craft.MOVE_UP for _ in range(-dy)])\n\n  # Calculate the target direction to face the workshop\n  current_direction = env._current_state.dir\n\n  if dx == 0 and dy == 0:  # Already at the workshop\n      pass\n  elif abs(dx) > abs(dy):  # Prioritize horizontal movement\n      while current_direction != (craft.RIGHT if dx > 0 else craft.LEFT):\n          actions_to_take.append(craft.TURN_RIGHT)\n          current_direction = (current_direction + 1) % 4\n  else:  # Prioritize vertical movement\n      while current_direction != (craft.DOWN if dy > 0 else craft.UP):\n          actions_to_take.append(craft.TURN_LEFT)\n          current_direction = (current_direction - 1) % 4\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T16:20:35.495456", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n\n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = env._current_state.inventory.copy()\n\n  # Check if all ingredients are available\n  required_ingredients = {cookbook.index[k]: v for k, v in recipe.items()}\n\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if not can_craft:\n    return []\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No available workshop to craft item\")\n\n  # Select the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n  # Calculate actions to move the agent to the nearest workshop\n  dx = nearest_workshop_pos[0] - current_position[0]\n  dy = nearest_workshop_pos[1] - current_position[1]\n\n  actions_to_take = []\n\n  if dx > 0:\n    actions_to_take.extend([craft.MOVE_RIGHT for _ in range(dx)])\n  elif dx < 0:\n    actions_to_take.extend([craft.MOVE_LEFT for _ in range(-dx)])\n\n  if dy > 0:\n    actions_to_take.extend([craft.MOVE_DOWN for _ in range(dy)])\n  elif dy < 0:\n    actions_to_take.extend([craft.MOVE_UP for _ in range(-dy)])\n\n  # Calculate the target direction to face the workshop\n  current_direction = env._current_state.dir\n\n  if dx == 0 and dy == 0:  # Already at the workshop\n      pass\n  elif abs(dx) > abs(dy):  # Prioritize horizontal movement\n      while current_direction != (craft.RIGHT if dx > 0 else craft.LEFT):\n          actions_to_take.append(craft.TURN_RIGHT)\n          current_direction = (current_direction + 1) % 4\n  else:  # Prioritize vertical movement\n      while current_direction != (craft.DOWN if dy > 0 else craft.UP):\n          actions_to_take.append(craft.TURN_LEFT)\n          current_direction = (current_direction - 1) % 4\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T16:21:41.584455", "function_name": "craft", "function_body": "  return []", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T16:21:42.637294", "function_name": "craft", "function_body": "  def find_nearest_workshop(workshop_index):\n    pos_x, pos_y = env._current_state.pos\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    \n    if not workshop_positions.size:\n      return None\n\n    # Calculate distances to each workshop and find the closest one\n    distances = [abs(x - pos_x) + abs(y - pos_y) for x, y in workshop_positions]\n    nearest_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n    return nearest_workshop_pos\n\n  def move_to_position(target_pos):\n    actions = []\n    current_pos = env._current_state.pos\n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if abs(dx) > abs(dy):\n        move_dir = \"RIGHT\" if dx > 0 else \"LEFT\"\n      else:\n        move_dir = \"DOWN\" if dy > 0 else \"UP\"\n\n      actions.append(env.world.N_ACTIONS[move_dir])\n      # Simulate the movement to update current_pos\n      if move_dir == \"RIGHT\":\n        current_pos = (current_pos[0] + 1, current_pos[1])\n      elif move_dir == \"LEFT\":\n        current_pos = (current_pos[0] - 1, current_pos[1])\n      elif move_dir == \"DOWN\":\n        current_pos = (current_pos[0], current_pos[1] + 1)\n      elif move_dir == \"UP\":\n        current_pos = (current_pos[0], current_pos[1] - 1)\n\n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if there's a recipe for this item\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the ingredients required to craft this item\n  recipe = env.world.cookbook.recipes[item_index]\n  ingredients_needed = {ingredient: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n\n  # Check if we have all the ingredients in our inventory\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  # Subtract the ingredients we already have from what's needed\n  for ingredient_index, count in inventory_dict.items():\n    if ingredient_index in ingredients_needed:\n      ingredients_needed[ingredient_index] -= count\n      if ingredients_needed[ingredient_index] <= 0:\n        del ingredients_needed[ingredient_index]\n\n  # If there are still ingredients needed, return an empty action list\n  if ingredients_needed:\n    return []\n\n  # Get the workshop index where this item needs to be crafted\n  workshop_name = recipe[\"_at\"]\n  workshop_index = getattr(env.world, f\"{workshop_name}_index\")\n\n  # Find the position of the nearest workshop in the grid\n  nearest_workshop_pos = find_nearest_workshop(workshop_index)\n  \n  if not nearest_workshop_pos:\n    return []\n\n  # Determine actions to move to the nearest workshop\n  actions_to_move = move_to_position(nearest_workshop_pos)\n\n  # Add USE action to craft the item\n  actions_to_move.append(env.world.USE)\n\n  # Simulate moving and crafting in the environment to update the state\n  for action in actions_to_move:\n    _, done, _ = env.step(action)\n    if done:\n      break\n\n  return actions_to_move", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T16:22:24.326321", "function_name": "craft", "function_body": "  # Fetch the required recipe for the item from the cookbook\n  index = env.world.cookbook.index\n  item_index = index[item]\n  recipe = env.world.cookbook.recipes.get(item_index)\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  # Determine the ingredients needed and their counts\n  required_ingredients = {}\n  for ingredient, count in recipe.items():\n      if ingredient != \"_key\":\n          required_ingredients[ingredient] = count\n\n  actions = []\n\n  # Collect all required ingredients if not already in inventory\n  current_inventory = env._current_state.inventory\n  for ingredient_index, count in required_ingredients.items():\n    ingredient_name = index.get(ingredient_index)\n    if current_inventory[ingredient_index] < count:\n      collect_actions = collect_v2(env, ingredient_name)\n      actions.extend(collect_actions)\n\n  # Go to the specified workshop and use it to craft the item\n  workshop_key = recipe[\"_key\"]\n  workshop_name = workshop_key.split(\"_at_\")[1]\n  workshop_indices = env.world.workshop_indices\n\n  for idx in workshop_indices:\n    if index.get(idx) == workshop_name:\n      move_actions = move_to_workshop(env, idx)\n      actions.extend(move_actions)\n      break\n  else:\n    raise ValueError(f\"No valid workshop found for {item}\")\n\n  # Use the workshop to craft the item\n  actions.append(craft.world.CraftWorld.USE)\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-10T16:22:25.320827", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index for the item to craft\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the recipe exists and get the required primitives\n  if item_index in env.world.cookbook.recipes:\n    recipe = env.world.cookbook.recipes[item_index]\n    \n    # Determine the workshop index from the \"_at\" key\n    workshop_name = recipe.pop('_at', None)\n    if workshop_name is not None:\n      workshop_index = getattr(env.world, f'{workshop_name}_index')\n      \n      # Check inventory for required primitives\n      required_primitives = env.world.cookbook.primitives_for(item_index)\n      has_all_primitives = True\n      \n      for primitive_index, count in required_primitives.items():\n        if env._current_state.inventory[primitive_index] < count:\n          has_all_primitives = False\n          break\n      \n      # If we have all the primitives, proceed to craft the item\n      if has_all_primitives:\n        actions.extend(navigate_to_workshop(env._current_state.grid, env._current_state.pos, workshop_index))\n        \n        # Add USE action to craft the item at the workshop\n        actions.append(4)  # Assuming USE is represented by index 4\n        \n    else:\n      print(f\"No workshop specified for crafting {item}.\")\n  else:\n    print(f\"No recipe found for crafting {item}.\")\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-10T16:23:06.923356", "function_name": "craft", "function_body": "  # Get the index for the goal item\n  goal_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the required primitives to craft the item\n  primitive_counts = env.world.cookbook.primitives_for(goal_index)\n  \n  actions = []\n  current_state = env._current_state\n  \n  # Collect all required primitives first\n  for primitive, count in primitive_counts.items():\n    primitive_name = env.world.cookbook.index.get(primitive)\n    \n    # Check if we have enough of this primitive already in our inventory\n    if current_state.inventory[primitive] >= count:\n      continue\n    \n    # Determine how many more of this primitive we need to collect\n    needed_count = count - current_state.inventory[primitive]\n    \n    for _ in range(needed_count):\n      actions.extend(collect(env, primitive_name))\n      \n  # Now that we have all the primitives, find out where we can craft the item and go there\n  workshop_index = None\n  \n  for recipe_input, count in env.world.cookbook.recipes[goal_index].items():\n    if recipe_input == \"_at\":\n      workshop_index = env.world.cookbook.index[count]\n      \n  # Check if we found a valid workshop\n  if workshop_index is None:\n    return []\n  \n  workshop_name = env.world.cookbook.index.get(workshop_index)\n  \n  # Move to the nearest instance of the required workshop\n  actions.extend(move_to(env, workshop_name))\n  \n  # Turn towards the workshop and use it to craft the item\n  actions.append(use_action_towards(env._current_state.pos, workshop_name))\n  \n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-10T16:23:07.883732", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  goal_index = env.world.cookbook.index[item]\n  \n  if goal_index not in env.world.cookbook.recipes:\n    print(f\"No recipe for {item}.\")\n    return []\n\n  # Find out the required ingredients and their counts\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  actions = []\n  primitives_required = {}\n  workshop_required = None\n\n  # Collect primitives if not already in inventory\n  for ingredient, count in recipe.items():\n    if ingredient == \"_key\":\n      workshop_required = env.world.cookbook.index[count]\n      continue\n    \n    required_count = count - env._current_state.inventory[ingredient]\n    if required_count > 0:\n      primitives_required[ingredient] = required_count\n  \n  # Collect all required primitives\n  for primitive_index, required_count in primitives_required.items():\n    while required_count > 0:\n      collect_actions = collect(env.world.cookbook.index.get(env.world.cookbook.kinds[primitive_index]), env)\n      actions.extend(collect_actions)\n      \n      # Update the inventory after collecting (assuming collection is successful)\n      env._current_state.inventory[primitive_index] += 1\n      required_count -= 1\n  \n  # Go to the workshop and craft the item\n  if workshop_required:\n    move_to_workshop_actions = move_to(env, workshop_required)\n    actions.extend(move_to_workshop_actions)\n    \n    # Use the USE action at the workshop (assuming facing the correct direction)\n    actions.append(4)  # Assuming 4 is the USE action\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-10T16:25:06.129612", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n\n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = env._current_state.inventory.copy()\n\n  # Check if all ingredients are available\n  required_ingredients = {cookbook.index[k]: v for k, v in recipe.items()}\n\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if not can_craft:\n    return []\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No available workshop to craft item\")\n\n  # Select the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n  # Calculate actions to move the agent to the nearest workshop\n  dx = nearest_workshop_pos[0] - current_position[0]\n  dy = nearest_workshop_pos[1] - current_position[1]\n\n  actions_to_take = []\n\n  if dx > 0:\n    actions_to_take.extend([craft.MOVE_RIGHT for _ in range(dx)])\n  elif dx < 0:\n    actions_to_take.extend([craft.MOVE_LEFT for _ in range(-dx)])\n\n  if dy > 0:\n    actions_to_take.extend([craft.MOVE_DOWN for _ in range(dy)])\n  elif dy < 0:\n    actions_to_take.extend([craft.MOVE_UP for _ in range(-dy)])\n\n  # Calculate the target direction to face the workshop\n  current_direction = env._current_state.dir\n\n  if dx == 0 and dy == 0:  # Already at the workshop\n      pass\n  elif abs(dx) > abs(dy):  # Prioritize horizontal movement\n      while current_direction != (craft.RIGHT if dx > 0 else craft.LEFT):\n          actions_to_take.append(craft.TURN_RIGHT)\n          current_direction = (current_direction + 1) % 4\n  else:  # Prioritize vertical movement\n      while current_direction != (craft.DOWN if dy > 0 else craft.UP):\n          actions_to_take.append(craft.TURN_LEFT)\n          current_direction = (current_direction - 1) % 4\n\n  # Ensure the agent faces directly towards the workshop cell\n  target_direction = None\n  if dx == 0 and dy > 0:\n      target_direction = craft.DOWN\n  elif dx == 0 and dy < 0:\n      target_direction = craft.UP\n  elif dx > 0 and dy == 0:\n      target_direction = craft.RIGHT\n  elif dx < 0 and dy == 0:\n      target_direction = craft.LEFT\n\n  if target_direction is not None and current_direction != target_direction:\n      while current_direction != target_direction:\n          actions_to_take.append(craft.TURN_RIGHT)\n          current_direction = (current_direction + 1) % 4\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T16:25:07.231701", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = env._current_state.inventory.copy()\n\n  # Check if all ingredients are available\n  required_ingredients = {cookbook.index[k]: v for k, v in recipe.items()}\n\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if not can_craft:\n    return []\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No available workshop to craft item\")\n\n  # Select the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n  # Calculate actions to move the agent to the nearest workshop\n  dx = nearest_workshop_pos[0] - current_position[0]\n  dy = nearest_workshop_pos[1] - current_position[1]\n\n  actions_to_take = []\n\n  # Move in a direction that prioritizes reaching the target cell with minimal turns\n  while dx != 0 or dy != 0:\n    if abs(dx) >= abs(dy):  # Prioritize horizontal movement\n      move_dir = craft.MOVE_RIGHT if dx > 0 else craft.MOVE_LEFT\n      current_position[0] += (1 if dx > 0 else -1)\n      dx -= (1 if dx > 0 else -1)\n    else:  # Prioritize vertical movement\n      move_dir = craft.MOVE_DOWN if dy > 0 else craft.MOVE_UP\n      current_position[1] += (1 if dy > 0 else -1)\n      dy -= (1 if dy > 0 else -1)\n\n    actions_to_take.append(move_dir)\n\n  # Ensure the agent faces directly towards the workshop cell\n  target_direction = None\n  if dx == 0 and dy > 0:\n      target_direction = craft.DOWN\n  elif dx == 0 and dy < 0:\n      target_direction = craft.UP\n  elif dx > 0 and dy == 0:\n      target_direction = craft.RIGHT\n  elif dx < 0 and dy == 0:\n      target_direction = craft.LEFT\n\n  current_direction = env._current_state.dir\n  if target_direction is not None and current_direction != target_direction:\n    while current_direction != target_direction:\n        actions_to_take.append(craft.TURN_RIGHT)\n        current_direction = (current_direction + 1) % 4\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T16:26:34.450237", "function_name": "craft", "function_body": "  # Get the index of the item to craft\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we already have the item in our inventory\n  if env._current_state.inventory[item_index] > 0:\n    return []\n  \n  # Fetch the primitives required for crafting the item\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  \n  # If no primitives are needed, return an empty list (shouldn't happen with valid recipes)\n  if not primitives_needed:\n    return []\n\n  actions = []\n  collected_primitives = set()\n  \n  # Collect all required primitives\n  for primitive_name, count in primitives_needed.items():\n    primitive_index = env.world.cookbook.index[primitive_name]\n    \n    # Check if the agent already has enough of this primitive in their inventory\n    if env._current_state.inventory[primitive_index] >= count:\n      continue\n    \n    # Determine if the primitive is a natural resource or needs crafting\n    if primitive_index in env.world.grabbable_indices:\n      actions.extend(collect(env, primitive_name))\n      collected_primitives.add(primitive_index)\n    \n    else:\n      # Recursively craft the primitive\n      actions.extend(craft_v2(env, primitive_name))\n  \n  # Ensure all required primitives are collected before proceeding to crafting\n  if not all(env._current_state.inventory[primitive] >= count for primitive, count in primitives_needed.items()):\n    return []\n  \n  # Navigate to the workshop and perform the USE action to craft the item\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_name = recipe[\"_key\"]\n  workshop_index = env.world.workshop_indices[worKshop_name]\n\n  actions.extend(navigate_and_craft(env, workshop_index))\n  \n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-10T16:26:35.446121", "function_name": "craft", "function_body": "  actions = []\n\n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the required primitives for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  \n  # Collect missing primitives\n  for primitive_index, count in required_primitives.items():\n      primitive_name = env.world.cookbook.index.get(primitive_index)\n      \n      # Find positions of the primitive on the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] > 0)\n\n      if len(primitive_positions) == 0:\n          print(f\"No {primitive_name} found on the grid.\")\n          return []  # Return empty list if no primitives are available\n      \n      for _ in range(count):\n          for pos in primitive_positions:\n              x, y = pos\n              \n              # Calculate direction to move towards the primitive\n              dx, dy = x - env._current_state.pos[0], y - env._current_state.pos[1]\n              if dx > 0:\n                  actions.extend([craft.DOWN] * abs(dx))\n              elif dx < 0:\n                  actions.extend([craft.UP] * abs(dx))\n              if dy > 0:\n                  actions.extend([craft.RIGHT] * abs(dy))\n              elif dy < 0:\n                  actions.extend([craft.LEFT] * abs(dy))\n              \n              # Perform USE action to collect the primitive\n              actions.append(craft.USE)\n              \n              # Update grid and inventory after collecting (simulating step results)\n              env._current_state.grid[x, y, primitive_index] = 0\n              env._current_state.inventory[primitive_index] += 1\n  \n  # Find positions of the workshop on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, item_index] > 0)\n  \n  if len(workshop_positions) == 0:\n      print(f\"No workshop for {item} found on the grid.\")\n      return []  # Return empty list if no workshops are available\n  \n  for pos in workshop_positions:\n      x, y = pos\n      \n      # Calculate direction to move towards the workshop\n      dx, dy = x - env._current_state.pos[0], y - env._current_state.pos[1]\n      if dx > 0:\n          actions.extend([craft.DOWN] * abs(dx))\n      elif dx < 0:\n          actions.extend([craft.UP] * abs(dx))\n      if dy > 0:\n          actions.extend([craft.RIGHT] * abs(dy))\n      elif dy < 0:\n          actions.extend([craft.LEFT] * abs(dy))\n      \n      # Perform USE action to craft the item\n      actions.append(craft.USE)\n      \n      # Update inventory after crafting (simulating step results)\n      env._current_state.inventory[item_index] += 1\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-10T16:27:44.223198", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Retrieve the recipe for the item\n  recipe = env.world.cookbook.recipes[item_index]\n  \n  # Check if the agent already has the required ingredients in its inventory\n  missing_ingredients = []\n  for ingredient, count in recipe.items():\n      if ingredient == \"_at\":\n          continue  # Skip the workshop information\n      \n      ingredient_index = env.world.cookbook.index[ingredient]\n      \n      # Check if the agent has enough of this ingredient\n      if env._current_state.inventory[ingredient_index] < count:\n          missing_ingredients.append((ingredient, count))\n  \n  # If there are missing ingredients, return an empty action list for now\n  if missing_ingredients:\n      print(f\"Missing ingredients: {missing_ingredients}\")\n      return []\n  \n  # Find the workshop where the item can be crafted\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n  \n  # Get the position of all workshops in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n      print(f\"No available {workshop_name} found.\")\n      return []\n  \n  # For simplicity, choose the closest workshop to the agent's current position\n  closest_workshop = min(workshop_positions, key=lambda p: np.linalg.norm(np.array(p) - np.array(env._current_state.pos)))\n  \n  # Calculate the actions needed to move to the closest workshop\n  path_to_workshop = find_path(env._current_state.grid, env._current_state.pos, closest_workshop)\n  \n  if not path_to_workshop:\n      print(\"No valid path to the workshop found.\")\n      return []\n  \n  # Actions to move to the workshop\n  actions = [action_index(action) for action in path_to_workshop]\n  \n  # Add the USE action to craft the item\n  actions.append(env.world.cookbook.index[\"USE\"])\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-10T16:27:45.230010", "function_name": "craft", "function_body": "  # Retrieve the index of the goal item\n  idx_goal = env.world.cookbook.index[item]\n  \n  # Check if the item has a recipe in the cookbook\n  if idx_goal not in env.world.cookbook.recipes:\n    return []\n  \n  # Get the list of required ingredients for the item\n  recipe = env.world.cookbook.recipes[idx_goal]\n\n  # Check if we have all the required primitives in our inventory\n  actions_to_take = []\n\n  # Process each ingredient in the recipe\n  for ingredient, count in recipe.items():\n    if ingredient == \"_at\":\n      workshop_type = recipe[\"_at\"]\n      workshop_index = env.world.cookbook.index[workshop_type]\n      continue\n    \n    idx_ingredient = env.world.cookbook.index[ingredient]\n\n    # Check if we have enough of the required primitive\n    while env._current_state.inventory[idx_ingredient] < count:\n      actions_to_take.extend(collect_v2(env, ingredient))\n\n  # Now that we have all ingredients, navigate to the workshop and use it\n  workshop_index = env.world.cookbook.index[recipe[\"_at\"]]\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    return []\n\n  # Choose the closest workshop\n  agent_position = env._current_state.pos\n  closest_workshop_idx = np.argmin(np.linalg.norm(workshop_positions - agent_position, axis=1))\n  closest_workshop_pos = tuple(workshop_positions[closest_workshop_idx])\n\n  # Move to the closest workshop\n  actions_to_take.extend(move_v2(env, closest_workshop_pos))\n\n  # Use the workshop to craft the item\n  actions_to_take.append(env.world.N_ACTIONS - 1)  # Assuming USE action is the last action\n\n  return actions_to_take", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-10T16:31:01.210000", "function_name": "craft", "function_body": "  def _move_to_position(target_pos):\n      # Find the path to the target position using A* search\n      start = env._current_state.pos\n      \n      def heuristic(a, b):\n          return abs(a[0] - b[0]) + abs(a[1] - b[1])\n      \n      open_set = collections.PriorityQueue()\n      open_set.put((0, start))\n      came_from = {}\n      g_score = {start: 0}\n      \n      while not open_set.empty():\n          _, current = open_set.get()\n          \n          if current == target_pos:\n              path = []\n              while current in came_from:\n                  path.append(current)\n                  current = came_from[current]\n              path.reverse()\n              actions = _convert_path_to_actions(path, start)\n              return actions\n          \n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              if 0 <= neighbor[0] < env.world.WIDTH and 0 <= neighbor[1] < env.world.HEIGHT:\n                  tentative_g_score = g_score[current] + 1\n                  if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                      came_from[neighbor] = current\n                      g_score[neighbor] = tentative_g_score\n                      f_score = tentative_g_score + heuristic(neighbor, target_pos)\n                      open_set.put((f_score, neighbor))\n      \n      return []\n  \n  def _convert_path_to_actions(path, start):\n      actions = []\n      cx, cy = start\n      \n      for x, y in path:\n          if cx < x:\n              actions.append(craft.RIGHT)\n          elif cx > x:\n              actions.append(craft.LEFT)\n          if cy < y:\n              actions.append(craft.DOWN)\n          elif cy > y:\n              actions.append(craft.UP)\n          cx, cy = x, y\n      \n      return actions\n  \n  def _has_required_primitives(primitive_indices):\n      for i in primitive_indices:\n          if env._current_state.inventory[i] <= 0:\n              return False\n      return True\n\n  index = env.world.cookbook.index\n  item_index = index[item]\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n\n  actions = []\n\n  # Check if the recipe exists and has a key\n  if \"_key\" in recipe:\n      key_index = recipe[\"_key\"]\n      workshop_index = env.world.workshop_indices[key_index]\n      \n      if not _has_required_primitives([i for i in recipe if i != \"_key\"]):\n          return []\n      \n      # Find all positions of the required workshop\n      workshop_positions = []\n      for x in range(env.world.WIDTH):\n          for y in range(env.world.HEIGHT):\n              if np.any(env._current_state.grid[x, y] == workshop_index):\n                  workshop_positions.append((x, y))\n      \n      if not workshop_positions:\n          return []  # No workshops found\n      \n      # Move to the nearest workshop\n      actions_to_workshop = None\n      closest_distance = float('inf')\n      \n      for wp in workshop_positions:\n          distance = abs(wp[0] - env._current_state.pos[0]) + abs(wp[1] - env._current_state.pos[1])\n          if distance < closest_distance:\n              actions_to_workshop = _move_to_position(wp)\n              closest_distance = distance\n      \n      # Ensure the agent is facing the correct direction to use the workshop\n      target_pos = None\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          neighbor_pos = (env._current_state.pos[0] + dx, env._current_state.pos[1] + dy)\n          if 0 <= neighbor_pos[0] < env.world.WIDTH and 0 <= neighbor_pos[1] < env.world.HEIGHT:\n              if np.any(env._current_state.grid[neighbor_pos[0], neighbor_pos[1]] == workshop_index):\n                  target_pos = neighbor_pos\n                  break\n      \n      if not target_pos:\n          return []  # No valid target position found\n      \n      direction_to_target = (target_pos[0] - env._current_state.pos[0], target_pos[1] - env._current_state.pos[1])\n      \n      if direction_to_target == (-1, 0):\n          actions_to_workshop.append(craft.LEFT)\n      elif direction_to_target == (1, 0):\n          actions_to_workshop.append(craft.RIGHT)\n      elif direction_to_target == (0, -1):\n          actions_to_workshop.append(craft.UP)\n      elif direction_to_target == (0, 1):\n          actions_to_workshop.append(craft.DOWN)\n      \n      # Finally, add the USE action\n      actions_to_workshop.append(craft.USE)\n      return actions_to_workshop\n  \n  else:\n      return []  # No recipe found for the item", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T16:31:02.254666", "function_name": "craft", "function_body": "  def _move_to_position(target_pos):\n      # Find the path to the target position using A* search\n      start = env._current_state.pos\n      \n      def heuristic(a, b):\n          return abs(a[0] - b[0]) + abs(a[1] - b[1])\n      \n      open_set = collections.PriorityQueue()\n      open_set.put((0, start))\n      came_from = {}\n      g_score = {start: 0}\n      \n      while not open_set.empty():\n          _, current = open_set.get()\n          \n          if current == target_pos:\n              path = []\n              while current in came_from:\n                  path.append(current)\n                  current = came_from[current]\n              path.reverse()\n              actions = _convert_path_to_actions(path, start)\n              return actions\n          \n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              if 0 <= neighbor[0] < env.world.WIDTH and 0 <= neighbor[1] < env.world.HEIGHT:\n                  tentative_g_score = g_score[current] + 1\n                  if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                      came_from[neighbor] = current\n                      g_score[neighbor] = tentative_g_score\n                      f_score = tentative_g_score + heuristic(neighbor, target_pos)\n                      open_set.put((f_score, neighbor))\n      \n      return []\n  \n  def _convert_path_to_actions(path, start):\n      actions = []\n      cx, cy = start\n      \n      for x, y in path:\n          if cx < x:\n              actions.append(craft.RIGHT)\n          elif cx > x:\n              actions.append(craft.LEFT)\n          if cy < y:\n              actions.append(craft.DOWN)\n          elif cy > y:\n              actions.append(craft.UP)\n          cx, cy = x, y\n      \n      return actions\n  \n  def _has_required_primitives(primitive_indices):\n      for i in primitive_indices:\n          if env._current_state.inventory[i] <= 0:\n              return False\n      return True\n\n  index = env.world.cookbook.index\n  item_index = index[item]\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n\n  actions = []\n\n  # Check if the recipe exists and has a key\n  if \"_key\" in recipe:\n      key_index = recipe[\"_key\"]\n      workshop_index = env.world.workshop_indices[key_index]\n      \n      if not _has_required_primitives([i for i in recipe if i != \"_key\"]):\n          return []\n      \n      # Find all positions of the required workshop\n      workshop_positions = []\n      for x in range(env.world.WIDTH):\n          for y in range(env.world.HEIGHT):\n              if np.any(env._current_state.grid[x, y] == workshop_index):\n                  workshop_positions.append((x, y))\n      \n      if not workshop_positions:\n          return []  # No workshops found\n      \n      # Move to the nearest workshop\n      actions_to_workshop = None\n      closest_distance = float('inf')\n      \n      for wp in workshop_positions:\n          distance = abs(wp[0] - env._current_state.pos[0]) + abs(wp[1] - env._current_state.pos[1])\n          if distance < closest_distance:\n              actions_to_workshop = _move_to_position(wp)\n              closest_distance = distance\n      \n      if not actions_to_workshop:\n          return []  # No path to any workshop found\n      \n      # Ensure the agent is facing the correct direction to use the workshop\n      target_pos = None\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          neighbor_pos = (env._current_state.pos[0] + dx, env._current_state.pos[1] + dy)\n          if 0 <= neighbor_pos[0] < env.world.WIDTH and 0 <= neighbor_pos[1] < env.world.HEIGHT:\n              if np.any(env._current_state.grid[neighbor_pos[0], neighbor_pos[1]] == workshop_index):\n                  target_pos = neighbor_pos\n                  break\n      \n      if not target_pos:\n          return []  # No valid target position found\n      \n      direction_to_target = (target_pos[0] - env._current_state.pos[0], target_pos[1] - env._current_state.pos[1])\n      \n      if direction_to_target == (-1, 0):\n          actions.append(craft.LEFT)\n      elif direction_to_target == (1, 0):\n          actions.append(craft.RIGHT)\n      elif direction_to_target == (0, -1):\n          actions.append(craft.UP)\n      elif direction_to_target == (0, 1):\n          actions.append(craft.DOWN)\n      \n      # Finally, add the USE action\n      actions.extend(actions_to_workshop + [craft.USE])\n      return actions\n  \n  else:\n      return []  # No recipe found for the item", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T16:31:48.100104", "function_name": "craft", "function_body": "  # Get the index of the item from the cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the required primitives for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  \n  # Collect missing primitives\n  actions = []\n  inventory = env._current_state.inventory\n  \n  # Collecting primitives that are not already in inventory\n  for primitive, count in required_primitives.items():\n    if inventory[primitive] < count:\n      actions.extend(collect_v1(env, primitive))\n      \n  # Now move to the workshop and craft the item\n  workshop = env.world.cookbook.recipes[item_index].get(\"_at\")\n  \n  if workshop is not None:\n    # Move to the corresponding workshop\n    workshop_index = env.world.cookbook.index[workshop]\n    actions.extend(move_to_workshop_v1(env, workshop_index))\n    \n    # Use action to craft the item\n    actions.append(4)  # Assuming USE action is indexed as 4\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-10T16:31:49.069320", "function_name": "craft", "function_body": "  actions = []\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item\n  goal_index = cookbook.index[item]\n\n  # Check if there's a recipe for this item\n  if goal_index not in cookbook.recipes:\n    print(f\"No recipe found for {item}.\")\n    return []\n\n  # Determine the required primitives and their counts\n  recipe = cookbook.recipes[goal_index]\n  required_primitives = {}\n\n  for ingredient, count in recipe.items():\n    if ingredient == \"_at\":\n      continue\n    elif ingredient.startswith(\"_\"):\n      print(f\"Unknown ingredient type: {ingredient}\")\n      return []\n    else:\n      required_primitives[cookbook.index[ingredient]] = count\n\n  # Check inventory and collect missing primitives\n  for primitive_index, required_count in required_primitives.items():\n    if env._current_state.inventory[primitive_index] < required_count:\n      actions.extend(collect_v1(env, cookbook.get(primitive_index)))\n\n  # Craft the item at the specified workshop\n  if \"_at\" not in recipe:\n    print(\"No workshop specified for crafting.\")\n    return []\n\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.workshop_indices[env.world.cookbook.index[workshop_name]]\n\n  # Find the position of the nearest workshop\n  target_pos, direction = find_nearest_workshop(env._current_state, workshop_index)\n\n  if target_pos is None:\n    print(f\"No reachable {workshop_name} found.\")\n    return []\n\n  actions.extend(navigate_to_position(env._current_state, target_pos, direction))\n  actions.append(craft.use_action())  # Assuming USE action is the one to craft\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-10T16:32:42.893793", "function_name": "craft", "function_body": "  # Check if we have all primitives required for crafting\n  goal_index = env.world.cookbook.index[item]\n  if goal_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n  \n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  \n  # Check if the agent has the required primitives in its inventory\n  for primitive, count in required_primitives.items():\n    if env._current_state.inventory[primitive] < count:\n      return []  # Not enough primitives to craft the item\n  \n  # Get the workshop index where crafting should occur\n  recipe = env.world.cookbook.recipes[goal_index]\n  workshop_name = list(recipe.values())[0][\"_at\"]\n  workshop_index = env.world.workshop_indices[env.world.cookbook.index[workshop_name]]\n  \n  # Find the nearest workshop of the required type\n  actions_to_workshop = move_to(env._current_state, workshop_index)\n  if not actions_to_workshop:\n    return []  # No valid path to the workshop\n  \n  # Craft the item by performing USE action at the workshop\n  actions_to_use = [craft.USE]\n  \n  return actions_to_workshop + actions_to_use", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-10T16:32:43.859764", "function_name": "craft", "function_body": "  # Initialize the list of actions\n  actions = []\n\n  # Get the index of the desired item from the cookbook\n  item_index = env.world.cookbook.index[item]\n\n  # Check if there is a recipe for the item\n  if item_index not in env.world.cookbook.recipes:\n    print(f\"No recipe found for {item}\")\n    return actions\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Extract the ingredients and workshop from the recipe\n  ingredients = {k: v for k, v in recipe.items() if k != \"_key\" and k != \"_at\"}\n  workshop_key = \"_at\"\n  workshop_name = recipe.get(workshop_key)\n\n  # If no workshop is specified, we cannot craft this item here\n  if not workshop_name:\n    print(f\"No workshop specified for {item}\")\n    return actions\n\n  # Get the index of the workshop\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the workshop in the grid\n  workshop_pos = None\n  for y in range(env._current_state.grid.shape[0]):\n    for x in range(env._current_state.grid.shape[1]):\n      if env._current_state.grid[y, x, workshop_index] == 1:\n        workshop_pos = (x, y)\n        break\n    if workshop_pos:\n      break\n\n  # If no workshop is found, return empty actions\n  if not workshop_pos:\n    print(f\"No {workshop_name} found in the grid\")\n    return actions\n\n  # Check if we have all required ingredients\n  inventory = env._current_state.inventory\n  missing_ingredients = []\n  for ingredient_name, count in ingredients.items():\n    ingredient_index = env.world.cookbook.index[ingredient_name]\n    if inventory[ingredient_index] < count:\n      missing_ingredients.append((ingredient_name, count - inventory[ingredient_index]))\n\n  # If we are missing any ingredients, return empty actions\n  if missing_ingredients:\n    print(f\"Missing ingredients: {missing_ingredients}\")\n    return actions\n\n  # Calculate the direction to face the workshop\n  agent_pos = env._current_state.pos\n  target_dir = None\n  for i, dir_vector in enumerate([(0, -1), (0, 1), (-1, 0), (1, 0)]):  # UP, DOWN, LEFT, RIGHT\n    if tuple(np.add(agent_pos, dir_vector)) == workshop_pos:\n      target_dir = i\n      break\n\n  # If no valid direction to face the workshop is found, return empty actions\n  if target_dir is None:\n    print(\"No valid direction to face the workshop\")\n    return actions\n\n  # Add actions to move towards the workshop and then use it\n  actions.extend(move_to(env._current_state, workshop_pos))\n  actions.append(target_dir)  # Set direction to face the workshop\n  actions.append(4)  # USE action\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-10T16:33:43.889188", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index of the item from the cookbook\n  item_idx = env.world.cookbook.index[item]\n  \n  # Check if we already have the item in our inventory\n  if env._current_state.inventory[item_idx] > 0:\n      return actions  # No need to craft, already have it\n\n  # Get the recipe for the item (outputs required ingredients and workshop)\n  recipe = env.world.cookbook.recipes[item_idx]\n\n  # Check if all ingredients are available in inventory\n  missing_ingredients = []\n  for ingredient, count in recipe.items():\n      if ingredient == \"_key\":\n          continue  # Skip _key which indicates the workshop\n\n      # Get the index of the ingredient from the cookbook\n      ingredient_idx = env.world.cookbook.index[ingredient]\n\n      # Check if we have enough of this ingredient in our inventory\n      if env._current_state.inventory[ingredient_idx] < count:\n          missing_ingredients.append(ingredient)\n  \n  # If there are missing ingredients, we need to collect them first\n  for ingredient in missing_ingredients:\n      ingredient_idx = env.world.cookbook.index[ingredient]\n      \n      # Find the position of the ingredient on the grid\n      positions = np.argwhere(env._current_state.grid[:, :, ingredient_idx] > 0)\n      if len(positions) == 0:\n          print(f\"Ingredient {ingredient} not found in the environment.\")\n          continue\n      \n      # Add actions to move to and collect the ingredient\n      for pos in positions:\n          x, y = pos\n          \n          # Calculate the difference in position\n          dx = x - env._current_state.pos[0]\n          dy = y - env._current_state.pos[1]\n          \n          # Add movement actions based on the differences\n          if dx < 0:\n              actions.extend([env.world.N_ACTIONS.LEFT] * abs(dx))\n          elif dx > 0:\n              actions.extend([env.world.N_ACTIONS.RIGHT] * abs(dx))\n          \n          if dy < 0:\n              actions.extend([env.world.N_ACTIONS.UP] * abs(dy))\n          elif dy > 0:\n              actions.extend([env.world.N_ACTIONS.DOWN] * abs(dy))\n          \n          # Add action to collect the ingredient\n          actions.append(env.world.N_ACTIONS.USE)\n  \n  # Find the position of the workshop required for crafting\n  workshop = recipe[\"_key\"]\n  workshop_idx = env.world.cookbook.index[workshop]\n  positions = np.argwhere(env._current_state.grid[:, :, workshop_idx] > 0)\n\n  if len(positions) == 0:\n      print(f\"Workshop {workshop} not found in the environment.\")\n      return actions\n  \n  # Add actions to move to the workshop\n  for pos in positions:\n      x, y = pos\n      \n      # Calculate the difference in position\n      dx = x - env._current_state.pos[0]\n      dy = y - env._current_state.pos[1]\n      \n      # Add movement actions based on the differences\n      if dx < 0:\n          actions.extend([env.world.N_ACTIONS.LEFT] * abs(dx))\n      elif dx > 0:\n          actions.extend([env.world.N_ACTIONS.RIGHT] * abs(dx))\n      \n      if dy < 0:\n          actions.extend([env.world.N_ACTIONS.UP] * abs(dy))\n      elif dy > 0:\n          actions.extend([env.world.N_ACTIONS.DOWN] * abs(dy))\n      \n      # Add action to use the workshop\n      actions.append(env.world.N_ACTIONS.USE)\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-10T16:33:44.845690", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index of the desired item\n  item_idx = env.world.cookbook.index[item]\n  \n  # Check if we have all the items/primitives required for crafting\n  recipe = env.world.cookbook.recipes.get(item_idx, {})\n  if not recipe:\n    return actions\n  \n  # Collect all the ingredients needed\n  for ingredient, count in recipe.items():\n      if ingredient == \"_at\":\n          continue  # Skip the \"_at\" key which specifies the workshop\n      \n      required_amount = count\n      \n      while env._current_state.inventory[ingredient] < required_amount:\n          primitive_name = env.world.cookbook.index.get(ingredient, None)\n          if not primitive_name:\n              return actions\n          \n          actions.extend(collect(env, primitive_name))\n  \n  # Once all ingredients are collected, move to the workshop and craft the item\n  workshop = recipe.get(\"_at\", None)\n  if workshop:\n      workshop_idx = env.world.cookbook.index[workshop]\n      \n      for workshop_pos in np.argwhere(env._current_state.grid[:, :, workshop_idx]):\n          actions.extend(move_to(env, tuple(workshop_pos)))\n          actions.append(craft_action(item))\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-10T16:35:03.670091", "function_name": "craft", "function_body": "  # Get the index for the desired item\n  goal_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the primitives required to craft the item\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  \n  actions = []\n\n  # Helper function to move the agent to a specified position and direction\n  def navigate_to(pos, dir):\n    current_pos = env._current_state.pos\n    current_dir = env._current_state.dir\n    \n    if current_dir != dir:\n      # Calculate the number of rotations needed to face the correct direction\n      rotations_needed = (dir - current_dir) % 4\n      for _ in range(rotations_needed):\n        actions.append(env.world.cookbook.index['RIGHT'])\n    \n    # Move towards the target position\n    while current_pos != pos:\n      if current_pos[0] < pos[0]:\n        actions.append(env.world.cookbook.index['DOWN'])\n        current_pos = (current_pos[0] + 1, current_pos[1])\n      elif current_pos[0] > pos[0]:\n        actions.append(env.world.cookbook.index['UP'])\n        current_pos = (current_pos[0] - 1, current_pos[1])\n      elif current_pos[1] < pos[1]:\n        actions.append(env.world.cookbook.index['RIGHT'])\n        current_pos = (current_pos[0], current_pos[1] + 1)\n      elif current_pos[1] > pos[1]:\n        actions.append(env.world.cookbook.index['LEFT'])\n        current_pos = (current_pos[0], current_pos[1] - 1)\n\n  # Helper function to collect all required primitives\n  def collect_primitives(required):\n    for primitive, count in required.items():\n      while env._current_state.inventory[primitive] < count:\n        # Find the position of the primitive on the grid\n        pos = None\n        for x in range(env._current_state.grid.shape[0]):\n          for y in range(env._current_state.grid.shape[1]):\n            if env._current_state.grid[x, y, primitive] > 0:\n              pos = (x, y)\n              break\n          if pos is not None:\n            break\n        \n        if pos is None:\n          return False  # Primitive not found on the grid\n        \n        # Navigate to the position of the primitive\n        navigate_to(pos, env.world.cookbook.index['UP'])  # Assume we face up when collecting primitives\n        \n        # Collect the primitive\n        actions.append(env.world.cookbook.index['USE'])\n    \n    return True\n\n  # Check if all required primitives are collected\n  if not collect_primitives(required_primitives):\n    return []  # Cannot craft item as primitives are missing\n  \n  # Find the workshop specified in the recipe for crafting the item\n  recipe = env.world.cookbook.recipes[goal_index]\n  workshop_index = None\n  for key, value in recipe.items():\n    if key == \"_key\":\n      workshop_index = value\n  \n  if workshop_index is None:\n    return []  # Workshop not specified in the recipe\n\n  # Navigate to the workshop and craft the item\n  workshop_pos = None\n  for x in range(env._current_state.grid.shape[0]):\n    for y in range(env._current_state.grid.shape[1]):\n      if env._current_state.grid[x, y, workshop_index] > 0:\n        workshop_pos = (x, y)\n        break\n    if workshop_pos is not None:\n      break\n\n  if workshop_pos is None:\n    return []  # Workshop not found on the grid\n\n  # Navigate to the position of the workshop\n  navigate_to(workshop_pos, env.world.cookbook.index['UP'])  # Assume we face up when using the workshop\n  \n  # Craft the item\n  actions.append(env.world.cookbook.index['USE'])\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-10T16:35:04.638312", "function_name": "craft", "function_body": "  # Convert item name to its index using the cookbook\n  if not isinstance(item, int):\n    item_index = env.world.cookbook.index[item]\n  else:\n    item_index = item\n\n  actions = []\n\n  # Check if we have all the primitives required for crafting\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n\n  inventory = env._current_state.inventory\n\n  missing_primitives = {}\n  for primitive, count in primitives_required.items():\n      if inventory[primitive] < count:\n          missing_primitives[primitive] = count - inventory[primitive]\n\n  # If there are missing primitives, we need to collect them first\n  if missing_primitives:\n    return actions\n\n  # If all primitives are available, proceed to the workshop and craft the item\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_index = None\n\n  for key, value in recipe.items():\n      if key.startswith(\"_at\"):\n          workshop_index = env.world.cookbook.index[value]\n\n  if not workshop_index:\n    raise ValueError(f\"No workshop specified for crafting {item}\")\n\n  # Find the position of the workshop\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"Workshop not found in the grid\")\n\n  # Assuming there's only one workshop, take the first position\n  target_workshop_position = tuple(workshop_positions[0])\n\n  # Move to the workshop\n  actions.extend(move_to_target(env._current_state.pos, target_workshop_position))\n\n  # Turn to face the workshop (assuming facing up initially)\n  current_direction = env._current_state.dir\n  required_direction = direction_towards(env._current_state.pos, target_workshop_position)\n\n  if required_direction != current_direction:\n    actions.append(direction_to_action(required_direction))\n\n  # Use action to craft the item\n  actions.append(4)  # USE action\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-10T16:35:59.669870", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  goal_index = env.world.cookbook.index[item]\n\n  # Check if we already have the item in our inventory\n  if env._current_state.inventory[goal_index] > 0:\n    return []\n\n  # Get the primitives required to craft the item\n  primitives_required = env.world.cookbook.primitives_for(goal_index)\n\n  actions = []\n  \n  # First, collect all the required primitives\n  for primitive_index, count in primitives_required.items():\n      primitive_name = env.world.cookbook.index.get(primitive_index)\n      \n      if env._current_state.inventory[primitive_index] >= count:\n          continue\n      \n      # Find where to collect the primitives\n      while not env._current_state.next_to(primitive_index):\n          # Randomly move until we find a place with the primitive\n          actions.extend([np.random.choice([craft.LEFT, craft.RIGHT, craft.UP, craft.DOWN])])\n      \n      # Collect the required amount of primitives\n      for _ in range(count - env._current_state.inventory[primitive_index]):\n          actions.append(craft.USE)\n  \n  # Now we need to go to the workshop and craft the item\n  workshop_index = None\n  recipe = env.world.cookbook.recipes.get(goal_index, {})\n  \n  for ingredient, count in recipe.items():\n      if ingredient == \"_at\":\n          workshop_name = recipe[\"_at\"]\n          workshop_index = env.world.cookbook.index[workshop_name]\n          break\n  \n  # Navigate to the workshop\n  # For simplicity, we will assume that the agent can move directly to the nearest workshop location.\n  # In a real implementation, you would need an A* or similar pathfinding algorithm.\n  if workshop_index is not None:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n      \n      if len(workshop_positions) == 0:\n          return []  # No available workshops to craft the item\n      \n      nearest_workshop_pos = min(workshop_positions, key=lambda pos: np.linalg.norm(np.array(pos) - np.array(env._current_state.pos)))\n      \n      while env._current_state.pos != tuple(nearest_workshop_pos):\n          # Calculate direction vector\n          direction_vector = nearest_workshop_pos - np.array(env._current_state.pos)\n          \n          # Determine the best action based on direction vector\n          if direction_vector[0] < 0:\n              actions.append(craft.LEFT)\n          elif direction_vector[0] > 0:\n              actions.append(craft.RIGHT)\n          if direction_vector[1] < 0:\n              actions.append(craft.DOWN)\n          elif direction_vector[1] > 0:\n              actions.append(craft.UP)\n      \n      # Once at the workshop, use the USE action to craft the item\n      actions.append(craft.USE)\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-10T16:36:00.628060", "function_name": "craft", "function_body": "  actions = []\n  current_state = env._current_state\n  cookbook = current_state.world.cookbook\n\n  # Resolve the item index from its name\n  item_index = cookbook.index[item]\n\n  # Check if the required primitives for crafting are in inventory or available on the grid.\n  required_primitives = cookbook.primitives_for(item_index)\n\n  # Collect missing primitives first, if necessary.\n  if required_primitives:\n    for primitive, count in required_primitives.items():\n      while current_state.inventory[primitive] < count:\n        actions.extend(collect(env, cookbook.index.get(primitive)))\n\n  # Move to the workshop and use it to craft the item.\n  workshop_index = None\n  for ingredient, count in cookbook.recipes[item_index].items():\n    if \"_at\" in cookbook.recipes[item_index]:\n      workshop_index = cookbook.index[cookbook.recipes[item_index][\"_at\"]]\n      break\n\n  if workshop_index is not None:\n    # Find the position of the workshop.\n    grid = current_state.grid\n    workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n    if len(workshop_positions) > 0:\n      workshop_pos = tuple(workshop_positions[0])\n\n      # Move to the workshop position.\n      actions.extend(move_to(env, workshop_pos))\n\n      # Face the correct direction towards the workshop and use it.\n      # Assuming the agent faces right (direction 3).\n      actions.append(4)  # USE action\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-10T16:37:22.291885", "function_name": "craft", "function_body": "  actions = []\n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we already have the required item in inventory or if it's a primitive\n  if env._current_state.inventory[item_index] > 0 or item_index in env.world.grabbable_indices:\n    return actions\n  \n  # Get all primitives needed to craft this item recursively\n  primitives_needed = get_primitives_recursively(env, item_index)\n  \n  # Collect all the required primitives\n  for primitive, count in primitives_needed.items():\n      actions.extend(collect_v2(env, env.world.cookbook.index.get(primitive)))\n      \n  # Determine the workshop to use based on the recipe\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_name = list(recipe[\"_key\"].split(\"_at=\"))[1] if \"_key\" in recipe else None\n  \n  # If we have a valid workshop, proceed to it\n  if workshop_name:\n      workshop_indices = [idx for idx, name in enumerate(env.world.workshop_indices) \n                          if workshop_name in env.world.cookbook.index.get(name)]\n      \n      # Find the closest workshop of the desired type\n      closest_workshop_index = find_closest_workshop(env._current_state.pos, workshop_indices)\n      \n      # Move to the closest workshop and align direction correctly before using\n      actions.extend(move_to_workshop_and_align_direction(env._current_state, closest_workshop_index))\n      \n      # Craft the item at the workshop\n      actions.append(craft.USE)\n  \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T16:37:23.262941", "function_name": "craft", "function_body": "  def find_closest_workshop(pos, workshop_indices):\n    min_distance = float('inf')\n    closest_index = None\n    for idx in workshop_indices:\n      pos_idx = env.world.cookbook.index.get(idx)\n      distance = np.linalg.norm(np.array(pos) - np.array(env._current_state.grid[:, :, pos_idx].nonzero()))\n      if distance < min_distance:\n        min_distance = distance\n        closest_index = idx\n    return closest_index\n\n  def move_to_workshop_and_align_direction(state, workshop_index):\n    # Find the position of all instances of the workshop type on the grid\n    workshop_positions = np.argwhere(state.grid[:, :, workshop_index] == 1)\n    \n    # Calculate distances to each instance and choose the closest one\n    distances = [np.linalg.norm(np.array(workshop_pos) - np.array(state.pos)) for workshop_pos in workshop_positions]\n    closest_workshop_pos = workshop_positions[np.argmin(distances)]\n    \n    # Generate actions to move the agent to this position\n    actions = []\n    while state.pos != tuple(closest_workshop_pos):\n      dx, dy = closest_workshop_pos[0] - state.pos[0], closest_workshop_pos[1] - state.pos[1]\n      if abs(dx) > abs(dy):\n        actions.append(craft.MOVE_FUNC('RIGHT' if dx > 0 else 'LEFT'))\n      else:\n        actions.append(craft.MOVE_FUNC('DOWN' if dy > 0 else 'UP'))\n      \n    # Align the agent's direction to face the workshop\n    if state.pos[0] == closest_workshop_pos[0]:\n      actions.append(craft.MOVE_FUNC('RIGHT' if closest_workshop_pos[1] > state.pos[1] else 'LEFT'))\n    elif state.pos[1] == closest_workshop_pos[1]:\n      actions.append(craft.MOVE_FUNC('DOWN' if closest_workshop_pos[0] > state.pos[0] else 'UP'))\n    \n    return actions\n\n  actions = []\n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we already have the required item in inventory or if it's a primitive\n  if env._current_state.inventory[item_index] > 0:\n    return actions\n  \n  # Get all primitives needed to craft this item\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  \n  # Collect all the required primitives\n  for primitive, count in primitives_needed.items():\n      actions.extend(collect_v2(env, primitive))\n      \n  # Determine the workshop to use based on the recipe\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_name = list(recipe[\"_key\"].split(\"_at=\"))[1] if \"_key\" in recipe else None\n  \n  # If we have a valid workshop, proceed to it\n  if workshop_name:\n      workshop_indices = [idx for idx, name in enumerate(env.world.workshop_indices) \n                          if workshop_name in env.world.cookbook.index.get(name)]\n      \n      # Find the closest workshop of the desired type\n      closest_workshop_index = find_closest_workshop(state.pos, workshop_indices)\n      \n      # Move to the closest workshop and align direction correctly before using\n      actions.extend(move_to_workshop_and_align_direction(state, closest_workshop_index))\n      \n      # Craft the item at the workshop\n      actions.append(craft.USE)\n  \n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-10T16:38:24.651336", "function_name": "craft", "function_body": "  # Check if we have all required items/primitives for crafting\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  primitives_needed = cookbook.primitives_for(item_index)\n\n  actions = []\n\n  # Check inventory to see if we already have the required primitives or other crafted items\n  current_inventory = env._current_state.inventory\n\n  for primitive, count in primitives_needed.items():\n    while current_inventory[primitive] < count:\n      actions.extend(collect_v2(env, cookbook.get(primitive)))\n    \n    current_inventory[primitive] -= count\n  \n  # Go to the workshop and perform USE action\n  workshop_index = None\n  for key, value in cookbook.recipes[item_index].items():\n    if \"_at\" in key:\n      workshop_index = cookbook.index[value]\n      break\n\n  if workshop_index is not None:\n    actions.extend(move_to_workshop_v2(env, workshop_index))\n    actions.append(craft.USE)  # Assuming USE is the action to craft at a workshop\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-10T16:38:25.635950", "function_name": "craft", "function_body": "  # Convert item name to index\n  item_idx = env.world.cookbook.index[item]\n\n  # Check if the item has a recipe (can be crafted)\n  if item_idx not in env.world.cookbook.recipes:\n    return []\n\n  # Retrieve the recipe for the item\n  recipe = env.world.cookbook.recipes[item_idx]\n\n  # Initialize list to hold actions\n  actions = []\n\n  # Check and collect all required primitives for the recipe\n  for ingredient, count in recipe.items():\n      if ingredient == \"_at\":\n          workshop = recipe[ingredient]\n          continue\n\n      # Convert ingredient name to index\n      ingredient_idx = env.world.cookbook.index[ingredient]\n\n      while np.sum(env._current_state.inventory[ingredient_idx]) < count:\n          actions.extend(collect(env, ingredient))\n\n  # Move to the specified workshop and craft the item using USE action\n  workshop_idx = env.world.cookbook.index[workshop]\n  workshop_pos = None\n\n  # Find a position of the workshop in the grid (assuming there's only one for simplicity)\n  for x in range(env._current_state.grid.shape[0]):\n      for y in range(env._current_state.grid.shape[1]):\n          if env._current_state.grid[x, y, workshop_idx] > 0:\n              workshop_pos = (x, y)\n              break\n      if workshop_pos is not None:\n          break\n\n  if workshop_pos is None:\n      return []\n\n  # Calculate actions to move towards the workshop\n  path_to_workshop = a_star(env._current_state.pos, workshop_pos, env._current_state.grid)\n\n  for next_pos in path_to_workshop[1:]:  # Exclude current position\n      direction = get_direction(env._current_state.pos, next_pos)\n      actions.append(direction)\n\n  # Add USE action to craft the item\n  actions.append(4)  # Assuming USE is represented by action index 4\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-10T16:39:38.846398", "function_name": "craft", "function_body": "  actions = []\n  \n  # Convert the item name to its index using the cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n  \n  if not recipe:\n    return []\n\n  # Determine which workshop is required based on the \"_at\" key in the recipe\n  workshop_key = '_at'\n  workshop_name = recipe.pop(workshop_key, None)\n  \n  if not workshop_name:\n    print(f\"No workshop specified for item {item}.\")\n    return []\n  \n  workshop_index = env.world.cookbook.index[workshop_name]\n  \n  # Find all the required items/primitives\n  required_items = list(recipe.keys())\n  \n  # Check if we have all the required items in our inventory\n  inventory = env._current_state.inventory\n  \n  for required_item in required_items:\n    required_count = recipe[required_item]\n    if inventory[env.world.cookbook.index[required_item]] < required_count:\n      return []  # Missing some required items, cannot craft yet\n\n  # Find the position of the workshop\n  grid = env._current_state.grid\n  \n  # Assume we can find a single block with the workshop type in our grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n    print(f\"No {workshop_name} found on the grid.\")\n    return []\n  \n  target_workshop_pos = tuple(workshop_positions[0])\n  \n  # Move to the workshop\n  actions.extend(move_to(env, target_workshop_pos))\n  \n  # Turn towards the workshop and use the USE action to craft the item\n  direction_to_face = get_direction_to_face(env._current_state.pos, target_workshop_pos)\n  actions.append(direction_to_face)\n  actions.append(craft.ACTION_USE)\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-10T16:39:39.899394", "function_name": "craft", "function_body": "  actions = []\n  cookbook = env.world.cookbook\n  goal_idx = cookbook.index[item]\n  \n  # Check if we have all the items/primitives required for crafting\n  primitives_needed = cookbook.primitives_for(goal_idx)\n  \n  current_inventory = env._current_state.inventory\n  \n  # Check inventory for each primitive needed\n  for primitive, count in primitives_needed.items():\n    if current_inventory[primitive] < count:\n      print(f\"Not enough {cookbook.index.get(primitive)} to craft {item}\")\n      return []  # Not enough items to start crafting\n  \n  # If all items are available, proceed with the crafting process\n  recipe = cookbook.recipes[goal_idx]\n  \n  # Identify the workshop where crafting needs to be done\n  workshop_key = \"_key\"\n  workshop_name = recipe[workshop_key] if workshop_key in recipe else None\n\n  if not workshop_name:\n    print(f\"No workshop specified for {item} in the recipe.\")\n    return []\n\n  # Find all positions of the required workshop on the grid\n  workshop_idx = cookbook.index[workshop_name]\n  workshop_positions = np.argwhere(env._current_state.grid[:,:,workshop_idx] > 0)\n\n  if len(workshop_positions) == 0:\n    print(f\"No {workshop_name} found in the grid.\")\n    return []\n  \n  # Choose the closest workshop\n  current_pos = env._current_state.pos\n  distances = np.linalg.norm(workshop_positions - current_pos, axis=1)\n  closest_workshop_idx = np.argmin(distances)\n  target_pos = tuple(workshop_positions[closest_workshop_idx])\n  \n  # Calculate actions to move to the closest workshop\n  path_to_workshop = a_star(env._current_state.grid, current_pos, target_pos, env.world.non_grabbable_indices)\n  \n  if not path_to_workshop:\n    print(f\"No valid path to {workshop_name} found.\")\n    return []\n\n  # Convert positions in path to actions\n  for i in range(len(path_to_workshop) - 1):\n      direction = get_direction_from_positions(path_to_workshop[i], path_to_workshop[i + 1])\n      if direction:\n          actions.append(direction)\n  \n  # Once at the workshop, perform the USE action to craft the item\n  actions.append(4)  # Assuming USE action is 4\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-10T16:42:46.288620", "function_name": "craft", "function_body": "  def _move_to_position(target_pos):\n    start = env._current_state.pos\n\n    def heuristic(a, b):\n        return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n    open_set = collections.PriorityQueue()\n    open_set.put((0, start))\n    came_from = {}\n    g_score = {start: 0}\n\n    while not open_set.empty():\n        _, current = open_set.get()\n\n        if current == target_pos:\n            path = []\n            while current in came_from:\n                path.append(current)\n                current = came_from[current]\n            path.reverse()\n            actions = _convert_path_to_actions(path, start)\n            return actions\n\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            neighbor = (current[0] + dx, current[1] + dy)\n            if 0 <= neighbor[0] < env.world.WIDTH and 0 <= neighbor[1] < env.world.HEIGHT:\n                tentative_g_score = g_score[current] + 1\n                if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                    came_from[neighbor] = current\n                    g_score[neighbor] = tentative_g_score\n                    f_score = tentative_g_score + heuristic(neighbor, target_pos)\n                    open_set.put((f_score, neighbor))\n\n    return []\n\n  def _convert_path_to_actions(path, start):\n      actions = []\n      cx, cy = start\n      \n      for x, y in path:\n          if cx < x:\n              actions.append(craft.RIGHT)\n          elif cx > x:\n              actions.append(craft.LEFT)\n          if cy < y:\n              actions.append(craft.DOWN)\n          elif cy > y:\n              actions.append(craft.UP)\n          cx, cy = x, y\n      \n      return actions\n\n  def _has_required_primitives(primitive_indices):\n      for i in primitive_indices:\n          if env._current_state.inventory[i] <= 0:\n              return False\n      return True\n  \n  index = env.world.cookbook.index\n  item_index = index[item]\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n\n  actions = []\n\n  # Check if the recipe exists and has a key\n  if \"_key\" in recipe:\n      key_index = recipe[\"_key\"]\n      workshop_index = env.world.workshop_indices[key_index]\n\n      # Collect all required primitives if not already in inventory\n      for primitive_index in [i for i in recipe if i != \"_key\"]:\n          if env._current_state.inventory[primitive_index] <= 0:\n              actions.extend(collect(env, index.get_by_value(primitive_index)))\n\n      # Find all positions of the required workshop\n      workshop_positions = []\n      for x in range(env.world.WIDTH):\n          for y in range(env.world.HEIGHT):\n              if np.any(env._current_state.grid[x, y] == workshop_index):\n                  workshop_positions.append((x, y))\n\n      if not workshop_positions:\n          return []  # No workshops found\n\n      # Move to the nearest workshop\n      actions_to_workshop = None\n      closest_distance = float('inf')\n\n      for wp in workshop_positions:\n          distance = abs(wp[0] - env._current_state.pos[0]) + abs(wp[1] - env._current_state.pos[1])\n          if distance < closest_distance:\n              actions_to_workshop = _move_to_position(wp)\n              closest_distance = distance\n\n      if not actions_to_workshop:\n          return []  # No path to any workshop found\n\n      # Ensure the agent is facing the correct direction to use the workshop\n      target_pos = None\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          neighbor_pos = (env._current_state.pos[0] + dx, env._current_state.pos[1] + dy)\n          if 0 <= neighbor_pos[0] < env.world.WIDTH and 0 <= neighbor_pos[1] < env.world.HEIGHT:\n              if np.any(env._current_state.grid[neighbor_pos[0], neighbor_pos[1]] == workshop_index):\n                  target_pos = neighbor_pos\n                  break\n\n      if not target_pos:\n          return []  # No valid target position found\n\n      direction_to_target = (target_pos[0] - env._current_state.pos[0], target_pos[1] - env._current_state.pos[1])\n\n      if direction_to_target == (-1, 0):\n          actions.append(craft.LEFT)\n      elif direction_to_target == (1, 0):\n          actions.append(craft.RIGHT)\n      elif direction_to_target == (0, -1):\n          actions.append(craft.UP)\n      elif direction_to_target == (0, 1):\n          actions.append(craft.DOWN)\n\n      # Finally, add the USE action\n      actions.extend(actions_to_workshop + [craft.USE])\n      return actions\n\n  else:\n      return []  # No recipe found for the item", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T16:42:47.403307", "function_name": "craft", "function_body": "  def _move_to_position(target_pos):\n    start = env._current_state.pos\n    open_set = collections.deque([start])\n    came_from = {}\n    \n    while open_set:\n        current = open_set.popleft()\n        \n        if current == target_pos:\n            path = []\n            while current in came_from:\n                path.append(current)\n                current = came_from[current]\n            path.reverse()\n            actions = _convert_path_to_actions(path, start)\n            return actions\n        \n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            neighbor = (current[0] + dx, current[1] + dy)\n            if 0 <= neighbor[0] < env.world.WIDTH and 0 <= neighbor[1] < env.world.HEIGHT:\n                if neighbor not in came_from:\n                    came_from[neighbor] = current\n                    open_set.append(neighbor)\n    \n    return []\n\n  def _convert_path_to_actions(path, start):\n      actions = []\n      cx, cy = start\n      \n      for x, y in path:\n          if cx < x:\n              actions.append(craft.RIGHT)\n          elif cx > x:\n              actions.append(craft.LEFT)\n          if cy < y:\n              actions.append(craft.DOWN)\n          elif cy > y:\n              actions.append(craft.UP)\n          cx, cy = x, y\n      \n      return actions\n\n  def _has_required_primitives(primitive_indices):\n      for i in primitive_indices:\n          if env._current_state.inventory[i] <= 0:\n              return False\n      return True\n  \n  index = env.world.cookbook.index\n  item_index = index[item]\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n\n  actions = []\n\n  # Check if the recipe exists and has a key\n  if \"_key\" in recipe:\n      key_index = recipe[\"_key\"]\n      workshop_index = env.world.workshop_indices[key_index]\n      \n      if not _has_required_primitives([i for i in recipe if i != \"_key\"]):\n          return []\n      \n      # Find all positions of the required workshop\n      workshop_positions = []\n      for x in range(env.world.WIDTH):\n          for y in range(env.world.HEIGHT):\n              if np.any(env._current_state.grid[x, y] == workshop_index):\n                  workshop_positions.append((x, y))\n      \n      if not workshop_positions:\n          return []  # No workshops found\n      \n      # Move to the nearest workshop\n      actions_to_workshop = None\n      closest_distance = float('inf')\n      \n      for wp in workshop_positions:\n          distance = abs(wp[0] - env._current_state.pos[0]) + abs(wp[1] - env._current_state.pos[1])\n          if distance < closest_distance:\n              actions_to_workshop = _move_to_position(wp)\n              closest_distance = distance\n      \n      if not actions_to_workshop:\n          return []  # No path to any workshop found\n      \n      # Ensure the agent is facing the correct direction to use the workshop\n      target_pos = None\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          neighbor_pos = (env._current_state.pos[0] + dx, env._current_state.pos[1] + dy)\n          if 0 <= neighbor_pos[0] < env.world.WIDTH and 0 <= neighbor_pos[1] < env.world.HEIGHT:\n              if np.any(env._current_state.grid[neighbor_pos[0], neighbor_pos[1]] == workshop_index):\n                  target_pos = neighbor_pos\n                  break\n      \n      if not target_pos:\n          return []  # No valid target position found\n      \n      direction_to_target = (target_pos[0] - env._current_state.pos[0], target_pos[1] - env._current_state.pos[1])\n      \n      if direction_to_target == (-1, 0):\n          actions.append(craft.LEFT)\n      elif direction_to_target == (1, 0):\n          actions.append(craft.RIGHT)\n      elif direction_to_target == (0, -1):\n          actions.append(craft.UP)\n      elif direction_to_target == (0, 1):\n          actions.append(craft.DOWN)\n      \n      # Finally, add the USE action\n      actions.extend(actions_to_workshop + [craft.USE])\n      return actions\n  \n  else:\n      return []  # No recipe found for the item", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T16:44:20.284232", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = env._current_state.inventory.copy()\n\n  # Check if all ingredients are available\n  required_ingredients = {cookbook.index[k]: v for k, v in recipe.items()}\n\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if not can_craft:\n    return []\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No available workshop to craft item\")\n\n  # Select the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n  # Calculate actions to move the agent to the nearest workshop\n  actions_to_take = calculate_movement_actions(env._current_state.pos, nearest_workshop_pos)\n\n  # Align the agent with the direction it needs to face the workshop before using the USE action\n  target_direction = determine_target_direction(nearest_workshop_pos, env._current_state.pos, env._current_state.dir)\n  actions_to_take.extend(align_with_direction(env._current_state.dir, target_direction))\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T16:44:21.354622", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = env._current_state.inventory.copy()\n\n  # Check if all ingredients are available\n  required_ingredients = {cookbook.index[k]: v for k, v in recipe.items()}\n\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if not can_craft:\n    return []\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No available workshop to craft item\")\n\n  # Select the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n  # Calculate actions to move the agent to the nearest workshop\n  actions_to_take = calculate_movement_actions(env._current_state.pos, nearest_workshop_pos)\n\n  # Ensure facing the correct direction to use the workshop\n  current_direction = env._current_state.dir\n  required_direction = get_required_direction(current_position, nearest_workshop_pos)\n  \n  actions_to_take.extend(turn_towards_direction(current_direction, required_direction))\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T16:46:53.498345", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n\n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = env._current_state.inventory.copy()\n\n  # Check if all ingredients are available\n  required_ingredients = {cookbook.index[k]: v for k, v in recipe.items()}\n\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if not can_craft:\n    return []\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No available workshop to craft item\")\n\n  # Select the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n  # Calculate actions to move the agent to the nearest workshop\n  dx = nearest_workshop_pos[0] - current_position[0]\n  dy = nearest_workshop_pos[1] - current_position[1]\n\n  actions_to_take = []\n\n  # Move in the direction that minimizes distance first (either vertical or horizontal)\n  if abs(dx) > abs(dy):\n    move_direction = craft.MOVE_RIGHT if dx > 0 else craft.MOVE_LEFT\n    opposite_move = craft.MOVE_LEFT if dx > 0 else craft.MOVE_RIGHT\n    actions_to_take.extend([move_direction for _ in range(abs(dx))])\n    # If moving vertically first, check if need to turn before moving vertically\n    if dy != 0:\n      target_vertical_direction = craft.DOWN if dy > 0 else craft.UP\n      current_direction = env._current_state.dir\n\n      while current_direction != target_vertical_direction:\n          actions_to_take.append(craft.TURN_RIGHT)\n          current_direction = (current_direction + 1) % 4\n\n      move_direction = craft.MOVE_DOWN if dy > 0 else craft.MOVE_UP\n      opposite_move = craft.MOVE_UP if dy > 0 else craft.MOVE_DOWN\n      actions_to_take.extend([move_direction for _ in range(abs(dy))])\n  else:\n    move_direction = craft.MOVE_DOWN if dy > 0 else craft.MOVE_UP\n    opposite_move = craft.MOVE_UP if dy > 0 else craft.MOVE_DOWN\n    actions_to_take.extend([move_direction for _ in range(abs(dy))])\n    # If moving horizontally first, check if need to turn before moving horizontally\n    if dx != 0:\n      target_horizontal_direction = craft.RIGHT if dx > 0 else craft.LEFT\n      current_direction = env._current_state.dir\n\n      while current_direction != target_horizontal_direction:\n          actions_to_take.append(craft.TURN_RIGHT)\n          current_direction = (current_direction + 1) % 4\n\n      move_direction = craft.MOVE_RIGHT if dx > 0 else craft.MOVE_LEFT\n      opposite_move = craft.MOVE_LEFT if dx > 0 else craft.MOVE_RIGHT\n      actions_to_take.extend([move_direction for _ in range(abs(dx))])\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T16:46:54.562919", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n\n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = env._current_state.inventory.copy()\n\n  # Check if all ingredients are available\n  required_ingredients = {cookbook.index[k]: v for k, v in recipe.items()}\n\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if not can_craft:\n    return []\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No available workshop to craft item\")\n\n  # Select the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n  # Calculate actions to move the agent to the nearest workshop\n  dx = nearest_workshop_pos[0] - current_position[0]\n  dy = nearest_workshop_pos[1] - current_position[1]\n\n  actions_to_take = []\n\n  if dx > 0:\n    actions_to_take.extend([craft.MOVE_RIGHT for _ in range(dx)])\n  elif dx < 0:\n    actions_to_take.extend([craft.MOVE_LEFT for _ in range(-dx)])\n\n  if dy > 0:\n    actions_to_take.extend([craft.MOVE_DOWN for _ in range(dy)])\n  elif dy < 0:\n    actions_to_take.extend([craft.MOVE_UP for _ in range(-dy)])\n\n  # Calculate the target direction to face the workshop\n  current_direction = env._current_state.dir\n\n  if dx == 0 and dy == 0:  # Already at the workshop\n      pass\n  else:\n      target_direction = None\n\n      if abs(dx) > abs(dy):\n          target_direction = craft.RIGHT if dx > 0 else craft.LEFT\n      else:\n          target_direction = craft.DOWN if dy > 0 else craft.UP\n\n      while current_direction != target_direction:\n          actions_to_take.append(craft.TURN_RIGHT)\n          current_direction = (current_direction + 1) % 4\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T16:49:25.514388", "function_name": "craft", "function_body": "  def calculate_path(start_pos, target_pos, grid):\n    \"\"\"A simple BFS implementation to find a path from start_pos to target_pos.\"\"\"\n    queue = collections.deque([(start_pos, [])])\n    visited = set()\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]  # RIGHT, DOWN, LEFT, UP\n\n    while queue:\n        (x, y), path = queue.popleft()\n\n        if (x, y) == target_pos:\n            return path\n\n        if (x, y) in visited:\n            continue\n        visited.add((x, y))\n\n        for dx, dy in directions:\n            nx, ny = x + dx, y + dy\n            if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and grid[nx, ny, -1] == 0:  # Assuming the last layer is walkable\n                queue.append(((nx, ny), path + [(dx, dy)]))\n\n    return None\n\n  def move_to_direction(target_direction, current_direction):\n    \"\"\"Calculate actions to turn from current_direction to target_direction.\"\"\"\n    actions = []\n    while current_direction != target_direction:\n        actions.append(craft.TURN_RIGHT)\n        current_direction = (current_direction + 1) % 4\n    return actions\n\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = env._current_state.inventory.copy()\n\n  # Check if all ingredients are available\n  required_ingredients = {cookbook.index[k]: v for k, v in recipe.items()}\n\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if not can_craft:\n    return []\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No available workshop to craft item\")\n\n  # Select the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n  # Calculate the path to the nearest workshop\n  path = calculate_path(tuple(current_position), nearest_workshop_pos, env._current_state.grid)\n\n  if not path:\n    raise ValueError(\"No valid path found to reach the workshop\")\n\n  actions_to_take = []\n  \n  current_direction = env._current_state.dir\n\n  for (dx, dy) in path:\n      target_direction = None\n      if dx == 1 and dy == 0:\n          target_direction = craft.RIGHT\n      elif dx == -1 and dy == 0:\n          target_direction = craft.LEFT\n      elif dx == 0 and dy == 1:\n          target_direction = craft.DOWN\n      elif dx == 0 and dy == -1:\n          target_direction = craft.UP\n\n      actions_to_take.extend(move_to_direction(target_direction, current_direction))\n      actions_to_take.append(craft.MOVE_FORWARD)\n      current_direction = target_direction\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T16:49:26.561576", "function_name": "craft", "function_body": "  def calculate_path(start_pos, target_pos, grid):\n    \"\"\"A simple BFS implementation to find a path from start_pos to target_pos.\"\"\"\n    queue = collections.deque([(start_pos, [])])\n    visited = set()\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]  # RIGHT, DOWN, LEFT, UP\n\n    while queue:\n        (x, y), path = queue.popleft()\n\n        if (x, y) == target_pos:\n            return path\n\n        if (x, y) in visited:\n            continue\n        visited.add((x, y))\n\n        for dx, dy in directions:\n            nx, ny = x + dx, y + dy\n            if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and grid[nx, ny, -1] == 0:  # Assuming the last layer is walkable\n                queue.append(((nx, ny), path + [(dx, dy)]))\n\n    return None\n\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = env._current_state.inventory.copy()\n\n  # Check if all ingredients are available\n  required_ingredients = {cookbook.index[k]: v for k, v in recipe.items()}\n\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if not can_craft:\n    return []\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No available workshop to craft item\")\n\n  # Select the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n  # Calculate the path to the nearest workshop\n  path = calculate_path(tuple(current_position), nearest_workshop_pos, env._current_state.grid)\n\n  if not path:\n    raise ValueError(\"No valid path found to reach the workshop\")\n\n  actions_to_take = []\n  \n  current_direction = env._current_state.dir\n\n  for (dx, dy) in path:\n      target_direction = None\n      if dx == 1 and dy == 0:\n          target_direction = craft.RIGHT\n      elif dx == -1 and dy == 0:\n          target_direction = craft.LEFT\n      elif dx == 0 and dy == 1:\n          target_direction = craft.DOWN\n      elif dx == 0 and dy == -1:\n          target_direction = craft.UP\n\n      while current_direction != target_direction:\n          actions_to_take.append(craft.TURN_RIGHT)\n          current_direction = (current_direction + 1) % 4\n\n      actions_to_take.append(craft.MOVE_FORWARD)\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T16:51:03.643144", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = env._current_state.inventory.copy()\n\n  # Check if all ingredients are available\n  required_ingredients = {cookbook.index[k]: v for k, v in recipe.items()}\n\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if not can_craft:\n    return []\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No available workshop to craft item\")\n\n  # Select the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n  # Calculate actions to move the agent to the nearest workshop\n  actions_to_take = calculate_movement_actions(env._current_state.pos, nearest_workshop_pos)\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T16:51:04.730961", "function_name": "craft", "function_body": "  def calculate_movement_actions(current_pos, target_pos):\n    current_x, current_y = current_pos\n    target_x, target_y = target_pos\n\n    # Calculate the required movements in x and y directions\n    dx = target_x - current_x\n    dy = target_y - current_y\n\n    actions = []\n    \n    if dx > 0:\n        actions.extend([craft.MOVE_RIGHT for _ in range(dx)])\n    elif dx < 0:\n        actions.extend([craft.MOVE_LEFT for _ in range(-dx)])\n\n    if dy > 0:\n        actions.extend([craft.MOVE_DOWN for _ in range(dy)])\n    elif dy < 0:\n        actions.extend([craft.MOVE_UP for _ in range(-dy)])\n\n    return actions\n\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = env._current_state.inventory.copy()\n\n  # Check if all ingredients are available\n  required_ingredients = {cookbook.index[k]: v for k, v in recipe.items()}\n\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if not can_craft:\n    return []\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No available workshop to craft item\")\n\n  # Select the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n  # Calculate actions to move the agent to the nearest workshop\n  actions_to_take = calculate_movement_actions(env._current_state.pos, nearest_workshop_pos)\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T16:51:55.771615", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the item has a recipe in the cookbook\n  if item_index not in env.world.cookbook.recipes:\n    return []  # No recipe for this item\n  \n  # Retrieve the recipe for the item\n  recipe = env.world.cookbook.recipes[item_index]\n  \n  # Extract ingredients and required workshop from the recipe\n  ingredients = {env.world.cookbook.index[ingredient]: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n  workshop_name = recipe[\"_at\"]\n  \n  # Get the index of the workshop\n  workshop_index = env.world.cookbook.index[workshop_name]\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index])\n  \n  # Check if the agent has all required ingredients in their inventory\n  for ingredient, count in ingredients.items():\n    if env._current_state.inventory[ingredient] < count:\n      return []  # Not enough ingredients\n  \n  # Find a position near a workshop to use it\n  for pos in workshop_positions:\n    x, y = pos\n    \n    # Check all adjacent positions to find an empty cell to move into\n    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n      nx, ny = x + dx, y + dy\n      \n      if env._current_state.grid[nx, ny].sum() == 0:  # Check if the cell is empty\n        # Move to the adjacent position\n        actions.extend([env.world.N_ACTIONS - 4 + i for i in range(4) if (nx, ny) == craft.move_in_direction(env._current_state.pos, env._current_state.dir + i)])\n        \n        # Turn towards the workshop and use it\n        actions.append(craft.turn_towards((x, y), env._current_state.pos))\n        actions.append(env.world.USE)\n        \n        return actions\n  \n  return []  # No suitable position found to craft the item", "island_id": 6, "scores": {"3": -1}}
