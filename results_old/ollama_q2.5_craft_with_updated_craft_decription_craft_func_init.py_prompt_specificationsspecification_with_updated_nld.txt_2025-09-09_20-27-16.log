  \n  # Turn the agent to face the workshop and perform USE action\n  if not state.next_to(workshop_index):\n    return []  # Agent cannot reach the workshop\n  \n  # Assuming the agent will face the workshop after reaching it.\n  actions.append(4)  # Use action\n\n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T06:53:52.617088", "function_name": "craft", "function_body": "  def has_all_primitives(required_primitives, inventory_dict):\n    return all(primitive in inventory_dict and inventory_dict[primitive] >= required_primitives[primitive] for primitive in required_primitives)\n\n  actions = []\n  \n  # Get the index of the goal item\n  try:\n      item_index = env.world.cookbook.index[item]\n  except KeyError:\n      print(f\"Item {item} not found in the cookbook.\")\n      return []\n\n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  # If not all primitives are available return empty action list\n  if not has_all_primitives(required_primitives, inventory_dict):\n    print(f\"Not enough primitives to craft {item}.\")\n    return []\n  \n  # Find the workshop where we can craft this item\n  workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n      workshop_index = recipe.get(\"_at\")\n      break\n  \n  if workshop_index is None:\n    print(f\"No workshop found to craft {item}.\")\n    return []\n\n  # Convert workshop index to the actual name of the workshop\n  workshop_name = env.world.cookbook.index.get(workshop_index)\n  \n  # Find the position of the nearest workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(workshop_positions) == 0:\n    print(f\"No {workshop_name} found in the grid.\")\n    return []\n  \n  # Select the closest workshop (for simplicity, we take the first one found)\n  target_workshop_pos = tuple(workshop_positions[0])\n\n  # Navigate to the selected workshop\n  actions.extend(navigate(env._current_state, target_workshop_pos))\n  \n  # Turn towards the workshop if not already facing it\n  current_direction = env._current_state.dir\n  direction_to_workshop = get_direction(env._current_state.pos, target_workshop_pos)\n  if current_direction != direction_to_workshop:\n    actions.append(direction_to_workshop)\n\n  # Use the USE action to craft the item at the workshop\n  actions.append(4)  # Assuming 4 is the index for the USE action\n  \n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-11T06:53:53.663164", "function_name": "craft", "function_body": "  def has_all_primitives(required_primitives, inventory_dict):\n    return all(primitive in inventory_dict and inventory_dict[primitive] >= required_primitives[primitive] for primitive in required_primitives)\n\n  actions = []\n  \n  # Get the index of the goal item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  # If not all primitives are available return empty action list\n  if not has_all_primitives(required_primitives, inventory_dict):\n    return []\n  \n  # Find the workshop where we can craft this item\n  workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n      workshop_index = recipe.get(\"_at\")\n      break\n  \n  if workshop_index is None:\n    return []\n\n  # Convert workshop index to the actual name of the workshop\n  workshop_name = env.world.cookbook.index.get(workshop_index)\n  \n  # Find the position of the nearest workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(workshop_positions) == 0:\n    return []\n  \n  # Select the closest workshop (for simplicity, we take the first one found)\n  target_workshop_pos = tuple(workshop_positions[0])\n\n  # Navigate to the selected workshop\n  actions.extend(navigate(env._current_state, target_workshop_pos))\n  \n  # Turn towards the workshop if not already facing it\n  current_direction = env._current_state.dir\n  direction_to_workshop = get_direction(env._current_state.pos, target_workshop_pos)\n  if current_direction != direction_to_workshop:\n    actions.append(direction_to_workshop)\n\n  # Ensure the agent is directly in front of the workshop before using USE\n  aligned_actions = align_with_target(env._current_state, target_workshop_pos)\n  actions.extend(aligned_actions)\n  \n  # Use the USE action to craft the item at the workshop\n  actions.append(4)  # Assuming 4 is the index for the USE action\n  \n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T06:54:47.632258", "function_name": "craft", "function_body": "  # Translate item name to index\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the recipe for the desired item exists and retrieve required primitives\n  if item_index not in env.world.cookbook.recipes:\n    print(f\"No recipe found for {item}.\")\n    return []\n\n  recipe = env.world.cookbook.recipes[item_index]\n  \n  # Collect all necessary primitives\n  actions = []\n  for ingredient, count in recipe.items():\n      if ingredient == \"_at\":\n          continue  # Skip the workshop information\n\n      ingredient_name = env.world.cookbook.index.get(ingredient)\n      for _ in range(count):\n          collect_actions = collect(env, ingredient_name)\n          actions.extend(collect_actions)\n\n  # Move to the specified workshop\n  workshop_index = recipe[\"_at\"]\n  workshop_name = env.world.cookbook.index.get(workshop_index)\n  \n  # Find path to the workshop and move there\n  path_to_workshop = find_path(env._current_state, workshop_name)\n  actions.extend(path_to_workshop)\n\n  # Craft the item by using the USE action at the workshop\n  actions.append(4)  # Assuming 4 is the index for USE action\n\n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-11T06:54:48.593210", "function_name": "craft", "function_body": "  # Step 1: Check if the required primitives for crafting are in the inventory\n  current_state = env._current_state\n  goal_index = env.world.cookbook.index[item]\n  \n  if goal_index not in env.world.cookbook.recipes:\n    return []\n  \n  recipe = env.world.cookbook.recipes[goal_index]\n\n  # Collecting required primitives \n  actions_to_collect_primitives = []\n\n  for ingredient, count in recipe.items():\n      if ingredient == \"_at\": continue\n      primitive_index = env.world.cookbook.index.get(ingredient)\n      \n      while current_state.inventory[primitive_index] < count:\n          actions_to_collect_primitives.extend(collect(env, primitive))\n          _, done, _ = env.step(actions_to_collect_primitives[-1])\n          current_state = env._current_state\n          if done:\n              break\n\n  # Step 2: Navigate to the workshop and craft the item\n  workshop_index = env.world.cookbook.index.get(recipe[\"_at\"])\n  actions_to_workshop = move(env, env.world.workshop_indices[workshop_index])\n  current_state = env._current_state\n\n  # Step 3: Perform the USE action at the workshop\n  actions_to_use = [craft.CraftWorld.USE]\n\n  return actions_to_collect_primitives + actions_to_workshop + actions_to_use", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-11T06:55:42.654106", "function_name": "craft", "function_body": "  # Get the cookbook\n  cookbook = env.world.cookbook\n\n  # Convert item name to index\n  item_index = cookbook.index[item]\n\n  # Check if we have all required items for crafting\n  primitives_needed = cookbook.primitives_for(item_index)\n\n  # If no recipe is found, return empty action list\n  if not primitives_needed:\n    print(f\"No recipe found for {item}.\")\n    return []\n\n  # Initialize actions list\n  actions = []\n\n  # Get current state and inventory\n  current_state = env._current_state\n  inventory = current_state.inventory\n\n  # Check if we have all the required items in our inventory\n  missing_items = {}\n  for primitive_index, count in primitives_needed.items():\n    if inventory[primitive_index] < count:\n      missing_items[primitive_index] = count - inventory[primitive_index]\n\n  # If no items are missing, proceed to craft the item at the specified workshop\n  if not missing_items:\n    print(\"All required items are available.\")\n    actions.extend(craft_item(env, item_index))\n  else:\n    print(f\"Missing items: {missing_items}\")\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-11T06:55:43.624062", "function_name": "craft", "function_body": "  actions = []\n\n  # Get the index for the target item\n  item_index = env.world.cookbook.index[item]\n\n  if not item_index:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  # Check if we have all required primitives to craft the item\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n\n  for prim, count in required_primitives.items():\n    if env._current_state.inventory[prim] < count:\n      return []  # We don't have enough of this primitive\n\n  # Find the recipe for the item and determine the workshop\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_key = recipe.get(\"_at\")\n\n  if not workshop_key:\n    raise ValueError(f\"No workshop specified in recipe for {item}\")\n\n  workshop_index = env.world.cookbook.index[workshop_key]\n\n  # Find a location of the required workshop\n  workshop_pos = None\n  grid = env._current_state.grid\n  for x in range(grid.shape[0]):\n      for y in range(grid.shape[1]):\n          if grid[x, y, workshop_index] == 1:\n              workshop_pos = (x, y)\n              break\n      if workshop_pos:\n          break\n\n  if not workshop_pos:\n    raise ValueError(f\"No {workshop_key} found on the grid.\")\n\n  # Navigate to the workshop position\n  current_pos = env._current_state.pos\n  actions.extend(navigate_to(env, workshop_pos))\n\n  # Turn to face the workshop (assuming facing right is index 3)\n  if env._current_state.dir != 3:\n      turn_action = [2, 1][env._current_state.dir < 3] * 2  # Turn left or right twice\n      actions.extend(turn_action)\n\n  # Perform USE action to craft the item\n  actions.append(4)  # Assuming USE is represented as index 4\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-11T06:57:55.232832", "function_name": "craft", "function_body": "  def get_direction(current_pos, target_pos):\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    if abs(dx) > abs(dy):\n      return 2 if dx < 0 else 3  # LEFT or RIGHT\n    elif abs(dy) >= abs(dx):\n      return 1 if dy > 0 else 0  # UP or DOWN\n\n  def navigate(state, target_pos):\n    path = []\n    current_pos = state.pos\n    target_direction = get_direction(current_pos, target_pos)\n\n    while current_pos != target_pos:\n      direction_to_target = get_direction(current_pos, target_pos)\n      if direction_to_target == target_direction:\n        if direction_to_target == 0:  # DOWN\n          path.append(0)\n          current_pos = (current_pos[0], current_pos[1] - 1)\n        elif direction_to_target == 1:  # UP\n          path.append(1)\n          current_pos = (current_pos[0], current_pos[1] + 1)\n        elif direction_to_target == 2:  # LEFT\n          path.append(2)\n          current_pos = (current_pos[0] - 1, current_pos[1])\n        elif direction_to_target == 3:  # RIGHT\n          path.append(3)\n          current_pos = (current_pos[0] + 1, current_pos[1])\n\n    return path\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n\n  # If not all primitives are available return empty action list\n  if not all(primitive in inventory_dict and inventory_dict[primitive] >= required_primitives[primitive] for primitive in required_primitives):\n    return []\n\n  # Find the workshop where we can craft this item\n  workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n      workshop_index = recipe.get(\"_at\")\n      break\n\n  if workshop_index is None:\n    return []\n\n  # Convert workshop index to the actual name of the workshop\n  workshop_name = env.world.cookbook.index.get(workshop_index)\n\n  # Find the position of the nearest workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(workshop_positions) == 0:\n    return []\n\n  # Select the closest workshop (for simplicity, we take the first one found)\n  target_workshop_pos = tuple(workshop_positions[0])\n\n  # Navigate to the selected workshop\n  actions = navigate(env._current_state, target_workshop_pos)\n\n  # Turn towards the workshop if not already facing it\n  current_direction = env._current_state.dir\n  direction_to_workshop = get_direction(env._current_state.pos, target_workshop_pos)\n\n  # Check if we need to turn\n  if current_direction != direction_to_workshop:\n    actions.append(direction_to_workshop)\n\n  # Use the USE action to craft the item at the workshop\n  actions.append(4)  # Assuming 4 is the index for the USE action\n\n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T06:57:56.269896", "function_name": "craft", "function_body": "  def get_direction(current_pos, target_pos):\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    if dx > 0:\n      return 3  # RIGHT\n    elif dx < 0:\n      return 2  # LEFT\n    elif dy > 0:\n      return 1  # UP\n    else:\n      return 0  # DOWN\n\n  def navigate(state, target_pos):\n    path = []\n    current_pos = state.pos\n\n    while current_pos != target_pos:\n      direction = get_direction(current_pos, target_pos)\n\n      if direction == 0:  # DOWN\n        path.append(0)\n        current_pos = (current_pos[0], current_pos[1] - 1)\n      elif direction == 1:  # UP\n        path.append(1)\n        current_pos = (current_pos[0], current_pos[1] + 1)\n      elif direction == 2:  # LEFT\n        path.append(2)\n        current_pos = (current_pos[0] - 1, current_pos[1])\n      elif direction == 3:  # RIGHT\n        path.append(3)\n        current_pos = (current_pos[0] + 1, current_pos[1])\n\n    return path\n\n  def turn_to_direction(current_direction, target_direction):\n    if current_direction != target_direction:\n      return [target_direction]\n    else:\n      return []\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n\n  # If not all primitives are available return empty action list\n  if not all(primitive in inventory_dict and inventory_dict[primitive] >= required_primitives[primitive] for primitive in required_primitives):\n    return []\n\n  # Find the workshop where we can craft this item\n  workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n      workshop_index = recipe.get(\"_at\")\n      break\n\n  if workshop_index is None:\n    return []\n\n  # Find the position of the nearest workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(workshop_positions) == 0:\n    return []\n\n  # Select the closest workshop (for simplicity, we take the first one found)\n  target_workshop_pos = tuple(workshop_positions[0])\n\n  # Navigate to the selected workshop\n  actions = navigate(env._current_state, target_workshop_pos)\n\n  # Turn towards the workshop if not already facing it\n  current_direction = env._current_state.dir\n  direction_to_workshop = get_direction(env._current_state.pos, target_workshop_pos)\n  actions.extend(turn_to_direction(current_direction, direction_to_workshop))\n\n  # Use the USE action to craft the item at the workshop\n  actions.append(4)  # Assuming 4 is the index for the USE action\n\n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T06:58:55.250410", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  index = cookbook.index\n  goal_index = index.index(item)\n  \n  if goal_index not in cookbook.recipes:\n    # No recipe for this item.\n    return []\n\n  actions = []\n  primitive_counts = cookbook.primitives_for(goal_index)\n\n  for i_kind, count in primitive_counts.items():\n    primitive_name = index.get(i_kind)\n    \n    while env._current_state.inventory[i_kind] < count:\n      collect_actions = collect_v2(env, primitive_name)\n      if not collect_actions:\n        return []\n      \n      actions.extend(collect_actions)\n  \n  workshop_index = cookbook.recipes[goal_index][\"_key\"]\n  workshop_pos = None\n  \n  # Find the nearest workshop position\n  for x in range(env.world.cookbook.WIDTH):\n    for y in range(env.world.cookbook.HEIGHT):\n      if env._current_state.grid[x, y, workshop_index] == 1:\n        workshop_pos = (x, y)\n        break\n    if workshop_pos is not None:\n      break\n  \n  if workshop_pos is None:\n    return []\n\n  move_actions = navigate_to(env, workshop_pos)\n  actions.extend(move_actions)\n\n  # Adjust direction to face the workshop\n  final_dir = compute_direction(env._current_state.pos, workshop_pos)\n  turn_actions = turn_to(env._current_state.dir, final_dir)\n  actions.extend(turn_actions)\n\n  # Perform USE action to craft the item\n  actions.append(craft.USE)\n  \n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-11T06:58:56.227092", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index of the item we want to craft\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the item has a recipe\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the required ingredients and their counts for crafting the item\n  recipe = env.world.cookbook.recipes[item_index]\n  \n  # Dictionary to hold actions needed for each ingredient\n  ingredient_actions = collections.defaultdict(list)\n  \n  # Find actions to collect all necessary primitives\n  for ingredient, count in recipe.items():\n    if ingredient == \"_at\":\n      workshop = recipe[\"_at\"]\n      workshop_index = env.world.cookbook.index[workshop]\n      continue\n    \n    ingredient_index = env.world.cookbook.index[ingredient]\n    \n    # Check if the agent already has enough of this ingredient\n    if env._current_state.inventory[ingredient_index] >= count:\n      continue\n\n    # Collect primitives\n    actions.extend(collect(env, ingredient))\n    \n  # Move to the specified workshop\n  workshop_index = env.world.cookbook.index[recipe[\"_at\"]]\n  workshop_pos = find_workshop_position(env, workshop_index)\n  \n  if workshop_pos is None:\n    return []\n\n  # Add move actions to reach the workshop\n  actions.extend(move_to_position(env._current_state.pos, workshop_pos))\n  \n  # Use action at the workshop\n  actions.append(craft.USE)\n  \n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-11T07:01:04.947221", "function_name": "craft", "function_body": "  def navigate_to_position(current_pos: tuple, target_pos: tuple) -> list[int]:\n      \"\"\"Navigates the agent from current position to target position.\"\"\"\n      actions = []\n      while current_pos != target_pos:\n          dx = target_pos[0] - current_pos[0]\n          dy = target_pos[1] - current_pos[1]\n          \n          if abs(dx) > abs(dy):\n              direction = 3 if dx > 0 else 2  # RIGHT or LEFT\n          else:\n              direction = 4 if dy > 0 else 1  # DOWN or UP\n          \n          actions.append(direction)\n          current_pos = (current_pos[0] + (1 if direction == 3 else -1 if direction == 2 else 0),\n                         current_pos[1] + (1 if direction == 4 else -1 if direction == 1 else 0))\n      \n      return actions\n\n  def face_workshop(current_pos: tuple, workshop_pos: tuple) -> list[int]:\n      \"\"\"Faces the agent towards the workshop.\"\"\"\n      actions = []\n      dx = workshop_pos[0] - current_pos[0]\n      dy = workshop_pos[1] - current_pos[1]\n      \n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      \n      if dy > 0:\n          actions.append(4)  # DOWN\n      elif dy < 0:\n          actions.append(1)  # UP\n      \n      return actions\n\n  def get_turn_actions(current_dir: int, target_dir: int) -> list[int]:\n      \"\"\"Calculates the sequence of turn actions to change from current direction to target direction.\"\"\"\n      turn_actions = []\n      if (current_dir + 1) % 4 == target_dir:\n          turn_actions.append(6)  # Turn right\n      elif (current_dir - 1) % 4 == target_dir:\n          turn_actions.append(5)  # Turn left\n      else:\n          turn_actions.extend([5, 5])  # Turn around\n      return turn_actions\n\n  actions = []\n\n  # Get the index for the goal item\n  goal_index = env.world.cookbook.index[item]\n\n  # Check if we have all the required primitives in inventory\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  \n  missing_primitives = {}\n  for prim, count in required_primitives.items():\n      if env._current_state.inventory[prim] < count:\n          missing_primitives[prim] = count - env._current_state.inventory[prim]\n  \n  if missing_primitives:\n      return []  # Return empty list if any primitive is not sufficient\n\n  # Identify the workshop where crafting should occur\n  for recipe_output, ingredients in env.world.cookbook.recipes.items():\n      if recipe_output == goal_index and \"_key\" in ingredients:\n          workshop_key = ingredients[\"_key\"]\n          break\n  else:\n      return []  # No valid workshop found\n  \n  # Find the index of the workshop\n  workshop_index = env.world.cookbook.index[workshop_key]\n\n  # Locate the workshop on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n      return []  # Workshop not found on the grid\n\n  # Navigate to the nearest workshop\n  agent_pos = env._current_state.pos\n  closest_workshop = min(workshop_positions, key=lambda x: np.linalg.norm(np.array(x) - np.array(agent_pos)))\n  \n  actions.extend(navigate_to_position(agent_pos, closest_workshop))\n  \n  # Face the workshop before using it\n  actions.extend(face_workshop(agent_pos, closest_workshop))\n\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T07:01:05.987692", "function_name": "craft", "function_body": "  def navigate_to_position(agent_pos, target_pos):\n      actions = []\n      while tuple(agent_pos) != tuple(target_pos):\n          dx, dy = target_pos[0] - agent_pos[0], target_pos[1] - agent_pos[1]\n          \n          if abs(dx) > abs(dy):\n              move_dir = 3 if dx > 0 else 2\n          else:\n              move_dir = 4 if dy > 0 else 1\n          \n          actions.append(move_dir)\n          agent_pos = (agent_pos[0] + (move_dir == 3) - (move_dir == 2), \n                       agent_pos[1] + (move_dir == 4) - (move_dir == 1))\n      \n      return actions\n\n  def face_workshop(agent_pos, workshop_pos):\n      actions = []\n      dx, dy = workshop_pos[0] - agent_pos[0], workshop_pos[1] - agent_pos[1]\n      \n      if abs(dx) > abs(dy):\n          move_dir = 3 if dx > 0 else 2\n      else:\n          move_dir = 4 if dy > 0 else 1\n      \n      actions.append(move_dir)\n      return actions\n\n  actions = []\n\n  # Get the index for the goal item\n  goal_index = env.world.cookbook.index[item]\n\n  # Check if we have all the required primitives in inventory\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  \n  missing_primitives = {}\n  for prim, count in required_primitives.items():\n      if env._current_state.inventory[prim] < count:\n          missing_primitives[prim] = count - env._current_state.inventory[prim]\n  \n  if missing_primitives:\n      return []  # Return empty list if any primitive is not sufficient\n\n  # Identify the workshop where crafting should occur\n  for recipe_output, ingredients in env.world.cookbook.recipes.items():\n      if recipe_output == goal_index and \"_key\" in ingredients:\n          workshop_key = ingredients[\"_key\"]\n          break\n  else:\n      return []  # No valid workshop found\n  \n  # Find the index of the workshop\n  workshop_index = env.world.cookbook.index[workshop_key]\n\n  # Locate the workshop on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n      return []  # Workshop not found on the grid\n\n  # Navigate to the nearest workshop\n  agent_pos = env._current_state.pos\n  closest_workshop = min(workshop_positions, key=lambda x: np.linalg.norm(np.array(x) - np.array(agent_pos)))\n  \n  actions.extend(navigate_to_position(agent_pos, closest_workshop))\n  \n  # Face the workshop before using it\n  actions.extend(face_workshop(agent_pos, closest_workshop))\n\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-11T07:06:56.091478", "function_name": "craft", "function_body": "  def navigate_to_position_bfs(env, target_pos):\n    pos = env._current_state.pos\n    grid = env._current_state.grid\n    width, height = grid.shape[:2]\n    \n    queue = collections.deque([pos])\n    visited = set()\n    parent = {pos: None}\n\n    while queue:\n        current_pos = queue.popleft()\n\n        if tuple(current_pos) == target_pos:\n            # Reconstruct path from start to target\n            path = []\n            while current_pos is not None:\n                path.append(current_pos)\n                current_pos = parent[current_pos]\n            return path[::-1]\n\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n            if 0 <= new_x < width and 0 <= new_y < height and (new_x, new_y) not in visited:\n                queue.append((new_x, new_y))\n                visited.add((new_x, new_y))\n                parent[(new_x, new_y)] = current_pos\n\n    return None\n\n  def navigate_to_item_bfs(env, target_indices):\n    pos = env._current_state.pos\n    grid = env._current_state.grid\n    width, height = grid.shape[:2]\n    \n    queue = collections.deque([pos])\n    visited = set()\n    parent = {pos: None}\n\n    while queue:\n        current_pos = queue.popleft()\n\n        if any(grid[current_pos[0], current_pos[1], i] > 0 for i in target_indices):\n            # Reconstruct path from start to target\n            path = []\n            while current_pos is not None:\n                path.append(current_pos)\n                current_pos = parent[current_pos]\n            return path[::-1]\n\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n            if 0 <= new_x < width and 0 <= new_y < height and (new_x, new_y) not in visited:\n                queue.append((new_x, new_y))\n                visited.add((new_x, new_y))\n                parent[(new_x, new_y)] = current_pos\n\n    return None\n\n  def navigate_to_position(env, target_pos):\n      path = navigate_to_position_bfs(env, target_pos)\n      \n      if path is None:\n          print(\"No valid path found to the position.\")\n          return []\n\n      actions = []\n      for next_pos in path[1:]:\n          # Calculate direction to move towards next_pos\n          dx = next_pos[0] - env._current_state.pos[0]\n          dy = next_pos[1] - env._current_state.pos[1]\n\n          if dx == 1:\n              actions.append(env.world.N_ACTIONS - 3)  # RIGHT action\n          elif dx == -1:\n              actions.append(env.world.N_ACTIONS - 4)  # LEFT action\n          elif dy == 1:\n              actions.append(env.world.N_ACTIONS - 2)  # DOWN action\n          elif dy == -1:\n              actions.append(env.world.N_ACTIONS - 5)  # UP action\n\n      return actions\n\n  def navigate_to_item(env, target_indices):\n      path = navigate_to_item_bfs(env, target_indices)\n      \n      if path is None:\n          print(\"No valid path found to the item.\")\n          return []\n\n      actions = []\n      for next_pos in path[1:]:\n          # Calculate direction to move towards next_pos\n          dx = next_pos[0] - env._current_state.pos[0]\n          dy = next_pos[1] - env._current_state.pos[1]\n\n          if dx == 1:\n              actions.append(env.world.N_ACTIONS - 3)  # RIGHT action\n          elif dx == -1:\n              actions.append(env.world.N_ACTIONS - 4)  # LEFT action\n          elif dy == 1:\n              actions.append(env.world.N_ACTIONS - 2)  # DOWN action\n          elif dy == -1:\n              actions.append(env.world.N_ACTIONS - 5)  # UP action\n\n      return actions\n\n  def collect_primitive(env, primitive_name):\n      \"\"\"Helper function to collect a primitive.\"\"\"\n      primitive_index = env.world.cookbook.index[primitive_name]\n      \n      if primitive_index not in env.world.grabbable_indices:\n          raise ValueError(f\"{primitive_name} is not a grabbable item.\")\n      \n      # Check if already have the required amount of the primitive\n      if env._current_state.inventory[primitive_index] >= recipe.get(primitive_name, 0):\n          return []\n      \n      actions = []\n\n      while env._current_state.inventory[primitive_index] < recipe.get(primitive_name, 0):\n          positions = find_item_positions(env, [primitive_index])\n          \n          if not positions:\n              raise ValueError(f\"No available {primitive_name} to collect.\")\n          \n          for pos in positions:\n              actions.extend(navigate_to_position(env, pos))\n              \n              # Check if the agent is next to an item\n              if env._current_state.next_to(primitive_index):\n                  actions.append(env.world.N_ACTIONS - 1)  # USE action\n              \n              if env._current_state.inventory[primitive_index] >= recipe.get(primitive_name, 0):\n                  break\n\n      return actions\n\n  def find_item_positions(env, target_indices):\n      \"\"\"Find all positions of specific items in the grid.\"\"\"\n      grid = env._current_state.grid\n      positions = []\n      for idx in target_indices:\n          pos_list = np.argwhere(grid[:, :, idx] > 0).tolist()\n          positions.extend(pos_list)\n      return positions\n\n  def find_workshop_position(env, workshop_name):\n      \"\"\"Find the position of a specific workshop in the grid.\"\"\"\n      grid = env._current_state.grid\n      workshop_index = env.world.cookbook.index[f\"workshop{workshop_name}\"]\n      \n      pos_list = np.argwhere(grid[:, :, workshop_index] > 0)\n      if len(pos_list) == 0:\n          raise ValueError(f\"No available {workshop_name} to navigate to.\")\n      return pos_list[0].tolist()\n\n  def find_required_primitives(recipe):\n    required_primitives = []\n    for item, count in recipe.items():\n        if isinstance(item, str) and not item.startswith('_'):\n            required_primitives.append((item, count))\n    return required_primitives\n\n  def get_target_direction(env, target_pos):\n      \"\"\"Determine the direction to face before using a workshop.\"\"\"\n      current_pos = env._current_state.pos\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if dx == 1:\n          return env.world.N_ACTIONS - 3  # RIGHT action\n      elif dx == -1:\n          return env.world.N_ACTIONS - 4  # LEFT action\n      elif dy == 1:\n          return env.world.N_ACTIONS - 2  # DOWN action\n      elif dy == -1:\n          return env.world.N_ACTIONS - 5  # UP action\n\n      return None\n\n  def craft_intermediate_items(env, recipe):\n    actions = []\n    for item, count in recipe.items():\n        if isinstance(item, str) and not item.startswith('_') and item != 'workshop':\n            actions.extend(collect_primitive(env, item))\n        elif isinstance(item, int) and item not in env.world.grabbable_indices:\n            intermediate_item_name = env.world.cookbook.reverse_index[item]\n            intermediate_recipe = env.world.cookbook.recipes.get(intermediate_item_name)\n            if intermediate_recipe:\n                actions.extend(craft_v2(env, intermediate_item_name))\n    return actions\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the goal item is a primitive or not in the recipes\n  if item_index in env.world.grabbable_indices:\n      return []  # Primitives cannot be crafted\n  \n  # Retrieve the recipe for the desired item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Determine the workshop required for crafting\n  workshop_key = \"_at\"\n  workshop_name = next((k.split('_')[1] for k in recipe if k.startswith(workshop_key)), None)\n  if not workshop_name:\n      raise ValueError(f\"No workshop specified for crafting {item}.\")\n  \n  workshop_index = env.world.cookbook.index[f\"workshop{workshop_name}\"]\n  workshop_pos = find_workshop_position(env, f\"workshop{workshop_name}\")\n\n  actions = []\n\n  # Craft any required intermediate items\n  actions.extend(craft_intermediate_items(env, recipe))\n\n  # Collect all required primitives or intermediate items\n  required_primitives = find_required_primitives(recipe)\n  for primitive_name, count in required_primitives:\n      actions.extend(collect_primitive(env, primitive_name))\n      \n  # Navigate to the workshop and use it to craft the item\n  if not env._current_state.next_to(workshop_index):\n      actions.extend(navigate_to_position(env, workshop_pos))\n  \n  # Ensure correct facing direction before using the workshop\n  target_direction = get_target_direction(env, workshop_pos)\n  if target_direction:\n      actions.append(target_direction)\n\n  actions.append(env.world.N_ACTIONS - 1)  # USE action\n\n  return actions", "island_id": 1, "scores": {}}
