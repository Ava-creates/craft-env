et_direction):\n      # Determine which action to take to rotate towards the target direction\n      if target_direction[0] == -1:\n          return env.world.cookbook.index[\"LEFT\"]\n      elif target_direction[0] == 1:\n          return env.world.cookbook.index[\"RIGHT\"]\n      elif target_direction[1] == -1:\n          return env.world.cookbook.index[\"UP\"]\n      elif target_direction[1] == 1:\n          return env.world.cookbook.index[\"DOWN\"]\n\n  def get_rotated_direction(current_direction, action):\n      # Update the current direction based on the taken action\n      if action == env.world.cookbook.index[\"LEFT\"]:\n          return np.array([-current_direction[1], current_direction[0]])\n      elif action == env.world.cookbook.index[\"RIGHT\"]:\n          return np.array([current_direction[1], -current_direction[0]])\n      elif action == env.world.cookbook.index[\"UP\"]:\n          return np.array([0, -1])\n      elif action == env.world.cookbook.index[\"DOWN\"]:\n          return np.array([0, 1])\n\n  goal_index = env.world.cookbook.index[item]\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n\n  actions = []\n\n  if not required_primitives:\n    return [] # No recipe or no primitives needed, can't craft\n\n  # Check if all required primitives are already in inventory\n  for primitive, count in required_primitives.items():\n    if env._current_state.inventory[primitive] < count:\n      return [] # Not enough primitives to start crafting\n\n  # Find the workshop where we need to go to craft this item\n  workshop_index = None\n  for recipe_key, recipe in env.world.cookbook.recipes.items():\n    if \"_at\" in recipe and recipe[\"_at\"] == goal_index:\n      workshop_index = env.world.cookbook.index[recipe_key]\n      break\n\n  # Check if the required workshop exists\n  if workshop_index is None:\n    return [] # No suitable workshop found\n  \n  # Navigate to the closest workshop\n  target_pos = None\n  for x in range(env._current_state.grid.shape[0]):\n    for y in range(env._current_state.grid.shape[1]):\n      if env._current_state.grid[x, y, workshop_index] > 0:\n        target_pos = (x, y)\n        break\n    if target_pos is not None:\n      break\n  \n  # If no workshop is found, return an empty list\n  if target_pos is None:\n    return []\n\n  # Simple pathfinding to the workshop using A* algorithm\n  start_pos = env._current_state.pos\n  path = astar(start_pos, target_pos, env._current_state.grid.shape)\n\n  # Convert path into actions\n  if path:\n      for i in range(len(path) - 1):\n          dx = path[i + 1][0] - path[i][0]\n          dy = path[i + 1][1] - path[i][1]\n\n          if dx == 0 and dy == -1:\n              actions.append(env.world.cookbook.index[\"UP\"])\n          elif dx == 0 and dy == 1:\n              actions.append(env.world.cookbook.index[\"DOWN\"])\n          elif dx == -1 and dy == 0:\n              actions.append(env.world.cookbook.index[\"LEFT\"])\n          elif dx == 1 and dy == 0:\n              actions.append(env.world.cookbook.index[\"RIGHT\"])\n\n      # Orient the agent towards the workshop before using it\n      target_direction = np.array(target_pos) - np.array(path[-2])\n      current_direction = get_current_direction_from_state(env._current_state)\n\n      while not is_facing_correct_direction(current_direction, target_direction):\n          actions.append(rotate_towards_target_direction(current_direction, target_direction))\n          current_direction = get_rotated_direction(current_direction, rotate_towards_target_direction(current_direction, target_direction))\n\n  # Use action to craft the item at the workshop\n  actions.append(env.world.cookbook.index[\"USE\"])\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T13:08:08.937836", "function_name": "craft", "function_body": "  def get_workshop_position(workshop_required):\n      workshop_index = env.world.cookbook.index[workshop_required]\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n      if workshop_positions.size:\n          return tuple(workshop_positions[0])\n      else:\n          return None\n\n  def determine_facing_direction(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      directions = []\n      if dx > 0:\n          directions.append(craft.ACTION_RIGHT)\n      elif dx < 0:\n          directions.append(craft.ACTION_LEFT)\n\n      if dy > 0:\n          directions.append(craft.ACTION_DOWN)\n      elif dy < 0:\n          directions.append(craft.ACTION_UP)\n\n      return directions\n\n  def navigate_to(env, target_pos):\n      actions = []\n      current_pos = env._current_state.pos\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if dx > 0:\n          actions.extend([craft.ACTION_RIGHT] * abs(dx))\n      elif dx < 0:\n          actions.extend([craft.ACTION_LEFT] * abs(dx))\n\n      if dy > 0:\n          actions.extend([craft.ACTION_DOWN] * abs(dy))\n      elif dy < 0:\n          actions.extend([craft.ACTION_UP] * abs(dy))\n\n      return actions\n\n  item_index = env.world.cookbook.index[item]\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  current_inventory = {env.world.cookbook.index.get(i): env._current_state.inventory[i] for i in range(len(env._current_state.inventory))}\n\n  actions = []\n\n  # Check if we have all the primitives required\n  for primitive, count in required_primitives.items():\n    if current_inventory.get(primitive, 0) < count:\n      return []  # Return empty list as we do not have enough primitives\n\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_required = None\n  for key in recipe.keys():\n    if \"_at\" in key:\n      workshop_required = key.split(\"_at\")[1].strip()\n      break\n\n  if not workshop_required:\n    return []  # No valid workshop found in the recipe\n\n  target_workshop_position = get_workshop_position(workshop_required)\n  if not target_workshop_position:\n    return []  # No valid workshop found on the grid\n\n  actions.extend(navigate_to(env, target_workshop_position))\n\n  facing_directions = determine_facing_direction(env._current_state.pos, target_workshop_position)\n  for direction in facing_directions:\n      actions.append(direction)\n\n  actions.append(craft.ACTION_USE)\n\n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T13:08:10.039874", "function_name": "craft", "function_body": "  def get_workshop_position(workshop_required):\n      workshop_index = env.world.cookbook.index[workshop_required]\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n      if workshop_positions.size:\n          return tuple(workshop_positions[0])\n      else:\n          return None\n\n  def determine_facing_direction(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      # Determine the direction with the largest absolute difference\n      if abs(dx) > abs(dy):\n          # Horizontal movement\n          return craft.ACTION_RIGHT if dx > 0 else craft.ACTION_LEFT\n      else:\n          # Vertical movement\n          return craft.ACTION_DOWN if dy > 0 else craft.ACTION_UP\n\n  def navigate_to(env, target_pos):\n      actions = []\n      current_pos = env._current_state.pos\n      while current_pos != target_pos:\n          direction = determine_facing_direction(current_pos, target_pos)\n          if direction is not None:\n              actions.append(direction)\n          # Move in the determined direction\n          action = craft.ACTION_USE if current_pos == target_pos else direction\n          _, done, _ = env.step(action)\n          if done:\n              break\n          current_pos = env._current_state.pos  # Update position after step\n      return actions\n\n  item_index = env.world.cookbook.index[item]\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  current_inventory = {env.world.cookbook.index.get(i): env._current_state.inventory[i] for i in range(len(env._current_state.inventory))}\n\n  actions = []\n\n  # Check if we have all the primitives required\n  for primitive, count in required_primitives.items():\n    if current_inventory.get(primitive, 0) < count:\n      return []  # Return empty list as we do not have enough primitives\n\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_required = None\n  for key in recipe.keys():\n    if \"_at\" in key:\n      workshop_required = key.split(\"_at\")[1].strip()\n      break\n\n  if not workshop_required:\n    return []  # No valid workshop found in the recipe\n\n  target_workshop_position = get_workshop_position(workshop_required)\n  if not target_workshop_position:\n    return []  # No valid workshop found on the grid\n\n  actions.extend(navigate_to(env, target_workshop_position))\n\n  facing_direction = determine_facing_direction(env._current_state.pos, target_workshop_position)\n  if facing_direction is not None:\n      actions.append(facing_direction)\n\n  actions.append(craft.ACTION_USE)\n\n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T13:09:43.147510", "function_name": "craft", "function_body": "  # Get the index of the item we want to craft\n  item_index = env.world.cookbook.index[item]\n\n  # Check if there's a recipe for this item\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Extract the ingredients and the workshop from the recipe\n  recipe = env.world.cookbook.recipes[item_index]\n  ingredients_needed = {ingredient: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n  workshop_name = recipe[\"_at\"]\n  workshop_index = getattr(env.world, f\"{workshop_name}_index\")\n\n  # Determine the current inventory of the agent\n  inventory_dict = {\n      env.world.cookbook.index.get(i): count \n      for i, count in enumerate(env._current_state.inventory) if count > 0\n  }\n\n  # Check if we have all ingredients needed or need to collect more\n  actions_to_collect = []\n  actions_to_move = []\n\n  # First, check if the agent is already next to a workshop\n  pos_x, pos_y = env._current_state.pos\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  \n  nearest_workshop_pos = None\n\n  if workshop_positions.size:\n    distances = [abs(x - pos_x) + abs(y - pos_y) for x, y in workshop_positions]\n    nearest_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n    \n    # Check if the agent is already next to the closest workshop\n    dx = nearest_workshop_pos[0] - pos_x\n    dy = nearest_workshop_pos[1] - pos_y\n    \n    if abs(dx) <= 1 and abs(dy) <= 1:\n      actions_to_move.append(env.world.USE)\n      return actions_to_move\n\n  # Calculate the total number of each ingredient needed\n  for ingredient_index, count in ingredients_needed.items():\n    inventory_count = inventory_dict.get(ingredient_index, 0)\n    \n    if inventory_count < count:\n      # Determine actions to collect more of this ingredient\n      primitive_name = env.world.cookbook.index[ingredient_index]\n      \n      # Find positions of the ingredient in the grid\n      ingredient_positions = np.argwhere(env._current_state.grid[:, :, ingredient_index] == 1)\n      \n      if not ingredient_positions.size:\n        return []  # No available ingredients\n      \n      # Calculate distances to each ingredient and find the closest one\n      distances = [abs(x - pos_x) + abs(y - pos_y) for x, y in ingredient_positions]\n      nearest_ingredient_pos = tuple(ingredient_positions[np.argmin(distances)])\n      \n      # Determine actions to move to the nearest ingredient\n      while (pos_x, pos_y) != nearest_ingredient_pos:\n        dx = nearest_ingredient_pos[0] - pos_x\n        dy = nearest_ingredient_pos[1] - pos_y\n\n        if abs(dx) > abs(dy):\n          move_dir = \"RIGHT\" if dx > 0 else \"LEFT\"\n        else:\n          move_dir = \"DOWN\" if dy > 0 else \"UP\"\n\n        actions_to_collect.append(env.world.N_ACTIONS[move_dir])\n        pos_x, pos_y = env._current_state.pos\n\n      # Add USE action to collect the ingredient\n      actions_to_collect.extend([env.world.USE] * (count - inventory_count))\n\n  # After collecting all ingredients, determine actions to move back to a workshop and craft the item\n  if nearest_workshop_pos:\n    pos_x, pos_y = env._current_state.pos\n\n    while (pos_x, pos_y) != nearest_workshop_pos:\n      dx = nearest_workshop_pos[0] - pos_x\n      dy = nearest_workshop_pos[1] - pos_y\n\n      if abs(dx) > abs(dy):\n        move_dir = \"RIGHT\" if dx > 0 else \"LEFT\"\n      else:\n        move_dir = \"DOWN\" if dy > 0 else \"UP\"\n\n      actions_to_move.append(env.world.N_ACTIONS[move_dir])\n      pos_x, pos_y = env._current_state.pos\n\n    # Add USE action to craft the item\n    actions_to_move.append(env.world.USE)\n\n  return actions_to_collect + actions_to_move", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-10T13:09:44.102429", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if there's a recipe for this item\n  if item_index not in env.world.cookbook.recipes:\n    return []\n  \n  # Get the ingredients required to craft this item and the workshop where it needs to be crafted\n  recipe = env.world.cookbook.recipes[item_index]\n  ingredients_needed = {ingredient: count for ingredient, count in recipe.items() if ingredient != \"_at\"}\n  workshop_name = recipe[\"_at\"]\n  workshop_index = getattr(env.world, f\"{workshop_name}_index\")\n  \n  # Find the positions of all workshops of the required type in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if not workshop_positions.size:\n    return []\n  \n  # Determine the nearest workshop to move towards\n  pos_x, pos_y = env._current_state.pos\n  distances = [abs(x - pos_x) + abs(y - pos_y) for x, y in workshop_positions]\n  nearest_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n  \n  # Determine actions to move to the nearest workshop\n  actions_to_move = []\n  while (pos_x, pos_y) != nearest_workshop_pos:\n    dx = nearest_workshop_pos[0] - pos_x\n    dy = nearest_workshop_pos[1] - pos_y\n\n    if abs(dx) > abs(dy):\n      move_dir = \"RIGHT\" if dx > 0 else \"LEFT\"\n    else:\n      move_dir = \"DOWN\" if dy > 0 else \"UP\"\n\n    actions_to_move.append(env.world.N_ACTIONS[move_dir])\n\n    # Update the position after each move\n    if move_dir == \"RIGHT\":\n        pos_x += 1\n    elif move_dir == \"LEFT\":\n        pos_x -= 1\n    elif move_dir == \"DOWN\":\n        pos_y += 1\n    else:\n        pos_y -= 1\n\n  # Add USE action to craft the item\n  actions_to_move.append(env.world.USE)\n\n  return actions_to_move", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-10T13:10:40.745036", "function_name": "craft", "function_body": "  # Retrieve the index of the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Get the primitives needed to craft the desired item\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n\n  actions = []\n\n  # Check if we have all required primitives in our inventory\n  for primitive, count in required_primitives.items():\n    while env._current_state.inventory[primitive] < count:\n      # Find the location of the primitive in the grid\n      locations = np.argwhere(env._current_state.grid[:, :, primitive] == 1)\n      \n      if len(locations) > 0:\n        for loc in locations:\n          x, y = loc\n          \n          # Navigate to the location of the primitive\n          actions.extend(navigate_to(env._current_state, (x, y)))\n          \n          # Collect the primitive\n          actions.append(craft.COLLECT_FUNC(primitive))\n      else:\n        print(f\"Primitive {primitive} not found in grid.\")\n        return []\n\n  # Find the workshop where we can craft the item\n  workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n      workshop_index = next(iter(recipe))\n      break\n\n  if workshop_index is not None:\n    # Find the location of the workshop in the grid\n    locations = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    \n    if len(locations) > 0:\n      x, y = locations[0]\n      \n      # Navigate to the location of the workshop\n      actions.extend(navigate_to(env._current_state, (x, y)))\n      \n      # Craft the item\n      actions.append(craft.CRAFT_FUNC(item_index))\n    else:\n      print(f\"Workshop for {item} not found in grid.\")\n      return []\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-10T13:10:41.722942", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index for the item to be crafted from the cookbook\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the items/primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  inventory = env._current_state.inventory\n\n  # Check if the agent has all required primitives in their inventory\n  for primitive_index, count in required_primitives.items():\n    if inventory[primitive_index] < count:\n      return []  # If any primitive is missing, return empty action list\n\n  # Now that we have all the required items, proceed to craft the item\n  # Find the workshop specified in the recipe\n  for recipe_output, recipe_details in env.world.cookbook.recipes.items():\n    if recipe_output == item_index:\n      workshop_name = recipe_details[\"_at\"]\n      break\n\n  # Get the index of the workshop from the cookbook\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the nearest workshop in the grid\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  dir_ = env._current_state.dir\n\n  def get_nearest_workshop(workshop_index, grid):\n    positions = np.argwhere(grid[:, :, workshop_index] == 1)\n    distances = [np.linalg.norm(pos - p) for p in positions]\n    nearest_pos = positions[np.argmin(distances)]\n    return tuple(nearest_pos)\n\n  nearest_workshop_pos = get_nearest_workshop(workshop_index, grid)\n\n  # Calculate the actions to move to the workshop\n  path_to_workshop = find_path(grid, pos, nearest_workshop_pos)\n  actions.extend(path_to_workshop)\n\n  # Turn the agent to face the workshop\n  turn_action = calculate_turn(dir_, nearest_workshop_pos - np.array(pos))\n  actions.append(turn_action)\n\n  # Perform the USE action to craft the item\n  actions.append(env.world.craft_index)  # Assuming there's an index for the USE action\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-10T13:11:37.847223", "function_name": "craft", "function_body": "  # Step 1: Determine the required primitives for crafting the given item.\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  \n  if item not in index:\n    raise ValueError(f\"Unknown item: {item}\")\n  \n  goal_index = index[item]\n  required_primitives = cookbook.primitives_for(goal_index)\n  \n  actions = []\n\n  # Step 2: Collect the required primitives.\n  for primitive, count in required_primitives.items():\n    primitive_name = index.get(primitive)\n    while env._current_state.inventory[primitive] < count:\n      collect_actions = collect(env, primitive_name)\n      actions.extend(collect_actions)\n\n  # Step 3: Go to the workshop and use it to craft the item.\n  recipe = cookbook.recipes[goal_index]\n  workshop_type = recipe[\"_at\"]\n  \n  if workshop_type not in index:\n    raise ValueError(f\"Unknown workshop type: {workshop_type}\")\n  \n  workshop_index = index[workshop_type]\n\n  # Find a nearby workshop of the required type.\n  workshops = env.world.workshop_indices\n  target_workshop_pos = None\n\n  for pos in np.argwhere(env._current_state.grid[:, :, workshop_index] == 1):\n    if all(pos >= 0) and all(pos < env._current_state.grid.shape[:2]):\n      target_workshop_pos = tuple(pos)\n      break\n\n  if not target_workshop_pos:\n    raise ValueError(f\"No {workshop_type} found on the map.\")\n\n  # Move to the target workshop.\n  move_actions_to_workshop = move_to(env, target_workshop_pos)\n  actions.extend(move_actions_to_workshop)\n\n  # Craft the item by using the workshop.\n  use_action_index = env.world.n_actions - 1  # Assuming USE action is the last one\n  actions.append(use_action_index)\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-10T13:11:38.853040", "function_name": "craft", "function_body": "  # Initialize the action list\n  actions = []\n\n  # Get the index of the desired item using the cookbook\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the required primitives for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n\n  # Iterate over each required primitive and check if it's available in inventory or needs to be collected\n  for primitive, count in required_primitives.items():\n    while env._current_state.inventory[primitive] < count:\n      # Find the nearest cell with the required primitive\n      actions.extend(find_nearest_primitive(env, primitive))\n      actions.append(craft.MOVE_FUNC(\"UP\"))  # Placeholder move action to face the block\n\n      # Collect the required number of primitives\n      for _ in range(count - env._current_state.inventory[primitive]):\n        actions.append(craft.COLLECT_FUNC(env.world.cookbook.index.get(primitive)))\n\n  # Determine the workshop where crafting can occur\n  workshop_index = get_workshop_for_item(env, item)\n\n  if workshop_index is not None:\n    # Move to the nearest cell next to the required workshop\n    actions.extend(find_nearest_workshop(env, workshop_index))\n    actions.append(craft.MOVE_FUNC(\"UP\"))  # Placeholder move action to face the block\n\n    # Perform the USE action at the workshop\n    actions.append(craft.CRAFT_FUNC(item))\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-10T13:12:39.344773", "function_name": "craft", "function_body": "  # Get the goal index from the item name\n  if item not in env.world.cookbook.index:\n    raise ValueError(f\"Unknown item: {item}\")\n  \n  goal_index = env.world.cookbook.index[item]\n  actions = []\n\n  # Check if we have all the primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  inventory_dict = dict(zip(env.world.cookbook.kinds, env._current_state.inventory))\n  \n  for prim_idx, count in required_primitives.items():\n    if inventory_dict.get(prim_idx, 0) < count:\n      # If we don't have enough of a required primitive, return an empty action list\n      print(f\"Not enough {env.world.cookbook.index.get(prim_idx)}: Have {inventory_dict.get(prim_idx, 0)}, Need {count}\")\n      return []\n\n  # Determine the workshop to go to based on the recipe\n  recipe = env.world.cookbook.recipes[goal_index]\n  workshop_name = recipe[\"_at\"]\n  if workshop_name not in env.world.workshop_indices:\n    raise ValueError(f\"Unknown workshop: {workshop_name}\")\n\n  workshop_idx = env.world.index[workshop_name]\n\n  # Find the position of the nearest workshop\n  grid_with_workshops = np.any(env._current_state.grid[:, :, workshop_idx], axis=2)\n  workshops_positions = list(zip(*np.where(grid_with_workshops)))\n  if not workshops_positions:\n    raise ValueError(f\"No {workshop_name} found in the grid\")\n\n  # Find the closest workshop to the current position\n  current_pos = env._current_state.pos\n  nearest_workshop_pos = min(workshops_positions, key=lambda pos: np.linalg.norm(np.array(pos) - np.array(current_pos)))\n\n  # Navigate to the closest workshop\n  actions.extend(navigate_to(env, nearest_workshop_pos))\n\n  # Face the workshop and use it to craft the item\n  if not env._current_state.next_to(workshop_idx):\n    actions.append(craft.DIR_ACTION_MAP[\"USE\"])\n  \n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-10T13:12:40.318039", "function_name": "craft", "function_body": "  def move_to_workshop(workshop_idx):\n    # Placeholder function to move to a workshop\n    actions = []\n    for x in range(10):  # Example hardcoded path\n      actions.append(craft.N_ACTIONS - 5)  # Assuming UP action is the last one and others are 0-3 (LEFT, RIGHT, DOWN)\n    return actions\n\n  def use_workshop():\n    return [craft.N_ACTIONS - 4]  # Assuming USE action is the last one\n\n  item_idx = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes.get(item_idx)\n\n  if not recipe:\n      return []\n\n  actions = []\n  # Collect all required primitives\n  for ingredient, count in recipe.items():\n      if ingredient == \"_at\":\n          continue\n      ingredient_idx = env.world.cookbook.index[ingredient]\n      while np.sum(env._current_state.inventory[ingredient_idx]) < count:\n          collect_actions = collect_v2(env, ingredient)\n          actions.extend(collect_actions)\n\n  # Move to the workshop and use it\n  workshop_name = recipe[\"_at\"]\n  workshop_idx = env.world.cookbook.index[workshop_name]\n  actions.extend(move_to_workshop(workshop_idx))\n  actions.extend(use_workshop())\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-10T13:15:20.515955", "function_name": "craft", "function_body": "  def move_to_position(pos):\n    current_pos = env._current_state.pos\n    actions = []\n    while current_pos != pos:\n      delta_x = pos[0] - current_pos[0]\n      delta_y = pos[1] - current_pos[1]\n\n      if delta_x < 0:\n          actions.append(2)  # LEFT\n      elif delta_x > 0:\n          actions.append(3)  # RIGHT\n\n      if delta_y < 0:\n          actions.append(0)  # DOWN\n      elif delta_y > 0:\n          actions.append(1)  # UP\n      \n      # Execute the action to move one step closer\n      reward, done, observations = env.step(actions[-1])\n      current_pos = (observations['features_dict']['pos'] * env.world.WIDTH).astype(int), (observations['features_dict']['pos'] * env.world.HEIGHT).astype(int)\n\n    return actions\n\n  def face_workshop(workshop_pos):\n      current_pos = env._current_state.pos\n      delta_x = workshop_pos[0] - current_pos[0]\n      delta_y = workshop_pos[1] - current_pos[1]\n\n      direction_actions = []\n      if delta_x < 0:\n          direction_actions.append(2)  # LEFT\n      elif delta_x > 0:\n          direction_actions.append(3)  # RIGHT\n\n      if delta_y < 0:\n          direction_actions.append(0)  # DOWN\n      elif delta_y > 0:\n          direction_actions.append(1)  # UP\n      \n      return direction_actions[-1]  # Only the last action is needed to face the workshop\n\n  actions = []\n\n  # Convert item name to its index in the cookbook\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the required primitives for crafting the item\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n\n  # Check if we have all the required primitives in our inventory\n  missing_primitives = []\n  for primitive, required_count in required_primitives.items():\n    if inventory_dict.get(primitive, 0) < required_count:\n      missing_primitives.append((primitive, required_count))\n\n  # If there are any missing primitives, return an empty list of actions\n  if missing_primitives:\n    return []\n\n  # Determine the workshop where crafting should occur\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_required_key = [k for k in recipe.keys() if \"_at\" in k][0]\n  workshop_required_value = recipe[workshop_required_key].split(\"_\")[-1]\n\n  # Find the nearest workshop of the required type\n  closest_workshop_pos = None\n  min_distance = float('inf')\n\n  for pos in env.world.workshop_indices:\n    if pos[2] == env.world.cookbook.index.get(workshop_required_value):  # Check if it's the correct workshop type\n      distance = abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n      if distance < min_distance:\n        closest_workshop_pos = (pos[0], pos[1])\n        min_distance = distance\n\n  # Add actions to move to the nearest workshop\n  actions.extend(move_to_position(closest_workshop_pos))\n\n  # Face the workshop before using it\n  face_direction_action = face_workshop(closest_workshop_pos)\n  actions.append(face_direction_action)\n\n  # Add USE action to craft the item\n  actions.append(4)  # Assuming USE action is 4\n\n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T13:15:21.501741", "function_name": "craft", "function_body": "  def move_to_position(pos):\n    current_pos = env._current_state.pos\n    actions = []\n    while current_pos != pos:\n      delta_x = pos[0] - current_pos[0]\n      delta_y = pos[1] - current_pos[1]\n\n      if delta_x < 0:\n          actions.append(2)  # LEFT\n      elif delta_x > 0:\n          actions.append(3)  # RIGHT\n\n      if delta_y < 0:\n          actions.append(0)  # DOWN\n      elif delta_y > 0:\n          actions.append(1)  # UP\n      \n      # Execute the action to move one step closer\n      reward, done, observations = env.step(actions[-1])\n      current_pos = (observations['features_dict']['pos'] * env.world.WIDTH).astype(int)\n      \n    return actions\n\n  def face_workshop(workshop_pos):\n    current_pos = env._current_state.pos\n    delta_x = workshop_pos[0] - current_pos[0]\n    delta_y = workshop_pos[1] - current_pos[1]\n\n    direction_actions = []\n    if delta_x < 0:\n        direction_actions.append(2)  # LEFT\n    elif delta_x > 0:\n        direction_actions.append(3)  # RIGHT\n\n    if delta_y < 0:\n        direction_actions.append(0)  # DOWN\n    elif delta_y > 0:\n        direction_actions.append(1)  # UP\n    \n    return direction_actions[-1]  # Only the last action is needed to face the workshop\n  \n  def collect_primitives(primitive_indices):\n    actions = []\n    for primitive_index in primitive_indices:\n      # Find the nearest location of the primitive\n      closest_primitive_pos = None\n      min_distance = float('inf')\n\n      for pos in env.world.workshop_indices:  # Assuming we can find primitives at workshop locations for simplicity\n        if env._current_state.next_to(pos, primitive_index):\n          distance = abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n          if distance < min_distance:\n            closest_primitive_pos = (pos[0], pos[1])\n            min_distance = distance\n\n      # Add actions to move to the nearest primitive\n      actions.extend(move_to_position(closest_primitive_pos))\n\n      # Face the primitive before collecting it\n      face_direction_action = face_workshop(closest_primitive_pos)\n      actions.append(face_direction_action)\n\n      # Add COLLECT action for the primitive\n      actions.append(5)  # Assuming COLLECT action is 5\n\n    return actions\n  \n  actions = []\n\n  # Convert item name to its index in the cookbook\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the required primitives for crafting the item\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  inventory_dict = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n\n  # Identify missing primitives and collect them\n  missing_primitive_indices = []\n  for primitive, required_count in required_primitives.items():\n    if inventory_dict.get(primitive, 0) < required_count:\n      missing_primitive_indices.extend([primitive] * (required_count - inventory_dict.get(primitive, 0)))\n\n  if missing_primitive_indices:\n    actions.extend(collect_primitives(missing_primitive_indices))\n\n  # Determine the workshop where crafting should occur\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_required_key = [k for k, v in recipe.items() if \"_at\" in k][0]\n  workshop_required_name = recipe[workshop_required_key]\n\n  # Find the nearest workshop of the required type\n  closest_workshop_pos = None\n  min_distance = float('inf')\n\n  for pos in env.world.workshop_indices:\n    if env.world.cookbook.index.get(pos[2]) == workshop_required_name:  # Check if it's the correct workshop type\n      distance = abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n      if distance < min_distance:\n        closest_workshop_pos = (pos[0], pos[1])\n        min_distance = distance\n\n  # Add actions to move to the nearest workshop\n  actions.extend(move_to_position(closest_workshop_pos))\n\n  # Face the workshop before using it\n  face_direction_action = face_workshop(closest_workshop_pos)\n  actions.append(face_direction_action)\n\n  # Add USE action to craft the item\n  actions.append(4)  # Assuming USE action is 4\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-10T13:16:44.091675", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  goal_idx = env.world.cookbook.index[item]\n  \n  # Check if we have all required primitives for crafting\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)\n  current_inventory = env._current_state.inventory\n  \n  actions_to_take = []\n  \n  # Collect missing primitives\n  for primitive_idx, count in primitives_needed.items():\n      primitive_name = env.world.cookbook.index.get(primitive_idx)\n      \n      while np.sum(current_inventory[primitive_idx]) < count:\n          actions_to_collect_primitive = collect(env, primitive_name)\n          actions_to_take.extend(actions_to_collect_primitive)\n          \n          # Update the current state and inventory after collecting primitives\n          for action in actions_to_collect_primitive:\n              _, done, _ = env.step(action)\n              if done:\n                  return []  # If episode ends while collecting, stop crafting\n              \n          current_inventory = env._current_state.inventory\n  \n  # Go to the workshop specified in the recipe\n  workshop_idx = None\n  for ingredient_key, _ in env.world.cookbook.recipes[goal_idx].items():\n      if \"_at\" in ingredient_key:\n          workshop_name = env.world.cookbook.recipes[goal_idx][ingredient_key]\n          workshop_idx = env.world.cookbook.index[workshop_name]\n          break\n  \n  # Find the position of the required workshop\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_idx] > 0)\n  \n  if len(workshop_positions) == 0:\n      return []  # No workshop found for crafting\n  \n  target_workshop_pos = tuple(workshop_positions[0])\n  \n  # Move to the position of the required workshop\n  actions_to_move_to_workshop = move(env, env._current_state.pos, target_workshop_pos)\n  actions_to_take.extend(actions_to_move_to_workshop)\n  \n  # After reaching the workshop, perform the USE action to craft the item\n  actions_to_take.append(craft.USE)  # Assuming USE is defined in the craft module\n  \n  return actions_to_take", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-10T13:16:45.093364", "function_name": "craft", "function_body": "  # Convert item name to its corresponding index\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the recipe exists for the given item\n  if item_index not in env.world.cookbook.recipes:\n    print(f\"No recipe found for {item}.\")\n    return []\n\n  # Get the ingredients needed for the crafting\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Initialize a list to hold actions\n  actions = []\n  \n  # Collect all required primitives and intermediate items\n  for ingredient, count in recipe.items():\n      if ingredient == \"_key\":\n          continue\n      \n      # If the ingredient is already in inventory, skip it\n      if env._current_state.inventory[ingredient] >= count:\n          continue\n\n      # Otherwise, collect or craft the missing ingredients\n      if ingredient in env.world.cookbook.primitives:\n          # Collect primitives directly from the environment\n          actions.extend(collect_v2(env, env.world.cookbook.index.get(ingredient)))\n      else:\n          # Craft intermediate items\n          actions.extend(craft_v2(env, env.world.cookbook.index.get(env.world.cookbook.recipes[ingredient][\"_key\"])))\n\n  # Navigate to the correct workshop and use it to craft the item\n  workshop = recipe[\"_key\"]\n  workshop_index = env.world.workshop_indices[workshop]\n  \n  # Find the position of the workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  \n  if len(workshop_positions) == 0:\n      print(f\"No {workshop} found in the grid.\")\n      return []\n\n  # Choose the closest workshop to navigate to\n  current_pos = env._current_state.pos\n  distances = np.linalg.norm(workshop_positions - current_pos, axis=1)\n  closest_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n\n  # Move to the closest workshop position\n  actions.extend(move_to(env, closest_workshop_pos))\n  \n  # Face towards the workshop and use it\n  actions.append(face_towards_v2(env, closest_workshop_pos))\n  actions.append(craft.use)\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-10T13:17:45.628895", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the recipe exists for the item\n  if item_index not in env.world.cookbook.recipes:\n    print(f\"No recipe found for {item}\")\n    return []\n\n  # Get the primitives required to craft the item\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n\n  # Check if we already have all the required primitives\n  actions_to_take = []\n  inventory = env._current_state.inventory\n\n  # Collect any missing primitives\n  for primitive, count in required_primitives.items():\n    while inventory[primitive] < count:\n      actions_to_take.extend(collect_v2(env, env.world.cookbook.index.get(primitive)))\n\n  # Craft the item at the correct workshop\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_name = recipe[\"_at\"]\n  workshop_index = [i for i, idx in enumerate(env.world.workshop_indices) if env.world.cookbook.index.get(workshop_name) == idx][0]\n\n  # Find the closest workshop position on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  closest_workshop_pos = min(workshop_positions, key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1]))\n\n  # Move to the closest workshop\n  actions_to_take.extend(move_v2(env, closest_workshop_pos))\n\n  # Face the correct direction to use the workshop\n  actions_to_take.append(craft.DIR_RIGHT)  # Assuming we need to face right to use the workshop\n\n  # Use the workshop to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-10T13:17:46.709950", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we already have the required item in inventory or if it's a primitive\n  if env._current_state.inventory[item_index] > 0 or item_index in env.world.grabbable_indices:\n    return []\n  \n  # Get all primitives needed to craft this item\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  \n  # Collect all the required primitives\n  for primitive, count in primitives_needed.items():\n    actions.extend(collect_v2(env, env.world.cookbook.index.get(primitive)))\n  \n  # Now that we have collected all the necessary primitives, go to the appropriate workshop and craft the item\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_name = list(recipe[\"_key\"].split(\"_at=\"))[1] if \"_key\" in recipe else None\n  \n  if workshop_name:\n    workshop_indices = [idx for idx, name in enumerate(env.world.workshop_indices) \n                        if f\"{workshop_name}\" in env.world.cookbook.index.get(name)]\n    closest_workshop = find_closest_workshop(env._current_state.pos, workshop_indices)\n    actions.extend(move_to_workshop(env._current_state, closest_workshop))\n    \n    # Facing the correct direction before using\n    for _ in range(3):  # assuming the agent can rotate up to 3 times to face the correct direction\n      actions.append(craft.LEFT)  # or RIGHT\n    \n    actions.append(craft.USE)\n  \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T13:21:46.317071", "function_name": "craft", "function_body": "  def astar(start, goal, grid_shape):\n    open_set = collections.PriorityQueue()\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, goal)}\n\n    open_set.put((f_score[start], start))\n\n    while not open_set.empty():\n        _, current = open_set.get()\n\n        if current == goal:\n            return reconstruct_path(came_from, current)\n\n        for neighbor in neighbors(current, grid_shape):\n            tentative_g_score = g_score[current] + 1\n\n            if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                came_from[neighbor] = current\n                g_score[neighbor] = tentative_g_score\n                f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                open_set.put((f_score[neighbor], neighbor))\n\n    return []\n\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def neighbors(pos, grid_shape):\n      x, y = pos\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < grid_shape[0] and 0 <= ny < grid_shape[1]:\n              yield (nx, ny)\n\n  def reconstruct_path(came_from, current):\n      total_path = [current]\n      while current in came_from:\n          current = came_from[current]\n          total_path.append(current)\n      return total_path[::-1]\n\n  def get_current_direction_from_state(state):\n    # This function should determine the current direction of the agent based on the state\n    # Placeholder implementation assuming a fixed direction (e.g., UP)\n    return np.array([0, -1])\n\n  def is_facing_correct_direction(current_direction, target_direction):\n    # Check if the current direction matches the target direction\n    return np.array_equal(current_direction, target_direction)\n\n  def rotate_towards_target_direction(current_direction, target_direction):\n      # Determine the rotation action needed to face the target direction\n      if np.array_equal(target_direction, np.array([0, -1])):  # UP\n          return env.world.cookbook.index[\"UP\"]\n      elif np.array_equal(target_direction, np.array([0, 1])):   # DOWN\n          return env.world.cookbook.index[\"DOWN\"]\n      elif np.array_equal(target_direction, np.array([-1, 0])): # LEFT\n          return env.world.cookbook.index[\"LEFT\"]\n      elif np.array_equal(target_direction, np.array([1, 0])):  # RIGHT\n          return env.world.cookbook.index[\"RIGHT\"]\n\n  def get_rotated_direction(current_direction, action):\n    # Update the current direction based on the rotation action taken\n    if action == env.world.cookbook.index[\"UP\"]:\n        return np.array([0, -1])\n    elif action == env.world.cookbook.index[\"DOWN\"]:\n        return np.array([0, 1])\n    elif action == env.world.cookbook.index[\"LEFT\"]:\n        return np.array([-1, 0])\n    elif action == env.world.cookbook.index[\"RIGHT\"]:\n        return np.array([1, 0])\n\n  goal_index = env.world.cookbook.index[item]\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n\n  actions = []\n\n  if not required_primitives:\n    return [] # No recipe or no primitives needed, can't craft\n\n  # Check if all required primitives are already in inventory\n  for primitive, count in required_primitives.items():\n    if env._current_state.inventory[primitive] < count:\n      return [] # Not enough primitives to start crafting\n\n  # Find the workshop where we need to go to craft this item\n  workshop_index = None\n  for recipe_key, recipe in env.world.cookbook.recipes.items():\n    if \"_at\" in recipe and recipe[\"_at\"] == goal_index:\n      workshop_index = env.world.cookbook.index[recipe_key]\n      break\n\n  # Check if the required workshop exists\n  if workshop_index is None:\n    return [] # No suitable workshop found\n  \n  # Navigate to the closest workshop\n  target_pos = None\n  for x in range(env._current_state.grid.shape[0]):\n    for y in range(env._current_state.grid.shape[1]):\n      if env._current_state.grid[x, y, workshop_index] > 0:\n        target_pos = (x, y)\n        break\n    if target_pos is not None:\n      break\n  \n  # If no workshop is found, return an empty list\n  if target_pos is None:\n    return []\n\n  # Simple pathfinding to the workshop using A* algorithm\n  start_pos = env._current_state.pos\n  path = astar(start_pos, target_pos, env._current_state.grid.shape)\n\n  # Convert path into actions\n  if path:\n      for i in range(len(path) - 1):\n          dx = path[i + 1][0] - path[i][0]\n          dy = path[i + 1][1] - path[i][1]\n\n          if dx == 0 and dy == -1:\n              actions.append(env.world.cookbook.index[\"UP\"])\n          elif dx == 0 and dy == 1:\n              actions.append(env.world.cookbook.index[\"DOWN\"])\n          elif dx == -1 and dy == 0:\n              actions.append(env.world.cookbook.index[\"LEFT\"])\n          elif dx == 1 and dy == 0:\n              actions.append(env.world.cookbook.index[\"RIGHT\"])\n\n      # Orient the agent towards the workshop before using it\n      target_direction = np.array(target_pos) - np.array(path[-2])\n      current_direction = get_current_direction_from_state(env._current_state)\n\n      while not is_facing_correct_direction(current_direction, target_direction):\n          actions.append(rotate_towards_target_direction(current_direction, target_direction))\n          current_direction = get_rotated_direction(current_direction, rotate_towards_target_direction(current_direction, target_direction))\n\n  # Use action to craft the item at the workshop\n  actions.append(env.world.cookbook.index[\"USE\"])\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T13:21:47.424366", "function_name": "craft", "function_body": "  def astar(start, goal, grid_shape):\n    # A* algorithm implementation\n    open_set = collections.PriorityQueue()\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, goal)}\n\n    open_set.put((f_score[start], start))\n\n    while not open_set.empty():\n        _, current = open_set.get()\n\n        if current == goal:\n            return reconstruct_path(came_from, current)\n\n        for neighbor in neighbors(current, grid_shape):\n            tentative_g_score = g_score[current] + 1\n\n            if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                came_from[neighbor] = current\n                g_score[neighbor] = tentative_g_score\n                f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                open_set.put((f_score[neighbor], neighbor))\n\n    return []\n\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def neighbors(pos, grid_shape):\n      x, y = pos\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < grid_shape[0] and 0 <= ny < grid_shape[1]:\n              yield (nx, ny)\n\n  def reconstruct_path(came_from, current):\n      total_path = [current]\n      while current in came_from:\n          current = came_from[current]\n          total_path.append(current)\n      return total_path[::-1]\n\n  def get_current_direction_from_state(state):\n    # Assuming we have a method to determine the agent's direction from state\n    return state.direction\n\n  def is_facing_correct_direction(current_direction, target_direction):\n    # Normalize directions to unit vectors and compare\n    current_direction = np.array(current_direction) / np.linalg.norm(current_direction)\n    target_direction = np.array(target_direction) / np.linalg.norm(target_direction)\n\n    dot_product = np.dot(current_direction, target_direction)\n\n    return np.isclose(dot_product, 1.0)\n\n  def rotate_towards_target_direction(current_direction, target_direction):\n    # Determine the rotation action to face the target direction\n    current_angle = np.arctan2(current_direction[1], current_direction[0])\n    target_angle = np.arctan2(target_direction[1], target_direction[0])\n\n    angle_difference = target_angle - current_angle\n\n    if abs(angle_difference) < np.pi / 4:\n        return env.world.cookbook.index[\"USE\"]\n    elif angle_difference > 0:\n        return env.world.cookbook.index[\"RIGHT\"]\n    else:\n        return env.world.cookbook.index[\"LEFT\"]\n\n  def get_rotated_direction(current_direction, rotation_action):\n      # Update the agent's direction after applying a rotation action\n      if rotation_action == env.world.cookbook.index[\"RIGHT\"]:\n          angle = np.pi / 2\n      elif rotation_action == env.world.cookbook.index[\"LEFT\"]:\n          angle = -np.pi / 2\n\n      current_angle = np.arctan2(current_direction[1], current_direction[0])\n      new_angle = current_angle + angle\n\n      return (int(np.round(np.cos(new_angle))), int(np.round(np.sin(new_angle))))\n\n  goal_index = env.world.cookbook.index[item]\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n\n  actions = []\n\n  if not required_primitives:\n    return [] # No recipe or no primitives needed, can't craft\n\n  # Check if all required primitives are already in inventory\n  for primitive, count in required_primitives.items():\n    if env._current_state.inventory[primitive] < count:\n      return [] # Not enough primitives to start crafting\n\n  # Find the workshop where we need to go to craft this item\n  workshop_index = None\n  for recipe_key, recipe in env.world.cookbook.recipes.items():\n    if \"_at\" in recipe and recipe[\"_at\"] == goal_index:\n      workshop_index = env.world.cookbook.index[recipe_key]\n      break\n\n  # Check if the required workshop exists\n  if workshop_index is None:\n    return [] # No suitable workshop found\n  \n  # Navigate to the closest workshop\n  target_pos = None\n  for x in range(env._current_state.grid.shape[0]):\n    for y in range(env._current_state.grid.shape[1]):\n      if env._current_state.grid[x, y, workshop_index] > 0:\n        target_pos = (x, y)\n        break\n    if target_pos is not None:\n      break\n  \n  # If no workshop is found, return an empty list\n  if target_pos is None:\n    return []\n\n  # Simple pathfinding to the workshop using A* algorithm\n  start_pos = env._current_state.pos\n  path = astar(start_pos, target_pos, env._current_state.grid.shape)\n\n  # Convert path into actions\n  if path:\n      for i in range(len(path) - 1):\n          dx = path[i + 1][0] - path[i][0]\n          dy = path[i + 1][1] - path[i][1]\n\n          if dx == 0 and dy == -1:\n              actions.append(env.world.cookbook.index[\"UP\"])\n          elif dx == 0 and dy == 1:\n              actions.append(env.world.cookbook.index[\"DOWN\"])\n          elif dx == -1 and dy == 0:\n              actions.append(env.world.cookbook.index[\"LEFT\"])\n          elif dx == 1 and dy == 0:\n              actions.append(env.world.cookbook.index[\"RIGHT\"])\n\n      # Orient the agent towards the workshop before using it\n      target_direction = np.array(target_pos) - np.array(path[-2])\n      current_direction = get_current_direction_from_state(env._current_state)\n\n      while not is_facing_correct_direction(current_direction, target_direction):\n          actions.append(rotate_towards_target_direction(current_direction, target_direction))\n          current_direction = get_rotated_direction(current_direction, rotate_towards_target_direction(current_direction, target_direction))\n\n  # Use action to craft the item at the workshop\n  actions.append(env.world.cookbook.index[\"USE\"])\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T13:22:56.377849", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  item_idx = env.world.cookbook.index[item]\n  \n  # Retrieve the recipe for the item (if it exists)\n  if item_idx in env.world.cookbook.recipes:\n    recipe = env.world.cookbook.recipes[item_idx]\n    \n    actions = []\n    \n    # Check all ingredients needed and if we have them\n    for ingredient, count in recipe.items():\n        if ingredient == \"_at\":\n            workshop_name = recipe[\"_at\"]\n            workshop_idx = env.world.workshop_indices[env.world.cookbook.index[workshop_name]]\n            continue\n        \n        ingredient_idx = env.world.cookbook.index.get(ingredient)\n        if ingredient_idx is None:\n            # If the ingredient doesn't exist in our cookbook, we cannot proceed\n            return []\n        \n        while np.sum(env._current_state.inventory[ingredient_idx]) < count:\n            actions.extend(collect(env, ingredient))\n            \n            # Check if any of the collected items are part of other recipes to craft necessary items.\n            for other_item_idx in env.world.cookbook.recipes.keys():\n                if ingredient_idx in env.world.cookbook.primitives_for(other_item_idx):\n                    actions.extend(craft_v2(env, env.world.cookbook.index.get[other_item_idx]))\n    \n    # Now that we have all the ingredients, move to the workshop and craft the item\n    actions.append(move(env, workshop_name))\n    actions.append(USE_FUNC)\n  \n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-10T13:22:57.410756", "function_name": "craft", "function_body": "  # Initialize actions list\n  actions = []\n  \n  # Get the index of the desired item\n  goal_index = env.world.cookbook.index[item]\n  \n  # Check if the goal is a primitive or something that can be crafted\n  if goal_index in env.world.cookbook.primitives:\n    return []  # Primitives cannot be crafted\n  \n  # Get the recipe for the desired item\n  recipe = env.world.cookbook.recipes[goal_index]\n  \n  # Collect all required primitives and intermediate items\n  for ingredient, count in recipe.items():\n      if ingredient == \"_key\":\n          continue  # Skip \"_key\" which indicates the workshop\n    \n      ingredient_index = env.world.cookbook.index.get(ingredient)\n      \n      # Check if we already have enough of this ingredient\n      while np.sum(env._current_state.inventory[ingredient_index]) < count:\n          actions.extend(collect_v2(env, ingredient))\n  \n  # Go to the correct workshop and use it to craft the item\n  workshop = recipe[\"_key\"]\n  workshop_index = env.world.cookbook.index.get(workshop)\n  \n  # Find a position next to the workshop\n  workshop_positions = np.argwhere(np.any(env._current_state.grid[:, :, workshop_index], axis=2))\n  if len(workshop_positions) == 0:\n      return []  # No available workshops\n  \n  closest_workshop_pos = find_closest_position(env, workshop_positions)\n  \n  # Move to the position next to the workshop\n  actions.extend(move_to_position(env._current_state.pos, closest_workshop_pos, env.world.cookbook.index))\n  \n  # Turn to face the workshop and use it\n  facing_direction = calculate_facing_direction(env._current_state.pos, closest_workshop_pos)\n  actions.append(facing_direction)  # Assuming this is a valid direction index\n  \n  actions.append(craft.USE)  # Use action to craft the item\n  \n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-10T13:25:19.178364", "function_name": "craft", "function_body": "  def _move_to_workshop(workshop_index):\n      # Find the nearest workshop and move there using A* search\n      start = env._current_state.pos\n      goal = None\n      \n      for dx in range(-env.world.WIDTH, env.world.WIDTH + 1):\n          for dy in range(-env.world.HEIGHT, env.world.HEIGHT + 1):\n              target_pos = (start[0] + dx, start[1] + dy)\n              if 0 <= target_pos[0] < env.world.WIDTH and 0 <= target_pos[1] < env.world.HEIGHT:\n                  if np.any(env._current_state.grid[target_pos[0], target_pos[1]] == workshop_index):\n                      goal = target_pos\n                      break\n          if goal is not None:\n              break\n      \n      if goal is None:\n          return []\n      \n      def heuristic(a, b):\n          return abs(a[0] - b[0]) + abs(a[1] - b[1])\n      \n      open_set = collections.PriorityQueue()\n      open_set.put((0, start))\n      came_from = {}\n      g_score = {start: 0}\n      \n      while not open_set.empty():\n          _, current = open_set.get()\n          \n          if current == goal:\n              path = []\n              while current in came_from:\n                  path.append(current)\n                  current = came_from[current]\n              path.reverse()\n              actions = _convert_path_to_actions(path, start)\n              return actions\n          \n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              if 0 <= neighbor[0] < env.world.WIDTH and 0 <= neighbor[1] < env.world.HEIGHT:\n                  tentative_g_score = g_score[current] + 1\n                  if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                      came_from[neighbor] = current\n                      g_score[neighbor] = tentative_g_score\n                      f_score = tentative_g_score + heuristic(neighbor, goal)\n                      open_set.put((f_score, neighbor))\n      \n      return []\n  \n  def _convert_path_to_actions(path, start):\n      actions = []\n      cx, cy = start\n      \n      for x, y in path:\n          if cx < x:\n              actions.append(craft.RIGHT)\n          elif cx > x:\n              actions.append(craft.LEFT)\n          if cy < y:\n              actions.append(craft.DOWN)\n          elif cy > y:\n              actions.append(craft.UP)\n          cx, cy = x, y\n      \n      return actions\n  \n  def _has_required_primitives(primitive_indices):\n      for i in primitive_indices:\n          if env._current_state.inventory[i] <= 0:\n              return False\n      return True\n\n  index = env.world.cookbook.index\n  item_index = index[item]\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n\n  if \"_key\" in recipe:\n      key_index = recipe[\"_key\"]\n      workshop_index = env.world.workshop_indices[key_index]\n      \n      if not _has_required_primitives([i for i in recipe if i != \"_key\"]):\n          return []\n      \n      actions_to_workshop = _move_to_workshop(workshop_index)\n      \n      # Ensure the agent is facing the correct direction to use the workshop\n      target_pos = None\n      \n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          neighbor_pos = (env._current_state.pos[0] + dx, env._current_state.pos[1] + dy)\n          if 0 <= neighbor_pos[0] < env.world.WIDTH and 0 <= neighbor_pos[1] < env.world.HEIGHT:\n              if np.any(env._current_state.grid[neighbor_pos[0], neighbor_pos[1]] == workshop_index):\n                  target_pos = neighbor_pos\n                  break\n      \n      if target_pos is not None:\n          direction_to_target = (target_pos[0] - env._current_state.pos[0], target_pos[1] - env._current_state.pos[1])\n          \n          if direction_to_target == (-1, 0):\n              actions_to_workshop.append(craft.LEFT)\n          elif direction_to_target == (1, 0):\n              actions_to_workshop.append(craft.RIGHT)\n          elif direction_to_target == (0, -1):\n              actions_to_workshop.append(craft.UP)\n          elif direction_to_target == (0, 1):\n              actions_to_workshop.append(craft.DOWN)\n      \n      # Finally, add the USE action\n      actions_to_workshop.append(craft.USE)\n      return actions_to_workshop\n  \n  else:\n      return []", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T13:25:20.168403", "function_name": "craft", "function_body": "  def _move_to_position(target_pos):\n    # Implement a simple pathfinding algorithm to move towards the target position\n    x, y = target_pos\n    cx, cy = env._current_state.pos\n    actions = []\n    while (cx, cy) != (x, y):\n      if cx < x:\n        actions.append(craft.RIGHT)\n      elif cx > x:\n        actions.append(craft.LEFT)\n      if cy < y:\n        actions.append(craft.DOWN)\n      elif cy > y:\n        actions.append(craft.UP)\n      # Move one step closer\n      cx, cy = _next_position(cx, cy, actions[-1])\n    return actions\n\n  def _next_position(x, y, action):\n    if action == craft.RIGHT:\n      x += 1\n    elif action == craft.LEFT:\n      x -= 1\n    elif action == craft.DOWN:\n      y += 1\n    elif action == craft.UP:\n      y -= 1\n    return x, y\n\n  def _move_to_workshop(workshop_index):\n    # Find the nearest workshop and move there\n    actions = []\n    min_distance = float('inf')\n    target_pos = None\n    for dx in range(-env.world.WIDTH, env.world.WIDTH + 1):\n      for dy in range(-env.world.HEIGHT, env.world.HEIGHT + 1):\n        cx, cy = env._current_state.pos\n        target_x, target_y = cx + dx, cy + dy\n        if 0 <= target_x < env.world.WIDTH and 0 <= target_y < env.world.HEIGHT:\n          if np.any(env._current_state.grid[target_x, target_y] == workshop_index):\n              distance = abs(dx) + abs(dy)\n              if distance < min_distance:\n                  min_distance = distance\n                  target_pos = (target_x, target_y)\n\n    if target_pos is not None:\n        actions.extend(_move_to_position(target_pos))\n    return actions\n\n  def _has_required_primitives(primitive_indices):\n    for i in primitive_indices:\n      if env._current_state.inventory[i] <= 0:\n        return False\n    return True\n\n  index = env.world.cookbook.index\n  item_index = index[item]\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n\n  # Check if the required primitives are available in the inventory\n  primitive_indices = [i for i in recipe if i != \"_key\"]\n  if not _has_required_primitives(primitive_indices):\n    return []\n\n  # Find the workshop index and move to it\n  key_index = recipe[\"_key\"]\n  workshop_index = env.world.workshop_indices[key_index]\n  actions = _move_to_workshop(workshop_index)\n\n  # Use the USE action to craft the item\n  actions.append(craft.USE)\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-10T13:29:24.054920", "function_name": "craft", "function_body": "  def _move_to_workshop(workshop_index):\n    # Find the nearest workshop and move there using A* search\n    start = env._current_state.pos\n    goal = None\n    \n    for dx in range(-env.world.WIDTH, env.world.WIDTH + 1):\n        for dy in range(-env.world.HEIGHT, env.world.HEIGHT + 1):\n            target_pos = (start[0] + dx, start[1] + dy)\n            if 0 <= target_pos[0] < env.world.WIDTH and 0 <= target_pos[1] < env.world.HEIGHT:\n                if np.any(env._current_state.grid[target_pos[0], target_pos[1]] == workshop_index):\n                    goal = target_pos\n                    break\n        if goal is not None:\n            break\n    \n    if goal is None:\n        return []\n    \n    def heuristic(a, b):\n        return abs(a[0] - b[0]) + abs(a[1] - b[1])\n    \n    open_set = collections.PriorityQueue()\n    open_set.put((0, start))\n    came_from = {}\n    g_score = {start: 0}\n    \n    while not open_set.empty():\n        _, current = open_set.get()\n        \n        if current == goal:\n            path = []\n            while current in came_from:\n                path.append(current)\n                current = came_from[current]\n            path.reverse()\n            actions = _convert_path_to_actions(path, start)\n            return actions\n        \n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            neighbor = (current[0] + dx, current[1] + dy)\n            if 0 <= neighbor[0] < env.world.WIDTH and 0 <= neighbor[1] < env.world.HEIGHT:\n                tentative_g_score = g_score[current] + 1\n                if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                    came_from[neighbor] = current\n                    g_score[neighbor] = tentative_g_score\n                    f_score = tentative_g_score + heuristic(neighbor, goal)\n                    open_set.put((f_score, neighbor))\n    \n    return []\n\n  def _convert_path_to_actions(path, start):\n      actions = []\n      cx, cy = start\n      \n      for x, y in path:\n          if cx < x:\n              actions.append(craft.RIGHT)\n          elif cx > x:\n              actions.append(craft.LEFT)\n          if cy < y:\n              actions.append(craft.DOWN)\n          elif cy > y:\n              actions.append(craft.UP)\n          cx, cy = x, y\n      \n      return actions\n\n  def _has_required_primitives(primitive_indices):\n    for i in primitive_indices:\n        if env._current_state.inventory[i] <= 0:\n            return False\n    return True\n  \n  def _collect_primitive(primitive_index):\n    # Find the nearest primitive and move there using A* search\n    start = env._current_state.pos\n    goal = None\n    \n    for dx in range(-env.world.WIDTH, env.world.WIDTH + 1):\n        for dy in range(-env.world.HEIGHT, env.world.HEIGHT + 1):\n            target_pos = (start[0] + dx, start[1] + dy)\n            if 0 <= target_pos[0] < env.world.WIDTH and 0 <= target_pos[1] < env.world.HEIGHT:\n                if np.any(env._current_state.grid[target_pos[0], target_pos[1]] == primitive_index):\n                    goal = target_pos\n                    break\n        if goal is not None:\n            break\n    \n    if goal is None:\n        return []\n    \n    def heuristic(a, b):\n        return abs(a[0] - b[0]) + abs(a[1] - b[1])\n    \n    open_set = collections.PriorityQueue()\n    open_set.put((0, start))\n    came_from = {}\n    g_score = {start: 0}\n    \n    while not open_set.empty():\n        _, current = open_set.get()\n        \n        if current == goal:\n            path = []\n            while current in came_from:\n                path.append(current)\n                current = came_from[current]\n            path.reverse()\n            actions = _convert_path_to_actions(path, start) + [craft.USE]  # Add USE action to collect the primitive\n            return actions\n        \n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            neighbor = (current[0] + dx, current[1] + dy)\n            if 0 <= neighbor[0] < env.world.WIDTH and 0 <= neighbor[1] < env.world.HEIGHT:\n                tentative_g_score = g_score[current] + 1\n                if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                    came_from[neighbor] = current\n                    g_score[neighbor] = tentative_g_score\n                    f_score = tentative_g_score + heuristic(neighbor, goal)\n                    open_set.put((f_score, neighbor))\n    \n    return []\n\n  index = env.world.cookbook.index\n  item_index = index[item]\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n\n  if \"_key\" in recipe:\n      key_index = recipe[\"_key\"]\n      workshop_index = env.world.workshop_indices[key_index]\n      \n      # Collect all required primitives\n      actions = []\n      for primitive_index in [i for i in recipe if i != \"_key\"]:\n          if not _has_required_primitives([primitive_index]):\n              actions.extend(_collect_primitive(primitive_index))\n          \n          # Check again after collecting to ensure we have enough\n          if not _has_required_primitives([primitive_index]):\n              return []  # If still missing, return failure\n\n      # Move to the workshop and use it\n      actions_to_workshop = _move_to_workshop(workshop_index)\n      \n      # Ensure the agent is facing the correct direction to use the workshop\n      target_pos = None\n      \n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          neighbor_pos = (env._current_state.pos[0] + dx, env._current_state.pos[1] + dy)\n          if 0 <= neighbor_pos[0] < env.world.WIDTH and 0 <= neighbor_pos[1] < env.world.HEIGHT:\n              if np.any(env._current_state.grid[neighbor_pos[0], neighbor_pos[1]] == workshop_index):\n                  target_pos = neighbor_pos\n                  break\n      \n      if target_pos is not None:\n          direction_to_target = (target_pos[0] - env._current_state.pos[0], target_pos[1] - env._current_state.pos[1])\n          \n          if direction_to_target == (-1, 0):\n              actions_to_workshop.append(craft.LEFT)\n          elif direction_to_target == (1, 0):\n              actions_to_workshop.append(craft.RIGHT)\n          elif direction_to_target == (0, -1):\n              actions_to_workshop.append(craft.UP)\n          elif direction_to_target == (0, 1):\n              actions_to_workshop.append(craft.DOWN)\n      \n      # Finally, add the USE action\n      actions.extend(actions_to_workshop + [craft.USE])\n      return actions\n  \n  else:\n      return []", "island_id": 8, "scores": {"3": 0.0}}
