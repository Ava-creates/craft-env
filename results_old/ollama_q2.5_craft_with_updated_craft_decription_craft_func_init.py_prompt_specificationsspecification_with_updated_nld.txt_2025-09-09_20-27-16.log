or _ in range(-dx)])\n\n  if dy > 0:\n    actions_to_take.extend([craft.MOVE_DOWN for _ in range(dy)])\n  elif dy < 0:\n    actions_to_take.extend([craft.MOVE_UP for _ in range(-dy)])\n\n  # Calculate the target direction to face the workshop\n  current_direction = env._current_state.dir\n\n  if dx == 0 and dy == 0:  # Already at the workshop\n      pass\n  else:\n      # Determine the target direction based on the relative position of the workshop\n      if dx > 0:\n          target_direction = craft.RIGHT\n      elif dx < 0:\n          target_direction = craft.LEFT\n      elif dy > 0:\n          target_direction = craft.DOWN\n      else:  # dy < 0\n          target_direction = craft.UP\n\n      # Calculate the difference in directions and adjust accordingly\n      direction_diff = (target_direction - current_direction) % 4\n\n      if direction_diff == 1:\n          actions_to_take.append(craft.TURN_RIGHT)\n      elif direction_diff == 2:\n          actions_to_take.extend([craft.TURN_RIGHT, craft.TURN_RIGHT])\n      elif direction_diff == 3:\n          actions_to_take.append(craft.TURN_LEFT)\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-10T09:35:52.539180", "function_name": "craft", "function_body": "  # Helper function to collect required items\n  def collect_required_items(env, recipe):\n    actions = []\n    for primitive, count in recipe.items():\n      if primitive != \"_key\":\n        while np.sum(env._current_state.inventory[primitive]) < count:\n          actions.extend(collect(env, env.world.cookbook.index.get(primitive)))\n          actions.append(craft.USE)\n          actions.append(craft.MOVE_FORWARD)\n    return actions\n\n  # Helper function to go to the workshop\n  def navigate_to_workshop(env, workshop_index):\n    # Placeholder for navigation logic (simple BFS or A* can be used)\n    target_pos = None\n    for pos in np.argwhere(env._current_state.grid[:, :, workshop_index] > 0):\n      target_pos = tuple(pos)\n      break\n\n    if target_pos is not None:\n      actions = []\n      current_pos = env._current_state.pos\n      # Simple BFS to find the shortest path\n      queue = collections.deque([current_pos])\n      visited = set()\n      parent = {}\n\n      while queue:\n        pos = queue.popleft()\n        if pos == target_pos:\n          break\n        if pos in visited:\n          continue\n        visited.add(pos)\n        x, y = pos\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          nx, ny = x + dx, y + dy\n          if (nx, ny) not in visited and env._current_state.grid[nx, ny, :].sum() == 0:\n            queue.append((nx, ny))\n            parent[(nx, ny)] = pos\n\n      # Reconstruct the path\n      while target_pos != current_pos:\n        actions.extend(move(env._current_state.dir, craft.LEFT if nx < x else craft.RIGHT if nx > x else craft.UP if ny < y else craft.DOWN))\n        current_pos = (nx, ny)\n\n      return actions\n    return []\n\n  # Main logic to craft the item\n  index = env.world.cookbook.index.index(item)\n  recipe = env.world.cookbook.recipes[index]\n  \n  # Collect required items\n  actions = collect_required_items(env, recipe)\n  \n  # Navigate to workshop\n  if \"_key\" in recipe:\n    workshop_index = env.world.cookbook.index.index(recipe[\"_key\"])\n    actions.extend(navigate_to_workshop(env, workshop_index))\n  \n  # Craft the item using USE action\n  actions.append(craft.USE)\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-10T09:35:53.528345", "function_name": "craft", "function_body": "  actions = []\n\n  # Convert item name to index\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the recipe for the item exists\n  if item_index not in env.world.cookbook.recipes:\n    return []  # No recipe found\n\n  # Get the ingredients and their required counts from the recipe\n  recipe = env.world.cookbook.recipes[item_index]\n  ingredients = {k: v for k, v in recipe.items() if k != \"_key\"}\n\n  # Check if we have all the ingredients needed to craft the item\n  for ingredient, count in ingredients.items():\n    if env._current_state.inventory[ingredient] < count:\n      return []  # Missing required ingredients\n\n  # Determine which workshop is required\n  workshop = recipe[\"_key\"]\n\n  # Find the position of the required workshop\n  grid = env._current_state.grid\n  workshop_position = None\n  for y in range(grid.shape[0]):\n    for x in range(grid.shape[1]):\n      if grid[y, x, env.world.cookbook.index[workshop]] == 1:\n        workshop_position = (x, y)\n        break\n\n  if not workshop_position:\n    return []  # Workshop position not found\n\n  # Move to the workshop\n  current_pos = env._current_state.pos\n  direction = env._current_state.dir\n  x_diff = workshop_position[0] - current_pos[0]\n  y_diff = workshop_position[1] - current_pos[1]\n\n  # Calculate the actions needed to move to the workshop and face it\n  if x_diff > 0:\n    turn_right(direction, actions)\n    move_forward(x_diff, actions)\n  elif x_diff < 0:\n    turn_left(direction, actions)\n    move_forward(-x_diff, actions)\n\n  if y_diff > 0:\n    turn_down(direction, actions)\n    move_forward(y_diff, actions)\n  elif y_diff < 0:\n    turn_up(direction, actions)\n    move_forward(-y_diff, actions)\n\n  # Add USE action to craft the item\n  actions.append(env.world.cookbook.index[\"USE\"])\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-10T09:37:30.733554", "function_name": "craft", "function_body": "  actions = []\n  # Convert the item name to its index using the cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all required primitives for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  current_inventory = {env.world.cookbook.index.get(idx): count for idx, count in enumerate(env._current_state.inventory) if count > 0}\n  \n  # If any required primitive is missing, return empty action list\n  for req_item, req_count in required_primitives.items():\n    if current_inventory.get(req_item, 0) < req_count:\n      actions.extend(collect_primitives(env, item_index))\n      break\n\n  # Find the workshop required to craft this item\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_key = next(key for key in recipe.keys() if key.startswith(\"_at\"))\n  workshop_name = recipe[workshop_key]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n  \n  if len(workshop_positions) == 0:\n    return []\n\n  # Choose a random workshop position to head towards\n  workshop_pos = tuple(workshop_positions[env.world.random.randint(len(workshop_positions))])\n  \n  # Calculate the path from the current position to the chosen workshop\n  start_pos = env._current_state.pos\n  path = shortest_path(grid, start_pos, workshop_pos)\n  \n  if not path:\n    return []\n\n  # Generate actions to move along the calculated path\n  for target_pos in path[1:]:  # Skip the starting point\n    action = move_towards(env._current_state.pos, env._current_state.dir, target_pos)\n    if action is None:\n      continue  # Handle cases where no valid move exists\n    actions.append(action)\n\n  # Turn towards the workshop to face it\n  workshop_dir = direction_to(env._current_state.pos, workshop_pos)\n  while env._current_state.dir != workshop_dir:\n    actions.append(turn_towards(workshop_dir))\n  \n  # Add USE action to craft the item at the workshop\n  actions.append(craft.ACTIONS.USE)\n  \n  return actions", "island_id": 1, "scores": {"3": -1}}
