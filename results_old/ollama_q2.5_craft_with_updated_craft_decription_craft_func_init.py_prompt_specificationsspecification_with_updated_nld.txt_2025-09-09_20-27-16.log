{"timestamp": "2025-09-09T22:10:28.055588", "function_name": "craft", "function_body": "  def get_required_primitives(cookbook, item_index):\n    required_ingredients = {cookbook.index[k]: v for k, v in cookbook.recipes[item_index].items() if k in cookbook.primitives}\n    return required_ingredients\n\n  def collect_primitive(env, primitive_name) -> list[int]:\n      actions_to_take = []\n      \n      # Get the index of the primitive\n      primitive_index = env.world.cookbook.index[primitive_name]\n      \n      if not primitive_index:\n          raise ValueError(\"Unknown primitive\")\n      \n      # Find all positions of the required primitive in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] > 0)\n      \n      if len(primitive_positions) == 0:\n          raise ValueError(f\"No available {primitive_name} to collect\")\n      \n      # Select the nearest primitive\n      current_position = np.array(env._current_state.pos)\n      distances_to_primitives = np.linalg.norm(current_position - primitive_positions, axis=1)\n      nearest_primitive_index = np.argmin(distances_to_primitives)\n      nearest_primitive_pos = tuple(primitive_positions[nearest_primitive_index])\n      \n      # Calculate actions to move the agent to the nearest primitive\n      dx = nearest_primitive_pos[0] - current_position[0]\n      dy = nearest_primitive_pos[1] - current_position[1]\n\n      if dx > 0:\n          actions_to_take.extend([craft.MOVE_RIGHT for _ in range(dx)])\n      elif dx < 0:\n          actions_to_take.extend([craft.MOVE_LEFT for _ in range(-dx)])\n\n      if dy > 0:\n          actions_to_take.extend([craft.MOVE_DOWN for _ in range(dy)])\n      elif dy < 0:\n          actions_to_take.extend([craft.MOVE_UP for _ in range(-dy)])\n\n      # Add the COLLECT action to pick up the primitive\n      actions_to_take.append(craft.COLLECT)\n\n      return actions_to_take\n\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = env._current_state.inventory.copy()\n\n  # Check if all ingredients are available\n  required_primitives = get_required_primitives(cookbook, item_index)\n\n  actions_to_take = []\n\n  for ingredient_index, required_count in required_primitives.items():\n    while available_inventory.get(ingredient_index, 0) < required_count:\n      collect_actions = collect_primitive(env, cookbook.index.ordered_keys()[list(cookbook.index.values()).index(ingredient_index)])\n      actions_to_take.extend(collect_actions)\n      available_inventory[ingredient_index] = available_inventory.get(ingredient_index, 0) + 1\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No available workshop to craft item\")\n\n  # Select the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n  # Calculate actions to move the agent to the nearest workshop\n  dx = nearest_workshop_pos[0] - current_position[0]\n  dy = nearest_workshop_pos[1] - current_position[1]\n\n  if dx > 0:\n      actions_to_take.extend([craft.MOVE_RIGHT for _ in range(dx)])\n  elif dx < 0:\n      actions_to_take.extend([craft.MOVE_LEFT for _ in range(-dx)])\n\n  if dy > 0:\n      actions_to_take.extend([craft.MOVE_DOWN for _ in range(dy)])\n  elif dy < 0:\n      actions_to_take.extend([craft.MOVE_UP for _ in range(-dy)])\n\n  # Calculate the target direction to face the workshop\n  current_direction = env._current_state.dir\n\n  if dx == 0 and dy == 0:  # Already at the workshop\n      pass\n  elif dx > 0:\n      while current_direction != craft.RIGHT:\n          actions_to_take.append(craft.TURN_RIGHT)\n          current_direction = (current_direction + 1) % 4\n  elif dx < 0:\n      while current_direction != craft.LEFT:\n          actions_to_take.append(craft.TURN_LEFT)\n          current_direction = (current_direction - 1) % 4\n  elif dy > 0:\n      while current_direction != craft.DOWN:\n          actions_to_take.append(craft.TURN_RIGHT)\n          current_direction = (current_direction + 1) % 4\n  elif dy < 0:\n      while current_direction != craft.UP:\n          actions_to_take.append(craft.TURN_LEFT)\n          current_direction = (current_direction - 1) % 4\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-09T22:10:29.110609", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  if not workshop_name:\n    raise ValueError(\"No workshop specified in the recipe\")\n\n  workshop_index = cookbook.index[workshop_name]\n\n  available_inventory = env._current_state.inventory.copy()\n\n  # Check if all ingredients are available\n  required_ingredients = {cookbook.index[k]: v for k, v in recipe.items()}\n\n  can_craft = True\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if not can_craft:\n    return []\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No available workshop to craft item\")\n\n  # Select the nearest workshop\n  current_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n  # Calculate actions to move the agent to the nearest workshop\n  dx = nearest_workshop_pos[0] - current_position[0]\n  dy = nearest_workshop_pos[1] - current_position[1]\n\n  actions_to_take = []\n\n  if dx > 0:\n    actions_to_take.extend([craft.MOVE_RIGHT for _ in range(dx)])\n  elif dx < 0:\n    actions_to_take.extend([craft.MOVE_LEFT for _ in range(-dx)])\n\n  if dy > 0:\n    actions_to_take.extend([craft.MOVE_DOWN for _ in range(dy)])\n  elif dy < 0:\n    actions_to_take.extend([craft.MOVE_UP for _ in range(-dy)])\n\n  # Calculate the target direction to face the workshop\n  current_direction = env._current_state.dir\n\n  if dx == 0 and dy == 0:  # Already at the workshop\n      pass\n  elif dx > 0:\n      while current_direction != craft.RIGHT:\n          actions_to_take.append(craft.TURN_RIGHT)\n          current_direction = (current_direction + 1) % 4\n  elif dx < 0:\n      while current_direction != craft.LEFT:\n          actions_to_take.append(craft.TURN_LEFT)\n          current_direction = (current_direction - 1) % 4\n  elif dy > 0:\n      while current_direction != craft.DOWN:\n          actions_to_take.append(craft.TURN_RIGHT)\n          current_direction = (current_direction + 1) % 4\n  elif dy < 0:\n      while current_direction != craft.UP:\n          actions_to_take.append(craft.TURN_LEFT)\n          current_direction = (current_direction - 1) % 4\n\n  # Add the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-09T22:13:14.099987", "function_name": "craft", "function_body": "  def get_primitive_actions(primitive_index):\n    \"\"\"Returns a list of actions required to collect a primitive.\"\"\"\n    # Find all locations of the primitive in the grid\n    primitive_locations = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n    if len(primitive_locations) == 0:\n      return []\n\n    target_location = primitive_locations[np.random.choice(len(primitive_locations))]\n\n    actions = []\n    while env._current_state.pos != tuple(target_location):\n      dx, dy = target_location - np.array(env._current_state.pos)\n      direction = None\n      if dx < 0 and not env._current_state.next_to(env.world.cookbook.index['BOUNDARY']):\n        direction = env.world.N_ACTIONS.DOWN\n      elif dx > 0 and not env._current_state.next_to(env.world.cookbook.index['BOUNDARY']):\n        direction = env.world.N_ACTIONS.UP\n      elif dy < 0 and not env._current_state.next_to(env.world.cookbook.index['BOUNDARY']):\n        direction = env.world.N_ACTIONS.LEFT\n      elif dy > 0 and not env._current_state.next_to(env.world.cookbook.index['BOUNDARY']):\n        direction = env.world.N_ACTIONS.RIGHT\n\n      if direction is not None:\n        actions.append(direction)\n\n    # Add the USE action to collect the primitive\n    actions.append(env.world.N_ACTIONS.USE)\n    \n    return actions\n\n  def get_workshop_actions(workshop_index):\n    \"\"\"Returns a list of actions required to move to and use the workshop.\"\"\"\n    # Find all locations of the workshop in the grid\n    workshop_locations = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_locations) == 0:\n      return []\n\n    target_location = workshop_locations[np.random.choice(len(workshop_locations))]\n\n    actions = []\n    while env._current_state.pos != tuple(target_location):\n      dx, dy = target_location - np.array(env._current_state.pos)\n      direction = None\n      if dx < 0 and not env._current_state.next_to(env.world.cookbook.index['BOUNDARY']):\n        direction = env.world.N_ACTIONS.DOWN\n      elif dx > 0 and not env._current_state.next_to(env.world.cookbook.index['BOUNDARY']):\n        direction = env.world.N_ACTIONS.UP\n      elif dy < 0 and not env._current_state.next_to(env.world.cookbook.index['BOUNDARY']):\n        direction = env.world.N_ACTIONS.LEFT\n      elif dy > 0 and not env._current_state.next_to(env.world.cookbook.index['BOUNDARY']):\n        direction = env.world.N_ACTIONS.RIGHT\n\n      if direction is not None:\n        actions.append(direction)\n\n    # Add the USE action to use the workshop\n    actions.append(env.world.N_ACTIONS.USE)\n    \n    return actions\n\n  def has_all_primitives(primitive_counts):\n    \"\"\"Check if the agent's inventory has all required primitives.\"\"\"\n    for primitive_index, count in primitive_counts.items():\n      if env._current_state.inventory[primitive_index] < count:\n        return False\n    return True\n\n  # Get the index of the item to craft\n  item_index = env.world.cookbook.index[item]\n\n  # Get the primitive counts required to craft the item\n  primitive_counts = env.world.cookbook.primitives_for(item_index)\n\n  if not has_all_primitives(primitive_counts):\n    return []\n\n  actions = []\n  \n  # Collect all required primitives\n  for primitive, count in primitive_counts.items():\n    while env._current_state.inventory[primitive] < count:\n      actions.extend(get_primitive_actions(primitive))\n  \n  # Move to the workshop and use it to craft the item\n  if \"_key\" in env.world.cookbook.recipes[item_index]:\n    workshop_key = env.world.cookbook.recipes[item_index][\"_key\"]\n    workshop_index = env.world.cookbook.index[workshop_key]\n    actions.extend(get_workshop_actions(workshop_index))\n  \n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-09-09T22:13:15.212886", "function_name": "craft", "function_body": "  def get_primitive_actions(primitive_index):\n    \"\"\"Returns a list of actions required to collect a primitive.\"\"\"\n    # Find all locations of the primitive in the grid\n    primitive_locations = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n    if len(primitive_locations) == 0:\n      return []\n\n    # Sort locations by proximity to the current position\n    distances = np.linalg.norm(primitive_locations - env._current_state.pos, axis=1)\n    target_location = primitive_locations[np.argmin(distances)]\n\n    actions = []\n    while env._current_state.pos != tuple(target_location):\n      dx, dy = target_location - np.array(env._current_state.pos)\n      direction = None\n      if dx < 0 and not env._current_state.next_to(env.world.cookbook.index['BOUNDARY']):\n        direction = env.world.N_ACTIONS.DOWN\n      elif dx > 0 and not env._current_state.next_to(env.world.cookbook.index['BOUNDARY']):\n        direction = env.world.N_ACTIONS.UP\n      elif dy < 0 and not env._current_state.next_to(env.world.cookbook.index['BOUNDARY']):\n        direction = env.world.N_ACTIONS.LEFT\n      elif dy > 0 and not env._current_state.next_to(env.world.cookbook.index['BOUNDARY']):\n        direction = env.world.N_ACTIONS.RIGHT\n\n      if direction is not None:\n        actions.append(direction)\n\n    # Add the USE action to collect the primitive\n    actions.append(env.world.N_ACTIONS.USE)\n    \n    return actions\n\n  def get_workshop_actions(workshop_index):\n    \"\"\"Returns a list of actions required to move to and use the workshop.\"\"\"\n    # Find all locations of the workshop in the grid\n    workshop_locations = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_locations) == 0:\n      return []\n\n    # Sort locations by proximity to the current position\n    distances = np.linalg.norm(workshop_locations - env._current_state.pos, axis=1)\n    target_location = workshop_locations[np.argmin(distances)]\n\n    actions = []\n    while env._current_state.pos != tuple(target_location):\n      dx, dy = target_location - np.array(env._current_state.pos)\n      direction = None\n      if dx < 0 and not env._current_state.next_to(env.world.cookbook.index['BOUNDARY']):\n        direction = env.world.N_ACTIONS.DOWN\n      elif dx > 0 and not env._current_state.next_to(env.world.cookbook.index['BOUNDARY']):\n        direction = env.world.N_ACTIONS.UP\n      elif dy < 0 and not env._current_state.next_to(env.world.cookbook.index['BOUNDARY']):\n        direction = env.world.N_ACTIONS.LEFT\n      elif dy > 0 and not env._current_state.next_to(env.world.cookbook.index['BOUNDARY']):\n        direction = env.world.N_ACTIONS.RIGHT\n\n      if direction is not None:\n        actions.append(direction)\n\n    # Add the USE action to use the workshop\n    actions.append(env.world.N_ACTIONS.USE)\n    \n    return actions\n\n  def has_all_primitives(primitive_counts):\n    \"\"\"Check if the agent's inventory has all required primitives.\"\"\"\n    for primitive_index, count in primitive_counts.items():\n      if env._current_state.inventory[primitive_index] < count:\n        return False\n    return True\n\n  # Get the index of the item to craft\n  item_index = env.world.cookbook.index[item]\n\n  # Get the primitive counts required to craft the item\n  primitive_counts = env.world.cookbook.primitives_for(item_index)\n\n  if not has_all_primitives(primitive_counts):\n    return []\n\n  actions = []\n  \n  # Collect all required primitives\n  for primitive, count in primitive_counts.items():\n    for _ in range(count):\n      actions.extend(get_primitive_actions(primitive))\n  \n  # Move to the workshop and use it to craft the item\n  if \"_key\" in env.world.cookbook.recipes[item_index]:\n    workshop_key = env.world.cookbook.recipes[item_index][\"_key\"]\n    workshop_index = env.world.cookbook.index[workshop_key]\n    actions.extend(get_workshop_actions(workshop_index))\n  \n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-09-09T22:15:03.163401", "function_name": "craft", "function_body": "  # Retrieve the index for the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the item has a recipe in the cookbook\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the ingredients required for crafting the item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  actions = []\n  # Iterate over each ingredient and check if it is available or needs to be crafted further\n  for ingredient, count in recipe.items():\n      if ingredient == \"_key\":\n          continue  # Skip \"_key\" which indicates the workshop requirement\n\n      # Determine if the ingredient is a primitive or another crafted item\n      if ingredient in env.world.cookbook.primitives:\n          # Collect the primitive ingredient\n          actions.extend(collect(env, ingredient))\n      else:\n          # Recursively craft the non-primitive ingredient\n          actions.extend(craft_v2(env, ingredient))\n\n  # Find the workshop where the crafting should occur based on \"_key\" in the recipe\n  workshop_key = \"_key\"\n  if workshop_key in recipe:\n      workshop_index = env.world.cookbook.index[recipe[workshop_key]]\n      workshop_position = find_workshop_position(env, workshop_index)\n      actions.extend(move_to_position(env, workshop_position))\n      actions.append(craft.use_action())\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-09T22:15:04.146848", "function_name": "craft", "function_body": "  def find_workshop(workshop_index):\n    current_state = env._current_state\n    # Search for the nearest workshop using BFS\n    q = collections.deque([(*current_state.pos, None)])  # (x, y, parent_action)\n    visited = set()\n    \n    while q:\n      x, y, parent_action = q.popleft()\n      \n      if (x, y) in visited:\n          continue\n      visited.add((x, y))\n      \n      # Check if the current cell is the workshop\n      if env._current_state.grid[x, y, workshop_index] == 1:\n        path = []\n        while parent_action is not None:\n            path.append(parent_action)\n            parent_action = action_history[(x, y)]\n        return path[::-1]\n      \n      # Explore neighbors (UP, DOWN, LEFT, RIGHT)\n      for dx, dy, direction in [(-1, 0, craft.LEFT), (1, 0, craft.RIGHT), (0, -1, craft.UP), (0, 1, craft.DOWN)]:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n          # Check if the next cell is blocked\n          if not np.any(env._current_state.grid[nx, ny]) or (nx, ny) in visited:\n            continue\n          \n          action_history[(nx, ny)] = direction\n          q.append((nx, ny, direction))\n    \n    return []\n\n  def collect_primitive(primitive_index):\n      current_state = env._current_state\n      # Search for the nearest primitive using BFS\n      q = collections.deque([(*current_state.pos, None)])  # (x, y, parent_action)\n      visited = set()\n      \n      while q:\n          x, y, parent_action = q.popleft()\n          \n          if (x, y) in visited:\n              continue\n          visited.add((x, y))\n          \n          # Check if the current cell contains the primitive\n          if env._current_state.grid[x, y, primitive_index] == 1:\n            path = []\n            while parent_action is not None:\n                path.append(parent_action)\n                parent_action = action_history[(x, y)]\n            return path[::-1]\n          \n          # Explore neighbors (UP, DOWN, LEFT, RIGHT)\n          for dx, dy, direction in [(-1, 0, craft.LEFT), (1, 0, craft.RIGHT), (0, -1, craft.UP), (0, 1, craft.DOWN)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n                # Check if the next cell is blocked\n                if not np.any(env._current_state.grid[nx, ny]) or (nx, ny) in visited:\n                  continue\n                \n                action_history[(nx, ny)] = direction\n                q.append((nx, ny, direction))\n      \n      return []\n  \n  def get_primitive_counts(item_index):\n    # Get the primitives required for crafting the item\n    cookbook = env.world.cookbook.recipes[item_index]\n    primitives = {}\n    \n    for ingredient_index, count in cookbook.items():\n        if \"_at\" not in cookbook:\n            raise ValueError(f\"No workshop specified for recipe of {env.world.cookbook.index.get(item_index)}\")\n        if ingredient_index != \"_key\":\n            primitive_name = env.world.cookbook.index.get(ingredient_index)\n            primitives[primitive_name] = count\n    \n    return primitives\n\n  # Convert item name to index\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the primitives required for crafting the item\n  primitives = get_primitive_counts(item_index)\n\n  actions = []\n  # Collect all required primitives\n  for primitive, count in primitives.items():\n      primitive_index = env.world.cookbook.index[primitive]\n      while env._current_state.inventory[primitive_index] < count:\n          actions.extend(collect_primitive(primitive_index))\n          actions.append(craft.USE)\n\n  # Find the workshop and go there\n  workshop_index = env.world.cookbook.recipes[item_index][\"_at\"]\n  actions.extend(find_workshop(workshop_index))\n\n  # Use action to craft the item\n  actions.append(craft.USE)\n  \n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-09T22:17:41.196614", "function_name": "craft", "function_body": "  def move_to_position(target_pos):\n    current_pos = np.array(env._current_state.pos)\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    actions = []\n    if dx > 0:\n      actions.extend([craft.MOVE_RIGHT for _ in range(dx)])\n    elif dx < 0:\n      actions.extend([craft.MOVE_LEFT for _ in range(-dx)])\n\n    if dy > 0:\n      actions.extend([craft.MOVE_DOWN for _ in range(dy)])\n    elif dy < 0:\n      actions.extend([craft.MOVE_UP for _ in range(-dy)])\n\n    return actions\n\n  def rotate_to_direction(target_dir):\n    current_dir = env._current_state.dir\n    actions = []\n\n    while current_dir != target_dir:\n        if (target_dir - current_dir) % 4 == 1:\n            actions.append(craft.TURN_RIGHT)\n            current_dir = (current_dir + 1) % 4\n        elif (target_dir - current_dir) % 4 == 2:\n            actions.extend([craft.TURN_RIGHT, craft.TURN_RIGHT])\n            current_dir = (current_dir + 2) % 4\n        elif (target_dir - current_dir) % 4 == 3:\n            actions.append(craft.TURN_LEFT)\n            current_dir = (current_dir - 1) % 4\n\n    return actions\n\n  item_index = env.world.cookbook.index[item]\n  \n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n\n  # Check if we have all ingredients in inventory to craft this item\n  required_ingredients = recipe.copy()\n  required_ingredients.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  available_inventory = {env.world.cookbook.index[k]: v for k, v in env.world.cookbook.index.reverse_contents.items() if k in env._current_state.inventory}\n\n  # Check if all ingredients are available\n  can_craft = True\n  actions_to_take = []\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if can_craft:\n    # Determine the workshop to use based on the \"_at\" field of the recipe\n    workshop_name = recipe.get(\"_at\", None)\n    if workshop_name is not None:\n      workshop_index = env.world.cookbook.index[workshop_name]\n\n      # Find all positions of the required workshop in the grid\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n      if len(workshop_positions) == 0:\n        raise ValueError(\"No available workshop to craft item\")\n\n      # Select the nearest workshop\n      current_position = np.array(env._current_state.pos)\n      distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n      nearest_workshop_index = np.argmin(distances_to_workshops)\n      nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n      # Calculate actions to move the agent to the nearest workshop\n      actions_to_take.extend(move_to_position(nearest_workshop_pos))\n\n      # Rotate the agent to face the workshop (assuming facing up initially for simplicity)\n      target_direction = craft.UP\n      if nearest_workshop_pos[0] > current_position[0]:\n          target_direction = craft.RIGHT\n      elif nearest_workshop_pos[0] < current_position[0]:\n          target_direction = craft.LEFT\n      elif nearest_workshop_pos[1] > current_position[1]:\n          target_direction = craft.DOWN\n\n      actions_to_take.extend(rotate_to_direction(target_direction))\n\n      # Add the USE action to craft the item\n      actions_to_take.append(craft.USE)\n\n    else:\n      raise ValueError(\"No workshop specified in the recipe\")\n\n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-09T22:17:42.275286", "function_name": "craft", "function_body": "  def move_towards_target(target_pos):\n    current_position = np.array(env._current_state.pos)\n    dx = target_pos[0] - current_position[0]\n    dy = target_pos[1] - current_position[1]\n\n    actions_to_take = []\n    \n    if dx > 0:\n        actions_to_take.extend([craft.MOVE_RIGHT for _ in range(dx)])\n    elif dx < 0:\n        actions_to_take.extend([craft.MOVE_LEFT for _ in range(-dx)])\n\n    if dy > 0:\n        actions_to_take.extend([craft.MOVE_DOWN for _ in range(dy)])\n    elif dy < 0:\n        actions_to_take.extend([craft.MOVE_UP for _ in range(-dy)])\n    \n    return actions_to_take\n\n  def rotate_towards(target_direction):\n      current_direction = env._current_state.dir\n      directions = [craft.UP, craft.RIGHT, craft.DOWN, craft.LEFT]\n      \n      while current_direction != target_direction:\n          if (current_direction + 1) % 4 == target_direction:\n              actions_to_take.append(craft.TURN_RIGHT)\n              current_direction = (current_direction + 1) % 4\n          else:\n              actions_to_take.append(craft.TURN_LEFT)\n              current_direction = (current_direction - 1) % 4\n\n  item_index = env.world.cookbook.index[item]\n  \n  if not item_index:\n    raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n\n  # Check if we have all ingredients in inventory to craft this item\n  required_ingredients = recipe.copy()\n  required_ingredients.pop(\"_at\", None)  # Remove \"_at\" key which specifies workshop\n\n  available_inventory = {env.world.cookbook.index[k]: v for k, v in env.world.cookbook.index.reverse_contents.items() if k in env._current_state.inventory}\n\n  # Check if all ingredients are available\n  can_craft = True\n  actions_to_take = []\n\n  for ingredient_index, required_count in required_ingredients.items():\n    if ingredient_index not in available_inventory or available_inventory[ingredient_index] < required_count:\n      can_craft = False\n      break\n\n  if can_craft:\n    # Determine the workshop to use based on the \"_at\" field of the recipe\n    workshop_name = recipe.get(\"_at\", None)\n    if workshop_name is not None:\n      workshop_index = env.world.cookbook.index[workshop_name]\n\n      # Find all positions of the required workshop in the grid\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n      if len(workshop_positions) == 0:\n        raise ValueError(\"No available workshop to craft item\")\n\n      # Select the nearest workshop\n      current_position = np.array(env._current_state.pos)\n      distances_to_workshops = np.linalg.norm(current_position - workshop_positions, axis=1)\n      nearest_workshop_index = np.argmin(distances_to_workshops)\n      nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n      # Move towards the nearest workshop\n      actions_to_take.extend(move_towards_target(nearest_workshop_pos))\n      \n      # Rotate to face the workshop\n      target_direction = env._current_state.dir\n      if nearest_workshop_pos[0] > current_position[0]:\n          target_direction = craft.RIGHT\n      elif nearest_workshop_pos[0] < current_position[0]:\n          target_direction = craft.LEFT\n\n      if nearest_workshop_pos[1] > current_position[1]:\n          target_direction = craft.DOWN\n      elif nearest_workshop_pos[1] < current_position[1]:\n          target_direction = craft.UP\n      \n      actions_to_take.extend(rotate_towards(target_direction))\n\n      # Add the USE action to craft the item\n      actions_to_take.append(craft.USE)\n\n    else:\n      raise ValueError(\"No workshop specified in the recipe\")\n\n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-09T22:19:48.000145", "function_name": "craft", "function_body": "  def get_primitive_actions(primitive_index):\n    \"\"\"Returns a list of actions required to collect a primitive.\"\"\"\n    # Find all locations of the primitive in the grid\n    primitive_locations = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n    if len(primitive_locations) == 0:\n      return []\n\n    target_location = primitive_locations[np.random.choice(len(primitive_locations))]\n    \n    actions = []\n    while env._current_state.pos != tuple(target_location):\n      dx, dy = target_location - np.array(env._current_state.pos)\n      direction_actions = {\n          (dx < 0): env.world.N_ACTIONS.DOWN,\n          (dx > 0): env.world.N_ACTIONS.UP,\n          (dy < 0): env.world.N_ACTIONS.LEFT,\n          (dy > 0): env.world.N_ACTIONS.RIGHT\n      }\n      \n      for condition, action in direction_actions.items():\n          if condition and not env._current_state.next_to(env.world.cookbook.index['BOUNDARY']):\n              actions.append(action)\n              break\n\n    # Add the USE action to collect the primitive\n    actions.append(env.world.N_ACTIONS.USE)\n    \n    return actions\n\n  def get_workshop_actions(workshop_index):\n    \"\"\"Returns a list of actions required to move to and use the workshop.\"\"\"\n    workshop_locations = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_locations) == 0:\n      return []\n\n    target_location = workshop_locations[np.random.choice(len(workshop_locations))]\n    \n    actions = []\n    while env._current_state.pos != tuple(target_location):\n      dx, dy = target_location - np.array(env._current_state.pos)\n      direction_actions = {\n          (dx < 0): env.world.N_ACTIONS.DOWN,\n          (dx > 0): env.world.N_ACTIONS.UP,\n          (dy < 0): env.world.N_ACTIONS.LEFT,\n          (dy > 0): env.world.N_ACTIONS.RIGHT\n      }\n      \n      for condition, action in direction_actions.items():\n          if condition and not env._current_state.next_to(env.world.cookbook.index['BOUNDARY']):\n              actions.append(action)\n              break\n\n    # Add the USE action to use the workshop\n    actions.append(env.world.N_ACTIONS.USE)\n    \n    return actions\n\n  def has_all_primitives(primitive_counts):\n    \"\"\"Check if the agent's inventory has all required primitives.\"\"\"\n    for primitive_index, count in primitive_counts.items():\n      if env._current_state.inventory[primitive_index] < count:\n        return False\n    return True\n\n  # Get the index of the item to craft\n  item_index = env.world.cookbook.index[item]\n\n  # Get the primitive counts required to craft the item\n  primitive_counts = env.world.cookbook.primitives_for(item_index)\n\n  if not has_all_primitives(primitive_counts):\n    return []\n\n  actions = []\n  \n  for primitive, count in primitive_counts.items():\n    for _ in range(count):\n      actions.extend(get_primitive_actions(primitive))\n  \n  if \"_key\" in env.world.cookbook.recipes[item_index]:\n    workshop_key = env.world.cookbook.recipes[item_index][\"_key\"]\n    workshop_index = env.world.cookbook.index[workshop_key]\n    actions.extend(get_workshop_actions(workshop_index))\n\n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-09-09T22:19:49.070761", "function_name": "craft", "function_body": "  def get_primitive_actions(primitive_index):\n    primitive_locations = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n    \n    if len(primitive_locations) == 0:\n      return []\n\n    target_location = primitive_locations[np.random.choice(len(primitive_locations))]\n    actions = []\n    \n    while env._current_state.pos != tuple(target_location):\n      dx, dy = target_location - np.array(env._current_state.pos)\n      direction_actions = {\n          (dx < 0): env.world.N_ACTIONS.DOWN,\n          (dx > 0): env.world.N_ACTIONS.UP,\n          (dy < 0): env.world.N_ACTIONS.LEFT,\n          (dy > 0): env.world.N_ACTIONS.RIGHT\n      }\n      \n      for condition, action in direction_actions.items():\n          if condition:\n              actions.append(action)\n              break\n\n    actions.append(env.world.N_ACTIONS.USE)\n    return actions\n\n  def get_workshop_actions(workshop_index):\n    workshop_locations = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_locations) == 0:\n      return []\n\n    target_location = workshop_locations[np.random.choice(len(workshop_locations))]\n    \n    actions = []\n    \n    while env._current_state.pos != tuple(target_location):\n      dx, dy = target_location - np.array(env._current_state.pos)\n      \n      direction_actions = {\n          (dx < 0): env.world.N_ACTIONS.DOWN,\n          (dx > 0): env.world.N_ACTIONS.UP,\n          (dy < 0): env.world.N_ACTIONS.LEFT,\n          (dy > 0): env.world.N_ACTIONS.RIGHT\n      }\n      \n      for condition, action in direction_actions.items():\n          if condition:\n              actions.append(action)\n              break\n\n    actions.append(env.world.N_ACTIONS.USE)\n    return actions\n\n  def has_all_primitives(primitive_counts):\n    for primitive_index, count in primitive_counts.items():\n      if env._current_state.inventory[primitive_index] < count:\n        return False\n    return True\n\n  # Get the index of the item to craft\n  item_index = env.world.cookbook.index[item]\n\n  # Get the primitive counts required to craft the item\n  primitive_counts = env.world.cookbook.primitives_for(item_index)\n\n  if not has_all_primitives(primitive_counts):\n    return []\n\n  actions = []\n  \n  for primitive, count in primitive_counts.items():\n    for _ in range(count):\n      actions.extend(get_primitive_actions(primitive))\n  \n  if \"_key\" in env.world.cookbook.recipes[item_index]:\n    workshop_key = env.world.cookbook.recipes[item_index][\"_key\"]\n    workshop_index = env.world.cookbook.index[workshop_key]\n    actions.extend(get_workshop_actions(workshop_index))\n\n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-09-09T22:21:38.405179", "function_name": "craft", "function_body": "  # Get the index of the desired item from the cookbook\n  goal_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the ingredients required to craft the item\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  \n  # Collect primitives that are not in inventory\n  actions_to_take = []\n  for primitive_index, count in required_primitives.items():\n    if env._current_state.inventory[primitive_index] < count:\n      # Find the location of the primitive\n      locations = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      for loc in locations:\n        x, y = loc\n        while not (env._current_state.pos == (x, y)):\n          # Calculate direction to move towards the primitive\n          dx, dy = x - env._current_state.pos[0], y - env._current_state.pos[1]\n          if abs(dx) > abs(dy):\n            actions_to_take.append(3 if dx < 0 else 2)\n          else:\n            actions_to_take.append(1 if dy > 0 else 0)\n        # Collect the primitive\n        actions_to_take.append(4)\n  \n  # Go to the workshop and craft the item\n  workshop_index = None\n  for i, recipes in env.world.cookbook.recipes.items():\n    if goal_index in recipes:\n      workshop_index = recipes[\"_at\"]\n      break\n  \n  if workshop_index is not None:\n    workshop_locations = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    for loc in workshop_locations:\n      x, y = loc\n      while not (env._current_state.pos == (x, y)):\n        # Calculate direction to move towards the workshop\n        dx, dy = x - env._current_state.pos[0], y - env._current_state.pos[1]\n        if abs(dx) > abs(dy):\n          actions_to_take.append(3 if dx < 0 else 2)\n        else:\n          actions_to_take.append(1 if dy > 0 else 0)\n      # Craft the item\n      actions_to_take.append(4)\n  \n  return actions_to_take", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-09T22:21:39.469580", "function_name": "craft", "function_body": "  # Convert item name to index\n  goal_index = env.world.cookbook.index[item]\n  \n  # Get the primitives required for the given item\n  required_primitives = env.world.cookbook.primitives_for(goal_index)\n  \n  # Initialize actions list\n  actions = []\n  \n  # Collect all required primitives\n  for primitive, count in required_primitives.items():\n    while env._current_state.inventory[primitive] < count:\n      actions.extend(collect(env, env.world.cookbook.index.get(primitive)))\n    \n  # Find the workshop and perform the USE action to craft the item\n  for recipe, details in env.world.cookbook.recipes.items():\n    if goal_index == recipe:\n      workshop = details['_key']\n      \n      # Navigate to the workshop\n      actions.extend(move_to_workshop(env, workshop))\n      \n      # Perform the USE action at the workshop\n      actions.append(craft.USE)\n      \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-09T22:22:54.920289", "function_name": "craft", "function_body": "  actions = []\n  # Get the index of the item to craft\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we already have the item in our inventory\n  if env._current_state.inventory[item_index] > 0:\n    return actions\n  \n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n  \n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  # Check if we have all the required primitives in our inventory\n  for ingredient_index, count in recipe.items():\n    if ingredient_index == \"_key\":\n      continue  # Skip the key that indicates the workshop\n    if env._current_state.inventory[ingredient_index] < count:\n      return []  # Not enough ingredients\n\n  # Go to the correct workshop and use it to craft the item\n  workshop = recipe.get(\"_key\")\n  if not workshop:\n    raise ValueError(f\"No workshop specified in recipe for {item}\")\n\n  workshop_indices = env.world.workshop_indices\n  target_workshop_index = workshop_indices[env.world.cookbook.index[workshop]]\n\n  # Find the position of the closest workshop\n  current_pos = np.array(env._current_state.pos)\n  distances = np.linalg.norm(current_pos - np.array(workshop_positions), axis=1)\n  closest_workshop_position = workshop_positions[np.argmin(distances)]\n\n  # Generate actions to move to the closest workshop\n  target_x, target_y = closest_workshop_position\n  current_x, current_y = env._current_state.pos\n\n  # Move horizontally first\n  if current_x < target_x:\n    actions.extend([env.N_ACTIONS.LEFT] * (target_x - current_x))\n  elif current_x > target_x:\n    actions.extend([env.N_ACTIONS.RIGHT] * (current_x - target_x))\n\n  # Then move vertically\n  if current_y < target_y:\n    actions.extend([env.N_ACTIONS.DOWN] * (target_y - current_y))\n  elif current_y > target_y:\n    actions.extend([env.N_ACTIONS.UP] * (current_y - target_y))\n\n  # Add the USE action to craft the item\n  actions.append(env.N_ACTIONS.USE)\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-09T22:22:55.941613", "function_name": "craft", "function_body": "  index = env.world.cookbook.index\n  goal_index = index[item]\n\n  # Check if the goal is a primitive\n  if goal_index in env.world.primitives:\n    raise ValueError(f\"Cannot craft a primitive: {item}\")\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(goal_index, {})\n\n  # If no recipe found, return empty action list\n  if not recipe:\n    return []\n\n  # Check if all ingredients are available in inventory\n  actions = []\n  for ingredient, count in recipe.items():\n    if ingredient == \"_key\":\n      continue  # Skip the key which indicates the workshop\n\n    ingredient_index = index[ingredient]\n    required_count = count\n\n    # Calculate how many more of this ingredient we need to collect\n    have_count = env._current_state.inventory[ingredient_index]\n\n    if have_count < required_count:\n      # If we don't have enough, find where to get it and add actions to collect\n      collect_actions = collect(env, index.get(ingredient))\n      if not collect_actions:\n        return []  # Unable to collect ingredient\n\n      actions.extend(collect_actions)\n\n  # Check which workshop is needed for crafting\n  workshop_name = recipe[\"_key\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the nearest workshop and add actions to move there\n  move_to_workshop_actions = move_to(env, workshop_index)\n  if not move_to_workshop_actions:\n    return []  # Unable to find a path to the workshop\n\n  actions.extend(move_to_workshop_actions)\n\n  # Add action to use the workshop (crafting)\n  actions.append(craft.CRAFT_FUNC(workshop_index))\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-09T22:23:44.843236", "function_name": "craft", "function_body": "  # Step 1: Resolve the index for the desired item\n  cookbook = env.world.cookbook\n  if item not in cookbook.index:\n    print(f\"Item {item} not found in cookbook.\")\n    return []\n\n  goal_index = cookbook.index[item]\n  \n  # Step 2: Check if the item can be crafted (i.e., has a recipe)\n  if goal_index not in cookbook.recipes:\n    print(f\"No crafting recipe for {item}.\")\n    return []\n  \n  # Step 3: Retrieve the recipe and required ingredients\n  recipe = cookbook.recipes[goal_index]\n  \n  actions = []\n\n  # Step 4: Check if we have all the primitives required to craft this item in inventory\n  for ingredient, count in recipe.items():\n    if ingredient == \"_at\": \n      continue\n    ingredient_index = cookbook.index[ingredient]\n    if env._current_state.inventory[ingredient_index] < count:\n        print(f\"Missing {count} {ingredient}(s) to craft {item}.\")\n        return []\n\n  # Step 5: Identify the workshop required for crafting (specified in recipe)\n  workshop_name = recipe[\"_at\"]\n  workshop_index = cookbook.index[workshop_name]\n\n  # Step 6: Navigate to the nearest available workshop\n  actions.extend(navigate_to_workshop(env, workshop_index))\n  \n  # Step 7: Face the workshop and perform the USE action to craft the item\n  if face_and_use(env, workshop_index):\n    actions.append(4)  # Use action\n  \n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-09T22:23:45.806369", "function_name": "craft", "function_body": "  index = env.world.cookbook.index\n  goal_index = index[item]\n  \n  # Check if the goal is a primitive or already in inventory\n  if goal_index in env.world.primitives:\n    return []\n  \n  # Get the recipe for the item\n  recipe = env._current_state.world.cookbook.recipes[goal_index]\n\n  required_items = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  actions = []\n\n  # Collect all required items\n  for required_item_name, count in required_items.items():\n    required_item_index = index[required_item_name]\n    while env._current_state.inventory[required_item_index] < count:\n      collect_actions = collect(env, required_item_name)\n      if not collect_actions:\n        return []\n      actions.extend(collect_actions)\n\n  # Go to the workshop and craft the item\n  workshop_index = index[recipe[\"_at\"]]\n  move_to_workshop_actions = move_to_workshop(env, workshop_index)\n  actions.extend(move_to_workshop_actions)\n\n  actions.append(craft.CRAFT_FUNC(workshop_index))\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-09T22:25:05.429293", "function_name": "craft", "function_body": "  def find_closest_workshop(workshop_indices):\n    pos = env._current_state.pos\n    closest_workshop = None\n    min_distance = float('inf')\n    for workshop_index in workshop_indices:\n      for x in range(env.world.grid.shape[0]):\n        for y in range(env.world.grid.shape[1]):\n          if env._current_state.grid[x, y, workshop_index] > 0:\n            distance = abs(x - pos[0]) + abs(y - pos[1])\n            if distance < min_distance:\n              min_distance = distance\n              closest_workshop = (x, y)\n    return closest_workshop\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the desired item is a primitive; primitives cannot be crafted.\n  if item_index in env.world.cookbook.primitives:\n    return []\n\n  # Fetch the recipe for crafting the specified item.\n  recipe = env.world.cookbook.recipes.get(item_index)\n\n  # If no valid recipe exists or \"_key\" not specified, return an empty action list.\n  if not recipe or \"_key\" not in recipe:\n    return []\n\n  workshop_key = recipe[\"_key\"]\n  workshop_indices = [env.world.cookbook.index[workshop_key]]\n\n  actions = []\n  # Check inventory for sufficient primitives.\n  missing_ingredients = {}\n  for ingredient, count in recipe.items():\n    if ingredient == \"_key\":\n      continue\n    ingredient_index = env.world.cookbook.index[ingredient]\n    current_count = env._current_state.inventory[ingredient_index]\n    if current_count < count:\n      missing_ingredients[ingredient] = count - current_count\n\n  # If any ingredients are missing, attempt to collect them.\n  for ingredient, required_count in missing_ingredients.items():\n    ingredient_index = env.world.cookbook.index[ingredient]\n    actions.extend(collect_v2(env, ingredient, required_count))\n\n  # Find the closest workshop that can craft the item.\n  closest_workshop_pos = find_closest_workshop(workshop_indices)\n  if closest_workshop_pos is None:\n    return []\n\n  # Move to the closest workshop.\n  target_x, target_y = closest_workshop_pos\n  actions.extend(move_to_position(env._current_state.pos, (target_x, target_y)))\n\n  # Use the USE action at the correct location.\n  actions.append(craft.ACTION_USE)\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-09T22:25:06.482107", "function_name": "craft", "function_body": "  # Convert item name to index using the cookbook's index mapping.\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the desired item is a primitive; primitives cannot be crafted.\n  if item_index in env.world.cookbook.primitives:\n    return []\n\n  # Fetch the recipe for crafting the specified item.\n  recipe = env.world.cookbook.recipes.get(item_index)\n\n  # If no valid recipe exists or \"_key\" not specified, return an empty action list.\n  if not recipe or \"_key\" not in recipe:\n    return []\n\n  workshop_key = recipe[\"_key\"]\n  workshop_index = env.world.cookbook.index[workshop_key]\n\n  actions = []\n  # Check inventory for sufficient primitives.\n  missing_ingredients = {}\n  for ingredient, count in recipe.items():\n    if ingredient == \"_key\":\n      continue\n    ingredient_index = env.world.cookbook.index[ingredient]\n    current_count = env._current_state.inventory[ingredient_index]\n    if current_count < count:\n      missing_ingredients[ingredient] = count - current_count\n\n  # If any ingredients are missing, attempt to collect them.\n  for ingredient, required_count in missing_ingredients.items():\n    ingredient_index = env.world.cookbook.index[ingredient]\n    actions.extend(collect_v3(env, ingredient, required_count))\n\n  # Move to a workshop that can craft the item.\n  actions.extend(move_to_workshop(env, workshop_index))\n\n  # Use the USE action at the correct location.\n  actions.append(craft.ACTION_USE)\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-09T22:27:23.119748", "function_name": "craft", "function_body": "  def get_primitive_actions(primitive_index):\n    \"\"\"Returns a list of actions required to collect a primitive.\"\"\"\n    # Find all locations of the primitive in the grid\n    primitive_locations = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n    \n    if len(primitive_locations) == 0:\n      return []\n\n    target_location = primitive_locations[np.random.choice(len(primitive_locations))]\n    path = find_path(env, env._current_state.pos, tuple(target_location))\n    \n    actions = []\n    for dx, dy in path:\n      direction = (dx, dy)\n      \n      if direction == (-1, 0):\n        actions.append(env.world.N_ACTIONS.DOWN)\n      elif direction == (1, 0):\n        actions.append(env.world.N_ACTIONS.UP)\n      elif direction == (0, -1):\n        actions.append(env.world.N_ACTIONS.LEFT)\n      elif direction == (0, 1):\n        actions.append(env.world.N_ACTIONS.RIGHT)\n\n    # Add the USE action to collect the primitive\n    actions.append(env.world.N_ACTIONS.USE)\n    \n    return actions\n\n  def get_workshop_actions(workshop_index):\n    \"\"\"Returns a list of actions required to move to and use the workshop.\"\"\"\n    # Find all locations of the workshop in the grid\n    workshop_locations = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_locations) == 0:\n      return []\n\n    target_location = workshop_locations[np.random.choice(len(workshop_locations))]\n    path = find_path(env, env._current_state.pos, tuple(target_location))\n    \n    actions = []\n    for dx, dy in path:\n      direction = (dx, dy)\n      \n      if direction == (-1, 0):\n        actions.append(env.world.N_ACTIONS.DOWN)\n      elif direction == (1, 0):\n        actions.append(env.world.N_ACTIONS.UP)\n      elif direction == (0, -1):\n        actions.append(env.world.N_ACTIONS.LEFT)\n      elif direction == (0, 1):\n        actions.append(env.world.N_ACTIONS.RIGHT)\n\n    # Add the USE action to use the workshop\n    actions.append(env.world.N_ACTIONS.USE)\n    \n    return actions\n\n  def has_all_primitives(primitive_counts):\n    \"\"\"Check if the agent's inventory has all required primitives.\"\"\"\n    for primitive_index, count in primitive_counts.items():\n      if env._current_state.inventory[primitive_index] < count:\n        return False\n    return True\n\n  # Get the index of the item to craft\n  item_index = env.world.cookbook.index[item]\n\n  # Get the primitive counts required to craft the item\n  primitive_counts = env.world.cookbook.primitives_for(item_index)\n\n  if not has_all_primitives(primitive_counts):\n    return []\n\n  actions = []\n  \n  # Collect all required primitives\n  for primitive, count in primitive_counts.items():\n    for _ in range(count):\n      actions.extend(get_primitive_actions(primitive))\n  \n  # Move to the workshop and use it to craft the item\n  if \"_key\" in env.world.cookbook.recipes[item_index]:\n    workshop_key = env.world.cookbook.recipes[item_index][\"_key\"]\n    workshop_index = env.world.cookbook.index[workshop_key]\n    actions.extend(get_workshop_actions(workshop_index))\n  \n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-09-09T22:27:24.185834", "function_name": "craft", "function_body": "  # Helper functions to determine the direction and action needed\n  def get_direction(pos1, pos2):\n      dx = pos2[0] - pos1[0]\n      dy = pos2[1] - pos1[1]\n      if dx < 0:\n          return env.world.N_ACTIONS.DOWN\n      elif dx > 0:\n          return env.world.N_ACTIONS.UP\n      elif dy < 0:\n          return env.world.N_ACTIONS.LEFT\n      elif dy > 0:\n          return env.world.N_ACTIONS.RIGHT\n      else:\n          return None\n\n  def get_primitive_actions(primitive_index):\n    \"\"\"Returns a list of actions required to collect a primitive.\"\"\"\n    # Find all locations of the primitive in the grid\n    primitive_locations = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n    \n    if len(primitive_locations) == 0:\n      return []\n\n    # Choose the closest location to move to\n    current_pos = np.array(env._current_state.pos)\n    distances = np.linalg.norm(primitive_locations - current_pos, axis=1)\n    target_location = primitive_locations[np.argmin(distances)]\n    \n    actions = []\n    while env._current_state.pos != tuple(target_location):\n      direction_action = get_direction(env._current_state.pos, target_location)\n      if direction_action is not None:\n        actions.append(direction_action)\n      \n    # Add the USE action to collect the primitive\n    actions.append(env.world.N_ACTIONS.USE)\n    \n    return actions\n\n  def get_workshop_actions(workshop_index):\n    \"\"\"Returns a list of actions required to move to and use the workshop.\"\"\"\n    # Find all locations of the workshop in the grid\n    workshop_locations = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_locations) == 0:\n      return []\n\n    current_pos = np.array(env._current_state.pos)\n    distances = np.linalg.norm(workshop_locations - current_pos, axis=1)\n    target_location = workshop_locations[np.argmin(distances)]\n    \n    actions = []\n    while env._current_state.pos != tuple(target_location):\n      direction_action = get_direction(env._current_state.pos, target_location)\n      if direction_action is not None:\n        actions.append(direction_action)\n\n    # Add the USE action to use the workshop\n    actions.append(env.world.N_ACTIONS.USE)\n    \n    return actions\n\n  def has_all_primitives(primitive_counts):\n    \"\"\"Check if the agent's inventory has all required primitives.\"\"\"\n    for primitive_index, count in primitive_counts.items():\n      if env._current_state.inventory[primitive_index] < count:\n        return False\n    return True\n\n  # Get the index of the item to craft\n  item_index = env.world.cookbook.index[item]\n\n  # Get the primitive counts required to craft the item\n  primitive_counts = env.world.cookbook.primitives_for(item_index)\n\n  if not has_all_primitives(primitive_counts):\n    return []\n\n  actions = []\n  \n  # Collect all required primitives\n  for primitive, count in primitive_counts.items():\n    for _ in range(count):\n      actions.extend(get_primitive_actions(primitive))\n  \n  # Move to the workshop and use it to craft the item\n  if \"_key\" in env.world.cookbook.recipes[item_index]:\n    workshop_key = env.world.cookbook.recipes[item_index][\"_key\"]\n    workshop_index = env.world.cookbook.index[workshop_key]\n    actions.extend(get_workshop_actions(workshop_index))\n  \n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-09-09T22:34:09.985744", "function_name": "craft", "function_body": "  actions = []\n\n  # Get the cookbook\n  cookbook = env.world.cookbook\n\n  # Map item name to index\n  i_item = cookbook.index[item]\n\n  # Check if we have all primitives required for crafting\n  primitives_required = cookbook.primitives_for(i_item)\n  inventory = env._current_state.inventory.copy()\n\n  # Check if the agent has all the required items in their inventory\n  for primitive, count in primitives_required.items():\n    if inventory[primitive] < count:\n      return []  # Return empty list if any required item is missing\n\n  # Get the recipe details (where to craft)\n  recipe = cookbook.recipes[i_item]\n  workshop_key = \"_at\"\n  if workshop_key not in recipe:\n    return []  # Invalid recipe, no workshop specified\n\n  workshop_name = recipe[workshop_key]\n\n  # Find the index of the required workshop\n  i_workshop = cookbook.index[workshop_name]\n\n  # Get the current position and direction of the agent\n  pos = env._current_state.pos\n  dir = env._current_state.dir\n\n  # Define a simple pathfinding function to move towards the workshop\n  def find_path_to_workshop(pos, target_pos):\n    # Implement a basic BFS for demonstration purposes\n    queue = collections.deque([pos])\n    visited = set()\n    parent = {pos: None}\n\n    while queue:\n      current_pos = queue.popleft()\n\n      if current_pos == target_pos:\n        path = []\n        while current_pos is not None:\n          path.append(current_pos)\n          current_pos = parent[current_pos]\n        return list(reversed(path))[1:]\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        next_pos = (current_pos[0] + dx, current_pos[1] + dy)\n        if 0 <= next_pos[0] < env._current_state.grid.shape[0] and \\\n           0 <= next_pos[1] < env._current_state.grid.shape[1] and \\\n           next_pos not in visited:\n          visited.add(next_pos)\n          parent[next_pos] = current_pos\n          queue.append(next_pos)\n\n    return None\n\n  # Find the position of the workshop on the grid\n  grid = env._current_state.grid\n  target_pos = None\n  for x in range(grid.shape[0]):\n    for y in range(grid.shape[1]):\n      if np.any(grid[x, y, i_workshop] == 1):\n        target_pos = (x, y)\n        break\n    if target_pos:\n      break\n\n  if not target_pos:\n    return []  # Workshop not found on the grid\n\n  # Find a path to the workshop\n  path = find_path_to_workshop(pos, target_pos)\n\n  if not path:\n    return []  # No path found to the workshop\n\n  # Define action mappings for movement\n  dir_map = {\n      (0, -1): craft.LEFT,\n      (0, 1): craft.RIGHT,\n      (-1, 0): craft.UP,\n      (1, 0): craft.DOWN\n  }\n\n  # Move towards the workshop\n  for next_pos in path:\n    dx = next_pos[0] - pos[0]\n    dy = next_pos[1] - pos[1]\n\n    action = dir_map.get((dx, dy))\n    if action is not None:\n      actions.append(action)\n\n    pos = next_pos\n\n  # Check if the agent is facing the workshop\n  final_dx = target_pos[0] - pos[0]\n  final_dy = target_pos[1] - pos[1]\n\n  if (final_dx, final_dy) in dir_map:\n    direction_to_turn = dir_map[(final_dx, final_dy)]\n    actions.append(direction_to_turn)\n\n  # Perform the USE action to craft the item\n  actions.append(craft.USE)\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-09T22:34:11.013633", "function_name": "craft", "function_body": "  # Extracting index from the item name\n  item_index = env.world.cookbook.index[item]\n  \n  # Checking if we already have the item in inventory\n  if env._current_state.inventory[item_index] > 0:\n    return []\n  \n  # Check the required primitives and their counts for crafting the item\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  \n  actions = []\n\n  # Collecting all required primitives \n  for primitive, count in required_primitives.items():\n      while env._current_state.inventory[primitive] < count:\n          primitive_name = env.world.cookbook.index.get(primitive)\n          collect_actions = collect(env, primitive_name)\n          actions.extend(collect_actions)\n\n  # Find the workshop that can craft the item\n  for recipe_output, ingredients in env.world.cookbook.recipes.items():\n      if \"_at\" in ingredients:\n          workshop = ingredients[\"_at\"]\n          break\n\n  # Convert workshop name to index\n  workshop_index = env.world.cookbook.index[workshop]\n\n  # Locate the workshop on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n      return []\n\n  workshop_position = tuple(workshop_positions[0])\n\n  # Move to the workshop\n  move_actions = move_to_target(env, workshop_position)\n  actions.extend(move_actions)\n\n  # Turn towards the workshop and use it\n  direction = calculate_direction(env._current_state.pos, workshop_position)\n  actions.append(direction)\n  actions.append(env.world.cookbook.index[\"USE\"])\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-09T22:35:54.278970", "function_name": "craft", "function_body": "  def move_to_workshop(state, workshop_index):\n    pos = state.pos\n    grid = state.grid\n\n    # Find the closest workshop in the grid.\n    workshops = [(x, y) for x in range(grid.shape[0]) \n                 for y in range(grid.shape[1]) if grid[x, y, workshop_index] > 0]\n    if not workshops:\n      return []\n\n    # Choose the nearest workshop.\n    target_x, target_y = min(workshops, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n    return move_to_position(pos, (target_x, target_y))\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the desired item is a primitive; primitives cannot be crafted.\n  if item_index in env.world.cookbook.primitives:\n    return []\n\n  # Fetch the recipe for crafting the specified item.\n  recipe = env.world.cookbook.recipes.get(item_index)\n\n  # If no valid recipe exists or \"_key\" not specified, return an empty action list.\n  if not recipe or \"_key\" not in recipe:\n    return []\n\n  workshop_key = recipe[\"_key\"]\n  workshop_index = env.world.cookbook.index[workshop_key]\n\n  actions = []\n  # Check inventory for sufficient primitives.\n  missing_ingredients = {}\n  for ingredient, count in recipe.items():\n    if ingredient == \"_key\":\n      continue\n    ingredient_index = env.world.cookbook.index[ingredient]\n    current_count = state.inventory[ingredient_index]\n    if current_count < count:\n      missing_ingredients[ingredient] = count - current_count\n\n  # If any ingredients are missing, attempt to collect them.\n  for ingredient, required_count in missing_ingredients.items():\n    ingredient_index = env.world.cookbook.index[ingredient]\n    actions.extend(collect_v4(env, ingredient, required_count))\n\n  # Move to a workshop that can craft the item.\n  actions.extend(move_to_workshop(state, workshop_index))\n\n  # Use the USE action at the correct location.\n  actions.append(craft.ACTION_USE)\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-09T22:35:55.330498", "function_name": "craft", "function_body": "  def find_closest_workshop(workshop_index):\n    pos = env._current_state.pos\n    closest_workshop = None\n    min_distance = float('inf')\n    for x in range(env.world.grid.shape[0]):\n      for y in range(env.world.grid.shape[1]):\n        if env._current_state.grid[x, y, workshop_index] > 0:\n          distance = abs(x - pos[0]) + abs(y - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop = (x, y)\n    return closest_workshop\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the desired item is a primitive; primitives cannot be crafted.\n  if item_index in env.world.cookbook.primitives:\n    return []\n\n  # Fetch the recipe for crafting the specified item.\n  recipe = env.world.cookbook.recipes.get(item_index)\n\n  # If no valid recipe exists or \"_key\" not specified, return an empty action list.\n  if not recipe or \"_key\" not in recipe:\n    return []\n\n  workshop_key = recipe[\"_key\"]\n  workshop_index = env.world.cookbook.index[workshop_key]\n\n  actions = []\n  # Check inventory for sufficient primitives.\n  missing_ingredients = {}\n  for ingredient, count in recipe.items():\n    if ingredient == \"_key\":\n      continue\n    ingredient_index = env.world.cookbook.index[ingredient]\n    current_count = env._current_state.inventory[ingredient_index]\n    if current_count < count:\n      missing_ingredients[ingredient] = count - current_count\n\n  # If any ingredients are missing, attempt to collect them.\n  for ingredient, required_count in missing_ingredients.items():\n    ingredient_index = env.world.cookbook.index[ingredient]\n    actions.extend(collect_v4(env, ingredient, required_count))\n\n  # Find the closest workshop that can craft the item.\n  closest_workshop_pos = find_closest_workshop(workshop_index)\n  if closest_workshop_pos is None:\n    return []\n\n  # Move to the closest workshop.\n  target_x, target_y = closest_workshop_pos\n  actions.extend(move_to_position(env._current_state.pos, (target_x, target_y)))\n\n  # Turn to face the workshop before using it.\n  actions.append(turn_towards(env._current_state.dir, env.world.grid.shape))\n\n  # Use the USE action at the correct location.\n  actions.append(craft.ACTION_USE)\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-09T22:37:01.468808", "function_name": "craft", "function_body": "  # Get the index of the desired item from the cookbook\n  i_goal = env.world.cookbook.index[item]\n\n  if not env._current_state.inventory[i_goal] > 0:\n    actions = []\n\n    # Retrieve the recipe for the item\n    recipe = env.world.cookbook.recipes[i_goal]\n    \n    # Gather all required primitives and intermediate items\n    for ingredient, count in recipe.items():\n      if ingredient == \"_at\":\n        workshop_name = recipe[ingredient]\n        continue\n      \n      i_ingredient = env.world.cookbook.index.get(ingredient)\n      while env._current_state.inventory[i_ingredient] < count:\n        # Find the location of the ingredient in the grid\n        locations = np.argwhere(env._current_state.grid[..., i_ingredient] > 0)\n\n        if len(locations) == 0:\n          raise ValueError(f\"No {ingredient} found on the map.\")\n\n        # Select a random location for simplicity\n        target_location = tuple(locations[env.world.random.randint(len(locations))])\n        \n        # Calculate actions to move towards the ingredient\n        path_actions = calculate_path(env._current_state, target_location)\n        actions.extend(path_actions)\n\n        # Add action to collect the ingredient\n        actions.append(env.action_specs()[collect])\n\n        # Move back to the starting position (optional, can be optimized)\n        start_pos = env._current_state.pos\n        return_to_start_actions = calculate_path(env._current_state, start_pos)\n        actions.extend(return_to_start_actions)\n\n    # Go to the workshop and craft the item\n    workshop_index = env.world.cookbook.index.get(workshop_name)\n    locations = np.argwhere(env._current_state.grid[..., workshop_index] > 0)\n\n    if len(locations) == 0:\n      raise ValueError(f\"No {workshop_name} found on the map.\")\n\n    target_location = tuple(locations[env.world.random.randint(len(locations))])\n    \n    # Calculate actions to move towards the workshop\n    path_actions = calculate_path(env._current_state, target_location)\n    actions.extend(path_actions)\n\n    # Add action to use the workshop (craft the item)\n    actions.append(env.action_specs()[use])\n\n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-09T22:37:02.492283", "function_name": "craft", "function_body": "  # Convert item name to index\n  item_idx = env.world.cookbook.index[item]\n\n  # Check if the item has a recipe\n  if item_idx not in env.world.cookbook.recipes:\n    return []\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes[item_idx]\n\n  # Collect all required primitives and crafted items\n  actions = []\n  for ingredient, count in recipe.items():\n    if ingredient == \"_key\":\n      continue\n\n    # Find the index of the ingredient\n    ingredient_idx = env.world.cookbook.index[ingredient]\n    for _ in range(count):\n      actions.extend(collect(env, ingredient))\n\n  # Go to the workshop and craft the item\n  workshop_index = recipe[\"_at\"]\n  workshop_pos = find_workshop_position(env, workshop_index)\n  if workshop_pos is None:\n    return []\n\n  # Add actions to move to the workshop position\n  actions.extend(move_to_position(env, env._current_state.pos, workshop_pos))\n\n  # Add action to face the workshop and use it\n  actions.append(facing_direction_for_use(env, workshop_pos))\n  actions.append(craft.CRAFT_FUNC)\n\n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-09T22:38:35.375269", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index for the desired item from the cookbook\n  item_idx = env.world.cookbook.index[item]\n  \n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_idx, {})\n  \n  if not recipe:\n    return []  # No recipe found\n  \n  # Determine the workshop where the crafting should happen\n  workshop_key = \"_key\"\n  workshop_index = int(recipe.pop(workshop_key, -1))\n  \n  if workshop_index == -1:\n    return []  # Workshop not specified in the recipe\n  \n  # Get the list of workshops from the world configuration\n  workshop_indices = env.world.workshop_indices\n  \n  if workshop_index >= len(workshop_indices):\n    return []  # Invalid workshop index\n  \n  # Determine the target position for the workshop\n  target_workshop_pos = None\n  for y in range(env._current_state.grid.shape[1]):\n      for x in range(env._current_state.grid.shape[0]):\n          if env._current_state.grid[x, y, workshop_indices[workshop_index]] == 1:\n              target_workshop_pos = (x, y)\n              break\n      if target_workshop_pos is not None:\n          break\n  \n  if target_workshop_pos is None:\n    return []  # Workshop position not found in the grid\n\n  # Check and collect all required primitives\n  for ingredient_idx, count in recipe.items():\n      if env._current_state.inventory[ingredient_idx] < count:\n          actions.extend(collect(env, env.world.cookbook.index.get(ingredient_idx)))\n      \n      if env._current_state.inventory[ingredient_idx] < count:\n        return []  # Could not collect all required primitives\n  \n  # Move to the target workshop\n  actions.extend(move_to(env._current_state, target_workshop_pos))\n  \n  # Perform the USE action at the workshop\n  actions.append(4)  # USE action index\n\n  # Verify if item is crafted by checking inventory\n  if env._current_state.inventory[item_idx] == 0:\n    return []  # Crafting failed\n  \n  return actions", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-09-09T22:38:36.428487", "function_name": "craft", "function_body": "  def collect_ingredient(name: str):\n    ingredient_idx = env.world.cookbook.index[name]\n    if env._current_state.inventory[ingredient_idx] == 0:\n      # Collect the ingredient if it's not already in inventory\n      return collect_v2(env, name)\n    return []\n\n  actions = []\n  \n  # Get the index for the desired item from the cookbook\n  item_idx = env.world.cookbook.index[item]\n  \n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_idx, {})\n  \n  if not recipe:\n    return []  # No recipe found\n  \n  # Determine the workshop where the crafting should happen\n  workshop_key = \"_key\"\n  workshop_index = int(recipe.pop(workshop_key, -1))\n  \n  if workshop_index == -1:\n    return []  # Workshop not specified in the recipe\n  \n  # Get the list of workshops from the world configuration\n  workshop_indices = env.world.workshop_indices\n  \n  if workshop_index >= len(workshop_indices):\n    return []  # Invalid workshop index\n\n  # Determine the target position for the workshop\n  target_workshop_pos = None\n  for y in range(env._current_state.grid.shape[1]):\n      for x in range(env._current_state.grid.shape[0]):\n          if env._current_state.grid[x, y, workshop_indices[workshop_index]] == 1:\n              target_workshop_pos = (x, y)\n              break\n      if target_workshop_pos is not None:\n          break\n  \n  if target_workshop_pos is None:\n    return []  # Workshop position not found in the grid\n\n  # Collect all required primitives\n  for ingredient_idx, count in recipe.items():\n      ingredient_name = env.world.cookbook.index.get(ingredient_idx)\n      while env._current_state.inventory[ingredient_idx] < count:\n          actions.extend(collect_v2(env, ingredient_name))\n      \n      if env._current_state.inventory[ingredient_idx] < count:\n        return []  # Could not collect all required primitives\n\n  # Move to the target workshop\n  actions.extend(move_to(env._current_state, target_workshop_pos))\n  \n  # Perform the USE action at the workshop\n  actions.append(4)  # USE action index\n  \n  return actions", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-09-09T22:39:49.665535", "function_name": "craft", "function_body": "  # Helper function to move towards a given position\n  def move_towards(pos):\n      actions = []\n      current_pos = env._current_state.pos\n      while current_pos != pos:\n          dx = pos[0] - current_pos[0]\n          dy = pos[1] - current_pos[1]\n\n          if dx > 0:\n              actions.append(env.world.world.N_RIGHT)\n          elif dx < 0:\n              actions.append(env.world.world.N_LEFT)\n\n          if dy > 0:\n              actions.append(env.world.world.N_DOWN)\n          elif dy < 0:\n              actions.append(env.world.world.N_UP)\n\n          # Move one step in the correct direction\n          reward, done, observations = env.step(actions[-1])\n          current_pos = env._current_state.pos\n\n      return actions\n  \n  # Get the index of the item to craft\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n\n  # Check if we have all the primitives required for crafting\n  primitives_needed = cookbook.primitives_for(item_index)\n  inventory = env._current_state.inventory\n\n  if not all(inventory[i] >= count for i, count in primitives_needed.items()):\n      return []\n\n  # Find the workshop where the item can be crafted\n  workshop_name = cookbook.recipes[item_index][\"_at\"]\n  workshop_index = [i for i, w in enumerate(env.world.workshop_indices) if env.world.cookbook.index.get(w) == workshop_name][0]\n  workshop_pos = np.argwhere(env._current_state.grid[:, :, env.world.workshop_indices[workshop_index]] > 0)[0]\n\n  # Move towards the workshop\n  actions_to_take = move_towards(workshop_pos)\n\n  # Check if we are facing the correct direction to use the workshop\n  dx = workshop_pos[0] - env._current_state.pos[0]\n  dy = workshop_pos[1] - env._current_state.pos[1]\n\n  if dx > 0:\n      actions_to_take.append(env.world.world.N_RIGHT)\n  elif dx < 0:\n      actions_to_take.append(env.world.world.N_LEFT)\n\n  if dy > 0:\n      actions_to_take.append(env.world.world.N_DOWN)\n  elif dy < 0:\n      actions_to_take.append(env.world.world.N_UP)\n\n  # Perform the USE action to craft the item\n  actions_to_take.append(env.world.world.N_USE)\n\n  return actions_to_take", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-09T22:39:49.735856", "function_name": "craft", "function_body": "    # Get the goal index from the item name\n    try:\n        goal_index = env.world.cookbook.index[item]\n    except KeyError:\n        print(f\"Item {item} not found in cookbook.\")\n        return []\n\n    # Check if we have all required primitives to craft the item\n    required_primitives = env.world.cookbook.primitives_for(goal_index)\n    \n    actions_to_take = []\n    \n    for primitive, count in required_primitives.items():\n        primitive_name = env.world.cookbook.index.get(primitive)\n\n        # Collect primitives if needed\n        while np.sum(env._current_state.inventory[primitive]) < count:\n            collect_actions = collect_v2(env, primitive_name)\n            actions_to_take.extend(collect_actions)\n\n    # Find the workshop index for crafting\n    recipe = env.world.cookbook.recipes[goal_index]\n    workshop_key = \"_key\"\n    if workshop_key in recipe:\n        workshop_name = recipe[workshop_key]\n        workshop_index = env.world.cookbook.index[workshop_name]\n\n        # Move to the workshop and face it for crafting\n        move_to_workshop_actions = move_v2(env, workshop_index)\n        actions_to_take.extend(move_to_workshop_actions)\n\n        # Use action to craft the item at the workshop\n        use_action = 4  # Assuming USE action is represented by index 4\n        actions_to_take.append(use_action)\n    else:\n        print(\"No workshop specified for crafting this item.\")\n        return []\n\n    return actions_to_take", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-09T22:40:40.438248", "function_name": "craft", "function_body": "  # Get the index of the item from the cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the primitives required for crafting the item\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  inventory = env._current_state.inventory\n\n  # Collect missing primitives\n  actions = []\n  for primitive_index, count in required_primitives.items():\n    if inventory[primitive_index] < count:\n      primitive_name = env.world.cookbook.index.get(primitive_index)\n      collect_actions = collect(env, primitive_name)\n      actions.extend(collect_actions)\n\n  # Go to the workshop and craft the item\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_key = list(recipe.keys())[0] if \"_key\" in recipe else \"_key\"\n  workshop_index = env.world.workshop_indices[recipe[workshop_key]]\n  workshop_name = env.world.cookbook.index.get(workshop_index)\n  \n  # Find the position of the workshop\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) > 0:\n    workshop_pos = tuple(workshop_positions[0])\n    move_actions = move_to(env, workshop_pos)\n    actions.extend(move_actions)\n    \n    # Add the USE action to craft the item\n    use_action = env.world.cookbook.index[\"USE\"]\n    actions.append(use_action)\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-09T22:40:41.416329", "function_name": "craft", "function_body": "  # Get the index of the item to craft\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Extract the recipe for the item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Collect all required primitives and items\n  actions = []\n  inventory_needed = {}\n  \n  for ingredient, count in recipe.items():\n    if ingredient == \"_at\":\n      workshop_type = recipe[\"_at\"]\n      continue\n    \n    ingredient_index = env.world.cookbook.index[ingredient]\n    inventory_needed[ingredient_index] = count\n\n  # Check if we already have the required items in our inventory\n  current_inventory = env._current_state.inventory\n  for ingredient, needed_count in inventory_needed.items():\n    if current_inventory[ingredient] < needed_count:\n      actions.extend(collect(env, env.world.cookbook.index.get(ingredient)))\n\n  # Move to the workshop and craft the item\n  workshop_index = [i for i, idx in enumerate(env.world.workshop_indices) if env.world.cookbook.index.get(workshop_type) == idx][0]\n  actions.append(MOVE_FUNC(DOWN)) # Just a placeholder, need actual movement logic\n\n  # Use action to craft the item at the workshop\n  actions.append(4)  # USE action index\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-09T22:41:32.579429", "function_name": "craft", "function_body": "  # Get the index of the goal item from the cookbook\n  goal_index = env.world.cookbook.index[item]\n\n  # Check if we have all the primitives required for crafting the item\n  primitives_required = env.world.cookbook.primitives_for(goal_index)\n  \n  actions = []\n\n  # Check if we already have the item in our inventory\n  if env._current_state.inventory[goal_index] > 0:\n    return actions\n  \n  # If not, check if we have all required primitives in our inventory\n  for primitive_index, count in primitives_required.items():\n    while env._current_state.inventory[primitive_index] < count:\n      # Find the nearest cell containing the required primitive\n      pos = find_nearest_primitive(env, primitive_index)\n      if pos is None:\n        return []  # If no such cell exists, return an empty action list\n      \n      # Move to the position of the primitive and collect it\n      actions.extend(move_to_position(env._current_state.pos, pos))\n      actions.append(craft.COLLECT_FUNC(primitive_index))\n\n  # Now that we have all required primitives, move to the workshop and craft the item\n  workshop_index = env.world.cookbook.recipes[goal_index]['_at']\n  workshop_pos = find_nearest_workshop(env, workshop_index)\n  \n  if workshop_pos is None:\n    return []  # If no such workshop exists, return an empty action list\n  \n  actions.extend(move_to_position(env._current_state.pos, workshop_pos))\n  actions.append(craft.USE_FUNC)\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-09T22:41:33.566374", "function_name": "craft", "function_body": "  # Convert item name to its corresponding index in the cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if there's a recipe for this item\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the ingredients needed and their counts\n  recipe = env.world.cookbook.recipes[item_index]\n\n  actions = []\n  \n  # Collect primitives required by the recipe\n  for ingredient, count in recipe.items():\n      if ingredient == '_at':\n          continue  # Skip the '_at' key which indicates where to craft the item\n      \n      # Convert ingredient name to its corresponding index in the cookbook\n      ingredient_index = env.world.cookbook.index[ingredient]\n      \n      # Check if we have enough of this ingredient in our inventory\n      while np.sum(env._current_state.inventory[ingredient_index]) < count:\n          actions.extend(collect_v0(env, ingredient))\n  \n  # Determine the workshop to use for crafting\n  workshop = recipe['_at']\n  workshop_index = env.world.cookbook.index[workshop]\n  \n  # Move to the nearest workshop and craft the item\n  actions.extend(move_to_workshop_v0(env, workshop_index))\n  actions.append(4)  # USE action\n  \n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-09T22:43:47.296725", "function_name": "craft", "function_body": "  def get_primitive_actions(primitive_index):\n    \"\"\"Returns a list of actions required to collect a primitive.\"\"\"\n    # Find all locations of the primitive in the grid\n    primitive_locations = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n    if len(primitive_locations) == 0:\n      return []\n\n    target_location = primitive_locations[np.random.choice(len(primitive_locations))]\n    \n    actions = []\n    while env._current_state.pos != tuple(target_location):\n      dx, dy = target_location - np.array(env._current_state.pos)\n      direction_actions = {\n          (dx < 0): env.world.N_ACTIONS.DOWN,\n          (dx > 0): env.world.N_ACTIONS.UP,\n          (dy < 0): env.world.N_ACTIONS.LEFT,\n          (dy > 0): env.world.N_ACTIONS.RIGHT\n      }\n      \n      for condition, action in direction_actions.items():\n          if condition and not env._current_state.next_to(env.world.cookbook.index['BOUNDARY']):\n              actions.append(action)\n              break\n\n    # Add the USE action to collect the primitive\n    actions.append(env.world.N_ACTIONS.USE)\n    \n    return actions\n\n  def get_workshop_actions(workshop_index):\n    \"\"\"Returns a list of actions required to move to and use the workshop.\"\"\"\n    workshop_locations = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_locations) == 0:\n      return []\n\n    target_location = workshop_locations[np.random.choice(len(workshop_locations))]\n    \n    actions = []\n    while env._current_state.pos != tuple(target_location):\n      dx, dy = target_location - np.array(env._current_state.pos)\n      direction_actions = {\n          (dx < 0): env.world.N_ACTIONS.DOWN,\n          (dx > 0): env.world.N_ACTIONS.UP,\n          (dy < 0): env.world.N_ACTIONS.LEFT,\n          (dy > 0): env.world.N_ACTIONS.RIGHT\n      }\n      \n      for condition, action in direction_actions.items():\n          if condition and not env._current_state.next_to(env.world.cookbook.index['BOUNDARY']):\n              actions.append(action)\n              break\n\n    # Add the USE action to use the workshop\n    actions.append(env.world.N_ACTIONS.USE)\n    \n    return actions\n\n  def has_all_primitives(primitive_counts):\n    \"\"\"Check if the agent's inventory has all required primitives.\"\"\"\n    for primitive_index, count in primitive_counts.items():\n      if env._current_state.inventory[primitive_index] < count:\n        return False\n    return True\n\n  # Get the index of the item to craft\n  item_index = env.world.cookbook.index[item]\n\n  # Get the primitive counts required to craft the item\n  primitive_counts = env.world.cookbook.primitives_for(item_index)\n\n  actions = []\n\n  # Collect all required primitives if not already collected\n  for primitive, count in primitive_counts.items():\n    for _ in range(count - env._current_state.inventory[primitive]):\n      actions.extend(get_primitive_actions(primitive))\n\n  if \"_key\" in env.world.cookbook.recipes[item_index]:\n    workshop_key = env.world.cookbook.recipes[item_index][\"_key\"]\n    workshop_index = env.world.cookbook.index[workshop_key]\n    actions.extend(get_workshop_actions(workshop_index))\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
