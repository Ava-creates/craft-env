{"timestamp": "2025-09-11T04:48:11.281637", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the required primitives for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  \n  actions = []\n  \n  # Collect missing primitives\n  for primitive, count in required_primitives.items():\n    if env._current_state.inventory[primitive] < count:\n      # Get the name of the primitive from the index\n      primitive_name = env.world.cookbook.index.get(primitive)\n      \n      # Generate actions to collect the primitive\n      collect_actions = collect(env, primitive_name)\n      \n      # Add collected actions to the main action list\n      actions.extend(collect_actions)\n  \n  # Now that we have all required primitives, go to the workshop and craft the item\n  \n  # Find which workshop is needed for crafting this item\n  recipe = env.world.cookbook.recipes[item_index]\n  if \"_at\" in recipe:\n    workshop_name = recipe[\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Get the position of the nearest workshop of the required type\n    grid = env._current_state.grid\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n    \n    if len(positions) == 0:\n      return []  # No workshop available\n\n    closest_workshop_position = min(\n        positions,\n        key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n    )\n\n    # Generate actions to move to the nearest workshop\n    target_directions = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n    current_pos = env._current_state.pos\n    for direction in target_directions:\n      if closest_workshop_position[0] == current_pos[0] + direction[0] and closest_workshop_position[1] == current_pos[1] + direction[1]:\n        actions.append(env.world.cookbook.index[f\"MOVE_{direction}\"])\n    \n    # Rotate to face the workshop\n    # Assuming the agent can rotate in 90-degree increments\n    target_direction = (closest_workshop_position[1] - env._current_state.pos[1], closest_workshop_position[0] - env._current_state.pos[0])\n    if target_direction == (0, 1):\n      actions.append(env.world.cookbook.index[\"MOVE_UP\"])\n    elif target_direction == (0, -1):\n      actions.append(env.world.cookbook.index[\"MOVE_DOWN\"])\n    elif target_direction == (1, 0):\n      actions.append(env.world.cookbook.index[\"MOVE_RIGHT\"])\n    elif target_direction == (-1, 0):\n      actions.append(env.world.cookbook.index[\"MOVE_LEFT\"])\n\n    # Perform the USE action to craft the item\n    actions.append(env.world.cookbook.index[\"USE\"])\n  \n  return actions", "island_id": 4, "scores": {"3": -1}}
