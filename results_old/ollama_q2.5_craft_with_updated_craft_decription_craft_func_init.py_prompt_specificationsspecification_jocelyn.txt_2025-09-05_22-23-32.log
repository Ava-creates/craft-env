{"timestamp": "2025-09-06T13:18:20.596977", "function_name": "craft", "function_body": "  def get_action_for_direction(dx, dy):\n    ACTION_UP = env.world.n_actions - 4 + 0\n    ACTION_DOWN = env.world.n_actions - 4 + 2\n    ACTION_LEFT = env.world.n_actions - 4 + 1\n    ACTION_RIGHT = env.world.n_actions - 4 + 3\n\n    if dx < 0:\n      return ACTION_LEFT\n    elif dx > 0:\n      return ACTION_RIGHT\n    elif dy < 0:\n      return ACTION_DOWN\n    else:\n      return ACTION_UP\n\n  def move_to_position(target_x, target_y):\n    \"\"\"Helper function to generate actions to move to a specific position.\"\"\"\n    actions = []\n    pos_x, pos_y = env._current_state.pos\n    \n    while pos_x != target_x or pos_y != target_y:\n      dx = target_x - pos_x\n      dy = target_y - pos_y\n      \n      if abs(dx) >= abs(dy):\n        actions.append(get_action_for_direction(dx, 0))\n        pos_x += (-1 if dx < 0 else 1)\n      else:\n        actions.append(get_action_for_direction(0, dy))\n        pos_y += (-1 if dy < 0 else 1)\n    \n    return actions\n\n  def find_closest_target(target_positions):\n    \"\"\"Helper function to find the closest target position.\"\"\"\n    pos_x, pos_y = env._current_state.pos\n    \n    min_distance = float('inf')\n    closest_pos = None\n    \n    for tx, ty in zip(*target_positions):\n        distance = abs(tx - pos_x) + abs(ty - pos_y)\n        if distance < min_distance:\n            min_distance = distance\n            closest_pos = (tx, ty)\n    \n    return closest_pos\n\n  def collect_primitives(primitive_index, count):\n    \"\"\"Helper function to generate actions to collect required primitives.\"\"\"\n    current_inventory = env._current_state.inventory\n    actions = []\n    \n    while current_inventory[primitive_index] < count:\n      primitive_positions = np.where(env._current_state.grid[:, :, primitive_index] > 0)\n      closest_primitive_pos = find_closest_target(primitive_positions)\n      \n      if closest_primitive_pos is not None:\n        tx, ty = closest_primitive_pos\n        actions.extend(move_to_position(tx, ty))\n        actions.append(ACTION_USE)  # Assuming USE is always the last action to collect primitive\n        current_inventory[primitive_index] += 1\n      else:\n        return [], False  # If no source for the primitive, return empty list and failure flag\n    \n    return actions, True\n\n  def use_workshop():\n    \"\"\"Helper function to generate actions to use a workshop.\"\"\"\n    actions = []\n    item_index = env.world.cookbook.index[item]\n    primitives_needed = env.world.cookbook.primitives_for(item_index)\n\n    # Check if we have all required primitives for crafting the item\n    current_inventory = env._current_state.inventory\n\n    # Collect missing primitives\n    for prim, count in primitives_needed.items():\n      while current_inventory[prim] < count:\n        primitive_actions, success = collect_primitives(prim, count)\n        \n        if not success:\n          return []  # If no source for the primitive, return empty list\n        \n        actions.extend(primitive_actions)\n\n    # Find and use a workshop that has the required recipe\n    for i, workshop in enumerate(env.world.workshop_indices):\n      workshop_positions = np.where(env._current_state.grid[:, :, workshop] > 0)\n      closest_workshop_pos = find_closest_target(workshop_positions)\n      \n      if closest_workshop_pos is not None:\n        tx, ty = closest_workshop_pos\n        actions.extend(move_to_position(tx, ty))\n        actions.append(ACTION_USE)  # Assuming USE is always the last action to craft item\n        return actions\n    \n    return []  # If no workshop found\n\n  ACTION_UP = env.world.n_actions - 4 + 0\n  ACTION_DOWN = env.world.n_actions - 4 + 2\n  ACTION_LEFT = env.world.n_actions - 4 + 1\n  ACTION_RIGHT = env.world.n_actions - 4 + 3\n  ACTION_USE = env.world.n_actions - 1\n\n  return use_workshop()", "island_id": 2, "scores": {"3": 1.8000002}}
{"timestamp": "2025-09-06T13:18:21.674509", "function_name": "craft", "function_body": "  ACTION_UP = env.world.n_actions - 4 + 0\n  ACTION_DOWN = env.world.n_actions - 4 + 2\n  ACTION_LEFT = env.world.n_actions - 4 + 1\n  ACTION_RIGHT = env.world.n_actions - 4 + 3\n  ACTION_USE = env.world.n_actions - 1\n\n  def move_to_position(target_x, target_y):\n    \"\"\"Helper function to generate actions to move to a specific position.\"\"\"\n    actions = []\n    pos_x, pos_y = env._current_state.pos\n    \n    while pos_x != target_x or pos_y != target_y:\n      dx = target_x - pos_x\n      dy = target_y - pos_y\n      \n      if abs(dx) > abs(dy):\n        actions.append(ACTION_LEFT if dx < 0 else ACTION_RIGHT)\n      else:\n        actions.append(ACTION_DOWN if dy < 0 else ACTION_UP)\n      \n      pos_x += (-1 if dx < 0 else 1) if abs(dx) > abs(dy) else 0\n      pos_y += (-1 if dy < 0 else 1) if abs(dx) <= abs(dy) else 0\n    \n    return actions\n\n  def find_closest_target(target_positions):\n    \"\"\"Helper function to find the closest target position.\"\"\"\n    pos_x, pos_y = env._current_state.pos\n    \n    min_distance = float('inf')\n    closest_pos = None\n    \n    for tx, ty in zip(*target_positions):\n        distance = abs(tx - pos_x) + abs(ty - pos_y)\n        if distance < min_distance:\n            min_distance = distance\n            closest_pos = (tx, ty)\n    \n    return closest_pos\n\n  def collect_primitives(primitive_index, count):\n    \"\"\"Helper function to generate actions to collect required primitives.\"\"\"\n    current_inventory = env._current_state.inventory\n    actions = []\n    \n    while current_inventory[primitive_index] < count:\n      primitive_positions = np.where(env._current_state.grid[:, :, primitive_index] > 0)\n      closest_primitive_pos = find_closest_target(primitive_positions)\n      \n      if closest_primitive_pos is not None:\n        tx, ty = closest_primitive_pos\n        actions.extend(move_to_position(tx, ty))\n        actions.append(ACTION_USE)  # Assuming USE is always the last action to collect primitive\n        current_inventory[primitive_index] += 1\n      else:\n        return [], False  # If no source for the primitive, return empty list and failure flag\n    \n    return actions, True\n\n  def use_workshop(workshop_index):\n    \"\"\"Helper function to generate actions to use a workshop.\"\"\"\n    target_positions = np.where(env._current_state.grid[:, :, workshop_index] > 0)\n    \n    if len(target_positions[0]) == 0 or len(target_positions[1]) == 0:\n      return None\n    \n    closest_workshop_pos = find_closest_target(target_positions)\n    \n    if closest_workshop_pos is not None:\n        tx, ty = closest_workshop_pos\n        actions = move_to_position(tx, ty)\n        actions.append(ACTION_USE)  # Assuming USE is always the last action to craft item\n        return actions\n\n  def check_workshop_availability(workshop_index, primitives_needed):\n    \"\"\"Helper function to check if a workshop has the required recipe.\"\"\"\n    # Assuming each workshop can craft any item with the correct primitives in inventory\n    return True\n\n  actions = []\n  \n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all required primitives for crafting the item\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  current_inventory = env._current_state.inventory\n\n  # Collect missing primitives\n  for prim, count in primitives_needed.items():\n    while current_inventory[prim] < count:\n      primitive_actions, success = collect_primitives(prim, count)\n      \n      if not success:\n        return []  # If no source for the primitive, return empty list\n      \n      actions.extend(primitive_actions)\n\n  # Find and use a workshop that has the required recipe\n  workshop_used = False\n  for i, workshop in enumerate(env.world.workshop_indices):\n    if check_workshop_availability(workshop, primitives_needed):\n      workshop_actions = use_workshop(workshop)\n      \n      if workshop_actions is not None:\n        actions.extend(workshop_actions)\n        workshop_used = True\n        break\n\n  return actions if workshop_used else []", "island_id": 2, "scores": {"3": 2.0}}
{"timestamp": "2025-09-06T13:19:22.525289", "function_name": "craft", "function_body": "  actions = []\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n  \n  if goal_index not in cookbook.recipes:\n    raise ValueError(f\"No recipe for {item} found.\")\n\n  # Check if we have all the primitives required to craft the item.\n  required_primitives = cookbook.primitives_for(goal_index)\n  available_inventory = env._current_state.inventory\n\n  # Check if we have all required items/primitives in inventory\n  has_all_required = True\n  for primitive, count in required_primitives.items():\n    if available_inventory[primitive] < count:\n      has_all_required = False\n      break\n  \n  if not has_all_required:\n    return []\n\n  # Go to the workshop and craft the item.\n  workshop_indices = env.world.workshop_indices\n  goal_recipe = cookbook.recipes[goal_index]\n  workshop_index = None\n\n  for ingredient, _ in goal_recipe.items():\n    if ingredient.startswith(\"_key\"):\n      continue  # Skip key ingredients that are not directly related to location.\n\n    if ingredient == \"_key\" or int(ingredient) not in available_inventory:\n      continue  # Skip keys and ingredients we don't have in inventory.\n\n    workshop_index = int(ingredient)\n    break\n\n  if workshop_index is None:\n    raise ValueError(f\"No suitable workshop found for crafting {item}.\")\n\n  workshop_pos = np.argwhere(env._current_state.grid[:, :, workshop_index])[0]\n\n  # Move to the workshop position\n  actions.extend(move_to(env, tuple(workshop_pos)))\n  \n  # Use the workshop to craft the item\n  actions.append(craft.USE)\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-06T13:19:23.489683", "function_name": "craft", "function_body": "  # Get the index of the item to be crafted from the cookbook's index.\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if there is a recipe for the desired item in the cookbook.\n  if item_index not in env.world.cookbook.recipes:\n    return []  # No recipe available\n\n  # Get the primitives required to craft the item.\n  requirements = env.world.cookbook.primitives_for(item_index)\n  \n  # Initialize an empty list of actions.\n  actions = []\n\n  # Collect all primitive resources needed for crafting.\n  for primitive, count in requirements.items():\n    # Get the name of the primitive from the cookbook's index.\n    primitive_name = env.world.cookbook.index.get(primitive, None)\n    \n    if primitive_name is not None:\n      collect_actions = collect(env, primitive_name)\n      actions.extend(collect_actions)\n\n  # Proceed to craft the item at a workshop.\n  # Assuming the recipe specifies a workshop (if needed).\n  for workshop_index in env.world.workshop_indices:\n    # Check if the current grid cell contains the required workshop.\n    if env._current_state.next_to(workshop_index):\n      actions.append(env.world.n_actions - 1)  # USE action to craft\n      break\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-06T13:21:51.114044", "function_name": "craft", "function_body": "  def navigate_to_workshop(pos: tuple, target_pos: tuple):\n      dx = target_pos[0] - pos[0]\n      dy = target_pos[1] - pos[1]\n\n      actions = []\n      if dx > 0:\n          actions.extend([env.world.RIGHT for _ in range(abs(dx))])\n      elif dx < 0:\n          actions.extend([env.world.LEFT for _ in range(abs(dx))])\n\n      if dy > 0:\n          actions.extend([env.world.DOWN for _ in range(abs(dy))])\n      elif dy < 0:\n          actions.extend([env.world.UP for _ in range(abs(dy))])\n\n      return actions\n\n  def manhattan_distance(pos1: tuple, pos2: tuple):\n      return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n\n  def find_workshop_position(env, workshop_index):\n      grid = env._current_state.grid\n      positions = np.argwhere(grid[:, :, workshop_index] == 1)\n      if positions.size > 0:\n          return tuple(positions[0])\n      else:\n          raise ValueError(f\"No position found for workshop index {workshop_index}\")\n\n  actions = []\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n  \n  # Check if we have all required primitives in our inventory\n  required_primitives = cookbook.primitives_for(goal_index)\n  for primitive, count in required_primitives.items():\n    if env._current_state.inventory[primitive] < count:\n      return []  # Not enough primitives to craft the item\n\n  # Find a workshop to perform crafting\n  recipe = cookbook.recipes.get(goal_index, {})\n  workshop_indices = [ingredient for ingredient in recipe.keys() \n                      if ingredient in env.world.workshop_indices and ingredient != \"_key\"]\n\n  if not workshop_indices:\n    return []  # No suitable workshop found\n  \n  # Sort workshops by distance to the nearest one\n  distances = {workshop: manhattan_distance(env._current_state.pos, find_workshop_position(env, workshop)) for workshop in workshop_indices}\n  closest_workshop_index = min(distances, key=distances.get)\n\n  # Navigate to the nearest workshop\n  actions.extend(navigate_to_workshop(env._current_state.pos, closest_workshop_index))\n\n  # Perform USE action at the workshop to craft the item\n  actions.append(env.world.N_ACTIONS - 1)  # Assuming USE is the last action index (N_ACTIONS - 1)\n\n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T13:21:52.217724", "function_name": "craft", "function_body": "  def manhattan_distance(pos1: tuple, pos2: tuple):\n      return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n\n  def find_workshop_position(env, workshop_index):\n      positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n      if positions.size > 0:\n          return tuple(positions[0])\n      else:\n          raise ValueError(f\"No position found for workshop index {workshop_index}\")\n\n  def navigate_to_workshop(pos, target_pos):\n    dx = target_pos[0] - pos[0]\n    dy = target_pos[1] - pos[1]\n\n    actions = []\n    if dx > 0:\n        actions.extend([env.world.RIGHT for _ in range(dx)])\n    elif dx < 0:\n        actions.extend([env.world.LEFT for _ in range(-dx)])\n\n    if dy > 0:\n        actions.extend([env.world.DOWN for _ in range(dy)])\n    elif dy < 0:\n        actions.extend([env.world.UP for _ in range(-dy)])\n\n    return actions\n\n  actions = []\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n  \n  # Check if we have all required primitives in our inventory\n  required_primitives = cookbook.primitives_for(goal_index)\n  for primitive, count in required_primitives.items():\n    if env._current_state.inventory[primitive] < count:\n      return []  # Not enough primitives to craft the item\n\n  # Find a workshop to perform crafting\n  recipe = cookbook.recipes.get(goal_index, {})\n  workshop_indices = [ingredient for ingredient in recipe.keys() \n                      if ingredient in env.world.workshop_indices and ingredient != \"_key\"]\n\n  if not workshop_indices:\n    return []  # No suitable workshop found\n  \n  # Sort workshops by distance to the nearest one\n  distances = {workshop: manhattan_distance(env._current_state.pos, find_workshop_position(env, workshop)) for workshop in workshop_indices}\n  closest_workshop_index = min(distances, key=distances.get)\n\n  # Navigate to the nearest workshop\n  target_pos = find_workshop_position(env, closest_workshop_index)\n  actions.extend(navigate_to_workshop(env._current_state.pos, target_pos))\n\n  # Perform USE action at the workshop to craft the item\n  actions.append(env.world.USE)  # Assuming USE is directly accessible\n\n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T13:26:53.384472", "function_name": "craft", "function_body": "  def move_to_position(target_x, target_y):\n    \"\"\"Helper function to generate actions to move to a specific position.\"\"\"\n    pos_x, pos_y = env._current_state.pos\n    actions = []\n    \n    while pos_x != target_x or pos_y != target_y:\n      dx = target_x - pos_x\n      dy = target_y - pos_y\n      \n      if abs(dx) > abs(dy):\n        actions.append(ACTION_LEFT if dx < 0 else ACTION_RIGHT)\n      else:\n        actions.append(ACTION_DOWN if dy < 0 else ACTION_UP)\n      \n      # Update position\n      pos_x += (-1 if dx < 0 else 1) if abs(dx) > abs(dy) else 0\n      pos_y += (-1 if dy < 0 else 1) if abs(dx) <= abs(dy) else 0\n    \n    return actions\n\n  def find_closest_target(target_positions):\n    \"\"\"Helper function to find the closest target position.\"\"\"\n    pos_x, pos_y = env._current_state.pos\n    min_distance = float('inf')\n    closest_pos = None\n    \n    for tx, ty in zip(*target_positions):\n        distance = abs(tx - pos_x) + abs(ty - pos_y)\n        if distance < min_distance:\n            min_distance = distance\n            closest_pos = (tx, ty)\n    \n    return closest_pos\n\n  def pick_up_primitives(primitive_index, count):\n    \"\"\"Helper function to generate actions to pick up primitives.\"\"\"\n    actions = []\n    current_primitive_count = current_inventory[primitive_index]\n    \n    while current_primitive_count < count:\n      primitive_positions = np.where(env._current_state.grid[:, :, primitive_index] > 0)\n      \n      if not np.any(primitive_positions):\n        return []  # If no source for the primitive, return empty list\n      \n      closest_primitive_pos = find_closest_target(primitive_positions)\n      tx, ty = closest_primitive_pos\n      primitive_actions = move_to_position(tx, ty)\n      actions.extend(primitive_actions)\n      \n      # Perform USE action to collect the primitive\n      actions.append(ACTION_USE)\n      current_primitive_count += 1\n    \n    return actions\n\n  def use_workshop(workshop_index):\n    \"\"\"Helper function to generate actions to use a workshop.\"\"\"\n    target_pos_x, target_pos_y = np.where(env._current_state.grid[:, :, workshop_index] > 0)\n    \n    if not np.any(target_pos_x) or not np.any(target_pos_y):\n      return None\n    \n    closest_workshop_pos = find_closest_target((target_pos_x, target_pos_y))\n    tx, ty = closest_workshop_pos\n    actions = move_to_position(tx, ty)\n    actions.append(ACTION_USE)  # Assuming USE is always the last action to craft item\n    return actions\n\n  def get_primitives_needed(item_index):\n      \"\"\"Helper function to get primitives needed for an item.\"\"\"\n      return env.world.cookbook.primitives_for(item_index)\n\n  # Define action constants\n  ACTION_UP = env.world.n_actions - 4 + 0\n  ACTION_DOWN = env.world.n_actions - 4 + 2\n  ACTION_LEFT = env.world.n_actions - 4 + 1\n  ACTION_RIGHT = env.world.n_actions - 4 + 3\n  ACTION_USE = env.world.n_actions - 1\n\n  actions = []\n  \n  # Get the index of the desired item\n  if item not in env.world.cookbook.index:\n    return []  # Return empty list if item is not in cookbook\n  \n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all required primitives for crafting the item\n  primitives_needed = get_primitives_needed(item_index)\n  current_inventory = env._current_state.inventory\n\n  # Collect missing primitives\n  for prim, count in primitives_needed.items():\n    primitive_actions = pick_up_primitives(prim, count)\n    actions.extend(primitive_actions)\n\n  # Find and use a workshop that has the required recipe\n  workshop_found = False\n  for i, workshop in enumerate(env.world.workshop_indices):\n    if env._current_state.grid[:, :, workshop].any():  # Check if there's at least one workshop of this type\n      workshop_positions = np.where(env._current_state.grid[:, :, workshop] > 0)\n      closest_workshop_pos = find_closest_target(workshop_positions)\n      \n      if closest_workshop_pos is not None:\n        tx, ty = closest_workshop_pos\n        workshop_actions = move_to_position(tx, ty)\n        actions.extend(workshop_actions)\n        \n        # Perform USE action to craft the item\n        actions.append(ACTION_USE)\n        workshop_found = True\n        break\n\n  if not workshop_found:\n    return []  # Return empty list if no suitable workshop found\n  \n  return actions", "island_id": 8, "scores": {"3": 1.1}}
{"timestamp": "2025-09-06T13:26:54.460970", "function_name": "craft", "function_body": "  def move_to_position(target_x, target_y):\n    \"\"\"Helper function to generate actions to move to a specific position.\"\"\"\n    pos_x, pos_y = env._current_state.pos\n    actions = []\n    \n    while pos_x != target_x or pos_y != target_y:\n      dx = target_x - pos_x\n      dy = target_y - pos_y\n      \n      if abs(dx) > abs(dy):\n        actions.append(ACTION_LEFT if dx < 0 else ACTION_RIGHT)\n      else:\n        actions.append(ACTION_DOWN if dy < 0 else ACTION_UP)\n      \n      # Update position\n      pos_x += (-1 if dx < 0 else 1) if abs(dx) > abs(dy) else 0\n      pos_y += (-1 if dy < 0 else 1) if abs(dx) <= abs(dy) else 0\n    \n    return actions\n\n  def find_closest_target(target_positions):\n    \"\"\"Helper function to find the closest target position.\"\"\"\n    pos_x, pos_y = env._current_state.pos\n    min_distance = float('inf')\n    closest_pos = None\n    \n    for tx, ty in zip(*target_positions):\n        distance = abs(tx - pos_x) + abs(ty - pos_y)\n        if distance < min_distance:\n            min_distance = distance\n            closest_pos = (tx, ty)\n    \n    return closest_pos\n\n  def pick_up_primitives(primitive_index, count):\n    \"\"\"Helper function to generate actions to pick up primitives.\"\"\"\n    actions = []\n    \n    while current_inventory[primitive_index] < count:\n      primitive_positions = np.where(env._current_state.grid[:, :, primitive_index] > 0)\n      \n      if not np.any(primitive_positions):\n        return []  # If no source for the primitive, return empty list\n      \n      closest_primitive_pos = find_closest_target(primitive_positions)\n      tx, ty = closest_primitive_pos\n      primitive_actions = move_to_position(tx, ty)\n      actions.extend(primitive_actions)\n      \n      # Perform USE action to collect the primitive\n      actions.append(ACTION_USE)\n      current_inventory[primitive_index] += 1\n    \n    return actions\n\n  def use_workshop(workshop_index):\n    \"\"\"Helper function to generate actions to use a workshop.\"\"\"\n    target_pos_x, target_pos_y = np.where(env._current_state.grid[:, :, workshop_index] > 0)\n    \n    if not np.any(target_pos_x) or not np.any(target_pos_y):\n      return None\n    \n    closest_workshop_pos = find_closest_target((target_pos_x, target_pos_y))\n    tx, ty = closest_workshop_pos\n    actions = move_to_position(tx, ty)\n    actions.append(ACTION_USE)  # Assuming USE is always the last action to craft item\n    return actions\n\n  def get_primitives_needed(item_index):\n      \"\"\"Helper function to get primitives needed for an item.\"\"\"\n      return env.world.cookbook.primitives_for(item_index)\n\n  # Define action constants\n  ACTION_UP = env.world.n_actions - 4 + 0\n  ACTION_DOWN = env.world.n_actions - 4 + 2\n  ACTION_LEFT = env.world.n_actions - 4 + 1\n  ACTION_RIGHT = env.world.n_actions - 4 + 3\n  ACTION_USE = env.world.n_actions - 1\n\n  actions = []\n  \n  # Get the index of the desired item\n  if item not in env.world.cookbook.index:\n    return []  # Return empty list if item is not in cookbook\n  \n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all required primitives for crafting the item\n  primitives_needed = get_primitives_needed(item_index)\n  current_inventory = env._current_state.inventory\n\n  # Collect missing primitives\n  for prim, count in primitives_needed.items():\n    primitive_actions = pick_up_primitives(prim, count)\n    actions.extend(primitive_actions)\n\n  # Find and use a workshop that has the required recipe\n  for i, workshop in enumerate(env.world.workshop_indices):\n    if env._current_state.grid[:, :, workshop].any():  # Check if there's at least one workshop of this type\n      workshop_positions = np.where(env._current_state.grid[:, :, workshop] > 0)\n      closest_workshop_pos = find_closest_target(workshop_positions)\n      \n      if closest_workshop_pos is not None:\n        tx, ty = closest_workshop_pos\n        workshop_actions = move_to_position(tx, ty)\n        actions.extend(workshop_actions)\n        \n        # Perform USE action to craft the item\n        actions.append(ACTION_USE)\n        break\n\n  return actions", "island_id": 8, "scores": {"3": 2.0}}
{"timestamp": "2025-09-06T13:30:16.180017", "function_name": "craft", "function_body": "  def move_to_position(current_pos, target_pos):\n    # Calculate the direction vector from current position to target position\n    direction_vector = np.array(target_pos) - np.array(current_pos)\n    \n    # Determine the steps needed in each dimension\n    dx, dy = direction_vector\n    \n    actions = []\n    \n    # Move vertically first if necessary\n    if dy < 0:\n      actions.extend([1] * abs(dy))  # UP\n    elif dy > 0:\n      actions.extend([0] * abs(dy))  # DOWN\n    \n    # Then move horizontally\n    if dx < 0:\n      actions.extend([2] * abs(dx))  # LEFT\n    elif dx > 0:\n      actions.extend([3] * abs(dx))  # RIGHT\n    \n    return actions\n\n  actions = []\n  \n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all primitives required to make the item\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n  \n  for primitive, count in primitives_required.items():\n    while env._current_state.inventory[primitive] < count:\n      # Find the nearest workshop that can produce this primitive\n      workshop_index = None\n      for recipe_output, ingredients in env.world.cookbook.recipes.items():\n        if \"_key\" in ingredients and ingredients[\"_key\"] == primitive:\n          workshop_index = recipe_output\n          break\n      \n      if workshop_index is not None:\n        # Find the position of the nearest workshop on the grid\n        workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n        closest_workshop_position = min(workshop_positions, key=lambda pos: np.linalg.norm(np.array(pos) - np.array(env._current_state.pos)))\n        \n        # Move to the workshop\n        actions.extend(move_to_position(env._current_state.pos, closest_workshop_position))\n        \n        # Use the workshop to produce the primitive\n        actions.append(4)  # USE action\n        \n      else:\n        return []  # Cannot find a workshop to produce the required primitive\n  \n  # Once we have all primitives, move to any available workshop to craft the item\n  available_workshops = [i for i in env.world.workshop_indices if i in env.world.cookbook.recipes and env.world.cookbook.recipes[i].get(item_index, 0) > 0]\n  \n  if not available_workshops:\n    return []  # No workshop available to craft the item\n  \n  closest_workshop_position = None\n  min_distance = float('inf')\n  \n  for workshop in available_workshops:\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop] > 0)\n    \n    for pos in workshop_positions:\n      distance = np.linalg.norm(np.array(pos) - np.array(env._current_state.pos))\n      \n      if distance < min_distance:\n        closest_workshop_position = pos\n        min_distance = distance\n  \n  actions.extend(move_to_position(env._current_state.pos, closest_workshop_position))\n  \n  # Use the workshop to craft the item\n  actions.append(4)  # USE action\n  \n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T13:30:17.253692", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all primitives required to make the item\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n  \n  for primitive, count in primitives_required.items():\n    while env._current_state.inventory[primitive] < count:\n      # Find the nearest workshop that can produce this primitive\n      workshop_indices = []\n      for recipe_output, ingredients in env.world.cookbook.recipes.items():\n        if \"_key\" in ingredients and ingredients[\"_key\"] == primitive:\n          workshop_indices.append(recipe_output)\n      \n      if not workshop_indices:\n        return []  # Cannot find a workshop to produce the required primitive\n      \n      closest_workshop_position = None\n      min_distance = float('inf')\n      \n      for workshop_index in workshop_indices:\n        workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n        \n        for pos in workshop_positions:\n          distance = np.linalg.norm(np.array(pos) - np.array(env._current_state.pos))\n          \n          if distance < min_distance:\n            closest_workshop_position = pos\n            min_distance = distance\n      \n      # Move to the workshop\n      actions.extend(move_to_position(env._current_state.pos, closest_workshop_position))\n      \n      # Use the workshop to produce the primitive\n      actions.append(4)  # USE action\n  \n  # Once we have all primitives, move to any available workshop to craft the item\n  available_workshops = [i for i in env.world.workshop_indices if i in env.world.cookbook.recipes and env.world.cookbook.recipes[i].get(item_index, 0) > 0]\n  \n  if not available_workshops:\n    return []  # No workshop available to craft the item\n  \n  closest_workshop_position = None\n  min_distance = float('inf')\n  \n  for workshop in available_workshops:\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop] > 0)\n    \n    for pos in workshop_positions:\n      distance = np.linalg.norm(np.array(pos) - np.array(env._current_state.pos))\n      \n      if distance < min_distance:\n        closest_workshop_position = pos\n        min_distance = distance\n  \n  actions.extend(move_to_position(env._current_state.pos, closest_workshop_position))\n  \n  # Use the workshop to craft the item\n  actions.append(4)  # USE action\n  \n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T13:31:12.705354", "function_name": "craft", "function_body": "  actions = []\n  index = env.world.cookbook.index\n  item_index = index[item]\n  \n  if not primitives_for_item(item_index):\n    # No recipe to make this item\n    return []\n\n  # Find the workshop needed for crafting\n  workshop_needed = find_workshop(env, item)\n  actions.extend(move_to_location(env, workshop_needed))\n\n  # Craft the item (USE action at the workshop)\n  actions.append(craft.USE)\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-06T13:31:13.711864", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item has a recipe\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Check if all ingredients are available in the inventory or can be collected\n  required_primitives = set()\n  for ingredient, count in recipe.items():\n      if ingredient != \"_key\":\n          if ingredient not in env.world.cookbook.primitives:\n              required_primitives.add(ingredient)\n          elif env._current_state.inventory[ingredient] < count:\n              return []\n\n  # If we have all required primitives, proceed to craft the item\n  for primitive in required_primitives:\n      actions.extend(collect(env, env.world.cookbook.index.get(primitive)))\n\n  # Move to the workshop and perform the crafting action\n  workshop_index = recipe[\"_key\"]\n  if workshop_index in env.world.workshop_indices:\n      x, y = get_workshop_position(env, workshop_index)\n      move_to_workshop_actions = move_to(env, (x, y))\n      actions.extend(move_to_workshop_actions)\n      actions.append(4)  # USE action to craft the item\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-06T13:36:32.739924", "function_name": "craft", "function_body": "  def get_action_for_direction(dx, dy):\n    ACTION_UP = env.world.n_actions - 4 + 0\n    ACTION_DOWN = env.world.n_actions - 4 + 2\n    ACTION_LEFT = env.world.n_actions - 4 + 1\n    ACTION_RIGHT = env.world.n_actions - 4 + 3\n\n    if dx < 0:\n      return ACTION_LEFT\n    elif dx > 0:\n      return ACTION_RIGHT\n    elif dy < 0:\n      return ACTION_DOWN\n    else:\n      return ACTION_UP\n\n  def move_to_position(target_x, target_y):\n    \"\"\"Helper function to generate actions to move to a specific position.\"\"\"\n    actions = []\n    pos_x, pos_y = env._current_state.pos\n    \n    while pos_x != target_x or pos_y != target_y:\n      dx = target_x - pos_x\n      dy = target_y - pos_y\n      \n      if abs(dx) > abs(dy):\n        actions.append(get_action_for_direction(dx, 0))\n        pos_x += (-1 if dx < 0 else 1)\n      else:\n        actions.append(get_action_for_direction(0, dy))\n        pos_y += (-1 if dy < 0 else 1)\n    \n    return actions\n\n  def find_closest_target(target_positions):\n    \"\"\"Helper function to find the closest target position.\"\"\"\n    pos_x, pos_y = env._current_state.pos\n    \n    min_distance = float('inf')\n    closest_pos = None\n    \n    for tx, ty in zip(*target_positions):\n        distance = abs(tx - pos_x) + abs(ty - pos_y)\n        if distance < min_distance:\n            min_distance = distance\n            closest_pos = (tx, ty)\n    \n    return closest_pos\n\n  def collect_primitives(primitive_index, count):\n    \"\"\"Helper function to generate actions to collect required primitives.\"\"\"\n    current_inventory = env._current_state.inventory\n    actions = []\n    \n    while current_inventory[primitive_index] < count:\n      primitive_positions = np.where(env._current_state.grid[:, :, primitive_index] > 0)\n      closest_primitive_pos = find_closest_target(primitive_positions)\n      \n      if closest_primitive_pos is not None:\n        tx, ty = closest_primitive_pos\n        actions.extend(move_to_position(tx, ty))\n        actions.append(ACTION_USE)  # Assuming USE is always the last action to collect primitive\n        current_inventory[primitive_index] += 1\n      else:\n        return [], False  # If no source for the primitive, return empty list and failure flag\n    \n    return actions, True\n\n  def use_workshop():\n    \"\"\"Helper function to generate actions to use a workshop.\"\"\"\n    for i, workshop in enumerate(env.world.workshop_indices):\n      workshop_positions = np.where(env._current_state.grid[:, :, workshop] > 0)\n      closest_workshop_pos = find_closest_target(workshop_positions)\n      \n      if closest_workshop_pos is not None:\n        tx, ty = closest_workshop_pos\n        actions = move_to_position(tx, ty)\n        actions.append(ACTION_USE)  # Assuming USE is always the last action to craft item\n        return actions\n    \n    return []  # If no workshop found\n\n  def validate_recipe(item_index):\n      \"\"\"Helper function to validate if all required primitives are available in the environment.\"\"\"\n      primitives_needed = env.world.cookbook.primitives_for(item_index)\n      \n      for prim, count in primitives_needed.items():\n          primitive_positions = np.where(env._current_state.grid[:, :, prim] > 0)\n          \n          if len(primitive_positions[0]) == 0:\n              return False\n      \n      return True\n\n  ACTION_UP = env.world.n_actions - 4 + 0\n  ACTION_DOWN = env.world.n_actions - 4 + 2\n  ACTION_LEFT = env.world.n_actions - 4 + 1\n  ACTION_RIGHT = env.world.n_actions - 4 + 3\n  ACTION_USE = env.world.n_actions - 1\n\n  actions = []\n  \n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Validate if all required primitives are available in the environment\n  if not validate_recipe(item_index):\n    return []  # If any primitive is unavailable, return empty list\n  \n  # Check if we have all required primitives for crafting the item\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n\n  # Collect missing primitives\n  for prim, count in primitives_needed.items():\n    primitive_actions, success = collect_primitives(prim, count)\n    \n    if not success:\n      return []  # If no source for the primitive, return empty list\n    \n    actions.extend(primitive_actions)\n\n  # Find and use a workshop that has the required recipe\n  workshop_actions = use_workshop()\n  actions.extend(workshop_actions)\n\n  return actions", "island_id": 2, "scores": {"3": 0.29999995}}
{"timestamp": "2025-09-06T13:36:33.876949", "function_name": "craft", "function_body": "  def get_action_for_direction(dx, dy):\n    ACTION_UP = env.world.n_actions - 4 + 0\n    ACTION_DOWN = env.world.n_actions - 4 + 2\n    ACTION_LEFT = env.world.n_actions - 4 + 1\n    ACTION_RIGHT = env.world.n_actions - 4 + 3\n\n    if dx < 0:\n      return ACTION_LEFT\n    elif dx > 0:\n      return ACTION_RIGHT\n    elif dy < 0:\n      return ACTION_DOWN\n    else:\n      return ACTION_UP\n\n  def move_to_position(target_x, target_y):\n    \"\"\"Helper function to generate actions to move to a specific position.\"\"\"\n    actions = []\n    pos_x, pos_y = env._current_state.pos\n    \n    while pos_x != target_x or pos_y != target_y:\n      dx = target_x - pos_x\n      dy = target_y - pos_y\n      \n      if abs(dx) > abs(dy):\n        actions.append(get_action_for_direction(dx, 0))\n        pos_x += (-1 if dx < 0 else 1)\n      else:\n        actions.append(get_action_for_direction(0, dy))\n        pos_y += (-1 if dy < 0 else 1)\n    \n    return actions\n\n  def find_closest_target(target_positions):\n    \"\"\"Helper function to find the closest target position.\"\"\"\n    pos_x, pos_y = env._current_state.pos\n    \n    min_distance = float('inf')\n    closest_pos = None\n    \n    for tx, ty in zip(*target_positions):\n        distance = abs(tx - pos_x) + abs(ty - pos_y)\n        if distance < min_distance:\n            min_distance = distance\n            closest_pos = (tx, ty)\n    \n    return closest_pos\n\n  def collect_primitives(primitive_index, count):\n    \"\"\"Helper function to generate actions to collect required primitives.\"\"\"\n    current_inventory = env._current_state.inventory\n    actions = []\n    \n    while current_inventory[primitive_index] < count:\n      primitive_positions = np.where(env._current_state.grid[:, :, primitive_index] > 0)\n      closest_primitive_pos = find_closest_target(primitive_positions)\n      \n      if closest_primitive_pos is not None:\n        tx, ty = closest_primitive_pos\n        actions.extend(move_to_position(tx, ty))\n        actions.append(ACTION_USE)  # Assuming USE is always the last action to collect primitive\n        current_inventory[primitive_index] += 1\n      else:\n        return [], False  # If no source for the primitive, return empty list and failure flag\n    \n    return actions, True\n\n  def use_workshop():\n    \"\"\"Helper function to generate actions to use a workshop.\"\"\"\n    for i, workshop in enumerate(env.world.workshop_indices):\n      workshop_positions = np.where(env._current_state.grid[:, :, workshop] > 0)\n      closest_workshop_pos = find_closest_target(workshop_positions)\n      \n      if closest_workshop_pos is not None:\n        tx, ty = closest_workshop_pos\n        actions = move_to_position(tx, ty)\n        actions.append(ACTION_USE)  # Assuming USE is always the last action to craft item\n        return actions\n    \n    return []  # If no workshop found\n\n  def check_inventory_for_primitives(primitives_needed):\n    \"\"\"Check if we already have all required primitives.\"\"\"\n    current_inventory = env._current_state.inventory\n    for prim, count in primitives_needed.items():\n      if current_inventory[prim] < count:\n        return False\n    return True\n\n  ACTION_UP = env.world.n_actions - 4 + 0\n  ACTION_DOWN = env.world.n_actions - 4 + 2\n  ACTION_LEFT = env.world.n_actions - 4 + 1\n  ACTION_RIGHT = env.world.n_actions - 4 + 3\n  ACTION_USE = env.world.n_actions - 1\n\n  actions = []\n  \n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all required primitives for crafting the item\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n\n  # If all primitives are already in inventory, no need to collect them\n  if check_inventory_for_primitives(primitives_needed):\n    workshop_actions = use_workshop()\n    actions.extend(workshop_actions)\n    return actions\n\n  # Collect missing primitives\n  for prim, count in primitives_needed.items():\n    primitive_actions, success = collect_primitives(prim, count)\n    \n    if not success:\n      return []  # If no source for the primitive, return empty list\n    \n    actions.extend(primitive_actions)\n\n  # Find and use a workshop that has the required recipe\n  workshop_actions = use_workshop()\n  actions.extend(workshop_actions)\n\n  return actions", "island_id": 2, "scores": {"3": 2.0}}
{"timestamp": "2025-09-06T13:40:16.793550", "function_name": "craft", "function_body": "  def move_to_pos(pos):\n      current_pos = env._current_state.pos\n      path = bfs(current_pos, pos)\n      if not path:\n          return []\n      \n      action_map = {(-1, 0): craft.MOVE_FUNC(craft.UP), (1, 0): craft.MOVE_FUNC(craft.DOWN),\n                    (0, -1): craft.MOVE_FUNC(craft.LEFT), (0, 1): craft.MOVE_FUNC(craft.RIGHT)}\n      \n      actions = []\n      for i in range(1, len(path)):\n          dx = path[i][0] - path[i-1][0]\n          dy = path[i][1] - path[i-1][1]\n          action = action_map.get((dx, dy))\n          if action:\n              actions.append(action)\n      return actions\n\n  def bfs(start, end):\n      queue = collections.deque([start])\n      visited = set()\n      parent = {start: None}\n\n      while queue:\n          current = queue.popleft()\n          if current == end:\n              path = []\n              while current is not None:\n                  path.append(current)\n                  current = parent[current]\n              return path[::-1]\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = current[0] + dx, current[1] + dy\n              if 0 <= nx < env.world.grid.shape[0] and 0 <= ny < env.world.grid.shape[1]:\n                  neighbor = (nx, ny)\n                  if neighbor not in visited:\n                      queue.append(neighbor)\n                      visited.add(neighbor)\n                      parent[neighbor] = current\n\n      return None\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the primitives required to craft the item\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n  inventory_counts = collections.Counter(env._current_state.inventory)\n\n  # If any primitive is missing, return an empty action list\n  for prim_idx, count in primitives_required.items():\n      if inventory_counts.get(prim_idx, 0) < count:\n          return []\n\n  actions = []\n  \n  # Find all workshops and their positions\n  workshop_positions = {}\n  for i in range(env.world.grid.shape[0]):\n      for j in range(env.world.grid.shape[1]):\n          kind = np.argmax(env.world.grid[i, j])\n          if kind in env.world.workshop_indices:\n              workshop_positions[kind] = (i, j)\n  \n  # If no workshops are found, return an empty action list\n  if not workshop_positions:\n      return []\n\n  # Determine which workshop to use based on the recipe\n  recipe = env.world.cookbook.recipes[item_index]\n  required_primitives = {prim_idx for prim_idx in primitives_required}\n  available_workshops = set(workshop_positions.keys())\n  \n  # Find a workshop that can craft the item\n  workshop_kind = None\n  for kind, pos in workshop_positions.items():\n      if kind in recipe or \"_key\" in recipe:\n          workshop_kind = kind\n          break\n  \n  if not workshop_kind:\n      return []\n\n  # Move to the chosen workshop\n  actions.extend(move_to_pos(workshop_positions[workshop_kind]))\n  \n  # Add the USE action to craft the item\n  actions.append(craft.CRAFT_FUNC(item_index))\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T13:40:17.855515", "function_name": "craft", "function_body": "  def bfs(start, end):\n      queue = collections.deque([start])\n      visited = set()\n      parent = {start: None}\n\n      while queue:\n          current = queue.popleft()\n          if current == end:\n              path = []\n              while current is not None:\n                  path.append(current)\n                  current = parent[current]\n              return path[::-1]\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = current[0] + dx, current[1] + dy\n              if 0 <= nx < env.world.grid.shape[0] and 0 <= ny < env.world.grid.shape[1]:\n                  neighbor = (nx, ny)\n                  if neighbor not in visited:\n                      queue.append(neighbor)\n                      visited.add(neighbor)\n                      parent[neighbor] = current\n\n      return None\n\n  def move_to_pos(pos):\n      current_pos = env._current_state.pos\n      path = bfs(current_pos, pos)\n      if not path:\n          return []\n      \n      action_map = {(-1, 0): craft.MOVE_FUNC(craft.UP), (1, 0): craft.MOVE_FUNC(craft.DOWN),\n                    (0, -1): craft.MOVE_FUNC(craft.LEFT), (0, 1): craft.MOVE_FUNC(craft.RIGHT)}\n      \n      actions = []\n      for i in range(1, len(path)):\n          dx = path[i][0] - path[i-1][0]\n          dy = path[i][1] - path[i-1][1]\n          action = action_map.get((dx, dy))\n          if action:\n              actions.append(action)\n      return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the primitives required to craft the item\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n  inventory_counts = collections.Counter(env._current_state.inventory)\n\n  # If any primitive is missing, return an empty action list\n  for prim_idx, count in primitives_required.items():\n      if inventory_counts.get(prim_idx, 0) < count:\n          return []\n\n  actions = []\n  \n  # Find all workshops and their positions\n  workshop_positions = {}\n  for i in range(env.world.grid.shape[0]):\n      for j in range(env.world.grid.shape[1]):\n          kind = np.argmax(env.world.grid[i, j])\n          if kind in env.world.workshop_indices:\n              workshop_positions[kind] = (i, j)\n  \n  # If no workshops are found, return an empty action list\n  if not workshop_positions:\n      return []\n\n  # Determine which workshop to use based on the recipe\n  recipe = env.world.cookbook.recipes[item_index]\n  required_primitives = {prim_idx for prim_idx in primitives_required}\n  available_workshops = set(workshop_positions.keys())\n  \n  # Find a workshop that can craft the item\n  workshop_kind = None\n  for kind, pos in workshop_positions.items():\n      if kind in recipe or \"_key\" in recipe:\n          workshop_kind = kind\n          break\n  \n  if not workshop_kind:\n      return []\n\n  # Move to the chosen workshop\n  actions.extend(move_to_pos(workshop_positions[workshop_kind]))\n  \n  # Add the USE action to craft the item\n  actions.append(craft.CRAFT_FUNC(item_index))\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T13:44:37.906065", "function_name": "craft", "function_body": "  def find_all_positions_of_kind(grid: np.ndarray, kind_index: int):\n    positions = []\n    for y in range(grid.shape[0]):\n      for x in range(grid.shape[1]):\n        if grid[y, x, kind_index] > 0:\n          positions.append((x, y))\n    return positions\n\n  def distance(pos1: tuple, pos2: tuple) -> int:\n    \"\"\"Calculate the Manhattan distance between two positions.\"\"\"\n    return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n\n  def move_to_position(current_pos: tuple, target_pos: tuple) -> list[int]:\n    \"\"\"Generate a sequence of actions to move from current position to target position.\"\"\"\n    actions = []\n    current_x, current_y = current_pos\n    target_x, target_y = target_pos\n    \n    # Move vertically first if moving up (negative dy)\n    if current_y < target_y:\n        actions.extend([0] * (target_y - current_y))  # DOWN\n    elif current_y > target_y:\n        actions.extend([1] * (current_y - target_y))  # UP\n    \n    # Then move horizontally\n    if current_x < target_x:\n        actions.extend([2] * (target_x - current_x))  # RIGHT\n    elif current_x > target_x:\n        actions.extend([3] * (current_x - target_x))  # LEFT\n    \n    return actions\n\n  def collect_primitive(env, primitive: int) -> list[int]:\n    \"\"\"Generate a sequence of actions to collect the required primitive.\"\"\"\n    grid = env._current_state.grid\n    positions = find_all_positions_of_kind(grid, primitive)\n    \n    if not positions:\n        return []\n    \n    nearest_position = min(positions, key=lambda pos: distance(env._current_state.pos, pos))\n    path_to_primitive = move_to_position(env._current_state.pos, nearest_position)\n    return path_to_primitive + [4]  # Add USE action to collect the primitive\n\n  def find_workshop_index_for_item(item_index: int, cookbook):\n      \"\"\"Find the workshop index required for crafting an item.\"\"\"\n      recipe = cookbook.recipes[item_index]\n      workshop_key = recipe.get(\"_key\", None)\n      \n      if workshop_key is not None:\n          for key, value in cookbook.recipes.items():\n              if \"_key\" in value and value[\"_key\"] == workshop_key:\n                  return key\n      return None\n\n  def check_and_collect_primitives(env, primitives_needed):\n      actions = []\n      grid = env._current_state.grid\n      \n      for primitive, count in primitives_needed.items():\n          missing_count = count - env._current_state.inventory[primitive]\n          while missing_count > 0:\n              actions.extend(collect_primitive(env, primitive))\n              # Simulate the collection by updating inventory\n              env._current_state.inventory[primitive] += 1\n              missing_count -= 1\n      \n      return actions\n\n  def find_closest_workshop_position(grid: np.ndarray, workshop_index: int, current_pos: tuple):\n    positions = find_all_positions_of_kind(grid, workshop_index)\n    if not positions:\n        return None\n    nearest_position = min(positions, key=lambda pos: distance(current_pos, pos))\n    return nearest_position\n\n  def execute_actions(actions: list[int], env) -> bool:\n    \"\"\"Execute a sequence of actions in the environment and check if the item is crafted.\"\"\"\n    for action in actions:\n        reward, done, observations = env.step(action)\n        if done:\n            return True\n    return False\n\n  actions = []\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  # Check if we have all the primitives required for crafting\n  primitives_needed = cookbook.primitives_for(item_index)\n  actions.extend(check_and_collect_primitives(env, primitives_needed))\n  \n  # Find the workshop index needed to craft the item\n  workshop_index = find_workshop_index_for_item(item_index, cookbook)\n\n  if workshop_index is not None:\n      grid = env._current_state.grid\n      nearest_workshop_pos = find_closest_workshop_position(grid, workshop_index, env._current_state.pos)\n      \n      if nearest_workshop_pos is not None:\n          actions.extend(move_to_position(env._current_state.pos, nearest_workshop_pos))\n          \n          # Use the workshop to craft the item\n          actions.append(4)  # USE action\n  \n  return actions", "island_id": 1, "scores": {"3": 0.49999994}}
{"timestamp": "2025-09-06T13:44:38.953612", "function_name": "craft", "function_body": "  def find_all_positions_of_kind(grid: np.ndarray, kind_index: int):\n    positions = []\n    for y in range(grid.shape[0]):\n      for x in range(grid.shape[1]):\n        if grid[y, x, kind_index] > 0:\n          positions.append((x, y))\n    return positions\n\n  def distance(pos1: tuple, pos2: tuple) -> int:\n    \"\"\"Calculate the Manhattan distance between two positions.\"\"\"\n    return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n\n  def move_to_position(current_pos: tuple, target_pos: tuple) -> list[int]:\n    \"\"\"Generate a sequence of actions to move from current position to target position.\"\"\"\n    actions = []\n    current_x, current_y = current_pos\n    target_x, target_y = target_pos\n    \n    # Move vertically first if moving up (negative dy)\n    if current_y < target_y:\n        actions.extend([0] * (target_y - current_y))  # DOWN\n    elif current_y > target_y:\n        actions.extend([1] * (current_y - target_y))  # UP\n    \n    # Then move horizontally\n    if current_x < target_x:\n        actions.extend([2] * (target_x - current_x))  # RIGHT\n    elif current_x > target_x:\n        actions.extend([3] * (current_x - target_x))  # LEFT\n    \n    return actions\n\n  def collect_primitive(env, primitive: int) -> list[int]:\n    \"\"\"Generate a sequence of actions to collect the required primitive.\"\"\"\n    grid = env._current_state.grid\n    positions = find_all_positions_of_kind(grid, primitive)\n    \n    if not positions:\n        return []\n    \n    nearest_position = min(positions, key=lambda pos: distance(env._current_state.pos, pos))\n    path_to_primitive = move_to_position(env._current_state.pos, nearest_position)\n    return path_to_primitive + [4]  # Add USE action to collect the primitive\n\n  def find_workshop_index_for_item(item_index: int, cookbook):\n      \"\"\"Find the workshop index required for crafting an item.\"\"\"\n      recipe = cookbook.recipes[item_index]\n      workshop_key = recipe.get(\"_key\", None)\n      \n      if workshop_key is not None:\n          for key, value in cookbook.recipes.items():\n              if \"_key\" in value and value[\"_key\"] == workshop_key:\n                  return key\n      return None\n\n  def check_and_collect_primitives(env, primitives_needed):\n      actions = []\n      grid = env._current_state.grid\n      \n      for primitive, count in primitives_needed.items():\n          missing_count = count - env._current_state.inventory[primitive]\n          while missing_count > 0:\n              actions.extend(collect_primitive(env, primitive))\n              # Simulate the collection by updating inventory\n              env._current_state.inventory[primitive] += 1\n              missing_count -= 1\n      \n      return actions\n\n  def find_closest_workshop_position(grid: np.ndarray, workshop_index: int, current_pos: tuple):\n    positions = find_all_positions_of_kind(grid, workshop_index)\n    if not positions:\n        return None\n    nearest_position = min(positions, key=lambda pos: distance(current_pos, pos))\n    return nearest_position\n\n  def optimize_path(actions: list[int]):\n      \"\"\"Optimize the sequence of actions to reduce redundant moves.\"\"\"\n      optimized_actions = []\n      current_direction = -1\n      \n      for action in actions:\n          if current_direction == -1 or (current_direction != action and not are_opposites(current_direction, action)):\n              optimized_actions.append(action)\n          current_direction = action\n      \n      return optimized_actions\n\n  def are_opposites(dir1: int, dir2: int) -> bool:\n      \"\"\"Check if two directions are opposites.\"\"\"\n      return (dir1 == 0 and dir2 == 1) or (dir1 == 1 and dir2 == 0) or (dir1 == 2 and dir2 == 3) or (dir1 == 3 and dir2 == 2)\n\n  actions = []\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  # Check if we have all the primitives required for crafting\n  primitives_needed = cookbook.primitives_for(item_index)\n  actions.extend(check_and_collect_primitives(env, primitives_needed))\n  \n  # Find the workshop index needed to craft the item\n  workshop_index = find_workshop_index_for_item(item_index, cookbook)\n\n  if workshop_index is not None:\n      grid = env._current_state.grid\n      nearest_workshop_pos = find_closest_workshop_position(grid, workshop_index, env._current_state.pos)\n      \n      if nearest_workshop_pos is not None:\n          actions.extend(move_to_position(env._current_state.pos, nearest_workshop_pos))\n          \n          # Use the workshop to craft the item\n          actions.append(4)  # USE action\n  \n  return optimize_path(actions)", "island_id": 1, "scores": {"3": 0.49999994}}
{"timestamp": "2025-09-06T13:48:33.009498", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index of the goal item\n  goal_index = env.world.cookbook.index[item]\n  \n  # Check if the goal item has a recipe in the cookbook\n  if goal_index not in env.world.cookbook.recipes:\n    return []\n\n  # Fetch the recipe for the goal item\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  # List of actions to collect primitives needed for crafting\n  collect_actions = []\n  \n  # Check and collect all required primitives or ingredients\n  for ingredient, count in recipe.items():\n    if ingredient == \"_key\":\n      continue  # Skip the key if present in the recipe\n    \n    ingredient_index = int(ingredient)\n    \n    # If the ingredient is not already in inventory\n    if env._current_state.inventory[ingredient_index] < count:\n      # Generate actions to collect the required amount of primitives or ingredients\n      collect_actions += collect_v2(env, env.world.cookbook.index.get(env.world.cookbook.reverse_contents[ingredient_index]))\n  \n  actions.extend(collect_actions)\n  \n  # Check if all required items are now in inventory\n  for ingredient, count in recipe.items():\n    if ingredient == \"_key\":\n      continue  # Skip the key if present in the recipe\n    \n    ingredient_index = int(ingredient)\n    \n    if env._current_state.inventory[ingredient_index] < count:\n      return []  # If not enough ingredients are collected, return an empty action list\n\n  # Perform crafting actions\n  workshop_type = \"_key\" in recipe\n  for _ in range(count):\n    # Find the appropriate workshop based on the item to be crafted\n    if workshop_type and recipe[\"_key\"] == \"workshop\":\n      workshops = env.world.workshop_indices[0]  # Assuming workshop type is specified correctly\n      actions.append(env.world.cookbook.index[\"WORKSHOP0\"])  # Hardcoded for now, need to dynamically find the correct workshop\n    else:\n      workshops = None\n\n    if workshops is not None:\n      x, y = env._current_state.pos\n      # Find nearest workshop and move towards it\n      min_distance = float('inf')\n      nearest_workshop = None\n      \n      for workshop_index in workshops:\n        wx, wy = divmod(workshop_index, 10)  # Assuming a grid size of 10x10 for simplicity\n        distance = abs(wx - x) + abs(wy - y)\n        if distance < min_distance:\n          min_distance = distance\n          nearest_workshop = (wx, wy)\n\n      # Generate actions to move towards the nearest workshop\n      actions.extend(move_towards(env, nearest_workshop))\n      \n      # Add the USE action to perform crafting at the workshop\n      actions.append(craft.USE)\n    else:\n      # If no specific workshop is required, just add the USE action (assuming the agent is already at a suitable location)\n      actions.append(craft.USE)\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-06T13:48:33.978831", "function_name": "craft", "function_body": "  actions = []\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item\n  item_index = cookbook.index[item]\n  \n  # If the item is a primitive or in environment, we cannot craft it directly\n  if item_index in cookbook.environment or item_index in cookbook.primitives:\n    return actions\n  \n  # Check if we have all the ingredients required to craft the item\n  recipe = cookbook.recipes.get(item_index)\n  if not recipe:\n    return actions\n\n  def gather_primitive(primitive_index):\n    nonlocal actions\n    # Check if primitive is already in inventory\n    if env._current_state.inventory[primitive_index] > 0:\n      return\n    \n    # Find the nearest location of the primitive on the grid\n    pos = env._current_state.pos\n    grid = env._current_state.grid\n\n    # Search for the primitive within a reasonable range (e.g., 15x15 window)\n    search_range = min(15, grid.shape[0], grid.shape[1])\n    found_position = None\n    for dx in range(-search_range, search_range + 1):\n      for dy in range(-search_range, search_range + 1):\n        x, y = pos[0] + dx, pos[1] + dy\n        if 0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]:\n          if grid[x, y, primitive_index] > 0:\n            found_position = (x, y)\n            break\n      if found_position:\n        break\n\n    # If the primitive is not found, we cannot gather it\n    if not found_position:\n      return\n    \n    # Move to the position of the primitive\n    actions.extend(move_to(env._current_state, found_position))\n    \n    # Collect the primitive\n    actions.append(craft.COLLECT_FUNC(primitive_index))\n  \n  def move_to(current_state, target_pos):\n    nonlocal actions\n    pos = current_state.pos\n    dir = current_state.dir\n    \n    # Simple A* search to find a path from pos to target_pos\n    def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n    \n    open_set = [(heuristic(pos, target_pos), pos)]\n    came_from = {}\n    g_score = {pos: 0}\n    f_score = {pos: heuristic(pos, target_pos)}\n    \n    while open_set:\n      _, current = min(open_set, key=lambda x: x[0])\n      open_set.remove((f_score[current], current))\n      \n      if current == target_pos:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        path.reverse()\n        return [move_to_direction(pos, next_pos) for pos, next_pos in zip(path[:-1], path[1:])] + [craft.USE_ACTION]\n      \n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        tentative_g_score = g_score[current] + 1\n        \n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n          if tentative_g_score < g_score.get(neighbor, float('inf')):\n            came_from[neighbor] = current\n            g_score[neighbor] = tentative_g_score\n            f_score[neighbor] = tentative_g_score + heuristic(neighbor, target_pos)\n            open_set.append((f_score[neighbor], neighbor))\n    \n    return []  # No path found\n  \n  def move_to_direction(current_pos, next_pos):\n    nonlocal actions\n    dir = env._current_state.dir\n    \n    # Calculate the direction to move from current_pos to next_pos\n    dx = next_pos[0] - current_pos[0]\n    dy = next_pos[1] - current_pos[1]\n    \n    if dx == 0 and dy == 0:\n      return craft.USE_ACTION\n    \n    target_dir = None\n    if dx > 0:\n      target_dir = craft.RIGHT_ACTION\n    elif dx < 0:\n      target_dir = craft.LEFT_ACTION\n    elif dy > 0:\n      target_dir = craft.DOWN_ACTION\n    elif dy < 0:\n      target_dir = craft.UP_ACTION\n    \n    if dir != target_dir:\n      return target_dir\n    \n    return craft.USE_ACTION\n  \n  # Gather all required primitives\n  for ingredient_index, count in recipe.items():\n    if ingredient_index == \"_key\":\n      continue\n    while env._current_state.inventory[ingredient_index] < count:\n      gather_primitive(ingredient_index)\n  \n  # Craft the item at a workshop\n  for workshop_index in cookbook.workshop_indices:\n    if env._current_state.next_to(workshop_index):\n      actions.append(craft.MOVE_FUNC(dir=craft.USE_ACTION))\n      break\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-06T13:53:10.312110", "function_name": "craft", "function_body": "  ACTION_UP = env.world.n_actions - 4 + 0\n  ACTION_DOWN = env.world.n_actions - 4 + 2\n  ACTION_LEFT = env.world.n_actions - 4 + 1\n  ACTION_RIGHT = env.world.n_actions - 4 + 3\n  ACTION_USE = env.world.n_actions - 1\n\n  def move_to_position(target_x, target_y):\n    \"\"\"Helper function to generate actions to move to a specific position.\"\"\"\n    actions = []\n    pos_x, pos_y = env._current_state.pos\n    \n    while pos_x != target_x or pos_y != target_y:\n      dx = target_x - pos_x\n      dy = target_y - pos_y\n      \n      if abs(dx) > abs(dy):\n        actions.append(ACTION_LEFT if dx < 0 else ACTION_RIGHT)\n        pos_x += (-1 if dx < 0 else 1)\n      else:\n        actions.append(ACTION_DOWN if dy < 0 else ACTION_UP)\n        pos_y += (-1 if dy < 0 else 1)\n    \n    return actions\n\n  def find_closest_target(target_positions):\n    \"\"\"Helper function to find the closest target position.\"\"\"\n    pos_x, pos_y = env._current_state.pos\n    \n    min_distance = float('inf')\n    closest_pos = None\n    \n    for tx, ty in zip(*target_positions):\n        distance = abs(tx - pos_x) + abs(ty - pos_y)\n        if distance < min_distance:\n            min_distance = distance\n            closest_pos = (tx, ty)\n    \n    return closest_pos\n\n  def pick_up_primitives(primitive_index, count):\n    \"\"\"Helper function to generate actions to pick up primitives.\"\"\"\n    actions = []\n    current_inventory = env._current_state.inventory\n    \n    while current_inventory[primitive_index] < count:\n      target_positions = np.where(env._current_state.grid[:, :, primitive_index] > 0)\n      \n      if len(target_positions[0]) == 0 or len(target_positions[1]) == 0:\n        return [], False\n      \n      closest_primitive_pos = find_closest_target(target_positions)\n      \n      if closest_primitive_pos is not None:\n          tx, ty = closest_primitive_pos\n          actions.extend(move_to_position(tx, ty))\n          actions.append(ACTION_USE)  # Assuming USE is always the last action to collect primitive\n          current_inventory[primitive_index] += 1\n      else:\n        return [], False  # If no source for the primitive, return empty list and failure flag\n    \n    return actions, True\n\n  def use_workshop(workshop_index):\n    \"\"\"Helper function to generate actions to use a workshop.\"\"\"\n    target_positions = np.where(env._current_state.grid[:, :, workshop_index] > 0)\n    \n    if len(target_positions[0]) == 0 or len(target_positions[1]) == 0:\n      return None\n    \n    closest_workshop_pos = find_closest_target(target_positions)\n    \n    if closest_workshop_pos is not None:\n        tx, ty = closest_workshop_pos\n        actions = move_to_position(tx, ty)\n        actions.append(ACTION_USE)  # Assuming USE is always the last action to craft item\n        return actions\n\n  def verify_inventory():\n    \"\"\"Helper function to verify if we have all required primitives.\"\"\"\n    item_index = env.world.cookbook.index[item]\n    primitives_needed = env.world.cookbook.primitives_for(item_index)\n    \n    for prim, count in primitives_needed.items():\n      if env._current_state.inventory[prim] < count:\n        return False\n    \n    return True\n\n  actions = []\n  \n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Verify if we have all required primitives for crafting the item\n  if not verify_inventory():\n    # Collect missing primitives\n    primitives_needed = env.world.cookbook.primitives_for(item_index)\n\n    for prim, count in primitives_needed.items():\n      primitive_actions, success = pick_up_primitives(prim, count)\n      \n      if not success:\n        return []  # If no source for the primitive, return empty list\n      \n      actions.extend(primitive_actions)\n\n  # Find and use a workshop that has the required recipe\n  for i, workshop in enumerate(env.world.workshop_indices):\n    workshop_actions = use_workshop(workshop)\n    \n    if workshop_actions is not None:\n      actions.extend(workshop_actions)\n      \n      # Perform USE action to craft the item\n      actions.append(ACTION_USE)\n      break\n\n  return actions", "island_id": 2, "scores": {"3": 2.0}}
{"timestamp": "2025-09-06T13:53:11.370633", "function_name": "craft", "function_body": "  def move_to_position(target_x, target_y):\n    \"\"\"Helper function to generate actions to move to a specific position.\"\"\"\n    actions = []\n    pos_x, pos_y = env._current_state.pos\n    \n    while pos_x != target_x or pos_y != target_y:\n      dx = target_x - pos_x\n      dy = target_y - pos_y\n      \n      if abs(dx) > abs(dy):\n        actions.append(ACTION_LEFT if dx < 0 else ACTION_RIGHT)\n        pos_x += (-1 if dx < 0 else 1)\n      else:\n        actions.append(ACTION_DOWN if dy < 0 else ACTION_UP)\n        pos_y += (-1 if dy < 0 else 1)\n    \n    return actions\n\n  def find_closest_target(target_positions):\n    \"\"\"Helper function to find the closest target position.\"\"\"\n    pos_x, pos_y = env._current_state.pos\n    \n    min_distance = float('inf')\n    closest_pos = None\n    \n    for tx, ty in zip(*target_positions):\n        distance = abs(tx - pos_x) + abs(ty - pos_y)\n        if distance < min_distance:\n            min_distance = distance\n            closest_pos = (tx, ty)\n    \n    return closest_pos\n\n  def pick_up_primitives(primitive_index, count):\n    \"\"\"Helper function to generate actions to pick up primitives.\"\"\"\n    actions = []\n    current_inventory = env._current_state.inventory\n    \n    while current_inventory[primitive_index] < count:\n      target_positions = np.where(env._current_state.grid[:, :, primitive_index] > 0)\n      \n      if len(target_positions[0]) == 0 or len(target_positions[1]) == 0:\n        return [], False\n      \n      closest_primitive_pos = find_closest_target(target_positions)\n      \n      if closest_primitive_pos is not None:\n          tx, ty = closest_primitive_pos\n          actions.extend(move_to_position(tx, ty))\n          actions.append(ACTION_USE)  # Assuming USE is always the last action to collect primitive\n          current_inventory[primitive_index] += 1\n      else:\n        return [], False  # If no source for the primitive, return empty list and failure flag\n    \n    return actions, True\n\n  def use_workshop():\n    \"\"\"Helper function to generate actions to use a workshop.\"\"\"\n    workshops = env.world.workshop_indices\n    grid = env._current_state.grid\n    \n    for workshop in workshops:\n      workshop_positions = np.where(grid[:, :, workshop] > 0)\n      \n      if len(workshop_positions[0]) == 0 or len(workshop_positions[1]) == 0:\n        continue\n      \n      closest_workshop_pos = find_closest_target(workshop_positions)\n      \n      if closest_workshop_pos is not None:\n          tx, ty = closest_workshop_pos\n          actions = move_to_position(tx, ty)\n          actions.append(ACTION_USE)  # Assuming USE is always the last action to craft item\n          return actions\n    \n    return None\n\n  ACTION_UP = env.world.n_actions - 4 + 0\n  ACTION_DOWN = env.world.n_actions - 4 + 2\n  ACTION_LEFT = env.world.n_actions - 4 + 1\n  ACTION_RIGHT = env.world.n_actions - 4 + 3\n  ACTION_USE = env.world.n_actions - 1\n\n  actions = []\n  \n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all required primitives for crafting the item\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n\n  # Collect missing primitives\n  for prim, count in primitives_needed.items():\n    primitive_actions, success = pick_up_primitives(prim, count)\n    \n    if not success:\n      return []  # If no source for the primitive, return empty list\n    \n    actions.extend(primitive_actions)\n\n  # Find and use a workshop that has the required recipe\n  workshop_actions = use_workshop()\n  \n  if workshop_actions is not None:\n    actions.extend(workshop_actions)\n    \n    # Perform USE action to craft the item\n    actions.append(ACTION_USE)\n  else:\n    return []  # If no workshop found, return empty list\n\n  return actions", "island_id": 2, "scores": {"3": 2.0}}
{"timestamp": "2025-09-06T13:55:25.232592", "function_name": "craft", "function_body": "  def move_to_pos(pos):\n    current_pos = env._current_state.pos\n    path = bfs(current_pos, pos)\n    if not path:\n      return []\n    \n    action_map = {(-1, 0): craft.MOVE_FUNC(craft.UP), (1, 0): craft.MOVE_FUNC(craft.DOWN),\n                  (0, -1): craft.MOVE_FUNC(craft.LEFT), (0, 1): craft.MOVE_FUNC(craft.RIGHT)}\n    \n    actions = []\n    for i in range(1, len(path)):\n      dx = path[i][0] - path[i-1][0]\n      dy = path[i][1] - path[i-1][1]\n      action = action_map.get((dx, dy))\n      if action:\n        actions.append(action)\n    return actions\n\n  def bfs(start, goal):\n    queue = collections.deque([start])\n    came_from = {start: None}\n    \n    while queue:\n      current = queue.popleft()\n      \n      if current == goal:\n        path = []\n        while current is not None:\n          path.append(current)\n          current = came_from[current]\n        return list(reversed(path))\n      \n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        if 0 <= neighbor[0] < env.world.grid.shape[0] and 0 <= neighbor[1] < env.world.grid.shape[1]:\n          kind = np.argmax(env.world.grid[neighbor])\n          if kind not in env.world.grass_indices:  # Assuming grass is the only traversable terrain\n            continue\n          if neighbor not in came_from:\n            queue.append(neighbor)\n            came_from[neighbor] = current\n    \n    return []\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the primitives required to craft the item\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n  inventory_counts = collections.Counter(env._current_state.inventory)\n\n  # If any primitive is missing, return an empty action list\n  for prim_idx, count in primitives_required.items():\n    if inventory_counts.get(prim_idx, 0) < count:\n      return []\n\n  actions = []\n  \n  # Find all workshops and their positions\n  workshop_positions = {}\n  for i in range(env.world.grid.shape[0]):\n    for j in range(env.world.grid.shape[1]):\n      kind = np.argmax(env.world.grid[i, j])\n      if kind in env.world.workshop_indices:\n        workshop_positions[kind] = (i, j)\n  \n  # If no workshops are found, return an empty action list\n  if not workshop_positions:\n    return []\n\n  # Determine which workshop to use based on the recipe\n  recipe = env.world.cookbook.recipes[item_index]\n  required_primitives = {prim_idx for prim_idx in primitives_required}\n  available_workshops = set(workshop_positions.keys())\n  \n  # Find a workshop that can craft the item\n  workshop_kind = None\n  for kind, pos in workshop_positions.items():\n    if kind in recipe or \"_key\" in recipe:\n      workshop_kind = kind\n      break\n  \n  if not workshop_kind:\n    return []\n\n  # Move to the chosen workshop\n  actions.extend(move_to_pos(workshop_positions[workshop_kind]))\n  \n  # Add the USE action to craft the item\n  actions.append(craft.CRAFT_FUNC(item_index))\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
