{"timestamp": "2025-09-06T09:23:53.762320", "function_name": "craft", "function_body": "  def move(dir):\n    if dir == 'UP':\n      return env.world.N_ACTIONS - 4\n    elif dir == 'DOWN':\n      return env.world.N_ACTIONS - 3\n    elif dir == 'LEFT':\n      return env.world.N_ACTIONS - 2\n    elif dir == 'RIGHT':\n      return env.world.N_ACTIONS - 1\n\n  def use():\n    return env.world.N_ACTIONS - 5\n\n  actions = []\n\n  # Get the cookbook and index for the item\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n\n  if item_index not in cookbook.recipes:\n    return []  # Item has no recipe\n\n  # Check and collect missing primitives\n  missing_primitives = []\n  for ingredient, count in cookbook.recipes[item_index].items():\n    if ingredient == \"_key\":\n      continue\n    \n    if ingredient not in cookbook.primitives:\n      return []\n    \n    ingredient_index = int(ingredient)\n    if env._current_state.inventory[ingredient_index] < count:\n      missing_primitives.append((ingredient_index, count - env._current_state.inventory[ingredient_index]))\n\n  for primitive_index, required_count in missing_primitives:\n    actions.extend(collect_v0(env, primitive_index))\n\n  # Find a workshop that can craft the item\n  workshop_indices = env.world.workshop_indices\n  recipe = cookbook.recipes[item_index]\n  found_workshop = None\n  for workshop in workshop_indices:\n    if workshop in recipe:  # Check if the workshop is specified in the recipe\n      found_workshop = workshop\n      break\n\n  if not found_workshop:\n    return []  # No suitable workshop found\n\n  # Move to the nearest workshop that can craft the item\n  pos = env._current_state.pos\n  dir = env._current_state.dir\n  grid = env._current_state.grid\n  target_pos = None\n  for i in range(grid.shape[0]):\n    for j in range(grid.shape[1]):\n      if grid[i, j, found_workshop] > 0:\n        target_pos = (i, j)\n        break\n    if target_pos:\n      break\n\n  if not target_pos:\n    return []  # No workshop of the required type found on the grid\n\n  # Navigate to the workshop using A* search algorithm for pathfinding\n  actions.extend(a_star_search(env._current_state.grid, env._current_state.pos, target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(use())\n\n  return actions", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T09:23:54.743380", "function_name": "craft", "function_body": "  # Helper function to perform the USE action\n  def use():\n    return env.world.N_ACTIONS - 5\n\n  actions = []\n\n  # Get the cookbook and index for the item\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n\n  if item_index not in cookbook.recipes:\n    return []  # Item has no recipe\n\n  # Check if we have all the primitives required for crafting\n  primitives_needed = cookbook.primitives_for(item_index)\n  inventory = env._current_state.inventory\n  missing_primitives = {}\n\n  for primitive, count in primitives_needed.items():\n    if inventory[primitive] < count:\n      missing_primitives[primitive] = count - inventory[primitive]\n\n  # Collect all missing primitives\n  if missing_primitives:\n    for primitive, required_count in missing_primitives.items():\n      actions.extend(collect_v0(env, primitive))\n    \n    return actions\n\n  # Find a workshop that can craft the item\n  workshop_indices = env.world.workshop_indices\n  recipe = cookbook.recipes[item_index]\n  found_workshop = None\n  for workshop in workshop_indices:\n    if workshop in recipe:  # Check if the workshop is specified in the recipe\n      found_workshop = workshop\n      break\n\n  if not found_workshop:\n    return []  # No suitable workshop found\n\n  # Move to the nearest workshop that can craft the item\n  pos = env._current_state.pos\n  dir = env._current_state.dir\n  grid = env._current_state.grid\n  target_pos = None\n  for i in range(grid.shape[0]):\n    for j in range(grid.shape[1]):\n      if grid[i, j, found_workshop] > 0:\n        target_pos = (i, j)\n        break\n    if target_pos:\n      break\n\n  if not target_pos:\n    return []  # No workshop of the required type found on the grid\n\n  # Navigate to the workshop using A* search algorithm for pathfinding\n  actions.extend(a_star_search(env._current_state.grid, env._current_state.pos, target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(use())\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-06T09:25:30.155889", "function_name": "craft", "function_body": "  # Convert the item name to its index in the cookbook's index\n  goal_index = env.world.cookbook.index[item]\n  \n  # Get primitives needed for crafting the item (returns a dict)\n  primitives_needed = env.world.cookbook.primitives_for(goal_index)\n\n  # Check if we have all primitives in inventory or can collect them\n  actions = []\n  current_inventory = env._current_state.inventory\n  \n  # Iterate through each primitive and check if it is available in inventory\n  for primitive, count in primitives_needed.items():\n    if current_inventory[primitive] < count:\n      # If not enough of the primitive, we need to collect more.\n      actions.extend(collect(env, primitive))", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-06T09:25:31.148669", "function_name": "craft", "function_body": "  # Fetch the index of the item from the cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the item has a recipe in the cookbook\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Retrieve the recipe for the item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Collect all the required primitives and ingredients from the environment.\n  actions = []\n  for ingredient, count in recipe.items():\n      if ingredient == \"_key\": continue  # Skip the key if present\n      \n      # Convert ingredient index back to name using reverse_contents\n      ingredient_name = env.world.cookbook.index.get(ingredient)\n      \n      # Collect the required number of ingredients\n      actions.extend(collect(env, ingredient_name) * count)\n\n  # Find a workshop location and move there\n  workshops = [idx for idx in env.world.workshop_indices if env._current_state.next_to(idx)]\n  if not workshops:\n    return []  # No nearby workshop found\n\n  workshop_index = workshops[0]\n  \n  # Move to the first available workshop location\n  actions.extend(move(env, env.world.index.get(workshop_index)))\n  \n  # Perform the USE action to craft the item\n  actions.append(4)  # Assuming 4 is the index for the USE action\n  \n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-06T09:28:23.130389", "function_name": "craft", "function_body": "  def navigate_to_workshop(env, workshop_index):\n    target_pos = find_workshop_position(env, workshop_index)\n    current_pos = env._current_state.pos\n    path = a_star_search(current_pos, target_pos, env._current_state.grid)\n    actions = []\n    for next_step in path:\n      if next_step[0] > current_pos[0]:\n        actions.append(env.world.RIGHT)\n      elif next_step[0] < current_pos[0]:\n        actions.append(env.world.LEFT)\n      if next_step[1] > current_pos[1]:\n        actions.append(env.world.DOWN)\n      elif next_step[1] < current_pos[1]:\n        actions.append(env.world.UP)\n      current_pos = next_step\n    return actions\n\n  def find_workshop_position(env, workshop_index):\n    grid = env._current_state.grid\n    positions = np.argwhere(grid[:, :, workshop_index] == 1)\n    if len(positions) > 0:\n      return tuple(positions[0])\n    else:\n      raise ValueError(f\"No position found for workshop index {workshop_index}\")\n\n  def heuristic(a, b):\n    return abs(b[0] - a[0]) + abs(b[1] - a[1])\n\n  def a_star_search(start, goal, grid):\n    open_set = collections.PriorityQueue()\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, goal)}\n    open_set.put((f_score[start], start))\n    \n    while not open_set.empty():\n      _, current = open_set.get()\n\n      if current == goal:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        return path[::-1]\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n          tentative_g_score = g_score[current] + 1\n          if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n            came_from[neighbor] = current\n            g_score[neighbor] = tentative_g_score\n            f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n            open_set.put((f_score[neighbor], neighbor))\n    \n    return []  # No path found\n\n  actions = []\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n  \n  # Check if we have all required primitives in our inventory\n  required_primitives = cookbook.primitives_for(goal_index)\n  for primitive, count in required_primitives.items():\n    if env._current_state.inventory[primitive] < count:\n      return []  # Not enough primitives to craft the item\n\n  # Find a workshop to perform crafting\n  recipe = cookbook.recipes.get(goal_index, {})\n  workshop_indices = [ingredient for ingredient in recipe.keys() \n                      if ingredient in env.world.workshop_indices and ingredient != \"_key\"]\n\n  if not workshop_indices:\n    return []  # No suitable workshop found\n  \n  # Sort workshops by distance to the nearest one\n  distances = {workshop: heuristic(env._current_state.pos, find_workshop_position(env, workshop)) for workshop in workshop_indices}\n  closest_workshop_index = min(distances, key=distances.get)\n  \n  # Navigate to the nearest workshop using A* search\n  actions.extend(navigate_to_workshop(env, closest_workshop_index))\n\n  # Perform USE action at the workshop to craft the item\n  actions.append(env.world.N_ACTIONS - 1)  # Assuming USE is the last action index (N_ACTIONS - 1)\n\n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T09:28:24.178184", "function_name": "craft", "function_body": "  def navigate_to_workshop_actions(pos, target_pos):\n    dx = target_pos[0] - pos[0]\n    dy = target_pos[1] - pos[1]\n\n    actions = []\n    if dx > 0:\n        actions.extend([env.world.RIGHT for _ in range(abs(dx))])\n    elif dx < 0:\n        actions.extend([env.world.LEFT for _ in range(abs(dx))])\n\n    if dy > 0:\n        actions.extend([env.world.DOWN for _ in range(abs(dy))])\n    elif dy < 0:\n        actions.extend([env.world.UP for _ in range(abs(dy))])\n\n    return actions\n\n  def find_workshop_position(env, workshop_index):\n    grid = env._current_state.grid\n    positions = np.argwhere(grid[:, :, workshop_index] == 1)\n    if len(positions) > 0:\n        return tuple(positions[0])\n    else:\n        raise ValueError(f\"No position found for workshop index {workshop_index}\")\n\n  actions = []\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n  \n  # Check if we have all required primitives in our inventory\n  required_primitives = cookbook.primitives_for(goal_index)\n  for primitive, count in required_primitives.items():\n    if env._current_state.inventory[primitive] < count:\n      return []  # Not enough primitives to craft the item\n\n  # Find a workshop to perform crafting\n  recipe = cookbook.recipes.get(goal_index, {})\n  workshop_indices = [ingredient for ingredient in recipe.keys() \n                      if ingredient in env.world.workshop_indices and ingredient != \"_key\"]\n\n  if not workshop_indices:\n    return []  # No suitable workshop found\n  \n  # Sort workshops by distance to the nearest one\n  distances = {workshop: manhattan_distance(env._current_state.pos, find_workshop_position(env, workshop)) for workshop in workshop_indices}\n  closest_workshop_index = min(distances, key=distances.get)\n  \n  # Navigate to the nearest workshop\n  target_pos = find_workshop_position(env, closest_workshop_index)\n  actions.extend(navigate_to_workshop_actions(env._current_state.pos, target_pos))\n\n  # Perform USE action at the workshop to craft the item\n  actions.append(env.world.USE)  # Using the USE attribute directly from env.world\n\n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T09:29:45.348153", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n  inventory = env._current_state.inventory\n\n  # If any of the required primitives are not available, return an empty action list\n  if any(inventory[i] < count for i, count in primitives_required.items()):\n    return []\n\n  recipe = env.world.cookbook.recipes[item_index]\n  possible_workshops = [w for w in env.world.workshop_indices if recipe.get(f\"_{w}\") is not None]\n\n  if not possible_workshops:\n    return []\n\n  # For simplicity, let's choose the first available workshop\n  workshop_index = possible_workshops[0]\n\n  # Actions to navigate to the workshop\n  actions_to_workshop = find_path(env._current_state.grid, env._current_state.pos, (env.world.workshop_indices.index(workshop_index),))\n\n  if not actions_to_workshop:\n    return []\n\n  USE_ACTION = 4\n\n  # Combine all actions\n  actions = actions_to_workshop + [USE_ACTION]\n\n  return actions", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T09:29:46.312991", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n  inventory = env._current_state.inventory\n\n  # Check if we have all the items/primitives required for crafting\n  missing_primitives = {i: count - inventory[i] for i, count in primitives_required.items() if inventory[i] < count}\n\n  if not missing_primitives:\n    return craft_v1(env, item)  # If no primitives are missing, proceed to crafting\n\n  actions = []\n  \n  # Collect missing primitives\n  for primitive_index, count_needed in missing_primitives.items():\n      primitive_name = env.world.cookbook.index.get(primitive_index)\n      if not primitive_name:\n          continue\n      \n      actions.extend(collect(env, primitive_name) * count_needed)\n\n  # After collecting all required primitives, proceed to crafting\n  actions.extend(craft_v1(env, item))\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-06T09:33:30.658493", "function_name": "craft", "function_body": "  def find_path(grid, start_pos, target_index):\n    target = env.world.workshop_indices[target_index]\n    queue = collections.deque([start_pos])\n    visited = set([start_pos])\n    came_from = {start_pos: None}\n    \n    while queue:\n      current = queue.popleft()\n      if grid[current] == target:\n        path = []\n        while current is not None:\n          path.append(current)\n          current = came_from[current]\n        return path[::-1]\n      \n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        if grid.shape[0] > neighbor[0] >= 0 and grid.shape[1] > neighbor[1] >= 0 and neighbor not in visited:\n          queue.append(neighbor)\n          visited.add(neighbor)\n          came_from[neighbor] = current\n    \n    return []\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the items/primitives required for crafting\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n  inventory = env._current_state.inventory\n  \n  # If any of the required primitives are not available, return an empty action list\n  if any(inventory[i] < count for i, count in primitives_required.items()):\n    return []\n  \n  # Find a workshop that can be used to craft the item\n  recipe = env.world.cookbook.recipes[item_index]\n  possible_workshops = [w for w in env.world.workshop_indices if recipe.get(f\"_{w}\") is not None]\n  \n  if not possible_workshops:\n    return []\n  \n  # For simplicity, let's choose the first available workshop\n  workshop_index = possible_workshops[0]\n  \n  # Get the current position of the agent and direction\n  current_pos = env._current_state.pos\n  \n  # Actions to navigate to the workshop\n  path_to_workshop = find_path(env._current_state.grid, current_pos, env.world.workshop_indices.index(workshop_index))\n  \n  if not path_to_workshop:\n    return []\n  \n  # Convert path to actions\n  def convert_path_to_actions(path):\n    actions = []\n    for i in range(len(path) - 1):\n      dx = path[i + 1][0] - path[i][0]\n      dy = path[i + 1][1] - path[i][1]\n      \n      if dx == 1:\n          actions.append(3)  # RIGHT\n      elif dx == -1:\n          actions.append(2)  # LEFT\n      elif dy == 1:\n          actions.append(0)  # DOWN\n      elif dy == -1:\n          actions.append(1)  # UP\n      \n    return actions\n  \n  actions_to_workshop = convert_path_to_actions(path_to_workshop)\n  \n  # Action to use the workshop (USE action)\n  USE_ACTION = 4\n  \n  # Combine all actions\n  actions = actions_to_workshop + [USE_ACTION]\n  \n  return actions", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T09:33:31.708842", "function_name": "craft", "function_body": "  def find_nearest_workshop(current_pos, workshop_indices):\n    min_distance = float('inf')\n    nearest_workshop_index = None\n    for w in workshop_indices:\n      # Assuming the grid is represented with (x, y) coordinates\n      x_diff = abs(w[0] - current_pos[0])\n      y_diff = abs(w[1] - current_pos[1])\n      distance = x_diff + y_diff  # Manhattan distance\n      if distance < min_distance:\n        min_distance = distance\n        nearest_workshop_index = w\n    return nearest_workshop_index\n\n  def find_path(grid, start_pos, target_pos):\n    \"\"\"Finds a path from start_pos to target_pos using Breadth-First Search (BFS).\"\"\"\n    queue = collections.deque([start_pos])\n    visited = set()\n    parent = {start_pos: None}\n    \n    while queue:\n        pos = queue.popleft()\n        if pos == target_pos:\n            break\n        visited.add(pos)\n        \n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            new_pos = (pos[0] + dx, pos[1] + dy)\n            if (0 <= new_pos[0] < grid.shape[0] and \n                0 <= new_pos[1] < grid.shape[1] and \n                grid[new_pos] == 0 and \n                new_pos not in visited):\n                queue.append(new_pos)\n                parent[new_pos] = pos\n    \n    path = []\n    while target_pos:\n        path.append(target_pos)\n        target_pos = parent[target_pos]\n    \n    return path[::-1]\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the items/primitives required for crafting\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n  inventory = env._current_state.inventory\n  \n  # If any of the required primitives are not available, return an empty action list\n  if any(inventory[i] < count for i, count in primitives_required.items()):\n    return []\n  \n  # Find a workshop that can be used to craft the item\n  recipe = env.world.cookbook.recipes[item_index]\n  possible_workshops = [w for w in env.world.workshop_indices if recipe.get(f\"_{w}\") is not None]\n  \n  if not possible_workshops:\n    return []\n  \n  # Find the nearest workshop to the current position\n  current_pos = env._current_state.pos\n  nearest_workshop_index = find_nearest_workshop(current_pos, possible_workshops)\n  \n  if nearest_workshop_index is None:\n    return []\n  \n  # Actions to navigate to the nearest workshop\n  actions_to_workshop = find_path(env._current_state.grid, current_pos, nearest_workshop_index)\n  \n  if not actions_to_workshop:\n    return []\n  \n  # Convert positions in path to actions\n  directions = {'UP': 0, 'DOWN': 1, 'LEFT': 2, 'RIGHT': 3}\n  actions = []\n  for i in range(len(actions_to_workshop) - 1):\n      start_pos = actions_to_workshop[i]\n      end_pos = actions_to_workshop[i + 1]\n      dx = end_pos[0] - start_pos[0]\n      dy = end_pos[1] - start_pos[1]\n      \n      if dx == -1:\n          actions.append(directions['UP'])\n      elif dx == 1:\n          actions.append(directions['DOWN'])\n      elif dy == -1:\n          actions.append(directions['LEFT'])\n      elif dy == 1:\n          actions.append(directions['RIGHT'])\n  \n  # Action to use the workshop (USE action)\n  USE_ACTION = 4\n  \n  # Combine all actions\n  actions.append(USE_ACTION)\n  \n  return actions", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T09:37:45.971759", "function_name": "craft", "function_body": "  def find_all_positions_of_kind(grid: np.ndarray, kind_index: int):\n    positions = []\n    for y in range(grid.shape[0]):\n      for x in range(grid.shape[1]):\n        if grid[y, x, kind_index] > 0:\n          positions.append((x, y))\n    return positions\n\n  def distance(pos1: tuple, pos2: tuple) -> int:\n    \"\"\"Calculate the Manhattan distance between two positions.\"\"\"\n    return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n\n  def move_to_position(current_pos: tuple, target_pos: tuple) -> list[int]:\n    \"\"\"Generate a sequence of actions to move from current position to target position.\"\"\"\n    actions = []\n    current_x, current_y = current_pos\n    target_x, target_y = target_pos\n    \n    # Move vertically first\n    while current_y < target_y:\n        actions.append(0)  # DOWN\n        current_y += 1\n    while current_y > target_y:\n        actions.append(1)  # UP\n        current_y -= 1\n    \n    # Then move horizontally\n    while current_x < target_x:\n        actions.append(2)  # LEFT\n        current_x += 1\n    while current_x > target_x:\n        actions.append(3)  # RIGHT\n        current_x -= 1\n    \n    return actions\n\n  def collect_primitive(env, primitive: int) -> list[int]:\n    \"\"\"Generate a sequence of actions to collect the required primitive.\"\"\"\n    primitive_positions = find_all_positions_of_kind(env._current_state.grid, primitive)\n    \n    if not primitive_positions:\n      # If no primitives are found, try to move to the nearest known position\n      return []\n    \n    nearest_primitive_pos = min(primitive_positions, key=lambda pos: distance(env._current_state.pos, pos))\n    actions_to_collect = move_to_position(env._current_state.pos, nearest_primitive_pos)\n    actions_to_collect.append(4)  # USE action to collect the primitive\n    \n    return actions_to_collect\n\n  def find_workshop_index_for_item(item_index: int, cookbook):\n      \"\"\"Find the workshop index required for crafting an item.\"\"\"\n      recipe = cookbook.recipes[item_index]\n      workshop_key = recipe.get(\"_key\", None)\n      \n      if workshop_key is not None:\n          for key, value in cookbook.recipes.items():\n              if \"_key\" in value and value[\"_key\"] == workshop_key:\n                  return key\n      return None\n\n  actions = []\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the primitives required for crafting\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  missing_primitives = {primitive: count - env._current_state.inventory[primitive] \n                        for primitive, count in primitives_needed.items() \n                        if count > env._current_state.inventory[primitive]}\n  \n  # Collect all missing primitives\n  for primitive, count in missing_primitives.items():\n    while count > 0:\n      actions.extend(collect_primitive(env, primitive))\n      count -= 1\n  \n  # Find the workshop index needed to craft the item\n  workshop_index = find_workshop_index_for_item(item_index, env.world.cookbook)\n  \n  if workshop_index is not None:\n    workshop_positions = find_all_positions_of_kind(env._current_state.grid, workshop_index)\n    \n    if workshop_positions:\n      nearest_workshop_pos = min(workshop_positions, key=lambda pos: distance(env._current_state.pos, pos))\n      actions.extend(move_to_position(env._current_state.pos, nearest_workshop_pos))\n      \n      # Use the workshop to craft the item\n      actions.append(4)  # USE action\n  \n  return actions", "island_id": 1, "scores": {"3": 0.2}}
{"timestamp": "2025-09-06T09:37:47.045124", "function_name": "craft", "function_body": "  def find_all_positions_of_kind(grid: np.ndarray, kind_index: int):\n    positions = []\n    for y in range(grid.shape[0]):\n      for x in range(grid.shape[1]):\n        if grid[y, x, kind_index] > 0:\n          positions.append((x, y))\n    return positions\n\n  def distance(pos1: tuple, pos2: tuple) -> int:\n    \"\"\"Calculate the Manhattan distance between two positions.\"\"\"\n    return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n\n  def move_to_position(current_pos: tuple, target_pos: tuple) -> list[int]:\n    \"\"\"Generate a sequence of actions to move from current position to target position.\"\"\"\n    actions = []\n    current_x, current_y = current_pos\n    target_x, target_y = target_pos\n    \n    # Move vertically first\n    while current_y < target_y:\n        actions.append(0)  # DOWN\n        current_y += 1\n    while current_y > target_y:\n        actions.append(1)  # UP\n        current_y -= 1\n    \n    # Then move horizontally\n    while current_x < target_x:\n        actions.append(2)  # LEFT\n        current_x += 1\n    while current_x > target_x:\n        actions.append(3)  # RIGHT\n        current_x -= 1\n    \n    return actions\n\n  def collect_primitive(env, primitive: int) -> list[int]:\n    \"\"\"Generate a sequence of actions to collect the required primitive.\"\"\"\n    primitive_positions = find_all_positions_of_kind(env._current_state.grid, primitive)\n    \n    if not primitive_positions:\n      # If no primitives are found, try to move to the nearest known position\n      return []\n    \n    nearest_primitive_pos = min(primitive_positions, key=lambda pos: distance(env._current_state.pos, pos))\n    actions_to_collect = move_to_position(env._current_state.pos, nearest_primitive_pos)\n    actions_to_collect.append(4)  # USE action to collect the primitive\n    \n    return actions_to_collect\n\n  def find_workshop_index_for_item(item_index: int, cookbook):\n      \"\"\"Find the workshop index required for crafting an item.\"\"\"\n      recipe = cookbook.recipes[item_index]\n      workshop_key = recipe.get(\"_key\", None)\n      \n      if workshop_key is not None:\n          for key, value in cookbook.recipes.items():\n              if \"_key\" in value and value[\"_key\"] == workshop_key:\n                  return key\n      return None\n\n  def check_and_collect_primitives(env, primitives_needed):\n    actions = []\n    missing_primitives = {primitive: count - env._current_state.inventory[primitive] \n                          for primitive, count in primitives_needed.items() \n                          if count > env._current_state.inventory[primitive]}\n    \n    # Collect all missing primitives\n    for primitive, count in missing_primitives.items():\n      while count > 0:\n        actions.extend(collect_primitive(env, primitive))\n        count -= 1\n    \n    return actions\n\n  actions = []\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the primitives required for crafting\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  actions.extend(check_and_collect_primitives(env, primitives_needed))\n  \n  # Find the workshop index needed to craft the item\n  workshop_index = find_workshop_index_for_item(item_index, env.world.cookbook)\n\n  if workshop_index is not None:\n    workshop_positions = find_all_positions_of_kind(env._current_state.grid, workshop_index)\n    nearest_workshop_pos = min(workshop_positions, key=lambda pos: distance(env._current_state.pos, pos))\n    actions.extend(move_to_position(env._current_state.pos, nearest_workshop_pos))\n    \n    # Use the workshop to craft the item\n    actions.append(4)  # USE action\n  \n  return actions", "island_id": 1, "scores": {"3": 0.2}}
{"timestamp": "2025-09-06T09:40:01.311407", "function_name": "craft", "function_body": "  # Step 1: Resolve the name to index\n  cookbook = env.world.cookbook\n  item_index = cookbook.index.index(item)\n  \n  if item_index is None:\n    raise ValueError(f\"Item '{item}' not found in the cookbook.\")\n  \n  # Step 2: Get required primitives\n  primitives_needed = cookbook.primitives_for(item_index)\n\n  # Check if all needed primitives are available in inventory\n  for primitive, count in primitives_needed.items():\n    primitive_name = cookbook.index.get(primitive)\n    if env._current_state.inventory[primitive] < count:\n      print(f\"Missing {count} {primitive_name}(s) required to craft {item}.\")\n      return []\n  \n  # Step 3: Determine the workshop for crafting\n  recipe = cookbook.recipes[item_index]\n  workshop_index = None\n\n  if \"_key\" in recipe and \"workshop\" in recipe[\"_key\"]:\n    workshop_index = int(recipe[\"_key\"][\"workshop\"])\n  \n  if workshop_index is None:\n    print(f\"No specific workshop found for {item}. Defaulting to first available.\")\n    workshop_index = env.world.workshop_indices[0]\n  \n  # Step 4: Move the agent to the nearest workshop\n  actions_to_workshop = move_to_nearest(env, workshop_index)\n  if not actions_to_workshop:\n    print(\"Failed to find a path to any workshop.\")\n    return []\n  \n  # Step 5: Add USE action to perform crafting\n  actions_to_craft = actions_to_workshop + [craft.USE]\n  \n  return actions_to_craft", "island_id": 6, "scores": {"3": -1}}
