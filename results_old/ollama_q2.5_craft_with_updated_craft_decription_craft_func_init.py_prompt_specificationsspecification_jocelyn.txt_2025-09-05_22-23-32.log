{"timestamp": "2025-09-06T03:40:42.840122", "function_name": "craft", "function_body": "  # Get the index of the desired item from the cookbook\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item has a recipe in the cookbook\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes[item_index]\n  \n  # Collect all required primitives and ingredients\n  actions = []\n  current_state = env._current_state\n\n  # Check if we have all the items/ primitves required for crafting\n  inventory = current_state.inventory\n  \n  # Collect primitives\n  for i_primitive, count in recipe.items():\n    if i_primitive == \"_key\":\n      continue  # Skip the _key entry which is not a primitive\n    if inventory[i_primitive] < count:\n      # Calculate how many more of this item we need\n      needed = count - inventory[i_primitive]\n      # Determine the type of primitive and collect it\n      primitive_name = env.world.cookbook.index.get(i_primitive, \"UNKNOWN\")\n      \n      actions.extend(collect(env, primitive_name))\n  \n  # Move to a workshop for crafting if necessary\n  # For now, assume there is a single workshop that can craft any item\n  # This needs to be improved to check the specific recipe and move to the correct workshop\n  \n  # Example: Assume we always move to workshop0 for crafting\n  workshop_index = env.world.workshop_indices[0]\n  \n  # Find the position of the workshop in the grid\n  workshop_pos = np.argwhere(current_state.grid[:, :, workshop_index]).tolist()\n  \n  if not workshop_pos:\n    return []  # No workshop found in the grid\n  \n  # Move to the closest workshop (for simplicity, take the first one)\n  target_pos = workshop_pos[0]\n  actions.extend(move_to(env, target_pos))\n  \n  # Use the workshop to craft the item\n  actions.append(craft.CraftLab.USE)\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-06T03:40:43.841106", "function_name": "craft", "function_body": "  # Convert item name to index using the cookbook\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item has a recipe\n  if item_index not in env.world.cookbook.recipes:\n    print(f\"No recipe found for {item}.\")\n    return []\n\n  # Get the primitives required for crafting the item\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n\n  actions = []\n  \n  # Collect all the required primitives if they are not already in inventory\n  for primitive, count in primitives_required.items():\n    while env._current_state.inventory[primitive] < count:\n      collect_actions = collect(env, env.world.cookbook.index.get(primitive))\n      actions.extend(collect_actions)\n  \n  # Find a workshop to perform the crafting\n  workshops = [i for i in env.world.workshop_indices if env._current_state.next_to(i)]\n  \n  if not workshops:\n    print(\"No available workshops.\")\n    return []\n  \n  # Move to the nearest workshop\n  workshop = workshops[0]\n  move_actions = move_to_workshop(env, workshop)\n  actions.extend(move_actions)\n  \n  # Craft the item by using the USE action at the workshop\n  actions.append(4)  # USE action\n  \n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-06T03:42:39.987639", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index of the item from the cookbook\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have a recipe for this item\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the primitives required to craft this item\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n\n  # Check if all required primitives are available in inventory\n  all_primitives_available = True\n  for primitive, count in primitives_required.items():\n      if env._current_state.inventory[primitive] < count:\n          all_primitives_available = False\n          break\n\n  if not all_primitives_available:\n    return []\n\n  # Determine which workshop to use based on the recipe\n  workshops_available = env.world.workshop_indices\n  \n  # Move towards a nearby workshop (this is simplified and assumes we can move directly)\n  selected_workshop_index = None\n  for workshop in workshops_available:\n      if env._current_state.next_to(workshop):\n          selected_workshop_index = workshop\n          break\n\n  if selected_workshop_index is None:\n    return []\n\n  # Calculate the direction to move towards the selected workshop\n  current_pos = np.array(env._current_state.pos)\n  target_pos = np.where(env._current_state.grid[:, :, selected_workshop_index] == 1)[0:2]\n  \n  if not target_pos[0].size or not target_pos[1].size:\n    return []\n\n  # Calculate the direction\n  target_pos = (target_pos[0][0], target_pos[1][0])\n  delta = target_pos - current_pos\n  \n  direction_mapping = {\n      np.array([0, 1]): 3,  # RIGHT\n      np.array([0, -1]): 2, # LEFT\n      np.array([1, 0]): 0,  # DOWN\n      np.array([-1, 0]): 1   # UP\n  }\n  \n  direction = direction_mapping.get(delta)\n  if direction is None:\n    return []\n\n  actions.append(direction)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE action\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-06T03:42:40.983572", "function_name": "craft", "function_body": "  actions = []\n\n  # Get the index of the item from the cookbook\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have a recipe for this item\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the primitives required to craft this item\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n\n  # Collect missing primitives\n  for primitive, count in primitives_required.items():\n      while env._current_state.inventory[primitive] < count:\n          actions.extend(collect(env, env.world.cookbook.index.get(primitive)))\n\n  # Determine which workshop to use based on the recipe\n  workshops_available = env.world.workshop_indices\n  selected_workshop = None\n  \n  for workshop in workshops_available:\n      if workshop in env._current_state.grid[env._current_state.pos[0], env._current_state.pos[1]]:\n          selected_workshop = workshop\n          break\n\n  # Move to the workshop (assuming we are adjacent)\n  actions.append(env.world.cookbook.index.get(selected_workshop))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE action\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-06T03:45:58.416142", "function_name": "craft", "function_body": "  def has_primitives(primitives):\n    for primitive, count in primitives.items():\n      if env._current_state.inventory[primitive] < count:\n        return False\n    return True\n\n  def move_to_position(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    # Calculate the direction to move (UP/DOWN and LEFT/RIGHT)\n    row_diff = target_pos[0] - current_pos[0]\n    col_diff = target_pos[1] - current_pos[1]\n    \n    # Move vertically first (UP or DOWN)\n    if row_diff > 0:\n        actions.extend([1] * row_diff)  # DOWN\n    else:\n        actions.extend([0] * abs(row_diff))  # UP\n    \n    # Move horizontally next (LEFT or RIGHT)\n    if col_diff > 0:\n        actions.extend([3] * col_diff)  # RIGHT\n    else:\n        actions.extend([2] * abs(col_diff))  # LEFT\n    \n    return actions\n\n  def get_random_workshop_position(env, workshop_index):\n    grid = env._current_state.grid\n    positions_next_to_workshop = np.argwhere(grid[:, :, workshop_index] > 0)\n    if len(positions_next_to_workshop) == 0:\n      return None\n    target_pos = tuple(positions_next_to_workshop[env.random.randint(len(positions_next_to_workshop))])\n    return target_pos\n\n  def get_all_workshop_positions(env, workshop_index):\n    grid = env._current_state.grid\n    positions_next_to_workshop = np.argwhere(grid[:, :, workshop_index] > 0)\n    if len(positions_next_to_workshop) == 0:\n      return []\n    return [tuple(pos) for pos in positions_next_to_workshop]\n\n  def get_closest_position(env, target_positions):\n    current_pos = np.array(env._current_state.pos)\n    distances = np.linalg.norm(current_pos - np.array(target_positions), axis=1)\n    closest_index = np.argmin(distances)\n    return target_positions[closest_index]\n\n  # Get the index of the item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the primitives needed to craft the item\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  if not has_primitives(required_primitives):\n    return []\n  \n  # Get workshop index from recipe (assuming there is only one workshop specified in the recipe)\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_index = next(i for i, count in recipe.items() if i != \"_key\")\n  \n  # Find all positions next to the workshop\n  target_positions = get_all_workshop_positions(env, workshop_index)\n  if not target_positions:\n    return []\n  \n  # Get the closest position among the available positions\n  target_pos = get_closest_position(env, target_positions)\n  \n  # Move to the chosen position\n  actions_to_target = move_to_position(env, target_pos)\n  if not actions_to_target:\n    return []\n  \n  # Add USE action to craft the item\n  use_action = env.world.n_actions - 1  # Assuming USE is the last action\n  \n  # Combine all actions\n  actions = actions_to_target + [use_action]\n  \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T03:45:59.505337", "function_name": "craft", "function_body": "  def has_primitives(primitives):\n    for primitive, count in primitives.items():\n      if env._current_state.inventory[primitive] < count:\n        return False\n    return True\n\n  def move_to_position(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    # Calculate the direction to move\n    direction_row = np.sign(target_pos[0] - current_pos[0])\n    direction_col = np.sign(target_pos[1] - current_pos[1])\n\n    while current_pos != target_pos:\n      if direction_row != 0:\n        action = 1 if direction_row > 0 else 0\n        actions.append(action)\n        current_pos = (current_pos[0] + direction_row, current_pos[1])\n      elif direction_col != 0:\n        action = 3 if direction_col > 0 else 2\n        actions.append(action)\n        current_pos = (current_pos[0], current_pos[1] + direction_col)\n\n    return actions\n\n  def get_random_workshop_position(env, workshop_index):\n    grid = env._current_state.grid\n    positions_next_to_workshop = np.argwhere(grid[:, :, workshop_index] > 0)\n    if len(positions_next_to_workshop) == 0:\n      return None\n    target_pos = tuple(positions_next_to_workshop[env.random.randint(len(positions_next_to_workshop))])\n    return target_pos\n\n  # Get the index of the item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the primitives needed to craft the item\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  if not has_primitives(required_primitives):\n    return []\n  \n  # Get workshop index from recipe (assuming there is only one workshop specified in the recipe)\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_indices = [i for i, count in recipe.items() if i != \"_key\"]\n  \n  actions = []\n  for workshop_index in workshop_indices:\n    # Find a position next to the workshop\n    target_pos = get_random_workshop_position(env, workshop_index)\n    if not target_pos:\n      return []\n    \n    # Move to the chosen position\n    actions_to_target = move_to_position(env, target_pos)\n    if not actions_to_target:\n      return []\n    \n    # Add USE action to craft the item\n    use_action = env.world.n_actions - 1  # Assuming USE is the last action\n    \n    # Combine all actions\n    actions.extend(actions_to_target + [use_action])\n  \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T03:47:04.342367", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n\n  # Step 2: Check if we have all the required ingredients for crafting\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n\n  actions = []\n  inventory = env._current_state.inventory\n\n  # Check if we already have enough of all required primitives\n  can_craft = True\n  for primitive, count in primitives_needed.items():\n      if inventory[primitive] < count:\n          can_craft = False\n          break\n\n  # If we do not have the ingredients, return an empty list or handle collecting them.\n  if not can_craft:\n      return []\n\n  # Step 3: Proceed to craft the item by going to the workshop and performing the USE action.\n  for workshop_index in env.world.workshop_indices:\n      if inventory[workshop_index] > 0:\n          actions.append(env.action_specs()[\"USE\"])\n          break\n\n  # If no workshop is available, return an empty list\n  else:\n      return []\n\n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T03:47:05.438627", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n  \n  # Step 1: Check if we have all the required ingredients for crafting\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  \n  actions = []\n  inventory = env._current_state.inventory\n\n  # Check if we already have enough of all required primitives\n  can_craft = True\n  missing_primitives = {}\n  for primitive, count in primitives_needed.items():\n      if inventory[primitive] < count:\n          can_craft = False\n          missing_primitives[primitive] = count - inventory[primitive]\n  \n  # If we do not have the ingredients, return an empty list or handle collecting them.\n  if not can_craft:\n      return []\n  \n  # Step 3: Proceed to craft the item by going to the workshop and performing the USE action.\n  for workshop_index in env.world.workshop_indices:\n      if inventory[workshop_index] > 0:\n          actions.append(env.action_specs()[\"USE\"])\n          break\n  \n  # If no workshop is available, return an empty list\n  else:\n      return []\n  \n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T03:48:59.912408", "function_name": "craft", "function_body": "  # Convert the item name to its index using the cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the primitives required for crafting the item\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  \n  actions = []\n  \n  # Check if all the primitives are available in the inventory\n  for primitive_index, count in primitives_needed.items():\n    while env._current_state.inventory[primitive_index] < count:\n      # Find the position of the primitive in the grid\n      pos = np.argwhere(env._current_state.grid[:, :, primitive_index])\n      \n      if len(pos) == 0:\n        return []  # Cannot find the required primitive\n      \n      # Move to the closest primitive\n      target_pos = tuple(pos[0][:2])  # Get the first occurrence of the primitive\n      actions.extend(move_to(env, target_pos))\n      \n      # Collect the primitive\n      actions.append(craft.CRAFT_USE)\n      \n      # Update the inventory (this is a simulation and we assume that the inventory is updated after collecting the primitive)\n      env._current_state.inventory[primitive_index] += 1\n  \n  # Go to the workshop to craft the item\n  workshop_indices = [index for index in env.world.workshop_indices if index in primitives_needed]\n  \n  if len(workshop_indices) == 0:\n    return []  # No suitable workshop found\n  \n  workshop_pos = find_workshop_position(env, workshop_indices[0])\n  \n  actions.extend(move_to(env, workshop_pos))\n  \n  # Craft the item\n  actions.append(craft.CRAFT_USE)\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-06T03:49:00.891112", "function_name": "craft", "function_body": "  actions = []\n  \n  # Convert the item name to its corresponding index using the cookbook's index\n  item_index = env.world.cookbook.index[item]\n  if item_index is None:\n    return []  # If the item doesn't exist in the cookbook, return an empty list\n\n  # Check if we have all the primitives required for crafting the item\n  primitive_requirements = env.world.cookbook.primitives_for(item_index)\n  current_inventory = env._current_state.inventory\n  \n  # Check if the current inventory has all the required primitives\n  all_primitives_available = True\n  for prim_index, count in primitive_requirements.items():\n    if current_inventory[prim_index] < count:\n      all_primitives_available = False\n      break\n\n  if not all_primitives_available:\n    return []  # If any primitive is missing, return an empty list\n\n  # Find the workshop index from the recipe\n  recipes = env.world.cookbook.recipes[item_index]\n  workshop_index = None\n  for ingredient, count in recipes.items():\n    if ingredient.startswith(\"workshop\"):\n      workshop_index = int(ingredient.split(\"_\")[-1])\n      break\n\n  if workshop_index is None:\n    return []  # If no workshop is specified in the recipe, return an empty list\n\n  # Convert workshop index to its corresponding name using the cookbook's index\n  workshop_name = env.world.cookbook.index.get(workshop_index)\n  if workshop_name is None:\n    return []  # If the workshop doesn't exist in the cookbook, return an empty list\n\n  # Find the position of the workshop on the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    return []  # If no workshop is found on the grid, return an empty list\n\n  # Choose the closest workshop (for simplicity)\n  agent_pos = env._current_state.pos\n  closest_workshop = min(workshop_positions, key=lambda pos: np.linalg.norm(np.array(pos) - np.array(agent_pos)))\n\n  # Calculate the path to the closest workshop and move there\n  path_to_workshop = calculate_path(env._current_state.grid, agent_pos, tuple(closest_workshop))\n  actions.extend(path_to_workshop)\n\n  # Add the USE action to craft the item at the workshop\n  actions.append(craft.USE)\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-06T03:50:13.350794", "function_name": "craft", "function_body": "  actions = []\n\n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index)\n\n  if not recipe:\n    return []  # No recipe found for the item\n\n  # Check and collect all primitives required by the recipe\n  primitives_required = []\n  for ingredient, count in recipe.items():\n      if ingredient == \"_key\":\n          continue\n      ingredient_index = env.world.cookbook.index.get(ingredient)\n      if ingredient_index is None:\n          return []  # Ingredient not found in cookbook\n      while env._current_state.inventory[ingredient_index] < count:\n          primitives_required.append((ingredient, count))\n\n  for primitive_name, required_count in primitives_required:\n      primitive_index = env.world.cookbook.index.get(primitive_name)\n      if primitive_index is None:\n          return []  # Primitive not found in cookbook\n      while env._current_state.inventory[primitive_index] < required_count:\n          # Collect the primitive\n          actions.extend(collect(env, primitive_name))\n\n  # Go to the workshop and perform USE action to craft the item\n  workshop_index = recipe.get(\"_key\")\n  if workshop_index is not None:\n      workshop_position = find_workshop_position(env, workshop_index)\n      actions.extend(move_to_position(env, workshop_position))\n      actions.append(env.world.N_ACTIONS)  # USE action\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-06T03:50:14.348885", "function_name": "craft", "function_body": "  # Convert item name to index\n  item_index = env.world.cookbook.index[item]\n\n  # Get the recipe for the item\n  if item_index not in env.world.cookbook.recipes:\n    return []  # No recipe found, return empty action list\n\n  recipe = env.world.cookbook.recipes[item_index]\n\n  actions = []\n  \n  # Check if we have all primitives required for crafting\n  primitives_needed = {ingredient: count for ingredient, count in recipe.items() if ingredient != \"_key\"}\n  \n  for primitive_name, count in primitives_needed.items():\n    primitive_index = env.world.cookbook.index[primitive_name]\n    while env._current_state.inventory[primitive_index] < count:\n      # If we don't have enough of this primitive, collect it\n      actions.extend(collect_v2(env, primitive_name))\n    \n  # Check if the agent is at a workshop where they can craft the item\n  current_pos = env._current_state.pos\n  \n  # Find the nearest workshop that has the required recipe key\n  workshop_index = recipe.get(\"_key\", None)\n  if workshop_index is not None:\n    nearest_workshop = find_nearest_workshop(env, workshop_index)\n    if nearest_workshop is not None:\n      actions.extend(move_to_position_v2(env._current_state.pos, nearest_workshop))\n      # Use the USE action to craft the item\n      actions.append(craft.CRAFT_FUNC(item_index))\n  else:\n    return []  # No valid workshop found\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-06T03:53:28.930235", "function_name": "craft", "function_body": "  def get_item_index(item_name):\n    return env.world.cookbook.index[item_name]\n\n  def find_workshop_for_goal(goal_index):\n    # Find a workshop with the required recipe\n    for workshop_index in env.world.workshop_indices:\n      if goal_index in env.world.cookbook.recipes.get(workshop_index, {}):\n        return workshop_index\n    return None\n\n  # Get the goal index for the desired item\n  goal_index = get_item_index(item)\n\n  # Check if we have all the primitives required for crafting\n  primitives_required = env.world.cookbook.primitives_for(goal_index)\n  inventory = env._current_state.inventory\n\n  # Check if the agent has all the required primitives in their inventory\n  for primitive, count in primitives_required.items():\n    if inventory[primitive] < count:\n      return []  # Not enough primitives to craft the item\n\n  # Find a workshop with the required recipe\n  workshop_index = find_workshop_for_goal(goal_index)\n  if workshop_index is None:\n    return []  # No valid workshop found\n\n  # Get the coordinates of the workshops in the grid\n  workshop_coords = np.argwhere(env._current_state.grid[:, :, workshop_index])\n  if not workshop_coords.size:\n    return []  # Workshop not found in the grid\n\n  # Find the nearest workshop to the agent's current position\n  current_pos = env._current_state.pos\n  nearest_workshop_idx = find_nearest_target(current_pos, workshop_coords)\n  target_pos = tuple(workshop_coords[nearest_workshop_idx])\n\n  # Calculate the actions needed to move to the target position\n  actions_to_target = calculate_actions_to_move(env, current_pos, target_pos)\n\n  if not actions_to_target:\n    return []  # Could not find a path to the workshop\n\n  # Append the USE action to craft the item at the workshop\n  actions_to_target.append(4)  # USE action index is 4\n\n  return actions_to_target", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T03:53:30.010266", "function_name": "craft", "function_body": "  def get_item_index(item_name):\n    return env.world.cookbook.index[item_name]\n\n  def find_workshop_for_goal(goal_index):\n    # Find a workshop with the required recipe\n    for workshop_index in env.world.workshop_indices:\n      if goal_index in env.world.cookbook.recipes.get(workshop_index, {}):\n        return workshop_index\n    return None\n\n  def find_nearest_target(current_pos, target_coords):\n    min_distance = float('inf')\n    nearest_target_idx = -1\n    for i, coord in enumerate(target_coords):\n      distance = np.linalg.norm(np.array(coord) - np.array(current_pos))\n      if distance < min_distance:\n        min_distance = distance\n        nearest_target_idx = i\n    return nearest_target_idx\n\n  def calculate_actions_to_move(env, current_pos, target_pos):\n    # Use a simple pathfinding algorithm to calculate the actions needed to move to the target position\n    path = astar_search(env._current_state.grid, current_pos, target_pos)\n    if not path:\n      return []\n    \n    actions = []\n    for i in range(1, len(path)):\n      next_pos = path[i]\n      delta_x = next_pos[0] - current_pos[0]\n      delta_y = next_pos[1] - current_pos[1]\n\n      if delta_x > 0:\n        actions.append(3)  # RIGHT\n      elif delta_x < 0:\n        actions.append(2)  # LEFT\n      elif delta_y > 0:\n        actions.append(1)  # UP\n      elif delta_y < 0:\n        actions.append(0)  # DOWN\n\n      current_pos = next_pos\n    \n    return actions\n\n  def astar_search(grid, start, goal):\n    open_set = collections.PriorityQueue()\n    open_set.put((0, start))\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, goal)}\n\n    while not open_set.empty():\n      _, current = open_set.get()\n\n      if current == goal:\n        return reconstruct_path(came_from, current)\n\n      for neighbor in get_neighbors(grid, current):\n        tentative_g_score = g_score[current] + 1\n\n        if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n          came_from[neighbor] = current\n          g_score[neighbor] = tentative_g_score\n          f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n          open_set.put((f_score[neighbor], neighbor))\n\n    return []\n\n  def get_neighbors(grid, pos):\n    x, y = pos\n    neighbors = []\n    if x > 0 and grid[x-1, y].sum() == 0:  # Check if cell is empty\n      neighbors.append((x-1, y))\n    if x < grid.shape[0] - 1 and grid[x+1, y].sum() == 0:\n      neighbors.append((x+1, y))\n    if y > 0 and grid[x, y-1].sum() == 0:\n      neighbors.append((x, y-1))\n    if y < grid.shape[1] - 1 and grid[x, y+1].sum() == 0:\n      neighbors.append((x, y+1))\n    return neighbors\n\n  def heuristic(a, b):\n    return np.linalg.norm(np.array(a) - np.array(b), ord=1)\n\n  def reconstruct_path(came_from, current):\n    total_path = [current]\n    while current in came_from:\n        current = came_from[current]\n        total_path.append(current)\n    return total_path[::-1]\n\n  # Get the goal index for the desired item\n  goal_index = get_item_index(item)\n\n  # Check if we have all the primitives required for crafting\n  primitives_required = env.world.cookbook.primitives_for(goal_index)\n  inventory = env._current_state.inventory\n\n  # Check if the agent has all the required primitives in their inventory\n  for primitive, count in primitives_required.items():\n    if inventory[primitive] < count:\n      return []  # Not enough primitives to craft the item\n\n  # Find a workshop with the required recipe\n  workshop_index = find_workshop_for_goal(goal_index)\n  if workshop_index is None:\n    return []  # No valid workshop found\n\n  # Get the coordinates of the workshops in the grid\n  workshop_coords = np.argwhere(env._current_state.grid[:, :, workshop_index])\n  if not workshop_coords.size:\n    return []  # Workshop not found in the grid\n\n  # Find the nearest workshop to the agent's current position\n  current_pos = env._current_state.pos\n  nearest_workshop_idx = find_nearest_target(current_pos, workshop_coords)\n  target_pos = tuple(workshop_coords[nearest_workshop_idx])\n\n  # Calculate the actions needed to move to the target position\n  actions_to_target = calculate_actions_to_move(env, current_pos, target_pos)\n\n  if not actions_to_target:\n    return []  # Could not find a path to the workshop\n\n  # Append the USE action to craft the item at the workshop\n  actions_to_target.append(4)  # USE action index is 4\n\n  return actions_to_target", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T03:55:44.623930", "function_name": "craft", "function_body": "  def has_primitives(primitives):\n    for primitive, count in primitives.items():\n      if env._current_state.inventory[primitive] < count:\n        return False\n    return True\n\n  def move_to_position(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    # Calculate the direction to move\n    direction_row = np.sign(target_pos[0] - current_pos[0])\n    direction_col = np.sign(target_pos[1] - current_pos[1])\n\n    while current_pos != target_pos:\n      if direction_row != 0:\n        action = 1 if direction_row > 0 else 0\n        actions.append(action)\n        current_pos = (current_pos[0] + direction_row, current_pos[1])\n      elif direction_col != 0:\n        action = 3 if direction_col > 0 else 2\n        actions.append(action)\n        current_pos = (current_pos[0], current_pos[1] + direction_col)\n\n    return actions\n\n  def get_random_workshop_position(env, workshop_index):\n    grid = env._current_state.grid\n    positions_next_to_workshop = np.argwhere(grid[:, :, workshop_index] > 0)\n    if len(positions_next_to_workshop) == 0:\n      return None\n    target_pos = tuple(positions_next_to_workshop[env.random.randint(len(positions_next_to_workshop))])\n    return target_pos\n\n  def get_required_primitives(item_index):\n    required_primitives = env.world.cookbook.primitives_for(item_index)\n    return required_primitives\n\n  # Get the index of the item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the primitives needed to craft the item\n  required_primitives = get_required_primitives(item_index)\n  if not has_primitives(required_primitives):\n    return []\n  \n  # Find all workshop indices from the recipe (assuming multiple workshops could be involved in crafting)\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_indices = [i for i, count in recipe.items() if i != \"_key\"]\n  \n  actions = []\n  for workshop_index in workshop_indices:\n    # Find a position next to the workshop\n    target_pos = get_random_workshop_position(env, workshop_index)\n    if not target_pos:\n      return []\n    \n    # Move to the chosen position\n    actions_to_target = move_to_position(env, target_pos)\n    if not actions_to_target:\n      return []\n    \n    # Add USE action to craft the item\n    use_action = env.world.n_actions - 1  # Assuming USE is the last action\n    \n    # Combine all actions\n    actions.extend(actions_to_target + [use_action])\n  \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T03:55:45.751343", "function_name": "craft", "function_body": "  def has_primitives(primitives):\n    for primitive, count in primitives.items():\n      if env._current_state.inventory[primitive] < count:\n        return False\n    return True\n\n  def move_to_position(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    # Calculate the direction to move\n    direction_row = np.sign(target_pos[0] - current_pos[0])\n    direction_col = np.sign(target_pos[1] - current_pos[1])\n\n    while current_pos != target_pos:\n      if direction_row != 0:\n        action = 1 if direction_row > 0 else 0\n        actions.append(action)\n        current_pos = (current_pos[0] + direction_row, current_pos[1])\n      elif direction_col != 0:\n        action = 3 if direction_col > 0 else 2\n        actions.append(action)\n        current_pos = (current_pos[0], current_pos[1] + direction_col)\n\n    return actions\n\n  def get_random_workshop_position(env, workshop_index):\n    grid = env._current_state.grid\n    positions_next_to_workshop = np.argwhere(grid[:, :, workshop_index] > 0)\n    if len(positions_next_to_workshop) == 0:\n      return None\n    target_pos = tuple(positions_next_to_workshop[env.random.randint(len(positions_next_to_workshop))])\n    return target_pos\n\n  # Get the index of the item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the primitives needed to craft the item\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  if not has_primitives(required_primitives):\n    return []\n  \n  # Get workshop indices from recipe (assuming multiple workshops might be specified in the recipe)\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_indices = [i for i, count in recipe.items() if i != \"_key\"]\n  \n  actions = []\n  for workshop_index in workshop_indices:\n    # Find a position next to the workshop\n    target_pos = get_random_workshop_position(env, workshop_index)\n    if not target_pos:\n      return []\n    \n    # Move to the chosen position\n    actions_to_target = move_to_position(env, target_pos)\n    if not actions_to_target:\n      return []\n    \n    # Add USE action to craft the item\n    use_action = env.world.n_actions - 1  # Assuming USE is the last action\n    \n    # Combine all actions\n    actions.extend(actions_to_target + [use_action])\n  \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T03:56:42.864327", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the goal item\n  item_index = cookbook.index[item]\n  \n  if item_index not in cookbook.recipes:\n    raise ValueError(f\"No recipe available for crafting {item}.\")\n\n  # Get all primitives required to craft the goal item\n  primitives_needed = cookbook.primitives_for(item_index)\n\n  actions = []\n\n  # Collect all primitives needed for crafting\n  for primitive, count in primitives_needed.items():\n      # Move to a location with the primitive and collect it\n      if primitive not in world.grabbable_indices:\n          continue\n\n      while env._current_state.inventory[primitive] < count:\n          actions.extend(collect(env, primitive))\n\n  # Craft the item at the workshop\n  for recipe_input, count in cookbook.recipes[item_index].items():\n      if recipe_input == \"_key\":\n          continue  # Skip the key ingredient placeholder\n\n      workshop = world.workshop_indices[0]\n      while env._current_state.inventory[recipe_input] < count:\n          actions.extend(move_to_workshop(env, workshop))\n          actions.append(4)  # USE action to craft\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-06T03:56:44.003479", "function_name": "craft", "function_body": "  actions = []\n  \n  # Convert the item name to its corresponding index\n  item_index = env.world.cookbook.index[item]\n  \n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Check if we have all required primitives\n  for ingredient, count in recipe.items():\n    if ingredient == \"_key\":\n      continue\n    \n    if ingredient not in env.world.cookbook.primitives:\n      return []\n    \n    ingredient_index = int(ingredient)\n    if env._current_state.inventory[ingredient_index] < count:\n      return []\n\n  # Find the workshop index for crafting\n  workshop_indices = env.world.workshop_indices\n\n  for workshop_index in workshop_indices:\n    actions.append(craft.MOVE_FUNC(workshop_index))\n    actions.append(craft.USE)\n\n  return actions", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T03:59:16.401221", "function_name": "craft", "function_body": "  def find_workshop(recipe):\n      if \"_key\" in recipe:\n          workshop_key = recipe[\"_key\"]\n          for key, value in env.world.cookbook.recipes.items():\n              if \"_key\" in value and value[\"_key\"] == workshop_key:\n                  return list(value.keys())[0] if isinstance(list(value.keys())[0], int) else None\n      return None\n\n  def move_to_position(current_pos, target_pos):\n      directions = [(0, -1), (0, 1), (-1, 0), (1, 0)]  # LEFT, RIGHT, UP, DOWN (adjusted for the direction map)\n      queue = collections.deque([(current_pos, [])])\n      visited = set([current_pos])\n\n      while queue:\n          pos, path = queue.popleft()\n          if pos == target_pos:\n              return [craft.N_ACTIONS[directions.index(d)] for d in path]\n          \n          for d in directions:\n              new_pos = (pos[0] + d[1], pos[1] + d[0])  # Adjusted indexing for the direction map\n              if 0 <= new_pos[0] < env._current_state.grid.shape[0] and 0 <= new_pos[1] < env._current_state.grid.shape[1] and new_pos not in visited:\n                  visited.add(new_pos)\n                  queue.append((new_pos, path + [directions.index(d)]))\n      \n      return []\n\n  def find_position_of_kind(grid, kind_index):\n      for y in range(grid.shape[0]):\n          for x in range(grid.shape[1]):\n              if grid[y, x] == kind_index:\n                  return (x, y)\n      return None\n\n  actions = []\n  \n  # Get the index of the item from the cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the primitives required for crafting\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  missing_primitives = {primitive: count - env._current_state.inventory[primitive] \n                        for primitive, count in primitives_needed.items() \n                        if count > env._current_state.inventory[primitive]}\n  \n  # If there are any missing primitives, return an empty action list\n  if missing_primitives:\n      return []\n  \n  # Find the workshop index needed to craft the item\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_index = find_workshop(recipe)\n  \n  # If no valid workshops are found, return an empty action list\n  if workshop_index is None:\n      return []\n  \n  # Move to the workshop\n  workshop_pos = find_position_of_kind(env._current_state.grid, workshop_index)\n  if workshop_pos is not None:\n      actions.extend(move_to_position(env._current_state.pos, workshop_pos))\n      \n      # Use the workshop to craft the item\n      actions.append(4)  # USE action\n  \n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T03:59:17.526411", "function_name": "craft", "function_body": "  def find_workshop(recipe):\n    if \"_key\" in recipe:\n      workshop_key = recipe[\"_key\"]\n      for key, value in env.world.cookbook.recipes.items():\n        if \"_key\" in value and value[\"_key\"] == workshop_key:\n          return list(value.keys())[0] if isinstance(list(value.keys())[0], int) else None\n    return None\n\n  def move_to_position(current_pos, target_pos):\n    directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n    queue = collections.deque([(current_pos, [])])\n    visited = set([current_pos])\n    \n    while queue:\n      pos, path = queue.popleft()\n      if pos == target_pos:\n        return [craft.N_ACTIONS[i] for i in path]\n      \n      for d in directions:\n        new_pos = (pos[0] + d[0], pos[1] + d[1])\n        if 0 <= new_pos[0] < env._current_state.grid.shape[0] and 0 <= new_pos[1] < env._current_state.grid.shape[1] and new_pos not in visited:\n          visited.add(new_pos)\n          queue.append((new_pos, path + [directions.index(d)]))\n    \n    return []\n\n  def find_position_of_kind(grid, kind):\n    pos = np.argwhere(grid[..., kind] == 1)\n    if len(pos) > 0:\n      return tuple(pos[0])\n    return None\n\n  actions = []\n  \n  # Get the index of the item from the cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the primitives required for crafting\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  missing_primitives = {primitive: count - env._current_state.inventory[primitive] \n                        for primitive, count in primitives_needed.items() \n                        if count > env._current_state.inventory[primitive]}\n  \n  # If there are any missing primitives, return an empty action list\n  if missing_primitives:\n    return []\n  \n  # Find the workshop index needed to craft the item\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_index = find_workshop(recipe)\n  \n  # If no valid workshops are found, return an empty action list\n  if workshop_index is None:\n    return []\n  \n  # Move to the workshop\n  workshop_pos = find_position_of_kind(env._current_state.grid, workshop_index)\n  if workshop_pos is not None:\n    actions.extend(move_to_position(env._current_state.pos, workshop_pos))\n    \n    # Use the workshop to craft the item\n    actions.append(4)  # USE action\n  \n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T04:02:40.974892", "function_name": "craft", "function_body": "  def get_item_index(item_name):\n    return env.world.cookbook.index[item_name]\n\n  def find_workshop_for_goal(goal_index):\n    for workshop_index in env.world.workshop_indices:\n      if goal_index in env.world.cookbook.recipes.get(workshop_index, {}):\n        return workshop_index\n    return None\n\n  def find_nearest_target(current_pos, target_coords):\n    min_distance = float('inf')\n    nearest_target_idx = -1\n    for i, coord in enumerate(target_coords):\n      distance = np.linalg.norm(np.array(coord) - np.array(current_pos))\n      if distance < min_distance:\n        min_distance = distance\n        nearest_target_idx = i\n    return nearest_target_idx\n\n  def calculate_actions_to_move(env, current_pos, target_pos):\n    path = astar_search(env._current_state.grid, current_pos, target_pos)\n    if not path:\n      return []\n    \n    actions = []\n    for i in range(1, len(path)):\n      next_pos = path[i]\n      delta_x = next_pos[0] - current_pos[0]\n      delta_y = next_pos[1] - current_pos[1]\n\n      if delta_x > 0:\n        actions.append(3)  # RIGHT\n      elif delta_x < 0:\n        actions.append(2)  # LEFT\n      elif delta_y > 0:\n        actions.append(1)  # UP\n      elif delta_y < 0:\n        actions.append(0)  # DOWN\n\n      current_pos = next_pos\n    \n    return actions\n\n  def astar_search(grid, start, goal):\n    open_set = collections.PriorityQueue()\n    open_set.put((0, start))\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, goal)}\n\n    while not open_set.empty():\n      _, current = open_set.get()\n\n      if current == goal:\n        return reconstruct_path(came_from, current)\n\n      for neighbor in get_neighbors(grid, current):\n        tentative_g_score = g_score[current] + 1\n\n        if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n          came_from[neighbor] = current\n          g_score[neighbor] = tentative_g_score\n          f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n          open_set.put((f_score[neighbor], neighbor))\n\n    return []\n\n  def get_neighbors(grid, pos):\n    x, y = pos\n    neighbors = []\n    directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n    for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and grid[nx, ny].sum() == 0:\n            neighbors.append((nx, ny))\n    return neighbors\n\n  def heuristic(a, b):\n    return np.linalg.norm(np.array(a) - np.array(b), ord=1)\n\n  def reconstruct_path(came_from, current):\n    total_path = [current]\n    while current in came_from:\n        current = came_from[current]\n        total_path.append(current)\n    return total_path[::-1]\n\n  # Get the goal index for the desired item\n  goal_index = get_item_index(item)\n\n  # Check if we have all the primitives required for crafting\n  primitives_required = env.world.cookbook.primitives_for(goal_index)\n  inventory = env._current_state.inventory\n\n  # Check if the agent has all the required primitives in their inventory\n  for primitive, count in primitives_required.items():\n    if inventory[primitive] < count:\n      return []  # Not enough primitives to craft the item\n\n  # Find a workshop with the required recipe\n  workshop_index = find_workshop_for_goal(goal_index)\n  if workshop_index is None:\n    return []  # No valid workshop found\n\n  # Get the coordinates of the workshops in the grid\n  workshop_coords = np.argwhere(env._current_state.grid[:, :, workshop_index])\n  if not workshop_coords.size:\n    return []  # Workshop not found in the grid\n\n  # Find the nearest workshop to the agent's current position\n  current_pos = env._current_state.pos\n  nearest_workshop_idx = find_nearest_target(current_pos, workshop_coords)\n  target_pos = tuple(workshop_coords[nearest_workshop_idx])\n\n  # Calculate the actions needed to move to the target position\n  actions_to_target = calculate_actions_to_move(env, current_pos, target_pos)\n\n  if not actions_to_target:\n    return []  # Could not find a path to the workshop\n\n  # Append the USE action to craft the item at the workshop\n  actions_to_target.append(4)  # USE action index is 4\n\n  return actions_to_target", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T04:02:42.055853", "function_name": "craft", "function_body": "  def get_item_index(item_name):\n    return env.world.cookbook.index[item_name]\n\n  def find_workshop_for_goal(goal_index):\n    # Find a workshop with the required recipe\n    for workshop_index in env.world.workshop_indices:\n      if goal_index in env.world.cookbook.recipes.get(workshop_index, {}):\n        return workshop_index\n    return None\n\n  def find_nearest_target(current_pos, target_coords):\n    min_distance = float('inf')\n    nearest_target_idx = -1\n    for i, coord in enumerate(target_coords):\n      distance = np.linalg.norm(np.array(coord) - np.array(current_pos))\n      if distance < min_distance:\n        min_distance = distance\n        nearest_target_idx = i\n    return nearest_target_idx\n\n  def calculate_actions_to_move(env, current_pos, target_pos):\n    # Use a simple pathfinding algorithm to calculate the actions needed to move to the target position\n    path = astar_search(env._current_state.grid, current_pos, target_pos)\n    if not path:\n      return []\n    \n    actions = []\n    for i in range(1, len(path)):\n      next_pos = path[i]\n      delta_x = next_pos[0] - current_pos[0]\n      delta_y = next_pos[1] - current_pos[1]\n\n      if delta_x > 0:\n        actions.append(3)  # RIGHT\n      elif delta_x < 0:\n        actions.append(2)  # LEFT\n      elif delta_y > 0:\n        actions.append(1)  # UP\n      elif delta_y < 0:\n        actions.append(0)  # DOWN\n\n      current_pos = next_pos\n    \n    return actions\n\n  def astar_search(grid, start, goal):\n    open_set = collections.PriorityQueue()\n    open_set.put((0, start))\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, goal)}\n\n    while not open_set.empty():\n      _, current = open_set.get()\n\n      if current == goal:\n        return reconstruct_path(came_from, current)\n\n      for neighbor in get_neighbors(grid, current):\n        tentative_g_score = g_score[current] + 1\n\n        if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n          came_from[neighbor] = current\n          g_score[neighbor] = tentative_g_score\n          f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n          open_set.put((f_score[neighbor], neighbor))\n\n    return []\n\n  def get_neighbors(grid, pos):\n    x, y = pos\n    neighbors = []\n    if x > 0 and grid[x-1, y].sum() == 0:  # Check if cell is empty\n      neighbors.append((x-1, y))\n    if x < grid.shape[0] - 1 and grid[x+1, y].sum() == 0:\n      neighbors.append((x+1, y))\n    if y > 0 and grid[x, y-1].sum() == 0:\n      neighbors.append((x, y-1))\n    if y < grid.shape[1] - 1 and grid[x, y+1].sum() == 0:\n      neighbors.append((x, y+1))\n    return neighbors\n\n  def heuristic(a, b):\n    return np.linalg.norm(np.array(a) - np.array(b), ord=1)\n\n  def reconstruct_path(came_from, current):\n    total_path = [current]\n    while current in came_from:\n        current = came_from[current]\n        total_path.append(current)\n    return total_path[::-1]\n\n  # Get the goal index for the desired item\n  goal_index = get_item_index(item)\n\n  # Check if we have all the primitives required for crafting\n  primitives_required = env.world.cookbook.primitives_for(goal_index)\n  inventory = env._current_state.inventory\n\n  # Check if the agent has all the required primitives in their inventory\n  for primitive, count in primitives_required.items():\n    if inventory[primitive] < count:\n      return []  # Not enough primitives to craft the item\n\n  # Find a workshop with the required recipe\n  workshop_index = find_workshop_for_goal(goal_index)\n  if workshop_index is None:\n    return []  # No valid workshop found\n\n  # Get the coordinates of the workshops in the grid\n  workshop_coords = np.argwhere(env._current_state.grid[:, :, workshop_index])\n  if not workshop_coords.size:\n    return []  # Workshop not found in the grid\n\n  # Find the nearest workshop to the agent's current position\n  current_pos = env._current_state.pos\n  nearest_workshop_idx = find_nearest_target(current_pos, workshop_coords)\n  target_pos = tuple(workshop_coords[nearest_workshop_idx])\n\n  # Calculate the actions needed to move to the target position\n  actions_to_target = calculate_actions_to_move(env, current_pos, target_pos)\n\n  if not actions_to_target:\n    return []  # Could not find a path to the workshop\n\n  # Append the USE action to craft the item at the workshop\n  actions_to_target.append(4)  # USE action index is 4\n\n  return actions_to_target", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T04:03:51.644634", "function_name": "craft", "function_body": "  # Helper function to move to a specific position\n  def move_to(pos):\n    x_goal, y_goal = pos\n    x_cur, y_cur = env._current_state.pos\n    actions = []\n    while x_cur != x_goal:\n      if x_cur < x_goal:\n        actions.append(craft.MOVE_RIGHT)\n      else:\n        actions.append(craft.MOVE_LEFT)\n      x_cur += 1 if x_cur < x_goal else -1\n    while y_cur != y_goal:\n      if y_cur < y_goal:\n        actions.append(craft.MOVE_DOWN)\n      else:\n        actions.append(craft.MOVE_UP)\n      y_cur += 1 if y_cur < y_goal else -1\n    return actions\n\n  # Helper function to check if all ingredients are available in the inventory\n  def has_ingredients(primitives, inventory):\n    for primitive_index in primitives:\n      if inventory[primitive_index] == 0:\n        return False\n    return True\n\n  # Get item index from name\n  cookbook = env.world.cookbook.index\n  item_index = cookbook[item]\n\n  # Check if the item has a recipe\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"No recipe found for item: {item}\")\n\n  # Get the recipe and primitives required\n  recipe = env.world.cookbook.recipes[item_index]\n  primitives = [key for key in recipe.keys() if key != \"_key\"]\n\n  # Check if all ingredients are available in the inventory\n  inventory = env._current_state.inventory\n  if not has_ingredients(primitives, inventory):\n    return []\n\n  # Find a workshop to craft the item\n  workshop_indices = env.world.workshop_indices\n  workshop_positions = [(x, y) for x in range(env.scenario.grid.shape[0]) for y in range(env.scenario.grid.shape[1])\n                        if any(env.scenario.grid[x, y, idx] > 0 for idx in workshop_indices)]\n\n  # If no workshop is found, return an empty list\n  if not workshop_positions:\n    return []\n\n  # Move to the first available workshop\n  actions = move_to(workshop_positions[0])\n\n  # Perform USE action at the workshop to craft the item\n  actions.append(craft.USE)\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-06T04:03:52.694522", "function_name": "craft", "function_body": "  # Helper function to move in a direction\n  def move(dir):\n    if dir == 'UP':\n      return env.world.N_ACTIONS - 4\n    elif dir == 'DOWN':\n      return env.world.N_ACTIONS - 3\n    elif dir == 'LEFT':\n      return env.world.N_ACTIONS - 2\n    elif dir == 'RIGHT':\n      return env.world.N_ACTIONS - 1\n\n  # Helper function to perform the USE action\n  def use():\n    return env.world.N_ACTIONS - 5\n\n  actions = []\n\n  # Get the index of the item to craft\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the primitives required for crafting\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  inventory = env._current_state.inventory\n\n  for prim, count in primitives_needed.items():\n    if inventory[prim] < count:\n      return []  # Not enough primitives to craft\n\n  # Find a workshop that can craft the item\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_indices = env.world.workshop_indices\n\n  for workshop_index in workshop_indices:\n    if workshop_index in recipe:\n      break\n  else:\n    return []  # No workshop found that can craft the item\n\n  # Move to the workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n\n  # Simple heuristic to move towards the workshop (could be improved)\n  workshop_pos = np.argwhere(grid[:, :, workshop_index] > 0)[0]\n  while not np.array_equal(pos, workshop_pos):\n    if pos[0] < workshop_pos[0]:\n      actions.append(move('DOWN'))\n      pos = (pos[0] + 1, pos[1])\n    elif pos[0] > workshop_pos[0]:\n      actions.append(move('UP'))\n      pos = (pos[0] - 1, pos[1])\n    if pos[1] < workshop_pos[1]:\n      actions.append(move('RIGHT'))\n      pos = (pos[0], pos[1] + 1)\n    elif pos[1] > workshop_pos[1]:\n      actions.append(move('LEFT'))\n      pos = (pos[0], pos[1] - 1)\n\n  # Use the workshop to craft the item\n  actions.append(use())\n\n  return actions", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T04:04:37.602579", "function_name": "craft", "function_body": "  # Get index from name\n  cookbook = env.world.cookbook.index\n  item_index = cookbook[item]\n\n  # Check if we have all primitives required for crafting the item\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n\n  # If not all primitives are available, return an empty action list\n  inventory = env._current_state.inventory\n  missing_primitives = [p for p in primitives_needed if inventory[p] < primitives_needed[p]]\n  if missing_primitives:\n    print(f\"Missing primitives: {missing_primitives}\")\n    return []\n\n  # Find a workshop that can craft the item\n  recipes = env.world.cookbook.recipes\n  workshop_index = None\n  for recipe_output, recipe in recipes.items():\n      if recipe.get(\"_key\", None) == item_index:\n          workshop_index = list(recipe.values())[0]  # Assuming first ingredient is workshop index\n          break\n\n  # If no valid workshop found, return an empty action list\n  if workshop_index is None:\n    print(\"No valid workshop found for the item.\")\n    return []\n\n  # Navigate to the workshop and perform the crafting action (USE)\n  actions = []\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  dir = env._current_state.dir\n\n  # Find all positions of the workshop in the grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    print(\"No workshops found on the grid.\")\n    return []\n\n  # Calculate distances from current position to each workshop\n  distances = [np.linalg.norm(np.array(pos) - wp) for wp in workshop_positions]\n  \n  # Choose the closest workshop\n  closest_workshop_pos = workshop_positions[np.argmin(distances)]\n\n  # Navigate to the closest workshop (simple BFS or A* can be used here)\n  actions += navigate_to(env._current_state, closest_workshop_pos)\n\n  # Perform the USE action to craft the item\n  actions.append(env.world.cookbook.index[\"USE\"])\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-06T04:04:38.581110", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all primitives required for crafting\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n  \n  actions = []\n  # If there are no primitives required, it means we can't craft the item with current setup.\n  if not primitives_required:\n    return actions\n  \n  # Collecting necessary primitives\n  for primitive, count in primitives_required.items():\n      action_to_collect_primitive = collect(env, env.world.cookbook.index.get(primitive))\n      actions.extend(action_to_collect_primitive)\n\n  # Proceed to craft the item by going to the workshop and using USE action\n  # Assuming there is a workshop that can be used for crafting any item. \n  # This might need to be refined further based on specific workshops required for different items.\n  # For simplicity, let's assume we move to the first available workshop.\n\n  if env.world.workshop_indices:\n      workshop_index = env.world.workshop_indices[0]\n      actions.extend(move_to_workshop(env, workshop_index))\n      actions.append(craft.USE)\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-06T04:05:14.088594", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index of the desired item\n  index = env.world.cookbook.index[item]\n  \n  # Check if the goal is known (i.e., if it exists in the recipes)\n  if index not in env.world.cookbook.recipes:\n    return []  # Raise ValueError or return an empty list\n  \n  # Get the primitives required to craft the item\n  primitives_needed = env.world.cookbook.primitives_for(index)\n  \n  # Collect all necessary primitives\n  for primitive, count in primitives_needed.items():\n    # Ensure we have enough of each primitive in our inventory\n    while env._current_state.inventory[primitive] < count:\n      actions.extend(collect_v2(env, primitive))\n  \n  # Find a workshop that can craft the item\n  workshops = [workshop for workshop in env.world.workshop_indices if index in env.world.cookbook.recipes]\n  \n  # Use the first available workshop to craft the item\n  if workshops:\n    workshop_index = workshops[0]\n    \n    # Move to the workshop\n    actions.extend(move_to_workshop(env, workshop_index))\n    \n    # Craft the item at the workshop\n    actions.append(craft.ACTION_USE)\n  else:\n    return []  # No workshop found for crafting the item\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-06T04:05:15.207216", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n\n  if item_index not in cookbook.recipes:\n    print(f\"No recipe for {item}.\")\n    return []\n\n  # Check if we have all the primitives required.\n  primitives_required = cookbook.primitives_for(item_index)\n  inventory = env._current_state.inventory\n\n  missing_primitives = []\n  actions = []\n\n  for primitive, count in primitives_required.items():\n    if inventory[primitive] < count:\n      missing_primitives.append((primitive, count - inventory[primitive]))\n\n  if missing_primitives:\n    print(f\"Missing primitives: {missing_primitives}. Cannot craft {item}.\")\n    return []\n\n  # If we have all the required primitives, proceed to craft.\n  recipe = cookbook.recipes[item_index]\n  workshop_index = recipe.get(\"_key\", None)\n\n  if not workshop_index:\n    print(\"No workshop specified in the recipe.\")\n    return []\n\n  # Move to the workshop and perform the USE action to craft the item.\n  workshop_position = env._current_state.world.workshop_indices[workshop_index]\n  current_position = env._current_state.pos\n\n  actions.extend(move_to(env, workshop_position))\n  actions.append(craft.USE)\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-06T04:08:43.571476", "function_name": "craft", "function_body": "  def get_item_index(item_name):\n    return env.world.cookbook.index[item_name]\n\n  def find_workshop_for_goal(goal_index):\n    for workshop_index in env.world.workshop_indices:\n      if goal_index in env.world.cookbook.recipes.get(workshop_index, {}):\n        return workshop_index\n    return None\n\n  def find_nearest_target(current_pos, target_coords):\n    min_distance = float('inf')\n    nearest_target_idx = -1\n    for i, coord in enumerate(target_coords):\n      distance = np.linalg.norm(np.array(coord) - np.array(current_pos))\n      if distance < min_distance:\n        min_distance = distance\n        nearest_target_idx = i\n    return nearest_target_idx\n\n  def calculate_actions_to_move(env, current_pos, target_pos):\n    path = astar_search(env._current_state.grid, current_pos, target_pos)\n    if not path:\n      return []\n    \n    actions = []\n    for i in range(1, len(path)):\n      next_pos = path[i]\n      delta_x = next_pos[0] - current_pos[0]\n      delta_y = next_pos[1] - current_pos[1]\n\n      if delta_x > 0:\n        actions.append(3)  # RIGHT\n      elif delta_x < 0:\n        actions.append(2)  # LEFT\n      elif delta_y > 0:\n        actions.append(1)  # UP\n      elif delta_y < 0:\n        actions.append(0)  # DOWN\n\n      current_pos = next_pos\n    \n    return actions\n\n  def astar_search(grid, start, goal):\n    open_set = collections.PriorityQueue()\n    open_set.put((0, start))\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, goal)}\n\n    while not open_set.empty():\n      _, current = open_set.get()\n\n      if current == goal:\n        return reconstruct_path(came_from, current)\n\n      for neighbor in get_neighbors(grid, current):\n        tentative_g_score = g_score[current] + 1\n\n        if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n          came_from[neighbor] = current\n          g_score[neighbor] = tentative_g_score\n          f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n          open_set.put((f_score[neighbor], neighbor))\n\n    return []\n\n  def get_neighbors(grid, pos):\n    x, y = pos\n    neighbors = []\n    directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n    for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and grid[nx, ny].sum() == 0:\n            neighbors.append((nx, ny))\n    return neighbors\n\n  def heuristic(a, b):\n    return np.linalg.norm(np.array(a) - np.array(b), ord=1)\n\n  def reconstruct_path(came_from, current):\n    total_path = [current]\n    while current in came_from:\n        current = came_from[current]\n        total_path.append(current)\n    return total_path[::-1]\n\n  # Get the goal index for the desired item\n  goal_index = get_item_index(item)\n\n  # Check if we have all the primitives required for crafting\n  primitives_required = env.world.cookbook.primitives_for(goal_index)\n  inventory = env._current_state.inventory\n\n  # Check if the agent has all the required primitives in their inventory\n  for primitive, count in primitives_required.items():\n    if inventory[primitive] < count:\n      return []  # Not enough primitives to craft the item\n\n  # Find a workshop with the required recipe\n  workshop_index = find_workshop_for_goal(goal_index)\n  if workshop_index is None:\n    return []  # No valid workshop found\n\n  # Get the coordinates of the workshops in the grid\n  workshop_coords = np.argwhere(env._current_state.grid[:, :, workshop_index])\n  if not workshop_coords.size:\n    return []  # Workshop not found in the grid\n\n  # Find the nearest workshop to the agent's current position\n  current_pos = env._current_state.pos\n  nearest_workshop_idx = find_nearest_target(current_pos, workshop_coords)\n  target_pos = tuple(workshop_coords[nearest_workshop_idx])\n\n  # Calculate the actions needed to move to the target position\n  actions_to_target = calculate_actions_to_move(env, current_pos, target_pos)\n\n  if not actions_to_target:\n    return []  # Could not find a path to the workshop\n\n  # Append the USE action to craft the item at the workshop\n  actions_to_target.append(4)  # USE action index is 4\n\n  return actions_to_target", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T04:08:44.630404", "function_name": "craft", "function_body": "  def get_item_index(item_name):\n    return env.world.cookbook.index[item_name]\n\n  def find_workshop_for_goal(goal_index):\n    for workshop_index in env.world.workshop_indices:\n      if goal_index in env.world.cookbook.recipes.get(workshop_index, {}):\n        return workshop_index\n    return None\n\n  def find_nearest_target(current_pos, target_coords):\n    min_distance = float('inf')\n    nearest_target_idx = -1\n    for i, coord in enumerate(target_coords):\n      distance = np.linalg.norm(np.array(coord) - np.array(current_pos))\n      if distance < min_distance:\n        min_distance = distance\n        nearest_target_idx = i\n    return nearest_target_idx\n\n  def calculate_actions_to_move(env, current_pos, target_pos):\n    path = astar_search(env._current_state.grid, current_pos, target_pos)\n    if not path:\n      return []\n    \n    actions = []\n    for i in range(1, len(path)):\n      next_pos = path[i]\n      delta_x = next_pos[0] - current_pos[0]\n      delta_y = next_pos[1] - current_pos[1]\n\n      if delta_x > 0:\n        actions.append(3)  # RIGHT\n      elif delta_x < 0:\n        actions.append(2)  # LEFT\n      elif delta_y > 0:\n        actions.append(1)  # UP\n      elif delta_y < 0:\n        actions.append(0)  # DOWN\n\n      current_pos = next_pos\n    \n    return actions\n\n  def astar_search(grid, start, goal):\n    open_set = collections.PriorityQueue()\n    open_set.put((0, start))\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, goal)}\n\n    while not open_set.empty():\n      _, current = open_set.get()\n\n      if current == goal:\n        return reconstruct_path(came_from, current)\n\n      for neighbor in get_neighbors(grid, current):\n        tentative_g_score = g_score[current] + 1\n\n        if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n          came_from[neighbor] = current\n          g_score[neighbor] = tentative_g_score\n          f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n          open_set.put((f_score[neighbor], neighbor))\n\n    return []\n\n  def get_neighbors(grid, pos):\n    x, y = pos\n    neighbors = []\n    directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n    for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and grid[nx, ny].sum() == 0:\n            neighbors.append((nx, ny))\n    return neighbors\n\n  def heuristic(a, b):\n    return np.linalg.norm(np.array(a) - np.array(b), ord=1)\n\n  def reconstruct_path(came_from, current):\n    total_path = [current]\n    while current in came_from:\n        current = came_from[current]\n        total_path.append(current)\n    return total_path[::-1]\n\n  # Get the goal index for the desired item\n  goal_index = get_item_index(item)\n\n  # Check if we have all the primitives required for crafting\n  primitives_required = env.world.cookbook.primitives_for(goal_index)\n  inventory = env._current_state.inventory\n\n  # Check if the agent has all the required primitives in their inventory\n  for primitive, count in primitives_required.items():\n    if inventory[primitive] < count:\n      return []  # Not enough primitives to craft the item\n\n  # Find a workshop with the required recipe\n  workshop_index = find_workshop_for_goal(goal_index)\n  if workshop_index is None:\n    return []  # No valid workshop found\n\n  # Get the coordinates of the workshops in the grid\n  workshop_coords = np.argwhere(env._current_state.grid[:, :, workshop_index])\n  if not workshop_coords.size:\n    return []  # Workshop not found in the grid\n\n  # Find the nearest workshop to the agent's current position\n  current_pos = env._current_state.pos\n  nearest_workshop_idx = find_nearest_target(current_pos, workshop_coords)\n  target_pos = tuple(workshop_coords[nearest_workshop_idx])\n\n  # Calculate the actions needed to move to the target position\n  actions_to_target = calculate_actions_to_move(env, current_pos, target_pos)\n\n  if not actions_to_target:\n    return []  # Could not find a path to the workshop\n\n  # Append the USE action to craft the item at the workshop\n  actions_to_target.append(4)  # USE action index is 4\n\n  # Collect any required primitives that are missing in the inventory\n  for primitive, count in primitives_required.items():\n    if inventory[primitive] < count:\n      actions_to_primitive = collect(env, primitive)\n      actions_to_target.extend(actions_to_primitive)\n\n  return actions_to_target", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T04:11:02.198343", "function_name": "craft", "function_body": "  def find_nearest_workshop(grid, workshops):\n      min_dist = float('inf')\n      nearest_workshop_pos = None\n      agent_pos = env._current_state.pos\n      \n      for workshop_index in workshops:\n          workshop_pos = find_position_of_kind(grid, workshop_index)\n          if workshop_pos is not None:\n              dist = np.linalg.norm(np.array(agent_pos) - np.array(workshop_pos))\n              if dist < min_dist:\n                  min_dist = dist\n                  nearest_workshop_pos = workshop_pos\n      \n      return nearest_workshop_pos\n\n  def find_position_of_kind(grid, kind_index):\n      positions = np.argwhere(grid[:, :, kind_index] > 0)\n      if len(positions) == 0:\n          return None\n      # Return the first position found (simple heuristic for now)\n      return tuple(positions[0])\n\n  def move_to_position(current_pos, target_pos):\n      x_diff = target_pos[0] - current_pos[0]\n      y_diff = target_pos[1] - current_pos[1]\n\n      actions = []\n      \n      # Move horizontally first\n      if x_diff > 0:\n          actions.extend([3] * abs(x_diff))  # RIGHT\n      elif x_diff < 0:\n          actions.extend([2] * abs(x_diff))  # LEFT\n      \n      # Then move vertically\n      if y_diff > 0:\n          actions.extend([1] * abs(y_diff))  # UP\n      elif y_diff < 0:\n          actions.extend([0] * abs(y_diff))  # DOWN\n      \n      return actions\n\n  def collect_primitives(primitives_needed):\n      actions = []\n      \n      for primitive, count in primitives_needed.items():\n          if env._current_state.inventory[primitive] >= count:\n              continue\n          \n          # Find positions of the required primitive\n          primitive_positions = find_position_of_kind(env._current_state.grid, primitive)\n          if not primitive_positions:\n              return []  # Could not find the required primitive\n            \n          # Move to the position and collect the primitive\n          actions.extend(move_to_position(env._current_state.pos, primitive_positions))\n          actions.append(4)  # USE action\n      \n      return actions\n\n  actions = []\n  \n  # Get the index of the item from the cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the primitives required for crafting\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  missing_primitives = {primitive: count - env._current_state.inventory[primitive] \n                        for primitive, count in primitives_needed.items() \n                        if count > env._current_state.inventory[primitive]}\n  \n  # If there are any missing primitives, collect them\n  actions.extend(collect_primitives(missing_primitives))\n  \n  # Find the workshop index needed to craft the item\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_indices = [i_kind for i_kind in env.world.workshop_indices \n                      if any(i_kind == key or f\"workshop{i_kind}\" in str(key) for key in recipe.keys())]\n  \n  # If no valid workshops are found, return an empty action list\n  if not workshop_indices:\n    return []\n  \n  # Find the nearest workshop\n  nearest_workshop_pos = find_nearest_workshop(env._current_state.grid, workshop_indices)\n  \n  # Move to the nearest workshop\n  if nearest_workshop_pos is not None:\n    actions.extend(move_to_position(env._current_state.pos, nearest_workshop_pos))\n    \n    # Use the workshop to craft the item\n    actions.append(4)  # USE action\n  \n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T04:11:03.248664", "function_name": "craft", "function_body": "  def find_position_of_kind(grid, kind_index):\n    positions = np.argwhere(grid[:, :, kind_index] == 1)\n    return tuple(positions[0]) if positions.size > 0 else None\n\n  def move_to_position(current_pos, target_pos) -> list[int]:\n      actions = []\n      while current_pos != target_pos:\n          delta_x = target_pos[0] - current_pos[0]\n          delta_y = target_pos[1] - current_pos[1]\n\n          if delta_x < 0:\n              actions.append(2)  # LEFT\n          elif delta_x > 0:\n              actions.append(3)  # RIGHT\n\n          if delta_y < 0:\n              actions.append(1)  # UP\n          elif delta_y > 0:\n              actions.append(0)  # DOWN\n\n          current_pos = (current_pos[0] + (delta_x != 0), current_pos[1] + (delta_y != 0))\n\n      return actions\n\n  def find_nearest_workshop(grid, workshops):\n      min_dist = float('inf')\n      nearest_workshop_pos = None\n      agent_pos = env._current_state.pos\n      \n      for workshop_index in workshops:\n          workshop_pos = find_position_of_kind(grid, workshop_index)\n          if workshop_pos is not None:\n              dist = np.linalg.norm(np.array(agent_pos) - np.array(workshop_pos))\n              if dist < min_dist:\n                  min_dist = dist\n                  nearest_workshop_pos = workshop_pos\n      \n      return nearest_workshop_pos\n\n  actions = []\n  \n  # Get the index of the item from the cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the primitives required for crafting\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  missing_primitives = {primitive: count - env._current_state.inventory[primitive] \n                        for primitive, count in primitives_needed.items() \n                        if count > env._current_state.inventory[primitive]}\n  \n  # If there are any missing primitives, return an empty action list\n  if missing_primitives:\n    return []\n  \n  # Find the workshop index needed to craft the item\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_indices = [i_kind for i_kind in env.world.workshop_indices \n                      if any(i_kind == key or f\"workshop{i_kind}\" in str(key) for key in recipe.keys())]\n  \n  # If no valid workshops are found, return an empty action list\n  if not workshop_indices:\n    return []\n  \n  # Find the nearest workshop\n  nearest_workshop_pos = find_nearest_workshop(env._current_state.grid, workshop_indices)\n  \n  # Move to the nearest workshop\n  if nearest_workshop_pos is not None:\n    actions.extend(move_to_position(env._current_state.pos, nearest_workshop_pos))\n    \n    # Use the workshop to craft the item\n    actions.append(4)  # USE action\n  \n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T04:12:10.707166", "function_name": "craft", "function_body": "  actions = []\n  \n  # Convert item name to index using cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the required primitives are available in inventory\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n  for primitive, count in primitives_required.items():\n    if env._current_state.inventory[primitive] < count:\n      return []  # Primitives not available, return empty action list\n  \n  # Get workshop index from recipe (assuming there's one workshop type for simplicity)\n  # This needs to be more sophisticated based on the actual recipe format\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_index = None\n  for ingredient in recipe:\n    if ingredient.startswith(\"workshop\"):\n      workshop_index = int(ingredient.split(\"_\")[-1])\n      break\n  \n  if workshop_index is None:\n    return []  # No valid workshop found, return empty action list\n  \n  # Move to the nearest available workshop of specified type\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n    return []  # No workshops available, return empty action list\n  \n  closest_workshop_pos = min(\n      workshop_positions,\n      key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n  )\n  \n  path_to_workshop = find_path(env._current_state.grid, env._current_state.pos, closest_workshop_pos)\n  \n  if not path_to_workshop:\n    return []  # No valid path to workshop found, return empty action list\n  \n  actions.extend(path_to_workshop)  # Add movement actions to reach the nearest workshop\n  \n  actions.append(4)  # USE action to craft the item at the workshop\n  \n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-06T04:12:11.738498", "function_name": "craft", "function_body": "  actions = []\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in cookbook.recipes:\n    print(f\"No recipe for {item}\")\n    return []\n\n  # Get the primitives required to craft the item\n  primitive_requirements = cookbook.primitives_for(item_index)\n\n  # Collect all the required primitives\n  for primitive, count in primitive_requirements.items():\n      actions.extend(collect_v1(env, cookbook.index.get(primitive)))\n\n  # Move to the workshop and use the action to craft the item\n  recipe = cookbook.recipes[item_index]\n  if \"_key\" in recipe:\n      workshop_index = recipe[\"_key\"]\n  else:\n      print(\"No key found in recipe\")\n      return []\n\n  workshop_indices = env.world.workshop_indices\n\n  # Find the nearest workshop index based on the given key (workshop type)\n  nearest_workshop_index = next((i for i, idx in enumerate(workshop_indices) if idx == workshop_index), None)\n\n  if nearest_workshop_index is not None:\n      workshop_pos = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n      if workshop_pos.size > 0:\n          # Assuming the first found position of the workshop\n          target_workshop_pos = tuple(workshop_pos[0])\n\n          actions.extend(move_to_v1(env, target_workshop_pos))\n          actions.append(craft.USE)\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-06T04:14:55.605488", "function_name": "craft", "function_body": "  def has_primitives(primitives):\n    for primitive, count in primitives.items():\n      if env._current_state.inventory[primitive] < count:\n        return False\n    return True\n\n  def move_to_position(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    # Calculate the direction to move\n    direction_row = np.sign(target_pos[0] - current_pos[0])\n    direction_col = np.sign(target_pos[1] - current_pos[1])\n\n    while current_pos != target_pos:\n      if direction_row != 0:\n        action = 1 if direction_row > 0 else 0\n        actions.append(action)\n        current_pos = (current_pos[0] + direction_row, current_pos[1])\n      elif direction_col != 0:\n        action = 3 if direction_col > 0 else 2\n        actions.append(action)\n        current_pos = (current_pos[0], current_pos[1] + direction_col)\n\n    return actions\n\n  def get_random_workshop_position(env, workshop_index):\n    grid = env._current_state.grid\n    positions_next_to_workshop = np.argwhere(grid[:, :, workshop_index] > 0)\n    if len(positions_next_to_workshop) == 0:\n      return None\n    target_pos = tuple(positions_next_to_workshop[env.random.randint(len(positions_next_to_workshop))])\n    return target_pos\n\n  def get_required_primitives(item_index):\n    required_primitives = env.world.cookbook.primitives_for(item_index)\n    return required_primitives\n\n  # Get the index of the item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the primitives needed to craft the item\n  required_primitives = get_required_primitives(item_index)\n  if not has_primitives(required_primitives):\n    return []\n  \n  # Find all workshop indices from the recipe (assuming multiple workshops could be involved in crafting)\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_indices = [i for i, count in recipe.items() if i != \"_key\"]\n  \n  actions = []\n  for workshop_index in workshop_indices:\n    # Find a position next to the workshop\n    target_pos = get_random_workshop_position(env, workshop_index)\n    if not target_pos:\n      return []\n    \n    # Move to the chosen position\n    actions_to_target = move_to_position(env, target_pos)\n    if not actions_to_target:\n      return []\n    \n    # Add USE action to craft the item\n    use_action = env.world.n_actions - 1  # Assuming USE is the last action\n    \n    # Combine all actions\n    actions.extend(actions_to_target + [use_action])\n  \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
