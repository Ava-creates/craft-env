    actions.append(ACTION_USE)  # Assuming USE is always the last action to collect primitive\n        return actions\n\n  def use_workshop(workshop_index):\n    \"\"\"Helper function to generate actions to use a workshop.\"\"\"\n    target_positions = np.where(env._current_state.grid[:, :, workshop_index] > 0)\n    \n    if len(target_positions[0]) == 0 or len(target_positions[1]) == 0:\n      return None\n    \n    closest_workshop_pos = find_closest_target(target_positions)\n    \n    if closest_workshop_pos is not None:\n        tx, ty = closest_workshop_pos\n        actions = move_to_position(tx, ty)\n        actions.append(ACTION_USE)  # Assuming USE is always the last action to craft item\n        return actions\n\n  def find_closest_target(target_positions):\n      \"\"\"Helper function to find the closest target position.\"\"\"\n      pos_x, pos_y = env._current_state.pos\n      \n      min_distance = float('inf')\n      closest_pos = None\n      \n      for tx, ty in zip(*target_positions):\n          distance = abs(tx - pos_x) + abs(ty - pos_y)\n          if distance < min_distance:\n              min_distance = distance\n              closest_pos = (tx, ty)\n      \n      return closest_pos\n\n  def check_workshop_availability(workshop_index, primitives_needed):\n    \"\"\"Helper function to check if a workshop has the required recipe.\"\"\"\n    # Assuming each workshop can craft any item with the correct primitives in inventory\n    return True\n\n  actions = []\n  \n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all required primitives for crafting the item\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  current_inventory = env._current_state.inventory\n\n  # Collect missing primitives\n  for prim, count in primitives_needed.items():\n    while current_inventory[prim] < count:\n      primitive_actions = pick_up_primitives(prim)\n      \n      if primitive_actions is not None:\n        actions.extend(primitive_actions)\n        current_inventory[prim] += 1\n      else:\n        return []  # If no source for the primitive, return empty list\n\n  # Find and use a workshop that has the required recipe\n  workshop_used = False\n  for i, workshop in enumerate(env.world.workshop_indices):\n    if check_workshop_availability(workshop, primitives_needed):\n      workshop_actions = move_to_workshop(workshop)\n      \n      if workshop_actions is not None:\n        actions.extend(workshop_actions)\n        \n        # Perform USE action to craft the item\n        actions.append(ACTION_USE)\n        workshop_used = True\n        break\n\n  return actions if workshop_used else []", "island_id": 2, "scores": {"3": 2.0}}
{"timestamp": "2025-09-06T12:21:44.354074", "function_name": "craft", "function_body": "  # Step 1: Get the index of the desired item from the cookbook's index.\n  goal_index = env.world.cookbook.index[item]\n  \n  # Step 2: Retrieve the primitives required to craft the item\n  recipe = env.world.cookbook.primitives_for(goal_index)\n  \n  if not recipe:\n    return []  # No recipe available for this item\n  \n  actions = []\n  \n  # Step 3: Check and collect all required primitives.\n  for primitive_index, count in recipe.items():\n    # Determine the position of the primitive in the grid\n    primitive_name = env.world.cookbook.index.get(primitive_index)\n    \n    if not primitive_name:\n      continue\n    \n    while env._current_state.inventory[primitive_index] < count:\n      # Step 4: Collect the required primitives.\n      collect_actions = collect_v2(env, primitive_name)\n      actions.extend(collect_actions)\n      \n      if env._current_state.inventory[primitive_index] >= count:\n        break\n  \n  # Step 5: Find a workshop to craft the item.\n  workshop_indices = env.world.workshop_indices\n  for workshop in workshop_indices:\n    if env._current_state.next_to(workshop):\n      actions.append(env.world.n_actions - 1)  # USE action to use the workshop\n      break\n  \n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-06T12:21:45.324988", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all primitives required for crafting\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  \n  if not primitives_needed:\n    return []  # No recipe found\n  \n  # Collecting primitives\n  for primitive, count in primitives_needed.items():\n    while env._current_state.inventory[primitive] < count:\n      actions.extend(collect(env, primitive))\n      \n  # Check again if we have all required primitives\n  if any(env._current_state.inventory[p] < c for p, c in primitives_needed.items()):\n    return []  # Failed to collect all required primitives\n  \n  # Go to the workshop and use it to craft the item\n  workshop_index = next(iter(primitives_needed.keys()))  # Assuming that any primitive is mapped to a workshop index\n  actions.extend(go_to_workshop(env, workshop_index))\n  actions.append(env.world.N_ACTIONS - 1)  # USE action\n  \n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-06T12:22:47.218818", "function_name": "craft", "function_body": "  # Initialize a list to store actions\n  actions = []\n\n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the primitives required for crafting the item\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n\n  # Collect all the primitives needed if not already in inventory\n  for primitive, count in primitives_needed.items():\n    actions.extend(collect_v2(env, primitive))\n\n  # Find a workshop to use for crafting\n  for workshop_index in env.world.workshop_indices:\n      # Check if this workshop can be used to craft the item\n      if any(ingredient == \"_key\" or ingredient == workshop_index for ingredient in env.world.cookbook.recipes[item_index]):\n          actions.append(env.world.index[\"USE\"])\n          break\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-06T12:22:48.194204", "function_name": "craft", "function_body": "  # Get the index for the item to be crafted\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the primitives required for crafting\n  needed_primitives = env.world.cookbook.primitives_for(item_index)\n\n  actions = []\n  \n  # Collect all necessary primitives if not already in inventory\n  for primitive, count in needed_primitives.items():\n      while np.sum(env._current_state.inventory[primitive]) < count:\n          actions.extend(collect(env, primitive))\n          \n  # Move to the workshop and perform the USE action to craft the item\n  recipe = env.world.cookbook.recipes[item_index]\n  \n  if '_key' in recipe:\n      workshop_key = recipe['_key']\n      workshop_index = env.world.workshop_indices[workshop_key]\n      \n      # Find a nearby cell with the required workshop type\n      cells_with_workshop = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n      if len(cells_with_workshop) == 0:\n          return []  # No workshop found\n      \n      nearest_cell = find_nearest_cell(env._current_state.pos, cells_with_workshop)\n      \n      # Move to the nearest cell with the required workshop type\n      actions.extend(move_to_position(env, nearest_cell))\n      \n      # Perform the USE action to craft the item\n      actions.append(4)  # USE action\n      \n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-06T12:24:23.213939", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all primitives required to make the item\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n  \n  for primitive, count in primitives_required.items():\n    while env._current_state.inventory[primitive] < count:\n      # Find the nearest workshop that can produce this primitive\n      workshop_index = None\n      for recipe_output, ingredients in env.world.cookbook.recipes.items():\n        if \"_key\" in ingredients and ingredients[\"_key\"] == primitive:\n          workshop_index = recipe_output\n          break\n      \n      if workshop_index is not None:\n        # Find the position of the nearest workshop on the grid\n        workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n        closest_workshop_position = min(workshop_positions, key=lambda pos: np.linalg.norm(np.array(pos) - np.array(env._current_state.pos)))\n        \n        # Move to the workshop\n        actions.extend(move_to_position(env._current_state.pos, closest_workshop_position))\n        \n        # Use the workshop to produce the primitive\n        actions.append(4)  # USE action\n        \n      else:\n        return []  # Cannot find a workshop to produce the required primitive\n  \n  # Once we have all primitives, move to any available workshop to craft the item\n  available_workshops = [i for i in env.world.workshop_indices if i in env.world.cookbook.recipes and env.world.cookbook.recipes[i].get(item_index, 0) > 0]\n  \n  if not available_workshops:\n    return []  # No workshop available to craft the item\n  \n  closest_workshop_position = None\n  min_distance = float('inf')\n  \n  for workshop in available_workshops:\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop] > 0)\n    \n    for pos in workshop_positions:\n      distance = np.linalg.norm(np.array(pos) - np.array(env._current_state.pos))\n      \n      if distance < min_distance:\n        closest_workshop_position = pos\n        min_distance = distance\n  \n  actions.extend(move_to_position(env._current_state.pos, closest_workshop_position))\n  \n  # Use the workshop to craft the item\n  actions.append(4)  # USE action\n  \n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T12:24:24.189528", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index for the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the primitives required for crafting the item\n  if not has_primitives(env, item_index):\n    return []\n\n  # Find a workshop with the required recipe\n  workshop_index = find_workshop_with_recipe(env, item_index)\n  if workshop_index is None:\n    return []\n\n  # Move to the workshop and craft the item\n  actions.extend(move_to_workshop(env, workshop_index))\n  actions.append(craft.USE)  # Craft action\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-06T12:25:49.162922", "function_name": "craft", "function_body": "  # Convert item name to index\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item has a recipe in the cookbook\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the primitives required for crafting the item\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n\n  # Collect all required primitives\n  actions_to_take = []\n  for primitive, count in primitives_required.items():\n    primitive_name = env.world.cookbook.index.get(primitive)\n    actions_to_take.extend(collect(env, primitive_name))\n\n  # Go to the workshop and craft the item\n  if '_key' in env.world.cookbook.recipes[item_index]:\n    workshop_index = env.world.cookbook.recipes[item_index]['_key']\n  else:\n    return []\n\n  # Move to the workshop position (placeholder logic)\n  workshop_position = None  # This needs to be determined based on the grid\n  for x in range(env.scenario.init_grid.shape[0]):\n      for y in range(env.scenario.init_grid.shape[1]):\n          if env.scenario.init_grid[x, y, workshop_index] > 0:\n              workshop_position = (x, y)\n              break\n\n  if not workshop_position:\n    return []\n\n  # Calculate actions to move the agent to the workshop position\n  path_actions = move_to(env, workshop_position)\n\n  # Add USE action to craft the item\n  path_actions.append(craft.USE)\n  \n  # Combine all actions\n  actions_to_take.extend(path_actions)\n\n  return actions_to_take", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-06T12:25:50.277641", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the recipe exists for the item\n  if item_index not in env.world.cookbook.recipes:\n    print(f\"No recipe found for {item}.\")\n    return []\n  \n  # Get the primitives required to craft the item\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n  \n  actions = []\n\n  # Check if we have all required primitives in our inventory\n  inventory = env._current_state.inventory\n  missing_primitives = {i_kind: count for i_kind, count in primitives_required.items() if inventory[i_kind] < count}\n\n  if missing_primitives:\n    print(f\"Missing primitives for crafting {item}: {missing_primitives}\")\n    return []\n\n  # Navigate to the workshop and craft the item\n  # For simplicity, let's assume we know the workshop index from the recipe\n  workshop_index = env.world.cookbook.recipes[item_index].get(\"_key\")\n  if workshop_index is None:\n    print(f\"No workshop index found in the recipe for {item}.\")\n    return []\n  \n  # Convert workshop index to actual grid position (dummy implementation)\n  # In reality, this should be determined by the grid layout\n  workshop_pos = (workshop_index // env.world.grid.shape[1], workshop_index % env.world.grid.shape[1])\n  \n  # Add actions to move to the workshop\n  current_pos = env._current_state.pos\n  actions.extend(move_to(env, workshop_pos))\n  \n  # Add action to use the workshop\n  actions.append(craft.USE)\n  \n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-06T12:29:14.194925", "function_name": "craft", "function_body": "  def bfs(start, goal):\n      queue = collections.deque([start])\n      visited = set()\n      parent = {start: None}\n\n      while queue:\n          pos = queue.popleft()\n          if pos == goal:\n              path = []\n              while pos is not None:\n                  path.append(pos)\n                  pos = parent[pos]\n              return path[::-1]\n\n          x, y = pos\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < env.world.grid.shape[0] and 0 <= ny < env.world.grid.shape[1] and (nx, ny) not in visited:\n                  queue.append((nx, ny))\n                  visited.add((nx, ny))\n                  parent[(nx, ny)] = pos\n\n      return []\n\n  def move_to_pos(pos):\n      current_pos = env._current_state.pos\n      path = bfs(current_pos, pos)\n      if not path:\n          return []\n      \n      action_map = {(-1, 0): craft.MOVE_FUNC(craft.UP), (1, 0): craft.MOVE_FUNC(craft.DOWN),\n                    (0, -1): craft.MOVE_FUNC(craft.LEFT), (0, 1): craft.MOVE_FUNC(craft.RIGHT)}\n      \n      actions = []\n      for i in range(1, len(path)):\n          dx = path[i][0] - path[i-1][0]\n          dy = path[i][1] - path[i-1][1]\n          action = action_map.get((dx, dy))\n          if action:\n              actions.append(action)\n      return actions\n\n  def collect_primitives(env, primitives_required):\n      inventory_counts = collections.Counter(env._current_state.inventory)\n      actions = []\n      \n      for prim_idx, count in primitives_required.items():\n          if inventory_counts.get(prim_idx, 0) < count:\n              # Find the positions of the required primitive\n              primitive_positions = np.argwhere(env.world.grid[:, :, prim_idx] > 0)\n              \n              if not primitive_positions.size:\n                  return []  # If no positions found, return an empty action list\n              \n              for pos in primitive_positions:\n                  actions.extend(move_to_pos(tuple(pos)))\n                  actions.append(craft.COLLECT_FUNC(prim_idx))\n                  \n      return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the primitives required to craft the item\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n\n  # Collect missing primitives\n  collect_actions = collect_primitives(env, primitives_required)\n  if not collect_actions:\n      return []\n\n  actions = []\n  \n  # Find all workshops and their positions\n  workshop_positions = {}\n  for i in range(env.world.grid.shape[0]):\n      for j in range(env.world.grid.shape[1]):\n          kind = np.argmax(env.world.grid[i, j])\n          if kind in env.world.workshop_indices:\n              workshop_positions[kind] = (i, j)\n  \n  # If no workshops are found, return an empty action list\n  if not workshop_positions:\n      return []\n\n  # Determine which workshop to use based on the recipe\n  recipe = env.world.cookbook.recipes[item_index]\n  required_primitives = {prim_idx for prim_idx in primitives_required}\n  available_workshops = set(workshop_positions.keys())\n  \n  # Find a workshop that can craft the item\n  workshop_kind = None\n  for kind, pos in workshop_positions.items():\n      if kind in recipe or \"_key\" in recipe:\n          workshop_kind = kind\n          break\n  \n  if not workshop_kind:\n      return []\n\n  # Move to the chosen workshop\n  actions.extend(collect_actions)\n  actions.extend(move_to_pos(workshop_positions[workshop_kind]))\n  \n  # Add the USE action to craft the item\n  actions.append(craft.CRAFT_FUNC(item_index))\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-06T12:29:15.358928", "function_name": "craft", "function_body": "  def bfs(start, goal):\n      queue = collections.deque([start])\n      visited = set()\n      parent = {start: None}\n\n      while queue:\n          pos = queue.popleft()\n          if pos == goal:\n              path = []\n              while pos is not None:\n                  path.append(pos)\n                  pos = parent[pos]\n              return path[::-1]\n\n          x, y = pos\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < env.world.grid.shape[0] and 0 <= ny < env.world.grid.shape[1] and (nx, ny) not in visited:\n                  queue.append((nx, ny))\n                  visited.add((nx, ny))\n                  parent[(nx, ny)] = pos\n\n      return []\n\n  def move_to_pos(pos):\n      current_pos = env._current_state.pos\n      path = bfs(current_pos, pos)\n      if not path:\n          return []\n      \n      action_map = {(-1, 0): craft.MOVE_FUNC(craft.UP), (1, 0): craft.MOVE_FUNC(craft.DOWN),\n                    (0, -1): craft.MOVE_FUNC(craft.LEFT), (0, 1): craft.MOVE_FUNC(craft.RIGHT)}\n      \n      actions = []\n      for i in range(1, len(path)):\n          dx = path[i][0] - path[i-1][0]\n          dy = path[i][1] - path[i-1][1]\n          action = action_map.get((dx, dy))\n          if action:\n              actions.append(action)\n      return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the primitives required to craft the item\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n  inventory_counts = collections.Counter(env._current_state.inventory)\n\n  # If any primitive is missing, return an empty action list\n  for prim_idx, count in primitives_required.items():\n      if inventory_counts.get(prim_idx, 0) < count:\n          return []\n\n  actions = []\n  \n  # Find all workshops and their positions\n  workshop_positions = {}\n  for i in range(env.world.grid.shape[0]):\n      for j in range(env.world.grid.shape[1]):\n          kind = np.argmax(env.world.grid[i, j])\n          if kind in env.world.workshop_indices:\n              workshop_positions[kind] = (i, j)\n  \n  # If no workshops are found, return an empty action list\n  if not workshop_positions:\n      return []\n\n  # Determine which workshop to use based on the recipe\n  recipe = env.world.cookbook.recipes[item_index]\n  required_primitives = {prim_idx for prim_idx in primitives_required}\n  available_workshops = set(workshop_positions.keys())\n  \n  # Find a workshop that can craft the item\n  workshop_kind = None\n  for kind, pos in workshop_positions.items():\n      if any(prim in recipe for prim in required_primitives):\n          workshop_kind = kind\n          break\n  \n  if not workshop_kind:\n      return []\n\n  # Move to the chosen workshop\n  actions.extend(move_to_pos(workshop_positions[workshop_kind]))\n  \n  # Add the USE action to craft the item\n  actions.append(craft.CRAFT_FUNC(item_index))\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T12:33:22.053938", "function_name": "craft", "function_body": "  def find_all_positions_of_kind(grid: np.ndarray, kind_index: int):\n    positions = []\n    for y in range(grid.shape[0]):\n      for x in range(grid.shape[1]):\n        if grid[y, x, kind_index] > 0:\n          positions.append((x, y))\n    return positions\n\n  def distance(pos1: tuple, pos2: tuple) -> int:\n    \"\"\"Calculate the Manhattan distance between two positions.\"\"\"\n    return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n\n  def move_to_position(current_pos: tuple, target_pos: tuple) -> list[int]:\n    \"\"\"Generate a sequence of actions to move from current position to target position.\"\"\"\n    actions = []\n    current_x, current_y = current_pos\n    target_x, target_y = target_pos\n    \n    # Calculate the steps needed in each direction\n    dx = target_x - current_x\n    dy = target_y - current_y\n    \n    # Move horizontally first if moving left (negative dx)\n    if dx < 0:\n        actions.extend([3] * abs(dx))\n    \n    # Then move vertically\n    if dy > 0:\n        actions.extend([0] * dy)  # DOWN\n    elif dy < 0:\n        actions.extend([1] * abs(dy))  # UP\n    \n    # Move horizontally if moving right (positive dx)\n    if dx > 0:\n        actions.extend([2] * dx)\n    \n    return actions\n\n  def collect_primitive(env, primitive: int) -> list[int]:\n    \"\"\"Generate a sequence of actions to collect the required primitive.\"\"\"\n    grid = env._current_state.grid\n    positions = find_all_positions_of_kind(grid, primitive)\n    \n    if not positions:\n        return []\n    \n    nearest_position = min(positions, key=lambda pos: distance(env._current_state.pos, pos))\n    path_to_primitive = move_to_position(env._current_state.pos, nearest_position)\n    return path_to_primitive + [4]  # Add USE action to collect the primitive\n\n  def find_workshop_index_for_item(item_index: int, cookbook):\n      \"\"\"Find the workshop index required for crafting an item.\"\"\"\n      recipe = cookbook.recipes[item_index]\n      workshop_key = recipe.get(\"_key\", None)\n      \n      if workshop_key is not None:\n          for key, value in cookbook.recipes.items():\n              if \"_key\" in value and value[\"_key\"] == workshop_key:\n                  return key\n      return None\n\n  def check_and_collect_primitives(env, primitives_needed):\n      actions = []\n      grid = env._current_state.grid\n      \n      for primitive, count in primitives_needed.items():\n          missing_count = count - env._current_state.inventory[primitive]\n          while missing_count > 0:\n              actions.extend(collect_primitive(env, primitive))\n              # Simulate the collection by updating inventory\n              env._current_state.inventory[primitive] += 1\n              missing_count -= 1\n      \n      return actions\n\n  def find_closest_workshop_position(grid: np.ndarray, workshop_index: int, current_pos: tuple):\n    positions = find_all_positions_of_kind(grid, workshop_index)\n    if not positions:\n        return None\n    nearest_position = min(positions, key=lambda pos: distance(current_pos, pos))\n    return nearest_position\n\n  actions = []\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  # Check if we have all the primitives required for crafting\n  primitives_needed = cookbook.primitives_for(item_index)\n  actions.extend(check_and_collect_primitives(env, primitives_needed))\n  \n  # Find the workshop index needed to craft the item\n  workshop_index = find_workshop_index_for_item(item_index, cookbook)\n\n  if workshop_index is not None:\n      grid = env._current_state.grid\n      nearest_workshop_pos = find_closest_workshop_position(grid, workshop_index, env._current_state.pos)\n      \n      if nearest_workshop_pos is not None:\n          actions.extend(move_to_position(env._current_state.pos, nearest_workshop_pos))\n          \n          # Use the workshop to craft the item\n          actions.append(4)  # USE action\n  \n  return actions", "island_id": 1, "scores": {"3": 0.29999995}}
{"timestamp": "2025-09-06T12:33:23.123970", "function_name": "craft", "function_body": "  def find_all_positions_of_kind(grid: np.ndarray, kind_index: int):\n    positions = []\n    for y in range(grid.shape[0]):\n      for x in range(grid.shape[1]):\n        if grid[y, x, kind_index] > 0:\n          positions.append((x, y))\n    return positions\n\n  def distance(pos1: tuple, pos2: tuple) -> int:\n    \"\"\"Calculate the Manhattan distance between two positions.\"\"\"\n    return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n\n  def move_to_position(current_pos: tuple, target_pos: tuple) -> list[int]:\n    \"\"\"Generate a sequence of actions to move from current position to target position.\"\"\"\n    actions = []\n    current_x, current_y = current_pos\n    target_x, target_y = target_pos\n    \n    # Calculate the steps needed in each direction\n    dx = target_x - current_x\n    dy = target_y - current_y\n    \n    # Move vertically first if moving up (negative dy)\n    if dy < 0:\n        actions.extend([1] * abs(dy))\n        current_y += dy\n    \n    # Then move horizontally\n    if dx > 0:\n        actions.extend([2] * dx)  # RIGHT\n        current_x += dx\n    elif dx < 0:\n        actions.extend([3] * abs(dx))  # LEFT\n        current_x -= dx\n    \n    # Move vertically if moving down (positive dy)\n    if dy > 0:\n        actions.extend([0] * dy)  # DOWN\n        current_y += dy\n    \n    return actions\n\n  def collect_primitive(env, primitive: int) -> list[int]:\n    \"\"\"Generate a sequence of actions to collect the required primitive.\"\"\"\n    grid = env._current_state.grid\n    positions = find_all_positions_of_kind(grid, primitive)\n    \n    if not positions:\n        return []\n    \n    nearest_position = min(positions, key=lambda pos: distance(env._current_state.pos, pos))\n    path_to_primitive = move_to_position(env._current_state.pos, nearest_position)\n    return path_to_primitive + [4]  # Add USE action to collect the primitive\n\n  def find_workshop_index_for_item(item_index: int, cookbook):\n      \"\"\"Find the workshop index required for crafting an item.\"\"\"\n      recipe = cookbook.recipes[item_index]\n      workshop_key = recipe.get(\"_key\", None)\n      \n      if workshop_key is not None:\n          for key, value in cookbook.recipes.items():\n              if \"_key\" in value and value[\"_key\"] == workshop_key:\n                  return key\n      return None\n\n  def check_and_collect_primitives(env, primitives_needed):\n      actions = []\n      grid = env._current_state.grid\n      \n      for primitive, count in primitives_needed.items():\n          missing_count = count - env._current_state.inventory[primitive]\n          while missing_count > 0:\n              actions.extend(collect_primitive(env, primitive))\n              # Simulate the collection by updating inventory\n              env._current_state.inventory[primitive] += 1\n              missing_count -= 1\n      \n      return actions\n\n  def find_closest_workshop_position(grid: np.ndarray, workshop_index: int, current_pos: tuple):\n    positions = find_all_positions_of_kind(grid, workshop_index)\n    if not positions:\n        return None\n    nearest_position = min(positions, key=lambda pos: distance(current_pos, pos))\n    return nearest_position\n\n  actions = []\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  # Check if we have all the primitives required for crafting\n  primitives_needed = cookbook.primitives_for(item_index)\n  actions.extend(check_and_collect_primitives(env, primitives_needed))\n  \n  # Find the workshop index needed to craft the item\n  workshop_index = find_workshop_index_for_item(item_index, cookbook)\n\n  if workshop_index is not None:\n      grid = env._current_state.grid\n      nearest_workshop_pos = find_closest_workshop_position(grid, workshop_index, env._current_state.pos)\n      \n      if nearest_workshop_pos is not None:\n          actions.extend(move_to_position(env._current_state.pos, nearest_workshop_pos))\n          \n          # Use the workshop to craft the item\n          actions.append(4)  # USE action\n  \n  return actions", "island_id": 1, "scores": {"3": 0.49999994}}
