{"timestamp": "2025-09-06T06:21:06.919489", "function_name": "craft", "function_body": "  def has_primitives(primitives):\n    for primitive, count in primitives.items():\n      if env._current_state.inventory[primitive] < count:\n        return False\n    return True\n\n  def move_to_position(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    # Calculate the direction to move\n    while current_pos != target_pos:\n        row_diff = np.sign(target_pos[0] - current_pos[0])\n        col_diff = np.sign(target_pos[1] - current_pos[1])\n\n        if row_diff != 0 and (current_pos[0] + row_diff, current_pos[1]) not in env.world.cookbook.index._boundary_positions:\n            action = 3 if row_diff > 0 else 2\n            actions.append(action)\n            current_pos = (current_pos[0] + row_diff, current_pos[1])\n        elif col_diff != 0 and (current_pos[0], current_pos[1] + col_diff) not in env.world.cookbook.index._boundary_positions:\n            action = 1 if col_diff > 0 else 0\n            actions.append(action)\n            current_pos = (current_pos[0], current_pos[1] + col_diff)\n\n    return actions\n\n  def get_random_workshop_position(env, workshop_index):\n    grid = env._current_state.grid\n    positions_next_to_workshop = np.argwhere(grid[:, :, workshop_index] > 0)\n    if len(positions_next_to_workshop) == 0:\n      return None\n    target_pos = tuple(positions_next_to_workshop[env.random.randint(len(positions_next_to_workshop))])\n    return target_pos\n\n  def get_required_primitives(item_index):\n    required_primitives = env.world.cookbook.primitives_for(item_index)\n    return required_primitives\n\n  # Get the index of the item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the primitives needed to craft the item\n  required_primitives = get_required_primitives(item_index)\n  if not has_primitives(required_primitives):\n    return []\n  \n  # Find the workshop indices from the recipe (assuming there's only one workshop involved in crafting)\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_indices = [i for i, count in recipe.items() if i != \"_key\"]\n  \n  actions = []\n  for workshop_index in workshop_indices:\n    # Find a position next to the workshop\n    target_pos = get_random_workshop_position(env, workshop_index)\n    if not target_pos:\n      return []\n    \n    # Move to the chosen position\n    actions_to_target = move_to_position(env, target_pos)\n    if not actions_to_target:\n      return []\n    \n    # Add USE action to craft the item\n    use_action = env.world.n_actions - 1  # Assuming USE is the last action\n    \n    # Combine all actions\n    actions.extend(actions_to_target + [use_action])\n  \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T06:21:44.062151", "function_name": "craft", "function_body": "  # Convert item name to its corresponding index\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the goal is valid\n  if item_index not in env.world.cookbook.recipes:\n    print(f\"No recipe found for {item}.\")\n    return []\n\n  # Get the primitives required for crafting the item\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n  \n  # Initialize a list to store the actions needed to craft the item\n  actions_to_take = []\n  \n  # Check if we have all the required primitives in our inventory\n  for primitive, count in primitives_required.items():\n    if env._current_state.inventory[primitive] < count:\n      print(f\"Missing {count - env._current_state.inventory[primitive]} of {env.world.cookbook.index.get(primitive, 'unknown')}.\")\n      # TODO: Add logic to collect the missing primitives\n      return []\n\n  # If we have all the required primitives, proceed to craft the item\n  for primitive in primitives_required.keys():\n    # Move to the nearest workshop that can process this primitive\n    # For now, let's assume there is a single workshop (WORKSHOP0) available\n    actions_to_take.extend(move_v1(env, \"WORKSHOP0\"))\n\n    # Perform the USE action at the workshop\n    actions_to_take.append(4)\n\n  return actions_to_take", "island_id": 6, "scores": {"3": -1}}
