{"timestamp": "2025-09-06T11:25:41.952556", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Get primitives required to craft the item\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  \n  actions = []\n  \n  # Check if we have all the primitives needed in our inventory\n  for primitive, count in primitives_needed.items():\n    current_count = env._current_state.inventory[primitive]\n    \n    # If we don't have enough of this primitive, we need to collect more\n    if current_count < count:\n      actions.extend(collect_v2(env, primitive))\n  \n  # Assuming we have all primitives, go to the workshop and craft the item\n  workshop_index = env.world.cookbook.recipes[item_index].get(\"_key\", None)\n  \n  if workshop_index is not None:\n    # Find position of the nearest workshop of the required type\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index])\n    \n    if len(workshop_positions) == 0:\n      return []  # No available workshop\n    \n    # Choose the closest workshop\n    current_pos = env._current_state.pos\n    closest_workshop = min(workshop_positions, key=lambda pos: np.linalg.norm(np.array(pos) - np.array(current_pos)))\n    \n    # Move to the closest workshop\n    actions.extend(move_to_position(env, closest_workshop))\n    \n    # Use the workshop to craft the item\n    actions.append(craft.USE)\n  \n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-06T11:30:39.473110", "function_name": "craft", "function_body": "  ACTION_UP = env.world.n_actions - 4 + 0\n  ACTION_DOWN = env.world.n_actions - 4 + 2\n  ACTION_LEFT = env.world.n_actions - 4 + 1\n  ACTION_RIGHT = env.world.n_actions - 4 + 3\n  ACTION_USE = env.world.n_actions - 1\n\n  def move_to_position(target_x, target_y):\n    \"\"\"Helper function to generate actions to move to a specific position.\"\"\"\n    actions = []\n    pos_x, pos_y = env._current_state.pos\n    \n    while pos_x != target_x or pos_y != target_y:\n      dx = target_x - pos_x\n      dy = target_y - pos_y\n      \n      if abs(dx) > abs(dy):\n        actions.append(ACTION_LEFT if dx < 0 else ACTION_RIGHT)\n      else:\n        actions.append(ACTION_DOWN if dy < 0 else ACTION_UP)\n      \n      pos_x += (-1 if dx < 0 else 1) if abs(dx) > abs(dy) else 0\n      pos_y += (-1 if dy < 0 else 1) if abs(dx) <= abs(dy) else 0\n    \n    return actions\n\n  def move_to_workshop(workshop_index):\n    \"\"\"Helper function to generate actions to move to a workshop.\"\"\"\n    target_positions = np.where(env._current_state.grid[:, :, workshop_index] > 0)\n    \n    if len(target_positions[0]) == 0 or len(target_positions[1]) == 0:\n      return None\n    \n    closest_workshop_pos = find_closest_target(target_positions)\n    \n    if closest_workshop_pos is not None:\n        tx, ty = closest_workshop_pos\n        actions = move_to_position(tx, ty)\n        return actions\n\n  def pick_up_primitives(primitive_index):\n    \"\"\"Helper function to generate actions to pick up primitives.\"\"\"\n    target_positions = np.where(env._current_state.grid[:, :, primitive_index] > 0)\n    \n    if len(target_positions[0]) == 0 or len(target_positions[1]) == 0:\n      return None\n    \n    closest_primitive_pos = find_closest_target(target_positions)\n    \n    if closest_primitive_pos is not None:\n        tx, ty = closest_primitive_pos\n        actions = move_to_position(tx, ty)\n        actions.append(ACTION_USE)  # Assuming USE is always the last action to collect primitive\n        return actions\n\n  def use_workshop(workshop_index):\n    \"\"\"Helper function to generate actions to use a workshop.\"\"\"\n    target_positions = np.where(env._current_state.grid[:, :, workshop_index] > 0)\n    \n    if len(target_positions[0]) == 0 or len(target_positions[1]) == 0:\n      return None\n    \n    closest_workshop_pos = find_closest_target(target_positions)\n    \n    if closest_workshop_pos is not None:\n        tx, ty = closest_workshop_pos\n        actions = move_to_position(tx, ty)\n        actions.append(ACTION_USE)  # Assuming USE is always the last action to craft item\n        return actions\n\n  def find_closest_target(target_positions):\n      \"\"\"Helper function to find the closest target position.\"\"\"\n      pos_x, pos_y = env._current_state.pos\n      \n      min_distance = float('inf')\n      closest_pos = None\n      \n      for tx, ty in zip(*target_positions):\n          distance = abs(tx - pos_x) + abs(ty - pos_y)\n          if distance < min_distance:\n              min_distance = distance\n              closest_pos = (tx, ty)\n      \n      return closest_pos\n\n  def get_primitives_needed(item_index):\n    \"\"\"Helper function to get the primitives needed for crafting an item.\"\"\"\n    primitives_needed = env.world.cookbook.primitives_for(item_index)\n    \n    # Check if any of the required primitives are non-primitive items\n    non_primitive_items = [prim for prim, count in primitives_needed.items() if not is_primitive(prim)]\n    \n    return primitives_needed, non_primitive_items\n\n  def is_primitive(index):\n    \"\"\"Helper function to check if an item index is a primitive.\"\"\"\n    return index not in env.world.workshop_indices\n\n  actions = []\n  \n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Recursively resolve non-primitive items\n  primitives_needed, non_primitive_items = get_primitives_needed(item_index)\n  \n  while non_primitive_items:\n    non_prim = non_primitive_items.pop(0)\n    \n    # Craft the non-primitive item first\n    craft_actions = craft_v2(env, env.world.cookbook.index[non_prim])\n    \n    if not craft_actions:\n      return []  # If we can't craft a required non-primitive item, return empty list\n    \n    actions.extend(craft_actions)\n    \n    # Update the inventory after crafting\n    primitives_needed[non_prim] -= 1\n    if primitives_needed[non_prim] <= 0:\n      del primitives_needed[non_prim]\n    \n    # Re-check for non-primitives in case crafting the item provided more required items\n    primitives_needed, new_non_primitive_items = get_primitives_needed(item_index)\n    non_primitive_items.extend(new_non_primitive_items)\n\n  # Now we only have primitive items to collect\n  current_inventory = env._current_state.inventory\n\n  for prim, count in primitives_needed.items():\n    while current_inventory[prim] < count:\n      primitive_actions = pick_up_primitives(prim)\n      \n      if primitive_actions is not None:\n        actions.extend(primitive_actions)\n        current_inventory[prim] += 1\n      else:\n        return []  # If no source for the primitive, return empty list\n\n  # Find and use a workshop that has the required recipe\n  for i, workshop in enumerate(env.world.workshop_indices):\n    workshop_actions = move_to_workshop(workshop)\n    \n    if workshop_actions is not None:\n      actions.extend(workshop_actions)\n      \n      # Perform USE action to craft the item\n      actions.append(ACTION_USE)\n      break\n\n  return actions", "island_id": 2, "scores": {}}
{"timestamp": "2025-09-06T11:30:40.648520", "function_name": "craft", "function_body": "  ACTION_UP = env.world.n_actions - 4 + 0\n  ACTION_DOWN = env.world.n_actions - 4 + 2\n  ACTION_LEFT = env.world.n_actions - 4 + 1\n  ACTION_RIGHT = env.world.n_actions - 4 + 3\n  ACTION_USE = env.world.n_actions - 1\n\n  def move_to_position(target_x, target_y):\n    \"\"\"Helper function to generate actions to move to a specific position.\"\"\"\n    actions = []\n    pos_x, pos_y = env._current_state.pos\n    \n    while pos_x != target_x or pos_y != target_y:\n      dx = target_x - pos_x\n      dy = target_y - pos_y\n      \n      if abs(dx) > abs(dy):\n        actions.append(ACTION_LEFT if dx < 0 else ACTION_RIGHT)\n      else:\n        actions.append(ACTION_DOWN if dy < 0 else ACTION_UP)\n      \n      pos_x += (-1 if dx < 0 else 1) if abs(dx) > abs(dy) else 0\n      pos_y += (-1 if dy < 0 else 1) if abs(dx) <= abs(dy) else 0\n    \n    return actions\n\n  def move_to_workshop(workshop_index):\n    \"\"\"Helper function to generate actions to move to a workshop.\"\"\"\n    target_positions = np.where(env._current_state.grid[:, :, workshop_index] > 0)\n    \n    if len(target_positions[0]) == 0 or len(target_positions[1]) == 0:\n      return None\n    \n    closest_workshop_pos = find_closest_target(target_positions)\n    \n    if closest_workshop_pos is not None:\n        tx, ty = closest_workshop_pos\n        actions = move_to_position(tx, ty)\n        return actions\n\n  def pick_up_primitives(primitive_index):\n    \"\"\"Helper function to generate actions to pick up primitives.\"\"\"\n    target_positions = np.where(env._current_state.grid[:, :, primitive_index] > 0)\n    \n    if len(target_positions[0]) == 0 or len(target_positions[1]) == 0:\n      return None\n    \n    closest_primitive_pos = find_closest_target(target_positions)\n    \n    if closest_primitive_pos is not None:\n        tx, ty = closest_primitive_pos\n        actions = move_to_position(tx, ty)\n        actions.append(ACTION_USE)  # Assuming USE is always the last action to collect primitive\n        return actions\n\n  def use_workshop(workshop_index):\n    \"\"\"Helper function to generate actions to use a workshop.\"\"\"\n    target_positions = np.where(env._current_state.grid[:, :, workshop_index] > 0)\n    \n    if len(target_positions[0]) == 0 or len(target_positions[1]) == 0:\n      return None\n    \n    closest_workshop_pos = find_closest_target(target_positions)\n    \n    if closest_workshop_pos is not None:\n        tx, ty = closest_workshop_pos\n        actions = move_to_position(tx, ty)\n        actions.append(ACTION_USE)  # Assuming USE is always the last action to craft item\n        return actions\n\n  def find_closest_target(target_positions):\n      \"\"\"Helper function to find the closest target position.\"\"\"\n      pos_x, pos_y = env._current_state.pos\n      \n      min_distance = float('inf')\n      closest_pos = None\n      \n      for tx, ty in zip(*target_positions):\n          distance = abs(tx - pos_x) + abs(ty - pos_y)\n          if distance < min_distance:\n              min_distance = distance\n              closest_pos = (tx, ty)\n      \n      return closest_pos\n\n  def check_workshop_availability(workshop_index, primitives_needed):\n    \"\"\"Helper function to check if a workshop has the required recipe.\"\"\"\n    # Assuming each workshop can craft any item with the correct primitives in inventory\n    return True\n\n  actions = []\n  \n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all required primitives for crafting the item\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  current_inventory = env._current_state.inventory\n\n  # Collect missing primitives\n  for prim, count in primitives_needed.items():\n    while current_inventory[prim] < count:\n      primitive_actions = pick_up_primitives(prim)\n      \n      if primitive_actions is not None:\n        actions.extend(primitive_actions)\n        current_inventory[prim] += 1\n      else:\n        return []  # If no source for the primitive, return empty list\n\n  # Find and use a workshop that has the required recipe\n  workshop_used = False\n  for i, workshop in enumerate(env.world.workshop_indices):\n    if check_workshop_availability(workshop, primitives_needed):\n      workshop_actions = move_to_workshop(workshop)\n      \n      if workshop_actions is not None:\n        actions.extend(workshop_actions)\n        \n        # Perform USE action to craft the item\n        actions.append(ACTION_USE)\n        workshop_used = True\n        break\n\n  return actions if workshop_used else []", "island_id": 2, "scores": {"3": 2.0}}
{"timestamp": "2025-09-06T11:35:23.361442", "function_name": "craft", "function_body": "  ACTION_UP = env.world.n_actions - 4 + 0\n  ACTION_DOWN = env.world.n_actions - 4 + 2\n  ACTION_LEFT = env.world.n_actions - 4 + 1\n  ACTION_RIGHT = env.world.n_actions - 4 + 3\n  ACTION_USE = env.world.n_actions - 1\n\n  def move_to_position(target_x, target_y):\n    \"\"\"Helper function to generate actions to move to a specific position.\"\"\"\n    actions = []\n    pos_x, pos_y = env._current_state.pos\n    \n    while pos_x != target_x or pos_y != target_y:\n      dx = target_x - pos_x\n      dy = target_y - pos_y\n      \n      if abs(dx) > abs(dy):\n        actions.append(ACTION_LEFT if dx < 0 else ACTION_RIGHT)\n      else:\n        actions.append(ACTION_DOWN if dy < 0 else ACTION_UP)\n      \n      pos_x += (-1 if dx < 0 else 1) if abs(dx) > abs(dy) else 0\n      pos_y += (-1 if dy < 0 else 1) if abs(dx) <= abs(dy) else 0\n    \n    return actions\n\n  def find_closest_target(target_positions):\n    \"\"\"Helper function to find the closest target position.\"\"\"\n    pos_x, pos_y = env._current_state.pos\n    \n    min_distance = float('inf')\n    closest_pos = None\n    \n    for tx, ty in zip(*target_positions):\n        distance = abs(tx - pos_x) + abs(ty - pos_y)\n        if distance < min_distance:\n            min_distance = distance\n            closest_pos = (tx, ty)\n    \n    return closest_pos\n\n  def pick_up_primitives(primitive_index, count):\n    \"\"\"Helper function to generate actions to pick up primitives.\"\"\"\n    actions = []\n    \n    while current_inventory[primitive_index] < count:\n      primitive_positions = np.where(env._current_state.grid[:, :, primitive_index] > 0)\n      \n      if not primitive_positions[0].size:\n        return []  # No primitives found, return empty list\n      \n      closest_primitive_pos = find_closest_target(primitive_positions)\n      \n      if closest_primitive_pos is None:\n        return []  # If no source for the primitive, return empty list\n      \n      tx, ty = closest_primitive_pos\n      primitive_actions = move_to_position(tx, ty)\n      actions.extend(primitive_actions)\n      \n      # Perform USE action to collect the primitive\n      actions.append(ACTION_USE)\n      current_inventory[primitive_index] += 1\n    \n    return actions\n\n  def use_workshop(workshop_index):\n    \"\"\"Helper function to generate actions to use a workshop.\"\"\"\n    target_pos_x, target_pos_y = np.where(env._current_state.grid[:, :, workshop_index] > 0)\n    \n    if len(target_pos_x) == 0 or len(target_pos_y) == 0:\n      return None\n    \n    # Move towards the nearest workshop and perform USE action\n    closest_workshop_pos = find_closest_target((target_pos_x, target_pos_y))\n    \n    actions = move_to_position(closest_workshop_pos[0], closest_workshop_pos[1])\n    actions.append(ACTION_USE)  # Assuming USE is always the last action to craft item\n    \n    return actions\n\n  def get_primitives_needed(item_index):\n      \"\"\"Helper function to get primitives needed for an item.\"\"\"\n      return env.world.cookbook.primitives_for(item_index)\n\n  actions = []\n  \n  # Get the index of the desired item\n  if item not in env.world.cookbook.index:\n    return []  # Return empty list if item is not in cookbook\n  \n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all required primitives for crafting the item\n  primitives_needed = get_primitives_needed(item_index)\n  current_inventory = env._current_state.inventory\n\n  # Collect missing primitives\n  for prim, count in primitives_needed.items():\n    primitive_actions = pick_up_primitives(prim, count)\n    actions.extend(primitive_actions)\n\n  # Find and use a workshop that has the required recipe\n  found_workshop = False\n  for i, workshop in enumerate(env.world.workshop_indices):\n    if env._current_state.grid[:, :, workshop].any():  # Check if there's at least one workshop of this type\n      actions_from_workshop = use_workshop(workshop)\n      \n      if actions_from_workshop:\n        actions.extend(actions_from_workshop)\n        found_workshop = True\n        break\n\n  if not found_workshop:\n    return []  # Return empty list if no suitable workshop is found\n\n  return actions", "island_id": 8, "scores": {"3": 2.0}}
{"timestamp": "2025-09-06T11:35:24.425081", "function_name": "craft", "function_body": "  ACTION_UP = env.world.n_actions - 4 + 0\n  ACTION_DOWN = env.world.n_actions - 4 + 2\n  ACTION_LEFT = env.world.n_actions - 4 + 1\n  ACTION_RIGHT = env.world.n_actions - 4 + 3\n  ACTION_USE = env.world.n_actions - 1\n\n  def move_to_position(target_x, target_y):\n    \"\"\"Helper function to generate actions to move to a specific position.\"\"\"\n    actions = []\n    pos_x, pos_y = env._current_state.pos\n    \n    while pos_x != target_x or pos_y != target_y:\n      dx = target_x - pos_x\n      dy = target_y - pos_y\n      \n      if abs(dx) > abs(dy):\n        actions.append(ACTION_LEFT if dx < 0 else ACTION_RIGHT)\n      else:\n        actions.append(ACTION_DOWN if dy < 0 else ACTION_UP)\n      \n      pos_x += (-1 if dx < 0 else 1) if abs(dx) > abs(dy) else 0\n      pos_y += (-1 if dy < 0 else 1) if abs(dx) <= abs(dy) else 0\n    \n    return actions\n\n  def find_closest_target(target_positions):\n    \"\"\"Helper function to find the closest target position.\"\"\"\n    pos_x, pos_y = env._current_state.pos\n    \n    min_distance = float('inf')\n    closest_pos = None\n    \n    for tx, ty in zip(*target_positions):\n        distance = abs(tx - pos_x) + abs(ty - pos_y)\n        if distance < min_distance:\n            min_distance = distance\n            closest_pos = (tx, ty)\n    \n    return closest_pos\n\n  def pick_up_primitives(primitive_index, count):\n    \"\"\"Helper function to generate actions to pick up primitives.\"\"\"\n    actions = []\n    current_inventory = env._current_state.inventory\n    \n    while current_inventory[primitive_index] < count:\n      primitive_positions = np.where(env._current_state.grid[:, :, primitive_index] > 0)\n      \n      if not primitive_positions[0].size:\n          return []  # No primitives found, return empty list\n      \n      closest_primitive_pos = find_closest_target(primitive_positions)\n      \n      if closest_primitive_pos is None:\n        return []  # If no source for the primitive, return empty list\n      \n      tx, ty = closest_primitive_pos\n      primitive_actions = move_to_position(tx, ty)\n      actions.extend(primitive_actions)\n      \n      # Perform USE action to collect the primitive\n      actions.append(ACTION_USE)\n      current_inventory[primitive_index] += 1\n    \n    return actions\n\n  def use_workshop(workshop_index):\n    \"\"\"Helper function to generate actions to use a workshop.\"\"\"\n    target_pos_x, target_pos_y = np.where(env._current_state.grid[:, :, workshop_index] > 0)\n    \n    if len(target_pos_x) == 0 or len(target_pos_y) == 0:\n      return None\n    \n    # Move towards the nearest workshop and perform USE action\n    actions = []\n    for tx, ty in zip(*workshop_positions):\n        actions.extend(move_to_position(tx, ty))\n        actions.append(ACTION_USE)\n    \n    return actions\n\n  def get_primitives_needed(item_index):\n      \"\"\"Helper function to get primitives needed for an item.\"\"\"\n      return env.world.cookbook.primitives_for(item_index)\n\n  actions = []\n  \n  # Get the index of the desired item\n  if item not in env.world.cookbook.index:\n    return []  # Return empty list if item is not in cookbook\n  \n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all required primitives for crafting the item\n  primitives_needed = get_primitives_needed(item_index)\n  current_inventory = env._current_state.inventory\n\n  # Collect missing primitives\n  for prim, count in primitives_needed.items():\n    primitive_actions = pick_up_primitives(prim, count)\n    actions.extend(primitive_actions)\n\n  # Find and use a workshop that has the required recipe\n  found_workshop = False\n  for i, workshop in enumerate(env.world.workshop_indices):\n    if env._current_state.grid[:, :, workshop].any():  # Check if there's at least one workshop of this type\n      workshop_positions = np.where(env._current_state.grid[:, :, workshop] > 0)\n      \n      # Try each workshop found\n      for tx, ty in zip(*workshop_positions):\n          actions.extend(move_to_position(tx, ty))\n          actions.append(ACTION_USE)  # Assuming USE is always the last action to craft item\n          found_workshop = True\n          break\n      \n    if found_workshop:\n        break\n\n  if not found_workshop:\n    return []  # Return empty list if no suitable workshop is found\n\n  return actions", "island_id": 8, "scores": {"3": 2.0}}
{"timestamp": "2025-09-06T11:37:38.966670", "function_name": "craft", "function_body": "  # Get the index of the item we want to craft\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the primitives required for crafting\n  if not env.world.cookbook.primitives_for(item_index):\n    return []\n\n  # List to hold actions\n  actions = []\n\n  # Go to a workshop (assuming first one is available)\n  workshop_index = env.world.workshop_indices[0]\n  \n  # Placeholder function to find the path to the workshop\n  def find_path_to_workshop(env, target_pos):\n      return []  # This should be replaced with an actual pathfinding algorithm\n\n  # Get position of a workshop (assuming we can get it from somewhere)\n  # For now, let's assume we have some way to determine this.\n  workshop_position = (0, 0)  # This should be the actual position of the workshop\n  \n  # Find path to the workshop\n  path_to_workshop = find_path_to_workshop(env, workshop_position)\n  actions.extend(path_to_workshop)\n\n  # Use action at the workshop\n  actions.append(craft.USE)\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-06T11:37:40.032260", "function_name": "craft", "function_body": "  # Retrieve the index for the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the primitives required to craft the item\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n  inventory_counts = collections.Counter(env._current_state.inventory)\n\n  # If any primitive is missing, return an empty action list\n  for prim_idx, count in primitives_required.items():\n      if inventory_counts.get(prim_idx, 0) < count:\n          return []\n\n  actions = []\n  \n  # Move to the workshop specified in the recipe (assuming there's a single workshop)\n  workshop_index = env.world.workshop_indices[0]\n  workshop_pos = None\n\n  for i in range(env.world.grid.shape[0]):\n      for j in range(env.world.grid.shape[1]):\n          if np.any(env.world.grid[i, j] == workshop_index):\n              workshop_pos = (i, j)\n              break\n      if workshop_pos:\n          break\n  \n  # If no workshop is found, return an empty action list\n  if not workshop_pos:\n      return []\n\n  # Calculate the path to the workshop (assuming a simple BFS for now)\n  from collections import deque\n\n  def bfs(start, end):\n      queue = deque([start])\n      visited = set()\n      parent = {start: None}\n\n      while queue:\n          current = queue.popleft()\n          if current == end:\n              path = []\n              while current is not None:\n                  path.append(current)\n                  current = parent[current]\n              return path[::-1]\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = current[0] + dx, current[1] + dy\n              if 0 <= nx < env.world.grid.shape[0] and 0 <= ny < env.world.grid.shape[1]:\n                  neighbor = (nx, ny)\n                  if neighbor not in visited:\n                      queue.append(neighbor)\n                      visited.add(neighbor)\n                      parent[neighbor] = current\n\n      return None\n\n  path_to_workshop = bfs(env._current_state.pos, workshop_pos)\n\n  # If no path to the workshop is found, return an empty action list\n  if not path_to_workshop:\n      return []\n\n  # Convert path to actions (UP, DOWN, LEFT, RIGHT)\n  action_map = {(-1, 0): craft.MOVE_FUNC(craft.UP), (1, 0): craft.MOVE_FUNC(craft.DOWN),\n                (0, -1): craft.MOVE_FUNC(craft.LEFT), (0, 1): craft.MOVE_FUNC(craft.RIGHT)}\n\n  for i in range(1, len(path_to_workshop)):\n      dx = path_to_workshop[i][0] - path_to_workshop[i-1][0]\n      dy = path_to_workshop[i][1] - path_to_workshop[i-1][1]\n      action = action_map.get((dx, dy))\n      if action:\n          actions.append(action)\n\n  # Add the USE action to craft the item\n  actions.append(craft.CRAFT_FUNC(item_index))\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T11:38:43.311375", "function_name": "craft", "function_body": "  def can_craft(item_index):\n    required_primitives = cookbook.primitives_for(item_index)\n    for primitive, count in required_primitives.items():\n      if env._current_state.inventory[primitive] < count:\n        return False\n    return True\n\n  actions = []\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n  \n  # Check if we can craft the item\n  if not can_craft(goal_index):\n    return []  # Not enough primitives to craft the item\n  \n  # Find a workshop to perform crafting\n  recipe = cookbook.recipes.get(goal_index, {})\n  workshop_indices = [ingredient for ingredient, _ in recipe.items() if ingredient in env.world.workshop_indices]\n  \n  if not workshop_indices:\n    return []  # No suitable workshops found\n\n  # Determine the nearest workshop\n  nearest_workshop = find_nearest_workshop(env._current_state.grid, env._current_state.pos, workshop_indices)\n\n  # Navigate to the nearest workshop\n  actions.extend(navigate_to_workshop(env._current_state.grid, env._current_state.pos, nearest_workshop))\n\n  # Perform USE action at the workshop to craft the item\n  actions.append(env.world.N_ACTIONS - 1)  # Assuming USE is the last action index (N_ACTIONS - 1)\n\n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T11:38:44.361981", "function_name": "craft", "function_body": "  actions = []\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n  \n  # Check if we have all required primitives in our inventory\n  required_primitives = cookbook.primitives_for(goal_index)\n  for primitive, count in required_primitives.items():\n    if env._current_state.inventory[primitive] < count:\n      return []  # Not enough primitives to craft the item\n\n  # Find a workshop to perform crafting\n  recipe = cookbook.recipes.get(goal_index, {})\n  workshop_indices = [ingredient for ingredient, _ in recipe.items() if ingredient in env.world.workshop_indices]\n  \n  if not workshop_indices:\n    return []  # No suitable workshops found\n\n  # Determine the nearest workshop\n  nearest_workshop = find_nearest_workshop(env._current_state.grid, env._current_state.pos, workshop_indices)\n\n  # Navigate to the nearest workshop\n  actions.extend(navigate_to_workshop(env, nearest_workshop))\n\n  # Perform USE action at the workshop to craft the item\n  actions.append(env.world.N_ACTIONS - 1)  # Assuming USE is the last action index (N_ACTIONS - 1)\n\n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T11:39:49.436783", "function_name": "craft", "function_body": "  # Extract the index for the desired item\n  item_index = env.world.cookbook.index[item]\n\n  if not env.world.cookbook.recipes.get(item_index):\n    print(f\"No recipe found for {item}.\")\n    return []\n\n  actions = []\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n\n  # Collect all primitives needed\n  for primitive, count in primitives_needed.items():\n      for _ in range(count):\n          actions.extend(collect(env, env.world.cookbook.index.get(primitive)))\n\n  # Move to the workshop and craft the item\n  if \"workshop\" in env.world.cookbook.recipes[item_index]:\n      workshop = env.world.cookbook.recipes[item_index][\"_key\"]\n      workshop_index = int(workshop[-1])\n      actions.extend(move_to_workshop(env, workshop_index))\n  \n  # Perform the USE action to craft the item\n  actions.append(craft.USE)\n\n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-06T11:39:50.427407", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index of the item we want to craft\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all primitives required for crafting\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  \n  # If no primitives are needed, return an empty list\n  if not primitives_needed:\n    print(\"No primitives needed or item unknown.\")\n    return actions\n\n  # Collect the primitives needed\n  for primitive_index, count in primitives_needed.items():\n    primitive_name = env.world.cookbook.index.get(primitive_index)\n    if primitive_name is None:\n      continue\n    \n    # Collect the required amount of this primitive\n    while env._current_state.inventory[primitive_index] < count:\n      actions.extend(collect_v2(env, primitive_name))\n  \n  # Go to the workshop and use it to craft the item\n  # Assuming there's only one type of workshop in simple scenarios\n  workshop_index = env.world.workshop_indices[0]\n  \n  # Move to a cell next to the workshop\n  actions.extend(find_path_to_item(env, workshop_index))\n  \n  # Use the workshop to craft the item\n  actions.append(craft.ENV_ACTION_USE)\n\n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-06T11:41:54.586067", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the primitives required for crafting the item\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  \n  actions_to_take = []\n\n  # Collect missing primitives if necessary\n  for primitive, count in primitives_needed.items():\n    # Get the name of the primitive from its index\n    primitive_name = env.world.cookbook.index.get(primitive, \"unknown\")\n    \n    # If the primitive is not in our inventory, we need to collect it\n    if env._current_state.inventory[primitive] < count:\n      # Collect the required amount of primitives\n      actions_to_take.extend(collect_v2(env, primitive_name, count))\n  \n  # Go to the workshop and perform the USE action to craft the item\n  workshop_index = next(workshop for workshop in env.world.workshop_indices if env._current_state.next_to(workshop))\n  actions_to_take.append(env.world.cookbook.index[env.world.cookbook.index.get('USE', 'UNKNOWN')])\n  \n  return actions_to_take", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-06T11:41:55.558677", "function_name": "craft", "function_body": "  # Initialize actions list\n  actions = []\n  \n  # Get the index of the item to be crafted\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the ingredients for the recipe\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  \n  # Collect all needed primitives\n  for primitive, count in primitives_needed.items():\n    actions.extend(collect_v2(env, primitive))\n    \n    # If the collection fails (returns an empty list), return empty action list\n    if not actions:\n      return []\n    \n    # Verify if we have collected enough of the primitive\n    while env._current_state.inventory[primitive] < count:\n      actions.extend(collect_v2(env, primitive))\n      \n  # Get the recipe for the item to be crafted\n  recipe = env.world.cookbook.recipes[item_index]\n  \n  # Find a workshop that can craft this item (assuming \"_key\" is not needed here)\n  available_workshops = [workshop for workshop in env.world.workshop_indices if workshop in recipe]\n  \n  if not available_workshops:\n    return []\n  \n  # Choose the first available workshop\n  target_workshop_index = available_workshops[0]\n  \n  # Get the position of the target workshop from the grid (assuming we have a way to find it)\n  # For simplicity, let's assume the grid has a function to find the nearest entity by type\n  def find_nearest_entity(grid, index):\n    for y in range(grid.shape[1]):\n      for x in range(grid.shape[0]):\n        if np.any(grid[x, y] == index):\n          return (x, y)\n    return None\n  \n  target_workshop_pos = find_nearest_entity(env._current_state.grid, target_workshop_index)\n  \n  if not target_workshop_pos:\n    return []\n  \n  # Calculate the path to the target workshop\n  def calculate_path(start_pos, end_pos):\n    # Placeholder for A* or any other pathfinding algorithm\n    return [(1, 0), (2, 0)]  # Example hardcoded path\n  \n  path_to_workshop = calculate_path(env._current_state.pos, target_workshop_pos)\n  \n  # Convert the path to actions\n  def path_to_actions(path, start_pos):\n    actions = []\n    x, y = start_pos\n    for dx, dy in path:\n      if (x + dx, y + dy) == (env.world.WIDTH - 1, env.world.HEIGHT - 1):  # Example condition to break the loop\n        break\n      if dx > 0:\n        actions.append(env.world.ACTIONS.RIGHT)\n      elif dx < 0:\n        actions.append(env.world.ACTIONS.LEFT)\n      elif dy > 0:\n        actions.append(env.world.ACTIONS.DOWN)\n      elif dy < 0:\n        actions.append(env.world.ACTIONS.UP)\n      x += dx\n      y += dy\n    return actions\n  \n  actions.extend(path_to_actions(path_to_workshop, env._current_state.pos))\n  \n  # Add the USE action to craft the item at the workshop\n  actions.append(env.world.ACTIONS.USE)\n  \n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-06T11:46:15.326324", "function_name": "craft", "function_body": "  def find_all_positions_of_kind(grid: np.ndarray, kind_index: int):\n    positions = []\n    for y in range(grid.shape[0]):\n      for x in range(grid.shape[1]):\n        if grid[y, x, kind_index] > 0:\n          positions.append((x, y))\n    return positions\n\n  def distance(pos1: tuple, pos2: tuple) -> int:\n    \"\"\"Calculate the Manhattan distance between two positions.\"\"\"\n    return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n\n  def move_to_position(current_pos: tuple, target_pos: tuple) -> list[int]:\n    \"\"\"Generate a sequence of actions to move from current position to target position.\"\"\"\n    actions = []\n    current_x, current_y = current_pos\n    target_x, target_y = target_pos\n    \n    # Move vertically first\n    while current_y < target_y:\n        actions.append(0)  # DOWN\n        current_y += 1\n    while current_y > target_y:\n        actions.append(1)  # UP\n        current_y -= 1\n    \n    # Then move horizontally\n    while current_x < target_x:\n        actions.append(2)  # LEFT\n        current_x += 1\n    while current_x > target_x:\n        actions.append(3)  # RIGHT\n        current_x -= 1\n    \n    return actions\n\n  def collect_primitive(env, primitive: int) -> list[int]:\n    \"\"\"Generate a sequence of actions to collect the required primitive.\"\"\"\n    grid = env._current_state.grid\n    positions = find_all_positions_of_kind(grid, primitive)\n    \n    if not positions:\n        return []\n    \n    nearest_position = min(positions, key=lambda pos: distance(env._current_state.pos, pos))\n    path_to_primitive = move_to_position(env._current_state.pos, nearest_position)\n    return path_to_primitive + [4]  # Add USE action to collect the primitive\n\n  def find_workshop_index_for_item(item_index: int, cookbook):\n      \"\"\"Find the workshop index required for crafting an item.\"\"\"\n      recipe = cookbook.recipes[item_index]\n      workshop_key = recipe.get(\"_key\", None)\n      \n      if workshop_key is not None:\n          for key, value in cookbook.recipes.items():\n              if \"_key\" in value and value[\"_key\"] == workshop_key:\n                  return key\n      return None\n\n  def check_and_collect_primitives(env, primitives_needed):\n      actions = []\n      grid = env._current_state.grid\n      \n      for primitive, count in primitives_needed.items():\n          missing_count = count - env._current_state.inventory[primitive]\n          while missing_count > 0:\n              actions.extend(collect_primitive(env, primitive))\n              # Simulate the collection by updating inventory\n              env._current_state.inventory[primitive] += 1\n              missing_count -= 1\n      \n      return actions\n\n  def find_closest_workshop_position(grid: np.ndarray, workshop_index: int, current_pos: tuple):\n    positions = find_all_positions_of_kind(grid, workshop_index)\n    if not positions:\n        return None\n    nearest_position = min(positions, key=lambda pos: distance(current_pos, pos))\n    return nearest_position\n\n  actions = []\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  # Check if we have all the primitives required for crafting\n  primitives_needed = cookbook.primitives_for(item_index)\n  actions.extend(check_and_collect_primitives(env, primitives_needed))\n  \n  # Find the workshop index needed to craft the item\n  workshop_index = find_workshop_index_for_item(item_index, cookbook)\n\n  if workshop_index is not None:\n      grid = env._current_state.grid\n      nearest_workshop_pos = find_closest_workshop_position(grid, workshop_index, env._current_state.pos)\n      \n      if nearest_workshop_pos is not None:\n          actions.extend(move_to_position(env._current_state.pos, nearest_workshop_pos))\n          \n          # Use the workshop to craft the item\n          actions.append(4)  # USE action\n  \n  return actions", "island_id": 1, "scores": {"3": 0.49999994}}
{"timestamp": "2025-09-06T11:46:16.396671", "function_name": "craft", "function_body": "  def find_all_positions_of_kind(grid: np.ndarray, kind_index: int):\n    positions = []\n    for y in range(grid.shape[0]):\n      for x in range(grid.shape[1]):\n        if grid[y, x, kind_index] > 0:\n          positions.append((x, y))\n    return positions\n\n  def distance(pos1: tuple, pos2: tuple) -> int:\n    \"\"\"Calculate the Manhattan distance between two positions.\"\"\"\n    return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n\n  def move_to_position(current_pos: tuple, target_pos: tuple) -> list[int]:\n    \"\"\"Generate a sequence of actions to move from current position to target position.\"\"\"\n    actions = []\n    current_x, current_y = current_pos\n    target_x, target_y = target_pos\n    \n    # Move vertically first\n    while current_y < target_y:\n        actions.append(0)  # DOWN\n        current_y += 1\n    while current_y > target_y:\n        actions.append(1)  # UP\n        current_y -= 1\n    \n    # Then move horizontally\n    while current_x < target_x:\n        actions.append(2)  # LEFT\n        current_x += 1\n    while current_x > target_x:\n        actions.append(3)  # RIGHT\n        current_x -= 1\n    \n    return actions\n\n  def collect_primitive(env, primitive: int) -> list[int]:\n    \"\"\"Generate a sequence of actions to collect the required primitive.\"\"\"\n    grid = env._current_state.grid\n    primitive_positions = find_all_positions_of_kind(grid, primitive)\n    \n    if not primitive_positions:\n      # If no primitives are found, try to move to the nearest known position\n      return []\n    \n    nearest_primitive_pos = min(primitive_positions, key=lambda pos: distance(env._current_state.pos, pos))\n    actions_to_collect = move_to_position(env._current_state.pos, nearest_primitive_pos)\n    actions_to_collect.append(4)  # USE action to collect the primitive\n    \n    return actions_to_collect\n\n  def find_workshop_index_for_item(item_index: int, cookbook):\n      \"\"\"Find the workshop index required for crafting an item.\"\"\"\n      recipe = cookbook.recipes[item_index]\n      workshop_key = recipe.get(\"_key\", None)\n      \n      if workshop_key is not None:\n          for key, value in cookbook.recipes.items():\n              if \"_key\" in value and value[\"_key\"] == workshop_key:\n                  return key\n      return None\n\n  def find_closest_workshop_position(grid: np.ndarray, workshop_index: int, current_pos: tuple):\n    \"\"\"Find the closest position of a workshop to the current position.\"\"\"\n    workshop_positions = find_all_positions_of_kind(grid, workshop_index)\n    if not workshop_positions:\n        return None\n    nearest_workshop_pos = min(workshop_positions, key=lambda pos: distance(current_pos, pos))\n    return nearest_workshop_pos\n\n  actions = []\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the primitives required for crafting\n  cookbook = env.world.cookbook\n  primitives_needed = cookbook.primitives_for(item_index)\n  missing_primitives = {primitive: count - env._current_state.inventory[primitive] \n                        for primitive, count in primitives_needed.items() \n                        if count > env._current_state.inventory[primitive]}\n  \n  # Collect all missing primitives\n  for primitive, count in missing_primitives.items():\n    while count > 0:\n      actions.extend(collect_primitive(env, primitive))\n      count -= 1\n  \n  # Find the workshop index needed to craft the item\n  workshop_index = find_workshop_index_for_item(item_index, cookbook)\n  \n  if workshop_index is not None:\n    nearest_workshop_pos = find_closest_workshop_position(env._current_state.grid, workshop_index, env._current_state.pos)\n    \n    if nearest_workshop_pos is not None:\n      actions.extend(move_to_position(env._current_state.pos, nearest_workshop_pos))\n      \n      # Use the workshop to craft the item\n      actions.append(4)  # USE action\n  \n  return actions", "island_id": 1, "scores": {"3": 0.2}}
{"timestamp": "2025-09-06T11:50:17.556224", "function_name": "craft", "function_body": "  def find_all_positions_of_kind(grid: np.ndarray, kind_index: int):\n    positions = []\n    for y in range(grid.shape[0]):\n      for x in range(grid.shape[1]):\n        if grid[y, x, kind_index] > 0:\n          positions.append((x, y))\n    return positions\n\n  def distance(pos1: tuple, pos2: tuple) -> int:\n    \"\"\"Calculate the Manhattan distance between two positions.\"\"\"\n    return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n\n  def move_to_position(current_pos: tuple, target_pos: tuple) -> list[int]:\n    \"\"\"Generate a sequence of actions to move from current position to target position.\"\"\"\n    actions = []\n    current_x, current_y = current_pos\n    target_x, target_y = target_pos\n    \n    # Move vertically first\n    while current_y < target_y:\n        actions.append(0)  # DOWN\n        current_y += 1\n    while current_y > target_y:\n        actions.append(1)  # UP\n        current_y -= 1\n    \n    # Then move horizontally\n    while current_x < target_x:\n        actions.append(2)  # LEFT\n        current_x += 1\n    while current_x > target_x:\n        actions.append(3)  # RIGHT\n        current_x -= 1\n    \n    return actions\n\n  def collect_primitive(env, primitive: int) -> list[int]:\n    \"\"\"Generate a sequence of actions to collect the required primitive.\"\"\"\n    grid = env._current_state.grid\n    positions = find_all_positions_of_kind(grid, primitive)\n    \n    if not positions:\n        return []\n    \n    nearest_position = min(positions, key=lambda pos: distance(env._current_state.pos, pos))\n    path_to_primitive = move_to_position(env._current_state.pos, nearest_position)\n    return path_to_primitive + [4]  # Add USE action to collect the primitive\n\n  def find_workshop_index_for_item(item_index: int, cookbook):\n      \"\"\"Find the workshop index required for crafting an item.\"\"\"\n      recipe = cookbook.recipes[item_index]\n      workshop_key = recipe.get(\"_key\", None)\n      \n      if workshop_key is not None:\n          for key, value in cookbook.recipes.items():\n              if \"_key\" in value and value[\"_key\"] == workshop_key:\n                  return key\n      return None\n\n  def check_and_collect_primitives(env, primitives_needed):\n      actions = []\n      grid = env._current_state.grid\n      \n      for primitive, count in primitives_needed.items():\n          missing_count = count - env._current_state.inventory[primitive]\n          while missing_count > 0:\n              actions.extend(collect_primitive(env, primitive))\n              # Simulate the collection by updating inventory\n              env._current_state.inventory[primitive] += 1\n              missing_count -= 1\n      \n      return actions\n\n  def find_closest_workshop_position(grid: np.ndarray, workshop_index: int, current_pos: tuple):\n    positions = find_all_positions_of_kind(grid, workshop_index)\n    if not positions:\n        return None\n    nearest_position = min(positions, key=lambda pos: distance(current_pos, pos))\n    return nearest_position\n\n  def check_and_collect_primitives_optimized(env, primitives_needed):\n      actions = []\n      grid = env._current_state.grid\n      \n      for primitive, count in primitives_needed.items():\n          missing_count = count - env._current_state.inventory[primitive]\n          if missing_count > 0:\n              positions = find_all_positions_of_kind(grid, primitive)\n              if not positions:\n                  return []  # If no position found, we can't collect the required primitives\n              \n              nearest_position = min(positions, key=lambda pos: distance(env._current_state.pos, pos))\n              path_to_primitive = move_to_position(env._current_state.pos, nearest_position)\n              actions.extend(path_to_primitive + [4])  # Add USE action to collect the primitive\n              \n              # Simulate the collection by updating inventory\n              env._current_state.inventory[primitive] += 1\n              missing_count -= 1\n      \n      return actions\n\n  def craft_item(env, item_index: int) -> list[int]:\n      cookbook = env.world.cookbook\n      primitives_needed = cookbook.primitives_for(item_index)\n      \n      # Check and collect all required primitives\n      actions = check_and_collect_primitives_optimized(env, primitives_needed)\n      \n      if not actions:\n          return []  # If no actions were generated, we can't proceed to craft the item\n      \n      workshop_index = find_workshop_index_for_item(item_index, cookbook)\n      if workshop_index is None:\n          return []  # No workshop found for this item\n      \n      grid = env._current_state.grid\n      nearest_workshop_pos = find_closest_workshop_position(grid, workshop_index, env._current_state.pos)\n      \n      if nearest_workshop_pos is not None:\n          actions.extend(move_to_position(env._current_state.pos, nearest_workshop_pos))\n          \n          # Use the workshop to craft the item\n          actions.append(4)  # USE action\n      \n      return actions\n\n  item_index = env.world.cookbook.index[item]\n  return craft_item(env, item_index)", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T11:50:18.631914", "function_name": "craft", "function_body": "  def find_all_positions_of_kind(grid: np.ndarray, kind_index: int):\n    positions = []\n    for y in range(grid.shape[0]):\n      for x in range(grid.shape[1]):\n        if grid[y, x, kind_index] > 0:\n          positions.append((x, y))\n    return positions\n\n  def distance(pos1: tuple, pos2: tuple) -> int:\n    \"\"\"Calculate the Manhattan distance between two positions.\"\"\"\n    return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n\n  def move_to_position(current_pos: tuple, target_pos: tuple) -> list[int]:\n    \"\"\"Generate a sequence of actions to move from current position to target position.\"\"\"\n    actions = []\n    current_x, current_y = current_pos\n    target_x, target_y = target_pos\n    \n    # Move vertically first\n    while current_y < target_y:\n        actions.append(0)  # DOWN\n        current_y += 1\n    while current_y > target_y:\n        actions.append(1)  # UP\n        current_y -= 1\n    \n    # Then move horizontally\n    while current_x < target_x:\n        actions.append(2)  # LEFT\n        current_x += 1\n    while current_x > target_x:\n        actions.append(3)  # RIGHT\n        current_x -= 1\n    \n    return actions\n\n  def collect_primitive(env, primitive: int) -> list[int]:\n    \"\"\"Generate a sequence of actions to collect the required primitive.\"\"\"\n    grid = env._current_state.grid\n    positions = find_all_positions_of_kind(grid, primitive)\n    \n    if not positions:\n        return []\n    \n    nearest_position = min(positions, key=lambda pos: distance(env._current_state.pos, pos))\n    path_to_primitive = move_to_position(env._current_state.pos, nearest_position)\n    return path_to_primitive + [4]  # Add USE action to collect the primitive\n\n  def find_workshop_index_for_item(item_index: int, cookbook):\n      \"\"\"Find the workshop index required for crafting an item.\"\"\"\n      recipe = cookbook.recipes[item_index]\n      workshop_key = recipe.get(\"_key\", None)\n      \n      if workshop_key is not None:\n          for key, value in cookbook.recipes.items():\n              if \"_key\" in value and value[\"_key\"] == workshop_key:\n                  return key\n      return None\n\n  def check_and_collect_primitives(env, primitives_needed):\n      actions = []\n      grid = env._current_state.grid\n      \n      for primitive, count in primitives_needed.items():\n          missing_count = count - env._current_state.inventory[primitive]\n          while missing_count > 0:\n              actions.extend(collect_primitive(env, primitive))\n              # Simulate the collection by updating inventory\n              env._current_state.inventory[primitive] += 1\n              missing_count -= 1\n      \n      return actions\n\n  def find_closest_workshop_position(grid: np.ndarray, workshop_index: int, current_pos: tuple):\n    positions = find_all_positions_of_kind(grid, workshop_index)\n    if not positions:\n        return None\n    nearest_position = min(positions, key=lambda pos: distance(current_pos, pos))\n    return nearest_position\n\n  def execute_actions_and_update_state(env, actions):\n      for action in actions:\n          _, done, _ = env.step(action)\n          if done:\n              break\n\n  actions = []\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  # Check if we have all the primitives required for crafting\n  primitives_needed = cookbook.primitives_for(item_index)\n  collection_actions = check_and_collect_primitives(env, primitives_needed)\n\n  execute_actions_and_update_state(env, collection_actions)  # Execute and update state\n  \n  # Find the workshop index needed to craft the item\n  workshop_index = find_workshop_index_for_item(item_index, cookbook)\n\n  if workshop_index is not None:\n      grid = env._current_state.grid\n      nearest_workshop_pos = find_closest_workshop_position(grid, workshop_index, env._current_state.pos)\n      \n      if nearest_workshop_pos is not None:\n          movement_actions = move_to_position(env._current_state.pos, nearest_workshop_pos)\n          actions.extend(movement_actions)\n          \n          # Use the workshop to craft the item\n          actions.append(4)  # USE action\n  \n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T11:52:48.095874", "function_name": "craft", "function_body": "  def move_to_pos(pos):\n      current_pos = env._current_state.pos\n      path = bfs(current_pos, pos)\n      if not path:\n          return []\n      \n      action_map = {(-1, 0): craft.MOVE_FUNC(craft.UP), (1, 0): craft.MOVE_FUNC(craft.DOWN),\n                    (0, -1): craft.MOVE_FUNC(craft.LEFT), (0, 1): craft.MOVE_FUNC(craft.RIGHT)}\n      \n      actions = []\n      for i in range(1, len(path)):\n          dx = path[i][0] - path[i-1][0]\n          dy = path[i][1] - path[i-1][1]\n          action = action_map.get((dx, dy))\n          if action:\n              actions.append(action)\n      return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the primitives required to craft the item\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n  inventory_counts = collections.Counter(env._current_state.inventory)\n\n  # If any primitive is missing, return an empty action list\n  for prim_idx, count in primitives_required.items():\n      if inventory_counts.get(prim_idx, 0) < count:\n          return []\n\n  actions = []\n  \n  # Find all workshops and their positions\n  workshop_positions = {}\n  for i in range(env.world.grid.shape[0]):\n      for j in range(env.world.grid.shape[1]):\n          kind = np.argmax(env.world.grid[i, j])\n          if kind in env.world.workshop_indices:\n              workshop_positions[kind] = (i, j)\n  \n  # If no workshops are found, return an empty action list\n  if not workshop_positions:\n      return []\n\n  # Determine which workshop to use based on the recipe\n  recipe = env.world.cookbook.recipes[item_index]\n  required_primitives = {prim_idx for prim_idx in primitives_required}\n  available_workshops = set(workshop_positions.keys())\n  \n  # Find a workshop that can craft the item\n  workshop_kind = None\n  for kind, pos in workshop_positions.items():\n      if kind in recipe or \"_key\" in recipe:\n          workshop_kind = kind\n          break\n  \n  if not workshop_kind:\n      return []\n\n  # Move to the chosen workshop\n  actions.extend(move_to_pos(workshop_positions[workshop_kind]))\n  \n  # Add the USE action to craft the item\n  actions.append(craft.CRAFT_FUNC(item_index))\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T11:52:49.138965", "function_name": "craft", "function_body": "  def get_next_workshop_pos(current_state):\n      workshop_indices = env.world.workshop_indices\n      for idx in workshop_indices:\n          for i in range(env.world.grid.shape[0]):\n              for j in range(env.world.grid.shape[1]):\n                  if np.any(env.world.grid[i, j] == idx):\n                      return (i, j)\n      return None\n\n  def bfs(start, end):\n      queue = collections.deque([start])\n      visited = set()\n      parent = {start: None}\n\n      while queue:\n          current = queue.popleft()\n          if current == end:\n              path = []\n              while current is not None:\n                  path.append(current)\n                  current = parent[current]\n              return path[::-1]\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = current[0] + dx, current[1] + dy\n              if 0 <= nx < env.world.grid.shape[0] and 0 <= ny < env.world.grid.shape[1]:\n                  neighbor = (nx, ny)\n                  if neighbor not in visited:\n                      queue.append(neighbor)\n                      visited.add(neighbor)\n                      parent[neighbor] = current\n\n      return None\n  \n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the primitives required to craft the item\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n  inventory_counts = collections.Counter(env._current_state.inventory)\n\n  # If any primitive is missing, return an empty action list\n  for prim_idx, count in primitives_required.items():\n      if inventory_counts.get(prim_idx, 0) < count:\n          return []\n\n  actions = []\n  \n  # Move to the workshop specified in the recipe (assuming there's a single workshop)\n  workshop_pos = get_next_workshop_pos(env._current_state)\n\n  # If no workshop is found, return an empty action list\n  if not workshop_pos:\n      return []\n\n  # Calculate the path to the workshop using BFS\n  path_to_workshop = bfs(env._current_state.pos, workshop_pos)\n\n  # If no path to the workshop is found, return an empty action list\n  if not path_to_workshop:\n      return []\n\n  # Convert path to actions (UP, DOWN, LEFT, RIGHT)\n  action_map = {(-1, 0): craft.MOVE_FUNC(craft.UP), (1, 0): craft.MOVE_FUNC(craft.DOWN),\n                (0, -1): craft.MOVE_FUNC(craft.LEFT), (0, 1): craft.MOVE_FUNC(craft.RIGHT)}\n\n  for i in range(1, len(path_to_workshop)):\n      dx = path_to_workshop[i][0] - path_to_workshop[i-1][0]\n      dy = path_to_workshop[i][1] - path_to_workshop[i-1][1]\n      action = action_map.get((dx, dy))\n      if action:\n          actions.append(action)\n\n  # Add the USE action to craft the item\n  actions.append(craft.CRAFT_FUNC(item_index))\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T11:56:44.832835", "function_name": "craft", "function_body": "  def navigate_to_workshop_actions(pos, target_pos):\n    dx = target_pos[0] - pos[0]\n    dy = target_pos[1] - pos[1]\n\n    actions = []\n    if dx > 0:\n        actions.extend([env.world.RIGHT for _ in range(abs(dx))])\n    elif dx < 0:\n        actions.extend([env.world.LEFT for _ in range(abs(dx))])\n\n    if dy > 0:\n        actions.extend([env.world.DOWN for _ in range(abs(dy))])\n    elif dy < 0:\n        actions.extend([env.world.UP for _ in range(abs(dy))])\n\n    return actions\n\n  def manhattan_distance(pos1, pos2):\n      return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n\n  def find_workshop_position(env, workshop_index):\n    grid = env._current_state.grid\n    positions = np.argwhere(grid[:, :, workshop_index] == 1)\n    if len(positions) > 0:\n        return tuple(positions[0])\n    else:\n        raise ValueError(f\"No position found for workshop index {workshop_index}\")\n\n  def find_workshops(env):\n      workshops = {}\n      grid = env._current_state.grid\n      for i in env.world.workshop_indices:\n          positions = np.argwhere(grid[:, :, i] == 1)\n          if len(positions) > 0:\n              workshops[i] = tuple(positions[0])\n      return workshops\n\n  def navigate_to_workshop(env, workshop_index):\n    target_pos = find_workshop_position(env, workshop_index)\n    current_pos = env._current_state.pos\n    path = a_star_search(current_pos, target_pos, env._current_state.grid)\n    actions = []\n    for next_step in path:\n      if next_step[0] > current_pos[0]:\n        actions.append(env.world.RIGHT)\n      elif next_step[0] < current_pos[0]:\n        actions.append(env.world.LEFT)\n      if next_step[1] > current_pos[1]:\n        actions.append(env.world.DOWN)\n      elif next_step[1] < current_pos[1]:\n        actions.append(env.world.UP)\n      current_pos = next_step\n    return actions\n\n  def heuristic(a, b):\n    return abs(b[0] - a[0]) + abs(b[1] - a[1])\n\n  def a_star_search(start, goal, grid):\n    open_set = collections.PriorityQueue()\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, goal)}\n    open_set.put((f_score[start], start))\n    \n    while not open_set.empty():\n      _, current = open_set.get()\n\n      if current == goal:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        return path[::-1]\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n          tentative_g_score = g_score[current] + 1\n          if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n            came_from[neighbor] = current\n            g_score[neighbor] = tentative_g_score\n            f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n            open_set.put((f_score[neighbor], neighbor))\n    \n    return []  # No path found\n\n  def collect_primitive(env, primitive_index):\n    actions = []\n    grid = env._current_state.grid\n    positions = np.argwhere(grid[:, :, primitive_index] == 1)\n    if len(positions) > 0:\n      closest_primitive_pos = min([(manhattan_distance(env._current_state.pos, tuple(pos)), tuple(pos)) for pos in positions])[1]\n      actions.extend(navigate_to_workshop_actions(env._current_state.pos, closest_primitive_pos))\n      actions.append(env.world.N_ACTIONS - 2)  # Assuming COLLECT is the second last action index (N_ACTIONS - 2)\n    return actions\n\n  actions = []\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  required_primitives = cookbook.primitives_for(goal_index)\n\n  for primitive, count in required_primitives.items():\n    while env._current_state.inventory[primitive] < count:\n      actions.extend(collect_primitive(env, primitive))\n\n  workshop_indices = [ingredient for ingredient in cookbook.recipes[goal_index].keys() \n                      if ingredient in env.world.workshop_indices and ingredient != \"_key\"]\n\n  if not workshop_indices:\n    return []  # No suitable workshop found\n\n  distances = {workshop: manhattan_distance(env._current_state.pos, find_workshop_position(env, workshop)) for workshop in workshop_indices}\n  closest_workshop_index = min(distances, key=distances.get)\n\n  actions.extend(navigate_to_workshop(env, closest_workshop_index))\n  \n  # Perform USE action at the workshop to craft the item\n  actions.append(env.world.N_ACTIONS - 1)  # Assuming USE is the last action index (N_ACTIONS - 1)\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-06T11:56:45.844243", "function_name": "craft", "function_body": "  def navigate_to_workshop(env, workshop_index):\n    target_pos = find_workshop_position(env, workshop_index)\n    current_pos = env._current_state.pos\n    path = a_star_search(current_pos, target_pos, env._current_state.grid)\n    actions = []\n    for next_step in path:\n      if next_step[0] > current_pos[0]:\n        actions.append(env.world.RIGHT)\n      elif next_step[0] < current_pos[0]:\n        actions.append(env.world.LEFT)\n      if next_step[1] > current_pos[1]:\n        actions.append(env.world.DOWN)\n      elif next_step[1] < current_pos[1]:\n        actions.append(env.world.UP)\n      current_pos = next_step\n    return actions\n\n  def find_workshop_position(env, workshop_index):\n    grid = env._current_state.grid\n    positions = np.argwhere(grid[:, :, workshop_index] == 1)\n    if len(positions) > 0:\n      return tuple(positions[0])\n    else:\n      raise ValueError(f\"No position found for workshop index {workshop_index}\")\n\n  def heuristic(a, b):\n    return abs(b[0] - a[0]) + abs(b[1] - a[1])\n\n  def a_star_search(start, goal, grid):\n    open_set = collections.PriorityQueue()\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, goal)}\n    open_set.put((f_score[start], start))\n    \n    while not open_set.empty():\n      _, current = open_set.get()\n\n      if current == goal:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        return path[::-1]\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n          tentative_g_score = g_score[current] + 1\n          if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n            came_from[neighbor] = current\n            g_score[neighbor] = tentative_g_score\n            f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n            open_set.put((f_score[neighbor], neighbor))\n    \n    return []  # No path found\n\n  def collect_primitives(env, primitives):\n    actions = []\n    for primitive, count in primitives.items():\n      while env._current_state.inventory[primitive] < count:\n        actions.extend(collect_primitive_actions(env, primitive))\n    return actions\n\n  def collect_primitive_actions(env, primitive_index):\n    # Find positions of the primitive on the grid\n    grid = env._current_state.grid\n    positions = np.argwhere(grid[:, :, primitive_index] == 1)\n    \n    if len(positions) == 0:\n      raise ValueError(f\"No position found for primitive index {primitive_index}\")\n    \n    # Sort primitives by distance to the nearest one\n    distances = {tuple(pos): heuristic(env._current_state.pos, tuple(pos)) for pos in positions}\n    closest_primitive_pos = min(distances, key=distances.get)\n    \n    # Navigate to the nearest primitive using A* search\n    path = a_star_search(env._current_state.pos, closest_primitive_pos, env._current_state.grid)\n    actions = []\n    current_pos = env._current_state.pos\n    for next_step in path:\n      if next_step[0] > current_pos[0]:\n        actions.append(env.world.RIGHT)\n      elif next_step[0] < current_pos[0]:\n        actions.append(env.world.LEFT)\n      if next_step[1] > current_pos[1]:\n        actions.append(env.world.DOWN)\n      elif next_step[1] < current_pos[1]:\n        actions.append(env.world.UP)\n      current_pos = next_step\n\n    # Perform USE action to collect the primitive\n    actions.append(env.world.N_ACTIONS - 1)  # Assuming USE is the last action index (N_ACTIONS - 1)\n\n    return actions\n\n  actions = []\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n  \n  # Check if we have all required primitives in our inventory\n  required_primitives = cookbook.primitives_for(goal_index)\n  missing_primitives = {k: v for k, v in required_primitives.items() \n                        if env._current_state.inventory[k] < v}\n  \n  # Collect missing primitives\n  actions.extend(collect_primitives(env, missing_primitives))\n  \n  # Find a workshop to perform crafting\n  recipe = cookbook.recipes.get(goal_index, {})\n  workshop_indices = [ingredient for ingredient in recipe.keys() \n                      if ingredient in env.world.workshop_indices and ingredient != \"_key\"]\n\n  if not workshop_indices:\n    return []  # No suitable workshop found\n  \n  # Sort workshops by distance to the nearest one\n  distances = {workshop: heuristic(env._current_state.pos, find_workshop_position(env, workshop)) for workshop in workshop_indices}\n  closest_workshop_index = min(distances, key=distances.get)\n  \n  # Navigate to the nearest workshop using A* search\n  actions.extend(navigate_to_workshop(env, closest_workshop_index))\n\n  # Perform USE action at the workshop to craft the item\n  actions.append(env.world.N_ACTIONS - 1)  # Assuming USE is the last action index (N_ACTIONS - 1)\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-06T11:58:00.924191", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index of the item to craft\n  item_index = env.world.cookbook.index[item]\n  \n  if item_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n  \n  # Check if we have all required primitives for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  \n  # If no recipe is available, return an empty action list\n  if not required_primitives:\n    return actions\n  \n  # Collect required primitives\n  for primitive_index, count in required_primitives.items():\n    primitive_name = env.world.cookbook.index.get(primitive_index)\n    \n    if primitive_name is None:\n      raise ValueError(f\"Unknown primitive index: {primitive_index}\")\n    \n    # Check if we already have the required amount of the primitive in our inventory\n    if env._current_state.inventory[primitive_index] >= count:\n      continue\n    \n    # Collect the required amount of the primitive\n    actions.extend(collect(env, primitive_name))\n    \n    # Check again after collection if we have enough of the primitive\n    if env._current_state.inventory[primitive_index] < count:\n      return []  # Failed to collect required primitives\n  \n  # Find a suitable workshop for crafting\n  for i_kind in env.world.workshop_indices:\n    if env._current_state.next_to(i_kind):\n      # Move to the workshop location and craft the item\n      actions.extend(move(env, (env._current_state.pos[0], env._current_state.pos[1])))\n      actions.append(craft.CRAFT_FUNC(env.cookbook.index[item]))\n      return actions\n  \n  # If no suitable workshop is found, return an empty action list\n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-06T11:58:01.932568", "function_name": "craft", "function_body": "  # First get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the primitives required for crafting the item\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  \n  # If we do not have any primitives, return an empty action list\n  if not required_primitives:\n    print(\"No recipe for this item or no primitives required.\")\n    return []\n  \n  actions = []\n\n  # Collect the required primitives if they are not already in inventory\n  for primitive_index, count in required_primitives.items():\n    # Check if the primitive is already in the inventory\n    if env._current_state.inventory[primitive_index] < count:\n      # If not, we need to collect it\n      primitive_name = env.world.cookbook.index.get(primitive_index, \"UNKNOWN\")\n      \n      # Collect the required amount of primitives\n      for _ in range(count - env._current_state.inventory[primitive_index]):\n        actions.extend(collect(env, primitive_name))\n  \n  # Move to the workshop specified in the recipe and perform the USE action\n  recipe = env.world.cookbook.recipes.get(item_index)\n  if not recipe:\n    print(\"No recipe found for the item.\")\n    return actions\n  \n  # Assuming there's only one workshop for simplicity (this might need adjustment based on actual recipes)\n  workshop_indices = env.world.workshop_indices\n\n  for workshop_index in workshop_indices:\n    # Check if any of the workshops are next to the agent\n    if env._current_state.next_to(workshop_index):\n      # Move towards the workshop and perform the USE action\n      actions.append(env.action_specs()[\"USE\"])\n      break\n  \n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-06T11:59:05.663665", "function_name": "craft", "function_body": "  actions = []\n  cookbook = env.world.cookbook\n\n  # Get the index of the desired item\n  item_index = cookbook.index[item]\n\n  if item_index is None:\n      print(f\"Item {item} not found in cookbook.\")\n      return []\n\n  # Get the primitives needed for crafting the item\n  primitives_needed = cookbook.primitives_for(item_index)\n\n  if not primitives_needed:\n      print(f\"No recipe found for item {item}.\")\n      return []\n\n  # Collect all required primitives\n  for primitive, count in primitives_needed.items():\n      primitive_name = cookbook.index.get(primitive)\n      for _ in range(count):\n          actions.extend(collect_v2(env, primitive_name))\n\n  # Find the workshop needed to craft the item\n  workshop_index = None\n  for recipe, ingredients in cookbook.recipes.items():\n      if recipe == item_index:\n          workshop_index = ingredients.get(\"_key\", None)\n          break\n\n  if workshop_index is None:\n      print(f\"No workshop found for item {item}.\")\n      return []\n\n  # Find the position of the workshop on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n      print(f\"Workshop for item {item} not found on the grid.\")\n      return []\n\n  # Go to the nearest workshop\n  agent_position = env._current_state.pos\n  nearest_workshop = min(workshop_positions, key=lambda pos: np.linalg.norm(np.array(pos) - np.array(agent_position)))\n  \n  actions.extend(move_to_v2(env, nearest_workshop))\n\n  # Perform USE action at the workshop\n  actions.append(4)  # Assuming USE is represented by 4\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-06T11:59:06.642153", "function_name": "craft", "function_body": "  index = env.world.cookbook.index\n  primitives_for_goal = env.world.cookbook.primitives_for(index[item])\n  \n  actions = []\n  if not primitives_for_goal:\n    return []\n\n  # Collect all required primitives\n  for primitive, count in primitives_for_goal.items():\n    primitive_name = index.get(primitive)\n    while env._current_state.inventory[primitive] < count:\n      actions.extend(collect(env, primitive_name))\n      reward, done, observations = env.step(actions[-1])\n      if done:\n        break\n\n  # Move to the workshop specified in the recipe\n  # For now, assume we always use workshop0 (index 5)\n  workshop_index = 5\n  actions.extend(move_to_workshop(env, workshop_index))\n\n  # Use action to craft the item\n  actions.append(craft.USE)\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-06T12:00:04.841615", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all primitives required for crafting\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n  \n  for primitive, count in primitives_required.items():\n    # Collect primitives if needed\n    primitive_name = env.world.cookbook.index.get(primitive, \"UNKNOWN\")\n    \n    while env._current_state.inventory[primitive] < count:\n      actions.extend(collect(env, primitive_name))\n      \n      # Move to a workshop and craft the item\n      for workshop in env.world.workshop_indices:\n        if next_to(env._current_state, workshop):\n          actions.append(DOWN)  # Example action, adjust based on direction logic\n          actions.append(USE)\n          break\n  \n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-06T12:00:05.844043", "function_name": "craft", "function_body": "  actions = []\n  \n  # Convert the item name to its corresponding index\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the required primitives in our inventory to craft the item\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  \n  for primitive_index, count in required_primitives.items():\n    while env._current_state.inventory[primitive_index] < count:\n      # Collect more of this primitive\n      actions.extend(collect_v2(env, env.world.cookbook.index.get(primitive_index)))\n  \n  # Once we have all the primitives, find a workshop to craft the item at\n  workshops = env.world.workshop_indices\n  \n  for workshop in workshops:\n    if env._current_state.grid[workshop].any():\n      # Move to the workshop\n      actions.extend(move_v2(env, workshop))\n      \n      # Perform the USE action to craft the item\n      actions.append(env.world.n_actions - 1)  # Assuming USE is the last action\n      \n      break\n  \n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-06T12:04:02.832971", "function_name": "craft", "function_body": "  def find_all_positions_of_kind(grid: np.ndarray, kind_index: int):\n    positions = []\n    for y in range(grid.shape[0]):\n      for x in range(grid.shape[1]):\n        if grid[y, x, kind_index] > 0:\n          positions.append((x, y))\n    return positions\n\n  def distance(pos1: tuple, pos2: tuple) -> int:\n    \"\"\"Calculate the Manhattan distance between two positions.\"\"\"\n    return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n\n  def move_to_position(current_pos: tuple, target_pos: tuple) -> list[int]:\n    \"\"\"Generate a sequence of actions to move from current position to target position.\"\"\"\n    actions = []\n    current_x, current_y = current_pos\n    target_x, target_y = target_pos\n    \n    # Move vertically first\n    while current_y < target_y:\n        actions.append(0)  # DOWN\n        current_y += 1\n    while current_y > target_y:\n        actions.append(1)  # UP\n        current_y -= 1\n    \n    # Then move horizontally\n    while current_x < target_x:\n        actions.append(2)  # LEFT\n        current_x += 1\n    while current_x > target_x:\n        actions.append(3)  # RIGHT\n        current_x -= 1\n    \n    return actions\n\n  def collect_primitive(env, primitive: int) -> list[int]:\n    \"\"\"Generate a sequence of actions to collect the required primitive.\"\"\"\n    grid = env._current_state.grid\n    positions = find_all_positions_of_kind(grid, primitive)\n    \n    if not positions:\n        return []\n    \n    nearest_position = min(positions, key=lambda pos: distance(env._current_state.pos, pos))\n    path_to_primitive = move_to_position(env._current_state.pos, nearest_position)\n    return path_to_primitive + [4]  # Add USE action to collect the primitive\n\n  def find_workshop_index_for_item(item_index: int, cookbook):\n      \"\"\"Find the workshop index required for crafting an item.\"\"\"\n      recipe = cookbook.recipes[item_index]\n      workshop_key = recipe.get(\"_key\", None)\n      \n      if workshop_key is not None:\n          for key, value in cookbook.recipes.items():\n              if \"_key\" in value and value[\"_key\"] == workshop_key:\n                  return key\n      return None\n\n  def check_and_collect_primitives(env, primitives_needed):\n      actions = []\n      grid = env._current_state.grid\n      \n      for primitive, count in primitives_needed.items():\n          missing_count = count - env._current_state.inventory[primitive]\n          while missing_count > 0:\n              actions.extend(collect_primitive(env, primitive))\n              # Simulate the collection by updating inventory\n              env._current_state.inventory[primitive] += 1\n              missing_count -= 1\n      \n      return actions\n\n  def find_closest_workshop_position(grid: np.ndarray, workshop_index: int, current_pos: tuple):\n    positions = find_all_positions_of_kind(grid, workshop_index)\n    if not positions:\n        return None\n    nearest_position = min(positions, key=lambda pos: distance(current_pos, pos))\n    return nearest_position\n\n  actions = []\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  # Check if we have all the primitives required for crafting\n  primitives_needed = cookbook.primitives_for(item_index)\n  actions.extend(check_and_collect_primitives(env, primitives_needed))\n  \n  # Find the workshop index needed to craft the item\n  workshop_index = find_workshop_index_for_item(item_index, cookbook)\n\n  if workshop_index is not None:\n      grid = env._current_state.grid\n      nearest_workshop_pos = find_closest_workshop_position(grid, workshop_index, env._current_state.pos)\n      \n      if nearest_workshop_pos is not None:\n          actions.extend(move_to_position(env._current_state.pos, nearest_workshop_pos))\n          \n          # Use the workshop to craft the item\n          actions.append(4)  # USE action\n  \n  return actions", "island_id": 1, "scores": {"3": 0.49999994}}
{"timestamp": "2025-09-06T12:04:03.882847", "function_name": "craft", "function_body": "  def find_all_positions_of_kind(grid: np.ndarray, kind_index: int):\n    positions = []\n    for y in range(grid.shape[0]):\n      for x in range(grid.shape[1]):\n        if grid[y, x, kind_index] > 0:\n          positions.append((x, y))\n    return positions\n\n  def distance(pos1: tuple, pos2: tuple) -> int:\n    \"\"\"Calculate the Manhattan distance between two positions.\"\"\"\n    return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n\n  def move_to_position(current_pos: tuple, target_pos: tuple) -> list[int]:\n    \"\"\"Generate a sequence of actions to move from current position to target position.\"\"\"\n    actions = []\n    current_x, current_y = current_pos\n    target_x, target_y = target_pos\n    \n    # Calculate the steps needed in each direction\n    dx = target_x - current_x\n    dy = target_y - current_y\n    \n    # Move horizontally first if moving left (negative dx)\n    if dx < 0:\n        actions.extend([3] * abs(dx))\n        current_x += dx\n    \n    # Then move vertically\n    if dy > 0:\n        actions.extend([0] * dy)  # DOWN\n        current_y += dy\n    elif dy < 0:\n        actions.extend([1] * abs(dy))  # UP\n        current_y -= dy\n    \n    # Move horizontally if moving right (positive dx)\n    if dx > 0:\n        actions.extend([2] * dx)\n        current_x += dx\n    \n    return actions\n\n  def collect_primitive(env, primitive: int) -> list[int]:\n    \"\"\"Generate a sequence of actions to collect the required primitive.\"\"\"\n    grid = env._current_state.grid\n    positions = find_all_positions_of_kind(grid, primitive)\n    \n    if not positions:\n        return []\n    \n    nearest_position = min(positions, key=lambda pos: distance(env._current_state.pos, pos))\n    path_to_primitive = move_to_position(env._current_state.pos, nearest_position)\n    return path_to_primitive + [4]  # Add USE action to collect the primitive\n\n  def find_workshop_index_for_item(item_index: int, cookbook):\n      \"\"\"Find the workshop index required for crafting an item.\"\"\"\n      recipe = cookbook.recipes[item_index]\n      workshop_key = recipe.get(\"_key\", None)\n      \n      if workshop_key is not None:\n          for key, value in cookbook.recipes.items():\n              if \"_key\" in value and value[\"_key\"] == workshop_key:\n                  return key\n      return None\n\n  def check_and_collect_primitives(env, primitives_needed):\n      actions = []\n      grid = env._current_state.grid\n      \n      for primitive, count in primitives_needed.items():\n          missing_count = count - env._current_state.inventory[primitive]\n          while missing_count > 0:\n              actions.extend(collect_primitive(env, primitive))\n              # Simulate the collection by updating inventory\n              env._current_state.inventory[primitive] += 1\n              missing_count -= 1\n      \n      return actions\n\n  def find_closest_workshop_position(grid: np.ndarray, workshop_index: int, current_pos: tuple):\n    positions = find_all_positions_of_kind(grid, workshop_index)\n    if not positions:\n        return None\n    nearest_position = min(positions, key=lambda pos: distance(current_pos, pos))\n    return nearest_position\n\n  actions = []\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  # Check if we have all the primitives required for crafting\n  primitives_needed = cookbook.primitives_for(item_index)\n  actions.extend(check_and_collect_primitives(env, primitives_needed))\n  \n  # Find the workshop index needed to craft the item\n  workshop_index = find_workshop_index_for_item(item_index, cookbook)\n\n  if workshop_index is not None:\n      grid = env._current_state.grid\n      nearest_workshop_pos = find_closest_workshop_position(grid, workshop_index, env._current_state.pos)\n      \n      if nearest_workshop_pos is not None:\n          actions.extend(move_to_position(env._current_state.pos, nearest_workshop_pos))\n          \n          # Use the workshop to craft the item\n          actions.append(4)  # USE action\n  \n  return actions", "island_id": 1, "scores": {"3": 0.29999995}}
{"timestamp": "2025-09-06T12:05:21.596658", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  item_idx = env.world.cookbook.index[item]\n\n  # Check if we have all the primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_idx)\n\n  actions = []\n  \n  # Collect all required primitives if not already in inventory\n  for primitive, count in required_primitives.items():\n    while env._current_state.inventory[primitive] < count:\n      collect_primitive_actions = collect(env, env.world.cookbook.index.get(primitive))\n      actions.extend(collect_primitive_actions)\n      # After collecting the required primitive, update the state\n      reward, done, observations = env.step(ACTION_USE)\n      total_reward += reward\n      if done:\n        break\n  \n  # Go to the workshop and use it to craft the item\n  for workshop in env.world.workshop_indices:\n    if env._current_state.next_to(workshop):\n      actions.append(env.ACTION_USE)  # Use the workshop to craft the item\n      return actions\n\n  return []  # Return empty list if no suitable workshop is found or crafting failed", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-06T12:05:22.592339", "function_name": "craft", "function_body": "  # Convert the item name to its corresponding index in the cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the primitives required for crafting the item\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  inventory = env._current_state.inventory\n  \n  actions = []\n  \n  # Collect missing primitives\n  for primitive, count in primitives_needed.items():\n    if inventory[primitive] < count:\n      primitive_name = env.world.cookbook.index.get(primitive)\n      actions.extend(collect(env, primitive_name))\n      \n      # Check if we have enough after collecting\n      if inventory[primitive] < count:\n        return []  # Could not collect enough primitives\n\n  # Go to the workshop and perform USE action to craft the item\n  # Assume there is a single workshop for simplicity\n  workshop_index = env.world.workshop_indices[0]\n  \n  # Find the position of the workshop in the grid\n  grid = env._current_state.grid\n  pos = np.argwhere(grid[:, :, workshop_index] > 0)\n  \n  if len(pos) == 0:\n    return []  # Workshop not found in the grid\n\n  target_pos = tuple(pos[0])\n  current_pos = env._current_state.pos\n  \n  # Move to the workshop position\n  actions.extend(move_to(env, current_pos, target_pos))\n  \n  # Perform USE action to craft the item at the workshop\n  actions.append(4)  # Assuming USE is represented by index 4\n\n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-06T12:08:49.315156", "function_name": "craft", "function_body": "  def move_to_pos(pos):\n      current_pos = env._current_state.pos\n      path = bfs(current_pos, pos)\n      if not path:\n          return []\n      \n      action_map = {(-1, 0): craft.MOVE_FUNC(craft.UP), (1, 0): craft.MOVE_FUNC(craft.DOWN),\n                    (0, -1): craft.MOVE_FUNC(craft.LEFT), (0, 1): craft.MOVE_FUNC(craft.RIGHT)}\n      \n      actions = []\n      for i in range(1, len(path)):\n          dx = path[i][0] - path[i-1][0]\n          dy = path[i][1] - path[i-1][1]\n          action = action_map.get((dx, dy))\n          if action:\n              actions.append(action)\n      return actions\n\n  def bfs(start, goal):\n      queue = collections.deque([start])\n      came_from = {start: None}\n      \n      while queue:\n          current = queue.popleft()\n          \n          if current == goal:\n              path = []\n              while current is not None:\n                  path.append(current)\n                  current = came_from[current]\n              return list(reversed(path))\n          \n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              if 0 <= neighbor[0] < env.world.grid.shape[0] and 0 <= neighbor[1] < env.world.grid.shape[1]:\n                  kind = np.argmax(env.world.grid[neighbor])\n                  if kind not in env.world.grass_indices:  # Assuming grass is the only traversable terrain\n                      continue\n                  if neighbor not in came_from:\n                      queue.append(neighbor)\n                      came_from[neighbor] = current\n      \n      return []\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the primitives required to craft the item\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n  inventory_counts = collections.Counter(env._current_state.inventory)\n\n  # If any primitive is missing, return an empty action list\n  for prim_idx, count in primitives_required.items():\n      if inventory_counts.get(prim_idx, 0) < count:\n          return []\n\n  actions = []\n  \n  # Find all workshops and their positions\n  workshop_positions = {}\n  for i in range(env.world.grid.shape[0]):\n      for j in range(env.world.grid.shape[1]):\n          kind = np.argmax(env.world.grid[i, j])\n          if kind in env.world.workshop_indices:\n              workshop_positions[kind] = (i, j)\n  \n  # If no workshops are found, return an empty action list\n  if not workshop_positions:\n      return []\n\n  # Determine which workshop to use based on the recipe\n  recipe = env.world.cookbook.recipes[item_index]\n  required_primitives = {prim_idx for prim_idx in primitives_required}\n  available_workshops = set(workshop_positions.keys())\n  \n  # Find a workshop that can craft the item\n  workshop_kind = None\n  for kind, pos in workshop_positions.items():\n      if kind in recipe or \"_key\" in recipe:\n          workshop_kind = kind\n          break\n  \n  if not workshop_kind:\n      return []\n\n  # Move to the chosen workshop\n  actions.extend(move_to_pos(workshop_positions[workshop_kind]))\n  \n  # Add the USE action to craft the item\n  actions.append(craft.CRAFT_FUNC(item_index))\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T12:08:50.451342", "function_name": "craft", "function_body": "  def bfs(start, goal):\n      queue = collections.deque([start])\n      visited = set()\n      parent = {start: None}\n\n      while queue:\n          pos = queue.popleft()\n          if pos == goal:\n              path = []\n              while pos is not None:\n                  path.append(pos)\n                  pos = parent[pos]\n              return path[::-1]\n\n          x, y = pos\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < env.world.grid.shape[0] and 0 <= ny < env.world.grid.shape[1] and (nx, ny) not in visited:\n                  queue.append((nx, ny))\n                  visited.add((nx, ny))\n                  parent[(nx, ny)] = pos\n\n      return []\n\n  def move_to_pos(pos):\n      current_pos = env._current_state.pos\n      path = bfs(current_pos, pos)\n      if not path:\n          return []\n      \n      action_map = {(-1, 0): craft.MOVE_FUNC(craft.UP), (1, 0): craft.MOVE_FUNC(craft.DOWN),\n                    (0, -1): craft.MOVE_FUNC(craft.LEFT), (0, 1): craft.MOVE_FUNC(craft.RIGHT)}\n      \n      actions = []\n      for i in range(1, len(path)):\n          dx = path[i][0] - path[i-1][0]\n          dy = path[i][1] - path[i-1][1]\n          action = action_map.get((dx, dy))\n          if action:\n              actions.append(action)\n      return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the primitives required to craft the item\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n  inventory_counts = collections.Counter(env._current_state.inventory)\n\n  # If any primitive is missing, return an empty action list\n  for prim_idx, count in primitives_required.items():\n      if inventory_counts.get(prim_idx, 0) < count:\n          return []\n\n  actions = []\n  \n  # Find all workshops and their positions\n  workshop_positions = {}\n  for i in range(env.world.grid.shape[0]):\n      for j in range(env.world.grid.shape[1]):\n          kind = np.argmax(env.world.grid[i, j])\n          if kind in env.world.workshop_indices:\n              workshop_positions[kind] = (i, j)\n  \n  # If no workshops are found, return an empty action list\n  if not workshop_positions:\n      return []\n\n  # Determine which workshop to use based on the recipe\n  recipe = env.world.cookbook.recipes[item_index]\n  required_primitives = {prim_idx for prim_idx in primitives_required}\n  available_workshops = set(workshop_positions.keys())\n  \n  # Find a workshop that can craft the item\n  workshop_kind = None\n  for kind, pos in workshop_positions.items():\n      if kind in recipe or \"_key\" in recipe:\n          workshop_kind = kind\n          break\n  \n  if not workshop_kind:\n      return []\n\n  # Move to the chosen workshop\n  actions.extend(move_to_pos(workshop_positions[workshop_kind]))\n  \n  # Add the USE action to craft the item\n  actions.append(craft.CRAFT_FUNC(item_index))\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T12:10:16.174503", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the items/primitives required for crafting\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  \n  for primitive, count in primitives_needed.items():\n    if env._current_state.inventory[primitive] < count:\n      actions.extend(collect_v2(env, env.world.cookbook.index.get(primitive)))\n      \n  # Assuming the workshop index is stored somewhere in the recipe\n  # For now, let's assume we know the workshop index for simplicity\n  workshop_index = env.world.workshop_indices[0]\n  \n  # Move to the workshop\n  actions.extend(move_to(env, workshop_index))\n  \n  # Perform the USE action to craft the item\n  actions.append(craft.USE)\n  \n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-06T12:10:17.188499", "function_name": "craft", "function_body": "  # Get the index of the item to be crafted\n  item_idx = env.world.cookbook.index[item]\n  \n  # Check if we have all the primitives required for crafting the item\n  primitives_needed = env.world.cookbook.primitives_for(item_idx)\n  \n  actions = []\n  if not primitives_needed:\n    return actions\n  \n  # Collect the primitives needed for crafting\n  for primitive_idx, count in primitives_needed.items():\n    # Get the name of the primitive\n    primitive_name = env.world.cookbook.index.get(primitive_idx)\n    \n    # Collect enough primitives\n    while env._current_state.inventory[primitive_idx] < count:\n      # Find a location to collect the primitive\n      locations = np.argwhere(env._current_state.grid[:, :, primitive_idx] > 0)\n      if not locations.size:\n        return []  # No location found for this primitive\n      \n      # Move to the closest location\n      loc_x, loc_y = locations[np.argmin(np.sum((locations - env._current_state.pos) ** 2, axis=1))]\n      \n      actions.extend(move_to(env, (loc_x, loc_y)))\n      actions.append(craft.Collect_FUNC(primitive_name))\n  \n  # Go to the workshop and craft the item\n  workshop_idx = None\n  for recipe in env.world.cookbook.recipes.values():\n    if \"_key\" in recipe and recipe[\"_key\"] == \"workshop\":\n      workshop_idx = recipe[primitive_idx]\n      break\n  \n  if workshop_idx is None:\n    return []  # No workshop found\n  \n  workshop_locations = np.argwhere(env._current_state.grid[:, :, workshop_idx] > 0)\n  if not workshop_locations.size:\n    return []  # No workshop location found\n  \n  # Move to the closest workshop\n  loc_x, loc_y = workshop_locations[np.argmin(np.sum((workshop_locations - env._current_state.pos) ** 2, axis=1))]\n  \n  actions.extend(move_to(env, (loc_x, loc_y)))\n  actions.append(craft.CRAFT_FUNC(item))\n  \n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-06T12:15:18.479686", "function_name": "craft", "function_body": "  ACTION_UP = env.world.n_actions - 4 + 0\n  ACTION_DOWN = env.world.n_actions - 4 + 2\n  ACTION_LEFT = env.world.n_actions - 4 + 1\n  ACTION_RIGHT = env.world.n_actions - 4 + 3\n  ACTION_USE = env.world.n_actions - 1\n\n  def move_to_position(target_x, target_y):\n    \"\"\"Helper function to generate actions to move to a specific position.\"\"\"\n    actions = []\n    pos_x, pos_y = env._current_state.pos\n    \n    while pos_x != target_x or pos_y != target_y:\n      dx = target_x - pos_x\n      dy = target_y - pos_y\n      \n      if abs(dx) > abs(dy):\n        actions.append(ACTION_LEFT if dx < 0 else ACTION_RIGHT)\n      else:\n        actions.append(ACTION_DOWN if dy < 0 else ACTION_UP)\n      \n      pos_x += (-1 if dx < 0 else 1) if abs(dx) > abs(dy) else 0\n      pos_y += (-1 if dy < 0 else 1) if abs(dx) <= abs(dy) else 0\n    \n    return actions\n\n  def move_to_workshop(workshop_index):\n    \"\"\"Helper function to generate actions to move to a workshop.\"\"\"\n    target_positions = np.where(env._current_state.grid[:, :, workshop_index] > 0)\n    \n    if len(target_positions[0]) == 0 or len(target_positions[1]) == 0:\n      return None\n    \n    closest_workshop_pos = find_closest_target(target_positions)\n    \n    if closest_workshop_pos is not None:\n        tx, ty = closest_workshop_pos\n        actions = move_to_position(tx, ty)\n        return actions\n\n  def pick_up_primitives(primitive_index):\n    \"\"\"Helper function to generate actions to pick up primitives.\"\"\"\n    target_positions = np.where(env._current_state.grid[:, :, primitive_index] > 0)\n    \n    if len(target_positions[0]) == 0 or len(target_positions[1]) == 0:\n      return None\n    \n    closest_primitive_pos = find_closest_target(target_positions)\n    \n    if closest_primitive_pos is not None:\n        tx, ty = closest_primitive_pos\n        actions = move_to_position(tx, ty)\n        actions.append(ACTION_USE)  # Assuming USE is always the last action to collect primitive\n        return actions\n\n  def use_workshop(workshop_index):\n    \"\"\"Helper function to generate actions to use a workshop.\"\"\"\n    target_positions = np.where(env._current_state.grid[:, :, workshop_index] > 0)\n    \n    if len(target_positions[0]) == 0 or len(target_positions[1]) == 0:\n      return None\n    \n    closest_workshop_pos = find_closest_target(target_positions)\n    \n    if closest_workshop_pos is not None:\n        tx, ty = closest_workshop_pos\n        actions = move_to_position(tx, ty)\n        actions.append(ACTION_USE)  # Assuming USE is always the last action to craft item\n        return actions\n\n  def find_closest_target(target_positions):\n      \"\"\"Helper function to find the closest target position.\"\"\"\n      pos_x, pos_y = env._current_state.pos\n      \n      min_distance = float('inf')\n      closest_pos = None\n      \n      for tx, ty in zip(*target_positions):\n          distance = abs(tx - pos_x) + abs(ty - pos_y)\n          if distance < min_distance:\n              min_distance = distance\n              closest_pos = (tx, ty)\n      \n      return closest_pos\n\n  def find_nearest_workshop_with_recipe(item_index):\n    \"\"\"Helper function to find the nearest workshop with a specific recipe.\"\"\"\n    workshops = env.world.workshop_indices\n    \n    for i, workshop in enumerate(workshops):\n        if item_index in env.world.cookbook.recipes[workshop]:\n            return workshop\n    return None\n\n  actions = []\n  \n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all required primitives for crafting the item\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  current_inventory = env._current_state.inventory\n\n  # Collect missing primitives\n  for prim, count in primitives_needed.items():\n    while current_inventory[prim] < count:\n      primitive_actions = pick_up_primitives(prim)\n      \n      if primitive_actions is not None:\n        actions.extend(primitive_actions)\n        current_inventory[prim] += 1\n      else:\n        return []  # If no source for the primitive, return empty list\n\n  # Find and use a workshop that has the required recipe\n  nearest_workshop = find_nearest_workshop_with_recipe(item_index)\n\n  if nearest_workshop is not None:\n    workshop_actions = move_to_workshop(nearest_workshop)\n    \n    if workshop_actions is not None:\n      actions.extend(workshop_actions)\n      \n      # Perform USE action to craft the item\n      actions.append(ACTION_USE)\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-06T12:15:19.567701", "function_name": "craft", "function_body": "  ACTION_UP = env.world.n_actions - 4 + 0\n  ACTION_DOWN = env.world.n_actions - 4 + 2\n  ACTION_LEFT = env.world.n_actions - 4 + 1\n  ACTION_RIGHT = env.world.n_actions - 4 + 3\n  ACTION_USE = env.world.n_actions - 1\n\n  def move_to_position(target_x, target_y):\n    \"\"\"Helper function to generate actions to move to a specific position.\"\"\"\n    actions = []\n    pos_x, pos_y = env._current_state.pos\n    \n    while pos_x != target_x or pos_y != target_y:\n      dx = target_x - pos_x\n      dy = target_y - pos_y\n      \n      if abs(dx) > abs(dy):\n        actions.append(ACTION_LEFT if dx < 0 else ACTION_RIGHT)\n      else:\n        actions.append(ACTION_DOWN if dy < 0 else ACTION_UP)\n      \n      pos_x += (-1 if dx < 0 else 1) if abs(dx) > abs(dy) else 0\n      pos_y += (-1 if dy < 0 else 1) if abs(dx) <= abs(dy) else 0\n    \n    return actions\n\n  def move_to_workshop(workshop_index):\n    \"\"\"Helper function to generate actions to move to a workshop.\"\"\"\n    target_positions = np.where(env._current_state.grid[:, :, workshop_index] > 0)\n    \n    if len(target_positions[0]) == 0 or len(target_positions[1]) == 0:\n      return None\n    \n    closest_workshop_pos = find_closest_target(target_positions)\n    \n    if closest_workshop_pos is not None:\n        tx, ty = closest_workshop_pos\n        actions = move_to_position(tx, ty)\n        return actions\n\n  def pick_up_primitives(primitive_index):\n    \"\"\"Helper function to generate actions to pick up primitives.\"\"\"\n    target_positions = np.where(env._current_state.grid[:, :, primitive_index] > 0)\n    \n    if len(target_positions[0]) == 0 or len(target_positions[1]) == 0:\n      return None\n    \n    closest_primitive_pos = find_closest_target(target_positions)\n    \n    if closest_primitive_pos is not None:\n        tx, ty = closest_primitive_pos\n        actions = move_to_position(tx, ty)\n        actions.append(ACTION_USE)  # Assuming USE is always the last action to collect primitive\n        return actions\n\n  def use_workshop(workshop_index):\n    \"\"\"Helper function to generate actions to use a workshop.\"\"\"\n    target_positions = np.where(env._current_state.grid[:, :, workshop_index] > 0)\n    \n    if len(target_positions[0]) == 0 or len(target_positions[1]) == 0:\n      return None\n    \n    closest_workshop_pos = find_closest_target(target_positions)\n    \n    if closest_workshop_pos is not None:\n        tx, ty = closest_workshop_pos\n        actions = move_to_position(tx, ty)\n        actions.append(ACTION_USE)  # Assuming USE is always the last action to craft item\n        return actions\n\n  def find_closest_target(target_positions):\n      \"\"\"Helper function to find the closest target position.\"\"\"\n      pos_x, pos_y = env._current_state.pos\n      \n      min_distance = float('inf')\n      closest_pos = None\n      \n      for tx, ty in zip(*target_positions):\n          distance = abs(tx - pos_x) + abs(ty - pos_y)\n          if distance < min_distance:\n              min_distance = distance\n              closest_pos = (tx, ty)\n      \n      return closest_pos\n\n  def update_inventory():\n      \"\"\"Helper function to update the inventory based on current state.\"\"\"\n      current_inventory = env._current_state.inventory.copy()\n      for prim in primitives_needed.keys():\n          # Assuming some way to determine how many of each primitive are collected\n          # This is a placeholder logic and needs to be replaced with actual game mechanics.\n          while current_inventory[prim] < primitives_needed[prim]:\n              # Simulate picking up the primitive (this should be replaced with actual environment interaction)\n              current_inventory[prim] += 1\n      return current_inventory\n\n  actions = []\n  \n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all required primitives for crafting the item\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  current_inventory = update_inventory()\n\n  # Collect missing primitives\n  for prim, count in primitives_needed.items():\n    while current_inventory[prim] < count:\n      primitive_actions = pick_up_primitives(prim)\n      \n      if primitive_actions is not None:\n        actions.extend(primitive_actions)\n        current_inventory = update_inventory()  # Update inventory after collecting primitives\n      else:\n        return []  # If no source for the primitive, return empty list\n\n  # Find and use a workshop that has the required recipe\n  for i, workshop in enumerate(env.world.workshop_indices):\n    workshop_actions = move_to_workshop(workshop)\n    \n    if workshop_actions is not None:\n      actions.extend(workshop_actions)\n      \n      # Perform USE action to craft the item\n      actions.append(ACTION_USE)\n      break\n\n  return actions", "island_id": 2, "scores": {"3": 0.90000004}}
{"timestamp": "2025-09-06T12:20:29.090742", "function_name": "craft", "function_body": "  ACTION_UP = env.world.n_actions - 4 + 0\n  ACTION_DOWN = env.world.n_actions - 4 + 2\n  ACTION_LEFT = env.world.n_actions - 4 + 1\n  ACTION_RIGHT = env.world.n_actions - 4 + 3\n  ACTION_USE = env.world.n_actions - 1\n\n  def move_to_position(target_x, target_y):\n    \"\"\"Helper function to generate actions to move to a specific position.\"\"\"\n    actions = []\n    pos_x, pos_y = env._current_state.pos\n    \n    while pos_x != target_x or pos_y != target_y:\n      dx = target_x - pos_x\n      dy = target_y - pos_y\n      \n      if abs(dx) > abs(dy):\n        actions.append(ACTION_LEFT if dx < 0 else ACTION_RIGHT)\n      else:\n        actions.append(ACTION_DOWN if dy < 0 else ACTION_UP)\n      \n      pos_x += (-1 if dx < 0 else 1) if abs(dx) > abs(dy) else 0\n      pos_y += (-1 if dy < 0 else 1) if abs(dx) <= abs(dy) else 0\n    \n    return actions\n\n  def move_to_workshop(workshop_index):\n    \"\"\"Helper function to generate actions to move to a workshop.\"\"\"\n    target_positions = np.where(env._current_state.grid[:, :, workshop_index] > 0)\n    \n    if len(target_positions[0]) == 0 or len(target_positions[1]) == 0:\n      return None\n    \n    closest_workshop_pos = find_closest_target(target_positions)\n    \n    if closest_workshop_pos is not None:\n        tx, ty = closest_workshop_pos\n        actions = move_to_position(tx, ty)\n        return actions\n\n  def pick_up_primitives(primitive_index):\n    \"\"\"Helper function to generate actions to pick up primitives.\"\"\"\n    target_positions = np.where(env._current_state.grid[:, :, primitive_index] > 0)\n    \n    if len(target_positions[0]) == 0 or len(target_positions[1]) == 0:\n      return None\n    \n    closest_primitive_pos = find_closest_target(target_positions)\n    \n    if closest_primitive_pos is not None:\n        tx, ty = closest_primitive_pos\n        actions = move_to_position(tx, ty)\n        actions.append(ACTION_USE)  # Assuming USE is always the last action to collect primitive\n        return actions\n\n  def use_workshop(workshop_index):\n    \"\"\"Helper function to generate actions to use a workshop.\"\"\"\n    target_positions = np.where(env._current_state.grid[:, :, workshop_index] > 0)\n    \n    if len(target_positions[0]) == 0 or len(target_positions[1]) == 0:\n      return None\n    \n    closest_workshop_pos = find_closest_target(target_positions)\n    \n    if closest_workshop_pos is not None:\n        tx, ty = closest_workshop_pos\n        actions = move_to_position(tx, ty)\n        actions.append(ACTION_USE)  # Assuming USE is always the last action to craft item\n        return actions\n\n  def find_closest_target(target_positions):\n      \"\"\"Helper function to find the closest target position.\"\"\"\n      pos_x, pos_y = env._current_state.pos\n      \n      min_distance = float('inf')\n      closest_pos = None\n      \n      for tx, ty in zip(*target_positions):\n          distance = abs(tx - pos_x) + abs(ty - pos_y)\n          if distance < min_distance:\n              min_distance = distance\n              closest_pos = (tx, ty)\n      \n      return closest_pos\n\n  def check_workshop_availability(workshop_index, primitives_needed):\n    \"\"\"Helper function to check if a workshop has the required recipe.\"\"\"\n    # Assuming each workshop can craft any item with the correct primitives in inventory\n    return True\n\n  actions = []\n  \n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all required primitives for crafting the item\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  current_inventory = env._current_state.inventory\n\n  # Collect missing primitives\n  for prim, count in primitives_needed.items():\n    while current_inventory[prim] < count:\n      primitive_actions = pick_up_primitives(prim)\n      \n      if primitive_actions is not None:\n        actions.extend(primitive_actions)\n        current_inventory[prim] += 1\n      else:\n        return []  # If no source for the primitive, return empty list\n\n  # Find and use a workshop that has the required recipe\n  workshop_used = False\n  for i, workshop in enumerate(env.world.workshop_indices):\n    if check_workshop_availability(workshop, primitives_needed):\n      workshop_actions = move_to_workshop(workshop)\n      \n      if workshop_actions is not None:\n        actions.extend(workshop_actions)\n        \n        # Perform USE action to craft the item\n        actions.append(ACTION_USE)\n        workshop_used = True\n        break\n\n  return actions if workshop_used else []", "island_id": 2, "scores": {"3": 2.0}}
