{"timestamp": "2025-09-06T13:56:31.073170", "function_name": "craft", "function_body": "  def get_workshop_for_item(item_index):\n    # This is a placeholder function to determine which workshop can handle the crafting for a given item.\n    # In practice, you would need to parse the recipe and find the required workshop.\n    return env.world.workshop_indices[0]\n\n  actions = []\n  current_state = env._current_state\n\n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the primitives required for crafting the item\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  for primitive, count in primitives_needed.items():\n    while current_state.inventory[primitive] < count:\n      actions.extend(collect(env, primitive))\n      current_state = env._current_state\n  \n  # Get the workshop index where we can craft this item\n  workshop_index = get_workshop_for_item(item_index)\n\n  # Move to the nearest available spot next to a workshop\n  move_to_position(actions, current_state, find_nearest_workshop_position(current_state.grid, workshop_index))\n  \n  # Perform USE action to start crafting\n  actions.append(craft.USE)\n  \n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-06T13:56:32.052871", "function_name": "craft", "function_body": "  # Get the index for the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item has a recipe in the cookbook\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Retrieve the recipe for the item\n  recipe = env.world.cookbook.recipes[item_index]\n  \n  # Get the list of ingredients and their counts required for crafting\n  ingredient_counts = {env.world.cookbook.index[ingredient]: count for ingredient, count in recipe.items() if ingredient != \"_key\"}\n\n  actions = []\n\n  # Collect all necessary ingredients\n  for ingredient_index, count in ingredient_counts.items():\n    while env._current_state.inventory[ingredient_index] < count:\n      collect_actions = collect_v1(env, ingredient_index)\n      actions.extend(collect_actions)\n\n  # Move to the workshop if required by the recipe\n  workshop_required = \"_key\" in recipe and recipe[\"_key\"] is not None\n  if workshop_required:\n    workshop_key = recipe[\"_key\"]\n    workshop_index = env.world.cookbook.index[workshop_key]\n    workshop_position = env.world.workshop_indices[workshop_index]\n\n    # Move the agent to the workshop position\n    move_actions = move_to(env, workshop_position)\n    actions.extend(move_actions)\n\n  # Use the USE action to craft the item at the workshop\n  use_action = 4  # Assuming 4 is the index for the USE action\n  actions.append(use_action)\n\n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-06T13:58:01.124671", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have a recipe for this item\n  if item_index not in env.world.cookbook.recipes:\n    return []\n    \n  # Determine which workshop is required (if any)\n  workshop_index = None\n  if \"_key\" in env.world.cookbook.recipes[item_index]:\n      workshop_index = env.world.cookbook.recipes[item_index][\"_key\"]\n\n  actions = []\n\n  # Check if we have all the ingredients required for crafting\n  ingredients_needed = env.world.cookbook.recipes[item_index].copy()\n  \n  # Remove the \"_key\" entry if it exists (it's not an ingredient)\n  if \"_key\" in ingredients_needed:\n    del ingredients_needed[\"_key\"]\n\n  # Check if we have enough of each ingredient\n  for ingredient, count in ingredients_needed.items():\n    if env._current_state.inventory[ingredient] < count:\n      return []  # We don't have all the required ingredients\n\n  # Move to the required workshop (if needed)\n  if workshop_index is not None:\n    found_workshop = False\n    for workshop_pos in env.world.workshop_indices:\n      if env.world.grid[workshop_pos] == workshop_index:\n        actions.extend(move_to_position(env, workshop_pos))\n        found_workshop = True\n        break\n\n    if not found_workshop:\n      return []  # Could not find the required workshop\n\n  # Perform the USE action to craft the item\n  actions.append(4)  # 4 corresponds to the USE action\n\n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-06T13:58:02.171924", "function_name": "craft", "function_body": "  def move_to_position(pos):\n    \"\"\"Generate a list of actions to move the agent to a specific position.\"\"\"\n    current_pos = env._current_state.pos\n    target_x, target_y = pos\n    dx = target_x - current_pos[0]\n    dy = target_y - current_pos[1]\n\n    actions = []\n    \n    # Move horizontally first\n    if dx > 0:\n      actions.extend([3] * abs(dx))  # RIGHT\n    elif dx < 0:\n      actions.extend([2] * abs(dx))  # LEFT\n\n    # Then move vertically\n    if dy > 0:\n      actions.extend([1] * abs(dy))  # UP\n    elif dy < 0:\n      actions.extend([0] * abs(dy))  # DOWN\n    \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have a recipe for this item\n  if item_index not in env.world.cookbook.recipes:\n    return []\n    \n  # Determine which workshop is required (if any)\n  workshop_index = None\n  if \"_key\" in env.world.cookbook.recipes[item_index]:\n      workshop_index = env.world.cookbook.recipes[item_index][\"_key\"]\n\n  actions = []\n\n  # Move to the required workshop (if needed)\n  if workshop_index is not None:\n    for workshop_pos in env.world.workshop_indices:\n      if env.world.grid[workshop_pos] == workshop_index:\n        actions.extend(move_to_position(workshop_pos))\n        break\n\n  # Perform the USE action to craft the item\n  actions.append(4)  # 4 corresponds to the USE action\n\n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T14:01:05.507195", "function_name": "craft", "function_body": "  def bfs(start, goal):\n      queue = collections.deque([start])\n      visited = set()\n      parent = {start: None}\n\n      while queue:\n          pos = queue.popleft()\n          if pos == goal:\n              path = []\n              while pos is not None:\n                  path.append(pos)\n                  pos = parent[pos]\n              return path[::-1]\n\n          x, y = pos\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < env.world.grid.shape[0] and 0 <= ny < env.world.grid.shape[1] and (nx, ny) not in visited:\n                  queue.append((nx, ny))\n                  visited.add((nx, ny))\n                  parent[(nx, ny)] = pos\n\n      return []\n\n  def move_to_pos(pos):\n      current_pos = env._current_state.pos\n      path = bfs(current_pos, pos)\n      if not path:\n          return []\n      \n      action_map = {(-1, 0): craft.MOVE_FUNC(craft.UP), (1, 0): craft.MOVE_FUNC(craft.DOWN),\n                    (0, -1): craft.MOVE_FUNC(craft.LEFT), (0, 1): craft.MOVE_FUNC(craft.RIGHT)}\n      \n      actions = []\n      for i in range(1, len(path)):\n          dx = path[i][0] - path[i-1][0]\n          dy = path[i][1] - path[i-1][1]\n          action = action_map.get((dx, dy))\n          if action:\n              actions.append(action)\n      return actions\n\n  def find_closest_workshop(item_index):\n      workshop_positions = {}\n      for i in range(env.world.grid.shape[0]):\n          for j in range(env.world.grid.shape[1]):\n              kind = np.argmax(env.world.grid[i, j])\n              if kind in env.world.workshop_indices:\n                  workshop_positions[kind] = (i, j)\n      \n      # If no workshops are found, return None\n      if not workshop_positions:\n          return None\n      \n      recipe = env.world.cookbook.recipes[item_index]\n      required_primitives = {prim_idx for prim_idx in primitives_required}\n      \n      closest_workshop = None\n      min_distance = float('inf')\n      current_pos = env._current_state.pos\n      \n      for kind, pos in workshop_positions.items():\n          if any(prim in recipe for prim in required_primitives):\n              distance = abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n              if distance < min_distance:\n                  min_distance = distance\n                  closest_workshop = kind\n      \n      return workshop_positions.get(closest_workshop)\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the primitives required to craft the item\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n  inventory_counts = collections.Counter(env._current_state.inventory)\n\n  # If any primitive is missing, return an empty action list\n  for prim_idx, count in primitives_required.items():\n      if inventory_counts.get(prim_idx, 0) < count:\n          return []\n\n  actions = []\n  \n  # Find the closest workshop that can craft the item\n  workshop_pos = find_closest_workshop(item_index)\n  \n  if not workshop_pos:\n      return []\n\n  # Move to the chosen workshop\n  actions.extend(move_to_pos(workshop_pos))\n  \n  # Add the USE action to craft the item\n  actions.append(craft.CRAFT_FUNC(item_index))\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T14:01:06.698142", "function_name": "craft", "function_body": "  def bfs(start, goal):\n      queue = collections.deque([start])\n      visited = set()\n      parent = {start: None}\n\n      while queue:\n          pos = queue.popleft()\n          if pos == goal:\n              path = []\n              while pos is not None:\n                  path.append(pos)\n                  pos = parent[pos]\n              return path[::-1]\n\n          x, y = pos\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < env.world.grid.shape[0] and 0 <= ny < env.world.grid.shape[1] and (nx, ny) not in visited:\n                  queue.append((nx, ny))\n                  visited.add((nx, ny))\n                  parent[(nx, ny)] = pos\n\n      return []\n\n  def move_to_pos(pos):\n      current_pos = env._current_state.pos\n      path = bfs(current_pos, pos)\n      if not path:\n          return []\n      \n      action_map = {(-1, 0): craft.MOVE_UP, (1, 0): craft.MOVE_DOWN,\n                    (0, -1): craft.MOVE_LEFT, (0, 1): craft.MOVE_RIGHT}\n      \n      actions = []\n      for i in range(1, len(path)):\n          dx = path[i][0] - path[i-1][0]\n          dy = path[i][1] - path[i-1][1]\n          action = action_map.get((dx, dy))\n          if action:\n              actions.append(action)\n      return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the primitives required to craft the item\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n  inventory_counts = collections.Counter(env._current_state.inventory)\n\n  # If any primitive is missing, return an empty action list\n  for prim_idx, count in primitives_required.items():\n      if inventory_counts.get(prim_idx, 0) < count:\n          return []\n\n  actions = []\n  \n  # Find all workshops and their positions\n  workshop_positions = {}\n  for i in range(env.world.grid.shape[0]):\n      for j in range(env.world.grid.shape[1]):\n          kind = np.argmax(env.world.grid[i, j])\n          if kind in env.world.workshop_indices:\n              workshop_positions[kind] = (i, j)\n  \n  # If no workshops are found, return an empty action list\n  if not workshop_positions:\n      return []\n\n  # Determine which workshop to use based on the recipe\n  recipe = env.world.cookbook.recipes[item_index]\n  required_primitives = {prim_idx for prim_idx in primitives_required}\n  available_workshops = set(workshop_positions.keys())\n  \n  # Find a workshop that can craft the item\n  workshop_kind = None\n  for kind, pos in workshop_positions.items():\n      if any(prim in recipe for prim in required_primitives):\n          workshop_kind = kind\n          break\n  \n  if not workshop_kind:\n      return []\n\n  # Move to the chosen workshop\n  actions.extend(move_to_pos(workshop_positions[workshop_kind]))\n  \n  # Add the USE action to craft the item\n  actions.append(craft.USE)\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T14:03:11.958675", "function_name": "craft", "function_body": "  def navigate_to_workshop(pos: tuple, target_pos: tuple):\n      dx = target_pos[0] - pos[0]\n      dy = target_pos[1] - pos[1]\n\n      actions = []\n      if dx > 0:\n          actions.extend([env.world.RIGHT for _ in range(abs(dx))])\n      elif dx < 0:\n          actions.extend([env.world.LEFT for _ in range(abs(dx))])\n\n      if dy > 0:\n          actions.extend([env.world.DOWN for _ in range(abs(dy))])\n      elif dy < 0:\n          actions.extend([env.world.UP for _ in range(abs(dy))])\n\n      return actions\n\n  def find_nearest_workshop(grid, pos, workshop_indices):\n      min_distance = float('inf')\n      nearest_workshop_pos = None\n      for workshop_index in workshop_indices:\n          positions = np.argwhere(grid[:, :, workshop_index] > 0)\n          if positions.size == 0:\n              continue\n          \n          x_w, y_w = positions[0]\n          distance = abs(x_w - pos[0]) + abs(y_w - pos[1])\n          if distance < min_distance:\n              min_distance = distance\n              nearest_workshop_pos = (x_w, y_w)\n      return nearest_workshop_pos\n\n  actions = []\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n  \n  # Check if we have all required primitives in our inventory\n  required_primitives = cookbook.primitives_for(goal_index)\n  for primitive, count in required_primitives.items():\n    if env._current_state.inventory[primitive] < count:\n      return []  # Not enough primitives to craft the item\n\n  # Find a workshop to perform crafting\n  recipe = cookbook.recipes.get(goal_index, {})\n  workshop_indices = [ingredient for ingredient in recipe.keys() \n                      if ingredient in env.world.workshop_indices and ingredient != \"_key\"]\n\n  if not workshop_indices:\n    return []  # No suitable workshop found\n  \n  # Determine the nearest workshop\n  nearest_workshop_pos = find_nearest_workshop(env._current_state.grid, env._current_state.pos, workshop_indices)\n  \n  if nearest_workshop_pos is None:\n      return []\n\n  # Navigate to the nearest workshop\n  actions.extend(navigate_to_workshop(env._current_state.pos, nearest_workshop_pos))\n\n  # Perform USE action at the workshop to craft the item\n  actions.append(env.world.N_ACTIONS - 1)  # Assuming USE is the last action index (N_ACTIONS - 1)\n\n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T14:03:13.098665", "function_name": "craft", "function_body": "  def navigate_to_workshop(current_pos: tuple, target_pos: tuple):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      actions = []\n      if dx > 0:\n          actions.extend([env.world.RIGHT for _ in range(abs(dx))])\n      elif dx < 0:\n          actions.extend([env.world.LEFT for _ in range(abs(dx))])\n\n      if dy > 0:\n          actions.extend([env.world.DOWN for _ in range(abs(dy))])\n      elif dy < 0:\n          actions.extend([env.world.UP for _ in range(abs(dy))])\n\n      return actions\n\n  def manhattan_distance(pos1: tuple, pos2: tuple):\n      return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n\n  def find_workshop_position(env, workshop_index):\n      grid = env._current_state.grid\n      positions = np.argwhere(grid[:, :, workshop_index] > 0)\n      if positions.size == 0:\n          raise ValueError(f\"No position found for workshop index {workshop_index}\")\n      return tuple(positions[0])\n\n  actions = []\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n  \n  # Check if we have all required primitives in our inventory\n  required_primitives = cookbook.primitives_for(goal_index)\n  for primitive, count in required_primitives.items():\n    if env._current_state.inventory[primitive] < count:\n      return []  # Not enough primitives to craft the item\n\n  # Find a workshop to perform crafting\n  recipe = cookbook.recipes.get(goal_index, {})\n  workshop_indices = [ingredient for ingredient in recipe.keys() \n                      if ingredient in env.world.workshop_indices and ingredient != \"_key\"]\n\n  if not workshop_indices:\n    return []  # No suitable workshop found\n  \n  # Sort workshops by distance to the nearest one\n  distances = {workshop: manhattan_distance(env._current_state.pos, find_workshop_position(env, workshop)) for workshop in workshop_indices}\n  closest_workshop_index = min(distances, key=distances.get)\n\n  # Navigate to the nearest workshop\n  target_pos = find_workshop_position(env, closest_workshop_index)\n  actions.extend(navigate_to_workshop(env._current_state.pos, target_pos))\n\n  # Perform USE action at the workshop to craft the item\n  actions.append(env.world.N_ACTIONS - 1)  # Assuming USE is the last action index (N_ACTIONS - 1)\n\n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T14:07:22.808698", "function_name": "craft", "function_body": "  def get_action_for_direction(dx, dy):\n    ACTION_UP = env.world.n_actions - 4 + 0\n    ACTION_DOWN = env.world.n_actions - 4 + 2\n    ACTION_LEFT = env.world.n_actions - 4 + 1\n    ACTION_RIGHT = env.world.n_actions - 4 + 3\n\n    if dx < 0:\n      return ACTION_LEFT\n    elif dx > 0:\n      return ACTION_RIGHT\n    elif dy < 0:\n      return ACTION_DOWN\n    else:\n      return ACTION_UP\n\n  def move_to_position(target_x, target_y):\n    \"\"\"Helper function to generate actions to move to a specific position.\"\"\"\n    actions = []\n    pos_x, pos_y = env._current_state.pos\n    \n    while pos_x != target_x or pos_y != target_y:\n      dx = target_x - pos_x\n      dy = target_y - pos_y\n      \n      if abs(dx) >= abs(dy):\n        actions.append(get_action_for_direction(dx, 0))\n        pos_x += (-1 if dx < 0 else 1)\n      else:\n        actions.append(get_action_for_direction(0, dy))\n        pos_y += (-1 if dy < 0 else 1)\n    \n    return actions\n\n  def find_closest_target(target_positions):\n    \"\"\"Helper function to find the closest target position.\"\"\"\n    pos_x, pos_y = env._current_state.pos\n    \n    min_distance = float('inf')\n    closest_pos = None\n    \n    for tx, ty in zip(*target_positions):\n        distance = abs(tx - pos_x) + abs(ty - pos_y)\n        if distance < min_distance:\n            min_distance = distance\n            closest_pos = (tx, ty)\n    \n    return closest_pos\n\n  def collect_primitives(primitive_index, count):\n    \"\"\"Helper function to generate actions to collect required primitives.\"\"\"\n    current_inventory = env._current_state.inventory\n    actions = []\n    \n    while current_inventory[primitive_index] < count:\n      primitive_positions = np.where(env._current_state.grid[:, :, primitive_index] > 0)\n      closest_primitive_pos = find_closest_target(primitive_positions)\n      \n      if closest_primitive_pos is not None:\n        tx, ty = closest_primitive_pos\n        actions.extend(move_to_position(tx, ty))\n        actions.append(ACTION_USE)  # Assuming USE is always the last action to collect primitive\n        current_inventory[primitive_index] += 1\n      else:\n        return [], False  # If no source for the primitive, return empty list and failure flag\n    \n    return actions, True\n\n  def use_workshop():\n    \"\"\"Helper function to generate actions to use a workshop.\"\"\"\n    for i, workshop in enumerate(env.world.workshop_indices):\n      workshop_positions = np.where(env._current_state.grid[:, :, workshop] > 0)\n      closest_workshop_pos = find_closest_target(workshop_positions)\n      \n      if closest_workshop_pos is not None:\n        tx, ty = closest_workshop_pos\n        actions = move_to_position(tx, ty)\n        actions.append(ACTION_USE)  # Assuming USE is always the last action to craft item\n        return actions\n    \n    return []  # If no workshop found\n\n  ACTION_UP = env.world.n_actions - 4 + 0\n  ACTION_DOWN = env.world.n_actions - 4 + 2\n  ACTION_LEFT = env.world.n_actions - 4 + 1\n  ACTION_RIGHT = env.world.n_actions - 4 + 3\n  ACTION_USE = env.world.n_actions - 1\n\n  actions = []\n  \n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all required primitives for crafting the item\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n\n  # Collect missing primitives\n  for prim, count in primitives_needed.items():\n    primitive_actions, success = collect_primitives(prim, count)\n    \n    if not success:\n      return []  # If no source for the primitive, return empty list\n    \n    actions.extend(primitive_actions)\n\n  # Find and use a workshop that has the required recipe\n  workshop_actions = use_workshop()\n  actions.extend(workshop_actions)\n\n  return actions", "island_id": 2, "scores": {"3": 1.8000002}}
{"timestamp": "2025-09-06T14:07:23.866573", "function_name": "craft", "function_body": "  def get_action_for_direction(dx, dy):\n    ACTION_UP = env.world.n_actions - 4 + 0\n    ACTION_DOWN = env.world.n_actions - 4 + 2\n    ACTION_LEFT = env.world.n_actions - 4 + 1\n    ACTION_RIGHT = env.world.n_actions - 4 + 3\n\n    if dx < 0:\n      return ACTION_LEFT\n    elif dx > 0:\n      return ACTION_RIGHT\n    elif dy < 0:\n      return ACTION_DOWN\n    else:\n      return ACTION_UP\n\n  def move_to_position(target_x, target_y):\n    \"\"\"Helper function to generate actions to move to a specific position.\"\"\"\n    actions = []\n    pos_x, pos_y = env._current_state.pos\n    \n    while pos_x != target_x or pos_y != target_y:\n      dx = target_x - pos_x\n      dy = target_y - pos_y\n      \n      if abs(dx) > abs(dy):\n        action = get_action_for_direction(dx, 0)\n        actions.append(action)\n        pos_x += (-1 if dx < 0 else 1) if action in [ACTION_LEFT, ACTION_RIGHT] else 0\n      else:\n        action = get_action_for_direction(0, dy)\n        actions.append(action)\n        pos_y += (-1 if dy < 0 else 1) if action in [ACTION_UP, ACTION_DOWN] else 0\n    \n    return actions\n\n  def find_closest_target(target_positions):\n    \"\"\"Helper function to find the closest target position.\"\"\"\n    pos_x, pos_y = env._current_state.pos\n    \n    min_distance = float('inf')\n    closest_pos = None\n    \n    for tx, ty in zip(*target_positions):\n        distance = abs(tx - pos_x) + abs(ty - pos_y)\n        if distance < min_distance:\n            min_distance = distance\n            closest_pos = (tx, ty)\n    \n    return closest_pos\n\n  def collect_primitives(primitive_index, count):\n    \"\"\"Helper function to generate actions to collect required primitives.\"\"\"\n    current_inventory = env._current_state.inventory\n    actions = []\n    \n    while current_inventory[primitive_index] < count:\n      primitive_positions = np.where(env._current_state.grid[:, :, primitive_index] > 0)\n      closest_primitive_pos = find_closest_target(primitive_positions)\n      \n      if closest_primitive_pos is not None:\n        tx, ty = closest_primitive_pos\n        actions.extend(move_to_position(tx, ty))\n        actions.append(ACTION_USE)  # Assuming USE is always the last action to collect primitive\n        current_inventory[primitive_index] += 1\n      else:\n        return [], False  # If no source for the primitive, return empty list and failure flag\n    \n    return actions, True\n\n  def use_workshop():\n    \"\"\"Helper function to generate actions to use a workshop.\"\"\"\n    for i, workshop in enumerate(env.world.workshop_indices):\n      workshop_positions = np.where(env._current_state.grid[:, :, workshop] > 0)\n      closest_workshop_pos = find_closest_target(workshop_positions)\n      \n      if closest_workshop_pos is not None:\n        tx, ty = closest_workshop_pos\n        actions = move_to_position(tx, ty)\n        actions.append(ACTION_USE)  # Assuming USE is always the last action to craft item\n        return actions\n    \n    return []  # If no workshop found\n\n  ACTION_UP = env.world.n_actions - 4 + 0\n  ACTION_DOWN = env.world.n_actions - 4 + 2\n  ACTION_LEFT = env.world.n_actions - 4 + 1\n  ACTION_RIGHT = env.world.n_actions - 4 + 3\n  ACTION_USE = env.world.n_actions - 1\n\n  actions = []\n  \n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all required primitives for crafting the item\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n\n  # Collect missing primitives\n  for prim, count in primitives_needed.items():\n    primitive_actions, success = collect_primitives(prim, count)\n    \n    if not success:\n      return []  # If no source for the primitive, return empty list\n    \n    actions.extend(primitive_actions)\n\n  # Find and use a workshop that has the required recipe\n  workshop_actions = use_workshop()\n  actions.extend(workshop_actions)\n\n  return actions", "island_id": 2, "scores": {"3": 2.0}}
{"timestamp": "2025-09-06T14:11:02.777314", "function_name": "craft", "function_body": "  def move_to_pos(pos):\n    current_pos = env._current_state.pos\n    path = bfs(current_pos, pos)\n    if not path:\n      return []\n    \n    action_map = {(-1, 0): craft.MOVE_FUNC(craft.UP), (1, 0): craft.MOVE_FUNC(craft.DOWN),\n                  (0, -1): craft.MOVE_FUNC(craft.LEFT), (0, 1): craft.MOVE_FUNC(craft.RIGHT)}\n    \n    actions = []\n    for i in range(1, len(path)):\n      dx = path[i][0] - path[i-1][0]\n      dy = path[i][1] - path[i-1][1]\n      action = action_map.get((dx, dy))\n      if action:\n        actions.append(action)\n    return actions\n\n  def bfs(start, end):\n    queue = collections.deque([start])\n    visited = set()\n    parent = {start: None}\n\n    while queue:\n      current = queue.popleft()\n      if current == end:\n        path = []\n        while current is not None:\n          path.append(current)\n          current = parent[current]\n        return path[::-1]\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = current[0] + dx, current[1] + dy\n        if 0 <= nx < env.world.grid.shape[0] and 0 <= ny < env.world.grid.shape[1]:\n          neighbor = (nx, ny)\n          if neighbor not in visited:\n            queue.append(neighbor)\n            visited.add(neighbor)\n            parent[neighbor] = current\n\n    return None\n  \n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the primitives required to craft the item\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n  inventory_counts = collections.Counter(env._current_state.inventory)\n\n  # If any primitive is missing, return an empty action list\n  for prim_idx, count in primitives_required.items():\n    if inventory_counts.get(prim_idx, 0) < count:\n      return []\n\n  actions = []\n  \n  # Find all workshops and their positions\n  workshop_positions = {}\n  for i in range(env.world.grid.shape[0]):\n    for j in range(env.world.grid.shape[1]):\n      kind = np.argmax(env.world.grid[i, j])\n      if kind in env.world.workshop_indices:\n        workshop_positions[kind] = (i, j)\n  \n  # If no workshops are found, return an empty action list\n  if not workshop_positions:\n    return []\n\n  # Determine which workshop to use based on the recipe\n  recipe = env.world.cookbook.recipes[item_index]\n  required_primitives = {prim_idx for prim_idx in primitives_required}\n  available_workshops = set(workshop_positions.keys())\n  \n  # Find a workshop that can craft the item\n  workshop_kind = None\n  for kind, pos in workshop_positions.items():\n    if kind in recipe or \"_key\" in recipe:\n      workshop_kind = kind\n      break\n  \n  if not workshop_kind:\n    return []\n\n  # Move to the chosen workshop\n  actions.extend(move_to_pos(workshop_positions[workshop_kind]))\n  \n  # Add the USE action to craft the item\n  actions.append(craft.CRAFT_FUNC(item_index))\n\n  # Check for additional requirements in the recipe (like \"_key\")\n  if \"_key\" in recipe:\n    key_item = recipe[\"_key\"]\n    if inventory_counts.get(key_item, 0) < 1:\n      return []\n    \n    # Assuming the key item is not already next to the workshop, we need to find it\n    # and move to its position before crafting.\n    key_positions = [(i, j) for i in range(env.world.grid.shape[0]) \n                     for j in range(env.world.grid.shape[1])\n                     if np.argmax(env.world.grid[i, j]) == key_item]\n    \n    if not key_positions:\n      return []\n    \n    # Choose the closest key position\n    closest_key_pos = min(key_positions, key=lambda p: abs(p[0] - workshop_positions[workshop_kind][0]) + abs(p[1] - workshop_positions[workshop_kind][1]))\n    \n    actions.extend(move_to_pos(closest_key_pos))\n    actions.append(craft.CRAFT_FUNC(item_index))\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
