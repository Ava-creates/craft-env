{"timestamp": "2025-09-06T15:23:02.728735", "function_name": "craft", "function_body": "  def get_workshop_index(item):\n    for recipe in env.world.cookbook.recipes.values():\n      if \"_key\" in recipe and recipe[\"_key\"] == item:\n        return recipe.get(\"workshop\", None)\n    return None\n\n  actions = []\n  \n  # Get the index of the item to craft\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all primitives required for crafting the item\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  inventory_counts = {env.world.cookbook.index.get(name, None): count for name, count in env._current_state.inventory.items()}\n  \n  for primitive_index, required_count in required_primitives.items():\n    if inventory_counts.get(primitive_index, 0) < required_count:\n      # If we don't have enough of a primitive, return an empty action list\n      return []\n    \n  workshop_index = get_workshop_index(item)\n  if workshop_index is None:\n    return []\n\n  # Add actions to move to the workshop and use it\n  actions.extend(move_to_workshop(env, workshop_index))\n  actions.append(env.world.cookbook.index[\"USE\"])\n  \n  return actions", "island_id": 6, "scores": {"3": -1}}
