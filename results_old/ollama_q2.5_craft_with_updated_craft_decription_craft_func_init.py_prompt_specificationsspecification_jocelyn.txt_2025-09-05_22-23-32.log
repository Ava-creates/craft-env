the primitive\n      \n      return actions_to_collect\n\n  def find_workshop_index_for_item(item_index: int, cookbook):\n      \"\"\"Find the workshop index required for crafting an item.\"\"\"\n      recipe = cookbook.recipes[item_index]\n      workshop_key = recipe.get(\"_key\", None)\n      \n      if workshop_key is not None:\n          for key, value in cookbook.recipes.items():\n              if \"_key\" in value and value[\"_key\"] == workshop_key:\n                  return key\n      return None\n\n  def check_and_collect_primitives(env, primitives_needed):\n      actions = []\n      missing_primitives = {primitive: count - env._current_state.inventory[primitive] \n                            for primitive, count in primitives_needed.items() \n                            if count > env._current_state.inventory[primitive]}\n      \n      # Collect all missing primitives\n      for primitive, count in missing_primitives.items():\n          while count > 0:\n              actions.extend(collect_primitive(env, primitive))\n              count -= 1\n      \n      return actions\n\n  def find_closest_workshop_position(grid: np.ndarray, workshop_index: int, current_pos: tuple):\n      workshop_positions = find_all_positions_of_kind(grid, workshop_index)\n      if not workshop_positions:\n          return None\n      nearest_workshop_pos = min(workshop_positions, key=lambda pos: distance(current_pos, pos))\n      return nearest_workshop_pos\n\n  def update_inventory(env, primitives_needed):\n      for primitive, count in primitives_needed.items():\n          while count > 0 and env._current_state.inventory[primitive] < count:\n              actions_to_collect = collect_primitive(env, primitive)\n              if not actions_to_collect:  # If no more positions of the primitive can be found\n                  return False, []\n              actions.extend(actions_to_collect)\n              count -= 1\n      return True, []\n\n  def update_environment_state(env, actions):\n      for action in actions:\n          reward, done, observations = env.step(action)\n          if done:\n              break\n\n  actions = []\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the primitives required for crafting\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  success, additional_actions = update_inventory(env, primitives_needed)\n  if not success:\n      return []\n  actions.extend(additional_actions)\n\n  # Find the workshop index needed to craft the item\n  workshop_index = find_workshop_index_for_item(item_index, env.world.cookbook)\n\n  if workshop_index is not None:\n      nearest_workshop_pos = find_closest_workshop_position(env._current_state.grid, workshop_index, env._current_state.pos)\n      \n      if nearest_workshop_pos is not None:\n          actions.extend(move_to_position(env._current_state.pos, nearest_workshop_pos))\n          \n          # Use the workshop to craft the item\n          actions.append(4)  # USE action\n  \n  return actions", "island_id": 1, "scores": {"3": 0.2}}
{"timestamp": "2025-09-06T11:24:44.111913", "function_name": "craft", "function_body": "  def find_all_positions_of_kind(grid, kind_index):\n      positions = []\n      for y in range(grid.shape[0]):\n          for x in range(grid.shape[1]):\n              if grid[y, x, kind_index] > 0:\n                  positions.append((x, y))\n      return positions\n\n  def distance(pos1, pos2):\n      return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n\n  def move_to_position(current_pos, target_pos):\n      actions = []\n      current_x, current_y = current_pos\n      target_x, target_y = target_pos\n      \n      # Move vertically first\n      while current_y < target_y:\n          actions.append(0)  # DOWN\n          current_y += 1\n      while current_y > target_y:\n          actions.append(1)  # UP\n          current_y -= 1\n      \n      # Then move horizontally\n      while current_x < target_x:\n          actions.append(2)  # LEFT\n          current_x += 1\n      while current_x > target_x:\n          actions.append(3)  # RIGHT\n          current_x -= 1\n      \n      return actions\n\n  def collect_primitives(env, primitives_needed):\n      actions = []\n      for primitive_index, count in primitives_needed.items():\n          if env._current_state.inventory[primitive_index] < count:\n              positions = find_all_positions_of_kind(env._current_state.grid, primitive_index)\n              if not positions:\n                  return []  # If no positions found, return empty action list\n              \n              nearest_position = min(positions, key=lambda pos: distance(env._current_state.pos, pos))\n              actions.extend(move_to_position(env._current_state.pos, nearest_position))\n              actions.append(4)  # USE to collect the primitive\n      return actions\n\n  def find_workshop_for_item(env, item_index):\n      recipe = env.world.cookbook.recipes[item_index]\n      workshop_key = recipe.get(\"_key\", None)\n      if workshop_key is not None:\n          for key, value in env.world.cookbook.recipes.items():\n              if \"_key\" in value and value[\"_key\"] == workshop_key:\n                  return key\n      return None\n\n  actions = []\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the primitives required for crafting\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  \n  # Collect missing primitives\n  actions.extend(collect_primitives(env, primitives_needed))\n  \n  # Find the workshop index needed to craft the item\n  workshop_index = find_workshop_for_item(env, item_index)\n\n  if workshop_index is not None:\n      workshop_positions = find_all_positions_of_kind(env._current_state.grid, workshop_index)\n      nearest_workshop_pos = min(workshop_positions, key=lambda pos: distance(env._current_state.pos, pos))\n      actions.extend(move_to_position(env._current_state.pos, nearest_workshop_pos))\n      \n      # Use the workshop to craft the item\n      actions.append(4)  # USE action\n  \n  return actions", "island_id": 1, "scores": {"3": 0.2}}
{"timestamp": "2025-09-06T11:24:45.300022", "function_name": "craft", "function_body": "  def find_all_positions_of_kind(grid, kind_index):\n    positions = []\n    for y in range(grid.shape[0]):\n      for x in range(grid.shape[1]):\n        if grid[y, x, kind_index] > 0:\n          positions.append((x, y))\n    return positions\n\n  def distance(pos1, pos2):\n    return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n\n  def move_to_position(current_pos, target_pos):\n    actions = []\n    current_x, current_y = current_pos\n    target_x, target_y = target_pos\n    \n    # Calculate the direction to move\n    dx = target_x - current_x\n    dy = target_y - current_y\n\n    if abs(dx) > abs(dy):\n      # Move horizontally first\n      while dx < 0:\n        actions.append(3)  # RIGHT\n        dx += 1\n      while dx > 0:\n        actions.append(2)  # LEFT\n        dx -= 1\n      \n      # Then move vertically\n      while dy < 0:\n        actions.append(1)  # UP\n        dy += 1\n      while dy > 0:\n        actions.append(0)  # DOWN\n        dy -= 1\n    else:\n      # Move vertically first\n      while dy < 0:\n        actions.append(1)  # UP\n        dy += 1\n      while dy > 0:\n        actions.append(0)  # DOWN\n        dy -= 1\n      \n      # Then move horizontally\n      while dx < 0:\n        actions.append(3)  # RIGHT\n        dx += 1\n      while dx > 0:\n        actions.append(2)  # LEFT\n        dx -= 1\n    \n    return actions\n\n  def collect_primitives(env, primitives_needed):\n    actions = []\n    for primitive_index, count in primitives_needed.items():\n      if env._current_state.inventory[primitive_index] < count:\n        positions = find_all_positions_of_kind(env._current_state.grid, primitive_index)\n        if not positions:\n          return []  # If no positions found, return empty action list\n        \n        nearest_position = min(positions, key=lambda pos: distance(env._current_state.pos, pos))\n        actions.extend(move_to_position(env._current_state.pos, nearest_position))\n        actions.append(4)  # USE to collect the primitive\n    return actions\n\n  def find_workshop_for_item(env, item_index):\n    for key, value in env.world.cookbook.recipes.items():\n      if \"_key\" in value and value[\"_key\"] == env.world.cookbook.recipes[item_index].get(\"_key\"):\n        return key\n    return None\n\n  actions = []\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the primitives required for crafting\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  \n  # Collect missing primitives\n  actions.extend(collect_primitives(env, primitives_needed))\n  \n  # Find the workshop index needed to craft the item\n  workshop_index = find_workshop_for_item(env, item_index)\n\n  if workshop_index is not None:\n    workshop_positions = find_all_positions_of_kind(env._current_state.grid, workshop_index)\n    nearest_workshop_pos = min(workshop_positions, key=lambda pos: distance(env._current_state.pos, pos))\n    actions.extend(move_to_position(env._current_state.pos, nearest_workshop_pos))\n    \n    # Use the workshop to craft the item\n    actions.append(4)  # USE action\n  \n  return actions", "island_id": 1, "scores": {"3": 0.0}}
