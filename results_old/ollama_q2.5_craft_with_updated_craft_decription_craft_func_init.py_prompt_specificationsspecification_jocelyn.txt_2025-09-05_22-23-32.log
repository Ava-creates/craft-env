{"timestamp": "2025-09-06T08:10:08.291771", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have a recipe for this item\n  if item_index not in env.world.cookbook.recipes:\n    return []  # No recipe, cannot craft\n  \n  # Collect required primitives\n  actions_to_take = []\n  recipe = env.world.cookbook.recipes[item_index]\n  \n  # Loop through the recipe to collect all required ingredients\n  for ingredient, count in recipe.items():\n    if ingredient == \"_key\":\n      continue  # Skip the _key entry which is used internally\n    \n    primitive_index = int(ingredient)\n    while env._current_state.inventory[primitive_index] < count:\n      actions_to_take.extend(collect(env, primitive_index))\n      \n  # Go to workshop and craft\n  workshop_indices = env.world.workshop_indices\n  \n  for workshop in workshop_indices:\n    if env._current_state.next_to(workshop):\n      actions_to_take.append(env.world.n_actions)  # Use action (index of USE)\n      return actions_to_take\n  \n  # If we are not next to any workshop, move towards the nearest one\n  min_distance = float('inf')\n  closest_workshop = None\n  \n  for workshop in workshop_indices:\n    distance = np.linalg.norm(np.array(env._current_state.pos) - np.array(workshop))\n    if distance < min_distance:\n      min_distance = distance\n      closest_workshop = workshop\n  \n  # Calculate the direction to move towards the closest workshop\n  dx, dy = closest_workshop[0] - env._current_state.pos[0], closest_workshop[1] - env._current_state.pos[1]\n  \n  if abs(dx) > abs(dy):\n    if dx > 0:\n      actions_to_take.append(3)  # RIGHT\n    else:\n      actions_to_take.append(2)  # LEFT\n  else:\n    if dy > 0:\n      actions_to_take.append(0)  # DOWN\n    else:\n      actions_to_take.append(1)  # UP\n  \n  actions_to_take.append(env.world.n_actions)  # USE action (index of USE)\n  \n  return actions_to_take", "is