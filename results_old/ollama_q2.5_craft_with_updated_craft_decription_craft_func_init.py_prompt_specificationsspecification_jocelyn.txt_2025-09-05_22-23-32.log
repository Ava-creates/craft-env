         return []\n\n  actions = []\n  \n  # Find all workshops and their positions\n  workshop_positions = {}\n  for i in range(env.world.grid.shape[0]):\n      for j in range(env.world.grid.shape[1]):\n          kind = np.argmax(env.world.grid[i, j])\n          if kind in env.world.workshop_indices:\n              workshop_positions[kind] = (i, j)\n  \n  # If no workshops are found, return an empty action list\n  if not workshop_positions:\n      return []\n\n  # Determine which workshop to use based on the recipe\n  recipe = env.world.cookbook.recipes[item_index]\n  required_primitives = {prim_idx for prim_idx in primitives_required}\n  available_workshops = set(workshop_positions.keys())\n  \n  # Find a workshop that can craft the item\n  workshop_kind = None\n  for kind, pos in workshop_positions.items():\n      if kind in recipe or \"_key\" in recipe:\n          workshop_kind = kind\n          break\n  \n  if not workshop_kind:\n      return []\n\n  # Move to the chosen workshop\n  actions.extend(move_to_pos(workshop_positions[workshop_kind]))\n  \n  # Add the USE action to craft the item\n  actions.append(craft.CRAFT_FUNC(item_index))\n\n  # Check if there are any additional items required in the recipe and collect them if needed\n  for key, value in recipe.items():\n      if key != \"_key\" and key not in primitives_required:\n          item_to_collect = env.world.cookbook.index.reverse(key)\n          actions.extend(collect(env, item_to_collect))\n  \n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T14:12:35.251795", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the item has a recipe; if not, return an empty action list\n  if item_index not in env.world.cookbook.recipes:\n    return []\n  \n  # Get the primitives required to craft the item\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  \n  actions = []\n  \n  # Check and collect the primitives needed\n  for primitive, count in primitives_needed.items():\n    current_count = env._current_state.inventory[primitive]\n    \n    if current_count < count:\n      # Calculate how many more of this primitive are needed\n      additional_needed = count - current_count\n      \n      # Collect the required amount of the primitive\n      collect_actions = collect_primitive(env, primitive, additional_needed)\n      actions.extend(collect_actions)\n      \n      # After collecting, check again if we have enough\n      updated_count = env._current_state.inventory[primitive]\n      if updated_count < count:\n        return []  # If still not enough, return an empty action list\n  \n  # Assuming we now have all primitives, go to the workshop and craft the item\n  workshop_index = env.world.cookbook.recipes[item_index].get(\"_key\", None)\n  \n  if workshop_index is not None:\n    # Find positions of available workshops of the required type\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index])\n    \n    if len(workshop_positions) == 0:\n      return []  # No available workshop\n    \n    # Choose the closest workshop\n    current_pos = env._current_state.pos\n    closest_workshop = min(workshop_positions, key=lambda pos: np.linalg.norm(np.array(pos) - np.array(current_pos)))\n    \n    # Move to the closest workshop\n    actions.extend(move_to_position(env, closest_workshop))\n    \n    # Use the workshop to craft the item\n    actions.append(craft.USE)\n  \n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-06T14:12:36.244256", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Retrieve primitives required to craft the item\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  \n  actions = []\n  \n  # Check if we have all the primitives needed in our inventory\n  for primitive, count in primitives_needed.items():\n    current_count = env._current_state.inventory[primitive]\n    \n    # If we don't have enough of this primitive, collect more\n    if current_count < count:\n      # Determine how many more we need\n      to_collect = count - current_count\n      \n      while to_collect > 0:\n        actions.extend(collect_primitive(env, primitive))\n        to_collect -= env._current_state.inventory[primitive]  # Update the collected amount\n  \n  # Assuming we have all primitives, go to the workshop and craft the item\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_index = recipe.get(\"_key\", None)\n  \n  if workshop_index is not None:\n    # Find position of the nearest workshop of the required type\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index])\n    \n    if len(workshop_positions) == 0:\n      return []  # No available workshop\n    \n    # Choose the closest workshop\n    current_pos = env._current_state.pos\n    closest_workshop = min(workshop_positions, key=lambda pos: np.linalg.norm(np.array(pos) - np.array(current_pos)))\n    \n    # Move to the closest workshop\n    actions.extend(move_to_position(env, closest_workshop))\n    \n    # Use the workshop to craft the item\n    actions.append(craft.USE)\n  \n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-06T14:13:36.517844", "function_name": "craft", "function_body": "  # Get the index for the desired item\n  item_idx = env.world.cookbook.index[item]\n\n  # Check if there's a recipe for this item in the cookbook\n  if item_idx not in env.world.cookbook.recipes:\n    return []\n\n  # Get the recipe for the item, which includes ingredients and their counts\n  recipe = env.world.cookbook.recipes[item_idx]\n  \n  actions = []\n  \n  # Check inventory to see what we need to collect\n  needed_ingredients = {}\n  for ingredient_idx, count in recipe.items():\n      if ingredient_idx != \"_key\":\n          required_count = count - env._current_state.inventory[ingredient_idx]\n          if required_count > 0:\n              needed_ingredients[ingredient_idx] = required_count\n\n  # Collect all the needed ingredients\n  for ingredient_idx, required_count in needed_ingredients.items():\n    ingredient_name = env.world.cookbook.index.get(ingredient_idx)\n    # Assuming collect_primitive is defined to return actions to collect a primitive\n    collect_actions = collect_primitive(env, ingredient_name)\n    actions.extend(collect_actions)\n\n  # Once we have all ingredients, go to the workshop and craft the item\n  workshop_idx = recipe[\"_key\"]\n  workshop_pos = env.world.workshop_indices[workshop_idx]\n  \n  # Move agent to the workshop position\n  move_to_workshop_actions = move_agent_to_position(env._current_state.pos, workshop_pos)\n  actions.extend(move_to_workshop_actions)\n\n  # Use action to craft the item\n  actions.append(craft.USE)\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-06T14:13:37.561113", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have a recipe for the item\n  if item_index not in env.world.cookbook.recipes:\n    return []  # No recipe available, cannot craft this item\n\n  # Get the primitives required for crafting the item\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n  \n  # Check if we have all the required primitives in our inventory\n  current_inventory = env._current_state.inventory\n  missing_primitives = {i: count for i, count in primitives_required.items() if current_inventory[i] < count}\n\n  if missing_primitives:\n    return []  # Missing some primitives, cannot craft this item\n  \n  actions = []\n\n  # Navigate to the workshop and perform the crafting action\n  workshop_index = None\n  for workshop in env.world.workshop_indices:\n      if any(env._current_state.next_to(primitive) for primitive in missing_primitives):\n          workshop_index = workshop\n          break\n\n  if workshop_index is not None:\n      actions.extend(navigate_to_workshop(env, workshop_index))\n      actions.append(4)  # USE action to craft the item\n  \n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T14:14:47.833631", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item is in the environment or can be crafted\n  if item_index not in env.world.cookbook.recipes:\n    print(f\"No recipe for {item}.\")\n    return []\n\n  # Collect all required primitives\n  actions = []\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  for primitive, count in required_primitives.items():\n      primitive_name = env.world.cookbook.index.get(primitive)\n      for _ in range(count):\n          collect_actions = collect_v2(env, primitive_name)\n          if not collect_actions:\n              return []\n          actions.extend(collect_actions)\n\n  # Go to the workshop and craft the item\n  # Assuming there is only one workshop index available in the list `env.world.workshop_indices`\n  workshop_index = env.world.workshop_indices[0]\n  move_to_workshop_actions = navigate(env, workshop_index)\n  if not move_to_workshop_actions:\n      return []\n  actions.extend(move_to_workshop_actions)\n\n  # Use action to craft the item\n  actions.append(4)  # Assuming USE is represented by index 4\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-06T14:14:48.864765", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  index = cookbook.index\n  \n  # Get the index of the item to craft\n  goal_index = index[item]\n  \n  # Check if we have all primitives required for crafting\n  required_primitives = cookbook.primitives_for(goal_index)\n  \n  actions = []\n  \n  # Collecting required primitives\n  for primitive, count in required_primitives.items():\n    primitive_name = index.get(primitive)\n    while env._current_state.inventory[primitive] < count:\n      actions.extend(collect(env, primitive_name))\n  \n  # Find the workshop to craft the item\n  recipe = cookbook.recipes[goal_index]\n  workshop = None\n  for ingredient in recipe:\n    if \"_key\" not in ingredient and ingredient != goal_index:\n      primitive_name = index.get(ingredient)\n      if primitive_name.startswith(\"workshop\"):\n        workshop = primitive\n        break\n  \n  if workshop is None:\n    raise ValueError(\"No workshop specified in the recipe.\")\n  \n  # Move to the workshop\n  actions.extend(move_to_workshop(env, workshop))\n  \n  # Perform USE action at the workshop\n  actions.append(4)  # Assuming USE action has index 4\n  \n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-06T14:18:50.174924", "function_name": "craft", "function_body": "  ACTION_UP = env.world.n_actions - 4 + 0\n  ACTION_DOWN = env.world.n_actions - 4 + 2\n  ACTION_LEFT = env.world.n_actions - 4 + 1\n  ACTION_RIGHT = env.world.n_actions - 4 + 3\n  ACTION_USE = env.world.n_actions - 1\n\n  def move_to_position(target_x, target_y):\n    \"\"\"Helper function to generate actions to move to a specific position.\"\"\"\n    actions = []\n    pos_x, pos_y = env._current_state.pos\n    \n    while pos_x != target_x or pos_y != target_y:\n      dx = target_x - pos_x\n      dy = target_y - pos_y\n      \n      if abs(dx) > abs(dy):\n        actions.append(ACTION_LEFT if dx < 0 else ACTION_RIGHT)\n      else:\n        actions.append(ACTION_DOWN if dy < 0 else ACTION_UP)\n      \n      pos_x += (-1 if dx < 0 else 1) if abs(dx) > abs(dy) else 0\n      pos_y += (-1 if dy < 0 else 1) if abs(dx) <= abs(dy) else 0\n    \n    return actions\n\n  def find_closest_target(target_positions):\n      \"\"\"Helper function to find the closest target position.\"\"\"\n      pos_x, pos_y = env._current_state.pos\n      \n      min_distance = float('inf')\n      closest_pos = None\n      \n      for tx, ty in zip(*target_positions):\n          distance = abs(tx - pos_x) + abs(ty - pos_y)\n          if distance < min_distance:\n              min_distance = distance\n              closest_pos = (tx, ty)\n      \n      return closest_pos\n\n  def pick_up_primitives(primitive_index, count):\n    \"\"\"Helper function to generate actions to pick up primitives.\"\"\"\n    actions = []\n    \n    while current_inventory[primitive_index] < count:\n      primitive_positions = np.where(env._current_state.grid[:, :, primitive_index] > 0)\n      closest_primitive_pos = find_closest_target(primitive_positions)\n      \n      if closest_primitive_pos is not None:\n        tx, ty = closest_primitive_pos\n        primitive_actions = move_to_position(tx, ty)\n        actions.extend(primitive_actions)\n        \n        # Perform USE action to collect the primitive\n        actions.append(ACTION_USE)\n        current_inventory[primitive_index] += 1\n      else:\n        return []  # If no source for the primitive, return empty list\n    \n    return actions\n\n  def use_workshop(workshop_index):\n    \"\"\"Helper function to generate actions to use a workshop.\"\"\"\n    target_pos_x, target_pos_y = np.where(env._current_state.grid[:, :, workshop_index] > 0)\n    \n    if len(target_pos_x) == 0 or len(target_pos_y) == 0:\n      return None\n    \n    # Move towards the nearest workshop and perform USE action\n    actions = move_to_position(target_pos_x[0], target_pos_y[0])\n    actions.append(ACTION_USE)  # Assuming USE is always the last action to craft item\n    return actions\n\n  def get_primitives_needed(item_index):\n    \"\"\"Helper function to get primitives needed for an item.\"\"\"\n    return env.world.cookbook.primitives_for(item_index)\n\n  actions = []\n  \n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all required primitives for crafting the item\n  primitives_needed = get_primitives_needed(item_index)\n  current_inventory = env._current_state.inventory\n\n  # Collect missing primitives\n  for prim, count in primitives_needed.items():\n    primitive_actions = pick_up_primitives(prim, count)\n    actions.extend(primitive_actions)\n\n  # Find and use a workshop that has the required recipe\n  for i, workshop in enumerate(env.world.workshop_indices):\n    if env._current_state.grid[:, :, workshop].any():  # Check if there's at least one workshop of this type\n      workshop_positions = np.where(env._current_state.grid[:, :, workshop] > 0)\n      closest_workshop_pos = find_closest_target(workshop_positions)\n      \n      if closest_workshop_pos is not None:\n        tx, ty = closest_workshop_pos\n        workshop_actions = move_to_position(tx, ty)\n        actions.extend(workshop_actions)\n        \n        # Perform USE action to craft the item\n        actions.append(ACTION_USE)\n        break\n\n  return actions", "island_id": 8, "scores": {"3": 2.0}}
{"timestamp": "2025-09-06T14:18:51.231635", "function_name": "craft", "function_body": "  def move_to_position(target_x, target_y):\n    \"\"\"Helper function to generate actions to move to a specific position.\"\"\"\n    actions = []\n    pos_x, pos_y = env._current_state.pos\n    \n    while pos_x != target_x or pos_y != target_y:\n      dx = target_x - pos_x\n      dy = target_y - pos_y\n      \n      if abs(dx) > abs(dy):\n        actions.append(ACTION_LEFT if dx < 0 else ACTION_RIGHT)\n      else:\n        actions.append(ACTION_DOWN if dy < 0 else ACTION_UP)\n      \n      pos_x += (-1 if dx < 0 else 1) if abs(dx) > abs(dy) else 0\n      pos_y += (-1 if dy < 0 else 1) if abs(dx) <= abs(dy) else 0\n    \n    return actions\n\n  def find_closest_target(target_positions):\n      \"\"\"Helper function to find the closest target position.\"\"\"\n      pos_x, pos_y = env._current_state.pos\n      \n      min_distance = float('inf')\n      closest_pos = None\n      \n      for tx, ty in zip(*target_positions):\n          distance = abs(tx - pos_x) + abs(ty - pos_y)\n          if distance < min_distance:\n              min_distance = distance\n              closest_pos = (tx, ty)\n      \n      return closest_pos\n\n  def pick_up_primitives(primitive_index, count):\n    \"\"\"Helper function to generate actions to pick up primitives.\"\"\"\n    actions = []\n    \n    while current_inventory[primitive_index] < count:\n      primitive_positions = np.where(env._current_state.grid[:, :, primitive_index] > 0)\n      closest_primitive_pos = find_closest_target(primitive_positions)\n      \n      if closest_primitive_pos is not None:\n        tx, ty = closest_primitive_pos\n        primitive_actions = move_to_position(tx, ty)\n        actions.extend(primitive_actions)\n        \n        # Perform USE action to collect the primitive\n        actions.append(ACTION_USE)\n        current_inventory[primitive_index] += 1\n      else:\n        return []  # If no source for the primitive, return empty list\n    \n    return actions\n\n  def get_primitives_needed(item_index):\n    \"\"\"Helper function to get primitives needed for an item.\"\"\"\n    return env.world.cookbook.primitives_for(item_index)\n\n  def plan_route_to_workshop(workshop_index):\n      \"\"\"Helper function to plan a route to the nearest workshop with required recipe.\"\"\"\n      target_pos_x, target_pos_y = np.where(env._current_state.grid[:, :, workshop_index] > 0)\n      \n      if len(target_pos_x) == 0 or len(target_pos_y) == 0:\n          return None\n      \n      closest_workshop_pos = find_closest_target((target_pos_x, target_pos_y))\n      \n      if closest_workshop_pos is not None:\n          tx, ty = closest_workshop_pos\n          actions = move_to_position(tx, ty)\n          actions.append(ACTION_USE)  # Assuming USE is always the last action to craft item\n          return actions\n      \n      return None\n\n  # Define action constants\n  ACTION_UP = env.world.n_actions - 4 + 0\n  ACTION_DOWN = env.world.n_actions - 4 + 2\n  ACTION_LEFT = env.world.n_actions - 4 + 1\n  ACTION_RIGHT = env.world.n_actions - 4 + 3\n  ACTION_USE = env.world.n_actions - 1\n\n  actions = []\n  \n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all required primitives for crafting the item\n  primitives_needed = get_primitives_needed(item_index)\n  current_inventory = env._current_state.inventory\n\n  # Collect missing primitives\n  for prim, count in primitives_needed.items():\n    primitive_actions = pick_up_primitives(prim, count)\n    actions.extend(primitive_actions)\n\n  # Plan and execute the route to the nearest workshop with required recipe\n  for workshop_index in env.world.workshop_indices:\n      if plan_route_to_workshop(workshop_index) is not None:\n          workshop_actions = plan_route_to_workshop(workshop_index)\n          actions.extend(workshop_actions)\n          break\n\n  return actions", "island_id": 8, "scores": {"3": 2.0}}
{"timestamp": "2025-09-06T14:20:49.170865", "function_name": "craft", "function_body": "  actions = []\n  \n  # Convert item name to index using the cookbook index\n  if item not in env.world.cookbook.index:\n    print(f\"Item '{item}' not found in cookbook.\")\n    return actions\n  \n  goal_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the primitives required for crafting\n  primitives_needed = env.world.cookbook.primitives_for(goal_index)\n  inventory = env._current_state.inventory.copy()\n  \n  for primitive_index, count in primitives_needed.items():\n    if inventory[primitive_index] < count:\n      print(f\"Not enough {env.world.cookbook.index.get(primitive_index)} to craft {item}.\")\n      return actions\n\n  # If we have all the primitives, proceed to craft\n  recipe = env.world.cookbook.recipes[goal_index]\n  \n  for ingredient_index, count in recipe.items():\n    if ingredient_index != \"_key\":\n      while inventory[ingredient_index] < count:\n        # Collect more of this ingredient if needed\n        actions.extend(collect_v2(env, env.world.cookbook.index.get(ingredient_index)))\n        inventory = env._current_state.inventory.copy()\n  \n  # Move to the workshop specified in the recipe\n  if \"_key\" in recipe:\n    workshop_type = recipe[\"_key\"]\n    workshop_index = next((i for i, w in enumerate(env.world.workshop_indices) \n                           if env.world.cookbook.index.get(workshop_type) == w), None)\n    \n    if workshop_index is not None:\n      # Implement logic to move the agent to a specific workshop\n      actions.extend(move_to_workshop_v2(env, workshop_index))\n    else:\n      print(f\"No workshop found for {workshop_type} required to craft {item}.\")\n      return actions\n  \n  # Use the workshop to craft the item\n  actions.append(4)  # Assuming USE action index is 4\n  \n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-06T14:20:50.176920", "function_name": "craft", "function_body": "  # Get the index of the desired item using the cookbook's index\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the recipe for the item exists in the cookbook\n  if item_index not in env.world.cookbook.recipes:\n    print(f\"No recipe found for {item}.\")\n    return []\n  \n  # Get the primitives required to craft the item and their counts\n  primitives = env.world.cookbook.primitives_for(item_index)\n  \n  # Initialize an empty list of actions\n  actions = []\n\n  # Collect all primitives needed for crafting\n  for primitive, count in primitives.items():\n      primitive_name = env.world.cookbook.index.get(primitive, \"Unknown\")\n      \n      if primitive_name == \"Unknown\":\n          print(f\"Primitive index {primitive} not found in the cookbook.\")\n          return []\n      \n      # Collect each primitive required by the recipe\n      collect_primitive_actions = collect(env, primitive_name)\n      actions.extend(collect_primitive_actions)\n\n  # Craft the item using the workshop specified in the recipe\n  if \"_key\" in env.world.cookbook.recipes[item_index]:\n    workshop_index = env.world.cookbook.recipes[item_index][\"_key\"]\n    workshop_name = env.world.cookbook.index.get(workshop_index, \"Unknown\")\n    \n    if workshop_name == \"Unknown\":\n        print(f\"Workshop index {workshop_index} not found in the cookbook.\")\n        return []\n    \n    # Move to the workshop\n    move_to_workshop_actions = move(env, workshop_name)\n    actions.extend(move_to_workshop_actions)\n\n  # Perform the USE action at the workshop to craft the item\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-06T14:24:51.235007", "function_name": "craft", "function_body": "  def get_action_mapping():\n    \"\"\"Helper function to define action mapping.\"\"\"\n    ACTION_UP = env.world.n_actions - 4 + 0\n    ACTION_DOWN = env.world.n_actions - 4 + 2\n    ACTION_LEFT = env.world.n_actions - 4 + 1\n    ACTION_RIGHT = env.world.n_actions - 4 + 3\n    ACTION_USE = env.world.n_actions - 1\n\n    return {\n        'UP': ACTION_UP,\n        'DOWN': ACTION_DOWN,\n        'LEFT': ACTION_LEFT,\n        'RIGHT': ACTION_RIGHT,\n        'USE': ACTION_USE\n    }\n\n  def move_to_position(target_x, target_y):\n    \"\"\"Helper function to generate actions to move to a specific position.\"\"\"\n    actions = []\n    pos_x, pos_y = env._current_state.pos\n    \n    while pos_x != target_x or pos_y != target_y:\n      dx = target_x - pos_x\n      dy = target_y - pos_y\n      \n      if abs(dx) > abs(dy):\n        actions.append(action_mapping['LEFT'] if dx < 0 else action_mapping['RIGHT'])\n      else:\n        actions.append(action_mapping['DOWN'] if dy < 0 else action_mapping['UP'])\n      \n      pos_x += (-1 if dx < 0 else 1) if abs(dx) > abs(dy) else 0\n      pos_y += (-1 if dy < 0 else 1) if abs(dx) <= abs(dy) else 0\n    \n    return actions\n\n  def find_closest_target(target_positions):\n      \"\"\"Helper function to find the closest target position.\"\"\"\n      pos_x, pos_y = env._current_state.pos\n      \n      min_distance = float('inf')\n      closest_pos = None\n      \n      for tx, ty in zip(*target_positions):\n          distance = abs(tx - pos_x) + abs(ty - pos_y)\n          if distance < min_distance:\n              min_distance = distance\n              closest_pos = (tx, ty)\n      \n      return closest_pos\n\n  def pick_up_primitives(primitive_index, count):\n    \"\"\"Helper function to generate actions to pick up primitives.\"\"\"\n    actions = []\n    \n    while current_inventory[primitive_index] < count:\n      primitive_positions = np.where(env._current_state.grid[:, :, primitive_index] > 0)\n      closest_primitive_pos = find_closest_target(primitive_positions)\n      \n      if closest_primitive_pos is not None:\n        tx, ty = closest_primitive_pos\n        primitive_actions = move_to_position(tx, ty)\n        actions.extend(primitive_actions)\n        \n        # Perform USE action to collect the primitive\n        actions.append(action_mapping['USE'])\n        current_inventory[primitive_index] += 1\n      else:\n        return []  # If no source for the primitive, return empty list\n    \n    return actions\n\n  def use_workshop(workshop_index):\n    \"\"\"Helper function to generate actions to use a workshop.\"\"\"\n    target_pos_x, target_pos_y = np.where(env._current_state.grid[:, :, workshop_index] > 0)\n    \n    if len(target_pos_x) == 0 or len(target_pos_y) == 0:\n      return None\n    \n    # Move towards the nearest workshop and perform USE action\n    actions = move_to_position(target_pos_x[0], target_pos_y[0])\n    actions.append(action_mapping['USE'])  # Assuming USE is always the last action to craft item\n    return actions\n\n  def get_primitives_needed(item_index):\n    \"\"\"Helper function to get primitives needed for an item.\"\"\"\n    return env.world.cookbook.primitives_for(item_index)\n\n  action_mapping = get_action_mapping()\n  \n  actions = []\n  \n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all required primitives for crafting the item\n  primitives_needed = get_primitives_needed(item_index)\n  current_inventory = env._current_state.inventory\n\n  # Collect missing primitives\n  for prim, count in primitives_needed.items():\n    primitive_actions = pick_up_primitives(prim, count)\n    actions.extend(primitive_actions)\n\n  # Find and use a workshop that has the required recipe\n  for i, workshop in enumerate(env.world.workshop_indices):\n    if env._current_state.grid[:, :, workshop].any():  # Check if there's at least one workshop of this type\n      workshop_positions = np.where(env._current_state.grid[:, :, workshop] > 0)\n      closest_workshop_pos = find_closest_target(workshop_positions)\n      \n      if closest_workshop_pos is not None:\n        tx, ty = closest_workshop_pos\n        workshop_actions = move_to_position(tx, ty)\n        actions.extend(workshop_actions)\n        \n        # Perform USE action to craft the item\n        actions.append(action_mapping['USE'])\n        break\n\n  return actions", "island_id": 8, "scores": {"3": 2.0}}
