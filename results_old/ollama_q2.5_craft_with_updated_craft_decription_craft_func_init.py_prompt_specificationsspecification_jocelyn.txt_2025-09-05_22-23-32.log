{"timestamp": "2025-09-06T08:33:51.492186", "function_name": "craft", "function_body": "  def has_primitives(primitives):\n    for primitive, count in primitives.items():\n      if env._current_state.inventory[primitive] < count:\n        return False\n    return True\n\n  def move_to_position(current_pos, target_pos):\n    actions = []\n    \n    # Calculate the direction to move\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n    \n    # Determine vertical moves first (UP or DOWN)\n    if dx > 0:\n      actions.extend([1] * abs(dx))  # DOWN\n    elif dx < 0:\n      actions.extend([0] * abs(dx))  # UP\n    \n    # Determine horizontal moves next (LEFT or RIGHT)\n    if dy > 0:\n      actions.extend([3] * abs(dy))  # RIGHT\n    elif dy < 0:\n      actions.extend([2] * abs(dy))  # LEFT\n    \n    return actions\n\n  def get_closest_workshop_position(grid, workshop_index):\n    positions_next_to_workshop = np.argwhere(grid[:, :, workshop_index] > 0)\n    \n    if len(positions_next_to_workshop) == 0:\n      return None\n    \n    current_pos = np.array(env._current_state.pos)\n    distances = np.linalg.norm(current_pos - positions_next_to_workshop, axis=1)\n    closest_idx = np.argmin(distances)\n    \n    return tuple(positions_next_to_workshop[closest_idx])\n\n  # Get the index of the item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the primitives needed to craft the item\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  if not has_primitives(required_primitives):\n    return []\n  \n  # Get workshop index from recipe (assuming there is only one workshop specified in the recipe)\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_index = next(i for i, count in recipe.items() if i != \"_key\")\n  \n  # Find the closest position next to the workshop\n  target_pos = get_closest_workshop_position(env._current_state.grid, workshop_index)\n  \n  if not target_pos:\n    return []\n  \n  # Move to the chosen position\n  actions_to_target = move_to_position(env._current_state.pos, target_pos)\n  if not actions_to_target:\n    return []\n  \n  # Add USE action to craft the item\n  use_action = env.world.n_actions - 1  # Assuming USE is the last action\n  \n  # Combine all actions\n  actions = actions_to_target + [use_action]\n  \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T08:33:52.575270", "function_name": "craft", "function_body": "  def has_primitives(primitives):\n    for primitive, count in primitives.items():\n      if env._current_state.inventory[primitive] < count:\n        return False\n    return True\n\n  def move_to_position(env, target_pos):\n    current_pos = np.array(env._current_state.pos)\n    actions = []\n\n    # Calculate the direction to move\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    # Determine vertical moves first (UP or DOWN)\n    if dx > 0:\n      actions.extend([1] * abs(dx))  # DOWN\n    elif dx < 0:\n      actions.extend([0] * abs(dx))  # UP\n\n    # Determine horizontal moves next (LEFT or RIGHT)\n    if dy > 0:\n      actions.extend([3] * abs(dy))  # RIGHT\n    elif dy < 0:\n      actions.extend([2] * abs(dy))  # LEFT\n\n    return actions\n\n  def get_closest_workshop_position(env, workshop_index):\n    grid = env._current_state.grid\n    positions_next_to_workshop = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if len(positions_next_to_workshop) == 0:\n      return None\n\n    current_pos = np.array(env._current_state.pos)\n    distances = np.linalg.norm(current_pos - positions_next_to_workshop, axis=1)\n    closest_idx = np.argmin(distances)\n\n    return tuple(positions_next_to_workshop[closest_idx])\n\n  def get_required_primitives(item_index):\n    return env.world.cookbook.primitives_for(item_index)\n\n  # Get the index of the item\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the primitives needed to craft the item\n  required_primitives = get_required_primitives(item_index)\n  if not has_primitives(required_primitives):\n    return []\n\n  # Get workshop indices from recipe (assuming multiple workshops could be involved in crafting)\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_indices = [i for i, count in recipe.items() if i != \"_key\"]\n\n  actions = []\n  for workshop_index in workshop_indices:\n    # Find the closest position next to the workshop\n    target_pos = get_closest_workshop_position(env, workshop_index)\n    if not target_pos:\n      return []\n\n    # Move to the chosen position\n    actions_to_target = move_to_position(env, target_pos)\n    if not actions_to_target:\n      return []\n\n    # Add USE action to craft the item\n    use_action = env.world.n_actions - 1  # Assuming USE is the last action\n\n    # Combine all actions\n    actions.extend(actions_to_target + [use_action])\n\n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T08:39:03.139677", "function_name": "craft", "function_body": "  ACTION_UP = env.world.n_actions - 4 + 0\n  ACTION_DOWN = env.world.n_actions - 4 + 2\n  ACTION_LEFT = env.world.n_actions - 4 + 1\n  ACTION_RIGHT = env.world.n_actions - 4 + 3\n  ACTION_USE = env.world.n_actions - 1\n\n  def move_to_position(target_x, target_y):\n    \"\"\"Helper function to generate actions to move to a specific position.\"\"\"\n    actions = []\n    pos_x, pos_y = env._current_state.pos\n    \n    while pos_x != target_x or pos_y != target_y:\n      dx = target_x - pos_x\n      dy = target_y - pos_y\n      \n      if abs(dx) > abs(dy):\n        actions.append(ACTION_LEFT if dx < 0 else ACTION_RIGHT)\n      else:\n        actions.append(ACTION_DOWN if dy < 0 else ACTION_UP)\n      \n      pos_x += (-1 if dx < 0 else 1) if abs(dx) > abs(dy) else 0\n      pos_y += (-1 if dy < 0 else 1) if abs(dx) <= abs(dy) else 0\n    \n    return actions\n\n  def find_closest_target(target_positions):\n      \"\"\"Helper function to find the closest target position.\"\"\"\n      pos_x, pos_y = env._current_state.pos\n      \n      min_distance = float('inf')\n      closest_pos = None\n      \n      for tx, ty in zip(*target_positions):\n          distance = abs(tx - pos_x) + abs(ty - pos_y)\n          if distance < min_distance:\n              min_distance = distance\n              closest_pos = (tx, ty)\n      \n      return closest_pos\n\n  def pick_up_primitives(primitive_index, count):\n    \"\"\"Helper function to generate actions to pick up primitives.\"\"\"\n    actions = []\n    \n    while current_inventory[primitive_index] < count:\n      primitive_positions = np.where(env._current_state.grid[:, :, primitive_index] > 0)\n      closest_primitive_pos = find_closest_target(primitive_positions)\n      \n      if closest_primitive_pos is not None:\n        tx, ty = closest_primitive_pos\n        primitive_actions = move_to_position(tx, ty)\n        actions.extend(primitive_actions)\n        \n        # Perform USE action to collect the primitive\n        actions.append(ACTION_USE)\n        current_inventory[primitive_index] += 1\n      else:\n        return []  # If no source for the primitive, return empty list\n    \n    return actions\n\n  def use_workshop(workshop_index):\n    \"\"\"Helper function to generate actions to use a workshop.\"\"\"\n    target_pos_x, target_pos_y = np.where(env._current_state.grid[:, :, workshop_index] > 0)\n    \n    if len(target_pos_x) == 0 or len(target_pos_y) == 0:\n      return None\n    \n    # Move towards the nearest workshop and perform USE action\n    actions = []\n    for tx, ty in zip(target_pos_x, target_pos_y):\n        actions.extend(move_to_position(tx, ty))\n        actions.append(ACTION_USE)\n    \n    return actions\n\n  def get_primitives_needed(item_index):\n      \"\"\"Helper function to get primitives needed for an item.\"\"\"\n      return env.world.cookbook.primitives_for(item_index)\n\n  actions = []\n  \n  # Get the index of the desired item\n  if item not in env.world.cookbook.index:\n    return []  # Return empty list if item is not in cookbook\n  \n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all required primitives for crafting the item\n  primitives_needed = get_primitives_needed(item_index)\n  current_inventory = env._current_state.inventory\n\n  # Collect missing primitives\n  for prim, count in primitives_needed.items():\n    primitive_actions = pick_up_primitives(prim, count)\n    actions.extend(primitive_actions)\n\n  # Find and use a workshop that has the required recipe\n  found_workshop = False\n  for i, workshop in enumerate(env.world.workshop_indices):\n    if env._current_state.grid[:, :, workshop].any():  # Check if there's at least one workshop of this type\n      workshop_positions = np.where(env._current_state.grid[:, :, workshop] > 0)\n      \n      # Try each workshop found\n      for tx, ty in zip(*workshop_positions):\n          actions.extend(move_to_position(tx, ty))\n          actions.append(ACTION_USE)  # Assuming USE is always the last action to craft item\n          found_workshop = True\n          break\n      \n    if found_workshop:\n        break\n\n  if not found_workshop:\n    return []  # Return empty list if no suitable workshop is found\n\n  return actions", "island_id": 8, "scores": {"3": 2.0}}
{"timestamp": "2025-09-06T08:39:04.219514", "function_name": "craft", "function_body": "  ACTION_UP = env.world.n_actions - 4 + 0\n  ACTION_DOWN = env.world.n_actions - 4 + 2\n  ACTION_LEFT = env.world.n_actions - 4 + 1\n  ACTION_RIGHT = env.world.n_actions - 4 + 3\n  ACTION_USE = env.world.n_actions - 1\n\n  def move_to_position(target_x, target_y):\n    \"\"\"Helper function to generate actions to move to a specific position.\"\"\"\n    actions = []\n    pos_x, pos_y = env._current_state.pos\n    \n    while pos_x != target_x or pos_y != target_y:\n      dx = target_x - pos_x\n      dy = target_y - pos_y\n      \n      if abs(dx) > abs(dy):\n        actions.append(ACTION_LEFT if dx < 0 else ACTION_RIGHT)\n      else:\n        actions.append(ACTION_DOWN if dy < 0 else ACTION_UP)\n      \n      pos_x += (-1 if dx < 0 else 1) if abs(dx) > abs(dy) else 0\n      pos_y += (-1 if dy < 0 else 1) if abs(dx) <= abs(dy) else 0\n    \n    return actions\n\n  def find_closest_target(target_positions):\n      \"\"\"Helper function to find the closest target position.\"\"\"\n      pos_x, pos_y = env._current_state.pos\n      \n      min_distance = float('inf')\n      closest_pos = None\n      \n      for tx, ty in zip(*target_positions):\n          distance = abs(tx - pos_x) + abs(ty - pos_y)\n          if distance < min_distance:\n              min_distance = distance\n              closest_pos = (tx, ty)\n      \n      return closest_pos\n\n  def pick_up_primitives(primitive_index, count):\n    \"\"\"Helper function to generate actions to pick up primitives.\"\"\"\n    actions = []\n    \n    while current_inventory[primitive_index] < count:\n      primitive_positions = np.where(env._current_state.grid[:, :, primitive_index] > 0)\n      closest_primitive_pos = find_closest_target(primitive_positions)\n      \n      if closest_primitive_pos is not None:\n        tx, ty = closest_primitive_pos\n        primitive_actions = move_to_position(tx, ty)\n        actions.extend(primitive_actions)\n        \n        # Perform USE action to collect the primitive\n        actions.append(ACTION_USE)\n        current_inventory[primitive_index] += 1\n      else:\n        return []  # If no source for the primitive, return empty list\n    \n    return actions\n\n  def use_workshop(workshop_index):\n    \"\"\"Helper function to generate actions to use a workshop.\"\"\"\n    target_pos_x, target_pos_y = np.where(env._current_state.grid[:, :, workshop_index] > 0)\n    \n    if len(target_pos_x) == 0 or len(target_pos_y) == 0:\n      return None\n    \n    # Move towards the nearest workshop and perform USE action\n    actions = move_to_position(target_pos_x[0], target_pos_y[0])\n    actions.append(ACTION_USE)  # Assuming USE is always the last action to craft item\n    return actions\n\n  def get_primitives_needed(item_index):\n      \"\"\"Helper function to get primitives needed for an item.\"\"\"\n      return env.world.cookbook.primitives_for(item_index)\n\n  def check_inventory():\n      \"\"\"Check if all required items are in inventory.\"\"\"\n      current_inventory = env._current_state.inventory\n      primitives_needed = get_primitives_needed(item_index)\n      \n      for prim, count in primitives_needed.items():\n          if current_inventory[prim] < count:\n              return False\n      return True\n\n  actions = []\n  \n  # Get the index of the desired item\n  if item not in env.world.cookbook.index:\n    return []  # Return empty list if item is not in cookbook\n  \n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we already have all required primitives for crafting the item\n  if check_inventory():\n    print(f\"All primitives for {item} are already in inventory.\")\n    found_workshop = False\n    for i, workshop in enumerate(env.world.workshop_indices):\n      if env._current_state.grid[:, :, workshop].any():  # Check if there's at least one workshop of this type\n        workshop_positions = np.where(env._current_state.grid[:, :, workshop] > 0)\n        closest_workshop_pos = find_closest_target(workshop_positions)\n        \n        if closest_workshop_pos is not None:\n          tx, ty = closest_workshop_pos\n          workshop_actions = move_to_position(tx, ty)\n          actions.extend(workshop_actions)\n          \n          # Perform USE action to craft the item\n          actions.append(ACTION_USE)\n          found_workshop = True\n          break\n\n    if not found_workshop:\n      return []  # Return empty list if no suitable workshop is found\n\n    return actions\n\n  # If inventory check fails, collect missing primitives\n  current_inventory = env._current_state.inventory\n  primitives_needed = get_primitives_needed(item_index)\n\n  for prim, count in primitives_needed.items():\n    primitive_actions = pick_up_primitives(prim, count)\n    actions.extend(primitive_actions)\n\n  # Find and use a workshop that has the required recipe\n  found_workshop = False\n  for i, workshop in enumerate(env.world.workshop_indices):\n    if env._current_state.grid[:, :, workshop].any():  # Check if there's at least one workshop of this type\n      workshop_positions = np.where(env._current_state.grid[:, :, workshop] > 0)\n      closest_workshop_pos = find_closest_target(workshop_positions)\n      \n      if closest_workshop_pos is not None:\n        tx, ty = closest_workshop_pos\n        workshop_actions = move_to_position(tx, ty)\n        actions.extend(workshop_actions)\n        \n        # Perform USE action to craft the item\n        actions.append(ACTION_USE)\n        found_workshop = True\n        break\n\n  if not found_workshop:\n    return []  # Return empty list if no suitable workshop is found\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-06T08:40:00.819659", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index for the item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all required primitives and ingredients\n  if not has_primitives_for(env, item_index):\n    return []\n\n  # Collect all required primitives\n  actions.extend(collect_required_primitives(env, item_index))\n\n  # Find the workshop index from the recipe\n  workshop_index = find_workshop_index_from_recipe(env.world.cookbook.recipes[item_index])\n\n  # Move to the workshop and craft the item\n  actions.extend(move_to_workshop_and_craft(env, workshop_index, item_index))\n  \n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-06T08:40:01.814572", "function_name": "craft", "function_body": "  # Get the index for the desired item\n  goal_index = env.world.cookbook.index[item]\n\n  # Retrieve the primitives required to craft the goal\n  primitives_needed = env.world.cookbook.primitives_for(goal_index)\n\n  if not primitives_needed:\n    print(f\"No recipe found for {item}.\")\n    return []\n\n  actions = []\n  \n  # Collect all the primitives needed\n  for primitive, count in primitives_needed.items():\n    primitive_name = env.world.cookbook.index.get(primitive)\n    \n    while env._current_state.inventory[primitive] < count:\n      # Generate a scenario to collect the primitive if not enough is available\n      collect_actions = collect(env, primitive_name)\n      actions.extend(collect_actions)\n\n  # Now craft the item at the appropriate workshop\n  recipe = env.world.cookbook.recipes.get(goal_index, {})\n  if \"_key\" in recipe:\n    workshop_type = int(recipe[\"_key\"])\n    workshop_index = env.world.workshop_indices[workshop_type]\n\n    # Navigate to the workshop\n    navigate_actions = navigate_to_workshop(env._current_state, workshop_index)\n    actions.extend(navigate_actions)\n\n    # Perform the crafting action at the workshop\n    actions.append(4)  # Use action\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-06T08:42:27.211810", "function_name": "craft", "function_body": "  def navigate_to_workshop_actions(pos, target_pos):\n    dx = target_pos[0] - pos[0]\n    dy = target_pos[1] - pos[1]\n\n    actions = []\n    if dx > 0:\n        actions.extend([env.world.RIGHT for _ in range(abs(dx))])\n    elif dx < 0:\n        actions.extend([env.world.LEFT for _ in range(abs(dx))])\n\n    if dy > 0:\n        actions.extend([env.world.DOWN for _ in range(abs(dy))])\n    elif dy < 0:\n        actions.extend([env.world.UP for _ in range(abs(dy))])\n\n    return actions\n\n  def manhattan_distance(pos1, pos2):\n      return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n\n  def find_workshop_position(env, workshop_index):\n    grid = env._current_state.grid\n    positions = np.argwhere(grid[:, :, workshop_index] == 1)\n    if positions.size > 0:\n        return tuple(positions[0])\n    else:\n        raise ValueError(f\"No position found for workshop index {workshop_index}\")\n\n  actions = []\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  # Check if we have all required primitives in our inventory\n  required_primitives = cookbook.primitives_for(goal_index)\n  missing_items = {primitive: count - env._current_state.inventory[primitive] for primitive, count in required_primitives.items() if env._current_state.inventory[primitive] < count}\n  \n  if missing_items:\n    return []  # Not enough primitives to craft the item\n\n  # Find a workshop to perform crafting\n  recipe = cookbook.recipes.get(goal_index, {})\n  workshop_indices = [ingredient for ingredient in recipe.keys() \n                      if ingredient in env.world.workshop_indices and ingredient != \"_key\"]\n\n  if not workshop_indices:\n    return []  # No suitable workshop found\n  \n  # Sort workshops by distance to the nearest one\n  distances = {workshop: manhattan_distance(env._current_state.pos, find_workshop_position(env, workshop)) for workshop in workshop_indices}\n  closest_workshop_index = min(distances, key=distances.get)\n  \n  # Navigate to the nearest workshop\n  target_pos = find_workshop_position(env, closest_workshop_index)\n  actions.extend(navigate_to_workshop_actions(env._current_state.pos, target_pos))\n\n  # Perform USE action at the workshop to craft the item\n  actions.append(env.world.N_ACTIONS - 1)  # Assuming USE is the last action index (N_ACTIONS - 1)\n\n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T08:42:28.300391", "function_name": "craft", "function_body": "  def navigate_to_workshop_actions(pos, target_pos):\n    dx = target_pos[0] - pos[0]\n    dy = target_pos[1] - pos[1]\n\n    actions = []\n    # Prioritize moving in the direction that reduces manhattan distance\n    if abs(dx) > abs(dy):\n      if dx > 0:\n        actions.extend([env.world.RIGHT for _ in range(abs(dx))])\n      else:\n        actions.extend([env.world.LEFT for _ in range(abs(dx))])\n      if dy > 0:\n        actions.extend([env.world.DOWN for _ in range(abs(dy))])\n      else:\n        actions.extend([env.world.UP for _ in range(abs(dy))])\n    else:\n      if dy > 0:\n        actions.extend([env.world.DOWN for _ in range(abs(dy))])\n      else:\n        actions.extend([env.world.UP for _ in range(abs(dy))])\n      if dx > 0:\n        actions.extend([env.world.RIGHT for _ in range(abs(dx))])\n      else:\n        actions.extend([env.world.LEFT for _ in range(abs(dx))])\n\n    return actions\n\n  def manhattan_distance(pos1, pos2):\n      return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n\n  def find_workshop_position(env, workshop_index):\n    grid = env._current_state.grid\n    positions = np.argwhere(grid[:, :, workshop_index] == 1)\n    if positions.size > 0:\n        return tuple(positions[0])\n    else:\n        raise ValueError(f\"No position found for workshop index {workshop_index}\")\n\n  actions = []\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  # Check if we have all required primitives in our inventory\n  required_primitives = cookbook.primitives_for(goal_index)\n  for primitive, count in required_primitives.items():\n      if env._current_state.inventory[primitive] < count:\n          return []  # Not enough primitives to craft the item\n\n  # Find a workshop to perform crafting\n  recipe = cookbook.recipes.get(goal_index, {})\n  workshop_indices = [ingredient for ingredient in recipe.keys() \n                      if ingredient in env.world.workshop_indices and ingredient != \"_key\"]\n\n  if not workshop_indices:\n      return []  # No suitable workshop found\n  \n  # Sort workshops by distance to the nearest one\n  distances = {workshop: manhattan_distance(env._current_state.pos, find_workshop_position(env, workshop)) for workshop in workshop_indices}\n  closest_workshop_index = min(distances, key=distances.get)\n  \n  # Navigate to the nearest workshop\n  target_pos = find_workshop_position(env, closest_workshop_index)\n  actions.extend(navigate_to_workshop_actions(env._current_state.pos, target_pos))\n\n  # Perform USE action at the workshop to craft the item\n  actions.append(env.world.N_ACTIONS - 1)  # Assuming USE is the last action index (N_ACTIONS - 1)\n\n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T08:44:16.352293", "function_name": "craft", "function_body": "  actions = []\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n  \n  # Check if we have all required primitives in our inventory\n  required_primitives = cookbook.primitives_for(goal_index)\n  for primitive, count in required_primitives.items():\n    if env._current_state.inventory[primitive] < count:\n      return []  # Not enough primitives to craft the item\n\n  # Find a workshop to perform crafting\n  recipe = cookbook.recipes.get(goal_index, {})\n  workshop_indices = [ingredient for ingredient in recipe.keys() \n                      if ingredient in env.world.workshop_indices and ingredient != \"_key\"]\n\n  if not workshop_indices:\n    return []  # No suitable workshop found\n  \n  # Sort workshops by distance to the nearest one\n  distances = {workshop: manhattan_distance(env._current_state.pos, find_workshop_position(env, workshop)) for workshop in workshop_indices}\n  closest_workshop_index = min(distances, key=distances.get)\n\n  # Navigate to the nearest workshop\n  actions.extend(navigate_to_workshop(env, closest_workshop_index))\n\n  # Perform USE action at the workshop to craft the item\n  actions.append(env.world.N_ACTIONS - 1)  # Assuming USE is the last action index (N_ACTIONS - 1)\n\n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T08:44:17.406231", "function_name": "craft", "function_body": "  def manhattan_distance(pos1: tuple, pos2: tuple):\n      return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n\n  def find_workshop_position(env, workshop_index):\n      for x in range(env.world.WIDTH):\n          for y in range(env.world.HEIGHT):\n              if env._current_state.grid[x, y, workshop_index] > 0:\n                  return (x, y)\n      return None\n\n  actions = []\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n  \n  # Check if we have all required primitives in our inventory\n  required_primitives = cookbook.primitives_for(goal_index)\n  for primitive, count in required_primitives.items():\n    if env._current_state.inventory[primitive] < count:\n      return []  # Not enough primitives to craft the item\n\n  # Find a workshop to perform crafting\n  recipe = cookbook.recipes.get(goal_index, {})\n  workshop_indices = [ingredient for ingredient in recipe.keys() \n                      if ingredient in env.world.workshop_indices and ingredient != \"_key\"]\n\n  if not workshop_indices:\n    return []  # No suitable workshop found\n  \n  # Sort workshops by distance to the nearest one\n  distances = {workshop: manhattan_distance(env._current_state.pos, find_workshop_position(env, workshop)) for workshop in workshop_indices}\n  closest_workshop_index = min(distances, key=distances.get)\n\n  # Navigate to the nearest workshop\n  actions.extend(navigate_to_workshop(env, closest_workshop_index))\n\n  # Perform USE action at the workshop to craft the item\n  actions.append(env.world.N_ACTIONS - 1)  # Assuming USE is the last action index (N_ACTIONS - 1)\n\n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T08:45:11.947184", "function_name": "craft", "function_body": "  # Extract the index of the desired item from the cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the items/primitives required for crafting\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  \n  if not primitives_needed:\n    return []  # No recipe or no primitives needed (invalid case)\n\n  actions = []\n\n  # Collect all primitives needed for crafting\n  for primitive, count in primitives_needed.items():\n      for _ in range(count):\n          actions.extend(collect_v2(env, env.world.cookbook.index.get(primitive)))\n\n  # Go to the workshop and craft the item\n  if \"workshop\" in item.lower():  # Assuming workshops are named with 'workshop' keyword\n      target_workshop = item_index\n  else:\n      target_workshop = None\n\n  if target_workshop is not None:\n      actions.extend(navigate_to_workshop(env, target_workshop))\n      \n  # Use the USE action at the workshop to craft the item\n  actions.append(4)  # Assuming USE is represented by index 4\n  \n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-06T08:45:12.943760", "function_name": "craft", "function_body": "  actions = []\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  primitives_for_goal = cookbook.primitives_for(index[item])\n  \n  if not primitives_for_goal:\n    return []\n\n  # Check if all required primitives are available in the inventory\n  for primitive_index, count in primitives_for_goal.items():\n      if env._current_state.inventory[primitive_index] < count:\n          return []\n          \n  # Find the workshop index and move to it\n  workshop_index = None\n  for recipe, ingredients in cookbook.recipes.items():\n      if recipe == index[item]:\n          workshop_index = int(ingredients[\"_key\"])\n          break\n\n  if workshop_index is None or workshop_index not in env.world.workshop_indices:\n      return []\n\n  # Move to the workshop\n  actions.extend(move_to_workshop(env, workshop_index))\n  \n  # Perform USE action to craft the item\n  actions.append(craft.ACTION_USE)\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-06T08:46:02.217071", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all the primitives required to craft the item\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n  \n  actions = []\n  \n  for primitive, count in primitives_required.items():\n    # Collect each primitive\n    while env._current_state.inventory[primitive] < count:\n      actions.extend(collect_v2(env, primitive))\n    \n  # Move to a workshop and use the USE action to craft the item\n  for workshop_index in env.world.workshop_indices:\n    if env._current_state.next_to(workshop_index):\n      actions.append(craft.MOVE_FUNC('USE'))\n      break\n  \n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-06T08:46:03.195593", "function_name": "craft", "function_body": "  actions = []\n\n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have a recipe for this item\n  if item_index not in env.world.cookbook.recipes:\n    return actions\n\n  # Calculate required primitives and check inventory\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  for primitive, count in primitives_needed.items():\n    if env._current_state.inventory[primitive] < count:\n      return actions\n\n  # Get the workshop index from the recipe (assuming \"_key\" has workshop info)\n  workshop_key = env.world.cookbook.recipes[item_index][\"_key\"]\n  workshop_index = int(workshop_key.split('_')[1])\n\n  # Move to the workshop\n  workshop_pos = env.world.workshop_indices[workshop_index]\n  move_to_workshop_actions = move_to_position(env, workshop_pos)\n  actions.extend(move_to_workshop_actions)\n\n  # Perform USE action to craft item\n  actions.append(4)  # Use action\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-06T08:47:20.838432", "function_name": "craft", "function_body": "  actions = []\n  \n  # Convert item name to index\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the goal is a primitive or has no recipe\n  if item_index in env.world.non_grabbable_indices:\n    return actions\n  \n  # Get the primitives required for crafting the item\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n  \n  # Collect each required primitive\n  for primitive, count in primitives_required.items():\n    while count > 0:\n      # Find the closest location of the primitive and collect it\n      actions.extend(collect(env, env.world.cookbook.index.get(env.world.cookbook.index[primitive])))\n      count -= 1\n  \n  # Go to a workshop and craft the item (assuming any workshop can be used)\n  if len(env.world.workshop_indices) > 0:\n    workshop_index = env.world.workshop_indices[0]\n    \n    # Find the closest location of the workshop\n    workshop_pos = find_closest_item(env, workshop_index)\n    actions.extend(navigate_to(env, workshop_pos))\n    \n    # Use action to craft the item\n    actions.append(4)  # USE action index is 4\n  \n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-06T08:47:21.830254", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all primitives required for crafting\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  \n  actions = []\n\n  # If no recipe exists or we don't have required primitives, return empty action list\n  if not primitives_needed:\n    print(\"No recipe found or missing primitives.\")\n    return actions\n\n  # Collect all required primitives\n  for primitive_index in primitives_needed.keys():\n      primitive_name = env.world.cookbook.index.get(primitive_index)\n      if primitive_name:\n          while not env._current_state.inventory[primitive_index]:\n              collect_actions = collect(env, primitive_name)\n              actions.extend(collect_actions)\n\n  # Move to a workshop and craft the item\n  for recipe in env.world.cookbook.recipes.values():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n      workshop_index = recipe.get(\"workshop\")\n      if workshop_index is not None:\n        # Find a position next to the workshop\n        workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n        \n        for pos in workshop_positions:\n          move_actions = get_move_to_position_actions(env, tuple(pos))\n          actions.extend(move_actions)\n\n          # Use action to craft the item at the workshop\n          actions.append(4)  # USE action\n\n          return actions\n  \n  print(\"No valid workshop found.\")\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-06T08:50:13.140638", "function_name": "craft", "function_body": "  def get_workshop_index(item):\n      # Determine the workshop index based on the item.\n      # This mapping should be defined in the cookbook or some configuration file.\n      workshops = {\n          'PLANK': env.world.workshop_indices[0],\n          'STICK': env.world.workshop_indices[0],\n          'CLOTH': env.world.workshop_indices[1],\n          'ROPE': env.world.workshop_indices[1],\n          'BRIDGE': env.world.workshop_indices[2],\n          'BUNDLE': env.world.workshop_indices[2],\n          # Add more mappings as needed\n      }\n      return workshops.get(item, None)\n\n  def get_primitive_locations(primitives):\n      # Find the positions of all primitives in the grid.\n      locations = {}\n      for primitive in primitives:\n          locs = np.argwhere(env._current_state.grid[:, :, primitive] > 0)\n          locations[primitive] = [(x, y) for x, y in locs]\n      return locations\n\n  def get_closest_primitive(primitive_locations):\n      # Find the closest primitive to the current position.\n      min_distance = float('inf')\n      closest_primitive = None\n      for primitive, locs in primitive_locations.items():\n          if locs:\n              distances = [np.linalg.norm(np.array(loc) - np.array(env._current_state.pos)) for loc in locs]\n              closest_loc = locs[np.argmin(distances)]\n              distance = np.min(distances)\n              if distance < min_distance:\n                  min_distance = distance\n                  closest_primitive = (primitive, closest_loc)\n      return closest_primitive\n\n  def move_to_location(location):\n      # Calculate the direction to move towards the location.\n      current_pos = env._current_state.pos\n      dx = location[0] - current_pos[0]\n      dy = location[1] - current_pos[1]\n      actions = []\n      if abs(dx) > abs(dy):\n          actions.extend([craft.MOVE_FUNC(craft.RIGHT) if dx > 0 else craft.MOVE_FUNC(craft.LEFT)] * abs(dx))\n      else:\n          actions.extend([craft.MOVE_FUNC(craft.DOWN) if dy > 0 else craft.MOVE_FUNC(craft.UP)] * abs(dy))\n      return actions\n\n  def collect_primitive(primitive):\n      # Collect the specified primitive.\n      actions = []\n      primitive_locations = get_primitive_locations([primitive])\n      closest_primitive, loc = get_closest_primitive(primitive_locations)\n      while env._current_state.grid[loc[0], loc[1], closest_primitive] > 0:\n          actions.extend(move_to_location(loc))\n          actions.append(craft.COLLECT_FUNC(closest_primitive))\n      return actions\n\n  def craft_item(workshop_index):\n      # Craft the item at the specified workshop.\n      actions = []\n      location = (workshop_index // env.world.grid.shape[1], workshop_index % env.world.grid.shape[1])\n      actions.extend(move_to_location(location))\n      actions.append(craft.USE_FUNC)\n      return actions\n\n  def check_primitives(primitive_indices):\n      # Check if all required primitives are available in the inventory.\n      for primitive in primitive_indices:\n          if env._current_state.inventory[primitive] == 0:\n              return False\n      return True\n\n  item_index = env.world.cookbook.index[item]\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  primitive_indices = list(primitives_needed.keys())\n\n  # Check if all required primitives are available.\n  if not check_primitives(primitive_indices):\n      # Collect required primitives if not in inventory\n      for primitive in primitive_indices:\n          while env._current_state.inventory[primitive] < primitives_needed[primitive]:\n              actions.extend(collect_primitive(primitive))\n\n  workshop_index = get_workshop_index(item)\n  if workshop_index is not None:\n      actions.extend(craft_item(workshop_index))\n  else:\n      return []\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
