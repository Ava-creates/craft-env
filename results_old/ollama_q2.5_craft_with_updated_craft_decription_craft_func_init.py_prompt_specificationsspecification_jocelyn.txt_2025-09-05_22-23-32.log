{"timestamp": "2025-09-06T08:12:32.460980", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item has a recipe in the cookbook\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Get the required ingredients and their counts from the recipe\n  recipe = env.world.cookbook.recipes[item_index]\n  ingredient_counts = {ingredient: count for ingredient, count in recipe.items() if ingredient != \"_key\"}\n\n  # Check if we have all the primitives required for crafting\n  inventory = env._current_state.inventory\n\n  actions = []\n  for ingredient, count in ingredient_counts.items():\n    # If the primitive is not available in the inventory or less than required, return empty action list\n    if inventory[ingredient] < count:\n      return []\n\n  # Find a workshop to craft the item\n  workshops = env.world.workshop_indices\n\n  # For simplicity, we select the first workshop available\n  selected_workshop_index = workshops[0]\n\n  # Get the grid and find the position of the selected workshop\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, selected_workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    return []\n\n  # Choose a random position from available workshops\n  chosen_workshop_position = tuple(workshop_positions[env.world.random.randint(len(workshop_positions))])\n\n  # Move the agent to the workshop\n  actions.extend(movement_actions_to(env, chosen_workshop_position))\n\n  # Perform the USE action at the workshop to craft the item\n  actions.append(craft.USE)\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-06T08:12:33.524463", "function_name": "craft", "function_body": "  actions = []\n  world = env.world\n  cookbook = world.cookbook\n\n  # Get the index of the goal item\n  goal_index = cookbook.index[item]\n\n  # Get primitives required for crafting the goal item\n  primitives_needed = cookbook.primitives_for(goal_index)\n\n  # Check if we have all the primitives needed in inventory\n  current_inventory = env._current_state.inventory\n  for primitive, count in primitives_needed.items():\n    if current_inventory[primitive] < count:\n      return []  # We do not have enough primitives to craft the item\n\n  # Now that we have all the required primitives, proceed to craft the item\n  # Find a workshop to use for crafting\n  available_workshops = world.workshop_indices\n  chosen_workshop = None\n\n  for workshop in available_workshops:\n    if env._current_state.next_to(workshop):\n      chosen_workshop = workshop\n      break\n\n  if chosen_workshop is None:\n    return []  # No workshop nearby to use for crafting\n\n  # Move to the workshop and perform the USE action\n  actions.extend(find_path(env, chosen_workshop))\n  actions.append(env.world.world.action_map['USE'])\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-06T08:15:21.186007", "function_name": "craft", "function_body": "  def navigate_to_workshop_actions(pos, target_pos):\n    dx = target_pos[0] - pos[0]\n    dy = target_pos[1] - pos[1]\n\n    actions = []\n    if dx > 0:\n        actions.extend([env.world.RIGHT for _ in range(abs(dx))])\n    elif dx < 0:\n        actions.extend([env.world.LEFT for _ in range(abs(dx))])\n\n    if dy > 0:\n        actions.extend([env.world.DOWN for _ in range(abs(dy))])\n    elif dy < 0:\n        actions.extend([env.world.UP for _ in range(abs(dy))])\n\n    return actions\n\n  def manhattan_distance(pos1, pos2):\n      return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n\n  def find_workshop_position(env, workshop_index):\n    grid = env._current_state.grid\n    positions = np.argwhere(grid[:, :, workshop_index] == 1)\n    if positions.size > 0:\n        return tuple(positions[0])\n    else:\n        raise ValueError(f\"No position found for workshop index {workshop_index}\")\n\n  actions = []\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  # Check if we have all required primitives in our inventory\n  required_primitives = cookbook.primitives_for(goal_index)\n  for primitive, count in required_primitives.items():\n      if env._current_state.inventory[primitive] < count:\n          return []  # Not enough primitives to craft the item\n\n  # Find a workshop to perform crafting\n  recipe = cookbook.recipes.get(goal_index, {})\n  workshop_indices = [ingredient for ingredient in recipe.keys() \n                      if ingredient in env.world.workshop_indices and ingredient != \"_key\"]\n\n  if not workshop_indices:\n      return []  # No suitable workshop found\n  \n  # Sort workshops by distance to the nearest one\n  distances = {workshop: manhattan_distance(env._current_state.pos, find_workshop_position(env, workshop)) for workshop in workshop_indices}\n  closest_workshop_index = min(distances, key=distances.get)\n  \n  # Navigate to the nearest workshop\n  target_pos = find_workshop_position(env, closest_workshop_index)\n  actions.extend(navigate_to_workshop_actions(env._current_state.pos, target_pos))\n\n  # Ensure we are at the correct position before using the workshop\n  if env._current_state.pos != target_pos:\n      return []  # Navigation failed\n\n  # Perform USE action at the workshop to craft the item\n  actions.append(env.world.N_ACTIONS - 1)  # Assuming USE is the last action index (N_ACTIONS - 1)\n\n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T08:15:22.181398", "function_name": "craft", "function_body": "  def navigate_to_workshop_actions(pos, target_pos):\n    dx = target_pos[0] - pos[0]\n    dy = target_pos[1] - pos[1]\n\n    actions = []\n    if dx > 0:\n        actions.extend([env.world.RIGHT for _ in range(abs(dx))])\n    elif dx < 0:\n        actions.extend([env.world.LEFT for _ in range(abs(dx))])\n\n    if dy > 0:\n        actions.extend([env.world.DOWN for _ in range(abs(dy))])\n    elif dy < 0:\n        actions.extend([env.world.UP for _ in range(abs(dy))])\n\n    return actions\n\n  def manhattan_distance(pos1, pos2):\n      return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n\n  def find_workshop_position(env, workshop_index):\n    grid = env._current_state.grid\n    positions = np.argwhere(grid[:, :, workshop_index] == 1)\n    if positions.size > 0:\n        return tuple(positions[0])\n    else:\n        raise ValueError(f\"No position found for workshop index {workshop_index}\")\n\n  def is_item_next_to_agent(env, item_index):\n      x, y = env._current_state.pos\n      neighborhood = grid[x-1:x+2, y-1:y+2]\n      return np.any(neighborhood[:, :, item_index] == 1)\n\n  actions = []\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  # Check if we have all required primitives in our inventory or nearby\n  required_primitives = cookbook.primitives_for(goal_index)\n  for primitive, count in required_primitives.items():\n      in_inventory = env._current_state.inventory[primitive] >= count\n      nearby = is_item_next_to_agent(env, primitive)\n      if not (in_inventory or nearby):\n          return []  # Not enough primitives to craft the item\n\n  # Find a workshop to perform crafting\n  recipe = cookbook.recipes.get(goal_index, {})\n  workshop_indices = [ingredient for ingredient in recipe.keys() \n                      if ingredient in env.world.workshop_indices and ingredient != \"_key\"]\n\n  if not workshop_indices:\n      return []  # No suitable workshop found\n  \n  # Sort workshops by distance to the nearest one\n  distances = {workshop: manhattan_distance(env._current_state.pos, find_workshop_position(env, workshop)) for workshop in workshop_indices}\n  closest_workshop_index = min(distances, key=distances.get)\n  \n  # Navigate to the nearest workshop\n  target_pos = find_workshop_position(env, closest_workshop_index)\n  actions.extend(navigate_to_workshop_actions(env._current_state.pos, target_pos))\n\n  # Perform USE action at the workshop to craft the item\n  actions.append(env.world.N_ACTIONS - 1)  # Assuming USE is the last action index (N_ACTIONS - 1)\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-06T08:17:03.387203", "function_name": "craft", "function_body": "  # Get the index of the goal item\n  goal_index = env.world.cookbook.index[item]\n\n  # Check if we have all the primitives required for crafting\n  primitives_required = env.world.cookbook.primitives_for(goal_index)\n  actions_to_take = []\n\n  # Collect missing primitives\n  for primitive_index, count in primitives_required.items():\n    if env._current_state.inventory[primitive_index] < count:\n      # Find a primitive to collect\n      primitive_name = env.world.cookbook.index.get(primitive_index)\n\n      if not primitive_name:\n        continue\n\n      actions_to_take.extend(collect(env, primitive_name))\n\n  # Go to the workshop and craft the item\n  workshop_indices = [i for i in env.world.workshop_indices if env._current_state.next_to(i)]\n\n  if not workshop_indices:\n    return []\n\n  workshop_index = workshop_indices[0]\n\n  # Move to the workshop\n  actions_to_take.extend(move(env, (env._current_state.pos, workshop_index)))\n\n  # Craft the item by using the USE action at the workshop\n  actions_to_take.append(4)  # Assuming 4 is the index for the USE action\n\n  return actions_to_take", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-06T08:17:04.365719", "function_name": "craft", "function_body": "  actions = []\n\n  # Get the cookbook index for the item to craft\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item has a recipe\n  if item_index in env.world.cookbook.recipes:\n    recipe = env.world.cookbook.recipes[item_index]\n    \n    # List of primitives required and their counts\n    required_primitives = {i: count for i, count in recipe.items() if i != \"_key\"}\n    \n    # Check if we have all the required primitives in inventory\n    for i_primitive, count in required_primitives.items():\n      if env._current_state.inventory[i_primitive] < count:\n        return []  # We do not have enough of a required primitive\n    \n    # Find the nearest workshop that can craft this item\n    key = recipe[\"_key\"]\n    workshop_indices = [i for i in env.world.workshop_indices if env.world.cookbook.recipes[i][\"_key\"] == key]\n    \n    if not workshop_indices:\n      return []  # No available workshop to craft the item\n    \n    # Choose the closest workshop\n    closest_workshop_index = min(workshop_indices, key=lambda i: np.linalg.norm(np.array(env._current_state.pos) - np.argwhere(env._current_state.grid[:, :, i])[0]))\n    \n    # Find the position of the closest workshop\n    workshop_positions = [tuple(pos) for pos in np.argwhere(env._current_state.grid[:, :, closest_workshop_index])]\n    closest_workshop_pos = min(workshop_positions, key=lambda p: np.linalg.norm(np.array(p) - np.array(env._current_state.pos)))\n    \n    # Move to the closest workshop\n    path_to_workshop = bfs(env._current_state.grid, env._current_state.pos, closest_workshop_pos)\n    actions.extend([env.action_specs()[\"DOWN\"] if d == (0, 1) else \n                    env.action_specs()[\"UP\"] if d == (0, -1) else \n                    env.action_specs()[\"LEFT\"] if d == (-1, 0) else \n                    env.action_specs()[\"RIGHT\"] for d in path_to_workshop])\n    \n    # Use the workshop to craft the item\n    actions.append(env.action_specs()[\"USE\"])\n  \n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-06T08:20:43.045736", "function_name": "craft", "function_body": "  ACTION_UP = env.world.n_actions - 4 + 0\n  ACTION_DOWN = env.world.n_actions - 4 + 2\n  ACTION_LEFT = env.world.n_actions - 4 + 1\n  ACTION_RIGHT = env.world.n_actions - 4 + 3\n  ACTION_USE = env.world.n_actions - 1\n\n  def move_to_position(target_x, target_y):\n    \"\"\"Helper function to generate actions to move to a specific position.\"\"\"\n    actions = []\n    pos_x, pos_y = env._current_state.pos\n    \n    while pos_x != target_x or pos_y != target_y:\n      dx = target_x - pos_x\n      dy = target_y - pos_y\n      \n      if abs(dx) > abs(dy):\n        actions.append(ACTION_LEFT if dx < 0 else ACTION_RIGHT)\n      else:\n        actions.append(ACTION_DOWN if dy < 0 else ACTION_UP)\n      \n      pos_x += (-1 if dx < 0 else 1) if abs(dx) > abs(dy) else 0\n      pos_y += (-1 if dy < 0 else 1) if abs(dx) <= abs(dy) else 0\n    \n    return actions\n\n  def find_closest_target(target_positions):\n      \"\"\"Helper function to find the closest target position.\"\"\"\n      pos_x, pos_y = env._current_state.pos\n      \n      min_distance = float('inf')\n      closest_pos = None\n      \n      for tx, ty in zip(*target_positions):\n          distance = abs(tx - pos_x) + abs(ty - pos_y)\n          if distance < min_distance:\n              min_distance = distance\n              closest_pos = (tx, ty)\n      \n      return closest_pos\n\n  def pick_up_primitives(primitive_index, count):\n    \"\"\"Helper function to generate actions to pick up primitives.\"\"\"\n    actions = []\n    \n    while current_inventory[primitive_index] < count:\n      primitive_positions = np.where(env._current_state.grid[:, :, primitive_index] > 0)\n      closest_primitive_pos = find_closest_target(primitive_positions)\n      \n      if closest_primitive_pos is not None:\n        tx, ty = closest_primitive_pos\n        primitive_actions = move_to_position(tx, ty)\n        actions.extend(primitive_actions)\n        \n        # Perform USE action to collect the primitive\n        actions.append(ACTION_USE)\n        current_inventory[primitive_index] += 1\n      else:\n        return []  # If no source for the primitive, return empty list\n    \n    return actions\n\n  def use_workshop(workshop_index):\n    \"\"\"Helper function to generate actions to use a workshop.\"\"\"\n    target_pos_x, target_pos_y = np.where(env._current_state.grid[:, :, workshop_index] > 0)\n    \n    if len(target_pos_x) == 0 or len(target_pos_y) == 0:\n      return None\n    \n    # Move towards the nearest workshop and perform USE action\n    actions = move_to_position(target_pos_x[0], target_y[0])\n    actions.append(ACTION_USE)  # Assuming USE is always the last action to craft item\n    return actions\n\n  def get_primitives_needed(item_index):\n      \"\"\"Helper function to get primitives needed for an item.\"\"\"\n      return env.world.cookbook.primitives_for(item_index)\n\n  actions = []\n  \n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all required primitives for crafting the item\n  primitives_needed = get_primitives_needed(item_index)\n  current_inventory = env._current_state.inventory\n\n  # Collect missing primitives\n  for prim, count in primitives_needed.items():\n    primitive_actions = pick_up_primitives(prim, count)\n    actions.extend(primitive_actions)\n\n  # Find and use a workshop that has the required recipe\n  for i, workshop in enumerate(env.world.workshop_indices):\n    if env._current_state.grid[:, :, workshop].any():  # Check if there's at least one workshop of this type\n      workshop_positions = np.where(env._current_state.grid[:, :, workshop] > 0)\n      closest_workshop_pos = find_closest_target(workshop_positions)\n      \n      if closest_workshop_pos is not None:\n        tx, ty = closest_workshop_pos\n        workshop_actions = move_to_position(tx, ty)\n        actions.extend(workshop_actions)\n        \n        # Perform USE action to craft the item\n        actions.append(ACTION_USE)\n        break\n\n  return actions", "island_id": 8, "scores": {"3": 2.0}}
