     \n      if workshop_key is not None:\n          for key, value in cookbook.recipes.items():\n              if \"_key\" in value and value[\"_key\"] == workshop_key:\n                  return key\n      return None\n\n  def check_and_collect_primitives(env, primitives_needed):\n      actions = []\n      grid = env._current_state.grid\n      \n      for primitive, count in primitives_needed.items():\n          missing_count = count - env._current_state.inventory[primitive]\n          while missing_count > 0:\n              actions.extend(collect_primitive(env, primitive))\n              # Simulate the collection by updating inventory\n              env._current_state.inventory[primitive] += 1\n              missing_count -= 1\n      \n      return actions\n\n  def find_closest_workshop_position(grid: np.ndarray, workshop_index: int, current_pos: tuple):\n    positions = find_all_positions_of_kind(grid, workshop_index)\n    if not positions:\n        return None\n    nearest_position = min(positions, key=lambda pos: distance(current_pos, pos))\n    return nearest_position\n\n  def optimize_path(actions: list[int]):\n      \"\"\"Optimize the sequence of actions to reduce redundant moves.\"\"\"\n      optimized_actions = []\n      current_direction = -1\n      \n      for action in actions:\n          if current_direction == -1 or (current_direction != action and not are_opposites(current_direction, action)):\n              optimized_actions.append(action)\n          current_direction = action\n      \n      return optimized_actions\n\n  def are_opposites(dir1: int, dir2: int) -> bool:\n      \"\"\"Check if two directions are opposites.\"\"\"\n      return (dir1 == 0 and dir2 == 1) or (dir1 == 1 and dir2 == 0) or (dir1 == 2 and dir2 == 3) or (dir1 == 3 and dir2 == 2)\n\n  actions = []\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  # Check if we have all the primitives required for crafting\n  primitives_needed = cookbook.primitives_for(item_index)\n  actions.extend(check_and_collect_primitives(env, primitives_needed))\n  \n  # Find the workshop index needed to craft the item\n  workshop_index = find_workshop_index_for_item(item_index, cookbook)\n\n  if workshop_index is not None:\n      grid = env._current_state.grid\n      nearest_workshop_pos = find_closest_workshop_position(grid, workshop_index, env._current_state.pos)\n      \n      if nearest_workshop_pos is not None:\n          actions.extend(move_to_position(env._current_state.pos, nearest_workshop_pos))\n          \n          # Use the workshop to craft the item\n          actions.append(4)  # USE action\n  \n  return optimize_path(actions)", "island_id": 1, "scores": {"3": 0.49999994}}
