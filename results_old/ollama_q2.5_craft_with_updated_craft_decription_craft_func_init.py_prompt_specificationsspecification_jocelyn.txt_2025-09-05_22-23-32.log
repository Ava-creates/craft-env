{"timestamp": "2025-09-06T08:22:20.691495", "function_name": "craft", "function_body": "  # Translate the item name to its corresponding index in the cookbook.\n  item_index = env.world.cookbook.index[item]\n\n  if item_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  # Check if we have all primitives required for crafting\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n\n  # If any required primitive is not in the inventory, return empty action list\n  missing_primitives = [p for p, count in required_primitives.items() if env._current_state.inventory[p] < count]\n  if missing_primitives:\n    print(f\"Missing primitives: {missing_primitives}\")\n    return []\n\n  # Find the first workshop index from the recipe that is present in the grid.\n  workshop_index = None\n  for ingredient_or_key, count in env.world.cookbook.recipes[item_index].items():\n      if \"_key\" not in ingredient_or_key and ingredient_or_key.isdigit():\n          workshop_index = int(ingredient_or_key)\n          break\n\n  # If no valid workshop index is found, raise an error.\n  if workshop_index is None:\n    raise ValueError(f\"No valid workshop found for item: {item}\")\n\n  # Find the position of the nearest workshop on the grid.\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  nearest_workshop_position = min(workshop_positions, key=lambda pos: sum(abs(np.array(pos) - np.array(env._current_state.pos))))\n\n  # Calculate actions to move to the nearest workshop\n  actions_to_move = calculate_actions_to_position(env, nearest_workshop_position)\n\n  # Add USE action to craft the item at the workshop.\n  use_action = env.world.n_actions  # Assuming USE is the last action in the list of actions\n\n  return actions_to_move + [use_action]", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-06T08:22:21.660604", "function_name": "craft", "function_body": "  # Get the index for the desired item\n  goal_index = env.world.cookbook.index[item]\n  \n  # Check if the item is non-grabbable or a primitive (can't be crafted)\n  if goal_index in env.world.non_grabbable_indices or goal_index in env.world.primitives:\n    return []\n  \n  # Get the primitives required for crafting the item\n  primitives_required = env.world.cookbook.primitives_for(goal_index)\n\n  actions = []\n\n  # Collect all required primitives\n  for primitive, count in primitives_required.items():\n      primitive_name = env.world.cookbook.index.get(primitive)\n      \n      # Check if we already have enough of this primitive in inventory\n      while env._current_state.inventory[primitive] < count:\n          # Move to a location where the primitive is available (simple heuristic: closest non-grabbable entity)\n          for x in range(env.world.cookbook.grid.shape[0]):\n              for y in range(env.world.cookbook.grid.shape[1]):\n                  if env.world.cookbook.grid[x, y, primitive] > 0:\n                      # Move to the location (simple heuristic: move directly towards it)\n                      actions.extend(move_to_location((x, y), env._current_state.pos))\n                      \n                      # Collect the primitive\n                      actions.append(env.action_specs()[\"COLLECT_FUNC\"])\n                      \n                      break\n              else:\n                  continue\n              break\n\n  # Go to the workshop and craft the item (simple heuristic: move directly towards the first workshop)\n  for workshop in env.world.workshop_indices:\n      if env.world.cookbook.grid[workshop[0], workshop[1]].any():\n          actions.extend(move_to_location(workshop, env._current_state.pos))\n          \n          # Craft the item\n          actions.append(env.action_specs()[\"USE_FUNC\"])\n          \n          break\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-06T08:25:52.371709", "function_name": "craft", "function_body": "  ACTION_UP = env.world.n_actions - 4 + 0\n  ACTION_DOWN = env.world.n_actions - 4 + 2\n  ACTION_LEFT = env.world.n_actions - 4 + 1\n  ACTION_RIGHT = env.world.n_actions - 4 + 3\n  ACTION_USE = env.world.n_actions - 1\n\n  def move_to_position(target_x, target_y):\n    \"\"\"Helper function to generate actions to move to a specific position.\"\"\"\n    actions = []\n    pos_x, pos_y = env._current_state.pos\n    \n    while pos_x != target_x or pos_y != target_y:\n      dx = target_x - pos_x\n      dy = target_y - pos_y\n      \n      if abs(dx) > abs(dy):\n        actions.append(ACTION_LEFT if dx < 0 else ACTION_RIGHT)\n      else:\n        actions.append(ACTION_DOWN if dy < 0 else ACTION_UP)\n      \n      pos_x += (-1 if dx < 0 else 1) if abs(dx) > abs(dy) else 0\n      pos_y += (-1 if dy < 0 else 1) if abs(dx) <= abs(dy) else 0\n    \n    return actions\n\n  def find_closest_target(target_positions):\n      \"\"\"Helper function to find the closest target position.\"\"\"\n      pos_x, pos_y = env._current_state.pos\n      \n      min_distance = float('inf')\n      closest_pos = None\n      \n      for tx, ty in zip(*target_positions):\n          distance = abs(tx - pos_x) + abs(ty - pos_y)\n          if distance < min_distance:\n              min_distance = distance\n              closest_pos = (tx, ty)\n      \n      return closest_pos\n\n  def pick_up_primitives(primitive_index, count):\n    \"\"\"Helper function to generate actions to pick up primitives.\"\"\"\n    actions = []\n    \n    while current_inventory[primitive_index] < count:\n      primitive_positions = np.where(env._current_state.grid[:, :, primitive_index] > 0)\n      closest_primitive_pos = find_closest_target(primitive_positions)\n      \n      if closest_primitive_pos is not None:\n        tx, ty = closest_primitive_pos\n        primitive_actions = move_to_position(tx, ty)\n        actions.extend(primitive_actions)\n        \n        # Perform USE action to collect the primitive\n        actions.append(ACTION_USE)\n        current_inventory[primitive_index] += 1\n      else:\n        return []  # If no source for the primitive, return empty list\n    \n    return actions\n\n  def use_workshop(workshop_index):\n    \"\"\"Helper function to generate actions to use a workshop.\"\"\"\n    target_pos_x, target_pos_y = np.where(env._current_state.grid[:, :, workshop_index] > 0)\n    \n    if len(target_pos_x) == 0 or len(target_pos_y) == 0:\n      return None\n    \n    # Move towards the nearest workshop and perform USE action\n    actions = move_to_position(target_pos_x[0], target_pos_y[0])\n    actions.append(ACTION_USE)  # Assuming USE is always the last action to craft item\n    return actions\n\n  def get_primitives_needed(item_index):\n      \"\"\"Helper function to get primitives needed for an item.\"\"\"\n      return env.world.cookbook.primitives_for(item_index)\n\n  actions = []\n  \n  # Get the index of the desired item\n  if item not in env.world.cookbook.index:\n    return []  # Return empty list if item is not in cookbook\n  \n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all required primitives for crafting the item\n  primitives_needed = get_primitives_needed(item_index)\n  current_inventory = env._current_state.inventory\n\n  # Collect missing primitives\n  for prim, count in primitives_needed.items():\n    primitive_actions = pick_up_primitives(prim, count)\n    actions.extend(primitive_actions)\n\n  # Find and use a workshop that has the required recipe\n  found_workshop = False\n  for i, workshop in enumerate(env.world.workshop_indices):\n    if env._current_state.grid[:, :, workshop].any():  # Check if there's at least one workshop of this type\n      workshop_positions = np.where(env._current_state.grid[:, :, workshop] > 0)\n      closest_workshop_pos = find_closest_target(workshop_positions)\n      \n      if closest_workshop_pos is not None:\n        tx, ty = closest_workshop_pos\n        workshop_actions = move_to_position(tx, ty)\n        actions.extend(workshop_actions)\n        \n        # Perform USE action to craft the item\n        actions.append(ACTION_USE)\n        found_workshop = True\n        break\n\n  if not found_workshop:\n    return []  # Return empty list if no suitable workshop is found\n\n  return actions", "island_id": 8, "scores": {"3": 2.0}}
