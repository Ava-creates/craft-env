{"timestamp": "2025-05-10T13:08:52.298541", "function_name": "craft", "function_body": "  def get_recipe(item):\n    if isinstance(item, int):  # If it's an ingredient (int), return its index and add the action to craft it\n      return [env.world.grabbable_indices.index(item)]\n    elif hasattr(item, 'primitives'):  # If it's a recipe output, get its ingredients\n      return [get_recipe(ingredient) for ingredient in item.primitives]\n    else:\n      raise ValueError(\"Invalid item type.\")\n\n  try:\n    recipe = env.world.cookbook.primitives_for(item)\n    if not recipe:\n      return []\n    \n    actions = [1, 4]  # Move to workshop and use\n    ingredients = get_recipe(env.world.grabbable_indices.index(item))\n    for ingredient in ingredients:\n      if isinstance(ingredient, list):  # If it's a nested list of ingredients, recursively process each one\n        for sub_ingredient in ingredient:\n          actions += [1, 4] + [sub_ingredient]\n      else:  # Otherwise, just add the action to craft the ingredient\n        actions += [1, 4] + [ingredient]\n    return actions\n  except Exception as e:\n    print(f\"Error in craft_v2 function: {e}\")\n    return []", "island_id": 5, "scores": {"3": 2.5}}
{"timestamp": "2025-05-10T13:09:14.877550", "function_name": "craft", "function_body": "  def find_recipe(goal):\n    for output, ingredients in env.world.recipes.items():\n      if goal == output:\n        return {k: v for k, v in ingredients.items()}\n    return {}\n\n  recipe = find_recipe(item)\n  actions = []\n  for ingredient, count in recipe.items():\n    # Find the index of the ingredient in the inventory\n    idx = env.world.index[ingredient]\n    while not np.isnan(idx):\n      # Move to the ingredient if it's not already in the inventory\n      pos = env._current_state.pos\n      dir = env._current_state.dir\n      action = None\n      if dir == 0 and pos[1] > 0: action = 1  # UP\n      elif dir == 1 and pos[0] < env.WIDTH - 1: action = 3  # RIGHT\n      elif dir == 2 and pos[1] < env.HEIGHT - 1: action = 4  # DOWN\n      elif dir == 3 and pos[0] > 0: action = 2  # LEFT\n      if action is not None:\n        actions.append(action)\n        env._current_state.step(action)\n        pos = env._current_state.pos\n        dir = env._current_state.dir\n      \n      # Check if the ingredient is in the inventory and count down\n      while idx != -1 and env._current_state.inventory[idx] > 0:\n        actions.append(4)  # USE to pick up the ingredient\n        env._current_state.step(4)\n        pos = env._current_state.pos\n        dir = env._current_state.dir\n      \n      if idx != -1:\n        # If not enough of the ingredient, return an error or handle it as needed\n        raise ValueError(f\"Not enough {ingredient} to craft {item}\")\n  \n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-05-10T13:09:16.791113", "function_name": "craft", "function_body": "  def find_ingredients(goal):\n    recipe = env.world.cookbook.recipes.get(goal)\n    if not recipe:\n      return []\n    ingredients = []\n    for ingredient, count in recipe.items():\n      if isinstance(ingredient, str) and ingredient != \"_key\":\n        ingredients.extend([env.world.cookbook.index[ingredient]] * count)\n      elif isinstance(ingredient, int):\n        ingredients.append(ingredient)\n    return ingredients\n  \n  def craft_sequence(goal):\n    ingredients = find_ingredients(goal)\n    actions = []\n    for ingredient in reversed(ingredients):\n      # Move to the ingredient position if not already there\n      pos = env.world.non_grabbable_indices[ingredient]\n      if np.array_equal((env.grid_pos), pos):\n        continue\n      dx, dy = pos - (env.grid_pos)\n      if dx > 0: actions.append(3) # RIGHT\n      elif dx < 0: actions.append(2) # LEFT\n      elif dy > 0: actions.append(1) # DOWN\n      elif dy < 0: actions.append(0) # UP\n      # Use the ingredient to craft if possible\n      while not env.next_to(ingredient):\n        actions.append(4) # USE\n    return actions\n  \n  goal = env.world.cookbook.index[item]\n  return craft_sequence(goal)", "island_id": 9, "scores": {"3": 1.0}}
{"timestamp": "2025-05-10T13:09:18.699334", "function_name": "craft", "function_body": "  def get_required_primitives(goal):\n    recipe = env.world.cookbook.recipes[goal]\n    required_primitives = {}\n    for key, count in recipe.items():\n      if isinstance(key, int) and key != \"_key\":\n        required_primitives[key] = count\n    return required_primitives\n\n  # Get the required primitives to craft the item\n  required_primitives = get_required_primitives(item)\n  \n  # Check if we have all required primitives in inventory\n  inventory = env.current_state.inventory\n  actions = []\n  for primitive, count in required_primitives.items():\n    while inventory[primitive] < count:\n      # Find and pick up the primitive until we have enough\n      found_primitive = False\n      for action in range(env.n_actions):\n        if env._is_valid_action(action):\n          new_state, reward, done, info = env.step(action)\n          if env.current_state.next_to(primitive) and inventory[primitive] < count:\n            actions.append(action)\n            found_primitive = True\n            break\n      if not found_primitive:\n        break  # If we can't find the primitive, stop trying to craft this item\n  \n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-05-10T13:09:20.623175", "function_name": "craft", "function_body": "  def get_recipe(goal):\n    recipe = env.world.cookbook.recipes.get(goal)\n    if not recipe:\n      return None\n    ingredients = []\n    for ingredient, count in recipe.items():\n      if isinstance(ingredient, str) and ingredient != \"_key\":\n        ingredients.append((env.world.cookbook.index[ingredient], count))\n      elif ingredient == \"_key\":\n        # Handle the case where it's a special key for the next level of recursion\n        pass\n    return ingredients\n\n  def craft_recursive(goal, steps):\n    recipe = get_recipe(goal)\n    if not recipe:\n      return []\n    \n    actions = []\n    for ingredient, count in recipe:\n      # Craft each required ingredient first\n      actions.extend(craft_recursive(ingredient, steps))\n      # Then craft the main goal item\n      while env.world.primitives[ingredient] > 0 and count > 0:\n        if env.world.non_grabbable_indices.contains(ingredient):\n          break\n        actions.append(env.world.grabbable_indices.index(ingredient))\n        actions.append(env.world.workshop_indices[0])\n        count -= 1\n        env.world.primitives[ingredient] -= 1\n      if count > 0:\n        # If we can't craft enough, try to pick up more ingredients or resources\n        actions.extend(craft_recursive(ingredient, steps))\n    return actions\n\n  item_index = env.world.cookbook.index[item]\n  actions = craft_recursive(item_index, [])\n  return actions", "island_id": 9, "scores": {"3": 1.0}}
