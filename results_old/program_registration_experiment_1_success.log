{"timestamp": "2025-05-10T08:24:33.216802", "function_name": "craft", "function_body": "  def get_required_primitives(goal):\n    recipe = env.world.recipes[goal]\n    required_primitives = {}\n    for ingredient, count in recipe.items():\n      if isinstance(ingredient, str) and ingredient != \"_key\":\n        required_primitives[env.world.index.getitem(ingredient)] = count\n    return required_primitives\n\n  def get_inventory_count(primitive):\n    return env._current_state.inventory[primitive] if primitive in env._current_state.inventory else 0\n\n  goal_idx = item\n  required_primitives = get_required_primitives(goal_idx)\n  actions = []\n  \n  for primitive, count in required_primitives.items():\n    while get_inventory_count(primitive) < count:\n      # Find the closest workshop to pick up the primitive\n      workshop_indices = env.world.workshop_indices\n      min_distance = float('inf')\n      best_workshop = None\n      for idx in workshop_indices:\n        distance = abs(env._current_state.pos[0] - idx) + abs(env._current_state.pos[1] - idx)\n        if distance < min_distance:\n          min_distance = distance\n          best_workshop = idx\n      # Move to the workshop and pick up the primitive\n      actions.append(best_workshop - len(env.world.grabbable_indices))\n      env.step(best_workshop - len(env.world.grabbable_indices))\n  \n  # Craft the item\n  for _ in range(count):\n    actions.append(goal_idx)\n    env.step(goal_idx)\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
