{"timestamp": "2025-05-09T18:32:47.899975", "function_name": "craft", "function_body": "  # Get the recipe for the desired item\n  goal = env.world.cookbook.index.get(item)\n  if goal is None:\n    raise ValueError(\"Unknown item index.\")\n  \n  recipe = env.world.primitives_for(goal)\n  \n  actions = []\n  # Iterate over the required ingredients and their counts from the recipe\n  for ingredient, count in recipe.items():\n    if count == 1:  # If only one is needed, try to pick it up directly\n      ingredient_index = env.world.cookbook.index[ingredient]\n      if env.non_grabbable_indices and ingredient_index in env.non_grabbable_indices:\n        continue  # Skip if the ingredient is non-grabbable\n      actions.append(env.world.grabbable_indices.index(ingredient_index) + 5)  # Move to grabbable index and use\n    else:  # If multiple are needed, we need to craft first before picking up\n      if count > env.inventory[ingredient]:  # Check if inventory has enough of this ingredient\n        raise ValueError(f\"Not enough {ingredient} in inventory to craft the desired item.\")\n      \n      # Craft as many times as needed\n      for _ in range(count):\n        actions += [1, 4]  # Move to workshop and use (craft)\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
