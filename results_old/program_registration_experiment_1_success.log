{"timestamp": "2025-05-09T18:32:51.700262", "function_name": "craft", "function_body": "  # Get the crafting recipe for the given item\n  goal = env.world.cookbook.index.get(item)\n  if goal is None:\n    raise ValueError(\"Item not found in cookbook.\")\n  \n  # Check if the goal can be crafted directly from primitives or environment items\n  recipe = env.world.primitives_for(goal)\n  \n  actions = []\n  for kind, count in recipe.items():\n    if kind == \"_key\":  # Skip the key itself\n      continue\n    \n    # Find the index of the primitive or environment item in the cookbook\n    entity_index = env.world.cookbook.index[kind]\n    \n    # Determine how to pick up the entity (if it's not grabbable, find its position)\n    if kind in env.non_grabbable_indices:\n      pos = np.argwhere(env.grid[:, :, entity_index] > 0)[0]\n      actions.extend([pos[1], pos[0]])  # Add the position to the action list\n    else:\n      grabbable_indices = env.grabbable_indices\n      if entity_index in grabbable_indices:\n        actions.append(entity_index)  # Add the index of the grabbable item to the action list\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-05-09T18:33:12.985756", "function_name": "craft", "function_body": "  # Initialize the action sequence with a no-op (do nothing)\n  actions = []\n  \n  # Check if the desired item is in the environment's cookbook and has an associated recipe\n  if env.world.cookbook.index.get(item):\n    current_inventory = np.zeros(env.world.n_kinds, dtype=int)\n    \n    # Get the indices of all items in the inventory\n    for i in range(env.world.n_kinds):\n      if env.non_grabbable_indices and (i in env.non_grabbable_indices or i in env.primitives):\n        continue\n      current_inventory[i] = np.sum(env.grid[:, :, i])\n    \n    # Find the indices of all ingredients required for crafting the desired item\n    recipe = env.world.cookbook.recipes[item]\n    ingredients = []\n    counts = []\n    for ingredient_index, count in recipe.items():\n      if isinstance(ingredient_index, str) and '[' in ingredient_index:\n        _, arg = parse_fexp(ingredient_index)\n        ingredient_index = int(arg)\n      ingredients.append(ingredient_index)\n      counts.append(count)\n    \n    # Collect the required items that are available in the inventory\n    required_items = []\n    for i, ingredient in enumerate(ingredients):\n      if current_inventory[ingredient] > 0:\n        required_items.append((ingredient, counts[i]))\n    \n    # Sort required items by their indices to ensure a consistent order for crafting\n    required_items = sorted(required_items, key=lambda x: x[0])\n    \n    # Craft each required item using the recipe and add the corresponding actions\n    for ingredient, count in required_items:\n      ingredient_index = int(ingredient)\n      if not env.non_grabbable_indices or (ingredient_index not in env.non_grabbable_indices and ingredient_index not in env.primitives):\n        actions.append(env.world.cookbook.index[str(ingredient)])\n        for _ in range(count):\n          if len(actions) >= max_steps:\n            break\n          # Add the grab action if the item is not already in the inventory or requires more than one to be crafted\n          actions.append(env.world.cookbook.index[str(ingredient)])\n  \n  return actions[:max_steps]", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-05-09T18:33:14.884740", "function_name": "craft", "function_body": "  # Get the recipe for the desired item\n  goal_index = env.world.cookbook.index.getitem(item)\n  if goal_index is None:\n    raise ValueError(\"Unknown item: {}\".format(item))\n  \n  # Initialize an empty list to store actions\n  actions = []\n\n  # Get the ingredients and their counts from the recipe\n  recipe = env.world.cookbook.recipes[goal_index]\n  for ingredient, count in recipe.items():\n    if ingredient == \"_key\":\n      continue  # Skip the key which indicates the total number of items to craft\n    \n    # Find the index of the ingredient in the cookbook\n    ingredient_index = env.world.cookbook.index.getitem(ingredient)\n    if ingredient_index is None:\n      raise ValueError(\"Unknown ingredient: {}\".format(ingredient))\n    \n    # Craft the ingredients until we have enough for the recipe\n    while not env.state.inventory[ingredient_index] >= count:\n      actions.extend([env.world.cookbook.index.getitem(ingredient)])  # Add action to craft the ingredient\n      if len(actions) > 10:  # Safety check to avoid infinite loops\n        raise ValueError(\"Unable to craft ingredients for {}\".format(item))\n  \n  return actions", "island_id": 9, "scores": {"3": -1}}
