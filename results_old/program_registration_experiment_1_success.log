{"timestamp": "2025-05-10T11:35:02.021354", "function_name": "craft", "function_body": "  # Initialize the action list to be returned\n  actions = []\n  \n  # Get the recipe for the desired item\n  recipe = env.world.recipes[item]\n  \n  # Iterate over the ingredients in the recipe\n  for ingredient, count in recipe.items():\n    if isinstance(ingredient, str):  # If the ingredient is a primitive resource\n      # Find the index of the primitive resource in the environment\n      ingredient_index = env.world.cookbook.index[ingredient]\n      \n      # Add actions to pickup the primitive resource until we have enough\n      while not np.any(env.grid[:, :, ingredient_index] > 0):\n        for action in [0, 2, 3]:  # Try moving down, left, right if possible\n          new_pos = (env.pos[0] + (-1 if action == 0 else 0) + (1 if action == 3 else 0),\n                     env.pos[1] + (-1 if action == 2 else 0) + (1 if action == 1 else 0))\n          if 0 <= new_pos[0] < env.grid.shape[0] and 0 <= new_pos[1] < env.grid.shape[1]:\n            actions.append(action)\n            \n      # Pick up the primitive resource\n      for action in [4]:  # Use action to pick up the resource\n        if np.any(env.grid[:, :, ingredient_index] > 0):\n          actions.append(4)\n  \n    else:  # If the ingredient is another crafted item\n      # Find the index of the crafted item in the environment\n      ingredient_index = int(ingredient)\n      \n      # Recursively call craft_v2 to get the actions for the ingredients needed for this recipe\n      subactions = craft_v2(env, ingredient_index)\n      \n      # Append the subactions to the main action list\n      actions.extend(subactions)\n  \n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-05-10T11:35:03.929907", "function_name": "craft", "function_body": "  # Get the recipe for the desired item\n  goal = env.world.cookbook.index.get(item)\n  if goal is None:\n    raise ValueError(\"Item not found in cookbook\")\n  \n  # Find required primitives to craft the item\n  requirements = env.world.primitives_for(goal)\n\n  # Initialize actions list with a no-op action (0)\n  actions = [0]\n\n  # Iterate over each primitive and its requirement count\n  for prim, count in requirements.items():\n    if count > 0:\n      # Find the index of the primitive in the environment\n      prim_index = env.world.cookbook.index.get(prim)\n      if prim_index is None:\n        raise ValueError(\"Primitive not found in cookbook\")\n      \n      # Calculate the number of times to pickup the primitive\n      for _ in range(count):\n        actions.append(env.world.non_grabbable_indices.get(prim_index))\n  \n  return actions", "island_id": 4, "scores": {"3": -1}}
