{"timestamp": "2025-05-09T23:47:24.423733", "function_name": "craft", "function_body": "  def get_required_primitives(item_index):\n    prims = env.world.cookbook.recipes.get(item_index, None)\n    if not prims:\n      raise ValueError(\"Item {} does not have a crafting recipe.\".format(item))\n    \n    return {k: v for k, v in prims.items() if isinstance(k, int)}  # Filter out non-primitive indices\n  \n  def craft_actions_for_item(ingredients):\n    actions = []\n    for kind, count in ingredients.items():\n      p_index = kind\n      for _ in range(count):\n        actions.extend([1, 4])  # Move to the item, pick it up, and use it to craft the desired item.\n    return actions\n  \n  ingredients = get_required_primitives(item)\n  \n  if not ingredients:\n    raise ValueError(\"Item cannot be crafted\")\n  \n  actions = []\n  \n  for kind, count in ingredients.items():\n    p_index = kind\n    \n    # If the primitive is found and can be used to craft the item, add the necessary actions.\n    if p_index is not None:\n      for _ in range(count):\n        actions.extend([1, 4])  # Move to the item, pick it up, and use it to craft the desired item.\n  \n  return actions", "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-05-09T23:47:36.699410", "function_name": "craft", "function_body": "  def get_recipe(item):\n    recipe = env.world.cookbook.recipes.get(item, None)\n    if not recipe:\n      raise ValueError(\"Item {} does not have a crafting recipe.\".format(item))\n    return recipe\n  \n  recipe = get_recipe(item)\n  actions = []\n  \n  for ingredient, count in recipe.items():\n    if isinstance(ingredient, int):  # It's an index of the primitive resource\n      p_index = ingredient\n      actions.extend([1] * count + [4])  # Move to the item and use it to craft the desired item.\n  \n  return actions", "island_id": 1, "scores": {"3": 1.5}}
