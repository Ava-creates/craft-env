{"timestamp": "2025-05-10T11:48:55.028328", "function_name": "craft", "function_body": "  # Get the recipe for the desired item from the environment's cookbook.\n  goal = env.world.cookbook.index.get(item)\n  if goal is None:\n    raise ValueError(f\"Item '{item}' not found in cookbook.\")\n  \n  # Retrieve the indices of all primitive components required to craft the desired item.\n  recipe = env.world.primitives_for(goal)\n  actions = []\n  for component, count in recipe.items():\n    component_index = env.world.cookbook.index[component]\n    # Assuming that each component can be picked up by its index.\n    for _ in range(count):\n      actions.append(env.grabbable_indices.index(component_index))\n  \n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-05-10T11:48:56.925964", "function_name": "craft", "function_body": "  # Get the index of the goal item in the env.world.cookbook.index\n  goal_idx = env.world.cookbook.index.get(item)\n  if goal_idx is None:\n    raise ValueError(f\"Item '{item}' not found in cookbook.\")\n  \n  # Initialize an empty list to store actions\n  actions = []\n\n  # Get the primitive ingredients needed for crafting the item\n  recipe = env.world.cookbook.recipes[goal_idx]\n  for ingredient, count in recipe.items():\n    if isinstance(ingredient, str) and ingredient != \"_key\":\n      ingredient_idx = env.world.cookbook.index.get(ingredient)\n      if ingredient_idx is None:\n        raise ValueError(f\"Ingredient '{ingredient}' not found in cookbook.\")\n      \n      # Check the inventory to see if we have enough of this ingredient\n      while count > 0 and env.state.inventory[ingredient_idx] > 0:\n        actions.append(env.world.non_grabbable_indices.get(ingredient_idx))\n        count -= 1\n      \n      # If we don't have enough, add a use action to try and craft more later\n      if count > 0:\n        actions.append(4)  # USE action\n  \n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-05-10T11:48:58.820562", "function_name": "craft", "function_body": "  # Start with the goal item in mind.\n  goal = env.world.cookbook.index.get(item)\n  if goal is None:\n    raise ValueError(\"Unknown item to craft\")\n  \n  # Get the recipe for this goal item.\n  recipe = env.world.primitives_for(goal)\n  actions = []\n\n  # Iterate over the ingredients in the recipe.\n  for ingredient, count in recipe.items():\n    ingredient_idx = env.world.cookbook.index.get(ingredient)\n    if ingredient_idx is None:\n      raise ValueError(\"Unknown ingredient to craft\")\n    \n    # Check if we have enough of this ingredient in the inventory.\n    while count > 0 and env.state.inventory[ingredient_idx] > 0:\n      actions.append(env.world.cookbook.index.getitem(ingredient))\n      count -= 1\n    \n    # If we don't have enough, try to pick up more until we do or run out of attempts.\n    while count > 0 and not env.state.next_to(ingredient_idx):\n      if np.random.rand() < 0.5:  # Randomly decide to move in a direction.\n        actions.append(np.random.choice([0, 1, 2, 3]))\n      else:\n        break\n    \n    # If we still don't have enough after trying to pick up more, give up on this ingredient.\n    while count > 0 and not env.state.next_to(ingredient_idx):\n      actions.append(4)  # Use the action to try to move closer.\n    \n    if count == 0:\n      continue\n    \n    # If we still don't have enough, pick up more until we do or run out of attempts.\n    while count > 0 and not env.state.next_to(ingredient_idx):\n      actions.append(np.random.choice([0, 1, 2, 3]))\n    \n    if count == 0:\n      continue\n    \n    # If we still don't have enough, give up on this ingredient.\n    while count > 0 and not env.state.next_to(ingredient_idx):\n      actions.append(4)  # Use the action to try to move closer.\n  \n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-05-10T11:49:00.717817", "function_name": "craft", "function_body": "  # Get the recipe for the desired item\n  cookbook = env.world.cookbook\n  goal_index = item\n  if not (0 <= goal_index < len(cookbook.recipes)):\n    raise ValueError(\"Invalid item index\")\n  \n  recipe = cookbook.recipes[goal_index]\n  \n  # Get the indices of the required ingredients from the recipe\n  ingredient_indices = [ingredient for ingredient in recipe if isinstance(ingredient, int)]\n  \n  # Check if we have enough ingredients in the inventory to craft the item\n  inventory = env.state.inventory\n  needed_ingredients = {index: count for index, count in recipe.items() if isinstance(index, int)}\n  has_enough_ingredients = all(inventory[index] >= count for index, count in needed_ingredients.items())\n  \n  # If we don't have enough ingredients, return an empty list\n  if not has_enough_ingredients:\n    return []\n  \n  # Craft the item by using the recipe\n  actions = [env.world.index.get(ingredient) for ingredient in needed_ingredients]\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-05-10T11:49:20.171996", "function_name": "craft", "function_body": "  def find_ingredient_location(grid, ingredient_index):\n    for x in range(grid.shape[0]):\n      for y in range(grid.shape[1]):\n        if grid[x, y] == ingredient_index:\n          return (x, y)\n    raise ValueError(f\"Ingredient {ingredient_index} not found in the grid.\")\n\n  recipe = env.world.cookbook.recipes[item]\n  \n  actions = []\n  \n  # Iterate over the ingredients in the recipe\n  for ingredient, count in recipe.items():\n    if ingredient == \"_key\":\n      continue  # Skip the key which is used to represent the output itself\n    \n    # Find the index of the ingredient in the environment\n    ingredient_index = env.world.cookbook.index[ingredient]\n    \n    # Move to the ingredient location and add the action to the list\n    current_pos = find_ingredient_location(env._current_state.grid, ingredient_index)\n    if current_pos[0] < env._current_state.pos[0]:\n      actions.append(1)  # Move UP\n    elif current_pos[0] > env._current_state.pos[0]:\n      actions.append(3)  # Move DOWN\n    elif current_pos[1] < env._current_state.pos[1]:\n      actions.append(2)  # Move LEFT\n    elif current_pos[1] > env._current_state.pos[1]:\n      actions.append(0)  # Move RIGHT\n    \n    if ingredient == \"stone\":\n      actions.append(4)  # Use the stone to craft the item\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
