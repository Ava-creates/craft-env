{"timestamp": "2025-05-09T23:18:56.037438", "function_name": "craft", "function_body": "  def get_recipe(goal_idx):\n    recipe = env.world.cookbook.recipes[goal_idx]\n    ingredients = {k: v for k, v in recipe.items() if isinstance(k, int)}\n    return ingredients\n  \n  goal_idx = item\n  recipe = get_recipe(goal_idx)\n  actions = []\n  for ingredient_index, count in recipe.items():\n    if env.world.cookbook.primitives[ingredient_index]:\n      # If the ingredient is a primitive, add pickup and craft actions\n      actions.append(env.world.non_grabbable_indices.get(ingredient_index))  # Pickup action\n      actions.append(4)  # Craft action\n    else:\n      # If the ingredient requires further crafting, recursively call get_actions for that ingredient\n      subgoal = env.world.cookbook.primitives[ingredient_index]\n      actions.extend(craft_v2(env, subgoal))\n  \n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-05-09T23:18:57.918196", "function_name": "craft", "function_body": "  recipe = env.world.cookbook.primitives_for(item)\n  if not recipe:\n    return []\n  \n  actions = []\n  for ingredient_index, count in recipe.items():\n    ingredient_item = env.world.cookbook.index[ingredient_index]\n    # Recursively find the actions to craft each ingredient\n    actions += craft_v2(env, ingredient_item)\n    \n    # Add the action to pick up the crafted item if it's not already in inventory\n    if env.world.cookbook.index[ingredient_index] != item:\n      actions.append(4)  # USE action\n  \n  return actions", "island_id": 5, "scores": {"3": -1}}
