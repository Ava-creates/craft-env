{"timestamp": "2025-05-10T06:51:34.942123", "function_name": "craft", "function_body": "  def find_ingredient_index(ingredient_name):\n    if ingredient_name in env.world.cookbook.primitives:\n      return env.world.cookbook.index[ingredient_name]\n    else:\n      for recipe in env.world.cookbook.recipes.values():\n        if list(recipe.keys())[0] == ingredient_name:\n          return list(recipe.keys())[0]  # Return the index directly since it's a primitive\n\n  def get_ingredient_index(ingredient_name):\n    return env.world.cookbook.index[ingredient_name]\n\n  recipe = env.world.cookbook.recipes[item]\n  \n  actions = []\n  \n  for ingredient, count in recipe.items():\n    if ingredient == \"_key\":\n      continue  # Skip the key which is used to represent the output itself\n    \n    ingredient_index = find_ingredient_index(ingredient)\n    \n    # Move to the ingredient location and add the action to the list\n    actions.append(1)  # Move UP (assuming the ingredients are above the agent initially)\n    actions.append(4)  # Use the ingredient to craft the item\n  \n  return actions", "island_id": 2, "scores": {"3": 2.5}}
{"timestamp": "2025-05-10T06:51:36.852728", "function_name": "craft", "function_body": "  def get_ingredient_index(ingredient_name):\n    if ingredient_name in env.world.cookbook.primitives:\n      return env.world.cookbook.index[ingredient_name]\n    else:\n      for recipe in env.world.cookbook.recipes.values():\n        if list(recipe.keys())[0] == ingredient_name:\n          return list(recipe.keys())[0]  # Return the index directly since it's a primitive\n\n  def get_ingredient_location(ingredient_index):\n    for y in range(env.world.grid.shape[1]):\n      for x in range(env.world.grid.shape[0]):\n        if env.world.grid[x, y, ingredient_index] > 0:\n          return (x, y)\n    raise ValueError(f\"Ingredient {ingredient_index} not found in the grid.\")\n\n  recipe = env.world.cookbook.recipes[item]\n  \n  actions = []\n  \n  for ingredient, count in recipe.items():\n    if ingredient == \"_key\":\n      continue  # Skip the key which is used to represent the output itself\n    \n    ingredient_index = get_ingredient_index(ingredient)\n    ingredient_location = get_ingredient_location(ingredient_index)\n    \n    # Move to the ingredient location and add the action to the list\n    move_actions = []\n    if ingredient_location[1] > env.state.pos[1]:\n      move_actions.append(1)  # Move UP\n    elif ingredient_location[1] < env.state.pos[1]:\n      move_actions.append(2)  # Move DOWN\n    elif ingredient_location[0] > env.state.pos[0]:\n      move_actions.append(3)  # Move RIGHT\n    elif ingredient_location[0] < env.state.pos[0]:\n      move_actions.append(4)  # Move LEFT\n    \n    actions.extend(move_actions)\n    actions.append(4)  # Use the ingredient to craft the item\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-05-10T06:51:38.959783", "function_name": "craft", "function_body": "  def get_ingredient_index(ingredient_name):\n    if ingredient_name in env.world.cookbook.primitives:\n      return env.world.cookbook.index[ingredient_name]\n    else:\n      for recipe in env.world.cookbook.recipes.values():\n        if list(recipe.keys())[0] == ingredient_name:\n          return list(recipe.keys())[0]  # Return the index directly since it's a primitive\n\n  def get_ingredient_indices(recipe):\n    return [get_ingredient_index(key) if key != \"_key\" else None for key in recipe.keys()]\n\n  recipe = env.world.cookbook.recipes[item]\n  \n  actions = []\n  \n  ingredient_indices = get_ingredient_indices(recipe)\n  \n  # Filter out None values which represent the final product itself\n  filtered_ingredient_indices = [index for index in ingredient_indices if index is not None]\n  \n  # Move to each ingredient location and use them to craft the item\n  for idx in filtered_ingredient_indices:\n    actions.append(1)  # Move UP (assuming the ingredients are above the agent initially)\n    actions.append(4)  # Use the ingredient to craft the item\n  \n  return actions", "island_id": 2, "scores": {"3": 1.0}}
