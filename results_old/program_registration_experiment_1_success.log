{"timestamp": "2025-05-09T18:39:05.658916", "function_name": "craft", "function_body": "  # Get the recipe for the given item\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index.get(item)\n  if goal_index is None:\n    raise ValueError(\"Item not found in cookbook\")\n  \n  # Get the ingredients and counts from the recipe\n  recipe = cookbook.recipes[goal_index]\n  needed_ingredients = {}\n  for ingredient, count in recipe.items():\n    if isinstance(ingredient, str):  # It's an item name, not \"_key\"\n      ingredient_index = cookbook.index.get(ingredient)\n      if ingredient_index is None:\n        raise ValueError(f\"Ingredient {ingredient} not found in cookbook\")\n      needed_ingredients[ingredient_index] = count\n  \n  # Check inventory and collect necessary ingredients\n  state = env._current_state\n  inventory = state.inventory\n  actions = []\n  for ingredient, count in needed_ingredients.items():\n    while count > 0:\n      if inventory[ingredient] > 0:\n        actions.append(env.world.grabbable_indices.index(ingredient) + 4)  # Use pickup action\n        inventory[ingredient] -= 1\n        count -= 1\n      else:\n        # Move to the nearest ingredient if possible\n        pos = state.pos\n        directions = [(0, -1), (0, 1), (-1, 0), (1, 0)]  # UP, DOWN, LEFT, RIGHT\n        found = False\n        for direction in directions:\n          new_pos = (pos[0] + direction[0], pos[1] + direction[1])\n          if env.world.grid[new_pos].any():  # Check if the cell is not empty\n            actions.append(direction_to_action(direction))\n            found = True\n            break\n        if not found:\n          raise ValueError(\"No path to ingredient\")\n  \n  # Craft the item\n  actions.append(4)  # Use action to craft\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
