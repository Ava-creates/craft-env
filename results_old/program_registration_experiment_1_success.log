{"timestamp": "2025-05-10T04:18:27.112736", "function_name": "craft", "function_body": "  def get_recipe(item):\n    if isinstance(item, int):  # If it's an ingredient (int), return its index and add the action to craft it\n      return [env.world.grabbable_indices.index(item)]\n    elif hasattr(item, 'primitives'):  # If it's a recipe output, get its ingredients\n      return [get_recipe(ingredient) for ingredient in item.primitives]\n    else:\n      raise ValueError(\"Invalid item type.\")\n\n  try:\n    recipe = env.world.cookbook.primitives_for(item)\n    if not recipe:\n      return []\n    \n    actions = [1, 4]  # Move to workshop and use\n    ingredients = get_recipe(env.world.grabbable_indices.index(item))\n    for ingredient in ingredients:\n      if isinstance(ingredient, list):  # If it's a nested list of ingredients, recursively process each one\n        for sub_ingredient in ingredient:\n          actions += [1, 4] + [sub_ingredient]\n      else:  # Otherwise, just add the action to craft the ingredient\n        actions += [1, 4] + [ingredient]\n    return actions\n  except Exception as e:\n    print(f\"Error in craft_v2 function: {e}\")\n    return []", "island_id": 5, "scores": {"3": 2.5}}
{"timestamp": "2025-05-10T04:18:43.798586", "function_name": "craft", "function_body": "  # Get the recipe for the desired item.\n  recipe = env.world.cookbook.recipes[item]\n  \n  # Initialize an empty list to hold the actions needed to craft the item.\n  actions = []\n  \n  # Iterate over each ingredient in the recipe.\n  for ingredient_index, count in recipe.items():\n    if isinstance(ingredient_index, str) and 'primitive' in ingredient_index:\n      primitive_kind_index = int(ingredient_index.split('[')[-1].rstrip(']'))\n      # Find the index of the primitive resource in the environment's cookbook.\n      for i, kind in enumerate(env.world.cookbook.kinds):\n        if env.world.cookbook.reverse_contents[i] == 'primitive':\n          if env.world.cookbook.primitives[i] == primitive_kind_index:\n            # Add the necessary actions to pick up and store the primitive resource in inventory.\n            pos = np.where(env.grid[:,:,i] != 0)\n            for x, y in zip(*pos):\n              if env.grid[x, y, i] == 1:\n                # Check if the position is valid to pick up the item and move there.\n                actions += get_move_actions(env, (x, y))\n                break\n            actions.append(4)  # Use action to store the primitive in inventory.\n    elif ingredient_index == \"_key\":\n      continue\n  \n  return actions", "island_id": 6, "scores": {"3": 1.0}}
