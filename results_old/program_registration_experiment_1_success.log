{"timestamp": "2025-05-10T12:24:10.847760", "function_name": "craft", "function_body": "  def find_ingredient(ingredient_name):\n    ingredient_index = env.world.cookbook.index[ingredient_name]\n    return ingredient_index\n\n  recipe = env.world.cookbook.recipes[item]\n  \n  actions = []\n  \n  for ingredient, count in recipe.items():\n    if ingredient == \"_key\":\n      continue  # Skip the key which is used to represent the output itself\n    \n    ingredient_index = find_ingredient(ingredient)\n    \n    # Calculate the position to move to based on the ingredient index\n    pos = env.world.grabbable_indices[ingredient_index]\n    \n    # Move to the ingredient location and add the action to the list\n    if pos != env.state._cached_features_dict['pos']:\n      dx, dy = pos[0] - env.state.pos[0], pos[1] - env.state.pos[1]\n      if dx > 0: actions.append(3)  # Move RIGHT\n      elif dx < 0: actions.append(2)  # Move LEFT\n      elif dy > 0: actions.append(1)  # Move UP\n      elif dy < 0: actions.append(0)  # Move DOWN\n    \n    actions.append(4)  # Use the ingredient to craft the item\n  \n  return actions", "island_id": 3, "scores": {"3": -1}}
