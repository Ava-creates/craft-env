{"timestamp": "2025-05-09T23:10:41.675236", "function_name": "craft", "function_body": "  # Get the indices for the goal and its ingredients from the environment's cookbook.\n  goal_index = env.world.cookbook.index.get(item)\n  if goal_index is None:\n    raise ValueError(f\"Item {item} not found in cookbook.\")\n  \n  # Retrieve the recipe for the goal item.\n  recipe = env.world.primitives_for(goal_index)\n  \n  actions = []\n  \n  # Iterate over the ingredients and their counts required to craft the item.\n  for ingredient, count in recipe.items():\n    if ingredient < len(env.grabbable_indices):  # Check if it's a grabbable index\n      action = env.grabbable_indices.index(ingredient)\n      actions.extend([action] * count)\n  \n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-05-09T23:10:43.579399", "function_name": "craft", "function_body": "  # Find the recipe for the given item\n  goal_index = env.world.cookbook.index[item]\n  output_index = np.argmax([0] + [r[goal_index].get('_key', 0) for r in env.world.recipes])\n  if output_index == 0:\n    return []  # No recipe found, cannot craft the item\n  \n  # Get the ingredients and their counts from the recipe\n  recipe = env.world.recipes[output_index]\n  ingredients = {k: v for k, v in recipe.items() if isinstance(k, int)}\n  \n  actions = []\n  for ingredient_index, count in ingredients.items():\n    # Check if the ingredient is already in the inventory\n    while env._current_state.inventory[ingredient_index] < count:\n      # If not, find and pick up the ingredient\n      found = False\n      for y in range(env.world.n_kinds):\n        for x in range(env.world.n_kinds):\n          if env.grid[x, y, ingredient_index] > 0:\n            # Move to the ingredient position and pick it up\n            pos = (x, y)\n            while pos != env._current_state.pos:\n              if pos[0] < env._current_state.pos[0]:\n                actions.append(3)  # LEFT\n                pos = (pos[0]+1, pos[1])\n              elif pos[0] > env._current_state.pos[0]:\n                actions.append(2)  # RIGHT\n                pos = (pos[0]-1, pos[1])\n              if pos[1] < env._current_state.pos[1]:\n                actions.append(1)  # UP\n                pos = (pos[0], pos[1]+1)\n              elif pos[1] > env._current_state.pos[1]:\n                actions.append(0)  # DOWN\n                pos = (pos[0], pos[1]-1)\n            actions.append(4)  # USE\n            found = True\n            break\n        if found: break\n      if not found: raise ValueError(f\"Ingredient {ingredient_index} not found in the environment.\")\n    \n    # Use the ingredient to craft the item\n    for _ in range(count):\n      actions.append(4)  # USE\n  \n  return actions", "island_id": 8, "scores": {"3": -1}}
