{"timestamp": "2025-05-10T11:06:03.449196", "function_name": "craft", "function_body": "  def find_ingredient_location(grid, ingredient_index):\n    for x in range(grid.shape[0]):\n      for y in range(grid.shape[1]):\n        if grid[x, y] == ingredient_index:\n          return (x, y)\n    raise ValueError(f\"Ingredient {ingredient_index} not found in the grid.\")\n  \n  recipe = env.world.cookbook.recipes[item]\n  \n  actions = []\n  \n  # Iterate over the ingredients in the recipe\n  for ingredient, count in recipe.items():\n    if ingredient == \"_key\":\n      continue  # Skip the key which is used to represent the output itself\n    \n    # Find the index of the ingredient in the environment\n    ingredient_index = env.world.cookbook.index[ingredient]\n    \n    # Move to the ingredient location and add the action to the list\n    current_pos = find_ingredient_location(env._current_state.grid, ingredient_index)\n    if current_pos[0] > env._current_state.pos[0]:  # If the ingredient is below the agent\n      for _ in range(current_pos[0] - env._current_state.pos[0]):\n        actions.append(1)  # Move UP until aligned vertically\n    elif current_pos[0] < env._current_state.pos[0]:  # If the ingredient is above the agent\n      for _ in range(env._current_state.pos[0] - current_pos[0]):\n        actions.append(3)  # Move DOWN until aligned vertically\n    elif current_pos[1] > env._current_state.pos[1]:  # If the ingredient is to the left of the agent\n      for _ in range(current_pos[1] - env._current_state.pos[1]):\n        actions.append(2)  # Move LEFT until aligned horizontally\n    elif current_pos[1] < env._current_state.pos[1]:  # If the ingredient is to the right of the agent\n      for _ in range(env._current_state.pos[1] - current_pos[1]):\n        actions.append(0)  # Move RIGHT until aligned horizontally\n    \n    actions.append(4)  # Use the ingredient to craft the item\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
