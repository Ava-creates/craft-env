{"timestamp": "2025-05-10T13:58:00.151665", "function_name": "craft", "function_body": "  def find_ingredient_location(grid, ingredient_index):\n    for x in range(grid.shape[0]):\n      for y in range(grid.shape[1]):\n        if grid[x, y] == ingredient_index:\n          return (x, y)\n    raise ValueError(f\"Ingredient {ingredient_index} not found in the grid.\")\n\n  def move_to_ingredient(pos, dir, ingredient_pos):\n    dx = ingredient_pos[0] - pos[0]\n    dy = ingredient_pos[1] - pos[1]\n    if dx > 0:\n      return 3  # RIGHT\n    elif dx < 0:\n      return 2  # LEFT\n    elif dy > 0:\n      return 1  # UP\n    elif dy < 0:\n      return 0  # DOWN\n    else:\n      raise ValueError(\"Ingredient is already at the agent's position.\")\n\n  recipe = env.world.cookbook.recipes[item]\n  \n  actions = []\n  \n  for ingredient, count in recipe.items():\n    if ingredient == \"_key\":\n      continue\n    \n    ingredient_index = env.world.cookbook.index[ingredient]\n    ingredient_pos = find_ingredient_location(env.grid, ingredient_index)\n    \n    # Determine the action to move to the ingredient location\n    while True:\n      if pos == ingredient_pos:\n        break  # Stop when at the ingredient's position\n      \n      if dir == 0 and env.non_grabbable_indices[ingredient_index] not in (1, 2):  # UP\n        actions.append(1)\n        pos = (max(pos[0]-1, 0), pos[1])\n        dir = 1\n      elif dir == 1 and env.non_grabbable_indices[ingredient_index] not in (3, 4):  # RIGHT\n        actions.append(3)\n        pos = (pos[0], min(pos[1]+1, env.grid.shape[1]-1))\n        dir = 3\n      elif dir == 2 and env.non_grabbable_indices[ingredient_index] not in (5, 6):  # DOWN\n        actions.append(0)\n        pos = (min(pos[0]+1, env.grid.shape[0]-1), pos[1])\n        dir = 0\n      elif dir == 3 and env.non_grabbable_indices[ingredient_index] not in (7, 8):  # LEFT\n        actions.append(2)\n        pos = (pos[0], max(pos[1]-1, 0))\n        dir = 2\n    \n    actions.append(4)  # Use the ingredient to craft the item\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
