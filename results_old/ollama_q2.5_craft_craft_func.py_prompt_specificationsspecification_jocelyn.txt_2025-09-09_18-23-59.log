ay([0, -1])\n\n  # Ensure the agent is facing the workshop before using it\n  dx, dy = nearest_target_pos - pos\n  target_direction = None\n  if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n      target_direction = 3 if dx > 0 else 2\n  else:  # Then move in y-direction\n      target_direction = 1 if dy > 0 else 0\n\n  current_direction = env._current_state.direction  # Assuming there's a direction attribute in CraftState\n\n  # Calculate the rotation needed to face the workshop\n  if (target_direction - current_direction) % 4 == 1:\n      actions.append(5)  # Turn right\n  elif (target_direction - current_direction) % 4 == 3:\n      actions.append(6)  # Turn left\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
