{"timestamp": "2025-09-11T10:58:52.511572", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 5, "scores": {"3": 4.7}}
{"timestamp": "2025-09-11T11:01:41.413728", "function_name": "craft", "function_body": "  def move_to_target(pos, target_pos):\n      actions = []\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          if abs(dx) > abs(dy):  \n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  \n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n      return actions\n\n  def orient_towards_workshop(current_dir, target_direction):\n      direction_map = {0: 90, 1: 0, 2: 270, 3: 180}\n      current_angle = direction_map[current_dir]\n      target_angle = direction_map[target_direction]\n\n      delta_angle = (target_angle - current_angle + 360) % 360\n\n      actions = []\n      if delta_angle > 180:\n          while delta_angle > 180:\n              actions.append(2 if current_dir == 3 else 3)\n              current_dir = (current_dir + 1) % 4\n              delta_angle = (direction_map[target_direction] - direction_map[current_dir] + 360) % 360\n      elif delta_angle < 180 and delta_angle != 0:\n          while delta_angle < 180:\n              actions.append(2 if current_dir == 0 else 3)\n              current_dir = (current_dir - 1) % 4\n              delta_angle = (direction_map[target_direction] - direction_map[current_dir] + 360) % 360\n      \n      return actions\n\n  def get_direction_to_workshop(pos, target_pos):\n      dx, dy = target_pos - pos\n      if abs(dx) > abs(dy):  \n          return 3 if dx > 0 else 2\n      else:  \n          return 1 if dy > 0 else 0\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  move_actions = move_to_target(pos, nearest_target_pos)\n  actions.extend(move_actions)\n\n  # Get the direction to the workshop and orient the agent towards it\n  target_direction = get_direction_to_workshop(env._current_state.pos, nearest_target_pos)\n  orient_actions = orient_towards_workshop(env._current_state.dir, target_direction)\n  actions.extend(orient_actions)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 5, "scores": {"3": 4.0}}
{"timestamp": "2025-09-11T11:01:42.480644", "function_name": "craft", "function_body": "  def move_to_target(pos, target_pos):\n      actions = []\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          if abs(dx) > abs(dy):  \n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  \n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n      return actions\n\n  def orient_towards_workshop(current_dir, target_direction):\n      current_direction_deg = {0: 90, 1: 0, 2: 270, 3: 180}[current_dir]\n      \n      # Calculate the difference in direction\n      delta_direction = (target_direction - current_direction_deg + 360) % 360\n      \n      actions = []\n      while delta_direction > 180:\n          actions.append(2 if current_dir == 3 else 3)\n          current_dir = (current_dir + 1) % 4\n          delta_direction = (target_direction - {0: 90, 1: 0, 2: 270, 3: 180}[current_dir] + 360) % 360\n      \n      while delta_direction < 180 and delta_direction != 0:\n          actions.append(2 if current_dir == 0 else 3)\n          current_dir = (current_dir - 1) % 4\n          delta_direction = (target_direction - {0: 90, 1: 0, 2: 270, 3: 180}[current_dir] + 360) % 360\n      \n      return actions\n\n  def calculate_target_direction(pos, target_pos):\n      dx = target_pos[0] - pos[0]\n      dy = target_pos[1] - pos[1]\n      direction_to_workshop = np.arctan2(dy, dx) * 180 / np.pi\n      if direction_to_workshop < 0:\n          direction_to_workshop += 360\n      return direction_to_workshop\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  move_actions = move_to_target(pos, nearest_target_pos)\n  actions.extend(move_actions)\n\n  # Calculate the target direction towards the workshop\n  target_direction = calculate_target_direction(pos, nearest_target_pos)\n\n  # Orient the agent towards the workshop (optional, might not be necessary)\n  orient_actions = orient_towards_workshop(env._current_state.dir, target_direction)\n  actions.extend(orient_actions)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 5, "scores": {"3": 5.0}}
{"timestamp": "2025-09-11T11:03:49.781872", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  available_workshops = []\n  for recipe in cookbook.recipes.values():\n      if \"_key\" not in recipe or recipe[\"_key\"] != goal_index:\n          continue\n      \n      workshop_types = set(workshop_indices) & set(recipe.keys())\n      for workshop_type in workshop_types:\n          available_workshops.append((workshop_type, recipe[workshop_type]))\n\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  if not available_workshops:\n      raise ValueError(\"No suitable workshop found for the item\")\n\n  # Calculate distances to all workshops\n  for workshop_idx, _ in available_workshops:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-11T11:03:50.767287", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  # Note: This version assumes a specific recipe for the item, and thus might require adjustments.\n  # We need to check if there is a direct match in recipes first.\n  \n  closest_workshop_idx = None\n  \n  for workshop_idx in workshop_indices:\n      for output, ingredients in cookbook.recipes.items():\n          if output == goal_index and workshop_idx in ingredients[\"_key\"]:\n              closest_workshop_idx = workshop_idx\n              break\n\n      if closest_workshop_idx is not None:\n          break\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found for the item\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  if nearest_target_pos is None:\n      raise ValueError(\"No available positions to reach the workshop\")\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Orient the agent towards the workshop (optional, might not be necessary)\n  direction_to_workshop = np.arctan2(nearest_target_pos[1] - pos[1], nearest_target_pos[0] - pos[0]) * 180 / np.pi\n  current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n  \n  if direction_to_workshop < 0:\n      direction_to_workshop += 360\n\n  # Calculate the difference in direction\n  delta_direction = (direction_to_workshop - current_direction + 360) % 360\n  \n  if delta_direction > 180:\n      actions.append(2 if env._current_state.dir == 3 else 3)\n      env._current_state.dir = (env._current_state.dir + 1) % 4\n  elif delta_direction < 180 and delta_direction != 0:\n      actions.append(2 if env._current_state.dir == 0 else 3)\n      env._current_state.dir = (env._current_state.dir - 1) % 4\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
