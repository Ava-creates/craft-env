arget < 0:\n          direction_to_target += 360\n\n      current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n\n      # Calculate the difference in direction\n      delta_direction = (direction_to_target - current_direction + 360) % 360\n\n      actions = []\n\n      if delta_direction > 180:\n          turn_action = 2 if env._current_state.dir == 3 else 3\n          while delta_direction >= 90:\n              actions.append(turn_action)\n              env._current_state.dir = (env._current_state.dir + 1) % 4\n              current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n              delta_direction = (direction_to_target - current_direction + 360) % 360\n\n      else:\n          turn_action = 2 if env._current_state.dir == 0 else 3\n          while delta_direction >= 90:\n              actions.append(turn_action)\n              env._current_state.dir = (env._current_state.dir - 1) % 4\n              current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n              delta_direction = (direction_to_target - current_direction + 360) % 360\n\n      return actions\n  \n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      next_move_action = get_next_move_action(pos, nearest_target_pos)\n      actions.append(next_move_action)\n      \n      # Update the position based on the move action\n      if next_move_action == 3: pos[0] += 1\n      elif next_move_action == 2: pos[0] -= 1\n      elif next_move_action == 1: pos[1] += 1\n      else: pos[1] -= 1\n\n  # Orient the agent towards the workshop\n  actions.extend(orient_towards_target(pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 4, "scores": {"3": 5.0}}
{"timestamp": "2025-09-10T16:19:26.240244", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate all positions of this type of workshop\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          # Find the nearest specific workshop position\n          nearest_target_pos = None\n          min_nearest_distance = float('inf')\n\n          for target_pos in workshop_pos_list:\n              distance = np.linalg.norm(pos - target_pos, ord=2)\n              if distance < min_nearest_distance:\n                  nearest_target_pos = target_pos\n                  min_nearest_distance = distance\n\n          # Update the closest workshop if this one is closer\n          if min_nearest_distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, min_nearest_distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  nearest_target_pos = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])[0]\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Calculate the direction to face towards the workshop\n  current_direction = env._current_state.dir\n  target_direction = None\n  \n  if nearest_target_pos[1] == pos[1]:  # Same y-axis\n      target_direction = 3 if nearest_target_pos[0] < pos[0] else 2\n  elif nearest_target_pos[0] == pos[0]:  # Same x-axis\n      target_direction = 1 if nearest_target_pos[1] > pos[1] else 0\n\n  # Adjust direction to face the workshop\n  while current_direction != target_direction:\n      if (target_direction - current_direction) % 4 == 1 or (target_direction - current_direction) % 4 == -3:\n          actions.append(2)  # Turn left\n      elif (target_direction - current_direction) % 4 == 2 or (target_direction - current_direction) % 4 == -2:\n          actions.append(2)\n          actions.append(2)  # Turn around\n      else:\n          actions.append(3)  # Turn right\n      \n      current_direction = (current_direction + 1) % 4 if actions[-1] == 3 else (current_direction - 1) % 4\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-10T16:24:26.324249", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate all positions of this type of workshop\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          # Find the nearest specific workshop position\n          nearest_target_pos = None\n          min_nearest_distance = float('inf')\n\n          for target_pos in workshop_pos_list:\n              distance = np.linalg.norm(pos - target_pos, ord=2)\n              if distance < min_nearest_distance:\n                  nearest_target_pos = target_pos\n                  min_nearest_distance = distance\n\n          # Update the closest workshop if this one is closer\n          if min_nearest_distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, min_nearest_distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  nearest_target_pos = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])[0]\n\n  # Calculate direction vector to the target position\n  dx, dy = nearest_target_pos - pos\n\n  # Normalize direction vector\n  distance = np.linalg.norm([dx, dy])\n  if distance > 0:\n      dx /= distance\n      dy /= distance\n\n  # Move towards the workshop\n  while not np.array_equal(pos, nearest_target_pos):\n      # Determine next step based on direction vector\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Check the orientation of the agent and adjust if necessary\n  direction_to_workshop = np.arctan2(nearest_target_pos[1] - pos[1], nearest_target_pos[0] - pos[0]) * 180 / np.pi\n  current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n  \n  if direction_to_workshop < 0:\n      direction_to_workshop += 360\n\n  # Calculate the difference in direction\n  delta_direction = (direction_to_workshop - current_direction + 360) % 360\n  \n  # Adjust agent's direction to face the workshop\n  while delta_direction != 0:\n      if delta_direction > 180:\n          actions.append(2 if env._current_state.dir == 3 else 3)\n          env._current_state.dir = (env._current_state.dir + 1) % 4\n      elif delta_direction < 180 and delta_direction != 0:\n          actions.append(2 if env._current_state.dir == 0 else 3)\n          env._current_state.dir = (env._current_state.dir - 1) % 4\n      \n      direction_to_workshop = np.arctan2(nearest_target_pos[1] - pos[1], nearest_target_pos[0] - pos[0]) * 180 / np.pi\n      current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n      \n      if direction_to_workshop < 0:\n          direction_to_workshop += 360\n      \n      delta_direction = (direction_to_workshop - current_direction + 360) % 360\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-10T16:27:01.888038", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Calculate the sequence of moves required to reach the target position using A* algorithm\n  def heuristic(a, b):\n      return np.linalg.norm(np.array(a) - np.array(b), ord=2)\n\n  open_set = []\n  closed_set = set()\n  g_score = {tuple(pos): 0}\n  f_score = {tuple(pos): heuristic(pos, nearest_target_pos)}\n  came_from = {}\n\n  heapq.heappush(open_set, (f_score[tuple(pos)], tuple(pos)))\n\n  while open_set:\n      _, current = heapq.heappop(open_set)\n\n      if np.array_equal(np.array(current), nearest_target_pos):\n          path = []\n          while current in came_from:\n              path.append(current)\n              current = came_from[current]\n          path.reverse()\n          break\n\n      closed_set.add(current)\n\n      for neighbor in [(current[0] + 1, current[1]), (current[0] - 1, current[1]), (current[0], current[1] + 1), (current[0], current[1] - 1)]:\n          tentative_g_score = g_score[tuple(current)] + heuristic(current, neighbor)\n\n          if tuple(neighbor) not in closed_set and env._current_state.grid[neighbor[1], neighbor[0]] != 0:  # Ensure the agent can move to the neighbor\n              if tuple(neighbor) not in g_score or tentative_g_score < g_score[tuple(neighbor)]:\n                  came_from[tuple(neighbor)] = current\n                  g_score[tuple(neighbor)] = tentative_g_score\n                  f_score[tuple(neighbor)] = tentative_g_score + heuristic(neighbor, nearest_target_pos)\n                  if tuple(neighbor) not in [x[1] for x in open_set]:\n                      heapq.heappush(open_set, (f_score[tuple(neighbor)], tuple(neighbor)))\n\n  else:\n      raise ValueError(\"No path found to the workshop\")\n\n  # Convert the path into actions\n  for i in range(len(path) - 1):\n      dx = path[i + 1][0] - path[i][0]\n      dy = path[i + 1][1] - path[i][1]\n\n      if dx == 1:\n          actions.append(3)\n      elif dx == -1:\n          actions.append(2)\n      elif dy == 1:\n          actions.append(1)\n      elif dy == -1:\n          actions.append(0)\n\n  # Orient the agent towards the workshop (optional, might not be necessary)\n  direction_to_workshop = np.arctan2(nearest_target_pos[1] - pos[1], nearest_target_pos[0] - pos[0]) * 180 / np.pi\n  current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n  \n  if direction_to_workshop < 0:\n      direction_to_workshop += 360\n\n  # Calculate the difference in direction\n  delta_direction = (direction_to_workshop - current_direction + 360) % 360\n  \n  if delta_direction > 180:\n      actions.append(2 if env._current_state.dir == 3 else 3)\n      env._current_state.dir = (env._current_state.dir + 1) % 4\n  elif delta_direction < 180 and delta_direction != 0:\n      actions.append(2 if env._current_state.dir == 0 else 3)\n      env._current_state.dir = (env._current_state.dir - 1) % 4\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
