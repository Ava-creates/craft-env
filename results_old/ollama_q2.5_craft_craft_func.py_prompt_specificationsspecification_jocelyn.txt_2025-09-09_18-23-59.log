n = nearest_target_pos - pos\n  current_direction = np.array([np.cos(env._current_state.pos[2]), np.sin(env._current_state.pos[2])])\n\n  angle_diff = np.arctan2(target_direction[1], target_direction[0]) - np.arctan2(current_direction[1], current_direction[0])\n  angle_diff = (angle_diff + np.pi) % (2 * np.pi) - np.pi\n\n  if angle_diff > 0:\n      actions.append(3)  # Turn RIGHT\n  elif angle_diff < 0:\n      actions.append(2)  # Turn LEFT\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 3, "scores": {"3": -1}}
