{"timestamp": "2025-09-10T23:21:32.728659", "function_name": "craft", "function_body": "  def calculate_distance(pos1, pos2):\n      return np.linalg.norm(np.array(pos1) - np.array(pos2), ord=2)\n\n  def find_nearest_workshop(state, workshop_indices):\n      pos = np.array(state.pos)\n      nearest_workshop_idx, min_distance = None, float('inf')\n      \n      for workshop_idx in workshop_indices:\n          workshop_pos_list = np.argwhere(state.grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) > 0:\n              nearest_target_pos = min(workshop_pos_list, key=lambda pos: calculate_distance(pos, state.pos))\n              distance = calculate_distance(nearest_target_pos, pos)\n              \n              if distance < min_distance:\n                  nearest_workshop_idx, min_distance = workshop_idx, distance\n      \n      return nearest_workshop_idx, nearest_target_pos\n\n  def move_to_position(state, target_pos):\n      actions = []\n      pos = np.array(state.pos)\n\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          \n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n      \n      return actions\n\n  def orient_towards_workshop(state, target_pos):\n      actions = []\n      \n      direction_to_workshop = np.arctan2(target_pos[1] - state.pos[1], target_pos[0] - state.pos[0]) * 180 / np.pi\n      current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[state.dir]\n      \n      if direction_to_workshop < 0:\n          direction_to_workshop += 360\n\n      delta_direction = (direction_to_workshop - current_direction + 360) % 360\n      \n      if delta_direction > 180:\n          actions.append(2 if state.dir == 3 else 3)\n          state.dir = (state.dir + 1) % 4\n      elif delta_direction < 180 and delta_direction != 0:\n          actions.append(2 if state.dir == 0 else 3)\n          state.dir = (state.dir - 1) % 4\n      \n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  # Find the nearest workshop that can craft the desired item\n  closest_workshop_idx, nearest_target_pos = find_nearest_workshop(env._current_state, workshop_indices)\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  actions = []\n\n  # Move to the closest workshop position\n  actions.extend(move_to_position(env._current_state, nearest_target_pos))\n\n  # Orient the agent towards the workshop (optional)\n  actions.extend(orient_towards_workshop(env._current_state, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 3.7}}
