t the agent towards the workshop (optional, might not be necessary)\n  direction_to_workshop = np.arctan2(nearest_target_pos[1] - pos[1], nearest_target_pos[0] - pos[0]) * 180 / np.pi\n  current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n  \n  if direction_to_workshop < 0:\n      direction_to_workshop += 360\n\n  # Calculate the difference in direction\n  delta_direction = (direction_to_workshop - current_direction + 360) % 360\n  \n  while delta_direction > 180:\n      actions.append(2 if env._current_state.dir == 3 else 3)\n      env._current_state.dir = (env._current_state.dir + 1) % 4\n      direction_to_workshop = np.arctan2(nearest_target_pos[1] - pos[1], nearest_target_pos[0] - pos[0]) * 180 / np.pi\n      current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n      delta_direction = (direction_to_workshop - current_direction + 360) % 360\n  \n  while delta_direction < 180 and delta_direction != 0:\n      actions.append(2 if env._current_state.dir == 0 else 3)\n      env._current_state.dir = (env._current_state.dir - 1) % 4\n      direction_to_workshop = np.arctan2(nearest_target_pos[1] - pos[1], nearest_target_pos[0] - pos[0]) * 180 / np.pi\n      current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n      delta_direction = (direction_to_workshop - current_direction + 360) % 360\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 5, "scores": {"3": 5.0}}
{"timestamp": "2025-09-11T14:02:21.739826", "function_name": "craft", "function_body": "  def move_to_target(current_pos, target_pos):\n      actions = []\n      while not np.array_equal(current_pos, target_pos):\n          dx, dy = target_pos - current_pos\n          if abs(dx) > abs(dy):  \n              actions.append(3 if dx > 0 else 2)\n              current_pos[0] += 1 if dx > 0 else -1\n          else:  \n              actions.append(1 if dy > 0 else 0)\n              current_pos[1] += 1 if dy > 0 else -1\n      return actions\n\n  def orient_towards_workshop(current_dir, target_direction):\n      # Map agent's direction to degrees (90: up, 0: right, 270: down, 180: left)\n      current_direction_deg = {0: 90, 1: 0, 2: 270, 3: 180}[current_dir]\n      \n      # Calculate the difference in direction\n      delta_direction = (target_direction - current_direction_deg + 360) % 360\n      \n      actions = []\n      while delta_direction > 180:\n          actions.append(2 if current_dir == 3 else 3)\n          current_dir = (current_dir + 1) % 4\n          delta_direction = (target_direction - {0: 90, 1: 0, 2: 270, 3: 180}[current_dir] + 360) % 360\n      \n      while delta_direction < 180 and delta_direction != 0:\n          actions.append(2 if current_dir == 0 else 3)\n          current_dir = (current_dir - 1) % 4\n          delta_direction = (target_direction - {0: 90, 1: 0, 2: 270, 3: 180}[current_dir] + 360) % 360\n      \n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  \n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  current_pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(workshop_positions) == 0: \n          continue\n      \n      # Calculate the closest position among all workshops of this type\n      nearest_workshop_pos = None\n      min_nearest_distance = float('inf')\n      \n      for workshop_pos in workshop_positions:\n          distance = np.linalg.norm(current_pos - workshop_pos, ord=2)\n          \n          if distance < min_nearest_distance:\n              nearest_workshop_pos = workshop_pos\n              min_nearest_distance = distance\n      \n      # Update the closest workshop and its position\n      if min_nearest_distance < min_distance:\n          closest_workshop_idx = workshop_idx\n          closest_workshop_pos = nearest_workshop_pos\n          min_distance = min_nearest_distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  move_actions = move_to_target(current_pos, closest_workshop_pos)\n  actions.extend(move_actions)\n\n  # Calculate the target direction towards the workshop\n  direction_to_workshop = np.arctan2(closest_workshop_pos[1] - current_pos[1], closest_workshop_pos[0] - current_pos[0]) * 180 / np.pi\n  if direction_to_workshop < 0:\n      direction_to_workshop += 360\n\n  # Orient the agent towards the workshop (optional, might not be necessary)\n  orient_actions = orient_towards_workshop(env._current_state.dir, direction_to_workshop)\n  actions.extend(orient_actions)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 5, "scores": {"3": 5.0}}
{"timestamp": "2025-09-11T14:09:21.600915", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      direction = (np.arctan2(dy, dx) * 180 / np.pi + 360) % 360 // 90\n      current_direction = env._current_state.dir\n      \n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          move_action = (2 if direction == 0 else 3)\n          pos[0] += 1 if direction == 3 else -1\n      else:  # Then move in y-direction\n          move_action = (0 if direction == 1 else 1)\n          pos[1] += 1 if direction == 0 else -1\n      \n      if current_direction != direction:\n          actions.append(2 if (direction - current_direction) % 4 == 1 else 3)\n          env._current_state.dir = direction\n      actions.append(move_action)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-11T14:09:22.574279", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  recipe = cookbook.recipes[goal_index]\n  \n  # Check if the required primitives are in the inventory\n  for primitive, count in recipe.primitives.items():\n      if env._current_state.inventory.get(primitive, 0) < count:\n          raise ValueError(f\"Not enough {primitive} in inventory to craft {item}\")\n\n  workshop_indices = [env.world.cookbook.index[workshop] for workshop in recipe.workshops]\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = neares