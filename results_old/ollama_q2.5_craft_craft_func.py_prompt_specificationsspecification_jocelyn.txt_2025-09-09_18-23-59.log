)\n\n      if np.array_equal(current, nearest_target_pos):\n          path = []\n          while current in came_from:\n              path.append(current)\n              current = came_from[current]\n          path.reverse()\n          return path\n\n      open_set.remove(current)\n      closed_set.add(current)\n\n      for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n          neighbor = (current[0] + dx, current[1] + dy)\n          if neighbor not in closed_set and \\\n             0 <= neighbor[0] < grid_height and 0 <= neighbor[1] < grid_width and \\\n             env._current_state.grid[neighbor[0], neighbor[1], closest_workshop_idx] == 0:\n              tentative_g_score = g_score[tuple(current)] + heuristic(current, neighbor)\n\n              if neighbor not in open_set or tentative_g_score < g_score.get(neighbor, float('inf')):\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, nearest_target_pos)\n                  open_set.add(neighbor)\n\n  # Convert path to actions\n  path = a_star_path(env._current_state.pos, nearest_target_pos, env._current_state.grid[:, :, closest_workshop_idx])\n  \n  for i in range(len(path) - 1):\n      dx, dy = path[i + 1][0] - path[i][0], path[i + 1][1] - path[i][1]\n      if dx == 1:\n          actions.append(3)\n      elif dx == -1:\n          actions.append(2)\n      elif dy == 1:\n          actions.append(1)\n      elif dy == -1:\n          actions.append(0)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-10T01:00:09.776079", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  \n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(workshop_pos_list) > 0:  \n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          \n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Find the nearest workshop position from the mean position\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  \n  nearest_target_pos = min(target_positions, key=lambda p: np.linalg.norm(pos - p, ord=2))\n\n  # Ensure the nearest position is within the grid bounds\n  grid_height, grid_width, _ = env._current_state.grid.shape\n  nearest_target_pos[0] = max(0, min(nearest_target_pos[0], grid_height - 1))\n  nearest_target_pos[1] = max(0, min(nearest_target_pos[1], grid_width - 1))\n\n  # Calculate the path to the nearest target position using A* algorithm\n  def heuristic(a, b):\n      return np.linalg.norm(np.array(a) - np.array(b), ord=2)\n\n  def a_star_search(start, goal):\n      open_set = []\n      heapq.heappush(open_set, (0, start))\n      came_from = {}\n      g_score = {tuple(start): 0}\n      f_score = {tuple(start): heuristic(start, goal)}\n\n      while open_set:\n          _, current = heapq.heappop(open_set)\n\n          if np.array_equal(current, goal):\n              path = []\n              while tuple(current) in came_from:\n                  path.append(tuple(current))\n                  current = came_from[tuple(current)]\n              return path[::-1]\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = np.array(current) + np.array([dx, dy])\n              tentative_g_score = g_score[tuple(current)] + heuristic(current, neighbor)\n              \n              if not (0 <= neighbor[0] < grid_height and 0 <= neighbor[1] < grid_width):\n                  continue\n              \n              if tuple(neighbor) not in g_score or tentative_g_score < g_score[tuple(neighbor)]:\n                  came_from[tuple(neighbor)] = tuple(current)\n                  g_score[tuple(neighbor)] = tentative_g_score\n                  f_score[tuple(neighbor)] = tentative_g_score + heuristic(neighbor, goal)\n                  heapq.heappush(open_set, (f_score[tuple(neighbor)], neighbor))\n\n      return []\n\n  path = a_star_search(pos, nearest_target_pos)\n\n  # Convert the path to actions\n  for i in range(len(path) - 1):\n      dx, dy = path[i + 1][0] - path[i][0], path[i + 1][1] - path[i][1]\n      \n      if dx == 1:\n          actions.append(3)  # RIGHT\n      elif dx == -1:\n          actions.append(2)  # LEFT\n      elif dy == 1:\n          actions.append(1)  # UP\n      elif dy == -1:\n          actions.append(0)  # DOWN\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-10T01:02:17.543176", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n\n  # Calculate distances to all workshops\n  workshop_distances = []\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_distances.append((workshop_idx, np.linalg.norm(pos - workshop_pos_list.mean(axis=0), ord=2)))\n\n  if not workshop_distances:\n      raise ValueError(\"No available workshops found\")\n\n  closest_workshop_idx, min_distance = min(workshop_distances, key=lambda x: x[1])\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[np.argmin(np.linalg.norm(pos - target_positions, axis=1))]\n\n  # Move to the closest workshop position using A* pathfinding for more efficient movement\n  def heuristic(a, b):\n      return np.linalg.norm(np.array(a) - np.array(b), ord=2)\n\n  def a_star(start, goal):\n      open_set = set()\n      closed_set = set()\n      g_score = {start: 0}\n      f_score = {start: heuristic(start, goal)}\n      came_from = {}\n\n      open_set.add(start)\n\n      while open_set:\n          current = min(open_set, key=lambda x: f_score[x])\n\n          if current == goal:\n              path = []\n              while current in came_from:\n                  path.append(current)\n                  current = came_from[current]\n              path.reverse()\n              return path\n\n          open_set.remove(current)\n          closed_set.add(current)\n\n          neighbors = [(current[0] + dx, current[1] + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n          for neighbor in neighbors:\n              tentative_g_score = g_score[current] + heuristic(current, neighbor)\n\n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                  open_set.add(neighbor)\n\n      return []\n\n  path_to_target = a_star(tuple(pos), tuple(nearest_target_pos))\n\n  # Convert path to actions\n  for step in path_to_target:\n      dx, dy = np.array(step) - pos\n      if abs(dx) > abs(dy):\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 0, "scores": {"3": 4.7}}
{"timestamp": "2025-09-10T01:02:18.651605", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position using A* pathfinding for more efficient movement\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal):\n      open_set = set()\n      closed_set = set()\n      g_score = {start: 0}\n      f_score = {start: heuristic(start, goal)}\n      came_from = {}\n\n      open_set.add(start)\n\n      while open_set:\n          current = min(open_set, key=lambda x: f_score[x])\n\n          if current == goal:\n              path = []\n              while current in came_from:\n                  path.append(current)\n                  current = came_from[current]\n              path.reverse()\n              return path\n\n          open_set.remove(current)\n          closed_set.add(current)\n\n          neighbors = [(current[0] + dx, current[1] + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n          for neighbor in neighbors:\n              tentative_g_score = g_score[current] + heuristic(current, neighbor)\n\n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                  open_set.add(neighbor)\n\n      return []\n\n  path_to_target = a_star(tuple(pos), tuple(nearest_target_pos))\n\n  # Convert path to actions\n  for step in path_to_target:\n      dx, dy = np.array(step) - pos\n      if abs(dx) > abs(dy):\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 0, "scores": {"3": 4.7}}
{"timestamp": "2025-09-10T01:04:07.162431", "function_name": "craft", "function_body": "  def navigate_to(target_pos):\n      pos = np.array(env._current_state.pos)\n      actions = []\n      \n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          elif abs(dx) < abs(dy):  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n          else:  # Both directions are equally close, choose one randomly\n              direction = np.random.choice([2, 3]) if dx > 0 else np.random.choice([0, 1])\n              actions.append(direction)\n              if direction in [0, 1]:\n                  pos[1] += 1 if direction == 1 else -1\n              else:\n                  pos[0] += 1 if direction == 3 else -1\n      \n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  \n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(workshop_pos_list) > 0:  \n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          \n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Find the nearest workshop position from the mean position\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  \n  nearest_target_pos = min(target_positions, key=lambda p: np.linalg.norm(pos - p, ord=2))\n\n  # Ensure the nearest position is within the grid bounds\n  grid_height, grid_width, _ = env._current_state.grid.shape\n  nearest_target_pos[0] = max(0, min(nearest_target_pos[0], grid_height - 1))\n  nearest_target_pos[1] = max(0, min(nearest_target_pos[1], grid_width - 1))\n\n  # Move to the closest workshop position\n  actions.extend(navigate_to(nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": 4.7}}
{"timestamp": "2025-09-10T01:04:08.253745", "function_name": "craft", "function_body": "  def navigate_to(target_pos):\n      pos = np.array(env._current_state.pos)\n      actions = []\n      \n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          elif abs(dx) < abs(dy):  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n          else:  # Both directions are equally close, choose one randomly\n              direction = np.random.choice([2, 3]) if dx > 0 else np.random.choice([0, 1])\n              actions.append(direction)\n              if direction in [0, 1]:\n                  pos[1] += 1 if direction == 1 else -1\n              else:\n                  pos[0] += 1 if direction == 3 else -1\n      \n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(workshop_pos_list) > 0:  \n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          \n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Find the nearest workshop position from the mean position\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  \n  nearest_target_pos = min(target_positions, key=lambda p: np.linalg.norm(pos - p, ord=2))\n\n  # Ensure the nearest position is within the grid bounds\n  grid_height, grid_width, _ = env._current_state.grid.shape\n  nearest_target_pos[0] = max(0, min(nearest_target_pos[0], grid_height - 1))\n  nearest_target_pos[1] = max(0, min(nearest_target_pos[1], grid_width - 1))\n\n  # Navigate to the closest workshop position\n  actions.extend(navigate_to(nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": 4.7}}
{"timestamp": "2025-09-10T01:06:23.910845", "function_name": "craft", "function_body": "  def get_direction_to_move(dx, dy):\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          return 3 if dx > 0 else 2\n      else:  # Then move in y-direction\n          return 1 if dy > 0 else 0\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda x: np.linalg.norm(pos - x))\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      direction = get_direction_to_move(dx, dy)\n      actions.append(direction)\n\n      # Update position\n      if direction == 0:\n          pos[1] -= 1\n      elif direction == 1:\n          pos[1] += 1\n      elif direction == 2:\n          pos[0] -= 1\n      else:  # direction == 3\n          pos[0] += 1\n\n  # Orient the agent towards the workshop (optional, might not be necessary)\n  direction_to_workshop = np.arctan2(nearest_target_pos[1] - pos[1], nearest_target_pos[0] - pos[0]) * 180 / np.pi\n  current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n  \n  if direction_to_workshop < 0:\n      direction_to_workshop += 360\n\n  # Calculate the difference in direction\n  delta_direction = (direction_to_workshop - current_direction + 360) % 360\n  \n  if delta_direction > 180:\n      actions.append(2 if env._current_state.dir == 3 else 3)\n      env._current_state.dir = (env._current_state.dir + 1) % 4\n  elif delta_direction < 180 and delta_direction != 0:\n      actions.append(2 if env._current_state.dir == 0 else 3)\n      env._current_state.dir = (env._current_state.dir - 1) % 4\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 1, "scores": {"3": 5.0}}
