rient the agent towards the workshop (optional, might not be necessary)\n  direction_to_workshop = np.arctan2(nearest_target_pos[1] - pos[1], nearest_target_pos[0] - pos[0]) * 180 / np.pi\n  current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n  \n  if direction_to_workshop < 0:\n      direction_to_workshop += 360\n\n  # Calculate the difference in direction\n  delta_direction = (direction_to_workshop - current_direction + 360) % 360\n  \n  if delta_direction > 180:\n      actions.append(2 if env._current_state.dir == 3 else 3)\n      env._current_state.dir = (env._current_state.dir + 1) % 4\n  elif delta_direction < 180 and delta_direction != 0:\n      actions.append(2 if env._current_state.dir == 0 else 3)\n      env._current_state.dir = (env._current_state.dir - 1) % 4\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 5, "scores": {"3": 5.0}}
{"timestamp": "2025-09-11T07:56:14.950425", "function_name": "craft", "function_body": "  def get_closest_workshop_position(pos, target_workshops):\n      min_distance = float('inf')\n      nearest_target_pos = None\n\n      for workshop_idx in target_workshops:\n          workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          if len(workshop_positions) > 0:  # Check if there are any locations for this workshop type\n              workshop_mean_position = workshop_positions.mean(axis=0)\n              distance = np.linalg.norm(pos - workshop_mean_position, ord=2)\n              if distance < min_distance:\n                  nearest_target_pos = workshop_mean_position.astype(int)\n                  min_distance = distance\n\n      return nearest_target_pos\n\n  def calculate_actions_to_target(target_pos):\n      actions = []\n      pos = np.array(env._current_state.pos)\n\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      return actions\n\n  def orient_towards_target(target_pos):\n      actions = []\n      direction_to_target = np.arctan2(target_pos[1] - env._current_state.pos[1], target_pos[0] - env._current_state.pos[0]) * 180 / np.pi\n      current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n      \n      if direction_to_target < 0:\n          direction_to_target += 360\n\n      delta_direction = (direction_to_target - current_direction + 360) % 360\n      \n      while delta_direction > 180:\n          actions.append(2 if env._current_state.dir == 3 else 3)\n          env._current_state.dir = (env._current_state.dir + 1) % 4\n          direction_to_target = np.arctan2(target_pos[1] - env._current_state.pos[1], target_pos[0] - env._current_state.pos[0]) * 180 / np.pi\n          current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n          delta_direction = (direction_to_target - current_direction + 360) % 360\n      \n      while delta_direction < 180 and delta_direction != 0:\n          actions.append(2 if env._current_state.dir == 0 else 3)\n          env._current_state.dir = (env._current_state.dir - 1) % 4\n          direction_to_target = np.arctan2(target_pos[1] - env._current_state.pos[1], target_pos[0] - env._current_state.pos[0]) * 180 / np.pi\n          current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n          delta_direction = (direction_to_target - current_direction + 360) % 360\n      \n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Determine which workshops can craft the desired item\n  target_workshops = [i for i, recipe in enumerate(cookbook.recipes) if goal_index in recipe.values()]\n\n  if not target_workshops:\n      raise ValueError(f\"No available workshop found that can craft {item}\")\n\n  # Get the closest workshop position\n  pos = np.array(env._current_state.pos)\n  nearest_target_pos = get_closest_workshop_position(pos, target_workshops)\n\n  if nearest_target_pos is None:\n      raise ValueError(\"No available workshop positions found\")\n\n  # Calculate actions to move towards the workshop\n  actions_to_workshop = calculate_actions_to_target(nearest_target_pos)\n  actions.extend(actions_to_workshop)\n\n  # Orient towards the workshop\n  orientation_actions = orient_towards_target(nearest_target_pos)\n  actions.extend(orientation_actions)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
