{"timestamp": "2025-09-09T20:56:19.630991", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Ensure the agent is facing the correct direction before using the workshop\n  current_dir = env._current_state.dir\n  target_dir = np.arctan2(nearest_target_pos[1] - pos[1], nearest_target_pos[0] - pos[0]) * (180 / np.pi) % 360 // 90\n\n  if current_dir != target_dir:\n      # Calculate the difference in direction\n      dir_diff = (target_dir - current_dir) % 4\n      if dir_diff == 1:\n          actions.append(2)  # LEFT\n      elif dir_diff == 2:\n          actions.extend([2, 2])  # LEFT twice (or RIGHT twice)\n      elif dir_diff == 3:\n          actions.append(3)  # RIGHT\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 9, "scores": {"3": 3.7}}
{"timestamp": "2025-09-09T20:56:20.786428", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      direction_to_move = None\n\n      # Determine direction to move in based on the shortest path heuristic\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          direction_to_move = 3 if dx > 0 else 2\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          direction_to_move = 1 if dy > 0 else 0\n          pos[1] += 1 if dy > 0 else -1\n\n      actions.append(direction_to_move)\n\n  # Check if we need to turn towards the correct direction before using\n  current_dir = env._current_state.dir\n  target_pos = nearest_target_pos\n  target_dir = np.arctan2(target_pos[1] - pos[1], target_pos[0] - pos[0]) * (180 / np.pi) % 360 // 90\n\n  # Calculate the difference in direction\n  dir_diff = (target_dir - current_dir) % 4\n  if dir_diff == 1:\n      actions.append(2)  # LEFT\n  elif dir_diff == 2:\n      actions.extend([2, 2])  # LEFT twice (or RIGHT twice)\n  elif dir_diff == 3:\n      actions.append(3)  # RIGHT\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 9, "scores": {"3": 3.7}}
{"timestamp": "2025-09-09T20:57:43.563460", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Determine the nearest workshop type that can craft the desired item\n  min_distance, closest_workshop_idx = float('inf'), None\n  current_pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Get all positions of workshops of this type\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_positions) == 0:  # Skip if there are no locations for the workshop\n          continue\n\n      # Calculate distances to each workshop position from current position and find the nearest one\n      distances = np.linalg.norm(workshop_positions - current_pos, axis=1)\n      min_workshop_distance = np.min(distances)\n\n      if min_workshop_distance < min_distance:\n          min_distance = min_workshop_distance\n          closest_workshop_idx = workshop_idx\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Find the nearest position among all workshops of the chosen type\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda x: np.linalg.norm(x - current_pos))\n\n  # Move towards the nearest workshop position\n  while not np.array_equal(current_pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - current_pos\n\n      # Determine direction to move in (prioritize moving in x-direction first)\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          current_pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          current_pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE action\n\n  return actions", "island_id": 6, "scores": {"3": 4.7}}
