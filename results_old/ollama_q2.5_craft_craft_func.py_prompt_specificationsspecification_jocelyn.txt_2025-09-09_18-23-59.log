     actions.append(direction)\n\n  # Orient the agent towards the workshop (optional, might not be necessary)\n  direction_to_workshop = np.arctan2(nearest_target_pos[1] - pos[1], nearest_target_pos[0] - nearest_target_pos[0]) * 180 / np.pi\n  current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n  \n  if direction_to_workshop < 0:\n      direction_to_workshop += 360\n\n  # Calculate the difference in direction\n  delta_direction = (direction_to_workshop - current_direction + 360) % 360\n  \n  while delta_direction > 180:\n      actions.append(2 if env._current_state.dir == 3 else 3)\n      env._current_state.dir = (env._current_state.dir + 1) % 4\n      direction_to_workshop = np.arctan2(nearest_target_pos[1] - pos[1], nearest_target_pos[0] - nearest_target_pos[0]) * 180 / np.pi\n      current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n      if direction_to_workshop < 0:\n          direction_to_workshop += 360\n      delta_direction = (direction_to_workshop - current_direction + 360) % 360\n  \n  while delta_direction < 180 and delta_direction != 0:\n      actions.append(2 if env._current_state.dir == 0 else 3)\n      env._current_state.dir = (env._current_state.dir - 1) % 4\n      direction_to_workshop = np.arctan2(nearest_target_pos[1] - pos[1], nearest_target_pos[0] - nearest_target_pos[0]) * 180 / np.pi\n      current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n      if direction_to_workshop < 0:\n          direction_to_workshop += 360\n      delta_direction = (direction_to_workshop - current_direction + 360) % 360\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 4, "scores": {"3": 5.0}}
{"timestamp": "2025-09-10T00:28:21.104158", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  closest_workshop_idx, nearest_target_pos = find_closest_workshop(pos, workshop_indices, env._current_state.grid)\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      \n      direction = determine_move_direction(dx, dy)\n      \n      actions.append(direction)\n      update_position(pos, direction)\n\n  # Orient the agent towards the workshop (optional, might not be necessary)\n  orient_agent(env._current_state, nearest_target_pos)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-10T00:30:08.083066", "function_name": "craft", "function_body": "  def navigate_to(target_pos):\n      pos = np.array(env._current_state.pos)\n      actions = []\n      \n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n      \n      return actions\n\n  def find_closest_workshop(goal_index):\n      cookbook = env.world.cookbook\n      workshop_indices = env.world.workshop_indices\n      grid = env._current_state.grid\n      pos = np.array(env._current_state.pos)\n\n      closest_workshop_idx, min_distance = None, float('inf')\n\n      for workshop_idx in workshop_indices:\n          # Calculate the mean position of all workshops of this type\n          workshop_pos_list = np.argwhere(grid[:, :, workshop_idx])\n\n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              workshop_pos_mean = workshop_pos_list.mean(axis=0)\n              distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n\n              # Check if this workshop can craft the desired item\n              if goal_index in cookbook.recipes[workshop_idx]:\n                  if distance < min_distance:\n                      closest_workshop_idx, min_distance = workshop_idx, distance\n\n      return closest_workshop_idx\n\n  def find_nearest_target_pos(workshop_idx):\n      grid = env._current_state.grid\n      pos = np.array(env._current_state.pos)\n      target_positions = np.argwhere(grid[:, :, workshop_idx])\n      \n      # Calculate the nearest position to move towards\n      nearest_target_pos = min(target_positions, key=lambda p: np.linalg.norm(pos - p))\n\n      return nearest_target_pos\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_idx = find_closest_workshop(goal_index)\n  \n  if workshop_idx is None:\n      raise ValueError(\"No available workshop found to craft the desired item\")\n\n  nearest_target_pos = find_nearest_target_pos(workshop_idx)\n\n  # Ensure the nearest position is within the grid bounds\n  grid_height, grid_width, _ = env._current_state.grid.shape\n  nearest_target_pos[0] = max(0, min(nearest_target_pos[0], grid_height - 1))\n  nearest_target_pos[1] = max(0, min(nearest_target_pos[1], grid_width - 1))\n\n  # Navigate to the closest workshop position\n  actions = navigate_to(nearest_target_pos)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-10T00:30:09.220788", "function_name": "craft", "function_body": "  def navigate_to(target_pos):\n      pos = np.array(env._current_state.pos)\n      dir = env._current_state.dir\n      actions = []\n      \n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n\n          # Adjust direction based on the current orientation of the agent\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              new_dir = 3 if dx > 0 else 2\n          else:  # Then move in y-direction\n              new_dir = 1 if dy > 0 else 0\n\n          while dir != new_dir:\n              # Rotate towards the new direction\n              actions.append(2 if (new_dir - dir) % 4 == 3 else 3)\n              dir = (dir + 1) % 4\n\n          # Move forward in the correct direction\n          actions.append(0)\n          pos[0] += 1 if dx > 0 else (-1 if dx < 0 else 0)\n          pos[1] += 1 if dy > 0 else (-1 if dy < 0 else 0)\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda p: np.linalg.norm(pos - p))\n\n  # Ensure the nearest position is within the grid bounds\n  grid_height, grid_width, _ = env._current_state.grid.shape\n  nearest_target_pos[0] = max(0, min(nearest_target_pos[0], grid_height - 1))\n  nearest_target_pos[1] = max(0, min(nearest_target_pos[1], grid_width - 1))\n\n  # Navigate to the closest workshop position\n  actions.extend(navigate_to(nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": 1.4000001}}
