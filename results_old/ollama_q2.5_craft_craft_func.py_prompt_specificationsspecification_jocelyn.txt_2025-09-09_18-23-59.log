n)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 5, "scores": {"3": 4.7}}
{"timestamp": "2025-09-09T18:58:06.888196", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  nearest_workshop_pos = None\n\n  for workshop_idx in workshop_indices:\n      # Calculate positions of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          distances = np.linalg.norm(workshop_pos_list - pos, axis=1)\n          nearest_workshop_index = np.argmin(distances)\n          target_workshop_pos = workshop_pos_list[nearest_workshop_index]\n\n          # Update nearest workshop position if this one is closer\n          if nearest_workshop_pos is None or distances[nearest_workshop_index] < np.linalg.norm(nearest_workshop_pos - pos, ord=2):\n              nearest_workshop_pos = target_workshop_pos\n\n  if nearest_workshop_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_workshop_pos):\n      dx, dy = nearest_workshop_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      elif dy != 0:  # Then move in y-direction, but only if there is a need to do so\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 1, "scores": {"3": 4.7}}
