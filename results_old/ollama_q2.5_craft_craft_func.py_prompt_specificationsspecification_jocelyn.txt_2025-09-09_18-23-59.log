{"timestamp": "2025-09-10T08:05:13.378495", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find the closest workshop that can craft the desired item\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  \n  pos = np.array(env._current_state.pos)\n\n  # Iterate through all workshops to find the one with the shortest distance\n  min_distance = float('inf')\n  closest_workshop_pos = None\n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_positions) == 0:  # No positions found, skip to next workshop\n          continue\n\n      # Calculate the distance from current position to each workshop and find the nearest one\n      distances = [np.linalg.norm(pos - wp, ord=2) for wp in workshop_positions]\n      closest_wp_idx = np.argmin(distances)\n      closest_distance = distances[closest_wp_idx]\n\n      if closest_distance < min_distance:\n          min_distance = closest_distance\n          closest_workshop_pos = workshop_positions[closest_wp_idx]\n\n  if closest_workshop_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move towards the nearest workshop\n  while not np.array_equal(pos, closest_workshop_pos):\n      dx, dy = closest_workshop_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Orient the agent towards the workshop (optional, might not be necessary)\n  direction_to_workshop = np.arctan2(closest_workshop_pos[1] - pos[1], closest_workshop_pos[0] - pos[0]) * 180 / np.pi\n  current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n  \n  if direction_to_workshop < 0:\n      direction_to_workshop += 360\n\n  # Calculate the difference in direction\n  delta_direction = (direction_to_workshop - current_direction + 360) % 360\n  \n  if delta_direction > 180:\n      actions.append(2 if env._current_state.dir == 3 else 3)\n      env._current_state.dir = (env._current_state.dir + 1) % 4\n  elif delta_direction < 180 and delta_direction != 0:\n      actions.append(2 if env._current_state.dir == 0 else 3)\n      env._current_state.dir = (env._current_state.dir - 1) % 4\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 6, "scores": {"3": 5.0}}
{"timestamp": "2025-09-10T08:05:14.450998", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[np.argmin(np.linalg.norm(target_positions - pos, axis=1))]\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Orient the agent towards the workshop (optional, might not be necessary)\n  direction_to_workshop = np.arctan2(nearest_target_pos[1] - pos[1], nearest_target_pos[0] - pos[0]) * 180 / np.pi\n  current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n  \n  if direction_to_workshop < 0:\n      direction_to_workshop += 360\n\n  # Calculate the difference in direction\n  delta_direction = (direction_to_workshop - current_direction + 360) % 360\n  \n  if delta_direction > 180:\n      actions.append(2 if env._current_state.dir == 3 else 3)\n      env._current_state.dir = (env._current_state.dir + 1) % 4\n  elif delta_direction < 180 and delta_direction != 0:\n      actions.append(2 if env._current_state.dir == 0 else 3)\n      env._current_state.dir = (env._current_state.dir - 1) % 4\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 6, "scores": {"3": 5.0}}
{"timestamp": "2025-09-10T08:07:45.316640", "function_name": "craft", "function_body": "  def find_closest_workshop(item_index):\n      closest_workshop_idx, min_distance = None, float('inf')\n      \n      for workshop_idx in env.world.workshop_indices:\n          # Calculate the mean position of all workshops of this type\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              workshop_pos_mean = workshop_pos_list.mean(axis=0)\n              distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n              \n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n      \n      return closest_workshop_idx\n\n  def calculate_movement_actions(nearest_target_pos):\n      actions = []\n      \n      while not np.array_equal(pos, nearest_target_pos):\n          dx, dy = nearest_target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n      \n      return actions\n\n  def calculate_orientation_actions(nearest_target_pos):\n      direction_to_workshop = np.arctan2(nearest_target_pos[1] - pos[1], nearest_target_pos[0] - pos[0]) * 180 / np.pi\n      current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n      \n      if direction_to_workshop < 0:\n          direction_to_workshop += 360\n\n      # Calculate the difference in direction\n      delta_direction = (direction_to_workshop - current_direction + 360) % 360\n      \n      actions = []\n      \n      while delta_direction > 90:\n          actions.append(2 if env._current_state.dir == 3 else 3)\n          env._current_state.dir = (env._current_state.dir + 1) % 4\n          delta_direction -= 90\n      while delta_direction < -90:\n          actions.append(2 if env._current_state.dir == 0 else 3)\n          env._current_state.dir = (env._current_state.dir - 1) % 4\n          delta_direction += 90\n      \n      return actions\n\n  def calculate_orientation_action(nearest_target_pos):\n      direction_to_workshop = np.arctan2(nearest_target_pos[1] - pos[1], nearest_target_pos[0] - pos[0]) * 180 / np.pi\n      current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n      \n      if direction_to_workshop < 0:\n          direction_to_workshop += 360\n\n      # Calculate the difference in direction\n      delta_direction = (direction_to_workshop - current_direction + 360) % 360\n      \n      actions = []\n      \n      if delta_direction > 180:\n          actions.append(2 if env._current_state.dir == 3 else 3)\n          env._current_state.dir = (env._current_state.dir + 1) % 4\n      elif delta_direction < 180 and delta_direction != 0:\n          actions.append(2 if env._current_state.dir == 0 else 3)\n          env._current_state.dir = (env._current_state.dir - 1) % 4\n      \n      return actions\n\n  # Main logic for crafting\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  pos = np.array(env._current_state.pos)\n\n  closest_workshop_idx = find_closest_workshop(goal_index)\n  \n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n  \n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda x: np.linalg.norm(x - pos))\n  \n  actions = calculate_movement_actions(nearest_target_pos) + calculate_orientation_action(nearest_target_pos) + [4]  # USE\n\n  return actions", "island_id": 8, "scores": {"3": 5.0}}
{"timestamp": "2025-09-10T08:07:46.394409", "function_name": "craft", "function_body": "  def find_closest_workshop(pos):\n      closest_workshop_idx, min_distance = None, float('inf')\n      \n      for workshop_idx in env.world.workshop_indices:\n          # Calculate the mean position of all workshops of this type\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              workshop_pos_mean = workshop_pos_list.mean(axis=0)\n              distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n              \n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n      \n      return closest_workshop_idx, min_distance\n\n  def find_nearest_target_position(workshop_idx):\n      target_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      nearest_target_pos = None\n      min_nearest_distance = float('inf')\n      \n      for target_pos in target_positions:\n          distance = np.linalg.norm(pos - target_pos, ord=2)\n          \n          if distance < min_nearest_distance:\n              nearest_target_pos = target_pos\n              min_nearest_distance = distance\n      \n      return nearest_target_pos\n\n  def calculate_movement_actions(nearest_target_pos):\n      actions = []\n      \n      while not np.array_equal(pos, nearest_target_pos):\n          dx, dy = nearest_target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n      \n      return actions\n\n  def calculate_orientation_actions(nearest_target_pos):\n      direction_to_workshop = np.arctan2(nearest_target_pos[1] - pos[1], nearest_target_pos[0] - pos[0]) * 180 / np.pi\n      current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n      \n      if direction_to_workshop < 0:\n          direction_to_workshop += 360\n\n      # Calculate the difference in direction\n      delta_direction = (direction_to_workshop - current_direction + 360) % 360\n      \n      actions = []\n      \n      if delta_direction > 180:\n          actions.append(2 if env._current_state.dir == 3 else 3)\n          env._current_state.dir = (env._current_state.dir + 1) % 4\n      elif delta_direction < 180 and delta_direction != 0:\n          actions.append(2 if env._current_state.dir == 0 else 3)\n          env._current_state.dir = (env._current_state.dir - 1) % 4\n      \n      return actions\n\n  # Main logic for crafting\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  pos = np.array(env._current_state.pos)\n\n  closest_workshop_idx, _ = find_closest_workshop(pos)\n  \n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n  \n  nearest_target_pos = find_nearest_target_position(closest_workshop_idx)\n  \n  actions = calculate_movement_actions(nearest_target_pos) + calculate_orientation_actions(nearest_target_pos) + [4]  # USE\n\n  return actions", "island_id": 8, "scores": {"3": 5.0}}
