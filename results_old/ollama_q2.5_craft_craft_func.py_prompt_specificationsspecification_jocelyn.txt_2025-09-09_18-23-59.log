"scores": {"3": 4.7}}
{"timestamp": "2025-09-10T00:38:43.280030", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Determine the closest specific position among the workshops to move towards\n  min_distance = float('inf')\n  nearest_target_pos = None\n\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Find all positions of this type of workshop in the grid\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_positions) > 0:  # Ensure there's at least one of this workshop type\n          for target_pos in workshop_positions:\n              distance = np.linalg.norm(pos - target_pos, ord=2)\n\n              if distance < min_distance:\n                  nearest_target_pos = target_pos\n                  min_distance = distance\n\n  if nearest_target_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in, prioritizing x-direction first\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": 4.7}}
{"timestamp": "2025-09-10T00:40:24.967326", "function_name": "craft", "function_body": "  def find_nearest_workshop(pos, grid, workshop_indices):\n      closest_workshop_idx = None\n      min_distance = float('inf')\n      \n      for workshop_idx in workshop_indices:\n          positions = np.argwhere(grid[:, :, workshop_idx])\n          if len(positions) == 0:\n              continue\n\n          distances = [np.linalg.norm(pos - p, ord=2) for p in positions]\n          nearest_pos = positions[np.argmin(distances)]\n          distance = distances[np.argmin(distances)]\n\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n      \n      return closest_workshop_idx, nearest_pos\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  pos = np.array(env._current_state.pos)\n  grid = env._current_state.grid\n  actions = []\n\n  # Find the nearest workshop that can craft the desired item\n  closest_workshop_idx, nearest_target_pos = find_nearest_workshop(pos, grid, workshop_indices)\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the nearest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  \n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      elif abs(dx) < abs(dy):\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n      else:  \n          direction = np.random.choice([2, 3]) if dx > 0 else np.random.choice([0, 1])\n          actions.append(direction)\n          if direction in [0, 1]:\n              pos[1] += 1 if direction == 1 else -1\n          else:\n              pos[0] += 1 if direction == 3 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  \n\n  return actions", "island_id": 7, "scores": {"3": 4.7}}
{"timestamp": "2025-09-10T00:40:25.941516", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = [i for i in env.world.workshop_indices if i in cookbook.recipes[goal_index]]\n\n  if not workshop_indices:\n      raise ValueError(\"No suitable workshops found to craft the item.\")\n\n  actions = []\n\n  # Determine the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_positions) > 0:  \n          workshop_mean_pos = workshop_positions.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_mean_pos, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshops found\")\n\n  # Determine the nearest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda p: np.linalg.norm(pos - p))\n\n  # Move to the nearest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      elif abs(dx) < abs(dy):  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n      else:  \n          direction = np.random.choice([2, 3]) if dx > 0 else np.random.choice([0, 1])\n          actions.append(direction)\n          if direction in [0, 1]:\n              pos[1] += 1 if direction == 1 else -1\n          else:\n              pos[0] += 1 if direction == 3 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  \n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-10T00:42:00.800152", "function_name": "craft", "function_body": "  def move_towards(current_pos, target_pos):\n      actions = []\n      while not np.array_equal(current_pos, target_pos):\n          dx, dy = target_pos - current_pos\n          \n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              action = 3 if dx > 0 else 2\n              current_pos[0] += 1 if dx > 0 else -1\n          elif dy != 0:\n              action = 1 if dy > 0 else 0\n              current_pos[1] += 1 if dy > 0 else -1\n          else:\n              break\n          \n          actions.append(action)\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  target_workshops = {}\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          distances = np.linalg.norm(workshop_pos_list - pos, axis=1)\n          min_distance = distances.min()\n          nearest_target_pos = workshop_pos_list[distances.argmin()]\n          target_workshops[workshop_idx] = (min_distance, nearest_target_pos)\n\n  if not target_workshops:\n      raise ValueError(\"No available workshop found\")\n\n  # Find the closest workshop\n  closest_workshop_idx, (min_distance, nearest_target_pos) = min(target_workshops.items(), key=lambda x: x[1][0])\n\n  # Move to the closest workshop position\n  actions.extend(move_towards(pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 3, "scores": {"3": 4.7}}
{"timestamp": "2025-09-10T00:42:01.762356", "function_name": "craft", "function_body": "  def move_towards(current_pos, target_pos):\n      actions = []\n      while not np.array_equal(current_pos, target_pos):\n          dx, dy = target_pos - current_pos\n          \n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              current_pos[0] += 1 if dx > 0 else -1\n          elif dy != 0:\n              actions.append(1 if dy > 0 else 0)\n              current_pos[1] += 1 if dy > 0 else -1\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Determine which workshops can be used to craft the desired item\n  workshop_indices = [k for k, v in cookbook.recipes.items() if goal_index in v.values()]\n\n  if not workshop_indices:\n      raise ValueError(f\"No recipe found to craft {item}\")\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest available workshop among those that can craft the desired item\n  target_workshops = {}\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          distances = np.linalg.norm(workshop_pos_list - pos, axis=1)\n          min_distance = distances.min()\n          nearest_target_pos = workshop_pos_list[distances.argmin()]\n          target_workshops[workshop_idx] = (min_distance, nearest_target_pos)\n\n  if not target_workshops:\n      raise ValueError(\"No available workshop found\")\n\n  # Find the closest workshop\n  closest_workshop_idx, (min_distance, nearest_target_pos) = min(target_workshops.items(), key=lambda x: x[1][0])\n\n  # Move to the closest workshop position\n  actions.extend(move_towards(pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-10T00:44:33.392607", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  \n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(workshop_pos_list) == 0:  # Skip this workshop type if no positions found\n          continue\n      \n      workshop_pos_mean = workshop_pos_list.mean(axis=0)\n      distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n      \n      if distance < min_distance:\n          closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[np.argmin([np.linalg.norm(pos - tp, ord=2) for tp in target_positions])]\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      direction = None\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          direction = 3 if dx > 0 else 2\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          direction = 1 if dy > 0 else 0\n          pos[1] += 1 if dy > 0 else -1\n      \n      actions.append(direction)\n\n  # Orient the agent towards the workshop (optional, might not be necessary)\n  direction_to_workshop = np.arctan2(nearest_target_pos[1] - pos[1], nearest_target_pos[0] - pos[0]) * 180 / np.pi\n  current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n  \n  if direction_to_workshop < 0:\n      direction_to_workshop += 360\n\n  # Calculate the difference in direction\n  delta_direction = (direction_to_workshop - current_direction + 360) % 360\n  \n  if delta_direction > 180:\n      actions.append(2 if env._current_state.dir == 3 else 3)\n      env._current_state.dir = (env._current_state.dir + 1) % 4\n  elif delta_direction < 180 and delta_direction != 0:\n      actions.append(2 if env._current_state.dir == 0 else 3)\n      env._current_state.dir = (env._current_state.dir - 1) % 4\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 5, "scores": {"3": 5.0}}
