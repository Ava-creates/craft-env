{"timestamp": "2025-09-09T19:54:02.508637", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  min_distance, closest_workshop_idx, target_pos = float('inf'), None, None\n  current_pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Get all positions of workshops of this type\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_positions) == 0:  # Skip if there are no locations for the workshop\n          continue\n\n      # Find nearest position among these workshop positions\n      distances = np.linalg.norm(workshop_positions - current_pos, axis=1)\n      nearest_index = np.argmin(distances)\n      nearest_workshop_pos = workshop_positions[nearest_index]\n      \n      distance_to_nearest = distances[nearest_index]\n\n      if distance_to_nearest < min_distance:\n          min_distance = distance_to_nearest\n          closest_workshop_idx = workshop_idx\n          target_pos = nearest_workshop_pos\n\n  if closest_workshop_idx is None or target_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the path to the closest position of the nearest workshop using A* search\n  actions.extend(a_star_search(env, current_pos, target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE action\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
