heck if the agent is already facing the workshop before using it\n  target_direction = np.arctan2(nearest_target_pos[1] - pos[1], nearest_target_pos[0] - pos[0])\n  current_direction = env._current_state.dir * (np.pi / 2)  # Convert to radians for comparison\n\n  # Calculate the difference in directions and adjust if necessary\n  angle_diff = target_direction - current_direction\n\n  # Normalize angle difference to [-pi, pi]\n  angle_diff = (angle_diff + np.pi) % (2 * np.pi) - np.pi\n\n  # Adjust direction based on the smallest rotation needed\n  if angle_diff < -np.pi / 4:\n      actions.append(2)  # LEFT\n  elif angle_diff > np.pi / 4:\n      actions.append(3)  # RIGHT\n  else:\n      actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": 1.7}}
