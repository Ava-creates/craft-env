eturn actions", "island_id": 3, "scores": {"3": 4.7}}
{"timestamp": "2025-09-09T21:43:41.032934", "function_name": "craft", "function_body": "  def get_direction(dx: int, dy: int):\n      if dx > 0:\n          return 3\n      elif dx < 0:\n          return 2\n      elif dy > 0:\n          return 1\n      else:\n          return 0\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Determine the nearest workshop type that can craft the desired item\n  min_distance, closest_workshop_idx = float('inf'), None\n  current_pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Get all positions of workshops of this type\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_positions) == 0:  # Skip if there are no locations for the workshop\n          continue\n\n      # Calculate distances to each workshop position from current position and find the nearest one\n      distances = np.linalg.norm(workshop_positions - current_pos, axis=1)\n      min_workshop_distance = np.min(distances)\n\n      if min_workshop_distance < min_distance:\n          min_distance = min_workshop_distance\n          closest_workshop_idx = workshop_idx\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Find the nearest position among all workshops of the chosen type\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda x: np.linalg.norm(x - current_pos))\n\n  # Move towards the nearest workshop position\n  while not np.array_equal(current_pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - current_pos\n\n      # Determine direction to move in (prioritize moving in x-direction first)\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(get_direction(dx, 0))\n          current_pos[0] += np.sign(dx)\n      else:  # Then move in y-direction\n          actions.append(get_direction(0, dy))\n          current_pos[1] += np.sign(dy)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE action\n\n  return actions", "island_id": 6, "scores": {"3": 4.7}}
{"timestamp": "2025-09-09T21:43:42.013698", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Determine the nearest workshop type that can craft the desired item\n  min_distance, closest_workshop_idx = float('inf'), None\n  current_pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Get all positions of workshops of this type\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_positions) == 0:  # Skip if there are no locations for the workshop\n          continue\n\n      # Calculate distances to each workshop position from current position and find the nearest one\n      distances = np.linalg.norm(workshop_positions - current_pos, axis=1)\n      min_workshop_distance = np.min(distances)\n\n      if min_workshop_distance < min_distance:\n          min_distance = min_workshop_distance\n          closest_workshop_idx = workshop_idx\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Find the nearest position among all workshops of the chosen type\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda x: np.linalg.norm(x - current_pos))\n\n  # Plan a path to the nearest workshop position using A* search algorithm for better efficiency in movement.\n  def heuristic(a, b):\n      return np.linalg.norm(np.array(a) - np.array(b), ord=2)\n\n  def astar(start, goal, grid):\n      open_set = []\n      heapq.heappush(open_set, (0, start))\n      came_from = {}\n      g_score = {tuple(start): 0}\n      f_score = {tuple(start): heuristic(start, goal)}\n\n      while open_set:\n          _, current = heapq.heappop(open_set)\n\n          if tuple(current) == tuple(goal):\n              path = []\n              while tuple(current) in came_from:\n                  path.append(tuple(current))\n                  current = came_from[tuple(current)]\n              path.reverse()\n              return path\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              tentative_g_score = g_score[tuple(current)] + heuristic(current, neighbor)\n\n              if not (0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]):\n                  continue\n\n              if grid[neighbor] != 0:\n                  continue\n\n              if tuple(neighbor) not in g_score or tentative_g_score < g_score[tuple(neighbor)]:\n                  came_from[tuple(neighbor)] = current\n                  g_score[tuple(neighbor)] = tentative_g_score\n                  f_score[tuple(neighbor)] = tentative_g_score + heuristic(neighbor, goal)\n                  heapq.heappush(open_set, (f_score[tuple(neighbor)], neighbor))\n\n      return None\n\n  # Plan the path using A* search algorithm\n  path = astar(tuple(current_pos), tuple(nearest_target_pos), env._current_state.grid[:, :, 0])\n  \n  if not path:\n      raise ValueError(\"No valid path to workshop found\")\n\n  # Convert the path into a series of actions\n  for (x1, y1), (x2, y2) in zip(path[:-1], path[1:]):\n      dx, dy = x2 - x1, y2 - y1\n\n      if dx == 1:\n          actions.append(3)  # RIGHT\n      elif dx == -1:\n          actions.append(2)  # LEFT\n      elif dy == 1:\n          actions.append(1)  # UP\n      elif dy == -1:\n          actions.append(0)  # DOWN\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE action\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
