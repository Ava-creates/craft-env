to reach the closest workshop position\n  actions.extend(calculate_actions_to_reach(pos, nearest_target_pos))\n  \n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 2, "scores": {"3": 4.7}}
