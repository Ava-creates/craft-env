{"timestamp": "2025-09-11T06:12:18.039176", "function_name": "craft", "function_body": "  def get_closest_workshop_position(pos, workshop_indices):\n      min_distance = float('inf')\n      nearest_target_pos = None\n      \n      for workshop_idx in workshop_indices:\n          # Calculate the mean position of all workshops of this type\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              workshop_pos_mean = workshop_pos_list.mean(axis=0)\n              distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n              if distance < min_distance:\n                  nearest_target_pos = workshop_pos_mean\n                  min_distance = distance\n      \n      return nearest_target_pos\n\n  def get_directional_action(dx, dy):\n      \"\"\"Determine the action to move in based on dx and dy.\"\"\"\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          return 3 if dx > 0 else 2\n      else:  # Then move in y-direction\n          return 1 if dy > 0 else 0\n\n  def rotate_to_face_target(current_pos, target_pos):\n      \"\"\"Calculate the actions needed to orient the agent towards the target position.\"\"\"\n      direction_to_workshop = np.arctan2(target_pos[1] - current_pos[1], target_pos[0] - current_pos[0]) * 180 / np.pi\n      current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n      \n      if direction_to_workshop < 0:\n          direction_to_workshop += 360\n\n      delta_direction = (direction_to_workshop - current_direction + 360) % 360\n      actions = []\n\n      while delta_direction > 180 or delta_direction != 0:\n          if delta_direction > 180:\n              actions.append(2 if env._current_state.dir == 3 else 3)\n              env._current_state.dir = (env._current_state.dir + 1) % 4\n          else:\n              actions.append(2 if env._current_state.dir == 0 else 3)\n              env._current_state.dir = (env._current_state.dir - 1) % 4\n\n          direction_to_workshop = np.arctan2(target_pos[1] - current_pos[1], target_pos[0] - current_pos[0]) * 180 / np.pi\n          current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n          \n          if direction_to_workshop < 0:\n              direction_to_workshop += 360\n          \n          delta_direction = (direction_to_workshop - current_direction + 360) % 360\n      \n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  recipe = cookbook.recipes.get(goal_index)\n  if not recipe:\n      raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest position to move towards\n  pos = np.array(env._current_state.pos)\n  nearest_target_pos = get_closest_workshop_position(pos, workshop_indices)\n\n  if nearest_target_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  nearest_target_pos = np.round(nearest_target_pos).astype(int) # Ensure target position is an integer\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      action = get_directional_action(dx, dy)\n      actions.append(action)\n      pos[0] += 1 if action == 3 else (-1 if action == 2 else 0)\n      pos[1] += 1 if action == 1 else (-1 if action == 0 else 0)\n\n  # Orient the agent towards the workshop\n  actions.extend(rotate_to_face_target(pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 0, "scores": {"3": 5.0}}
{"timestamp": "2025-09-11T06:12:19.022107", "function_name": "craft", "function_body": "  def get_closest_workshop_position(pos, workshop_indices):\n      min_distance = float('inf')\n      nearest_target_pos = None\n      \n      for workshop_idx in workshop_indices:\n          # Calculate the mean position of all workshops of this type\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              for target_pos in workshop_pos_list:\n                  dist_to_target = np.linalg.norm(pos - target_pos, ord=2)\n                  if dist_to_target < min_distance:\n                      nearest_target_pos = target_pos\n                      min_distance = dist_to_target\n      \n      return nearest_target_pos\n\n  def get_directional_action(dx, dy):\n      \"\"\"Determine the action to move in based on dx and dy.\"\"\"\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          return 3 if dx > 0 else 2\n      else:  # Then move in y-direction\n          return 1 if dy > 0 else 0\n\n  def rotate_to_face_target(current_pos, target_pos):\n      \"\"\"Calculate the actions needed to orient the agent towards the target position.\"\"\"\n      direction_to_workshop = np.arctan2(target_pos[1] - current_pos[1], target_pos[0] - current_pos[0]) * 180 / np.pi\n      current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n      \n      if direction_to_workshop < 0:\n          direction_to_workshop += 360\n\n      delta_direction = (direction_to_workshop - current_direction + 360) % 360\n      actions = []\n\n      while delta_direction > 180 or delta_direction != 0:\n          if delta_direction > 180:\n              actions.append(2 if env._current_state.dir == 3 else 3)\n              env._current_state.dir = (env._current_state.dir + 1) % 4\n          else:\n              actions.append(2 if env._current_state.dir == 0 else 3)\n              env._current_state.dir = (env._current_state.dir - 1) % 4\n\n          direction_to_workshop = np.arctan2(target_pos[1] - current_pos[1], target_pos[0] - current_pos[0]) * 180 / np.pi\n          current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n          \n          if direction_to_workshop < 0:\n              direction_to_workshop += 360\n          \n          delta_direction = (direction_to_workshop - current_direction + 360) % 360\n      \n      return actions\n\n  def ensure_required_primitives_in_inventory(env, recipe):\n      \"\"\"Ensure all required primitives are in the inventory. Collect if not.\"\"\"\n      actions = []\n      for key in recipe.keys():\n          if key != '_key' and env._current_state.inventory.get(key, 0) < recipe[key]:\n              # Assume collect function is defined somewhere to get items from the grid\n              actions.extend(collect(env, key))\n      return actions\n\n  def collect(env, item):\n      \"\"\"Collect the specified item from the grid.\"\"\"\n      cookbook = env.world.cookbook\n      item_index = cookbook.index[item]\n      \n      if item_index is None:\n          raise ValueError(\"Unknown item\")\n\n      # Find all positions of the item in the grid\n      target_positions = np.argwhere(env._current_state.grid[:, :, item_index])\n      nearest_target_pos = None\n      min_distance = float('inf')\n\n      pos = np.array(env._current_state.pos)\n\n      for target_pos in target_positions:\n          distance = np.linalg.norm(pos - target_pos, ord=2)\n          if distance < min_distance:\n              nearest_target_pos = target_pos\n              min_distance = distance\n\n      # Move to the closest item position\n      while not np.array_equal(pos, nearest_target_pos):\n          dx, dy = nearest_target_pos - pos\n          action = get_directional_action(dx, dy)\n          actions.append(action)\n          pos[0] += 1 if action == 3 else (-1 if action == 2 else 0)\n          pos[1] += 1 if action == 1 else (-1 if action == 0 else 0)\n\n      # Use the item to collect it\n      actions.append(4)  # USE\n      \n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  recipe = cookbook.recipes.get(goal_index)\n  if not recipe:\n      raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Ensure all required primitives are in the inventory\n  actions.extend(ensure_required_primitives_in_inventory(env, recipe))\n\n  # Find the closest position to move towards\n  pos = np.array(env._current_state.pos)\n  nearest_target_pos = get_closest_workshop_position(pos, workshop_indices)\n\n  if nearest_target_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      action = get_directional_action(dx, dy)\n      actions.append(action)\n      pos[0] += 1 if action == 3 else (-1 if action == 2 else 0)\n      pos[1] += 1 if action == 1 else (-1 if action == 0 else 0)\n\n  # Orient the agent towards the workshop\n  actions.extend(rotate_to_face_target(pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 0, "scores": {"3": -1}}
