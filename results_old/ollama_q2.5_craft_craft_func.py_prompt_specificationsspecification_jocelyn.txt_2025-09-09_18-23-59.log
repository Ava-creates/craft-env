rient the agent towards the workshop (optional, might not be necessary)\n  direction_to_workshop = np.arctan2(nearest_target_pos[1] - pos[1], nearest_target_pos[0] - pos[0]) * 180 / np.pi\n  current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n  \n  if direction_to_workshop < 0:\n      direction_to_workshop += 360\n\n  # Calculate the difference in direction\n  delta_direction = (direction_to_workshop - current_direction + 360) % 360\n  \n  if delta_direction > 180:\n      actions.append(2 if env._current_state.dir == 3 else 3)\n      env._current_state.dir = (env._current_state.dir + 1) % 4\n  elif delta_direction < 180 and delta_direction != 0:\n      actions.append(2 if env._current_state.dir == 0 else 3)\n      env._current_state.dir = (env._current_state.dir - 1) % 4\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 7, "scores": {"3": 5.0}}
{"timestamp": "2025-09-11T06:23:32.880858", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda x: np.linalg.norm(pos - x))\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 4, "scores": {"3": 4.7}}
{"timestamp": "2025-09-11T06:28:33.271727", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate all positions of workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          nearest_workshop_pos = min(workshop_pos_list, key=lambda x: np.linalg.norm(pos - x))\n          distance = np.linalg.norm(pos - nearest_workshop_pos, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, nearest_target_pos, distance = workshop_idx, nearest_workshop_pos, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Orient the agent towards the workshop (optional, might not be necessary)\n  direction_to_workshop = np.arctan2(nearest_target_pos[1] - pos[1], nearest_target_pos[0] - nearest_target_pos[0]) * 180 / np.pi\n  current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n  \n  if direction_to_workshop < 0:\n      direction_to_workshop += 360\n\n  # Calculate the difference in direction\n  delta_direction = (direction_to_workshop - current_direction + 360) % 360\n  \n  # Adjust agent's direction to face the workshop\n  while delta_direction > 180:\n      actions.append(2 if env._current_state.dir == 3 else 3)\n      env._current_state.dir = (env._current_state.dir + 1) % 4\n      direction_to_workshop -= 90\n  while delta_direction < 180 and delta_direction != 0:\n      actions.append(2 if env._current_state.dir == 0 else 3)\n      env._current_state.dir = (env._current_state.dir - 1) % 4\n      direction_to_workshop += 90\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-11T06:35:53.887931", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  pos = np.array(env._current_state.pos)\n  current_dir = env._current_state.dir\n  \n  closest_workshop_idx, min_distance = None, float('inf')\n  \n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          \n          if distance < min_distance:\n              closest_workshop_idx = workshop_idx\n              min_distance = distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[np.argmin([np.linalg.norm(pos - target_pos, ord=2) for target_pos in target_positions])]\n\n  # Function to calculate direction based on the difference vector (dx, dy)\n  def calc_direction(dx: int, dy: int):\n      if dx == 0:\n          return 1 if dy > 0 else 0\n      elif dy == 0:\n          return 3 if dx > 0 else 2\n      else:\n          # If not directly aligned, choose a direction based on the larger absolute value of dx or dy\n          return calc_direction(dx, 0) if abs(dx) > abs(dy) else calc_direction(0, dy)\n\n  # Move towards the nearest target position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Calculate the direction to move in\n      direction = calc_direction(dx, dy)\n      \n      actions.append(direction)\n\n      # Update the current position based on the direction moved\n      if direction == 0:\n          pos[1] += 1\n      elif direction == 1:\n          pos[1] -= 1\n      elif direction == 2:\n          pos[0] -= 1\n      elif direction == 3:\n          pos[0] += 1\n\n  # Calculate the final direction to align with the workshop\n  dx, dy = nearest_target_pos - pos\n  target_direction = calc_direction(dx, dy)\n\n  # Determine the number of turns needed\n  turn_action = None\n  num_turns = (target_direction - current_dir + 4) % 4\n\n  if num_turns == 1:\n      turn_action = 3  # Turn right\n  elif num_turns == 3:\n      turn_action = 2  # Turn left\n  else:  # num_turns is 0 or 2 (no need to turn or turn around)\n      pass\n\n  if turn_action is not None:\n      actions.append(turn_action)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-11T06:35:54.966929", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find the closest workshop that can craft the desired item\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Calculate agent's current position and direction\n  pos = np.array(env._current_state.pos)\n  current_dir = env._current_state.dir\n  \n  # Mapping of directions to action indices\n  dir_to_action = {0: (1, 'UP'), 1: (0, 'DOWN'), 2: (3, 'LEFT'), 3: (2, 'RIGHT')}\n  \n  closest_workshop_idx, min_distance = None, float('inf')\n  \n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          \n          if distance < min_distance:\n              closest_workshop_idx = workshop_idx\n              min_distance = distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[np.argmin([np.linalg.norm(pos - target_pos, ord=2) for target_pos in target_positions])]\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(dir_to_action[3][0] if dx > 0 else dir_to_action[2][0])\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(dir_to_action[1][0] if dy > 0 else dir_to_action[0][0])\n          pos[1] += 1 if dy > 0 else -1\n\n  # Orient the agent towards the workshop\n  direction_to_workshop = np.arctan2(nearest_target_pos[1] - pos[1], nearest_target_pos[0] - pos[0]) * 180 / np.pi\n  \n  # Ensure angle is in range [0, 360)\n  if direction_to_workshop < 0:\n      direction_to_workshop += 360\n\n  # Convert current direction to degrees\n  current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[current_dir]\n\n  delta_direction = (direction_to_workshop - current_direction + 360) % 360\n  \n  # Determine the number of turns needed\n  if delta_direction > 180:\n      num_turns = 1\n      turn_action = 2 if current_dir == 3 else 3  # Turn left or right based on current direction\n  elif delta_direction < 180 and delta_direction != 0:\n      num_turns = 1\n      turn_action = 2 if current_dir == 0 else 3\n  else:\n      num_turns = 0\n\n  for _ in range(num_turns):\n      actions.append(turn_action)\n      # Update the current direction after each turn\n      current_dir = (current_dir + (-1 if turn_action == 3 else 1)) % 4\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 4, "scores": {"3": 0.2}}
{"timestamp": "2025-09-11T06:37:52.473412", "function_name": "craft", "function_body": "  def move_to_position(pos, target_pos):\n      actions = []\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n      return actions\n\n  def orient_towards(current_dir, target_direction):\n      directions = [\"UP\", \"DOWN\", \"LEFT\", \"RIGHT\"]\n      current_index = directions.index(current_dir)\n      target_index = directions.index(target_direction)\n\n      # Calculate the shortest path to turn towards the target direction\n      if (target_index - current_index) % 4 == 1:\n          return [3]  # Turn RIGHT\n      elif (target_index - current_index) % 4 == 2:\n          return [3, 3]  # Turn RIGHT twice or LEFT twice\n      elif (target_index - current_index) % 4 == 3:\n          return [2]  # Turn LEFT\n      else:\n          return []\n\n  def get_direction_to_workshop(pos, target_pos):\n      dx, dy = target_pos - pos\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          return \"LEFT\" if dx < 0 else \"RIGHT\"\n      else:  # Then move in y-direction\n          return \"UP\" if dy > 0 else \"DOWN\"\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda x: np.linalg.norm(pos - x))\n\n  actions.extend(move_to_position(pos, nearest_target_pos))\n  \n  # Orient the agent towards the workshop\n  direction_to_workshop = get_direction_to_workshop(pos, nearest_target_pos)\n  orientation_actions = orient_towards(env._current_state.dir, direction_to_workshop)\n  actions.extend(orientation_actions)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-11T06:37:53.601741", "function_name": "craft", "function_body": "  def move_to_position(pos, target_pos):\n      actions = []\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      return actions, pos\n  \n  def orient_towards(pos, target_pos, current_dir):\n      direction_to_workshop = np.arctan2(target_pos[1] - pos[1], target_pos[0] - pos[0]) * 180 / np.pi\n      current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[current_dir]\n      \n      if direction_to_workshop < 0:\n          direction_to_workshop += 360\n\n      delta_direction = (direction_to_workshop - current_direction + 360) % 360\n      \n      actions = []\n      while delta_direction >= 90:\n          actions.append(2 if current_dir == 3 else 3)\n          current_dir = (current_dir + 1) % 4\n          delta_direction -= 90\n\n      return actions, current_dir\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda x: np.linalg.norm(pos - x))\n\n  # Move to the closest workshop position\n  movement_actions, new_pos = move_to_position(pos, nearest_target_pos)\n  actions.extend(movement_actions)\n\n  # Orient the agent towards the workshop (optional, might not be necessary)\n  orientation_actions, new_direction = orient_towards(new_pos, nearest_target_pos, env._current_state.dir)\n  actions.extend(orientation_actions)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 5, "scores": {"3": 5.0}}
