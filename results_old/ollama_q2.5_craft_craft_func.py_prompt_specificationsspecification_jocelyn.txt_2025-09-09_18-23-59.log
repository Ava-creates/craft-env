t the agent towards the workshop (optional, might not be necessary)\n  direction_to_workshop = np.arctan2(nearest_target_pos[1] - pos[1], nearest_target_pos[0] - pos[0]) * 180 / np.pi\n  current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n  \n  if direction_to_workshop < 0:\n      direction_to_workshop += 360\n\n  # Calculate the difference in direction\n  delta_direction = (direction_to_workshop - current_direction + 360) % 360\n  \n  # Simplify turning logic to just turn left or right based on angle difference\n  if delta_direction > 180:\n      actions.append(2 if env._current_state.dir == 3 else 3)\n      env._current_state.dir = (env._current_state.dir + 1) % 4\n  elif delta_direction < 180 and delta_direction != 0:\n      actions.append(2 if env._current_state.dir == 0 else 3)\n      env._current_state.dir = (env._current_state.dir - 1) % 4\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 1, "scores": {"3": 5.0}}
{"timestamp": "2025-09-10T19:06:35.379740", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  recipe = cookbook.recipes.get(goal_index)\n  if not recipe:\n      raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Orient the agent towards the workshop (optional, might not be necessary)\n  direction_to_workshop = np.arctan2(nearest_target_pos[1] - pos[1], nearest_target_pos[0] - pos[0]) * 180 / np.pi\n  current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n  \n  if direction_to_workshop < 0:\n      direction_to_workshop += 360\n\n  # Calculate the difference in direction\n  delta_direction = (direction_to_workshop - current_direction + 360) % 360\n  \n  if delta_direction > 180:\n      actions.append(2 if env._current_state.dir == 3 else 3)\n      env._current_state.dir = (env._current_state.dir + 1) % 4\n  elif delta_direction < 180 and delta_direction != 0:\n      actions.append(2 if env._current_state.dir == 0 else 3)\n      env._current_state.dir = (env._current_state.dir - 1) % 4\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 0, "scores": {"3": 5.0}}
{"timestamp": "2025-09-10T19:06:36.428877", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  recipe = cookbook.recipes.get(goal_index)\n  if not recipe:\n      raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  # Check if any workshop in the recipe is available\n  for ingredient, quantity in recipe.items():\n      if ingredient != \"_workshop\":\n          continue\n\n      workshop_type = cookbook.index[ingredient]\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_type])\n\n      if len(workshop_pos_list) > 0:\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_type, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Orient the agent towards the workshop (optional, might not be necessary)\n  direction_to_workshop = np.arctan2(nearest_target_pos[1] - pos[1], nearest_target_pos[0] - nearest_target_pos[0]) * 180 / np.pi\n  current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n  \n  if direction_to_workshop < 0:\n      direction_to_workshop += 360\n\n  # Calculate the difference in direction\n  delta_direction = (direction_to_workshop - current_direction + 360) % 360\n  \n  if delta_direction > 180:\n      actions.append(2 if env._current_state.dir == 3 else 3)\n      env._current_state.dir = (env._current_state.dir + 1) % 4\n  elif delta_direction < 180 and delta_direction != 0:\n      actions.append(2 if env._current_state.dir == 0 else 3)\n      env._current_state.dir = (env._current_state.dir - 1) % 4\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-10T19:08:38.853579", "function_name": "craft", "function_body": "  def calculate_distance(pos1, pos2):\n      return np.linalg.norm(np.array(pos1) - np.array(pos2), ord=2)\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Determine the workshop type required for crafting\n  recipe = next((r for r in cookbook.recipes.values() if r['output'] == goal_index), None)\n  \n  if not recipe:\n      raise ValueError(f\"No known recipe to craft {item}\")\n\n  workshop_type = recipe.get('workshop', None)\n\n  if workshop_type is None or workshop_type not in env.world.workshop_indices:\n      raise ValueError(\"No available workshop found for this item\")\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n  \n  # Find the closest matching workshop\n  target_workshops = env._current_state.grid[:, :, workshop_type]\n  workshop_positions = np.argwhere(target_workshops)\n\n  if len(workshop_positions) == 0:\n      raise ValueError(\"No available workshops found\")\n\n  nearest_target_pos = min(workshop_positions, key=lambda x: calculate_distance(pos, x))\n\n  # Calculate the shortest path to the closest workshop\n  path = find_shortest_path(env._current_state.grid, pos, nearest_target_pos)\n\n  if not path:\n      raise ValueError(\"No valid path to the workshop\")\n\n  for next_pos in path[1:]:\n      dx, dy = next_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Orient the agent towards the workshop (optional, might not be necessary)\n  direction_to_workshop = np.arctan2(nearest_target_pos[1] - pos[1], nearest_target_pos[0] - pos[0]) * 180 / np.pi\n  current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n  \n  if direction_to_workshop < 0:\n      direction_to_workshop += 360\n\n  # Calculate the difference in direction\n  delta_direction = (direction_to_workshop - current_direction + 360) % 360\n  \n  if delta_direction > 180:\n      actions.append(2 if env._current_state.dir == 3 else 3)\n      pos = (env._current_state.dir + 1) % 4\n  elif delta_direction < 180 and delta_direction != 0:\n      actions.append(2 if env._current_state.dir == 0 else 3)\n      pos = (env._current_state.dir - 1) % 4\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-10T19:08:40.057059", "function_name": "craft", "function_body": "  def calculate_distance(pos1, pos2):\n      return np.linalg.norm(np.array(pos1) - np.array(pos2), ord=2)\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(goal_index)\n  \n  if not recipe:\n      raise ValueError(f\"No recipe found for item: {item}\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  current_state = env._current_state\n  pos = np.array(current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(current_state.grid[:, :, workshop_idx])\n      \n      if len(workshop_pos_list) == 0: \n          continue\n\n      workshop_pos_mean = workshop_pos_list.mean(axis=0)\n      distance = calculate_distance(pos, workshop_pos_mean)\n\n      if distance < min_distance:\n          closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda x: calculate_distance(pos, x))\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  \n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  \n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Orient the agent towards the workshop (optional, might not be necessary)\n  direction_to_workshop = np.arctan2(nearest_target_pos[1] - pos[1], nearest_target_pos[0] - pos[0]) * 180 / np.pi\n  current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[current_state.dir]\n  \n  if direction_to_workshop < 0:\n      direction_to_workshop += 360\n\n  # Calculate the difference in direction\n  delta_direction = (direction_to_workshop - current_direction + 360) % 360\n  \n  if delta_direction > 180:\n      actions.append(2 if current_state.dir == 3 else 3)\n      current_state.dir = (current_state.dir + 1) % 4\n  elif delta_direction < 180 and delta_direction != 0:\n      actions.append(2 if current_state.dir == 0 else 3)\n      current_state.dir = (current_state.dir - 1) % 4\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 5, "scores": {"3": 5.0}}
{"timestamp": "2025-09-10T19:10:46.471719", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest available workshop with required ingredients\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n\n          # Verify if all ingredients are available in this area\n          recipe = cookbook.recipes.get(goal_index, {})\n          required_ingredients = set(recipe.keys()) - {\"_key\"}\n          \n          if all(env._current_state.next_to(ingredient) for ingredient in required_ingredients):\n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found with the required ingredients\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos