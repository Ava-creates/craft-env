= 3 if direction_delta[0] > 0 else 2\n  elif direction_delta[1] != 0:\n      target_direction = 1 if direction_delta[1] > 0 else 0\n\n  while current_direction != target_direction:\n      actions.append(2 if (current_direction + 1) % 4 == target_direction or (current_direction - 3) % 4 == target_direction else 3)\n      current_direction = (current_direction + 1) % 4 if (current_direction + 1) % 4 == target_direction else (current_direction - 1) % 4\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 4, "scores": {"3": -1}}
