90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n  \n  if direction_to_workshop < 0:\n      direction_to_workshop += 360\n\n  # Calculate the difference in direction\n  delta_direction = (direction_to_workshop - current_direction + 360) % 360\n  \n  # Simplify orientation logic\n  if delta_direction > 180:\n      actions.append(2 if env._current_state.dir == 3 else 3)\n      env._current_state.dir = (env._current_state.dir + 1) % 4\n  elif delta_direction < 180 and delta_direction != 0:\n      actions.append(2 if env._current_state.dir == 0 else 3)\n      env._current_state.dir = (env._current_state.dir - 1) % 4\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 7, "scores": {"3": 5.0}}
{"timestamp": "2025-09-10T17:30:35.856009", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda x: np.linalg.norm(pos - x))\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      elif abs(dy) > abs(dx):  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n      # If the agent is on the same row or column, decide which direction to go\n      elif dx == 0:\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n      elif dy == 0:\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n\n  # Orient the agent towards the workshop (optional, might not be necessary)\n  direction_to_workshop = np.arctan2(nearest_target_pos[1] - pos[1], nearest_target_pos[0] - pos[0]) * 180 / np.pi\n  current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n  \n  if direction_to_workshop < 0:\n      direction_to_workshop += 360\n\n  # Calculate the difference in direction\n  delta_direction = (direction_to_workshop - current_direction + 360) % 360\n  \n  if delta_direction > 180:\n      actions.append(2 if env._current_state.dir == 3 else 3)\n      env._current_state.dir = (env._current_state.dir + 1) % 4\n  elif delta_direction < 180 and delta_direction != 0:\n      actions.append(2 if env._current_state.dir == 0 else 3)\n      env._current_state.dir = (env._current_state.dir - 1) % 4\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-10T17:33:09.906253", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  recipe = cookbook.primitives.get(goal_index)\n  if not recipe:\n      raise ValueError(f\"No recipe found for item {item}\")\n\n  # Filter workshops that can craft the desired item based on their primitives.\n  applicable_workshop_indices = [\n      workshop_idx for workshop_idx in env.world.workshop_indices\n      if any(workshop_primitive in recipe for workshop_primitive in cookbook.primitives.get(workshop_idx, []))\n  ]\n\n  if not applicable_workshop_indices:\n      raise ValueError(\"No applicable workshops found for the desired item.\")\n\n  actions = []\n\n  # Find the closest applicable workshop\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in applicable_workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available applicable workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Orient the agent towards the workshop (optional, might not be necessary)\n  direction_to_workshop = np.arctan2(nearest_target_pos[1] - pos[1], nearest_target_pos[0] - pos[0]) * 180 / np.pi\n  current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n  \n  if direction_to_workshop < 0:\n      direction_to_workshop += 360\n\n  # Calculate the difference in direction\n  delta_direction = (direction_to_workshop - current_direction + 360) % 360\n  \n  # Adjusting agent's direction to face the workshop\n  if delta_direction > 180:\n      actions.append(2 if env._current_state.dir == 3 else 3)\n      env._current_state.dir = (env._current_state.dir + 1) % 4\n  elif delta_direction < 180 and delta_direction != 0:\n      actions.append(2 if env._current_state.dir == 0 else 3)\n      env._current_state.dir = (env._current_state.dir - 1) % 4\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-10T17:38:10.058400", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Orient the agent towards the workshop (optional, might not be necessary)\n  direction_to_workshop = np.arctan2(nearest_target_pos[1] - pos[1], nearest_target_pos[0] - pos[0]) * 180 / np.pi\n  current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n  \n  if direction_to_workshop < 0:\n      direction_to_workshop += 360\n\n  # Calculate the difference in direction\n  delta_direction = (direction_to_workshop - current_direction + 360) % 360\n  \n  # Adjusting agent's direction to face the workshop\n  while delta_direction > 180:\n      actions.append(2 if env._current_state.dir == 3 else 3)\n      env._current_state.dir = (env._current_state.dir + 1) % 4\n      direction_to_workshop = np.arctan2(nearest_target_pos[1] - pos[1], nearest_target_pos[0] - pos[0]) * 180 / np.pi\n      delta_direction = (direction_to_workshop - current_direction + 360) % 360\n\n  while delta_direction < 180 and delta_direction != 0:\n      actions.append(2 if env._current_state.dir == 0 else 3)\n      env._current_state.dir = (env._current_state.dir - 1) % 4\n      direction_to_workshop = np.arctan2(nearest_target_pos[1] - pos[1], nearest_target_pos[0] - pos[0]) * 180 / np.pi\n      delta_direction = (direction_to_workshop - current_direction + 360) % 360\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-10T17:40:41.292054", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda x: np.linalg.norm(pos - x))\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      direction_to_move = None\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          direction_to_move = (3 if dx > 0 else 2)\n          pos[0] += (1 if dx > 0 else -1)\n      else:  # Then move in y-direction\n          direction_to_move = (1 if dy > 0 else 0)\n          pos[1] += (1 if dy > 0 else -1)\n\n      actions.append(direction_to_move)\n\n  # Calculate the direction towards the workshop and orient the agent\n  current_direction = env._current_state.dir\n\n  target_direction = calculate_direction_to_target(pos, nearest_target_pos)\n  while current_direction != target_direction:\n      if (current_direction + 1) % 4 == target_direction or \\\n         (current_direction - 1) % 4 == target_direction:\n          actions.append(2 if (current_direction + 1) % 4 == target_direction else 3)\n          current_direction = target_direction\n      else:\n          actions.extend([2, 2])  # Turn 180 degrees\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-10T17:40:42.387054", "function_name": "craft", "function_body": "  def calculate_direction_to_target(pos: np.ndarray, target_pos: np.ndarray) -> int:\n      dx, dy = target_pos - pos\n      if abs(dx) > abs(dy):\n          return (3 if dx > 0 else 2)\n      else:\n          return (1 if dy > 0 else 0)\n\n  def orient_towards_target(current_dir: int, direction_to_workshop: float) -> list[int]:\n      current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[current_dir]\n      \n      if direction_to_workshop < 0:\n          direction_to_workshop += 360\n\n      delta_direction = (direction_to_workshop - current_direction + 360) % 360\n      \n      actions = []\n      while delta_direction > 180:\n          actions.append(2 if current_dir == 3 else 3)\n          current_dir = (current_dir + 1) % 4\n          direction_to_workshop += -90 if current_dir in [0, 1] else -270\n          delta_direction = (direction_to_workshop - {0: 90, 1: 0, 2: 270, 3: 180}[current_dir] + 360) % 360\n      \n      while delta_direction < 180 and delta_direction != 0:\n          actions.append(2 if current_dir == 0 else 3)\n          current_dir = (current_dir - 1) % 4\n          direction_to_workshop += 90 if current_dir in [0, 1] else 270\n          delta_direction = (direction_to_workshop - {0: 90, 1: 0, 2: 270, 3: 180}[current_dir] + 360) % 360\n      \n      return actions\n\n  def find_closest_workshop(env):\n      pos = np.array(env._current_state.pos)\n      workshop_indices = env.world.workshop_indices\n      closest_workshop_idx, min_distance = None, float('inf')\n      \n      for workshop_idx in workshop_indices:\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              workshop_pos_mean = workshop_pos_list.mean(axis=0)\n              distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n      \n      if closest_workshop_idx is None:\n          raise ValueError(\"No available workshop found\")\n      \n      return closest_workshop_idx\n\n  def find_nearest_target_position(env, workshop_idx):\n      pos = np.array(env._current_state.pos)\n      target_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      nearest_target_pos = min(target_positions, key=lambda x: np.linalg.norm(pos - x))\n      return nearest_target_pos\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx = find_closest_workshop(env)\n\n  # Calculate the closest position to move towards\n  nearest_target_pos = find_nearest_target_position(env, closest_workshop_idx)\n\n  # Move to the closest workshop position\n  pos = np.array(env._current_state.pos)\n  while not np.array_equal(pos, nearest_target_pos):\n      direction_to_move = calculate_direction_to_target(pos, nearest_target_pos)\n      actions.append(direction_to_move)\n      pos += (direction_to_move == 3) * np.array([1, 0]) + (direction_to_move == 2) * np.array([-1, 0]) +\\\n             (direction_to_move == 1) * np.array([0, 1]) + (direction_to_move == 0) * np.array([0, -1])\n\n  # Calculate the direction towards the workshop and orient the agent\n  current_direction = env._current_state.dir\n  direction_to_workshop = np.arctan2(nearest_target_pos[1] - pos[1], nearest_target_pos[0] - nearest_target_pos[0]) * 180 / np.pi\n  \n  # Adjust agent's direction to face towards the workshop\n  actions.extend(orient_towards_target(current_direction, direction_to_workshop))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 4, "scores": {"3": 3.0}}
{"timestamp": "2025-09-10T17:43:16.598343", "function_name": "craft", "function_body": "  def move_to_position(pos_x, pos_y):\n      current_pos = np.array(env._current_state.pos)\n      target_pos = np.array([pos_x, pos_y])\n\n      while not np.array_equal(current_pos, target_pos):\n          dx, dy = target_pos - current_pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              current_pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              current_pos[1] += 1 if dy > 0 else -1\n\n      return current_pos\n\n  def orient_towards(target_dir):\n      current_dir = env._current_state.dir\n      \n      while current_dir != target_dir:\n          if (current_dir + 1) % 4 == target_dir or (target_dir - current_dir) % 4 == 3:\n              actions.append(3)  # Turn right\n          else:\n              actions.append(2)  # Turn left\n          \n          current_dir = (current_dir + 1) % 4\n\n      env._current_state.dir = target_dir\n\n  def calculate_direction_to_workshop(pos, workshop_pos):\n      direction_to_workshop = np.arctan2(workshop_pos[1] - pos[1], workshop_pos[0] - pos[0]) * 180 / np.pi\n      current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n      \n      if direction_to_workshop < 0:\n          direction_to_workshop += 360\n\n      delta_direction = (direction_to_workshop - current_direction + 360) % 360\n      \n      target_dir = None\n      if delta_direction <= 90 or delta_direction > 270:\n          target_dir = 1 if delta_direction < 90 else 3\n      elif 90 < delta_direction <= 180:\n          target_dir = 0\n      elif 180 < delta_direction <= 270:\n          target_dir = 2\n\n      return target_dir\n\n  def find_closest_workshop():\n      pos = np.array(env._current_state.pos)\n      min_distance = float('inf')\n      closest_workshop_idx = None\n      nearest_target_pos = None\n      \n      for workshop_idx in env.world.workshop_indices:\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) == 0:  # No available workshops of this type\n              continue\n\n          for target_pos in workshop_pos_list:\n              distance = np.linalg.norm(pos - target_pos, ord=2)\n              if distance < min_distance:\n                  closest_workshop_idx, min_distance, nearest_target_pos = workshop_idx, distance, target_pos\n      \n      return closest_workshop_idx, nearest_target_pos\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, nearest_target_pos = find_closest_workshop()\n\n  if closest_workshop_idx is None or nearest_target_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  pos = move_to_position(nearest_target_pos[0], nearest_target_pos[1])\n\n  # Orient the agent towards the workshop\n  target_dir = calculate_direction_to_workshop(pos, nearest_target_pos)\n  orient_towards(target_dir)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": 5.0}}
