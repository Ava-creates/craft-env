n_to_workshop += 360\n\n  # Calculate the difference in direction\n  delta_direction = (direction_to_workshop - current_direction + 360) % 360\n  \n  # Simplified direction adjustment logic\n  while delta_direction >= 180:\n      actions.append(2 if env._current_state.dir == 3 else 3)\n      env._current_state.dir = (env._current_state.dir + 1) % 4\n      delta_direction -= 180\n\n  while delta_direction > 90:\n      actions.append(2 if env._current_state.dir == 0 else 3)\n      env._current_state.dir = (env._current_state.dir - 1) % 4\n      delta_direction -= 90\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-11T07:44:24.937060", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position using a more efficient pathfinding algorithm (A*).\n  def heuristic(a, b):\n      return np.linalg.norm(np.array(a) - np.array(b), ord=1)\n\n  def astar(start, goal):\n      open_set = set()\n      closed_set = set()\n      g = {start: 0}\n      f = {start: heuristic(start, goal)}\n      came_from = {}\n\n      open_set.add(start)\n\n      while open_set:\n          current = min(open_set, key=lambda x: f[x])\n          if current == goal:\n              data, total = [], current\n              while total in came_from:\n                  data.append(total)\n                  total = came_from[total]\n              return data[::-1]\n\n          open_set.remove(current)\n          closed_set.add(current)\n\n          for neighbor in [(current[0] - 1, current[1]), (current[0] + 1, current[1]), \n                            (current[0], current[1] - 1), (current[0], current[1] + 1)]:\n              tentative_g = g[current] + heuristic(current, neighbor)\n              if not (0 <= neighbor[0] < env._current_state.grid.shape[0]) or \\\n                 not (0 <= neighbor[1] < env._current_state.grid.shape[1]):\n                  continue\n\n              if neighbor in closed_set and tentative_g >= g.get(neighbor, float('inf')):\n                  continue\n              elif neighbor not in open_set or tentative_g < g.get(neighbor, float('inf')):\n                  came_from[neighbor] = current\n                  g[neighbor] = tentative_g\n                  f[neighbor] = tentative_g + heuristic(neighbor, goal)\n                  if neighbor not in open_set:\n                      open_set.add(neighbor)\n\n      return None\n\n  path = astar(tuple(pos), tuple(nearest_target_pos))\n  \n  if path is None or len(path) == 0:\n      raise ValueError(\"No path found to the workshop\")\n\n  # Convert the path into actions\n  for i in range(len(path) - 1):\n      dx, dy = path[i + 1][0] - path[i][0], path[i + 1][1] - path[i][1]\n      if dx > 0:\n          actions.append(3)\n      elif dx < 0:\n          actions.append(2)\n      elif dy > 0:\n          actions.append(1)\n      else:\n          actions.append(0)\n\n  # Orient the agent towards the workshop\n  direction_to_workshop = np.arctan2(nearest_target_pos[1] - pos[1], nearest_target_pos[0] - pos[0]) * 180 / np.pi\n  current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n  \n  if direction_to_workshop < 0:\n      direction_to_workshop += 360\n\n  # Calculate the difference in direction\n  delta_direction = (direction_to_workshop - current_direction + 360) % 360\n  \n  while delta_direction >= 180:\n      actions.append(2 if env._current_state.dir == 3 else 3)\n      env._current_state.dir = (env._current_state.dir + 1) % 4\n      delta_direction -= 180\n\n  while delta_direction > 90:\n      actions.append(2 if env._current_state.dir == 0 else 3)\n      env._current_state.dir = (env._current_state.dir - 1) % 4\n      delta_direction -= 90\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 3, "scores": {"3": 0.7}}
{"timestamp": "2025-09-11T07:47:08.527830", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position using A* pathfinding\n  start = tuple(pos)\n  end = tuple(nearest_target_pos)\n\n  def heuristic(a, b):\n      return np.linalg.norm(np.array(a) - np.array(b), ord=2)\n\n  open_set = []\n  heapq.heappush(open_set, (0 + heuristic(start, end), start))\n  came_from = {}\n  g_score = {start: 0}\n  f_score = {start: heuristic(start, end)}\n\n  while open_set:\n      _, current = heapq.heappop(open_set)\n      \n      if current == end:\n          path = []\n          while current in came_from:\n              path.append(current)\n              current = came_from[current]\n          path.reverse()\n          break\n      \n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          neighbor = (current[0] + dx, current[1] + dy)\n          \n          if not (0 <= neighbor[0] < env._current_state.grid.shape[0]) or not (0 <= neighbor[1] < env._current_state.grid.shape[1]):\n              continue\n          \n          tentative_g_score = g_score[current] + 1\n          \n          if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n              came_from[neighbor] = current\n              g_score[neighbor] = tentative_g_score\n              f_score[neighbor] = tentative_g_score + heuristic(neighbor, end)\n              heapq.heappush(open_set, (f_score[neighbor], neighbor))\n\n  if 'path' not in locals():\n      raise ValueError(\"No path found to the workshop\")\n\n  # Generate actions from path\n  for i in range(len(path) - 1):\n      current_pos = np.array(path[i])\n      next_pos = np.array(path[i + 1])\n\n      dx, dy = next_pos - current_pos\n\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      elif dy > 0:\n          actions.append(1)  # DOWN\n      elif dy < 0:\n          actions.append(0)  # UP\n\n  # Orient the agent towards the workshop (optional, might not be necessary)\n  direction_to_workshop = np.arctan2(nearest_target_pos[1] - pos[1], nearest_target_pos[0] - pos[0]) * 180 / np.pi\n  current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n  \n  if direction_to_workshop < 0:\n      direction_to_workshop += 360\n\n  # Calculate the difference in direction\n  delta_direction = (direction_to_workshop - current_direction + 360) % 360\n  \n  if delta_direction > 180:\n      actions.append(2 if env._current_state.dir == 3 else 3)\n      env._current_state.dir = (env._current_state.dir + 1) % 4\n  elif delta_direction < 180 and delta_direction != 0:\n      actions.append(2 if env._current_state.dir == 0 else 3)\n      env._current_state.dir = (env._current_state.dir - 1) % 4\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
