{"timestamp": "2025-09-10T16:49:54.421653", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Determine the workshop index from the recipe that can craft the desired item\n  for recipe in cookbook.recipes:\n      if goal_index == recipe.output_item_index:\n          required_workshop_index = recipe.workshop_type\n          break\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest available workshop of the specified type\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  if required_workshop_index in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, required_workshop_index])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          for workshop_pos in workshop_pos_list:\n              distance = np.linalg.norm(pos - workshop_pos, ord=2)\n              if distance < min_distance:\n                  closest_workshop_idx, min_distance, nearest_target_pos = required_workshop_index, distance, workshop_pos\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop of the specified type found\")\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Orient the agent towards the workshop (optional, might not be necessary)\n  direction_to_workshop = np.arctan2(nearest_target_pos[1] - pos[1], nearest_target_pos[0] - pos[0]) * 180 / np.pi\n  current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n  \n  if direction_to_workshop < 0:\n      direction_to_workshop += 360\n\n  # Calculate the difference in direction\n  delta_direction = (direction_to_workshop - current_direction + 360) % 360\n  \n  if delta_direction > 180:\n      actions.append(2 if env._current_state.dir == 3 else 3)\n      env._current_state.dir = (env._current_state.dir + 1) % 4\n  elif delta_direction < 180 and delta_direction != 0:\n      actions.append(2 if env._current_state.dir == 0 else 3)\n      env._current_state.dir = (env._current_state.dir - 1) % 4\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-10T16:52:33.930571", "function_name": "craft", "function_body": "  def move_to_position(pos_x, pos_y):\n      current_pos = np.array(env._current_state.pos)\n      target_pos = np.array([pos_x, pos_y])\n\n      while not np.array_equal(current_pos, target_pos):\n          dx, dy = target_pos - current_pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              current_pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              current_pos[1] += 1 if dy > 0 else -1\n\n      return current_pos\n\n  def orient_towards(target_dir):\n      current_dir = env._current_state.dir\n      \n      while current_dir != target_dir:\n          if (current_dir + 1) % 4 == target_dir or (target_dir - current_dir) % 4 == 3:\n              actions.append(3)  # Turn right\n          else:\n              actions.append(2)  # Turn left\n          \n          current_dir = (current_dir + 1) % 4\n\n      env._current_state.dir = target_dir\n\n  def calculate_direction_to_workshop(pos, workshop_pos):\n      direction_to_workshop = np.arctan2(workshop_pos[1] - pos[1], workshop_pos[0] - pos[0]) * 180 / np.pi\n      current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n      \n      if direction_to_workshop < 0:\n          direction_to_workshop += 360\n\n      delta_direction = (direction_to_workshop - current_direction + 360) % 360\n      \n      target_dir = None\n      if delta_direction <= 90 or delta_direction > 270:\n          target_dir = 1 if delta_direction < 90 else 3\n      elif 90 < delta_direction <= 180:\n          target_dir = 0\n      elif 180 < delta_direction <= 270:\n          target_dir = 2\n\n      return target_dir\n\n  def find_closest_workshop():\n      pos = np.array(env._current_state.pos)\n      closest_workshop_idx, min_distance = None, float('inf')\n\n      for workshop_idx in env.world.workshop_indices:\n          # Calculate the mean position of all workshops of this type\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              workshop_pos_mean = workshop_pos_list.mean(axis=0)\n              distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n\n      return closest_workshop_idx, min_distance\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, _ = find_closest_workshop()\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda p: np.linalg.norm(np.array(env._current_state.pos) - p))\n\n  # Move to the closest workshop position\n  pos = move_to_position(nearest_target_pos[0], nearest_target_pos[1])\n\n  # Orient the agent towards the workshop\n  target_dir = calculate_direction_to_workshop(pos, nearest_target_pos)\n  orient_towards(target_dir)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": 5.0}}
{"timestamp": "2025-09-10T16:52:34.919478", "function_name": "craft", "function_body": "  def move_to_position(pos_x, pos_y):\n      current_pos = np.array(env._current_state.pos)\n      target_pos = np.array([pos_x, pos_y])\n\n      while not np.array_equal(current_pos, target_pos):\n          dx, dy = target_pos - current_pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              current_pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              current_pos[1] += 1 if dy > 0 else -1\n\n      return current_pos\n\n  def orient_towards(target_dir):\n      current_dir = env._current_state.dir\n      \n      while current_dir != target_dir:\n          if (current_dir + 1) % 4 == target_dir or (target_dir - current_dir) % 4 == 3:\n              actions.append(3)  # Turn right\n          else:\n              actions.append(2)  # Turn left\n          \n          current_dir = (current_dir + 1) % 4\n\n      env._current_state.dir = target_dir\n\n  def calculate_direction_to_workshop(pos, workshop_pos):\n      direction_to_workshop = np.arctan2(workshop_pos[1] - pos[1], workshop_pos[0] - pos[0]) * 180 / np.pi\n      current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n      \n      if direction_to_workshop < 0:\n          direction_to_workshop += 360\n\n      delta_direction = (direction_to_workshop - current_direction + 360) % 360\n      \n      target_dir = None\n      if delta_direction <= 90 or delta_direction > 270:\n          target_dir = 1 if delta_direction < 90 else 3\n      elif 90 < delta_direction <= 180:\n          target_dir = 0\n      elif 180 < delta_direction <= 270:\n          target_dir = 2\n\n      return target_dir\n\n  def find_closest_workshop(item_index):\n      workshop_indices = env.world.workshop_indices\n      pos = np.array(env._current_state.pos)\n      \n      closest_workshop_idx, min_distance = None, float('inf')\n\n      for workshop_idx in workshop_indices:\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              workshop_pos_mean = workshop_pos_list.mean(axis=0)\n              distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n              \n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n\n      return closest_workshop_idx\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx = find_closest_workshop(goal_index)\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda p: np.linalg.norm(pos - p))\n\n  # Move to the closest workshop position\n  pos = move_to_position(nearest_target_pos[0], nearest_target_pos[1])\n\n  # Orient the agent towards the workshop\n  target_dir = calculate_direction_to_workshop(pos, nearest_target_pos)\n  orient_towards(target_dir)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-10T16:54:27.104250", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Pathfinding using A* algorithm to find the shortest path to the workshop\n  def heuristic(a, b):\n      return np.linalg.norm(np.array(a) - np.array(b), ord=1)\n\n  def a_star_search(start, goal):\n      open_set = collections.PriorityQueue()\n      open_set.put((0, start))\n      came_from = {}\n      g_score = {tuple(start): 0}\n      f_score = {tuple(start): heuristic(start, goal)}\n\n      while not open_set.empty():\n          _, current = open_set.get()\n\n          if tuple(current) == tuple(goal):\n              path = []\n              while current in came_from:\n                  path.append(tuple(current))\n                  current = came_from[tuple(current)]\n              return path[::-1]\n\n          for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              tentative_g_score = g_score[tuple(current)] + heuristic(current, neighbor)\n\n              if not (0 <= neighbor[0] < env._current_state.grid.shape[0]) or not (0 <= neighbor[1] < env._current_state.grid.shape[1]):\n                  continue\n\n              if tuple(neighbor) not in g_score or tentative_g_score < g_score[tuple(neighbor)]:\n                  came_from[tuple(neighbor)] = current\n                  g_score[tuple(neighbor)] = tentative_g_score\n                  f_score[tuple(neighbor)] = tentative_g_score + heuristic(neighbor, goal)\n                  open_set.put((f_score[tuple(neighbor)], neighbor))\n\n      return None\n\n  path = a_star_search(tuple(pos), tuple(nearest_target_pos))\n  \n  if not path:\n      raise ValueError(\"No valid path to the workshop found\")\n\n  # Convert path into actions\n  for next_pos in path[1:]:\n      dx, dy = next_pos[0] - pos[0], next_pos[1] - pos[1]\n      \n      if dx == 1:  # RIGHT\n          actions.append(3)\n      elif dx == -1:  # LEFT\n          actions.append(2)\n      elif dy == 1:  # UP\n          actions.append(1)\n      elif dy == -1:  # DOWN\n          actions.append(0)\n\n      pos = np.array(next_pos)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-10T16:54:28.214342", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 4, "scores": {"3": 4.7}}
{"timestamp": "2025-09-10T16:57:03.725840", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          nearest_workshop_pos = min(workshop_pos_list, key=lambda x: np.linalg.norm(pos - x))\n          distance = np.linalg.norm(pos - nearest_workshop_pos, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda x: np.linalg.norm(pos - x))\n\n  def orient_towards_target(current_pos: np.ndarray, target_pos: np.ndarray) -> list[int]:\n      dx, dy = target_pos - current_pos\n      direction_to_target = np.arctan2(dy, dx) * 180 / np.pi\n\n      # Normalize direction to be between [0, 360)\n      if direction_to_target < 0:\n          direction_to_target += 360\n\n      current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n\n      # Calculate the difference in direction\n      delta_direction = (direction_to_target - current_direction + 360) % 360\n\n      actions = []\n\n      if delta_direction > 180:\n          turn_action = 2 if env._current_state.dir == 3 else 3\n          while delta_direction >= 90:\n              actions.append(turn_action)\n              env._current_state.dir = (env._current_state.dir + 1) % 4\n              current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n              delta_direction = (direction_to_target - current_direction + 360) % 360\n\n      else:\n          turn_action = 2 if env._current_state.dir == 0 else 3\n          while delta_direction >= 90:\n              actions.append(turn_action)\n              env._current_state.dir = (env._current_state.dir - 1) % 4\n              current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n              delta_direction = (direction_to_target - current_direction + 360) % 360\n\n      return actions\n  \n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      \n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          move_action = 3 if dx > 0 else 2\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          move_action = 1 if dy > 0 else 0\n          pos[1] += 1 if dy > 0 else -1\n      \n      actions.append(move_action)\n\n  # Orient the agent towards the workshop\n  actions.extend(orient_towards_target(pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 4, "scores": {"3": 5.0}}
