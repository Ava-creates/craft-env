\n          if current == goal:\n              path = []\n              while current in came_from:\n                  path.append(current)\n                  current = came_from[current]\n              path.reverse()\n              return path\n\n          open_set.remove(current)\n          closed_set.add(current)\n\n          neighbors = [(current[0] + dx, current[1] + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n          for neighbor in neighbors:\n              tentative_g_score = g_score[current] + heuristic(current, neighbor)\n\n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                  open_set.add(neighbor)\n\n      return []\n\n  path_to_target = a_star(tuple(pos), tuple(nearest_target_pos))\n\n  # Convert path to actions\n  for step in path_to_target:\n      dx, dy = np.array(step) - pos\n      if abs(dx) > abs(dy):\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 0, "scores": {"3": 4.7}}
{"timestamp": "2025-09-10T01:43:35.477139", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          nearest_workshop_pos = min(workshop_pos_list, key=lambda x: np.linalg.norm(pos - x))\n          distance = np.linalg.norm(pos - nearest_workshop_pos, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda x: np.linalg.norm(pos - x))\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Orient the agent towards the workshop (optional, might not be necessary)\n  direction_to_workshop = np.arctan2(nearest_target_pos[1] - pos[1], nearest_target_pos[0] - nearest_target_pos[0]) * 180 / np.pi\n  current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n  \n  if direction_to_workshop < 0:\n      direction_to_workshop += 360\n\n  # Calculate the difference in direction\n  delta_direction = (direction_to_workshop - current_direction + 360) % 360\n  \n  # Adjust agent's direction to face towards the workshop\n  while delta_direction > 180:\n      actions.append(2 if env._current_state.dir == 3 else 3)\n      env._current_state.dir = (env._current_state.dir + 1) % 4\n      direction_to_workshop = np.arctan2(nearest_target_pos[1] - pos[1], nearest_target_pos[0] - nearest_target_pos[0]) * 180 / np.pi\n      current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n      if direction_to_workshop < 0:\n          direction_to_workshop += 360\n      delta_direction = (direction_to_workshop - current_direction + 360) % 360\n  \n  while delta_direction < 180 and delta_direction != 0:\n      actions.append(2 if env._current_state.dir == 0 else 3)\n      env._current_state.dir = (env._current_state.dir - 1) % 4\n      direction_to_workshop = np.arctan2(nearest_target_pos[1] - pos[1], nearest_target_pos[0] - nearest_target_pos[0]) * 180 / np.pi\n      current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n      if direction_to_workshop < 0:\n          direction_to_workshop += 360\n      delta_direction = (direction_to_workshop - current_direction + 360) % 360\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 4, "scores": {"3": 5.0}}
{"timestamp": "2025-09-10T01:43:36.447341", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find the workshop that can craft the desired item based on recipe.\n  required_workshop_indices = []\n  for recipe in cookbook.recipes.values():\n      if recipe.get('output', {}).get('name') == item:\n          required_workshop_indices.append(recipe['workshop'])\n\n  if not required_workshop_indices:\n      raise ValueError(\"No workshop can craft the desired item.\")\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in required_workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda x: np.linalg.norm(pos - x))\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Orient the agent towards the workshop (optional, might not be necessary)\n  direction_to_workshop = np.arctan2(nearest_target_pos[1] - pos[1], nearest_target_pos[0] - pos[0]) * 180 / np.pi\n  current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n  \n  if direction_to_workshop < 0:\n      direction_to_workshop += 360\n\n  # Calculate the difference in direction\n  delta_direction = (direction_to_workshop - current_direction + 360) % 360\n  \n  # Adjust agent's direction to face towards the workshop\n  while delta_direction > 180:\n      actions.append(2 if env._current_state.dir == 3 else 3)\n      env._current_state.dir = (env._current_state.dir + 1) % 4\n      direction_to_workshop = np.arctan2(nearest_target_pos[1] - pos[1], nearest_target_pos[0] - pos[0]) * 180 / np.pi\n      current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n      if direction_to_workshop < 0:\n          direction_to_workshop += 360\n      delta_direction = (direction_to_workshop - current_direction + 360) % 360\n  \n  while delta_direction < 180 and delta_direction != 0:\n      actions.append(2 if env._current_state.dir == 0 else 3)\n      env._current_state.dir = (env._current_state.dir - 1) % 4\n      direction_to_workshop = np.arctan2(nearest_target_pos[1] - pos[1], nearest_target_pos[0] - pos[0]) * 180 / np.pi\n      current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n      if direction_to_workshop < 0:\n          direction_to_workshop += 360\n      delta_direction = (direction_to_workshop - current_direction + 360) % 360\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-10T01:45:13.964865", "function_name": "craft", "function_body": "  def get_action(start: np.ndarray, end: np.ndarray) -> int:\n      dx, dy = end - start\n      if abs(dx) > abs(dy):\n          return 3 if dx > 0 else 2\n      else:\n          return 1 if dy > 0 else 0\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  current_pos = np.array(env._current_state.pos)\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_positions) == 0:  # Skip if there are no locations for the workshop\n          continue\n\n      # Calculate distances to each workshop position from current position and find the nearest one\n      distances = np.linalg.norm(workshop_positions - current_pos, axis=1)\n      min_workshop_distance = np.min(distances)\n\n      if min_workshop_distance < min_distance:\n          min_distance = min_workshop_distance\n          closest_workshop_idx = workshop_idx\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Find the nearest position among all workshops of the chosen type\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda x: np.linalg.norm(x - current_pos))\n\n  # Move towards the nearest workshop position\n  while not np.array_equal(current_pos, nearest_target_pos):\n      action = get_action(current_pos, nearest_target_pos)\n      actions.append(action)\n\n      if action == 3:\n          current_pos[0] += 1\n      elif action == 2:\n          current_pos[0] -= 1\n      elif action == 1:\n          current_pos[1] += 1\n      else:\n          current_pos[1] -= 1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE action\n\n  return actions", "island_id": 6, "scores": {"3": 4.7}}
{"timestamp": "2025-09-10T01:45:15.055757", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  min_distance, closest_workshop_idx = float('inf'), None\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Get all positions of workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) == 0:  # Skip if there are no locations for the workshop\n          continue\n\n      # Find the nearest workshop position to current position\n      nearest_workshop_pos = min(\n          workshop_pos_list, \n          key=lambda x: np.linalg.norm(x - pos)\n      )\n      \n      distance_to_nearest_workshop = np.linalg.norm(nearest_workshop_pos - pos)\n      \n      if distance_to_nearest_workshop < min_distance:\n          closest_workshop_idx = workshop_idx\n          min_distance = distance_to_nearest_workshop\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the direction to move towards the nearest workshop position\n  nearest_target_pos = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])[0]\n  dx, dy = nearest_target_pos - pos\n  path_x = np.sign(dx)\n  path_y = np.sign(dy)\n\n  # Move towards the nearest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += path_x\n          dx -= path_x\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += path_y\n          dy -= path_y\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 6, "scores": {"3": 4.7}}
{"timestamp": "2025-09-10T01:46:45.940140", "function_name": "craft", "function_body": "  def navigate_to(target_pos):\n      pos = np.array(env._current_state.pos)\n      actions = []\n      \n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n      \n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  actions = []\n\n  # Determine the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_positions) > 0:  # Ensure there's at least one of this workshop type\n          workshop_mean_pos = workshop_positions.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_mean_pos, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Determine the nearest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda p: np.linalg.norm(pos - p))\n\n  # Navigate to the nearest workshop position\n  actions.extend(navigate_to(nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": 4.7}}
