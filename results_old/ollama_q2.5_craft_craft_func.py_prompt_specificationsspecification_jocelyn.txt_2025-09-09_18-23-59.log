{"timestamp": "2025-09-09T20:30:38.833649", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position using A* algorithm\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal):\n      open_set = collections.PriorityQueue()\n      open_set.put((0, start))\n      came_from = {}\n      g_score = {tuple(pos): float('inf') for pos in np.argwhere(env._current_state.grid > 0)}\n      g_score[tuple(start)] = 0\n      f_score = {tuple(pos): float('inf') for pos in np.argwhere(env._current_state.grid > 0)}\n      f_score[tuple(start)] = heuristic(start, goal)\n\n      while not open_set.empty():\n          _, current = open_set.get()\n          if np.array_equal(current, goal):\n              path = []\n              while tuple(current) in came_from:\n                  path.append(tuple(current))\n                  current = came_from[tuple(current)]\n              return path[::-1]\n\n          for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n              neighbor = current + np.array([dx, dy])\n              tentative_g_score = g_score[tuple(current)] + 1\n\n              if tuple(neighbor) not in g_score or tentative_g_score < g_score[tuple(neighbor)]:\n                  came_from[tuple(neighbor)] = current\n                  g_score[tuple(neighbor)] = tentative_g_score\n                  f_score[tuple(neighbor)] = tentative_g_score + heuristic(neighbor, goal)\n                  open_set.put((f_score[tuple(neighbor)], neighbor))\n\n      return None\n\n  path = a_star(pos, nearest_target_pos)\n  if path is not None:\n      for next_pos in path[1:]:\n          dx, dy = next_pos - pos\n          direction = None\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              direction = 3 if dx > 0 else 2\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              direction = 1 if dy > 0 else 0\n              pos[1] += 1 if dy > 0 else -1\n          \n          actions.append(direction)\n\n      # Use the workshop to craft the item\n      actions.append(4)  # USE\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-09T20:32:03.441016", "function_name": "craft", "function_body": "  def find_closest_workshop(item_index, pos):\n      min_distance = float('inf')\n      closest_workshop_idx = None\n      nearest_target_pos = None\n\n      for workshop_idx in env.world.workshop_indices:\n          # Calculate all positions of this type of workshop\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n          if len(workshop_pos_list) == 0:  # Skip if no workshops are found\n              continue\n\n          # Find the nearest workshop to the current position\n          for workshop_pos in workshop_pos_list:\n              distance = np.linalg.norm(pos - workshop_pos, ord=2)\n              if distance < min_distance:\n                  closest_workshop_idx = workshop_idx\n                  nearest_target_pos = workshop_pos\n                  min_distance = distance\n\n      return closest_workshop_idx, nearest_target_pos, min_distance\n  \n  def move_to_position(current_pos, target_pos):\n      actions = []\n      dx, dy = target_pos - current_pos\n\n      # Determine direction to move in\n      while not np.array_equal(current_pos, target_pos):\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              current_pos[0] += 1 if dx > 0 else -1\n              dx = target_pos[0] - current_pos[0]\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              current_pos[1] += 1 if dy > 0 else -1\n              dy = target_pos[1] - current_pos[1]\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, nearest_target_pos, min_distance = find_closest_workshop(goal_index, pos)\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  actions.extend(move_to_position(pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 2, "scores": {"3": 4.7}}
{"timestamp": "2025-09-09T20:32:04.571686", "function_name": "craft", "function_body": "  def find_closest_workshop(item_index, pos):\n      min_distance = float('inf')\n      closest_workshop_idx = None\n      nearest_target_pos = None\n\n      for workshop_idx in env.world.workshop_indices:\n          # Calculate all positions of this type of workshop\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n          if len(workshop_pos_list) == 0:  # Skip if no workshops are found\n              continue\n\n          # Find the nearest workshop to the current position\n          for workshop_pos in workshop_pos_list:\n              distance = np.linalg.norm(pos - workshop_pos, ord=2)\n              if distance < min_distance:\n                  closest_workshop_idx = workshop_idx\n                  nearest_target_pos = workshop_pos\n                  min_distance = distance\n\n      return closest_workshop_idx, nearest_target_pos, min_distance\n\n  def move_to_position(current_pos, target_pos):\n      actions = []\n      while not np.array_equal(current_pos, target_pos):\n          dx, dy = target_pos - current_pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              current_pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              current_pos[1] += 1 if dy > 0 else -1\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, nearest_target_pos, min_distance = find_closest_workshop(goal_index, pos)\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  actions = move_to_position(pos, nearest_target_pos)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 2, "scores": {"3": 4.7}}
{"timestamp": "2025-09-09T20:33:18.788575", "function_name": "craft", "function_body": "  def move_to_position(current_pos, target_pos):\n      actions = []\n      while not np.array_equal(current_pos, target_pos):\n          dx, dy = target_pos - current_pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              current_pos[0] += 1 if dx > 0 else -1\n          elif dy != 0:\n              actions.append(1 if dy > 0 else 0)\n              current_pos[1] += 1 if dy > 0 else -1\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  target_workshops = {}\n  \n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          distances = np.linalg.norm(workshop_pos_list - pos, axis=1)\n          min_distance = distances.min()\n          nearest_target_pos = workshop_pos_list[distances.argmin()]\n          target_workshops[workshop_idx] = (min_distance, nearest_target_pos)\n\n  if not target_workshops:\n      raise ValueError(\"No available workshop found\")\n\n  # Find the closest workshop\n  closest_workshop_idx, (_, nearest_target_pos) = min(target_workshops.items(), key=lambda x: x[1][0])\n\n  # Move to the closest workshop position\n  actions.extend(move_to_position(pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 3, "scores": {"3": 4.7}}
