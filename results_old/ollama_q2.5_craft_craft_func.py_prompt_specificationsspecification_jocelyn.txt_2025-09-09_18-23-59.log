{"timestamp": "2025-09-10T07:13:57.027061", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Calculate the direction to face the workshop\n  target_direction = np.arctan2(nearest_target_pos[1] - pos[1], nearest_target_pos[0] - nearest_target_pos[0]) * 180 / np.pi\n  current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n  \n  if target_direction < 0:\n      target_direction += 360\n\n  # Calculate the difference in direction\n  delta_direction = (target_direction - current_direction + 360) % 360\n  \n  # Adjust direction to face the workshop\n  while delta_direction > 180 or delta_direction != 0:\n      if delta_direction > 180:\n          actions.append(2 if env._current_state.dir == 3 else 3)\n          env._current_state.dir = (env._current_state.dir + 1) % 4\n      elif delta_direction < 180 and delta_direction != 0:\n          actions.append(2 if env._current_state.dir == 0 else 3)\n          env._current_state.dir = (env._current_state.dir - 1) % 4\n      \n      target_direction = np.arctan2(nearest_target_pos[1] - pos[1], nearest_target_pos[0] - nearest_target_pos[0]) * 180 / np.pi\n      current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n      \n      if target_direction < 0:\n          target_direction += 360\n      \n      delta_direction = (target_direction - current_direction + 360) % 360\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 5, "scores": {"3": 5.0}}
{"timestamp": "2025-09-10T07:18:57.093221", "function_name": "craft", "function_body": "  def calculate_angle(current_pos: np.ndarray, target_pos: np.ndarray) -> float:\n      delta_x = target_pos[0] - current_pos[0]\n      delta_y = target_pos[1] - current_pos[1]\n      return np.arctan2(delta_y, delta_x) * (180 / np.pi)\n\n  def calculate_direction(angle: float) -> int:\n      if angle < 45 or angle >= 315:\n          return 1  # UP\n      elif 45 <= angle < 135:\n          return 3  # RIGHT\n      elif 135 <= angle < 225:\n          return 0  # DOWN\n      else:  # 225 <= angle < 315\n          return 2  # LEFT\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  actions = []\n  current_pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(current_pos - workshop_pos_mean, ord=2)\n\n          if distance < min_distance:\n              closest_workshop_idx = workshop_idx\n              min_distance = distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(current_pos - target_pos, ord=2)\n\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(current_pos, nearest_target_pos):\n      target_angle = calculate_angle(current_pos, nearest_target_pos)\n      current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n      \n      if target_angle < 0:\n          target_angle += 360\n\n      delta_direction = (target_angle - current_direction + 360) % 360\n      \n      # Adjust direction to face the workshop\n      while delta_direction > 180 or delta_direction != 0:\n          if delta_direction > 180:\n              actions.append(2 if env._current_state.dir == 3 else 3)\n              env._current_state.dir = (env._current_state.dir + 1) % 4\n          elif delta_direction < 180 and delta_direction != 0:\n              actions.append(2 if env._current_state.dir == 0 else 3)\n              env._current_state.dir = (env._current_state.dir - 1) % 4\n      \n          current_pos = np.array(env._current_state.pos)\n          target_angle = calculate_angle(current_pos, nearest_target_pos)\n          current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n      \n          if target_angle < 0:\n              target_angle += 360\n      \n          delta_direction = (target_angle - current_direction + 360) % 360\n\n      # Move towards the workshop\n      direction_to_move = calculate_direction(target_angle)\n      actions.append(direction_to_move)\n\n      # Update the agent's position\n      if direction_to_move == 1:  # UP\n          current_pos[1] += 1\n      elif direction_to_move == 3:  # RIGHT\n          current_pos[0] += 1\n      elif direction_to_move == 0:  # DOWN\n          current_pos[1] -= 1\n      else:  # LEFT\n          current_pos[0] -= 1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-10T07:22:14.567589", "function_name": "craft", "function_body": "  def get_direction_to_move(dx, dy):\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          return 3 if dx > 0 else 2\n      else:  # Then move in y-direction\n          return 1 if dy > 0 else 0\n\n  def calculate_angle(pos, target_pos):\n      \"\"\"Calculate the angle between current position and target position.\"\"\"\n      dx = target_pos[0] - pos[0]\n      dy = target_pos[1] - pos[1]\n      angle = np.arctan2(dy, dx) * 180 / np.pi\n      if angle < 0:\n          angle += 360\n      return angle\n\n  def calculate_direction_from_angle(angle):\n      \"\"\"Map angle to the nearest direction (0: UP, 1: DOWN, 2: LEFT, 3: RIGHT).\"\"\"\n      directions = [90, -90, 180, 0]  # UP, DOWN, LEFT, RIGHT\n      direction_angles = [(d - 22.5) % 360 for d in directions]\n      direction_angles.append((direction_angles[0] + 360) % 360)  # Handle wrap-around for UP\n\n      min_angle_diff = float('inf')\n      best_direction = None\n      for i, da in enumerate(direction_angles):\n          angle_diff = abs(angle - da)\n          if angle_diff < min_angle_diff:\n              min_angle_diff = angle_diff\n              best_direction = i % 4\n      return best_direction\n\n  def rotate_towards_target(current_dir, target_angle):\n      \"\"\"Generate rotation actions to face the target angle.\"\"\"\n      current_angle = {0: 90, 1: 0, 2: 270, 3: 180}[current_dir]\n      delta_angle = (target_angle - current_angle + 360) % 360\n      actions = []\n\n      if delta_angle < 180:\n          while abs((current_angle - target_angle + 360) % 360) > 5:  # Rotate counterclockwise\n              actions.append(2 if current_dir == 0 else 3)\n              current_dir = (current_dir - 1) % 4\n              current_angle = {0: 90, 1: 0, 2: 270, 3: 180}[current_dir]\n      elif delta_angle > 180:\n          while abs((current_angle - target_angle + 360) % 360) > 5:  # Rotate clockwise\n              actions.append(2 if current_dir == 3 else 3)\n              current_dir = (current_dir + 1) % 4\n              current_angle = {0: 90, 1: 0, 2: 270, 3: 180}[current_dir]\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate positions of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          for workshop_pos in workshop_pos_list:\n              distance = np.linalg.norm(pos - workshop_pos, ord=2)\n              if distance < min_distance:\n                  closest_workshop_idx, min_distance, nearest_target_pos = workshop_idx, distance, workshop_pos\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda x: np.linalg.norm(pos - x))\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      direction = get_direction_to_move(dx, dy)\n      actions.append(direction)\n\n      # Update position\n      if direction == 0:\n          pos[1] -= 1\n      elif direction == 1:\n          pos[1] += 1\n      elif direction == 2:\n          pos[0] -= 1\n      else:  # direction == 3\n          pos[0] += 1\n\n  # Calculate the angle to face towards the workshop\n  target_angle = calculate_angle(pos, nearest_target_pos)\n\n  # Orient the agent towards the workshop\n  actions.extend(rotate_towards_target(env._current_state.dir, target_angle))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 1, "scores": {"3": 5.0}}
{"timestamp": "2025-09-10T07:22:15.710833", "function_name": "craft", "function_body": "  def get_direction_to_move(dx, dy):\n      \"\"\"Determine the direction to move based on differences in x and y.\"\"\"\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          return 3 if dx > 0 else 2\n      else:  # Then move in y-direction\n          return 1 if dy > 0 else 0\n\n  def calculate_angle(pos, target_pos):\n      \"\"\"Calculate the angle between current position and target position.\"\"\"\n      dx = target_pos[0] - pos[0]\n      dy = target_pos[1] - pos[1]\n      angle = np.arctan2(dy, dx) * 180 / np.pi\n      if angle < 0:\n          angle += 360\n      return angle\n\n  def calculate_direction_from_angle(angle):\n      \"\"\"Map angle to the nearest direction (0: UP, 1: DOWN, 2: LEFT, 3: RIGHT).\"\"\"\n      directions = [90, -90, 180, 0]  # UP, DOWN, LEFT, RIGHT\n      direction_angles = [(d - 45) % 360 for d in directions]\n      direction_angles.append((direction_angles[0] + 360) % 360)  # Handle wrap-around for UP\n\n      min_angle_diff = float('inf')\n      best_direction = None\n      for i, da in enumerate(direction_angles):\n          angle_diff = abs(angle - da)\n          if angle_diff < min_angle_diff:\n              min_angle_diff = angle_diff\n              best_direction = i % 4\n      return best_direction\n\n  def rotate_towards_target(current_dir, target_angle):\n      \"\"\"Generate rotation actions to face the target angle.\"\"\"\n      current_angle = {0: 90, 1: 0, 2: 270, 3: 180}[current_dir]\n      delta_angle = (target_angle - current_angle + 360) % 360\n      actions = []\n\n      if delta_angle < 180:\n          while abs((current_angle - target_angle + 360) % 360) > 5:  # Rotate counterclockwise\n              actions.append(2 if current_dir == 0 else 3)\n              current_dir = (current_dir - 1) % 4\n              current_angle = {0: 90, 1: 0, 2: 270, 3: 180}[current_dir]\n      elif delta_angle > 180:\n          while abs((current_angle - target_angle + 360) % 360) > 5:  # Rotate clockwise\n              actions.append(2 if current_dir == 3 else 3)\n              current_dir = (current_dir + 1) % 4\n              current_angle = {0: 90, 1: 0, 2: 270, 3: 180}[current_dir]\n      return actions\n\n  def find_closest_workshop(env, goal_index):\n      \"\"\"Find the closest workshop that can craft the desired item.\"\"\"\n      cookbook = env.world.cookbook\n      workshop_indices = env.world.workshop_indices\n      pos = np.array(env._current_state.pos)\n      closest_workshop_idx, min_distance = None, float('inf')\n\n      # Iterate over each type of workshop\n      for workshop_idx in workshop_indices:\n          # Get positions of all workshops of this type\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n          if len(workshop_pos_list) > 0:  # Check if there are any locations for the workshop\n              for workshop_pos in workshop_pos_list:\n                  distance = np.linalg.norm(pos - workshop_pos, ord=2)\n                  if distance < min_distance:\n                      closest_workshop_idx, min_distance, nearest_target_pos = workshop_idx, distance, workshop_pos\n\n      if closest_workshop_idx is None:\n          raise ValueError(\"No available workshop found\")\n\n      # Get all positions of the closest workshop type\n      target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n      nearest_target_pos = min(target_positions, key=lambda x: np.linalg.norm(pos - x))\n      \n      return nearest_target_pos\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  nearest_target_pos = find_closest_workshop(env, goal_index)\n  \n  pos = np.array(env._current_state.pos)\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      direction = get_direction_to_move(dx, dy)\n      actions.append(direction)\n\n      # Update position\n      if direction == 0:\n          pos[1] -= 1\n      elif direction == 1:\n          pos[1] += 1\n      elif direction == 2:\n          pos[0] -= 1\n      else:  # direction == 3\n          pos[0] += 1\n\n  # Calculate the angle to face towards the workshop\n  target_angle = calculate_angle(pos, nearest_target_pos)\n\n  # Orient the agent towards the workshop\n  actions.extend(rotate_towards_target(env._current_state.dir, target_angle))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 1, "scores": {"3": 5.0}}
{"timestamp": "2025-09-10T07:24:32.470871", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n      # Orient the agent towards the workshop (optional, might not be necessary)\n      direction_to_workshop = np.arctan2(nearest_target_pos[1] - pos[1], nearest_target_pos[0] - pos[0]) * 180 / np.pi\n      current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n      \n      if direction_to_workshop < 0:\n          direction_to_workshop += 360\n\n      # Calculate the difference in direction\n      delta_direction = (direction_to_workshop - current_direction + 360) % 360\n      \n      if delta_direction > 180:\n          actions.append(2 if env._current_state.dir == 3 else 3)\n          env._current_state.dir = (env._current_state.dir + 1) % 4\n      elif delta_direction < 180 and delta_direction != 0:\n          actions.append(2 if env._current_state.dir == 0 else 3)\n          env._current_state.dir = (env._current_state.dir - 1) % 4\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 1, "scores": {"3": 1.0}}
