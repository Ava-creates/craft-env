{"timestamp": "2025-09-11T01:50:05.214414", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest available workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  nearest_workshop_pos = None\n  min_distance = float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_positions) == 0:  # Skip this workshop type if no location found\n          continue\n\n      for workshop_pos in workshop_positions:\n          distance = np.linalg.norm(pos - workshop_pos, ord=2)\n          if distance < min_distance:\n              nearest_workshop_pos = workshop_pos\n              min_distance = distance\n\n  if nearest_workshop_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_workshop_pos):\n      dx, dy = nearest_workshop_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Optionally orient the agent towards the workshop (optional, might not be necessary)\n\n  direction_to_workshop = np.arctan2(nearest_workshop_pos[1] - pos[1], nearest_workshop_pos[0] - pos[0]) * 180 / np.pi\n  current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n  \n  if direction_to_workshop < 0:\n      direction_to_workshop += 360\n\n  # Calculate the difference in direction\n  delta_direction = (direction_to_workshop - current_direction + 360) % 360\n  \n  while delta_direction > 180 or delta_direction != 0:\n      if delta_direction > 180:\n          actions.append(2 if env._current_state.dir == 3 else 3)\n          env._current_state.dir = (env._current_state.dir + 1) % 4\n      elif delta_direction < 180 and delta_direction != 0:\n          actions.append(2 if env._current_state.dir == 0 else 3)\n          env._current_state.dir = (env._current_state.dir - 1) % 4\n\n      # Recalculate direction_to_workshop and delta_direction\n      direction_to_workshop = np.arctan2(nearest_workshop_pos[1] - pos[1], nearest_workshop_pos[0] - pos[0]) * 180 / np.pi\n      if direction_to_workshop < 0:\n          direction_to_workshop += 360\n      delta_direction = (direction_to_workshop - current_direction + 360) % 360\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-11T01:53:01.060545", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest available workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  \n  min_distance = float('inf')\n  nearest_workshop_pos = None\n  \n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(workshop_pos_list) == 0:  # Skip this workshop type if no location found\n          continue\n      \n      for target_pos in workshop_pos_list:\n          distance = np.linalg.norm(pos - target_pos, ord=2)\n          \n          if distance < min_distance:\n              min_distance = distance\n              nearest_workshop_pos = target_pos\n\n  if nearest_workshop_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate path to the closest workshop position using A* search algorithm\n  start_node = (pos[0], pos[1])\n  end_node = (nearest_workshop_pos[0], nearest_workshop_pos[1])\n\n  def heuristic(node, goal):\n    return np.linalg.norm(np.array(node) - np.array(goal), ord=2)\n\n  open_set = []\n  closed_set = set()\n  g_costs = {start_node: 0}\n  f_costs = {start_node: heuristic(start_node, end_node)}\n  came_from = {}\n\n  open_set.append((f_costs[start_node], start_node))\n\n  while open_set:\n    _, current_node = open_set.pop(0)\n\n    if current_node == end_node:\n      path = []\n      while current_node in came_from:\n        path.append(current_node)\n        current_node = came_from[current_node]\n      path.reverse()\n      break\n\n    closed_set.add(current_node)\n\n    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n      neighbor = (current_node[0] + dx, current_node[1] + dy)\n      \n      if not (0 <= neighbor[0] < env._current_state.grid.shape[0] and 0 <= neighbor[1] < env._current_state.grid.shape[1]):\n        continue\n      \n      if any(env._current_state.grid[neighbor[0], neighbor[1], block_type] for block_type in range(len(env.world.cookbook.index))):\n        continue\n\n      tentative_g_cost = g_costs[current_node] + 1\n      \n      if neighbor not in g_costs or tentative_g_cost < g_costs[neighbor]:\n        came_from[neighbor] = current_node\n        g_costs[neighbor] = tentative_g_cost\n        f_costs[neighbor] = tentative_g_cost + heuristic(neighbor, end_node)\n        \n        if neighbor not in closed_set:\n          open_set.append((f_costs[neighbor], neighbor))\n          open_set.sort(key=lambda x: x[0])\n\n  else:\n      raise ValueError(\"No path found to the workshop\")\n\n  # Convert path to actions\n  for next_node in path[1:]:\n    dx, dy = next_node[0] - pos[0], next_node[1] - pos[1]\n\n    if dx > 0:\n        actions.append(3)  # RIGHT\n    elif dx < 0:\n        actions.append(2)  # LEFT\n    elif dy > 0:\n        actions.append(1)  # UP\n    else:  # dy < 0\n        actions.append(0)  # DOWN\n\n    pos[0], pos[1] = next_node\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-11T01:53:02.125428", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest available workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  \n  min_distance = float('inf')\n  nearest_workshop_pos = None\n  \n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(workshop_pos_list) == 0:  # Skip this workshop type if no location found\n          continue\n      \n      for target_pos in workshop_pos_list:\n          distance = np.linalg.norm(pos - target_pos, ord=1)  # Use Manhattan distance for grid-based movement\n\n          if distance < min_distance:\n              min_distance = distance\n              nearest_workshop_pos = target_pos\n\n  if nearest_workshop_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position using A* algorithm for optimal pathfinding\n  start_pos = tuple(pos)\n  end_pos = tuple(nearest_workshop_pos)\n\n  def heuristic(a, b):\n      return np.linalg.norm(np.array(a) - np.array(b), ord=1)\n\n  def a_star(start, goal):\n      open_set = collections.PriorityQueue()\n      open_set.put((0, start))\n      came_from = {}\n      g_score = {start: 0}\n      f_score = {start: heuristic(start, goal)}\n\n      while not open_set.empty():\n          _, current = open_set.get()\n\n          if current == goal:\n              path = []\n              while current in came_from:\n                  path.append(current)\n                  current = came_from[current]\n              path.reverse()\n              return path\n\n          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n\n              tentative_g_score = g_score[current] + heuristic(current, neighbor)\n\n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                  open_set.put((f_score[neighbor], neighbor))\n\n      return None\n\n  path = a_star(start_pos, end_pos)\n\n  if path is None:\n      raise ValueError(\"No valid path found to the workshop\")\n\n  # Convert the path into actions\n  for i in range(len(path) - 1):\n      dx, dy = path[i + 1][0] - path[i][0], path[i + 1][1] - path[i][1]\n      \n      if dx == 1:\n          actions.append(3)  # RIGHT\n      elif dx == -1:\n          actions.append(2)  # LEFT\n      elif dy == 1:\n          actions.append(1)  # UP\n      elif dy == -1:\n          actions.append(0)  # DOWN\n\n  # Optionally orient the agent towards the workshop (optional, might not be necessary)\n\n  direction_to_workshop = np.arctan2(nearest_workshop_pos[1] - pos[1], nearest_workshop_pos[0] - pos[0]) * 180 / np.pi\n  current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n  \n  if direction_to_workshop < 0:\n      direction_to_workshop += 360\n\n  # Calculate the difference in direction\n  delta_direction = (direction_to_workshop - current_direction + 360) % 360\n  \n  while delta_direction > 180:\n      actions.append(2 if env._current_state.dir == 3 else 3)\n      env._current_state.dir = (env._current_state.dir + 1) % 4\n      direction_to_workshop = np.arctan2(nearest_workshop_pos[1] - pos[1], nearest_workshop_pos[0] - pos[0]) * 180 / np.pi\n      current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n      delta_direction = (direction_to_workshop - current_direction + 360) % 360\n\n  while delta_direction < 180 and delta_direction != 0:\n      actions.append(2 if env._current_state.dir == 0 else 3)\n      env._current_state.dir = (env._current_state.dir - 1) % 4\n      direction_to_workshop = np.arctan2(nearest_workshop_pos[1] - pos[1], nearest_workshop_pos[0] - pos[0]) * 180 / np.pi\n      current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n      delta_direction = (direction_to_workshop - current_direction + 360) % 360\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
