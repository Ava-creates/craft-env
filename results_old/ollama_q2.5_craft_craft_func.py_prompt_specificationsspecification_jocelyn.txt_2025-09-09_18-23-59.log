ction)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 5, "scores": {"3": 4.7}}
{"timestamp": "2025-09-09T21:05:13.836025", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n\n  # Check all recipes to find which workshop type is required for the goal item\n  workshop_type_required = None\n  for output, recipe in cookbook.recipes.items():\n      if goal_index == output:\n          for ingredient, count in recipe.items():\n              if \"_key\" not in ingredient:  # Check only ingredients, not keys\n                  ingredient_index = int(ingredient)\n                  if ingredient_index in workshop_indices:\n                      workshop_type_required = ingredient_index\n                      break\n          if workshop_type_required is not None:\n              break\n\n  if workshop_type_required is None:\n      raise ValueError(\"No suitable workshop found for crafting the item\")\n\n  # Calculate the closest position of the required type of workshop to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, workshop_type_required])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  if nearest_target_pos is None:\n      raise ValueError(\"No available workshop position found\")\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      direction = None\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          direction = 3 if dx > 0 else 2\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          direction = 1 if dy > 0 else 0\n          pos[1] += 1 if dy > 0 else -1\n      \n      actions.append(direction)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-09T21:07:37.278170", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Orient the agent towards the workshop (optional, might not be necessary)\n  direction_to_workshop = np.arctan2(nearest_target_pos[1] - pos[1], nearest_target_pos[0] - nearest_target_pos[0]) * 180 / np.pi\n  current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n  \n  if direction_to_workshop < 0:\n      direction_to_workshop += 360\n\n  # Calculate the difference in direction\n  delta_direction = (direction_to_workshop - current_direction + 360) % 360\n  \n  if delta_direction > 180:\n      actions.append(2 if env._current_state.dir == 3 else 3)\n      env._current_state.dir = (env._current_state.dir + 1) % 4\n  elif delta_direction < 180 and delta_direction != 0:\n      actions.append(2 if env._current_state.dir == 0 else 3)\n      env._current_state.dir = (env._current_state.dir - 1) % 4\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 4, "scores": {"3": 5.0}}
{"timestamp": "2025-09-09T21:12:37.355713", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      direction_to_move = (np.arctan2(dy, dx) * 180 / np.pi + 360) % 360\n\n      # Determine the closest direction to move in\n      if direction_to_move < 45 or direction_to_move >= 315:\n          actions.append(3)  # RIGHT\n      elif 45 <= direction_to_move < 135:\n          actions.append(1)  # DOWN\n      elif 135 <= direction_to_move < 225:\n          actions.append(2)  # LEFT\n      else:  # 225 <= direction_to_move < 315\n          actions.append(0)  # UP\n\n      pos += np.array([dx > 0, dy > 0]).astype(int)\n\n  # Orient the agent towards the workshop (optional)\n  direction_to_workshop = np.arctan2(nearest_target_pos[1] - pos[1], nearest_target_pos[0] - pos[0]) * 180 / np.pi\n  current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n  \n  if direction_to_workshop < 0:\n      direction_to_workshop += 360\n\n  # Calculate the difference in direction\n  delta_direction = (direction_to_workshop - current_direction + 360) % 360\n  \n  if delta_direction > 180:\n      actions.append(2 if env._current_state.dir == 3 else 3)\n      env._current_state.dir = (env._current_state.dir + 1) % 4\n  elif delta_direction < 180 and delta_direction != 0:\n      actions.append(2 if env._current_state.dir == 0 else 3)\n      env._current_state.dir = (env._current_state.dir - 1) % 4\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-09T21:13:58.953728", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  \n  # Calculate distances from current position to all workshops\n  target_workshops = []\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          distances = [(np.linalg.norm(pos - wp, ord=2), idx, wp) for idx, wp in enumerate(workshop_pos_list)]\n          target_workshops.extend(distances)\n  \n  if not target_workshops:\n      raise ValueError(\"No available workshop found\")\n  \n  # Find the nearest target position among all workshops\n  nearest_target_distance, _, nearest_target_pos = min(target_workshops, key=lambda x: x[0])\n  \n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 8, "scores": {"3": 4.7}}
{"timestamp": "2025-09-09T21:14:00.090142", "function_name": "craft", "function_body": "  def get_direction(dx: int, dy: int):\n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      else:\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  target_workshops = []\n  \n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          target_workshops.extend([(workshop_pos, workshop_idx) for workshop_pos in workshop_pos_list])\n  \n  if not target_workshops:\n      raise ValueError(\"No available workshop found\")\n  \n  # Find the nearest target position among all workshops\n  nearest_target = min(target_workshops, key=lambda x: np.linalg.norm(pos - x[0], ord=2))\n  nearest_target_pos, closest_workshop_idx = nearest_target\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      direction = get_direction(dx, dy)\n      actions.append(direction)\n      \n      # Update position based on the action taken\n      if direction == 0:\n          pos[1] -= 1\n      elif direction == 1:\n          pos[1] += 1\n      elif direction == 2:\n          pos[0] -= 1\n      else:  # direction == 3\n          pos[0] += 1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 8, "scores": {"3": 4.7}}
{"timestamp": "2025-09-09T21:15:21.316511", "function_name": "craft", "function_body": "  def move_to_position(current_pos, target_pos):\n      actions = []\n      while not np.array_equal(current_pos, target_pos):\n          dx, dy = target_pos - current_pos\n          direction = None\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              direction = 3 if dx > 0 else 2\n              current_pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              direction = 1 if dy > 0 else 0\n              current_pos[1] += 1 if dy > 0 else -1\n          \n          actions.append(direction)\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  actions.extend(move_to_position(pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 5, "scores": {"3": 4.7}}
{"timestamp": "2025-09-09T21:15:22.450565", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Check if there is any location for the workshop\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  \n          # Find the nearest workshop position to the current position\n          distances = np.linalg.norm(workshop_pos_list - pos, axis=1)\n          closest_workshop_pos = workshop_pos_list[np.argmin(distances)]\n          distance = np.linalg.norm(closest_workshop_pos - pos, ord=2)\n\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the nearest workshop position\n  target_pos = closest_workshop_pos\n  while not np.array_equal(pos, target_pos):\n      dx, dy = target_pos - pos\n      direction = None\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          direction = 3 if dx > 0 else 2\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          direction = 1 if dy > 0 else 0\n          pos[1] += 1 if dy > 0 else -1\n      \n      actions.append(direction)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 5, "scores": {"3": 4.7}}
{"timestamp": "2025-09-09T21:22:23.787699", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda p: np.linalg.norm(pos - p))\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      direction = None\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          direction = (3 if dx > 0 else 2)\n      else:  # Then move in y-direction\n          direction = (1 if dy > 0 else 0)\n\n      actions.append(direction)\n      pos += np.array([1, 0]) if direction == 3 else\\\n             np.array([-1, 0]) if direction == 2 else\\\n             np.array([0, 1]) if direction == 1 else\\\n             np.array([0, -1])\n\n  # Ensure the agent is facing the workshop\n  dx, dy = nearest_target_pos - pos\n\n  if abs(dx) > abs(dy):\n      target_direction = (3 if dx > 0 else 2)\n  else:\n      target_direction = (1 if dy > 0 else 0)\n\n  while env._current_state.pos[0] + np.array([1, 0])[0] * (target_direction == 3) + np.array([-1, 0])[0] * (\n          target_direction == 2) != nearest_target_pos[0]:\n      actions.append(target_direction)\n  \n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-09T21:27:23.929138", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda p: np.linalg.norm(pos - p))\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      direction = None\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          direction = (3 if dx > 0 else 2)\n      else:  # Then move in y-direction\n          direction = (1 if dy > 0 else 0)\n\n      actions.append(direction)\n      pos += np.array([1, 0]) if direction == 3 else\\\n             np.array([-1, 0]) if direction == 2 else\\\n             np.array([0, 1]) if direction == 1 else\\\n             np.array([0, -1])\n\n  # Ensure the agent faces the correct direction before using the workshop\n  target_direction = np.sign(nearest_target_pos - pos)\n  current_direction = np.array([1 if env._current_state.pos[0] < nearest_target_pos[0] else -1,\n                                1 if env._current_state.pos[1] < nearest_target_pos[1] else -1])\n\n  while not np.array_equal(target_direction, current_direction):\n      direction_change_action = None\n      if target_direction[0] != current_direction[0]:\n          direction_change_action = (3 if target_direction[0] > 0 else 2)\n      elif target_direction[1] != current_direction[1]:\n          direction_change_action = (1 if target_direction[1] > 0 else 0)\n\n      actions.append(direction_change_action)\n      current_direction = np.array([1 if env._current_state.pos[0] < nearest_target_pos[0] else -1,\n                                    1 if env._current_state.pos[1] < nearest_target_pos[1] else -1])\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
