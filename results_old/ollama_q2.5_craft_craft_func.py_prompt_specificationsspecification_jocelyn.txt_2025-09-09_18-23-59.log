rient the agent towards the workshop (optional, might not be necessary)\n  direction_to_workshop = np.arctan2(nearest_target_pos[1] - pos[1], nearest_target_pos[0] - pos[0]) * 180 / np.pi\n  current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n  \n  if direction_to_workshop < 0:\n      direction_to_workshop += 360\n\n  # Calculate the difference in direction\n  delta_direction = (direction_to_workshop - current_direction + 360) % 360\n  \n  if delta_direction > 180:\n      actions.append(2 if env._current_state.dir == 3 else 3)\n      env._current_state.dir = (env._current_state.dir + 1) % 4\n  elif delta_direction < 180 and delta_direction != 0:\n      actions.append(2 if env._current_state.dir == 0 else 3)\n      env._current_state.dir = (env._current_state.dir - 1) % 4\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 2, "scores": {"3": 5.0}}
{"timestamp": "2025-09-11T03:52:07.729068", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Orient the agent towards the workshop (optional, might not be necessary)\n  direction_to_workshop = np.arctan2(nearest_target_pos[1] - pos[1], nearest_target_pos[0] - nearest_target_pos[0]) * 180 / np.pi\n  current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n  \n  if direction_to_workshop < 0:\n      direction_to_workshop += 360\n\n  # Calculate the difference in direction\n  delta_direction = (direction_to_workshop - current_direction + 360) % 360\n  \n  if delta_direction > 180:\n      actions.append(2 if env._current_state.dir == 3 else 3)\n      env._current_state.dir = (env._current_state.dir + 1) % 4\n  elif delta_direction < 180 and delta_direction != 0:\n      actions.append(2 if env._current_state.dir == 0 else 3)\n      env._current_state.dir = (env._current_state.dir - 1) % 4\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 5, "scores": {"3": 5.0}}
{"timestamp": "2025-09-11T03:52:08.859660", "function_name": "craft", "function_body": "  def move_to_position(pos, target_pos):\n      actions = []\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda x: np.linalg.norm(pos - x))\n\n  actions.extend(move_to_position(pos, nearest_target_pos))\n  \n  # Orient the agent towards the workshop (optional, might not be necessary)\n  direction_to_workshop = np.arctan2(nearest_target_pos[1] - pos[1], nearest_target_pos[0] - pos[0]) * 180 / np.pi\n  current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n  \n  if direction_to_workshop < 0:\n      direction_to_workshop += 360\n\n  # Calculate the difference in direction\n  delta_direction = (direction_to_workshop - current_direction + 360) % 360\n  \n  if delta_direction > 180:\n      actions.append(2 if env._current_state.dir == 3 else 3)\n      env._current_state.dir = (env._current_state.dir + 1) % 4\n  elif delta_direction < 180 and delta_direction != 0:\n      actions.append(2 if env._current_state.dir == 0 else 3)\n      env._current_state.dir = (env._current_state.dir - 1) % 4\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 5, "scores": {"3": 5.0}}
{"timestamp": "2025-09-11T03:54:51.290296", "function_name": "craft", "function_body": "  def get_closest_workshop_position(pos, workshop_indices):\n      min_distance = float('inf')\n      nearest_target_pos = None\n      \n      for workshop_idx in workshop_indices:\n          # Calculate the mean position of all workshops of this type\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              for target_pos in workshop_pos_list:\n                  dist_to_target = np.linalg.norm(pos - target_pos, ord=2)\n                  if dist_to_target < min_distance:\n                      nearest_target_pos = target_pos\n                      min_distance = dist_to_target\n      \n      return nearest_target_pos\n\n  def get_directional_action(dx, dy):\n      \"\"\"Determine the action to move in based on dx and dy.\"\"\"\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          return 3 if dx > 0 else 2\n      else:  # Then move in y-direction\n          return 1 if dy > 0 else 0\n\n  def rotate_to_face_target(current_pos, target_pos):\n      \"\"\"Calculate the actions needed to orient the agent towards the target position.\"\"\"\n      direction_to_workshop = np.arctan2(target_pos[1] - current_pos[1], target_pos[0] - current_pos[0]) * 180 / np.pi\n      current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n      \n      if direction_to_workshop < 0:\n          direction_to_workshop += 360\n\n      delta_direction = (direction_to_workshop - current_direction + 360) % 360\n      actions = []\n\n      while abs(delta_direction) > 1e-5:  # Use a small threshold for floating point comparison\n          if delta_direction < 0:\n              delta_direction += 360\n\n          turn_action = (2 if env._current_state.dir == 3 else 3) if delta_direction > 180 else (2 if env._current_state.dir == 0 else 3)\n          actions.append(turn_action)\n          env._current_state.dir = (env._current_state.dir + 1) % 4 if turn_action == 3 else (env._current_state.dir - 1) % 4\n          \n          direction_to_workshop = np.arctan2(target_pos[1] - current_pos[1], target_pos[0] - current_pos[0]) * 180 / np.pi\n          current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n          \n          if direction_to_workshop < 0:\n              direction_to_workshop += 360\n\n          delta_direction = (direction_to_workshop - current_direction + 360) % 360\n      \n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  \n  # Find the closest position to move towards\n  pos = np.array(env._current_state.pos)\n  nearest_target_pos = get_closest_workshop_position(pos, workshop_indices)\n\n  if nearest_target_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      action = get_directional_action(dx, dy)\n      actions.append(action)\n      pos[0] += 1 if action == 3 else (-1 if action == 2 else 0)\n      pos[1] += 1 if action == 1 else (-1 if action == 0 else 0)\n\n  # Orient the agent towards the workshop\n  actions.extend(rotate_to_face_target(pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 0, "scores": {"3": 5.0}}
{"timestamp": "2025-09-11T03:54:52.409826", "function_name": "craft", "function_body": "  def get_closest_workshop_position(pos, workshop_indices):\n      min_distance = float('inf')\n      nearest_target_pos = None\n      \n      for workshop_idx in workshop_indices:\n          # Calculate the mean position of all workshops of this type\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              for target_pos in workshop_pos_list:\n                  dist_to_target = np.linalg.norm(pos - target_pos, ord=2)\n                  if dist_to_target < min_distance:\n                      nearest_target_pos = target_pos\n                      min_distance = dist_to_target\n      \n      return nearest_target_pos\n\n  def get_directional_action(dx, dy):\n      \"\"\"Determine the action to move in based on dx and dy.\"\"\"\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          return 3 if dx > 0 else 2\n      else:  # Then move in y-direction\n          return 1 if dy > 0 else 0\n\n  def rotate_to_face_target(current_pos, target_pos):\n      \"\"\"Calculate the actions needed to orient the agent towards the target position.\"\"\"\n      direction_to_workshop = np.arctan2(target_pos[1] - current_pos[1], target_pos[0] - current_pos[0]) * 180 / np.pi\n      current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n      \n      if direction_to_workshop < 0:\n          direction_to_workshop += 360\n\n      delta_direction = (direction_to_workshop - current_direction + 360) % 360\n      actions = []\n\n      while delta_direction > 180 or delta_direction != 0:\n          if delta_direction > 180:\n              actions.append(2 if env._current_state.dir == 3 else 3)\n              env._current_state.dir = (env._current_state.dir + 1) % 4\n          else:\n              actions.append(2 if env._current_state.dir == 0 else 3)\n              env._current_state.dir = (env._current_state.dir - 1) % 4\n\n          direction_to_workshop = np.arctan2(target_pos[1] - current_pos[1], target_pos[0] - current_pos[0]) * 180 / np.pi\n          current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n          \n          if direction_to_workshop < 0:\n              direction_to_workshop += 360\n          \n          delta_direction = (direction_to_workshop - current_direction + 360) % 360\n      \n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  \n  # Find the closest position to move towards\n  pos = np.array(env._current_state.pos)\n  nearest_target_pos = get_closest_workshop_position(pos, workshop_indices)\n\n  if nearest_target_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      action = get_directional_action(dx, dy)\n      actions.append(action)\n      pos[0] += 1 if action == 3 else (-1 if action == 2 else 0)\n      pos[1] += 1 if action == 1 else (-1 if action == 0 else 0)\n\n  # Orient the agent towards the workshop\n  actions.extend(rotate_to_face_target(pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 0, "scores": {"3": 5.0}}
{"timestamp": "2025-09-11T03:57:18.925680", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  \n  # Determine the type of workshop needed for crafting\n  recipe_workshops = [workshop for workshop, recipes in cookbook.recipes.items() if goal_index in recipes]\n  \n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest available workshop that can craft the desired item\n  for workshop_name in recipe_workshops:\n      workshop_idx = cookbook.index[workshop_name]\n      \n      if workshop_idx not in workshop_indices:  # Skip if this is not an actual workshop index in the environment\n          continue\n\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_name, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, cookbook.index[closest_workshop_idx]])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Orient the agent towards the workshop (optional, might not be necessary)\n  direction_to_workshop = np.arctan2(nearest_target_pos[1] - pos[1], nearest_target_pos[0] - pos[0]) * 180 / np.pi\n  current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[env._current_state.dir]\n  \n  if direction_to_workshop < 0:\n      direction_to_workshop += 360\n\n  # Calculate the difference in direction\n  delta_direction = (direction_to_workshop - current_direction + 360) % 360\n  \n  if delta_direction > 180:\n      actions.append(2 if env._current_state.dir == 3 else 3)\n      env._current_state.dir = (env._current_state.dir + 1) % 4\n  elif delta_direction < 180 and delta_direction != 0:\n      actions.append(2 if env._current_state.dir == 0 else 3)\n      env._current_state.dir = (env._current_state.dir - 1) % 4\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-11T03:57:19.919401", "function_name": "craft", "function_body": "  def move_to_position(pos, target_pos):\n      actions = []\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n      return actions\n\n  def turn_towards(pos, target_pos, current_dir):\n      direction_to_workshop = np.arctan2(target_pos[1] - pos[1], target_pos[0] - pos[0]) * 180 / np.pi\n      if direction_to_workshop < 0:\n          direction_to_workshop += 360\n\n      current_direction = {0: 90, 1: 0, 2: 270, 3: 180}[current_dir]\n      delta_direction = (direction_to_workshop - current_direction + 360) % 360\n\n      actions = []\n      if delta_direction > 180:\n          actions.append(2 if current_dir == 3 else 3)\n          new_dir = (current_dir + 1) % 4\n      elif delta_direction < 180 and delta_direction != 0:\n          actions.append(2 if current_dir == 0 else 3)\n          new_dir = (current_dir - 1) % 4\n      return actions, new_dir\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  actions.extend(move_to_position(pos, nearest_target_pos))\n\n  # Orient the agent towards the workshop\n  turn_actions, new_dir = turn_towards(nearest_target_pos, nearest_target_pos, env._current_state.dir)\n  actions.extend(turn_actions)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 8, "scores": {"3": -1}}
