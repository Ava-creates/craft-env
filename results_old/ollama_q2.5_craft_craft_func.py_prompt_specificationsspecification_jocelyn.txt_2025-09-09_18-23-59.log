 += 1 if dx > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 7, "scores": {"3": 4.7}}
{"timestamp": "2025-09-09T20:02:07.719285", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate all positions of this type of workshop\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda x: np.linalg.norm(pos - x))\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      direction = None\n\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          direction = 3 if dx > 0 else 2\n      else:  # Then move in y-direction\n          direction = 1 if dy > 0 else 0\n\n      actions.append(direction)\n      pos += np.array([1 if dx > 0 else -1, 1 if dy > 0 else -1]) * (abs(dx) >= abs(dy))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-09T20:02:08.700818", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate all positions of this type of workshop\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) == 0:  # Skip if no workshops are found\n          continue\n\n      # Find the nearest workshop to the current position\n      for workshop_pos in workshop_pos_list:\n          distance = np.linalg.norm(pos - workshop_pos, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx = workshop_idx\n              nearest_target_pos = workshop_pos\n              min_distance = distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      actions.extend(calculate_moves_to_position(pos, nearest_target_pos))\n      pos = np.array(nearest_target_pos)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-09T20:03:10.772800", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Determine the closest workshop that can craft the desired item\n  min_distance = float('inf')\n  nearest_workshop_pos = None\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(workshop_pos_list) > 0:\n          # Calculate the mean position of all workshops of this type\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          \n          # Find the nearest specific workshop to the current position\n          for target_pos in workshop_pos_list:\n              distance = np.linalg.norm(np.array(env._current_state.pos) - target_pos, ord=2)\n              if distance < min_distance:\n                  min_distance = distance\n                  nearest_workshop_pos = target_pos\n\n  if nearest_workshop_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position with pathfinding\n  current_pos = np.array(env._current_state.pos)\n\n  def move_towards(target):\n      nonlocal current_pos, actions\n      while not np.array_equal(current_pos, target):\n          dx, dy = target - current_pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              current_pos[0] += 1 if dx > 0 else -1\n          elif dy != 0:  # Then move in y-direction, but only if there is a need to do so\n              actions.append(1 if dy > 0 else 0)\n              current_pos[1] += 1 if dy > 0 else -1\n\n  move_towards(nearest_workshop_pos)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 1, "scores": {"3": 4.7}}
{"timestamp": "2025-09-09T20:03:11.833761", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Determine the closest workshop that can craft the desired item\n  min_distance = float('inf')\n  nearest_workshop_pos = None\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(workshop_pos_list) > 0:\n          # Find the nearest specific workshop to the current position\n          for target_pos in workshop_pos_list:\n              distance = np.linalg.norm(np.array(env._current_state.pos) - target_pos, ord=2)\n              if distance < min_distance:\n                  min_distance = distance\n                  nearest_workshop_pos = target_pos\n\n  if nearest_workshop_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  current_pos = np.array(env._current_state.pos)\n\n  while not np.array_equal(current_pos, nearest_workshop_pos):\n      dx, dy = nearest_workshop_pos - current_pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          current_pos[0] += 1 if dx > 0 else -1\n      elif dy != 0:  # Then move in y-direction, but only if there is a need to do so\n          actions.append(1 if dy > 0 else 0)\n          current_pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 1, "scores": {"3": 4.7}}
{"timestamp": "2025-09-09T20:04:00.042720", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  target_workshops = []\n  \n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          target_workshops.extend([(workshop_pos, workshop_idx) for workshop_pos in workshop_pos_list])\n  \n  if not target_workshops:\n      raise ValueError(\"No available workshop found\")\n  \n  # Find the nearest target position among all workshops\n  nearest_target = min(target_workshops, key=lambda x: np.linalg.norm(pos - x[0], ord=2))\n  nearest_target_pos, closest_workshop_idx = nearest_target\n\n  # Move to the closest workshop position\n  actions.extend(move_to_position(env._current_state.pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-09T20:04:01.023760", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  \n  # Check which workshops are needed for crafting the item\n  required_workshops = []\n  for recipe in cookbook.recipes.values():\n      if goal_index in recipe:\n          required_workshops.extend(list(set(workshop_indices) & set(recipe.keys())))\n\n  if not required_workshops:\n      raise ValueError(\"No available workshop found for this item\")\n\n  # Find the closest target position among all workshops\n  nearest_target = None\n  min_distance = float('inf')\n  \n  for workshop_idx in required_workshops:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          nearest_workshop_pos = min(\n              workshop_pos_list, key=lambda x: np.linalg.norm(pos - x, ord=2)\n          )\n          \n          distance = np.linalg.norm(pos - nearest_workshop_pos, ord=2)\n          \n          if distance < min_distance:\n              min_distance = distance\n              nearest_target = (nearest_workshop_pos, workshop_idx)\n\n  if not nearest_target:\n      raise ValueError(\"No available workshop found within the grid\")\n\n  nearest_target_pos, closest_workshop_idx = nearest_target\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-09T20:05:01.425559", "function_name": "craft", "function_body": "  def find_closest_workshop(item_index, pos):\n      min_distance = float('inf')\n      closest_workshop_idx = None\n      nearest_target_pos = None\n\n      for workshop_idx in env.world.workshop_indices:\n          # Calculate all positions of this type of workshop\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n          if len(workshop_pos_list) == 0:  # Skip if no workshops are found\n              continue\n\n          # Find the nearest workshop to the current position\n          for workshop_pos in workshop_pos_list:\n              distance = np.linalg.norm(pos - workshop_pos, ord=2)\n              if distance < min_distance:\n                  closest_workshop_idx = workshop_idx\n                  nearest_target_pos = workshop_pos\n                  min_distance = distance\n\n      return closest_workshop_idx, nearest_target_pos, min_distance\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, nearest_target_pos, min_distance = find_closest_workshop(goal_index, pos)\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 2, "scores": {"3": 4.7}}
{"timestamp": "2025-09-09T20:05:02.480990", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  min_distance = float('inf')\n\n  for workshop_idx in workshop_indices:\n      # Calculate all positions of this type of workshop\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) == 0:  # Skip if no workshops are found\n          continue\n\n      # Find the nearest workshop to the current position\n      for workshop_pos in workshop_pos_list:\n          distance = np.linalg.norm(pos - workshop_pos, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx = workshop_idx\n              nearest_target_pos = workshop_pos\n              min_distance = distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      elif abs(dy) > abs(dx):  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n      else:  # If dx == dy, choose one direction arbitrarily (e.g., x-direction first)\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 2, "scores": {"3": 4.7}}
{"timestamp": "2025-09-09T20:06:12.671154", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      direction = None\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          direction = 3 if dx > 0 else 2\n          pos[0] += 1 if dx > 0 else -1\n      elif abs(dx) < abs(dy):  # Then move in y-direction\n          direction = 1 if dy > 0 else 0\n          pos[1] += 1 if dy > 0 else -1\n      else:  # If both are equal, choose one direction (here we choose x-direction)\n          direction = 3 if dx > 0 else 2\n          pos[0] += 1 if dx > 0 else -1\n      \n      actions.append(direction)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 5, "scores": {"3": 4.7}}
{"timestamp": "2025-09-09T20:11:12.829629", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      direction = None\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          direction = 3 if dx > 0 else 2\n          pos[0] += 1 if dx > 0 else -1\n      elif abs(dy) > abs(dx):  # Then move in y-direction\n          direction = 1 if dy > 0 else 0\n          pos[1] += 1 if dy > 0 else -1\n      else:  # If both are equal, choose a random direction (here we choose x-direction)\n          direction = np.random.choice([2, 3]) if dx != 0 else np.random.choice([0, 1])\n      \n      actions.append(direction)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-09T20:17:39.217360", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Calculate the direction to move towards the workshop\n  dx, dy = nearest_target_pos - pos\n  current_dir = env._current_state.dir\n  target_direction = None\n\n  if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n      target_direction = (3 if dx > 0 else 2)\n  else:  # Then move in y-direction\n      target_direction = (1 if dy > 0 else 0)\n\n  while not np.array_equal(pos, nearest_target_pos):\n      # Check if we need to change direction\n      if current_dir != target_direction:\n          dir_diff = (target_direction - current_dir) % 4\n          if dir_diff == 1:\n              actions.append(2)  # LEFT\n              current_dir = (current_dir + 1) % 4\n          elif dir_diff == 3:\n              actions.append(3)  # RIGHT\n              current_dir = (current_dir - 1) % 4\n          else:  # Turn around\n              actions.extend([2, 2])  # LEFT twice (or RIGHT twice)\n              current_dir = (current_dir + 2) % 4\n\n      # Move in the target direction\n      actions.append(target_direction)\n      pos[0] += 1 if target_direction == 3 else -1 if target_direction == 2 else 0\n      pos[1] += 1 if target_direction == 1 else -1 if target_direction == 0 else 0\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-09T20:17:40.293883", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Check if we need to turn towards the correct direction before using\n  current_dir = env._current_state.dir\n  target_dir = np.arctan2(nearest_target_pos[1] - pos[1], nearest_target_pos[0] - pos[0]) * (180 / np.pi) % 360 // 90\n\n  if current_dir != target_dir:\n      # Calculate the difference in direction\n      dir_diff = (target_dir - current_dir + 4) % 4\n      if dir_diff == 1:\n          actions.append(2)  # LEFT\n      elif dir_diff == 3:\n          actions.append(3)  # RIGHT\n      elif dir_diff == 2:\n          actions.extend([2, 2])  # LEFT twice (or RIGHT twice)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": 3.7}}
{"timestamp": "2025-09-09T20:24:09.577477", "function_name": "craft", "function_body": "  def move_towards_target(pos, target_pos):\n      dx, dy = target_pos - pos\n      actions = []\n      while not np.array_equal(pos, target_pos):\n          direction = None\n          \n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              direction = (3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              direction = (1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n          actions.append(direction)\n\n      return actions, pos\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  sub_actions, pos = move_towards_target(pos, nearest_target_pos)\n  actions.extend(sub_actions)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-09T20:24:10.555369", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Function to calculate the next move direction using A* algorithm\n  def a_star(start, goal, grid):\n      neighbors = [(0,1), (1,0), (0,-1), (-1,0)]\n      close_set = set()\n      came_from = {}\n      gscore = {start:0}\n      fscore = {start:heuristic(start, goal)}\n      oheap = []\n      heapq.heappush(oheap, (fscore[start], start))\n      \n      while oheap:\n          current = heapq.heappop(oheap)[1]\n          \n          if current == goal:\n              data = []\n              while current in came_from:\n                  data.append(current)\n                  current = came_from[current]\n              return data\n          \n          close_set.add(current)\n          for i, j in neighbors:\n              neighbor = current[0] + i, current[1] + j \n              tentative_g_score = gscore[current] + 1\n                \n              if 0 <= neighbor[0] < grid.shape[0]:\n                  if 0 <= neighbor[1] < grid.shape[1]:                \n                      if grid[neighbor] == 1:   # This checks if the neighbor is an obstacle\n                          continue\n                  else:\n                      # array bound y walls\n                      continue\n              else:\n                  # array bound x walls\n                  continue\n                \n              if neighbor in close_set and tentative_g_score >= gscore.get(neighbor, 0):\n                  continue\n                    \n              if  tentative_g_score < gscore.get(neighbor, 0) or neighbor not in [i[1]for i in oheap]:\n                  came_from[neighbor] = current\n                  gscore[neighbor] = tentative_g_score\n                  fscore[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                  heapq.heappush(oheap, (fscore[neighbor], neighbor))\n                  \n      return False\n  \n  def heuristic(a, b):\n      return np.linalg.norm(np.array(a) - np.array(b), ord=2)\n\n  path = a_star(tuple(pos), tuple(nearest_target_pos), env._current_state.grid.sum(axis=-1))\n\n  if not path:\n      raise ValueError(\"No valid path to the workshop found\")\n\n  for next_step in reversed(path[1:]):\n      dx, dy = np.array(next_step) - pos\n      direction = None\n      \n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          direction = (3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          direction = (1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n      actions.append(direction)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-09T20:25:16.132792", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  target_workshops = {}\n  \n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          distances = np.linalg.norm(workshop_pos_list - pos, axis=1)\n          min_distance = distances.min()\n          nearest_target_pos = workshop_pos_list[distances.argmin()]\n          target_workshops[workshop_idx] = (min_distance, nearest_target_pos)\n\n  if not target_workshops:\n      raise ValueError(\"No available workshop found\")\n\n  # Find the closest workshop\n  closest_workshop_idx, (min_distance, nearest_target_pos) = min(target_workshops.items(), key=lambda x: x[1][0])\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      elif dy != 0:\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 3, "scores": {"3": 4.7}}
