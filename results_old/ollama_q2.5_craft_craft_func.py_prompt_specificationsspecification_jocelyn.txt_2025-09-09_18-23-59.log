t_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  actions.extend(move_towards(pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 3, "scores": {"3": 4.7}}
{"timestamp": "2025-09-09T20:26:12.087207", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  \n  # Create a list of distances to each available workshop\n  target_workshops = []\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          target_workshops.extend([(workshop_pos, workshop_idx) for workshop_pos in workshop_pos_list])\n  \n  if not target_workshops:\n      raise ValueError(\"No available workshop found\")\n  \n  # Find the nearest target position among all workshops\n  nearest_target = min(target_workshops, key=lambda x: np.linalg.norm(pos - x[0], ord=2))\n  nearest_target_pos, closest_workshop_idx = nearest_target\n\n  # Calculate the direction to move towards the nearest workshop\n  dx, dy = nearest_target_pos - pos\n  \n  # Move to the closest workshop position (use A* for optimal pathfinding)\n  actions.extend(a_star_pathfinding(env._current_state.grid, tuple(pos), tuple(nearest_target_pos)))\n  \n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-09T20:26:13.209975", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          return 3 if dx > 0 else 2  # RIGHT or LEFT\n      else:  # Then move in y-direction\n          return 1 if dy > 0 else 0  # UP or DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  target_workshops = []\n  \n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          target_workshops.extend([(workshop_pos, workshop_idx) for workshop_pos in workshop_pos_list])\n  \n  if not target_workshops:\n      raise ValueError(\"No available workshop found\")\n  \n  # Find the nearest target position among all workshops\n  nearest_target = min(target_workshops, key=lambda x: np.linalg.norm(pos - x[0], ord=2))\n  nearest_target_pos, closest_workshop_idx = nearest_target\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      direction = get_direction(dx, dy)\n      actions.append(direction)\n      \n      # Update position based on the move action taken\n      if direction == 3:\n          pos[0] += 1\n      elif direction == 2:\n          pos[0] -= 1\n      elif direction == 1:\n          pos[1] += 1\n      else:  # direction == 0\n          pos[1] -= 1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 8, "scores": {"3": 4.7}}
