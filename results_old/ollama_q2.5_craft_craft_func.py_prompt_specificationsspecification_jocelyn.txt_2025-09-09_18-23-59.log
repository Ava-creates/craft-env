{"timestamp": "2025-09-09T23:02:01.827614", "function_name": "craft", "function_body": "  def get_direction(dx: int, dy: int):\n      directions = [(3, dx > 0), (2, dx < 0), (1, dy > 0), (0, dy < 0)]\n      valid_dirs = [d for d, condition in directions if condition]\n      return valid_dirs[0] if valid_dirs else None\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  target_workshops = []\n  \n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          target_workshops.extend([(workshop_pos, workshop_idx) for workshop_pos in workshop_pos_list])\n  \n  if not target_workshops:\n      raise ValueError(\"No available workshop found\")\n  \n  # Find the nearest target position among all workshops\n  nearest_target = min(target_workshops, key=lambda x: np.linalg.norm(pos - x[0], ord=2))\n  nearest_target_pos, closest_workshop_idx = nearest_target\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      direction = get_direction(dx, dy)\n      \n      if direction is None:\n          raise ValueError(\"No valid direction found\")\n      \n      actions.append(direction)\n      \n      # Update position based on the action taken\n      if direction == 0:\n          pos[1] -= 1\n      elif direction == 1:\n          pos[1] += 1\n      elif direction == 2:\n          pos[0] -= 1\n      else:  # direction == 3\n          pos[0] += 1\n\n  # Use the workshop to craft the item\n  actions.append(4) 