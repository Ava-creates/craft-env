nt_pos - target_pos)\n        if distance < min_distance:\n          min_distance = distance\n          workshop_pos = (x, y)\n\n  # If no workshop position is found, return an empty list of actions\n  if workshop_pos is None:\n    return []\n\n  # Calculate the path to the closest workshop and perform the USE action\n  target_pos = np.array(workshop_pos)\n  actions_to_workshop = []\n  while not np.all(agent_pos == target_pos):\n    direction = target_pos - agent_pos\n    if abs(direction[0]) > abs(direction[1]):\n      # Move horizontally\n      if direction[0] > 0:\n        actions_to_workshop.append(3)  # RIGHT\n        agent_pos[0] += 1\n      else:\n        actions_to_workshop.append(2)  # LEFT\n        agent_pos[0] -= 1\n    else:\n      # Move vertically\n      if direction[1] > 0:\n        actions_to_workshop.append(1)  # UP\n        agent_pos[1] += 1\n      else:\n        actions_to_workshop.append(0)  # DOWN\n        agent_pos[1] -= 1\n\n  actions_to_workshop.append(4)  # USE to craft the item\n\n  return actions_to_workshop", "island_id": 1, "scores": {"": 2.0}}
