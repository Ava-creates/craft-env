ny < grid_shape[1]:\n            heapq.heappush(queue, (cost + 1, (nx, ny), actions + [action]))\n    return []\n\n  def ensure_inventory(item_index):\n    \"\"\"Ensures the inventory has all required primitives for crafting.\"\"\"\n    actions = []\n    current_inventory = env._current_state.inventory.copy()\n    \n    # Get required primitives from the recipe\n    required_primitives = []\n    for output_idx, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n        required_primitives.extend(ingredients.keys())\n    \n    for primitive in required_primitives:\n      primitive_index = env.world.cookbook.index[primitive]\n      if current_inventory[primitive_index] == 0:\n        collect_actions = collect(env, primitive)\n        actions.extend(collect_actions)\n        # Update the inventory after collecting\n        current_inventory[primitive_index] += 1\n    \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n  grid_shape = env._current_state.grid.shape[:2]\n\n  # Find the closest workshop for crafting\n  workshop_index = get_closest_workshop(item_index)\n\n  # Ensure inventory has all required primitives\n  actions_to_collect_primitives = ensure_inventory(item_index)\n\n  # Find the position of the closest workshop in the grid\n  agent_pos = np.array(env._current_state.pos)\n  workshop_pos = None\n  min_distance = float('inf')\n  for y in range(grid_shape[1]):\n    for x in range(grid_shape[0]):\n      if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n        target_pos = np.array((x, y))\n        distance = np.linalg.norm(agent_pos - target_pos)\n        if distance < min_distance:\n          min_distance = distance\n          workshop_pos = (x, y)\n\n  # If no workshop position is found, return an empty list of actions\n  if workshop_pos is None:\n    return []\n\n  # Calculate the path to the closest workshop and perform the USE action\n  target_pos = np.array(workshop_pos)\n  actions_to_workshop = path_to_target(agent_pos.tolist(), target_pos.tolist())\n  actions_to_workshop.append(4)  # USE to craft the item\n\n  return actions_to_collect_primitives + actions_to_workshop", "island_id": 2, "scores": {"": -1}}
{"timestamp": "2025-09-03T04:23:28.341470", "function_name": "craft", "function_body": "  def get_nearest_workshop_pos(workshop_index):\n    agent_pos = np.array(env._current_state.pos)\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n    distances = np.linalg.norm(workshop_positions - agent_pos, axis=1)\n    nearest_workshop_idx = np.argmin(distances)\n    return workshop_positions[nearest_workshop_idx]\n\n  def generate_move_actions(source_pos, target_pos):\n    actions = []\n    relative_pos = target_pos - source_pos\n    \n    # Determine the direction to move\n    if relative_pos[0] < 0:  # Move down\n        actions.append(craft.DOWN)\n    elif relative_pos[0] > 0:  # Move up\n        actions.append(craft.UP)\n    \n    if relative_pos[1] < 0:  # Move left\n        actions.append(craft.LEFT)\n    elif relative_pos[1] > 0:  # Move right\n        actions.append(craft.RIGHT)\n\n    return actions\n\n  actions = []\n\n  # Get the index for the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item is a primitive or requires crafting\n  if item_index in env.world.grabbable_indices:\n      return []  # No need to craft primitives\n  \n  # Find the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index, None)\n  \n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  # Check if we have all ingredients in the inventory\n  required_ingredients = {\n      ingredient: count for ingredient, count in recipe.items() if ingredient != \"_key\"\n  }\n  \n  if not all(env._current_state.inventory[ingredient] >= count for ingredient, count in required_ingredients.items()):\n    raise ValueError(f\"Missing required ingredients to craft {item}\")\n\n  # Find the workshop index from the \"_key\" field in the recipe\n  workshop_index = env.world.cookbook.index[recipe[\"_key\"]]\n\n  # Get the nearest workshop position\n  nearest_workshop_pos = get_nearest_workshop_pos(workshop_index)\n\n  # Generate actions to move towards the nearest workshop\n  source_pos = np.array(env._current_state.pos)\n  move_actions = generate_move_actions(source_pos, nearest_workshop_pos)\n\n  actions.extend(move_actions)\n\n  # Add the USE action to craft the item at the workshop\n  actions.append(craft.USE)\n\n  return actions", "island_id": 8, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T04:23:29.424857", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index for the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the item is a primitive or requires crafting\n  if item_index in env.world.grabbable_indices:\n    return []  # No need to craft primitives\n  \n  # Find the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index, None)\n  \n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n  \n  # Check if we have all ingredients in the inventory\n  required_ingredients = {\n      ingredient: count for ingredient, count in recipe.items() if ingredient != \"_key\"\n  }\n  \n  if not all(env._current_state.inventory[ingredient] >= count for ingredient, count in required_ingredients.items()):\n    raise ValueError(f\"Missing required ingredients to craft {item}\")\n  \n  # Find the workshop index from the \"_key\" field in the recipe\n  workshop_index = env.world.cookbook.index[recipe[\"_key\"]]\n  \n  # Determine the direction and move to the nearest workshop\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshop for {item}\")\n  \n  # Find the nearest workshop\n  agent_pos = np.array(env._current_state.pos)\n  distances = np.linalg.norm(workshop_positions - agent_pos, axis=1)\n  nearest_workshop_idx = np.argmin(distances)\n  nearest_workshop_pos = workshop_positions[nearest_workshop_idx]\n  \n  # Generate actions to move towards the nearest workshop\n  relative_pos = nearest_workshop_pos - agent_pos\n  \n  def generate_move_actions(x_diff, y_diff):\n    if x_diff < 0:\n      return [craft.DOWN] * abs(x_diff)\n    elif x_diff > 0:\n      return [craft.UP] * abs(x_diff)\n    \n    if y_diff < 0:\n      return [craft.LEFT] * abs(y_diff)\n    elif y_diff > 0:\n      return [craft.RIGHT] * abs(y_diff)\n  \n  # Calculate the sequence of actions to move to the nearest workshop\n  x_diff = relative_pos[0]\n  y_diff = relative_pos[1]\n  \n  # Determine if moving vertically or horizontally is better first based on Manhattan distance\n  if abs(x_diff) > abs(y_diff):\n      actions.extend(generate_move_actions(x_diff, 0))\n      actions.extend(generate_move_actions(0, y_diff))\n  else:\n      actions.extend(generate_move_actions(0, y_diff))\n      actions.extend(generate_move_actions(x_diff, 0))\n\n  # Add the USE action to craft the item at the workshop\n  actions.append(craft.USE)\n\n  return actions", "island_id": 8, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T04:25:41.749320", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    # A* pathfinding algorithm for more efficient movement\n    open_set = collections.deque([current_pos])\n    came_from = {}\n    g_score = {current_pos: 0}\n    f_score = {current_pos: abs(target_pos[0] - current_pos[0]) + abs(target_pos[1] - target_pos[1])}\n\n    while open_set:\n      # Get the position with the lowest f score\n      current = min(open_set, key=lambda p: f_score[p])\n      open_set.remove(current)\n      \n      if current == target_pos:\n        break\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        \n        # Check if the neighbor is within grid bounds and not an obstacle\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n          tentative_g_score = g_score[current] + 1\n            \n          if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n            came_from[neighbor] = current\n            g_score[neighbor] = tentative_g_score\n            f_score[neighbor] = tentative_g_score + abs(target_pos[0] - neighbor[0]) + abs(target_pos[1] - neighbor[1])\n            if neighbor not in open_set:\n              open_set.append(neighbor)\n\n    # Reconstruct path\n    total_path = []\n    while current in came_from:\n      total_path.append(current)\n      current = came_from[current]\n    total_path.reverse()\n\n    for next_pos in total_path:\n      dx = next_pos[0] - current_pos[0]\n      dy = next_pos[1] - current_pos[1]\n\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      elif dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n\n      current_pos = next_pos\n      \n    return actions\n\n  def collect_primitive(env, primitive):\n    item_index = env.world.cookbook.index[primitive]\n    \n    # Find the position of the primitive on the grid\n    grid = env._current_state.grid\n    pos = env._current_state.pos\n    target_pos = None\n    \n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if grid[i, j, item_index] > 0:\n          target_pos = (i, j)\n          break\n      if target_pos:\n          break\n\n    if not target_pos:\n      raise ValueError(f\"No available '{primitive}' found on the grid.\")\n\n    # Move to the position of the primitive and collect it\n    actions_to_primitive = move_to(env, target_pos)\n    actions_to_primitive.append(4)  # Assuming action index 4 corresponds to COLLECT\n\n    return actions_to_primitive\n  \n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  actions = []\n\n  # Collect all required primitives\n  for primitive, count in env.world.cookbook.primitives_required(item).items():\n      actions.extend(collect_primitive(env, primitive))\n  \n  # Determine which workshop is required for crafting this item\n  # Since the problem does not specify how to determine the workshop,\n  # we will assume that all workshops can craft any items for simplicity.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions + actions_to_workshop", "island_id": 5, "scores": {"": -1}}
{"timestamp": "2025-09-03T04:25:42.742994", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    # A* pathfinding algorithm for more efficient movement\n    open_set = collections.deque([current_pos])\n    came_from = {}\n    g_score = {current_pos: 0}\n    f_score = {current_pos: abs(target_pos[0] - current_pos[0]) + abs(target_pos[1] - target_pos[1])}\n\n    while open_set:\n      current = open_set.popleft()\n      \n      if current == target_pos:\n        break\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        \n        tentative_g_score = g_score[current] + 1\n        \n        if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n          came_from[neighbor] = current\n          g_score[neighbor] = tentative_g_score\n          f_score[neighbor] = tentative_g_score + abs(target_pos[0] - neighbor[0]) + abs(target_pos[1] - neighbor[1])\n          open_set.append(neighbor)\n\n    # Reconstruct path\n    total_path = []\n    while current in came_from:\n      total_path.append(current)\n      current = came_from[current]\n    total_path.reverse()\n\n    for next_pos in total_path:\n      dx = next_pos[0] - current_pos[0]\n      dy = next_pos[1] - current_pos[1]\n\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      elif dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n\n      current_pos = next_pos\n      \n    return actions\n\n  def gather_primitives(env, primitives):\n    grid = env._current_state.grid\n    pos = env._current_state.pos\n    \n    actions = []\n    for primitive in primitives:\n      # Find the closest position of the primitive on the grid\n      min_distance = float('inf')\n      target_pos = None\n      \n      for i in range(grid.shape[0]):\n        for j in range(grid.shape[1]):\n          if grid[i, j, primitive] > 0:\n            distance = abs(i - pos[0]) + abs(j - pos[1])\n            if distance < min_distance:\n              min_distance = distance\n              target_pos = (i, j)\n      \n      if not target_pos:\n        raise ValueError(f\"No available {env.world.cookbook.index[primitive]} found on the grid.\")\n      \n      # Move to the closest position of the primitive\n      actions.extend(move_to(env, target_pos))\n      \n      # Use the USE action to gather the primitive\n      actions.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n      \n      pos = target_pos  # Update the current position\n    \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Get the primitives required for crafting the item\n  primitives = env.world.cookbook.primitives[item]\n\n  # Gather all required primitives\n  gather_actions = gather_primitives(env, primitives)\n\n  # Determine which workshop is required for crafting this item\n  # Since the problem does not specify how to determine the workshop,\n  # we will assume that all workshops can craft any items for simplicity.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return gather_actions + actions_to_workshop", "island_id": 5, "scores": {"": -1}}
{"timestamp": "2025-09-03T04:26:13.536475", "function_name": "craft", "function_body": "  actions = []\n  index = env.world.cookbook.index\n  workshop_indices = env.world.workshop_indices\n\n  # Find the required workshop for the item to be crafted\n  recipe = env.world.cookbook.recipes[index[item]]\n  needed_workshop = None\n\n  for ingredient, count in recipe.items():\n      if isinstance(ingredient, str) and \"_key\" not in ingredient:\n          i_kind = index.get(index[ingredient])\n          if i_kind in workshop_indices:\n              needed_workshop = i_kind\n              break\n\n  # If a workshop is found, navigate to it\n  if needed_workshop:\n      actions.extend(navigate_to_workshop(env, needed_workshop))\n      \n      # Use the workshop\n      actions.append(craft.USE)\n\n  return actions", "island_id": 9, "scores": {"": -1}}
{"timestamp": "2025-09-03T04:26:14.618740", "function_name": "craft", "function_body": "  # Get the index of the item to be crafted\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the workshop indices from the world configuration\n  workshop_indices = env.world.workshop_indices\n  \n  # Define actions for movement (UP, DOWN, LEFT, RIGHT) and USE action\n  UP, DOWN, LEFT, RIGHT, USE = range(5)\n  \n  # Initialize an empty list to store the actions needed\n  actions = []\n  \n  # Assume we need to move to a workshop to craft the item\n  target_workshop_index = workshop_indices[0]  # For simplicity, always choose the first workshop\n  \n  # Get the current position of the agent\n  current_pos = env._current_state.pos\n  \n  # Placeholder for finding the path to the target workshop\n  def find_path_to_workshop(current_pos, target_workshop_index):\n    # This function should return a list of actions (UP, DOWN, LEFT, RIGHT) to reach the target workshop\n    # For now, we will use a simple hardcoded path as an example\n    return [UP, UP]  # Example hardcoded path\n  \n  # Get the path to the target workshop\n  path_to_workshop = find_path_to_workshop(current_pos, target_workshop_index)\n  \n  # Add the path actions to the list of actions needed\n  actions.extend(path_to_workshop)\n  \n  # Add the USE action to start crafting at the workshop\n  actions.append(USE)\n  \n  return actions", "island_id": 9, "scores": {"": -0.3}}
{"timestamp": "2025-09-03T04:28:16.923018", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    # A* pathfinding algorithm for more efficient movement\n    open_set = collections.deque([current_pos])\n    came_from = {}\n    g_score = {current_pos: 0}\n    f_score = {current_pos: abs(target_pos[0] - current_pos[0]) + abs(target_pos[1] - current_pos[1])}\n\n    while open_set:\n      # Sort the open set based on f_score for A*\n      open_set = collections.deque(sorted(open_set, key=lambda x: f_score[x]))\n      \n      current = open_set.popleft()\n      \n      if current == target_pos:\n        break\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        \n        tentative_g_score = g_score[current] + 1\n        \n        if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n          came_from[neighbor] = current\n          g_score[neighbor] = tentative_g_score\n          f_score[neighbor] = tentative_g_score + abs(target_pos[0] - neighbor[0]) + abs(target_pos[1] - neighbor[1])\n          open_set.append(neighbor)\n\n    # Reconstruct path\n    total_path = []\n    while current in came_from:\n      total_path.append(current)\n      current = came_from[current]\n    total_path.reverse()\n\n    for next_pos in total_path:\n      dx = next_pos[0] - current_pos[0]\n      dy = next_pos[1] - current_pos[1]\n\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      elif dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n\n      current_pos = next_pos\n      \n    return actions\n\n  def collect_primitives(env, primitives):\n    actions = []\n    for primitive in primitives:\n        while not env._current_state.next_primitive_in_inventory(primitive):\n            closest_primitive_pos = find_closest_primitive(env._current_state.grid, env._current_state.pos, primitive)\n            \n            if not closest_primitive_pos:\n                raise ValueError(f\"No available {primitive} found on the grid.\")\n            \n            # Move to the closest primitive\n            actions.extend(move_to(env, closest_primitive_pos))\n            \n            # Use the USE action to collect the primitive\n            actions.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n            \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  # This step assumes that the recipe specifies the workshop type needed.\n  # Since the problem does not specify how to determine the workshop,\n  # we will assume that all workshops can craft any items for simplicity.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Determine required primitives for crafting the item\n  recipe = env.world.cookbook.recipes[item_index]\n  required_primitives = [key for key, value in recipe.items() if value > 0]\n\n  # Collect all required primitives\n  actions_to_collect_primitives = collect_primitives(env, required_primitives)\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_collect_primitives + actions_to_workshop", "island_id": 6, "scores": {"": -1}}
{"timestamp": "2025-09-03T04:28:17.921484", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    # A* pathfinding algorithm for more efficient movement\n    open_set = collections.deque([current_pos])\n    came_from = {}\n    g_score = {current_pos: 0}\n    f_score = {current_pos: abs(target_pos[0] - current_pos[0]) + abs(target_pos[1] - current_pos[1])}\n\n    while open_set:\n      # Sort the open set based on f_score for A*\n      open_set = collections.deque(sorted(open_set, key=lambda x: f_score[x]))\n      \n      current = open_set.popleft()\n      \n      if current == target_pos:\n        break\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        \n        # Check if the neighbor is a valid move (i.e., not out of bounds and not a boundary)\n        if (0 <= neighbor[0] < grid.shape[0] and\n            0 <= neighbor[1] < grid.shape[1] and\n            not grid[neighbor[0], neighbor[1], env.world.cookbook.index['BOUNDARY']]):\n          \n          tentative_g_score = g_score[current] + 1\n          \n          if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n            came_from[neighbor] = current\n            g_score[neighbor] = tentative_g_score\n            f_score[neighbor] = tentative_g_score + abs(target_pos[0] - neighbor[0]) + abs(target_pos[1] - neighbor[1])\n            open_set.append(neighbor)\n\n    # Reconstruct path\n    total_path = []\n    while current in came_from:\n      total_path.append(current)\n      current = came_from[current]\n    total_path.reverse()\n\n    for next_pos in total_path:\n      dx = next_pos[0] - current_pos[0]\n      dy = next_pos[1] - current_pos[1]\n\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      elif dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n\n      current_pos = next_pos\n      \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  # This step assumes that the recipe specifies the workshop type needed.\n  # Since the problem does not specify how to determine the workshop,\n  # we will assume that all workshops can craft any items for simplicity.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 6, "scores": {"": -1}}
{"timestamp": "2025-09-03T04:29:36.188445", "function_name": "craft", "function_body": "  def get_nearest_workshop_pos(workshop_index):\n    agent_pos = np.array(env._current_state.pos)\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n    distances = np.linalg.norm(workshop_positions - agent_pos, axis=1)\n    nearest_workshop_idx = np.argmin(distances)\n    return workshop_positions[nearest_workshop_idx]\n\n  def generate_move_actions(source_pos, target_pos):\n    actions = []\n    relative_pos = target_pos - source_pos\n    \n    # Determine the direction to move\n    if relative_pos[0] < 0:  # Move down\n        while relative_pos[0] < 0:\n            actions.append(craft.DOWN)\n            relative_pos[0] += 1\n    elif relative_pos[0] > 0:  # Move up\n        while relative_pos[0] > 0:\n            actions.append(craft.UP)\n            relative_pos[0] -= 1\n    \n    if relative_pos[1] < 0:  # Move left\n        while relative_pos[1] < 0:\n            actions.append(craft.LEFT)\n            relative_pos[1] += 1\n    elif relative_pos[1] > 0:  # Move right\n        while relative_pos[1] > 0:\n            actions.append(craft.RIGHT)\n            relative_pos[1] -= 1\n\n    return actions\n\n  actions = []\n\n  # Get the index for the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item is a primitive or requires crafting\n  if item_index in env.world.grabbable_indices:\n      return []  # No need to craft primitives\n  \n  # Find the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index, None)\n  \n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  # Check if we have all ingredients in the inventory\n  required_ingredients = {\n      ingredient: count for ingredient, count in recipe.items() if ingredient != \"_key\"\n  }\n  \n  if not all(env._current_state.inventory[ingredient] >= count for ingredient, count in required_ingredients.items()):\n    raise ValueError(f\"Missing required ingredients to craft {item}\")\n\n  # Find the workshop index from the \"_key\" field in the recipe\n  workshop_index = env.world.cookbook.index[recipe[\"_key\"]]\n\n  # Get the nearest workshop position\n  nearest_workshop_pos = get_nearest_workshop_pos(workshop_index)\n\n  # Generate actions to move towards the nearest workshop\n  source_pos = np.array(env._current_state.pos)\n  move_actions = generate_move_actions(source_pos, nearest_workshop_pos)\n\n  actions.extend(move_actions)\n\n  # Add the USE action to craft the item at the workshop\n  actions.append(craft.USE)\n\n  return actions", "island_id": 8, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T04:29:37.293435", "function_name": "craft", "function_body": "  def get_nearest_workshop_pos(workshop_index):\n    agent_pos = np.array(env._current_state.pos)\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n    distances = np.linalg.norm(workshop_positions - agent_pos, axis=1)\n    nearest_workshop_idx = np.argmin(distances)\n    return workshop_positions[nearest_workshop_idx]\n\n  def generate_move_actions(source_pos, target_pos):\n    actions = []\n    relative_pos = target_pos - source_pos\n\n    # Determine the direction to move\n    if relative_pos[0] < 0:  # Move down\n        actions.append(craft.DOWN)\n    elif relative_pos[0] > 0:  # Move up\n        actions.append(craft.UP)\n\n    if relative_pos[1] < 0:  # Move left\n        actions.append(craft.LEFT)\n    elif relative_pos[1] > 0:  # Move right\n        actions.append(craft.RIGHT)\n\n    return actions\n\n  def move_towards(env, target_pos):\n      source_pos = np.array(env._current_state.pos)\n      move_actions = generate_move_actions(source_pos, target_pos)\n      \n      for action in move_actions:\n          reward, done, observations = env.step(action)\n          if done:\n              break\n      \n      return move_actions\n\n  actions = []\n\n  # Get the index for the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item is a primitive or requires crafting\n  if item_index in env.world.grabbable_indices:\n      return []  # No need to craft primitives\n  \n  # Find the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index, None)\n  \n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  # Check if we have all ingredients in the inventory\n  required_ingredients = {\n      ingredient: count for ingredient, count in recipe.items() if ingredient != \"_key\"\n  }\n  \n  if not all(env._current_state.inventory[ingredient] >= count for ingredient, count in required_ingredients.items()):\n    raise ValueError(f\"Missing required ingredients to craft {item}\")\n\n  # Find the workshop index from the \"_key\" field in the recipe\n  workshop_index = env.world.cookbook.index[recipe[\"_key\"]]\n\n  # Get the nearest workshop position\n  nearest_workshop_pos = get_nearest_workshop_pos(workshop_index)\n\n  # Move towards the nearest workshop\n  move_actions = move_towards(env, nearest_workshop_pos)\n  actions.extend(move_actions)\n\n  # Add the USE action to craft the item at the workshop\n  reward, done, observations = env.step(craft.USE)\n  if not done:\n      actions.append(craft.USE)\n\n  return actions", "island_id": 8, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T04:32:10.790337", "function_name": "craft", "function_body": "  def get_closest_workshop(item_index):\n    \"\"\"Finds the closest workshop that can craft the specified item.\"\"\"\n    # Determine the workshop required based on the recipe key\n    workshop_indices = []\n    for output_idx, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n        workshop_name = ingredients.get(\"_workshop\")\n        if workshop_name:\n          workshop_indices.append(env.world.cookbook.index[workshop_name])\n    \n    # If no specific workshop is needed, use a default one\n    if not workshop_indices:\n      return env.world.workshop_indices[0]  # Default to the first workshop type\n    \n    # Find the closest workshop in the grid\n    agent_pos = np.array(env._current_state.pos)\n    min_distance = float('inf')\n    closest_workshop_index = None\n    for workshop_index in workshop_indices:\n      for y in range(grid_shape[1]):\n        for x in range(grid_shape[0]):\n          if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n            target_pos = np.array((x, y))\n            distance = np.linalg.norm(agent_pos - target_pos)\n            if distance < min_distance:\n              min_distance = distance\n              closest_workshop_index = workshop_index\n    return closest_workshop_index\n\n  def path_to_target(start, target):\n    \"\"\"Computes the path from start position to target position using A* algorithm for better efficiency.\"\"\"\n    queue = [(0, start, [])]\n    visited = set()\n    while queue:\n      cost, (x, y), actions = heapq.heappop(queue)\n      if (x, y) == tuple(target):\n        return actions\n      if (x, y) not in visited:\n        visited.add((x, y))\n        for dx, dy, action in [(-1, 0, 2), (1, 0, 3), (0, -1, 0), (0, 1, 1)]:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < grid_shape[0] and 0 <= ny < grid_shape[1]:\n            heapq.heappush(queue, (cost + 1, (nx, ny), actions + [action]))\n    return []\n\n  def ensure_inventory(item_index):\n      \"\"\"Ensures the inventory has all required primitives for crafting.\"\"\"\n      actions = []\n      current_inventory = env._current_state.inventory.copy()\n      \n      # Get required primitives from the recipe\n      required_primitives = []\n      for output_idx, ingredients in env.world.cookbook.recipes.items():\n          if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n              required_primitives.extend([ingredient for ingredient in ingredients.keys() if ingredient != \"_key\"])\n      \n      # Collect each required primitive that is not already in the inventory\n      for primitive in required_primitives:\n          primitive_index = env.world.cookbook.index[primitive]\n          if current_inventory.get(primitive_index, 0) == 0:\n              collect_actions = collect(env, primitive)\n              actions.extend(collect_actions)\n              current_inventory[primitive_index] += 1\n      \n      return actions\n\n  def collect(env, primitive):\n    \"\"\"Collects the specified primitive by finding and moving to its location.\"\"\"\n    # Find all locations of the primitive in the grid\n    primitive_index = env.world.cookbook.index[primitive]\n    target_positions = []\n    for y in range(grid_shape[1]):\n        for x in range(grid_shape[0]):\n            if env._current_state.grid[x, y, primitive_index] > 0:\n                target_positions.append((x, y))\n    \n    # Find the closest target position to collect\n    agent_pos = np.array(env._current_state.pos)\n    min_distance = float('inf')\n    closest_target = None\n    for pos in target_positions:\n        distance = np.linalg.norm(agent_pos - np.array(pos))\n        if distance < min_distance:\n            min_distance = distance\n            closest_target = pos\n    \n    # If no target position is found, return an empty list of actions\n    if closest_target is None:\n        return []\n    \n    # Calculate the path to the closest target and perform the USE action\n    actions_to_primitive = path_to_target(agent_pos.tolist(), closest_target)\n    actions_to_primitive.append(4)  # USE to collect the primitive\n    \n    return actions_to_primitive\n\n  import heapq\n\n  item_index = env.world.cookbook.index[item]\n  grid_shape = env._current_state.grid.shape[:2]\n\n  # Ensure inventory has all required primitives\n  actions_to_collect_primitives = ensure_inventory(item_index)\n\n  # Find the closest workshop for crafting\n  workshop_index = get_closest_workshop(item_index)\n\n  # Check if any workshops of that type exist in the environment\n  if workshop_index is None:\n    return []\n\n  # Find the position of all workshops of this type in the grid\n  agent_pos = np.array(env._current_state.pos)\n  workshop_positions = []\n  for y in range(grid_shape[1]):\n    for x in range(grid_shape[0]):\n      if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n        workshop_positions.append((x, y))\n\n  # If no workshops are found, return an empty list of actions\n  if not workshop_positions:\n    return []\n\n  # Calculate distances to all workshops and find the closest one\n  min_distance = float('inf')\n  closest_workshop_pos = None\n  for pos in workshop_positions:\n      target_pos = np.array(pos)\n      distance = np.linalg.norm(agent_pos - target_pos)\n      if distance < min_distance:\n          min_distance = distance\n          closest_workshop_pos = pos\n\n  # Calculate the path to the closest workshop and perform the USE action\n  target_pos = np.array(closest_workshop_pos)\n  actions_to_workshop = path_to_target(agent_pos.tolist(), target_pos.tolist())\n  actions_to_workshop.append(4)  # USE to craft the item\n\n  return actions_to_collect_primitives + actions_to_workshop", "island_id": 2, "scores": {"": 2.0}}
