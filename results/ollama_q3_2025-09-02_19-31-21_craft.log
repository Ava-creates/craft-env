{"timestamp": "2025-09-02T23:35:49.591344", "function_name": "craft", "function_body": "  # Constants for action indices\n  UP, DOWN, LEFT, RIGHT, USE = env.action_specs()['UP'], env.action_specs()['DOWN'], env.action_specs()['LEFT'], env.action_specs()['RIGHT'], env.action_specs()['USE']\n\n  def get_missing_ingredients(recipe):\n    required_ingredients = {k: v for k, v in recipe.items() if k != \"_key\"}\n    missing_ingredients = []\n    inventory_counts = env._current_state.inventory\n    for ingredient_index, count in required_ingredients.items():\n      if inventory_counts[ingredient_index] < count:\n        missing_ingredients.append((ingredient_index, count - inventory_counts[ingredient_index]))\n    return missing_ingredients\n\n  def move_to(env, target_pos):\n    \"\"\"Generate actions to move the agent to a target position using A* search.\"\"\"\n    from collections import defaultdict\n    import heapq\n    \n    directions = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n    \n    def heuristic(a, b):\n        return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n    start = env._current_state.pos\n    queue = []\n    heapq.heappush(queue, (0, start))\n    came_from = {start: None}\n    cost_so_far = defaultdict(int)\n    cost_so_far[start] = 0\n\n    while queue:\n        current_cost, current = heapq.heappop(queue)\n\n        if current == target_pos:\n            break\n\n        for direction in directions:\n            neighbor = tuple(np.add(current, direction))\n            if (0 <= neighbor[0] < env._current_state.grid.shape[0] and 0 <= neighbor[1] < env._current_state.grid.shape[1] and \n                np.all(env._current_state.grid[neighbor] == 0)):\n                new_cost = cost_so_far[current] + 1\n                if neighbor not in cost_so_far or new_cost < cost_so_far[neighbor]:\n                    cost_so_far[neighbor] = new_cost\n                    priority = new_cost + heuristic(neighbor, target_pos)\n                    heapq.heappush(queue, (priority, neighbor))\n                    came_from[neighbor] = current\n\n    path = []\n    while target_pos:\n        path.append(target_pos)\n        target_pos = came_from[target_pos]\n    \n    return path[::-1]\n\n  def collect_missing_ingredients(env, missing_ingredients) -> list[int]:\n    \"\"\"Generate actions to collect all required ingredients.\"\"\"\n    actions = []\n    for ingredient_index, count in missing_ingredients:\n      ingredient_name = env.world.cookbook.index.get(ingredient_index, \"unknown\")\n      # Collect the ingredient 'count' times\n      for _ in range(count):\n        actions.extend(collect(env, ingredient_name))\n    return actions\n\n  def find_closest_primitive(env, primitive_name) -> tuple[int, int]:\n    \"\"\"Find the closest primitive based on the name.\"\"\"\n    primitive_index = env.world.cookbook.index[primitive_name]\n    primitives = np.argwhere(env._current_state.grid[:, :, primitive_index] > 0)\n    \n    if primitives.size == 0:\n      return None\n    \n    agent_pos = env._current_state.pos\n    distances = np.sum(np.abs(primitives - agent_pos), axis=1)\n    nearest_primitive = tuple(primitives[np.argmin(distances)])\n    \n    return nearest_primitive\n\n  def collect(env, primitive_name) -> list[int]:\n    \"\"\"Generate actions to collect a specific primitive.\"\"\"\n    nearest_primitive = find_closest_primitive(env, primitive_name)\n    if nearest_primitive is None:\n      return []\n    \n    path_to_primitive = move_to(env, nearest_primitive)\n    use_action_index = USE\n    \n    # Return the list of actions including moving to the primitive and using it\n    return [UP if dy < 0 else DOWN if dy > 0 else LEFT if dx < 0 else RIGHT for (dx, dy) in path_to_primitive] + [use_action_index]\n\n  item_index = env.world.cookbook.index[item]\n  \n  recipes = {k: v for k, v in env.world.cookbook.recipes.items() if \"_key\" in v and v[\"_key\"] == item_index}\n  \n  if not recipes:\n    return []\n\n  recipe = next(iter(recipes.values()))\n  missing_ingredients = get_missing_ingredients(recipe)\n\n  actions_to_collect = collect_missing_ingredients(env, missing_ingredients)\n  \n  # Determine which workshop type is needed based on the ingredients\n  workshop_needed = None\n  for ingredient_index in recipe.keys():\n      kind_name = env.world.cookbook.index.get(ingredient_index, \"unknown\")\n      if kind_name.startswith(\"WORKSHOP\"):\n          workshop_needed = ingredient_index\n          break\n\n  if workshop_needed is None:\n      workshop_needed = env.world.workshop_indices[0]\n\n  workshops = np.argwhere(env._current_state.grid[:, :, workshop_needed] > 0)\n  \n  if workshops.size == 0:\n      return []\n\n  agent_pos = env._current_state.pos\n  distances = np.sum(np.abs(workshops - agent_pos), axis=1)\n  nearest_workshop = tuple(workshops[np.argmin(distances)])\n\n  actions_to_workshop = move_to(env, nearest_workshop)\n\n  use_action_index = USE\n\n  return actions_to_collect + actions_to_workshop + [use_action_index]", "island_id": 4, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T23:36:49.098829", "function_name": "craft", "function_body": "  def find_nearest_workshop(state, workshop_indices):\n      min_distance = float('inf')\n      nearest_workshop_pos = None\n      \n      for workshop_idx in workshop_indices:\n          target_pos = find_position_of_kind(env, workshop_idx)\n          distance = np.linalg.norm(np.array(target_pos) - np.array(state.pos))\n          \n          if distance < min_distance:\n              min_distance = distance\n              nearest_workshop_pos = target_pos\n      \n      return nearest_workshop_pos\n\n  def move_to_position(current_pos, target_pos):\n      x_diff = target_pos[0] - current_pos[0]\n      y_diff = target_pos[1] - current_pos[1]\n\n      actions = []\n      \n      if y_diff > 0:\n          actions.extend([craft.UP] * abs(y_diff))\n      elif y_diff < 0:\n          actions.extend([craft.DOWN] * abs(y_diff))\n\n      if x_diff > 0:\n          actions.extend([craft.RIGHT] * abs(x_diff))\n      elif x_diff < 0:\n          actions.extend([craft.LEFT] * abs(x_diff))\n      \n      return actions\n\n  def find_position_of_kind(env, kind_index):\n      # This function needs to be implemented\n      for y in range(env.scenario.init_grid.shape[0]):\n          for x in range(env.scenario.init_grid.shape[1]):\n              if env.scenario.init_grid[y, x, kind_index] > 0:\n                  return (x, y)\n      return None\n\n  actions = []\n  current_state = env._current_state\n  item_index = env.world.cookbook.index[item]\n\n  # Find the workshop index for crafting the item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n  if \"_key\" in recipe:\n      key_workshop = recipe[\"_key\"]\n      workshop_index = env.world.workshop_indices[key_workshop]\n      \n      # Move to the nearest workshop of the required kind if not already next to one\n      if not current_state.next_to(workshop_index):\n          target_pos = find_nearest_workshop(current_state, [workshop_index])\n          actions.extend(move_to_position(current_state.pos, target_pos))\n          \n      # Perform the USE action to craft the item\n      actions.append(craft.USE)\n\n  return actions", "island_id": 8, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T23:36:50.202440", "function_name": "craft", "function_body": "  def find_nearest_workshop(state, workshop_indices):\n      min_distance = float('inf')\n      nearest_workshop_pos = None\n      \n      for workshop_idx in workshop_indices:\n          target_pos = find_position_of_kind(env, workshop_idx)\n          distance = np.linalg.norm(np.array(target_pos) - np.array(state.pos))\n          \n          if distance < min_distance:\n              min_distance = distance\n              nearest_workshop_pos = target_pos\n      \n      return nearest_workshop_pos\n\n  def find_position_of_kind(env, kind_index):\n      \"\"\"Finds the position of a given kind in the environment grid.\"\"\"\n      grid = env._current_state.grid\n      positions = np.argwhere(grid[:, :, kind_index] > 0)\n      \n      if len(positions) == 0:\n          return None\n      \n      # Return the first found position (assuming multiple positions are rare or irrelevant for this task)\n      return tuple(positions[0])\n\n  def move_to_position(current_pos, target_pos):\n      \"\"\"Generates a list of actions to move from current_pos to target_pos.\"\"\"\n      x_diff = target_pos[0] - current_pos[0]\n      y_diff = target_pos[1] - current_pos[1]\n      \n      actions = []\n      \n      # Move horizontally\n      if x_diff > 0:\n          actions.extend([craft.RIGHT] * abs(x_diff))\n      elif x_diff < 0:\n          actions.extend([craft.LEFT] * abs(x_diff))\n      \n      # Move vertically\n      if y_diff > 0:\n          actions.extend([craft.UP] * abs(y_diff))\n      elif y_diff < 0:\n          actions.extend([craft.DOWN] * abs(y_diff))\n      \n      return actions\n\n  actions = []\n  current_state = env._current_state\n\n  # Get the index of the desired item from the cookbook index\n  item_index = env.world.cookbook.index[item]\n\n  # Find the workshop index for crafting the item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n  if \"_key\" in recipe:\n      key_workshop = recipe[\"_key\"]\n      workshop_index = env.world.workshop_indices[key_workshop]\n      \n      # Move to the nearest workshop of the required kind if not already next to one\n      if not current_state.next_to(workshop_index):\n          target_pos = find_nearest_workshop(current_state, [workshop_index])\n          actions.extend(move_to_position(current_state.pos, target_pos))\n          \n      # Perform the USE action to craft the item\n      actions.append(craft.USE)\n\n  return actions", "island_id": 8, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T23:39:23.034545", "function_name": "craft", "function_body": "  def get_workshop_for_item(item_index):\n    # Identify the workshop required for crafting the specified item\n    for workshop, recipes in env.world.cookbook.recipes.items():\n        if '_key' in recipes and item_index == recipes['_key']:\n            return workshop\n    return None\n\n  def find_nearest_workshop(env, workshop_index):\n      # Locate the nearest instance of a workshop on the grid using BFS\n      start = env._current_state.pos\n      queue = collections.deque([start])\n      visited = set()\n      parent = {start: None}\n\n      while queue:\n          current = queue.popleft()\n          if current in visited:\n              continue\n          visited.add(current)\n\n          # Explore neighboring cells\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              if not is_within_bounds(env._current_state.grid.shape, neighbor) or neighbor in visited:\n                  continue\n\n              # Check if the neighboring cell contains the required workshop\n              if env._current_state.grid[current[1] + dy, current[0] + dx, workshop_index] > 0:\n                  return reconstruct_path(parent, start, neighbor)\n\n              queue.append(neighbor)\n              parent[neighbor] = current\n\n      return None\n\n  def is_within_bounds(grid_shape, position):\n      # Verify if the given position is within the grid boundaries\n      x, y = position\n      return 0 <= x < grid_shape[1] and 0 <= y < grid_shape[0]\n\n  def reconstruct_path(parent, start, goal):\n      # Reconstruct the path from `start` to `goal` using the parent dictionary\n      path = []\n      current = goal\n      while current != start:\n          path.append(current)\n          current = parent[current]\n      path.reverse()\n      return path\n\n  def navigate_to(env, location):\n      # Navigate the agent from its current position to the specified `location`\n      current_pos = env._current_state.pos\n      path = find_path(env._current_state.grid.shape, current_pos, location)\n      \n      actions = []\n      for i in range(1, len(path)):\n          dx = path[i][0] - path[i-1][0]\n          dy = path[i][1] - path[i-1][1]\n\n          # Convert grid movements to corresponding action indices\n          if (dx, dy) == (-1, 0):\n              actions.append(env.N_ACTIONS - 4)\n          elif (dx, dy) == (1, 0):\n              actions.append(env.N_ACTIONS - 3)\n          elif (dx, dy) == (0, -1):\n              actions.append(env.N_ACTIONS - 2)\n          elif (dx, dy) == (0, 1):\n              actions.append(env.N_ACTIONS - 1)\n\n      return actions\n\n  def find_path(grid_shape, start, end):\n      # Use A* search to find the shortest path from `start` to `end`\n      open_set = collections.PriorityQueue()\n      open_set.put((0, start))\n      came_from = {}\n      cost_so_far = {}\n      came_from[start] = None\n      cost_so_far[start] = 0\n\n      while not open_set.empty():\n          _, current = open_set.get()\n\n          if current == end:\n              break\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              new_cost = cost_so_far[current] + heuristic(current, neighbor)\n\n              if is_within_bounds(grid_shape, neighbor) and (neighbor not in cost_so_far or new_cost < cost_so_far[neighbor]):\n                  cost_so_far[neighbor] = new_cost\n                  priority = new_cost + heuristic(end, neighbor)\n                  open_set.put((priority, neighbor))\n                  came_from[neighbor] = current\n\n      return reconstruct_path(came_from, start, end)\n\n  def heuristic(a, b):\n      # Calculate the Manhattan distance between two points `a` and `b`\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Determine if any workshop is required for crafting this item\n  workshop_index = get_workshop_for_item(item_index)\n\n  actions = []\n\n  if workshop_index is not None:\n      # Find the nearest workshop of the required type\n      nearest_workshop_location = find_nearest_workshop(env, workshop_index)\n      \n      if nearest_workshop_location is not None:\n          # Navigate to the workshop location\n          actions.extend(navigate_to(env, nearest_workshop_location))\n          \n          # Use the workshop to craft the item\n          actions.append(env.N_ACTIONS - 5)  # USE action index\n  else:\n    # No specific workshop needed; likely a primitive item that can be crafted directly from available primitives (e.g., STICK from WOOD)\n    actions.append(env.N_ACTIONS - 5)  # USE action index\n\n  return actions", "island_id": 9, "scores": {"": -1}}
{"timestamp": "2025-09-02T23:39:24.138850", "function_name": "craft", "function_body": "  def get_workshop_for_item(item_index):\n    # Iterate through recipes to find the workshop needed for crafting the specified item.\n    for workshop, recipe in env.world.cookbook.recipes.items():\n        if '_key' in recipe and recipe['_key'] == item_index:\n            return workshop\n    return None\n\n  def find_nearest_workshop(env, workshop_index):\n    # Use BFS to find the nearest instance of a workshop with index `workshop_index`.\n    start = env._current_state.pos\n    queue = collections.deque([start])\n    visited = set()\n    parent = {start: None}\n\n    while queue:\n        current = queue.popleft()\n        if current in visited:\n            continue\n        visited.add(current)\n\n        # Check all four neighboring cells\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            neighbor = (current[0] + dx, current[1] + dy)\n            if not is_within_bounds(env._current_state.grid.shape, neighbor) or neighbor in visited:\n                continue\n\n            # If we find a workshop at this cell, reconstruct the path to it\n            if env._current_state.grid[current[1] + dy, current[0] + dx, workshop_index] > 0:\n                return reconstruct_path(parent, start, neighbor)\n\n            queue.append(neighbor)\n            parent[neighbor] = current\n\n    return None\n\n  def is_within_bounds(grid_shape, position):\n      x, y = position\n      return 0 <= x < grid_shape[1] and 0 <= y < grid_shape[0]\n\n  def reconstruct_path(parent, start, goal):\n      # Reconstruct the path from start to goal using the parent map.\n      path = []\n      current = goal\n      while current != start:\n          path.append(current)\n          current = parent[current]\n      path.reverse()\n      return path\n\n  def navigate_to(env, location):\n      # Navigate the agent from its current position to the given `location`.\n      current_pos = env._current_state.pos\n      path = find_path(env._current_state.grid.shape, current_pos, location)\n\n      actions = []\n      for i in range(1, len(path)):\n          dx = path[i][0] - path[i-1][0]\n          dy = path[i][1] - path[i-1][1]\n\n          # Map the movement to an action index\n          if (dx, dy) == (-1, 0):\n              actions.append(env.action_specs()['LEFT'])\n          elif (dx, dy) == (1, 0):\n              actions.append(env.action_specs()['RIGHT'])\n          elif (dx, dy) == (0, -1):\n              actions.append(env.action_specs()['UP'])\n          elif (dx, dy) == (0, 1):\n              actions.append(env.action_specs()['DOWN'])\n\n      return actions\n\n  def find_path(grid_shape, start, end):\n      # Use A* search to find the shortest path from `start` to `end`.\n      open_set = collections.PriorityQueue()\n      open_set.put((0, start))\n      came_from = {}\n      cost_so_far = {}\n      came_from[start] = None\n      cost_so_far[start] = 0\n\n      while not open_set.empty():\n          _, current = open_set.get()\n\n          if current == end:\n              break\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              new_cost = cost_so_far[current] + heuristic(current, neighbor)\n\n              if is_within_bounds(grid_shape, neighbor) and (neighbor not in cost_so_far or new_cost < cost_so_far[neighbor]):\n                  cost_so_far[neighbor] = new_cost\n                  priority = new_cost + heuristic(end, neighbor)\n                  open_set.put((priority, neighbor))\n                  came_from[neighbor] = current\n\n      return reconstruct_path(came_from, start, end)\n\n  def heuristic(a, b):\n      # Calculate the Manhattan distance between two points.\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def collect_primitives(env, primitives):\n      # Collect all necessary primitives for crafting the item.\n      actions = []\n      for primitive in primitives:\n          # Find and navigate to each required primitive\n          location = find_nearest_primitive(env, primitive)\n          if location is not None:\n              actions.extend(navigate_to(env, location))\n              actions.append(env.action_specs()['USE'])\n      return actions\n\n  def find_nearest_primitive(env, primitive_index):\n      # Use BFS to find the nearest instance of a primitive with index `primitive_index`.\n      start = env._current_state.pos\n      queue = collections.deque([start])\n      visited = set()\n      parent = {start: None}\n\n      while queue:\n          current = queue.popleft()\n          if current in visited:\n              continue\n          visited.add(current)\n\n          # Check all four neighboring cells\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              if not is_within_bounds(env._current_state.grid.shape, neighbor) or neighbor in visited:\n                  continue\n\n              # If we find a primitive at this cell, reconstruct the path to it\n              if env._current_state.grid[current[1] + dy, current[0] + dx, primitive_index] > 0:\n                  return reconstruct_path(parent, start, neighbor)\n\n              queue.append(neighbor)\n              parent[neighbor] = current\n\n      return None\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Find the workshop that allows crafting this item (if any)\n  workshop_index = get_workshop_for_item(item_index)\n\n  actions = []\n\n  if workshop_index is not None:\n      # Check if all primitives required for the item are in inventory\n      primitives_needed = [key for key, value in env.world.cookbook.recipes[workshop_index].items() if key != '_key']\n      primitives_in_inventory = [env._current_state.inventory.get(key, 0) > 0 for key in primitives_needed]\n\n      # Collect missing primitives if necessary\n      if not all(primitives_in_inventory):\n          actions.extend(collect_primitives(env, primitives_needed))\n      \n      # Get the location of the nearest workshop of the required type\n      nearest_workshop_location = find_nearest_workshop(env, workshop_index)\n      \n      if nearest_workshop_location is not None:\n          # Navigate to the workshop location\n          actions.extend(navigate_to(env, nearest_workshop_location))\n          \n          # Use the workshop to craft the item\n          actions.append(env.action_specs()['USE'])\n  else:\n    # No specific workshop needed, likely a primitive item that can be crafted anywhere (e.g., STICK from WOOD)\n    actions.append(env.action_specs()['USE'])\n\n  return actions", "island_id": 9, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T23:39:54.326602", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Find a workshop that can craft the item\n  available_workshops = []\n  for i in range(len(env.world.workshop_indices)):\n      workshop_index = env.world.workshop_indices[i]\n      \n      # Check if any recipe uses this workshop as an ingredient or output\n      recipes_using_workshop = [recipe for recipe in env.world.cookbook.recipes.values() if workshop_index in recipe.values()]\n      if len(recipes_using_workshop) > 0:\n          available_workshops.append(workshop_index)\n\n  if not available_workshops:\n      raise ValueError(f\"No workshop found that can craft {item}.\")\n\n  # Choose the first available workshop\n  chosen_workshop = available_workshops[0]\n\n  # Find the position of the chosen workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, chosen_workshop] > 0)\n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No instance of workshop {chosen_workshop} found in the grid.\")\n\n  # Choose the first occurrence of the workshop\n  target_pos = tuple(workshop_positions[0])\n\n  # Generate actions to move towards the chosen workshop\n  actions_to_target = generate_movement_actions(env._current_state, target_pos)\n\n  # Add the USE action to craft the item at the workshop\n  actions_to_target.append(4)  # USE\n\n  return actions_to_target", "island_id": 0, "scores": {"": -1}}
{"timestamp": "2025-09-02T23:39:55.369216", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get index for desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Assuming we have all ingredients in the inventory\n\n  # Identify required workshop based on recipe (if any)\n  recipe = env.world.cookbook.recipes.get(item_index)\n  if recipe:\n    _key = recipe.get(\"_key\")\n    if _key is not None:\n      workshop_name = f\"WORKSHOP{_key}\"\n      workshop_index = env.world.cookbook.index[workshop_name]\n      # Move to the workshop\n      actions.extend(move_to_workshop(env, workshop_index))\n  \n  # Craft the item by using USE action\n  actions.append(4)  # Use action\n  \n  return actions", "island_id": 0, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T23:40:30.214582", "function_name": "craft", "function_body": "  def find_workshop_index(item):\n    # Assuming there is a way to determine which workshop is needed for an item\n    # This is a placeholder function; you need to implement this logic\n    cookbook = env.world.cookbook.recipes\n    for recipe in cookbook.values():\n        if \"_key\" in recipe and recipe[\"_key\"] == item:\n            return recipe[\"workshop_index\"]\n    return None\n\n  def go_to_workshop(workshop_index):\n      # This function should return a list of actions to navigate the agent to the specified workshop\n      # Placeholder: Assume we have a pathfinding algorithm that returns a list of directions\n      return []\n\n  item_index = env.world.cookbook.index[item]\n  workshop_index = find_workshop_index(item)\n  \n  if workshop_index is None:\n    raise ValueError(f\"No recipe found for {item} or its required workshop.\")\n\n  actions_to_workshop = go_to_workshop(workshop_index)\n  action_use = craft.USE\n  return actions_to_workshop + [action_use]", "island_id": 1, "scores": {"": -1}}
{"timestamp": "2025-09-02T23:40:31.179722", "function_name": "craft", "function_body": "  # Define actions for moving in different directions\n  UP = env.world.N_ACTIONS - 5\n  DOWN = env.world.N_ACTIONS - 4\n  LEFT = env.world.N_ACTIONS - 3\n  RIGHT = env.world.N_ACTIONS - 2\n\n  USE = env.world.N_ACTIONS - 1\n\n  # Get the index of the desired item to craft\n  item_index = env.world.cookbook.index[item]\n\n  # Determine which workshop is needed for crafting this item\n  required_workshop_indices = [\n      i for i, recipe in enumerate(env.world.workshop_indices) if recipe == item_index\n  ]\n\n  # If no specific workshop is found, use the first one as a default\n  workshop_index = env.world.workshop_indices[0] if not required_workshop_indices else required_workshop_indices[0]\n\n  # Get the position of the workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n      raise ValueError(\"No available workshop for crafting.\")\n\n  # Choose the first available workshop position\n  workshop_pos = tuple(workshop_positions[0])\n\n  # Calculate the path to the nearest workshop\n  start_pos = env._current_state.pos\n  path_to_workshop = bfs(env._current_state.grid, start_pos, workshop_pos)\n\n  actions = []\n  for move in path_to_workshop:\n      if move == (start_pos[0], start_pos[1] - 1):\n          actions.append(UP)\n      elif move == (start_pos[0], start_pos[1] + 1):\n          actions.append(DOWN)\n      elif move == (start_pos[0] - 1, start_pos[1]):\n          actions.append(LEFT)\n      elif move == (start_pos[0] + 1, start_pos[1]):\n          actions.append(RIGHT)\n      start_pos = move\n\n  # Add the USE action to craft the item\n  actions.append(USE)\n\n  return actions", "island_id": 1, "scores": {"": -1}}
{"timestamp": "2025-09-02T23:42:08.786946", "function_name": "craft", "function_body": "  # Define constants for the environment\n  UP = env.N_ACTIONS - 4\n  DOWN = env.N_ACTIONS - 3\n  LEFT = env.N_ACTIONS - 2\n  RIGHT = env.N_ACTIONS - 1\n  USE = env.N_ACTIONS - 5\n\n  # Get item index from the cookbook\n  item_index = env.world.cookbook.index[item]\n\n  # Find the workshop required for crafting this item\n  recipes = env.world.cookbook.recipes\n  workshop_indices = env.world.workshop_indices\n\n  # Determine the workshop that can craft the desired item\n  workshop_required_for_item = None\n  for recipe in recipes:\n    if \"_key\" in recipes[recipe]:\n      key = recipes[recipe][\"_key\"]\n      if key == item_index and recipe in workshop_indices:\n        workshop_required_for_item = recipe\n        break\n\n  # If no specific workshop is required, assume any workshop can craft it\n  if workshop_required_for_item is None:\n    for workshop_index in workshop_indices:\n      if item_index in recipes.get(workshop_index, {}):\n        workshop_required_for_item = workshop_index\n        break\n\n  # Validate that a suitable workshop was found\n  if workshop_required_for_item is None:\n    raise ValueError(f\"No suitable workshop found to craft {item}.\")\n\n  # Get the current position of the agent\n  current_pos = env._current_state.pos\n\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star_search(start, goal):\n    open_set = collections.PriorityQueue()\n    open_set.put((0, start))\n    came_from = {}\n    cost_so_far = {}\n    came_from[start] = None\n    cost_so_far[start] = 0\n\n    while not open_set.empty():\n        _, current = open_set.get()\n\n        if current == goal:\n            break\n\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            neighbor = (current[0] + dx, current[1] + dy)\n            new_cost = cost_so_far[current] + heuristic(current, neighbor)\n\n            if neighbor not in cost_so_far or new_cost < cost_so_far[neighbor]:\n                cost_so_far[neighbor] = new_cost\n                priority = new_cost + heuristic(goal, neighbor)\n                open_set.put((priority, neighbor))\n                came_from[neighbor] = current\n\n    return reconstruct_path(came_from, start, goal)\n\n  def reconstruct_path(came_from, start, goal):\n      current = goal\n      path = []\n      while current != start:\n          path.append(current)\n          current = came_from[current]\n      path.append(start)\n      path.reverse()\n      return path\n\n  # Calculate the position of the workshop on the grid\n  workshop_pos = None\n  for y in range(env._current_state.grid.shape[0]):\n    for x in range(env._current_state.grid.shape[1]):\n      if env._current_state.grid[y, x, workshop_required_for_item] > 0:\n        workshop_pos = (x, y)\n        break\n    if workshop_pos is not None:\n        break\n\n  # Validate that the workshop position was found\n  if workshop_pos is None:\n    raise ValueError(f\"No workshop of type {workshop_required_for_item} found on the grid.\")\n\n  # Find the path to the workshop\n  path_to_workshop = a_star_search(current_pos, workshop_pos)\n\n  # Map direction changes to actions\n  action_map = {(0, -1): UP, (0, 1): DOWN, (-1, 0): LEFT, (1, 0): RIGHT}\n\n  # Convert the path into a list of actions\n  actions_to_workshop = []\n  for i in range(1, len(path_to_workshop)):\n      dx = path_to_workshop[i][0] - path_to_workshop[i-1][0]\n      dy = path_to_workshop[i][1] - path_to_workshop[i-1][1]\n      if (dx, dy) in action_map:\n          actions_to_workshop.append(action_map[(dx, dy)])\n\n  # Add the USE action to craft the item\n  actions_to_workshop.append(USE)\n\n  return actions_to_workshop", "island_id": 9, "scores": {"": -1}}
{"timestamp": "2025-09-02T23:42:09.838531", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n\n  # Find the workshop required for crafting this item\n  recipes = env.world.cookbook.recipes\n  workshop_indices = env.world.workshop_indices\n\n  workshop_required_for_item = None\n  for recipe in recipes:\n    if \"_key\" in recipes[recipe]:\n      key = recipes[recipe][\"_key\"]\n      if key == item_index and recipe in workshop_indices:\n        workshop_required_for_item = recipe\n        break\n\n  # If no workshop is required, return an empty list (item can be crafted directly)\n  if workshop_required_for_item is None:\n    return []\n\n  # Get the current position of the agent\n  current_pos = env._current_state.pos\n  \n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star_search(start, goal):\n    open_set = collections.PriorityQueue()\n    open_set.put((0, start))\n    came_from = {}\n    cost_so_far = {}\n    came_from[start] = None\n    cost_so_far[start] = 0\n\n    while not open_set.empty():\n        _, current = open_set.get()\n\n        if current == goal:\n            break\n\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            neighbor = (current[0] + dx, current[1] + dy)\n            new_cost = cost_so_far[current] + heuristic(current, neighbor)\n\n            if neighbor not in cost_so_far or new_cost < cost_so_far[neighbor]:\n                cost_so_far[neighbor] = new_cost\n                priority = new_cost + heuristic(goal, neighbor)\n                open_set.put((priority, neighbor))\n                came_from[neighbor] = current\n\n    return reconstruct_path(came_from, start, goal)\n\n  def reconstruct_path(came_from, start, goal):\n      current = goal\n      path = []\n      while current != start:\n          path.append(current)\n          current = came_from[current]\n      path.reverse()\n      return path\n\n  # Calculate the position of the workshop on the grid\n  workshop_pos = None\n  for y in range(env._current_state.grid.shape[0]):\n    for x in range(env._current_state.grid.shape[1]):\n      if env._current_state.grid[y, x, workshop_required_for_item] > 0:\n        workshop_pos = (x, y)\n        break\n    if workshop_pos is not None:\n        break\n\n  # If no workshop is found on the grid, return an empty list\n  if workshop_pos is None:\n    return []\n\n  # Find the path to the workshop\n  path_to_workshop = a_star_search(current_pos, workshop_pos)\n\n  action_map = {(-1, 0): env.N_ACTIONS - 4, (1, 0): env.N_ACTIONS - 3, (0, -1): env.N_ACTIONS - 2, (0, 1): env.N_ACTIONS - 1}\n  actions_to_workshop = []\n  for i in range(1, len(path_to_workshop)):\n      dx = path_to_workshop[i][0] - path_to_workshop[i-1][0]\n      dy = path_to_workshop[i][1] - path_to_workshop[i-1][1]\n      if (dx, dy) in action_map:\n          actions_to_workshop.append(action_map[(dx, dy)])\n\n  # Add the USE action to craft the item\n  actions_to_workshop.append(env.N_ACTIONS - 5)\n\n  return actions_to_workshop", "island_id": 9, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T23:43:32.958266", "function_name": "craft", "function_body": "  def get_workshop_for_item(item_index):\n    for recipe in env.world.cookbook.recipes.values():\n        if '_key' in recipe and item_index == recipe['_key']:\n            return recipe[\"workshop\"]\n    return None\n\n  def find_nearest_workshop(env, workshop_type_index):\n      # Retrieve the list of all workshops of this type from the world configuration\n      workshop_locations = []\n      for y in range(env._current_state.grid.shape[0]):\n          for x in range(env._current_state.grid.shape[1]):\n              if env._current_state.grid[y, x, workshop_type_index] > 0:\n                  workshop_locations.append((x, y))\n      \n      current_pos = env._current_state.pos\n      \n      # Find the nearest workshop location to the agent's current position\n      nearest_workshop_location = min(workshop_locations, key=lambda loc: np.linalg.norm(np.array(loc) - np.array(current_pos)))\n      \n      return nearest_workshop_location\n\n  def navigate_to(env, target_position):\n    current_pos = env._current_state.pos\n    path = a_star_search(current_pos, target_position)\n    \n    action_map = {(-1, 0): env.action_specs()['UP'], \n                  (1, 0): env.action_specs()['DOWN'],\n                  (0, -1): env.action_specs()['LEFT'],\n                  (0, 1): env.action_specs()['RIGHT']}\n    actions_to_target = []\n    for i in range(1, len(path)):\n        dx = path[i][0] - path[i-1][0]\n        dy = path[i][1] - path[i-1][1]\n        if (dx, dy) in action_map:\n            actions_to_target.append(action_map[(dx, dy)])\n    \n    return actions_to_target\n\n  item_index = env.world.cookbook.index[item]\n\n  # Find the workshop that allows crafting this item\n  workshop_type_index = get_workshop_for_item(item_index)\n\n  actions = []\n\n  if workshop_type_index is not None:\n      # Get the location of the nearest workshop of the required type\n      nearest_workshop_location = find_nearest_workshop(env, workshop_type_index)\n      \n      # Navigate to the workshop location\n      actions.extend(navigate_to(env, nearest_workshop_location))\n      \n      # Use the workshop to craft the item\n      actions.append(env.action_specs()['USE'])\n  \n  return actions", "island_id": 9, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T23:43:34.044840", "function_name": "craft", "function_body": "  def get_workshop_for_item(item_index):\n    for workshop, recipes in env.world.cookbook.recipes.items():\n        if '_key' in recipes and item_index == recipes['_key']:\n            return workshop\n    return None\n\n  def find_nearest_workshop(env, workshop_type_index):\n      current_pos = env._current_state.pos\n      \n      # Find the nearest workshop location to the agent's current position\n      distances = {loc: np.linalg.norm(np.array(loc) - np.array(current_pos)) for loc in env.world.workshop_indices[workshop_type_index]}\n      \n      nearest_workshop_location = min(distances, key=distances.get)\n      \n      return nearest_workshop_location\n\n  def navigate_to(env, target_location):\n    # Convert the navigation problem into a grid traversal problem\n    current_pos = env._current_state.pos\n    \n    # Find the shortest path using A* algorithm or similar\n    def heuristic(a, b):\n        return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n    def a_star_search(start, goal):\n      open_set = collections.PriorityQueue()\n      open_set.put((0, start))\n      came_from = {}\n      cost_so_far = {}\n      came_from[start] = None\n      cost_so_far[start] = 0\n\n      while not open_set.empty():\n          _, current = open_set.get()\n\n          if current == goal:\n              break\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              new_cost = cost_so_far[current] + heuristic(current, neighbor)\n\n              if neighbor not in cost_so_far or new_cost < cost_so_far[neighbor]:\n                  cost_so_far[neighbor] = new_cost\n                  priority = new_cost + heuristic(goal, neighbor)\n                  open_set.put((priority, neighbor))\n                  came_from[neighbor] = current\n\n      return reconstruct_path(came_from, start, goal)\n\n    def reconstruct_path(came_from, start, goal):\n      current = goal\n      path = []\n      while current != start:\n          path.append(current)\n          current = came_from[current]\n      path.append(start)\n      path.reverse()\n      return path\n\n    # Calculate the path to the target location\n    path_to_target = a_star_search(current_pos, target_location)\n\n    # Convert the path into actions (UP, DOWN, LEFT, RIGHT)\n    action_map = {(-1, 0): env.N_ACTIONS - 4, (1, 0): env.N_ACTIONS - 3, (0, -1): env.N_ACTIONS - 2, (0, 1): env.N_ACTIONS - 1}\n    actions_to_target = []\n    for i in range(1, len(path_to_target)):\n        dx = path_to_target[i][0] - path_to_target[i-1][0]\n        dy = path_to_target[i][1] - path_to_target[i-1][1]\n        if (dx, dy) in action_map:\n            actions_to_target.append(action_map[(dx, dy)])\n\n    return actions_to_target\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Find the workshop that allows crafting this item (if any)\n  workshop_type_index = get_workshop_for_item(item_index)\n\n  actions = []\n\n  if workshop_type_index is not None:\n      # Get the location of the nearest workshop of the required type\n      nearest_workshop_location = find_nearest_workshop(env, workshop_type_index)\n      \n      # Navigate to the workshop location\n      actions.extend(navigate_to(env, nearest_workshop_location))\n      \n      # Use the workshop to craft the item\n      actions.append(env.action_specs()['USE'])\n  \n  return actions", "island_id": 9, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T23:44:55.265470", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n\n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      # Move horizontally first\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      \n      # Then move vertically\n      if dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n\n      current_pos = (current_pos[0] + (dx // abs(dx)) if dx != 0 else current_pos[0],\n                     current_pos[1] + (dy // abs(dy)) if dy != 0 else current_pos[1])\n      \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  # This step assumes that the recipe specifies the workshop type needed.\n  # Since the problem does not specify how to determine the workshop,\n  # we will assume that all workshops can craft any items for simplicity.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 7, "scores": {"": 4.7}}
{"timestamp": "2025-09-02T23:44:56.316635", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      # Determine the direction to move with priority: RIGHT/LEFT > UP/DOWN\n      if abs(dx) >= abs(dy):\n        if dx > 0:\n          actions.append(3)  # RIGHT\n        else:\n          actions.append(2)  # LEFT\n      elif abs(dy) > abs(dx):\n        if dy > 0:\n          actions.append(1)  # UP\n        else:\n          actions.append(0)  # DOWN\n\n      current_pos = (current_pos[0] + (dx // abs(dx)) if dx != 0 else current_pos[0],\n                     current_pos[1] + (dy // abs(dy)) if dy != 0 else current_pos[1])\n      \n    return actions\n\n  def move_and_craft(env, item_index):\n    grid = env._current_state.grid\n    pos = env._current_state.pos\n    \n    # Find the closest workshop\n    closest_workshop_pos = find_closest_workshop(grid, pos)\n\n    if not closest_workshop_pos:\n      raise ValueError(\"No available workshops found on the grid.\")\n    \n    # Move to the closest workshop\n    actions_to_workshop = move_to(env, closest_workshop_pos)\n    \n    # Use the USE action to craft the item at the workshop\n    actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n    \n    return actions_to_workshop\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  # This step assumes that the recipe specifies the workshop type needed.\n  # Since the problem does not specify how to determine the workshop,\n  # we will assume that all workshops can craft any items for simplicity.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  return move_and_craft(env, item_index)", "island_id": 7, "scores": {"": 0.7}}
{"timestamp": "2025-09-02T23:45:52.195520", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get index for desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Assuming we have all ingredients in the inventory\n\n  # Identify required workshop based on recipe (if any)\n  recipe = env.world.cookbook.recipes.get(item_index)\n  if recipe:\n    _key = recipe.get(\"_key\")\n    if _key is not None:\n      workshop_name = f\"WORKSHOP{_key}\"\n      workshop_index = env.world.cookbook.index[workshop_name]\n      # Move to the workshop\n      actions.extend(move_to_workshop(env, workshop_index))\n  \n  # Craft the item by using USE action\n  actions.append(4)  # Use action\n  \n  return actions", "island_id": 0, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T23:45:53.240302", "function_name": "craft", "function_body": "  def move_to_workshop(state, workshop_index):\n    actions = []\n    grid = state.grid\n    pos = state.pos\n    dir = state.dir\n    n_kinds = state.world.cookbook.n_kinds\n    \n    # Find the nearest workshop cell index in the grid\n    workshop_cells = np.argwhere(grid[:, :, workshop_index] > 0)\n    \n    if len(workshop_cells) == 0:\n      raise ValueError(\"No workshops found for this item.\")\n    \n    closest_workshop = min(workshop_cells, key=lambda x: (x[0]-pos[0])**2 + (x[1]-pos[1])**2)\n    \n    # Calculate the path to the nearest workshop\n    path = astar(grid, pos, closest_workshop, n_kinds)\n    \n    for step in path:\n      if step == pos:\n        continue\n      \n      dx, dy = step[0] - pos[0], step[1] - pos[1]\n      \n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      elif dy > 0:\n          actions.append(0)  # DOWN\n      elif dy < 0:\n          actions.append(1)  # UP\n      \n      pos = step\n    \n    return actions\n\n  def astar(grid, start, goal, n_kinds):\n    open_set = collections.PriorityQueue()\n    open_set.put((0, start))\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, goal)}\n    \n    while not open_set.empty():\n        _, current = open_set.get()\n\n        if current == goal:\n            return reconstruct_path(came_from, current)\n        \n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            neighbor = (current[0] + dx, current[1] + dy)\n            \n            if not (0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]):\n                continue\n            \n            tentative_g_score = g_score[current] + 1\n            if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                came_from[neighbor] = current\n                g_score[neighbor] = tentative_g_score\n                f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                open_set.put((f_score[neighbor], neighbor))\n    \n    return []\n\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def reconstruct_path(came_from, current):\n      total_path = [current]\n      while current in came_from:\n          current = came_from[current]\n          total_path.append(current)\n      return list(reversed(total_path))\n  \n  actions = []\n  \n  # Get index for desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Assuming we have all ingredients in the inventory\n\n  # Identify required workshop based on recipe (if any)\n  recipe = env.world.cookbook.recipes.get(item_index)\n  if recipe:\n    _key = recipe.get(\"_key\")\n    if _key is not None:\n      workshop_name = f\"WORKSHOP{_key}\"\n      workshop_index = env.world.cookbook.index[workshop_name]\n      # Move to the workshop\n      actions.extend(move_to_workshop(env._current_state, workshop_index))\n  \n  # Craft the item by using USE action\n  actions.append(4)  # Use action\n  \n  return actions", "island_id": 0, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T23:47:02.902757", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    \"\"\"Moves the agent towards the target position using a simple Manhattan pathfinding strategy.\"\"\"\n    current_pos = env._current_state.pos\n    actions = []\n\n    while current_pos != target_pos:\n      # Calculate direction to move\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if abs(dx) > abs(dy):\n        if dx > 0:\n          actions.append(3)  # RIGHT\n        else:\n          actions.append(2)  # LEFT\n      else:\n        if dy > 0:\n          actions.append(1)  # UP\n        else:\n          actions.append(0)  # DOWN\n\n      current_pos = (current_pos[0] + (dx // abs(dx)) if dx != 0 else current_pos[0],\n                     current_pos[1] + (dy // abs(dy)) if dy != 0 else current_pos[1])\n      \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  # This step assumes that the recipe specifies the workshop type needed.\n  # Since the problem does not specify how to determine the workshop,\n  # we will assume that all workshops can craft any items for simplicity.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 6, "scores": {"": 0.90000004}}
{"timestamp": "2025-09-02T23:47:03.958232", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Iterate over all positions to find the closest workshop\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    # Simple pathfinding logic: moves towards the target position using A* or similar\n    current_pos = env._current_state.pos\n    actions = []\n\n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if abs(dx) > abs(dy):\n        if dx > 0:\n          actions.append(3)  # RIGHT\n        else:\n          actions.append(2)  # LEFT\n      else:\n        if dy > 0:\n          actions.append(1)  # UP\n        else:\n          actions.append(0)  # DOWN\n\n      current_pos = (current_pos[0] + (dx // abs(dx)) if dx != 0 else current_pos[0],\n                     current_pos[1] + (dy // abs(dy)) if dy != 0 else current_pos[1])\n      \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 6, "scores": {"": 0.90000004}}
{"timestamp": "2025-09-02T23:47:51.564348", "function_name": "craft", "function_body": "  def navigate_to_workshop(workshop_index):\n    # Determine the position of the workshop\n    pos = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)[0]\n    \n    # Calculate the path to the workshop (simple BFS for demonstration)\n    queue = collections.deque([env._current_state.pos])\n    visited = set()\n    parent_map = {env._current_state.pos: None}\n    \n    while queue:\n        current_pos = queue.popleft()\n        if tuple(current_pos) == tuple(pos):\n            break\n        visited.add(tuple(current_pos))\n        \n        # Explore neighbors\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            new_x = current_pos[0] + dx\n            new_y = current_pos[1] + dy\n            if 0 <= new_x < env._current_state.grid.shape[0] and 0 <= new_y < env._current_state.grid.shape[1]:\n                new_pos = (new_x, new_y)\n                if tuple(new_pos) not in visited:\n                    queue.append(new_pos)\n                    parent_map[new_pos] = current_pos\n    \n    # Reconstruct path\n    path = []\n    while pos is not None:\n        path.append(pos)\n        pos = parent_map[tuple(pos)]\n    \n    actions = []\n    for new_pos in reversed(path[1:]):\n        delta_x = new_pos[0] - env._current_state.pos[0]\n        delta_y = new_pos[1] - env._current_state.pos[1]\n        \n        if delta_x == 1:\n            actions.append(env.action_specs()['RIGHT'])\n        elif delta_x == -1:\n            actions.append(env.action_specs()['LEFT'])\n        elif delta_y == 1:\n            actions.append(env.action_specs()['DOWN'])\n        elif delta_y == -1:\n            actions.append(env.action_specs()['UP'])\n    \n    return actions\n\n  # Get the workshop index needed for crafting\n  workshop_index = env.world.cookbook.workshop_indices[item]\n  \n  # Navigate to the workshop\n  actions = navigate_to_workshop(workshop_index)\n  \n  # Add the USE action to craft the item\n  actions.append(env.action_specs()['USE'])\n  \n  return actions", "island_id": 3, "scores": {"": -1}}
{"timestamp": "2025-09-02T23:47:52.523843", "function_name": "craft", "function_body": "  # Get the index for the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Find the recipe for the item in the cookbook recipes\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"No recipe found for item: {item}\")\n\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Initialize actions list\n  actions = []\n\n  # Check if there's a specific workshop required\n  if \"_key\" in recipe and recipe[\"_key\"] != \"none\":\n      key = recipe[\"_key\"]\n      # Get the index for the workshop associated with the key (e.g., WORKSHOP0)\n      workshop_index = env.world.cookbook.index[key]\n      \n      # Find the position of a cell containing the required workshop\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n      if len(workshop_positions) > 0:\n          target_pos = tuple(workshop_positions[0])\n\n          # Calculate the relative direction to the workshop from the current position\n          current_pos = env._current_state.pos\n          dx, dy = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n          \n          # Add actions to move towards the workshop\n          if dy > 0:\n              actions.extend([UP] * abs(dy))\n          elif dy < 0:\n              actions.extend([DOWN] * abs(dy))\n          if dx > 0:\n              actions.extend([RIGHT] * abs(dx))\n          elif dx < 0:\n              actions.extend([LEFT] * abs(dx))\n\n          # Add the USE action to interact with the workshop\n          actions.append(USE)\n      else:\n          raise ValueError(f\"No workshop found for key: {key}\")\n  else:\n      # If no specific workshop is required, just use the USE action at the current position\n      actions.append(USE)\n\n  return actions", "island_id": 3, "scores": {"": -1}}
{"timestamp": "2025-09-02T23:48:25.549660", "function_name": "craft", "function_body": "  # Convert item name to index\n  item_index = env.world.cookbook.index[item]\n\n  # Find which workshop is needed for this item (if any)\n  workshop_needed = None\n  for recipe_output, ingredients in env.world.cookbook.recipes.items():\n    if \"_key\" in ingredients and ingredients[\"_key\"] == item:\n      workshop_needed = int(ingredients[\"\"])\n      break\n\n  actions = []\n  \n  # If a workshop is needed, move to the nearest one\n  if workshop_needed:\n      closest_workshop = None\n      min_distance = float('inf')\n      \n      for i in range(len(env.world.workshop_indices)):\n          if env.world.workshop_indices[i] == workshop_needed:\n              pos = find_nearest_workshop_position(env.world.grid, env._current_state.pos, i)\n              distance = abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n              \n              if distance < min_distance:\n                  closest_workshop = pos\n                  min_distance = distance\n      \n      # Move to the nearest workshop\n      actions.extend(move_to_position(env, closest_workshop))\n\n  # Perform the USE action to craft the item\n  actions.append(craft.ACTIONS[\"USE\"])\n\n  return actions", "island_id": 5, "scores": {"": -1}}
{"timestamp": "2025-09-02T23:48:26.610711", "function_name": "craft", "function_body": "  def get_workshop_index(item):\n    # Find the workshop index required for crafting the item\n    recipe = env.world.cookbook.recipes[env.world.cookbook.index[item]]\n    for ingredient in recipe:\n        if isinstance(ingredient, str) and \"workshop\" in ingredient:\n            return env.world.workshop_indices[int(ingredient[-1])]\n    raise ValueError(f\"No workshop found for crafting {item}\")\n\n  def navigate_to_workshop(workshop_index):\n    # Navigate to the workshop using a simple heuristic (closest path)\n    pos = np.array(env._current_state.pos)\n    target_pos = np.unravel_index(workshop_index, env.world.workshop_indices.shape)\n    actions = []\n    while not np.array_equal(pos, target_pos):\n        delta = target_pos - pos\n        if delta[0] < 0:\n            actions.append(craft.DOWN)  # Move down\n        elif delta[0] > 0:\n            actions.append(craft.UP)    # Move up\n        elif delta[1] < 0:\n            actions.append(craft.LEFT)  # Move left\n        else:\n            actions.append(craft.RIGHT) # Move right\n        pos += np.sign(delta)\n    return actions\n\n  def use_workshop():\n      # Use the workshop to craft the item\n      return [craft.USE]\n\n  # Main logic for crafting the item\n  try:\n    workshop_index = get_workshop_index(item)\n    navigate_actions = navigate_to_workshop(workshop_index)\n    craft_action = use_workshop()\n    return navigate_actions + craft_action\n  except ValueError as e:\n    print(e)\n    return []", "island_id": 5, "scores": {"": -1}}
{"timestamp": "2025-09-02T23:50:07.020150", "function_name": "craft", "function_body": "  def get_closest_workshop(item_index):\n    \"\"\"Finds the closest workshop that can craft the specified item.\"\"\"\n    # Determine the workshop required based on the recipe key\n    workshop_indices = []\n    for output_idx, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n        workshop_name = ingredients.get(\"_workshop\")\n        if workshop_name:\n          workshop_indices.append(env.world.cookbook.index[workshop_name])\n    \n    # If no specific workshop is needed, use a default one\n    if not workshop_indices:\n      return env.world.workshop_indices[0]  # Default to the first workshop type\n    \n    # Find the closest workshop in the grid\n    agent_pos = np.array(env._current_state.pos)\n    min_distance = float('inf')\n    closest_workshop_index = None\n    for workshop_index in workshop_indices:\n      for y in range(grid_shape[1]):\n        for x in range(grid_shape[0]):\n          if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n            target_pos = np.array((x, y))\n            distance = np.linalg.norm(agent_pos - target_pos)\n            if distance < min_distance:\n              min_distance = distance\n              closest_workshop_index = workshop_index\n    return closest_workshop_index\n\n  def path_to_target(start, target):\n    \"\"\"Computes the path from start position to target position using A* algorithm.\"\"\"\n    actions = []\n    # Define possible movements and their corresponding actions\n    moves = [(1, 0, 3), (-1, 0, 2), (0, 1, 1), (0, -1, 0)]  # RIGHT, LEFT, UP, DOWN\n    open_set = collections.deque([(start[0], start[1], [])])  # Queue for BFS\n    visited = set()\n    \n    while open_set:\n      x, y, path = open_set.popleft()\n      \n      if (x, y) == tuple(target):\n        return path\n      \n      if (x, y) in visited:\n        continue\n      \n      visited.add((x, y))\n      \n      for dx, dy, action in moves:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < grid_shape[0] and 0 <= ny < grid_shape[1]:\n          open_set.append((nx, ny, path + [action]))\n    \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n  grid_shape = env._current_state.grid.shape[:2]\n\n  # Find the closest workshop for crafting\n  workshop_index = get_closest_workshop(item_index)\n\n  # Find the position of the closest workshop in the grid\n  agent_pos = np.array(env._current_state.pos)\n  workshop_pos = None\n  min_distance = float('inf')\n  for y in range(grid_shape[1]):\n    for x in range(grid_shape[0]):\n      if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n        target_pos = np.array((x, y))\n        distance = np.linalg.norm(agent_pos - target_pos)\n        if distance < min_distance:\n          min_distance = distance\n          workshop_pos = (x, y)\n\n  # If no workshop position is found, return an empty list of actions\n  if workshop_pos is None:\n    return []\n\n  # Calculate the path to the closest workshop and perform the USE action\n  target_pos = np.array(workshop_pos)\n  actions_to_workshop = path_to_target(agent_pos[:2], target_pos)\n  actions_to_workshop.append(4)  # USE to craft the item\n\n  return actions_to_workshop", "island_id": 2, "scores": {"": 2.0}}
{"timestamp": "2025-09-02T23:50:08.060401", "function_name": "craft", "function_body": "  def get_closest_workshop(item_index):\n    \"\"\"Finds the closest workshop that can craft the specified item.\"\"\"\n    # Determine the workshop required based on the recipe key\n    workshop_indices = []\n    for output_idx, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n        workshop_name = ingredients.get(\"_workshop\")\n        if workshop_name:\n          workshop_indices.append(env.world.cookbook.index[workshop_name])\n    \n    # If no specific workshop is needed, use a default one\n    if not workshop_indices:\n      return env.world.workshop_indices[0]  # Default to the first workshop type\n    \n    # Find the closest workshop in the grid\n    agent_pos = np.array(env._current_state.pos)\n    min_distance = float('inf')\n    closest_workshop_index = None\n    for workshop_index in workshop_indices:\n      for y in range(grid_shape[1]):\n        for x in range(grid_shape[0]):\n          if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n            target_pos = np.array((x, y))\n            distance = np.linalg.norm(agent_pos - target_pos)\n            if distance < min_distance:\n              min_distance = distance\n              closest_workshop_index = workshop_index\n    return closest_workshop_index\n\n  def path_to_target(start, target):\n    \"\"\"Computes the path from start position to target position.\"\"\"\n    actions = []\n    while not np.all(start == target):\n        direction = target - start\n        if abs(direction[0]) > abs(direction[1]):\n            # Move horizontally\n            if direction[0] > 0:\n                actions.append(3)  # RIGHT\n                start[0] += 1\n            else:\n                actions.append(2)  # LEFT\n                start[0] -= 1\n        else:\n            # Move vertically\n            if direction[1] > 0:\n                actions.append(1)  # UP\n                start[1] += 1\n            else:\n                actions.append(0)  # DOWN\n                start[1] -= 1\n    return actions\n\n  item_index = env.world.cookbook.index[item]\n  grid_shape = env._current_state.grid.shape[:2]\n\n  # Find the closest workshop for crafting\n  workshop_index = get_closest_workshop(item_index)\n\n  # Find the position of the closest workshop in the grid\n  agent_pos = np.array(env._current_state.pos)\n  workshop_pos = None\n  min_distance = float('inf')\n  for y in range(grid_shape[1]):\n    for x in range(grid_shape[0]):\n      if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n        target_pos = np.array((x, y))\n        distance = np.linalg.norm(agent_pos - target_pos)\n        if distance < min_distance:\n          min_distance = distance\n          workshop_pos = (x, y)\n\n  # If no workshop position is found, return an empty list of actions\n  if workshop_pos is None:\n    return []\n\n  # Calculate the path to the closest workshop and perform the USE action\n  target_pos = np.array(workshop_pos)\n  actions_to_workshop = path_to_target(agent_pos, target_pos)\n\n  # Check if the agent already has enough items in inventory to craft\n  item_recipe = env.world.cookbook.recipes[item_index]\n  for ingredient_idx, quantity in item_recipe.items():\n      if ingredient_idx != \"_key\" and ingredient_idx != \"_workshop\":\n          if env._current_state.inventory[ingredient_idx] < quantity:\n              return []  # Not enough ingredients to craft\n\n  actions_to_workshop.append(4)  # USE to craft the item\n\n  return actions_to_workshop", "island_id": 2, "scores": {"": -1}}
{"timestamp": "2025-09-02T23:50:51.174080", "function_name": "craft", "function_body": "  # Convert item name to index\n  item_index = env.world.cookbook.index[item]\n\n  # Determine which workshop can produce the item\n  recipes = env.world.cookbook.recipes\n  for output_index, recipe in recipes.items():\n      if \"_key\" not in recipe:  # Ensure it's a direct output recipe\n          if output_index == item_index:\n              ingredient_indices = list(recipe.keys())\n              break\n\n  # Check the workshop index associated with the ingredients\n  workshop_index = -1\n  for i_kind in env.world.workshop_indices:\n      if all(env._current_state.next_to(i) for i in ingredient_indices):\n          workshop_index = i_kind\n          break\n\n  # Define actions based on the direction and position of the workshop\n  actions = []\n  \n  # Move to the nearest workshop\n  if workshop_index != -1:\n      pos = env._current_state.pos\n      grid = env._current_state.grid\n      target_pos = np.argwhere(grid[:, :, workshop_index])[0]\n      \n      # Calculate direction from current position to target position\n      delta_x, delta_y = target_pos[1] - pos[1], target_pos[0] - pos[0]\n      \n      if delta_x > 0:\n          actions.extend([craft.RIGHT] * abs(delta_x))\n      elif delta_x < 0:\n          actions.extend([craft.LEFT] * abs(delta_x))\n      \n      if delta_y > 0:\n          actions.extend([craft.DOWN] * abs(delta_y))\n      elif delta_y < 0:\n          actions.extend([craft.UP] * abs(delta_y))\n      \n      # Perform the USE action to craft\n      actions.append(craft.USE)\n  \n  return actions", "island_id": 1, "scores": {"": -1}}
{"timestamp": "2025-09-02T23:50:52.176513", "function_name": "craft", "function_body": "  # Get the index of the desired item from the cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Find the workshop that is needed to craft the item.\n  workshops = [i for i in env.world.workshop_indices if env.world.grid[env._current_state.pos[0], env._current_state.pos[1], i] > 0]\n\n  # If no workshop is found, raise an exception\n  if not workshops:\n    raise ValueError(\"No suitable workshop found for crafting the item.\")\n\n  # Get the index of the first available workshop from the list\n  workshop_index = workshops[0]\n  \n  # Calculate the direction to move towards the workshop based on the agent's current position and the workshop's position.\n  target_pos = np.array([np.where(env.world.grid[:, :, workshop_index] > 0)[0][0], \n                         np.where(env.world.grid[:, :, workshop_index] > 0)[1][0]])\n  \n  actions = []\n\n  # Calculate the direction to move towards the workshop\n  while not (env._current_state.pos == target_pos).all():\n      current_pos = env._current_state.pos\n      if current_pos[0] < target_pos[0]:\n          actions.append(env.action_specs()[\"DOWN\"])\n      elif current_pos[0] > target_pos[0]:\n          actions.append(env.action_specs()[\"UP\"])\n      if current_pos[1] < target_pos[1]:\n          actions.append(env.action_specs()[\"RIGHT\"])\n      elif current_pos[1] > target_pos[1]:\n          actions.append(env.action_specs()[\"LEFT\"])\n\n  # Add the USE action to craft the item\n  actions.append(env.action_specs()[\"USE\"])\n  \n  return actions", "island_id": 1, "scores": {"": -1}}
{"timestamp": "2025-09-02T23:51:30.627434", "function_name": "craft", "function_body": "  # Extract index from item name using the cookbook index\n  i_item = env.world.cookbook.index[item]\n\n  # Find required workshop type for crafting (if any)\n  for recipe in env.world.cookbook.recipes.values():\n      if i_item in recipe:\n          workshop_type = recipe.get(\"_key\", None)\n          break\n\n  # If no specific workshop is needed, return an empty list\n  if workshop_type is None:\n      return []\n\n  # Find the index of the required workshop type\n  workshop_index = env.world.cookbook.index[workshop_type]\n\n  # Define actions to move to a workshop and use it\n  actions_to_take = []\n  \n  # First, find the nearest workshop of the required type\n  # (This is a placeholder for the actual logic to find the nearest workshop)\n  nearest_workshop_pos = find_nearest_workshop(env._current_state.grid, workshop_index)\n  \n  # Generate actions to move to the nearest workshop\n  if nearest_workshop_pos:\n      path_actions = generate_path_actions(env._current_state.pos, nearest_workshop_pos)\n      actions_to_take.extend(path_actions)\n\n      # Once at the workshop, use it to craft the item\n      actions_to_take.append(4)  # USE action\n\n  return actions_to_take", "island_id": 3, "scores": {"": -1}}
{"timestamp": "2025-09-02T23:51:31.588649", "function_name": "craft", "function_body": "  # Get the index for the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Find which workshop is required to craft this item (if any)\n  for recipe in env.world.cookbook.recipes.values():\n      if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n          workshop_name = recipe[\"workshop\"]\n          break\n  else:\n      raise ValueError(f\"No recipe found for {item} or no specific workshop is required.\")\n\n  # Get the index of the workshop\n  workshop_index = env.world.cookbook.index[workshop_name]\n  \n  # Find the position of the workshop in the grid\n  workshop_pos = None\n  for y in range(env._current_state.grid.shape[0]):\n      for x in range(env._current_state.grid.shape[1]):\n          if env._current_state.grid[y, x, workshop_index] > 0:\n              workshop_pos = (x, y)\n              break\n      if workshop_pos is not None:\n          break\n  \n  if workshop_pos is None:\n      raise ValueError(f\"No workshop of type {workshop_name} found in the grid.\")\n\n  # Calculate the direction to move towards the workshop\n  target_x, target_y = workshop_pos\n  current_x, current_y = env._current_state.pos\n\n  actions = []\n  \n  # Move towards the workshop\n  while (current_x != target_x) or (current_y != target_y):\n      dx = target_x - current_x\n      dy = target_y - current_y\n      \n      if dx > 0:\n          actions.append(env.world.cookbook.index[\"RIGHT\"])\n      elif dx < 0:\n          actions.append(env.world.cookbook.index[\"LEFT\"])\n      \n      if dy > 0:\n          actions.append(env.world.cookbook.index[\"DOWN\"])\n      elif dy < 0:\n          actions.append(env.world.cookbook.index[\"UP\"])\n\n      current_x += np.sign(dx)\n      current_y += np.sign(dy)\n\n  # Once at the workshop, use it to craft the item\n  actions.append(env.world.cookbook.index[\"USE\"])\n\n  return actions", "island_id": 3, "scores": {"": -1}}
{"timestamp": "2025-09-02T23:53:06.856471", "function_name": "craft", "function_body": "  def get_workshop_for_item(item_index):\n    for workshop, recipes in env.world.cookbook.recipes.items():\n        if '_key' in recipes and item_index == recipes['_key']:\n            return workshop\n    return None\n\n  def find_nearest_workshop(env, workshop_index):\n    grid = env._current_state.grid\n    height, width, _ = grid.shape\n    \n    # Find all locations of the workshop on the grid\n    workshop_locations = [(x, y) for x in range(width) for y in range(height) if grid[y, x, workshop_index] > 0]\n    \n    if not workshop_locations:\n        return None\n    \n    agent_pos = env._current_state.pos\n    \n    # Find the nearest workshop based on Manhattan distance\n    nearest_location = min(workshop_locations, key=lambda loc: abs(loc[0] - agent_pos[0]) + abs(loc[1] - agent_pos[1]))\n    \n    return nearest_location\n\n  def navigate_to(env, target_pos):\n    actions = []\n    agent_pos = env._current_state.pos\n    path = a_star_search(agent_pos, target_pos)\n    \n    if not path:\n        return []\n\n    for i in range(1, len(path)):\n        dx = path[i][0] - path[i-1][0]\n        dy = path[i][1] - path[i-1][1]\n\n        if (dx, dy) == (-1, 0):\n            actions.append(env.action_specs()['UP'])\n        elif (dx, dy) == (1, 0):\n            actions.append(env.action_specs()['DOWN'])\n        elif (dx, dy) == (0, -1):\n            actions.append(env.action_specs()['LEFT'])\n        elif (dx, dy) == (0, 1):\n            actions.append(env.action_specs()['RIGHT'])\n\n    return actions\n\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star_search(start, goal):\n    open_set = collections.PriorityQueue()\n    open_set.put((0, start))\n    came_from = {}\n    cost_so_far = {}\n    came_from[start] = None\n    cost_so_far[start] = 0\n\n    while not open_set.empty():\n        _, current = open_set.get()\n\n        if current == goal:\n            break\n\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            neighbor = (current[0] + dx, current[1] + dy)\n            new_cost = cost_so_far[current] + heuristic(current, neighbor)\n\n            if neighbor not in cost_so_far or new_cost < cost_so_far[neighbor]:\n                cost_so_far[neighbor] = new_cost\n                priority = new_cost + heuristic(goal, neighbor)\n                open_set.put((priority, neighbor))\n                came_from[neighbor] = current\n\n    return reconstruct_path(came_from, start, goal)\n\n  def reconstruct_path(came_from, start, goal):\n    current = goal\n    path = []\n    while current != start:\n        path.append(current)\n        current = came_from[current]\n    path.reverse()\n    return path\n\n  item_index = env.world.cookbook.index[item]\n\n  # Find the workshop that allows crafting this item (if any)\n  workshop_index = get_workshop_for_item(item_index)\n\n  actions = []\n\n  if workshop_index is not None:\n      nearest_workshop_location = find_nearest_workshop(env, workshop_index)\n      \n      if nearest_workshop_location is not None:\n          # Navigate to the workshop location\n          actions.extend(navigate_to(env, nearest_workshop_location))\n          \n          # Use the workshop to craft the item\n          actions.append(env.action_specs()['USE'])\n  else:\n      # No specific workshop needed, likely a primitive item that can be crafted anywhere (e.g., STICK from WOOD)\n      actions.append(env.action_specs()['USE'])\n\n  return actions", "island_id": 9, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T23:53:07.862962", "function_name": "craft", "function_body": "  def get_workshop_for_item(item_index):\n    for workshop, recipes in env.world.cookbook.recipes.items():\n        if '_key' in recipes and item_index == recipes['_key']:\n            return workshop\n    return None\n\n  def find_nearest_workshop(env, workshop_index):\n      \"\"\"Finds the nearest location of a given workshop type.\"\"\"\n      grid = env._current_state.grid\n      height, width, _ = grid.shape\n      workshop_locations = [(x, y) for x in range(width) for y in range(height) if grid[y, x, workshop_index] > 0]\n      \n      if not workshop_locations:\n          return None\n      \n      agent_pos = env._current_state.pos\n      nearest_location = min(workshop_locations, key=lambda loc: abs(loc[0] - agent_pos[0]) + abs(loc[1] - agent_pos[1]))\n      return nearest_location\n\n  def navigate_to(env, target_pos):\n      \"\"\"Navigates the agent to a target position.\"\"\"\n      actions = []\n      agent_pos = env._current_state.pos\n      target_x, target_y = target_pos\n      \n      # Calculate directions needed to move\n      dx = target_x - agent_pos[0]\n      dy = target_y - agent_pos[1]\n      \n      if dx > 0:\n          actions.extend([env.N_ACTIONS - 1] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([env.N_ACTIONS - 2] * abs(dx))  # LEFT\n      \n      if dy > 0:\n          actions.extend([env.N_ACTIONS - 3] * abs(dy))  # DOWN\n      elif dy < 0:\n          actions.extend([env.N_ACTIONS - 4] * abs(dy))  # UP\n      \n      return actions\n\n  def get_item_from_inventory(env, item_index):\n    \"\"\"Checks if the item is in the inventory and returns a USE action if it is.\"\"\"\n    inventory = env._current_state.inventory\n    if item_index in inventory:\n        return [env.N_ACTIONS - 5]  # USE to craft the item from inventory\n    return []\n\n  item_index = env.world.cookbook.index[item]\n  \n  actions = []\n\n  # Check if the item can be crafted directly from the inventory (e.g., STICK)\n  direct_craft_actions = get_item_from_inventory(env, item_index)\n  if direct_craft_actions:\n      actions.extend(direct_craft_actions)\n  else:\n      # Find the workshop that allows crafting this item (if any)\n      workshop_index = get_workshop_for_item(item_index)\n\n      if workshop_index is not None:\n          # Get the location of the nearest workshop of the required type\n          nearest_workshop_location = find_nearest_workshop(env, workshop_index)\n          \n          if nearest_workshop_location is not None:\n              # Navigate to the workshop location\n              actions.extend(navigate_to(env, nearest_workshop_location))\n              \n              # Use the workshop to craft the item\n              actions.append(env.N_ACTIONS - 5)  # USE\n      else:\n          # No specific workshop needed, likely a primitive item that can be crafted anywhere (e.g., STICK from WOOD)\n          actions.append(env.N_ACTIONS - 5)  # USE\n\n  return actions", "island_id": 9, "scores": {"": -1}}
