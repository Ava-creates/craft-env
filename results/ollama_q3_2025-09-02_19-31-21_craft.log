{"timestamp": "2025-09-03T02:57:22.032023", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Iterate over all positions in the grid to find the closest workshop\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if any(grid[i, j, w] > 0 for w in workshop_indices):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    # Calculate the direction to move and generate actions\n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if abs(dx) >= abs(dy):\n          # Move horizontally first\n          if dx > 0:\n              actions.append(3)  # RIGHT\n              current_pos = (current_pos[0] + 1, current_pos[1])\n          elif dx < 0:\n              actions.append(2)  # LEFT\n              current_pos = (current_pos[0] - 1, current_pos[1])\n      else:\n          # Move vertically first\n          if dy > 0:\n              actions.append(1)  # UP\n              current_pos = (current_pos[0], current_pos[1] + 1)\n          elif dy < 0:\n              actions.append(0)  # DOWN\n              current_pos = (current_pos[0], current_pos[1] - 1)\n    \n    return actions\n\n  def get_workshop_for_item(item_index, cookbook):\n      \"\"\"Determine which workshop is required for crafting the item.\"\"\"\n      # Placeholder function to determine the workshop index.\n      # In reality, this would need to be extracted from the recipes.\n      # For simplicity, we assume all workshops can craft any items.\n      return env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  workshop_index = get_workshop_for_item(item_index, env.world.cookbook)\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 7, "scores": {"": 4.7}}
{"timestamp": "2025-09-03T02:57:23.097013", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    # Calculate the direction to move\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    while abs(dx) > 0 or abs(dy) > 0:\n        if abs(dx) >= abs(dy):\n            # Move horizontally first\n            if dx > 0:\n                actions.append(3)  # RIGHT\n                dx -= 1\n            elif dx < 0:\n                actions.append(2)  # LEFT\n                dx += 1\n        else:\n            # Move vertically first\n            if dy > 0:\n                actions.append(1)  # UP\n                dy -= 1\n            elif dy < 0:\n                actions.append(0)  # DOWN\n                dy += 1\n    \n    return actions\n\n  def get_workshop_for_item(item_index, cookbook):\n      \"\"\"Determine which workshop is required for crafting the item.\"\"\"\n      # This function assumes that recipes specify which workshop is needed.\n      # For simplicity, we assume all workshops can craft any items.\n      # In reality, this would need to be extracted from the recipes.\n      return env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  def collect_primitives(env, primitives):\n    \"\"\"Collects the required primitives for crafting.\"\"\"\n    actions = []\n    pos = env._current_state.pos\n    grid = env._current_state.grid\n    \n    for primitive in primitives:\n        primitive_index = env.world.cookbook.index[primitive]\n        primitive_positions = np.argwhere(grid[:, :, primitive_index] > 0)\n        \n        if len(primitive_positions) == 0:\n            raise ValueError(f\"Primitive '{primitive}' not found on the grid.\")\n        \n        # Find the closest primitive\n        min_distance = float('inf')\n        closest_primitive_pos = None\n        for p in primitive_positions:\n            distance = abs(p[0] - pos[0]) + abs(p[1] - pos[1])\n            if distance < min_distance:\n                min_distance = distance\n                closest_primitive_pos = tuple(p)\n        \n        # Move to the closest primitive and collect it\n        actions.extend(move_to(env, closest_primitive_pos))\n        actions.append(env.world.n_actions - 2)  # Assuming the second last action index corresponds to COLLECT\n\n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  workshop_index = get_workshop_for_item(item_index, env.world.cookbook)\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Collect required primitives for crafting the item\n  recipe = env.world.cookbook.recipes[item_index]\n  primitive_names = [env.world.cookbook.index[i] for i in recipe.keys()]\n  actions_to_collect_primitives = collect_primitives(env, primitive_names)\n\n  # Move to the closest workshop and craft the item\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_collect_primitives + actions_to_workshop", "island_id": 7, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T02:57:53.791645", "function_name": "craft", "function_body": "  goal_index = env.world.cookbook.index[item]\n  actions = []\n\n  if goal_index in env.world.workshop_indices:\n    # Find all workshops that can produce the item\n    workshop_indices = [idx for idx, recipe in env.world.cookbook.recipes.items() \n                        if \"_key\" in recipe and recipe[\"_key\"] == goal_index]\n\n    if workshop_indices:\n        chosen_workshop_index = workshop_indices[0]\n        \n        # Find positions of the chosen workshop in the grid\n        workshop_positions = np.argwhere(env._current_state.grid[:, :, chosen_workshop_index]).tolist()\n\n        if workshop_positions:\n            nearest_workshop_position = min(workshop_positions, \n                                           key=lambda pos: np.linalg.norm(np.array(pos) - np.array(env._current_state.pos)))\n\n            # Move to the nearest workshop position\n            target_pos = nearest_workshop_position\n\n            # Calculate the direction and move towards the workshop\n            actions.extend(move_towards(env, target_pos))\n\n            # Use the workshop to craft the item\n            actions.append(craft.CRAFT_FUNC(goal_index))\n  \n  return actions", "island_id": 5, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T02:57:54.857421", "function_name": "craft", "function_body": "  goal_index = env.world.cookbook.index[item]\n  actions = []\n\n  if goal_index in env.world.workshop_indices:\n    # Find all workshops that can produce the item\n    workshop_indices = [idx for idx, recipe in env.world.cookbook.recipes.items() \n                        if \"_key\" in recipe and recipe[\"_key\"] == goal_index]\n\n    if workshop_indices:\n        chosen_workshop_index = workshop_indices[0]\n        \n        # Find positions of the chosen workshop in the grid\n        workshop_positions = np.argwhere(env._current_state.grid[:, :, chosen_workshop_index]).tolist()\n\n        if workshop_positions:\n            nearest_workshop_position = min(workshop_positions, \n                                           key=lambda pos: np.linalg.norm(np.array(pos) - np.array(env._current_state.pos)))\n            \n            # Calculate the direction and move towards the workshop\n            actions.extend(move_towards(env, nearest_workshop_position))\n\n            # Use the workshop to craft the item\n            actions.append(craft.CRAFT_FUNC(item))\n  \n  return actions", "island_id": 5, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T02:59:30.606083", "function_name": "craft", "function_body": "  def move_to_position(current_pos, target_pos):\n    \"\"\"Generate a sequence of actions to move from current position to target position.\"\"\"\n    x_diff = target_pos[0] - current_pos[0]\n    y_diff = target_pos[1] - current_pos[1]\n\n    actions = []\n\n    # Determine direction based on the differences\n    if x_diff > 0:\n        actions.extend([3] * abs(x_diff))  # RIGHT\n    elif x_diff < 0:\n        actions.extend([2] * abs(x_diff))  # LEFT\n\n    if y_diff > 0:\n        actions.extend([1] * abs(y_diff))  # UP\n    elif y_diff < 0:\n        actions.extend([0] * abs(y_diff))  # DOWN\n\n    return actions\n\n  def turn_towards(current_dir, target_pos):\n      \"\"\"Generate a sequence of actions to turn the agent towards the target position.\"\"\"\n      current_x, current_y = env._current_state.pos\n      target_x, target_y = target_pos\n      \n      if target_x < current_x:\n          target_dir = 2  # LEFT\n      elif target_x > current_x:\n          target_dir = 3  # RIGHT\n      elif target_y < current_y:\n          target_dir = 1  # UP\n      else:  # target_y > current_y\n          target_dir = 0  # DOWN\n      \n      diff = (target_dir - current_dir) % 4\n      if diff == 1 or diff == -3:\n          return [4] * 1  # Turn right\n      elif diff == 2 or diff == -2:\n          return [4, 4]  # Turn around\n      else:  # diff == 3 or diff == -1\n          return [4] * 3  # Turn left\n      \n      return []\n\n  actions = []\n  \n  # Get the index of the desired item to be crafted\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n  \n  # Check if there is a \"_key\" in the recipe, which indicates the workshop type required\n  if \"_key\" in recipe:\n      workshop_type = recipe[\"_key\"]\n      \n      # Find the index of the corresponding workshop in the world configuration\n      workshop_indices = env.world.workshop_indices\n      \n      # Select one of the workshops based on the workshop type (simple random choice for now)\n      selected_workshop_index = None\n      for idx, workshop in enumerate(env.world.cookbook.index):\n          if workshop.startswith(workshop_type):\n              selected_workshop_index = workshop_indices[idx]\n              break\n      \n      if selected_workshop_index is not None:\n          # Determine the position of the selected workshop from the current state's grid\n          workshop_positions = np.argwhere(env._current_state.grid[:, :, selected_workshop_index] > 0)\n          \n          if len(workshop_positions) > 0:\n              target_pos = tuple(workshop_positions[0])\n              \n              # Move to the target position of the workshop\n              actions.extend(move_to_position(env._current_state.pos, target_pos))\n              \n              # Turn to face the workshop\n              actions.extend(turn_towards(env._current_state.dir, target_pos))\n              \n              # Perform the USE action to start crafting\n              actions.append(4)  # USE action index\n  \n  return actions", "island_id": 3, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T02:59:31.643558", "function_name": "craft", "function_body": "  def move_to_position(current_pos, target_pos):\n    \"\"\"Generate a sequence of actions to move from current position to target position.\"\"\"\n    x_diff = target_pos[0] - current_pos[0]\n    y_diff = target_pos[1] - current_pos[1]\n\n    actions = []\n\n    # Determine direction based on the differences\n    if x_diff > 0:\n        actions.extend([3] * abs(x_diff))  # RIGHT\n    elif x_diff < 0:\n        actions.extend([2] * abs(x_diff))  # LEFT\n\n    if y_diff > 0:\n        actions.extend([1] * abs(y_diff))  # UP\n    elif y_diff < 0:\n        actions.extend([0] * abs(y_diff))  # DOWN\n\n    return actions\n\n  def calculate_direction_to_face(current_pos, target_pos):\n    \"\"\"Calculate the direction to face the target position from the current position.\"\"\"\n    x_diff = target_pos[0] - current_pos[0]\n    y_diff = target_pos[1] - current_pos[1]\n\n    if x_diff < 0:\n        return 2  # LEFT\n    elif x_diff > 0:\n        return 3  # RIGHT\n    elif y_diff < 0:\n        return 1  # UP\n    else:  # y_diff > 0\n        return 0  # DOWN\n\n  def turn_towards(current_dir, target_dir):\n    \"\"\"Generate actions to turn from the current direction to the target direction.\"\"\"\n    if current_dir != target_dir:\n      diff = (target_dir - current_dir) % 4\n      if diff == 1 or diff == -3:\n        return [4] * 1  # Turn right\n      elif diff == 2 or diff == -2:\n        return [4, 4]  # Turn around\n      else:  # diff == 3 or diff == -1\n        return [4] * 3  # Turn left\n    return []\n\n  actions = []\n  \n  # Get the index of the desired item to be crafted\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n  \n  # Check if there is a \"_key\" in the recipe, which indicates the workshop type required\n  if \"_key\" in recipe:\n      workshop_type = recipe[\"_key\"]\n      \n      # Find the index of the corresponding workshop in the world configuration\n      workshop_indices = env.world.workshop_indices\n      \n      # Select one of the workshops based on the workshop type (simple random choice for now)\n      selected_workshop_index = None\n      for idx, workshop in enumerate(env.world.cookbook.index):\n          if workshop.startswith(workshop_type):\n              selected_workshop_index = workshop_indices[idx]\n              break\n      \n      if selected_workshop_index is not None:\n          # Determine the position of the selected workshop from the current state's grid\n          workshop_positions = np.argwhere(env._current_state.grid[:, :, selected_workshop_index] > 0)\n          \n          if len(workshop_positions) > 0:\n              target_pos = tuple(workshop_positions[0])\n              \n              # Move to the target position of the workshop\n              actions.extend(move_to_position(env._current_state.pos, target_pos))\n              \n              # Turn to face the workshop\n              current_dir = env._current_state.dir\n              target_dir = calculate_direction_to_face(current_dir, target_pos)\n              actions.extend(turn_towards(current_dir, target_dir))\n              \n              # Perform the USE action to start crafting\n              actions.append(4)  # USE action index\n  \n  return actions", "island_id": 3, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T03:00:10.292565", "function_name": "craft", "function_body": "  goal_index = env.world.cookbook.index[item]\n\n  actions = []\n\n  if goal_index in env.world.cookbook.recipes:\n    # Find all workshops that can produce the item\n    workshop_indices = [idx for idx, recipe in env.world.cookbook.recipes.items() \n                        if \"_key\" in recipe and recipe[\"_key\"] == goal_index]\n    \n    if workshop_indices:\n        # Choose the first available workshop (assuming it's always reachable)\n        chosen_workshop_index = workshop_indices[0]\n\n        # Find positions of the chosen workshop in the grid\n        workshop_positions = np.argwhere(env._current_state.grid[:, :, chosen_workshop_index]).tolist()\n        \n        if workshop_positions:\n            nearest_workshop_position = min(workshop_positions, \n                                           key=lambda pos: np.linalg.norm(np.array(pos) - np.array(env._current_state.pos)))\n\n            # Move to the nearest workshop position\n            current_x, current_y = env._current_state.pos\n            target_x, target_y = nearest_workshop_position\n\n            # Calculate moves in x-direction\n            if current_x < target_x:\n                actions.extend([craft.RIGHT] * (target_x - current_x))\n            elif current_x > target_x:\n                actions.extend([craft.LEFT] * (current_x - target_x))\n\n            # Calculate moves in y-direction\n            if current_y < target_y:\n                actions.extend([craft.DOWN] * (target_y - current_y))\n            elif current_y > target_y:\n                actions.extend([craft.UP] * (current_y - target_y))\n\n            # Use the workshop to craft the item\n            actions.append(craft.USE)\n\n  return actions", "island_id": 5, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T03:00:11.343656", "function_name": "craft", "function_body": "  goal_index = env.world.cookbook.index[item]\n  actions = []\n\n  if goal_index in env.world.cookbook.recipes:\n    # Find all workshops that can produce the item\n    workshop_indices = [idx for idx, recipe in env.world.cookbook.recipes.items() \n                        if \"_key\" in recipe and recipe[\"_key\"] == goal_index]\n    \n    if workshop_indices:\n        # Choose the first available workshop (assuming it's always reachable)\n        chosen_workshop_index = workshop_indices[0]\n\n        # Find positions of the chosen workshop in the grid\n        workshop_positions = np.argwhere(env._current_state.grid[:, :, chosen_workshop_index]).tolist()\n        \n        if workshop_positions:\n            nearest_workshop_position = min(workshop_positions, \n                                           key=lambda pos: np.linalg.norm(np.array(pos) - np.array(env._current_state.pos)))\n\n            # Calculate the path to the nearest workshop position\n            actions.extend(calculate_path_to_target(env, nearest_workshop_position))\n            \n            # Use the workshop to craft the item\n            actions.append(craft.CRAFT_FUNC(item))\n  \n  return actions", "island_id": 5, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T03:00:46.194763", "function_name": "craft", "function_body": "  # Get the index for the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Find the workshop indices where this item can be crafted\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_indices = []\n  for key in recipe:\n      if key.startswith(\"_key\"):\n          workshop_indices.append(int(key.split(\"_\")[1]))\n\n  if not workshop_indices:\n      raise ValueError(f\"No workshop found for crafting {item}\")\n\n  # Choose the first available workshop (we can improve this later)\n  target_workshop_index = workshop_indices[0]\n\n  # Find the position of the chosen workshop in the grid\n  target_pos = None\n  for y in range(env._current_state.grid.shape[0]):\n      for x in range(env._current_state.grid.shape[1]):\n          if env._current_state.grid[y, x, target_workshop_index] > 0:\n              target_pos = (x, y)\n              break\n      if target_pos:\n          break\n\n  if not target_pos:\n      raise ValueError(f\"Workshop {target_workshop_index} not found in the grid\")\n\n  # Calculate actions to move towards the workshop\n  current_pos = env._current_state.pos\n  actions_to_move = []\n  while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if abs(dx) > abs(dy):\n          # Move horizontally\n          if dx > 0:\n              actions_to_move.append(env.world.N_ACTIONS.RIGHT)\n          else:\n              actions_to_move.append(env.world.N_ACTIONS.LEFT)\n      else:\n          # Move vertically\n          if dy > 0:\n              actions_to_move.append(env.world.N_ACTIONS.DOWN)\n          else:\n              actions_to_move.append(env.world.N_ACTIONS.UP)\n\n      current_pos = (current_pos[0] + (1 if dx > 0 else -1 if dx < 0 else 0),\n                     current_pos[1] + (1 if dy > 0 else -1 if dy < 0 else 0))\n\n  # Add the USE action to craft the item\n  actions_to_move.append(env.world.N_ACTIONS.USE)\n\n  return actions_to_move", "island_id": 1, "scores": {"": -1}}
{"timestamp": "2025-09-03T03:00:47.162276", "function_name": "craft", "function_body": "  actions = []\n  # Get the index of the goal item\n  goal_index = env.world.cookbook.index[item]\n\n  # Get the primitives required to craft the item\n  primitives_required = env.world.cookbook.primitives_for(goal_index)\n\n  # Check if all primitives are in inventory\n  for primitive, count in primitives_required.items():\n    if env._current_state.inventory[primitive] < count:\n      return actions  # Return empty list as we cannot craft the item\n\n  # Find the nearest workshop to go to\n  nearest_workshop = find_nearest_workshop(env)\n\n  # Move to the nearest workshop\n  actions.extend(move_to(env, nearest_workshop))\n\n  # Perform the USE action to craft the item\n  actions.append(4)  # USE action\n\n  return actions", "island_id": 1, "scores": {"": -1}}
{"timestamp": "2025-09-03T03:02:27.931880", "function_name": "craft", "function_body": "  def get_closest_workshop(item_index):\n    \"\"\"Finds the closest workshop that can craft the specified item.\"\"\"\n    # Determine the workshop required based on the recipe key\n    workshop_indices = []\n    for output_idx, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n        workshop_name = ingredients.get(\"_workshop\")\n        if workshop_name:\n          workshop_indices.append(env.world.cookbook.index[workshop_name])\n    \n    # If no specific workshop is needed, use a default one\n    if not workshop_indices:\n      return env.world.workshop_indices[0]  # Default to the first workshop type\n    \n    # Find the closest workshop in the grid\n    agent_pos = np.array(env._current_state.pos)\n    min_distance = float('inf')\n    closest_workshop_index = None\n    for workshop_index in workshop_indices:\n      for y in range(grid_shape[1]):\n        for x in range(grid_shape[0]):\n          if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n            target_pos = np.array((x, y))\n            distance = np.linalg.norm(agent_pos - target_pos)\n            if distance < min_distance:\n              min_distance = distance\n              closest_workshop_index = workshop_index\n    return closest_workshop_index\n\n  def path_to_target(start, target):\n    \"\"\"Computes the path from start position to target position using A* algorithm for better efficiency.\"\"\"\n    open_set = [(0, start, [])]  # (f_cost, current_pos, actions)\n    closed_set = set()\n    while open_set:\n      f_cost, current_pos, actions = heapq.heappop(open_set)\n      if tuple(current_pos) == tuple(target):\n        return actions\n      if tuple(current_pos) in closed_set:\n        continue\n      closed_set.add(tuple(current_pos))\n      \n      # Explore neighbors (UP, DOWN, LEFT, RIGHT)\n      for dx, dy, action in [(0, -1, 0), (0, 1, 1), (-1, 0, 2), (1, 0, 3)]:\n        new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n        if 0 <= new_x < grid_shape[0] and 0 <= new_y < grid_shape[1]:\n          new_cost = f_cost + 1\n          heapq.heappush(open_set, (new_cost, (new_x, new_y), actions + [action]))\n    return []\n\n  item_index = env.world.cookbook.index[item]\n  grid_shape = env._current_state.grid.shape[:2]\n\n  # Find the closest workshop for crafting\n  workshop_index = get_closest_workshop(item_index)\n\n  # Find the position of the closest workshop in the grid\n  agent_pos = np.array(env._current_state.pos)\n  workshop_pos = None\n  min_distance = float('inf')\n  for y in range(grid_shape[1]):\n    for x in range(grid_shape[0]):\n      if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n        target_pos = np.array((x, y))\n        distance = np.linalg.norm(agent_pos - target_pos)\n        if distance < min_distance:\n          min_distance = distance\n          workshop_pos = (x, y)\n\n  # If no workshop position is found, return an empty list of actions\n  if workshop_pos is None:\n    return []\n\n  # Calculate the path to the closest workshop and perform the USE action\n  target_pos = np.array(workshop_pos)\n  actions_to_workshop = path_to_target(agent_pos.tolist(), target_pos.tolist())\n  actions_to_workshop.append(4)  # USE to craft the item\n\n  return actions_to_workshop", "island_id": 2, "scores": {"": -1}}
{"timestamp": "2025-09-03T03:02:29.006038", "function_name": "craft", "function_body": "  def get_closest_workshop(item_index):\n    \"\"\"Finds the closest workshop that can craft the specified item.\"\"\"\n    # Determine the workshop required based on the recipe key\n    workshop_indices = []\n    for output_idx, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n        workshop_name = ingredients.get(\"_workshop\")\n        if workshop_name:\n          workshop_indices.append(env.world.cookbook.index[workshop_name])\n    \n    # If no specific workshop is needed, use a default one\n    if not workshop_indices:\n      return env.world.workshop_indices[0]  # Default to the first workshop type\n    \n    # Find the closest workshop in the grid\n    agent_pos = np.array(env._current_state.pos)\n    min_distance = float('inf')\n    closest_workshop_index = None\n    for workshop_index in workshop_indices:\n      for y in range(grid_shape[1]):\n        for x in range(grid_shape[0]):\n          if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n            target_pos = np.array((x, y))\n            distance = np.linalg.norm(agent_pos - target_pos)\n            if distance < min_distance:\n              min_distance = distance\n              closest_workshop_index = workshop_index\n    return closest_workshop_index\n\n  def path_to_target(start, target):\n    \"\"\"Computes the path from start position to target position using BFS.\"\"\"\n    queue = collections.deque([(start, [])])\n    visited = set()\n    while queue:\n      (x, y), actions = queue.popleft()\n      if (x, y) == tuple(target):\n        return actions\n      if (x, y) not in visited:\n        visited.add((x, y))\n        for dx, dy, action in [(-1, 0, 0), (1, 0, 1), (0, -1, 2), (0, 1, 3)]:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < grid_shape[0] and 0 <= ny < grid_shape[1]:\n            queue.append(((nx, ny), actions + [action]))\n    return []\n\n  item_index = env.world.cookbook.index[item]\n  grid_shape = env._current_state.grid.shape[:2]\n\n  # Find the closest workshop for crafting\n  workshop_index = get_closest_workshop(item_index)\n\n  # Find the position of the closest workshop in the grid\n  agent_pos = np.array(env._current_state.pos)\n  workshop_pos = None\n  min_distance = float('inf')\n  for y in range(grid_shape[1]):\n    for x in range(grid_shape[0]):\n      if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n        target_pos = np.array((x, y))\n        distance = np.linalg.norm(agent_pos - target_pos)\n        if distance < min_distance:\n          min_distance = distance\n          workshop_pos = (x, y)\n\n  # If no workshop position is found, return an empty list of actions\n  if workshop_pos is None:\n    return []\n\n  # Calculate the path to the closest workshop and perform the USE action\n  target_pos = np.array(workshop_pos)\n  actions_to_workshop = path_to_target(agent_pos.tolist(), target_pos.tolist())\n  actions_to_workshop.append(4)  # USE to craft the item\n\n  return actions_to_workshop", "island_id": 2, "scores": {"": 1.0}}
{"timestamp": "2025-09-03T03:02:52.185630", "function_name": "craft", "function_body": "  actions = []\n\n  # Get the index of the desired item from the cookbook index\n  item_index = env.world.cookbook.index[item]\n\n  # Find the workshop index for crafting the item\n  workshop_index = None\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n  if \"_key\" in recipe:\n      key_workshop = recipe[\"_key\"]\n      workshop_index = env.world.workshop_indices[key_workshop]\n  \n  # Move to the found workshop\n  if workshop_index is not None:\n      target_pos = find_position_of_kind(env, workshop_index)\n      actions.extend(move_to_position(env._current_state.pos, target_pos))\n      \n      # Perform the USE action to craft the item\n      actions.append(craft.USE)\n\n  return actions", "island_id": 8, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T03:02:53.256892", "function_name": "craft", "function_body": "  actions = []\n\n  # Get the index of the desired item from the cookbook index\n  item_index = env.world.cookbook.index[item]\n\n  # Find the workshop index for crafting the item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n  if \"_key\" in recipe:\n      key_workshop = recipe[\"_key\"]\n      workshop_index = env.world.workshop_indices[key_workshop]\n  \n      # Move to the found workshop\n      target_pos = find_position_of_kind(env, workshop_index)\n      actions.extend(move_to_position(env._current_state.pos, target_pos))\n      \n      # Perform the USE action to craft the item\n      actions.append(craft.USE)\n\n  return actions", "island_id": 8, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T03:03:26.851814", "function_name": "craft", "function_body": "  def calculate_path_to_target(state, target_pos):\n    current_x, current_y = state.pos\n    target_x, target_y = target_pos\n\n    # Calculate moves in x-direction\n    if current_x < target_x:\n        actions.extend([craft.RIGHT] * (target_x - current_x))\n    elif current_x > target_x:\n        actions.extend([craft.LEFT] * (current_x - target_x))\n\n    # Calculate moves in y-direction\n    if current_y < target_y:\n        actions.extend([craft.DOWN] * (target_y - current_y))\n    elif current_y > target_y:\n        actions.extend([craft.UP] * (current_y - current_y))\n    \n    return actions\n\n  goal_index = env.world.cookbook.index[item]\n  actions = []\n\n  if goal_index in env.world.cookbook.recipes:\n    # Find all workshops that can produce the item\n    workshop_indices = [idx for idx, recipe in env.world.cookbook.recipes.items() \n                        if \"_key\" in recipe and recipe[\"_key\"] == goal_index]\n    \n    if workshop_indices:\n        chosen_workshop_index = workshop_indices[0]\n\n        # Find positions of the chosen workshop in the grid\n        workshop_positions = np.argwhere(env._current_state.grid[:, :, chosen_workshop_index]).tolist()\n        \n        if workshop_positions:\n            nearest_workshop_position = min(workshop_positions, \n                                           key=lambda pos: np.linalg.norm(np.array(pos) - np.array(env._current_state.pos)))\n\n            # Calculate the path to the nearest workshop position\n            actions.extend(calculate_path_to_target(env._current_state, nearest_workshop_position))\n            \n            # Use the workshop to craft the item\n            actions.append(craft.USE)\n  \n  return actions", "island_id": 5, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T03:03:27.897590", "function_name": "craft", "function_body": "  goal_index = env.world.cookbook.index[item]\n  actions = []\n\n  if goal_index in env.world.cookbook.recipes:\n    # Find all workshops that can produce the item\n    workshop_indices = [idx for idx, recipe in env.world.cookbook.recipes.items() \n                        if \"_key\" in recipe and recipe[\"_key\"] == goal_index]\n    \n    if workshop_indices:\n        chosen_workshop_index = workshop_indices[0]\n\n        # Find positions of the chosen workshop in the grid\n        workshop_positions = np.argwhere(env._current_state.grid[:, :, chosen_workshop_index]).tolist()\n\n        if workshop_positions:\n            nearest_workshop_position = min(workshop_positions, \n                                           key=lambda pos: np.linalg.norm(np.array(pos) - np.array(env._current_state.pos)))\n\n            # Calculate the path to the nearest workshop position\n            actions.extend(calculate_path_to_target(env, nearest_workshop_position))\n            \n            # Use the workshop to craft the item\n            actions.append(craft.CRAFT_FUNC(item))\n\n  return actions", "island_id": 5, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T03:04:51.110690", "function_name": "craft", "function_body": "  def get_missing_ingredients(recipe):\n      required_ingredients = {k: v for k, v in recipe.items() if k != \"_key\"}\n      missing_ingredients = []\n      inventory_counts = env._current_state.inventory\n      for ingredient_index, count in required_ingredients.items():\n          if inventory_counts[ingredient_index] < count:\n              missing_ingredients.append((ingredient_index, count - inventory_counts[ingredient_index]))\n      return missing_ingredients\n\n  def move_to(env, target_pos):\n      # This function will generate actions to move the agent from its current position to the target position.\n      # Placeholder implementation: Directly calculate the difference in positions and translate it into actions.\n      current_pos = env._current_state.pos\n      delta_x = target_pos[1] - current_pos[1]\n      delta_y = target_pos[0] - current_pos[0]\n      \n      actions = []\n      if delta_x > 0:\n          actions.extend([env.world.cookbook.index[\"RIGHT\"]] * abs(delta_x))\n      elif delta_x < 0:\n          actions.extend([env.world.cookbook.index[\"LEFT\"]] * abs(delta_x))\n      \n      if delta_y > 0:\n          actions.extend([env.world.cookbook.index[\"DOWN\"]] * abs(delta_y))\n      elif delta_y < 0:\n          actions.extend([env.world.cookbook.index[\"UP\"]] * abs(delta_y))\n      \n      return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Retrieve all recipes that produce the specified item\n  recipes = {k: v for k, v in env.world.cookbook.recipes.items() if \"_key\" in v and v[\"_key\"] == item_index}\n\n  # If no recipe is found, return an empty list\n  if not recipes:\n      return []\n\n  # Assume we have only one recipe to produce the item\n  recipe = next(iter(recipes.values()))\n\n  # Identify required ingredients from the recipe\n  missing_ingredients = get_missing_ingredients(recipe)\n\n  # Determine which workshop type is needed based on the ingredients\n  workshop_needed = None\n  for ingredient_index in recipe.keys():\n      kind_name = env.world.cookbook.index.get(ingredient_index, \"unknown\")\n      if kind_name.startswith(\"WORKSHOP\"):\n          workshop_needed = ingredient_index\n          break\n\n  # If no specific workshop is needed, use the first available workshop\n  if workshop_needed is None:\n      workshop_needed = env.world.workshop_indices[0]\n\n  # Find the nearest workshop of the required type\n  workshops = np.argwhere(env._current_state.grid[:, :, workshop_needed] > 0)\n  \n  # If no workshop of the required type is found, return an empty list\n  if workshops.size == 0:\n      return []\n\n  # Choose the closest workshop to the agent's current position\n  agent_pos = env._current_state.pos\n  distances = np.sum(np.abs(workshops - agent_pos), axis=1)\n  nearest_workshop = tuple(workshops[np.argmin(distances)])\n\n  # Generate actions to move the agent to the nearest workshop\n  actions_to_workshop = move_to(env, nearest_workshop)\n\n  # Use action to craft the item\n  use_action_index = env.world.cookbook.index[\"USE\"]\n\n  # Collect missing ingredients if any\n  actions_to_collect = []\n  for ingredient_index, count in missing_ingredients:\n      ingredient_name = env.world.cookbook.index.get(ingredient_index, \"unknown\")\n      actions_to_collect.extend(collect(env, ingredient_name) * count)\n\n  # Combine all actions: collecting missing ingredients, moving to workshop, and using it\n  return actions_to_collect + actions_to_workshop + [use_action_index]", "island_id": 4, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T03:04:52.166651", "function_name": "craft", "function_body": "  def get_missing_ingredients(recipe):\n      required_ingredients = {k: v for k, v in recipe.items() if k != \"_key\"}\n      missing_ingredients = []\n      inventory_counts = env._current_state.inventory\n      for ingredient_index, count in required_ingredients.items():\n          if inventory_counts[ingredient_index] < count:\n              missing_ingredients.append((ingredient_index, count - inventory_counts[ingredient_index]))\n      return missing_ingredients\n\n  item_index = env.world.cookbook.index[item]\n\n  # Retrieve all recipes that produce the specified item\n  recipes = {k: v for k, v in env.world.cookbook.recipes.items() if \"_key\" in v and v[\"_key\"] == item_index}\n\n  # If no recipe is found, return an empty list\n  if not recipes:\n      return []\n\n  # Assume we have only one recipe to produce the item\n  recipe = next(iter(recipes.values()))\n\n  # Identify required ingredients from the recipe\n  missing_ingredients = get_missing_ingredients(recipe)\n\n  # Determine which workshop type is needed based on the ingredients\n  workshop_needed = None\n  for ingredient_index in recipe.keys():\n      kind_name = env.world.cookbook.index.get(ingredient_index, \"unknown\")\n      if kind_name.startswith(\"WORKSHOP\"):\n          workshop_needed = ingredient_index\n          break\n\n  # If no specific workshop is needed, use the first available workshop\n  if workshop_needed is None:\n      workshop_needed = env.world.workshop_indices[0]\n\n  # Find the nearest workshop of the required type\n  workshops = np.argwhere(env._current_state.grid[:, :, workshop_needed] > 0)\n  \n  # If no workshop of the required type is found, return an empty list\n  if workshops.size == 0:\n      return []\n\n  # Choose the closest workshop to the agent's current position\n  agent_pos = env._current_state.pos\n  distances = np.sum(np.abs(workshops - agent_pos), axis=1)\n  nearest_workshop = tuple(workshops[np.argmin(distances)])\n\n  # Generate actions to move the agent to the nearest workshop\n  actions_to_workshop = move_to(env, nearest_workshop)\n\n  # Use action to craft the item\n  use_action_index = env.world.cookbook.index[\"USE\"]\n\n  # Collect missing ingredients if any\n  actions_to_collect = []\n  for ingredient_index, count in missing_ingredients:\n      ingredient_name = env.world.cookbook.index.get(ingredient_index, \"unknown\")\n      actions_to_collect.extend(collect(env, ingredient_name) * count)\n\n  # Combine all actions: collecting missing ingredients, moving to workshop, and using it\n  return actions_to_collect + actions_to_workshop + [use_action_index]", "island_id": 4, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T03:06:54.698196", "function_name": "craft", "function_body": "  def get_recipe_for_item(item_index):\n    for workshop, recipe in env.world.cookbook.recipes.items():\n      if '_key' in recipe and recipe['_key'] == item_index:\n        return workshop, recipe\n    return None, None\n\n  def find_nearest_workshop(env, workshop_index):\n    grid = env._current_state.grid\n    height, width, _ = grid.shape\n    workshop_locations = [(x, y) for x in range(width) for y in range(height) if grid[y, x, workshop_index] > 0]\n    \n    if not workshop_locations:\n      return None\n    \n    agent_pos = env._current_state.pos\n    nearest_location = min(workshop_locations, key=lambda loc: abs(loc[0] - agent_pos[0]) + abs(loc[1] - agent_pos[1]))\n    return nearest_location\n\n  def navigate_to(env, target_pos):\n    actions = []\n    agent_pos = env._current_state.pos\n    target_x, target_y = target_pos\n    \n    # Calculate directions needed to move\n    dx = target_x - agent_pos[0]\n    dy = target_y - agent_pos[1]\n    \n    action_map = {(-1, 0): env.N_ACTIONS - 4, (1, 0): env.N_ACTIONS - 3, (0, -1): env.N_ACTIONS - 2, (0, 1): env.N_ACTIONS - 1}\n    \n    # Determine the direction based on the difference in coordinates\n    if dx > 0:\n      actions.extend([action_map[(1, 0)]] * abs(dx))\n    elif dx < 0:\n      actions.extend([action_map[(-1, 0)]] * abs(dx))\n    \n    if dy > 0:\n      actions.extend([action_map[(0, 1)]] * abs(dy))\n    elif dy < 0:\n      actions.extend([action_map[(0, -1)]] * abs(dy))\n    \n    return actions\n\n  def a_star_search(start, goal):\n    open_set = collections.PriorityQueue()\n    open_set.put((0, start))\n    came_from = {}\n    cost_so_far = {}\n    came_from[start] = None\n    cost_so_far[start] = 0\n\n    while not open_set.empty():\n      _, current = open_set.get()\n\n      if current == goal:\n        break\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        new_cost = cost_so_far[current] + heuristic(current, neighbor)\n\n        if neighbor not in cost_so_far or new_cost < cost_so_far[neighbor]:\n          cost_so_far[neighbor] = new_cost\n          priority = new_cost + heuristic(goal, neighbor)\n          open_set.put((priority, neighbor))\n          came_from[neighbor] = current\n\n    return reconstruct_path(came_from, start, goal)\n\n  def reconstruct_path(came_from, start, goal):\n    current = goal\n    path = []\n    while current != start:\n      path.append(current)\n      current = came_from[current]\n    path.append(start)\n    path.reverse()\n    return path\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the recipe and workshop required for crafting this item\n  workshop_index, recipe = get_recipe_for_item(item_index)\n\n  actions = []\n\n  if workshop_index is not None:\n      # Find the nearest workshop location\n      nearest_workshop_location = find_nearest_workshop(env, workshop_index)\n      \n      if nearest_workshop_location is not None:\n          # Navigate to the workshop location using A* search for more efficient pathfinding\n          current_pos = env._current_state.pos\n          actions.extend(a_star_search(current_pos, nearest_workshop_location))\n          \n          # Convert the path into actions (UP, DOWN, LEFT, RIGHT)\n          action_map = {(-1, 0): env.N_ACTIONS - 4, (1, 0): env.N_ACTIONS - 3, (0, -1): env.N_ACTIONS - 2, (0, 1): env.N_ACTIONS - 1}\n          actions_to_workshop = []\n          for i in range(1, len(actions)):\n            dx = actions[i][0] - actions[i-1][0]\n            dy = actions[i][1] - actions[i-1][1]\n            if (dx, dy) in action_map:\n              actions_to_workshop.append(action_map[(dx, dy)])\n          actions.extend(actions_to_workshop)\n          \n          # Use the workshop to craft the item\n          actions.append(env.N_ACTIONS - 5)\n\n  return actions", "island_id": 9, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T03:06:55.697854", "function_name": "craft", "function_body": "  def get_required_primitives(item_index):\n    \"\"\"Get the required primitives to craft the given item.\"\"\"\n    if item_index in env.world.cookbook.primitives:\n      return [item_index]\n    elif item_index in env.world.cookbook.recipes:\n      recipe = env.world.cookbook.recipes[item_index]\n      primitives = []\n      for ingredient, quantity in recipe.items():\n        if ingredient != \"_key\":\n          primitives.extend(get_required_primitives(ingredient) * quantity)\n      return primitives\n    else:\n      raise ValueError(f\"Item index {item_index} not found in cookbook.\")\n\n  def find_nearest_primitive(env, primitive_index):\n    \"\"\"Find the nearest location of a given primitive.\"\"\"\n    grid = env._current_state.grid\n    height, width, _ = grid.shape\n    primitive_locations = [(x, y) for x in range(width) for y in range(height) if grid[y, x, primitive_index] > 0]\n    \n    if not primitive_locations:\n      return None\n    \n    agent_pos = env._current_state.pos\n    nearest_location = min(primitive_locations, key=lambda loc: abs(loc[0] - agent_pos[0]) + abs(loc[1] - agent_pos[1]))\n    return nearest_location\n\n  def navigate_to(env, target_pos):\n    \"\"\"Navigate the agent to a target position.\"\"\"\n    actions = []\n    agent_pos = env._current_state.pos\n    target_x, target_y = target_pos\n    \n    # Calculate directions needed to move\n    dx = target_x - agent_pos[0]\n    dy = target_y - agent_pos[1]\n    \n    # Determine the direction based on the difference in coordinates\n    if dx > 0:\n      actions.extend([env.action_specs()['RIGHT']] * abs(dx))\n    elif dx < 0:\n      actions.extend([env.action_specs()['LEFT']] * abs(dx))\n    \n    if dy > 0:\n      actions.extend([env.action_specs()['DOWN']] * abs(dy))\n    elif dy < 0:\n      actions.extend([env.action_specs()['UP']] * abs(dy))\n    \n    return actions\n\n  def a_star_search(start, goal):\n    \"\"\"A* search algorithm to find the shortest path.\"\"\"\n    open_set = collections.PriorityQueue()\n    open_set.put((0, start))\n    came_from = {}\n    cost_so_far = {}\n    came_from[start] = None\n    cost_so_far[start] = 0\n\n    while not open_set.empty():\n      _, current = open_set.get()\n\n      if current == goal:\n        break\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        new_cost = cost_so_far[current] + heuristic(current, neighbor)\n\n        if neighbor not in cost_so_far or new_cost < cost_so_far[neighbor]:\n          cost_so_far[neighbor] = new_cost\n          priority = new_cost + heuristic(goal, neighbor)\n          open_set.put((priority, neighbor))\n          came_from[neighbor] = current\n\n    return reconstruct_path(came_from, start, goal)\n\n  def reconstruct_path(came_from, start, goal):\n    \"\"\"Reconstruct the path from start to goal.\"\"\"\n    current = goal\n    path = []\n    while current != start:\n      path.append(current)\n      current = came_from[current]\n    path.append(start)\n    path.reverse()\n    return path\n\n  def heuristic(a, b):\n    \"\"\"Heuristic function for A* search (Manhattan distance).\"\"\"\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the required primitives to craft the item\n  required_primitives = get_required_primitives(item_index)\n  \n  actions = []\n  \n  # Collect each required primitive\n  for primitive_index in set(required_primitives):\n    primitive_pos = find_nearest_primitive(env, primitive_index)\n    \n    if primitive_pos is not None:\n      actions.extend(navigate_to(env, primitive_pos))\n      actions.append(env.action_specs()['USE'])\n    else:\n      raise ValueError(f\"Primitive index {primitive_index} not found on the grid.\")\n\n  # Navigate to and use the workshop to craft the item\n  workshop_index = get_workshop_for_item(item_index)\n  \n  if workshop_index is not None:\n    workshop_pos = find_nearest_workshop(env, workshop_index)\n    \n    if workshop_pos is not None:\n      actions.extend(navigate_to(env, workshop_pos))\n      actions.append(env.action_specs()['USE'])\n    else:\n      raise ValueError(f\"No workshop found for item index {item_index}.\")\n\n  return actions", "island_id": 9, "scores": {"": -1}}
{"timestamp": "2025-09-03T03:07:43.002339", "function_name": "craft", "function_body": "  def move_towards(state, target_pos):\n    current_x, current_y = state.pos\n    target_x, target_y = target_pos\n\n    moves = []\n    # Calculate moves in x-direction\n    if current_x < target_x:\n        moves.extend([craft.MOVE_FUNC(craft.RIGHT)] * (target_x - current_x))\n    elif current_x > target_x:\n        moves.extend([craft.MOVE_FUNC(craft.LEFT)] * (current_x - target_x))\n\n    # Calculate moves in y-direction\n    if current_y < target_y:\n        moves.extend([craft.MOVE_FUNC(craft.DOWN)] * (target_y - current_y))\n    elif current_y > target_y:\n        moves.extend([craft.MOVE_FUNC(craft.UP)] * (current_y - target_y))\n    \n    return moves\n\n  goal_index = env.world.cookbook.index[item]\n  actions = []\n\n  if goal_index in env.world.cookbook.recipes:\n    # Find all workshops that can produce the item\n    workshop_indices = [idx for idx, recipe in env.world.cookbook.recipes.items() \n                        if \"_key\" in recipe and recipe[\"_key\"] == goal_index]\n    \n    if workshop_indices:\n        chosen_workshop_index = workshop_indices[0]\n\n        # Find positions of the chosen workshop in the grid\n        workshop_positions = np.argwhere(env._current_state.grid[:, :, chosen_workshop_index]).tolist()\n\n        if workshop_positions:\n            nearest_workshop_position = min(workshop_positions, \n                                           key=lambda pos: np.linalg.norm(np.array(pos) - np.array(env._current_state.pos)))\n\n            # Move to the nearest workshop position\n            actions.extend(move_towards(env._current_state, nearest_workshop_position))\n\n            # Use the workshop to craft the item\n            actions.append(craft.CRAFT_FUNC(item))\n  \n  return actions", "island_id": 5, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T03:07:44.099418", "function_name": "craft", "function_body": "  goal_index = env.world.cookbook.index[item]\n  actions = []\n\n  if goal_index in env.world.cookbook.recipes:\n    # Find all workshops that can produce the item\n    workshop_indices = [idx for idx, recipe in env.world.cookbook.recipes.items() \n                        if \"_key\" in recipe and recipe[\"_key\"] == goal_index]\n    \n    if workshop_indices:\n        chosen_workshop_index = workshop_indices[0]\n\n        # Find positions of the chosen workshop in the grid\n        workshop_positions = np.argwhere(env._current_state.grid[:, :, chosen_workshop_index]).tolist()\n\n        if workshop_positions:\n            nearest_workshop_position = min(workshop_positions, \n                                           key=lambda pos: np.linalg.norm(np.array(pos) - np.array(env._current_state.pos)))\n\n            # Move to the nearest workshop position\n            current_x, current_y = env._current_state.pos\n            target_x, target_y = nearest_workshop_position\n\n            # Calculate moves in x-direction\n            if current_x < target_x:\n                actions.extend([craft.MOVE_FUNC(craft.RIGHT)] * (target_x - current_x))\n            elif current_x > target_x:\n                actions.extend([craft.MOVE_FUNC(craft.LEFT)] * (current_x - target_x))\n\n            # Calculate moves in y-direction\n            if current_y < target_y:\n                actions.extend([craft.MOVE_FUNC(craft.DOWN)] * (target_y - current_y))\n            elif current_y > target_y:\n                actions.extend([craft.MOVE_FUNC(craft.UP)] * (current_y - target_y))\n\n            # Use the workshop to craft the item\n            actions.append(craft.CRAFT_FUNC(goal_index))\n  \n  return actions", "island_id": 5, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T03:08:49.955185", "function_name": "craft", "function_body": "  def find_path(start, goal):\n    # Simple BFS for finding a path in the grid\n    queue = collections.deque([start])\n    visited = set()\n    parent = {start: None}\n\n    while queue:\n      pos = queue.popleft()\n      if pos == goal:\n        break\n\n      x, y = pos\n      neighbors = [(x+1, y), (x-1, y), (x, y+1), (x, y-1)]\n      \n      for nx, ny in neighbors:\n        if 0 <= nx < current_state.grid.shape[0] and 0 <= ny < current_state.grid.shape[1]:\n          if (nx, ny) not in visited and current_state.next_to(env.world.non_grabbable_indices, pos=(nx, ny)):\n            queue.append((nx, ny))\n            visited.add((nx, ny))\n            parent[(nx, ny)] = pos\n\n    path = []\n    while goal is not None:\n      path.append(goal)\n      goal = parent[goal]\n    return path[::-1]\n\n  actions = []\n  current_state = env._current_state\n\n  # Get index for desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item has a recipe\n  if item_index not in env.world.cookbook.recipes:\n    return []  # No recipe found, can't craft\n\n  # Identify required workshop based on recipe\n  recipe = env.world.cookbook.recipes[item_index]\n  _key = recipe.get(\"_key\")\n  \n  if _key is None:\n    return []  # No key specified in the recipe, can't determine workshop\n  \n  workshop_name = f\"WORKSHOP{_key}\"\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find a position of the workshop on the grid\n  workshop_positions = np.argwhere(current_state.grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n    return []  # Workshop not found on the grid, can't craft\n\n  # Choose the closest workshop to the current position\n  distances = [np.linalg.norm(np.array(pos) - np.array(current_state.pos)) for pos in workshop_positions]\n  closest_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n\n  # Find a path to the closest workshop\n  path_to_workshop = find_path(tuple(current_state.pos), closest_workshop_pos)\n\n  # Convert the path into actions\n  current_pos = tuple(current_state.pos)\n  for next_pos in path_to_workshop:\n    dx = next_pos[0] - current_pos[0]\n    dy = next_pos[1] - current_pos[1]\n\n    if abs(dx) > 1 or abs(dy) > 1:\n      raise ValueError(\"Invalid move detected, pathfinding error\")\n\n    if dx != 0:\n      action = env.world.RIGHT if dx > 0 else env.world.LEFT\n    else:\n      action = env.world.DOWN if dy > 0 else env.world.UP\n\n    actions.append(action)\n    reward, done, observations = env.step(action)\n    current_state = env._current_state\n    current_pos = tuple(current_state.pos)\n\n  # Use the workshop to craft the item\n  actions.append(env.world.USE)\n\n  return actions", "island_id": 0, "scores": {"": 0.0}}
