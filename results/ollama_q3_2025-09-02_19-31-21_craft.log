{"timestamp": "2025-09-02T21:17:32.599570", "function_name": "craft", "function_body": "  # Get the index of the item to be crafted from the cookbook\n  item_index = env.world.cookbook.index[item]\n\n  # Check if there is a recipe for the item in the cookbook\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"No recipe found for {item}.\")\n\n  # Get the workshop index for the item from the recipes\n  # Assuming that \"_key\" contains the workshop information (this might need to be adjusted based on the actual structure of recipes)\n  workshop_index = env.world.cookbook.recipes[item_index][\"_key\"]\n\n  # Determine the direction to move towards the workshop\n  workshop_pos = next((i for i, index in enumerate(env.world.workshop_indices) if index == workshop_index), None)\n  if workshop_pos is None:\n    raise ValueError(f\"No valid workshop found for {item}.\")\n\n  # Calculate the direction from the current position to the workshop\n  target_workshop = env.world.workshop_indices[workshop_pos]\n  current_pos = env._current_state.pos\n\n  # Convert current position and target position to numpy arrays for easier calculation\n  current_pos_np = np.array(current_pos)\n  target_workshop_np = np.array(env.world.scenario.grid.shape[:2])[::-1] // 2 + (workshop_pos - len(env.world.workshop_indices) // 2)\n\n  # Calculate the direction vector from the current position to the workshop\n  direction_vector = target_workshop_np - current_pos_np\n\n  # Determine the actions needed to move towards the workshop based on the direction vector\n  actions_to_take = []\n\n  if direction_vector[0] > 0:\n    actions_to_take.extend([3] * abs(direction_vector[0]))  # RIGHT\n  elif direction_vector[0] < 0:\n    actions_to_take.extend([2] * abs(direction_vector[0]))  # LEFT\n\n  if direction_vector[1] > 0:\n    actions_to_take.extend([0] * abs(direction_vector[1]))  # DOWN\n  elif direction_vector[1] < 0:\n    actions_to_take.extend([1] * abs(direction_vector[1]))  # UP\n\n  # Add the USE action to craft the item at the workshop\n  actions_to_take.append(4)  # USE\n\n  return actions_to_take", "island_id": 1, "scores": {"": -1}}
{"timestamp": "2025-09-02T21:18:02.193162", "function_name": "craft", "function_body": "  # Find the index of the item to be crafted\n  item_index = env.world.cookbook.index[item]\n\n  # Determine which workshop (if any) is required for crafting this item\n  workshop_required = None\n  for recipe_key, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n          workshop_required = recipe_key\n\n  actions = []\n\n  # If a workshop is required to craft the item\n  if workshop_required:\n    # Get all positions of the required workshops on the grid\n    workshop_positions = []\n    for i, workshop_index in enumerate(env.world.workshop_indices):\n        if workshop_index == workshop_required:\n            workshop_name = env.world.cookbook.get(workshop_index)\n            workshop_positions.append(np.argwhere(env._current_state.grid[:, :, workshop_index] > 0))\n\n    # Move to the nearest workshop\n    agent_position = np.array(env._current_state.pos)\n    nearest_workshop = min(workshop_positions, key=lambda pos: np.linalg.norm(agent_position - pos.mean(axis=0)))\n    target_pos = tuple(nearest_workshop[0])\n\n    actions.extend(move_to_position(env, target_pos))\n\n    # Perform the USE action to craft the item\n    actions.append(env.action_specs()['USE'])\n\n  return actions", "island_id": 6, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T21:18:03.245282", "function_name": "craft", "function_body": "  # Determine the workshop needed for crafting the item (if any)\n  recipe_key = None\n  for key, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == env.world.cookbook.index[item]:\n          recipe_key = key\n          break\n\n  # Initialize actions list\n  actions = []\n\n  # If a workshop is required to craft the item\n  if recipe_key:\n    # Get the position of the required workshop from its index\n    workshop_index = env.world.workshop_indices[recipe_key]\n    workshop_position = None\n    \n    # Find the actual grid position corresponding to the workshop index\n    for y in range(env.scenario.init_grid.shape[0]):\n        for x in range(env.scenario.init_grid.shape[1]):\n            if env.scenario.init_grid[y, x, workshop_index] == 1:\n                workshop_position = (x, y)\n                break\n        if workshop_position:\n            break\n\n    # Move to the workshop\n    actions.extend(move_to_workshop(env, workshop_position))\n\n    # Perform the USE action to craft the item\n    actions.append(env.action_specs()['USE'])\n\n  return actions", "island_id": 6, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T21:18:55.955929", "function_name": "craft", "function_body": "  item_idx = env.world.cookbook.index[item]\n  \n  # Get all recipes for the item\n  possible_recipes = {k: v for k, v in env.world.cookbook.recipes.items() if \"_key\" in v and v[\"_key\"] == item_idx}\n  \n  # If no recipe is found, return an empty list\n  if not possible_recipes:\n    return []\n\n  # Assume we have only one recipe to produce the item (or you could choose a specific recipe based on conditions)\n  recipe = next(iter(possible_recipes.values()))\n\n  # Identify required ingredients from the recipe\n  required_ingredients = [k for k in recipe.keys() if k != \"_key\"]\n\n  # Determine which workshop type is needed based on the ingredients\n  workshop_needed = None\n  for ingredient_index in required_ingredients:\n      kind_name = env.world.cookbook.index.get(ingredient_index, \"unknown\")\n      if kind_name.startswith(\"WORKSHOP\"):\n          workshop_needed = ingredient_index\n          break\n\n  # If no specific workshop is needed, use the first available workshop\n  if workshop_needed is None:\n      workshop_needed = env.world.workshop_indices[0]\n\n  # Find the nearest workshop of the required type\n  workshops = np.argwhere(env._current_state.grid[:, :, workshop_needed] > 0)\n  \n  # If no workshop of the required type is found, return an empty list\n  if workshops.size == 0:\n      return []\n\n  # Choose the closest workshop to the agent's current position\n  agent_pos = env._current_state.pos\n  distances = np.sum(np.abs(workshops - agent_pos), axis=1)\n  nearest_workshop = tuple(workshops[np.argmin(distances)])\n\n  # Generate actions to move the agent to the nearest workshop\n  actions_to_workshop = move_to(env, nearest_workshop)\n\n  # Use action to craft the item\n  use_action_index = env.world.cookbook.index[\"USE\"]\n\n  return actions_to_workshop + [use_action_index]", "island_id": 4, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T21:18:57.009532", "function_name": "craft", "function_body": "  # Get the index for the desired item\n  item_idx = env.world.cookbook.index[item]\n\n  # Find the recipe that produces this item\n  recipes = {k: v for k, v in env.world.cookbook.recipes.items() if \"_key\" in v and v[\"_key\"] == item_idx}\n\n  # If no recipe is found, return an empty list\n  if not recipes:\n    return []\n\n  # Assume we have only one recipe to produce the item\n  recipe = next(iter(recipes.values()))\n\n  # Determine which workshop type is needed based on the ingredients\n  workshop_needed = None\n  for ingredient_index in recipe.keys():\n      kind_name = env.world.cookbook.index.get(ingredient_index, \"unknown\")\n      if kind_name.startswith(\"WORKSHOP\"):\n          workshop_needed = ingredient_index\n          break\n\n  # If no specific workshop is needed, use the first available workshop\n  if workshop_needed is None:\n      workshop_needed = env.world.workshop_indices[0]\n\n  # Find the nearest workshop of the required type\n  workshops = np.argwhere(env._current_state.grid[:, :, workshop_needed] > 0)\n  \n  # If no workshop of the required type is found, return an empty list\n  if workshops.size == 0:\n      return []\n\n  # Choose the closest workshop to the agent's current position\n  agent_pos = env._current_state.pos\n  distances = np.sum(np.abs(workshops - agent_pos), axis=1)\n  nearest_workshop = tuple(workshops[np.argmin(distances)])\n\n  # Generate actions to move the agent to the nearest workshop\n  actions_to_workshop = move_to(env, nearest_workshop)\n\n  # Use action index for crafting\n  use_action_index = env.world.cookbook.index[\"USE\"]\n\n  # Combine all actions: moving to workshop and using it\n  return actions_to_workshop + [use_action_index]", "island_id": 4, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T21:20:35.410558", "function_name": "craft", "function_body": "  def get_missing_ingredients(recipe):\n      required_ingredients = {k: v for k, v in recipe.items() if k != \"_key\"}\n      missing_ingredients = []\n      inventory_counts = env._current_state.inventory\n      for ingredient_index, count in required_ingredients.items():\n          if inventory_counts[ingredient_index] < count:\n              missing_ingredients.append((ingredient_index, count - inventory_counts[ingredient_index]))\n      return missing_ingredients\n\n  def move_to(env, target_pos):\n    \"\"\"Generate actions to move the agent to a target position.\"\"\"\n    # Implement pathfinding logic here\n    # For now, this function returns an empty list of actions\n    return []\n\n  item_index = env.world.cookbook.index[item]\n\n  # Retrieve all recipes that produce the specified item\n  recipes = {k: v for k, v in env.world.cookbook.recipes.items() if \"_key\" in v and v[\"_key\"] == item_index}\n\n  # If no recipe is found, return an empty list\n  if not recipes:\n    return []\n\n  # Assume we have only one recipe to produce the item\n  recipe = next(iter(recipes.values()))\n\n  # Identify required ingredients from the recipe\n  missing_ingredients = get_missing_ingredients(recipe)\n\n  # Determine which workshop type is needed based on the ingredients\n  workshop_needed = None\n  for ingredient_index in recipe.keys():\n      kind_name = env.world.cookbook.index.get(ingredient_index, \"unknown\")\n      if kind_name.startswith(\"WORKSHOP\"):\n          workshop_needed = ingredient_index\n          break\n\n  # If no specific workshop is needed, use the first available workshop\n  if workshop_needed is None:\n      workshop_needed = env.world.workshop_indices[0]\n\n  # Find the nearest workshop of the required type\n  workshops = np.argwhere(env._current_state.grid[:, :, workshop_needed] > 0)\n  \n  # If no workshop of the required type is found, return an empty list\n  if workshops.size == 0:\n      return []\n\n  # Choose the closest workshop to the agent's current position\n  agent_pos = env._current_state.pos\n  distances = np.sum(np.abs(workshops - agent_pos), axis=1)\n  nearest_workshop = tuple(workshops[np.argmin(distances)])\n\n  # Generate actions to move the agent to the nearest workshop\n  actions_to_workshop = move_to(env, nearest_workshop)\n\n  # Use action to craft the item\n  use_action_index = env.world.cookbook.index[\"USE\"]\n\n  # Collect missing ingredients if any\n  actions_to_collect = []\n  for ingredient_index, count in missing_ingredients:\n      ingredient_name = env.world.cookbook.index.get(ingredient_index, \"unknown\")\n      actions_to_collect.extend(collect(env, ingredient_name) * count)\n\n  # Combine all actions: collecting missing ingredients, moving to workshop, and using it\n  return actions_to_collect + actions_to_workshop + [use_action_index]", "island_id": 4, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T21:20:36.480923", "function_name": "craft", "function_body": "  def get_missing_ingredients(recipe):\n    required_ingredients = {k: v for k, v in recipe.items() if k != \"_key\"}\n    missing_ingredients = []\n    inventory_counts = env._current_state.inventory\n    for ingredient_index, count in required_ingredients.items():\n      if inventory_counts[ingredient_index] < count:\n        missing_ingredients.append((ingredient_index, count - inventory_counts[ingredient_index]))\n    return missing_ingredients\n\n  def move_to(env, target_pos):\n    \"\"\"Generate actions to move the agent to a target position using pathfinding logic.\"\"\"\n    # Implement pathfinding logic here (e.g., A* or BFS)\n    # For simplicity, let's assume we have a function `find_path` that returns a list of positions\n    # Example: find_path(env._current_state.grid, env._current_state.pos, target_pos)\n    \n    def find_path(grid, start, end):\n      \"\"\"A simple pathfinding function using BFS.\"\"\"\n      from collections import deque\n      \n      directions = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n      queue = deque([start])\n      came_from = {start: None}\n      \n      while queue:\n        current = queue.popleft()\n        if current == end:\n          break\n        for direction in directions:\n          neighbor = tuple(np.add(current, direction))\n          if (0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1] and \n              np.all(grid[neighbor] == 0)):\n            queue.append(neighbor)\n            came_from[neighbor] = current\n      \n      path = []\n      while end:\n        path.append(end)\n        end = came_from[end]\n      \n      return path[::-1]\n\n    # Find the path to the target position\n    path = find_path(env._current_state.grid, env._current_state.pos, target_pos)\n    \n    actions = []\n    current_pos = env._current_state.pos\n    \n    for next_pos in path[1:]:  # Skip the start position\n      direction = tuple(np.subtract(next_pos, current_pos))\n      \n      if direction == (0, 1):\n        actions.append(env.world.cookbook.index[\"RIGHT\"])\n      elif direction == (0, -1):\n        actions.append(env.world.cookbook.index[\"LEFT\"])\n      elif direction == (1, 0):\n        actions.append(env.world.cookbook.index[\"DOWN\"])\n      elif direction == (-1, 0):\n        actions.append(env.world.cookbook.index[\"UP\"])\n      \n      current_pos = next_pos\n    \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Retrieve all recipes that produce the specified item\n  recipes = {k: v for k, v in env.world.cookbook.recipes.items() if \"_key\" in v and v[\"_key\"] == item_index}\n\n  # If no recipe is found, return an empty list\n  if not recipes:\n    return []\n\n  # Assume we have only one recipe to produce the item\n  recipe = next(iter(recipes.values()))\n\n  # Identify required ingredients from the recipe\n  missing_ingredients = get_missing_ingredients(recipe)\n\n  # Determine which workshop type is needed based on the ingredients\n  workshop_needed = None\n  for ingredient_index in recipe.keys():\n      kind_name = env.world.cookbook.index.get(ingredient_index, \"unknown\")\n      if kind_name.startswith(\"WORKSHOP\"):\n          workshop_needed = ingredient_index\n          break\n\n  # If no specific workshop is needed, use the first available workshop\n  if workshop_needed is None:\n      workshop_needed = env.world.workshop_indices[0]\n\n  # Find the nearest workshop of the required type\n  workshops = np.argwhere(env._current_state.grid[:, :, workshop_needed] > 0)\n  \n  # If no workshop of the required type is found, return an empty list\n  if workshops.size == 0:\n      return []\n\n  # Choose the closest workshop to the agent's current position\n  agent_pos = env._current_state.pos\n  distances = np.sum(np.abs(workshops - agent_pos), axis=1)\n  nearest_workshop = tuple(workshops[np.argmin(distances)])\n\n  # Generate actions to move the agent to the nearest workshop\n  actions_to_workshop = move_to(env, nearest_workshop)\n\n  # Use action to craft the item\n  use_action_index = env.world.cookbook.index[\"USE\"]\n\n  # Collect missing ingredients if any\n  actions_to_collect = []\n  for ingredient_index, count in missing_ingredients:\n      ingredient_name = env.world.cookbook.index.get(ingredient_index, \"unknown\")\n      actions_to_collect.extend(collect(env, ingredient_name) * count)\n\n  # Combine all actions: collecting missing ingredients, moving to workshop, and using it\n  return actions_to_collect + actions_to_workshop + [use_action_index]", "island_id": 4, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T21:21:19.102996", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n\n  # Retrieve the recipe for the item.\n  recipe = env.world.cookbook.recipes.get(item_index, None)\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for item: {item}\")\n\n  actions = []\n\n  # Check if we need to go to a specific workshop\n  if \"_key\" in recipe:\n    workshop_key = recipe[\"_key\"]\n    workshop_indices = env.world.workshop_indices\n\n    # Determine the correct workshop index based on the key (e.g., \"workshop0\", \"workshop1\", etc.)\n    if workshop_key.startswith(\"workshop\"):\n      workshop_number = int(workshop_key.replace(\"workshop\", \"\"))\n      workshop_index = workshop_indices[workshop_number]\n    else:\n      raise ValueError(f\"Unknown workshop key: {workshop_key}\")\n\n    # Find the position of the workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index])\n\n    if not workshop_positions.size:\n      raise ValueError(\"Workshop not found in the current scenario.\")\n\n    # Choose a random position around the workshop to move to (since there might be multiple positions)\n    workshop_pos = tuple(workshop_positions[np.random.choice(len(workshop_positions))])\n\n    # Move to the chosen workshop position\n    actions.extend(move_to(env, workshop_pos))\n\n  # Perform the USE action to craft the item\n  actions.append(4)  # Assuming USE is represented by index 4\n\n  return actions", "island_id": 3, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T21:21:20.152167", "function_name": "craft", "function_body": "  def get_closest_workshop_position(workshop_index):\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index])\n    agent_pos = env._current_state.pos\n\n    # Calculate Manhattan distance to each workshop position\n    distances = [abs(pos[0] - agent_pos[0]) + abs(pos[1] - agent_pos[1]) for pos in workshop_positions]\n    \n    # Get the index of the closest workshop position\n    closest_index = np.argmin(distances)\n    \n    return tuple(workshop_positions[closest_index])\n\n  item_index = env.world.cookbook.index[item]\n\n  # Retrieve the recipe for the item.\n  recipe = env.world.cookbook.recipes.get(item_index, None)\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for item: {item}\")\n\n  actions = []\n\n  # Check if we need to go to a specific workshop\n  if \"_key\" in recipe:\n    workshop_key = recipe[\"_key\"]\n    workshop_indices = env.world.workshop_indices\n\n    # Determine the correct workshop index based on the key (e.g., \"workshop0\", \"workshop1\", etc.)\n    if workshop_key.startswith(\"workshop\"):\n      workshop_number = int(workshop_key.replace(\"workshop\", \"\"))\n      workshop_index = workshop_indices[workshop_number]\n    else:\n      raise ValueError(f\"Unknown workshop key: {workshop_key}\")\n\n    # Get the closest position of the workshop in the grid\n    workshop_pos = get_closest_workshop_position(workshop_index)\n\n    # Move to the chosen workshop position\n    actions.extend(move_to(env, workshop_pos))\n\n  # Perform the USE action to craft the item\n  actions.append(4)  # Assuming USE is represented by index 4\n\n  return actions", "island_id": 3, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T21:21:58.354994", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n\n  # Retrieve the recipe for the item.\n  recipe = env.world.cookbook.recipes.get(item_index, None)\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for item: {item}\")\n\n  actions = []\n\n  # Check if we need to go to a specific workshop\n  if \"_key\" in recipe:\n    workshop_key = recipe[\"_key\"]\n    workshop_indices = env.world.workshop_indices\n\n    # Determine the correct workshop index based on the key (e.g., \"workshop0\", \"workshop1\", etc.)\n    if workshop_key.startswith(\"workshop\"):\n      workshop_number = int(workshop_key.replace(\"workshop\", \"\"))\n      workshop_index = workshop_indices[workshop_number]\n    else:\n      raise ValueError(f\"Unknown workshop key: {workshop_key}\")\n\n    # Find the position of the workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index])\n\n    if not workshop_positions.size:\n      raise ValueError(\"Workshop not found in the current scenario.\")\n\n    # Select a random workshop position to move towards\n    target_position = tuple(workshop_positions[np.random.choice(range(len(workshop_positions)))])\n\n    # Move the agent to the selected target position\n    actions.extend(move_to(env, target_position))\n\n  # Check if any ingredient is not already in inventory and needs to be collected first\n  for ingredient_index, count in recipe.items():\n      if ingredient_index != \"_key\" and env._current_state.inventory[ingredient_index] < count:\n          raise ValueError(f\"Ingredient {ingredient_index} missing from inventory.\")\n\n  # Perform the USE action to craft the item\n  actions.append(4)  # Assuming USE is represented by index 4\n\n  return actions", "island_id": 3, "scores": {"": -1}}
{"timestamp": "2025-09-02T21:21:59.410744", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n\n  # Retrieve the recipe for the item.\n  recipe = env.world.cookbook.recipes.get(item_index, None)\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for item: {item}\")\n\n  actions = []\n\n  # Check if we need to go to a specific workshop\n  if \"_key\" in recipe:\n    workshop_key = recipe[\"_key\"]\n    workshop_indices = env.world.workshop_indices\n\n    # Determine the correct workshop index based on the key (e.g., \"workshop0\", \"workshop1\", etc.)\n    if workshop_key.startswith(\"workshop\"):\n      workshop_number = int(workshop_key.replace(\"workshop\", \"\"))\n      workshop_index = workshop_indices[workshop_number]\n    else:\n      raise ValueError(f\"Unknown workshop key: {workshop_key}\")\n\n    # Find the position of the workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index])\n\n    if not workshop_positions.size:\n      raise ValueError(\"Workshop not found in the current scenario.\")\n\n    # Select a random workshop position to move towards\n    target_position = tuple(workshop_positions[np.random.choice(range(len(workshop_positions)))])\n\n    # Move the agent to the selected target position\n    actions.extend(move_to(env, target_position))\n\n  # Perform the USE action to craft the item\n  actions.append(4)  # Assuming USE is represented by index 4\n\n  return actions", "island_id": 3, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T21:23:32.638147", "function_name": "craft", "function_body": "  def get_workshop_for_item(item_index):\n    for workshop_type_index in env.world.workshop_indices:\n        recipes = env.world.cookbook.recipes.get(workshop_type_index, {})\n        if '_key' in recipes and item_index == recipes['_key']:\n            return workshop_type_index\n    return None\n\n  def find_nearest_workshop(env, workshop_type_index):\n      current_pos = env._current_state.pos\n      \n      # Filter out workshops that are actually present on the grid\n      actual_workshops = [(x, y) for y in range(env._current_state.grid.shape[0])\n                          for x in range(env._current_state.grid.shape[1])\n                          if env._current_state.grid[y, x, workshop_type_index] > 0]\n      \n      if not actual_workshops:\n          return None\n      \n      # Find the nearest workshop location to the agent's current position\n      nearest_workshop_location = min(actual_workshops, key=lambda loc: np.linalg.norm(np.array(loc) - np.array(current_pos)))\n      \n      return nearest_workshop_location\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Find the workshop that allows crafting this item (if any)\n  workshop_type_index = get_workshop_for_item(item_index)\n\n  actions = []\n\n  if workshop_type_index is not None:\n      # Get the location of the nearest workshop of the required type\n      nearest_workshop_location = find_nearest_workshop(env, workshop_type_index)\n      \n      if nearest_workshop_location is not None:\n          # Navigate to the workshop location\n          actions.extend(navigate_to(env._current_state.grid, env._current_state.pos, nearest_workshop_location))\n          \n          # Use the workshop to craft the item\n          actions.append(env.action_specs()['USE'])\n  \n  return actions", "island_id": 9, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T21:23:33.706248", "function_name": "craft", "function_body": "  def get_workshop_for_item(item_index):\n    for recipe in env.world.cookbook.recipes.items():\n        if '_key' in recipe[1] and recipe[1]['_key'] == item_index:\n            return recipe[0]\n    return None\n\n  def find_nearest_workshop(env, workshop_index):\n      current_pos = env._current_state.pos\n      grid_shape = env._current_state.grid.shape\n      \n      # Define a heuristic for the A* algorithm (Manhattan distance)\n      def heuristic(a, b):\n          return abs(a[0] - b[0]) + abs(a[1] - b[1])\n      \n      # Function to perform A* search\n      def a_star_search(start, goal):\n          open_set = collections.PriorityQueue()\n          open_set.put((0, start))\n          came_from = {}\n          cost_so_far = {}\n          came_from[start] = None\n          cost_so_far[start] = 0\n\n          while not open_set.empty():\n              _, current = open_set.get()\n\n              if current == goal:\n                  break\n\n              for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                  neighbor = (current[0] + dx, current[1] + dy)\n                  new_cost = cost_so_far[current] + heuristic(current, neighbor)\n\n                  if neighbor not in cost_so_far or new_cost < cost_so_far[neighbor]:\n                      cost_so_far[neighbor] = new_cost\n                      priority = new_cost + heuristic(goal, neighbor)\n                      open_set.put((priority, neighbor))\n                      came_from[neighbor] = current\n\n          return reconstruct_path(came_from, start, goal)\n\n      def reconstruct_path(came_from, start, goal):\n          current = goal\n          path = []\n          while current != start:\n              path.append(current)\n              current = came_from[current]\n          path.reverse()\n          return path\n      \n      # Find the nearest workshop on the grid\n      min_distance = float('inf')\n      nearest_workshop_location = None\n      for y in range(grid_shape[0]):\n          for x in range(grid_shape[1]):\n              if env._current_state.grid[y, x, workshop_index] > 0:\n                  distance = heuristic(current_pos, (x, y))\n                  if distance < min_distance:\n                      min_distance = distance\n                      nearest_workshop_location = (x, y)\n      \n      return a_star_search(current_pos, nearest_workshop_location)\n\n  def navigate_to(env, target_pos):\n      current_pos = env._current_state.pos\n      \n      # Define a heuristic for the A* algorithm (Manhattan distance)\n      def heuristic(a, b):\n          return abs(a[0] - b[0]) + abs(a[1] - b[1])\n      \n      # Function to perform A* search\n      def a_star_search(start, goal):\n          open_set = collections.PriorityQueue()\n          open_set.put((0, start))\n          came_from = {}\n          cost_so_far = {}\n          came_from[start] = None\n          cost_so_far[start] = 0\n\n          while not open_set.empty():\n              _, current = open_set.get()\n\n              if current == goal:\n                  break\n\n              for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                  neighbor = (current[0] + dx, current[1] + dy)\n                  new_cost = cost_so_far[current] + heuristic(current, neighbor)\n\n                  if neighbor not in cost_so_far or new_cost < cost_so_far[neighbor]:\n                      cost_so_far[neighbor] = new_cost\n                      priority = new_cost + heuristic(goal, neighbor)\n                      open_set.put((priority, neighbor))\n                      came_from[neighbor] = current\n\n          return reconstruct_path(came_from, start, goal)\n\n      def reconstruct_path(came_from, start, goal):\n          current = goal\n          path = []\n          while current != start:\n              path.append(current)\n              current = came_from[current]\n          path.reverse()\n          return path\n      \n      # Find the path to the target position\n      path_to_target = a_star_search(current_pos, target_pos)\n\n      # Convert the path into actions (UP, DOWN, LEFT, RIGHT)\n      action_map = {(-1, 0): env.N_ACTIONS - 4, (1, 0): env.N_ACTIONS - 3, (0, -1): env.N_ACTIONS - 2, (0, 1): env.N_ACTIONS - 1}\n      actions_to_target = []\n      for i in range(1, len(path_to_target)):\n          dx = path_to_target[i][0] - path_to_target[i-1][0]\n          dy = path_to_target[i][1] - path_to_target[i-1][1]\n          if (dx, dy) in action_map:\n              actions_to_target.append(action_map[(dx, dy)])\n      \n      return actions_to_target\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Find the workshop that allows crafting this item (if any)\n  workshop_index = get_workshop_for_item(item_index)\n\n  actions = []\n\n  if workshop_index is not None:\n      # Get the location of the nearest workshop\n      path_to_nearest_workshop = find_nearest_workshop(env, workshop_index)\n      \n      # Navigate to the workshop\n      actions.extend(navigate_to(env, (path_to_nearest_workshop[-1][0], path_to_nearest_workshop[-1][1])))\n      \n      # Use the workshop to craft the item\n      actions.append(env.action_specs()['USE'])\n  \n  return actions", "island_id": 9, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T21:24:18.684918", "function_name": "craft", "function_body": "  def move_to_workshop(state, workshop_index):\n      workshop_positions = np.argwhere(state.grid[:, :, workshop_index] > 0)\n      if not workshop_positions.any():\n          raise ValueError(\"Workshop not found in the grid.\")\n      \n      target_pos = tuple(workshop_positions[0])\n      \n      actions = []\n      while state.pos != target_pos:\n          direction, new_state = find_next_direction(state, target_pos)\n          action = env.action_specs()[direction]\n          actions.append(action)\n          state = new_state\n      \n      return actions\n\n  def find_next_direction(state, target_pos):\n      possible_moves = {\n          \"UP\": (0, -1),\n          \"DOWN\": (0, 1),\n          \"LEFT\": (-1, 0),\n          \"RIGHT\": (1, 0)\n      }\n      \n      for move_name, move in possible_moves.items():\n          new_pos = tuple(np.array(state.pos) + np.array(move))\n          if is_valid_move(new_pos):\n              return move_name, CraftState(\n                  state.scenario,\n                  state.grid,\n                  new_pos,\n                  state.dir,\n                  state.inventory\n              )\n      \n      raise ValueError(\"No valid move found.\")\n\n  def is_valid_move(pos):\n      x, y = pos\n      return (0 <= x < env.world.grid.shape[0] and \n              0 <= y < env.world.grid.shape[1] and \n              not any(state.grid[x, y, non_grabbable_index] > 0 for non_grabbable_index in state.world.non_grabbable_indices))\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Determine the workshop needed for crafting the item (if any)\n  workshop_required = None\n  for recipe_key, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n          workshop_required = recipe_key\n  \n  # Initialize actions list\n  actions = []\n\n  # If a workshop is required to craft the item\n  if workshop_required:\n    # Determine the position of the required workshop\n    workshop_position = None\n    for i, workshop_index in enumerate(env.world.workshop_indices):\n        if workshop_index == workshop_required:\n            workshop_position = env.world.cookbook.index.get(env.world.cookbook.get(workshop_index))\n    \n    # Move to the workshop (this part needs to be implemented)\n    actions.extend(move_to_workshop(state, workshop_required))\n\n    # Perform the USE action to craft the item\n    actions.append(env.action_specs()['USE'])\n\n  return actions", "island_id": 6, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T21:24:19.740117", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Determine the workshop needed for crafting the item (if any)\n  workshop_required = None\n  for recipe_key, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n          workshop_required = recipe_key\n  \n  # Initialize actions list\n  actions = []\n\n  # If a workshop is required to craft the item\n  if workshop_required:\n    # Determine the position of the required workshop\n    workshop_position = None\n    for i, workshop_index in enumerate(env.world.workshop_indices):\n        if workshop_index == workshop_required:\n            workshop_position = i\n    \n    # Move to the workshop (this part needs to be implemented)\n    actions.extend(move_to_workshop(env, workshop_position))\n\n    # Perform the USE action to craft the item\n    actions.append(env.action_specs()['USE'])\n\n  return actions", "island_id": 6, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T21:25:12.423128", "function_name": "craft", "function_body": "  # Define constants for movement directions and action USE.\n  UP = env.world.cookbook.index[\"UP\"]\n  DOWN = env.world.cookbook.index[\"DOWN\"]\n  LEFT = env.world.cookbook.index[\"LEFT\"]\n  RIGHT = env.world.cookbook.index[\"RIGHT\"]\n  USE = env.world.cookbook.index[\"USE\"]\n\n  # Get the item index from the cookbook.\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item has a recipe in the cookbook.\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"No recipe found for {item}.\")\n\n  # Retrieve the recipe for the item.\n  recipe = env.world.cookbook.recipes[item_index]\n  \n  # Assume we already have all required primitives in inventory to craft this.\n  actions = []\n\n  # Determine if there's a specific workshop associated with the item using \"_key\".\n  workshop_key = recipe.get(\"_key\", None)\n\n  # If no explicit workshop key, assume the first available workshop.\n  workshop_indices = env.world.workshop_indices\n  if workshop_key:\n    workshop_index = env.world.cookbook.index[workshop_key]\n    workshop_indices = [workshop_index] if workshop_index in workshop_indices else workshop_indices\n\n  # Find a position next to any of the workshops where we can craft the item.\n  for workshop_index in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index])\n      for pos in workshop_positions:\n          # Calculate the direction needed to face the workshop from the current position.\n          delta_x, delta_y = pos[0] - env._current_state.pos[0], pos[1] - env._current_state.pos[1]\n\n          # Only consider adjacent cells for simplicity.\n          if abs(delta_x) + abs(delta_y) == 1:\n              # Move towards the workshop position from the current position.\n              while env._current_state.pos != (pos[0], pos[1]):\n                  if delta_x > 0:\n                      actions.append(RIGHT)\n                  elif delta_x < 0:\n                      actions.append(LEFT)\n                  elif delta_y > 0:\n                      actions.append(DOWN)\n                  elif delta_y < 0:\n                      actions.append(UP)\n\n              # Add the USE action to craft the item.\n              actions.append(USE)\n              break\n\n      if actions:  # If we found a valid position, stop searching.\n          break\n  \n  return actions", "island_id": 1, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T21:25:13.484683", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n\n  # Check if the item has a recipe in the cookbook\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"No recipe found for {item}.\")\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes[item_index]\n  \n  # Assume we already have all required primitives in inventory to craft this.\n  actions = []\n\n  # Check if there is a specific workshop associated with this item (using \"_key\" as placeholder)\n  workshop_key = recipe.get(\"_key\", None)\n\n  # If there's no explicit workshop key, assume the first available workshop\n  workshop_indices = env.world.workshop_indices\n  if workshop_key:\n    workshop_index = env.world.cookbook.index[workshop_key]\n    workshop_indices = [workshop_index] if workshop_index in workshop_indices else workshop_indices\n\n  # Find a position next to any of the workshops where we can craft the item\n  for workshop_index in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index])\n      for pos in workshop_positions:\n          # Calculate the direction needed to face the workshop from the current position\n          delta_x, delta_y = pos[0] - env._current_state.pos[0], pos[1] - env._current_state.pos[1]\n          if abs(delta_x) + abs(delta_y) == 1:  # Only consider adjacent cells for simplicity\n              # Calculate the direction needed to reach the workshop position from the current position\n              while env._current_state.pos != (pos[0], pos[1]):\n                  actions.extend(move_to(env, (pos[0], pos[1])))\n\n              # Add the USE action to craft the item\n              actions.append(env.world.cookbook.index[\"USE\"])\n              break\n\n      if actions:  # If we found a valid position, stop searching\n          break\n  \n  return actions", "island_id": 1, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T21:25:49.413939", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n\n  # Retrieve the recipe for the item.\n  recipe = env.world.cookbook.recipes.get(item_index)\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  actions = []\n\n  # Check if we need to go to a specific workshop\n  if \"_key\" in recipe:\n    workshop_key = recipe[\"_key\"]\n    \n    # Determine the correct workshop index based on the key (e.g., \"workshop0\", \"workshop1\", etc.)\n    if workshop_key.startswith(\"workshop\"):\n      workshop_number = int(workshop_key.replace(\"workshop\", \"\"))\n      workshop_index = env.world.workshop_indices[workshop_number]\n    else:\n      raise ValueError(f\"Unknown workshop key: {workshop_key}\")\n\n    # Find the position of the workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index])\n\n    if workshop_positions.size == 0:\n      raise ValueError(\"Workshop not found in the current scenario.\")\n\n    # Choose a random position around the workshop to move to (since there might be multiple positions)\n    target_position = tuple(workshop_positions[np.random.choice(range(len(workshop_positions)))])\n\n    # Move the agent to the target position\n    actions.extend(move_to(env, target_position))\n\n  # Perform the USE action to craft the item\n  actions.append(4)  # Assuming USE is represented by index 4\n\n  return actions", "island_id": 3, "scores": {"": 0.0}}
