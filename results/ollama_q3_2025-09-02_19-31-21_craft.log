oal\n          current = (x, y)\n          path = []\n          \n          while current in came_from:\n              dx, dy = np.array(current) - np.array(came_from[current])\n              if (dx, dy) == (-1, 0):  # UP\n                  path.append(env.action_specs()['UP'])\n              elif (dx, dy) == (1, 0):  # DOWN\n                  path.append(env.action_specs()['DOWN'])\n              elif (dx, dy) == (0, -1):  # LEFT\n                  path.append(env.action_specs()['LEFT'])\n              elif (dx, dy) == (0, 1):  # RIGHT\n                  path.append(env.action_specs()['RIGHT'])\n              current = came_from[current]\n          \n          return path[::-1]\n      \n      return None\n\n  def heuristic(a, b):\n    \"\"\"Calculate the Manhattan distance between two points.\"\"\"\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Find the workshop that allows crafting this item (if any)\n  workshop_index = get_workshop_for_item(item_index)\n\n  actions = []\n\n  if workshop_index is not None:\n      # Get the location of the nearest workshop of the required type\n      nearest_workshop_location = find_nearest_workshop(env, workshop_index)\n      \n      if nearest_workshop_location is not None:\n          # Navigate to the workshop location\n          actions.extend(nearest_workshop_location)\n          \n          # Craft the item using the workshop\n          actions.append(env.action_specs()['USE'])\n  \n  return actions", "island_id": 9, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T23:29:21.417294", "function_name": "craft", "function_body": "  def get_workshop_for_item(item_index):\n    for workshop in env.world.workshop_indices:\n        if workshop in env.world.cookbook.recipes and '_key' in env.world.cookbook.recipes[workshop] and item_index == env.world.cookbook.recipes[workshop]['_key']:\n            return workshop\n    return None\n\n  def find_nearest_workshop(env, workshop_index):\n      \"\"\"Find the nearest workshop of a given type using A*.\"\"\"\n      world = env.world\n      grid = env._current_state.grid\n      pos = env._current_state.pos\n      \n      # Define heuristic function for A*\n      def heuristic(a, b):\n          return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n      open_set = collections.PriorityQueue()\n      open_set.put((0, pos))\n      came_from = {}\n      cost_so_far = {}\n      came_from[pos] = None\n      cost_so_far[pos] = 0\n\n      while not open_set.empty():\n          _, current = open_set.get()\n\n          # Check if the current cell is a workshop of the required type\n          if world.workshop_indices[workshop_index - len(world.primitives)] == np.argmax(grid[current]):\n              return reconstruct_path(came_from, pos, current)\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              new_cost = cost_so_far[current] + heuristic(current, neighbor)\n\n              if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n                  if neighbor not in cost_so_far or new_cost < cost_so_far[neighbor]:\n                      cost_so_far[neighbor] = new_cost\n                      priority = new_cost + heuristic(neighbor, current)\n                      open_set.put((priority, neighbor))\n                      came_from[neighbor] = current\n\n      return None\n\n  def reconstruct_path(came_from, start, goal):\n      \"\"\"Reconstruct the path from the start to the goal.\"\"\"\n      current = goal\n      path = []\n      while current != start:\n          path.append(current)\n          current = came_from[current]\n      path.reverse()\n      return path\n\n  def navigate_to(env, target_location):\n      \"\"\"Navigate to a target location on the grid.\"\"\"\n      world = env.world\n      actions = []\n      \n      for i in range(1, len(target_location)):\n          dx = target_location[i][0] - target_location[i-1][0]\n          dy = target_location[i][1] - target_location[i-1][1]\n          \n          if (dx, dy) == (-1, 0):  # UP\n              actions.append(env.action_specs()['UP'])\n          elif (dx, dy) == (1, 0):  # DOWN\n              actions.append(env.action_specs()['DOWN'])\n          elif (dx, dy) == (0, -1):  # LEFT\n              actions.append(env.action_specs()['LEFT'])\n          elif (dx, dy) == (0, 1):  # RIGHT\n              actions.append(env.action_specs()['RIGHT'])\n\n      return actions\n\n  def craft_item(env):\n    \"\"\"Use the workshop to craft the item.\"\"\"\n    return [env.action_specs()['USE']]\n\n  # Get the index of the item in the cookbook index\n  item_index = env.world.cookbook.index[item]\n  \n  # Find the workshop that allows crafting this item (if any)\n  workshop_index = get_workshop_for_item(item_index)\n\n  actions = []\n\n  if workshop_index is not None:\n      # Get the location of the nearest workshop of the required type\n      nearest_workshop_location = find_nearest_workshop(env, workshop_index)\n      \n      if nearest_workshop_location is not None:\n          # Navigate to the workshop location\n          actions.extend(navigate_to(env, nearest_workshop_location))\n          \n          # Craft the item using the workshop\n          actions.extend(craft_item(env))\n  \n  return actions", "island_id": 9, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T23:29:22.541495", "function_name": "craft", "function_body": "  def find_nearest_workshop(env, workshop_index):\n    world = env.world\n    grid = env._current_state.grid\n    pos = env._current_state.pos\n\n    # Define heuristic function for A*\n    def heuristic(a, b):\n        return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n    open_set = collections.PriorityQueue()\n    open_set.put((0, pos))\n    came_from = {}\n    cost_so_far = {}\n    came_from[pos] = None\n    cost_so_far[pos] = 0\n\n    while not open_set.empty():\n        _, current = open_set.get()\n\n        # Check if the current cell is a workshop of the required type\n        if world.workshop_indices[workshop_index - len(world.primitives)] == np.argmax(grid[current]):\n            return reconstruct_path(came_from, pos, current)\n\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            neighbor = (current[0] + dx, current[1] + dy)\n            new_cost = cost_so_far[current] + heuristic(current, neighbor)\n\n            if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n                if neighbor not in cost_so_far or new_cost < cost_so_far[neighbor]:\n                    cost_so_far[neighbor] = new_cost\n                    priority = new_cost + heuristic(neighbor, current)\n                    open_set.put((priority, neighbor))\n                    came_from[neighbor] = current\n\n    return None\n\n  def reconstruct_path(came_from, start, goal):\n    \"\"\"Reconstruct the path from the start to the goal.\"\"\"\n    current = goal\n    path = []\n    while current != start:\n        path.append(current)\n        current = came_from[current]\n    path.reverse()\n    return path\n\n  def navigate_to(env, target_location):\n    world = env.world\n    actions = []\n\n    for i in range(1, len(target_location)):\n        dx = target_location[i][0] - target_location[i-1][0]\n        dy = target_location[i][1] - target_location[i-1][1]\n\n        if (dx, dy) == (-1, 0):  # UP\n            actions.append(env.action_specs()['UP'])\n        elif (dx, dy) == (1, 0):  # DOWN\n            actions.append(env.action_specs()['DOWN'])\n        elif (dx, dy) == (0, -1):  # LEFT\n            actions.append(env.action_specs()['LEFT'])\n        elif (dx, dy) == (0, 1):  # RIGHT\n            actions.append(env.action_specs()['RIGHT'])\n\n    return actions\n\n  def get_workshop_for_item(item_index):\n      for workshop, recipes in env.world.cookbook.recipes.items():\n          if '_key' in recipes and item_index == recipes['_key']:\n              return workshop\n      return None\n  \n  def craft_item():\n      return [env.action_specs()['USE']]\n\n  # Get the index of the item to be crafted\n  item_index = env.world.cookbook.index[item]\n  \n  # Find the workshop that allows crafting this item (if any)\n  workshop_index = get_workshop_for_item(item_index)\n\n  actions = []\n\n  if workshop_index is not None:\n      # Get the location of the nearest workshop of the required type\n      nearest_workshop_location = find_nearest_workshop(env, workshop_index)\n      \n      if nearest_workshop_location is not None:\n          # Navigate to the workshop location\n          actions.extend(navigate_to(env, nearest_workshop_location))\n          \n          # Craft the item using the workshop\n          actions.extend(craft_item())\n\n  return actions", "island_id": 9, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T23:30:17.258461", "function_name": "craft", "function_body": "  def get_workshop_index_for_item(item):\n      # Assuming each recipe has a \"_key\" which indicates the required workshop type.\n      cookbook = env.world.cookbook\n      index = cookbook.index[item]\n      recipe = cookbook.recipes[index]\n      if \"_key\" in recipe:\n          return recipe[\"_key\"]\n      return None\n\n  def navigate_to_workshop(workshop_index):\n      # Placeholder to move towards a specific workshop. This should be replaced with the actual navigation logic.\n      actions = []\n      target_pos = (0, 0)  # Placeholder for the target position of the workshop\n      current_pos = env._current_state.pos\n      while current_pos != target_pos:\n          # Simple heuristic: move one step towards the target position\n          if current_pos[0] < target_pos[0]:\n              actions.append(craft.LEFT)\n          elif current_pos[0] > target_pos[0]:\n              actions.append(craft.RIGHT)\n          elif current_pos[1] < target_pos[1]:\n              actions.append(craft.DOWN)\n          else:\n              actions.append(craft.UP)\n          # Update the current position for the next iteration (this is a placeholder update)\n          current_pos = (current_pos[0] + 1, current_pos[1])\n      return actions\n\n  def get_required_primitives(item):\n      cookbook = env.world.cookbook\n      index = cookbook.index[item]\n      return cookbook.primitives_for(index)\n\n  # Main logic for crafting the item\n  required_primitives = get_required_primitives(item)\n  if not required_primitives:\n      raise ValueError(f\"No recipe found for {item}\")\n\n  actions = []\n  workshop_index = get_workshop_index_for_item(item)\n  if workshop_index is None:\n      raise ValueError(\"No workshop found for the specified item\")\n\n  # Navigate to the workshop\n  actions.extend(navigate_to_workshop(workshop_index))\n  \n  # Use action at the workshop to craft the item\n  actions.append(craft.USE)\n\n  return actions", "island_id": 0, "scores": {"": -1}}
{"timestamp": "2025-09-02T23:30:18.236561", "function_name": "craft", "function_body": "  def get_workshop_index_for_item(item):\n    # Fetch the recipe for the item from cookbook\n    recipe = env.world.cookbook.recipes.get(env.world.cookbook.index[item], None)\n    \n    if not recipe:\n      raise ValueError(f\"No recipe found for {item}\")\n    \n    # Determine which workshop is needed based on the recipe (assuming there's a \"_key\" that indicates this)\n    workshop_key = recipe.get(\"_key\", None)\n    \n    if not workshop_key:\n      raise ValueError(f\"No workshop key found in recipe for {item}\")\n\n    return env.world.cookbook.index[workshop_key]\n\n  def navigate_to_workshop(workshop_index):\n    # Assuming the agent can move to a specific position on the grid\n    # For simplicity, let's assume there is a function `move_to_position` that moves the agent to a given (x, y) position.\n    \n    # Get the list of workshop positions from CraftWorld\n    workshops = env.world.workshop_indices\n    \n    if workshop_index not in range(1, len(workshops) + 1):\n      raise ValueError(f\"Invalid workshop index: {workshop_index}\")\n    \n    # Find the (x, y) position corresponding to the workshop index\n    x, y = np.argwhere(env._current_state.grid == workshops[workshop_index - 1])[0]\n    \n    # Move the agent to the workshop position\n    actions = []\n    current_pos = env._current_state.pos\n    \n    # Calculate the direction needed to move towards the workshop\n    dx = x - current_pos[0]\n    dy = y - current_pos[1]\n    \n    # Move in the x-direction first\n    if dx > 0:\n      actions.extend([craft.MOVE_FUNC(craft.RIGHT)] * abs(dx))\n    elif dx < 0:\n      actions.extend([craft.MOVE_FUNC(craft.LEFT)] * abs(dx))\n    \n    # Then move in the y-direction\n    if dy > 0:\n      actions.extend([craft.MOVE_FUNC(craft.DOWN)] * abs(dy))\n    elif dy < 0:\n      actions.extend([craft.MOVE_FUNC(craft.UP)] * abs(dy))\n    \n    return actions\n\n  workshop_index = get_workshop_index_for_item(item)\n  navigate_actions = navigate_to_workshop(workshop_index)\n  \n  # After navigating to the workshop, use the USE action to craft the item\n  navigate_actions.append(craft.CRAFT_FUNC(craft.USE))\n\n  return navigate_actions", "island_id": 0, "scores": {"": -1}}
{"timestamp": "2025-09-02T23:31:26.642179", "function_name": "craft", "function_body": "  def get_workshop_for_item(item_index):\n    for workshop, recipes in env.world.cookbook.recipes.items():\n        if '_key' in recipes and item_index == recipes['_key']:\n            return workshop\n    return None\n\n  def find_nearest_workshop(env, workshop_index):\n      # This function should be implemented to find the nearest location of a specific type of workshop\n      # For now, let's assume it returns some hardcoded location for demonstration purposes.\n      return (0, 0)  # Replace with actual logic\n\n  def navigate_to(env, target_location):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    # Simple navigation: move down until we reach the target y-coordinate\n    while current_pos[1] < target_location[1]:\n        actions.append(env.action_specs()['DOWN'])\n        current_pos = (current_pos[0], current_pos[1] + 1)\n    \n    # Move right until we reach the target x-coordinate\n    while current_pos[0] < target_location[0]:\n        actions.append(env.action_specs()['RIGHT'])\n        current_pos = (current_pos[0] + 1, current_pos[1])\n    \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Find the workshop that allows crafting this item (if any)\n  workshop_index = get_workshop_for_item(item_index)\n\n  actions = []\n\n  if workshop_index is not None:\n      # Get the location of the nearest workshop of the required type\n      nearest_workshop_location = find_nearest_workshop(env, workshop_index)\n      \n      # Navigate to the workshop location\n      actions.extend(navigate_to(env, nearest_workshop_location))\n      \n      # Use the workshop to craft the item\n      actions.append(env.action_specs()['USE'])\n  \n  return actions", "island_id": 9, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T23:31:27.697844", "function_name": "craft", "function_body": "  def get_workshop_for_item(item_index):\n    for workshop, recipes in env.world.cookbook.recipes.items():\n        if '_key' in recipes and item_index == recipes['_key']:\n            return workshop\n    return None\n\n  def find_nearest_workshop(env, workshop_index):\n      # Find all positions of the specified type of workshop on the grid\n      positions = [(x, y) for x in range(env.world.scenario.init_grid.shape[0]) \n                   for y in range(env.world.scenario.init_grid.shape[1]) \n                   if env.world.scenario.init_grid[x, y, workshop_index] > 0]\n      \n      # Find the nearest position to the agent's current position\n      agent_pos = env._current_state.pos\n      distances = [(abs(x - agent_pos[0]) + abs(y - agent_pos[1]), (x, y)) for x, y in positions]\n      if distances:\n          return min(distances, key=lambda d: d[0])[1]\n      return None\n\n  def navigate_to(env, target_location):\n    # This function should generate actions to navigate the agent to the target location\n    # For simplicity, we use a basic A* pathfinding algorithm here.\n    def heuristic(a, b):\n        return abs(b[0] - a[0]) + abs(b[1] - a[1])\n\n    def get_neighbors(pos):\n        neighbors = []\n        x, y = pos\n        if x > 0:\n            neighbors.append((x-1, y))\n        if x < env.world.scenario.init_grid.shape[0]-1:\n            neighbors.append((x+1, y))\n        if y > 0:\n            neighbors.append((x, y-1))\n        if y < env.world.scenario.init_grid.shape[1]-1:\n            neighbors.append((x, y+1))\n        return neighbors\n\n    start = env._current_state.pos\n    end = target_location\n\n    open_set = []\n    heapq.heappush(open_set, (0, start))\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, end)}\n\n    while open_set:\n        current = heapq.heappop(open_set)[1]\n        \n        if current == end:\n            path = []\n            while current in came_from:\n                path.append(current)\n                current = came_from[current]\n            path.reverse()\n            return [env.action_specs()[action] for action in path_to_actions(path, env._current_state.pos)]\n        \n        for neighbor in get_neighbors(current):\n            tentative_g_score = g_score[current] + 1\n            \n            if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                came_from[neighbor] = current\n                g_score[neighbor] = tentative_g_score\n                f_score[neighbor] = tentative_g_score + heuristic(neighbor, end)\n                heapq.heappush(open_set, (f_score[neighbor], neighbor))\n    \n    return []\n\n  def path_to_actions(path, start):\n      actions = []\n      for i in range(len(path) - 1):\n          x1, y1 = path[i]\n          x2, y2 = path[i+1]\n          \n          if x2 > x1:\n              actions.append('RIGHT')\n          elif x2 < x1:\n              actions.append('LEFT')\n          elif y2 > y1:\n              actions.append('DOWN')\n          elif y2 < y1:\n              actions.append('UP')\n      return [env.action_specs()[action] for action in actions]\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Find the workshop that allows crafting this item (if any)\n  workshop_index = get_workshop_for_item(item_index)\n\n  actions = []\n\n  if workshop_index is not None:\n      # Get the location of the nearest workshop of the required type\n      nearest_workshop_location = find_nearest_workshop(env, workshop_index)\n      \n      # Navigate to the workshop location\n      actions.extend(navigate_to(env, nearest_workshop_location))\n      \n      # Use the workshop to craft the item\n      actions.append(env.action_specs()['USE'])\n  \n  return actions", "island_id": 9, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T23:33:23.263625", "function_name": "craft", "function_body": "  def get_closest_workshop(item_index):\n    \"\"\"Finds the closest workshop that can craft the specified item.\"\"\"\n    # Determine the workshop required based on the recipe key\n    workshop_indices = []\n    for output_idx, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n        workshop_name = ingredients.get(\"_workshop\")\n        if workshop_name:\n          workshop_indices.append(env.world.cookbook.index[workshop_name])\n    \n    # If no specific workshop is needed, use a default one\n    if not workshop_indices:\n      return env.world.workshop_indices[0]  # Default to the first workshop type\n    \n    # Find the closest workshop in the grid\n    agent_pos = np.array(env._current_state.pos)\n    min_distance = float('inf')\n    closest_workshop_index = None\n    for workshop_index in workshop_indices:\n      for y in range(grid_shape[1]):\n        for x in range(grid_shape[0]):\n          if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n            target_pos = np.array((x, y))\n            distance = np.linalg.norm(agent_pos - target_pos)\n            if distance < min_distance:\n              min_distance = distance\n              closest_workshop_index = workshop_index\n    return closest_workshop_index\n\n  def path_to_target(start, target):\n    \"\"\"Computes the path from start position to target position using BFS.\"\"\"\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]  # UP, RIGHT, DOWN, LEFT\n    queue = collections.deque([(start, [])])\n    visited = set()\n    \n    while queue:\n        current_pos, actions = queue.popleft()\n        \n        if tuple(current_pos) == target:\n            return actions\n        \n        for direction in directions:\n            new_pos = (current_pos[0] + direction[0], current_pos[1] + direction[1])\n            \n            # Ensure the new position is within bounds and not visited\n            if 0 <= new_pos[0] < grid_shape[0] and 0 <= new_pos[1] < grid_shape[1]:\n                if new_pos not in visited:\n                    visited.add(new_pos)\n                    new_actions = actions + [directions.index(direction)]\n                    queue.append((new_pos, new_actions))\n    \n    return []  # Return an empty list if no path is found\n\n  item_index = env.world.cookbook.index[item]\n  grid_shape = env._current_state.grid.shape[:2]\n\n  # Find the closest workshop for crafting\n  workshop_index = get_closest_workshop(item_index)\n\n  # Find the position of the closest workshop in the grid\n  agent_pos = np.array(env._current_state.pos)\n  workshop_pos = None\n  min_distance = float('inf')\n  for y in range(grid_shape[1]):\n    for x in range(grid_shape[0]):\n      if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n        target_pos = np.array((x, y))\n        distance = np.linalg.norm(agent_pos - target_pos)\n        if distance < min_distance:\n          min_distance = distance\n          workshop_pos = (x, y)\n\n  # If no workshop position is found, return an empty list of actions\n  if workshop_pos is None:\n    return []\n\n  # Calculate the path to the closest workshop using BFS and perform the USE action\n  target_pos = tuple(workshop_pos)\n  actions_to_workshop = path_to_target(tuple(agent_pos), target_pos)\n\n  if not actions_to_workshop:\n    return []  # Return an empty list if no path is found\n\n  # Append the USE action to craft the item\n  actions_to_workshop.append(4)  # USE to craft the item\n\n  return actions_to_workshop", "island_id": 2, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T23:33:24.370844", "function_name": "craft", "function_body": "  def get_closest_workshop(item_index):\n    \"\"\"Finds the closest workshop that can craft the specified item.\"\"\"\n    # Determine the workshop required based on the recipe key\n    workshop_indices = []\n    for output_idx, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n        workshop_name = ingredients.get(\"_workshop\")\n        if workshop_name:\n          workshop_indices.append(env.world.cookbook.index[workshop_name])\n    \n    # If no specific workshop is needed, use a default one\n    if not workshop_indices:\n      return env.world.workshop_indices[0]  # Default to the first workshop type\n    \n    # Find the closest workshop in the grid\n    agent_pos = np.array(env._current_state.pos)\n    min_distance = float('inf')\n    closest_workshop_index = None\n    for workshop_index in workshop_indices:\n      for y in range(grid_shape[1]):\n        for x in range(grid_shape[0]):\n          if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n            target_pos = np.array((x, y))\n            distance = np.linalg.norm(agent_pos - target_pos)\n            if distance < min_distance:\n              min_distance = distance\n              closest_workshop_index = workshop_index\n    return closest_workshop_index\n\n  def path_to_target(start, target):\n    \"\"\"Computes the path from start position to target position using A* algorithm.\"\"\"\n    open_set = []\n    closed_set = set()\n    g_costs = {tuple(start): 0}\n    f_costs = {tuple(start): np.linalg.norm(np.array(target) - start)}\n    parents = {}\n\n    def heuristic(a, b):\n      return np.linalg.norm(np.array(b) - a)\n\n    open_set.append((f_costs[tuple(start)], tuple(start)))\n\n    while open_set:\n        _, current = min(open_set, key=lambda x: x[0])\n        open_set.remove((f_costs[current], current))\n        closed_set.add(current)\n\n        if current == tuple(target):\n            path = []\n            while current in parents:\n                path.append(parents[current])\n                current = parents[current]\n            return path[::-1]\n\n        for direction in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n            neighbor = (current[0] + direction[0], current[1] + direction[1])\n\n            if 0 <= neighbor[0] < grid_shape[0] and 0 <= neighbor[1] < grid_shape[1]:\n                tentative_g_cost = g_costs[current] + 1\n\n                if neighbor in closed_set:\n                    continue\n                elif neighbor not in [x[1] for x in open_set] or tentative_g_cost < g_costs[neighbor]:\n                    parents[neighbor] = current\n                    g_costs[neighbor] = tentative_g_cost\n                    f_costs[neighbor] = tentative_g_cost + heuristic(neighbor, target)\n                    if neighbor not in [x[1] for x in open_set]:\n                        open_set.append((f_costs[neighbor], neighbor))\n\n    return []\n\n  item_index = env.world.cookbook.index[item]\n  grid_shape = env._current_state.grid.shape[:2]\n\n  # Find the closest workshop for crafting\n  workshop_index = get_closest_workshop(item_index)\n\n  # Find the position of the closest workshop in the grid\n  agent_pos = np.array(env._current_state.pos)\n  workshop_pos = None\n  min_distance = float('inf')\n  for y in range(grid_shape[1]):\n    for x in range(grid_shape[0]):\n      if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n        target_pos = np.array((x, y))\n        distance = np.linalg.norm(agent_pos - target_pos)\n        if distance < min_distance:\n          min_distance = distance\n          workshop_pos = (x, y)\n\n  # If no workshop position is found, return an empty list of actions\n  if workshop_pos is None:\n    return []\n\n  # Calculate the path to the closest workshop and perform the USE action\n  target_pos = np.array(workshop_pos)\n  path_actions = []\n  grid_path = path_to_target(tuple(agent_pos), tuple(target_pos))\n\n  for step in grid_path:\n      direction = (step[0] - agent_pos[0], step[1] - agent_pos[1])\n      if direction == (-1, 0):\n          path_actions.append(2)  # LEFT\n      elif direction == (1, 0):\n          path_actions.append(3)  # RIGHT\n      elif direction == (0, -1):\n          path_actions.append(0)  # DOWN\n      elif direction == (0, 1):\n          path_actions.append(1)  # UP\n      \n      agent_pos = np.array(step)\n\n  path_actions.append(4)  # USE to craft the item\n\n  return path_actions", "island_id": 2, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T23:35:48.543613", "function_name": "craft", "function_body": "  # Helper function to get missing ingredients for a recipe\n  def get_missing_ingredients(recipe):\n      required_ingredients = {k: v for k, v in recipe.items() if k != \"_key\"}\n      inventory_counts = env._current_state.inventory\n      missing_ingredients = []\n      \n      for ingredient_index, count in required_ingredients.items():\n          if inventory_counts[ingredient_index] < count:\n              missing_ingredients.append((ingredient_index, count - inventory_counts[ingredient_index]))\n      \n      return missing_ingredients\n\n  # Helper function to move the agent to a target position using pathfinding\n  def move_to(env, target_pos):\n      from collections import deque\n      \n      directions = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n      queue = deque([env._current_state.pos])\n      came_from = {env._current_state.pos: None}\n      \n      while queue:\n          current = queue.popleft()\n          if current == target_pos:\n              break\n          for direction in directions:\n              neighbor = tuple(np.add(current, direction))\n              if (0 <= neighbor[0] < env._current_state.grid.shape[0] and \n                  0 <= neighbor[1] < env._current_state.grid.shape[1] and \n                  np.all(env._current_state.grid[neighbor] == 0)):\n                  queue.append(neighbor)\n                  came_from[neighbor] = current\n      \n      path = []\n      while target_pos:\n          path.append(target_pos)\n          target_pos = came_from[target_pos]\n      \n      return path[::-1]\n\n  # Helper function to collect all required ingredients\n  def collect_missing_ingredients(env, missing_ingredients) -> list[int]:\n      actions = []\n      for ingredient_index, count in missing_ingredients:\n          ingredient_name = env.world.cookbook.index.get(ingredient_index, \"unknown\")\n          if ingredient_name == \"unknown\":\n              continue  # Skip unknown ingredients\n          \n          # Collect the ingredient 'count' times\n          for _ in range(count):\n              actions.extend(collect(env, ingredient_name))\n      \n      return actions\n\n  # Helper function to find the closest primitive based on the name\n  def find_closest_primitive(env, primitive_name) -> tuple[int, int]:\n      try:\n          primitive_index = env.world.cookbook.index[primitive_name]\n          primitives = np.argwhere(env._current_state.grid[:, :, primitive_index] > 0)\n          \n          if primitives.size == 0:\n              return None\n          \n          agent_pos = env._current_state.pos\n          distances = np.sum(np.abs(primitives - agent_pos), axis=1)\n          nearest_primitive = tuple(primitives[np.argmin(distances)])\n          \n          return nearest_primitive\n      except KeyError:\n          print(f\"Primitive {primitive_name} not found in cookbook index.\")\n          return None\n\n  # Helper function to generate actions to collect a specific primitive\n  def collect(env, primitive_name) -> list[int]:\n      nearest_primitive = find_closest_primitive(env, primitive_name)\n      if nearest_primitive is None:\n          return []\n      \n      path_to_primitive = move_to(env, nearest_primitive)\n      use_action_index = env.world.cookbook.index[\"USE\"]\n      \n      # Return the list of actions including moving to the primitive and using it\n      return [move for pos in path_to_primitive for move in get_move_actions(env._current_state.pos, pos)] + [use_action_index]\n\n  def get_move_actions(current_pos, target_pos):\n      \"\"\"Generate a sequence of actions to move from current position to target position.\"\"\"\n      directions = {\n          (0, 1): env.action_specs()['RIGHT'],\n          (0, -1): env.action_specs()['LEFT'],\n          (1, 0): env.action_specs()['DOWN'],\n          (-1, 0): env.action_specs()['UP']\n      }\n      \n      path_to_primitive = move_to(env, target_pos)\n      actions = []\n      \n      for i in range(len(path_to_primitive) - 1):\n          dx = path_to_primitive[i + 1][0] - path_to_primitive[i][0]\n          dy = path_to_primitive[i + 1][1] - path_to_primitive[i][1]\n          move_action = directions.get((dx, dy), None)\n          \n          if move_action is not None:\n              actions.append(move_action)\n      \n      return actions\n\n  # Main logic to craft the item\n  item_index = env.world.cookbook.index[item]\n  \n  # Find the recipe for the item\n  recipes = {k: v for k, v in env.world.cookbook.recipes.items() if \"_key\" in v and v[\"_key\"] == item_index}\n  \n  if not recipes:\n      print(f\"No recipe found for item {item}\")\n      return []\n\n  recipe = next(iter(recipes.values()))\n  missing_ingredients = get_missing_ingredients(recipe)\n\n  actions_to_collect = collect_missing_ingredients(env, missing_ingredients)\n  \n  # Determine which workshop type is needed based on the ingredients\n  workshop_needed = None\n  for ingredient_index in recipe.keys():\n      kind_name = env.world.cookbook.index.get(ingredient_index, \"unknown\")\n      if kind_name.startswith(\"WORKSHOP\"):\n          workshop_needed = ingredient_index\n          break\n\n  if workshop_needed is None:\n      print(\"No workshop found in the recipe.\")\n      workshop_needed = env.world.workshop_indices[0]  # Default to the first workshop type available\n\n  workshops = np.argwhere(env._current_state.grid[:, :, workshop_needed] > 0)\n  \n  if workshops.size == 0:\n      print(f\"No available workshops of type {workshop_needed}\")\n      return []\n\n  agent_pos = env._current_state.pos\n  distances = np.sum(np.abs(workshops - agent_pos), axis=1)\n  nearest_workshop = tuple(workshops[np.argmin(distances)])\n\n  actions_to_workshop = move_to(env, nearest_workshop)\n\n  use_action_index = env.world.cookbook.index[\"USE\"]\n\n  return actions_to_collect + actions_to_workshop + [use_action_index]", "i