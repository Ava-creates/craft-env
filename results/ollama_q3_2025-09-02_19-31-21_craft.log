turn actions\n\n  def get_required_primitives(item_index):\n    required_primitives = []\n    for ingredients in env.world.cookbook.recipes.values():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n        required_primitives.extend([ingredient for ingredient, count in ingredients.items() if isinstance(ingredient, int)])\n        break\n    return required_primitives\n\n  def collect_primitive(primitive_index):\n    actions = []\n    agent_pos = np.array(env._current_state.pos)\n    grid_shape = env._current_state.grid.shape[:2]\n    \n    # Find the closest source of the primitive in the grid\n    min_distance = float('inf')\n    closest_source_pos = None\n    for y in range(grid_shape[1]):\n      for x in range(grid_shape[0]):\n        if env._current_state.grid[x, y, primitive_index] > 0:\n          target_pos = np.array((x, y))\n          distance = np.linalg.norm(agent_pos - target_pos)\n          if distance < min_distance:\n            min_distance = distance\n            closest_source_pos = (x, y)\n\n    if closest_source_pos is None:\n      return actions\n\n    # Navigate to the closest source of the primitive and collect it\n    actions.extend(navigate_to_position(closest_source_pos))\n    actions.append(4)  # USE to collect the primitive\n\n    return actions\n\n  def craft_item_at_workshop():\n    actions = []\n    workshop_index = get_closest_workshop(item_index)\n    \n    # Find all workshops in the grid\n    workshop_positions = []\n    for y in range(grid_shape[1]):\n      for x in range(grid_shape[0]):\n        if env._current_state.grid[x, y, workshop_index] > 0:\n          workshop_positions.append((x, y))\n\n    # If no workshops are found, return an empty list of actions\n    if not workshop_positions:\n      return []\n\n    closest_workshop = min(workshop_positions, key=lambda pos: np.linalg.norm(np.array(pos) - np.array(env._current_state.pos)))\n    actions.extend(navigate_to_position(closest_workshop))\n    actions.append(4)  # USE to craft the item\n\n    return actions\n  \n  def update_agent_pos(actions):\n    agent_pos = np.array(env._current_state.pos)\n    for action in actions:\n      if action == 0:  # DOWN\n        agent_pos[1] -= 1\n      elif action == 1:  # UP\n        agent_pos[1] += 1\n      elif action == 2:  # LEFT\n        agent_pos[0] -= 1\n      elif action == 3:  # RIGHT\n        agent_pos[0] += 1\n    return agent_pos\n\n  item_index = env.world.cookbook.index[item]\n  grid_shape = env._current_state.grid.shape[:2]\n\n  required_primitives = get_required_primitives(item_index)\n\n  actions = []\n  for primitive_index in required_primitives:\n    if env._current_state.inventory[primitive_index] == 0:  # Check if the primitive is not already collected\n      collect_actions = collect_primitive(primitive_index)\n      actions.extend(collect_actions)\n      env._current_state.pos = update_agent_pos(collect_actions)  # Update agent position after collecting\n\n  craft_actions = craft_item_at_workshop()\n  actions.extend(craft_actions)\n\n  return actions", "island_id": 1, "scores": {"": 2.0}}
{"timestamp": "2025-09-03T07:36:05.924993", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n\n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      # Determine the direction with the smallest absolute difference\n      if abs(dx) > abs(dy):\n          if dx > 0:\n              actions.append(3)  # RIGHT\n          else:\n              actions.append(2)  # LEFT\n      else:\n          if dy > 0:\n              actions.append(1)  # UP\n          else:\n              actions.append(0)  # DOWN\n\n      current_pos = (current_pos[0] + (dx // abs(dx)) if dx != 0 else current_pos[0],\n                     current_pos[1] + (dy // abs(dy)) if dy != 0 else current_pos[1])\n      \n    return actions\n  \n  def get_workshop_for_item(item_index):\n      # Assuming that the recipe for an item specifies which workshop is needed\n      # For simplicity, let's assume there is a mapping from items to workshops in the cookbook\n      # Here we just use a placeholder. In reality, this would need to be extracted from the recipes.\n      return env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  workshop_index = get_workshop_for_item(item_index)\n\n  # Find the closest workshop of the required type\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 7, "scores": {"": 0.90000004}}
{"timestamp": "2025-09-03T07:36:06.990959", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n\n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      # Move horizontally first\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      \n      # Then move vertically\n      if dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n\n      current_pos = (current_pos[0] + (dx // abs(dx)) if dx != 0 else current_pos[0],\n                     current_pos[1] + (dy // abs(dy)) if dy != 0 else current_pos[1])\n      \n    return actions\n  \n  def get_workshop_for_item(item_index):\n      # Assuming that the recipe for an item specifies which workshop is needed\n      # For simplicity, let's assume there is a mapping from items to workshops in the cookbook\n      # Here we just use a placeholder. In reality, this would need to be extracted from the recipes.\n      return env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  workshop_index = get_workshop_for_item(item_index)\n\n  # Find the closest workshop of the required type\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Check if we are next to the workshop\n  current_pos = env._current_state.pos\n  dx = abs(closest_workshop_pos[0] - current_pos[0])\n  dy = abs(closest_workshop_pos[1] - current_pos[1])\n\n  if dx + dy > 1:\n      # If not, move closer to the workshop\n      actions_to_workshop.extend(move_to(env, closest_workshop_pos))\n\n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 7, "scores": {"": 0.7}}
{"timestamp": "2025-09-03T07:37:38.562034", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      # Prioritize horizontal movement if both directions are available\n      if abs(dx) > abs(dy):\n        actions.append(3 if dx > 0 else 2)\n        current_pos = (current_pos[0] + (dx // abs(dx)), current_pos[1])\n      elif abs(dy) > abs(dx):\n        actions.append(1 if dy > 0 else 0)\n        current_pos = (current_pos[0], current_pos[1] + (dy // abs(dy)))\n      else:  # If dx == dy, move in one direction and then the other\n        actions.append(3 if dx > 0 else 2)  # Move horizontally first\n        current_pos = (current_pos[0] + (dx // abs(dx)), current_pos[1])\n        actions.append(1 if dy > 0 else 0)  # Then move vertically\n        current_pos = (current_pos[0], current_pos[1] + (dy // abs(dy)))\n\n    return actions\n\n  def get_workshop_for_item(item_index, recipes):\n      # This function should determine the specific workshop type needed for an item.\n      # For now, we will use a simple heuristic based on the item name.\n      if 'PLANK' in item or 'STICK' in item:\n          return env.world.workshop_indices[0]  # Workshop0 for wood-related items\n      elif 'CLOTH' in item or 'ROPE' in item:\n          return env.world.workshop_indices[1]  # Workshop1 for fabric-related items\n      elif 'BRIDGE' in item or 'LADDER' in item:\n          return env.world.workshop_indices[2]  # Workshop2 for construction-related items\n      else:\n          return env.world.workshop_indices[0]  # Default to Workshop0\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  workshop_index = get_workshop_for_item(item, env.world.cookbook.recipes)\n\n  # Find the closest workshop of the required type\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 7, "scores": {"": 4.7}}
{"timestamp": "2025-09-03T07:37:39.522156", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos, workshop_index):\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if grid[i, j, workshop_index] > 0:\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      # Prioritize horizontal movement if both directions are available\n      if dx != 0 and dy != 0:\n        if abs(dx) > abs(dy):\n          actions.append(3 if dx > 0 else 2)\n          current_pos = (current_pos[0] + (dx // abs(dx)), current_pos[1])\n        else:\n          actions.append(1 if dy > 0 else 0)\n          current_pos = (current_pos[0], current_pos[1] + (dy // abs(dy)))\n      elif dx != 0:\n        actions.append(3 if dx > 0 else 2)\n        current_pos = (current_pos[0] + (dx // abs(dx)), current_pos[1])\n      elif dy != 0:\n        actions.append(1 if dy > 0 else 0)\n        current_pos = (current_pos[0], current_pos[1] + (dy // abs(dy)))\n\n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  # This step assumes that the recipe specifies the workshop type needed.\n  # Since the problem does not specify how to determine the workshop,\n  # we will assume that all workshops can craft any items for simplicity.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos, workshop_index)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 7, "scores": {"": -1}}
{"timestamp": "2025-09-03T07:38:57.512132", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n\n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      # Determine the direction to move based on the largest difference\n      if abs(dx) > abs(dy):\n        # Move horizontally first\n        if dx > 0:\n          actions.append(3)  # RIGHT\n        else:\n          actions.append(2)  # LEFT\n      else:\n        # Then move vertically\n        if dy > 0:\n          actions.append(1)  # UP\n        else:\n          actions.append(0)  # DOWN\n\n      current_pos = (current_pos[0] + (dx // abs(dx)) if dx != 0 else current_pos[0],\n                     current_pos[1] + (dy // abs(dy)) if dy != 0 else current_pos[1])\n      \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  # This step assumes that the recipe specifies the workshop type needed.\n  # Since the problem does not specify how to determine the workshop,\n  # we will assume that all workshops can craft any items for simplicity.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 9, "scores": {"": 0.90000004}}
{"timestamp": "2025-09-03T07:38:58.564708", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n\n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      # Move horizontally first\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      \n      # Then move vertically\n      if dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n\n      current_pos = (current_pos[0] + (dx // abs(dx)) if dx != 0 else current_pos[0],\n                     current_pos[1] + (dy // abs(dy)) if dy != 0 else current_pos[1])\n      \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  # This step assumes that the recipe specifies the workshop type needed.\n  # Since the problem does not specify how to determine the workshop,\n  # we will assume that all workshops can craft any items for simplicity.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 9, "scores": {"": 4.7}}
{"timestamp": "2025-09-03T07:40:56.780186", "function_name": "craft", "function_body": "  def get_closest_workshop(item_index):\n    \"\"\"Finds the closest workshop that can craft the specified item.\"\"\"\n    # Determine the workshop required based on the recipe key\n    workshop_indices = []\n    for output_idx, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n        workshop_name = ingredients.get(\"_workshop\")\n        if workshop_name:\n          workshop_indices.append(env.world.cookbook.index[workshop_name])\n    \n    # If no specific workshop is needed, use a default one\n    if not workshop_indices:\n      return env.world.workshop_indices[0]  # Default to the first workshop type\n    \n    # Find the closest workshop in the grid\n    agent_pos = np.array(env._current_state.pos)\n    min_distance = float('inf')\n    closest_workshop_index = None\n    for workshop_index in workshop_indices:\n      for y in range(grid_shape[1]):\n        for x in range(grid_shape[0]):\n          if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n            target_pos = np.array((x, y))\n            distance = np.linalg.norm(agent_pos - target_pos)\n            if distance < min_distance:\n              min_distance = distance\n              closest_workshop_index = (x, y)  # Store the position instead of index\n    \n    return closest_workshop_index\n\n  def path_to_target(start, target):\n    \"\"\"Computes the path from start position to target position using A* algorithm.\"\"\"\n    actions = []\n    moves = [(1, 0, 3), (-1, 0, 2), (0, 1, 1), (0, -1, 0)]  # RIGHT, LEFT, UP, DOWN\n    open_set = collections.deque([(start[0], start[1], [])])  # Queue for BFS\n    visited = set()\n    \n    while open_set:\n      x, y, path = open_set.popleft()\n      \n      if (x, y) == tuple(target):\n        return path\n      \n      if (x, y) in visited:\n        continue\n      \n      visited.add((x, y))\n      \n      for dx, dy, action in moves:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < grid_shape[0] and 0 <= ny < grid_shape[1]:\n          open_set.append((nx, ny, path + [action]))\n    \n    return actions\n\n  def get_required_primitives(item_index):\n    \"\"\"Retrieves the list of required primitives for crafting an item.\"\"\"\n    for output_idx, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n        return [env.world.cookbook.index[primitive] for primitive in ingredients.keys() if primitive != \"_key\" and primitive != \"_workshop\"]\n    return []\n\n  def ensure_inventory(item_index):\n    \"\"\"Ensures the inventory has all required primitives for crafting.\"\"\"\n    actions = []\n    current_inventory = env._current_state.inventory.copy()\n    \n    # Get the list of required primitives\n    required_primitives = get_required_primitives(item_index)\n    \n    # Collect each missing primitive from the environment\n    for primitive in required_primitives:\n      if current_inventory[primitive] == 0:\n        collect_actions = collect(env, env.world.cookbook.reverse_index[primitive])\n        actions.extend(collect_actions)\n        # Update inventory after collecting\n        current_inventory[primitive] += 1\n    \n    return actions\n\n  def update_inventory(item_index):\n    \"\"\"Updates the inventory based on crafted items.\"\"\"\n    env._current_state.inventory[item_index] += 1\n\n  item_index = env.world.cookbook.index[item]\n  grid_shape = env._current_state.grid.shape[:2]\n\n  # Ensure inventory has all required primitives\n  actions_to_collect_primitives = ensure_inventory(item_index)\n\n  # Find the closest workshop for crafting\n  workshop_pos = get_closest_workshop(item_index)\n\n  # If no workshop position is found, return an empty list of actions\n  if workshop_pos is None:\n    return []\n\n  # Calculate the path to the closest workshop and perform the USE action\n  target_pos = np.array(workshop_pos)\n  agent_pos = np.array(env._current_state.pos)\n  actions_to_workshop = path_to_target(agent_pos[:2], target_pos)\n  actions_to_workshop.append(4)  # USE to craft the item\n\n  # Update inventory after crafting\n  update_inventory(item_index)\n\n  return actions_to_collect_primitives + actions_to_workshop", "island_id": 2, "scores": {"": -1}}
