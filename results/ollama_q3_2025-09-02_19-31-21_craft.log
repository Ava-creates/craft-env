Turn to face the workshop (simple direction check for now)\n              # Assuming agent faces the right direction after moving\n\n              # Perform the USE action to start crafting\n              actions.append(4)  # USE action index\n  \n  return actions", "island_id": 3, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T01:35:55.483419", "function_name": "craft", "function_body": "  def get_closest_workshop(item_index):\n    \"\"\"Finds the closest workshop that can craft the specified item.\"\"\"\n    # Determine the workshop required based on the recipe key\n    workshop_indices = []\n    for output_idx, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n        workshop_name = ingredients.get(\"_workshop\")\n        if workshop_name:\n          workshop_indices.append(env.world.cookbook.index[workshop_name])\n    \n    # If no specific workshop is needed, use a default one\n    if not workshop_indices:\n      return env.world.workshop_indices[0]  # Default to the first workshop type\n    \n    # Find the closest workshop in the grid\n    agent_pos = np.array(env._current_state.pos)\n    min_distance = float('inf')\n    closest_workshop_index = None\n    for workshop_index in workshop_indices:\n      for y in range(grid_shape[1]):\n        for x in range(grid_shape[0]):\n          if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n            target_pos = np.array((x, y))\n            distance = np.linalg.norm(agent_pos - target_pos)\n            if distance < min_distance:\n              min_distance = distance\n              closest_workshop_index = workshop_index\n    return closest_workshop_index\n\n  def path_to_target(start, target):\n    \"\"\"Computes the path from start position to target position.\"\"\"\n    actions = []\n    while not np.all(start == target):\n        direction = target - start\n        if abs(direction[0]) > abs(direction[1]):\n            # Move horizontally\n            if direction[0] > 0:\n                actions.append(3)  # RIGHT\n                start[0] += 1\n            else:\n                actions.append(2)  # LEFT\n                start[0] -= 1\n        else:\n            # Move vertically\n            if direction[1] > 0:\n                actions.append(1)  # UP\n                start[1] += 1\n            else:\n                actions.append(0)  # DOWN\n                start[1] -= 1\n    return actions\n\n  def ensure_inventory(item_index, required_primitives):\n    \"\"\"Ensures the inventory has all required primitives for crafting.\"\"\"\n    actions = []\n    current_inventory = env._current_state.inventory.copy()\n    \n    for primitive in required_primitives:\n      if current_inventory.get(primitive, 0) == 0:\n        collect_actions = collect(env, primitive)\n        actions.extend(collect_actions)\n        # Update the inventory after collecting\n        current_inventory[primitive] += 1\n    \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n  grid_shape = env._current_state.grid.shape[:2]\n\n  # Find the closest workshop for crafting\n  workshop_index = get_closest_workshop(item_index)\n\n  # Get required primitives from the recipe\n  required_primitives = []\n  target_item_index = None\n  for output_idx, ingredients in env.world.cookbook.recipes.items():\n    if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n      required_primitives.extend([env.world.cookbook.index[p] for p in ingredients.keys() if p != \"_workshop\"])\n      target_item_index = output_idx\n\n  # Ensure inventory has all required primitives\n  actions_to_collect_primitives = ensure_inventory(target_item_index, required_primitives)\n\n  # Find the position of the closest workshop in the grid\n  agent_pos = np.array(env._current_state.pos)\n  workshop_positions = []\n  for y in range(grid_shape[1]):\n    for x in range(grid_shape[0]):\n      if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n        workshop_positions.append((x, y))\n\n  # If no workshops are found, return an empty list of actions\n  if not workshop_positions:\n    return []\n\n  # Calculate distances to all workshops and find the closest one\n  min_distance = float('inf')\n  closest_workshop_pos = None\n  for pos in workshop_positions:\n      target_pos = np.array(pos)\n      distance = np.linalg.norm(agent_pos - target_pos)\n      if distance < min_distance:\n          min_distance = distance\n          closest_workshop_pos = pos\n\n  # Calculate the path to the closest workshop and perform the USE action\n  target_pos = np.array(closest_workshop_pos)\n  actions_to_workshop = path_to_target(agent_pos.tolist(), target_pos.tolist())\n  actions_to_workshop.append(4)  # USE to craft the item\n\n  return actions_to_collect_primitives + actions_to_workshop", "island_id": 2, "scores": {"": -1}}
{"timestamp": "2025-09-03T01:35:56.483585", "function_name": "craft", "function_body": "  def get_closest_workshop(item_index):\n    \"\"\"Finds the closest workshop that can craft the specified item.\"\"\"\n    # Determine the workshop required based on the recipe key\n    workshop_indices = []\n    for output_idx, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n        workshop_name = ingredients.get(\"_workshop\")\n        if workshop_name:\n          workshop_indices.append(env.world.cookbook.index[workshop_name])\n    \n    # If no specific workshop is needed, use a default one\n    if not workshop_indices:\n      return env.world.workshop_indices[0]  # Default to the first workshop type\n    \n    # Find the closest workshop in the grid\n    agent_pos = np.array(env._current_state.pos)\n    min_distance = float('inf')\n    closest_workshop_index = None\n    for workshop_index in workshop_indices:\n      for y in range(grid_shape[1]):\n        for x in range(grid_shape[0]):\n          if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n            target_pos = np.array((x, y))\n            distance = np.linalg.norm(agent_pos - target_pos)\n            if distance < min_distance:\n              min_distance = distance\n              closest_workshop_index = workshop_index\n    return closest_workshop_index\n\n  def path_to_target(start, target):\n    \"\"\"Computes the path from start position to target position using A* algorithm for better efficiency.\"\"\"\n    queue = [(0, start, [])]\n    visited = set()\n    while queue:\n      cost, (x, y), actions = heapq.heappop(queue)\n      if (x, y) == tuple(target):\n        return actions\n      if (x, y) not in visited:\n        visited.add((x, y))\n        for dx, dy, action in [(-1, 0, 2), (1, 0, 3), (0, -1, 0), (0, 1, 1)]:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < grid_shape[0] and 0 <= ny < grid_shape[1]:\n            heapq.heappush(queue, (cost + 1, (nx, ny), actions + [action]))\n    return []\n\n  def ensure_inventory(item_index, required_primitives):\n    \"\"\"Ensures the inventory has all required primitives for crafting.\"\"\"\n    actions = []\n    current_inventory = env._current_state.inventory.copy()\n    \n    for primitive in required_primitives:\n      if current_inventory.get(primitive, 0) == 0:\n        collect_actions = collect(env, primitive)\n        actions.extend(collect_actions)\n        # Update the inventory after collecting\n        current_inventory[primitive] += 1\n    \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n  grid_shape = env._current_state.grid.shape[:2]\n\n  # Find the closest workshop for crafting\n  workshop_index = get_closest_workshop(item_index)\n\n  # Get required primitives from the recipe\n  required_primitives = []\n  for output_idx, ingredients in env.world.cookbook.recipes.items():\n    if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n      required_primitives.extend(ingredients.keys())\n  \n  # Ensure inventory has all required primitives\n  actions_to_collect_primitives = ensure_inventory(item_index, required_primitives)\n\n  # Find the position of the closest workshop in the grid\n  agent_pos = np.array(env._current_state.pos)\n  workshop_positions = []\n  for y in range(grid_shape[1]):\n    for x in range(grid_shape[0]):\n      if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n        workshop_positions.append((x, y))\n\n  # If no workshops are found, return an empty list of actions\n  if not workshop_positions:\n    return []\n\n  # Calculate distances to all workshops and find the closest one\n  min_distance = float('inf')\n  closest_workshop_pos = None\n  for pos in workshop_positions:\n      target_pos = np.array(pos)\n      distance = np.linalg.norm(agent_pos - target_pos)\n      if distance < min_distance:\n          min_distance = distance\n          closest_workshop_pos = pos\n\n  # Calculate the path to the closest workshop and perform the USE action\n  target_pos = np.array(closest_workshop_pos)\n  actions_to_workshop = path_to_target(agent_pos.tolist(), target_pos.tolist())\n  actions_to_workshop.append(4)  # USE to craft the item\n\n  return actions_to_collect_primitives + actions_to_workshop", "island_id": 2, "scores": {"": -1}}
{"timestamp": "2025-09-03T01:36:46.122847", "function_name": "craft", "function_body": "  def move_towards(state, target_pos):\n    current_x, current_y = state.pos\n    target_x, target_y = target_pos\n\n    moves = []\n    # Calculate moves in x-direction\n    if current_x < target_x:\n        moves.extend([craft.MOVE_FUNC(craft.RIGHT)] * (target_x - current_x))\n    elif current_x > target_x:\n        moves.extend([craft.MOVE_FUNC(craft.LEFT)] * (current_x - target_x))\n\n    # Calculate moves in y-direction\n    if current_y < target_y:\n        moves.extend([craft.MOVE_FUNC(craft.DOWN)] * (target_y - current_y))\n    elif current_y > target_y:\n        moves.extend([craft.MOVE_FUNC(craft.UP)] * (current_y - target_y))\n    \n    return moves\n\n  goal_index = env.world.cookbook.index[item]\n  actions = []\n\n  if goal_index in env.world.workshop_indices:\n    # Find all workshops that can produce the item\n    workshop_indices = [idx for idx, recipe in env.world.cookbook.recipes.items() \n                        if \"_key\" in recipe and recipe[\"_key\"] == goal_index]\n    \n    if workshop_indices:\n        chosen_workshop_index = workshop_indices[0]\n\n        # Find positions of the chosen workshop in the grid\n        workshop_positions = np.argwhere(env._current_state.grid[:, :, chosen_workshop_index]).tolist()\n\n        if workshop_positions:\n            nearest_workshop_position = min(workshop_positions, \n                                           key=lambda pos: np.linalg.norm(np.array(pos) - np.array(env._current_state.pos)))\n            \n            # Move to the nearest workshop position\n            target_pos = nearest_workshop_position\n\n            actions.extend(move_towards(env._current_state, (target_x, target_y)))\n\n            # Use the workshop to craft the item\n            actions.append(craft.USE)\n\n  return actions", "island_id": 5, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T01:36:47.221696", "function_name": "craft", "function_body": "  def move_towards(state, target_pos):\n    current_x, current_y = state.pos\n    target_x, target_y = target_pos\n\n    moves = []\n    # Calculate moves in x-direction\n    if current_x < target_x:\n        moves.extend([craft.MOVE_FUNC(craft.RIGHT)] * (target_x - current_x))\n    elif current_x > target_x:\n        moves.extend([craft.MOVE_FUNC(craft.LEFT)] * (current_x - target_x))\n\n    # Calculate moves in y-direction\n    if current_y < target_y:\n        moves.extend([craft.MOVE_FUNC(craft.DOWN)] * (target_y - current_y))\n    elif current_y > target_y:\n        moves.extend([craft.MOVE_FUNC(craft.UP)] * (current_y - target_y))\n    \n    return moves\n\n  goal_index = env.world.cookbook.index[item]\n  actions = []\n\n  if goal_index in env.world.workshop_indices:\n    # Find all workshops that can produce the item\n    workshop_indices = [idx for idx, recipe in env.world.cookbook.recipes.items() \n                        if \"_key\" in recipe and recipe[\"_key\"] == goal_index]\n\n    if not workshop_indices:\n        return actions  # No workshop found to craft the item\n\n    chosen_workshop_index = workshop_indices[0]\n\n    # Find positions of the chosen workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, chosen_workshop_index]).tolist()\n\n    if not workshop_positions:\n        return actions  # No positions found for the chosen workshop\n\n    nearest_workshop_position = min(workshop_positions, \n                                     key=lambda pos: np.linalg.norm(np.array(pos) - np.array(env._current_state.pos)))\n\n    target_pos = nearest_workshop_position\n    actions.extend(move_towards(env._current_state, target_pos))\n\n    # Use the workshop to craft the item\n    actions.append(craft.CRAFT_FUNC(goal_index))\n  \n  return actions", "island_id": 5, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T01:38:04.456698", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n\n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      # Move horizontally first\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      \n      # Then move vertically\n      if dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n\n      current_pos = (current_pos[0] + (dx // abs(dx)) if dx != 0 else current_pos[0],\n                     current_pos[1] + (dy // abs(dy)) if dy != 0 else current_pos[1])\n      \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  # This step assumes that the recipe specifies the workshop type needed.\n  # Since the problem does not specify how to determine the workshop,\n  # we will assume that all workshops can craft any items for simplicity.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 7, "scores": {"": 4.7}}
{"timestamp": "2025-09-03T01:38:05.521434", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    # Calculate the direction to move\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n    \n    # Move horizontally first\n    if dx > 0:\n        actions.extend([3] * abs(dx))  # RIGHT\n    elif dx < 0:\n        actions.extend([2] * abs(dx))  # LEFT\n    \n    # Then move vertically\n    if dy > 0:\n        actions.extend([1] * abs(dy))  # UP\n    elif dy < 0:\n        actions.extend([0] * abs(dy))  # DOWN\n    \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  # This step assumes that the recipe specifies the workshop type needed.\n  # Since the problem does not specify how to determine the workshop,\n  # we will assume that all workshops can craft any items for simplicity.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 7, "scores": {"": 4.7}}
{"timestamp": "2025-09-03T01:39:48.897302", "function_name": "craft", "function_body": "  def get_workshop_for_item(item_index):\n    for workshop, recipes in env.world.cookbook.recipes.items():\n        if '_key' in recipes and item_index == recipes['_key']:\n            return workshop\n    return None\n\n  def find_nearest_workshop(env, workshop_index):\n      \"\"\"Find the nearest workshop of a given type using A*.\"\"\"\n      world = env.world\n      grid = env._current_state.grid\n      pos = env._current_state.pos\n      \n      # Define heuristic function for A*\n      def heuristic(a, b):\n          return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n      open_set = collections.PriorityQueue()\n      open_set.put((0, pos))\n      came_from = {}\n      cost_so_far = {}\n      came_from[pos] = None\n      cost_so_far[pos] = 0\n\n      while not open_set.empty():\n          _, current = open_set.get()\n\n          # Check if the current cell is a workshop of the required type\n          if world.workshop_indices[workshop_index - len(world.primitives)] == np.argmax(grid[current]):\n              return reconstruct_path(came_from, pos, current)\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              new_cost = cost_so_far[current] + heuristic(current, neighbor)\n\n              if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n                  if neighbor not in cost_so_far or new_cost < cost_so_far[neighbor]:\n                      cost_so_far[neighbor] = new_cost\n                      priority = new_cost + heuristic(neighbor, current)\n                      open_set.put((priority, neighbor))\n                      came_from[neighbor] = current\n\n      return None\n\n  def reconstruct_path(came_from, start, goal):\n      \"\"\"Reconstruct the path from the start to the goal.\"\"\"\n      current = goal\n      path = []\n      while current != start:\n          path.append(current)\n          current = came_from[current]\n      path.reverse()\n      return path\n\n  def navigate_to(env, target_location):\n      \"\"\"Navigate to a target location on the grid.\"\"\"\n      world = env.world\n      actions = []\n      \n      for i in range(1, len(target_location)):\n          dx = target_location[i][0] - target_location[i-1][0]\n          dy = target_location[i][1] - target_location[i-1][1]\n          \n          if (dx, dy) == (-1, 0):  # UP\n              actions.append(env.action_specs()['UP'])\n          elif (dx, dy) == (1, 0):  # DOWN\n              actions.append(env.action_specs()['DOWN'])\n          elif (dx, dy) == (0, -1):  # LEFT\n              actions.append(env.action_specs()['LEFT'])\n          elif (dx, dy) == (0, 1):  # RIGHT\n              actions.append(env.action_specs()['RIGHT'])\n\n      return actions\n\n  def craft_item(env):\n    \"\"\"Use the workshop to craft the item.\"\"\"\n    return [env.action_specs()['USE']]\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Find the workshop that allows crafting this item (if any)\n  workshop_index = get_workshop_for_item(item_index)\n\n  actions = []\n\n  if workshop_index is not None:\n      # Get the location of the nearest workshop of the required type\n      nearest_workshop_location = find_nearest_workshop(env, workshop_index)\n      \n      if nearest_workshop_location is not None:\n          # Navigate to the workshop location\n          actions.extend(navigate_to(env, nearest_workshop_location))\n          \n          # Craft the item using the workshop\n          actions.extend(craft_item(env))\n  \n  return actions", "island_id": 9, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T01:39:49.881798", "function_name": "craft", "function_body": "  def get_workshop_for_item(item_index):\n    for workshop in env.world.workbook.recipes:\n      if '_key' in env.world.cookbook.recipes[workshop] and env.world.cookbook.recipes[workshop]['_key'] == item_index:\n        return workshop\n    return None\n\n  def find_nearest_workshop(env, workshop_index):\n    \"\"\"Find the nearest workshop of a given type using A*.\"\"\"\n    world = env.world\n    grid = env._current_state.grid\n    start_pos = env._current_state.pos\n    \n    # Define heuristic function for A*\n    def heuristic(a, b):\n        return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n    open_set = collections.PriorityQueue()\n    open_set.put((0, start_pos))\n    came_from = {}\n    cost_so_far = {}\n    came_from[start_pos] = None\n    cost_so_far[start_pos] = 0\n\n    while not open_set.empty():\n        _, current = open_set.get()\n\n        # Check if the current cell is a workshop of the required type\n        for workshop in world.workshop_indices:\n            if np.argmax(grid[current]) == workshop and workshop == workshop_index:\n                return reconstruct_path(came_from, start_pos, current)\n\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            neighbor = (current[0] + dx, current[1] + dy)\n            new_cost = cost_so_far[current] + heuristic(current, neighbor)\n\n            if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n                if neighbor not in cost_so_far or new_cost < cost_so_far[neighbor]:\n                    cost_so_far[neighbor] = new_cost\n                    priority = new_cost + heuristic(neighbor, current)\n                    open_set.put((priority, neighbor))\n                    came_from[neighbor] = current\n\n    return None\n\n  def reconstruct_path(came_from, start, goal):\n      \"\"\"Reconstruct the path from the start to the goal.\"\"\"\n      current = goal\n      path = []\n      while current != start:\n          path.append(current)\n          current = came_from[current]\n      path.reverse()\n      return path\n\n  def navigate_to(env, target_location):\n      \"\"\"Navigate to a target location on the grid.\"\"\"\n      world = env.world\n      actions = []\n      \n      for i in range(1, len(target_location)):\n          dx = target_location[i][0] - target_location[i-1][0]\n          dy = target_location[i][1] - target_location[i-1][1]\n          \n          if (dx, dy) == (-1, 0):  # UP\n              actions.append(env.action_specs()['UP'])\n          elif (dx, dy) == (1, 0):  # DOWN\n              actions.append(env.action_specs()['DOWN'])\n          elif (dx, dy) == (0, -1):  # LEFT\n              actions.append(env.action_specs()['LEFT'])\n          elif (dx, dy) == (0, 1):  # RIGHT\n              actions.append(env.action_specs()['RIGHT'])\n\n      return actions\n\n  def craft_item(env):\n    \"\"\"Use the workshop to craft the item.\"\"\"\n    return [env.action_specs()['USE']]\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Find the workshop that allows crafting this item (if any)\n  workshop_index = get_workshop_for_item(item_index)\n\n  actions = []\n\n  if workshop_index is not None:\n      # Get the location of the nearest workshop of the required type\n      nearest_workshop_location = find_nearest_workshop(env, workshop_index)\n      \n      if nearest_workshop_location is not None:\n          # Navigate to the workshop location\n          actions.extend(navigate_to(env, nearest_workshop_location))\n          \n          # Craft the item using the workshop\n          actions.extend(craft_item(env))\n  \n  return actions", "island_id": 9, "scores": {"": -1}}
{"timestamp": "2025-09-03T01:41:59.228082", "function_name": "craft", "function_body": "  def get_missing_ingredients(recipe):\n    required_ingredients = {k: v for k, v in recipe.items() if k != \"_key\"}\n    missing_ingredients = []\n    inventory_counts = env._current_state.inventory\n    for ingredient_index, count in required_ingredients.items():\n      if inventory_counts[ingredient_index] < count:\n        missing_ingredients.append((ingredient_index, count - inventory_counts[ingredient_index]))\n    return missing_ingredients\n\n  def move_to(env, target_pos):\n    \"\"\"Generate actions to move the agent to a target position using pathfinding logic.\"\"\"\n    def find_path(grid, start, end):\n      from collections import deque\n      directions = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n      queue = deque([start])\n      came_from = {start: None}\n      \n      while queue:\n        current = queue.popleft()\n        if current == end:\n          break\n        for direction in directions:\n          neighbor = tuple(np.add(current, direction))\n          if (0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1] and \n              np.all(grid[neighbor] == 0)):\n            queue.append(neighbor)\n            came_from[neighbor] = current\n      \n      path = []\n      while end:\n        path.append(end)\n        end = came_from[end]\n      \n      return path[::-1]\n\n    path = find_path(env._current_state.grid, env._current_state.pos, target_pos)\n    \n    actions = []\n    current_pos = env._current_state.pos\n    \n    for next_pos in path[1:]:\n      direction = tuple(np.subtract(next_pos, current_pos))\n      \n      if direction == (0, 1):\n        actions.append(env.world.cookbook.index[\"RIGHT\"])\n      elif direction == (0, -1):\n        actions.append(env.world.cookbook.index[\"LEFT\"])\n      elif direction == (1, 0):\n        actions.append(env.world.cookbook.index[\"DOWN\"])\n      elif direction == (-1, 0):\n        actions.append(env.world.cookbook.index[\"UP\"])\n      \n      current_pos = next_pos\n    \n    return actions\n\n  def collect_missing_ingredients(env, missing_ingredients) -> list[int]:\n    \"\"\"Generate actions to collect all required ingredients.\"\"\"\n    actions = []\n    for ingredient_index, count in missing_ingredients:\n      ingredient_name = env.world.cookbook.index.get(ingredient_index, \"unknown\")\n      # Collect the ingredient 'count' times\n      for _ in range(count):\n        actions.extend(collect(env, ingredient_name))\n    return actions\n\n  def collect(env, primitive) -> list[int]:\n    \"\"\"Generate actions to collect a specific primitive.\"\"\"\n    item_index = env.world.cookbook.index[primitive]\n    \n    # Find all positions of the required primitive on the grid\n    positions = np.argwhere(env._current_state.grid[:, :, item_index] > 0)\n    \n    if positions.size == 0:\n      return []\n    \n    agent_pos = env._current_state.pos\n    \n    # Calculate distances to each position and sort by distance\n    distances = np.sum(np.abs(positions - agent_pos), axis=1)\n    sorted_positions = positions[np.argsort(distances)]\n    \n    actions = []\n    \n    for pos in sorted_positions:\n      actions.extend(move_to(env, tuple(pos)))\n      \n      # Add the collect action (which is assumed to be the index of \"COLLECT\" in the cookbook)\n      collect_action_index = env.world.cookbook.index[\"COLLECT\"]\n      actions.append(collect_action_index)\n    \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n  \n  recipes = {k: v for k, v in env.world.cookbook.recipes.items() if \"_key\" in v and v[\"_key\"] == item_index}\n  \n  if not recipes:\n    return []\n\n  recipe = next(iter(recipes.values()))\n  missing_ingredients = get_missing_ingredients(recipe)\n\n  # Determine which workshop type is needed based on the ingredients\n  workshop_needed = None\n  for ingredient_index in recipe.keys():\n      kind_name = env.world.cookbook.index.get(ingredient_index, \"unknown\")\n      if kind_name.startswith(\"WORKSHOP\"):\n          workshop_needed = ingredient_index\n          break\n\n  if workshop_needed is None:\n      workshop_needed = env.world.workshop_indices[0]\n\n  workshops = np.argwhere(env._current_state.grid[:, :, workshop_needed] > 0)\n  \n  if workshops.size == 0:\n      return []\n\n  agent_pos = env._current_state.pos\n  distances = np.sum(np.abs(workshops - agent_pos), axis=1)\n  nearest_workshop = tuple(workshops[np.argmin(distances)])\n\n  actions_to_workshop = move_to(env, nearest_workshop)\n\n  use_action_index = env.world.cookbook.index[\"USE\"]\n\n  actions_to_collect = collect_missing_ingredients(env, missing_ingredients)\n\n  return actions_to_collect + actions_to_workshop + [use_action_index]", "island_id": 4, "scores": {"": 0.0}}
