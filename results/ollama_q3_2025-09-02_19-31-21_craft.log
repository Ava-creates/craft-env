{"timestamp": "2025-09-02T19:35:35.998013", "function_name": "craft", "function_body": "  actions = []\n\n  # Get the index of the item from the cookbook's index\n  i_item = env.world.cookbook.index[item]\n\n  # Find a workshop that can be used to craft this item\n  workshops_needed = [key for key, value in env.world.cookbook.recipes.items() if \"_key\" in value and value[\"_key\"] == i_item]\n  \n  if not workshops_needed:\n    raise ValueError(f\"No workshop available to craft {item}\")\n\n  # Get the index of any one of the needed workshops\n  i_workshop = workshops_needed[0]\n\n  # Find all positions of the workshop on the grid\n  pos = np.argwhere(env._current_state.grid[:, :, i_workshop] > 0)\n\n  if not len(pos):\n    raise ValueError(f\"No available {item} workshop found on the grid\")\n\n  # Choose a random position from the list of workshops\n  chosen_pos = pos[env.world.random.randint(len(pos))]\n\n  # Calculate the direction to move towards the chosen workshop\n  current_dir = env._current_state.dir\n  current_pos = np.array(env._current_state.pos)\n\n  while not np.array_equal(current_pos, chosen_pos):\n      # Calculate the relative position of the workshop\n      rel_pos = chosen_pos - current_pos\n\n      # Determine direction to move\n      if rel_pos[1] > 0:\n          actions.append(env.action_specs()[RIGHT])\n          current_dir = RIGHT\n      elif rel_pos[1] < 0:\n          actions.append(env.action_specs()[LEFT])\n          current_dir = LEFT\n      else:\n          if rel_pos[0] > 0 and current_dir != DOWN:\n              actions.append(env.action_specs()[DOWN])\n              current_dir = DOWN\n          elif rel_pos[0] < 0 and current_dir != UP:\n              actions.append(env.action_specs()[UP])\n              current_dir = UP\n\n      # Update position based on action\n      if current_dir == RIGHT:\n          current_pos[1] += 1\n      elif current_dir == LEFT:\n          current_pos[1] -= 1\n      elif current_dir == DOWN:\n          current_pos[0] += 1\n      elif current_dir == UP:\n          current_pos[0] -= 1\n\n  # Turn towards the workshop if necessary (not currently in front)\n  actions.append(env.action_specs()[USE])\n\n  return actions", "island_id": 4, "scores": {"": -1}}
{"timestamp": "2025-09-02T19:35:36.964900", "function_name": "craft", "function_body": "  # Get the index for the desired item\n  item_idx = env.world.cookbook.index[item]\n\n  # Determine the workshop needed to craft the item (this is a simplified assumption)\n  # In reality, you would need to map items to their respective workshops.\n  # For now, let's assume all items can be crafted in any workshop.\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  \n  # Move to the first workshop available\n  workshop_idx = workshop_indices[0]\n  pos = (env._current_state.grid.shape[0] // 2, env._current_state.grid.shape[1] // 2)  # Assume starting position in the middle of the grid\n\n  # Find a path to the workshop\n  actions.extend(find_path(env._current_state.grid, pos, workshop_idx))\n\n  # Add action to use the workshop to craft the item\n  actions.append(env.world.n_actions - 1)  # Assuming the USE action is the last one in the n_actions list\n\n  return actions", "island_id": 4, "scores": {"": -1}}
