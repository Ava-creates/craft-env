 workshop on the grid\n  workshop_pos = None\n  for y in range(env._current_state.grid.shape[0]):\n    for x in range(env._current_state.grid.shape[1]):\n      if env._current_state.grid[y, x, workshop_required_for_item] > 0:\n        workshop_pos = (x, y)\n        break\n    if workshop_pos is not None:\n        break\n\n  # If no workshop is found on the grid, return an empty list\n  if workshop_pos is None:\n    return []\n\n  # Find the path to the workshop\n  path_to_workshop = a_star_search(current_pos, workshop_pos)\n\n  action_map = {(-1, 0): env.N_ACTIONS - 4, (1, 0): env.N_ACTIONS - 3, (0, -1): env.N_ACTIONS - 2, (0, 1): env.N_ACTIONS - 1}\n  actions_to_workshop = []\n  for i in range(1, len(path_to_workshop)):\n      dx = path_to_workshop[i][0] - path_to_workshop[i-1][0]\n      dy = path_to_workshop[i][1] - path_to_workshop[i-1][1]\n      if (dx, dy) in action_map:\n          actions_to_workshop.append(action_map[(dx, dy)])\n\n  # Add the USE action to craft the item\n  actions_to_workshop.append(env.N_ACTIONS - 5)\n\n  return actions_to_workshop", "island_id": 9, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T00:03:15.901083", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n\n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      # Move horizontally first\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      \n      # Then move vertically\n      if dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n\n      current_pos = (current_pos[0] + (dx // abs(dx)) if dx != 0 else current_pos[0],\n                     current_pos[1] + (dy // abs(dy)) if dy != 0 else current_pos[1])\n      \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  # This step assumes that the recipe specifies the workshop type needed.\n  # Since the problem does not specify how to determine the workshop,\n  # we will assume that all workshops can craft any items for simplicity.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 7, "scores": {"": 4.7}}
{"timestamp": "2025-09-03T00:03:16.983627", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n\n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      # Move horizontally first\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      \n      # Then move vertically\n      if dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n\n      current_pos = (current_pos[0] + (dx // abs(dx)) if dx != 0 else current_pos[0],\n                     current_pos[1] + (dy // abs(dy)) if dy != 0 else current_pos[1])\n      \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  # This step assumes that the recipe specifies the workshop type needed.\n  # Since the problem does not specify how to determine the workshop,\n  # we will assume that all workshops can craft any items for simplicity.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 7, "scores": {"": 4.7}}
{"timestamp": "2025-09-03T00:04:38.570622", "function_name": "craft", "function_body": "  def get_workshop_for_item(item_index):\n    for workshop, recipes in env.world.cookbook.recipes.items():\n        if '_key' in recipes and item_index == recipes['_key']:\n            return workshop\n    return None\n\n  def find_nearest_workshop(env, workshop_index):\n      \"\"\"Finds the nearest location of a given workshop type.\"\"\"\n      grid = env._current_state.grid\n      height, width, _ = grid.shape\n      \n      # Collect all positions where the specified workshop is located\n      workshop_locations = [(x, y) for x in range(width) for y in range(height) if grid[y, x, workshop_index] > 0]\n      \n      if not workshop_locations:\n          return None\n      \n      agent_pos = env._current_state.pos\n      \n      # Calculate Manhattan distances to all workshop locations\n      nearest_location = min(workshop_locations, key=lambda loc: abs(loc[0] - agent_pos[0]) + abs(loc[1] - agent_pos[1]))\n      \n      return nearest_location\n\n  def navigate_to(env, target_pos):\n      \"\"\"Navigates the agent to a target position.\"\"\"\n      actions = []\n      agent_pos = env._current_state.pos\n      target_x, target_y = target_pos\n      \n      # Calculate directions needed to move\n      dx = target_x - agent_pos[0]\n      dy = target_y - agent_pos[1]\n      \n      # Determine the direction based on the difference in coordinates\n      if dx > 0:\n          actions.extend([env.action_specs()['RIGHT']] * abs(dx))\n      elif dx < 0:\n          actions.extend([env.action_specs()['LEFT']] * abs(dx))\n      \n      if dy > 0:\n          actions.extend([env.action_specs()['DOWN']] * abs(dy))\n      elif dy < 0:\n          actions.extend([env.action_specs()['UP']] * abs(dy))\n      \n      return actions\n\n  def craft_item(env):\n    \"\"\"Use the workshop to craft the item.\"\"\"\n    return [env.action_specs()['USE']]\n\n  # Find the index of the item in the cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the workshop that allows crafting this item (if any)\n  workshop_index = get_workshop_for_item(item_index)\n\n  actions = []\n\n  if workshop_index is not None:\n      # Get the location of the nearest workshop of the required type\n      nearest_workshop_location = find_nearest_workshop(env, workshop_index)\n      \n      if nearest_workshop_location is not None:\n          # Navigate to the workshop location\n          actions.extend(navigate_to(env, nearest_workshop_location))\n          \n          # Craft the item using the workshop\n          actions.extend(craft_item(env))\n  else:\n      # No specific workshop needed, likely a primitive item that can be crafted anywhere (e.g., STICK from WOOD)\n      actions.append(env.action_specs()['USE'])\n\n  return actions", "island_id": 9, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T00:04:39.612431", "function_name": "craft", "function_body": "  def get_workshop_for_item(item_index):\n    for workshop, recipes in env.world.cookbook.recipes.items():\n        if '_key' in recipes and item_index == recipes['_key']:\n            return workshop\n    return None\n\n  def find_nearest_workshop(env, workshop_index):\n      \"\"\"Finds the nearest location of a given workshop type.\"\"\"\n      grid = env._current_state.grid\n      height, width, _ = grid.shape\n      \n      # Collect all positions where the specified workshop is located\n      workshop_locations = [(x, y) for x in range(width) for y in range(height) if grid[y, x, workshop_index] > 0]\n      \n      if not workshop_locations:\n          return None\n      \n      agent_pos = env._current_state.pos\n      \n      # Calculate Manhattan distances to all workshop locations\n      nearest_location = min(workshop_locations, key=lambda loc: abs(loc[0] - agent_pos[0]) + abs(loc[1] - agent_pos[1]))\n      \n      return nearest_location\n\n  def navigate_to(env, target_pos):\n    \"\"\"Navigates the agent to a target position.\"\"\"\n    actions = []\n    agent_pos = env._current_state.pos\n    current_x, current_y = agent_pos\n    target_x, target_y = target_pos\n    \n    # Move horizontally first\n    if target_x > current_x:\n        actions.extend([env.action_specs()['RIGHT']] * (target_x - current_x))\n    elif target_x < current_x:\n        actions.extend([env.action_specs()['LEFT']] * (current_x - target_x))\n    \n    # Then move vertically\n    if target_y > current_y:\n        actions.extend([env.action_specs()['DOWN']] * (target_y - current_y))\n    elif target_y < current_y:\n        actions.extend([env.action_specs()['UP']] * (current_y - target_y))\n    \n    return actions\n\n  def use_workshop(env):\n      \"\"\"Use the workshop to craft the item.\"\"\"\n      return [env.action_specs()['USE']]\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Find the workshop that allows crafting this item (if any)\n  workshop_index = get_workshop_for_item(item_index)\n\n  actions = []\n\n  if workshop_index is not None:\n      # Get the location of the nearest workshop of the required type\n      nearest_workshop_location = find_nearest_workshop(env, workshop_index)\n      \n      if nearest_workshop_location is not None:\n          # Navigate to the workshop location\n          actions.extend(navigate_to(env, nearest_workshop_location))\n          \n          # Craft the item using the workshop\n          actions.extend(use_workshop(env))\n\n  else:\n      # No specific workshop needed, likely a primitive item that can be crafted anywhere (e.g., STICK from WOOD)\n      actions.append(env.action_specs()['USE'])\n\n  return actions", "island_id": 9, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T00:05:32.792059", "function_name": "craft", "function_body": "  # Check if the goal item is in the inventory\n  if env._current_state.inventory[env.world.cookbook.index[item]] > 0:\n    print(f\"Item {item} already in inventory.\")\n    return []\n\n  # Get the workshop index needed for crafting the item (this should be improved)\n  workshop_idx = None\n  for idx, recipe in env.world.cookbook.recipes.items():\n      if \"_key\" not in recipe and env.world.cookbook.index[item] == idx:\n          workshop_idx = env.world.workshop_indices[0]\n          break\n\n  # Ensure we have a valid workshop index\n  if workshop_idx is None:\n    raise ValueError(f\"No workshop found for crafting {item}.\")\n\n  # Find the position of the nearest workshop in the grid\n  min_distance = float('inf')\n  target_pos = None\n  for x in range(env._current_state.grid.shape[0]):\n      for y in range(env._current_state.grid.shape[1]):\n          if env._current_state.grid[x, y, workshop_idx] > 0:\n              distance = abs(x - env._current_state.pos[0]) + abs(y - env._current_state.pos[1])\n              if distance < min_distance:\n                  min_distance = distance\n                  target_pos = (x, y)\n\n  # Ensure we have a valid target position\n  if target_pos is None:\n    raise ValueError(f\"No workshop found in the grid for crafting {item}.\")\n\n  # Move to the nearest workshop\n  actions_to_move = []\n  current_pos = env._current_state.pos\n  while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if dx > 0:\n          actions_to_move.append(env.world.N_ACTIONS.DOWN)\n      elif dx < 0:\n          actions_to_move.append(env.world.N_ACTIONS.UP)\n\n      if dy > 0:\n          actions_to_move.append(env.world.N_ACTIONS.RIGHT)\n      elif dy < 0:\n          actions_to_move.append(env.world.N_ACTIONS.LEFT)\n\n      current_pos = (current_pos[0] + dx, current_pos[1] + dy)\n\n  # Add the USE action to craft the item\n  actions_to_move.append(env.world.N_ACTIONS.USE)\n\n  return actions_to_move", "island_id": 5, "scores": {"": -1}}
{"timestamp": "2025-09-03T00:05:33.757354", "function_name": "craft", "function_body": "  actions = []\n  # Get the index of the item we want to craft\n  item_idx = env.world.cookbook.index[item]\n\n  # Find out which workshops can be used to craft this item\n  workshop_indices = [\n      w for w in env.world.workshop_indices if item_idx in env.world.cookbook.recipes[w]\n  ]\n\n  # Check if there are any suitable workshops\n  if not workshop_indices:\n    raise ValueError(f\"No available workshop found for crafting {item}\")\n\n  # Select the first available workshop (could be improved to select the closest one)\n  target_workshop_index = workshop_indices[0]\n\n  # Get the current position of the agent and the position of the selected workshop\n  current_pos = env._current_state.pos\n  target_pos = np.where(env._current_state.grid[target_workshop_index, :, :] == 1)\n\n  if not target_pos[0].size:\n    raise ValueError(f\"Workshop {item} not found in the grid\")\n\n  # Calculate the direction to move towards the workshop\n  target_x, target_y = target_pos[0][0], target_pos[1][0]\n  current_x, current_y = current_pos\n\n  # Move agent towards the workshop (simple heuristic: move directly towards it)\n  while not (current_x == target_x and current_y == target_y):\n    if current_x < target_x:\n      actions.append(env.world.N_ACTIONS.DOWN)  # or UP depending on grid orientation\n      current_x += 1\n    elif current_x > target_x:\n      actions.append(env.world.N_ACTIONS.UP)\n      current_x -= 1\n    elif current_y < target_y:\n      actions.append(env.world.N_ACTIONS.RIGHT)\n      current_y += 1\n    elif current_y > target_y:\n      actions.append(env.world.N_ACTIONS.LEFT)\n      current_y -= 1\n\n  # Once at the workshop, use the USE action to craft the item\n  actions.append(env.world.N_ACTIONS.USE)\n\n  return actions", "island_id": 5, "scores": {"": -1}}
{"timestamp": "2025-09-03T00:06:29.256608", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if any(grid[i, j, w] > 0 for w in workshop_indices):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n\n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if abs(dx) >= abs(dy):\n        if dx > 0:\n          actions.append(3)  # RIGHT\n        elif dx < 0:\n          actions.append(2)  # LEFT\n      else:\n        if dy > 0:\n          actions.append(1)  # UP\n        elif dy < 0:\n          actions.append(0)  # DOWN\n\n      current_pos = (current_pos[0] + np.sign(dx), current_pos[1] + np.sign(dy))\n\n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 6, "scores": {"": 0.7}}
{"timestamp": "2025-09-03T00:11:29.675039", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Iterate over all positions to find the closest workshop\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n\n    # Calculate differences\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    while current_pos != target_pos:\n      if abs(dx) > abs(dy):\n        if dx > 0:\n          actions.append(3)  # RIGHT\n        else:\n          actions.append(2)  # LEFT\n        dx -= (dx // abs(dx)) if dx != 0 else 0\n      else:\n        if dy > 0:\n          actions.append(1)  # UP\n        else:\n          actions.append(0)  # DOWN\n        dy -= (dy // abs(dy)) if dy != 0 else 0\n\n      current_pos = (current_pos[0] + (dx // abs(dx)) if dx != 0 else current_pos[0],\n                     current_pos[1] + (dy // abs(dy)) if dy != 0 else current_pos[1])\n      \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 6, "scores": {"": -1}}
{"timestamp": "2025-09-03T00:12:22.171724", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index of the desired item from the cookbook's index\n  item_idx = env.world.cookbook.index[item]\n  \n  # Check if the goal is a primitive resource (cannot be crafted)\n  if item_idx in env.world.cookbook.primitives:\n    raise ValueError(\"Cannot craft primitives directly.\")\n  \n  # Get the workshop index for the desired item\n  recipe = env.world.cookbook.recipes.get(item_idx)\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}.\")\n  \n  # Determine which workshop to go to based on the recipe (assuming \"_key\" indicates the type of workshop needed)\n  workshop_type = recipe.get(\"_key\")\n  if workshop_type is None:\n    raise ValueError(\"Recipe does not specify a workshop type.\")\n  \n  # Find the index of the workshop in the world's workshop_indices\n  workshop_idx = next((i for i, w in enumerate(env.world.workshop_indices) if env.world.cookbook.index.get(w) == workshop_type), None)\n  if workshop_idx is None:\n    raise ValueError(f\"No suitable workshop found for {item}.\")\n  \n  # Calculate the position of the workshop (this is a placeholder; actual position needs to be determined based on grid layout)\n  # For simplicity, let's assume the workshop is at a fixed position in the grid\n  workshop_pos = (10, 10)  # Placeholder position\n  \n  # Add actions to move towards the workshop\n  current_pos = env._current_state.pos\n  actions.extend(move_to_position(current_pos, workshop_pos))\n  \n  # Add action to use the workshop\n  actions.append(env.world.N_ACTIONS - 1)  # Assuming USE is the last action (index N_ACTIONS - 1)\n  \n  return actions", "island_id": 1, "scores": {"": -1}}
{"timestamp": "2025-09-03T00:12:23.156161", "function_name": "craft", "function_body": "  actions = []\n\n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have a recipe for this item\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"No crafting recipe found for {item}\")\n\n  # Determine which workshop to use based on the recipe (assuming first ingredient's location)\n  recipe = env.world.cookbook.recipes[item_index]\n  ingredients = list(recipe.keys())\n  \n  if \"_key\" in ingredients:\n    ingredients.remove(\"_key\")\n    \n  ingredient_indices = [env.world.cookbook.index.get(ingredient, None) for ingredient in ingredients]\n  \n  # Assuming the first ingredient determines which workshop to use\n  primary_ingredient_index = ingredient_indices[0]\n\n  # Determine the workshop index based on the primary ingredient\n  if primary_ingredient_index in env.world.workshop_indices:\n    workshop_index = primary_ingredient_index\n  else:\n    raise ValueError(f\"Cannot determine workshop for crafting {item}\")\n\n  # Find the position of the workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"Workshop not found on the grid\")\n\n  # Choose the closest workshop (assuming the first one is the closest)\n  target_workshop_pos = tuple(workshop_positions[0])\n\n  # Get current position and direction\n  current_pos = env._current_state.pos\n  current_dir = env._current_state.dir\n\n  # Calculate actions to move to the workshop\n  actions.extend(move_to(env, target_workshop_pos))\n\n  # Align the agent's direction with the workshop\n  aligned_actions = align_with(env, target_workshop_pos)\n  if aligned_actions is not None:\n    actions.extend(aligned_actions)\n\n  # Use the USE action at the workshop to craft the item\n  actions.append(4)  # Assuming 4 is the index for the USE action\n\n  return actions", "island_id": 1, "scores": {"": -1}}
{"timestamp": "2025-09-03T00:13:42.650026", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    # Simple pathfinding logic: moves towards the target position using A* or similar\n    current_pos = env._current_state.pos\n    actions = []\n\n    while current_pos != target_pos:\n      # Calculate direction to move\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if abs(dx) > abs(dy):\n        if dx > 0:\n          actions.append(3)  # RIGHT\n        else:\n          actions.append(2)  # LEFT\n      else:\n        if dy > 0:\n          actions.append(1)  # UP\n        else:\n          actions.append(0)  # DOWN\n\n      current_pos = (current_pos[0] + (dx // abs(dx)) if dx != 0 else current_pos[0],\n                     current_pos[1] + (dy // abs(dy)) if dy != 0 else current_pos[1])\n      \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  # This step assumes that the recipe specifies the workshop type needed.\n  # Since the problem does not specify how to determine the workshop,\n  # we will assume that all workshops can craft any items for simplicity.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 6, "scores": {"": 0.90000004}}
{"timestamp": "2025-09-03T00:13:43.704376", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    # Simple pathfinding logic: moves towards the target position using A* or similar\n    current_pos = env._current_state.pos\n    actions = []\n\n    while current_pos != target_pos:\n      # Calculate direction to move\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if abs(dx) > abs(dy):\n        if dx > 0:\n          actions.append(3)  # RIGHT\n        else:\n          actions.append(2)  # LEFT\n      else:\n        if dy > 0:\n          actions.append(1)  # UP\n        else:\n          actions.append(0)  # DOWN\n\n      current_pos = (current_pos[0] + (dx // abs(dx)) if dx != 0 else current_pos[0],\n                     current_pos[1] + (dy // abs(dy)) if dy != 0 else current_pos[1])\n      \n    return actions\n\n  def move_and_use(env, target_pos):\n      # Move to the target position\n      actions = move_to(env, target_pos)\n      # Use action at the target position\n      actions.append(env.world.n_actions - 1)  # Assuming USE is the last action index\n      return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  # This step assumes that the recipe specifies the workshop type needed.\n  # Since the problem does not specify how to determine the workshop,\n  # we will assume that all workshops can craft any items for simplicity.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop and use it to craft the item\n  actions_to_workshop_and_use = move_and_use(env, closest_workshop_pos)\n  \n  return actions_to_workshop_and_use", "island_id": 6, "scores": {"": 0.90000004}}
{"timestamp": "2025-09-03T00:14:55.799439", "function_name": "craft", "function_body": "  def find_nearest_workshop(state, workshop_indices):\n    min_distance = float('inf')\n    nearest_workshop_pos = None\n    \n    for workshop_idx in workshop_indices:\n      target_pos = find_position_of_kind(env, workshop_idx)\n      distance = np.linalg.norm(np.array(target_pos) - np.array(state.pos))\n      \n      if distance < min_distance:\n        min_distance = distance\n        nearest_workshop_pos = target_pos\n    \n    return nearest_workshop_pos\n\n  def move_to_position(current_pos, target_pos):\n    # Convert positions to grid coordinates (x, y)\n    current_x, current_y = current_pos\n    target_x, target_y = target_pos\n    \n    actions = []\n    \n    if current_y > target_y:\n      while current_y > target_y:\n        actions.append(craft.UP)\n        current_y -= 1\n    elif current_y < target_y:\n      while current_y < target_y:\n        actions.append(craft.DOWN)\n        current_y += 1\n    \n    if current_x > target_x:\n      while current_x > target_x:\n        actions.append(craft.LEFT)\n        current_x -= 1\n    elif current_x < target_x:\n      while current_x < target_x:\n        actions.append(craft.RIGHT)\n        current_x += 1\n    \n    return actions\n\n  def find_position_of_kind(env, kind_index):\n    # Iterate over the grid to find a position of the given kind index\n    for y in range(env._current_state.grid.shape[0]):\n      for x in range(env._current_state.grid.shape[1]):\n        if env._current_state.grid[y, x, kind_index] > 0:\n          return (x, y)\n    \n    raise ValueError(f\"No position found for kind index {kind_index}\")\n\n  actions = []\n  current_state = env._current_state\n\n  # Get the index of the desired item from the cookbook index\n  item_index = env.world.cookbook.index[item]\n\n  # Find the workshop index for crafting the item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n  if \"_key\" in recipe:\n    key_workshop = recipe[\"_key\"]\n    workshop_indices = [env.world.workshop_indices[key_workshop]]\n    \n    # Check if we are already next to a workshop of the required kind\n    if not current_state.next_to(workshop_indices[0]):\n      target_pos = find_nearest_workshop(current_state, workshop_indices)\n      actions.extend(move_to_position(current_state.pos, target_pos))\n      \n    # Perform the USE action to craft the item\n    actions.append(craft.USE)\n\n  return actions", "island_id": 8, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T00:14:56.838676", "function_name": "craft", "function_body": "  def find_nearest_workshop(state, workshop_indices):\n      min_distance = float('inf')\n      nearest_workshop_pos = None\n      \n      for workshop_idx in workshop_indices:\n          target_pos = find_position_of_kind(env, workshop_idx)\n          distance = np.linalg.norm(np.array(target_pos) - np.array(state.pos))\n          \n          if distance < min_distance:\n              min_distance = distance\n              nearest_workshop_pos = target_pos\n      \n      return nearest_workshop_pos\n\n  def move_to_position(current_pos, target_pos):\n      # Convert positions to grid coordinates (x, y)\n      current_x, current_y = current_pos\n      target_x, target_y = target_pos\n      \n      actions = []\n      \n      # Calculate direction vectors and prioritize moving vertically first if needed\n      dy = target_y - current_y\n      dx = target_x - current_x\n      \n      # Move vertically first if there is a difference in y-coordinate\n      if dy != 0:\n          move_dir = craft.DOWN if dy > 0 else craft.UP\n          actions.extend([move_dir] * abs(dy))\n      \n      # Then move horizontally if there is a difference in x-coordinate\n      if dx != 0:\n          move_dir = craft.RIGHT if dx > 0 else craft.LEFT\n          actions.extend([move_dir] * abs(dx))\n      \n      return actions\n\n  def find_position_of_kind(env, kind_index):\n      # Iterate over the grid to find a position of the given kind index\n      for y in range(env._current_state.grid.shape[0]):\n          for x in range(env._current_state.grid.shape[1]):\n              if env._current_state.grid[y, x, kind_index] > 0:\n                  return (x, y)\n      \n      raise ValueError(f\"No position found for kind index {kind_index}\")\n\n  actions = []\n  current_state = env._current_state\n\n  # Get the index of the desired item from the cookbook index\n  item_index = env.world.cookbook.index[item]\n\n  # Find the workshop index for crafting the item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n  if \"_key\" in recipe:\n      key_workshop = recipe[\"_key\"]\n      workshop_index = env.world.workshop_indices[key_workshop]\n      \n      # Move to the nearest workshop of the required kind if not already next to one\n      if not current_state.next_to(workshop_index):\n          target_pos = find_nearest_workshop(current_state, [workshop_index])\n          actions.extend(move_to_position(current_state.pos, target_pos))\n          \n      # Perform the USE action to craft the item\n      actions.append(craft.USE)\n\n  return actions", "island_id": 8, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T00:15:54.231484", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Find which workshop can make this item\n  for workshop in env.world.workshop_indices:\n    if any(item_index == ingredient for ingredient, count in env.world.cookbook.recipes.get(workshop, {}).items()):\n      target_workshop = workshop\n      break\n\n  # Get the position of the target workshop (assuming we know where the workshops are)\n  grid = env._current_state.grid[:, :, target_workshop]\n  if not np.any(grid):\n    raise ValueError(\"Target workshop not found in the environment.\")\n\n  # Find a cell with value 1 in the grid, indicating the position of the workshop\n  pos = tuple(np.argwhere(grid == 1)[0])\n\n  # Calculate the relative direction to move towards the target workshop\n  current_pos = env._current_state.pos\n  dx, dy = pos[0] - current_pos[0], pos[1] - current_pos[1]\n\n  actions = []\n\n  # Move towards the target workshop\n  if dx < 0:\n      actions.extend([env.N_ACTIONS.DOWN] * abs(dx))\n  elif dx > 0:\n      actions.extend([env.N_ACTIONS.UP] * abs(dx))\n\n  if dy < 0:\n      actions.extend([env.N_ACTIONS.LEFT] * abs(dy))\n  elif dy > 0:\n      actions.extend([env.N_ACTIONS.RIGHT] * abs(dy))\n\n  # Use the USE action to craft the item at the target workshop\n  actions.append(env.N_ACTIONS.USE)\n\n  return actions", "island_id": 5, "scores": {"": -1}}
{"timestamp": "2025-09-03T00:15:55.212075", "function_name": "craft", "function_body": "  def _collect_primitives(primitive_indices):\n      actions = []\n      for primitive_index in primitive_indices:\n          # Find the position of the primitive on the grid\n          positions = np.argwhere(env._current_state.grid[:, :, primitive_index] > 0)\n          \n          if len(positions) == 0:\n              continue  # Skip if no primitives found\n\n          # Go to the nearest primitive\n          closest_primitive_pos = min(\n              positions, key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n          )\n          \n          actions.extend(move_to_position(env, closest_primitive_pos))\n          actions.append(craft.COLLECT_FUNC(primitive_index))  # Collect the primitive\n\n      return actions\n  \n  def move_to_position(state, target_pos):\n      \"\"\"Returns a list of actions to move from the current position to the target position.\"\"\"\n      x_diff = target_pos[0] - state.pos[0]\n      y_diff = target_pos[1] - state.pos[1]\n      actions = []\n\n      if y_diff < 0:\n          actions.extend([craft.UP for _ in range(-y_diff)])\n      elif y_diff > 0:\n          actions.extend([craft.DOWN for _ in range(y_diff)])\n\n      if x_diff < 0:\n          actions.extend([craft.LEFT for _ in range(-x_diff)])\n      elif x_diff > 0:\n          actions.extend([craft.RIGHT for _ in range(x_diff)])\n\n      return actions\n  \n  def find_workshop_for_item(item_index):\n      \"\"\"Finds a workshop where the item can be crafted.\"\"\"\n      recipes = env.world.cookbook.recipes\n      for recipe in recipes.values():\n          if recipe.get(\"_key\") == item_index:\n              # Assuming that \"_key\" is the output index of the recipe\n              for ingredient, _ in recipe.items():\n                  if ingredient in env.world.workshop_indices:\n                      return ingredient\n      return None  # Return None if no workshop found\n\n  def move_to_workshop(workshop_index):\n      \"\"\"Returns a list of actions to move from the current position to the workshop.\"\"\"\n      target_pos = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)[0]\n      return move_to_position(env._current_state, target_pos)\n\n  # Get the index of the item\n  item_index = env.world.cookbook.index[item]\n\n  # Find all primitive indices required to craft the item\n  primitive_indices = []\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  for primitive_index, count in primitives_needed.items():\n      primitive_indices.extend([primitive_index] * count)\n\n  # Collect all primitives required\n  actions = _collect_primitives(primitive_indices)\n\n  # Find and move to the appropriate workshop\n  workshop_index = find_workshop_for_item(item_index)\n  if workshop_index is not None:\n      actions.extend(move_to_workshop(workshop_index))\n      actions.append(craft.USE_FUNC)  # Use the workshop to craft the item\n\n  return actions", "island_id": 5, "scores": {"": -1}}
{"timestamp": "2025-09-03T00:16:51.030399", "function_name": "craft", "function_body": "  # Helper function to get the index of an item\n  def get_item_index(item_name):\n    return env.world.cookbook.index[item_name]\n\n  # Helper function to navigate to a specific position\n  def move_to_position(x, y):\n      current_x, current_y = env._current_state.pos\n      actions = []\n      while current_x < x:\n          actions.append(env.world.N_ACTIONS.DOWN)  # Assuming DOWN increases x\n          current_x += 1\n      while current_x > x:\n          actions.append(env.world.N_ACTIONS.UP)    # Assuming UP decreases x\n          current_x -= 1\n      while current_y < y:\n          actions.append(env.world.N_ACTIONS.RIGHT) # Assuming RIGHT increases y\n          current_y += 1\n      while current_y > y:\n          actions.append(env.world.N_ACTIONS.LEFT)  # Assuming LEFT decreases y\n          current_y -= 1\n      return actions\n\n  # Get the index of the item to craft\n  item_index = get_item_index(item)\n  \n  # Find a workshop that can produce this item\n  for recipe_output, ingredients in env.world.cookbook.recipes.items():\n    if recipe_output == item_index:\n        # Assuming all recipes require USE action at a workshop\n        workshop_indices = [idx for idx in ingredients.get(\"_key\", []) if idx in env.world.workshop_indices]\n        break\n  else:\n      raise ValueError(f\"No recipe found to craft {item}\")\n\n  # Navigate to the nearest workshop that can produce this item\n  closest_workshop_idx, min_distance = None, float('inf')\n  for workshop_idx in workshop_indices:\n    workshop_x, workshop_y = divmod(workshop_idx, env.world.scenario.grid.shape[1])\n    distance = abs(env._current_state.pos[0] - workshop_x) + abs(env._current_state.pos[1] - workshop_y)\n    if distance < min_distance:\n        closest_workshop_idx = workshop_idx\n        min_distance = distance\n\n  # Move to the nearest workshop\n  workshop_x, workshop_y = divmod(closest_workshop_idx, env.world.scenario.grid.shape[1])\n  actions = move_to_position(workshop_x, workshop_y)\n\n  # Add the USE action to craft the item\n  actions.append(env.world.N_ACTIONS.USE)\n  \n  return actions", "island_id": 1, "scores": {"": -1}}
{"timestamp": "2025-09-03T00:16:51.995877", "function_name": "craft", "function_body": "  index = env.world.cookbook.index\n  item_index = index[item]\n  \n  # Get the recipe for the item.\n  recipe = env.world.cookbook.recipes.get(item_index)\n  if not recipe:\n    raise ValueError(f\"No recipe found for item: {item}\")\n  \n  actions = []\n  \n  # Check if any workshop is required.\n  required_workshop = None\n  for ingredient in recipe:\n      if ingredient == \"_key\":\n          continue  # Skip the key which indicates count of ingredients\n      kind_index = index.get(ingredient)\n      if kind_index in env.world.workshop_indices:\n          required_workshop = kind_index\n          break\n  \n  if required_workshop is not None:\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, required_workshop] > 0)\n    \n    # If there are multiple workshops of the same type, choose one.\n    if len(workshop_positions) == 0:\n      raise ValueError(f\"No workshops found for item: {item}\")\n      \n    chosen_workshop_pos = workshop_positions[0]\n    target_x, target_y = chosen_workshop_pos\n    \n    current_x, current_y = env._current_state.pos\n    direction = env._current_state.dir\n\n    # Calculate the actions needed to reach the nearest workshop.\n    while not (current_x == target_x and current_y == target_y):\n        if target_x > current_x:\n            actions.append(3)  # RIGHT\n            current_x += 1\n        elif target_x < current_x:\n            actions.append(2)  # LEFT\n            current_x -= 1\n        if target_y > current_y:\n            actions.append(0)  # DOWN\n            current_y += 1\n        elif target_y < current_y:\n            actions.append(1)  # UP\n            current_y -= 1\n    \n    # Align the direction to face the workshop.\n    while not (current_x == target_x and current_y == target_y):\n      if (target_x > current_x and direction != 3) or (target_x < current_x and direction != 2):\n          actions.append(4)  # USE (to rotate)\n          direction = (direction + 1) % 4\n      elif (target_y > current_y and direction != 0) or (target_y < current_y and direction != 1):\n          actions.append(4)  # USE (to rotate)\n          direction = (direction + 1) % 4\n\n    # Use the workshop to craft the item.\n    actions.append(4)  # USE\n    \n  else:\n      raise ValueError(f\"No workshops found for item: {item}\")\n  \n  return actions", "island_id": 1, "scores": {"": -1}}
{"timestamp": "2025-09-03T00:18:19.437026", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos, workshop_indices):\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n\n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      # Move horizontally first\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      \n      # Then move vertically\n      if dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n\n      current_pos = (current_pos[0] + (dx // abs(dx)) if dx != 0 else current_pos[0],\n                     current_pos[1] + (dy // abs(dy)) if dy != 0 else current_pos[1])\n      \n    return actions\n  \n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  # This step assumes that the recipe specifies the workshop type needed.\n  # Since the problem does not specify how to determine the workshop,\n  # we will assume that all workshops can craft any items for simplicity.\n  # In practice, you would need to parse the recipe and check its requirements.\n\n  # For demonstration purposes, let's assume the first workshop is required.\n  workshop_index = env.world.workshop_indices[0]  \n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos, [workshop_index])\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 7, "scores": {"": -1}}
{"timestamp": "2025-09-03T00:18:20.531793", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n\n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      # Move horizontally first\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      \n      # Then move vertically\n      if dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n\n      current_pos = (current_pos[0] + (dx // abs(dx)) if dx != 0 else current_pos[0],\n                     current_pos[1] + (dy // abs(dy)) if dy != 0 else current_pos[1])\n      \n    return actions\n  \n  def get_workshop_for_item(item_index):\n      # This function should determine the specific workshop type needed for an item.\n      # For now, we will use a simple heuristic based on the item name.\n      if 'PLANK' in item or 'STICK' in item:\n          return env.world.workshop_indices[0]  # Workshop0 for wood-related items\n      elif 'CLOTH' in item or 'ROPE' in item:\n          return env.world.workshop_indices[1]  # Workshop1 for fabric-related items\n      elif 'BRIDGE' in item or 'LADDER' in item:\n          return env.world.workshop_indices[2]  # Workshop2 for construction-related items\n      else:\n          return env.world.workshop_indices[0]  # Default to Workshop0\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  workshop_index = get_workshop_for_item(item)\n\n  # Find the closest workshop of the required type\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 7, "scores": {"": 4.7}}
{"timestamp": "2025-09-03T00:19:00.020415", "function_name": "craft", "function_body": "", "island_id": 3, "scores": {"": -1}}
{"timestamp": "2025-09-03T00:24:00.161522", "function_name": "craft", "function_body": "  def get_workshop_index(item):\n    # Get the recipe for the item\n    item_index = env.world.cookbook.index[item]\n    recipe = env.world.cookbook.recipes.get(item_index, {})\n    \n    # Check if the recipe is known and has a workshop key\n    if \"_key\" in recipe:\n        return env.world.workshop_indices[recipe[\"_key\"]]\n    else:\n        # Default to the first workshop if no specific one is mentioned\n        return env.world.workshop_indices[0]\n    \n  def move_to_workshop(workshop_index):\n      target_pos = np.unravel_index(workshop_index, env._current_state.grid.shape[:2])\n      actions = []\n      \n      while not np.array_equal(env._current_state.pos, target_pos):\n          # Calculate the difference in position\n          delta_x = target_pos[0] - env._current_state.pos[0]\n          delta_y = target_pos[1] - env._current_state.pos[1]\n          \n          if delta_x > 0:\n              actions.append(env.action_specs()[\"DOWN\"])\n          elif delta_x < 0:\n              actions.append(env.action_specs()[\"UP\"])\n          \n          if delta_y > 0:\n              actions.append(env.action_specs()[\"RIGHT\"])\n          elif delta_y < 0:\n              actions.append(env.action_specs()[\"LEFT\"])\n      \n      return actions\n\n  def use_workshop():\n      return [env.action_specs()[\"USE\"]]\n  \n  # Get the workshop index for the item\n  workshop_index = get_workshop_index(item)\n  \n  # Move to the workshop\n  move_actions = move_to_workshop(workshop_index)\n  \n  # Use the workshop to craft the item\n  use_action = use_workshop()\n  \n  return move_actions + use_action", "island_id": 3, "scores": {"": -1}}
{"timestamp": "2025-09-03T00:25:59.680789", "function_name": "craft", "function_body": "  def get_closest_workshop(item_index):\n    \"\"\"Finds the closest workshop that can craft the specified item.\"\"\"\n    # Determine the workshop required based on the recipe key\n    for output_idx, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n        workshop_name = ingredients.get(\"_workshop\")\n        if workshop_name:\n          workshop_index = env.world.cookbook.index[workshop_name]\n          agent_pos = np.array(env._current_state.pos)\n          min_distance = float('inf')\n          closest_workshop_position = None\n          grid_shape = env._current_state.grid.shape[:2]\n\n          # Find the closest workshop in the grid\n          for y in range(grid_shape[1]):\n            for x in range(grid_shape[0]):\n              if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n                target_pos = np.array((x, y))\n                distance = np.linalg.norm(agent_pos - target_pos)\n                if distance < min_distance:\n                  min_distance = distance\n                  closest_workshop_position = (x, y)\n\n          return closest_workshop_index, closest_workshop_position\n    \n    # If no specific workshop is needed, use a default one\n    default_workshop_index = env.world.workshop_indices[0]  # Default to the first workshop type\n    agent_pos = np.array(env._current_state.pos)\n    min_distance = float('inf')\n    closest_default_workshop_position = None\n    grid_shape = env._current_state.grid.shape[:2]\n\n    # Find the closest default workshop in the grid\n    for y in range(grid_shape[1]):\n      for x in range(grid_shape[0]):\n        if env._current_state.grid[x, y, default_workshop_index] > 0:  # Check if the workshop is present at this cell\n          target_pos = np.array((x, y))\n          distance = np.linalg.norm(agent_pos - target_pos)\n          if distance < min_distance:\n            min_distance = distance\n            closest_default_workshop_position = (x, y)\n\n    return default_workshop_index, closest_default_workshop_position\n\n  def path_to_target(start, target):\n    \"\"\"Computes the path from start position to target position.\"\"\"\n    actions = []\n    while not np.all(start == target):\n        direction = target - start\n        if abs(direction[0]) > abs(direction[1]):\n            # Move horizontally\n            if direction[0] > 0:\n                actions.append(3)  # RIGHT\n                start[0] += 1\n            else:\n                actions.append(2)  # LEFT\n                start[0] -= 1\n        else:\n            # Move vertically\n            if direction[1] > 0:\n                actions.append(1)  # UP\n                start[1] += 1\n            else:\n                actions.append(0)  # DOWN\n                start[1] -= 1\n    return actions\n\n  def ensure_inventory(item_index, required_primitives):\n    \"\"\"Ensures the inventory has all required primitives for crafting.\"\"\"\n    actions = []\n    current_inventory = env._current_state.inventory.copy()\n    \n    for primitive in required_primitives:\n      if current_inventory.get(primitive, 0) == 0:\n        collect_actions = collect(env, primitive)\n        actions.extend(collect_actions)\n        current_inventory[primitive] += 1\n    \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n  workshop_index, workshop_pos = get_closest_workshop(item_index)\n\n  # Get required primitives from the recipe\n  required_primitives = []\n  for output_idx, ingredients in env.world.cookbook.recipes.items():\n    if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n      required_primitives.extend([env.world.cookbook.index[p] for p in ingredients.keys()])\n\n  # Ensure inventory has all required primitives\n  actions_to_collect_primitives = ensure_inventory(item_index, required_primitives)\n\n  # If no workshop position is found, return an empty list of actions\n  if workshop_pos is None:\n    return []\n\n  # Calculate the path to the closest workshop and perform the USE action\n  target_pos = np.array(workshop_pos)\n  actions_to_workshop = path_to_target(np.array(env._current_state.pos), target_pos)\n  actions_to_workshop.append(4)  # USE to craft the item\n\n  return actions_to_collect_primitives + actions_to_workshop", "island_id": 2, "scores": {"": 2.0}}
{"timestamp": "2025-09-03T00:26:00.743550", "function_name": "craft", "function_body": "  def get_closest_workshop(item_index):\n    \"\"\"Finds the closest workshop that can craft the specified item.\"\"\"\n    # Determine the workshop required based on the recipe key\n    workshop_indices = []\n    for output_idx, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n        workshop_name = ingredients.get(\"_workshop\")\n        if workshop_name:\n          workshop_indices.append(env.world.cookbook.index[workshop_name])\n    \n    # If no specific workshop is needed, use a default one\n    if not workshop_indices:\n      return env.world.workshop_indices[0]  # Default to the first workshop type\n    \n    # Find the closest workshop in the grid\n    agent_pos = np.array(env._current_state.pos)\n    min_distance = float('inf')\n    closest_workshop_index = None\n    for workshop_index in workshop_indices:\n      for y in range(grid_shape[1]):\n        for x in range(grid_shape[0]):\n          if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n            target_pos = np.array((x, y))\n            distance = np.linalg.norm(agent_pos - target_pos)\n            if distance < min_distance:\n              min_distance = distance\n              closest_workshop_index = workshop_index\n    return closest_workshop_index\n\n  def path_to_target(start, target):\n    \"\"\"Computes the path from start position to target position.\"\"\"\n    actions = []\n    while not np.all(start == target):\n        direction = target - start\n        if abs(direction[0]) > abs(direction[1]):\n            # Move horizontally\n            if direction[0] > 0:\n                actions.append(3)  # RIGHT\n                start[0] += 1\n            else:\n                actions.append(2)  # LEFT\n                start[0] -= 1\n        else:\n            # Move vertically\n            if direction[1] > 0:\n                actions.append(1)  # UP\n                start[1] += 1\n            else:\n                actions.append(0)  # DOWN\n                start[1] -= 1\n    return actions\n\n  def ensure_inventory(item_index, required_primitives):\n    \"\"\"Ensures the inventory has all required primitives for crafting.\"\"\"\n    actions = []\n    current_inventory = env._current_state.inventory.copy()\n    \n    for primitive in required_primitives:\n      if current_inventory.get(primitive, 0) == 0:\n        collect_actions = collect(env, primitive)\n        actions.extend(collect_actions)\n        # Update the inventory after collecting\n        current_inventory[primitive] += 1\n    \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n  grid_shape = env._current_state.grid.shape[:2]\n\n  # Find the closest workshop for crafting\n  workshop_index = get_closest_workshop(item_index)\n\n  # Get required primitives from the recipe\n  required_primitives = []\n  for output_idx, ingredients in env.world.cookbook.recipes.items():\n    if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n      required_primitives.extend(ingredients.keys())\n  \n  # Ensure inventory has all required primitives\n  actions_to_collect_primitives = ensure_inventory(item_index, required_primitives)\n\n  # Find the position of the closest workshop in the grid\n  agent_pos = np.array(env._current_state.pos)\n  workshop_pos = None\n  min_distance = float('inf')\n  for y in range(grid_shape[1]):\n    for x in range(grid_shape[0]):\n      if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n        target_pos = np.array((x, y))\n        distance = np.linalg.norm(agent_pos - target_pos)\n        if distance < min_distance:\n          min_distance = distance\n          workshop_pos = (x, y)\n\n  # If no workshop position is found, return an empty list of actions\n  if workshop_pos is None:\n    return []\n\n  # Calculate the path to the closest workshop and perform the USE action\n  target_pos = np.array(workshop_pos)\n  actions_to_workshop = path_to_target(agent_pos, target_pos)\n  actions_to_workshop.append(4)  # USE to craft the item\n\n  return actions_to_collect_primitives + actions_to_workshop", "island_id": 2, "scores": {"": 2.0}}
{"timestamp": "2025-09-03T00:27:12.078893", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    # Simple pathfinding logic: moves towards the target position using A* or similar\n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if abs(dx) > abs(dy):\n        if dx > 0:\n          actions.append(3)  # RIGHT\n        else:\n          actions.append(2)  # LEFT\n      else:\n        if dy > 0:\n          actions.append(1)  # UP\n        else:\n          actions.append(0)  # DOWN\n\n      current_pos = (current_pos[0] + (dx // abs(dx)) if dx != 0 else current_pos[0],\n                     current_pos[1] + (dy // abs(dy)) if dy != 0 else current_pos[1])\n      \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  # This step assumes that the recipe specifies the workshop type needed.\n  # Since the problem does not specify how to determine the workshop,\n  # we will assume that all workshops can craft any items for simplicity.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 6, "scores": {"": 0.90000004}}
{"timestamp": "2025-09-03T00:27:13.139346", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if any(grid[i, j, w] > 0 for w in workshop_indices):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n\n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if abs(dx) > abs(dy):\n        actions.append(3 if dx > 0 else 2)\n      else:\n        actions.append(1 if dy > 0 else 0)\n\n      current_pos = (current_pos[0] + (dx // abs(dx)) if dx != 0 else current_pos[0],\n                     current_pos[1] + (dy // abs(dy)) if dy != 0 else current_pos[1])\n      \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  workshop_index = env.world.workshop_indices[0]  # Placeholder, assuming all workshops can craft\n\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming USE is the last action\n\n  return actions_to_workshop", "island_id": 6, "scores": {"": 0.90000004}}
{"timestamp": "2025-09-03T00:27:44.830004", "function_name": "craft", "function_body": "  # Get the index of the item we want to craft\n  item_index = env.world.cookbook.index[item]\n\n  # Find a workshop that can produce this item (for simplicity, assume there's only one recipe per output and it has a single workshop)\n  for workshop_type in range(len(env.world.workshop_indices)):\n      workshop_idx = env.world.workshop_indices[workshop_type]\n      \n      # Check if the current workshop can craft the item\n      if item_index in env.world.cookbook.recipes:\n          # Assuming the workshop type is directly related to the recipe index (this may not be true, just an assumption for simplicity)\n          # Move to the workshop\n          actions_to_workshop = move_to(env, workshop_idx)\n\n          # Use the USE action to craft the item at the workshop\n          actions_to_craft = [env.world.n_actions - 1]  # Assuming USE is always the last action in the action space\n\n          return actions_to_workshop + actions_to_craft\n  \n  raise ValueError(\"No workshop found that can produce the desired item.\")", "island_id": 3, "scores": {"": -1}}
{"timestamp": "2025-09-03T00:27:45.801452", "function_name": "craft", "function_body": "  # Get the cookbook from the environment\n  cookbook = env.world.cookbook\n\n  # Get the index of the item to be crafted\n  item_index = cookbook.index[item]\n\n  # Determine which workshop is needed for crafting this item\n  # This requires checking the recipe to see what ingredients are required\n  # and then determining which workshop can handle those ingredients.\n  # For simplicity, let's assume we have a function `determine_workshop` that does this.\n  def determine_workshop(cookbook, item_index):\n    recipe = cookbook.recipes[item_index]\n    for ingredient in recipe:\n      if ingredient != \"_key\":\n        return env.world.workshop_indices[0]  # Simplified assumption\n    return None\n\n  workshop_index = determine_workshop(cookbook, item_index)\n\n  if workshop_index is None:\n    raise ValueError(f\"No suitable workshop found to craft {item}\")\n\n  # Get the position of the agent\n  pos = env._current_state.pos\n\n  # Move to the workshop\n  actions_to_move = move_to_position(env, pos, (workshop_index[0], workshop_index[1]))\n\n  # Use the workshop to craft the item\n  actions_to_use = [craft.USE]\n\n  return actions_to_move + actions_to_use", "island_id": 3, "scores": {"": -1}}
{"timestamp": "2025-09-03T00:28:19.954180", "function_name": "craft", "function_body": "  # Get the index for the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Find the workshop required to craft this item\n  recipe = env.world.cookbook.recipes.get(item_index)\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  # Extract the key \"_key\" which contains the type of workshop needed\n  workshop_key = recipe[\"_key\"]\n  \n  # Find the index of the required workshop from the environment's workshop_indices\n  if workshop_key in env.world.workshop_indices:\n    workshop_index = env.world.workshop_indices[workshop_key]\n  else:\n    raise ValueError(f\"Workshop {workshop_key} not found in environment\")\n\n  # Get the current position and direction of the agent\n  pos = env._current_state.pos\n  dir = env._current_state.dir\n\n  # Placeholder for actions to take\n  actions_to_take = []\n\n  # Action indices (assuming these are defined constants)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Define a function to move towards the target position\n  def move_towards(target_pos):\n    dx, dy = target_pos[0] - pos[0], target_pos[1] - pos[1]\n    if dx > 0:\n      actions_to_take.extend([RIGHT] * abs(dx))\n    elif dx < 0:\n      actions_to_take.extend([LEFT] * abs(dx))\n    if dy > 0:\n      actions_to_take.extend([DOWN] * abs(dy))\n    elif dy < 0:\n      actions_to_take.extend([UP] * abs(dy))\n\n  # Move towards the workshop\n  move_towards(workshop_index)\n\n  # Perform the USE action to craft the item\n  actions_to_take.append(USE)\n  \n  return actions_to_take", "island_id": 1, "scores": {"": -1}}
{"timestamp": "2025-09-03T00:28:20.924418", "function_name": "craft", "function_body": "  # Convert item name to index\n  item_index = env.world.cookbook.index[item]\n\n  # Find the workshop that can produce this item based on the recipes\n  workshop_indices = find_workshops_for_item(env, item_index)\n\n  # If no suitable workshop is found, return an empty list or raise an error\n  if not workshop_indices:\n    print(f\"No workshop available to craft {item}\")\n    return []\n\n  # Find a nearby reachable workshop\n  nearest_workshop_idx = find_nearest_reachable_workshop(env, workshop_indices)\n\n  # If no reachable workshop is found, return an empty list or raise an error\n  if nearest_workshop_idx is None:\n    print(f\"No reachable workshop available to craft {item}\")\n    return []\n\n  # Actions to move towards the workshop\n  actions_to_move = move_towards_workshop(env, nearest_workshop_idx)\n\n  # Action to use the workshop to craft the item (USE action)\n  actions_to_craft = [craft.USE]\n\n  # Combine all actions into one list\n  return actions_to_move + actions_to_craft", "island_id": 1, "scores": {"": -1}}
{"timestamp": "2025-09-03T00:28:57.979206", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Find the workshop that can craft this item\n  for recipe in env.world.cookbook.recipes.values():\n    if item_index == recipe.get(\"_key\"):\n      workshop_index = list(recipe.keys())[0]  # Assuming the first key is the workshop index\n      break\n\n  # Navigate to the workshop\n  workshop_pos = find_workshop_position(env, workshop_index)\n  actions.extend(navigate_to_position(env._current_state, workshop_pos))\n  \n  # Use action at the workshop to craft the item\n  actions.append(4)  # Assuming USE action is represented by index 4\n  \n  return actions", "island_id": 1, "scores": {"": -1}}
{"timestamp": "2025-09-03T00:28:58.949427", "function_name": "craft", "function_body": "  # Get the index of the item to craft\n  item_idx = env.world.cookbook.index[item]\n  \n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_idx not in env.world.cookbook.recipes:\n    raise ValueError(f\"No recipe for {item} found.\")\n    \n  # Get the workshop index from the recipes\n  workshop_idx = next(iter(env.world.cookbook.recipes[item_idx].keys()))\n  \n  # Check if the workshop is known and valid\n  if workshop_idx not in env.world.workshop_indices:\n    raise ValueError(f\"Workshop for {item} not found.\")\n    \n  # Define actions to move to the nearest workshop\n  actions = []\n  \n  # Find the closest workshop using a simple heuristic (manhattan distance)\n  closest_workshop_pos = None\n  min_distance = float('inf')\n  grid = env._current_state.grid\n  \n  for w_idx in env.world.workshop_indices:\n      if w_idx == workshop_idx: \n          x, y = np.where(grid[:, :, w_idx] > 0)\n          if len(x) > 0 and len(y) > 0:\n              distance = abs(env._current_state.pos[0] - x[0]) + abs(env._current_state.pos[1] - y[0])\n              if distance < min_distance:\n                  min_distance = distance\n                  closest_workshop_pos = (x[0], y[0])\n\n  # If no workshop is found, raise an error\n  if closest_workshop_pos is None:\n      raise ValueError(f\"No available workshop for {item}.\")\n\n  # Calculate actions to move towards the closest workshop\n  while env._current_state.pos != closest_workshop_pos:\n      dx = closest_workshop_pos[0] - env._current_state.pos[0]\n      dy = closest_workshop_pos[1] - env._current_state.pos[1]\n\n      if dx < 0:\n          actions.append(env.world.N_ACTIONS.DOWN)\n      elif dx > 0:\n          actions.append(env.world.N_ACTIONS.UP)\n\n      if dy < 0:\n          actions.append(env.world.N_ACTIONS.LEFT)\n      elif dy > 0:\n          actions.append(env.world.N_ACTIONS.RIGHT)\n\n      # Perform the action to move closer\n      reward, done, observations = env.step(actions[-1])\n      if done:\n          break\n\n  # Once at the workshop, perform the USE action to craft the item\n  actions.append(env.world.N_ACTIONS.USE)\n  \n  return actions", "island_id": 1, "scores": {"": -1}}
{"timestamp": "2025-09-03T00:31:23.449768", "function_name": "craft", "function_body": "  def get_closest_workshop(item_index):\n    \"\"\"Finds the closest workshop that can craft the specified item.\"\"\"\n    workshop_indices = []\n    for output_idx, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n        workshop_name = ingredients.get(\"_workshop\")\n        if workshop_name:\n          workshop_indices.append(env.world.cookbook.index[workshop_name])\n    \n    # If no specific workshop is needed, use a default one\n    if not workshop_indices:\n      return env.world.workshop_indices[0]  # Default to the first workshop type\n    \n    # Find the closest workshop in the grid\n    agent_pos = np.array(env._current_state.pos)\n    min_distance = float('inf')\n    closest_workshop_index = None\n    for workshop_index in workshop_indices:\n      for y in range(grid_shape[1]):\n        for x in range(grid_shape[0]):\n          if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n            target_pos = np.array((x, y))\n            distance = np.linalg.norm(agent_pos - target_pos)\n            if distance < min_distance:\n              min_distance = distance\n              closest_workshop_index = workshop_index\n    return closest_workshop_index\n\n  def path_to_target(start, target):\n    \"\"\"Computes the path from start position to target position using BFS for better efficiency.\"\"\"\n    queue = collections.deque([(start, [])])\n    visited = set()\n    while queue:\n      (x, y), actions = queue.popleft()\n      if (x, y) == tuple(target):\n        return actions\n      if (x, y) not in visited:\n        visited.add((x, y))\n        for dx, dy, action in [(-1, 0, 2), (1, 0, 3), (0, -1, 0), (0, 1, 1)]:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < grid_shape[0] and 0 <= ny < grid_shape[1]:\n            queue.append(((nx, ny), actions + [action]))\n    return []\n\n  def ensure_inventory(item_index):\n      \"\"\"Ensures the inventory has all required primitives for crafting.\"\"\"\n      actions = []\n      current_inventory = env._current_state.inventory.copy()\n      \n      # Get required primitives from the recipe\n      required_primitives = []\n      for output_idx, ingredients in env.world.cookbook.recipes.items():\n          if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n              required_primitives.extend([ingredient for ingredient in ingredients.keys() if ingredient != \"_key\"])\n      \n      # Collect each required primitive that is not already in the inventory\n      for primitive in required_primitives:\n          primitive_index = env.world.cookbook.index[primitive]\n          if current_inventory.get(primitive_index, 0) == 0:\n              collect_actions = collect(env, primitive)\n              actions.extend(collect_actions)\n              current_inventory[primitive_index] += 1\n      \n      return actions\n\n  def collect(env, primitive):\n    \"\"\"Collects the specified primitive from the grid.\"\"\"\n    actions = []\n    primitive_index = env.world.cookbook.index[primitive]\n    agent_pos = np.array(env._current_state.pos)\n    \n    # Find all positions of the primitive in the grid\n    primitive_positions = []\n    for y in range(grid_shape[1]):\n        for x in range(grid_shape[0]):\n            if env._current_state.grid[x, y, primitive_index] > 0:\n                primitive_positions.append((x, y))\n    \n    # If no positions found, return an empty list of actions\n    if not primitive_positions:\n        return []\n    \n    # Find the closest primitive to collect\n    min_distance = float('inf')\n    closest_primitive_pos = None\n    for pos in primitive_positions:\n        distance = np.linalg.norm(agent_pos - np.array(pos))\n        if distance < min_distance:\n            min_distance = distance\n            closest_primitive_pos = pos\n    \n    # Calculate the path to the closest primitive and perform the USE action\n    actions_to_primitive = path_to_target(agent_pos.tolist(), closest_primitive_pos)\n    actions.extend(actions_to_primitive)\n    actions.append(4)  # USE to collect the item\n    \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n  grid_shape = env._current_state.grid.shape[:2]\n\n  # Find the closest workshop for crafting\n  workshop_index = get_closest_workshop(item_index)\n\n  # Ensure inventory has all required primitives\n  actions_to_collect_primitives = ensure_inventory(item_index)\n\n  # Find the position of the closest workshop in the grid\n  agent_pos = np.array(env._current_state.pos)\n  workshop_pos = None\n  min_distance = float('inf')\n  for y in range(grid_shape[1]):\n    for x in range(grid_shape[0]):\n      if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n        target_pos = np.array((x, y))\n        distance = np.linalg.norm(agent_pos - target_pos)\n        if distance < min_distance:\n          min_distance = distance\n          workshop_pos = (x, y)\n\n  # If no workshop position is found, return an empty list of actions\n  if workshop_pos is None:\n    return []\n\n  # Calculate the path to the closest workshop and perform the USE action\n  target_pos = np.array(workshop_pos)\n  actions_to_workshop = path_to_target(agent_pos.tolist(), target_pos.tolist())\n  actions_to_workshop.append(4)  # USE to craft the item\n\n  return actions_to_collect_primitives + actions_to_workshop", "island_id": 2, "scores": {"": 2.0}}
{"timestamp": "2025-09-03T00:31:24.497837", "function_name": "craft", "function_body": "  def get_closest_workshop(item_index):\n    \"\"\"Finds the closest workshop that can craft the specified item.\"\"\"\n    workshop_indices = []\n    for output_idx, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n        workshop_name = ingredients.get(\"_workshop\")\n        if workshop_name:\n          workshop_indices.append(env.world.cookbook.index[workshop_name])\n    \n    # If no specific workshop is needed, use a default one\n    if not workshop_indices:\n      return env.world.workshop_indices[0]  # Default to the first workshop type\n    \n    # Find the closest workshop in the grid\n    agent_pos = np.array(env._current_state.pos)\n    min_distance = float('inf')\n    closest_workshop_index = None\n    for workshop_index in workshop_indices:\n      for y in range(grid_shape[1]):\n        for x in range(grid_shape[0]):\n          if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n            target_pos = np.array((x, y))\n            distance = np.linalg.norm(agent_pos - target_pos)\n            if distance < min_distance:\n              min_distance = distance\n              closest_workshop_index = workshop_index\n    return closest_workshop_index\n\n  def path_to_target(start, target):\n    \"\"\"Computes the path from start position to target position using BFS for better efficiency.\"\"\"\n    queue = collections.deque([(start, [])])\n    visited = set()\n    while queue:\n      (x, y), actions = queue.popleft()\n      if (x, y) == tuple(target):\n        return actions\n      if (x, y) not in visited:\n        visited.add((x, y))\n        for dx, dy, action in [(-1, 0, 2), (1, 0, 3), (0, -1, 0), (0, 1, 1)]:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < grid_shape[0] and 0 <= ny < grid_shape[1]:\n            queue.append(((nx, ny), actions + [action]))\n    return []\n\n  def ensure_inventory(item_index):\n      \"\"\"Ensures the inventory has all required primitives for crafting.\"\"\"\n      actions = []\n      current_inventory = env._current_state.inventory.copy()\n      \n      # Get required primitives from the recipe\n      required_primitives = []\n      for output_idx, ingredients in env.world.cookbook.recipes.items():\n          if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n              required_primitives.extend([ingredient for ingredient in ingredients.keys() if ingredient != \"_key\"])\n      \n      # Collect each required primitive that is not already in the inventory\n      for primitive in required_primitives:\n          primitive_index = env.world.cookbook.index[primitive]\n          if current_inventory.get(primitive_index, 0) == 0:\n              collect_actions = collect(env, primitive)\n              actions.extend(collect_actions)\n              current_inventory[primitive_index] += 1\n      \n      return actions\n\n  def collect(env, primitive):\n    \"\"\"Collects the specified primitive by finding and moving to its location.\"\"\"\n    # Find all locations of the primitive in the grid\n    primitive_index = env.world.cookbook.index[primitive]\n    target_positions = []\n    for y in range(grid_shape[1]):\n        for x in range(grid_shape[0]):\n            if env._current_state.grid[x, y, primitive_index] > 0:\n                target_positions.append((x, y))\n    \n    # Find the closest target position to collect\n    agent_pos = np.array(env._current_state.pos)\n    min_distance = float('inf')\n    closest_target = None\n    for pos in target_positions:\n        distance = np.linalg.norm(agent_pos - np.array(pos))\n        if distance < min_distance:\n            min_distance = distance\n            closest_target = pos\n    \n    # If no target position is found, return an empty list of actions\n    if closest_target is None:\n        return []\n    \n    # Calculate the path to the closest target and perform the USE action\n    actions_to_primitive = path_to_target(agent_pos.tolist(), closest_target)\n    actions_to_primitive.append(4)  # USE to collect the primitive\n    \n    return actions_to_primitive\n\n  item_index = env.world.cookbook.index[item]\n  grid_shape = env._current_state.grid.shape[:2]\n\n  # Ensure inventory has all required primitives\n  actions_to_collect_primitives = ensure_inventory(item_index)\n\n  # Find the closest workshop for crafting\n  workshop_index = get_closest_workshop(item_index)\n\n  # Find the position of the closest workshop in the grid\n  agent_pos = np.array(env._current_state.pos)\n  workshop_pos = None\n  min_distance = float('inf')\n  for y in range(grid_shape[1]):\n    for x in range(grid_shape[0]):\n      if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n        target_pos = np.array((x, y))\n        distance = np.linalg.norm(agent_pos - target_pos)\n        if distance < min_distance:\n          min_distance = distance\n          workshop_pos = (x, y)\n\n  # If no workshop position is found, return an empty list of actions\n  if workshop_pos is None:\n    return []\n\n  # Calculate the path to the closest workshop and perform the USE action\n  target_pos = np.array(workshop_pos)\n  actions_to_workshop = path_to_target(agent_pos.tolist(), target_pos.tolist())\n  actions_to_workshop.append(4)  # USE to craft the item\n\n  return actions_to_collect_primitives + actions_to_workshop", "island_id": 2, "scores": {"": 2.0}}
{"timestamp": "2025-09-03T00:32:56.011151", "function_name": "craft", "function_body": "  def move_to(pos):\n    \"\"\"Helper function to generate actions to move an agent to a target position.\"\"\"\n    current_pos = env._current_state.pos\n    dx = pos[0] - current_pos[0]\n    dy = pos[1] - current_pos[1]\n\n    actions = []\n    if dx < 0:\n      actions.extend([env.world.cookbook.index[\"LEFT\"]] * abs(dx))\n    elif dx > 0:\n      actions.extend([env.world.cookbook.index[\"RIGHT\"]] * abs(dx))\n\n    if dy < 0:\n      actions.extend([env.world.cookbook.index[\"UP\"]] * abs(dy))\n    elif dy > 0:\n      actions.extend([env.world.cookbook.index[\"DOWN\"]] * abs(dy))\n\n    return actions\n\n  def collect_missing_ingredients(recipe):\n    \"\"\"Helper function to determine missing ingredients and generate collection actions.\"\"\"\n    required_ingredients = {k: v for k, v in recipe.items() if k != \"_key\"}\n    inventory_counts = env._current_state.inventory\n    actions = []\n    \n    for ingredient_index, count in required_ingredients.items():\n      primitive_name = env.world.cookbook.index.get(ingredient_index, \"unknown\")\n      missing_count = count - inventory_counts[ingredient_index]\n      \n      if missing_count > 0:\n        for _ in range(missing_count):\n          actions.extend(collect(env, primitive_name))\n    \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Get all recipes that produce the item\n  recipes = {k: v for k, v in env.world.cookbook.recipes.items() if \"_key\" in v and v[\"_key\"] == item_index}\n\n  # If no recipe is found, return an empty list\n  if not recipes:\n    return []\n\n  # Assume we have only one recipe to produce the item\n  recipe = next(iter(recipes.values()))\n\n  # Determine which workshop type is needed based on the ingredients\n  workshop_needed = None\n  for ingredient_index in recipe.keys():\n      if ingredient_index != \"_key\":\n          kind_name = env.world.cookbook.index.get(ingredient_index, \"unknown\")\n          if kind_name.startswith(\"WORKSHOP\"):\n              workshop_needed = ingredient_index\n              break\n\n  # If no specific workshop is needed, use the first available workshop\n  if workshop_needed is None:\n      workshop_needed = env.world.workshop_indices[0]\n\n  # Find the nearest workshop of the required type\n  workshops = np.argwhere(env._current_state.grid[:, :, workshop_needed] > 0)\n  \n  # If no workshop of the required type is found, return an empty list\n  if workshops.size == 0:\n      return []\n\n  # Choose the closest workshop to the agent's current position\n  agent_pos = env._current_state.pos\n  distances = np.sum(np.abs(workshops - agent_pos), axis=1)\n  nearest_workshop = tuple(workshops[np.argmin(distances)])\n\n  # Generate actions to move the agent to the nearest workshop\n  actions_to_workshop = move_to(nearest_workshop)\n\n  # Collect missing ingredients if any\n  collection_actions = collect_missing_ingredients(recipe)\n\n  # Use action to craft the item\n  use_action_index = env.world.cookbook.index[\"USE\"]\n\n  # Return the list of actions including moving to the workshop, collecting missing ingredients, and using it\n  return collection_actions + actions_to_workshop + [use_action_index]", "island_id": 4, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T00:32:57.058899", "function_name": "craft", "function_body": "  def move_to(pos):\n    \"\"\"Helper function to generate actions to move an agent to a target position.\"\"\"\n    current_pos = env._current_state.pos\n    dx = pos[0] - current_pos[0]\n    dy = pos[1] - current_pos[1]\n\n    actions = []\n    if dx < 0:\n      actions.extend([env.world.cookbook.index[\"LEFT\"]] * abs(dx))\n    elif dx > 0:\n      actions.extend([env.world.cookbook.index[\"RIGHT\"]] * abs(dx))\n\n    if dy < 0:\n      actions.extend([env.world.cookbook.index[\"UP\"]] * abs(dy))\n    elif dy > 0:\n      actions.extend([env.world.cookbook.index[\"DOWN\"]] * abs(dy))\n\n    return actions\n\n  def get_missing_ingredients(recipe):\n    required_ingredients = {k: v for k, v in recipe.items() if k != \"_key\"}\n    missing_ingredients = []\n    inventory_counts = env._current_state.inventory\n    for ingredient_index, count in required_ingredients.items():\n      if inventory_counts[ingredient_index] < count:\n        missing_ingredients.append((ingredient_index, count - inventory_counts[ingredient_index]))\n    return missing_ingredients\n\n  def collect_missing_ingredients(missing_ingredients) -> list[int]:\n    \"\"\"Generate actions to collect all required ingredients.\"\"\"\n    actions = []\n    for ingredient_index, count in missing_ingredients:\n      ingredient_name = env.world.cookbook.index.get(ingredient_index, \"unknown\")\n      # Collect the ingredient 'count' times\n      for _ in range(count):\n        actions.extend(collect(env, ingredient_name))\n    return actions\n\n  def find_nearest_workshop(workshop_type_indices) -> tuple[int, int]:\n    agent_pos = env._current_state.pos\n    grid = env._current_state.grid\n    distances = np.inf * np.ones(grid.shape[:2])\n    \n    for index in workshop_type_indices:\n      workshops = np.argwhere(grid[:, :, index] > 0)\n      for workshop in workshops:\n        distance = np.sum(np.abs(workshop - agent_pos))\n        if distance < distances[tuple(workshop)]:\n          distances[tuple(workshop)] = distance\n    \n    nearest_workshop = np.unravel_index(np.argmin(distances), distances.shape)\n    return nearest_workshop\n\n  item_index = env.world.cookbook.index[item]\n  \n  recipes = {k: v for k, v in env.world.cookbook.recipes.items() if \"_key\" in v and v[\"_key\"] == item_index}\n  \n  if not recipes:\n    return []\n\n  recipe = next(iter(recipes.values()))\n  missing_ingredients = get_missing_ingredients(recipe)\n\n  # Determine which workshop type is needed based on the ingredients\n  workshop_needed_indices = []\n  for ingredient_index in recipe.keys():\n      kind_name = env.world.cookbook.index.get(ingredient_index, \"unknown\")\n      if kind_name.startswith(\"WORKSHOP\"):\n          workshop_needed_indices.append(ingredient_index)\n  \n  if not workshop_needed_indices:\n    workshop_needed_indices = [env.world.workshop_indices[0]]\n\n  nearest_workshop = find_nearest_workshop(workshop_needed_indices)\n\n  actions_to_workshop = move_to(nearest_workshop)\n\n  use_action_index = env.world.cookbook.index[\"USE\"]\n\n  actions_to_collect = collect_missing_ingredients(missing_ingredients)\n\n  return actions_to_collect + actions_to_workshop + [use_action_index]", "island_id": 4, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T00:34:09.825363", "function_name": "craft", "function_body": "  def find_nearest_workshop(state, workshop_indices):\n    min_distance = float('inf')\n    nearest_workshop_pos = None\n    \n    for workshop_idx in workshop_indices:\n      target_pos = find_position_of_kind(env, workshop_idx)\n      distance = np.linalg.norm(np.array(target_pos) - np.array(state.pos))\n      \n      if distance < min_distance:\n        min_distance = distance\n        nearest_workshop_pos = target_pos\n    \n    return nearest_workshop_pos\n\n  def move_to_position(current_pos, target_pos):\n    # Convert positions to grid coordinates (x, y)\n    current_x, current_y = current_pos\n    target_x, target_y = target_pos\n    \n    actions = []\n    \n    # Calculate direction vectors and prioritize moving vertically first if needed\n    dy = target_y - current_y\n    dx = target_x - current_x\n    \n    # Move vertically first if there is a difference in y-coordinate\n    if dy != 0:\n      move_dir = craft.DOWN if dy > 0 else craft.UP\n      actions.extend([move_dir] * abs(dy))\n    \n    # Then move horizontally if there is a difference in x-coordinate\n    if dx != 0:\n      move_dir = craft.RIGHT if dx > 0 else craft.LEFT\n      actions.extend([move_dir] * abs(dx))\n    \n    return actions\n\n  def find_position_of_kind(env, kind_index):\n    # Iterate over the grid to find a position of the given kind index\n    for y in range(env._current_state.grid.shape[0]):\n      for x in range(env._current_state.grid.shape[1]):\n        if env._current_state.grid[y, x, kind_index] > 0:\n          return (x, y)\n    \n    raise ValueError(f\"No position found for kind index {kind_index}\")\n\n  actions = []\n  current_state = env._current_state\n\n  # Get the index of the desired item from the cookbook index\n  item_index = env.world.cookbook.index[item]\n\n  # Find the workshop index for crafting the item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n  if \"_key\" in recipe:\n    key_workshop = recipe[\"_key\"]\n    workshop_index = env.world.workshop_indices[key_workshop]\n    \n    # Move to the nearest workshop of the required kind if not already next to one\n    if not current_state.next_to(workshop_index):\n      target_pos = find_nearest_workshop(current_state, [workshop_index])\n      actions.extend(move_to_position(current_state.pos, target_pos))\n      \n    # Perform the USE action to craft the item\n    actions.append(craft.USE)\n\n  return actions", "island_id": 8, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T00:34:10.877027", "function_name": "craft", "function_body": "  def find_nearest_workshop(state, workshop_indices):\n    min_distance = float('inf')\n    nearest_workshop_pos = None\n    \n    for workshop_idx in workshop_indices:\n        target_pos = find_position_of_kind(env, workshop_idx)\n        distance = np.linalg.norm(np.array(target_pos) - np.array(state.pos))\n        \n        if distance < min_distance:\n            min_distance = distance\n            nearest_workshop_pos = target_pos\n    \n    return nearest_workshop_pos\n\n  def move_to_position(current_pos, target_pos):\n      # Convert positions to grid coordinates (x, y)\n      current_x, current_y = current_pos\n      target_x, target_y = target_pos\n      \n      actions = []\n      \n      # Calculate direction vectors and prioritize moving vertically first if needed\n      dy = target_y - current_y\n      dx = target_x - current_x\n      \n      # Move vertically first if there is a difference in y-coordinate\n      if dy != 0:\n          move_dir = craft.DOWN if dy > 0 else craft.UP\n          actions.extend([move_dir] * abs(dy))\n      \n      # Then move horizontally if there is a difference in x-coordinate\n      if dx != 0:\n          move_dir = craft.RIGHT if dx > 0 else craft.LEFT\n          actions.extend([move_dir] * abs(dx))\n      \n      return actions\n\n  def find_position_of_kind(env, kind_index):\n    # Iterate over the grid to find a position of the given kind index\n    for y in range(env._current_state.grid.shape[1]):\n        for x in range(env._current_state.grid.shape[0]):\n            if env._current_state.grid[y, x, kind_index] > 0:\n                return (x, y)\n      \n    raise ValueError(f\"No position found for kind index {kind_index}\")\n\n  actions = []\n  current_state = env._current_state\n\n  # Get the index of the desired item from the cookbook index\n  item_index = env.world.cookbook.index[item]\n\n  # Find the workshop index for crafting the item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n  if \"_key\" in recipe:\n      key_workshop = recipe[\"_key\"]\n      workshop_index = env.world.workshop_indices[key_workshop]\n      \n      # Move to the nearest workshop of the required kind if not already next to one\n      if not current_state.next_to(workshop_index):\n          target_pos = find_nearest_workshop(current_state, [workshop_index])\n          actions.extend(move_to_position(current_state.pos, target_pos))\n          \n      # Perform the USE action to craft the item\n      actions.append(craft.USE)\n\n  return actions", "island_id": 8, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T00:35:10.091356", "function_name": "craft", "function_body": "  def get_workshop_for_item(item_index):\n    for workshop, recipes in env.world.cookbook.recipes.items():\n        if '_key' in recipes and item_index == recipes['_key']:\n            return workshop\n    return None\n\n  def find_nearest_workshop(env, workshop_type_index):\n    grid = env._current_state.grid\n    pos = env._current_state.pos\n    \n    # Find all locations of the workshop type on the grid\n    workshop_locations = np.argwhere(grid[:, :, workshop_type_index] > 0)\n    \n    # Calculate Manhattan distances from the current position to each workshop location\n    distances = np.sum(np.abs(workshop_locations - pos), axis=1)\n    \n    # Find the nearest workshop location\n    nearest_workshop_location = tuple(workshop_locations[np.argmin(distances)])\n    \n    return nearest_workshop_location\n\n  def navigate_to(env, target_pos):\n    current_pos = env._current_state.pos\n    \n    actions = []\n    while current_pos != target_pos:\n        delta_x = target_pos[0] - current_pos[0]\n        delta_y = target_pos[1] - current_pos[1]\n        \n        if delta_x > 0:\n            actions.append(env.action_specs()['RIGHT'])\n        elif delta_x < 0:\n            actions.append(env.action_specs()['LEFT'])\n        \n        if delta_y > 0:\n            actions.append(env.action_specs()['DOWN'])\n        elif delta_y < 0:\n            actions.append(env.action_specs()['UP'])\n        \n        # Update the current position based on the action\n        new_pos = tuple(current_pos)\n        for action in actions[-1:]:\n            _, env._current_state = env.step(action, num_steps=1)\n            new_pos = env._current_state.pos\n        \n        current_pos = new_pos\n    \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Find the workshop that allows crafting this item (if any)\n  workshop_index = get_workshop_for_item(item_index)\n\n  actions = []\n\n  if workshop_index is not None:\n      # Get the location of the nearest workshop of the required type\n      nearest_workshop_location = find_nearest_workshop(env, workshop_index)\n      \n      # Navigate to the workshop location\n      actions.extend(navigate_to(env, nearest_workshop_location))\n      \n      # Use the workshop to craft the item\n      actions.append(env.action_specs()['USE'])\n  \n  return actions", "island_id": 9, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T00:35:11.140141", "function_name": "craft", "function_body": "  def get_workshop_for_item(item_index):\n    for workshop, recipes in env.world.cookbook.recipes.items():\n        if '_key' in recipes and item_index == recipes['_key']:\n            return workshop\n    return None\n\n  def find_nearest_workshop(env, workshop_type):\n      \"\"\"Finds the nearest workshop of a given type.\"\"\"\n      world = env.world\n      grid = env._current_state.grid\n      pos = env._current_state.pos\n      \n      # Iterate over all possible positions in the grid to find workshops\n      min_distance = float('inf')\n      nearest_location = None\n      for i in range(grid.shape[0]):\n          for j in range(grid.shape[1]):\n              if grid[i, j, workshop_type] > 0:\n                  distance = abs(i - pos[0]) + abs(j - pos[1])\n                  if distance < min_distance:\n                      min_distance = distance\n                      nearest_location = (i, j)\n      return nearest_location\n  \n  def navigate_to(env, target_position):\n    \"\"\"Navigates the agent to a given position.\"\"\"\n    current_position = env._current_state.pos\n    actions = []\n    \n    # Calculate direction vector\n    dx = target_position[0] - current_position[0]\n    dy = target_position[1] - current_position[1]\n\n    while dx != 0 or dy != 0:\n        if dx < 0:\n            actions.append(env.action_specs()['LEFT'])\n            dx += 1\n        elif dx > 0:\n            actions.append(env.action_specs()['RIGHT'])\n            dx -= 1\n        if dy < 0:\n            actions.append(env.action_specs()['UP'])\n            dy += 1\n        elif dy > 0:\n            actions.append(env.action_specs()['DOWN'])\n            dy -= 1\n    \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Find the workshop that allows crafting this item (if any)\n  workshop_index = get_workshop_for_item(item_index)\n\n  actions = []\n\n  if workshop_index is not None:\n      # Get the location of the nearest workshop of the required type\n      nearest_workshop_location = find_nearest_workshop(env, workshop_index)\n      \n      # Navigate to the workshop location\n      actions.extend(navigate_to(env, nearest_workshop_location))\n      \n      # Use the workshop to craft the item\n      actions.append(env.action_specs()['USE'])\n  \n  return actions", "island_id": 9, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T00:35:54.805642", "function_name": "craft", "function_body": "  goal_index = env.world.cookbook.index[item]\n\n  actions = []\n\n  if goal_index in env.world.workshop_indices:\n    # Find all workshops that can produce the item\n    workshop_indices = [idx for idx, recipe in env.world.cookbook.recipes.items() \n                        if \"_key\" in recipe and recipe[\"_key\"] == goal_index]\n    \n    if workshop_indices:\n        # Choose the first available workshop (assuming it's always reachable)\n        chosen_workshop_index = workshop_indices[0]\n\n        # Find the position of the chosen workshop\n        workshop_pos = np.argwhere(env._current_state.grid[:, :, chosen_workshop_index]).tolist()\n        \n        if workshop_pos:\n            # Move to the nearest workshop position\n            target_pos = workshop_pos[0]  # Assume moving to the first occurrence\n\n            # Calculate the direction and move towards the workshop\n            current_x, current_y = env._current_state.pos\n            target_x, target_y = target_pos\n\n            # Calculate moves in x-direction\n            if current_x < target_x:\n                actions.extend([craft.MOVE_FUNC(craft.RIGHT)] * (target_x - current_x))\n            elif current_x > target_x:\n                actions.extend([craft.MOVE_FUNC(craft.LEFT)] * (current_x - target_x))\n\n            # Calculate moves in y-direction\n            if current_y < target_y:\n                actions.extend([craft.MOVE_FUNC(craft.DOWN)] * (target_y - current_y))\n            elif current_y > target_y:\n                actions.extend([craft.MOVE_FUNC(craft.UP)] * (current_y - target_y))\n\n            # Use the workshop to craft the item\n            actions.append(craft.CRAFT_FUNC(item))\n  \n  return actions", "island_id": 5, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T00:35:55.777763", "function_name": "craft", "function_body": "  def move_to(target_pos):\n    current_x, current_y = env._current_state.pos\n    target_x, target_y = target_pos\n\n    # Calculate moves in x-direction\n    if current_x < target_x:\n        actions.extend([craft.MOVE_FUNC(craft.RIGHT)] * (target_x - current_x))\n    elif current_x > target_x:\n        actions.extend([craft.MOVE_FUNC(craft.LEFT)] * (current_x - target_x))\n\n    # Calculate moves in y-direction\n    if current_y < target_y:\n        actions.extend([craft.MOVE_FUNC(craft.DOWN)] * (target_y - current_y))\n    elif current_y > target_y:\n        actions.extend([craft.MOVE_FUNC(craft.UP)] * (current_y - target_y))\n\n  def get_workshop_for(goal_index):\n    # Find all workshops that can produce the item\n    workshop_indices = [idx for idx, recipe in env.world.cookbook.recipes.items() \n                        if \"_key\" in recipe and recipe[\"_key\"] == goal_index]\n    \n    return workshop_indices\n\n  actions = []\n  goal_index = env.world.cookbook.index[item]\n\n  # Check if the goal item can be crafted\n  if goal_index not in get_workshop_for(goal_index):\n      raise ValueError(f\"No known way to craft {item}.\")\n\n  # Find all workshops that can produce the item\n  workshop_indices = get_workshop_for(goal_index)\n\n  if workshop_indices:\n    # Choose the first available workshop (assuming it's always reachable)\n    chosen_workshop_index = workshop_indices[0]\n\n    # Find the position of the chosen workshop\n    workshop_pos = np.argwhere(env._current_state.grid[:, :, chosen_workshop_index]).tolist()\n    \n    if workshop_pos:\n      # Move to the nearest workshop position\n      target_pos = workshop_pos[0]  # Assume moving to the first occurrence\n\n      # Move to the workshop\n      move_to(target_pos)\n\n      # Use the workshop to craft the item\n      actions.append(craft.CRAFT_FUNC(item))\n  \n  return actions", "island_id": 5, "scores": {"": 