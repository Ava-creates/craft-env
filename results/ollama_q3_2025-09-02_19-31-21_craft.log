ns.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      elif dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n\n      current_pos = next_pos\n      \n    return actions\n\n  def collect_primitives(env, primitives):\n    actions = []\n    grid = env._current_state.grid\n    pos = env._current_state.pos\n    \n    for primitive in primitives:\n        primitive_index = env.world.cookbook.index[primitive]\n        \n        while not np.any([grid[i, j, primitive_index] > 0 for i in range(grid.shape[0]) for j in range(grid.shape[1])]):\n            # Randomly move around to find the primitive\n            actions.append(np.random.choice([0, 1, 2, 3]))\n            reward, env._current_state = env._current_state.step(actions[-1])\n            grid = env._current_state.grid\n        \n        closest_primitive_pos = find_closest(grid, pos, [primitive_index])\n        \n        if closest_primitive_pos:\n            actions.extend(move_to(env, closest_primitive_pos))\n            actions.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n            reward, env._current_state = env._current_state.step(actions[-1])\n            grid = env._current_state.grid\n    \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n      raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Get the list of primitives required for crafting the item\n  recipe = env.world.cookbook.recipes[item_index]\n  primitives_required = [key for key in recipe if key in env.world.cookbook.index]\n\n  # Collect all required primitives\n  actions_to_collect_primitives = collect_primitives(env, primitives_required)\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest(grid, pos, env.world.workshop_indices)\n\n  if not closest_workshop_pos:\n      raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_collect_primitives + actions_to_workshop", "island_id": 3, "scores": {"": 4.7}}
{"timestamp": "2025-09-03T19:44:22.421322", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos, workshop_indices):\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if any(grid[i, j, w] > 0 for w in workshop_indices):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      # Determine the direction to move first based on larger difference\n      if abs(dx) >= abs(dy):\n          move_horizontally_first = True\n      else:\n          move_horizontally_first = False\n      \n      if move_horizontally_first:\n        while dx != 0:\n          actions.append(3 if dx > 0 else 2)  # RIGHT or LEFT\n          current_pos = (current_pos[0] + np.sign(dx), current_pos[1])\n          dx -= np.sign(dx)\n        while dy != 0:\n          actions.append(1 if dy > 0 else 0)  # UP or DOWN\n          current_pos = (current_pos[0], current_pos[1] + np.sign(dy))\n          dy -= np.sign(dy)\n      else:\n        while dy != 0:\n          actions.append(1 if dy > 0 else 0)  # UP or DOWN\n          current_pos = (current_pos[0], current_pos[1] + np.sign(dy))\n          dy -= np.sign(dy)\n        while dx != 0:\n          actions.append(3 if dx > 0 else 2)  # RIGHT or LEFT\n          current_pos = (current_pos[0] + np.sign(dx), current_pos[1])\n          dx -= np.sign(dx)\n      \n    return actions\n\n  def find_workshop_for_item(env, item_index):\n      \"\"\"Determine which workshop can craft the given item.\"\"\"\n      cookbook = env.world.cookbook\n      if item_index not in cookbook.recipes:\n          raise ValueError(f\"Item with index {item_index} cannot be crafted as it has no recipe.\")\n      \n      # For simplicity, we assume the first workshop is suitable for any item.\n      # In a more detailed implementation, you would check the recipe's requirements.\n      return env.world.workshop_indices[0]\n\n  def collect_primitives(env, primitives):\n    actions = []\n    cookbook = env.world.cookbook\n    current_state = env._current_state\n    \n    for primitive in primitives:\n        primitive_index = cookbook.index[primitive]\n        while not current_state.next_observation[\"inventory\"][primitive_index] > 0:\n            # Find the closest source of the primitive on the grid\n            target_pos = None\n            min_distance = float('inf')\n            \n            for i in range(current_state.grid.shape[0]):\n                for j in range(current_state.grid.shape[1]):\n                    if current_state.grid[i, j, primitive_index] > 0:\n                        distance = abs(i - current_state.pos[0]) + abs(j - current_state.pos[1])\n                        if distance < min_distance:\n                            min_distance = distance\n                            target_pos = (i, j)\n            \n            if not target_pos:\n                raise ValueError(f\"No available source found for primitive '{primitive}'.\")\n            \n            # Move to the closest source of the primitive\n            actions.extend(move_to(env, target_pos))\n            \n            # Use the COLLECT action to collect the primitive\n            actions.append(4)  # Assuming the fifth action index corresponds to COLLECT\n            \n            # Update the current state\n            reward, done, observations = env.step(actions[-1])\n            current_state = observations[\"state\"]\n    \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  workshop_index = find_workshop_for_item(env, item_index)\n\n  # Find the closest workshop of the determined type\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos, [workshop_index])\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Collect all required primitives for crafting the item\n  recipe = env.world.cookbook.recipes[item_index]\n  primitives = []\n  \n  for ingredient in recipe:\n      primitive_name = ingredient[0]  # Assuming the ingredient is a tuple (name, quantity)\n      if primitive_name in env.world.cookbook.index:  # Check if it's a primitive\n          primitives.append(primitive_name)\n\n  collect_actions = collect_primitives(env, primitives)\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  use_action = env.world.n_actions - 1  # Assuming the last action index corresponds to USE\n\n  return collect_actions + actions_to_workshop + [use_action]", "island_id": 4, "scores": {"": -1}}
{"timestamp": "2025-09-03T19:44:23.397646", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if any(grid[i, j, w] > 0 for w in workshop_indices):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      # Determine the direction to move first based on larger difference\n      if abs(dx) >= abs(dy):\n          actions.extend([3 if dx > 0 else 2] * abs(dx))  # RIGHT or LEFT\n          current_pos = (target_pos[0], current_pos[1])\n      else:\n          actions.extend([1 if dy > 0 else 0] * abs(dy))  # UP or DOWN\n          current_pos = (current_pos[0], target_pos[1])\n      \n    return actions\n\n  def find_workshop_for_item(env, item_index):\n      \"\"\"Determine which workshop can craft the given item.\"\"\"\n      cookbook = env.world.cookbook\n      \n      if item_index not in cookbook.recipes:\n          raise ValueError(f\"Item with index {item_index} cannot be crafted as it has no recipe.\")\n      \n      # For simplicity, we assume the first workshop is suitable for any item.\n      # In a more detailed implementation, you would check the recipe's requirements.\n      return env.world.workshop_indices[0]\n\n  def ensure_primitives_in_inventory(env, primitives):\n    \"\"\"Ensure that all required primitives are in the inventory. \n       If not, generate actions to collect them.\"\"\"\n    current_inventory = env._current_state.inventory\n 