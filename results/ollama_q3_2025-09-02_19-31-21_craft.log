{"timestamp": "2025-09-03T00:45:40.944011", "function_name": "craft", "function_body": "  UP = 1\n  DOWN = 0\n  LEFT = 3\n  RIGHT = 2\n  USE = 4\n\n  def get_missing_ingredients(recipe):\n      required_ingredients = {k: v for k, v in recipe.items() if k != \"_key\"}\n      missing_ingredients = []\n      inventory_counts = env._current_state.inventory\n      for ingredient_index, count in required_ingredients.items():\n          if inventory_counts[ingredient_index] < count:\n              missing_ingredients.append((ingredient_index, count - inventory_counts[ingredient_index]))\n      return missing_ingredients\n\n  def move_to(env, target_pos):\n    \"\"\"Generate actions to move the agent to a target position using BFS.\"\"\"\n    current_pos = env._current_state.pos\n    direction = env._current_state.dir\n    queue = collections.deque([(current_pos, direction, [])])\n    visited = set()\n    \n    # Define movement vectors for each direction\n    directions = [(0, 1), (0, -1), (-1, 0), (1, 0)]  # RIGHT, LEFT, UP, DOWN\n    \n    while queue:\n        pos, dir, path = queue.popleft()\n        \n        if tuple(pos) == target_pos:\n            return path\n        \n        if (tuple(pos), dir) in visited:\n            continue\n        visited.add((tuple(pos), dir))\n        \n        for i, (dx, dy) in enumerate(directions):\n            new_pos = (pos[0] + dx, pos[1] + dy)\n            \n            # Check if the new position is within bounds and not blocked\n            if 0 <= new_pos[0] < env._current_state.grid.shape[0] and\\\n               0 <= new_pos[1] < env._current_state.grid.shape[1] and\\\n               env._current_state.grid[new_pos, env.world.water_index] == 0:\n                \n                if i == dir:  # Move straight\n                    new_path = path + [i]\n                    queue.append((new_pos, i, new_path))\n                elif (i - dir) % 4 == 1:  # Turn right\n                    turn_action = RIGHT\n                    new_path = path + [turn_action, i]\n                    queue.append((new_pos, i, new_path))\n                elif (i - dir) % 4 == 3:  # Turn left\n                    turn_action = LEFT\n                    new_path = path + [turn_action, i]\n                    queue.append((new_pos, i, new_path))\n                else:  # Turn around\n                    turn_action1 = LEFT if dir in (0, 2) else RIGHT\n                    turn_action2 = LEFT if dir in (1, 3) else RIGHT\n                    new_path = path + [turn_action1, turn_action2, i]\n                    queue.append((new_pos, i, new_path))\n    \n    return []  # No path found\n\n  item_index = env.world.cookbook.index[item]\n\n  # Retrieve all recipes that produce the specified item\n  recipes = {k: v for k, v in env.world.cookbook.recipes.items() if \"_key\" in v and v[\"_key\"] == item_index}\n\n  # If no recipe is found, return an empty list\n  if not recipes:\n    return []\n\n  # Assume we have only one recipe to produce the item\n  recipe = next(iter(recipes.values()))\n\n  # Identify required ingredients from the recipe\n  missing_ingredients = get_missing_ingredients(recipe)\n\n  # Determine which workshop type is needed based on the ingredients\n  workshop_needed = None\n  for ingredient_index in recipe.keys():\n      kind_name = env.world.cookbook.index.get(ingredient_index, \"unknown\")\n      if kind_name.startswith(\"WORKSHOP\"):\n          workshop_needed = ingredient_index\n          break\n\n  # If no specific workshop is needed, use the first available workshop\n  if workshop_needed is None:\n      workshop_needed = env.world.workshop_indices[0]\n\n  # Find the nearest workshop of the required type\n  workshops = np.argwhere(env._current_state.grid[:, :, workshop_needed] > 0)\n  \n  # If no workshop of the required type is found, return an empty list\n  if workshops.size == 0:\n      return []\n\n  # Choose the closest workshop to the agent's current position\n  agent_pos = env._current_state.pos\n  distances = np.sum(np.abs(workshops - agent_pos), axis=1)\n  nearest_workshop = tuple(workshops[np.argmin(distances)])\n\n  # Generate actions to move the agent to the nearest workshop\n  actions_to_workshop = move_to(env, nearest_workshop)\n\n  # Use action to craft the item\n  use_action_index = env.world.cookbook.index[\"USE\"]\n\n  # Collect missing ingredients if any\n  actions_to_collect = []\n  for ingredient_index, count in missing_ingredients:\n      ingredient_name = env.world.cookbook.index.get(ingredient_index, \"unknown\")\n      actions_to_collect.extend(collect(env, ingredient_name) * count)\n\n  # Combine all actions: collecting missing ingredients, moving to workshop, and using it\n  return actions_to_collect + actions_to_workshop + [use_action_index]", "island_id": 4, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T00:45:41.998948", "function_name": "craft", "function_body": "  def get_missing_ingredients(recipe):\n      required_ingredients = {k: v for k, v in recipe.items() if k != \"_key\"}\n      missing_ingredients = []\n      inventory_counts = env._current_state.inventory\n      for ingredient_index, count in required_ingredients.items():\n          if inventory_counts[ingredient_index] < count:\n              missing_ingredients.append((ingredient_index, count - inventory_counts[ingredient_index]))\n      return missing_ingredients\n\n  def move_to(env, target_pos):\n    \"\"\"Generate actions to move the agent to a target position using BFS.\"\"\"\n    current_pos = env._current_state.pos\n    direction = env._current_state.dir\n    queue = collections.deque([(current_pos, direction, [])])\n    visited = set()\n    \n    # Define movement vectors for each direction\n    directions = [(0, 1), (0, -1), (-1, 0), (1, 0)]  # UP, DOWN, LEFT, RIGHT\n    \n    while queue:\n        pos, dir, path = queue.popleft()\n        \n        if tuple(pos) == target_pos:\n            return path\n        \n        if (tuple(pos), dir) in visited:\n            continue\n        visited.add((tuple(pos), dir))\n        \n        for i, (dx, dy) in enumerate(directions):\n            new_pos = (pos[0] + dx, pos[1] + dy)\n            \n            # Check if the new position is within bounds and not blocked by water or non-walkable terrain\n            if 0 <= new_pos[0] < env._current_state.grid.shape[0] and\\\n               0 <= new_pos[1] < env._current_state.grid.shape[1] and\\\n               env._current_state.grid[new_pos, env.world.water_index] == 0:\n                \n                # Determine the action to take based on direction\n                if i == dir:  # Move straight\n                    new_path = path + [i]\n                elif i == (dir + 1) % 4:  # Turn right\n                    turn_action = RIGHT if i == 2 else LEFT\n                    new_path = path + [turn_action, i]\n                elif i == (dir - 1) % 4:  # Turn left\n                    turn_action = LEFT if i == 3 else RIGHT\n                    new_path = path + [turn_action, i]\n                else:  # Turn around\n                    turn_action1 = LEFT if dir in (0, 2) else RIGHT\n                    turn_action2 = LEFT if dir in (1, 3) else RIGHT\n                    new_path = path + [turn_action1, turn_action2, i]\n                \n                queue.append((new_pos, i, new_path))\n    \n    return []  # No path found\n\n  def collect(env, primitive):\n      \"\"\"Generate actions to collect a required primitive.\"\"\"\n      UP = env.world.cookbook.index[\"UP\"]\n      DOWN = env.world.cookbook.index[\"DOWN\"]\n      LEFT = env.world.cookbook.index[\"LEFT\"]\n      RIGHT = env.world.cookbook.index[\"RIGHT\"]\n\n      def move_to_primitive(env, target_pos):\n          \"\"\"Generate actions to move the agent to a target primitive position using BFS.\"\"\"\n          current_pos = env._current_state.pos\n          direction = env._current_state.dir\n          queue = collections.deque([(current_pos, direction, [])])\n          visited = set()\n          \n          # Define movement vectors for each direction\n          directions = [(0, 1), (0, -1), (-1, 0), (1, 0)]  # UP, DOWN, LEFT, RIGHT\n          \n          while queue:\n              pos, dir, path = queue.popleft()\n              \n              if tuple(pos) == target_pos:\n                  return path\n              \n              if (tuple(pos), dir) in visited:\n                  continue\n              visited.add((tuple(pos), dir))\n              \n              for i, (dx, dy) in enumerate(directions):\n                  new_pos = (pos[0] + dx, pos[1] + dy)\n                  \n                  # Check if the new position is within bounds and not blocked by water or non-walkable terrain\n                  if 0 <= new_pos[0] < env._current_state.grid.shape[0] and\\\n                     0 <= new_pos[1] < env._current_state.grid.shape[1] and\\\n                     env._current_state.grid[new_pos, env.world.water_index] == 0:\n                      \n                      # Determine the action to take based on direction\n                      if i == dir:  # Move straight\n                          new_path = path + [i]\n                      elif i == (dir + 1) % 4:  # Turn right\n                          turn_action = RIGHT if i == 2 else LEFT\n                          new_path = path + [turn_action, i]\n                      elif i == (dir - 1) % 4:  # Turn left\n                          turn_action = LEFT if i == 3 else RIGHT\n                          new_path = path + [turn_action, i]\n                      else:  # Turn around\n                          turn_action1 = LEFT if dir in (0, 2) else RIGHT\n                          turn_action2 = LEFT if dir in (1, 3) else RIGHT\n                          new_path = path + [turn_action1, turn_action2, i]\n                      \n                      queue.append((new_pos, i, new_path))\n          \n          return []  # No path found\n\n      primitive_index = env.world.cookbook.index[primitive]\n\n      # Find the nearest available primitive of the required type\n      primitives = np.argwhere(env._current_state.grid[:, :, primitive_index] > 0)\n\n      if primitives.size == 0:\n          return []\n\n      agent_pos = env._current_state.pos\n      distances = np.sum(np.abs(primitives - agent_pos), axis=1)\n      nearest_primitive = tuple(primitives[np.argmin(distances)])\n\n      # Generate actions to move the agent to the nearest primitive\n      actions_to_primitive = move_to_primitive(env, nearest_primitive)\n\n      # Check if the agent is adjacent to the primitive and can collect it\n      adjacent_actions = []\n      current_pos = env._current_state.pos\n      if abs(current_pos[0] - nearest_primitive[0]) + abs(current_pos[1] - nearest_primitive[1]) == 1:\n          # Agent is adjacent, just pick up the primitive\n          return actions_to_primitive\n      else:\n          # Move to a position adjacent to the primitive\n          adj_positions = [(nearest_primitive[0] + dx, nearest_primitive[1] + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n          for pos in adj_positions:\n              if 0 <= pos[0] < env._current_state.grid.shape[0] and\\\n                 0 <= pos[1] < env._current_state.grid.shape[1]:\n                  path_to_adj = move_to_primitive(env, pos)\n                  adjacent_actions.extend(path_to_adj + [USE])\n                  break\n\n      return actions_to_primitive + adjacent_actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Retrieve all recipes that produce the specified item\n  recipes = {k: v for k, v in env.world.cookbook.recipes.items() if \"_key\" in v and v[\"_key\"] == item_index}\n\n  # If no recipe is found, return an empty list\n  if not recipes:\n    return []\n\n  # Assume we have only one recipe to produce the item\n  recipe = next(iter(recipes.values()))\n\n  # Identify required ingredients from the recipe\n  missing_ingredients = get_missing_ingredients(recipe)\n\n  # Determine which workshop type is needed based on the ingredients\n  workshop_needed = None\n  for ingredient_index in recipe.keys():\n      kind_name = env.world.cookbook.index.get(ingredient_index, \"unknown\")\n      if kind_name.startswith(\"WORKSHOP\"):\n          workshop_needed = ingredient_index\n          break\n\n  # If no specific workshop is needed, use the first available workshop\n  if workshop_needed is None:\n      workshop_needed = env.world.workshop_indices[0]\n\n  # Find the nearest workshop of the required type\n  workshops = np.argwhere(env._current_state.grid[:, :, workshop_needed] > 0)\n  \n  # If no workshop of the required type is found, return an empty list\n  if workshops.size == 0:\n      return []\n\n  # Choose the closest workshop to the agent's current position\n  agent_pos = env._current_state.pos\n  distances = np.sum(np.abs(workshops - agent_pos), axis=1)\n  nearest_workshop = tuple(workshops[np.argmin(distances)])\n\n  # Generate actions to move the agent to the nearest workshop\n  actions_to_workshop = move_to(env, nearest_workshop)\n\n  # Use action index for crafting\n  use_action_index = env.world.cookbook.index[\"USE\"]\n\n  # Collect missing ingredients if any\n  actions_to_collect = []\n  for ingredient_index, count in missing_ingredients:\n      ingredient_name = env.world.cookbook.index.get(ingredient_index, \"unknown\")\n      actions_to_collect.extend(collect(env, ingredient_name) * count)\n\n  # Combine all actions: collecting missing ingredients, moving to workshop, and using it\n  return actions_to_collect + actions_to_workshop + [use_action_index]", "island_id": 4, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T00:47:11.704922", "function_name": "craft", "function_body": "  def get_workshop_for_item(item_index):\n    for workshop, recipes in env.world.cookbook.recipes.items():\n        if '_key' in recipes and item_index == recipes['_key']:\n            return workshop\n    return None\n\n  def find_nearest_workshop(env, workshop_type):\n      current_pos = env._current_state.pos\n      grid = env._current_state.grid\n      \n      # Find all locations of the specified type on the grid\n      locations = np.argwhere(grid[:, :, workshop_type] > 0)\n      \n      # Calculate distances from current position to each location\n      distances = np.array([abs(current_pos[0] - loc[0]) + abs(current_pos[1] - loc[1]) for loc in locations])\n      \n      # Find the nearest location\n      nearest_location_index = np.argmin(distances)\n      return tuple(locations[nearest_location_index])\n\n  def navigate_to(env, target_location):\n    current_pos = env._current_state.pos\n    \n    # Use A* algorithm to find path from current position to target location\n    def heuristic(a, b):\n        return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n    def a_star_search(start, goal):\n        open_set = collections.PriorityQueue()\n        open_set.put((0, start))\n        came_from = {}\n        cost_so_far = {}\n        came_from[start] = None\n        cost_so_far[start] = 0\n\n        while not open_set.empty():\n            _, current = open_set.get()\n\n            if current == goal:\n                break\n\n            for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                neighbor = (current[0] + dx, current[1] + dy)\n                new_cost = cost_so_far[current] + heuristic(current, neighbor)\n\n                if neighbor not in cost_so_far or new_cost < cost_so_far[neighbor]:\n                    cost_so_far[neighbor] = new_cost\n                    priority = new_cost + heuristic(goal, neighbor)\n                    open_set.put((priority, neighbor))\n                    came_from[neighbor] = current\n\n        return reconstruct_path(came_from, start, goal)\n\n    def reconstruct_path(came_from, start, goal):\n        current = goal\n        path = []\n        while current != start:\n            path.append(current)\n            current = came_from[current]\n        path.reverse()\n        return path\n\n    # Calculate the path to the target location\n    path_to_target = a_star_search(current_pos, target_location)\n\n    # Convert the path into actions (UP, DOWN, LEFT, RIGHT)\n    action_map = {(-1, 0): env.action_specs()['UP'], (1, 0): env.action_specs()['RIGHT'],\n                  (0, -1): env.action_specs()['DOWN'], (0, 1): env.action_specs()['LEFT']}\n    actions_to_target = []\n    for i in range(1, len(path_to_target)):\n        dx = path_to_target[i][0] - path_to_target[i-1][0]\n        dy = path_to_target[i][1] - path_to_target[i-1][1]\n        if (dx, dy) in action_map:\n            actions_to_target.append(action_map[(dx, dy)])\n    \n    return actions_to_target\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Find the workshop that allows crafting this item\n  workshop_index = get_workshop_for_item(item_index)\n\n  actions = []\n\n  if workshop_index is not None:\n      # Get the location of the nearest workshop of the required type\n      nearest_workshop_location = find_nearest_workshop(env, workshop_index)\n      \n      # Navigate to the workshop location\n      actions.extend(navigate_to(env, nearest_workshop_location))\n      \n      # Use the workshop to craft the item\n      actions.append(env.action_specs()['USE'])\n  \n  return actions", "island_id": 9, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T00:47:12.705079", "function_name": "craft", "function_body": "  def get_workshop_for_item(item_index):\n    for recipe in env.world.cookbook.recipes:\n        if '_key' in env.world.cookbook.recipes[recipe] and item_index == env.world.cookbook.recipes[recipe]['_key']:\n            return recipe\n    return None\n\n  def find_nearest_workshop(env, workshop_index):\n      current_pos = env._current_state.pos\n      \n      # Find the position of the specified workshop on the grid\n      workshop_positions = []\n      for y in range(env._current_state.grid.shape[0]):\n          for x in range(env._current_state.grid.shape[1]):\n              if env._current_state.grid[y, x, workshop_index] > 0:\n                  workshop_positions.append((x, y))\n      \n      # If no workshops are found on the grid, return None\n      if not workshop_positions:\n          return None\n      \n      # Calculate distances to all workshop positions and find the nearest one\n      def distance(pos1, pos2):\n          return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n      \n      nearest_workshop_location = min(workshop_positions, key=lambda wp: distance(current_pos, wp))\n      return nearest_workshop_location\n\n  def navigate_to(env, target_position):\n    current_pos = env._current_state.pos\n    path = a_star_search(current_pos, target_position)\n    \n    action_map = {(-1, 0): env.action_specs()['UP'], (1, 0): env.action_specs()['DOWN'],\n                  (0, -1): env.action_specs()['LEFT'], (0, 1): env.action_specs()['RIGHT']}\n    actions_to_target = []\n    for i in range(1, len(path)):\n        dx = path[i][0] - path[i-1][0]\n        dy = path[i][1] - path[i-1][1]\n        if (dx, dy) in action_map:\n            actions_to_target.append(action_map[(dx, dy)])\n    \n    return actions_to_target\n\n  item_index = env.world.cookbook.index[item]\n\n  # Find the workshop that allows crafting this item (if any)\n  workshop_index = get_workshop_for_item(item_index)\n\n  if workshop_index is None:\n      raise ValueError(f\"No workshop available for crafting {item}\")\n\n  # Get the location of the nearest workshop of the required type\n  nearest_workshop_location = find_nearest_workshop(env, workshop_index)\n\n  if nearest_workshop_location is None:\n      raise ValueError(f\"Workshop for {item} not found on the grid\")\n\n  # Navigate to the workshop location\n  actions_to_workshop = navigate_to(env, nearest_workshop_location)\n  \n  # Use the workshop to craft the item\n  actions_to_workshop.append(env.action_specs()['USE'])\n\n  return actions_to_workshop", "island_id": 9, "scores": {"": -1}}
{"timestamp": "2025-09-03T00:48:48.212735", "function_name": "craft", "function_body": "  def move_to_workshop(state, workshop_index):\n    actions = []\n    grid = state.grid\n    pos = state.pos\n    dir = state.dir\n    \n    # Find the nearest workshop cell index in the grid\n    workshop_cells = np.argwhere(grid[:, :, workshop_index] > 0)\n    \n    if len(workshop_cells) == 0:\n      raise ValueError(\"No workshops found for this item.\")\n    \n    closest_workshop = min(workshop_cells, key=lambda x: (x[0]-pos[0])**2 + (x[1]-pos[1])**2)\n    \n    # Calculate the path to the nearest workshop\n    path = astar(grid, pos, closest_workshop)\n    \n    for step in path:\n      if step == pos:\n        continue\n      \n      dx, dy = step[0] - pos[0], step[1] - pos[1]\n      \n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      elif dy > 0:\n          actions.append(0)  # DOWN\n      elif dy < 0:\n          actions.append(1)  # UP\n      \n      pos = step\n    \n    return actions\n\n  def astar(grid, start, goal):\n    open_set = collections.PriorityQueue()\n    open_set.put((0, start))\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, goal)}\n    \n    while not open_set.empty():\n        _, current = open_set.get()\n\n        if current == goal:\n            return reconstruct_path(came_from, current)\n        \n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            neighbor = (current[0] + dx, current[1] + dy)\n            \n            if not (0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]):\n                continue\n            \n            tentative_g_score = g_score[current] + 1\n            if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                came_from[neighbor] = current\n                g_score[neighbor] = tentative_g_score\n                f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                open_set.put((f_score[neighbor], neighbor))\n    \n    return []\n\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def reconstruct_path(came_from, current):\n      total_path = [current]\n      while current in came_from:\n          current = came_from[current]\n          total_path.append(current)\n      return list(reversed(total_path))\n  \n  actions = []\n  \n  # Get index for desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Assuming we have all ingredients in the inventory\n\n  # Identify required workshop based on recipe (if any)\n  recipe = env.world.cookbook.recipes.get(item_index)\n  if recipe:\n    _key = recipe.get(\"_key\")\n    if _key is not None:\n      workshop_name = f\"WORKSHOP{_key}\"\n      workshop_index = env.world.cookbook.index[workshop_name]\n      # Move to the workshop\n      actions.extend(move_to_workshop(env._current_state, workshop_index))\n  \n  # Craft the item by using USE action\n  actions.append(4)  # Use action\n  \n  return actions", "island_id": 0, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T00:48:49.300005", "function_name": "craft", "function_body": "  def move_to_workshop(state, workshop_index):\n    actions = []\n    grid = state.grid\n    pos = state.pos\n    dir = state.dir\n    n_kinds = state.world.cookbook.n_kinds\n    \n    # Find the nearest workshop cell index in the grid\n    workshop_cells = np.argwhere(grid[:, :, workshop_index] > 0)\n    \n    if len(workshop_cells) == 0:\n      raise ValueError(\"No workshops found for this item.\")\n    \n    closest_workshop = min(workshop_cells, key=lambda x: (x[0]-pos[0])**2 + (x[1]-pos[1])**2)\n    \n    # Calculate the path to the nearest workshop\n    path = astar(grid, pos, closest_workshop, n_kinds)\n    \n    for step in path:\n      if step == pos:\n        continue\n      \n      dx, dy = step[0] - pos[0], step[1] - pos[1]\n      \n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      elif dy > 0:\n          actions.append(0)  # DOWN\n      elif dy < 0:\n          actions.append(1)  # UP\n      \n      pos = step\n    \n    return actions\n\n  def astar(grid, start, goal, n_kinds):\n    open_set = collections.PriorityQueue()\n    open_set.put((0, start))\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, goal)}\n    \n    while not open_set.empty():\n        _, current = open_set.get()\n\n        if current == goal:\n            return reconstruct_path(came_from, current)\n        \n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            neighbor = (current[0] + dx, current[1] + dy)\n            \n            if not (0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]):\n                continue\n            \n            tentative_g_score = g_score[current] + 1\n            if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                came_from[neighbor] = current\n                g_score[neighbor] = tentative_g_score\n                f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                open_set.put((f_score[neighbor], neighbor))\n    \n    return []\n\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def reconstruct_path(came_from, current):\n      total_path = [current]\n      while current in came_from:\n          current = came_from[current]\n          total_path.append(current)\n      return list(reversed(total_path))\n  \n  actions = []\n  \n  # Get index for desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Assuming we have all ingredients in the inventory\n\n  # Identify required workshop based on recipe (if any)\n  recipe = env.world.cookbook.recipes.get(item_index)\n  if recipe:\n    _key = recipe.get(\"_key\")\n    if _key is not None:\n      workshop_name = f\"WORKSHOP{_key}\"\n      workshop_index = env.world.cookbook.index[workshop_name]\n      # Move to the workshop\n      actions.extend(move_to_workshop(env._current_state, workshop_index))\n  \n  # Craft the item by using USE action\n  actions.append(4)  # Use action\n  \n  return actions", "island_id": 0, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T00:51:12.724305", "function_name": "craft", "function_body": "  def get_closest_workshop(item_index):\n    \"\"\"Finds the closest workshop that can craft the specified item.\"\"\"\n    workshop_indices = []\n    for output_idx, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n        workshop_name = ingredients.get(\"_workshop\")\n        if workshop_name:\n          workshop_indices.append(env.world.cookbook.index[workshop_name])\n    \n    # If no specific workshop is needed, use a default one\n    if not workshop_indices:\n      return env.world.workshop_indices[0]  # Default to the first workshop type\n    \n    # Find the closest workshop in the grid\n    agent_pos = np.array(env._current_state.pos)\n    min_distance = float('inf')\n    closest_workshop_index = None\n    for workshop_index in workshop_indices:\n      for y in range(grid_shape[1]):\n        for x in range(grid_shape[0]):\n          if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n            target_pos = np.array((x, y))\n            distance = np.linalg.norm(agent_pos - target_pos)\n            if distance < min_distance:\n              min_distance = distance\n              closest_workshop_index = workshop_index\n    return closest_workshop_index\n\n  def path_to_target(start, target):\n    \"\"\"Computes the path from start position to target position using BFS for better efficiency.\"\"\"\n    queue = collections.deque([(start, [])])\n    visited = set()\n    while queue:\n      (x, y), actions = queue.popleft()\n      if (x, y) == tuple(target):\n        return actions\n      if (x, y) not in visited:\n        visited.add((x, y))\n        for dx, dy, action in [(-1, 0, 2), (1, 0, 3), (0, -1, 0), (0, 1, 1)]:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < grid_shape[0] and 0 <= ny < grid_shape[1]:\n            queue.append(((nx, ny), actions + [action]))\n    return []\n\n  def ensure_inventory(item_index):\n      \"\"\"Ensures the inventory has all required primitives for crafting.\"\"\"\n      actions = []\n      current_inventory = env._current_state.inventory.copy()\n      \n      # Get required primitives from the recipe\n      required_primitives = []\n      for output_idx, ingredients in env.world.cookbook.recipes.items():\n          if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n              required_primitives.extend([ingredient for ingredient in ingredients.keys() if ingredient != \"_key\"])\n      \n      # Collect each required primitive that is not already in the inventory\n      for primitive in required_primitives:\n          primitive_index = env.world.cookbook.index[primitive]\n          if current_inventory.get(primitive_index, 0) == 0:\n              collect_actions = collect(env, primitive)\n              actions.extend(collect_actions)\n              current_inventory[primitive_index] += 1\n      \n      return actions\n\n  def collect(env, primitive):\n    \"\"\"Collects the specified primitive by finding and moving to its location.\"\"\"\n    # Find all locations of the primitive in the grid\n    primitive_index = env.world.cookbook.index[primitive]\n    target_positions = []\n    for y in range(grid_shape[1]):\n        for x in range(grid_shape[0]):\n            if env._current_state.grid[x, y, primitive_index] > 0:\n                target_positions.append((x, y))\n    \n    # If no target positions are found, return an empty list of actions\n    if not target_positions:\n        return []\n    \n    # Sort target positions by distance to the agent's current position\n    agent_pos = np.array(env._current_state.pos)\n    target_positions.sort(key=lambda pos: np.linalg.norm(agent_pos - np.array(pos)))\n    \n    # Collect primitives from each target position in order of proximity\n    actions = []\n    for pos in target_positions:\n        actions.extend(path_to_target(agent_pos.tolist(), pos))\n        actions.append(4)  # USE to collect the primitive\n        agent_pos = np.array(pos)\n    \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n  grid_shape = env._current_state.grid.shape[:2]\n\n  # Ensure inventory has all required primitives\n  actions_to_collect_primitives = ensure_inventory(item_index)\n\n  # Find the closest workshop for crafting\n  workshop_index = get_closest_workshop(item_index)\n\n  # Find the position of the closest workshop in the grid\n  agent_pos = np.array(env._current_state.pos)\n  workshop_pos = None\n  min_distance = float('inf')\n  for y in range(grid_shape[1]):\n    for x in range(grid_shape[0]):\n      if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n        target_pos = np.array((x, y))\n        distance = np.linalg.norm(agent_pos - target_pos)\n        if distance < min_distance:\n          min_distance = distance\n          workshop_pos = (x, y)\n\n  # If no workshop position is found, return an empty list of actions\n  if workshop_pos is None:\n    return []\n\n  # Calculate the path to the closest workshop and perform the USE action\n  target_pos = np.array(workshop_pos)\n  actions_to_workshop = path_to_target(agent_pos.tolist(), target_pos.tolist())\n  actions_to_workshop.append(4)  # USE to craft the item\n\n  return actions_to_collect_primitives + actions_to_workshop", "island_id": 2, "scores": {"": 2.0}}
{"timestamp": "2025-09-03T00:51:13.798568", "function_name": "craft", "function_body": "  def get_closest_workshop(item_index):\n    \"\"\"Finds the closest workshop that can craft the specified item.\"\"\"\n    # Determine the workshop required based on the recipe key\n    workshop_indices = []\n    for output_idx, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n        workshop_name = ingredients.get(\"_workshop\")\n        if workshop_name:\n          workshop_indices.append(env.world.cookbook.index[workshop_name])\n    \n    # If no specific workshop is needed, use a default one\n    if not workshop_indices:\n      return env.world.workshop_indices[0]  # Default to the first workshop type\n    \n    # Find the closest workshop in the grid\n    agent_pos = np.array(env._current_state.pos)\n    min_distance = float('inf')\n    closest_workshop_index = None\n    for workshop_index in workshop_indices:\n      for y in range(grid_shape[1]):\n        for x in range(grid_shape[0]):\n          if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n            target_pos = np.array((x, y))\n            distance = np.linalg.norm(agent_pos - target_pos)\n            if distance < min_distance:\n              min_distance = distance\n              closest_workshop_index = workshop_index\n    return closest_workshop_index\n\n  def path_to_target(start, target):\n    \"\"\"Computes the path from start position to target position using BFS for better efficiency.\"\"\"\n    queue = collections.deque([(start, [])])\n    visited = set()\n    while queue:\n      (x, y), actions = queue.popleft()\n      if (x, y) == tuple(target):\n        return actions\n      if (x, y) not in visited:\n        visited.add((x, y))\n        for dx, dy, action in [(-1, 0, 2), (1, 0, 3), (0, -1, 0), (0, 1, 1)]:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < grid_shape[0] and 0 <= ny < grid_shape[1]:\n            queue.append(((nx, ny), actions + [action]))\n    return []\n\n  def ensure_inventory(item_index):\n      \"\"\"Ensures the inventory has all required primitives for crafting.\"\"\"\n      actions = []\n      current_inventory = env._current_state.inventory.copy()\n      \n      # Get required primitives from the recipe\n      required_primitives = []\n      for output_idx, ingredients in env.world.cookbook.recipes.items():\n          if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n              required_primitives.extend([ingredient for ingredient in ingredients.keys() if ingredient != \"_key\"])\n      \n      # Collect each required primitive that is not already in the inventory\n      for primitive in required_primitives:\n          primitive_index = env.world.cookbook.index[primitive]\n          if current_inventory.get(primitive_index, 0) == 0:\n              collect_actions = collect(env, primitive)\n              actions.extend(collect_actions)\n              current_inventory[primitive_index] += 1\n      \n      return actions\n\n  def collect(env, primitive):\n    \"\"\"Collects the specified primitive by finding and moving to its location.\"\"\"\n    # Find all locations of the primitive in the grid\n    primitive_index = env.world.cookbook.index[primitive]\n    target_positions = []\n    for y in range(grid_shape[1]):\n        for x in range(grid_shape[0]):\n            if env._current_state.grid[x, y, primitive_index] > 0:\n                target_positions.append((x, y))\n    \n    # Find the closest target position to collect\n    agent_pos = np.array(env._current_state.pos)\n    min_distance = float('inf')\n    closest_target = None\n    for pos in target_positions:\n        distance = np.linalg.norm(agent_pos - np.array(pos))\n        if distance < min_distance:\n            min_distance = distance\n            closest_target = pos\n    \n    # If no target position is found, return an empty list of actions\n    if closest_target is None:\n        return []\n    \n    # Calculate the path to the closest target and perform the USE action\n    actions_to_primitive = path_to_target(agent_pos.tolist(), closest_target)\n    actions_to_primitive.append(4)  # USE to collect the primitive\n    \n    return actions_to_primitive\n\n  item_index = env.world.cookbook.index[item]\n  grid_shape = env._current_state.grid.shape[:2]\n\n  # Ensure inventory has all required primitives\n  actions_to_collect_primitives = ensure_inventory(item_index)\n\n  # Find the closest workshop for crafting\n  workshop_index = get_closest_workshop(item_index)\n\n  # Find the position of the closest workshop in the grid\n  agent_pos = np.array(env._current_state.pos)\n  workshop_pos = None\n  min_distance = float('inf')\n  for y in range(grid_shape[1]):\n    for x in range(grid_shape[0]):\n      if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n        target_pos = np.array((x, y))\n        distance = np.linalg.norm(agent_pos - target_pos)\n        if distance < min_distance:\n          min_distance = distance\n          workshop_pos = (x, y)\n\n  # If no workshop position is found, return an empty list of actions\n  if workshop_pos is None:\n    return []\n\n  # Calculate the path to the closest workshop and perform the USE action\n  target_pos = np.array(workshop_pos)\n  actions_to_workshop = path_to_target(agent_pos.tolist(), target_pos.tolist())\n  actions_to_workshop.append(4)  # USE to craft the item\n\n  return actions_to_collect_primitives + actions_to_workshop", "island_id": 2, "scores": {"": 2.0}}
