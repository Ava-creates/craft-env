dy < 0:\n          actions.append(0)  # DOWN\n\n      current_pos = next_pos\n      \n    return actions\n\n  def collect_primitives(env, primitives):\n    actions = []\n    grid = env._current_state.grid\n    pos = env._current_state.pos\n    \n    for primitive in primitives:\n        primitive_index = env.world.cookbook.index[primitive]\n        \n        # Find positions of the primitive on the grid\n        primitive_positions = [(i, j) for i in range(grid.shape[0]) for j in range(grid.shape[1]) if grid[i, j, primitive_index] > 0]\n        \n        if not primitive_positions:\n            raise ValueError(f\"Primitive '{primitive}' not found on the grid.\")\n        \n        # Find the closest primitive\n        min_distance = float('inf')\n        closest_primitive_pos = None\n        for p in primitive_positions:\n            distance = abs(p[0] - pos[0]) + abs(p[1] - pos[1])\n            if distance < min_distance:\n                min_distance = distance\n                closest_primitive_pos = p\n        \n        # Move to the closest primitive\n        actions.extend(move_to(env, closest_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n    \n    return actions\n\n  def check_inventory(env, primitives):\n      inventory = env._current_state.inventory\n      return all(primitive in inventory and inventory[primitive] >= count for primitive, count in primitives.items())\n\n  item_index = env.world.cookbook.index[item]\n\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  recipe = env.world.cookbook.recipes[item_index]\n  required_primitives = {key: value for key, value in recipe.items() if key in env.world.cookbook.index}\n\n  # Check inventory before collecting primitives\n  if not check_inventory(env, required_primitives):\n      collect_actions = collect_primitives(env, required_primitives)\n  else:\n      collect_actions = []\n\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos, env.world.workshop_indices)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  move_actions = move_to(env, closest_workshop_pos)\n  \n  use_action = [env.world.n_actions - 1]  # Assuming the last action index corresponds to USE\n\n  return collect_actions + move_actions + use_action", "island_id": 5, "scores": {"": 4.7}}
{"timestamp": "2025-09-03T18:51:15.324296", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    # A* pathfinding algorithm for more efficient movement\n    open_set = collections.deque([current_pos])\n    came_from = {}\n    g_score = {current_pos: 0}\n    f_score = {current_pos: abs(target_pos[0] - current_pos[0]) + abs(target_pos[1] - target_pos[1])}\n\n    while open_set:\n      # Get the node with the lowest f_score\n      current = min(open_set, key=lambda x: f_score[x])\n      open_set.remove(current)\n      \n      if current == target_pos:\n        break\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        \n        # Ensure the neighbor is within grid bounds\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n            tentative_g_score = g_score[current] + 1\n            \n            if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                came_from[neighbor] = current\n                g_score[neighbor] = tentative_g_score\n                f_score[neighbor] = tentative_g_score + abs(target_pos[0] - neighbor[0]) + abs(target_pos[1] - neighbor[1])\n                if neighbor not in open_set:\n                    open_set.append(neighbor)\n\n    # Reconstruct path\n    total_path = []\n    while current in came_from:\n      total_path.append(current)\n      current = came_from[current]\n    total_path.reverse()\n\n    for next_pos in total_path:\n      dx = next_pos[0] - current_pos[0]\n      dy = next_pos[1] - current_pos[1]\n\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      elif dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n\n      current_pos = next_pos\n      \n    return actions\n\n  def collect_primitives(env, primitives):\n    \"\"\"Collects all required primitives for crafting the item.\"\"\"\n    actions = []\n    grid = env._current_state.grid\n    pos = env._current_state.pos\n    \n    for primitive in primitives:\n        primitive_index = env.world.cookbook.index[primitive]\n        \n        # Find positions of the primitive on the grid\n        primitive_positions = [(i, j) for i in range(grid.shape[0]) for j in range(grid.shape[1]) if grid[i, j, primitive_index] > 0]\n        \n        if not primitive_positions:\n            raise ValueError(f\"Primitive '{primitive}' not found on the grid.\")\n        \n        # Find the closest primitive\n        min_distance = float('inf')\n        closest_primitive_pos = None\n        for p in primitive_positions:\n            distance = abs(p[0] - pos[0]) + abs(p[1] - pos[1])\n            if distance < min_distance:\n                min_distance = distance\n                closest_primitive_pos = p\n        \n        # Move to the closest primitive\n        actions.extend(move_to(env, closest_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n    \n    return actions\n\n  def check_inventory(env, required_primitives):\n      \"\"\"Checks if all required primitives are in the inventory.\"\"\"\n      inventory = env._current_state.inventory\n      missing_primitives = []\n\n      for primitive_index, quantity_needed in required_primitives.items():\n          if primitive_index not in inventory or inventory[primitive_index] < quantity_needed:\n              missing_primitives.append((primitive_index, quantity_needed - (inventory.get(primitive_index, 0))))\n      \n      return missing_primitives\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Get required primitives for crafting the item with their quantities\n  recipe = env.world.cookbook.recipes[item_index]\n  required_primitives = {env.world.cookbook.index[primitive]: quantity for primitive, quantity in recipe.items() if primitive in env.world.cookbook.index}\n\n  # Check which primitives are missing or insufficient in quantity\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  missing_primitives = check_inventory(env, required_primitives)\n\n  collect_actions = []\n  \n  for primitive_index, quantity_needed in missing_primitives:\n      primitive_name = env.world.cookbook.index[primitive_index]\n      \n      # Find positions of the primitive on the grid\n      primitive_positions = [(i, j) for i in range(grid.shape[0]) for j in range(grid.shape[1]) if grid[i, j, primitive_index] > 0]\n      \n      if not primitive_positions:\n          raise ValueError(f\"Primitive '{primitive_name}' not found on the grid.\")\n      \n      # Move to and collect the required quantity of the primitive\n      for _ in range(quantity_needed):\n          # Find the closest primitive\n          min_distance = float('inf')\n          closest_primitive_pos = None\n          for p in primitive_positions:\n              distance = abs(p[0] - pos[0]) + abs(p[1] - pos[1])\n              if distance < min_distance:\n                  min_distance = distance\n                  closest_primitive_pos = p\n          \n          # Move to the closest primitive\n          collect_actions.extend(move_to(env, closest_primitive_pos))\n          \n          # Use the USE action to collect the primitive\n          collect_actions.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n          \n          # Update grid and position after collecting the primitive\n          pos = closest_primitive_pos\n          grid[closest_primitive_pos] -= 1\n\n  # Find the closest workshop\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  move_actions = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  use_action = [env.world.n_actions - 1]  # Assuming the last action index corresponds to USE\n\n  return collect_actions + move_actions + use_action", "island_id": 5, "scores": {"": 4.7}}
{"timestamp": "2025-09-03T18:51:16.390780", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    # A* pathfinding algorithm for more efficient movement\n    open_set = collections.deque([current_pos])\n    came_from = {}\n    g_score = {current_pos: 0}\n    f_score = {current_pos: abs(target_pos[0] - current_pos[0]) + abs(target_pos[1] - target_pos[1])}\n\n    while open_set:\n      # Get the node with the lowest f_score\n      current = min(open_set, key=lambda x: f_score[x])\n      open_set.remove(current)\n      \n      if current == target_pos:\n        break\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        \n        # Check if the neighbor is within grid bounds\n        if not (0 <= neighbor[0] < grid.shape[0]) or not (0 <= neighbor[1] < grid.shape[1]):\n            continue\n        \n        tentative_g_score = g_score[current] + 1\n        \n        if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n          came_from[neighbor] = current\n          g_score[neighbor] = tentative_g_score\n          f_score[neighbor] = tentative_g_score + abs(target_pos[0] - neighbor[0]) + abs(target_pos[1] - neighbor[1])\n          open_set.append(neighbor)\n\n    # Reconstruct path\n    total_path = []\n    while current in came_from:\n      total_path.append(current)\n      current = came_from[current]\n    total_path.reverse()\n\n    for next_pos in total_path:\n      dx = next_pos[0] - current_pos[0]\n      dy = next_pos[1] - current_pos[1]\n\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      elif dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n\n      current_pos = next_pos\n      \n    return actions\n\n  def collect_primitives(env, primitives):\n    \"\"\"Collects all required primitives for crafting the item.\"\"\"\n    actions = []\n    grid = env._current_state.grid\n    pos = env._current_state.pos\n    \n    for primitive in primitives:\n        primitive_index = env.world.cookbook.index[primitive]\n        \n        # Find positions of the primitive on the grid\n        primitive_positions = [(i, j) for i in range(grid.shape[0]) for j in range(grid.shape[1]) if grid[i, j, primitive_index] > 0]\n        \n        if not primitive_positions:\n            raise ValueError(f\"Primitive '{primitive}' not found on the grid.\")\n        \n        # Find the closest primitive\n        min_distance = float('inf')\n        closest_primitive_pos = None\n        for p in primitive_positions:\n            distance = abs(p[0] - pos[0]) + abs(p[1] - pos[1])\n            if distance < min_distance:\n                min_distance = distance\n                closest_primitive_pos = p\n        \n        # Move to the closest primitive\n        actions.extend(move_to(env, closest_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n    \n    return actions\n\n  def check_inventory_for_primitives(env, primitives):\n    \"\"\"Checks if all required primitives are in the inventory.\"\"\"\n    inventory = env._current_state.inventory\n    required_primitives = [env.world.cookbook.index[primitive] for primitive in primitives]\n    \n    missing_primitives = []\n    for primitive_index in required_primitives:\n        if inventory[primitive_index] < recipe.get(primitive_index, 0):\n            missing_primitives.append((primitive_index, recipe.get(primitive_index, 0) - inventory[primitive_index]))\n    \n    return missing_primitives\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Get required primitives and their quantities for crafting the item\n  recipe = env.world.cookbook.recipes[item_index]\n  required_primitives = [key for key, value in recipe.items() if key in env.world.cookbook.index]\n\n  # Check which primitives are missing from the inventory or require additional collection\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  \n  # Collect all required primitives that are not in the inventory\n  collect_actions = []\n  \n  # Check if we already have the required primitives in our inventory\n  missing_primitives = check_inventory_for_primitives(env, required_primitives)\n  \n  for primitive_index, quantity_needed in missing_primitives:\n      primitive_name = env.world.cookbook.index[primitive_index]\n      \n      # Find positions of the primitive on the grid\n      primitive_positions = [(i, j) for i in range(grid.shape[0]) for j in range(grid.shape[1]) if grid[i, j, primitive_index] > 0]\n      \n      if not primitive_positions:\n          raise ValueError(f\"Primitive '{primitive_name}' not found on the grid.\")\n      \n      # Collect the required quantity of primitives\n      while quantity_needed > 0:\n          # Find the closest primitive\n          min_distance = float('inf')\n          closest_primitive_pos = None\n          for p in primitive_positions:\n              distance = abs(p[0] - pos[0]) + abs(p[1] - pos[1])\n              if distance < min_distance:\n                  min_distance = distance\n                  closest_primitive_pos = p\n          \n          # Move to the closest primitive\n          collect_actions.extend(move_to(env, closest_primitive_pos))\n          \n          # Use the USE action to collect the primitive\n          collect_actions.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n          \n          # Update remaining quantity needed\n          quantity_needed -= 1\n  \n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  move_actions = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  use_action = [env.world.n_actions - 1]  # Assuming the last action index corresponds to USE\n\n  return collect_actions + move_actions + use_action", "island_id": 5, "scores": {"": 4.7}}
{"timestamp": "2025-09-03T18:52:45.778639", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Iterate over all positions in the grid to find the nearest workshop\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    # Calculate the direction to move\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    # Move horizontally first if needed\n    while dx != 0:\n      action = 3 if dx > 0 else 2  # RIGHT or LEFT\n      actions.append(action)\n      current_pos = (current_pos[0] + (dx // abs(dx)), current_pos[1])\n      dx -= (dx // abs(dx))\n\n    # Then move vertically if needed\n    while dy != 0:\n      action = 1 if dy > 0 else 0  # UP or DOWN\n      actions.append(action)\n      current_pos = (current_pos[0], current_pos[1] + (dy // abs(dy)))\n      dy -= (dy // abs(dy))\n      \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  # This step assumes that the recipe specifies the workshop type needed.\n  # Since the problem does not specify how to determine the workshop,\n  # we will assume that all workshops can craft any items for simplicity.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 9, "scores": {"": 4.7}}
