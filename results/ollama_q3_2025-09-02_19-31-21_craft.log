{"timestamp": "2025-09-02T20:45:46.905926", "function_name": "craft", "function_body": "  # Fetch the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Find all recipes that produce the desired item.\n  target_recipes = [recipe for recipe in env.world.cookbook.recipes.items() if \"_key\" in recipe[1] and recipe[1][\"_key\"] == item_index]\n  \n  # Check if any valid recipes are found\n  if not target_recipes:\n      return []\n  \n  # Find the nearest workshop that can produce the desired item.\n  min_distance = float('inf')\n  nearest_workshop_pos = None\n  \n  for output_idx, recipe in target_recipes:\n      required_ingredients = [i for i in recipe if i != \"_key\"]\n      available_workshops = env.world.cookbook.recipes[output_idx].get(\"workshop\", [])\n      \n      # Check if any workshop can produce the desired item\n      if not available_workshops:\n          continue\n      \n      for workshop_index in available_workshops:\n          workshop_positions = np.argwhere(env._current_state.grid[:, :, env.world.workshop_indices[workshop_index]] > 0)\n          \n          for pos in workshop_positions:\n              distance = np.linalg.norm(env._current_state.pos - pos, ord=1)\n              if distance < min_distance and all(env._current_state.inventory[i] >= recipe[i] for i in required_ingredients):\n                  min_distance = distance\n                  nearest_workshop_pos = tuple(pos)\n  \n  # If no workshop can produce the desired item with available ingredients, return an empty list.\n  if nearest_workshop_pos is None:\n      return []\n  \n  # Calculate the actions needed to move to the nearest workshop.\n  actions_to_workshop = calculate_actions_to_move(env._current_state.pos, nearest_workshop_pos)\n  \n  # Add the USE action to start crafting.\n  actions_to_workshop.append(env.action_specs()[\"USE\"])\n  \n  return actions_to_workshop", "island_id": 3, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T20:46:52.430147", "function_name": "craft", "function_body": "  def move_to_position(current_pos, target_pos):\n    delta_x = target_pos[0] - current_pos[0]\n    delta_y = target_pos[1] - current_pos[1]\n    \n    actions = []\n    \n    # Move in the x-direction\n    if delta_x > 0:\n        actions.extend([env.world.cookbook.index[\"RIGHT\"]] * delta_x)\n    elif delta_x < 0:\n        actions.extend([env.world.cookbook.index[\"LEFT\"]] * -delta_x)\n    \n    # Move in the y-direction\n    if delta_y > 0:\n        actions.extend([env.world.cookbook.index[\"DOWN\"]] * delta_y)\n    elif delta_y < 0:\n        actions.extend([env.world.cookbook.index[\"UP\"]] * -delta_y)\n    \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item has a recipe in the cookbook\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"No recipe found for {item}.\")\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes[item_index]\n  \n  actions = []\n\n  # Check if there is a specific workshop associated with this item (using \"_key\" as placeholder)\n  workshop_key = recipe.get(\"_key\", None)\n\n  # If there's no explicit workshop key, assume the first available workshop\n  workshop_indices = env.world.workshop_indices\n  if workshop_key:\n    workshop_index = env.world.cookbook.index[workshop_key]\n    workshop_indices = [workshop_index] if workshop_index in workshop_indices else workshop_indices\n\n  # Find a position next to any of the workshops where we can craft the item\n  for workshop_index in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index])\n      for pos in workshop_positions:\n          adjacent_cells = [(pos[0] + dx, pos[1] + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n          \n          # Check if any of the adjacent cells are free and reachable\n          for adj_pos in adjacent_cells:\n              if env._current_state.grid[adj_pos] == 0:  # Assuming 0 means an empty cell\n                  actions.extend(move_to_position(env._current_state.pos, adj_pos))\n                  actions.append(env.world.cookbook.index[\"USE\"])\n                  return actions\n\n  raise ValueError(f\"No reachable position found to craft {item}.\")", "island_id": 1, "scores": {"": -1}}
{"timestamp": "2025-09-02T20:46:53.550424", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n\n  # Check if the item has a recipe in the cookbook\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"No recipe found for {item}.\")\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes[item_index]\n  \n  # Assume we already have all required primitives in inventory to craft this.\n  actions = []\n\n  # Check if there is a specific workshop associated with this item (using \"_key\" as placeholder)\n  workshop_key = recipe.get(\"_key\", None)\n\n  # If there's no explicit workshop key, assume the first available workshop\n  workshop_indices = env.world.workshop_indices\n  if workshop_key:\n    workshop_index = env.world.cookbook.index[workshop_key]\n    workshop_indices = [workshop_index] if workshop_index in workshop_indices else workshop_indices\n\n  # Find a position next to any of the workshops where we can craft the item\n  for workshop_index in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index])\n      for pos in workshop_positions:\n          # Calculate the direction needed to face the workshop from the current position\n          delta_x, delta_y = pos[0] - env._current_state.pos[0], pos[1] - env._current_state.pos[1]\n          \n          # Consider adjacent cells (Manhattan distance 1)\n          if abs(delta_x) + abs(delta_y) == 1:\n              direction_actions = []\n              if delta_x > 0:\n                  direction_actions.append(env.world.cookbook.index[\"RIGHT\"])\n              elif delta_x < 0:\n                  direction_actions.append(env.world.cookbook.index[\"LEFT\"])\n              elif delta_y > 0:\n                  direction_actions.append(env.world.cookbook.index[\"DOWN\"])\n              elif delta_y < 0:\n                  direction_actions.append(env.world.cookbook.index[\"UP\"])\n\n              # Try to face the workshop\n              for action in direction_actions:\n                  env._current_state = env.step(action)[2]  # Update state after each step\n                  if env._current_state.next_to(workshop_index):\n                      actions.extend(direction_actions)\n                      actions.append(env.world.cookbook.index[\"USE\"])\n                      break\n\n              if actions:  # If we found a valid position, stop searching\n                  break\n\n      if actions:  # If we found a valid position, stop searching\n          break\n\n  return actions", "island_id": 1, "scores": {"": 0.0}}
