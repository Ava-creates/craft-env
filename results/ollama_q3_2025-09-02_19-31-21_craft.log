r\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 4, "scores": {"": 4.7}}
{"timestamp": "2025-09-03T04:42:35.968703", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if any(grid[i, j, w] > 0 for w in workshop_indices):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      # Determine the direction to move first based on distance\n      if abs(dx) > abs(dy):\n          # Move horizontally first\n          actions.extend([3] * dx if dx > 0 else [2] * -dx)\n          actions.extend([1] * dy if dy > 0 else [0] * -dy)\n      else:\n          # Move vertically first\n          actions.extend([1] * dy if dy > 0 else [0] * -dy)\n          actions.extend([3] * dx if dx > 0 else [2] * -dx)\n\n      current_pos = (current_pos[0] + dx, current_pos[1] + dy)\n      \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  # Since the problem does not specify how to determine the workshop,\n  # we will assume that all workshops can craft any items for simplicity.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 4, "scores": {"": 4.7}}
{"timestamp": "2025-09-03T04:43:01.849098", "function_name": "craft", "function_body": "  # Get the index for the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  if item_index in env.world.cookbook.primitives:\n    raise ValueError(f\"Cannot craft primitive item: {item}\")\n\n  # Find the workshop indices relevant to crafting the item\n  relevant_workshops = []\n  for i, recipe in enumerate(env.world.cookbook.recipes.values()):\n      if item_index in recipe.get(\"_key\", []):\n          relevant_workshops.append(i)\n\n  # If no workshops are relevant, raise an error\n  if not relevant_workshops:\n      raise ValueError(f\"No workshop found to craft the item: {item}\")\n\n  # Choose the first relevant workshop (we can improve this logic later)\n  workshop_index = relevant_workshops[0]\n\n  actions = find_path_to_workshop(env, workshop_index) + [craft.USE]\n  \n  return actions", "island_id": 9, "scores": {"": -1}}
{"timestamp": "2025-09-03T04:43:02.894147", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n  \n  # Check if the item is in the primitives set or not\n  if item_index in env.world.cookbook.primitives:\n    raise ValueError(f\"Cannot craft primitive item: {item}\")\n\n  # Find the workshop index for crafting the item\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Determine which workshop to go to based on the recipe rules\n  for i, workshop_index in enumerate(workshop_indices):\n    # Check if the workshop is involved in crafting the item\n    recipe = env.world.cookbook.recipes.get(item_index)\n    if recipe and any(ingredient_index == workshop_index for ingredient_index in recipe):\n      actions.extend(find_path_to_workshop(env, workshop_indices[i]))\n      actions.append(craft.USE)  # Use action to craft the item at the workshop\n\n  return actions", "island_id": 9, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T04:45:43.246283", "function_name": "craft", "function_body": "  def get_closest_workshop(item_index):\n    \"\"\"Finds the closest workshop that can craft the specified item.\"\"\"\n    workshop_indices = []\n    for output_idx, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n        workshop_name = ingredients.get(\"_workshop\")\n        if workshop_name:\n          workshop_indices.append(env.world.cookbook.index[workshop_name])\n    \n    # If no specific workshop is needed, use a default one\n    if not workshop_indices:\n      return env.world.workshop_indices[0]  # Default to the first workshop type\n    \n    # Find the closest workshop in the grid\n    agent_pos = np.array(env._current_state.pos)\n    min_distance = float('inf')\n    closest_workshop_index = None\n    for workshop_index in workshop_indices:\n      for y in range(grid_shape[1]):\n        for x in range(grid_shape[0]):\n          if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n            target_pos = np.array((x, y))\n            distance = np.linalg.norm(agent_pos - target_pos)\n            if distance < min_distance:\n              min_distance = distance\n              closest_workshop_index = workshop_index\n    return closest_workshop_index\n\n  def path_to_target(start, target):\n    \"\"\"Computes the path from start position to target position using BFS for better efficiency.\"\"\"\n    queue = collections.deque([(start, [])])\n    visited = set()\n    while queue:\n      (x, y), actions = queue.popleft()\n      if (x, y) == tuple(target):\n        return actions\n      if (x, y) not in visited:\n        visited.add((x, y))\n        for dx, dy, action in [(-1, 0, 2), (1, 0, 3), (0, -1, 0), (0, 1, 1)]:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < grid_shape[0] and 0 <= ny < grid_shape[1]:\n            queue.append(((nx, ny), actions + [action]))\n    return []\n\n  def ensure_inventory(item_index):\n      \"\"\"Ensures the inventory has all required primitives for crafting.\"\"\"\n      actions = []\n      current_inventory = env._current_state.inventory.copy()\n      \n      # Get required primitives from the recipe\n      required_primitives = []\n      for output_idx, ingredients in env.world.cookbook.recipes.items():\n          if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n              required_primitives.extend([ingredient for ingredient in ingredients.keys() if ingredient != \"_key\"])\n      \n      # Collect each required primitive that is not already in the inventory\n      for primitive in required_primitives:\n          primitive_index = env.world.cookbook.index[primitive]\n          if current_inventory.get(primitive_index, 0) == 0:\n              collect_actions = collect(env, primitive)\n              actions.extend(collect_actions)\n              current_inventory[primitive_index] += 1\n      \n      return actions\n\n  def collect(env, primitive):\n    \"\"\"Collects the specified primitive from the grid.\"\"\"\n    actions = []\n    primitive_index = env.world.cookbook.index[primitive]\n    agent_pos = np.array(env._current_state.pos)\n    \n    # Find all positions of the primitive in the grid\n    primitive_positions = []\n    for y in range(grid_shape[1]):\n        for x in range(grid_shape[0]):\n            if env._current_state.grid[x, y, primitive_index] > 0:  # Check if the primitive is present at this cell\n                primitive_positions.append((x, y))\n    \n    # If no positions found, return an empty list of actions\n    if not primitive_positions:\n        return []\n    \n    # Find the closest primitive to collect\n    min_distance = float('inf')\n    closest_primitive_pos = None\n    for pos in primitive_positions:\n        distance = np.linalg.norm(agent_pos - np.array(pos))\n        if distance < min_distance:\n            min_distance = distance\n            closest_primitive_pos = pos\n    \n    # Calculate the path to the closest primitive and perform the USE action\n    actions_to_primitive = path_to_target(agent_pos.tolist(), closest_primitive_pos)\n    actions.extend(actions_to_primitive)\n    actions.append(4)  # USE to collect the item\n    \n    return actions\n\n  def update_state(env, actions):\n      \"\"\"Simulates the environment state after executing a sequence of actions.\"\"\"\n      current_state = env._current_state.copy()\n      for action in actions:\n          if action < 4:  # Movement actions (LEFT, RIGHT, UP, DOWN)\n              dx, dy = [(-1, 0), (1, 0), (0, -1), (0, 1)][action]\n              new_x = current_state.pos[0] + dx\n              new_y = current_state.pos[1] + dy\n              if 0 <= new_x < grid_shape[0] and 0 <= new_y < grid_shape[1]:\n                  current_state.pos = (new_x, new_y)\n          elif action == 4:  # USE action\n              x, y = current_state.pos\n              for idx in range(len(current_state.grid[x, y])):\n                  if current_state.grid[x, y, idx] > 0:\n                      item_name = list(env.world.cookbook.index.keys())[list(env.world.cookbook.index.values()).index(idx)]\n                      if item_name in env.world.cookbook.primitives:\n                          current_state.inventory[idx] += 1\n                          current_state.grid[x, y, idx] -= 1\n                          break\n      return current_state\n\n  item_index = env.world.cookbook.index[item]\n  grid_shape = env._current_state.grid.shape[:2]\n\n  # Find the closest workshop for crafting\n  workshop_index = get_closest_workshop(item_index)\n\n  # Ensure inventory has all required primitives\n  actions_to_collect_primitives = ensure_inventory(item_index)\n  current_state = update_state(env, actions_to_collect_primitives)\n\n  # Find the position of the closest workshop in the grid\n  agent_pos = np.array(current_state.pos)\n  workshop_pos = None\n  min_distance = float('inf')\n  for y in range(grid_shape[1]):\n    for x in range(grid_shape[0]):\n      if current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n        target_pos = np.array((x, y))\n        distance = np.linalg.norm(agent_pos - target_pos)\n        if distance < min_distance:\n          min_distance = distance\n          workshop_pos = (x, y)\n\n  # If no workshop position is found, return an empty list of actions\n  if workshop_pos is None:\n    return []\n\n  # Calculate the path to the closest workshop and perform the USE action\n  target_pos = np.array(workshop_pos)\n  actions_to_workshop = path_to_target(agent_pos.tolist(), target_pos.tolist())\n  actions_to_workshop.append(4)  # USE to craft the item\n\n  return actions_to_collect_primitives + actions_to_workshop", "island_id": 2, "scores": {"": -1}}
{"timestamp": "2025-09-03T04:45:44.364226", "function_name": "craft", "function_body": "  def get_closest_workshop(item_index):\n    \"\"\"Finds the closest workshop that can craft the specified item.\"\"\"\n    workshop_indices = []\n    for output_idx, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n        workshop_name = ingredients.get(\"_workshop\")\n        if workshop_name:\n          workshop_indices.append(env.world.cookbook.index[workshop_name])\n    \n    # If no specific workshop is needed, use a default one\n    if not workshop_indices:\n      return env.world.workshop_indices[0]  # Default to the first workshop type\n    \n    # Find the closest workshop in the grid\n    agent_pos = np.array(env._current_state.pos)\n    min_distance = float('inf')\n    closest_workshop_index = None\n    for workshop_index in workshop_indices:\n      for y in range(grid_shape[1]):\n        for x in range(grid_shape[0]):\n          if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n            target_pos = np.array((x, y))\n            distance = np.linalg.norm(agent_pos - target_pos)\n            if distance < min_distance:\n              min_distance = distance\n              closest_workshop_index = workshop_index\n    return closest_workshop_index\n\n  def path_to_target(start, target):\n    \"\"\"Computes the path from start position to target position using BFS for better efficiency.\"\"\"\n    queue = collections.deque([(start, [])])\n    visited = set()\n    while queue:\n      (x, y), actions = queue.popleft()\n      if (x, y) == tuple(target):\n        return actions\n      if (x, y) not in visited:\n        visited.add((x, y))\n        for dx, dy, action in [(-1, 0, 2), (1, 0, 3), (0, -1, 0), (0, 1, 1)]:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < grid_shape[0] and 0 <= ny < grid_shape[1]:\n            queue.append(((nx, ny), actions + [action]))\n    return []\n\n  def ensure_inventory(item_index):\n      \"\"\"Ensures the inventory has all required primitives for crafting.\"\"\"\n      actions = []\n      current_inventory = env._current_state.inventory.copy()\n      \n      # Get required primitives from the recipe\n      required_primitives = []\n      for output_idx, ingredients in env.world.cookbook.recipes.items():\n          if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n              required_primitives.extend([ingredient for ingredient in ingredients.keys() if ingredient != \"_key\"])\n      \n      # Collect each required primitive that is not already in the inventory\n      for primitive in required_primitives:\n          primitive_index = env.world.cookbook.index[primitive]\n          if current_inventory.get(primitive_index, 0) == 0:\n              collect_actions = collect(env, primitive)\n              actions.extend(collect_actions)\n              current_inventory[primitive_index] += 1\n      \n      return actions\n\n  def collect(env, primitive):\n    \"\"\"Collects the specified primitive from the grid.\"\"\"\n    actions = []\n    primitive_index = env.world.cookbook.index[primitive]\n    agent_pos = np.array(env._current_state.pos)\n    \n    # Find all positions of the primitive in the grid\n    primitive_positions = []\n    for y in range(grid_shape[1]):\n        for x in range(grid_shape[0]):\n            if env._current_state.grid[x, y, primitive_index] > 0:\n                primitive_positions.append((x, y))\n    \n    # If no positions found, return an empty list of actions\n    if not primitive_positions:\n        return []\n    \n    # Find the closest primitive to collect\n    min_distance = float('inf')\n    closest_primitive_pos = None\n    for pos in primitive_positions:\n        distance = np.linalg.norm(agent_pos - np.array(pos))\n        if distance < min_distance:\n            min_distance = distance\n            closest_primitive_pos = pos\n    \n    # Calculate the path to the closest primitive and perform the USE action\n    actions_to_primitive = path_to_target(agent_pos.tolist(), closest_primitive_pos)\n    actions.extend(actions_to_primitive)\n    actions.append(4)  # USE to collect the item\n    \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n  grid_shape = env._current_state.grid.shape[:2]\n\n  # Ensure inventory has all required primitives\n  actions_to_collect_primitives = ensure_inventory(item_index)\n\n  # Find the closest workshop for crafting\n  workshop_index = get_closest_workshop(item_index)\n\n  # Find the position of the closest workshop in the grid\n  agent_pos = np.array(env._current_state.pos)\n  workshop_pos = None\n  min_distance = float('inf')\n  for y in range(grid_shape[1]):\n    for x in range(grid_shape[0]):\n      if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n        target_pos = np.array((x, y))\n        distance = np.linalg.norm(agent_pos - target_pos)\n        if distance < min_distance:\n          min_distance = distance\n          workshop_pos = (x, y)\n\n  # If no workshop position is found, return an empty list of actions\n  if workshop_pos is None:\n    return []\n\n  # Calculate the path to the closest workshop and perform the USE action\n  target_pos = np.array(workshop_pos)\n  actions_to_workshop = path_to_target(agent_pos.tolist(), target_pos.tolist())\n  actions_to_workshop.append(4)  # USE to craft the item\n\n  return actions_to_collect_primitives + actions_to_workshop", "island_id": 2, "scores": {"": 2.0}}
{"timestamp": "2025-09-03T04:47:12.169200", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n\n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      # Move horizontally first\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      \n      # Then move vertically\n      if dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n\n      current_pos = (current_pos[0] + (dx // abs(dx)) if dx != 0 else current_pos[0],\n                     current_pos[1] + (dy // abs(dy)) if dy != 0 else current_pos[1])\n      \n    return actions\n\n  def find_required_primitives(env, item_index):\n      \"\"\"Find the required primitives for crafting an item based on its recipe.\"\"\"\n      cookbook = env.world.cookbook\n      primitives = []\n\n      if item_index in cookbook.recipes:\n          recipe = cookbook.recipes[item_index]\n          for key, value in recipe.items():\n              if key in cookbook.primitives:\n                  primitives.append((key, value))\n      return primitives\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  required_primitives = find_required_primitives(env, item_index)\n\n  actions = []\n\n  # Check and collect required primitives\n  for primitive_name, amount in required_primitives:\n      if env._current_state.inventory.get(primitive_name, 0) < amount:\n          # Collect the primitive if not enough is available in inventory\n          actions.extend(collect_v1(env, primitive_name))\n      \n  # Determine which workshop is required for crafting this item\n  # This step assumes that the recipe specifies the workshop type needed.\n  # Since the problem does not specify how to determine the workshop,\n  # we will assume that all workshops can craft any items for simplicity.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions.extend(move_to(env, closest_workshop_pos))\n  \n  # Use the USE action to craft the item at the workshop\n  actions.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions", "island_id": 7, "scores": {"": -1}}
{"timestamp": "2025-09-03T04:52:12.274444", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    directions = [(0, -1), (-1, 0), (0, 1), (1, 0)]  # UP, LEFT, DOWN, RIGHT\n    direction_indices = [0, 2, 1, 3]  # Corresponding action indices\n\n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      for i, (dx_step, dy_step) in enumerate(directions):\n        if dx == dx_step and dy == dy_step:\n          actions.append(direction_indices[i])\n          current_pos = (current_pos[0] + dx_step, current_pos[1] + dy_step)\n          break\n\n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  # This step assumes that the recipe specifies the workshop type needed.\n  # Since the problem does not specify how to determine the workshop,\n  # we will assume that all workshops can craft any items for simplicity.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 7, "scores": {"": -1}}
{"timestamp": "2025-09-03T04:53:39.786193", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos, workshop_indices):\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      # Move horizontally first\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      \n      # Then move vertically\n      if dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n\n      current_pos = (current_pos[0] + (dx // abs(dx)) if dx != 0 else current_pos[0],\n                     current_pos[1] + (dy // abs(dy)) if dy != 0 else current_pos[1])\n      \n    return actions\n  \n  def get_workshop_for_item(item_index):\n      # Assuming that the recipe for an item specifies which workshop is needed\n      # For simplicity, let's assume there is a mapping from items to workshops in the cookbook\n      # Here we just use a placeholder. In reality, this would need to be extracted from the recipes.\n      return env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  workshop_index = get_workshop_for_item(item_index)\n\n  # Find the closest workshop of the required type\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos, [workshop_index])\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 7, "scores": {"": -1}}
{"timestamp": "2025-09-03T04:53:40.861057", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n\n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      # Move horizontally first\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      \n      # Then move vertically\n      if dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n\n      current_pos = (current_pos[0] + (dx // abs(dx)) if dx != 0 else current_pos[0],\n                     current_pos[1] + (dy // abs(dy)) if dy != 0 else current_pos[1])\n      \n    return actions\n  \n  def get_workshop_for_item(item_index):\n      # Assuming that the recipe for an item specifies which workshop is needed\n      # For simplicity, let's assume there is a mapping from items to workshops in the cookbook\n      # Here we just use a placeholder. In reality, this would need to be extracted from the recipes.\n      return env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  workshop_index = get_workshop_for_item(item_index)\n\n  # Find the closest workshop of the required type\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 7, "scores": {"": 4.7}}
{"timestamp": "2025-09-03T04:55:14.849178", "function_name": "craft", "function_body": "  def move_to_workshop(state, workshop_index):\n    actions = []\n    grid = state.grid\n    pos = state.pos\n    dir = state.dir\n    \n    # Find the nearest workshop cell index in the grid\n    workshop_cells = np.argwhere(grid[:, :, workshop_index] > 0)\n    \n    if len(workshop_cells) == 0:\n      raise ValueError(\"No workshops found for this item.\")\n    \n    closest_workshop = min(workshop_cells, key=lambda x: (x[0]-pos[0])**2 + (x[1]-pos[1])**2)\n    \n    # Calculate the path to the nearest workshop\n    path = astar(grid, pos, closest_workshop, state.world.cookbook.n_kinds)\n    \n    for step in path:\n      if step == pos:\n        continue\n      \n      dx, dy = step[0] - pos[0], step[1] - pos[1]\n      \n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      elif dy > 0:\n          actions.append(0)  # DOWN\n      elif dy < 0:\n          actions.append(1)  # UP\n      \n      pos = step\n    \n    return actions\n\n  def astar(grid, start, goal, n_kinds):\n    open_set = collections.PriorityQueue()\n    open_set.put((0, start))\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, goal)}\n    \n    while not open_set.empty():\n        _, current = open_set.get()\n\n        if current == goal:\n            return reconstruct_path(came_from, current)\n        \n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            neighbor = (current[0] + dx, current[1] + dy)\n            \n            if not (0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]):\n                continue\n            \n            tentative_g_score = g_score[current] + 1\n            if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                came_from[neighbor] = current\n                g_score[neighbor] = tentative_g_score\n                f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                open_set.put((f_score[neighbor], neighbor))\n    \n    return []\n\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def reconstruct_path(came_from, current):\n      total_path = [current]\n      while current in came_from:\n          current = came_from[current]\n          total_path.append(current)\n      return list(reversed(total_path))\n\n  actions = []\n  \n  # Get index for desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Identify required workshop based on recipe (if any)\n  recipe = env.world.cookbook.recipes.get(item_index)\n  if recipe:\n    _key = recipe.get(\"_key\")\n    if _key is not None:\n      workshop_name = f\"WORKSHOP{_key}\"\n      workshop_index = env.world.cookbook.index[workshop_name]\n      \n      # Move to the workshop\n      actions.extend(move_to_workshop(env._current_state, workshop_index))\n  \n  # Craft the item by using USE action\n  actions.append(4)  # Use action\n\n  return actions", "island_id": 0, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T04:55:15.918058", "function_name": "craft", "function_body": "  def move_to_workshop(state, workshop_index):\n    actions = []\n    grid = state.grid\n    pos = state.pos\n    dir = state.dir\n    \n    # Find the nearest workshop cell index in the grid\n    workshop_cells = np.argwhere(grid[:, :, workshop_index] > 0)\n    \n    if len(workshop_cells) == 0:\n      raise ValueError(\"No workshops found for this item.\")\n    \n    closest_workshop = min(workshop_cells, key=lambda x: (x[0]-pos[0])**2 + (x[1]-pos[1])**2)\n    \n    # Calculate the path to the nearest workshop\n    path = astar(grid, pos, closest_workshop, state.world.cookbook.n_kinds)\n    \n    for step in path:\n      if step == pos:\n        continue\n      \n      dx, dy = step[0] - pos[0], step[1] - pos[1]\n      \n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      elif dy > 0:\n          actions.append(0)  # DOWN\n      elif dy < 0:\n          actions.append(1)  # UP\n      \n      pos = step\n    \n    return actions\n\n  def astar(grid, start, goal, n_kinds):\n    open_set = collections.PriorityQueue()\n    open_set.put((0, start))\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, goal)}\n    \n    while not open_set.empty():\n        _, current = open_set.get()\n\n        if current == goal:\n            return reconstruct_path(came_from, current)\n        \n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            neighbor = (current[0] + dx, current[1] + dy)\n            \n            if not (0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]):\n                continue\n            \n            tentative_g_score = g_score[current] + 1\n            if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                came_from[neighbor] = current\n                g_score[neighbor] = tentative_g_score\n                f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                open_set.put((f_score[neighbor], neighbor))\n    \n    return []\n\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def reconstruct_path(came_from, current):\n      total_path = [current]\n      while current in came_from:\n          current = came_from[current]\n          total_path.append(current)\n      return list(reversed(total_path))\n\n  actions = []\n  \n  # Get index for desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Identify required workshop based on recipe (if any)\n  recipe = env.world.cookbook.recipes.get(item_index)\n  if recipe:\n    _key = recipe.get(\"_key\")\n    if _key is not None:\n      workshop_name = f\"WORKSHOP{_key}\"\n      workshop_index = env.world.cookbook.index[workshop_name]\n      \n      # Move to the workshop\n      actions.extend(move_to_workshop(env._current_state, workshop_index))\n  \n  # Craft the item by using USE action\n  actions.append(4)  # Use action\n  \n  return actions", "island_id": 0, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T04:57:04.313812", "function_name": "craft", "function_body": "  def move_to_position(current_pos: tuple, target_pos: tuple) -> list[int]:\n    \"\"\"Helper function to generate movement and turning actions to reach the target position.\"\"\"\n    queue = collections.deque([(current_pos, [], env._current_state.dir)])\n    visited = set()\n    \n    while queue:\n      pos, path, dir_ = queue.popleft()\n      \n      if pos == target_pos:\n        return path\n      \n      if (pos, dir_) in visited:\n        continue\n      \n      visited.add((pos, dir_))\n      \n      x, y = pos\n      directions = [(x + 1, y, 0), (x - 1, y, 1), (x, y + 1, 2), (x, y - 1, 3)]\n      \n      for nx, ny, dir_idx in directions:\n        if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n          if env._current_state.grid[nx, ny, 0] == 0:  # Assuming the first layer is walkable\n            turn_actions = turn_towards(dir_, dir_idx)\n            queue.append(((nx, ny), path + turn_actions + [dir_idx], dir_idx))\n    \n    return []  # If no path found, return an empty list\n\n  def calculate_direction_to_face(current_dir, target_pos, current_pos):\n      \"\"\"Helper function to determine the direction the agent should face.\"\"\"\n      x_diff = target_pos[0] - current_pos[0]\n      y_diff = target_pos[1] - current_pos[1]\n\n      if x_diff > 0:\n          return 3  # RIGHT\n      elif x_diff < 0:\n          return 2  # LEFT\n      elif y_diff > 0:\n          return 0  # DOWN\n      elif y_diff < 0:\n          return 1  # UP\n\n      return current_dir\n\n  def turn_towards(current_dir, target_dir):\n    \"\"\"Helper function to generate actions to turn the agent towards the target direction.\"\"\"\n    if current_dir == target_dir:\n        return []\n    \n    left_turns = [(0, 2), (1, 3), (2, 1), (3, 0)]\n    right_turns = [(0, 3), (1, 2), (2, 0), (3, 1)]\n\n    if (current_dir, target_dir) in left_turns:\n        return [2] * ((target_dir - current_dir) % 4)\n    elif (current_dir, target_dir) in right_turns:\n        return [3] * ((target_dir - current_dir) % 4)\n\n    return []\n\n  actions = []\n  \n  # Get the index of the desired item to be crafted\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n\n  if \"_key\" in recipe:\n      workshop_type = recipe[\"_key\"]\n\n      # Find the index of the corresponding workshop in the world configuration\n      workshop_indices = env.world.workshop_indices\n\n      selected_workshop_index = find_workshop(workshop_type, workshop_indices)\n      \n      if selected_workshop_index is not None:\n          # Determine the position of the selected workshop from the current state's grid\n          workshop_positions = np.argwhere(env._current_state.grid[:, :, selected_workshop_index] > 0)\n\n          if len(workshop_positions) > 0:\n              target_pos = tuple(workshop_positions[0])\n\n              # Move to the target position of the workshop\n              actions.extend(move_to_position(env._current_state.pos, target_pos))\n              \n              # Perform the USE action to start crafting\n              actions.append(4)  # USE action index\n  \n  return actions", "island_id": 3, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T04:57:05.364113", "function_name": "craft", "function_body": "  def move_to_position(current_pos: tuple, target_pos: tuple) -> list[int]:\n    \"\"\"Helper function to generate movement actions to reach the target position.\"\"\"\n    queue = collections.deque([(current_pos, [], env._current_state.dir)])\n    visited = set()\n    \n    while queue:\n      pos, path, dir_ = queue.popleft()\n      \n      if pos == target_pos:\n        return path\n      \n      if (pos, dir_) in visited:\n        continue\n      \n      visited.add((pos, dir_))\n      \n      x, y = pos\n      directions = [(x + 1, y, 0), (x - 1, y, 1), (x, y + 1, 2), (x, y - 1, 3)]\n      \n      for nx, ny, dir_idx in directions:\n        if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n          if env._current_state.grid[nx, ny, 0] == 0:  # Assuming the first layer is walkable\n            queue.append(((nx, ny), path + [dir_idx], dir_idx))\n    \n    return []  # If no path found, return an empty list\n\n  def calculate_direction_to_face(current_dir, target_pos, current_pos):\n      \"\"\"Helper function to determine the direction the agent should face.\"\"\"\n      x_diff = target_pos[0] - current_pos[0]\n      y_diff = target_pos[1] - current_pos[1]\n\n      if x_diff > 0:\n          return 3  # RIGHT\n      elif x_diff < 0:\n          return 2  # LEFT\n      elif y_diff > 0:\n          return 0  # DOWN\n      elif y_diff < 0:\n          return 1  # UP\n\n      return current_dir\n\n  def turn_towards(current_dir, target_dir):\n    \"\"\"Helper function to generate actions to turn the agent towards the target direction.\"\"\"\n    if current_dir == target_dir:\n        return []\n    \n    left_turns = [(0, 2), (1, 3), (2, 1), (3, 0)]\n    right_turns = [(0, 3), (1, 2), (2, 0), (3, 1)]\n\n    if (current_dir, target_dir) in left_turns:\n        return [2] * ((target_dir - current_dir) % 4)\n    elif (current_dir, target_dir) in right_turns:\n        return [3] * ((target_dir - current_dir) % 4)\n\n    return []\n\n  def find_workshop(workshop_type: str, workshop_indices: list[int]) -> int:\n      \"\"\"Helper function to find the index of the workshop type.\"\"\"\n      if workshop_type in [\"workshop_0\", \"workshop_1\", \"workshop_2\"]:\n          return workshop_indices[int(workshop_type.split(\"_\")[1])]\n      else:\n          raise ValueError(\"Unknown workshop type\")\n\n  actions = []\n  \n  # Get the index of the desired item to be crafted\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n\n  if \"_key\" in recipe:\n      workshop_type = recipe[\"_key\"]\n\n      # Find the index of the corresponding workshop in the world configuration\n      workshop_indices = env.world.workshop_indices\n\n      try:\n          selected_workshop_index = find_workshop(workshop_type, workshop_indices)\n          \n          # Determine the position of the selected workshop from the current state's grid\n          workshop_positions = np.argwhere(env._current_state.grid[:, :, selected_workshop_index] > 0)\n\n          if len(workshop_positions) > 0:\n              target_pos = tuple(workshop_positions[0])\n\n              # Move to the target position of the workshop\n              actions.extend(move_to_position(env._current_state.pos, target_pos))\n              \n              # Turn to face the workshop (simple direction check for now)\n              current_dir = env._current_state.dir\n              target_dir = calculate_direction_to_face(current_dir, target_pos, env._current_state.pos)\n              actions.extend(turn_towards(current_dir, target_dir))\n              \n              # Perform the USE action to start crafting\n              actions.append(4)  # USE action index\n\n      except ValueError as e:\n          print(f\"Error: {e}\")\n  \n  return actions", "island_id": 3, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T04:58:25.465269", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n\n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      # Move horizontally first if needed\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      \n      # Then move vertically if needed\n      if dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n\n      current_pos = (current_pos[0] + (dx // abs(dx)) if dx != 0 else current_pos[0],\n                     current_pos[1] + (dy // abs(dy)) if dy != 0 else current_pos[1])\n      \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  # This step assumes that the recipe specifies the workshop type needed.\n  # Since the problem does not specify how to determine the workshop,\n  # we will assume that all workshops can craft any items for simplicity.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 4, "scores": {"": 4.7}}
{"timestamp": "2025-09-03T04:58:26.536033", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n\n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      # Determine the direction to move\n      if abs(dx) > abs(dy):\n          step_x = np.sign(dx)\n          step_y = 0\n      else:\n          step_x = 0\n          step_y = np.sign(dy)\n\n      actions.append({\n        (0, 1): 1,  # UP\n        (0, -1): 0,  # DOWN\n        (1, 0): 3,  # RIGHT\n        (-1, 0): 2   # LEFT\n      }[(step_x, step_y)])\n\n      current_pos = (current_pos[0] + step_x, current_pos[1] + step_y)\n      \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  # This step assumes that the recipe specifies the workshop type needed.\n  # Since the problem does not specify how to determine the workshop,\n  # we will assume that all workshops can craft any items for simplicity.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 4, "scores": {"": 4.7}}
{"timestamp": "2025-09-03T05:00:09.771682", "function_name": "craft", "function_body": "  def move_to_position(current_pos, target_pos):\n    \"\"\"Helper function to generate movement actions to reach the target position.\"\"\"\n    x_diff = target_pos[0] - current_pos[0]\n    y_diff = target_pos[1] - current_pos[1]\n\n    # Generate LEFT/RIGHT movements\n    if x_diff < 0:\n      actions.extend([2] * abs(x_diff))  # LEFT\n    elif x_diff > 0:\n      actions.extend([3] * abs(x_diff))  # RIGHT\n\n    # Generate DOWN/UP movements\n    if y_diff < 0:\n      actions.extend([1] * abs(y_diff))  # UP\n    elif y_diff > 0:\n      actions.extend([0] * abs(y_diff))  # DOWN\n\n  def calculate_direction_to_face(current_pos, target_pos):\n    \"\"\"Helper function to determine the direction the agent needs to face.\"\"\"\n    x_diff = target_pos[0] - current_pos[0]\n    y_diff = target_pos[1] - current_pos[1]\n\n    if x_diff > 0:\n      return 3  # RIGHT\n    elif x_diff < 0:\n      return 2  # LEFT\n    elif y_diff > 0:\n      return 0  # DOWN\n    elif y_diff < 0:\n      return 1  # UP\n\n    return current_dir\n\n  def turn_towards(current_dir, target_dir):\n    \"\"\"Helper function to generate turn actions to face the target direction.\"\"\"\n    if current_dir == target_dir:\n      return []\n\n    diff = (target_dir - current_dir) % 4\n    \n    if diff == 1 or diff == 3:\n      actions.append(diff)\n    elif diff == 2:\n      actions.extend([0, 1])  # Turn 180 degrees (e.g., LEFT + UP)\n\n  def find_workshop(workshop_type, workshop_indices):\n    \"\"\"Helper function to determine the index of the workshop type needed.\"\"\"\n    if workshop_type in [\"workshop_0\", \"workshop_1\", \"workshop_2\"]:\n        return workshop_indices[int(workshop_type.split(\"_\")[1])]\n    else:\n        return None\n\n  def find_closest_workshop_position(target_index):\n      \"\"\"Helper function to find the closest workshop position given its index.\"\"\"\n      positions = np.argwhere(env._current_state.grid[:, :, target_index] > 0)\n      if len(positions) == 0:\n          return None\n      current_pos = env._current_state.pos\n      distances = [np.linalg.norm(pos - current_pos) for pos in positions]\n      closest_idx = np.argmin(distances)\n      return tuple(positions[closest_idx])\n\n  actions = []\n\n  # Get the index of the desired item to be crafted\n  item_index = env.world.cookbook.index[item]\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n\n  if \"_key\" in recipe:\n      workshop_type = recipe[\"_key\"]\n\n      # Find the index of the corresponding workshop in the world configuration\n      workshop_indices = env.world.workshop_indices\n\n      selected_workshop_index = find_workshop(workshop_type, workshop_indices)\n      \n      if selected_workshop_index is not None:\n          # Determine the closest position of the selected workshop from the current state's grid\n          target_pos = find_closest_workshop_position(selected_workshop_index)\n\n          if target_pos is not None:\n              # Move to the target position of the workshop\n              move_to_position(env._current_state.pos, target_pos)\n              \n              # Turn to face the workshop (simple direction check for now)\n              current_dir = env._current_state.dir\n              target_dir = calculate_direction_to_face(env._current_state.pos, target_pos)\n              turn_towards(current_dir, target_dir)\n              \n              # Perform the USE action to start crafting\n              actions.append(4)  # USE action index\n  \n  return actions", "island_id": 3, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T05:00:10.818088", "function_name": "craft", "function_body": "  def move_to_position(current_pos, target_pos):\n    \"\"\"Helper function to generate movement actions to reach the target position.\"\"\"\n    x_diff = target_pos[0] - current_pos[0]\n    y_diff = target_pos[1] - current_pos[1]\n\n    # Generate LEFT/RIGHT movements\n    if x_diff < 0:\n      actions.extend([2] * abs(x_diff))  # LEFT\n    elif x_diff > 0:\n      actions.extend([3] * abs(x_diff))  # RIGHT\n\n    # Generate DOWN/UP movements\n    if y_diff < 0:\n      actions.extend([1] * abs(y_diff))  # UP\n    elif y_diff > 0:\n      actions.extend([0] * abs(y_diff))  # DOWN\n\n  def calculate_direction_to_face(current_pos, target_pos):\n    \"\"\"Helper function to determine the direction the agent needs to face.\"\"\"\n    x_diff = target_pos[0] - current_pos[0]\n    y_diff = target_pos[1] - current_pos[1]\n\n    if x_diff > 0:\n      return 3  # RIGHT\n    elif x_diff < 0:\n      return 2  # LEFT\n    elif y_diff > 0:\n      return 0  # DOWN\n    elif y_diff < 0:\n      return 1  # UP\n\n    return current_dir\n\n  def turn_towards(current_dir, target_dir):\n    \"\"\"Helper function to generate turn actions to face the target direction.\"\"\"\n    if current_dir == target_dir:\n      return\n\n    diff = (target_dir - current_dir) % 4\n    \n    if diff == 1 or diff == 3:\n      actions.append(diff)\n    elif diff == 2:\n      actions.extend([0, 1])  # Turn 180 degrees (e.g., LEFT + UP)\n\n  def find_workshop(workshop_type, workshop_indices):\n    \"\"\"Helper function to determine the index of the workshop type needed.\"\"\"\n    if workshop_type in [\"workshop_0\", \"workshop_1\", \"workshop_2\"]:\n        return workshop_indices[int(workshop_type.split(\"_\")[1])]\n    else:\n        return None\n\n  def find_closest_workshop_position(target_index):\n      \"\"\"Helper function to find the closest workshop position given its index.\"\"\"\n      positions = np.argwhere(env._current_state.grid[:, :, target_index] > 0)\n      if len(positions) == 0:\n          return None\n      current_pos = env._current_state.pos\n      distances = [np.linalg.norm(pos - current_pos) for pos in positions]\n      closest_idx = np.argmin(distances)\n      return tuple(positions[closest_idx])\n\n  def check_and_move_to_workshop(workshop_type):\n    \"\"\"Helper function to find the closest workshop and move towards it.\"\"\"\n    selected_workshop_index = find_workshop(workshop_type, env.world.workshop_indices)\n    \n    if selected_workshop_index is not None:\n        target_pos = find_closest_workshop_position(selected_workshop_index)\n\n        if target_pos is not None:\n            # Move to the target position of the workshop\n            move_to_position(env._current_state.pos, target_pos)\n            \n            # Turn to face the workshop (simple direction check for now)\n            current_dir = env._current_state.dir\n            target_dir = calculate_direction_to_face(env._current_state.pos, target_pos)\n            turn_towards(current_dir, target_dir)\n\n  actions = []\n\n  # Get the index of the desired item to be crafted\n  item_index = env.world.cookbook.index[item]\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n\n  if \"_key\" in recipe:\n      workshop_type = recipe[\"_key\"]\n\n      # Check and move to the closest workshop of the required type\n      check_and_move_to_workshop(workshop_type)\n      \n      # Perform the USE action to start crafting\n      actions.append(4)  # USE action index\n  \n  return actions", "island_id": 3, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T05:02:17.784186", "function_name": "craft", "function_body": "  def get_closest_workshop(item_index):\n    \"\"\"Finds the closest workshop that can craft the specified item.\"\"\"\n    workshop_indices = []\n    for output_idx, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n        workshop_name = ingredients.get(\"_workshop\")\n        if workshop_name:\n          workshop_indices.append(env.world.cookbook.index[workshop_name])\n    \n    # If no specific workshop is needed, use a default one\n    if not workshop_indices:\n      return env.world.workshop_indices[0]  # Default to the first workshop type\n    \n    # Find the closest workshop in the grid\n    agent_pos = np.array(env._current_state.pos)\n    min_distance = float('inf')\n    closest_workshop_index = None\n    for workshop_index in workshop_indices:\n      for y in range(grid_shape[1]):\n        for x in range(grid_shape[0]):\n          if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n            target_pos = np.array((x, y))\n            distance = np.linalg.norm(agent_pos - target_pos)\n            if distance < min_distance:\n              min_distance = distance\n              closest_workshop_index = workshop_index\n    return closest_workshop_index\n\n  def path_to_target(start, target):\n    \"\"\"Computes the path from start position to target position using BFS for better efficiency.\"\"\"\n    queue = collections.deque([(start, [])])\n    visited = set()\n    while queue:\n      (x, y), actions = queue.popleft()\n      if (x, y) == tuple(target):\n        return actions\n      if (x, y) not in visited:\n        visited.add((x, y))\n        for dx, dy, action in [(-1, 0, 2), (1, 0, 3), (0, -1, 0), (0, 1, 1)]:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < grid_shape[0] and 0 <= ny < grid_shape[1]:\n            queue.append(((nx, ny), actions + [action]))\n    return []\n\n  def get_required_primitives(item_index):\n    \"\"\"Retrieves the list of required primitives for crafting an item.\"\"\"\n    for output_idx, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n        return [primitive for primitive in ingredients.keys() if primitive != \"_key\" and primitive != \"_workshop\"]\n    return []\n\n  def collect(env, primitive):\n    \"\"\"Collects the required primitives from the environment.\"\"\"\n    primitive_index = env.world.cookbook.index[primitive]\n    agent_pos = np.array(env._current_state.pos)\n    \n    # Find positions of the resource in the grid\n    resource_positions = []\n    for y in range(grid_shape[1]):\n      for x in range(grid_shape[0]):\n        if env._current_state.grid[x, y, primitive_index] > 0:\n          resource_positions.append((x, y))\n    \n    actions = []\n    for position in resource_positions:\n      path_actions = path_to_target(agent_pos.tolist(), list(position))\n      actions.extend(path_actions)\n      actions.append(4)  # USE to collect the item\n      agent_pos = np.array(position)  # Update the agent's position\n    \n    return actions\n\n  def ensure_inventory(item_index, required_primitives):\n    \"\"\"Ensures the inventory has all required primitives for crafting.\"\"\"\n    actions = []\n    current_inventory = env._current_state.inventory.copy()\n    \n    for primitive in required_primitives:\n      if current_inventory.get(primitive, 0) == 0:\n        collect_actions = collect(env, primitive)\n        actions.extend(collect_actions)\n        current_inventory[primitive] += 1\n    \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n  grid_shape = env._current_state.grid.shape[:2]\n\n  # Get required primitives from the recipe\n  required_primitives = get_required_primitives(item_index)\n\n  # Ensure inventory has all required primitives\n  actions_to_collect_primitives = ensure_inventory(item_index, required_primitives)\n\n  # Find the closest workshop for crafting\n  workshop_index = get_closest_workshop(item_index)\n\n  # Find the position of the closest workshop in the grid\n  agent_pos = np.array(env._current_state.pos)\n  workshop_pos = None\n  min_distance = float('inf')\n  for y in range(grid_shape[1]):\n    for x in range(grid_shape[0]):\n      if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n        target_pos = np.array((x, y))\n        distance = np.linalg.norm(agent_pos - target_pos)\n        if distance < min_distance:\n          min_distance = distance\n          workshop_pos = (x, y)\n\n  # If no workshop position is found, return an empty list of actions\n  if workshop_pos is None:\n    return []\n\n  # Calculate the path to the closest workshop and perform the USE action\n  target_pos = np.array(workshop_pos)\n  actions_to_workshop = path_to_target(agent_pos.tolist(), target_pos.tolist())\n  actions_to_workshop.append(4)  # USE to craft the item\n\n  return actions_to_collect_primitives + actions_to_workshop", "island_id": 2, "scores": {"": 2.0}}
