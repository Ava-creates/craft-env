{"timestamp": "2025-09-03T03:10:01.281026", "function_name": "craft", "function_body": "  def move_to(pos):\n    \"\"\"Helper function to generate actions to move an agent to a target position.\"\"\"\n    current_pos = env._current_state.pos\n    dx = pos[0] - current_pos[0]\n    dy = pos[1] - current_pos[1]\n\n    actions = []\n    if dx < 0:\n      actions.extend([env.action_specs()['LEFT']] * abs(dx))\n    elif dx > 0:\n      actions.extend([env.action_specs()['RIGHT']] * abs(dx))\n\n    if dy < 0:\n      actions.extend([env.action_specs()['UP']] * abs(dy))\n    elif dy > 0:\n      actions.extend([env.action_specs()['DOWN']] * abs(dy))\n\n    return actions\n\n  item_idx = env.world.cookbook.index[item]\n\n  # Determine if the item requires a specific workshop based on its recipe\n  recipe = env.world.cookbook.recipes.get(item_idx, {})\n  workshop_key = recipe.get('_key')\n\n  if workshop_key:\n      workshop_idx = env.world.cookbook.index[workshop_key]\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx] > 0)\n      \n      if len(workshop_positions) == 0:\n          return []  # No workshops found, cannot craft\n\n      # Determine the nearest workshop based on Manhattan distance\n      current_pos = env._current_state.pos\n      distances = [abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1]) for pos in workshop_positions]\n      nearest_workshop_idx = np.argmin(distances)\n      nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_idx])\n\n      # Generate actions to move to the nearest workshop\n      actions_to_workshop = move_to(nearest_workshop_pos)\n  else:\n      actions_to_workshop = []\n\n  # Use action to craft the item\n  use_action_index = env.action_specs()['USE']\n\n  return actions_to_workshop + [use_action_index]", "island_id": 4, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T03:10:02.293441", "function_name": "craft", "function_body": "  # Get the index of the item to be crafted\n  item_idx = env.world.cookbook.index[item]\n\n  # Retrieve the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_idx)\n\n  if not recipe:\n      raise ValueError(f\"No recipe found for {item}\")\n\n  # Determine if a specific workshop is required for crafting this item\n  workshop_key = recipe.get('_key')\n  \n  # Get the index of the workshop if it's specified in the recipe\n  if workshop_key:\n      workshop_idx = env.world.cookbook.index[workshop_key]\n  else:\n      workshop_idx = None\n\n  # Initialize a list to store actions\n  actions = []\n\n  # Check if all required ingredients are available in the inventory\n  required_ingredients = {k: v for k, v in recipe.items() if k != '_key'}\n  inventory_counts = env._current_state.inventory\n  missing_ingredients = [ingredient for ingredient, count in required_ingredients.items()\n                         if inventory_counts[ingredient] < count]\n\n  # Collect missing ingredients if any\n  for primitive_idx in missing_ingredients:\n      primitive_name = env.world.cookbook.index.get(primitive_idx, \"unknown\")\n      actions.extend(collect(env, primitive_name))\n\n  # Find all positions of the nearest workshop in the grid, if needed\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx] > 0) if workshop_idx is not None else []\n\n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No available workshops found for crafting {item}\")\n\n  # Determine the nearest workshop based on Manhattan distance\n  current_pos = env._current_state.pos\n  distances = [abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1]) for pos in workshop_positions]\n  nearest_workshop_idx = np.argmin(distances)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_idx])\n\n  # Calculate the actions needed to move to the nearest workshop\n  while env._current_state.pos != nearest_workshop_pos:\n      dx = nearest_workshop_pos[0] - env._current_state.pos[0]\n      dy = nearest_workshop_pos[1] - env._current_state.pos[1]\n\n      if dx < 0:\n          actions.append(env.action_specs()['LEFT'])\n      elif dx > 0:\n          actions.append(env.action_specs()['RIGHT'])\n      else:\n          if dy < 0:\n              actions.append(env.action_specs()['UP'])\n          elif dy > 0:\n              actions.append(env.action_specs()['DOWN'])\n\n      # Step the environment with the calculated action\n      _, _, _ = env.step(actions[-1])\n\n  # Perform the USE action to craft the item at the workshop\n  actions.append(env.action_specs()['USE'])\n\n  return actions", "island_id": 4, "scores": {"": -1}}
{"timestamp": "2025-09-03T03:12:16.609238", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    # A* pathfinding algorithm for more efficient movement\n    open_set = collections.deque([current_pos])\n    came_from = {}\n    g_score = {current_pos: 0}\n    f_score = {current_pos: abs(target_pos[0] - current_pos[0]) + abs(target_pos[1] - current_pos[1])}\n\n    while open_set:\n      current = open_set.popleft()\n      \n      if current == target_pos:\n        break\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        \n        tentative_g_score = g_score[current] + 1\n        \n        if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n          came_from[neighbor] = current\n          g_score[neighbor] = tentative_g_score\n          f_score[neighbor] = tentative_g_score + abs(target_pos[0] - neighbor[0]) + abs(target_pos[1] - neighbor[1])\n          open_set.append(neighbor)\n\n    # Reconstruct path\n    total_path = []\n    while current in came_from:\n      total_path.append(current)\n      current = came_from[current]\n    total_path.reverse()\n\n    for next_pos in total_path:\n      dx = next_pos[0] - current_pos[0]\n      dy = next_pos[1] - current_pos[1]\n\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      elif dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n\n      current_pos = next_pos\n      \n    return actions\n\n  def collect_primitives(env, primitives):\n    actions = []\n    for primitive in primitives:\n      grid = env._current_state.grid\n      pos = env._current_state.pos\n      primitive_index = env.world.cookbook.index[primitive]\n      \n      # Find all positions of the required primitive on the grid\n      primitive_positions = [(i, j) for i in range(grid.shape[0]) for j in range(grid.shape[1]) if grid[i, j, primitive_index] > 0]\n\n      if not primitive_positions:\n        raise ValueError(f\"Required primitive '{primitive}' not found on the grid.\")\n\n      # Find the closest primitive to collect\n      min_distance = float('inf')\n      closest_primitive_pos = None\n      for p in primitive_positions:\n          distance = abs(p[0] - pos[0]) + abs(p[1] - pos[1])\n          if distance < min_distance:\n              min_distance = distance\n              closest_primitive_pos = p\n      \n      # Move to the closest primitive and collect it\n      actions.extend(move_to(env, closest_primitive_pos))\n      actions.append(env.world.n_actions - 2)  # Assuming the second last action index corresponds to COLLECT\n\n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  # This step assumes that the recipe specifies the workshop type needed.\n  # Since the problem does not specify how to determine the workshop,\n  # we will assume that all workshops can craft any items for simplicity.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Find the primitives required to craft the item\n  recipe = env.world.cookbook.recipes[item_index]\n  primitives = [env.world.cookbook.index.inverse[i] for i in recipe if i in env.world.cookbook.index]\n\n  # Collect all required primitives\n  actions_to_collect_primitives = collect_primitives(env, primitives)\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_collect_primitives + actions_to_workshop", "island_id": 6, "scores": {"": 4.7}}
{"timestamp": "2025-09-03T03:12:17.574363", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if any(grid[i, j, w] > 0 for w in workshop_indices):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    open_set = collections.deque([current_pos])\n    came_from = {}\n    g_score = {current_pos: 0}\n    f_score = {current_pos: abs(target_pos[0] - current_pos[0]) + abs(target_pos[1] - current_pos[1])}\n\n    while open_set:\n      current = open_set.popleft()\n      \n      if current == target_pos:\n        break\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        \n        tentative_g_score = g_score[current] + 1\n        \n        if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n          came_from[neighbor] = current\n          g_score[neighbor] = tentative_g_score\n          f_score[neighbor] = tentative_g_score + abs(target_pos[0] - neighbor[0]) + abs(target_pos[1] - neighbor[1])\n          open_set.append(neighbor)\n\n    total_path = []\n    while current in came_from:\n      total_path.append(current)\n      current = came_from[current]\n    total_path.reverse()\n\n    for next_pos in total_path:\n      dx = next_pos[0] - current_pos[0]\n      dy = next_pos[1] - current_pos[1]\n\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      elif dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n\n      current_pos = next_pos\n      \n    return actions\n  \n  def collect_primitives(env, primitives):\n    collected_actions = []\n    for primitive in primitives:\n      grid = env._current_state.grid\n      pos = env._current_state.pos\n      primitive_index = env.world.cookbook.index[primitive]\n      \n      # Find the closest primitive location\n      min_distance = float('inf')\n      closest_primitive_pos = None\n      for i in range(grid.shape[0]):\n        for j in range(grid.shape[1]):\n          if grid[i, j, primitive_index] > 0:\n            distance = abs(i - pos[0]) + abs(j - pos[1])\n            if distance < min_distance:\n              min_distance = distance\n              closest_primitive_pos = (i, j)\n      \n      if not closest_primitive_pos:\n        raise ValueError(f\"No available '{primitive}' found on the grid.\")\n      \n      # Move to the closest primitive location\n      actions_to_primitive = move_to(env, closest_primitive_pos)\n      collected_actions.extend(actions_to_primitive)\n      \n      # Use the USE action to collect the primitive\n      collected_actions.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n    \n    return collected_actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which primitives are required for crafting this item\n  required_primitives = []\n  for ingredient, count in env.world.cookbook.recipes[item_index].items():\n      if ingredient not in env._current_state.inventory:\n          required_primitives.extend([ingredient] * count)\n\n  # Collect the required primitives\n  collect_actions = collect_primitives(env, required_primitives)\n  \n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n  \n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return collect_actions + actions_to_workshop", "island_id": 6, "scores": {"": -1}}
{"timestamp": "2025-09-03T03:13:56.077453", "function_name": "craft", "function_body": "  def move_to_workshop(state, workshop_index):\n    actions = []\n    grid = state.grid\n    pos = state.pos\n    dir = state.dir\n    \n    # Find the nearest workshop cell index in the grid\n    workshop_cells = np.argwhere(grid[:, :, workshop_index] > 0)\n    \n    if len(workshop_cells) == 0:\n      raise ValueError(\"No workshops found for this item.\")\n    \n    closest_workshop = min(workshop_cells, key=lambda x: (x[0]-pos[0])**2 + (x[1]-pos[1])**2)\n    \n    # Calculate the path to the nearest workshop\n    path = astar(grid, pos, closest_workshop)\n    \n    for step in path:\n      if step == pos:\n        continue\n      \n      dx, dy = step[0] - pos[0], step[1] - pos[1]\n      \n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      elif dy > 0:\n          actions.append(0)  # DOWN\n      elif dy < 0:\n          actions.append(1)  # UP\n      \n      pos = step\n    \n    return actions\n\n  def astar(grid, start, goal):\n    open_set = collections.PriorityQueue()\n    open_set.put((0, start))\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, goal)}\n    \n    while not open_set.empty():\n        _, current = open_set.get()\n\n        if current == goal:\n            return reconstruct_path(came_from, current)\n        \n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            neighbor = (current[0] + dx, current[1] + dy)\n            \n            if not (0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]):\n                continue\n            \n            tentative_g_score = g_score[current] + 1\n            if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                came_from[neighbor] = current\n                g_score[neighbor] = tentative_g_score\n                f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                open_set.put((f_score[neighbor], neighbor))\n    \n    return []\n\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def reconstruct_path(came_from, current):\n      total_path = [current]\n      while current in came_from:\n          current = came_from[current]\n          total_path.append(current)\n      return list(reversed(total_path))\n  \n  actions = []\n  \n  # Get index for desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Assuming we have all ingredients in the inventory\n\n  # Identify required workshop based on recipe (if any)\n  recipe = env.world.cookbook.recipes.get(item_index)\n  if recipe:\n    _key = recipe.get(\"_key\")\n    if _key is not None:\n      workshop_name = f\"WORKSHOP{_key}\"\n      workshop_index = env.world.cookbook.index[workshop_name]\n      # Move to the workshop\n      actions.extend(move_to_workshop(env._current_state, workshop_index))\n  \n  # Craft the item by using USE action\n  actions.append(4)  # Use action\n  \n  return actions", "island_id": 0, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T03:13:57.118432", "function_name": "craft", "function_body": "  def move_to_workshop(state, workshop_index):\n    actions = []\n    grid = state.grid\n    pos = state.pos\n    dir = state.dir\n    \n    # Find the nearest workshop cell index in the grid\n    workshop_cells = np.argwhere(grid[:, :, workshop_index] > 0)\n    \n    if len(workshop_cells) == 0:\n      raise ValueError(\"No workshops found for this item.\")\n    \n    closest_workshop = min(workshop_cells, key=lambda x: (x[0]-pos[0])**2 + (x[1]-pos[1])**2)\n    \n    # Calculate the path to the nearest workshop\n    path = astar(grid, pos, closest_workshop)\n    \n    for step in path:\n      if step == pos:\n        continue\n      \n      dx, dy = step[0] - pos[0], step[1] - pos[1]\n      \n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      elif dy > 0:\n          actions.append(0)  # DOWN\n      elif dy < 0:\n          actions.append(1)  # UP\n      \n      pos = step\n    \n    return actions\n\n  def astar(grid, start, goal):\n    open_set = collections.PriorityQueue()\n    open_set.put((0, start))\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, goal)}\n    \n    while not open_set.empty():\n        _, current = open_set.get()\n\n        if current == goal:\n            return reconstruct_path(came_from, current)\n        \n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            neighbor = (current[0] + dx, current[1] + dy)\n            \n            if not (0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]):\n                continue\n            \n            tentative_g_score = g_score[current] + 1\n            if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                came_from[neighbor] = current\n                g_score[neighbor] = tentative_g_score\n                f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                open_set.put((f_score[neighbor], neighbor))\n    \n    return []\n\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def reconstruct_path(came_from, current):\n      total_path = [current]\n      while current in came_from:\n          current = came_from[current]\n          total_path.append(current)\n      return list(reversed(total_path))\n  \n  actions = []\n  \n  # Get index for desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Assuming we have all ingredients in the inventory\n\n  # Identify required workshop based on recipe (if any)\n  recipe = env.world.cookbook.recipes.get(item_index)\n  if recipe:\n    _key = recipe.get(\"_key\")\n    if _key is not None:\n      workshop_name = f\"WORKSHOP{_key}\"\n      workshop_index = env.world.cookbook.index[workshop_name]\n      \n      # Check if the agent is already at a workshop\n      current_workshop_cells = np.argwhere(grid[:, :, workshop_index] > 0)\n      for cell in current_workshop_cells:\n          if tuple(state.pos) == tuple(cell):\n              break\n      else:\n          # Move to the workshop\n          actions.extend(move_to_workshop(env._current_state, workshop_index))\n  \n  # Craft the item by using USE action\n  actions.append(4)  # Use action\n  \n  return actions", "island_id": 0, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T03:14:22.913017", "function_name": "craft", "function_body": "  current_state = env._current_state\n\n  # Get the index of the desired item from the cookbook index\n  item_index = env.world.cookbook.index[item]\n\n  # Find the workshop index for crafting the item\n  workshop_index = None\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n  if \"_key\" in recipe:\n      key_workshop = recipe[\"_key\"]\n      workshop_index = env.world.workshop_indices[key_workshop]\n  \n  # Move to the found workshop\n  if workshop_index is not None:\n      target_pos = find_position_of_kind(env, workshop_index)\n      actions.extend(move_to_position(current_state.pos, target_pos))\n      \n      # Perform the USE action to craft the item\n      actions.append(craft.USE)\n\n  return actions", "island_id": 8, "scores": {"": -1}}
{"timestamp": "2025-09-03T03:14:24.052287", "function_name": "craft", "function_body": "  actions = []\n  current_state = env._current_state\n\n  # Get the index of the desired item from the cookbook index\n  item_index = env.world.cookbook.index[item]\n\n  # Find the workshop index for crafting the item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n  if \"_key\" in recipe:\n      key_workshop = recipe[\"_key\"]\n      workshop_index = env.world.workshop_indices[key_workshop]\n  \n      # Check if we are already next to a workshop of the required kind\n      if current_state.next_to(workshop_index):\n          actions.append(craft.USE)\n      else:\n          target_pos = find_position_of_kind(env, workshop_index)\n          \n          if target_pos is not None:\n              actions.extend(move_to_position(current_state.pos, target_pos))\n              \n              # Perform the USE action to craft the item\n              actions.append(craft.USE)\n\n  return actions", "island_id": 8, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T03:16:21.529849", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n  \n  def get_workshop_for_item(item_index):\n      for workshop_type_index in env.world.workshop_indices:\n          recipes = env.world.cookbook.recipes.get(workshop_type_index, {})\n          if '_key' in recipes and item_index == recipes['_key']:\n              return workshop_type_index\n      return None\n\n  def find_nearest_workshop(env, workshop_type_index):\n      current_pos = env._current_state.pos\n      \n      # Filter out workshops that are actually present on the grid\n      actual_workshops = [(x, y) for y in range(env._current_state.grid.shape[0])\n                          for x in range(env._current_state.grid.shape[1])\n                          if env._current_state.grid[y, x, workshop_type_index] > 0]\n      \n      if not actual_workshops:\n          return None\n      \n      nearest_workshop_location = min(actual_workshops, key=lambda loc: np.linalg.norm(np.array(loc) - np.array(current_pos)))\n      \n      return nearest_workshop_location\n\n  def navigate_to(grid, start_pos, end_pos):\n      path = find_path_a_star(grid, start_pos, end_pos)\n      actions = []\n      for next_step in path:\n          direction = get_direction(start_pos, next_step)\n          actions.append(env.action_specs()[direction])\n          start_pos = next_step\n      return actions\n\n  def find_path_a_star(grid, start, end):\n      open_set = collections.PriorityQueue()\n      open_set.put((0, start))\n      came_from = {}\n      cost_so_far = {start: 0}\n\n      while not open_set.empty():\n          current = open_set.get()[1]\n\n          if current == end:\n              break\n\n          for neighbor in get_neighbors(grid, current):\n              new_cost = cost_so_far[current] + 1\n              if neighbor not in cost_so_far or new_cost < cost_so_far[neighbor]:\n                  cost_so_far[neighbor] = new_cost\n                  priority = new_cost + heuristic(end, neighbor)\n                  open_set.put((priority, neighbor))\n                  came_from[neighbor] = current\n\n      return reconstruct_path(came_from, start, end)\n\n  def get_neighbors(grid, pos):\n      directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n      neighbors = []\n      for dx, dy in directions:\n          new_x, new_y = pos[0] + dx, pos[1] + dy\n          if 0 <= new_x < grid.shape[1] and 0 <= new_y < grid.shape[0] and grid[new_y, new_x, env.world.non_grabbable_indices].sum() == 0:\n              neighbors.append((new_x, new_y))\n      return neighbors\n\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def get_direction(start, end):\n      dx = end[0] - start[0]\n      dy = end[1] - start[1]\n      \n      if dx == 0:\n          return 'UP' if dy < 0 else 'DOWN'\n      elif dy == 0:\n          return 'LEFT' if dx < 0 else 'RIGHT'\n      else:\n          raise ValueError(\"Diagonal movement is not supported\")\n\n  workshop_type_index = get_workshop_for_item(item_index)\n\n  actions = []\n\n  if workshop_type_index is not None:\n      nearest_workshop_location = find_nearest_workshop(env, workshop_type_index)\n      \n      if nearest_workshop_location is not None:\n          actions.extend(navigate_to(env._current_state.grid, env._current_state.pos, nearest_workshop_location))\n          actions.append(env.action_specs()['USE'])\n  \n  return actions", "island_id": 9, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T03:16:22.504111", "function_name": "craft", "function_body": "  def get_workshop_for_item(item_index):\n      for workshop_type_index in env.world.workshop_indices:\n          recipes = env.world.cookbook.recipes.get(workshop_type_index, {})\n          if '_key' in recipes and item_index == recipes['_key']:\n              return workshop_type_index\n      return None\n\n  def find_nearest_workshop(env, workshop_type_index):\n      current_pos = env._current_state.pos\n      \n      actual_workshops = [(x, y) for y in range(env._current_state.grid.shape[0])\n                          for x in range(env._current_state.grid.shape[1])\n                          if env._current_state.grid[y, x, workshop_type_index] > 0]\n      \n      if not actual_workshops:\n          return None\n      \n      nearest_workshop_location = min(actual_workshops, key=lambda loc: np.linalg.norm(np.array(loc) - np.array(current_pos)))\n      \n      return nearest_workshop_location\n\n  def navigate_to(grid, start_pos, end_pos):\n      path = find_path(grid, start_pos, end_pos)\n      actions = []\n      for next_step in path:\n          direction = get_direction(start_pos, next_step)\n          actions.append(env.action_specs()[direction])\n          start_pos = next_step\n      return actions\n\n  def find_path(grid, start, end):\n      queue = collections.deque([start])\n      parent_map = {start: None}\n      \n      while queue:\n          current = queue.popleft()\n          \n          if current == end:\n              break\n          \n          for neighbor in get_neighbors(grid, current):\n              if neighbor not in parent_map:\n                  parent_map[neighbor] = current\n                  queue.append(neighbor)\n      \n      path = []\n      while current is not None:\n          path.append(current)\n          current = parent_map[current]\n      \n      return path[::-1]\n\n  def get_neighbors(grid, pos):\n      directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n      neighbors = []\n      for dx, dy in directions:\n          new_x, new_y = pos[0] + dx, pos[1] + dy\n          if 0 <= new_x < grid.shape[1] and 0 <= new_y < grid.shape[0]:\n              if np.sum(grid[new_y, new_x, env.world.non_grabbable_indices]) == 0:\n                  neighbors.append((new_x, new_y))\n      return neighbors\n\n  def get_direction(start, end):\n      dx = end[0] - start[0]\n      dy = end[1] - start[1]\n      \n      if dx == 0 and dy < 0:\n          return 'UP'\n      elif dx == 0 and dy > 0:\n          return 'DOWN'\n      elif dx < 0 and dy == 0:\n          return 'LEFT'\n      elif dx > 0 and dy == 0:\n          return 'RIGHT'\n      else:\n          raise ValueError(\"Diagonal movement is not supported\")\n\n  def collect_primitives(env, primitives):\n      actions = []\n      for primitive in primitives:\n          location = find_nearest_primitive(env, primitive)\n          if location is not None:\n              actions.extend(navigate_to(env._current_state.grid, env._current_state.pos, location))\n              actions.append(env.action_specs()['USE'])\n      return actions\n\n  def find_nearest_primitive(env, primitive_index):\n      start = env._current_state.pos\n      queue = collections.deque([start])\n      visited = set()\n      \n      while queue:\n          current = queue.popleft()\n          \n          if current in visited:\n              continue\n          visited.add(current)\n          \n          x, y = current\n          if env._current_state.grid[y, x, primitive_index] > 0:\n              return current\n          \n          for neighbor in get_neighbors(env._current_state.grid, current):\n              queue.append(neighbor)\n      \n      return None\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if all primitives are available in inventory\n  primitives_needed = [key for key, value in env.world.cookbook.recipes.get(item_index, {}).items() if key != '_key']\n  primitives_in_inventory = {key: env._current_state.inventory.get(key, 0) > 0 for key in primitives_needed}\n  \n  actions = []\n  \n  # Collect missing primitives\n  for primitive in primitives_needed:\n      if not primitives_in_inventory[primitive]:\n          location = find_nearest_primitive(env, primitive)\n          if location is not None:\n              actions.extend(navigate_to(env._current_state.grid, env._current_state.pos, location))\n              actions.append(env.action_specs()['USE'])\n  \n  workshop_type_index = get_workshop_for_item(item_index)\n\n  if workshop_type_index is not None:\n      nearest_workshop_location = find_nearest_workshop(env, workshop_type_index)\n      \n      if nearest_workshop_location is not None:\n          actions.extend(navigate_to(env._current_state.grid, env._current_state.pos, nearest_workshop_location))\n          actions.append(env.action_specs()['USE'])\n  else:\n    # No specific workshop needed, likely a primitive item that can be crafted anywhere (e.g., STICK from WOOD)\n    actions.append(env.action_specs()['USE'])\n\n  return actions", "island_id": 9, "scores": {"": -1}}
