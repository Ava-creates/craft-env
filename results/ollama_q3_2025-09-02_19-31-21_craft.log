 elif dx < 0:\n          actions.append(2)  # LEFT\n      elif dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n\n      current_pos = next_pos\n      \n    return actions\n  \n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  # This step assumes that the recipe specifies the workshop type needed.\n  # Since the problem does not specify how to determine the workshop,\n  # we will assume that all workshops can craft any items for simplicity.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Check if the agent is already at a workshop before using the USE action\n  if env._current_state.grid[pos[0], pos[1], workshop_index] > 0:\n    return [env.world.n_actions - 1]  # Assuming the last action index corresponds to USE\n\n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 8, "scores": {"": 4.7}}
{"timestamp": "2025-09-03T14:28:12.834968", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    # A* pathfinding algorithm for more efficient movement\n    open_set = collections.deque([current_pos])\n    came_from = {}\n    g_score = {current_pos: 0}\n    f_score = {current_pos: abs(target_pos[0] - current_pos[0]) + abs(target_pos[1] - current_pos[1])}\n\n    while open_set:\n      current = open_set.popleft()\n      \n      if current == target_pos:\n        break\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        \n        tentative_g_score = g_score[current] + 1\n        \n        if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n          came_from[neighbor] = current\n          g_score[neighbor] = tentative_g_score\n          f_score[neighbor] = tentative_g_score + abs(target_pos[0] - neighbor[0]) + abs(target_pos[1] - neighbor[1])\n          open_set.append(neighbor)\n\n    # Reconstruct path\n    total_path = []\n    while current in came_from:\n      total_path.append(current)\n      current = came_from[current]\n    total_path.reverse()\n\n    for next_pos in total_path:\n      dx = next_pos[0] - current_pos[0]\n      dy = next_pos[1] - current_pos[1]\n\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      elif dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n\n      current_pos = next_pos\n      \n    return actions\n  \n  def gather_primitives(env, primitives):\n    actions = []\n    grid = env._current_state.grid\n    pos = env._current_state.pos\n    \n    for primitive in primitives:\n        primitive_index = env.world.cookbook.index[primitive]\n        \n        # Find the closest position with the required primitive\n        min_distance = float('inf')\n        closest_primitive_pos = None\n        \n        for i in range(grid.shape[0]):\n            for j in range(grid.shape[1]):\n                if grid[i, j, primitive_index] > 0:\n                    distance = abs(i - pos[0]) + abs(j - pos[1])\n                    if distance < min_distance:\n                        min_distance = distance\n                        closest_primitive_pos = (i, j)\n        \n        if not closest_primitive_pos:\n            raise ValueError(f\"No available {primitive} found on the grid.\")\n        \n        # Move to the closest primitive position and pick it up\n        actions.extend(move_to(env, closest_primitive_pos))\n        actions.append(4)  # Assuming action index 4 corresponds to PICK_UP\n        \n    return actions\n\n  def check_inventory_for_primitives(env, primitives):\n      inventory = env._current_state.inventory\n      for primitive in primitives:\n          if inventory[env.world.cookbook.index[primitive]] == 0:\n              return False\n      return True\n  \n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine required primitives for crafting the item\n  recipe = env.world.cookbook.recipes[item_index]\n  required_primitives = [ingredient for ingredient in recipe if ingredient in env.world.cookbook.index]\n\n  # Check if all required primitives are already in inventory\n  if not check_inventory_for_primitives(env, required_primitives):\n      # Gather all required primitives\n      actions_to_gather = gather_primitives(env, required_primitives)\n  else:\n      actions_to_gather = []\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_gather + actions_to_workshop", "island_id": 8, "scores": {"": 4.7}}
{"timestamp": "2025-09-03T14:28:13.907337", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    # A* pathfinding algorithm for more efficient movement\n    open_set = collections.deque([current_pos])\n    came_from = {}\n    g_score = {current_pos: 0}\n    f_score = {current_pos: abs(target_pos[0] - current_pos[0]) + abs(target_pos[1] - current_pos[1])}\n\n    while open_set:\n      current = open_set.popleft()\n      \n      if current == target_pos:\n        break\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        \n        tentative_g_score = g_score[current] + 1\n        \n        if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n          came_from[neighbor] = current\n          g_score[neighbor] = tentative_g_score\n          f_score[neighbor] = tentative_g_score + abs(target_pos[0] - neighbor[0]) + abs(target_pos[1] - neighbor[1])\n          open_set.append(neighbor)\n\n    # Reconstruct path\n    total_path = []\n    while current in came_from:\n      total_path.append(current)\n      current = came_from[current]\n    total_path.reverse()\n\n    for next_pos in total_path:\n      dx = next_pos[0] - current_pos[0]\n      dy = next_pos[1] - current_pos[1]\n\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      elif dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n\n      current_pos = next_pos\n      \n    return actions\n  \n  def gather_primitives(env, primitives):\n    actions = []\n    grid = env._current_state.grid\n    pos = env._current_state.pos\n    \n    for primitive in primitives:\n        primitive_index = env.world.cookbook.index[primitive]\n        \n        # Find the closest position with the required primitive\n        min_distance = float('inf')\n        closest_primitive_pos = None\n        \n        for i in range(grid.shape[0]):\n            for j in range(grid.shape[1]):\n                if grid[i, j, primitive_index] > 0:\n                    distance = abs(i - pos[0]) + abs(j - pos[1])\n                    if distance < min_distance:\n                        min_distance = distance\n                        closest_primitive_pos = (i, j)\n        \n        if not closest_primitive_pos:\n            raise ValueError(f\"No available {primitive} found on the grid.\")\n        \n        # Move to the closest primitive position and pick it up\n        actions.extend(move_to(env, closest_primitive_pos))\n        actions.append(4)  # Assuming action index 4 corresponds to PICK_UP\n        \n    return actions\n\n  def check_inventory_for_primitives(env, primitives):\n      inventory = env._current_state.inventory\n      for primitive in primitives:\n          if inventory[env.world.cookbook.index[primitive]] == 0:\n              return False\n      return True\n  \n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine required primitives for crafting the item\n  recipe = env.world.cookbook.recipes[item_index]\n  required_primitives = [ingredient for ingredient in recipe if ingredient in env.world.cookbook.index]\n\n  # Check if all required primitives are already in inventory\n  if not check_inventory_for_primitives(env, required_primitives):\n      # Gather all required primitives\n      actions_to_gather = gather_primitives(env, required_primitives)\n  else:\n      actions_to_gather = []\n\n  # Determine which workshop is required for crafting this item\n  # This step assumes that the recipe specifies the workshop type needed.\n  # Since the problem does not specify how to determine the workshop,\n  # we will assume that all workshops can craft any items for simplicity.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_gather + actions_to_workshop", "island_id": 8, "scores": {"": 4.7}}
{"timestamp": "2025-09-03T14:29:33.555659", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n\n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      # Determine the direction to move based on the shortest path\n      if abs(dx) > abs(dy):\n        # Move horizontally first\n        if dx > 0:\n            actions.append(3)  # RIGHT\n        elif dx < 0:\n            actions.append(2)  # LEFT\n        else:\n            pass  # No movement needed in x direction\n      else:\n        # Move vertically first\n        if dy > 0:\n            actions.append(1)  # UP\n        elif dy < 0:\n            actions.append(0)  # DOWN\n        else:\n            pass  # No movement needed in y direction\n\n      current_pos = (current_pos[0] + (dx // abs(dx)) if dx != 0 else current_pos[0],\n                     current_pos[1] + (dy // abs(dy)) if dy != 0 else current_pos[1])\n      \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  # This step assumes that the recipe specifies the workshop type needed.\n  # Since the problem does not specify how to determine the workshop,\n  # we will assume that all workshops can craft any items for simplicity.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 9, "scores": {"": 0.90000004}}
{"timestamp": "2025-09-03T14:29:34.670136", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      # Determine the direction to move first (either horizontal or vertical)\n      if abs(dx) > abs(dy):\n          # Move horizontally\n          actions.extend([3] * dx if dx > 0 else [2] * (-dx))\n      else:\n          # Move vertically\n          actions.extend([1] * dy if dy > 0 else [0] * (-dy))\n\n      current_pos = target_pos\n\n    return actions\n  \n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  # This step assumes that the recipe specifies the workshop type needed.\n  # Since the problem does not specify how to determine the workshop,\n  # we will assume that all workshops can craft any items for simplicity.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 9, "scores": {"": 0.90000004}}
{"timestamp": "2025-09-03T14:31:15.492611", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    # Calculate the direction to move in\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    # Move horizontally first if needed\n    while dx != 0:\n      if dx > 0:\n        actions.append(3)  # RIGHT\n        dx -= 1\n      else:\n        actions.append(2)  # LEFT\n        dx += 1\n    \n    # Then move vertically if needed\n    while dy != 0:\n      if dy > 0:\n        actions.append(1)  # UP\n        dy -= 1\n      else:\n        actions.append(0)  # DOWN\n        dy += 1\n\n    return actions\n\n  def determine_workshop(item_index, workshop_indices):\n    \"\"\"Determine the specific workshop type required for crafting the item.\"\"\"\n    # Assuming there are different types of workshops and each can craft certain items.\n    # This is a placeholder implementation. In practice, you would have a mapping of items to workshop indices.\n    # For simplicity, let's assume WORKSHOP0 can craft any item.\n\n    return workshop_indices[0]  # Placeholder\n\n  def calculate_distance(pos1, pos2):\n      \"\"\"Calculate Manhattan distance between two positions.\"\"\"\n      return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n\n  item_index = env.world.cookbook.index[item]\n\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  workshop_indices = env.world.workshop_indices\n\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  \n  # Find all workshops on the grid\n  workshops = []\n  for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n          if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n              workshops.append((i, j))\n  \n  if not workshops:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Sort workshops by distance to find the closest one\n  workshops.sort(key=lambda x: calculate_distance(pos, x))\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, workshops[0])\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 4, "scores": {"": 4.7}}
{"timestamp": "2025-09-03T14:31:16.472387", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    # Calculate the direction to move in\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    # Move horizontally first if needed\n    while dx != 0:\n      if dx > 0:\n        actions.append(3)  # RIGHT\n        dx -= 1\n      else:\n        actions.append(2)  # LEFT\n        dx += 1\n    \n    # Then move vertically if needed\n    while dy != 0:\n      if dy > 0:\n        actions.append(1)  # UP\n        dy -= 1\n      else:\n        actions.append(0)  # DOWN\n        dy += 1\n\n    return actions\n\n  def determine_workshop(item_index, workshop_indices):\n    \"\"\"Determine the specific workshop type required for crafting the item.\"\"\"\n    # Assuming there are different types of workshops and each can craft certain items.\n    # This is a placeholder implementation. In practice, you would have a mapping of items to workshop indices.\n    # For simplicity, let's assume WORKSHOP0 can craft any item.\n\n    return workshop_indices[0]  # Placeholder\n\n  def collect_primitives(env, primitives):\n      \"\"\"Collect all required primitives for crafting the item.\"\"\"\n      actions = []\n      for primitive in primitives:\n          primitive_index = env.world.cookbook.index[primitive]\n          while not env._current_state.next_obs()['features_dict']['inventory'][primitive_index]:\n              closest_primitive_pos = find_closest_primitive(env._current_state.grid, env._current_state.pos, primitive_index)\n              if closest_primitive_pos is None:\n                  raise ValueError(f\"No available {primitive} found on the grid.\")\n              actions.extend(move_to(env, closest_primitive_pos))\n              actions.append(env.world.n_actions - 1)  # USE action to collect the primitive\n      return actions\n\n  def find_closest_primitive(grid, pos, primitive_index):\n    min_distance = float('inf')\n    closest_primitive_pos = None\n    \n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if grid[i, j, primitive_index] > 0:\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_primitive_pos = (i, j)\n    return closest_primitive_pos\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Collect all required primitives for crafting this item\n  actions = []\n  primitives = [env.world.cookbook.index[primitive] for primitive in env.world.cookbook.recipes[item_index]]\n  actions.extend(collect_primitives(env, primitives))\n\n  workshop_indices = env.world.workshop_indices\n\n  # Determine which workshop is required for crafting this item\n  workshop_index = determine_workshop(item_index, workshop_indices)\n\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  \n  # Find the closest workshop of the required type\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions.extend(move_to(env, closest_workshop_pos))\n  \n  # Use the USE action to craft the item at the workshop\n  actions.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions", "island_id": 4, "scores": {"": -1}}
{"timestamp": "2025-09-03T14:32:51.607501", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Iterate over all positions to find the closest workshop\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if any(grid[i, j, w] > 0 for w in workshop_indices):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    # Calculate the direction to move in each step\n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      # Move horizontally first if there is a difference\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      \n      # Then move vertically if there is a difference\n      if dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n\n      current_pos = (current_pos[0] + np.sign(dx), current_pos[1] + np.sign(dy))\n\n    return actions\n\n  def collect_primitives(env, item_index):\n    primitives_needed = env.world.cookbook.primitives_needed[item_index]\n    actions = []\n    \n    for primitive in primitives_needed:\n      while not env._current_state.next_state.has_primitive(primitive):\n        # Move to the closest source of the primitive\n        grid = env._current_state.grid\n        pos = env._current_state.pos\n        primitive_pos = find_closest_primitive(grid, pos, primitive)\n        \n        if not primitive_pos:\n          raise ValueError(f\"No available sources of '{primitive}' found on the grid.\")\n        \n        actions.extend(move_to(env, primitive_pos))\n        actions.append(4)  # Use action to collect the primitive\n    \n    return actions\n\n  def find_closest_primitive(grid, pos, primitive):\n    primitive_index = env.world.cookbook.index[primitive]\n    min_distance = float('inf')\n    closest_primitive_pos = None\n    \n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if grid[i, j, primitive_index] > 0:\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_primitive_pos = (i, j)\n    return closest_primitive_pos\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  actions = []\n  \n  # Collect all necessary primitives\n  actions.extend(collect_primitives(env, item_index))\n  \n  # Determine which workshop is required for crafting this item\n  # This step assumes that the recipe specifies the workshop type needed.\n  # Since the problem does not specify how to determine the workshop,\n  # we will assume that all workshops can craft any items for simplicity.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  actions.extend(actions_to_workshop)\n  \n  # Use the USE action to craft the item at the workshop\n  use_action_index = env.world.n_actions - 1  # Assuming the last action index corresponds to USE\n  actions.append(use_action_index)\n\n  return actions", "island_id": 1, "scores": {"": -1}}
