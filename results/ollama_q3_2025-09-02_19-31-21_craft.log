{"timestamp": "2025-09-03T03:18:24.978193", "function_name": "craft", "function_body": "  def navigate_to_nearest_workshop(env, workshop_index):\n      grid = env._current_state.grid\n      pos = env._current_state.pos\n      \n      # Find all locations of the workshop type on the grid\n      workshop_locations = np.argwhere(grid[:, :, workshop_index] > 0)\n      \n      if len(workshop_locations) == 0:\n          return None, []\n      \n      # Calculate Manhattan distances from the current position to each workshop location\n      distances = np.sum(np.abs(workshop_locations - pos), axis=1)\n      \n      # Find the nearest workshop location\n      nearest_workshop_location = tuple(workshop_locations[np.argmin(distances)])\n      \n      # A* search to navigate to the nearest workshop location\n      path = a_star_search(pos, nearest_workshop_location)\n      \n      if not path:\n          return None, []\n      \n      actions = []\n      for i in range(1, len(path)):\n          dx = path[i][0] - path[i-1][0]\n          dy = path[i][1] - path[i-1][1]\n          action = direction_to_action(dx, dy)\n          if action is not None:\n              actions.append(action)\n      \n      return nearest_workshop_location, actions\n\n  def a_star_search(start, goal):\n      open_set = collections.PriorityQueue()\n      open_set.put((0, start))\n      came_from = {}\n      cost_so_far = {}\n      came_from[start] = None\n      cost_so_far[start] = 0\n      \n      while not open_set.empty():\n          _, current = open_set.get()\n\n          if current == goal:\n              break\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              new_cost = cost_so_far[current] + heuristic(current, neighbor)\n\n              if neighbor not in cost_so_far or new_cost < cost_so_far[neighbor]:\n                  cost_so_far[neighbor] = new_cost\n                  priority = new_cost + heuristic(goal, neighbor)\n                  open_set.put((priority, neighbor))\n                  came_from[neighbor] = current\n      \n      return reconstruct_path(came_from, start, goal)\n\n  def reconstruct_path(came_from, start, goal):\n      current = goal\n      path = []\n      while current != start:\n          path.append(current)\n          current = came_from[current]\n      path.append(start)\n      path.reverse()\n      return path\n\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def direction_to_action(dx, dy):\n      if (dx, dy) == (-1, 0):\n          return env.action_specs()['LEFT']\n      elif (dx, dy) == (1, 0):\n          return env.action_specs()['RIGHT']\n      elif (dx, dy) == (0, -1):\n          return env.action_specs()['UP']\n      elif (dx, dy) == (0, 1):\n          return env.action_specs()['DOWN']\n      return None\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Find the workshop required for crafting this item\n  recipes = env.world.cookbook.recipes\n  workshop_indices = env.world.workshop_indices\n  \n  workshop_required_for_item = None\n  for recipe in recipes:\n    if \"_key\" in recipes[recipe]:\n      key = recipes[recipe][\"_key\"]\n      if key == item_index and recipe in workshop_indices:\n        workshop_required_for_item = recipe\n        break\n\n  # If no workshop is required, return an empty list (item can be crafted directly)\n  if workshop_required_for_item is None:\n    return []\n\n  # Navigate to the nearest workshop of the required type\n  _, actions_to_workshop = navigate_to_nearest_workshop(env, workshop_required_for_item)\n  \n  # Add the USE action to craft the item\n  actions_to_workshop.append(env.action_specs()['USE'])\n  \n  return actions_to_workshop", "island_id": 9, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T03:18:25.945811", "function_name": "craft", "function_body": "  def get_workshop_for_item(item_index):\n    for workshop in env.world.workshop_indices:\n        if '_key' in env.world.cookbook.recipes[workshop] and item_index == env.world.cookbook.recipes[workshop]['_key']:\n            return workshop\n    return None\n\n  def find_nearest_workshop(env, workshop_type_index):\n    grid = env._current_state.grid\n    pos = env._current_state.pos\n    \n    # Find all locations of the workshop type on the grid\n    workshop_locations = np.argwhere(grid[:, :, workshop_type_index] > 0)\n    \n    if not workshop_locations.size:\n      return None\n    \n    # Calculate Manhattan distances from the current position to each workshop location\n    distances = np.sum(np.abs(workshop_locations - pos), axis=1)\n    \n    # Find the nearest workshop location\n    nearest_workshop_location = tuple(workshop_locations[np.argmin(distances)])\n    \n    return nearest_workshop_location\n\n  def a_star_search(grid, start, goal):\n      open_set = collections.PriorityQueue()\n      open_set.put((0, start))\n      came_from = {}\n      cost_so_far = {}\n      came_from[start] = None\n      cost_so_far[start] = 0\n\n      while not open_set.empty():\n          _, current = open_set.get()\n\n          if current == goal:\n              break\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              new_cost = cost_so_far[current] + heuristic(current, neighbor)\n\n              if neighbor not in cost_so_far or new_cost < cost_so_far[neighbor]:\n                  cost_so_far[neighbor] = new_cost\n                  priority = new_cost + heuristic(goal, neighbor)\n                  open_set.put((priority, neighbor))\n                  came_from[neighbor] = current\n\n      return reconstruct_path(came_from, start, goal)\n\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def reconstruct_path(came_from, start, goal):\n      current = goal\n      path = []\n      while current != start:\n          path.append(current)\n          current = came_from[current]\n      path.reverse()\n      return path\n\n  def translate_directions_to_actions(path, action_map, pos):\n      actions = []\n      for i in range(1, len(path)):\n          dx = path[i][0] - path[i-1][0]\n          dy = path[i][1] - path[i-1][1]\n          if (dx, dy) in action_map:\n              actions.append(action_map[(dx, dy)])\n          else:\n              # If the direction is not valid, adjust to a valid move\n              for adj_x, adj_y in [(0, 1), (0, -1), (1, 0), (-1, 0)]:\n                  if (adj_x + pos[0], adj_y + pos[1]) == path[i]:\n                      actions.append(action_map[(adj_x, adj_y)])\n      return actions\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Find the workshop that allows crafting this item\n  workshop_index = get_workshop_for_item(item_index)\n\n  actions = []\n\n  if workshop_index is not None:\n      # Get the location of the nearest workshop of the required type\n      nearest_workshop_location = find_nearest_workshop(env, workshop_index)\n      \n      if nearest_workshop_location is None:\n          return []\n      \n      current_pos = env._current_state.pos\n      \n      # Find the path to the workshop using A* search\n      path_to_workshop = a_star_search(env._current_state.grid, current_pos, nearest_workshop_location)\n\n      action_map = {(-1, 0): env.action_specs()['LEFT'], (1, 0): env.action_specs()['RIGHT'], \n                    (0, -1): env.action_specs()['UP'], (0, 1): env.action_specs()['DOWN']}\n      \n      # Translate path to actions\n      actions_to_workshop = translate_directions_to_actions(path_to_workshop, action_map, current_pos)\n      \n      # Add the USE action to craft the item\n      actions_to_workshop.append(env.action_specs()['USE'])\n      \n      return actions_to_workshop\n  \n  return []", "island_id": 9, "scores": {"": -1}}
{"timestamp": "2025-09-03T03:19:39.493595", "function_name": "craft", "function_body": "  def find_nearest_workshop(state, workshop_indices):\n    min_distance = float('inf')\n    nearest_workshop_pos = None\n    \n    for workshop_idx in workshop_indices:\n      target_pos = find_position_of_kind(env, workshop_idx)\n      distance = np.linalg.norm(np.array(target_pos) - np.array(state.pos))\n      \n      if distance < min_distance:\n        min_distance = distance\n        nearest_workshop_pos = target_pos\n    \n    return nearest_workshop_pos\n\n  def move_to_position(current_pos, target_pos):\n    actions = []\n    current_x, current_y = current_pos\n    target_x, target_y = target_pos\n    \n    # Determine direction to move based on the difference in positions\n    dx = target_x - current_x\n    dy = target_y - current_y\n    \n    while dx != 0 or dy != 0:\n      if abs(dx) > abs(dy):\n        if dx > 0:\n          actions.append(craft.RIGHT)\n          dx -= 1\n        elif dx < 0:\n          actions.append(craft.LEFT)\n          dx += 1\n      else:\n        if dy > 0:\n          actions.append(craft.DOWN)\n          dy -= 1\n        elif dy < 0:\n          actions.append(craft.UP)\n          dy += 1\n    \n    return actions\n\n  def find_position_of_kind(env, kind_index):\n    grid = env._current_state.grid\n    positions = np.argwhere(grid[:, :, kind_index] > 0)\n    if len(positions) == 0:\n      return None  # No such kind found in the grid\n    return tuple(positions[0])\n\n  actions = []\n  current_state = env._current_state\n\n  # Get the index of the desired item from the cookbook index\n  item_index = env.world.cookbook.index[item]\n\n  # Find the workshop index for crafting the item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n  if \"_key\" in recipe:\n    key_workshop = recipe[\"_key\"]\n    workshop_indices = [env.world.workshop_indices[key_workshop]]\n    \n    # Move to the nearest workshop of the required kind if not already next to one\n    if not current_state.next_to(workshop_indices[0]):\n      target_pos = find_nearest_workshop(current_state, workshop_indices)\n      actions.extend(move_to_position(current_state.pos, target_pos))\n      \n    # Perform the USE action to craft the item\n    actions.append(craft.USE)\n\n  return actions", "island_id": 8, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T03:19:40.486895", "function_name": "craft", "function_body": "  def find_nearest_workshop(state, workshop_indices):\n    min_distance = float('inf')\n    nearest_workshop_pos = None\n    \n    for workshop_idx in workshop_indices:\n      target_pos = find_position_of_kind(env, workshop_idx)\n      distance = np.linalg.norm(np.array(target_pos) - np.array(state.pos))\n      \n      if distance < min_distance:\n        min_distance = distance\n        nearest_workshop_pos = target_pos\n    \n    return nearest_workshop_pos\n\n  def move_to_position(current_pos, target_pos):\n    actions = []\n    current_x, current_y = current_pos\n    target_x, target_y = target_pos\n    \n    # Determine direction to move based on the difference in positions\n    dx = target_x - current_x\n    dy = target_y - current_y\n    \n    while dx != 0 or dy != 0:\n      if dx > 0:\n        actions.append(craft.RIGHT)\n        dx -= 1\n      elif dx < 0:\n        actions.append(craft.LEFT)\n        dx += 1\n      \n      if dy > 0:\n        actions.append(craft.DOWN)\n        dy -= 1\n      elif dy < 0:\n        actions.append(craft.UP)\n        dy += 1\n    \n    return actions\n\n  def find_position_of_kind(env, kind_index):\n    grid = env._current_state.grid\n    positions = np.argwhere(grid[:, :, kind_index] > 0)\n    if len(positions) == 0:\n      return None  # No such kind found in the grid\n    return tuple(positions[0])\n\n  def find_workshop_indices_for_item(env, item_index):\n    recipe = env.world.cookbook.recipes.get(item_index, {})\n    workshop_indices = []\n    for key, value in recipe.items():\n        if key.startswith('workshop'):\n            workshop_indices.append(int(value))\n    return workshop_indices\n\n  actions = []\n  current_state = env._current_state\n\n  # Get the index of the desired item from the cookbook index\n  item_index = env.world.cookbook.index[item]\n\n  # Find all workshops that can be used to craft the item\n  workshop_indices = find_workshop_indices_for_item(env, item_index)\n  \n  if not workshop_indices:\n    return actions  # No workshops found for this item\n\n  # Move to the nearest workshop of the required kind if not already next to one\n  target_pos = find_nearest_workshop(current_state, workshop_indices)\n  if target_pos is None:\n      return actions  # No workshops found in the grid\n\n  if not current_state.next_to(workshop_indices[0]):\n    actions.extend(move_to_position(current_state.pos, target_pos))\n    \n  # Perform the USE action to craft the item\n  actions.append(craft.USE)\n\n  return actions", "island_id": 8, "scores": {"": -1}}
{"timestamp": "2025-09-03T03:20:22.906365", "function_name": "craft", "function_body": "  goal_index = env.world.cookbook.index[item]\n  actions = []\n\n  if goal_index in env.world.cookbook.recipes:\n    # Find all workshops that can produce the item\n    workshop_indices = [idx for idx, recipe in env.world.cookbook.recipes.items() \n                        if \"_key\" in recipe and recipe[\"_key\"] == goal_index]\n    \n    if workshop_indices:\n        # Choose the first available workshop (assuming it's always reachable)\n        chosen_workshop_index = workshop_indices[0]\n\n        # Find positions of the chosen workshop in the grid\n        workshop_positions = np.argwhere(env._current_state.grid[:, :, chosen_workshop_index]).tolist()\n        \n        if workshop_positions:\n            nearest_workshop_position = min(workshop_positions, \n                                           key=lambda pos: np.linalg.norm(np.array(pos) - np.array(env._current_state.pos)))\n\n            # Calculate the path to the nearest workshop position\n            actions.extend(calculate_path_to_target(env, nearest_workshop_position))\n            \n            # Use the workshop to craft the item\n            actions.append(craft.CRAFT_FUNC(item))\n  \n  return actions", "island_id": 5, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T03:20:23.947464", "function_name": "craft", "function_body": "  goal_index = env.world.cookbook.index[item]\n  actions = []\n\n  # Find all workshops that can produce the item\n  workshop_indices = [idx for idx, recipe in env.world.cookbook.recipes.items() \n                      if \"_key\" in recipe and recipe[\"_key\"] == goal_index]\n\n  if not workshop_indices:\n      return actions\n\n  chosen_workshop_index = workshop_indices[0]\n  \n  # Find the position of the chosen workshop\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, chosen_workshop_index]).tolist()\n\n  if not workshop_positions:\n      return actions\n\n  # Determine the nearest workshop\n  target_pos = min(workshop_positions, \n                   key=lambda pos: np.linalg.norm(np.array(pos) - np.array(env._current_state.pos)))\n  \n  # Calculate path to the nearest workshop using A* algorithm\n  path = a_star_pathfinding(env._current_state.grid, env._current_state.pos, target_pos)\n\n  if not path:\n      return actions\n\n  for next_pos in path:\n      current_x, current_y = env._current_state.pos\n      target_x, target_y = next_pos\n\n      # Calculate moves in x-direction\n      while current_x != target_x:\n          if current_x < target_x:\n              actions.append(craft.MOVE_FUNC(craft.RIGHT))\n              current_x += 1\n          else:\n              actions.append(craft.MOVE_FUNC(craft.LEFT))\n              current_x -= 1\n\n      # Calculate moves in y-direction\n      while current_y != target_y:\n          if current_y < target_y:\n              actions.append(craft.MOVE_FUNC(craft.DOWN))\n              current_y += 1\n          else:\n              actions.append(craft.MOVE_FUNC(craft.UP))\n              current_y -= 1\n\n      # Step the environment to move the agent\n      env._current_state, _, _ = env.step(actions[-1].index)\n\n  # Use the workshop to craft the item\n  actions.append(craft.CRAFT_FUNC(item))\n\n  return actions", "island_id": 5, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T03:21:54.809956", "function_name": "craft", "function_body": "  def get_missing_ingredients(recipe):\n    required_ingredients = {k: v for k, v in recipe.items() if k != \"_key\"}\n    missing_ingredients = []\n    inventory_counts = env._current_state.inventory\n    for ingredient_index, count in required_ingredients.items():\n      if inventory_counts[ingredient_index] < count:\n        missing_ingredients.append((ingredient_index, count - inventory_counts[ingredient_index]))\n    return missing_ingredients\n\n  def collect_missing_ingredients(env, missing_ingredients):\n    actions = []\n    for ingredient_index, count in missing_ingredients:\n      ingredient_name = env.world.cookbook.index.get(ingredient_index, \"unknown\")\n      for _ in range(count):\n        actions.extend(collect_v1(env, ingredient_name))\n    return actions\n\n  def find_nearest_workshop(recipe):\n    workshop_needed = None\n    # Determine which workshop type is needed based on the ingredients\n    for ingredient_index in recipe.keys():\n      if ingredient_index != \"_key\":\n          kind_name = env.world.cookbook.index.get(ingredient_index, \"unknown\")\n          if kind_name.startswith(\"WORKSHOP\"):\n              workshop_needed = ingredient_index\n              break\n\n    # If no specific workshop is needed, use the first available workshop\n    if workshop_needed is None:\n        workshop_needed = env.world.workshop_indices[0]\n\n    workshops = np.argwhere(env._current_state.grid[:, :, workshop_needed] > 0)\n\n    if workshops.size == 0:\n      return None\n\n    agent_pos = env._current_state.pos\n    distances = np.sum(np.abs(workshops - agent_pos), axis=1)\n    nearest_workshop = tuple(workshops[np.argmin(distances)])\n\n    return nearest_workshop, workshop_needed\n\n  def move_to(env, target_pos):\n    # Calculate the difference in positions\n    x_diff = target_pos[0] - env._current_state.pos[0]\n    y_diff = target_pos[1] - env._current_state.pos[1]\n\n    actions = []\n\n    if x_diff > 0:\n      actions.extend([env.world.cookbook.index[\"RIGHT\"]] * x_diff)\n    elif x_diff < 0:\n      actions.extend([env.world.cookbook.index[\"LEFT\"]] * abs(x_diff))\n\n    if y_diff > 0:\n      actions.extend([env.world.cookbook.index[\"DOWN\"]] * y_diff)\n    elif y_diff < 0:\n      actions.extend([env.world.cookbook.index[\"UP\"]] * abs(y_diff))\n\n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Get all recipes that produce the item\n  recipes = {k: v for k, v in env.world.cookbook.recipes.items() if \"_key\" in v and v[\"_key\"] == item_index}\n\n  # If no recipe is found, return an empty list\n  if not recipes:\n    return []\n\n  # Assume we have only one recipe to produce the item\n  recipe = next(iter(recipes.values()))\n\n  nearest_workshop, workshop_needed = find_nearest_workshop(recipe)\n\n  if nearest_workshop is None:\n    return []\n\n  actions_to_workshop = move_to(env, nearest_workshop)\n\n  # Check if the item is already in the inventory\n  if env._current_state.inventory[item_index] > 0:\n    return []\n\n  # Collect required primitives if not already present in the inventory\n  missing_ingredients = get_missing_ingredients(recipe)\n  primitive_actions = collect_missing_ingredients(env, missing_ingredients)\n\n  # Use action index for crafting\n  use_action_index = env.world.cookbook.index[\"USE\"]\n\n  return primitive_actions + actions_to_workshop + [use_action_index]", "island_id": 4, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T03:21:55.871282", "function_name": "craft", "function_body": "  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    # Calculate the difference in position\n    delta_x = target_pos[0] - current_pos[0]\n    delta_y = target_pos[1] - current_pos[1]\n    \n    # Determine direction and append corresponding actions\n    if delta_x < 0:\n        actions.extend([env.world.LEFT] * abs(delta_x))\n    elif delta_x > 0:\n        actions.extend([env.world.RIGHT] * abs(delta_x))\n    \n    if delta_y < 0:\n        actions.extend([env.world.DOWN] * abs(delta_y))\n    elif delta_y > 0:\n        actions.extend([env.world.UP] * abs(delta_y))\n    \n    return actions\n\n  def get_missing_ingredients(recipe):\n    required_ingredients = {k: v for k, v in recipe.items() if k != \"_key\"}\n    missing_ingredients = []\n    inventory_counts = env._current_state.inventory\n    for ingredient_index, count in required_ingredients.items():\n      if inventory_counts[ingredient_index] < count:\n        missing_ingredients.append((ingredient_index, count - inventory_counts[ingredient_index]))\n    return missing_ingredients\n\n  def collect_missing_ingredients(env, missing_ingredients):\n    actions = []\n    for ingredient_index, count in missing_ingredients:\n      ingredient_name = env.world.cookbook.index.get(ingredient_index, \"unknown\")\n      for _ in range(count):\n        actions.extend(collect_v1(env, ingredient_name))\n    return actions\n\n  def find_nearest_workshop(recipe):\n    # Determine which workshop type is needed based on the ingredients\n    workshop_needed = None\n    for ingredient_index in recipe.keys():\n      if ingredient_index != \"_key\":\n          kind_name = env.world.cookbook.index.get(ingredient_index, \"unknown\")\n          if kind_name.startswith(\"WORKSHOP\"):\n              workshop_needed = ingredient_index\n              break\n\n    # If no specific workshop is needed, use the first available workshop\n    if workshop_needed is None:\n        workshop_needed = env.world.workshop_indices[0]\n\n    workshops = np.argwhere(env._current_state.grid[:, :, workshop_needed] > 0)\n\n    if workshops.size == 0:\n      return None\n\n    agent_pos = env._current_state.pos\n    distances = np.sum(np.abs(workshops - agent_pos), axis=1)\n    nearest_workshop = tuple(workshops[np.argmin(distances)])\n\n    return nearest_workshop, workshop_needed\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Get all recipes that produce the item\n  recipes = {k: v for k, v in env.world.cookbook.recipes.items() if \"_key\" in v and v[\"_key\"] == item_index}\n\n  # If no recipe is found, return an empty list\n  if not recipes:\n    return []\n\n  # Assume we have only one recipe to produce the item\n  recipe = next(iter(recipes.values()))\n\n  nearest_workshop, workshop_needed = find_nearest_workshop(recipe)\n\n  if nearest_workshop is None:\n    return []\n\n  actions_to_workshop = move_to(env, nearest_workshop)\n\n  # Check if the item is already in the inventory\n  if env._current_state.inventory[item_index] > 0:\n    return []\n\n  # Collect required primitives if not already present in the inventory\n  missing_ingredients = get_missing_ingredients(recipe)\n  primitive_actions = collect_missing_ingredients(env, missing_ingredients)\n\n  # Use action index for crafting\n  use_action_index = env.world.cookbook.index[\"USE\"]\n\n  return primitive_actions + actions_to_workshop + [use_action_index]", "island_id": 4, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T03:23:31.069339", "function_name": "craft", "function_body": "  def move_to_workshop(state, workshop_index):\n    actions = []\n    grid = state.grid\n    pos = state.pos\n    dir = state.dir\n    \n    # Find the nearest workshop cell index in the grid\n    workshop_cells = np.argwhere(grid[:, :, workshop_index] > 0)\n    \n    if len(workshop_cells) == 0:\n      raise ValueError(\"No workshops found for this item.\")\n    \n    closest_workshop = min(workshop_cells, key=lambda x: (x[0]-pos[0])**2 + (x[1]-pos[1])**2)\n    \n    # Calculate the path to the nearest workshop\n    path = astar(grid, pos, closest_workshop)\n    \n    for step in path:\n      if step == pos:\n        continue\n      \n      dx, dy = step[0] - pos[0], step[1] - pos[1]\n      \n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      elif dy > 0:\n          actions.append(0)  # DOWN\n      elif dy < 0:\n          actions.append(1)  # UP\n      \n      pos = step\n    \n    return actions\n\n  def astar(grid, start, goal):\n    open_set = collections.PriorityQueue()\n    open_set.put((0, start))\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, goal)}\n    \n    while not open_set.empty():\n        _, current = open_set.get()\n\n        if current == goal:\n            return reconstruct_path(came_from, current)\n        \n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            neighbor = (current[0] + dx, current[1] + dy)\n            \n            if not (0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]):\n                continue\n            \n            tentative_g_score = g_score[current] + 1\n            if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                came_from[neighbor] = current\n                g_score[neighbor] = tentative_g_score\n                f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                open_set.put((f_score[neighbor], neighbor))\n    \n    return []\n\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def reconstruct_path(came_from, current):\n      total_path = [current]\n      while current in came_from:\n          current = came_from[current]\n          total_path.append(current)\n      return list(reversed(total_path))\n  \n  actions = []\n  \n  # Get index for desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Assuming we have all ingredients in the inventory\n\n  # Identify required workshop based on recipe (if any)\n  recipe = env.world.cookbook.recipes.get(item_index)\n  if recipe:\n    _key = recipe.get(\"_key\")\n    if _key is not None:\n      workshop_name = f\"WORKSHOP{_key}\"\n      workshop_index = env.world.cookbook.index[workshop_name]\n      # Move to the workshop\n      actions.extend(move_to_workshop(env._current_state, workshop_index))\n  \n  # Craft the item by using USE action\n  actions.append(4)  # Use action\n  \n  return actions", "island_id": 0, "scores": {"": 0.0}}
