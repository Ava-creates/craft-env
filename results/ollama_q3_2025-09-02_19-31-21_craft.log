elif dx < 0:\n          actions.append(2)  # LEFT\n      elif dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n\n      current_pos = next_pos\n      \n    return actions\n  \n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  # This step assumes that the recipe specifies the workshop type needed.\n  # Since the problem does not specify how to determine the workshop,\n  # we will assume that all workshops can craft any items for simplicity.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Check if the agent is already at a workshop before using the USE action\n  if env._current_state.grid[pos[0], pos[1], workshop_index] > 0:\n    return [env.world.n_actions - 1]  # Assuming the last action index corresponds to USE\n\n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  # Check if the inventory already has the item before crafting\n  current_inventory = env._current_state.inventory\n  if current_inventory[item_index] > 0:\n    return []  # No need to craft if the item is already in the inventory\n\n  return actions_to_workshop", "island_id": 8, "scores": {"": 4.7}}
{"timestamp": "2025-09-03T13:27:15.665641", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Iterate over all positions in the grid to find the nearest workshop\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if any(grid[i, j, w] > 0 for w in workshop_indices):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    # A* pathfinding algorithm to find the shortest path to the target position\n    open_set = collections.deque([(0, current_pos)])  # Priority queue with (f_score, position)\n    came_from = {}\n    g_score = {current_pos: 0}\n    f_score = {current_pos: abs(target_pos[0] - current_pos[0]) + abs(target_pos[1] - current_pos[1])}\n\n    while open_set:\n      _, current = open_set.popleft()\n      \n      if current == target_pos:\n        break\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        \n        tentative_g_score = g_score[current] + 1\n        \n        if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n          came_from[neighbor] = current\n          g_score[neighbor] = tentative_g_score\n          f_score[neighbor] = tentative_g_score + abs(target_pos[0] - neighbor[0]) + abs(target_pos[1] - neighbor[1])\n          open_set.append((f_score[neighbor], neighbor))\n\n    # Reconstruct path\n    total_path = []\n    while current in came_from:\n      total_path.append(current)\n      current = came_from[current]\n    total_path.reverse()\n\n    for next_pos in total_path:\n      dx = next_pos[0] - current_pos[0]\n      dy = next_pos[1] - current_pos[1]\n\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      elif dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n\n      current_pos = next_pos\n      \n    return actions\n\n  def check_inventory(item_index, inventory):\n    item_name = env.world.cookbook.index.get_key(item_index)\n    required_primitives = env.world.cookbook.primitives_required[item_name]\n    \n    for primitive in required_primitives:\n        if primitive not in inventory or inventory[primitive] <= 0:\n            return False\n    return True\n\n  def collect_missing_primitives(env, item):\n      # Get the index of the item to craft\n      item_index = env.world.cookbook.index[item]\n\n      # Check if the item can be crafted (i.e., it has a recipe)\n      if item_index not in env.world.cookbook.recipes:\n          raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n      \n      # Determine which workshop is required for crafting this item\n      # This step assumes that the recipe specifies the workshop type needed.\n      # Since the problem does not specify how to determine the workshop,\n      # we will assume that all workshops can craft any items for simplicity.\n      workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n      \n      # Get required primitives\n      item_name = env.world.cookbook.index.get_key(item_index)\n      required_primitives = env.world.cookbook.primitives_required[item_name]\n      \n      # Check current inventory\n      current_inventory = collections.defaultdict(int)\n      grid = env._current_state.grid\n      for i in range(grid.shape[0]):\n          for j in range(grid.shape[1]):\n              for primitive_index, count in enumerate(grid[i, j]):\n                  if count > 0:\n                      primitive_name = env.world.cookbook.index.get_key(primitive_index)\n                      current_inventory[primitive_name] += count\n      \n      # Determine missing primitives\n      actions = []\n      for primitive in required_primitives:\n          if primitive not in current_inventory or current_inventory[primitive] <= 0:\n              # Find closest source of the primitive\n              target_primitive_index = env.world.cookbook.index[primitive]\n              target_pos = None\n              min_distance = float('inf')\n              for i in range(grid.shape[0]):\n                  for j in range(grid.shape[1]):\n                      if grid[i, j, target_primitive_index] > 0:\n                          distance = abs(i - pos[0]) + abs(j - pos[1])\n                          if distance < min_distance:\n                              min_distance = distance\n                              target_pos = (i, j)\n              \n              if not target_pos:\n                  raise ValueError(f\"No available source of '{primitive}' found on the grid.\")\n              \n              # Move to the closest primitive source\n              actions.extend(move_to(env, target_pos))\n              \n              # Use the USE action to collect the primitive\n              actions.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n      \n      return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  # This step assumes that the recipe specifies the workshop type needed.\n  # Since the problem does not specify how to determine the workshop,\n  # we will assume that all workshops can craft any items for simplicity.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Check if all required primitives are in inventory\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  current_inventory = collections.defaultdict(int)\n  for i in range(grid.shape[0]):\n    for j in range(grid.shape[1]):\n      for primitive_index, count in enumerate(grid[i, j]):\n        if count > 0:\n          primitive_name = env.world.cookbook.index.get_key(primitive_index)\n          current_inventory[primitive_name] += count\n\n  actions_to_workshop = []\n  \n  # Collect missing primitives\n  actions_to_collect_primitives = collect_missing_primitives(env, item)\n\n  if actions_to_collect_primitives:\n    actions_to_workshop.extend(actions_to_collect_primitives)\n\n  # Find the closest workshop\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n  \n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n  \n  # Move to the closest workshop\n  actions_to_workshop.extend(move_to(env, closest_workshop_pos))\n\n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 6, "scores": {"": -1}}
{"timestamp": "2025-09-03T13:27:16.731778", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Iterate over all positions in the grid to find the nearest workshop\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if any(grid[i, j, w] > 0 for w in workshop_indices):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    # A* pathfinding algorithm to find the shortest path to the target position\n    open_set = collections.deque([(0, current_pos)])  # Priority queue with (f_score, position)\n    came_from = {}\n    g_score = {current_pos: 0}\n    f_score = {current_pos: abs(target_pos[0] - current_pos[0]) + abs(target_pos[1] - current_pos[1])}\n\n    while open_set:\n      _, current = open_set.popleft()\n      \n      if current == target_pos:\n        break\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        \n        tentative_g_score = g_score[current] + 1\n        \n        if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n          came_from[neighbor] = current\n          g_score[neighbor] = tentative_g_score\n          f_score[neighbor] = tentative_g_score + abs(target_pos[0] - neighbor[0]) + abs(target_pos[1] - neighbor[1])\n          open_set.append((f_score[neighbor], neighbor))\n\n    # Reconstruct path\n    total_path = []\n    while current in came_from:\n      total_path.append(current)\n      current = came_from[current]\n    total_path.reverse()\n\n    for next_pos in total_path:\n      dx = next_pos[0] - current_pos[0]\n      dy = next_pos[1] - current_pos[1]\n\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      elif dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n\n      current_pos = next_pos\n      \n    return actions\n  \n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  # This step assumes that the recipe specifies the workshop type needed.\n  # Since the problem does not specify how to determine the workshop,\n  # we will assume that all workshops can craft any items for simplicity.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 6, "scores": {"": 4.7}}
{"timestamp": "2025-09-03T13:28:52.560867", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n\n    # Iterate over all positions to find the closest workshop with a heuristic approach\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if any(grid[i, j, w] > 0 for w in workshop_indices):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    # Use A* pathfinding algorithm for efficient movement\n    def heuristic(a, b):\n        return abs(b[0] - a[0]) + abs(b[1] - a[1])\n\n    open_set = collections.PriorityQueue()\n    open_set.put((0, current_pos))\n    came_from = {}\n    g_score = {current_pos: 0}\n    f_score = {current_pos: heuristic(current_pos, target_pos)}\n\n    while not open_set.empty():\n        _, current = open_set.get()\n\n        if current == target_pos:\n            # Reconstruct path\n            total_path = []\n            while current in came_from:\n                dx = came_from[current][0] - current[0]\n                dy = came_from[current][1] - current[1]\n\n                if dx > 0:\n                    actions.append(3)  # RIGHT\n                elif dx < 0:\n                    actions.append(2)  # LEFT\n                \n                if dy > 0:\n                    actions.append(1)  # UP\n                elif dy < 0:\n                    actions.append(0)  # DOWN\n\n                current = came_from[current]\n            return total_path[::-1]\n\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            neighbor = (current[0] + dx, current[1] + dy)\n            tentative_g_score = g_score[current] + 1\n\n            if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n                if tentative_g_score < g_score.get(neighbor, float('inf')):\n                    came_from[neighbor] = current\n                    g_score[neighbor] = tentative_g_score\n                    f_score[neighbor] = tentative_g_score + heuristic(neighbor, target_pos)\n                    open_set.put((f_score[neighbor], neighbor))\n\n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  # This step assumes that the recipe specifies the workshop type needed.\n  # Since the problem does not specify how to determine the workshop,\n  # we will assume that all workshops can craft any items for simplicity.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop using A* pathfinding\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 1, "scores": {"": -1}}
{"timestamp": "2025-09-03T13:28:53.511055", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n\n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      # Determine the direction with the larger distance to move first\n      if abs(dx) > abs(dy):\n        if dx > 0:\n            actions.append(3)  # RIGHT\n        else:\n            actions.append(2)  # LEFT\n        current_pos = (current_pos[0] + (dx // abs(dx)), current_pos[1])\n      elif abs(dy) >= abs(dx):\n        if dy > 0:\n            actions.append(1)  # UP\n        else:\n            actions.append(0)  # DOWN\n        current_pos = (current_pos[0], current_pos[1] + (dy // abs(dy)))\n\n    return actions\n\n  def determine_workshop_for_item(env, item_index):\n      workshop_indices = env.world.workshop_indices\n      recipes = env.world.cookbook.recipes\n      \n      for w in workshop_indices:\n          # Check if the recipe specifies this workshop\n          if any(item_index == recipe.get('_key', -1) for recipe in recipes.values()):\n              return w\n      return None  # Default to no workshop found\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  workshop_index = determine_workshop_for_item(env, item_index)\n\n  if workshop_index is None:\n      raise ValueError(\"No suitable workshop found for the given item.\")\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 1, "scores": {"": -1}}
