turn actions\n\n  item_index = env.world.cookbook.index[item]\n  grid_shape = env._current_state.grid.shape[:2]\n\n  workshop_index = get_closest_workshop(item_index)\n\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  # If no workshops are found, return an empty list of actions\n  if not workshop_positions.size:\n    return []\n\n  closest_workshop = min(workshop_positions, key=lambda pos: np.linalg.norm(np.array(pos) - np.array(env._current_state.pos)))\n  actions_to_closest_workshop = navigate_to_position(closest_workshop)\n\n  actions_to_closest_workshop.append(4)  # USE to craft the item\n\n  return actions_to_closest_workshop", "island_id": 1, "scores": {"": 2.0}}
{"timestamp": "2025-09-03T05:54:43.573279", "function_name": "craft", "function_body": "  def get_closest_workshop(item_index):\n    \"\"\"Finds the closest workshop that can craft the specified item.\"\"\"\n    # Determine the workshop required based on the recipe key\n    workshop_indices = []\n    for output_idx, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n        workshop_name = ingredients.get(\"_workshop\")\n        if workshop_name:\n          workshop_indices.append(env.world.cookbook.index[workshop_name])\n    \n    # If no specific workshop is needed, use a default one\n    if not workshop_indices:\n      return env.world.workshop_indices[0]  # Default to the first workshop type\n    \n    # Find the closest workshop in the grid\n    agent_pos = np.array(env._current_state.pos)\n    min_distance = float('inf')\n    closest_workshop_index = None\n    for workshop_index in workshop_indices:\n      for y in range(grid_shape[1]):\n        for x in range(grid_shape[0]):\n          if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n            target_pos = np.array((x, y))\n            distance = np.linalg.norm(agent_pos - target_pos)\n            if distance < min_distance:\n              min_distance = distance\n              closest_workshop_index = workshop_index\n    return closest_workshop_index\n\n  def path_to_target(start, target):\n    \"\"\"Computes the path from start position to target position using A* algorithm.\"\"\"\n    actions = []\n    # Define possible movements and their corresponding actions\n    moves = [(1, 0, 3), (-1, 0, 2), (0, 1, 1), (0, -1, 0)]  # RIGHT, LEFT, UP, DOWN\n    open_set = collections.deque([(start[0], start[1], [])])  # Queue for BFS\n    visited = set()\n    \n    while open_set:\n      x, y, path = open_set.popleft()\n      \n      if (x, y) == tuple(target):\n        return path\n      \n      if (x, y) in visited:\n        continue\n      \n      visited.add((x, y))\n      \n      for dx, dy, action in moves:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < grid_shape[0] and 0 <= ny < grid_shape[1]:\n          open_set.append((nx, ny, path + [action]))\n    \n    return actions\n\n  def get_required_primitives(item_index):\n    \"\"\"Retrieves the list of required primitives for crafting an item.\"\"\"\n    for output_idx, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n        return [primitive for primitive in ingredients.keys() if primitive != \"_key\" and primitive != \"_workshop\"]\n    return []\n\n  def ensure_inventory(item_index):\n    \"\"\"Ensures the inventory has all required primitives for crafting.\"\"\"\n    actions = []\n    current_inventory = env._current_state.inventory.copy()\n    \n    # Get the list of required primitives\n    required_primitives = get_required_primitives(item_index)\n    \n    # Collect each missing primitive from the environment\n    for primitive in required_primitives:\n      if primitive not in current_inventory or current_inventory[primitive] == 0:\n        collect_actions = collect(env, primitive)\n        actions.extend(collect_actions)\n        # Update inventory after collecting\n        current_inventory[primitive] += 1\n    \n    return actions\n\n  def update_inventory(item_index):\n    \"\"\"Updates the inventory based on crafted items.\"\"\"\n    env._current_state.inventory[item_index] += 1\n\n  item_index = env.world.cookbook.index[item]\n  grid_shape = env._current_state.grid.shape[:2]\n\n  # Ensure inventory has all required primitives\n  actions_to_collect_primitives = ensure_inventory(item_index)\n\n  # Find the closest workshop for crafting\n  workshop_index = get_closest_workshop(item_index)\n\n  # Find the position of the closest workshop in the grid\n  agent_pos = np.array(env._current_state.pos)\n  workshop_pos = None\n  min_distance = float('inf')\n  for y in range(grid_shape[1]):\n    for x in range(grid_shape[0]):\n      if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n        target_pos = np.array((x, y))\n        distance = np.linalg.norm(agent_pos - target_pos)\n        if distance < min_distance:\n          min_distance = distance\n          workshop_pos = (x, y)\n\n  # If no workshop position is found, return an empty list of actions\n  if workshop_pos is None:\n    return []\n\n  # Calculate the path to the closest workshop and perform the USE action\n  target_pos = np.array(workshop_pos)\n  actions_to_workshop = path_to_target(agent_pos[:2], target_pos)\n  actions_to_workshop.append(4)  # USE to craft the item\n\n  # Update inventory after crafting\n  update_inventory(item_index)\n\n  return actions_to_collect_primitives + actions_to_workshop", "island_id": 2, "scores": {"": 2.7}}
{"timestamp": "2025-09-03T05:54:44.535817", "function_name": "craft", "function_body": "  def get_closest_workshop(item_index):\n    \"\"\"Finds the closest workshop that can craft the specified item.\"\"\"\n    # Determine the workshop required based on the recipe key\n    workshop_indices = []\n    for output_idx, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n        workshop_name = ingredients.get(\"_workshop\")\n        if workshop_name:\n          workshop_indices.append(env.world.cookbook.index[workshop_name])\n    \n    # If no specific workshop is needed, use a default one\n    if not workshop_indices:\n      return env.world.workshop_indices[0]  # Default to the first workshop type\n    \n    # Find the closest workshop in the grid\n    agent_pos = np.array(env._current_state.pos)\n    min_distance = float('inf')\n    closest_workshop_index = None\n    for workshop_index in workshop_indices:\n      for y in range(grid_shape[1]):\n        for x in range(grid_shape[0]):\n          if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n            target_pos = np.array((x, y))\n            distance = np.linalg.norm(agent_pos - target_pos)\n            if distance < min_distance:\n              min_distance = distance\n              closest_workshop_index = (x, y, workshop_index)\n    return closest_workshop_index\n\n  def path_to_target(start, target):\n    \"\"\"Computes the path from start position to target position using A* algorithm.\"\"\"\n    actions = []\n    # Define possible movements and their corresponding actions\n    moves = [(1, 0, 3), (-1, 0, 2), (0, 1, 1), (0, -1, 0)]  # RIGHT, LEFT, UP, DOWN\n    open_set = collections.deque([(start[0], start[1], [])])  # Queue for BFS\n    visited = set()\n    \n    while open_set:\n      x, y, path = open_set.popleft()\n      \n      if (x, y) == tuple(target):\n        return path\n      \n      if (x, y) in visited:\n        continue\n      \n      visited.add((x, y))\n      \n      for dx, dy, action in moves:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < grid_shape[0] and 0 <= ny < grid_shape[1]:\n          open_set.append((nx, ny, path + [action]))\n    \n    return actions\n\n  def get_required_primitives(item_index):\n    \"\"\"Retrieves the list of required primitives for crafting an item.\"\"\"\n    for output_idx, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n        return [primitive for primitive in ingredients.keys() if primitive != \"_key\" and primitive != \"_workshop\"]\n    return []\n\n  def ensure_inventory(item_index):\n    \"\"\"Ensures the inventory has all required primitives for crafting.\"\"\"\n    actions = []\n    current_inventory = env._current_state.inventory.copy()\n    \n    # Get the list of required primitives\n    required_primitives = get_required_primitives(item_index)\n    \n    # Collect each missing primitive from the environment\n    for primitive in required_primitives:\n      if primitive not in current_inventory or current_inventory[primitive] == 0:\n        collect_actions = collect(env, primitive)\n        actions.extend(collect_actions)\n        # Update inventory after collecting\n        current_inventory[primitive] += 1\n    \n    return actions\n\n  def update_inventory(item_index):\n    \"\"\"Updates the inventory based on crafted items.\"\"\"\n    env._current_state.inventory[item_index] += 1\n\n  item_index = env.world.cookbook.index[item]\n  grid_shape = env._current_state.grid.shape[:2]\n\n  # Ensure inventory has all required primitives\n  actions_to_collect_primitives = ensure_inventory(item_index)\n\n  # Find the closest workshop for crafting\n  workshop_info = get_closest_workshop(item_index)\n  \n  if not workshop_info:\n    return []  # No valid workshop found\n\n  x, y, _ = workshop_info\n\n  # Calculate the path to the closest workshop and perform the USE action\n  agent_pos = np.array(env._current_state.pos)\n  target_pos = np.array((x, y))\n  actions_to_workshop = path_to_target(agent_pos[:2], target_pos)\n  actions_to_workshop.append(4)  # USE to craft the item\n\n  # Update inventory after crafting\n  update_inventory(item_index)\n\n  return actions_to_collect_primitives + actions_to_workshop", "island_id": 2, "scores": {"": -1}}
{"timestamp": "2025-09-03T05:56:08.810672", "function_name": "craft", "function_body": "  def move_to_position_bfs(start: tuple, goal: tuple):\n    directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n    direction_map = {(-1, 0): 1, (1, 0): 0, (0, -1): 2, (0, 1): 3}\n    \n    queue = collections.deque([(start, [])])\n    visited = set([start])\n\n    while queue:\n      pos, path = queue.popleft()\n      \n      if pos == goal:\n        return path\n      \n      x, y = pos\n\n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        \n        # Ensure the new position is within grid bounds and walkable\n        if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n          if env._current_state.grid[nx, ny, 0] == 0:  # Assuming layer 0 is walkable\n            if (nx, ny) not in visited:\n              visited.add((nx, ny))\n              queue.append(((nx, ny), path + [direction_map[(dx, dy)]]))\n\n    return []\n\n  def turn_towards(current_dir, target_dir):\n    \"\"\"Calculate the actions needed to turn from current direction to target direction.\"\"\"\n    diff = (target_dir - current_dir) % 4\n    \n    if diff == 1:\n        return [3]  # RIGHT\n    elif diff == 2:\n        return [2, 3]  # LEFT + RIGHT or 180 degrees\n    elif diff == 3:\n        return [2]  # LEFT\n\n    return []  # Already facing the target direction\n\n  def find_workshop(workshop_type):\n      \"\"\"Find the index of the workshop in the grid.\"\"\"\n      for idx, workshop_name in enumerate(env.world.cookbook.index):\n          if workshop_name.startswith(workshop_type):\n              return env.world.workshop_indices[idx]\n      return None\n\n  actions = []\n\n  # Get the index of the desired item to be crafted\n  item_index = env.world.cookbook.index[item]\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n\n  if \"_key\" in recipe:\n      workshop_type = recipe[\"_key\"]\n\n      # Find the index of the corresponding workshop in the world configuration\n      selected_workshop_index = find_workshop(workshop_type)\n      \n      if selected_workshop_index is not None:\n          # Determine the position(s) of the selected workshop from the current state's grid\n          workshop_positions = np.argwhere(env._current_state.grid[:, :, selected_workshop_index] > 0)\n\n          if len(workshop_positions) > 0:\n              target_pos = tuple(workshop_positions[0])\n\n              # Move to the target position of the workshop\n              actions.extend(move_to_position_bfs(env._current_state.pos, target_pos))\n              \n              # Turn to face the workshop\n              current_dir = env._current_state.dir\n              target_dir = (target_pos[1] - env._current_state.pos[1], target_pos[0] - env._current_state.pos[0])\n              actions.extend(turn_towards(current_dir, target_dir))\n\n              # Perform the USE action to start crafting\n              actions.append(4)  # USE action index\n  \n  return actions", "island_id": 3, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T05:56:09.851871", "function_name": "craft", "function_body": "  def move_to_position_bfs(current_pos: tuple, target_pos: tuple) -> list[int]:\n    \"\"\"Helper function to calculate the sequence of movements from current position to target position using BFS.\"\"\"\n    grid = env._current_state.grid[:, :, 0] == 0  # Assuming the first layer is walkable\n    width, height = grid.shape\n\n    queue = collections.deque([(current_pos[1], current_pos[0], [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n\n      if (x, y) == target_pos:\n        return path\n      \n      if (x, y) in visited:\n        continue\n      \n      visited.add((x, y))\n      \n      directions = [(0, 1, 2), (0, -1, 3), (1, 0, 0), (-1, 0, 1)]  # RIGHT, LEFT, DOWN, UP\n      for dx, dy, dir_idx in directions:\n        nx, ny = x + dx, y + dy\n\n        if 0 <= nx < height and 0 <= ny < width and grid[nx, ny]:\n          queue.append((nx, ny, path + [dir_idx]))\n    \n    return []  # If no path found, return an empty list\n\n\n  def find_workshop(workshop_type, workshop_indices):\n    if workshop_type in [\"workshop_0\", \"workshop_1\", \"workshop_2\"]:\n        return workshop_indices[int(workshop_type.split(\"_\")[1])]\n    else:\n        return None\n\n  actions = []\n\n  # Get the index of the desired item to be crafted\n  item_index = env.world.cookbook.index[item]\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n\n  if \"_key\" in recipe:\n      workshop_type = recipe[\"_key\"]\n\n      # Find the index of the corresponding workshop in the world configuration\n      workshop_indices = env.world.workshop_indices\n\n      selected_workshop_index = find_workshop(workshop_type, workshop_indices)\n      \n      if selected_workshop_index is not None:\n          # Determine the position of the selected workshop from the current state's grid\n          workshop_positions = np.argwhere(env._current_state.grid[:, :, selected_workshop_index] > 0)\n\n          if len(workshop_positions) > 0:\n              target_pos = (workshop_positions[0][1], workshop_positions[0][0])\n\n              # Move to the target position of the workshop\n              actions.extend(move_to_position_bfs(env._current_state.pos, target_pos))\n              \n              # Perform the USE action to start crafting\n              actions.append(4)  # USE action index\n  \n  return actions", "island_id": 3, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T05:58:07.062513", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    # A* pathfinding algorithm for more efficient movement\n    open_set = collections.deque([current_pos])\n    came_from = {}\n    g_score = {current_pos: 0}\n    f_score = {current_pos: abs(target_pos[0] - current_pos[0]) + abs(target_pos[1] - current_pos[1])}\n\n    while open_set:\n      current = open_set.popleft()\n      \n      if current == target_pos:\n        break\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        \n        tentative_g_score = g_score[current] + 1\n        \n        if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n          came_from[neighbor] = current\n          g_score[neighbor] = tentative_g_score\n          f_score[neighbor] = tentative_g_score + abs(target_pos[0] - neighbor[0]) + abs(target_pos[1] - neighbor[1])\n          open_set.append(neighbor)\n\n    # Reconstruct path\n    total_path = []\n    while current in came_from:\n      total_path.append(current)\n      current = came_from[current]\n    total_path.reverse()\n\n    for next_pos in total_path:\n      dx = next_pos[0] - current_pos[0]\n      dy = next_pos[1] - current_pos[1]\n\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      elif dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n\n      current_pos = next_pos\n      \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 6, "scores": {"": 4.7}}
{"timestamp": "2025-09-03T05:58:08.125723", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    # A* pathfinding algorithm for more efficient movement\n    open_set = collections.deque([current_pos])\n    came_from = {}\n    g_score = {current_pos: 0}\n    f_score = {current_pos: abs(target_pos[0] - current_pos[0]) + abs(target_pos[1] - current_pos[1])}\n\n    while open_set:\n      current = open_set.popleft()\n      \n      if current == target_pos:\n        break\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        \n        tentative_g_score = g_score[current] + 1\n        \n        if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n          came_from[neighbor] = current\n          g_score[neighbor] = tentative_g_score\n          f_score[neighbor] = tentative_g_score + abs(target_pos[0] - neighbor[0]) + abs(target_pos[1] - neighbor[1])\n          open_set.append(neighbor)\n\n    # Reconstruct path\n    total_path = []\n    while current in came_from:\n      total_path.append(current)\n      current = came_from[current]\n    total_path.reverse()\n\n    for next_pos in total_path:\n      dx = next_pos[0] - current_pos[0]\n      dy = next_pos[1] - current_pos[1]\n\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      elif dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n\n      current_pos = next_pos\n      \n    return actions\n\n  def collect_primitives(env, primitives):\n    \"\"\"Collect the required primitives for crafting the item.\"\"\"\n    actions = []\n    \n    for primitive in primitives:\n        # Find the closest resource of the primitive\n        primitive_index = env.world.cookbook.index[primitive]\n        grid = env._current_state.grid\n        pos = env._current_state.pos\n        closest_resource_pos = find_closest_primitive(grid, pos, primitive_index)\n        \n        if not closest_resource_pos:\n            raise ValueError(f\"No available {primitive} found on the grid.\")\n        \n        # Move to the closest resource and collect it\n        actions.extend(move_to(env, closest_resource_pos))\n        actions.append(env.world.n_actions - 2)  # Assuming the second last action index corresponds to COLLECT\n        \n    return actions\n\n  def find_closest_primitive(grid, pos, primitive_index):\n    min_distance = float('inf')\n    closest_primitive_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if grid[i, j, primitive_index] > 0:\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_primitive_pos = (i, j)\n    return closest_primitive_pos\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which primitives are required for crafting this item\n  recipe = env.world.cookbook.recipes[item_index]\n  required_primitives = [env.world.cookbook.index[primitive] for primitive in recipe if primitive in env.world.cookbook.index]\n\n  # Collect the required primitives\n  actions_to_collect_primitives = collect_primitives(env, required_primitives)\n  \n  # Determine which workshop is required for crafting this item\n  # This step assumes that the recipe specifies the workshop type needed.\n  # Since the problem does not specify how to determine the workshop,\n  # we will assume that all workshops can craft any items for simplicity.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_collect_primitives + actions_to_workshop", "island_id": 6, "scores": {"": 4.7}}
