{"timestamp": "2025-09-02T22:08:15.573336", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n  \n  # Find the appropriate workshop based on the recipe key\n  workshop_name = None\n  for output_idx, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n          workshop_name = ingredients.get(\"_workshop\")\n          break\n\n  if not workshop_name:\n      return []  # No specific workshop needed or specified\n\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the workshop in the grid\n  grid_shape = env._current_state.grid.shape[:2]\n  workshop_pos = None\n\n  for y in range(grid_shape[1]):\n      for x in range(grid_shape[0]):\n          if np.any(env._current_state.grid[x, y] == workshop_index):\n              workshop_pos = (x, y)\n              break\n      if workshop_pos:\n          break\n  \n  if not workshop_pos:\n      return []  # Workshop not found in the grid\n\n  # Calculate path to the workshop\n  actions_to_workshop = []\n  agent_pos = np.array(env._current_state.pos)\n  target_pos = np.array(workshop_pos)\n\n  while not np.all(agent_pos == target_pos):\n      if agent_pos[0] < target_pos[0]:\n          actions_to_workshop.append(3)  # RIGHT\n          agent_pos[0] += 1\n      elif agent_pos[0] > target_pos[0]:\n          actions_to_workshop.append(2)  # LEFT\n          agent_pos[0] -= 1\n      elif agent_pos[1] < target_pos[1]:\n          actions_to_workshop.append(1)  # UP\n          agent_pos[1] += 1\n      else:\n          actions_to_workshop.append(0)  # DOWN\n          agent_pos[1] -= 1\n\n  actions_to_workshop.append(4)  # USE to craft the item\n  \n  return actions_to_workshop", "island_id": 2, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T22:08:16.622193", "function_name": "craft", "function_body": "  def pathfind(agent_pos: np.ndarray, target_pos: np.ndarray) -> list[int]:\n    \"\"\"Pathfinding function to navigate the grid.\"\"\"\n    actions = []\n    while not np.all(agent_pos == target_pos):\n      if agent_pos[0] < target_pos[0]:\n          actions.append(3)  # RIGHT\n          agent_pos[0] += 1\n      elif agent_pos[0] > target_pos[0]:\n          actions.append(2)  # LEFT\n          agent_pos[0] -= 1\n      elif agent_pos[1] < target_pos[1]:\n          actions.append(1)  # UP\n          agent_pos[1] += 1\n      else:\n          actions.append(0)  # DOWN\n          agent_pos[1] -= 1\n    return actions\n\n  item_index = env.world.cookbook.index[item]\n  \n  recipe_key = None\n  workshop_name = None\n  \n  for output_idx, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n          recipe_key = output_idx\n          workshop_name = ingredients.get(\"_workshop\")\n          break\n\n  if not workshop_name:\n      return []  # No specific workshop needed or specified\n  \n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the workshop in the grid\n  grid_shape = env._current_state.grid.shape[:2]\n  workshop_pos = None\n\n  for y in range(grid_shape[1]):\n      for x in range(grid_shape[0]):\n          if np.any(env._current_state.grid[x, y] == workshop_index):\n              workshop_pos = (x, y)\n              break\n      if workshop_pos:\n          break\n  \n  if not workshop_pos:\n      return []  # Workshop not found in the grid\n\n  # Calculate path to the workshop and perform the USE action\n  actions_to_workshop = pathfind(np.array(env._current_state.pos), np.array(workshop_pos))\n  actions_to_workshop.append(4)  # USE\n\n  return actions_to_workshop", "island_id": 2, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T22:08:54.174851", "function_name": "craft", "function_body": "  # Extracting the index of the goal item\n  goal_index = env.world.cookbook.index[item]\n  \n  # Retrieving the recipe for the goal item from the cookbook\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  # Extracting the workshop index (if any) required to craft the item\n  workshop_index = None\n  if \"_key\" in recipe:\n    workshop_key = recipe[\"_key\"]\n    if workshop_key.startswith(\"workshop\"):\n      workshop_index = int(workshop_key[-1])\n\n  actions = []\n\n  # If a workshop is needed, navigate to it\n  if workshop_index is not None:\n    workshop_positions = [\n        pos for pos, kind in np.ndenumerate(env._current_state.grid[:, :, :])\n        if kind == env.world.workshop_indices[workshop_index]\n    ]\n    \n    # Assuming the agent can navigate to any of the workshops randomly\n    target_pos = workshop_positions[0]\n\n    # Calculate the direction and steps needed to reach the workshop\n    current_pos = env._current_state.pos\n    dx = target_pos[1] - current_pos[1]\n    dy = target_pos[0] - current_pos[0]\n\n    # Determine the actions required to move towards the target position\n    if dx > 0:\n        actions.extend([craft.LEFT] * abs(dx))\n    elif dx < 0:\n        actions.extend([craft.RIGHT] * abs(dx))\n    if dy > 0:\n        actions.extend([craft.DOWN] * abs(dy))\n    elif dy < 0:\n        actions.extend([craft.UP] * abs(dy))\n\n  # Perform the crafting action\n  actions.append(craft.USE)\n\n  return actions", "island_id": 0, "scores": {"": -1}}
{"timestamp": "2025-09-02T22:08:55.139251", "function_name": "craft", "function_body": "  # Find the index for the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Find the workshop that can craft the desired item\n  recipe = None\n  for output_idx, ingredients in env.world.cookbook.recipes.items():\n    if output_idx == item_index:\n      recipe = ingredients\n      break\n  \n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  # Find the index of the workshop that can craft this item\n  workshop_indices = env.world.workshop_indices\n  # We assume here that any workshop can craft anything; otherwise, we'd need to check the recipe ingredients\n  workshop_index = workshop_indices[0]\n  \n  # Get the position of the nearest workshop\n  pos_x, pos_y = find_nearest_workshop(env._current_state.grid, workshop_index)\n  \n  # Calculate actions needed to move to the nearest workshop\n  move_actions = navigate_to_pos(env, (pos_x, pos_y))\n  \n  # Add USE action to perform crafting at the workshop\n  use_action = env.world.n_actions - 1  # Assuming USE is the last action\n  \n  return move_actions + [use_action]", "island_id": 0, "scores": {"": -1}}
{"timestamp": "2025-09-02T22:10:24.850504", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n\n  # Find the recipe for the desired item and determine the required workshop\n  recipe = None\n  for output_idx, ingredients in env.world.cookbook.recipes.items():\n    if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n      recipe = ingredients\n      break\n\n  # If no specific workshop is required or not found in the recipe, return an empty list of actions\n  if recipe is None or \"_workshop\" not in recipe:\n    return []\n\n  # Get the index of the workshop from the cookbook's index\n  workshop_name = recipe[\"_workshop\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the workshop in the grid\n  workshop_pos = None\n  for y in range(env._current_state.grid.shape[0]):\n    for x in range(env._current_state.grid.shape[1]):\n      if np.any(env._current_state.grid[y, x] == workshop_index):\n        workshop_pos = (x, y)\n        break\n    if workshop_pos is not None:\n      break\n\n  # If the workshop is not found in the grid, return an empty list of actions\n  if workshop_pos is None:\n    return []\n\n  # Calculate the path to the workshop using A* search algorithm for better efficiency\n  start_x, start_y = env._current_state.pos\n  end_x, end_y = workshop_pos\n\n  def heuristic(a, b):\n    \"\"\"Manhattan distance heuristic.\"\"\"\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  open_set = []\n  closed_set = set()\n  g_costs = {start_x * env._current_state.grid.shape[0] + start_y: 0}\n  f_costs = {start_x * env._current_state.grid.shape[0] + start_y: heuristic((start_x, start_y), (end_x, end_y))}\n  came_from = {}\n\n  open_set.append((f_costs[start_x * env._current_state.grid.shape[0] + start_y], (start_x, start_y)))\n\n  while open_set:\n    _, current = min(open_set, key=lambda o: o[0])\n    open_set.remove(min(open_set, key=lambda o: o[0]))\n\n    if current == (end_x, end_y):\n      break\n\n    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        if 0 <= neighbor[0] < env._current_state.grid.shape[0] and 0 <= neighbor[1] < env._current_state.grid.shape[1]:\n            tentative_g_cost = g_costs[current[0] * env._current_state.grid.shape[0] + current[1]] + 1\n            neighbor_index = neighbor[0] * env._current_state.grid.shape[0] + neighbor[1]\n            \n            if neighbor not in closed_set or tentative_g_cost < g_costs.get(neighbor_index, float('inf')):\n                came_from[neighbor] = current\n                g_costs[neighbor_index] = tentative_g_cost\n                f_costs[neighbor_index] = tentative_g_cost + heuristic(neighbor, (end_x, end_y))\n                \n                if neighbor not in [o[1] for o in open_set]:\n                    open_set.append((f_costs[neighbor_index], neighbor))\n\n    closed_set.add(current)\n\n  # If the goal was reached, reconstruct the path\n  if (end_x, end_y) in came_from:\n      current = (end_x, end_y)\n      total_path = [current]\n      while current in came_from:\n          current = came_from[current]\n          total_path.append(current)\n      total_path.reverse()\n      \n      # Convert path to actions\n      actions_to_workshop = []\n      for i in range(len(total_path) - 1):\n          if total_path[i + 1][0] > total_path[i][0]:\n              actions_to_workshop.append(env.N_RIGHT)\n          elif total_path[i + 1][0] < total_path[i][0]:\n              actions_to_workshop.append(env.N_LEFT)\n          elif total_path[i + 1][1] > total_path[i][1]:\n              actions_to_workshop.append(env.N_DOWN)\n          else:\n              actions_to_workshop.append(env.N_UP)\n      \n      # Add the USE action to craft the item\n      actions_to_workshop.append(env.N_USE)\n\n      return actions_to_workshop\n\n  # If no path is found, return an empty list of actions\n  return []", "island_id": 2, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T22:10:25.929633", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, workshop_indices):\n      agent_pos = env._current_state.pos\n      closest_workshop_pos = None\n      min_distance = float('inf')\n      \n      for y in range(grid.shape[0]):\n          for x in range(grid.shape[1]):\n              if np.any(np.isin(grid[y, x], workshop_indices)):\n                  distance = abs(x - agent_pos[0]) + abs(y - agent_pos[1])\n                  if distance < min_distance:\n                      min_distance = distance\n                      closest_workshop_pos = (x, y)\n      return closest_workshop_pos\n\n  item_index = env.world.cookbook.index[item]\n\n  # Find the workshop required for crafting this item (if any)\n  recipe = None\n  for output, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" not in ingredients:\n          continue\n      if ingredients[\"_key\"] == item_index:\n          recipe = ingredients\n          break\n\n  # If no specific workshop is required, return an empty list of actions\n  if recipe is None or \"_workshop\" not in recipe:\n      return []\n\n  # Get the index of the workshop from the cookbook's index\n  workshop_name = recipe[\"_workshop\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the closest workshop in the grid\n  workshop_pos = find_closest_workshop(env._current_state.grid, [workshop_index])\n\n  # If the workshop is not found in the grid, return an empty list of actions\n  if workshop_pos is None:\n      return []\n\n  # Calculate the path to the workshop using Manhattan distance heuristic\n  start_x, start_y = env._current_state.pos\n  end_x, end_y = workshop_pos\n  actions_to_workshop = []\n  \n  while start_x != end_x or start_y != end_y:\n      if start_x < end_x:\n          actions_to_workshop.append(env.N_RIGHT)\n          start_x += 1\n      elif start_x > end_x:\n          actions_to_workshop.append(env.N_LEFT)\n          start_x -= 1\n      elif start_y < end_y:\n          actions_to_workshop.append(env.N_DOWN)\n          start_y += 1\n      else:\n          actions_to_workshop.append(env.N_UP)\n          start_y -= 1\n  \n  # Add the USE action to craft the item\n  actions_to_workshop.append(env.N_USE)\n\n  return actions_to_workshop", "island_id": 2, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T22:11:58.768950", "function_name": "craft", "function_body": "  def get_workshop_for_item(item_index):\n    for workshop, recipes in env.world.cookbook.recipes.items():\n        if '_key' in recipes and item_index == recipes['_key']:\n            return workshop\n    return None\n\n  def find_nearest_workshop(env, workshop_index):\n      \"\"\"Find the nearest workshop of a given type using A*.\"\"\"\n      world = env.world\n      grid = env._current_state.grid\n      pos = env._current_state.pos\n      \n      # Define heuristic function for A*\n      def heuristic(a, b):\n          return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n      open_set = collections.PriorityQueue()\n      open_set.put((0, pos))\n      came_from = {}\n      cost_so_far = {}\n      came_from[pos] = None\n      cost_so_far[pos] = 0\n\n      while not open_set.empty():\n          _, current = open_set.get()\n\n          # Check if the current cell is a workshop of the required type\n          if world.workshop_indices[workshop_index - len(world.primitives)] == np.argmax(grid[current]):\n              return reconstruct_path(came_from, pos, current)\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              new_cost = cost_so_far[current] + heuristic(current, neighbor)\n\n              if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n                  if neighbor not in cost_so_far or new_cost < cost_so_far[neighbor]:\n                      cost_so_far[neighbor] = new_cost\n                      priority = new_cost + heuristic(neighbor, current)\n                      open_set.put((priority, neighbor))\n                      came_from[neighbor] = current\n\n      return None\n\n  def reconstruct_path(came_from, start, goal):\n      \"\"\"Reconstruct the path from the start to the goal.\"\"\"\n      current = goal\n      path = []\n      while current != start:\n          path.append(current)\n          current = came_from[current]\n      path.reverse()\n      return path\n\n  def navigate_to(env, target_location):\n      \"\"\"Navigate to a target location on the grid.\"\"\"\n      world = env.world\n      actions = []\n      \n      for i in range(1, len(target_location)):\n          dx = target_location[i][0] - target_location[i-1][0]\n          dy = target_location[i][1] - target_location[i-1][1]\n          \n          if (dx, dy) == (-1, 0):  # UP\n              actions.append(env.action_specs()['UP'])\n          elif (dx, dy) == (1, 0):  # DOWN\n              actions.append(env.action_specs()['DOWN'])\n          elif (dx, dy) == (0, -1):  # LEFT\n              actions.append(env.action_specs()['LEFT'])\n          elif (dx, dy) == (0, 1):  # RIGHT\n              actions.append(env.action_specs()['RIGHT'])\n\n      return actions\n\n  def craft_item(env):\n    \"\"\"Use the workshop to craft the item.\"\"\"\n    return [env.action_specs()['USE']]\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Find the workshop that allows crafting this item (if any)\n  workshop_index = get_workshop_for_item(item_index)\n\n  actions = []\n\n  if workshop_index is not None:\n      # Get the location of the nearest workshop of the required type\n      nearest_workshop_location = find_nearest_workshop(env, workshop_index)\n      \n      if nearest_workshop_location is not None:\n          # Navigate to the workshop location\n          actions.extend(navigate_to(env, nearest_workshop_location))\n          \n          # Craft the item using the workshop\n          actions.extend(craft_item(env))\n  \n  return actions", "island_id": 9, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T22:11:59.849416", "function_name": "craft", "function_body": "  def get_workshop_for_item(item_index):\n    \"\"\"Find the workshop that allows crafting this item.\"\"\"\n    for workshop in env.world.workshop_indices:\n        if any('_key' in recipes and item_index == recipes['_key'] for recipes in env.world.cookbook.recipes.get(workshop, {}).values()):\n            return workshop\n    return None\n\n  def find_nearest_workshop(env, workshop_index):\n      \"\"\"Find the nearest workshop of a given type.\"\"\"\n      world = env.world\n      grid = env._current_state.grid\n      pos = env._current_state.pos\n      \n      # Initialize BFS with starting position\n      queue = collections.deque([(pos[0], pos[1], [])])\n      visited = set([pos])\n\n      while queue:\n          x, y, path = queue.popleft()\n          \n          if np.argmax(grid[x, y]) == workshop_index - len(world.primitives):\n              return (x, y), path\n          \n          # Explore neighbors in all four directions\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and (nx, ny) not in visited:\n                  queue.append((nx, ny, path + [(dx, dy)]))\n                  visited.add((nx, ny))\n      \n      return None\n\n  def navigate_to(env, target_location):\n      \"\"\"Navigate to a target location on the grid.\"\"\"\n      world = env.world\n      actions = []\n      \n      for dx, dy in target_location[1]:\n          if (dx, dy) == (-1, 0):  # UP\n              actions.append(world.N_ACTIONS - 4)\n          elif (dx, dy) == (1, 0):  # DOWN\n              actions.append(world.N_ACTIONS - 3)\n          elif (dx, dy) == (0, -1):  # LEFT\n              actions.append(world.N_ACTIONS - 2)\n          elif (dx, dy) == (0, 1):  # RIGHT\n              actions.append(world.N_ACTIONS - 1)\n\n      return actions\n\n  def craft_item(env):\n    \"\"\"Use the workshop to craft the item.\"\"\"\n    return [world.N_ACTIONS - 5]\n\n  world = env.world\n  cookbook = world.cookbook\n  \n  item_index = cookbook.index[item]\n  \n  # Find the workshop that allows crafting this item (if any)\n  workshop_index = get_workshop_for_item(item_index)\n\n  actions = []\n\n  if workshop_index is not None:\n      # Get the location of the nearest workshop of the required type\n      nearest_workshop_location = find_nearest_workshop(env, workshop_index)\n      \n      if nearest_workshop_location is not None:\n          # Navigate to the workshop location\n          actions.extend(navigate_to(env, nearest_workshop_location))\n          \n          # Craft the item using the workshop\n          actions.extend(craft_item(env))\n  \n  return actions", "island_id": 9, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T22:13:05.270640", "function_name": "craft", "function_body": "  index = env.world.cookbook.index\n  item_index = index[item]\n  \n  # Get the recipe for the desired item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n  \n  if not recipe:\n      raise ValueError(f\"No recipe found for item {item}.\")\n\n  actions = []\n  \n  # Find required workshops based on ingredient indices in the recipe\n  workshop_indices = set()\n  for ingredient_index in recipe:\n      if ingredient_index == \"_key\":\n          continue\n      \n      # Check all workshops to see which one can produce this ingredient\n      for workshop in env.world.workshop_indices:\n          workshop_recipe = env.world.cookbook.recipes.get(workshop, {})\n          if any(ingredient_index == value for value in workshop_recipe.values()):\n              workshop_indices.add(workshop)\n              break\n\n  # Move to each required workshop and collect ingredients (if necessary)\n  for workshop_index in workshop_indices:\n      # Find the position of the workshop\n      grid = env._current_state.grid\n      positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n      if len(positions) == 0:\n          raise ValueError(f\"No available workshop with index {workshop_index}.\")\n      \n      # Choose the closest workshop\n      pos = env._current_state.pos\n      distances = np.sum(np.abs(positions - pos), axis=1)\n      closest_workshop_pos = tuple(positions[np.argmin(distances)])\n      \n      # Move to the closest workshop\n      actions.extend(navigate_to(env, closest_workshop_pos))\n      \n      # Craft at the workshop (USE action)\n      actions.append(craft.USE)\n\n  return actions", "island_id": 5, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T22:13:06.382528", "function_name": "craft", "function_body": "  def navigate_to(pos):\n    current_pos = env._current_state.pos\n    direction = env._current_state.dir\n\n    # Calculate the difference in positions\n    dx = pos[0] - current_pos[0]\n    dy = pos[1] - current_pos[1]\n\n    actions = []\n\n    # Rotate to face the correct direction\n    if dx > 0 and direction != 2:  # East\n        if direction == 3:\n            actions.append(craft.LEFT)\n        elif direction == 0:\n            actions.append(craft.RIGHT)\n        elif direction == 1:\n            actions.extend([craft.LEFT, craft.LEFT])\n        direction = 2\n    elif dx < 0 and direction != 3:  # West\n        if direction == 2:\n            actions.append(craft.LEFT)\n        elif direction == 0:\n            actions.extend([craft.LEFT, craft.LEFT])\n        elif direction == 1:\n            actions.append(craft.RIGHT)\n        direction = 3\n    elif dy > 0 and direction != 0:  # North\n        if direction == 2:\n            actions.append(craft.LEFT)\n        elif direction == 3:\n            actions.extend([craft.LEFT, craft.LEFT])\n        elif direction == 1:\n            actions.append(craft.RIGHT)\n        direction = 0\n    elif dy < 0 and direction != 1:  # South\n        if direction == 2:\n            actions.append(craft.RIGHT)\n        elif direction == 3:\n            actions.append(craft.LEFT)\n        elif direction == 0:\n            actions.extend([craft.LEFT, craft.LEFT])\n        direction = 1\n\n    # Move to the target position\n    for _ in range(abs(dx)):\n        actions.append(craft.RIGHT if dx > 0 else craft.LEFT)\n\n    for _ in range(abs(dy)):\n        actions.append(craft.UP if dy > 0 else craft.DOWN)\n\n    return actions\n\n  index = env.world.cookbook.index\n  item_index = index[item]\n  \n  # Get the recipe for the desired item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n  \n  if not recipe:\n      raise ValueError(f\"No recipe found for item {item}.\")\n\n  actions = []\n  \n  # Find required workshops based on ingredient indices in the recipe\n  workshop_indices = set()\n  for ingredient_index in recipe:\n      if ingredient_index == \"_key\":\n          continue\n      \n      # Check all workshops to see which one can produce this ingredient\n      for workshop in env.world.workshop_indices:\n          workshop_recipe = env.world.cookbook.recipes.get(workshop, {})\n          if any(ingredient_index == value for value in workshop_recipe.values()):\n              workshop_indices.add(workshop)\n              break\n\n  # Move to each required workshop and collect ingredients (if necessary)\n  for workshop_index in workshop_indices:\n      # Find the position of the workshop\n      grid = env._current_state.grid\n      positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n      if len(positions) == 0:\n          raise ValueError(f\"No available workshop with index {workshop_index}.\")\n      \n      # Choose the closest workshop\n      pos = env._current_state.pos\n      distances = np.sum(np.abs(positions - pos), axis=1)\n      closest_workshop_pos = tuple(positions[np.argmin(distances)])\n      \n      # Move to the closest workshop\n      actions.extend(navigate_to(closest_workshop_pos))\n      \n      # Craft at the workshop (USE action)\n      actions.append(craft.USE)\n\n  return actions", "island_id": 5, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T22:14:11.751060", "function_name": "craft", "function_body": "  def navigate_to(target_pos):\n    current_pos = env._current_state.pos\n    delta_x = target_pos[0] - current_pos[0]\n    delta_y = target_pos[1] - current_pos[1]\n\n    actions = []\n    \n    # Move horizontally\n    if delta_x > 0:\n        actions.extend([craft.RIGHT] * abs(delta_x))\n    elif delta_x < 0:\n        actions.extend([craft.LEFT] * abs(delta_x))\n\n    # Move vertically\n    if delta_y > 0:\n        actions.extend([craft.DOWN] * abs(delta_y))\n    elif delta_y < 0:\n        actions.extend([craft.UP] * abs(delta_y))\n    \n    return actions\n\n  def navigate_and_craft(workshop_index):\n    grid = env._current_state.grid\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n    if len(positions) == 0:\n        raise ValueError(f\"No available workshop with index {workshop_index}.\")\n    \n    # Choose the closest workshop\n    pos = env._current_state.pos\n    distances = np.sum(np.abs(positions - pos), axis=1)\n    closest_workshop_pos = positions[np.argmin(distances)]\n    \n    # Move to the closest workshop\n    actions.extend(navigate_to(tuple(closest_workshop_pos)))\n    \n    # Craft at the workshop (USE action)\n    actions.append(craft.USE)\n\n  index = env.world.cookbook.index\n  item_index = index[item]\n  \n  # Get the recipe for the desired item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n  \n  if not recipe:\n      raise ValueError(f\"No recipe found for item {item}.\")\n\n  # Find required workshop types based on ingredient indices in the recipe\n  workshop_indices = set()\n  for ingredient_index in recipe:\n      if ingredient_index == \"_key\":\n          continue\n      \n      # Check all workshops to see which one can produce this ingredient\n      for workshop in env.world.workshop_indices:\n          workshop_recipe = env.world.cookbook.recipes.get(workshop, {})\n          if any(ingredient_index == value for value in workshop_recipe.values()):\n              workshop_indices.add(workshop)\n              break\n\n  actions = []\n  \n  # Move to each required workshop and collect ingredients (if necessary)\n  for workshop_index in workshop_indices:\n      navigate_and_craft(workshop_index)\n\n  return actions", "island_id": 5, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T22:14:12.792005", "function_name": "craft", "function_body": "  def navigate_to(target_pos):\n    current_pos = env._current_state.pos\n    delta_x = target_pos[0] - current_pos[0]\n    delta_y = target_pos[1] - current_pos[1]\n\n    actions = []\n    \n    # Move in the x direction\n    if delta_x > 0:\n        actions.extend([craft.RIGHT]*delta_x)\n    elif delta_x < 0:\n        actions.extend([craft.LEFT]*abs(delta_x))\n    \n    # Move in the y direction\n    if delta_y > 0:\n        actions.extend([craft.DOWN]*delta_y)\n    elif delta_y < 0:\n        actions.extend([craft.UP]*abs(delta_y))\n    \n    return actions\n\n  def navigate_and_craft(workshop_index):\n    grid = env._current_state.grid\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n    if len(positions) == 0:\n        raise ValueError(f\"No available workshop with index {workshop_index}.\")\n    \n    # Choose the closest workshop\n    pos = env._current_state.pos\n    distances = np.sum(np.abs(positions - pos), axis=1)\n    closest_workshop_pos = tuple(positions[np.argmin(distances)])\n    \n    # Move to the closest workshop\n    actions.extend(navigate_to(closest_workshop_pos))\n    \n    # Craft at the workshop (USE action)\n    actions.append(craft.USE)\n\n  index = env.world.cookbook.index\n  item_index = index[item]\n  \n  # Get the recipe for the desired item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n  \n  if not recipe:\n      raise ValueError(f\"No recipe found for item {item}.\")\n\n  # Find required workshop types based on ingredient indices in the recipe\n  workshop_indices = []\n  for ingredient_index in recipe:\n      if ingredient_index == \"_key\":\n          continue\n      for workshop in env.world.workshop_indices:\n          if ingredient_index in env.world.cookbook.recipes.get(workshop, {}).values():\n              workshop_indices.append(workshop)\n              break\n  \n  # Remove duplicates\n  workshop_indices = list(set(workshop_indices))\n  \n  actions = []\n  for workshop_index in workshop_indices:\n      navigate_and_craft(workshop_index)\n\n  return actions", "island_id": 5, "scores": {"": 0.0}}
