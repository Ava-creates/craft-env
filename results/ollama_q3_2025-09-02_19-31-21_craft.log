em\n  # This step assumes that the recipe specifies the workshop type needed.\n  # Since the problem does not specify how to determine the workshop,\n  # we will assume that all workshops can craft any items for simplicity.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Check if we are already at the target position\n  if env._current_state.pos != closest_workshop_pos:\n      actions_to_workshop.append(4)  # Adjust action index for USE\n  \n  return actions_to_workshop", "island_id": 9, "scores": {"": 4.7}}
{"timestamp": "2025-09-03T14:55:12.560413", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Iterate over all positions to find the closest workshop\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if any(grid[i, j, w] > 0 for w in workshop_indices):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    # A* pathfinding algorithm for more efficient movement\n    open_set = collections.deque([current_pos])\n    came_from = {}\n    g_score = {current_pos: 0}\n    f_score = {current_pos: abs(target_pos[0] - current_pos[0]) + abs(target_pos[1] - current_pos[1])}\n\n    while open_set:\n      # Get the position with the lowest f_score\n      current = min(open_set, key=lambda x: f_score[x])\n      open_set.remove(current)\n      \n      if current == target_pos:\n        break\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        \n        tentative_g_score = g_score[current] + 1\n        \n        if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n          came_from[neighbor] = current\n          g_score[neighbor] = tentative_g_score\n          f_score[neighbor] = tentative_g_score + abs(target_pos[0] - neighbor[0]) + abs(target_pos[1] - neighbor[1])\n          open_set.append(neighbor)\n\n    # Reconstruct path\n    total_path = []\n    while current in came_from:\n      total_path.append(current)\n      current = came_from[current]\n    total_path.reverse()\n\n    for next_pos in total_path:\n      dx = next_pos[0] - current_pos[0]\n      dy = next_pos[1] - current_pos[1]\n\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      elif dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n\n      current_pos = next_pos\n      \n    return actions\n\n  def collect_primitives(env, primitives):\n    \"\"\"Collect the required primitives to craft the item.\"\"\"\n    actions = []\n    \n    for primitive in primitives:\n        grid = env._current_state.grid\n        pos = env._current_state.pos\n        \n        # Find all positions of the primitive on the grid\n        primitive_indices = [i for i, w in enumerate(env.world.workshop_indices) if w == primitive]\n        if not primitive_indices:\n            raise ValueError(f\"Primitive '{primitive}' not found in the world.\")\n        \n        target_pos = None\n        min_distance = float('inf')\n        \n        # Find the closest position of the primitive to the current agent position\n        for i in range(grid.shape[0]):\n          for j in range(grid.shape[1]):\n            if any(grid[i, j, p] > 0 for p in primitive_indices):\n              distance = abs(i - pos[0]) + abs(j - pos[1])\n              if distance < min_distance:\n                min_distance = distance\n                target_pos = (i, j)\n        \n        if not target_pos:\n            raise ValueError(f\"Position of primitive '{primitive}' not found on the grid.\")\n        \n        # Move to the target position and collect the primitive\n        actions.extend(move_to(env, target_pos))\n        actions.append(4)  # Assuming action index 4 corresponds to PICKUP (not defined in original problem)\n    \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n  \n  # Get the required primitives for crafting the item\n  recipe = env.world.cookbook.recipes[item_index]\n  primitives = [p for p in recipe if p in env.world.workshop_indices]\n\n  # Collect the required primitives\n  actions_to_collect_primitives = collect_primitives(env, primitives)\n\n  # Determine which workshop is required for crafting this item\n  # This step assumes that the recipe specifies the workshop type needed.\n  # Since the problem does not specify how to determine the workshop,\n  # we will assume that all workshops can craft any items for simplicity.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_collect_primitives + actions_to_workshop", "island_id": 0, "scores": {"": 4.7}}
{"timestamp": "2025-09-03T14:55:13.607841", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Iterate over all positions to find the closest workshop\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if any(grid[i, j, w] > 0 for w in workshop_indices):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    # A* pathfinding algorithm for more efficient movement\n    open_set = collections.deque([current_pos])\n    came_from = {}\n    g_score = {current_pos: 0}\n    f_score = {current_pos: abs(target_pos[0] - current_pos[0]) + abs(target_pos[1] - current_pos[1])}\n\n    while open_set:\n      # Get the position with the lowest f_score\n      current = min(open_set, key=lambda x: f_score[x])\n      open_set.remove(current)\n      \n      if current == target_pos:\n        break\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        \n        tentative_g_score = g_score[current] + 1\n        \n        if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n          came_from[neighbor] = current\n          g_score[neighbor] = tentative_g_score\n          f_score[neighbor] = tentative_g_score + abs(target_pos[0] - neighbor[0]) + abs(target_pos[1] - neighbor[1])\n          open_set.append(neighbor)\n\n    # Reconstruct path\n    total_path = []\n    while current in came_from:\n      total_path.append(current)\n      current = came_from[current]\n    total_path.reverse()\n\n    for next_pos in total_path:\n      dx = next_pos[0] - current_pos[0]\n      dy = next_pos[1] - current_pos[1]\n\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      elif dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n\n      current_pos = next_pos\n      \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  # This step assumes that the recipe specifies the workshop type needed.\n  # Since the problem does not specify how to determine the workshop,\n  # we will assume that all workshops can craft any items for simplicity.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 0, "scores": {"": 4.7}}
{"timestamp": "2025-09-03T14:57:31.905550", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Iterate over all positions in the grid to find the nearest workshop\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if any(grid[i, j, w] > 0 for w in workshop_indices):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def find_closest_primitive(grid, pos, primitive_index):\n    min_distance = float('inf')\n    closest_primitive_pos = None\n    \n    # Iterate over all positions in the grid to find the nearest primitive\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if grid[i, j, primitive_index] > 0:\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_primitive_pos = (i, j)\n    return closest_primitive_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    # A* pathfinding algorithm to find the shortest path to the target position\n    open_set = collections.deque([(0, current_pos)])  # Priority queue with (f_score, position)\n    came_from = {}\n    g_score = {current_pos: 0}\n    f_score = {current_pos: abs(target_pos[0] - current_pos[0]) + abs(target_pos[1] - target_pos[1])}\n\n    while open_set:\n      _, current = open_set.popleft()\n      \n      if current == target_pos:\n        break\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        \n        tentative_g_score = g_score[current] + 1\n        \n        if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n          came_from[neighbor] = current\n          g_score[neighbor] = tentative_g_score\n          f_score[neighbor] = tentative_g_score + abs(target_pos[0] - neighbor[0]) + abs(target_pos[1] - neighbor[1])\n          open_set.append((f_score[neighbor], neighbor))\n\n    # Reconstruct path\n    total_path = []\n    while current in came_from:\n      total_path.append(current)\n      current = came_from[current]\n    total_path.reverse()\n\n    for next_pos in total_path:\n      dx = next_pos[0] - current_pos[0]\n      dy = next_pos[1] - current_pos[1]\n\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      elif dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n\n      current_pos = next_pos\n      \n    return actions\n  \n  def get_workshop_type(item_index):\n    # Placeholder function to determine the required workshop type for an item.\n    # This function should be replaced with actual logic based on the recipes.\n    if \"_workshop1\" in env.world.cookbook.recipes[item_index].keys():\n      return env.world.workshop_indices[0]\n    elif \"_workshop2\" in env.world.cookbook.recipes[item_index].keys():\n      return env.world.workshop_indices[1]\n    else:\n      return env.world.workshop_indices[2]  # Assume all workshops can craft any items\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  workshop_type = get_workshop_type(item_index)\n\n  # Find the closest workshop of the required type\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Check for nearby primitives before using the USE action\n  needed_primitives = env.world.cookbook.recipes[item_index].get('ingredients', [])\n  current_inventory = env._current_state.inventory\n\n  # Collect primitives if they are not in the inventory\n  actions_to_collect_primitives = []\n  for primitive in needed_primitives:\n    if primitive not in current_inventory or current_inventory[primitive] == 0:\n      # Find the closest position of this primitive\n      primitive_pos = find_closest_primitive(grid, pos, primitive)\n      \n      if not primitive_pos:\n        raise ValueError(f\"Primitive '{primitive}' not found on the grid.\")\n      \n      actions_to_collect_primitives.extend(move_to(env, primitive_pos))\n      actions_to_collect_primitives.append(4)  # Assuming action index 4 corresponds to COLLECT\n      \n      # Move back to the closest workshop\n      actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.extend(actions_to_collect_primitives)\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 6, "scores": {"": 4.7}}
