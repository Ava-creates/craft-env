Turn to face the workshop (simple direction check for now)\n              current_dir = env._current_state.dir\n              target_dir = calculate_direction_to_face(env._current_state.pos, target_pos)\n              actions.extend(turn_towards(current_dir, target_dir))\n              \n              # Perform the USE action to start crafting\n              actions.append(4)  # USE action index\n  \n  return actions", "island_id": 3, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T01:56:51.251824", "function_name": "craft", "function_body": "  # Get the index of the item to craft\n  goal_index = env.world.cookbook.index[item]\n  \n  # Get the recipe for the item from the cookbook\n  recipe = env.world.cookbook.recipes.get(goal_index, {})\n  \n  if not recipe:\n    raise ValueError(f\"No recipe found for item {item}\")\n    \n  actions = []\n  \n  # Determine which workshop to use based on the ingredients needed\n  required_workshops = set()\n  for ingredient, count in recipe.items():\n      if ingredient != \"_key\":  # Assuming _key is a special keyword and not an actual ingredient\n          ingredient_index = int(ingredient)\n          if ingredient_index in env.world.cookbook.primitives:\n              # Find the workshop that can craft this primitive\n              for workshop_index in env.world.workshop_indices:\n                  # Here we assume there's some way to determine which workshops can craft which primitives\n                  # This part needs more information about how to determine the correct workshop\n                  pass\n          required_workshops.add(workshop_index)\n  \n  if not required_workshops:\n    raise ValueError(f\"No suitable workshop found for crafting {item}\")\n\n  # For simplicity, let's assume we go to the first workshop in the list\n  target_workshop = env.world.workshop_indices[0]\n  \n  # Move to the target workshop (this part needs more logic to determine the path)\n  actions.extend(move_to(env, target_workshop))\n  \n  # Perform the USE action to craft the item\n  actions.append(craft.USE)\n\n  return actions", "island_id": 1, "scores": {"": -1}}
{"timestamp": "2025-09-03T01:56:52.213783", "function_name": "craft", "function_body": "  # Get the index for the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the item is in the inventory\n  if env._current_state.inventory[item_index] > 0:\n      return []\n  \n  # Find the workshop that can be used to craft the item\n  for workshop_index in env.world.workshop_indices:\n      # Get the recipe for the item from the cookbook\n      recipe = env.world.cookbook.recipes.get(item_index, None)\n      \n      if not recipe:\n          raise ValueError(f\"No recipe found for item: {item}\")\n      \n      # Check if this workshop can craft the item based on its ingredients\n      can_craft = True\n      for ingredient_index in recipe.keys():\n          if ingredient_index != \"_key\" and env._current_state.inventory[ingredient_index] < recipe[ingredient_index]:\n              can_craft = False\n              break\n      \n      if can_craft:\n          # Move to the workshop location (assuming the agent starts at a valid position)\n          actions = move_to_workshop(env, workshop_index)\n\n          # Use action to craft the item\n          actions.append(4)  # 4 corresponds to USE in the environment\n\n          return actions\n  \n  raise ValueError(f\"No suitable workshop found for crafting item: {item}\")", "island_id": 1, "scores": {"": -1}}
{"timestamp": "2025-09-03T01:58:33.670990", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    # Calculate the direction to move\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    if abs(dx) > abs(dy):\n        # Move horizontally first\n        if dx > 0:\n            actions.extend([3] * abs(dx))  # RIGHT\n        elif dx < 0:\n            actions.extend([2] * abs(dx))  # LEFT\n        \n        # Then move vertically\n        if dy > 0:\n            actions.extend([1] * abs(dy))  # UP\n        elif dy < 0:\n            actions.extend([0] * abs(dy))  # DOWN\n    else:\n        # Move vertically first\n        if dy > 0:\n            actions.extend([1] * abs(dy))  # UP\n        elif dy < 0:\n            actions.extend([0] * abs(dy))  # DOWN\n        \n        # Then move horizontally\n        if dx > 0:\n            actions.extend([3] * abs(dx))  # RIGHT\n        elif dx < 0:\n            actions.extend([2] * abs(dx))  # LEFT\n    \n    return actions\n\n  def get_recipe_primitives(item_index):\n      recipe = env.world.cookbook.recipes[item_index]\n      primitives_needed = []\n      \n      for ingredient, amount in recipe.items():\n          if ingredient in env.world.cookbook.primitives:\n              primitives_needed.extend([ingredient] * amount)\n          \n          # Recursively find primitives needed for non-primitive ingredients\n          elif ingredient in env.world.cookbook.recipes:\n              primitives_needed.extend(get_recipe_primitives(ingredient))\n      \n      return primitives_needed\n\n  def collect_primitives(primitives):\n      actions = []\n      current_pos = env._current_state.pos\n      \n      grid = env._current_state.grid\n      primitive_indices = {name: env.world.cookbook.index[name] for name in primitives}\n      \n      # Find the closest source of each primitive\n      for primitive, index in primitive_indices.items():\n          min_distance = float('inf')\n          closest_primitive_pos = None\n          \n          for i in range(grid.shape[0]):\n              for j in range(grid.shape[1]):\n                  if grid[i, j, index] > 0:\n                      distance = abs(i - current_pos[0]) + abs(j - current_pos[1])\n                      if distance < min_distance:\n                          min_distance = distance\n                          closest_primitive_pos = (i, j)\n          \n          # Move to the closest primitive source and collect it\n          actions.extend(move_to(env, closest_primitive_pos))\n          actions.append(4)  # Collect action\n      \n      return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  # This step assumes that the recipe specifies the workshop type needed.\n  # Since the problem does not specify how to determine the workshop,\n  # we will assume that all workshops can craft any items for simplicity.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Find and collect all primitives needed for crafting\n  primitives_needed = get_recipe_primitives(item_index)\n  actions_to_collect_primitives = collect_primitives(primitives_needed)\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(4)  # Assuming the last action index corresponds to USE\n\n  return actions_to_collect_primitives + actions_to_workshop", "island_id": 7, "scores": {"": -1}}
{"timestamp": "2025-09-03T01:58:34.725806", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    # Calculate the direction to move\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    while abs(dx) > 0 or abs(dy) > 0:\n        if abs(dx) >= abs(dy):\n            # Move horizontally first\n            if dx > 0:\n                actions.append(3)  # RIGHT\n                dx -= 1\n            elif dx < 0:\n                actions.append(2)  # LEFT\n                dx += 1\n        else:\n            # Move vertically first\n            if dy > 0:\n                actions.append(1)  # UP\n                dy -= 1\n            elif dy < 0:\n                actions.append(0)  # DOWN\n                dy += 1\n    \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  # This step assumes that the recipe specifies the workshop type needed.\n  # Since the problem does not specify how to determine the workshop,\n  # we will assume that all workshops can craft any items for simplicity.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 7, "scores": {"": 4.7}}
{"timestamp": "2025-09-03T02:00:09.605711", "function_name": "craft", "function_body": "  def move_to_workshop(state, workshop_index):\n    actions = []\n    grid = state.grid\n    pos = state.pos\n    dir = state.dir\n    n_kinds = state.world.cookbook.n_kinds\n    \n    # Find the nearest workshop cell index in the grid\n    workshop_cells = np.argwhere(grid[:, :, workshop_index] > 0)\n    \n    if len(workshop_cells) == 0:\n      raise ValueError(\"No workshops found for this item.\")\n    \n    closest_workshop = min(workshop_cells, key=lambda x: (x[0]-pos[0])**2 + (x[1]-pos[1])**2)\n    \n    # Calculate the path to the nearest workshop\n    path = astar(grid, pos, closest_workshop, n_kinds)\n    \n    for step in path:\n      if step == pos:\n        continue\n      \n      dx, dy = step[0] - pos[0], step[1] - pos[1]\n      \n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      elif dy > 0:\n          actions.append(0)  # DOWN\n      elif dy < 0:\n          actions.append(1)  # UP\n      \n      pos = step\n    \n    return actions\n\n  def astar(grid, start, goal, n_kinds):\n    open_set = collections.PriorityQueue()\n    open_set.put((0, start))\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, goal)}\n    \n    while not open_set.empty():\n        _, current = open_set.get()\n\n        if current == goal:\n            return reconstruct_path(came_from, current)\n        \n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            neighbor = (current[0] + dx, current[1] + dy)\n            \n            if not (0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]):\n                continue\n            \n            tentative_g_score = g_score[current] + 1\n            if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                came_from[neighbor] = current\n                g_score[neighbor] = tentative_g_score\n                f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                open_set.put((f_score[neighbor], neighbor))\n    \n    return []\n\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def reconstruct_path(came_from, current):\n      total_path = [current]\n      while current in came_from:\n          current = came_from[current]\n          total_path.append(current)\n      return list(reversed(total_path))\n  \n  actions = []\n  \n  # Get index for desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Assuming we have all ingredients in the inventory\n\n  # Identify required workshop based on recipe (if any)\n  recipe = env.world.cookbook.recipes.get(item_index)\n  if recipe:\n    _key = recipe.get(\"_key\")\n    if _key is not None:\n      workshop_name = f\"WORKSHOP{_key}\"\n      workshop_index = env.world.cookbook.index[workshop_name]\n      # Move to the workshop\n      actions.extend(move_to_workshop(env._current_state, workshop_index))\n  \n  # Craft the item by using USE action\n  actions.append(4)  # Use action\n  \n  return actions", "island_id": 0, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T02:00:10.649836", "function_name": "craft", "function_body": "  def move_to_workshop(state, workshop_index):\n    actions = []\n    grid = state.grid\n    pos = state.pos\n    dir = state.dir\n    \n    # Find the nearest workshop cell index in the grid\n    workshop_cells = np.argwhere(grid[:, :, workshop_index] > 0)\n    \n    if len(workshop_cells) == 0:\n      raise ValueError(\"No workshops found for this item.\")\n    \n    closest_workshop = min(workshop_cells, key=lambda x: (x[0]-pos[0])**2 + (x[1]-pos[1])**2)\n    \n    # Calculate the path to the nearest workshop\n    path = astar(grid, pos, closest_workshop, state.world.cookbook.n_kinds)\n    \n    for step in path:\n      if step == pos:\n        continue\n      \n      dx, dy = step[0] - pos[0], step[1] - pos[1]\n      \n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      elif dy > 0:\n          actions.append(0)  # DOWN\n      elif dy < 0:\n          actions.append(1)  # UP\n      \n      pos = step\n    \n    return actions\n\n  def astar(grid, start, goal, n_kinds):\n    open_set = collections.PriorityQueue()\n    open_set.put((0, start))\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, goal)}\n    \n    while not open_set.empty():\n        _, current = open_set.get()\n\n        if current == goal:\n            return reconstruct_path(came_from, current)\n        \n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            neighbor = (current[0] + dx, current[1] + dy)\n            \n            if not (0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]):\n                continue\n            \n            tentative_g_score = g_score[current] + 1\n            if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                came_from[neighbor] = current\n                g_score[neighbor] = tentative_g_score\n                f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                open_set.put((f_score[neighbor], neighbor))\n    \n    return []\n\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def reconstruct_path(came_from, current):\n      total_path = [current]\n      while current in came_from:\n          current = came_from[current]\n          total_path.append(current)\n      return list(reversed(total_path))\n\n  actions = []\n  \n  # Get index for desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Identify required workshop based on recipe (if any)\n  recipe = env.world.cookbook.recipes.get(item_index)\n  if recipe:\n    _key = recipe.get(\"_key\")\n    if _key is not None:\n      workshop_name = f\"WORKSHOP{_key}\"\n      workshop_index = env.world.cookbook.index[workshop_name]\n      \n      # Move to the workshop\n      actions.extend(move_to_workshop(env._current_state, workshop_index))\n  \n  # Craft the item by using USE action\n  actions.append(4)  # Use action\n  \n  return actions", "island_id": 0, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T02:01:47.519069", "function_name": "craft", "function_body": "  def move_to_position(current_pos: tuple, target_pos: tuple) -> list[int]:\n    \"\"\"Helper function to generate movement actions to reach the target position.\"\"\"\n    queue = collections.deque([(current_pos, [], env._current_state.dir)])\n    visited = set()\n    \n    while queue:\n      pos, path, dir_ = queue.popleft()\n      \n      if pos == target_pos:\n        return path\n      \n      if (pos, dir_) in visited:\n        continue\n      \n      visited.add((pos, dir_))\n      \n      x, y = pos\n      directions = [(x + 1, y, 0), (x - 1, y, 1), (x, y + 1, 2), (x, y - 1, 3)]\n      \n      for nx, ny, dir_idx in directions:\n        if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n          if env._current_state.grid[nx, ny, 0] == 0:  # Assuming the first layer is walkable\n            queue.append(((nx, ny), path + [dir_idx], dir_idx))\n    \n    return []  # If no path found, return an empty list\n\n  def calculate_direction_to_face(current_dir, target_pos, current_pos):\n      \"\"\"Helper function to determine the direction the agent should face.\"\"\"\n      x_diff = target_pos[0] - current_pos[0]\n      y_diff = target_pos[1] - current_pos[1]\n\n      if x_diff > 0:\n          return 3  # RIGHT\n      elif x_diff < 0:\n          return 2  # LEFT\n      elif y_diff > 0:\n          return 0  # DOWN\n      elif y_diff < 0:\n          return 1  # UP\n\n      return current_dir\n\n  def turn_towards(current_dir, target_dir):\n    \"\"\"Helper function to generate actions to turn the agent towards the target direction.\"\"\"\n    if current_dir == target_dir:\n        return []\n    \n    left_turns = [(0, 2), (1, 3), (2, 1), (3, 0)]\n    right_turns = [(0, 3), (1, 2), (2, 0), (3, 1)]\n\n    if (current_dir, target_dir) in left_turns:\n        return [2] * ((target_dir - current_dir) % 4)\n    elif (current_dir, target_dir) in right_turns:\n        return [3] * ((target_dir - current_dir) % 4)\n\n    return []\n\n  actions = []\n  \n  # Get the index of the desired item to be crafted\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n\n  if \"_key\" in recipe:\n      workshop_type = recipe[\"_key\"]\n\n      # Find the index of the corresponding workshop in the world configuration\n      workshop_indices = env.world.workshop_indices\n\n      selected_workshop_index = find_workshop(workshop_type, workshop_indices)\n      \n      if selected_workshop_index is not None:\n          # Determine the position of the selected workshop from the current state's grid\n          workshop_positions = np.argwhere(env._current_state.grid[:, :, selected_workshop_index] > 0)\n\n          if len(workshop_positions) > 0:\n              target_pos = tuple(workshop_positions[0])\n\n              # Move to the target position of the workshop\n              actions.extend(move_to_position(env._current_state.pos, target_pos))\n              \n              # Turn to face the workshop (simple direction check for now)\n              current_dir = env._current_state.dir\n              target_dir = calculate_direction_to_face(current_dir, target_pos, env._current_state.pos)\n              actions.extend(turn_towards(current_dir, target_dir))\n              \n              # Perform the USE action to start crafting\n              actions.append(4)  # USE action index\n  \n  return actions", "island_id": 3, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T02:01:48.555761", "function_name": "craft", "function_body": "  def move_to_position(current_pos, target_pos):\n    \"\"\"Helper function to generate movement actions to reach the target position.\"\"\"\n    x_diff = target_pos[0] - current_pos[0]\n    y_diff = target_pos[1] - current_pos[1]\n\n    # Generate LEFT/RIGHT movements\n    if x_diff < 0:\n      actions.extend([2] * abs(x_diff))  # LEFT\n    elif x_diff > 0:\n      actions.extend([3] * abs(x_diff))  # RIGHT\n\n    # Generate DOWN/UP movements\n    if y_diff < 0:\n      actions.extend([1] * abs(y_diff))  # UP\n    elif y_diff > 0:\n      actions.extend([0] * abs(y_diff))  # DOWN\n\n  def calculate_direction_to_face(current_dir, target_pos, current_pos):\n    \"\"\"Helper function to determine the direction the agent needs to face.\"\"\"\n    x_diff = target_pos[0] - current_pos[0]\n    y_diff = target_pos[1] - current_pos[1]\n\n    if x_diff > 0:\n      return 3  # RIGHT\n    elif x_diff < 0:\n      return 2  # LEFT\n    elif y_diff > 0:\n      return 0  # DOWN\n    elif y_diff < 0:\n      return 1  # UP\n\n    return current_dir\n\n  def turn_towards(current_dir, target_dir):\n    \"\"\"Helper function to generate turn actions to face the target direction.\"\"\"\n    if current_dir == target_dir:\n      return []\n    \n    # Calculate the difference in directions\n    diff = (target_dir - current_dir) % 4\n    \n    if diff == 1 or diff == 3:\n      actions = [diff]\n    elif diff == 2:\n      actions = [0, 1]  # Turn 180 degrees (e.g., LEFT + UP)\n    \n    return actions\n\n  actions = []\n\n  # Get the index of the desired item to be crafted\n  item_index = env.world.cookbook.index[item]\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n\n  if \"_key\" in recipe:\n      workshop_type = recipe[\"_key\"]\n\n      # Find the index of the corresponding workshop in the world configuration\n      workshop_indices = env.world.workshop_indices\n\n      selected_workshop_index = find_workshop(workshop_type, workshop_indices)\n      \n      if selected_workshop_index is not None:\n          # Determine the position of the selected workshop from the current state's grid\n          workshop_positions = np.argwhere(env._current_state.grid[:, :, selected_workshop_index] > 0)\n\n          if len(workshop_positions) > 0:\n              target_pos = tuple(workshop_positions[0])\n\n              # Move to the target position of the workshop\n              move_to_position(env._current_state.pos, target_pos)\n              \n              # Turn to face the workshop (simple direction check for now)\n              current_dir = env._current_state.dir\n              target_dir = calculate_direction_to_face(current_dir, target_pos, env._current_state.pos)\n              actions.extend(turn_towards(current_dir, target_dir))\n              \n              # Perform the USE action to start crafting\n              actions.append(4)  # USE action index\n  \n  return actions", "island_id": 3, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T02:02:36.298537", "function_name": "craft", "function_body": "  def move_towards(state, target_pos):\n    current_x, current_y = state.pos\n    target_x, target_y = target_pos\n\n    moves = []\n    # Calculate moves in x-direction\n    if current_x < target_x:\n        moves.extend([craft.MOVE_FUNC(craft.RIGHT)] * (target_x - current_x))\n    elif current_x > target_x:\n        moves.extend([craft.MOVE_FUNC(craft.LEFT)] * (current_x - target_x))\n\n    # Calculate moves in y-direction\n    if current_y < target_y:\n        moves.extend([craft.MOVE_FUNC(craft.DOWN)] * (target_y - current_y))\n    elif current_y > target_y:\n        moves.extend([craft.MOVE_FUNC(craft.UP)] * (current_y - target_y))\n    \n    return moves\n\n  goal_index = env.world.cookbook.index[item]\n  actions = []\n\n  if goal_index in env.world.workshop_indices:\n    # Find all workshops that can produce the item\n    workshop_indices = [idx for idx, recipe in env.world.cookbook.recipes.items() \n                        if \"_key\" in recipe and recipe[\"_key\"] == goal_index]\n    \n    if workshop_indices:\n        chosen_workshop_index = workshop_indices[0]\n\n        # Find positions of the chosen workshop in the grid\n        workshop_positions = np.argwhere(env._current_state.grid[:, :, chosen_workshop_index]).tolist()\n\n        if workshop_positions:\n            nearest_workshop_position = min(workshop_positions, \n                                           key=lambda pos: np.linalg.norm(np.array(pos) - np.array(state.pos)))\n            \n            # Move to the nearest workshop position\n            actions.extend(move_towards(env._current_state, nearest_workshop_position))\n\n            # Use the workshop to craft the item\n            actions.append(craft.USE)\n\n  return actions", "island_id": 5, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T02:02:37.339015", "function_name": "craft", "function_body": "  def move_towards(state, target_pos):\n    current_x, current_y = state.pos\n    target_x, target_y = target_pos\n\n    moves = []\n    \n    # Calculate moves in y-direction first (vertical movement)\n    if current_y < target_y:\n        moves.extend([craft.MOVE_FUNC(craft.DOWN)] * (target_y - current_y))\n    elif current_y > target_y:\n        moves.extend([craft.MOVE_FUNC(craft.UP)] * (current_y - target_y))\n\n    # Calculate moves in x-direction (horizontal movement)\n    if current_x < target_x:\n        moves.extend([craft.MOVE_FUNC(craft.RIGHT)] * (target_x - current_x))\n    elif current_x > target_x:\n        moves.extend([craft.MOVE_FUNC(craft.LEFT)] * (current_x - target_x))\n\n    return moves\n\n  goal_index = env.world.cookbook.index[item]\n  actions = []\n\n  # Find all workshops that can produce the item\n  workshop_indices = [idx for idx, recipe in env.world.cookbook.recipes.items() \n                      if \"_key\" in recipe and recipe[\"_key\"] == goal_index]\n\n  if workshop_indices:\n      chosen_workshop_index = workshop_indices[0]\n      \n      # Find positions of the chosen workshop in the grid\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, chosen_workshop_index]).tolist()\n      \n      if workshop_positions:\n          nearest_workshop_position = min(workshop_positions, \n                                         key=lambda pos: np.linalg.norm(np.array(pos) - np.array(state.pos)))\n          \n          # Move to the nearest workshop position\n          target_pos = nearest_workshop_position\n\n          actions.extend(move_towards(env._current_state, (target_x, target_y)))\n\n          # Use the workshop to craft the item\n          actions.append(craft.USE)\n\n  return actions", "island_id": 5, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T02:03:27.428004", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get index for desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Assuming we have all ingredients in the inventory\n\n  # Identify required workshop based on recipe (if any)\n  recipe = env.world.cookbook.recipes.get(item_index)\n  if recipe:\n    _key = recipe.get(\"_key\")\n    if _key is not None:\n      workshop_name = f\"WORKSHOP{_key}\"\n      workshop_index = env.world.cookbook.index[workshop_name]\n      \n      # Find the position of any cell with the required workshop index\n      grid = env._current_state.grid\n      workshop_positions = np.argwhere(grid[:, :, workshop_index] > 0)\n      \n      if len(workshop_positions) == 0:\n        raise ValueError(f\"No {workshop_name} found on the grid.\")\n      \n      # Choose a random position to go to (for now, we'll just pick the first one)\n      target_pos = tuple(workshop_positions[0])\n      \n      # Calculate actions to move towards the target workshop\n      current_state = env._current_state\n      current_x, current_y = current_state.pos\n      \n      while not (target_pos == current_state.pos):\n        dx = target_pos[0] - current_x\n        dy = target_pos[1] - current_y\n        \n        if abs(dx) <= 1 and abs(dy) <= 1:  # Within reach of the workshop\n          break\n\n        # Determine direction to move\n        if dx > 0:\n          actions.append(env.world.RIGHT)\n        elif dx < 0:\n          actions.append(env.world.LEFT)\n\n        if dy > 0:\n          actions.append(env.world.DOWN)\n        elif dy < 0:\n          actions.append(env.world.UP)\n\n        # Execute the move action (if needed) and update current state\n        reward, done, observations = env.step(actions[-1])\n        current_state = env._current_state\n        current_x, current_y = current_state.pos\n\n      # Craft the item by using USE action\n      actions.append(env.world.USE)\n\n  return actions", "island_id": 0, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T02:03:28.469439", "function_name": "craft", "function_body": "  actions = []\n  current_state = env._current_state\n\n  # Get index for desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item has a recipe\n  if item_index not in env.world.cookbook.recipes:\n    return []  # No recipe found, can't craft\n\n  # Identify required workshop based on recipe\n  recipe = env.world.cookbook.recipes[item_index]\n  _key = recipe.get(\"_key\")\n  \n  if _key is None:\n    return []  # No key specified in the recipe, can't determine workshop\n  \n  workshop_name = f\"WORKSHOP{_key}\"\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find a position of the workshop on the grid\n  workshop_positions = np.argwhere(current_state.grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n    return []  # Workshop not found on the grid, can't craft\n\n  # Choose the closest workshop to the current position\n  distances = [np.linalg.norm(np.array(pos) - np.array(current_state.pos)) for pos in workshop_positions]\n  closest_workshop_pos = workshop_positions[np.argmin(distances)]\n\n  # Move towards the closest workshop\n  while not (current_state.pos[0] == closest_workshop_pos[0] and current_state.pos[1] == closest_workshop_pos[1]):\n    dx = closest_workshop_pos[0] - current_state.pos[0]\n    dy = closest_workshop_pos[1] - current_state.pos[1]\n\n    if abs(dx) > 1 or abs(dy) > 1:\n      # Determine the direction to move\n      if dx != 0:\n        action = env.world.RIGHT if dx > 0 else env.world.LEFT\n      else:\n        action = env.world.DOWN if dy > 0 else env.world.UP\n\n      actions.append(action)\n      reward, done, observations = env.step(action)\n      current_state = env._current_state\n    else:\n      break\n\n  # Use the workshop to craft the item\n  actions.append(env.world.USE)\n\n  return actions", "island_id": 0, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T02:04:59.786164", "function_name": "craft", "function_body": "  def move_to_position(current_pos, target_pos):\n    \"\"\"Helper function to generate movement actions to reach the target position.\"\"\"\n    x_diff = target_pos[0] - current_pos[0]\n    y_diff = target_pos[1] - current_pos[1]\n\n    # Generate LEFT/RIGHT movements\n    if x_diff < 0:\n      actions.extend([2] * abs(x_diff))  # LEFT\n    elif x_diff > 0:\n      actions.extend([3] * abs(x_diff))  # RIGHT\n\n    # Generate DOWN/UP movements\n    if y_diff < 0:\n      actions.extend([1] * abs(y_diff))  # UP\n    elif y_diff > 0:\n      actions.extend([0] * abs(y_diff))  # DOWN\n\n  def calculate_direction_to_face(current_pos, target_pos):\n    \"\"\"Helper function to determine the direction the agent needs to face.\"\"\"\n    x_diff = target_pos[0] - current_pos[0]\n    y_diff = target_pos[1] - current_pos[1]\n\n    if x_diff > 0:\n      return 3  # RIGHT\n    elif x_diff < 0:\n      return 2  # LEFT\n    elif y_diff > 0:\n      return 0  # DOWN\n    elif y_diff < 0:\n      return 1  # UP\n\n    return None  # No movement needed, already facing the target position\n\n  def turn_towards(current_dir, target_dir):\n    \"\"\"Helper function to generate turn actions to face the target direction.\"\"\"\n    if current_dir == target_dir:\n      return []\n    \n    # Calculate the difference in directions\n    diff = (target_dir - current_dir) % 4\n    \n    if diff == 1:\n      actions.append(3)  # RIGHT\n    elif diff == 2:\n      actions.extend([0, 1])  # Turn 180 degrees (e.g., DOWN + UP)\n    elif diff == 3:\n      actions.append(2)  # LEFT\n\n    return actions\n\n  def find_workshop(workshop_type, workshop_indices):\n    \"\"\"Helper function to determine the correct workshop index based on its type.\"\"\"\n    if workshop_type in [\"WORKSHOP0\", \"WORKSHOP1\", \"WORKSHOP2\"]:\n        for idx, ws_index in enumerate(env.world.workshop_indices):\n            if env.world.cookbook.index[workshop_type] == ws_index:\n                return idx\n    return None\n\n  actions = []\n\n  # Get the index of the desired item to be crafted\n  item_index = env.world.cookbook.index[item]\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n\n  if \"_key\" in recipe:\n      workshop_type = recipe[\"_key\"]\n\n      # Find the index of the corresponding workshop in the world configuration\n      workshop_indices = env.world.workshop_indices\n\n      selected_workshop_index = find_workshop(workshop_type, workshop_indices)\n      \n      if selected_workshop_index is not None:\n          # Determine the position of the selected workshop from the current state's grid\n          workshop_positions = np.argwhere(env._current_state.grid[:, :, selected_workshop_index] > 0)\n\n          if len(workshop_positions) > 0:\n              target_pos = tuple(workshop_positions[0])\n\n              # Move to the target position of the workshop\n              move_to_position(env._current_state.pos, target_pos)\n              \n              # Turn to face the workshop (simple direction check for now)\n              current_dir = env._current_state.dir\n              target_dir = calculate_direction_to_face(current_pos=env._current_state.pos, target_pos=target_pos)\n\n              if target_dir is not None:\n                  actions.extend(turn_towards(current_dir, target_dir))\n              \n              # Perform the USE action to start crafting\n              actions.append(4)  # USE action index\n  \n  return actions", "island_id": 3, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T02:05:00.822240", "function_name": "craft", "function_body": "  def move_to_position(current_pos, target_pos):\n    \"\"\"Helper function to generate movement actions to reach the target position.\"\"\"\n    x_diff = target_pos[0] - current_pos[0]\n    y_diff = target_pos[1] - current_pos[1]\n\n    # Generate LEFT/RIGHT movements\n    if x_diff < 0:\n      actions.extend([2] * abs(x_diff))  # LEFT\n    elif x_diff > 0:\n      actions.extend([3] * abs(x_diff))  # RIGHT\n\n    # Generate DOWN/UP movements\n    if y_diff < 0:\n      actions.extend([1] * abs(y_diff))  # UP\n    elif y_diff > 0:\n      actions.extend([0] * abs(y_diff))  # DOWN\n\n  def calculate_direction_to_face(current_pos, target_pos):\n    \"\"\"Helper function to determine the direction the agent needs to face.\"\"\"\n    x_diff = target_pos[0] - current_pos[0]\n    y_diff = target_pos[1] - current_pos[1]\n\n    if x_diff > 0:\n      return 3  # RIGHT\n    elif x_diff < 0:\n      return 2  # LEFT\n    elif y_diff > 0:\n      return 0  # DOWN\n    elif y_diff < 0:\n      return 1  # UP\n\n    return current_dir\n\n  def turn_towards(current_dir, target_dir):\n    \"\"\"Helper function to generate turn actions to face the target direction.\"\"\"\n    if current_dir == target_dir:\n      return []\n\n    diff = (target_dir - current_dir) % 4\n    \n    if diff == 1 or diff == 3:\n      actions.append(diff)\n    elif diff == 2:\n      actions.extend([0, 1])  # Turn 180 degrees (e.g., LEFT + UP)\n\n  def find_workshop(workshop_type, workshop_indices):\n    \"\"\"Helper function to determine the index of the workshop type needed.\"\"\"\n    if workshop_type in [\"workshop_0\", \"workshop_1\", \"workshop_2\"]:\n        return workshop_indices[int(workshop_type.split(\"_\")[1])]\n    else:\n        return None\n\n  actions = []\n\n  # Get the index of the desired item to be crafted\n  item_index = env.world.cookbook.index[item]\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n\n  if \"_key\" in recipe:\n      workshop_type = recipe[\"_key\"]\n\n      # Find the index of the corresponding workshop in the world configuration\n      workshop_indices = env.world.workshop_indices\n\n      selected_workshop_index = find_workshop(workshop_type, workshop_indices)\n      \n      if selected_workshop_index is not None:\n          # Determine the position of the selected workshop from the current state's grid\n          workshop_positions = np.argwhere(env._current_state.grid[:, :, selected_workshop_index] > 0)\n\n          if len(workshop_positions) > 0:\n              target_pos = tuple(workshop_positions[0])\n\n              # Move to the target position of the workshop\n              move_to_position(env._current_state.pos, target_pos)\n              \n              # Turn to face the workshop (simple direction check for now)\n              current_dir = env._current_state.dir\n              target_dir = calculate_direction_to_face(env._current_state.pos, target_pos)\n              turn_towards(current_dir, target_dir)\n              \n              # Perform the USE action to start crafting\n              actions.append(4)  # USE action index\n  \n  return actions", "island_id": 3, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T02:06:29.623392", "function_name": "craft", "function_body": "  def move_to_position(current_pos, target_pos):\n    \"\"\"Helper function to generate movement actions to reach the target position.\"\"\"\n    x_diff = target_pos[0] - current_pos[0]\n    y_diff = target_pos[1] - current_pos[1]\n\n    # Generate LEFT/RIGHT movements\n    if x_diff < 0:\n      return [2] * abs(x_diff)  # LEFT\n    elif x_diff > 0:\n      return [3] * abs(x_diff)  # RIGHT\n\n    # Generate DOWN/UP movements\n    actions = []\n    if y_diff < 0:\n      actions.extend([1] * abs(y_diff))  # UP\n    elif y_diff > 0:\n      actions.extend([0] * abs(y_diff))  # DOWN\n    \n    return actions\n\n  def find_workshop(workshop_type, workshop_indices):\n    \"\"\"Helper function to find the index of the corresponding workshop.\"\"\"\n    for idx, workshop in enumerate(env.world.cookbook.index):\n        if workshop.startswith(workshop_type):\n            return workshop_indices[idx]\n    return None\n  \n  def calculate_direction_to_face(current_pos, target_pos):\n    \"\"\"Calculate the direction to face the target position from the current position.\"\"\"\n    x_diff = target_pos[0] - current_pos[0]\n    y_diff = target_pos[1] - current_pos[1]\n\n    if x_diff < 0:\n        return 2  # LEFT\n    elif x_diff > 0:\n        return 3  # RIGHT\n    elif y_diff < 0:\n        return 1  # UP\n    else:  # y_diff > 0\n        return 0  # DOWN\n\n  def turn_towards(current_dir, target_dir):\n    \"\"\"Generate actions to turn from the current direction to the target direction.\"\"\"\n    if current_dir != target_dir:\n      diff = (target_dir - current_dir) % 4\n      if diff == 1 or diff == -3:\n        return [4] * 1  # Turn right\n      elif diff == 2 or diff == -2:\n        return [4, 4]  # Turn around\n      else:  # diff == 3 or diff == -1\n        return [4] * 3  # Turn left\n    return []\n\n  actions = []\n  \n  # Get the index of the desired item to be crafted\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n  \n  # Check if there is a \"_key\" in the recipe, which indicates the workshop type required\n  if \"_key\" in recipe:\n      workshop_type = recipe[\"_key\"]\n      \n      # Find the index of the corresponding workshop in the world configuration\n      workshop_indices = env.world.workshop_indices\n      \n      # Select one of the workshops based on the workshop type (simple random choice for now)\n      selected_workshop_index = find_workshop(workshop_type, workshop_indices)\n      \n      if selected_workshop_index is not None:\n          # Determine the position of the selected workshop from the current state's grid\n          workshop_positions = np.argwhere(env._current_state.grid[:, :, selected_workshop_index] > 0)\n          \n          if len(workshop_positions) > 0:\n              target_pos = tuple(workshop_positions[0])\n              \n              # Move to the target position of the workshop\n              actions.extend(move_to_position(env._current_state.pos, target_pos))\n              \n              # Turn to face the workshop (simple direction check for now)\n              current_dir = env._current_state.dir\n              target_dir = calculate_direction_to_face(current_dir, target_pos)\n              actions.extend(turn_towards(current_dir, target_dir))\n              \n              # Perform the USE action to start crafting\n              actions.append(4)  # USE action index\n  \n  return actions", "island_id": 3, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T02:06:30.724299", "function_name": "craft", "function_body": "  def move_to_position(current_pos, target_pos):\n    x_diff = target_pos[0] - current_pos[0]\n    y_diff = target_pos[1] - current_pos[1]\n\n    actions = []\n    if x_diff < 0:\n      actions.extend([2] * abs(x_diff))  # LEFT\n    elif x_diff > 0:\n      actions.extend([3] * abs(x_diff))  # RIGHT\n\n    if y_diff < 0:\n      actions.extend([1] * abs(y_diff))  # UP\n    elif y_diff > 0:\n      actions.extend([0] * abs(y_diff))  # DOWN\n\n    return actions\n\n  def turn_towards(current_dir, target_dir):\n    diff = (target_dir - current_dir) % 4\n    if diff == 1:\n      return [3]  # RIGHT\n    elif diff == 2:\n      return [3, 3]  # RIGHT, RIGHT or LEFT, LEFT\n    elif diff == 3:\n      return [2]  # LEFT\n    else:\n      return []\n\n  def calculate_direction_to_face(current_pos, target_pos):\n    x_diff = target_pos[0] - current_pos[0]\n    y_diff = target_pos[1] - current_pos[1]\n\n    if abs(x_diff) > abs(y_diff):  # Horizontal movement is more significant\n        return 3 if x_diff > 0 else 2  # RIGHT or LEFT\n    else:  # Vertical movement is more significant or both are equal\n        return 0 if y_diff > 0 else 1  # DOWN or UP\n\n  actions = []\n\n  item_index = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n\n  if \"_key\" in recipe:\n      workshop_type = recipe[\"_key\"]\n      workshop_indices = env.world.workshop_indices\n      selected_workshop_index = None\n      \n      # Select the first workshop that matches the required type\n      for idx, workshop in enumerate(env.world.cookbook.index):\n          if workshop.startswith(workshop_type):\n              selected_workshop_index = workshop_indices[idx]\n              break\n\n      if selected_workshop_index is not None:\n          workshop_positions = np.argwhere(env._current_state.grid[:, :, selected_workshop_index] > 0)\n          \n          if len(workshop_positions) > 0:\n              target_pos = tuple(workshop_positions[0])\n              \n              actions.extend(move_to_position(env._current_state.pos, target_pos))\n              \n              current_dir = env._current_state.dir\n              target_dir = calculate_direction_to_face(env._current_state.pos, target_pos)\n              actions.extend(turn_towards(current_dir, target_dir))\n              \n              # Perform the USE action to start crafting\n              actions.append(4)  # USE action index\n  \n  return actions", "island_id": 3, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T02:07:20.314475", "function_name": "craft", "function_body": "  def find_nearest_workshop(state, workshop_indices):\n    min_distance = float('inf')\n    nearest_workshop_pos = None\n    \n    for workshop_idx in workshop_indices:\n      target_pos = find_position_of_kind(env, workshop_idx)\n      distance = np.linalg.norm(np.array(target_pos) - np.array(state.pos))\n      \n      if distance < min_distance:\n        min_distance = distance\n        nearest_workshop_pos = target_pos\n    \n    return nearest_workshop_pos\n\n  def move_to_position(current_pos, target_pos):\n    actions = []\n    current_x, current_y = current_pos\n    target_x, target_y = target_pos\n    \n    # Determine direction to move based on the difference in positions\n    dx = target_x - current_x\n    dy = target_y - current_y\n    \n    if dx > 0:\n      actions.append(craft.RIGHT)\n    elif dx < 0:\n      actions.append(craft.LEFT)\n    \n    if dy > 0:\n      actions.append(craft.DOWN)\n    elif dy < 0:\n      actions.append(craft.UP)\n    \n    return actions\n\n  actions = []\n  current_state = env._current_state\n\n  # Get the index of the desired item from the cookbook index\n  item_index = env.world.cookbook.index[item]\n\n  # Find the workshop index for crafting the item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n  if \"_key\" in recipe:\n      key_workshop = recipe[\"_key\"]\n      workshop_indices = [env.world.workshop_indices[key_workshop]]\n      \n      # Move to the nearest workshop of the required kind if not already next to one\n      if not current_state.next_to(workshop_index):\n          target_pos = find_nearest_workshop(current_state, workshop_indices)\n          actions.extend(move_to_position(current_state.pos, target_pos))\n          \n      # Perform the USE action to craft the item\n      actions.append(craft.USE)\n\n  return actions", "island_id": 8, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T02:07:21.436634", "function_name": "craft", "function_body": "  def find_nearest_workshop(state, workshop_indices):\n      min_distance = float('inf')\n      nearest_workshop_pos = None\n      \n      for workshop_idx in workshop_indices:\n          target_pos = find_position_of_kind(env, workshop_idx)\n          distance = np.linalg.norm(np.array(target_pos) - np.array(state.pos))\n          \n          if distance < min_distance:\n              min_distance = distance\n              nearest_workshop_pos = target_pos\n      \n      return nearest_workshop_pos\n\n  def move_to_position(current_pos, target_pos):\n      actions = []\n      \n      # Calculate the direction to move towards the target position\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n      \n      if dx > 0:\n          actions.extend([craft.RIGHT]*abs(dx))\n      elif dx < 0:\n          actions.extend([craft.LEFT]*abs(dx))\n      \n      if dy > 0:\n          actions.extend([craft.DOWN]*abs(dy))\n      elif dy < 0:\n          actions.extend([craft.UP]*abs(dy))\n      \n      return actions\n\n  actions = []\n  current_state = env._current_state\n\n  # Get the index of the desired item from the cookbook index\n  item_index = env.world.cookbook.index[item]\n\n  # Find the workshop index for crafting the item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n  if \"_key\" in recipe:\n      key_workshop = recipe[\"_key\"]\n      workshop_index = env.world.workshop_indices[key_workshop]\n      \n      # Move to the nearest workshop of the required kind if not already next to one\n      if not current_state.next_to(workshop_index):\n          target_pos = find_nearest_workshop(current_state, [workshop_index])\n          actions.extend(move_to_position(current_state.pos, target_pos))\n          \n      # Perform the USE action to craft the item\n      actions.append(craft.USE)\n\n  return actions", "island_id": 8, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T02:08:42.111656", "function_name": "craft", "function_body": "  def get_workshop_for_item(item_index):\n    for workshop_type_index in env.world.workshop_indices:\n        recipes = env.world.cookbook.recipes.get(workshop_type_index, {})\n        if '_key' in recipes and item_index == recipes['_key']:\n            return workshop_type_index\n    return None\n\n  def find_nearest_workshop(env, workshop_type_index):\n      current_pos = env._current_state.pos\n      \n      # Filter out workshops that are actually present on the grid\n      actual_workshops = [(x, y) for y in range(env._current_state.grid.shape[0])\n                          for x in range(env._current_state.grid.shape[1])\n                          if env._current_state.grid[y, x, workshop_type_index] > 0]\n      \n      if not actual_workshops:\n          return None\n      \n      # Find the nearest workshop location to the agent's current position\n      nearest_workshop_location = min(actual_workshops, key=lambda loc: np.linalg.norm(np.array(loc) - np.array(current_pos)))\n      \n      return nearest_workshop_location\n\n  def navigate_to(grid, start_pos, target_pos):\n      directions = {'UP': env.action_specs()['UP'], 'DOWN': env.action_specs()['DOWN'],\n                    'LEFT': env.action_specs()['LEFT'], 'RIGHT': env.action_specs()['RIGHT']}\n      actions = []\n      \n      # Simple pathfinding (BFS) to find the shortest path from start to target\n      queue = collections.deque([(start_pos, [])])\n      visited = set([start_pos])\n      \n      while queue:\n          current_pos, path = queue.popleft()\n          \n          if current_pos == target_pos:\n              return [directions[action] for action in path]\n          \n          x, y = current_pos\n          for dx, dy, direction in [(0, -1, 'UP'), (1, 0, 'RIGHT'), (0, 1, 'DOWN'), (-1, 0, 'LEFT')]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and grid[nx, ny].sum() > 0 and (nx, ny) not in visited:\n                  queue.append(((nx, ny), path + [direction]))\n                  visited.add((nx, ny))\n      \n      return []\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Find the workshop that allows crafting this item (if any)\n  workshop_type_index = get_workshop_for_item(item_index)\n\n  actions = []\n\n  if workshop_type_index is not None:\n      # Get the location of the nearest workshop of the required type\n      nearest_workshop_location = find_nearest_workshop(env, workshop_type_index)\n      \n      if nearest_workshop_location is not None:\n          # Navigate to the workshop location\n          actions.extend(navigate_to(env._current_state.grid, env._current_state.pos, nearest_workshop_location))\n          \n          # Use the workshop to craft the item\n          actions.append(env.action_specs()['USE'])\n  \n  return actions", "island_id": 9, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T02:08:43.217635", "function_name": "craft", "function_body": "  def get_workshop_for_item(item_index):\n    for workshop_type_index in env.world.workshop_indices:\n        recipes = env.world.cookbook.recipes.get(workshop_type_index, {})\n        if '_key' in recipes and item_index == recipes['_key']:\n            return workshop_type_index\n    return None\n\n  def find_nearest_workshop(env, workshop_type_index):\n      \"\"\"Find the nearest workshop of a given type.\"\"\"\n      world = env.world\n      grid = env._current_state.grid\n      pos = env._current_state.pos\n      \n      # Filter out workshops that are actually present on the grid\n      actual_workshops = [(x, y) for x in range(grid.shape[1]) for y in range(grid.shape[0])\n                          if np.argmax(grid[y, x]) == workshop_type_index]\n      \n      if not actual_workshops:\n          return None\n      \n      # Calculate distances from current position to all workshops\n      distances = {loc: np.linalg.norm(np.array(loc) - np.array(pos)) for loc in actual_workshops}\n      \n      # Find the nearest workshop location\n      nearest_workshop_location = min(distances, key=distances.get)\n      \n      return nearest_workshop_location\n\n  def navigate_to(grid, current_pos, target_pos):\n      \"\"\"Navigate to a target location on the grid.\"\"\"\n      directions = {'UP': env.action_specs()['UP'], 'DOWN': env.action_specs()['DOWN'],\n                    'LEFT': env.action_specs()['LEFT'], 'RIGHT': env.action_specs()['RIGHT']}\n      actions = []\n      \n      # Simple BFS to find path\n      queue = collections.deque([(current_pos, [])])\n      visited = set([current_pos])\n      \n      while queue:\n          (x, y), path = queue.popleft()\n          \n          if (x, y) == target_pos:\n              return [directions[step] for step in path]\n          \n          for dx, dy in [(0, -1), (1, 0), (0, 1), (-1, 0)]:\n              nx, ny = x + dx, y + dy\n              \n              if 0 <= nx < grid.shape[1] and 0 <= ny < grid.shape[0] and grid[ny, nx].any() and (nx, ny) not in visited:\n                  queue.append(((nx, ny), path + [('UP' if dy == -1 else 'DOWN' if dy == 1 else 'LEFT' if dx == -1 else 'RIGHT')]))\n                  visited.add((nx, ny))\n      \n      return []\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Find the workshop that allows crafting this item (if any)\n  workshop_type_index = get_workshop_for_item(item_index)\n\n  actions = []\n\n  if workshop_type_index is not None:\n      # Get the location of the nearest workshop of the required type\n      nearest_workshop_location = find_nearest_workshop(env, workshop_type_index)\n      \n      if nearest_workshop_location is not None:\n          # Navigate to the workshop location\n          actions.extend(navigate_to(env._current_state.grid, env._current_state.pos, nearest_workshop_location))\n          \n          # Use the workshop to craft the item\n          actions.append(env.action_specs()['USE'])\n  \n  return actions", "island_id": 9, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T02:10:13.739390", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n\n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      # Move horizontally first\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      \n      # Then move vertically\n      if dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n\n      current_pos = (current_pos[0] + (dx // abs(dx)) if dx != 0 else current_pos[0],\n                     current_pos[1] + (dy // abs(dy)) if dy != 0 else current_pos[1])\n      \n    return actions\n  \n  def get_workshop_for_item(item_index):\n      # Assuming that the recipe for an item specifies which workshop is needed\n      # For simplicity, let's assume there is a mapping from items to workshops in the cookbook\n      # Here we just use a placeholder. In reality, this would need to be extracted from the recipes.\n      return env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  workshop_index = get_workshop_for_item(item_index)\n\n  # Find the closest workshop of the required type\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 7, "scores": {"": 4.7}}
{"timestamp": "2025-09-03T02:10:14.712102", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n\n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      # Move horizontally first if possible\n      if dx > 0 and not env._current_state.grid[current_pos[0], current_pos[1]+1, 0]:  # Check for obstacles in the way\n          actions.append(3)  # RIGHT\n          current_pos = (current_pos[0], current_pos[1] + 1)\n      elif dx < 0 and not env._current_state.grid[current_pos[0], current_pos[1]-1, 0]:\n          actions.append(2)  # LEFT\n          current_pos = (current_pos[0], current_pos[1] - 1)\n      \n      # Then move vertically if necessary\n      if dy > 0 and not env._current_state.grid[current_pos[0]+1, current_pos[1], 0]:\n          actions.append(1)  # UP\n          current_pos = (current_pos[0] + 1, current_pos[1])\n      elif dy < 0 and not env._current_state.grid[current_pos[0]-1, current_pos[1], 0]:\n          actions.append(0)  # DOWN\n          current_pos = (current_pos[0] - 1, current_pos[1])\n\n    return actions\n\n  def get_workshop_for_item(item_index):\n      # For simplicity, let's assume there is a mapping from items to workshops in the cookbook.\n      # Here we just use a placeholder. In reality, this would need to be extracted from the recipes.\n      return env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  workshop_index = get_workshop_for_item(item_index)\n\n  # Find the closest workshop of the required type\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 7, "scores": {"": -1}}
{"timestamp": "2025-09-03T02:11:25.647019", "function_name": "craft", "function_body": "  def move_to_position(current_pos: tuple, target_pos: tuple) -> list[int]:\n    \"\"\"Helper function to generate movement actions to reach the target position.\"\"\"\n    x_diff = target_pos[0] - current_pos[0]\n    y_diff = target_pos[1] - current_pos[1]\n\n    # Generate LEFT/RIGHT movements\n    if x_diff < 0:\n        actions.extend([2] * abs(x_diff))  # LEFT\n    elif x_diff > 0:\n        actions.extend([3] * abs(x_diff))  # RIGHT\n\n    # Generate DOWN/UP movements\n    if y_diff < 0:\n        actions.extend([1] * abs(y_diff))  # UP\n    elif y_diff > 0:\n        actions.extend([0] * abs(y_diff))  # DOWN\n\n  def find_workshop(workshop_type: str) -> int:\n    \"\"\"Helper function to find the index of the corresponding workshop.\"\"\"\n    for idx, workshop in enumerate(env.world.cookbook.index):\n        if workshop.startswith(workshop_type):\n            return env.world.workshop_indices[idx]\n    return None\n  \n  actions = []\n  \n  # Get the index of the desired item to be crafted\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n  \n  if \"_key\" in recipe:\n      workshop_type = recipe[\"_key\"]\n      \n      selected_workshop_index = find_workshop(workshop_type)\n      \n      if selected_workshop_index is not None:\n          # Determine the position of the selected workshop from the current state's grid\n          workshop_positions = np.argwhere(env._current_state.grid[:, :, selected_workshop_index] > 0)\n          \n          if len(workshop_positions) > 0:\n              target_pos = tuple(workshop_positions[0])\n              \n              # Move to the target position of the workshop\n              move_to_position(env._current_state.pos, target_pos)\n              \n              # Perform the USE action to start crafting\n              actions.append(4)  # USE action index\n  \n  return actions", "island_id": 3, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T02:11:26.686804", "function_name": "craft", "function_body": "  def move_to_position(current_pos: tuple, target_pos: tuple) -> list[int]:\n    \"\"\"Helper function to generate movement actions to reach the target position using BFS.\"\"\"\n    queue = collections.deque([(current_pos, [])])\n    visited = set()\n    \n    while queue:\n      pos, path = queue.popleft()\n      \n      if pos == target_pos:\n        return path\n      \n      if pos in visited:\n        continue\n      \n      visited.add(pos)\n      \n      x, y = pos\n      directions = [(x + 1, y, 0), (x - 1, y, 1), (x, y + 1, 2), (x, y - 1, 3)]\n      \n      for nx, ny, dir_idx in directions:\n        if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n          if env._current_state.grid[nx, ny, 0] == 0:  # Assuming the first layer is walkable\n            queue.append(((nx, ny), path + [dir_idx]))\n    \n    return []  # If no path found, return an empty list\n\n  def find_workshop(workshop_type: str) -> int:\n    \"\"\"Helper function to find the index of the corresponding workshop.\"\"\"\n    for idx, workshop in enumerate(env.world.cookbook.index):\n        if workshop.startswith(workshop_type):\n            return env.world.workshop_indices[idx]\n    return None\n  \n  actions = []\n  \n  # Get the index of the desired item to be crafted\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n  \n  # Check if there is a \"_key\" in the recipe, which indicates the workshop type required\n  if \"_key\" in recipe:\n      workshop_type = recipe[\"_key\"]\n      \n      # Find the index of the corresponding workshop in the world configuration\n      selected_workshop_index = find_workshop(workshop_type)\n      \n      if selected_workshop_index is not None:\n          # Determine the position of the selected workshop from the current state's grid\n          workshop_positions = np.argwhere(env._current_state.grid[:, :, selected_workshop_index] > 0)\n          \n          if len(workshop_positions) > 0:\n              target_pos = tuple(workshop_positions[0])\n              \n              # Move to the target position of the workshop\n              actions.extend(move_to_position(env._current_state.pos, target_pos))\n              \n              # Turn to face the workshop (simple direction check for now)\n              # Assuming agent faces the right direction after moving\n              \n              # Perform the USE action to start crafting\n              actions.append(4)  # USE action index\n  \n  return actions", "island_id": 3, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T02:12:54.740201", "function_name": "craft", "function_body": "  def move_to(pos):\n    \"\"\"Helper function to generate actions to move an agent to a target position.\"\"\"\n    current_pos = env._current_state.pos\n    dx = pos[0] - current_pos[0]\n    dy = pos[1] - current_pos[1]\n\n    actions = []\n    if dx < 0:\n      actions.extend([env.world.cookbook.index[\"LEFT\"]] * abs(dx))\n    elif dx > 0:\n      actions.extend([env.world.cookbook.index[\"RIGHT\"]] * abs(dx))\n\n    if dy < 0:\n      actions.extend([env.world.cookbook.index[\"UP\"]] * abs(dy))\n    elif dy > 0:\n      actions.extend([env.world.cookbook.index[\"DOWN\"]] * abs(dy))\n\n    return actions\n\n  def collect_primitive(primitive):\n    \"\"\"Helper function to generate actions to collect a primitive.\"\"\"\n    item_index = env.world.cookbook.index[primitive]\n    \n    # Find the nearest source of the primitive\n    sources = np.argwhere(env._current_state.grid[:, :, item_index] > 0)\n    \n    if sources.size == 0:\n      return []\n    \n    agent_pos = env._current_state.pos\n    distances = np.sum(np.abs(sources - agent_pos), axis=1)\n    nearest_source = tuple(sources[np.argmin(distances)])\n    \n    # Generate actions to move the agent to the nearest source\n    actions_to_primitive = move_to(nearest_source)\n\n    # Collect action to collect the primitive (assume USE is used for collecting as well)\n    use_action_index = env.world.cookbook.index[\"USE\"]\n    \n    return actions_to_primitive + [use_action_index]\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Get all recipes that produce the item\n  recipes = {k: v for k, v in env.world.cookbook.recipes.items() if \"_key\" in v and v[\"_key\"] == item_index}\n\n  if not recipes:\n    return []\n\n  # Assume we have only one recipe to produce the item\n  recipe = next(iter(recipes.values()))\n\n  # Collect primitives required for crafting\n  actions_to_collect_primitives = []\n  for ingredient_index, count in recipe.items():\n      if ingredient_index != \"_key\" and env._current_state.inventory.get(ingredient_index, 0) < count:\n          kind_name = env.world.cookbook.index.get(ingredient_index, \"unknown\")\n          actions_to_collect_primitives.extend(collect_primitive(kind_name))\n\n  # Determine which workshop type is needed based on the ingredients\n  workshop_needed = None\n  for ingredient_index in recipe.keys():\n      if ingredient_index != \"_key\":\n          kind_name = env.world.cookbook.index.get(ingredient_index, \"unknown\")\n          if kind_name.startswith(\"WORKSHOP\"):\n              workshop_needed = ingredient_index\n              break\n\n  # If no specific workshop is needed, use the first available workshop\n  if workshop_needed is None:\n      workshop_needed = env.world.workshop_indices[0]\n\n  # Find the nearest workshop of the required type\n  workshops = np.argwhere(env._current_state.grid[:, :, workshop_needed] > 0)\n  \n  if workshops.size == 0:\n      return []\n\n  # Choose the closest workshop to the agent's current position\n  agent_pos = env._current_state.pos\n  distances = np.sum(np.abs(workshops - agent_pos), axis=1)\n  nearest_workshop = tuple(workshops[np.argmin(distances)])\n\n  # Generate actions to move the agent to the nearest workshop\n  actions_to_workshop = move_to(nearest_workshop)\n\n  # Use action to craft the item\n  use_action_index = env.world.cookbook.index[\"USE\"]\n\n  return actions_to_collect_primitives + actions_to_workshop + [use_action_index]", "island_id": 4, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T02:12:55.785984", "function_name": "craft", "function_body": "  def move_to(pos):\n    \"\"\"Helper function to generate actions to move an agent to a target position.\"\"\"\n    current_pos = env._current_state.pos\n    dx = pos[0] - current_pos[0]\n    dy = pos[1] - current_pos[1]\n\n    actions = []\n    if dy < 0:\n      actions.extend([env.world.cookbook.index[\"UP\"]] * abs(dy))\n    elif dy > 0:\n      actions.extend([env.world.cookbook.index[\"DOWN\"]] * abs(dy))\n\n    if dx < 0:\n      actions.extend([env.world.cookbook.index[\"LEFT\"]] * abs(dx))\n    elif dx > 0:\n      actions.extend([env.world.cookbook.index[\"RIGHT\"]] * abs(dx))\n\n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Get all recipes that produce the item\n  recipes = {k: v for k, v in env.world.cookbook.recipes.items() if \"_key\" in v and v[\"_key\"] == item_index}\n\n  # If no recipe is found, return an empty list\n  if not recipes:\n    return []\n\n  # Assume we have only one recipe to produce the item\n  recipe = next(iter(recipes.values()))\n\n  # Determine which workshop type is needed based on the ingredients\n  workshop_needed = None\n  for ingredient_index in recipe.keys():\n      if ingredient_index != \"_key\":\n          kind_name = env.world.cookbook.index.get(ingredient_index, \"unknown\")\n          if kind_name.startswith(\"WORKSHOP\"):\n              workshop_needed = ingredient_index\n              break\n\n  # If no specific workshop is needed, use the first available workshop\n  if workshop_needed is None:\n      workshop_needed = env.world.workshop_indices[0]\n\n  # Find the nearest workshop of the required type\n  workshops = np.argwhere(env._current_state.grid[:, :, workshop_needed] > 0)\n  \n  # If no workshop of the required type is found, return an empty list\n  if workshops.size == 0:\n      return []\n\n  # Choose the closest workshop to the agent's current position\n  agent_pos = env._current_state.pos\n  distances = np.sum(np.abs(workshops - agent_pos), axis=1)\n  nearest_workshop = tuple(workshops[np.argmin(distances)])\n\n  # Generate actions to move the agent to the nearest workshop\n  actions_to_workshop = move_to(nearest_workshop)\n\n  # Use action to craft the item\n  use_action_index = env.world.cookbook.index[\"USE\"]\n\n  # Return the list of actions including moving to the workshop and using it\n  return actions_to_workshop + [use_action_index]", "island_id": 4, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T02:14:24.248005", "function_name": "craft", "function_body": "  def get_closest_workshop(item_index):\n    # Find the appropriate workshop based on the recipe key\n    workshop_indices = []\n    for output_idx, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n        workshop_name = ingredients.get(\"_workshop\")\n        if workshop_name:\n          workshop_indices.append(env.world.cookbook.index[workshop_name])\n    \n    # If no specific workshop is needed, use a default one\n    if not workshop_indices:\n      return env.world.workshop_indices[0]  # Default to the first workshop type\n    \n    # Find the closest workshop in the grid\n    agent_pos = np.array(env._current_state.pos)\n    min_distance = float('inf')\n    closest_workshop_index = None\n    for workshop_index in workshop_indices:\n      for y in range(grid_shape[1]):\n        for x in range(grid_shape[0]):\n          if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n            target_pos = np.array((x, y))\n            distance = np.linalg.norm(agent_pos - target_pos)\n            if distance < min_distance:\n              min_distance = distance\n              closest_workshop_index = workshop_index\n    return closest_workshop_index\n\n  def path_to_target(start, target):\n    \"\"\"Computes the path from start position to target position using BFS for better efficiency.\"\"\"\n    queue = collections.deque([(start, [])])\n    visited = set()\n    while queue:\n      (x, y), actions = queue.popleft()\n      if (x, y) == tuple(target):\n        return actions\n      if (x, y) not in visited:\n        visited.add((x, y))\n        for dx, dy, action in [(-1, 0, 2), (1, 0, 3), (0, -1, 0), (0, 1, 1)]:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < grid_shape[0] and 0 <= ny < grid_shape[1]:\n            queue.append(((nx, ny), actions + [action]))\n    return []\n\n  item_index = env.world.cookbook.index[item]\n  grid_shape = env._current_state.grid.shape[:2]\n\n  # Find the closest workshop for crafting\n  workshop_index = get_closest_workshop(item_index)\n\n  # Find the position of the closest workshop in the grid\n  agent_pos = np.array(env._current_state.pos)\n  workshop_pos = None\n  min_distance = float('inf')\n  for y in range(grid_shape[1]):\n    for x in range(grid_shape[0]):\n      if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n        target_pos = np.array((x, y))\n        distance = np.linalg.norm(agent_pos - target_pos)\n        if distance < min_distance:\n          min_distance = distance\n          workshop_pos = (x, y)\n\n  # If no workshop position is found, return an empty list of actions\n  if workshop_pos is None:\n    return []\n\n  # Calculate the path to the closest workshop and perform the USE action\n  target_pos = np.array(workshop_pos)\n  actions_to_workshop = path_to_target(agent_pos.tolist(), target_pos.tolist())\n  actions_to_workshop.append(4)  # USE to craft the item\n\n  return actions_to_workshop", "island_id": 2, "scores": {"": 2.0}}
{"timestamp": "2025-09-03T02:14:25.252800", "function_name": "craft", "function_body": "  def get_closest_workshop(item_index):\n    workshop_indices = []\n    for output_idx, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n        workshop_name = ingredients.get(\"_workshop\")\n        if workshop_name:\n          workshop_indices.append(env.world.cookbook.index[workshop_name])\n    \n    if not workshop_indices:\n      return env.world.workshop_indices[0]  # Default to the first workshop type\n    \n    agent_pos = np.array(env._current_state.pos)\n    min_distance = float('inf')\n    closest_workshop_index = None\n    for workshop_index in workshop_indices:\n      for y in range(grid_shape[1]):\n        for x in range(grid_shape[0]):\n          if env._current_state.grid[x, y, workshop_index] > 0:\n            target_pos = np.array((x, y))\n            distance = np.linalg.norm(agent_pos - target_pos)\n            if distance < min_distance:\n              min_distance = distance\n              closest_workshop_index = workshop_index\n    return closest_workshop_index\n\n  def path_to_target(start, target):\n    queue = collections.deque([(start, [])])\n    visited = set()\n    while queue:\n      (x, y), actions = queue.popleft()\n      if (x, y) == tuple(target):\n        return actions\n      if (x, y) not in visited:\n        visited.add((x, y))\n        for dx, dy, action in [(-1, 0, 2), (1, 0, 3), (0, -1, 0), (0, 1, 1)]:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < grid_shape[0] and 0 <= ny < grid_shape[1]:\n            queue.append(((nx, ny), actions + [action]))\n    return []\n\n  item_index = env.world.cookbook.index[item]\n  grid_shape = env._current_state.grid.shape[:2]\n\n  workshop_index = get_closest_workshop(item_index)\n  agent_pos = np.array(env._current_state.pos)\n\n  # Find the position of the closest workshop in the grid\n  workshop_pos = None\n  min_distance = float('inf')\n  for y in range(grid_shape[1]):\n    for x in range(grid_shape[0]):\n      if env._current_state.grid[x, y, workshop_index] > 0:\n        target_pos = np.array((x, y))\n        distance = np.linalg.norm(agent_pos - target_pos)\n        if distance < min_distance:\n          min_distance = distance\n          workshop_pos = (x, y)\n\n  if workshop_pos is None:\n    return []\n\n  actions_to_workshop = path_to_target(agent_pos.tolist(), workshop_pos.tolist())\n  actions_to_workshop.append(4)  # USE to craft the item\n\n  return actions_to_workshop", "island_id": 2, "scores": {"": -1}}
{"timestamp": "2025-09-03T02:16:01.910383", "function_name": "craft", "function_body": "  def move_to_workshop(state, workshop_index):\n    actions = []\n    grid = state.grid\n    pos = state.pos\n    \n    # Find the nearest workshop cell index in the grid\n    workshop_cells = np.argwhere(grid[:, :, workshop_index] > 0)\n    \n    if len(workshop_cells) == 0:\n      raise ValueError(\"No workshops found for this item.\")\n    \n    closest_workshop = min(workshop_cells, key=lambda x: (x[0]-pos[0])**2 + (x[1]-pos[1])**2)\n    \n    # Calculate the path to the nearest workshop\n    path = astar(grid, pos, closest_workshop)\n    \n    for step in path:\n      if step == pos:\n        continue\n      \n      dx, dy = step[0] - pos[0], step[1] - pos[1]\n      \n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      elif dy > 0:\n          actions.append(0)  # DOWN\n      elif dy < 0:\n          actions.append(1)  # UP\n      \n      pos = step\n    \n    return actions\n\n  def astar(grid, start, goal):\n    open_set = collections.PriorityQueue()\n    open_set.put((0, start))\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, goal)}\n    \n    while not open_set.empty():\n        _, current = open_set.get()\n\n        if current == goal:\n            return reconstruct_path(came_from, current)\n        \n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            neighbor = (current[0] + dx, current[1] + dy)\n            \n            if not (0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]):\n                continue\n            \n            tentative_g_score = g_score[current] + 1\n            if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                came_from[neighbor] = current\n                g_score[neighbor] = tentative_g_score\n                f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                open_set.put((f_score[neighbor], neighbor))\n    \n    return []\n\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def reconstruct_path(came_from, current):\n      total_path = [current]\n      while current in came_from:\n          current = came_from[current]\n          total_path.append(current)\n      return list(reversed(total_path))\n  \n  actions = []\n  \n  # Get index for desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Assuming we have all ingredients in the inventory\n\n  # Identify required workshop based on recipe (if any)\n  recipe = env.world.cookbook.recipes.get(item_index)\n  if recipe:\n    _key = recipe.get(\"_key\")\n    if _key is not None:\n      workshop_name = f\"WORKSHOP{_key}\"\n      workshop_index = env.world.cookbook.index[workshop_name]\n      # Move to the workshop\n      actions.extend(move_to_workshop(env._current_state, workshop_index))\n  \n  # Craft the item by using USE action\n  actions.append(4)  # Use action\n  \n  return actions", "island_id": 0, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T02:16:02.950346", "function_name": "craft", "function_body": "  def move_to_workshop(state, workshop_index):\n    actions = []\n    grid = state.grid\n    pos = state.pos\n    dir = state.dir\n    \n    # Find the nearest workshop cell index in the grid\n    workshop_cells = np.argwhere(grid[:, :, workshop_index] > 0)\n    \n    if len(workshop_cells) == 0:\n      raise ValueError(\"No workshops found for this item.\")\n    \n    closest_workshop = min(workshop_cells, key=lambda x: (x[0]-pos[0])**2 + (x[1]-pos[1])**2)\n    \n    # Calculate the path to the nearest workshop\n    path = astar(grid, pos, closest_workshop)\n    \n    for step in path:\n      if step == pos:\n        continue\n      \n      dx, dy = step[0] - pos[0], step[1] - pos[1]\n      \n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      elif dy > 0:\n          actions.append(0)  # DOWN\n      elif dy < 0:\n          actions.append(1)  # UP\n      \n      pos = step\n    \n    return actions\n\n  def astar(grid, start, goal):\n    open_set = collections.PriorityQueue()\n    open_set.put((0, start))\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, goal)}\n    \n    while not open_set.empty():\n        _, current = open_set.get()\n\n        if current == goal:\n            return reconstruct_path(came_from, current)\n        \n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            neighbor = (current[0] + dx, current[1] + dy)\n            \n            if not (0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]):\n                continue\n            \n            tentative_g_score = g_score[current] + 1\n            if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                came_from[neighbor] = current\n                g_score[neighbor] = tentative_g_score\n                f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                open_set.put((f_score[neighbor], neighbor))\n    \n    return []\n\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def reconstruct_path(came_from, current):\n      total_path = [current]\n      while current in came_from:\n          current = came_from[current]\n          total_path.append(current)\n      return list(reversed(total_path))\n  \n  actions = []\n  \n  # Get index for desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Assuming we have all ingredients in the inventory\n\n  # Identify required workshop based on recipe (if any)\n  recipe = env.world.cookbook.recipes.get(item_index)\n  if recipe:\n    _key = recipe.get(\"_key\")\n    if _key is not None:\n      workshop_name = f\"WORKSHOP{_key}\"\n      workshop_index = env.world.cookbook.index[workshop_name]\n      # Move to the workshop\n      actions.extend(move_to_workshop(env._current_state, workshop_index))\n  \n  # Craft the item by using USE action\n  actions.append(4)  # Use action\n  \n  return actions", "island_id": 0, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T02:17:06.844994", "function_name": "craft", "function_body": "  def find_nearest_workshop(state, workshop_indices):\n    min_distance = float('inf')\n    nearest_workshop_pos = None\n    \n    for workshop_idx in workshop_indices:\n      target_pos = find_position_of_kind(env, workshop_idx)\n      distance = np.linalg.norm(np.array(target_pos) - np.array(state.pos))\n      \n      if distance < min_distance:\n        min_distance = distance\n        nearest_workshop_pos = target_pos\n    \n    return nearest_workshop_pos\n\n  def move_to_position(current_pos, target_pos):\n    actions = []\n    current_x, current_y = current_pos\n    target_x, target_y = target_pos\n    \n    # Determine direction to move based on the difference in positions\n    dx = target_x - current_x\n    dy = target_y - current_y\n    \n    while dx != 0 or dy != 0:\n      if dx > 0:\n        actions.append(craft.RIGHT)\n        dx -= 1\n      elif dx < 0:\n        actions.append(craft.LEFT)\n        dx += 1\n      \n      if dy > 0:\n        actions.append(craft.DOWN)\n        dy -= 1\n      elif dy < 0:\n        actions.append(craft.UP)\n        dy += 1\n    \n    return actions\n\n  def find_position_of_kind(env, kind_index):\n    grid = env._current_state.grid\n    positions = np.argwhere(grid[:, :, kind_index] > 0)\n    if len(positions) == 0:\n      return None  # No such kind found in the grid\n    return tuple(positions[0])\n\n  actions = []\n  current_state = env._current_state\n\n  # Get the index of the desired item from the cookbook index\n  item_index = env.world.cookbook.index[item]\n\n  # Find the workshop index for crafting the item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n  if \"_key\" in recipe:\n    key_workshop = recipe[\"_key\"]\n    workshop_indices = [env.world.workshop_indices[key_workshop]]\n    \n    # Move to the nearest workshop of the required kind if not already next to one\n    if not current_state.next_to(workshop_indices[0]):\n      target_pos = find_nearest_workshop(current_state, workshop_indices)\n      actions.extend(move_to_position(current_state.pos, target_pos))\n      \n    # Perform the USE action to craft the item\n    actions.append(craft.USE)\n\n  return actions", "island_id": 8, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T02:17:07.894798", "function_name": "craft", "function_body": "  def find_nearest_workshop(state, workshop_indices):\n    min_distance = float('inf')\n    nearest_workshop_pos = None\n    \n    for workshop_idx in workshop_indices:\n      target_pos = find_position_of_kind(env, workshop_idx)\n      distance = np.linalg.norm(np.array(target_pos) - np.array(state.pos))\n      \n      if distance < min_distance:\n        min_distance = distance\n        nearest_workshop_pos = target_pos\n    \n    return nearest_workshop_pos\n\n  def move_to_position(current_pos, target_pos):\n    actions = []\n    current_x, current_y = current_pos\n    target_x, target_y = target_pos\n    \n    # Determine direction to move based on the difference in positions\n    dx = target_x - current_x\n    dy = target_y - current_y\n    \n    # Prioritize moving along the x-axis if both differences are non-zero\n    if abs(dx) > abs(dy):\n      if dx > 0:\n        actions.append(craft.RIGHT)\n      elif dx < 0:\n        actions.append(craft.LEFT)\n    else:\n      if dy > 0:\n        actions.append(craft.DOWN)\n      elif dy < 0:\n        actions.append(craft.UP)\n\n    return actions\n\n  actions = []\n  current_state = env._current_state\n\n  # Get the index of the desired item from the cookbook index\n  item_index = env.world.cookbook.index[item]\n\n  # Find the workshop index for crafting the item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n  if \"_key\" in recipe:\n    key_workshop = recipe[\"_key\"]\n    workshop_indices = [env.world.workshop_indices[key_workshop]]\n    \n    # Move to the nearest workshop of the required kind if not already next to one\n    if not current_state.next_to(workshop_indices[0]):\n      target_pos = find_nearest_workshop(current_state, workshop_indices)\n      actions.extend(move_to_position(current_state.pos, target_pos))\n      \n    # Perform the USE action to craft the item\n    actions.append(craft.USE)\n\n  return actions", "island_id": 8, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T02:20:48.122515", "function_name": "craft", "function_body": "  def get_workshop_for_item(item_index):\n      # Identify the workshop index needed to craft the specified item.\n      for workshop, recipes in env.world.cookbook.recipes.items():\n          if '_key' in recipes and item_index == recipes['_key']:\n              return workshop\n      return None\n\n  def find_nearest_workshop(env, workshop_index):\n      \"\"\"Find the nearest instance of a specific type of workshop on the grid.\"\"\"\n      start_pos = env._current_state.pos\n      \n      # Function to calculate Manhattan distance as heuristic for A* search.\n      def heuristic(a, b):\n          return abs(a[0] - b[0]) + abs(a[1] - b[1])\n      \n      # A* search function to find the shortest path.\n      def a_star_search(start, goal):\n          open_set = collections.PriorityQueue()\n          open_set.put((0, start))\n          came_from = {}\n          cost_so_far = {}\n          came_from[start] = None\n          cost_so_far[start] = 0\n      \n          while not open_set.empty():\n              _, current = open_set.get()\n      \n              if current == goal:\n                  break\n      \n              for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                  neighbor = (current[0] + dx, current[1] + dy)\n                  new_cost = cost_so_far[current] + heuristic(current, neighbor)\n      \n                  if neighbor not in cost_so_far or new_cost < cost_so_far[neighbor]:\n                      cost_so_far[neighbor] = new_cost\n                      priority = new_cost + heuristic(goal, neighbor)\n                      open_set.put((priority, neighbor))\n                      came_from[neighbor] = current\n      \n          return reconstruct_path(came_from, start, goal)\n      \n      # Function to reconstruct the path from start to goal.\n      def reconstruct_path(came_from, start, goal):\n          current = goal\n          path = []\n          while current != start:\n              path.append(current)\n              current = came_from[current]\n          path.reverse()\n          return path\n      \n      # Identify all workshop locations of the specified type on the grid.\n      workshop_locations = []\n      for y in range(env._current_state.grid.shape[0]):\n          for x in range(env._current_state.grid.shape[1]):\n              if np.argmax(env._current_state.grid[y, x]) == workshop_index:\n                  workshop_locations.append((x, y))\n      \n      # Find the nearest workshop to the agent's current position.\n      nearest_workshop = min(workshop_locations, key=lambda loc: heuristic(start_pos, loc), default=None)\n      \n      return nearest_workshop\n\n  def navigate_to(env, target_location):\n      \"\"\"Navigate to a target location on the grid using A* search.\"\"\"\n      start_pos = env._current_state.pos\n      \n      def heuristic(a, b):\n          return abs(a[0] - b[0]) + abs(a[1] - b[1])\n      \n      def a_star_search(start, goal):\n          open_set = collections.PriorityQueue()\n          open_set.put((0, start))\n          came_from = {}\n          cost_so_far = {}\n          came_from[start] = None\n          cost_so_far[start] = 0\n      \n          while not open_set.empty():\n              _, current = open_set.get()\n      \n              if current == goal:\n                  break\n      \n              for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                  neighbor = (current[0] + dx, current[1] + dy)\n                  new_cost = cost_so_far[current] + heuristic(current, neighbor)\n      \n                  if neighbor not in cost_so_far or new_cost < cost_so_far[neighbor]:\n                      cost_so_far[neighbor] = new_cost\n                      priority = new_cost + heuristic(goal, neighbor)\n                      open_set.put((priority, neighbor))\n                      came_from[neighbor] = current\n      \n          return reconstruct_path(came_from, start, goal)\n      \n      def reconstruct_path(came_from, start, goal):\n          current = goal\n          path = []\n          while current != start:\n              path.append(current)\n              current = came_from[current]\n          path.reverse()\n          return path\n\n      # Find the shortest path to the target location using A* search.\n      path_to_target = a_star_search(start_pos, target_location)\n\n      # Convert the path into actions (UP, DOWN, LEFT, RIGHT).\n      action_map = {(-1, 0): env.action_specs()['UP'], (1, 0): env.action_specs()['DOWN'],\n                    (0, -1): env.action_specs()['LEFT'], (0, 1): env.action_specs()['RIGHT']}\n      actions_to_target = []\n      for i in range(1, len(path_to_target)):\n          dx = path_to_target[i][0] - path_to_target[i-1][0]\n          dy = path_to_target[i][1] - path_to_target[i-1][1]\n          if (dx, dy) in action_map:\n              actions_to_target.append(action_map[(dx, dy)])\n\n      return actions_to_target\n\n  def pick_up_primitives(env, item_index):\n      \"\"\"Collect all required primitives to craft the specified item.\"\"\"\n      required_primitives = env.world.cookbook.recipes.get(item_index, {}).copy()\n      del required_primitives['_key']  # Remove the _key entry as it's not a primitive\n      \n      actions = []\n      \n      for primitive, count in required_primitives.items():\n          while count > 0:\n              if env._current_state.inventory[primitive] >= count:\n                  break\n              \n              # Find the nearest location of the required primitive.\n              target_location = find_nearest_primitive(env, primitive)\n              if target_location:\n                  actions.extend(navigate_to(env, target_location))\n                  actions.append(env.action_specs()['USE'])  # Pick up the primitive\n                  env._current_state.inventory[primitive] += 1\n                  count -= 1\n      \n      return actions\n\n  def find_nearest_primitive(env, primitive_index):\n      \"\"\"Find the nearest location of a specific primitive on the grid.\"\"\"\n      start_pos = env._current_state.pos\n      \n      def heuristic(a, b):\n          return abs(a[0] - b[0]) + abs(a[1] - b[1])\n      \n      def a_star_search(start, goal):\n          open_set = collections.PriorityQueue()\n          open_set.put((0, start))\n          came_from = {}\n          cost_so_far = {}\n          came_from[start] = None\n          cost_so_far[start] = 0\n      \n          while not open_set.empty():\n              _, current = open_set.get()\n      \n              if current == goal:\n                  break\n      \n              for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                  neighbor = (current[0] + dx, current[1] + dy)\n                  new_cost = cost_so_far[current] + heuristic(current, neighbor)\n      \n                  if neighbor not in cost_so_far or new_cost < cost_so_far[neighbor]:\n                      cost_so_far[neighbor] = new_cost\n                      priority = new_cost + heuristic(goal, neighbor)\n                      open_set.put((priority, neighbor))\n                      came_from[neighbor] = current\n      \n          return reconstruct_path(came_from, start, goal)\n      \n      def reconstruct_path(came_from, start, goal):\n          current = goal\n          path = []\n          while current != start:\n              path.append(current)\n              current = came_from[current]\n          path.reverse()\n          return path\n      \n      # Identify all locations of the specified primitive on the grid.\n      primitive_locations = []\n      for y in range(env._current_state.grid.shape[0]):\n          for x in range(env._current_state.grid.shape[1]):\n              if np.argmax(env._current_state.grid[y, x]) == primitive_index:\n                  primitive_locations.append((x, y))\n      \n      # Find the nearest location to the agent's current position.\n      nearest_primitive = min(primitive_locations, key=lambda loc: heuristic(start_pos, loc), default=None)\n      \n      return nearest_primitive\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Collect all required primitives if not already in inventory\n  actions_to_pick_up_primitives = pick_up_primitives(env, item_index)\n  \n  # Find the workshop that allows crafting this item (if any)\n  workshop_index = get_workshop_for_item(item_index)\n\n  actions = []\n\n  if workshop_index is not None:\n      # Get the location of the nearest workshop of the required type\n      nearest_workshop_location = find_nearest_workshop(env, workshop_index)\n      \n      if nearest_workshop_location:\n          # Navigate to the workshop location\n          actions.extend(navigate_to(env, nearest_workshop_location))\n          \n          # Use the workshop to craft the item\n          actions.append(env.action_specs()['USE'])\n  else:\n    # No specific workshop needed, likely a primitive item that can be crafted anywhere (e.g., STICK from WOOD)\n    actions.append(env.action_specs()['USE'])\n\n  return actions_to_pick_up_primitives + actions", "island_id": 9, "scores": {"": -1}}
{"timestamp": "2025-09-03T02:20:49.114184", "function_name": "craft", "function_body": "  def get_workshop_for_item(item_index):\n    for workshop, recipes in env.world.cookbook.recipes.items():\n        if '_key' in recipes and item_index == recipes['_key']:\n            return workshop\n    return None\n\n  def find_nearest_workshop(env, workshop_index):\n      start_pos = env._current_state.pos\n      \n      def heuristic(a, b):\n          return abs(a[0] - b[0]) + abs(a[1] - b[1])\n      \n      def a_star_search(start, goal):\n          open_set = collections.PriorityQueue()\n          open_set.put((0, start))\n          came_from = {}\n          cost_so_far = {}\n          came_from[start] = None\n          cost_so_far[start] = 0\n      \n          while not open_set.empty():\n              _, current = open_set.get()\n      \n              if current == goal:\n                  break\n      \n              for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                  neighbor = (current[0] + dx, current[1] + dy)\n                  new_cost = cost_so_far[current] + heuristic(current, neighbor)\n      \n                  if neighbor not in cost_so_far or new_cost < cost_so_far[neighbor]:\n                      cost_so_far[neighbor] = new_cost\n                      priority = new_cost + heuristic(goal, neighbor)\n                      open_set.put((priority, neighbor))\n                      came_from[neighbor] = current\n      \n          return reconstruct_path(came_from, start, goal)\n      \n      def reconstruct_path(came_from, start, goal):\n          current = goal\n          path = []\n          while current != start:\n              path.append(current)\n              current = came_from[current]\n          path.reverse()\n          return path\n      \n      # Find all workshop locations of the specified type on the grid\n      workshop_locations = []\n      for y in range(env._current_state.grid.shape[0]):\n          for x in range(env._current_state.grid.shape[1]):\n              if env._current_state.grid[y, x, workshop_index] > 0:\n                  workshop_locations.append((x, y))\n      \n      # Find the nearest workshop to the agent's current position\n      nearest_workshop = min(workshop_locations, key=lambda loc: heuristic(start_pos, loc), default=None)\n      \n      return nearest_workshop\n  \n  def navigate_to(env, target_location):\n    start_pos = env._current_state.pos\n    \n    def heuristic(a, b):\n        return abs(a[0] - b[0]) + abs(a[1] - b[1])\n    \n    def a_star_search(start, goal):\n        open_set = collections.PriorityQueue()\n        open_set.put((0, start))\n        came_from = {}\n        cost_so_far = {}\n        came_from[start] = None\n        cost_so_far[start] = 0\n    \n        while not open_set.empty():\n            _, current = open_set.get()\n    \n            if current == goal:\n                break\n    \n            for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                neighbor = (current[0] + dx, current[1] + dy)\n                new_cost = cost_so_far[current] + heuristic(current, neighbor)\n    \n                if neighbor not in cost_so_far or new_cost < cost_so_far[neighbor]:\n                    cost_so_far[neighbor] = new_cost\n                    priority = new_cost + heuristic(goal, neighbor)\n                    open_set.put((priority, neighbor))\n                    came_from[neighbor] = current\n    \n        return reconstruct_path(came_from, start, goal)\n    \n    def reconstruct_path(came_from, start, goal):\n        current = goal\n        path = []\n        while current != start:\n            path.append(current)\n            current = came_from[current]\n        path.reverse()\n        return path\n\n    # Find the shortest path to the target location using A* search\n    path_to_target = a_star_search(start_pos, target_location)\n\n    # Convert the path into actions (UP, DOWN, LEFT, RIGHT)\n    action_map = {(-1, 0): env.N_ACTIONS - 4, (1, 0): env.N_ACTIONS - 3, (0, -1): env.N_ACTIONS - 2, (0, 1): env.N_ACTIONS - 1}\n    actions_to_target = []\n    for i in range(1, len(path_to_target)):\n        dx = path_to_target[i][0] - path_to_target[i-1][0]\n        dy = path_to_target[i][1] - path_to_target[i-1][1]\n        if (dx, dy) in action_map:\n            actions_to_target.append(action_map[(dx, dy)])\n\n    return actions_to_target\n\n  def collect_primitives(env, item_index):\n      # This function will collect all the primitive items required to craft the given item.\n      # It assumes that the agent has a list of primitives needed for each item in its cookbook.\n\n      # Check if the item is a primitive\n      if item_index not in env.world.cookbook.recipes:\n          return []\n\n      recipes = env.world.cookbook.recipes[item_index]\n      actions = []\n      \n      for ingredient, amount_needed in recipes.items():\n          if ingredient == '_key':\n              continue\n          \n          # Determine how many of this ingredient we already have\n          current_amount = sum(env._current_state.inventory[env.world.cookbook.index.get(ingredient, -1)])\n          \n          if current_amount >= amount_needed:\n              continue\n\n          # We need to collect more of this ingredient\n          ingredient_index = env.world.cookbook.index[ingredient]\n          ingredient_location = find_nearest_ingredient(env, ingredient_index)\n          \n          if ingredient_location is not None:\n              # Navigate to the ingredient location and collect it\n              actions.extend(navigate_to(env, ingredient_location))\n              \n              # Collect the ingredient (this action might be different based on the game mechanics)\n              actions.append(env.action_specs()['PICKUP'])\n      \n      return actions\n\n  def find_nearest_ingredient(env, ingredient_index):\n    start_pos = env._current_state.pos\n    \n    def heuristic(a, b):\n        return abs(a[0] - b[0]) + abs(a[1] - b[1])\n    \n    def a_star_search(start, goal):\n        open_set = collections.PriorityQueue()\n        open_set.put((0, start))\n        came_from = {}\n        cost_so_far = {}\n        came_from[start] = None\n        cost_so_far[start] = 0\n    \n        while not open_set.empty():\n            _, current = open_set.get()\n    \n            if current == goal:\n                break\n    \n            for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                neighbor = (current[0] + dx, current[1] + dy)\n                new_cost = cost_so_far[current] + heuristic(current, neighbor)\n    \n                if neighbor not in cost_so_far or new_cost < cost_so_far[neighbor]:\n                    cost_so_far[neighbor] = new_cost\n                    priority = new_cost + heuristic(goal, neighbor)\n                    open_set.put((priority, neighbor))\n                    came_from[neighbor] = current\n    \n        return reconstruct_path(came_from, start, goal)\n    \n    def reconstruct_path(came_from, start, goal):\n        current = goal\n        path = []\n        while current != start:\n            path.append(current)\n            current = came_from[current]\n        path.reverse()\n        return path\n\n    # Find all ingredient locations on the grid\n    ingredient_locations = []\n    for y in range(env._current_state.grid.shape[0]):\n        for x in range(env._current_state.grid.shape[1]):\n            if env._current_state.grid[y, x, ingredient_index] > 0:\n                ingredient_locations.append((x, y))\n    \n    # Find the nearest ingredient to the agent's current position\n    nearest_ingredient = min(ingredient_locations, key=lambda loc: heuristic(start_pos, loc), default=None)\n    \n    return nearest_ingredient\n\n  item_index = env.world.cookbook.index[item]\n  \n  actions = []\n\n  # Collect all primitives needed for the item\n  actions.extend(collect_primitives(env, item_index))\n  \n  # Find the workshop that allows crafting this item (if any)\n  workshop_index = get_workshop_for_item(item_index)\n\n  if workshop_index is not None:\n      # Get the location of the nearest workshop of the required type\n      nearest_workshop_location = find_nearest_workshop(env, workshop_index)\n      \n      if nearest_workshop_location:\n          # Navigate to the workshop location\n          actions.extend(navigate_to(env, nearest_workshop_location))\n          \n          # Use the workshop to craft the item\n          actions.append(env.action_specs()['USE'])\n  else:\n    # No specific workshop needed, likely a primitive item that can be crafted anywhere (e.g., STICK from WOOD)\n    actions.append(env.action_specs()['USE'])\n\n  return actions", "island_id": 9, "scores": {"": -1}}
{"timestamp": "2025-09-03T02:22:49.541127", "function_name": "craft", "function_body": "  def get_closest_workshop(item_index):\n    \"\"\"Finds the closest workshop that can craft the specified item.\"\"\"\n    workshop_indices = []\n    for output_idx, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n        workshop_name = ingredients.get(\"_workshop\")\n        if workshop_name:\n          workshop_indices.append(env.world.cookbook.index[workshop_name])\n    \n    # If no specific workshop is needed, use a default one\n    if not workshop_indices:\n      return env.world.workshop_indices[0]  # Default to the first workshop type\n    \n    # Find the closest workshop in the grid\n    agent_pos = np.array(env._current_state.pos)\n    min_distance = float('inf')\n    closest_workshop_index = None\n    for workshop_index in workshop_indices:\n      for y in range(grid_shape[1]):\n        for x in range(grid_shape[0]):\n          if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n            target_pos = np.array((x, y))\n            distance = np.linalg.norm(agent_pos - target_pos)\n            if distance < min_distance:\n              min_distance = distance\n              closest_workshop_index = workshop_index\n    return closest_workshop_index\n\n  def path_to_target(start, target):\n    \"\"\"Computes the path from start position to target position using BFS for better efficiency.\"\"\"\n    queue = collections.deque([(start, [])])\n    visited = set()\n    while queue:\n      (x, y), actions = queue.popleft()\n      if (x, y) == tuple(target):\n        return actions\n      if (x, y) not in visited:\n        visited.add((x, y))\n        for dx, dy, action in [(-1, 0, 2), (1, 0, 3), (0, -1, 0), (0, 1, 1)]:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < grid_shape[0] and 0 <= ny < grid_shape[1]:\n            queue.append(((nx, ny), actions + [action]))\n    return []\n\n  def gather_primitives(primitive_indices):\n      \"\"\"Finds the closest primitives needed for crafting the item.\"\"\"\n      primitive_actions = []\n      agent_pos = np.array(env._current_state.pos)\n      \n      for primitive_index in primitive_indices:\n          # Find the position of the closest primitive in the grid\n          min_distance = float('inf')\n          closest_primitive_pos = None\n          for y in range(grid_shape[1]):\n              for x in range(grid_shape[0]):\n                  if env._current_state.grid[x, y, primitive_index] > 0:  # Check if the primitive is present at this cell\n                      target_pos = np.array((x, y))\n                      distance = np.linalg.norm(agent_pos - target_pos)\n                      if distance < min_distance:\n                          min_distance = distance\n                          closest_primitive_pos = (x, y)\n\n          # If no primitive position is found, return an empty list of actions\n          if closest_primitive_pos is None:\n              continue\n\n          # Calculate the path to the closest primitive and perform the COLLECT action\n          target_pos = np.array(closest_primitive_pos)\n          actions_to_primitive = path_to_target(agent_pos.tolist(), target_pos.tolist())\n          actions_to_primitive.append(4)  # USE to collect the primitive\n\n          # Append the actions to the list of primitive actions\n          primitive_actions.extend(actions_to_primitive)\n\n          # Update the agent position\n          agent_pos = np.array(closest_primitive_pos)\n          \n      return primitive_actions\n\n  item_index = env.world.cookbook.index[item]\n  grid_shape = env._current_state.grid.shape[:2]\n\n  # Find the closest workshop for crafting\n  workshop_index = get_closest_workshop(item_index)\n\n  # Find the position of the closest workshop in the grid\n  agent_pos = np.array(env._current_state.pos)\n  workshop_pos = None\n  min_distance = float('inf')\n  for y in range(grid_shape[1]):\n    for x in range(grid_shape[0]):\n      if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n        target_pos = np.array((x, y))\n        distance = np.linalg.norm(agent_pos - target_pos)\n        if distance < min_distance:\n          min_distance = distance\n          workshop_pos = (x, y)\n\n  # If no workshop position is found, return an empty list of actions\n  if workshop_pos is None:\n    return []\n\n  # Determine the primitives required for crafting the item\n  primitive_indices = []\n  for ingredients in env.world.cookbook.recipes.values():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n          for ingredient, count in ingredients.items():\n              if ingredient != \"_key\" and ingredient != \"_workshop\":\n                  primitive_index = env.world.cookbook.index[ingredient]\n                  if primitive_index not in primitive_indices and env._current_state.inventory.get(primitive_index, 0) < count:\n                      primitive_indices.append(primitive_index)\n          break\n\n  # Gather the primitives needed for crafting\n  primitive_actions = gather_primitives(primitive_indices)\n\n  # Calculate the path to the closest workshop and perform the USE action\n  target_pos = np.array(workshop_pos)\n  actions_to_workshop = path_to_target(agent_pos.tolist(), target_pos.tolist())\n  actions_to_workshop.append(4)  # USE to craft the item\n\n  return primitive_actions + actions_to_workshop", "island_id": 2, "scores": {"": 2.0}}
