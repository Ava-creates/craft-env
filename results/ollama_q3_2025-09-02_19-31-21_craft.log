 dy = next_pos[1] - current_pos[1]\n\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      elif dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n\n      current_pos = next_pos\n      \n    return actions\n\n  def collect_primitives(env, primitives):\n    \"\"\"Collects all required primitives for crafting the item.\"\"\"\n    actions = []\n    grid = env._current_state.grid\n    pos = env._current_state.pos\n    \n    for primitive in primitives:\n        primitive_index = env.world.cookbook.index[primitive]\n        \n        # Find positions of the primitive on the grid\n        primitive_positions = [(i, j) for i in range(grid.shape[0]) for j in range(grid.shape[1]) if grid[i, j, primitive_index] > 0]\n        \n        if not primitive_positions:\n            raise ValueError(f\"Primitive '{primitive}' not found on the grid.\")\n        \n        # Find the closest primitive\n        min_distance = float('inf')\n        closest_primitive_pos = None\n        for p in primitive_positions:\n            distance = abs(p[0] - pos[0]) + abs(p[1] - pos[1])\n            if distance < min_distance:\n                min_distance = distance\n                closest_primitive_pos = p\n        \n        # Move to the closest primitive\n        actions.extend(move_to(env, closest_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n    \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Get required primitives for crafting the item\n  recipe = env.world.cookbook.recipes[item_index]\n  required_primitives = [key for key, value in recipe.items() if key in env.world.cookbook.index]\n\n  # Collect all required primitives\n  collect_actions = collect_primitives(env, required_primitives)\n  \n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  move_actions = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  use_action = [env.world.n_actions - 1]  # Assuming the last action index corresponds to USE\n\n  return collect_actions + move_actions + use_action", "island_id": 5, "scores": {"": 4.7}}
{"timestamp": "2025-09-03T20:23:11.254339", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Iterate over all positions in the grid to find the nearest workshop\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if any(grid[i, j, w] > 0 for w in workshop_indices):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n\n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      # Prioritize moving vertically first to avoid getting stuck in narrow corridors\n      if dy > 0 and current_pos[1] < env._current_state.grid.shape[1] - 1:\n          actions.append(1)  # UP\n      elif dy < 0 and current_pos[1] > 0:\n          actions.append(0)  # DOWN\n      \n      # Then move horizontally if needed\n      if dx > 0 and current_pos[0] < env._current_state.grid.shape[0] - 1:\n          actions.append(3)  # RIGHT\n      elif dx < 0 and current_pos[0] > 0:\n          actions.append(2)  # LEFT\n\n      # Update the current position based on the action taken\n      if dy != 0:\n        current_pos = (current_pos[0], current_pos[1] + (dy // abs(dy)))\n      elif dx != 0:\n        current_pos = (current_pos[0] + (dx // abs(dx)), current_pos[1])\n      \n    return actions\n\n  # Get the index of the item to craft\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  # This step assumes that the recipe specifies the workshop type needed.\n  # Since the problem does not specify how to determine the workshop,\n  # we will assume that all workshops can craft any items for simplicity.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Ensure we are at the target position before using the USE action\n  if env._current_state.pos != closest_workshop_pos:\n      actions_to_workshop.append(4)  # USE action\n\n  return actions_to_workshop", "island_id": 9, "scores": {"": 2.7}}
{"timestamp": "2025-09-03T20:23:12.326436", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Iterate over all positions in the grid to find the nearest workshop\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if any(grid[i, j, w] > 0 for w in workshop_indices):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n\n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      # Prioritize moving vertically if needed to avoid getting stuck\n      if dy > 0 and current_pos[1] < env._current_state.grid.shape[1] - 1:\n          actions.append(1)  # UP\n      elif dy < 0 and current_pos[1] > 0:\n          actions.append(0)  # DOWN\n      \n      # Then move horizontally if needed\n      if dx > 0 and current_pos[0] < env._current_state.grid.shape[0] - 1:\n          actions.append(3)  # RIGHT\n      elif dx < 0 and current_pos[0] > 0:\n          actions.append(2)  # LEFT\n\n      # Update the current position based on the action taken\n      if dy != 0:\n        current_pos = (current_pos[0], current_pos[1] + (dy // abs(dy)))\n      elif dx != 0:\n        current_pos = (current_pos[0] + (dx // abs(dx)), current_pos[1])\n      \n    return actions\n\n  # Get the index of the item to craft\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  # This step assumes that the recipe specifies the workshop type needed.\n  # Since the problem does not specify how to determine the workshop,\n  # we will assume that all workshops can craft any items for simplicity.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Ensure we are at the target position before using the USE action\n  if env._current_state.pos != closest_workshop_pos:\n      actions_to_workshop.append(4)  # USE action\n\n  return actions_to_workshop", "island_id": 9, "scores": {"": 2.7}}
{"timestamp": "2025-09-03T20:24:59.630943", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n\n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      # Determine the direction to move based on the larger distance component\n      if abs(dx) > abs(dy):\n          if dx > 0:\n              actions.append(3)  # RIGHT\n          else:\n              actions.append(2)  # LEFT\n      else:\n          if dy > 0:\n              actions.append(1)  # UP\n          else:\n              actions.append(0)  # DOWN\n\n      current_pos = (current_pos[0] + np.sign(dx), current_pos[1] + np.sign(dy))\n      \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  # This step assumes that the recipe specifies the workshop type needed.\n  # Since the problem does not specify how to determine the workshop,\n  # we will assume that all workshops can craft any items for simplicity.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 8, "scores": {"": 0.90000004}}
{"timestamp": "2025-09-03T20:25:00.768534", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    # Calculate the direction to move\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n    \n    # Move horizontally first\n    if dx > 0:\n        actions.extend([3] * abs(dx))  # RIGHT\n    elif dx < 0:\n        actions.extend([2] * abs(dx))  # LEFT\n    \n    # Then move vertically\n    if dy > 0:\n        actions.extend([1] * abs(dy))  # UP\n    elif dy < 0:\n        actions.extend([0] * abs(dy))  # DOWN\n\n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  # This step assumes that the recipe specifies the workshop type needed.\n  # Since the problem does not specify how to determine the workshop,\n  # we will assume that all workshops can craft any items for simplicity.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 8, "scores": {"": 4.7}}
{"timestamp": "2025-09-03T20:27:00.157479", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    # Calculate the direction to move\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n    \n    # Determine the direction with the least distance first\n    if abs(dx) < abs(dy):\n      # Move horizontally first\n      if dx > 0:\n        actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n        actions.extend([2] * abs(dx))  # LEFT\n      \n      # Then move vertically\n      if dy > 0:\n        actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n        actions.extend([0] * abs(dy))  # DOWN\n    else:\n      # Move vertically first\n      if dy > 0:\n        actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n        actions.extend([0] * abs(dy))  # DOWN\n      \n      # Then move horizontally\n      if dx > 0:\n        actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n        actions.extend([2] * abs(dx))  # LEFT\n\n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  # This step assumes that the recipe specifies the workshop type needed.\n  # Since the problem does not specify how to determine the workshop,\n  # we will assume that all workshops can craft any items for simplicity.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 8, "scores": {"": 4.7}}
{"timestamp": "2025-09-03T20:27:01.142326", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    # Calculate the direction to move\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n    \n    # Move horizontally first\n    if dx > 0:\n        actions.extend([3] * abs(dx))  # RIGHT\n    elif dx < 0:\n        actions.extend([2] * abs(dx))  # LEFT\n    \n    # Then move vertically\n    if dy > 0:\n        actions.extend([1] * abs(dy))  # UP\n    elif dy < 0:\n        actions.extend([0] * abs(dy))  # DOWN\n\n    return actions\n\n  def check_resources(env, item_index):\n      recipe = env.world.cookbook.recipes[item_index]\n      inventory = env._current_state.features_dict['inventory']\n      \n      for required_item, amount in recipe.items():\n          if inventory[required_item] < amount:\n              return False\n      return True\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Ensure we have all required resources\n  if not check_resources(env, item_index):\n    raise ValueError(f\"Not enough resources to craft item '{item}'.\")\n  \n  # Determine which workshop is required for crafting this item\n  # This step assumes that the recipe specifies the workshop type needed.\n  # Since the problem does not specify how to determine the workshop,\n  # we will assume that all workshops can craft any items for simplicity.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 8, "scores": {"": -1}}
