{"timestamp": "2025-09-03T16:54:53.302852", "function_name": "craft", "function_body": "  def find_closest(grid, pos, indices):\n    min_distance = float('inf')\n    closest_pos = None\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, idx] > 0 for idx in indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_pos = (i, j)\n    return closest_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    # A* pathfinding algorithm for more efficient movement\n    open_set = collections.deque([current_pos])\n    came_from = {}\n    g_score = {current_pos: 0}\n    f_score = {current_pos: abs(target_pos[0] - current_pos[0]) + abs(target_pos[1] - current_pos[1])}\n\n    while open_set:\n      current = open_set.popleft()\n      \n      if current == target_pos:\n        break\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        \n        tentative_g_score = g_score[current] + 1\n        \n        if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n          came_from[neighbor] = current\n          g_score[neighbor] = tentative_g_score\n          f_score[neighbor] = tentative_g_score + abs(target_pos[0] - neighbor[0]) + abs(target_pos[1] - neighbor[1])\n          open_set.append(neighbor)\n\n    # Reconstruct path\n    total_path = []\n    while current in came_from:\n      total_path.append(current)\n      current = came_from[current]\n    total_path.reverse()\n\n    for next_pos in total_path:\n      dx = next_pos[0] - current_pos[0]\n      dy = next_pos[1] - current_pos[1]\n\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      elif dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n\n      current_pos = next_pos\n      \n    return actions\n  \n  def gather_primitives(env, primitives):\n    actions = []\n    grid = env._current_state.grid\n    pos = env._current_state.pos\n    \n    for primitive in primitives:\n        primitive_index = env.world.cookbook.index[primitive]\n        \n        # Find the closest position with the required primitive\n        closest_primitive_pos = find_closest(grid, pos, [primitive_index])\n        \n        if not closest_primitive_pos:\n            raise ValueError(f\"No available {primitive} found on the grid.\")\n        \n        # Move to the closest primitive position and pick it up\n        actions.extend(move_to(env, closest_primitive_pos))\n        actions.append(4)  # Assuming action index 4 corresponds to PICK_UP\n        \n    return actions\n\n  def check_inventory_for_primitives(env, primitives):\n      inventory = env._current_state.inventory\n      for primitive in primitives:\n          if inventory[env.world.cookbook.index[primitive]] == 0:\n              return False\n      return True\n  \n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine required primitives for crafting the item\n  recipe = env.world.cookbook.recipes[item_index]\n  required_primitives = [ingredient for ingredient in recipe if ingredient in env.world.cookbook.index]\n\n  # Check if all required primitives are already in inventory\n  if not check_inventory_for_primitives(env, required_primitives):\n      # Gather all required primitives\n      actions_to_gather = gather_primitives(env, required_primitives)\n  else:\n      actions_to_gather = []\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest(grid, pos, env.world.workshop_indices)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_gather + actions_to_workshop", "island_id": 8, "scores": {"": 4.7}}
{"timestamp": "2025-09-03T16:54:54.433296", "function_name": "craft", "function_body": "  def find_closest(grid, pos, target_indices):\n    min_distance = float('inf')\n    closest_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, index] > 0 for index in target_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_pos = (i, j)\n    return closest_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    # A* pathfinding algorithm for more efficient movement\n    open_set = collections.deque([current_pos])\n    came_from = {}\n    g_score = {current_pos: 0}\n    f_score = {current_pos: abs(target_pos[0] - current_pos[0]) + abs(target_pos[1] - current_pos[1])}\n\n    while open_set:\n      current = open_set.popleft()\n      \n      if current == target_pos:\n        break\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        \n        tentative_g_score = g_score[current] + 1\n        \n        if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n          came_from[neighbor] = current\n          g_score[neighbor] = tentative_g_score\n          f_score[neighbor] = tentative_g_score + abs(target_pos[0] - neighbor[0]) + abs(target_pos[1] - neighbor[1])\n          open_set.append(neighbor)\n\n    # Reconstruct path\n    total_path = []\n    while current in came_from:\n      total_path.append(current)\n      current = came_from[current]\n    total_path.reverse()\n\n    for next_pos in total_path:\n      dx = next_pos[0] - current_pos[0]\n      dy = next_pos[1] - current_pos[1]\n\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      elif dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n\n      current_pos = next_pos\n      \n    return actions\n  \n  def gather_primitives(env, primitives):\n    actions = []\n    \n    for primitive in primitives:\n        primitive_index = env.world.cookbook.index[primitive]\n        \n        # Find the closest position with the required primitive\n        closest_primitive_pos = find_closest(env._current_state.grid, env._current_state.pos, [primitive_index])\n        \n        if not closest_primitive_pos:\n            raise ValueError(f\"No available {primitive} found on the grid.\")\n        \n        # Move to the closest primitive position and pick it up\n        actions.extend(move_to(env, closest_primitive_pos))\n        actions.append(4)  # Assuming action index 4 corresponds to PICK_UP\n        \n    return actions\n\n  def check_inventory_for_primitives(env, primitives):\n      inventory = env._current_state.inventory\n      for primitive in primitives:\n          if inventory[env.world.cookbook.index[primitive]] == 0:\n              return False\n      return True\n  \n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine required primitives for crafting the item\n  recipe = env.world.cookbook.recipes[item_index]\n  required_primitives = [ingredient for ingredient in recipe if ingredient in env.world.cookbook.index]\n\n  # Check if all required primitives are already in inventory\n  if not check_inventory_for_primitives(env, required_primitives):\n      # Gather all required primitives\n      actions_to_gather = gather_primitives(env, required_primitives)\n  else:\n      actions_to_gather = []\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest(grid, pos, env.world.workshop_indices)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_gather + actions_to_workshop", "island_id": 8, "scores": {"": 4.7}}
{"timestamp": "2025-09-03T16:56:00.695471", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if abs(dx) > abs(dy):\n        direction_x = 3 if dx > 0 else 2\n        actions.append(direction_x)\n        current_pos = (current_pos[0] + (dx // abs(dx)), current_pos[1])\n      else:\n        direction_y = 1 if dy > 0 else 0\n        actions.append(direction_y)\n        current_pos = (current_pos[0], current_pos[1] + (dy // abs(dy)))\n      \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  workshop_index = env.world.workshop_indices[0]  # Placeholder for any workshop\n\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n  \n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  actions_to_workshop.append(env.world.n_actions - 1)  # USE action\n\n  return actions_to_workshop", "island_id": 2, "scores": {"": 4.7}}
{"timestamp": "2025-09-03T16:56:01.755424", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n\n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      # Prioritize moving vertically if both directions are needed to avoid obstacles\n      if dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n      \n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n\n      current_pos = (current_pos[0] + (dx // abs(dx)) if dx != 0 else current_pos[0],\n                     current_pos[1] + (dy // abs(dy)) if dy != 0 else current_pos[1])\n      \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Assuming all workshops can craft any items for simplicity\n  workshop_index = env.world.workshop_indices[0]\n\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n  \n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  actions_to_workshop.append(env.world.n_actions - 1)  # USE action\n\n  return actions_to_workshop", "island_id": 2, "scores": {"": 4.7}}
{"timestamp": "2025-09-03T16:57:45.117131", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos, workshop_indices):\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    # Use A* algorithm for pathfinding to avoid obstacles and find the shortest path\n    open_list = collections.deque([(pos, [])])\n    closed_set = set()\n    \n    while open_list:\n      (x, y), path = open_list.popleft()\n      \n      if (x, y) == target_pos:\n        return actions + path\n      \n      closed_set.add((x, y))\n      \n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and (nx, ny) not in closed_set:\n          if grid[nx, ny, env.world.non_walkable_indices].sum() == 0:  # Check if the cell is walkable\n            open_list.append(((nx, ny), path + [craft.action_map[(dx, dy)]]))\n    \n    return actions\n\n  def get_workshop_for_item(env, item_index):\n      # For simplicity, let's assume all workshops can craft any items.\n      # This needs to be adapted based on the actual recipes and workshop capabilities.\n      return env.world.workshop_indices[0]\n\n  # Map movement directions to action indices\n  action_map = {\n    (-1, 0): 0,  # UP\n    (1, 0): 1,   # DOWN\n    (0, -1): 2,  # LEFT\n    (0, 1): 3    # RIGHT\n  }\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  workshop_indices = get_workshop_for_item(env, item_index)\n\n  # Find the closest workshop of the required type\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos, workshop_indices)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 1, "scores": {"": -1}}
{"timestamp": "2025-09-03T16:57:46.173193", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n\n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      # Move horizontally first\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      \n      # Then move vertically\n      if dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n\n      current_pos = (current_pos[0] + (dx // abs(dx)) if dx != 0 else current_pos[0],\n                     current_pos[1] + (dy // abs(dy)) if dy != 0 else current_pos[1])\n      \n    return actions\n\n  def get_workshop_for_item(env, item_index):\n      # For simplicity, let's assume all workshops can craft any items.\n      # This needs to be adapted based on the actual recipes and workshop capabilities.\n      return env.world.workshop_indices[0]\n\n  def check_inventory(env, recipe):\n    current_inventory = collections.Counter({env.world.cookbook.index[item]: count for item, count in enumerate(env._current_state.inventory)})\n    required_items = collections.Counter(recipe.get('_requirements', {}))\n\n    # Check if the inventory has all required items\n    return not (required_items - current_inventory)\n\n  def collect_primitives(env):\n      primitives = env.world.cookbook.primitives\n      actions = []\n      \n      for primitive in primitives:\n          primitive_index = env.world.cookbook.index[primitive]\n          closest_primitive_pos = find_closest_item(env._current_state.grid, env._current_state.pos, primitive_index)\n          \n          if closest_primitive_pos:\n              actions.extend(move_to(env, closest_primitive_pos))\n              actions.append(4)  # Collect the primitive\n      return actions\n\n  def find_closest_item(grid, pos, item_index):\n    min_distance = float('inf')\n    closest_item_pos = None\n    \n    for i in range(grid.shape[0]):\n        for j in range(grid.shape[1]):\n            if grid[i, j, item_index] > 0:\n                distance = abs(i - pos[0]) + abs(j - pos[1])\n                if distance < min_distance:\n                    min_distance = distance\n                    closest_item_pos = (i, j)\n    return closest_item_pos\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  workshop_index = get_workshop_for_item(env, item_index)\n\n  # Find the closest workshop of the required type\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Check inventory and collect primitives if needed\n  actions = []\n  if not check_inventory(env, recipe):\n      actions.extend(collect_primitives(env))\n\n  # Move to the closest workshop\n  actions.extend(move_to(env, closest_workshop_pos))\n  \n  # Use the USE action to craft the item at the workshop\n  actions.append(4)  # Assuming the last action index corresponds to USE\n\n  return actions", "island_id": 1, "scores": {"": 4.7}}
{"timestamp": "2025-09-03T16:59:11.965660", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if any(grid[i, j, w] > 0 for w in workshop_indices):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      # Prioritize moving in the direction with the largest difference\n      if abs(dx) > abs(dy):\n        move_horizontally = True\n      else:\n        move_horizontally = False\n      \n      if move_horizontally:\n          if dx > 0:\n              actions.append(3)  # RIGHT\n          elif dx < 0:\n              actions.append(2)  # LEFT\n      else:\n          if dy > 0:\n              actions.append(1)  # UP\n          elif dy < 0:\n              actions.append(0)  # DOWN\n      \n      current_pos = (current_pos[0] + np.sign(dx), current_pos[1]) if move_horizontally else (current_pos[0], current_pos[1] + np.sign(dy))\n      \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  # For now, let's assume that all workshops can craft any items.\n  workshop_indices = env.world.workshop_indices\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 4, "scores": {"": 4.7}}
{"timestamp": "2025-09-03T16:59:13.023381", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if any(grid[i, j, w] > 0 for w in workshop_indices):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      # Determine the direction to move first based on larger difference\n      if abs(dx) >= abs(dy):\n          move_horizontally_first = True\n      else:\n          move_horizontally_first = False\n      \n      if move_horizontally_first:\n        while dx != 0:\n          actions.append(3 if dx > 0 else 2)  # RIGHT or LEFT\n          current_pos = (current_pos[0] + np.sign(dx), current_pos[1])\n          dx -= np.sign(dx)\n        while dy != 0:\n          actions.append(1 if dy > 0 else 0)  # UP or DOWN\n          current_pos = (current_pos[0], current_pos[1] + np.sign(dy))\n          dy -= np.sign(dy)\n      else:\n        while dy != 0:\n          actions.append(1 if dy > 0 else 0)  # UP or DOWN\n          current_pos = (current_pos[0], current_pos[1] + np.sign(dy))\n          dy -= np.sign(dy)\n        while dx != 0:\n          actions.append(3 if dx > 0 else 2)  # RIGHT or LEFT\n          current_pos = (current_pos[0] + np.sign(dx), current_pos[1])\n          dx -= np.sign(dx)\n      \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  # This step assumes that the recipe specifies the workshop type needed.\n  # Since the problem does not specify how to determine the workshop,\n  # we will assume that all workshops can craft any items for simplicity.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 4, "scores": {"": 4.7}}
{"timestamp": "2025-09-03T17:01:06.503902", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    # A* pathfinding algorithm for more efficient movement\n    open_set = collections.deque([current_pos])\n    came_from = {}\n    g_score = {current_pos: 0}\n    f_score = {current_pos: abs(target_pos[0] - current_pos[0]) + abs(target_pos[1] - target_pos[1])}\n\n    while open_set:\n      # Get the node with the lowest f_score\n      current = min(open_set, key=lambda x: f_score[x])\n      open_set.remove(current)\n      \n      if current == target_pos:\n        break\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        \n        tentative_g_score = g_score[current] + 1\n        \n        if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n          came_from[neighbor] = current\n          g_score[neighbor] = tentative_g_score\n          f_score[neighbor] = tentative_g_score + abs(target_pos[0] - neighbor[0]) + abs(target_pos[1] - neighbor[1])\n          open_set.append(neighbor)\n\n    # Reconstruct path\n    total_path = []\n    while current in came_from:\n      total_path.append(current)\n      current = came_from[current]\n    total_path.reverse()\n\n    for next_pos in total_path:\n      dx = next_pos[0] - current_pos[0]\n      dy = next_pos[1] - current_pos[1]\n\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      elif dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n\n      current_pos = next_pos\n      \n    return actions\n\n  def check_inventory(env, item_index):\n    recipe = env.world.cookbook.recipes[item_index]\n    \n    for primitive in recipe:\n      primitive_index = env.world.cookbook.index[primitive]\n      if env._current_state.inventory[primitive_index] == 0:\n        raise ValueError(f\"Missing required primitive '{primitive}' to craft '{item}'.\")\n  \n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Check inventory for required primitives\n  check_inventory(env, item_index)\n\n  # Determine which workshop is required for crafting this item\n  # This step assumes that the recipe specifies the workshop type needed.\n  # Since the problem does not specify how to determine the workshop,\n  # we will assume that all workshops can craft any items for simplicity.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 5, "scores": {"": -1}}
{"timestamp": "2025-09-03T17:01:07.564134", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    # A* pathfinding algorithm for more efficient movement\n    open_set = collections.deque([current_pos])\n    came_from = {}\n    g_score = {current_pos: 0}\n    f_score = {current_pos: abs(target_pos[0] - current_pos[0]) + abs(target_pos[1] - target_pos[1])}\n\n    while open_set:\n      # Get the node with the lowest f_score\n      current = min(open_set, key=lambda x: f_score[x])\n      open_set.remove(current)\n      \n      if current == target_pos:\n        break\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n\n        # Check if the neighbor is a valid position on the grid\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n          tentative_g_score = g_score[current] + 1\n\n          if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n            came_from[neighbor] = current\n            g_score[neighbor] = tentative_g_score\n            f_score[neighbor] = tentative_g_score + abs(target_pos[0] - neighbor[0]) + abs(target_pos[1] - neighbor[1])\n            open_set.append(neighbor)\n\n    # Reconstruct path\n    total_path = []\n    while current in came_from:\n      total_path.append(current)\n      current = came_from[current]\n    total_path.reverse()\n\n    for next_pos in total_path:\n      dx = next_pos[0] - current_pos[0]\n      dy = next_pos[1] - current_pos[1]\n\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      elif dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n\n      current_pos = next_pos\n      \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  # This step assumes that the recipe specifies the workshop type needed.\n  # Since the problem does not specify how to determine the workshop,\n  # we will assume that all workshops can craft any items for simplicity.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 5, "scores": {"": 4.7}}
