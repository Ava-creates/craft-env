current_pos[1] + 1)\n      elif direction_to_workshop == \"LEFT\":\n          current_pos = (current_pos[0] - 1, current_pos[1])\n      elif direction_to_workshop == \"RIGHT\":\n          current_pos = (current_pos[0] + 1, current_pos[1])\n\n  # Add the USE action to craft the item\n  actions.append(craft.USE)\n\n  return actions", "island_id": 2, "scores": {"": -1}}
{"timestamp": "2025-09-02T21:02:51.757969", "function_name": "craft", "function_body": "  # Find the required workshop for crafting\n  item_index = env.world.cookbook.index[item]\n  workshop_required = None\n\n  # Determine the workshop needed for crafting the item (if any)\n  for recipe_key, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n          workshop_required = recipe_key\n  \n  actions = []\n\n  if workshop_required:\n    # Find all locations of required workshops\n    workshop_locations = np.argwhere(env._current_state.grid[:, :, workshop_required] > 0)\n    \n    closest_workshop_location = None\n    min_distance = float('inf')\n    \n    for location in workshop_locations:\n        distance = abs(location[0] - env._current_state.pos[0]) + abs(location[1] - env._current_state.pos[1])\n        if distance < min_distance:\n            min_distance = distance\n            closest_workshop_location = tuple(location)\n    \n    # Move to the nearest workshop\n    actions.extend(move_to_workshop(env._current_state, closest_workshop_location))\n    \n    # Perform the USE action to craft the item\n    actions.append(env.action_specs()['USE'])\n  \n  return actions", "island_id": 6, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T21:02:52.810007", "function_name": "craft", "function_body": "  def find_nearest_workshop(grid, pos, world):\n    closest_workshop = None\n    min_distance = float('inf')\n    \n    for workshop_index in world.workshop_indices:\n      # Find positions of the workshop in the grid\n      locations = np.argwhere(grid[:, :, workshop_index] > 0)\n      \n      for location in locations:\n        distance = abs(location[0] - pos[0]) + abs(location[1] - pos[1])\n        if distance < min_distance:\n          min_distance = distance\n          closest_workshop = tuple(location)\n    \n    return closest_workshop\n\n  def move_to_workshop(state, workshop_pos):\n    actions = []\n    current_pos = state.pos\n    \n    # Calculate direction to move towards the workshop\n    dx = workshop_pos[0] - current_pos[0]\n    dy = workshop_pos[1] - current_pos[1]\n\n    # Move horizontally first if needed\n    if dx > 0:\n      actions.extend([env.action_specs()['RIGHT']] * abs(dx))\n    elif dx < 0:\n      actions.extend([env.action_specs()['LEFT']] * abs(dx))\n\n    # Then move vertically if needed\n    if dy > 0:\n      actions.extend([env.action_specs()['DOWN']] * abs(dy))\n    elif dy < 0:\n      actions.extend([env.action_specs()['UP']] * abs(dy))\n    \n    return actions\n  \n  item_index = env.world.cookbook.index[item]\n  \n  # Determine the workshop needed for crafting the item (if any)\n  workshop_required = None\n  for recipe_key, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n          workshop_required = recipe_key\n  \n  actions = []\n\n  if workshop_required:\n    closest_workshop_position = find_nearest_workshop(env._current_state.grid, env._current_state.pos, env.world)\n    \n    # Move to the workshop\n    actions.extend(move_to_workshop(env._current_state, closest_workshop_position))\n\n    # Perform the USE action to craft the item\n    actions.append(env.action_specs()['USE'])\n\n  return actions", "island_id": 6, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T21:03:38.608280", "function_name": "craft", "function_body": "  actions = []\n  \n  # Convert item name to index\n  item_index = env.world.cookbook.index[item]\n  \n  # Find the required workshop for crafting the item\n  workshop_index = None\n  for i in range(len(env.world.workshop_indices)):\n      if env.world.workshop_indices[i] in env.world.cookbook.recipes[item_index]:\n          workshop_index = i\n          break\n  \n  if workshop_index is None:\n      raise ValueError(f\"No known recipe for {item} or no suitable workshop found.\")\n  \n  # Move to the workshop\n  actions.extend(move_to_workshop(env, workshop_index))\n  \n  # Use action at the workshop\n  actions.append(craft.USE)\n  \n  return actions", "island_id": 2, "scores": {"": -1}}
{"timestamp": "2025-09-02T21:03:39.592611", "function_name": "craft", "function_body": "  # Get index for the desired item\n  item_index = env.world.cookbook.index[item]\n\n  actions = []\n\n  # Check if the agent has all the required primitives in its inventory to craft the item\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  inventory = env._current_state.inventory\n\n  for primitive, count in required_primitives.items():\n    if inventory[primitive] < count:\n      raise ValueError(f\"Not enough {env.world.cookbook.index.get(primitive, 'unknown')} to craft {item}\")\n\n  # Find the nearest workshop that can craft the item\n  workshop_index = None\n  for idx in env.world.workshop_indices:\n      recipe_output = env.world.cookbook.recipes[idx]\n      if item_index in recipe_output.values():\n          workshop_index = idx\n          break\n\n  if workshop_index is None:\n      raise ValueError(f\"No workshop can craft {item}\")\n\n  # Get the position of the nearest workshop\n  grid = env._current_state.grid\n  workshops = np.argwhere(grid[:, :, workshop_index] == 1)\n  closest_workshop_pos = None\n  min_distance = float('inf')\n\n  for pos in workshops:\n      distance = np.linalg.norm(np.array(pos) - np.array(env._current_state.pos))\n      if distance < min_distance:\n          min_distance = distance\n          closest_workshop_pos = tuple(pos)\n\n  if closest_workshop_pos is None:\n      raise ValueError(f\"No workshop found on the grid for {item}\")\n\n  # Move to the nearest workshop\n  current_pos = env._current_state.pos\n  direction = env._current_state.dir\n\n  # Calculate the relative position of the workshop from the agent\n  delta_x = closest_workshop_pos[0] - current_pos[0]\n  delta_y = closest_workshop_pos[1] - current_pos[1]\n\n  # Determine the directions to move in\n  if delta_x < 0:\n      actions.extend([env.world.LEFT] * abs(delta_x))\n  elif delta_x > 0:\n      actions.extend([env.world.RIGHT] * abs(delta_x))\n\n  if delta_y < 0:\n      actions.extend([env.world.DOWN] * abs(delta_y))\n  elif delta_y > 0:\n      actions.extend([env.world.UP] * abs(delta_y))\n\n  # Orient the agent towards the workshop\n  if direction == 0:  # Facing up\n      if delta_x < 0:\n          actions.append(env.world.LEFT)\n      elif delta_x > 0:\n          actions.append(env.world.RIGHT)\n  elif direction == 1:  # Facing down\n      if delta_x < 0:\n          actions.append(env.world.RIGHT)\n      elif delta_x > 0:\n          actions.append(env.world.LEFT)\n  elif direction == 2:  # Facing left\n      if delta_y < 0:\n          actions.append(env.world.DOWN)\n      elif delta_y > 0:\n          actions.append(env.world.UP)\n  elif direction == 3:  # Facing right\n      if delta_y < 0:\n          actions.append(env.world.UP)\n      elif delta_y > 0:\n          actions.append(env.world.DOWN)\n\n  # Use the workshop to craft the item\n  actions.append(env.world.USE)\n\n  return actions", "island_id": 2, "scores": {"": -1}}
{"timestamp": "2025-09-02T21:04:00.222427", "function_name": "craft", "function_body": "  # Get index for item\n  item_index = env.world.cookbook.index[item]\n  \n  # Find the required workshop index for crafting this item\n  recipe = env.world.cookbook.recipes.get(item_index)\n  if not recipe:\n    raise ValueError(f\"No recipe found for item: {item}\")\n\n  # Assuming there is always a \"_key\" in the recipe that points to the required workshop index\n  workshop_index = recipe[\"_key\"]\n  \n  # Get the position of the agent and the target workshop\n  current_pos = env._current_state.pos\n  target_workshop_pos = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)[0]\n  \n  # Calculate the path to the target workshop\n  actions_to_target = move_to_position(current_pos, target_workshop_pos)\n  \n  # Add USE action to craft the item\n  actions_to_target.append(craft.ACTION_USE)\n\n  return actions_to_target", "island_id": 0, "scores": {"": -1}}
{"timestamp": "2025-09-02T21:04:01.184682", "function_name": "craft", "function_body": "  # Step 1: Determine the workshop needed for crafting\n  # This is a placeholder function that should be replaced with actual logic\n  def determine_workshop(item):\n    # Placeholder logic to determine workshop index based on item\n    if item == \"PLANK\":\n      return env.world.workshop_indices[0]\n    elif item == \"STICK\":\n      return env.world.workshop_indices[1]\n    else:\n      raise ValueError(f\"No workshop defined for crafting {item}\")\n\n  # Step 2: Navigate to the workshop\n  actions_to_take = navigate_to_workshop(env, determine_workshop(item))\n\n  # Step 3: Use the workshop to craft the item\n  actions_to_take.append(env.world.n_actions)  # Assuming USE action is the last action\n\n  return actions_to_take", "island_id": 0, "scores": {"": -1}}
{"timestamp": "2025-09-02T21:04:53.775019", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n\n  # Check if the item has a recipe in the cookbook\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"No recipe found for {item}.\")\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes[item_index]\n  \n  # Assume we already have all required primitives in inventory to craft this.\n  actions = []\n\n  # Check if there is a specific workshop associated with this item (using \"_key\" as placeholder)\n  workshop_key = recipe.get(\"_key\", None)\n\n  # If there's no explicit workshop key, assume the first available workshop\n  workshop_indices = env.world.workshop_indices\n  if workshop_key:\n    workshop_index = env.world.cookbook.index[workshop_key]\n    workshop_indices = [workshop_index] if workshop_index in workshop_indices else workshop_indices\n\n  # Find a position next to any of the workshops where we can craft the item\n  for workshop_index in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index])\n      for pos in workshop_positions:\n          # Calculate the direction needed to face the workshop from the current position\n          delta_x, delta_y = pos[0] - env._current_state.pos[0], pos[1] - env._current_state.pos[1]\n          if abs(delta_x) + abs(delta_y) == 1:  # Only consider adjacent cells for simplicity\n              # Calculate the required direction to face the workshop\n              if delta_x > 0:\n                  actions.append(env.world.cookbook.index[\"RIGHT\"])\n              elif delta_x < 0:\n                  actions.append(env.world.cookbook.index[\"LEFT\"])\n              elif delta_y > 0:\n                  actions.append(env.world.cookbook.index[\"DOWN\"])\n              elif delta_y < 0:\n                  actions.append(env.world.cookbook.index[\"UP\"])\n\n              # Add the USE action to craft the item\n              actions.append(env.world.cookbook.index[\"USE\"])\n              break\n\n      if actions:  # If we found a valid position, stop searching\n          break\n\n  return actions", "island_id": 1, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T21:04:54.837622", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n\n  # Check if the item has a recipe in the cookbook\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"No recipe found for {item}.\")\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes[item_index]\n  \n  # Assume we already have all required primitives in inventory to craft this.\n  actions = []\n\n  # Check if there is a specific workshop associated with this item (using \"_key\" as placeholder)\n  workshop_key = recipe.get(\"_key\", None)\n\n  # If there's no explicit workshop key, assume the first available workshop\n  workshop_indices = env.world.workshop_indices\n  if workshop_key:\n    workshop_index = env.world.cookbook.index[workshop_key]\n    workshop_indices = [workshop_index] if workshop_index in workshop_indices else workshop_indices\n\n  # Find a position next to any of the workshops where we can craft the item\n  for workshop_index in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index])\n      for pos in workshop_positions:\n          # Calculate the direction needed to face the workshop from the current position\n          delta_x, delta_y = pos[0] - env._current_state.pos[0], pos[1] - env._current_state.pos[1]\n          if abs(delta_x) + abs(delta_y) == 1:  # Only consider adjacent cells for simplicity\n              while env._current_state.pos != (pos[0], pos[1]):\n                  # Calculate the direction needed to reach the workshop position from the current position\n                  if delta_x > 0:\n                      actions.append(env.world.cookbook.index[\"RIGHT\"])\n                  elif delta_x < 0:\n                      actions.append(env.world.cookbook.index[\"LEFT\"])\n                  elif delta_y > 0:\n                      actions.append(env.world.cookbook.index[\"DOWN\"])\n                  elif delta_y < 0:\n                      actions.append(env.world.cookbook.index[\"UP\"])\n\n              # Add the USE action to craft the item\n              actions.append(env.world.cookbook.index[\"USE\"])\n              break\n\n      if actions:  # If we found a valid position, stop searching\n          break\n  \n  return actions", "island_id": 1, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T21:05:59.647528", "function_name": "craft", "function_body": "  index = env.world.cookbook.index\n  item_index = index[item]\n  \n  # Get the recipe for the desired item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n  \n  if not recipe:\n      raise ValueError(f\"No recipe found for item {item}.\")\n  \n  actions = []\n  inventory = env._current_state.inventory\n  \n  # Check if all ingredients are already in inventory\n  for ingredient_index in recipe:\n      if ingredient_index == \"_key\":\n          continue\n      \n      required_count = recipe[ingredient_index]\n      \n      if inventory[ingredient_index] < required_count:\n          # Determine which workshops can produce the required ingredient\n          workshop_indices = []\n          for workshop in env.world.workshop_indices:\n              workshop_recipe = env.world.cookbook.recipes.get(workshop, {})\n              if any(ingredient_index == value for value in workshop_recipe.values()):\n                  workshop_indices.append(workshop)\n          \n          # Remove duplicates\n          workshop_indices = list(set(workshop_indices))\n          \n          # Move to each required workshop and collect ingredients\n          for workshop_index in workshop_indices:\n              grid = env._current_state.grid\n              positions = np.argwhere(grid[:, :, workshop_index] > 0)\n              \n              if len(positions) == 0:\n                  raise ValueError(f\"No available workshop with index {workshop_index}.\")\n              \n              # Choose the closest workshop\n              pos = env._current_state.pos\n              distances = np.sum(np.abs(positions - pos), axis=1)\n              closest_workshop_pos = positions[np.argmin(distances)]\n              \n              # Move to the closest workshop\n              actions.extend(navigate_to(env, tuple(closest_workshop_pos)))\n              \n              # Craft at the workshop (USE action)\n              actions.append(craft.USE)\n\n  # Move to a workshop that can produce the desired item\n  output_workshop_indices = []\n  for workshop in env.world.workshop_indices:\n      workshop_recipe = env.world.cookbook.recipes.get(workshop, {})\n      if any(item_index == value for value in workshop_recipe.values()):\n          output_workshop_indices.append(workshop)\n  \n  # Remove duplicates\n  output_workshop_indices = list(set(output_workshop_indices))\n  \n  # Move to each required workshop and collect ingredients (if necessary)\n  for workshop_index in output_workshop_indices:\n      grid = env._current_state.grid\n      positions = np.argwhere(grid[:, :, workshop_index] > 0)\n      \n      if len(positions) == 0:\n          raise ValueError(f\"No available workshop with index {workshop_index}.\")\n      \n      # Choose the closest workshop\n      pos = env._current_state.pos\n      distances = np.sum(np.abs(positions - pos), axis=1)\n      closest_workshop_pos = positions[np.argmin(distances)]\n      \n      # Move to the closest workshop\n      actions.extend(navigate_to(env, tuple(closest_workshop_pos)))\n      \n      # Craft at the workshop (USE action)\n      actions.append(craft.USE)\n\n  return actions", "island_id": 5, "scores": {"": -1}}
{"timestamp": "2025-09-02T21:06:00.614142", "function_name": "craft", "function_body": "  index = env.world.cookbook.index\n  item_index = index[item]\n\n  # Get the recipe for the desired item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n      raise ValueError(f\"No recipe found for item {item}.\")\n\n  actions = []\n\n  def get_workshops_for_ingredient(ingredient_index):\n      workshops = []\n      for workshop in env.world.workshop_indices:\n          workshop_recipe = env.world.cookbook.recipes.get(workshop, {})\n          if ingredient_index in workshop_recipe.values():\n              workshops.append(workshop)\n      return workshops\n\n  # Collect all required ingredients\n  for ingredient_index in recipe:\n      if ingredient_index == \"_key\":\n          continue\n      \n      workshops = get_workshops_for_ingredient(ingredient_index)\n\n      if not workshops:\n          raise ValueError(f\"No workshop found to produce ingredient with index {ingredient_index}.\")\n\n      for workshop_index in workshops:\n          grid = env._current_state.grid\n          positions = np.argwhere(grid[:, :, workshop_index] > 0)\n          \n          if len(positions) == 0:\n              raise ValueError(f\"No available workshop with index {workshop_index}.\")\n          \n          # Choose the closest workshop\n          pos = env._current_state.pos\n          distances = np.sum(np.abs(positions - pos), axis=1)\n          closest_workshop_pos = positions[np.argmin(distances)]\n          \n          # Move to the closest workshop\n          actions.extend(navigate_to(env, tuple(closest_workshop_pos)))\n          \n          # Craft at the workshop (USE action)\n          actions.append(craft.USE)\n\n  # Move to a workshop that can produce the final item\n  workshops = get_workshops_for_ingredient(item_index)\n\n  if not workshops:\n      raise ValueError(f\"No workshop found to produce the final item with index {item_index}.\")\n\n  for workshop_index in workshops:\n      grid = env._current_state.grid\n      positions = np.argwhere(grid[:, :, workshop_index] > 0)\n      \n      if len(positions) == 0:\n          raise ValueError(f\"No available workshop with index {workshop_index}.\")\n      \n      # Choose the closest workshop\n      pos = env._current_state.pos\n      distances = np.sum(np.abs(positions - pos), axis=1)\n      closest_workshop_pos = positions[np.argmin(distances)]\n      \n      # Move to the closest workshop\n      actions.extend(navigate_to(env, tuple(closest_workshop_pos)))\n      \n      # Craft at the workshop (USE action)\n      actions.append(craft.USE)\n\n  return actions", "island_id": 5, "scores": {"": -1}}
{"timestamp": "2025-09-02T21:06:34.381654", "function_name": "craft", "function_body": "  # Constants for actions\n  DOWN, UP, LEFT, RIGHT, USE = env.action_specs()[\"DOWN\"], env.action_specs()[\n      \"UP\"], env.action_specs()[\"LEFT\"], env.action_specs()[\"RIGHT\"], env.action_specs()[\"USE\"]\n  \n  # Get the index of the item to craft from the cookbook\n  item_index = env.world.cookbook.index[item]\n\n  # Determine which workshop is needed for crafting based on the item index\n  # This requires knowledge of which workshops are required for which items\n  # For simplicity, let's assume we have a function `get_workshop_for_item(item_index)` that returns the appropriate workshop index\n  workshop_index = get_workshop_for_item(item_index)\n  \n  # Get the position of the workshop in the grid\n  workshop_pos = env.world.workshop_indices[workshop_index]\n  \n  # Calculate the path to the workshop from the current position\n  path_to_workshop = calculate_path(env._current_state.pos, workshop_pos)\n\n  # Generate actions to move along the path\n  actions_to_move = [convert_direction_to_action(\n      (x1 - x0, y1 - y0)) for (x0, y0), (x1, y1) in zip(path_to_workshop[:-1], path_to_workshop[1:])]\n  \n  # Add the USE action to craft the item\n  actions_to_move.append(USE)\n  \n  return actions_to_move", "island_id": 7, "scores": {"": -1}}
{"timestamp": "2025-09-02T21:06:35.347787", "function_name": "craft", "function_body": "  # Get the index for the target item\n  item_index = env.world.cookbook.index[item]\n  \n  # Find a workshop that can make the item (assuming there is one and it's known)\n  workshop_indices = [i for i, w in enumerate(env.world.workshop_indices) if w == item_index]\n  if not workshop_indices:\n    raise ValueError(f\"No workshop found to craft {item}\")\n\n  workshop_index = workshop_indices[0]\n\n  # Determine the actions needed to move to the workshop\n  target_workshop_pos = env.world.workshop_indices.index(workshop_index)\n  current_pos = env._current_state.pos\n\n  # Calculate the relative position of the workshop from the current position\n  delta_x = target_workshop_pos[0] - current_pos[0]\n  delta_y = target_workshop_pos[1] - current_pos[1]\n\n  actions_to_take = []\n\n  if delta_x > 0:\n    actions_to_take.extend([craft.N_RIGHT] * abs(delta_x))\n  elif delta_x < 0:\n    actions_to_take.extend([craft.N_LEFT] * abs(delta_x))\n\n  if delta_y > 0:\n    actions_to_take.extend([craft.N_DOWN] * abs(delta_y))\n  elif delta_y < 0:\n    actions_to_take.extend([craft.N_UP] * abs(delta_y))\n\n  # Once at the workshop, perform the USE action to craft the item\n  actions_to_take.append(craft.N_USE)\n\n  return actions_to_take", "island_id": 7, "scores": {"": -1}}
{"timestamp": "2025-09-02T21:08:47.279075", "function_name": "craft", "function_body": "  def get_workshop_for_item(item_index):\n    for workshop, recipes in env.world.cookbook.recipes.items():\n        if '_key' in recipes and item_index == recipes['_key']:\n            return workshop\n    return None\n\n  def find_nearest_workshop(env, workshop_index):\n      # This function will find the nearest instance of a specific type of workshop on the grid.\n      # The agent's current position is considered as the starting point.\n      start_pos = env._current_state.pos\n      \n      def heuristic(a, b):\n          return abs(a[0] - b[0]) + abs(a[1] - b[1])\n      \n      def a_star_search(start, goal):\n          open_set = collections.PriorityQueue()\n          open_set.put((0, start))\n          came_from = {}\n          cost_so_far = {}\n          came_from[start] = None\n          cost_so_far[start] = 0\n      \n          while not open_set.empty():\n              _, current = open_set.get()\n      \n              if current == goal:\n                  break\n      \n              for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                  neighbor = (current[0] + dx, current[1] + dy)\n                  new_cost = cost_so_far[current] + heuristic(current, neighbor)\n      \n                  if neighbor not in cost_so_far or new_cost < cost_so_far[neighbor]:\n                      cost_so_far[neighbor] = new_cost\n                      priority = new_cost + heuristic(goal, neighbor)\n                      open_set.put((priority, neighbor))\n                      came_from[neighbor] = current\n      \n          return reconstruct_path(came_from, start, goal)\n      \n      def reconstruct_path(came_from, start, goal):\n          current = goal\n          path = []\n          while current != start:\n              path.append(current)\n              current = came_from[current]\n          path.append(start)\n          path.reverse()\n          return path\n      \n      # Find all workshop locations of the specified type on the grid\n      workshop_locations = []\n      for y in range(env._current_state.grid.shape[0]):\n          for x in range(env._current_state.grid.shape[1]):\n              if env._current_state.grid[y, x, workshop_index] > 0:\n                  workshop_locations.append((x, y))\n      \n      # Find the nearest workshop to the agent's current position\n      nearest_workshop = min(workshop_locations, key=lambda loc: heuristic(start_pos, loc), default=None)\n      \n      return nearest_workshop\n  \n  def navigate_to(env, target_location):\n    start_pos = env._current_state.pos\n    \n    def heuristic(a, b):\n        return abs(a[0] - b[0]) + abs(a[1] - b[1])\n    \n    def a_star_search(start, goal):\n        open_set = collections.PriorityQueue()\n        open_set.put((0, start))\n        came_from = {}\n        cost_so_far = {}\n        came_from[start] = None\n        cost_so_far[start] = 0\n    \n        while not open_set.empty():\n            _, current = open_set.get()\n    \n            if current == goal:\n                break\n    \n            for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                neighbor = (current[0] + dx, current[1] + dy)\n                new_cost = cost_so_far[current] + heuristic(current, neighbor)\n    \n                if neighbor not in cost_so_far or new_cost < cost_so_far[neighbor]:\n                    cost_so_far[neighbor] = new_cost\n                    priority = new_cost + heuristic(goal, neighbor)\n                    open_set.put((priority, neighbor))\n                    came_from[neighbor] = current\n    \n        return reconstruct_path(came_from, start, goal)\n    \n    def reconstruct_path(came_from, start, goal):\n        current = goal\n        path = []\n        while current != start:\n            path.append(current)\n            current = came_from[current]\n        path.reverse()\n        return path\n\n    # Find the shortest path to the target location using A* search\n    path_to_target = a_star_search(start_pos, target_location)\n\n    # Convert the path into actions (UP, DOWN, LEFT, RIGHT)\n    action_map = {(-1, 0): env.N_ACTIONS - 4, (1, 0): env.N_ACTIONS - 3, (0, -1): env.N_ACTIONS - 2, (0, 1): env.N_ACTIONS - 1}\n    actions_to_target = []\n    for i in range(1, len(path_to_target)):\n        dx = path_to_target[i][0] - path_to_target[i-1][0]\n        dy = path_to_target[i][1] - path_to_target[i-1][1]\n        if (dx, dy) in action_map:\n            actions_to_target.append(action_map[(dx, dy)])\n\n    return actions_to_target\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Find the workshop that allows crafting this item (if any)\n  workshop_index = get_workshop_for_item(item_index)\n\n  actions = []\n\n  if workshop_index is not None:\n      # Get the location of the nearest workshop of the required type\n      nearest_workshop_location = find_nearest_workshop(env, workshop_index)\n      \n      if nearest_workshop_location:\n          # Navigate to the workshop location\n          actions.extend(navigate_to(env, nearest_workshop_location))\n          \n          # Use the workshop to craft the item\n          actions.append(env.action_specs()['USE'])\n  else:\n    # No specific workshop needed, likely a primitive item that can be crafted anywhere (e.g., STICK from WOOD)\n    actions.append(env.action_specs()['USE'])\n\n  return actions", "island_id": 9, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T21:08:48.362719", "function_name": "craft", "function_body": "  def get_workshop_for_item(item_index):\n    for workshop, recipes in env.world.cookbook.recipes.items():\n        if '_key' in recipes and item_index == recipes['_key']:\n            return workshop\n    return None\n\n  def find_nearest_workshop(env, workshop_index):\n    # This function finds the nearest instance of a workshop with index `workshop_index` on the grid.\n    # It uses a simple Breadth-First Search (BFS) to explore the grid starting from the agent's current position.\n    start = env._current_state.pos\n    queue = collections.deque([start])\n    visited = set()\n    parent = {start: None}\n\n    while queue:\n        current = queue.popleft()\n        if current in visited:\n            continue\n        visited.add(current)\n\n        # Check all four neighboring cells\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            neighbor = (current[0] + dx, current[1] + dy)\n            if not is_within_bounds(env._current_state.grid.shape, neighbor) or neighbor in visited:\n                continue\n\n            # If we find a workshop at this cell, reconstruct the path to it\n            if env._current_state.grid[current[1] + dy, current[0] + dx, workshop_index] > 0:\n                return reconstruct_path(parent, start, neighbor)\n\n            queue.append(neighbor)\n            parent[neighbor] = current\n\n    return None\n\n  def is_within_bounds(grid_shape, position):\n      x, y = position\n      return 0 <= x < grid_shape[1] and 0 <= y < grid_shape[0]\n\n  def reconstruct_path(parent, start, goal):\n      path = []\n      current = goal\n      while current != start:\n          path.append(current)\n          current = parent[current]\n      path.reverse()\n      return path\n\n  def navigate_to(env, location):\n      # This function navigates the agent from its current position to the given `location`.\n      # It converts a series of grid movements into corresponding action indices.\n      current_pos = env._current_state.pos\n      path = find_path(env._current_state.grid.shape, current_pos, location)\n      \n      actions = []\n      for i in range(1, len(path)):\n          dx = path[i][0] - path[i-1][0]\n          dy = path[i][1] - path[i-1][1]\n\n          # Map the movement to an action index\n          if (dx, dy) == (-1, 0):\n              actions.append(env.action_specs()['LEFT'])\n          elif (dx, dy) == (1, 0):\n              actions.append(env.action_specs()['RIGHT'])\n          elif (dx, dy) == (0, -1):\n              actions.append(env.action_specs()['UP'])\n          elif (dx, dy) == (0, 1):\n              actions.append(env.action_specs()['DOWN'])\n\n      return actions\n\n  def find_path(grid_shape, start, end):\n      # This function uses A* search to find the shortest path from `start` to `end`.\n      open_set = collections.PriorityQueue()\n      open_set.put((0, start))\n      came_from = {}\n      cost_so_far = {}\n      came_from[start] = None\n      cost_so_far[start] = 0\n\n      while not open_set.empty():\n          _, current = open_set.get()\n\n          if current == end:\n              break\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              new_cost = cost_so_far[current] + heuristic(current, neighbor)\n\n              if is_within_bounds(grid_shape, neighbor) and (neighbor not in cost_so_far or new_cost < cost_so_far[neighbor]):\n                  cost_so_far[neighbor] = new_cost\n                  priority = new_cost + heuristic(end, neighbor)\n                  open_set.put((priority, neighbor))\n                  came_from[neighbor] = current\n\n      return reconstruct_path(came_from, start, end)\n\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Find the workshop that allows crafting this item (if any)\n  workshop_index = get_workshop_for_item(item_index)\n\n  actions = []\n\n  if workshop_index is not None:\n      # Get the location of the nearest workshop of the required type\n      nearest_workshop_location = find_nearest_workshop(env, workshop_index)\n      \n      if nearest_workshop_location is not None:\n          # Navigate to the workshop location\n          actions.extend(navigate_to(env, nearest_workshop_location))\n          \n          # Use the workshop to craft the item\n          actions.append(env.action_specs()['USE'])\n  else:\n    # No specific workshop needed, likely a primitive item that can be crafted anywhere (e.g., STICK from WOOD)\n    actions.append(env.action_specs()['USE'])\n\n  return actions", "island_id": 9, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T21:09:36.722799", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n  recipes = env.world.cookbook.recipes\n  \n  # Check if the item has a recipe\n  if item_index not in recipes:\n      return []  # Return an empty list if no recipe is found\n\n  recipe = recipes[item_index]\n  \n  # Determine the workshop type required for crafting the item\n  workshop_type_key = recipe.get(\"_key\", None)\n  if not workshop_type_key:\n      return []  # Return an empty list if no workshop key is specified\n  \n  # Find all workshops of the needed type in the world\n  workshop_indices = [i for i, idx in enumerate(env.world.workshop_indices) \n                      if env.world.cookbook.index.get(idx) == workshop_type_key]\n  \n  if not workshop_indices:\n      return []  # Return an empty list if no valid workshops are found\n  \n  # Choose the first available workshop (for simplicity)\n  workshop_index = workshop_indices[0]\n\n  # Get the position of the chosen workshop from the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n      return []  # Return an empty list if no valid positions for the workshop are found\n\n  # Choose the first available position (for simplicity)\n  target_pos = tuple(workshop_positions[0])\n\n  # Calculate the actions needed to move to the target position\n  current_pos = env._current_state.pos\n  actions_to_move = pathfinding(current_pos, target_pos, grid)\n\n  if not actions_to_move:\n      return []  # Return an empty list if no valid path is found\n\n  # Add the USE action to craft the item\n  actions_to_craft = actions_to_move + [env.world.N_ACTIONS - 1]  # Assuming USE is the last action\n\n  return actions_to_craft", "island_id": 6, "scores": {"": 0.0}}
