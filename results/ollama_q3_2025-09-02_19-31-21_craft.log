\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  use_action_index = env.world.n_actions - 1  # Assuming the last action index corresponds to USE\n  actions_to_workshop.append(use_action_index)\n\n  return actions_to_workshop", "island_id": 1, "scores": {"": 4.7}}
{"timestamp": "2025-09-03T11:20:33.603012", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    # A* pathfinding algorithm for more efficient movement\n    open_set = collections.deque([current_pos])\n    came_from = {}\n    g_score = {current_pos: 0}\n    f_score = {current_pos: abs(target_pos[0] - current_pos[0]) + abs(target_pos[1] - current_pos[1])}\n\n    while open_set:\n      # Get the position with the lowest f score\n      current = min(open_set, key=lambda x: f_score[x])\n      open_set.remove(current)\n      \n      if current == target_pos:\n        break\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        \n        # Ensure the neighbor is within grid bounds\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n            tentative_g_score = g_score[current] + 1\n            \n            if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                came_from[neighbor] = current\n                g_score[neighbor] = tentative_g_score\n                f_score[neighbor] = tentative_g_score + abs(target_pos[0] - neighbor[0]) + abs(target_pos[1] - neighbor[1])\n                if neighbor not in open_set:\n                    open_set.append(neighbor)\n\n    # Reconstruct path\n    total_path = []\n    while current in came_from:\n      total_path.append(current)\n      current = came_from[current]\n    total_path.reverse()\n\n    for next_pos in total_path:\n      dx = next_pos[0] - current_pos[0]\n      dy = next_pos[1] - current_pos[1]\n\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      elif dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n\n      current_pos = next_pos\n      \n    return actions\n\n  def check_inventory(env, item_index):\n    \"\"\"Check if the required ingredients for crafting the item are in the inventory.\"\"\"\n    recipe = env.world.cookbook.recipes[item_index]\n    inventory = env._current_state.inventory\n    \n    missing_items = []\n    for ingredient, quantity in recipe.items():\n        if inventory.get(ingredient, 0) < quantity:\n            missing_items.append(ingredient)\n    \n    return missing_items\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Check inventory for required ingredients\n  missing_items = check_inventory(env, item_index)\n  if missing_items:\n    raise ValueError(f\"Missing items {missing_items} to craft '{item}'.\")\n\n  # Determine which workshop is required for crafting this item\n  # This step assumes that the recipe specifies the workshop type needed.\n  # Since the problem does not specify how to determine the workshop,\n  # we will assume that all workshops can craft any items for simplicity.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 0, "scores": {"": -1}}
{"timestamp": "2025-09-03T11:20:34.588535", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    # A* pathfinding algorithm for more efficient movement\n    open_set = collections.deque([current_pos])\n    came_from = {}\n    g_score = {current_pos: 0}\n    f_score = {current_pos: abs(target_pos[0] - current_pos[0]) + abs(target_pos[1] - current_pos[1])}\n\n    while open_set:\n      # Get the position with the lowest f score\n      current = min(open_set, key=lambda x: f_score[x])\n      open_set.remove(current)\n      \n      if current == target_pos:\n        break\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        \n        # Ensure the neighbor is within grid bounds\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n            tentative_g_score = g_score[current] + 1\n            \n            if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                came_from[neighbor] = current\n                g_score[neighbor] = tentative_g_score\n                f_score[neighbor] = tentative_g_score + abs(target_pos[0] - neighbor[0]) + abs(target_pos[1] - neighbor[1])\n                if neighbor not in open_set:\n                    open_set.append(neighbor)\n\n    # Reconstruct path\n    total_path = []\n    while current in came_from:\n      total_path.append(current)\n      current = came_from[current]\n    total_path.reverse()\n\n    for next_pos in total_path:\n      dx = next_pos[0] - current_pos[0]\n      dy = next_pos[1] - current_pos[1]\n\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      elif dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n\n      current_pos = next_pos\n      \n    return actions\n\n  def collect_primitives(env, primitives):\n    actions = []\n    grid = env._current_state.grid\n    pos = env._current_state.pos\n    \n    for primitive in primitives:\n        # Find the closest position of the primitive on the grid\n        min_distance = float('inf')\n        closest_primitive_pos = None\n        for i in range(grid.shape[0]):\n            for j in range(grid.shape[1]):\n                if grid[i, j, primitive] > 0:\n                    distance = abs(i - pos[0]) + abs(j - pos[1])\n                    if distance < min_distance:\n                        min_distance = distance\n                        closest_primitive_pos = (i, j)\n        \n        if not closest_primitive_pos:\n            raise ValueError(f\"No available {env.world.cookbook.index.reverse_mapping[primitive]} found on the grid.\")\n        \n        # Move to the closest primitive\n        actions.extend(move_to(env, closest_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n        \n        pos = closest_primitive_pos\n    \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Get the primitives required for crafting the item\n  recipe = env.world.cookbook.recipes[item_index]\n  primitives_required = [primitive for primitive, quantity in recipe.items() if quantity > 0]\n\n  # Collect all required primitives\n  actions_to_collect_primitives = collect_primitives(env, primitives_required)\n\n  # Determine which workshop is required for crafting this item\n  # This step assumes that the recipe specifies the workshop type needed.\n  # Since the problem does not specify how to determine the workshop,\n  # we will assume that all workshops can craft any items for simplicity.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_collect_primitives + actions_to_workshop", "island_id": 0, "scores": {"": -1}}
{"timestamp": "2025-09-03T11:22:07.413927", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n\n    # Iterate over all positions on the grid to find the closest workshop\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if any(grid[i, j, w] > 0 for w in workshop_indices):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n\n    # Calculate the direction to move in\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    # Determine movement order based on Manhattan distance minimization\n    if abs(dx) > abs(dy):\n      # Move horizontally first if needed\n      while dx != 0:\n        action = 3 if dx > 0 else 2\n        actions.append(action)\n        dx -= 1 if dx > 0 else -1\n\n      # Then move vertically if needed\n      while dy != 0:\n        action = 1 if dy > 0 else 0\n        actions.append(action)\n        dy -= 1 if dy > 0 else -1\n    else:\n      # Move vertically first if needed\n      while dy != 0:\n        action = 1 if dy > 0 else 0\n        actions.append(action)\n        dy -= 1 if dy > 0 else -1\n\n      # Then move horizontally if needed\n      while dx != 0:\n        action = 3 if dx > 0 else 2\n        actions.append(action)\n        dx -= 1 if dx > 0 else -1\n\n    return actions\n\n  def determine_workshop(item_index, workshop_indices):\n    \"\"\"Determine the specific workshop type required for crafting the item.\"\"\"\n    # Placeholder implementation. In practice, you would have a mapping of items to workshop indices.\n    # For simplicity, let's assume WORKSHOP0 can craft any item.\n\n    return workshop_indices[0]  # Placeholder\n\n  # Get the index of the item\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  workshop_indices = env.world.workshop_indices\n  workshop_index = determine_workshop(item_index, workshop_indices)\n\n  # Find the closest workshop of the required type\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 4, "scores": {"": 4.7}}
{"timestamp": "2025-09-03T11:22:08.396078", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n\n    # Iterate over all positions on the grid to find the closest workshop\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if any(grid[i, j, w] > 0 for w in workshop_indices):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n\n    # Calculate the direction to move in\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    # Move horizontally first if needed\n    while dx != 0:\n      action = 3 if dx > 0 else 2\n      actions.append(action)\n      dx -= 1 if dx > 0 else -1\n\n    # Then move vertically if needed\n    while dy != 0:\n      action = 1 if dy > 0 else 0\n      actions.append(action)\n      dy -= 1 if dy > 0 else -1\n\n    return actions\n\n  def determine_workshop(item_index, workshop_indices):\n    \"\"\"Determine the specific workshop type required for crafting the item.\"\"\"\n    # This is a placeholder implementation. In practice, you would have a mapping of items to workshop indices.\n    # For simplicity, let's assume WORKSHOP0 can craft any item.\n\n    return workshop_indices[0]  # Placeholder\n\n  def move_around(env):\n    \"\"\"Move around the environment to find and collect required primitives.\"\"\"\n    actions = []\n    max_steps = 10  # Limit the number of steps to avoid infinite loops\n    for _ in range(max_steps):\n      action = env.world.random_action()  # Assuming there's a method to generate random actions\n      actions.append(action)\n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  workshop_indices = env.world.workshop_indices\n  workshop_index = determine_workshop(item_index, workshop_indices)\n\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n\n  # If the inventory doesn't have all required primitives, move around to collect them\n  if not check_inventory(env, item_index):\n    actions_to_collect = move_around(env)\n  else:\n    actions_to_collect = []\n\n  # Find the closest workshop of the required type\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_collect + actions_to_workshop", "island_id": 4, "scores": {"": -1}}
{"timestamp": "2025-09-03T11:24:15.292600", "function_name": "craft", "function_body": "  def get_closest_workshop(item_index):\n    \"\"\"Finds the closest workshop that can craft the specified item.\"\"\"\n    # Determine the workshop required based on the recipe key\n    workshop_indices = []\n    for output_idx, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n        workshop_name = ingredients.get(\"_workshop\")\n        if workshop_name:\n          workshop_indices.append(env.world.cookbook.index[workshop_name])\n    \n    # If no specific workshop is needed, use a default one\n    if not workshop_indices:\n      return env.world.workshop_indices[0]  # Default to the first workshop type\n    \n    # Find the closest workshop in the grid\n    agent_pos = np.array(env._current_state.pos)\n    min_distance = float('inf')\n    closest_workshop_index = None\n    for workshop_index in workshop_indices:\n      for y in range(grid_shape[1]):\n        for x in range(grid_shape[0]):\n          if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n            target_pos = np.array((x, y))\n            distance = np.linalg.norm(agent_pos - target_pos)\n            if distance < min_distance:\n              min_distance = distance\n              closest_workshop_index = workshop_index\n    return closest_workshop_index\n\n  def path_to_target(start, target):\n    \"\"\"Computes the path from start position to target position using A* algorithm.\"\"\"\n    actions = []\n    # Define possible movements and their corresponding actions\n    moves = [(1, 0, 3), (-1, 0, 2), (0, 1, 1), (0, -1, 0)]  # RIGHT, LEFT, UP, DOWN\n    open_set = collections.deque([(start[0], start[1], [])])  # Queue for BFS\n    visited = set()\n    \n    while open_set:\n      x, y, path = open_set.popleft()\n      \n      if (x, y) == tuple(target):\n        return path\n      \n      if (x, y) in visited:\n        continue\n      \n      visited.add((x, y))\n      \n      for dx, dy, action in moves:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < grid_shape[0] and 0 <= ny < grid_shape[1]:\n          open_set.append((nx, ny, path + [action]))\n    \n    return actions\n\n  def get_required_primitives(item_index):\n    \"\"\"Retrieves the list of required primitives for crafting an item.\"\"\"\n    for output_idx, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n        return [primitive for primitive in ingredients.keys() if primitive != \"_key\" and primitive != \"_workshop\"]\n    return []\n\n  def ensure_inventory(item_index):\n    \"\"\"Ensures the inventory has all required primitives for crafting.\"\"\"\n    actions = []\n    current_inventory = env._current_state.inventory.copy()\n    \n    # Get the list of required primitives\n    required_primitives = get_required_primitives(item_index)\n    \n    # Collect each missing primitive from the environment\n    for primitive in required_primitives:\n      if primitive not in current_inventory or current_inventory[primitive] == 0:\n        collect_actions = collect(env, primitive)\n        actions.extend(collect_actions)\n        # Update inventory after collecting\n        current_inventory[primitive] += 1\n    \n    return actions\n\n  def update_inventory(item_index):\n    \"\"\"Updates the inventory based on crafted items.\"\"\"\n    env._current_state.inventory[item_index] += 1\n\n  item_index = env.world.cookbook.index[item]\n  grid_shape = env._current_state.grid.shape[:2]\n\n  # Ensure inventory has all required primitives\n  actions_to_collect_primitives = ensure_inventory(item_index)\n\n  # Find the closest workshop for crafting\n  workshop_index = get_closest_workshop(item_index)\n\n  # Find the position of the closest workshop in the grid\n  agent_pos = np.array(env._current_state.pos)\n  workshop_pos = None\n  min_distance = float('inf')\n  for y in range(grid_shape[1]):\n    for x in range(grid_shape[0]):\n      if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n        target_pos = np.array((x, y))\n        distance = np.linalg.norm(agent_pos - target_pos)\n        if distance < min_distance:\n          min_distance = distance\n          workshop_pos = (x, y)\n\n  # If no workshop position is found, return an empty list of actions\n  if workshop_pos is None:\n    return []\n\n  # Calculate the path to the closest workshop and perform the USE action\n  target_pos = np.array(workshop_pos)\n  actions_to_workshop = path_to_target(agent_pos[:2], target_pos)\n  actions_to_workshop.append(4)  # USE to craft the item\n\n  # Update inventory after crafting\n  update_inventory(item_index)\n\n  return actions_to_collect_primitives + actions_to_workshop", "island_id": 2, "scores": {"": 2.7}}
{"timestamp": "2025-09-03T11:24:16.407686", "function_name": "craft", "function_body": "  def get_closest_workshop(item_index):\n    \"\"\"Finds the closest workshop that can craft the specified item.\"\"\"\n    workshop_indices = []\n    for output_idx, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n        workshop_name = ingredients.get(\"_workshop\")\n        if workshop_name:\n          workshop_indices.append(env.world.cookbook.index[workshop_name])\n    \n    # If no specific workshop is needed, use a default one\n    if not workshop_indices:\n      return env.world.workshop_indices[0]\n    \n    agent_pos = np.array(env._current_state.pos)\n    min_distance = float('inf')\n    closest_workshop_index = None\n    grid_shape = env._current_state.grid.shape[:2]\n\n    for workshop_index in workshop_indices:\n      for y in range(grid_shape[1]):\n        for x in range(grid_shape[0]):\n          if env._current_state.grid[x, y, workshop_index] > 0:\n            target_pos = np.array((x, y))\n            distance = np.linalg.norm(agent_pos - target_pos)\n            if distance < min_distance:\n              min_distance = distance\n              closest_workshop_index = workshop_index\n    return closest_workshop_index\n\n  def path_to_target(start, target):\n    \"\"\"Computes the path from start position to target position using A* algorithm.\"\"\"\n    moves = [(1, 0, 3), (-1, 0, 2), (0, 1, 1), (0, -1, 0)]  # RIGHT, LEFT, UP, DOWN\n    open_set = collections.deque([(start[0], start[1], [])])  # Queue for BFS\n    visited = set()\n    \n    while open_set:\n      x, y, path = open_set.popleft()\n      \n      if (x, y) == tuple(target):\n        return path\n      \n      if (x, y) in visited:\n        continue\n      \n      visited.add((x, y))\n      \n      for dx, dy, action in moves:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < grid_shape[0] and 0 <= ny < grid_shape[1]:\n          open_set.append((nx, ny, path + [action]))\n    \n    return []\n\n  def get_required_primitives(item_index):\n    \"\"\"Retrieves the list of required primitives for crafting an item.\"\"\"\n    for output_idx, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n        return [primitive for primitive in ingredients.keys() if primitive != \"_key\" and primitive != \"_workshop\"]\n    return []\n\n  def ensure_inventory(item_index):\n    \"\"\"Ensures the inventory has all required primitives for crafting.\"\"\"\n    actions = []\n    current_inventory = env._current_state.inventory.copy()\n    \n    # Get the list of required primitives\n    required_primitives = get_required_primitives(item_index)\n    \n    # Collect each missing primitive from the environment\n    for primitive in required_primitives:\n      if primitive not in current_inventory or current_inventory[primitive] == 0:\n        collect_actions = collect(env, primitive)\n        actions.extend(collect_actions)\n        # Update inventory after collecting\n        current_inventory[primitive] += 1\n    \n    return actions\n\n  def update_inventory(item_index):\n    \"\"\"Updates the inventory based on crafted items.\"\"\"\n    env._current_state.inventory[item_index] += 1\n\n  item_index = env.world.cookbook.index[item]\n  grid_shape = env._current_state.grid.shape[:2]\n\n  # Ensure inventory has all required primitives\n  actions_to_collect_primitives = ensure_inventory(item_index)\n\n  # Find the closest workshop for crafting\n  workshop_index = get_closest_workshop(item_index)\n\n  # Find the position of the closest workshop in the grid\n  agent_pos = np.array(env._current_state.pos)\n  workshop_pos = None\n  min_distance = float('inf')\n\n  for y in range(grid_shape[1]):\n    for x in range(grid_shape[0]):\n      if env._current_state.grid[x, y, workshop_index] > 0:\n        target_pos = np.array((x, y))\n        distance = np.linalg.norm(agent_pos - target_pos)\n        if distance < min_distance:\n          min_distance = distance\n          workshop_pos = (x, y)\n\n  # If no workshop position is found, return an empty list of actions\n  if workshop_pos is None:\n    return []\n\n  # Calculate the path to the closest workshop and perform the USE action\n  target_pos = np.array(workshop_pos)\n  actions_to_workshop = path_to_target(agent_pos[:2], target_pos)\n  actions_to_workshop.append(4)  # USE to craft the item\n\n  # Update inventory after crafting\n  update_inventory(item_index)\n\n  return actions_to_collect_primitives + actions_to_workshop", "island_id": 2, "scores": {"": 2.7}}
{"timestamp": "2025-09-03T11:25:33.582774", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Iterate over all positions in the grid to find the closest workshop\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if any(grid[i, j, w] > 0 for w in workshop_indices):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    # Calculate the differences in x and y coordinates\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    # Move horizontally first\n    if dx > 0:\n        actions.extend([3] * abs(dx))  # RIGHT\n    elif dx < 0:\n        actions.extend([2] * abs(dx))  # LEFT\n\n    # Then move vertically\n    if dy > 0:\n        actions.extend([1] * abs(dy))  # UP\n    elif dy < 0:\n        actions.extend([0] * abs(dy))  # DOWN\n      \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  # For simplicity, we assume that all workshops can craft any items.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Find the closest workshop on the grid\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Generate actions to move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 9, "scores": {"": 4.7}}
{"timestamp": "2025-09-03T11:25:34.635420", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Iterate over all positions in the grid to find the closest workshop\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if any(grid[i, j, w] > 0 for w in workshop_indices):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    # Calculate the differences in x and y coordinates\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    # Determine direction to move horizontally and vertically\n    if dx > 0:\n      horizontal_action = 3  # RIGHT\n    elif dx < 0:\n      horizontal_action = 2  # LEFT\n    else:\n      horizontal_action = None\n\n    if dy > 0:\n      vertical_action = 1  # UP\n    elif dy < 0:\n      vertical_action = 0  # DOWN\n    else:\n      vertical_action = None\n\n    # Move horizontally first if necessary\n    while dx != 0:\n      actions.append(horizontal_action)\n      dx += -1 if dx > 0 else 1\n\n    # Then move vertically if necessary\n    while dy != 0:\n      actions.append(vertical_action)\n      dy += -1 if dy > 0 else 1\n      \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  # For simplicity, we assume that all workshops can craft any items.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Find the closest workshop on the grid\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Generate actions to move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 9, "scores": {"": 4.7}}
