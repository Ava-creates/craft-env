No available workshops found on the grid.\")\n  \n  # Move to the closest workshop\n  actions.extend(move_to(env, closest_workshop_pos))\n  \n  # Use the USE action to craft the item at the workshop\n  actions.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions", "island_id": 6, "scores": {"": 4.7}}
{"timestamp": "2025-09-03T07:14:58.505879", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    # A* pathfinding algorithm for more efficient movement\n    open_set = collections.deque([current_pos])\n    came_from = {}\n    g_score = {current_pos: 0}\n    f_score = {current_pos: abs(target_pos[0] - current_pos[0]) + abs(target_pos[1] - current_pos[1])}\n\n    while open_set:\n      # Sort the open set based on f_score for A*\n      open_set = collections.deque(sorted(open_set, key=lambda x: f_score[x]))\n      \n      current = open_set.popleft()\n      \n      if current == target_pos:\n        break\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        \n        tentative_g_score = g_score[current] + 1\n        \n        if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n          came_from[neighbor] = current\n          g_score[neighbor] = tentative_g_score\n          f_score[neighbor] = tentative_g_score + abs(target_pos[0] - neighbor[0]) + abs(target_pos[1] - neighbor[1])\n          open_set.append(neighbor)\n\n    # Reconstruct path\n    total_path = []\n    while current in came_from:\n      total_path.append(current)\n      current = came_from[current]\n    total_path.reverse()\n\n    for next_pos in total_path:\n      dx = next_pos[0] - current_pos[0]\n      dy = next_pos[1] - current_pos[1]\n\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      elif dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n\n      current_pos = next_pos\n      \n    return actions\n\n  def collect_primitives(env, primitives):\n    \"\"\"Collects all the required primitive items.\"\"\"\n    actions = []\n    for primitive in primitives:\n      # Find the closest position of the primitive\n      grid = env._current_state.grid\n      pos = env._current_state.pos\n      primitive_index = env.world.cookbook.index[primitive]\n      \n      min_distance = float('inf')\n      closest_primitive_pos = None\n      \n      for i in range(grid.shape[0]):\n        for j in range(grid.shape[1]):\n          if grid[i, j, primitive_index] > 0:\n            distance = abs(i - pos[0]) + abs(j - pos[1])\n            if distance < min_distance:\n              min_distance = distance\n              closest_primitive_pos = (i, j)\n      \n      if not closest_primitive_pos:\n        raise ValueError(f\"No available '{primitive}' found on the grid.\")\n      \n      # Move to the closest primitive and collect it\n      actions.extend(move_to(env, closest_primitive_pos))\n      actions.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n      \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  # This step assumes that the recipe specifies the workshop type needed.\n  # Since the problem does not specify how to determine the workshop,\n  # we will assume that all workshops can craft any items for simplicity.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Determine required primitives for crafting the item\n  recipe = env.world.cookbook.recipes[item_index]\n  required_primitives = [k for k in recipe.keys() if k != '_output']\n\n  # Collect all required primitives\n  actions_to_collect_primitives = collect_primitives(env, required_primitives)\n  \n  # Move to the closest workshop after collecting primitives\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n\n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_collect_primitives + actions_to_workshop", "island_id": 6, "scores": {"": -1}}
{"timestamp": "2025-09-03T07:14:59.488288", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    # A* pathfinding algorithm for more efficient movement\n    open_set = collections.deque([current_pos])\n    came_from = {}\n    g_score = {current_pos: 0}\n    f_score = {current_pos: abs(target_pos[0] - current_pos[0]) + abs(target_pos[1] - target_pos[1])}\n\n    while open_set:\n      current = open_set.popleft()\n      \n      if current == target_pos:\n        break\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        \n        tentative_g_score = g_score[current] + 1\n        \n        if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n          came_from[neighbor] = current\n          g_score[neighbor] = tentative_g_score\n          f_score[neighbor] = tentative_g_score + abs(target_pos[0] - neighbor[0]) + abs(target_pos[1] - neighbor[1])\n          open_set.append(neighbor)\n\n    # Reconstruct path\n    total_path = []\n    while current in came_from:\n      total_path.append(current)\n      current = came_from[current]\n    total_path.reverse()\n\n    for next_pos in total_path:\n      dx = next_pos[0] - current_pos[0]\n      dy = next_pos[1] - current_pos[1]\n\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      elif dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n\n      current_pos = next_pos\n      \n    return actions\n\n  def get_required_primitives(item_index):\n    \"\"\"Retrieve the required primitives for crafting an item.\"\"\"\n    if item_index not in env.world.cookbook.recipes:\n        raise ValueError(f\"No recipe found for item index {item_index}\")\n    \n    recipe = env.world.cookbook.recipes[item_index]\n    primitives = []\n    for primitive, count in recipe.items():\n      if primitive in env.world.cookbook.primitives:\n          primitives.append(primitive)\n      else:\n          # Recursively get required primitives for sub-items\n          primitives.extend(get_required_primitives(primitive))\n    \n    return list(set(primitives))\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n      raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  # This step assumes that the recipe specifies the workshop type needed.\n  # Since the problem does not specify how to determine the workshop,\n  # we will assume that all workshops can craft any items for simplicity.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Get required primitives\n  required_primitives = get_required_primitives(item_index)\n\n  actions = []\n  \n  for primitive in required_primitives:\n    actions.extend(collect(env, primitive))\n    \n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n      raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  actions.extend(actions_to_workshop)\n\n  return actions", "island_id": 6, "scores": {"": -1}}
{"timestamp": "2025-09-03T07:17:09.216835", "function_name": "craft", "function_body": "  def get_closest_workshop(item_index):\n    \"\"\"Finds the closest workshop that can craft the specified item.\"\"\"\n    workshop_indices = []\n    for output_idx, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n        workshop_name = ingredients.get(\"_workshop\")\n        if workshop_name:\n          workshop_indices.append(env.world.cookbook.index[workshop_name])\n    \n    # If no specific workshop is needed, use a default one\n    if not workshop_indices:\n      return env.world.workshop_indices[0]  # Default to the first workshop type\n    \n    # Find the closest workshop in the grid\n    agent_pos = np.array(env._current_state.pos)\n    min_distance = float('inf')\n    closest_workshop_index = None\n    for workshop_index in workshop_indices:\n      for y in range(grid_shape[1]):\n        for x in range(grid_shape[0]):\n          if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n            target_pos = np.array((x, y))\n            distance = np.linalg.norm(agent_pos - target_pos)\n            if distance < min_distance:\n              min_distance = distance\n              closest_workshop_index = workshop_index\n    return closest_workshop_index\n\n  def path_to_target(start, target):\n    \"\"\"Computes the path from start position to target position using A* algorithm.\"\"\"\n    actions = []\n    # Define possible movements and their corresponding actions\n    moves = [(1, 0, 3), (-1, 0, 2), (0, 1, 1), (0, -1, 0)]  # RIGHT, LEFT, UP, DOWN\n    open_set = collections.deque([(start[0], start[1], [])])  # Queue for BFS\n    visited = set()\n    \n    while open_set:\n      x, y, path = open_set.popleft()\n      \n      if (x, y) == tuple(target):\n        return path\n      \n      if (x, y) in visited:\n        continue\n      \n      visited.add((x, y))\n      \n      for dx, dy, action in moves:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < grid_shape[0] and 0 <= ny < grid_shape[1]:\n          open_set.append((nx, ny, path + [action]))\n    \n    return actions\n\n  def get_required_primitives(item_index):\n    \"\"\"Retrieves the list of required primitives for crafting an item.\"\"\"\n    for output_idx, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n        return [primitive for primitive in ingredients.keys() if primitive != \"_key\" and primitive != \"_workshop\"]\n    return []\n\n  def ensure_inventory(item_index):\n    \"\"\"Ensures the inventory has all required primitives for crafting.\"\"\"\n    actions = []\n    current_inventory = env._current_state.inventory.copy()\n    \n    # Get the list of required primitives\n    required_primitives = get_required_primitives(item_index)\n    \n    # Collect each missing primitive from the environment\n    for primitive in required_primitives:\n      if primitive not in current_inventory or current_inventory[primitive] == 0:\n        collect_actions = collect(env, primitive)\n        actions.extend(collect_actions)\n        # Update inventory after collecting\n        current_inventory[primitive] += 1\n    \n    return actions\n\n  def update_inventory(item_index):\n    \"\"\"Updates the inventory based on crafted items.\"\"\"\n    env._current_state.inventory[item_index] += 1\n\n  item_index = env.world.cookbook.index[item]\n  grid_shape = env._current_state.grid.shape[:2]\n\n  # Ensure inventory has all required primitives\n  actions_to_collect_primitives = ensure_inventory(item_index)\n\n  # Find the closest workshop for crafting\n  workshop_index = get_closest_workshop(item_index)\n\n  # Find the position of the closest workshop in the grid\n  agent_pos = np.array(env._current_state.pos)\n  workshop_pos = None\n  min_distance = float('inf')\n  for y in range(grid_shape[1]):\n    for x in range(grid_shape[0]):\n      if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n        target_pos = np.array((x, y))\n        distance = np.linalg.norm(agent_pos - target_pos)\n        if distance < min_distance:\n          min_distance = distance\n          workshop_pos = (x, y)\n\n  # If no workshop position is found, return an empty list of actions\n  if workshop_pos is None:\n    return []\n\n  # Calculate the path to the closest workshop and perform the USE action\n  target_pos = np.array(workshop_pos)\n  actions_to_workshop = path_to_target(agent_pos[:2], target_pos)\n  actions_to_workshop.append(4)  # USE to craft the item\n\n  # Update inventory after crafting\n  update_inventory(item_index)\n\n  return actions_to_collect_primitives + actions_to_workshop", "island_id": 2, "scores": {"": 2.7}}
{"timestamp": "2025-09-03T07:17:10.268467", "function_name": "craft", "function_body": "  def get_closest_workshop(item_index):\n    \"\"\"Finds the closest workshop that can craft the specified item.\"\"\"\n    # Determine the workshop required based on the recipe key\n    workshop_indices = []\n    for output_idx, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n        workshop_name = ingredients.get(\"_workshop\")\n        if workshop_name:\n          workshop_indices.append(env.world.cookbook.index[workshop_name])\n    \n    # If no specific workshop is needed, use a default one\n    if not workshop_indices:\n      return env.world.workshop_indices[0]  # Default to the first workshop type\n    \n    # Find the closest workshop in the grid\n    agent_pos = np.array(env._current_state.pos)\n    min_distance = float('inf')\n    closest_workshop_index = None\n    for workshop_index in workshop_indices:\n      for y in range(grid_shape[1]):\n        for x in range(grid_shape[0]):\n          if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n            target_pos = np.array((x, y))\n            distance = np.linalg.norm(agent_pos - target_pos)\n            if distance < min_distance:\n              min_distance = distance\n              closest_workshop_index = workshop_index\n    return closest_workshop_index\n\n  def path_to_target(start, target):\n    \"\"\"Computes the path from start position to target position using A* algorithm.\"\"\"\n    actions = []\n    # Define possible movements and their corresponding actions\n    moves = [(1, 0, 3), (-1, 0, 2), (0, 1, 1), (0, -1, 0)]  # RIGHT, LEFT, UP, DOWN\n    open_set = collections.deque([(start[0], start[1], [])])  # Queue for BFS\n    visited = set()\n    \n    while open_set:\n      x, y, path = open_set.popleft()\n      \n      if (x, y) == tuple(target):\n        return path\n      \n      if (x, y) in visited:\n        continue\n      \n      visited.add((x, y))\n      \n      for dx, dy, action in moves:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < grid_shape[0] and 0 <= ny < grid_shape[1]:\n          open_set.append((nx, ny, path + [action]))\n    \n    return actions\n\n  def get_required_primitives(item_index):\n    \"\"\"Retrieves the list of required primitives for crafting an item.\"\"\"\n    for output_idx, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n        return [primitive for primitive in ingredients.keys() if primitive != \"_key\" and primitive != \"_workshop\"]\n    return []\n\n  def ensure_inventory(item_index):\n    \"\"\"Ensures the inventory has all required primitives for crafting.\"\"\"\n    actions = []\n    current_inventory = env._current_state.inventory.copy()\n    \n    # Get the list of required primitives\n    required_primitives = get_required_primitives(item_index)\n    \n    # Collect each missing primitive from the environment\n    for primitive in required_primitives:\n      if primitive not in current_inventory or current_inventory[primitive] == 0:\n        collect_actions = collect(env, primitive)\n        actions.extend(collect_actions)\n        # Update inventory after collecting\n        current_inventory[primitive] += 1\n    \n    return actions\n\n  def update_inventory(item_index):\n    \"\"\"Updates the inventory based on crafted items.\"\"\"\n    env._current_state.inventory[item_index] += 1\n\n  item_index = env.world.cookbook.index[item]\n  grid_shape = env._current_state.grid.shape[:2]\n\n  # Ensure inventory has all required primitives\n  actions_to_collect_primitives = ensure_inventory(item_index)\n\n  # Find the closest workshop for crafting\n  workshop_index = get_closest_workshop(item_index)\n\n  # Find the position of the closest workshop in the grid\n  agent_pos = np.array(env._current_state.pos)\n  workshop_pos = None\n  min_distance = float('inf')\n  for y in range(grid_shape[1]):\n    for x in range(grid_shape[0]):\n      if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n        target_pos = np.array((x, y))\n        distance = np.linalg.norm(agent_pos - target_pos)\n        if distance < min_distance:\n          min_distance = distance\n          workshop_pos = (x, y)\n\n  # If no workshop position is found, return an empty list of actions\n  if workshop_pos is None:\n    return []\n\n  # Calculate the path to the closest workshop and perform the USE action\n  target_pos = np.array(workshop_pos)\n  actions_to_workshop = path_to_target(agent_pos[:2], target_pos)\n  actions_to_workshop.append(4)  # USE to craft the item\n\n  # Update inventory after crafting\n  update_inventory(item_index)\n\n  return actions_to_collect_primitives + actions_to_workshop", "island_id": 2, "scores": {"": 2.7}}
{"timestamp": "2025-09-03T07:18:45.051848", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n\n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      # Move horizontally first if the difference is larger or equal\n      if abs(dx) >= abs(dy):\n          if dx > 0:\n              actions.append(3)  # RIGHT\n          elif dx < 0:\n              actions.append(2)  # LEFT\n      else:  # Otherwise, move vertically\n          if dy > 0:\n              actions.append(1)  # UP\n          elif dy < 0:\n              actions.append(0)  # DOWN\n\n      # Update current position based on the action taken\n      if abs(dx) >= abs(dy):\n        current_pos = (current_pos[0] + (dx // abs(dx)), current_pos[1])\n      else:\n        current_pos = (current_pos[0], current_pos[1] + (dy // abs(dy)))\n\n    return actions\n\n  def determine_workshop(item_index, workshop_indices):\n    \"\"\"Determine the specific workshop type required for crafting the item.\"\"\"\n    # Assuming there are different types of workshops and each can craft certain items.\n    # This is a placeholder implementation. In practice, you would have a mapping of items to workshop indices.\n\n    # For simplicity, let's assume WORKSHOP0 can craft any item.\n    return workshop_indices[0]  # Placeholder\n\n  def check_inventory(env, recipe):\n    \"\"\"Check if the inventory contains all required items for crafting.\"\"\"\n    inventory = env._current_state.inventory\n    for ingredient in recipe:\n        if ingredient not in inventory or inventory[ingredient] < recipe[ingredient]:\n            return False\n    return True\n  \n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  recipe = env.world.cookbook.recipes[item_index]\n  \n  # Ensure that all required items are in the inventory\n  if not check_inventory(env, recipe):\n    raise ValueError(f\"Not enough ingredients to craft '{item}'.\")\n  \n  workshop_indices = env.world.workshop_indices\n\n  # Determine which workshop is required for crafting this item\n  workshop_index = determine_workshop(item_index, workshop_indices)\n\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  \n  # Find the closest workshop of the required type\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 4, "scores": {"": -1}}
{"timestamp": "2025-09-03T07:18:46.098494", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n\n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n\n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      # Determine the direction to move first based on which is closer\n      if abs(dx) > abs(dy):\n          # Move horizontally first\n          if dx > 0:\n              actions.append(3)  # RIGHT\n          elif dx < 0:\n              actions.append(2)  # LEFT\n      else:\n          # Move vertically first\n          if dy > 0:\n              actions.append(1)  # UP\n          elif dy < 0:\n              actions.append(0)  # DOWN\n\n      # Update current position based on the action taken\n      if dx != 0 and abs(dx) >= abs(dy):\n        current_pos = (current_pos[0] + (dx // abs(dx)), current_pos[1])\n      else:\n        current_pos = (current_pos[0], current_pos[1] + (dy // abs(dy)))\n\n    return actions\n\n  def determine_workshop(item_index, workshop_indices):\n    \"\"\"Determine the specific workshop type required for crafting the item.\"\"\"\n    # Assuming there are different types of workshops and each can craft certain items.\n    # This is a placeholder implementation. In practice, you would have a mapping of items to workshop indices.\n\n    # For simplicity, let's assume WORKSHOP0 can craft any item.\n    return workshop_indices[0]  # Placeholder\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  workshop_indices = env.world.workshop_indices\n\n  # Determine which workshop is required for crafting this item\n  workshop_index = determine_workshop(item_index, workshop_indices)\n\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  \n  # Find the closest workshop of the required type\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 4, "scores": {"": 0.90000004}}
{"timestamp": "2025-09-03T07:20:37.071966", "function_name": "craft", "function_body": "  def move_to_position(current_pos, target_pos):\n    \"\"\"Helper function to generate movement actions to reach the target position.\"\"\"\n    x_diff = target_pos[0] - current_pos[0]\n    y_diff = target_pos[1] - current_pos[1]\n\n    # Generate LEFT/RIGHT movements\n    if x_diff < 0:\n      actions.extend([2] * abs(x_diff))  # LEFT\n    elif x_diff > 0:\n      actions.extend([3] * abs(x_diff))  # RIGHT\n\n    # Generate DOWN/UP movements\n    if y_diff < 0:\n      actions.extend([1] * abs(y_diff))  # UP\n    elif y_diff > 0:\n      actions.extend([0] * abs(y_diff))  # DOWN\n\n  def calculate_direction_to_face(current_dir, target_pos, current_pos):\n    \"\"\"Helper function to determine the direction the agent needs to face.\"\"\"\n    x_diff = target_pos[0] - current_pos[0]\n    y_diff = target_pos[1] - current_pos[1]\n\n    if x_diff > 0:\n      return 3  # RIGHT\n    elif x_diff < 0:\n      return 2  # LEFT\n    elif y_diff > 0:\n      return 0  # DOWN\n    elif y_diff < 0:\n      return 1  # UP\n\n    return current_dir\n\n  def turn_towards(current_dir, target_dir):\n    \"\"\"Helper function to generate turn actions to face the target direction.\"\"\"\n    if current_dir == target_dir:\n      return []\n    \n    # Calculate the difference in directions\n    diff = (target_dir - current_dir) % 4\n    \n    if diff == 1:\n      actions = [3]  # Turn RIGHT\n    elif diff == 2:\n      actions = [0, 1]  # Turn 180 degrees (e.g., DOWN + UP)\n    elif diff == 3:\n      actions = [2]  # Turn LEFT\n    \n    return actions\n\n  def find_workshop(workshop_type):\n    \"\"\"Helper function to find the index of the corresponding workshop.\"\"\"\n    for idx, workshop in enumerate(env.world.cookbook.index):\n        if workshop.startswith(workshop_type):\n            return env.world.workshop_indices[idx]\n    return None\n  \n  def check_and_move_to_workshop():\n      # Find the workshop type required for crafting\n      recipe = env.world.cookbook.recipes.get(item_index, {})\n      if \"_key\" in recipe:\n          workshop_type = recipe[\"_key\"]\n\n          # Find the index of the corresponding workshop in the world configuration\n          selected_workshop_index = find_workshop(workshop_type)\n          \n          if selected_workshop_index is not None:\n              # Determine the position of the selected workshop from the current state's grid\n              workshop_positions = np.argwhere(env._current_state.grid[:, :, selected_workshop_index] > 0)\n\n              if len(workshop_positions) > 0:\n                  target_pos = tuple(workshop_positions[0])\n\n                  # Move to the target position of the workshop\n                  move_to_position(env._current_state.pos, target_pos)\n                  \n                  # Turn to face the workshop (simple direction check for now)\n                  current_dir = env._current_state.dir\n                  target_dir = calculate_direction_to_face(current_dir, target_pos, env._current_state.pos)\n                  actions.extend(turn_towards(current_dir, target_dir))\n                  \n                  # Perform the USE action to start crafting\n                  actions.append(4)  # USE action index\n\n  def collect_primitives():\n      primitives_needed = []\n      \n      # Get the list of primitives needed for crafting the item\n      recipe = env.world.cookbook.recipes.get(item_index, {})\n      for ingredient, quantity in recipe.items():\n          if ingredient in env.world.cookbook.primitives:\n              primitives_needed.extend([ingredient] * quantity)\n\n      # Collect all required primitives\n      current_pos = env._current_state.pos\n      inventory = collections.Counter(env._current_state.inventory)\n      \n      for primitive in primitives_needed:\n          if inventory[primitive] < 1:\n              # Find the position of the required primitive in the grid\n              primitive_index = env.world.cookbook.index[primitive]\n              primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] > 0)\n\n              if len(primitive_positions) > 0:\n                  target_pos = tuple(primitive_positions[0])\n\n                  # Move to the target position of the primitive\n                  move_to_position(current_pos, target_pos)\n                  \n                  # Collect the primitive by performing the USE action\n                  actions.append(4)  # USE action index\n\n                  # Update current position and inventory\n                  current_pos = target_pos\n                  inventory[primitive] += 1\n\n  actions = []\n\n  # Get the index of the desired item to be crafted\n  item_index = env.world.cookbook.index[item]\n\n  # Check if primitives are needed and collect them\n  collect_primitives()\n\n  # Move to the workshop and craft the item\n  check_and_move_to_workshop()\n  \n  return actions", "island_id": 3, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T07:20:38.181200", "function_name": "craft", "function_body": "  def move_to_position(current_pos, target_pos):\n    \"\"\"Helper function to generate movement actions to reach the target position.\"\"\"\n    x_diff = target_pos[0] - current_pos[0]\n    y_diff = target_pos[1] - current_pos[1]\n\n    # Generate LEFT/RIGHT movements\n    if x_diff < 0:\n      actions.extend([2] * abs(x_diff))  # LEFT\n    elif x_diff > 0:\n      actions.extend([3] * abs(x_diff))  # RIGHT\n\n    # Generate DOWN/UP movements\n    if y_diff < 0:\n      actions.extend([1] * abs(y_diff))  # UP\n    elif y_diff > 0:\n      actions.extend([0] * abs(y_diff))  # DOWN\n  \n  def calculate_direction_to_face(current_dir, target_pos, current_pos):\n    \"\"\"Helper function to determine the direction the agent needs to face.\"\"\"\n    x_diff = target_pos[0] - current_pos[0]\n    y_diff = target_pos[1] - current_pos[1]\n\n    if x_diff > 0:\n      return 3  # RIGHT\n    elif x_diff < 0:\n      return 2  # LEFT\n    elif y_diff > 0:\n      return 0  # DOWN\n    elif y_diff < 0:\n      return 1  # UP\n\n    return current_dir\n\n  def turn_towards(current_dir, target_dir):\n    \"\"\"Helper function to generate turn actions to face the target direction.\"\"\"\n    if current_dir == target_dir:\n      return []\n    \n    # Calculate the difference in directions\n    diff = (target_dir - current_dir) % 4\n    \n    if diff == 1:\n      actions = [3]  # Turn RIGHT\n    elif diff == 2:\n      actions = [0, 1]  # Turn 180 degrees (e.g., DOWN + UP)\n    elif diff == 3:\n      actions = [2]  # Turn LEFT\n    \n    return actions\n\n  def find_workshop(workshop_type):\n    \"\"\"Helper function to find the index of the corresponding workshop.\"\"\"\n    for idx, workshop in enumerate(env.world.cookbook.index):\n        if workshop.startswith(workshop_type):\n            return env.world.workshop_indices[idx]\n    return None\n  \n  actions = []\n\n  # Get the index of the desired item to be crafted\n  item_index = env.world.cookbook.index[item]\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n\n  if \"_key\" in recipe:\n      workshop_type = recipe[\"_key\"]\n\n      # Find the index of the corresponding workshop in the world configuration\n      selected_workshop_index = find_workshop(workshop_type)\n      \n      if selected_workshop_index is not None:\n          # Determine the position of the selected workshop from the current state's grid\n          workshop_positions = np.argwhere(env._current_state.grid[:, :, selected_workshop_index] > 0)\n\n          if len(workshop_positions) > 0:\n              target_pos = tuple(workshop_positions[0])\n\n              # Move to the target position of the workshop\n              move_to_position(env._current_state.pos, target_pos)\n              \n              # Turn to face the workshop\n              current_dir = env._current_state.dir\n              target_dir = calculate_direction_to_face(current_dir, target_pos, env._current_state.pos)\n              actions.extend(turn_towards(current_dir, target_dir))\n              \n              # Perform the USE action to start crafting\n              actions.append(4)  # USE action index\n  \n  return actions", "island_id": 3, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T07:22:07.989290", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      # Determine the direction to move in\n      if abs(dx) > abs(dy):\n        # Move horizontally first if needed\n        if dx > 0:\n          actions.append(3)  # RIGHT\n          current_pos = (current_pos[0] + 1, current_pos[1])\n        else:\n          actions.append(2)  # LEFT\n          current_pos = (current_pos[0] - 1, current_pos[1])\n      else:\n        # Then move vertically if needed\n        if dy > 0:\n          actions.append(1)  # UP\n          current_pos = (current_pos[0], current_pos[1] + 1)\n        else:\n          actions.append(0)  # DOWN\n          current_pos = (current_pos[0], current_pos[1] - 1)\n      \n    return actions\n\n  def determine_workshop(item_index, workshop_indices):\n    \"\"\"Determine the specific workshop type required for crafting the item.\"\"\"\n    # Assuming there are different types of workshops and each can craft certain items.\n    # This is a placeholder implementation. In practice, you would have a mapping of items to workshop indices.\n    # For simplicity, let's assume WORKSHOP0 can craft any item.\n\n    return workshop_indices[0]  # Placeholder\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  workshop_indices = env.world.workshop_indices\n\n  # Determine which workshop is required for crafting this item\n  workshop_index = determine_workshop(item_index, workshop_indices)\n\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  \n  # Find the closest workshop of the required type\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 4, "scores": {"": 4.7}}
{"timestamp": "2025-09-03T07:22:08.989062", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n\n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      # Move horizontally first if needed\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      \n      # Then move vertically if needed\n      if dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n\n      current_pos = (current_pos[0] + (dx // abs(dx)) if dx != 0 else current_pos[0],\n                     current_pos[1] + (dy // abs(dy)) if dy != 0 else current_pos[1])\n      \n    return actions\n  \n  def determine_workshop(item_index, workshop_indices):\n      # Check the recipes to determine which workshop can craft the item.\n      cookbook = env.world.cookbook\n      for recipe in cookbook.recipes.values():\n          if item_index in recipe:\n              # Assuming the first key is the workshop type needed\n              return next(iter(recipe.keys()))\n      raise ValueError(f\"No workshop found that can craft item {item}\")\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  workshop_indices = env.world.workshop_indices\n\n  # Determine which workshop is required for crafting this item\n  workshop_type_needed = determine_workshop(item_index, workshop_indices)\n\n  # Find the closest workshop of the required type\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  \n  # Filter workshops to only those that can craft the item\n  specific_workshops = [w for w in workshop_indices if grid[:, :, w].any()]\n  \n  if not specific_workshops:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 4, "scores": {"": -1}}
{"timestamp": "2025-09-03T07:23:25.108420", "function_name": "craft", "function_body": "  def move_to_position(current_pos, target_pos):\n    \"\"\"Helper function to generate movement actions to reach the target position.\"\"\"\n    x_diff = target_pos[0] - current_pos[0]\n    y_diff = target_pos[1] - current_pos[1]\n\n    # Generate LEFT/RIGHT movements\n    if x_diff < 0:\n      actions.extend([2] * abs(x_diff))  # LEFT\n    elif x_diff > 0:\n      actions.extend([3] * abs(x_diff))  # RIGHT\n\n    # Generate DOWN/UP movements\n    if y_diff < 0:\n      actions.extend([1] * abs(y_diff))  # UP\n    elif y_diff > 0:\n      actions.extend([0] * abs(y_diff))  # DOWN\n  \n  def turn_towards_workshop(current_state, target_pos):\n    \"\"\"Helper function to determine the direction to face the workshop.\"\"\"\n    current_x, current_y = current_state.pos\n    target_x, target_y = target_pos\n    \n    if target_x < current_x:\n      return 2  # LEFT\n    elif target_x > current_x:\n      return 3  # RIGHT\n    elif target_y < current_y:\n      return 1  # UP\n    else:\n      return 0  # DOWN\n\n  actions = []\n  \n  # Get the index of the desired item to be crafted\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n  \n  if \"_key\" in recipe:\n      workshop_type = recipe[\"_key\"]\n      \n      # Find the index of the corresponding workshop in the world configuration\n      workshop_indices = env.world.workshop_indices\n      \n      selected_workshop_index = None\n      for idx, workshop_name in enumerate(env.world.cookbook.index):\n          if workshop_name.startswith(workshop_type):\n              selected_workshop_index = workshop_indices[idx]\n              break\n      \n      if selected_workshop_index is not None:\n          # Determine the position of the selected workshop from the current state's grid\n          workshop_positions = np.argwhere(env._current_state.grid[:, :, selected_workshop_index] > 0)\n          \n          if len(workshop_positions) > 0:\n              target_pos = tuple(workshop_positions[0])\n              \n              # Move to the target position of the workshop\n              move_to_position(current_state.pos, target_pos)\n              \n              # Turn to face the workshop\n              actions.append(turn_towards_workshop(env._current_state, target_pos))\n              \n              # Perform the USE action to start crafting\n              actions.append(4)  # USE action index\n  \n  return actions", "island_id": 3, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T07:23:26.167454", "function_name": "craft", "function_body": "  def move_to_position(current_pos, target_pos):\n    \"\"\"Helper function to generate movement actions to reach the target position.\"\"\"\n    x_diff = target_pos[0] - current_pos[0]\n    y_diff = target_pos[1] - current_pos[1]\n\n    # Generate LEFT/RIGHT movements\n    if x_diff < 0:\n      return [2] * abs(x_diff)  # LEFT\n    elif x_diff > 0:\n      return [3] * abs(x_diff)  # RIGHT\n\n    # Generate DOWN/UP movements\n    if y_diff < 0:\n      return [1] * abs(y_diff)  # UP\n    elif y_diff > 0:\n      return [0] * abs(y_diff)  # DOWN\n    \n    return []\n\n  def turn_towards_workshop(current_state, target_pos):\n    \"\"\"Helper function to determine the direction to face the workshop.\"\"\"\n    current_x, current_y = current_state.pos\n    target_x, target_y = target_pos\n    \n    if target_x < current_x:\n      return 2  # LEFT\n    elif target_x > current_x:\n      return 3  # RIGHT\n    elif target_y < current_y:\n      return 1  # UP\n    else:\n      return 0  # DOWN\n\n  def find_workshop(workshop_type, workshop_indices):\n    \"\"\"Helper function to find the index of the corresponding workshop.\"\"\"\n    for idx, workshop in enumerate(env.world.cookbook.index):\n        if workshop.startswith(workshop_type):\n            return workshop_indices[idx]\n    return None\n  \n  actions = []\n\n  # Get the index of the desired item to be crafted\n  item_index = env.world.cookbook.index[item]\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n\n  if \"_key\" in recipe:\n      workshop_type = recipe[\"_key\"]\n\n      # Find the index of the corresponding workshop in the world configuration\n      workshop_indices = env.world.workshop_indices\n\n      selected_workshop_index = find_workshop(workshop_type, workshop_indices)\n      \n      if selected_workshop_index is not None:\n          # Determine the position of the selected workshop from the current state's grid\n          workshop_positions = np.argwhere(env._current_state.grid[:, :, selected_workshop_index] > 0)\n\n          if len(workshop_positions) > 0:\n              target_pos = tuple(workshop_positions[0])\n\n              # Move to the target position of the workshop\n              actions.extend(move_to_position(env._current_state.pos, target_pos))\n              \n              # Turn to face the workshop (simple direction check for now)\n              # Assuming agent faces the right direction after moving\n              actions.append(turn_towards_workshop(env._current_state, target_pos))\n              \n              # Perform the USE action to start crafting\n              actions.append(4)  # USE action index\n  \n  return actions", "island_id": 3, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T07:24:53.128258", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Iterate over all positions to find the nearest workshop\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    # Calculate the direction to move\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    # Determine the optimal path using a simple greedy approach\n    while abs(dx) > 0 or abs(dy) > 0:\n        if abs(dx) >= abs(dy):\n            # Move horizontally first\n            if dx > 0:\n                actions.append(3)  # RIGHT\n                dx -= 1\n            elif dx < 0:\n                actions.append(2)  # LEFT\n                dx += 1\n        else:\n            # Move vertically first\n            if dy > 0:\n                actions.append(1)  # UP\n                dy -= 1\n            elif dy < 0:\n                actions.append(0)  # DOWN\n                dy += 1\n    \n    return actions\n\n  def get_workshop_for_item(item_index):\n      \"\"\"Determine which workshop is required for crafting this item.\"\"\"\n      # This function should extract the required workshop from the recipe.\n      # For now, we assume that all recipes require the first workshop.\n      # This is a placeholder and needs to be replaced with actual logic.\n      return env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  workshop_index = get_workshop_for_item(item_index)\n\n  # Find the closest workshop of the required type\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 7, "scores": {"": 4.7}}
{"timestamp": "2025-09-03T07:24:54.256618", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Iterate over all positions to find the nearest workshop\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    # Calculate the direction to move using a simple greedy approach\n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if abs(dx) > abs(dy):\n        # Move horizontally first\n        if dx > 0:\n            actions.append(3)  # RIGHT\n            current_pos = (current_pos[0] + 1, current_pos[1])\n        elif dx < 0:\n            actions.append(2)  # LEFT\n            current_pos = (current_pos[0] - 1, current_pos[1])\n      else:\n        # Move vertically first\n        if dy > 0:\n            actions.append(1)  # UP\n            current_pos = (current_pos[0], current_pos[1] + 1)\n        elif dy < 0:\n            actions.append(0)  # DOWN\n            current_pos = (current_pos[0], current_pos[1] - 1)\n\n    return actions\n\n  def get_workshop_for_item(item_index):\n      \"\"\"Determine which workshop is required for crafting this item.\"\"\"\n      recipe = env.world.cookbook.recipes[item_index]\n      \n      # For simplicity, assume that the workshop index is specified in the recipe\n      # In a real-world scenario, you might need to parse the recipe to determine the correct workshop.\n      return recipe.get('workshop', env.world.workshop_indices[0])  # Use the first workshop as a placeholder\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  workshop_index = get_workshop_for_item(item_index)\n\n  # Find the closest workshop of the required type\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 7, "scores": {"": 4.7}}
{"timestamp": "2025-09-03T07:26:58.946332", "function_name": "craft", "function_body": "  def get_closest_workshop(item_index):\n    \"\"\"Finds the closest workshop that can craft the specified item.\"\"\"\n    # Determine the workshop required based on the recipe key\n    workshop_indices = []\n    for output_idx, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n        workshop_name = ingredients.get(\"_workshop\")\n        if workshop_name:\n          workshop_indices.append(env.world.cookbook.index[workshop_name])\n    \n    # If no specific workshop is needed, use a default one\n    if not workshop_indices:\n      return env.world.workshop_indices[0]  # Default to the first workshop type\n    \n    # Find the closest workshop in the grid\n    agent_pos = np.array(env._current_state.pos)\n    min_distance = float('inf')\n    closest_workshop_index = None\n    for workshop_index in workshop_indices:\n      for y in range(grid_shape[1]):\n        for x in range(grid_shape[0]):\n          if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n            target_pos = np.array((x, y))\n            distance = np.linalg.norm(agent_pos - target_pos)\n            if distance < min_distance:\n              min_distance = distance\n              closest_workshop_index = workshop_index\n    return closest_workshop_index\n\n  def path_to_target(start, target):\n    \"\"\"Computes the path from start position to target position using A* algorithm.\"\"\"\n    actions = []\n    # Define possible movements and their corresponding actions\n    moves = [(1, 0, 3), (-1, 0, 2), (0, 1, 1), (0, -1, 0)]  # RIGHT, LEFT, UP, DOWN\n    open_set = collections.deque([(start[0], start[1], [])])  # Queue for BFS\n    visited = set()\n    \n    while open_set:\n      x, y, path = open_set.popleft()\n      \n      if (x, y) == tuple(target):\n        return path\n      \n      if (x, y) in visited:\n        continue\n      \n      visited.add((x, y))\n      \n      for dx, dy, action in moves:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < grid_shape[0] and 0 <= ny < grid_shape[1]:\n          open_set.append((nx, ny, path + [action]))\n    \n    return actions\n\n  def get_required_primitives(item_index):\n    \"\"\"Retrieves the list of required primitives for crafting an item.\"\"\"\n    for output_idx, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n        return [primitive for primitive in ingredients.keys() if primitive != \"_key\" and primitive != \"_workshop\"]\n    return []\n\n  def ensure_inventory(item_index):\n    \"\"\"Ensures the inventory has all required primitives for crafting.\"\"\"\n    actions = []\n    current_inventory = env._current_state.inventory.copy()\n    \n    # Get the list of required primitives\n    required_primitives = get_required_primitives(item_index)\n    \n    # Collect each missing primitive from the environment\n    for primitive in required_primitives:\n      if primitive not in current_inventory or current_inventory[primitive] == 0:\n        collect_actions = collect(env, primitive)\n        actions.extend(collect_actions)\n        # Update inventory after collecting\n        current_inventory[primitive] += 1\n    \n    return actions\n\n  def update_inventory(item_index):\n    \"\"\"Updates the inventory based on crafted items.\"\"\"\n    env._current_state.inventory[item_index] += 1\n\n  item_index = env.world.cookbook.index[item]\n  grid_shape = env._current_state.grid.shape[:2]\n\n  # Ensure inventory has all required primitives\n  actions_to_collect_primitives = ensure_inventory(item_index)\n\n  # Find the closest workshop for crafting\n  workshop_index = get_closest_workshop(item_index)\n\n  # Find the position of the closest workshop in the grid\n  agent_pos = np.array(env._current_state.pos)\n  workshop_pos = None\n  min_distance = float('inf')\n  for y in range(grid_shape[1]):\n    for x in range(grid_shape[0]):\n      if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n        target_pos = np.array((x, y))\n        distance = np.linalg.norm(agent_pos - target_pos)\n        if distance < min_distance:\n          min_distance = distance\n          workshop_pos = (x, y)\n\n  # If no workshop position is found, return an empty list of actions\n  if workshop_pos is None:\n    return []\n\n  # Calculate the path to the closest workshop and perform the USE action\n  target_pos = np.array(workshop_pos)\n  actions_to_workshop = path_to_target(agent_pos[:2], target_pos)\n  actions_to_workshop.append(4)  # USE to craft the item\n\n  # Update inventory after crafting\n  update_inventory(item_index)\n\n  return actions_to_collect_primitives + actions_to_workshop", "island_id": 2, "scores": {"": 2.7}}
{"timestamp": "2025-09-03T07:26:59.922846", "function_name": "craft", "function_body": "  def get_closest_workshop(item_index):\n    \"\"\"Finds the closest workshop that can craft the specified item.\"\"\"\n    # Determine the workshop required based on the recipe key\n    workshop_indices = []\n    for output_idx, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n        workshop_name = ingredients.get(\"_workshop\")\n        if workshop_name:\n          workshop_indices.append(env.world.cookbook.index[workshop_name])\n    \n    # If no specific workshop is needed, use a default one\n    if not workshop_indices:\n      return env.world.workshop_indices[0]  # Default to the first workshop type\n    \n    # Find the closest workshop in the grid\n    agent_pos = np.array(env._current_state.pos)\n    min_distance = float('inf')\n    closest_workshop_index = None\n    for workshop_index in workshop_indices:\n      for y in range(grid_shape[1]):\n        for x in range(grid_shape[0]):\n          if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n            target_pos = np.array((x, y))\n            distance = np.linalg.norm(agent_pos - target_pos)\n            if distance < min_distance:\n              min_distance = distance\n              closest_workshop_index = (x, y)  # Store the position directly\n    return closest_workshop_index\n\n  def path_to_target(start, target):\n    \"\"\"Computes the path from start position to target position using A* algorithm.\"\"\"\n    actions = []\n    # Define possible movements and their corresponding actions\n    moves = [(1, 0, 3), (-1, 0, 2), (0, 1, 1), (0, -1, 0)]  # RIGHT, LEFT, UP, DOWN\n    open_set = collections.deque([(start[0], start[1], [])])  # Queue for BFS\n    visited = set()\n    \n    while open_set:\n      x, y, path = open_set.popleft()\n      \n      if (x, y) == tuple(target):\n        return path\n      \n      if (x, y) in visited:\n        continue\n      \n      visited.add((x, y))\n      \n      for dx, dy, action in moves:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < grid_shape[0] and 0 <= ny < grid_shape[1]:\n          open_set.append((nx, ny, path + [action]))\n    \n    return actions\n\n  def get_required_primitives(item_index):\n    \"\"\"Retrieves the list of required primitives for crafting an item.\"\"\"\n    for output_idx, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n        return [primitive for primitive in ingredients.keys() if primitive != \"_key\" and primitive != \"_workshop\"]\n    return []\n\n  def ensure_inventory(item_index):\n    \"\"\"Ensures the inventory has all required primitives for crafting.\"\"\"\n    actions = []\n    current_inventory = env._current_state.inventory.copy()\n    \n    # Get the list of required primitives\n    required_primitives = get_required_primitives(item_index)\n    \n    # Collect each missing primitive from the environment\n    for primitive in required_primitives:\n      if primitive not in current_inventory or current_inventory[primitive] == 0:\n        collect_actions = collect(env, primitive)\n        actions.extend(collect_actions)\n        # Update inventory after collecting\n        current_inventory[primitive] += 1\n    \n    return actions\n\n  def update_inventory(item_index):\n    \"\"\"Updates the inventory based on crafted items.\"\"\"\n    env._current_state.inventory[item_index] += 1\n\n  item_index = env.world.cookbook.index[item]\n  grid_shape = env._current_state.grid.shape[:2]\n\n  # Ensure inventory has all required primitives\n  actions_to_collect_primitives = ensure_inventory(item_index)\n\n  # Find the closest workshop for crafting and its position directly\n  workshop_pos = get_closest_workshop(item_index)\n\n  # If no workshop position is found, return an empty list of actions\n  if workshop_pos is None:\n    return []\n\n  # Calculate the path to the closest workshop and perform the USE action\n  target_pos = np.array(workshop_pos)\n  agent_pos = np.array(env._current_state.pos)\n  actions_to_workshop = path_to_target(agent_pos[:2], target_pos)\n  actions_to_workshop.append(4)  # USE to craft the item\n\n  # Update inventory after crafting\n  update_inventory(item_index)\n\n  return actions_to_collect_primitives + actions_to_workshop", "island_id": 2, "scores": {"": -1}}
{"timestamp": "2025-09-03T07:28:22.826398", "function_name": "craft", "function_body": "  def get_nearest_workshop_pos(workshop_index):\n    agent_pos = np.array(env._current_state.pos)\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n    distances = np.linalg.norm(workshop_positions - agent_pos, axis=1)\n    nearest_workshop_idx = np.argmin(distances)\n    return workshop_positions[nearest_workshop_idx]\n\n  def generate_move_actions(source_pos, target_pos):\n    actions = []\n    relative_pos = target_pos - source_pos\n\n    # Determine the direction to move\n    if relative_pos[0] < 0:  # Move down\n        while env._current_state.pos[0] > target_pos[0]:\n            actions.append(craft.DOWN)\n            _, done, _ = env.step(craft.DOWN)\n            if done:\n                break\n    elif relative_pos[0] > 0:  # Move up\n        while env._current_state.pos[0] < target_pos[0]:\n            actions.append(craft.UP)\n            _, done, _ = env.step(craft.UP)\n            if done:\n                break\n\n    if relative_pos[1] < 0:  # Move left\n        while env._current_state.pos[1] > target_pos[1]:\n            actions.append(craft.LEFT)\n            _, done, _ = env.step(craft.LEFT)\n            if done:\n                break\n    elif relative_pos[1] > 0:  # Move right\n        while env._current_state.pos[1] < target_pos[1]:\n            actions.append(craft.RIGHT)\n            _, done, _ = env.step(craft.RIGHT)\n            if done:\n                break\n\n    return actions\n\n  actions = []\n\n  # Get the index for the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item is a primitive or requires crafting\n  if item_index in env.world.grabbable_indices:\n      return []  # No need to craft primitives\n  \n  # Find the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index, None)\n  \n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  # Check if we have all ingredients in the inventory\n  required_ingredients = {\n      ingredient: count for ingredient, count in recipe.items() if ingredient != \"_key\"\n  }\n  \n  if not all(env._current_state.inventory[ingredient] >= count for ingredient, count in required_ingredients.items()):\n    raise ValueError(f\"Missing required ingredients to craft {item}\")\n\n  # Find the workshop index from the \"_key\" field in the recipe\n  workshop_index = env.world.cookbook.index[recipe[\"_key\"]]\n\n  # Get the nearest workshop position\n  nearest_workshop_pos = get_nearest_workshop_pos(workshop_index)\n\n  # Generate actions to move towards the nearest workshop\n  source_pos = np.array(env._current_state.pos)\n  move_actions = generate_move_actions(source_pos, nearest_workshop_pos)\n\n  actions.extend(move_actions)\n\n  # Add the USE action to craft the item at the workshop\n  actions.append(craft.USE)\n\n  return actions", "island_id": 8, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T07:28:23.885639", "function_name": "craft", "function_body": "  def get_nearest_workshop_pos(workshop_index):\n    agent_pos = np.array(env._current_state.pos)\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n    distances = np.linalg.norm(workshop_positions - agent_pos, axis=1)\n    nearest_workshop_idx = np.argmin(distances)\n    return workshop_positions[nearest_workshop_idx]\n\n  def generate_move_actions(source_pos, target_pos):\n    actions = []\n    relative_pos = target_pos - source_pos\n\n    # Determine the direction to move\n    if relative_pos[0] < 0:  # Move down\n        while source_pos[0] > nearest_workshop_pos[0]:\n            actions.append(craft.DOWN)\n            source_pos[0] -= 1\n    elif relative_pos[0] > 0:  # Move up\n        while source_pos[0] < nearest_workshop_pos[0]:\n            actions.append(craft.UP)\n            source_pos[0] += 1\n    \n    if relative_pos[1] < 0:  # Move left\n        while source_pos[1] > nearest_workshop_pos[1]:\n            actions.append(craft.LEFT)\n            source_pos[1] -= 1\n    elif relative_pos[1] > 0:  # Move right\n        while source_pos[1] < nearest_workshop_pos[1]:\n            actions.append(craft.RIGHT)\n            source_pos[1] += 1\n\n    return actions\n\n  actions = []\n\n  # Get the index for the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item is a primitive or requires crafting\n  if item_index in env.world.grabbable_indices:\n      return []  # No need to craft primitives\n  \n  # Find the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index, None)\n  \n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  # Check if we have all ingredients in the inventory\n  required_ingredients = {\n      ingredient: count for ingredient, count in recipe.items() if ingredient != \"_key\"\n  }\n  \n  if not all(env._current_state.inventory[ingredient] >= count for ingredient, count in required_ingredients.items()):\n    raise ValueError(f\"Missing required ingredients to craft {item}\")\n\n  # Find the workshop index from the \"_key\" field in the recipe\n  workshop_index = env.world.cookbook.index[recipe[\"_key\"]]\n\n  # Get the nearest workshop position\n  nearest_workshop_pos = get_nearest_workshop_pos(workshop_index)\n\n  # Generate actions to move towards the nearest workshop\n  source_pos = np.array(env._current_state.pos)\n  move_actions = generate_move_actions(source_pos, nearest_workshop_pos)\n\n  actions.extend(move_actions)\n\n  # Add the USE action to craft the item at the workshop\n  actions.append(craft.USE)\n\n  return actions", "island_id": 8, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T07:30:46.066143", "function_name": "craft", "function_body": "  def get_closest_workshop(item_index):\n    workshop_indices = []\n    for output_idx, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n        workshop_name = ingredients.get(\"_workshop\")\n        if workshop_name:\n          workshop_indices.append(env.world.cookbook.index[workshop_name])\n    \n    # If no specific workshop is needed, use a default one\n    if not workshop_indices:\n      return env.world.workshop_indices[0]  # Default to the first workshop type\n    \n    # Find the closest workshop in the grid\n    agent_pos = np.array(env._current_state.pos)\n    min_distance = float('inf')\n    closest_workshop_index = None\n    for workshop_index in workshop_indices:\n      for y in range(grid_shape[1]):\n        for x in range(grid_shape[0]):\n          if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n            target_pos = np.array((x, y))\n            distance = np.linalg.norm(agent_pos - target_pos)\n            if distance < min_distance:\n              min_distance = distance\n              closest_workshop_index = workshop_index\n    return closest_workshop_index\n\n  def navigate_to_position(target_pos):\n      actions = []\n      agent_pos = np.array(env._current_state.pos)\n      while not np.all(agent_pos == target_pos):\n          direction = target_pos - agent_pos\n          if abs(direction[0]) > abs(direction[1]):\n              # Move horizontally\n              if direction[0] > 0:\n                  actions.append(3)  # RIGHT\n                  agent_pos[0] += 1\n              else:\n                  actions.append(2)  # LEFT\n                  agent_pos[0] -= 1\n          else:\n              # Move vertically\n              if direction[1] > 0:\n                  actions.append(1)  # UP\n                  agent_pos[1] += 1\n              else:\n                  actions.append(0)  # DOWN\n                  agent_pos[1] -= 1\n      return actions\n\n  def check_and_collect_primitives(primitive_indices):\n      actions = []\n      for primitive_index in primitive_indices:\n          if env._current_state.inventory[primitive_index] == 0:\n              # Find the position of the primitive\n              target_pos = None\n              min_distance = float('inf')\n              for y in range(grid_shape[1]):\n                  for x in range(grid_shape[0]):\n                      if env._current_state.grid[x, y, primitive_index] > 0:\n                          pos = np.array((x, y))\n                          distance = np.linalg.norm(pos - np.array(env._current_state.pos))\n                          if distance < min_distance:\n                              min_distance = distance\n                              target_pos = (x, y)\n              \n              # Navigate to the primitive and collect it\n              actions.extend(navigate_to_position(target_pos))\n              actions.append(4)  # USE to collect the item\n      return actions\n\n  def get_required_primitives(item_index):\n      required_primitives = []\n      for output_idx, ingredients in env.world.cookbook.recipes.items():\n          if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n              required_primitives.extend([env.world.cookbook.index[prim] for prim in ingredients.keys() if prim != \"_workshop\" and prim != \"_key\"])\n      return required_primitives\n\n  def get_required_primitives_with_count(item_index):\n      required_primitives = collections.defaultdict(int)\n      for output_idx, ingredients in env.world.cookbook.recipes.items():\n          if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n              for prim, count in ingredients.items():\n                  if prim != \"_workshop\" and prim != \"_key\":\n                      required_primitives[env.world.cookbook.index[prim]] = count\n      return required_primitives\n\n  def check_and_collect_primitives_with_count(primitive_counts):\n      actions = []\n      for primitive_index, count_required in primitive_counts.items():\n          if env._current_state.inventory[primitive_index] < count_required:\n              # Find the position of the primitive\n              target_pos = None\n              min_distance = float('inf')\n              for y in range(grid_shape[1]):\n                  for x in range(grid_shape[0]):\n                      if env._current_state.grid[x, y, primitive_index] > 0:\n                          pos = np.array((x, y))\n                          distance = np.linalg.norm(pos - np.array(env._current_state.pos))\n                          if distance < min_distance:\n                              min_distance = distance\n                              target_pos = (x, y)\n              \n              # Navigate to the primitive and collect it until we have enough\n              while env._current_state.inventory[primitive_index] < count_required:\n                  actions.extend(navigate_to_position(target_pos))\n                  actions.append(4)  # USE to collect the item\n      return actions\n\n  def navigate_and_collect_primitives(primitive_counts):\n      actions = []\n      for primitive_index, count_required in primitive_counts.items():\n          if env._current_state.inventory[primitive_index] < count_required:\n              # Find the position of the primitive\n              target_pos = None\n              min_distance = float('inf')\n              for y in range(grid_shape[1]):\n                  for x in range(grid_shape[0]):\n                      if env._current_state.grid[x, y, primitive_index] > 0:\n                          pos = np.array((x, y))\n                          distance = np.linalg.norm(pos - np.array(env._current_state.pos))\n                          if distance < min_distance:\n                              min_distance = distance\n                              target_pos = (x, y)\n              \n              # Navigate to the primitive and collect it until we have enough\n              while env._current_state.inventory[primitive_index] < count_required:\n                  actions.extend(navigate_to_position(target_pos))\n                  actions.append(4)  # USE to collect the item\n      return actions\n\n  item_index = env.world.cookbook.index[item]\n  grid_shape = env._current_state.grid.shape[:2]\n\n  workshop_index = get_closest_workshop(item_index)\n\n  if workshop_index is None:\n      return []\n\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  if not workshop_positions.size:\n      return []\n\n  closest_workshop = min(workshop_positions, key=lambda pos: np.linalg.norm(np.array(pos) - np.array(env._current_state.pos)))\n\n  required_primitives_counts = get_required_primitives_with_count(item_index)\n  \n  actions_to_collect_primitives = check_and_collect_primitives_with_count(required_primitives_counts)\n\n  actions_to_closest_workshop = navigate_to_position(closest_workshop)\n  actions_to_closest_workshop.append(4)  # USE to craft the item\n\n  return actions_to_collect_primitives + actions_to_closest_workshop", "island_id": 1, "scores": {"": 2.0}}
{"timestamp": "2025-09-03T07:30:47.125823", "function_name": "craft", "function_body": "  def get_closest_workshop(item_index):\n    workshop_indices = []\n    for output_idx, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n        workshop_name = ingredients.get(\"_workshop\")\n        if workshop_name:\n          workshop_indices.append(env.world.cookbook.index[workshop_name])\n    \n    # If no specific workshop is needed, use a default one\n    if not workshop_indices:\n      return env.world.workshop_indices[0]  # Default to the first workshop type\n    \n    # Find the closest workshop in the grid\n    agent_pos = np.array(env._current_state.pos)\n    min_distance = float('inf')\n    closest_workshop_index = None\n    for workshop_index in workshop_indices:\n      for y in range(grid_shape[1]):\n        for x in range(grid_shape[0]):\n          if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n            target_pos = np.array((x, y))\n            distance = np.linalg.norm(agent_pos - target_pos)\n            if distance < min_distance:\n              min_distance = distance\n              closest_workshop_index = workshop_index\n    return closest_workshop_index\n\n  def navigate_to_position(target_pos):\n    actions = []\n    agent_pos = np.array(env._current_state.pos)\n    while not np.all(agent_pos == target_pos):\n      direction = target_pos - agent_pos\n      if abs(direction[0]) > abs(direction[1]):\n        # Move horizontally\n        if direction[0] > 0:\n          actions.append(3)  # RIGHT\n          agent_pos[0] += 1\n        else:\n          actions.append(2)  # LEFT\n          agent_pos[0] -= 1\n      else:\n        # Move vertically\n        if direction[1] > 0:\n          actions.append(1)  # UP\n          agent_pos[1] += 1\n        else:\n          actions.append(0)  # DOWN\n          agent_pos[1] -= 1\n    return actions\n\n  def check_and_collect_primitives(primitive_indices):\n    actions = []\n    for primitive_index in primitive_indices:\n      if env._current_state.inventory[primitive_index] == 0:\n        # Find the position of the primitive\n        target_pos = None\n        min_distance = float('inf')\n        for y in range(grid_shape[1]):\n          for x in range(grid_shape[0]):\n            if env._current_state.grid[x, y, primitive_index] > 0:\n              pos = np.array((x, y))\n              distance = np.linalg.norm(pos - np.array(env._current_state.pos))\n              if distance < min_distance:\n                min_distance = distance\n                target_pos = (x, y)\n        \n        # Navigate to the primitive and collect it\n        actions.extend(navigate_to_position(target_pos))\n        actions.append(4)  # USE to collect the item\n    return actions\n\n  def get_required_primitives(item_index):\n    required_primitives = []\n    for output_idx, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n        required_primitives.extend([env.world.cookbook.index[prim] for prim in ingredients.keys() if prim != \"_workshop\" and prim != \"_key\"])\n    return required_primitives\n\n  def get_workshop_position(workshop_index):\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n    if not workshop_positions.size:\n      return None\n    closest_workshop = min(workshop_positions, key=lambda pos: np.linalg.norm(np.array(pos) - np.array(env._current_state.pos)))\n    return closest_workshop\n\n  item_index = env.world.cookbook.index[item]\n  grid_shape = env._current_state.grid.shape[:2]\n\n  workshop_index = get_closest_workshop(item_index)\n\n  if workshop_index is None:\n    return []\n\n  required_primitives_indices = get_required_primitives(item_index)\n  \n  actions_to_collect_primitives = check_and_collect_primitives(required_primitives_indices)\n\n  closest_workshop_position = get_workshop_position(workshop_index)\n  if closest_workshop_position is None:\n    return []\n  \n  actions_to_closest_workshop = navigate_to_position(closest_workshop_position)\n  actions_to_closest_workshop.append(4)  # USE to craft the item\n\n  return actions_to_collect_primitives + actions_to_closest_workshop", "island_id": 1, "scores": {"": 2.0}}
{"timestamp": "2025-09-03T07:32:25.036627", "function_name": "craft", "function_body": "  def move_to_workshop(state, workshop_index):\n    actions = []\n    grid = state.grid\n    pos = state.pos\n    dir = state.dir\n    n_kinds = state.world.cookbook.n_kinds\n    \n    # Find the nearest workshop cell index in the grid\n    workshop_cells = np.argwhere(grid[:, :, workshop_index] > 0)\n    \n    if len(workshop_cells) == 0:\n      raise ValueError(\"No workshops found for this item.\")\n    \n    closest_workshop = min(workshop_cells, key=lambda x: (x[0]-pos[0])**2 + (x[1]-pos[1])**2)\n    \n    # Calculate the path to the nearest workshop\n    path = astar(grid, pos, closest_workshop, n_kinds)\n    \n    for step in path:\n      if step == pos:\n        continue\n      \n      dx, dy = step[0] - pos[0], step[1] - pos[1]\n      \n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      elif dy > 0:\n          actions.append(0)  # DOWN\n      elif dy < 0:\n          actions.append(1)  # UP\n      \n      pos = step\n    \n    return actions\n\n  def astar(grid, start, goal, n_kinds):\n    open_set = collections.PriorityQueue()\n    open_set.put((0, start))\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, goal)}\n    \n    while not open_set.empty():\n        _, current = open_set.get()\n\n        if current == goal:\n            return reconstruct_path(came_from, current)\n        \n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            neighbor = (current[0] + dx, current[1] + dy)\n            \n            if not (0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]):\n                continue\n            \n            tentative_g_score = g_score[current] + 1\n            if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                came_from[neighbor] = current\n                g_score[neighbor] = tentative_g_score\n                f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                open_set.put((f_score[neighbor], neighbor))\n    \n    return []\n\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def reconstruct_path(came_from, current):\n      total_path = [current]\n      while current in came_from:\n          current = came_from[current]\n          total_path.append(current)\n      return list(reversed(total_path))\n  \n  actions = []\n  \n  # Get index for desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Assuming we have all ingredients in the inventory\n\n  # Identify required workshop based on recipe (if any)\n  recipe = env.world.cookbook.recipes.get(item_index)\n  if recipe:\n    _key = recipe.get(\"_key\")\n    if _key is not None:\n      workshop_name = f\"WORKSHOP{_key}\"\n      workshop_index = env.world.cookbook.index[workshop_name]\n      # Move to the workshop\n      actions.extend(move_to_workshop(env._current_state, workshop_index))\n  \n  # Craft the item by using USE action\n  actions.append(4)  # Use action\n  \n  return actions", "island_id": 0, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T07:32:26.072860", "function_name": "craft", "function_body": "  def move_to_workshop(state, workshop_index):\n    actions = []\n    grid = state.grid\n    pos = state.pos\n    dir = state.dir\n    n_kinds = state.world.cookbook.n_kinds\n    \n    # Find the nearest workshop cell index in the grid\n    workshop_cells = np.argwhere(grid[:, :, workshop_index] > 0)\n    \n    if len(workshop_cells) == 0:\n      raise ValueError(\"No workshops found for this item.\")\n    \n    closest_workshop = min(workshop_cells, key=lambda x: (x[0]-pos[0])**2 + (x[1]-pos[1])**2)\n    \n    # Calculate the path to the nearest workshop\n    path = astar(grid, pos, closest_workshop, n_kinds)\n    \n    for step in path:\n      if step == pos:\n        continue\n      \n      dx, dy = step[0] - pos[0], step[1] - pos[1]\n      \n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      elif dy > 0:\n          actions.append(0)  # DOWN\n      elif dy < 0:\n          actions.append(1)  # UP\n      \n      pos = step\n    \n    return actions\n\n  def astar(grid, start, goal, n_kinds):\n    open_set = collections.PriorityQueue()\n    open_set.put((0, start))\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, goal)}\n    \n    while not open_set.empty():\n        _, current = open_set.get()\n\n        if current == goal:\n            return reconstruct_path(came_from, current)\n        \n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            neighbor = (current[0] + dx, current[1] + dy)\n            \n            if not (0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]):\n                continue\n            \n            # Ensure the agent can move to this cell\n            if np.sum(grid[neighbor[0], neighbor[1]]) == n_kinds:\n              continue\n            \n            tentative_g_score = g_score[current] + 1\n            if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                came_from[neighbor] = current\n                g_score[neighbor] = tentative_g_score\n                f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                open_set.put((f_score[neighbor], neighbor))\n    \n    return []\n\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def reconstruct_path(came_from, current):\n      total_path = [current]\n      while current in came_from:\n          current = came_from[current]\n          total_path.append(current)\n      return list(reversed(total_path))\n\n  actions = []\n  \n  # Get index for desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Assuming we have all ingredients in the inventory\n\n  # Identify required workshop based on recipe (if any)\n  recipe = env.world.cookbook.recipes.get(item_index)\n  if recipe:\n    _key = recipe.get(\"_key\")\n    if _key is not None:\n      workshop_name = f\"WORKSHOP{_key}\"\n      workshop_index = env.world.cookbook.index[workshop_name]\n      # Move to the workshop\n      actions.extend(move_to_workshop(env._current_state, workshop_index))\n  \n  # Craft the item by using USE action\n  actions.append(4)  # Use action\n  \n  return actions", "island_id": 0, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T07:34:36.935050", "function_name": "craft", "function_body": "  def get_closest_workshop(item_index):\n    workshop_indices = []\n    for output_idx, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n        workshop_name = ingredients.get(\"_workshop\")\n        if workshop_name:\n          workshop_indices.append(env.world.cookbook.index[workshop_name])\n    \n    # If no specific workshop is needed, use a default one\n    if not workshop_indices:\n      return env.world.workshop_indices[0]  # Default to the first workshop type\n    \n    # Find the closest workshop in the grid\n    agent_pos = np.array(env._current_state.pos)\n    min_distance = float('inf')\n    closest_workshop_index = None\n    for workshop_index in workshop_indices:\n      for y in range(grid_shape[1]):\n        for x in range(grid_shape[0]):\n          if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n            target_pos = np.array((x, y))\n            distance = np.linalg.norm(agent_pos - target_pos)\n            if distance < min_distance:\n              min_distance = distance\n              closest_workshop_index = workshop_index\n    return closest_workshop_index\n\n  def navigate_to_position(target_pos):\n    actions = []\n    agent_pos = np.array(env._current_state.pos)\n    while not np.all(agent_pos == target_pos):\n      direction = target_pos - agent_pos\n      if abs(direction[0]) > abs(direction[1]):\n        # Move horizontally\n        if direction[0] > 0:\n          actions.append(3)  # RIGHT\n          agent_pos[0] += 1\n        else:\n          actions.append(2)  # LEFT\n          agent_pos[0] -= 1\n      else:\n        # Move vertically\n        if direction[1] > 0:\n          actions.append(1)  # UP\n          agent_pos[1] += 1\n        else:\n          actions.append(0)  # DOWN\n          agent_pos[1] -= 1\n    return actions\n\n  def get_required_primitives(item_index):\n    required_primitives = []\n    for ingredients in env.world.cookbook.recipes.values():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n        required_primitives.extend([ingredient for ingredient, count in ingredients.items() if isinstance(ingredient, int)])\n        break\n    return required_primitives\n\n  def collect_primitive(primitive_index):\n    actions = []\n    agent_pos = np.array(env._current_state.pos)\n    grid_shape = env._current_state.grid.shape[:2]\n    \n    # Find the closest source of the primitive in the grid\n    min_distance = float('inf')\n    closest_source_pos = None\n    for y in range(grid_shape[1]):\n      for x in range(grid_shape[0]):\n        if env._current_state.grid[x, y, primitive_index] > 0:\n          target_pos = np.array((x, y))\n          distance = np.linalg.norm(agent_pos - target_pos)\n          if distance < min_distance:\n            min_distance = distance\n            closest_source_pos = (x, y)\n\n    if closest_source_pos is None:\n      return actions\n\n    # Navigate to the closest source of the primitive and collect it\n    actions.extend(navigate_to_position(closest_source_pos))\n    actions.append(4)  # USE to collect the primitive\n\n    return actions\n\n  def craft_item_at_workshop():\n    actions = []\n    workshop_index = get_closest_workshop(item_index)\n    \n    # Find all workshops in the grid\n    workshop_positions = []\n    for y in range(grid_shape[1]):\n      for x in range(grid_shape[0]):\n        if env._current_state.grid[x, y, workshop_index] > 0:\n          workshop_positions.append((x, y))\n\n    # If no workshops are found, return an empty list of actions\n    if not workshop_positions:\n      return []\n\n    closest_workshop = min(workshop_positions, key=lambda pos: np.linalg.norm(np.array(pos) - np.array(env._current_state.pos)))\n    actions.extend(navigate_to_position(closest_workshop))\n    actions.append(4)  # USE to craft the item\n\n    return actions\n\n  def check_inventory_for_primitives(required_primitives):\n    missing_primitives = [primitive for primitive in required_primitives if env._current_state.inventory[primitive] == 0]\n    return missing_primitives\n\n  item_index = env.world.cookbook.index[item]\n  grid_shape = env._current_state.grid.shape[:2]\n\n  required_primitives = get_required_primitives(item_index)\n  missing_primitives = check_inventory_for_primitives(required_primitives)\n\n  actions = []\n  for primitive_index in missing_primitives:\n    actions.extend(collect_primitive(primitive_index))\n\n  actions.extend(craft_item_at_workshop())\n\n  return actions", "island_id": 1, "scores": {"": 2.0}}
