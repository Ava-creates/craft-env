hops[np.argmin(distances)])\n\n  path_to_workshop = move_to(env, nearest_workshop)\n  actions_to_workshop = [env.world.cookbook.index[direction] for direction in path_to_workshop]\n\n  use_action_index = env.world.cookbook.index[\"USE\"]\n\n  return actions_to_collect + actions_to_workshop + [use_action_index]", "island_id": 4, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T23:17:24.730616", "function_name": "craft", "function_body": "  def find_nearest_workshop(state, workshop_indices):\n      min_distance = float('inf')\n      nearest_workshop_pos = None\n      \n      for workshop_idx in workshop_indices:\n          target_pos = find_position_of_kind(env, workshop_idx)\n          distance = np.linalg.norm(np.array(target_pos) - np.array(state.pos))\n          \n          if distance < min_distance:\n              min_distance = distance\n              nearest_workshop_pos = target_pos\n      \n      return nearest_workshop_pos\n\n  actions = []\n  current_state = env._current_state\n\n  # Get the index of the desired item from the cookbook index\n  item_index = env.world.cookbook.index[item]\n\n  # Find the workshop index for crafting the item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n  if \"_key\" in recipe:\n      key_workshop = recipe[\"_key\"]\n      workshop_index = env.world.workshop_indices[key_workshop]\n      \n      # Move to the nearest workshop of the required kind if not already next to one\n      if not current_state.next_to(workshop_index):\n          target_pos = find_nearest_workshop(current_state, [workshop_index])\n          actions.extend(move_to_position(current_state.pos, target_pos))\n          \n      # Perform the USE action to craft the item\n      actions.append(craft.USE)\n\n  return actions", "island_id": 8, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T23:17:25.789058", "function_name": "craft", "function_body": "  def find_nearest_workshop(state, workshop_indices):\n      min_distance = float('inf')\n      nearest_workshop_pos = None\n      \n      for workshop_idx in workshop_indices:\n          target_pos = find_position_of_kind(env, workshop_idx)\n          distance = np.linalg.norm(np.array(target_pos) - np.array(state.pos))\n          \n          if distance < min_distance:\n              min_distance = distance\n              nearest_workshop_pos = target_pos\n      \n      return nearest_workshop_pos\n\n  actions = []\n  current_state = env._current_state\n\n  # Get the index of the desired item from the cookbook index\n  item_index = env.world.cookbook.index[item]\n\n  # Find the workshop index for crafting the item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n  if \"_key\" in recipe:\n      key_workshop = recipe[\"_key\"]\n      workshop_indices = [env.world.workshop_indices[key_workshop]]\n  \n      # Check if we are already next to a workshop of the required kind\n      if not current_state.next_to(workshop_indices[0]):\n          target_pos = find_nearest_workshop(current_state, workshop_indices)\n          actions.extend(move_to_position(current_state.pos, target_pos))\n          \n      # Perform the USE action to craft the item\n      actions.append(craft.USE)\n\n  return actions", "island_id": 8, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T23:18:00.760538", "function_name": "craft", "function_body": "  def get_workshop_for_item(item_index):\n    for workshop, recipes in env.world.cookbook.recipes.items():\n        if '_key' in recipes and item_index == recipes['_key']:\n            return workshop\n    return None\n\n  def find_nearest_workshop(env, workshop_type_index):\n      # Retrieve the list of all workshops of this type from the world configuration\n      workshop_locations = env.world.workshop_indices\n      \n      current_pos = env._current_state.pos\n      \n      # Filter workshops based on workshop_type_index\n      filtered_workshops = [loc for idx, loc in enumerate(workshop_locations) if idx == workshop_type_index]\n      \n      # Find the nearest workshop location to the agent's current position\n      nearest_workshop_location = min(filtered_workshops, key=lambda loc: np.linalg.norm(np.array(loc) - np.array(current_pos)))\n      \n      return nearest_workshop_location\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Find the workshop that allows crafting this item (if any)\n  workshop_type_index = get_workshop_for_item(item_index)\n\n  actions = []\n\n  if workshop_type_index is not None:\n      # Get the location of the nearest workshop of the required type\n      nearest_workshop_location = find_nearest_workshop(env, workshop_type_index)\n      \n      # Navigate to the workshop location\n      actions.extend(navigate_to(env, nearest_workshop_location))\n      \n      # Use the workshop to craft the item\n      actions.append(env.action_specs()['USE'])\n  \n  return actions", "island_id": 9, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T23:18:01.866683", "function_name": "craft", "function_body": "  def get_workshop_for_item(item_index):\n    for workshop, recipes in env.world.cookbook.recipes.items():\n        if '_key' in recipes and item_index == recipes['_key']:\n            return workshop\n    return None\n\n  def find_nearest_workshop(env, workshop_type_index):\n      # Retrieve the list of all workshops of this type from the world configuration\n      workshop_locations = env.world.workshop_indices[workshop_type_index]\n      \n      current_pos = env._current_state.pos\n      \n      # Find the nearest workshop location to the agent's current position using Manhattan distance\n      nearest_workshop_location = min(workshop_locations, key=lambda loc: abs(loc[0] - current_pos[0]) + abs(loc[1] - current_pos[1]))\n      \n      return nearest_workshop_location\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Find the workshop that allows crafting this item (if any)\n  workshop_type_index = get_workshop_for_item(item_index)\n\n  actions = []\n\n  if workshop_type_index is not None:\n      # Get the location of the nearest workshop of the required type\n      nearest_workshop_location = find_nearest_workshop(env, workshop_type_index)\n      \n      # Navigate to the workshop location\n      actions.extend(navigate_to(env, nearest_workshop_location))\n      \n      # Use the workshop to craft the item\n      actions.append(env.action_specs()['USE'])\n  \n  return actions", "island_id": 9, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T23:19:34.853875", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    # Simple pathfinding logic: moves towards the target position using A* or similar\n    current_pos = env._current_state.pos\n    actions = []\n    \n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if abs(dx) > abs(dy):\n        if dx > 0:\n          actions.append(3)  # RIGHT\n        else:\n          actions.append(2)  # LEFT\n      else:\n        if dy > 0:\n          actions.append(1)  # UP\n        else:\n          actions.append(0)  # DOWN\n\n      current_pos = (current_pos[0] + (dx // abs(dx)) if dx != 0 else current_pos[0],\n                     current_pos[1] + (dy // abs(dy)) if dy != 0 else current_pos[1])\n      \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  # This step assumes that the recipe specifies the workshop type needed.\n  # Since the problem does not specify how to determine the workshop,\n  # we will assume that all workshops can craft any items for simplicity.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  use_action_index = env.world.n_actions - 1  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 7, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T23:19:35.834850", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n      # Simple pathfinding logic: moves towards the target position using A* or similar\n      current_pos = env._current_state.pos\n      actions = []\n      \n      # Define a simple heuristic for A*\n      def heuristic(a, b):\n          return abs(b[0] - a[0]) + abs(b[1] - a[1])\n      \n      # Priority queue to explore the shortest path\n      open_set = collections.PriorityQueue()\n      open_set.put((0, current_pos))\n      came_from = {}\n      g_score = {current_pos: 0}\n      \n      while not open_set.empty():\n          _, current = open_set.get()\n          \n          if current == target_pos:\n              break\n          \n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              \n              # Ensure the neighbor is within grid bounds and traversable\n              if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n                  tentative_g_score = g_score[current] + 1\n                  \n                  if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                      came_from[neighbor] = current\n                      g_score[neighbor] = tentative_g_score\n                      f_score = tentative_g_score + heuristic(neighbor, target_pos)\n                      open_set.put((f_score, neighbor))\n      \n      # Reconstruct the path from start to target\n      while current in came_from:\n          if came_from[current][0] < current[0]:\n              actions.append(2)  # LEFT\n          elif came_from[current][0] > current[0]:\n              actions.append(3)  # RIGHT\n          elif came_from[current][1] < current[1]:\n              actions.append(0)  # UP\n          elif came_from[current][1] > current[1]:\n              actions.append(1)  # DOWN\n          \n          current = came_from[current]\n      \n      return actions[::-1]\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  # This step assumes that the recipe specifies the workshop type needed.\n  # Since the problem does not specify how to determine the workshop,\n  # we will assume that all workshops can craft any items for simplicity.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 7, "scores": {"": -1}}
{"timestamp": "2025-09-02T23:20:40.466814", "function_name": "craft", "function_body": "  def navigate_to(pos):\n    current_pos = env._current_state.pos\n    dir_diff = (pos[0] - current_pos[0], pos[1] - current_pos[1])\n    \n    actions = []\n    if dir_diff[0] > 0:\n        actions.extend([craft.DOWN] * abs(dir_diff[0]))\n    elif dir_diff[0] < 0:\n        actions.extend([craft.UP] * abs(dir_diff[0]))\n\n    if dir_diff[1] > 0:\n        actions.extend([craft.RIGHT] * abs(dir_diff[1]))\n    elif dir_diff[1] < 0:\n        actions.extend([craft.LEFT] * abs(dir_diff[1]))\n    \n    return actions\n\n  def navigate_and_craft(workshop_index):\n    grid = env._current_state.grid\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n    if len(positions) == 0:\n        raise ValueError(f\"No available workshop with index {workshop_index}.\")\n    \n    # Choose the closest workshop\n    pos = env._current_state.pos\n    distances = np.sum(np.abs(positions - pos), axis=1)\n    closest_workshop_pos = positions[np.argmin(distances)]\n    \n    # Move to the closest workshop\n    actions.extend(navigate_to(tuple(closest_workshop_pos)))\n    \n    # Craft at the workshop (USE action)\n    actions.append(craft.USE)\n\n  index = env.world.cookbook.index\n  item_index = index[item]\n  \n  # Get the recipe for the desired item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n  \n  if not recipe:\n      raise ValueError(f\"No recipe found for item {item}.\")\n\n  # Find required workshop types based on ingredient indices in the recipe\n  workshop_indices = []\n  for ingredient_index in recipe:\n      if ingredient_index == \"_key\":\n          continue\n      for workshop in env.world.workshop_indices:\n          if ingredient_index in env.world.cookbook.recipes.get(workshop, {}).values():\n              workshop_indices.append(workshop)\n              break\n  \n  # Remove duplicates\n  workshop_indices = list(set(workshop_indices))\n  \n  actions = []\n  for workshop_index in workshop_indices:\n      navigate_and_craft(workshop_index)\n\n  return actions", "island_id": 5, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T23:20:41.566573", "function_name": "craft", "function_body": "  def navigate_to(pos):\n    # Calculate direction to move\n    current_pos = env._current_state.pos\n    dir_diff = (pos[0] - current_pos[0], pos[1] - current_pos[1])\n    \n    actions = []\n    if dir_diff[0] > 0:\n        actions.extend([craft.DOWN] * abs(dir_diff[0]))\n    elif dir_diff[0] < 0:\n        actions.extend([craft.UP] * abs(dir_diff[0]))\n\n    if dir_diff[1] > 0:\n        actions.extend([craft.RIGHT] * abs(dir_diff[1]))\n    elif dir_diff[1] < 0:\n        actions.extend([craft.LEFT] * abs(dir_diff[1]))\n    \n    return actions\n\n  def navigate_and_craft(workshop_index):\n      grid = env._current_state.grid\n      positions = np.argwhere(grid[:, :, workshop_index] > 0)\n      if len(positions) == 0:\n          raise ValueError(f\"No available workshop with index {workshop_index}.\")\n      \n      # Choose the closest workshop\n      pos = env._current_state.pos\n      distances = np.sum(np.abs(positions - pos), axis=1)\n      closest_workshop_pos = positions[np.argmin(distances)]\n      \n      # Move to the closest workshop\n      actions.extend(navigate_to(tuple(closest_workshop_pos)))\n      \n      # Craft at the workshop (USE action)\n      actions.append(craft.USE)\n\n  index = env.world.cookbook.index\n  item_index = index[item]\n  \n  # Get the recipe for the desired item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n  \n  if not recipe:\n      raise ValueError(f\"No recipe found for item {item}.\")\n\n  # Find required workshop types based on ingredient indices in the recipe\n  workshop_indices = []\n  for ingredient_index in recipe:\n      if ingredient_index == \"_key\":\n          continue\n      for workshop in env.world.workshop_indices:\n          if ingredient_index in env.world.cookbook.recipes.get(workshop, {}).values():\n              workshop_indices.append(workshop)\n              break\n  \n  # Remove duplicates\n  workshop_indices = list(set(workshop_indices))\n  \n  actions = []\n  for workshop_index in workshop_indices:\n      navigate_and_craft(workshop_index)\n\n  return actions", "island_id": 5, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T23:22:49.783577", "function_name": "craft", "function_body": "  def move_to_workshop(env, target_index):\n      \"\"\"\n      Returns a list of actions to move to the workshop at the specified index.\n      \n      Args:\n          env (env.CraftLab): The CraftLab environment instance.\n          target_index (int): The index of the workshop in `env.world.workshop_indices`.\n          \n      Returns:\n          List[int]: A list of action indices the agent can execute to move to the workshop.\n      \"\"\"\n      actions = []\n      \n      # Get the current position and direction\n      pos = env._current_state.pos\n      \n      # Determine the target position based on workshop index\n      target_pos = None  # Placeholder for actual logic to determine target position\n      for i, idx in enumerate(env.world.workshop_indices):\n          if idx == target_index:\n              target_pos = np.argwhere(env._current_state.grid[:, :, target_index] == 1)[0]\n      \n      # Implement logic to move from current position to target position\n      actions.extend(navigate_to_position(env, pos, target_pos))\n      \n      return actions\n\n  def navigate_to_position(env, start_pos, end_pos):\n      \"\"\"\n      Returns a list of actions to navigate from the start position to the end position.\n      \n      Args:\n          env (env.CraftLab): The CraftLab environment instance.\n          start_pos (tuple(int, int)): The starting position as a tuple (x, y).\n          end_pos (tuple(int, int)): The target position as a tuple (x, y).\n          \n      Returns:\n          List[int]: A list of action indices the agent can execute to navigate from start to end position.\n      \"\"\"\n      actions = []\n      \n      # Use simple pathfinding algorithm (e.g., BFS) to find the shortest path\n      path = bfs_pathfinding(env._current_state.grid, start_pos, end_pos)\n      \n      # Translate path into a sequence of actions\n      for i in range(1, len(path)):\n          dx = path[i][0] - path[i-1][0]\n          dy = path[i][1] - path[i-1][1]\n          \n          if dx == 1:\n              actions.append(env.action_specs()['DOWN'])\n          elif dx == -1:\n              actions.append(env.action_specs()['UP'])\n          elif dy == 1:\n              actions.append(env.action_specs()['RIGHT'])\n          elif dy == -1:\n              actions.append(env.action_specs()['LEFT'])\n      \n      return actions\n\n  def bfs_pathfinding(grid, start, end):\n      \"\"\"\n      Uses BFS to find the shortest path from `start` to `end`.\n      \n      Args:\n          grid (np.ndarray): The environment grid.\n          start (tuple(int, int)): The starting position as a tuple (x, y).\n          end (tuple(int, int)): The target position as a tuple (x, y).\n          \n      Returns:\n          List[tuple(int, int)]: A list of positions representing the shortest path from `start` to `end`.\n      \"\"\"\n      queue = collections.deque([start])\n      visited = set()\n      parent_map = {}\n      \n      while queue:\n          current_pos = queue.popleft()\n          \n          if current_pos == end:\n              break\n          \n          if current_pos in visited:\n              continue\n          \n          visited.add(current_pos)\n          \n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current_pos[0] + dx, current_pos[1] + dy)\n              \n              if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1] and grid[neighbor].sum() == 0:  # Assuming sum==0 means walkable\n                  queue.append(neighbor)\n                  parent_map[neighbor] = current_pos\n      \n      path = []\n      step = end\n      \n      while step in parent_map:\n          path.insert(0, step)\n          step = parent_map[step]\n      \n      if path and path[0] == start:\n          path.insert(0, start)\n      \n      return path\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Determine the workshop needed for crafting the item (if any)\n  workshop_required = None\n  for recipe_key, ingredients in env.world.cookbook.recipes.items():\n    if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n      workshop_required = recipe_key\n  \n  actions = []\n\n  # If a workshop is required to craft the item\n  if workshop_required:\n    # Determine the position of the required workshop\n    workshop_position = None\n    for i, idx in enumerate(env.world.workshop_indices):\n      if idx == workshop_required:\n        target_index = idx\n        break\n    \n    # Find the actual position of the workshop on the grid\n    try:\n        workshop_positions = np.argwhere(env._current_state.grid[:, :, target_index] > 0)\n        if len(workshop_positions) > 0:\n            workshop_position = tuple(workshop_positions[0])\n        else:\n            raise ValueError(f\"No workshop found with index {target_index}\")\n    except ValueError as e:\n        print(e)\n        return actions\n\n    # Move to the workshop\n    actions.extend(move_to_workshop(env, target_index))\n\n    # Perform the USE action to craft the item\n    actions.append(env.action_specs()['USE'])\n\n  return actions", "island_id": 6, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T23:22:50.831653", "function_name": "craft", "function_body": "  def move_to_workshop(env, target_index):\n      \"\"\"\n      Returns a list of actions to move to the workshop at the specified index.\n      \n      Args:\n          env (env.CraftLab): The CraftLab environment instance.\n          target_index (int): The index of the workshop in `env.world.workshop_indices`.\n          \n      Returns:\n          List[int]: A list of action indices the agent can execute to move to the workshop.\n      \"\"\"\n      actions = []\n      \n      # Get the current position and direction\n      pos = env._current_state.pos\n      \n      # Determine the target position based on workshop index\n      target_pos = np.argwhere(env._current_state.grid[:, :, target_index] == 1)[0]\n      \n      # Implement logic to move from current position to target position\n      actions.extend(navigate_to_position(env, pos, target_pos))\n      \n      return actions\n\n  def navigate_to_position(env, start_pos, end_pos):\n      \"\"\"\n      Returns a list of actions to navigate from the start position to the end position.\n      \n      Args:\n          env (env.CraftLab): The CraftLab environment instance.\n          start_pos (tuple(int, int)): The starting position as a tuple (x, y).\n          end_pos (tuple(int, int)): The target position as a tuple (x, y).\n          \n      Returns:\n          List[int]: A list of action indices the agent can execute to navigate from start to end position.\n      \"\"\"\n      actions = []\n      \n      # Use simple pathfinding algorithm (e.g., BFS) to find the shortest path\n      path = bfs_pathfinding(env._current_state.grid, start_pos, end_pos)\n      \n      # Translate path into a sequence of actions\n      for i in range(1, len(path)):\n          dx = path[i][0] - path[i-1][0]\n          dy = path[i][1] - path[i-1][1]\n          \n          if dx == 1:\n              actions.append(env.action_specs()['DOWN'])\n          elif dx == -1:\n              actions.append(env.action_specs()['UP'])\n          elif dy == 1:\n              actions.append(env.action_specs()['RIGHT'])\n          elif dy == -1:\n              actions.append(env.action_specs()['LEFT'])\n      \n      return actions\n\n  def bfs_pathfinding(grid, start, end):\n      \"\"\"\n      Uses BFS to find the shortest path from `start` to `end`.\n      \n      Args:\n          grid (np.ndarray): The environment grid.\n          start (tuple(int, int)): The starting position as a tuple (x, y).\n          end (tuple(int, int)): The target position as a tuple (x, y).\n          \n      Returns:\n          List[tuple(int, int)]: A list of positions representing the shortest path from `start` to `end`.\n      \"\"\"\n      queue = collections.deque([start])\n      visited = set()\n      parent_map = {}\n      \n      while queue:\n          current_pos = queue.popleft()\n          \n          if current_pos == end:\n              break\n          \n          if current_pos in visited:\n              continue\n          \n          visited.add(current_pos)\n          \n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current_pos[0] + dx, current_pos[1] + dy)\n              \n              if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1] and grid[neighbor].sum() == 0:  # Assuming empty cells have a sum of 0\n                  queue.append(neighbor)\n                  parent_map[neighbor] = current_pos\n      \n      path = []\n      step = end\n      \n      while step in parent_map:\n          path.insert(0, step)\n          step = parent_map[step]\n      \n      if path and path[0] == start:\n          path.insert(0, start)\n      \n      return path\n\n  item_index = env.world.cookbook.index[item]\n\n  # Determine the workshop needed for crafting the item (if any)\n  workshop_required = None\n  for recipe_key, ingredients in env.world.cookbook.recipes.items():\n    if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n      workshop_required = recipe_key\n  \n  actions = []\n\n  # If a workshop is required to craft the item\n  if workshop_required:\n    # Determine the position of the required workshop\n    try:\n        workshop_position = np.argwhere(env._current_state.grid[:, :, workshop_required] == 1)[0]\n    except IndexError:\n        raise ValueError(f\"No workshop found with index {workshop_required}.\")\n    \n    # Move to the workshop\n    actions.extend(move_to_workshop(env, workshop_position))\n\n    # Perform the USE action to craft the item\n    actions.append(env.action_specs()['USE'])\n\n  return actions", "island_id": 6, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T23:23:54.280706", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Retrieve recipes that produce the specified item\n  recipes = {k: v for k, v in env.world.cookbook.recipes.items() if \"_key\" in v and v[\"_key\"] == item_index}\n\n  # If no recipe is found, return an empty list\n  if not recipes:\n    return []\n\n  # Assume we have only one recipe to produce the item\n  recipe = next(iter(recipes.values()))\n\n  # Identify required ingredients from the recipe\n  required_ingredients = [k for k in recipe.keys() if k != \"_key\"]\n\n  # Check if all required ingredients are available in inventory\n  missing_ingredients = []\n  for ingredient_index in required_ingredients:\n    if not env._current_state.inventory[ingredient_index]:\n      missing_ingredients.append(ingredient_index)\n\n  # If any ingredients are missing, attempt to collect them\n  actions_to_collect = []\n  for ingredient_index in missing_ingredients:\n    ingredient_name = env.world.cookbook.index.get(ingredient_index, \"unknown\")\n    actions_to_collect.extend(collect(env, ingredient_name))\n\n  # Determine which workshop type is needed based on the ingredients\n  workshop_needed = None\n  for ingredient_index in required_ingredients:\n      if ingredient_index != \"_key\":\n          kind_name = env.world.cookbook.index.get(ingredient_index, \"unknown\")\n          if kind_name.startswith(\"WORKSHOP\"):\n              workshop_needed = ingredient_index\n              break\n\n  # If no specific workshop is needed, use the first available workshop\n  if workshop_needed is None:\n      workshop_needed = env.world.workshop_indices[0]\n\n  # Find the nearest workshop of the required type\n  workshops = np.argwhere(env._current_state.grid[:, :, workshop_needed] > 0)\n\n  # If no workshop of the required type is found, return an empty list\n  if workshops.size == 0:\n      return []\n\n  # Choose the closest workshop to the agent's current position\n  agent_pos = env._current_state.pos\n  distances = np.sum(np.abs(workshops - agent_pos), axis=1)\n  nearest_workshop = tuple(workshops[np.argmin(distances)])\n\n  # Generate actions to move the agent to the nearest workshop\n  actions_to_workshop = move_to(env, nearest_workshop)\n\n  # Use action to craft the item\n  use_action_index = env.world.cookbook.index[\"USE\"]\n\n  # Combine all actions: collecting missing ingredients, moving to workshop, and using it\n  return actions_to_collect + actions_to_workshop + [use_action_index]", "island_id": 4, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T23:23:55.330456", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n  # Get all recipes that produce the item\n  recipes = {k: v for k, v in env.world.cookbook.recipes.items() if \"_key\" in v and v[\"_key\"] == item_index}\n\n  # If no recipe is found, return an empty list\n  if not recipes:\n    return []\n\n  # Assume we have only one recipe to produce the item\n  recipe = next(iter(recipes.values()))\n\n  # Determine which workshop type is needed based on the ingredients\n  workshop_needed = None\n  for ingredient_index in recipe.keys():\n      if ingredient_index != \"_key\":\n          kind_name = env.world.cookbook.index.get(ingredient_index, \"unknown\")\n          if kind_name.startswith(\"WORKSHOP\"):\n              workshop_needed = ingredient_index\n              break\n\n  # If no specific workshop is needed, use the first available workshop\n  if workshop_needed is None:\n      workshop_needed = env.world.workshop_indices[0]\n\n  # Find the nearest workshop of the required type\n  workshops = np.argwhere(env._current_state.grid[:, :, workshop_needed] > 0)\n\n  # If no workshop of the required type is found, return an empty list\n  if workshops.size == 0:\n      return []\n\n  # Choose the closest workshop to the agent's current position\n  agent_pos = env._current_state.pos\n  distances = np.sum(np.abs(workshops - agent_pos), axis=1)\n  nearest_workshop = tuple(workshops[np.argmin(distances)])\n\n  # Generate actions to move the agent to the nearest workshop\n  actions_to_workshop = move_to(env, nearest_workshop)\n\n  # Use action to craft the item\n  use_action_index = env.world.cookbook.index[\"USE\"]\n\n  return actions_to_workshop + [use_action_index]", "island_id": 4, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T23:25:18.637235", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n\n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if abs(dx) > abs(dy):\n        if dx > 0:\n          actions.append(3)  # RIGHT\n        else:\n          actions.append(2)  # LEFT\n      else:\n        if dy > 0:\n          actions.append(1)  # UP\n        else:\n          actions.append(0)  # DOWN\n\n      current_pos = (current_pos[0] + (dx // abs(dx)) if dx != 0 else current_pos[0],\n                     current_pos[1] + (dy // abs(dy)) if dy != 0 else current_pos[1])\n      \n    return actions\n  \n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  # This step assumes that the recipe specifies the workshop type needed.\n  # Since the problem does not specify how to determine the workshop,\n  # we will assume that all workshops can craft any items for simplicity.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 7, "scores": {"": 0.90000004}}
{"timestamp": "2025-09-02T23:25:19.699878", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n\n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      # Prioritize moving in the direction of the greater distance to reach faster\n      if abs(dx) > abs(dy):\n        if dx > 0:\n          actions.append(3)  # RIGHT\n        else:\n          actions.append(2)  # LEFT\n      elif abs(dy) > abs(dx):\n        if dy > 0:\n          actions.append(1)  # UP\n        else:\n          actions.append(0)  # DOWN\n      else:\n        # If dx == dy, move in one direction first (e.g., RIGHT), then adjust\n        if dx > 0:\n          actions.append(3)  # RIGHT\n        elif dy > 0:\n          actions.append(1)  # UP\n        elif dx < 0:\n          actions.append(2)  # LEFT\n        else:\n          actions.append(0)  # DOWN\n\n      current_pos = (current_pos[0] + (dx // abs(dx)) if dx != 0 else current_pos[0],\n                     current_pos[1] + (dy // abs(dy)) if dy != 0 else current_pos[1])\n      \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  # This step assumes that the recipe specifies the workshop type needed.\n  # Since the problem does not specify how to determine the workshop,\n  # we will assume that all workshops can craft any items for simplicity.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 7, "scores": {"": 0.7}}
{"timestamp": "2025-09-02T23:27:38.250074", "function_name": "craft", "function_body": "  def get_workshop_for_item(item_index):\n    for workshop, recipes in env.world.cookbook.recipes.items():\n        if '_key' in recipes and item_index == recipes['_key']:\n            return workshop\n    return None\n\n  def find_nearest_workshop(env, workshop_index):\n      \"\"\"Find the nearest workshop of a given type using A*.\"\"\"\n      world = env.world\n      grid = env._current_state.grid\n      pos = env._current_state.pos\n      \n      start = (pos[0], pos[1])\n      goal = None\n      \n      # Initialize the priority queue with the starting position\n      open_set = collections.PriorityQueue()\n      open_set.put((0, start, []))\n      \n      came_from = {}\n      g_score = {start: 0}\n      f_score = {start: heuristic(start, world.workshop_indices[workshop_index - len(world.primitives)])}\n      \n      while not open_set.empty():\n          _, current, path = open_set.get()\n          \n          if np.argmax(grid[current]) == world.workshop_indices[workshop_index - len(world.primitives)]:\n              goal = current\n              break\n          \n          # Explore neighbors in all four directions\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              \n              if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n                  tentative_g_score = g_score[current] + 1\n                  \n                  if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                      came_from[neighbor] = current\n                      g_score[neighbor] = tentative_g_score\n                      f_score[neighbor] = tentative_g_score + heuristic(neighbor, world.workshop_indices[workshop_index - len(world.primitives)])\n                      open_set.put((f_score[neighbor], neighbor, path + [(dx, dy)]))\n      \n      if goal is not None:\n          x, y = goal\n          current = (x, y)\n          path = []\n          \n          while current in came_from:\n              dx, dy = np.array(current) - np.array(came_from[current])\n              if (dx, dy) == (-1, 0):  # UP\n                  path.append(env.action_specs()['UP'])\n              elif (dx, dy) == (1, 0):  # DOWN\n                  path.append(env.action_specs()['DOWN'])\n              elif (dx, dy) == (0, -1):  # LEFT\n                  path.append(env.action_specs()['LEFT'])\n              elif (dx, dy) == (0, 1):  # RIGHT\n                  path.append(env.action_specs()['RIGHT'])\n              current = came_from[current]\n          \n          return path[::-1]\n      \n      return None\n\n  def heuristic(a, b):\n    \"\"\"Calculate the Manhattan distance between two points.\"\"\"\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def get_primitives_needed(item_index):\n      \"\"\"Get the primitives needed to craft an item.\"\"\"\n      if item_index in env.world.cookbook.recipes:\n          recipe = env.world.cookbook.recipes[item_index]\n          return {key: value for key, value in recipe.items() if key != '_key'}\n      return {}\n\n  def collect_primitive(env, primitive_index):\n      \"\"\"Collect the required primitives.\"\"\"\n      grid = env._current_state.grid\n      agent_pos = env._current_state.pos\n      \n      # Find all locations of the primitive on the grid\n      primitive_locations = np.argwhere(grid[:, :, primitive_index] > 0)\n      \n      actions = []\n      for location in primitive_locations:\n          # Navigate to the primitive location\n          path_to_primitive = navigate_to(env, tuple(location))\n          actions.extend(path_to_primitive)\n          \n          # Collect the primitive (assuming USE action collects it)\n          actions.append(env.action_specs()['USE'])\n      \n      return actions\n\n  def navigate_to(env, target_pos):\n      \"\"\"Navigate to a given position on the grid using A*.\"\"\"\n      world = env.world\n      grid = env._current_state.grid\n      pos = env._current_state.pos\n      \n      start = (pos[0], pos[1])\n      goal = target_pos\n      \n      # Initialize the priority queue with the starting position\n      open_set = collections.PriorityQueue()\n      open_set.put((0, start, []))\n      \n      came_from = {}\n      g_score = {start: 0}\n      f_score = {start: heuristic(start, goal)}\n      \n      while not open_set.empty():\n          _, current, path = open_set.get()\n          \n          if current == goal:\n              break\n          \n          # Explore neighbors in all four directions\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              \n              if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n                  tentative_g_score = g_score[current] + 1\n                  \n                  if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                      came_from[neighbor] = current\n                      g_score[neighbor] = tentative_g_score\n                      f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                      open_set.put((f_score[neighbor], neighbor, path + [(dx, dy)]))\n      \n      if goal in came_from:\n          x, y = goal\n          current = (x, y)\n          path = []\n          \n          while current in came_from:\n              dx, dy = np.array(current) - np.array(came_from[current])\n              if (dx, dy) == (-1, 0):  # UP\n                  path.append(env.action_specs()['UP'])\n              elif (dx, dy) == (1, 0):  # DOWN\n                  path.append(env.action_specs()['DOWN'])\n              elif (dx, dy) == (0, -1):  # LEFT\n                  path.append(env.action_specs()['LEFT'])\n              elif (dx, dy) == (0, 1):  # RIGHT\n                  path.append(env.action_specs()['RIGHT'])\n              current = came_from[current]\n          \n          return path[::-1]\n      \n      return None\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the primitives needed to craft the item\n  primitives_needed = get_primitives_needed(item_index)\n  \n  actions = []\n  \n  for primitive, count in primitives_needed.items():\n      primitive_index = primitive\n      \n      # Collect the required number of primitives\n      while count > 0:\n          actions.extend(collect_primitive(env, primitive_index))\n          count -= 1\n  \n  # Find the workshop that allows crafting this item (if any)\n  workshop_index = get_workshop_for_item(item_index)\n\n  if workshop_index is not None:\n      # Get the location of the nearest workshop of the required type\n      nearest_workshop_location = find_nearest_workshop(env, workshop_index)\n      \n      if nearest_workshop_location is not None:\n          # Navigate to the workshop location\n          actions.extend(nearest_workshop_location)\n          \n          # Craft the item using the workshop\n          actions.append(env.action_specs()['USE'])\n  \n  return actions", "island_id": 9, "scores": {"": -1}}
