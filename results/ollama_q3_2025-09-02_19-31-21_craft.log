     elif dx < 0:\n          actions.append(2)  # LEFT\n      elif dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n\n      current_pos = next_pos\n      \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  # This step assumes that the recipe specifies the workshop type needed.\n  # Since the problem does not specify how to determine the workshop,\n  # we will assume that all workshops can craft any items for simplicity.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 3, "scores": {"": 4.7}}
{"timestamp": "2025-09-03T07:55:51.098921", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Iterate over all positions on the grid to find the closest workshop\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if any(grid[i, j, w] > 0 for w in workshop_indices):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    # Calculate the direction to move in\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    # Move horizontally first if needed\n    while dx != 0:\n      if dx > 0:\n        actions.append(3)  # RIGHT\n        dx -= 1\n      else:\n        actions.append(2)  # LEFT\n        dx += 1\n    \n    # Then move vertically if needed\n    while dy != 0:\n      if dy > 0:\n        actions.append(1)  # UP\n        dy -= 1\n      else:\n        actions.append(0)  # DOWN\n        dy += 1\n\n    return actions\n  \n  def find_item_in_env(env, item):\n    \"\"\"Find the position of a given item on the grid.\"\"\"\n    item_index = env.world.cookbook.index[item]\n    grid = env._current_state.grid\n    \n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if grid[i, j, item_index] > 0:\n          return (i, j)\n    return None\n\n  def determine_workshop(item_index, workshop_indices):\n    \"\"\"Determine the specific workshop type required for crafting the item.\"\"\"\n    # This is a placeholder implementation. In practice, you would have a mapping of items to workshop indices.\n    # For simplicity, let's assume WORKSHOP0 can craft any item.\n\n    return workshop_indices[0]  # Placeholder\n\n  def collect_item(env, item):\n    \"\"\"Generate actions to collect an item if it's not already in the inventory.\"\"\"\n    item_pos = find_item_in_env(env, item)\n    \n    if item_pos:\n      actions_to_item = move_to(env, item_pos)\n      actions_to_item.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n      return actions_to_item\n    else:\n      raise ValueError(f\"Item '{item}' not found on the grid.\")\n\n  def get_required_primitives(item_index, cookbook):\n    \"\"\"Get a list of required primitives for crafting an item.\"\"\"\n    recipe = cookbook.recipes.get(item_index)\n    \n    if not recipe:\n      raise ValueError(\"No recipe available for this item.\")\n    \n    required_primitives = []\n    for ingredient in recipe:\n        if ingredient not in env._current_state.inventory:  # Check if the ingredient is not already in inventory\n            required_primitives.append(ingredient)\n    return required_primitives\n\n  # Get the index of the item\n  item_index = env.world.cookbook.index[item]\n\n  # Determine which workshop is required for crafting this item\n  workshop_indices = env.world.workshop_indices\n  workshop_index = determine_workshop(item_index, workshop_indices)\n\n  # Find the closest workshop of the required type\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Collect all required primitives\n  required_primitives = get_required_primitives(item_index, env.world.cookbook)\n  actions_to_collect_items = []\n  \n  for primitive in required_primitives:\n      action = collect_item(env, primitive)\n      actions_to_collect_items.extend(action)\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n\n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_collect_items + actions_to_workshop", "island_id": 4, "scores": {"": -1}}
{"timestamp": "2025-09-03T07:55:52.054975", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Iterate over all positions on the grid to find the closest workshop\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if any(grid[i, j, w] > 0 for w in workshop_indices):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    # Calculate the direction to move in\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    # Move horizontally first if needed\n    while dx != 0:\n      if dx > 0:\n        actions.append(3)  # RIGHT\n        dx -= 1\n      else:\n        actions.append(2)  # LEFT\n        dx += 1\n    \n    # Then move vertically if needed\n    while dy != 0:\n      if dy > 0:\n        actions.append(1)  # UP\n        dy -= 1\n      else:\n        actions.append(0)  # DOWN\n        dy += 1\n\n    return actions\n\n  def determine_workshop(item_index, workshop_indices):\n    \"\"\"Determine the specific workshop type required for crafting the item.\"\"\"\n    # This is a placeholder implementation. In practice, you would have a mapping of items to workshop indices.\n    # For simplicity, let's assume WORKSHOP0 can craft any item.\n\n    return workshop_indices[0]  # Placeholder\n\n  def check_inventory_for_primitives(env, primitives):\n      inventory = env._current_state.inventory\n      for primitive in primitives:\n          if inventory.get(primitive, 0) == 0:\n              return False\n      return True\n\n  # Get the index of the item\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  workshop_indices = env.world.workshop_indices\n  workshop_index = determine_workshop(item_index, workshop_indices)\n\n  # Get the primitives needed to craft the item\n  primitives_needed = [env.world.cookbook.index[p] for p in env.world.cookbook.recipes[item_index]]\n\n  # Check if all required primitives are available in the inventory\n  if not check_inventory_for_primitives(env, primitives_needed):\n      return []  # No actions can be taken as we do not have the required items\n\n  # Find the closest workshop of the required type\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 4, "scores": {"": -1}}
