{"timestamp": "2025-09-03T00:00:16.857178", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n\n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      # Move horizontally first\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      \n      # Then move vertically\n      if dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n\n      current_pos = (current_pos[0] + (dx // abs(dx)) if dx != 0 else current_pos[0],\n                     current_pos[1] + (dy // abs(dy)) if dy != 0 else current_pos[1])\n      \n    return actions\n\n  def get_workshop_for_item(item_index):\n      # Assuming that the recipe for an item specifies which workshop is needed\n      # For simplicity, let's assume there is a mapping from items to workshops in the cookbook\n      # Here we just use a placeholder. In reality, this would need to be extracted from the recipes.\n      return env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  workshop_index = get_workshop_for_item(item_index)\n\n  # Find the closest workshop of the required type\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 7, "scores": {"": 4.7}}
{"timestamp": "2025-09-03T00:00:17.907564", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Flatten the grid to iterate over all positions\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n\n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      # Move horizontally first\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      \n      # Then move vertically\n      if dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n\n      current_pos = (current_pos[0] + (dx // abs(dx)) if dx != 0 else current_pos[0],\n                     current_pos[1] + (dy // abs(dy)) if dy != 0 else current_pos[1])\n      \n    return actions\n  \n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  # This step assumes that the recipe specifies the workshop type needed.\n  # Since the problem does not specify how to determine the workshop,\n  # we will assume that all workshops can craft any items for simplicity.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 7, "scores": {"": 4.7}}
{"timestamp": "2025-09-03T00:01:55.838870", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n  if item_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  # Find the workshop required for crafting this item\n  recipes = env.world.cookbook.recipes\n  workshop_indices = env.world.workshop_indices\n\n  workshop_required_for_item = None\n  for recipe in recipes:\n    if \"_key\" in recipes[recipe]:\n      key = recipes[recipe][\"_key\"]\n      if key == item_index and recipe in workshop_indices:\n        workshop_required_for_item = recipe\n        break\n\n  # If no workshop is required, return an empty list (item can be crafted directly)\n  if workshop_required_for_item is None:\n    return []\n\n  # Get the current position of the agent\n  current_pos = env._current_state.pos\n\n  # Find the shortest path to the workshop using A* algorithm or similar\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star_search(start, goal):\n    open_set = collections.PriorityQueue()\n    open_set.put((0, start))\n    came_from = {}\n    cost_so_far = {}\n    came_from[start] = None\n    cost_so_far[start] = 0\n\n    while not open_set.empty():\n        _, current = open_set.get()\n\n        if current == goal:\n            break\n\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            neighbor = (current[0] + dx, current[1] + dy)\n            new_cost = cost_so_far[current] + heuristic(current, neighbor)\n\n            if neighbor not in cost_so_far or new_cost < cost_so_far[neighbor]:\n                cost_so_far[neighbor] = new_cost\n                priority = new_cost + heuristic(goal, neighbor)\n                open_set.put((priority, neighbor))\n                came_from[neighbor] = current\n\n    return reconstruct_path(came_from, start, goal)\n\n  def reconstruct_path(came_from, start, goal):\n      current = goal\n      path = []\n      while current != start:\n          path.append(current)\n          current = came_from[current]\n      path.reverse()\n      return path\n\n  # Calculate the position of the workshop on the grid\n  workshop_pos = None\n  for y in range(env._current_state.grid.shape[0]):\n    for x in range(env._current_state.grid.shape[1]):\n      if env._current_state.grid[y, x, workshop_required_for_item] > 0:\n        workshop_pos = (x, y)\n        break\n    if workshop_pos is not None:\n        break\n\n  # If no workshop is found on the grid, return an empty list\n  if workshop_pos is None:\n    return []\n\n  # Find the path to the workshop\n  path_to_workshop = a_star_search(current_pos, workshop_pos)\n\n  # Convert the path into actions (UP, DOWN, LEFT, RIGHT)\n  action_map = {(-1, 0): env.action_specs()['UP'], (1, 0): env.action_specs()['RIGHT'],\n                (0, -1): env.action_specs()['DOWN'], (0, 1): env.action_specs()['LEFT']}\n  actions_to_workshop = []\n  for i in range(1, len(path_to_workshop)):\n      dx = path_to_workshop[i][0] - path_to_workshop[i-1][0]\n      dy = path_to_workshop[i][1] - path_to_workshop[i-1][1]\n      if (dx, dy) in action_map:\n          actions_to_workshop.append(action_map[(dx, dy)])\n\n  # Add the USE action to craft the item\n  actions_to_workshop.append(env.action_specs()['USE'])\n\n  return actions_to_workshop", "island_id": 9, "scores": {"": 0.0}}
