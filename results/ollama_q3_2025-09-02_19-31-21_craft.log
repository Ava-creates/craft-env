in range(grid_shape[1]):\n    for x in range(grid_shape[0]):\n      if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n        target_pos = np.array((x, y))\n        distance = np.linalg.norm(agent_pos - target_pos)\n        if distance < min_distance:\n          min_distance = distance\n          workshop_pos = (x, y)\n\n  # If no workshop position is found, return an empty list of actions\n  if workshop_pos is None:\n    return []\n\n  # Calculate the path to the closest workshop and perform the USE action\n  target_pos = np.array(workshop_pos)\n  actions_to_workshop = path_to_target(agent_pos[:2], target_pos)\n  actions_to_workshop.append(4)  # USE to craft the item\n\n  # Update inventory after crafting\n  update_inventory(item_index)\n\n  return actions_to_collect_primitives + actions_to_workshop", "island_id": 2, "scores": {"": 2.7}}
{"timestamp": "2025-09-03T09:59:47.131309", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if any(grid[i, j, w] > 0 for w in workshop_indices):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      # Move horizontally first if needed\n      if dx > 0 and abs(dx) >= abs(dy):\n          actions.append(3)  # RIGHT\n          current_pos = (current_pos[0] + 1, current_pos[1])\n      elif dx < 0 and abs(dx) >= abs(dy):\n          actions.append(2)  # LEFT\n          current_pos = (current_pos[0] - 1, current_pos[1])\n      \n      # Move vertically if needed\n      if dy > 0 and abs(dy) >= abs(dx):\n          actions.append(1)  # UP\n          current_pos = (current_pos[0], current_pos[1] + 1)\n      elif dy < 0 and abs(dy) >= abs(dx):\n          actions.append(0)  # DOWN\n          current_pos = (current_pos[0], current_pos[1] - 1)\n\n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  # This step assumes that the recipe specifies the workshop type needed.\n  # Since the problem does not specify how to determine the workshop,\n  # we will assume that all workshops can craft any items for simplicity.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 1, "scores": {"": 4.7}}
{"timestamp": "2025-09-03T09:59:48.125331", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any([grid[i, j, w] > 0 for w in workshop_indices]):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      # Move horizontally first\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      \n      # Then move vertically\n      if dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n\n      current_pos = (current_pos[0] + (dx // abs(dx)) if dx != 0 else current_pos[0],\n                     current_pos[1] + (dy // abs(dy)) if dy != 0 else current_pos[1])\n      \n    return actions\n\n  def ensure_primitives(env, item):\n      primitives = env.world.cookbook.primitives_for_item(item)\n      for primitive in primitives:\n          while not env._current_state.next_to(primitive):\n              closest_primitive_pos = find_closest_primitive(grid, pos, primitive)\n              if not closest_primitive_pos:\n                  raise ValueError(f\"No available {primitive} found on the grid.\")\n              \n              actions_to_primitive = move_to(env, closest_primitive_pos)\n              actions_to_primitive.append(4)  # Assuming the last action index corresponds to USE (collecting)\n              yield from actions_to_primitive\n          \n          yield 4  # Collect the primitive\n\n      def find_closest_primitive(grid, pos, primitive):\n          primitive_index = env.world.cookbook.index[primitive]\n          min_distance = float('inf')\n          closest_primitive_pos = None\n          \n          for i in range(grid.shape[0]):\n              for j in range(grid.shape[1]):\n                  if grid[i, j, primitive_index] > 0:\n                      distance = abs(i - pos[0]) + abs(j - pos[1])\n                      if distance < min_distance:\n                          min_distance = distance\n                          closest_primitive_pos = (i, j)\n          return closest_primitive_pos\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  # This step assumes that the recipe specifies the workshop type needed.\n  # Since the problem does not specify how to determine the workshop,\n  # we will assume that all workshops can craft any items for simplicity.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Ensure all primitives are collected\n  actions_to_collect_primitives = list(ensure_primitives(env, item))\n  \n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(4)  # Assuming the last action index corresponds to USE\n\n  return actions_to_collect_primitives + actions_to_workshop", "island_id": 1, "scores": {"": -1}}
{"timestamp": "2025-09-03T10:01:17.204653", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n\n    # Iterate over all positions on the grid to find the closest workshop\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if any(grid[i, j, w] > 0 for w in workshop_indices):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n\n    # Calculate the direction to move in\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    # Move horizontally first if needed\n    while dx != 0:\n      action = 3 if dx > 0 else 2\n      actions.append(action)\n      dx -= 1 if dx > 0 else -1\n\n    # Then move vertically if needed\n    while dy != 0:\n      action = 1 if dy > 0 else 0\n      actions.append(action)\n      dy -= 1 if dy > 0 else -1\n\n    return actions\n\n  def determine_workshop(item_index, workshop_indices):\n    \"\"\"Determine the specific workshop type required for crafting the item.\"\"\"\n    # This is a placeholder implementation. In practice, you would have a mapping of items to workshop indices.\n    # For simplicity, let's assume WORKSHOP0 can craft any item.\n\n    return workshop_indices[0]  # Placeholder\n\n  # Get the index of the item\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  workshop_indices = env.world.workshop_indices\n  workshop_index = determine_workshop(item_index, workshop_indices)\n\n  # Find the closest workshop of the required type\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 4, "scores": {"": 4.7}}
{"timestamp": "2025-09-03T10:01:18.176663", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Iterate over all positions on the grid to find the closest workshop\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if any(grid[i, j, w] > 0 for w in workshop_indices):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    # Calculate the direction to move in\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    # Move horizontally first if needed\n    while dx != 0:\n      if dx > 0:\n        actions.append(3)  # RIGHT\n        dx -= 1\n      else:\n        actions.append(2)  # LEFT\n        dx += 1\n    \n    # Then move vertically if needed\n    while dy != 0:\n      if dy > 0:\n        actions.append(1)  # UP\n        dy -= 1\n      else:\n        actions.append(0)  # DOWN\n        dy += 1\n\n    return actions\n\n  def determine_workshop(item_index, workshop_indices):\n    \"\"\"Determine the specific workshop type required for crafting the item.\"\"\"\n    \n    # For simplicity, let's assume WORKSHOP0 can craft any item.\n    # In a real-world scenario, you would have a mapping of items to specific workshops.\n\n    return workshop_indices[0]  # Placeholder\n\n  def check_inventory_for_primitives(env, item_index):\n    \"\"\"Check if the required primitives for crafting the item are available in the inventory.\"\"\"\n    \n    # Get the recipe for the item\n    recipe = env.world.cookbook.recipes[item_index]\n\n    # Check each ingredient in the recipe\n    for primitive_index, amount in recipe.items():\n      if env._current_state.inventory[primitive_index] < amount:\n        return False  # Missing required primitives\n\n    return True  # All required primitives are available\n\n  # Get the index of the item\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  workshop_indices = env.world.workshop_indices\n  workshop_index = determine_workshop(item_index, workshop_indices)\n\n  # Check if the required primitives are available in the inventory\n  if not check_inventory_for_primitives(env, item_index):\n    raise ValueError(f\"Required primitives for '{item}' are not available in the inventory.\")\n\n  # Find the closest workshop of the required type\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 4, "scores": {"": -1}}
{"timestamp": "2025-09-03T10:02:39.816429", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Iterate over all positions in the grid to find the closest workshop\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any(grid[i, j, workshop_indices] > 0):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    # Calculate the differences in x and y coordinates\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    # Move horizontally first\n    while dx != 0:\n      if dx > 0:\n        actions.append(3)  # RIGHT\n      else:\n        actions.append(2)  # LEFT\n      dx += -1 if dx > 0 else 1\n\n    # Then move vertically\n    while dy != 0:\n      if dy > 0:\n        actions.append(1)  # UP\n      else:\n        actions.append(0)  # DOWN\n      dy += -1 if dy > 0 else 1\n      \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  # This step assumes that the recipe specifies the workshop type needed.\n  # Since the problem does not specify how to determine the workshop,\n  # we will assume that all workshops can craft any items for simplicity.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 9, "scores": {"": 4.7}}
{"timestamp": "2025-09-03T10:02:40.873169", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Iterate over all positions in the grid to find the closest workshop\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if np.any(grid[i, j, w] > 0 for w in workshop_indices):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n\n    # Calculate the differences in x and y coordinates\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    # Move horizontally first\n    while dx != 0:\n      if dx > 0:\n        actions.append(3)  # RIGHT\n      else:\n        actions.append(2)  # LEFT\n      current_pos = (current_pos[0] + 1, current_pos[1]) if dx > 0 else (current_pos[0] - 1, current_pos[1])\n      dx += -1 if dx > 0 else 1\n\n    # Then move vertically\n    while dy != 0:\n      if dy > 0:\n        actions.append(1)  # UP\n      else:\n        actions.append(0)  # DOWN\n      current_pos = (current_pos[0], current_pos[1] + 1) if dy > 0 else (current_pos[0], current_pos[1] - 1)\n      dy += -1 if dy > 0 else 1\n      \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine which workshop is required for crafting this item\n  # Since the problem does not specify how to determine the workshop,\n  # we will assume that all workshops can craft any items for simplicity.\n  workshop_index = env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  # Find the closest workshop on the grid\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Generate actions to move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions_to_workshop", "island_id": 9, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T10:04:52.431191", "function_name": "craft", "function_body": "  def get_closest_workshop(item_index):\n    \"\"\"Finds the closest workshop that can craft the specified item.\"\"\"\n    # Determine the workshop required based on the recipe key\n    workshop_indices = []\n    for output_idx, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n        workshop_name = ingredients.get(\"_workshop\")\n        if workshop_name:\n          workshop_indices.append(env.world.cookbook.index[workshop_name])\n    \n    # If no specific workshop is needed, use a default one\n    if not workshop_indices:\n      return env.world.workshop_indices[0]  # Default to the first workshop type\n    \n    # Find the closest workshop in the grid\n    agent_pos = np.array(env._current_state.pos)\n    min_distance = float('inf')\n    closest_workshop_index = None\n    for workshop_index in workshop_indices:\n      for y in range(grid_shape[1]):\n        for x in range(grid_shape[0]):\n          if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n            target_pos = np.array((x, y))\n            distance = np.linalg.norm(agent_pos - target_pos)\n            if distance < min_distance:\n              min_distance = distance\n              closest_workshop_index = workshop_index\n    return closest_workshop_index\n\n  def path_to_target(start, target):\n    \"\"\"Computes the path from start position to target position using A* algorithm.\"\"\"\n    # Define possible movements and their corresponding actions\n    moves = [(1, 0, 3), (-1, 0, 2), (0, 1, 1), (0, -1, 0)]  # RIGHT, LEFT, UP, DOWN\n    open_set = collections.deque([(start[0], start[1], [], 0)])  # Queue for BFS with cost\n    visited = set()\n    \n    while open_set:\n      x, y, path, cost = open_set.popleft()\n      \n      if (x, y) == tuple(target):\n        return path\n      \n      if (x, y) in visited:\n        continue\n      \n      visited.add((x, y))\n      \n      for dx, dy, action in moves:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < grid_shape[0] and 0 <= ny < grid_shape[1]:\n          open_set.append((nx, ny, path + [action], cost + 1))\n    \n    return []\n\n  def get_required_primitives(item_index):\n    \"\"\"Retrieves the list of required primitives for crafting an item.\"\"\"\n    for output_idx, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n        return [primitive for primitive in ingredients.keys() if primitive != \"_key\" and primitive != \"_workshop\"]\n    return []\n\n  def ensure_inventory(item_index):\n    \"\"\"Ensures the inventory has all required primitives for crafting.\"\"\"\n    actions = []\n    current_inventory = env._current_state.inventory.copy()\n    \n    # Get the list of required primitives\n    required_primitives = get_required_primitives(item_index)\n    \n    # Collect each missing primitive from the environment\n    for primitive in required_primitives:\n      if primitive not in current_inventory or current_inventory[primitive] == 0:\n        collect_actions = collect(env, primitive)\n        actions.extend(collect_actions)\n        # Update inventory after collecting\n        current_inventory[primitive] += 1\n    \n    return actions\n\n  def update_inventory(item_index):\n    \"\"\"Updates the inventory based on crafted items.\"\"\"\n    env._current_state.inventory[item_index] += 1\n\n  item_index = env.world.cookbook.index[item]\n  grid_shape = env._current_state.grid.shape[:2]\n\n  # Ensure inventory has all required primitives\n  actions_to_collect_primitives = ensure_inventory(item_index)\n\n  # Find the closest workshop for crafting\n  workshop_index = get_closest_workshop(item_index)\n\n  # Find the position of the closest workshop in the grid\n  agent_pos = np.array(env._current_state.pos)\n  workshop_pos = None\n  min_distance = float('inf')\n  for y in range(grid_shape[1]):\n    for x in range(grid_shape[0]):\n      if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n        target_pos = np.array((x, y))\n        distance = np.linalg.norm(agent_pos - target_pos)\n        if distance < min_distance:\n          min_distance = distance\n          workshop_pos = (x, y)\n\n  # If no workshop position is found, return an empty list of actions\n  if workshop_pos is None:\n    return []\n\n  # Calculate the path to the closest workshop and perform the USE action\n  target_pos = np.array(workshop_pos)\n  actions_to_workshop = path_to_target(agent_pos[:2], target_pos)\n  actions_to_workshop.append(4)  # USE to craft the item\n\n  # Update inventory after crafting\n  update_inventory(item_index)\n\n  return actions_to_collect_primitives + actions_to_workshop", "island_id": 8, "scores": {"": 2.7}}
{"timestamp": "2025-09-03T10:04:53.484017", "function_name": "craft", "function_body": "  def get_closest_workshop(item_index):\n    \"\"\"Finds the closest workshop that can craft the specified item.\"\"\"\n    # Determine the workshop required based on the recipe key\n    workshop_indices = []\n    for output_idx, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n        workshop_name = ingredients.get(\"_workshop\")\n        if workshop_name:\n          workshop_indices.append(env.world.cookbook.index[workshop_name])\n    \n    # If no specific workshop is needed, use a default one\n    if not workshop_indices:\n      return env.world.workshop_indices[0]  # Default to the first workshop type\n    \n    # Find the closest workshop in the grid\n    agent_pos = np.array(env._current_state.pos)\n    min_distance = float('inf')\n    closest_workshop_index = None\n    for workshop_index in workshop_indices:\n      for y in range(grid_shape[1]):\n        for x in range(grid_shape[0]):\n          if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n            target_pos = np.array((x, y))\n            distance = np.linalg.norm(agent_pos - target_pos)\n            if distance < min_distance:\n              min_distance = distance\n              closest_workshop_index = workshop_index\n    return closest_workshop_index\n\n  def path_to_target(start, target):\n    \"\"\"Computes the path from start position to target position using A* algorithm.\"\"\"\n    # Define possible movements and their corresponding actions\n    moves = [(1, 0, 3), (-1, 0, 2), (0, 1, 1), (0, -1, 0)]  # RIGHT, LEFT, UP, DOWN\n    open_set = collections.deque([(start[0], start[1], [], 0)])  # Queue for BFS with cost\n    visited = set()\n    \n    while open_set:\n      x, y, path, cost = open_set.popleft()\n      \n      if (x, y) == tuple(target):\n        return path\n      \n      if (x, y) in visited:\n        continue\n      \n      visited.add((x, y))\n      \n      for dx, dy, action in moves:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < grid_shape[0] and 0 <= ny < grid_shape[1]:\n          open_set.append((nx, ny, path + [action], cost + 1))\n    \n    return []\n\n  def get_required_primitives(item_index):\n    \"\"\"Retrieves the list of required primitives for crafting an item.\"\"\"\n    for output_idx, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n        return [primitive for primitive in ingredients.keys() if primitive != \"_key\" and primitive != \"_workshop\"]\n    return []\n\n  def ensure_inventory(item_index):\n    \"\"\"Ensures the inventory has all required primitives for crafting.\"\"\"\n    actions = []\n    current_inventory = env._current_state.inventory.copy()\n    \n    # Get the list of required primitives\n    required_primitives = get_required_primitives(item_index)\n    \n    # Collect each missing primitive from the environment\n    for primitive in required_primitives:\n      if primitive not in current_inventory or current_inventory[primitive] == 0:\n        collect_actions = collect(env, primitive)\n        actions.extend(collect_actions)\n        # Update inventory after collecting\n        current_inventory[primitive] += 1\n    \n    return actions\n\n  def update_inventory(item_index):\n    \"\"\"Updates the inventory based on crafted items.\"\"\"\n    env._current_state.inventory[item_index] += 1\n\n  item_index = env.world.cookbook.index[item]\n  grid_shape = env._current_state.grid.shape[:2]\n\n  # Ensure inventory has all required primitives\n  actions_to_collect_primitives = ensure_inventory(item_index)\n\n  # Find the closest workshop for crafting\n  workshop_index = get_closest_workshop(item_index)\n\n  # Find the position of the closest workshop in the grid\n  agent_pos = np.array(env._current_state.pos)\n  workshop_pos = None\n  min_distance = float('inf')\n  for y in range(grid_shape[1]):\n    for x in range(grid_shape[0]):\n      if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n        target_pos = np.array((x, y))\n        distance = np.linalg.norm(agent_pos - target_pos)\n        if distance < min_distance:\n          min_distance = distance\n          workshop_pos = (x, y)\n\n  # If no workshop position is found, return an empty list of actions\n  if workshop_pos is None:\n    return []\n\n  # Calculate the path to the closest workshop and perform the USE action\n  target_pos = np.array(workshop_pos)\n  actions_to_workshop = path_to_target(agent_pos[:2], target_pos)\n  actions_to_workshop.append(4)  # USE to craft the item\n\n  # Update inventory after crafting\n  update_inventory(item_index)\n\n  return actions_to_collect_primitives + actions_to_workshop", "island_id": 8, "scores": {"": 2.7}}
{"timestamp": "2025-09-03T10:06:57.333832", "function_name": "craft", "function_body": "  def get_closest_workshop(item_index):\n    \"\"\"Finds the closest workshop that can craft the specified item.\"\"\"\n    # Determine the workshop required based on the recipe key\n    workshop_indices = []\n    for output_idx, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n        workshop_name = ingredients.get(\"_workshop\")\n        if workshop_name:\n          workshop_indices.append(env.world.cookbook.index[workshop_name])\n    \n    # If no specific workshop is needed, use a default one\n    if not workshop_indices:\n      return env.world.workshop_indices[0]  # Default to the first workshop type\n    \n    # Find the closest workshop in the grid\n    agent_pos = np.array(env._current_state.pos)\n    min_distance = float('inf')\n    closest_workshop_index = None\n    for workshop_index in workshop_indices:\n      for y in range(grid_shape[1]):\n        for x in range(grid_shape[0]):\n          if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n            target_pos = np.array((x, y))\n            distance = np.linalg.norm(agent_pos - target_pos)\n            if distance < min_distance:\n              min_distance = distance\n              closest_workshop_index = workshop_index\n    return closest_workshop_index\n\n  def path_to_target(start, target):\n    \"\"\"Computes the path from start position to target position using A* algorithm.\"\"\"\n    actions = []\n    # Define possible movements and their corresponding actions\n    moves = [(1, 0, 3), (-1, 0, 2), (0, 1, 1), (0, -1, 0)]  # RIGHT, LEFT, UP, DOWN\n    open_set = collections.deque([(start[0], start[1], [])])  # Queue for BFS\n    visited = set()\n    \n    while open_set:\n      x, y, path = open_set.popleft()\n      \n      if (x, y) == tuple(target):\n        return path\n      \n      if (x, y) in visited:\n        continue\n      \n      visited.add((x, y))\n      \n      for dx, dy, action in moves:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < grid_shape[0] and 0 <= ny < grid_shape[1]:\n          open_set.append((nx, ny, path + [action]))\n    \n    return actions\n\n  def get_required_primitives(item_index):\n    \"\"\"Retrieves the list of required primitives for crafting an item.\"\"\"\n    for output_idx, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n        return [primitive for primitive in ingredients.keys() if primitive != \"_key\" and primitive != \"_workshop\"]\n    return []\n\n  def ensure_inventory(item_index):\n    \"\"\"Ensures the inventory has all required primitives for crafting.\"\"\"\n    actions = []\n    current_inventory = env._current_state.inventory.copy()\n    \n    # Get the list of required primitives\n    required_primitives = get_required_primitives(item_index)\n    \n    # Collect each missing primitive from the environment\n    for primitive in required_primitives:\n      if primitive not in current_inventory or current_inventory[primitive] == 0:\n        collect_actions = collect(env, primitive)\n        actions.extend(collect_actions)\n        # Update inventory after collecting\n        current_inventory[primitive] += 1\n    \n    return actions\n\n  def update_inventory(item_index):\n    \"\"\"Updates the inventory based on crafted items.\"\"\"\n    env._current_state.inventory[item_index] += 1\n\n  item_index = env.world.cookbook.index[item]\n  grid_shape = env._current_state.grid.shape[:2]\n\n  # Ensure inventory has all required primitives\n  actions_to_collect_primitives = ensure_inventory(item_index)\n\n  # Find the closest workshop for crafting\n  workshop_index = get_closest_workshop(item_index)\n\n  # Find the position of the closest workshop in the grid\n  agent_pos = np.array(env._current_state.pos)\n  workshop_pos = None\n  min_distance = float('inf')\n  for y in range(grid_shape[1]):\n    for x in range(grid_shape[0]):\n      if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n        target_pos = np.array((x, y))\n        distance = np.linalg.norm(agent_pos - target_pos)\n        if distance < min_distance:\n          min_distance = distance\n          workshop_pos = (x, y)\n\n  # If no workshop position is found, return an empty list of actions\n  if workshop_pos is None:\n    return []\n\n  # Calculate the path to the closest workshop and perform the USE action\n  target_pos = np.array(workshop_pos)\n  actions_to_workshop = path_to_target(agent_pos[:2], target_pos)\n  actions_to_workshop.append(4)  # USE to craft the item\n\n  # Update inventory after crafting\n  update_inventory(item_index)\n\n  return actions_to_collect_primitives + actions_to_workshop", "island_id": 2, "scores": {"": 2.7}}
{"timestamp": "2025-09-03T10:06:58.301504", "function_name": "craft", "function_body": "  def get_closest_workshop(item_index):\n    \"\"\"Finds the closest workshop that can craft the specified item.\"\"\"\n    # Determine the workshop required based on the recipe key\n    workshop_indices = []\n    for output_idx, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n        workshop_name = ingredients.get(\"_workshop\")\n        if workshop_name:\n          workshop_indices.append(env.world.cookbook.index[workshop_name])\n    \n    # If no specific workshop is needed, use a default one\n    if not workshop_indices:\n      return env.world.workshop_indices[0]  # Default to the first workshop type\n    \n    # Find the closest workshop in the grid\n    agent_pos = np.array(env._current_state.pos)\n    min_distance = float('inf')\n    closest_workshop_index = None\n    for workshop_index in workshop_indices:\n      for y in range(grid_shape[1]):\n        for x in range(grid_shape[0]):\n          if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n            target_pos = np.array((x, y))\n            distance = np.linalg.norm(agent_pos - target_pos)\n            if distance < min_distance:\n              min_distance = distance\n              closest_workshop_index = (x, y)\n    return closest_workshop_index\n\n  def path_to_target(start, target):\n    \"\"\"Computes the path from start position to target position using A* algorithm.\"\"\"\n    actions = []\n    # Define possible movements and their corresponding actions\n    moves = [(1, 0, 3), (-1, 0, 2), (0, 1, 1), (0, -1, 0)]  # RIGHT, LEFT, UP, DOWN\n    open_set = collections.deque([(start[0], start[1], [])])  # Queue for BFS\n    visited = set()\n    \n    while open_set:\n      x, y, path = open_set.popleft()\n      \n      if (x, y) == tuple(target):\n        return path\n      \n      if (x, y) in visited:\n        continue\n      \n      visited.add((x, y))\n      \n      for dx, dy, action in moves:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < grid_shape[0] and 0 <= ny < grid_shape[1]:\n          open_set.append((nx, ny, path + [action]))\n    \n    return actions\n\n  def get_required_primitives(item_index):\n    \"\"\"Retrieves the list of required primitives for crafting an item.\"\"\"\n    for output_idx, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n        return [primitive for primitive in ingredients.keys() if primitive != \"_key\" and primitive != \"_workshop\"]\n    return []\n\n  def ensure_inventory(item_index):\n    \"\"\"Ensures the inventory has all required primitives for crafting.\"\"\"\n    actions = []\n    current_inventory = env._current_state.inventory.copy()\n    \n    # Get the list of required primitives\n    required_primitives = get_required_primitives(item_index)\n    \n    # Collect each missing primitive from the environment\n    for primitive in required_primitives:\n      if primitive not in current_inventory or current_inventory[primitive] == 0:\n        collect_actions = collect(env, primitive)\n        actions.extend(collect_actions)\n        # Update inventory after collecting\n        current_inventory[primitive] += 1\n    \n    return actions\n\n  def update_inventory(item_index):\n    \"\"\"Updates the inventory based on crafted items.\"\"\"\n    env._current_state.inventory[item_index] += 1\n\n  item_index = env.world.cookbook.index[item]\n  grid_shape = env._current_state.grid.shape[:2]\n\n  # Ensure inventory has all required primitives\n  actions_to_collect_primitives = ensure_inventory(item_index)\n\n  # Find the closest workshop for crafting\n  workshop_pos = get_closest_workshop(item_index)\n\n  # If no workshop position is found, return an empty list of actions\n  if workshop_pos is None:\n    return []\n\n  # Calculate the path to the closest workshop and perform the USE action\n  target_pos = np.array(workshop_pos)\n  agent_pos = np.array(env._current_state.pos)\n  actions_to_workshop = path_to_target(agent_pos[:2], target_pos)\n  actions_to_workshop.append(4)  # USE to craft the item\n\n  # Update inventory after crafting\n  update_inventory(item_index)\n\n  return actions_to_collect_primitives + actions_to_workshop", "island_id": 2, "scores": {"": -1}}
{"timestamp": "2025-09-03T10:09:04.198093", "function_name": "craft", "function_body": "  def get_closest_workshop(item_index):\n    \"\"\"Finds the closest workshop that can craft the specified item.\"\"\"\n    # Determine the workshop required based on the recipe key\n    for output_idx, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n        workshop_name = ingredients.get(\"_workshop\")\n        if workshop_name:\n          workshop_index = env.world.cookbook.index[workshop_name]\n          # Find the closest workshop in the grid\n          agent_pos = np.array(env._current_state.pos)\n          min_distance = float('inf')\n          closest_workshop_pos = None\n          for y in range(grid_shape[1]):\n            for x in range(grid_shape[0]):\n              if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n                target_pos = np.array((x, y))\n                distance = np.linalg.norm(agent_pos - target_pos)\n                if distance < min_distance:\n                  min_distance = distance\n                  closest_workshop_pos = (x, y)\n          return closest_workshop_index, closest_workshop_pos\n    # If no specific workshop is needed or found, use a default one\n    default_workshop_index = env.world.workshop_indices[0]  # Default to the first workshop type\n    agent_pos = np.array(env._current_state.pos)\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    for y in range(grid_shape[1]):\n      for x in range(grid_shape[0]):\n        if env._current_state.grid[x, y, default_workshop_index] > 0:  # Check if the workshop is present at this cell\n          target_pos = np.array((x, y))\n          distance = np.linalg.norm(agent_pos - target_pos)\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (x, y)\n    return default_workshop_index, closest_workshop_pos\n\n  def path_to_target(start, target):\n    \"\"\"Computes the path from start position to target position using A* algorithm.\"\"\"\n    # Define possible movements and their corresponding actions\n    moves = [(1, 0, 3), (-1, 0, 2), (0, 1, 1), (0, -1, 0)]  # RIGHT, LEFT, UP, DOWN\n    open_set = collections.deque([(start[0], start[1], [], 0)])  # Queue for BFS with cost\n    visited = set()\n    \n    while open_set:\n      x, y, path, cost = open_set.popleft()\n      \n      if (x, y) == tuple(target):\n        return path\n      \n      if (x, y) in visited:\n        continue\n      \n      visited.add((x, y))\n      \n      for dx, dy, action in moves:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < grid_shape[0] and 0 <= ny < grid_shape[1]:\n          open_set.append((nx, ny, path + [action], cost + 1))\n    \n    return []\n\n  def get_required_primitives(item_index):\n    \"\"\"Retrieves the list of required primitives for crafting an item.\"\"\"\n    for output_idx, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n        return [primitive for primitive in ingredients.keys() if primitive != \"_key\" and primitive != \"_workshop\"]\n    return []\n\n  def ensure_inventory(item_index):\n    \"\"\"Ensures the inventory has all required primitives for crafting.\"\"\"\n    actions = []\n    current_inventory = env._current_state.inventory.copy()\n    \n    # Get the list of required primitives\n    required_primitives = get_required_primitives(item_index)\n    \n    # Collect each missing primitive from the environment\n    for primitive in required_primitives:\n      if primitive not in current_inventory or current_inventory[primitive] == 0:\n        collect_actions = collect(env, primitive)\n        actions.extend(collect_actions)\n        # Update inventory after collecting\n        current_inventory[primitive] += 1\n    \n    return actions\n\n  def update_inventory(item_index):\n    \"\"\"Updates the inventory based on crafted items.\"\"\"\n    env._current_state.inventory[item_index] += 1\n\n  item_index = env.world.cookbook.index[item]\n  grid_shape = env._current_state.grid.shape[:2]\n\n  # Ensure inventory has all required primitives\n  actions_to_collect_primitives = ensure_inventory(item_index)\n\n  # Find the closest workshop for crafting and its position\n  workshop_index, workshop_pos = get_closest_workshop(item_index)\n\n  # If no workshop position is found, return an empty list of actions\n  if workshop_pos is None:\n    return []\n\n  # Calculate the path to the closest workshop and perform the USE action\n  target_pos = np.array(workshop_pos)\n  actions_to_workshop = path_to_target(agent_pos[:2], target_pos)\n  actions_to_workshop.append(4)  # USE to craft the item\n\n  # Update inventory after crafting\n  update_inventory(item_index)\n\n  return actions_to_collect_primitives + actions_to_workshop", "island_id": 8, "scores": {"": -1}}
{"timestamp": "2025-09-03T10:09:05.161858", "function_name": "craft", "function_body": "  def get_closest_workshop(item_index):\n    \"\"\"Finds the closest workshop that can craft the specified item.\"\"\"\n    # Determine the workshop required based on the recipe key\n    workshop_indices = []\n    for output_idx, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n        workshop_name = ingredients.get(\"_workshop\")\n        if workshop_name:\n          workshop_indices.append(env.world.cookbook.index[workshop_name])\n    \n    # If no specific workshop is needed, use a default one\n    if not workshop_indices:\n      return env.world.workshop_indices[0]  # Default to the first workshop type\n    \n    # Find the closest workshop in the grid\n    agent_pos = np.array(env._current_state.pos)\n    min_distance = float('inf')\n    closest_workshop_index = None\n    for workshop_index in workshop_indices:\n      for y in range(grid_shape[1]):\n        for x in range(grid_shape[0]):\n          if env._current_state.grid[x, y, workshop_index] > 0:  # Check if the workshop is present at this cell\n            target_pos = np.array((x, y))\n            distance = np.linalg.norm(agent_pos - target_pos)\n            if distance < min_distance:\n              min_distance = distance\n              closest_workshop_index = (workshop_index, x, y)  # Store both index and position\n    return closest_workshop_index\n\n  def path_to_target(start, target):\n    \"\"\"Computes the path from start position to target position using A* algorithm.\"\"\"\n    moves = [(1, 0, 3), (-1, 0, 2), (0, 1, 1), (0, -1, 0)]  # RIGHT, LEFT, UP, DOWN\n    open_set = collections.deque([(start[0], start[1], [], 0)])  # Queue for BFS with cost\n    visited = set()\n    \n    while open_set:\n      x, y, path, cost = open_set.popleft()\n      \n      if (x, y) == tuple(target):\n        return path\n      \n      if (x, y) in visited:\n        continue\n      \n      visited.add((x, y))\n      \n      for dx, dy, action in moves:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < grid_shape[0] and 0 <= ny < grid_shape[1]:\n          open_set.append((nx, ny, path + [action], cost + 1))\n    \n    return []\n\n  def get_required_primitives(item_index):\n    \"\"\"Retrieves the list of required primitives for crafting an item.\"\"\"\n    for output_idx, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n        return [env.world.cookbook.index[primitive] for primitive in ingredients.keys() if primitive != \"_key\" and primitive != \"_workshop\"]\n    return []\n\n  def ensure_inventory(item_index):\n    \"\"\"Ensures the inventory has all required primitives for crafting.\"\"\"\n    actions = []\n    current_inventory = env._current_state.inventory.copy()\n    \n    # Get the list of required primitives\n    required_primitives = get_required_primitives(item_index)\n    \n    # Collect each missing primitive from the environment\n    for primitive in required_primitives:\n      if primitive not in current_inventory or current_inventory[primitive] == 0:\n        collect_actions = collect(env, env.world.cookbook.reverse_index[primitive])\n        actions.extend(collect_actions)\n        # Update inventory after collecting\n        current_inventory[primitive] += 1\n    \n    return actions\n\n  def update_inventory(item_index):\n    \"\"\"Updates the inventory based on crafted items.\"\"\"\n    env._current_state.inventory[item_index] += 1\n\n  item_index = env.world.cookbook.index[item]\n  grid_shape = env._current_state.grid.shape[:2]\n\n  # Ensure inventory has all required primitives\n  actions_to_collect_primitives = ensure_inventory(item_index)\n\n  # Find the closest workshop for crafting\n  workshop_info = get_closest_workshop(item_index)\n  \n  if not workshop_info:\n    return []\n\n  workshop_index, x, y = workshop_info\n\n  # Calculate the path to the closest workshop and perform the USE action\n  target_pos = np.array((x, y))\n  agent_pos = np.array(env._current_state.pos[:2])\n  actions_to_workshop = path_to_target(agent_pos, target_pos)\n  actions_to_workshop.append(4)  # USE to craft the item\n\n  # Update inventory after crafting\n  update_inventory(item_index)\n\n  return actions_to_collect_primitives + actions_to_workshop", "island_id": 8, "scores": {"": -1}}
{"timestamp": "2025-09-03T10:11:06.669442", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Iterate over all positions in the grid to find the closest workshop\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if any(grid[i, j, w] > 0 for w in env.world.workshop_indices):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    # Calculate the direction to move and generate actions\n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if abs(dx) >= abs(dy):\n          # Move horizontally first\n          if dx > 0:\n              actions.append(3)  # RIGHT\n              current_pos = (current_pos[0] + 1, current_pos[1])\n          elif dx < 0:\n              actions.append(2)  # LEFT\n              current_pos = (current_pos[0] - 1, current_pos[1])\n      else:\n          # Move vertically first\n          if dy > 0:\n              actions.append(1)  # UP\n              current_pos = (current_pos[0], current_pos[1] + 1)\n          elif dy < 0:\n              actions.append(0)  # DOWN\n              current_pos = (current_pos[0], current_pos[1] - 1)\n    \n    return actions\n\n  def get_workshop_for_item(item_index, cookbook):\n      \"\"\"Determine which workshop is required for crafting the item.\"\"\"\n      # Placeholder function to determine the workshop index.\n      # In reality, this would need to be extracted from the recipes.\n      # For simplicity, we assume all workshops can craft any items.\n      return env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  def has_required_primitives(env, item_index):\n    \"\"\"Check if the required primitives for crafting are in the inventory.\"\"\"\n    recipe = env.world.cookbook.recipes[item_index]\n    required_primitives = set()\n    \n    def get_primitive_indices(primitive_names):\n        return {env.world.cookbook.index[name] for name in primitive_names}\n    \n    # Extract required primitives from the recipe\n    if '_requires' in recipe:\n        required_primitives.update(get_primitive_indices(recipe['_requires']))\n    \n    # Check inventory against required primitives\n    inventory = env._current_state.inventory\n    return all(inventory[p] > 0 for p in required_primitives)\n\n  def collect_primitives(env, required_primitives):\n      \"\"\"Generate actions to collect the required primitives.\"\"\"\n      actions = []\n      \n      for primitive_name in required_primitives:\n          actions.extend(collect(env, primitive_name))\n      \n      return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Determine required primitives for crafting\n  recipe = env.world.cookbook.recipes[item_index]\n  required_primitives = set()\n  \n  def get_primitive_indices(primitive_names):\n      return {env.world.cookbook.index[name] for name in primitive_names}\n  \n  if '_requires' in recipe:\n      required_primitives.update(get_primitive_indices(recipe['_requires']))\n  \n  # Check inventory against required primitives and collect missing ones\n  actions = []\n  inventory = env._current_state.inventory\n  \n  missing_primitives = [primitive for primitive in required_primitives if inventory[primitive] == 0]\n  if missing_primitives:\n      actions.extend(collect_primitives(env, missing_primitives))\n\n  # Determine which workshop is required for crafting this item\n  workshop_index = get_workshop_for_item(item_index, env.world.cookbook)\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  \n  # Use the USE action to craft the item at the workshop\n  actions.extend(actions_to_workshop)\n  actions.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions", "island_id": 7, "scores": {"": 4.7}}
{"timestamp": "2025-09-03T10:11:07.801733", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    # Iterate over all positions in the grid to find the closest workshop\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if any(grid[i, j, w] > 0 for w in env.world.workshop_indices):\n          distance = abs(i - pos[0]) + abs(j - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    return closest_workshop_pos\n\n  def move_to(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    # Calculate the direction to move and generate actions\n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if abs(dx) >= abs(dy):\n          # Move horizontally first\n          if dx > 0:\n              actions.append(3)  # RIGHT\n              current_pos = (current_pos[0] + 1, current_pos[1])\n          elif dx < 0:\n              actions.append(2)  # LEFT\n              current_pos = (current_pos[0] - 1, current_pos[1])\n      else:\n          # Move vertically first\n          if dy > 0:\n              actions.append(1)  # UP\n              current_pos = (current_pos[0], current_pos[1] + 1)\n          elif dy < 0:\n              actions.append(0)  # DOWN\n              current_pos = (current_pos[0], current_pos[1] - 1)\n    \n    return actions\n\n  def get_workshop_for_item(item_index, cookbook):\n      \"\"\"Determine which workshop is required for crafting the item.\"\"\"\n      # Placeholder function to determine the workshop index.\n      # In reality, this would need to be extracted from the recipes.\n      # For simplicity, we assume all workshops can craft any items.\n      return env.world.workshop_indices[0]  # Use the first workshop as a placeholder\n\n  def has_required_primitives(env, item_index):\n    \"\"\"Check if the required primitives for crafting are in the inventory.\"\"\"\n    recipe = env.world.cookbook.recipes[item_index]\n    required_primitives = set()\n    \n    def get_primitive_indices(primitive_names):\n        return {env.world.cookbook.index[name] for name in primitive_names}\n    \n    # Extract required primitives from the recipe\n    if '_requires' in recipe:\n        required_primitives.update(get_primitive_indices(recipe['_requires']))\n    \n    # Check inventory against required primitives\n    inventory = env._current_state.inventory\n    return all(inventory[p] > 0 for p in required_primitives)\n\n  def collect_required_primitives(env, item_index):\n    \"\"\"Collect required primitives needed to craft the item.\"\"\"\n    recipe = env.world.cookbook.recipes[item_index]\n    actions = []\n    \n    if '_requires' in recipe:\n        required_primitives = recipe['_requires']\n        for primitive in required_primitives:\n            actions.extend(collect(env, primitive))\n    \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Item '{item}' cannot be crafted as it has no recipe.\")\n\n  # Collect required primitives if they are not already in the inventory\n  actions = collect_required_primitives(env, item_index)\n\n  # Determine which workshop is required for crafting this item\n  workshop_index = get_workshop_for_item(item_index, env.world.cookbook)\n\n  # Find the closest workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n\n  if not closest_workshop_pos:\n    raise ValueError(\"No available workshops found on the grid.\")\n\n  # Move to the closest workshop\n  actions_to_workshop = move_to(env, closest_workshop_pos)\n  actions.extend(actions_to_workshop)\n  \n  # Use the USE action to craft the item at the workshop\n  actions.append(env.world.n_actions - 1)  # Assuming the last action index corresponds to USE\n\n  return actions", "island_id": 7, "scores": {"": 4.7}}
