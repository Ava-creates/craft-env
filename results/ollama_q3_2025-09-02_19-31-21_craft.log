{"timestamp": "2025-09-02T22:54:50.242974", "function_name": "craft", "function_body": "  # Get the index for the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Determine if a workshop is required and which one to use\n  workshop_required = None\n  for recipe_key, ingredients in env.world.cookbook.recipes.items():\n      if \"_key\" in ingredients and ingredients[\"_key\"] == item_index:\n          workshop_required = recipe_key\n          break\n  \n  actions = []\n\n  # If a workshop is required, move to the correct workshop\n  if workshop_required:\n    # Find position of the required workshop in the grid\n    target_pos = None\n    for y in range(env.world.init_grid.shape[0]):\n        for x in range(env.world.init_grid.shape[1]):\n            if np.any(env.world.init_grid[y, x] == workshop_required):\n                target_pos = (x, y)\n                break\n        if target_pos:\n            break\n    \n    # Calculate the path to the workshop using BFS\n    queue = collections.deque([(env._current_state.pos, env._current_state.dir)])\n    visited = set([env._current_state.pos])\n    parent = {env._current_state.pos: None}\n    \n    while queue:\n        (pos, current_dir), dir_index = queue.popleft()\n        \n        if pos == target_pos:\n            break\n        \n        for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n            new_x, new_y = pos[0] + dx, pos[1] + dy\n            if 0 <= new_x < env.world.init_grid.shape[1] and 0 <= new_y < env.world.init_grid.shape[0]:\n                if (new_x, new_y) not in visited:\n                    queue.append(((new_x, new_y), current_dir))\n                    visited.add((new_x, new_y))\n    \n    # Reconstruct the path\n    path = []\n    while target_pos:\n        path.append(target_pos)\n        target_pos = parent[target_pos]\n    \n    path.reverse()\n    \n    # Translate path into actions\n    action_list = []\n    for next_pos in path[1:]:\n        dx, dy = next_pos[0] - env._current_state.pos[0], next_pos[1] - env._current_state.pos[1]\n        if (dx == 1 and dy == 0):\n            target_dir = 'RIGHT'\n        elif (dx == -1 and dy == 0):\n            target_dir = 'LEFT'\n        elif (dx == 0 and dy == 1):\n            target_dir = 'DOWN'\n        elif (dx == 0 and dy == -1):\n            target_dir = 'UP'\n        \n        # Determine the direction change needed\n        if current_dir != target_dir:\n            action_list.append(env.action_specs()[current_dir][target_dir])\n            current_dir = target_dir\n        \n        action_list.append(env.action_specs()['FORWARD'])\n    \n    actions.extend(action_list)\n\n    # Perform the USE action to craft the item\n    actions.append(env.action_specs()['USE'])\n\n  return actions", "island_id": 6, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T22:55:15.852712", "function_name": "craft", "function_body": "  actions = []\n\n  # Get the index of the desired item from the cookbook index\n  item_index = env.world.cookbook.index[item]\n\n  # Find the workshop index for crafting the item\n  workshop_index = None\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n  if \"_key\" in recipe:\n      key_workshop = recipe[\"_key\"]\n      workshop_index = env.world.workshop_indices[key_workshop]\n  \n  # Check if all ingredients are available in inventory\n  if not check_inventory(env._current_state.inventory, item_index):\n      return actions  # Return empty list if ingredients are missing\n  \n  # Move to the found workshop\n  if workshop_index is not None:\n      target_pos = find_position_of_kind(env, workshop_index)\n      actions.extend(move_to_position(env._current_state.pos, target_pos))\n      \n      # Perform the USE action to craft the item\n      actions.append(craft.USE)\n\n  return actions", "island_id": 8, "scores": {"": -1}}
{"timestamp": "2025-09-02T22:55:16.899231", "function_name": "craft", "function_body": "  actions = []\n  current_state = env._current_state\n\n  # Get the index of the desired item from the cookbook index\n  item_index = env.world.cookbook.index[item]\n\n  # Find the workshop index for crafting the item\n  workshop_index = None\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n  if \"_key\" in recipe:\n      key_workshop = recipe[\"_key\"]\n      workshop_index = env.world.workshop_indices[key_workshop]\n  \n  # Move to the found workshop if it exists\n  if workshop_index is not None:\n      target_pos = find_position_of_kind(env, workshop_index)\n      actions.extend(move_to_position(current_state.pos, target_pos))\n      \n      # Perform the USE action to craft the item\n      actions.append(craft.USE)\n\n  return actions", "island_id": 8, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T22:57:30.012436", "function_name": "craft", "function_body": "  def get_missing_ingredients(recipe):\n    required_ingredients = {k: v for k, v in recipe.items() if k != \"_key\"}\n    missing_ingredients = []\n    inventory_counts = env._current_state.inventory\n    for ingredient_index, count in required_ingredients.items():\n      if inventory_counts[ingredient_index] < count:\n        missing_ingredients.append((ingredient_index, count - inventory_counts[ingredient_index]))\n    return missing_ingredients\n\n  def move_to(env, target_pos):\n    \"\"\"Generate actions to move the agent to a target position using pathfinding logic.\"\"\"\n    def find_path(grid, start, end):\n      from collections import deque\n      directions = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n      queue = deque([start])\n      came_from = {start: None}\n      \n      while queue:\n        current = queue.popleft()\n        if current == end:\n          break\n        for direction in directions:\n          neighbor = tuple(np.add(current, direction))\n          if (0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1] and \n              np.all(grid[neighbor] == 0)):\n            queue.append(neighbor)\n            came_from[neighbor] = current\n      \n      path = []\n      while end:\n        path.append(end)\n        end = came_from[end]\n      \n      return path[::-1]\n\n    path = find_path(env._current_state.grid, env._current_state.pos, target_pos)\n    \n    actions = []\n    current_pos = env._current_state.pos\n    \n    for next_pos in path[1:]:\n      direction = tuple(np.subtract(next_pos, current_pos))\n      \n      if direction == (0, 1):\n        actions.append(env.world.cookbook.index[\"RIGHT\"])\n      elif direction == (0, -1):\n        actions.append(env.world.cookbook.index[\"LEFT\"])\n      elif direction == (1, 0):\n        actions.append(env.world.cookbook.index[\"DOWN\"])\n      elif direction == (-1, 0):\n        actions.append(env.world.cookbook.index[\"UP\"])\n      \n      current_pos = next_pos\n    \n    return actions\n\n  def collect_missing_ingredients(env, missing_ingredients) -> list[int]:\n    \"\"\"Generate actions to collect all required ingredients.\"\"\"\n    actions = []\n    for ingredient_index, count in missing_ingredients:\n      ingredient_name = env.world.cookbook.index.get(ingredient_index, \"unknown\")\n      # Collect the ingredient 'count' times\n      for _ in range(count):\n        actions.extend(collect(env, ingredient_name))\n    return actions\n\n  def collect(env, primitive) -> list[int]:\n    \"\"\"Generate actions to collect a specific primitive.\"\"\"\n    item_index = env.world.cookbook.index[primitive]\n    \n    # Find all positions of the required primitive on the grid\n    positions = np.argwhere(env._current_state.grid[:, :, item_index] > 0)\n    \n    if positions.size == 0:\n      return []\n    \n    agent_pos = env._current_state.pos\n    \n    # Calculate distances to each position and sort by distance\n    distances = np.sum(np.abs(positions - agent_pos), axis=1)\n    sorted_positions = positions[np.argsort(distances)]\n    \n    actions = []\n    \n    for pos in sorted_positions:\n      actions.extend(move_to(env, tuple(pos)))\n      \n      # Add the collect action (which is assumed to be the index of \"COLLECT\" in the cookbook)\n      collect_action_index = env.world.cookbook.index[\"COLLECT\"]\n      actions.append(collect_action_index)\n    \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n  \n  recipes = {k: v for k, v in env.world.cookbook.recipes.items() if \"_key\" in v and v[\"_key\"] == item_index}\n  \n  if not recipes:\n    return []\n\n  recipe = next(iter(recipes.values()))\n  missing_ingredients = get_missing_ingredients(recipe)\n\n  # Determine which workshop type is needed based on the ingredients\n  workshop_needed = None\n  for ingredient_index in recipe.keys():\n      kind_name = env.world.cookbook.index.get(ingredient_index, \"unknown\")\n      if kind_name.startswith(\"WORKSHOP\"):\n          workshop_needed = ingredient_index\n          break\n\n  if workshop_needed is None:\n      workshop_needed = env.world.workshop_indices[0]\n\n  workshops = np.argwhere(env._current_state.grid[:, :, workshop_needed] > 0)\n  \n  if workshops.size == 0:\n      return []\n\n  agent_pos = env._current_state.pos\n  distances = np.sum(np.abs(workshops - agent_pos), axis=1)\n  nearest_workshop = tuple(workshops[np.argmin(distances)])\n\n  actions_to_workshop = move_to(env, nearest_workshop)\n\n  use_action_index = env.world.cookbook.index[\"USE\"]\n\n  actions_to_collect = collect_missing_ingredients(env, missing_ingredients)\n\n  return actions_to_collect + actions_to_workshop + [use_action_index]", "island_id": 4, "scores": {"": 0.0}}
{"timestamp": "2025-09-02T22:57:31.052392", "function_name": "craft", "function_body": "  def get_missing_ingredients(recipe):\n    required_ingredients = {k: v for k, v in recipe.items() if k != \"_key\"}\n    missing_ingredients = []\n    inventory_counts = env._current_state.inventory\n    for ingredient_index, count in required_ingredients.items():\n      if inventory_counts[ingredient_index] < count:\n        missing_ingredients.append((ingredient_index, count - inventory_counts[ingredient_index]))\n    return missing_ingredients\n\n  def move_to(env, target_pos):\n    \"\"\"Generate actions to move the agent to a target position using pathfinding logic.\"\"\"\n    def find_path(grid, start, end):\n      from collections import deque\n      directions = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n      queue = deque([start])\n      came_from = {start: None}\n      \n      while queue:\n        current = queue.popleft()\n        if current == end:\n          break\n        for direction in directions:\n          neighbor = tuple(np.add(current, direction))\n          if (0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1] and \n              np.all(grid[neighbor] == 0)):\n            queue.append(neighbor)\n            came_from[neighbor] = current\n      \n      path = []\n      while end:\n        path.append(end)\n        end = came_from[end]\n      \n      return path[::-1]\n\n    path = find_path(env._current_state.grid, env._current_state.pos, target_pos)\n    \n    actions = []\n    current_pos = env._current_state.pos\n    \n    for next_pos in path[1:]:\n      direction = tuple(np.subtract(next_pos, current_pos))\n      \n      if direction == (0, 1):\n        actions.append(env.world.cookbook.index[\"RIGHT\"])\n      elif direction == (0, -1):\n        actions.append(env.world.cookbook.index[\"LEFT\"])\n      elif direction == (1, 0):\n        actions.append(env.world.cookbook.index[\"DOWN\"])\n      elif direction == (-1, 0):\n        actions.append(env.world.cookbook.index[\"UP\"])\n      \n      current_pos = next_pos\n    \n    return actions\n\n  def collect_missing_ingredients(env, missing_ingredients) -> list[int]:\n    \"\"\"Generate actions to collect all required ingredients.\"\"\"\n    actions = []\n    for ingredient_index, count in missing_ingredients:\n      ingredient_name = env.world.cookbook.index.get(ingredient_index, \"unknown\")\n      # Collect the ingredient 'count' times\n      for _ in range(count):\n        actions.extend(collect(env, ingredient_name))\n    return actions\n\n  def find_nearest_workshop(env, workshop_type_indices) -> tuple[int, int]:\n    agent_pos = env._current_state.pos\n    grid = env._current_state.grid\n    distances = np.inf * np.ones(grid.shape[:2])\n    \n    for index in workshop_type_indices:\n      workshops = np.argwhere(grid[:, :, index] > 0)\n      for workshop in workshops:\n        distance = np.sum(np.abs(workshop - agent_pos))\n        if distance < distances[tuple(workshop)]:\n          distances[tuple(workshop)] = distance\n    \n    nearest_workshop = np.unravel_index(np.argmin(distances), distances.shape)\n    return nearest_workshop\n\n  item_index = env.world.cookbook.index[item]\n  \n  recipes = {k: v for k, v in env.world.cookbook.recipes.items() if \"_key\" in v and v[\"_key\"] == item_index}\n  \n  if not recipes:\n    return []\n\n  recipe = next(iter(recipes.values()))\n  missing_ingredients = get_missing_ingredients(recipe)\n\n  # Determine which workshop type is needed based on the ingredients\n  workshop_needed_indices = []\n  for ingredient_index in recipe.keys():\n      kind_name = env.world.cookbook.index.get(ingredient_index, \"unknown\")\n      if kind_name.startswith(\"WORKSHOP\"):\n          workshop_needed_indices.append(ingredient_index)\n  \n  if not workshop_needed_indices:\n    workshop_needed_indices = [env.world.workshop_indices[0]]\n\n  nearest_workshop = find_nearest_workshop(env, workshop_needed_indices)\n\n  actions_to_workshop = move_to(env, nearest_workshop)\n\n  use_action_index = env.world.cookbook.index[\"USE\"]\n\n  actions_to_collect = collect_missing_ingredients(env, missing_ingredients)\n\n  return actions_to_collect + actions_to_workshop + [use_action_index]", "island_id": 4, "scores": {"": 0.0}}
