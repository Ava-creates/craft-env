me_from[tuple(current)]\n            path.reverse()\n            return [get_action(agent_pos, next_step) for next_step in path]\n        \n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            neighbor = current + np.array((dx, dy))\n            if not (0 <= neighbor[0] < grid_shape[0] and 0 <= neighbor[1] < grid_shape[1]):\n                continue\n            tentative_g_score = g_score[tuple(current)] + 1\n\n            if tuple(neighbor) not in g_score or tentative_g_score < g_score[tuple(neighbor)]:\n                came_from[tuple(neighbor)] = current\n                g_score[tuple(neighbor)] = tentative_g_score\n                f_score[tuple(neighbor)] = tentative_g_score + heuristic(neighbor, target_pos)\n                open_set.put((f_score[tuple(neighbor)], tuple(neighbor)))\n    \n    return []\n\n  def get_action(current_pos, next_step):\n      if next_step[0] > current_pos[0]:\n          return 3  # RIGHT\n      elif next_step[0] < current_pos[0]:\n          return 2  # LEFT\n      elif next_step[1] > current_pos[1]:\n          return 1  # UP\n      else:\n          return 0  # DOWN\n\n  item_index = env.world.cookbook.index[item]\n  grid_shape = env._current_state.grid.shape[:2]\n\n  workshop_index = get_closest_workshop(item_index)\n\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index])\n  if len(workshop_positions) == 0:\n      return []\n\n  closest_workshop_pos = min(workshop_positions, key=lambda pos: np.linalg.norm(np.array(pos) - np.array(env._current_state.pos)))\n  actions_to_closest_workshop = navigate_to_position(closest_workshop_pos)\n\n  actions_to_closest_workshop.append(4)  # USE to craft the item\n\n  return actions_to_closest_workshop", "island_id": 1, "scores": {"": -1}}
