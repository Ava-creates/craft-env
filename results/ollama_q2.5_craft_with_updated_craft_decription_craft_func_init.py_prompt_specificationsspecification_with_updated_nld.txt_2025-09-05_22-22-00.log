{"timestamp": "2025-09-06T17:48:49.509041", "function_name": "craft", "function_body": "  def move_to_workshop(current_pos):\n      workshops = []\n      for i, workshop_kind in enumerate(env.world.workshop_indices):\n          workshop_location = find_workshop(env._current_state.grid, workshop_kind)\n          if workshop_location:\n              workshops.append((workshop_location, i))\n      \n      if not workshops:\n          return []\n      \n      closest_workshop = min(workshops, key=lambda x: np.linalg.norm(np.array(x[0]) - np.array(current_pos)))\n      target_pos = closest_workshop[0]\n      \n      return move_to_location(current_pos, target_pos)\n\n  def find_workshop(grid, workshop_kind):\n      for i in range(grid.shape[0]):\n          for j in range(grid.shape[1]):\n              if grid[i, j, workshop_kind] == 1:\n                  return (i, j)\n      return None\n\n  def move_to_location(current_pos, target_pos):\n      actions = []\n      x_diff = target_pos[0] - current_pos[0]\n      y_diff = target_pos[1] - current_pos[1]\n\n      # Move in the direction with the larger difference first to reduce diagonal movement\n      if abs(x_diff) >= abs(y_diff):\n          if x_diff > 0:\n              actions.extend([3] * abs(x_diff))  # RIGHT\n          elif x_diff < 0:\n              actions.extend([2] * abs(x_diff))  # LEFT\n          \n          if y_diff > 0:\n              actions.extend([1] * abs(y_diff))  # UP\n          elif y_diff < 0:\n              actions.extend([0] * abs(y_diff))  # DOWN\n      else:\n          if y_diff > 0:\n              actions.extend([1] * abs(y_diff))  # UP\n          elif y_diff < 0:\n              actions.extend([0] * abs(y_diff))  # DOWN\n          \n          if x_diff > 0:\n              actions.extend([3] * abs(x_diff))  # RIGHT\n          elif x_diff < 0:\n              actions.extend([2] * abs(x_diff))  # LEFT\n      \n      return actions\n\n  def collect_primitives(env, required_primitives):\n      \"\"\"Generate actions to collect the required primitives.\"\"\"\n      actions = []\n      for primitive, count in required_primitives.items():\n          if env._current_state.inventory[primitive] < count:\n              available_locations = find_primitive_locations(env._current_state.grid, primitive)\n              while env._current_state.inventory[primitive] < count and available_locations:\n                  target_pos = available_locations.pop()\n                  actions.extend(move_to_location(env._current_state.pos, target_pos))\n                  actions.append(4)  # Collect the primitive\n      return actions\n\n  def find_primitive_locations(grid, primitive_kind):\n      \"\"\"Find all locations of a given primitive in the grid.\"\"\"\n      locations = []\n      for i in range(grid.shape[0]):\n          for j in range(grid.shape[1]):\n              if grid[i, j, primitive_kind] == 1:\n                  locations.append((i, j))\n      return locations\n\n  def check_inventory(required_primitives):\n      \"\"\"Check if all required primitives are already in inventory.\"\"\"\n      for primitive, count in required_primitives.items():\n          if env._current_state.inventory[primitive] < count:\n              return False\n      return True\n\n  actions = []\n\n  # Get the cookbook and its index mapping\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  # Get the required primitives to craft the item\n  required_primitives = cookbook.primitives_for(item_index)\n  \n  if not required_primitives:\n      return []  # No primitives needed, assume item can be crafted directly\n\n  # Check if all required primitives are already in inventory\n  if check_inventory(required_primitives):\n      actions.extend(move_to_workshop(env._current_state.pos))\n      actions.append(4)  # USE action at workshop\n      return actions\n  \n  # Collect each type of required primitive if not enough in inventory\n  for primitive, count in required_primitives.items():\n      if env._current_state.inventory[primitive] < count:\n          available_locations = find_primitive_locations(env._current_state.grid, primitive)\n          while env._current_state.inventory[primitive] < count and available_locations:\n              target_pos = available_locations.pop()\n              actions.extend(move_to_location(env._current_state.pos, target_pos))\n              actions.append(4)  # Collect the primitive\n  \n  # Move to a workshop and perform the USE action\n  actions.extend(move_to_workshop(env._current_state.pos))\n  \n  # Perform the USE action to craft the item at the workshop\n  actions.append(4)  # Assuming 4 is the action index for USE\n  \n  return actions", "island_id": 5, "scores": {"3": 5.6}}
{"timestamp": "2025-09-06T17:50:17.440979", "function_name": "craft", "function_body": "  # Convert the item name to its corresponding index\n  item_index = env.world.cookbook.index.index(item)\n  \n  if item_index is None:\n      raise ValueError(f\"Unknown item: {item}\")\n\n  # Check if we have all the primitives required for crafting the item\n  primitive_requirements = env.world.cookbook.primitives_for(item_index)\n\n  # Function to collect primitives\n  def collect_primitive(primitive):\n      actions = []\n      # Find the positions of the primitive in the grid\n      primitive_indices = np.argwhere(env._current_state.grid[:, :, primitive] == 1)\n      \n      for pos in primitive_indices:\n          x, y = pos\n          dx, dy = x - env._current_state.pos[0], y - env._current_state.pos[1]\n          \n          # Calculate direction needed to reach the position\n          if dx > 0:\n              actions.extend([craft.DOWN] * abs(dx))\n          elif dx < 0:\n              actions.extend([craft.UP] * abs(dx))\n          if dy > 0:\n              actions.extend([craft.RIGHT] * abs(dy))\n          elif dy < 0:\n              actions.extend([craft.LEFT] * abs(dy))\n          \n          # Collect the primitive\n          actions.append(craft.USE)\n      return actions\n\n  # Collect all required primitives\n  all_actions = []\n  for primitive, count in primitive_requirements.items():\n      all_actions.extend(collect_primitive(primitive) * count)\n\n  # Find a workshop to craft the item\n  workshops = [i for i, idx in enumerate(env.world.workshop_indices) if idx == env.world.cookbook.recipes[item_index][\"_key\"]]\n  \n  if not workshops:\n      raise ValueError(f\"No suitable workshop found for crafting {item}\")\n\n  # Go to one of the available workshops and use it\n  x, y = env.world.scenario.init_grid.shape[:2]\n  for workshop in workshops:\n      wx, wy = workshop // x, workshop % y\n      \n      dx, dy = wx - env._current_state.pos[0], wy - env._current_state.pos[1]\n      \n      if dx > 0:\n          all_actions.extend([craft.DOWN] * abs(dx))\n      elif dx < 0:\n          all_actions.extend([craft.UP] * abs(dx))\n      if dy > 0:\n          all_actions.extend([craft.RIGHT] * abs(dy))\n      elif dy < 0:\n          all_actions.extend([craft.LEFT] * abs(dy))\n      \n      # Use the workshop to craft\n      all_actions.append(craft.USE)\n  \n  return all_actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-06T17:50:18.430741", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the goal is known and achievable\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"Unknown or unachievable goal: {item}\")\n\n  # Fetch the primitives required for crafting the item\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  \n  # Check if all required primitives are already in the inventory\n  missing_primitives = []\n  for primitive, count in primitives_needed.items():\n    if env._current_state.inventory[primitive] < count:\n      missing_primitives.append((primitive, count))\n      \n  actions = []\n\n  if missing_primitives:\n    # Collect missing primitives\n    for primitive_index, required_count in missing_primitives:\n      primitive_name = env.world.cookbook.index.get(primitive_index)\n      # Find positions of the primitive in the grid\n      positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(positions) == 0:\n        raise ValueError(f\"Primitives '{primitive_name}' not found on the map\")\n        \n      for _ in range(required_count):\n        # Move to each position and collect\n        for pos in positions:\n          actions.extend(move_to_position(env._current_state, (pos[1], pos[0])))\n          actions.append(craft.COLLECT_FUNC(primitive_index))\n          \n    return actions\n  \n  # If all primitives are already available, go to the workshop and craft the item\n  # Assuming that the first workshop is used for crafting (this can be refined)\n  workshop_index = env.world.workshop_indices[0]\n  positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n  if len(positions) == 0:\n    raise ValueError(\"No workshops found on the map\")\n    \n  # Move to the first available workshop\n  actions.extend(move_to_position(env._current_state, (positions[0][1], positions[0][0])))\n  \n  # Craft the item\n  actions.append(craft.USE_FUNC(item_index))\n  \n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-06T17:52:54.031032", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, workshop_indices):\n    current_pos = env._current_state.pos\n    closest_position = None\n    min_distance = float('inf')\n    \n    for workshop_kind in workshop_indices:\n      positions = []\n      for i in range(grid.shape[0]):\n        for j in range(grid.shape[1]):\n          if grid[i, j, workshop_kind] == 1:\n            positions.append((i, j))\n      \n      # Find the closest workshop of this kind\n      for pos in positions:\n        distance = np.linalg.norm(np.array(pos) - np.array(current_pos))\n        if distance < min_distance:\n          min_distance = distance\n          closest_position = pos\n    \n    return closest_position\n\n  def move_to_location(current_pos, target_pos):\n    actions = []\n    x_diff = target_pos[0] - current_pos[0]\n    y_diff = target_pos[1] - current_pos[1]\n\n    # Move in the y-direction first to avoid getting stuck in corners\n    if y_diff > 0:\n        actions.extend([1] * abs(y_diff))  # UP\n    elif y_diff < 0:\n        actions.extend([0] * abs(y_diff))  # DOWN\n\n    # Move in the x-direction\n    if x_diff > 0:\n        actions.extend([3] * abs(x_diff))  # RIGHT\n    elif x_diff < 0:\n        actions.extend([2] * abs(x_diff))  # LEFT\n    \n    return actions\n\n  def collect_primitives(primitive_index, count):\n    actions = []\n    grid = env._current_state.grid\n    primitive_positions = []\n\n    # Find all positions of the required primitive in the grid\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if grid[i, j, primitive_index] == 1:\n          primitive_positions.append((i, j))\n    \n    if not primitive_positions:\n      return []  # No primitives found\n    \n    current_pos = env._current_state.pos\n\n    # Move to each primitive position and collect it\n    for pos in primitive_positions[:count]:  # Limit collection to required count\n      actions.extend(move_to_location(current_pos, pos))\n      actions.append(4)  # Assuming 4 is the action index for USE\n      current_pos = pos\n    \n    return actions\n\n  def check_workshop_recipe(workshop_index):\n    # This function should be implemented to verify that the workshop at the given index can craft the item with the provided recipe.\n    # For simplicity, this implementation assumes it can always find a recipe if a workshop exists.\n    return True\n\n  actions = []\n  \n  # Get the cookbook and its index mapping\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  # Get the required primitives to craft the item\n  required_primitives = cookbook.primitives_for(item_index)\n  \n  # Collect all the required primitives\n  for primitive, count in required_primitives.items():\n    if env._current_state.inventory[primitive] < count:\n      actions.extend(collect_primitives(primitive, count))\n  \n  # Find closest workshop that can craft the item\n  current_pos = env._current_state.pos\n  recipe = cookbook.primitives_for(item_index)\n  workshop_location = find_closest_workshop(env._current_state.grid, env.world.workshop_indices)\n  \n  if workshop_location is not None:\n      actions.extend(move_to_location(current_pos, workshop_location))\n      actions.append(4)  # Assuming 4 is the action index for USE\n  else:\n      return []  # No suitable workshop found\n  \n  return actions", "island_id": 2, "scores": {"3": 4.6}}
{"timestamp": "2025-09-06T17:52:55.161429", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, workshop_indices):\n    current_pos = env._current_state.pos\n    closest_position = None\n    min_distance = float('inf')\n    \n    for workshop_kind in workshop_indices:\n      positions = []\n      for i in range(grid.shape[0]):\n        for j in range(grid.shape[1]):\n          if grid[i, j, workshop_kind] == 1:\n            positions.append((i, j))\n      \n      # Find the closest workshop of this kind\n      for pos in positions:\n        distance = np.linalg.norm(np.array(pos) - np.array(current_pos))\n        if distance < min_distance:\n          min_distance = distance\n          closest_position = pos\n    \n    return closest_position\n\n  def move_to_location(current_pos, target_pos):\n    actions = []\n    x_diff = target_pos[0] - current_pos[0]\n    y_diff = target_pos[1] - current_pos[1]\n\n    # Move in the x-direction\n    if x_diff > 0:\n        actions.extend([3] * abs(x_diff))  # RIGHT\n    elif x_diff < 0:\n        actions.extend([2] * abs(x_diff))  # LEFT\n\n    # Move in the y-direction\n    if y_diff > 0:\n        actions.extend([1] * abs(y_diff))  # UP\n    elif y_diff < 0:\n        actions.extend([0] * abs(y_diff))  # DOWN\n    \n    return actions\n\n  def collect_primitives(primitive_index, count):\n    actions = []\n    grid = env._current_state.grid\n    primitive_positions = []\n\n    # Find all positions of the required primitive in the grid\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if grid[i, j, primitive_index] == 1:\n          primitive_positions.append((i, j))\n    \n    if not primitive_positions:\n      return []  # No primitives found\n    \n    current_pos = env._current_state.pos\n\n    # Move to each primitive position and collect it\n    for pos in primitive_positions[:count]:  # Limit collection to required count\n      actions.extend(move_to_location(current_pos, pos))\n      actions.append(4)  # Assuming 4 is the action index for USE\n      current_pos = pos\n    \n    return actions\n\n  def check_workshop_capability(workshop_index, item_index):\n    cookbook = env.world.cookbook\n    if \"_key\" in cookbook.primitives_for(item_index):\n        key_required = cookbook.primitives_for(item_index)[\"_key\"]\n        if env._current_state.inventory[key_required] < 1:\n            return False\n    \n    for primitive, count in cookbook.primitives_for(item_index).items():\n        if primitive != \"_key\" and count > 0:\n            return True\n    return False\n\n  actions = []\n  \n  # Get the cookbook and its index mapping\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  # Get the required primitives to craft the item\n  required_primitives = cookbook.primitives_for(item_index)\n  \n  # Collect all the required primitives\n  for primitive, count in required_primitives.items():\n    if primitive == \"_key\":\n        continue\n    if env._current_state.inventory[primitive] < count:\n      actions.extend(collect_primitives(primitive, count))\n  \n  # Check if any workshop can craft the item with available resources\n  current_pos = env._current_state.pos\n  found_workshop = False\n  for workshop_kind in env.world.workshop_indices:\n    workshop_location = find_closest_workshop(env._current_state.grid, [workshop_kind])\n    if workshop_location is not None and check_workshop_capability(workshop_kind, item_index):\n      actions.extend(move_to_location(current_pos, workshop_location))\n      actions.append(4)  # Assuming 4 is the action index for USE\n      found_workshop = True\n      break\n  \n  if not found_workshop:\n    return []  # No suitable workshop found or required primitives missing\n\n  return actions", "island_id": 2, "scores": {"3": 5.6}}
{"timestamp": "2025-09-06T17:55:39.784060", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, workshop_kind):\n    positions = []\n    current_pos = env._current_state.pos\n    \n    # Collect all positions of the specified workshop kind\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if grid[i, j, workshop_kind] == 1:\n          positions.append((i, j))\n    \n    if not positions:\n      return None\n    \n    # Find the closest workshop to the current position\n    closest_position = min(positions, key=lambda x: np.linalg.norm(np.array(x) - np.array(current_pos)))\n    return closest_position\n\n  def move_to_location(current_pos, target_pos):\n    actions = []\n    x_diff = target_pos[0] - current_pos[0]\n    y_diff = target_pos[1] - current_pos[1]\n\n    # Determine direction of movement in the x-direction\n    if x_diff > 0:\n        actions.extend([3] * abs(x_diff))  # RIGHT\n    elif x_diff < 0:\n        actions.extend([2] * abs(x_diff))  # LEFT\n\n    # Determine direction of movement in the y-direction\n    if y_diff > 0:\n        actions.extend([1] * abs(y_diff))  # UP\n    elif y_diff < 0:\n        actions.extend([0] * abs(y_diff))  # DOWN\n    \n    return actions\n\n  def collect_primitives(primitive_index, count):\n    actions = []\n    grid = env._current_state.grid\n    primitive_positions = []\n\n    # Collect all positions of the specified primitive in the grid\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if grid[i, j, primitive_index] == 1:\n          primitive_positions.append((i, j))\n    \n    current_pos = env._current_state.pos\n\n    # Collect enough primitives to meet the required count\n    collected_count = 0\n    for pos in primitive_positions:\n      actions.extend(move_to_location(current_pos, pos))\n      actions.append(4)  # Assuming 4 is the action index for USE\n      current_pos = pos\n      collected_count += 1\n      \n      if collected_count >= count:\n        break\n    \n    return actions\n\n  def find_workshop_with_recipe(grid, recipe):\n    workshops = env.world.workshop_indices\n    current_pos = env._current_state.pos\n    \n    # Check each workshop to see if it can craft the item\n    for i in range(len(workshops)):\n      workshop_location = find_closest_workshop(grid, workshops[i])\n      if workshop_location:\n        return (workshop_location, i)\n    \n    return None\n\n  actions = []\n  \n  # Get the cookbook and its index mapping\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  # Get the required primitives to craft the item\n  required_primitives = cookbook.primitives_for(item_index)\n  \n  # Collect all the required primitives\n  for primitive, count in required_primitives.items():\n    if env._current_state.inventory[primitive] < count:\n      actions.extend(collect_primitives(primitive, count))\n  \n  # Find a workshop that can craft the item and move to it\n  recipe = cookbook.primitives_for(item_index)\n  workshop_info = find_workshop_with_recipe(env._current_state.grid, recipe)\n  if workshop_info is not None:\n    target_pos, _ = workshop_info\n    actions.extend(move_to_location(env._current_state.pos, target_pos))\n  \n  # Perform the USE action to craft the item at the workshop\n  actions.append(4)  # Assuming 4 is the action index for USE\n  \n  return actions", "island_id": 2, "scores": {"3": 5.6}}
{"timestamp": "2025-09-06T17:55:40.763627", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, workshop_kind):\n    positions = []\n    current_pos = env._current_state.pos\n    \n    # Collect all positions of the specified workshop kind\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if grid[i, j, workshop_kind] == 1:\n          positions.append((i, j))\n    \n    # Find the closest workshop to the current position\n    closest_position = min(positions, key=lambda x: np.linalg.norm(np.array(x) - np.array(current_pos)))\n    return closest_position\n\n  def move_to_location(current_pos, target_pos):\n    actions = []\n    x_diff = target_pos[0] - current_pos[0]\n    y_diff = target_pos[1] - current_pos[1]\n\n    # Move in the y-direction first to avoid obstacles\n    if y_diff > 0:\n        actions.extend([1] * abs(y_diff))  # UP\n    elif y_diff < 0:\n        actions.extend([0] * abs(y_diff))  # DOWN\n\n    # Then move in the x-direction\n    if x_diff > 0:\n        actions.extend([3] * abs(x_diff))  # RIGHT\n    elif x_diff < 0:\n        actions.extend([2] * abs(x_diff))  # LEFT\n    \n    return actions\n\n  def collect_primitives(primitive_index, count):\n    actions = []\n    grid = env._current_state.grid\n    primitive_positions = []\n\n    # Find all positions of the required primitive in the grid\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if grid[i, j, primitive_index] == 1:\n          primitive_positions.append((i, j))\n    \n    if not primitive_positions:\n      return []  # No primitives found\n    \n    current_pos = env._current_state.pos\n\n    # Move to each primitive position and collect it\n    for pos in primitive_positions[:count]:  # Limit collection to required count\n      actions.extend(move_to_location(current_pos, pos))\n      actions.append(4)  # Assuming 4 is the action index for USE\n      current_pos = pos\n    \n    return actions\n\n  def find_workshop_with_recipe(grid, recipe):\n    workshops = env.world.workshop_indices\n    closest_workshops = []\n\n    for workshop_kind in workshops:\n        workshop_location = find_closest_workshop(env._current_state.grid, workshop_kind)\n        if workshop_location:\n            closest_workshops.append((workshop_location, workshop_kind))\n    \n    # Check if any of the found workshops have the required recipe\n    for location, kind in closest_workshops:\n      if check_workshop_recipe(location, recipe):\n          return (location, kind)\n    \n    return None\n\n  def check_workshop_recipe(workshop_location, recipe):\n      # This function should be implemented to verify that the workshop at the given location can craft the item with the provided recipe.\n      # For simplicity, this implementation assumes it can always find a recipe if a workshop exists.\n      return True\n\n  actions = []\n  \n  # Get the cookbook and its index mapping\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  # Get the required primitives to craft the item\n  required_primitives = cookbook.primitives_for(item_index)\n  \n  # Collect all the required primitives\n  for primitive, count in required_primitives.items():\n    if env._current_state.inventory[primitive] < count:\n      actions.extend(collect_primitives(primitive, count))\n  \n  # Find a workshop that can craft the item\n  current_pos = env._current_state.pos\n  recipe = cookbook.primitives_for(item_index)\n  workshop_info = find_workshop_with_recipe(env._current_state.grid, recipe)\n  \n  if workshop_info:\n      location, kind = workshop_info\n      actions.extend(move_to_location(current_pos, location))\n      actions.append(4)  # Assuming 4 is the action index for USE\n  else:\n      return []  # No suitable workshop found\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-06T17:56:33.909024", "function_name": "craft", "function_body": "  index = env.world.cookbook.index.get(item)\n  \n  if index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  primitives_needed = env.world.cookbook.primitives_for(index)\n  actions = []\n\n  for primitive, count in primitives_needed.items():\n    primitive_name = env.world.cookbook.index.get(primitive)\n    for _ in range(count):\n      actions.extend(collect(env, primitive_name))\n\n  # Find the workshop location\n  workshop_index = None\n  for workshop in env.world.workshop_indices:\n    if index in env.world.cookbook.recipes[workshop].get(\"_key\", []):\n      workshop_index = workshop\n      break\n\n  if workshop_index is None:\n    raise ValueError(f\"No workshop found to craft {item}\")\n\n  # Convert workshop index to a position on the grid\n  workshop_name = env.world.cookbook.index.get(workshop_index)\n  workshop_position = find_workshop_position(env, workshop_name)\n\n  if workshop_position is None:\n    raise ValueError(f\"Workshop for {item} not found in the environment\")\n\n  actions.extend(navigate_to(env, workshop_position))\n  actions.append(USE)\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-06T17:56:34.900207", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index for the desired item using the cookbook\n  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the primitives required to craft this item\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  inventory_dict = {env.world.cookbook.get(i): count for i, count in enumerate(env._current_state.inventory)}\n\n  # Collecting missing primitives\n  for primitive, needed_count in primitives_needed.items():\n    if inventory_dict.get(env.world.cookbook.get(primitive), 0) < needed_count:\n      # Collect the missing primitives\n      collect_actions = collect_v2(env, env.world.cookbook.get(primitive))\n      actions.extend(collect_actions)\n\n  # Craft the item by going to the workshop and using it\n  workshop_index = None\n\n  # Check if there are any workshops in the environment that can be used for crafting this item\n  for workshop in env.world.workshop_indices:\n    if workshop in primitives_needed:\n      workshop_index = workshop\n      break\n\n  if workshop_index is not None:\n    # Find the position of the closest workshop and move to it\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    closest_workshop_position = min(workshop_positions, key=lambda pos: np.linalg.norm(np.array(pos) - np.array(env._current_state.pos)))\n    \n    # Calculate the actions needed to reach the closest workshop\n    move_actions = move_to_target(env, tuple(closest_workshop_position))\n    actions.extend(move_actions)\n    \n    # Use the workshop to craft the item\n    actions.append(4)  # Action index for USE\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-06T17:59:06.776312", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, workshop_indices):\n    current_pos = env._current_state.pos\n    closest_workshop = None\n    min_distance = float('inf')\n    \n    for i, workshop_kind in enumerate(workshop_indices):\n      positions = np.argwhere(grid[:, :, workshop_kind] == 1)\n      \n      if positions.size > 0:\n        distances = np.linalg.norm(positions - current_pos, axis=1)\n        closest_position = tuple(positions[np.argmin(distances)])\n        \n        distance = np.min(distances)\n        if distance < min_distance:\n          min_distance = distance\n          closest_workshop = (closest_position, i)\n    \n    return closest_workshop\n\n  def move_to_location(current_pos, target_pos):\n    actions = []\n    x_diff = target_pos[0] - current_pos[0]\n    y_diff = target_pos[1] - current_pos[1]\n\n    # Move in the x-direction\n    if x_diff > 0:\n        actions.extend([3] * abs(x_diff))  # RIGHT\n    elif x_diff < 0:\n        actions.extend([2] * abs(x_diff))  # LEFT\n\n    # Move in the y-direction\n    if y_diff > 0:\n        actions.extend([1] * abs(y_diff))  # UP\n    elif y_diff < 0:\n        actions.extend([0] * abs(y_diff))  # DOWN\n    \n    return actions\n\n  def collect_primitives(primitive_index):\n    grid = env._current_state.grid\n    positions = np.argwhere(grid[:, :, primitive_index] == 1)\n    \n    if positions.size == 0:\n      return []  # No primitives found\n    \n    current_pos = env._current_state.pos\n    actions = []\n    \n    for pos in positions:\n      actions.extend(move_to_location(current_pos, tuple(pos)))\n      actions.append(4)  # Assuming 4 is the action index for USE\n      current_pos = tuple(pos)\n    \n    return actions\n\n  def check_inventory(item_index):\n    cookbook = env.world.cookbook\n    required_primitives = cookbook.primitives_for(item_index)\n    inventory = env._current_state.inventory\n    \n    for primitive, count in required_primitives.items():\n      if inventory[primitive] < count:\n        return False\n    return True\n\n  def update_inventory(action, item_index):\n    current_state = env._current_state\n    if action == 4:  # USE action\n      cookbook = env.world.cookbook\n      required_primitives = cookbook.primitives_for(item_index)\n      \n      for primitive, count in required_primitives.items():\n        current_state.inventory[primitive] -= count\n      \n      current_state.inventory[item_index] += 1\n\n  actions = []\n  \n  # Get the cookbook and its index mapping\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  if not check_inventory(item_index):\n    required_primitives = cookbook.primitives_for(item_index)\n    \n    for primitive, count in required_primitives.items():\n      current_count = env._current_state.inventory[primitive]\n      needed = count - current_count\n      \n      if needed > 0:\n        actions.extend(collect_primitives(primitive))\n  \n  # Move to the closest workshop\n  closest_workshop = find_closest_workshop(env._current_state.grid, env.world.workshop_indices)\n  if closest_workshop:\n    target_pos, _ = closest_workshop\n    actions.extend(move_to_location(env._current_state.pos, target_pos))\n    actions.append(4)  # USE action to craft the item\n  \n  update_inventory(actions[-1], item_index)\n  \n  return actions", "island_id": 6, "scores": {"3": 5.7999997}}
{"timestamp": "2025-09-06T17:59:07.833246", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, workshop_kind):\n    positions = []\n    current_pos = env._current_state.pos\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if grid[i, j, workshop_kind] == 1:\n          positions.append((i, j))\n    \n    # Find the closest workshop using Euclidean distance\n    if not positions:\n      return None\n    \n    closest_position = min(positions, key=lambda x: np.linalg.norm(np.array(x) - np.array(current_pos)))\n    return closest_position\n\n  def move_to_location(current_pos, target_pos):\n    actions = []\n    x_diff = target_pos[0] - current_pos[0]\n    y_diff = target_pos[1] - current_pos[1]\n\n    # Move in the y-direction\n    if y_diff > 0:\n        actions.extend([1] * abs(y_diff))  # UP\n    elif y_diff < 0:\n        actions.extend([0] * abs(y_diff))  # DOWN\n\n    # Move in the x-direction\n    if x_diff > 0:\n        actions.extend([3] * abs(x_diff))  # RIGHT\n    elif x_diff < 0:\n        actions.extend([2] * abs(x_diff))  # LEFT\n    \n    return actions\n\n  def move_to_workshop(grid):\n    workshops = []\n    for i, workshop_kind in enumerate(env.world.workshop_indices):\n      workshop_location = find_closest_workshop(grid, workshop_kind)\n      if workshop_location:\n        workshops.append((workshop_location, i))\n    \n    # Find the closest workshop to the current position\n    if not workshops:\n      return []  # No workshops found\n    \n    closest_workshop = min(workshops, key=lambda x: np.linalg.norm(np.array(x[0]) - np.array(env._current_state.pos)))\n    target_pos = closest_workshop[0]\n    \n    # Generate actions to move from current position to the workshop\n    return move_to_location(env._current_state.pos, target_pos)\n\n  def collect_primitives(primitive_index):\n    actions = []\n    grid = env._current_state.grid\n    primitive_positions = []\n\n    # Find all positions of the required primitive in the grid\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if grid[i, j, primitive_index] == 1:\n          primitive_positions.append((i, j))\n    \n    if not primitive_positions:\n      return []  # No primitives found\n    \n    current_pos = env._current_state.pos\n\n    # Move to each primitive position and collect it\n    for pos in primitive_positions:\n      actions.extend(move_to_location(current_pos, pos))\n      actions.append(4)  # Assuming 4 is the action index for USE\n      current_pos = pos\n    \n    return actions\n\n  def check_inventory(item_index):\n    cookbook = env.world.cookbook\n    required_primitives = cookbook.primitives_for(item_index)\n    inventory = env._current_state.inventory\n    \n    # Check if all primitives are available in sufficient quantities\n    for primitive, count in required_primitives.items():\n      if inventory[primitive] < count:\n        return False\n    return True\n\n  def update_inventory(action):\n    current_state = env._current_state\n    if action == 4:  # USE action\n      cookbook = env.world.cookbook\n      item_index = cookbook.index[item]\n      required_primitives = cookbook.primitives_for(item_index)\n      \n      for primitive, count in required_primitives.items():\n        current_state.inventory[primitive] -= count\n      \n      # Add the crafted item to inventory\n      current_state.inventory[item_index] += 1\n\n  actions = []\n  \n  # Get the cookbook and its index mapping\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  # Check if all primitives are available in sufficient quantities\n  if not check_inventory(item_index):\n      required_primitives = cookbook.primitives_for(item_index)\n      \n      # Collect all the required primitives\n      for primitive, count in required_primitives.items():\n          current_count = env._current_state.inventory[primitive]\n          needed = count - current_count\n          \n          if needed > 0:\n              actions.extend(collect_primitives(primitive))\n  \n  # Move to a workshop and perform the USE action\n  grid = env._current_state.grid\n  actions.extend(move_to_workshop(grid))\n  \n  # Perform the USE action to craft the item at the workshop\n  actions.append(4)  # Assuming 4 is the action index for USE\n  \n  # Update inventory after crafting (simulated here)\n  update_inventory(actions[-1])\n  \n  return actions", "island_id": 6, "scores": {"3": 5.7999997}}
{"timestamp": "2025-09-06T18:01:57.917670", "function_name": "craft", "function_body": "  def move_to_workshop(current_pos):\n      workshops = []\n      for i, workshop_kind in enumerate(env.world.workshop_indices):\n          workshop_location = find_workshop(env._current_state.grid, workshop_kind)\n          if workshop_location:\n              workshops.append((workshop_location, i))\n      \n      if not workshops:\n          return []\n      \n      closest_workshop = min(workshops, key=lambda x: np.linalg.norm(np.array(x[0]) - np.array(current_pos)))\n      target_pos = closest_workshop[0]\n      \n      return move_to_location(current_pos, target_pos)\n\n  def find_workshop(grid, workshop_kind):\n      for i in range(grid.shape[0]):\n          for j in range(grid.shape[1]):\n              if grid[i, j, workshop_kind] == 1:\n                  return (i, j)\n      return None\n\n  def move_to_location(current_pos, target_pos):\n      actions = []\n      x_diff = target_pos[0] - current_pos[0]\n      y_diff = target_pos[1] - current_pos[1]\n\n      if x_diff > 0:\n          actions.extend([3] * abs(x_diff))  # RIGHT\n      elif x_diff < 0:\n          actions.extend([2] * abs(x_diff))  # LEFT\n\n      if y_diff > 0:\n          actions.extend([1] * abs(y_diff))  # UP\n      elif y_diff < 0:\n          actions.extend([0] * abs(y_diff))  # DOWN\n      \n      return actions\n\n  def collect_primitives(env, required_primitives):\n      \"\"\"Generate actions to collect the required primitives.\"\"\"\n      actions = []\n      for primitive, count in required_primitives.items():\n          if env._current_state.inventory[primitive] < count:\n              available_locations = find_primitive_locations(env._current_state.grid, primitive)\n              while env._current_state.inventory[primitive] < count and available_locations:\n                  target_pos = available_locations.pop()\n                  actions.extend(move_to_location(env._current_state.pos, target_pos))\n                  actions.append(4)  # Collect the primitive\n      return actions\n\n  def find_primitive_locations(grid, primitive_kind):\n      \"\"\"Find all locations of a given primitive in the grid.\"\"\"\n      locations = []\n      for i in range(grid.shape[0]):\n          for j in range(grid.shape[1]):\n              if grid[i, j, primitive_kind] == 1:\n                  locations.append((i, j))\n      return locations\n\n  def check_inventory(required_primitives):\n      \"\"\"Check if all required primitives are already in inventory.\"\"\"\n      for primitive, count in required_primitives.items():\n          if env._current_state.inventory[primitive] < count:\n              return False\n      return True\n\n  actions = []\n\n  # Get the cookbook and its index mapping\n  cookbook = env.world.cookbook\n  \n  # Check if item is in the index\n  if item not in cookbook.index:\n      raise ValueError(f\"Item {item} not found in cookbook.\")\n  \n  item_index = cookbook.index[item]\n  \n  # Get the required primitives to craft the item\n  required_primitives = cookbook.primitives_for(item_index)\n  \n  if not required_primitives:\n      return []  # No primitives needed, assume item can be crafted directly\n\n  # Check if all required primitives are already in inventory\n  if check_inventory(required_primitives):\n      actions.extend(move_to_workshop(env._current_state.pos))\n      actions.append(4)  # USE action at workshop\n      return actions\n  \n  # Collect each type of required primitive if not enough in inventory\n  for primitive, count in required_primitives.items():\n      if env._current_state.inventory[primitive] < count:\n          available_locations = find_primitive_locations(env._current_state.grid, primitive)\n          while env._current_state.inventory[primitive] < count and available_locations:\n              target_pos = available_locations.pop()\n              actions.extend(move_to_location(env._current_state.pos, target_pos))\n              actions.append(4)  # Collect the primitive\n  \n  # Move to a workshop and perform the USE action\n  actions.extend(move_to_workshop(env._current_state.pos))\n  \n  # Perform the USE action to craft the item at the workshop\n  actions.append(4)  # Assuming 4 is the action index for USE\n  \n  return actions", "island_id": 5, "scores": {"3": 5.6}}
