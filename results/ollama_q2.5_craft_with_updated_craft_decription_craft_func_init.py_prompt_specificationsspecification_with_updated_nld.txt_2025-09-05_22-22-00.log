   actions.extend(move_to_location(env._current_state.pos, target_pos))\n                  actions.append(4)  # Collect the primitive\n      return actions\n\n  def find_primitive_locations(grid, primitive_kind):\n      \"\"\"Find all locations of a given primitive in the grid.\"\"\"\n      locations = []\n      for i in range(grid.shape[0]):\n          for j in range(grid.shape[1]):\n              if grid[i, j, primitive_kind] == 1:\n                  locations.append((i, j))\n      return locations\n\n  def check_inventory(env, required_primitives):\n      \"\"\"Check if the inventory has all required primitives.\"\"\"\n      for primitive, count in required_primitives.items():\n          if env._current_state.inventory[primitive] < count:\n              return False\n      return True\n\n  actions = []\n\n  # Get the cookbook and its index mapping\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  # Get the required primitives to craft the item\n  required_primitives = cookbook.primitives_for(item_index)\n  \n  # Check if all required primitives are in inventory\n  if not check_inventory(env, required_primitives):\n      # Collect the required primitives if not enough in inventory\n      actions.extend(collect_primitives(env, required_primitives))\n  \n  # Move to a workshop and perform the USE action\n  actions.extend(move_to_workshop(env._current_state.pos))\n  \n  # Perform the USE action to craft the item at the workshop\n  actions.append(4)  # Assuming 4 is the action index for USE\n  \n  return actions", "island_id": 4, "scores": {"3": 5.6}}
