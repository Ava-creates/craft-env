pos))\n                  actions.append(4)  # Collect the primitive\n      return actions\n\n  def find_primitive_locations(grid, primitive_kind):\n      \"\"\"Find all locations of a given primitive in the grid.\"\"\"\n      locations = []\n      for i in range(grid.shape[0]):\n          for j in range(grid.shape[1]):\n              if grid[i, j, primitive_kind] == 1:\n                  locations.append((i, j))\n      return locations\n\n  actions = []\n\n  # Get the cookbook and its index mapping\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  # Check if the item is already in inventory\n  if env._current_state.inventory[item_index] > 0:\n      return []  # No need to craft\n\n  # Get the required primitives to craft the item\n  required_primitives = cookbook.primitives_for(item_index)\n  \n  # Collect the required primitives if not enough in inventory\n  actions.extend(collect_primitives(env, required_primitives))\n  \n  # Move to a workshop and perform the USE action\n  actions.extend(move_to_workshop(env._current_state.pos))\n  \n  # Perform the USE action to craft the item at the workshop\n  actions.append(4)  # Assuming 4 is the action index for USE\n  \n  return actions", "island_id": 8, "scores": {"3": 5.6}}
{"timestamp": "2025-09-06T17:08:53.314160", "function_name": "craft", "function_body": "  actions = []\n\n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n\n  if item_index is None:\n      return []  # Item not found in cookbook\n\n  # Check if we have all primitives required for crafting\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n\n  inventory = env._current_state.inventory\n\n  # Check if the agent has all the required primitives\n  for primitive, count in primitives_needed.items():\n      if inventory[primitive] < count:\n          return []  # Missing primitives to craft item\n\n  # Find a workshop with the required recipe\n  workshops = env.world.workshop_indices\n  found_workshop = None\n  for workshop_index in workshops:\n      recipe = env.world.cookbook.recipes.get(workshop_index)\n      if recipe and recipe.get(item_index, 0) > 0:\n          found_workshop = workshop_index\n          break\n\n  if not found_workshop:\n      return []  # No suitable workshop found\n\n  # Move to the workshop\n  target_pos = env.world.cookbook.index.get(found_workshop)\n  current_pos = env._current_state.pos\n\n  path_to_workshop = find_path(env, current_pos, target_pos)\n\n  if not path_to_workshop:\n      return []  # No path to workshop found\n\n  actions.extend(path_to_workshop)\n\n  # Perform the crafting action\n  actions.append(env.world.cookbook.index['USE'])\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T17:08:54.286676", "function_name": "craft", "function_body": "  # Get the index of the item to craft\n  i_item = env.world.cookbook.index[item]\n  \n  # Check if we have all primitives needed for crafting\n  required_primitives = env.world.cookbook.primitives_for(i_item)\n  inventory = env._current_state.inventory\n  \n  # Collect missing primitives\n  actions_to_take = []\n  for primitive, count in required_primitives.items():\n    while np.sum(inventory[primitive]) < count:\n      actions_to_take.extend(collect(env, env.world.cookbook.index.get(primitive)))\n  \n  # Check if all primitives are collected\n  if not all(np.sum(inventory[p]) >= c for p, c in required_primitives.items()):\n    return []  # Return empty list if we can't collect all needed primitives\n  \n  # Find a workshop that can craft the item\n  recipes = env.world.cookbook.recipes[i_item]\n  workshop_indices = [k for k, v in recipes.items() if \"_key\" not in v and v != -1]\n  \n  if not workshop_indices:\n    return []  # Return empty list if no valid workshop is found\n  \n  # Move to a workshop\n  workshop_index = workshop_indices[0]  # Choose the first available workshop\n  workshop_pos = env.world.workshop_indices[workshop_index]\n  \n  # Find path to the workshop\n  path_to_workshop = find_path(env._current_state.grid, env._current_state.pos, workshop_pos)\n  actions_to_take.extend([DIRECTIONS[dir] for dir in path_to_workshop])\n  \n  # Craft the item at the workshop (USE action)\n  actions_to_take.append(USE_ACTION)\n  \n  return actions_to_take", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-06T17:11:03.714438", "function_name": "craft", "function_body": "  def move_to_workshop(current_pos):\n      workshops = []\n      for i, workshop_kind in enumerate(env.world.workshop_indices):\n          workshop_location = find_workshop(env._current_state.grid, workshop_kind)\n          if workshop_location:\n              workshops.append((workshop_location, i))\n      \n      if not workshops:\n          return []\n      \n      closest_workshop = min(workshops, key=lambda x: np.linalg.norm(np.array(x[0]) - np.array(current_pos)))\n      target_pos = closest_workshop[0]\n      \n      return move_to_location(current_pos, target_pos)\n\n  def find_workshop(grid, workshop_kind):\n      for i in range(grid.shape[0]):\n          for j in range(grid.shape[1]):\n              if grid[i, j, workshop_kind] == 1:\n                  return (i, j)\n      return None\n\n  def move_to_location(current_pos, target_pos):\n      actions = []\n      x_diff = target_pos[0] - current_pos[0]\n      y_diff = target_pos[1] - current_pos[1]\n\n      if x_diff > 0:\n          actions.extend([3] * abs(x_diff))  # RIGHT\n      elif x_diff < 0:\n          actions.extend([2] * abs(x_diff))  # LEFT\n\n      if y_diff > 0:\n          actions.extend([1] * abs(y_diff))  # UP\n      elif y_diff < 0:\n          actions.extend([0] * abs(y_diff))  # DOWN\n      \n      return actions\n\n  def collect_primitives(env, required_primitives):\n      \"\"\"Generate actions to collect the required primitives.\"\"\"\n      actions = []\n      for primitive, count in required_primitives.items():\n          if env._current_state.inventory[primitive] < count:\n              available_locations = find_primitive_locations(env._current_state.grid, primitive)\n              while env._current_state.inventory[primitive] < count and available_locations:\n                  target_pos = available_locations.pop()\n                  actions.extend(move_to_location(env._current_state.pos, target_pos))\n                  actions.append(4)  # Collect the primitive\n      return actions\n\n  def find_primitive_locations(grid, primitive_kind):\n      \"\"\"Find all locations of a given primitive in the grid.\"\"\"\n      locations = []\n      for i in range(grid.shape[0]):\n          for j in range(grid.shape[1]):\n              if grid[i, j, primitive_kind] == 1:\n                  locations.append((i, j))\n      return locations\n\n  def check_crafted_item(env, item_index):\n      \"\"\"Check if the crafted item is in the inventory.\"\"\"\n      return env._current_state.inventory[item_index] > 0\n\n  actions = []\n\n  # Get the cookbook and its index mapping\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  # Get the required primitives to craft the item\n  required_primitives = cookbook.primitives_for(item_index)\n  \n  # Collect the required primitives if not enough in inventory\n  actions.extend(collect_primitives(env, required_primitives))\n  \n  # Move to a workshop and perform the USE action\n  actions.extend(move_to_workshop(env._current_state.pos))\n  \n  # Perform the USE action to craft the item at the workshop\n  actions.append(4)  # Assuming 4 is the action index for USE\n  \n  # Check if the crafted item is in the inventory\n  if check_crafted_item(env, item_index):\n      return actions\n\n  return []  # If crafting failed, return empty actions", "island_id": 8, "scores": {"3": 0.0}}
