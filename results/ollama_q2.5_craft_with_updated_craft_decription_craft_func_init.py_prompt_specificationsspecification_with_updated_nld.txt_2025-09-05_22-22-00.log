{"timestamp": "2025-09-06T16:50:08.921981", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, workshop_kind):\n    positions = []\n    current_pos = env._current_state.pos\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if grid[i, j, workshop_kind] == 1:\n          positions.append((i, j))\n    \n    # Find the closest workshop using Euclidean distance\n    if not positions:\n      return None\n    \n    closest_position = min(positions, key=lambda x: np.linalg.norm(np.array(x) - np.array(current_pos)))\n    return closest_position\n\n  def move_to_location(current_pos, target_pos):\n    actions = []\n    x_diff = target_pos[0] - current_pos[0]\n    y_diff = target_pos[1] - current_pos[1]\n\n    # Move in the x-direction\n    if x_diff > 0:\n        actions.extend([3] * abs(x_diff))  # RIGHT\n    elif x_diff < 0:\n        actions.extend([2] * abs(x_diff))  # LEFT\n\n    # Move in the y-direction\n    if y_diff > 0:\n        actions.extend([1] * abs(y_diff))  # UP\n    elif y_diff < 0:\n        actions.extend([0] * abs(y_diff))  # DOWN\n    \n    return actions\n\n  def move_to_workshop(current_pos):\n    workshops = []\n    for i, workshop_kind in enumerate(env.world.workshop_indices):\n      workshop_location = find_closest_workshop(env._current_state.grid, workshop_kind)\n      if workshop_location:\n        workshops.append((workshop_location, i))\n    \n    # Find the closest workshop to the current position\n    if not workshops:\n      return []  # No workshops found\n    \n    closest_workshop = min(workshops, key=lambda x: np.linalg.norm(np.array(x[0]) - np.array(current_pos)))\n    target_pos = closest_workshop[0]\n    \n    # Generate actions to move from current position to the workshop\n    return move_to_location(current_pos, target_pos)\n\n  def collect_primitives(primitive_index):\n    actions = []\n    grid = env._current_state.grid\n    primitive_positions = []\n\n    # Find all positions of the required primitive in the grid\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if grid[i, j, primitive_index] == 1:\n          primitive_positions.append((i, j))\n    \n    if not primitive_positions:\n      return []  # No primitives found\n    \n    current_pos = env._current_state.pos\n\n    # Move to each primitive position and collect it\n    for pos in primitive_positions:\n      actions.extend(move_to_location(current_pos, pos))\n      actions.append(4)  # Assuming 4 is the action index for USE\n      current_pos = pos\n    \n    return actions\n\n  def check_inventory(item_index):\n    cookbook = env.world.cookbook\n    required_primitives = cookbook.primitives_for(item_index)\n    inventory = env._current_state.inventory\n    \n    # Check if all primitives are available in sufficient quantities\n    for primitive, count in required_primitives.items():\n      if inventory[primitive] < count:\n        return False\n    return True\n\n  def update_inventory(action):\n    current_state = env._current_state\n    if action == 4:  # USE action\n      cookbook = env.world.cookbook\n      item_index = cookbook.index[item]\n      required_primitives = cookbook.primitives_for(item_index)\n      \n      for primitive, count in required_primitives.items():\n        current_state.inventory[primitive] -= count\n      \n      # Add the crafted item to inventory\n      current_state.inventory[item_index] += 1\n\n  actions = []\n  \n  # Get the cookbook and its index mapping\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  # Check if all primitives are available in sufficient quantities\n  if not check_inventory(item_index):\n      required_primitives = cookbook.primitives_for(item_index)\n      \n      # Collect all the required primitives\n      for primitive, count in required_primitives.items():\n          current_count = env._current_state.inventory[primitive]\n          needed = count - current_count\n          \n          if needed > 0:\n              actions.extend(collect_primitives(primitive))\n  \n  # Move to a workshop and perform the USE action\n  actions.extend(move_to_workshop(env._current_state.pos))\n  \n  # Perform the USE action to craft the item at the workshop\n  actions.append(4)  # Assuming 4 is the action index for USE\n  \n  # Update inventory after crafting (simulated here)\n  update_inventory(actions[-1])\n  \n  return actions", "island_id": 6, "scores": {"3": 5.7999997}}
