{"timestamp": "2025-09-06T06:20:30.169244", "function_name": "craft", "function_body": "  # Get the index for the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  if item_index is None:\n    raise ValueError(f\"Item '{item}' not found in cookbook.\")\n\n  # Check if we have all the primitives required to craft the item\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  inventory = env._current_state.inventory\n  \n  for prim, count in primitives_needed.items():\n    if inventory[prim] < count:\n      return []  # Not enough primitives to craft the item\n\n  # Find the workshop required from the recipes\n  recipes = env.world.cookbook.recipes[item_index]\n  \n  # Assuming there's a \"_key\" that indicates the workshop type needed\n  workshop_key = \"_key\"\n  if workshop_key in recipes:\n    workshop_type = recipes[workshop_key]\n    workshop_indices = getattr(env.world, f\"workshop_indices_{workshop_type}\")\n  else:\n    workshop_indices = env.world.workshop_indices\n\n  # Find an empty cell next to any of the workshops\n  grid = env._current_state.grid\n  for workshop_index in workshop_indices:\n    x, y = divmod(workshop_index, grid.shape[1])\n    if (x-1 >= 0 and grid[x-1, y].sum() == 0) or \\\n       (x+1 < grid.shape[0] and grid[x+1, y].sum() == 0) or \\\n       (y-1 >= 0 and grid[x, y-1].sum() == 0) or \\\n       (y+1 < grid.shape[1] and grid[x, y+1].sum() == 0):\n      workshop_pos = (x, y)\n      break\n  else:\n    return []  # No empty cell found next to any workshop\n\n  # Get the current position of the agent\n  agent_pos = env._current_state.pos\n  \n  # Calculate the path from the agent's position to the workshop position\n  path_to_workshop = a_star_search(grid, agent_pos, workshop_pos)\n  \n  if not path_to_workshop:\n    return []  # No valid path found\n\n  actions = []\n  for step in path_to_workshop[:-1]:\n    dx, dy = step[0] - agent_pos[0], step[1] - agent_pos[1]\n    direction = get_direction(dx, dy)\n    if direction is not None:\n      actions.append(direction)\n\n  # Move to the cell next to the workshop\n  final_step = path_to_workshop[-1]\n  dx, dy = final_step[0] - agent_pos[0], final_step[1] - agent_pos[1]\n  direction = get_direction(dx, dy)\n  if direction is not None:\n    actions.append(direction)\n\n  # Perform the USE action to craft the item\n  actions.append(USE_ACTION)\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
