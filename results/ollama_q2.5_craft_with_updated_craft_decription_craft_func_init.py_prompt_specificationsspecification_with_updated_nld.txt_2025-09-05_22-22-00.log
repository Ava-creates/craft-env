{"timestamp": "2025-09-06T11:32:16.769393", "function_name": "craft", "function_body": "  # Convert the item name to its corresponding index using the cookbook's index\n  item_index = env.world.cookbook.index[item]\n\n  # Retrieve the primitive requirements for crafting the specified item\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n\n  # Build a dictionary representing the current inventory, mapping item names to their counts\n  current_inventory = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n\n  # Identify any missing primitives that are required for crafting but not present in sufficient quantity in the current inventory\n  missing_primitives = [primitive for primitive, count in required_primitives.items() if current_inventory.get(primitive, 0) < count]\n\n  # If there are missing primitives, return an empty action list as crafting is not possible\n  if missing_primitives:\n    return []\n\n  # Locate a suitable workshop from the cookbook recipes that can be used to craft the specified item and is present in the environment's workshop indices\n  workshop_index = None\n  for i, recipe in env.world.cookbook.recipes.items():\n      if recipe.get(\"_key\", None) == item_index and i in env.world.workshop_indices:\n          workshop_index = i\n          break\n\n  # If no suitable workshop is found, return an empty action list as crafting is not possible\n  if workshop_index is None:\n    return []\n\n  # Find the positions of all workshops on the grid that match the required workshop index\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  # If no workshop positions are found, return an empty action list as crafting is not possible\n  if not workshop_positions.size:\n    return []\n\n  # Choose the nearest workshop position to move towards (for simplicity, we choose the first one)\n  current_pos = env._current_state.pos\n  target_pos = tuple(workshop_positions[0])\n\n  # Calculate the actions required to move from the current position to the target workshop position\n  delta_x = target_pos[0] - current_pos[0]\n  delta_y = target_pos[1] - current_pos[1]\n\n  actions = []\n\n  # Determine the direction and sequence of movements based on the differences in x and y coordinates\n  if abs(delta_x) > abs(delta_y):\n      if delta_x < 0:\n          actions.extend([env.world.N_ACTIONS['LEFT']] * abs(delta_x))\n      elif delta_x > 0:\n          actions.extend([env.world.N_ACTIONS['RIGHT']] * abs(delta_x))\n\n      # Then move vertically\n      if delta_y < 0:\n          actions.extend([env.world.N_ACTIONS['UP']] * abs(delta_y))\n      elif delta_y > 0:\n          actions.extend([env.world.N_ACTIONS['DOWN']] * abs(delta_y))\n  else:\n      # Move vertically first if required\n      if delta_y < 0:\n          actions.extend([env.world.N_ACTIONS['UP']] * abs(delta_y))\n      elif delta_y > 0:\n          actions.extend([env.world.N_ACTIONS['DOWN']] * abs(delta_y))\n\n      # Then move horizontally\n      if delta_x < 0:\n          actions.extend([env.world.N_ACTIONS['LEFT']] * abs(delta_x))\n      elif delta_x > 0:\n          actions.extend([env.world.N_ACTIONS['RIGHT']] * abs(delta_x))\n\n  # Add the USE action to craft the item at the workshop\n  actions.append(env.world.N_ACTIONS['USE'])\n\n  return actions", "island_id": 2, "scores": {"3": 0.0}}
