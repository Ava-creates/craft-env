{"timestamp": "2025-09-06T12:14:17.660592", "function_name": "craft", "function_body": "  def find_nearest_workshop(state, workshop_index):\n    queue = collections.deque([state.pos])\n    visited = set()\n    \n    while queue:\n        current_pos = queue.popleft()\n        if state.grid[current_pos[0], current_pos[1]][workshop_index] == 1:\n            return current_pos\n        \n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            nx, ny = current_pos[0] + dx, current_pos[1] + dy\n            if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                if (nx, ny) not in visited and sum(state.grid[nx, ny]) == 0:\n                    visited.add((nx, ny))\n                    queue.append((nx, ny))\n    return None\n\n  def pathfinding(start_pos, end_pos, grid):\n    queue = collections.deque([(start_pos, [])])\n    visited = set([start_pos])\n    \n    while queue:\n        current_pos, path = queue.popleft()\n        if current_pos == end_pos:\n            return path + [end_pos]\n        \n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            nx, ny = current_pos[0] + dx, current_pos[1] + dy\n            if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n                if (nx, ny) not in visited and sum(grid[nx, ny]) == 0:\n                    visited.add((nx, ny))\n                    queue.append(((nx, ny), path + [current_pos]))\n    return []\n\n  def actions_from_path(path):\n    if len(path) < 2:\n        return []\n    \n    actions = []\n    for i in range(1, len(path)):\n        dx = path[i][0] - path[i-1][0]\n        dy = path[i][1] - path[i-1][1]\n        \n        if dx == 1:\n            actions.append(craft.ACTION_DOWN)\n        elif dx == -1:\n            actions.append(craft.ACTION_UP)\n        elif dy == 1:\n            actions.append(craft.ACTION_RIGHT)\n        elif dy == -1:\n            actions.append(craft.ACTION_LEFT)\n    \n    return actions\n\n  def pick_up_primitives(state, primitives_required):\n    actions = []\n    for primitive, count in primitives_required.items():\n      while state.inventory[primitive] < count:\n        # Find the nearest location of this primitive\n        primitive_pos = find_nearest_primitive(state.grid, primitive)\n        if primitive_pos is None:\n          return []  # No reachable primitive found\n        \n        # Move to the nearest location of the primitive\n        path_to_primitive = pathfinding(state.pos, primitive_pos, state.grid)\n        actions.extend(actions_from_path(path_to_primitive))\n        \n        # Perform the USE action to pick up the primitive\n        actions.append(craft.ACTION_USE)\n        \n        # Update the state after picking up the primitive\n        state.inventory[primitive] += 1\n    \n    return actions\n\n  def find_nearest_primitive(grid, primitive_index):\n    queue = collections.deque([(state.pos)])\n    visited = set()\n    \n    while queue:\n        current_pos = queue.popleft()\n        if grid[current_pos[0], current_pos[1]][primitive_index] == 1:\n            return current_pos\n        \n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            nx, ny = current_pos[0] + dx, current_pos[1] + dy\n            if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n                if (nx, ny) not in visited and sum(grid[nx, ny]) == 0:\n                    visited.add((nx, ny))\n                    queue.append((nx, ny))\n    return None\n\n  def perform_crafting(state, workshop_index):\n    actions = []\n    \n    # Find the nearest reachable workshop\n    workshop_pos = find_nearest_workshop(state, workshop_index)\n\n    if workshop_pos is None:\n        return []\n\n    # Move to the nearest workshop\n    path_to_workshop = pathfinding(state.pos, workshop_pos, state.grid)\n    actions.extend(actions_from_path(path_to_workshop))\n\n    # Perform the USE action at the workshop to craft the item\n    actions.append(craft.ACTION_USE)\n\n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the goal is achievable\n  if item_index not in env.world.cookbook.recipes:\n      return []\n\n  # Get the primitives required for crafting the item\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n\n  actions = []\n  \n  # Pick up required primitives\n  state = env._current_state\n  actions.extend(pick_up_primitives(state, primitives_required))\n\n  # Determine which workshop is required\n  workshop_index = None\n  recipe = env.world.cookbook.recipes[item_index]\n  if \"_key\" in recipe:\n      key = recipe[\"_key\"]\n      if key == \"workshop0\":\n          workshop_index = env.world.workshop_indices[0]\n      elif key == \"workshop1\":\n          workshop_index = env.world.workshop_indices[1]\n      elif key == \"workshop2\":\n          workshop_index = env.world.workshop_indices[2]\n\n  if workshop_index is None:\n    return []\n\n  # Perform crafting at the determined workshop\n  actions.extend(perform_crafting(state, workshop_index))\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T12:16:21.914865", "function_name": "craft", "function_body": "  return []", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T12:16:22.896681", "function_name": "craft", "function_body": "  # Implement this function based on the given environment and DSL\n  def move_towards(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    # Calculate the difference in positions\n    delta_x = target_pos[0] - current_pos[0]\n    delta_y = target_pos[1] - current_pos[1]\n    \n    # Move vertically to the target position\n    if delta_x > 0:\n      actions.extend([craft.DOWN] * delta_x)\n    elif delta_x < 0:\n      actions.extend([craft.UP] * (-delta_x))\n    \n    # Move horizontally to the target position\n    if delta_y > 0:\n      actions.extend([craft.RIGHT] * delta_y)\n    elif delta_y < 0:\n      actions.extend([craft.LEFT] * (-delta_y))\n    \n    return actions\n\n  def find_nearest_workshop(grid, current_pos, workshop_indices):\n    workshops_of_type = np.concatenate([np.argwhere(grid[:, :, index] == 1) for index in workshop_indices])\n    \n    if len(workshops_of_type) > 0:\n      distances = np.linalg.norm(workshops_of_type - current_pos, axis=1)\n      nearest_workshop_index = np.argmin(distances)\n      return tuple(workshops_of_type[nearest_workshop_index])\n    return None\n\n  def collect_primitives(env, primitives_needed):\n    actions_to_take = []\n    \n    for primitive, count in primitives_needed.items():\n      required_count = count - env._current_state.inventory[primitive]\n      \n      if required_count > 0:\n        # Find the positions of the primitive in the grid\n        grid = env._current_state.grid\n        primitive_positions = np.argwhere(grid[:, :, primitive] == 1)\n        \n        for _ in range(required_count):\n          nearest_primitive_pos = find_nearest_workshop(grid, np.array(env._current_state.pos), [primitive])\n          \n          if nearest_primitive_pos is not None:\n            actions_to_take.extend(move_towards(env, nearest_primitive_pos))\n            \n            # Use the USE action to collect the primitive\n            actions_to_take.append(craft.USE)\n    \n    return actions_to_take\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Fetch the primitives required to craft the item\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  \n  # Initialize a list of actions to take\n  actions_to_take = []\n  \n  # Collect any missing primitives\n  collect_actions = collect_primitives(env, primitives_needed)\n  if collect_actions:\n    actions_to_take.extend(collect_actions)\n\n  # Find a workshop index that can be used to craft the desired item\n  for recipe in env.world.cookbook.recipes.values():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n      # This is a potential candidate for crafting\n      workshop_indices = recipe.get(\"workshop\", [])\n      \n      if not isinstance(workshop_indices, list):\n        workshop_indices = [workshop_indices]\n      \n      grid = env._current_state.grid\n      current_pos = np.array(env._current_state.pos)\n      \n      nearest_workshop_pos = find_nearest_workshop(grid, current_pos, workshop_indices)\n\n      if nearest_workshop_pos is not None:\n        # Move towards the nearest workshop\n        actions_to_take.extend(move_towards(env, nearest_workshop_pos))\n        \n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(craft.USE)\n        \n        return actions_to_take\n\n  # If no suitable workshop is found, return an empty list\n  return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-06T12:20:12.097099", "function_name": "craft", "function_body": "  def move_to_workshop(current_pos):\n      \"\"\"Generate actions to move from current position to a workshop.\"\"\"\n      # Locate all workshops and their positions in the grid\n      workshops = []\n      for i, workshop_kind in enumerate(env.world.workshop_indices):\n          workshop_location = find_workshop(env._current_state.grid, workshop_kind)\n          if workshop_location:\n              workshops.append((workshop_location, i))\n      \n      # Find the closest workshop to the current position\n      if not workshops:\n          return []  # No workshops found\n      \n      closest_workshop = min(workshops, key=lambda x: np.linalg.norm(np.array(x[0]) - np.array(current_pos)))\n      target_pos = closest_workshop[0]\n      \n      # Generate actions to move from current position to the workshop\n      return move_to_location(current_pos, target_pos)\n\n  def find_workshop(grid, workshop_kind):\n      \"\"\"Find the position of a workshop in the grid.\"\"\"\n      for i in range(grid.shape[0]):\n          for j in range(grid.shape[1]):\n              if grid[i, j, workshop_kind] == 1:\n                  return (i, j)\n      return None\n\n  def move_to_location(current_pos, target_pos):\n      \"\"\"Generate actions to move from current position to target position.\"\"\"\n      path = a_star_search(current_pos, target_pos, env._current_state.grid)\n      if not path:\n          return []\n      \n      actions = []\n      for next_pos in path[1:]:  # Skip the starting point\n          x_diff = next_pos[0] - current_pos[0]\n          y_diff = next_pos[1] - current_pos[1]\n          \n          if x_diff > 0:\n              actions.append(3)  # RIGHT\n          elif x_diff < 0:\n              actions.append(2)  # LEFT\n          \n          if y_diff > 0:\n              actions.append(1)  # UP\n          elif y_diff < 0:\n              actions.append(0)  # DOWN\n          \n          current_pos = next_pos\n      \n      return actions\n\n  def a_star_search(start, goal, grid):\n      \"\"\"A* search algorithm to find the shortest path from start to goal.\"\"\"\n      open_set = []\n      heapq.heappush(open_set, (0, start))\n      \n      came_from = {}\n      g_score = {start: 0}\n      f_score = {start: heuristic(start, goal)}\n      \n      while open_set:\n          _, current = heapq.heappop(open_set)\n          \n          if current == goal:\n              return reconstruct_path(came_from, current)\n          \n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n                  tentative_g_score = g_score[current] + 1\n                  \n                  if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                      came_from[neighbor] = current\n                      g_score[neighbor] = tentative_g_score\n                      f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                      heapq.heappush(open_set, (f_score[neighbor], neighbor))\n      \n      return []  # No path found\n\n  def heuristic(a, b):\n      \"\"\"Heuristic function for A* search.\"\"\"\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def reconstruct_path(came_from, current):\n      \"\"\"Reconstruct the path from start to goal.\"\"\"\n      total_path = [current]\n      while current in came_from:\n          current = came_from[current]\n          total_path.append(current)\n      return total_path[::-1]\n\n  actions = []\n  \n  # Get the cookbook and its index mapping\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  # Get the required primitives to craft the item\n  required_primitives = cookbook.primitives_for(item_index)\n  \n  # Check if we have all the required primitives in our inventory\n  for primitive, count in required_primitives.items():\n    if env._current_state.inventory[primitive] < count:\n      return []  # Not enough primitives to proceed with crafting\n  \n  # Move to a workshop and perform the USE action\n  actions.extend(move_to_workshop(env._current_state.pos))\n  \n  # Perform the USE action to craft the item at the workshop\n  actions.append(4)  # Assuming 4 is the action index for USE\n  \n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-06T12:20:13.219789", "function_name": "craft", "function_body": "  def move_to_workshop(current_pos):\n      \"\"\"Generate actions to move from current position to a workshop.\"\"\"\n      workshops = []\n      for i, workshop_kind in enumerate(env.world.workshop_indices):\n          workshop_location = find_workshop(env._current_state.grid, workshop_kind)\n          if workshop_location:\n              workshops.append((workshop_location, i))\n      \n      if not workshops:\n          return []  # No workshops found\n      \n      closest_workshop = min(workshops, key=lambda x: np.linalg.norm(np.array(x[0]) - np.array(current_pos)))\n      target_pos = closest_workshop[0]\n      \n      return move_to_location(current_pos, target_pos)\n\n  def find_workshop(grid, workshop_kind):\n      \"\"\"Find the position of a workshop in the grid.\"\"\"\n      for i in range(grid.shape[0]):\n          for j in range(grid.shape[1]):\n              if grid[i, j, workshop_kind] == 1:\n                  return (i, j)\n      return None\n\n  def move_to_location(current_pos, target_pos):\n      \"\"\"Generate actions to move from current position to target position.\"\"\"\n      actions = []\n      x_diff = target_pos[0] - current_pos[0]\n      y_diff = target_pos[1] - current_pos[1]\n\n      if abs(x_diff) > abs(y_diff):\n          if x_diff > 0:\n              actions.extend([3] * abs(x_diff))  # RIGHT\n          elif x_diff < 0:\n              actions.extend([2] * abs(x_diff))  # LEFT\n          \n          if y_diff > 0:\n              actions.extend([1] * abs(y_diff))  # UP\n          elif y_diff < 0:\n              actions.extend([0] * abs(y_diff))  # DOWN\n      else:\n          if y_diff > 0:\n              actions.extend([1] * abs(y_diff))  # UP\n          elif y_diff < 0:\n              actions.extend([0] * abs(y_diff))  # DOWN\n          \n          if x_diff > 0:\n              actions.extend([3] * abs(x_diff))  # RIGHT\n          elif x_diff < 0:\n              actions.extend([2] * abs(x_diff))  # LEFT\n      \n      return actions\n\n  actions = []\n  \n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  required_primitives = cookbook.primitives_for(item_index)\n  \n  for primitive, count in required_primitives.items():\n    if env._current_state.inventory[primitive] < count:\n      # Find the position of the primitive in the grid\n      primitive_location = find_workshop(env._current_state.grid, primitive)\n      \n      if not primitive_location:\n          return []  # Primitive not found in the grid\n      \n      actions.extend(move_to_location(env._current_state.pos, primitive_location))\n      \n      # Perform the USE action to collect the primitive\n      actions.append(4)  # Assuming 4 is the action index for USE\n      \n  actions.extend(move_to_workshop(env._current_state.pos))\n  \n  actions.append(4)  # Use the workshop to craft the item\n  \n  return actions", "island_id": 6, "scores": {"3": 4.6}}
{"timestamp": "2025-09-06T12:21:50.664396", "function_name": "craft", "function_body": "  # Retrieve the index for the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the goal is achievable (i.e., it has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"No known recipe to craft {item}\")\n\n  # Get primitives required for crafting one of this item\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n\n  # Collect all the needed primitives (if they are not already in inventory)\n  actions_to_take = []\n  \n  # For each primitive, check if it is needed and not already in inventory\n  for prim_index, count in primitives_needed.items():\n    # Check how many of this primitive we currently have\n    current_count = env._current_state.inventory[prim_index]\n\n    # If we need more than we currently have, collect the difference\n    if current_count < count:\n      actions_to_take.extend(collect_v1(env, prim_index))\n\n  # Assuming all primitives are collected in inventory now\n  # Proceed to find a workshop that can craft this item\n  for workshop in env.world.workshop_indices:\n    # Check if this workshop has the recipe for the desired item\n    if \"_key\" not in env.world.cookbook.recipes[item_index] or workshop == int(env.world.cookbook.recipes[item_index][\"_key\"]):\n      # Find the position of the workshop on the grid\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop] > 0)\n      \n      if len(workshop_positions) == 0:\n        continue\n      \n      # Navigate to one of the workshops (first found)\n      target_pos = tuple(workshop_positions[0])\n      actions_to_take.extend(navigate_v1(env, target_pos))\n      \n      # Once at the workshop, perform the USE action to craft the item\n      actions_to_take.append(craft.USE)\n      break\n\n  return actions_to_take", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-06T12:21:51.658742", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  item_idx = env.world.cookbook.index[item]\n\n  # Check if the recipe for the item exists\n  if item_idx not in env.world.cookbook.recipes:\n    return []\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes[item_idx]\n  \n  # Initialize actions list\n  actions = []\n  \n  # Collect required items/primitives\n  for ingredient, count in recipe.items():\n      if ingredient == \"_key\":\n          continue  # Skip the key ingredient which is typically just a placeholder\n\n      primitive_name = env.world.cookbook.index.get(ingredient)\n      if not primitive_name:\n          return []  # Ingredient index does not exist in the cookbook\n\n      actions.extend(collect(env, primitive_name))\n\n  # Add workshop-specific actions\n  for i_workshop in env.world.workshop_indices:\n      if next_to(env._current_state, i_workshop):\n          actions.append(USE)  # Interact with the workshop to craft\n          break\n  else:\n      return []  # No workshop found nearby\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-06T12:24:55.706062", "function_name": "craft", "function_body": "  def move_to_index(target_pos):\n    current_pos = env._current_state.pos\n    if target_pos == current_pos:\n      return []\n    \n    actions = []\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    # Determine the direction to move horizontally (LEFT or RIGHT)\n    if dx > 0:\n        actions.extend([craft.RIGHT] * dx)\n    elif dx < 0:\n        actions.extend([craft.LEFT] * (-dx))\n    \n    # Determine the direction to move vertically (UP or DOWN)\n    if dy > 0:\n        actions.extend([craft.DOWN] * dy)\n    elif dy < 0:\n        actions.extend([craft.UP] * (-dy))\n    \n    return actions\n\n  def collect_item(item_index, required_amount):\n    available_positions = np.argwhere(env._current_state.grid[:, :, item_index] > 0)\n    collected = 0\n    \n    while collected < required_amount and len(available_positions) > 0:\n        closest_pos = min(available_positions, key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1]))\n        actions_to_take.extend(move_to_index(closest_pos))\n        actions_to_take.append(craft.USE)\n        \n        # Simulate the action to update inventory\n        env._current_state = env._step_internal(craft.USE)[2]\n        collected += 1\n        \n        available_positions = np.argwhere(env._current_state.grid[:, :, item_index] > 0)\n    \n    return collected == required_amount\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the item has a recipe\n  if item_index not in env.world.cookbook.recipes:\n    return []  # No recipe for this item\n\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Find the workshop required for crafting the item\n  if \"_key\" not in recipe:\n    return []  # No workshop specified for this item\n  \n  workshop_type = int(recipe[\"_key\"])\n  workshop_index = env.world.workshop_indices[workshop_type]\n  \n  actions_to_take = []\n\n  # Check and collect all required items/primitives\n  inventory = env._current_state.inventory\n\n  for requirement, amount in recipe.items():\n    if requirement == \"_key\":\n      continue\n    \n    required_item_index = int(requirement)\n    \n    if inventory[required_item_index] < amount:\n        collected = collect_item(required_item_index, amount)\n        if not collected:\n            return []  # Failed to collect enough items\n\n  # Move to the closest workshop\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n    return []  # No available workshops\n  \n  closest_workshop = min(workshop_positions, key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1]))\n  \n  actions_to_take.extend(move_to_index(closest_workshop))\n  \n  # Perform the USE action to craft the item\n  actions_to_take.append(craft.USE)\n  \n  return actions_to_take", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T12:24:56.820620", "function_name": "craft", "function_body": "  def move_to_index(target_pos):\n    current_pos = env._current_state.pos\n    if target_pos == current_pos:\n      return []\n    \n    actions = []\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    # Determine the direction to move horizontally (LEFT or RIGHT)\n    if dx > 0:\n        actions.extend([craft.RIGHT] * dx)\n    elif dx < 0:\n        actions.extend([craft.LEFT] * (-dx))\n    \n    # Determine the direction to move vertically (UP or DOWN)\n    if dy > 0:\n        actions.extend([craft.DOWN] * dy)\n    elif dy < 0:\n        actions.extend([craft.UP] * (-dy))\n    \n    return actions\n\n  def collect_item(item_index, required_amount):\n    available_positions = np.argwhere(env._current_state.grid[:, :, item_index] > 0)\n    collected = 0\n    \n    while collected < required_amount and len(available_positions) > 0:\n        closest_pos = min(available_positions, key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1]))\n        actions_to_take.extend(move_to_index(closest_pos))\n        actions_to_take.append(craft.USE)\n        \n        # Simulate the action to update inventory\n        env._current_state = env._step_internal(craft.USE)[2]\n        collected += 1\n        \n        available_positions = np.argwhere(env._current_state.grid[:, :, item_index] > 0)\n    \n    return collected == required_amount\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the item has a recipe\n  if item_index not in env.world.cookbook.recipes:\n    return []  # No recipe for this item\n\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Find the workshop required for crafting the item\n  if \"_key\" not in recipe:\n    return []  # No workshop specified for this item\n  \n  workshop_type = int(recipe[\"_key\"])\n  workshop_index = env.world.workshop_indices[workshop_type]\n  \n  actions_to_take = []\n\n  inventory = env._current_state.inventory\n\n  # Check and collect all required items/primitives\n  for requirement, amount in recipe.items():\n    if requirement == \"_key\":\n      continue\n    \n    required_item_index = int(requirement)\n    \n    if inventory[required_item_index] < amount:\n        collected = collect_item(required_item_index, amount)\n        if not collected:\n            return []  # Failed to collect enough items\n\n  # Find the closest workshop with available space\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    return []  # No available workshops\n  \n  closest_workshop = min(workshop_positions, key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1]))\n  \n  actions_to_take.extend(move_to_index(closest_workshop))\n  \n  # Perform the USE action to craft the item\n  actions_to_take.append(craft.USE)\n  \n  return actions_to_take", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T12:27:52.884627", "function_name": "craft", "function_body": "  def move_towards(pos: tuple, target_pos: tuple):\n    \"\"\"Generates a sequence of actions to move the agent from pos to target_pos.\"\"\"\n    x_diff = target_pos[0] - pos[0]\n    y_diff = target_pos[1] - pos[1]\n\n    # Determine directions based on differences\n    actions = []\n    if x_diff < 0:\n        actions.extend([craft.LEFT for _ in range(abs(x_diff))])\n    elif x_diff > 0:\n        actions.extend([craft.RIGHT for _ in range(abs(x_diff))])\n\n    if y_diff < 0:\n        actions.extend([craft.DOWN for _ in range(abs(y_diff))])\n    elif y_diff > 0:\n        actions.extend([craft.UP for _ in range(abs(y_diff))])\n\n    return actions\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Fetch the primitives required to craft the item\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  \n  # Check if all the required primitives are in the inventory\n  inventory = env._current_state.inventory\n  \n  # Initialize a list of actions to take\n  actions_to_take = []\n\n  # Check if we have enough primitives in our inventory to craft the item\n  for primitive, count in primitives_needed.items():\n    if inventory[primitive] < count:\n      return []  # Not enough primitives\n\n  # Find all workshops that can be used to craft the desired item\n  workshop_indices = []\n  for recipe in env.world.cookbook.recipes.values():\n    key = recipe.get(\"_key\")\n    if key is not None and key.startswith(\"workshop\"):\n        workshop_index = recipe.get(\"workshop\", None)\n        if isinstance(workshop_index, list):\n            workshop_indices.extend(workshop_index)\n        elif workshop_index is not None:\n            workshop_indices.append(workshop_index)\n\n  # Filter out any None values\n  workshop_indices = [index for index in workshop_indices if index is not None]\n\n  if not workshop_indices:\n    return []  # No workshops found\n\n  # Find the nearest workshop of any suitable type\n  grid = env._current_state.grid\n  all_workshops = np.argwhere(np.isin(grid.sum(axis=2), workshop_indices))\n\n  if len(all_workshops) == 0:\n    return []  # No workshops available\n\n  # Calculate distances to each workshop from the current position\n  pos = np.array(env._current_state.pos)\n  distances = np.linalg.norm(all_workshops - pos, axis=1)\n\n  # Find the nearest workshop\n  nearest_workshop_pos = all_workshops[np.argmin(distances)]\n\n  # Move towards the nearest workshop and add actions to list\n  actions_to_take.extend(move_towards(env._current_state.pos, tuple(nearest_workshop_pos)))\n\n  # Use the USE action to craft the item at the workshop\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T12:27:53.951438", "function_name": "craft", "function_body": "  def move_towards(pos: tuple, target_pos: tuple):\n    \"\"\"Generates a sequence of actions to move the agent from pos to target_pos.\"\"\"\n    x_diff = target_pos[0] - pos[0]\n    y_diff = target_pos[1] - pos[1]\n    \n    # Determine the direction based on differences\n    if x_diff < 0:\n      return [craft.LEFT for _ in range(abs(x_diff))]\n    elif x_diff > 0:\n      return [craft.RIGHT for _ in range(abs(x_diff))]\n    if y_diff < 0:\n      return [craft.DOWN for _ in range(abs(y_diff))]\n    elif y_diff > 0:\n      return [craft.UP for _ in range(abs(y_diff))]\n    \n    # If we are already at the target position, no actions needed\n    return []\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Fetch the primitives required to craft the item\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  \n  # Check if all the required primitives are in the inventory\n  inventory = env._current_state.inventory\n  \n  # Initialize a list of actions to take\n  actions_to_take = []\n  \n  # Check if we have enough primitives in our inventory to craft the item\n  for primitive, count in primitives_needed.items():\n    if inventory[primitive] < count:\n      return []  # Not enough primitives\n\n  # Find all workshops that can be used to craft the desired item\n  workshop_indices = []\n  for recipe in env.world.cookbook.recipes.values():\n    key = recipe.get(\"_key\")\n    if key is not None and key.startswith(\"workshop\"):\n        workshop_index = recipe.get(\"workshop\", [])\n        if isinstance(workshop_index, list):\n            workshop_indices.extend(workshop_index)\n        elif isinstance(workshop_index, int):\n            workshop_indices.append(workshop_index)\n\n  # Filter out any duplicate or invalid indices\n  workshop_indices = list(set(filter(None, workshop_indices)))\n\n  if not workshop_indices:\n    return []  # No workshops found\n\n  # Find the nearest workshop of any suitable type\n  grid = env._current_state.grid\n  all_workshops = np.argwhere(np.isin(grid.sum(axis=2), workshop_indices))\n\n  if len(all_workshops) == 0:\n    return []  # No workshops available\n\n  # Calculate distances to each workshop from the current position\n  pos = np.array(env._current_state.pos)\n  distances = np.linalg.norm(all_workshops - pos, axis=1)\n\n  # Find the nearest workshop\n  nearest_workshop_pos = all_workshops[np.argmin(distances)]\n\n  # Move towards the nearest workshop and add actions to list\n  actions_to_take.extend(move_towards(env._current_state.pos, tuple(nearest_workshop_pos)))\n\n  # Use the USE action to craft the item at the workshop\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T12:28:36.868387", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have all required primitives in our inventory\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  for primitive, count in required_primitives.items():\n    if env._current_state.inventory[primitive] < count:\n      return []  # Not enough primitives to craft the item\n\n  # Find a suitable workshop that can be used to craft the item\n  available_workshops = env.world.workshop_indices\n  suitable_workshop = None\n  \n  for workshop in available_workshops:\n    if workshop in required_primitives:\n      suitable_workshop = workshop\n      break\n\n  if not suitable_workshop:\n    return []  # No suitable workshop found to craft the item\n\n  # Calculate the path from current position to the workshop\n  workshop_position = find_workshop_position(env._current_state.grid, suitable_workshop)\n  \n  if workshop_position is None:\n    return []  # Workshop not found on the grid\n\n  path_to_workshop = calculate_path(env._current_state.pos, workshop_position)\n\n  if path_to_workshop is None:\n    return []  # No path to the workshop\n\n  actions = []\n\n  # Add actions to move to each position in the path\n  for pos in path_to_workshop:\n      direction = get_direction(env._current_state.pos, pos)\n      action = move_action(direction)\n      actions.append(action)\n      env._current_state.pos = pos  # Update agent's position\n\n  # Add the USE action at the workshop location to craft the item\n  actions.append(USE_ACTION)\n\n  return actions", "island_id": 3, "scores": {"3": 0.0}}
