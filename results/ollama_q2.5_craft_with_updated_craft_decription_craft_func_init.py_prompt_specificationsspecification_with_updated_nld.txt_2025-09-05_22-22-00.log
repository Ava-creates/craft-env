{"timestamp": "2025-09-06T11:38:59.820706", "function_name": "craft", "function_body": "  def move_to_workshop(current_pos):\n      workshops = []\n      for i, workshop_kind in enumerate(env.world.workshop_indices):\n          workshop_location = find_workshop(env._current_state.grid, workshop_kind)\n          if workshop_location:\n              workshops.append((workshop_location, i))\n      \n      if not workshops:\n          return []\n\n      # Filter workshops by availability (no other item being crafted there)\n      available_workshops = []\n      for workshop_pos, _ in workshops:\n          if is_workshop_available(env._current_state.grid, workshop_pos):\n              available_workshops.append(workshop_pos)\n\n      if not available_workshops:\n          return []\n\n      closest_workshop = min(available_workshops, key=lambda x: np.linalg.norm(np.array(x) - np.array(current_pos)))\n      target_pos = closest_workshop\n      \n      return move_to_location(current_pos, target_pos)\n\n  def find_workshop(grid, workshop_kind):\n      for i in range(grid.shape[0]):\n          for j in range(grid.shape[1]):\n              if grid[i, j, workshop_kind] == 1:\n                  return (i, j)\n      return None\n\n  def move_to_location(current_pos, target_pos):\n      actions = []\n      x_diff = target_pos[0] - current_pos[0]\n      y_diff = target_pos[1] - current_pos[1]\n\n      # Determine the direction to move based on the differences\n      if x_diff > 0:\n          actions.extend([3] * abs(x_diff))  # RIGHT\n      elif x_diff < 0:\n          actions.extend([2] * abs(x_diff))  # LEFT\n\n      if y_diff > 0:\n          actions.extend([1] * abs(y_diff))  # UP\n      elif y_diff < 0:\n          actions.extend([0] * abs(y_diff))  # DOWN\n      \n      return actions\n\n  def collect_primitives(env, required_primitives):\n      \"\"\"Generate actions to collect the required primitives.\"\"\"\n      actions = []\n      for primitive, count in required_primitives.items():\n          if env._current_state.inventory[primitive] < count:\n              available_locations = find_primitive_locations(env._current_state.grid, primitive)\n              while env._current_state.inventory[primitive] < count and available_locations:\n                  target_pos = available_locations.pop()\n                  actions.extend(move_to_location(env._current_state.pos, target_pos))\n                  actions.append(4)  # Collect the primitive\n      return actions\n\n  def find_primitive_locations(grid, primitive_kind):\n      \"\"\"Find all locations of a given primitive in the grid.\"\"\"\n      locations = []\n      for i in range(grid.shape[0]):\n          for j in range(grid.shape[1]):\n              if grid[i, j, primitive_kind] == 1:\n                  locations.append((i, j))\n      return locations\n\n  def is_workshop_available(grid, workshop_pos):\n      \"\"\"Check if the workshop at the given position is available.\"\"\"\n      # Assuming that other items being crafted are represented by specific indices in the grid\n      for item_index in env.world.cookbook.index.values():\n          if grid[workshop_pos[0], workshop_pos[1], item_index] > 0:\n              return False\n      return True\n\n  actions = []\n\n  # Get the cookbook and its index mapping\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  # Get the required primitives to craft the item\n  required_primitives = cookbook.primitives_for(item_index)\n  \n  # Collect the required primitives if not enough in inventory\n  actions.extend(collect_primitives(env, required_primitives))\n  \n  # Move to a workshop and perform the USE action\n  actions.extend(move_to_workshop(env._current_state.pos))\n  \n  # Perform the USE action to craft the item at the workshop\n  actions.append(4)  # Assuming 4 is the action index for USE\n  \n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-06T11:44:53.929997", "function_name": "craft", "function_body": "  def find_nearest_workshop(state, workshop_index):\n    queue = collections.deque([state.pos])\n    visited = set()\n    \n    while queue:\n        current_pos = queue.popleft()\n        if state.grid[current_pos[0], current_pos[1]][workshop_index] == 1:\n            return current_pos\n        \n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            nx, ny = current_pos[0] + dx, current_pos[1] + dy\n            if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                if (nx, ny) not in visited and sum(state.grid[nx, ny]) == 0:\n                    visited.add((nx, ny))\n                    queue.append((nx, ny))\n    return None\n\n  def pathfinding(start_pos, end_pos, grid):\n    queue = collections.deque([(start_pos, [])])\n    visited = set([start_pos])\n    \n    while queue:\n        current_pos, path = queue.popleft()\n        if current_pos == end_pos:\n            return path + [end_pos]\n        \n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            nx, ny = current_pos[0] + dx, current_pos[1] + dy\n            if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n                if (nx, ny) not in visited and sum(grid[nx, ny]) == 0:\n                    visited.add((nx, ny))\n                    queue.append(((nx, ny), path + [current_pos]))\n    return []\n\n  def actions_from_path(path):\n    if len(path) < 2:\n        return []\n    \n    actions = []\n    for i in range(1, len(path)):\n        dx = path[i][0] - path[i-1][0]\n        dy = path[i][1] - path[i-1][1]\n        \n        if dx == 1:\n            actions.append(craft.ACTION_DOWN)\n        elif dx == -1:\n            actions.append(craft.ACTION_UP)\n        elif dy == 1:\n            actions.append(craft.ACTION_RIGHT)\n        elif dy == -1:\n            actions.append(craft.ACTION_LEFT)\n    \n    return actions\n\n  def pick_up_primitives(state, primitives_required):\n    actions = []\n    for primitive, count in primitives_required.items():\n      while state.inventory[primitive] < count:\n        # Find the nearest location of this primitive\n        primitive_pos = find_nearest_primitive(state.grid, primitive)\n        if primitive_pos is None:\n          return []  # No reachable primitive found\n        \n        # Move to the nearest location of the primitive\n        path_to_primitive = pathfinding(state.pos, primitive_pos, state.grid)\n        actions.extend(actions_from_path(path_to_primitive))\n        \n        # Perform the USE action to pick up the primitive\n        actions.append(craft.ACTION_USE)\n        \n        # Update the state after picking up the primitive\n        state.inventory[primitive] += 1\n    \n    return actions\n\n  def find_nearest_primitive(grid, primitive_index):\n    queue = collections.deque([(state.pos)])\n    visited = set()\n    \n    while queue:\n        current_pos = queue.popleft()\n        if grid[current_pos[0], current_pos[1]][primitive_index] == 1:\n            return current_pos\n        \n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            nx, ny = current_pos[0] + dx, current_pos[1] + dy\n            if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n                if (nx, ny) not in visited and sum(grid[nx, ny]) == 0:\n                    visited.add((nx, ny))\n                    queue.append((nx, ny))\n    return None\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the goal is achievable\n  if item_index not in env.world.cookbook.recipes:\n      return []\n\n  # Get the primitives required for crafting the item\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n\n  actions = []\n  \n  # Pick up required primitives\n  state = env._current_state\n  actions.extend(pick_up_primitives(state, primitives_required))\n\n  # Determine which workshop is required\n  workshop_index = None\n  recipe = env.world.cookbook.recipes[item_index]\n  if \"_key\" in recipe:\n      key = recipe[\"_key\"]\n      if key == \"workshop0\":\n          workshop_index = env.world.workshop_indices[0]\n      elif key == \"workshop1\":\n          workshop_index = env.world.workshop_indices[1]\n      elif key == \"workshop2\":\n          workshop_index = env.world.workbook_indices[2]  # Fixed typo here\n\n  if workshop_index is None:\n    return []\n\n  # Find the nearest reachable workshop\n  workshop_pos = find_nearest_workshop(state, workshop_index)\n\n  if workshop_pos is None:\n      return []\n\n  # Move to the nearest workshop\n  path_to_workshop = pathfinding(state.pos, workshop_pos, state.grid)\n  actions.extend(actions_from_path(path_to_workshop))\n\n  # Perform the USE action at the workshop to craft the item\n  actions.append(craft.ACTION_USE)\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T11:44:55.022615", "function_name": "craft", "function_body": "  def find_nearest_workshop(state, workshop_indices):\n    \"\"\"Find the nearest reachable workshop among multiple workshops.\"\"\"\n    queue = collections.deque([state.pos])\n    visited = set()\n    \n    while queue:\n        current_pos = queue.popleft()\n        for i, workshop_index in enumerate(workshop_indices):\n            if state.grid[current_pos[0], current_pos[1]][workshop_index] == 1:\n                return current_pos, i\n        \n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            nx, ny = current_pos[0] + dx, current_pos[1] + dy\n            if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                if (nx, ny) not in visited and sum(state.grid[nx, ny]) == 0:\n                    visited.add((nx, ny))\n                    queue.append((nx, ny))\n    return None, None\n\n  def pathfinding(start_pos, end_pos, grid):\n    \"\"\"BFS for finding a path from start to end.\"\"\"\n    queue = collections.deque([(start_pos, [])])\n    visited = set([start_pos])\n    \n    while queue:\n        current_pos, path = queue.popleft()\n        if current_pos == end_pos:\n            return path + [end_pos]\n        \n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            nx, ny = current_pos[0] + dx, current_pos[1] + dy\n            if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n                if (nx, ny) not in visited and sum(grid[nx, ny]) == 0:\n                    visited.add((nx, ny))\n                    queue.append(((nx, ny), path + [current_pos]))\n    return []\n\n  def actions_from_path(path):\n      \"\"\"Convert a list of positions into a list of action indices.\"\"\"\n      if len(path) < 2:\n          return []\n      \n      actions = []\n      for i in range(1, len(path)):\n          dx = path[i][0] - path[i-1][0]\n          dy = path[i][1] - path[i-1][1]\n          \n          if dx == 1:\n              actions.append(craft.ACTION_DOWN)\n          elif dx == -1:\n              actions.append(craft.ACTION_UP)\n          elif dy == 1:\n              actions.append(craft.ACTION_RIGHT)\n          elif dy == -1:\n              actions.append(craft.ACTION_LEFT)\n      \n      return actions\n\n  def pick_up_primitives(state, primitives_required):\n    \"\"\"Pick up required primitives if they are not in the inventory.\"\"\"\n    actions = []\n    for primitive, count in primitives_required.items():\n        while state.inventory[primitive] < count:\n            # Find the nearest location of this primitive\n            primitive_pos = find_nearest_primitive(state.grid, primitive)\n            if primitive_pos is None:\n                return []  # No reachable primitive found\n            \n            # Move to the nearest location of the primitive\n            path_to_primitive = pathfinding(state.pos, primitive_pos, state.grid)\n            actions.extend(actions_from_path(path_to_primitive))\n            \n            # Perform the USE action to pick up the primitive\n            actions.append(craft.ACTION_USE)\n            \n            # Update the state after picking up the primitive\n            state.inventory[primitive] += 1\n    \n    return actions\n\n  def find_nearest_primitive(grid, primitive_index):\n      \"\"\"Find the nearest reachable location of a given primitive.\"\"\"\n      queue = collections.deque([(state.pos)])\n      visited = set()\n      \n      while queue:\n          current_pos = queue.popleft()\n          if grid[current_pos[0], current_pos[1]][primitive_index] == 1:\n              return current_pos\n          \n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = current_pos[0] + dx, current_pos[1] + dy\n              if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n                  if (nx, ny) not in visited and sum(grid[nx, ny]) == 0:\n                      visited.add((nx, ny))\n                      queue.append((nx, ny))\n      return None\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the goal is achievable (i.e., the item has a recipe)\n  if item_index not in env.world.cookbook.recipes:\n      return []\n\n  # Get the primitives required for crafting the item\n  primitives_required = env.world.cookbook.primitives_for(item_index)\n\n  actions = []\n  \n  # Pick up required primitives if they are not in the inventory\n  state = env._current_state\n  actions.extend(pick_up_primitives(state, primitives_required))\n\n  # Determine which workshops are required for crafting the item\n  workshop_indices = []\n  recipe = env.world.cookbook.recipes[item_index]\n  if \"_key\" in recipe:\n      key = recipe[\"_key\"]\n      if \"workshop0\" in key:\n          workshop_indices.append(env.world.workshop_indices[0])\n      if \"workshop1\" in key:\n          workshop_indices.append(env.world.workshop_indices[1])\n      if \"workshop2\" in key:\n          workshop_indices.append(env.world.workshop_indices[2])\n\n  if not workshop_indices:\n      return []  # No suitable workshops found for crafting\n\n  # Find the nearest reachable workshop among multiple workshops\n  workshop_pos, _ = find_nearest_workshop(state, workshop_indices)\n\n  if workshop_pos is None:\n      return []  # No reachable workshop found\n\n  # Move to the nearest workshop\n  path_to_workshop = pathfinding(state.pos, workshop_pos, state.grid)\n  actions.extend(actions_from_path(path_to_workshop))\n\n  # Perform the USE action at the workshop to craft the item\n  actions.append(craft.ACTION_USE)\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T11:53:13.514973", "function_name": "craft", "function_body": "  def move_to_workshop(current_pos):\n      workshops = []\n      for i, workshop_kind in enumerate(env.world.workshop_indices):\n          workshop_location = find_workshop(env._current_state.grid, workshop_kind)\n          if workshop_location:\n              workshops.append((workshop_location, i))\n      \n      if not workshops:\n          return []\n      \n      closest_workshop = min(workshops, key=lambda x: np.linalg.norm(np.array(x[0]) - np.array(current_pos)))\n      target_pos = closest_workshop[0]\n      \n      return move_to_location(current_pos, target_pos)\n\n  def find_workshop(grid, workshop_kind):\n      for i in range(grid.shape[0]):\n          for j in range(grid.shape[1]):\n              if grid[i, j, workshop_kind] == 1:\n                  return (i, j)\n      return None\n\n  def move_to_location(current_pos, target_pos):\n      actions = []\n      x_diff = target_pos[0] - current_pos[0]\n      y_diff = target_pos[1] - current_pos[1]\n\n      # Determine the direction to move based on the differences\n      if x_diff > 0:\n          actions.extend([3] * abs(x_diff))  # RIGHT\n      elif x_diff < 0:\n          actions.extend([2] * abs(x_diff))  # LEFT\n\n      if y_diff > 0:\n          actions.extend([1] * abs(y_diff))  # UP\n      elif y_diff < 0:\n          actions.extend([0] * abs(y_diff))  # DOWN\n      \n      return actions\n\n  def collect_primitives(env, required_primitives):\n      \"\"\"Generate actions to collect the required primitives.\"\"\"\n      actions = []\n      for primitive, count in required_primitives.items():\n          while env._current_state.inventory[primitive] < count:\n              available_locations = find_primitive_locations(env._current_state.grid, primitive)\n              if not available_locations:\n                  return []  # Unable to collect required primitives\n              target_pos = available_locations.pop()\n              actions.extend(move_to_location(env._current_state.pos, target_pos))\n              actions.append(4)  # Collect the primitive\n      return actions\n\n  def find_primitive_locations(grid, primitive_kind):\n      \"\"\"Find all locations of a given primitive in the grid.\"\"\"\n      locations = []\n      for i in range(grid.shape[0]):\n          for j in range(grid.shape[1]):\n              if grid[i, j, primitive_kind] == 1:\n                  locations.append((i, j))\n      return locations\n\n  actions = []\n\n  # Get the cookbook and its index mapping\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  # Get the required primitives to craft the item\n  required_primitives = cookbook.primitives_for(item_index)\n  \n  # Collect the required primitives if not enough in inventory\n  actions.extend(collect_primitives(env, required_primitives))\n  \n  # Move to a workshop and perform the USE action\n  actions.extend(move_to_workshop(env._current_state.pos))\n  \n  # Perform the USE action to craft the item at the workshop\n  actions.append(4)  # Assuming 4 is the action index for USE\n  \n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-06T11:58:13.579823", "function_name": "craft", "function_body": "  def move_to_workshop(current_pos):\n      workshops = []\n      for i, workshop_kind in enumerate(env.world.workshop_indices):\n          workshop_location = find_workshop(env._current_state.grid, workshop_kind)\n          if workshop_location:\n              workshops.append((workshop_location, i))\n      \n      if not workshops:\n          return []\n      \n      closest_workshop = min(workshops, key=lambda x: np.linalg.norm(np.array(x[0]) - np.array(current_pos)))\n      target_pos = closest_workshop[0]\n      \n      return move_to_location(current_pos, target_pos)\n\n  def find_workshop(grid, workshop_kind):\n      for i in range(grid.shape[0]):\n          for j in range(grid.shape[1]):\n              if grid[i, j, workshop_kind] == 1:\n                  return (i, j)\n      return None\n\n  def move_to_location(current_pos, target_pos):\n      actions = []\n      x_diff = target_pos[0] - current_pos[0]\n      y_diff = target_pos[1] - current_pos[1]\n\n      # Determine the direction to move based on the differences\n      if x_diff > 0:\n          actions.extend([3] * abs(x_diff))  # RIGHT\n      elif x_diff < 0:\n          actions.extend([2] * abs(x_diff))  # LEFT\n\n      if y_diff > 0:\n          actions.extend([1] * abs(y_diff))  # UP\n      elif y_diff < 0:\n          actions.extend([0] * abs(y_diff))  # DOWN\n      \n      return actions\n\n  def collect_primitives(env, required_primitives):\n      \"\"\"Generate actions to collect the required primitives.\"\"\"\n      actions = []\n      for primitive, count in required_primitives.items():\n          while env._current_state.inventory[primitive] < count:\n              available_locations = find_primitive_locations(env._current_state.grid, primitive)\n              if not available_locations:\n                  raise ValueError(f\"Not enough {env.world.cookbook.index.get_by_value(primitive)} to craft {item}\")\n              \n              target_pos = available_locations.pop()\n              actions.extend(move_to_location(env._current_state.pos, target_pos))\n              actions.append(4)  # Collect the primitive\n      return actions\n\n  def find_primitive_locations(grid, primitive_kind):\n      \"\"\"Find all locations of a given primitive in the grid.\"\"\"\n      locations = []\n      for i in range(grid.shape[0]):\n          for j in range(grid.shape[1]):\n              if grid[i, j, primitive_kind] == 1:\n                  locations.append((i, j))\n      return locations\n\n  actions = []\n\n  # Get the cookbook and its index mapping\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  # Get the required primitives to craft the item\n  required_primitives = cookbook.primitives_for(item_index)\n  \n  # Collect the required primitives if not enough in inventory\n  actions.extend(collect_primitives(env, required_primitives))\n  \n  # Move to a workshop and perform the USE action\n  actions.extend(move_to_workshop(env._current_state.pos))\n  \n  # Perform the USE action to craft the item at the workshop\n  actions.append(4)  # Assuming 4 is the action index for USE\n  \n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-06T11:59:19.658372", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n\n  # Check if we have all the required primitives in our inventory\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n  for primitive, count in required_primitives.items():\n    if env._current_state.inventory[primitive] < count:\n      return []  # Not enough primitives to craft the item\n\n  # Find a suitable workshop that can be used to craft the item\n  available_workshops = env.world.workshop_indices\n  suitable_workshop = None\n  \n  for workshop in available_workshops:\n    if workshop in required_primitives.values():\n      suitable_workshop = workshop\n      break\n\n  if not suitable_workshop:\n    return []  # No suitable workshop found to craft the item\n\n  # Calculate the path from the current position to the workshop\n  workshop_location = find_workshop_location(env, suitable_workshop)\n  path_to_workshop = calculate_path(env._current_state.pos, workshop_location)\n\n  # Generate actions to move the agent to the workshop\n  actions = [move_action(dir) for dir in path_to_workshop]\n  \n  # Add the USE action at the workshop location\n  actions.append(USE_ACTION)\n  \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T11:59:20.727657", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  current_state = env._current_state\n\n  # Get the index of the desired item\n  item_index = cookbook.index[item]\n\n  # Check if we have all required primitives in our inventory\n  required_primitives = cookbook.primitives_for(item_index)\n  \n  for primitive, count in required_primitives.items():\n    if current_state.inventory[primitive] < count:\n      return []  # Not enough primitives to craft the item\n\n  # Find a suitable workshop that can be used to craft the item\n  available_workshops = env.world.workshop_indices\n  suitable_workshop = None\n  \n  for workshop in available_workshops:\n    if cookbook.recipes[item_index].get(workshop, 0) > 0:\n      suitable_workshop = workshop\n      break\n\n  if not suitable_workshop:\n    return []  # No suitable workshop found to craft the item\n\n  # Calculate the path from the current position to the workshop\n  workshop_location = find_workshop_location(env, suitable_workshop)\n  path_to_workshop = calculate_path(current_state.pos, workshop_location)\n\n  # Generate actions to move the agent to the workshop\n  actions = [move_action(dir) for dir in path_to_workshop]\n  \n  # Add the USE action at the workshop location\n  actions.append(USE_ACTION)\n  \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
