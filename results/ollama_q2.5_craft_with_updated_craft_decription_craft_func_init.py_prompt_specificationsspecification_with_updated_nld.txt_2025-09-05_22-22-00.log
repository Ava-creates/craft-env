{"timestamp": "2025-09-06T15:10:24.676785", "function_name": "craft", "function_body": "  def move_to_workshop(current_pos):\n      workshops = []\n      for i, workshop_kind in enumerate(env.world.workshop_indices):\n          workshop_location = find_workshop(env._current_state.grid, workshop_kind)\n          if workshop_location:\n              workshops.append((workshop_location, i))\n      \n      if not workshops:\n          return []\n      \n      closest_workshop = min(workshops, key=lambda x: np.linalg.norm(np.array(x[0]) - np.array(current_pos)))\n      target_pos = closest_workshop[0]\n      \n      return move_to_location(current_pos, target_pos)\n\n  def find_workshop(grid, workshop_kind):\n      for i in range(grid.shape[0]):\n          for j in range(grid.shape[1]):\n              if grid[i, j, workshop_kind] == 1:\n                  return (i, j)\n      return None\n\n  def move_to_location(current_pos, target_pos):\n      actions = []\n      x_diff = target_pos[0] - current_pos[0]\n      y_diff = target_pos[1] - current_pos[1]\n\n      if x_diff > 0:\n          actions.extend([3] * abs(x_diff))  # RIGHT\n      elif x_diff < 0:\n          actions.extend([2] * abs(x_diff))  # LEFT\n\n      if y_diff > 0:\n          actions.extend([1] * abs(y_diff))  # UP\n      elif y_diff < 0:\n          actions.extend([0] * abs(y_diff))  # DOWN\n      \n      return actions\n\n  def collect_primitives(env, required_primitives):\n      \"\"\"Generate actions to collect the required primitives.\"\"\"\n      actions = []\n      for primitive, count in required_primitives.items():\n          if env._current_state.inventory[primitive] < count:\n              available_locations = find_primitive_locations(env._current_state.grid, primitive)\n              while env._current_state.inventory[primitive] < count and available_locations:\n                  target_pos = available_locations.pop()\n                  actions.extend(move_to_location(env._current_state.pos, target_pos))\n                  actions.append(4)  # Collect the primitive\n      return actions\n\n  def find_primitive_locations(grid, primitive_kind):\n      \"\"\"Find all locations of a given primitive in the grid.\"\"\"\n      locations = []\n      for i in range(grid.shape[0]):\n          for j in range(grid.shape[1]):\n              if grid[i, j, primitive_kind] == 1:\n                  locations.append((i, j))\n      return locations\n\n  actions = []\n\n  # Get the cookbook and its index mapping\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  # Get the required primitives to craft the item\n  required_primitives = cookbook.primitives_for(item_index)\n  \n  if not required_primitives:\n      return []  # No primitives needed, return empty actions\n  \n  # Collect the required primitives if not enough in inventory\n  actions.extend(collect_primitives(env, required_primitives))\n  \n  # Move to a workshop and perform the USE action\n  actions.extend(move_to_workshop(env._current_state.pos))\n  \n  # Perform the USE action to craft the item at the workshop\n  actions.append(4)  # Assuming 4 is the action index for USE\n  \n  return actions", "island_id": 8, "scores": {"3": 5.6}}
{"timestamp": "2025-09-06T15:13:43.671664", "function_name": "craft", "function_body": "  def move_towards(target_pos):\n    \"\"\"\n    Helper function to calculate actions needed to move from current position to target position.\n    \n    Args:\n      target_pos (tuple): Target position (x, y).\n      \n    Returns:\n      List[int]: List of action indices representing the sequence of movements.\n    \"\"\"\n    x_diff = target_pos[0] - env._current_state.pos[0]\n    y_diff = target_pos[1] - env._current_state.pos[1]\n\n    actions = []\n    \n    # Determine direction to move in\n    if x_diff < 0:\n        for _ in range(-x_diff):\n            actions.append(craft.LEFT)\n    elif x_diff > 0:\n        for _ in range(x_diff):\n            actions.append(craft.RIGHT)\n\n    if y_diff < 0:\n        for _ in range(-y_diff):\n            actions.append(craft.DOWN)\n    elif y_diff > 0:\n        for _ in range(y_diff):\n            actions.append(craft.UP)\n\n    return actions\n\n  def get_primitive_positions(primitive_index, grid):\n    \"\"\"\n    Helper function to find all positions of a primitive resource in the environment.\n    \n    Args:\n      primitive_index (int): Index of the primitive resource.\n      grid (numpy.ndarray): The current state grid of the environment.\n      \n    Returns:\n      List[tuple]: List of positions where the primitive is found.\n    \"\"\"\n    return np.argwhere(grid.sum(axis=2) == primitive_index)\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Retrieve the primitives required for crafting the item\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  \n  # Initialize a list to store the actions required to craft the item\n  actions_to_take = []\n\n  # Check if we have all the required primitives in our inventory\n  inventory = env._current_state.inventory\n\n  for primitive, count in primitives_needed.items():\n    if inventory[primitive] < count:\n        primitive_positions = get_primitive_positions(primitive, env._current_state.grid)\n        \n        if len(primitive_positions) == 0:\n            return []  # No primitives available in the environment\n        \n        nearest_position = tuple(min(primitive_positions, key=lambda p: np.linalg.norm(np.array(p) - np.array(env._current_state.pos))))\n        \n        # Move towards the nearest primitive resource\n        actions_to_take.extend(move_towards(nearest_position))\n        \n        # Collect the primitive by using the USE action\n        actions_to_take.append(craft.USE)\n  \n  # Find a workshop index that can be used to craft the desired item\n  workshop_indices = []\n  for recipe in env.world.cookbook.recipes.values():\n    key = recipe.get(\"_key\")\n    if key == item_index:\n      workshops = recipe.get(\"workshop\", [])\n      if not isinstance(workshops, list):\n          workshops = [workshops]\n      workshop_indices.extend(workshops)\n\n  # Find the nearest workshop of any suitable type\n  all_workshops = np.argwhere(np.isin(env._current_state.grid.sum(axis=2), workshop_indices))\n\n  if len(all_workshops) == 0:\n    return []  # No workshops available\n\n  # Calculate distances to each workshop from the current position\n  pos = np.array(env._current_state.pos)\n  distances = np.linalg.norm(all_workshops - pos, axis=1)\n\n  # Find the nearest workshop\n  nearest_workshop_pos = tuple(all_workshops[np.argmin(distances)])\n\n  # Move towards the nearest workshop and add actions to list\n  actions_to_take.extend(move_towards(nearest_workshop_pos))\n\n  # Use the USE action to craft the item at the workshop\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T15:13:44.737200", "function_name": "craft", "function_body": "  def move_towards(target_pos):\n    \"\"\"\n    Helper function to calculate actions needed to move from current position to target position.\n    \n    Args:\n      target_pos (tuple): Target position (x, y).\n      \n    Returns:\n      List[int]: List of action indices representing the sequence of movements.\n    \"\"\"\n    x_diff = target_pos[0] - env._current_state.pos[0]\n    y_diff = target_pos[1] - env._current_state.pos[1]\n\n    actions = []\n    \n    # Determine direction to move in\n    if x_diff < 0:\n        for _ in range(-x_diff):\n            actions.append(craft.LEFT)\n    elif x_diff > 0:\n        for _ in range(x_diff):\n            actions.append(craft.RIGHT)\n\n    if y_diff < 0:\n        for _ in range(-y_diff):\n            actions.append(craft.DOWN)\n    elif y_diff > 0:\n        for _ in range(y_diff):\n            actions.append(craft.UP)\n\n    return actions\n\n  def nearest_workshop(workshops):\n    \"\"\"\n    Helper function to find the nearest workshop from the current position.\n    \n    Args:\n      workshops (np.ndarray): Array of positions (x, y) of all available workshops.\n      \n    Returns:\n      Tuple[int]: Position of the nearest workshop.\n    \"\"\"\n    pos = np.array(env._current_state.pos)\n    distances = np.linalg.norm(workshops - pos, axis=1)\n    return tuple(workshops[np.argmin(distances)])\n\n  def collect_primitive(primitive_index):\n    \"\"\"\n    Helper function to collect the required primitive if not available in inventory.\n    \n    Args:\n      primitive_index (int): Index of the primitive item.\n      \n    Returns:\n      List[int]: List of action indices representing the sequence of movements and collection actions.\n    \"\"\"\n    grid = env._current_state.grid\n    primitive_positions = np.argwhere(grid.sum(axis=2) == primitive_index)\n\n    if len(primitive_positions) == 0:\n        return []  # No primitives available to collect\n\n    nearest_primitive_pos = nearest_workshop(primitive_positions)\n    \n    # Move towards the nearest primitive position and add actions to list\n    actions = move_towards(nearest_primitive_pos)\n    actions.append(craft.COLLECT_FUNC)\n\n    return actions\n  \n  item_index = env.world.cookbook.index[item]\n  \n  # Retrieve the primitives required for crafting the item\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  \n  # Initialize a list to store the actions required to craft the item\n  actions_to_take = []\n\n  # Check if we have all the required primitives in our inventory\n  inventory = env._current_state.inventory\n\n  for primitive, count in primitives_needed.items():\n    while inventory[primitive] < count:\n      # Collect the required primitive\n      actions_to_take.extend(collect_primitive(primitive))\n      \n      # Update the inventory after collecting the primitive\n      state_prime, _, _ = env.step(actions_to_take[-1])\n      inventory = state_prime.inventory\n\n  # Find a workshop index that can be used to craft the desired item\n  workshop_indices = []\n  for recipe in env.world.cookbook.recipes.values():\n    key = recipe.get(\"_key\")\n    if key == item_index:\n      workshops = recipe.get(\"workshop\", [])\n      if not isinstance(workshops, list):\n          workshops = [workshops]\n      workshop_indices.extend(workshops)\n\n  # Find the nearest workshop of any suitable type\n  grid = env._current_state.grid\n  all_workshops = np.argwhere(np.isin(grid.sum(axis=2), workshop_indices))\n\n  if len(all_workshops) == 0:\n    return []  # No workshops available\n\n  # Calculate distances to each workshop from the current position\n  nearest_workshop_pos = nearest_workshop(all_workshops)\n\n  # Move towards the nearest workshop and add actions to list\n  actions_to_take.extend(move_towards(nearest_workshop_pos))\n\n  # Use the USE action to craft the item at the workshop\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-06T15:22:00.783476", "function_name": "craft", "function_body": "  def move_to_workshop(current_pos):\n      workshops = []\n      for i, workshop_kind in enumerate(env.world.workshop_indices):\n          workshop_location = find_workshop(env._current_state.grid, workshop_kind)\n          if workshop_location:\n              workshops.append((workshop_location, i))\n      \n      if not workshops:\n          return []\n      \n      closest_workshop = min(workshops, key=lambda x: np.linalg.norm(np.array(x[0]) - np.array(current_pos)))\n      target_pos = closest_workshop[0]\n      \n      return move_to_location(current_pos, target_pos)\n\n  def find_workshop(grid, workshop_kind):\n      for i in range(grid.shape[0]):\n          for j in range(grid.shape[1]):\n              if grid[i, j, workshop_kind] == 1:\n                  return (i, j)\n      return None\n\n  def move_to_location(current_pos, target_pos):\n      actions = []\n      x_diff = target_pos[0] - current_pos[0]\n      y_diff = target_pos[1] - current_pos[1]\n\n      # Ensure the agent faces the correct direction before moving\n      if x_diff > 0:\n          actions.extend([3] * abs(x_diff))  # RIGHT\n      elif x_diff < 0:\n          actions.extend([2] * abs(x_diff))  # LEFT\n\n      if y_diff > 0:\n          actions.extend([1] * abs(y_diff))  # UP\n      elif y_diff < 0:\n          actions.extend([0] * abs(y_diff))  # DOWN\n      \n      return actions\n\n  def collect_primitives(env, required_primitives):\n      \"\"\"Generate actions to collect the required primitives.\"\"\"\n      actions = []\n      for primitive, count in required_primitives.items():\n          while env._current_state.inventory[primitive] < count:\n              available_locations = find_primitive_locations(env._current_state.grid, primitive)\n              if not available_locations:\n                  print(f\"No more {env.world.cookbook.index.get(primitive)} available to collect.\")\n                  return []\n              target_pos = available_locations.pop()\n              actions.extend(move_to_location(env._current_state.pos, target_pos))\n              actions.append(4)  # Collect the primitive\n      return actions\n\n  def find_primitive_locations(grid, primitive_kind):\n      \"\"\"Find all locations of a given primitive in the grid.\"\"\"\n      locations = []\n      for i in range(grid.shape[0]):\n          for j in range(grid.shape[1]):\n              if grid[i, j, primitive_kind] == 1:\n                  locations.append((i, j))\n      return locations\n\n  actions = []\n\n  # Get the cookbook and its index mapping\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  # Get the required primitives to craft the item\n  required_primitives = cookbook.primitives_for(item_index)\n  \n  if not required_primitives:\n      print(f\"No primitives required for {item}.\")\n      return []\n  \n  # Collect the required primitives if not enough in inventory\n  actions.extend(collect_primitives(env, required_primitives))\n  \n  if not actions:  # If no actions were generated to collect primitives, return an empty list\n      return []\n\n  # Move to a workshop and perform the USE action\n  actions.extend(move_to_workshop(env._current_state.pos))\n  \n  # Perform the USE action to craft the item at the workshop\n  actions.append(4)  # Assuming 4 is the action index for USE\n  \n  return actions", "island_id": 5, "scores": {"3": -1}}
