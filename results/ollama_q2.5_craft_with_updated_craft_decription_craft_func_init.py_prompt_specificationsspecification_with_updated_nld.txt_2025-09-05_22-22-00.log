   actions.extend(move_to_location(env._current_state.pos, target_pos))\n                  actions.append(4)  # Collect the primitive\n      return actions\n\n  def find_primitive_locations(grid, primitive_kind):\n      \"\"\"Find all locations of a given primitive in the grid.\"\"\"\n      locations = []\n      for i in range(grid.shape[0]):\n          for j in range(grid.shape[1]):\n              if grid[i, j, primitive_kind] == 1:\n                  locations.append((i, j))\n      return locations\n\n  def rotate_directions(directions):\n      \"\"\"Rotate directions to ensure agent faces the correct direction.\"\"\"\n      rotated_directions = []\n      current_direction = env._current_state.pos\n      for action in directions:\n          if action == 0:  # UP\n              if current_direction[1] < target_pos[1]:\n                  rotated_directions.append(1)  # Change to UP\n              else:\n                  rotated_directions.append(3)  # Change to DOWN\n          elif action == 1:  # DOWN\n              if current_direction[1] > target_pos[1]:\n                  rotated_directions.append(0)  # Change to DOWN\n              else:\n                  rotated_directions.append(2)  # Change to UP\n          elif action == 2:  # LEFT\n              if current_direction[0] < target_pos[0]:\n                  rotated_directions.append(3)  # Change to RIGHT\n              else:\n                  rotated_directions.append(1)  # Change to LEFT\n          elif action == 3:  # RIGHT\n              if current_direction[0] > target_pos[0]:\n                  rotated_directions.append(2)  # Change to LEFT\n              else:\n                  rotated_directions.append(0)  # Change to RIGHT\n      return rotated_directions\n\n  actions = []\n\n  # Get the cookbook and its index mapping\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  # Get the required primitives to craft the item\n  required_primitives = cookbook.primitives_for(item_ind