 turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set includes the agent's inventory as part of the state key.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing.\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Increased MAX_EXPLORED_STATES due to the larger state space when tracking inventory.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Improvement for `collect_v2`: Goal Check - First, check if the primitive is directly under the agent's feet.\n    # This applies to grabbable items that can be picked up by standing on them and using USE.\n    if i_kind in world.grabbable_indices and state.grid[current_r, current_c, i_kind] == 1:\n        inventory_before_use_on_self = np.copy(state.inventory)\n        _, state_after_use_on_self = state.step(USE_ACT)\n        # Verify successful collection\n        if state_after_use_on_self.inventory[i_kind] > inventory_before_use_on_self[i_kind]:\n            return path + [USE_ACT] # Collected by using at current position\n\n    # Goal Check: Check for primitive in adjacent cells (cardinal directions).\n    # This check relies on `state.next_to(i_kind)` which covers the 3x3 neighborhood.\n    # We then iterate through cardinal directions to find the specific cell and face it.\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Ensure facing cell is within grid bounds and contains the target primitive\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                temp_state_after_turns = state \n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action on the cell in front.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the USE action from the current position generally.\n    # This is important if using an item at the current position (e.g., picking up a tool,\n    # or interacting with a workshop) changes the inventory state, which might be necessary\n    # for later steps to collect the *target* primitive. This complements the specific\n    # goal checks above.\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if the USE action resulted in a meaningful state change (inventory, position, or direction).\n    # This prevents adding redundant states to the queue if USE had no effect.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T06:22:06.218765", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (r, c)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  action_map = env.action_specs()\n  # Map DSL movement/turn actions to their integer indices from action_specs\n  # Assuming UP/DOWN are Forward/Backward and LEFT/RIGHT are Turn Left/Right\n  # This interpretation is common for DMLab-style environments where agent has a facing direction.\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  # This defines how position changes when moving \"forward\" in a given direction.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT, move in positive column direction\n      1: (-1, 0),  # Facing UP, move in negative row direction\n      2: (0, -1),  # Facing LEFT, move in negative column direction\n      3: (1, 0)    # Facing DOWN, move in positive column direction\n  }\n\n  # Map for turning left/right, updating the agent's direction (0-3)\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # R->U->L->D->R\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # R->D->L->U->R\n\n  # Get indices of non-grabbable items that block movement (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # BFS state: ((row, col), direction), path_actions\n  # Queue stores ( (current_pos_tuple, current_dir_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (current_pos_tuple, current_dir_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # Stores the action list to reach the target state\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent at current state\n      # Calculate the coordinates of the cell directly in front\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if front_cell is within grid bounds\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          # Check if the front_cell contains the primitive\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Path to target found (agent is adjacent and facing the primitive)\n\n      # 2. Explore possible next actions: Move Forward, Turn Left, Turn Right\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if next_pos is within bounds and this (position, direction) state hasn't been visited\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT and\n          (next_pos, next_dir) not in visited):\n          \n          # Check if next_pos is walkable\n          # A cell is walkable if it doesn't contain any non-walkable entity (e.g., boundary, water)\n          is_walkable = True\n          for kind_idx in non_walkable_kinds_indices:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          # Agent cannot walk onto the primitive itself, only up to it to use it.\n          if initial_grid[next_r, next_c, primitive_id] > 0:\n              is_walkable = False\n\n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path was found, append the USE action to the sequence\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 1, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T06:22:07.472760", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n\n  This function uses a Breadth-First Search (BFS) to find the shortest\n  sequence of actions (movement and turns) to bring the agent adjacent\n  to the specified primitive, facing it, and then appends a 'USE' action.\n\n  Args:\n      env (env.CraftLab): The CraftLab object representing the current environment.\n      primitive (str): The string name of the primitive resource to collect.\n\n  Returns:\n      List[int]: A sequence of action indices to execute to collect the primitive.\n                 Returns an empty list if the primitive is unreachable.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's current (row, column) tuple\n  initial_dir = current_state.dir # Agent's current facing direction (0:Right, 1:Up, 2:Left, 3:Down)\n\n  # Get the integer ID for the target primitive from the cookbook index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # Map symbolic actions from action_specs to their integer indices\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # Assumed to be forward movement\n  TURN_LEFT_ACTION = action_map['LEFT']     # Assumed to be turn left\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Assumed to be turn right\n  USE_ACTION = action_map['USE']            # Action to interact with an object\n\n  # Define changes in (row, col) for each direction (0:R, 1:U, 2:L, 3:D)\n  # When agent moves \"forward\" (using MOVE_FORWARD_ACTION)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: +1 to column\n      1: (-1, 0),  # Facing UP: -1 to row\n      2: (0, -1),  # Facing LEFT: -1 to column\n      3: (1, 0)    # Facing DOWN: +1 to row\n  }\n\n  # Define how direction changes when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Get indices of entities that block agent movement (non-walkable terrain/objects)\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n  # Create a set of non-walkable indices for efficient lookups.\n  # The primitive itself is typically not walkable, as the agent stands adjacent to collect it.\n  non_walkable_for_movement = set(non_walkable_kinds_indices)\n  non_walkable_for_movement.add(primitive_id)\n\n\n  # BFS state: ((current_row, current_col), current_direction_int)\n  # Queue stores (state, list_of_actions_to_reach_this_state)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (state) to avoid redundant computations and cycles\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the action sequence leading to the state\n                      # where the agent is adjacent to the primitive and facing it.\n\n  # Helper function to check if a cell is walkable\n  def _is_cell_walkable(r, c, grid, non_walkable_indices_set):\n      \"\"\"Checks if the cell at (r, c) is within bounds and doesn't contain non-walkable items.\"\"\"\n      if not (0 <= r < WIDTH and 0 <= c < HEIGHT):\n          return False # Out of bounds\n      \n      # Check if any non-walkable item exists in this cell\n      for kind_idx in non_walkable_indices_set:\n          if grid[r, c, kind_idx] > 0:\n              return False # Contains a non-walkable item\n      return True\n\n  while queue:\n      (current_pos, current_dir), path_to_current_state = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent at current state\n      # Calculate the coordinates of the cell directly in front of the agent\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the cell in front is within grid bounds AND contains the primitive\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT and\n          initial_grid[front_r, front_c, primitive_id] > 0):\n          \n          target_path = path_to_current_state\n          break # Found the path to be adjacent and facing the primitive\n\n      # 2. Explore possible next actions from the current state (Move Forward, Turn Left, Turn Right)\n      \n      # Try Move Forward (equivalent to 'UP' in action_specs for movement)\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if the next position is valid and has not been visited with this direction\n      if (next_pos, next_dir) not in visited:\n          # Use the helper to check walkability, passing the set of non-walkable kinds\n          if _is_cell_walkable(next_r, next_c, initial_grid, non_walkable_for_movement):\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_to_current_state + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_to_current_state + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_to_current_state + [TURN_RIGHT_ACTION]))\n\n  # If a path was found to reach an adjacent and facing position, append the USE action\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 1, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T06:23:42.120276", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  grid_snapshot = current_state.grid\n  start_pos = current_state.pos # tuple (r, c)\n  start_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  target_primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = grid_snapshot.shape\n\n  action_map = env.action_specs()\n  # Map DSL movement/turn actions to their integer indices from action_specs\n  MOVE_FORWARD = action_map['UP'] # Agent moves forward in its current direction\n  TURN_LEFT = action_map['LEFT']   # Agent turns left in place\n  TURN_RIGHT = action_map['RIGHT'] # Agent turns right in place\n  USE_ACTION = action_map['USE']   # Agent uses the item in front of it\n\n  # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  # This defines how position changes when moving \"forward\".\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT (positive column change)\n      1: (-1, 0),  # Facing UP (negative row change)\n      2: (0, -1),  # Facing LEFT (negative column change)\n      3: (1, 0)    # Facing DOWN (positive row change)\n  }\n\n  # Map for turning left/right, updating the agent's direction (0-3)\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Get indices of non-grabbable items that block movement (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  non_walkable_kind_ids = current_state.world.non_grabbable_indices\n\n  # BFS state: ((row, col), direction), path_actions\n  # Queue stores ( (current_pos_tuple, current_dir_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((start_pos, start_dir), [])])\n  # Visited set stores (current_pos_tuple, current_dir_int) to avoid cycles and redundant paths\n  visited = {(start_pos, start_dir)}\n\n  target_path = None # Stores the action list to reach the target state\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # Check if the primitive is directly in front of the agent at the current state.\n      # If so, this is a valid state to perform the USE action to collect it.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the cell in front is within grid bounds\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          # Check if the cell in front contains the target primitive\n          if grid_snapshot[front_r, front_c, target_primitive_id] > 0:\n              target_path = path_actions\n              break # Path to target found! (agent is adjacent to and facing the primitive)\n\n      # Explore possible next actions: Move Forward, Turn Left, Turn Right\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir_after_move = current_dir # Moving forward does not change facing direction\n\n      # Check if next_pos is within bounds and this (position, direction) state hasn't been visited\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT and\n          (next_pos, next_dir_after_move) not in visited):\n          \n          # Check if the potential next_pos is walkable.\n          # A cell is walkable if it does not contain any non-walkable entity (e.g., boundary, water, workshop).\n          # Also, the agent cannot walk *onto* the primitive it wants to collect, only adjacent to it.\n          is_walkable = True\n          for kind_idx in non_walkable_kind_ids:\n              if grid_snapshot[next_r, next_c, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          \n          # If still walkable, ensure it's not the primitive itself (agent must remain adjacent)\n          if is_walkable and grid_snapshot[next_r, next_c, target_primitive_id] > 0:\n              is_walkable = False\n\n          if is_walkable:\n              visited.add((next_pos, next_dir_after_move))\n              queue.append(((next_pos, next_dir_after_move), path_actions + [MOVE_FORWARD]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT]))\n\n  # If a path was found, append the USE action to the sequence of actions.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T06:23:43.376508", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (r, c)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = initial_grid.shape # (rows, columns, kinds)\n\n  action_map = env.action_specs()\n  USE_ACTION = action_map['USE']\n\n  non_grabbable_indices = current_state.world.non_grabbable_indices\n\n  # Define the BFS helper function locally to encapsulate pathfinding logic.\n  # This makes the collect_v1 function cleaner and more modular.\n  def _find_path_to_adjacent_facing_primitive(\n      start_pos: tuple[int, int],\n      start_dir: int,\n      target_primitive_id: int,\n  ) -> list[int] | None:\n      \"\"\"\n      Internal helper function to find a sequence of movement/turn actions (BFS)\n      to reach a state where the agent is adjacent to and facing the target primitive.\n      \n      This function captures `WIDTH`, `HEIGHT`, `initial_grid`, `action_map`,\n      and `non_grabbable_indices` from the outer scope.\n      \"\"\"\n      # Extract action indices from the outer scope's action_map\n      MOVE_FORWARD_ACTION = action_map['UP']\n      TURN_LEFT_ACTION = action_map['LEFT']\n      TURN_RIGHT_ACTION = action_map['RIGHT']\n\n      # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n      # This defines how position changes when moving \"forward\".\n      DIR_TO_DRDC = {\n          0: (0, 1),   # Facing RIGHT, move in positive column direction\n          1: (-1, 0),  # Facing UP, move in negative row direction\n          2: (0, -1),  # Facing LEFT, move in negative column direction\n          3: (1, 0)    # Facing DOWN, move in positive row direction\n      }\n\n      # Map for updating agent's direction when turning left/right\n      TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n      TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n      # BFS Queue: stores ( (current_pos_tuple, current_dir_int), list_of_actions_to_reach_here )\n      queue = collections.deque([((start_pos, start_dir), [])])\n      # Visited set: stores (position_tuple, direction_int) to avoid redundant paths and cycles\n      visited = {(start_pos, start_dir)}\n\n      while queue:\n          (current_pos, current_dir), path_actions = queue.popleft()\n          r, c = current_pos\n\n          # 1. Check if the current state satisfies the target condition:\n          # The primitive must be in the cell directly in front of the agent.\n          front_dr, front_dc = DIR_TO_DRDC[current_dir]\n          front_r, front_c = r + front_dr, c + front_dc\n\n          # Ensure the cell in front is within grid bounds\n          if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n              # Check if the cell in front contains the target primitive\n              if initial_grid[front_r, front_c, target_primitive_id] > 0:\n                  return path_actions # Path found, return the sequence of actions\n\n          # 2. Explore possible next actions: Move Forward, Turn Left, Turn Right\n          \n          # Try Move Forward\n          move_dr, move_dc = DIR_TO_DRDC[current_dir]\n          next_r, next_c = r + move_dr, c + move_dc\n          next_pos = (next_r, next_c)\n          next_dir = current_dir # Moving forward does not change facing direction\n\n          # Check if the next position is within bounds and this (position, direction) state hasn't been visited\n          if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT and\n              (next_pos, next_dir) not in visited):\n              \n              # Determine if the next position is walkable:\n              # - Cannot contain any entities globally defined as non-grabbable (e.g., boundaries, water, workshops)\n              # - Cannot be the target primitive itself (agent steps *adjacent* to it, not *onto* it, before using).\n              is_walkable = True\n              for kind_idx in non_grabbable_indices:\n                  if initial_grid[next_r, next_c, kind_idx] > 0:\n                      is_walkable = False\n                      break\n              if initial_grid[next_r, next_c, target_primitive_id] > 0:\n                  is_walkable = False # Prevent walking onto the primitive\n\n              if is_walkable:\n                  visited.add((next_pos, next_dir))\n                  queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n          # Try Turn Left\n          next_dir_left = TURN_LEFT_MAP[current_dir]\n          # Turning does not change position, only direction.\n          if ((current_pos, next_dir_left) not in visited):\n              visited.add((current_pos, next_dir_left))\n              queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n          # Try Turn Right\n          next_dir_right = TURN_RIGHT_MAP[current_dir]\n          # Turning does not change position, only direction.\n          if ((current_pos, next_dir_right) not in visited):\n              visited.add((current_pos, next_dir_right))\n              queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n      return None # No path found after exploring all reachable states\n\n  # Call the nested BFS helper function to find the movement/turn sequence\n  path_to_primitive = _find_path_to_adjacent_facing_primitive(\n      start_pos=initial_pos,\n      start_dir=initial_dir,\n      target_primitive_id=primitive_id,\n  )\n\n  # If a valid path to the primitive was found, append the 'USE' action to the sequence.\n  # The 'USE' action is assumed to \"collect\" the primitive once the agent is in the correct position.\n  if path_to_primitive is not None:\n      actions_list.extend(path_to_primitive)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T06:24:37.352525", "function_name": "collect", "function_body": "", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-08-01T06:24:38.615870", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`. Finds a path to collect a primitive by getting\n  in front of it and then using the 'USE' action. Handles non-grabbable primitives.\n\n  Args:\n      env (env.CraftLab): The CraftLab object.\n      primitive (str): The name of the primitive to collect.\n\n  Returns:\n      List[int]: A sequence of action indices to execute.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state\n\n  # Store initial grid, position, and direction for pathfinding.\n  # The grid is considered static during pathfinding; only agent's (pos, dir) changes.\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's starting row, column tuple (r, c)\n  initial_dir = current_state.dir # Agent's starting direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the world's cookbook index.\n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  # Get grid dimensions to check boundaries during pathfinding.\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # --- Early Exit: If the primitive is not grabbable, collecting it is not possible. ---\n  # This includes things like BOUNDARY, WATER, WORKSHOP_X as defined in the DSL as primitives.\n  if primitive_id not in current_state.world.grabbable_indices:\n      return []\n\n  # Retrieve the mapping from action names (strings) to their integer codes.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define direction vectors for moving forward based on current orientation.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT (0): move +1 column\n      1: (-1, 0),  # Facing UP (1): move -1 row\n      2: (0, -1),  # Facing LEFT (2): move -1 column\n      3: (1, 0)    # Facing DOWN (3): move +1 row\n  }\n\n  # Define how agent's direction changes when turning left or right.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # Define entities that block agent movement.\n  # These are typically non-grabbable structures like boundaries, water, workshops.\n  obstacles_to_movement_indices = set(current_state.world.non_grabbable_indices)\n  \n  # A grabbable primitive itself also acts as an obstacle to movement;\n  # the agent should not move *onto* the primitive's square to collect it.\n  # Instead, it should position itself adjacent and use 'USE'.\n  # This is only added if it's grabbable, which is ensured by the early exit.\n  obstacles_to_movement_indices.add(primitive_id)\n\n  # --- Nested Helper Functions ---\n  def _is_cell_walkable(r, c):\n      \"\"\"Checks if a given grid cell (r, c) is within bounds and does not contain any obstacle.\"\"\"\n      if not (0 <= r < WIDTH and 0 <= c < HEIGHT):\n          return False  # Out of bounds\n\n      # Check if the cell contains any defined obstacle kind.\n      # The `initial_grid` represents the fixed map layout.\n      for kind_idx in obstacles_to_movement_indices:\n          if initial_grid[r, c, kind_idx] > 0:\n              return False  # Contains a non-walkable item/obstacle\n\n      return True\n\n  def _is_primitive_in_front_of_agent(agent_r, agent_c, agent_dir):\n      \"\"\"Checks if the target primitive is in the cell directly in front of the agent.\"\"\"\n      dr, dc = DIR_TO_DRDC[agent_dir]\n      front_r, front_c = agent_r + dr, agent_c + dc\n      \n      # Check bounds for the cell in front\n      if not (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          return False\n      \n      # Check if the primitive is in that front cell.\n      # `initial_grid` is used because the map contents don't change during pathfinding.\n      if initial_grid[front_r, front_c, primitive_id] > 0:\n          return True\n      return False\n  # --- End of Nested Helper Functions ---\n\n  # Optimization: If the primitive is already directly in front of the agent's initial position\n  # and orientation, we can just perform the USE action without pathfinding.\n  if _is_primitive_in_front_of_agent(initial_pos[0], initial_pos[1], initial_dir):\n      return [USE_ACTION]\n\n  # Initialize Breadth-First Search (BFS) for pathfinding.\n  # The queue stores tuples:\n  #   ((current_position_tuple (r, c), current_direction_int), list_of_actions_taken_to_reach_here)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # The 'visited' set keeps track of (position, direction) pairs already explored\n  # to prevent cycles and redundant computations, ensuring the shortest path is found.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # This will store the shortest action sequence to a collectable state.\n\n  # Main BFS loop: continues until the queue is empty or a path is found.\n  while queue:\n      # Dequeue the current state and the path leading to it.\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # Check if the current agent state (position and direction) is a goal state,\n      # meaning the primitive is directly in front and ready for collection.\n      if _is_primitive_in_front_of_agent(r, c, current_dir):\n          target_path_actions = path_actions # A shortest path to this collectible state is found.\n          break # Terminate BFS; no need to explore further as BFS finds the shortest path.\n\n      # Explore possible next states by applying valid actions: Move Forward, Turn Left, Turn Right.\n\n      # 1. Try MOVE_FORWARD_ACTION:\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change the agent's facing direction.\n\n      # If the next cell is walkable and this (position, direction) state has not been visited:\n      if _is_cell_walkable(next_r, next_c) and\\\n         (next_pos, next_dir) not in visited:\n          visited.add((next_pos, next_dir)) # Mark the new state as visited.\n          # Add the new state to the queue with the updated path.\n          queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # 2. Try TURN_LEFT_ACTION:\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if (current_pos, next_dir_left) not in visited:\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # 3. Try TURN_RIGHT_ACTION:\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if (current_pos, next_dir_right) not in visited:\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # After BFS completes:\n  # If a path to a collectable position and orientation was found,\n  # append the final 'USE' action to perform the collection.\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T06:25:21.394381", "function_name": "collect", "function_body": "  current_state = env._current_state\n  \n  # --- 1. Initialize Action Map and Primitive ID ---\n  primitive_idx = env.world.cookbook.index.index(primitive)\n  \n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # --- 2. Prerequisite Check: Ensure the primitive is actually grabbable ---\n  # The 'collect' function implies picking up an item into inventory.\n  # If the item is not registered as 'grabbable' in the world, it cannot be collected\n  # into inventory via the 'USE' action (e.g., water, boundary, workshops are not grabbable).\n  if primitive_idx not in env.world.grabbable_indices:\n      return []\n\n  # --- 3. Early Exit: If primitive is already in inventory ---\n  # If the agent already possesses the primitive, no actions are needed.\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # --- 4. Immediate Collection Check: Agent already adjacent ---\n  # If the agent is currently in a position where the 'USE' action can collect the primitive,\n  # (i.e., the primitive is within the 3x3 neighborhood of the agent's position),\n  # then only the 'USE' action is required.\n  if current_state.next_to(primitive_idx):\n    return [USE]\n\n  # --- 5. Identify all physical locations of the primitive on the grid ---\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  primitive_locations_on_grid = [] \n  for x in range(grid_width):\n    for y in range(grid_height):\n      # Check if the primitive kind exists at this cell (count > 0).\n      if grid[x, y, primitive_idx] > 0:\n        primitive_locations_on_grid.append((x, y))\n\n  # If no instances of the primitive are found on the grid, it's currently unreachable.\n  if not primitive_locations_on_grid:\n    return []\n\n  # --- 6. Determine \"Goal Cells\" for Pathfinding ---\n  # These are the grid cells where the agent needs to stand to successfully\n  # perform the 'USE' action to collect the primitive. Given `CraftState.next_to`\n  # checks the 3x3 neighborhood, any cell within 1 Manhattan distance (or on top of)\n  # a primitive's location is a valid goal cell for the agent's position.\n  collectible_agent_positions = set()\n  for px, py in primitive_locations_on_grid:\n    # Iterate through the 3x3 neighborhood around the primitive's location (px, py).\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        ax, ay = px + dx, py + dy # Candidate agent position\n        # Ensure the candidate agent position is within grid boundaries.\n        if 0 <= ax < grid_width and 0 <= ay < grid_height:\n          collectible_agent_positions.add((ax, ay))\n  \n  # This case should ideally not happen if primitive_locations_on_grid is not empty\n  # and grid dimensions are reasonable, but included for robustness.\n  if not collectible_agent_positions:\n      return []\n\n  # --- 7. Define Impassable Terrain Kinds ---\n  # These are entities that block agent movement. In CraftWorld, non-grabbable\n  # entities are generally impassable, except for workshops, which are traversable.\n  impassable_terrain_kinds = set(env.world.non_grabbable_indices) - set(env.world.workshop_indices)\n\n  # --- 8. Perform Breadth-First Search (BFS) for the shortest path ---\n  # Find the shortest sequence of movement actions from the agent's current position\n  # to any of the `collectible_agent_positions`.\n  start_position = current_state.pos\n  \n  # BFS queue: stores tuples of (current_position, list_of_actions_taken_to_reach_here).\n  bfs_queue = collections.deque([(start_position, [])]) \n  # Set to keep track of visited positions to prevent cycles and redundant exploration.\n  visited_positions = {start_position} \n\n  # Define possible cardinal moves (delta_x, delta_y) and their corresponding action indices.\n  cardinal_movement_actions = [\n      ((0, -1), UP),    # Move North (decreases Y coordinate)\n      ((0, 1), DOWN),   # Move South (increases Y coordinate)\n      ((-1, 0), LEFT),  # Move West (decreases X coordinate)\n      ((1, 0), RIGHT),  # Move East (increases X coordinate)\n  ]\n\n  while bfs_queue:\n    (cx, cy), path_to_current = bfs_queue.popleft() # Get the current position and the path to it\n\n    # If the current position is one of our target collection cells, we have found the shortest path.\n    if (cx, cy) in collectible_agent_positions:\n      # Append the USE action, as the agent is now in a valid position to collect the primitive.\n      return path_to_current + [USE]\n\n    # Explore valid neighboring cells for movement (cardinal directions only).\n    for (dx, dy), action in cardinal_movement_actions:\n      nx, ny = cx + dx, cy + dy # Calculate the new potential position\n      next_pos = (nx, ny)\n\n      # Check if the new position is within the overall grid boundaries.\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue # Skip if out of bounds.\n\n      # Check if the new position is traversable (not impassable).\n      # A cell is considered impassable if it contains any of the `impassable_terrain_kinds`.\n      is_cell_impassable = False\n      for k_idx in impassable_terrain_kinds:\n          if grid[nx, ny, k_idx] > 0: # If this impassable kind is present at (nx, ny)\n              is_cell_impassable = True\n              break # No need to check other kinds, it's already impassable.\n      \n      if is_cell_impassable:\n          continue # Skip if the cell is impassable.\n\n      # If the new position is valid and has not been visited, add it to the queue for exploration.\n      if next_pos not in visited_positions:\n        visited_positions.add(next_pos)\n        bfs_queue.append((next_pos, path_to_current + [action]))\n\n  # --- 9. No Path Found ---\n  # If the BFS completes and the queue becomes empty without finding a path to any target cell,\n  # it means the primitive is unreachable from the current agent's position.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T06:25:22.853756", "function_name": "collect", "function_body": "  current_state = env._current_state\n  \n  # 1. Initialize Action Map and Primitive ID\n  # Get the integer index for the desired primitive from the world's cookbook index.\n  # This will raise a KeyError if the primitive name is not known to the environment.\n  primitive_idx = env.world.cookbook.index.index(primitive)\n  \n  # Retrieve action mappings from the environment for clarity and to use correct action indices.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE'] # The action to collect an item when adjacent to it.\n\n  # 2. Early Exit: If primitive is already in inventory\n  # If the agent already possesses at least one unit of the primitive, no collection is needed.\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # 3. Immediate Collection Check: Agent already adjacent?\n  # The `CraftState.next_to` method efficiently checks if the primitive is in the\n  # 3x3 neighborhood (including the agent's current cell). If so, we just need to USE.\n  if current_state.next_to(primitive_idx):\n    return [USE]\n\n  # 4. Identify all physical locations of the primitive on the grid\n  # Iterate through the entire grid to find all cells where the primitive exists.\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  primitive_on_grid_locations = [] \n  for x in range(grid_width):\n    for y in range(grid_height):\n      # If the primitive's kind index has a count > 0 at (x, y), it's present there.\n      if grid[x, y, primitive_idx] > 0:\n        primitive_on_grid_locations.append((x, y))\n\n  # If the primitive is not found anywhere on the grid, it's currently unreachable from the world.\n  if not primitive_on_grid_locations:\n    return []\n\n  # 5. Determine \"Goal Cells\" for Pathfinding (Agent's target positions)\n  # A \"goal cell\" for the agent's movement is any grid cell from which the 'USE'\n  # action can successfully collect the primitive. Given `CraftState.next_to`\n  # checks the 3x3 neighborhood, any cell adjacent to (or on top of) a primitive's\n  # location is a valid goal cell for the agent's final position before using.\n  target_agent_collection_cells = set()\n  for px, py in primitive_on_grid_locations:\n    # Check all 3x3 neighbors around the primitive's location (px, py).\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        ax, ay = px + dx, py + dy # Candidate agent position\n        # Ensure the candidate agent position is within grid boundaries.\n        if 0 <= ax < grid_width and 0 <= ay < grid_height:\n          target_agent_collection_cells.add((ax, ay))\n  \n  # If, for some reason, no valid target cells could be determined (highly unlikely if primitives exist),\n  # then we cannot reach it.\n  if not target_agent_collection_cells:\n      return []\n\n  # 6. Pre-calculate Impassable Terrain Kinds\n  # These are entities that block agent movement. In CraftWorld, these are generally\n  # non-grabbable items that are not designated workshops (which are traversable).\n  impassable_terrain_kinds = set(env.world.non_grabbable_indices) - set(env.world.workshop_indices)\n\n  # 7. Perform Breadth-First Search (BFS) for the shortest path\n  # Start position for BFS is the agent's current position.\n  start_pos = current_state.pos\n  \n  # BFS queue stores tuples of (current_position, list_of_actions_taken_to_reach_here).\n  bfs_queue = collections.deque([(start_pos, [])]) \n  # Set to keep track of visited positions to prevent cycles and redundant exploration.\n  visited_positions = {start_pos} \n\n  # Define possible cardinal moves (delta_x, delta_y) and their corresponding action indices.\n  cardinal_movement_actions = [\n      ((0, -1), UP),    # Move North (decreases Y coordinate)\n      ((0, 1), DOWN),   # Move South (increases Y coordinate)\n      ((-1, 0), LEFT),  # Move West (decreases X coordinate)\n      ((1, 0), RIGHT),  # Move East (increases X coordinate)\n  ]\n\n  while bfs_queue:\n    (cx, cy), path_to_current = bfs_queue.popleft() # Get the current position and the path to it\n\n    # If the current position is one of our desired target collection cells, we have found the shortest path.\n    if (cx, cy) in target_agent_collection_cells:\n      # Append the USE action, as the agent is now in a valid position to collect the primitive.\n      return path_to_current + [USE]\n\n    # Explore valid neighboring cells for movement (cardinal directions only).\n    for (dx, dy), action in cardinal_movement_actions:\n      nx, ny = cx + dx, cy + dy # Calculate the new potential position\n      next_pos = (nx, ny)\n\n      # Check if the new position is within the overall grid boundaries.\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue # Skip if out of bounds.\n\n      # Check if the new position is traversable (not blocked by impassable terrain).\n      # A cell is considered impassable if it contains any of the `impassable_terrain_kinds`.\n      is_cell_impassable = False\n      for k_idx in impassable_terrain_kinds:\n          if grid[nx, ny, k_idx] > 0: # If this impassable kind is present at (nx, ny)\n              is_cell_impassable = True\n              break # No need to check other kinds, it's already impassable.\n      \n      if is_cell_impassable:\n          continue # Skip if the cell is impassable.\n\n      # If the new position is valid and has not been visited, add it to the queue for exploration.\n      if next_pos not in visited_positions:\n        visited_positions.add(next_pos)\n        bfs_queue.append((next_pos, path_to_current + [action]))\n\n  # If the BFS completes and the queue becomes empty without finding a path to any target cell,\n  # it means the primitive is unreachable from the current agent's position in the current grid state.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T06:27:05.760978", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v0`.\n    This version refactors the BFS into helper functions for clarity and slightly\n    improves path reconstruction/handling of immediate goal satisfaction.\n    \n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect.\n\n    Returns:\n        List[int]: A sequence of action indices to execute.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos\n  initial_dir = current_state.dir\n\n  primitive_id = current_state.world.cookbook.index[primitive]\n  # Defensive check, though DSL context implies primitive will always be valid\n  if primitive_id is None: \n      return []\n\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  # This defines how position changes when moving \"forward\" in a given direction.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT, move in positive column direction\n      1: (-1, 0),  # Facing UP, move in negative row direction\n      2: (0, -1),  # Facing LEFT, move in negative column direction\n      3: (1, 0)    # Facing DOWN, move in positive row direction\n  }\n\n  # Map for turning left/right, updating the agent's direction (0-3)\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  def _is_target_state(pos, current_dir):\n      \"\"\"Checks if the given position and direction combination places the\n      primitive directly in front of the agent.\n      \"\"\"\n      r, c = pos\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n\n      if not (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          return False # Cell in front is out of bounds\n      \n      return initial_grid[front_r, front_c, primitive_id] > 0\n\n  def _is_walkable_cell(pos):\n      \"\"\"Checks if the given cell is walkable by the agent.\"\"\"\n      r, c = pos\n      if not (0 <= r < WIDTH and 0 <= c < HEIGHT):\n          return False # Cell itself is out of bounds\n      \n      # A cell is not walkable if it contains any non-walkable entity\n      for kind_idx in non_walkable_kinds_indices:\n          if initial_grid[r, c, kind_idx] > 0:\n              return False\n      \n      # Also, prevent walking directly onto the primitive itself, as we need to stop adjacent to it\n      if initial_grid[r, c, primitive_id] > 0:\n          return False\n          \n      return True\n  \n  # BFS state: ((row, col), direction)\n  # Queue stores ( (current_pos_tuple, current_dir_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (current_pos_tuple, current_dir_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # Stores the action list to reach the target state\n\n  # Check if the agent is already in the target state (adjacent and facing the primitive)\n  if _is_target_state(initial_pos, initial_dir):\n      target_path = [] # No preceding movement actions needed\n\n  # If not immediately at target, perform BFS\n  if target_path is None:\n      while queue:\n          (current_pos, current_dir), path_actions = queue.popleft()\n          \n          # Explore possible next actions: Move Forward, Turn Left, Turn Right\n          \n          # Try Move Forward\n          move_dr, move_dc = DIR_TO_DRDC[current_dir]\n          next_r, next_c = current_pos[0] + move_dr, current_pos[1] + move_dc\n          next_pos = (next_r, next_c)\n          next_dir = current_dir # Direction doesn't change on move\n\n          if _is_walkable_cell(next_pos): # Ensure the new cell is walkable\n              new_state = (next_pos, next_dir)\n              if new_state not in visited:\n                  visited.add(new_state)\n                  new_path = path_actions + [MOVE_FORWARD_ACTION]\n                  if _is_target_state(next_pos, next_dir):\n                      target_path = new_path\n                      break # Path to target found, break BFS\n                  queue.append((new_state, new_path))\n\n          # Try Turn Left\n          next_dir_left = TURN_LEFT_MAP[current_dir]\n          new_state_left = (current_pos, next_dir_left)\n          if new_state_left not in visited:\n              visited.add(new_state_left)\n              new_path_left = path_actions + [TURN_LEFT_ACTION]\n              if _is_target_state(current_pos, next_dir_left):\n                  target_path = new_path_left\n                  break # Path to target found, break BFS\n              queue.append((new_state_left, new_path_left))\n\n          # Try Turn Right\n          next_dir_right = TURN_RIGHT_MAP[current_dir]\n          new_state_right = (current_pos, next_dir_right)\n          if new_state_right not in visited:\n              visited.add(new_state_right)\n              new_path_right = path_actions + [TURN_RIGHT_ACTION]\n              if _is_target_state(current_pos, next_dir_right):\n                  target_path = new_path_right\n                  break # Path to target found, break BFS\n              queue.append((new_state_right, new_path_right))\n\n  # If a path was found, append the USE action to the sequence\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T06:27:06.898140", "function_name": "collect", "function_body": "  current_state = env._current_state\n  grid = current_state.grid\n  agent_initial_pos = current_state.pos # (row, col) tuple\n  agent_initial_dir = current_state.dir # int (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  grid_rows, grid_cols, _ = grid.shape\n\n  # Map DSL movement/turn actions to their integer indices from action_specs\n  action_mapping = env.action_specs()\n  MOVE_FORWARD = action_mapping['UP']    # Typically 'UP' means move forward in current direction\n  TURN_LEFT = action_mapping['LEFT']\n  TURN_RIGHT = action_mapping['RIGHT']\n  USE_ACTION = action_mapping['USE']\n\n  # Define changes in (row, col) for each direction index\n  # Index 0:RIGHT (+col), 1:UP (-row), 2:LEFT (-col), 3:DOWN (+row)\n  DIR_VECTORS = [\n      (0, 1),   # 0: Facing RIGHT (dr, dc)\n      (-1, 0),  # 1: Facing UP\n      (0, -1),  # 2: Facing LEFT\n      (1, 0)    # 3: Facing DOWN\n  ]\n\n  # Define how direction index changes when turning left or right\n  TURN_LEFT_DIR_MAP = {0: 1, 1: 2, 2: 3, 3: 0} # R -> U -> L -> D -> R\n  TURN_RIGHT_DIR_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # R -> D -> L -> U -> R\n\n  # Get indices of entities that block movement (e.g., 'BOUNDARY', 'WATER', 'WORKSHOP_X')\n  non_walkable_kind_indices = current_state.world.non_grabbable_indices\n\n  # BFS state is defined by (agent_position_tuple, agent_direction_int)\n  # Queue stores tuples of: ( (current_pos, current_dir), list_of_actions_to_reach_this_state )\n  queue = collections.deque([((agent_initial_pos, agent_initial_dir), [])])\n  \n  # Visited set stores (pos_tuple, dir_int) to avoid cycles and re-exploring paths\n  visited_states = set([(agent_initial_pos, agent_initial_dir)])\n\n  while queue:\n      ((r, c), current_dir), path_so_far = queue.popleft()\n\n      # 1. Check if the current position and direction allow collecting the primitive.\n      # Calculate the cell directly in front of the agent.\n      dr, dc = DIR_VECTORS[current_dir]\n      cell_in_front_r, cell_in_front_c = r + dr, c + dc\n\n      # Check if the cell in front is within grid bounds AND contains the primitive.\n      if (0 <= cell_in_front_r < grid_rows and 0 <= cell_in_front_c < grid_cols and\n          grid[cell_in_front_r, cell_in_front_c, primitive_id] > 0):\n          # Found a state where the agent is next to and facing the primitive.\n          # Append the USE action and return the complete sequence.\n          return path_so_far + [USE_ACTION]\n\n      # 2. Explore next possible actions (Move Forward, Turn Left, Turn Right).\n\n      # Try Move Forward\n      next_r, next_c = r + dr, c + dc # dr, dc are still from current_dir\n      next_pos_after_move = (next_r, next_c)\n      next_dir_after_move = current_dir # Direction doesn't change on move\n\n      # Check if the new position is within bounds and the state hasn't been visited.\n      if (0 <= next_r < grid_rows and 0 <= next_c < grid_cols and\n          (next_pos_after_move, next_dir_after_move) not in visited_states):\n          \n          # Check if the cell to move into is walkable (i.e., not a boundary, water, etc.)\n          is_walkable = True\n          for kind_idx in non_walkable_kind_indices:\n              if grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          # Also, ensure the agent doesn't walk directly *onto* the primitive itself.\n          if grid[next_r, next_c, primitive_id] > 0:\n              is_walkable = False\n\n          if is_walkable:\n              visited_states.add((next_pos_after_move, next_dir_after_move))\n              queue.append(((next_pos_after_move, next_dir_after_move), path_so_far + [MOVE_FORWARD]))\n\n      # Try Turn Left\n      next_dir_after_turn_left = TURN_LEFT_DIR_MAP[current_dir]\n      # Position remains the same after turning\n      if ((r, c), next_dir_after_turn_left) not in visited_states:\n          visited_states.add(((r, c), next_dir_after_turn_left))\n          queue.append((((r, c), next_dir_after_turn_left), path_so_far + [TURN_LEFT]))\n\n      # Try Turn Right\n      next_dir_after_turn_right = TURN_RIGHT_DIR_MAP[current_dir]\n      # Position remains the same after turning\n      if ((r, c), next_dir_after_turn_right) not in visited_states:\n          visited_states.add(((r, c), next_dir_after_turn_right))\n          queue.append((((r, c), next_dir_after_turn_right), path_so_far + [TURN_RIGHT]))\n\n  # If the BFS queue becomes empty and no path to the primitive was found\n  return []", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T06:28:30.577408", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  grid = current_state.grid # The current state's grid layout\n  initial_pos = current_state.pos # Agent's starting position (row, col)\n  initial_dir = current_state.dir # Agent's starting direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  grid_height, grid_width, _ = grid.shape\n\n  # Map DSL action names to their corresponding integer IDs from the environment's action_specs\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP'] # Assuming 'UP' in DSL means moving forward\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define changes in (row, col) for each direction when moving forward\n  # Direction 0: Right (+col), 1: Up (-row), 2: Left (-col), 3: Down (+row)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT\n      1: (-1, 0),  # Facing UP\n      2: (0, -1),  # Facing LEFT\n      3: (1, 0)    # Facing DOWN\n  }\n\n  # Define how direction changes when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # e.g., Right (0) -> Up (1)\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # e.g., Right (0) -> Down (3)\n\n  # Identify entity kinds that block movement (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # Use Breadth-First Search (BFS) to find the shortest path to the primitive.\n  # BFS queue stores: ((current_position_tuple, current_direction_int), list_of_actions_to_reach_here)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores: (position_tuple, direction_int) to prevent redundant exploration and cycles\n  visited = {(initial_pos, initial_dir)}\n\n  # This variable will store the action sequence to reach the state where the agent is\n  # adjacent to the primitive and facing it.\n  path_to_primitive_adjacent = None \n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # Check if the primitive is currently in the cell directly in front of the agent.\n      dr_front, dc_front = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + dr_front, c + dc_front\n      \n      # Ensure the front cell is within grid boundaries\n      if (0 <= front_r < grid_height and 0 <= front_c < grid_width):\n          # If the primitive is found in the cell directly in front, we have reached our target pre-USE state.\n          if grid[front_r, front_c, primitive_id] > 0:\n              path_to_primitive_adjacent = path_actions\n              break # Found the shortest path, no need to explore further\n\n      # Explore possible next actions: Move Forward, Turn Left, Turn Right\n      \n      # Option 1: Try to Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r_move, next_c_move = r + move_dr, c + move_dc\n      next_pos_move = (next_r_move, next_c_move)\n      next_dir_move = current_dir # Direction does not change when moving forward\n\n      # Check if the next position is within bounds and the state hasn't been visited\n      if (0 <= next_r_move < grid_height and 0 <= next_c_move < grid_width and\n          (next_pos_move, next_dir_move) not in visited):\n          \n          # Determine if the next cell is walkable.\n          # An agent cannot walk onto non-grabbable items or onto the primitive itself.\n          is_walkable = True\n          if grid[next_r_move, next_c_move, primitive_id] > 0: # Cannot walk onto the primitive\n              is_walkable = False\n          else:\n              for kind_idx in non_walkable_kinds_indices:\n                  if grid[next_r_move, next_c_move, kind_idx] > 0:\n                      is_walkable = False\n                      break\n          \n          if is_walkable:\n              visited.add((next_pos_move, next_dir_move))\n              queue.append(((next_pos_move, next_dir_move), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Option 2: Try to Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Option 3: Try to Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path to being adjacent and facing the primitive was found, append the USE action.\n  if path_to_primitive_adjacent is not None:\n      actions_list.extend(path_to_primitive_adjacent)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 2, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T06:28:31.699852", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (row, col)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  primitive_id = current_state.world.cookbook.index[primitive]\n  GRID_ROWS, GRID_COLS, _ = initial_grid.shape # Grid dimensions (rows, columns)\n\n  action_map = env.action_specs()\n  # Map DSL movement/turn actions to their integer indices from action_specs\n  # UP typically means move forward, LEFT/RIGHT are turns.\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  # (dr, dc) indicates how position (row, col) changes when moving \"forward\".\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col + 1)\n      1: (-1, 0),  # Facing UP: (row - 1, col)\n      2: (0, -1),  # Facing LEFT: (row, col - 1)\n      3: (1, 0)    # Facing DOWN: (row + 1, col)\n  }\n\n  # Map for updating the agent's direction when turning left or right.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # RIGHT -> UP -> LEFT -> DOWN -> RIGHT\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # RIGHT -> DOWN -> LEFT -> UP -> RIGHT\n\n  # Get indices of entities that inherently block movement (e.g., BOUNDARY, WATER, WORKSHOP_X).\n  # Agent cannot walk onto cells containing these kinds.\n  blocking_kind_indices = current_state.world.non_grabbable_indices\n\n  # BFS state representation: ((current_pos_tuple, current_dir_int), list_of_actions_to_reach_here)\n  # The queue stores states to explore.\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # The visited set tracks (position, direction) pairs to avoid redundant computations and cycles.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # Stores the shortest sequence of actions to reach the \"ready to use\" state.\n\n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      r, c = current_pos\n\n      # Check if the primitive is directly in front of the agent in the current state.\n      # This is the \"goal\" condition for the BFS (agent is adjacent and facing the primitive).\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the cell directly in front is within grid bounds.\n      if (0 <= front_r < GRID_ROWS and 0 <= front_c < GRID_COLS):\n          # If the cell in front contains the primitive, we have found the shortest path\n          # to a state where the agent can 'USE' the primitive.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path_actions = path_so_far\n              break # Shortest path to the target interaction state found, terminate BFS.\n\n      # Explore possible next actions: Move Forward, Turn Left, Turn Right.\n      \n      # 1. Try moving Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction.\n\n      # Check if the next position is within grid bounds and this (pos, dir) state hasn't been visited.\n      if (0 <= next_r < GRID_ROWS and 0 <= next_c < GRID_COLS and\n          (next_pos, next_dir) not in visited):\n          \n          # Determine if the 'next_pos' cell is walkable.\n          # A cell is not walkable if it contains any 'blocking_kind' (like boundaries, water).\n          # Also, the agent cannot walk *onto* the primitive itself; it must stand *adjacent* to it.\n          is_walkable = True\n          for kind_idx in blocking_kind_indices:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          \n          # Prevent walking onto the primitive itself. This applies to grabbable items (like WOOD)\n          # and also provides a redundant check for non-grabbable items if they are the primitive.\n          if initial_grid[next_r, next_c, primitive_id] > 0:\n              is_walkable = False\n\n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_so_far + [MOVE_FORWARD_ACTION]))\n\n      # 2. Try turning Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_so_far + [TURN_LEFT_ACTION]))\n\n      # 3. Try turning Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_so_far + [TURN_RIGHT_ACTION]))\n\n  # If a path was found to the \"ready to use\" state, append the final USE action.\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 2, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T06:29:07.024673", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos\n  initial_dir = current_state.dir\n\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # Helper 1: Get Action Mappings\n  def _get_action_map():\n      return env.action_specs()\n  \n  action_map = _get_action_map()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Helper 2: Get Primitive ID\n  def _get_kind_id(world, primitive_name):\n      return world.cookbook.index[primitive_name]\n  \n  primitive_id = _get_kind_id(current_state.world, primitive)\n  if primitive_id is None: \n      return [] # Should not happen based on DSL context\n\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # Helper 3: Get Movement Constants\n  def _get_movement_constants():\n      # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n      DIR_TO_DRDC = {\n          0: (0, 1),   # Facing RIGHT, move in positive column direction\n          1: (-1, 0),  # Facing UP, move in negative row direction\n          2: (0, -1),  # Facing LEFT, move in negative column direction\n          3: (1, 0)    # Facing DOWN, move in positive row direction\n      }\n      TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n      TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n      return DIR_TO_DRDC, TURN_LEFT_MAP, TURN_RIGHT_MAP\n  \n  DIR_TO_DRDC, TURN_LEFT_MAP, TURN_RIGHT_MAP = _get_movement_constants()\n\n  # Helper 4: Check if agent is facing the target primitive\n  def _is_target_state(pos, current_dir, target_grid, target_primitive_id, width, height):\n      r, c = pos\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n\n      if not (0 <= front_r < width and 0 <= front_c < height):\n          return False # Cell in front is out of bounds\n      \n      return target_grid[front_r, front_c, target_primitive_id] > 0\n\n  # Helper 5: Check if a cell is walkable\n  def _is_walkable_cell(pos, target_grid, target_primitive_id, non_walkable_indices, width, height):\n      r, c = pos\n      if not (0 <= r < width and 0 <= c < height):\n          return False # Cell itself is out of bounds\n      \n      # A cell is not walkable if it contains any non-walkable entity\n      for kind_idx in non_walkable_indices:\n          if target_grid[r, c, kind_idx] > 0:\n              return False\n      \n      # Also, prevent walking directly onto the primitive itself, as we need to stop adjacent to it\n      if target_grid[r, c, target_primitive_id] > 0:\n          return False\n          \n      return True\n\n  # Helper 6: BFS to find path to primitive\n  def _bfs_find_path(start_pos, start_dir, target_grid, target_primitive_id, \n                      non_walkable_indices, width, height,\n                      move_forward_action, turn_left_action, turn_right_action):\n      \n      # BFS state: ((row, col), direction)\n      # Queue stores ( (current_pos_tuple, current_dir_int), list_of_actions_to_reach_here )\n      queue = collections.deque([((start_pos, start_dir), [])])\n      # Visited set stores (current_pos_tuple, current_dir_int) to avoid cycles and redundant paths\n      visited = {(start_pos, start_dir)}\n\n      while queue:\n          (current_pos, current_dir), path_actions = queue.popleft()\n          \n          # Check if current state (position and direction) makes the primitive targetable\n          if _is_target_state(current_pos, current_dir, target_grid, target_primitive_id, width, height):\n              return path_actions # Path to target state found\n\n          # Explore possible next actions: Move Forward, Turn Left, Turn Right\n          \n          # Try Move Forward\n          move_dr, move_dc = DIR_TO_DRDC[current_dir]\n          next_r, next_c = current_pos[0] + move_dr, current_pos[1] + move_dc\n          next_pos = (next_r, next_c)\n          next_dir = current_dir # Direction doesn't change on move\n\n          if _is_walkable_cell(next_pos, target_grid, target_primitive_id, non_walkable_indices, width, height):\n              new_state = (next_pos, next_dir)\n              if new_state not in visited:\n                  visited.add(new_state)\n                  new_path = path_actions + [move_forward_action]\n                  queue.append((new_state, new_path))\n\n          # Try Turn Left\n          next_dir_left = TURN_LEFT_MAP[current_dir]\n          new_state_left = (current_pos, next_dir_left)\n          if new_state_left not in visited:\n              visited.add(new_state_left)\n              new_path_left = path_actions + [turn_left_action]\n              queue.append((new_state_left, new_path_left))\n\n          # Try Turn Right\n          next_dir_right = TURN_RIGHT_MAP[current_dir]\n          new_state_right = (current_pos, next_dir_right)\n          if new_state_right not in visited:\n              visited.add(new_state_right)\n              new_path_right = path_actions + [turn_right_action]\n              queue.append((new_state_right, new_path_right))\n      \n      return None # No path found\n\n  # Main logic for collect_v1\n  target_path = None\n\n  # Check if the agent is already in a state to collect (adjacent and facing)\n  if _is_target_state(initial_pos, initial_dir, initial_grid, primitive_id, WIDTH, HEIGHT):\n      target_path = [] # No movement actions needed, just USE\n\n  # If not immediately at target, perform BFS\n  if target_path is None:\n      target_path = _bfs_find_path(initial_pos, initial_dir, initial_grid, primitive_id, \n                                   non_walkable_kinds_indices, WIDTH, HEIGHT,\n                                   MOVE_FORWARD_ACTION, TURN_LEFT_ACTION, TURN_RIGHT_ACTION)\n\n  # If a path was found (or it was an immediate goal), append the USE action\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T06:29:08.211859", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos\n  initial_dir = current_state.dir\n\n  primitive_id = current_state.world.cookbook.index[primitive]\n  # Defensive check, though DSL context implies primitive will always be valid\n  if primitive_id is None: \n      return []\n\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  # This defines how position changes when moving \"forward\" in a given direction.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT, move in positive column direction\n      1: (-1, 0),  # Facing UP, move in negative row direction\n      2: (0, -1),  # Facing LEFT, move in negative column direction\n      3: (1, 0)    # Facing DOWN, move in positive row direction\n  }\n\n  # Map for turning left/right, updating the agent's direction (0-3)\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  def _is_target_facing(pos, agent_dir):\n      \"\"\"Checks if the primitive is in the cell directly in front of the agent.\"\"\"\n      r, c = pos\n      front_dr, front_dc = DIR_TO_DRDC[agent_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n\n      if not (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          return False # Cell in front is out of bounds\n      \n      return initial_grid[front_r, front_c, primitive_id] > 0\n\n  def _is_cell_walkable(pos):\n      \"\"\"Checks if a given cell (r, c) is traversable.\"\"\"\n      r, c = pos\n      if not (0 <= r < WIDTH and 0 <= c < HEIGHT):\n          return False\n      \n      # A cell is not walkable if it contains any non-grabbable entity,\n      # or if it contains the primitive itself (we need to stop *adjacent*).\n      for kind_idx in non_walkable_kinds_indices:\n          if initial_grid[r, c, kind_idx] > 0:\n              return False\n      \n      if initial_grid[r, c, primitive_id] > 0: # Cannot walk *onto* the primitive\n          return False\n          \n      return True\n  \n  def _get_possible_next_states(current_pos, current_dir):\n      \"\"\"Generates possible next states and actions from the current state.\"\"\"\n      neighbors = []\n\n      # 1. Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = current_pos[0] + move_dr, current_pos[1] + move_dc\n      next_pos_move = (next_r, next_c)\n      if _is_cell_walkable(next_pos_move):\n          neighbors.append(((next_pos_move, current_dir), MOVE_FORWARD_ACTION))\n\n      # 2. Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      neighbors.append(((current_pos, next_dir_left), TURN_LEFT_ACTION))\n\n      # 3. Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      neighbors.append(((current_pos, next_dir_right), TURN_RIGHT_ACTION))\n\n      return neighbors\n\n  # BFS Initialization\n  start_state = (initial_pos, initial_dir)\n  queue = collections.deque([(start_state, [])]) # ( (pos, dir), path_actions )\n  visited = {start_state}\n\n  path_to_target = None\n\n  # Immediate check for target state: if agent is already in position to USE the primitive\n  if _is_target_facing(initial_pos, initial_dir):\n      path_to_target = [] # No movement actions needed, just USE\n\n  # If not immediately at target, perform BFS\n  if path_to_target is None:\n      while queue:\n          (current_pos, current_dir), path_actions = queue.popleft()\n\n          for (next_pos, next_dir), action in _get_possible_next_states(current_pos, current_dir):\n              next_state = (next_pos, next_dir)\n              if next_state not in visited:\n                  visited.add(next_state)\n                  new_path_actions = path_actions + [action]\n                  \n                  # Check if the new state is a target state (agent is facing the primitive)\n                  if _is_target_facing(next_pos, next_dir):\n                      path_to_target = new_path_actions\n                      break # Found shortest path\n                  \n                  queue.append((next_state, new_path_actions))\n          \n          if path_to_target is not None:\n              break # Exit outer BFS loop if path found\n\n  # If a path was found, append the USE action to the sequence\n  if path_to_target is not None:\n      actions_list.extend(path_to_target)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T06:30:59.993793", "function_name": "collect", "function_body": "  # The following helper function is nested inside collect_v1 to adhere to the\n  # \"only return code that will fit in that function\" constraint, as it was in collect_v0.\n  # It performs a Breadth-First Search (BFS) to find the shortest sequence of actions\n  # (moves and turns) to position the agent adjacent to and facing a target item.\n  def _find_path_to_adjacent_facing_primitive(\n      start_pos: tuple[int, int],\n      start_dir: int,\n      target_primitive_id: int,\n      initial_grid: np.ndarray,\n      action_map: dict[str, int],\n      non_grabbable_indices: set[int]\n  ) -> list[int] | None:\n      \"\"\"\n      Internal helper for collect_v1: Finds a path to be adjacent to and facing a primitive.\n\n      Uses BFS to explore agent states (position and direction) and find the shortest\n      sequence of movement and turn actions that leads the agent to a cell\n      from which the target primitive is directly in front and grabbable via 'USE'.\n\n      Args:\n          start_pos (tuple[int, int]): The agent's starting (row, column) position.\n          start_dir (int): The agent's starting direction (0:R, 1:U, 2:L, 3:D).\n          target_primitive_id (int): The integer ID of the primitive to target.\n          initial_grid (np.ndarray): The grid layout of the environment.\n          action_map (dict[str, int]): Mapping of action names (e.g., 'UP', 'LEFT') to their integer IDs.\n          non_grabbable_indices (set[int]): A set of item IDs that represent impassable terrain\n                                             (e.g., boundaries, water, workshops).\n\n      Returns:\n          list[int] | None: A list of action integers representing the path, or None if no path found.\n      \"\"\"\n      WIDTH, HEIGHT, _ = initial_grid.shape\n\n      # Extract specific action IDs for clarity and direct use\n      MOVE_FORWARD_ACTION = action_map['UP'] # 'UP' action moves agent forward in current direction\n      TURN_LEFT_ACTION = action_map['LEFT']\n      TURN_RIGHT_ACTION = action_map['RIGHT']\n\n      # Define how position changes based on current direction when moving forward\n      # Dir (0:Right, 1:Up, 2:Left, 3:Down) maps to (delta_row, delta_col)\n      DIR_TO_DRDC = {\n          0: (0, 1),   # Facing RIGHT: (row, col+1)\n          1: (-1, 0),  # Facing UP: (row-1, col)\n          2: (0, -1),  # Facing LEFT: (row, col-1)\n          3: (1, 0)    # Facing DOWN: (row+1, col)\n      }\n\n      # Define how direction changes when turning\n      TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n      TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n      # BFS Initialization\n      # Queue stores tuples: ((current_row, current_col), current_direction), list_of_actions_taken_to_reach_here\n      queue = collections.deque([((start_pos, start_dir), [])])\n      # Visited set stores states (position_tuple, direction_int) to avoid cycles and redundant paths\n      visited = {(start_pos, start_dir)}\n\n      while queue:\n          (current_pos, current_dir), path_actions = queue.popleft()\n          r, c = current_pos\n\n          # Check if the current state satisfies the goal condition:\n          # Is the target primitive directly in front of the agent?\n          front_dr, front_dc = DIR_TO_DRDC[current_dir]\n          front_r, front_c = r + front_dr, c + front_dc\n\n          # Ensure the cell directly in front is within grid boundaries\n          if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n              # If the target primitive is in that cell, we found a path to the desired state.\n              if initial_grid[front_r, front_c, target_primitive_id] > 0:\n                  return path_actions # Return the sequence of actions that led to this state\n\n          # Explore possible next states by applying actions: Move Forward, Turn Left, Turn Right\n\n          # 1. Try moving forward\n          next_r_move, next_c_move = r + DIR_TO_DRDC[current_dir][0], c + DIR_TO_DRDC[current_dir][1]\n          next_pos_move = (next_r_move, next_c_move)\n          next_dir_move = current_dir # Direction doesn't change when moving forward\n\n          # Check validity and visit status of the 'move forward' state\n          if (0 <= next_r_move < WIDTH and 0 <= next_c_move < HEIGHT and\n              (next_pos_move, next_dir_move) not in visited):\n              \n              # Determine if the target cell is walkable:\n              # - It cannot contain any items defined as non-grabbable/impassable terrain.\n              # - It cannot be the target primitive itself (agent must stand *next* to it, not on it).\n              is_walkable = True\n              for kind_idx in non_grabbable_indices:\n                  if initial_grid[next_r_move, next_c_move, kind_idx] > 0:\n                      is_walkable = False\n                      break\n              # Additionally, explicitly prevent walking onto the target primitive itself.\n              # This is crucial for \"collection\" where USE is applied from an adjacent cell.\n              if initial_grid[next_r_move, next_c_move, target_primitive_id] > 0:\n                  is_walkable = False\n\n              if is_walkable:\n                  visited.add((next_pos_move, next_dir_move))\n                  queue.append(((next_pos_move, next_dir_move), path_actions + [MOVE_FORWARD_ACTION]))\n\n          # 2. Try turning left\n          next_dir_left = TURN_LEFT_MAP[current_dir]\n          # Position remains the same when turning\n          if ((current_pos, next_dir_left) not in visited):\n              visited.add((current_pos, next_dir_left))\n              queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n          # 3. Try turning right\n          next_dir_right = TURN_RIGHT_MAP[current_dir]\n          # Position remains the same when turning\n          if ((current_pos, next_dir_right) not in visited):\n              visited.add((current_pos, next_dir_right))\n              queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n      return None # No path found after exhausting all reachable states\n\n  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos\n  initial_dir = current_state.dir\n\n  # Get the integer ID for the target primitive from the cookbook index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  # Get the action map from the environment to translate action names to integers\n  action_map = env.action_specs()\n  USE_ACTION = action_map['USE']\n\n  # Identify items that are generally impassable or not meant to be walked upon.\n  # These indices come from CraftWorld's definition of non-grabbable items (e.g., boundaries, water, workshops).\n  non_walkable_terrain_indices = current_state.world.non_grabbable_indices\n\n  # Call the nested helper function to find the optimal sequence of moves and turns\n  # to reach a position adjacent to and facing the target primitive.\n  path_to_primitive = _find_path_to_adjacent_facing_primitive(\n      start_pos=initial_pos,\n      start_dir=initial_dir,\n      target_primitive_id=primitive_id,\n      initial_grid=initial_grid,\n      action_map=action_map,\n      non_grabbable_indices=non_walkable_terrain_indices\n  )\n\n  # If a valid path was found, append the 'USE' action to the sequence.\n  # The 'USE' action is the final step to \"collect\" or interact with the primitive.\n  if path_to_primitive is not None:\n      actions_list.extend(path_to_primitive)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T06:31:01.316819", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (row, col)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Get grid dimensions for boundary checks\n  GRID_ROWS, GRID_COLS, _ = initial_grid.shape \n\n  action_map = env.action_specs()\n  # Extract action indices from the action_map for clarity and robustness\n  MOVE_FORWARD_ACTION = action_map['UP'] # Assuming 'UP' corresponds to moving forward relative to current direction\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  non_grabbable_indices = current_state.world.non_grabbable_indices\n\n  # Direction mapping: (dr, dc) for agent's facing direction\n  # This defines how position changes when moving \"forward\" for each direction.\n  # Directions: 0 (Right), 1 (Up), 2 (Left), 3 (Down)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  def _find_path_to_adjacent_facing_primitive(\n      start_pos: tuple[int, int],\n      start_dir: int,\n      target_primitive_id: int,\n  ) -> list[int] | None:\n      \"\"\"\n      Internal helper function to find a sequence of movement/turn actions (BFS)\n      to reach a state where the agent is adjacent to and facing the target primitive.\n      \"\"\"\n      # BFS Queue: stores ( (current_pos_tuple, current_dir_int), list_of_actions_to_reach_here )\n      queue = collections.deque([((start_pos, start_dir), [])])\n      # Visited set: stores (position_tuple, direction_int) to avoid redundant paths and cycles\n      visited = {(start_pos, start_dir)}\n\n      while queue:\n          # Pop the current state and path from the queue\n          (current_pos, current_dir), path_actions = queue.popleft()\n          current_r, current_c = current_pos\n\n          # 1. Check if the current state satisfies the target condition:\n          # The primitive must be in the cell directly in front of the agent.\n          front_dr, front_dc = DIR_TO_DRDC[current_dir]\n          front_r, front_c = current_r + front_dr, current_c + front_dc\n\n          # Ensure the cell in front is within grid bounds\n          if (0 <= front_r < GRID_ROWS and 0 <= front_c < GRID_COLS):\n              # Check if the cell in front contains the target primitive\n              if initial_grid[front_r, front_c, target_primitive_id] > 0:\n                  return path_actions # Path found, return the sequence of actions\n\n          # 2. Explore possible next actions: Move Forward, Turn Left, Turn Right\n          \n          # Try Move Forward\n          move_dr, move_dc = DIR_TO_DRDC[current_dir]\n          next_r, next_c = current_r + move_dr, current_c + move_dc\n          next_pos = (next_r, next_c)\n          next_dir = current_dir # Moving forward does not change facing direction\n\n          # Check if the next position is within bounds and this (position, direction) state hasn't been visited\n          if (0 <= next_r < GRID_ROWS and 0 <= next_c < GRID_COLS and\n              (next_pos, next_dir) not in visited):\n              \n              # Determine if the next position is walkable:\n              is_walkable = True\n              # An agent cannot walk onto cells containing non-grabbable entities\n              for kind_idx in non_grabbable_indices:\n                  if initial_grid[next_r, next_c, kind_idx] > 0:\n                      is_walkable = False\n                      break\n              # An agent also cannot walk onto the target primitive itself (it needs to be adjacent)\n              if initial_grid[next_r, next_c, target_primitive_id] > 0:\n                  is_walkable = False\n\n              if is_walkable:\n                  visited.add((next_pos, next_dir))\n                  queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n          # Try Turn Left\n          # Using modular arithmetic for concise turn calculations: (current_dir + 1) % 4\n          # R(0)->U(1), U(1)->L(2), L(2)->D(3), D(3)->R(0)\n          next_dir_left = (current_dir + 1) % 4\n          # Turning does not change position.\n          if ((current_pos, next_dir_left) not in visited):\n              visited.add((current_pos, next_dir_left))\n              queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n          # Try Turn Right\n          # Using modular arithmetic for concise turn calculations: (current_dir - 1 + 4) % 4\n          # R(0)->D(3), U(1)->R(0), L(2)->U(1), D(3)->L(2)\n          next_dir_right = (current_dir - 1 + 4) % 4\n          # Turning does not change position.\n          if ((current_pos, next_dir_right) not in visited):\n              visited.add((current_pos, next_dir_right))\n              queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n      return None # No path found after exploring all reachable states\n\n  # Call the nested BFS helper function to find the movement/turn sequence\n  path_to_primitive = _find_path_to_adjacent_facing_primitive(\n      start_pos=initial_pos,\n      start_dir=initial_dir,\n      target_primitive_id=primitive_id,\n  )\n\n  # If a valid path to the primitive was found, append the 'USE' action to the sequence.\n  # The 'USE' action is assumed to \"collect\" the primitive once the agent is in the correct position.\n  if path_to_primitive is not None:\n      actions_list.extend(path_to_primitive)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T06:32:08.144868", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos\n  initial_dir = current_state.dir\n\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # Helper 1: Get Action Mappings\n  def _get_action_map():\n      return env.action_specs()\n  \n  action_map = _get_action_map()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Helper 2: Get Primitive ID\n  def _get_kind_id(world, primitive_name):\n      return world.cookbook.index[primitive_name]\n  \n  primitive_id = _get_kind_id(current_state.world, primitive)\n  if primitive_id is None: \n      # Primitive name not found, this should ideally not happen if DSL is valid\n      return [] \n  \n  # --- Improvement for collect_v1: Check if the primitive is actually grabbable ---\n  # If the primitive is not in the list of grabbable items, we cannot 'collect' it.\n  if primitive_id not in current_state.world.grabbable_indices:\n      return []\n\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # Helper 3: Get Movement Constants\n  def _get_movement_constants():\n      # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n      DIR_TO_DRDC = {\n          0: (0, 1),   # Facing RIGHT, move in positive column direction\n          1: (-1, 0),  # Facing UP, move in negative row direction\n          2: (0, -1),  # Facing LEFT, move in negative column direction\n          3: (1, 0)    # Facing DOWN, move in positive row direction\n      }\n      TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n      TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n      return DIR_TO_DRDC, TURN_LEFT_MAP, TURN_RIGHT_MAP\n  \n  DIR_TO_DRDC, TURN_LEFT_MAP, TURN_RIGHT_MAP = _get_movement_constants()\n\n  # Helper 4: Check if agent is facing the target primitive\n  def _is_target_state(pos, current_dir, target_grid, target_primitive_id, width, height):\n      r, c = pos\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n\n      if not (0 <= front_r < width and 0 <= front_c < height):\n          return False # Cell in front is out of bounds\n      \n      return target_grid[front_r, front_c, target_primitive_id] > 0\n\n  # Helper 5: Check if a cell is walkable\n  def _is_walkable_cell(pos, target_grid, target_primitive_id, non_walkable_indices, width, height):\n      r, c = pos\n      if not (0 <= r < width and 0 <= c < height):\n          return False # Cell itself is out of bounds\n      \n      # A cell is not walkable if it contains any non-walkable entity\n      for kind_idx in non_walkable_indices:\n          if target_grid[r, c, kind_idx] > 0:\n              return False\n      \n      # Also, prevent walking directly onto the primitive itself, as we need to stop adjacent to it\n      # This check specifically prevents walking ONTO the primitive that needs to be collected\n      if target_grid[r, c, target_primitive_id] > 0:\n          return False\n          \n      return True\n\n  # Helper 6: BFS to find path to primitive\n  def _bfs_find_path(start_pos, start_dir, target_grid, target_primitive_id, \n                      non_walkable_indices, width, height,\n                      move_forward_action, turn_left_action, turn_right_action):\n      \n      # BFS state: ((row, col), direction)\n      # Queue stores ( (current_pos_tuple, current_dir_int), list_of_actions_to_reach_here )\n      queue = collections.deque([((start_pos, start_dir), [])])\n      # Visited set stores (current_pos_tuple, current_dir_int) to avoid cycles and redundant paths\n      visited = {(start_pos, start_dir)}\n\n      while queue:\n          (current_pos, current_dir), path_actions = queue.popleft()\n          \n          # Check if current state (position and direction) makes the primitive targetable\n          if _is_target_state(current_pos, current_dir, target_grid, target_primitive_id, width, height):\n              return path_actions # Path to target state found\n\n          # Explore possible next actions: Move Forward, Turn Left, Turn Right\n          \n          # Try Move Forward\n          move_dr, move_dc = DIR_TO_DRDC[current_dir]\n          next_r, next_c = current_pos[0] + move_dr, current_pos[1] + move_dc\n          next_pos = (next_r, next_c)\n          next_dir = current_dir # Direction doesn't change on move\n\n          if _is_walkable_cell(next_pos, target_grid, target_primitive_id, non_walkable_indices, width, height):\n              new_state = (next_pos, next_dir)\n              if new_state not in visited:\n                  visited.add(new_state)\n                  new_path = path_actions + [move_forward_action]\n                  queue.append((new_state, new_path))\n\n          # Try Turn Left\n          next_dir_left = TURN_LEFT_MAP[current_dir]\n          new_state_left = (current_pos, next_dir_left)\n          if new_state_left not in visited:\n              visited.add(new_state_left)\n              new_path_left = path_actions + [turn_left_action]\n              queue.append((new_state_left, new_path_left))\n\n          # Try Turn Right\n          next_dir_right = TURN_RIGHT_MAP[current_dir]\n          new_state_right = (current_pos, next_dir_right)\n          if new_state_right not in visited:\n              visited.add(new_state_right)\n              new_path_right = path_actions + [turn_right_action]\n              queue.append((new_state_right, new_path_right))\n      \n      return None # No path found\n\n  # Main logic for collect_v1\n  target_path = None\n\n  # Check if the agent is already in a state to collect (adjacent and facing)\n  if _is_target_state(initial_pos, initial_dir, initial_grid, primitive_id, WIDTH, HEIGHT):\n      target_path = [] # No movement actions needed, just USE\n\n  # If not immediately at target, perform BFS\n  if target_path is None:\n      target_path = _bfs_find_path(initial_pos, initial_dir, initial_grid, primitive_id, \n                                   non_walkable_kinds_indices, WIDTH, HEIGHT,\n                                   MOVE_FORWARD_ACTION, TURN_LEFT_ACTION, TURN_RIGHT_ACTION)\n\n  # If a path was found (or it was an immediate goal), append the USE action\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T06:32:09.356536", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos\n  initial_dir = current_state.dir\n\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # Helper 1: Get Action Mappings\n  def _get_action_map():\n      return env.action_specs()\n  \n  action_map = _get_action_map()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Helper 2: Get Primitive ID\n  def _get_kind_id(world, primitive_name):\n      # Using .get() for robustness in case the primitive name isn't found, though\n      # for a valid DSL 'primitive' it should always exist.\n      return world.cookbook.index.get(primitive_name) \n  \n  primitive_id = _get_kind_id(current_state.world, primitive)\n  if primitive_id is None: \n      # If primitive name is not valid/found, no actions can be generated.\n      return []\n\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # Helper 3: Get Movement Constants\n  def _get_movement_constants():\n      # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n      DIR_TO_DRDC = {\n          0: (0, 1),   # Facing RIGHT, move in positive column direction (c + 1)\n          1: (-1, 0),  # Facing UP, move in negative row direction (r - 1)\n          2: (0, -1),  # Facing LEFT, move in negative column direction (c - 1)\n          3: (1, 0)    # Facing DOWN, move in positive row direction (r + 1)\n      }\n      TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0} # R -> U -> L -> D -> R\n      TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # R -> D -> L -> U -> R\n      return DIR_TO_DRDC, TURN_LEFT_MAP, TURN_RIGHT_MAP\n  \n  DIR_TO_DRDC, TURN_LEFT_MAP, TURN_RIGHT_MAP = _get_movement_constants()\n\n  # Helper 4: Check if agent is facing the target primitive\n  def _is_target_state(pos, current_dir, target_grid, target_primitive_id, width, height):\n      r, c = pos\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n\n      if not (0 <= front_r < width and 0 <= front_c < height):\n          return False # Cell in front is out of bounds\n      \n      return target_grid[front_r, front_c, target_primitive_id] > 0\n\n  # Helper 5: Check if a cell is walkable\n  def _is_walkable_cell(pos, target_grid, target_primitive_id, non_walkable_indices, width, height):\n      r, c = pos\n      if not (0 <= r < width and 0 <= c < height):\n          return False # Cell itself is out of bounds\n      \n      # A cell is not walkable if it contains any non-walkable entity\n      for kind_idx in non_walkable_indices:\n          if target_grid[r, c, kind_idx] > 0:\n              return False\n      \n      # Also, prevent walking directly onto the primitive itself, as we need to stop adjacent to it\n      if target_grid[r, c, target_primitive_id] > 0:\n          return False # Cannot walk onto the target primitive itself\n          \n      return True\n\n  # Helper 6: BFS to find path to primitive\n  # This BFS searches for a sequence of moves and turns to reach a state\n  # from which the agent can perform a 'USE' action on the primitive.\n  def _bfs_find_path(start_pos, start_dir, target_grid, target_primitive_id, \n                      non_walkable_indices, width, height,\n                      move_forward_action, turn_left_action, turn_right_action):\n      \n      # BFS state: ((row, col), direction)\n      # Queue stores ( (current_pos_tuple, current_dir_int), list_of_actions_to_reach_here )\n      queue = collections.deque([((start_pos, start_dir), [])])\n      # Visited set stores (current_pos_tuple, current_dir_int) to avoid cycles and redundant paths\n      visited = {(start_pos, start_dir)}\n\n      while queue:\n          (current_pos, current_dir), path_actions = queue.popleft()\n          \n          # Check if current state (position and direction) makes the primitive targetable\n          # If so, this path is a valid sequence of actions to get adjacent and facing.\n          if _is_target_state(current_pos, current_dir, target_grid, target_primitive_id, width, height):\n              return path_actions # Path to target state found\n\n          # Explore possible next actions: Move Forward, Turn Left, Turn Right\n          \n          # 1. Try Move Forward\n          move_dr, move_dc = DIR_TO_DRDC[current_dir]\n          next_r, next_c = current_pos[0] + move_dr, current_pos[1] + move_dc\n          next_pos = (next_r, next_c)\n          next_dir = current_dir # Direction doesn't change on move\n\n          if _is_walkable_cell(next_pos, target_grid, target_primitive_id, non_walkable_indices, width, height):\n              new_state = (next_pos, next_dir)\n              if new_state not in visited:\n                  visited.add(new_state)\n                  new_path = path_actions + [move_forward_action]\n                  queue.append((new_state, new_path))\n\n          # 2. Try Turn Left\n          next_dir_left = TURN_LEFT_MAP[current_dir]\n          new_state_left = (current_pos, next_dir_left)\n          if new_state_left not in visited:\n              visited.add(new_state_left)\n              new_path_left = path_actions + [turn_left_action]\n              queue.append((new_state_left, new_path_left))\n\n          # 3. Try Turn Right\n          next_dir_right = TURN_RIGHT_MAP[current_dir]\n          new_state_right = (current_pos, next_dir_right)\n          if new_state_right not in visited:\n              visited.add(new_state_right)\n              new_path_right = path_actions + [turn_right_action]\n              queue.append((new_state_right, new_path_right))\n      \n      return None # No path found to any target primitive was found\n\n  # Main logic for collect_v1\n  # The improvement over v0 is a slight simplification:\n  # The BFS function (_bfs_find_path) is now solely responsible for finding the path,\n  # including the case where the agent is already in a state to collect (in which case it returns []).\n  target_path_to_adjacent_state = _bfs_find_path(initial_pos, initial_dir, initial_grid, primitive_id, \n                                   non_walkable_kinds_indices, WIDTH, HEIGHT,\n                                   MOVE_FORWARD_ACTION, TURN_LEFT_ACTION, TURN_RIGHT_ACTION)\n\n  # If a path was found (or if the agent was already adjacent and facing, resulting in an empty path),\n  # append the USE action to complete the collection.\n  if target_path_to_adjacent_state is not None:\n      actions_list.extend(target_path_to_adjacent_state)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-08-01T06:32:51.168323", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (r, c)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Ensure the primitive exists and is something that can be 'collected' (i.e., is grabbable).\n  # If the primitive name is not found, or it's a non-grabbable entity (like a workshop or boundary),\n  # then we cannot \"collect\" it in the sense of using the USE action.\n  if primitive_id is None: \n      return []\n  if primitive_id not in current_state.world.grabbable_indices:\n      return []\n\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  action_map = env.action_specs()\n  # Map DSL movement/turn actions to their integer indices.\n  # In DMLab-style environments, 'UP' often corresponds to moving forward in the current direction.\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction.\n  # This defines how the agent's position changes when moving \"forward\".\n  # 0:RIGHT (+col), 1:UP (-row), 2:LEFT (-col), 3:DOWN (+row)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT (0), moves +1 in column\n      1: (-1, 0),  # Facing UP (1), moves -1 in row\n      2: (0, -1),  # Facing LEFT (2), moves -1 in column\n      3: (1, 0)    # Facing DOWN (3), moves +1 in row\n  }\n\n  # Maps for turning left/right, updating the agent's direction (0-3).\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # RIGHT -> UP -> LEFT -> DOWN -> RIGHT\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # RIGHT -> DOWN -> LEFT -> UP -> RIGHT\n\n  # Get indices of non-grabbable items that act as obstacles (e.g., BOUNDARY, WATER, WORKSHOP_X).\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # BFS setup:\n  # Queue stores ( (current_pos_tuple, current_dir_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (current_pos_tuple, current_dir_int) to avoid cycles and redundant paths.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # Stores the sequence of actions to reach the target state (adjacent and facing the primitive)\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Goal Check: Is the primitive directly in front of the agent at the current state?\n      # Calculate the coordinates of the cell directly in front of the agent.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the front cell is within grid bounds.\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          # Check if the front cell contains the primitive.\n          # If it does, we've found a path to be adjacent and facing the primitive.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Path to target found! Exit BFS.\n\n      # 2. Explore possible next actions: Move Forward, Turn Left, Turn Right.\n      \n      # --- Explore Move Forward ---\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction.\n\n      # Check if the next position is within bounds and this (position, direction) state hasn't been visited.\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT and\n          (next_pos, next_dir) not in visited):\n          \n          # Determine if the 'next_pos' is walkable.\n          # A cell is walkable if it does not contain any non-walkable entities (e.g., boundaries, water, workshops).\n          # Also, the agent cannot walk *onto* the primitive itself; it must stop *adjacent* to it.\n          is_walkable = True\n          for kind_idx in non_walkable_kinds_indices:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          # Explicitly prevent walking onto the target primitive itself.\n          if initial_grid[next_r, next_c, primitive_id] > 0:\n              is_walkable = False\n\n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # --- Explore Turn Left ---\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # --- Explore Turn Right ---\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path was successfully found (or if the agent started in a targetable position),\n  # append the USE action to complete the collection.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T06:32:52.388803", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (r, c)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  # Get the integer ID for the primitive from the cookbook's index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Basic validation: If primitive name doesn't map to an ID or is not grabbable,\n  # it cannot be collected using the 'USE' action.\n  if primitive_id is None or primitive_id not in current_state.world.grabbable_indices:\n      return []\n\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP'] # Assuming 'UP' means move forward in current direction\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define how agent's position changes based on its facing direction\n  # (dr, dc) for agent's facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT, moving forward increments column\n      1: (-1, 0),  # Facing UP, moving forward decrements row\n      2: (0, -1),  # Facing LEFT, moving forward decrements column\n      3: (1, 0)    # Facing DOWN, moving forward increments row\n  }\n\n  # Define how agent's direction changes when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # R->U->L->D->R\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # R->D->L->U->R\n\n  # Get indices of non-grabbable items that block agent movement\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # BFS setup\n  # Queue stores ( (current_pos_tuple, current_dir_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (current_pos_tuple, current_dir_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the sequence of actions to reach the target state\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # Check if the primitive is directly in front of the agent at the current state\n      # Calculate the coordinates of the cell directly in front of the agent\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the front cell is within grid boundaries\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          # If the front cell contains the primitive, we have found our target state\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Exit BFS as the shortest path to target is found\n\n      # Explore possible next actions: Move Forward, Turn Left, Turn Right\n      \n      # 1. Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if the next position is within bounds and the state hasn't been visited\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT and\n          (next_pos, next_dir) not in visited):\n          \n          # Check if next_pos is a walkable cell\n          # A cell is walkable if it does not contain any non-walkable entity (e.g., boundary, water)\n          # AND it does not contain the primitive itself (agent must stop *adjacent* to it, not *on* it)\n          is_walkable = True\n          for kind_idx in non_walkable_kinds_indices:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          \n          # Also, ensure we don't try to walk onto the primitive we want to collect\n          if initial_grid[next_r, next_c, primitive_id] > 0:\n              is_walkable = False\n\n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # 2. Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning only changes direction, not position\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # 3. Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning only changes direction, not position\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path was successfully found (target_path is not None), append the USE action\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T06:33:37.018810", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  \n  # Extract relevant information from the current state for pathfinding.\n  grid = current_state.grid\n  agent_initial_pos = current_state.pos  # (row, col)\n  agent_initial_dir = current_state.dir  # 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  # Get the integer ID for the target primitive (e.g., WOOD, STONE).\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Get grid dimensions to check for valid positions.\n  num_rows, num_cols, _ = grid.shape\n\n  # Retrieve numerical action codes from the environment's action specifications.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # In CraftWorld, 'UP' moves the agent forward.\n  TURN_LEFT_ACTION = action_map['LEFT']     # Turns agent 90 degrees counter-clockwise.\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Turns agent 90 degrees clockwise.\n  USE_ACTION = action_map['USE']            # Interacts with the cell directly in front.\n\n  # Define how agent's position changes based on direction when moving forward.\n  # Maps direction (0-3) to a (delta_row, delta_column) vector.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT (East): (row, col + 1)\n      1: (-1, 0),  # Facing UP (North): (row - 1, col)\n      2: (0, -1),  # Facing LEFT (West): (row, col - 1)\n      3: (1, 0)    # Facing DOWN (South): (row + 1, col)\n  }\n\n  # Define how agent's direction changes after turning left or right.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Example: RIGHT (0) -> UP (1)\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Example: RIGHT (0) -> DOWN (3)\n\n  # Get indices of entities that are considered non-walkable terrain (e.g., walls, water, certain workshops).\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # Initialize Breadth-First Search (BFS):\n  # The queue stores tuples: ((current_agent_position, current_agent_direction), list_of_actions_taken_to_reach_this_state).\n  queue = collections.deque([((agent_initial_pos, agent_initial_dir), [])])\n  \n  # The 'visited' set keeps track of all unique (position, direction) states already explored\n  # to prevent cycles and ensure the shortest path is found.\n  visited = {(agent_initial_pos, agent_initial_dir)}\n\n  path_to_primitive_adjacency = None # This will store the action sequence if a path is found.\n\n  # Start BFS traversal to find the shortest path to a state where the agent is\n  # adjacent to and facing the target primitive.\n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      r, c = current_pos # Unpack current row and column.\n\n      # 1. Check if the target primitive is directly in front of the agent from the current state.\n      # This is the \"goal state\" for our pathfinding: being positioned to interact with the primitive.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the cell directly in front is within grid boundaries before checking its contents.\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n          # If the primitive is present in this cell, we have found a path that leads the agent\n          # to be adjacent to and facing the primitive.\n          if grid[front_r, front_c, primitive_id] > 0:\n              path_to_primitive_adjacency = path_so_far # Store the sequence of actions that led to this state.\n              break # Path found! Terminate BFS as we found the shortest path.\n\n      # 2. Explore all possible next actions (Move Forward, Turn Left, Turn Right) from the current state.\n\n      # --- Try Move Forward Action ---\n      # Calculate the next position if the agent moves forward. Direction remains unchanged.\n      next_r_move, next_c_move = r + front_dr, c + front_dc # Agent moves into the cell that was 'front'\n      next_pos_move = (next_r_move, next_c_move)\n      next_dir_move = current_dir # Moving forward does not change orientation.\n\n      # Check if the potential next position is within bounds and this new (position, direction) state\n      # has not been visited yet.\n      if (0 <= next_r_move < num_rows and 0 <= next_c_move < num_cols and\n          (next_pos_move, next_dir_move) not in visited):\n          \n          # Determine if the next cell is walkable.\n          # The agent cannot walk onto:\n          #   a) The primitive itself (interaction is from an adjacent square, not by stepping on it).\n          #   b) Any non-grabbable entities (like boundaries, water, or specific workshops that are impassable).\n          is_walkable = True\n          if grid[next_r_move, next_c_move, primitive_id] > 0: # Cannot walk onto the primitive itself\n              is_walkable = False\n          else:\n              for kind_idx in non_walkable_kinds_indices:\n                  if grid[next_r_move, next_c_move, kind_idx] > 0:\n                      is_walkable = False\n                      break\n\n          if is_walkable:\n              # If walkable, add the new state to the queue and mark it as visited.\n              visited.add((next_pos_move, next_dir_move))\n              queue.append(((next_pos_move, next_dir_move), path_so_far + [MOVE_FORWARD_ACTION]))\n\n      # --- Try Turn Left Action ---\n      # Calculate the new direction after turning left. Position remains unchanged.\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      if ((current_pos, next_dir_left) not in visited):\n          # Add the new state to the queue and mark as visited.\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_so_far + [TURN_LEFT_ACTION]))\n\n      # --- Try Turn Right Action ---\n      # Calculate the new direction after turning right. Position remains unchanged.\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      if ((current_pos, next_dir_right) not in visited):\n          # Add the new state to the queue and mark as visited.\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_so_far + [TURN_RIGHT_ACTION]))\n\n  # After BFS completes:\n  # If a path to the target (adjacent to and facing the primitive) was found,\n  # extend the found path with the final 'USE' action to collect the primitive.\n  # If no path was found (path_to_primitive_adjacency is None), an empty list is returned,\n  # indicating the primitive is unreachable from the current state.\n  if path_to_primitive_adjacency is not None:\n      actions_list.extend(path_to_primitive_adjacency)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T06:33:38.192793", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` using a Breadth-First Search (BFS) algorithm\n  to find the shortest sequence of actions to locate and collect a primitive.\n  \n    Args:\n        env (env.CraftLab): The CraftLab environment instance.\n        primitive (str): The string name of the primitive to be collected (e.g., \"WOOD\", \"STONE\").\n\n    Returns:\n        List[int]: A sequence of action indices to move the agent to a position\n                   adjacent to and facing the primitive, followed by the 'USE' action.\n                   Returns an empty list if the primitive is not found on the grid or is unreachable.\n  \"\"\"\n  current_state = env._current_state\n  \n  # 1. Extract Current State Information for Pathfinding\n  grid = current_state.grid\n  start_pos = current_state.pos  # Agent's initial position (row, col)\n  start_dir = current_state.dir  # Agent's initial facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook's index.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Get grid dimensions for boundary checks during movement.\n  num_rows, num_cols, _ = grid.shape\n\n  # Retrieve numerical action codes from the environment's action specifications.\n  action_map = env.action_specs()\n  ACT_FORWARD = action_map['UP']      # Moves agent forward in its current direction\n  ACT_LEFT = action_map['LEFT']       # Turns agent 90 degrees left\n  ACT_RIGHT = action_map['RIGHT']     # Turns agent 90 degrees right\n  ACT_USE = action_map['USE']         # Interacts with the entity directly in front\n\n  # 2. Define Agent Movement and Direction Mechanics\n  # DRDC: Maps agent's direction (0-3) to a (delta_row, delta_column) vector.\n  # This vector indicates the change in coordinates for the cell directly in front of the agent.\n  DRDC = {\n      0: (0, 1),   # Facing RIGHT (East): (row, col+1)\n      1: (-1, 0),  # Facing UP (North): (row-1, col)\n      2: (0, -1),  # Facing LEFT (West): (row, col-1)\n      3: (1, 0)    # Facing DOWN (South): (row+1, col)\n  }\n\n  # TURN_L_MAP / TURN_R_MAP: Map current direction to the new direction after a turn.\n  TURN_L_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # e.g., RIGHT(0) -> UP(1)\n  TURN_R_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # e.g., RIGHT(0) -> DOWN(3)\n\n  # Get indices of entities that are considered non-walkable terrain (e.g., boundaries, water, workshops).\n  impassable_ids = current_state.world.non_grabbable_indices\n\n  # 3. BFS Initialization\n  # The queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_this_state).\n  queue = collections.deque([((start_pos, start_dir), [])])\n  \n  # The 'visited' set stores (position_tuple, direction_int) to prevent redundant exploration\n  # and cycles, ensuring the shortest path is found.\n  visited = {(start_pos, start_dir)}\n\n  # This variable will store the action sequence if a path is found,\n  # leading the agent to be adjacent to and facing the primitive (before the 'USE' action).\n  found_path = None \n\n  # 4. BFS Traversal\n  while queue:\n      (curr_pos, curr_dir), path_actions = queue.popleft()\n      r, c = curr_pos # Unpack current row and column.\n\n      # Check if the target primitive is directly in front of the agent from the current state.\n      # This is the \"goal state\" for our pathfinding: being positioned to interact with the primitive.\n      dr, dc = DRDC[curr_dir]\n      front_r, front_c = r + dr, c + dc\n      \n      # Ensure the cell directly in front is within grid boundaries.\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n          # If the primitive is present in this 'front' cell, we have found a path that leads the agent\n          # to be adjacent to and facing the primitive.\n          if grid[front_r, front_c, primitive_id] > 0:\n              found_path = path_actions # Store the sequence of actions that led to this state.\n              break # Path found! Terminate BFS as we found the shortest path.\n\n      # 5. Explore all possible next actions (Move Forward, Turn Left, Turn Right) from the current state.\n\n      # A) Try Move Forward Action\n      # Calculate the next position if the agent moves forward. Direction remains unchanged.\n      next_pos_fwd = (front_r, front_c) # Agent moves into the cell that was previously \"front\".\n      next_dir_fwd = curr_dir # Moving forward does not change orientation.\n\n      # Check if the potential next position is within bounds and this new (position, direction) state\n      # has not been visited yet.\n      if (0 <= next_pos_fwd[0] < num_rows and 0 <= next_pos_fwd[1] < num_cols and\n          (next_pos_fwd, next_dir_fwd) not in visited):\n          \n          # Determine if the next cell is walkable.\n          # The agent cannot walk onto:\n          #   a) The primitive itself (interaction is from an adjacent square, not by stepping on it).\n          #   b) Any non-grabbable/impassable entities (like boundaries, water, or specific workshops).\n          is_walkable = True\n          # First, check if the cell contains the primitive we are looking for.\n          if grid[next_pos_fwd[0], next_pos_fwd[1], primitive_id] > 0:\n              is_walkable = False\n          else: # If not the primitive, check other impassable kinds.\n              for kind_idx in impassable_ids:\n                  if grid[next_pos_fwd[0], next_pos_fwd[1], kind_idx] > 0:\n                      is_walkable = False\n                      break\n\n          if is_walkable:\n              # If walkable, add the new state to the queue and mark it as visited.\n              visited.add((next_pos_fwd, next_dir_fwd))\n              queue.append(((next_pos_fwd, next_dir_fwd), path_actions + [ACT_FORWARD]))\n\n      # B) Try Turn Left Action\n      # Calculate the new direction after turning left. Position remains unchanged.\n      next_dir_left = TURN_L_MAP[curr_dir]\n      # Check if this new state (same position, new direction) has not been visited.\n      if ((curr_pos, next_dir_left) not in visited):\n          # Add the new state to the queue and mark as visited.\n          visited.add((curr_pos, next_dir_left))\n          queue.append(((curr_pos, next_dir_left), path_actions + [ACT_LEFT]))\n\n      # C) Try Turn Right Action\n      # Calculate the new direction after turning right. Position remains unchanged.\n      next_dir_right = TURN_R_MAP[curr_dir]\n      # Check if this new state has not been visited.\n      if ((curr_pos, next_dir_right) not in visited):\n          # Add the new state to the queue and mark as visited.\n          visited.add((curr_pos, next_dir_right))\n          queue.append(((curr_pos, next_dir_right), path_actions + [ACT_RIGHT]))\n\n  # 6. Finalize Actions\n  # After BFS completes:\n  # If a path to the target state (agent adjacent and facing the primitive) was found,\n  # append the final 'USE' action to the discovered path. This completes the collection sequence.\n  # If no path was found (found_path remains None), an empty list is returned.\n  final_actions = []\n  if found_path is not None:\n      final_actions = found_path + [ACT_USE]\n\n  return final_actions", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T06:34:33.167824", "function_name": "collect", "function_body": "  current_state = env._current_state\n  \n  # Get the integer index for the primitive from the cookbook\n  primitive_idx = env.world.cookbook.index.index(primitive)\n  \n  # Map action names to their integer IDs for clarity\n  action_map = env.action_specs()\n  DOWN = action_map['DOWN']\n  UP = action_map['UP']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # --- Helper Mappings for Directions and Movements ---\n  # CraftState dir: 0=North (Y-), 1=East (X+), 2=South (Y+), 3=West (X-)\n\n  # Maps (dx, dy) vector from agent's position to a target position\n  # to the direction the agent must be facing to hit that target.\n  # E.g., if agent is at (0,0) and target is at (0,-1) (North), agent must face North (dir 0).\n  DXDY_TO_AGENT_DIR = {\n      (0, -1): 0, # Target is North of agent -> agent faces North\n      (1, 0): 1,  # Target is East of agent  -> agent faces East\n      (0, 1): 2,  # Target is South of agent -> agent faces South\n      (-1, 0): 3, # Target is West of agent  -> agent faces West\n  }\n\n  # Maps movement action to the (dx, dy) change in position and the resulting agent direction.\n  # Note: Moving UP (action 1) makes the agent face North (dir 0).\n  MOVE_ACTIONS_DETAILS = {\n      UP: ((0, -1), 0),    # Action: UP, Delta: (0, -1), New Dir: 0 (North)\n      DOWN: ((0, 1), 2),   # Action: DOWN, Delta: (0, 1), New Dir: 2 (South)\n      LEFT: ((-1, 0), 3),  # Action: LEFT, Delta: (-1, 0), New Dir: 3 (West)\n      RIGHT: ((1, 0), 1),  # Action: RIGHT, Delta: (1, 0), New Dir: 1 (East)\n  }\n  \n  # Direction vectors corresponding to agent's dir (0:N, 1:E, 2:S, 3:W)\n  # Used to find the cell in front of the agent.\n  DIR_INDEX_TO_DXDY = {\n      0: (0, -1), # North\n      1: (1, 0),  # East\n      2: (0, 1),  # South\n      3: (-1, 0), # West\n  }\n\n  # --- Step 1: Immediate Collection Check ---\n  # If the primitive is directly in front of the agent, we can collect it immediately.\n  cx, cy = current_state.pos\n  current_dir_idx = current_state.dir\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  # Determine the cell directly in front of the agent\n  if current_dir_idx in DIR_INDEX_TO_DXDY:\n      dx_front, dy_front = DIR_INDEX_TO_DXDY[current_dir_idx]\n      target_x, target_y = cx + dx_front, cy + dy_front\n      \n      # Check if the target cell is within grid bounds and contains the primitive\n      if (0 <= target_x < grid_width and 0 <= target_y < grid_height and \n          grid[target_x, target_y, primitive_idx] > 0):\n          return [USE]\n\n  # --- Step 2: Identify Primitive Locations on the Grid ---\n  # Find all cells on the grid that contain the target primitive.\n  all_primitive_locations = []\n  for x in range(grid_width):\n    for y in range(grid_height):\n      if grid[x, y, primitive_idx] > 0:\n        all_primitive_locations.append((x, y))\n\n  # --- Step 3: Define Goal States for BFS ---\n  # A \"goal state\" for our BFS is an (agent_x, agent_y, agent_direction) tuple\n  # from which the 'USE' action can successfully collect the primitive.\n  # This means the agent must be adjacent to the primitive and facing it.\n  goal_states = set()\n  # Relative coordinates for cardinal neighbors (where agent can stand relative to primitive)\n  CARDINAL_NEIGHBORS = [(0, -1), (0, 1), (-1, 0), (1, 0)] # North, South, West, East\n\n  for px, py in all_primitive_locations:\n    for dx_rel, dy_rel in CARDINAL_NEIGHBORS:\n      # Candidate agent position (gx, gy) adjacent to the primitive\n      gx, gy = px + dx_rel, py + dy_rel \n\n      # Ensure the candidate agent position is within grid boundaries\n      if not (0 <= gx < grid_width and 0 <= gy < grid_height):\n        continue\n      \n      # Determine the direction the agent at (gx, gy) needs to face to look at (px, py)\n      # This is the vector from agent's potential position to primitive's position.\n      vec_to_primitive_x, vec_to_primitive_y = px - gx, py - gy\n      \n      if (vec_to_primitive_x, vec_to_primitive_y) in DXDY_TO_AGENT_DIR:\n        required_agent_dir = DXDY_TO_AGENT_DIR[(vec_to_primitive_x, vec_to_primitive_y)]\n        goal_states.add((gx, gy, required_agent_dir))\n\n  if not goal_states:\n      # No primitive found, or no valid positions to collect it from.\n      return []\n\n  # --- Step 4: Perform BFS to Find Shortest Path ---\n  start_pos_x, start_pos_y = current_state.pos\n  start_agent_dir = current_state.dir\n  \n  # BFS queue: Stores (x, y, agent_direction) states to visit\n  q = collections.deque([(start_pos_x, start_pos_y, start_agent_dir)])\n  \n  # Visited set/dict: Stores {(x, y, agent_direction): (parent_x, parent_y, parent_dir, action_to_reach_here)}\n  # Used to reconstruct the path.\n  visited = {(start_pos_x, start_pos_y, start_agent_dir): (None, None, None, None)}\n\n  # Determine impassable terrain for the agent (cannot stand on these cells)\n  # Workshops are typically traversable even if non-grabbable.\n  impassable_terrain_indices = set(env.world.non_grabbable_indices) - set(env.world.workshop_indices)\n\n  found_goal_state = None # To store the first goal state found by BFS\n\n  while q:\n    cx, cy, c_dir = q.popleft()\n    current_bfs_state = (cx, cy, c_dir)\n\n    # If we reached a goal state, we found the shortest path.\n    if current_bfs_state in goal_states:\n      found_goal_state = current_bfs_state\n      break \n\n    # Explore possible moves (UP, DOWN, LEFT, RIGHT)\n    for action, (d_pos, n_dir) in MOVE_ACTIONS_DETAILS.items():\n      dx, dy = d_pos\n      nx, ny = cx + dx, cy + dy # New position after move\n      new_bfs_state = (nx, ny, n_dir) # New state including agent's new direction\n\n      # Check grid boundaries for the new position\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue\n\n      # Check if the new position is traversable (not impassable terrain)\n      is_new_pos_impassable = False\n      for k_idx in impassable_terrain_indices:\n          if grid[nx, ny, k_idx] > 0: # If the cell contains an impassable kind\n              is_new_pos_impassable = True\n              break\n      \n      if is_new_pos_impassable:\n          continue\n\n      # If this new state (position and direction) hasn't been visited, add it to the queue\n      if new_bfs_state not in visited:\n        visited[new_bfs_state] = (cx, cy, c_dir, action) # Record parent state and action\n        q.append(new_bfs_state)\n\n  if found_goal_state is None:\n    # No path could be found to any of the primitive's collection points.\n    return []\n\n  # --- Step 5: Reconstruct Path and Append USE Action ---\n  path_actions = []\n  current_path_state = found_goal_state\n  \n  # Backtrack from the found goal state to the initial state\n  while current_path_state != (start_pos_x, start_pos_y, start_agent_dir):\n    parent_x, parent_y, parent_dir, action_taken = visited[current_path_state]\n    path_actions.append(action_taken)\n    current_path_state = (parent_x, parent_y, parent_dir)\n  \n  path_actions.reverse() # Reverse the path to get actions in correct order\n\n  # Finally, append the 'USE' action to collect the primitive\n  return path_actions + [USE]", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T06:34:34.298719", "function_name": "collect", "function_body": "  current_state = env._current_state\n  \n  # Retrieve the integer index for the primitive from the cookbook's index.\n  # This converts the string name (e.g., \"WOOD\") into its numerical ID.\n  primitive_idx = env.world.cookbook.index.index(primitive)\n  \n  # Get the mapping from action names (strings) to their integer codes.\n  action_map = env.action_specs()\n  DOWN = action_map['DOWN']\n  UP = action_map['UP']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Define mappings for agent direction and movement.\n  # Agent directions: 0=North, 1=East, 2=South, 3=West.\n  # These are relative to the grid:\n  # North: (0, -1) = Up on a typical Cartesian grid (Y decreases)\n  # East: (1, 0)   = Right (X increases)\n  # South: (0, 1)  = Down (Y increases)\n  # West: (-1, 0)  = Left (X decreases)\n\n  # Maps (dx, dy) vector from agent's current position to a target's position\n  # to the integer index of the direction the agent needs to face to hit that target.\n  DXDY_TO_DIR_INDEX = {\n      (0, -1): 0, # Target is North of agent, agent faces North\n      (1, 0): 1,  # Target is East of agent, agent faces East\n      (0, 1): 2,  # Target is South of agent, agent faces South\n      (-1, 0): 3, # Target is West of agent, agent faces West\n  }\n\n  # Maps a movement action (UP, DOWN, LEFT, RIGHT) to the resulting direction\n  # the agent will be facing after taking that action.\n  ACTION_TO_RESULTING_DIR_INDEX = {\n      UP: 0,    # Moving UP (action 1) makes agent face North (dir 0)\n      RIGHT: 1, # Moving RIGHT (action 3) makes agent face East (dir 1)\n      DOWN: 2,  # Moving DOWN (action 0) makes agent face South (dir 2)\n      LEFT: 3,  # Moving LEFT (action 2) makes agent face West (dir 3)\n  }\n\n  # Maps an agent's current direction index to the (dx, dy) vector representing\n  # the cell directly in front of the agent.\n  DIR_INDEX_TO_DXDY = {\n      0: (0, -1), # North: (x, y-1)\n      1: (1, 0),  # East: (x+1, y)\n      2: (0, 1),  # South: (x, y+1)\n      3: (-1, 0), # West: (x-1, y)\n  }\n\n  # Get current agent position and direction.\n  cx, cy = current_state.pos\n  current_dir_idx = current_state.dir\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  # --- Step 1: Check if the primitive is already directly in front of the agent ---\n  # If so, a single USE action is sufficient.\n  if current_dir_idx in DIR_INDEX_TO_DXDY:\n      dx, dy = DIR_INDEX_TO_DXDY[current_dir_idx]\n      target_x, target_y = cx + dx, cy + dy\n      \n      # Check if the target cell is within grid bounds and contains the primitive.\n      if (0 <= target_x < grid_width and 0 <= target_y < grid_height and \n          grid[target_x, target_y, primitive_idx] > 0):\n          return [USE]\n\n  # --- Step 2: Find all locations of the primitive on the entire grid ---\n  # These are the potential targets for the USE action.\n  primitive_locations = []\n  for x in range(grid_width):\n    for y in range(grid_height):\n      if grid[x, y, primitive_idx] > 0:\n        primitive_locations.append((x, y))\n\n  # --- Step 3: Define \"goal states\" for the agent's BFS ---\n  # A goal state is a (agent_x, agent_y, agent_direction) tuple from which the\n  # agent can perform a 'USE' action to collect the primitive.\n  # This means the agent must be adjacent to a primitive and facing it.\n  goal_states = set()\n  for px, py in primitive_locations:\n    # Consider the four cardinal neighbors of the primitive where the agent could stand.\n    for dx_rel, dy_rel in [(0, -1), (0, 1), (-1, 0), (1, 0)]: # North, South, West, East relative to primitive\n      gx, gy = px + dx_rel, py + dy_rel # Agent's potential position (goal position)\n\n      # Ensure this potential agent position is within grid boundaries.\n      if not (0 <= gx < grid_width and 0 <= gy < grid_height):\n        continue\n      \n      # Determine the direction the agent at (gx, gy) must face to target (px, py).\n      required_dx, required_dy = px - gx, py - gy\n      \n      if (required_dx, required_dy) in DXDY_TO_DIR_INDEX:\n        required_agent_dir = DXDY_TO_DIR_INDEX[(required_dx, required_dy)]\n        goal_states.add((gx, gy, required_agent_dir))\n\n  # If no primitive is found, or no valid adjacent positions, collecting is impossible.\n  if not goal_states:\n      return []\n\n  # --- Step 4: Perform a Breadth-First Search (BFS) to find the shortest path ---\n  # The BFS state is (agent_x, agent_y, agent_direction).\n  start_pos = current_state.pos\n  start_dir = current_state.dir\n  \n  # Queue for BFS: stores (x, y, agent_dir_at_this_pos)\n  q = collections.deque([(start_pos[0], start_pos[1], start_dir)])\n  \n  # Dictionary to reconstruct path:\n  # Stores {(x, y, dir): (parent_x, parent_y, parent_dir, action_to_reach_here)}\n  visited = {(start_pos[0], start_pos[1], start_dir): (None, None, None, None)}\n\n  # Define possible movement actions, their (dx, dy) effect, and the resulting agent direction.\n  MOVE_ACTIONS_AND_NEW_DIRS = [\n      ((0, -1), UP, ACTION_TO_RESULTING_DIR_INDEX[UP]),    # Move North\n      ((0, 1), DOWN, ACTION_TO_RESULTING_DIR_INDEX[DOWN]), # Move South\n      ((-1, 0), LEFT, ACTION_TO_RESULTING_DIR_INDEX[LEFT]),# Move West\n      ((1, 0), RIGHT, ACTION_TO_RESULTING_DIR_INDEX[RIGHT]),# Move East\n  ]\n\n  # Identify impassable entity kinds. These are non-grabbable entities\n  # that the agent cannot move onto or through (e.g., water, boundary).\n  # Workshops are non-grabbable but are usually passable, so exclude them.\n  impassable_kinds = set()\n  for idx in env.world.non_grabbable_indices:\n      if idx not in env.world.workshop_indices:\n          impassable_kinds.add(idx)\n\n  found_goal_state = None\n\n  while q:\n    cx, cy, c_dir = q.popleft()\n    current_bfs_state = (cx, cy, c_dir)\n\n    # If the current state is one of our predefined goal states, we've found the shortest path.\n    if current_bfs_state in goal_states:\n      found_goal_state = current_bfs_state\n      break\n\n    # Explore all possible next states (move actions)\n    for (dx, dy), action, n_dir in MOVE_ACTIONS_AND_NEW_DIRS:\n      nx, ny = cx + dx, cy + dy\n      new_bfs_state = (nx, ny, n_dir)\n\n      # Check for valid grid boundaries.\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue\n\n      # Check if the new position contains an impassable object.\n      is_impassable = False\n      for k_idx in impassable_kinds:\n          if grid[nx, ny, k_idx] > 0: # If there's any quantity of an impassable kind\n              is_impassable = True\n              break\n      \n      if is_impassable:\n          continue\n\n      # If this new state (position and direction) has not been visited yet,\n      # add it to the queue and mark it as visited.\n      if new_bfs_state not in visited:\n        visited[new_bfs_state] = (cx, cy, c_dir, action) # Store parent and action\n        q.append(new_bfs_state)\n\n  # If no path to any goal state was found after BFS, the primitive is unreachable.\n  if found_goal_state is None:\n    return []\n\n  # --- Step 5: Reconstruct the path of actions ---\n  # Backtrack from the found_goal_state to the start_state using the 'visited' map.\n  path_actions = []\n  current_path_state = found_goal_state\n  \n  # Loop until we reach the initial state (which has a None parent).\n  while current_path_state != (start_pos[0], start_pos[1], start_dir):\n    px, py, p_dir, action_taken = visited[current_path_state]\n    path_actions.append(action_taken)\n    current_path_state = (px, py, p_dir)\n  \n  # The path was constructed in reverse order (from goal to start), so reverse it.\n  path_actions.reverse()\n\n  # Finally, append the 'USE' action to collect the primitive once the agent is in position.\n  return path_actions + [USE]", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T06:35:07.100565", "function_name": "collect", "function_body": "  actions_list = []\n  # Get the current state of the environment. This state includes the grid,\n  # agent's position, direction, and inventory.\n  current_state = env._current_state\n\n  # Store initial grid, position, and direction for pathfinding.\n  # The grid is considered static during pathfinding; only agent's (pos, dir) changes.\n  initial_grid = current_state.grid\n  initial_agent_pos = current_state.pos # Agent's starting row, column tuple (r, c)\n  initial_agent_dir = current_state.dir # Agent's starting direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the world's cookbook index.\n  # This ID is used to locate the primitive on the grid.\n  primitive_kind_id = current_state.world.cookbook.index[primitive]\n\n  # Get grid dimensions to check boundaries during pathfinding.\n  GRID_WIDTH, GRID_HEIGHT, _ = initial_grid.shape\n\n  # Retrieve the mapping from action names (strings) to their integer codes.\n  # This ensures compatibility with the environment's `step` method.\n  action_name_to_id = env.action_specs()\n  \n  # Map DSL movement/turn actions to their integer indices.\n  MOVE_FORWARD_ACTION_ID = action_name_to_id['UP'] # 'UP' in DSL means 'move forward'\n  TURN_LEFT_ACTION_ID = action_name_to_id['LEFT']\n  TURN_RIGHT_ACTION_ID = action_name_to_id['RIGHT']\n  USE_ACTION_ID = action_name_to_id['USE'] # Action to perform collection/interaction\n\n  # Define direction vectors for moving forward based on current orientation.\n  # Maps agent's direction index to (delta_row, delta_column) for a forward step.\n  # Agent's direction (dir): 0=RIGHT, 1=UP, 2=LEFT, 3=DOWN\n  DIRECTION_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col + 1)\n      1: (-1, 0),  # Facing UP: (row - 1, col)\n      2: (0, -1),  # Facing LEFT: (row, col - 1)\n      3: (1, 0)    # Facing DOWN: (row + 1, col)\n  }\n\n  # Define how agent's direction changes when turning left or right.\n  # These mappings cycle through the four cardinal directions (0, 1, 2, 3).\n  TURN_LEFT_DIR_MAP = {0: 1, 1: 2, 2: 3, 3: 0} # Example: RIGHT (0) -> UP (1)\n  TURN_RIGHT_DIR_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Example: RIGHT (0) -> DOWN (3)\n\n  # Identify all entity kinds that act as obstacles to agent movement.\n  # An agent cannot walk onto cells containing these items.\n  # 1. Non-grabbable entities (e.g., BOUNDARY, WATER, WORKSHOP0) are inherently obstacles.\n  unwalkable_kind_ids = set(current_state.world.non_grabbable_indices)\n  \n  # 2. If the target primitive itself is a grabbable item (e.g., WOOD, STONE, GOLD),\n  #    the agent should not walk directly onto its tile. It must interact from an\n  #    adjacent cell. Thus, the primitive's own ID is also added as an obstacle for movement.\n  if primitive_kind_id in current_state.world.grabbable_indices:\n      unwalkable_kind_ids.add(primitive_kind_id)\n  \n  # Early Exit Optimization: If the primitive is already in the agent's 3x3\n  # neighborhood (i.e., immediately collectible from the current position), just return the USE action.\n  # The `CraftState.next_to` method provides this check efficiently.\n  if current_state.next_to(primitive_kind_id):\n      return [USE_ACTION_ID]\n\n  # Initialize Breadth-First Search (BFS) for pathfinding.\n  # The BFS queue stores tuples:\n  #   ((current_position_tuple (r, c), current_direction_int), list_of_actions_taken_to_reach_here)\n  # This structure allows tracking both spatial location and agent orientation.\n  bfs_queue = collections.deque([((initial_agent_pos, initial_agent_dir), [])])\n  \n  # The 'visited' set keeps track of (position, direction) pairs already explored\n  # to prevent cycles and redundant computations, ensuring the shortest path is found.\n  visited_states = {(initial_agent_pos, initial_agent_dir)}\n\n  path_to_collection_spot = None # This will store the shortest action sequence to a collectible state.\n\n  # Main BFS loop: continues until the queue is empty or a path to a goal is found.\n  while bfs_queue:\n      # Dequeue the current state (position and direction) and the path leading to it.\n      (current_pos, current_dir), current_path_actions = bfs_queue.popleft()\n      r, c = current_pos\n\n      # Check if the current agent position (r, c) is a \"goal state\" for collection.\n      # A goal state means the primitive is located in any cell within the 3x3 neighborhood\n      # around the agent's current position on the initial grid. This mirrors the `CraftState.next_to` logic.\n      is_primitive_in_neighborhood = False\n      for dr_offset in [-1, 0, 1]: # Iterate through relative row offsets (-1, 0, 1)\n          for dc_offset in [-1, 0, 1]: # Iterate through relative column offsets (-1, 0, 1)\n              check_r, check_c = r + dr_offset, c + dc_offset\n              # Ensure the cell being checked is within grid boundaries.\n              if (0 <= check_r < GRID_WIDTH and 0 <= check_c < GRID_HEIGHT and\n                  initial_grid[check_r, check_c, primitive_kind_id] > 0):\n                  is_primitive_in_neighborhood = True\n                  break # Primitive found in neighborhood, no need to check further cells for this position.\n          if is_primitive_in_neighborhood:\n              break # Break outer loop too if found.\n\n      if is_primitive_in_neighborhood:\n          path_to_collection_spot = current_path_actions # A shortest path to a collectible state is found.\n          break # Terminate BFS; no need to explore further as we found the shortest path.\n\n      # Explore possible next states by applying valid actions: Move Forward, Turn Left, Turn Right.\n\n      # 1. Try MOVE_FORWARD_ACTION:\n      delta_r, delta_c = DIRECTION_TO_DRDC[current_dir]\n      next_r, next_c = r + delta_r, c + delta_c\n      next_agent_pos = (next_r, next_c)\n      next_agent_dir_after_move = current_dir # Moving forward does not change the agent's facing direction.\n\n      # Check if the potential next position is valid (within bounds and not previously visited with this direction).\n      if (0 <= next_r < GRID_WIDTH and 0 <= next_c < GRID_HEIGHT and\n          (next_agent_pos, next_agent_dir_after_move) not in visited_states):\n          \n          is_cell_walkable = True\n          # Verify that the cell at `next_agent_pos` does not contain any obstacle.\n          for kind_idx in unwalkable_kind_ids:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_cell_walkable = False\n                  break # This cell contains an obstacle, so it's not walkable.\n\n          if is_cell_walkable:\n              visited_states.add((next_agent_pos, next_agent_dir_after_move)) # Mark the new state as visited.\n              # Add the new state to the queue with the updated path.\n              bfs_queue.append(((next_agent_pos, next_agent_dir_after_move), \n                                current_path_actions + [MOVE_FORWARD_ACTION_ID]))\n\n      # 2. Try TURN_LEFT_ACTION:\n      next_agent_dir_left = TURN_LEFT_DIR_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_agent_dir_left) not in visited_states):\n          visited_states.add((current_pos, next_agent_dir_left))\n          bfs_queue.append(((current_pos, next_agent_dir_left), \n                            current_path_actions + [TURN_LEFT_ACTION_ID]))\n\n      # 3. Try TURN_RIGHT_ACTION:\n      next_agent_dir_right = TURN_RIGHT_DIR_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_agent_dir_right) not in visited_states):\n          visited_states.add((current_pos, next_agent_dir_right))\n          bfs_queue.append(((current_pos, next_agent_dir_right), \n                            current_path_actions + [TURN_RIGHT_ACTION_ID]))\n\n  # After BFS completes:\n  # If a path to a collectable position was found (`path_to_collection_spot` is not None),\n  # append the final 'USE' action to perform the collection.\n  if path_to_collection_spot is not None:\n      actions_list.extend(path_to_collection_spot)\n      actions_list.append(USE_ACTION_ID)\n\n  return actions_list", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T06:35:08.269994", "function_name": "collect", "function_body": "  actions_list = []\n  # Get the current state of the environment. This state includes the grid,\n  # agent's position, direction, and inventory.\n  current_state = env._current_state\n\n  # Store initial grid, position, and direction for pathfinding.\n  # The grid is considered static during pathfinding; only agent's (pos, dir) changes.\n  initial_grid = current_state.grid\n  initial_agent_pos = current_state.pos # Agent's starting row, column tuple (r, c)\n  initial_agent_dir = current_state.dir # Agent's starting direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the world's cookbook index.\n  # This ID is used to locate the primitive on the grid.\n  primitive_kind_id = current_state.world.cookbook.index[primitive]\n\n  # Get grid dimensions to check boundaries during pathfinding.\n  GRID_WIDTH, GRID_HEIGHT, _ = initial_grid.shape\n\n  # Retrieve the mapping from action names (strings) to their integer codes.\n  # This ensures compatibility with the environment's `step` method.\n  action_name_to_id = env.action_specs()\n  \n  # Map DSL movement/turn actions to their integer indices.\n  MOVE_FORWARD_ACTION_ID = action_name_to_id['UP'] # 'UP' in DSL means 'move forward'\n  TURN_LEFT_ACTION_ID = action_name_to_id['LEFT']\n  TURN_RIGHT_ACTION_ID = action_name_to_id['RIGHT']\n  USE_ACTION_ID = action_name_to_id['USE'] # Action to perform collection/interaction\n\n  # Define direction vectors for moving forward based on current orientation.\n  # Maps agent's direction index to (delta_row, delta_column) for a forward step.\n  # Agent's direction (dir): 0=RIGHT, 1=UP, 2=LEFT, 3=DOWN\n  DIRECTION_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col + 1)\n      1: (-1, 0),  # Facing UP: (row - 1, col)\n      2: (0, -1),  # Facing LEFT: (row, col - 1)\n      3: (1, 0)    # Facing DOWN: (row + 1, col)\n  }\n\n  # Define how agent's direction changes when turning left or right.\n  # These mappings cycle through the four cardinal directions (0, 1, 2, 3).\n  TURN_LEFT_DIR_MAP = {0: 1, 1: 2, 2: 3, 3: 0} # Example: RIGHT (0) -> UP (1)\n  TURN_RIGHT_DIR_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Example: RIGHT (0) -> DOWN (3)\n\n  # Identify all entity kinds that act as obstacles to agent movement.\n  # An agent cannot walk onto cells containing these items.\n  # 1. Non-grabbable entities (e.g., BOUNDARY, WATER, WORKSHOP0) are inherently obstacles.\n  unwalkable_kind_ids = set(current_state.world.non_grabbable_indices)\n  \n  # 2. If the target primitive itself is a grabbable item (e.g., WOOD, STONE, GOLD),\n  #    the agent should not walk directly onto its tile. It must interact from an\n  #    adjacent cell. Thus, the primitive's own ID is also added as an obstacle for movement.\n  if primitive_kind_id in current_state.world.grabbable_indices:\n      unwalkable_kind_ids.add(primitive_kind_id)\n  \n  # Helper function to determine if a grid cell is walkable.\n  def _is_cell_walkable(r, c):\n      \"\"\"Checks if a cell (r, c) is within bounds and doesn't contain unwalkable items.\"\"\"\n      if not (0 <= r < GRID_WIDTH and 0 <= c < GRID_HEIGHT):\n          return False  # Out of bounds\n      \n      # Check if the cell contains any unwalkable kind.\n      for kind_idx in unwalkable_kind_ids:\n          if initial_grid[r, c, kind_idx] > 0:\n              return False  # Cell contains an obstacle\n      return True\n\n  # Helper function to check if the primitive is in the agent's 3x3 neighborhood.\n  def _is_primitive_in_agent_neighborhood(agent_r, agent_c):\n      \"\"\"Checks if the target primitive is in the 3x3 neighborhood of (agent_r, agent_c).\"\"\"\n      for dr_offset in [-1, 0, 1]:\n          for dc_offset in [-1, 0, 1]:\n              check_r, check_c = agent_r + dr_offset, agent_c + dc_offset\n              if (0 <= check_r < GRID_WIDTH and 0 <= check_c < GRID_HEIGHT and\n                  initial_grid[check_r, check_c, primitive_kind_id] > 0):\n                  return True\n      return False\n\n  # Early Exit Optimization: If the primitive is already in the agent's 3x3\n  # neighborhood (i.e., immediately collectible from the current position), just return the USE action.\n  # The `CraftState.next_to` method provides this check efficiently.\n  if current_state.next_to(primitive_kind_id):\n      return [USE_ACTION_ID]\n\n  # Initialize Breadth-First Search (BFS) for pathfinding.\n  # The BFS queue stores tuples:\n  #   ((current_position_tuple (r, c), current_direction_int), list_of_actions_taken_to_reach_here)\n  # This structure allows tracking both spatial location and agent orientation.\n  bfs_queue = collections.deque([((initial_agent_pos, initial_agent_dir), [])])\n  \n  # The 'visited' set keeps track of (position, direction) pairs already explored\n  # to prevent cycles and redundant computations, ensuring the shortest path is found.\n  visited_states = {(initial_agent_pos, initial_agent_dir)}\n\n  path_to_collection_spot = None # This will store the shortest action sequence to a collectible state.\n\n  # Main BFS loop: continues until the queue is empty or a path to a goal is found.\n  while bfs_queue:\n      # Dequeue the current state (position and direction) and the path leading to it.\n      (current_pos, current_dir), current_path_actions = bfs_queue.popleft()\n      r, c = current_pos\n\n      # Check if the current agent position (r, c) is a \"goal state\" for collection.\n      # A goal state means the primitive is located in any cell within the 3x3 neighborhood\n      # around the agent's current position on the initial grid.\n      if _is_primitive_in_agent_neighborhood(r, c):\n          path_to_collection_spot = current_path_actions # A shortest path to a collectible state is found.\n          break # Terminate BFS; no need to explore further as we found the shortest path.\n\n      # Explore possible next states by applying valid actions: Move Forward, Turn Left, Turn Right.\n      \n      # 1. Try MOVE_FORWARD_ACTION:\n      delta_r, delta_c = DIRECTION_TO_DRDC[current_dir]\n      next_r, next_c = r + delta_r, c + delta_c\n      next_agent_pos_after_move = (next_r, next_c)\n      next_agent_dir_after_move = current_dir # Moving forward does not change the agent's facing direction.\n\n      # Check if the next position is valid and walkable, and the state has not been visited.\n      if _is_cell_walkable(next_r, next_c) and \\\n         ((next_agent_pos_after_move, next_agent_dir_after_move) not in visited_states):\n          \n          visited_states.add((next_agent_pos_after_move, next_agent_dir_after_move)) # Mark the new state as visited.\n          # Add the new state to the queue with the updated path.\n          bfs_queue.append(((next_agent_pos_after_move, next_agent_dir_after_move), \n                            current_path_actions + [MOVE_FORWARD_ACTION_ID]))\n\n      # 2. Try TURN_LEFT_ACTION:\n      next_agent_dir_left = TURN_LEFT_DIR_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_agent_dir_left) not in visited_states):\n          visited_states.add((current_pos, next_agent_dir_left))\n          bfs_queue.append(((current_pos, next_agent_dir_left), \n                            current_path_actions + [TURN_LEFT_ACTION_ID]))\n\n      # 3. Try TURN_RIGHT_ACTION:\n      next_agent_dir_right = TURN_RIGHT_DIR_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_agent_dir_right) not in visited_states):\n          visited_states.add((current_pos, next_agent_dir_right))\n          bfs_queue.append(((current_pos, next_agent_dir_right), \n                            current_path_actions + [TURN_RIGHT_ACTION_ID]))\n\n  # After BFS completes:\n  # If a path to a collectable position was found (`path_to_collection_spot` is not None),\n  # append the final 'USE' action to perform the collection.\n  if path_to_collection_spot is not None:\n      actions_list.extend(path_to_collection_spot)\n      actions_list.append(USE_ACTION_ID)\n\n  return actions_list", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T06:36:28.697557", "function_name": "collect", "function_body": "  actions = []\n  \n  current_state = env._current_state \n  grid = current_state.grid\n  current_pos = current_state.pos\n  \n  # Get action mappings from the environment's action_specs\n  ACTION_MAP = env.action_specs()\n  UP = ACTION_MAP['UP']\n  DOWN = ACTION_MAP['DOWN']\n  LEFT = ACTION_MAP['LEFT']\n  RIGHT = ACTION_MAP['RIGHT']\n  USE = ACTION_MAP['USE']\n\n  # Get the integer ID of the primitive from the cookbook index\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Improvement for v2: Before pathfinding, check if the primitive is actually grabbable.\n  # The 'collect' function implies picking up the item into inventory. If it's a non-grabbable\n  # entity (like WATER, BOUNDARY, WORKSHOP), it cannot be collected. In such cases,\n  # an empty list of actions should be returned.\n  if primitive_id not in env.world.grabbable_indices:\n      return []\n\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Define movement deltas corresponding to actions\n  DELTAS = {\n      UP: (-1, 0),    # (dr, dc) for moving UP (decreases row index)\n      DOWN: (1, 0),   # (dr, dc) for moving DOWN (increases row index)\n      LEFT: (0, -1),  # (dr, dc) for moving LEFT (decreases col index)\n      RIGHT: (0, 1)   # (dr, dc) for moving RIGHT (increases col index)\n  }\n\n  # 1. Immediate check: If the agent is already next to the primitive, and it's grabbable (checked above),\n  # then a single 'USE' action is sufficient.\n  if current_state.next_to(primitive_id):\n      actions.append(USE)\n      return actions\n\n  # 2. Find all grid locations where the target primitive exists.\n  primitive_locations = []\n  for r in range(WIDTH):\n      for c in range(HEIGHT):\n          # Check if the primitive_id layer at (r, c) has a value of 1 (present)\n          if grid[r, c, primitive_id] == 1:\n              primitive_locations.append((r, c))\n\n  # If the primitive is not found anywhere on the grid, it's unreachable.\n  if not primitive_locations:\n      return []\n\n  # 3. Perform Breadth-First Search (BFS) to find the shortest path\n  #    to a cell that is adjacent to any of the primitive locations.\n  # Queue stores tuples: ((current_row, current_col), [list_of_actions_to_reach_here])\n  q = collections.deque([(current_pos, [])]) \n  visited = {current_pos} # Keep track of visited positions to avoid cycles and redundant paths\n\n  target_adjacent_path = None # Will store the action sequence to reach an adjacent cell\n\n  while q:\n      (r, c), path_so_far = q.popleft()\n\n      # Check if the current cell (r, c) is adjacent to any of the primitive's locations.\n      # Adjacency is defined by Manhattan distance of 1 (up, down, left, or right).\n      for pr, pc in primitive_locations:\n          if abs(r - pr) + abs(c - pc) == 1:\n              target_adjacent_path = path_so_far # This path gets us adjacent to the primitive\n              break # Found the shortest path to an adjacent cell, can stop BFS\n      \n      if target_adjacent_path is not None:\n          break # Exit BFS loop as the goal is met\n\n      # Explore valid neighboring cells\n      for action_dir, (dr, dc) in DELTAS.items():\n          nr, nc = r + dr, c + dc # Calculate new potential position\n\n          # Boundary check: Ensure the new position is within grid limits\n          if not (0 <= nr < WIDTH and 0 <= nc < HEIGHT):\n              continue\n          \n          # Traversability check: Ensure the new position is not occupied by a non-grabbable item.\n          # Non-grabbable items include boundaries, water, and workshops, which block movement.\n          is_traversable = True\n          for kind_idx in env.world.non_grabbable_indices:\n              if grid[nr, nc, kind_idx] == 1: # If this cell contains a non-grabbable item\n                  is_traversable = False\n                  break # This neighbor is an obstacle, cannot move here\n          \n          if not is_traversable:\n              continue # Skip this neighbor if it's an obstacle\n          \n          # If the neighbor has not been visited, add it to the queue for exploration\n          if (nr, nc) not in visited:\n              visited.add((nr, nc))\n              new_path = path_so_far + [action_dir]\n              q.append(((nr, nc), new_path))\n    \n  # 4. Construct the final action sequence\n  if target_adjacent_path is not None:\n      actions.extend(target_adjacent_path)\n      # At this point, we know primitive_id is grabbable due to the initial check.\n      # So, once adjacent, we can append the 'USE' action to collect it.\n      actions.append(USE) \n  \n  return actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T06:36:29.938846", "function_name": "collect", "function_body": "  actions = []\n  \n  # Get the current state, grid, and agent's position from the environment.\n  current_state = env._current_state \n  grid = current_state.grid\n  current_pos = current_state.pos\n  \n  # Get the integer ID for the primitive from the game's cookbook index.\n  # This converts the string name (e.g., \"WOOD\") into its corresponding numerical ID.\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Retrieve action mappings (e.g., 'UP', 'DOWN', 'USE') from the environment's specifications.\n  # This ensures compatibility with the specific action mapping used by the CraftLab instance.\n  _action_specs = env.action_specs()\n  UP = _action_specs['UP']\n  DOWN = _action_specs['DOWN']\n  LEFT = _action_specs['LEFT']\n  RIGHT = _action_specs['RIGHT']\n  USE = _action_specs['USE']\n\n  # Define movement deltas (row, col changes) for each cardinal direction action.\n  DELTAS = {\n      UP: (-1, 0),    # Moving UP decreases the row index.\n      DOWN: (1, 0),   # Moving DOWN increases the row index.\n      LEFT: (0, -1),  # Moving LEFT decreases the column index.\n      RIGHT: (0, 1)   # Moving RIGHT increases the column index.\n  }\n  \n  # Get grid dimensions.\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # --- Key Improvement for collect_v2 ---\n  # 1. Initial check for \"grabbability\":\n  # The 'collect' function implies acquiring an item into inventory. If the target primitive\n  # cannot be picked up (i.e., it's not in the set of grabbable indices), then no sequence\n  # of actions can \"collect\" it. In this case, we return an empty list immediately.\n  # This efficiently handles cases like trying to 'collect' \"WATER\", \"BOUNDARY\", or \"WORKSHOP\".\n  if primitive_id not in env.world.grabbable_indices:\n      return []\n\n  # 2. Check if the agent is already next to the primitive.\n  # The `next_to` method of CraftState checks if the specified primitive_id is\n  # present in any of the 8 surrounding cells (3x3 neighborhood, excluding agent's cell).\n  if current_state.next_to(primitive_id):\n      actions.append(USE) # If adjacent and grabbable (checked above), a single 'USE' action suffices.\n      return actions # Return the action list immediately.\n\n  # 3. Find all grid locations where the target primitive exists.\n  # We iterate through the entire grid to identify all cells that contain the primitive.\n  primitive_locations = []\n  for r in range(WIDTH):\n      for c in range(HEIGHT):\n          # A cell contains the primitive if its value in the primitive_id layer is 1.\n          if grid[r, c, primitive_id] == 1:\n              primitive_locations.append((r, c))\n\n  # If the primitive is not found anywhere on the grid, it cannot be collected.\n  # Return an empty list of actions as it's unreachable.\n  if not primitive_locations:\n      return []\n\n  # 4. Perform Breadth-First Search (BFS) to find the shortest path.\n  # The BFS aims to find the minimum number of moves to reach any cell that is\n  # adjacent to any instance of the target primitive.\n  # The queue stores tuples: ((current_row, current_col), [list_of_actions_to_reach_here]).\n  q = collections.deque([(current_pos, [])]) \n  # The `visited` set tracks all grid positions that have already been added to the queue.\n  # This prevents infinite loops in cyclic paths and ensures the shortest path is found.\n  visited = {current_pos} \n\n  # This variable will store the action sequence that leads to an adjacent cell.\n  target_adjacent_path = None \n\n  while q:\n      (r, c), path_so_far = q.popleft()\n\n      # For the current cell (r, c), check if it's adjacent to any primitive location.\n      # Adjacency is defined by a Manhattan distance of 1 (i.e., directly up, down, left, or right).\n      for pr, pc in primitive_locations:\n          if abs(r - pr) + abs(c - pc) == 1: \n              target_adjacent_path = path_so_far # Store this path, as it's the shortest found so far.\n              break # Stop checking other primitive locations if one is found.\n      \n      if target_adjacent_path is not None:\n          break # Exit the BFS loop as the primary goal (shortest path to an adjacent cell) is met.\n\n      # Explore valid neighboring cells (UP, DOWN, LEFT, RIGHT).\n      for action_dir, (dr, dc) in DELTAS.items():\n          nr, nc = r + dr, c + dc # Calculate the coordinates of the potential new position.\n\n          # Boundary check: Ensure the new position is within the grid limits.\n          if not (0 <= nr < WIDTH and 0 <= nc < HEIGHT):\n              continue # Skip this neighbor if it's out of bounds.\n          \n          # Traversability check: Determine if the agent can move into the new position.\n          # A cell is non-traversable if it contains any item listed in `non_grabbable_indices`.\n          # These are typically static obstacles like walls, water, or workshop structures.\n          is_traversable = True\n          for kind_idx in env.world.non_grabbable_indices:\n              if grid[nr, nc, kind_idx] == 1: # If the cell is occupied by a non-traversable item.\n                  is_traversable = False\n                  break # Mark as non-traversable and stop checking other kinds for this cell.\n          \n          if not is_traversable:\n              continue # Skip this neighbor if it's an obstacle.\n          \n          # If the neighbor is traversable and has not been visited yet, add it to the queue.\n          if (nr, nc) not in visited:\n              visited.add((nr, nc)) # Mark the new position as visited.\n              new_path = path_so_far + [action_dir] # Extend the current path with the action taken.\n              q.append(((nr, nc), new_path)) # Add the new state (position and path) to the queue.\n    \n  # 5. Construct the final action sequence.\n  # If a path to an adjacent cell was successfully found during the BFS.\n  if target_adjacent_path is not None:\n      actions.extend(target_adjacent_path) # Add the movement actions to reach the adjacent cell.\n      actions.append(USE) # After reaching an adjacent cell, perform the 'USE' action to collect the primitive.\n                          # The check for 'grabbable_indices' was already done at the beginning.\n  \n  return actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T06:37:19.146627", "function_name": "collect", "function_body": "  actions = []\n  \n  # Retrieve the current state from the environment. This state object contains\n  # the current grid layout, agent's position, and inventory, along with references\n  # to the CraftWorld configuration (cookbook, non-grabbable items, etc.).\n  current_state = env._current_state \n  grid = current_state.grid\n  current_pos = current_state.pos\n  \n  # Convert the human-readable primitive name (e.g., \"WOOD\", \"STONE\") into its\n  # corresponding integer ID, which is used internally by the grid and world data structures.\n  # The cookbook's index attribute provides this mapping.\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # EARLY EXIT: If the requested primitive is not a truly collectible resource\n  # (i.e., not in the `cookbook.primitives` set, which defines what can be picked up\n  # and used in recipes), then it cannot be \"collected\" in the sense of adding to inventory.\n  # Examples include \"WATER\", \"WORKSHOP0\", which are environment features, not items.\n  if primitive_id not in env.world.cookbook.primitives:\n      return [] # Return an empty list, as this primitive cannot be collected.\n\n  # Extract grid dimensions from the grid NumPy array's shape.\n  # Assuming WIDTH corresponds to rows and HEIGHT to columns.\n  NUM_ROWS, NUM_COLS, _ = grid.shape\n\n  # Obtain the integer representations for standard movement and interaction actions\n  # from the environment's action specifications. This ensures compatibility with\n  # the DMLab-style `env.step()` function and robustness to changes in action integer values.\n  action_map = env.action_specs()\n  DOWN = action_map['DOWN']\n  UP = action_map['UP']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Define coordinate changes (deltas) for each cardinal movement action.\n  # These are used to calculate the new (row, column) position after taking an action.\n  MOVE_DELTAS = {\n      UP: (-1, 0),    # Moving UP decreases the row index.\n      DOWN: (1, 0),   # Moving DOWN increases the row index.\n      LEFT: (0, -1),  # Moving LEFT decreases the column index.\n      RIGHT: (0, 1)   # Moving RIGHT increases the column index.\n  }\n\n  # --- Step 1: Immediate collection check ---\n  # Before starting a search, first check if the agent is already in a position\n  # to collect the primitive (i.e., within its 3x3 interaction neighborhood,\n  # implying it's cardinally adjacent or on the same cell).\n  # The `current_state.next_to()` method efficiently performs this check.\n  if current_state.next_to(primitive_id):\n      # If already next to it, a single 'USE' action is sufficient.\n      actions.append(USE)\n      return actions \n\n  # --- Step 2: Locate all instances of the target primitive on the grid ---\n  # We need to find all possible locations where the desired primitive exists.\n  # This serves as the set of potential targets for our pathfinding algorithm.\n  primitive_locations = []\n  for r in range(NUM_ROWS):\n      for c in range(NUM_COLS):\n          # If the grid layer corresponding to `primitive_id` has a value of 1 at (r, c),\n          # it indicates the primitive is present in that cell.\n          if grid[r, c, primitive_id] == 1:\n              primitive_locations.append((r, c))\n\n  # If no instances of the primitive are found anywhere on the grid,\n  # it's impossible to collect it, so return an empty list of actions.\n  if not primitive_locations:\n      return []\n\n  # --- Step 3: Breadth-First Search (BFS) for the shortest path ---\n  # The BFS aims to find the minimum number of movement actions required to reach\n  # any grid cell from which the agent can successfully `USE` (collect) the primitive.\n  # We're looking for a path to a cell that is cardinally adjacent to any primitive location.\n\n  # The BFS queue stores tuples: ((row, column), [list_of_actions_to_reach_this_point]).\n  bfs_queue = collections.deque([(current_pos, [])]) \n  # `visited_positions` is a set to keep track of grid cells already explored.\n  # This prevents infinite loops in cyclic paths and ensures the shortest path is found.\n  visited_positions = {current_pos} \n\n  # This variable will store the final sequence of movement actions once the\n  # shortest path to an adjacent, traversable cell is discovered.\n  shortest_path_to_adj_cell = None \n\n  # Start the BFS exploration.\n  while bfs_queue:\n      (current_r, current_c), path_so_far = bfs_queue.popleft()\n\n      # For the current cell (current_r, current_c), check if it is cardinally adjacent\n      # to any of the primitive locations found in Step 2.\n      # Cardinal adjacency means a Manhattan distance of 1 (directly up, down, left, or right).\n      # If so, this is a valid target cell from which the 'USE' action can be applied.\n      for target_primitive_r, target_primitive_c in primitive_locations:\n          if abs(current_r - target_primitive_r) + abs(current_c - target_primitive_c) == 1: \n              shortest_path_to_adj_cell = path_so_far # Store the path leading to this adjacent cell.\n              break # Found a valid target; no need to check other primitive locations for this path.\n      \n      if shortest_path_to_adj_cell is not None:\n          break # If the shortest path to an adjacent cell has been found, exit the BFS.\n\n      # Explore all four cardinal neighbors from the `current_pos`.\n      for action_direction, (dr, dc) in MOVE_DELTAS.items():\n          next_r, next_c = current_r + dr, current_c + dc # Calculate the coordinates of the potential next cell.\n          next_pos = (next_r, next_c)\n\n          # Validate the `next_pos`:\n          # 1. Boundary check: Ensure the new position is within the grid boundaries.\n          if not (0 <= next_r < NUM_ROWS and 0 <= next_c < NUM_COLS):\n              continue # Skip this neighbor if it's out of bounds.\n          \n          # 2. Traversability check: Determine if the agent can move onto `next_pos`.\n          # A cell is non-traversable if it contains any item whose ID is in the\n          # `env.world.non_grabbable_indices` set (e.g., walls, water, workshops).\n          is_traversable = True\n          for non_grabbable_kind_id in env.world.non_grabbable_indices:\n              if grid[next_r, next_c, non_grabbable_kind_id] == 1: \n                  is_traversable = False # This cell contains an obstacle.\n                  break # No need to check other non-grabbable types for this cell.\n          \n          if not is_traversable:\n              continue # Skip this neighbor if it's an obstacle.\n          \n          # 3. Visited check: If this neighbor has not been visited yet, add it to the queue.\n          # This ensures that BFS finds the shortest path by processing layers level by level.\n          if next_pos not in visited_positions:\n              visited_positions.add(next_pos) # Mark the position as visited.\n              # Extend the path with the action taken to reach this `next_pos`.\n              new_path_so_far = path_so_far + [action_direction] \n              bfs_queue.append((next_pos, new_path_so_far)) # Add the new state to the queue.\n    \n  # --- Step 4: Construct the final sequence of actions ---\n  # If the BFS successfully found a path to an adjacent, traversable cell:\n  if shortest_path_to_adj_cell is not None:\n      # First, append all the movement actions required to reach the target adjacent cell.\n      actions.extend(shortest_path_to_adj_cell)\n      \n      # Then, append the 'USE' action to actually collect the primitive.\n      # We already filtered for `primitive_id in env.world.cookbook.primitives` at the start,\n      # ensuring that if we reach this point, the item is indeed collectible.\n      actions.append(USE) \n  \n  return actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T06:37:20.301489", "function_name": "collect", "function_body": "  actions = []\n  \n  # Get the current state of the environment. This object provides access to\n  # the current grid layout, agent's position, inventory, and crucial world\n  # configuration details (like non-grabbable items and object IDs).\n  current_state = env._current_state \n  grid = current_state.grid # The 3D NumPy array representing the world grid.\n  current_pos = current_state.pos # Agent's current (row, column) position.\n  \n  # Obtain the integer IDs for standard actions (movement and 'USE').\n  # This makes the code robust to changes in the underlying action integer values.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Define coordinate changes (deltas) corresponding to each cardinal movement action.\n  # These are used to calculate new positions during pathfinding.\n  MOVE_DELTAS = {\n      UP: (-1, 0),    # Moving UP decreases the row index.\n      DOWN: (1, 0),   # Moving DOWN increases the row index.\n      LEFT: (0, -1),  # Moving LEFT decreases the column index.\n      RIGHT: (0, 1)   # Moving RIGHT increases the column index.\n  }\n\n  # Convert the human-readable primitive name (e.g., \"WOOD\", \"STONE\") into its\n  # corresponding integer ID, which is used for indexing into the grid and other\n  # world data structures.\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # --- Critical Initial Check: Is the requested primitive actually grabbable? ---\n  # The task is to \"collect\" the primitive. If an item is not in the\n  # `env.world.grabbable_indices` set (e.g., it's water, a boundary, or a workshop),\n  # it cannot be picked up and thus cannot be \"collected\". In such cases,\n  # no actions should be returned.\n  if primitive_id not in env.world.grabbable_indices:\n      return [] # Return an empty list if the item cannot be collected.\n\n  # Get grid dimensions (width, height) for boundary checks during pathfinding.\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # --- Step 1: Immediate Collection Check ---\n  # First, check if the agent is already positioned such that it can collect\n  # the primitive with a single `USE` action. `current_state.next_to()`\n  # efficiently checks the 3x3 neighborhood around the agent's current position.\n  if current_state.next_to(primitive_id):\n      actions.append(USE) # If so, only the USE action is needed.\n      return actions # Return immediately, as the goal is achieved.\n\n  # --- Step 2: Locate All Instances of the Target Primitive on the Grid ---\n  # Scan the entire grid to find all cells where the target primitive exists.\n  # These locations represent potential collection points.\n  primitive_locations = []\n  for r in range(WIDTH):\n      for c in range(HEIGHT):\n          # The grid is a 3D array: (row, column, kind_id). If grid[r, c, primitive_id]\n          # is 1, it means the primitive is present at that (r, c) cell.\n          if grid[r, c, primitive_id] == 1:\n              primitive_locations.append((r, c))\n\n  # If no instances of the primitive are found anywhere on the grid,\n  # it's impossible to collect it, so return an empty list of actions.\n  if not primitive_locations:\n      return []\n\n  # --- Step 3: Breadth-First Search (BFS) for the Shortest Path ---\n  # The BFS aims to find the shortest sequence of movement actions to reach\n  # any grid cell from which the agent can successfully `USE` (collect) the primitive.\n  # This means finding a path to a cell that is cardinally adjacent (Manhattan distance 1)\n  # to any of the located primitive_locations.\n\n  # The BFS queue stores tuples: ((current_row, current_col), [list_of_actions_to_reach_here]).\n  bfs_queue = collections.deque([(current_pos, [])]) \n  \n  # A set to keep track of visited (row, col) coordinates. This prevents\n  # redundant explorations and infinite loops in cyclic environments,\n  # ensuring that the shortest path is found.\n  visited_positions = {current_pos} \n\n  # This variable will store the final sequence of movement actions once the\n  # shortest path to an adjacent, traversable cell is discovered.\n  shortest_path_to_adj_cell = None \n\n  # Begin the BFS exploration.\n  while bfs_queue:\n      # Dequeue the current position and the path taken to reach it.\n      (current_r, current_c), path_so_far = bfs_queue.popleft()\n\n      # Goal Check: Check if the current cell (current_r, current_c) is\n      # cardinally adjacent to any of the primitive's known locations.\n      for target_primitive_r, target_primitive_c in primitive_locations:\n          # Calculate Manhattan distance. If it's 1, they are cardinally adjacent.\n          if abs(current_r - target_primitive_r) + abs(current_c - target_primitive_c) == 1: \n              shortest_path_to_adj_cell = path_so_far # Store the path leading to this adjacent cell.\n              break # Found a valid target; no need to check other primitive locations for this path.\n      \n      # If the shortest path to an adjacent cell has been found, exit the BFS.\n      if shortest_path_to_adj_cell is not None:\n          break \n\n      # Explore all four cardinal neighbors from the `current_pos`.\n      for action_direction, (dr, dc) in MOVE_DELTAS.items():\n          next_r, next_c = current_r + dr, current_c + dc # Calculate the potential next cell's coordinates.\n          next_pos = (next_r, next_c)\n\n          # 1. Boundary Check: Ensure the new position is within the grid limits.\n          if not (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT):\n              continue # Skip this neighbor if it's out of bounds.\n          \n          # 2. Traversability Check: Determine if the agent can move onto `next_pos`.\n          # A cell is non-traversable if it contains any item whose ID is in the\n          # `env.world.non_grabbable_indices` set (e.g., walls, water, workshops).\n          is_traversable = True\n          for non_grabbable_kind_id in env.world.non_grabbable_indices:\n              if grid[next_r, next_c, non_grabbable_kind_id] == 1: \n                  is_traversable = False # This cell contains an obstacle.\n                  break # No need to check other non-grabbable types for this cell.\n          \n          if not is_traversable:\n              continue # Skip this neighbor if it's an obstacle.\n          \n          # 3. Visited Check: If this neighbor has not been visited yet, add it to the queue.\n          # This is key for BFS to guarantee the shortest path by processing layers level by level.\n          if next_pos not in visited_positions:\n              visited_positions.add(next_pos) # Mark the position as visited.\n              # Extend the path with the action taken to reach this `next_pos`.\n              new_path_so_far = path_so_far + [action_direction] \n              bfs_queue.append((next_pos, new_path_so_far)) # Add the new state to the queue.\n    \n  # --- Step 4: Construct the final sequence of actions to return ---\n  # If the BFS successfully found a path to a cell adjacent to the primitive:\n  if shortest_path_to_adj_cell is not None:\n      # First, append all the movement actions required to reach the target adjacent cell.\n      actions.extend(shortest_path_to_adj_cell)\n      \n      # Since we already verified that `primitive_id` is a grabbable item at the start\n      # of the function, we can now confidently append the 'USE' action to collect it.\n      actions.append(USE) \n  \n  return actions", "island_id": 0, "scores": {"3": 0.0}}
