 turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set includes the agent's inventory as part of the state key.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing.\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # V2 Improvement: Further increased MAX_EXPLORED_STATES for potentially deeper searches.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 100 # Increased from 50 to 100\n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check - First, check if the primitive is directly under the agent's feet.\n    # This applies to items that can be picked up by standing on them and using USE.\n    # V2 Improvement: Make this check more general, using `is_collectible_via_use`\n    # to include water and stone, which are collectible but not necessarily grabbable.\n    if state.grid[current_r, current_c, i_kind] == 1 and is_collectible_via_use:\n        inventory_before_use_on_self = np.copy(state.inventory)\n        _, state_after_use_on_self = state.step(USE_ACT)\n        # Verify successful collection\n        if state_after_use_on_self.inventory[i_kind] > inventory_before_use_on_self[i_kind]:\n            return path + [USE_ACT] # Collected by using at current position\n\n    # Goal Check: Check for primitive in adjacent cells (cardinal directions).\n    # This check relies on `state.next_to(i_kind)` which covers the 3x3 neighborhood.\n    # We then iterate through cardinal directions to find the specific cell and face it.\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Ensure facing cell is within grid bounds and contains the target primitive\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                temp_state_after_turns = state \n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action on the cell in front.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the USE action from the current position generally.\n    # This is important if using an item at the current position (e.g., picking up a tool,\n    # or interacting with a workshop) changes the inventory state, which might be necessary\n    # for later steps to collect the *target* primitive. This complements the specific\n    # goal checks above.\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if the USE action resulted in a meaningful state change (inventory, position, or direction).\n    # This prevents adding redundant states to the queue if USE had no effect.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T08:16:31.787069", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state # Get the current state of the environment.\n  \n  # Retrieve the integer ID for the target primitive from the cookbook's index.\n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  # Early exit: If the agent already possesses the primitive in its inventory, no actions are needed.\n  if current_state.inventory[primitive_id] > 0:\n      return []\n\n  # Extract relevant initial state information.\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's starting position (row, column tuple)\n  initial_dir = current_state.dir # Agent's starting direction (int: 0=RIGHT, 1=UP, 2=LEFT, 3=DOWN)\n\n  # Get grid dimensions.\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # Map action names to their corresponding integer indices for execution.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP'] # 'UP' in action_specs implies moving forward in current direction.\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define changes in (row, column) based on agent's current direction.\n  # This helps calculate the cell directly in front of the agent or the next position when moving.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: +1 to column (x-axis)\n      1: (-1, 0),  # Facing UP: -1 to row (y-axis)\n      2: (0, -1),  # Facing LEFT: -1 to column (x-axis)\n      3: (1, 0)    # Facing DOWN: +1 to row (y-axis)\n  }\n\n  # Define how the agent's direction changes when turning.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Define which entity kinds block agent movement into a cell.\n  # This includes all non-grabbable items (e.g., boundaries, water, workshops).\n  # Crucially, it also includes the 'primitive_id' itself if it's a collectible\n  # resource (e.g., WOOD, STONE, IRON), because the agent needs to be *adjacent*\n  # to such resources to 'USE' them, not standing directly on them.\n  # Workshops (WORKSHOP0, WORKSHOP1, WORKSHOP2) are also non-grabbable.\n  blocking_kinds_for_movement = set(current_state.world.non_grabbable_indices)\n  \n  # Add the target primitive itself to blocking kinds if it's not already there.\n  # This ensures the agent doesn't try to move onto a collectible resource.\n  if primitive_id not in blocking_kinds_for_movement:\n      blocking_kinds_for_movement.add(primitive_id)\n  \n  # Convert the set to a list for efficient indexing with NumPy arrays.\n  blocking_kinds_for_movement_list = list(blocking_kinds_for_movement)\n\n  # Initialize Breadth-First Search (BFS) data structures:\n  # queue: stores ( (agent_position_tuple, agent_direction_int), list_of_actions_taken_to_reach_this_state )\n  # visited: stores (agent_position_tuple, agent_direction_int) pairs to prevent redundant exploration and cycles.\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # This variable will hold the sequence of actions if a path to the primitive is found.\n\n  # Start the BFS loop to find the shortest path to a cell adjacent to the primitive.\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos # Extract current row and column.\n\n      # 1. Goal Check: Determine if the target primitive is directly in front of the agent.\n      # Calculate the coordinates of the cell that the agent is currently facing.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the 'front' cell is within the grid boundaries.\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          # If the cell directly in front contains the primitive we are looking for,\n          # we have found a path that leads the agent to be adjacent and facing the primitive.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path_actions = path_actions # Store this path.\n              break # Exit BFS, as we've found the shortest path to an actionable state.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n      \n      # --- Try Move Forward action ---\n      # Calculate the agent's new position if it moves one step forward.\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir_move = current_dir # Moving forward does not change the agent's facing direction.\n\n      # Check if the calculated next position is within the grid boundaries.\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT):\n          # Check if this specific (position, direction) state has been visited before.\n          if (next_pos, next_dir_move) not in visited:\n              # Check if the next position is walkable. A cell is considered non-walkable if it contains\n              # any of the blocking kinds (e.g., boundary, water, workshops, or the target primitive itself).\n              is_walkable = not np.any(initial_grid[next_r, next_c, blocking_kinds_for_movement_list] > 0)\n              \n              if is_walkable:\n                  visited.add((next_pos, next_dir_move)) # Mark this state as visited.\n                  # Add the new state to the queue, appending the MOVE_FORWARD_ACTION to the path.\n                  queue.append(((next_pos, next_dir_move), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # --- Try Turn Left action ---\n      # Calculate the new direction after turning left. The agent's position remains unchanged.\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Check if this (current_position, new_direction) state has been visited.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left)) # Mark as visited.\n          # Add the new state to the queue, appending the TURN_LEFT_ACTION to the path.\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # --- Try Turn Right action ---\n      # Calculate the new direction after turning right. The agent's position remains unchanged.\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Check if this (current_position, new_direction) state has been visited.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right)) # Mark as visited.\n          # Add the new state to the queue, appending the TURN_RIGHT_ACTION to the path.\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # After the BFS loop completes:\n  # If a path was found (i.e., target_path_actions is not None), append the final USE action.\n  # This 'USE' action will interact with the primitive that the agent is now facing.\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  # Return the sequence of actions. If no path was found, actions_list will be empty.\n  return actions_list", "island_id": 1, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T08:16:33.028598", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  \n  # Get the integer ID for the target primitive from the cookbook index.\n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  # Improvement for collect_v2: Early exit if the primitive is already in inventory.\n  # If the agent already possesses the desired primitive, no further actions are needed.\n  if current_state.inventory[primitive_id] > 0:\n      return []\n\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's starting position (row, column)\n  initial_dir = current_state.dir # Agent's starting direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # Get action mappings from the environment's action specifications.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP'] # 'UP' typically means moving forward relative to agent's direction.\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for changing row and column based on agent's facing direction.\n  # Used to calculate the cell directly in front or the next position when moving forward.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT (positive column change)\n      1: (-1, 0),  # Facing UP (negative row change)\n      2: (0, -1),  # Facing LEFT (negative column change)\n      3: (1, 0)    # Facing DOWN (positive row change)\n  }\n\n  # Maps for updating agent's direction after turning left or right.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Identify all entity kinds that inherently block movement (e.g., BOUNDARY, WATER, WORKSHOP_X).\n  # These are defined as \"non-grabbable\" in the CraftWorld configuration.\n  non_grabbable_kinds_set = current_state.world.non_grabbable_indices\n\n  # Define the complete set of entity kinds that block agent movement into a cell.\n  # This includes `non_grabbable_kinds_set` and the `primitive` itself if it's a collectible\n  # resource (e.g., WOOD, STONE), as the agent should stand *adjacent* to collect, not *on*.\n  # If the primitive is already a non-grabbable (like a workshop), adding it again has no effect.\n  # This ensures the agent finds a path to stand *next to* the primitive, not on it.\n  blocking_kinds_for_movement = set(non_grabbable_kinds_set)\n  if primitive_id not in blocking_kinds_for_movement:\n      blocking_kinds_for_movement.add(primitive_id)\n  \n  # Convert the set to a list for efficient NumPy array indexing during grid cell checks.\n  blocking_kinds_for_movement_list = list(blocking_kinds_for_movement)\n\n  # Initialize Breadth-First Search (BFS) structures:\n  # queue: stores ( (current_position_tuple, current_direction_int), list_of_actions_to_reach_here )\n  # visited: stores (position_tuple, direction_int) pairs to prevent redundant exploration and cycles.\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # This will store the sequence of actions if a path to the primitive is found.\n\n  # BFS loop to find the shortest path.\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos # Current row and column of the agent.\n\n      # 1. Goal Check: Determine if the target primitive is directly in front of the agent.\n      # Calculate the coordinates of the cell directly in front of the agent.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the front cell is within the grid boundaries.\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          # Check if the front cell contains the primitive we are looking for.\n          # We use `initial_grid` here because the BFS explores possible paths\n          # based on the static initial layout, not dynamic changes.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path_actions = path_actions # Path found! Store the actions.\n              break # Exit BFS, as we found the shortest path to an adjacent position.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n      \n      # Try Move Forward action:\n      # Calculate the next position if the agent moves forward.\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change the agent's facing direction.\n\n      # Check if the next position is within grid boundaries.\n      if not (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT):\n          continue # Skip this move, it's out of bounds.\n\n      # Check if this specific (position, direction) state has not been visited yet.\n      if (next_pos, next_dir) in visited:\n          continue # Skip, already visited this state via a shorter or equal path.\n          \n      # Check if the next position is walkable. A cell is not walkable if it contains any\n      # of the blocking kinds (e.g., boundary, water, workshop, or the primitive itself if collectible).\n      # np.any will return True if any of the specified kind indices have a count > 0 at that cell.\n      is_walkable = not np.any(initial_grid[next_r, next_c, blocking_kinds_for_movement_list] > 0)\n      \n      if is_walkable:\n          visited.add((next_pos, next_dir)) # Mark this state as visited.\n          # Add the new state to the queue with the updated path of actions.\n          queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left action:\n      # Calculate the new direction after turning left. Position remains unchanged.\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Check if this (current_position, new_direction) state has not been visited.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left)) # Mark as visited.\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right action:\n      # Calculate the new direction after turning right. Position remains unchanged.\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Check if this (current_position, new_direction) state has not been visited.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right)) # Mark as visited.\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # After BFS completes:\n  # If a path was found (i.e., target_path_actions is not None), append the final USE action.\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 1, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T08:17:17.881205", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos\n  initial_dir = current_state.dir # 0:Right, 1:Up, 2:Left, 3:Down\n\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # 1. Define Action Mappings from CraftLab's action_specs\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # In DMLab-style, 'UP' often means move forward\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # 2. Define Movement and Turning Constants based on agent's direction\n  # DIR_TO_DRDC: Maps current direction (0-3) to (delta_row, delta_column) for moving forward\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT (0), moving forward means (r, c+1)\n      1: (-1, 0),  # Facing UP (1), moving forward means (r-1, c)\n      2: (0, -1),  # Facing LEFT (2), moving forward means (r, c-1)\n      3: (1, 0)    # Facing DOWN (3), moving forward means (r+1, c)\n  }\n  # TURN_LEFT_MAP: Maps current direction to the new direction after turning left\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0} # Right -> Up -> Left -> Down -> Right\n  # TURN_RIGHT_MAP: Maps current direction to the new direction after turning right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # 3. Get Primitive ID and Check Grabbability\n  primitive_id = current_state.world.cookbook.index[primitive]\n  if primitive_id is None: \n      # If the primitive name is not found in the cookbook index, it cannot be collected.\n      return [] \n\n  if primitive_id not in current_state.world.grabbable_indices:\n      # If the item is not grabbable (e.g., water, boundary, workshops), it cannot be 'collected' by USE.\n      return [] \n\n  # Indices of entities that cannot be walked upon by the agent (e.g., water, boundaries, workshops)\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # Helper function to check if coordinates are within the grid bounds\n  def _is_valid_coord(r, c):\n      return 0 <= r < WIDTH and 0 <= c < HEIGHT\n\n  # Helper function to check if a cell is traversable/walkable by the agent.\n  # An agent cannot walk onto non-grabbable items or onto the item it intends to collect.\n  def _is_walkable_cell(pos):\n      r, c = pos\n      if not _is_valid_coord(r, c):\n          return False\n      \n      # Check if the cell contains any non-walkable entity (e.g., water, workshops, stone)\n      for kind_idx in non_walkable_kinds_indices:\n          if initial_grid[r, c, kind_idx] > 0:\n              return False\n      \n      # The agent cannot walk directly onto the primitive it's trying to collect; \n      # it must stop adjacent to it and use the 'USE' action.\n      if initial_grid[r, c, primitive_id] > 0:\n          return False\n          \n      return True\n\n  # Helper function to check if the agent is positioned and facing the target primitive\n  # such that a 'USE' action would collect it.\n  def _is_target_facing(pos, current_dir):\n      r, c = pos\n      # Calculate the coordinates of the cell directly in front of the agent\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n\n      if not _is_valid_coord(front_r, front_c):\n          return False # Cell in front is out of bounds\n      \n      # Check if the cell directly in front of the agent contains the target primitive\n      return initial_grid[front_r, front_c, primitive_id] > 0\n\n  # Breadth-First Search (BFS) to find the shortest path to a state\n  # where the primitive can be collected (i.e., agent is adjacent and facing it).\n  def _bfs_find_path():\n      # BFS state is defined by ((row, col), direction)\n      # Queue stores: ( (current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_here )\n      queue = collections.deque([((initial_pos, initial_dir), [])])\n      # Visited set stores (position_tuple, direction_int) to prevent redundant exploration and cycles.\n      visited = {(initial_pos, initial_dir)}\n\n      while queue:\n          (current_pos, current_dir), path_actions = queue.popleft()\n          \n          # Check if the current state (position and direction) allows for immediate collection\n          if _is_target_facing(current_pos, current_dir):\n              return path_actions # Found the shortest sequence of actions to reach a \"ready-to-use\" state\n\n          # Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right\n          \n          # 1. Attempt to Move Forward\n          move_dr, move_dc = DIR_TO_DRDC[current_dir]\n          next_r, next_c = current_pos[0] + move_dr, current_pos[1] + move_dc\n          next_pos_move = (next_r, next_c)\n          next_dir_move = current_dir # Direction does not change when moving\n\n          # Check if the new position is walkable and this state hasn't been visited\n          if _is_walkable_cell(next_pos_move):\n              new_state = (next_pos_move, next_dir_move)\n              if new_state not in visited:\n                  visited.add(new_state)\n                  new_path = path_actions + [MOVE_FORWARD_ACTION]\n                  queue.append((new_state, new_path))\n\n          # 2. Attempt to Turn Left\n          next_dir_left = TURN_LEFT_MAP[current_dir]\n          new_state_left = (current_pos, next_dir_left) # Position remains the same, only direction changes\n          if new_state_left not in visited:\n              visited.add(new_state_left)\n              new_path_left = path_actions + [TURN_LEFT_ACTION]\n              queue.append((new_state_left, new_path_left))\n\n          # 3. Attempt to Turn Right\n          next_dir_right = TURN_RIGHT_MAP[current_dir]\n          new_state_right = (current_pos, next_dir_right) # Position remains the same, only direction changes\n          if new_state_right not in visited:\n              visited.add(new_state_right)\n              new_path_right = path_actions + [TURN_RIGHT_ACTION]\n              queue.append((new_state_right, new_path_right))\n      \n      return None # No path found to reach a state where the primitive can be collected\n\n  # --- Main logic for `collect_v2` ---\n  target_movement_actions = None\n\n  # First, check if the agent is already in the correct state to collect the primitive\n  # (i.e., adjacent to and facing the primitive)\n  if _is_target_facing(initial_pos, initial_dir):\n      target_movement_actions = [] # No prior movement actions are needed\n\n  # If not already in position, perform BFS to find the shortest path to such a state\n  if target_movement_actions is None:\n      target_movement_actions = _bfs_find_path()\n\n  # If a path was successfully found (or it was an immediate goal),\n  # append the final USE action to the sequence.\n  if target_movement_actions is not None:\n      actions_list.extend(target_movement_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T08:17:19.002711", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos\n  initial_dir = current_state.dir # 0:R, 1:U, 2:L, 3:D\n\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # 1. Define Action Mappings\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP'] # DMLab's \"UP\" usually means move forward\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # 2. Define Movement Constants for 4-directional grid movement\n  # (dr, dc) delta row, delta column for each direction (0:R, 1:U, 2:L, 3:D)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT (positive column)\n      1: (-1, 0),  # Facing UP (negative row)\n      2: (0, -1),  # Facing LEFT (negative column)\n      3: (1, 0)    # Facing DOWN (positive row)\n  }\n  # Map for turning left (e.g., if facing RIGHT (0), turn to face UP (1))\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0} # R -> U -> L -> D -> R\n  # Map for turning right (e.g., if facing RIGHT (0), turn to face DOWN (3))\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # R -> D -> L -> U -> R\n\n  # 3. Get Primitive ID and Check Grabbability\n  primitive_id = current_state.world.cookbook.index.get(primitive) # Use .get() for safety\n  if primitive_id is None:\n      # Primitive name not found in the cookbook index\n      return []\n\n  if primitive_id not in current_state.world.grabbable_indices:\n      # If the item is not grabbable (e.g., water, boundary, workshops), it cannot be 'collected'\n      # via USE action. It can only be walked next to or observed.\n      return []\n\n  # Indices of entities that cannot be walked upon by the agent (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # Helper function to check if coordinates are within grid bounds\n  def _is_valid_coord(r, c):\n      return 0 <= r < WIDTH and 0 <= c < HEIGHT\n\n  # Helper function to check if a cell is traversable by the agent\n  def _is_walkable_cell(pos):\n      r, c = pos\n      if not _is_valid_coord(r, c):\n          return False\n      \n      # A cell is not walkable if it contains any non-grabbable entity (like water, boundary, workshops, stone)\n      # or if it contains the primitive itself (agent cannot walk *onto* the primitive it collects, only adjacent to it).\n      for kind_idx in non_walkable_kinds_indices:\n          if initial_grid[r, c, kind_idx] > 0:\n              return False\n      \n      # Agent cannot walk directly onto the primitive it's trying to collect; it must stop adjacent to it.\n      if initial_grid[r, c, primitive_id] > 0:\n          return False\n          \n      return True\n\n  # Helper function to check if the agent is positioned and facing the target primitive\n  # such that a 'USE' action would collect it.\n  def _is_target_facing(pos, current_dir):\n      r, c = pos\n      # Calculate the coordinates of the cell directly in front of the agent\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n\n      if not _is_valid_coord(front_r, front_c):\n          return False # Cell in front is out of bounds\n      \n      # Check if the cell directly in front of the agent contains the target primitive\n      return initial_grid[front_r, front_c, primitive_id] > 0\n\n  # Breadth-First Search (BFS) to find the shortest path to a state\n  # where the primitive can be collected (i.e., agent is adjacent and facing it).\n  def _bfs_find_path():\n      # BFS state: ((row, col), direction)\n      # Queue stores ( (current_position_tuple, current_direction_int), list_of_actions_to_reach_here )\n      queue = collections.deque([((initial_pos, initial_dir), [])])\n      # Visited set stores (position_tuple, direction_int) to prevent redundant exploration and cycles.\n      visited = {(initial_pos, initial_dir)}\n\n      while queue:\n          (current_pos, current_dir), path_actions = queue.popleft()\n          \n          # Check if the current state (position and direction) makes the primitive targetable\n          if _is_target_facing(current_pos, current_dir):\n              return path_actions # Found the shortest sequence of actions to reach a \"ready-to-use\" state\n\n          # Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right\n          \n          # 1. Attempt to Move Forward\n          move_dr, move_dc = DIR_TO_DRDC[current_dir]\n          next_r, next_c = current_pos[0] + move_dr, current_pos[1] + move_dc\n          next_pos_move = (next_r, next_c)\n          next_dir_move = current_dir # Direction does not change when moving\n\n          new_state_move = (next_pos_move, next_dir_move)\n          if _is_walkable_cell(next_pos_move) and new_state_move not in visited:\n              visited.add(new_state_move)\n              new_path = path_actions + [MOVE_FORWARD_ACTION]\n              queue.append((new_state_move, new_path))\n\n          # 2. Attempt to Turn Left\n          next_dir_left = TURN_LEFT_MAP[current_dir]\n          new_state_left = (current_pos, next_dir_left) # Position remains the same, only direction changes\n          if new_state_left not in visited:\n              visited.add(new_state_left)\n              new_path_left = path_actions + [TURN_LEFT_ACTION]\n              queue.append((new_state_left, new_path_left))\n\n          # 3. Attempt to Turn Right\n          next_dir_right = TURN_RIGHT_MAP[current_dir]\n          new_state_right = (current_pos, next_dir_right) # Position remains the same, only direction changes\n          if new_state_right not in visited:\n              visited.add(new_state_right)\n              new_path_right = path_actions + [TURN_RIGHT_ACTION]\n              queue.append((new_state_right, new_path_right))\n      \n      return None # No path found to reach a state where the primitive can be collected\n\n  # --- Main logic for `collect` function ---\n  target_movement_actions = None\n\n  # First, check if the agent is already in a state to collect the primitive (adjacent and facing)\n  if _is_target_facing(initial_pos, initial_dir):\n      target_movement_actions = [] # No prior movement actions are needed\n\n  # If not already in position, perform BFS to find the shortest path\n  if target_movement_actions is None:\n      target_movement_actions = _bfs_find_path()\n\n  # If a path was successfully found (or it was an immediate goal), append the final USE action\n  if target_movement_actions is not None:\n      actions_list.extend(target_movement_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-08-01T08:17:59.083876", "function_name": "collect", "function_body": "  actions = []\n  \n  current_state = env._current_state \n  grid = current_state.grid\n  current_pos = current_state.pos\n  \n  # Get the integer ID of the primitive from the cookbook index\n  primitive_id = env.world.cookbook.index[primitive]\n\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Retrieve action mapping from the environment for robustness\n  _action_specs = env.action_specs()\n  DOWN = _action_specs['DOWN']\n  UP = _action_specs['UP']\n  LEFT = _action_specs['LEFT']\n  RIGHT = _action_specs['RIGHT']\n  USE = _action_specs['USE']\n\n  # Define movement deltas for convenience for the 4 cardinal directions\n  DELTAS = {\n      UP: (-1, 0),\n      DOWN: (1, 0),\n      LEFT: (0, -1),\n      RIGHT: (0, 1)\n  }\n\n  # 1. Immediate collection check: If the agent is already next to the primitive\n  # (within its 3x3 neighborhood) and the primitive is grabbable,\n  # a single 'USE' action is sufficient to collect it without moving.\n  if current_state.next_to(primitive_id) and primitive_id in current_state.world.grabbable_indices:\n      actions.append(USE)\n      return actions\n\n  # 2. Find all locations of the target primitive on the grid using numpy.where\n  row_indices, col_indices = np.where(grid[:, :, primitive_id] == 1)\n  primitive_locations = list(zip(row_indices, col_indices))\n\n  # If the primitive is not found anywhere on the grid, it cannot be collected.\n  if not primitive_locations:\n      return []\n\n  # 3. Perform Breadth-First Search (BFS) to find the shortest path\n  #    to a cell cardinally adjacent to any primitive location.\n  # The queue stores tuples: ((current_row, current_col), [list_of_actions_to_reach_here]).\n  q = collections.deque([(current_pos, [])]) \n  # The visited set keeps track of positions already explored to avoid cycles.\n  visited = {current_pos} \n\n  # This variable will store the path found to an adjacent cell once it's discovered.\n  target_adj_pos_path = None \n\n  while q:\n      (r, c), path = q.popleft()\n\n      # Check if the current position (r, c) is cardinally adjacent to any of the primitive locations.\n      # From such a position, the 'USE' action can be applied.\n      for pr, pc in primitive_locations:\n          if abs(r - pr) + abs(c - pc) == 1: \n              target_adj_pos_path = path # Found the shortest path to an adjacent cell.\n              break # Break from this inner loop.\n      \n      if target_adj_pos_path is not None:\n          break # Exit the BFS loop once the shortest path has been found.\n\n      # Explore valid neighbors (UP, DOWN, LEFT, RIGHT).\n      for action_dir, (dr, dc) in DELTAS.items():\n          nr, nc = r + dr, c + dc # Calculate the new potential position.\n          next_pos = (nr, nc)\n\n          # Check bounds: Ensure the new position is within the grid boundaries.\n          if not (0 <= nr < WIDTH and 0 <= nc < HEIGHT):\n              continue\n          \n          # Check traversability:\n          # A cell is considered non-traversable if it contains any item\n          # whose kind index is in the world's `non_grabbable_indices` set\n          # (e.g., 'BOUNDARY', 'WATER', 'WORKSHOP' structures).\n          is_traversable = True\n          for i_kind in env.world.non_grabbable_indices:\n              if grid[nr, nc, i_kind] == 1: \n                  is_traversable = False\n                  break \n          \n          if not is_traversable:\n              continue \n          \n          # If the neighbor has not been visited, add it to the queue.\n          if next_pos not in visited:\n              visited.add(next_pos) \n              new_path = path + [action_dir] \n              q.append((next_pos, new_path))\n    \n  # 4. If a path to an adjacent cell was found, extend the actions list with this path.\n  #    Then, append a 'USE' action only if the primitive is a grabbable item\n  #    (i.e., it can be added to the inventory upon 'USE').\n  if target_adj_pos_path is not None:\n      actions.extend(target_adj_pos_path)\n      if primitive_id in current_state.world.grabbable_indices:\n          actions.append(USE) \n  \n  return actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T08:18:00.317129", "function_name": "collect", "function_body": "  actions = []\n  \n  current_state = env._current_state \n  grid = current_state.grid\n  current_pos = current_state.pos\n  \n  primitive_id = env.world.cookbook.index[primitive]\n\n  WIDTH, HEIGHT, _ = grid.shape\n\n  _action_specs = env.action_specs()\n  DOWN = _action_specs['DOWN']\n  UP = _action_specs['UP']\n  LEFT = _action_specs['LEFT']\n  RIGHT = _action_specs['RIGHT']\n  USE = _action_specs['USE']\n\n  DELTAS = {\n      UP: (-1, 0),\n      DOWN: (1, 0),\n      LEFT: (0, -1),\n      RIGHT: (0, 1)\n  }\n\n  # 1. Find all locations of the target primitive on the grid using numpy.where\n  row_indices, col_indices = np.where(grid[:, :, primitive_id] == 1)\n  primitive_locations = list(zip(row_indices, col_indices))\n\n  if not primitive_locations:\n      return [] # Primitive not found anywhere\n\n  # 2. Perform Breadth-First Search (BFS) to find the shortest path\n  #    to a cell cardinally adjacent to any primitive location.\n  # The queue stores tuples: ((current_row, current_col), [list_of_actions_to_reach_here]).\n  q = collections.deque([(current_pos, [])]) \n  # The visited set keeps track of positions already explored to avoid cycles and redundant paths.\n  visited = {current_pos} \n\n  # This variable will store the path found to an adjacent cell once it's discovered.\n  target_adj_pos_path = None \n\n  while q:\n      (r, c), path = q.popleft()\n\n      # Check if the current position (r, c) is cardinally adjacent to any of the primitive locations.\n      # Being \"adjacent\" means a Manhattan distance of 1 (horizontally or vertically).\n      # If the agent starts already adjacent, 'path' will be empty and this condition will be met.\n      for pr, pc in primitive_locations:\n          if abs(r - pr) + abs(c - pc) == 1: \n              target_adj_pos_path = path # Found the shortest path to an adjacent cell.\n              break # Break from this inner loop as we've found our target path.\n      \n      if target_adj_pos_path is not None:\n          break # Exit the BFS loop once the shortest path to an adjacent cell has been found.\n\n      # Explore valid neighbors (UP, DOWN, LEFT, RIGHT).\n      for action_dir, (dr, dc) in DELTAS.items():\n          nr, nc = r + dr, c + dc # Calculate the new potential position.\n          next_pos = (nr, nc)\n\n          # Check bounds: Ensure the new position is within the grid boundaries.\n          if not (0 <= nr < WIDTH and 0 <= nc < HEIGHT):\n              continue\n          \n          # Check traversability:\n          # A cell is considered non-traversable if it contains any item\n          # whose kind index is in the world's `non_grabbable_indices` set.\n          # These are obstacles like 'BOUNDARY', 'WATER', or 'WORKSHOP' structures.\n          is_traversable = True\n          for i_kind in current_state.world.non_grabbable_indices:\n              if grid[nr, nc, i_kind] == 1: # If this cell contains a non-grabbable item.\n                  is_traversable = False\n                  break # This neighbor is an obstacle, so stop checking and mark as not traversable.\n          \n          if not is_traversable:\n              continue # Skip this neighbor if it's an obstacle.\n          \n          # If the neighbor has not been visited, add it to the queue to explore later.\n          if next_pos not in visited:\n              visited.add(next_pos) # Mark as visited.\n              new_path = path + [action_dir] # Extend the current path with the action taken.\n              q.append((next_pos, new_path)) # Add the new state to the queue.\n    \n  # 3. If a path to an adjacent cell was found during BFS,\n  #    extend the actions list with this path and then append a 'USE' action.\n  #    The 'USE' action will interact with the primitive. This is appropriate\n  #    whether the primitive is a grabbable item (e.g., WOOD, IRON) or a\n  #    non-grabbable interaction point (e.g., WORKSHOP, WATER, STONE).\n  if target_adj_pos_path is not None:\n      actions.extend(target_adj_pos_path)\n      actions.append(USE) # Always append USE for interaction\n  \n  return actions", "island_id": 0, "scores": {"3": 0.0}}
