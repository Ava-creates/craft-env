 turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set includes the agent's inventory as part of the state key\n  # to distinguish between states identical in position/direction but differing in inventory.\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Increased MAX_EXPLORED_STATES due to the larger state space when tracking inventory.\n  # Use min(n_kinds, 10) as a heuristic multiplier for inventory states to cap complexity\n  # while still allowing some inventory variation.\n  MAX_EXPLORED_INVENTORY_STATES_MULTIPLIER = min(world.cookbook.n_kinds, 10) \n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * MAX_EXPLORED_INVENTORY_STATES_MULTIPLIER \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent excessive computation.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # --- CONSOLIDATED IMMEDIATE COLLECTION ATTEMPT ---\n    # This section aims to find the primitive and collect it as soon as possible\n    # from the *current* `state`, either by using it at the agent's position\n    # or by turning and using it on an adjacent cell.\n\n    # 1. Attempt collection by using at the current position (covers grabbable items on the same cell).\n    inventory_before_general_use = np.copy(state.inventory) # Snapshot inventory before this potential USE\n    _, state_after_general_use = state.step(USE_ACT) # Simulate USE action\n\n    if state_after_general_use.inventory[i_kind] > inventory_before_general_use[i_kind]:\n        return path + [USE_ACT] # Primitive collected! Return this path immediately.\n\n    # 2. Attempt collection from an adjacent cell by turning to face it and using.\n    # We iterate through all 4 cardinal directions relative to the agent.\n    for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n        dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n        facing_r, facing_c = current_r + dr, current_c + dc\n\n        # Check if the cell we would face is within grid bounds AND contains the primitive.\n        if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n            state.grid[facing_r, facing_c, i_kind] == 1):\n            \n            # Get the actions needed to turn from current_dir to target_dir.\n            turns_to_face = _get_turning_actions(current_dir, target_dir)\n            temp_state_after_turns = state # Start simulation from the current 'state'\n\n            # Apply each turn action to simulate the state after turning.\n            for turn_action in turns_to_face:\n                _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n            \n            # Snapshot inventory *after* turns, before the final USE attempt.\n            inventory_before_facing_use = np.copy(temp_state_after_turns.inventory)\n\n            # Simulate the 'USE' action in the new facing direction.\n            _, state_after_facing_use = temp_state_after_turns.step(USE_ACT)\n\n            # Critical check: Did the count of the primitive in inventory actually increase?\n            if state_after_facing_use.inventory[i_kind] > inventory_before_facing_use[i_kind]:\n                return path + turns_to_face + [USE_ACT] # Primitive collected!\n\n    # --- EXPLORE NEXT STATES (Movement and General USE for tools/intermediate steps) ---\n    # If the primitive wasn't collected immediately from the 'state', explore future possibilities.\n\n    # Explore possible movement actions (UP, DOWN, LEFT, RIGHT).\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Also explore the state resulting from the general 'USE' action that was attempted at the start\n    # of this BFS iteration (`state_after_general_use`).\n    # This is important if 'USE' didn't collect the target primitive *directly*, but changed the state\n    # in a way that enables *future* collection (e.g., picking up a tool, or clearing an obstacle).\n    \n    # Only add this state if it's truly new (not already visited) and it's meaningfully different\n    # from the 'state' it originated from (i.e., something actually happened from the USE action).\n    if not (np.array_equal(state_after_general_use.inventory, inventory_before_general_use) and\n            state_after_general_use.pos == state.pos and\n            state_after_general_use.dir == state.dir):\n        \n        next_inventory_tuple = tuple(state_after_general_use.inventory)\n        next_state_key = (state_after_general_use.pos[0], state_after_general_use.pos[1], state_after_general_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_general_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T13:42:30.729371", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    # This acts as an early exit for invalid primitive names.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it, as it's already obtained.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # Collectible items include grabbable items (e.g., wood, iron), and specific environment features\n  # like 'water' or 'stone' that might be gathered directly.\n  # Items like workshops, boundaries, or bridges are typically fixed elements and not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not intended to be collected via 'USE', we prune the search early.\n  # This prevents the BFS from attempting to collect uncollectible entities.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference that wraps correctly.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set now includes the agent's inventory as part of the state key.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing, allowing BFS to distinguish\n  # between states that are identical in position/direction but differ in inventory.\n  # This is crucial for problems where collecting one item (e.g., a tool) enables collecting another.\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, [])) # (current_state_object, path_taken_to_reach_this_state)\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Maximum number of unique states to explore. This limit prevents excessive computation\n  # for very large or complex environments where a path might not exist or is too long.\n  # The factor '10' for inventory captures common scenarios where inventory changes enable new paths,\n  # but prevents unbounded exploration in more complex crafting trees.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    # This helps cap the search time for intractable or non-existent paths.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`) in the agent's vicinity.\n    if state.next_to(i_kind):\n        # Iterate through all four cardinal directions to identify if the primitive is directly faceable.\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell directly in front is within grid bounds and contains the primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions required to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    # Apply each turn action to simulate the new state after turning.\n                    # Reward is ignored as we are only tracking state changes for pathfinding.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify successful collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical success condition: Did the count of the target primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed, resource depletion) implemented within `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT] # Path found!\n\n    # Explore possible movement actions (UP, DOWN, LEFT, RIGHT):\n    for action in move_actions:\n      _, next_state = state.step(action)\n      # Create a hashable key for the next state, including position, direction, and inventory.\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      # If this state has not been visited before, add it to the queue and visited set.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the USE action from the current position.\n    # This is important even if not directly facing the target primitive, as using an item\n    # at the current spot (e.g., picking up a tool like an axe from the ground, or activating a workbench)\n    # can change the inventory state, which might be necessary for later steps to collect the target primitive (e.g., wood).\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if the USE action resulted in a meaningful state change (inventory, position, or direction).\n    # This prevents adding redundant states to the queue if the USE action had no effect.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions\n  # and the defined action set within the exploration limits.\n  return []", "island_id": 4, "scores": {"3": 1.5}}
