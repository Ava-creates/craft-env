 turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set includes the agent's inventory as part of the state key,\n  # allowing the algorithm to distinguish states that are identical in position/direction\n  # but differ in inventory (e.g., having a tool vs. not).\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Increased MAX_EXPLORED_STATES to account for the larger state space when tracking inventory\n  # and the more comprehensive 'USE' action exploration.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 30 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the target primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`) in the 3x3 neighborhood.\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions required to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify successful collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical verification: Did the count of the target primitive in inventory actually increase?\n                # This confirms successful collection, accounting for any internal game rules\n                # (e.g., requiring tools) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # IMPROVEMENT for v2: More comprehensive 'USE' action exploration.\n    # Instead of only trying 'USE' in the current direction, check all 8 adjacent cells\n    # and simulate turning to face them before using, if something 'useable' is found.\n    for r_offset in [-1, 0, 1]:\n        for c_offset in [-1, 0, 1]:\n            # Skip current position (0,0) as agent typically interacts with adjacent cells.\n            if r_offset == 0 and c_offset == 0:\n                continue \n\n            # Calculate the coordinates of the adjacent cell to potentially interact with.\n            target_r, target_c = current_r + r_offset, current_c + c_offset\n\n            # Check if the target cell is within grid boundaries.\n            if not (0 <= target_r < grid_width and 0 <= target_c < grid_height):\n                continue\n\n            # Determine if there's any item in this adjacent cell that is \"useable\".\n            # This includes grabbable items (like tools), water, or stone.\n            is_something_useable_at_target = False\n            for k_idx in world.grabbable_indices:\n                if state.grid[target_r, target_c, k_idx] == 1:\n                    is_something_useable_at_target = True\n                    break\n            if not is_something_useable_at_target:\n                if (state.grid[target_r, target_c, world.water_index] == 1 or\n                    state.grid[target_r, target_c, world.stone_index] == 1):\n                    is_something_useable_at_target = True\n            \n            # If nothing useable is found at this adjacent cell, skip to the next one.\n            if not is_something_useable_at_target:\n                continue \n\n            # If something useable is found, figure out which direction the agent needs to face to interact with it.\n            # Then simulate the turns and the USE action.\n            \n            # Iterate through all 4 possible directions the agent could be facing.\n            # Find the direction that puts (target_r, target_c) directly in front of the agent.\n            for dir_to_face in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n                dr_face, dc_face = _DIR_TO_DELTA_FRONT[dir_to_face]\n                # If current_pos + delta for this direction matches target_pos, then this is the direction to face.\n                if (current_r + dr_face == target_r and current_c + dc_face == target_c):\n                    \n                    # Calculate and simulate the turning actions from the current_dir to dir_to_face.\n                    turns_to_face_target = _get_turning_actions(current_dir, dir_to_face)\n                    temp_state_after_turns = state # Start from the current state for this simulation branch\n                    for turn_action in turns_to_face_target:\n                        _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n                    \n                    # Store inventory before 'USE' to check for changes afterwards.\n                    inventory_before_use = np.copy(temp_state_after_turns.inventory)\n                    # Simulate the 'USE' action from the state where agent is facing the target.\n                    _, state_after_current_use = temp_state_after_turns.step(USE_ACT)\n\n                    # Add this new state to the queue only if the 'USE' action resulted in a meaningful change.\n                    # A meaningful change implies inventory modification, or less commonly, agent movement/direction change.\n                    if not (np.array_equal(state_after_current_use.inventory, inventory_before_use) and\n                            state_after_current_use.pos == temp_state_after_turns.pos and \n                            state_after_current_use.dir == temp_state_after_turns.dir):\n                        \n                        next_inventory_tuple = tuple(state_after_current_use.inventory)\n                        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n                        if next_state_key not in visited:\n                            visited.add(next_state_key)\n                            # The path for this new state includes the original path + turns + USE action.\n                            q.append((state_after_current_use, path + turns_to_face_target + [USE_ACT]))\n                    \n                    # After processing this direction for the current target cell, break and move to the next adjacent cell.\n                    break \n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T11:30:20.896989", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Semantic check: Determine if this primitive is *actually* collectible into inventory.\n  # This filters out non-grabbable environment features (like workshops, boundaries, non-resource items)\n  # unless they are explicitly water or stone (which are environment but can be collected).\n  is_primitive_resource = i_kind in world.cookbook.primitives\n  is_special_collectible_environment = (i_kind == world.water_index or i_kind == world.stone_index)\n  is_grabbable = i_kind in world.grabbable_indices # Items that can be picked up directly (e.g., tools, crafted items)\n\n  # If it's not a primitive resource, not water/stone, and not grabbable, it's likely not meant to be \"collected\" into inventory.\n  # This prevents trying to collect things like 'workshop0' or 'boundary'.\n  if not (is_primitive_resource or is_special_collectible_environment or is_grabbable):\n      return []\n\n  # 3. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n\n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n\n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set includes the agent's inventory as part of the state key,\n  # as inventory changes affect future actions and goals.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing.\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Set a heuristic upper bound for explored states to prevent excessively long searches\n  # in complex scenarios. This value can be tuned.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 150 # Slightly increased from v1's 100\n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n\n    # --- Immediate Goal Check 1: Check for collection by using USE_ACT at the current position. ---\n    # This covers picking up items the agent is standing on (e.g., grabbable items on the ground).\n    inventory_before_use_at_pos = np.copy(state.inventory)\n    _, state_after_use_at_pos = state.step(USE_ACT)\n    if state_after_use_at_pos.inventory[i_kind] > inventory_before_use_at_pos[i_kind]:\n        return path + [USE_ACT] # Found a path by using at the current position\n\n    # --- Immediate Goal Check 2: Check for collection by turning and then using USE_ACT on an adjacent cell. ---\n    # This covers interacting with resources like wood, stone, water, or objects like workshops.\n    for target_dir in range(4): # Iterate through possible facing directions: 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n        dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n        facing_r, facing_c = current_r + dr, current_c + dc\n\n        # Ensure facing cell is within grid bounds.\n        if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height):\n            # Check if there's *any* item or entity at the facing cell that could be interacted with.\n            # We don't check for 'i_kind' specifically here, as `USE` might transform other items into 'i_kind'.\n            if np.any(state.grid[facing_r, facing_c, :] == 1):\n                # Simulate the turning actions required to face the potential source.\n                temp_state_after_turns = state # Start from the current state for simulation\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use_after_turn = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action on the cell in front.\n                _, state_after_use_after_turn = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the *target primitive* in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed, resource depletion) implemented in `CraftState.step`.\n                if state_after_use_after_turn.inventory[i_kind] > inventory_before_use_after_turn[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # --- Explore successor states by movement actions. ---\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory) # Inventory is part of the state for visited check\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # --- Explore successor state by using USE_ACT at the current position if it leads to a new and meaningful state. ---\n    # This is important if USE_ACT might acquire a tool, change the environment, or enable future collection,\n    # even if it doesn't directly yield the target primitive in this step.\n    # `state_after_use_at_pos` was already computed earlier.\n    state_changed_by_use_at_pos = not (\n        np.array_equal(state_after_use_at_pos.inventory, inventory_before_use_at_pos) and\n        state_after_use_at_pos.pos == state.pos and\n        state_after_use_at_pos.dir == state.dir\n    )\n    next_inventory_tuple_after_use_at_pos = tuple(state_after_use_at_pos.inventory)\n    next_state_key_after_use_at_pos = (state_after_use_at_pos.pos[0], state_after_use_at_pos.pos[1], state_after_use_at_pos.dir, next_inventory_tuple_after_use_at_pos)\n\n    if state_changed_by_use_at_pos and next_state_key_after_use_at_pos not in visited:\n        visited.add(next_state_key_after_use_at_pos)\n        q.append((state_after_use_at_pos, path + [USE_ACT]))\n    \n    # --- Explore successor states by using USE_ACT after turning to an adjacent cell, if it leads to a new and meaningful state. ---\n    # This covers general interaction with adjacent objects that modify the state, even if not directly yielding the goal primitive.\n    for target_dir in range(4):\n        dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n        facing_r, facing_c = current_r + dr, current_c + dc\n\n        if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height):\n            # Only consider using if there is something interactable in front.\n            if np.any(state.grid[facing_r, facing_c, :] == 1):\n                temp_state_after_turns = state\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                inventory_before_use_after_turn = np.copy(temp_state_after_turns.inventory)\n                _, state_after_use_after_turn = temp_state_after_turns.step(USE_ACT)\n\n                state_changed_by_use_after_turn = not (\n                    np.array_equal(state_after_use_after_turn.inventory, inventory_before_use_after_turn) and\n                    state_after_use_after_turn.pos == temp_state_after_turns.pos and\n                    state_after_use_after_turn.dir == temp_state_after_turns.dir\n                )\n                \n                next_inventory_tuple_after_use_after_turn = tuple(state_after_use_after_turn.inventory)\n                next_state_key_after_use_after_turn = (state_after_use_after_turn.pos[0], state_after_use_after_turn.pos[1], state_after_use_after_turn.dir, next_inventory_tuple_after_use_after_turn)\n\n                # Add to queue if state changed and it's a new state (not already visited).\n                if state_changed_by_use_after_turn and next_state_key_after_use_after_turn not in visited:\n                    visited.add(next_state_key_after_use_after_turn)\n                    q.append((state_after_use_after_turn, path + turns_to_face + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 6, "scores": {"3": 2.0}}
{"timestamp": "2025-08-01T11:30:28.530021", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic checks for collectibility.\n  # First, ensure the target is actually defined as a primitive in the cookbook.\n  # If it's not a primitive, this function should not attempt to collect it.\n  if i_kind not in world.cookbook.primitives:\n      return []\n\n  # Second, determine if this primitive is generally collectible via the 'USE' action\n  # in the CraftWorld environment. This heuristic prevents searching for ways to 'collect'\n  # non-grabbable environment features (like boundaries, or workshops which are not picked up).\n  # CraftWorld's 'USE' action typically covers picking up grabbable items or interacting\n  # with specific resource blocks like water or stone.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or\n      i_kind == world.water_index or\n      i_kind == world.stone_index\n  )\n  # Note: The DSL lists WORKSHOPx as primitives. However, CraftWorld's `workshop_indices`\n  # are typically `non_grabbable_indices`. If `i_kind` is a workshop, `is_collectible_via_use`\n  # will be False, and this function will correctly return an empty path, as workshops\n  # cannot be \"collected\" into inventory via the standard 'USE' action.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n\n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n\n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set includes the agent's inventory, position, and direction as part of the state key.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing.\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Heuristic upper bound for explored states to prevent excessively long searches.\n  # This considers grid cells * directions * a factor for diverse inventory states.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 100\n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n\n    # Immediate Goal Check 1: Check if the primitive can be collected by using the USE_ACT\n    # at the current agent's position. This covers picking up items the agent is standing on.\n    inventory_before_use_at_pos = np.copy(state.inventory)\n    _, state_after_use_at_pos = state.step(USE_ACT)\n    if state_after_use_at_pos.inventory[i_kind] > inventory_before_use_at_pos[i_kind]:\n        return path + [USE_ACT] # Found a path by using at the current position\n\n    # Immediate Goal Check 2: Check if the primitive can be collected by turning\n    # and then using USE_ACT on an adjacent cell.\n    for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n        dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n        facing_r, facing_c = current_r + dr, current_c + dc\n\n        # Ensure facing cell is within grid bounds.\n        if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height):\n            # If there's any item (represented by a 1 in any channel) in front, it's potentially interactable.\n            # This is a broad check; the `state.step` handles specific interaction logic.\n            if np.any(state.grid[facing_r, facing_c, :] == 1):\n                # Simulate the turning actions required to face the potential source.\n                temp_state_after_turns = state\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use_after_turn = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action on the cell in front.\n                _, state_after_use_after_turn = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the *target primitive* in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules (e.g., tools needed).\n                if state_after_use_after_turn.inventory[i_kind] > inventory_before_use_after_turn[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n\n    # Explore the USE action from the current position if it leads to a new and meaningful state.\n    # This covers cases where USE_ACT might acquire a tool or change the environment in a useful way,\n    # even if it doesn't directly yield the target primitive.\n    # `state_after_use_at_pos` was already computed above in Goal Check 1.\n    next_inventory_tuple_after_use_at_pos = tuple(state_after_use_at_pos.inventory)\n    next_state_key_after_use_at_pos = (state_after_use_at_pos.pos[0], state_after_use_at_pos.pos[1], state_after_use_at_pos.dir, next_inventory_tuple_after_use_at_pos)\n\n    # Check if the USE action at the current position actually changed the state (pos, dir, or inventory)\n    # compared to the `state` from which it was executed.\n    state_changed_by_use_at_pos = not (\n        np.array_equal(state_after_use_at_pos.inventory, inventory_before_use_at_pos) and\n        state_after_use_at_pos.pos == state.pos and\n        state_after_use_at_pos.dir == state.dir\n    )\n\n    if state_changed_by_use_at_pos and next_state_key_after_use_at_pos not in visited:\n        visited.add(next_state_key_after_use_at_pos)\n        q.append((state_after_use_at_pos, path + [USE_ACT]))\n\n    # Explore USE actions after turning if they yield a non-goal-primitive but useful state change.\n    for target_dir in range(4):\n        dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n        facing_r, facing_c = current_r + dr, current_c + dc\n\n        if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height):\n            # If there's any item (represented by a 1) in front that could be interacted with.\n            if np.any(state.grid[facing_r, facing_c, :] == 1):\n                temp_state_after_turns = state\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                inventory_before_use_after_turn = np.copy(temp_state_after_turns.inventory)\n                _, state_after_use_after_turn = temp_state_after_turns.step(USE_ACT)\n\n                state_changed_by_use_after_turn = not (\n                    np.array_equal(state_after_use_after_turn.inventory, inventory_before_use_after_turn) and\n                    state_after_use_after_turn.pos == temp_state_after_turns.pos and\n                    state_after_use_after_turn.dir == temp_state_after_turns.dir\n                )\n\n                next_inventory_tuple_after_use_after_turn = tuple(state_after_use_after_turn.inventory)\n                next_state_key_after_use_after_turn = (state_after_use_after_turn.pos[0], state_after_use_after_turn.pos[1], state_after_use_after_turn.dir, next_inventory_tuple_after_use_after_turn)\n\n                # Add to queue if state changed and it's a new state.\n                # Crucially, we only add if it *didn't* already satisfy the goal (which was handled by early returns).\n                if state_changed_by_use_after_turn and next_state_key_after_use_after_turn not in visited:\n                    visited.add(next_state_key_after_use_after_turn)\n                    q.append((state_after_use_after_turn, path + turns_to_face + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T11:31:46.250974", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Map the primitive name (string) to its integer ID.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not found, it's an invalid target.\n    return []\n\n  # 2. Early exit: If the agent already has the primitive, no actions are needed.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Determine if the primitive is collectible via the 'USE' action in the game.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If not collectible by 'USE', we cannot fulfill the request.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action constants and spatial relationship helpers.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP\n      1: (0, 1),  # RIGHT\n      2: (1, 0),  # DOWN\n      3: (0, -1)  # LEFT\n  }\n\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      \"\"\"Calculates the minimal turning actions to face target_dir from current_dir.\"\"\"\n      if current_dir == target_dir:\n          return []\n      \n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # One step clockwise\n          return [RIGHT_ACT]\n      elif diff == 3: # One step counter-clockwise\n          return [LEFT_ACT]\n      else: # Two steps (180-degree turn)\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily use two rights for 180 turn\n\n  # 5. Initialize BFS data structures.\n  q = collections.deque()\n  visited = set() # Stores (row, col, dir, inventory_tuple) to avoid cycles and redundant exploration.\n\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, [])) # (CraftState object, list of actions to reach this state)\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  \n  # V2 Improvement: Refined constants for search limits.\n  # These constants help manage the computational complexity of the BFS, balancing\n  # thoroughness with performance.\n  MAX_INVENTORY_STATES_MULTIPLIER = 10 # Heuristic to allow for various inventory states (e.g., acquiring tools).\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * MAX_INVENTORY_STATES_MULTIPLIER \n  MAX_PATH_LENGTH = 200 # Maximum allowed actions in a path to collect the primitive.\n\n  explored_states_count = 0\n\n  # 6. BFS Loop: Continues as long as there are states to explore in the queue.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path leading to it.\n    explored_states_count += 1\n\n    # Pruning: If the number of explored states exceeds the heuristic limit,\n    # terminate the search, indicating no feasible path within reasonable bounds.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      return [] \n    \n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # First, check if the target primitive (`i_kind`) is present in the agent's 3x3 neighborhood.\n    if state.next_to(i_kind):\n        for target_dir in range(4): # Iterate through all four possible agent orientations.\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Verify that the cell directly in front (if facing `target_dir`) is:\n            # a) within grid boundaries, and b) actually contains an instance of the primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                \n                # V2 Improvement: Prune early if the potential final path (path + turns + USE)\n                # would exceed the maximum allowed length. This prevents costly simulation\n                # of actions on paths that will ultimately be rejected.\n                potential_final_path_length = len(path) + len(turns_to_face) + 1 \n                if potential_final_path_length > MAX_PATH_LENGTH:\n                    continue # This specific path to collection is too long; try other directions or paths.\n\n                # Simulate the turning actions to align the agent with the primitive.\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before 'USE' to verify successful collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical verification: Check if the primitive's count in inventory increased.\n                # This confirms successful collection, respecting game mechanics (e.g., needing tools).\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    final_path = path + turns_to_face + [USE_ACT]\n                    # Since BFS guarantees the shortest path, if this path is found and valid, return it.\n                    # The length check (<= MAX_PATH_LENGTH) is already implicitly satisfied by the `continue`\n                    # check above, but included here for explicit clarity.\n                    if len(final_path) <= MAX_PATH_LENGTH:\n                        return final_path\n                    # If the shortest path found is still too long, no valid path within the limit exists.\n                    # This case should ideally not be hit if `potential_final_path_length` check is effective.\n\n    # Explore possible movement actions (UP, DOWN, LEFT, RIGHT).\n    for action in move_actions:\n      # V2 Improvement: Prune early if adding this movement action would exceed MAX_PATH_LENGTH.\n      if len(path) + 1 > MAX_PATH_LENGTH:\n          continue # Skip this action if it makes the path too long.\n\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      # Add the new state to the queue if it hasn't been visited before.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the general 'USE' action from the current position.\n    # This is important for collecting tools or other items that change the inventory,\n    # which might be necessary for later steps to collect the target primitive.\n    # V2 Improvement: Prune early if adding this general 'USE' action would exceed MAX_PATH_LENGTH.\n    if len(path) + 1 > MAX_PATH_LENGTH:\n        continue # Skip this action if it makes the path too long.\n\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Only add the state if the 'USE' action had a meaningful effect (changed inventory, position, or direction).\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        # Add this 'USE'-resultant state to the queue if it's a new, unvisited state.\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue becomes empty and no path was returned, it means the primitive is unreachable\n  # from the initial state within the defined exploration limits.\n  return []", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T11:31:47.709292", "function_name": "collect", "function_body": "  \"\"\"An improved version of `collect_v1` that finds a sequence of actions\n  to collect a specified primitive item in the CraftLab environment using BFS.\n\n  Improvements over v1 primarily focus on enhanced clarity, constant tuning,\n  and robust handling of state transitions.\n\n  Args:\n      env (env.CraftLab): The CraftLab environment instance.\n      primitive (str): The name of the primitive resource to collect (e.g., \"wood\", \"stone\").\n\n  Returns:\n      List[int]: A list of integer action codes (e.g., UP, DOWN, USE)\n                 representing the shortest path to collect the primitive.\n                 Returns an empty list if the primitive is already collected,\n                 uncollectible, or unreachable within defined search limits.\n  \"\"\"\n  current_state = env._current_state\n  world = env.world\n\n  # 1. Map the string name of the primitive to its internal integer ID.\n  # This ID is essential for interacting with the simulation's grid and inventory.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name does not exist in the world's index, it's invalid.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If the agent already possesses the item, no collection actions are needed.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Determine if the primitive is inherently collectible via the 'USE' action.\n  # This includes resources defined as 'grabbable' (e.g., sticks, planks)\n  # or specific environmental features that can be directly interacted with\n  # for collection (e.g., \"water\", \"stone\"). Other items (like \"workshop\")\n  # are typically structures, not inventory items.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the target item is not of a type that can be collected via the 'USE' action,\n  # then this function cannot fulfill the request.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define Action Constants and Movement/Direction Mapping.\n  # These mappings ensure the code uses the correct integer IDs for actions\n  # and accurately simulates agent movement and orientation changes.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  # A list of basic movement actions for easy iteration during BFS.\n  MOVE_ACTIONS = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) that would place an agent in the cell directly in front.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: Decreases row (moves North on grid)\n      1: (0, 1),  # RIGHT: Increases column (moves East)\n      2: (1, 0),  # DOWN: Increases row (moves South)\n      3: (0, -1)  # LEFT: Decreases column (moves West)\n  }\n\n  # Helper function to compute the minimal sequence of turning actions needed\n  # to align the agent's `current_dir` with a `target_dir`.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Agent is already facing the desired direction.\n\n      # Calculate the shortest rotational difference, considering wrap-around (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference that correctly\n      # identifies the shortest turn (e.g., from 3 to 0 is +1 (RIGHT), not -3 (LEFT, LEFT, LEFT)).\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2 (A 180-degree turn, e.g., UP(0) -> DOWN(2))\n          # Two consecutive turns in the same direction achieve a 180-degree rotation.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily use two RIGHT_ACTs, two LEFT_ACTs would also work.\n\n  # 5. Initialize Breadth-First Search (BFS) data structures.\n  q = collections.deque() # Queue to hold (CraftState, list_of_actions_to_reach_this_state) tuples.\n  \n  # The 'visited' set tracks previously explored states to prevent cycles and redundant work.\n  # A state is defined by (agent_row, agent_col, agent_direction, inventory_tuple).\n  # Inventory is converted to an immutable tuple to be hashable and to distinguish states\n  # where the agent's capabilities (tools, resources) have changed.\n  visited = set()\n\n  # Start BFS from the current state of the environment.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, [])) # Add initial state with an empty action path.\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n\n  # V2 Improvement: Refined Heuristic Limits for BFS Exploration.\n  # These constants are set to balance between finding a solution and preventing\n  # excessively long computations in complex or very large environments.\n\n  # INVENTORY_STATE_VARIABILITY_FACTOR: This heuristic accounts for the number of\n  # distinct \"useful\" inventory states (e.g., acquiring different tools) that might\n  # be encountered for a given (position, direction). A higher value allows more\n  # exploration of tool-gathering paths.\n  INVENTORY_STATE_VARIABILITY_FACTOR = 10 # Empirically chosen, can be tuned.\n  \n  # MAX_EXPLORED_STATES: The absolute upper bound on the number of unique\n  # (position, direction, inventory) states the BFS will visit.\n  # This prevents the search from running indefinitely in highly complex maps.\n  # It scales with grid size and number of directions (4), and the inventory variability.\n  MAX_EXPLORED_STATES = grid_width * grid_height * len(_DIR_TO_DELTA_FRONT) * INVENTORY_STATE_VARIABILITY_FACTOR\n  \n  # MAX_PATH_LENGTH: Maximum number of actions allowed in a returned path.\n  # Solutions requiring paths longer than this are considered too inefficient\n  # or practically unreachable for a single primitive collection.\n  # A path length of 200 is generally generous for a single collection task.\n  MAX_PATH_LENGTH = 200 \n\n  explored_states_count = 0 # Counter for visited states to enforce `MAX_EXPLORED_STATES`.\n\n  # 6. BFS Loop: Continue as long as there are states in the queue to explore.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path leading to it.\n    explored_states_count += 1\n\n    # Pruning: If the search has explored too many states, it suggests that\n    # the target is either unreachable or requires an excessively long path.\n    # Return an empty list to signal failure to find a viable path within limits.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      return [] \n    \n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # --- Goal Check and Collection Attempt ---\n    # Check if the target primitive (`i_kind`) is present in the agent's 3x3 neighborhood.\n    if state.next_to(i_kind):\n        # Iterate through all four possible agent orientations (UP, RIGHT, DOWN, LEFT).\n        # We need to find if facing any of these directions would put the primitive directly in front.\n        for target_dir in range(len(_DIR_TO_DELTA_FRONT)): \n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Verify that the cell directly in front (if facing `target_dir`) meets conditions:\n            # a) within grid boundaries, and b) actually contains an instance of the primitive (grid value is 1).\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Calculate and simulate the sequence of turning actions required to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    # Apply each turning action. Rewards for turns are typically 0.0, so ignored.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Capture the inventory state *before* attempting the 'USE' action.\n                # This is crucial for verifying if 'USE' successfully collected the primitive.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action from the correctly oriented state.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical Verification: Check if the count of the target primitive\n                # in the inventory *increased* after the 'USE' action. This confirms\n                # successful collection, accounting for any game rules (e.g., needing\n                # a specific tool) implemented internally by `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    # A valid path has been found. Construct the full sequence of actions.\n                    final_path = path + turns_to_face + [USE_ACT]\n                    \n                    # V2 Improvement: Apply MAX_PATH_LENGTH limit at the point of discovery.\n                    # If the shortest path found (due to BFS) exceeds the maximum allowed length,\n                    # then this path is not considered viable. No other shorter path exists.\n                    if len(final_path) <= MAX_PATH_LENGTH:\n                        return final_path\n                    else:\n                        # The shortest path is too long, so no valid path exists within the limit.\n                        return []\n\n    # --- Explore New States through Actions ---\n    # 1. Explore possible movement actions (UP, DOWN, LEFT, RIGHT).\n    # These actions change position and potentially direction but not inventory directly.\n    for action in MOVE_ACTIONS:\n      _, next_state = state.step(action)\n      # Convert the inventory of the new state to an immutable tuple for hashability.\n      next_inventory_tuple = tuple(next_state.inventory) \n      # Create a unique key for the `visited` set to track explored (pos, dir, inventory) combinations.\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      # If this new state has not been visited before, add it to the queue and mark it as visited.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # 2. Explore the 'USE' action generally from the current position.\n    # This is distinct from the 'USE' in the goal check. This general 'USE' handles scenarios\n    # where using an item at the current location might change the inventory (e.g., picking\n    # up a tool like an axe or shears, or interacting with a crafting bench), which could\n    # enable future collection of other primitives, even if it doesn't directly collect the *target* primitive.\n    inventory_before_current_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Only add the state resulting from this general 'USE' if it actually led to a\n    # meaningful change in the state (inventory, position, or direction). This prevents\n    # adding redundant states to the queue if 'USE' had no effect (e.g., using nothing,\n    # or using an item that doesn't change the state).\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_current_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        # Add this 'USE'-resultant state to the queue if it's a new, unvisited state.\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS loop completes and the queue becomes empty without finding a path\n  # to collect the target primitive, it means the primitive is either unreachable\n  # from the initial state or requires a path longer than `MAX_PATH_LENGTH`\n  # or involves exploring more states than `MAX_EXPLORED_STATES`.\n  return []", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T11:33:02.522424", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # `visited` set tracks previously explored states to avoid cycles and redundant computation.\n  # A state is defined by (agent_row, agent_col, agent_direction, inventory_tuple).\n  visited = set()\n  # `came_from` dictionary for efficient path reconstruction (avoids costly list copies).\n  # It maps a state_key to (previous_state_key, action_taken_to_reach_current_state).\n  came_from = {} \n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  initial_state_key = (current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple)\n  \n  # The queue stores the CraftState object and its unique key.\n  q.append((current_state, initial_state_key))\n  visited.add(initial_state_key)\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # MAX_EXPLORED_STATES is a heuristic limit to prevent excessive search.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n  # MAX_PATH_LENGTH is a heuristic limit to prevent excessively long plans.\n  MAX_PATH_LENGTH = 200 \n\n  # 6. BFS Loop.\n  while q:\n    # Dequeue the current state and its unique key.\n    state, current_state_key = q.popleft() \n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      return [] # No path found within limits.\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`) in the 3x3 neighborhood.\n    if state.next_to(i_kind):\n        for target_dir in range(4): # Iterate through possible agent orientations (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell directly in front contains the target primitive\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                temp_state_before_use = state \n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                for turn_action in turns_to_face:\n                    # Apply each turn action to get the state after all turns.\n                    _, temp_state_before_use = temp_state_before_use.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_before_use.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_before_use.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`).\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    # Path reconstruction:\n                    path_to_current_state = []\n                    temp_key = current_state_key\n                    # Reconstruct path by tracing back from the current state key to the initial state key.\n                    while temp_key != initial_state_key:\n                        prev_key, action = came_from[temp_key]\n                        path_to_current_state.insert(0, action) # Insert at the beginning to build path in correct order\n                        temp_key = prev_key\n                    \n                    final_path = path_to_current_state + turns_to_face + [USE_ACT]\n\n                    # Check if the found path is within the maximum allowed length.\n                    if len(final_path) <= MAX_PATH_LENGTH:\n                        return final_path\n                    else:\n                        # The shortest path found is too long, so no valid path exists within the limit.\n                        return []\n\n    # Explore possible actions: movements and general USE.\n    # The general USE action is important if using an item (e.g., picking up a tool)\n    # can change the inventory state, which might be necessary for later steps to collect the primitive.\n    actions_to_consider = move_actions + [USE_ACT]\n    \n    for action in actions_to_consider:\n        _, next_state = state.step(action) # CraftState.step returns a new state object\n        \n        next_inventory_tuple = tuple(next_state.inventory)\n        next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            came_from[next_state_key] = (current_state_key, action)\n            q.append((next_state, next_state_key))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T11:33:03.957050", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` with enhanced clarity, robustness checks, and consistent state management.\n    \n    Args:\n        env (env.CraftLab): The CraftLab object providing the environment state and actions.\n        primitive (str): The name of the primitive item to be collected (e.g., \"wood\", \"stone\").\n\n    Returns:\n        List[int]: A sequence of integer action indices (e.g., UP, DOWN, USE)\n                   that, when executed, will lead to the collection of the specified primitive.\n                   Returns an empty list if the primitive is already in inventory or unreachable.\n  \"\"\"\n  current_state = env._current_state\n  world = env.world\n\n  # 1. Obtain the integer ID for the target primitive.\n  # If the primitive name is not recognized by the cookbook, it cannot be collected.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # Primitive name not found; it's an invalid target for collection.\n    return []\n\n  # 2. Early Exit: Check if the primitive is already present in the agent's inventory.\n  # If so, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic Pre-Check: Determine if the primitive is of a type that can be collected via the 'USE' action.\n  # This filters out environmental elements (like workshops, boundaries) that are not typically \"collected\"\n  # into inventory. It includes grabbable items and specific harvestable resources like water or stone.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  if not is_collectible_via_use:\n    # If the primitive is not designated as collectible by 'USE', no path will be found.\n    return []\n\n  # 4. Define action constants and movement/orientation utilities.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # Mapping agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to (row_change, col_change) for the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # Facing UP: target is one row above.\n      1: (0, 1),  # Facing RIGHT: target is one column to the right.\n      2: (1, 0),  # Facing DOWN: target is one row below.\n      3: (0, -1)  # Facing LEFT: target is one column to the left.\n  }\n\n  # Helper function to compute the minimal sequence of turn actions\n  # required for the agent to change from `current_dir` to `target_dir`.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # No turns needed if already facing the target direction.\n      \n      # Calculate the difference in directions, handling the circular nature (0-3).\n      # Adding 4 and then modulo 4 ensures the `diff` is always positive [0, 1, 2, 3].\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # One clockwise turn (e.g., UP to RIGHT).\n          return [RIGHT_ACT]\n      elif diff == 3: # One counter-clockwise turn (e.g., UP to LEFT).\n          return [LEFT_ACT]\n      else: # `diff == 2` implies a 180-degree turn (e.g., UP to DOWN).\n          # This can be achieved with two turns in the same direction.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily pick RIGHT twice.\n\n  # 5. Initialize Breadth-First Search (BFS) data structures.\n  # `q`: A deque to manage states to visit, storing (CraftState object, path_to_this_state).\n  q = collections.deque()\n  # `visited`: A set to keep track of already explored states to prevent cycles and redundant work.\n  # A state is defined by (agent_row, agent_col, agent_direction, immutable_inventory_tuple).\n  # The inventory is converted to a tuple to make it hashable for set lookups.\n  visited = set()\n\n  # Add the initial environment state to the queue and visited set.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  initial_state_key = (current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple)\n  \n  q.append((current_state, [])) # Start with the current state and an empty list of actions.\n  visited.add(initial_state_key) # Mark the initial state as visited.\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  \n  # Heuristic limits for BFS to prevent excessive computation in large or unsolvable environments.\n  # MAX_EXPLORED_STATES: Limits the total number of distinct states (pos, dir, inventory) explored.\n  # The `* 10` is an arbitrary multiplier to account for different inventory configurations.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  \n  # MAX_PATH_LENGTH: Defines the maximum acceptable length for a plan.\n  # Paths longer than this are considered too inefficient or infeasible.\n  MAX_PATH_LENGTH = 200 \n\n  # 6. BFS Loop: Continuously explore states until the queue is empty or a solution is found.\n  while q:\n    # Dequeue the current state and the sequence of actions that led to it.\n    state, path = q.popleft() \n\n    # Pruning by path length: If the current path already exceeds the maximum allowed length,\n    # skip exploring neighbors from this state, as any extended path will also be too long.\n    if len(path) >= MAX_PATH_LENGTH:\n        continue \n    \n    # Pruning by total states explored: If too many distinct states have been visited globally,\n    # it indicates a very large search space or an unlikely solution within reasonable bounds.\n    if len(visited) > MAX_EXPLORED_STATES:\n      return [] # Return empty list, indicating no feasible path found within limits.\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # --- Goal Check: Attempt to collect the primitive from the current state ---\n    # First, check if the primitive is in the agent's immediate 3x3 neighborhood.\n    if state.next_to(i_kind):\n        # If found nearby, iterate through all four cardinal directions to find if\n        # facing any of them would directly target the primitive.\n        for target_dir in range(4): \n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Validate that the cell in front is within grid boundaries and contains the primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Calculate the turning actions required to face the target cell.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                \n                # Simulate the turning actions to get the agent's state just before using 'USE'.\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    # `state.step` returns (reward, new_state). We only care about `new_state`.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Record inventory *before* attempting the 'USE' action to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Crucial check: Did the inventory count of `i_kind` actually increase after 'USE'?\n                # This confirms successful collection, respecting internal game rules (e.g., tool requirements).\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    # If collected, we've found the shortest path (due to BFS property).\n                    final_path = path + turns_to_face + [USE_ACT]\n                    \n                    # Final validation against maximum path length before returning.\n                    if len(final_path) <= MAX_PATH_LENGTH:\n                        return final_path\n                    else:\n                        # Even the shortest path found is too long, so consider it unachievable.\n                        return [] \n\n    # --- Explore Neighboring States: Add new states (from movement or general 'USE') to the queue ---\n    \n    # 1. Explore Movement Actions (UP, DOWN, LEFT, RIGHT):\n    for action in move_actions:\n      # Get the new state after applying a movement action.\n      _, next_state = state.step(action) \n      \n      # Create a hashable key for the new state.\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      # If this new state hasn't been visited, add it to the queue and mark as visited.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action])) # Append the action to the path.\n    \n    # 2. Explore General 'USE' Action:\n    # The 'USE' action might not directly collect the *target* primitive, but it could\n    # change the inventory (e.g., picking up a tool) or the environment, opening up new possibilities.\n    \n    inventory_before_general_use = np.copy(state.inventory)\n    _, state_after_general_use = state.step(USE_ACT)\n    \n    # Add the state resulting from a general 'USE' action only if it changed meaningfully.\n    # This prevents redundant exploration of states where 'USE' was a no-op (e.g., used in empty space).\n    if not (np.array_equal(state_after_general_use.inventory, inventory_before_general_use) and\n            state_after_general_use.pos == state.pos and\n            state_after_general_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_general_use.inventory)\n        next_state_key = (state_after_general_use.pos[0], state_after_general_use.pos[1], state_after_general_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_general_use, path + [USE_ACT]))\n\n  # 7. If the BFS loop completes and the queue becomes empty without finding a solution,\n  # it means the primitive is unreachable from the initial state within the defined search limits.\n  return []", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T11:33:54.645400", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state # Access the underlying CraftState for detailed info\n\n  grid = current_state.grid # (rows, columns, kinds) numpy array representing the current state of the world\n  agent_initial_pos = current_state.pos  # Agent's starting position (row, col)\n  agent_initial_dir = current_state.dir  # Agent's starting facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook's index.\n  # This maps string names (e.g., \"WOOD\", \"STONE\") to their integer representations.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Determine grid dimensions for boundary checks and pathfinding.\n  grid_rows, grid_cols, _ = grid.shape\n\n  # Retrieve integer action IDs from the environment's action specifications.\n  # These are the numeric codes for actions like moving forward, turning, and using.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # Corresponds to moving forward in the current direction\n  TURN_LEFT_ACTION = action_map['LEFT']     # Corresponds to turning 90 degrees left\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Corresponds to turning 90 degrees right\n  USE_ACTION = action_map['USE']            # Action to interact with the cell directly in front\n\n  # Direction vectors (dr, dc) for agent's facing direction.\n  # These define how row and column coordinates change when moving \"forward\".\n  # Mapping: 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # Mapping for updating agent's direction when turning left or right.\n  # Directions cycle: 0 -> 1 -> 2 -> 3 -> 0 for left turns.\n  TURN_LEFT_DIR_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # RIGHT->UP->LEFT->DOWN->RIGHT\n  TURN_RIGHT_DIR_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # RIGHT->DOWN->LEFT->UP->RIGHT\n\n  # Define all kinds that block agent movement into a cell.\n  # This includes non-grabbable entities (like walls, water, workshops) AND the primitive itself.\n  # The agent needs to be *adjacent* to the primitive to 'USE' it, not occupy its cell.\n  blocking_kinds_indices = current_state.world.non_grabbable_indices.union({primitive_id})\n\n  # BFS Initialization:\n  # The queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_to_reach_here)\n  # A state includes both position and orientation because actions (like 'USE') depend on direction,\n  # and possible next positions depend on current direction.\n  queue = collections.deque([((agent_initial_pos, agent_initial_dir), [])])\n  \n  # The visited set stores (position_tuple, direction_int) to avoid redundant computations, cycles,\n  # and ensure finding the shortest path (BFS guarantees this for unweighted graphs).\n  visited = {(agent_initial_pos, agent_initial_dir)}\n\n  # This variable will store the sequence of actions to reach the state where the primitive is in front.\n  path_to_primitive_adjacency = None \n\n  while queue:\n      (current_pos, current_dir), path_taken = queue.popleft()\n      current_row, current_col = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent from the current state.\n      # If it is, we've found our target \"adjacency\" state for collection.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_cell_row, front_cell_col = current_row + front_dr, current_col + front_dc\n      \n      # Ensure the cell in front is within grid boundaries before checking its contents.\n      if (0 <= front_cell_row < grid_rows and 0 <= front_cell_col < grid_cols):\n          # Check if the primitive is present in this front cell.\n          if grid[front_cell_row, front_cell_col, primitive_id] > 0:\n              path_to_primitive_adjacency = path_taken\n              break # Target state found, stop BFS.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n      # These actions change the agent's state (position and/or direction).\n\n      # Try Move Forward action:\n      move_dr, move_dc = DIR_TO_DRDC[current_dir] # Delta for moving forward\n      next_row, next_col = current_row + move_dr, current_col + move_dc\n      next_pos = (next_row, next_col)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if the potential next position is valid (within grid bounds)\n      # and if this specific (position, direction) state has not been visited yet.\n      if (0 <= next_row < grid_rows and 0 <= next_col < grid_cols and\n          (next_pos, next_dir) not in visited):\n          \n          is_walkable = True\n          # Determine if the next cell is walkable.\n          # A cell is not walkable if it contains any kind from the 'blocking_kinds_indices' set.\n          for kind_idx in blocking_kinds_indices:\n              if grid[next_row, next_col, kind_idx] > 0:\n                  is_walkable = False\n                  break\n\n          if is_walkable:\n              visited.add((next_pos, next_dir)) # Mark new state as visited\n              # Add to queue with the updated path, including the MOVE_FORWARD_ACTION.\n              queue.append(((next_pos, next_dir), path_taken + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left action:\n      next_dir_left = TURN_LEFT_DIR_MAP[current_dir] # Calculate new direction after turning left\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left)) # Mark new state as visited\n          # Add to queue with updated path, including the TURN_LEFT_ACTION.\n          queue.append(((current_pos, next_dir_left), path_taken + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right action:\n      next_dir_right = TURN_RIGHT_DIR_MAP[current_dir] # Calculate new direction after turning right\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right)) # Mark new state as visited\n          # Add to queue with updated path, including the TURN_RIGHT_ACTION.\n          queue.append(((current_pos, next_dir_right), path_taken + [TURN_RIGHT_ACTION]))\n\n  # After BFS completes (either target found or queue empty):\n  # If a path to the target adjacency state was found, append the USE action to complete the collection.\n  if path_to_primitive_adjacency is not None:\n      actions_list.extend(path_to_primitive_adjacency)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T11:33:55.871629", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` with consolidated blocking logic for cleaner pathfinding.\"\"\"\n  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's initial position (row, col)\n  initial_dir = current_state.dir # Agent's initial facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook's index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Determine grid dimensions: num_rows corresponds to grid.shape[0], num_cols to grid.shape[1]\n  num_rows, num_cols, _ = initial_grid.shape\n\n  # Retrieve action mapping from the environment\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # Corresponds to moving forward in the current direction\n  TURN_LEFT_ACTION = action_map['LEFT']     # Corresponds to turning 90 degrees left\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Corresponds to turning 90 degrees right\n  USE_ACTION = action_map['USE']            # Action to interact with the cell in front\n\n  # Direction vectors (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  # (dr, dc) indicates how row and column change when moving \"forward\"\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # Mapping for updating agent's direction when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # RIGHT->UP->LEFT->DOWN->RIGHT\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # RIGHT->DOWN->LEFT->UP->RIGHT\n\n  # Define all kinds that block agent movement into a cell.\n  # This includes non-grabbable entities (like walls, water, workshops)\n  # AND the primitive itself, as the agent needs to be *adjacent* to it to 'USE' it, not occupy its cell.\n  blocked_for_movement_kinds = current_state.world.non_grabbable_indices.copy()\n  blocked_for_movement_kinds.add(primitive_id)\n  # Convert the set to a list once for efficient iteration.\n  blocked_for_movement_kinds_list = list(blocked_for_movement_kinds)\n\n  # BFS initialization:\n  # Queue stores ( (current_position_tuple, current_direction_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (position_tuple, direction_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the sequence of actions to reach the state where the primitive is in front\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent from the current state (ready for USE action)\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the cell in front is within grid boundaries\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n          # Check if the primitive is in this cell. If yes, we've found our target adjacent state.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Path found! The agent is positioned adjacent to and facing the primitive.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right\n\n      # Attempt to Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Direction does not change when moving forward\n\n      # Check if the next position is within bounds and this (position, direction) state hasn't been visited\n      if (0 <= next_r < num_rows and 0 <= next_c < num_cols and\n          (next_pos, next_dir) not in visited):\n          \n          is_walkable = True\n          # Check if the potential next cell contains any blocking kind defined in `blocked_for_movement_kinds_list`.\n          for kind_idx in blocked_for_movement_kinds_list:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable = False\n                  break # Found a blocking item, so this cell is not walkable.\n\n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Attempt to Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Attempt to Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path to the target adjacent state was found, append the USE action to complete the collection\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T11:35:49.654407", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` by optimizing path reconstruction memory usage.\"\"\"\n  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # Helper to reconstruct path from the parent map\n  def _reconstruct_path(end_state_key, initial_key, parent_map):\n      path = []\n      current_key = end_state_key\n      while current_key != initial_key:\n          if current_key not in parent_map:\n              # Should not happen if a path was truly found.\n              return [] \n          prev_state_key, action = parent_map[current_key]\n          path.append(action)\n          current_key = prev_state_key\n      return path[::-1] # Reverse the path to get actions from start to end\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # `visited` set stores state keys: (pos_r, pos_c, dir, inventory_tuple)\n  visited = set()\n  # `parent` dictionary maps `current_state_key` -> `(previous_state_key, action_taken_to_reach_current)`\n  parent = {} \n  # `state_object_map` maps `state_key` -> `CraftState` object. Necessary to retrieve the actual state object\n  # when expanding from a key, as `CraftState` is not directly hashable and we need to call its methods.\n  state_object_map = {}\n\n  initial_inventory_tuple = tuple(current_state.inventory)\n  initial_state_key = (current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple)\n\n  q.append(initial_state_key)\n  visited.add(initial_state_key)\n  state_object_map[initial_state_key] = current_state # Store the initial state object\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Increased MAX_EXPLORED_STATES due to the larger state space when tracking inventory.\n  # This is a heuristic and may need tuning for specific environment complexities.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state_key = q.popleft() # Dequeue the state key\n    state = state_object_map[state_key] # Retrieve the actual CraftState object\n    \n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`).\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                \n                # Simulate turning actions and update parent/state maps\n                temp_state_after_turns = state\n                temp_state_key_after_turns = state_key \n\n                for turn_action in turns_to_face:\n                    _, next_sim_state = temp_state_after_turns.step(turn_action)\n                    next_sim_state_key = (next_sim_state.pos[0], next_sim_state.pos[1], next_sim_state.dir, tuple(next_sim_state.inventory))\n                    \n                    # Only add to parent/state_object_map if it's a new state or found a shorter path to it (BFS guarantees shortest path if first visited)\n                    if next_sim_state_key not in visited:\n                        visited.add(next_sim_state_key) # Mark as visited to prevent cycles\n                        # Don't add to queue here, as these are simulated steps for the goal check.\n                        # Their parentage is still tracked though.\n                        parent[next_sim_state_key] = (temp_state_key_after_turns, turn_action)\n                        state_object_map[next_sim_state_key] = next_sim_state \n\n                    temp_state_after_turns = next_sim_state\n                    temp_state_key_after_turns = next_sim_state_key\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    # Primitive successfully collected. Reconstruct full path.\n                    final_state_key_after_use = (state_after_use.pos[0], state_after_use.pos[1], state_after_use.dir, tuple(state_after_use.inventory))\n                    \n                    # Record the final USE action in the parent map\n                    # This check is crucial: ensure we only set the parent if we don't already have a shorter path recorded.\n                    # Since we're doing a BFS and tracking inventory, this will be the shortest path in action steps.\n                    if final_state_key_after_use not in visited: # If this final state has not been explicitly visited via BFS\n                        parent[final_state_key_after_use] = (temp_state_key_after_turns, USE_ACT)\n                        state_object_map[final_state_key_after_use] = state_after_use\n                    \n                    return _reconstruct_path(final_state_key_after_use, initial_state_key, parent)\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append(next_state_key)\n        parent[next_state_key] = (state_key, action) # Record parent and action\n        state_object_map[next_state_key] = next_state # Store the actual state object\n\n    # Explore the USE action from the current position, even if not directly on the target primitive.\n    # This is important if using an item at the current position (e.g., picking up a tool)\n    # can change the inventory state, which might be necessary for later steps to collect the primitive.\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if the USE action resulted in a meaningful state change (inventory, position, or direction).\n    # This prevents adding redundant states to the queue if USE had no effect.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append(next_state_key)\n            parent[next_state_key] = (state_key, USE_ACT) # Record parent and action\n            state_object_map[next_state_key] = state_after_current_use # Store the actual state object\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T11:35:51.045672", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set now includes the agent's inventory as part of the state key.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing, allowing BFS to distinguish\n  # between states that are identical in position/direction but differ in inventory (e.g., having a tool vs. not).\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Increased MAX_EXPLORED_STATES due to the larger state space when tracking inventory.\n  # This is a heuristic and may need tuning for specific environment complexities.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`).\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the USE action from the current position.\n    # IMPROVEMENT for V2: Only consider a USE action beneficial for 'collect' if it changes the inventory.\n    # Actions that only change position/direction or the grid without affecting inventory are not relevant\n    # for the goal of collecting items.\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if the USE action resulted in an inventory change.\n    if not np.array_equal(state_after_current_use.inventory, inventory_before_any_use):\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 4, "scores": {"3": 1.5}}
