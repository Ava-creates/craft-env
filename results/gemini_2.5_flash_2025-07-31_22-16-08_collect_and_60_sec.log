{"timestamp": "2025-08-01T05:48:37.262113", "function_name": "collect", "function_body": "  current_state = env._current_state\n  cookbook = env.world.cookbook\n  \n  # Get the integer index for the specified primitive string.\n  # The `index` method will add the item to the index if it's not already there.\n  primitive_idx = cookbook.index.index(primitive)\n\n  # Optimization 1: If the agent already has the primitive in its inventory,\n  # no actions are needed to collect it.\n  if current_state.inventory[primitive_idx] > 0:\n      return []\n\n  # Optimization 2: Check if the primitive is actually a grabbable item.\n  # Non-grabbable items (like 'water', 'workshop', 'boundary') cannot be\n  # collected into inventory, even if the agent is next to them.\n  if primitive_idx not in env.world.grabbable_indices:\n    return []\n\n  # Retrieve the current grid layout and the agent's starting position.\n  grid = current_state.grid\n  start_pos = current_state.pos  # (x, y) tuple\n\n  # Define indices for entities that block movement. These are typically\n  # non-grabbable environment features like water, workshops, or boundaries.\n  # The agent cannot move into a cell containing any of these.\n  obstacle_indices = env.world.non_grabbable_indices\n\n  # Define possible movement actions and their corresponding changes in (x, y) coordinates.\n  # This mapping is used for navigating the grid in the BFS.\n  # (dx, dy) represents (change in x, change in y)\n  move_deltas = {\n      craft.UP: (0, -1),\n      craft.DOWN: (0, 1),\n      craft.LEFT: (-1, 0),\n      craft.RIGHT: (1, 0)\n  }\n\n  grid_width, grid_height, _ = grid.shape\n\n  # Initialize Breadth-First Search (BFS):\n  # The queue stores tuples of ((current_x, current_y), list_of_actions_taken_to_reach_here).\n  # BFS guarantees finding the shortest path in terms of number of actions.\n  queue = collections.deque([(start_pos, [])])\n  \n  # The `visited` set keeps track of (x, y) positions that have already been\n  # added to the queue, preventing redundant explorations and cycles.\n  visited_positions = {start_pos}\n\n  while queue:\n    (current_x, current_y), path_to_current = queue.popleft()\n\n    # Check the 3x3 neighborhood around the agent's current conceptual position\n    # for the presence of the target primitive. This includes the agent's\n    # current cell itself. This simulates the `CraftState.next_to` check.\n    is_primitive_adjacent = False\n    for dx_adj in [-1, 0, 1]:\n      for dy_adj in [-1, 0, 1]:\n        neighbor_x, neighbor_y = current_x + dx_adj, current_y + dy_adj\n\n        # Ensure the neighbor cell is within grid boundaries.\n        if 0 <= neighbor_x < grid_width and 0 <= neighbor_y < grid_height:\n          # Check if the primitive is present in this neighboring cell.\n          if grid[neighbor_x, neighbor_y, primitive_idx] > 0:\n            is_primitive_adjacent = True\n            break # Primitive found, no need to check other adjacent cells.\n      if is_primitive_adjacent:\n        break # Break from outer loop as well.\n\n    if is_primitive_adjacent:\n      # If the primitive is found in the immediate vicinity, the path is complete.\n      # The final action is `USE` to collect the item.\n      return path_to_current + [craft.USE]\n\n    # If the primitive is not yet adjacent, explore valid cardinal neighbors for movement.\n    for action, (dx_move, dy_move) in move_deltas.items():\n      next_x, next_y = current_x + dx_move, current_y + dy_move\n      next_pos = (next_x, next_y)\n\n      # 1. Boundary check: Ensure the next position is within the grid.\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      # 2. Visited check: Avoid re-processing positions to find the shortest path.\n      if next_pos in visited_positions:\n        continue\n\n      # 3. Obstacle check: Determine if the target cell is traversable.\n      # A cell is an obstacle if it contains any non-grabbable item.\n      is_next_cell_an_obstacle = False\n      for obs_idx in obstacle_indices:\n        if grid[next_x, next_y, obs_idx] > 0:\n          is_next_cell_an_obstacle = True\n          break\n      if is_next_cell_an_obstacle:\n        continue\n\n      # If the next position is valid and traversable, add it to the queue\n      # with the updated path, and mark it as visited.\n      visited_positions.add(next_pos)\n      queue.append((next_pos, path_to_current + [action]))\n\n  # If the BFS queue becomes empty and the primitive was not found as adjacent\n  # to any reachable position, it means the primitive is unreachable or not on the map.\n  return []", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T05:48:38.396115", "function_name": "collect", "function_body": "  # Define constants for turning logic, assuming specific int values for directions.\n  # These map `craft` constants to internal indices for cyclic arithmetic.\n  # Order for clockwise rotation: UP -> RIGHT -> DOWN -> LEFT\n  _dir_map_to_idx = {\n      craft.UP: 0,\n      craft.RIGHT: 1,\n      craft.DOWN: 2,\n      craft.LEFT: 3,\n  }\n\n  def _get_turn_actions(current_dir: int, target_dir: int) -> list[int]:\n      \"\"\"Calculates actions to turn from current_dir to target_dir.\n      Assumes 4 cardinal directions and 90-degree turns.\n      \"\"\"\n      if current_dir == target_dir:\n          return []\n\n      current_idx = _dir_map_to_idx.get(current_dir)\n      target_idx = _dir_map_to_idx.get(target_dir)\n\n      if current_idx is None or target_idx is None:\n          # This case should ideally not happen with valid craft directions\n          return []\n\n      # Calculate the difference in indices, ensuring positive result (0-3)\n      diff = (target_idx - current_idx + 4) % 4\n\n      if diff == 1: # One step clockwise (e.g., UP to RIGHT)\n          return [craft.RIGHT]\n      elif diff == 2: # Two steps clockwise (180 degrees, e.g., UP to DOWN)\n          return [craft.RIGHT, craft.RIGHT]\n      elif diff == 3: # Three steps clockwise (one step anti-clockwise, e.g., UP to LEFT)\n          return [craft.LEFT]\n      return [] # Should not be reached under normal circumstances\n\n  current_state = env._current_state\n  cookbook = env.world.cookbook\n  primitive_idx = cookbook.index.index(primitive)\n\n  # Optimization: If the agent already possesses the primitive in inventory.\n  if current_state.inventory[primitive_idx] > 0:\n      return []\n\n  # Safety check: If the requested primitive is not a grabbable item\n  # (e.g., \"water\", \"workshop\", \"boundary\"), it cannot be collected into inventory.\n  if primitive_idx not in env.world.grabbable_indices:\n    return []\n\n  grid = current_state.grid\n  start_pos = current_state.pos # Agent's current (x, y) position\n  start_dir = current_state.dir # Agent's initial facing direction\n\n  # Indices of entities that block movement (non-grabbable items).\n  # These are assumed to be the only obstacles the agent cannot move into.\n  non_movable_obstacle_indices = env.world.non_grabbable_indices\n\n  # Define movement actions and their corresponding delta coordinates (dx, dy).\n  moves = {\n      craft.UP: (0, -1),\n      craft.DOWN: (0, 1),\n      craft.LEFT: (-1, 0),\n      craft.RIGHT: (1, 0)\n  }\n\n  grid_width, grid_height, _ = grid.shape\n\n  # BFS initialization:\n  # The queue stores tuples of ((current_x, current_y, current_direction), list_of_actions_to_reach_here).\n  queue = collections.deque([((start_pos[0], start_pos[1], start_dir), [])])\n  # The `visited` set keeps track of (x, y, direction) states already explored\n  # to prevent cycles and ensure the shortest path in terms of actions.\n  visited = {(start_pos[0], start_pos[1], start_dir)}\n\n  while queue:\n    (x, y, current_dir), path = queue.popleft()\n\n    # Check cardinal 1-cell neighborhood around the current agent position (x, y)\n    # for the presence of the target primitive. We assume the 'USE' action\n    # targets the cell directly in front of the agent.\n    found_adjacent_primitive = False\n    primitive_target_cell = None\n    target_dir_for_use = None # The direction agent needs to face to interact with the primitive\n\n    # Iterate over cardinal directions (relative to agent)\n    cardinal_relative_positions = {\n        (0, -1): craft.UP,    # Cell directly \"up\" from agent\n        (0, 1): craft.DOWN,   # Cell directly \"down\" from agent\n        (-1, 0): craft.LEFT,  # Cell directly \"left\" from agent\n        (1, 0): craft.RIGHT,  # Cell directly \"right\" from agent\n    }\n\n    for (dx_adj, dy_adj), direction_needed in cardinal_relative_positions.items():\n      nx_adj, ny_adj = x + dx_adj, y + dy_adj\n\n      # Ensure the adjacent cell is within the grid boundaries.\n      if 0 <= nx_adj < grid_width and 0 <= ny_adj < grid_height:\n        # Check if the target primitive is present at this adjacent cell\n        if grid[nx_adj, ny_adj, primitive_idx] > 0:\n          found_adjacent_primitive = True\n          primitive_target_cell = (nx_adj, ny_adj)\n          target_dir_for_use = direction_needed # This is the direction the agent needs to face\n          break # Primitive found, stop checking other cardinal directions.\n\n    if found_adjacent_primitive:\n      # If the primitive is found in the immediate cardinal vicinity,\n      # calculate necessary turning actions to face it, then append 'USE'.\n      turn_actions = _get_turn_actions(current_dir, target_dir_for_use)\n      return path + turn_actions + [craft.USE]\n\n    # If the primitive is not yet adjacent, explore valid neighboring cells for movement.\n    # Consider only cardinal directions for movement.\n    for action, (dx_move, dy_move) in moves.items():\n      next_x, next_y = x + dx_move, y + dy_move\n      next_dir = action # Agent's new direction is set to the direction of movement\n\n      next_state = (next_x, next_y, next_dir)\n\n      # 1. Bounds check: Ensure the next position is within the grid dimensions.\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      # 2. Visited check: Avoid revisiting (position, direction) states to find the shortest path.\n      if next_state in visited:\n        continue\n\n      # 3. Traversability check: Ensure the next cell is not an obstacle.\n      is_obstacle = False\n      for obstacle_idx in non_movable_obstacle_indices:\n        if grid[next_x, next_y, obstacle_idx] > 0:\n          is_obstacle = True\n          break\n      if is_obstacle:\n        continue\n\n      # If all checks pass, add the new valid state to the queue.\n      visited.add(next_state)\n      queue.append((next_state, path + [action]))\n\n  # If the BFS queue becomes empty and no path to an adjacent primitive was found,\n  # it means the primitive is unreachable or does not exist on the map.\n  return []", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T05:50:00.557603", "function_name": "collect", "function_body": "  current_state = env._current_state\n  \n  # Retrieve action mappings for clarity and direct use in the BFS\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Get the integer index for the target primitive from the cookbook.\n  # Using `index.index(item)` ensures the item is mapped to an ID, creating it if necessary.\n  primitive_idx = env.world.cookbook.index.index(primitive)\n\n  # Optimization: If the agent is already next to the primitive, simply use it.\n  # The `CraftState.next_to` method correctly checks the 3x3 neighborhood around the agent's position.\n  if current_state.next_to(primitive_idx):\n    return [USE]\n\n  # Initialize grid and dimensions for pathfinding operations\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  # Determine impassable terrain types.\n  # These are entities that the agent cannot move onto.\n  # They are non-grabbable entities from the cookbook's environment set,\n  # excluding workshop locations which are typically traversable.\n  impassable_kinds = set(env.world.cookbook.environment) - set(env.world.workshop_indices)\n\n  # First, find all locations on the grid where the target primitive exists.\n  primitive_locations_on_grid = [] \n  for x in range(grid_width):\n    for y in range(grid_height):\n      # If the primitive's layer at (x, y) has a count greater than 0, it means it's present.\n      if grid[x, y, primitive_idx] > 0:\n        primitive_locations_on_grid.append((x, y))\n\n  # If the primitive isn't found anywhere on the map, it's unreachable.\n  if not primitive_locations_on_grid:\n    return []\n\n  # Define \"goal cells\" for the BFS. A goal cell is any traversable grid cell\n  # from which the agent can successfully use the 'USE' action on the primitive.\n  # This implies being in the 3x3 neighborhood of a primitive location.\n  goal_cells = set()\n  for px, py in primitive_locations_on_grid:\n    # Iterate through the 3x3 neighborhood around each primitive location.\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        gx, gy = px + dx, py + dy # Calculate potential goal cell coordinates\n\n        # Ensure the potential goal cell is within grid boundaries.\n        if not (0 <= gx < grid_width and 0 <= gy < grid_height):\n          continue\n\n        # Check if the potential goal cell itself contains an impassable kind.\n        # The agent must be able to move *to* this cell to perform 'USE'.\n        is_goal_cell_impassable = False\n        for k_idx in impassable_kinds:\n            if grid[gx, gy, k_idx] > 0: \n                is_goal_cell_impassable = True\n                break\n        \n        # Only add traversable cells to the set of goal cells.\n        if not is_goal_cell_impassable:\n          goal_cells.add((gx, gy))\n\n  # If no traversable goal cells are identified, the primitive is effectively unreachable.\n  if not goal_cells:\n      return []\n\n  # Perform Breadth-First Search (BFS) to find the shortest path from the agent's\n  # current position to any of the defined goal cells.\n  start_pos = current_state.pos\n  \n  # BFS queue: stores tuples of (current_position, path_taken_actions_to_reach_current_position)\n  q = collections.deque([(start_pos, [])]) \n  # Set to keep track of visited positions to prevent cycles and redundant exploration.\n  visited = {start_pos} \n\n  # Define possible movement deltas and their corresponding action indices.\n  MOVE_DELTAS_AND_ACTIONS = [\n      ((0, -1), UP),    # Move North (decreases Y-coordinate)\n      ((0, 1), DOWN),   # Move South (increases Y-coordinate)\n      ((-1, 0), LEFT),  # Move West (decreases X-coordinate)\n      ((1, 0), RIGHT),  # Move East (increases X-coordinate)\n  ]\n\n  while q:\n    (cx, cy), path = q.popleft() # Dequeue the current position and its path\n\n    # If the current position is one of our target goal cells, we've found the shortest path.\n    if (cx, cy) in goal_cells:\n      # The path found leads to a cell from which 'USE' can be applied.\n      return path + [USE] # Append the 'USE' action as the final step.\n\n    # Explore valid neighboring cells from the current position.\n    for (dx, dy), action in MOVE_DELTAS_AND_ACTIONS:\n      nx, ny = cx + dx, cy + dy # Calculate the new potential position.\n      new_pos = (nx, ny)\n\n      # Check if the new position is within the grid boundaries.\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue\n\n      # Check if the new position contains any impassable kind.\n      # The agent cannot move into cells with impassable entities.\n      is_new_pos_impassable = False\n      for k_idx in impassable_kinds:\n          if grid[nx, ny, k_idx] > 0: \n              is_new_pos_impassable = True\n              break\n      \n      if is_new_pos_impassable:\n          continue # Skip this position as it's blocked.\n\n      # If the new position has not been visited yet, add it to the queue for exploration.\n      if new_pos not in visited:\n        visited.add(new_pos)\n        q.append((new_pos, path + [action]))\n\n  # If the BFS queue becomes empty and no path to a goal cell was found,\n  # it means the primitive is unreachable from the current state.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T05:50:01.743466", "function_name": "collect", "function_body": "  current_state = env._current_state\n  current_grid = current_state.grid\n  current_pos = current_state.pos\n\n  # Get the integer index for the primitive from the cookbook\n  primitive_idx = env.world.cookbook.index.index(primitive)\n  \n  # Get action mappings from the environment's action_specs for clarity\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # 1. If the agent is already next to the primitive, simply use it.\n  # This leverages the CraftState's built-in `next_to` check.\n  if current_state.next_to(primitive_idx):\n    return [USE]\n\n  # 2. Find all grid locations where the primitive exists.\n  grid_width, grid_height, _ = current_grid.shape\n  \n  # List to store (x, y) coordinates of primitive occurrences\n  primitive_locations_on_grid = [] \n  # Iterate through the grid to find where the primitive is located\n  for x in range(grid_width):\n    for y in range(grid_height):\n      # If the primitive_idx layer at (x, y) has a value > 0, it means the primitive is there\n      if current_grid[x, y, primitive_idx] > 0:\n        primitive_locations_on_grid.append((x, y))\n\n  # If the primitive isn't anywhere on the map, we can't collect it.\n  if not primitive_locations_on_grid:\n    return []\n\n  # 3. Determine all \"goal cells\" for the BFS. \n  # A goal cell is any cell adjacent to (or on top of) the primitive, \n  # from which the agent can use the 'USE' action.\n  # For CraftWorld, 'USE' acts on the 3x3 neighborhood. So, any cell (gx,gy)\n  # such that a primitive location (px,py) is in its 3x3 neighborhood.\n  goal_cells = set()\n  for px, py in primitive_locations_on_grid:\n    # Iterate through the 3x3 neighborhood around each primitive location\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        gx, gy = px + dx, py + dy\n        # Ensure the potential goal cell is within grid bounds\n        if 0 <= gx < grid_width and 0 <= gy < grid_height:\n          goal_cells.add((gx, gy))\n\n  # 4. Perform Breadth-First Search (BFS) to find the shortest path.\n  \n  # BFS queue: stores (current_position, path_taken_actions_to_reach_current_position)\n  q = collections.deque([(current_pos, [])]) \n  # Set to keep track of visited positions to avoid redundant exploration and cycles\n  visited = {current_pos} \n\n  # Define possible movement deltas and their corresponding action indices\n  # (dx, dy) -> action\n  MOVE_DELTAS_AND_ACTIONS = [\n      ((0, -1), UP),    # Move North (Up on screen Y-)\n      ((0, 1), DOWN),   # Move South (Down on screen Y+)\n      ((-1, 0), LEFT),  # Move West (Left on screen X-)\n      ((1, 0), RIGHT),  # Move East (Right on screen X+)\n  ]\n\n  # Identify impassable kinds. These are non-grabbable items that are not workshops.\n  # The agent cannot move into cells containing these.\n  impassable_kinds_indices = set()\n  for idx in env.world.non_grabbable_indices:\n      # Workshops are typically traversable, even if non-grabbable\n      if idx not in env.world.workshop_indices: \n          impassable_kinds_indices.add(idx)\n\n  while q:\n    (cx, cy), path = q.popleft() # Dequeue the current position and its path\n\n    # If the current position is one of our target goal cells, we've found the shortest path\n    if (cx, cy) in goal_cells:\n      # The path found leads to the cell from which 'USE' can be applied.\n      return path + [USE]\n\n    # Explore valid neighbors\n    for (dx, dy), action in MOVE_DELTAS_AND_ACTIONS:\n      nx, ny = cx + dx, cy + dy # Calculate new potential position\n      new_pos = (nx, ny)\n\n      # Check if the new position is within grid boundaries\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue\n\n      # Check if the new position is impassable.\n      # A cell is impassable if any of the 'impassable_kinds_indices' are present there.\n      is_impassable = False\n      for k_idx in impassable_kinds_indices:\n          # Check if this specific impassable kind exists at (nx,ny) with a count > 0\n          if current_grid[nx, ny, k_idx] > 0: \n              is_impassable = True\n              break\n      \n      if is_impassable:\n          continue # Cannot move to this cell, skip it\n\n      # If the new position has not been visited yet, add it to the queue\n      if new_pos not in visited:\n        visited.add(new_pos)\n        q.append((new_pos, path + [action]))\n\n  # If the BFS queue becomes empty and no path to a goal cell was found,\n  # it means the primitive is unreachable from the current state.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T05:51:02.581725", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\"\"\"\n  current_state = env._current_state\n  \n  # Retrieve the integer index corresponding to the primitive name.\n  # This will raise a KeyError if the primitive name is not valid, as per design.\n  primitive_idx = env.world.cookbook.index.index(primitive)\n  \n  # --- Improvement for v2: Check if the primitive is already collected ---\n  # If the agent's inventory already contains the primitive, no actions are needed\n  # to collect it. This avoids redundant collection attempts and makes the collection\n  # idempotent if the item is already possessed.\n  if current_state.inventory[primitive_idx] > 0:\n    return [] # Already have it, return an empty action list.\n\n  # Get the integer mappings for all possible actions from the environment.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # --- Step 1: Check for immediate collection ---\n  # If the agent is already adjacent to the primitive (within its 3x3 neighborhood,\n  # including its own cell if the primitive is there), the most efficient action is\n  # simply to 'USE' it. This check prevents unnecessary pathfinding.\n  if current_state.next_to(primitive_idx):\n    return [USE]\n\n  # --- Step 2: Locate all occurrences of the primitive on the grid ---\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  # List to store (x, y) coordinates of all cells containing the primitive.\n  primitive_locations_on_grid = [] \n  for x in range(grid_width):\n    for y in range(grid_height):\n      # If the primitive's layer at (x, y) has a value greater than 0, it exists there.\n      if grid[x, y, primitive_idx] > 0:\n        primitive_locations_on_grid.append((x, y))\n\n  # If the primitive is not found anywhere on the map, it's unreachable.\n  if not primitive_locations_on_grid:\n    return []\n\n  # --- Step 3: Determine \"Goal Cells\" for BFS ---\n  # A \"goal cell\" is any grid location from which the agent can apply the 'USE' action\n  # to collect the target primitive. Since 'USE' affects a 3x3 area around the agent,\n  # any cell (gx, gy) that has a primitive (px, py) within its 3x3 neighborhood\n  # is a valid goal cell for the pathfinding BFS.\n  goal_cells = set()\n  for px, py in primitive_locations_on_grid:\n    # Iterate through the 3x3 neighborhood around each primitive instance.\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        gx, gy = px + dx, py + dy \n        # Ensure the potential goal cell (gx, gy) is within the grid boundaries.\n        if 0 <= gx < grid_width and 0 <= gy < grid_height:\n          goal_cells.add((gx, gy))\n\n  # --- Step 4: Perform Breadth-First Search (BFS) for the shortest path ---\n  # The BFS will find the shortest sequence of movement actions from the agent's\n  # current position to any of the identified 'goal_cells'.\n\n  start_pos = current_state.pos\n  \n  # BFS queue: Stores tuples of (current_position, list_of_actions_taken_to_reach_here).\n  q = collections.deque([(start_pos, [])]) \n  # Set to keep track of visited grid positions to prevent infinite loops and redundant work.\n  visited = {start_pos} \n\n  # Define all possible movement directions (delta X, delta Y) and their corresponding action indices.\n  MOVEMENT_DELTAS_AND_ACTIONS = [\n      ((0, -1), UP),    # Move North (decreases Y-coordinate)\n      ((0, 1), DOWN),   # Move South (increases Y-coordinate)\n      ((-1, 0), LEFT),  # Move West (decreases X-coordinate)\n      ((1, 0), RIGHT),  # Move East (increases X-coordinate)\n  ]\n\n  # Identify impassable terrain. These are entities that the agent cannot move onto.\n  # In CraftWorld, non-grabbable items that are NOT workshops typically block movement.\n  impassable_kinds = set()\n  for idx in env.world.non_grabbable_indices:\n      # Workshops (e.g., WORKSHOP0, WORKSHOP0, WORKSHOP1, WORKSHOP2) are usually traversable,\n      # even though they cannot be picked up. Exclude them from impassable.\n      if idx not in env.world.workshop_indices: \n          impassable_kinds.add(idx)\n\n  while q:\n    # Dequeue the current position and the path leading to it.\n    (cx, cy), path_to_current = q.popleft() \n\n    # If the current position is one of our target goal cells, we've found the shortest path.\n    if (cx, cy) in goal_cells:\n      # Append the 'USE' action to the path and return the complete action sequence.\n      return path_to_current + [USE]\n\n    # Explore all valid neighboring cells from the current position.\n    for (dx, dy), action in MOVEMENT_DELTAS_AND_ACTIONS:\n      nx, ny = cx + dx, cy + dy # Calculate the coordinates of the next potential position.\n      new_pos = (nx, ny)\n\n      # 1. Boundary Check: Ensure the new position is within the grid dimensions.\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue # Skip if the new position is out of bounds.\n\n      # 2. Impassability Check: Determine if the new position contains any impassable entity.\n      is_impassable = False\n      for k_idx in impassable_kinds:\n          # If an impassable kind is present at (nx, ny) with a count > 0, the cell is blocked.\n          if grid[nx, ny, k_idx] > 0: \n              is_impassable = True\n              break # No need to check other impassable kinds for this cell.\n      \n      if is_impassable:\n          continue # Skip this move if the cell is impassable.\n\n      # 3. Visited Check: If the new position has not been visited yet during this BFS.\n      if new_pos not in visited:\n        visited.add(new_pos) # Mark the new position as visited.\n        # Enqueue the new position along with the updated path to reach it.\n        q.append((new_pos, path_to_current + [action]))\n\n  # If the BFS completes (queue becomes empty) and no path to a goal cell was found,\n  # it means the primitive is currently unreachable from the agent's starting position.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T05:51:03.808868", "function_name": "collect", "function_body": "  current_state = env._current_state\n  # Retrieve the integer index corresponding to the primitive name.\n  primitive_idx = env.world.cookbook.index.index(primitive)\n  \n  # --- Improvement for v2: Check if the primitive is already in inventory ---\n  # If the agent's inventory already contains the primitive, there's no need to\n  # move or use actions to collect it. This avoids redundant operations,\n  # leading to more efficient and direct task completion.\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # Get the integer mappings for all possible actions from the environment.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # --- Step 1: Check for immediate collection ---\n  # If the agent is already adjacent to the primitive (within its 3x3 neighborhood),\n  # the most efficient action is simply to 'USE' it.\n  if current_state.next_to(primitive_idx):\n    return [USE]\n\n  # --- Step 2: Locate all occurrences of the primitive on the grid ---\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  # List to store (x, y) coordinates of all cells containing the primitive.\n  primitive_locations_on_grid = [] \n  for x in range(grid_width):\n    for y in range(grid_height):\n      # If the primitive's layer at (x, y) has a value greater than 0, it exists there.\n      if grid[x, y, primitive_idx] > 0:\n        primitive_locations_on_grid.append((x, y))\n\n  # If the primitive is not found anywhere on the map, it's unreachable.\n  if not primitive_locations_on_grid:\n    return []\n\n  # --- Step 3: Determine \"Goal Cells\" for BFS ---\n  # A \"goal cell\" is any grid location from which the agent can apply the 'USE' action\n  # to collect the target primitive. Since 'USE' affects a 3x3 area around the agent,\n  # any cell (gx, gy) that has a primitive (px, py) within its 3x3 neighborhood\n  # is a valid goal cell for the pathfinding BFS.\n  goal_cells = set()\n  for px, py in primitive_locations_on_grid:\n    # Iterate through the 3x3 neighborhood around each primitive instance.\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        gx, gy = px + dx, py + dy \n        # Ensure the potential goal cell (gx, gy) is within the grid boundaries.\n        if 0 <= gx < grid_width and 0 <= gy < grid_height:\n          goal_cells.add((gx, gy))\n\n  # --- Step 4: Perform Breadth-First Search (BFS) for the shortest path ---\n  # The BFS will find the shortest sequence of movement actions from the agent's\n  # current position to any of the identified 'goal_cells'.\n\n  start_pos = current_state.pos\n  \n  # BFS queue: Stores tuples of (current_position, list_of_actions_taken_to_reach_here).\n  q = collections.deque([(start_pos, [])]) \n  # Set to keep track of visited grid positions to prevent infinite loops and redundant work.\n  visited = {start_pos} \n\n  # Define all possible movement directions (delta X, delta Y) and their corresponding action indices.\n  MOVEMENT_DELTAS_AND_ACTIONS = [\n      ((0, -1), UP),    # Move North (decreases Y-coordinate)\n      ((0, 1), DOWN),   # Move South (increases Y-coordinate)\n      ((-1, 0), LEFT),  # Move West (decreases X-coordinate)\n      ((1, 0), RIGHT),  # Move East (increases X-coordinate)\n  ]\n\n  # Identify impassable terrain. These are entities that the agent cannot move onto.\n  # In CraftWorld, non-grabbable items that are NOT workshops typically block movement.\n  impassable_kinds = set()\n  for idx in env.world.non_grabbable_indices:\n      # Workshops (e.g., WORKSHOP0, WORKSHOP1, WORKSHOP2) are usually traversable,\n      # even though they cannot be picked up.\n      if idx not in env.world.workshop_indices: \n          impassable_kinds.add(idx)\n\n  while q:\n    # Dequeue the current position and the path leading to it.\n    (cx, cy), path_to_current = q.popleft() \n\n    # If the current position is one of our target goal cells, we've found the shortest path.\n    if (cx, cy) in goal_cells:\n      # Append the 'USE' action to the path and return the complete action sequence.\n      return path_to_current + [USE]\n\n    # Explore all valid neighboring cells from the current position.\n    for (dx, dy), action in MOVEMENT_DELTAS_AND_ACTIONS:\n      nx, ny = cx + dx, cy + dy # Calculate the coordinates of the next potential position.\n      new_pos = (nx, ny)\n\n      # 1. Boundary Check: Ensure the new position is within the grid dimensions.\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue # Skip if the new position is out of bounds.\n\n      # 2. Impassability Check: Determine if the new position contains any impassable entity.\n      is_impassable = False\n      for k_idx in impassable_kinds:\n          # If an impassable kind is present at (nx, ny) with a count > 0, the cell is blocked.\n          if grid[nx, ny, k_idx] > 0: \n              is_impassable = True\n              break # No need to check other impassable kinds for this cell.\n      \n      if is_impassable:\n          continue # Skip this move if the cell is impassable.\n\n      # 3. Visited Check: If the new position has not been visited yet during this BFS.\n      if new_pos not in visited:\n        visited.add(new_pos) # Mark the new position as visited.\n        # Enqueue the new position along with the updated path to reach it.\n        q.append((new_pos, path_to_current + [action]))\n\n  # If the BFS completes (queue becomes empty) and no path to a goal cell was found,\n  # it means the primitive is currently unreachable from the agent's starting position.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T05:52:23.861216", "function_name": "collect", "function_body": "  current_state = env._current_state\n  \n  # --- 1. Initialize Action Map and Primitive ID ---\n  primitive_idx = env.world.cookbook.index.index(primitive)\n  \n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # --- 2. Early Exit: If primitive is already in inventory ---\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # --- 3. Immediate Collection Check (Agent already adjacent) ---\n  # If the agent is already in a position to collect the primitive (i.e., it's within\n  # the 3x3 neighborhood based on `current_state.next_to`), simply use it.\n  if current_state.next_to(primitive_idx):\n    return [USE]\n\n  # --- 4. Identify all physical locations of the primitive on the grid ---\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  primitive_locations_on_grid = [] \n  for x in range(grid_width):\n    for y in range(grid_height):\n      if grid[x, y, primitive_idx] > 0: # Check if the primitive kind exists at this cell\n        primitive_locations_on_grid.append((x, y))\n\n  # If the primitive is not found anywhere on the grid, it's currently unreachable.\n  if not primitive_locations_on_grid:\n    return []\n\n  # --- 5. Determine \"Goal Cells\" for BFS ---\n  # A \"goal cell\" for the agent's movement is any grid cell from which the 'USE'\n  # action can successfully collect the primitive. This means any cell adjacent to\n  # (or on top of) a primitive's location.\n  collectible_agent_positions = set()\n  for px, py in primitive_locations_on_grid:\n    # Iterate through the 3x3 neighborhood around the primitive's location (px, py)\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        ax, ay = px + dx, py + dy # Candidate agent position\n        # Ensure the candidate agent position is within grid boundaries\n        if 0 <= ax < grid_width and 0 <= ay < grid_height:\n          collectible_agent_positions.add((ax, ay))\n\n  # --- 6. Pre-calculate Impassable Terrain Kinds ---\n  # These are entities that block agent movement. In CraftWorld, these are generally\n  # non-grabbable items that are not designated workshops (which are traversable).\n  impassable_terrain_kinds = set(env.world.non_grabbable_indices) - set(env.world.workshop_indices)\n\n  # --- 7. Perform Breadth-First Search (BFS) for the shortest path ---\n  start_position = current_state.pos\n  \n  # BFS queue: stores current_position (x,y).\n  bfs_queue = collections.deque([(start_position)]) \n  \n  # Dictionary to store the parent of each visited node and the action taken to reach it.\n  # { (x,y): ((parent_x, parent_y), action_from_parent_to_self) }\n  # This allows path reconstruction efficiently by backtracking from the goal.\n  parent_action_map = {start_position: (None, None)} # Parent of start is None, action is None\n\n  # Define possible movement deltas (dx, dy) and their corresponding action indices.\n  MOVE_ACTIONS = [\n      ((0, -1), UP),    # North (decreases Y)\n      ((0, 1), DOWN),   # South (increases Y)\n      ((-1, 0), LEFT),  # West (decreases X)\n      ((1, 0), RIGHT),  # East (increases X)\n  ]\n\n  while bfs_queue:\n    current_x, current_y = bfs_queue.popleft() # Dequeue current position\n    current_pos = (current_x, current_y)\n\n    # If the current agent position is one of the desired \"goal cells\",\n    # we've found the shortest path to a location from which 'USE' can collect.\n    if current_pos in collectible_agent_positions:\n      path_actions = []\n      node = current_pos\n      # Reconstruct path by backtracking from the goal to the start.\n      # The loop stops when 'node' becomes the 'start_position', whose parent is None.\n      while parent_action_map[node][0] is not None: \n        parent, action = parent_action_map[node]\n        path_actions.append(action) # Actions are added in reverse order\n        node = parent\n      \n      path_actions.reverse() # Reverse to get actions in correct order from start to goal\n      return path_actions + [USE] # Add the final USE action to collect\n\n    # Explore all valid neighboring cells for movement.\n    for (dx, dy), action_to_take in MOVE_ACTIONS:\n      next_x, next_y = current_x + dx, current_y + dy # Calculate the new potential position\n      next_position = (next_x, next_y)\n\n      # Check if the new position is within the grid boundaries.\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue # Out of bounds, skip\n\n      # Check if the new position is traversable (not blocked by impassable terrain).\n      is_impassable_location = any(grid[next_x, next_y, k_idx] > 0 for k_idx in impassable_terrain_kinds)\n      \n      if is_impassable_location:\n          continue # Cannot move to this cell, skip\n\n      # If the new position is valid and has not been visited yet, add it to the queue.\n      if next_position not in parent_action_map: # Check if already visited\n        parent_action_map[next_position] = (current_pos, action_to_take) # Store parent and action\n        bfs_queue.append(next_position) # Enqueue for further exploration\n\n  # --- 8. No Path Found ---\n  # If the BFS completes and the queue is empty, it means no path to a collectible\n  # location was found from the current agent state.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T05:52:25.162054", "function_name": "collect", "function_body": "  current_state = env._current_state\n  \n  # --- 1. Initialize Action Map and Primitive ID ---\n  primitive_idx = env.world.cookbook.index.index(primitive)\n  \n  action_map = env.action_specs()\n  USE = action_map['USE']\n\n  # --- 2. Early Exit: If primitive is already in inventory ---\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # --- 3. Immediate Collection Check (Agent already adjacent) ---\n  # If the agent is already in a position to collect the primitive, simply use it.\n  # This relies on `CraftState.next_to` indicating if the primitive is within\n  # the 3x3 neighborhood of the agent's current position, allowing 'USE'.\n  if current_state.next_to(primitive_idx):\n    return [USE]\n\n  # --- 4. Identify all physical locations of the primitive on the grid ---\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  primitive_locations_on_grid = [] \n  for x in range(grid_width):\n    for y in range(grid_height):\n      if grid[x, y, primitive_idx] > 0: # Check if the primitive kind exists at this cell\n        primitive_locations_on_grid.append((x, y))\n\n  # If the primitive is not found anywhere on the grid, it's currently unreachable.\n  if not primitive_locations_on_grid:\n    return []\n\n  # --- 5. Determine \"Goal Cells\" for Pathfinding ---\n  # A \"goal cell\" for the agent's movement is any grid cell from which the 'USE'\n  # action can successfully collect the primitive. Given `CraftState.next_to`\n  # checks the 3x3 neighborhood, any cell adjacent to (or on top of) a primitive's\n  # location is a valid goal cell for the agent's position.\n  collectible_agent_positions = set()\n  for px, py in primitive_locations_on_grid:\n    # Iterate through the 3x3 neighborhood around the primitive's location (px, py)\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        ax, ay = px + dx, py + dy # Candidate agent position\n        # Ensure the candidate agent position is within grid boundaries\n        if 0 <= ax < grid_width and 0 <= ay < grid_height:\n          collectible_agent_positions.add((ax, ay))\n  \n  # If no valid collectible positions are found (e.g., primitive is outside accessible grid),\n  # this is a highly unlikely edge case if primitive_locations_on_grid is not empty and grid bounds are sensible.\n  if not collectible_agent_positions:\n      return []\n\n  # --- 6. Pre-calculate Impassable Terrain Kinds ---\n  # These are entities that block agent movement. In CraftWorld, these are generally\n  # non-grabbable items that are not designated workshops (which are traversable).\n  impassable_terrain_kinds = set(env.world.non_grabbable_indices) - set(env.world.workshop_indices)\n\n  # --- 7. Perform Breadth-First Search (BFS) for the shortest path ---\n  # Define a nested helper function for BFS to improve modularity.\n  def _bfs_find_shortest_path(start_position, goal_set, current_grid, impassable_kinds_set, current_action_map):\n    bfs_queue = collections.deque([(start_position, [])]) \n    visited_positions = {start_position} \n\n    move_actions = [\n        ((0, -1), current_action_map['UP']),\n        ((0, 1), current_action_map['DOWN']),\n        ((-1, 0), current_action_map['LEFT']),\n        ((1, 0), current_action_map['RIGHT']),\n    ]\n\n    while bfs_queue:\n      (current_x, current_y), path_actions = bfs_queue.popleft()\n\n      # If the current position is one of the desired goal cells, we found the path.\n      if (current_x, current_y) in goal_set:\n        return path_actions\n\n      # Explore all valid neighboring cells for movement.\n      for (dx, dy), action_to_take in move_actions:\n        next_x, next_y = current_x + dx, current_y + dy\n        next_position = (next_x, next_y)\n\n        # Check if the new position is within the grid boundaries.\n        if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n          continue\n\n        # Check if the new position is traversable (not blocked by impassable terrain).\n        is_impassable = any(current_grid[next_x, next_y, k_idx] > 0 for k_idx in impassable_kinds_set)\n        if is_impassable:\n            continue\n\n        # If the new position is valid and has not been visited yet, add it to the queue.\n        if next_position not in visited_positions:\n          visited_positions.add(next_position)\n          bfs_queue.append((next_position, path_actions + [action_to_take]))\n    \n    # If the BFS completes and the queue is empty, no path was found.\n    return []\n\n  path_to_primitive = _bfs_find_shortest_path(\n      start_position=current_state.pos,\n      goal_set=collectible_agent_positions,\n      current_grid=grid,\n      impassable_kinds_set=impassable_terrain_kinds,\n      current_action_map=action_map\n  )\n\n  # --- 8. Return Path and USE action ---\n  if path_to_primitive:\n    return path_to_primitive + [USE]\n  else:\n    # No path found to any collectible location.\n    return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T05:53:09.980104", "function_name": "collect", "function_body": "  current_state = env._current_state\n  grid = current_state.grid\n  start_pos = current_state.pos  # Agent's current (row, column) position\n  grid_width, grid_height, _ = grid.shape\n\n  actions = [] # List to store the sequence of actions to be returned.\n\n  # 1. Map the primitive name (string) to its integer ID using the cookbook's index.\n  cookbook = env.world.cookbook\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not found, it cannot be collected.\n    return []\n\n  # 2. Define action constants from the 'craft' module for clarity and direct use.\n  ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = (\n      craft.UP, craft.DOWN, craft.LEFT, craft.RIGHT, craft.USE\n  )\n  \n  # Mapping of (delta_row, delta_column) offsets to the corresponding cardinal movement action.\n  CARDINAL_DIRECTIONS = [\n      (-1, 0, ACTION_UP),    # Move up: decreases row index\n      (1, 0, ACTION_DOWN),   # Move down: increases row index\n      (0, -1, ACTION_LEFT),  # Move left: decreases column index\n      (0, 1, ACTION_RIGHT)   # Move right: increases column index\n  ]\n\n  # Neighborhood offsets for a 3x3 area, including the center (0,0) for grabbable resources.\n  NEIGHBORHOOD_OFFSETS_3x3 = [\n      (dr, dc) for dr in [-1, 0, 1] for dc in [-1, 0, 1]\n  ]\n\n  # 3. Categorize the primitive type based on its properties in CraftWorld.\n  is_grabbable_resource = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n\n  # If the primitive is neither a grabbable resource nor a workshop,\n  # it's likely an uncollectible environmental element or an obstacle.\n  # For such types, 'collect' action is not applicable.\n  if not is_grabbable_resource and not is_workshop:\n      # This includes things like 'BOUNDARY' or static 'STONE' that isn't a gatherable resource.\n      return []\n\n  # 4. Pre-calculate blocking kind indices for `is_passable` function.\n  # These are non-grabbable items that are *not* workshops (as workshops are traversable).\n  blocking_kind_indices = {\n      idx for idx in env.world.non_grabbable_indices\n      if idx not in env.world.workshop_indices\n  }\n  # Water is explicitly considered a blocking element.\n  blocking_kind_indices.add(env.world.water_index) \n\n  # 5. Helper function to determine if a given grid cell (r, c) is traversable by the agent.\n  def is_passable(r, c):\n    # Check if the coordinates are within the defined grid boundaries.\n    if not (0 <= r < grid_width and 0 <= c < grid_height):\n      return False\n    \n    # Check if the cell contains any blocking entity.\n    # The grid stores one-hot encoding for entities at each cell.\n    for k_idx in blocking_kind_indices:\n      if grid[r, c, k_idx] == 1:\n        return False # This cell contains an unpassable obstacle.\n    return True\n\n  # 6. Identify all initial locations on the grid where the target primitive exists.\n  primitive_grid_locations = []\n  for r in range(grid_width):\n    for c in range(grid_height):\n      if grid[r, c, primitive_idx] == 1:\n        primitive_grid_locations.append((r, c))\n\n  if not primitive_grid_locations:\n    # If the primitive is not present anywhere on the current map, it cannot be collected.\n    return []\n\n  # 7. Determine the set of \"target reachable positions\" for the BFS.\n  # These are the traversable cells where the agent needs to be located to interact with the primitive.\n  target_reachable_positions = set()\n  \n  if is_grabbable_resource:\n    # For grabbable resources (e.g., WOOD, STONE), the agent needs to be\n    # in any of the 8 adjacent cells (3x3 neighborhood) around the resource, or on its cell\n    # if it's traversable, to be able to use the 'USE' action to pick it up.\n    for pr, pc in primitive_grid_locations: # For each instance of the primitive\n      for dr, dc in NEIGHBORHOOD_OFFSETS_3x3: # Check all 9 cells around it (including itself)\n        nr, nc = pr + dr, pc + dc # Calculate potential agent standing position\n        if is_passable(nr, nc): # Only add traversable cells to the target set\n          target_reachable_positions.add((nr, nc))\n  elif is_workshop:\n    # For workshops (e.g., WORKSHOP0), the agent needs to move directly *onto* the workshop cell\n    # to use it for crafting. Only add traversable workshop cells.\n    for pr, pc in primitive_grid_locations:\n      if is_passable(pr, pc):\n        target_reachable_positions.add((pr, pc))\n  \n  if not target_reachable_positions:\n    # If no reachable (traversable) target positions are found for the agent to move to, return empty.\n    return []\n\n  # 8. Perform a Breadth-First Search (BFS) to find the shortest path from start_pos\n  #    to any of the target_reachable_positions.\n  q = collections.deque([(start_pos, [])]) # Queue stores (current_position, path_taken_actions_so_far).\n  visited = {start_pos} # Set to keep track of grid cells already processed.\n  \n  path_found_actions = None # This will store the shortest sequence of actions found.\n\n  while q:\n    (curr_r, curr_c), current_path = q.popleft()\n\n    # If the current cell is one of our desired target positions, we have found the shortest path.\n    if (curr_r, curr_c) in target_reachable_positions:\n      path_found_actions = current_path\n      break # Exit BFS as the shortest path to *any* target is found.\n\n    # Explore valid cardinal neighbors (Up, Down, Left, Right).\n    for dr, dc, action_val in CARDINAL_DIRECTIONS:\n      next_r, next_c = curr_r + dr, curr_c + dc # Calculate neighbor coordinates\n      \n      # Check if the neighbor cell is within bounds, has not been visited yet, and is traversable.\n      if (next_r, next_c) not in visited:\n        if is_passable(next_r, next_c):\n          visited.add((next_r, next_c)) # Mark the neighbor as visited.\n          # Add the neighbor to the queue with the updated path.\n          q.append(((next_r, next_c), current_path + [action_val]))\n\n  # 9. Construct the final sequence of actions to return based on the BFS result.\n  if path_found_actions is not None:\n    actions.extend(path_found_actions)\n    # Once the agent reaches the target spot, a 'USE' action is generally required\n    # to collect the resource or interact with the workshop.\n    actions.append(ACTION_USE)\n  \n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T05:53:11.085268", "function_name": "collect", "function_body": "  current_state = env._current_state\n  grid = current_state.grid\n  agent_start_pos = current_state.pos  # Agent's current (row, column) position\n  grid_rows, grid_cols, _ = grid.shape # Grid dimensions (rows, columns)\n\n  # Initialize the list of actions to be returned\n  actions_to_take = []\n\n  # 1. Map the primitive name (string) to its integer ID\n  cookbook = env.world.cookbook\n  primitive_id = cookbook.index.get(primitive) # Use .get() to safely retrieve ID, returns None if not found\n  if primitive_id is None:\n    return [] # Primitive name not found in the environment's index\n\n  # 2. Define action constants from the 'craft' module for clarity\n  ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = (\n      craft.UP, craft.DOWN, craft.LEFT, craft.RIGHT, craft.USE\n  )\n  \n  # Mapping of (delta_row, delta_column) offsets to the corresponding cardinal movement action\n  CARDINAL_MOVE_ACTIONS = {\n      (-1, 0): ACTION_UP,    # Move up: decreases row index\n      (1, 0): ACTION_DOWN,   # Move down: increases row index\n      (0, -1): ACTION_LEFT,  # Move left: decreases column index\n      (0, 1): ACTION_RIGHT   # Move right: increases column index\n  }\n\n  # 3. Determine the interaction type for the primitive based on its category in CraftWorld\n  is_grabbable_item = primitive_id in env.world.grabbable_indices\n  is_workshop_location = primitive_id in env.world.workshop_indices\n\n  # If the primitive is neither a grabbable item nor a workshop, it's likely an\n  # uncollectible environmental element (e.g., a static background \"BOUNDARY\" or \"STONE\"\n  # that isn't gatherable). In such cases, no collection action is possible.\n  if primitive_id in env.world.non_grabbable_indices and not is_workshop_location:\n    return []\n\n  # 4. Define `is_traversable` helper function for BFS pathfinding\n  # A cell is blocked if it contains any non-grabbable item that is NOT a workshop.\n  # This set identifies all indices of entities that block agent movement.\n  blocking_entity_ids = {\n      idx for idx in env.world.non_grabbable_indices\n      if idx not in env.world.workshop_indices # Workshops are generally traversable\n  }\n\n  def is_traversable(r, c):\n    # Check if the coordinates are within the defined grid boundaries.\n    if not (0 <= r < grid_rows and 0 <= c < grid_cols):\n      return False\n    \n    # Check for blocking entities at the current cell (r, c).\n    # If any blocking entity is present, the cell is not traversable.\n    for entity_idx in blocking_entity_ids:\n      if grid[r, c, entity_idx] == 1:\n        return False # This cell contains an impassable obstacle.\n    return True\n\n  # 5. Identify all initial locations on the grid where the target primitive exists.\n  primitive_locations_on_grid = []\n  for r in range(grid_rows):\n    for c in range(grid_cols):\n      if grid[r, c, primitive_id] == 1:\n        primitive_locations_on_grid.append((r, c))\n\n  if not primitive_locations_on_grid:\n    return [] # If the primitive is not present anywhere on the map, it cannot be collected.\n\n  # 6. Determine the set of \"target reachable positions\" for the BFS.\n  # These are the traversable cells where the agent needs to be located to interact with the primitive.\n  bfs_target_positions = set()\n  \n  # Offsets for a 3x3 neighborhood, including the center (0,0), used for grabbable items.\n  NEIGHBORHOOD_3x3_OFFSETS = [\n      (dr, dc) for dr in [-1, 0, 1] for dc in [-1, 0, 1]\n  ]\n\n  if is_grabbable_item:\n    # For grabbable items (e.g., WOOD, STONE), the agent needs to be in any of the\n    # traversable cells in the 3x3 neighborhood around the item to 'USE' it.\n    for prim_r, prim_c in primitive_locations_on_grid:\n      for dr, dc in NEIGHBORHOOD_3x3_OFFSETS:\n        target_r, target_c = prim_r + dr, prim_c + dc\n        if is_traversable(target_r, target_c):\n          bfs_target_positions.add((target_r, target_c))\n  elif is_workshop_location:\n    # For workshops (e.g., WORKSHOP0), the agent typically needs to move directly\n    # *onto* the workshop cell to 'USE' it.\n    for prim_r, prim_c in primitive_locations_on_grid:\n      if is_traversable(prim_r, prim_c): # Only add if the workshop cell itself is traversable\n        bfs_target_positions.add((prim_r, prim_c))\n  \n  if not bfs_target_positions:\n    return [] # If no reachable target positions are found, return an empty action list.\n\n  # 7. Perform a Breadth-First Search (BFS) to find the shortest path from `agent_start_pos`\n  #    to any of the `bfs_target_positions`.\n  \n  # The queue stores tuples of (current_position, path_taken_actions_so_far).\n  q = collections.deque([(agent_start_pos, [])])\n  # The 'visited_positions' set keeps track of grid cells already processed to avoid\n  # cycles and redundant paths, ensuring the shortest path is found.\n  visited_positions = {agent_start_pos}\n  \n  shortest_path_actions = None # This will store the shortest sequence of actions found.\n\n  while q:\n    (curr_r, curr_c), current_path = q.popleft()\n\n    # If the current cell is one of our desired target positions, we have found the shortest path.\n    if (curr_r, curr_c) in bfs_target_positions:\n      shortest_path_actions = current_path\n      break # Exit BFS as the shortest path to *any* target is found.\n\n    # Explore valid cardinal neighbors (Up, Down, Left, Right).\n    for (dr, dc), action_val in CARDINAL_MOVE_ACTIONS.items():\n      next_r, next_c = curr_r + dr, curr_c + dc # Calculate neighbor coordinates\n      \n      # Check if the neighbor cell is within bounds, has not been visited yet, and is traversable.\n      if (next_r, next_c) not in visited_positions:\n        if is_traversable(next_r, next_c):\n          visited_positions.add((next_r, next_c)) # Mark the neighbor as visited.\n          # Add the neighbor to the queue with the updated path.\n          q.append(((next_r, next_c), current_path + [action_val]))\n\n  # 8. Construct the final sequence of actions based on the BFS result.\n  if shortest_path_actions is not None:\n    actions_to_take.extend(shortest_path_actions)\n    # After reaching the target interaction spot, a 'USE' action is typically required\n    # to collect the item or activate the workshop.\n    actions_to_take.append(ACTION_USE)\n  \n  return actions_to_take", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-08-01T05:53:59.935470", "function_name": "collect", "function_body": "  current_state = env._current_state\n  \n  # Get the integer index for the desired primitive.\n  # This will raise a KeyError if the primitive name is not valid.\n  primitive_idx = env.world.cookbook.index.index(primitive)\n  \n  # --- Optimization: Check if the primitive is already collected ---\n  # If the agent's inventory already contains the primitive, no actions are needed\n  # to collect it. This avoids redundant collection attempts.\n  if current_state.inventory[primitive_idx] > 0:\n    return [] # Already have it, return an empty action list.\n\n  # Retrieve action mappings for clarity and to ensure correct action indices are used.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # 1. Immediate collection check:\n  # If the agent is already within the 3x3 neighborhood (including diagonals and its own cell)\n  # of the primitive, it can directly use/collect it.\n  if current_state.next_to(primitive_idx):\n    # This means the agent is in a valid position to interact with the primitive.\n    return [USE]\n\n  # 2. Identify all grid locations where the primitive exists.\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  primitive_locations = []\n  # Iterate through the entire grid to find all cells containing the specified primitive.\n  # Using np.where to find all locations where the primitive's layer has a value > 0\n  primitive_x_coords, primitive_y_coords = np.where(grid[:, :, primitive_idx] > 0)\n  for x, y in zip(primitive_x_coords, primitive_y_coords):\n      primitive_locations.append((x, y))\n\n  # If no instances of the primitive are found on the grid, it's not collectible.\n  if not primitive_locations:\n    return []\n\n  # 3. Define \"goal cells\" for the Breadth-First Search (BFS).\n  # A goal cell is any cell from which the agent can successfully collect the primitive.\n  # Given that `CraftState.next_to` checks the 3x3 neighborhood, any cell in this\n  # 3x3 vicinity of a primitive location is a valid goal.\n  goal_cells = set()\n  for px, py in primitive_locations:\n    # Iterate through all 3x3 neighbors (including (0,0) for the primitive's own cell).\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        gx, gy = px + dx, py + dy\n        # Ensure the potential goal cell is within the grid boundaries.\n        if 0 <= gx < grid_width and 0 <= gy < grid_height:\n          goal_cells.add((gx, gy))\n\n  # 4. Determine which entity kinds make a cell impassable for agent movement.\n  # Impassable kinds are defined as non-grabbable items that are NOT workshops.\n  # Workshops are typically non-grabbable but often walkable/interactable locations.\n  impassable_kinds = list(set(env.world.non_grabbable_indices) - set(env.world.workshop_indices))\n  # Convert to a list for efficient NumPy indexing later.\n\n  # 5. Perform Breadth-First Search (BFS) to find the shortest path\n  # from the agent's current position to any of the identified goal cells.\n  start_pos = current_state.pos\n  \n  # The queue for BFS stores tuples of (current_position, path_taken_actions_to_reach_here).\n  q = collections.deque([(start_pos, [])]) \n  # A set to keep track of visited positions to prevent cycles and redundant exploration.\n  visited = {start_pos} \n\n  # Define possible cardinal moves (delta_x, delta_y) and their corresponding action indices.\n  DELTAS_ACTIONS = [\n      ((0, -1), UP),    # Move North (decreases Y coordinate)\n      ((0, 1), DOWN),   # Move South (increases Y coordinate)\n      ((-1, 0), LEFT),  # Move West (decreases X coordinate)\n      ((1, 0), RIGHT),  # Move East (increases X coordinate)\n  ]\n\n  while q:\n    (cx, cy), path_so_far = q.popleft() # Get the current position and the path to it\n\n    # If the current position is one of our goal cells, we have found the shortest path.\n    if (cx, cy) in goal_cells:\n      # Append the USE action, as the agent is now in a position to collect the primitive.\n      return path_so_far + [USE]\n\n    # Explore valid neighboring cells for movement (cardinal directions).\n    for (dx, dy), action in DELTAS_ACTIONS:\n      nx, ny = cx + dx, cy + dy # Calculate the new potential position\n\n      # Check if the new position is within the overall grid boundaries.\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue # Skip if out of bounds.\n\n      # Check if the new position is traversable (not impassable).\n      # A cell is considered impassable if it contains any of the `impassable_kinds`.\n      # Using NumPy's `any` function for a more efficient check across multiple kinds.\n      is_impassable_cell = False\n      if impassable_kinds: # Only perform check if there are actual impassable kinds\n          is_impassable_cell = np.any(grid[nx, ny, impassable_kinds] > 0)\n      \n      if is_impassable_cell:\n          continue # Skip if the cell is impassable.\n\n      # If the new position is valid and not visited, add it to the queue for exploration.\n      new_pos = (nx, ny)\n      if new_pos not in visited:\n        visited.add(new_pos)\n        q.append((new_pos, path_so_far + [action]))\n\n  # If the BFS completes and the queue becomes empty without finding a path to any goal cell,\n  # it means the primitive is unreachable from the current agent's position.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T05:54:01.166758", "function_name": "collect", "function_body": "  current_state = env._current_state\n  \n  # Get the integer index for the desired primitive.\n  # This relies on the cookbook's index to map the string name to an integer ID.\n  # The `index.index()` method ensures the primitive gets an ID if it's new,\n  # or returns its existing ID.\n  primitive_idx = env.world.cookbook.index.index(primitive)\n  \n  # Optimization from collect_v1: If the agent already has the primitive in its inventory,\n  # no collection actions are needed. Return an empty list of actions.\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # Map action names to their integer IDs for clarity and robust access.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # 1. Immediate Collection Check:\n  # Check if the agent is currently positioned such that the 'USE' action\n  # would successfully collect the primitive. `CraftState.next_to` checks the 3x3 vicinity.\n  if current_state.next_to(primitive_idx):\n    # Agent is in a valid position to collect, so just perform the USE action.\n    return [USE]\n\n  # 2. Locate all instances of the primitive on the current grid.\n  # The grid is a 3D NumPy array: (WIDTH, HEIGHT, n_kinds).\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  primitive_locations = [] # Stores (x, y) coordinates of primitive instances.\n  for x in range(grid_width):\n    for y in range(grid_height):\n      # If the primitive's layer at (x, y) has a count greater than 0, it exists there.\n      if grid[x, y, primitive_idx] > 0:\n        primitive_locations.append((x, y))\n\n  # If no instances of the primitive are found on the grid, it's currently unreachable\n  # or non-existent in the environment.\n  if not primitive_locations:\n    return []\n\n  # 3. Define \"goal cells\" for the pathfinding (Breadth-First Search).\n  # A goal cell is any grid cell from which the agent can use the 'USE' action\n  # to collect the primitive. Given `CraftState.next_to` checks a 3x3 area,\n  # any cell within the 3x3 neighborhood of a primitive's location (including\n  # the primitive's cell itself) is a valid goal cell for movement.\n  goal_cells = set()\n  for px, py in primitive_locations:\n    # Iterate through the 3x3 square centered at (px, py).\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        gx, gy = px + dx, py + dy # Calculate candidate goal cell coordinates.\n        # Ensure the candidate goal cell is within the overall grid boundaries.\n        if 0 <= gx < grid_width and 0 <= gy < grid_height:\n          goal_cells.add((gx, gy))\n\n  # 4. Determine which entity kinds constitute impassable terrain for agent movement.\n  # In CraftWorld, non-grabbable items that are NOT workshops are typically\n  # impassable (e.g., water, stone, boundary walls). Workshops are non-grabbable\n  # but often serve as traversable action locations.\n  impassable_kinds = set(env.world.non_grabbable_indices) - set(env.world.workshop_indices)\n\n  # 5. Perform Breadth-First Search (BFS) to find the shortest sequence of\n  # movement actions from the agent's current position to any of the goal cells.\n  start_pos = current_state.pos\n  \n  # BFS queue: stores tuples of (current_position (tuple), list_of_actions_taken_to_reach_here).\n  q = collections.deque([(start_pos, [])]) \n  # Set of visited positions to avoid cycles and redundant path exploration,\n  # ensuring the shortest path is found for unweighted edges.\n  visited = {start_pos} \n\n  # Define possible cardinal movement deltas and their corresponding action IDs.\n  MOVE_ACTIONS_MAP = [\n      ((0, -1), UP),    # Move North (decreases Y coordinate)\n      ((0, 1), DOWN),   # Move South (increases Y coordinate)\n      ((-1, 0), LEFT),  # Move West (decreases X coordinate)\n      ((1, 0), RIGHT),  # Move East (increases X coordinate)\n  ]\n\n  while q:\n    (cx, cy), path_so_far = q.popleft() # Dequeue the current state.\n\n    # If the current position is one of our goal cells, we've found the shortest path.\n    if (cx, cy) in goal_cells:\n      # The agent is now in a position to collect the primitive, so append the USE action.\n      return path_so_far + [USE]\n\n    # Explore all four cardinal neighbors (up, down, left, right).\n    for (dx, dy), action in MOVE_ACTIONS_MAP:\n      nx, ny = cx + dx, cy + dy # Calculate the next potential position.\n      next_pos = (nx, ny)\n\n      # Check if the next position is within the grid boundaries.\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue # Out of bounds, skip this move.\n\n      # Check if the next position is traversable (not blocked by impassable terrain).\n      is_impassable_cell = False\n      for k_idx in impassable_kinds:\n          # If any impassable kind is present at the next cell, it's blocked.\n          if grid[nx, ny, k_idx] > 0: \n              is_impassable_cell = True\n              break # Found an impassable kind, no need to check others.\n      \n      if is_impassable_cell:\n          continue # Cannot move to this cell, skip this move.\n\n      # If the next position is valid and has not been visited yet, add it to the queue.\n      if next_pos not in visited:\n        visited.add(next_pos)\n        q.append((next_pos, path_so_far + [action]))\n\n  # If the BFS completes and the queue is empty, it means no path to any\n  # collectible primitive location was found from the agent's current position.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T05:55:15.398491", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  \n  # Extract immutable state details required for pathfinding.\n  grid = current_state.grid  # The grid layout (rows, cols, kinds)\n  initial_pos = current_state.pos  # Agent's starting (row, col)\n  initial_dir = current_state.dir  # Agent's starting direction (int: 0=RIGHT, 1=UP, 2=LEFT, 3=DOWN)\n\n  # Get the unique integer ID for the target primitive from the cookbook's index.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Get grid dimensions for boundary checks.\n  num_rows, num_cols, _ = grid.shape\n\n  # Map action names to their integer IDs from the environment's specifications.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define how (row, col) coordinates change when moving forward based on direction.\n  # Key: current_direction_int, Value: (delta_row, delta_column)\n  DIR_TO_DELTA_RC = {\n      0: (0, 1),   # RIGHT: row same, col + 1\n      1: (-1, 0),  # UP: row - 1, col same\n      2: (0, -1),  # LEFT: row same, col - 1\n      3: (1, 0)    # DOWN: row + 1, col same\n  }\n\n  # Define how the agent's direction changes when turning left or right.\n  # Key: current_direction_int, Value: new_direction_int\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Cycle: R -> U -> L -> D -> R\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Cycle: R -> D -> L -> U -> R\n\n  # Get indices of entities that block agent movement. These are cells the agent cannot enter.\n  # This set typically includes boundaries, water, and workshop locations.\n  impassable_kind_indices = current_state.world.non_grabbable_indices\n\n  # Helper function: Checks if a given cell (r, c) is within bounds and can be traversed by the agent.\n  # The agent cannot move into cells containing impassable entities or the primitive itself.\n  def is_traversable(r: int, c: int) -> bool:\n      # 1. Check if the coordinates are within the grid boundaries.\n      if not (0 <= r < num_rows and 0 <= c < num_cols):\n          return False\n      \n      # 2. Check if the cell contains the primitive we are trying to collect.\n      # The agent must be adjacent to the primitive to 'USE' it, not on top of it.\n      if grid[r, c, primitive_id] > 0:\n          return False\n          \n      # 3. Check if the cell contains any impassable (non-grabbable) entities.\n      # This iterates through the list of impassable kinds and checks if any are present in the cell.\n      for kind_idx in impassable_kind_indices:\n          if grid[r, c, kind_idx] > 0:\n              return False\n      \n      return True\n\n  # BFS Initialization:\n  # The queue stores tuples: ((current_position, current_direction), list_of_actions_to_reach_this_state).\n  # Each item in the queue represents a unique agent state (position and orientation)\n  # and the sequence of actions that led to it from the initial state.\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # The 'visited' set stores (position, direction) tuples to prevent cycles and re-exploring\n  # states that have already been processed with a shorter or equal path.\n  visited = {(initial_pos, initial_dir)}\n\n  # This variable will store the actions needed to reach a state where the primitive is directly in front.\n  path_to_target_adjacency = None \n\n  # Perform Breadth-First Search.\n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      r, c = current_pos # Unpack current row and column.\n\n      # Check if the primitive is in the cell immediately in front of the agent.\n      # This is the goal condition: being adjacent to and facing the primitive.\n      delta_r_front, delta_c_front = DIR_TO_DELTA_RC[current_dir]\n      front_r, front_c = r + delta_r_front, c + delta_c_front\n      \n      # If the front cell is within bounds and contains the primitive, we've found our path.\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols) and \\\n         grid[front_r, front_c, primitive_id] > 0:\n          path_to_target_adjacency = path_so_far\n          break # Exit BFS, as the shortest path is found.\n\n      # Explore possible next actions: Move Forward, Turn Left, Turn Right.\n\n      # 1. Try MOVE_FORWARD_ACTION:\n      # Calculate the next position if the agent moves forward. Direction remains unchanged.\n      move_delta_r, move_delta_c = DIR_TO_DELTA_RC[current_dir]\n      next_r, next_c = r + move_delta_r, c + move_delta_c\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change orientation.\n\n      # If the next position is traversable and this (position, direction) state hasn't been visited,\n      # add it to the queue for exploration.\n      if is_traversable(next_r, next_c) and (next_pos, next_dir) not in visited:\n          visited.add((next_pos, next_dir))\n          queue.append(((next_pos, next_dir), path_so_far + [MOVE_FORWARD_ACTION]))\n\n      # 2. Try TURN_LEFT_ACTION:\n      # Calculate the new direction after turning left. Position remains unchanged.\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # If this (position, direction) state hasn't been visited, add it to the queue.\n      if (current_pos, next_dir_left) not in visited:\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_so_far + [TURN_LEFT_ACTION]))\n\n      # 3. Try TURN_RIGHT_ACTION:\n      # Calculate the new direction after turning right. Position remains unchanged.\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # If this (position, direction) state hasn't been visited, add it to the queue.\n      if (current_pos, next_dir_right) not in visited:\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_so_far + [TURN_RIGHT_ACTION]))\n\n  # After BFS completes:\n  # If a path was found to an adjacent-and-facing state, append the 'USE' action.\n  if path_to_target_adjacency is not None:\n      actions_list.extend(path_to_target_adjacency)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T05:55:16.648179", "function_name": "collect", "function_body": "  \"\"\"Returns a list of actions to find and collect the specified primitive from the environment grid.\n  \n    This function implements a Breadth-First Search (BFS) algorithm to find the shortest\n    sequence of actions (movements and turns) required to position the agent directly\n    adjacent to the primitive and facing it, followed by a 'USE' action to collect it.\n\n    The search considers the agent's position and orientation as part of its state to ensure\n    optimal paths that include necessary turns.\n\n    Args:\n        env (env.CraftLab): The CraftLab environment instance, providing access to\n                            the current game state (grid, agent pos/dir, world info).\n        primitive (str): The string name of the primitive item to be collected\n                         (e.g., \"WOOD\", \"STONE\").\n\n    Returns:\n        List[int]: A sequence of integer action codes (e.g., UP, LEFT, USE)\n                   that, when executed, will lead to the collection of the primitive.\n                   Returns an empty list if the primitive is unreachable.\n  \"\"\"\n  # Initialize the list to store the sequence of actions.\n  action_sequence = []\n  \n  # Retrieve the current state of the game from the environment.\n  current_game_state = env._current_state\n  \n  # Extract critical information from the current state for pathfinding.\n  game_grid = current_game_state.grid  # The 3D NumPy array representing the world layout.\n  agent_current_pos = current_game_state.pos  # Tuple (row, col) of the agent's current coordinates.\n  agent_current_dir = current_game_state.dir  # Integer representing the agent's current facing direction.\n\n  # Get the unique integer ID (index) for the target primitive from the cookbook.\n  # This ID is used to locate the primitive type on the grid.\n  primitive_kind_id = current_game_state.world.cookbook.index[primitive]\n  \n  # Determine the dimensions of the game grid for boundary checks.\n  num_grid_rows, num_grid_cols, _ = game_grid.shape\n\n  # Map human-readable action names to their corresponding integer codes as defined by the environment.\n  env_action_map = env.action_specs()\n  ACTION_FORWARD = env_action_map['UP']      # Moves the agent one step forward in its current direction.\n  ACTION_TURN_LEFT = env_action_map['LEFT']   # Rotates the agent 90 degrees counter-clockwise.\n  ACTION_TURN_RIGHT = env_action_map['RIGHT'] # Rotates the agent 90 degrees clockwise.\n  ACTION_USE = env_action_map['USE']          # Interacts with the cell directly in front of the agent.\n\n  # Define how row and column coordinates change when the agent moves forward based on its direction.\n  # This is crucial for calculating the cell directly in front of the agent.\n  DIRECTION_TO_DELTA_RC = {\n      0: (0, 1),   # Facing RIGHT: (delta_row=0, delta_col=+1)\n      1: (-1, 0),  # Facing UP: (delta_row=-1, delta_col=0)\n      2: (0, -1),  # Facing LEFT: (delta_row=0, delta_col=-1)\n      3: (1, 0)    # Facing DOWN: (delta_row=+1, delta_col=0)\n  }\n\n  # Define how the agent's direction changes when performing turn actions.\n  TURN_LEFT_DIRECTION_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # e.g., RIGHT (0) -> UP (1)\n  TURN_RIGHT_DIRECTION_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # e.g., RIGHT (0) -> DOWN (3)\n\n  # Retrieve indices of entity kinds that represent impassable terrain or objects.\n  # The agent cannot walk onto cells containing these kinds.\n  impassable_entity_kind_ids = current_game_state.world.non_grabbable_indices # This is a set\n\n  # Helper function to determine if a specific grid cell (r, c) is traversable by the agent.\n  # A cell is traversable if it's within bounds, does not contain impassable entities,\n  # and does not contain the primitive itself (agent collects from adjacent, not by walking on).\n  def is_cell_traversable(r: int, c: int) -> bool:\n      # Check if the coordinates are within the defined grid boundaries.\n      if not (0 <= r < num_grid_rows and 0 <= c < num_grid_cols):\n          return False\n      \n      # Check if the cell contains any entity that blocks agent movement.\n      for kind_idx in impassable_entity_kind_ids:\n          if game_grid[r, c, kind_idx] > 0: # If this impassable kind is present, it's not traversable.\n              return False\n      \n      # The agent cannot walk directly onto the primitive it wants to collect.\n      # Collection involves moving adjacent and using the 'USE' action.\n      if game_grid[r, c, primitive_kind_id] > 0:\n          return False\n      \n      return True\n\n  # Initialize the BFS queue. Each element is a tuple:\n  # ((current_position_tuple, current_direction_int), list_of_actions_to_reach_this_state)\n  bfs_queue = collections.deque([((agent_current_pos, agent_current_dir), [])])\n  \n  # Initialize the set of visited states to prevent redundant computations and infinite loops.\n  # A state is defined by (position, direction).\n  visited_states = {(agent_current_pos, agent_current_dir)}\n\n  # This variable will store the path (list of actions) once the goal state is found.\n  shortest_path_to_primitive_adj = None \n\n  # Start the Breadth-First Search.\n  while bfs_queue:\n      (current_pos, current_dir), path_so_far = bfs_queue.popleft()\n      current_r, current_c = current_pos # Unpack current row and column.\n\n      # Check if the primitive is in the cell directly in front of the agent from the current state.\n      # This is the immediate pre-collection goal (agent is adjacent and facing the primitive).\n      delta_r_front, delta_c_front = DIRECTION_TO_DELTA_RC[current_dir]\n      front_cell_r, front_cell_c = current_r + delta_r_front, current_c + delta_c_front\n      \n      # Ensure the cell in front is within grid boundaries before checking its content.\n      if (0 <= front_cell_r < num_grid_rows and 0 <= front_cell_c < num_grid_cols):\n          # If the primitive is found directly in front, we have achieved the pre-collection goal.\n          if game_grid[front_cell_r, front_cell_c, primitive_kind_id] > 0:\n              shortest_path_to_primitive_adj = path_so_far # Store the path leading to this state.\n              break # Exit BFS, as the shortest path is found.\n\n      # Explore all possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n\n      # 1. Consider ACTION_FORWARD:\n      # Calculate the next position if the agent moves one step forward.\n      move_delta_r, move_delta_c = DIRECTION_TO_DELTA_RC[current_dir]\n      next_r_forward, next_c_forward = current_r + move_delta_r, current_c + move_delta_c\n      next_pos_forward = (next_r_forward, next_c_forward)\n      next_dir_forward = current_dir # Agent's direction does not change when moving forward.\n\n      # If the next forward position is traversable and this new state (pos, dir) has not been visited:\n      if is_cell_traversable(next_r_forward, next_c_forward) and \\\n         (next_pos_forward, next_dir_forward) not in visited_states:\n          visited_states.add((next_pos_forward, next_dir_forward)) # Mark this state as visited.\n          # Add the new state and the extended path to the queue for further exploration.\n          bfs_queue.append(((next_pos_forward, next_dir_forward), path_so_far + [ACTION_FORWARD]))\n\n      # 2. Consider ACTION_TURN_LEFT:\n      # Calculate the new direction after turning left. Position remains unchanged.\n      next_dir_left = TURN_LEFT_DIRECTION_MAP[current_dir]\n      # If this new state (same position, new direction) has not been visited:\n      if (current_pos, next_dir_left) not in visited_states:\n          visited_states.add((current_pos, next_dir_left)) # Mark as visited.\n          # Add the new state and extended path to the queue.\n          bfs_queue.append(((current_pos, next_dir_left), path_so_far + [ACTION_TURN_LEFT]))\n\n      # 3. Consider ACTION_TURN_RIGHT:\n      # Calculate the new direction after turning right. Position remains unchanged.\n      next_dir_right = TURN_RIGHT_DIRECTION_MAP[current_dir]\n      # If this new state has not been visited:\n      if (current_pos, next_dir_right) not in visited_states:\n          visited_states.add((current_pos, next_dir_right)) # Mark as visited.\n          # Add the new state and extended path to the queue.\n          bfs_queue.append(((current_pos, next_dir_right), path_so_far + [ACTION_TURN_RIGHT]))\n\n  # After the BFS concludes:\n  # If a path was found that leads to the agent being adjacent to and facing the primitive:\n  if shortest_path_to_primitive_adj is not None:\n      action_sequence.extend(shortest_path_to_primitive_adj) # Add all movement/turn actions.\n      action_sequence.append(ACTION_USE) # Append the final 'USE' action to collect the primitive.\n  \n  # Return the complete sequence of actions. If no path was found, action_sequence will be empty.\n  return action_sequence", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T05:55:56.238729", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_agent_pos = current_state.pos  # Agent's initial position (row, col)\n  initial_agent_dir = current_state.dir  # Agent's initial facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook's index.\n  # We assume the 'primitive' string is a valid key in the index.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Determine grid dimensions\n  num_rows, num_cols, _ = initial_grid.shape\n\n  # Retrieve integer action IDs from the environment's action specifications\n  action_map = env.action_specs()\n  MOVE_FORWARD = action_map['UP']    # Corresponds to moving forward in the current direction\n  TURN_LEFT = action_map['LEFT']     # Corresponds to turning 90 degrees left\n  TURN_RIGHT = action_map['RIGHT']   # Corresponds to turning 90 degrees right\n  USE_ITEM = action_map['USE']            # Action to interact with the cell directly in front\n\n  # Direction vectors (dr, dc) for agent's facing direction.\n  # (dr, dc) indicates how row and column change when moving \"forward\".\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # Mapping for updating agent's direction when turning left or right\n  TURN_LEFT_DIR_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # RIGHT -> UP -> LEFT -> DOWN -> RIGHT\n  TURN_RIGHT_DIR_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # RIGHT -> DOWN -> LEFT -> UP -> RIGHT\n\n  # Get indices of entities that block agent movement (e.g., BOUNDARY, WATER, WORKSHOP_X).\n  # These are entities the agent cannot walk onto. Convert the set to a list for efficient NumPy indexing.\n  non_walkable_kinds_indices_list = list(current_state.world.non_grabbable_indices)\n\n  # BFS Initialization:\n  # The queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_to_reach_here)\n  queue = collections.deque([((initial_agent_pos, initial_agent_dir), [])])\n  # The visited set stores (position_tuple, direction_int) to avoid redundant computations and cycles.\n  visited = {(initial_agent_pos, initial_agent_dir)}\n\n  # This variable will store the sequence of actions to reach the state where the primitive is in front.\n  path_to_primitive_adjacent = None \n\n  while queue:\n      (current_pos, current_dir), path_taken = queue.popleft()\n      current_row, current_col = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent from the current state.\n      # If it is, we've found our target \"adjacency\" state.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_cell_row, front_cell_col = current_row + front_dr, current_col + front_dc\n      \n      # Ensure the cell in front is within grid boundaries\n      if (0 <= front_cell_row < num_rows and 0 <= front_cell_col < num_cols):\n          # Check if the primitive is present in this front cell\n          if initial_grid[front_cell_row, front_cell_col, primitive_id] > 0:\n              path_to_primitive_adjacent = path_taken\n              break # Path to adjacency found, no need to explore further from this branch\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right\n\n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_row, next_col = current_row + move_dr, current_col + move_dc\n      next_pos = (next_row, next_col)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if the potential next position is valid and has not been visited with this orientation\n      if (0 <= next_row < num_rows and 0 <= next_col < num_cols and\n          (next_pos, next_dir) not in visited):\n          \n          # Determine if the next cell is walkable.\n          # It's not walkable if it contains any non-grabbable entity (boundary, water, workshop, etc.)\n          # or if it contains the primitive itself (as we need to be adjacent to 'use' it).\n          is_walkable = True\n          \n          # Check if the cell contains any non-walkable entities\n          if non_walkable_kinds_indices_list and np.sum(initial_grid[next_row, next_col, non_walkable_kinds_indices_list]) > 0:\n              is_walkable = False\n          \n          # Agent also cannot walk onto the primitive itself, as it needs to be \"used\" from an adjacent square\n          if is_walkable and initial_grid[next_row, next_col, primitive_id] > 0: \n              is_walkable = False\n\n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_taken + [MOVE_FORWARD]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_DIR_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_taken + [TURN_LEFT]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_DIR_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_taken + [TURN_RIGHT]))\n\n  # If a path to the target adjacency state was found, append the USE action to complete the collection.\n  if path_to_primitive_adjacent is not None:\n      actions_list.extend(path_to_primitive_adjacent)\n      actions_list.append(USE_ITEM)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T05:55:57.368239", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_agent_pos = current_state.pos  # Agent's initial position (row, col)\n  initial_agent_dir = current_state.dir  # Agent's initial facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook's index\n  # This assumes the 'primitive' string is a valid key in the index.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Determine grid dimensions\n  num_rows, num_cols, _ = initial_grid.shape\n\n  # Retrieve integer action IDs from the environment's action specifications\n  action_map = env.action_specs()\n  MOVE_FORWARD = action_map['UP']    # Corresponds to moving forward in the current direction\n  TURN_LEFT = action_map['LEFT']     # Corresponds to turning 90 degrees left\n  TURN_RIGHT = action_map['RIGHT']   # Corresponds to turning 90 degrees right\n  USE_ITEM = action_map['USE']            # Action to interact with the cell directly in front\n\n  # Direction vectors (dr, dc) for agent's facing direction\n  # (dr, dc) indicates how row and column change when moving \"forward\" in a specific direction.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # Mapping for updating agent's direction when turning left or right\n  TURN_LEFT_DIR_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # RIGHT->UP->LEFT->DOWN->RIGHT\n  TURN_RIGHT_DIR_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # RIGHT->DOWN->LEFT->UP->RIGHT\n\n  # Get indices of entities that block agent movement (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  # These are entities the agent cannot walk onto.\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # BFS Initialization:\n  # The queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_to_reach_here)\n  queue = collections.deque([((initial_agent_pos, initial_agent_dir), [])])\n  # The visited set stores (position_tuple, direction_int) to avoid redundant computations and cycles.\n  visited = {(initial_agent_pos, initial_agent_dir)}\n\n  # This variable will store the sequence of actions to reach the state where the primitive is in front.\n  path_to_primitive_adjacent = None \n\n  while queue:\n      (current_pos, current_dir), path_taken = queue.popleft()\n      current_row, current_col = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent from the current state.\n      # If it is, we've found our target \"adjacency\" state.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_cell_row, front_cell_col = current_row + front_dr, current_col + front_dc\n      \n      # Ensure the cell in front is within grid boundaries\n      if (0 <= front_cell_row < num_rows and 0 <= front_cell_col < num_cols):\n          # Check if the primitive is present in this front cell\n          if initial_grid[front_cell_row, front_cell_col, primitive_id] > 0:\n              path_to_primitive_adjacent = path_taken\n              break # Path to adjacency found, no need to explore further from this branch\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right\n\n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_row, next_col = current_row + move_dr, current_col + move_dc\n      next_pos = (next_row, next_col)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if the potential next position is valid and has not been visited with this orientation\n      if (0 <= next_row < num_rows and 0 <= next_col < num_cols and\n          (next_pos, next_dir) not in visited):\n          \n          # Determine if the next cell is walkable.\n          # It's not walkable if it contains any non-grabbable entity (boundary, water, workshop, etc.)\n          # or if it contains the primitive itself (as we need to be adjacent to 'use' it).\n          is_walkable = True\n          for kind_idx in non_walkable_kinds_indices:\n              if initial_grid[next_row, next_col, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          if is_walkable and initial_grid[next_row, next_col, primitive_id] > 0: # Cannot walk onto the primitive itself\n              is_walkable = False\n\n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_taken + [MOVE_FORWARD]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_DIR_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_taken + [TURN_LEFT]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_DIR_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_taken + [TURN_RIGHT]))\n\n  # If a path to the target adjacency state was found, append the USE action to complete the collection.\n  if path_to_primitive_adjacent is not None:\n      actions_list.extend(path_to_primitive_adjacent)\n      actions_list.append(USE_ITEM)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T05:57:14.466588", "function_name": "collect", "function_body": "  primitive_id = env.world.cookbook.index[primitive]\n  if primitive_id is None:\n      return []\n\n  state = env._current_state\n  \n  # If the primitive is already in the inventory, no actions are needed.\n  if state.inventory[primitive_id] > 0:\n      return []\n  \n  current_pos = state.pos # (x, y) or (col, row)\n  grid = state.grid\n  # Grid dimensions based on (WIDTH, HEIGHT, n_kinds)\n  # For a grid of shape (WIDTH, HEIGHT, n_kinds),\n  # grid[x, y] accesses the kinds at column x, row y.\n  width, height, _ = grid.shape # width is number of columns (x), height is number of rows (y)\n\n  actions_map = env.action_specs()\n  ACTION_DOWN = actions_map['DOWN']\n  ACTION_UP = actions_map['UP']\n  ACTION_LEFT = actions_map['LEFT']\n  ACTION_RIGHT = actions_map['RIGHT']\n  ACTION_USE = actions_map['USE']\n\n  # Mapping from CraftState.dir (0=UP, 1=DOWN, 2=LEFT, 3=RIGHT) to (dr, dc) for target cell.\n  # (dr, dc) = (change in row, change in col) relative to agent's current (row, col).\n  # Assuming current_pos (x,y) maps to (col, row) on the grid,\n  # and the BFS state (r,c) represents (row, col).\n  dir_to_delta = {\n      0: (-1, 0), # UP: moves to (row-1, col)\n      1: (1, 0),  # DOWN: moves to (row+1, col)\n      2: (0, -1), # LEFT: moves to (row, col-1)\n      3: (0, 1),  # RIGHT: moves to (row, col+1)\n  }\n\n  # Mapping from a movement action ID to the resulting CraftState.dir ID after taking that action.\n  action_to_resulting_dir_id = {\n      ACTION_UP: 0,\n      ACTION_DOWN: 1,\n      ACTION_LEFT: 2,\n      ACTION_RIGHT: 3,\n  }\n\n  # Define possible movements for BFS exploration.\n  # Each tuple is (dr, dc, action_index) representing relative row/col change and the action.\n  move_options = [\n      (dir_to_delta[0][0], dir_to_delta[0][1], ACTION_UP),    # Move UP\n      (dir_to_delta[1][0], dir_to_delta[1][1], ACTION_DOWN),  # Move DOWN\n      (dir_to_delta[2][0], dir_to_delta[2][1], ACTION_LEFT),  # Move LEFT\n      (dir_to_delta[3][0], dir_to_delta[3][1], ACTION_RIGHT)  # Move RIGHT\n  ]\n\n  # BFS queue: stores tuples of ((row, col), current_dir_id, [list_of_actions_taken_to_reach_this_state])\n  # `current_pos` is (col, row), so convert to (row, col) for consistency with (dr, dc)\n  initial_r, initial_c = current_pos[1], current_pos[0] \n  q = collections.deque([((initial_r, initial_c), state.dir, [])])\n  \n  # Set to keep track of visited states to avoid cycles and redundant paths.\n  # A state is defined by the agent's position ((row, col)) AND its facing direction.\n  visited = {((initial_r, initial_c), state.dir)}\n\n  while q:\n      (r, c), d_id, path_actions = q.popleft()\n\n      # Check if the current state (position and direction) allows for collection.\n      # Calculate the coordinates of the cell directly in front of the agent.\n      fr, fc = r + dir_to_delta[d_id][0], c + dir_to_delta[d_id][1] # (front_row, front_col)\n\n      # If the cell in front (fr, fc) is within grid bounds AND contains the primitive,\n      # then we have found a valid path to collect it.\n      # Note: grid access is grid[col, row], so grid[fc, fr]\n      if (0 <= fr < height and 0 <= fc < width) and grid[fc, fr, primitive_id] > 0:\n          return path_actions + [ACTION_USE] # Append USE action and return the complete sequence.\n\n      # Explore possible next states by taking movement actions (UP, DOWN, LEFT, RIGHT).\n      for dr, dc, action_to_take in move_options:\n          nr, nc = r + dr, c + dc # Calculate new position (new_row, new_col)\n          new_d_id = action_to_resulting_dir_id[action_to_take] # Determine new facing direction\n\n          next_bfs_pos = (nr, nc)\n          next_bfs_state = (next_bfs_pos, new_d_id)\n\n          # Boundary check: Ensure the new position (col, row) is within the grid.\n          # (nc, nr) needs to be within (width, height)\n          if not (0 <= nc < width and 0 <= nr < height):\n              continue\n\n          # Determine if the agent can move to (nc, nr) based on terrain features.\n          is_impassable = False\n          \n          # Rule 1: Cannot move into a cell containing WATER.\n          if grid[nc, nr, env.world.water_index] > 0:\n              is_impassable = True\n          \n          # Rule 2: Cannot move into any non-grabbable item that is not a workshop.\n          # Workshops are typically non-grabbable but traversable.\n          if not is_impassable:\n              for item_id in env.world.non_grabbable_indices:\n                  if item_id == env.world.water_index: # Water is handled by Rule 1, skip\n                      continue\n                  if item_id in env.world.workshop_indices: # Workshops are traversable, skip\n                      continue\n                  \n                  if grid[nc, nr, item_id] > 0: # If the cell contains this non-grabbable, non-workshop item\n                      is_impassable = True\n                      break \n          \n          # Rule 3: Cannot move into any grabbable item (as they are usually collected from adjacent cells).\n          if not is_impassable:\n              for item_id in env.world.grabbable_indices:\n                  if grid[nc, nr, item_id] > 0: # If the cell contains any grabbable item\n                      is_impassable = True\n                      break\n\n          if is_impassable:\n              continue # Cannot move to this cell, try next movement.\n\n          # If the new state (position and direction) has not been visited, add it to the queue.\n          if next_bfs_state not in visited:\n              visited.add(next_bfs_state)\n              q.append((next_bfs_pos, new_d_id, path_actions + [action_to_take]))\n\n  # If the BFS completes and no path to collect the primitive was found.\n  return []", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T05:57:15.590726", "function_name": "collect", "function_body": "  primitive_id = env.world.cookbook.index.get(primitive)\n  if primitive_id is None:\n      # The primitive name was not found in the index.\n      # This indicates an invalid input, so no actions can be generated.\n      return []\n\n  # V2 Improvement: Explicitly check if the primitive is grabbable.\n  # The 'collect' function implies adding the item to inventory.\n  # Non-grabbable items (like WORKSHOPs, WATER, BOUNDARY) cannot be collected into inventory.\n  if primitive_id not in env.world.grabbable_indices:\n      # It's impossible to \"collect\" this primitive type into inventory.\n      return []\n\n  state = env._current_state\n  \n  # If the primitive is already in the inventory, no actions are needed.\n  if state.inventory[primitive_id] > 0:\n      return []\n  \n  current_pos = state.pos\n  grid = state.grid\n  width, height, _ = grid.shape\n\n  actions_map = env.action_specs()\n  ACTION_DOWN = actions_map['DOWN']\n  ACTION_UP = actions_map['UP']\n  ACTION_LEFT = actions_map['LEFT']\n  ACTION_RIGHT = actions_map['RIGHT']\n  ACTION_USE = actions_map['USE']\n\n  # Mapping from CraftState.dir (0=UP, 1=DOWN, 2=LEFT, 3=RIGHT) to (dr, dc)\n  # These deltas indicate the cell directly in front of the agent based on its facing direction.\n  # (dr, dc) = (change in row, change in column)\n  dir_to_delta = {\n      0: (-1, 0), # UP: row-1, col\n      1: (1, 0),  # DOWN: row+1, col\n      2: (0, -1), # LEFT: row, col-1\n      3: (0, 1),  # RIGHT: row, col+1\n  }\n\n  # Mapping from a movement action ID to the resulting CraftState.dir ID after taking that action.\n  action_to_resulting_dir_id = {\n      ACTION_UP: 0,\n      ACTION_DOWN: 1,\n      ACTION_LEFT: 2,\n      ACTION_RIGHT: 3,\n  }\n\n  # Define possible movements (dr, dc, action_index) for BFS exploration.\n  move_deltas = [\n      (dir_to_delta[0][0], dir_to_delta[0][1], ACTION_UP),\n      (dir_to_delta[1][0], dir_to_delta[1][1], ACTION_DOWN),\n      (dir_to_delta[2][0], dir_to_delta[2][1], ACTION_LEFT),\n      (dir_to_delta[3][0], dir_to_delta[3][1], ACTION_RIGHT)\n  ]\n\n  # BFS queue: stores tuples of ((row, col), current_dir_id, [list_of_actions_taken_to_reach_this_state])\n  # `current_dir_id` is crucial because the `USE` action depends on the agent's facing direction.\n  q = collections.deque([(current_pos, state.dir, [])])\n  \n  # Set to keep track of visited states to avoid cycles and redundant paths.\n  # A state in this context is defined by the agent's position AND its facing direction.\n  visited = {(current_pos, state.dir)}\n\n  while q:\n      (r, c), d_id, path_actions = q.popleft()\n\n      # Check if the current state (position and direction) allows for collection.\n      # Calculate the coordinates of the cell directly in front of the agent.\n      fr, fc = r + dir_to_delta[d_id][0], c + dir_to_delta[d_id][1]\n\n      # If the cell in front (fr, fc) is within grid bounds AND contains the primitive,\n      # then we have found a valid path to collect it.\n      # Since we already filtered for grabbable primitives at the start,\n      # we just need to confirm it's in front.\n      if (0 <= fr < width and 0 <= fc < height) and grid[fr, fc, primitive_id] > 0:\n          return path_actions + [ACTION_USE] # Append USE action and return the complete sequence.\n\n      # Explore possible next states by taking movement actions (UP, DOWN, LEFT, RIGHT).\n      for dr, dc, action_to_take in move_deltas:\n          nr, nc = r + dr, c + dc # Calculate new position after attempting movement\n          new_d_id = action_to_resulting_dir_id[action_to_take] # Determine new facing direction\n\n          next_bfs_state = ((nr, nc), new_d_id)\n\n          # Boundary check: Ensure the new position is within the grid.\n          if not (0 <= nr < width and 0 <= nc < height):\n              continue # New position is out of bounds\n\n          # Determine if the agent can move to (nr, nc) based on terrain features.\n          is_impassable = False\n          \n          # Rule 1: Cannot move into a cell containing WATER.\n          if grid[nr, nc, env.world.water_index] > 0:\n              is_impassable = True\n          \n          # Rule 2: Cannot move into any non-grabbable item that is not a workshop.\n          # Workshops are generally traversable (agent can walk onto them).\n          if not is_impassable:\n              for item_id in env.world.non_grabbable_indices:\n                  # Skip water (handled by Rule 1) and workshops (traversable).\n                  if item_id == env.world.water_index or item_id in env.world.workshop_indices:\n                      continue\n                  \n                  # If the cell contains this non-grabbable, non-workshop item, it's impassable.\n                  if grid[nr, nc, item_id] > 0:\n                      is_impassable = True\n                      break\n          \n          # Rule 3: Cannot move into any grabbable item.\n          # Grabbable items (like WOOD, IRON, STONE) are typically collected from an adjacent square,\n          # implying the agent cannot occupy the same cell as the resource.\n          if not is_impassable:\n              for item_id in env.world.grabbable_indices:\n                  # If the cell contains any grabbable item, it's impassable.\n                  if grid[nr, nc, item_id] > 0:\n                      is_impassable = True\n                      break\n\n          if is_impassable:\n              continue # Cannot move to this cell, try next movement.\n\n          # If the new state (position and direction) has not been visited, add it to the queue.\n          if next_bfs_state not in visited:\n              visited.add(next_bfs_state)\n              q.append((next_bfs_state[0], next_bfs_state[1], path_actions + [action_to_take]))\n\n  # If the BFS completes and no path to collect the primitive was found.\n  return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-08-01T05:58:06.302639", "function_name": "collect", "function_body": "  actions = []\n\n  # 1. Get Primitive Index\n  cookbook = env.world.cookbook\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # Primitive name not found in cookbook index, cannot collect\n    return []\n\n  # The 'collect' DSL keyword is intended for grabbable items (resources that go into inventory).\n  # Workshops are interacted with using 'craft', and non-grabbable environment entities (like water, boundary)\n  # cannot be 'collected' in this manner.\n  if primitive_idx not in env.world.grabbable_indices:\n    return []\n\n  # Get current state information\n  current_state = env._current_state\n  current_pos = current_state.pos\n  grid = current_state.grid\n  WIDTH, HEIGHT, _ = grid.shape # Dimensions of the grid\n\n  # Map (dr, dc) for cardinal directions to action constants\n  ACTION_MAP = {\n      (-1, 0): craft.UP,\n      (1, 0): craft.DOWN,\n      (0, -1): craft.LEFT,\n      (0, 1): craft.RIGHT\n  }\n  CARDINAL_DIRECTIONS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n  \n  # Neighborhood offsets for a 3x3 area, including the center (0,0)\n  # This represents all cells within a 3x3 square centered at the agent's position\n  # from which the agent can \"use\" an adjacent or co-located item.\n  NEIGHBORHOOD_OFFSETS = [\n      (dr, dc) for dr in [-1, 0, 1] for dc in [-1, 0, 1]\n  ]\n\n  # Pre-compute indices of all grid features that block agent movement.\n  # This includes water and any other non-grabbable items that are not workshops.\n  # Workshops are considered traversable locations where the agent can stand.\n  all_blocking_indices = {\n      idx for idx in env.world.non_grabbable_indices\n      if idx not in env.world.workshop_indices\n  }\n\n  # Helper function to check if a cell (r, c) is traversable by the agent.\n  def is_traversable(r, c):\n      # Check if coordinates are within grid bounds.\n      if not (0 <= r < WIDTH and 0 <= c < HEIGHT):\n          return False\n\n      # Check for any blocking obstacles at this cell.\n      # If grid[r, c, k_idx] is 1 for any k_idx in all_blocking_indices, it's not traversable.\n      for k_idx in all_blocking_indices:\n          if grid[r, c, k_idx] == 1:\n              return False\n      return True\n\n  # 2. Immediate Collection Check: If agent is already next to the primitive, simply use it.\n  # The `next_to` method checks if the primitive_idx is in the 3x3 neighborhood of the agent.\n  if current_state.next_to(primitive_idx):\n    actions.append(craft.USE)\n    return actions\n\n  # 3. Find all grid locations where the target primitive exists using numpy.where.\n  primitive_rows, primitive_cols = np.where(grid[:, :, primitive_idx] == 1)\n  target_primitive_locations = list(zip(primitive_rows, primitive_cols))\n\n  if not target_primitive_locations:\n    # Primitive not found anywhere on the map\n    return []\n\n  # 4. Identify all \"collectible spots\" (traversable cells where the agent can stand\n  #    to be 'next to' the target primitive and then 'USE' it).\n  collectible_spots = set()\n  for pr, pc in target_primitive_locations:\n    for dr, dc in NEIGHBORHOOD_OFFSETS:\n      nr, nc = pr + dr, pc + dc\n      \n      # If this potential standing spot is traversable, add it to our set of targets for BFS.\n      if is_traversable(nr, nc):\n        collectible_spots.add((nr, nc))\n\n  if not collectible_spots:\n    # No reachable (traversable) spots identified where the agent can be next to the primitive\n    return []\n\n  # 5. Breadth-First Search (BFS) to find the shortest path from the current position\n  #    to any of the identified collectible spots.\n  q = collections.deque([(current_pos, [])]) # Queue stores (position, path_taken_actions)\n  visited = {current_pos} # Set of visited (row, col) tuples to avoid cycles and redundant paths\n  path_found = None\n\n  while q:\n    (r, c), current_path = q.popleft()\n\n    # If the current position is one of the collectible spots, we found the shortest path.\n    if (r, c) in collectible_spots:\n      path_found = current_path\n      break # Found the shortest path, no need to explore further\n\n    # Explore cardinal neighbors (UP, DOWN, LEFT, RIGHT)\n    for dr, dc in CARDINAL_DIRECTIONS:\n      next_r, next_c = r + dr, c + dc\n      \n      # Only explore if the cell hasn't been visited and is traversable\n      if (next_r, next_c) not in visited:\n        if is_traversable(next_r, next_c):\n          visited.add((next_r, next_c))\n          q.append(((next_r, next_c), current_path + [ACTION_MAP[(dr, dc)]]))\n\n  # 6. Construct the final action list\n  if path_found:\n    actions.extend(path_found)\n    actions.append(craft.USE) # Once at the collectible spot, use the item to collect it.\n  \n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T05:58:07.482140", "function_name": "collect", "function_body": "  actions = []\n\n  # 1. Get Primitive Index from the cookbook\n  cookbook = env.world.cookbook\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # Primitive name not found in cookbook index, cannot collect\n    return []\n\n  # The 'collect' DSL keyword is intended for grabbable items (resources that go into inventory).\n  # Workshops are interacted with using 'craft', and water/boundary cannot be collected.\n  # If the primitive is not grabbable, return an empty list as it cannot be \"collected\" this way.\n  if primitive_idx not in env.world.grabbable_indices:\n    return []\n\n  # Get current state information\n  current_state = env._current_state\n  current_pos = current_state.pos\n  grid = current_state.grid\n  WIDTH, HEIGHT, _ = grid.shape # Dimensions of the grid\n\n  # Map (dr, dc) for cardinal directions to action constants\n  ACTION_MAP = {\n      (-1, 0): craft.UP,\n      (1, 0): craft.DOWN,\n      (0, -1): craft.LEFT,\n      (0, 1): craft.RIGHT\n  }\n  CARDINAL_DIRECTIONS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n  \n  # Neighborhood offsets for a 3x3 area, including the center (0,0).\n  # These are used to determine all cells adjacent to a primitive where the agent can stand.\n  NEIGHBORHOOD_OFFSETS = [\n      (dr, dc) for dr in [-1, 0, 1] for dc in [-1, 0, 1]\n  ]\n\n  # Pre-compute indices of grid features that block agent movement.\n  # A cell is blocking if it contains water OR if it contains any non-grabbable item that is NOT a workshop.\n  blocking_kind_indices = {\n      idx for idx in env.world.non_grabbable_indices\n      if idx != env.world.water_index and idx not in env.world.workshop_indices\n  }\n\n  # Helper function to check if a cell (r, c) is traversable by the agent.\n  def is_traversable(r, c):\n      # Check if coordinates are within grid bounds.\n      if not (0 <= r < WIDTH and 0 <= c < HEIGHT):\n          return False\n\n      # Check for water, which is explicitly non-passable.\n      if grid[r, c, env.world.water_index] == 1:\n          return False\n\n      # Check for other blocking obstacles (pre-computed).\n      # If any blocking kind is at this cell, it's not traversable.\n      for k_idx in blocking_kind_indices:\n          if grid[r, c, k_idx] == 1:\n              return False\n      return True\n\n  # 2. Immediate Collection Check: If agent is already next to the primitive, simply use it.\n  # The `next_to` method checks if the primitive_idx is in the 3x3 neighborhood of the agent.\n  if current_state.next_to(primitive_idx):\n    actions.append(craft.USE)\n    return actions\n\n  # 3. Find all grid locations where the target primitive exists.\n  # np.where is an efficient way to find all (row, col) coordinates where the primitive is present.\n  primitive_rows, primitive_cols = np.where(grid[:, :, primitive_idx] == 1)\n  target_primitive_locations = list(zip(primitive_rows, primitive_cols))\n\n  if not target_primitive_locations:\n    # Primitive not found anywhere on the map\n    return []\n\n  # 4. Identify all \"collectible spots\". These are traversable cells where the agent can stand\n  #    to be 'next to' the target primitive (and thus 'USE' it).\n  collectible_spots = set()\n  for pr, pc in target_primitive_locations:\n    for dr, dc in NEIGHBORHOOD_OFFSETS:\n      nr, nc = pr + dr, pc + dc\n      \n      # If this potential standing spot is traversable, add it to our set of targets for BFS.\n      if is_traversable(nr, nc):\n        collectible_spots.add((nr, nc))\n\n  if not collectible_spots:\n    # No reachable (traversable) spots identified where the agent can be next to the primitive.\n    return []\n\n  # 5. Breadth-First Search (BFS) to find the shortest path from the current position\n  #    to any of the identified collectible spots.\n  q = collections.deque([(current_pos, [])]) # Queue stores (position, path_taken_actions)\n  visited = {current_pos} # Set of visited (row, col) tuples to avoid cycles and redundant paths\n  path_found = None\n\n  while q:\n    (r, c), current_path = q.popleft()\n\n    # If the current position is one of the collectible spots, we found the shortest path.\n    if (r, c) in collectible_spots:\n      path_found = current_path\n      break # Found the shortest path, no need to explore further\n\n    # Explore cardinal neighbors (UP, DOWN, LEFT, RIGHT)\n    for dr, dc in CARDINAL_DIRECTIONS:\n      next_r, next_c = r + dr, c + dc\n      \n      # Only explore if the cell hasn't been visited and is traversable\n      if (next_r, next_c) not in visited:\n        if is_traversable(next_r, next_c):\n          visited.add((next_r, next_c))\n          q.append(((next_r, next_c), current_path + [ACTION_MAP[(dr, dc)]]))\n\n  # 6. Construct the final action list.\n  if path_found:\n    actions.extend(path_found)\n    actions.append(craft.USE) # Once at the collectible spot, use the item to collect it.\n  \n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T05:58:56.121091", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  # The queue stores tuples: (CraftState object, list of actions to reach this state).\n  # Storing the CraftState object directly allows us to simulate `state.step()` efficiently.\n  q = collections.deque()\n  # The 'visited' set keeps track of (row, col, direction) tuples to prevent cycles\n  # and re-exploring states already visited via a shorter or equal path.\n  visited = set()\n\n  # Start BFS from the current environment state.\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Set a maximum number of states to explore to prevent excessively long searches\n  # or infinite loops in very complex or unreachable scenarios.\n  # The total number of unique (position, direction) states is `grid_width * grid_height * 4`.\n  # A multiplier is added for robustness, allowing for some redundant state visits if pathfinding is complex.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 3 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # First, check if the desired primitive is located in the 3x3 neighborhood of the agent.\n    # The `next_to` method provides an efficient pre-check.\n    if state.next_to(i_kind):\n        # If the primitive is nearby, iterate through all 4 possible directions the agent could face.\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            # Calculate the coordinates of the cell that would be directly in front of the agent\n            # if it were facing `target_dir` from its current `state.pos`.\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the calculated facing cell is within grid bounds\n            # AND if that specific cell contains an instance of the desired primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # We've found the primitive on the grid and can face it.\n                # Now, crucial step: Simulate the turns and the 'USE' action\n                # to verify if collection is actually successful (e.g., if a tool is needed).\n                \n                # 1. Simulate the turning actions to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    # state.step() returns a *new* CraftState object, ensuring proper simulation.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store the inventory *before* attempting the 'USE' action.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # 2. Simulate the 'USE' action from the state where the agent is facing the primitive.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # 3. Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies that the primitive was successfully collected (e.g., if tools were present and used).\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    # Success! The primitive was collected.\n                    # The complete sequence of actions is:\n                    # (actions to reach current state) + (turning actions) + (USE action to collect).\n                    return path + turns_to_face + [USE_ACT]\n\n    # If the primitive cannot be collected from the current position (either not nearby,\n    # or nearby but not successfully collected), explore possible movement actions.\n    for action in move_actions:\n      # Simulate the action to get the next state without modifying the current environment.\n      # `state.step()` correctly updates position, direction, inventory, and handles collisions.\n      _, next_state = state.step(action)\n\n      # Create a unique key for the `next_state` to check against the `visited` set.\n      # A state is considered unique if its position and direction are different.\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir)\n\n      # If this next state has not been visited before, add it to the queue for exploration.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 6, "scores": {"3": 1.0}}
{"timestamp": "2025-08-01T05:58:57.435778", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  # The queue stores tuples: (CraftState object, list of actions to reach this state).\n  # Storing the CraftState object directly allows us to simulate `state.step()` efficiently.\n  q = collections.deque()\n  # The 'visited' set keeps track of (row, col, direction) tuples to prevent cycles\n  # and re-exploring states already visited via a shorter or equal path.\n  visited = set()\n\n  # Start BFS from the current environment state.\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Set a maximum number of states to explore to prevent excessively long searches\n  # or infinite loops in very complex or unreachable scenarios.\n  # The total number of unique (position, direction) states is `grid_width * grid_height * 4`.\n  # A multiplier is added for robustness, allowing for some redundant state visits if pathfinding is complex.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 3 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # First, check if the desired primitive is located in the 3x3 neighborhood of the agent.\n    # The `next_to` method provides an efficient pre-check.\n    if state.next_to(i_kind):\n        # If the primitive is nearby, iterate through all 4 possible directions the agent could face.\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            # Calculate the coordinates of the cell that would be directly in front of the agent\n            # if it were facing `target_dir` from its current `state.pos`.\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the calculated facing cell is within grid bounds\n            # AND if that specific cell contains an instance of the desired primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # We've found the primitive on the grid and can face it.\n                # Now, crucial step: Simulate the turns and the 'USE' action\n                # to verify if collection is actually successful (e.g., if a tool is needed).\n                \n                # 1. Simulate the turning actions to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    # state.step()