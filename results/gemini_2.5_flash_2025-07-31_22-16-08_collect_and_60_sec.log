{"timestamp": "2025-08-01T13:49:59.278211", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or\n      i_kind == world.water_index or\n      i_kind == world.stone_index\n  )\n\n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  # This prunes the search space for uncollectible primitives early.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n  # For collect_v2, we explore the USE action as a potential state-changing action\n  # at every step, in addition to movement actions.\n  all_possible_actions = move_actions + [USE_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n\n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n\n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set tracks (row, col, direction, inventory_tuple, grid_hash).\n  # Including grid_hash is crucial for states where USE actions change the environment\n  # (e.g., removing obstacles) without changing agent's position/direction/inventory immediately.\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  initial_grid_hash = hash(current_state.grid.tobytes()) # Hash grid for initial state\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple, initial_grid_hash))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Maximum number of unique states to explore. This limit prevents excessive computation\n  # for very large or complex environments where a path might not exist or is too long.\n  # The multiplier is increased to account for the larger state space with grid changes.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 100 # Adjusted multiplier for v2\n\n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop adding new ones.\n    # This acts as a safeguard against overly long searches.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue # Continues processing existing items in queue but won't add new ones\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n\n    # Goal Check: Can we collect the primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`).\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell in front is within grid bounds and contains the primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and\n                state.grid[facing_r, facing_c, i_kind] == 1):\n\n                # Simulate the turning actions to face the primitive.\n                temp_state_after_turns = state\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                for turn_action in turns_to_face:\n                    # _ is reward, which is always 0.0 for step, we only care about new_state\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`).\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore all possible actions (movement and general USE) from the current state.\n    # This is an improvement from v1: USE_ACT is now treated uniformly with movement\n    # actions when generating successor states, allowing more complex interaction paths.\n    current_inventory_tuple = tuple(state.inventory)\n    current_grid_hash = hash(state.grid.tobytes())\n    current_state_key = (state.pos[0], state.pos[1], state.dir, current_inventory_tuple, current_grid_hash)\n\n    for action in all_possible_actions:\n      _, next_state = state.step(action)\n\n      # Generate the unique key for the next state.\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_grid_hash = hash(next_state.grid.tobytes())\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple, next_grid_hash)\n\n      # Add to queue only if the next state is distinct from the current one (i.e., the action had an effect)\n      # AND it has not been visited before.\n      # This handles cases where an action (like moving into a wall or using air) results in no state change.\n      if next_state_key != current_state_key and next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T13:51:03.252661", "function_name": "collect", "function_body": "  \"\"\"Returns a list of actions to find and collect the specified primitive in the passed env.\n    \n    This function implements a Breadth-First Search (BFS) to find the shortest sequence of actions\n    (movements and 'USE' actions) that leads to an increase in the agent's inventory for the given primitive.\n\n    Args:\n        env (env.CraftLab): The CraftLab object representing the current simulation environment.\n        primitive (str): The name of the primitive item to collect (e.g., \"wood\", \"iron\", \"stone\").\n\n    Returns:\n        List[int]: A sequence of action indices (integers) to execute to collect the primitive.\n                   Returns an empty list if the primitive is already collected, not collectible via 'USE',\n                   or no path is found within a reasonable search limit.\n  \"\"\"\n  current_state = env._current_state\n  world = env.world # Access to CraftWorld configuration (cookbook, indices, etc.)\n\n  # 1. Map the primitive name to its integer ID.\n  # If the primitive name is not found in the world's cookbook index, it's an invalid target.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # Primitive name not recognized by the environment.\n    return []\n\n  # 2. Check if the primitive is already present in the agent's inventory.\n  # If the agent already possesses at least one unit of the primitive, no collection is needed.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Determine if the primitive is a type that can be collected using the 'USE' action.\n  # This includes grabbable items (like tools, resources) and specific environmental elements\n  # like \"water\" or \"stone\" which can be gathered. Other items (e.g., workshops, boundaries)\n  # cannot be \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not designed to be collected via 'USE', this function cannot handle it.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action constants and utility mappings.\n  action_map = env.action_specs() # Get integer IDs for actions from the environment.\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the corresponding change in (row, column) coordinates for the cell directly in front.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP (North): Decreases row index\n      1: (0, 1),  # RIGHT (East): Increases column index\n      2: (1, 0),  # DOWN (South): Increases row index\n      3: (0, -1)  # LEFT (West): Decreases column index\n  }\n\n  # Helper function to compute the minimal sequence of turning actions (LEFT/RIGHT)\n  # required to face a `target_dir` from the `current_dir`.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction, no turns needed.\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive result for consistent difference calculation.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., from UP (0) to RIGHT (1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., from UP (0) to LEFT (3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., from UP (0) to DOWN (2))\n          # Two consecutive turns in the same direction (e.g., two rights or two lefts) achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] \n\n  # 5. Initialize Breadth-First Search (BFS) data structures.\n  q = collections.deque() # Queue for BFS, storing (CraftState, list_of_actions_to_reach_state).\n  \n  # 'visited' set: Stores unique states to avoid redundant exploration and cycles.\n  # A state is defined by (row, col, direction, inventory_tuple).\n  # Inventory (numpy.ndarray) must be converted to an immutable tuple to be hashable for the set.\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory) # Convert inventory array to tuple for hashing.\n  q.append((current_state, [])) # Add initial state and an empty path to the queue.\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  # Get grid dimensions for boundary checks.\n  grid_width, grid_height, _ = current_state.grid.shape\n  \n  # MAX_EXPLORED_STATES: A pragmatic limit on the number of states to explore.\n  # This prevents the search from running indefinitely in very complex or unreachable scenarios.\n  # The factor '4' accounts for directions, '10' is a heuristic for different relevant inventory states\n  # (e.g., acquiring a tool during the search might enable new paths).\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 6. BFS Loop: Explore states layer by layer to find the shortest path.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path taken to reach it.\n    explored_states_count += 1\n\n    # Pruning: If too many states have been explored, stop expanding from this path.\n    # This acts as a soft limit, allowing paths already in the queue to be processed,\n    # but preventing further exploration from states beyond a certain search depth/breadth.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the target primitive from the current 'state'?\n    # First, check if the primitive (i_kind) is in any of the 8 cells surrounding the agent (3x3 neighborhood).\n    if state.next_to(i_kind):\n        # If it is, iterate through all four possible directions the agent could face.\n        for target_dir in range(4): # Directions: 0=UP, 1=RIGHT, 2=DOWN, 3=LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc # Calculate coordinates of the cell directly in front.\n\n            # Check if the cell in front is within grid bounds AND contains the target primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # If yes, simulate the actions required to turn and face this primitive.\n                temp_state_after_turns = state \n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                for turn_action in turns_to_face:\n                    # Simulate each turn; reward is always 0.0 in CraftLab, so it's discarded.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store the inventory *before* attempting the 'USE' action.\n                # This is crucial for verifying if the 'USE' action successfully collected the item.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action. This is the action that attempts to collect the primitive.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Verify successful collection: Check if the count of the primitive in inventory actually increased.\n                # This accounts for game mechanics like requiring a specific tool or resource depletion.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    # A path to collect the primitive has been found! Return the full sequence of actions.\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible actions from the current state (if goal not yet reached):\n    # a. Movement actions (UP, DOWN, LEFT, RIGHT).\n    for action in move_actions:\n      # Simulate taking the movement action.\n      _, next_state = state.step(action)\n      \n      # Construct a hashable key for the next state, including position, direction, and inventory.\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      # If this next state has not been visited before, add it to the queue and visited set.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # b. 'USE' action from the current position (even if no primitive is immediately adjacent).\n    # This is important because using certain items (e.g., a workbench, or picking up a tool)\n    # at the current location might change the inventory or environment in a way that\n    # enables future collection steps.\n    inventory_before_any_use = np.copy(state.inventory) # Store inventory before potential USE.\n    _, state_after_current_use = state.step(USE_ACT) # Simulate the USE action.\n    \n    # Check if the 'USE' action actually resulted in a meaningful change to the state.\n    # This prevents adding redundant states to the queue if 'USE' had no effect (e.g., using it in an empty space).\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        # If the state changed, create its key and add to queue/visited if new.\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # If the BFS loop finishes and the queue is exhausted without finding a path to collect the primitive,\n  # it implies that the primitive is currently unreachable or uncollectible from the initial state\n  # under the current game rules and search limits.\n  return []", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T13:51:04.669908", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Map the primitive name (string) to its unique integer ID.\n  # This ID is used to interact with the grid and inventory arrays.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized by the world's index, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If the goal is already satisfied, no actions are needed.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic Check: Verify if this specific primitive is designed to be collected\n  # via the 'USE' action in the game. This typically applies to grabbable items\n  # (like wood, iron, grass) and specific environmental resources (like water, stone).\n  # Items like workshops, boundaries, or crafted items are not directly \"collected\" this way.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the primitive is not a type that can be collected using the 'USE' action,\n  # then this function cannot achieve the goal.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action constants and utility mappings.\n  # These are the integer representations of actions understood by `CraftLab.step()`.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # Map agent's numerical direction (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT) to the\n  # corresponding (row_change, col_change) for the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP (moves North)\n      1: (0, 1),  # RIGHT (moves East)\n      2: (1, 0),  # DOWN (moves South)\n      3: (0, -1)  # LEFT (moves West)\n  }\n\n  # Helper function to compute the minimal sequence of turning actions (LEFT/RIGHT)\n  # required to face a `target_dir` from the `current_dir`.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction.\n      \n      # Calculate the rotational difference, ensuring a positive result for modulo.\n      # `(target_dir - current_dir + 4) % 4` handles both positive and negative differences\n      # and wraps correctly around the 0-3 direction range.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., from UP(0) to RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., from UP(0) to LEFT(3))\n          return [LEFT_ACT]\n      else: # `diff == 2`, implies a 180-degree turn (e.g., UP(0) to DOWN(2)).\n            # This can be achieved with two turns in the same direction.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily use two right turns.\n\n  # 5. Initialize Breadth-First Search (BFS) structures for state exploration.\n  q = collections.deque()\n  # `visited` set stores a hashable representation of states: (row, col, direction, inventory_tuple).\n  # Converting `inventory` (a numpy array) to a tuple makes it hashable, allowing BFS to\n  # distinguish between states that are identical in position/direction but differ due to\n  # changes in inventory (e.g., acquiring a tool, which might enable new interactions).\n  visited = set()\n\n  # Add the initial state to the queue and visited set to start the BFS.\n  # Inventory is converted to a tuple for hashability.\n  initial_inventory_tuple = tuple(current_state.inventory.tolist())\n  q.append((current_state, [])) # Queue stores (CraftState object, list of actions taken to reach this state)\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Set a pragmatic maximum limit on the number of unique states to explore.\n  # This prevents excessively long or infinite searches in complex or unreachable scenarios.\n  # The `* 10` is a heuristic to allow for some variations in inventory states during the search.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 6. BFS Loop: Continuously explore states layer by layer until the goal is found\n  # or all reachable states have been explored.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If the search has exceeded a predefined limit, skip this state.\n    # This acts as a soft timeout, preventing the search from becoming computationally intractable.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue # Continue to the next state in the queue, or terminate if queue becomes empty.\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Determine if the target primitive can be collected from the `state`.\n    # First, check if the primitive exists in the agent's immediate 3x3 neighborhood.\n    if state.next_to(i_kind):\n        # If the primitive is nearby, iterate through all four possible facing directions (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT).\n        for target_dir in range(4): \n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell directly in front (if the agent were facing `target_dir`)\n            # is within grid boundaries and actually contains the target primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # If yes, simulate the actions to turn and face the primitive.\n                temp_state_after_turns = state \n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                for turn_action in turns_to_face:\n                    # `step` returns reward (always 0.0 in this implementation) and the new state.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store the inventory state *before* attempting the 'USE' action.\n                # This is crucial for verifying that the 'USE' action results in an actual collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action. This is the attempt to collect the primitive.\n                # Reward is always 0.0, so it's discarded.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Crucial Validation: Check if the count of the target primitive in the inventory\n                # actually increased after the 'USE' action. This confirms successful collection,\n                # taking into account any underlying game mechanics (e.g., requiring a tool, resource depletion).\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    # A path to collect the primitive has been found! Return the complete sequence of actions.\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible actions from the current state to generate new states for BFS:\n    # 1. Movement actions (UP, DOWN, LEFT, RIGHT).\n    for action in move_actions:\n      # Simulate the movement action. Reward is always 0.0.\n      _, next_state = state.step(action)\n      \n      # Create a hashable key for the `next_state` to track visited states.\n      next_inventory_tuple = tuple(next_state.inventory.tolist())\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      # If this specific state (position, direction, and inventory) has not been visited yet,\n      # add it to the queue for future exploration and mark it as visited.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # 2. Explore the 'USE' action from the current position (without necessarily facing a primitive).\n    # This is important for cases where using an item at the agent's current location (e.g.,\n    # picking up a tool from the ground, or interacting with a workbench to craft an intermediate\n    # item that is then needed to collect the final primitive) changes the inventory or state\n    # in a way that enables further progress towards the goal.\n    inventory_before_current_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if the 'USE' action resulted in a meaningful state change (e.g., inventory change,\n    # or position/direction change if 'USE' also implies movement/teleport - though less common).\n    # This prevents adding redundant states to the queue if 'USE' had no effect (e.g., using USE in empty space).\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_current_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory.tolist())\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # If the BFS loop completes and the queue becomes empty without finding a path\n  # to collect the primitive, it indicates that the primitive is currently unreachable\n  # or uncollectible from the initial state under the current game conditions.\n  return []", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T13:51:38.281464", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos  # (row, col)\n  initial_dir = current_state.dir  # int (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # 1. Input Validation and Early Exits:\n  # Get the integer ID for the primitive from the environment's cookbook index.\n  try:\n      primitive_id = current_state.world.cookbook.index[primitive]\n  except KeyError:\n      # If the primitive name is not recognized, it cannot be collected.\n      return []\n  \n  # Check if the primitive is actually grabbable (can be picked up and added to inventory).\n  # Non-grabbable items (like 'WATER', 'WORKSHOP0') cannot be 'collected' in this manner.\n  if primitive_id not in current_state.world.grabbable_indices:\n      # If the primitive is not grabbable, it's impossible to \"collect\" it.\n      return []\n\n  # Check if the primitive is already in the inventory. If yes, no actions are needed.\n  if current_state.inventory[primitive_id] > 0:\n      return []\n\n  # Get grid dimensions for boundary checks\n  GRID_ROWS, GRID_COLS, _ = initial_grid.shape \n\n  # Map DMLab action names to their integer indices for clarity and use in pathfinding.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP'] # 'UP' action typically means 'move forward' relative to current direction\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define how agent's position changes based on its facing direction\n  # Directions: 0 (Right), 1 (Up), 2 (Left), 3 (Down)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: move to (row, col+1)\n      1: (-1, 0),  # Facing UP: move to (row-1, col)\n      2: (0, -1),  # Facing LEFT: move to (row, col-1)\n      3: (1, 0)    # Facing DOWN: move to (row+1, col)\n  }\n\n  # Maps for updating direction when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # Get indices of entities that cannot be walked upon (e.g., boundaries, water, workshops).\n  # These are considered 'obstacles' for pathfinding.\n  non_walkable_kind_ids = current_state.world.non_grabbable_indices\n\n  # Helper function to determine if a cell at (r_coord, c_coord) is walkable.\n  # A cell is not walkable if it's out of bounds, contains a non-grabbable entity,\n  # or contains the target primitive itself (agent must be adjacent to 'USE' it).\n  def _is_walkable_cell(r_coord: int, c_coord: int) -> bool:\n      # Check grid boundaries\n      if not (0 <= r_coord < GRID_ROWS and 0 <= c_coord < GRID_COLS):\n          return False\n      \n      # Check if cell contains any entity that blocks movement (e.g., boundary, water, workshops)\n      for kind_idx in non_walkable_kind_ids:\n          if initial_grid[r_coord, c_coord, kind_idx] > 0:\n              return False\n      \n      # Agent cannot walk onto the primitive it wants to collect.\n      # It must be adjacent to the primitive to perform the 'USE' action.\n      if initial_grid[r_coord, c_coord, primitive_id] > 0:\n          return False # Don't walk *onto* the primitive.\n\n      return True\n\n  # --- BFS for finding path to an adjacent and facing primitive ---\n  # State in BFS queue: ((current_position_tuple, current_direction_int), list_of_actions_taken)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited states: (position_tuple, direction_int) to avoid cycles and redundant paths.\n  visited = {(initial_pos, initial_dir)}\n\n  path_to_adjacent_primitive = None # Stores the action sequence if found\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # A. Check for Goal Condition: Is the target primitive directly in front of the agent?\n      # Calculate the coordinates of the cell one step forward from the agent's current position and direction.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      target_r, target_c = r + front_dr, c + front_dc\n\n      # Ensure the target cell is within grid boundaries.\n      if (0 <= target_r < GRID_ROWS and 0 <= target_c < GRID_COLS):\n          # Check if the target cell contains the primitive we want to collect.\n          if initial_grid[target_r, target_c, primitive_id] > 0:\n              path_to_adjacent_primitive = path_actions # Found the path to get *adjacent* and *facing* it\n              break # Exit BFS, shortest path found\n\n      # B. Explore possible next actions (Movement and Turns):\n      \n      # 1. Try Move Forward:\n      # Calculate the next position if the agent moves forward (in its current facing direction).\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos_after_move = (next_r, next_c)\n      next_dir_after_move = current_dir # Direction does not change when moving forward\n\n      # Check if this new state (position, direction) is valid and unvisited.\n      if _is_walkable_cell(next_r, next_c):\n          if (next_pos_after_move, next_dir_after_move) not in visited:\n              visited.add((next_pos_after_move, next_dir_after_move))\n              queue.append(( (next_pos_after_move, next_dir_after_move), path_actions + [MOVE_FORWARD_ACTION] ))\n\n      # 2. Try Turn Left:\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(( (current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION] ))\n\n      # 3. Try Turn Right:\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(( (current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION] ))\n\n  # After BFS: If a path to being adjacent and facing the primitive was found,\n  # append the 'USE' action to actually collect it.\n  if path_to_adjacent_primitive is not None:\n      actions_list.extend(path_to_adjacent_primitive)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T13:51:39.474745", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos  # (row, col)\n  initial_dir = current_state.dir  # int (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # 1. Input Validation and Early Exits:\n  # Get the integer ID for the primitive from the environment's cookbook index.\n  try:\n      primitive_id = current_state.world.cookbook.index[primitive]\n  except KeyError:\n      # If the primitive name is not recognized, it cannot be collected.\n      return []\n\n  # Check if the primitive is actually grabbable (can be picked up and added to inventory).\n  # Non-grabbable items (like 'WATER', 'WORKSHOP0') cannot be 'collected' in this manner.\n  if primitive_id not in current_state.world.grabbable_indices:\n      return []\n  \n  # Optimization: If the primitive is already in inventory, no actions are needed.\n  if current_state.inventory[primitive_id] > 0:\n      return []\n\n  # Get grid dimensions for boundary checks\n  GRID_ROWS, GRID_COLS, _ = initial_grid.shape \n\n  # Map DMLab action names to their integer indices for clarity and use in pathfinding.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP'] # 'UP' action typically means 'move forward' relative to current direction\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define how agent's position changes based on its facing direction\n  # Directions: 0 (Right), 1 (Up), 2 (Left), 3 (Down)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (dr, dc) = (0, 1) - column increases\n      1: (-1, 0),  # Facing UP: (dr, dc) = (-1, 0) - row decreases\n      2: (0, -1),  # Facing LEFT: (dr, dc) = (0, -1) - column decreases\n      3: (1, 0)    # Facing DOWN: (dr, dc) = (1, 0) - row increases\n  }\n\n  # Maps for updating direction when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # Get indices of entities that block movement (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  non_walkable_kind_ids = current_state.world.non_grabbable_indices\n\n  # Helper function to determine if a cell at (r_coord, c_coord) is walkable.\n  # A cell is not walkable if it's out of bounds, contains a non-grabbable entity,\n  # or contains the target primitive itself (agent must be adjacent to use it).\n  def _is_walkable_cell(r_coord: int, c_coord: int) -> bool:\n      # Check grid boundaries\n      if not (0 <= r_coord < GRID_ROWS and 0 <= c_coord < GRID_COLS):\n          return False\n      \n      # Check if cell contains any entity that blocks movement (e.g., boundary, water, workshops)\n      for kind_idx in non_walkable_kind_ids:\n          if initial_grid[r_coord, c_coord, kind_idx] > 0:\n              return False\n      \n      # Agent cannot walk onto the primitive it wants to collect.\n      # It must be adjacent to the primitive to perform the 'USE' action.\n      if initial_grid[r_coord, c_coord, primitive_id] > 0:\n          return False\n\n      return True\n\n  # --- BFS for finding path to an adjacent and facing primitive ---\n  # BFS queue: stores ((current_r, current_c), current_dir), list_of_actions_to_reach_here\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set: stores (current_pos_tuple, current_dir_int) to prevent redundant exploration\n  visited = {(initial_pos, initial_dir)}\n\n  path_to_adjacent_primitive = None # To store the path of actions once the target is found\n\n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      r, c = current_pos\n\n      # A. Check for Goal Condition: Is the target primitive directly in front of the agent?\n      # Calculate the coordinates of the cell one step forward from the agent's current position and direction.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the target cell is within grid boundaries.\n      if (0 <= front_r < GRID_ROWS and 0 <= front_c < GRID_COLS):\n          # Check if the target cell contains the primitive we want to collect.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              path_to_adjacent_primitive = path_so_far # Found the path to get *adjacent* and *facing* it\n              break # Exit BFS, shortest path found\n\n      # B. Explore possible next actions (Movement and Turns):\n      \n      # 1. Try Move Forward:\n      # Calculate the next position if the agent moves forward (in its current facing direction).\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos_after_move = (next_r, next_c)\n      next_dir_after_move = current_dir # Direction does not change when moving forward\n\n      # Check if this new state (position, direction) is valid and unvisited.\n      if _is_walkable_cell(next_r, next_c):\n          if (next_pos_after_move, next_dir_after_move) not in visited:\n              visited.add((next_pos_after_move, next_dir_after_move))\n              queue.append(((next_pos_after_move, next_dir_after_move), path_so_far + [MOVE_FORWARD_ACTION]))\n\n      # 2. Try Turn Left:\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_so_far + [TURN_LEFT_ACTION]))\n\n      # 3. Try Turn Right:\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_so_far + [TURN_RIGHT_ACTION]))\n\n  # After BFS: If a path to being adjacent and facing the primitive was found,\n  # append the 'USE' action to actually collect it.\n  if path_to_adjacent_primitive is not None:\n      actions_list.extend(path_to_adjacent_primitive)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T13:52:24.529640", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state # Access the current CraftState from the environment\n\n  # 1. Extract necessary information from the current environment state\n  grid = current_state.grid # The grid layout: numpy.ndarray of shape (WIDTH, HEIGHT, n_kinds)\n  initial_pos = current_state.pos # Agent's current position: (row, col) tuple\n  initial_dir = current_state.dir # Agent's current facing direction: int (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook's index\n  try:\n      primitive_id = current_state.world.cookbook.index[primitive]\n  except KeyError:\n      # If the primitive name is not recognized, it cannot be collected.\n      return [] \n  \n  # Get grid dimensions for boundary checks\n  GRID_WIDTH, GRID_HEIGHT, _ = grid.shape\n\n  # Map symbolic action names to their integer indices as defined by CraftLab\n  action_map = env.action_specs()\n  ACTION_MOVE_FORWARD = action_map['UP'] # 'UP' is often used for moving forward in current direction\n  ACTION_TURN_LEFT = action_map['LEFT']\n  ACTION_TURN_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE'] # The action to perform collection\n\n  # Define movement deltas (dr, dc) for each cardinal direction\n  # Direction indices: 0 (Right), 1 (Up), 2 (Left), 3 (Down)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Right: (row, col + 1)\n      1: (-1, 0),  # Up:    (row - 1, col)\n      2: (0, -1),  # Left:  (row, col - 1)\n      3: (1, 0)    # Down:  (row + 1, col)\n  }\n\n  # Define how direction changes when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}   # R -> U -> L -> D -> R (clockwise for direction value)\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # R -> D -> L -> U -> R (counter-clockwise for direction value)\n\n  # Determine which entity kinds are \"unwalkable\" (obstacles) for the agent.\n  # This includes objects like boundaries, water, workshops, etc.,\n  # and crucially, the primitive itself, as the agent must stand *adjacent* to it.\n  unwalkable_kind_ids = set(current_state.world.non_grabbable_indices)\n  unwalkable_kind_ids.add(primitive_id) # Agent cannot walk ONTO the primitive to collect it.\n\n  # 2. Initialize BFS (Breadth-First Search) structures\n  # Queue stores tuples: ((row, col, direction), [list_of_actions_to_reach_this_state])\n  # The initial state is the agent's current position and direction with an empty action path.\n  queue = collections.deque([((initial_pos[0], initial_pos[1], initial_dir), [])])\n  \n  # Visited set stores (row, col, direction) tuples to prevent revisiting states and cycles.\n  visited = {(initial_pos[0], initial_pos[1], initial_dir)}\n\n  target_pre_use_path = None # This will store the action sequence to reach the state *before* 'USE'\n\n  # 3. BFS Loop: Explore the environment to find the primitive\n  while queue:\n      (r, c, current_dir), path_actions = queue.popleft()\n\n      # Check if the cell directly in front of the agent contains the target primitive.\n      # This is the \"pre-use\" goal state (adjacent and facing the item).\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Validate coordinates and check if the cell contains the primitive\n      if (0 <= front_r < GRID_WIDTH and 0 <= front_c < GRID_HEIGHT and\n          grid[front_r, front_c, primitive_id] > 0):\n          target_pre_use_path = path_actions # Found the path to the desired pre-collection state\n          break # Exit BFS as the shortest path is found\n\n      # Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right\n      \n      # A. Try moving Forward\n      next_r_move, next_c_move = r + DIR_TO_DRDC[current_dir][0], c + DIR_TO_DRDC[current_dir][1]\n      next_dir_move = current_dir # Direction doesn't change when moving forward\n      next_state_move_tuple = (next_r_move, next_c_move, next_dir_move)\n\n      # Check if the next position is within bounds and the state hasn't been visited\n      if (0 <= next_r_move < GRID_WIDTH and 0 <= next_c_move < GRID_HEIGHT and\n          next_state_move_tuple not in visited):\n          \n          # Check if the proposed next position is walkable (i.e., not an obstacle)\n          is_walkable = True\n          for kind_idx in unwalkable_kind_ids:\n              if grid[next_r_move, next_c_move, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          \n          if is_walkable:\n              visited.add(next_state_move_tuple)\n              queue.append((next_state_move_tuple, path_actions + [ACTION_MOVE_FORWARD]))\n\n      # B. Try turning Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      next_state_left_tuple = (r, c, next_dir_left) # Position remains the same\n      if next_state_left_tuple not in visited:\n          visited.add(next_state_left_tuple)\n          queue.append((next_state_left_tuple, path_actions + [ACTION_TURN_LEFT]))\n\n      # C. Try turning Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      next_state_right_tuple = (r, c, next_dir_right) # Position remains the same\n      if next_state_right_tuple not in visited:\n          visited.add(next_state_right_tuple)\n          queue.append((next_state_right_tuple, path_actions + [ACTION_TURN_RIGHT]))\n\n  # 4. Construct the final action sequence\n  if target_pre_use_path is not None:\n      actions_list.extend(target_pre_use_path) # Add all movement/turn actions\n      actions_list.append(ACTION_USE)      # Append the final collection action\n\n  return actions_list", "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T13:52:25.740315", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`. Returns a list of actions to find and collect the primitive in the passed env using BFS.\n  The goal is to navigate the agent to a position *adjacent* to the primitive and *facing* it,\n  then execute the 'USE' action.\n\n    Args:\n        env (env.CraftLab): The CraftLab object containing the current game state.\n        primitive (str): The name of the primitive item to collect (e.g., \"WOOD\", \"STONE\").\n\n    Returns:\n        List[int]: A sequence of integer action IDs to execute. Returns an empty list\n                   if the primitive is not found or is unreachable.\n  \"\"\"\n  actions_sequence = []\n  current_state = env._current_state # Access the current CraftState object from the environment\n\n  # Retrieve essential state information for BFS\n  grid = current_state.grid # The game grid: (WIDTH, HEIGHT, n_kinds) numpy array\n  start_pos = current_state.pos # Agent's current position: (row, col) tuple\n  start_dir = current_state.dir # Agent's current facing direction (int: 0=R, 1=U, 2=L, 3=D)\n\n  # Get the unique integer ID for the target primitive from the cookbook's index\n  # This ID is used to locate the primitive on the grid and in the inventory\n  primitive_idx = current_state.world.cookbook.index[primitive]\n  \n  # Get grid dimensions for bounds checking during BFS\n  GRID_WIDTH, GRID_HEIGHT, _ = grid.shape\n\n  # Map symbolic action names (from CraftLab's action_specs) to their corresponding integer IDs\n  action_map = env.action_specs()\n  ACTION_MOVE_FORWARD = action_map['UP'] # 'UP' is typically used to move the agent forward in its current direction\n  ACTION_TURN_LEFT = action_map['LEFT']\n  ACTION_TURN_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE'] # The action to interact with/collect an item\n\n  # Define how agent's (row, col) position changes when moving forward for each direction\n  # Direction mapping: 0=RIGHT, 1=UP, 2=LEFT, 3=DOWN\n  # (delta_row, delta_col)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: moves to (row, col+1)\n      1: (-1, 0),  # Facing UP:    moves to (row-1, col)\n      2: (0, -1),  # Facing LEFT:  moves to (row, col-1)\n      3: (1, 0)    # Facing DOWN:  moves to (row+1, col)\n  }\n\n  # Define how agent's direction changes when turning left or right\n  # These are cyclic mappings for direction integers (0-3)\n  TURN_LEFT_DIR_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Cycle: Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_DIR_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Cycle: Right -> Down -> Left -> Up -> Right\n\n  # Identify all entity kinds that the agent cannot walk onto.\n  # This includes entities marked as non-grabbable (e.g., boundaries, water, workshops).\n  # Crucially, the `primitive_idx` itself is added here because the agent must\n  # stop *adjacent* to it and face it to use the 'USE' action, not step directly onto its tile.\n  unwalkable_entity_indices = set(current_state.world.non_grabbable_indices)\n  unwalkable_entity_indices.add(primitive_idx) \n\n  # --- BFS (Breadth-First Search) Implementation ---\n  # The queue stores tuples: ((current_row, current_col, current_direction), [list_of_actions_to_reach_this_state])\n  queue = collections.deque([((start_pos[0], start_pos[1], start_dir), [])])\n  \n  # The visited set stores (row, col, direction) tuples to prevent redundant exploration and infinite loops.\n  # This ensures we find the shortest path in terms of number of actions.\n  visited_states = {(start_pos[0], start_pos[1], start_dir)}\n\n  # This variable will store the list of actions to reach the state *just before* executing the 'USE' action.\n  pre_use_actions = None \n\n  # --- BFS Loop ---\n  while queue:\n      (r, c, current_dir), path_to_current_state = queue.popleft()\n\n      # 1. Check for Goal Condition: Is the target primitive directly in front of the agent?\n      # Calculate the coordinates of the cell directly in front of the agent\n      dr_front, dc_front = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + dr_front, c + dc_front\n      \n      # Ensure the \"front\" cell is within the grid boundaries\n      if (0 <= front_r < GRID_WIDTH and 0 <= front_c < GRID_HEIGHT):\n          # Check if the target primitive is present in that cell\n          if grid[front_r, front_c, primitive_idx] > 0:\n              pre_use_actions = path_to_current_state # Found the shortest path to the pre-collection state\n              break # Exit the BFS, as the shortest path to the goal is found\n\n      # 2. Explore Possible Next Actions from the current state: Move Forward, Turn Left, Turn Right\n\n      # --- Try Move Forward ---\n      dr_move, dc_move = DIR_TO_DRDC[current_dir]\n      next_r_move, next_c_move = r + dr_move, c + dc_move\n      next_dir_move = current_dir # Direction does not change when moving\n      next_state_move = (next_r_move, next_c_move, next_dir_move)\n\n      # Check if the potential next position is within bounds and the state hasn't been visited\n      if (0 <= next_r_move < GRID_WIDTH and 0 <= next_c_move < GRID_HEIGHT and\n          next_state_move not in visited_states):\n          \n          # Check if the cell at the potential next position is walkable (i.e., not an obstacle)\n          is_next_pos_walkable = True\n          for kind_idx in unwalkable_entity_indices:\n              # If the target cell contains any unwalkable entity, it's not walkable\n              if grid[next_r_move, next_c_move, kind_idx] > 0:\n                  is_next_pos_walkable = False\n                  break # No need to check other unwalkable kinds if one is found\n          \n          if is_next_pos_walkable:\n              visited_states.add(next_state_move)\n              queue.append((next_state_move, path_to_current_state + [ACTION_MOVE_FORWARD]))\n\n      # --- Try Turning Left ---\n      next_dir_left = TURN_LEFT_DIR_MAP[current_dir]\n      next_state_left = (r, c, next_dir_left) # Position remains the same after turning\n      if (next_state_left not in visited_states):\n          visited_states.add(next_state_left)\n          queue.append((next_state_left, path_to_current_state + [ACTION_TURN_LEFT]))\n\n      # --- Try Turning Right ---\n      next_dir_right = TURN_RIGHT_DIR_MAP[current_dir]\n      next_state_right = (r, c, next_dir_right) # Position remains the same after turning\n      if (next_state_right not in visited_states):\n          visited_states.add(next_state_right)\n          queue.append((next_state_right, path_to_current_state + [ACTION_TURN_RIGHT]))\n\n  # --- Final Action Sequence Construction ---\n  # If a path to the adjacent-and-facing state was found, append the final 'USE' action.\n  # Otherwise, `pre_use_actions` remains None, and an empty list will be returned,\n  # indicating the primitive is not reachable or found.\n  if pre_use_actions is not None:\n      actions_sequence.extend(pre_use_actions) # Add movement/turn actions\n      actions_sequence.append(ACTION_USE)      # Add the collection action\n\n  return actions_sequence", "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T13:53:41.184498", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\"\"\"\n  \"\"\"Returns a list of actions to find and collect the primitive in the passed env.\n    \n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect.\n\n    Returns:\n        List[int]: A sequence of action indices to execute.\n  \"\"\"\n  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  # Convert the primitive name to lowercase to match cookbook's index.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized in the world's index, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If the agent already possesses the item, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that are explicitly defined as grabbable (can be picked up),\n  # or specific environmental resources like \"water\" or \"stone\" which are interacted with via USE.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory\n  # using the 'USE' action in this context.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item cannot be collected using 'USE' action, we do not proceed with a search for it.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1 (North)\n      1: (0, 1),  # RIGHT: col + 1 (East)\n      2: (1, 0),  # DOWN: row + 1 (South)\n      3: (0, -1)  # LEFT: col - 1 (West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # required to change from the current direction to a target direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference in the range [0, 3].\n      diff = (target_dir - current_dir + 4) % 4\n      \n      # Determine the shortest sequence of turns.\n      if diff == 1: # One clockwise turn (e.g., UP -> RIGHT)\n          return [RIGHT_ACT]\n      elif diff == 3: # One counter-clockwise turn (e.g., UP -> LEFT)\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP -> DOWN)\n          # Two consecutive turns in either direction (e.g., RIGHT, RIGHT) will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] \n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set tracks previously explored states to avoid cycles and redundant computation.\n  # A state is defined by (agent_row, agent_col, agent_direction, inventory_tuple).\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing, allowing BFS to distinguish\n  # between states that are identical in position/direction but differ in inventory (e.g., having a tool vs. not).\n  visited = set()\n\n  # Start BFS from the current environment state. The queue stores (CraftState, list_of_actions_to_reach_this_state).\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, [])) # Initial path is empty.\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # MAX_EXPLORED_STATES is a heuristic limit to prevent excessive search in large state spaces.\n  # This value can be tuned based on typical grid sizes and desired performance.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path of actions taken to reach it.\n    explored_states_count += 1\n\n    # Pruning: If the number of explored distinct states exceeds the limit, stop the entire search.\n    # This prevents excessive computation time if the goal is unreachable or requires a very long path.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      return [] # Return an empty list, indicating no path was found within the defined limits.\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # First, check if the target primitive (`i_kind`) is present in the 3x3 neighborhood around the agent.\n    if state.next_to(i_kind):\n        # If it's nearby, iterate through all possible agent orientations to see if one faces the primitive.\n        for target_dir in range(4): \n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell directly in front (after hypothetical turn) contains the target primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # If so, simulate the turning actions required to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    # Apply each turn action to get the state after all turns.\n                    # Reward is ignored as we are pathfinding for collection, not optimizing reward.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify successful collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., needing a tool) implemented within `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    # If collected, return the complete sequence of actions (path to state + turns + USE).\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible actions from the current state:\n    # 1. Movement actions (UP, DOWN, LEFT, RIGHT).\n    for action in move_actions:\n      _, next_state = state.step(action) # CraftState.step returns a new state object.\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action])) # Add new state and extended path to queue.\n    \n    # 2. General 'USE' action from the current position.\n    # This is important if using an item at the current position (e.g., picking up a tool from the ground)\n    # can change the inventory or capabilities, which might be necessary for later steps to collect the primitive.\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if the 'USE' action resulted in a meaningful state change (inventory, position, or direction).\n    # This avoids adding redundant states to the queue if 'USE' had no effect (e.g., using it in an empty space).\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions\n  # within the search limits.\n  return []", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T13:53:42.641572", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  # Convert the primitive name to lowercase to match cookbook's index.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized in the world's index, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If the agent already possesses the item, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that are explicitly defined as grabbable (can be picked up),\n  # or specific environmental resources like \"water\" or \"stone\" which are interacted with via USE.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory\n  # using the 'USE' action in this context.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item cannot be collected using 'USE' action, we do not proceed with a search for it.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1 (North)\n      1: (0, 1),  # RIGHT: col + 1 (East)\n      2: (1, 0),  # DOWN: row + 1 (South)\n      3: (0, -1)  # LEFT: col - 1 (West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # required to change from the current direction to a target direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference in the range [0, 3].\n      diff = (target_dir - current_dir + 4) % 4\n      \n      # Determine the shortest sequence of turns.\n      if diff == 1: # One clockwise turn (e.g., UP -> RIGHT)\n          return [RIGHT_ACT]\n      elif diff == 3: # One counter-clockwise turn (e.g., UP -> LEFT)\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP -> DOWN)\n          # Two consecutive turns in either direction (e.g., RIGHT, RIGHT) will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] \n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set tracks previously explored states to avoid cycles and redundant computation.\n  # A state is defined by (agent_row, agent_col, agent_direction, inventory_tuple).\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing, allowing BFS to distinguish\n  # between states that are identical in position/direction but differ in inventory (e.g., having a tool vs. not).\n  initial_inventory_tuple = tuple(current_state.inventory)\n  visited = set([(current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple)])\n\n  # Start BFS from the current environment state. The queue stores (CraftState, list_of_actions_to_reach_this_state).\n  q.append((current_state, [])) # Initial path is empty.\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # MAX_EXPLORED_STATES is a heuristic limit to prevent excessive search in large state spaces.\n  # This value can be tuned based on typical grid sizes and desired performance.\n  # It's set to cover roughly 10x the physical state space (pos x dir) to account for inventory variations.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path of actions taken to reach it.\n    explored_states_count += 1\n\n    # Pruning: If the total number of explored distinct states exceeds the limit,\n    # it implies that a reasonably short path cannot be found, so we terminate the search.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      return [] # Terminate search and indicate no path found within limits.\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # First, check if the target primitive (`i_kind`) is present in the 3x3 neighborhood around the agent.\n    if state.next_to(i_kind):\n        # If it's nearby, iterate through all possible agent orientations to see if one faces the primitive.\n        for target_dir in range(4): \n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell directly in front (after hypothetical turn) contains the target primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # If so, simulate the turning actions required to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    # Apply each turn action to get the state after all turns.\n                    # Reward is ignored as we are pathfinding for collection, not optimizing reward.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify successful collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., needing a tool) implemented within `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    # If collected, return the complete sequence of actions (path to state + turns + USE).\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible actions from the current state:\n    # 1. Movement actions (UP, DOWN, LEFT, RIGHT).\n    for action in move_actions:\n      _, next_state = state.step(action) # CraftState.step returns a new state object.\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action])) # Add new state and extended path to queue.\n    \n    # 2. General 'USE' action from the current position.\n    # This is important if using an item at the current position (e.g., picking up a tool from the ground)\n    # can change the inventory or capabilities, which might be necessary for later steps to collect the primitive.\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if the 'USE' action resulted in a meaningful state change (inventory, position, or direction).\n    # This avoids adding redundant states to the queue if 'USE' had no effect (e.g., using it in an empty space).\n    # Position and direction do not change for a 'USE' action, so only inventory needs comparison.\n    if not np.array_equal(state_after_current_use.inventory, inventory_before_any_use):\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions\n  # within the search limits.\n  return []", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T13:54:40.320543", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`. Finds the shortest path to a primitive and collects it.\n  \n  This function uses Breadth-First Search (BFS) to navigate the grid environment.\n  It explores possible movements (forward, turn left, turn right) to find a path\n  that leads the agent to a position adjacent to the target primitive, facing it.\n  Once such a state is found, a 'USE' action is appended to the path to collect the primitive.\n\n  Args:\n      env (env.CraftLab): The CraftLab object representing the current simulation environment.\n      primitive (str): The string name of the primitive item to be collected (e.g., \"WOOD\", \"STONE\").\n\n  Returns:\n      List[int]: A sequence of integer action codes (e.g., [UP, LEFT, USE])\n                 that, when executed, lead to the collection of the specified primitive.\n                 Returns an empty list if the primitive is unreachable or not found.\n  \"\"\"\n  # Retrieve the current state of the environment.\n  state = env._current_state\n  \n  # Extract relevant information from the current state for pathfinding.\n  grid = state.grid  # The current grid layout, a 3D NumPy array.\n  agent_pos = state.pos  # Agent's current position (row, column tuple).\n  agent_dir = state.dir  # Agent's current facing direction (int: 0=RIGHT, 1=UP, 2=LEFT, 3=DOWN).\n\n  # Get the integer ID for the target primitive from the environment's cookbook index.\n  primitive_id = state.world.cookbook.index[primitive]\n  \n  # Determine grid dimensions for boundary checks.\n  num_rows, num_cols, _ = grid.shape\n\n  # Map string action names to their corresponding integer codes for execution.\n  action_map = env.action_specs()\n  ACTION_MOVE_FORWARD = action_map['UP']\n  ACTION_TURN_LEFT = action_map['LEFT']\n  ACTION_TURN_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define changes in (row, column) for each facing direction when moving forward.\n  # This helps calculate the next position based on current direction.\n  DIRECTION_TO_DRDC = {\n      0: (0, 1),   # RIGHT: (row, col+1)\n      1: (-1, 0),  # UP:    (row-1, col)\n      2: (0, -1),  # LEFT:  (row, col-1)\n      3: (1, 0)    # DOWN:  (row+1, col)\n  }\n\n  # Define how agent's direction changes when turning left or right.\n  # Directions are cyclic (e.g., turning left from UP leads to LEFT).\n  TURN_LEFT_DIR_MAP = {0: 1, 1: 2, 2: 3, 3: 0} # RIGHT -> UP -> LEFT -> DOWN -> RIGHT\n  TURN_RIGHT_DIR_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # RIGHT -> DOWN -> LEFT -> UP -> RIGHT\n\n  # Get the set of entity indices that the agent cannot walk over or occupy.\n  # These include boundaries, water, and workshops, as defined in the CraftWorld.\n  # Convert to a list for efficient indexing with NumPy.\n  non_walkable_kind_ids = list(state.world.non_grabbable_indices)\n\n  # Helper function to check if a given grid cell (r, c) is a valid and walkable location for the agent.\n  def is_cell_walkable(r: int, c: int) -> bool:\n      # 1. Check if the cell is within the grid boundaries.\n      if not (0 <= r < num_rows and 0 <= c < num_cols):\n          return False\n      \n      # 2. Check if the cell contains the target primitive.\n      # The agent cannot walk onto the primitive itself; it must be collected from an adjacent cell.\n      if grid[r, c, primitive_id] > 0:\n          return False\n          \n      # 3. Check if the cell contains any non-walkable environmental features.\n      # If there are any non-walkable entities at (r,c), the agent cannot move to this cell.\n      # np.any is used for clarity over np.sum > 0 for boolean checks.\n      if non_walkable_kind_ids and np.any(grid[r, c, non_walkable_kind_ids] > 0):\n          return False\n          \n      return True\n\n  # Initialize BFS data structures:\n  # `queue`: Stores tuples of `((position, direction), path_taken_to_reach_here)`.\n  #          This allows us to reconstruct the path once the target is found.\n  # `visited`: Stores `(position, direction)` tuples to keep track of explored states\n  #            and prevent redundant computations or infinite loops.\n  queue = collections.deque([((agent_pos, agent_dir), [])])\n  visited = {(agent_pos, agent_dir)}\n\n  # This variable will store the final sequence of actions to be returned.\n  actions_to_primitive = []\n\n  # Start BFS.\n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      r, c = current_pos\n\n      # Check if the primitive is directly in front of the agent from the current state.\n      # This is the goal state for BFS: being in a position to 'USE' the primitive.\n      dr_front, dc_front = DIRECTION_TO_DRDC[current_dir]\n      front_r, front_c = r + dr_front, c + dc_front\n      \n      # Ensure the 'front' cell is within bounds before checking its contents.\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n          if grid[front_r, front_c, primitive_id] > 0:\n              # Goal achieved: agent is adjacent to and facing the primitive.\n              # Append the 'USE' action to the path and return.\n              actions_to_primitive.extend(path_so_far)\n              actions_to_primitive.append(ACTION_USE)\n              return actions_to_primitive # Path found, exit the function.\n\n      # Explore next possible states by applying allowed actions:\n\n      # 1. Try moving forward:\n      move_dr, move_dc = DIRECTION_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos_move = (next_r, next_c)\n      next_dir_move = current_dir # Direction doesn't change when moving forward.\n\n      if is_cell_walkable(next_r, next_c) and (next_pos_move, next_dir_move) not in visited:\n          visited.add((next_pos_move, next_dir_move))\n          queue.append(((next_pos_move, next_dir_move), path_so_far + [ACTION_MOVE_FORWARD]))\n\n      # 2. Try turning left:\n      next_dir_left = TURN_LEFT_DIR_MAP[current_dir]\n      # Position remains the same when turning.\n      if (current_pos, next_dir_left) not in visited:\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_so_far + [ACTION_TURN_LEFT]))\n\n      # 3. Try turning right:\n      next_dir_right = TURN_RIGHT_DIR_MAP[current_dir]\n      # Position remains the same when turning.\n      if (current_pos, next_dir_right) not in visited:\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_so_far + [ACTION_TURN_RIGHT]))\n\n  # If the queue becomes empty and the target primitive was not found,\n  # it means the primitive is unreachable from the current state.\n  return [] # Return an empty list indicating no path found.", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T13:54:41.540800", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos  # Agent's initial position (row, col)\n  initial_dir = current_state.dir  # Agent's initial facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Retrieve the integer ID for the target primitive from the cookbook's index.\n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  # Get grid dimensions: num_rows corresponds to grid.shape[0], num_cols to grid.shape[1].\n  num_rows, num_cols, _ = initial_grid.shape\n\n  # Retrieve numerical action codes from the environment's action_specs for clarity and consistency.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # Action to move forward in the current direction.\n  TURN_LEFT_ACTION = action_map['LEFT']     # Action to turn 90 degrees left.\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Action to turn 90 degrees right.\n  USE_ACTION = action_map['USE']            # Action to interact with (collect) the item in the cell directly in front.\n\n  # Define how movement changes row/column based on the agent's current direction.\n  # This mapping specifies (delta_row, delta_column) for moving \"forward\" given the agent's direction.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: moves to (row, col+1)\n      1: (-1, 0),  # Facing UP: moves to (row-1, col)\n      2: (0, -1),  # Facing LEFT: moves to (row, col-1)\n      3: (1, 0)    # Facing DOWN: moves to (row+1, col)\n  }\n\n  # Define how turns update the agent's direction. Directions wrap around.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # RIGHT(0)->UP(1)->LEFT(2)->DOWN(3)->RIGHT(0)\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # RIGHT(0)->DOWN(3)->LEFT(2)->UP(1)->RIGHT(0)\n\n  # Get indices of entities that block agent movement (e.g., BOUNDARY, WATER, WORKSHOP locations).\n  # These are entities the agent cannot occupy a cell with. Convert to a list for efficient NumPy indexing.\n  non_walkable_kinds_indices = list(current_state.world.non_grabbable_indices)\n\n  # Helper function to determine if a specific grid cell (r, c) is traversable by the agent.\n  # A cell is walkable if it's within bounds and does not contain any non-walkable entities,\n  # nor the primitive itself (as collection is done from an adjacent cell via 'USE').\n  def is_valid_and_walkable_cell(r: int, c: int) -> bool:\n      # Check if coordinates are within the grid boundaries.\n      if not (0 <= r < num_rows and 0 <= c < num_cols):\n          return False\n      \n      # The agent cannot move *into* the cell occupied by the primitive it wants to collect.\n      # Collection (via 'USE' action) happens from an adjacent cell.\n      if initial_grid[r, c, primitive_id] > 0:\n          return False\n          \n      # Check if the cell contains any entity that explicitly blocks agent movement.\n      # This includes boundaries, water, and static workshop locations.\n      # If the sum of counts for non-walkable kinds in this cell is greater than 0, it's blocked.\n      if non_walkable_kinds_indices and np.sum(initial_grid[r, c, non_walkable_kinds_indices]) > 0:\n          return False\n          \n      return True\n\n  # Initialize Breadth-First Search (BFS) to find the shortest path.\n  # The queue stores tuples: ((agent_position_tuple, agent_direction_int), list_of_actions_taken_so_far).\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # The visited set stores (agent_position_tuple, agent_direction_int) tuples.\n  # This prevents re-exploring states already visited, ensuring the shortest path is found.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the optimal action sequence to reach the pre-collection state.\n\n  # Begin BFS traversal.\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Goal Check: Determine if the primitive is directly in front of the agent from the current state.\n      # This is the target condition: being adjacent to and facing the primitive, ready to 'USE'.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the cell in front is within grid boundaries before checking its contents.\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n          # If the primitive is present in the cell directly in front, we have found our target state.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Shortest path found, exit the BFS loop.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n\n      # Try Moving Forward (Action: MOVE_FORWARD_ACTION)\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Direction remains unchanged when moving forward.\n\n      # If the next cell is walkable and this specific (position, direction) state has not been visited,\n      # add it to the queue for future exploration.\n      if is_valid_and_walkable_cell(next_r, next_c) and (next_pos, next_dir) not in visited:\n          visited.add((next_pos, next_dir))\n          queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turning Left (Action: TURN_LEFT_ACTION)\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Position does not change when turning.\n      if (current_pos, next_dir_left) not in visited:\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turning Right (Action: TURN_RIGHT_ACTION)\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Position does not change when turning.\n      if (current_pos, next_dir_right) not in visited:\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path to the target pre-collection state was found (i.e., target_path is not None),\n  # append the final 'USE' action to complete the collection process.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION) # Add the crucial 'USE' action to collect the primitive.\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T13:55:28.748864", "function_name": "collect", "function_body": "  \"\"\"Returns a list of actions to find and collect the primitive in the passed env.\n    \n    This function uses Breadth-First Search (BFS) to find the shortest path\n    to a location adjacent to the target primitive, where the agent is facing it.\n    Once such a position is reached, a 'USE' action is appended to the sequence.\n\n    Args:\n        env (env.CraftLab): The CraftLab object representing the current state of the environment.\n        primitive (str): The string name of the primitive resource or object to collect\n                         (e.g., \"WOOD\", \"WORKSHOP0\", \"STONE\").\n\n    Returns:\n        List[int]: A sequence of integer action IDs (as defined by env.action_specs())\n                   to execute. Returns an empty list if the primitive is not found\n                   in the environment or is unreachable.\n  \"\"\"\n  actions_list = []\n  \n  # Access the internal CraftState object which holds the current grid, position, and inventory.\n  current_state = env._current_state \n\n  # Extract essential information for pathfinding from the current state.\n  grid = current_state.grid  # The current grid layout (WIDTH, HEIGHT, n_kinds)\n  initial_pos = current_state.pos    # Agent's current (row, col) position on the grid.\n  initial_dir = current_state.dir    # Agent's current facing direction (0:Right, 1:Up, 2:Left, 3:Down).\n\n  # Get the integer ID for the target primitive from the cookbook index.\n  # If the primitive name is not recognized, it cannot be collected.\n  try:\n      primitive_id = current_state.world.cookbook.index[primitive]\n  except KeyError:\n      return []\n\n  # Get grid dimensions for boundary checks during pathfinding.\n  GRID_WIDTH, GRID_HEIGHT, _ = grid.shape \n\n  # Map action names (from DSL) to their integer indices (used by env.step).\n  action_map = env.action_specs()\n  ACTION_MOVE_FORWARD = action_map['UP'] # Corresponds to moving one step in the current direction\n  ACTION_TURN_LEFT = action_map['LEFT']\n  ACTION_TURN_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Pre-defined changes in (row, col) coordinates for each direction.\n  # This helps calculate the cell in front of the agent or the next position after moving.\n  # Directions: 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: +1 to column (x-axis)\n      1: (-1, 0),  # Facing UP: -1 to row (y-axis)\n      2: (0, -1),  # Facing LEFT: -1 to column (x-axis)\n      3: (1, 0)    # Facing DOWN: +1 to row (y-axis)\n  }\n\n  # Set of entity kind IDs that represent non-walkable terrain (e.g., BOUNDARY, WATER, WORKSHOP_X).\n  # These are general obstacles the agent cannot walk through.\n  non_walkable_kind_ids = current_state.world.non_grabbable_indices\n\n  # Helper function to determine if a cell at (r, c) is a valid and walkable location for the agent.\n  def _is_walkable_cell(r, c):\n      \"\"\"Checks if the given grid cell (r, c) is within bounds and does not contain\n      any blocking entities or the primitive itself (as agent needs to be adjacent to use).\"\"\"\n      # 1. Check if the cell is within the grid boundaries.\n      if not (0 <= r < GRID_WIDTH and 0 <= c < GRID_HEIGHT):\n          return False\n\n      # 2. Check if the cell contains any non-grabbable entity that blocks movement.\n      for kind_idx in non_walkable_kind_ids:\n          if grid[r, c, kind_idx] > 0:\n              return False\n      \n      # 3. Agent cannot walk directly *onto* the primitive it intends to collect.\n      # It must be adjacent to use it. If the primitive is on this cell, it's not walkable.\n      if grid[r, c, primitive_id] > 0:\n          return False\n      \n      return True\n\n  # --- Pre-compute all valid target agent states ---\n  # A \"target agent state\" is a combination of (agent_position, agent_direction)\n  # from which the agent can execute the 'USE' action to collect the primitive.\n  # This means the agent is one step away from the primitive and facing it.\n  target_agent_states = set()\n\n  # 1. Find all grid locations where the target primitive exists.\n  # np.argwhere returns an array of (row, col) coordinates.\n  primitive_locations = np.argwhere(grid[:, :, primitive_id] > 0)\n\n  # 2. For each primitive location, determine all possible agent states (pos, dir)\n  # from which that primitive could be collected.\n  for prim_r, prim_c in primitive_locations:\n      # Iterate through all 4 possible directions the agent could be facing to collect it.\n      for agent_dir_candidate in range(4):\n          # Determine the (dr, dc) that represents 'forward' for this agent_dir_candidate.\n          # This is the direction *from* the agent *to* the primitive.\n          dr, dc = DIR_TO_DRDC[agent_dir_candidate]\n\n          # The agent's position (agent_r, agent_c) must be such that\n          # if the agent moves (dr, dc) from (agent_r, agent_c), it lands on (prim_r, prim_c).\n          # Therefore, (agent_r, agent_c) = (prim_r - dr, prim_c - dc).\n          agent_r_candidate, agent_c_candidate = prim_r - dr, prim_c - dc\n          \n          # Check if this calculated candidate agent position is a valid and walkable cell.\n          # If it is, then this (position, direction) pair is a valid target state.\n          if _is_walkable_cell(agent_r_candidate, agent_c_candidate):\n              target_agent_states.add(((agent_r_candidate, agent_c_candidate), agent_dir_candidate))\n              \n  # If no primitive locations are found or all adjacent positions are unreachable,\n  # the target_agent_states set will be empty. In this case, no path can be found.\n  if not target_agent_states:\n      return []\n\n  # BFS Initialization:\n  # Queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_here).\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # Visited set stores (position_tuple, direction_int) to avoid redundant exploration\n  # and ensure the shortest path is found.\n  visited = {(initial_pos, initial_dir)}\n\n  # Variable to store the shortest action sequence once a target state is found.\n  path_to_adjacent_primitive = None \n\n  # Start Breadth-First Search traversal.\n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      current_r, current_c = current_pos\n\n      # Goal Check: Is the current agent state one of our pre-computed target states?\n      if (current_pos, current_dir) in target_agent_states:\n          path_to_adjacent_primitive = path_so_far\n          break # Shortest path to a 'USE'-ready position found.\n\n      # Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n\n      # Option 1: Move Forward\n      next_r_move, next_c_move = current_r + DIR_TO_DRDC[current_dir][0], current_c + DIR_TO_DRDC[current_dir][1]\n      next_pos_move = (next_r_move, next_c_move)\n      next_dir_move = current_dir # Direction does not change when moving forward.\n\n      # If the next position is valid, walkable, and this (pos,dir) state hasn't been visited:\n      if _is_walkable_cell(next_r_move, next_c_move):\n          if (next_pos_move, next_dir_move) not in visited:\n              visited.add((next_pos_move, next_dir_move))\n              queue.append(((next_pos_move, next_dir_move), path_so_far + [ACTION_MOVE_FORWARD]))\n\n      # Option 2: Turn Left (counter-clockwise rotation)\n      next_dir_left = (current_dir + 1) % 4 \n      # Position remains the same when turning.\n      if (current_pos, next_dir_left) not in visited:\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_so_far + [ACTION_TURN_LEFT]))\n\n      # Option 3: Turn Right (clockwise rotation)\n      next_dir_right = (current_dir - 1 + 4) % 4 # '+4' ensures positive result for modulo\n      # Position remains the same when turning.\n      if (current_pos, next_dir_right) not in visited:\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_so_far + [ACTION_TURN_RIGHT]))\n\n  # After BFS completes:\n  # If a path was found to a state where the agent is adjacent and facing the primitive,\n  # append the 'USE' action to complete the collection process.\n  if path_to_adjacent_primitive is not None:\n      actions_list.extend(path_to_adjacent_primitive)\n      actions_list.append(ACTION_USE)\n\n  # Return the sequence of actions. This list will be empty if the primitive\n  # was not found or was unreachable.\n  return actions_list", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T13:55:29.914387", "function_name": "collect", "function_body": "  current_state = env._current_state\n  grid = current_state.grid\n  initial_pos = current_state.pos\n  initial_dir = current_state.dir\n\n  try:\n    primitive_id = current_state.world.cookbook.index[primitive]\n  except KeyError:\n    return []\n\n  GRID_WIDTH, GRID_HEIGHT = grid.shape[0], grid.shape[1]\n\n  action_map = env.action_specs()\n  ACTION_MOVE_FORWARD = action_map['UP']\n  ACTION_TURN_LEFT = action_map['LEFT']\n  ACTION_TURN_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  non_walkable_indices = current_state.world.non_grabbable_indices\n\n  def is_cell_valid_and_walkable(r_coord, c_coord):\n    if not (0 <= r_coord < GRID_WIDTH and 0 <= c_coord < GRID_HEIGHT):\n      return False\n\n    for kind_idx in non_walkable_indices:\n      if grid[r_coord, c_coord, kind_idx] > 0:\n        return False\n    \n    # The agent cannot walk directly onto the primitive it intends to collect.\n    # It must be adjacent to use it.\n    if grid[r_coord, c_coord, primitive_id] > 0:\n        return False\n    \n    return True\n\n  # --- Pre-computation of target agent states ---\n  # A 'target agent state' is a (position, direction) tuple from which the agent\n  # can immediately use the 'USE' action to collect the primitive.\n  # This means the agent is at a walkable cell, one step away from the primitive,\n  # and facing it directly.\n  target_agent_states = set()\n\n  # Find all grid locations where the target primitive exists.\n  primitive_locations = np.argwhere(grid[:, :, primitive_id] > 0)\n\n  # For each primitive location, determine all possible agent states (pos, dir)\n  # from which that primitive could be collected.\n  for prim_r, prim_c in primitive_locations:\n      # Iterate through all 4 possible directions the agent could be facing.\n      for agent_dir_candidate in range(4):\n          # Determine the (dr, dc) that represents 'forward' for this agent_dir_candidate.\n          # This vector points *from* the agent's potential position *to* the primitive.\n          dr, dc = DIR_TO_DRDC[agent_dir_candidate]\n\n          # The agent's position (agent_r, agent_c) must be such that (agent_r + dr, agent_c + dc) == (prim_r, prim_c).\n          # Therefore, (agent_r, agent_c) = (prim_r - dr, prim_c - dc).\n          agent_r_candidate, agent_c_candidate = prim_r - dr, prim_c - dc\n          \n          # Check if this calculated candidate agent position is a valid and walkable cell.\n          if is_cell_valid_and_walkable(agent_r_candidate, agent_c_candidate):\n              target_agent_states.add(((agent_r_candidate, agent_c_candidate), agent_dir_candidate))\n              \n  # If no primitive locations are found or all adjacent positions are unreachable,\n  # the target_agent_states set will be empty. In this case, no path can be found.\n  if not target_agent_states:\n      return []\n\n  # BFS Initialization:\n  # Queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_here).\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # Visited set stores (position_tuple, direction_int) to avoid redundant exploration.\n  visited = {(initial_pos, initial_dir)}\n\n  path_to_adjacent_primitive = None \n\n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      current_r, current_c = current_pos\n\n      # Goal Check: Is the current agent state one of our pre-computed target states?\n      if ((current_pos, current_dir) in target_agent_states):\n          path_to_adjacent_primitive = path_so_far\n          break # Shortest path to a 'USE'-ready position found.\n\n      # Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n\n      # Option 1: Move Forward\n      next_r_move, next_c_move = current_r + DIR_TO_DRDC[current_dir][0], current_c + DIR_TO_DRDC[current_dir][1]\n      next_pos_move = (next_r_move, next_c_move)\n      next_dir_move = current_dir\n\n      if is_cell_valid_and_walkable(next_r_move, next_c_move):\n          if (next_pos_move, next_dir_move) not in visited:\n              visited.add((next_pos_move, next_dir_move))\n              queue.append(((next_pos_move, next_dir_move), path_so_far + [ACTION_MOVE_FORWARD]))\n\n      # Option 2: Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      if (current_pos, next_dir_left) not in visited:\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_so_far + [ACTION_TURN_LEFT]))\n\n      # Option 3: Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      if (current_pos, next_dir_right) not in visited:\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_so_far + [ACTION_TURN_RIGHT]))\n\n  # After BFS completes:\n  # If a path was found to a state where the agent is adjacent and facing the primitive,\n  # append the 'USE' action to complete the collection process.\n  actions_list = []\n  if path_to_adjacent_primitive is not None:\n      actions_list.extend(path_to_adjacent_primitive)\n      actions_list.append(ACTION_USE)\n\n  return actions_list", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T13:57:08.876491", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n\n  This version refines the Breadth-First Search (BFS) logic to ensure\n  all possible actions (Move Forward, Turn Left, Turn Right) are correctly\n  explored as independent next steps from any given state, avoiding a\n  copy-paste error present in the provided `collect_v1` example where\n  turn actions were incorrectly nested within the forward movement check.\n  It also explicitly re-confirms the `grabbable_indices` check for valid\n  collection targets, making the function more robust.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state\n  \n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  # Critical Improvement carried over from v1:\n  # Check if the primitive is actually grabbable. If it's not in the list of\n  # grabbable items (e.g., it's a boundary, water, or workshop), it cannot be\n  # collected using the USE action. In such cases, an empty list of actions\n  # is returned, as it's not a 'collectible' item in the sense of picking it up.\n  if primitive_id not in current_state.world.grabbable_indices:\n      return []\n\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (r, c)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  # This defines how position changes when moving \"forward\" (in the direction `dir`).\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT (positive column)\n      1: (-1, 0),  # Facing UP (negative row)\n      2: (0, -1),  # Facing LEFT (negative column)\n      3: (1, 0)    # Facing DOWN (positive row)\n  }\n\n  # Map for turning left/right, updating the agent's direction (0-3)\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}   # Right -> Up -> Left -> Down -> Right (counter-clockwise)\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right (clockwise)\n\n  # Combine non-grabbable items and the target primitive itself into a single set\n  # of indices that represent non-walkable cells for the agent.\n  # The agent cannot walk onto permanent obstacles (non_grabbable) or the primitive\n  # it intends to collect (as it should be in front, not under, for `USE`).\n  non_walkable_indices = current_state.world.non_grabbable_indices.union({primitive_id})\n  # Convert to a list for efficient NumPy advanced indexing\n  non_walkable_indices_list = list(non_walkable_indices) \n\n  # BFS state: ((row, col), direction), path_actions\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (current_pos_tuple, current_dir_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # Stores the action list to reach the target state\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent at current state.\n      # This is the goal state for collection: agent is adjacent and facing the primitive.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the cell directly in front is within grid bounds\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          # Check if the front cell contains the primitive we want to collect (quantity > 0).\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Path to target found!\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right\n      \n      # Try Move Forward Action\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r_forward, next_c_forward = r + move_dr, c + move_dc\n      next_pos_forward = (next_r_forward, next_c_forward)\n      next_dir_forward = current_dir # Moving forward does not change facing direction\n\n      # Check if the potential next position is within bounds\n      if (0 <= next_r_forward < WIDTH and 0 <= next_c_forward < HEIGHT):\n          # Check if this (position, direction) state hasn't been visited yet\n          if (next_pos_forward, next_dir_forward) not in visited:\n              # Check if the next position is walkable (i.e., does not contain any non-walkable item).\n              # np.any will be True if any of the specified obstacle kinds are present at the cell.\n              if not np.any(initial_grid[next_r_forward, next_c_forward, non_walkable_indices_list] > 0):\n                  visited.add((next_pos_forward, next_dir_forward))\n                  queue.append(((next_pos_forward, next_dir_forward), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left Action\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right Action\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path was found to an adjacent-and-facing state, append the USE action to the sequence.\n  # Otherwise, if no path is found (target unreachable), target_path remains None and an empty list is returned.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 2, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T13:57:10.034085", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  \n  # Get the integer ID for the primitive from the cookbook's index.\n  # Assumes 'primitive' string is valid and exists in the index.\n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  # CRITICAL CHECK: Ensure the primitive is actually grabbable.\n  # The 'collect' function, as defined by its interaction with the 'USE' action,\n  # implies picking up an item. If the item is not in 'grabbable_indices' (e.g.,\n  # 'WATER', 'STONE', 'WORKSHOP_X' which are not picked up but interacted with differently),\n  # this function cannot collect it.\n  if primitive_id not in current_state.world.grabbable_indices:\n      # Return an empty list as this primitive cannot be collected via this method.\n      return []\n\n  # Snapshot the initial grid, agent's position, and direction.\n  # The BFS operates on this static snapshot of the environment.\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's starting position (row, col)\n  initial_dir = current_state.dir # Agent's starting direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get grid dimensions for boundary checks.\n  GRID_WIDTH, GRID_HEIGHT, _ = initial_grid.shape\n\n  # Map action names to their integer indices.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # 'UP' typically means moving forward relative to agent's direction\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define direction vectors for moving \"forward\" based on agent's current direction.\n  # (dr, dc) tuple indicating change in (row, column) for each direction index.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # RIGHT: row stays, col increments\n      1: (-1, 0),  # UP: row decrements, col stays\n      2: (0, -1),  # LEFT: row stays, col decrements\n      3: (1, 0)    # DOWN: row increments, col stays\n  }\n\n  # Define how agent's direction changes when turning left or right.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}   # Cycle: RIGHT -> UP -> LEFT -> DOWN -> RIGHT\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}  # Cycle: RIGHT -> DOWN -> LEFT -> UP -> RIGHT\n\n  # Identify all types of cells the agent cannot walk onto.\n  # This includes explicitly non-grabbable entities (e.g., BOUNDARY, WATER, WORKSHOPs)\n  # AND the target primitive itself (agent cannot walk onto the item it intends to pick up).\n  non_walkable_indices = current_state.world.non_grabbable_indices.union({primitive_id})\n  # Convert to a list for efficient NumPy advanced indexing when checking cell occupancy.\n  non_walkable_indices_list = list(non_walkable_indices) \n\n  # BFS initialization:\n  # Queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_here)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (position, direction) pairs to prevent redundant exploration and cycles.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the sequence of actions to reach the target state (adjacent and facing the primitive)\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check for Goal Condition: Is the primitive directly in front of the agent?\n      # Calculate coordinates of the cell directly in front of the agent.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the front cell is within grid boundaries.\n      if (0 <= front_r < GRID_WIDTH and 0 <= front_c < GRID_HEIGHT):\n          # Check if the primitive is present in the cell directly in front.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions # Path to reach the adjacent-and-facing state is found.\n              break # Exit BFS, shortest path found.\n\n      # 2. Explore Next Possible Actions: Move Forward, Turn Left, Turn Right\n      \n      # --- Try Move Forward ---\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change direction.\n\n      # Check if the next position is within grid boundaries.\n      if (0 <= next_r < GRID_WIDTH and 0 <= next_c < GRID_HEIGHT):\n          # Check if this (position, direction) state has already been visited.\n          if (next_pos, next_dir) not in visited:\n              # Check if the next position is walkable. A cell is walkable if it does not contain\n              # any of the non-walkable items (obstacles or the target primitive itself).\n              is_walkable = not np.any(initial_grid[next_r, next_c, non_walkable_indices_list] > 0)\n              \n              if is_walkable:\n                  visited.add((next_pos, next_dir))\n                  queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # --- Try Turn Left ---\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # --- Try Turn Right ---\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # After BFS: If a path to the target (adjacent and facing) was found,\n  # append the 'USE' action to the found path.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n  \n  # If target_path is None, it means the primitive was not found or was unreachable.\n  # In this case, actions_list remains empty, which is the correct behavior.\n\n  return actions_list", "island_id": 2, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T13:57:55.720382", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state \n  \n  # Extract relevant information from the current state and world\n  initial_grid = current_state.grid \n  initial_pos = current_state.pos   \n  initial_dir = current_state.dir   \n\n  # Get the integer ID for the target primitive from the cookbook index\n  try:\n      primitive_id = current_state.world.cookbook.index[primitive]\n  except KeyError:\n      # If the primitive name is not recognized, it cannot be collected.\n      return []\n\n  WIDTH, HEIGHT, _ = initial_grid.shape \n\n  # Map action names to their integer indices using env.action_specs()\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # Moves agent one step in its current direction\n  TURN_LEFT_ACTION = action_map['LEFT']     # Rotates agent 90 degrees left\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Rotates agent 90 degrees right\n  USE_ACTION = action_map['USE']            # Interacts with the cell directly in front of the agent\n\n  # Direction definitions: (dr, dc) tuple for changes in row and column for each direction\n  # This helps determine the cell in front of the agent, or where it moves to.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT (+col)\n      1: (-1, 0),  # Facing UP (-row)\n      2: (0, -1),  # Facing LEFT (-col)\n      3: (1, 0)    # Facing DOWN (+row)\n  }\n\n  # Direction update maps for turns (clockwise for RIGHT, counter-clockwise for LEFT)\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # Get indices of entities that are considered non-walkable terrain (e.g., boundaries, water)\n  non_walkable_kind_ids = current_state.world.non_grabbable_indices\n\n  # Helper function to check if a cell (r, c) is a valid and traversable location for the agent.\n  # A cell is traversable if it's within bounds, does not contain any permanent obstacles,\n  # and does not contain the target primitive itself (as agent needs to be adjacent, not on it).\n  def _is_traversable_cell(r, c):\n      # 1. Check if the cell is within the grid boundaries.\n      if not (0 <= r < WIDTH and 0 <= c < HEIGHT):\n          return False\n\n      # 2. Check if the cell contains any non-grabbable entity that blocks movement.\n      for kind_idx in non_walkable_kind_ids:\n          if initial_grid[r, c, kind_idx] > 0:\n              return False\n      \n      # 3. Agent cannot walk directly *onto* the primitive it intends to collect.\n      # It must be adjacent to use it. If the primitive is on this cell, it's not traversable for movement.\n      if initial_grid[r, c, primitive_id] > 0:\n          return False\n      \n      return True\n\n  # BFS initialization\n  # Queue stores tuples: ((current_row, current_col), current_direction), list_of_actions_taken_to_reach_here\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # Visited set stores tuples: ((row, col), direction) to prevent revisiting states and ensure shortest path.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # This will store the sequence of actions to reach the goal state\n\n  # Start Breadth-First Search\n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      r, c = current_pos\n\n      # 1. Goal Check: Is the cell directly in front of the agent the target primitive?\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the cell in front is within grid bounds AND contains the target primitive\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT and\n          initial_grid[front_r, front_c, primitive_id] > 0):\n          target_path_actions = path_so_far\n          break # Shortest path to a 'USE'-ready position found!\n\n      # 2. Explore possible next actions from the current state (move or turn)\n\n      # --- Try Move Forward ---\n      next_r_move, next_c_move = r + DIR_TO_DRDC[current_dir][0], c + DIR_TO_DRDC[current_dir][1]\n      next_pos_move = (next_r_move, next_c_move)\n      next_dir_move = current_dir # Direction doesn't change when moving forward\n\n      # If the next position is traversable and this (pos,dir) state hasn't been visited:\n      if _is_traversable_cell(next_r_move, next_c_move) and \\\n         (next_pos_move, next_dir_move) not in visited:\n          visited.add((next_pos_move, next_dir_move))\n          queue.append(((next_pos_move, next_dir_move), path_so_far + [MOVE_FORWARD_ACTION]))\n\n      # --- Try Turn Left ---\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position.\n      if (current_pos, next_dir_left) not in visited:\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_so_far + [TURN_LEFT_ACTION]))\n\n      # --- Try Turn Right ---\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position.\n      if (current_pos, next_dir_right) not in visited:\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_so_far + [TURN_RIGHT_ACTION]))\n\n  # After BFS completes:\n  # If a path was found to a state where the agent is adjacent and facing the primitive,\n  # append the 'USE' action to complete the collection process.\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  # Return the sequence of actions. This list will be empty if the primitive\n  # was not found or was unreachable.\n  return actions_list", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T13:57:56.902520", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` to find and collect the primitive.\n    \n    This function uses Breadth-First Search (BFS) to find the shortest path\n    to a location adjacent to the target primitive, where the agent is facing it.\n    Once such a position is reached, a 'USE' action is appended to the sequence.\n\n    Args:\n        env (env.CraftLab): The CraftLab object representing the current state of the environment.\n        primitive (str): The string name of the primitive resource or object to collect\n                         (e.g., \"WOOD\", \"WORKSHOP0\", \"STONE\").\n\n    Returns:\n        List[int]: A sequence of integer action IDs (as defined by env.action_specs())\n                   to execute. Returns an empty list if the primitive is not found\n                   in the environment or is unreachable.\n  \"\"\"\n  actions_list = []\n  \n  # Access the internal CraftState object which holds the current grid, position, and inventory.\n  current_state = env._current_state \n\n  # Extract essential information for pathfinding from the current state.\n  grid = current_state.grid  # The current grid layout (WIDTH, HEIGHT, n_kinds)\n  initial_pos = current_state.pos    # Agent's current (row, col) position on the grid.\n  initial_dir = current_state.dir    # Agent's current facing direction (0:Right, 1:Up, 2:Left, 3:Down).\n\n  # Get the integer ID for the target primitive from the cookbook index.\n  # If the primitive name is not recognized, it cannot be collected.\n  try:\n      primitive_id = current_state.world.cookbook.index[primitive]\n  except KeyError:\n      return []\n\n  # Get grid dimensions for boundary checks during pathfinding.\n  GRID_WIDTH, GRID_HEIGHT, _ = grid.shape \n\n  # Map action names (from DSL) to their integer indices (used by env.step).\n  action_map = env.action_specs()\n  ACTION_MOVE_FORWARD = action_map['UP'] # Corresponds to moving one step in the current direction\n  ACTION_TURN_LEFT = action_map['LEFT']\n  ACTION_TURN_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Pre-defined changes in (row, col) coordinates for each direction.\n  # This helps calculate the cell in front of the agent or the next position after moving.\n  # Directions: 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: +1 to column (x-axis)\n      1: (-1, 0),  # Facing UP: -1 to row (y-axis)\n      2: (0, -1),  # Facing LEFT: -1 to column (x-axis)\n      3: (1, 0)    # Facing DOWN: +1 to row (y-axis)\n  }\n\n  # Set of entity kind IDs that represent non-walkable terrain (e.g., BOUNDARY, WATER, WORKSHOP_X).\n  # These are general obstacles the agent cannot walk through.\n  non_walkable_kind_ids = current_state.world.non_grabbable_indices\n\n  # Helper function to determine if a cell at (r, c) is a valid and walkable location for the agent.\n  def _is_valid_and_walkable(r, c):\n      \"\"\"Checks if the given grid cell (r, c) is within bounds and does not contain\n      any blocking entities or the primitive itself (as agent needs to be adjacent to use).\"\"\"\n      # 1. Check if the cell is within the grid boundaries.\n      if not (0 <= r < GRID_WIDTH and 0 <= c < GRID_HEIGHT):\n          return False\n\n      # 2. Check if the cell contains any non-grabbable entity that blocks movement.\n      for kind_idx in non_walkable_kind_ids:\n          if grid[r, c, kind_idx] > 0:\n              return False\n      \n      # 3. Agent cannot walk directly *onto* the primitive it intends to collect.\n      # It must be adjacent to use it. If the primitive is on this cell, it's not walkable.\n      if grid[r, c, primitive_id] > 0:\n          return False\n      \n      return True\n\n  # BFS Initialization:\n  # Queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_here).\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # Visited set stores (position_tuple, direction_int) to avoid redundant exploration\n  # and ensure the shortest path is found.\n  visited = {(initial_pos, initial_dir)}\n\n  # Variable to store the shortest action sequence once a target state is found.\n  path_to_use_position = None \n\n  # Start Breadth-First Search traversal.\n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      current_r, current_c = current_pos\n\n      # Goal Check: Is the cell directly in front of the agent the target primitive?\n      # If so, we are in a state where the 'USE' action can be applied.\n      dr_front, dc_front = DIR_TO_DRDC[current_dir]\n      front_r, front_c = current_r + dr_front, current_c + dc_front\n      \n      # Check if the cell in front is within grid bounds and contains the primitive.\n      if (0 <= front_r < GRID_WIDTH and 0 <= front_c < GRID_HEIGHT and\n          grid[front_r, front_c, primitive_id] > 0):\n          path_to_use_position = path_so_far\n          break # Shortest path to a 'USE'-ready position found.\n\n      # Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n\n      # Option 1: Move Forward\n      next_r_move, next_c_move = current_r + DIR_TO_DRDC[current_dir][0], current_c + DIR_TO_DRDC[current_dir][1]\n      next_pos_move = (next_r_move, next_c_move)\n      next_dir_move = current_dir # Direction does not change when moving forward.\n\n      # If the next position is valid, walkable, and this (pos,dir) state hasn't been visited:\n      if _is_valid_and_walkable(next_r_move, next_c_move):\n          if (next_pos_move, next_dir_move) not in visited:\n              visited.add((next_pos_move, next_dir_move))\n              queue.append(((next_pos_move, next_dir_move), path_so_far + [ACTION_MOVE_FORWARD]))\n\n      # Option 2: Turn Left (counter-clockwise rotation)\n      next_dir_left = (current_dir + 1) % 4 \n      # Position remains the same when turning.\n      if (current_pos, next_dir_left) not in visited:\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_so_far + [ACTION_TURN_LEFT]))\n\n      # Option 3: Turn Right (clockwise rotation)\n      next_dir_right = (current_dir - 1 + 4) % 4 # '+4' ensures positive result for modulo\n      # Position remains the same when turning.\n      if (current_pos, next_dir_right) not in visited:\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_so_far + [ACTION_TURN_RIGHT]))\n\n  # After BFS completes:\n  # If a path was found to a state where the agent is adjacent and facing the primitive,\n  # append the 'USE' action to complete the collection process.\n  if path_to_use_position is not None:\n      actions_list.extend(path_to_use_position)\n      actions_list.append(ACTION_USE)\n\n  # Return the sequence of actions. This list will be empty if the primitive\n  # was not found or was unreachable.\n  return actions_list", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T13:59:43.622321", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n  Specifically enhances:\n  1. Refines the goal condition for 'collecting' workshops, as workshops are\n     locations to use for crafting, not items to be picked up into inventory.\n     For workshops, the goal is to successfully perform a 'USE' action at the workshop,\n     leading to any detectable state change (e.g., crafting of other items, agent movement due to interaction).\n  2. Ensures the initial inventory check for 'collection' correctly applies only\n     to inventory-based items, not workshops.\n  \"\"\"\n  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  is_workshop = i_kind in world.workshop_indices\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is (and it's not a workshop), no actions are needed to \"collect\" it.\n  if not is_workshop and current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Determine if the primitive is a type that can be collected via the 'USE' action or interacted with.\n  # This includes explicit primitive resources (from cookbook), grabbable items, water, or stone.\n  is_collectible_via_use = (\n      i_kind in world.cookbook.primitives or \n      i_kind in world.grabbable_indices or\n      i_kind == world.water_index or\n      i_kind == world.stone_index\n  )\n\n  # If the item is not intended to be collected via 'USE' and is not a workshop, return an empty path.\n  # This acts as an early exit for truly non-collectible primitives like boundaries.\n  if not is_collectible_via_use and not is_workshop:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return []\n      \n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1:\n          return [RIGHT_ACT]\n      elif diff == 3:\n          return [LEFT_ACT]\n      else:\n          return [RIGHT_ACT, RIGHT_ACT]\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set includes the agent's inventory as part of the state key,\n  # allowing the algorithm to distinguish states that are identical in position/direction\n  # but differ in inventory (e.g., having a tool vs. not).\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Increased MAX_EXPLORED_STATES due to the larger state space when tracking inventory\n  # and considering workshop interactions.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 30 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # --- Goal Check Logic (Refined for v2) ---\n    # This section checks if the *target primitive* can be collected/used from the current 'state'.\n    \n    # Case 1: Target is a workshop. Goal is to USE it. Agent can be on it or next to it.\n    if is_workshop:\n        # Check if agent is currently on the workshop tile\n        if any(state.grid[current_r, current_c, w_idx] == 1 for w_idx in world.workshop_indices):\n            # Agent is on a workshop tile, attempt USE directly from here.\n            inventory_before_use = np.copy(state.inventory)\n            _, state_after_use = state.step(USE_ACT)\n            \n            # For workshops, \"collection\" means the USE action caused *any* state change.\n            # This covers crafting (inventory changes) or other side effects.\n            if not (np.array_equal(state_after_use.inventory, inventory_before_use) and\n                    state_after_use.pos == state.pos and\n                    state_after_use.dir == state.dir):\n                return path + [USE_ACT] # Success: USE action performed on the workshop\n        \n        # Check if agent is next to the workshop tile (but not on it)\n        elif state.next_to(i_kind):\n            # Iterate through all directions to find the workshop cell\n            for target_dir_val in range(4):\n                dr, dc = _DIR_TO_DELTA_FRONT[target_dir_val]\n                facing_r, facing_c = current_r + dr, current_c + dc\n                \n                if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                    state.grid[facing_r, facing_c, i_kind] == 1): # Check if the workshop is in this direction\n                    \n                    # Simulate turning to face the workshop\n                    turns_to_face = _get_turning_actions(current_dir, target_dir_val)\n                    temp_state_after_turns = state \n                    for turn_action in turns_to_face:\n                        _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                    inventory_before_use = np.copy(temp_state_after_turns.inventory)\n                    _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                    # For workshops, \"collection\" means the USE action caused *any* state change.\n                    if not (np.array_equal(state_after_use.inventory, inventory_before_use) and\n                            state_after_use.pos == temp_state_after_turns.pos and\n                            state_after_use.dir == temp_state_after_turns.dir):\n                        return path + turns_to_face + [USE_ACT] # Success: USE action performed towards workshop\n\n    # Case 2: Target is a regular inventory item. Goal is to collect it into inventory.\n    elif state.next_to(i_kind):\n        for target_dir_val in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir_val]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate turning to face the item\n                turns_to_face = _get_turning_actions(current_dir, target_dir_val)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # For inventory items, \"collection\" means its count increased.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n    # --- End Goal Check Logic ---\n\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the general 'USE' action from the current state.\n    # This is essential for picking up other grabbable items (like tools)\n    # or for crafting at workshops that are not the target primitive itself\n    # but might be necessary preconditions for other crafts.\n    \n    is_action_use_applicable = False\n\n    # Check 1: Is there something interactable directly in front of the agent?\n    front_dr, front_dc = _DIR_TO_DELTA_FRONT[current_dir]\n    facing_r, facing_c = current_r + front_dr, current_c + front_dc\n\n    if 0 <= facing_r < grid_width and 0 <= facing_c < grid_height:\n        # Check for grabbable items, water, or stone in front.\n        for k_idx in world.grabbable_indices:\n            if state.grid[facing_r, facing_c, k_idx] == 1:\n                is_action_use_applicable = True\n                break\n        if not is_action_use_applicable and (state.grid[facing_r, facing_c, world.water_index] == 1 or \n                                              state.grid[facing_r, facing_c, world.stone_index] == 1):\n            is_action_use_applicable = True\n        \n        # Check for any primitive resources in front that might be collected by USE (e.g., WOOD, IRON).\n        if not is_action_use_applicable:\n            for kind_idx_at_cell in range(state.grid.shape[2]): \n                if state.grid[facing_r, facing_c, kind_idx_at_cell] == 1 and\\\n                   kind_idx_at_cell in world.cookbook.primitives:\n                    is_action_use_applicable = True\n                    break\n    \n    # Check 2: Is the agent standing on a workshop?\n    # The 'USE' action can also trigger crafting if the agent is positioned on a workshop tile.\n    if not is_action_use_applicable: # Only check this if not already applicable by front cell\n        for workshop_idx in world.workshop_indices:\n            if state.grid[current_r, current_c, workshop_idx] == 1:\n                is_action_use_applicable = True\n                break\n\n    # Only attempt USE_ACT if `is_action_use_applicable` is True.\n    if is_action_use_applicable:\n        inventory_before_any_use = np.copy(state.inventory)\n        _, state_after_current_use = state.step(USE_ACT)\n        \n        # Add to queue only if the USE action resulted in a meaningful state change.\n        if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n                state_after_current_use.pos == state.pos and\n                state_after_current_use.dir == state.dir):\n\n            next_inventory_tuple = tuple(state_after_current_use.inventory)\n            next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n            if next_state_key not in visited:\n                visited.add(next_state_key)\n                q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T13:59:45.582203", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Determine if the primitive is a type that can be collected via the 'USE' action.\n  # This includes explicit primitive resources (from cookbook), grabbable items, water, or stone.\n  # The crucial improvement in v2 is including `i_kind in world.cookbook.primitives` in this check.\n  is_collectible_via_use = (\n      i_kind in world.cookbook.primitives or # This condition ensures all cookbook primitives are considered collectable.\n      i_kind in world.grabbable_indices or\n      i_kind == world.water_index or\n      i_kind == world.stone_index\n  )\n\n  # If the item is not intended to be collected via 'USE', return an empty path.\n  # This acts as an early exit for truly non-collectible primitives like boundaries.\n  # Workshops are handled implicitly by the BFS if crafting there is a prerequisite.\n  if not is_collectible_via_use and i_kind not in world.workshop_indices:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set includes the agent's inventory as part of the state key,\n  # allowing the algorithm to distinguish states that are identical in position/direction\n  # but differ in inventory (e.g., having a tool vs. not).\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Increased MAX_EXPLORED_STATES due to the larger state space when tracking inventory\n  # and considering workshop interactions. This heuristic limit helps prevent excessive \n  # computation in complex or unreachable scenarios.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 30 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`).\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the general 'USE' action from the current state.\n    # This is essential for picking up other grabbable items (like tools)\n    # or for crafting at workshops that are not the target primitive itself\n    # but might be necessary preconditions.\n    # The enhancement here (point 2 from description) ensures that ANY\n    # primitive resource in front is considered interactable, not just \n    # grabbable items, water, or stone, allowing for tool-based collection.\n    \n    is_action_use_applicable = False\n\n    # Check 1: Is there something interactable directly in front of the agent?\n    front_dr, front_dc = _DIR_TO_DELTA_FRONT[current_dir]\n    facing_r, facing_c = current_r + front_dr, current_c + front_dc\n\n    if 0 <= facing_r < grid_width and 0 <= facing_c < grid_height:\n        # Check for grabbable items, water, or stone in front.\n        for k_idx in world.grabbable_indices:\n            if state.grid[facing_r, facing_c, k_idx] == 1:\n                is_action_use_applicable = True\n                break\n        if not is_action_use_applicable and (state.grid[facing_r, facing_c, world.water_index] == 1 or \n                                              state.grid[facing_r, facing_c, world.stone_index] == 1):\n            is_action_use_applicable = True\n        \n        # Check for any primitive resources in front that might be collected by USE (e.g., WOOD, IRON).\n        # This is the specific enhancement from v1 to v2 as per the docstring description.\n        if not is_action_use_applicable:\n            for kind_idx_at_cell in range(state.grid.shape[2]): \n                if state.grid[facing_r, facing_c, kind_idx_at_cell] == 1 and\\\n                   kind_idx_at_cell in world.cookbook.primitives:\n                    is_action_use_applicable = True\n                    break\n    \n    # Check 2: Is the agent standing on a workshop?\n    # The 'USE' action can also trigger crafting if the agent is positioned on a workshop tile.\n    if not is_action_use_applicable: # Only check this if not already applicable by front cell\n        for workshop_idx in world.workshop_indices:\n            if state.grid[current_r, current_c, workshop_idx] == 1:\n                is_action_use_applicable = True\n                break\n\n    # Only attempt USE_ACT if `is_action_use_applicable` is True.\n    if is_action_use_applicable:\n        inventory_before_any_use = np.copy(state.inventory)\n        _, state_after_current_use = state.step(USE_ACT)\n        \n        # Add to queue only if the USE action resulted in a meaningful state change.\n        # A meaningful change means inventory or position/direction was updated.\n        # Inventory change is the primary signal for resource collection/crafting.\n        if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n                state_after_current_use.pos == state.pos and\n                state_after_current_use.dir == state.dir):\n\n            next_inventory_tuple = tuple(state_after_current_use.inventory)\n            next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n            if next_state_key not in visited:\n                visited.add(next_state_key)\n                q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T14:01:30.114035", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  # This list ensures we only attempt to collect items that are actually collectible via the USE action.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  # This prunes the search space for uncollectible primitives early.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set includes the agent's inventory as part of the state key.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing, allowing BFS to distinguish\n  # between states that are identical in position/direction but differ in inventory (e.g., having a tool vs. not).\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Maximum number of unique states to explore. This limit prevents excessive computation\n  # for very large or complex environments where a path might not exist or is too long.\n  # The factor '10' for inventory variations captures common scenarios where inventory changes enable new paths.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # --- V2 Improvement: Prioritize immediate collection at current position ---\n    # Check if 'USE' at the current location collects the primitive (e.g., picking up an item directly beneath the agent).\n    inventory_before_immediate_use = np.copy(state.inventory)\n    _, state_after_immediate_use = state.step(USE_ACT)\n    \n    # If the primitive was collected by a direct USE action, return the path.\n    if state_after_immediate_use.inventory[i_kind] > inventory_before_immediate_use[i_kind]:\n        return path + [USE_ACT]\n\n    # --- Goal Check: Can we collect the primitive from an ADJACENT cell? ---\n    # This check specifically looks for the target primitive (`i_kind`) in the 3x3 neighborhood.\n    # The `state.next_to(i_kind)` function includes the agent's current position, but\n    # we've already handled direct collection at the current position above.\n    # So, this block focuses on items in adjacent cells that require turning + USE.\n    if state.next_to(i_kind):\n        # Iterate through all four cardinal directions to find the target primitive in an adjacent cell.\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell in front is within grid bounds AND contains the primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    # Apply each turn action to simulate the new state after turning.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_facing_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_facing_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`.\n                if state_after_facing_use.inventory[i_kind] > inventory_before_facing_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # --- Explore next states (Movement and General USE for other purposes) ---\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the state resulting from the general 'USE' action, specifically `state_after_immediate_use`.\n    # This is important if `USE` at the current position didn't collect the *target* primitive (which would have returned),\n    # but changed the state in a way that enables *future* collection (e.g., picking up a tool, or clearing an obstacle).\n    \n    next_inventory_tuple_after_use = tuple(state_after_immediate_use.inventory)\n    next_state_key_after_use = (state_after_immediate_use.pos[0], state_after_immediate_use.pos[1], state_after_immediate_use.dir, next_inventory_tuple_after_use)\n    \n    # Only add this state if it's truly new and it's meaningfully different\n    # from the `state` it originated from (i.e., something actually happened from the USE action\n    # besides collecting the target primitive).\n    if next_state_key_after_use not in visited:\n        if not (np.array_equal(state_after_immediate_use.inventory, inventory_before_immediate_use) and\n                state_after_immediate_use.pos == state.pos and\n                state_after_immediate_use.dir == state.dir):\n            visited.add(next_state_key_after_use)\n            q.append((state_after_immediate_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T14:01:31.627306", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory in the initial state.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set includes the agent's inventory as part of the state key.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing.\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Maximum number of unique states to explore. This limit prevents excessive computation\n  # for very large or complex environments where a path might not exist or is too long.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent excessive computation.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    # *** IMPROVEMENT for V2 ***\n    # Immediate Goal Check: If the primitive is now in the inventory of this dequeued state,\n    # it means it was just collected by the action that led to this state. Return the path.\n    # This ensures that the shortest path to a collected state is returned first,\n    # adhering to BFS's shortest path guarantee.\n    if state.inventory[i_kind] > 0:\n        return path\n    \n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Explore actions that could lead to collecting the primitive from this state:\n    \n    # 1. Attempt collection from an adjacent cell by turning to face it and using.\n    # This uses `state.next_to(i_kind)` which checks a 3x3 neighborhood.\n    if state.next_to(i_kind):\n        # Iterate through all four cardinal directions to find the target primitive.\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell we would face is within grid bounds AND contains the primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n                \n                # Simulate the 'USE' action in the new facing direction.\n                # The check for successful collection is now handled by the general goal check\n                # at the top of the BFS loop when 'state_after_facing_use' is dequeued.\n                _, state_after_facing_use = temp_state_after_turns.step(USE_ACT)\n\n                # Add this potential next state to the queue if it's new.\n                next_inventory_tuple = tuple(state_after_facing_use.inventory)\n                next_state_key = (state_after_facing_use.pos[0], state_after_facing_use.pos[1], state_after_facing_use.dir, next_inventory_tuple)\n\n                if next_state_key not in visited:\n                    visited.add(next_state_key)\n                    q.append((state_after_facing_use, path + turns_to_face + [USE_ACT]))\n\n    # 2. Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # 3. Explore the 'USE' action from the current position, even if not directly facing the target primitive.\n    # This is important if using an item at the current position (e.g., picking up a tool like an axe)\n    # can change the inventory state, which might be necessary for later steps to collect the target primitive (e.g., wood).\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if the USE action resulted in a meaningful state change (inventory, position, or direction).\n    # This prevents adding redundant states to the queue if USE had no effect.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T14:02:45.674019", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n  Re-introduces more adaptive and robust search limits for BFS compared to v1,\n  allowing for exploration of longer paths and more states in complex environments.\n  \"\"\"\n  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Semantic check: Determine if this primitive is *actually* collectible into inventory.\n  # This includes items defined as primitives, special environment items like water/stone,\n  # and any other items explicitly marked as grabbable.\n  is_primitive_resource = i_kind in world.cookbook.primitives\n  is_special_collectible_environment = (i_kind == world.water_index or i_kind == world.stone_index)\n  is_grabbable = i_kind in world.grabbable_indices\n\n  if not (is_primitive_resource or is_special_collectible_environment or is_grabbable):\n      # The requested primitive is not collectible by means of a direct \"collect\" action.\n      # E.g., Workshops are locations, not items that can be collected into inventory.\n      return []\n\n  # 3. Check if the primitive is already in the agent's inventory.\n  if current_state.inventory[i_kind] > 0:\n      # Primitive is already collected, no actions needed.\n      return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # Delta coordinates for each direction (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT) relative to agent's position (row_delta, col_delta).\n  _DIRECTION_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row decreases, col stays same\n      1: (0, 1),  # RIGHT: row stays same, col increases\n      2: (1, 0),  # DOWN: row increases, col stays same\n      3: (0, -1)  # LEFT: row stays same, col decreases\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return []\n      # Calculate difference ensuring it's positive and within [0, 3] for turns.\n      diff = (target_dir - current_dir + 4) % 4\n      if diff == 1: # Clockwise turn (e.g., UP to RIGHT)\n          return [RIGHT_ACT]\n      elif diff == 3: # Counter-clockwise turn (e.g., UP to LEFT)\n          return [LEFT_ACT]\n      else: # diff == 2 (180-degree turn, e.g., UP to DOWN)\n          return [RIGHT_ACT, RIGHT_ACT] # Two right turns (or two left turns)\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The `visited` set tracks states already explored to prevent cycles and redundant work.\n  # A state is defined by (grid_hash, row, col, direction, inventory_tuple).\n  # `grid.tobytes()` is used for hashing the grid, ensuring distinct grid layouts are treated as distinct states.\n  # This is crucial because `USE_ACT` can modify the grid (e.g., removing a tree).\n  visited = set() \n\n  initial_inventory_tuple = tuple(current_state.inventory)\n  initial_grid_hash = hash(current_state.grid.tobytes()) \n\n  q.append((current_state, [])) # Queue stores (CraftState object, path_to_reach_this_state)\n  visited.add((initial_grid_hash, current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_rows, grid_cols, _ = current_state.grid.shape # Get grid dimensions as (rows, columns, kinds)\n\n  # Adaptive search limits:\n  # MAX_EXPLORED_STATES: Limits the total number of unique states processed to prevent\n  #                      runaway searches in very large or complex state spaces.\n  #                      Reverted factor from 150 (in v1) to 200 (from v0)\n  #                      to allow for more extensive exploration of grid/inventory permutations.\n  MAX_EXPLORED_STATES = grid_rows * grid_cols * 4 * 200 \n  \n  # MAX_PATH_LENGTH: Limits the length of any path considered. Set adaptively based on\n  #                  the grid dimensions, allowing for longer paths on larger maps,\n  #                  plus a buffer for turns and interactions. Reverted to v0's more\n  #                  generous (rows+cols)*7 to accommodate longer detours or sequences of interactions.\n  MAX_PATH_LENGTH = (grid_rows + grid_cols) * 7 \n\n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft()\n    explored_states_count += 1\n\n    # Pruning: If exploration limits are reached, stop exploring from this path.\n    # This prevents the search from becoming excessively long or consuming too much memory/time.\n    if explored_states_count > MAX_EXPLORED_STATES or len(path) >= MAX_PATH_LENGTH:\n      continue\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n\n    # List to store (next_state_object, actions_to_reach_next_state, inventory_before_last_action_applied)\n    # Storing 'inventory_before_last_action_applied' is crucial for detecting if the goal item\n    # was *specifically* acquired in the last step of a transition.\n    potential_next_transitions = []\n\n    # --- Generate all potential next states from the current state ---\n\n    # 1. Explore Movement Actions (UP, DOWN, LEFT, RIGHT)\n    for action in move_actions:\n        # Simulate step. The 'reward' is always 0.0 for this environment implementation.\n        # The 'inventory_before_move' is the current state's inventory, for later comparison.\n        inventory_before_move = np.copy(state.inventory)\n        _, next_state = state.step(action)\n        potential_next_transitions.append((next_state, path + [action], inventory_before_move))\n\n    # 2. Explore USE_ACT at the agent's current position.\n    # This covers collecting items directly from the cell the agent is standing on (e.g., grabbable items).\n    inventory_before_use_at_pos = np.copy(state.inventory)\n    grid_before_use_at_pos = np.copy(state.grid)\n    _, state_after_use_at_pos = state.step(USE_ACT)\n    \n    # Check if USE_ACT at current position resulted in a meaningful state change.\n    # A change implies interaction (e.g., item collected, grid modified).\n    state_changed_by_use_at_pos = not (\n        np.array_equal(state_after_use_at_pos.inventory, inventory_before_use_at_pos) and\n        state_after_use_at_pos.pos == state.pos and # Position usually unchanged by USE\n        state_after_use_at_pos.dir == state.dir and # Direction usually unchanged by USE\n        np.array_equal(state_after_use_at_pos.grid, grid_before_use_at_pos) # Grid can change if item removed/resource harvested\n    )\n    if state_changed_by_use_at_pos:\n        potential_next_transitions.append((state_after_use_at_pos, path + [USE_ACT], inventory_before_use_at_pos))\n    \n    # 3. Explore USE_ACT on adjacent cells (after turning to face them).\n    # This handles interacting with entities in the surrounding environment (e.g., chopping trees, mining rocks).\n    for target_dir_idx in range(4): # Iterate through all four possible facing directions (0, 1, 2, 3)\n        row_delta, col_delta = _DIRECTION_TO_DELTA_FRONT[target_dir_idx]\n        facing_r, facing_c = current_r + row_delta, current_c + col_delta\n\n        # Check if the cell the agent would face is within grid bounds AND contains any entity.\n        # This broad check is necessary because we don't know which specific entity yields the primitive\n        # without inspecting CraftState's internal logic for USE_ACT.\n        if (0 <= facing_r < grid_rows and 0 <= facing_c < grid_cols) and np.any(state.grid[facing_r, facing_c, :] == 1):\n            turns_to_face = _get_turning_actions(current_dir, target_dir_idx)\n            \n            # Simulate the turning actions to get to the correct orientation.\n            # Create a temporary state to apply turns without altering the 'state' from the queue.\n            temp_state_before_use = state \n            for turn_action in turns_to_face:\n                _, temp_state_before_use = temp_state_before_use.step(turn_action)\n            \n            # Capture inventory and grid states immediately before the final USE_ACT.\n            inventory_before_adj_use = np.copy(temp_state_before_use.inventory)\n            grid_before_adj_use = np.copy(temp_state_before_use.grid)\n            \n            # Perform the USE_ACT.\n            _, state_after_adj_use = temp_state_before_use.step(USE_ACT)\n            \n            # Check if USE_ACT on adjacent cell resulted in a meaningful state change.\n            state_changed_by_adj_use = not (\n                np.array_equal(state_after_adj_use.inventory, inventory_before_adj_use) and\n                state_after_adj_use.pos == temp_state_before_use.pos and\n                state_after_adj_use.dir == temp_state_before_use.dir and\n                np.array_equal(state_after_adj_use.grid, grid_before_adj_use)\n            )\n            if state_changed_by_adj_use:\n                potential_next_transitions.append(\n                    (state_after_adj_use, path + turns_to_face + [USE_ACT], inventory_before_adj_use)\n                )\n\n    # --- Process all generated potential next transitions ---\n    for next_s, next_p, inv_before_action in potential_next_transitions:\n        # First, check if the target primitive was successfully collected in this transition.\n        # This is the goal condition for the 'collect' function.\n        if next_s.inventory[i_kind] > inv_before_action[i_kind]:\n            return next_p # Goal achieved! Return the shortest path immediately (due to BFS property).\n\n        # If not the goal, add the new state to the queue if it hasn't been visited yet.\n        next_inventory_tuple = tuple(next_s.inventory)\n        next_grid_hash = hash(next_s.grid.tobytes())\n        next_state_key = (next_grid_hash, next_s.pos[0], next_s.pos[1], next_s.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((next_s, next_p))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state within the search limits.\n  return []", "island_id": 6, "scores": {"3": 2.5}}
