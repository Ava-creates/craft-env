{"timestamp": "2025-08-01T11:40:55.998833", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` to find and collect a primitive.\n    \n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect.\n\n    Returns:\n        List[int]: A sequence of action indices to execute.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state\n  \n  # Safeguard: If the environment state is not initialized, return an empty list.\n  if current_state is None:\n      return [] \n\n  # Get the integer ID for the target primitive from the cookbook index\n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  # Optimization: If the primitive is already in inventory, no actions are needed.\n  if current_state.inventory[primitive_id] > 0:\n      return []\n\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's current (row, column) tuple\n  initial_dir = current_state.dir # Agent's current facing direction (0:Right, 1:Up, 2:Left, 3:Down)\n  num_rows, num_cols, _ = initial_grid.shape # Extract grid dimensions\n\n  # Map symbolic actions from action_specs to their integer indices\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define changes in (row, col) for each direction (0:Right, 1:Up, 2:Left, 3:Down)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: +1 to column (col)\n      1: (-1, 0),  # Facing UP: -1 to row (row)\n      2: (0, -1),  # Facing LEFT: -1 to column (col)\n      3: (1, 0)    # Facing DOWN: +1 to row (row)\n  }\n\n  # Define how direction changes when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Get indices of entities that block agent movement (non-grabbable/non-walkable terrain/objects)\n  # The primitive itself is typically not walkable, as the agent needs to be adjacent to collect it.\n  non_walkable_for_movement_set = set(current_state.world.non_grabbable_indices)\n  non_walkable_for_movement_set.add(primitive_id) \n  \n  # Convert to a numpy array for efficient indexing in the `_is_cell_walkable` check\n  non_walkable_for_movement_indices = np.array(list(non_walkable_for_movement_set), dtype=int)\n\n  # Helper function to check if a cell is walkable using numpy array indexing\n  # Defined as a nested function to use `initial_grid`, `num_rows`, `num_cols`, and `non_walkable_for_movement_indices`\n  def _is_cell_walkable_optimized(r, c):\n      \"\"\"Checks if the cell at (r, c) is within bounds and doesn't contain non-walkable items.\"\"\"\n      if not (0 <= r < num_rows and 0 <= c < num_cols):\n          return False # Out of bounds\n      \n      # Check if any non-walkable item exists in this cell using numpy.any for efficiency\n      # Only perform this check if there are actual non-walkable indices to check against.\n      if len(non_walkable_for_movement_indices) > 0 and np.any(initial_grid[r, c, non_walkable_for_movement_indices] > 0):\n          return False # Contains a non-walkable item\n      return True\n\n  # BFS state representation: ((current_row, current_col), current_direction_int)\n  # Queue stores (state, list_of_actions_to_reach_this_state)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (state) to avoid redundant computations and cycles\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the action sequence leading to the state\n                      # where the agent is adjacent to the primitive and facing it.\n\n  while queue:\n      (current_pos, current_dir), path_to_current_state = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent at current state\n      # Calculate the coordinates of the cell directly in front of the agent\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the cell in front is within grid bounds AND contains the primitive\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols and\n          initial_grid[front_r, front_c, primitive_id] > 0):\n          \n          target_path = path_to_current_state\n          break # Found the path to be adjacent and facing the primitive\n\n      # 2. Explore possible next actions from the current state (Move Forward, Turn Left, Turn Right)\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if the next position is valid and has not been visited with this direction\n      if (next_pos, next_dir) not in visited:\n          # Use the optimized helper to check walkability\n          if _is_cell_walkable_optimized(next_r, next_c):\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_to_current_state + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_to_current_state + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_to_current_state + [TURN_RIGHT_ACTION]))\n\n  # If a path was found to reach an adjacent and facing position, append the USE action\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 1, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T11:40:57.208278", "function_name": "collect", "function_body": "  \"\"\"Returns a list of actions to find and collect the primitive in the passed env.\n    \n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect.\n\n    Returns:\n        List[int]: A sequence of action indices to execute. Returns an empty list\n                   if the primitive is already in the inventory or if it's unreachable.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's current (row, column) tuple\n  initial_dir = current_state.dir # Agent's current facing direction (0:Right, 1:Up, 2:Left, 3:Down)\n\n  # Get the integer ID for the target primitive from the cookbook index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  num_rows, num_cols, _ = initial_grid.shape # Extract grid dimensions\n\n  # Early exit: If the primitive is already in inventory, no actions are needed.\n  # This avoids unnecessary pathfinding if the goal is already met.\n  if current_state.inventory[primitive_id] > 0:\n      return []\n\n  # Map symbolic actions from action_specs to their integer indices\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define changes in (row, col) for each direction (0:Right, 1:Up, 2:Left, 3:Down)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: +1 to column (col)\n      1: (-1, 0),  # Facing UP: -1 to row (row)\n      2: (0, -1),  # Facing LEFT: -1 to column (col)\n      3: (1, 0)    # Facing DOWN: +1 to row (row)\n  }\n\n  # Define how direction changes when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Get indices of entities that block agent movement (non-grabbable/non-walkable terrain/objects)\n  # The primitive itself is typically not walkable, as the agent needs to be adjacent to collect it.\n  # This set prevents the agent from pathing *onto* these types of entities.\n  non_walkable_for_movement_set = set(current_state.world.non_grabbable_indices)\n  non_walkable_for_movement_set.add(primitive_id) # Add the target primitive itself to the blocking set\n  \n  # Convert to a numpy array for efficient indexing in the `_is_cell_walkable` check\n  non_walkable_for_movement_indices = np.array(list(non_walkable_for_movement_set), dtype=int)\n\n\n  # BFS state representation: ((current_row, current_col), current_direction_int)\n  # Queue stores (state, list_of_actions_to_reach_this_state)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (state) to avoid redundant computations and cycles\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the action sequence leading to the state\n                      # where the agent is adjacent to the primitive and facing it.\n\n  # Helper function to check if a cell is walkable using numpy array indexing\n  def _is_cell_walkable_optimized(r, c, grid, rows, cols, non_walkable_idx_array):\n      \"\"\"Checks if the cell at (r, c) is within bounds and doesn't contain non-walkable items.\"\"\"\n      if not (0 <= r < rows and 0 <= c < cols):\n          return False # Out of bounds\n      \n      # Check if any non-walkable item exists in this cell using numpy.any for efficiency\n      # This checks if any of the specified `non_walkable_idx_array` kinds are present\n      # in the cell `(r, c)` with a count greater than 0.\n      if non_walkable_idx_array.size > 0 and np.any(grid[r, c, non_walkable_idx_array] > 0):\n          return False # Contains a non-walkable item\n      return True\n\n  while queue:\n      (current_pos, current_dir), path_to_current_state = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent at current state\n      # This is the goal condition: being adjacent to and facing the primitive.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the cell in front is within grid bounds AND contains the primitive\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols and\n          initial_grid[front_r, front_c, primitive_id] > 0):\n          \n          target_path = path_to_current_state\n          break # Found the path to be adjacent and facing the primitive\n\n      # 2. Explore possible next actions from the current state (Move Forward, Turn Left, Turn Right)\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if the next position is valid and has not been visited with this direction\n      if (next_pos, next_dir) not in visited:\n          # Use the optimized helper to check walkability before adding to queue\n          if _is_cell_walkable_optimized(next_r, next_c, initial_grid, num_rows, num_cols, non_walkable_for_movement_indices):\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_to_current_state + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_to_current_state + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_to_current_state + [TURN_RIGHT_ACTION]))\n\n  # If a path was found to reach an adjacent and facing position, append the USE action\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 1, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T11:42:45.372878", "function_name": "collect", "function_body": "  \"\"\"Returns a list of actions to find and collect the primitive in the passed env.\n    \n    This version implements a Breadth-First Search (BFS) to find the shortest\n    sequence of actions. It explicitly considers both movement and 'USE' actions\n    for collecting resources or interacting with the environment to facilitate\n    future collection. The state in the BFS includes position, direction, and inventory.\n\n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect (e.g., \"wood\", \"stone\").\n\n    Returns:\n        List[int]: A sequence of action indices to execute to collect the primitive.\n                   Returns an empty list if the primitive is already in inventory\n                   or cannot be found/collected.\n  \"\"\"\n  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized (e.g., misspelled), it cannot be collected.\n    return []\n\n  # 2. Semantic check: Determine if this primitive is *actually* collectible into inventory.\n  # This filters out non-grabbable environment features (like workshops, boundaries)\n  # that are not intended to be \"collected\" as inventory items.\n  # \"Collectible\" here means either a primitive resource (like wood, iron),\n  # special environment items that can be collected (water, stone),\n  # or general grabbable items (like tools or crafted items found on the ground).\n  is_primitive_resource = i_kind in world.cookbook.primitives\n  is_special_collectible_environment = (i_kind == world.water_index or i_kind == world.stone_index)\n  is_grabbable = i_kind in world.grabbable_indices # Items that can be picked up directly\n\n  if not (is_primitive_resource or is_special_collectible_environment or is_grabbable):\n      return []\n\n  # 3. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n\n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n\n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set stores a unique key for each state to prevent cycles and redundant exploration.\n  # A state is defined by (agent_row, agent_col, agent_direction, tuple_of_inventory_counts).\n  # Inventory is included because collecting items (e.g., tools) changes the available actions.\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, [])) # Queue stores (CraftState object, path_to_this_state)\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Set a heuristic upper bound for explored states to prevent excessively long searches\n  # in complex scenarios. This value can be tuned based on typical grid sizes.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 150 # (pos_x * pos_y * num_directions * multiplier)\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    \n    # Optional pruning to limit search depth/breadth.\n    # If the search space is too large, this prevents OOM or very long execution.\n    if len(visited) > MAX_EXPLORED_STATES: \n      continue # Skip further processing for this path if we've explored too much.\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n\n    # --- Immediate Goal Check 1: Check for collection by using USE_ACT at the current position. ---\n    # This covers picking up items the agent is standing on (e.g., grabbable items like TOOLS).\n    inventory_before_use_at_pos = np.copy(state.inventory)\n    _, state_after_use_at_pos = state.step(USE_ACT) # Simulate USE action\n    \n    # If the target primitive's count increased in inventory, we found a direct path.\n    if state_after_use_at_pos.inventory[i_kind] > inventory_before_use_at_pos[i_kind]:\n        return path + [USE_ACT] # Return the path including the successful USE action\n\n    # --- Immediate Goal Check 2: Check for collection by turning and then using USE_ACT on an adjacent cell. ---\n    # This covers interacting with resources like wood, stone, water, or objects like workshops\n    # that produce the primitive when used.\n    for target_dir in range(4): # Iterate through all four possible facing directions\n        dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n        facing_r, facing_c = current_r + dr, current_c + dc\n\n        # Ensure the cell in front is within grid bounds.\n        if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height):\n            # Check if there's *any* item or entity at the facing cell that could potentially\n            # be interacted with (i.e., not an empty cell).\n            if np.any(state.grid[facing_r, facing_c, :] == 1):\n                # Simulate the turning actions required to face the potential source.\n                temp_state_after_turns = state # Start simulation from the current state\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                for turn_action in turns_to_face:\n                    # Apply each turning action sequentially\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use_after_turn = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action on the cell in front.\n                _, state_after_use_after_turn = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the *target primitive* in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed, resource depletion) implemented within `CraftState.step`).\n                if state_after_use_after_turn.inventory[i_kind] > inventory_before_use_after_turn[i_kind]:\n                    return path + turns_to_face + [USE_ACT] # Path found!\n\n    # --- Explore successor states by adding them to the queue for further exploration. ---\n    # This covers general movement and 'USE' actions that might change the state\n    # without immediately yielding the target primitive, but might enable it later.\n\n    # 1. Explore movement actions (UP, DOWN, LEFT, RIGHT).\n    for action in move_actions:\n      _, next_state = state.step(action) # Simulate the movement\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action])) # Add to queue for exploration\n\n    # 2. Explore `USE_ACT` at the current position if it results in a meaningful state change.\n    # (e.g., using a tool on oneself, or picking up something other than the target primitive).\n    # `state_after_use_at_pos` and `inventory_before_use_at_pos` are already computed.\n    state_changed_by_use_at_pos = not (\n        np.array_equal(state_after_use_at_pos.inventory, inventory_before_use_at_pos) and\n        state_after_use_at_pos.pos == state.pos and # Position usually doesn't change on USE\n        state_after_use_at_pos.dir == state.dir     # Direction usually doesn't change on USE\n    )\n    next_inventory_tuple_after_use_at_pos = tuple(state_after_use_at_pos.inventory)\n    next_state_key_after_use_at_pos = (state_after_use_at_pos.pos[0], state_after_use_at_pos.pos[1], state_after_use_at_pos.dir, next_inventory_tuple_after_use_at_pos)\n\n    if state_changed_by_use_at_pos and next_state_key_after_use_at_pos not in visited:\n        visited.add(next_state_key_after_use_at_pos)\n        q.append((state_after_use_at_pos, path + [USE_ACT]))\n\n    # 3. Explore `USE_ACT` after turning to an adjacent cell, if it results in a meaningful state change.\n    # This covers interactions that might clear a path, yield a different item, or activate a workshop.\n    for target_dir in range(4):\n        dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n        facing_r, facing_c = current_r + dr, current_c + dc\n\n        if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height):\n            if np.any(state.grid[facing_r, facing_c, :] == 1): # Check if something is there to interact with\n                temp_state_after_turns = state # Start simulation from current state\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                inventory_before_use_after_turn = np.copy(temp_state_after_turns.inventory)\n                _, state_after_use_after_turn = temp_state_after_turns.step(USE_ACT)\n\n                state_changed_by_use_after_turn = not (\n                    np.array_equal(state_after_use_after_turn.inventory, inventory_before_use_after_turn) and\n                    state_after_use_after_turn.pos == temp_state_after_turns.pos and\n                    state_after_use_after_turn.dir == temp_state_after_turns.dir\n                )\n                \n                next_inventory_tuple_after_use_after_turn = tuple(state_after_use_after_turn.inventory)\n                next_state_key_after_use_after_turn = (state_after_use_after_turn.pos[0], state_after_use_after_turn.pos[1], state_after_use_after_turn.dir, next_inventory_tuple_after_use_after_turn)\n\n                # Add to queue if the state changed meaningfully and it's a new (unvisited) state.\n                if state_changed_by_use_after_turn and next_state_key_after_use_after_turn not in visited:\n                    visited.add(next_state_key_after_use_after_turn)\n                    q.append((state_after_use_after_turn, path + turns_to_face + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T11:42:53.024707", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` by refactoring state computations.\"\"\"\n  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Semantic check: Determine if this primitive is *actually* collectible into inventory.\n  is_primitive_resource = i_kind in world.cookbook.primitives\n  is_special_collectible_environment = (i_kind == world.water_index or i_kind == world.stone_index)\n  is_grabbable = i_kind in world.grabbable_indices\n\n  if not (is_primitive_resource or is_special_collectible_environment or is_grabbable):\n      return []\n\n  # 3. Check if the primitive is already in the agent's inventory.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP\n      1: (0, 1),  # RIGHT\n      2: (1, 0),  # DOWN\n      3: (0, -1)  # LEFT\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return []\n      diff = (target_dir - current_dir + 4) % 4\n      if diff == 1:\n          return [RIGHT_ACT]\n      elif diff == 3:\n          return [LEFT_ACT]\n      else: # diff == 2 (180-degree turn)\n          return [RIGHT_ACT, RIGHT_ACT]\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  visited = set() # Stores (row, col, direction, inventory_tuple)\n\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Set a heuristic upper bound for explored states to prevent excessively long searches.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 150 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft()\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n\n    # --- Pre-simulate and cache outcomes of potential USE_ACT actions from the current state ---\n    # Case 1: USE_ACT at the current agent position\n    inventory_before_use_at_pos = np.copy(state.inventory)\n    _, state_after_use_at_pos = state.step(USE_ACT)\n    \n    # Case 2: USE_ACT after turning to face adjacent cells\n    # Stores (state_after_use_action, actions_to_perform_use, inventory_before_use_step, state_before_use_step)\n    simulated_adjacent_uses = []\n    for target_dir in range(4):\n        dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n        facing_r, facing_c = current_r + dr, current_c + dc\n\n        # Check if the facing cell is within bounds and contains any entity that might be interactable.\n        if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height) and np.any(state.grid[facing_r, facing_c, :] == 1):\n            turns_to_face = _get_turning_actions(current_dir, target_dir)\n            \n            # Simulate turns to get the state right before the final USE_ACT.\n            temp_state_before_use_step = state\n            for turn_action in turns_to_face:\n                _, temp_state_before_use_step = temp_state_before_use_step.step(turn_action)\n            \n            inventory_before_adj_use = np.copy(temp_state_before_use_step.inventory)\n            _, state_after_adj_use = temp_state_before_use_step.step(USE_ACT)\n            \n            simulated_adjacent_uses.append(\n                (state_after_adj_use, turns_to_face + [USE_ACT], inventory_before_adj_use, temp_state_before_use_step)\n            )\n\n    # --- Goal Checking Phase (Prioritize paths that immediately yield the primitive) ---\n    # 1. Check if USE at current position yields the primitive\n    if state_after_use_at_pos.inventory[i_kind] > inventory_before_use_at_pos[i_kind]:\n        return path + [USE_ACT]\n\n    # 2. Check if USE at an adjacent position (after turning) yields the primitive\n    for s_adj_use, a_adj_use, inv_before_adj_use, _ in simulated_adjacent_uses:\n        if s_adj_use.inventory[i_kind] > inv_before_adj_use[i_kind]:\n            return path + a_adj_use\n\n    # --- Exploration Phase (Add new, unique states to the queue) ---\n    # 1. Explore movement actions\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # 2. Explore USE at current position (if it led to a state change and is a new state)\n    use_at_pos_changed_state = not (\n        np.array_equal(state_after_use_at_pos.inventory, inventory_before_use_at_pos) and\n        state_after_use_at_pos.pos == state.pos and\n        state_after_use_at_pos.dir == state.dir\n    )\n    next_inventory_tuple_after_use_at_pos = tuple(state_after_use_at_pos.inventory)\n    next_state_key_after_use_at_pos = (state_after_use_at_pos.pos[0], state_after_use_at_pos.pos[1], state_after_use_at_pos.dir, next_inventory_tuple_after_use_at_pos)\n\n    if use_at_pos_changed_state and next_state_key_after_use_at_pos not in visited:\n        visited.add(next_state_key_after_use_at_pos)\n        q.append((state_after_use_at_pos, path + [USE_ACT]))\n    \n    # 3. Explore USE at adjacent cells (if it led to a state change and is a new state)\n    for s_adj_use, a_adj_use, inv_before_adj_use, temp_state_before_adj_use_step in simulated_adjacent_uses:\n        # Check if the state (inventory, position, direction, or grid implicitly) changed as a result of the USE action.\n        state_changed_by_adj_use = not (\n            np.array_equal(s_adj_use.inventory, inv_before_adj_use) and\n            s_adj_use.pos == temp_state_before_adj_use_step.pos and\n            s_adj_use.dir == temp_state_before_adj_use_step.dir\n        )\n        \n        next_inventory_tuple_after_adj_use = tuple(s_adj_use.inventory)\n        next_state_key_after_adj_use = (s_adj_use.pos[0], s_adj_use.pos[1], s_adj_use.dir, next_inventory_tuple_after_adj_use)\n\n        if state_changed_by_adj_use and next_state_key_after_adj_use not in visited:\n            visited.add(next_state_key_after_adj_use)\n            q.append((s_adj_use, path + a_adj_use))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 6, "scores": {"3": 2.0}}
{"timestamp": "2025-08-01T11:43:47.084469", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Determine if the primitive is a type that can be collected via the 'USE' action.\n  # This includes explicit primitive resources (from cookbook), grabbable items, water, or stone.\n  is_collectible_via_use = (\n      i_kind in world.cookbook.primitives or \n      i_kind in world.grabbable_indices or\n      i_kind == world.water_index or\n      i_kind == world.stone_index\n  )\n\n  # If the item is not intended to be collected via 'USE', return an empty path.\n  # This acts as an early exit for truly non-collectible primitives like boundaries.\n  # Workshops are handled implicitly by the BFS if crafting there is a prerequisite.\n  if not is_collectible_via_use and i_kind not in world.workshop_indices: # Ensure workshops aren't prematurely filtered\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set includes the agent's inventory as part of the state key,\n  # allowing the algorithm to distinguish states that are identical in position/direction\n  # but differ in inventory (e.g., having a tool vs. not).\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Increased MAX_EXPLORED_STATES due to the larger state space when tracking inventory\n  # and considering workshop interactions. This heuristic limit helps prevent excessive \n  # computation in complex or unreachable scenarios.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 30 # Increased multiplier from 20 to 30 for v2\n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`).\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the general 'USE' action from the current state.\n    # This is essential for picking up other grabbable items (like tools)\n    # or for crafting at workshops that are not the target primitive itself\n    # but might be necessary preconditions.\n    \n    is_action_use_applicable = False\n\n    # Check 1: Is there something interactable directly in front of the agent?\n    front_dr, front_dc = _DIR_TO_DELTA_FRONT[current_dir]\n    facing_r, facing_c = current_r + front_dr, current_c + front_dc\n\n    if 0 <= facing_r < grid_width and 0 <= facing_c < grid_height:\n        # Check for grabbable items, water, or stone in front.\n        for k_idx in world.grabbable_indices:\n            if state.grid[facing_r, facing_c, k_idx] == 1:\n                is_action_use_applicable = True\n                break\n        if not is_action_use_applicable and (state.grid[facing_r, facing_c, world.water_index] == 1 or \n                                              state.grid[facing_r, facing_c, world.stone_index] == 1):\n            is_action_use_applicable = True\n        \n        # Check for any primitive resources in front that might be collected by USE (e.g., WOOD, IRON).\n        if not is_action_use_applicable:\n            for kind_idx_at_cell in range(state.grid.shape[2]): \n                if state.grid[facing_r, facing_c, kind_idx_at_cell] == 1 and\\\n                   kind_idx_at_cell in world.cookbook.primitives:\n                    is_action_use_applicable = True\n                    break\n    \n    # Check 2 (NEW for v2): Is the agent standing on a workshop?\n    # The 'USE' action can also trigger crafting if the agent is positioned on a workshop tile.\n    if not is_action_use_applicable: # Only check this if not already applicable by front cell\n        for workshop_idx in world.workshop_indices:\n            if state.grid[current_r, current_c, workshop_idx] == 1:\n                is_action_use_applicable = True\n                break\n\n    # Only attempt USE_ACT if `is_action_use_applicable` is True.\n    if is_action_use_applicable:\n        inventory_before_any_use = np.copy(state.inventory)\n        _, state_after_current_use = state.step(USE_ACT)\n        \n        # Add to queue only if the USE action resulted in a meaningful state change.\n        # A meaningful change means inventory or position/direction was updated.\n        # Inventory change is the primary signal for resource collection/crafting.\n        if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n                state_after_current_use.pos == state.pos and\n                state_after_current_use.dir == state.dir):\n\n            next_inventory_tuple = tuple(state_after_current_use.inventory)\n            next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n            if next_state_key not in visited:\n                visited.add(next_state_key)\n                q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T11:43:49.276101", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the world's cookbook index.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized in the world's vocabulary, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already present in the agent's inventory.\n  # If so, it is already \"collected,\" and no actions are required.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Determine if the primitive is a type that can be collected via the 'USE' action.\n  # This includes explicit primitive resources defined in the cookbook, any grabbable items,\n  # and specific environmental resources like water or stone.\n  is_collectible_via_use = (\n      i_kind in world.cookbook.primitives or\n      i_kind in world.grabbable_indices or\n      i_kind == world.water_index or\n      i_kind == world.stone_index\n  )\n\n  # If the item is not designated as collectible via 'USE' (e.g., boundaries, workshops that aren't also primitives),\n  # then return an empty path as it cannot be collected by this function.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers for movements and interaction, and directional deltas.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # Map agent's direction (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT) to corresponding (row_change, col_change)\n  # to identify the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP (North)\n      1: (0, 1),  # RIGHT (East)\n      2: (1, 0),  # DOWN (South)\n      3: (0, -1)  # LEFT (West)\n  }\n\n  # Helper function to calculate the minimal sequence of turn actions\n  # required to change from the current_dir to the target_dir.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the desired direction.\n\n      # Calculate the difference in directions, ensuring a positive result by adding 4 and modulo 4.\n      diff = (target_dir - current_dir + 4) % 4\n\n      if diff == 1: # Target is one step clockwise (e.g., 0->1, 1->2, 2->3, 3->0).\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., 0->3, 1->0, etc.).\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., 0->2, 1->3).\n          return [RIGHT_ACT, RIGHT_ACT] # Two successive right turns (or two left turns).\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The `visited` set tracks states as a tuple `(row, col, direction, inventory_tuple)`.\n  # Including the inventory is crucial for problems where acquiring intermediate items (like tools)\n  # changes the set of possible actions or outcomes.\n  visited = set()\n\n  # Add the initial state to the queue and visited set.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, [])) # Queue stores (CraftState object, list of actions to reach it)\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, n_kinds = current_state.grid.shape\n  # Heuristic limit for the number of distinct states to explore.\n  # This prevents the BFS from running indefinitely in highly complex or effectively unreachable scenarios.\n  # The multiplier is increased to allow for more extensive exploration given inventory changes.\n  MAX_EXPLORED_STATES_MULTIPLIER = 40 # Increased from 20 in v1\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * MAX_EXPLORED_STATES_MULTIPLIER\n  explored_states_count = 0\n\n  # Pre-compute a boolean mask for efficient checking of any `useable` item (via general USE action)\n  # in a grid cell. This includes grabbable items, water, stone, and any cookbook primitives.\n  all_interactable_kinds_mask = np.zeros(n_kinds, dtype=bool)\n  for idx in world.grabbable_indices:\n      if 0 <= idx < n_kinds:\n          all_interactable_kinds_mask[idx] = True\n  if 0 <= world.water_index < n_kinds:\n      all_interactable_kinds_mask[world.water_index] = True\n  if 0 <= world.stone_index < n_kinds:\n      all_interactable_kinds_mask[world.stone_index] = True\n  for idx in world.cookbook.primitives:\n      if 0 <= idx < n_kinds:\n          all_interactable_kinds_mask[idx] = True\n\n  # 6. BFS Loop: Continues until the queue is empty or the goal is found.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and its associated action path.\n    explored_states_count += 1\n\n    # Pruning: If the exploration limit is reached, skip further processing for this path.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n\n    # Goal Check: Can the target primitive be collected from the current `state`?\n    # This involves checking if the primitive is in the agent's 3x3 neighborhood.\n    if state.next_to(i_kind):\n        # If it's nearby, iterate through all four cardinal directions to check if it's directly in front.\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell directly in front is within grid bounds and contains the target primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and\n                state.grid[facing_r, facing_c, i_kind] == 1):\n\n                # Calculate and apply the turning actions required to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state\n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Record inventory *before* attempting the 'USE' action. This is crucial\n                # to verify if the 'USE' action successfully collected the item.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action on the temporary state.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Crucial verification: Check if the count of the target primitive in inventory\n                # actually increased after the 'USE' action. This confirms successful collection,\n                # accounting for any game rules (e.g., requiring tools) handled by `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT] # Found a valid path to collect the primitive!\n\n    # Explore possible future states by performing movement actions.\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      # If this next state (position, direction, and inventory) has not been visited, add it to the queue.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n\n    # Explore the general 'USE' action from the current state.\n    # This is vital for scenarios where using an item at the current location (e.g., picking up a tool,\n    # or crafting at a workshop) might enable subsequent collection steps for the target primitive.\n    \n    # Determine the cell directly in front of the agent (where a 'USE' action would primarily apply).\n    front_dr, front_dc = _DIR_TO_DELTA_FRONT[current_dir]\n    facing_r, facing_c = current_r + front_dr, current_c + front_dc\n\n    is_something_useable_in_front = False\n    # Check if the cell in front is within bounds.\n    if 0 <= facing_r < grid_width and 0 <= facing_c < grid_height:\n        # Utilize the pre-computed mask to efficiently check if *any* interactable item\n        # (grabbable, water, stone, or cookbook primitive) is present in the cell directly in front.\n        is_something_useable_in_front = np.any(state.grid[facing_r, facing_c, all_interactable_kinds_mask])\n    \n    # Additionally, check if the agent is standing on a workshop, as 'USE' might apply there (e.g., for crafting).\n    is_standing_on_workshop = np.any(state.grid[current_r, current_c, list(world.workshop_indices)])\n\n    # Only attempt the 'USE' action if there's something potentially interactable in front\n    # OR if the agent is standing on a workshop.\n    if is_something_useable_in_front or is_standing_on_workshop:\n        inventory_before_any_use = np.copy(state.inventory) # Snapshot inventory before this general USE\n        _, state_after_current_use = state.step(USE_ACT)\n        \n        # Add to the queue only if the 'USE' action resulted in a meaningful state change.\n        # A meaningful change implies inventory modification or a change in position/direction.\n        # This prevents exploring redundant states where 'USE' had no effect (e.g., using nothing).\n        if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n                state_after_current_use.pos == state.pos and\n                state_after_current_use.dir == state.dir):\n\n            next_inventory_tuple = tuple(state_after_current_use.inventory)\n            next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n            if next_state_key not in visited:\n                visited.add(next_state_key)\n                q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS loop completes and no path to collect the primitive was found,\n  # it means the primitive is currently unreachable from the initial state given the agent's capabilities.\n  return []", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T11:45:20.982692", "function_name": "collect", "function_body": "  import numpy as np\n  import collections\n\n  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Semantic check: Determine if this primitive is *actually* collectible into inventory.\n  is_primitive_resource = i_kind in world.cookbook.primitives\n  is_special_collectible_environment = (i_kind == world.water_index or i_kind == world.stone_index)\n  is_grabbable = i_kind in world.grabbable_indices\n\n  if not (is_primitive_resource or is_special_collectible_environment or is_grabbable):\n      return []\n\n  # 3. Check if the primitive is already in the agent's inventory.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP\n      1: (0, 1),  # RIGHT\n      2: (1, 0),  # DOWN\n      3: (0, -1)  # LEFT\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return []\n      diff = (target_dir - current_dir + 4) % 4\n      if diff == 1:\n          return [RIGHT_ACT]\n      elif diff == 3:\n          return [LEFT_ACT]\n      else: # diff == 2 (180-degree turn)\n          return [RIGHT_ACT, RIGHT_ACT]\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  visited = set() # Stores (row, col, direction, inventory_tuple)\n\n  initial_inventory_tuple = tuple(current_state.inventory)\n  initial_state_key = (current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple)\n  \n  q.append((current_state, []))\n  visited.add(initial_state_key)\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Set a heuristic upper bound for explored states to prevent excessively long searches.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 150 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft()\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    current_inventory_snapshot = np.copy(state.inventory) # Snapshot for 'before' comparisons\n    current_state_key_for_comparison = (current_r, current_c, current_dir, tuple(current_inventory_snapshot))\n\n    # List to store (next_state_object, actions_taken_from_current_state, inventory_before_last_action)\n    # The last element `inventory_before_last_action` is crucial for checking if `i_kind` increased\n    # specifically due to the *last* action in `actions_taken_from_current_state`.\n    transitions_to_process = []\n\n    # --- Generate all possible one-step transitions from the current state ---\n\n    # 1. Movement actions\n    for action in move_actions:\n        _, next_s = state.step(action)\n        transitions_to_process.append((next_s, [action], current_inventory_snapshot))\n\n    # 2. USE_ACT at current position\n    _, next_s_use_at_pos = state.step(USE_ACT)\n    transitions_to_process.append((next_s_use_at_pos, [USE_ACT], current_inventory_snapshot))\n\n    # 3. USE_ACT after turning to an adjacent cell\n    for target_dir in range(4):\n        dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n        facing_r, facing_c = current_r + dr, current_c + dc\n\n        # Check if the facing cell is within bounds and contains any entity that might be interactable.\n        if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height) and np.any(state.grid[facing_r, facing_c, :] == 1):\n            turns_to_face = _get_turning_actions(current_dir, target_dir)\n            \n            # Simulate turns to get the state right before the final USE_ACT.\n            # In CraftWorld, turns do not change inventory or grid, only direction and position.\n            temp_state_before_use_step = state \n            for turn_action in turns_to_face:\n                _, temp_state_before_use_step = temp_state_before_use_step.step(turn_action)\n            \n            # Inventory right before the final USE action (after any turns)\n            inventory_before_adj_use_action = np.copy(temp_state_before_use_step.inventory)\n            _, state_after_adj_use = temp_state_before_use_step.step(USE_ACT)\n            \n            transitions_to_process.append(\n                (state_after_adj_use, turns_to_face + [USE_ACT], inventory_before_adj_use_action)\n            )\n\n    # --- Process all generated transitions: check goal, then add to queue if new ---\n    for next_state, actions_seq_from_current, inventory_before_last_action in transitions_to_process:\n        # Check if the target primitive was collected\n        if next_state.inventory[i_kind] > inventory_before_last_action[i_kind]:\n            return path + actions_seq_from_current\n\n        # If not collected, check if this is a new and valid state to explore further\n        next_inventory_tuple = tuple(next_state.inventory)\n        next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n        # Only add to queue if this resulting state is genuinely new and different from the current one\n        # This prevents adding \"no-op\" transitions that don't change the observable state\n        # (position, direction, inventory) and have already been visited.\n        if next_state_key != current_state_key_for_comparison and next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((next_state, path + actions_seq_from_current))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 6, "scores": {"3": 2.0}}
{"timestamp": "2025-08-01T11:45:28.582759", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Semantic check: Determine if this primitive is *actually* collectible into inventory.\n  is_primitive_resource = i_kind in world.cookbook.primitives\n  is_special_collectible_environment = (i_kind == world.water_index or i_kind == world.stone_index)\n  is_grabbable = i_kind in world.grabbable_indices\n\n  if not (is_primitive_resource or is_special_collectible_environment or is_grabbable):\n      return []\n\n  # 3. Check if the primitive is already in the agent's inventory.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP\n      1: (0, 1),  # RIGHT\n      2: (1, 0),  # DOWN\n      3: (0, -1)  # LEFT\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return []\n      diff = (target_dir - current_dir + 4) % 4\n      if diff == 1:\n          return [RIGHT_ACT]\n      elif diff == 3:\n          return [LEFT_ACT]\n      else: # diff == 2 (180-degree turn)\n          return [RIGHT_ACT, RIGHT_ACT]\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  visited = set() # Stores (row, col, direction, inventory_tuple)\n\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Set a heuristic upper bound for explored states to prevent excessively long searches.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 150 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft()\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n\n    # List to store (next_state_object, actions_to_reach_next_state, inventory_before_last_action_applied)\n    # This allows us to check if the goal item was acquired in the last step.\n    potential_next_transitions = []\n\n    # --- Generate all potential next states from the current state ---\n\n    # 1. Explore Movement Actions (UP, DOWN, LEFT, RIGHT)\n    for action in move_actions:\n        _, next_state = state.step(action)\n        # For movement, the 'inventory_before_action' is just the current state's inventory.\n        potential_next_transitions.append((next_state, path + [action], np.copy(state.inventory)))\n\n    # 2. Explore USE_ACT at current position\n    inventory_before_use_at_pos = np.copy(state.inventory)\n    _, state_after_use_at_pos = state.step(USE_ACT)\n    # Only add this transition if the state actually changed (e.g., something was picked up, or grid modified)\n    state_changed_by_use_at_pos = not (\n        np.array_equal(state_after_use_at_pos.inventory, inventory_before_use_at_pos) and\n        state_after_use_at_pos.pos == state.pos and\n        state_after_use_at_pos.dir == state.dir\n    )\n    if state_changed_by_use_at_pos:\n        potential_next_transitions.append((state_after_use_at_pos, path + [USE_ACT], inventory_before_use_at_pos))\n    \n    # 3. Explore USE_ACT on adjacent cells (after turning)\n    for target_dir in range(4): # Iterate through possible facing directions\n        dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n        facing_r, facing_c = current_r + dr, current_c + dc\n\n        # Check if the facing cell is within bounds and contains any interactable entity.\n        if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height) and np.any(state.grid[facing_r, facing_c, :] == 1):\n            turns_to_face = _get_turning_actions(current_dir, target_dir)\n            \n            # Simulate turns to get the state right before the final USE_ACT.\n            temp_state_before_use_step = state\n            for turn_action in turns_to_face:\n                _, temp_state_before_use_step = temp_state_before_use_step.step(turn_action)\n            \n            inventory_before_adj_use = np.copy(temp_state_before_use_step.inventory)\n            _, state_after_adj_use = temp_state_before_use_step.step(USE_ACT)\n            \n            # Only add this transition if the state actually changed as a result of the USE action.\n            state_changed_by_adj_use = not (\n                np.array_equal(state_after_adj_use.inventory, inventory_before_adj_use) and\n                state_after_adj_use.pos == temp_state_before_use_step.pos and\n                state_after_adj_use.dir == temp_state_before_use_step.dir\n            )\n            if state_changed_by_adj_use:\n                potential_next_transitions.append(\n                    (state_after_adj_use, path + turns_to_face + [USE_ACT], inventory_before_adj_use)\n                )\n\n    # --- Process all generated potential next transitions ---\n    for next_s, next_p, inv_before_action in potential_next_transitions:\n        # Check if the target primitive was successfully collected in this transition.\n        if next_s.inventory[i_kind] > inv_before_action[i_kind]:\n            return next_p # Goal achieved! Return the path immediately.\n\n        # If not the goal, add to queue if this exact state hasn't been visited.\n        next_inventory_tuple = tuple(next_s.inventory)\n        next_state_key = (next_s.pos[0], next_s.pos[1], next_s.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((next_s, next_p))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 6, "scores": {"3": 2.0}}
{"timestamp": "2025-08-01T11:47:54.636898", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # IMPROVEMENT for v2: The 'visited' set now includes the hash of the grid state\n  # in addition to position, direction, and inventory. This makes the search\n  # more robust to 'USE' actions that modify the grid (e.g., clearing obstacles)\n  # but may not directly change the agent's inventory, position, or direction.\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  initial_grid_hash = hash(current_state.grid.tobytes()) # Hash grid for initial state\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple, initial_grid_hash))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Increased MAX_EXPLORED_STATES significantly due to the much larger state space\n  # when tracking grid hash. This is a heuristic and may need tuning.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 50 # Increased multiplier\n\n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`).\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell we are facing is within bounds and contains the target primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                temp_state_after_turns = state \n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                for turn_action in turns_to_face:\n                    # _ is reward, which is always 0.0 for step, we only care about new_state\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`).\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions (UP, DOWN, LEFT, RIGHT):\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_grid_hash = hash(next_state.grid.tobytes()) # Hash grid for next state\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple, next_grid_hash)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the USE action from the current position.\n    # This is important for actions like picking up tools (which change inventory)\n    # or interacting with environmental elements that might clear paths (changing grid).\n    \n    # Store current state details to detect changes after USE action.\n    inventory_before_any_use = np.copy(state.inventory)\n    current_grid_hash = hash(state.grid.tobytes())\n    current_pos = state.pos\n    current_dir = state.dir\n\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if the USE action resulted in any significant change in the state.\n    # A change in inventory, position, direction, or the grid itself indicates a new\n    # state worth exploring. This makes `collect_v2` more general than `v1`'s\n    # focus only on inventory changes for general USE actions.\n    if (not np.array_equal(state_after_current_use.inventory, inventory_before_any_use) or\n        state_after_current_use.pos != current_pos or\n        state_after_current_use.dir != current_dir or\n        hash(state_after_current_use.grid.tobytes()) != current_grid_hash):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_grid_hash = hash(state_after_current_use.grid.tobytes())\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], \n                          state_after_current_use.dir, next_inventory_tuple, next_grid_hash)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T11:47:55.770977", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` using A* search with a heuristic.\n    \n    This version uses a priority queue (heapq) to prioritize states based on\n    f_cost = g_cost + h_cost, where g_cost is the path length so far and\n    h_cost is an estimated minimum number of actions to reach the goal.\n    The heuristic estimates the cost to move to a cell containing the primitive\n    and then use it.\n\n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect.\n\n    Returns:\n        List[int]: A sequence of action indices to execute.\n  \"\"\"\n  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with A* search.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # Heuristic function for A* search (h_cost)\n  def _h_cost(pos: tuple[int, int], target_kind_idx: int, grid: np.ndarray) -> float:\n      \"\"\"\n      Estimates the minimum number of actions from current_pos to collect target_kind_idx.\n      This is Manhattan distance to the closest target item, plus 1 for the USE action.\n      It's admissible because it never overestimates the actual cost for basic movement and use.\n      \"\"\"\n      min_dist_to_item = float('inf')\n      grid_rows, grid_cols, _ = grid.shape\n\n      # Iterate through the grid to find all occurrences of the target primitive.\n      for r in range(grid_rows):\n          for c in range(grid_cols):\n              if grid[r, c, target_kind_idx] == 1:\n                  dist = abs(pos[0] - r) + abs(pos[1] - c)\n                  min_dist_to_item = min(min_dist_to_item, dist)\n      \n      if min_dist_to_item == float('inf'):\n          return float('inf') # Target not found on the grid, thus unreachable.\n      \n      # The heuristic is the minimum Manhattan distance to any target cell\n      # plus 1 action for the final USE. This is an admissible (optimistic) lower bound.\n      return min_dist_to_item + 1 \n\n  # 5. Initialize A* search.\n  q = [] # Priority queue (min-heap) to store (f_cost, g_cost, state, path)\n  # visited_min_g_cost stores the minimum g_cost found so far for a given state_key\n  # state_key = (row, col, direction, inventory_tuple)\n  visited_min_g_cost = {} \n\n  initial_inventory_tuple = tuple(current_state.inventory)\n  initial_g_cost = 0 # Cost from start to current state (path length)\n  initial_h_cost = _h_cost(current_state.pos, i_kind, current_state.grid) # Estimated cost from current state to goal\n  initial_f_cost = initial_g_cost + initial_h_cost # Total estimated cost\n\n  # Push the initial state to the priority queue\n  heapq.heappush(q, (initial_f_cost, initial_g_cost, current_state, []))\n  visited_min_g_cost[(current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple)] = initial_g_cost\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Max explored states to prevent excessive computation in very large or complex scenarios.\n  # This acts as a safeguard; A* with an admissible heuristic would find the optimal path without it,\n  # but it can be useful in practice.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 6. A* Loop.\n  while q:\n    f_cost, g_cost, state, path = heapq.heappop(q) # Pop the state with the lowest f_cost\n    explored_states_count += 1\n\n    current_state_key = (state.pos[0], state.pos[1], state.dir, tuple(state.inventory))\n\n    # If we found a shorter path to this exact state (position, direction, inventory) already, skip this one.\n    if g_cost > visited_min_g_cost.get(current_state_key, float('inf')):\n        continue\n    \n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`).\n    if state.next_to(i_kind):\n        # Iterate through all 4 possible directions to find if the primitive is directly in front.\n        for target_dir_val in range(4): \n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir_val]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell directly in front is within grid bounds and contains the primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Calculate the turning actions needed to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir_val)\n                temp_state_after_turns = state \n                \n                # Simulate the turns to update the agent's direction in the temporary state.\n                # This is important for the subsequent USE action to be correctly applied.\n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    # If collected, return the combined path (moves + turns + USE).\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible actions (movement and general USE):\n    # Movement actions (UP, DOWN, LEFT, RIGHT)\n    for action in move_actions:\n      _, next_state = state.step(action) # Simulate action to get the next state\n      new_g_cost = g_cost + 1 # Each action costs 1\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, tuple(next_state.inventory))\n\n      # Only add to queue if this path is shorter or it's the first time visiting this state.\n      if new_g_cost < visited_min_g_cost.get(next_state_key, float('inf')):\n        visited_min_g_cost[next_state_key] = new_g_cost\n        next_h_cost = _h_cost(next_state.pos, i_kind, next_state.grid) # Recalculate heuristic for new state\n        next_f_cost = new_g_cost + next_h_cost\n        heapq.heappush(q, (next_f_cost, new_g_cost, next_state, path + [action]))\n    \n    # Explore the USE action from the current position.\n    # This is crucial for picking up tools or other items that might then enable\n    # collection of the target primitive.\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if the USE action resulted in an inventory change.\n    # We only consider USE actions that meaningfully change the inventory to avoid redundant paths.\n    if not np.array_equal(state_after_current_use.inventory, inventory_before_any_use):\n        new_g_cost = g_cost + 1\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, tuple(state_after_current_use.inventory))\n\n        if new_g_cost < visited_min_g_cost.get(next_state_key, float('inf')):\n            visited_min_g_cost[next_state_key] = new_g_cost\n            next_h_cost = _h_cost(state_after_current_use.pos, i_kind, state_after_current_use.grid)\n            next_f_cost = new_g_cost + next_h_cost\n            heapq.heappush(q, (next_f_cost, new_g_cost, state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the A* queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-08-01T11:48:58.493202", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world # Access to game world configuration (cookbook, indices, etc.)\n\n  # 1. Map the primitive name to its integer ID.\n  # If the primitive is not recognized, it cannot be collected.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If so, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is something that can be collected\n  # via the 'USE' action. This includes grabbable items, water, and stone.\n  # Entities like workshops, boundaries, or bridges are not typically 'collected' into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not a 'USE'-collectible primitive, then this function cannot collect it.\n  # The 'collect' DSL command is specifically for obtaining primitive resources.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action constants and utility mappings.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # Maps agent's direction (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT) to a delta (dr, dc)\n  # representing the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP (North: row - 1, col)\n      1: (0, 1),  # RIGHT (East: row, col + 1)\n      2: (1, 0),  # DOWN (South: row + 1, col)\n      3: (0, -1)  # LEFT (West: row, col - 1)\n  }\n\n  # Helper function to compute the minimal turning actions (LEFT/RIGHT)\n  # required to face a `target_dir` from the `current_dir`.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # The +4 and %4 ensure a positive result for consistent modulo behavior with negative inputs.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive turns in the same direction achieve a 180-degree rotation.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice.\n\n  # 5. Initialize Breadth-First Search (BFS) structures.\n  q = collections.deque()\n  # `visited` stores a tuple (row, col, direction, inventory_tuple) to represent a unique state.\n  # The inventory (a numpy array) is converted to a tuple for hashability.\n  visited = set()\n\n  # Start BFS from the current environment state.\n  # Convert initial inventory to a hashable tuple.\n  initial_inventory_tuple = tuple(current_state.inventory.tolist()) \n  q.append((current_state, [])) # Queue stores (CraftState object, list of actions to reach this state)\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Maximum number of unique states to explore. This acts as a safeguard against\n  # excessively long searches or infinite loops in complex/unsolvable scenarios.\n  # The multiplier accounts for positions, directions, and different relevant inventory states.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 6. BFS Loop: Explore states layer by layer to find the shortest path.\n  while q:\n    # Hard limit check: If we've processed too many states, assume uncollectible within reasonable bounds.\n    if explored_states_count >= MAX_EXPLORED_STATES:\n        return [] # Path not found within the allowed search space.\n\n    state, path = q.popleft() # Dequeue the current state and the path taken to reach it\n    explored_states_count += 1\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from the current 'state'?\n    # First, check if the primitive is in any adjacent cell.\n    if state.next_to(i_kind):\n        # Iterate through all four possible directions the agent could face.\n        for target_dir in range(4): \n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell directly in front is within grid bounds and contains the target primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # If yes, calculate the actions needed to turn and face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    # Simulate turns on a temporary state. Reward is 0.0, so discard.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Record inventory *before* attempting the 'USE' action.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action. This is where collection typically occurs.\n                # Reward is 0.0, so discard.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Crucial validation: Verify that the primitive's count in the inventory actually increased.\n                # This confirms successful collection based on game mechanics.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    # Found a successful path to collect the primitive!\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible actions from the current state:\n    # 1. Movement actions (UP, DOWN, LEFT, RIGHT).\n    for action in move_actions:\n      # Simulate taking the action to get the next state.\n      _, next_state = state.step(action)\n      \n      # Construct a hashable key for the next state, including position, direction, and inventory.\n      next_inventory_tuple = tuple(next_state.inventory.tolist())\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      # If this next state has not been visited before, add it to the queue and visited set.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # 2. Consider the 'USE' action from the agent's current position.\n    # This is important for scenarios where using an item at the current location\n    # (e.g., picking up a tool, activating a workbench) changes the state\n    # in a way that facilitates future collection of the target primitive.\n    inventory_before_current_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if the 'USE' action actually resulted in a meaningful state change\n    # (i.e., inventory, position, or direction changed).\n    # This prevents adding redundant states if 'USE' had no effect.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_current_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory.tolist())\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        # If this new state (after USE) has not been visited, add it to the queue and visited set.\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # If the BFS queue becomes empty and no path leading to the collection of the primitive\n  # was found, it means the primitive is currently unreachable or uncollectible from the\n  # initial state given the game's rules.\n  return []", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T11:48:59.962780", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world # Access to game world configuration (cookbook, indices, etc.)\n\n  # 1. Map the primitive name (e.g., \"wood\", \"water\") to its integer ID used by the simulation.\n  # If the primitive name is not found in the world's index, it's an invalid target,\n  # so no actions can be taken to collect it.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # The primitive name provided is not recognized by the environment.\n    return []\n\n  # 2. Check if the agent already possesses the primitive in its inventory.\n  # If the goal is already satisfied, no actions are necessary for collection.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Determine if this primitive is something that can actually be \"collected\"\n  # via the 'USE' action within the game's mechanics.\n  # \"Grabbable indices\" include items that can be picked up from the ground.\n  # \"Water\" and \"Stone\" are specific environmental resources collected by 'USE'.\n  # Other entities like \"WORKSHOP0\", \"BOUNDARY\", \"BRIDGE\" are typically not collected into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the target primitive is not designed to be collected using 'USE' action,\n  # this function (which implements collection via movement and USE) cannot fulfill the request.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action constants and utility mappings for agent movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  # Group movement actions for easier iteration during BFS.\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # This dictionary maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the corresponding change in (row, column) to find the cell directly in front.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP (moves towards smaller row index)\n      1: (0, 1),  # RIGHT (moves towards larger column index)\n      2: (1, 0),  # DOWN (moves towards larger row index)\n      3: (0, -1)  # LEFT (moves towards smaller column index)\n  }\n\n  # Helper function to calculate the minimal sequence of turning actions (LEFT/RIGHT)\n  # required to change the agent's `current_dir` to face `target_dir`.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction, no turns needed.\n      \n      # Calculate the difference in directions, handling the circular nature of directions (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference in the range [0, 3].\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # A difference of 1 implies a single clockwise turn (e.g., UP(0) to RIGHT(1)).\n          return [RIGHT_ACT]\n      elif diff == 3: # A difference of 3 implies a single counter-clockwise turn (e.g., UP(0) to LEFT(3)).\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) to DOWN(2)).\n          # This can be achieved by two consecutive right turns or two consecutive left turns.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose two right turns.\n\n  # 5. Initialize Breadth-First Search (BFS) data structures.\n  q = collections.deque() # The queue for states to explore: stores (CraftState object, path_to_reach_state).\n  # The `visited` set tracks states already processed to prevent redundant exploration and cycles.\n  # A state is defined by (agent_row, agent_col, agent_direction, current_inventory_as_tuple).\n  # Inventory (a numpy array) must be converted to a hashable tuple.\n  visited = set()\n\n  # Start BFS from the agent's initial state in the environment.\n  # Convert initial inventory to a tuple for inclusion in the visited set key.\n  initial_inventory_tuple = tuple(current_state.inventory.tolist()) \n  q.append((current_state, [])) # Add the starting state and an empty path.\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  # Set a pragmatic limit on the number of states to explore.\n  # This prevents extremely long searches or infinite loops in complex or unsolvable scenarios.\n  # Multiplier '4' for directions, '10' is a heuristic for various relevant inventory states\n  # (e.g., acquiring and using different tools).\n  grid_width, grid_height, _ = current_state.grid.shape\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 6. BFS Loop: Explore states layer by layer to find the shortest path to collect the primitive.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the action path that led to it.\n    explored_states_count += 1\n\n    # Pruning: If the number of explored states exceeds the defined limit, stop exploring\n    # from this branch to prevent performance issues. This means either the path is too long\n    # or the primitive is effectively unreachable within practical limits.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue # Skip processing this state, but allow BFS to continue with other states already in the queue.\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the target primitive (`i_kind`) from the current `state`?\n    # This involves checking if the primitive is in an adjacent cell.\n    if state.next_to(i_kind):\n        # If the primitive is adjacent, iterate through all four possible directions (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT).\n        # We need to find which specific direction (if any) points to the primitive.\n        for target_dir in range(4): \n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell directly in front (after turning) is within grid bounds\n            # and actually contains the target primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # If the primitive is found in the cell pointed to by `target_dir`:\n                # 1. Calculate the turning actions required to face that direction.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    # Simulate the turning actions. In CraftLab, rewards for moves are 0.0.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # 2. Record the agent's inventory *before* attempting the 'USE' action.\n                # This is crucial for verifying if the 'USE' action successfully collected the primitive.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # 3. Simulate the 'USE' action. This is the action that attempts to collect the primitive.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # 4. Crucial Verification: Check if the count of the target primitive in the inventory\n                # actually increased after the 'USE' action. This confirms successful collection,\n                # accounting for any internal game rules (e.g., tools needed, resource depletion).\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    # If collection was successful, we have found the shortest path!\n                    # Return the combined sequence of actions: path to `state` + turns + `USE`.\n                    return path + turns_to_face + [USE_ACT]\n\n    # Expand the current `state` by trying all possible actions:\n    # 1. Movement actions (UP, DOWN, LEFT, RIGHT).\n    for action in move_actions:\n      # Simulate taking the movement action to obtain the `next_state`.\n      _, next_state = state.step(action)\n      \n      # Create a hashable key for the `next_state` by converting its inventory\n      # (a numpy array) to a tuple.\n      next_inventory_tuple = tuple(next_state.inventory.tolist())\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      # If this `next_state` has not been visited before, add it to the queue\n      # for future exploration and mark it as visited.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # 2. The 'USE' action from the agent's current position (without necessarily facing the target primitive yet).\n    # This is important for scenarios where using an item at the agent's current location\n    # (e.g., picking up a required tool, using a workbench to craft a prerequisite) changes the state\n    # in a way that enables the subsequent collection of the primitive.\n    inventory_before_current_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if performing the 'USE' action actually resulted in a meaningful change\n    # to the agent's state (inventory, position, or direction).\n    # This prevents adding redundant states to the queue if 'USE' had no effect in this context.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_current_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory.tolist())\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        # If this new state (resulting from 'USE') has not been visited, add it to the queue.\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # If the BFS queue becomes empty and no path to collect the primitive was found,\n  # it indicates that the primitive is currently unreachable or uncollectible from the initial state\n  # under the current game rules and environment configuration.\n  return []", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T11:49:57.464252", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (r, c)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = initial_grid.shape # (rows, columns, kinds)\n\n  action_map = env.action_specs()\n  USE_ACTION = action_map['USE']\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n\n  # Determine if the target primitive is a workshop (where you step ONTO it to USE)\n  # or a regular grabbable item (where you stand ADJACENT and USE).\n  is_target_workshop = primitive_id in current_state.world.workshop_indices\n  \n  # Pre-check: If the agent is already on a workshop tile that is the target,\n  # it can directly use it without movement.\n  current_pos_r, current_pos_c = initial_pos\n  if is_target_workshop and initial_grid[current_pos_r, current_pos_c, primitive_id] > 0:\n      actions_list.append(USE_ACTION)\n      return actions_list\n\n  # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT, move in positive column direction\n      1: (-1, 0),  # Facing UP, move in negative row direction\n      2: (0, -1),  # Facing LEFT, move in negative column direction\n      3: (1, 0)    # Facing DOWN, move in positive row direction\n  }\n\n  # Map for updating agent's direction when turning left/right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # BFS Queue: stores ( (current_pos_tuple, current_dir_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set: stores (position_tuple, direction_int) to avoid redundant paths and cycles\n  visited = {(initial_pos, initial_dir)}\n\n  path_to_target = None # To store the path once the goal state is reached\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # --- Goal Check for Current State ---\n      if is_target_workshop:\n          # Goal for workshops: agent is ON the workshop tile\n          if initial_grid[r, c, primitive_id] > 0:\n              path_to_target = path_actions\n              break # Path found to be on the workshop\n      else:\n          # Goal for grabbable items: agent is ADJACENT and FACING the item\n          front_dr, front_dc = DIR_TO_DRDC[current_dir]\n          front_r, front_c = r + front_dr, c + front_dc\n\n          # Ensure the cell in front is within grid bounds\n          if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n              # Check if the cell in front contains the target primitive\n              if initial_grid[front_r, front_c, primitive_id] > 0:\n                  path_to_target = path_actions\n                  break # Path found to be adjacent and facing the primitive\n\n      # --- Explore Possible Next Actions (Move Forward, Turn Left, Turn Right) ---\n      \n      # 1. Try Moving Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if the next position is within grid boundaries and this state hasn't been visited\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT and\n          (next_pos, next_dir) not in visited):\n          \n          # Determine if the next position (next_r, next_c) is walkable.\n          is_walkable = True\n          \n          # Iterate through all kinds present at the potential next cell\n          for k_idx in range(initial_grid.shape[2]): # Loop through all possible kind IDs\n              if initial_grid[next_r, next_c, k_idx] > 0: # If this kind is present at the cell\n                  if k_idx == primitive_id:\n                      # If the cell contains the target primitive itself:\n                      if not is_target_workshop:\n                          # If it's a grabbable item, we cannot walk onto it (must be adjacent).\n                          is_walkable = False\n                          break\n                      # If it's a workshop, we ARE allowed to walk onto it (goal is to be on it).\n                  elif k_idx in current_state.world.non_grabbable_indices:\n                      # If it's another non-grabbable item (e.g., BOUNDARY, WATER, another type of workshop),\n                      # then the cell is not walkable.\n                      is_walkable = False\n                      break\n          \n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # 2. Try Turning Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # 3. Try Turning Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a valid path to the primitive (or workshop) was found, append the 'USE' action.\n  # The 'USE' action is assumed to \"collect\" or \"activate\" the primitive once the agent is in the correct position.\n  if path_to_target is not None:\n      actions_list.extend(path_to_target)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T11:49:58.609271", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  \n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  # Improvement for collect_v2: Check if the primitive is already in inventory.\n  # If it is, no collection actions are needed.\n  if current_state.inventory[primitive_id] > 0:\n      return []\n\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (r, c)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  WIDTH, HEIGHT, _ = initial_grid.shape # (rows, columns, kinds)\n\n  action_map = env.action_specs()\n  USE_ACTION = action_map['USE']\n\n  non_grabbable_indices = current_state.world.non_grabbable_indices\n\n  # Special handling for non-grabbable primitives (e.g., WORKSHOPS).\n  # If the agent is already standing on such a primitive, the 'USE' action\n  # might be directly applicable without requiring movement or turning to face it.\n  # This assumes interaction with these specific primitives can happen from the same cell.\n  current_pos_r, current_pos_c = initial_pos\n  if initial_grid[current_pos_r, current_pos_c, primitive_id] > 0 and\\\n     primitive_id in non_grabbable_indices:\n      # If the agent is on a non-grabbable primitive, just use it.\n      actions_list.append(USE_ACTION)\n      return actions_list\n\n  # Define the BFS helper function locally to encapsulate pathfinding logic.\n  # This function finds a path to a cell *adjacent* to the target primitive,\n  # such that the agent is *facing* the primitive.\n  def _find_path_to_adjacent_facing_primitive(\n      start_pos: tuple[int, int],\n      start_dir: int,\n      target_primitive_id: int,\n  ) -> list[int] | None:\n      \"\"\"\n      Internal helper function to find a sequence of movement/turn actions (BFS)\n      to reach a state where the agent is adjacent to and facing the target primitive.\n      \"\"\"\n      # Extract action indices from the outer scope's action_map\n      MOVE_FORWARD_ACTION = action_map['UP']\n      TURN_LEFT_ACTION = action_map['LEFT']\n      TURN_RIGHT_ACTION = action_map['RIGHT']\n\n      # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n      DIR_TO_DRDC = {\n          0: (0, 1),   # Facing RIGHT, move in positive column direction\n          1: (-1, 0),  # Facing UP, move in negative row direction\n          2: (0, -1),  # Facing LEFT, move in negative column direction\n          3: (1, 0)    # Facing DOWN, move in positive row direction\n      }\n\n      # Map for updating agent's direction when turning left/right\n      TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n      TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n      # BFS Queue: stores ( (current_pos_tuple, current_dir_int), list_of_actions_to_reach_here )\n      queue = collections.deque([((start_pos, start_dir), [])])\n      # Visited set: stores (position_tuple, direction_int) to avoid redundant paths and cycles\n      visited = {(start_pos, start_dir)}\n\n      while queue:\n          (current_pos, current_dir), path_actions = queue.popleft()\n          r, c = current_pos\n\n          # 1. Check if the current state satisfies the target condition:\n          # The primitive must be in the cell directly in front of the agent.\n          front_dr, front_dc = DIR_TO_DRDC[current_dir]\n          front_r, front_c = r + front_dr, c + front_dc\n\n          # Ensure the cell in front is within grid bounds\n          if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n              # Check if the cell in front contains the target primitive\n              if initial_grid[front_r, front_c, target_primitive_id] > 0:\n                  return path_actions # Path found, return the sequence of actions\n\n          # 2. Explore possible next actions: Move Forward, Turn Left, Turn Right\n          \n          # Try Move Forward\n          move_dr, move_dc = DIR_TO_DRDC[current_dir]\n          next_r, next_c = r + move_dr, c + move_dc\n          next_pos = (next_r, next_c)\n          next_dir = current_dir # Moving forward does not change facing direction\n\n          # Check if the next position is within bounds and this (position, direction) state hasn't been visited\n          if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT and\n              (next_pos, next_dir) not in visited):\n              \n              # Determine if the next position is walkable:\n              # - Cannot contain any entities globally defined as non-grabbable (e.g., boundaries, water, workshops).\n              # - Cannot be the target primitive itself (agent steps *adjacent* to it, not *onto* it, before using).\n              is_walkable = True\n              for kind_idx in non_grabbable_indices:\n                  if initial_grid[next_r, next_c, kind_idx] > 0:\n                      is_walkable = False\n                      break\n              # Prevent walking onto the primitive itself, as 'collect' usually means interacting from an adjacent cell.\n              if initial_grid[next_r, next_c, target_primitive_id] > 0:\n                  is_walkable = False\n\n              if is_walkable:\n                  visited.add((next_pos, next_dir))\n                  queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n          # Try Turn Left\n          next_dir_left = TURN_LEFT_MAP[current_dir]\n          # Turning does not change position, only direction.\n          if ((current_pos, next_dir_left) not in visited):\n              visited.add((current_pos, next_dir_left))\n              queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n          # Try Turn Right\n          next_dir_right = TURN_RIGHT_MAP[current_dir]\n          # Turning does not change position, only direction.\n          if ((current_pos, next_dir_right) not in visited):\n              visited.add((current_pos, next_dir_right))\n              queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n      return None # No path found after exploring all reachable states\n\n  # Call the nested BFS helper function to find the movement/turn sequence\n  path_to_primitive = _find_path_to_adjacent_facing_primitive(\n      start_pos=initial_pos,\n      start_dir=initial_dir,\n      target_primitive_id=primitive_id,\n  )\n\n  # If a valid path to the primitive was found, append the 'USE' action to the sequence.\n  # The 'USE' action is assumed to \"collect\" the primitive once the agent is in the correct position.\n  if path_to_primitive is not None:\n      actions_list.extend(path_to_primitive)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T11:50:34.792846", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Map the primitive name to its integer ID.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If so, it's already \"collected,\" and no actions are needed.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Determine if the primitive is a type that can be collected via the 'USE' action.\n  # This includes grabbable items (like tools), water, or stone. Other items (e.g., workshops, boundaries)\n  # are not typically \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or\n      i_kind == world.water_index or\n      i_kind == world.stone_index\n  )\n\n  # If the item is not intended to be collected via 'USE', return an empty path.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action constants and directional deltas for grid navigation.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # Delta values for checking the cell directly in front of the agent based on its current direction.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (North)\n      1: (0, 1),  # RIGHT: row, col + 1 (East)\n      2: (1, 0),  # DOWN: row + 1, col (South)\n      3: (0, -1)  # LEFT: row, col - 1 (West)\n  }\n\n  # Helper function to compute the minimal sequence of turns to face a target direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the correct direction.\n\n      # Calculate the difference in directions, wrapping around 0-3.\n      diff = (target_dir - current_dir + 4) % 4\n\n      if diff == 1: # Target is one step clockwise.\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise.\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn.\n          return [RIGHT_ACT, RIGHT_ACT] # Two successive right turns (or left turns).\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The `visited` set stores a tuple `(row, col, direction, inventory_tuple)` to represent\n  # a unique state. Converting inventory (numpy array) to a tuple makes it hashable for the set.\n  visited = set()\n\n  # Add the initial state to the queue and visited set.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, [])) # (current_state, path_to_reach_this_state)\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Heuristic limit to prevent the BFS from running indefinitely in complex or unreachable scenarios.\n  # The multiplier (10) is chosen to allow exploration of states including tool acquisition.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10\n  explored_states_count = 0\n\n  # 6. BFS Loop: Continues until the queue is empty or the goal is found.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and its associated path.\n    explored_states_count += 1\n\n    # Pruning: If too many distinct states have been explored, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n\n    # IMPROVEMENT for collect_v2: Goal Check - can the primitive be collected from the current state?\n    # This now considers two cases:\n    # 1. The primitive is directly under the agent (and is grabbable).\n    # 2. The primitive is in an adjacent cell (requires turning to face and then USE).\n\n    # Case 1: Primitive is directly under the agent and is grabbable.\n    if i_kind in world.grabbable_indices and state.grid[current_r, current_c, i_kind] == 1:\n        inventory_before_use = np.copy(state.inventory)\n        _, state_after_use = state.step(USE_ACT) # Attempt to pick up from current spot.\n\n        if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n            return path + [USE_ACT] # Found a path by picking up from current cell.\n\n    # Case 2: Primitive is in an adjacent cell and requires facing it.\n    # We use state.next_to(i_kind) as a broader hint, then refine by checking specific directions.\n    # Note: state.next_to also checks the current cell, but we've handled that explicitly above for grabbables.\n    if state.next_to(i_kind): # This ensures an item of i_kind is in the 3x3 neighborhood.\n        # Iterate through all four cardinal directions to check if the primitive is directly in front.\n        for target_dir in range(4):\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell directly in front is within bounds and contains the target primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and\n                state.grid[facing_r, facing_c, i_kind] == 1):\n\n                # Calculate and apply the turning actions required to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state\n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Record inventory *before* attempting the 'USE' action to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action on the temporary state.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Crucial verification: Check if the count of the target primitive in inventory\n                # actually increased. This confirms successful collection, accounting for any\n                # game rules (e.g., requiring tools) handled by `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT] # Found a path!\n\n    # Explore possible future states by performing movement actions.\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      # If this next state (position, direction, and inventory) has not been visited, add it to the queue.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n\n    # Explore the 'USE' action from the current state, even if not directly facing the target primitive.\n    # This is vital for scenarios where using an item at the current location (e.g., picking up a tool)\n    # might enable subsequent collection steps. This general 'USE' acts as a catch-all for various\n    # interactions that change the state (e.g., picking up a tool from the ground, interacting with a workshop).\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n\n    # Only add the state after a general 'USE' action if it actually caused a change\n    # in inventory, position, or direction, preventing redundant explorations.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS loop completes and no path to collect the primitive was found,\n  # it means the primitive is currently unreachable given the environment and agent's capabilities.\n  return []", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T11:50:36.261681", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Map the primitive name to its integer ID.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If so, it's already \"collected,\" and no actions are needed.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Determine if the primitive is a type that can be collected via the 'USE' action.\n  # This includes grabbable items (like tools), water, or stone. Other items (e.g., workshops, boundaries)\n  # are not typically \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or\n      i_kind == world.water_index or\n      i_kind == world.stone_index\n  )\n\n  # If the item is not intended to be collected via 'USE', return an empty path.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action constants and directional deltas for grid navigation.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # Delta values for checking the cell directly in front of the agent based on its current direction.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (North)\n      1: (0, 1),  # RIGHT: row, col + 1 (East)\n      2: (1, 0),  # DOWN: row + 1, col (South)\n      3: (0, -1)  # LEFT: row, col - 1 (West)\n  }\n\n  # Helper function to compute the minimal sequence of turns to face a target direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the correct direction.\n\n      # Calculate the difference in directions, wrapping around 0-3.\n      diff = (target_dir - current_dir + 4) % 4\n\n      if diff == 1: # Target is one step clockwise.\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise.\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn.\n          return [RIGHT_ACT, RIGHT_ACT] # Two successive right turns (or left turns).\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The `visited` set stores a tuple `(row, col, direction, inventory_tuple)` to represent\n  # a unique state. Converting inventory (numpy array) to a tuple makes it hashable for the set.\n  visited = set()\n\n  # Add the initial state to the queue and visited set.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, [])) # (current_state, path_to_reach_this_state)\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Heuristic limit to prevent the BFS from running indefinitely in complex or unreachable scenarios.\n  # The multiplier (10) is chosen to allow exploration of states including tool acquisition.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10\n  explored_states_count = 0\n\n  # 6. BFS Loop: Continues until the queue is empty or the goal is found.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and its associated path.\n    explored_states_count += 1\n\n    # Pruning: If too many distinct states have been explored, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n\n    # Goal Check - can the primitive be collected from the current state?\n    # This now considers two cases:\n    # 1. The primitive is directly under the agent (and is grabbable).\n    # 2. The primitive is in an adjacent cell (requires turning to face and then USE).\n\n    # Case 1: Primitive is directly under the agent and is grabbable.\n    if i_kind in world.grabbable_indices and state.grid[current_r, current_c, i_kind] == 1:\n        inventory_before_use = np.copy(state.inventory)\n        _, state_after_use = state.step(USE_ACT) # Attempt to pick up from current spot.\n\n        if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n            return path + [USE_ACT] # Found a path by picking up from current cell.\n\n    # Case 2: Primitive is in an adjacent cell and requires facing it.\n    # We use state.next_to(i_kind) as a broader hint, then refine by checking specific directions.\n    # Note: state.next_to also checks the current cell, but we've handled that explicitly above for grabbables.\n    if state.next_to(i_kind): # This ensures an item of i_kind is in the 3x3 neighborhood.\n        # Iterate through all four cardinal directions to check if the primitive is directly in front.\n        for target_dir in range(4):\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell directly in front is within bounds and contains the target primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and\n                state.grid[facing_r, facing_c, i_kind] == 1):\n\n                # Calculate and apply the turning actions required to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state\n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Record inventory *before* attempting the 'USE' action to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action on the temporary state.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Crucial verification: Check if the count of the target primitive in inventory\n                # actually increased. This confirms successful collection, accounting for any\n                # game rules (e.g., requiring tools) handled by `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT] # Found a path!\n\n    # Explore possible future states by performing movement actions.\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      # If this next state (position, direction, and inventory) has not been visited, add it to the queue.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n\n    # Explore the 'USE' action from the current state, even if not directly facing the target primitive.\n    # This is vital for scenarios where using an item at the current location (e.g., picking up a tool)\n    # might enable subsequent collection steps. This general 'USE' acts as a catch-all for various\n    # interactions that change the state (e.g., picking up a tool from the ground, interacting with a workshop).\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n\n    # Only add the state after a general 'USE' action if it actually caused a change\n    # in inventory, position, or direction, preventing redundant explorations.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS loop completes and no path to collect the primitive was found,\n  # it means the primitive is currently unreachable given the environment and agent's capabilities.\n  return []", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T11:51:57.413971", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # Define constants for actions and movement deltas\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  MOVE_ACTIONS = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # Maps agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front.\n  DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized by the cookbook, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Entities like workshops, boundaries, or bridges are typically non-grabbable and not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not considered collectible via 'USE' (e.g., a workshop),\n  # we don't proceed with a search for collection.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set now includes the agent's inventory as part of the state key.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing, allowing BFS to distinguish\n  # between states that are identical in position/direction but differ in inventory (e.g., having a tool vs. not).\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, [])) # (current_state, path_to_this_state)\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Heuristic limit for the number of states to explore in BFS.\n  # This helps prevent excessively long searches for unreachable or very distant items.\n  # The multiplier '10' accounts for different relevant inventory states that might\n  # be reached (e.g., picking up a tool) during the search for the primitive.\n  MAX_BFS_STATES_TO_EXPLORE = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 5. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    \n    # Pruning: If we've explored too many distinct states, terminate the BFS\n    # to prevent performance issues and ensure bounded search time.\n    explored_states_count += 1\n    if explored_states_count > MAX_BFS_STATES_TO_EXPLORE:\n      return [] # Terminate BFS and report no path found within limits.\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # Check if the target primitive (`i_kind`) is in the 3x3 neighborhood of the agent.\n    if state.next_to(i_kind):\n        for target_dir in range(4): # Iterate through all 4 possible facing directions\n            dr, dc = DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Ensure the cell directly in front is within grid bounds and contains the target primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions required to face the primitive.\n                temp_state_after_turns = state \n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                for turn_action in turns_to_face:\n                    # Reward is always 0.0, so we use `_` for the unused return value.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify successful collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                # Reward is always 0.0, so we use `_` for the unused return value.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical verification: Did the count of the primitive in inventory actually increase?\n                # This confirms successful collection, accounting for any internal game rules\n                # (e.g., tools needed, resource depletion) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in MOVE_ACTIONS:\n      # Simulate taking the action to get the next state.\n      # Reward is always 0.0, so we use `_` for the unused return value.\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      # If this new state has not been visited, add it to the queue and visited set.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the USE action from the current position (without moving).\n    # This is important if using an item at the current position (e.g., picking up a tool,\n    # or activating a workshop) can change the inventory or environment state,\n    # which might be necessary for later steps to collect the target primitive.\n    inventory_before_any_use = np.copy(state.inventory)\n    # Reward is always 0.0, so we use `_` for the unused return value.\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if the USE action resulted in a meaningful state change.\n    # This prevents adding redundant states to the queue if USE had no effect (e.g., using in empty space).\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 5, "scores": {"3": 1.5}}
