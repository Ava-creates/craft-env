{"timestamp": "2025-08-01T07:01:22.658088", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  grid = current_state.grid # The current grid layout (numpy.ndarray)\n  initial_pos = current_state.pos # Agent's current position (row, col)\n  initial_dir = current_state.dir # Agent's current facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = grid.shape\n\n  action_map = env.action_specs()\n  # Map DSL movement/turn actions to their integer indices from action_specs.\n  # Assuming 'UP' means move forward, 'LEFT'/'RIGHT' mean turn.\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) tuple for movement in each direction.\n  # 0:RIGHT (+col), 1:UP (-row), 2:LEFT (-col), 3:DOWN (+row)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # Maps for updating agent's direction after a turn.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # R->U->L->D->R\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # R->D->L->U->R\n\n  # Get indices of entities that block agent movement (e.g., BOUNDARY, WATER, WORKSHOP_X).\n  non_walkable_indices = current_state.world.non_grabbable_indices\n\n  # Helper function to check if a given cell (r, c) is valid and walkable for the agent.\n  def is_cell_valid_and_walkable(r_coord, c_coord):\n    # 1. Check if the cell is within the grid boundaries.\n    if not (0 <= r_coord < WIDTH and 0 <= c_coord < HEIGHT):\n      return False\n\n    # 2. Check if the cell contains any non-grabbable entity that blocks movement.\n    for kind_idx in non_walkable_indices:\n      if grid[r_coord, c_coord, kind_idx] > 0:\n        return False\n\n    # 3. Agent cannot walk directly *onto* the primitive itself; it must be adjacent to use it.\n    if grid[r_coord, c_coord, primitive_id] > 0:\n      return False\n    \n    return True\n\n  # BFS setup:\n  # Queue stores ( (current_position_tuple, current_direction_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (position_tuple, direction_int) to avoid redundant exploration and cycles.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # To store the shortest sequence of actions to reach the goal state.\n\n  # Perform BFS\n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      r, c = current_pos\n\n      # Goal Check: Is the primitive directly in front of the agent at the current state?\n      # This means the agent is in a position to USE the primitive.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # If the cell in front is within grid boundaries AND contains the primitive.\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT) and \\\n         (grid[front_r, front_c, primitive_id] > 0):\n          target_path_actions = path_so_far\n          break # Shortest path to adjacency and facing found, exit BFS.\n\n      # Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n\n      # Option 1: Move Forward\n      next_r_move, next_c_move = r + DIR_TO_DRDC[current_dir][0], c + DIR_TO_DRDC[current_dir][1]\n      next_pos_move = (next_r_move, next_c_move)\n      next_dir_move = current_dir # Direction does not change when moving forward.\n\n      # Check if the next position is valid and walkable, and if this state hasn't been visited.\n      if is_cell_valid_and_walkable(next_r_move, next_c_move):\n          if (next_pos_move, next_dir_move) not in visited:\n              visited.add((next_pos_move, next_dir_move))\n              queue.append(((next_pos_move, next_dir_move), path_so_far + [MOVE_FORWARD_ACTION]))\n\n      # Option 2: Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Position does not change when turning.\n      if (current_pos, next_dir_left) not in visited:\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_so_far + [TURN_LEFT_ACTION]))\n\n      # Option 3: Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Position does not change when turning.\n      if (current_pos, next_dir_right) not in visited:\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_so_far + [TURN_RIGHT_ACTION]))\n\n  # If a path to the target (adjacent and facing the primitive) was found,\n  # append the USE action to complete the collection process.\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T07:02:32.432785", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n  Optimizes the check for walkable cells by pre-calculating a blocking kinds mask,\n  improving efficiency within the BFS loop.\n    \n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect.\n\n    Returns:\n        List[int]: A sequence of action indices to execute.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (r, c)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  cookbook = current_state.world.cookbook\n  primitive_id = cookbook.index[primitive]\n  WIDTH, HEIGHT, N_KINDS = initial_grid.shape\n\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT, move in positive column direction (positive X)\n      1: (-1, 0),  # Facing UP, move in negative row direction (negative Y)\n      2: (0, -1),  # Facing LEFT, move in negative column direction (negative X)\n      3: (1, 0)    # Facing DOWN, move in positive row direction (positive Y)\n  }\n\n  # Map for turning left/right, updating the agent's direction (0-3)\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Pre-calculate the mask for blocking kinds for movement.\n  # A cell is blocking if it contains a non-grabbable item OR the primitive itself (if it's a grabbable resource).\n  # We cannot walk onto workshops or other static environment objects.\n  # We also cannot walk onto the primitive we are trying to collect.\n  blocking_kinds_mask = np.zeros(N_KINDS, dtype=bool)\n\n  # Mark all inherently non-grabbable items as blocking\n  for idx in current_state.world.non_grabbable_indices:\n      blocking_kinds_mask[idx] = True\n  \n  # If the primitive is not one of the inherently non-grabbable items (e.g., WOOD, STONE),\n  # then we also consider it blocking for movement, as we need to be adjacent to 'USE' it.\n  # Workshops are already covered by non_grabbable_indices.\n  if primitive_id not in current_state.world.non_grabbable_indices:\n      blocking_kinds_mask[primitive_id] = True\n\n  # BFS state: ((row, col), direction), path_actions\n  # Queue stores ( (current_pos_tuple, current_dir_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (current_pos_tuple, current_dir_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # Stores the action list to reach the target state\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent at current state\n      # Calculate the coordinates of the cell directly in front\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if front_cell is within grid bounds\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          # Check if the front_cell contains the primitive\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Path to target found (agent is adjacent and facing the primitive)\n\n      # 2. Explore possible next actions: Move Forward, Turn Left, Turn Right\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if next_pos is within bounds\n      if not (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT):\n          continue # Skip this move, it's out of bounds\n\n      # Check if this (position, direction) state hasn't been visited\n      if (next_pos, next_dir) in visited:\n          continue # Skip, already visited this state via a shorter or equal path\n      \n      # Check if the next_pos contains any blocking kind using the pre-calculated mask.\n      # initial_grid[next_r, next_c] gives a vector of counts for that cell (length N_KINDS).\n      # We check if any of the items at 'blocking_kinds_mask' positions have a count > 0.\n      if np.any(initial_grid[next_r, next_c][blocking_kinds_mask]):\n          continue # This cell is not walkable, skip this move.\n\n      # If all checks pass, it's a valid move. Add to queue.\n      visited.add((next_pos, next_dir))\n      queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path was found, append the USE action to the sequence\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 1, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T07:02:33.560066", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (r, c)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT, move in positive column direction (positive X)\n      1: (-1, 0),  # Facing UP, move in negative row direction (negative Y)\n      2: (0, -1),  # Facing LEFT, move in negative column direction (negative X)\n      3: (1, 0)    # Facing DOWN, move in positive row direction (positive Y)\n  }\n\n  # Map for turning left/right, updating the agent's direction (0-3)\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Pre-compute the set of all item kinds that block movement.\n  # This includes inherently non-grabbable entities (like boundaries, water, workshops)\n  # AND the specific primitive we are trying to collect (agent should stand *next to* it, not *on* it).\n  blocking_kind_ids_set = set(current_state.world.non_grabbable_indices)\n  blocking_kind_ids_set.add(primitive_id)\n  # Convert to numpy array for efficient indexing in the grid check within the loop\n  blocking_kind_indices = np.array(list(blocking_kind_ids_set), dtype=int)\n\n  # BFS state: ((row, col), direction), path_actions\n  # Queue stores ( (current_pos_tuple, current_dir_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (current_pos_tuple, current_dir_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # Stores the action list to reach the target state\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent at current state\n      # Calculate the coordinates of the cell directly in front\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if front_cell is within grid bounds\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          # Check if the front_cell contains the primitive\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Path to target found (agent is adjacent and facing the primitive)\n\n      # 2. Explore possible next actions: Move Forward, Turn Left, Turn Right\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if next_pos is within bounds\n      if not (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT):\n          continue # Skip this move, it's out of bounds\n\n      # Check if this (position, direction) state hasn't been visited\n      if (next_pos, next_dir) in visited:\n          continue # Skip, already visited this state via a shorter or equal path\n      \n      # Check if the next_pos contains any blocking kind using the pre-computed array.\n      # If np.any returns True, it means at least one blocking kind is present, so the cell is not walkable.\n      if np.any(initial_grid[next_r, next_c, blocking_kind_indices] > 0):\n          continue # This cell is not walkable, skip this move.\n\n      # If all checks pass, it's a valid move. Add to queue.\n      visited.add((next_pos, next_dir))\n      queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path was found, append the USE action to the sequence\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 1, "scores": {"3": 0.5}}
