en if not directly on the target primitive.\n    # This is important if using an item at the current position (e.g., picking up a tool)\n    # can change the inventory state, which might be necessary for later steps to collect the primitive.\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if the USE action resulted in a meaningful state change (inventory, position, or direction).\n    # This prevents adding redundant states to the queue if USE had no effect.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-08-01T15:17:44.572613", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Ensure the primitive is a resource that can be collected.\n  # Primitives listed in the DSL like 'BOUNDARY', 'WORKSHOP0' are not meant to be\n  # \"collected\" into inventory. We should only attempt to collect items that are\n  # true primitive resources (like wood, iron, etc.).\n  # The `cookbook.primitives` set is the authoritative source for identifying\n  # these base resources. This filter allows resources that might require tools\n  # (e.g., WOOD requiring AXE) to be collected, as the BFS will find paths\n  # to acquire tools first if they are available.\n  if i_kind not in world.cookbook.primitives:\n      return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set includes the agent's current inventory as part of the state key.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing, allowing BFS to distinguish\n  # between states that are identical in position/direction but differ in inventory (e.g., having a tool vs. not).\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Increased MAX_EXPLORED_STATES for collect_v2 to allow for even deeper exploration\n  # in more complex scenarios, potentially requiring multiple inventory changes or longer paths.\n  # The multiplier is increased from 50 (in v1) to 100.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 100 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`).\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell in front is within grid bounds and contains the target primitive\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the USE action from the current position, even if not directly on the target primitive.\n    # This is important if using an item at the current position (e.g., picking up a tool)\n    # can change the inventory state, which might be necessary for later steps to collect the primitive.\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if the USE action resulted in a meaningful state change (inventory, position, or direction).\n    # This prevents adding redundant states to the queue if USE had no effect.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T15:19:43.913411", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n  This function implements a Breadth-First Search (BFS) to find the shortest\n  sequence of actions required to collect a specified primitive item in the\n  CraftWorld environment. It rigorously tracks the agent's state (position,\n  direction, inventory, and grid layout) to ensure correctness and to find\n  an optimal (shortest) action path.\n\n  Improvements over `collect_v1` focus on enhanced clarity, robustness in\n  state tracking, and more explicit justification for key checks:\n  - Detailed comments on the state definition for the `visited_states` set.\n  - Clearer explanations for BFS mechanics, action generation, and pruning logic.\n  - Explicit checks for state changes after `ACTION_USE` to avoid adding\n    redundant states where an action had no effect.\n  - Comprehensive handling of different types of collectible items (primitives,\n    special environment entities, and grabbable items).\n\n  Args:\n      env (env.CraftLab): The CraftLab object representing the current environment.\n      primitive (str): The name of the primitive item (e.g., \"wood\", \"stone\", \"gold\")\n                       to be collected. This name is case-insensitive.\n\n  Returns:\n      List[int]: A list of integer action indices (e.g., `ACTION_UP`, `ACTION_USE`)\n                 representing the shortest sequence of actions to acquire the primitive.\n                 Returns an empty list under the following conditions:\n                 - The primitive is already present in the agent's inventory.\n                 - The provided primitive name is invalid or not recognized by the world.\n                 - The item cannot be collected into inventory via the defined 'collect' semantics.\n                 - No path to collect the primitive is found within the configured\n                   search limits (e.g., environment is too complex, primitive is unreachable).\n  \"\"\"\n  current_state = env._current_state\n  world = env.world # Access to the CraftWorld's cookbook, indices, etc.\n\n  # 1. Input Validation and Early Exit Checks\n  # First, resolve the primitive's string name to its unique integer ID.\n  try:\n    primitive_id = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not found in the world's index, it's invalid.\n    return []\n\n  # Determine if the resolved item is semantically collectible into inventory.\n  # This includes items designated as core primitives, special environmental\n  # features (like water or stone), or any item explicitly marked as grabbable.\n  is_collectible_item = (\n      primitive_id in world.cookbook.primitives or     # Items defined as primitive resources\n      primitive_id == world.water_index or             # Special environmental resource: water\n      primitive_id == world.stone_index or             # Special environmental resource: stone\n      primitive_id in world.grabbable_indices          # Any other item marked as directly grabbable\n  )\n  if not is_collectible_item:\n    # The requested item cannot be acquired into inventory via typical 'collect' actions.\n    return []\n\n  # If the primitive is already in the agent's inventory, no actions are needed.\n  if current_state.inventory[primitive_id] > 0:\n    return []\n\n  # 2. Define Action Constants and Helper Functions for State Transitions\n  action_specs = env.action_specs()\n  ACTION_UP = action_specs[\"UP\"]\n  ACTION_DOWN = action_specs[\"DOWN\"]\n  ACTION_LEFT = action_specs[\"LEFT\"]\n  ACTION_RIGHT = action_specs[\"RIGHT\"]\n  ACTION_USE = action_specs[\"USE\"]\n\n  MOVEMENT_ACTIONS = [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]\n\n  # Mapping from agent's integer direction (0: UP, 1: RIGHT, 2: DOWN, 3: LEFT)\n  # to its corresponding (row_delta, col_delta) for the cell directly in front.\n  DIRECTION_TO_FRONT_DELTA = {\n      0: (-1, 0), # UP: row decreases, col stays same\n      1: (0, 1),  # RIGHT: row stays same, col increases\n      2: (1, 0),  # DOWN: row increases, col stays same\n      3: (0, -1)  # LEFT: row stays same, col decreases\n  }\n\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      \"\"\"Calculates the minimal sequence of turn actions to change agent's facing direction.\"\"\"\n      if current_dir == target_dir:\n          return [] # Already facing the desired direction.\n      \n      # Calculate the angular difference in 90-degree increments (clockwise).\n      # Adding 4 and taking modulo 4 handles negative differences correctly for cyclical directions.\n      diff_clockwise = (target_dir - current_dir + 4) % 4\n      \n      if diff_clockwise == 1:  # 90 degrees clockwise turn\n          return [ACTION_RIGHT]\n      elif diff_clockwise == 3: # 270 degrees clockwise (equivalent to 90 degrees counter-clockwise)\n          return [ACTION_LEFT]\n      else: # diff_clockwise == 2 (180 degrees turn)\n          # Two right turns (or two left turns) achieves a 180-degree rotation.\n          return [ACTION_RIGHT, ACTION_RIGHT]\n\n  # 3. Initialize Breadth-First Search (BFS) Data Structures\n  # The BFS queue stores tuples: (current_CraftState_object, list_of_actions_taken_to_reach_this_state).\n  bfs_queue = collections.deque()\n  \n  # The `visited_states` set prevents revisiting already explored states and avoids cycles.\n  # A state is uniquely defined by a tuple:\n  # (hash_of_grid_bytes, agent_row_position, agent_col_position, agent_direction, tuple_of_inventory_counts).\n  # Hashing the grid's byte representation is critical because 'USE' actions can modify the grid (e.g., removing a tree).\n  # The inventory is converted to a tuple to make it hashable for set inclusion.\n  visited_states = set() \n\n  # Prepare the initial state for the BFS.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  initial_grid_hash = hash(current_state.grid.tobytes()) \n  initial_state_key = (initial_grid_hash, current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple)\n\n  bfs_queue.append((current_state, [])) # Start BFS from the agent's current environment state.\n  visited_states.add(initial_state_key)\n\n  grid_rows, grid_cols, _ = current_state.grid.shape\n  \n  # Heuristic Limits for Search: These parameters control the maximum number of unique\n  # states to explore and the maximum length of an action path. They are crucial\n  # for managing computational complexity and preventing unbounded searches in\n  # very large or complex environments.\n  MAX_EXPLORED_UNIQUE_STATES = grid_rows * grid_cols * 4 * 150 # Covers (pos * dir * inventory/grid variations)\n  MAX_ACTION_PATH_LENGTH = 250 # Prevents excessively long action sequences\n\n  states_explored_counter = 0\n\n  # 4. BFS Loop: Explore the state space layer by layer to find the shortest path.\n  while bfs_queue:\n    current_bfs_state, current_path = bfs_queue.popleft()\n    states_explored_counter += 1\n\n    # Pruning: If search limits are exceeded for the current path, stop expanding it.\n    if states_explored_counter > MAX_EXPLORED_UNIQUE_STATES or len(current_path) >= MAX_ACTION_PATH_LENGTH:\n      continue \n\n    agent_r, agent_c = current_bfs_state.pos\n    agent_dir = current_bfs_state.dir\n\n    # A list to accumulate all potential next transitions from the current state.\n    # Each entry is a tuple: (next_CraftState_object, full_action_sequence_to_next_state, inventory_before_last_action).\n    # `inventory_before_last_action` is vital for precisely detecting if the primitive was just acquired.\n    possible_next_transitions = []\n\n    # --- Generate Potential Next States from the Current BFS State ---\n\n    # A. Movement Actions (UP, DOWN, LEFT, RIGHT):\n    # These actions typically change only the agent's position and/or direction.\n    for action in MOVEMENT_ACTIONS:\n        # `current_bfs_state.step(action)` returns a *new* CraftState object, preserving BFS integrity.\n        _, next_s_after_move = current_bfs_state.step(action)\n        # The inventory state before this move is simply the current state's inventory.\n        possible_next_transitions.append((next_s_after_move, current_path + [action], current_bfs_state.inventory))\n\n    # B. ACTION_USE at the Agent's Current Position:\n    # This covers scenarios where the agent collects an item directly from the tile\n    # it is standing on (e.g., picking up a loose resource).\n    # Capture inventory and grid state *before* this specific `USE` action.\n    inventory_at_current_pos_before_use = np.copy(current_bfs_state.inventory)\n    grid_at_current_pos_before_use = np.copy(current_bfs_state.grid)\n    _, next_s_after_use_at_pos = current_bfs_state.step(ACTION_USE)\n    \n    # Only consider this transition if the 'USE' action resulted in a detectable state change.\n    # This avoids exploring redundant paths where USE had no effect (e.g., trying to USE an empty tile).\n    state_changed_by_pos_use = not (\n        np.array_equal(next_s_after_use_at_pos.inventory, inventory_at_current_pos_before_use) and\n        np.array_equal(next_s_after_use_at_pos.grid, grid_at_current_pos_before_use) and\n        next_s_after_use_at_pos.pos == current_bfs_state.pos and\n        next_s_after_use_at_pos.dir == current_bfs_state.dir\n    )\n    if state_changed_by_pos_use:\n        possible_next_transitions.append((next_s_after_use_at_pos, current_path + [ACTION_USE], inventory_at_current_pos_before_use))\n    \n    # C. ACTION_USE on Adjacent Cells (requires turning to face the cell first):\n    # This covers interactions like chopping trees, mining rocks, or using a workbench,\n    # where the target entity is in a neighboring cell and requires directional interaction.\n    for target_facing_direction in range(4): # Iterate through all 4 cardinal directions (UP, RIGHT, DOWN, LEFT).\n        dr, dc = DIRECTION_TO_FRONT_DELTA[target_facing_direction]\n        facing_r, facing_c = agent_r + dr, agent_c + dc\n\n        # Check if the cell directly in front is within grid bounds AND contains *any* entity.\n        # This broad check is used because 'USE' might interact with one type of entity\n        # (e.g., a \"ROCK\") to yield another (e.g., \"GOLD\").\n        if (0 <= facing_r < grid_rows and 0 <= facing_c < grid_cols) and np.any(current_bfs_state.grid[facing_r, facing_c, :] == 1):\n            \n            # 1. Determine the minimal sequence of actions needed to turn to face the target cell.\n            turning_actions = _get_turning_actions(agent_dir, target_facing_direction)\n            \n            # 2. Simulate these turning actions to reach an intermediate state where the agent is correctly oriented.\n            temp_state_after_turns = current_bfs_state\n            for turn_action in turning_actions:\n                _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n            \n            # 3. Capture inventory and grid states *before* performing the final ACTION_USE in this branch.\n            inventory_before_adj_use = np.copy(temp_state_after_turns.inventory)\n            grid_before_adj_use = np.copy(temp_state_after_turns.grid)\n            \n            # 4. Perform the ACTION_USE from the correctly oriented state.\n            _, next_s_after_adj_use = temp_state_after_turns.step(ACTION_USE)\n            \n            # Only consider this transition if the 'USE' action had a detectable effect on the state.\n            state_changed_by_adj_use = not (\n                np.array_equal(next_s_after_adj_use.inventory, inventory_before_adj_use) and\n                np.array_equal(next_s_after_adj_use.grid, grid_before_adj_use) and\n                next_s_after_adj_use.pos == temp_state_after_turns.pos and\n                next_s_after_adj_use.dir == temp_state_after_turns.dir\n            )\n            if state_changed_by_adj_use:\n                possible_next_transitions.append(\n                    (next_s_after_adj_use, current_path + turning_actions + [ACTION_USE], inventory_before_adj_use)\n                )\n\n    # --- Process all Generated Potential Transitions ---\n    for next_state_candidate, full_action_sequence, inventory_state_before_last_action in possible_next_transitions:\n        # Crucial Goal Check: Determine if the target primitive was acquired specifically\n        # by the *last* action in `full_action_sequence`. This ensures we identify the\n        # exact point of collection and return the shortest path.\n        if next_state_candidate.inventory[primitive_id] > inventory_state_before_last_action[primitive_id]:\n            return full_action_sequence # Goal achieved! Return the shortest path found.\n\n        # If the goal is not yet achieved, add the new state to the BFS queue for further\n        # exploration, but only if this exact state has not been visited before.\n        next_inventory_tuple = tuple(next_state_candidate.inventory)\n        next_grid_hash = hash(next_state_candidate.grid.tobytes())\n        next_state_key = (next_grid_hash, next_state_candidate.pos[0], next_state_candidate.pos[1], next_state_candidate.dir, next_inventory_tuple)\n\n        if next_state_key not in visited_states:\n            visited_states.add(next_state_key)\n            bfs_queue.append((next_state_candidate, full_action_sequence))\n\n  # 5. Search Exhausted:\n  # If the BFS queue becomes empty and the primitive has not been collected,\n  # it indicates that the primitive is unreachable from the initial state\n  # within the current environment configuration and defined search limits.\n  return []", "island_id": 2, "scores": {"3": 2.5}}
{"timestamp": "2025-08-01T15:19:45.163977", "function_name": "collect", "function_body": "", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-08-01T15:21:06.588676", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\"\"\"\n  \"\"\"Returns a list of actions to find and collect the primitive in the passed env.\n    \n    This version refines `collect_v1` by ensuring robust handling of state space\n    (including inventory) and clear verification of successful collection.\n    It uses a Breadth-First Search (BFS) to find the shortest sequence of actions.\n\n    Args:\n        env (env.CraftLab): The CraftLab object containing the current game state.\n        primitive (str): The name of the primitive resource to collect (e.g., \"wood\", \"stone\").\n\n    Returns:\n        List[int]: A sequence of integer action indices (from env.action_specs())\n                   to execute. Returns an empty list if the primitive is already\n                   in inventory, not collectible, or unreachable.\n  \"\"\"\n  current_state = env._current_state\n  world = env.world # Access to Cookbook, indices, etc.\n\n  # 1. Resolve the primitive name to its integer ID.\n  try:\n    primitive_id = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized by the world's cookbook, it's invalid.\n    return []\n\n  # 2. Early exit: If the primitive is already in the agent's inventory,\n  # no actions are needed to \"collect\" it.\n  if current_state.inventory[primitive_id] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is physically collectible via the 'USE' action.\n  # This typically includes items that can be picked up (`grabbable_indices`)\n  # and specific resources like water or stone. Other entities (workshops, boundaries)\n  # are generally not \"collected\" into inventory by this function.\n  is_physically_collectible = (\n      primitive_id in world.grabbable_indices or \n      primitive_id == world.water_index or \n      primitive_id == world.stone_index\n  )\n  \n  # If the item is not a type that can be collected via 'USE', return empty list.\n  if not is_physically_collectible:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # Maps agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT) to\n  # (row_change, col_change) for the cell directly in front of the agent.\n  DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP (North)\n      1: (0, 1),  # RIGHT (East)\n      2: (1, 0),  # DOWN (South)\n      3: (0, -1)  # LEFT (West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate shortest turn: 1, 2, or 3 steps (modulo 4 for circularity).\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # One step clockwise (e.g., UP->RIGHT)\n          return [RIGHT_ACT]\n      elif diff == 3: # One step counter-clockwise (e.g., UP->LEFT)\n          return [LEFT_ACT]\n      else: # diff == 2 (180-degree turn, e.g., UP->DOWN)\n          return [RIGHT_ACT, RIGHT_ACT] # Two consecutive turns in same direction\n\n  grid_width, grid_height, _ = current_state.grid.shape\n\n  # New helper function to encapsulate the collection attempt logic, extracted from v1.\n  def _attempt_collection_at_location(\n      s: craft.CraftState, \n      target_kind_idx: int, \n      current_path_prefix: list[int]\n  ) -> list[int]:\n      \"\"\"\n      Attempts to collect the target_kind_idx from the current state `s`,\n      assuming `s.next_to(target_kind_idx)` is true.\n      It will find the cell containing `target_kind_idx` in the 3x3 neighborhood,\n      turn the agent to face it, perform a 'USE' action, and verify collection.\n\n      Args:\n          s (craft.CraftState): The current state from which to attempt collection.\n          target_kind_idx (int): The ID of the primitive to collect.\n          current_path_prefix (list[int]): Actions taken to reach state `s`.\n\n      Returns:\n          list[int]: The full sequence of actions if collection is successful,\n                     otherwise an empty list.\n      \"\"\"\n      current_r, current_c = s.pos\n      current_d = s.dir\n\n      # Iterate through all 4 possible facing directions to find the primitive.\n      for target_facing_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n          dr, dc = DIR_TO_DELTA_FRONT[target_facing_dir]\n          facing_r, facing_c = current_r + dr, current_c + dc\n\n          # Check if the cell in front is within bounds and contains the primitive.\n          if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n              s.grid[facing_r, facing_c, target_kind_idx] == 1):\n              \n              # Calculate actions to turn and face the primitive.\n              turns_to_face = _get_turning_actions(current_d, target_facing_dir)\n              \n              # Simulate the turning actions to get the state where agent faces the primitive.\n              temp_state_after_turns = s \n              for turn_action in turns_to_face:\n                  _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n              # Store inventory before 'USE' to verify successful collection.\n              inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n              # Simulate the 'USE' action.\n              # `CraftState.step` handles complex interactions like tool consumption.\n              _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n              # Crucial verification: Did the target primitive's count in inventory increase?\n              # This confirms successful collection based on game mechanics.\n              if state_after_use.inventory[target_kind_idx] > inventory_before_use[target_kind_idx]:\n                  return current_path_prefix + turns_to_face + [USE_ACT] # Found a valid path!\n      return [] # No successful collection from this state\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set stores unique states as (row, col, direction, inventory_tuple).\n  # Including inventory is crucial for handling situations where tools are picked up\n  # or consumed, creating new reachable states.\n  visited = set()\n\n  # Start BFS from the current state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, [])) # Queue stores (current_CraftState_object, path_of_actions_to_reach_it)\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  # Heuristic limit for explored states to prevent excessively long searches,\n  # especially in large environments or when a path doesn't exist.\n  # This value may need tuning based on environment size and complexity.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: Stop if too many states have been explored.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n    \n    # Goal Check: If the target primitive is in the agent's immediate vicinity (3x3 neighborhood).\n    # If true, attempt to collect it.\n    if state.next_to(primitive_id):\n        actions_to_collect = _attempt_collection_at_location(state, primitive_id, path)\n        if actions_to_collect:\n            return actions_to_collect # Found a path and successfully collected!\n\n    # Explore possible movement actions (UP, DOWN, LEFT, RIGHT).\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      # Define the unique state key: (position_r, position_c, direction, inventory_tuple)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the general 'USE' action from the current position.\n    # This is important for picking up tools or other `grabbable_indices` that\n    # might be prerequisites for collecting the target primitive, even if\n    # the primitive itself is not yet 'next_to' the agent.\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if the 'USE' action actually changed the state significantly.\n    # Avoids adding redundant states if 'USE' had no effect (e.g., nothing to use).\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable under current conditions and constraints.\n  return []", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T15:21:08.063296", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world # Access to Cookbook, indices, etc.\n\n  # 1. Resolve the primitive name to its integer ID from the cookbook.\n  try:\n    primitive_id = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Early exit: If the primitive is already in the agent's inventory,\n  # no actions are needed to \"collect\" it.\n  if current_state.inventory[primitive_id] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is physically collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable_indices) and specific\n  # resources like water or stone. Other entities (e.g., workshops, boundaries)\n  # are typically not \"collected\" into inventory by this function.\n  is_physically_collectible = (\n      primitive_id in world.grabbable_indices or \n      primitive_id == world.water_index or \n      primitive_id == world.stone_index\n  )\n  \n  # If the item is not a type that can be collected using 'USE', return an empty list.\n  if not is_physically_collectible:\n    return []\n\n  # 4. Define action integer mappings and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # Maps agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT) to\n  # (row_change, col_change) for the cell directly in front of the agent.\n  DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP (North)\n      1: (0, 1),  # RIGHT (East)\n      2: (1, 0),  # DOWN (South)\n      3: (0, -1)  # LEFT (West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # required to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive turns in the same direction achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] \n\n  grid_width, grid_height, _ = current_state.grid.shape\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set stores unique states as (row, col, direction, inventory_tuple).\n  # Including the inventory as a tuple (for hashability) is critical, as picking\n  # up tools or other items can change the set of reachable states/actions.\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, [])) # Queue stores (CraftState object, list of actions to reach this state)\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  # Heuristic limit for explored states to prevent excessively long searches,\n  # especially in large or complex environments where a path might not exist.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the target primitive from this `state`?\n    # This check specifically looks if the `primitive_id` is in the agent's 3x3 neighborhood.\n    if state.next_to(primitive_id):\n        # Iterate through all 4 possible agent facing directions (UP, RIGHT, DOWN, LEFT)\n        # to find if the primitive is directly in front of any of them.\n        for target_facing_dir in range(4): \n            dr, dc = DIR_TO_DELTA_FRONT[target_facing_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell directly in front is within grid bounds and contains the primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, primitive_id] == 1):\n                \n                # Calculate the actions needed to turn the agent to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_facing_dir)\n                \n                # Simulate these turning actions to get an intermediate state.\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    # Note: We don't care about reward here, just the resulting state.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store the inventory state before attempting 'USE' to verify successful collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action. This is where collection (or tool usage) happens.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # CRUCIAL VERIFICATION: Check if the count of the primitive_id\n                # in the inventory actually increased. This confirms success\n                # and accounts for any internal game rules (e.g., needing a tool).\n                if state_after_use.inventory[primitive_id] > inventory_before_use[primitive_id]:\n                    # If collected successfully, return the full sequence of actions.\n                    return path + turns_to_face + [USE_ACT] \n\n    # Explore possible movement actions (UP, DOWN, LEFT, RIGHT).\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      # Define the unique state key: (position_r, position_c, direction, inventory_tuple)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the general 'USE' action from the current position, even if not\n    # directly on the target primitive. This is vital for picking up tools\n    # or other grabbable items that might be prerequisites for later steps.\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if the 'USE' action actually changed the state significantly\n    # (e.g., inventory changed, or agent moved/turned due to an interaction).\n    # This prevents adding redundant states to the queue if 'USE' had no effect.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T15:22:20.259884", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\"\"\"\n  \"\"\"This version incorporates robust BFS logic to find the shortest path to collect a primitive.\n  It correctly handles movement, `USE` actions (both at the agent's position and on adjacent cells),\n  and ensures that the target primitive is actually collectible. State hashing includes the grid\n  to account for environmental changes from `USE` actions (e.g., harvesting).\n  The search limits are adaptively set based on grid dimensions to balance exploration\n  depth with computational cost.\n  \"\"\"\n  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Semantic check: Determine if this primitive is *actually* collectible into inventory.\n  # This includes items defined as primitives, special environment items like water/stone,\n  # and any other items explicitly marked as grabbable.\n  is_primitive_resource = i_kind in world.cookbook.primitives\n  is_special_collectible_environment = (i_kind == world.water_index or i_kind == world.stone_index)\n  is_grabbable = i_kind in world.grabbable_indices\n\n  if not (is_primitive_resource or is_special_collectible_environment or is_grabbable):\n      # The requested primitive is not collectible by means of a direct \"collect\" action.\n      # E.g., Workshops are locations, not items that can be collected into inventory.\n      return []\n\n  # 3. Check if the primitive is already in the agent's inventory.\n  if current_state.inventory[i_kind] > 0:\n      # Primitive is already collected, no actions needed.\n      return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # Delta coordinates for each direction (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT) relative to agent's position (row_delta, col_delta).\n  _DIRECTION_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row decreases, col stays same\n      1: (0, 1),  # RIGHT: row stays same, col increases\n      2: (1, 0),  # DOWN: row increases, col stays same\n      3: (0, -1)  # LEFT: row stays same, col decreases\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return []\n      # Calculate difference ensuring it's positive and within [0, 3] for turns.\n      diff = (target_dir - current_dir + 4) % 4\n      if diff == 1: # Clockwise turn (e.g., UP to RIGHT)\n          return [RIGHT_ACT]\n      elif diff == 3: # Counter-clockwise turn (e.g., UP to LEFT)\n          return [LEFT_ACT]\n      else: # diff == 2 (180-degree turn, e.g., UP to DOWN)\n          return [RIGHT_ACT, RIGHT_ACT] # Two right turns (or two left turns)\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The `visited` set tracks states already explored to prevent cycles and redundant work.\n  # A state is defined by (grid_hash, row, col, direction, inventory_tuple).\n  # `grid.tobytes()` is used for hashing the grid, ensuring distinct grid layouts are treated as distinct states.\n  # This is crucial because `USE_ACT` can modify the grid (e.g., removing a tree).\n  visited = set() \n\n  initial_inventory_tuple = tuple(current_state.inventory)\n  initial_grid_hash = hash(current_state.grid.tobytes()) \n\n  q.append((current_state, [])) # Queue stores (CraftState object, path_to_reach_this_state)\n  visited.add((initial_grid_hash, current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_rows, grid_cols, _ = current_state.grid.shape # Get grid dimensions as (rows, columns, kinds)\n\n  # Adaptive search limits:\n  # MAX_EXPLORED_STATES: Limits the total number of unique states processed to prevent\n  #                      runaway searches in very large or complex state spaces.\n  MAX_EXPLORED_STATES = grid_rows * grid_cols * 4 * 200 \n  \n  # MAX_PATH_LENGTH: Limits the length of any path considered. Set adaptively based on\n  #                  the grid dimensions, allowing for longer paths on larger maps,\n  #                  plus a buffer for turns and interactions.\n  MAX_PATH_LENGTH = (grid_rows + grid_cols) * 7 \n\n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft()\n    explored_states_count += 1\n\n    # Pruning: If exploration limits are reached, stop exploring from this path.\n    # This prevents the search from becoming excessively long or consuming too much memory/time.\n    if explored_states_count > MAX_EXPLORED_STATES or len(path) >= MAX_PATH_LENGTH:\n      continue\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n\n    # List to store (next_state_object, actions_to_reach_next_state, inventory_before_last_action_applied)\n    # Storing 'inventory_before_last_action_applied' is crucial for detecting if the goal item\n    # was *specifically* acquired in the last step of a transition.\n    potential_next_transitions = []\n\n    # --- Generate all potential next states from the current state ---\n\n    # 1. Explore Movement Actions (UP, DOWN, LEFT, RIGHT)\n    for action in move_actions:\n        # Simulate step. The 'reward' is always 0.0 for this environment implementation.\n        # The 'inventory_before_move' is the current state's inventory, for later comparison.\n        inventory_before_move = np.copy(state.inventory)\n        _, next_state = state.step(action)\n        potential_next_transitions.append((next_state, path + [action], inventory_before_move))\n\n    # 2. Explore USE_ACT at the agent's current position.\n    # This covers collecting items directly from the cell the agent is standing on (e.g., grabbable items).\n    inventory_before_use_at_pos = np.copy(state.inventory)\n    grid_before_use_at_pos = np.copy(state.grid)\n    _, state_after_use_at_pos = state.step(USE_ACT)\n    \n    # Check if USE_ACT at current position resulted in a meaningful state change.\n    # A change implies interaction (e.g., item collected, grid modified).\n    state_changed_by_use_at_pos = not (\n        np.array_equal(state_after_use_at_pos.inventory, inventory_before_use_at_pos) and\n        state_after_use_at_pos.pos == state.pos and # Position usually unchanged by USE\n        state_after_use_at_pos.dir == state.dir and # Direction usually unchanged by USE\n        np.array_equal(state_after_use_at_pos.grid, grid_before_use_at_pos) # Grid can change if item removed/resource harvested\n    )\n    if state_changed_by_use_at_pos:\n        potential_next_transitions.append((state_after_use_at_pos, path + [USE_ACT], inventory_before_use_at_pos))\n    \n    # 3. Explore USE_ACT on adjacent cells (after turning to face them).\n    # This handles interacting with entities in the surrounding environment (e.g., chopping trees, mining rocks).\n    for target_dir_idx in range(4): # Iterate through all four possible facing directions (0, 1, 2, 3)\n        row_delta, col_delta = _DIRECTION_TO_DELTA_FRONT[target_dir_idx]\n        facing_r, facing_c = current_r + row_delta, current_c + col_delta\n\n        # Check if the cell the agent would face is within grid bounds AND contains any entity.\n        # This broad check is necessary because we don't know which specific entity yields the primitive\n        # without inspecting CraftState's internal logic for USE_ACT.\n        if (0 <= facing_r < grid_rows and 0 <= facing_c < grid_cols) and np.any(state.grid[facing_r, facing_c, :] == 1):\n            turns_to_face = _get_turning_actions(current_dir, target_dir_idx)\n            \n            # Simulate the turning actions to get to the correct orientation.\n            # Create a temporary state to apply turns without altering the 'state' from the queue.\n            temp_state_before_use = state \n            for turn_action in turns_to_face:\n                _, temp_state_before_use = temp_state_before_use.step(turn_action)\n            \n            # Capture inventory and grid states immediately before the final USE_ACT.\n            inventory_before_adj_use = np.copy(temp_state_before_use.inventory)\n            grid_before_adj_use = np.copy(temp_state_before_use.grid)\n            \n            # Perform the USE_ACT.\n            _, state_after_adj_use = temp_state_before_use.step(USE_ACT)\n            \n            # Check if USE_ACT on adjacent cell resulted in a meaningful state change.\n            state_changed_by_adj_use = not (\n                np.array_equal(state_after_adj_use.inventory, inventory_before_adj_use) and\n                state_after_adj_use.pos == temp_state_before_use.pos and\n                state_after_adj_use.dir == temp_state_before_use.dir and\n                np.array_equal(state_after_adj_use.grid, grid_before_adj_use)\n            )\n            if state_changed_by_adj_use:\n                potential_next_transitions.append(\n                    (state_after_adj_use, path + turns_to_face + [USE_ACT], inventory_before_adj_use)\n                )\n\n    # --- Process all generated potential next transitions ---\n    for next_s, next_p, inv_before_action in potential_next_transitions:\n        # First, check if the target primitive was successfully collected in this transition.\n        # This is the goal condition for the 'collect' function.\n        if next_s.inventory[i_kind] > inv_before_action[i_kind]:\n            return next_p # Goal achieved! Return the shortest path immediately (due to BFS property).\n\n        # If not the goal, add the new state to the queue if it hasn't been visited yet.\n        next_inventory_tuple = tuple(next_s.inventory)\n        next_grid_hash = hash(next_s.grid.tobytes())\n        next_state_key = (next_grid_hash, next_s.pos[0], next_s.pos[1], next_s.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((next_s, next_p))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state within the search limits.\n  return []", "island_id": 6, "scores": {"3": 2.5}}
{"timestamp": "2025-08-01T15:22:23.405400", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n  This version further relaxes the search limits to allow for finding paths\n  in more complex or larger environments, potentially involving more steps\n  or more significant grid modifications.\n  \"\"\"\n  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Semantic check: Determine if this primitive is *actually* collectible into inventory.\n  # This includes items defined as primitives, special environment items like water/stone,\n  # and any other items explicitly marked as grabbable.\n  is_primitive_resource = i_kind in world.cookbook.primitives\n  is_special_collectible_environment = (i_kind == world.water_index or i_kind == world.stone_index)\n  is_grabbable = i_kind in world.grabbable_indices\n\n  if not (is_primitive_resource or is_special_collectible_environment or is_grabbable):\n      # The requested primitive is not collectible by means of a direct \"collect\" action.\n      # E.g., Workshops are locations, not items that can be collected into inventory.\n      return []\n\n  # 3. Check if the primitive is already in the agent's inventory.\n  if current_state.inventory[i_kind] > 0:\n      # Primitive is already collected, no actions needed.\n      return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # Delta coordinates for each direction (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT) relative to agent's position (row_delta, col_delta).\n  _DIRECTION_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row decreases, col stays same\n      1: (0, 1),  # RIGHT: row stays same, col increases\n      2: (1, 0),  # DOWN: row increases, col stays same\n      3: (0, -1)  # LEFT: row stays same, col decreases\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return []\n      # Calculate difference ensuring it's positive and within [0, 3] for turns.\n      diff = (target_dir - current_dir + 4) % 4\n      if diff == 1: # Clockwise turn (e.g., UP to RIGHT)\n          return [RIGHT_ACT]\n      elif diff == 3: # Counter-clockwise turn (e.g., UP to LEFT)\n          return [LEFT_ACT]\n      else: # diff == 2 (180-degree turn, e.g., UP to DOWN)\n          return [RIGHT_ACT, RIGHT_ACT] # Two right turns (or two left turns)\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The `visited` set tracks states already explored to prevent cycles and redundant work.\n  # A state is defined by (grid_hash, row, col, direction, inventory_tuple).\n  # `grid.tobytes()` is used for hashing the grid, ensuring distinct grid layouts are treated as distinct states.\n  # This is crucial because `USE_ACT` can modify the grid (e.g., removing a tree).\n  visited = set() \n\n  initial_inventory_tuple = tuple(current_state.inventory)\n  initial_grid_hash = hash(current_state.grid.tobytes()) \n\n  q.append((current_state, [])) # Queue stores (CraftState object, path_to_reach_this_state)\n  visited.add((initial_grid_hash, current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_rows, grid_cols, _ = current_state.grid.shape # Get grid dimensions as (rows, columns, kinds)\n\n  # Adaptive search limits:\n  # MAX_EXPLORED_STATES: Limits the total number of unique states processed to prevent\n  #                      runaway searches in very large or complex state spaces.\n  #                      Increased from 200 (in v1) to 300 to allow for wider exploration.\n  MAX_EXPLORED_STATES = grid_rows * grid_cols * 4 * 300 \n  \n  # MAX_PATH_LENGTH: Limits the length of any path considered. Set adaptively based on\n  #                  the grid dimensions, allowing for longer paths on larger maps,\n  #                  plus a buffer for turns and interactions. Increased from (rows+cols)*7\n  #                  to max(rows, cols)*12 to accommodate longer detours or complex sequences.\n  MAX_PATH_LENGTH = max(grid_rows, grid_cols) * 12 \n\n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft()\n    explored_states_count += 1\n\n    # Pruning: If exploration limits are reached, stop exploring from this path.\n    # This prevents the search from becoming excessively long or consuming too much memory/time.\n    if explored_states_count > MAX_EXPLORED_STATES or len(path) >= MAX_PATH_LENGTH:\n      continue\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n\n    # List to store (next_state_object, actions_to_reach_next_state, inventory_before_last_action_applied)\n    # Storing 'inventory_before_last_action_applied' is crucial for detecting if the goal item\n    # was *specifically* acquired in the last step of a transition.\n    potential_next_transitions = []\n\n    # --- Generate all potential next states from the current state ---\n\n    # 1. Explore Movement Actions (UP, DOWN, LEFT, RIGHT)\n    for action in move_actions:\n        # Simulate step. The 'reward' is always 0.0 for this environment implementation.\n        # The 'inventory_before_move' is the current state's inventory, for later comparison.\n        inventory_before_move = np.copy(state.inventory)\n        _, next_state = state.step(action)\n        potential_next_transitions.append((next_state, path + [action], inventory_before_move))\n\n    # 2. Explore USE_ACT at the agent's current position.\n    # This covers collecting items directly from the cell the agent is standing on (e.g., grabbable items).\n    inventory_before_use_at_pos = np.copy(state.inventory)\n    grid_before_use_at_pos = np.copy(state.grid)\n    _, state_after_use_at_pos = state.step(USE_ACT)\n    \n    # Check if USE_ACT at current position resulted in a meaningful state change.\n    # A change implies interaction (e.g., item collected, grid modified).\n    state_changed_by_use_at_pos = not (\n        np.array_equal(state_after_use_at_pos.inventory, inventory_before_use_at_pos) and\n        state_after_use_at_pos.pos == state.pos and # Position usually unchanged by USE\n        state_after_use_at_pos.dir == state.dir and # Direction usually unchanged by USE\n        np.array_equal(state_after_use_at_pos.grid, grid_before_use_at_pos) # Grid can change if item removed/resource harvested\n    )\n    if state_changed_by_use_at_pos:\n        potential_next_transitions.append((state_after_use_at_pos, path + [USE_ACT], inventory_before_use_at_pos))\n    \n    # 3. Explore USE_ACT on adjacent cells (after turning to face them).\n    # This handles interacting with entities in the surrounding environment (e.g., chopping trees, mining rocks).\n    for target_dir_idx in range(4): # Iterate through all four possible facing directions (0, 1, 2, 3)\n        row_delta, col_delta = _DIRECTION_TO_DELTA_FRONT[target_dir_idx]\n        facing_r, facing_c = current_r + row_delta, current_c + col_delta\n\n        # Check if the cell the agent would face is within grid bounds AND contains any entity.\n        # This broad check is necessary because we don't know which specific entity yields the primitive\n        # without inspecting CraftState's internal logic for USE_ACT.\n        if (0 <= facing_r < grid_rows and 0 <= facing_c < grid_cols) and np.any(state.grid[facing_r, facing_c, :] == 1):\n            turns_to_face = _get_turning_actions(current_dir, target_dir_idx)\n            \n            # Simulate the turning actions to get to the correct orientation.\n            # Create a temporary state to apply turns without altering the 'state' from the queue.\n            temp_state_before_use = state \n            for turn_action in turns_to_face:\n                _, temp_state_before_use = temp_state_before_use.step(turn_action)\n            \n            # Capture inventory and grid states immediately before the final USE_ACT.\n            inventory_before_adj_use = np.copy(temp_state_before_use.inventory)\n            grid_before_adj_use = np.copy(temp_state_before_use.grid)\n            \n            # Perform the USE_ACT.\n            _, state_after_adj_use = temp_state_before_use.step(USE_ACT)\n            \n            # Check if USE_ACT on adjacent cell resulted in a meaningful state change.\n            state_changed_by_adj_use = not (\n                np.array_equal(state_after_adj_use.inventory, inventory_before_adj_use) and\n                state_after_adj_use.pos == temp_state_before_use.pos and\n                state_after_adj_use.dir == temp_state_before_use.dir and\n                np.array_equal(state_after_adj_use.grid, grid_before_adj_use)\n            )\n            if state_changed_by_adj_use:\n                potential_next_transitions.append(\n                    (state_after_adj_use, path + turns_to_face + [USE_ACT], inventory_before_adj_use)\n                )\n\n    # --- Process all generated potential next transitions ---\n    for next_s, next_p, inv_before_action in potential_next_transitions:\n        # First, check if the target primitive was successfully collected in this transition.\n        # This is the goal condition for the 'collect' function.\n        if next_s.inventory[i_kind] > inv_before_action[i_kind]:\n            return next_p # Goal achieved! Return the shortest path immediately (due to BFS property).\n\n        # If not the goal, add the new state to the queue if it hasn't been visited yet.\n        next_inventory_tuple = tuple(next_s.inventory)\n        next_grid_hash = hash(next_s.grid.tobytes())\n        next_state_key = (next_grid_hash, next_s.pos[0], next_s.pos[1], next_s.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((next_s, next_p))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state within the search limits.\n  return []", "island_id": 6, "scores": {"3": 2.5}}
{"timestamp": "2025-08-01T15:24:01.292976", "function_name": "collect", "function_body": "  \"\"\"Finds the shortest sequence of actions to collect a specified primitive item.\n\n    This function uses a Breadth-First Search (BFS) to explore possible game states.\n    A state is defined by the agent's position, direction, inventory, and the current\n    grid configuration. The search continues until the primitive is found in the\n    agent's inventory or the search limits are reached.\n\n    Args:\n        env (env.CraftLab): The CraftLab environment instance.\n        primitive (str): The name of the primitive item to collect (e.g., \"wood\", \"stone\").\n\n    Returns:\n        List[int]: A list of action indices representing the shortest path to collect\n                   the primitive. Returns an empty list if the primitive is already\n                   in inventory, is not collectible, or cannot be reached within\n                   the defined search limits.\n  \"\"\"\n  current_state = env._current_state\n  world = env.world # Access to Cookbook, indices, etc.\n\n  # --- Configuration and Initialization ---\n\n  # 1. Resolve primitive name to its integer ID.\n  # If the primitive name is not recognized, it cannot be collected.\n  try:\n    primitive_id = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    return []\n\n  # 2. Semantic check: Determine if this primitive is a type that can be \"collected\".\n  # This includes items defined as base primitives, special environment features,\n  # or any item classified as generally grabbable.\n  is_collectible_type = (\n      primitive_id in world.cookbook.primitives or\n      primitive_id == world.water_index or\n      primitive_id == world.stone_index or\n      primitive_id in world.grabbable_indices\n  )\n  if not is_collectible_type:\n    return [] # This item type cannot be acquired via the 'collect' action.\n\n  # 3. Early Exit: If the primitive is already in the agent's inventory, no actions are needed.\n  if current_state.inventory[primitive_id] > 0:\n    return []\n\n  # 4. Define Action Constants and Movement/Direction Utilities.\n  action_map = env.action_specs()\n  ACTION_UP = action_map[\"UP\"]\n  ACTION_DOWN = action_map[\"DOWN\"]\n  ACTION_LEFT = action_map[\"LEFT\"]\n  ACTION_RIGHT = action_map[\"RIGHT\"]\n  ACTION_USE = action_map[\"USE\"]\n\n  MOVEMENT_ACTIONS = [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]\n\n  # Delta coordinates for cells directly in front of the agent, based on its direction.\n  # Direction mapping: 0=UP, 1=RIGHT, 2=DOWN, 3=LEFT.\n  _DIRECTION_TO_FRONT_DELTA = {\n      0: (-1, 0), # UP: row decreases\n      1: (0, 1),  # RIGHT: col increases\n      2: (1, 0),  # DOWN: row increases\n      3: (0, -1)  # LEFT: col decreases\n  }\n\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      \"\"\"Calculates the minimal turning actions (LEFT/RIGHT) to face a target direction.\"\"\"\n      if current_dir == target_dir:\n          return []\n      \n      # Calculate the difference in 90-degree turns clockwise. Modulo 4 handles wrapping.\n      diff = (target_dir - current_dir + 4) % 4\n      if diff == 1: # 90 degrees clockwise\n          return [ACTION_RIGHT]\n      elif diff == 3: # 270 degrees clockwise (90 degrees counter-clockwise / 1 LEFT)\n          return [ACTION_LEFT]\n      else: # diff == 2 (180 degrees, e.g., UP to DOWN or vice versa)\n          return [ACTION_RIGHT, ACTION_RIGHT] # Two right turns is simplest representation.\n\n  # 5. Helper for hashing the grid for visited state tracking.\n  def _get_grid_hash(grid: np.ndarray) -> int:\n      \"\"\"Returns a hash for a numpy grid array for use in visited sets.\"\"\"\n      # Converting to bytes and then hashing is a standard and robust way to hash NumPy arrays.\n      return hash(grid.tobytes())\n\n  # --- BFS Setup ---\n\n  # Queue for BFS: stores (CraftState object, list_of_actions_to_reach_this_state)\n  bfs_queue = collections.deque()\n  \n  # Set to track visited states to prevent cycles and redundant exploration.\n  # A state is uniquely identified by (grid_hash, agent_row, agent_col, agent_direction, inventory_tuple).\n  # grid_hash: Essential because 'USE' actions can modify the environment grid (e.g., removing a tree).\n  # inventory_tuple: Essential because agent's capabilities (e.g., crafting, effective 'USE' actions) depend on inventory.\n  # (pos, dir): Standard agent localization.\n  visited_states = set() \n\n  # Initialize BFS with the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  initial_grid_hash = _get_grid_hash(current_state.grid) \n\n  bfs_queue.append((current_state, []))\n  visited_states.add((initial_grid_hash, current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_rows, grid_cols, _ = current_state.grid.shape\n  \n  # Heuristic limits to manage computational complexity and prevent excessive search.\n  # These values are chosen to balance search completeness with practical execution time.\n  MAX_EXPLORED_UNIQUE_STATES = grid_rows * grid_cols * 4 * 150 # Upper bound on unique states to explore.\n  MAX_ACTION_PATH_LENGTH = 250 # Upper bound on the length of an action sequence.\n\n  num_explored_states = 0\n\n  # Helper function to process a newly generated state.\n  # This function checks for the goal condition and adds the state to the BFS queue if not visited.\n  # It raises StopIteration if the goal is found, enabling an early exit from the BFS loop.\n  def _process_next_state(next_state: craft.CraftState, path_to_next_state: list[int], inventory_before_last_action: np.ndarray):\n      \"\"\"Checks for goal achievement or adds a new state to the BFS queue.\"\"\"\n      # Check if the primitive was acquired due to the *last action* in the path.\n      if next_state.inventory[primitive_id] > inventory_before_last_action[primitive_id]:\n          raise StopIteration(path_to_next_state) # Goal found! Propagate the path.\n\n      # If not the goal, prepare the key for the new state and add to visited set/queue.\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_grid_hash = _get_grid_hash(next_state.grid)\n      next_state_key = (next_grid_hash, next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited_states:\n          visited_states.add(next_state_key)\n          bfs_queue.append((next_state, path_to_next_state))\n\n  # --- BFS Loop ---\n  try:\n    while bfs_queue:\n      current_bfs_state, current_path = bfs_queue.popleft()\n      num_explored_states += 1\n\n      # Pruning: Skip this path if search limits are exceeded.\n      if num_explored_states > MAX_EXPLORED_UNIQUE_STATES or len(current_path) >= MAX_ACTION_PATH_LENGTH:\n        continue \n\n      agent_r, agent_c = current_bfs_state.pos\n      agent_dir = current_bfs_state.dir\n\n      # --- Generate Potential Next States from Current BFS State ---\n\n      # 1. Explore Movement Actions (UP, DOWN, LEFT, RIGHT).\n      for move_action in MOVEMENT_ACTIONS:\n          # current_bfs_state.step() returns a *new* state object, so no need to copy inventory.\n          _, next_s_after_move = current_bfs_state.step(move_action)\n          _process_next_state(next_s_after_move, current_path + [move_action], current_bfs_state.inventory)\n\n      # 2. Explore ACTION_USE at the agent's current position.\n      # This covers collecting items directly from the tile the agent is standing on\n      # (e.g., picking up a loose item or interacting with a workstation at the current spot).\n      inventory_before_use_at_pos = current_bfs_state.inventory\n      grid_before_use_at_pos = current_bfs_state.grid # Snapshot grid state before USE\n      _, next_s_after_use_at_pos = current_bfs_state.step(ACTION_USE)\n      \n      # Only process this if the USE action resulted in a state change (e.g., inventory or grid).\n      if not (np.array_equal(next_s_after_use_at_pos.inventory, inventory_before_use_at_pos) and\n              np.array_equal(next_s_after_use_at_pos.grid, grid_before_use_at_pos) and\n              next_s_after_use_at_pos.pos == current_bfs_state.pos and\n              next_s_after_use_at_pos.dir == current_bfs_state.dir):\n          _process_next_state(next_s_after_use_at_pos, current_path + [ACTION_USE], inventory_before_use_at_pos)\n      \n      # 3. Explore ACTION_USE on adjacent cells (after turning to face them).\n      # This handles interactions with entities that require agent orientation,\n      # such as chopping trees, mining rocks, or interacting with workshops.\n      for target_facing_dir in range(4): # Iterate through UP, RIGHT, DOWN, LEFT as potential target directions.\n          dr, dc = _DIRECTION_TO_FRONT_DELTA[target_facing_dir]\n          facing_r, facing_c = agent_r + dr, agent_c + dc\n\n          # Check if the cell in front is within grid bounds AND contains any entity.\n          # We check for 'any' entity, as 'USE' on one entity might yield another (e.g., 'ROCK' -> 'IRON').\n          if (0 <= facing_r < grid_rows and 0 <= facing_c < grid_cols) and np.any(current_bfs_state.grid[facing_r, facing_c, :] == 1):\n              \n              # First, get the actions to orient the agent towards the target cell.\n              turning_actions = _get_turning_actions(agent_dir, target_facing_dir)\n              \n              # Simulate these turning actions to reach an intermediate state with correct orientation.\n              temp_state_after_turns = current_bfs_state\n              for turn_action in turning_actions:\n                  _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n              \n              # Capture inventory and grid states *before* the final ACTION_USE in this branch.\n              inventory_before_adj_use = temp_state_after_turns.inventory\n              grid_before_adj_use = temp_state_after_turns.grid\n              \n              # Perform the ACTION_USE from the correctly oriented state.\n              _, next_s_after_adj_use = temp_state_after_turns.step(ACTION_USE)\n              \n              # Only consider this transition if the ACTION_USE resulted in a state change.\n              if not (np.array_equal(next_s_after_adj_use.inventory, inventory_before_adj_use) and\n                      np.array_equal(next_s_after_adj_use.grid, grid_before_adj_use) and\n                      next_s_after_adj_use.pos == temp_state_after_turns.pos and\n                      next_s_after_adj_use.dir == temp_state_after_turns.dir):\n                  _process_next_state(next_s_after_adj_use, current_path + turning_actions + [ACTION_USE], inventory_before_adj_use)\n  except StopIteration as e:\n    # The goal was found and the path is carried by the exception value.\n    return e.value\n\n  # If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current\n  # environment configuration and search limits.\n  return []", "island_id": 2, "scores": {"3": 2.5}}
{"timestamp": "2025-08-01T15:24:04.352077", "function_name": "collect", "function_body": "  \"\"\"Finds and collects a specified primitive item in the environment using a Breadth-First Search (BFS).\n\n  This function determines the shortest sequence of actions required for the agent to acquire\n  at least one unit of the `primitive` into its inventory. It accounts for movement,\n  and using the `USE` action to interact with the environment (both at the agent's\n  current position and on adjacent tiles after turning).\n\n  Args:\n      env (env.CraftLab): The CraftLab environment instance, providing access to\n                          the current game state and world configuration.\n      primitive (str): The string name of the primitive item to collect (e.g., \"wood\", \"stone\").\n\n  Returns:\n      List[int]: A list of action indices (integers) representing the shortest path\n                 to collect the primitive. Returns an empty list if the primitive\n                 is already in inventory, is not collectible, or is unreachable\n                 within the defined search limits.\n  \"\"\"\n  current_state = env._current_state\n  world = env.world # Access to CraftWorld, which holds Cookbook, indices, etc.\n\n  # 1. Map the primitive name string to its integer ID.\n  # If the name is not recognized, it cannot be collected.\n  try:\n    primitive_id = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # Primitive name not found in the world's index (e.g., typo, or non-existent item).\n    return []\n\n  # 2. Determine if the requested item is semantically collectible via this function.\n  # Collectible items include:\n  #   - Core primitive resources (e.g., \"wood\", \"iron\").\n  #   - Special environmental features that can be collected/interacted with (e.g., \"water\", \"stone\").\n  #   - Any item explicitly marked as 'grabbable' in the world configuration.\n  is_collectible_type = (\n      primitive_id in world.cookbook.primitives or\n      primitive_id == world.water_index or\n      primitive_id == world.stone_index or\n      primitive_id in world.grabbable_indices\n  )\n  if not is_collectible_type:\n    # If the item cannot be acquired through a \"collect\" action (e.g., it's a crafted item, a workshop),\n    # then this function should not attempt to find it.\n    return []\n\n  # 3. Early exit: If the primitive is already present in the agent's inventory,\n  # no actions are required.\n  if current_state.inventory[primitive_id] > 0:\n    return []\n\n  # 4. Define action constants and helper utilities for movement and direction.\n  action_map = env.action_specs()\n  ACTION_UP = action_map[\"UP\"]\n  ACTION_DOWN = action_map[\"DOWN\"]\n  ACTION_LEFT = action_map[\"LEFT\"]\n  ACTION_RIGHT = action_map[\"RIGHT\"]\n  ACTION_USE = action_map[\"USE\"]\n\n  MOVEMENT_ACTIONS = [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]\n\n  # Delta coordinates for cells directly in front of the agent, indexed by agent's direction.\n  # Direction mapping: 0=UP, 1=RIGHT, 2=DOWN, 3=LEFT.\n  DIRECTION_DELTAS = {\n      0: (-1, 0), # UP: row decreases, col same\n      1: (0, 1),  # RIGHT: row same, col increases\n      2: (1, 0),  # DOWN: row increases, col same\n      3: (0, -1)  # LEFT: row same, col decreases\n  }\n\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      \"\"\"Calculates the minimal turning actions (LEFT/RIGHT) to face a target direction.\"\"\"\n      if current_dir == target_dir:\n          return [] # Already facing the desired direction.\n      \n      # Calculate the difference in 90-degree turns clockwise. Modulo 4 handles wrapping around.\n      diff_clockwise = (target_dir - current_dir + 4) % 4\n      \n      if diff_clockwise == 1: # 90 degrees clockwise turn.\n          return [ACTION_RIGHT]\n      elif diff_clockwise == 3: # 270 degrees clockwise turn (equivalent to 90 degrees counter-clockwise).\n          return [ACTION_LEFT]\n      else: # diff_clockwise == 2 (180 degrees turn).\n          return [ACTION_RIGHT, ACTION_RIGHT] # Two right turns (or two left turns).\n\n  # 5. Initialize Breadth-First Search (BFS) components for state exploration.\n  # The BFS queue stores tuples: (current_state_object, list_of_actions_taken_to_reach_this_state).\n  bfs_queue = collections.deque()\n  \n  # The `visited_states` set keeps track of unique states already explored to prevent cycles\n  # and redundant computation. A state is uniquely defined by the agent's position, direction,\n  # inventory, and the entire grid configuration (as the grid can change via 'USE' actions).\n  initial_agent_pos = current_state.pos\n  initial_agent_dir = current_state.dir\n  initial_inventory_tuple = tuple(current_state.inventory) # Convert inventory array to tuple for hashing.\n  initial_grid_hash = hash(current_state.grid.tobytes()) # Hash the grid's raw bytes for a compact representation.\n\n  bfs_queue.append((current_state, [])) # Start the BFS from the initial state with an empty action path.\n  visited_states = set([(initial_grid_hash, initial_agent_pos[0], initial_agent_pos[1], initial_agent_dir, initial_inventory_tuple)])\n\n  grid_rows, grid_cols, _ = current_state.grid.shape\n  \n  # Define heuristic limits for the BFS search to prevent unbounded computation\n  # in very large or complex environments. These values are empirical.\n  MAX_EXPLORED_UNIQUE_STATES = grid_rows * grid_cols * 4 * 150 # Max number of unique states to visit.\n  MAX_ACTION_PATH_LENGTH = 250 # Max allowed length for a path of actions.\n\n  num_explored_states = 0 # Counter for states processed during BFS.\n\n  # Helper function to encapsulate the logic for processing a newly generated state.\n  # This function checks for goal achievement and adds the state to the BFS queue if it's new.\n  # It uses `StopIteration` for an efficient early exit when the goal is found.\n  def _process_next_state(next_state: craft.CraftState, path_to_next_state: list[int], inventory_before_action: np.ndarray):\n      \"\"\"\n      Checks if the goal primitive was acquired, and if not, adds the new state to the BFS queue.\n      Raises StopIteration if the goal is achieved.\n      \"\"\"\n      # Check if the primitive's count in inventory increased as a result of the last action.\n      if next_state.inventory[primitive_id] > inventory_before_action[primitive_id]:\n          raise StopIteration(path_to_next_state) # Goal achieved! Propagate the path upwards.\n\n      # If the goal is not yet achieved, add this state to the BFS queue if it hasn't been visited.\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_grid_hash = hash(next_state.grid.tobytes())\n      next_state_key = (next_grid_hash, next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited_states:\n          visited_states.add(next_state_key)\n          bfs_queue.append((next_state, path_to_next_state))\n\n  # 6. Main BFS Loop: Continues until the queue is empty or the goal is found.\n  try:\n    while bfs_queue:\n      current_bfs_state, current_path = bfs_queue.popleft()\n      num_explored_states += 1\n\n      # Pruning: Skip this path if search limits are exceeded.\n      if num_explored_states > MAX_EXPLORED_UNIQUE_STATES or len(current_path) >= MAX_ACTION_PATH_LENGTH:\n        continue \n\n      agent_r, agent_c = current_bfs_state.pos\n      agent_dir = current_bfs_state.dir\n\n      # --- Generate Potential Next States from the Current BFS State ---\n\n      # A. Explore simple Movement Actions (UP, DOWN, LEFT, RIGHT).\n      for move_action in MOVEMENT_ACTIONS:\n          # `step` returns a new state object, so `current_bfs_state.inventory` is naturally\n          # the inventory *before* this move action.\n          _, next_s_after_move = current_bfs_state.step(move_action)\n          _process_next_state(next_s_after_move, current_path + [move_action], current_bfs_state.inventory)\n\n      # B. Explore ACTION_USE at the agent's current position.\n      # This covers collecting items directly from the tile the agent is standing on\n      # (e.g., picking up grass).\n      inventory_before_use_at_pos = current_bfs_state.inventory\n      grid_before_use_at_pos = current_bfs_state.grid # Capture grid state before USE for change detection.\n      _, next_s_after_use_at_pos = current_bfs_state.step(ACTION_USE)\n      \n      # Only consider this transition if the 'USE' action actually changed the state\n      # (e.g., inventory updated, or grid modified). This avoids exploring useless 'USE' actions.\n      state_changed_by_pos_use = not (\n          np.array_equal(next_s_after_use_at_pos.inventory, inventory_before_use_at_pos) and\n          np.array_equal(next_s_after_use_at_pos.grid, grid_before_use_at_pos) and\n          next_s_after_use_at_pos.pos == current_bfs_state.pos and # Pos should not change for 'USE'\n          next_s_after_use_at_pos.dir == current_bfs_state.dir     # Dir should not change for 'USE'\n      )\n      if state_changed_by_pos_use:\n          _process_next_state(next_s_after_use_at_pos, current_path + [ACTION_USE], inventory_before_use_at_pos)\n      \n      # C. Explore ACTION_USE on adjacent cells (requiring the agent to turn to face them).\n      # This handles interactions like chopping trees or mining rocks.\n      for target_facing_dir in range(4): # Iterate through all 4 cardinal directions (0-3).\n          dr, dc = DIRECTION_DELTAS[target_facing_dir]\n          facing_r, facing_c = agent_r + dr, agent_c + dc\n\n          # Check if the cell in front is within grid bounds AND contains any entity.\n          # We don't check for 'primitive_id' specifically here, as 'USE' might\n          # convert one entity (e.g., 'tree') into the primitive (e.g., 'wood').\n          if (0 <= facing_r < grid_rows and 0 <= facing_c < grid_cols) and np.any(current_bfs_state.grid[facing_r, facing_c, :] == 1):\n              \n              # 1. Get the sequence of turning actions needed to face this adjacent cell.\n              turning_actions = _get_turning_actions(agent_dir, target_facing_dir)\n              \n              # 2. Simulate these turning actions to reach an intermediate state where the agent is oriented.\n              temp_state_after_turns = current_bfs_state\n              for turn_action in turning_actions:\n                  # Each step creates a new state, correctly propagating the intermediate state.\n                  _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n              \n              # 3. Capture inventory and grid states *before* performing the final ACTION_USE.\n              inventory_before_adj_use = temp_state_after_turns.inventory\n              grid_before_adj_use = temp_state_after_turns.grid\n              \n              # 4. Perform the ACTION_USE from the correctly oriented state.\n              _, next_s_after_adj_use = temp_state_after_turns.step(ACTION_USE)\n              \n              # Only add this path if the 'USE' action resulted in a state change.\n              state_changed_by_adj_use = not (\n                  np.array_equal(next_s_after_adj_use.inventory, inventory_before_adj_use) and\n                  np.array_equal(next_s_after_adj_use.grid, grid_before_adj_use) and\n                  next_s_after_adj_use.pos == temp_state_after_turns.pos and\n                  next_s_after_adj_use.dir == temp_state_after_turns.dir\n              )\n              if state_changed_by_adj_use:\n                  _process_next_state(next_s_after_adj_use, current_path + turning_actions + [ACTION_USE], inventory_before_adj_use)\n  \n  except StopIteration as e:\n    # The `_process_next_state` helper raised StopIteration, meaning the goal was found.\n    # The value of the exception contains the path to the goal.\n    return e.value\n\n  # 7. If the BFS loop completes without finding the primitive (i.e., the queue becomes empty\n  # and StopIteration was not raised), it means the primitive is unreachable from the initial\n  # state under the current conditions or within the defined search limits.\n  return []", "island_id": 2, "scores": {"3": 2.5}}
{"timestamp": "2025-08-01T15:25:40.592578", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set now includes the agent's inventory as part of the state key.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing, allowing BFS to distinguish\n  # between states that are identical in position/direction but differ in inventory (e.g., having a tool vs. not).\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Improvement for v2: Dynamically adjust MAX_EXPLORED_STATES based on the number of item kinds.\n  # This makes the heuristic limit more robust as the complexity of the inventory state space scales.\n  # A factor of (n_kinds + 1) is used to account for potential variations in inventory content.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * (world.cookbook.n_kinds + 1) \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`).\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore actions that change the state.\n    # First, consider the general USE action from the current position. This is important\n    # if using an item at the current position (e.g., picking up a tool) can change the\n    # inventory state, which might be necessary for later steps to collect the primitive.\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if the USE action resulted in a meaningful state change (inventory, position, or direction).\n    # This prevents adding redundant states to the queue if USE had no effect.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n    # Then, explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n  \n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 0, "scores": {"3": 1.5}}
