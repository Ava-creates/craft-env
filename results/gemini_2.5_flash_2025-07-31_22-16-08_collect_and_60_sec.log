{"timestamp": "2025-08-01T14:10:58.209829", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Semantic check: Determine if this primitive is *actually* collectible into inventory.\n  # This includes items defined as primitives, special environment items like water/stone,\n  # and any other items explicitly marked as grabbable.\n  is_primitive_resource = i_kind in world.cookbook.primitives\n  is_special_collectible_environment = (i_kind == world.water_index or i_kind == world.stone_index)\n  is_grabbable = i_kind in world.grabbable_indices\n\n  if not (is_primitive_resource or is_special_collectible_environment or is_grabbable):\n      # The requested primitive is not collectible through a direct 'collect' action.\n      # It might be craftable, but that's handled by the 'craft' DSL function.\n      return []\n\n  # 3. Check if the primitive is already in the agent's inventory.\n  if current_state.inventory[i_kind] > 0:\n      # Primitive is already collected, no actions needed.\n      return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row decreases, col stays same\n      1: (0, 1),  # RIGHT: row stays same, col increases\n      2: (1, 0),  # DOWN: row increases, col stays same\n      3: (0, -1)  # LEFT: row stays same, col decreases\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return []\n      # Calculate difference ensuring it's positive and within [0, 3]\n      diff = (target_dir - current_dir + 4) % 4\n      if diff == 1:\n          return [RIGHT_ACT] # One right turn (e.g., 0->1)\n      elif diff == 3:\n          return [LEFT_ACT]  # One left turn (e.g., 0->3)\n      else: # diff == 2 (180-degree turn, e.g., 0->2)\n          return [RIGHT_ACT, RIGHT_ACT] # Two right turns (or two left turns)\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The visited set must capture the full state to prevent redundant exploration,\n  # especially if grid changes without immediate inventory/position changes.\n  # State key: (grid_hash, row, col, direction, inventory_tuple)\n  visited = set() \n\n  initial_inventory_tuple = tuple(current_state.inventory)\n  # Hash the grid to include its state in the visited key.\n  # .tobytes() converts the numpy array to a bytes object, which is hashable.\n  initial_grid_hash = hash(current_state.grid.tobytes()) \n\n  q.append((current_state, [])) # Queue stores (CraftState object, path_to_reach_this_state)\n  visited.add((initial_grid_hash, current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Refined heuristic upper bounds for search limits:\n  # MAX_EXPLORED_STATES is increased slightly from v1 (150) to v0 (200), as the path length limit helps\n  # manage overall search complexity, allowing for a broader state exploration.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 200 \n  # MAX_PATH_LENGTH is re-introduced (was absent in v1) to prevent excessively long and inefficient\n  # action sequences, focusing the search on finding reasonably direct paths to the primitive.\n  MAX_PATH_LENGTH = max(grid_width, grid_height) * 8 \n\n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft()\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states or the path length exceeds a heuristic limit,\n    # skip further exploration from this state to prevent runaway searches.\n    if explored_states_count > MAX_EXPLORED_STATES or len(path) >= MAX_PATH_LENGTH:\n      continue\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n\n    # List to store (next_state_object, actions_to_reach_next_state, inventory_before_last_action_applied)\n    # Storing 'inventory_before_last_action_applied' is crucial for checking if the goal item\n    # was *specifically* acquired in the last step of a transition.\n    potential_next_transitions = []\n\n    # --- Generate all potential next states from the current state ---\n\n    # 1. Explore Movement Actions (UP, DOWN, LEFT, RIGHT)\n    for action in move_actions:\n        _, next_state = state.step(action)\n        # For movement, the 'inventory_before_action' is simply the current state's inventory.\n        potential_next_transitions.append((next_state, path + [action], np.copy(state.inventory)))\n\n    # 2. Explore USE_ACT at current position\n    # This handles collecting items directly from the cell the agent is standing on (e.g., grabbable items).\n    inventory_before_use_at_pos = np.copy(state.inventory)\n    grid_before_use_at_pos = np.copy(state.grid) # Capture grid state before USE\n    _, state_after_use_at_pos = state.step(USE_ACT)\n    \n    # Only consider this transition if the USE_ACT actually resulted in a state change\n    # (e.g., inventory changed, or grid changed, or position/direction changed).\n    # This filters out null/ineffective USE actions.\n    state_changed_by_use_at_pos = not (\n        np.array_equal(state_after_use_at_pos.inventory, inventory_before_use_at_pos) and\n        state_after_use_at_pos.pos == state.pos and\n        state_after_use_at_pos.dir == state.dir and\n        np.array_equal(state_after_use_at_pos.grid, grid_before_use_at_pos) \n    )\n    if state_changed_by_use_at_pos:\n        potential_next_transitions.append((state_after_use_at_pos, path + [USE_ACT], inventory_before_use_at_pos))\n    \n    # 3. Explore USE_ACT on adjacent cells (after turning to face them)\n    # This handles interacting with items/structures in the surrounding environment (e.g., chopping trees, mining rocks).\n    for target_dir in range(4): # Iterate through all four possible facing directions\n        dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n        facing_r, facing_c = current_r + dr, current_c + dc\n\n        # Check if the facing cell is within grid bounds and contains *any* entity.\n        # This allows interaction with any relevant environmental object that might yield the target primitive.\n        if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height) and np.any(state.grid[facing_r, facing_c, :] == 1):\n            turns_to_face = _get_turning_actions(current_dir, target_dir)\n            \n            # Simulate the turns to get the agent into the correct orientation before the USE_ACT.\n            temp_state_before_use_step = state\n            for turn_action in turns_to_face:\n                _, temp_state_before_use_step = temp_state_before_use_step.step(turn_action)\n            \n            # Capture inventory and grid states immediately before the final USE_ACT.\n            inventory_before_adj_use = np.copy(temp_state_before_use_step.inventory)\n            grid_before_adj_use = np.copy(temp_state_before_use_step.grid)\n            \n            # Perform the USE_ACT.\n            _, state_after_adj_use = temp_state_before_use_step.step(USE_ACT)\n            \n            # Only add this transition if the USE_ACT resulted in a change of state.\n            state_changed_by_adj_use = not (\n                np.array_equal(state_after_adj_use.inventory, inventory_before_adj_use) and\n                state_after_adj_use.pos == temp_state_before_use_step.pos and\n                state_after_adj_use.dir == temp_state_before_use_step.dir and\n                np.array_equal(state_after_adj_use.grid, grid_before_adj_use) \n            )\n            if state_changed_by_adj_use:\n                potential_next_transitions.append(\n                    (state_after_adj_use, path + turns_to_face + [USE_ACT], inventory_before_adj_use)\n                )\n\n    # --- Process all generated potential next transitions ---\n    for next_s, next_p, inv_before_action in potential_next_transitions:\n        # First, check if the target primitive was successfully collected in this transition.\n        if next_s.inventory[i_kind] > inv_before_action[i_kind]:\n            return next_p # Goal achieved! Return the shortest path immediately.\n\n        # If not the goal, add the new state to the queue if it hasn't been visited yet.\n        next_inventory_tuple = tuple(next_s.inventory)\n        next_grid_hash = hash(next_s.grid.tobytes()) # Hash grid for the visited set key\n        next_state_key = (next_grid_hash, next_s.pos[0], next_s.pos[1], next_s.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((next_s, next_p))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions\n  # and within the defined search limits.\n  return []", "island_id": 6, "scores": {"3": 2.5}}
{"timestamp": "2025-08-01T14:12:11.203165", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    # This also handles cases where a non-collectible \"primitive\" name is passed (e.g., \"workshop0\").\n    return []\n\n  # 2. Semantic check: Determine if this primitive is *actually* collectible into inventory.\n  # This includes items defined as primitives, special environment items like water/stone,\n  # and any other items explicitly marked as grabbable.\n  is_primitive_resource = i_kind in world.cookbook.primitives\n  is_special_collectible_environment = (i_kind == world.water_index or i_kind == world.stone_index)\n  is_grabbable = i_kind in world.grabbable_indices\n\n  if not (is_primitive_resource or is_special_collectible_environment or is_grabbable):\n      # The requested primitive is not collectible by means of a direct \"collect\" action.\n      # E.g., Workshops are locations, not items that can be collected into inventory.\n      # This filter helps avoid futile searches for uncollectible items.\n      return []\n\n  # 3. Check if the primitive is already in the agent's inventory.\n  if current_state.inventory[i_kind] > 0:\n      # Primitive is already collected, no actions needed. This is an immediate win.\n      return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # Delta coordinates for each direction (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT) relative to agent's position (row_delta, col_delta).\n  _DIRECTION_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row decreases, col stays same\n      1: (0, 1),  # RIGHT: row stays same, col increases\n      2: (1, 0),  # DOWN: row increases, col stays same\n      3: (0, -1)  # LEFT: row stays same, col decreases\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return []\n      # Calculate difference ensuring it's positive and within [0, 3] for turns.\n      diff = (target_dir - current_dir + 4) % 4\n      if diff == 1: # Clockwise turn (e.g., UP to RIGHT)\n          return [RIGHT_ACT]\n      elif diff == 3: # Counter-clockwise turn (e.g., UP to LEFT)\n          return [LEFT_ACT]\n      else: # diff == 2 (180-degree turn, e.g., UP to DOWN)\n          return [RIGHT_ACT, RIGHT_ACT] # Two right turns (or two left turns) are shortest for 180 deg.\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The `visited` set tracks unique states (grid_config, agent_pos, agent_dir, inventory)\n  # to prevent revisiting states and ensure the shortest path.\n  # Hashing the grid's bytes is critical because the grid can change due to 'USE_ACT' (e.g., chopping a tree).\n  visited = set() \n\n  initial_inventory_tuple = tuple(current_state.inventory)\n  initial_grid_hash = hash(current_state.grid.tobytes()) \n\n  q.append((current_state, [])) # Queue stores (CraftState object, path_to_reach_this_state)\n  visited.add((initial_grid_hash, current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_rows, grid_cols, _ = current_state.grid.shape # Get grid dimensions as (rows, columns, kinds)\n\n  # Adaptive search limits:\n  # These limits are designed to prevent the BFS from running indefinitely in very\n  # large or complex state spaces, while still allowing for reasonable exploration.\n  # Increased factors compared to v1 to improve robustness for more challenging scenarios.\n  # MAX_EXPLORED_STATES: Limits the total number of unique states processed.\n  # Factor 250 (up from 200 in v1) allows exploring more permutations of grid/inventory states.\n  MAX_EXPLORED_STATES = grid_rows * grid_cols * 4 * 250 \n  \n  # MAX_PATH_LENGTH: Limits the length of any path considered. Set adaptively based on\n  # the grid dimensions, allowing for longer paths on larger maps, plus a buffer for\n  # turns and interactions. Factor 10 (up from 7 in v1) provides even more allowance\n  # for winding paths, detours, and multi-step interactions.\n  MAX_PATH_LENGTH = (grid_rows + grid_cols) * 10 \n\n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft()\n    explored_states_count += 1\n\n    # Pruning: If exploration limits are reached, stop exploring from this path.\n    # This prevents the search from becoming excessively long or consuming too much memory/time.\n    if explored_states_count > MAX_EXPLORED_STATES or len(path) >= MAX_PATH_LENGTH:\n      continue # This path is too long or we've explored too many states, prune this branch.\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n\n    # List to store (next_state_object, actions_to_reach_next_state, inventory_before_last_action_applied)\n    # Storing `inventory_before_last_action_applied` is crucial for precisely detecting\n    # if the target primitive was acquired by the *last* action in the sequence.\n    potential_next_transitions = []\n\n    # --- Generate all potential next states from the current state ---\n\n    # 1. Explore Movement Actions (UP, DOWN, LEFT, RIGHT)\n    for action in move_actions:\n        # Simulate step. Note: The `reward` is always 0.0 in this environment's implementation,\n        # so it's ignored for pathfinding.\n        inventory_before_move = np.copy(state.inventory) # Capture inventory *before* the action\n        _, next_state = state.step(action)\n        potential_next_transitions.append((next_state, path + [action], inventory_before_move))\n\n    # 2. Explore USE_ACT at the agent's current position.\n    # This covers collecting items directly from the cell the agent is standing on (e.g., grabbable items\n    # like \"grass\" or \"gold\" if they are present on the current tile).\n    inventory_before_use_at_pos = np.copy(state.inventory)\n    grid_before_use_at_pos = np.copy(state.grid) # Capture grid state before action to detect changes\n    _, state_after_use_at_pos = state.step(USE_ACT)\n    \n    # Check if USE_ACT at current position resulted in a meaningful state change.\n    # A change implies interaction (e.g., item collected, grid modified).\n    state_changed_by_use_at_pos = not (\n        np.array_equal(state_after_use_at_pos.inventory, inventory_before_use_at_pos) and\n        state_after_use_at_pos.pos == state.pos and # Position usually unchanged by USE\n        state_after_use_at_pos.dir == state.dir and # Direction usually unchanged by USE\n        np.array_equal(state_after_use_at_pos.grid, grid_before_use_at_pos) # Grid can change if item removed/resource harvested\n    )\n    if state_changed_by_use_at_pos:\n        potential_next_transitions.append((state_after_use_at_pos, path + [USE_ACT], inventory_before_use_at_pos))\n    \n    # 3. Explore USE_ACT on adjacent cells (after turning to face them).\n    # This handles interacting with entities in the surrounding environment that require facing them\n    # (e.g., chopping trees, mining rocks, picking up water/stone from adjacent tiles).\n    for target_dir_idx in range(4): # Iterate through all four possible facing directions (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n        row_delta, col_delta = _DIRECTION_TO_DELTA_FRONT[target_dir_idx]\n        facing_r, facing_c = current_r + row_delta, current_c + col_delta\n\n        # Preliminary check: Is the cell the agent would face within grid bounds and does it contain *any* entity?\n        # This broad check is necessary because the environment's `step` logic determines which entities\n        # can be interacted with to yield specific primitives. We don't have a direct \"primitive -> source_entity\" map.\n        if (0 <= facing_r < grid_rows and 0 <= facing_c < grid_cols) and np.any(state.grid[facing_r, facing_c, :] == 1):\n            turns_to_face = _get_turning_actions(current_dir, target_dir_idx)\n            \n            # Simulate the turning actions. It's crucial to create a temporary state\n            # for this sequence of turns to avoid modifying the 'state' object from the queue directly.\n            temp_state_before_use = state \n            for turn_action in turns_to_face:\n                _, temp_state_before_use = temp_state_before_use.step(turn_action)\n            \n            # Capture inventory and grid states immediately before the final USE_ACT.\n            inventory_before_adj_use = np.copy(temp_state_before_use.inventory)\n            grid_before_adj_use = np.copy(temp_state_before_use.grid)\n            \n            # Perform the USE_ACT.\n            _, state_after_adj_use = temp_state_before_use.step(USE_ACT)\n            \n            # Check if USE_ACT on adjacent cell resulted in a meaningful state change.\n            state_changed_by_adj_use = not (\n                np.array_equal(state_after_adj_use.inventory, inventory_before_adj_use) and\n                state_after_adj_use.pos == temp_state_before_use.pos and # Position typically unchanged by USE\n                state_after_adj_use.dir == temp_state_before_use.dir and # Direction typically unchanged by USE\n                np.array_equal(state_after_adj_use.grid, grid_before_adj_use) # Grid can change if resource harvested\n            )\n            if state_changed_by_adj_use:\n                potential_next_transitions.append(\n                    (state_after_adj_use, path + turns_to_face + [USE_ACT], inventory_before_adj_use)\n                )\n\n    # --- Process all generated potential next transitions ---\n    for next_s, next_p, inv_before_action in potential_next_transitions:\n        # Check if the target primitive was successfully collected in this specific transition.\n        # This is the success condition for the 'collect' function: one or more units of `i_kind`\n        # were added to the inventory in this step.\n        if next_s.inventory[i_kind] > inv_before_action[i_kind]:\n            return next_p # Goal achieved! Return the shortest path immediately (guaranteed by BFS).\n\n        # If the goal was not achieved in this step, add the new state to the queue if it hasn't been visited yet.\n        next_inventory_tuple = tuple(next_s.inventory)\n        next_grid_hash = hash(next_s.grid.tobytes()) # Re-hash grid for the new state, as it might have changed.\n        next_state_key = (next_grid_hash, next_s.pos[0], next_s.pos[1], next_s.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((next_s, next_p))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state within the defined search limits.\n  return []", "island_id": 6, "scores": {"3": 2.5}}
{"timestamp": "2025-08-01T14:12:14.438831", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Semantic check: Determine if this primitive is *actually* collectible into inventory.\n  # This includes items defined as primitives, special environment items like water/stone,\n  # and any other items explicitly marked as grabbable.\n  is_primitive_resource = i_kind in world.cookbook.primitives\n  is_special_collectible_environment = (i_kind == world.water_index or i_kind == world.stone_index)\n  is_grabbable = i_kind in world.grabbable_indices\n\n  if not (is_primitive_resource or is_special_collectible_environment or is_grabbable):\n      # The requested primitive is not collectible by means of a direct \"collect\" action.\n      # E.g., Workshops are locations, not items that can be collected into inventory.\n      return []\n\n  # 3. Check if the primitive is already in the agent's inventory.\n  if current_state.inventory[i_kind] > 0:\n      # Primitive is already collected, no actions needed.\n      return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # Delta coordinates for each direction (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT) relative to agent's position (row_delta, col_delta).\n  _DIRECTION_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row decreases, col stays same\n      1: (0, 1),  # RIGHT: row stays same, col increases\n      2: (1, 0),  # DOWN: row increases, col stays same\n      3: (0, -1)  # LEFT: row stays same, col decreases\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return []\n      # Calculate difference ensuring it's positive and within [0, 3] for turns.\n      diff = (target_dir - current_dir + 4) % 4\n      if diff == 1: # Clockwise turn (e.g., UP to RIGHT)\n          return [RIGHT_ACT]\n      elif diff == 3: # Counter-clockwise turn (e.g., UP to LEFT)\n          return [LEFT_ACT]\n      else: # diff == 2 (180-degree turn, e.g., UP to DOWN)\n          return [RIGHT_ACT, RIGHT_ACT] # Two right turns (or two left turns)\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The `visited` set tracks states already explored to prevent cycles and redundant work.\n  # A state is defined by (grid_hash, row, col, direction, inventory_tuple).\n  # `grid.tobytes()` is used for hashing the grid, ensuring distinct grid layouts are treated as distinct states.\n  # This is crucial because `USE_ACT` can modify the grid (e.g., removing a tree).\n  visited = set() \n\n  initial_inventory_tuple = tuple(current_state.inventory)\n  initial_grid_hash = hash(current_state.grid.tobytes()) \n\n  q.append((current_state, [])) # Queue stores (CraftState object, path_to_reach_this_state)\n  visited.add((initial_grid_hash, current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_rows, grid_cols, _ = current_state.grid.shape # Get grid dimensions as (rows, columns, kinds)\n\n  # Adaptive search limits:\n  # MAX_EXPLORED_STATES: Limits the total number of unique states processed to prevent\n  #                      runaway searches in very large or complex state spaces.\n  #                      Increased factor from 200 (in v1) to 250 to allow for more extensive\n  #                      exploration of grid/inventory permutations and environmental changes,\n  #                      aiming for robustness in more varied scenarios.\n  MAX_EXPLORED_STATES = grid_rows * grid_cols * 4 * 250 \n  \n  # MAX_PATH_LENGTH: Limits the length of any path considered. Set adaptively based on\n  #                  the grid dimensions, allowing for longer paths on larger maps,\n  #                  plus a buffer for turns and interactions. Increased from v1's\n  #                  (rows+cols)*7 to (rows+cols)*10 for greater robustness in complex\n  #                  environments, accommodating longer detours or sequences of interactions.\n  MAX_PATH_LENGTH = (grid_rows + grid_cols) * 10\n\n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft()\n    explored_states_count += 1\n\n    # Pruning: If exploration limits are reached, stop exploring from this path.\n    # This prevents the search from becoming excessively long or consuming too much memory/time.\n    if explored_states_count > MAX_EXPLORED_STATES or len(path) >= MAX_PATH_LENGTH:\n      continue\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n\n    # List to store (next_state_object, actions_to_reach_next_state, inventory_before_last_action_applied)\n    # Storing 'inventory_before_last_action_applied' is crucial for detecting if the goal item\n    # was *specifically* acquired in the last step of a transition.\n    potential_next_transitions = []\n\n    # --- Generate all potential next states from the current state ---\n\n    # 1. Explore Movement Actions (UP, DOWN, LEFT, RIGHT)\n    for action in move_actions:\n        # Simulate step. The 'reward' is always 0.0 for this environment implementation.\n        # The 'inventory_before_move' is the current state's inventory, for later comparison.\n        inventory_before_move = np.copy(state.inventory)\n        _, next_state = state.step(action)\n        potential_next_transitions.append((next_state, path + [action], inventory_before_move))\n\n    # 2. Explore USE_ACT at the agent's current position.\n    # This covers collecting items directly from the cell the agent is standing on (e.g., grabbable items).\n    inventory_before_use_at_pos = np.copy(state.inventory)\n    grid_before_use_at_pos = np.copy(state.grid)\n    _, state_after_use_at_pos = state.step(USE_ACT)\n    \n    # Check if USE_ACT at current position resulted in a meaningful state change.\n    # A change implies interaction (e.g., item collected, grid modified).\n    state_changed_by_use_at_pos = not (\n        np.array_equal(state_after_use_at_pos.inventory, inventory_before_use_at_pos) and\n        state_after_use_at_pos.pos == state.pos and # Position usually unchanged by USE\n        state_after_use_at_pos.dir == state.dir and # Direction usually unchanged by USE\n        np.array_equal(state_after_use_at_pos.grid, grid_before_use_at_pos) # Grid can change if item removed/resource harvested\n    )\n    if state_changed_by_use_at_pos:\n        potential_next_transitions.append((state_after_use_at_pos, path + [USE_ACT], inventory_before_use_at_pos))\n    \n    # 3. Explore USE_ACT on adjacent cells (after turning to face them).\n    # This handles interacting with entities in the surrounding environment (e.g., chopping trees, mining rocks).\n    for target_dir_idx in range(4): # Iterate through all four possible facing directions (0, 1, 2, 3)\n        row_delta, col_delta = _DIRECTION_TO_DELTA_FRONT[target_dir_idx]\n        facing_r, facing_c = current_r + row_delta, current_c + col_delta\n\n        # Check if the cell the agent would face is within grid bounds AND contains any entity.\n        # This broad check is necessary because we don't know which specific entity yields the primitive\n        # without inspecting CraftState's internal logic for USE_ACT.\n        if (0 <= facing_r < grid_rows and 0 <= facing_c < grid_cols) and np.any(state.grid[facing_r, facing_c, :] == 1):\n            turns_to_face = _get_turning_actions(current_dir, target_dir_idx)\n            \n            # Simulate the turning actions to get to the correct orientation.\n            # Create a temporary state to apply turns without altering the 'state' from the queue.\n            temp_state_before_use = state \n            for turn_action in turns_to_face:\n                _, temp_state_before_use = temp_state_before_use.step(turn_action)\n            \n            # Capture inventory and grid states immediately before the final USE_ACT.\n            inventory_before_adj_use = np.copy(temp_state_before_use.inventory)\n            grid_before_adj_use = np.copy(temp_state_before_use.grid)\n            \n            # Perform the USE_ACT.\n            _, state_after_adj_use = temp_state_before_use.step(USE_ACT)\n            \n            # Check if USE_ACT on adjacent cell resulted in a meaningful state change.\n            state_changed_by_adj_use = not (\n                np.array_equal(state_after_adj_use.inventory, inventory_before_adj_use) and\n                state_after_adj_use.pos == temp_state_before_use.pos and\n                state_after_adj_use.dir == temp_state_before_use.dir and\n                np.array_equal(state_after_adj_use.grid, grid_before_adj_use)\n            )\n            if state_changed_by_adj_use:\n                potential_next_transitions.append(\n                    (state_after_adj_use, path + turns_to_face + [USE_ACT], inventory_before_adj_use)\n                )\n\n    # --- Process all generated potential next transitions ---\n    for next_s, next_p, inv_before_action in potential_next_transitions:\n        # Check if the target primitive was successfully collected in this specific transition.\n        # This is the goal condition for the 'collect' function.\n        if next_s.inventory[i_kind] > inv_before_action[i_kind]:\n            return next_p # Goal achieved! Return the shortest path immediately (due to BFS property).\n\n        # If not the goal, add the new state to the queue if it hasn't been visited yet.\n        next_inventory_tuple = tuple(next_s.inventory)\n        next_grid_hash = hash(next_s.grid.tobytes())\n        next_state_key = (next_grid_hash, next_s.pos[0], next_s.pos[1], next_s.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((next_s, next_p))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state within the search limits.\n  return []", "island_id": 6, "scores": {"3": 2.5}}
{"timestamp": "2025-08-01T14:13:09.824588", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n\n  # Retrieve essential information from the current environment state\n  primitive_id = current_state.world.cookbook.index[primitive]\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's current (row, column) tuple\n  initial_dir = current_state.dir # Agent's current facing direction (0:Right, 1:Up, 2:Left, 3:Down)\n\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # Early exit: If the agent already possesses the primitive in its inventory, no actions are needed.\n  if current_state.inventory[primitive_id] > 0:\n      return []\n\n  # Map symbolic actions to their integer indices from the environment's action_specs.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define changes in (row, col) based on agent's current direction.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: +1 to column (x-axis)\n      1: (-1, 0),  # Facing UP: -1 to row (y-axis)\n      2: (0, -1),  # Facing LEFT: -1 to column (x-axis)\n      3: (1, 0)    # Facing DOWN: +1 to row (y-axis)\n  }\n\n  # Define how agent's direction changes when turning.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # Define which entity kinds block agent movement into a cell.\n  non_walkable_for_movement = set(current_state.world.non_grabbable_indices)\n  non_walkable_for_movement.add(primitive_id) # Agent cannot walk onto the primitive itself to collect it.\n\n  # Helper function to check if a cell is within bounds and walkable.\n  def _is_cell_walkable(r, c, grid, non_walkable_indices_set, grid_width, grid_height):\n      \"\"\"Checks if the cell at (r, c) is within grid bounds and does not contain non-walkable items.\"\"\"\n      if not (0 <= r < grid_width and 0 <= c < grid_height):\n          return False # Out of bounds\n      for kind_idx in non_walkable_indices_set:\n          if grid[r, c, kind_idx] > 0:\n              return False # Contains a non-walkable item\n      return True\n\n  # Helper to generate possible next states and the actions to reach them\n  def _get_next_states_and_actions(current_r, current_c, current_d):\n      \"\"\"Yields (next_state, action) tuples from the current state.\"\"\"\n      \n      # Option 1: Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_d]\n      next_r_fwd, next_c_fwd = current_r + move_dr, current_c + move_dc\n      if _is_cell_walkable(next_r_fwd, next_c_fwd, initial_grid, non_walkable_for_movement, WIDTH, HEIGHT):\n          yield ((next_r_fwd, next_c_fwd), current_d), MOVE_FORWARD_ACTION\n\n      # Option 2: Try Turn Left (position remains unchanged)\n      next_d_left = TURN_LEFT_MAP[current_d]\n      yield ((current_r, current_c), next_d_left), TURN_LEFT_ACTION\n\n      # Option 3: Try Turn Right (position remains unchanged)\n      next_d_right = TURN_RIGHT_MAP[current_d]\n      yield ((current_r, current_c), next_d_right), TURN_RIGHT_ACTION\n\n  # BFS setup\n  # Queue stores (state) tuples: ((row, col), direction)\n  queue = collections.deque([((initial_pos, initial_dir))])\n  # Visited set stores states to prevent cycles and redundant exploration.\n  visited = {(initial_pos, initial_dir)}\n  # Parent dictionary for path reconstruction: (current_state) -> (previous_state, action_to_reach_current_state)\n  parent = {} \n\n  target_state_found = None # Stores the goal state from which USE action should be performed.\n\n  # Start the BFS loop\n  while queue:\n      current_pos_dir = queue.popleft() # Dequeue the current state\n      current_pos, current_dir = current_pos_dir\n      r, c = current_pos\n\n      # Goal Check: Is the target primitive directly in front of the agent?\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the 'front' cell is within grid boundaries AND contains the primitive.\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT and\n          initial_grid[front_r, front_c, primitive_id] > 0):\n          \n          target_state_found = current_pos_dir # Store this state as the goal was met.\n          break # Exit BFS, as the shortest path to an actionable state is found.\n\n      # Explore possible next states from the current state\n      for next_state, action_to_take in _get_next_states_and_actions(r, c, current_dir):\n          if next_state not in visited:\n              visited.add(next_state)      # Mark as visited\n              queue.append(next_state)     # Enqueue the new state\n              parent[next_state] = (current_pos_dir, action_to_take) # Record parent and action\n\n  # Path Reconstruction:\n  # If a path was found, reconstruct it by backtracking from the target state to the initial state.\n  if target_state_found is not None:\n      path_actions = []\n      current_reconstruction_state = target_state_found\n      \n      # Backtrack until the initial state is reached\n      while current_reconstruction_state != (initial_pos, initial_dir):\n          # This safety check handles cases where a state might unexpectedly not have a parent,\n          # although for a correctly implemented BFS, all reachable states should have one.\n          if current_reconstruction_state not in parent:\n              path_actions = [] # Clear actions, indicating a path reconstruction issue.\n              break\n          \n          prev_state, action = parent[current_reconstruction_state]\n          path_actions.append(action) # Add the action that led to the current state\n          current_reconstruction_state = prev_state # Move to the previous state\n      \n      # The path is built in reverse, so reverse it to get the correct chronological sequence.\n      path_actions.reverse()\n      actions_list.extend(path_actions)\n      actions_list.append(USE_ACTION) # Append the final 'USE' action to collect the primitive.\n\n  # Return the sequence of actions. If no path was found, actions_list will be empty.\n  return actions_list", "island_id": 1, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T14:13:11.157078", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n\n  # Retrieve essential information from the current environment state\n  # Get the unique integer ID for the target primitive from the cookbook's index.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's current (row, column) tuple\n  initial_dir = current_state.dir # Agent's current facing direction (0:Right, 1:Up, 2:Left, 3:Down)\n\n  num_rows, num_cols, _ = initial_grid.shape # Extract grid dimensions\n\n  # Agent facing directions constants for improved readability\n  RIGHT = 0\n  UP = 1\n  LEFT = 2\n  DOWN = 3\n\n  # Early exit: If the agent already possesses the primitive in its inventory, no actions are needed.\n  if current_state.inventory[primitive_id] > 0:\n      return []\n\n  # Map symbolic actions to their integer indices from the environment's action_specs.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP'] # In CraftLab, 'UP' typically means move forward\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define changes in (row, col) based on agent's current direction.\n  DIR_TO_DRDC = {\n      RIGHT: (0, 1),   # Facing RIGHT: +1 to column (col)\n      UP: (-1, 0),     # Facing UP: -1 to row (row)\n      LEFT: (0, -1),   # Facing LEFT: -1 to column (col)\n      DOWN: (1, 0)     # Facing DOWN: +1 to row (row)\n  }\n\n  # Define how agent's direction changes when turning.\n  TURN_LEFT_MAP = {RIGHT: UP, UP: LEFT, LEFT: DOWN, DOWN: RIGHT}\n  TURN_RIGHT_MAP = {RIGHT: DOWN, UP: RIGHT, LEFT: UP, DOWN: LEFT}\n\n  # Define which entity kinds block agent movement into a cell.\n  # This includes all non-grabbable items (e.g., boundaries, water, workshops).\n  # The primitive itself is typically added to this set, as the agent needs to be\n  # *adjacent* to it to 'USE' it, not standing directly on it.\n  non_walkable_for_movement = set(current_state.world.non_grabbable_indices)\n  non_walkable_for_movement.add(primitive_id)\n\n  # BFS state: ((row, col), direction_int)\n  # `queue`: stores states to visit (just the state tuple).\n  # `visited`: stores states that have been enqueued, to prevent cycles and redundant work.\n  # `parent`: stores (current_state) -> (previous_state, action_taken_to_reach_current_state).\n  # This allows efficient path reconstruction by backtracking from the target state.\n  queue = collections.deque([((initial_pos, initial_dir))])\n  visited = {(initial_pos, initial_dir)}\n  parent = {} # Maps (state) -> ((parent_state), action_from_parent_to_state)\n\n  target_state_found = None # This will store the final state from which USE action should be performed.\n\n  # Helper function to check if a cell is within bounds and walkable.\n  def _is_cell_walkable(r: int, c: int, grid: np.ndarray, num_rows: int, num_cols: int, non_walkable_indices_set: set) -> bool:\n      \"\"\"Checks if the cell at (r, c) is within grid bounds and does not contain non-walkable items.\"\"\"\n      if not (0 <= r < num_rows and 0 <= c < num_cols):\n          return False # Out of bounds\n      for kind_idx in non_walkable_indices_set:\n          if grid[r, c, kind_idx] > 0:\n              return False # Contains a non-walkable item\n      return True\n\n  # Start the BFS loop to find the shortest path to a cell adjacent to the primitive.\n  while queue:\n      current_pos_dir = queue.popleft() # Current state: ((row, col), direction)\n      current_pos, current_dir = current_pos_dir\n      r, c = current_pos\n\n      # 1. Goal Check: Determine if the target primitive is directly in front of the agent.\n      # Calculate the coordinates of the cell that the agent is currently facing.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the 'front' cell is within the grid boundaries AND contains the primitive.\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols and\n          initial_grid[front_r, front_c, primitive_id] > 0):\n          \n          target_state_found = current_pos_dir # Store this state as the goal was met.\n          break # Exit BFS, as we've found the shortest path to an actionable state.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n      \n      # --- Try Move Forward action ---\n      # Calculate the agent's new position if it moves one step forward.\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir_move = current_dir # Moving forward does not change the agent's facing direction.\n\n      next_state_move = (next_pos, next_dir_move)\n      # Check if this specific (position, direction) state has been visited before.\n      if next_state_move not in visited:\n          # Check if the next position is walkable.\n          if _is_cell_walkable(next_r, next_c, initial_grid, num_rows, num_cols, non_walkable_for_movement):\n              visited.add(next_state_move) # Mark this state as visited.\n              queue.append(next_state_move) # Add the new state to the queue.\n              parent[next_state_move] = (current_pos_dir, MOVE_FORWARD_ACTION) # Store parent and action.\n\n      # --- Try Turn Left action ---\n      # Calculate the new direction after turning left. The agent's position remains unchanged.\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      next_state_left = (current_pos, next_dir_left) # Position unchanged.\n      # Check if this (current_position, new_direction) state has been visited.\n      if next_state_left not in visited:\n          visited.add(next_state_left) # Mark as visited.\n          queue.append(next_state_left) # Add the new state to the queue.\n          parent[next_state_left] = (current_pos_dir, TURN_LEFT_ACTION) # Store parent and action.\n\n      # --- Try Turn Right action ---\n      # Calculate the new direction after turning right. The agent's position remains unchanged.\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      next_state_right = (current_pos, next_dir_right) # Position unchanged.\n      # Check if this (current_position, new_direction) state has been visited.\n      if next_state_right not in visited:\n          visited.add(next_state_right) # Mark as visited.\n          queue.append(next_state_right) # Add the new state to the queue.\n          parent[next_state_right] = (current_pos_dir, TURN_RIGHT_ACTION) # Store parent and action.\n\n  # Path Reconstruction:\n  # If a path was found (i.e., target_state_found is not None), reconstruct the path.\n  if target_state_found is not None:\n      path_actions = []\n      current_reconstruction_state = target_state_found\n      # Backtrack from the target state to the initial state using the 'parent' dictionary.\n      while current_reconstruction_state != (initial_pos, initial_dir):\n          # This check guards against unexpected states not found in parent, though\n          # for a correctly implemented BFS, all reachable states should have a parent.\n          if current_reconstruction_state not in parent:\n              path_actions = [] # Clear actions, indicating a path reconstruction issue.\n              break\n          \n          prev_state, action = parent[current_reconstruction_state]\n          path_actions.append(action) # Add the action that led to the current state.\n          current_reconstruction_state = prev_state # Move to the previous state.\n      \n      # The path is built in reverse chronological order (from target back to start),\n      # so reverse it to get the correct sequence of actions from start to target.\n      path_actions.reverse()\n      actions_list.extend(path_actions)\n      actions_list.append(USE_ACTION) # Append the final 'USE' action to collect the primitive.\n\n  # Return the sequence of actions. If no path was found, actions_list will be empty.\n  return actions_list", "island_id": 1, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T14:13:55.030200", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  \n  # Get the current grid, agent's position, direction, and inventory from the environment's current state.\n  grid = current_state.grid \n  initial_pos = current_state.pos  # Agent's (row, col) tuple\n  initial_dir = current_state.dir  # Agent's facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n  inventory = current_state.inventory # Agent's current inventory counts of each item.\n\n  # --- 1. Initial Validation and Early Exit Conditions ---\n  # Attempt to get the integer ID for the target primitive from the cookbook's index.\n  try:\n      primitive_id = current_state.world.cookbook.index[primitive]\n  except KeyError:\n      # If the primitive name is not found in the cookbook, it's an invalid target.\n      return []\n  \n  # Check if the primitive is actually designated as 'grabbable' by the world rules.\n  # For example, 'WATER' or 'WORKSHOP' locations are typically not grabbable.\n  if primitive_id not in current_state.world.grabbable_indices:\n      return []\n\n  # If the agent already possesses the primitive in its inventory, no action is needed.\n  if inventory[primitive_id] > 0:\n      return []\n  \n  # Get grid dimensions (rows and columns) for boundary checks.\n  GRID_ROWS, GRID_COLS, _ = grid.shape\n\n  # Map symbolic action names (used in the DSL and action_specs) to their integer indices.\n  action_map = env.action_specs()\n  # In this DMLab-style environment, 'UP' typically corresponds to moving forward in the current direction.\n  MOVE_FORWARD_ACTION = action_map['UP']  \n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE'] # Action to interact with the object in front.\n\n  # Define changes in (row, col) for moving one step forward, based on the current facing direction.\n  # Directions: 0 (RIGHT), 1 (UP), 2 (LEFT), 3 (DOWN).\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (delta_row=0, delta_col=+1)\n      1: (-1, 0),  # Facing UP: (delta_row=-1, delta_col=0)\n      2: (0, -1),  # Facing LEFT: (delta_row=0, delta_col=-1)\n      3: (1, 0)    # Facing DOWN: (delta_row=+1, delta_col=0)\n  }\n\n  # Define how the agent's direction changes when turning left or right (90 degrees).\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}   # Cycles: R -> U -> L -> D -> R (Counter-clockwise)\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}  # Cycles: R -> D -> L -> U -> R (Clockwise)\n\n  # Compile a set of entity kind IDs that the agent cannot walk onto.\n  # This includes entities designated as 'non-grabbable' (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  # which are fixed obstacles. Crucially, the agent also cannot walk *onto* the primitive\n  # it intends to collect; it must be adjacent to it to use it.\n  non_walkable_kind_ids = current_state.world.non_grabbable_indices.copy()\n  non_walkable_kind_ids.add(primitive_id) \n\n  # --- Helper function: Checks if a cell is within grid bounds and traversable. ---\n  def is_cell_valid_and_walkable(r_coord: int, c_coord: int) -> bool:\n    \"\"\"\n    Checks if the given (row, col) coordinates are within the grid and do not contain\n    any non-walkable entity (obstacles or the primitive itself).\n    \"\"\"\n    # 1. Check if the cell coordinates are within the defined grid boundaries.\n    if not (0 <= r_coord < GRID_ROWS and 0 <= c_coord < GRID_COLS):\n      return False\n\n    # 2. Check if the cell contains any entity that blocks agent movement.\n    # We use the initial grid state for this, assuming environment layout is static during collection.\n    for kind_idx in non_walkable_kind_ids:\n      if grid[r_coord, c_coord, kind_idx] > 0: # If the kind_idx exists in this cell.\n        return False\n    \n    # If all checks pass, the cell is safe for the agent to move into.\n    return True\n\n  # --- BFS Initialization ---\n  # The queue will store tuples: ( (current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_here ).\n  # This allows us to reconstruct the path once the goal is found.\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # The `visited` set stores `(position_tuple, direction_int)` pairs.\n  # This prevents revisiting the same state (position and facing direction),\n  # which is crucial for finding the shortest path in an unweighted graph and preventing infinite loops.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # This will store the shortest sequence of actions to reach the \"goal state\".\n\n  # --- BFS Execution Loop ---\n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      r, c = current_pos # Unpack current row and column coordinates.\n\n      # --- 2. Goal Check: Is the agent currently in a state where it can collect the primitive? ---\n      # This condition is met if the primitive is located in the grid cell *immediately in front* of the agent.\n      \n      # Calculate the coordinates of the cell directly in front of the agent.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the 'front' cell is within grid boundaries AND if it contains the target primitive.\n      if (0 <= front_r < GRID_ROWS and 0 <= front_c < GRID_COLS) and\\\n         (grid[front_r, front_c, primitive_id] > 0):\n          # If true, we have found the shortest path (sequence of movements and turns)\n          # that brings the agent adjacent to and facing the primitive.\n          target_path_actions = path_so_far\n          break # Exit the BFS loop as the shortest path to the pre-collection state is found.\n\n      # --- 3. Explore Possible Next States: Generate successor states by applying valid actions. ---\n      \n      # (a) Attempt to Move Forward:\n      # Calculate the new position if the agent moves forward. The direction remains unchanged.\n      next_r_move, next_c_move = r + DIR_TO_DRDC[current_dir][0], c + DIR_TO_DRDC[current_dir][1]\n      next_pos_move = (next_r_move, next_c_move)\n      next_dir_move = current_dir # Forward movement does not change facing direction.\n\n      # Check if the new position is valid and walkable, and if this specific (position, direction) state\n      # has not been visited before.\n      if is_cell_valid_and_walkable(next_r_move, next_c_move):\n          if (next_pos_move, next_dir_move) not in visited:\n              visited.add((next_pos_move, next_dir_move)) # Mark new state as visited.\n              # Add the new state to the queue with the updated path.\n              queue.append(((next_pos_move, next_dir_move), path_so_far + [MOVE_FORWARD_ACTION]))\n\n      # (b) Attempt to Turn Left:\n      # Calculate the new direction after turning left. The position remains unchanged.\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Check if this new state (same position, new direction) has not been visited.\n      if (current_pos, next_dir_left) not in visited:\n          visited.add((current_pos, next_dir_left)) # Mark new state as visited.\n          # Add the new state to the queue with the updated path.\n          queue.append(((current_pos, next_dir_left), path_so_far + [TURN_LEFT_ACTION]))\n\n      # (c) Attempt to Turn Right:\n      # Calculate the new direction after turning right. The position remains unchanged.\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Check if this new state (same position, new direction) has not been visited.\n      if (current_pos, next_dir_right) not in visited:\n          visited.add((current_pos, next_dir_right)) # Mark new state as visited.\n          # Add the new state to the queue with the updated path.\n          queue.append(((current_pos, next_dir_right), path_so_far + [TURN_RIGHT_ACTION]))\n\n  # --- 4. Finalizing the Action List ---\n  # If a path to the target (adjacent and facing the primitive) was successfully found during BFS.\n  if target_path_actions is not None:\n      # Extend the found path with the 'USE' action. This final action performs the collection.\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n  # If `target_path_actions` remains None, it means the primitive was unreachable from the current state.\n  # In this case, the `actions_list` (which was initialized as empty) will be returned.\n\n  return actions_list", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T14:13:56.342604", "function_name": "collect", "function_body": "  actions_list = [] # This list will store the sequence of actions to be returned.\n\n  # Retrieve essential information from the current environment state.\n  current_state = env._current_state\n  grid = current_state.grid # The current grid layout (numpy.ndarray of shape (WIDTH, HEIGHT, n_kinds))\n  initial_pos = current_state.pos # Agent's current position (tuple: (row, col))\n  initial_dir = current_state.dir # Agent's current facing direction (int: 0=RIGHT, 1=UP, 2=LEFT, 3=DOWN)\n  inventory = current_state.inventory # Agent's current inventory counts (numpy.ndarray)\n\n  # --- 1. Initial Validation and Early Exit Conditions ---\n  # Convert the primitive's string name to its unique integer ID.\n  try:\n      primitive_id = current_state.world.cookbook.index[primitive]\n  except KeyError:\n      # If the primitive name is not recognized by the cookbook, it's an invalid target.\n      # print(f\"Warning: Primitive '{primitive}' not found in cookbook index. Cannot collect.\")\n      return []\n  \n  # Check if the primitive is designated as 'grabbable' in the world configuration.\n  # Some items (e.g., BOUNDARY, WATER, WORKSHOP locations) are part of the environment\n  # but cannot be picked up or added to inventory.\n  if primitive_id not in current_state.world.grabbable_indices:\n      # print(f\"Info: Primitive '{primitive}' (ID: {primitive_id}) is not a grabbable item. Cannot collect.\")\n      return []\n\n  # If the agent already possesses at least one unit of the primitive, consider it collected.\n  # This prevents unnecessary actions if the goal is already met.\n  if inventory[primitive_id] > 0:\n      # print(f\"Info: Agent already has '{primitive}'. No actions needed.\")\n      return []\n  \n  # Get the dimensions of the grid for boundary checks.\n  GRID_ROWS, GRID_COLS, _ = grid.shape\n\n  # Map human-readable action names (from DSL) to their integer IDs used by the environment's `step` method.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']   # Assuming 'UP' corresponds to moving forward in the current direction.\n  TURN_LEFT_ACTION = action_map['LEFT']     # Turn 90 degrees counter-clockwise.\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Turn 90 degrees clockwise.\n  USE_ACTION = action_map['USE']         # Action to interact with the object in the cell directly in front.\n\n  # Define the change in (row, col) coordinates for each direction when moving forward.\n  # Direction IDs: 0 (Right), 1 (Up), 2 (Left), 3 (Down).\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: +1 to column (col)\n      1: (-1, 0),  # Facing UP: -1 to row (row)\n      2: (0, -1),  # Facing LEFT: -1 to column (col)\n      3: (1, 0)    # Facing DOWN: +1 to row (row)\n  }\n\n  # Define how the agent's direction ID changes after turning left or right.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}   # e.g., Right (0) -> Up (1)\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}  # e.g., Right (0) -> Down (3)\n\n  # Identify all entity kinds that block agent movement.\n  # This includes non-grabbable environment features (e.g., walls, water, workshops).\n  # Crucially, the agent *cannot* move onto the primitive itself; it must be adjacent to it.\n  # Hence, the primitive_id is also added to the non-walkable set.\n  non_walkable_kind_ids = current_state.world.non_grabbable_indices.copy()\n  non_walkable_kind_ids.add(primitive_id) \n\n  # --- Helper function for checking cell traversability ---\n  def is_cell_valid_and_walkable(r_coord: int, c_coord: int) -> bool:\n    \"\"\"\n    Checks if a given grid cell is within the environment's boundaries and\n    does not contain any obstacle that prevents the agent from moving onto it.\n    \"\"\"\n    # 1. Check if the cell coordinates are within the grid bounds.\n    if not (0 <= r_coord < GRID_ROWS and 0 <= c_coord < GRID_COLS):\n      return False\n\n    # 2. Check if the cell contains any \"non-walkable\" entity.\n    # The agent cannot move onto cells occupied by these items (e.g., walls, water, workshops).\n    for kind_idx in non_walkable_kind_ids:\n      if grid[r_coord, c_coord, kind_idx] > 0:\n        return False\n    \n    # If all checks pass, the cell is traversable.\n    return True\n\n  # --- 2. Breadth-First Search (BFS) Initialization ---\n  # The BFS queue stores tuples: ( (current_position_tuple, current_direction_int), list_of_actions_taken_so_far ).\n  # The starting state is the agent's initial position and direction with an empty path.\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # The 'visited' set keeps track of (position, direction) states that have already been explored.\n  # This prevents infinite loops in cyclic environments and ensures the shortest path is found.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # Variable to store the actions leading to the goal state.\n\n  # --- 3. BFS Execution ---\n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      r, c = current_pos # Unpack current row and column.\n\n      # --- Goal Check for Collection ---\n      # The goal is to reach a state where the primitive is in the cell *directly in front* of the agent.\n      # Calculate the coordinates of the cell in front.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the 'front' cell is within grid boundaries AND if it contains the target primitive.\n      if (0 <= front_r < GRID_ROWS and 0 <= front_c < GRID_COLS) and\\\n         (grid[front_r, front_c, primitive_id] > 0):\n          target_path_actions = path_so_far # We found the shortest path to be adjacent and facing the primitive.\n          break # Exit the BFS loop as the optimal path is found.\n\n      # --- Explore Possible Next States (Move Forward, Turn Left, Turn Right) ---\n      \n      # A. Try to Move Forward:\n      next_r_move, next_c_move = r + DIR_TO_DRDC[current_dir][0], c + DIR_TO_DRDC[current_dir][1]\n      next_pos_move = (next_r_move, next_c_move)\n      next_dir_move = current_dir # Moving forward does not change the agent's facing direction.\n\n      # Check if the prospective new position is valid and walkable, and if this specific\n      # (position, direction) state has not been visited before.\n      if is_cell_valid_and_walkable(next_r_move, next_c_move):\n          if (next_pos_move, next_dir_move) not in visited:\n              visited.add((next_pos_move, next_dir_move)) # Mark the new state as visited.\n              # Add the new state to the queue with the updated path (including MOVE_FORWARD).\n              queue.append(((next_pos_move, next_dir_move), path_so_far + [MOVE_FORWARD_ACTION]))\n\n      # B. Try to Turn Left:\n      next_dir_left = TURN_LEFT_MAP[current_dir] # Calculate new direction after turning left.\n      # Position remains unchanged when turning.\n      if (current_pos, next_dir_left) not in visited:\n          visited.add((current_pos, next_dir_left)) # Mark the new state as visited.\n          # Add the new state to the queue with the updated path (including TURN_LEFT).\n          queue.append(((current_pos, next_dir_left), path_so_far + [TURN_LEFT_ACTION]))\n\n      # C. Try to Turn Right:\n      next_dir_right = TURN_RIGHT_MAP[current_dir] # Calculate new direction after turning right.\n      # Position remains unchanged when turning.\n      if (current_pos, next_dir_right) not in visited:\n          visited.add((current_pos, next_dir_right)) # Mark the new state as visited.\n          # Add the new state to the queue with the updated path (including TURN_RIGHT).\n          queue.append(((current_pos, next_dir_right), path_so_far + [TURN_RIGHT_ACTION]))\n\n  # --- 4. Finalizing the Action List ---\n  # If a path to the goal (adjacent to and facing the primitive) was successfully found.\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions) # Add the movement/turn actions.\n      actions_list.append(USE_ACTION) # Append the 'USE' action to collect the primitive.\n  # If target_path_actions is None, it means the primitive was unreachable from the current state.\n  # In this case, the `actions_list` remains empty, which is the correct behavior.\n\n  return actions_list", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T14:14:37.237977", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's current (row, column) tuple\n  initial_dir = current_state.dir # Agent's current facing direction (0:Right, 1:Up, 2:Left, 3:Down)\n\n  # Get the integer ID for the target primitive from the cookbook index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # Early exit if primitive is already in inventory\n  if current_state.inventory[primitive_id] > 0:\n      return []\n\n  # Map symbolic actions from action_specs to their integer indices\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP'] # Assuming 'UP' means move forward\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define changes in (row, col) for each direction (0:Right, 1:Up, 2:Left, 3:Down)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: +1 to column (x)\n      1: (-1, 0),  # Facing UP: -1 to row (y)\n      2: (0, -1),  # Facing LEFT: -1 to column (x)\n      3: (1, 0)    # Facing DOWN: +1 to row (y)\n  }\n\n  # Define how direction changes when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0} # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Get indices of entities that block agent movement (non-walkable terrain/objects)\n  # The primitive itself should also be considered non-walkable for movement,\n  # as the agent stands adjacent to collect it, not on top of it.\n  non_walkable_for_movement_set = set(current_state.world.non_grabbable_indices)\n  non_walkable_for_movement_set.add(primitive_id) # Agent cannot walk ONTO the primitive\n  \n  # Convert to numpy array for efficient `np.any` check in the inner loop\n  non_walkable_for_movement_array = np.array(list(non_walkable_for_movement_set), dtype=int)\n\n  # Helper function to check if a cell is walkable\n  def _is_cell_walkable(r, c, grid, non_walkable_indices_array, grid_width, grid_height):\n      \"\"\"Checks if the cell at (r, c) is within bounds and doesn't contain non-walkable items.\"\"\"\n      if not (0 <= r < grid_width and 0 <= c < grid_height):\n          return False # Out of bounds\n      \n      # Check if any of the non-walkable kinds have a count > 0 in this cell\n      # This leverages NumPy's efficiency.\n      if non_walkable_indices_array.size > 0 and np.any(grid[r, c, non_walkable_indices_array] > 0):\n          return False # Contains a non-walkable item that blocks movement\n      return True\n\n  # BFS state: ((current_row, current_col), current_direction_int)\n  # Queue stores (state, list_of_actions_to_reach_this_state)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (state) to avoid redundant computations and cycles\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the action sequence leading to the state\n                      # where the agent is adjacent to the primitive and facing it.\n\n  while queue:\n      (current_pos, current_dir), path_to_current_state = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent at current state\n      # Calculate the coordinates of the cell directly in front of the agent\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the cell in front is within grid bounds AND contains the primitive\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT and\n          initial_grid[front_r, front_c, primitive_id] > 0):\n          \n          target_path = path_to_current_state\n          break # Found the path to be adjacent and facing the primitive\n\n      # 2. Explore possible next actions from the current state (Move Forward, Turn Left, Turn Right)\n      \n      # Try Move Forward (equivalent to 'UP' in action_specs for movement)\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if the next position is valid and has not been visited with this direction\n      if (next_pos, next_dir) not in visited:\n          # Use the helper to check walkability, passing the numpy array of non-walkable kinds\n          if _is_cell_walkable(next_r, next_c, initial_grid, non_walkable_for_movement_array, WIDTH, HEIGHT):\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_to_current_state + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_to_current_state + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_to_current_state + [TURN_RIGHT_ACTION]))\n\n  # If a path was found to reach an adjacent and facing position, append the USE action\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 1, "scores": {"3": 0.5}}
