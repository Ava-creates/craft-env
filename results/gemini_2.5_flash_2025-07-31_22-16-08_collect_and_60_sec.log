{"timestamp": "2025-08-01T00:46:40.922935", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state # Get the current state of the environment\n\n  # Extract key information from the current state\n  initial_grid = current_state.grid # The initial grid layout (WIDTH, HEIGHT, n_kinds)\n  initial_pos = current_state.pos # Agent's starting position (row, col) tuple\n  initial_dir = current_state.dir # Agent's starting direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the world's cookbook index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Get grid dimensions for boundary checks\n  GRID_WIDTH, GRID_HEIGHT, _ = initial_grid.shape\n\n  # Retrieve action mapping from the environment's action specifications for clear action names\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # Action to move the agent forward in its current facing direction\n  TURN_LEFT_ACTION = action_map['LEFT']     # Action to turn the agent 90 degrees counter-clockwise\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Action to turn the agent 90 degrees clockwise\n  USE_ACTION = action_map['USE']            # Action to interact with the cell in front or nearby\n\n  # Define how agent's (row, col) coordinates change based on current direction when moving forward\n  # This mapping helps calculate the next position when taking a MOVE_FORWARD_ACTION.\n  # Format: current_direction_int -> (delta_row, delta_col)\n  DIRECTION_TO_DELTA = {\n      0: (0, 1),   # Facing RIGHT (0): Move increases column (c)\n      1: (-1, 0),  # Facing UP (1): Move decreases row (r)\n      2: (0, -1),  # Facing LEFT (2): Move decreases column (c)\n      3: (1, 0)    # Facing DOWN (3): Move increases row (r)\n  }\n\n  # Define how agent's direction changes when performing a turn action.\n  # Format: current_direction_int -> new_direction_int\n  TURN_LEFT_DIRECTION_MAP = {0: 1, 1: 2, 2: 3, 3: 0} # Example: R(0) -> U(1)\n  TURN_RIGHT_DIRECTION_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Example: R(0) -> D(3)\n\n  # --- Define entities that act as obstacles for agent movement ---\n  # The agent cannot move into cells containing these entities.\n  # 1. Start with all non-grabbable entities (e.g., BOUNDARY, WATER, WORKSHOP0, WORKSHOP1, WORKSHOP2).\n  #    These are generally impassable terrain or fixed structures.\n  movement_obstacles_ids = set(current_state.world.non_grabbable_indices)\n  \n  # 2. If the target 'primitive' itself is a grabbable item (e.g., WOOD, STONE, GOLD),\n  #    the agent must typically stop *adjacent* to its location and then use the 'USE' action.\n  #    It should not walk *onto* the cell occupied by the primitive it intends to collect.\n  #    Therefore, if the primitive is grabbable, its ID is also considered an obstacle for movement *onto that specific tile*.\n  if primitive_id in current_state.world.grabbable_indices:\n      movement_obstacles_ids.add(primitive_id)\n  # Note: The 'collect' function in the DSL is designed for primitive resources (WOOD, STONE, etc.),\n  # which are typically grabbable. This obstacle definition is robust for such cases.\n\n  # --- Optimization: Initial check if the primitive is already collectible from the agent's current position ---\n  # The `CraftState.next_to()` method efficiently checks if the primitive is within the 3x3 neighborhood.\n  if current_state.next_to(primitive_id):\n      return [USE_ACTION] # If so, no pathfinding needed; just perform the USE action directly.\n\n  # --- Breadth-First Search (BFS) for pathfinding to the nearest collectable position ---\n  # The state in our BFS needs to capture both the agent's (row, col) position and its direction,\n  # as movement depends on the current facing direction.\n  # The BFS queue stores tuples: ((current_pos_tuple, current_dir_int), list_of_actions_taken_to_reach_this_state)\n  bfs_queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # The visited set stores (position_tuple, direction_int) pairs to prevent redundant exploration\n  # and avoid infinite loops in cyclic paths.\n  visited_states = {(initial_pos, initial_dir)}\n\n  shortest_path_to_collect_pos = None # This will store the action sequence if a path is found.\n\n  # Main BFS loop: Continues as long as there are states to explore\n  while bfs_queue:\n      # Unpack the current state and the path taken to reach it\n      (current_pos, current_dir), path_actions_so_far = bfs_queue.popleft()\n      current_r, current_c = current_pos\n\n      # --- Check if the current agent position is a 'goal' state for collection ---\n      # A goal state for collection means the target primitive is located in any cell\n      # within the 3x3 neighborhood centered at the agent's current position (current_r, current_c).\n      is_collectable_from_current_pos = False\n      for dr_check in [-1, 0, 1]: # Iterate over relative row offsets for neighborhood check\n          for dc_check in [-1, 0, 1]: # Iterate over relative column offsets for neighborhood check\n              check_r, check_c = current_r + dr_check, current_c + dc_check\n              \n              # Ensure the cell being checked is within grid boundaries\n              if (0 <= check_r < GRID_WIDTH and 0 <= check_c < GRID_HEIGHT and\n                  initial_grid[check_r, check_c, primitive_id] > 0): # Check if the primitive is present at this cell\n                  is_collectable_from_current_pos = True\n                  break # Primitive found in neighborhood, no need to check other cells for this agent position\n          if is_collectable_from_current_pos:\n              break # Break outer loop too, as a collectable position is found\n\n      if is_collectable_from_current_pos:\n          shortest_path_to_collect_pos = path_actions_so_far # Store the path\n          break # Shortest path to a collectable position has been found, terminate BFS\n\n      # --- Explore possible next actions from the current state: Move, Turn Left, Turn Right ---\n\n      # 1. Try MOVE_FORWARD_ACTION:\n      # Calculate the next position if the agent moves forward based on its current direction.\n      delta_r_move, delta_c_move = DIRECTION_TO_DELTA[current_dir]\n      next_r_move, next_c_move = current_r + delta_r_move, current_c + delta_c_move\n      next_pos_move = (next_r_move, next_c_move)\n      next_dir_move = current_dir # Moving forward does not change the agent's facing direction.\n\n      # Check if the calculated next state (position, direction) is valid and has not been visited.\n      if (0 <= next_r_move < GRID_WIDTH and 0 <= next_c_move < GRID_HEIGHT and\n          (next_pos_move, next_dir_move) not in visited_states):\n          \n          # Check if the cell we are moving *to* contains any obstacles.\n          is_next_cell_walkable = True\n          for obstacle_id in movement_obstacles_ids:\n              if initial_grid[next_r_move, next_c_move, obstacle_id] > 0:\n                  is_next_cell_walkable = False # The cell contains an obstacle, so it's not walkable.\n                  break # No need to check other obstacles for this cell.\n\n          if is_next_cell_walkable:\n              visited_states.add((next_pos_move, next_dir_move)) # Mark new state as visited.\n              bfs_queue.append(( (next_pos_move, next_dir_move), path_actions_so_far + [MOVE_FORWARD_ACTION] )) # Add to queue for exploration.\n\n      # 2. Try TURN_LEFT_ACTION:\n      # Calculate the new direction after turning left. Position remains unchanged.\n      next_dir_left = TURN_LEFT_DIRECTION_MAP[current_dir]\n      \n      # Check if this new state (same position, new direction) has not been visited.\n      if ((current_pos, next_dir_left) not in visited_states):\n          visited_states.add((current_pos, next_dir_left)) # Mark new state as visited.\n          bfs_queue.append(( (current_pos, next_dir_left), path_actions_so_far + [TURN_LEFT_ACTION] )) # Add to queue.\n\n      # 3. Try TURN_RIGHT_ACTION:\n      # Calculate the new direction after turning right. Position remains unchanged.\n      next_dir_right = TURN_RIGHT_DIRECTION_MAP[current_dir]\n      \n      # Check if this new state (same position, new direction) has not been visited.\n      if ((current_pos, next_dir_right) not in visited_states):\n          visited_states.add((current_pos, next_dir_right)) # Mark new state as visited.\n          bfs_queue.append(( (current_pos, next_dir_right), path_actions_so_far + [TURN_RIGHT_ACTION] )) # Add to queue.\n\n  # --- After BFS completes ---\n  # If a path was successfully found to a position from which the primitive can be collected:\n  if shortest_path_to_collect_pos is not None:\n      actions_list.extend(shortest_path_to_collect_pos) # Add the path actions\n      actions_list.append(USE_ACTION) # Append the final USE action to perform the collection.\n  \n  # If no path was found (e.g., primitive is unreachable or not present), actions_list will be empty.\n  return actions_list", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T00:46:42.086472", "function_name": "collect", "function_body": "  \"\"\"Returns a list of actions to find and collect the primitive in the passed env.\n\n    This function uses a Breadth-First Search (BFS) algorithm to find the shortest\n    sequence of actions (movements and turns) required to bring the agent to a\n    position adjacent to the target primitive, and then executes a 'USE' action.\n    It accounts for the agent's position and orientation, and obstacles in the\n    environment.\n\n    Args:\n        env (env.CraftLab): The CraftLab object representing the current simulation state.\n        primitive (str): The name of the primitive item to be collected (e.g., \"WOOD\", \"STONE\").\n\n    Returns:\n        List[int]: A sequence of integer action codes (from env.action_specs())\n                   to execute. Returns an empty list if the primitive is unreachable.\n  \"\"\"\n  actions_list = []\n  # Get the current state of the environment. This state includes the grid,\n  # agent's position, direction, and inventory.\n  current_state = env._current_state\n\n  # Store initial grid, position, and direction for pathfinding.\n  # The grid is considered static during pathfinding; only agent's (pos, dir) changes.\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's starting row, column tuple (r, c)\n  initial_dir = current_state.dir # Agent's starting direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the world's cookbook index.\n  # This ID is used to locate the primitive on the grid.\n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  # Get grid dimensions to check boundaries during pathfinding.\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # Retrieve the mapping from action names (strings) to their integer codes.\n  # This ensures compatibility with the environment's `step` method.\n  action_map = env.action_specs()\n  # DSL 'UP' action is typically interpreted as 'move forward' in the current direction.\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE'] # Action to perform collection/interaction\n\n  # Define direction vectors for moving forward based on current orientation.\n  # Maps direction index to (delta_row, delta_column) for a forward step.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT (0): move +1 column\n      1: (-1, 0),  # Facing UP (1): move -1 row\n      2: (0, -1),  # Facing LEFT (2): move -1 column\n      3: (1, 0)    # Facing DOWN (3): move +1 row\n  }\n\n  # Define how agent's direction changes when turning left or right.\n  # These mappings cycle through the four cardinal directions (0, 1, 2, 3).\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # Identify all entity kinds that act as obstacles to agent movement.\n  # 1. Non-grabbable entities (e.g., BOUNDARY, WATER, WORKSHOP0) are always obstacles.\n  obstacles_to_movement_indices = set(current_state.world.non_grabbable_indices)\n  # 2. If the target primitive itself is a grabbable item (e.g., WOOD, STONE, GOLD),\n  #    the agent should not walk directly onto its tile. It must interact from an\n  #    adjacent cell. Thus, the primitive's own ID is also added as an obstacle.\n  if primitive_id in current_state.world.grabbable_indices:\n      obstacles_to_movement_indices.add(primitive_id)\n  \n  # Early Exit Optimization: If the primitive is already in the agent's 3x3\n  # neighborhood (i.e., immediately collectible), just return the USE action.\n  # The `CraftState.next_to` method provides this check efficiently.\n  if current_state.next_to(primitive_id):\n      return [USE_ACTION]\n\n  # Initialize Breadth-First Search (BFS) for pathfinding.\n  # The BFS queue stores tuples:\n  #   ((current_position_tuple (r, c), current_direction_int), list_of_actions_taken_to_reach_here)\n  # This structure allows tracking both spatial location and agent orientation.\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # The 'visited' set keeps track of (position, direction) pairs already explored\n  # to prevent cycles and redundant computations, ensuring the shortest path is found.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # This will store the shortest action sequence to a collectible state.\n\n  # Main BFS loop: continues until the queue is empty or a path is found.\n  while queue:\n      # Dequeue the current state and the path leading to it.\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # Check if the current agent position (r, c) is a \"goal state\" for collection.\n      # A goal state means the primitive is located in any cell within the 3x3 neighborhood\n      # around the agent's current position on the initial grid.\n      found_collectable_position = False\n      for dr_check in [-1, 0, 1]: # Iterate relative row offsets\n          for dc_check in [-1, 0, 1]: # Iterate relative column offsets\n              check_r, check_c = r + dr_check, c + dc_check\n              # Ensure the cell being checked is within grid boundaries.\n              if (0 <= check_r < WIDTH and 0 <= check_c < HEIGHT and\n                  initial_grid[check_r, check_c, primitive_id] > 0):\n                  found_collectable_position = True\n                  break # Primitive found in neighborhood, no need to check further cells for this position.\n          if found_collectable_position:\n              break # Break outer loop too if found.\n\n      if found_collectable_position:\n          target_path_actions = path_actions # A shortest path to a collectible state is found.\n          break # Terminate BFS; no need to explore further.\n\n      # Explore possible next states by applying valid actions: Move Forward, Turn Left, Turn Right.\n\n      # 1. Try MOVE_FORWARD_ACTION:\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change the agent's facing direction.\n\n      # Check if the potential next position is valid (within bounds and not visited).\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT and\n          (next_pos, next_dir) not in visited):\n          \n          is_walkable = True\n          # Verify that the cell at `next_pos` does not contain any obstacle.\n          for kind_idx in obstacles_to_movement_indices:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable = False\n                  break # This cell contains an obstacle, so it's not walkable.\n\n          if is_walkable:\n              visited.add((next_pos, next_dir)) # Mark the new state as visited.\n              # Add the new state to the queue with the updated path.\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # 2. Try TURN_LEFT_ACTION:\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # 3. Try TURN_RIGHT_ACTION:\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # After BFS completes:\n  # If a path to a collectable position was found (`target_path_actions` is not None),\n  # append the final 'USE' action to perform the collection.\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T00:47:45.642842", "function_name": "collect", "function_body": "  \"\"\"Further improved version of `collect_v1`.\n\n    This function finds the shortest path to a primitive and generates the\n    sequence of actions to collect it. It correctly distinguishes between:\n    - Grabbable resources (e.g., WOOD, IRON): Agent must step ON the resource cell, then USE.\n    - Non-grabbable resources (e.g., STONE, WATER): Agent must step ADJACENT to the resource, then USE.\n    - Workshops (e.g., WORKSHOP0): Agent must step ON the workshop cell; no USE action is needed for \"collection\"\n      as they are crafting locations.\n    The pathfinding uses BFS, ensuring the shortest sequence of movement actions.\n\n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect (e.g., \"WOOD\", \"STONE\", \"WORKSHOP0\").\n\n    Returns:\n        List[int]: A sequence of action indices to execute (e.g., [UP, UP, USE]).\n                   Returns an empty list if the primitive is unreachable.\n  \"\"\"\n  actions = []\n\n  # 1. Get Action Mappings and Primitive Index\n  action_map = env.action_specs()\n  UP, DOWN, LEFT, RIGHT, USE = action_map['UP'], action_map['DOWN'], action_map['LEFT'], action_map['RIGHT'], action_map['USE']\n\n  primitive_idx = env.world.cookbook.index[primitive]\n\n  # Get current state information\n  current_state = env._current_state\n  start_pos = current_state.pos\n  global_grid = current_state.grid\n  W, H, _ = global_grid.shape\n\n  # Determine the type of primitive based on CraftWorld's internal indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  is_grabbable_resource = primitive_idx in env.world.grabbable_indices\n  # A non-grabbable resource (e.g., STONE, WATER) is anything in non_grabbable_indices\n  # that is not explicitly identified as a workshop.\n  is_non_grabbable_resource = (primitive_idx in env.world.non_grabbable_indices and not is_workshop)\n\n  # Define movement deltas for BFS\n  move_deltas = {\n      UP: (-1, 0),\n      DOWN: (1, 0),\n      LEFT: (0, -1),\n      RIGHT: (0, 1)\n  }\n\n  def is_within_bounds(r, c):\n      \"\"\"Checks if coordinates (r, c) are within the grid boundaries.\"\"\"\n      return 0 <= r < W and 0 <= c < H\n\n  def is_traversable(r, c):\n      \"\"\"Checks if (r, c) is a cell the agent can step onto.\n      \n      A cell is traversable if it's within bounds and does not contain any\n      non-grabbable item that is NOT a workshop. Workshops are considered\n      traversable, allowing the agent to stand on them.\n      \"\"\"\n      if not is_within_bounds(r, c):\n          return False\n      \n      # Iterate through all possible kinds at this cell (r,c)\n      for k_idx in range(global_grid.shape[2]):\n          if global_grid[r, c, k_idx] == 1: # If an item of kind k_idx is present\n              # If it's a non-grabbable item AND it's not a workshop, then it blocks movement.\n              if k_idx in env.world.non_grabbable_indices and k_idx not in env.world.workshop_indices:\n                  return False # This cell contains a blocking obstacle.\n      return True\n\n  def is_adjacent_to_kind(r, c, kind_idx):\n      \"\"\"Checks if (r, c) is adjacent (8-way) to a cell containing kind_idx.\"\"\"\n      for dr in [-1, 0, 1]:\n          for dc in [-1, 0, 1]:\n              if dr == 0 and dc == 0:\n                  continue # Skip the current cell itself\n              nr, nc = r + dr, c + dc\n              if is_within_bounds(nr, nc) and global_grid[nr, nc, kind_idx] == 1:\n                  return True\n      return False\n  \n  # BFS Queue: (current_position (r,c), path_so_far (list of actions))\n  queue = collections.deque([(start_pos, [])])\n  visited = {start_pos} # Set of (r, c) tuples already visited to prevent cycles and redundant exploration\n\n  path_to_target = None # Stores the action path to the desired location for collection/interaction\n\n  while queue:\n      (r, c), path_so_far = queue.popleft()\n\n      # Check if the current position satisfies the goal condition for the primitive\n      if is_workshop:\n          # For workshops, the goal is to be ON the workshop cell\n          if global_grid[r, c, primitive_idx] == 1:\n              path_to_target = path_so_far\n              break # Found the shortest path to the workshop\n      elif is_grabbable_resource:\n          # For grabbable resources, the goal is to be ON the cell containing the resource\n          if global_grid[r, c, primitive_idx] == 1:\n              path_to_target = path_so_far\n              break # Found the shortest path to the resource\n      elif is_non_grabbable_resource:\n          # For non-grabbable resources (like STONE, WATER), the goal is to be ADJACENT to it\n          if is_adjacent_to_kind(r, c, primitive_idx):\n              path_to_target = path_so_far\n              break # Found the shortest path to adjacency\n\n      # Explore neighbor cells (possible moves)\n      for action_val, (dr, dc) in move_deltas.items():\n          next_r, next_c = r + dr, c + dc\n          next_pos = (next_r, next_c)\n\n          if is_traversable(next_r, next_c) and next_pos not in visited:\n              visited.add(next_pos)\n              queue.append((next_pos, path_so_far + [action_val]))\n  \n  if path_to_target:\n      # If a path was found, append the USE action if the primitive is a resource (grabbable or non-grabbable).\n      # Workshops do not require a USE action for \"collection\" (they are locations for crafting).\n      if is_grabbable_resource or is_non_grabbable_resource:\n          actions = path_to_target + [USE]\n      else: # It's a workshop (or potentially a 'BOUNDARY' if that was a target)\n          actions = path_to_target\n  \n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T00:47:46.876736", "function_name": "collect", "function_body": "  actions = []\n\n  # 1. Get Action Mappings and Primitive Index\n  action_map = env.action_specs()\n  UP, DOWN, LEFT, RIGHT, USE = action_map['UP'], action_map['DOWN'], action_map['LEFT'], action_map['RIGHT'], action_map['USE']\n\n  primitive_idx = env.world.cookbook.index[primitive]\n\n  # Get current state information\n  current_state = env._current_state\n  start_pos = current_state.pos\n  global_grid = current_state.grid\n  W, H, _ = global_grid.shape  # Grid dimensions (Width, Height, Number of Kinds)\n\n  # 2. Determine the type of primitive to correctly define the target condition\n  is_workshop = primitive_idx in env.world.workshop_indices\n  is_grabbable_resource = primitive_idx in env.world.grabbable_indices\n  # Non-grabbable resources are items like STONE or WATER that cannot be walked upon\n  # but require interaction from an adjacent cell. Workshops are also non-grabbable\n  # but behave differently (can be walked upon, and do not require 'USE' for \"collection\").\n  is_non_grabbable_resource = (primitive_idx in env.world.non_grabbable_indices and not is_workshop)\n\n  # Define movement deltas for BFS\n  move_deltas = {\n      UP: (-1, 0),\n      DOWN: (1, 0),\n      LEFT: (0, -1),\n      RIGHT: (0, 1)\n  }\n\n  def is_within_bounds(r, c):\n      \"\"\"Checks if coordinates (r, c) are within the grid boundaries.\"\"\"\n      return 0 <= r < W and 0 <= c < H\n\n  def is_traversable(r, c):\n      \"\"\"Checks if (r, c) is a cell the agent can step onto.\n      \n      A cell is traversable if it's within bounds and does not contain any\n      non-grabbable item that blocks movement (i.e., not a workshop).\n      Workshops are non-grabbable but are traversable locations.\n      \"\"\"\n      if not is_within_bounds(r, c):\n          return False\n      \n      # Iterate through all possible kinds at this cell (r, c).\n      # If any kind present at (r,c) is a non-grabbable obstacle AND NOT a workshop,\n      # then the cell is not traversable.\n      for k_idx in range(global_grid.shape[2]):\n          if global_grid[r, c, k_idx] == 1: # If an item of kind k_idx is present at (r,c)\n              if k_idx in env.world.non_grabbable_indices:\n                  # If it's a non-grabbable item, check if it's a workshop.\n                  # Workshops are special non-grabbable items that can be stepped onto.\n                  if k_idx not in env.world.workshop_indices:\n                      return False # This cell contains a non-traversable obstacle (e.g., STONE, WATER, BOUNDARY)\n      return True # If no blocking non-grabbable item is found, the cell is traversable\n\n  def is_adjacent_to_kind(r, c, kind_idx):\n      \"\"\"Checks if (r, c) is adjacent (8-way) to a cell containing kind_idx.\"\"\"\n      for dr in [-1, 0, 1]:\n          for dc in [-1, 0, 1]:\n              if dr == 0 and dc == 0:\n                  continue # Skip checking the current cell itself\n              nr, nc = r + dr, c + dc\n              if is_within_bounds(nr, nc) and global_grid[nr, nc, kind_idx] == 1:\n                  return True\n      return False\n  \n  # 3. Breadth-First Search (BFS) to find the shortest path\n  # Queue stores (current_position (r, c), path_so_far (list of action indices))\n  queue = collections.deque([(start_pos, [])])\n  visited = {start_pos} # Set of (r, c) tuples already visited to prevent cycles\n\n  path_to_target = None # Will store the sequence of actions to reach the target location\n\n  while queue:\n      (r, c), path_so_far = queue.popleft()\n\n      # Check if the current position satisfies the goal condition for collection/reaching\n      if is_workshop:\n          # For workshops, the agent must be ON the workshop cell.\n          if global_grid[r, c, primitive_idx] == 1:\n              path_to_target = path_so_far\n              break # Found the shortest path to the workshop\n      elif is_grabbable_resource:\n          # For grabbable resources (e.g., WOOD, IRON), the agent must be ON the cell\n          # containing the resource.\n          if global_grid[r, c, primitive_idx] == 1:\n              path_to_target = path_so_far\n              break # Found the shortest path to the resource\n      elif is_non_grabbable_resource:\n          # For non-grabbable resources (e.g., STONE, WATER), the agent must be\n          # ADJACENT to the resource.\n          if is_adjacent_to_kind(r, c, primitive_idx):\n              path_to_target = path_so_far\n              break # Found the shortest path to an adjacent cell\n\n      # Explore traversable neighbors\n      for action_val, (dr, dc) in move_deltas.items():\n          next_r, next_c = r + dr, c + dc\n          next_pos = (next_r, next_c)\n\n          if is_traversable(next_r, next_c) and next_pos not in visited:\n              visited.add(next_pos)\n              queue.append((next_pos, path_so_far + [action_val]))\n  \n  # 4. Construct the final list of actions\n  if path_to_target:\n      # If a path was found, append the USE action if it's a resource to be \"collected\".\n      # Workshops are locations, not items to be picked up, so they don't need a USE action.\n      if is_grabbable_resource or is_non_grabbable_resource:\n          actions = path_to_target + [USE]\n      else: # It's a workshop (or other non-resource primitive if applicable)\n          actions = path_to_target\n  \n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T00:48:39.215668", "function_name": "collect", "function_body": "  current_state = env._current_state\n  grid = current_state.grid\n  start_pos = current_state.pos\n  grid_width, grid_height, _ = grid.shape\n  actions = []\n\n  # 1. Get Primitive Index\n  cookbook = env.world.cookbook\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # Primitive name not found in cookbook index, cannot proceed\n    return []\n\n  # 2. Define Action Constants\n  # These map directly to integer action codes for the environment.\n  ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = (\n      craft.UP, craft.DOWN, craft.LEFT, craft.RIGHT, craft.USE\n  )\n  \n  # Map (dr, dc) offsets for cardinal moves to their corresponding action constants\n  CARDINAL_MOVES_MAP = {\n      (-1, 0): ACTION_UP,    # Move up (decrease row index)\n      (1, 0): ACTION_DOWN,   # Move down (increase row index)\n      (0, -1): ACTION_LEFT,  # Move left (decrease column index)\n      (0, 1): ACTION_RIGHT  # Move right (increase column index)\n  }\n  CARDINAL_DIRECTIONS = list(CARDINAL_MOVES_MAP.keys())\n\n  # 3. Categorize the primitive type for collection logic\n  is_grabbable_resource = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n\n  # 4. Handle truly uncollectible/uninteractable primitives\n  # If the primitive is water, or a non-grabbable non-workshop entity, it cannot be 'collected'.\n  if primitive_idx == env.world.water_index or \\\n     (primitive_idx in env.world.non_grabbable_indices and not is_workshop):\n      return []\n\n  # 5. Helper function to determine if a grid cell (r, c) is traversable\n  def is_traversable(r, c):\n    # Check bounds\n    if not (0 <= r < grid_width and 0 <= c < grid_height):\n      return False\n\n    # Check for impassable obstacles at (r, c)\n    # Water is always an impassable obstacle.\n    if grid[r, c, env.world.water_index] == 1:\n      return False\n\n    # Iterate through all entity kinds present at the cell\n    kinds_at_cell = np.where(grid[r, c] == 1)[0]\n    for k_idx in kinds_at_cell:\n        # If the kind is a non-grabbable item and is not a workshop, it's an obstacle.\n        if k_idx in env.world.non_grabbable_indices:\n            if k_idx not in env.world.workshop_indices and k_idx != env.world.water_index:\n                return False # This cell contains a non-traversable obstacle\n    return True\n\n  # 6. Find all grid locations where the target primitive exists\n  primitive_grid_locations = []\n  for r in range(grid_width):\n    for c in range(grid_height):\n      if grid[r, c, primitive_idx] == 1:\n        primitive_grid_locations.append((r, c))\n\n  if not primitive_grid_locations:\n    # Primitive not found anywhere on the map\n    return []\n\n  # 7. Define \"target positions\" for the agent to reach via BFS\n  # These are the cells where the agent needs to be located to \"collect\" the primitive.\n  target_bfs_positions = set()\n  \n  # Offsets for 3x3 neighborhood (including center), used for grabbable resources\n  NEIGHBORHOOD_OFFSETS_3x3 = [\n      (dr, dc) for dr in [-1, 0, 1] for dc in [-1, 0, 1]\n  ]\n\n  if is_grabbable_resource:\n    # For grabbable resources, the agent needs to be adjacent (3x3 neighborhood)\n    # to the resource to use it.\n    for pr, pc in primitive_grid_locations:\n      for dr, dc in NEIGHBORHOOD_OFFSETS_3x3:\n        nr, nc = pr + dr, pc + dc\n        if is_traversable(nr, nc):\n          target_bfs_positions.add((nr, nc))\n  elif is_workshop:\n    # For workshops, the agent generally needs to move directly *onto* the workshop cell.\n    for pr, pc in primitive_grid_locations:\n      if is_traversable(pr, pc): # Ensure the workshop tile itself is traversable\n        target_bfs_positions.add((pr, pc))\n  \n  if not target_bfs_positions:\n    # No reachable or valid target positions found\n    return []\n\n  # 8. Pre-BFS Optimization: Check if already at a desired state\n  if is_grabbable_resource and current_state.next_to(primitive_idx):\n      # Agent is already adjacent to a grabbable primitive, just use it.\n      return [ACTION_USE]\n  elif is_workshop and start_pos in target_bfs_positions:\n      # Agent is already on a workshop tile, no movement or use is needed for 'collect' (reach).\n      return []\n\n  # 9. BFS to find the shortest path to any target position\n  q = collections.deque([(start_pos, [])]) # (position, path_taken_actions)\n  visited = {start_pos}\n  path_to_target = None\n\n  while q:\n    (r, c), current_path = q.popleft()\n\n    # If the current position is a target position, we found the shortest path\n    if (r, c) in target_bfs_positions:\n      path_to_target = current_path\n      break\n\n    for dr, dc in CARDINAL_DIRECTIONS:\n      next_r, next_c = r + dr, c + dc\n      \n      if (next_r, next_c) not in visited and is_traversable(next_r, next_c):\n          visited.add((next_r, next_c))\n          q.append(((next_r, next_c), current_path + [CARDINAL_MOVES_MAP[(dr, dc)]]))\n\n  # 10. Construct final action list\n  if path_to_target:\n    actions.extend(path_to_target)\n    # If collecting a grabbable resource, a 'USE' action is required after reaching the spot.\n    if is_grabbable_resource:\n      actions.append(ACTION_USE)\n  \n  return actions", "island_id": 8, "scores": {"3": 0.0}}
