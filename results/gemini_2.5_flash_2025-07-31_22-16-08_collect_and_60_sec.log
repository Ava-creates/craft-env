r = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`).\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the USE action from the current position, even if not directly on the target primitive.\n    # This is important if using an item at the current position (e.g., picking up a tool)\n    # can change the inventory state, which might be necessary for later steps to collect the primitive.\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if the USE action resulted in a meaningful state change (inventory, position, or direction).\n    # This prevents adding redundant states to the queue if USE had no effect.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T15:09:25.825430", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Semantic check: Determine if this primitive is *actually* collectible into inventory.\n  # This includes items defined as primitives, special environment items like water/stone,\n  # and any other items explicitly marked as grabbable.\n  is_primitive_resource = i_kind in world.cookbook.primitives\n  is_special_collectible_environment = (i_kind == world.water_index or i_kind == world.stone_index)\n  is_grabbable = i_kind in world.grabbable_indices\n\n  if not (is_primitive_resource or is_special_collectible_environment or is_grabbable):\n      # The requested primitive is not collectible through a direct 'collect' action.\n      # It might be craftable, but that's handled by the 'craft' DSL function.\n      return []\n\n  # 3. Check if the primitive is already in the agent's inventory.\n  if current_state.inventory[i_kind] > 0:\n      # Primitive is already collected, no actions needed.\n      return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row decreases, col stays same\n      1: (0, 1),  # RIGHT: row stays same, col increases\n      2: (1, 0),  # DOWN: row increases, col stays same\n      3: (0, -1)  # LEFT: row stays same, col decreases\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return []\n      # Calculate difference ensuring it's positive and within [0, 3]\n      diff = (target_dir - current_dir + 4) % 4\n      if diff == 1:\n          return [RIGHT_ACT] # One right turn (e.g., 0->1)\n      elif diff == 3:\n          return [LEFT_ACT]  # One left turn (e.g., 0->3)\n      else: # diff == 2 (180-degree turn, e.g., 0->2)\n          return [RIGHT_ACT, RIGHT_ACT] # Two right turns (or two left turns)\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The visited set must capture the full state to prevent redundant exploration,\n  # especially if grid changes without immediate inventory/position changes.\n  # State key: (grid_hash, row, col, direction, inventory_tuple)\n  visited = set() \n\n  initial_inventory_tuple = tuple(current_state.inventory)\n  # Hash the grid to include its state in the visited key.\n  # .tobytes() converts the numpy array to a bytes object, which is hashable.\n  initial_grid_hash = hash(current_state.grid.tobytes()) \n\n  q.append((current_state, [])) # Queue stores (CraftState object, path_to_reach_this_state)\n  visited.add((initial_grid_hash, current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Refined heuristic upper bounds for search limits. These values are chosen to balance\n  # computational cost with the likelihood of finding a path in typical CraftWorld scenarios.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 250 \n  MAX_PATH_LENGTH = max(grid_width, grid_height) * 10 \n\n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft()\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states or the path length exceeds a heuristic limit,\n    # skip further exploration from this state to prevent runaway searches.\n    if explored_states_count > MAX_EXPLORED_STATES or len(path) >= MAX_PATH_LENGTH:\n      continue\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n\n    # --- Generate and process all potential next transitions ---\n\n    # 1. Explore Movement Actions (UP, DOWN, LEFT, RIGHT)\n    for action in move_actions:\n        inv_before_action = state.inventory.copy() # Capture inventory state before this action\n        _, next_s = state.step(action)\n        next_p = path + [action]\n\n        # Check if primitive was collected after this action.\n        if next_s.inventory[i_kind] > inv_before_action[i_kind]:\n            return next_p # Goal achieved! Return the shortest path immediately.\n\n        # Add to queue if not visited.\n        next_inventory_tuple = tuple(next_s.inventory)\n        next_grid_hash = hash(next_s.grid.tobytes())\n        next_state_key = (next_grid_hash, next_s.pos[0], next_s.pos[1], next_s.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((next_s, next_p))\n\n    # 2. Explore USE_ACT at current position\n    inv_before_use_at_pos = state.inventory.copy()\n    grid_before_use_at_pos = state.grid.copy() # Capture grid state before USE\n    _, state_after_use_at_pos = state.step(USE_ACT)\n    \n    # Only consider this transition if the USE_ACT actually resulted in a state change\n    # (e.g., inventory changed, or grid changed, or position/direction changed).\n    # This filters out null/ineffective USE actions.\n    state_changed_by_use_at_pos = not (\n        np.array_equal(state_after_use_at_pos.inventory, inv_before_use_at_pos) and\n        state_after_use_at_pos.pos == state.pos and\n        state_after_use_at_pos.dir == state.dir and\n        np.array_equal(state_after_use_at_pos.grid, grid_before_use_at_pos) \n    )\n    if state_changed_by_use_at_pos:\n        next_s = state_after_use_at_pos\n        next_p = path + [USE_ACT]\n        # inv_before_use_at_pos is correctly the inventory before this specific USE_ACT\n\n        # Check if primitive was collected after this action.\n        if next_s.inventory[i_kind] > inv_before_use_at_pos[i_kind]:\n            return next_p # Goal achieved! Return the shortest path immediately.\n\n        # Add to queue if not visited.\n        next_inventory_tuple = tuple(next_s.inventory)\n        next_grid_hash = hash(next_s.grid.tobytes())\n        next_state_key = (next_grid_hash, next_s.pos[0], next_s.pos[1], next_s.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((next_s, next_p))\n\n    # 3. Explore USE_ACT on adjacent cells (after turning to face them)\n    for target_dir in range(4): # Iterate through all four possible facing directions\n        dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n        facing_r, facing_c = current_r + dr, current_c + dc\n\n        # Check if the facing cell is within grid bounds and contains *any* entity\n        # that could potentially be interacted with (e.g., a tree, rock, workbench).\n        if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height) and np.any(state.grid[facing_r, facing_c, :] == 1):\n            turns_to_face = _get_turning_actions(current_dir, target_dir)\n            \n            # Simulate the turns to get the agent into the correct orientation before the USE_ACT.\n            temp_state_before_use = state\n            for turn_action in turns_to_face:\n                _, temp_state_before_use = temp_state_before_use.step(turn_action)\n            \n            # Capture inventory and grid states immediately before the final USE_ACT.\n            inv_before_adj_use = temp_state_before_use.inventory.copy()\n            grid_before_adj_use = temp_state_before_use.grid.copy()\n            \n            # Perform the USE_ACT.\n            _, state_after_adj_use = temp_state_before_use.step(USE_ACT)\n            \n            # Only add this transition if the USE_ACT resulted in a change of state.\n            state_changed_by_adj_use = not (\n                np.array_equal(state_after_adj_use.inventory, inv_before_adj_use) and\n                state_after_adj_use.pos == temp_state_before_use.pos and\n                state_after_adj_use.dir == temp_state_before_use.dir and\n                np.array_equal(state_after_adj_use.grid, grid_before_adj_use) \n            )\n            if state_changed_by_adj_use:\n                next_s = state_after_adj_use\n                next_p = path + turns_to_face + [USE_ACT]\n                # inv_before_adj_use is correctly the inventory before this specific USE_ACT\n\n                # Check if primitive was collected after this action.\n                if next_s.inventory[i_kind] > inv_before_adj_use[i_kind]:\n                    return next_p # Goal achieved! Return the shortest path immediately.\n\n                # Add to queue if not visited.\n                next_inventory_tuple = tuple(next_s.inventory)\n                next_grid_hash = hash(next_s.grid.tobytes())\n                next_state_key = (next_grid_hash, next_s.pos[0], next_s.pos[1], next_s.dir, next_inventory_tuple)\n\n                if next_state_key not in visited:\n                    visited.add(next_state_key)\n                    q.append((next_s, next_p))\n  \n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions\n  # and within the defined search limits.\n  return []", "island_id": 6, "scores": {"3": 2.5}}
{"timestamp": "2025-08-01T15:09:28.906424", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n    This version refines search limits and confirms the semantic scope of collection,\n    and streamlines state transition generation for improved readability and minor efficiency.\n    \n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect.\n\n    Returns:\n        List[int]: A sequence of action indices to execute.\n  \"\"\"\n  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Semantic check: Determine if this primitive is *actually* collectible into inventory.\n  # This includes items defined as primitives, special environment items like water/stone,\n  # and any other items explicitly marked as grabbable.\n  is_primitive_resource = i_kind in world.cookbook.primitives\n  is_special_collectible_environment = (i_kind == world.water_index or i_kind == world.stone_index)\n  is_grabbable = i_kind in world.grabbable_indices\n\n  if not (is_primitive_resource or is_special_collectible_environment or is_grabbable):\n      # The requested primitive is not collectible through a direct 'collect' action.\n      # It might be craftable, but that's handled by the 'craft' DSL function.\n      return []\n\n  # 3. Check if the primitive is already in the agent's inventory.\n  if current_state.inventory[i_kind] > 0:\n      # Primitive is already collected, no actions needed.\n      return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row decreases, col stays same\n      1: (0, 1),  # RIGHT: row stays same, col increases\n      2: (1, 0),  # DOWN: row increases, col stays same\n      3: (0, -1)  # LEFT: row stays same, col decreases\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return []\n      # Calculate difference ensuring it's positive and within [0, 3]\n      diff = (target_dir - current_dir + 4) % 4\n      if diff == 1:\n          return [RIGHT_ACT] # One right turn (e.g., 0->1)\n      elif diff == 3:\n          return [LEFT_ACT]  # One left turn (e.g., 0->3)\n      else: # diff == 2 (180-degree turn, e.g., 0->2)\n          return [RIGHT_ACT, RIGHT_ACT] # Two right turns (or two left turns)\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The visited set must capture the full state to prevent redundant exploration,\n  # especially if grid changes without immediate inventory/position changes.\n  # State key: (grid_hash, row, col, direction, inventory_tuple)\n  visited = set() \n\n  initial_inventory_tuple = tuple(current_state.inventory)\n  # Hash the grid to include its state in the visited key.\n  # .tobytes() converts the numpy array to a bytes object, which is hashable.\n  initial_grid_hash = hash(current_state.grid.tobytes()) \n\n  q.append((current_state, [])) # Queue stores (CraftState object, path_to_reach_this_state)\n  visited.add((initial_grid_hash, current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Refined heuristic upper bounds for search limits:\n  # Slightly increased factors for more comprehensive search in collect_v2 compared to v1.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 300 # Increased from 250 in v1\n  MAX_PATH_LENGTH = max(grid_width, grid_height) * 12 # Increased from 10 in v1\n\n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft()\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states or the path length exceeds a heuristic limit,\n    # skip further exploration from this state to prevent runaway searches.\n    if explored_states_count > MAX_EXPLORED_STATES or len(path) >= MAX_PATH_LENGTH:\n      continue\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n\n    # --- Generate and process all potential next transitions ---\n\n    # 1. Explore Movement Actions (UP, DOWN, LEFT, RIGHT)\n    for action in move_actions:\n        inv_before_action = state.inventory.copy() # Capture inventory state before this action\n        _, next_s = state.step(action)\n        next_p = path + [action]\n\n        # Check if primitive was collected after this action.\n        if next_s.inventory[i_kind] > inv_before_action[i_kind]:\n            return next_p # Goal achieved! Return the shortest path immediately.\n\n        # Add to queue if not visited.\n        next_inventory_tuple = tuple(next_s.inventory)\n        next_grid_hash = hash(next_s.grid.tobytes())\n        next_state_key = (next_grid_hash, next_s.pos[0], next_s.pos[1], next_s.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((next_s, next_p))\n\n    # 2. Explore USE_ACT at current position\n    inv_before_use_at_pos = state.inventory.copy()\n    grid_before_use_at_pos = state.grid.copy() # Capture grid state before USE\n    _, state_after_use_at_pos = state.step(USE_ACT)\n    \n    # Only consider this transition if the USE_ACT actually resulted in a state change.\n    # This filters out null/ineffective USE actions that don't alter the environment or inventory.\n    state_changed_by_use_at_pos = not (\n        np.array_equal(state_after_use_at_pos.inventory, inv_before_use_at_pos) and\n        state_after_use_at_pos.pos == state.pos and\n        state_after_use_at_pos.dir == state.dir and\n        np.array_equal(state_after_use_at_pos.grid, grid_before_use_at_pos) \n    )\n    if state_changed_by_use_at_pos:\n        next_s = state_after_use_at_pos\n        next_p = path + [USE_ACT]\n        # inv_before_use_at_pos is correctly the inventory before this specific USE_ACT\n\n        # Check if primitive was collected after this action.\n        if next_s.inventory[i_kind] > inv_before_use_at_pos[i_kind]:\n            return next_p # Goal achieved! Return the shortest path immediately.\n\n        # Add to queue if not visited.\n        next_inventory_tuple = tuple(next_s.inventory)\n        next_grid_hash = hash(next_s.grid.tobytes())\n        next_state_key = (next_grid_hash, next_s.pos[0], next_s.pos[1], next_s.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((next_s, next_p))\n\n    # 3. Explore USE_ACT on adjacent cells (after turning to face them)\n    for target_dir in range(4): # Iterate through all four possible facing directions\n        dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n        facing_r, facing_c = current_r + dr, current_c + dc\n\n        # Check if the facing cell is within grid bounds and contains *any* entity\n        # that could potentially be interacted with (e.g., trees, rocks, workshops).\n        if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height) and np.any(state.grid[facing_r, facing_c, :] == 1):\n            turns_to_face = _get_turning_actions(current_dir, target_dir)\n            \n            # Simulate the turns to get the agent into the correct orientation before the USE_ACT.\n            temp_state_before_use = state\n            for turn_action in turns_to_face:\n                _, temp_state_before_use = temp_state_before_use.step(turn_action)\n            \n            # Capture inventory and grid states immediately before the final USE_ACT.\n            inv_before_adj_use = temp_state_before_use.inventory.copy()\n            grid_before_adj_use = temp_state_before_use.grid.copy()\n            \n            # Perform the USE_ACT.\n            _, state_after_adj_use = temp_state_before_use.step(USE_ACT)\n            \n            # Only add this transition if the USE_ACT resulted in a change of state.\n            state_changed_by_adj_use = not (\n                np.array_equal(state_after_adj_use.inventory, inv_before_adj_use) and\n                state_after_adj_use.pos == temp_state_before_use.pos and\n                state_after_adj_use.dir == temp_state_before_use.dir and\n                np.array_equal(state_after_adj_use.grid, grid_before_adj_use) \n            )\n            if state_changed_by_adj_use:\n                next_s = state_after_adj_use\n                next_p = path + turns_to_face + [USE_ACT]\n                # inv_before_adj_use is correctly the inventory before this specific USE_ACT\n\n                # Check if primitive was collected after this action.\n                if next_s.inventory[i_kind] > inv_before_adj_use[i_kind]:\n                    return next_p # Goal achieved! Return the shortest path immediately.\n\n                # Add to queue if not visited.\n                next_inventory_tuple = tuple(next_s.inventory)\n                next_grid_hash = hash(next_s.grid.tobytes())\n                next_state_key = (next_grid_hash, next_s.pos[0], next_s.pos[1], next_s.dir, next_inventory_tuple)\n\n                if next_state_key not in visited:\n                    visited.add(next_state_key)\n                    q.append((next_s, next_p))\n  \n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions\n  # and within the defined search limits.\n  return []", "island_id": 6, "scores": {"3": 2.5}}
{"timestamp": "2025-08-01T15:10:41.903197", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world # Access to Cookbook, indices, etc.\n\n  # 1. Resolve primitive name to its integer ID and perform initial validity checks.\n  try:\n    primitive_id = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # Primitive name not found in the world's index.\n    return []\n\n  # Determine if the item is semantically collectible.\n  # This includes explicit primitives, special environmental features (water/stone),\n  # or any item classified as grabbable.\n  is_collectible = (\n      primitive_id in world.cookbook.primitives or\n      primitive_id == world.water_index or\n      primitive_id == world.stone_index or\n      primitive_id in world.grabbable_indices\n  )\n  if not is_collectible:\n    # The requested item cannot be acquired via 'collect' action semantics.\n    return []\n\n  # 2. Early exit: If the primitive is already in inventory, no actions are needed.\n  if current_state.inventory[primitive_id] > 0:\n    return []\n\n  # 3. Define action constants and movement/interaction helper utilities.\n  action_specs = env.action_specs()\n  ACTION_UP = action_specs[\"UP\"]\n  ACTION_DOWN = action_specs[\"DOWN\"]\n  ACTION_LEFT = action_specs[\"LEFT\"]\n  ACTION_RIGHT = action_specs[\"RIGHT\"]\n  ACTION_USE = action_specs[\"USE\"]\n\n  MOVEMENT_ACTIONS = [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]\n\n  # Delta coordinates for cells directly in front of the agent, based on its direction.\n  # Direction 0: UP, 1: RIGHT, 2: DOWN, 3: LEFT\n  DIRECTION_TO_FRONT_DELTA = {\n      0: (-1, 0), # UP: row decreases\n      1: (0, 1),  # RIGHT: col increases\n      2: (1, 0),  # DOWN: row increases\n      3: (0, -1)  # LEFT: col decreases\n  }\n\n  def _get_turns_to_face(current_dir: int, target_dir: int) -> list[int]:\n      \"\"\"Calculates the minimal turning actions to change agent's facing direction.\"\"\"\n      if current_dir == target_dir:\n          return [] # Already facing correctly.\n      \n      # Calculate turns needed (clockwise difference, modulo 4 for wrapping).\n      diff = (target_dir - current_dir + 4) % 4\n      if diff == 1: # 90 degrees clockwise\n          return [ACTION_RIGHT]\n      elif diff == 3: # 270 degrees clockwise (90 degrees counter-clockwise)\n          return [ACTION_LEFT]\n      else: # diff == 2 (180 degrees)\n          return [ACTION_RIGHT, ACTION_RIGHT] # Two right turns (or two left turns)\n\n  # 4. Initialize BFS structures.\n  # Queue stores (current_state_object, list_of_actions_to_reach_this_state)\n  bfs_queue = collections.deque()\n  \n  # Visited set to prevent cycles and redundant state exploration.\n  # A state is defined by (grid_hash, agent_row, agent_col, agent_direction, inventory_tuple).\n  visited_states = set() \n\n  initial_inventory_tuple = tuple(current_state.inventory)\n  # Hash the entire grid to capture its current layout. This is crucial as 'USE'\n  # actions can modify the grid (e.g., removing a tree after chopping).\n  initial_grid_hash = hash(current_state.grid.tobytes()) \n\n  bfs_queue.append((current_state, []))\n  visited_states.add((initial_grid_hash, current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_rows, grid_cols, _ = current_state.grid.shape\n  \n  # Heuristic limits to manage computational complexity for large state spaces.\n  # These are crucial to prevent unbounded searches in complex environments.\n  MAX_EXPLORED_UNIQUE_STATES = grid_rows * grid_cols * 4 * 150 # Max unique states to consider.\n  MAX_PATH_LENGTH = 250 # Max actions in a path.\n\n  states_explored_counter = 0\n\n  # 5. BFS Loop: Explore states layer by layer.\n  while bfs_queue:\n    current_bfs_state, current_path = bfs_queue.popleft()\n    states_explored_counter += 1\n\n    # Pruning: Stop exploring this path if limits are exceeded.\n    if states_explored_counter > MAX_EXPLORED_UNIQUE_STATES or len(current_path) >= MAX_PATH_LENGTH:\n      continue \n\n    agent_r, agent_c = current_bfs_state.pos\n    agent_dir = current_bfs_state.dir\n\n    # List to hold potential next transitions:\n    # (next_state, complete_action_sequence, inventory_before_last_action)\n    # Storing `inventory_before_last_action` allows precise detection of goal acquisition.\n    potential_transitions = []\n\n    # --- Generate Next States from Current BFS State ---\n\n    # A. Movement Actions: UP, DOWN, LEFT, RIGHT\n    for action in MOVEMENT_ACTIONS:\n        # env.step returns a new state object, so current_bfs_state.inventory is implicitly 'inventory before action'.\n        _, next_s_after_move = current_bfs_state.step(action)\n        potential_transitions.append((next_s_after_move, current_path + [action], current_bfs_state.inventory))\n\n    # B. ACTION_USE at the Agent's Current Position\n    # This covers collecting items directly from the tile the agent is standing on.\n    inventory_before_use_at_pos = current_bfs_state.inventory\n    grid_before_use_at_pos = current_bfs_state.grid # Capture grid state before USE\n    _, next_s_after_use_at_pos = current_bfs_state.step(ACTION_USE)\n    \n    # Check if the USE action at position had any effect (inventory change, grid change, etc.)\n    state_changed_by_pos_use = not (\n        np.array_equal(next_s_after_use_at_pos.inventory, inventory_before_use_at_pos) and\n        np.array_equal(next_s_after_use_at_pos.grid, grid_before_use_at_pos) and\n        next_s_after_use_at_pos.pos == current_bfs_state.pos and\n        next_s_after_use_at_pos.dir == current_bfs_state.dir\n    )\n    if state_changed_by_pos_use:\n        potential_transitions.append((next_s_after_use_at_pos, current_path + [ACTION_USE], inventory_before_use_at_pos))\n    \n    # C. ACTION_USE on Adjacent Cells (after turning to face them)\n    # This covers interactions with entities in the 8-neighborhood that require facing (e.g., chopping a tree, mining a rock).\n    for target_facing_direction in range(4): # Iterate through UP, RIGHT, DOWN, LEFT as target directions\n        dr, dc = DIRECTION_TO_FRONT_DELTA[target_facing_direction]\n        facing_r, facing_c = agent_r + dr, agent_c + dc\n\n        # Check if the cell directly in front is within bounds and contains *any* entity.\n        # We don't need to check for `primitive_id` specifically here, as 'USE' might\n        # interact with one entity (e.g., \"ROCK\") to yield another (e.g., \"GOLD\").\n        if (0 <= facing_r < grid_rows and 0 <= facing_c < grid_cols) and np.any(current_bfs_state.grid[facing_r, facing_c, :] == 1):\n            \n            # 1. Get actions to turn the agent towards the target cell.\n            turning_actions = _get_turns_to_face(agent_dir, target_facing_direction)\n            \n            # 2. Simulate these turning actions to get an intermediate state where agent is oriented.\n            temp_state_after_turns = current_bfs_state\n            for turn_action in turning_actions:\n                _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n            \n            # 3. Capture inventory and grid states BEFORE performing the final USE action.\n            inventory_before_adj_use = temp_state_after_turns.inventory\n            grid_before_adj_use = temp_state_after_turns.grid\n            \n            # 4. Perform the ACTION_USE from the correctly oriented state.\n            _, next_s_after_adj_use = temp_state_after_turns.step(ACTION_USE)\n            \n            # Check if the USE action on the adjacent cell had any effect.\n            state_changed_by_adj_use = not (\n                np.array_equal(next_s_after_adj_use.inventory, inventory_before_adj_use) and\n                np.array_equal(next_s_after_adj_use.grid, grid_before_adj_use) and\n                next_s_after_adj_use.pos == temp_state_after_turns.pos and\n                next_s_after_adj_use.dir == temp_state_after_turns.dir\n            )\n            if state_changed_by_adj_use:\n                potential_transitions.append(\n                    (next_s_after_adj_use, current_path + turning_actions + [ACTION_USE], inventory_before_adj_use)\n                )\n\n    # --- Process all Generated Potential Transitions ---\n    for next_state, full_action_sequence, inv_before_last_action in potential_transitions:\n        # Check if the target primitive was acquired specifically in the LAST step of this path.\n        if next_state.inventory[primitive_id] > inv_before_last_action[primitive_id]:\n            return full_action_sequence # Goal achieved! Return the shortest path found.\n\n        # If not the goal, add the new state to the BFS queue if it hasn't been visited.\n        next_inventory_tuple = tuple(next_state.inventory)\n        next_grid_hash = hash(next_state.grid.tobytes())\n        next_state_key = (next_grid_hash, next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n        if next_state_key not in visited_states:\n            visited_states.add(next_state_key)\n            bfs_queue.append((next_state, full_action_sequence))\n\n  # 6. If the BFS queue is exhausted and no path was found, the primitive is unreachable\n  # under current conditions or within the defined search limits.\n  return []", "island_id": 2, "scores": {"3": 2.5}}
{"timestamp": "2025-08-01T15:10:44.979107", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Resolve primitive name to its integer ID.\n  # Return an empty list if the primitive name is not found in the cookbook's index.\n  try:\n    primitive_id = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    return []\n\n  # 2. Semantic check: Determine if this primitive is actually collectible into inventory.\n  # A primitive is collectible if it's a core primitive resource, a special environment\n  # feature (like water or stone), or any item explicitly marked as grabbable.\n  is_primitive_resource = primitive_id in world.cookbook.primitives\n  is_special_collectible_environment = (primitive_id == world.water_index or primitive_id == world.stone_index)\n  is_grabbable_item = primitive_id in world.grabbable_indices\n\n  if not (is_primitive_resource or is_special_collectible_environment or is_grabbable_item):\n      # If the requested item cannot be collected, return an empty action list.\n      return []\n\n  # 3. Quick check: If the primitive is already in the agent's inventory, no actions are needed.\n  if current_state.inventory[primitive_id] > 0:\n      return []\n\n  # 4. Define action constants and utilities for movement and direction.\n  action_map = env.action_specs()\n  ACTION_UP = action_map[\"UP\"]\n  ACTION_DOWN = action_map[\"DOWN\"]\n  ACTION_LEFT = action_map[\"LEFT\"]\n  ACTION_RIGHT = action_map[\"RIGHT\"]\n  ACTION_USE = action_map[\"USE\"]\n\n  MOVEMENT_ACTIONS = [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]\n\n  # Mapping from agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to its corresponding (row_delta, col_delta) for the cell directly in front.\n  _DIR_TO_FRONT_DELTA = {\n      0: (-1, 0), # UP: row decreases, col stays same\n      1: (0, 1),  # RIGHT: row stays same, col increases\n      2: (1, 0),  # DOWN: row increases, col stays same\n      3: (0, -1)  # LEFT: row stays same, col decreases\n  }\n\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      \"\"\"Calculates the shortest sequence of turns to face a target direction.\"\"\"\n      if current_dir == target_dir:\n          return []\n      \n      # Calculate the angular difference (clockwise) in number of 90-degree turns.\n      # Adding 4 and modulo 4 handles negative differences correctly.\n      diff_turns_clockwise = (target_dir - current_dir + 4) % 4\n      \n      if diff_turns_clockwise == 1:\n          return [ACTION_RIGHT] # One right turn.\n      elif diff_turns_clockwise == 3:\n          return [ACTION_LEFT]  # One left turn (equivalent to three right turns).\n      else: # diff_turns_clockwise == 2 (180-degree turn).\n          return [ACTION_RIGHT, ACTION_RIGHT] # Two right turns.\n\n  # 5. Initialize Breadth-First Search (BFS) components.\n  # The queue stores tuples of (current_state_object, path_taken_to_reach_this_state).\n  bfs_queue = collections.deque()\n  \n  # The visited set prevents redundant exploration of states. A state is uniquely\n  # identified by (grid_hash, row, col, direction, inventory_tuple).\n  visited_states = set() \n\n  initial_inventory_tuple = tuple(current_state.inventory)\n  # Convert numpy array to bytes for hashing to represent the grid state.\n  initial_grid_hash = hash(current_state.grid.tobytes()) \n\n  bfs_queue.append((current_state, [])) # Start BFS from the initial state with an empty path.\n  visited_states.add((initial_grid_hash, current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_rows, grid_cols, _ = current_state.grid.shape\n  \n  # Heuristic limits for search depth and breadth to prevent excessive computation.\n  MAX_EXPLORED_UNIQUE_STATES = grid_rows * grid_cols * 4 * 150 \n  MAX_ACTION_PATH_LENGTH = 250 \n\n  num_explored_states = 0\n\n  # Helper function to process a newly generated state for BFS.\n  # This function will raise StopIteration if the goal is found, enabling early exit.\n  def _process_next_state(next_state: craft.CraftState, path_to_next_state: list[int], inventory_before_last_action: np.ndarray):\n      \"\"\"Helper to check if goal achieved or add state to BFS queue.\"\"\"\n      # Check if the target primitive was successfully acquired in the *last step* of this sequence.\n      if next_state.inventory[primitive_id] > inventory_before_last_action[primitive_id]:\n          raise StopIteration(path_to_next_state) # Goal achieved! Propagate the path.\n\n      # If not the goal state, add it to the queue for further exploration if it hasn't been visited before.\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_grid_hash = hash(next_state.grid.tobytes())\n      next_state_key = (next_grid_hash, next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited_states:\n          visited_states.add(next_state_key)\n          bfs_queue.append((next_state, path_to_next_state))\n\n  # 6. BFS Loop: Explore states layer by layer to find the shortest path.\n  try:\n    while bfs_queue:\n      current_bfs_state, current_path = bfs_queue.popleft()\n      num_explored_states += 1\n\n      # Pruning: If limits are exceeded, stop exploring from this path.\n      if num_explored_states > MAX_EXPLORED_UNIQUE_STATES or len(current_path) >= MAX_ACTION_PATH_LENGTH:\n        continue \n\n      agent_r, agent_c = current_bfs_state.pos\n      agent_dir = current_bfs_state.dir\n\n      # --- Generate potential next states from the current BFS state ---\n\n      # 1. Explore Movement Actions (UP, DOWN, LEFT, RIGHT).\n      for move_action in MOVEMENT_ACTIONS:\n          _, next_s_after_move = current_bfs_state.step(move_action)\n          _process_next_state(next_s_after_move, current_path + [move_action], current_bfs_state.inventory)\n\n      # 2. Explore ACTION_USE at the agent's current position.\n      # This handles collecting items directly from the cell the agent is standing on.\n      inventory_before_use_at_pos = current_bfs_state.inventory # No copy needed as step returns new state\n      grid_before_use_at_pos = current_bfs_state.grid\n      _, next_s_after_use_at_pos = current_bfs_state.step(ACTION_USE)\n      \n      # Only add this transition if the ACTION_USE resulted in a detectable change.\n      if not (np.array_equal(next_s_after_use_at_pos.inventory, inventory_before_use_at_pos) and\n              np.array_equal(next_s_after_use_at_pos.grid, grid_before_use_at_pos) and\n              next_s_after_use_at_pos.pos == current_bfs_state.pos and\n              next_s_after_use_at_pos.dir == current_bfs_state.dir):\n          _process_next_state(next_s_after_use_at_pos, current_path + [ACTION_USE], inventory_before_use_at_pos)\n      \n      # 3. Explore ACTION_USE on adjacent cells (after turning to face them).\n      # This covers interactions like chopping trees or mining rocks, where the\n      # target resource is in an adjacent cell and requires facing it.\n      for target_facing_dir in range(4): # Iterate through all 4 cardinal directions.\n          dr, dc = _DIR_TO_FRONT_DELTA[target_facing_dir]\n          facing_r, facing_c = agent_r + dr, agent_c + dc\n\n          # Check if the cell directly in front is within grid bounds AND contains ANY entity.\n          if (0 <= facing_r < grid_rows and 0 <= facing_c < grid_cols) and np.any(current_bfs_state.grid[facing_r, facing_c, :] == 1):\n              \n              # Get the sequence of actions required to turn the agent to face the target direction.\n              turning_actions = _get_turning_actions(agent_dir, target_facing_dir)\n              \n              # Simulate the turning actions to get an intermediate state.\n              temp_state_after_turns = current_bfs_state\n              for turn_action in turning_actions:\n                  _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n              \n              # Capture inventory and grid *before* the final ACTION_USE for this branch.\n              inventory_before_adj_use = temp_state_after_turns.inventory\n              grid_before_adj_use = temp_state_after_turns.grid\n              \n              # Perform the ACTION_USE from the correctly oriented state.\n              _, next_s_after_adj_use = temp_state_after_turns.step(ACTION_USE)\n              \n              # Only consider this transition if the ACTION_USE resulted in a state change.\n              if not (np.array_equal(next_s_after_adj_use.inventory, inventory_before_adj_use) and\n                      np.array_equal(next_s_after_adj_use.grid, grid_before_adj_use) and\n                      next_s_after_adj_use.pos == temp_state_after_turns.pos and\n                      next_s_after_adj_use.dir == temp_state_after_turns.dir):\n                  _process_next_state(next_s_after_adj_use, current_path + turning_actions + [ACTION_USE], inventory_before_adj_use)\n  except StopIteration as e:\n    # Goal path found, return the path carried by the exception.\n    return e.value\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions\n  # or within the defined search limits.\n  return []", "island_id": 2, "scores": {"3": 2.5}}
