{"timestamp": "2025-08-01T14:15:30.833350", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n\n  grid = current_state.grid\n  initial_pos = current_state.pos\n  initial_dir = current_state.dir\n\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  num_rows, num_cols, _ = grid.shape\n\n  action_map = env.action_specs()\n  ACTION_MOVE_FORWARD = action_map['UP']\n  ACTION_TURN_LEFT = action_map['LEFT']\n  ACTION_TURN_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Mapping agent's direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN) to (delta_row, delta_col)\n  DIR_TO_DELTA_RC = {\n      0: (0, 1),   # Facing RIGHT\n      1: (-1, 0),  # Facing UP\n      2: (0, -1),  # Facing LEFT\n      3: (1, 0)    # Facing DOWN\n  }\n\n  # Mapping current direction to next direction after turning left or right\n  TURN_LEFT_DIR_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  TURN_RIGHT_DIR_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # Indices of entities that block agent movement (e.g., walls, water, workshops).\n  non_walkable_kind_indices = list(current_state.world.non_grabbable_indices)\n\n  def is_in_bounds(r: int, c: int) -> bool:\n      \"\"\"Checks if a given grid position (row, col) is within the valid boundaries.\"\"\"\n      return 0 <= r < num_rows and 0 <= c < num_cols\n\n  def is_cell_passable(r: int, c: int) -> bool:\n      \"\"\"Checks if the agent can legally move onto the cell (r, c).\n      \n      A cell is not passable if it's out of bounds, contains the target primitive itself\n      (agent must be adjacent to 'use' it), or contains any other non-grabbable/blocking entity.\n      \"\"\"\n      if not is_in_bounds(r, c):\n          return False\n      \n      # Agent cannot walk directly onto the primitive it wants to collect.\n      # It must be adjacent to it to 'USE' it.\n      if grid[r, c, primitive_id] > 0:\n          return False\n\n      # Check if the cell contains any other entity that blocks movement.\n      for kind_idx in non_walkable_kind_indices:\n          if grid[r, c, kind_idx] > 0:\n              return False\n          \n      return True\n\n  # BFS Initialization:\n  # The queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_to_reach_here).\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # The visited set stores (position_tuple, direction_int) to avoid redundant computations,\n  # prevent cycles, and ensure the shortest path is found.\n  visited_states = set([(initial_pos, initial_dir)])\n\n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      current_row, current_col = current_pos\n\n      # Check if the primitive is directly in front of the agent from the current state.\n      # If it is, we have found the target 'adjacency' state, and the path to reach it.\n      delta_r_front, delta_c_front = DIR_TO_DELTA_RC[current_dir]\n      front_cell_row, front_cell_col = current_row + delta_r_front, current_col + delta_c_front\n      \n      # Verify the cell in front is within bounds and contains the target primitive.\n      if (is_in_bounds(front_cell_row, front_cell_col) and \n          grid[front_cell_row, front_cell_col, primitive_id] > 0):\n          \n          # Target found: return the path to reach this adjacent state, plus the 'USE' action.\n          return path_so_far + [ACTION_USE]\n\n      # Explore possible next actions (Move Forward, Turn Left, Turn Right)\n      # from the current state and add valid, unvisited next states to the queue.\n\n      # 1. Try Move Forward action:\n      next_row_fwd, next_col_fwd = current_row + delta_r_front, current_col + delta_c_front\n      next_pos_fwd = (next_row_fwd, next_col_fwd)\n      # Agent's direction remains unchanged after moving straight.\n      next_dir_fwd = current_dir \n\n      if (is_cell_passable(next_row_fwd, next_col_fwd) and\n          (next_pos_fwd, next_dir_fwd) not in visited_states):\n          \n          visited_states.add((next_pos_fwd, next_dir_fwd))\n          queue.append(((next_pos_fwd, next_dir_fwd), path_so_far + [ACTION_MOVE_FORWARD]))\n\n      # 2. Try Turn Left action:\n      next_dir_left = TURN_LEFT_DIR_MAP[current_dir]\n      # Agent's position remains unchanged when turning.\n      if ((current_pos, next_dir_left) not in visited_states):\n          visited_states.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_so_far + [ACTION_TURN_LEFT]))\n\n      # 3. Try Turn Right action:\n      next_dir_right = TURN_RIGHT_DIR_MAP[current_dir]\n      # Agent's position remains unchanged when turning.\n      if ((current_pos, next_dir_right) not in visited_states):\n          visited_states.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_so_far + [ACTION_TURN_RIGHT]))\n\n  # If the BFS queue becomes empty and no path to the primitive was found,\n  # it means the primitive is unreachable in the current environment state.\n  return []", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T14:15:32.066357", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\"\"\"\n  current_state = env._current_state\n\n  # --- State Information Extraction ---\n  # Agent's current position (row, col) and facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN).\n  agent_initial_pos = current_state.pos\n  agent_initial_dir = current_state.dir\n\n  # The game grid, representing the environment layout.\n  grid_layout = current_state.grid\n  grid_rows, grid_cols, _ = grid_layout.shape\n\n  # Get the integer ID for the target primitive from the environment's cookbook index.\n  # This ID is used to identify the primitive within the grid's 'kinds' dimension.\n  target_primitive_id = current_state.world.cookbook.index[primitive]\n\n  # Get indices of entities that are typically impassable (e.g., boundaries, water, workshops).\n  # These are entities the agent cannot walk over. `non_grabbable_indices` is already a set.\n  impassable_entity_ids = current_state.world.non_grabbable_indices\n\n  # --- Action Mapping and Directional Constants ---\n  action_specs = env.action_specs()\n  ACTION_MOVE_FORWARD = action_specs['UP']    # Note: 'UP' in action_specs means move forward\n  ACTION_TURN_LEFT = action_specs['LEFT']\n  ACTION_TURN_RIGHT = action_specs['RIGHT']\n  ACTION_USE = action_specs['USE']\n\n  # Maps agent's direction (0,1,2,3) to corresponding (delta_row, delta_col) for moving forward.\n  # Example: 0 (RIGHT) means row doesn't change, col increases by 1.\n  DIR_TO_DELTA_RC = {\n      0: (0, 1),   # RIGHT\n      1: (-1, 0),  # UP\n      2: (0, -1),  # LEFT\n      3: (1, 0)    # DOWN\n  }\n\n  # Maps current direction to the new direction after turning left.\n  TURN_LEFT_DIR_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  # Maps current direction to the new direction after turning right.\n  TURN_RIGHT_DIR_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # --- Helper Functions for BFS ---\n\n  def is_within_bounds(r: int, c: int) -> bool:\n      \"\"\"Checks if a given grid cell (row, col) is within the environment's boundaries.\"\"\"\n      return 0 <= r < grid_rows and 0 <= c < grid_cols\n\n  def is_cell_passable(r: int, c: int) -> bool:\n      \"\"\"Determines if the agent can physically move into a specific grid cell (r, c).\n      A cell is not passable if:\n      1. It's out of bounds.\n      2. It contains the target primitive (agent must be adjacent to 'use', not on top).\n      3. It contains any recognized impassable entity (e.g., water, boundary walls).\n      \"\"\"\n      if not is_within_bounds(r, c):\n          return False\n      \n      # The agent cannot move onto the primitive itself, as it needs to 'use' it from an adjacent cell.\n      if grid_layout[r, c, target_primitive_id] > 0:\n          return False\n\n      # Check for any other known impassable entities in this cell.\n      # Iterate through `impassable_entity_ids` (which is a set) and check the grid layer.\n      for kind_id in impassable_entity_ids:\n          if grid_layout[r, c, kind_id] > 0:\n              return False\n          \n      return True\n\n  # --- Breadth-First Search (BFS) Implementation ---\n\n  # The BFS queue stores tuples:\n  # ((current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_here)\n  bfs_queue = collections.deque([((agent_initial_pos, agent_initial_dir), [])])\n  \n  # The visited set stores (position_tuple, direction_int) to keep track of states\n  # that have already been explored, preventing cycles and ensuring the shortest path.\n  visited_states = {(agent_initial_pos, agent_initial_dir)}\n\n  # This variable will store the list of actions leading to a state where the\n  # target primitive is directly in front of the agent.\n  path_to_primitive_adjacency = None \n\n  while bfs_queue:\n      (current_pos, current_dir), path_to_current_state = bfs_queue.popleft()\n      current_row, current_col = current_pos\n\n      # 1. Check if the primitive is immediately in front of the agent from the current state.\n      # If it is, we have found the path to an 'adjacent' state, which is our BFS goal.\n      delta_r_front, delta_c_front = DIR_TO_DELTA_RC[current_dir]\n      front_cell_row, front_cell_col = current_row + delta_r_front, current_col + delta_c_front\n      \n      if (is_within_bounds(front_cell_row, front_cell_col) and \n          grid_layout[front_cell_row, front_cell_col, target_primitive_id] > 0):\n          \n          path_to_primitive_adjacency = path_to_current_state\n          break # Goal found, exit the BFS loop.\n\n      # 2. Explore possible next actions (Move Forward, Turn Left, Turn Right)\n      #    from the current state and add valid, unvisited next states to the queue.\n\n      # A. Explore 'Move Forward' action:\n      next_row_move, next_col_move = current_row + delta_r_front, current_col + delta_c_front\n      next_pos_move = (next_row_move, next_col_move)\n      next_dir_move = current_dir # Direction doesn't change when moving straight.\n\n      if (is_cell_passable(next_row_move, next_col_move) and\n          (next_pos_move, next_dir_move) not in visited_states):\n          \n          visited_states.add((next_pos_move, next_dir_move))\n          bfs_queue.append(((next_pos_move, next_dir_move), path_to_current_state + [ACTION_MOVE_FORWARD]))\n\n      # B. Explore 'Turn Left' action:\n      next_dir_left = TURN_LEFT_DIR_MAP[current_dir]\n      next_pos_turn_left = current_pos # Position doesn't change when turning.\n\n      if ((next_pos_turn_left, next_dir_left) not in visited_states):\n          visited_states.add((next_pos_turn_left, next_dir_left))\n          bfs_queue.append(((next_pos_turn_left, next_dir_left), path_to_current_state + [ACTION_TURN_LEFT]))\n\n      # C. Explore 'Turn Right' action:\n      next_dir_right = TURN_RIGHT_DIR_MAP[current_dir]\n      next_pos_turn_right = current_pos # Position doesn't change when turning.\n\n      if ((next_pos_turn_right, next_dir_right) not in visited_states):\n          visited_states.add((next_pos_turn_right, next_dir_right))\n          bfs_queue.append(((next_pos_turn_right, next_dir_right), path_to_current_state + [ACTION_TURN_RIGHT]))\n\n  # --- Finalizing the Action List ---\n  # If a path to being adjacent to the primitive was found, append the 'USE' action\n  # to the collected path to finalize the primitive collection.\n  if path_to_primitive_adjacency is not None:\n      return path_to_primitive_adjacency + [ACTION_USE]\n  else:\n      # If the primitive is unreachable after exploring all possibilities, return an empty list.\n      return []", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T14:16:42.170328", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`. Finds and collects a primitive using BFS.\n\n    This function performs a Breadth-First Search (BFS) to find the shortest\n    sequence of actions (movements and turns) that will position the agent\n    adjacent to the target primitive and facing it, followed by a 'USE' action.\n    It considers unwalkable terrain to ensure a valid path.\n\n    Args:\n        env (env.CraftLab): The CraftLab object representing the current simulation environment.\n        primitive (str): The string name of the primitive item to collect (e.g., \"WOOD\", \"STONE\").\n\n    Returns:\n        List[int]: A sequence of integer action indices (e.g., MOVE_FORWARD, TURN_LEFT, USE)\n                   to execute in the environment. Returns an empty list if the primitive\n                   is unreachable or not found.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state\n\n  # Extract current state information\n  # The grid is typically indexed as grid[row, col, kind_id]\n  grid = current_state.grid \n  initial_pos = current_state.pos # Agent's current (row, col) tuple\n  initial_dir = current_state.dir # Agent's current facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook index\n  try:\n    primitive_id = current_state.world.cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not found in the cookbook, it cannot be collected.\n    return []\n  \n  # Determine grid dimensions (number of rows, number of columns)\n  GRID_ROWS, GRID_COLS, _ = grid.shape\n\n  # Map action names from the DSL/environment to their integer indices\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP'] # 'UP' action typically means moving forward in the current direction\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE'] # Action to collect the item\n\n  # Define how agent's (row, col) position changes when moving forward based on direction\n  # DIR_TO_DRDC maps current_dir to a (delta_row, delta_col) tuple\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT (0): (row, col+1)\n      1: (-1, 0),  # Facing UP (1):   (row-1, col)\n      2: (0, -1),  # Facing LEFT (2): (row, col-1)\n      3: (1, 0)    # Facing DOWN (3): (row+1, col)\n  }\n\n  # Define how agent's direction changes when turning\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right(0) -> Up(1) -> Left(2) -> Down(3) -> Right(0)\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right(0) -> Down(3) -> Left(2) -> Up(1) -> Right(0)\n\n  # Identify entity kinds that the agent cannot walk onto.\n  # This set includes general non-grabbable items (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  # AND the primitive itself, as the agent needs to stop *adjacent* to it to USE, not on it.\n  unwalkable_kind_ids = set(current_state.world.non_grabbable_indices)\n  unwalkable_kind_ids.add(primitive_id) \n\n  # BFS setup:\n  # The queue stores elements: ((current_pos_tuple, current_dir_int), list_of_actions_to_reach_here)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # The visited set stores (position, direction) pairs to avoid redundant exploration and cycles\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # This will store the sequence of actions once the target state is found\n\n  # Start BFS\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos # Deconstruct current_pos into row and column\n\n      # 1. Check if the target primitive is in the cell directly in front of the agent\n      # Calculate coordinates of the cell directly in front of the agent\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the front cell is within grid boundaries\n      if (0 <= front_r < GRID_ROWS and 0 <= front_c < GRID_COLS):\n          # Check if the front cell contains the primitive we are looking for\n          if grid[front_r, front_c, primitive_id] > 0:\n              target_path_actions = path_actions # Path to reach adjacent-and-facing state found\n              break # Exit BFS, target found\n\n      # 2. Explore possible next actions: Move Forward, Turn Left, Turn Right\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if the next position is within bounds and this (pos, dir) state hasn't been visited\n      if (0 <= next_r < GRID_ROWS and 0 <= next_c < GRID_COLS and\n          (next_pos, next_dir) not in visited):\n          \n          # Check if the next position is walkable (i.e., does not contain any unwalkable kinds)\n          is_walkable = True\n          for kind_idx in unwalkable_kind_ids:\n              if grid[next_r, next_c, kind_idx] > 0: # If the cell contains an unwalkable kind\n                  is_walkable = False\n                  break # Not walkable, no need to check other kinds in this cell\n          \n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning only changes direction, not position\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning only changes direction, not position\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path to the adjacent-and-facing state was found, append the USE action\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T14:16:43.311019", "function_name": "collect", "function_body": "  \"\"\"Finds and collects a specified primitive in the CraftLab environment using Breadth-First Search (BFS).\n\n    This function determines the shortest sequence of actions (movements and turns)\n    required to position the agent adjacent to the target primitive and facing it,\n    followed by a 'USE' action to collect it. It accounts for unwalkable terrain\n    and returns an empty list if the primitive is unreachable.\n\n    Args:\n        env (env.CraftLab): The CraftLab object representing the current simulation environment.\n        primitive (str): The string name of the primitive item to collect (e.g., \"WOOD\", \"STONE\").\n\n    Returns:\n        List[int]: A sequence of integer action indices (e.g., MOVE_FORWARD, TURN_LEFT, USE)\n                   to execute in the environment. Returns an empty list if the primitive\n                   is unreachable or its name is not recognized.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state\n\n  # Extract current state information\n  grid = current_state.grid \n  initial_pos = current_state.pos # Agent's current (row, col) tuple\n  initial_dir = current_state.dir # Agent's current facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook index\n  try:\n    primitive_id = current_state.world.cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not found in the cookbook, it cannot be collected.\n    return []\n  \n  # Determine grid dimensions (number of rows, number of columns)\n  GRID_ROWS, GRID_COLS, _ = grid.shape\n\n  # Map action names from the DSL/environment to their integer indices\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP'] # 'UP' action typically means moving forward in the current direction\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE'] # Action to collect the item\n\n  # Define how agent's (row, col) position changes when moving forward based on direction\n  # DIR_TO_DRDC maps current_dir to a (delta_row, delta_col) tuple\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT\n      1: (-1, 0),  # Facing UP\n      2: (0, -1),  # Facing LEFT\n      3: (1, 0)    # Facing DOWN\n  }\n\n  # Define how agent's direction changes when turning\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # Identify entity kinds that the agent cannot walk onto.\n  # This includes general non-grabbable items (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  # AND the primitive itself, as the agent needs to stop *adjacent* to it to USE, not on it.\n  unwalkable_kind_ids = set(current_state.world.non_grabbable_indices)\n  unwalkable_kind_ids.add(primitive_id) \n\n  # BFS setup:\n  # The queue stores elements: ((current_pos_tuple, current_dir_int), list_of_actions_to_reach_here)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # The visited set stores (position, direction) pairs to avoid redundant exploration and cycles\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # This will store the sequence of actions once the target state is found\n\n  # Start BFS\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos # Deconstruct current_pos into row and column\n\n      # 1. Check if the target primitive is in the cell directly in front of the agent\n      # Calculate coordinates of the cell directly in front of the agent\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the front cell is within grid boundaries\n      if (0 <= front_r < GRID_ROWS and 0 <= front_c < GRID_COLS):\n          # Check if the front cell contains the primitive we are looking for\n          if grid[front_r, front_c, primitive_id] > 0:\n              target_path_actions = path_actions # Path to reach adjacent-and-facing state found\n              break # Exit BFS, target found\n\n      # 2. Explore possible next actions: Move Forward, Turn Left, Turn Right\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if the next position is within bounds and this (pos, dir) state hasn't been visited\n      if (0 <= next_r < GRID_ROWS and 0 <= next_c < GRID_COLS and\n          (next_pos, next_dir) not in visited):\n          \n          # Check if the next position is walkable:\n          # A cell is unwalkable if it contains any entity kind specified in `unwalkable_kind_ids`.\n          # This is an improvement in conciseness over iterating and breaking.\n          is_walkable = not any(grid[next_r, next_c, kind_idx] > 0 for kind_idx in unwalkable_kind_ids)\n          \n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning only changes direction, not position\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning only changes direction, not position\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path to the adjacent-and-facing state was found, append the USE action\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T14:17:12.863230", "function_name": "collect", "function_body": "  actions_list = []\n  # Access the current state of the environment through the CraftLab wrapper\n  current_state = env._current_state \n  \n  # Map the string primitive name to its integer ID using the cookbook's index\n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  # Pre-check: Determine if the target primitive is actually collectible (grabbable).\n  # Items like BOUNDARY, WATER, STONE, and WORKSHOPS are fixed environmental features\n  # and cannot be picked up using the 'USE' action. If the primitive is not grabbable,\n  # no collection actions can be performed, so an empty list is returned immediately.\n  if primitive_id not in current_state.world.grabbable_indices:\n      # If the primitive is not something that can be 'picked up', return an empty path.\n      return []\n\n  # Extract initial state information for pathfinding\n  initial_grid = current_state.grid # The current layout of the world\n  initial_agent_pos = current_state.pos # Agent's starting (row, col) position\n  initial_agent_dir = current_state.dir # Agent's starting direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  GRID_WIDTH, GRID_HEIGHT, _ = initial_grid.shape # Get dimensions of the grid\n\n  # Map DSL actions (semantic names) to their corresponding integer indices\n  # as defined by the environment's action_specs.\n  action_specs = env.action_specs()\n  ACTION_MOVE_FORWARD = action_specs['UP']    # In Craft, 'UP' means moving forward relative to agent's direction.\n  ACTION_TURN_LEFT = action_specs['LEFT']\n  ACTION_TURN_RIGHT = action_specs['RIGHT']\n  ACTION_USE = action_specs['USE']\n\n  # Define changes in (row, col) coordinates for movement based on current facing direction.\n  # This mapping simplifies calculating the next position after a 'MOVE_FORWARD' action.\n  # (dr, dc) = (delta_row, delta_column)\n  DIRECTION_TO_DELTA_POS = {\n      0: (0, 1),   # Facing RIGHT (0): moving forward increases column (col + 1)\n      1: (-1, 0),  # Facing UP (1): moving forward decreases row (row - 1)\n      2: (0, -1),  # Facing LEFT (2): moving forward decreases column (col - 1)\n      3: (1, 0)    # Facing DOWN (3): moving forward increases row (row + 1)\n  }\n\n  # Define how the agent's direction changes when turning left or right.\n  # These are cyclical mappings (0->1->2->3->0 for left, 0->3->2->1->0 for right).\n  TURN_LEFT_NEXT_DIR = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_NEXT_DIR = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Identify all grid entity indices that block agent movement.\n  # This set includes non-grabbable items (e.g., boundaries, water, workshops)\n  # and crucially, the target `primitive_id` itself. The agent cannot move onto\n  # a square containing the item it intends to 'USE'; it must be adjacent to it.\n  # We convert to a list for efficient NumPy advanced indexing later.\n  non_walkable_kind_ids = list(current_state.world.non_grabbable_indices.union({primitive_id}))\n\n  # Breadth-First Search (BFS) for the shortest path to a collectible state.\n  # The BFS queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_here)\n  bfs_queue = collections.deque([((initial_agent_pos, initial_agent_dir), [])])\n  \n  # The visited set stores (position_tuple, direction_int) to prevent\n  # redundant exploration and infinite loops (cycles) in the search.\n  visited_states = {(initial_agent_pos, initial_agent_dir)}\n\n  # Variable to store the action sequence once the target state\n  # (agent is adjacent to and facing the primitive) is found.\n  shortest_path_to_primitive = None \n\n  while bfs_queue:\n      (current_pos, current_dir), current_path_actions = bfs_queue.popleft()\n      current_row, current_col = current_pos\n\n      # Check if the agent is currently positioned to 'USE' the primitive:\n      # This means the primitive must be in the cell directly in front of the agent.\n      front_dr, front_dc = DIRECTION_TO_DELTA_POS[current_dir]\n      cell_in_front_row, cell_in_front_col = current_row + front_dr, current_col + front_dc\n      \n      # Ensure the cell in front is within grid boundaries\n      if (0 <= cell_in_front_row < GRID_WIDTH and 0 <= cell_in_front_col < GRID_HEIGHT):\n          # Check if the primitive is present in the cell directly in front (indicated by a count > 0)\n          if initial_grid[cell_in_front_row, cell_in_front_col, primitive_id] > 0:\n              shortest_path_to_primitive = current_path_actions\n              break # Shortest path to a 'collectible' position found, terminate BFS.\n\n      # Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right\n      \n      # 1. Try moving forward\n      # Calculate the next position after moving forward\n      move_dr, move_dc = DIRECTION_TO_DELTA_POS[current_dir]\n      next_row, next_col = current_row + move_dr, current_col + move_dc\n      next_position = (next_row, next_col)\n      next_direction_after_move = current_dir # Moving forward does not change facing direction\n\n      # Check validity of the next state:\n      # a. Within grid boundaries\n      # b. This (position, direction) state has not been visited before\n      if (0 <= next_row < GRID_WIDTH and 0 <= next_col < GRID_HEIGHT and\n          (next_position, next_direction_after_move) not in visited_states):\n          \n          # c. Check if the next position is walkable (i.e., it does not contain any blocking entities).\n          # np.any returns True if any of the specified blocking kinds are present at (next_row, next_col).\n          if not np.any(initial_grid[next_row, next_col, non_walkable_kind_ids] > 0):\n              visited_states.add((next_position, next_direction_after_move))\n              bfs_queue.append(((next_position, next_direction_after_move), current_path_actions + [ACTION_MOVE_FORWARD]))\n\n      # 2. Try turning left\n      next_direction_left = TURN_LEFT_NEXT_DIR[current_dir]\n      # Turning changes direction but not position.\n      if ((current_pos, next_direction_left) not in visited_states):\n          visited_states.add((current_pos, next_direction_left))\n          bfs_queue.append(((current_pos, next_direction_left), current_path_actions + [ACTION_TURN_LEFT]))\n\n      # 3. Try turning right\n      next_direction_right = TURN_RIGHT_NEXT_DIR[current_dir]\n      # Turning changes direction but not position.\n      if ((current_pos, next_direction_right) not in visited_states):\n          visited_states.add((current_pos, next_direction_right))\n          bfs_queue.append(((current_pos, next_direction_right), current_path_actions + [ACTION_TURN_RIGHT]))\n\n  # If a path was successfully found to a position where the agent can 'USE' the primitive,\n  # append the 'USE' action to the sequence to complete the collection process.\n  if shortest_path_to_primitive is not None:\n      actions_list.extend(shortest_path_to_primitive)\n      actions_list.append(ACTION_USE)\n\n  return actions_list", "island_id": 2, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T14:17:14.081988", "function_name": "collect", "function_body": "  actions_list = []\n  # Access the current state of the environment through the CraftLab wrapper\n  current_state = env._current_state \n  \n  # Map the string primitive name to its integer ID using the cookbook's index\n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  # Pre-check: Determine if the target primitive is actually collectible (grabbable).\n  # Items like BOUNDARY, WATER, STONE, and WORKSHOPS are fixed environmental features\n  # and cannot be picked up using the 'USE' action. If the primitive is not grabbable,\n  # no collection actions can be performed, so an empty list is returned immediately.\n  if primitive_id not in current_state.world.grabbable_indices:\n      # If the primitive is not something that can be 'picked up', return an empty path.\n      return []\n\n  # Extract initial state information for pathfinding\n  initial_grid = current_state.grid # The current layout of the world\n  initial_agent_pos = current_state.pos # Agent's starting (row, col) position\n  initial_agent_dir = current_state.dir # Agent's starting direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  GRID_WIDTH, GRID_HEIGHT, _ = initial_grid.shape # Get dimensions of the grid\n\n  # Map DSL actions (semantic names) to their corresponding integer indices\n  # as defined by the environment's action_specs.\n  action_specs = env.action_specs()\n  ACTION_MOVE_FORWARD = action_specs['UP']    # In Craft, 'UP' means moving forward relative to agent's direction.\n  ACTION_TURN_LEFT = action_specs['LEFT']\n  ACTION_TURN_RIGHT = action_specs['RIGHT']\n  ACTION_USE = action_specs['USE']\n\n  # Define changes in (row, col) coordinates for movement based on current facing direction.\n  # This mapping simplifies calculating the next position after a 'MOVE_FORWARD' action.\n  # (dr, dc) = (delta_row, delta_column)\n  DIRECTION_TO_DELTA_POS = {\n      0: (0, 1),   # Facing RIGHT (0): moving forward increases column (col + 1)\n      1: (-1, 0),  # Facing UP (1): moving forward decreases row (row - 1)\n      2: (0, -1),  # Facing LEFT (2): moving forward decreases column (col - 1)\n      3: (1, 0)    # Facing DOWN (3): moving forward increases row (row + 1)\n  }\n\n  # Define how the agent's direction changes when turning left or right.\n  # These are cyclical mappings (0->1->2->3->0 for left, 0->3->2->1->0 for right).\n  TURN_LEFT_NEXT_DIR = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_NEXT_DIR = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Identify all grid entity indices that block agent movement.\n  # This set includes non-grabbable items (e.g., boundaries, water, workshops)\n  # and crucially, the target `primitive_id` itself. The agent cannot move onto\n  # a square containing the item it intends to 'USE'; it must be adjacent to it.\n  # We convert to a list for efficient NumPy advanced indexing later.\n  non_walkable_kind_ids = list(current_state.world.non_grabbable_indices.union({primitive_id}))\n\n  # Breadth-First Search (BFS) for the shortest path to a collectible state.\n  # The BFS queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_here)\n  bfs_queue = collections.deque([((initial_agent_pos, initial_agent_dir), [])])\n  \n  # The visited set stores (position_tuple, direction_int) to prevent\n  # redundant exploration and infinite loops (cycles) in the search.\n  visited_states = {(initial_agent_pos, initial_agent_dir)}\n\n  # Variable to store the action sequence once the target state\n  # (agent is adjacent to and facing the primitive) is found.\n  shortest_path_to_primitive = None \n\n  while bfs_queue:\n      (current_pos, current_dir), current_path_actions = bfs_queue.popleft()\n      current_row, current_col = current_pos\n\n      # Check if the agent is currently positioned to 'USE' the primitive:\n      # This means the primitive must be in the cell directly in front of the agent.\n      front_dr, front_dc = DIRECTION_TO_DELTA_POS[current_dir]\n      cell_in_front_row, cell_in_front_col = current_row + front_dr, current_col + front_dc\n      \n      # Ensure the cell in front is within grid boundaries\n      if (0 <= cell_in_front_row < GRID_WIDTH and 0 <= cell_in_front_col < GRID_HEIGHT):\n          # Check if the primitive is present in the cell directly in front (indicated by a count > 0)\n          if initial_grid[cell_in_front_row, cell_in_front_col, primitive_id] > 0:\n              shortest_path_to_primitive = current_path_actions\n              break # Shortest path to a 'collectible' position found, terminate BFS.\n\n      # Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right\n      \n      # 1. Try moving forward\n      # Calculate the next position after moving forward\n      move_dr, move_dc = DIRECTION_TO_DELTA_POS[current_dir]\n      next_row, next_col = current_row + move_dr, current_col + move_dc\n      next_position = (next_row, next_col)\n      next_direction_after_move = current_dir # Moving forward does not change facing direction\n\n      # Check validity of the next state:\n      # a. Within grid boundaries\n      # b. This (position, direction) state has not been visited before\n      if (0 <= next_row < GRID_WIDTH and 0 <= next_col < GRID_HEIGHT and\n          (next_position, next_direction_after_move) not in visited_states):\n          \n          # c. Check if the next position is walkable (i.e., it does not contain any blocking entities).\n          # np.any returns True if any of the specified blocking kinds are present at (next_row, next_col).\n          if not np.any(initial_grid[next_row, next_col, non_walkable_kind_ids] > 0):\n              visited_states.add((next_position, next_direction_after_move))\n              bfs_queue.append(((next_position, next_direction_after_move), current_path_actions + [ACTION_MOVE_FORWARD]))\n\n      # 2. Try turning left\n      next_direction_left = TURN_LEFT_NEXT_DIR[current_dir]\n      # Turning changes direction but not position.\n      if ((current_pos, next_direction_left) not in visited_states):\n          visited_states.add((current_pos, next_direction_left))\n          bfs_queue.append(((current_pos, next_direction_left), current_path_actions + [ACTION_TURN_LEFT]))\n\n      # 3. Try turning right\n      next_direction_right = TURN_RIGHT_NEXT_DIR[current_dir]\n      # Turning changes direction but not position.\n      if ((current_pos, next_direction_right) not in visited_states):\n          visited_states.add((current_pos, next_direction_right))\n          bfs_queue.append(((current_pos, next_direction_right), current_path_actions + [ACTION_TURN_RIGHT]))\n\n  # If a path was successfully found to a position where the agent can 'USE' the primitive,\n  # append the 'USE' action to the sequence to complete the collection process.\n  if shortest_path_to_primitive is not None:\n      actions_list.extend(shortest_path_to_primitive)\n      actions_list.append(ACTION_USE)\n\n  return actions_list", "island_id": 2, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T14:18:07.852982", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` with enhanced clarity and comments.\"\"\"\n  actions_to_take = [] # This list will store the sequence of actions to be returned.\n\n  # Get the current state of the environment.\n  # This provides the current grid, agent's position, and agent's direction.\n  current_state: env.CraftState = env._current_state \n  game_grid: np.ndarray = current_state.grid  # The 3D grid: (rows, columns, kinds)\n  agent_position: tuple[int, int] = current_state.pos  # Agent's (row, col) coordinates\n  agent_direction: int = current_state.dir  # Agent's facing direction (0:R, 1:U, 2:L, 3:D)\n\n  # Get the unique integer ID for the target primitive from the cookbook's index.\n  # The grid uses these integer IDs to represent different kinds of entities.\n  target_primitive_id: int = current_state.world.cookbook.index[primitive]\n  \n  # Determine grid dimensions for boundary checks during pathfinding.\n  grid_rows, grid_cols, _ = game_grid.shape\n\n  # Map human-readable action names to their corresponding integer codes as defined by the environment.\n  action_codes: dict[str, int] = env.action_specs()\n  ACTION_MOVE_FORWARD: int = action_codes['UP']    # 'UP' action moves the agent forward in its current direction.\n  ACTION_TURN_LEFT: int = action_codes['LEFT']     # Turns the agent 90 degrees left.\n  ACTION_TURN_RIGHT: int = action_codes['RIGHT']   # Turns the agent 90 degrees right.\n  ACTION_USE: int = action_codes['USE']            # Interacts with the cell directly in front of the agent.\n\n  # Define how row and column coordinates change for each facing direction (0:R, 1:U, 2:L, 3:D).\n  # These are relative changes: (delta_row, delta_col).\n  DIRECTION_TO_DELTA: dict[int, tuple[int, int]] = {\n      0: (0, 1),   # RIGHT: (row, col + 1)\n      1: (-1, 0),  # UP: (row - 1, col)\n      2: (0, -1),  # LEFT: (row, col - 1)\n      3: (1, 0)    # DOWN: (row + 1, col)\n  }\n\n  # Define how the agent's direction changes when turning left or right.\n  # These are mappings from current_direction to new_direction.\n  TURN_LEFT_MAP: dict[int, int] = {0: 1, 1: 2, 2: 3, 3: 0}   # Cycles 0->1->2->3->0\n  TURN_RIGHT_MAP: dict[int, int] = {0: 3, 1: 0, 2: 1, 3: 2} # Cycles 0->3->2->1->0\n\n  # Identify entity kinds that the agent cannot walk onto.\n  # These include environment obstacles (like walls, water, workshops) as well as the\n  # target primitive itself (agent must stand *adjacent* to it, not on it, to 'USE' it).\n  # Convert the set of indices to a numpy array for efficient lookup in the grid.\n  non_walkable_kind_ids: np.ndarray = np.array(list(current_state.world.non_grabbable_indices) + [target_primitive_id])\n\n  # Helper function to check if a given grid coordinate (r, c) is within the grid boundaries.\n  def is_in_bounds(r: int, c: int) -> bool:\n      return 0 <= r < grid_rows and 0 <= c < grid_cols\n\n  # Helper function to determine if the agent can move onto a specific cell (r, c).\n  # A cell is considered NOT walkable if:\n  # 1. It is outside the grid boundaries.\n  # 2. It contains the target primitive (agent cannot walk onto the item it needs to 'USE').\n  # 3. It contains any other non-grabbable (environmental) obstacle.\n  def is_cell_walkable(r: int, c: int) -> bool:\n      if not is_in_bounds(r, c):\n          return False\n      \n      # Check if the cell at (r, c) contains any of the non-walkable kinds.\n      # `np.any` efficiently checks if any specified index in the slice `game_grid[r, c, ...]` has a value > 0.\n      # It's important to check `non_walkable_kind_ids.size > 0` to prevent errors if the array is empty.\n      if non_walkable_kind_ids.size > 0 and np.any(game_grid[r, c, non_walkable_kind_ids] > 0):\n          return False\n          \n      return True\n\n  # BFS Initialization:\n  # The queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_here)\n  # The state includes both position and direction because movement and the 'USE' action are direction-dependent.\n  search_queue: collections.deque[tuple[tuple[tuple[int, int], int], list[int]]] = collections.deque([((agent_position, agent_direction), [])])\n  \n  # The visited set stores (position_tuple, direction_int) pairs to prevent cycles\n  # and redundant exploration, ensuring the shortest path is found (BFS property).\n  visited_states: set[tuple[tuple[int, int], int]] = {(agent_position, agent_direction)}\n\n  # This variable will store the path found to reach a state where the agent is\n  # adjacent to and facing the primitive.\n  path_to_adjacent_primitive: list[int] | None = None \n\n  # Start the Breadth-First Search\n  while search_queue:\n      (current_pos, current_dir), path_so_far = search_queue.popleft()\n      current_r, current_c = current_pos\n\n      # 1. Goal Check: Is the target primitive directly in front of the agent?\n      # If it is, we've found the path to get into position to 'USE' it.\n      dr_front, dc_front = DIRECTION_TO_DELTA[current_dir]\n      front_cell_r, front_cell_c = current_r + dr_front, current_c + dc_front\n      \n      if is_in_bounds(front_cell_r, front_cell_c) and game_grid[front_cell_r, front_cell_c, target_primitive_id] > 0:\n          path_to_adjacent_primitive = path_so_far\n          break # Path found, exit the BFS loop.\n\n      # 2. Explore possible next actions from the current state (position + direction).\n      # These actions generate new agent states (new position and/or new direction).\n\n      # --- Option A: Try to Move Forward ---\n      dr_move, dc_move = DIRECTION_TO_DELTA[current_dir]\n      next_r_move, next_c_move = current_r + dr_move, current_c + dc_move\n      next_pos_move: tuple[int, int] = (next_r_move, next_c_move)\n      next_dir_move: int = current_dir # Moving forward does not change facing direction.\n\n      # Check if the intended next cell is walkable and if this exact (position, direction) state\n      # has not been visited before to avoid redundant paths and infinite loops.\n      if is_cell_walkable(next_r_move, next_c_move) and (next_pos_move, next_dir_move) not in visited_states:\n          visited_states.add((next_pos_move, next_dir_move)) # Mark the new state as visited.\n          # Add the new state to the queue along with the accumulated path.\n          search_queue.append(((next_pos_move, next_dir_move), path_so_far + [ACTION_MOVE_FORWARD]))\n\n      # --- Option B: Try to Turn Left ---\n      next_dir_left: int = TURN_LEFT_MAP[current_dir] # Calculate the new direction after turning.\n      # Turning changes only direction, not position.\n      if (current_pos, next_dir_left) not in visited_states:\n          visited_states.add((current_pos, next_dir_left)) # Mark the new state as visited.\n          search_queue.append(((current_pos, next_dir_left), path_so_far + [ACTION_TURN_LEFT]))\n\n      # --- Option C: Try to Turn Right ---\n      next_dir_right: int = TURN_RIGHT_MAP[current_dir] # Calculate the new direction after turning.\n      # Turning changes only direction, not position.\n      if (current_pos, next_dir_right) not in visited_states:\n          visited_states.add((current_pos, next_dir_right)) # Mark the new state as visited.\n          search_queue.append(((current_pos, next_dir_right), path_so_far + [ACTION_TURN_RIGHT]))\n\n  # After the BFS search completes (either the target is found or the queue is empty):\n  # If a path to an adjacent and facing state was found, append the 'USE' action to complete the collection.\n  if path_to_adjacent_primitive is not None:\n      actions_to_take.extend(path_to_adjacent_primitive)\n      actions_to_take.append(ACTION_USE)\n\n  return actions_to_take", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T14:18:09.019950", "function_name": "collect", "function_body": "  actions_to_take = []\n  current_state = env._current_state\n  grid = current_state.grid\n  agent_pos = current_state.pos\n  agent_dir = current_state.dir\n\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  num_rows, num_cols, _ = grid.shape\n\n  action_codes = env.action_specs()\n  ACTION_MOVE_FORWARD = action_codes['UP']\n  ACTION_TURN_LEFT = action_codes['LEFT']\n  ACTION_TURN_RIGHT = action_codes['RIGHT']\n  ACTION_USE = action_codes['USE']\n\n  # Direction vectors (dr, dc) mapping agent's facing direction to grid coordinate changes.\n  # Mapping: 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n  DIRECTION_DELTAS = {\n      0: (0, 1),   # RIGHT: (row, col + 1)\n      1: (-1, 0),  # UP: (row - 1, col)\n      2: (0, -1),  # LEFT: (row, col - 1)\n      3: (1, 0)    # DOWN: (row + 1, col)\n  }\n\n  # Mapping for updating agent's direction when turning.\n  TURN_LEFT_NEW_DIR = {0: 1, 1: 2, 2: 3, 3: 0}  # Cycle: R -> U -> L -> D -> R\n  TURN_RIGHT_NEW_DIR = {0: 3, 1: 0, 2: 1, 3: 2} # Cycle: R -> D -> L -> U -> R\n\n  # Define all entity kinds that block agent movement onto a cell.\n  # This includes non-grabbable entities (e.g., walls, water, workshops)\n  # AND the primitive itself, as the agent needs to be *adjacent* to it to 'USE' it,\n  # not stand on top of it.\n  blocking_movement_kinds = current_state.world.non_grabbable_indices.copy()\n  blocking_movement_kinds.add(primitive_id)\n  blocking_movement_kinds_np = np.array(list(blocking_movement_kinds), dtype=int)\n\n\n  def _is_in_bounds(r: int, c: int) -> bool:\n      \"\"\"Checks if a given grid cell (r, c) is within the grid boundaries.\"\"\"\n      return 0 <= r < num_rows and 0 <= c < num_cols\n\n  def _is_cell_walkable(r: int, c: int) -> bool:\n      \"\"\"Determines if the agent can move onto the cell (r, c).\"\"\"\n      if not _is_in_bounds(r, c):\n          return False\n      \n      # A cell is not walkable if it contains any of the defined blocking kinds.\n      # `np.any` efficiently checks if any of the specified indices in the grid slice are positive.\n      if blocking_movement_kinds_np.size > 0 and np.any(grid[r, c, blocking_movement_kinds_np] > 0):\n          return False\n          \n      return True\n\n  # BFS Initialization:\n  # The queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_here)\n  # A state is defined by both position and orientation because 'USE' is direction-dependent,\n  # and movement is relative to current direction.\n  queue = collections.deque([((agent_pos, agent_dir), [])])\n  \n  # The visited set stores (position_tuple, direction_int) to prevent redundant computations,\n  # cycles, and ensure finding the shortest path (BFS guarantees this for unweighted graphs).\n  visited_states = {(agent_pos, agent_dir)}\n\n  path_to_primitive_adjacency = None # Stores the action sequence to get adjacent and facing the primitive.\n\n  # Start the Breadth-First Search\n  while queue:\n      (current_pos, current_dir), path_history = queue.popleft()\n      current_r, current_c = current_pos\n\n      # 1. Goal Check: Is the primitive directly in front of the agent from the current state?\n      # If so, we have found the sequence of movement actions to set up for the 'USE' action.\n      dr_front, dc_front = DIRECTION_DELTAS[current_dir]\n      front_r, front_c = current_r + dr_front, current_c + dc_front\n      \n      # Ensure the cell in front is within grid boundaries before checking its contents.\n      if _is_in_bounds(front_r, front_c) and grid[front_r, front_c, primitive_id] > 0:\n          path_to_primitive_adjacency = path_history\n          break # Target state found, exit BFS.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n      # These actions generate new agent states (position and/or direction).\n\n      # --- Try Move Forward action ---\n      dr_move, dc_move = DIRECTION_DELTAS[current_dir]\n      next_r_move, next_c_move = current_r + dr_move, current_c + dc_move\n      next_pos_move = (next_r_move, next_c_move)\n      next_dir_move = current_dir # Moving forward does not change facing direction\n\n      # Check if the potential next position is valid (walkable) and if this specific\n      # (position, direction) state has not been visited yet.\n      if _is_cell_walkable(next_r_move, next_c_move) and (next_pos_move, next_dir_move) not in visited_states:\n          visited_states.add((next_pos_move, next_dir_move)) # Mark new state as visited\n          # Add to queue with the updated path, including the ACTION_MOVE_FORWARD.\n          queue.append(((next_pos_move, next_dir_move), path_history + [ACTION_MOVE_FORWARD]))\n\n      # --- Try Turn Left action ---\n      next_dir_left = TURN_LEFT_NEW_DIR[current_dir] # Calculate new direction after turning left\n      # Turning only changes direction, not position.\n      if (current_pos, next_dir_left) not in visited_states:\n          visited_states.add((current_pos, next_dir_left)) # Mark new state as visited\n          # Add to queue with updated path, including the ACTION_TURN_LEFT.\n          queue.append(((current_pos, next_dir_left), path_history + [ACTION_TURN_LEFT]))\n\n      # --- Try Turn Right action ---\n      next_dir_right = TURN_RIGHT_NEW_DIR[current_dir] # Calculate new direction after turning right\n      # Turning only changes direction, not position.\n      if (current_pos, next_dir_right) not in visited_states:\n          visited_states.add((current_pos, next_dir_right)) # Mark new state as visited\n          # Add to queue with updated path, including the ACTION_TURN_RIGHT.\n          queue.append(((current_pos, next_dir_right), path_history + [ACTION_TURN_RIGHT]))\n\n  # After BFS completes (either target found or queue empty):\n  # If a path to the target adjacency state was found, append the 'USE' action to complete the collection.\n  if path_to_primitive_adjacency is not None:\n      actions_to_take.extend(path_to_primitive_adjacency)\n      actions_to_take.append(ACTION_USE)\n\n  return actions_to_take", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T14:19:15.616453", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set includes the agent's inventory as part of the state key.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing, allowing BFS to distinguish\n  # between states that are identical in position/direction but differ in inventory.\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Maximum number of unique states to explore. This limits excessive computation.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states,\n    # terminate the search immediately and return an empty path,\n    # indicating no path was found within the allowed computational budget.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      return [] # Hard limit: search failed within budget\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check Priority 1: Can we collect the primitive right where we are, without turning?\n    # This primarily applies to grabbable items located on the agent's current cell.\n    if i_kind in world.grabbable_indices and state.grid[current_r, current_c, i_kind] == 1:\n        inventory_before_immediate_use = np.copy(state.inventory)\n        _, state_after_immediate_use = state.step(USE_ACT)\n        if state_after_immediate_use.inventory[i_kind] > inventory_before_immediate_use[i_kind]:\n            return path + [USE_ACT] # Collected immediately!\n\n    # Goal Check Priority 2: Can we collect the primitive in an adjacent cell by facing it?\n    # This covers resources like water, stone, or grabbable items on adjacent cells\n    # that typically require facing.\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_facing_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_facing_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`.\n                if state_after_facing_use.inventory[i_kind] > inventory_before_facing_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the USE action from the current position if it results in a meaningful state change.\n    # This is important if using an item at the current position (e.g., picking up a tool like an axe)\n    # can change the inventory state, which might be necessary for later steps to collect the primitive.\n    inventory_before_any_use_exploration = np.copy(state.inventory)\n    _, state_after_current_use_exploration = state.step(USE_ACT)\n    \n    # Check if the USE action resulted in a meaningful state change (inventory, position, or direction).\n    # This prevents adding redundant states to the queue if USE had no effect.\n    if not (np.array_equal(state_after_current_use_exploration.inventory, inventory_before_any_use_exploration) and\n            state_after_current_use_exploration.pos == state.pos and\n            state_after_current_use_exploration.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use_exploration.inventory)\n        next_state_key = (state_after_current_use_exploration.pos[0], state_after_current_use_exploration.pos[1], state_after_current_use_exploration.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use_exploration, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 4, "scores": {"3": 1.5}}
