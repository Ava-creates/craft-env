{"timestamp": "2025-08-01T13:01:35.741748", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  # OPTIMIZATION for v2: Pre-convert `world.grabbable_indices` to a set for faster lookup.\n  grabbable_indices_set = set(world.grabbable_indices)\n  is_collectible_via_use = (\n      i_kind in grabbable_indices_set or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set stores a tuple representing (row, col, direction, inventory_tuple).\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing.\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # MAX_EXPLORED_STATES is a pragmatic limit to prevent extremely long searches.\n  # The multiplier '10' accounts for different relevant inventory states that might\n  # be reached (e.g., picking up a tool) during the search for the primitive.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # OPTIMIZATION for v2: Pre-convert `world.workshop_indices`\n  # to sets for faster `O(1)` average time lookups during the BFS loop.\n  workshop_indices_set = set(world.workshop_indices)\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, skip processing this state.\n    # This acts as a soft limit, allowing states already in the queue to be processed,\n    # but prevents the search from expanding indefinitely from very long paths.\n    if explored_states_count > MAX_EXPLORED_STATES:\n        continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`).\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Ensure the facing cell is within grid bounds and contains the target primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                temp_state_after_turns = state \n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                for turn_action in turns_to_face:\n                    # Reward is always 0.0 in this implementation, so we use `_`.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                # Reward is always 0.0 in this implementation, so we use `_`.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed, resource depletion) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      # Reward is always 0.0, so we use `_`.\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # OPTIMIZATION for v2: More efficiently check if a 'USE' action is worth exploring.\n    # A USE action is considered potentially useful if the agent is next to any grabbable item\n    # (which could be a tool or resource) OR if the agent is currently on a workshop.\n    \n    found_any_grabbable_next_to = False\n    # Check 3x3 neighborhood for any grabbable item (excluding current cell for 'next_to' semantic).\n    # This avoids repeated calls to `state.next_to` for each grabbable_index,\n    # improving efficiency when there are many grabbable types.\n    for r_offset in [-1, 0, 1]:\n        for c_offset in [-1, 0, 1]:\n            nr, nc = current_r + r_offset, current_c + c_offset\n            # Ensure cell is within grid bounds and is not the agent's current position (itself).\n            if (0 <= nr < grid_width and 0 <= nc < grid_height and \n                (nr, nc) != (current_r, current_c)): \n                # Check if *any* grabbable item is present at this (nr, nc) location.\n                for grabbable_idx in grabbable_indices_set: # Use the pre-converted set for O(1) average lookup\n                    if state.grid[nr, nc, grabbable_idx] == 1:\n                        found_any_grabbable_next_to = True\n                        break # Found one grabbable in this cell, no need to check others for this cell\n            if found_any_grabbable_next_to:\n                break # Found a grabbable in the neighborhood, no need to check other cells\n        if found_any_grabbable_next_to:\n            break # Found a grabbable in the neighborhood, no need to check other rows\n\n    # Check if agent is currently on a workshop cell.\n    is_on_workshop = any(state.grid[current_r, current_c, idx] == 1 for idx in workshop_indices_set) # Use the pre-converted set\n\n    if found_any_grabbable_next_to or is_on_workshop:\n        inventory_before_any_use = np.copy(state.inventory)\n        # Reward is always 0.0, so we use `_`.\n        _, state_after_current_use = state.step(USE_ACT)\n        \n        # Only add to queue if the USE action resulted in a meaningful state change\n        # (inventory, position, or direction changed). This prevents exploring redundant states.\n        if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n                state_after_current_use.pos == state.pos and\n                state_after_current_use.dir == state.dir):\n\n            next_inventory_tuple = tuple(state_after_current_use.inventory)\n            next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n            if next_state_key not in visited:\n                visited.add(next_state_key)\n                q.append((state_after_current_use, path + [USE_ACT]))\n\n  # If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T13:02:17.578378", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state # Access the internal CraftState instance\n\n  # Extract key information from the current state\n  grid = current_state.grid # The grid representing the world layout (WIDTH, HEIGHT, n_kinds)\n  initial_pos = current_state.pos # Agent's starting (row, col) tuple\n  initial_dir = current_state.dir # Agent's starting direction (0:Right, 1:Up, 2:Left, 3:Down)\n\n  # Get the integer ID for the target primitive from the cookbook's index\n  try:\n    primitive_id = current_state.world.cookbook.index[primitive]\n  except KeyError:\n    # Primitive not found in cookbook, cannot collect.\n    return []\n  \n  # Get grid dimensions for boundary checks\n  GRID_WIDTH, GRID_HEIGHT, _ = grid.shape\n\n  # Map action names to their integer indices using the environment's action_specs\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # Assuming 'UP' means move forward in current direction\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']            # Action to collect the item\n\n  # Define how agent's position changes when moving forward based on its current direction.\n  # (delta_row, delta_col) for each direction index.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT (0): (row, col + 1)\n      1: (-1, 0),  # Facing UP (1):    (row - 1, col)\n      2: (0, -1),  # Facing LEFT (2):  (row, col - 1)\n      3: (1, 0)    # Facing DOWN (3):  (row + 1, col)\n  }\n\n  # Define how agent's direction changes when turning left or right.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}   # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}  # Right -> Down -> Left -> Up -> Right\n\n  # Identify all entity kinds that the agent cannot walk onto.\n  # This includes general non-grabbable items (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  # AND the primitive itself, as the agent needs to stop *adjacent* to it, not on it, to USE.\n  unwalkable_kind_ids = set(current_state.world.non_grabbable_indices)\n  unwalkable_kind_ids.add(primitive_id) # Cannot walk *onto* the primitive we want to collect.\n\n  # --- Optimization for v2: Early exit if the primitive is already directly in front and ready for USE ---\n  r_init, c_init = initial_pos\n  front_dr_init, front_dc_init = DIR_TO_DRDC[initial_dir]\n  front_r_init, front_c_init = r_init + front_dr_init, c_init + front_dc_init\n  \n  # Check if the cell directly in front is within grid bounds and contains the primitive\n  if (0 <= front_r_init < GRID_WIDTH and 0 <= front_c_init < GRID_HEIGHT and\n      grid[front_r_init, front_c_init, primitive_id] > 0):\n      return [USE_ACTION]\n  # --- End of Optimization ---\n\n  # BFS setup:\n  # Queue stores elements: ((current_pos_tuple, current_dir_int), list_of_actions_to_reach_here)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # Visited set stores (position, direction) pairs to avoid redundant exploration and cycles.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # Will store the sequence of actions once the target state is found\n\n  # Start Breadth-First Search\n  while queue:\n      (current_pos_tuple, current_dir_int), path_actions = queue.popleft()\n      r, c = current_pos_tuple\n\n      # 1. Goal Check: Is the target primitive directly in front of the agent in this state?\n      # Calculate coordinates of the cell directly in front of the agent\n      front_dr, front_dc = DIR_TO_DRDC[current_dir_int]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the front cell is within grid boundaries\n      if (0 <= front_r < GRID_WIDTH and 0 <= front_c < GRID_HEIGHT):\n          # Check if the front cell contains the primitive. If it does, we've found our target state.\n          if grid[front_r, front_c, primitive_id] > 0:\n              target_path_actions = path_actions # Store the path to this state\n              break # Exit BFS, as we found the shortest path to be adjacent and facing.\n\n      # 2. Explore possible next actions: Move Forward, Turn Left, Turn Right\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir_int]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos_tuple = (next_r, next_c)\n      next_dir_int = current_dir_int # Moving forward does not change facing direction\n\n      # Check if the next position is within bounds and this (pos, dir) state hasn't been visited.\n      if (0 <= next_r < GRID_WIDTH and 0 <= next_c < GRID_HEIGHT and\n          (next_pos_tuple, next_dir_int) not in visited):\n          \n          # Check if the next position is walkable (i.e., doesn't contain any unwalkable kind).\n          is_walkable = True\n          for kind_idx in unwalkable_kind_ids:\n              if grid[next_r, next_c, kind_idx] > 0: # If the cell contains an unwalkable kind\n                  is_walkable = False\n                  break\n          \n          if is_walkable:\n              visited.add((next_pos_tuple, next_dir_int))\n              queue.append(((next_pos_tuple, next_dir_int), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir_int]\n      # Turning only changes direction, not position.\n      if ((current_pos_tuple, next_dir_left) not in visited):\n          visited.add((current_pos_tuple, next_dir_left))\n          queue.append(((current_pos_tuple, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir_int]\n      # Turning only changes direction, not position.\n      if ((current_pos_tuple, next_dir_right) not in visited):\n          visited.add((current_pos_tuple, next_dir_right))\n          queue.append(((current_pos_tuple, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path to the adjacent-and-facing state was found, append the USE action.\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T13:02:18.711169", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n  Finds the shortest path to a primitive, positions the agent adjacent and facing it,\n  then returns the sequence of actions to collect it. Uses Breadth-First Search (BFS).\n\n  Args:\n      env (env.CraftLab): The CraftLab environment object.\n      primitive (str): The name of the primitive resource to collect (e.g., \"WOOD\", \"STONE\").\n\n  Returns:\n      List[int]: A sequence of integer action codes (e.g., UP, LEFT, USE) to execute.\n                 Returns an empty list if the primitive is unreachable or not found.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state # Access the internal CraftState instance\n\n  # Extract key information from the current state\n  grid = current_state.grid # The grid representing the world layout (WIDTH, HEIGHT, n_kinds)\n  initial_pos = current_state.pos # Agent's starting (row, col) tuple\n  initial_dir = current_state.dir # Agent's starting direction (0:Right, 1:Up, 2:Left, 3:Down)\n\n  # Get the integer ID for the target primitive from the cookbook's index\n  try:\n    primitive_id = current_state.world.cookbook.index[primitive]\n  except KeyError:\n    # Primitive not found in cookbook, cannot collect.\n    return []\n  \n  # Get grid dimensions for boundary checks\n  GRID_WIDTH, GRID_HEIGHT, _ = grid.shape\n\n  # Map action names to their integer indices using the environment's action_specs\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # Assuming 'UP' means move forward in current direction\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']            # Action to collect the item\n\n  # Define how agent's position changes when moving forward based on its current direction.\n  # (delta_row, delta_col) for each direction index.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT (0): (row, col + 1)\n      1: (-1, 0),  # Facing UP (1):    (row - 1, col)\n      2: (0, -1),  # Facing LEFT (2):  (row, col - 1)\n      3: (1, 0)    # Facing DOWN (3):  (row + 1, col)\n  }\n\n  # Define how agent's direction changes when turning left or right.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}   # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}  # Right -> Down -> Left -> Up -> Right\n\n  # Identify all entity kinds that the agent cannot walk onto.\n  # This includes general non-grabbable items (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  # AND the primitive itself, as the agent needs to stop *adjacent* to it, not on it, to USE.\n  unwalkable_kind_ids = set(current_state.world.non_grabbable_indices)\n  unwalkable_kind_ids.add(primitive_id) # Cannot walk *onto* the primitive we want to collect.\n\n  # --- Optimization for v2: Early exit if the primitive is already directly in front and ready for USE ---\n  r_init, c_init = initial_pos\n  front_dr_init, front_dc_init = DIR_TO_DRDC[initial_dir]\n  front_r_init, front_c_init = r_init + front_dr_init, c_init + front_dc_init\n  \n  # Check if the cell directly in front is within grid bounds and contains the primitive\n  if (0 <= front_r_init < GRID_WIDTH and 0 <= front_c_init < GRID_HEIGHT and\n      grid[front_r_init, front_c_init, primitive_id] > 0):\n      return [USE_ACTION]\n  # --- End of Optimization ---\n\n  # BFS setup:\n  # Queue stores elements: ((current_pos_tuple, current_dir_int), list_of_actions_to_reach_here)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # Visited set stores (position, direction) pairs to avoid redundant exploration and cycles.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # Will store the sequence of actions once the target state is found\n\n  # Start Breadth-First Search\n  while queue:\n      (current_pos_tuple, current_dir_int), path_actions = queue.popleft()\n      r, c = current_pos_tuple\n\n      # 1. Goal Check: Is the target primitive directly in front of the agent in this state?\n      # Calculate coordinates of the cell directly in front of the agent\n      front_dr, front_dc = DIR_TO_DRDC[current_dir_int]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the front cell is within grid boundaries\n      if (0 <= front_r < GRID_WIDTH and 0 <= front_c < GRID_HEIGHT):\n          # Check if the front cell contains the primitive. If it does, we've found our target state.\n          # Note: The early exit handles the initial state where this check is trivial.\n          if grid[front_r, front_c, primitive_id] > 0:\n              target_path_actions = path_actions # Store the path to this state\n              break # Exit BFS, as we found the shortest path to be adjacent and facing.\n\n      # 2. Explore possible next actions: Move Forward, Turn Left, Turn Right\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir_int]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos_tuple = (next_r, next_c)\n      next_dir_int = current_dir_int # Moving forward does not change facing direction\n\n      # Check if the next position is within bounds and this (pos, dir) state hasn't been visited.\n      if (0 <= next_r < GRID_WIDTH and 0 <= next_c < GRID_HEIGHT and\n          (next_pos_tuple, next_dir_int) not in visited):\n          \n          # Check if the next position is walkable (i.e., doesn't contain any unwalkable kind).\n          is_walkable = True\n          for kind_idx in unwalkable_kind_ids:\n              if grid[next_r, next_c, kind_idx] > 0: # If the cell contains an unwalkable kind\n                  is_walkable = False\n                  break\n          \n          if is_walkable:\n              visited.add((next_pos_tuple, next_dir_int))\n              queue.append(((next_pos_tuple, next_dir_int), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir_int]\n      # Turning only changes direction, not position.\n      if ((current_pos_tuple, next_dir_left) not in visited):\n          visited.add((current_pos_tuple, next_dir_left))\n          queue.append(((current_pos_tuple, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir_int]\n      # Turning only changes direction, not position.\n      if ((current_pos_tuple, next_dir_right) not in visited):\n          visited.add((current_pos_tuple, next_dir_right))\n          queue.append(((current_pos_tuple, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path to the adjacent-and-facing state was found, append the USE action.\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T13:04:23.937720", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Semantic check: Determine if this primitive is *actually* collectible into inventory.\n  # This includes items defined as primitives, special environment items like water/stone,\n  # and any other items explicitly marked as grabbable.\n  is_primitive_resource = i_kind in world.cookbook.primitives\n  is_special_collectible_environment = (i_kind == world.water_index or i_kind == world.stone_index)\n  is_grabbable = i_kind in world.grabbable_indices\n\n  if not (is_primitive_resource or is_special_collectible_environment or is_grabbable):\n      # The requested primitive is not collectible.\n      return []\n\n  # 3. Check if the primitive is already in the agent's inventory.\n  if current_state.inventory[i_kind] > 0:\n      # Primitive is already collected, no actions needed.\n      return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row decreases, col stays same\n      1: (0, 1),  # RIGHT: row stays same, col increases\n      2: (1, 0),  # DOWN: row increases, col stays same\n      3: (0, -1)  # LEFT: row stays same, col decreases\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return []\n      # Calculate difference ensuring it's positive and within [0, 3]\n      diff = (target_dir - current_dir + 4) % 4\n      if diff == 1:\n          return [RIGHT_ACT] # One right turn\n      elif diff == 3:\n          return [LEFT_ACT]  # One left turn\n      else: # diff == 2 (180-degree turn)\n          return [RIGHT_ACT, RIGHT_ACT] # Two right turns (or two left turns)\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The visited set must capture the full state to prevent redundant exploration.\n  # State key: (grid_hash, row, col, direction, inventory_tuple)\n  visited = set() \n\n  initial_inventory_tuple = tuple(current_state.inventory)\n  # Hash the grid to include its state in the visited key.\n  # .tobytes() converts the numpy array to a bytes object, which is hashable.\n  initial_grid_hash = hash(current_state.grid.tobytes()) \n\n  initial_state_key = (initial_grid_hash, current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple)\n\n  q.append((current_state, [])) # Queue stores (CraftState object, path_to_reach_this_state)\n  visited.add(initial_state_key)\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Set a heuristic upper bound for the number of *unique* states to store in the 'visited' set.\n  # This is a practical safeguard to prevent excessively long searches on very large or complex maps\n  # by limiting the total unique states explored. The multiplier (150) allows for some depth\n  # and inventory variations.\n  MAX_UNIQUE_STATES_TO_VISIT = grid_width * grid_height * 4 * 150 \n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft()\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n\n    # List to store (next_state_object, actions_to_reach_next_state, inventory_before_last_action_applied)\n    # Storing 'inventory_before_last_action_applied' is crucial for checking if the goal item\n    # was *specifically* acquired in the last step of a transition.\n    potential_next_transitions = []\n\n    # --- Generate all potential next states from the current state ---\n\n    # 1. Explore Movement Actions (UP, DOWN, LEFT, RIGHT)\n    for action in move_actions:\n        _, next_state = state.step(action)\n        # For movement, the 'inventory_before_action' is simply the current state's inventory.\n        potential_next_transitions.append((next_state, path + [action], np.copy(state.inventory)))\n\n    # 2. Explore USE_ACT at current position\n    # This handles collecting items directly from the cell the agent is standing on (e.g., grabbable items).\n    inventory_before_use_at_pos = np.copy(state.inventory)\n    grid_before_use_at_pos = np.copy(state.grid) # Capture grid state before USE\n    _, state_after_use_at_pos = state.step(USE_ACT)\n    \n    # Only consider this transition if the USE_ACT actually resulted in a state change\n    # (e.g., inventory changed, or grid changed, or position/direction changed - though USE typically only changes inventory/grid).\n    state_changed_by_use_at_pos = not (\n        np.array_equal(state_after_use_at_pos.inventory, inventory_before_use_at_pos) and\n        state_after_use_at_pos.pos == state.pos and\n        state_after_use_at_pos.dir == state.dir and\n        np.array_equal(state_after_use_at_pos.grid, grid_before_use_at_pos) # Crucial to compare grid\n    )\n    if state_changed_by_use_at_pos:\n        potential_next_transitions.append((state_after_use_at_pos, path + [USE_ACT], inventory_before_use_at_pos))\n    \n    # 3. Explore USE_ACT on adjacent cells (after turning to face them)\n    # This handles interacting with items/structures in the surrounding environment (e.g., chopping trees, mining rocks).\n    for target_dir in range(4): # Iterate through all four possible facing directions\n        dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n        facing_r, facing_c = current_r + dr, current_c + dc\n\n        # Check if the facing cell is within grid bounds and contains *any* entity.\n        # This broad check allows interaction with any relevant environmental object\n        # that might yield the target primitive (e.g., 'ROCK' to get 'GOLD').\n        if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height) and np.any(state.grid[facing_r, facing_c, :] == 1):\n            turns_to_face = _get_turning_actions(current_dir, target_dir)\n            \n            # Simulate the turns to get the agent into the correct orientation before the USE_ACT.\n            temp_state_before_use_step = state\n            for turn_action in turns_to_face:\n                _, temp_state_before_use_step = temp_state_before_use_step.step(turn_action)\n            \n            # Capture inventory and grid states immediately before the final USE_ACT.\n            inventory_before_adj_use = np.copy(temp_state_before_use_step.inventory)\n            grid_before_adj_use = np.copy(temp_state_before_use_step.grid)\n            \n            # Perform the USE_ACT.\n            _, state_after_adj_use = temp_state_before_use_step.step(USE_ACT)\n            \n            # Only add this transition if the USE_ACT resulted in a change of state.\n            state_changed_by_adj_use = not (\n                np.array_equal(state_after_adj_use.inventory, inventory_before_adj_use) and\n                state_after_adj_use.pos == temp_state_before_use_step.pos and\n                state_after_adj_use.dir == temp_state_before_use_step.dir and\n                np.array_equal(state_after_adj_use.grid, grid_before_adj_use) # Crucial to compare grid\n            )\n            if state_changed_by_adj_use:\n                potential_next_transitions.append(\n                    (state_after_adj_use, path + turns_to_face + [USE_ACT], inventory_before_adj_use)\n                )\n\n    # --- Process all generated potential next transitions ---\n    for next_s, next_p, inv_before_action in potential_next_transitions:\n        # First, check if the target primitive was successfully collected in this transition.\n        if next_s.inventory[i_kind] > inv_before_action[i_kind]:\n            return next_p # Goal achieved! Return the path immediately.\n\n        # If not the goal, add the new state to the queue if it hasn't been visited yet.\n        next_inventory_tuple = tuple(next_s.inventory)\n        next_grid_hash = hash(next_s.grid.tobytes()) # Hash grid for the visited set key\n        next_state_key = (next_grid_hash, next_s.pos[0], next_s.pos[1], next_s.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            # Add to visited and queue only if we are within the budget for unique states.\n            # This ensures the 'visited' set size does not grow indefinitely.\n            if len(visited) < MAX_UNIQUE_STATES_TO_VISIT:\n                visited.add(next_state_key)\n                q.append((next_s, next_p))\n            # Else: If the limit is reached, we prune this branch of the search.\n            # The BFS will continue with other branches already in the queue or until it's empty.\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions\n  # or within the defined search limits.\n  return []", "island_id": 6, "scores": {"3": 2.5}}
{"timestamp": "2025-08-01T13:04:25.125298", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # V2 IMPROVEMENT: Early exit for explicitly non-collectible environmental entities.\n  # \"Primitives\" like BOUNDARY and WORKSHOPs are locations/obstacles, not items that can be\n  # placed into the agent's inventory. Running a BFS for them is wasteful.\n  boundary_idx = world.cookbook.index.get('boundary')\n  is_workshop = i_kind in world.workshop_indices\n\n  if (i_kind == boundary_idx) or is_workshop:\n      # Boundary and Workshop entities cannot be \"collected\" into inventory.\n      return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # This applies to all genuinely collectible primitives.\n  if current_state.inventory[i_kind] > 0:\n      # Primitive is already collected, no actions needed.\n      return []\n\n  # The following semantic checks from v0/v1 are partially redundant but provide\n  # a general safety net for other uncollectible kinds not explicitly listed above.\n  # However, the BFS goal (inventory increment) will ultimately filter these out,\n  # so this block can be simplified or removed if the above early exit is sufficient.\n  # For robustness, retaining a simplified version:\n  is_primitive_resource = i_kind in world.cookbook.primitives\n  is_special_collectible_environment = (i_kind == world.water_index or i_kind == world.stone_index)\n  is_grabbable = i_kind in world.grabbable_indices\n\n  # If the item is not a recognized primitive resource, a special collectible environment\n  # item (water/stone), or directly grabbable, it's likely not collectible into inventory\n  # via the 'collect' mechanism. This catches items that aren't workshops/boundaries\n  # but also aren't intended for inventory.\n  # Note: This check relies on `is_primitive_resource` which includes all DSL 'primitives'.\n  # The BFS will implicitly ensure 'WOOD' etc. are collectible via USE.\n  if not (is_primitive_resource or is_special_collectible_environment or is_grabbable):\n      return []\n\n  # 3. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row decreases, col stays same\n      1: (0, 1),  # RIGHT: row stays same, col increases\n      2: (1, 0),  # DOWN: row increases, col stays same\n      3: (0, -1)  # LEFT: row stays same, col decreases\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return []\n      # Calculate difference ensuring it's positive and within [0, 3]\n      diff = (target_dir - current_dir + 4) % 4\n      if diff == 1:\n          return [RIGHT_ACT] # One right turn\n      elif diff == 3:\n          return [LEFT_ACT]  # One left turn\n      else: # diff == 2 (180-degree turn)\n          return [RIGHT_ACT, RIGHT_ACT] # Two right turns (or two left turns)\n\n  # 4. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The visited set must capture the full state to prevent redundant exploration,\n  # especially if grid changes without immediate inventory/position changes.\n  # State key: (grid_hash, row, col, direction, inventory_tuple)\n  visited = set() \n\n  initial_inventory_tuple = tuple(current_state.inventory)\n  # Hash the grid to include its state in the visited key.\n  # .tobytes() converts the numpy array to a bytes object, which is hashable.\n  initial_grid_hash = hash(current_state.grid.tobytes()) \n\n  q.append((current_state, [])) # Queue stores (CraftState object, path_to_reach_this_state)\n  visited.add((initial_grid_hash, current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Set a heuristic upper bound for explored states to prevent excessively long searches\n  # on very large or complex maps. This is a practical safeguard.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 150 \n  explored_states_count = 0\n\n  # 5. BFS Loop.\n  while q:\n    state, path = q.popleft()\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent runaway search.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n\n    # List to store (next_state_object, actions_to_reach_next_state, inventory_before_last_action_applied)\n    # Storing 'inventory_before_last_action_applied' is crucial for checking if the goal item\n    # was *specifically* acquired in the last step of a transition.\n    potential_next_transitions = []\n\n    # --- Generate all potential next states from the current state ---\n\n    # 1. Explore Movement Actions (UP, DOWN, LEFT, RIGHT)\n    for action in move_actions:\n        _, next_state = state.step(action)\n        # For movement, the 'inventory_before_action' is simply the current state's inventory.\n        potential_next_transitions.append((next_state, path + [action], np.copy(state.inventory)))\n\n    # 2. Explore USE_ACT at current position\n    # This handles collecting items directly from the cell the agent is standing on (e.g., grabbable items).\n    inventory_before_use_at_pos = np.copy(state.inventory)\n    grid_before_use_at_pos = np.copy(state.grid) # Capture grid state before USE\n    _, state_after_use_at_pos = state.step(USE_ACT)\n    \n    # Only consider this transition if the USE_ACT actually resulted in a state change\n    # (e.g., inventory changed, or grid changed, or position/direction changed - though USE typically only changes inventory/grid).\n    state_changed_by_use_at_pos = not (\n        np.array_equal(state_after_use_at_pos.inventory, inventory_before_use_at_pos) and\n        state_after_use_at_pos.pos == state.pos and\n        state_after_use_at_pos.dir == state.dir and\n        np.array_equal(state_after_use_at_pos.grid, grid_before_use_at_pos) # Crucial to compare grid\n    )\n    if state_changed_by_use_at_pos:\n        potential_next_transitions.append((state_after_use_at_pos, path + [USE_ACT], inventory_before_use_at_pos))\n    \n    # 3. Explore USE_ACT on adjacent cells (after turning to face them)\n    # This handles interacting with items/structures in the surrounding environment (e.g., chopping trees, mining rocks).\n    for target_dir in range(4): # Iterate through all four possible facing directions\n        dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n        facing_r, facing_c = current_r + dr, current_c + dc\n\n        # Check if the facing cell is within grid bounds and contains *any* entity.\n        # This broad check allows interaction with any relevant environmental object\n        # that might yield the target primitive (e.g., 'ROCK' to get 'GOLD').\n        if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height) and np.any(state.grid[facing_r, facing_c, :] == 1):\n            turns_to_face = _get_turning_actions(current_dir, target_dir)\n            \n            # Simulate the turns to get the agent into the correct orientation before the USE_ACT.\n            temp_state_before_use_step = state\n            for turn_action in turns_to_face:\n                _, temp_state_before_use_step = temp_state_before_use_step.step(turn_action)\n            \n            # Capture inventory and grid states immediately before the final USE_ACT.\n            inventory_before_adj_use = np.copy(temp_state_before_use_step.inventory)\n            grid_before_adj_use = np.copy(temp_state_before_use_step.grid)\n            \n            # Perform the USE_ACT.\n            _, state_after_adj_use = temp_state_before_use_step.step(USE_ACT)\n            \n            # Only add this transition if the USE_ACT resulted in a change of state.\n            state_changed_by_adj_use = not (\n                np.array_equal(state_after_adj_use.inventory, inventory_before_adj_use) and\n                state_after_adj_use.pos == temp_state_before_use_step.pos and\n                state_after_adj_use.dir == temp_state_before_use_step.dir and\n                np.array_equal(state_after_adj_use.grid, grid_before_adj_use) # Crucial to compare grid\n            )\n            if state_changed_by_adj_use:\n                potential_next_transitions.append(\n                    (state_after_adj_use, path + turns_to_face + [USE_ACT], inventory_before_adj_use)\n                )\n\n    # --- Process all generated potential next transitions ---\n    for next_s, next_p, inv_before_action in potential_next_transitions:\n        # First, check if the target primitive was successfully collected in this transition.\n        if next_s.inventory[i_kind] > inv_before_action[i_kind]:\n            return next_p # Goal achieved! Return the path immediately.\n\n        # If not the goal, add the new state to the queue if it hasn't been visited yet.\n        next_inventory_tuple = tuple(next_s.inventory)\n        next_grid_hash = hash(next_s.grid.tobytes()) # Hash grid for the visited set key\n        next_state_key = (next_grid_hash, next_s.pos[0], next_s.pos[1], next_s.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((next_s, next_p))\n\n  # 6. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-08-01T13:05:49.992082", "function_name": "collect", "function_body": "  \"\"\"Finds the shortest sequence of actions to collect a specified primitive using Breadth-First Search (BFS).\n\n  This function aims to robustly locate and acquire a given primitive item within the CraftWorld environment.\n  It considers not only direct movement to the item but also the acquisition of necessary tools (e.g., an axe\n  to collect wood) or crafting at workshops, as these intermediate steps are implicitly handled by the `USE`\n  action in `CraftState.step`. The BFS tracks the agent's position, direction, and crucially, its inventory,\n  to correctly explore states where item collection capabilities change (e.g., after picking up a tool).\n\n  Args:\n      env (env.CraftLab): The CraftLab object representing the current simulation state.\n      primitive (str): The name of the primitive resource to collect (e.g., \"wood\", \"stone\", \"iron\").\n\n  Returns:\n      List[int]: A sequence of integer action indices (e.g., `[UP, UP, USE]`) that, when executed,\n                 will lead to the collection of at least one unit of the primitive.\n                 Returns an empty list if the primitive is already in inventory, or if no path\n                 is found within the exploration limits.\n  \"\"\"\n  current_state = env._current_state\n  world = env.world # Access to CraftWorld instance for indices and recipes.\n\n  # 1. Convert the primitive name (string) to its internal integer ID.\n  # This mapping is essential as the environment's grid and state attributes operate with integer indices.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the provided primitive name is not recognized in the world's cookbook, it cannot be collected.\n    # This prevents errors and handles cases where an invalid primitive name is provided.\n    return []\n\n  # 2. Early exit condition: Check if the primitive is already in the agent's inventory.\n  # If the agent already possesses the item, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Determine if the primitive is a type that can be collected via the 'USE' action.\n  # In CraftWorld, \"collection\" typically refers to picking up grabbable items (like tools or raw materials),\n  # or interacting with specific environment elements like \"water\" or \"stone\" to acquire them.\n  # Other entities (e.g., boundaries, workshops themselves) are not 'collected' into inventory this way.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or # Grabbable items such as wood, iron, tools, etc.\n      i_kind == world.water_index or     # The 'water' entity can be collected\n      i_kind == world.stone_index        # The 'stone' entity can be collected\n  )\n\n  # If the target item is not of a type that can be acquired by a 'USE' action,\n  # then this function, designed for collection via 'USE', cannot find a path.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action constants and utility mappings for grid navigation.\n  action_map = env.action_specs() # Get the mapping from human-readable action names to their integer IDs.\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's current direction (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n  # to the (row_change, col_change) needed to identify the grid cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (North)\n      1: (0, 1),  # RIGHT: row, col + 1 (East)\n      2: (1, 0),  # DOWN: row + 1, col (South)\n      3: (0, -1)  # LEFT: row, col - 1 (West)\n  }\n\n  # Helper function to compute the minimal sequence of turning actions required\n  # for the agent to face a specific target direction from its current one.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # No turns needed if already facing the correct way.\n\n      # Calculate the difference in directions, normalizing the result to be within [0, 3]\n      # to represent the shortest clockwise turn. Adding 4 and taking modulo 4 handles wrapping.\n      diff = (target_dir - current_dir + 4) % 4\n\n      if diff == 1: # Target is one step clockwise (e.g., UP -> RIGHT).\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP -> LEFT).\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP -> DOWN).\n          return [RIGHT_ACT, RIGHT_ACT] # Two successive right turns (or two left turns).\n\n  # 5. Initialize Breadth-First Search (BFS) data structures.\n  q = collections.deque() # The queue for BFS, storing (CraftState object, list of actions taken to reach this state).\n  # The `visited` set tracks states that have already been explored to avoid redundant work and infinite loops.\n  # A state is uniquely defined by (row, col, direction, inventory_tuple). Including the inventory\n  # is critical because acquiring tools or crafting items changes the agent's capabilities, making\n  # it a distinct and valuable state for future exploration, even if position and direction are the same.\n  visited = set()\n\n  # Add the initial state to the queue and mark it as visited.\n  initial_inventory_tuple = tuple(current_state.inventory) # Convert numpy array to tuple for hashability in the set.\n  q.append((current_state, [])) # The starting state has an empty path.\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, n_kinds = current_state.grid.shape\n  # `MAX_EXPLORED_STATES` serves as a heuristic limit to prevent the BFS from running\n  # indefinitely in very large, complex, or potentially unreachable scenarios.\n  # The multiplier (e.g., 10) provides a generous bound to allow for exploration across\n  # different inventory states and tool acquisition paths.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 # Width * Height * 4 directions * multiplier for inventory states.\n  explored_states_count = 0 # Counter for the number of unique states processed.\n\n  # Pre-compute a boolean mask for the 'n_kinds' dimension for efficient checks.\n  # This mask quickly identifies if any 'useable' item (grabbable, water, stone) is present\n  # at a specific grid cell, optimizing the check before trying a general 'USE' action.\n  all_useable_kind_indices = list(set(world.grabbable_indices) | {world.water_index, world.stone_index})\n  useable_kind_mask = np.zeros(n_kinds, dtype=bool)\n  for idx in all_useable_kind_indices:\n      if 0 <= idx < n_kinds: # Ensure the index is within valid bounds for the grid's kind dimension.\n          useable_kind_mask[idx] = True\n\n  # 6. Main BFS Loop: Continues as long as there are states to explore in the queue\n  # and the goal hasn't been found.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path taken to reach it.\n    explored_states_count += 1\n\n    # Pruning: If the number of explored states exceeds the predefined limit,\n    # skip further processing from this path. This manages computational resources\n    # and prevents excessively long search times for difficult or impossible goals.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue # This branch of the search is considered too long or deep.\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n\n    # 7. Goal Check: Determine if the target primitive can be collected from the current `state`.\n    # First, a quick check to see if the primitive is within the 3x3 neighborhood of the agent.\n    if state.next_to(i_kind):\n        # If it's nearby, iterate through all four cardinal directions to see if the primitive\n        # is directly in front of the agent in any of those directions.\n        for target_dir in range(4):\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Validate that the 'facing' cell is within the grid boundaries.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height):\n                # Check if the target primitive (i_kind) is indeed present in the cell directly in front.\n                if state.grid[facing_r, facing_c, i_kind] == 1:\n                    # If found, calculate the necessary turns for the agent to face it.\n                    turns_to_face = _get_turning_actions(current_dir, target_dir)\n                    temp_state_after_turns = state # Start simulating from the current state.\n                    for turn_action in turns_to_face:\n                        # Apply each turn action to simulate the state after turning.\n                        _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                    # Store the inventory *before* attempting the 'USE' action. This is crucial\n                    # for verifying that the 'USE' action genuinely resulted in collecting the primitive.\n                    inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                    # Simulate the 'USE' action in the temporary state. This action\n                    # will attempt to collect the item (e.g., if conditions like having a tool are met).\n                    _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                    # Verification of successful collection: The count of the target primitive\n                    # in the agent's inventory must have increased after the 'USE' action.\n                    # This confirms successful collection, accounting for any game rules\n                    # (e.g., needing an axe for wood) handled by `CraftState.step`.\n                    if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                        # If collected, we have found a path! Reconstruct and return the full action sequence.\n                        return path + turns_to_face + [USE_ACT]\n\n    # 8. Explore next possible states by simulating all valid actions from the current state.\n\n    # 8a. Explore movement actions (UP, DOWN, LEFT, RIGHT).\n    for action in move_actions:\n      _, next_state = state.step(action) # Simulate taking the movement action.\n      next_inventory_tuple = tuple(next_state.inventory) # Convert inventory to tuple for hashability.\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      # If this new state (defined by position, direction, and inventory) has not been visited before,\n      # add it to the queue for future exploration and mark it as visited.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n\n    # 8b. Explore the 'USE' action from the current state.\n    # The 'USE' action is vital because it can lead to acquiring intermediate items (like tools),\n    # or crafting at workshops, which might enable future collection steps of the target primitive.\n\n    # Determine the grid cell directly in front of the agent, as this is the primary target for 'USE'.\n    front_dr, front_dc = _DIR_TO_DELTA_FRONT[current_dir]\n    facing_r, facing_c = current_r + front_dr, current_c + front_dc\n\n    # Check if the 'facing' cell is within the grid's valid boundaries.\n    is_valid_facing_cell = (0 <= facing_r < grid_width and 0 <= facing_c < grid_height)\n\n    # Check if there's anything \"useable\" (grabbable item, water, or stone) in the cell directly in front.\n    # This uses the pre-computed `useable_kind_mask` for efficiency.\n    is_something_useable_in_front = False\n    if is_valid_facing_cell:\n        is_something_useable_in_front = np.any(state.grid[facing_r, facing_c, useable_kind_mask])\n\n    # Additionally, check if the agent is currently standing on a workshop, as 'USE' often triggers\n    # crafting operations when at a workshop.\n    is_standing_on_workshop = np.any(state.grid[current_r, current_c, list(world.workshop_indices)])\n\n    # Only attempt the 'USE' action if there's a plausible target in front OR if the agent is on a workshop.\n    # This optimization prunes many unproductive 'USE' actions (e.g., trying to use an empty wall or ground).\n    if is_something_useable_in_front or is_standing_on_workshop:\n        inventory_before_any_use = np.copy(state.inventory) # Capture inventory before trying USE.\n        _, state_after_current_use = state.step(USE_ACT) # Simulate the general USE action.\n\n        # Add the resulting state to the queue only if the 'USE' action actually caused\n        # a meaningful change in the environment (e.g., change in inventory, position, or direction).\n        # This prevents exploring states that are identical to the current one after an ineffective 'USE'.\n        if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n                state_after_current_use.pos == state.pos and\n                state_after_current_use.dir == state.dir):\n\n            next_inventory_tuple = tuple(state_after_current_use.inventory)\n            next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n            if next_state_key not in visited:\n                visited.add(next_state_key)\n                q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 9. If the BFS loop completes and no path to collect the primitive was found,\n  # it means the primitive is currently unreachable under the given conditions and exploration limits.\n  return []", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T13:05:51.470987", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Map the primitive name to its integer ID.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized in the world's cookbook, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If so, it's already \"collected,\" and no actions are needed.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Determine if the primitive is a type that can be collected via the 'USE' action.\n  # This includes grabbable items (like tools), water, or stone. Other items (e.g., workshops, boundaries)\n  # are not typically \"collected\" into inventory by 'USE'.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or\n      i_kind == world.water_index or\n      i_kind == world.stone_index\n  )\n\n  # If the item is not intended to be collected via 'USE', return an empty path.\n  # This acts as an early exit for uncollectible types.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action constants and directional deltas for grid navigation.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # Delta values for checking the cell directly in front of the agent based on its current direction.\n  # (row_change, col_change) for each of the 4 directions (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT).\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP (North)\n      1: (0, 1),  # RIGHT (East)\n      2: (1, 0),  # DOWN (South)\n      3: (0, -1)  # LEFT (West)\n  }\n\n  # Helper function to compute the minimal sequence of turns to face a target direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the correct direction.\n\n      # Calculate the difference in directions, wrapping around 0-3.\n      # The +4 % 4 ensures a positive result for modulo operation.\n      diff = (target_dir - current_dir + 4) % 4\n\n      if diff == 1: # Target is one step clockwise (e.g., 0->1, 1->2, 2->3, 3->0).\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., 0->3, 1->0, etc.).\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., 0->2, 1->3).\n          return [RIGHT_ACT, RIGHT_ACT] # Two successive right turns (or left turns).\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The `visited` set stores a tuple `(row, col, direction, inventory_tuple)` to represent\n  # a unique state. Converting inventory (numpy array) to a tuple makes it hashable for the set.\n  visited = set()\n\n  # Add the initial state to the queue and visited set.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, [])) # (current_state, path_to_reach_this_state)\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, n_kinds = current_state.grid.shape\n  # Heuristic limit to prevent the BFS from running indefinitely in complex or unreachable scenarios.\n  # The multiplier (10) allows for sufficient exploration, including states where intermediate tools are acquired.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10\n  explored_states_count = 0\n\n  # Pre-compute a boolean mask for the 'n_kinds' dimension to quickly check\n  # if any 'useable' item (grabbable, water, stone) is present at a grid cell.\n  # This optimizes the `is_something_useable_in_front` check within the BFS loop.\n  all_useable_kind_indices = list(set(world.grabbable_indices) | {world.water_index, world.stone_index})\n  useable_kind_mask = np.zeros(n_kinds, dtype=bool)\n  for idx in all_useable_kind_indices:\n      if 0 <= idx < n_kinds: # Ensure index is valid for the grid dimension\n          useable_kind_mask[idx] = True\n\n  # 6. BFS Loop: Continues until the queue is empty or the goal is found.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and its associated path.\n    explored_states_count += 1\n\n    # Pruning: If too many distinct states have been explored, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n\n    # Goal Check: Can the target primitive be collected from the current `state`?\n    # First, check if the primitive is within the 3x3 neighborhood.\n    if state.next_to(i_kind):\n        # If it's nearby, iterate through all four cardinal directions to check if it's directly in front.\n        for target_dir in range(4):\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell directly in front is within bounds and contains the target primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and\n                state.grid[facing_r, facing_c, i_kind] == 1):\n\n                # Calculate and apply the turning actions required to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state\n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Record inventory *before* attempting the 'USE' action to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action on the temporary state.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Crucial verification: Check if the count of the target primitive in inventory\n                # actually increased. This confirms successful collection, accounting for any\n                # game rules (e.g., requiring tools) handled by `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT] # Found a path!\n\n    # Explore possible future states by performing movement actions.\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      # If this next state (position, direction, and inventory) has not been visited, add it to the queue.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n\n    # Explore the 'USE' action from the current state.\n    # This is vital for scenarios where using an item at the current location (e.g., picking up a tool)\n    # or crafting at a workshop might enable subsequent collection steps.\n    \n    # Determine the cell directly in front of the agent. This is the primary target for a 'USE' action.\n    front_dr, front_dc = _DIR_TO_DELTA_FRONT[current_dir]\n    facing_r, facing_c = current_r + front_dr, current_c + front_dc\n\n    # Check bounds for the cell in front.\n    if 0 <= facing_r < grid_width and 0 <= facing_c < grid_height:\n        # Optimized check: Use the pre-computed `useable_kind_mask` to quickly determine\n        # if *any* useable item (grabbable, water, stone) is present in the cell directly in front.\n        is_something_useable_in_front = np.any(state.grid[facing_r, facing_c, useable_kind_mask])\n    else:\n        is_something_useable_in_front = False # Cannot use something out of bounds\n\n    # Additionally, check if the agent is standing on a workshop, as 'USE' might apply there (e.g., crafting).\n    is_standing_on_workshop = np.any(state.grid[current_r, current_c, list(world.workshop_indices)])\n\n    # Only attempt USE_ACT if there's something potentially interactable in front OR if standing on a workshop.\n    if is_something_useable_in_front or is_standing_on_workshop:\n        inventory_before_any_use = np.copy(state.inventory)\n        _, state_after_current_use = state.step(USE_ACT)\n        \n        # Add to queue only if the 'USE' action resulted in a meaningful state change.\n        # This prevents redundant exploration of states where 'USE' did nothing.\n        if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n                state_after_current_use.pos == state.pos and\n                state_after_current_use.dir == state.dir):\n\n            next_inventory_tuple = tuple(state_after_current_use.inventory)\n            next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n            if next_state_key not in visited:\n                visited.add(next_state_key)\n                q.append((state_after_current_use, path + [USE_ACT]))\n    # If the agent is not facing a valid cell or nothing useable is in front and not on a workshop,\n    # the 'USE' action is not considered for exploration from this specific state.\n\n  # 7. If the BFS loop completes and no path to collect the primitive was found,\n  # it means the primitive is currently unreachable given the environment and agent's capabilities.\n  return []", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T13:06:30.716704", "function_name": "collect", "function_body": "", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-08-01T13:06:31.942550", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n\n    This function finds the shortest sequence of actions for the agent to move to a\n    position adjacent to the specified primitive, face it, and then use it.\n    It utilizes a Breadth-First Search (BFS) for optimal pathfinding, ensuring\n    correct handling of blocking entities and agent orientation for interaction.\n\n    Args:\n        env (env.CraftLab): The CraftLab environment object, providing access to\n                            the current game state and world configuration.\n        primitive (str): The string name of the primitive item to be collected or\n                         interacted with (e.g., \"WOOD\", \"WORKSHOP0\").\n\n    Returns:\n        List[int]: A list of integer action codes (from `env.action_specs()`) that,\n                   when executed, will lead the agent to collect/use the primitive.\n                   Returns an empty list if the primitive is already in the agent's\n                   inventory or if no reachable path can be found on the current grid.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state # Access the current game state from the environment\n\n  # Retrieve the integer ID for the target primitive from the cookbook's index.\n  # This ID is used for grid lookups and inventory checks.\n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  # Early Exit Optimization: If the agent already possesses the primitive,\n  # no actions are needed. This is crucial for idempotent behavior and efficiency,\n  # especially for \"collectible\" primitives like WOOD or STONE.\n  if current_state.inventory[primitive_id] > 0:\n      return []\n\n  # Get the initial grid layout, agent's position, and facing direction from the current state.\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's current (row, column) tuple (r, c)\n  initial_dir = current_state.dir # Agent's current facing direction (0:Right, 1:Up, 2:Left, 3:Down)\n\n  # Get grid dimensions (num_rows corresponds to height, num_cols to width of the grid).\n  num_rows, num_cols, _ = initial_grid.shape\n\n  # Map symbolic action names to their integer indices as defined by the environment's action specifications.\n  # These integer values are what `env.step()` expects.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # In CraftWorld, 'UP' typically moves forward relative to agent's facing.\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']            # Action to interact with/collect an item in front.\n\n  # Define changes in (row, col) for each facing direction (0:Right, 1:Up, 2:Left, 3:Down).\n  # This helps calculate the cell directly in front of the agent or the cell the agent would move into.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col + 1)\n      1: (-1, 0),  # Facing UP:    (row - 1, col)\n      2: (0, -1),  # Facing LEFT:  (row, col - 1)\n      3: (1, 0)    # Facing DOWN:  (row + 1, col)\n  }\n\n  # Define how the agent's direction changes when performing a 'Turn Left' or 'Turn Right' action.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right (clockwise rotation of direction index)\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right (counter-clockwise rotation)\n\n  # Determine all item kinds that block agent movement into a cell.\n  # This set includes:\n  # 1. Inherently non-grabbable entities (e.g., BOUNDARY walls, WATER, WORKSHOP locations).\n  # 2. The target primitive itself, if it's a collectible resource (e.g., WOOD, STONE).\n  #    The agent must stand *adjacent* to such resources, not directly on their cell, to `USE` them.\n  #    If the primitive is already classified as non-grabbable (e.g., WORKSHOP), adding it again has no effect.\n  blocking_kinds_for_movement = set(current_state.world.non_grabbable_indices)\n  blocking_kinds_for_movement.add(primitive_id) # Ensure the target primitive itself blocks walking over it.\n  \n  # Convert the set of blocking kind IDs to a NumPy array for efficient indexing into the grid.\n  blocking_kind_indices_np = np.array(list(blocking_kinds_for_movement), dtype=int)\n\n  # Initialize Breadth-First Search (BFS):\n  # The queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_here)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # The visited set stores (position, direction) tuples to prevent redundant exploration and infinite loops (cycles).\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # This variable will store the action sequence once the goal state is found.\n\n  # Start the BFS traversal to find the shortest path.\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos # Extract current row and column of the agent.\n\n      # 1. Goal Check: Determine if the primitive is directly in the cell in front of the agent.\n      # If so, the agent is positioned correctly to 'USE' the primitive (i.e., adjacent and facing it).\n      front_dr, front_dc = DIR_TO_DRDC[current_dir] # Calculate delta for the cell directly in front.\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the calculated front cell is within the grid boundaries.\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n          # Check if the target primitive is present in the cell directly in front.\n          # `initial_grid[front_r, front_c, primitive_id] > 0` confirms the primitive's presence.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path_actions = path_actions # Path to the desired adjacency is found.\n              break # Exit BFS, as the shortest path is guaranteed by BFS.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n      \n      # Action: Try to Move Forward (relative to current_dir).\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Direction does not change when moving forward.\n\n      # Check if the potential next position is within grid boundaries.\n      if (0 <= next_r < num_rows and 0 <= next_c < num_cols):\n          # Check if this (position, direction) state has not been visited to avoid redundant paths.\n          if (next_pos, next_dir) not in visited:\n              # Check if the next position is walkable (i.e., it does not contain any blocking kinds).\n              # `np.any(initial_grid[next_r, next_c, blocking_kind_indices_np])`\n              # evaluates to True if *any* of the blocking kinds are present in the cell.\n              if not np.any(initial_grid[next_r, next_c, blocking_kind_indices_np]):\n                  visited.add((next_pos, next_dir)) # Mark as visited.\n                  queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION])) # Add to queue.\n\n      # Action: Try to Turn Left.\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning actions only change direction, not the agent's position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Action: Try to Turn Right.\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning actions only change direction, not the agent's position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # After BFS completes:\n  # If a path to the target (adjacent and facing the primitive) was found,\n  # extend the `actions_list` with that path and then append the `USE_ACTION`.\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION) # Finally, 'USE' the primitive to collect/interact.\n\n  return actions_list", "island_id": 1, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T13:07:09.187510", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's initial position (row, col)\n  initial_dir = current_state.dir # Agent's initial facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook's index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Determine grid dimensions: num_rows corresponds to grid.shape[0], num_cols to grid.shape[1]\n  num_rows, num_cols, _ = initial_grid.shape\n\n  # Retrieve action mapping from the environment\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # Corresponds to moving forward in the current direction\n  TURN_LEFT_ACTION = action_map['LEFT']     # Corresponds to turning 90 degrees left\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Corresponds to turning 90 degrees right\n  USE_ACTION = action_map['USE']            # Action to interact with the cell in front\n\n  # Direction vectors (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  # (dr, dc) indicates how row and column change when moving \"forward\"\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # Mapping for updating agent's direction when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # RIGHT->UP->LEFT->DOWN->RIGHT\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # RIGHT->DOWN->LEFT->UP->RIGHT\n\n  # Get indices of entities that block agent movement (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  # Convert the set to a list or numpy array once for efficient NumPy array indexing.\n  non_walkable_kinds_indices = list(current_state.world.non_grabbable_indices)\n\n  # BFS initialization:\n  # Queue stores ( (current_position_tuple, current_direction_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (position_tuple, direction_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the sequence of actions to reach the state where the primitive is in front\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent from the current state (ready for USE action)\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the cell in front is within grid boundaries\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n          # Check if the primitive is in this cell\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Path found! The agent is adjacent and facing the primitive.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right\n\n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Direction doesn't change when moving forward\n\n      # Check if the next position is within bounds and this (position, direction) state hasn't been visited\n      if (0 <= next_r < num_rows and 0 <= next_c < num_cols and\n          (next_pos, next_dir) not in visited):\n          \n          is_walkable = True\n          # Check if the next cell contains any non-walkable entity (e.g., BOUNDARY, WATER, WORKSHOP_X)\n          # by summing counts for all non-grabbable kinds at that cell.\n          # Only perform sum if there are non_walkable_kinds_indices defined to avoid error on empty list.\n          if non_walkable_kinds_indices and np.sum(initial_grid[next_r, next_c, non_walkable_kinds_indices]) > 0:\n              is_walkable = False\n          # Agent also cannot walk onto the primitive itself, as it needs to be \"used\" from an adjacent square\n          elif initial_grid[next_r, next_c, primitive_id] > 0:\n              is_walkable = False\n\n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path to the target state was found, append the USE action to complete the collection\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
