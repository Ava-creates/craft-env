{"timestamp": "2025-08-01T09:30:40.165774", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's initial position (row, col)\n  initial_dir = current_state.dir # Agent's initial facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook's index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Determine grid dimensions: num_rows corresponds to grid.shape[0], num_cols to grid.shape[1]\n  num_rows, num_cols, _ = initial_grid.shape\n\n  # Retrieve action mapping from the environment\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # Corresponds to moving forward in the current direction\n  TURN_LEFT_ACTION = action_map['LEFT']     # Corresponds to turning 90 degrees left\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Corresponds to turning 90 degrees right\n  USE_ACTION = action_map['USE']            # Action to interact with the cell in front\n\n  # Direction vectors (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  # (dr, dc) indicates how row and column change when moving \"forward\"\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # Mapping for updating agent's direction when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # RIGHT->UP->LEFT->DOWN->RIGHT\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # RIGHT->DOWN->LEFT->UP->RIGHT\n\n  # Get indices of entities that block agent movement (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  # Convert the set to a list once for efficient NumPy array indexing.\n  non_walkable_kinds_indices_list = list(current_state.world.non_grabbable_indices)\n\n  # Helper function to determine if the agent can move into a specific cell (r, c).\n  # A cell is walkable if it's within bounds and does not contain any non-walkable\n  # entities, including the primitive itself (as the agent needs to be adjacent to collect).\n  def _is_walkable_for_agent(r: int, c: int) -> bool:\n      # Check if coordinates are within the grid boundaries.\n      if not (0 <= r < num_rows and 0 <= c < num_cols):\n          return False\n      \n      # Check if the cell contains any entity that explicitly blocks agent movement.\n      # These are typically static obstacles like boundaries, water, or workshops.\n      # Use np.any to check if any of the non-walkable kinds are present in the cell.\n      if non_walkable_kinds_indices_list: # Ensure list is not empty before indexing to avoid errors\n          if np.any(initial_grid[r, c, non_walkable_kinds_indices_list] > 0):\n              return False\n      \n      # Crucially, the agent cannot move *into* the cell occupied by the primitive it wants to collect.\n      # Collection (via 'USE' action) happens from an adjacent cell.\n      if initial_grid[r, c, primitive_id] > 0:\n          return False\n          \n      return True\n\n  # BFS initialization:\n  # Queue stores ( (current_position_tuple, current_direction_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (position_tuple, direction_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the sequence of actions to reach the state where the primitive is in front\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent from the current state (ready for USE action)\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the cell in front is within grid boundaries\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n          # Check if the primitive is in this cell. If yes, we've found our target adjacent state.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Path found! The agent is positioned adjacent to and facing the primitive.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right\n\n      # Attempt to Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Direction does not change when moving forward\n\n      # If the next cell is walkable and this specific (position, direction) state has not been visited,\n      # add it to the queue for future exploration.\n      if _is_walkable_for_agent(next_r, next_c) and (next_pos, next_dir) not in visited:\n          visited.add((next_pos, next_dir))\n          queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Attempt to Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Attempt to Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path to the target adjacent state was found, append the USE action to complete the collection\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T09:30:41.314058", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's initial position (row, col)\n  initial_dir = current_state.dir # Agent's initial facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook's index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Determine grid dimensions: num_rows corresponds to grid.shape[0], num_cols to grid.shape[1]\n  num_rows, num_cols, _ = initial_grid.shape\n\n  # Retrieve numerical action codes from the environment's action_specs.\n  # This maps action names (e.g., 'UP', 'LEFT') to their corresponding integer IDs.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # Corresponds to moving forward in the current direction\n  TURN_LEFT_ACTION = action_map['LEFT']     # Corresponds to turning 90 degrees left\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Corresponds to turning 90 degrees right\n  USE_ACTION = action_map['USE']            # Action to interact with the cell in front (e.g., collect)\n\n  # Define how movement changes row/column based on the agent's current direction.\n  # This maps an agent's direction (0=Right, 1=Up, 2=Left, 3=Down) to the (delta_row, delta_column)\n  # for moving \"forward\".\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: moves to (row, col+1)\n      1: (-1, 0),  # Facing UP: moves to (row-1, col)\n      2: (0, -1),  # Facing LEFT: moves to (row, col-1)\n      3: (1, 0)    # Facing DOWN: moves to (row+1, col)\n  }\n\n  # Define how turns update the agent's direction (clockwise order for turns).\n  # For TURN_LEFT: 0->1 (R->U), 1->2 (U->L), 2->3 (L->D), 3->0 (D->R)\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  # For TURN_RIGHT: 0->3 (R->D), 1->0 (U->R), 2->1 (L->U), 3->2 (D->L)\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # Get indices of entities that block agent movement (e.g., BOUNDARY, WATER, WORKSHOP_X).\n  # These are entities the agent cannot occupy a cell with. Converting to a list once for efficiency.\n  non_walkable_kinds_indices_list = list(current_state.world.non_grabbable_indices)\n\n  # Initialize Breadth-First Search (BFS) for finding the shortest path.\n  # The queue stores tuples: ((agent_position_tuple, agent_direction_int), list_of_actions_taken_so_far).\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # The visited set stores (agent_position_tuple, agent_direction_int) tuples to prevent\n  # re-exploring states already visited, ensuring the shortest path is found.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the optimal action sequence to reach the pre-collection state.\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos # Unpack current row and column from position.\n\n      # 1. Goal Check: Determine if the primitive is directly in front of the agent from the current state.\n      # This is the target condition: being adjacent to and facing the primitive, ready to 'USE'.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the cell in front is within grid boundaries before checking its contents.\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n          # If the primitive is present in the cell directly in front, we have found our target state.\n          # The agent is now in position to use the 'USE_ACTION' to collect it.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Shortest path found to the pre-collection state, exit the BFS loop.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n\n      # Try Moving Forward (Action: MOVE_FORWARD_ACTION)\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Direction remains unchanged when moving forward.\n\n      # Check if the next position is within bounds and this specific (position, direction) state has not been visited.\n      if (0 <= next_r < num_rows and 0 <= next_c < num_cols and\n          (next_pos, next_dir) not in visited):\n          \n          is_walkable = True\n          # Check if the proposed next cell contains any non-walkable entity (like boundaries, water, workshops).\n          # Summing up the counts for all non-grabbable kinds at that cell.\n          if non_walkable_kinds_indices_list and np.sum(initial_grid[next_r, next_c, non_walkable_kinds_indices_list]) > 0:\n              is_walkable = False\n          # Also, the agent cannot move *into* the cell occupied by the primitive it wants to collect,\n          # as collection happens from an adjacent cell.\n          elif initial_grid[next_r, next_c, primitive_id] > 0:\n              is_walkable = False\n\n          # If the cell is walkable by the agent, add this new state to the queue.\n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turning Left (Action: TURN_LEFT_ACTION)\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Position does not change when turning.\n      # If this new (current_position, new_direction_left) state has not been visited, add it.\n      if (current_pos, next_dir_left) not in visited:\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turning Right (Action: TURN_RIGHT_ACTION)\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Position does not change when turning.\n      # If this new (current_position, new_direction_right) state has not been visited, add it.\n      if (current_pos, next_dir_right) not in visited:\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path to the target pre-collection state was found (i.e., target_path is not None),\n  # append the final 'USE' action to complete the collection process.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION) # Add the crucial 'USE' action to collect the primitive.\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T09:31:27.740751", "function_name": "collect", "function_body": "  current_state = env._current_state\n  \n  # Retrieve the integer index for the desired primitive.\n  # Using `env.world.cookbook.index[primitive]` (which uses Index.__getitem__)\n  # returns the index or None if the primitive name is not found.\n  primitive_idx = env.world.cookbook.index[primitive]\n  if primitive_idx is None:\n    # If the primitive name is not recognized or not a valid target, return an empty list.\n    return []\n  \n  # If the agent's inventory already contains at least one of the primitive, no collection is needed.\n  if current_state.inventory[primitive_idx] > 0:\n    return [] # Already collected, so return an empty action sequence.\n\n  # Get the integer mappings for all possible actions from the environment's action_specs.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # --- Step 1: Check for immediate collection ---\n  # Determine if the agent is already in a position (within a 3x3 neighborhood)\n  # to collect the primitive using a single 'USE' action.\n  if current_state.next_to(primitive_idx):\n    return [USE] # If adjacent, simply use the item.\n\n  # --- Step 2: Locate all occurrences of the primitive on the grid ---\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  primitive_locations = []\n  # Use numpy.where for efficient vectorized searching of all (x, y) coordinates\n  # where the primitive's count in the grid layer is greater than zero.\n  primitive_x_coords, primitive_y_coords = np.where(grid[:, :, primitive_idx] > 0)\n  for x, y in zip(primitive_x_coords, primitive_y_coords):\n      primitive_locations.append((x, y))\n\n  # If no instances of the primitive are found anywhere on the grid, it cannot be collected.\n  if not primitive_locations:\n    return []\n\n  # --- Step 3: Define \"Goal Cells\" for BFS ---\n  # A \"goal cell\" is any grid location from which the agent can successfully\n  # apply the 'USE' action to collect the target primitive. This includes any\n  # cell within the 3x3 Moore neighborhood of a primitive's actual location.\n  goal_cells = set()\n  for px, py in primitive_locations:\n    # Iterate through the 3x3 relative offsets (including the primitive's own cell).\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        gx, gy = px + dx, py + dy \n        # Ensure the calculated potential goal cell (gx, gy) is within the grid boundaries.\n        if 0 <= gx < grid_width and 0 <= gy < grid_height:\n          goal_cells.add((gx, gy))\n\n  # --- Step 4: Determine impassable terrain for agent movement ---\n  # Impassable entities are non-grabbable items that the agent cannot walk over.\n  # Workshop locations, though non-grabbable, are typically traversable.\n  impassable_indices = list(set(env.world.non_grabbable_indices) - set(env.world.workshop_indices))\n  # Flag to quickly check if any impassable kinds exist to avoid unnecessary checks.\n  has_impassable_kinds = bool(impassable_indices)\n\n  # --- Step 5: Perform Breadth-First Search (BFS) for the shortest path ---\n  # The BFS will find the shortest sequence of movement actions from the agent's\n  # current position to any of the identified 'goal_cells'.\n\n  start_pos = current_state.pos\n  \n  # BFS queue: Stores tuples of (current_position, list_of_actions_taken_to_reach_here).\n  q = collections.deque([(start_pos, [])]) \n  # Set to keep track of visited grid positions to prevent infinite loops and ensure\n  # the shortest path is found by exploring layer by layer.\n  visited = {start_pos} \n\n  # Define all possible cardinal movement directions (delta X, delta Y)\n  # and their corresponding action indices.\n  MOVEMENT_DELTAS_AND_ACTIONS = [\n      ((0, -1), UP),    # Move North (decreases Y-coordinate)\n      ((0, 1), DOWN),   # Move South (increases Y-coordinate)\n      ((-1, 0), LEFT),  # Move West (decreases X-coordinate)\n      ((1, 0), RIGHT),  # Move East (increases X-coordinate)\n  ]\n\n  while q:\n    # Dequeue the current position and the path leading to it.\n    (cx, cy), path_to_current = q.popleft() \n\n    # If the current position is one of our target goal cells, we've found the shortest path.\n    if (cx, cy) in goal_cells:\n      # Append the 'USE' action to the path and return the complete action sequence.\n      return path_to_current + [USE]\n\n    # Explore all valid neighboring cells from the current position.\n    for (dx, dy), action in MOVEMENT_DELTAS_AND_ACTIONS:\n      nx, ny = cx + dx, cy + dy # Calculate the coordinates of the next potential position.\n      new_pos = (nx, ny)\n\n      # 1. Boundary Check: Ensure the new position is within the grid dimensions.\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue # Skip if the new position is out of bounds.\n\n      # 2. Visited Check: If the new position has already been explored in this BFS.\n      if new_pos in visited:\n        continue # Skip if already visited to prevent cycles and ensure shortest path.\n\n      # 3. Impassability Check: Determine if the new position contains any impassable entity.\n      is_impassable_cell = False\n      if has_impassable_kinds: # Only perform the check if there are actual impassable kinds.\n          # Use np.any on the slice of the grid for efficient checking:\n          # True if any of the impassable kinds exist at (nx, ny) with a count > 0.\n          if np.any(grid[nx, ny, impassable_indices] > 0): \n              is_impassable_cell = True\n      \n      if is_impassable_cell:\n          continue # Skip this move if the cell is impassable.\n\n      # If the new position is valid, within bounds, traversable, and unvisited:\n      visited.add(new_pos) # Mark the new position as visited.\n      # Enqueue the new position along with the updated path to reach it.\n      q.append((new_pos, path_to_current + [action]))\n\n  # If the BFS completes (queue becomes empty) and no path to a goal cell was found,\n  # it implies that the primitive is currently unreachable from the agent's starting position.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T09:31:29.070373", "function_name": "collect", "function_body": "  current_state = env._current_state\n  \n  # Get the integer index for the desired primitive.\n  # Using __getitem__ (env.world.cookbook.index[primitive]) is robust as it returns None\n  # if the primitive name is not found, allowing graceful handling of invalid inputs.\n  primitive_idx = env.world.cookbook.index[primitive]\n  if primitive_idx is None:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n  \n  # If the agent already possesses at least one unit of the primitive, no action is needed.\n  # This avoids unnecessary movement if the goal is simply to have the item.\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # Retrieve action mappings from the environment to ensure correct action indices.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # 1. Immediate Collection Check:\n  # Check if the agent is currently within a 3x3 neighborhood of the primitive.\n  # If so, a single 'USE' action is sufficient to collect it without prior movement.\n  if current_state.next_to(primitive_idx):\n    return [USE]\n\n  # 2. Identify all locations on the grid where the primitive exists.\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  primitive_locations = []\n  # Using numpy.where is efficient for finding all (x, y) coordinates where the primitive is present.\n  primitive_x_coords, primitive_y_coords = np.where(grid[:, :, primitive_idx] > 0)\n  for x, y in zip(primitive_x_coords, primitive_y_coords):\n      primitive_locations.append((x, y))\n\n  # If the primitive is not found anywhere on the grid, it cannot be collected.\n  if not primitive_locations:\n    return []\n\n  # 3. Determine \"Goal Cells\" for Pathfinding (BFS):\n  # A goal cell is any grid location from which the agent can successfully collect the primitive\n  # using the 'USE' action. This implies any cell that is within the 3x3 neighborhood of a primitive.\n  goal_cells = set()\n  for px, py in primitive_locations:\n    # Iterate through all 9 cells in the 3x3 neighborhood around the primitive's location (px, py).\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        gx, gy = px + dx, py + dy\n        # Ensure the potential goal cell is within the grid boundaries.\n        if 0 <= gx < grid_width and 0 <= gy < grid_height:\n          goal_cells.add((gx, gy))\n\n  # 4. Define Impassable Terrain:\n  # These are grid elements that the agent cannot move onto. In CraftWorld, non-grabbable items\n  # are generally impassable, with the exception of workshop locations which are traversable.\n  impassable_kinds = set(env.world.non_grabbable_indices) - set(env.world.workshop_indices)\n  impassable_kinds_list = list(impassable_kinds) # Convert to list for NumPy indexing\n\n  # 5. Perform Breadth-First Search (BFS) to find the shortest path:\n  # The BFS aims to find the minimum sequence of movement actions from the agent's current\n  # position to any of the identified 'goal_cells'.\n\n  start_pos = current_state.pos\n  \n  # BFS queue: Stores tuples of (current_position, list_of_actions_taken_to_reach_here).\n  q = collections.deque([(start_pos, [])]) \n  # Set to track visited positions to avoid cycles and ensure the shortest path is found.\n  visited = {start_pos} \n\n  # Define possible cardinal movement directions (dx, dy) and their corresponding action indices.\n  MOVEMENT_DELTAS_AND_ACTIONS = [\n      ((0, -1), UP),    # Move North (decreases Y)\n      ((0, 1), DOWN),   # Move South (increases Y)\n      ((-1, 0), LEFT),  # Move West (decreases X)\n      ((1, 0), RIGHT),  # Move East (increases X)\n  ]\n\n  while q:\n    # Dequeue the current position and the path that led to it.\n    (cx, cy), path_to_current = q.popleft() \n\n    # If the current position is one of the target goal cells, the shortest path is found.\n    if (cx, cy) in goal_cells:\n      # Append the 'USE' action, as the agent is now in position to collect.\n      return path_to_current + [USE]\n\n    # Explore all valid neighboring cells from the current position.\n    for (dx, dy), action in MOVEMENT_DELTAS_AND_ACTIONS:\n      nx, ny = cx + dx, cy + dy # Calculate coordinates of the next potential position.\n      new_pos = (nx, ny)\n\n      # Check 1: Ensure the new position is within the overall grid boundaries.\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue \n\n      # Check 2: Determine if the new position contains any impassable entity.\n      is_impassable_cell = False\n      if impassable_kinds_list: # Only check if there are any defined impassable kinds.\n          # If any impassable kind has a count > 0 at (nx, ny), the cell is blocked.\n          is_impassable_cell = np.any(grid[nx, ny, impassable_kinds_list] > 0)\n      \n      if is_impassable_cell:\n          continue # Skip this cell if it's impassable.\n\n      # Check 3: If the new position has not been visited yet during this BFS.\n      if new_pos not in visited:\n        visited.add(new_pos) # Mark the new position as visited.\n        # Enqueue the new position along with the updated path.\n        q.append((new_pos, path_to_current + [action]))\n\n  # If the BFS completes and the queue is empty without finding a path to any goal cell,\n  # it means the primitive is currently unreachable from the agent's starting position.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T09:32:09.778794", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  grid = current_state.grid # The current grid layout (numpy.ndarray: WIDTH x HEIGHT x n_kinds)\n  initial_pos = current_state.pos # Agent's current position (row, col)\n  initial_dir = current_state.dir # Agent's current facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook's index.\n  # If the primitive name is not recognized, return an empty list as it cannot be collected.\n  try:\n    primitive_id = current_state.world.cookbook.index[primitive]\n  except KeyError:\n    return []\n\n  # Extract grid dimensions for boundary checks\n  GRID_WIDTH, GRID_HEIGHT, _ = grid.shape\n\n  # Map DSL movement/turn actions to their integer indices from CraftLab's action_specs.\n  action_map = env.action_specs()\n  ACTION_MOVE_FORWARD = action_map['UP'] # Assuming 'UP' corresponds to moving forward\n  ACTION_TURN_LEFT = action_map['LEFT']\n  ACTION_TURN_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE'] # Action to interact with an object in front of the agent\n\n  # Direction mapping: (dr, dc) tuple for change in row and column for each cardinal direction.\n  # This is used to calculate the cell in front of the agent or the next position after moving.\n  # 0:RIGHT (+col), 1:UP (-row), 2:LEFT (-col), 3:DOWN (+row)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # Maps for updating the agent's direction after a turn (clockwise rotation order for clarity).\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0} # R(0)->U(1)->L(2)->D(3)->R(0) (Counter-clockwise)\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # R(0)->D(3)->L(2)->U(1)->R(0) (Clockwise)\n\n  # Get indices of entities that block agent movement. These are typically non-grabbable\n  # entities like boundaries, water, or workshop stations, which the agent cannot walk onto.\n  # The primitive itself is also added here, as the agent must stop *adjacent* to it,\n  # not step onto its square, before using it.\n  obstacle_kind_ids = current_state.world.non_grabbable_indices.copy()\n  obstacle_kind_ids.add(primitive_id)\n\n  # Helper function to check if a given cell (r, c) is within bounds and free of obstacles.\n  def is_walkable(r_coord, c_coord):\n    # 1. Check if the cell coordinates are within the grid boundaries.\n    if not (0 <= r_coord < GRID_WIDTH and 0 <= c_coord < GRID_HEIGHT):\n      return False\n\n    # 2. Check if the cell contains any obstacle entity (non-grabbable or the primitive itself).\n    for kind_idx in obstacle_kind_ids:\n      if grid[r_coord, c_coord, kind_idx] > 0:\n        return False\n    \n    return True\n\n  # Initialize Breadth-First Search (BFS) structures.\n  # The queue stores tuples: ( (current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_here ).\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # The visited set stores (position_tuple, direction_int) to prevent redundant exploration\n  # and infinite loops by revisiting states already processed with a shorter or equal path.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # This will store the shortest action sequence once the goal is found.\n\n  # Begin BFS traversal\n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      r, c = current_pos # Unpack current position\n\n      # --- Goal Check ---\n      # Check if the target primitive is directly in front of the agent at the current state.\n      # This is the desired state from which the 'USE' action can be executed.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Verify the cell in front is within bounds and contains the target primitive.\n      if (0 <= front_r < GRID_WIDTH and 0 <= front_c < GRID_HEIGHT) and\\\n         (grid[front_r, front_c, primitive_id] > 0):\n          target_path_actions = path_so_far # Found the path to be adjacent and facing the primitive.\n          break # Exit BFS, as we found the shortest path.\n\n      # --- Explore Possible Next Actions ---\n      # From the current state, explore moving forward, turning left, and turning right.\n\n      # 1. Try Moving Forward\n      next_r_move, next_c_move = r + DIR_TO_DRDC[current_dir][0], c + DIR_TO_DRDC[current_dir][1]\n      next_pos_move = (next_r_move, next_c_move)\n      next_dir_move = current_dir # Direction remains unchanged after moving forward.\n\n      # If the next position is valid, walkable, and this (pos,dir) state hasn't been visited:\n      if is_walkable(next_r_move, next_c_move):\n          if (next_pos_move, next_dir_move) not in visited:\n              visited.add((next_pos_move, next_dir_move))\n              queue.append(((next_pos_move, next_dir_move), path_so_far + [ACTION_MOVE_FORWARD]))\n\n      # 2. Try Turning Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change the agent's position, only its direction.\n      if (current_pos, next_dir_left) not in visited:\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_so_far + [ACTION_TURN_LEFT]))\n\n      # 3. Try Turning Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change the agent's position, only its direction.\n      if (current_pos, next_dir_right) not in visited:\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_so_far + [ACTION_TURN_RIGHT]))\n\n  # After BFS completes, if a path to the target (adjacent and facing the primitive) was found,\n  # append the final 'USE' action to complete the collection.\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(ACTION_USE)\n\n  return actions_list", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T09:32:10.944217", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos  # Agent's (row, col) tuple\n  initial_dir = current_state.dir  # Agent's facing direction (0:R, 1:U, 2:L, 3:D)\n\n  # Get the integer ID for the target primitive from the cookbook index.\n  # If the primitive name is not recognized, return an empty list as it cannot be collected.\n  try:\n    primitive_id = current_state.world.cookbook.index[primitive]\n  except KeyError:\n    return []\n  \n  # Get grid dimensions for boundary checks\n  GRID_WIDTH, GRID_HEIGHT, _ = initial_grid.shape\n\n  # Map DSL movement/turn actions to their integer indices from env.action_specs()\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP'] # 'UP' is typically used for 'move forward' in DMLab-style\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define changes in (row, col) for each direction when moving forward.\n  # Direction mapping: 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col + 1)\n      1: (-1, 0),  # Facing UP: (row - 1, col)\n      2: (0, -1),  # Facing LEFT: (row, col - 1)\n      3: (1, 0)    # Facing DOWN: (row + 1, col)\n  }\n\n  # Define how the agent's direction changes when turning left/right.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}   # R -> U -> L -> D -> R (Counter-clockwise)\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}  # R -> D -> L -> U -> R (Clockwise)\n\n  # Compile a set of entity kinds that block agent movement.\n  # This includes non-grabbable items like boundaries, water, workshops.\n  # Crucially, the primitive itself is added here, as the agent must stop *adjacent* to it,\n  # not step onto its square, before using it.\n  non_walkable_kind_ids = current_state.world.non_grabbable_indices.copy()\n  non_walkable_kind_ids.add(primitive_id) # Agent cannot walk ONTO the primitive\n\n  # BFS state is represented by ( (row, col), direction ).\n  # The queue stores tuples: ( (current_position, current_direction), list_of_actions_to_reach_here ).\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # The visited set stores (position, direction) tuples to prevent revisiting states and infinite loops.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the sequence of actions once the goal state is found.\n\n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the agent is in the \"goal state\": adjacent to and facing the primitive.\n      # Calculate the coordinates of the cell directly in front of the agent.\n      dr_front, dc_front = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + dr_front, c + dc_front\n      \n      # Check if the cell in front is within grid bounds.\n      if (0 <= front_r < GRID_WIDTH and 0 <= front_c < GRID_HEIGHT):\n          # If the cell in front contains the target primitive, we've found our path.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_so_far # The path to reach this state\n              break # Shortest path found, exit BFS.\n\n      # 2. Explore possible next actions (Move Forward, Turn Left, Turn Right) from the current state.\n      \n      # --- Try Move Forward ---\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change the agent's facing direction.\n\n      # Check if the next position is within bounds and if this (pos, dir) state hasn't been visited.\n      if (0 <= next_r < GRID_WIDTH and 0 <= next_c < GRID_HEIGHT and\n          (next_pos, next_dir) not in visited):\n          \n          # Check if the next position is walkable (i.e., it does not contain any obstacle kind).\n          is_walkable_cell = True\n          for kind_idx in non_walkable_kind_ids:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable_cell = False\n                  break\n          \n          if is_walkable_cell:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_so_far + [MOVE_FORWARD_ACTION]))\n\n      # --- Try Turn Left ---\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning changes only direction, not position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_so_far + [TURN_LEFT_ACTION]))\n\n      # --- Try Turn Right ---\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning changes only direction, not position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_so_far + [TURN_RIGHT_ACTION]))\n\n  # If a path to the goal state (adjacent and facing primitive) was found, append the USE action.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T09:33:16.316718", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n  This version refines variable naming for clarity and removes minor redundancies,\n  while maintaining the robust BFS pathfinding logic from v1.\n  It finds the shortest sequence of actions to position the agent directly\n  facing the target primitive, and then appends the 'USE' action.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  agent_initial_pos = current_state.pos # tuple (r, c)\n  agent_initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  # Get the integer ID for the target primitive from the cookbook's index.\n  primitive_kind_id = current_state.world.cookbook.index[primitive]\n  GRID_WIDTH, GRID_HEIGHT, _ = initial_grid.shape # Get grid dimensions\n\n  # Retrieve integer action codes from the environment's action specifications.\n  action_map = env.action_specs()\n  ACTION_MOVE_FORWARD = action_map['UP']\n  ACTION_TURN_LEFT = action_map['LEFT']\n  ACTION_TURN_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Mapping from agent's direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN) to\n  # the change in (row, column) for the cell directly in front of the agent.\n  # This delta is used for both moving forward and checking the 'use' target.\n  DIRECTION_TO_DELTA = {\n      0: (0, 1),   # Facing RIGHT: (row, col + 1)\n      1: (-1, 0),  # Facing UP: (row - 1, col)\n      2: (0, -1),  # Facing LEFT: (row, col - 1)\n      3: (1, 0)    # Facing DOWN: (row + 1, col)\n  }\n\n  # Mappings to update agent's direction when turning left or right.\n  TURN_LEFT_DIRECTION_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  TURN_RIGHT_DIRECTION_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # Identify entities that block agent movement.\n  # These are cells the agent cannot walk into.\n  impassable_cell_kind_ids = set(current_state.world.non_grabbable_indices)\n  \n  # If the primitive itself is a grabbable item (e.g., WOOD, STONE),\n  # the agent should not walk onto its tile to collect it; it needs to be adjacent and use it.\n  # Thus, add the primitive's ID to impassable kinds for movement calculation.\n  if primitive_kind_id in current_state.world.grabbable_indices:\n      impassable_cell_kind_ids.add(primitive_kind_id)\n  \n  # Initialize Breadth-First Search (BFS) for pathfinding.\n  # The queue stores tuples: `((current_position_tuple, current_direction_int), list_of_actions_to_reach_here)`\n  queue = collections.deque([((agent_initial_pos, agent_initial_dir), [])])\n  \n  # The `visited_states` set tracks (position, direction) pairs to prevent revisiting\n  # and ensure the shortest path is found by avoiding cycles.\n  visited_states = {(agent_initial_pos, agent_initial_dir)}\n\n  shortest_path_to_collect = None # This will store the action sequence if a collectible state is found.\n\n  # Main BFS loop: Continues until the queue is empty or a path is found.\n  while queue:\n      # Dequeue the current state and the path leading to it.\n      (current_agent_pos, current_agent_dir), current_path_actions = queue.popleft()\n      current_r, current_c = current_agent_pos\n\n      # Determine the coordinates of the cell directly in front of the agent based on current_agent_dir.\n      dr_front, dc_front = DIRECTION_TO_DELTA[current_agent_dir]\n      front_cell_r, front_cell_c = current_r + dr_front, current_c + dc_front\n\n      # GOAL CONDITION: Check if the cell directly in front is within grid boundaries\n      # AND contains the target primitive.\n      is_goal_state = False\n      if (0 <= front_cell_r < GRID_WIDTH and 0 <= front_cell_c < GRID_HEIGHT and\n          initial_grid[front_cell_r, front_cell_c, primitive_kind_id] > 0):\n          is_goal_state = True\n\n      # If the agent is in a state from which it can 'USE' the primitive,\n      # we have found our target path (which is the current_path_actions).\n      if is_goal_state:\n          shortest_path_to_collect = current_path_actions\n          break # Shortest path found, terminate BFS.\n\n      # Explore possible next states by applying valid actions: Move Forward, Turn Left, Turn Right.\n      \n      # 1. Try ACTION_MOVE_FORWARD:\n      # Calculate the next position if the agent moves forward.\n      next_agent_r, next_agent_c = current_r + dr_front, current_c + dc_front\n      next_agent_pos = (next_agent_r, next_agent_c)\n      next_agent_dir = current_agent_dir # Moving forward does not change the agent's facing direction.\n\n      # Check if the potential next position is valid (within grid bounds)\n      # and if this (position, direction) state has not been visited yet.\n      if (0 <= next_agent_r < GRID_WIDTH and 0 <= next_agent_c < GRID_HEIGHT and\n          (next_agent_pos, next_agent_dir) not in visited_states):\n          \n          # Check if the cell at `next_agent_pos` contains any impassable obstacle.\n          is_walkable_to_next_pos = True\n          for kind_idx in impassable_cell_kind_ids:\n              if initial_grid[next_agent_r, next_agent_c, kind_idx] > 0:\n                  is_walkable_to_next_pos = False\n                  break # This cell contains an obstacle, so it's not walkable.\n\n          if is_walkable_to_next_pos:\n              visited_states.add((next_agent_pos, next_agent_dir)) # Mark the new state as visited.\n              # Add the new state to the queue with the updated path.\n              queue.append(((next_agent_pos, next_agent_dir), current_path_actions + [ACTION_MOVE_FORWARD]))\n\n      # 2. Try ACTION_TURN_LEFT:\n      next_agent_dir_left = TURN_LEFT_DIRECTION_MAP[current_agent_dir]\n      # Turning only changes direction, not position.\n      if ((current_agent_pos, next_agent_dir_left) not in visited_states):\n          visited_states.add((current_agent_pos, next_agent_dir_left))\n          queue.append(((current_agent_pos, next_agent_dir_left), current_path_actions + [ACTION_TURN_LEFT]))\n\n      # 3. Try ACTION_TURN_RIGHT:\n      next_agent_dir_right = TURN_RIGHT_DIRECTION_MAP[current_agent_dir]\n      # Turning only changes direction, not position.\n      if ((current_agent_pos, next_agent_dir_right) not in visited_states):\n          visited_states.add((current_agent_pos, next_agent_dir_right))\n          queue.append(((current_agent_pos, next_agent_dir_right), current_path_actions + [ACTION_TURN_RIGHT]))\n\n  # After BFS completes:\n  # If a path to a collectable state (position + direction) was found (`shortest_path_to_collect` is not None),\n  # extend the actions list with this path and append the final 'USE' action.\n  if shortest_path_to_collect is not None:\n      actions_list.extend(shortest_path_to_collect)\n      actions_list.append(ACTION_USE)\n\n  return actions_list", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T09:33:17.667909", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n  This function finds the shortest sequence of actions for the agent to move to a\n  position and orientation from which it can 'USE' (collect) the specified primitive.\n  It uses a Breadth-First Search (BFS) to explore the state space (agent's\n  (row, column) position and facing direction) to guarantee the shortest path in terms of actions.\n\n  The \"target state\" for the BFS is defined as any state where the agent is\n  positioned directly adjacent to the primitive and is facing it.\n\n  Args:\n      env (env.CraftLab): The CraftLab object representing the current simulation environment.\n      primitive (str): The string name of the primitive item to collect (e.g., \"WOOD\", \"STONE\").\n\n  Returns:\n      List[int]: A list of integer action codes (e.g., [MOVE_FORWARD, TURN_LEFT, USE])\n                 that, when executed, will lead the agent to collect the primitive.\n                 Returns an empty list if the primitive cannot be found or collected.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state # Get the current state of the environment.\n\n  # Extract necessary information from the current state and world configuration.\n  initial_grid = current_state.grid # The grid representing the environment layout.\n  initial_pos = current_state.pos   # Agent's starting (row, column) coordinates.\n  initial_dir = current_state.dir   # Agent's starting direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN).\n\n  # Convert the primitive's string name to its integer ID using the world's cookbook index.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = initial_grid.shape # Get grid dimensions.\n\n  # Map action names to their corresponding integer codes as defined by the environment.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # 'UP' typically means move forward in current direction.\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']            # Action to interact with an object in front.\n\n  # Define how agent's coordinates change when moving forward, based on direction.\n  # (dr, dc) = (change in row, change in column)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT (0): move +1 in column.\n      1: (-1, 0),  # Facing UP (1): move -1 in row.\n      2: (0, -1),  # Facing LEFT (2): move -1 in column.\n      3: (1, 0)    # Facing DOWN (3): move +1 in row.\n  }\n\n  # Define how agent's direction changes when turning.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}   # Cycles: RIGHT -> UP -> LEFT -> DOWN -> RIGHT\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Cycles: RIGHT -> DOWN -> LEFT -> UP -> RIGHT\n\n  # Determine which entities act as movement obstacles.\n  # 1. Non-grabbable items (e.g., BOUNDARY, WATER, WORKSHOP_X) cannot be walked through.\n  obstacles_to_movement_indices = set(current_state.world.non_grabbable_indices)\n  \n  # 2. If the target primitive is a grabbable item (e.g., WOOD, STONE),\n  #    the agent must stand *adjacent* to it and 'USE' it, not walk *onto* its cell.\n  #    Therefore, its cell is treated as an obstacle for movement pathfinding.\n  if primitive_id in current_state.world.grabbable_indices:\n      obstacles_to_movement_indices.add(primitive_id)\n  \n  # Initialize BFS:\n  # Queue stores tuples: ((current_pos_tuple, current_dir_int), list_of_actions_taken_to_reach_here)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # Visited set stores (position_tuple, direction_int) pairs to avoid redundant exploration\n  # and guarantee finding the shortest path by preventing cycles.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # Will store the path once a collectible state is found.\n\n  # Start BFS exploration.\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos # Current row and column of the agent.\n\n      # Calculate the coordinates of the cell directly in front of the agent.\n      face_dr, face_dc = DIR_TO_DRDC[current_dir]\n      cell_in_front_r, cell_in_front_c = r + face_dr, c + face_dc\n\n      # Check if the cell in front is valid (within grid boundaries)\n      # and if it contains the target primitive.\n      is_primitive_in_front = False\n      if (0 <= cell_in_front_r < WIDTH and 0 <= cell_in_front_c < HEIGHT and\n          initial_grid[cell_in_front_r, cell_in_front_c, primitive_id] > 0):\n          is_primitive_in_front = True\n\n      # Goal check: If the agent is currently in a state from which it can 'USE' the primitive,\n      # then we have found the shortest path to a collection point.\n      if is_primitive_in_front:\n          target_path_actions = path_actions # Store the path leading to this state.\n          break # Shortest path found, terminate BFS.\n\n      # Explore all possible next actions from the current state: Move, Turn Left, Turn Right.\n\n      # 1. Attempt to Move Forward:\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir_move = current_dir # Direction doesn't change when moving forward.\n\n      # Check bounds and if the next state has already been visited.\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT and\n          (next_pos, next_dir_move) not in visited):\n          \n          # Check if the potential `next_pos` contains any movement obstacles.\n          is_walkable_to_next_pos = True\n          for kind_idx in obstacles_to_movement_indices:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable_to_next_pos = False\n                  break # Found an obstacle, cannot walk here.\n\n          if is_walkable_to_next_pos:\n              visited.add((next_pos, next_dir_move)) # Mark the new state as visited.\n              # Add the new state to the queue with the path updated by MOVE_FORWARD_ACTION.\n              queue.append(((next_pos, next_dir_move), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # 2. Attempt to Turn Left:\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # 3. Attempt to Turn Right:\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # After BFS completes:\n  # If a `target_path_actions` was found (meaning a way to get to a collectable state):\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions) # Add the movement/turn actions.\n      actions_list.append(USE_ACTION)          # Append the final 'USE' action to collect.\n\n  return actions_list", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T09:33:56.971991", "function_name": "collect", "function_body": "  current_state = env._current_state\n  \n  # Retrieve the integer index corresponding to the primitive name.\n  # Using `index[primitive]` returns None if not found, preventing errors\n  # if an invalid primitive name is passed, making the function more robust.\n  primitive_idx = env.world.cookbook.index[primitive] \n  if primitive_idx is None:\n    # If the primitive name is not recognized in the cookbook, it cannot be collected.\n    return []\n\n  # Get the integer mappings for all possible actions from the environment.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # --- Early Exit 1: Primitive already in inventory ---\n  # If the agent already possesses the desired primitive, no actions are needed.\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # --- Early Exit 2: Agent is already adjacent to the primitive ---\n  # If the primitive is within the agent's 3x3 neighborhood, a single 'USE' action\n  # is sufficient to collect it. This avoids complex pathfinding for simple cases.\n  if current_state.next_to(primitive_idx):\n    return [USE]\n\n  # --- Step 1: Locate all physical instances of the primitive on the grid ---\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  primitive_locations_on_grid = [] \n  for x in range(grid_width):\n    for y in range(grid_height):\n      # If the primitive's kind index at (x, y) has a value greater than 0,\n      # an instance of the primitive exists at this location.\n      if grid[x, y, primitive_idx] > 0:\n        primitive_locations_on_grid.append((x, y))\n\n  # If the primitive is not found anywhere on the map, it's currently unreachable.\n  if not primitive_locations_on_grid:\n    return []\n\n  # --- Step 2: Determine \"Target Collection Cells\" for BFS ---\n  # A \"target collection cell\" is any grid position from which the agent can\n  # successfully use the 'USE' action to collect the desired primitive.\n  # The `next_to` method implies that `USE` affects a 3x3 area.\n  # Therefore, for each primitive instance at (px, py), any cell (gx, gy)\n  # in its 3x3 neighborhood is a valid starting point for the 'USE' action.\n  target_collection_cells = set()\n  for px, py in primitive_locations_on_grid:\n    # Iterate through the 3x3 neighborhood relative to the primitive's location.\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        gx, gy = px + dx, py + dy # Calculate potential goal cell coordinates.\n        # Ensure the potential target cell is within the overall grid boundaries.\n        if 0 <= gx < grid_width and 0 <= gy < grid_height:\n          target_collection_cells.add((gx, gy))\n\n  # --- Step 3: Identify Impassable Terrain ---\n  # Define which environmental kinds (entities) block agent movement.\n  # The `non_grabbable_indices` include things like water, stone, and also workshops.\n  # However, workshops are typically traversable, so we exclude them.\n  impassable_environment_kinds = set(env.world.non_grabbable_indices) - set(env.world.workshop_indices)\n\n  # --- Step 4: Perform Breadth-First Search (BFS) for the shortest path ---\n  # The BFS aims to find the shortest sequence of movement actions from the agent's\n  # current position to any of the identified `target_collection_cells`.\n  start_pos = current_state.pos\n  \n  # BFS queue: Stores positions to visit.\n  bfs_queue = collections.deque([start_pos])\n  \n  # `visited_info` dictionary: {position: (parent_position, action_taken_to_reach_here)}.\n  # This allows for efficient path reconstruction by backtracking from the found goal.\n  visited_info = {start_pos: (None, None)} \n\n  # Define all possible cardinal movements and their corresponding action indices.\n  CARDINAL_MOVES_AND_ACTIONS = [\n      ((0, -1), UP),    # Move North (decreases Y-coordinate)\n      ((0, 1), DOWN),   # Move South (increases Y-coordinate)\n      ((-1, 0), LEFT),  # Move West (decreases X-coordinate)\n      ((1, 0), RIGHT),  # Move East (increases X-coordinate)\n  ]\n\n  found_goal_pos = None # Initialize to None; will be updated if a path is found.\n\n  while bfs_queue:\n    current_x, current_y = bfs_queue.popleft() \n    current_pos = (current_x, current_y)\n\n    # If the current cell is one of our target collection cells, we've found the shortest path.\n    if current_pos in target_collection_cells:\n      found_goal_pos = current_pos\n      break # Exit BFS as the shortest path to a goal cell has been found.\n\n    # Explore all four cardinal neighbors from the current cell.\n    for (dx, dy), action_to_take in CARDINAL_MOVES_AND_ACTIONS:\n      next_x, next_y = current_x + dx, current_y + dy # Calculate coordinates of the next cell.\n      next_pos = (next_x, next_y)\n\n      # 1. Boundary Check: Ensure the next cell is within the grid dimensions.\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue # Skip if the next position is out of bounds.\n\n      # 2. Impassability Check: Determine if the next cell is traversable.\n      # A cell is traversable if it does NOT contain any entity from the `impassable_environment_kinds`.\n      is_next_cell_impassable = False\n      for kind_idx in impassable_environment_kinds:\n          # If the grid cell at (next_x, next_y) contains a count (>0) of an impassable kind,\n          # then this cell cannot be moved into.\n          if grid[next_x, next_y, kind_idx] > 0: \n              is_next_cell_impassable = True\n              break # Found an impassable kind, no need to check further for this cell.\n      \n      if is_next_cell_impassable:\n          continue # Skip this move if the cell is impassable.\n\n      # 3. Visited Check: Ensure the next cell has not been visited yet in this BFS.\n      if next_pos not in visited_info:\n        visited_info[next_pos] = (current_pos, action_to_take) # Store parent and action for path reconstruction.\n        bfs_queue.append(next_pos) # Enqueue the next position for exploration.\n\n  # --- Step 5: Path Reconstruction ---\n  # If BFS completed and a path to a target collection cell was found:\n  if found_goal_pos:\n    path_actions = []\n    current_path_pos = found_goal_pos\n    # Backtrack from the `found_goal_pos` to the `start_pos` using parent pointers.\n    while current_path_pos != start_pos:\n      parent_pos, action_from_parent = visited_info[current_path_pos]\n      path_actions.append(action_from_parent)\n      current_path_pos = parent_pos\n    \n    # The path was built in reverse order (from goal to start), so reverse it\n    # to get the correct sequence of actions from start to goal.\n    path_actions.reverse() \n\n    # Append the 'USE' action at the very end to collect the primitive,\n    # now that the agent has reached the correct position.\n    return path_actions + [USE]\n  else:\n    # If the BFS completes (queue becomes empty) and no path to a target cell was found,\n    # it means the primitive is currently unreachable from the agent's starting position.\n    return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T09:33:58.082017", "function_name": "collect", "function_body": "  current_state = env._current_state\n  \n  # Retrieve the integer index corresponding to the primitive name.\n  # Using __getitem__ (e.g., index[primitive]) will return None if not present,\n  # which is handled to immediately return an empty list of actions.\n  primitive_idx = env.world.cookbook.index[primitive] \n  if primitive_idx is None:\n    # Primitive name is not recognized in the game's index.\n    return []\n\n  # --- V2 Improvement: Check if the primitive is already in inventory ---\n  # If the agent's inventory already contains at least one instance of the primitive,\n  # there's no need to take any actions to collect it. This optimizes the process\n  # by avoiding redundant movement and use actions.\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # Get the integer mappings for all possible actions from the environment.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # --- Check for immediate collection ---\n  # If the agent is already adjacent to (within the 3x3 neighborhood of) the primitive,\n  # the most efficient action is just to 'USE' it.\n  if current_state.next_to(primitive_idx):\n    return [USE]\n\n  # --- Locate all occurrences of the primitive on the grid ---\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  # List to store (x, y) coordinates of all cells containing the primitive.\n  primitive_locations_on_grid = [] \n  for x in range(grid_width):\n    for y in range(grid_height):\n      # If the primitive's layer at (x, y) has a value greater than 0, it exists there.\n      if grid[x, y, primitive_idx] > 0:\n        primitive_locations_on_grid.append((x, y))\n\n  # If the primitive is not found anywhere on the map, it's unreachable.\n  if not primitive_locations_on_grid:\n    return []\n\n  # --- Determine \"Goal Cells\" for BFS ---\n  # A \"goal cell\" is any grid location from which the agent can successfully\n  # apply the 'USE' action to collect the target primitive. This corresponds\n  # to any cell (gx, gy) such that a primitive (px, py) is within its 3x3\n  # neighborhood (inclusive of the center cell).\n  target_collection_cells = set()\n  for px, py in primitive_locations_on_grid:\n    # Iterate through the 3x3 neighborhood around each primitive instance.\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        gx, gy = px + dx, py + dy \n        # Ensure the potential goal cell (gx, gy) is within the grid boundaries.\n        if 0 <= gx < grid_width and 0 <= gy < grid_height:\n          target_collection_cells.add((gx, gy))\n\n  # --- Define impassable terrain for agent movement ---\n  # Non-grabbable items that are *not* workshops are generally considered impassable.\n  # Workshops (e.g., BENCH) are typically traversable even though they cannot be picked up.\n  impassable_environment_kinds = set(env.world.non_grabbable_indices) - set(env.world.workshop_indices)\n\n  # --- Perform Breadth-First Search (BFS) for the shortest path ---\n  # The BFS aims to find the shortest sequence of movement actions from the agent's\n  # current position to any of the identified `target_collection_cells`.\n  start_pos = current_state.pos\n  \n  # BFS queue: Stores positions to visit.\n  bfs_queue = collections.deque([start_pos])\n  \n  # `visited_info` dictionary: Stores {position: (parent_position, action_to_reach_current_pos)}.\n  # This allows reconstructing the path by backtracking from the found goal.\n  visited_info = {start_pos: (None, None)} \n\n  # Define all possible cardinal movement directions and their corresponding action indices.\n  CARDINAL_MOVES_AND_ACTIONS = [\n      ((0, -1), UP),    # Move North (decreases Y coordinate)\n      ((0, 1), DOWN),   # Move South (increases Y coordinate)\n      ((-1, 0), LEFT),  # Move West (decreases X coordinate)\n      ((1, 0), RIGHT),  # Move East (increases X coordinate)\n  ]\n\n  found_goal_pos = None\n\n  while bfs_queue:\n    current_x, current_y = bfs_queue.popleft() \n    current_pos = (current_x, current_y)\n\n    # If the current position is one of our target collection cells, we've found the shortest path.\n    if current_pos in target_collection_cells:\n      found_goal_pos = current_pos\n      break # Exit BFS, as the shortest path to a goal cell is found.\n\n    # Explore all four cardinal neighbors from the current cell.\n    for (dx, dy), action_to_take in CARDINAL_MOVES_AND_ACTIONS:\n      next_x, next_y = current_x + dx, current_y + dy # Calculate the coordinates of the next cell.\n      next_pos = (next_x, next_y)\n\n      # 1. Boundary Check: Ensure the next cell is within the grid dimensions.\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue # Skip if out of bounds.\n\n      # 2. Impassability Check: Determine if the next cell is traversable.\n      # A cell is traversable if it does NOT contain any impassable environment kind.\n      is_next_cell_impassable = False\n      for kind_idx in impassable_environment_kinds:\n          # If the grid cell at (next_x, next_y) contains a count (>0) of an impassable kind,\n          # then this cell cannot be moved into.\n          if grid[next_x, next_y, kind_idx] > 0: \n              is_next_cell_impassable = True\n              break # Found an impassable kind, no need to check further.\n      \n      if is_next_cell_impassable:\n          continue # Skip this cell if it's impassable.\n\n      # 3. Visited Check: Ensure the next cell has not been visited before in this BFS path.\n      if next_pos not in visited_info:\n        visited_info[next_pos] = (current_pos, action_to_take) # Store parent and action for path reconstruction.\n        bfs_queue.append(next_pos) # Enqueue the next position.\n\n  # If BFS completed and no path to a goal cell was found (i.e., found_goal_pos is None\n  # or it wasn't a valid target collection cell, which implies BFS didn't reach one),\n  # it means the primitive is currently unreachable from the agent's position.\n  if found_goal_pos is None or found_goal_pos not in target_collection_cells:\n    return []\n\n  # --- Reconstruct the path from start_pos to found_goal_pos ---\n  path_actions = []\n  current_path_pos = found_goal_pos\n  # Backtrack from the goal position until the start position is reached.\n  while current_path_pos != start_pos:\n    parent_pos, action_from_parent = visited_info[current_path_pos]\n    path_actions.append(action_from_parent)\n    current_path_pos = parent_pos\n  \n  # The path was built in reverse order (from goal to start), so reverse it\n  # to get the correct sequence of actions from start to goal.\n  path_actions.reverse() \n\n  # Append the 'USE' action at the very end to collect the primitive,\n  # now that the agent is in the correct position.\n  return path_actions + [USE]", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T09:34:34.439760", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  \n  # Get the integer ID for the target primitive from the cookbook index.\n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  # --- Improvement for collect_v2: Early exit if the primitive is already in inventory. ---\n  # If the agent already possesses the desired primitive, no further actions are needed.\n  if current_state.inventory[primitive_id] > 0:\n      return []\n\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's current (row, column) tuple\n  initial_dir = current_state.dir # Agent's current facing direction (0:Right, 1:Up, 2:Left, 3:Down)\n\n  num_rows, num_cols, _ = initial_grid.shape # Extract grid dimensions\n\n  # Map symbolic actions from action_specs to their integer indices.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP'] # 'UP' in action_specs typically means \"move forward\"\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define changes in (row, col) for each direction (0:Right, 1:Up, 2:Left, 3:Down).\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: +1 to column (col)\n      1: (-1, 0),  # Facing UP: -1 to row (row)\n      2: (0, -1),  # Facing LEFT: -1 to column (col)\n      3: (1, 0)    # Facing DOWN: +1 to row (row)\n  }\n\n  # Define how direction changes when turning left or right.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Get indices of entities that block agent movement (non-grabbable terrain/objects).\n  non_grabbable_indices = current_state.world.non_grabbable_indices\n  \n  # Create a set of non-walkable indices for efficient lookups during BFS.\n  # The primitive itself is typically not walkable, as the agent needs to be adjacent to collect it.\n  non_walkable_for_movement_set = set(non_grabbable_indices)\n  non_walkable_for_movement_set.add(primitive_id)\n  \n  # Convert to a numpy array once for efficient grid checking during BFS.\n  # This is an optimization for potentially faster checks compared to iterating a Python set.\n  non_walkable_for_movement_array = np.array(list(non_walkable_for_movement_set), dtype=int)\n\n\n  # BFS initialization:\n  # queue: stores ( (current_position_tuple, current_direction_int), list_of_actions_to_reach_here )\n  # visited: stores (position_tuple, direction_int) pairs to prevent redundant exploration and cycles.\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # This will store the action sequence leading to the state\n                              # where the agent is adjacent to the primitive and facing it.\n\n  while queue:\n      (current_pos, current_dir), path_to_current_state = queue.popleft()\n      r, c = current_pos\n\n      # 1. Goal Check: Is the primitive directly in front of the agent at the current state?\n      # Calculate the coordinates of the cell directly in front of the agent.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the cell in front is within grid bounds AND contains the primitive.\n      # We check the `initial_grid` because the BFS is finding a path through the static environment.\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols and\n          initial_grid[front_r, front_c, primitive_id] > 0):\n          \n          target_path_actions = path_to_current_state\n          break # Found the shortest path to be adjacent and facing the primitive.\n\n      # 2. Explore possible next actions from the current state (Move Forward, Turn Left, Turn Right).\n      \n      # --- Try Move Forward ---\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction.\n\n      # Check if the next position is within grid boundaries.\n      if (0 <= next_r < num_rows and 0 <= next_c < num_cols):\n          # Check if this specific (position, direction) state has not been visited yet.\n          if (next_pos, next_dir) not in visited:\n              # Check if the next position is walkable.\n              # A cell is not walkable if it contains any of the blocking kinds (e.g., boundary, water, workshop,\n              # or the primitive itself as agent needs to stand *adjacent* to collect).\n              is_walkable = not np.any(initial_grid[next_r, next_c, non_walkable_for_movement_array] > 0)\n              \n              if is_walkable:\n                  visited.add((next_pos, next_dir)) # Mark this state as visited.\n                  # Add the new state to the queue with the updated path of actions.\n                  queue.append(((next_pos, next_dir), path_to_current_state + [MOVE_FORWARD_ACTION]))\n\n      # --- Try Turn Left ---\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if (current_pos, next_dir_left) not in visited:\n          visited.add((current_pos, next_dir_left)) # Mark as visited.\n          queue.append(((current_pos, next_dir_left), path_to_current_state + [TURN_LEFT_ACTION]))\n\n      # --- Try Turn Right ---\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if (current_pos, next_dir_right) not in visited:\n          visited.add((current_pos, next_dir_right)) # Mark as visited.\n          queue.append(((current_pos, next_dir_right), path_to_current_state + [TURN_RIGHT_ACTION]))\n\n  # If a path was found to reach an adjacent and facing position, append the final USE action.\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 1, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T09:34:35.549229", "function_name": "collect", "function_body": "", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-08-01T09:35:46.505971", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` by ensuring robust pathfinding and collection logic.\n  This function uses Breadth-First Search (BFS) to find the shortest sequence of\n  actions (moves and turns) to position the agent directly in front of the\n  specified primitive, and then includes the 'USE' action to collect it.\n\n    Args:\n        env (env.CraftLab): The CraftLab object representing the current simulation environment.\n        primitive (str): The string name of the primitive item to be collected.\n\n    Returns:\n        List[int]: A sequence of integer action IDs that, when executed, lead\n                   the agent to collect the specified primitive. Returns an empty\n                   list if the primitive is uncollectible or unreachable.\n  \"\"\"\n  actions_list = [] # This will store the final sequence of actions to be returned.\n  \n  # Retrieve the current state of the environment.\n  current_state = env._current_state \n  initial_grid = current_state.grid       # The 3D NumPy array representing the world grid at search start.\n  initial_pos = current_state.pos         # Agent's initial (row, col) coordinates.\n  initial_dir = current_state.dir         # Agent's initial facing direction (0:Right, 1:Up, 2:Left, 3:Down).\n\n  # Determine grid dimensions for boundary checks and traversal logic.\n  GRID_ROWS, GRID_COLS, _ = initial_grid.shape\n\n  # 1. Validate Primitive: Ensure the primitive exists and is grabbable.\n  # The cookbook's index maps string names to integer IDs.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # A primitive can only be collected if its ID is explicitly listed in the\n  # world's `grabbable_indices`. If not, it might be an unmovable object\n  # (like water, workshops, or boundaries) or an item that needs crafting.\n  if primitive_id not in current_state.world.grabbable_indices:\n      return [] # Uncollectible primitive, return an empty action list.\n\n  # 2. Map Action Names to Integer IDs: Standard actions in CraftLab.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # 'UP' translates to moving one step forward relative to agent's direction.\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']            # The action to pick up or interact with the item in front.\n\n  # 3. Define Directional Transformations: How agent's position and direction change.\n  # `DIR_TO_DRDC`: Maps agent's direction (0-3) to a change in (row, column) for a forward move.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Right: +col\n      1: (-1, 0),  # Up: -row\n      2: (0, -1),  # Left: -col\n      3: (1, 0)    # Down: +row\n  }\n  # `TURN_LEFT_MAP`: Defines the new direction after a counter-clockwise turn.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0} # Right -> Up -> Left -> Down -> Right\n  # `TURN_RIGHT_MAP`: Defines the new direction after a clockwise turn.\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Cache non-walkable entity indices. These are entities the agent cannot traverse through.\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # 4. Define Helper Functions for BFS Pathfinding.\n\n  def _is_valid_coord(r: int, c: int) -> bool:\n      \"\"\"Checks if the given (row, col) coordinates are within the grid boundaries.\"\"\"\n      return 0 <= r < GRID_ROWS and 0 <= c < GRID_COLS\n\n  def _is_walkable_cell(pos: tuple[int, int]) -> bool:\n      \"\"\"\n      Determines if the agent can move into a specific cell (`pos`).\n      A cell is considered walkable if it's within bounds and does not contain:\n      - Any non-grabbable (blocking) entity like water, workshops, or boundaries.\n      - The `primitive_id` itself, as the agent needs to be *adjacent* to collect,\n        not on top of, the item.\n      \"\"\"\n      r, c = pos\n      if not _is_valid_coord(r, c):\n          return False\n      \n      # Check if the cell contains any known blocking obstacles.\n      for kind_idx in non_walkable_kinds_indices:\n          if initial_grid[r, c, kind_idx] > 0:\n              return False # Obstacle found, cell is not walkable.\n      \n      # Crucially, the agent cannot walk *onto* the primitive it wants to collect.\n      # The 'USE' action operates on the cell *in front* of the agent.\n      if initial_grid[r, c, primitive_id] > 0:\n          return False # Target primitive is here, agent cannot occupy this spot.\n          \n      return True # Cell is clear for movement.\n\n  def _is_target_facing_state(pos: tuple[int, int], current_dir: int) -> bool:\n      \"\"\"\n      Checks if, from the current agent `pos` and `current_dir`, the target\n      `primitive_id` is located in the cell directly in front, meaning a 'USE'\n      action would successfully collect it.\n      \"\"\"\n      r, c = pos\n      # Calculate coordinates of the cell directly in front.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n\n      if not _is_valid_coord(front_r, front_c):\n          return False # Cell in front is out of bounds.\n      \n      # Check if the primitive exists (quantity > 0) in that front cell.\n      return initial_grid[front_r, front_c, primitive_id] > 0\n\n  # 5. Breadth-First Search (BFS) Implementation for Shortest Path.\n  # BFS guarantees finding the shortest path in terms of number of actions,\n  # as all actions (move, turn) have an implied cost of 1.\n\n  # `queue`: Stores tuples of `(agent_state, path_to_state)`.\n  #   `agent_state` is `((row, col), direction)`.\n  #   `path_to_state` is a list of integer action IDs leading to this state.\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # `visited`: Stores `agent_state` tuples to prevent redundant computations and cycles.\n  visited = {(initial_pos, initial_dir)}\n\n  # This variable will store the action sequence (excluding the final 'USE' action)\n  # that leads the agent to a position where it can collect the primitive.\n  path_to_collection_spot = None \n\n  # Optimization: Check if the agent is already in the 'ready-to-use' state.\n  if _is_target_facing_state(initial_pos, initial_dir):\n      path_to_collection_spot = [] # No movement actions needed, directly ready for 'USE'.\n\n  # If not already at the collection spot, start the BFS.\n  if path_to_collection_spot is None:\n      while queue:\n          (current_pos, current_dir), current_path = queue.popleft()\n          \n          # Explore all valid next actions: Move Forward, Turn Left, Turn Right.\n\n          # --- 5a. Explore Move Forward ---\n          move_dr, move_dc = DIR_TO_DRDC[current_dir]\n          next_r_fwd, next_c_fwd = current_pos[0] + move_dr, current_pos[1] + move_dc\n          next_pos_fwd = (next_r_fwd, next_c_fwd)\n          next_dir_fwd = current_dir # Direction doesn't change when moving.\n\n          if _is_walkable_cell(next_pos_fwd):\n              next_state_fwd = (next_pos_fwd, next_dir_fwd)\n              if next_state_fwd not in visited:\n                  visited.add(next_state_fwd)\n                  new_path_fwd = current_path + [MOVE_FORWARD_ACTION]\n                  \n                  # Check if moving forward leads to the target-facing state.\n                  if _is_target_facing_state(next_pos_fwd, next_dir_fwd):\n                      path_to_collection_spot = new_path_fwd\n                      break # Shortest path found, terminate BFS.\n                  \n                  queue.append((next_state_fwd, new_path_fwd))\n\n          # --- 5b. Explore Turn Left ---\n          next_dir_left = TURN_LEFT_MAP[current_dir]\n          # Position remains the same when turning.\n          new_state_left = (current_pos, next_dir_left) \n          \n          if new_state_left not in visited:\n              visited.add(new_state_left)\n              new_path_left = current_path + [TURN_LEFT_ACTION]\n              \n              # Check if turning left leads to the target-facing state.\n              if _is_target_facing_state(current_pos, next_dir_left):\n                  path_to_collection_spot = new_path_left\n                  break # Shortest path found, terminate BFS.\n              \n              queue.append((new_state_left, new_path_left))\n\n          # --- 5c. Explore Turn Right ---\n          next_dir_right = TURN_RIGHT_MAP[current_dir]\n          # Position remains the same when turning.\n          new_state_right = (current_pos, next_dir_right)\n          \n          if new_state_right not in visited:\n              visited.add(new_state_right)\n              new_path_right = current_path + [TURN_RIGHT_ACTION]\n              \n              # Check if turning right leads to the target-facing state.\n              if _is_target_facing_state(current_pos, next_dir_right):\n                  path_to_collection_spot = new_path_right\n                  break # Shortest path found, terminate BFS.\n              \n              queue.append((new_state_right, new_path_right))\n      \n  # 6. Construct the Final Action List.\n  # If BFS successfully found a path to a collection-ready state, append the 'USE' action.\n  if path_to_collection_spot is not None:\n      actions_list.extend(path_to_collection_spot)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T09:35:47.811711", "function_name": "collect", "function_body": "  \"\"\"Finds the shortest sequence of actions to move the agent to a position where\n  it can collect the specified primitive and then performs the collection.\n\n  This function uses Breadth-First Search (BFS) to find the optimal path\n  to a cell adjacent to the primitive, followed by a 'USE' action.\n\n  Args:\n      env (env.CraftLab): The CraftLab environment instance.\n      primitive (str): The string name of the primitive item to collect (e.g., \"WOOD\", \"IRON\").\n\n  Returns:\n      List[int]: A list of integer action codes (from env.action_specs())\n                 representing the path to the primitive and the final 'USE' action.\n                 Returns an empty list if the primitive cannot be found or collected.\n  \"\"\"\n  # 1. Initialize State Information\n  # Retrieve the current state of the environment from the CraftLab wrapper.\n  current_state = env._current_state \n  \n  # Get a snapshot of the grid (world layout) and agent's initial position and direction.\n  # The grid is a 3D NumPy array: (ROWS, COLS, KINDS).\n  # The search will be performed on this static grid snapshot.\n  grid_snapshot = current_state.grid       \n  agent_start_pos = current_state.pos      # (row, col) tuple.\n  agent_start_dir = current_state.dir      # Integer: 0=Right, 1=Up, 2=Left, 3=Down.\n\n  # Determine grid dimensions for boundary checks during pathfinding.\n  GRID_ROWS, GRID_COLS, _ = grid_snapshot.shape \n\n  # 2. Resolve Primitive ID and Validate Collectability\n  # Convert the human-readable primitive name (e.g., \"WOOD\") into its unique\n  # integer identifier as understood by the game engine.\n  # The DSL ensures 'primitive' is a valid name, so KeyError is unlikely if index is populated.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Crucial check: Can this primitive actually be picked up?\n  # Only items in `grabbable_indices` can be collected with the 'USE' action.\n  # Examples of non-grabbable items include \"water\", \"workshop\", \"boundary\".\n  if primitive_id not in current_state.world.grabbable_indices: \n      # If the item cannot be grabbed, there's no sequence of actions to collect it.\n      return []\n\n  # 3. Map Symbolic Actions to Environment-Specific Integer IDs\n  # These are standard action mappings provided by the CraftLab environment.\n  action_mapping = env.action_specs()\n  ACTION_MOVE_FORWARD = action_mapping['UP']    # In CraftLab, 'UP' means move forward relative to direction.\n  ACTION_TURN_LEFT = action_mapping['LEFT']\n  ACTION_TURN_RIGHT = action_mapping['RIGHT']\n  ACTION_USE = action_mapping['USE']            # The action to pick up an item in front.\n\n  # 4. Define Agent Movement and Directional Logic\n  # `DIRECTION_VECTORS`: Maps agent's current direction to (delta_row, delta_col)\n  # to determine the coordinates of the cell directly in front when moving forward or using 'USE'.\n  DIRECTION_VECTORS = {\n      0: (0, 1),   # Right: (row, col + 1)\n      1: (-1, 0),  # Up: (row - 1, col)\n      2: (0, -1),  # Left: (row, col - 1)\n      3: (1, 0)    # Down: (row + 1, col)\n  }\n  \n  # `TURN_LEFT_MAP`: Defines how the agent's direction changes when turning left (counter-clockwise).\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0} # Right -> Up -> Left -> Down -> Right\n  \n  # `TURN_RIGHT_MAP`: Defines how the agent's direction changes when turning right (clockwise).\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Identify entities that act as physical obstacles in the environment.\n  # The agent cannot walk onto these cells. In CraftWorld, non-grabbable items often serve this purpose.\n  obstacle_kind_indices = current_state.world.non_grabbable_indices\n\n  # 5. Helper Functions for BFS Pathfinding Logic\n  def is_valid_grid_coordinate(r: int, c: int) -> bool:\n      \"\"\"Checks if the given (row, col) coordinates are within the bounds of the grid.\"\"\"\n      return 0 <= r < GRID_ROWS and 0 <= c < GRID_COLS\n\n  def is_cell_walkable(target_pos: tuple[int, int]) -> bool:\n      \"\"\"\n      Determines if the agent can physically move into the `target_pos`.\n      A cell is walkable if:\n      1. It's within grid boundaries.\n      2. It does not contain any obstacle entities (defined by `obstacle_kind_indices`).\n      3. It does not contain the `primitive_id` itself. The agent must stand *adjacent*\n         to the primitive to collect it, not on the same cell.\n      \"\"\"\n      r, c = target_pos\n      if not is_valid_grid_coordinate(r, c):\n          return False\n      \n      # Check if the cell contains any obstacle kind.\n      for kind_idx in obstacle_kind_indices:\n          if grid_snapshot[r, c, kind_idx] > 0:\n              return False # This cell is blocked by an obstacle.\n      \n      # Check if the cell contains the target primitive.\n      # Agent cannot walk onto the item it wishes to collect.\n      if grid_snapshot[r, c, primitive_id] > 0:\n          return False # This cell contains the primitive itself.\n          \n      return True # The cell is traversable.\n  \n  def is_primitive_in_front(agent_pos: tuple[int, int], agent_dir: int) -> bool:\n      \"\"\"\n      Checks if the `primitive_id` is in the grid cell immediately in front of the agent.\n      This defines the \"goal state\" for our pathfinding: when the agent is correctly\n      positioned and oriented to use the 'USE' action.\n      \"\"\"\n      r, c = agent_pos\n      # Calculate the coordinates of the cell directly ahead of the agent.\n      dr, dc = DIRECTION_VECTORS[agent_dir]\n      front_r, front_c = r + dr, c + dc\n      \n      # The cell in front must be valid and contain the primitive.\n      if not is_valid_grid_coordinate(front_r, front_c):\n          return False\n      \n      return grid_snapshot[front_r, front_c, primitive_id] > 0\n\n  # 6. Breadth-First Search (BFS) Implementation for Shortest Path\n  # BFS is used to find the shortest sequence of movement/turn actions.\n  # `pathfinding_queue`: Stores tuples of `(agent_state, list_of_actions_taken_to_reach_this_state)`.\n  # `agent_state` is represented as `((row, col), direction)`.\n  pathfinding_queue = collections.deque([((agent_start_pos, agent_start_dir), [])])\n  \n  # `visited_states`: A set to keep track of agent states that have already been explored.\n  # This prevents redundant computations and infinite loops in cyclic environments.\n  visited_states = {(agent_start_pos, agent_start_dir)}\n\n  # This variable will store the found path of movement/turn actions before the final 'USE'.\n  actions_to_reach_collection_spot = None \n\n  # Optimization: Check if the agent is already in the 'ready-to-collect' state at the very beginning.\n  if is_primitive_in_front(agent_start_pos, agent_start_dir):\n      actions_to_reach_collection_spot = [] # No movement actions needed, just 'USE'.\n\n  # If the agent is not immediately in position, start BFS to find the path.\n  if actions_to_reach_collection_spot is None:\n      while pathfinding_queue:\n          # Dequeue the current state and the path taken to reach it.\n          (current_pos, current_dir), current_path = pathfinding_queue.popleft()\n          \n          # Explore all possible actions from the current state:\n          # 1. Move Forward\n          # 2. Turn Left\n          # 3. Turn Right\n\n          # --- Explore Move Forward ---\n          move_dr, move_dc = DIRECTION_VECTORS[current_dir]\n          next_pos_after_move = (current_pos[0] + move_dr, current_pos[1] + move_dc)\n          next_dir_after_move = current_dir # Direction doesn't change when moving.\n          next_state_after_move = (next_pos_after_move, next_dir_after_move)\n\n          if is_cell_walkable(next_pos_after_move) and next_state_after_move not in visited_states:\n              # This is a new, valid, and unvisited state.\n              visited_states.add(next_state_after_move)\n              new_path_after_move = current_path + [ACTION_MOVE_FORWARD]\n              \n              # If this new state allows collection, we found the shortest path.\n              if is_primitive_in_front(next_pos_after_move, next_dir_after_move):\n                  actions_to_reach_collection_spot = new_path_after_move\n                  break # Exit BFS, shortest path found.\n              \n              # Otherwise, add to queue for further exploration.\n              pathfinding_queue.append((next_state_after_move, new_path_after_move))\n\n          # --- Explore Turn Left ---\n          next_dir_after_turn_left = TURN_LEFT_MAP[current_dir]\n          next_pos_after_turn_left = current_pos # Position remains unchanged.\n          next_state_after_turn_left = (next_pos_after_turn_left, next_dir_after_turn_left)\n\n          if next_state_after_turn_left not in visited_states:\n              # This is a new, unvisited state (change in direction only).\n              visited_states.add(next_state_after_turn_left)\n              new_path_after_turn_left = current_path + [ACTION_TURN_LEFT]\n              \n              # If this new orientation allows collection, we found the shortest path.\n              if is_primitive_in_front(next_pos_after_turn_left, next_dir_after_turn_left):\n                  actions_to_reach_collection_spot = new_path_after_turn_left\n                  break # Exit BFS.\n              \n              # Otherwise, add to queue.\n              pathfinding_queue.append((next_state_after_turn_left, new_path_after_turn_left))\n\n          # --- Explore Turn Right ---\n          next_dir_after_turn_right = TURN_RIGHT_MAP[current_dir]\n          next_pos_after_turn_right = current_pos # Position remains unchanged.\n          next_state_after_turn_right = (next_pos_after_turn_right, next_dir_after_turn_right)\n\n          if next_state_after_turn_right not in visited_states:\n              # This is a new, unvisited state (change in direction only).\n              visited_states.add(next_state_after_turn_right)\n              new_path_after_turn_right = current_path + [ACTION_TURN_RIGHT]\n              \n              # If this new orientation allows collection, we found the shortest path.\n              if is_primitive_in_front(next_pos_after_turn_right, next_dir_after_turn_right):\n                  actions_to_reach_collection_spot = new_path_after_turn_right\n                  break # Exit BFS.\n              \n              # Otherwise, add to queue.\n              pathfinding_queue.append((next_state_after_turn_right, new_path_after_turn_right))\n      \n  # 7. Construct the Final Action Sequence\n  final_actions = []\n  if actions_to_reach_collection_spot is not None:\n      # If a path was found to a state where the primitive is in front,\n      # append that path to the final actions list.\n      final_actions.extend(actions_to_reach_collection_spot)\n      # Finally, add the 'USE' action to collect the primitive.\n      final_actions.append(ACTION_USE)\n\n  return final_actions", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T09:36:58.505913", "function_name": "collect", "function_body": "  \"\"\"Returns a list of actions to find and collect a primitive in the passed env.\n    This version refines `collect_v1` by correctly accounting for agent orientation\n    when performing the 'USE' action, ensuring the agent faces the target primitive.\n    \n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect (e.g., \"WOOD\", \"WATER\").\n\n    Returns:\n        List[int]: A sequence of action indices to execute. Returns an empty list\n                   if the primitive is already collected (for grabbable items)\n                   or is unreachable.\n  \"\"\"\n  current_state = env._current_state\n  world = env.world\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  # 1. Map primitive name to its integer ID and action names to their IDs.\n  primitive_idx = world.cookbook.index.index(primitive)\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Define agent direction mapping (consistent with CraftState.dir):\n  DIR_NORTH = 0\n  DIR_EAST = 1\n  DIR_SOUTH = 2\n  DIR_WEST = 3\n\n  # Helper dictionary: vector from agent_pos to target_pos -> agent's required facing direction index\n  VEC_TO_DIR_INDEX = {\n      (0, -1): DIR_NORTH,  # Target is North of agent\n      (1, 0): DIR_EAST,    # Target is East of agent\n      (0, 1): DIR_SOUTH,   # Target is South of agent\n      (-1, 0): DIR_WEST,   # Target is West of agent\n  }\n\n  # Helper dictionary: Movement action -> resulting agent facing direction index\n  ACTION_TO_RESULTING_DIR_INDEX = {\n      UP: DIR_NORTH,\n      RIGHT: DIR_EAST,\n      DOWN: DIR_SOUTH,\n      LEFT: DIR_WEST,\n  }\n\n  # Define possible movement actions for BFS: (dx, dy), action_id, resulting_dir\n  MOVEMENT_ACTIONS = [\n      ((0, -1), UP, ACTION_TO_RESULTING_DIR_INDEX[UP]),     # Move North\n      ((0, 1), DOWN, ACTION_TO_RESULTING_DIR_INDEX[DOWN]),  # Move South\n      ((-1, 0), LEFT, ACTION_TO_RESULTING_DIR_INDEX[LEFT]), # Move West\n      ((1, 0), RIGHT, ACTION_TO_RESULTING_DIR_INDEX[RIGHT]),# Move East\n  ]\n\n  # 2. Early Exit 1: If the primitive is a 'grabbable' item and already in the agent's inventory.\n  if primitive_idx in world.grabbable_indices and current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # 3. Locate all instances of the primitive on the grid.\n  primitive_x_coords, primitive_y_coords = np.where(grid[:, :, primitive_idx] > 0)\n  primitive_locations = list(zip(primitive_x_coords, primitive_y_coords))\n\n  if not primitive_locations:\n    return [] # No primitive instances found on the grid\n\n  # 4. Define \"goal states\" for BFS. A goal state is (agent_x, agent_y, agent_direction)\n  # from which a single 'USE' action will collect the primitive.\n  goal_states = set()\n  # Define relative vectors for agent positions surrounding a primitive for collection.\n  # (dx_rel_to_primitive, dy_rel_to_primitive) describes agent's position relative to primitive.\n  AGENT_RELATIVE_POSITIONS_FOR_USE = [(-1, 0), (1, 0), (0, -1), (0, 1)] # W, E, N, S relative to primitive\n\n  for px, py in primitive_locations:\n    for dx_rel_to_primitive, dy_rel_to_primitive in AGENT_RELATIVE_POSITIONS_FOR_USE:\n      # Candidate agent position (gx, gy) to collect this primitive (px, py)\n      gx, gy = px + dx_rel_to_primitive, py + dy_rel_to_primitive\n\n      # Ensure this candidate agent position is within grid boundaries\n      if not (0 <= gx < grid_width and 0 <= gy < grid_height):\n        continue\n      \n      # The agent at (gx, gy) needs to face (px, py).\n      # Calculate the vector from the candidate agent position to the primitive position.\n      vec_from_agent_to_primitive = (px - gx, py - gy)\n      \n      # Determine the required agent direction to face the primitive\n      if vec_from_agent_to_primitive in VEC_TO_DIR_INDEX:\n        required_agent_dir = VEC_TO_DIR_INDEX[vec_from_agent_to_primitive]\n        goal_states.add((gx, gy, required_agent_dir))\n\n  if not goal_states:\n      return [] # No valid goal states can be formed\n\n  # 5. Identify impassable terrain.\n  impassable_kinds_indices = list(set(world.non_grabbable_indices) - set(world.workshop_indices))\n  \n  # 6. Perform Breadth-First Search (BFS) to find the shortest path.\n  # The BFS state is (x, y, current_direction_of_agent).\n  start_bfs_state = (current_state.pos[0], current_state.pos[1], current_state.dir)\n  \n  # BFS queue: stores (current_x, current_y, current_dir)\n  q = collections.deque([start_bfs_state]) \n  \n  # Visited paths: {(x, y, dir): (parent_x, parent_y, parent_dir, action_to_reach_here)}\n  visited_paths = {start_bfs_state: (None, None, None, None)}\n\n  found_goal_state = None\n\n  while q:\n    cx, cy, c_dir = q.popleft()\n    current_bfs_state = (cx, cy, c_dir)\n\n    # If the current state matches one of our goal states, we've found the shortest path.\n    if current_bfs_state in goal_states:\n      found_goal_state = current_bfs_state\n      break\n\n    # Explore valid next states by applying movement actions.\n    for (dx, dy), action_id, next_dir in MOVEMENT_ACTIONS:\n      nx, ny = cx + dx, cy + dy # Calculate new position\n      next_bfs_state = (nx, ny, next_dir) # New state includes new position AND new direction\n\n      # Check 1: Ensure new position is within grid boundaries.\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue\n\n      # Check 2: Determine if the new position is occupied by impassable terrain.\n      is_impassable_location = False\n      if impassable_kinds_indices:\n          is_impassable_location = np.any(grid[nx, ny, impassable_kinds_indices] > 0)\n      \n      if is_impassable_location:\n          continue\n\n      # Check 3: If this (position, direction) state has not been visited, add it to the queue.\n      if next_bfs_state not in visited_paths:\n        visited_paths[next_bfs_state] = (cx, cy, c_dir, action_id) # Store parent and action\n        q.append(next_bfs_state)\n\n  # 7. Reconstruct the path of actions if a goal state was found.\n  if found_goal_state is None:\n    return [] # No path found\n\n  path_actions = []\n  current_path_state = found_goal_state\n  \n  # Backtrack from the found goal state to the initial state\n  while current_path_state != start_bfs_state:\n    parent_x, parent_y, parent_dir, action_taken = visited_paths[current_path_state]\n    path_actions.append(action_taken)\n    current_path_state = (parent_x, parent_y, parent_dir)\n  \n  path_actions.reverse() # Path was built in reverse, so reverse it for correct order\n\n  # Append the 'USE' action at the end to collect the primitive.\n  return path_actions + [USE]", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T09:36:59.859703", "function_name": "collect", "function_body": "", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-08-01T09:37:53.161293", "function_name": "collect", "function_body": "  actions = []\n  \n  current_state = env._current_state \n  grid = current_state.grid\n  current_pos = current_state.pos\n  \n  # Get the integer ID of the primitive from the cookbook index\n  primitive_id = env.world.cookbook.index[primitive]\n\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Retrieve action mapping from the environment for robustness\n  _action_specs = env.action_specs()\n  ACTION_DOWN = _action_specs['DOWN']\n  ACTION_UP = _action_specs['UP']\n  ACTION_LEFT = _action_specs['LEFT']\n  ACTION_RIGHT = _action_specs['RIGHT']\n  ACTION_USE = _action_specs['USE']\n\n  # Define movement deltas for convenience corresponding to the actions\n  # (row_change, col_change)\n  MOVE_DELTAS = {\n      ACTION_UP: (-1, 0),\n      ACTION_DOWN: (1, 0),\n      ACTION_LEFT: (0, -1),\n      ACTION_RIGHT: (0, 1)\n  }\n\n  # 1. Immediate collection check: If the agent is already next to the primitive,\n  # a single 'USE' action is sufficient to collect/interact with it.\n  if current_state.next_to(primitive_id):\n      actions.append(ACTION_USE)\n      return actions\n\n  # 2. Find all locations of the target primitive on the grid using numpy.where.\n  # This provides a more concise and potentially efficient way to find all\n  # occurrences of the primitive compared to nested Python loops.\n  row_indices, col_indices = np.where(grid[:, :, primitive_id] == 1)\n  primitive_locations = list(zip(row_indices, col_indices))\n\n  # If the primitive is not found anywhere on the grid, it cannot be collected.\n  if not primitive_locations:\n      return []\n\n  # 3. Perform Breadth-First Search (BFS) to find the shortest path\n  #    to a cell from which the agent can \"USE\" the primitive.\n  #    A cell is \"usable\" if it is adjacent (Manhattan distance of 1) to any primitive location.\n  \n  # The queue stores tuples: ((current_row, current_col), [list_of_actions_to_reach_here])\n  q = collections.deque([(current_pos, [])]) \n  # The visited set keeps track of positions already explored to avoid cycles and redundant paths.\n  visited = {current_pos} \n\n  # This variable will store the shortest action sequence found to an adjacent cell.\n  shortest_path_to_adjacent_cell = None \n\n  while q:\n      (r, c), path = q.popleft()\n\n      # Check if the current BFS node (r, c) is adjacent to any of the primitive locations.\n      # This is the goal condition for our pathfinding: reaching a cell from which we can USE.\n      is_current_pos_adjacent_to_primitive = False\n      for pr, pc in primitive_locations:\n          # Manhattan distance of 1 (abs(dr) + abs(dc) == 1) indicates direct cardinal adjacency.\n          if abs(r - pr) + abs(c - pc) == 1: \n              shortest_path_to_adjacent_cell = path # Found the shortest path\n              is_current_pos_adjacent_to_primitive = True\n              break # Exit inner loop, we found an adjacent primitive\n      \n      if is_current_pos_adjacent_to_primitive:\n          break # Exit BFS, the shortest path to an 'usable' position is found\n\n      # Explore valid neighboring cells (UP, DOWN, LEFT, RIGHT) from the current position (r, c).\n      for action_dir, (dr, dc) in MOVE_DELTAS.items():\n          nr, nc = r + dr, c + dc # Calculate the coordinates of the potential new position\n\n          # Check 1: Ensure the new position is within the grid boundaries.\n          if not (0 <= nr < WIDTH and 0 <= nc < HEIGHT):\n              continue\n          \n          # Check 2: Ensure the new position has not been visited yet to find the shortest path.\n          if (nr, nc) in visited:\n              continue\n\n          # Check 3: Ensure the new position is traversable (not an obstacle).\n          # A cell is non-traversable if it contains any item whose kind index\n          # is in the world's `non_grabbable_indices` set (e.g., BOUNDARY, WATER, WORKSHOPS).\n          is_traversable = True\n          for kind_idx in env.world.non_grabbable_indices:\n              if grid[nr, nc, kind_idx] == 1: # If this cell contains a non-grabbable item\n                  is_traversable = False\n                  break # This neighbor is an obstacle\n          \n          if not is_traversable:\n              continue # Skip this neighbor if it's an obstacle\n          \n          # If the new position is valid and traversable, add it to the queue.\n          visited.add((nr, nc))\n          # Extend the current path with the action taken to reach this new neighbor.\n          q.append(((nr, nc), path + [action_dir]))\n    \n  # 4. Construct the final sequence of actions.\n  # If a path to an adjacent cell was found, extend the actions list with this path\n  # and then append a 'USE' action to actually collect/interact with the primitive.\n  if shortest_path_to_adjacent_cell is not None:\n      actions.extend(shortest_path_to_adjacent_cell)\n      actions.append(ACTION_USE) \n  \n  return actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T09:37:54.339887", "function_name": "collect", "function_body": "  actions = []\n  \n  current_state = env._current_state \n  grid = current_state.grid\n  current_pos = current_state.pos\n  \n  # Get the integer ID of the primitive from the cookbook index\n  primitive_id = env.world.cookbook.index[primitive]\n\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Retrieve action mapping from the environment for robustness\n  _action_specs = env.action_specs()\n  ACTION_DOWN = _action_specs['DOWN']\n  ACTION_UP = _action_specs['UP']\n  ACTION_LEFT = _action_specs['LEFT']\n  ACTION_RIGHT = _action_specs['RIGHT']\n  ACTION_USE = _action_specs['USE']\n\n  # Define movement deltas for convenience corresponding to the actions\n  # (row_change, col_change)\n  MOVE_DELTAS = {\n      ACTION_UP: (-1, 0),\n      ACTION_DOWN: (1, 0),\n      ACTION_LEFT: (0, -1),\n      ACTION_RIGHT: (0, 1)\n  }\n\n  # 1. Immediate collection check: If the agent is already next to the primitive\n  # (within its 3x3 neighborhood) and the primitive is grabbable,\n  # a single 'USE' action is sufficient to collect it without moving.\n  if current_state.next_to(primitive_id) and primitive_id in current_state.world.grabbable_indices:\n      actions.append(ACTION_USE)\n      return actions\n\n  # 2. Find all locations of the target primitive on the grid using numpy.where\n  # This is generally more efficient than manual nested loops.\n  row_indices, col_indices = np.where(grid[:, :, primitive_id] == 1)\n  primitive_locations = list(zip(row_indices, col_indices))\n\n  # If the primitive is not found anywhere on the grid, it cannot be collected.\n  if not primitive_locations:\n      return []\n\n  # 3. Perform Breadth-First Search (BFS) to find the shortest path\n  #    to a cell from which the agent can \"USE\" the primitive.\n  #    A cell is \"usable\" if it is adjacent (Manhattan distance 1) to a primitive location.\n  # The queue stores tuples: ((current_row, current_col), [list_of_actions_to_reach_here]).\n  q = collections.deque([(current_pos, [])]) \n  # The visited set keeps track of positions already explored to avoid cycles and redundant paths.\n  visited = {current_pos} \n\n  # This variable will store the shortest action sequence found to an adjacent cell.\n  shortest_path_to_adjacent_cell = None \n\n  while q:\n      (r, c), path = q.popleft()\n\n      # Check if the current BFS node (r, c) is adjacent to any of the primitive locations.\n      # This is the goal condition for our pathfinding: reaching a cell from which we can USE.\n      is_current_pos_adjacent_to_primitive = False\n      for pr, pc in primitive_locations:\n          # Manhattan distance of 1 means cells are directly adjacent (horizontally or vertically).\n          if abs(r - pr) + abs(c - pc) == 1: \n              shortest_path_to_adjacent_cell = path # Found the shortest path\n              is_current_pos_adjacent_to_primitive = True\n              break # Exit inner loop, we found an adjacent primitive\n      \n      if is_current_pos_adjacent_to_primitive:\n          break # Exit BFS, the shortest path to an 'usable' position is found\n\n      # Explore valid neighboring cells from the current position (r, c).\n      for action_dir, (dr, dc) in MOVE_DELTAS.items():\n          nr, nc = r + dr, c + dc # Calculate the coordinates of the potential new position\n          next_pos = (nr, nc)\n\n          # Check 1: Ensure the new position is within the grid boundaries.\n          if not (0 <= nr < WIDTH and 0 <= nc < HEIGHT):\n              continue\n          \n          # Check 2: Ensure the new position has not been visited yet to find shortest path.\n          if next_pos in visited:\n              continue\n\n          # Check 3: Ensure the new position is traversable (not an obstacle).\n          # A cell is non-traversable if it contains any item whose kind index\n          # is in the world's `non_grabbable_indices` set (e.g., BOUNDARY, WATER, WORKSHOPS).\n          is_traversable = True\n          for kind_idx in env.world.non_grabbable_indices:\n              if grid[nr, nc, kind_idx] == 1: # If this cell contains a non-grabbable item\n                  is_traversable = False\n                  break # This neighbor is an obstacle\n          \n          if not is_traversable:\n              continue # Skip this neighbor if it's an obstacle\n          \n          # If the new position is valid and traversable, add it to the queue.\n          visited.add(next_pos)\n          # Extend the current path with the action taken to reach this new neighbor.\n          q.append((next_pos, path + [action_dir]))\n    \n  # 4. Construct the final sequence of actions.\n  # If a path to an adjacent cell was found, extend the actions list with this path.\n  # Then, append a 'USE' action only if the primitive is a grabbable item\n  # (i.e., it can be added to the inventory upon 'USE'), aligning with the term \"collect\".\n  if shortest_path_to_adjacent_cell is not None:\n      actions.extend(shortest_path_to_adjacent_cell)\n      if primitive_id in current_state.world.grabbable_indices:\n          actions.append(ACTION_USE) \n  \n  return actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T09:38:48.907961", "function_name": "collect", "function_body": "  \"\"\"Returns a list of actions to find and collect the primitive in the passed env.\n    \n    This implementation uses Breadth-First Search (BFS) to find the shortest\n    sequence of movements and turns to reach a position adjacent to the primitive\n    and facing it, followed by a 'USE' action.\n\n    Improvements over v1:\n    - More concise direction update logic using modulo arithmetic, removing explicit maps.\n    - Encapsulated walkability check into a helper function for clarity and reusability.\n    - Explicit handling for unknown primitive names, returning an empty list if not found.\n    \n    Args:\n        env (env.CraftLab): The CraftLab object representing the current simulation state.\n        primitive (str): The name of the primitive resource to collect (e.g., \"WOOD\", \"STONE\").\n\n    Returns:\n        List[int]: A sequence of action indices (integers) to execute in the environment.\n                   Returns an empty list if the primitive is not recognized or unreachable.\n  \"\"\"\n  actions_to_take = []\n  \n  # Access the internal CraftState object which holds the current grid, position, and inventory.\n  current_state = env._current_state \n\n  # Get the integer ID for the target primitive from the cookbook index.\n  # This ID is used to locate the primitive on the grid.\n  try:\n      primitive_id = current_state.world.cookbook.index[primitive]\n  except KeyError:\n      # If the primitive name is not recognized by the world's cookbook,\n      # it cannot be collected. Return an empty list of actions.\n      # print(f\"Warning: Primitive '{primitive}' not found in cookbook index.\") # For debugging\n      return []\n\n  # Extract essential information for pathfinding from the current state.\n  grid_data = current_state.grid  # The static grid layout of the environment.\n  initial_agent_pos = current_state.pos    # Agent's current (row, col) position on the grid.\n  initial_agent_dir = current_state.dir    # Agent's current facing direction (0:Right, 1:Up, 2:Left, 3:Down).\n\n  # Get grid dimensions for boundary checks during pathfinding.\n  GRID_ROWS, GRID_COLS, _ = grid_data.shape \n\n  # Map action names (from DSL) to their integer indices (used by env.step).\n  action_ids = env.action_specs()\n  MOVE_FORWARD = action_ids['UP']    # Assumed to move agent one step in current direction.\n  TURN_LEFT = action_ids['LEFT']     # Rotates agent 90 degrees left (counter-clockwise).\n  TURN_RIGHT = action_ids['RIGHT']   # Rotates agent 90 degrees right (clockwise).\n  USE_ACTION = action_ids['USE']     # Interacts with the cell directly in front (collects primitive).\n\n  # Pre-defined changes in (row, col) coordinates for each direction.\n  # These deltas are applied to the agent's current position to find the cell\n  # directly in front of the agent (for 'USE' action) or where it would move.\n  # Directions: 0 (Right), 1 (Up), 2 (Left), 3 (Down).\n  DIR_DELTAS = {\n      0: (0, 1),   # Facing RIGHT: +1 to column (col + 1).\n      1: (-1, 0),  # Facing UP: -1 to row (row - 1).\n      2: (0, -1),  # Facing LEFT: -1 to column (col - 1).\n      3: (1, 0)    # Facing DOWN: +1 to row (row + 1).\n  }\n\n  # Set of entity kind IDs that represent non-walkable terrain.\n  # The agent cannot move into these cells. Examples: 'BOUNDARY', 'WATER', 'WORKSHOP'.\n  non_walkable_kind_ids = current_state.world.non_grabbable_indices\n\n  # Helper function to determine if a given grid cell is traversable by the agent.\n  def is_cell_walkable(r, c):\n      # Check if the coordinates are within the grid boundaries.\n      if not (0 <= r < GRID_ROWS and 0 <= c < GRID_COLS):\n          return False\n      \n      # Check if the cell contains any non-walkable entity (e.g., water, boundary).\n      for kind_idx in non_walkable_kind_ids:\n          if grid_data[r, c, kind_idx] > 0:\n              return False\n      \n      # The agent typically stands *next* to, not *on*, the primitive to collect it with 'USE'.\n      # So, a cell containing the target primitive is also considered non-walkable for agent's position.\n      if grid_data[r, c, primitive_id] > 0:\n          return False\n          \n      return True\n\n  # BFS Initialization:\n  # The queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_here).\n  queue = collections.deque([((initial_agent_pos, initial_agent_dir), [])])\n  \n  # The visited set stores (position_tuple, direction_int) to prevent redundant exploration\n  # and ensure that the first path found by BFS is indeed the shortest path.\n  visited_states = {(initial_agent_pos, initial_agent_dir)}\n\n  # Variable to store the actions leading to the state where the agent is adjacent to\n  # and facing the primitive. Initialized to None, indicating no path found yet.\n  path_to_adjacent_primitive = None \n\n  # Start BFS traversal.\n  while queue:\n      (current_pos, current_dir), path_history = queue.popleft()\n      current_r, current_c = current_pos\n\n      # 1. Check if the current state is a \"goal state\" for collection:\n      # A goal state is defined as being positioned such that the target primitive\n      # is directly in front of the agent (and thus can be collected with 'USE').\n      \n      # Calculate the coordinates of the cell directly in front of the agent.\n      front_dr, front_dc = DIR_DELTAS[current_dir]\n      cell_in_front_r, cell_in_front_c = current_r + front_dr, current_c + front_dc\n      \n      # Ensure the cell directly in front is within grid bounds.\n      if (0 <= cell_in_front_r < GRID_ROWS and 0 <= cell_in_front_c < GRID_COLS):\n          # Check if the cell in front contains the target primitive.\n          # The value grid_data[r, c, kind_id] > 0 means that 'kind_id' exists at (r,c).\n          if grid_data[cell_in_front_r, cell_in_front_c, primitive_id] > 0:\n              path_to_adjacent_primitive = path_history\n              break # Shortest path to a 'USE' position found! Exit BFS.\n\n      # 2. Explore possible next actions from the current state: Move, Turn Left, Turn Right.\n      # For each action, calculate the next state (position and direction) and check if it's valid and new.\n\n      # --- Try Move Forward ---\n      next_r_move, next_c_move = current_r + DIR_DELTAS[current_dir][0], current_c + DIR_DELTAS[current_dir][1]\n      next_pos_move = (next_r_move, next_c_move)\n      next_dir_move = current_dir # Direction remains the same after moving forward.\n\n      if is_cell_walkable(next_r_move, next_c_move):\n          next_state_move = (next_pos_move, next_dir_move)\n          if next_state_move not in visited_states:\n              visited_states.add(next_state_move)\n              queue.append((next_state_move, path_history + [MOVE_FORWARD]))\n\n      # --- Try Turn Left ---\n      # Calculate new direction for counter-clockwise rotation: (current_dir + 1) % 4\n      # e.g., 0 (R) -> 1 (U), 1 (U) -> 2 (L), 2 (L) -> 3 (D), 3 (D) -> 0 (R)\n      next_dir_left = (current_dir + 1) % 4\n      next_state_left = (current_pos, next_dir_left) # Position does not change when turning.\n      if next_state_left not in visited_states:\n          visited_states.add(next_state_left)\n          queue.append((next_state_left, path_history + [TURN_LEFT]))\n\n      # --- Try Turn Right ---\n      # Calculate new direction for clockwise rotation: (current_dir - 1 + 4) % 4\n      # Adding 4 ensures the result is positive before modulo for Python's % operator.\n      # e.g., 0 (R) -> 3 (D), 1 (U) -> 0 (R), 2 (L) -> 1 (U), 3 (D) -> 2 (L)\n      next_dir_right = (current_dir - 1 + 4) % 4 \n      next_state_right = (current_pos, next_dir_right) # Position does not change when turning.\n      if next_state_right not in visited_states:\n          visited_states.add(next_state_right)\n          queue.append((next_state_right, path_history + [TURN_RIGHT]))\n\n  # After BFS completes:\n  # If a path was found to a state where the agent is adjacent and facing the primitive,\n  # append the 'USE' action to complete the collection process.\n  if path_to_adjacent_primitive is not None:\n      actions_to_take.extend(path_to_adjacent_primitive)\n      actions_to_take.append(USE_ACTION)\n\n  # Return the sequence of actions. This list will be empty if the primitive\n  # was not found or was unreachable.\n  return actions_to_take", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T09:38:50.106057", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  grid_snapshot = current_state.grid\n  start_pos = current_state.pos  # (row, col)\n  start_dir = current_state.dir  # int (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive.\n  # Handles cases where the primitive name might not be in the cookbook.\n  try:\n      target_primitive_id = current_state.world.cookbook.index[primitive]\n  except KeyError:\n      # If the primitive name is unknown, it cannot be collected.\n      return []\n\n  WIDTH, HEIGHT, _ = grid_snapshot.shape\n\n  # Map action names to their integer indices.\n  action_map = env.action_specs()\n  MOVE_FORWARD = action_map['UP']\n  TURN_LEFT = action_map['LEFT']\n  TURN_RIGHT = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Delta row, delta column for each direction (Right, Up, Left, Down).\n  DIR_TO_DRDC = {\n      0: (0, 1),   # RIGHT: (r, c+1)\n      1: (-1, 0),  # UP: (r-1, c)\n      2: (0, -1),  # LEFT: (r, c-1)\n      3: (1, 0)    # DOWN: (r+1, c)\n  }\n\n  # Mappings to calculate new direction after a turn.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # Indices of entities that block agent movement.\n  non_walkable_kind_ids = current_state.world.non_grabbable_indices\n\n  # BFS initialization:\n  # Queue stores (current_state_tuple, path_to_current_state).\n  # A state is (position_tuple, direction_int).\n  queue = collections.deque([((start_pos, start_dir), [])])\n  \n  # Visited set to prevent cycles and find the shortest path.\n  visited = {(start_pos, start_dir)}\n\n  target_path_actions = None # Stores actions to reach the \"ready to use\" state.\n\n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      r, c = current_pos\n\n      # Check if the primitive is directly in front of the agent.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # If the cell in front is valid and contains the primitive, we found our target.\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT and\n          grid_snapshot[front_r, front_c, target_primitive_id] > 0):\n          target_path_actions = path_so_far\n          break # Shortest path to a \"USE\" position found.\n\n      # Explore next possible states:\n      \n      # 1. Try moving forward\n      next_r_move, next_c_move = r + DIR_TO_DRDC[current_dir][0], c + DIR_TO_DRDC[current_dir][1]\n      next_pos_move = (next_r_move, next_c_move)\n      next_dir_move = current_dir # Direction doesn't change on move.\n\n      if (0 <= next_r_move < WIDTH and 0 <= next_c_move < HEIGHT and\n          (next_pos_move, next_dir_move) not in visited):\n          \n          # Check if the next cell is walkable (not an obstacle or the primitive itself).\n          is_walkable = True\n          for kind_idx in non_walkable_kind_ids:\n              if grid_snapshot[next_r_move, next_c_move, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          # Agent cannot walk onto the primitive it intends to collect.\n          if is_walkable and grid_snapshot[next_r_move, next_c_move, target_primitive_id] > 0:\n              is_walkable = False\n\n          if is_walkable:\n              visited.add((next_pos_move, next_dir_move))\n              queue.append(((next_pos_move, next_dir_move), path_so_far + [MOVE_FORWARD]))\n\n      # 2. Try turning left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_so_far + [TURN_LEFT]))\n\n      # 3. Try turning right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_so_far + [TURN_RIGHT]))\n\n  # If a path was found to be adjacent and facing the primitive, append the USE action.\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T09:39:26.639866", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos  # Agent's initial position (row, col)\n  initial_dir = current_state.dir  # Agent's initial facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook's index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Determine grid dimensions: num_rows corresponds to grid.shape[0], num_cols to grid.shape[1]\n  num_rows, num_cols, _ = initial_grid.shape\n\n  # Retrieve action mapping from the environment\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # Corresponds to moving forward in the current direction\n  TURN_LEFT_ACTION = action_map['LEFT']     # Corresponds to turning 90 degrees left\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Corresponds to turning 90 degrees right\n  USE_ACTION = action_map['USE']            # Action to interact with the cell in front\n\n  # Direction vectors (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  # (dr, dc) indicates how row and column change when moving \"forward\"\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # Mapping for updating agent's direction when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # RIGHT->UP->LEFT->DOWN->RIGHT\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # RIGHT->DOWN->LEFT->UP->RIGHT\n\n  # Get indices of entities that block agent movement (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  # Convert the set to a list once for efficient NumPy array indexing.\n  non_walkable_kinds_indices_list = list(current_state.world.non_grabbable_indices)\n\n  # Helper function to check if a grid cell is valid and walkable for the agent\n  def is_valid_and_walkable_cell(r, c):\n      # Check if the position is within grid boundaries\n      if not (0 <= r < num_rows and 0 <= c < num_cols):\n          return False\n      \n      # Agent cannot walk onto the primitive itself, as interaction (USE) is from an adjacent square.\n      # If the primitive is an \"environment\" item (e.g., WOOD, STONE), it generally occupies a cell.\n      # The agent must be *adjacent* to it to 'USE' it, not on top of it.\n      if initial_grid[r, c, primitive_id] > 0:\n          return False\n\n      # Check if the cell contains any non-walkable entity (e.g., BOUNDARY, WATER, WORKSHOP_X)\n      # by summing counts for all non-grabbable kinds at that cell.\n      # This ensures the agent doesn't try to move onto obstacles.\n      if non_walkable_kinds_indices_list and np.sum(initial_grid[r, c, non_walkable_kinds_indices_list]) > 0:\n          return False\n          \n      return True\n\n  # BFS initialization:\n  # Queue stores ( (current_position_tuple, current_direction_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (position_tuple, direction_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the sequence of actions to reach the state where the primitive is in front\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent from the current state (ready for USE action)\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the cell in front is within grid boundaries\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n          # Check if the primitive is in this cell. If yes, we've found our target adjacent state.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Path found! The agent is positioned adjacent to and facing the primitive.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right\n\n      # Attempt to Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Direction does not change when moving forward\n\n      # Check if the next position is valid and walkable, and this (position, direction) state hasn't been visited\n      if is_valid_and_walkable_cell(next_r, next_c) and (next_pos, next_dir) not in visited:\n          visited.add((next_pos, next_dir))\n          queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Attempt to Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Attempt to Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path to the target adjacent state was found, append the USE action to complete the collection\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T09:39:27.947645", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` with explicit error handling for unknown primitives.\n  Returns a list of actions to find and collect the primitive in the passed env.\n  This function uses a Breadth-First Search (BFS) to find the shortest sequence of\n  movement actions to reach a position adjacent to the specified primitive,\n  followed by a 'USE' action to collect it.\n    \n  Args:\n      env (env.CraftLab): The CraftLab object representing the current simulation state.\n      primitive (str): The name of the primitive item to collect (e.g., \"WOOD\", \"STONE\").\n\n  Returns:\n      List[int]: A sequence of integer action indices to execute. An empty list\n                 is returned if the primitive name is unknown, or if the primitive\n                 is unreachable or not found on the grid.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state\n\n  # Get the integer ID for the target primitive.\n  # If the primitive name is not found in the cookbook's index, return an empty list.\n  try:\n    primitive_id = current_state.world.cookbook.index[primitive]\n  except KeyError:\n    return []\n\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's initial position (row, col)\n  initial_dir = current_state.dir # Agent's initial facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Determine grid dimensions: num_rows corresponds to grid.shape[0], num_cols to grid.shape[1]\n  num_rows, num_cols, _ = initial_grid.shape\n\n  # Retrieve action mapping from the environment\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # Corresponds to moving forward in the current direction\n  TURN_LEFT_ACTION = action_map['LEFT']     # Corresponds to turning 90 degrees left\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Corresponds to turning 90 degrees right\n  USE_ACTION = action_map['USE']            # Action to interact with the cell in front\n\n  # Direction vectors (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  # (dr, dc) indicates how row and column change when moving \"forward\"\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # Mapping for updating agent's direction when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # RIGHT->UP->LEFT->DOWN->RIGHT\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # RIGHT->DOWN->LEFT->UP->RIGHT\n\n  # Get indices of entities that block agent movement (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  non_walkable_kinds_indices_list = list(current_state.world.non_grabbable_indices)\n\n  # Helper function to check if a grid cell is valid and walkable for the agent\n  def is_valid_and_walkable_cell(r, c):\n      # Check if the position is within grid boundaries\n      if not (0 <= r < num_rows and 0 <= c < num_cols):\n          return False\n      \n      # Agent cannot walk onto the primitive itself, as interaction (USE) is from an adjacent square.\n      if initial_grid[r, c, primitive_id] > 0:\n          return False\n\n      # Check if the cell contains any non-walkable entity (e.g., BOUNDARY, WATER, WORKSHOP_X)\n      # by summing counts for all non-grabbable kinds at that cell.\n      # This ensures the agent doesn't try to move onto obstacles.\n      if non_walkable_kinds_indices_list and np.sum(initial_grid[r, c, non_walkable_kinds_indices_list]) > 0:\n          return False\n          \n      return True\n\n  # BFS initialization:\n  # Queue stores ( (current_position_tuple, current_direction_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (position_tuple, direction_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the sequence of actions to reach the state where the primitive is in front\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent from the current state (ready for USE action)\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the cell in front is within grid boundaries\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n          # Check if the primitive is in this cell. If yes, we've found our target adjacent state.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Path found! The agent is positioned adjacent to and facing the primitive.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right\n\n      # Attempt to Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Direction does not change when moving forward\n\n      # Check if the next position is valid and walkable, and this (position, direction) state hasn't been visited\n      if is_valid_and_walkable_cell(next_r, next_c) and (next_pos, next_dir) not in visited:\n          visited.add((next_pos, next_dir))\n          queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Attempt to Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Attempt to Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path to the target adjacent state was found, append the USE action to complete the collection\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T09:40:25.984458", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos\n  initial_dir = current_state.dir # 0:Right, 1:Up, 2:Left, 3:Down\n\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # 1. Define Action Mappings from CraftLab's action_specs\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # In DMLab-style, 'UP' often means move forward\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # 2. Define Movement and Turning Constants based on agent's direction\n  # DIR_TO_DRDC: Maps current direction (0-3) to (delta_row, delta_column) for moving forward\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT (0), moving forward means (r, c+1)\n      1: (-1, 0),  # Facing UP (1), moving forward means (r-1, c)\n      2: (0, -1),  # Facing LEFT (2), moving forward means (r, c-1)\n      3: (1, 0)    # Facing DOWN (3), moving forward means (r+1, c)\n  }\n  # TURN_LEFT_MAP: Maps current direction to the new direction after turning left\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0} # Right -> Up -> Left -> Down -> Right\n  # TURN_RIGHT_MAP: Maps current direction to the new direction after turning right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # 3. Get Primitive ID and Check Grabbability\n  primitive_id = current_state.world.cookbook.index[primitive]\n  if primitive_id is None: \n      # If the primitive name is not found in the cookbook index, it cannot be collected.\n      return [] \n\n  if primitive_id not in current_state.world.grabbable_indices:\n      # If the item is not grabbable (e.g., water, boundary, workshops), it cannot be 'collected' by USE.\n      return [] \n\n  # Indices of entities that cannot be walked upon by the agent (e.g., water, workshops, stone)\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # Helper function to check if coordinates are within the grid bounds\n  def _is_valid_coord(r, c):\n      return 0 <= r < WIDTH and 0 <= c < HEIGHT\n\n  # Helper function to check if a cell is traversable/walkable by the agent.\n  # An agent cannot walk onto non-grabbable items or onto the item it intends to collect.\n  def _is_walkable_cell(pos):\n      r, c = pos\n      if not _is_valid_coord(r, c):\n          return False\n      \n      # Check if the cell contains any non-walkable entity (e.g., water, workshops, stone)\n      for kind_idx in non_walkable_kinds_indices:\n          if initial_grid[r, c, kind_idx] > 0:\n              return False\n      \n      # The agent cannot walk directly onto the primitive it's trying to collect; \n      # it must stop adjacent to it and use the 'USE' action.\n      if initial_grid[r, c, primitive_id] > 0:\n          return False\n          \n      return True\n\n  # Helper function to check if the agent is positioned and facing the target primitive\n  # such that a 'USE' action would collect it.\n  def _is_target_facing(pos, current_dir):\n      r, c = pos\n      # Calculate the coordinates of the cell directly in front of the agent\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n\n      if not _is_valid_coord(front_r, front_c):\n          return False # Cell in front is out of bounds\n      \n      # Check if the cell directly in front of the agent contains the target primitive\n      return initial_grid[front_r, front_c, primitive_id] > 0\n\n  # Breadth-First Search (BFS) to find the shortest path to a state\n  # where the primitive can be collected (i.e., agent is adjacent and facing it).\n  # BFS state is defined by ((row, col), direction)\n  # Queue stores: ( (current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (position_tuple, direction_int) to prevent redundant exploration and cycles.\n  visited = {(initial_pos, initial_dir)}\n\n  target_movement_actions = None # Will store the path found by BFS\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      \n      # If this state is a target-facing state, we found the shortest path\n      # The BFS guarantees the first path found is the shortest.\n      if _is_target_facing(current_pos, current_dir):\n          target_movement_actions = path_actions\n          break # Exit BFS, shortest path found\n\n      # Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right\n      \n      # 1. Attempt to Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = current_pos[0] + move_dr, current_pos[1] + move_dc\n      next_pos_move = (next_r, next_c)\n      next_dir_move = current_dir # Direction does not change when moving\n\n      # Check if the new position is walkable and this state hasn't been visited\n      if _is_walkable_cell(next_pos_move):\n          new_state = (next_pos_move, next_dir_move)\n          if new_state not in visited:\n              visited.add(new_state)\n              new_path = path_actions + [MOVE_FORWARD_ACTION]\n              queue.append((new_state, new_path))\n\n      # 2. Attempt to Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      new_state_left = (current_pos, next_dir_left) # Position remains the same, only direction changes\n      if new_state_left not in visited:\n          visited.add(new_state_left)\n          new_path_left = path_actions + [TURN_LEFT_ACTION]\n          queue.append((new_state_left, new_path_left))\n\n      # 3. Attempt to Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      new_state_right = (current_pos, next_dir_right) # Position remains the same, only direction changes\n      if new_state_right not in visited:\n          visited.add(new_state_right)\n          new_path_right = path_actions + [TURN_RIGHT_ACTION]\n          queue.append((new_state_right, new_path_right))\n  \n  # If a path was successfully found (or if the agent was already in position),\n  # append the final USE action to the sequence.\n  if target_movement_actions is not None:\n      actions_list.extend(target_movement_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T09:40:27.177971", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos\n  initial_dir = current_state.dir # 0:Right, 1:Up, 2:Left, 3:Down\n\n  # Extract grid dimensions. Note: WIDTH here refers to rows, HEIGHT to columns based on numpy (rows, cols) indexing.\n  # The problem statement uses (WIDTH, HEIGHT, n_kinds) for grid shape.\n  NUM_ROWS, NUM_COLS, _ = initial_grid.shape\n\n  # 1. Define Action Mappings from CraftLab's action_specs\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # In DMLab-style, 'UP' often means move forward\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # 2. Define Movement and Turning Constants based on agent's direction\n  # DIR_TO_DRDC: Maps current direction (0-3) to (delta_row, delta_column) for moving forward\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT (0), moving forward means (r, c+1)\n      1: (-1, 0),  # Facing UP (1), moving forward means (r-1, c)\n      2: (0, -1),  # Facing LEFT (2), moving forward means (r, c-1)\n      3: (1, 0)    # Facing DOWN (3), moving forward means (r+1, c)\n  }\n  # TURN_LEFT_MAP: Maps current direction to the new direction after turning left\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0} # Right -> Up -> Left -> Down -> Right\n  # TURN_RIGHT_MAP: Maps current direction to the new direction after turning right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # 3. Get Primitive ID and Check Grabbability\n  primitive_id = current_state.world.cookbook.index[primitive]\n  if primitive_id is None: \n      # If the primitive name is not found in the cookbook index, it cannot be collected.\n      return [] \n\n  if primitive_id not in current_state.world.grabbable_indices:\n      # If the item is not grabbable (e.g., water, boundary, workshops), it cannot be 'collected' by USE.\n      return [] \n\n  # Indices of entities that cannot be walked upon by the agent (e.g., water, boundaries, workshops)\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # Helper function to check if coordinates are within the grid bounds\n  def _is_valid_coord(r, c):\n      return 0 <= r < NUM_ROWS and 0 <= c < NUM_COLS\n\n  # Helper function to check if a cell is traversable/walkable by the agent.\n  # An agent cannot walk onto non-grabbable items or onto the item it intends to collect.\n  def _is_walkable_cell(pos):\n      r, c = pos\n      if not _is_valid_coord(r, c):\n          return False\n      \n      # Check if the cell contains any non-walkable entity (e.g., water, workshops, stone)\n      for kind_idx in non_walkable_kinds_indices:\n          if initial_grid[r, c, kind_idx] > 0:\n              return False\n      \n      # The agent cannot walk directly onto the primitive it's trying to collect; \n      # it must stop adjacent to it and use the 'USE' action.\n      if initial_grid[r, c, primitive_id] > 0:\n          return False\n          \n      return True\n\n  # Helper function to check if the agent is positioned and facing the target primitive\n  # such that a 'USE' action would collect it.\n  def _is_target_facing(pos, current_dir):\n      r, c = pos\n      # Calculate the coordinates of the cell directly in front of the agent\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n\n      if not _is_valid_coord(front_r, front_c):\n          return False # Cell in front is out of bounds\n      \n      # Check if the cell directly in front of the agent contains the target primitive\n      return initial_grid[front_r, front_c, primitive_id] > 0\n\n  # Breadth-First Search (BFS) to find the shortest path to a state\n  # where the primitive can be collected (i.e., agent is adjacent and facing it).\n  def _bfs_find_path():\n      # BFS state is defined by ((row, col), direction)\n      # Queue stores: ( (current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_here )\n      queue = collections.deque([((initial_pos, initial_dir), [])])\n      # Visited set stores (position_tuple, direction_int) to prevent redundant exploration and cycles.\n      visited = {(initial_pos, initial_dir)}\n\n      # Helper to add a new state to the queue if it hasn't been visited.\n      # It also checks if the new state is the target and returns the path immediately if so.\n      def _process_new_state(next_pos_candidate, next_dir_candidate, action_taken, current_path):\n          new_state_key = (next_pos_candidate, next_dir_candidate)\n          if new_state_key not in visited:\n              visited.add(new_state_key)\n              new_path = current_path + [action_taken]\n              # If this newly generated state is a target, we found the shortest path.\n              if _is_target_facing(next_pos_candidate, next_dir_candidate):\n                  return new_path # Return path and terminate BFS\n              queue.append((new_state_key, new_path))\n          return None # No path found yet through this branch\n\n      # Check if the agent is already in the correct state at the very beginning\n      if _is_target_facing(initial_pos, initial_dir):\n          return [] # No movement actions needed, just a USE action\n\n      while queue:\n          (current_pos, current_dir), path_actions = queue.popleft()\n          \n          # Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right\n          \n          # 1. Attempt to Move Forward\n          move_dr, move_dc = DIR_TO_DRDC[current_dir]\n          next_r, next_c = current_pos[0] + move_dr, current_pos[1] + move_dc\n          next_pos_move = (next_r, next_c)\n          \n          if _is_walkable_cell(next_pos_move):\n              result_path = _process_new_state(next_pos_move, current_dir, MOVE_FORWARD_ACTION, path_actions)\n              if result_path is not None:\n                  return result_path # Path found, exit BFS\n\n          # 2. Attempt to Turn Left\n          next_dir_left = TURN_LEFT_MAP[current_dir]\n          result_path = _process_new_state(current_pos, next_dir_left, TURN_LEFT_ACTION, path_actions)\n          if result_path is not None:\n              return result_path # Path found, exit BFS\n\n          # 3. Attempt to Turn Right\n          next_dir_right = TURN_RIGHT_MAP[current_dir]\n          result_path = _process_new_state(current_pos, next_dir_right, TURN_RIGHT_ACTION, path_actions)\n          if result_path is not None:\n              return result_path # Path found, exit BFS\n      \n      return None # No path found to reach a state where the primitive can be collected\n\n  # --- Main logic for `collect_v2` ---\n  # Find the shortest sequence of movement/turn actions to reach a state where USE can be applied\n  target_movement_actions = _bfs_find_path()\n\n  # If a path was successfully found (or it was an immediate goal),\n  # append the final USE action to the sequence.\n  if target_movement_actions is not None:\n      actions_list.extend(target_movement_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T09:42:18.916988", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory at the very beginning.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Define action integers for all possible actions.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  all_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT, USE_ACT]\n\n  # 4. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set stores a tuple representing the agent's full state (position, direction, inventory).\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing in the set.\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, [])) # Queue stores (CraftState object, path_to_reach_this_state: list of action integers)\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  # Heuristic limit to prevent excessively long searches in complex state spaces.\n  # This typically covers grid dimensions, agent directions, and a limited number of inventory variations.\n  grid_width, grid_height, _ = current_state.grid.shape\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 20 # Increased factor for more inventory variations\n  explored_states_count = 0\n\n  # 5. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    # We continue the loop rather than breaking, allowing other branches to complete if the goal\n    # is still reachable through them, but prioritizing breadth-first search.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    # --- GOAL CHECK ---\n    # If the target primitive is now in the agent's inventory, we have found a path.\n    # This check is crucial and is performed as soon as a state is dequeued.\n    if state.inventory[i_kind] > 0:\n        return path # Goal achieved! Return the sequence of actions that led to this state.\n\n    # --- EXPLORE ACTIONS ---\n    # For each possible action, simulate its effect and add the resulting new state to the queue if unvisited.\n    for action in all_actions:\n      # Simulate the action. `state.step` returns (reward, new_state).\n      # The reward is not used here, as we are only concerned with state transitions.\n      _, next_state = state.step(action)\n\n      # Construct a unique key for the next state to check against the 'visited' set.\n      # This key must capture all relevant aspects of the state that determine reachability,\n      # specifically position, direction, and inventory.\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      # If this next state has not been visited before, add it to the queue and mark as visited.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n\n  # 6. If the BFS queue is exhausted and the goal was never reached,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T09:42:20.988778", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` by increasing the state exploration limit\n  to allow for discovery of more complex or longer collection paths.\n  \n  This version builds upon v1's robust handling of directional USE actions and\n  its initial pruning of non-collectible items.\n  \"\"\"\n  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set now includes the agent's inventory as part of the state key.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing, allowing BFS to distinguish\n  # between states that are identical in position/direction but differ in inventory (e.g., having a tool vs. not).\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Increased MAX_EXPLORED_STATES to allow for deeper exploration and more complex paths.\n  # v0 had 20, v1 had 10. Let's make v2 even more capable.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 30 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n\n    # Check if the primitive can be collected from the current cell (agent is standing on it).\n    if state.grid[current_r, current_c, i_kind] == 1:\n        inventory_before_use = np.copy(state.inventory)\n        _, state_after_use = state.step(USE_ACT)\n        # Verify if the USE action successfully collected the item from the current spot.\n        if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n            return path + [USE_ACT] # Item collected from current position.\n    \n    # Check if the primitive is in the 3x3 neighborhood and can be collected by turning and using.\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Ensure the facing coordinates are within grid bounds and contain the primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                temp_state_after_turns = state \n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                for turn_action in turns_to_face:\n                    # It's crucial here that state.step only changes direction, not inventory or pos for turns.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the USE action from the current position, even if not directly on the target primitive\n    # or immediately collectable. This is for side effects (e.g., picking up a tool).\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use_general = state.step(USE_ACT)\n    \n    # Check if the general USE action resulted in a meaningful state change.\n    # This prevents adding redundant states to the queue if USE had no effect.\n    if not (np.array_equal(state_after_current_use_general.inventory, inventory_before_any_use) and\n            state_after_current_use_general.pos == state.pos and\n            state_after_current_use_general.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use_general.inventory)\n        next_state_key = (state_after_current_use_general.pos[0], state_after_current_use_general.pos[1], state_after_current_use_general.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use_general, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T09:43:04.628053", "function_name": "collect", "function_body": "", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-08-01T09:43:05.755275", "function_name": "collect", "function_body": "  actions_list = [] \n  \n  # Get the current state of the environment.\n  current_state = env._current_state \n  initial_grid = current_state.grid       # The static grid layout at the start of the search.\n  initial_pos = current_state.pos         # Agent's starting (row, col) position.\n  initial_dir = current_state.dir         # Agent's starting direction (0:Right, 1:Up, 2:Left, 3:Down).\n\n  # Extract grid dimensions for boundary checks.\n  GRID_ROWS, GRID_COLS, _ = initial_grid.shape\n\n  # 1. Resolve Primitive ID and Perform Essential Grabbability Checks\n  # Get the integer ID for the target primitive from the cookbook's index.\n  # The DSL ensures 'primitive' is a valid string name, but its 'collectability' needs validation.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # If the resolved ID is not associated with a grabbable item (e.g., it's a \"water\" or \"workshop\"),\n  # it cannot be collected using the 'USE' action. Return an empty list as this goal is unachievable\n  # for this specific 'collect' function.\n  if primitive_id not in current_state.world.grabbable_indices:\n      return []\n\n  # 2. Map DSL-like Actions to Environment-Specific Integer Indices\n  # These mappings are standard for the CraftLab environment.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # 'UP' action moves the agent forward in its current direction.\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']            # The action to collect/interact with an item in front.\n\n  # 3. Define Agent Movement and Turning Logic Constants\n  # These constants describe how the agent's position and direction change based on actions.\n  # `DIR_TO_DRDC`: Maps agent's direction (0-3) to a tuple (delta_row, delta_col) for a forward move.\n  # Directions: 0=Right (+col), 1=Up (-row), 2=Left (-col), 3=Down (+row).\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n  # `TURN_LEFT_MAP`: Maps current direction to the new direction after turning left (counter-clockwise).\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0} # E.g., Right (0) -> Up (1)\n  # `TURN_RIGHT_MAP`: Maps current direction to the new direction after turning right (clockwise).\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # E.g., Right (0) -> Down (3)\n\n  # Cache indices of entities that block agent movement (e.g., walls, water, workshops).\n  # The agent cannot physically move into these cells.\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # 4. Helper Functions for Breadth-First Search (BFS) Pathfinding Logic\n\n  def _is_valid_coord(r: int, c: int) -> bool:\n      \"\"\"Checks if the given grid coordinates (row, col) are within the valid grid boundaries.\"\"\"\n      return 0 <= r < GRID_ROWS and 0 <= c < GRID_COLS\n\n  def _is_walkable_cell(pos: tuple[int, int]) -> bool:\n      \"\"\"\n      Determines if the agent can physically move into the given cell (r, c).\n      A cell is walkable if:\n      1. It's within grid boundaries.\n      2. It does not contain any entities that are designated as non-grabbable\n         (which typically implies non-walkable, like walls, workshops, water).\n      3. It does not contain the `primitive_id` itself, as the agent collects\n         from *adjacent* cells, not by occupying the primitive's cell.\n      \"\"\"\n      r, c = pos\n      if not _is_valid_coord(r, c):\n          return False\n      \n      # Check for any non-grabbable (blocking) entities in the cell.\n      for kind_idx in non_walkable_kinds_indices:\n          if initial_grid[r, c, kind_idx] > 0:\n              return False # This cell contains a blocking obstacle.\n      \n      # The agent should not walk *onto* the primitive it intends to collect.\n      # The 'USE' action is performed on the cell *in front* of the agent.\n      if initial_grid[r, c, primitive_id] > 0:\n          return False # This cell contains the target primitive, agent cannot occupy it.\n          \n      return True # The cell is traversable for the agent.\n\n  def _is_target_facing_state(pos: tuple[int, int], current_dir: int) -> bool:\n      \"\"\"\n      Checks if, from the given agent position and direction, the target primitive\n      is located directly in the cell in front of the agent, making it ready for a 'USE' action.\n      \"\"\"\n      r, c = pos\n      # Calculate the coordinates of the cell directly in front of the agent.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n\n      if not _is_valid_coord(front_r, front_c):\n          return False # The cell in front is outside grid boundaries.\n      \n      # Return True if the primitive exists (quantity > 0) in the cell directly in front.\n      return initial_grid[front_r, front_c, primitive_id] > 0\n\n  # 5. Breadth-First Search (BFS) for Pathfinding\n  # BFS guarantees finding the shortest path (in terms of action count) because\n  # all actions (move, turn) are treated as having equal cost.\n\n  # `queue`: Stores tuples of `(agent_state, path_to_state)`.\n  # `agent_state` is `((row, col), direction)`.\n  # `path_to_state` is a list of integer action codes (the sequence of actions taken to reach this state).\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # `visited`: Stores `agent_state` tuples `((row, col), direction)` to prevent:\n  #   - Re-exploring already visited states (optimality).\n  #   - Infinite loops in cyclic paths.\n  visited = {(initial_pos, initial_dir)}\n\n  # `target_movement_actions`: This will store the sequence of actions that leads\n  # the agent to a position and orientation where it can successfully perform the 'USE' action.\n  target_movement_actions = None \n\n  # Optimization: Check if the agent is already in the 'ready-to-use' state at the very beginning.\n  if _is_target_facing_state(initial_pos, initial_dir):\n      target_movement_actions = [] # No preceding movement actions are needed.\n\n  # If not immediately at the target, proceed with the BFS search.\n  if target_movement_actions is None:\n      while queue:\n          (current_pos, current_dir), path_so_far = queue.popleft()\n          \n          # Explore all three possible next actions from the `current_state`:\n          # 1. Move Forward, 2. Turn Left, 3. Turn Right.\n\n          # --- 5a. Explore Move Forward action ---\n          move_dr, move_dc = DIR_TO_DRDC[current_dir]\n          next_r_fwd, next_c_fwd = current_pos[0] + move_dr, current_pos[1] + move_dc\n          next_pos_fwd = (next_r_fwd, next_c_fwd)\n          next_dir_fwd = current_dir # Direction does not change when moving.\n\n          # Check if the potential destination cell is walkable and the resulting state is new.\n          if _is_walkable_cell(next_pos_fwd):\n              new_state_fwd = (next_pos_fwd, next_dir_fwd)\n              if new_state_fwd not in visited:\n                  visited.add(new_state_fwd)\n                  new_path_fwd = path_so_far + [MOVE_FORWARD_ACTION]\n                  \n                  # If this new state makes the agent ready to collect the primitive,\n                  # we have found the shortest path.\n                  if _is_target_facing_state(next_pos_fwd, next_dir_fwd):\n                      target_movement_actions = new_path_fwd\n                      break # Terminate BFS as the shortest path is guaranteed.\n                  \n                  # Otherwise, add this new state to the queue for further exploration.\n                  queue.append((new_state_fwd, new_path_fwd))\n\n          # --- 5b. Explore Turn Left action ---\n          next_dir_left = TURN_LEFT_MAP[current_dir]\n          # Position remains unchanged when turning, only direction updates.\n          new_state_left = (current_pos, next_dir_left) \n          \n          # Check if this new state (same position, new direction) has been visited.\n          if new_state_left not in visited:\n              visited.add(new_state_left)\n              new_path_left = path_so_far + [TURN_LEFT_ACTION]\n              \n              # If this new orientation makes the agent ready to collect.\n              if _is_target_facing_state(current_pos, next_dir_left):\n                  target_movement_actions = new_path_left\n                  break # Shortest path found, terminate BFS.\n              \n              # Add to queue if not a goal state yet.\n              queue.append((new_state_left, new_path_left))\n\n          # --- 5c. Explore Turn Right action ---\n          next_dir_right = TURN_RIGHT_MAP[current_dir]\n          # Position remains unchanged when turning.\n          new_state_right = (current_pos, next_dir_right)\n          \n          # Check if this new state has been visited.\n          if new_state_right not in visited:\n              visited.add(new_state_right)\n              new_path_right = path_so_far + [TURN_RIGHT_ACTION]\n              \n              # If this new orientation makes the agent ready to collect.\n              if _is_target_facing_state(current_pos, next_dir_right):\n                  target_movement_actions = new_path_right\n                  break # Shortest path found, terminate BFS.\n              \n              # Add to queue if not a goal state yet.\n              queue.append((new_state_right, new_path_right))\n      \n  # 6. Construct the Final Action List\n  # If a path was successfully found (i.e., `target_movement_actions` is not None),\n  # append the final 'USE' action to the discovered movement sequence.\n  if target_movement_actions is not None:\n      actions_list.extend(target_movement_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T09:44:24.693910", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (r, c)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  # Get the integer ID for the target primitive from the cookbook index\n  # If the primitive name is not in the index, this will raise a KeyError, which is expected.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # Crucial check: If the primitive is not grabbable, it cannot be collected.\n  # Return an empty list of actions as 'collect' implies picking up an item into inventory.\n  if primitive_id not in current_state.world.grabbable_indices:\n      return []\n\n  # Retrieve action mapping from the environment's action specifications\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP'] # 'UP' in action_specs implies moving forward\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  # This helps calculate the next position when moving forward\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: +1 to column (c)\n      1: (-1, 0),  # Facing UP: -1 to row (r)\n      2: (0, -1),  # Facing LEFT: -1 to column (c)\n      3: (1, 0)    # Facing DOWN: +1 to row (r)\n  }\n\n  # Maps for updating the agent's direction when turning left/right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0} # R -> U -> L -> D -> R\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # R -> D -> L -> U -> R\n\n  # Identify non-walkable entities (e.g., BOUNDARY, WATER, WORKSHOP_X) that block agent movement\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # --- Nested Helper Functions for Readability and Abstraction ---\n  def _is_cell_walkable(r_check, c_check):\n      \"\"\"Checks if a given grid cell (r_check, c_check) is walkable based on the initial grid.\"\"\"\n      if not (0 <= r_check < WIDTH and 0 <= c_check < HEIGHT):\n          return False  # Out of bounds\n\n      # Check for non-grabbable blocking entities (e.g., walls, water)\n      for kind_idx in non_walkable_kinds_indices:\n          if initial_grid[r_check, c_check, kind_idx] > 0:\n              return False  # Cell contains a non-walkable item\n\n      # Agent cannot walk directly onto the primitive itself to collect it; collection happens from an adjacent cell.\n      if initial_grid[r_check, c_check, primitive_id] > 0:\n          return False\n\n      return True\n\n  def _is_primitive_in_agent_neighborhood(agent_r, agent_c):\n      \"\"\"Checks if the target primitive is in the 3x3 neighborhood (including the agent's cell)\n      of (agent_r, agent_c) on the initial grid. This defines a \"collectable\" position.\n      \"\"\"\n      for dr_check in [-1, 0, 1]:\n          for dc_check in [-1, 0, 1]:\n              check_r, check_c = agent_r + dr_check, agent_c + dc_check\n              # Ensure the cell being checked is within grid bounds.\n              if (0 <= check_r < WIDTH and 0 <= check_c < HEIGHT and\n                  initial_grid[check_r, check_c, primitive_id] > 0):\n                  return True\n      return False\n\n  def _simulate_action_effect(pos, direction, action_to_simulate):\n      \"\"\"Calculates the new (position, direction) tuple after performing an action.\"\"\"\n      r, c = pos\n      d = direction\n\n      if action_to_simulate == MOVE_FORWARD_ACTION:\n          dr, dc = DIR_TO_DRDC[d]\n          return (r + dr, c + dc), d\n      elif action_to_simulate == TURN_LEFT_ACTION:\n          return (r, c), TURN_LEFT_MAP[d]\n      elif action_to_simulate == TURN_RIGHT_ACTION:\n          return (r, c), TURN_RIGHT_MAP[d]\n      \n      # Should not reach here with valid actions, but return current state as fallback\n      return pos, direction\n  # --- End of Nested Helper Functions ---\n\n  # Optimization: If the primitive is already in the 3x3 neighborhood of the agent's current position,\n  # no pathfinding is needed; just use the item. This leverages the CraftState.next_to method.\n  if current_state.next_to(primitive_id):\n      return [USE_ACTION]\n\n  # Initialize Breadth-First Search (BFS) for pathfinding.\n  # The queue stores tuples: ( (current_position_tuple, current_direction_int), list_of_actions_to_reach_here ).\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # The visited set stores (position_tuple, direction_int) pairs to avoid redundant computations\n  # and infinite loops in cyclic paths.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # Stores the shortest sequence of actions to reach a collectable state.\n\n  # BFS Loop: continues as long as there are states to explore.\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # Check if the current position is a \"goal\" state for collection.\n      if _is_primitive_in_agent_neighborhood(r, c):\n          target_path = path_actions # Shortest path to this position found.\n          break # Terminate BFS as the goal is reached.\n\n      # Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n      for action in [MOVE_FORWARD_ACTION, TURN_LEFT_ACTION, TURN_RIGHT_ACTION]:\n          next_pos, next_dir = _simulate_action_effect(current_pos, current_dir, action)\n          next_r, next_c = next_pos\n\n          # Check if the next state (position, direction) has been visited.\n          if (next_pos, next_dir) not in visited:\n              is_valid_transition = True\n              if action == MOVE_FORWARD_ACTION:\n                  # For movement actions, also check if the target cell is walkable.\n                  if not _is_cell_walkable(next_r, next_c):\n                      is_valid_transition = False\n              \n              if is_valid_transition:\n                  visited.add((next_pos, next_dir))\n                  queue.append(((next_pos, next_dir), path_actions + [action]))\n\n  # After BFS completes:\n  # If a path to a collectable position was found, append the final USE action\n  # to actually perform the collection.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T09:44:26.015482", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (r, c)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  # Get the integer ID for the target primitive from the cookbook index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # === Improvement from v1: Ensure the primitive is actually grabbable ===\n  # The 'collect' function implies picking up an item into inventory.\n  # If the primitive is a non-grabbable entity (e.g., WORKSHOP, WATER, BOUNDARY),\n  # it cannot be \"collected\" into inventory. In such cases, return an empty list.\n  if primitive_id not in current_state.world.grabbable_indices:\n      return []\n\n  # Retrieve action mapping from the environment's action specifications\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP'] # 'UP' in action_specs implies moving forward\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  # This helps calculate the next position when moving forward\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: +1 to column (c)\n      1: (-1, 0),  # Facing UP: -1 to row (r)\n      2: (0, -1),  # Facing LEFT: -1 to column (c)\n      3: (1, 0)    # Facing DOWN: +1 to row (r)\n  }\n\n  # Maps for updating the agent's direction when turning left/right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0} # R -> U -> L -> D -> R\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # R -> D -> L -> U -> R\n\n  # Identify non-walkable entities (e.g., BOUNDARY, WATER, WORKSHOP_X) that block agent movement\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # --- Nested Helper Functions for Readability and Abstraction (reintroduced from v0) ---\n  def _is_cell_walkable(r, c):\n      \"\"\"Checks if a given grid cell (r, c) is walkable based on the initial grid.\"\"\"\n      if not (0 <= r < WIDTH and 0 <= c < HEIGHT):\n          return False  # Out of bounds\n\n      # Check for non-walkable blocking entities (e.g., walls, water, workshops).\n      for kind_idx in non_walkable_kinds_indices:\n          if initial_grid[r, c, kind_idx] > 0:\n              return False  # Cell contains a non-walkable item\n\n      # Agent cannot walk onto the primitive it wants to collect; collection happens from an adjacent cell.\n      # So, if the cell contains the primitive itself, it's not walkable for pathfinding.\n      if initial_grid[r, c, primitive_id] > 0:\n          return False\n\n      return True\n\n  def _is_primitive_in_agent_neighborhood(agent_r, agent_c):\n      \"\"\"Checks if the target primitive is in the 3x3 neighborhood of (agent_r, agent_c)\n      on the initial grid.\n      \"\"\"\n      for dr_check in [-1, 0, 1]:\n          for dc_check in [-1, 0, 1]:\n              check_r, check_c = agent_r + dr_check, agent_c + dc_check\n              # Ensure the cell being checked is within grid bounds.\n              if (0 <= check_r < WIDTH and 0 <= check_c < HEIGHT and\n                  initial_grid[check_r, check_c, primitive_id] > 0):\n                  return True\n      return False\n\n  def _simulate_action_effect(pos, direction, action_to_simulate):\n      \"\"\"Calculates the new (position, direction) tuple after performing an action.\"\"\"\n      r, c = pos\n      d = direction\n\n      if action_to_simulate == MOVE_FORWARD_ACTION:\n          dr, dc = DIR_TO_DRDC[d]\n          return (r + dr, c + dc), d\n      elif action_to_simulate == TURN_LEFT_ACTION:\n          return (r, c), TURN_LEFT_MAP[d]\n      elif action_to_simulate == TURN_RIGHT_ACTION:\n          return (r, c), TURN_RIGHT_MAP[d]\n      \n      # Should not reach here with valid actions, but return current state as fallback\n      return pos, direction\n  # --- End of Nested Helper Functions ---\n\n  # Optimization: If the primitive is already collectible from the current position, just use it.\n  # This leverages the CraftState.next_to method.\n  if current_state.next_to(primitive_id):\n      return [USE_ACTION]\n\n  # Initialize Breadth-First Search (BFS) for pathfinding.\n  # The queue stores tuples: ( (current_position_tuple, current_direction_int), list_of_actions_to_reach_here ).\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # The visited set stores (position_tuple, direction_int) pairs to avoid redundant computations\n  # and infinite loops in cyclic paths.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # Stores the shortest sequence of actions to reach a collectable state.\n\n  # BFS Loop: continues as long as there are states to explore.\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # Check if the current position is a \"goal\" state for collection (primitive in neighborhood).\n      if _is_primitive_in_agent_neighborhood(r, c):\n          target_path = path_actions # Shortest path to this position found.\n          break # Terminate BFS as the goal is reached.\n\n      # Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n      possible_actions = [MOVE_FORWARD_ACTION, TURN_LEFT_ACTION, TURN_RIGHT_ACTION]\n\n      for action in possible_actions:\n          next_pos, next_dir = _simulate_action_effect(current_pos, current_dir, action)\n          \n          # Check if the next state (position, direction) has been visited.\n          if (next_pos, next_dir) not in visited:\n              # For movement actions, also check if the target cell is walkable.\n              if action == MOVE_FORWARD_ACTION:\n                  if not _is_cell_walkable(next_pos[0], next_pos[1]):\n                      continue # Cannot move to this cell, skip this action path.\n\n              # If reachable and not visited, add to queue for exploration.\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [action]))\n\n  # After BFS completes:\n  # If a path to a collectable position was found, append the final USE action\n  # to actually perform the collection.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T09:45:13.172232", "function_name": "collect", "function_body": "", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-08-01T09:45:14.529013", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  world = current_state.world\n  grid = current_state.grid # The static initial grid layout\n  initial_pos = current_state.pos # Agent's starting (row, col) tuple\n  initial_dir = current_state.dir # Agent's starting direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Retrieve the integer ID for the target primitive from the world's cookbook index.\n  # If the primitive name is not found (e.g., misspelled or non-existent), return an empty list.\n  try:\n      primitive_id = world.cookbook.index[primitive]\n  except KeyError:\n      # The requested primitive name does not correspond to a known item in the environment.\n      return []\n\n  GRID_ROWS, GRID_COLS, _ = grid.shape # Dimensions of the grid (height, width)\n\n  # Obtain the integer mapping for actions from the environment's action specifications.\n  action_specs = env.action_specs()\n  MOVE_FORWARD_ACTION = action_specs['UP']    # 'UP' typically means move in current facing direction\n  TURN_LEFT_ACTION = action_specs['LEFT']\n  TURN_RIGHT_ACTION = action_specs['RIGHT']\n  USE_ACTION = action_specs['USE']\n\n  # Define changes in (row, col) for moving one step forward based on current direction.\n  # Direction 0 (RIGHT): (0, +1) -> same row, column increases\n  # Direction 1 (UP): (-1, 0) -> row decreases, same column\n  # Direction 2 (LEFT): (0, -1) -> same row, column decreases\n  # Direction 3 (DOWN): (+1, 0) -> row increases, same column\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT\n      1: (-1, 0),  # Facing UP\n      2: (0, -1),  # Facing LEFT\n      3: (1, 0)    # Facing DOWN\n  }\n\n  # Define how the agent's direction changes when turning left or right.\n  # Directions cycle through 0, 1, 2, 3.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}   # e.g., RIGHT (0) -> UP (1)\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}  # e.g., RIGHT (0) -> DOWN (3)\n\n  # Get the set of entity indices that the agent cannot walk onto.\n  # This typically includes boundaries, water, and workshop locations.\n  non_walkable_kinds = world.non_grabbable_indices\n\n  # Use Breadth-First Search (BFS) to find the shortest sequence of actions.\n  # Each item in the queue is: ((current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_here)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # The 'visited' set keeps track of (position, direction) states that have already\n  # been explored. This prevents infinite loops and ensures we find the shortest path.\n  visited = set()\n  visited.add((initial_pos, initial_dir))\n\n  # This variable will store the shortest action sequence found that brings the agent\n  # to a state where it is directly adjacent to the target primitive and facing it.\n  path_to_interaction_state = None \n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      current_r, current_c = current_pos\n\n      # Check if the target primitive is located in the cell directly in front of the agent.\n      # This is the desired pre-interaction state, where the 'USE' action can be applied.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = current_r + front_dr, current_c + front_dc\n      \n      # Ensure the calculated 'front' cell is within the grid boundaries.\n      if (0 <= front_r < GRID_ROWS and 0 <= front_c < GRID_COLS):\n          # If the primitive is present in the cell the agent is facing,\n          # we have found the shortest path to an \"interactable\" position.\n          if grid[front_r, front_c, primitive_id] > 0:\n              path_to_interaction_state = path_actions\n              break # Shortest path found, terminate BFS.\n\n      # Explore all possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n      \n      # 1. Try moving Forward\n      next_r_move, next_c_move = current_r + DIR_TO_DRDC[current_dir][0], current_c + DIR_TO_DRDC[current_dir][1]\n      next_pos_move = (next_r_move, next_c_move)\n      next_dir_move = current_dir # Moving forward does not change facing direction.\n\n      # Check if the potential next position is within grid boundaries and if this\n      # (new position, new direction) state has not been visited yet.\n      if (0 <= next_r_move < GRID_ROWS and 0 <= next_c_move < GRID_COLS and\n          (next_pos_move, next_dir_move) not in visited):\n          \n          # Determine if the 'next_pos_move' cell is a walkable location for the agent.\n          # A cell is not walkable if it contains any kind listed in 'non_walkable_kinds'.\n          # Crucially, the agent should also not walk *onto* the target primitive itself,\n          # as 'USE' (collection) is done from an adjacent cell.\n          is_walkable = True\n          \n          # Check for general non-walkable entities (e.g., BOUNDARY, WATER, WORKSHOP_X).\n          for kind_idx in non_walkable_kinds:\n              if grid[next_r_move, next_c_move, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          \n          # Explicitly prevent walking onto the target primitive itself.\n          if grid[next_r_move, next_c_move, primitive_id] > 0:\n              is_walkable = False\n          \n          if is_walkable:\n              visited.add((next_pos_move, next_dir_move))\n              queue.append(((next_pos_move, next_dir_move), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # 2. Try turning Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning actions change the agent's direction but not its position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # 3. Try turning Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning actions change the agent's direction but not its position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path was successfully found to the state where the agent is adjacent to\n  # and facing the primitive, append the final 'USE' action to collect it.\n  if path_to_interaction_state is not None:\n      actions_list.extend(path_to_interaction_state)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 2, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T09:45:54.442581", "function_name": "collect", "function_body": "  actions = [] # Initialize the list to store the sequence of actions.\n  \n  # Retrieve essential information from the current environment state.\n  current_state = env._current_state \n  grid = current_state.grid # The 3D numpy array representing the game world.\n  current_pos = current_state.pos # Agent's current (row, column) position.\n  \n  # Define grid dimensions for boundary checks.\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Map action names to their integer IDs for clarity and robustness.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Define movement deltas corresponding to each cardinal direction action.\n  # These are used to calculate new coordinates during pathfinding.\n  MOVE_DELTAS = {\n      UP: (-1, 0),    # Moving UP decreases the row index.\n      DOWN: (1, 0),   # Moving DOWN increases the row index.\n      LEFT: (0, -1),  # Moving LEFT decreases the column index.\n      RIGHT: (0, 1)   # Moving RIGHT increases the column index.\n  }\n\n  # --- Step 0: Validate Primitive and Initial Checks ---\n\n  # Attempt to get the integer ID for the requested primitive.\n  # If the primitive name is not in the cookbook's index, it's an unknown item.\n  try:\n      primitive_id = env.world.cookbook.index[primitive]\n  except KeyError:\n      # If the primitive doesn't exist in the game's vocabulary, it cannot be collected.\n      return [] \n\n  # Check if the primitive is actually a 'grabbable' item.\n  # Non-grabbable items (like BOUNDARY, WATER, WORKSHOPS) cannot be collected into inventory.\n  if primitive_id not in env.world.grabbable_indices:\n      return [] # Cannot collect non-grabbable items.\n\n  # --- Step 1: Immediate Collection Check ---\n  # Check if the agent is already positioned directly next to the primitive.\n  # If so, only a single 'USE' action is required.\n  if current_state.next_to(primitive_id):\n      actions.append(USE)\n      return actions # Goal achieved with minimal actions.\n\n  # --- Step 2: Locate All Instances of the Target Primitive on the Grid ---\n  # Scan the entire game grid to find all cells containing the target primitive.\n  # These are potential locations where the primitive can be found.\n  primitive_locations = []\n  for r in range(WIDTH):\n      for c in range(HEIGHT):\n          # grid[r, c, primitive_id] == 1 indicates the primitive is present at (r, c).\n          if grid[r, c, primitive_id] == 1:\n              primitive_locations.append((r, c))\n\n  # If no instances of the primitive are found on the grid, it's impossible to collect.\n  if not primitive_locations:\n      return [] # No primitive found, cannot collect.\n\n  # --- Step 3: Breadth-First Search (BFS) for the Shortest Path ---\n  # The goal of BFS is to find the shortest sequence of movement actions that leads\n  # the agent to a cell from which it can perform a 'USE' action to collect the primitive.\n  # This means finding a path to a cell that is cardinally adjacent (Manhattan distance 1)\n  # to any of the located `primitive_locations`.\n\n  # BFS queue: Stores tuples of ((row, col), [list_of_actions_to_reach_here]).\n  bfs_queue = collections.deque([(current_pos, [])]) \n  \n  # Visited set: Keeps track of grid positions already explored to prevent cycles\n  # and ensure the shortest path is found by avoiding redundant computations.\n  visited_positions = {current_pos} \n\n  # Variable to store the shortest sequence of movement actions once found.\n  shortest_path_to_adj_cell = None \n\n  while bfs_queue:\n      # Dequeue the current position and the path leading to it.\n      (r, c), path_so_far = bfs_queue.popleft()\n\n      # Check if the current cell (r, c) is adjacent to any primitive location.\n      # This is the success condition for the pathfinding part of the algorithm.\n      for target_pr, target_pc in primitive_locations:\n          # If Manhattan distance is 1, they are immediate neighbors.\n          if abs(r - target_pr) + abs(c - target_pc) == 1: \n              shortest_path_to_adj_cell = path_so_far # Path found!\n              break # Exit inner loop, as one adjacent primitive is enough.\n      \n      if shortest_path_to_adj_cell is not None:\n          break # Exit BFS, the shortest path to an 'usable' position has been found.\n\n      # Explore all four cardinal neighbors from the current position.\n      for action_direction, (dr, dc) in MOVE_DELTAS.items():\n          next_r, next_c = r + dr, c + dc # Calculate the coordinates of the potential next cell.\n          next_pos = (next_r, next_c)\n\n          # 1. Boundary Check: Ensure `next_pos` is within the grid boundaries.\n          if not (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT):\n              continue # Skip if out of bounds.\n          \n          # 2. Traversability Check: Determine if the agent can move onto `next_pos`.\n          # A cell is non-traversable if it contains any item whose ID is in the\n          # `env.world.non_grabbable_indices` set (e.g., solid walls, water, workshops).\n          is_traversable = True\n          for non_grabbable_kind_id in env.world.non_grabbable_indices:\n              if grid[next_r, next_c, non_grabbable_kind_id] == 1: \n                  is_traversable = False # Obstacle detected.\n                  break \n          \n          if not is_traversable:\n              continue # Skip if `next_pos` is an obstacle.\n          \n          # 3. Visited Check: Only add to queue if this position hasn't been visited yet.\n          if next_pos not in visited_positions:\n              visited_positions.add(next_pos) # Mark as visited.\n              # Create a new path by extending the current path with the action taken.\n              new_path_so_far = path_so_far + [action_direction] \n              bfs_queue.append((next_pos, new_path_so_far)) # Enqueue the new state.\n    \n  # --- Step 4: Construct the Final Action Sequence ---\n  # If a path to an adjacent cell was successfully found during BFS:\n  if shortest_path_to_adj_cell is not None:\n      # First, append all the movement actions required to reach that adjacent cell.\n      actions.extend(shortest_path_to_adj_cell)\n      \n      # Once adjacent to the primitive, append the 'USE' action to collect it.\n      actions.append(USE) \n  \n  return actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T09:45:55.663427", "function_name": "collect", "function_body": "  actions = []\n  \n  # Retrieve the current state from the environment. The `_current_state` attribute\n  # holds the CraftState object, which contains all dynamic information about the game.\n  current_state = env._current_state \n  grid = current_state.grid # The 3D NumPy array representing the occupancy of each grid cell.\n  current_pos = current_state.pos # The agent's current (row, column) position on the grid.\n  \n  # Map human-readable action names to their corresponding integer IDs.\n  # This makes the code more readable and resilient to changes in action ID assignments.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Define the change in (row, column) coordinates for each cardinal movement action.\n  # These deltas are essential for exploring neighboring cells during pathfinding.\n  MOVE_DELTAS = {\n      UP: (-1, 0),    # Moving up decreases the row index.\n      DOWN: (1, 0),   # Moving down increases the row index.\n      LEFT: (0, -1),  # Moving left decreases the column index.\n      RIGHT: (0, 1)   # Moving right increases the column index.\n  }\n\n  # Convert the string name of the primitive (e.g., \"WOOD\", \"STONE\") into its\n  # integer ID. This ID is used for indexing into the grid and inventory arrays.\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # *** Crucial Safety Check: Ensure the primitive is actually something that can be collected. ***\n  # Some items in the environment (like boundaries, water, or workshops) are not\n  # \"grabbable\" and cannot be picked up into the inventory. If the requested\n  # primitive is not in the `env.world.grabbable_indices` set, it's impossible\n  # to collect it, so an empty list of actions should be returned.\n  if primitive_id not in env.world.grabbable_indices:\n      return [] # Return an empty list if the item cannot be collected.\n\n  # Get the dimensions of the grid from its shape. These are used for boundary checks.\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # --- Step 1: Immediate Collection Check ---\n  # Before starting a complex pathfinding operation, first check if the agent is\n  # already in a position to collect the primitive with a single `USE` action.\n  # The `current_state.next_to()` method efficiently checks the 3x3 neighborhood.\n  if current_state.next_to(primitive_id):\n      actions.append(USE) # If adjacent, only a 'USE' action is needed.\n      return actions # Return immediately as the goal is achieved.\n\n  # --- Step 2: Locate All Instances of the Target Primitive on the Grid ---\n  # Scan the entire grid to find every cell where the target `primitive_id` is present.\n  # These locations are potential targets for collection.\n  primitive_locations = []\n  for r in range(WIDTH):\n      for c in range(HEIGHT):\n          # If the value at `grid[r, c, primitive_id]` is 1, it means the primitive\n          # is present at that specific (row, column) coordinate.\n          if grid[r, c, primitive_id] == 1:\n              primitive_locations.append((r, c))\n\n  # If, after scanning the entire grid, no instances of the primitive are found,\n  # it's impossible to collect it.\n  if not primitive_locations:\n      return []\n\n  # --- Step 3: Breadth-First Search (BFS) for the Shortest Path ---\n  # The goal of the BFS is to find the minimum number of movement actions required\n  # to reach *any* grid cell from which the agent can successfully `USE` (collect)\n  # the primitive. This means finding a path to a cell that is cardinally adjacent\n  # (Manhattan distance of 1) to any of the `primitive_locations`.\n\n  # Initialize the BFS queue. Each item in the queue is a tuple:\n  # `((row, col), [list_of_actions_taken_to_reach_this_cell])`.\n  bfs_queue = collections.deque([(current_pos, [])]) \n  \n  # Initialize a set to keep track of visited grid positions `(row, col)`.\n  # This prevents revisiting cells, avoids infinite loops in cyclic paths,\n  # and ensures that the shortest path is found by processing layers level by level.\n  visited_positions = {current_pos} \n\n  # This variable will store the list of movement actions that constitute the\n  # shortest path to a cell from which the agent can perform a 'USE' action.\n  shortest_path_to_adjacent_cell = None \n\n  # Perform the BFS until the queue is empty or a path is found.\n  while bfs_queue:\n      # Dequeue the current position and the path leading to it.\n      (current_r, current_c), path_so_far = bfs_queue.popleft()\n\n      # *** Goal Check for BFS: ***\n      # Check if the `current_pos` (current_r, current_c) is directly adjacent\n      # (Manhattan distance 1) to any of the `primitive_locations`.\n      for target_primitive_r, target_primitive_c in primitive_locations:\n          # Calculate the Manhattan distance. If it's 1, they are immediate neighbors.\n          if abs(current_r - target_primitive_r) + abs(current_c - target_primitive_c) == 1: \n              shortest_path_to_adjacent_cell = path_so_far # Path found! Store it.\n              break # Exit this inner loop; no need to check other primitive locations.\n      \n      # If a path to an adjacent cell was found in the previous step, exit the BFS.\n      if shortest_path_to_adjacent_cell is not None:\n          break \n\n      # *** Explore Neighbors: ***\n      # Iterate through all four cardinal directions (UP, DOWN, LEFT, RIGHT).\n      for action_direction, (dr, dc) in MOVE_DELTAS.items():\n          # Calculate the coordinates of the potential next cell.\n          next_r, next_c = current_r + dr, current_c + dc \n          next_pos = (next_r, next_c)\n\n          # 1. Boundary Check: Ensure the `next_pos` is within the valid grid dimensions.\n          if not (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT):\n              continue # Skip this neighbor if it's out of bounds.\n          \n          # 2. Traversability Check: Determine if the agent can move onto `next_pos`.\n          # A cell is considered non-traversable if it contains any item whose kind ID\n          # is in the `env.world.non_grabbable_indices` set (e.g., solid walls, water, workshops).\n          is_traversable = True\n          for non_grabbable_kind_id in env.world.non_grabbable_indices:\n              if grid[next_r, next_c, non_grabbable_kind_id] == 1: \n                  is_traversable = False # This cell contains an obstacle.\n                  break # No need to check other non-grabbable types for this cell.\n          \n          if not is_traversable:\n              continue # Skip this neighbor if it's an obstacle.\n          \n          # 3. Visited Check: If this `next_pos` has not been visited yet, add it to the queue.\n          if next_pos not in visited_positions:\n              visited_positions.add(next_pos) # Mark the new position as visited.\n              # Create a new path by extending the `path_so_far` with the current `action_direction`.\n              new_path_so_far = path_so_far + [action_direction] \n              bfs_queue.append((next_pos, new_path_so_far)) # Add the new state to the BFS queue.\n    \n  # --- Step 4: Construct the Final Action Sequence ---\n  # If the BFS successfully found a path to a cell from which the primitive can be collected:\n  if shortest_path_to_adjacent_cell is not None:\n      # First, add all the movement actions that lead to the adjacent cell.\n      actions.extend(shortest_path_to_adjacent_cell)\n      \n      # Once the agent is in an adjacent position, append the 'USE' action\n      # to collect the primitive. (We've already ensured it's a grabbable item).\n      actions.append(USE) \n  \n  return actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T09:47:05.409243", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID for the target item (what we want in inventory).\n  try:\n    i_kind_target = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind_target] > 0:\n      return []\n\n  # 3. Determine the 'source' kind on the grid that needs to be interacted with\n  # to yield the target primitive. This distinction is crucial for primitives\n  # like \"wood\" (target) which comes from \"tree\" (source).\n  i_kind_source = -1 # Default to an invalid value\n\n  # Case A: The primitive itself is directly grabbable (can be picked up directly from the grid)\n  # or is a special resource like water/stone that directly corresponds to a grid block.\n  if i_kind_target in world.grabbable_indices:\n      i_kind_source = i_kind_target\n  elif i_kind_target == world.water_index:\n      i_kind_source = world.water_index\n  elif i_kind_target == world.stone_index:\n      i_kind_source = world.stone_index\n  else:\n      # Case B: The primitive is obtained from a *different* source entity on the grid.\n      # This requires a mapping from the desired primitive (e.g., \"wood\") to its source entity (e.g., \"tree\").\n      # This restores the capability for collecting derived primitives that are not directly grabbable.\n      primitive_to_source_entity_name = {\n          \"wood\": \"tree\",\n          \"iron\": \"iron_ore\",\n          \"grass\": \"grass_block\", \n          \"rock\": \"rock_block\", \n          \"gold\": \"gold_ore\",\n          \"gem\": \"gem_ore\",\n          # Add other mappings as per environment's implicit gathering rules\n      }\n      source_entity_name = primitive_to_source_entity_name.get(primitive.lower())\n      \n      if source_entity_name:\n          try:\n              i_kind_source = world.cookbook.index[source_entity_name]\n          except KeyError:\n              # The source entity (e.g., 'tree') itself is not recognized in the cookbook index.\n              # This means either the environment does not contain this source or the mapping is incorrect.\n              return []\n      else:\n          # If it's not a direct grabbable/resource AND no specific source entity mapping exists,\n          # then this primitive is not collectible via a simple 'USE' action on the grid \n          # (e.g., it's a workshop, boundary, or exclusively craftable).\n          return []\n\n  # If i_kind_source is still invalid after all checks, it means the primitive cannot be collected.\n  if i_kind_source == -1:\n      return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set stores (row, col, direction, inventory_tuple) to avoid cycles\n  # and redundant exploration, as inventory changes can open up new possibilities.\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  \n  # A robust upper bound for explored states to prevent excessively long searches.\n  # It considers grid size, directions, and the number of distinct item kinds\n  # (as inventory changes are part of the state for BFS).\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * (1 + len(world.cookbook.kinds)) \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check 1: Is the 'source' entity (i_kind_source) at the agent's current position?\n    # This covers cases like picking up a loose item that is directly the source (e.g., a \"stick\").\n    if state.grid[current_r, current_c, i_kind_source] == 1:\n        inventory_before_use_on_self = np.copy(state.inventory)\n        _, state_after_use_on_self = state.step(USE_ACT)\n        \n        # Verify successful collection: check if the *target primitive's* count increased in inventory.\n        # This is crucial because using on a source might produce the target, or something else.\n        if state_after_use_on_self.inventory[i_kind_target] > inventory_before_use_on_self[i_kind_target]:\n            return path + [USE_ACT] # Collected by using at current position\n\n    # Goal Check 2: Is the 'source' entity (i_kind_source) in an adjacent cell?\n    # Iterate through cardinal directions to find the specific cell containing the source entity.\n    for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n        dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n        facing_r, facing_c = current_r + dr, current_c + dc\n\n        # Ensure facing cell is within grid bounds and contains the target source entity\n        if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n            state.grid[facing_r, facing_c, i_kind_source] == 1):\n            \n            # Simulate the turning actions required to face the source entity.\n            temp_state_after_turns = state \n            turns_to_face = _get_turning_actions(current_dir, target_dir)\n            for turn_action in turns_to_face:\n                _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n            # Store inventory before attempting USE to verify collection.\n            inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n            # Simulate the 'USE' action on the cell in front.\n            _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n            # Critical check: Did the count of the *target primitive* in inventory actually increase?\n            # This verifies successful collection, accounting for any internal game rules\n            # (e.g., requiring tools, or multiple uses) implemented in `CraftState.step`.\n            if state_after_use.inventory[i_kind_target] > inventory_before_use[i_kind_target]:\n                return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the USE action from the current position generally.\n    # This is important if using an item at the current position (e.g., picking up a tool,\n    # or interacting with a workshop) changes the inventory state. Such changes might be\n    # necessary for later steps to collect the *target* primitive (e.g., crafting a required tool).\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if the USE action resulted in a meaningful state change (inventory, position, or direction).\n    # This prevents adding redundant states to the queue if USE had no effect.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 6, "scores": {"3": 1.5}}
