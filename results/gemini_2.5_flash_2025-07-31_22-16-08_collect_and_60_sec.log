{"timestamp": "2025-08-01T14:20:22.771343", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # For collect_v1, the 'visited' set does NOT track inventory, only position and direction.\n  # This simplification means it may not find paths requiring intermediate tool collection\n  # if such collection changes the agent's capability (not just location).\n  visited = set()\n\n  # Start BFS from the current environment state.\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Max states to explore, based on grid size and 4 directions.\n  # This is a heuristic to prevent infinite loops in large or complex maps.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 5 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`).\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      # For collect_v1, only position and direction are part of the state key for visited set.\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Note: collect_v1 does NOT explore the USE action generally (not facing primitive).\n    # This is a key difference from the more advanced collect_v0, which accounts for\n    # picking up tools that might change inventory state.\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 1, "scores": {"3": 1.0}}
{"timestamp": "2025-08-01T14:20:24.016684", "function_name": "collect", "function_body": "  \"\"\"Simpler version of `collect` without tracking inventory in BFS visited states.\n    \n    This version uses a basic BFS to find a path to a primitive.\n    It does not consider changes in inventory during the pathfinding,\n    meaning it won't find paths that require picking up intermediate tools\n    (e.g., an axe to collect wood). The 'USE' action is only tried\n    when the agent is adjacent to the target primitive.\n\n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect.\n\n    Returns:\n        List[int]: A sequence of action indices to execute.\n  \"\"\"\n  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # Simplified 'visited' set: only tracks position and direction.\n  # It does NOT include inventory, which is the key difference from the `collect_v0` (improved) version.\n  visited = set()\n\n  # Start BFS from the current environment state.\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # MAX_EXPLORED_STATES can be smaller here as the state space (pos, dir) is smaller.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 2 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`).\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection. Even in this simpler BFS, it's good\n                # to confirm the action had the intended effect based on game rules.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      # Simpler state key: only position and direction.\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Crucial difference from the improved version (collect_v0):\n    # This version does NOT generally explore the 'USE' action if not directly next\n    # to the target primitive. It assumes 'USE' is only for collection of the target,\n    # not for picking up intermediate tools that might change capabilities.\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found.\n  return []", "island_id": 1, "scores": {"3": 1.0}}
{"timestamp": "2025-08-01T14:22:45.439720", "function_name": "collect", "function_body": "  import heapq\n\n  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Semantic check: Determine if this primitive is *actually* collectible into inventory.\n  # This includes items defined as primitives, special environment items like water/stone,\n  # and any other items explicitly marked as grabbable (e.g., if a crafted item drops).\n  is_primitive_resource = i_kind in world.cookbook.primitives\n  is_special_collectible_environment = (i_kind == world.water_index or i_kind == world.stone_index)\n  is_grabbable = i_kind in world.grabbable_indices\n\n  if not (is_primitive_resource or is_special_collectible_environment or is_grabbable):\n      # The requested primitive is not collectible through these means.\n      return []\n\n  # 3. Check if the primitive is already in the agent's inventory.\n  if current_state.inventory[i_kind] > 0:\n      # Primitive is already collected, no actions needed.\n      return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row decreases, col stays same\n      1: (0, 1),  # RIGHT: row stays same, col increases\n      2: (1, 0),  # DOWN: row increases, col stays same\n      3: (0, -1)  # LEFT: row stays same, col decreases\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return []\n      # Calculate difference ensuring it's positive and within [0, 3]\n      diff = (target_dir - current_dir + 4) % 4\n      if diff == 1: # One right turn\n          return [RIGHT_ACT]\n      elif diff == 3: # One left turn\n          return [LEFT_ACT]\n      else: # diff == 2 (180-degree turn)\n          return [RIGHT_ACT, RIGHT_ACT] # Two right turns (or two left turns)\n\n  # Heuristic function (h(n)): Estimates the cost from state n to the goal.\n  # Using Manhattan distance to the closest cell containing the target primitive.\n  # This is admissible as it never overestimates the true cost.\n  def h(state_obj: craft.CraftState) -> float:\n      min_dist = float('inf')\n      agent_r, agent_c = state_obj.pos\n      \n      # Find all cells on the grid that contain the target primitive `i_kind`.\n      # Note: For primitives like WOOD (which comes from TREE), this heuristic\n      # might be less informative if only 'TREE' entities are on the map and no 'WOOD' itself.\n      # However, it remains admissible and provides guidance.\n      potential_target_cells = np.argwhere(state_obj.grid[:, :, i_kind] == 1)\n      \n      if potential_target_cells.size == 0:\n          # If the primitive itself is not found on the map, it's considered unreachable by this heuristic.\n          # The search will then rely more on the g_score, behaving closer to BFS.\n          return float('inf')\n\n      for r_obj, c_obj in potential_target_cells:\n          dist = abs(agent_r - r_obj) + abs(agent_c - c_obj)\n          min_dist = min(min_dist, dist)\n      \n      return min_dist\n\n  # 5. Initialize A* search.\n  # open_set: Priority queue storing tuples (f_score, state_key, state_object, path_list)\n  #   f_score = g_score + h_score\n  #   state_key = (grid_hash, row, col, direction, inventory_tuple)\n  # g_scores: dictionary mapping state_key to the cost (g_score) to reach that state.\n  \n  # Hash the initial grid for state key.\n  initial_grid_hash = hash(current_state.grid.tobytes())\n  initial_inventory_tuple = tuple(current_state.inventory)\n  initial_state_key = (initial_grid_hash, current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple)\n\n  open_set = []\n  # Push (f_score, state_key, state_object, path_list)\n  heapq.heappush(open_set, (h(current_state), initial_state_key, current_state, []))\n\n  g_scores = {initial_state_key: 0}\n  \n  grid_width, grid_height, _ = current_state.grid.shape\n  # Set a heuristic upper bound for explored nodes to prevent excessively long searches.\n  MAX_EXPLORED_NODES = grid_width * grid_height * 4 * 200 # A* can potentially explore more efficiently than BFS\n\n  explored_nodes_count = 0\n\n  # 6. A* Loop.\n  while open_set:\n    f_score, state_key, state, path = heapq.heappop(open_set)\n    explored_nodes_count += 1\n\n    # Retrieve the current g_score for the state we just popped.\n    current_g_score = g_scores.get(state_key, float('inf'))\n\n    # If we found a shorter path to this state already, skip processing this longer path.\n    # This check is crucial for A* with a closed set (implicit here via g_scores update).\n    if current_g_score < len(path): \n        continue\n\n    # Pruning: If we've explored too many distinct states, stop to prevent runaway search.\n    if explored_nodes_count > MAX_EXPLORED_NODES:\n      continue\n\n    # Helper function to process a potential next state\n    def _process_next_state(next_s_obj, actions_for_this_step, inv_before_action):\n        # Check if the target primitive was successfully collected in this transition.\n        if next_s_obj.inventory[i_kind] > inv_before_action[i_kind]:\n            return True # Goal achieved!\n\n        next_grid_hash = hash(next_s_obj.grid.tobytes())\n        next_inventory_tuple = tuple(next_s_obj.inventory)\n        next_state_key = (next_grid_hash, next_s_obj.pos[0], next_s_obj.pos[1], next_s_obj.dir, next_inventory_tuple)\n\n        # Calculate the cost to reach this new state (g_score).\n        new_g_score = current_g_score + len(actions_for_this_step)\n\n        # If this path to next_state is shorter than any previously found, or if it's new.\n        if new_g_score < g_scores.get(next_state_key, float('inf')):\n            g_scores[next_state_key] = new_g_score\n            f_score = new_g_score + h(next_s_obj)\n            heapq.heappush(open_set, (f_score, next_state_key, next_s_obj, path + actions_for_this_step))\n        return False\n\n    # --- Generate all potential next states from the current state ---\n\n    # 1. Explore Movement Actions (UP, DOWN, LEFT, RIGHT)\n    for action in move_actions:\n        _, next_state = state.step(action)\n        # For movement, the 'inventory_before_action' is simply the current state's inventory.\n        if _process_next_state(next_state, [action], np.copy(state.inventory)):\n            return path + [action]\n\n    # 2. Explore USE_ACT at current position\n    inventory_before_use_at_pos = np.copy(state.inventory)\n    grid_before_use_at_pos = np.copy(state.grid) # Capture grid state before USE\n    _, state_after_use_at_pos = state.step(USE_ACT)\n    \n    # Only consider this transition if the USE_ACT actually resulted in a state change\n    state_changed_by_use_at_pos = not (\n        np.array_equal(state_after_use_at_pos.inventory, inventory_before_use_at_pos) and\n        state_after_use_at_pos.pos == state.pos and\n        state_after_use_at_pos.dir == state.dir and\n        np.array_equal(state_after_use_at_pos.grid, grid_before_use_at_pos)\n    )\n    if state_changed_by_use_at_pos:\n        if _process_next_state(state_after_use_at_pos, [USE_ACT], inventory_before_use_at_pos):\n            return path + [USE_ACT]\n    \n    # 3. Explore USE_ACT on adjacent cells (after turning to face them)\n    for target_dir in range(4): # Iterate through all four possible facing directions\n        # Determine cell in front of agent after turning\n        dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n        facing_r, facing_c = state.pos[0] + dr, state.pos[1] + dc\n\n        # Check if the facing cell is within grid bounds and contains *any* entity.\n        # This broad check allows interaction with any relevant environmental object.\n        if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height) and np.any(state.grid[facing_r, facing_c, :] == 1):\n            turns_to_face = _get_turning_actions(state.dir, target_dir)\n            \n            # Simulate the turns to get the agent into the correct orientation.\n            temp_state_before_use_step = state\n            for turn_action in turns_to_face:\n                _, temp_state_before_use_step = temp_state_before_use_step.step(turn_action)\n            \n            # Capture inventory and grid states immediately before the final USE_ACT.\n            inventory_before_adj_use = np.copy(temp_state_before_use_step.inventory)\n            grid_before_adj_use = np.copy(temp_state_before_use_step.grid)\n            \n            # Perform the USE_ACT.\n            _, state_after_adj_use = temp_state_before_use_step.step(USE_ACT)\n            \n            # Only add this transition if the USE_ACT resulted in a change of state.\n            state_changed_by_adj_use = not (\n                np.array_equal(state_after_adj_use.inventory, inventory_before_adj_use) and\n                state_after_adj_use.pos == temp_state_before_use_step.pos and\n                state_after_adj_use.dir == temp_state_before_use_step.dir and\n                np.array_equal(state_after_adj_use.grid, grid_before_adj_use)\n            )\n            if state_changed_by_adj_use:\n                if _process_next_state(state_after_adj_use, turns_to_face + [USE_ACT], inventory_before_adj_use):\n                    return path + turns_to_face + [USE_ACT]\n            \n  # 7. If the A* queue is exhausted and no path to collect the primitive was found.\n  return []", "island_id": 2, "scores": {"3": 2.0}}
{"timestamp": "2025-08-01T14:22:46.571609", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Semantic check: Determine if this primitive is *actually* collectible into inventory.\n  # This includes items defined as primitives, special environment items like water/stone,\n  # and any other items explicitly marked as grabbable.\n  is_primitive_resource = i_kind in world.cookbook.primitives\n  is_special_collectible_environment = (i_kind == world.water_index or i_kind == world.stone_index)\n  is_grabbable = i_kind in world.grabbable_indices\n\n  if not (is_primitive_resource or is_special_collectible_environment or is_grabbable):\n      # The requested primitive is not collectible through direct collection.\n      return []\n\n  # 3. Check if the primitive is already in the agent's inventory.\n  if current_state.inventory[i_kind] > 0:\n      # Primitive is already collected, no actions needed.\n      return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row decreases, col stays same\n      1: (0, 1),  # RIGHT: row stays same, col increases\n      2: (1, 0),  # DOWN: row increases, col stays same\n      3: (0, -1)  # LEFT: row stays same, col decreases\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return []\n      diff = (target_dir - current_dir + 4) % 4\n      if diff == 1: # Clockwise (RIGHT turn)\n          return [RIGHT_ACT]\n      elif diff == 3: # Counter-clockwise (LEFT turn)\n          return [LEFT_ACT]\n      else: # diff == 2 (180-degree turn)\n          return [RIGHT_ACT, RIGHT_ACT] # Two right turns is an efficient way to turn 180 degrees\n\n  # Helper function to get a hashable key for a CraftState for state tracking in sets/dicts.\n  # This key must uniquely identify a state for the purpose of the search (grid, position, direction, inventory).\n  def get_state_key(state: craft.CraftState):\n      # Hashing the grid's bytes representation is crucial as the grid can change (e.g., removing a tree).\n      return (hash(state.grid.tobytes()), state.pos[0], state.pos[1], state.dir, tuple(state.inventory))\n\n  # Heuristic function for A* (estimated cost from current state to goal state).\n  # This heuristic must be admissible (never overestimates the true cost) for A* to guarantee optimality.\n  # It estimates the minimum number of movement actions required to reach the primitive on the grid.\n  def h(state: craft.CraftState) -> float:\n      # If the primitive is already in the agent's inventory, the remaining cost to collect it is 0.\n      if state.inventory[i_kind] > 0:\n          return 0.0\n\n      min_manhattan_dist = float('inf')\n      \n      # Find all grid cells that contain the target primitive.\n      # np.argwhere returns (row, col) coordinates where the condition is true.\n      primitive_locations = np.argwhere(state.grid[:, :, i_kind] == 1)\n      \n      if primitive_locations.size == 0:\n          # If the primitive is not found on the current grid and not in inventory, it's considered unreachable\n          # via direct interaction in this branch of the search. Returning infinity effectively prunes this path.\n          return float('inf') \n\n      current_r, current_c = state.pos\n\n      for r, c in primitive_locations:\n          # Manhattan distance is an admissible heuristic for grid movement, as each move costs 1.\n          dist = abs(r - current_r) + abs(c - current_c)\n          min_manhattan_dist = min(min_manhattan_dist, dist)\n      \n      return min_manhattan_dist\n\n  # 5. Initialize A* search data structures.\n  # open_set: Priority queue storing (f_score, state_key) - ordered by f_score (g + h).\n  # The state_key is used to look up actual state objects and other scores.\n  open_set = [] \n  \n  # g_score: dict mapping state_key to g_score (actual cost from initial state to current state).\n  g_score = {}\n  \n  # came_from: dict mapping state_key to (parent_state_key, list_of_actions_taken_from_parent) for path reconstruction.\n  # This stores the specific sequence of actions that led to a state from its best parent.\n  came_from = {} \n  \n  # state_obj_cache: dict mapping state_key to the actual CraftState object.\n  # This prevents re-creating identical state objects and allows retrieval of state attributes.\n  state_obj_cache = {}\n\n  initial_state_key = get_state_key(current_state)\n  g_score[initial_state_key] = 0\n  initial_f_score = h(current_state) # Calculate initial f_score using heuristic\n  \n  # Push the initial state into the priority queue.\n  heapq.heappush(open_set, (initial_f_score, initial_state_key))\n  # Cache the initial state object.\n  state_obj_cache[initial_state_key] = current_state\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Set a heuristic upper bound on the number of unique states to explore.\n  # This helps prevent excessively long searches in very large or complex environments.\n  # The number of grid cells * 4 directions * max_relevant_inventory_items (simplified)\n  # provides a rough estimate of state space size.\n  MAX_EXPLORED_NODES = grid_width * grid_height * 4 * (min(world.cookbook.n_kinds, 10) + 1) * 20 # E.g., 10x10 grid, 4 dir, ~10 inv items, factor 20\n\n  # 6. A* Search Loop.\n  while open_set:\n    # Pop the state_key with the lowest f_score from the priority queue.\n    # A* guarantees that the first time the goal state is popped, it's via the shortest path.\n    current_f, current_key = heapq.heappop(open_set)\n    \n    # Retrieve the actual CraftState object and its current g_score.\n    current_state_obj = state_obj_cache[current_key]\n    current_g = g_score[current_key]\n\n    # Check if the goal is reached: the primitive is in the inventory.\n    if current_state_obj.inventory[i_kind] > 0:\n        # Goal reached! Reconstruct the path by backtracking using the `came_from` map.\n        path = []\n        node_key = current_key\n        while node_key != initial_state_key:\n            # Each entry in `came_from` stores a tuple: (parent_state_key, list_of_actions_taken_from_parent).\n            # We append this list of actions to our path.\n            prev_key, action_sequence_taken = came_from[node_key]\n            path.extend(action_sequence_taken) \n            node_key = prev_key\n        # The path is built in reverse; reverse it to get actions from start to goal.\n        return path[::-1] \n\n    # Pruning: If the number of unique states explored exceeds the defined limit, abort search.\n    # This prevents the search from running indefinitely in complex scenarios.\n    if len(state_obj_cache) > MAX_EXPLORED_NODES:\n        # print(f\"A* search exceeded MAX_EXPLORED_NODES ({MAX_EXPLORED_NODES}). Aborting search.\")\n        return [] # No path found within the exploration budget.\n\n    current_r, current_c = current_state_obj.pos\n    current_dir = current_state_obj.dir\n    \n    # Grid dimensions for boundary checks when considering adjacent cells.\n    grid_width, grid_height, _ = current_state_obj.grid.shape \n\n    # Generate all potential next states (neighbors) from the current state.\n    # Each neighbor is represented as: (next_CraftState_object, list_of_actions_to_reach_it, cost_of_these_actions).\n    neighbors = [] \n\n    # 1. Explore Movement Actions (UP, DOWN, LEFT, RIGHT). Each movement action has a cost of 1.\n    for action in move_actions:\n        # Simulate the action to get the next state. `step` returns a new CraftState object.\n        _reward, next_s_move = current_state_obj.step(action)\n        neighbors.append((next_s_move, [action], 1))\n\n    # 2. Explore USE_ACT at current position. This action also has a cost of 1.\n    # It's important to capture the state *before* the action to check if it caused a change.\n    inventory_before_use_at_pos = np.copy(current_state_obj.inventory)\n    grid_before_use_at_pos = np.copy(current_state_obj.grid)\n    _reward, state_after_use_at_pos = current_state_obj.step(USE_ACT)\n    \n    # Only add this transition if the USE_ACT actually resulted in a meaningful state change.\n    # This avoids exploring redundant states where USE_ACT has no effect.\n    if not (\n        np.array_equal(state_after_use_at_pos.inventory, inventory_before_use_at_pos) and\n        state_after_use_at_pos.pos == current_state_obj.pos and\n        state_after_use_at_pos.dir == current_state_obj.dir and\n        np.array_equal(state_after_use_at_pos.grid, grid_before_use_at_pos)\n    ):\n        neighbors.append((state_after_use_at_pos, [USE_ACT], 1))\n    \n    # 3. Explore USE_ACT on adjacent cells. This often involves a sequence of turn actions followed by a USE_ACT.\n    # Iterate through all four possible facing directions (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT).\n    for target_dir in range(4):\n        dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n        facing_r, facing_c = current_r + dr, current_c + dc\n\n        # Check if the cell we would be facing is within grid bounds AND contains *any* entity.\n        # This broad check is necessary because an entity might be interactable even if not the primitive itself\n        # (e.g., a \"stone\" block might yield \"gold\" when used).\n        if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height) and np.any(current_state_obj.grid[facing_r, facing_c, :] == 1):\n            \n            # Determine the sequence of turn actions needed to orient the agent towards the target direction.\n            turns_to_face = _get_turning_actions(current_dir, target_dir)\n            \n            # Simulate the turns sequentially to get an intermediate state where the agent is correctly oriented.\n            temp_state_after_turns = current_state_obj\n            for turn_action in turns_to_face:\n                _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n            \n            # Capture the inventory and grid state *just before* performing the USE_ACT.\n            inventory_before_adj_use = np.copy(temp_state_after_turns.inventory)\n            grid_before_adj_use = np.copy(temp_state_after_turns.grid)\n            \n            # Perform the USE_ACT from the correctly oriented temporary state.\n            _reward, state_after_adj_use = temp_state_after_turns.step(USE_ACT)\n            \n            # Only add this as a valid transition if the USE_ACT actually changed the state.\n            if not (\n                np.array_equal(state_after_adj_use.inventory, inventory_before_adj_use) and\n                state_after_adj_use.pos == temp_state_after_turns.pos and \n                state_after_adj_use.dir == temp_state_after_turns.dir and \n                np.array_equal(state_after_adj_use.grid, grid_before_adj_use)\n            ):\n                # The total sequence of actions for this transition is the turns + the USE_ACT.\n                action_sequence = turns_to_face + [USE_ACT]\n                cost_of_sequence = len(action_sequence) # Each action in the sequence costs 1.\n                neighbors.append((state_after_adj_use, action_sequence, cost_of_sequence))\n\n    # Process all generated neighbors:\n    for next_s, action_seq, cost_of_seq in neighbors:\n        next_key = get_state_key(next_s)\n        # Calculate the g_score (actual cost from start) for the path leading through `current_key` to `next_key`.\n        new_g_score = current_g + cost_of_seq\n\n        # If this new path to `next_key` is shorter (lower g_score) than any previously found path to `next_key`,\n        # or if `next_key` has not been visited yet:\n        if new_g_score < g_score.get(next_key, float('inf')):\n            g_score[next_key] = new_g_score\n            # Calculate the f_score (estimated total cost) for the new path.\n            f_score_val = new_g_score + h(next_s)\n            \n            # Store path reconstruction information: `next_key` was reached from `current_key` via `action_seq`.\n            came_from[next_key] = (current_key, action_seq) \n            # Cache the actual state object for `next_key`.\n            state_obj_cache[next_key] = next_s\n\n            # Add/update the state in the priority queue. If `next_key` was already in `open_set` with a higher `f_score`,\n            # this push adds a new entry, and the old one will be skipped when popped due to `g_score` check.\n            heapq.heappush(open_set, (f_score_val, next_key))\n\n  # If the open_set becomes empty and the goal was not reached, it means no path exists to collect the primitive.\n  return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-08-01T14:24:27.082421", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Obtain the integer ID for the target primitive.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized by the world's cookbook, it's uncollectible.\n    return []\n\n  # 2. Perform a semantic check: Can this item actually be collected into inventory?\n  # This includes explicit primitives, special environment items (water/stone),\n  # and any other items marked as generally grabbable.\n  is_primitive_resource = i_kind in world.cookbook.primitives\n  is_special_collectible_environment = (i_kind == world.water_index or i_kind == world.stone_index)\n  is_grabbable_item = i_kind in world.grabbable_indices\n\n  if not (is_primitive_resource or is_special_collectible_environment or is_grabbable_item):\n      # The requested item is not a collectible type that can be put in inventory.\n      return []\n\n  # 3. Quick check: Is the primitive already in the agent's inventory?\n  if current_state.inventory[i_kind] > 0:\n      # If already collected, no actions are needed.\n      return []\n\n  # 4. Define action constants and utility for direction/movement.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  # List of all standard movement actions.\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # Mapping from agent's direction (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT) to (row_delta, col_delta)\n  # for the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row decreases, col stays same\n      1: (0, 1),  # RIGHT: row stays same, col increases\n      2: (1, 0),  # DOWN: row increases, col stays same\n      3: (0, -1)  # LEFT: row stays same, col decreases\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return []\n      # Calculate difference ensuring it's positive and within [0, 3] (clockwise distance)\n      diff = (target_dir - current_dir + 4) % 4\n      if diff == 1:\n          return [RIGHT_ACT] # One right turn (e.g., 0->1)\n      elif diff == 3:\n          return [LEFT_ACT]  # One left turn (e.g., 0->3)\n      else: # diff == 2 (180-degree turn, e.g., 0->2)\n          return [RIGHT_ACT, RIGHT_ACT] # Two right turns is simplest, could also be two left.\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The visited set stores a unique key for each explored state to avoid cycles and redundant work.\n  # A state is defined by its grid configuration, agent's position, direction, and inventory.\n  # Hashing the grid's bytes representation is crucial as the grid can change (e.g., resource depletion).\n  visited = set() \n\n  initial_inventory_tuple = tuple(current_state.inventory)\n  initial_grid_hash = hash(current_state.grid.tobytes()) \n\n  # Add the initial state to the queue and visited set.\n  # Queue stores (CraftState object, path_to_reach_this_state)\n  q.append((current_state, [])) \n  visited.add((initial_grid_hash, current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  # Get grid dimensions for boundary checks.\n  grid_width, grid_height, _ = current_state.grid.shape\n  \n  # Set a practical upper bound for the number of explored states to prevent excessively long searches\n  # in very large or complex maps, especially if the goal is unreachable.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 150 # Heuristic limit based on grid size, directions, and a multiplier\n\n  explored_states_count = 0\n\n  # 6. BFS Loop: Explore states layer by layer.\n  while q:\n    state, path = q.popleft()\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states without finding a solution,\n    # it's likely too complex or unreachable within reasonable bounds.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue # Skip further processing of this path, continue with other paths or terminate.\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n\n    # List to store potential next transitions:\n    # (next_state_object, actions_to_reach_next_state, inventory_before_last_action_applied)\n    # Storing 'inventory_before_last_action_applied' is critical for precisely checking if\n    # the goal item was *specifically* acquired in the last step of a transition.\n    potential_next_transitions = []\n\n    # --- Generate all possible next states from the current state ---\n\n    # 1. Explore Movement Actions (UP, DOWN, LEFT, RIGHT).\n    # Moving doesn't change inventory directly, so inventory_before_action is current state's.\n    for action in move_actions:\n        # Simulate the action to get the next state.\n        _, next_state_after_move = state.step(action)\n        potential_next_transitions.append((next_state_after_move, path + [action], np.copy(state.inventory)))\n\n    # 2. Explore USE_ACT at the agent's current position.\n    # This handles collecting items that are directly \"under\" the agent (e.g., grabbable items).\n    inventory_before_use_at_pos = np.copy(state.inventory)\n    grid_before_use_at_pos = np.copy(state.grid) # Capture grid state before USE\n    \n    _, state_after_use_at_pos = state.step(USE_ACT)\n    \n    # Check if the USE_ACT at current position actually resulted in a state change.\n    # If no change occurred (e.g., nothing to use here), this transition is not useful to explore.\n    state_changed_by_use_at_pos = not (\n        np.array_equal(state_after_use_at_pos.inventory, inventory_before_use_at_pos) and\n        state_after_use_at_pos.pos == state.pos and # Pos/Dir typically don't change for USE, but good to check.\n        state_after_use_at_pos.dir == state.dir and\n        np.array_equal(state_after_use_at_pos.grid, grid_before_use_at_pos) # Crucial to compare grid\n    )\n    if state_changed_by_use_at_pos:\n        potential_next_transitions.append((state_after_use_at_pos, path + [USE_ACT], inventory_before_use_at_pos))\n    \n    # 3. Explore USE_ACT on adjacent cells (after turning to face them).\n    # This covers interacting with environmental features (e.g., chopping trees, mining rocks, using workshops).\n    for target_dir in range(4): # Iterate through all four possible facing directions (0, 1, 2, 3)\n        dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n        facing_r, facing_c = current_r + dr, current_c + dc\n\n        # Check if the cell the agent would be facing is within grid bounds AND contains any entity.\n        # `np.any(state.grid[facing_r, facing_c, :] == 1)` ensures there's something to interact with.\n        if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height) and np.any(state.grid[facing_r, facing_c, :] == 1):\n            \n            # First, simulate the turns required to face the target cell.\n            turns_to_face = _get_turning_actions(current_dir, target_dir)\n            temp_state_before_use_step = state\n            for turn_action in turns_to_face:\n                _, temp_state_before_use_step = temp_state_before_use_step.step(turn_action)\n            \n            # Capture inventory and grid states immediately before the final USE_ACT.\n            inventory_before_adj_use = np.copy(temp_state_before_use_step.inventory)\n            grid_before_adj_use = np.copy(temp_state_before_use_step.grid)\n            \n            # Now, perform the USE_ACT from the correctly oriented temporary state.\n            _, state_after_adj_use = temp_state_before_use_step.step(USE_ACT)\n            \n            # Only add this transition if the USE_ACT resulted in a change of state.\n            state_changed_by_adj_use = not (\n                np.array_equal(state_after_adj_use.inventory, inventory_before_adj_use) and\n                state_after_adj_use.pos == temp_state_before_use_step.pos and\n                state_after_adj_use.dir == temp_state_before_use_step.dir and\n                np.array_equal(state_after_adj_use.grid, grid_before_adj_use) \n            )\n            if state_changed_by_adj_use:\n                # The path includes turns then the USE_ACT.\n                potential_next_transitions.append(\n                    (state_after_adj_use, path + turns_to_face + [USE_ACT], inventory_before_adj_use)\n                )\n\n    # --- Process all generated potential next transitions ---\n    for next_s, next_p, inv_before_action in potential_next_transitions:\n        # Check if the target primitive was successfully collected in this specific transition.\n        if next_s.inventory[i_kind] > inv_before_action[i_kind]:\n            return next_p # Goal achieved! Return the found path immediately (BFS guarantees shortest).\n\n        # If the goal was not achieved, add the new state to the queue if it hasn't been visited.\n        next_inventory_tuple = tuple(next_s.inventory)\n        next_grid_hash = hash(next_s.grid.tobytes()) # Hash grid for the visited set key\n        next_state_key = (next_grid_hash, next_s.pos[0], next_s.pos[1], next_s.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((next_s, next_p))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state under current conditions.\n  return []", "island_id": 7, "scores": {"3": 2.5}}
{"timestamp": "2025-08-01T14:24:28.264340", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Semantic check: Determine if this primitive is *actually* collectible into inventory.\n  is_primitive_resource = i_kind in world.cookbook.primitives\n  is_special_collectible_environment = (i_kind == world.water_index or i_kind == world.stone_index)\n  is_grabbable = i_kind in world.grabbable_indices\n\n  if not (is_primitive_resource or is_special_collectible_environment or is_grabbable):\n      # The requested primitive is not collectible.\n      return []\n\n  # 3. Check if the primitive is already in the agent's inventory.\n  if current_state.inventory[i_kind] > 0:\n      # Primitive is already collected, no actions needed.\n      return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row decreases, col stays same\n      1: (0, 1),  # RIGHT: row stays same, col increases\n      2: (1, 0),  # DOWN: row increases, col increases\n      3: (0, -1)  # LEFT: row stays same, col decreases\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return []\n      # Calculate difference ensuring it's positive and within [0, 3]\n      diff = (target_dir - current_dir + 4) % 4\n      if diff == 1:\n          return [RIGHT_ACT] # One right turn\n      elif diff == 3:\n          return [LEFT_ACT]  # One left turn\n      else: # diff == 2 (180-degree turn)\n          return [RIGHT_ACT, RIGHT_ACT] # Two right turns (or two left turns)\n\n  grid_width, grid_height, _ = current_state.grid.shape\n\n  # Heuristic function for A* search: Estimates the minimum number of actions\n  # required to get to a state where the primitive can be collected.\n  # This includes movement and the final USE action.\n  def h(state_h: craft.CraftState, target_kind_idx: int) -> float:\n      min_dist_to_collect_pos = float('inf')\n      agent_r, agent_c = state_h.pos\n\n      # Determine if the item requires the agent to be adjacent (e.g., trees, rocks)\n      # or directly on the cell (e.g., dropped crafted items) to be \"used\" or collected.\n      needs_adjacency_to_use = target_kind_idx in world.non_grabbable_indices\n\n      found_target_on_grid = False\n      # Iterate over the entire grid to find all occurrences of target_kind_idx\n      for r in range(grid_width):\n          for c in range(grid_height):\n              if state_h.grid[r, c, target_kind_idx] == 1:\n                  found_target_on_grid = True\n                  if needs_adjacency_to_use:\n                      # If adjacency is needed, find min Manhattan distance to any adjacent cell.\n                      # Consider 4 cardinal directions for adjacency.\n                      for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                          adj_r, adj_c = r + dr, c + dc\n                          if 0 <= adj_r < grid_width and 0 <= adj_c < grid_height:\n                              dist = abs(agent_r - adj_r) + abs(agent_c - adj_c)\n                              min_dist_to_collect_pos = min(min_dist_to_collect_pos, dist)\n                  else:\n                      # If standing on the cell is enough, find min Manhattan distance to the cell itself.\n                      dist = abs(agent_r - r) + abs(agent_c - c)\n                      min_dist_to_collect_pos = min(min_dist_to_collect_pos, dist)\n      \n      if not found_target_on_grid:\n          # If the target kind isn't currently on the grid, it's considered unreachable for this heuristic.\n          return float('inf')\n\n      # Add 1 for the final USE_ACT. If no path found (min_dist_to_collect_pos is inf), keep it inf.\n      return min_dist_to_collect_pos + 1 if min_dist_to_collect_pos != float('inf') else float('inf')\n\n\n  # 5. Initialize A* Search.\n  # Priority queue: (f_score, g_score, state_object, path_list)\n  # f_score = g_score (cost from start) + h_score (estimated cost to goal)\n  pq = []\n  # g_scores: {state_key: current_g_score} to track the shortest path found to a state.\n  # State key: (grid_hash, row, col, direction, inventory_tuple)\n  g_scores = {}\n\n  initial_inventory_tuple = tuple(current_state.inventory)\n  initial_grid_hash = hash(current_state.grid.tobytes())\n\n  initial_g_score = 0\n  initial_h_score = h(current_state, i_kind)\n  initial_f_score = initial_g_score + initial_h_score\n\n  # Only start the search if the item is potentially obtainable from the grid (h is not infinity).\n  if initial_h_score == float('inf'):\n      return []\n\n  heapq.heappush(pq, (initial_f_score, initial_g_score, current_state, []))\n  g_scores[(initial_grid_hash, current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple)] = initial_g_score\n\n  # Set a practical upper bound for the number of nodes to explore to prevent excessively long searches.\n  MAX_NODES_TO_EXPLORE = grid_width * grid_height * 4 * 150 # Heuristic limit\n\n  explored_nodes_count = 0\n\n  # 6. A* Loop.\n  while pq:\n    f_score, g_score, state, path = heapq.heappop(pq)\n    explored_nodes_count += 1\n\n    # Pruning: If we've explored too many distinct states, skip to prevent runaway search.\n    if explored_nodes_count > MAX_NODES_TO_EXPLORE:\n      continue\n\n    current_state_key = (hash(state.grid.tobytes()), state.pos[0], state.pos[1], state.dir, tuple(state.inventory))\n\n    # If we found a shorter path to this state already, skip processing this longer path.\n    if g_score > g_scores.get(current_state_key, float('inf')):\n        continue\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n\n    # List to store (next_state_object, actions_to_reach_next_state, inventory_before_last_action_applied)\n    potential_next_transitions = []\n\n    # --- Generate all potential next states from the current state ---\n\n    # 1. Explore Movement Actions (UP, DOWN, LEFT, RIGHT)\n    for action in move_actions:\n        _, next_state = state.step(action)\n        # For movement, the 'inventory_before_action' is simply the current state's inventory.\n        potential_next_transitions.append((next_state, [action], np.copy(state.inventory)))\n\n    # 2. Explore USE_ACT at current position\n    inventory_before_use_at_pos = np.copy(state.inventory)\n    grid_before_use_at_pos = np.copy(state.grid)\n    _, state_after_use_at_pos = state.step(USE_ACT)\n    \n    state_changed_by_use_at_pos = not (\n        np.array_equal(state_after_use_at_pos.inventory, inventory_before_use_at_pos) and\n        state_after_use_at_pos.pos == state.pos and\n        state_after_use_at_pos.dir == state.dir and\n        np.array_equal(state_after_use_at_pos.grid, grid_before_use_at_pos)\n    )\n    if state_changed_by_use_at_pos:\n        potential_next_transitions.append((state_after_use_at_pos, [USE_ACT], inventory_before_use_at_pos))\n    \n    # 3. Explore USE_ACT on adjacent cells (after turning to face them)\n    for target_dir in range(4): # Iterate through all four possible facing directions\n        dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n        facing_r, facing_c = current_r + dr, current_c + dc\n\n        # Check if the facing cell is within grid bounds and contains *any* entity.\n        if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height) and np.any(state.grid[facing_r, facing_c, :] == 1):\n            turns_to_face = _get_turning_actions(current_dir, target_dir)\n            \n            # Simulate the turns to get the agent into the correct orientation before the USE_ACT.\n            temp_state_before_use_step = state\n            for turn_action in turns_to_face:\n                _, temp_state_before_use_step = temp_state_before_use_step.step(turn_action)\n            \n            inventory_before_adj_use = np.copy(temp_state_before_use_step.inventory)\n            grid_before_adj_use = np.copy(temp_state_before_use_step.grid)\n            \n            # Perform the USE_ACT.\n            _, state_after_adj_use = temp_state_before_use_step.step(USE_ACT)\n            \n            state_changed_by_adj_use = not (\n                np.array_equal(state_after_adj_use.inventory, inventory_before_adj_use) and\n                state_after_adj_use.pos == temp_state_before_use_step.pos and\n                state_after_adj_use.dir == temp_state_before_use_step.dir and\n                np.array_equal(state_after_adj_use.grid, grid_before_adj_use)\n            )\n            if state_changed_by_adj_use:\n                potential_next_transitions.append(\n                    (state_after_adj_use, turns_to_face + [USE_ACT], inventory_before_adj_use)\n                )\n\n    # --- Process all generated potential next transitions ---\n    for next_s, actions_for_transition, inv_before_action in potential_next_transitions:\n        new_g_score = g_score + len(actions_for_transition) # Cost of reaching next_s\n\n        # First, check if the target primitive was successfully collected in this transition.\n        if next_s.inventory[i_kind] > inv_before_action[i_kind]:\n            return path + actions_for_transition # Goal achieved! Return the path immediately.\n\n        next_state_key = (hash(next_s.grid.tobytes()), next_s.pos[0], next_s.pos[1], next_s.dir, tuple(next_s.inventory))\n\n        # If this path to next_s is shorter, or next_s hasn't been visited yet with a better path\n        if new_g_score < g_scores.get(next_state_key, float('inf')):\n            g_scores[next_state_key] = new_g_score\n            new_h_score = h(next_s, i_kind)\n            new_f_score = new_g_score + new_h_score\n            heapq.heappush(pq, (new_f_score, new_g_score, next_s, path + actions_for_transition))\n\n  # 7. If the A* priority queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-08-01T14:26:03.825168", "function_name": "collect", "function_body": "", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-08-01T14:26:06.087717", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n\n  This implementation further refines the Breadth-First Search (BFS) strategy\n  by ensuring maximum robustness and clarity in its approach to finding and\n  collecting a primitive resource. It leverages the detailed state representation\n  (including agent's position, direction, and crucially, inventory) in the\n  `visited` set to accurately model interactions that change inventory (e.g.,\n  picking up items, crafting tools) as part of the shortest path search.\n\n  Key aspects of this refined version:\n  1.  **Comprehensive `USE` Action Exploration:** The BFS actively explores the\n      'USE' action from any state if it's applicable (i.e., if something\n      interactable is in front, or if the agent is on a workshop). This\n      allows the algorithm to discover paths that involve acquiring intermediate\n      tools (like an axe) or crafting at workshops before the final collection\n      of the target primitive.\n  2.  **Inventory-Aware State Tracking:** By including the inventory (as a tuple)\n      in the `visited` set, the BFS correctly differentiates states that are\n      spatially identical but differ in the agent's possessions. This is critical\n      for solving tasks that require multi-step processes, such as crafting a tool\n      and then using it to collect a resource.\n  3.  **Robust Goal Verification:** The collection is verified by checking for an\n      actual increase in the target primitive's count in the inventory after a 'USE'\n      action, ensuring that the action was indeed successful as per the game's\n      mechanics (which might include tool requirements).\n  4.  **Heuristic Pruning:** `MAX_EXPLORED_STATES` provides a safeguard against\n      excessive computation in extremely complex or unreachable scenarios, ensuring\n      practical performance while still allowing for a broad search.\n\n  Args:\n      env (env.CraftLab): The CraftLab object representing the current simulation.\n      primitive (str): The name of the primitive resource to collect (e.g., \"wood\", \"stone\").\n\n  Returns:\n      List[int]: A sequence of integer action indices (e.g., `[UP, UP, USE]`)\n                 that, when executed, will lead to the collection of the primitive.\n                 Returns an empty list if the primitive is already in inventory\n                 or if no path is found.\n  \"\"\"\n  current_state = env._current_state\n  world = env.world\n\n  # 1. Map the primitive name to its integer ID from the world's cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If so, it's already \"collected,\" and no actions are needed.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Determine if the primitive is a type that can generally be collected via the 'USE' action.\n  # This includes:\n  # - Primitives explicitly defined in the cookbook (e.g., WOOD, IRON).\n  # - Grabbable items that can be picked up directly (e.g., tools like AXE).\n  # - Special fixed entities like water or stone.\n  is_collectible_via_use = (\n      i_kind in world.cookbook.primitives or\n      i_kind in world.grabbable_indices or\n      i_kind == world.water_index or\n      i_kind == world.stone_index\n  )\n\n  # If the target primitive is not collectable via 'USE' (e.g., a boundary,\n  # or a workshop which is a location, not an item to collect), and it's not a workshop\n  # (which could be an intermediate step for crafting), then it's unreachable for collection.\n  if not is_collectible_via_use and i_kind not in world.workshop_indices:\n    return []\n\n  # 4. Define action constants and directional deltas for grid navigation and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # Delta values for checking the cell directly in front of the agent based on its current direction.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (North)\n      1: (0, 1),  # RIGHT: row, col + 1 (East)\n      2: (1, 0),  # DOWN: row + 1, col (South)\n      3: (0, -1)  # LEFT: row, col - 1 (West)\n  }\n\n  # Helper function to compute the minimal sequence of turns to face a target direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the correct direction.\n\n      # Calculate the difference in directions, wrapping around 0-3.\n      diff = (target_dir - current_dir + 4) % 4\n\n      if diff == 1: # Target is one step clockwise (e.g., 0 to 1).\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., 0 to 3).\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn.\n          return [RIGHT_ACT, RIGHT_ACT] # Two successive right turns (or left turns).\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The `visited` set stores a tuple `(row, col, direction, inventory_tuple)` to represent\n  # a unique state. Converting inventory (numpy array) to a tuple makes it hashable for the set.\n  visited = set()\n\n  # Add the initial state to the queue and visited set.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, [])) # (current_state, path_to_reach_this_state)\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Heuristic limit to prevent the BFS from running indefinitely in highly complex or unreachable scenarios.\n  # The multiplier (e.g., 50) is chosen to allow exploration of states including tool acquisition and crafting.\n  # This provides a good balance between completeness for typical scenarios and performance.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 50\n  explored_states_count = 0\n\n  # 6. BFS Loop: Continues until the queue is empty or the goal is found.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and its associated path.\n    explored_states_count += 1\n\n    # Pruning: If too many distinct states have been explored, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n\n    # Goal Check: Can the target primitive be collected from the current `state`?\n    # This involves checking if the primitive is in the 3x3 neighborhood around the agent.\n    if state.next_to(i_kind):\n        # Iterate through all four cardinal directions to check if the primitive is directly in front.\n        for target_dir in range(4):\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell directly in front is within bounds and contains the target primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and\n                state.grid[facing_r, facing_c, i_kind] == 1):\n\n                # Simulate the turning actions required to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state\n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Record inventory *before* attempting the 'USE' action to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action on the temporary state.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Crucial verification: Check if the count of the target primitive in inventory\n                # actually increased. This confirms successful collection, accounting for any\n                # game rules (e.g., requiring tools) handled by `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT] # Found a path!\n\n    # Explore possible future states by performing movement actions.\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      # If this next state (position, direction, and inventory) has not been visited, add it to the queue.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n\n    # Explore the general 'USE' action from the current state.\n    # This is vital for scenarios where using an item at the current location (e.g., picking up a tool)\n    # or at a workshop might enable subsequent collection steps.\n    is_action_use_applicable = False\n\n    # Check 1: Is there something interactable directly in front of the agent that USE can act upon?\n    front_dr, front_dc = _DIR_TO_DELTA_FRONT[current_dir]\n    facing_r, facing_c = current_r + front_dr, current_c + front_dc\n\n    if 0 <= facing_r < grid_width and 0 <= facing_c < grid_height:\n        # Check for grabbable items, water, or stone in front.\n        for k_idx in world.grabbable_indices:\n            if state.grid[facing_r, facing_c, k_idx] == 1:\n                is_action_use_applicable = True\n                break\n        if not is_action_use_applicable and (state.grid[facing_r, facing_c, world.water_index] == 1 or\n                                              state.grid[facing_r, facing_c, world.stone_index] == 1):\n            is_action_use_applicable = True\n\n        # Check for any primitive resources in front that might be collected by USE (e.g., WOOD, IRON).\n        if not is_action_use_applicable:\n            for kind_idx_at_cell in range(state.grid.shape[2]):\n                if state.grid[facing_r, facing_c, kind_idx_at_cell] == 1 and \\\n                   kind_idx_at_cell in world.cookbook.primitives:\n                    is_action_use_applicable = True\n                    break\n\n    # Check 2: Is the agent standing on a workshop? 'USE' on a workshop can trigger crafting.\n    if not is_action_use_applicable: # Only check this if not already applicable by front cell\n        for workshop_idx in world.workshop_indices:\n            if state.grid[current_r, current_c, workshop_idx] == 1:\n                is_action_use_applicable = True\n                break\n\n    # If the 'USE' action is applicable in the current context, simulate it.\n    if is_action_use_applicable:\n        inventory_before_any_use = np.copy(state.inventory)\n        _, state_after_current_use = state.step(USE_ACT)\n\n        # Only add to queue if the 'USE' action resulted in a meaningful state change.\n        # A meaningful change means inventory or position/direction was updated.\n        # Inventory change is a primary signal for resource collection/crafting,\n        # but sometimes position/direction also changes (e.g., when a block is removed).\n        if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n                state_after_current_use.pos == state.pos and\n                state_after_current_use.dir == state.dir):\n\n            next_inventory_tuple = tuple(state_after_current_use.inventory)\n            next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n            if next_state_key not in visited:\n                visited.add(next_state_key)\n                q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS loop completes and no path to collect the primitive was found,\n  # it means the primitive is currently unreachable from the initial state given\n  # the environment and agent's capabilities within the search limits.\n  return []", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T14:28:41.519055", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Semantic check: Determine if this primitive is *actually* collectible into inventory.\n  # This includes items defined as primitives, special environment items like water/stone,\n  # and any other items explicitly marked as grabbable.\n  is_primitive_resource = i_kind in world.cookbook.primitives\n  is_special_collectible_environment = (i_kind == world.water_index or i_kind == world.stone_index)\n  is_grabbable = i_kind in world.grabbable_indices\n\n  if not (is_primitive_resource or is_special_collectible_environment or is_grabbable):\n      # The requested primitive is not collectible.\n      return []\n\n  # 3. Check if the primitive is already in the agent's inventory.\n  if current_state.inventory[i_kind] > 0:\n      # Primitive is already collected, no actions needed.\n      return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row decreases, col stays same\n      1: (0, 1),  # RIGHT: row stays same, col increases\n      2: (1, 0),  # DOWN: row increases, col stays same\n      3: (0, -1)  # LEFT: row stays same, col decreases\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return []\n      # Calculate difference ensuring it's positive and within [0, 3]\n      diff = (target_dir - current_dir + 4) % 4\n      if diff == 1:\n          return [RIGHT_ACT] # One right turn\n      elif diff == 3:\n          return [LEFT_ACT]  # One left turn\n      else: # diff == 2 (180-degree turn)\n          return [RIGHT_ACT, RIGHT_ACT] # Two right turns (or two left turns)\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The visited set must capture the full state to prevent redundant exploration,\n  # especially if grid changes without immediate inventory/position changes.\n  # State key: (grid_hash, row, col, direction, inventory_tuple)\n  visited = set() \n\n  initial_inventory_tuple = tuple(current_state.inventory)\n  # Hash the grid to include its state in the visited key.\n  # .tobytes() converts the numpy array to a bytes object, which is hashable.\n  initial_grid_hash = hash(current_state.grid.tobytes()) \n\n  q.append((current_state, [])) # Queue stores (CraftState object, path_to_reach_this_state)\n  visited.add((initial_grid_hash, current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  \n  # Heuristic limits to prevent excessively long searches for unfeasible goals\n  # or in very large/complex maps. These limits enhance robustness by preventing\n  # runaway computations for tasks that might be practically unreachable or too complex.\n  # Maximum number of unique states to explore.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 150 \n  # Maximum length of action path to consider. Paths longer than this are likely\n  # suboptimal or indicate an unreachable goal within reasonable steps.\n  MAX_PATH_LENGTH = 250 # A practical limit for a single collection task\n\n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft()\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states or the path length exceeds a limit,\n    # we stop exploring from this path to prevent runaway searches.\n    if explored_states_count > MAX_EXPLORED_STATES or len(path) >= MAX_PATH_LENGTH:\n      continue # Do not explore further from this path\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n\n    # List to store (next_state_object, actions_to_reach_next_state, inventory_before_last_action_applied)\n    # Storing 'inventory_before_last_action_applied' is crucial for checking if the goal item\n    # was *specifically* acquired in the last step of a transition.\n    potential_next_transitions = []\n\n    # --- Generate all potential next states from the current state ---\n\n    # 1. Explore Movement Actions (UP, DOWN, LEFT, RIGHT)\n    for action in move_actions:\n        _, next_state = state.step(action)\n        # For movement, the 'inventory_before_action' is simply the current state's inventory.\n        potential_next_transitions.append((next_state, path + [action], np.copy(state.inventory)))\n\n    # 2. Explore USE_ACT at current position\n    # This handles collecting items directly from the cell the agent is standing on (e.g., grabbable items).\n    inventory_before_use_at_pos = np.copy(state.inventory)\n    grid_before_use_at_pos = np.copy(state.grid) # Capture grid state before USE\n    _, state_after_use_at_pos = state.step(USE_ACT)\n    \n    # Only consider this transition if the USE_ACT actually resulted in a state change\n    # (e.g., inventory changed, or grid changed, or position/direction changed - though USE typically only changes inventory/grid).\n    state_changed_by_use_at_pos = not (\n        np.array_equal(state_after_use_at_pos.inventory, inventory_before_use_at_pos) and\n        state_after_use_at_pos.pos == state.pos and\n        state_after_use_at_pos.dir == state.dir and\n        np.array_equal(state_after_use_at_pos.grid, grid_before_use_at_pos) # Crucial to compare grid\n    )\n    if state_changed_by_use_at_pos:\n        potential_next_transitions.append((state_after_use_at_pos, path + [USE_ACT], inventory_before_use_at_pos))\n    \n    # 3. Explore USE_ACT on adjacent cells (after turning to face them)\n    # This handles interacting with items/structures in the surrounding environment (e.g., chopping trees, mining rocks).\n    for target_dir in range(4): # Iterate through all four possible facing directions\n        dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n        facing_r, facing_c = current_r + dr, current_c + dc\n\n        # Check if the facing cell is within grid bounds and contains *any* entity.\n        # This broad check allows interaction with any relevant environmental object\n        # that might yield the target primitive (e.g., 'ROCK' to get 'GOLD').\n        if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height) and np.any(state.grid[facing_r, facing_c, :] == 1):\n            turns_to_face = _get_turning_actions(current_dir, target_dir)\n            \n            # Simulate the turns to get the agent into the correct orientation before the USE_ACT.\n            # Create a temporary state to simulate turns without affecting the main BFS 'state'\n            temp_state_before_use_step = state\n            for turn_action in turns_to_face:\n                _, temp_state_before_use_step = temp_state_before_use_step.step(turn_action)\n            \n            # Capture inventory and grid states immediately before the final USE_ACT.\n            inventory_before_adj_use = np.copy(temp_state_before_use_step.inventory)\n            grid_before_adj_use = np.copy(temp_state_before_use_step.grid)\n            \n            # Perform the USE_ACT.\n            _, state_after_adj_use = temp_state_before_use_step.step(USE_ACT)\n            \n            # Only add this transition if the USE_ACT resulted in a change of state.\n            state_changed_by_adj_use = not (\n                np.array_equal(state_after_adj_use.inventory, inventory_before_adj_use) and\n                state_after_adj_use.pos == temp_state_before_use_step.pos and\n                state_after_adj_use.dir == temp_state_before_use_step.dir and\n                np.array_equal(state_after_adj_use.grid, grid_before_adj_use) # Crucial to compare grid\n            )\n            if state_changed_by_adj_use:\n                potential_next_transitions.append(\n                    (state_after_adj_use, path + turns_to_face + [USE_ACT], inventory_before_adj_use)\n                )\n\n    # --- Process all generated potential next transitions ---\n    for next_s, next_p, inv_before_action in potential_next_transitions:\n        # First, check if the target primitive was successfully collected in this transition.\n        if next_s.inventory[i_kind] > inv_before_action[i_kind]:\n            return next_p # Goal achieved! Return the path immediately.\n\n        # If not the goal, add the new state to the queue if it hasn't been visited yet.\n        next_inventory_tuple = tuple(next_s.inventory)\n        next_grid_hash = hash(next_s.grid.tobytes()) # Hash grid for the visited set key\n        next_state_key = (next_grid_hash, next_s.pos[0], next_s.pos[1], next_s.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((next_s, next_p))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions\n  # or exceeded the search limits (MAX_EXPLORED_STATES or MAX_PATH_LENGTH).\n  return []", "island_id": 2, "scores": {"3": 2.5}}
{"timestamp": "2025-08-01T14:28:43.882788", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Semantic check: Determine if this primitive is *actually* collectible into inventory.\n  # This includes items defined as primitives, special environment items like water/stone,\n  # and any other items explicitly marked as grabbable.\n  is_primitive_resource = i_kind in world.cookbook.primitives\n  is_special_collectible_environment = (i_kind == world.water_index or i_kind == world.stone_index)\n  is_grabbable_by_world_attr = i_kind in world.grabbable_indices\n\n  if not (is_primitive_resource or is_special_collectible_environment or is_grabbable_by_world_attr):\n      # The requested primitive is not collectible through the 'collect' mechanism.\n      return []\n\n  # 3. Check if the primitive is already in the agent's inventory.\n  if current_state.inventory[i_kind] > 0:\n      # Primitive is already collected, no actions needed.\n      return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row decreases, col stays same\n      1: (0, 1),  # RIGHT: row stays same, col increases\n      2: (1, 0),  # DOWN: row increases, col stays same\n      3: (0, -1)  # LEFT: row stays same, col decreases\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return []\n      # Calculate difference ensuring it's positive and within [0, 3]\n      diff = (target_dir - current_dir + 4) % 4\n      if diff == 1:\n          return [RIGHT_ACT] # One right turn\n      elif diff == 3:\n          return [LEFT_ACT]  # One left turn\n      else: # diff == 2 (180-degree turn)\n          return [RIGHT_ACT, RIGHT_ACT] # Two right turns (or two left turns)\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The visited set must capture the full state to prevent redundant exploration,\n  # especially if grid changes without immediate inventory/position changes.\n  # State key: (grid_hash, row, col, direction, inventory_tuple)\n  visited = set() \n\n  initial_inventory_tuple = tuple(current_state.inventory)\n  # Hash the grid to include its state in the visited key.\n  # .tobytes() converts the numpy array to a bytes object, which is hashable.\n  initial_grid_hash = hash(current_state.grid.tobytes()) \n\n  q.append((current_state, [])) # Queue stores (CraftState object, path_to_reach_this_state)\n  visited.add((initial_grid_hash, current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Set a heuristic upper bound for explored states to prevent excessively long searches\n  # on very large or complex maps. This is a practical safeguard.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 150 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft()\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent runaway search.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n\n    potential_next_transitions = []\n\n    # --- Generate all potential next states from the current state ---\n\n    # 1. Explore Movement Actions (UP, DOWN, LEFT, RIGHT)\n    for action in move_actions:\n        _, next_state = state.step(action)\n        # For movement, the 'inventory_before_action' is simply the current state's inventory.\n        potential_next_transitions.append((next_state, path + [action], np.copy(state.inventory)))\n\n    # 2. Explore USE_ACT at current position\n    # Refined: Only try USE_ACT at current position if the target item is directly on the tile,\n    # OR if any grabbable item is on the current tile that could potentially be a source.\n    current_cell_kinds = np.where(state.grid[current_r, current_c, :] == 1)[0]\n    \n    should_try_use_at_pos = False\n    if i_kind in current_cell_kinds: # If the target item is directly under agent\n        should_try_use_at_pos = True\n    else: # Check if any grabbable item (from world.grabbable_indices) is under agent\n        for k_idx in current_cell_kinds:\n            if k_idx in world.grabbable_indices:\n                should_try_use_at_pos = True\n                break\n\n    if should_try_use_at_pos:\n        inventory_before_use_at_pos = np.copy(state.inventory)\n        grid_before_use_at_pos = np.copy(state.grid) # Capture grid state before USE\n        _, state_after_use_at_pos = state.step(USE_ACT)\n        \n        # Only consider this transition if the USE_ACT actually resulted in a state change\n        state_changed_by_use_at_pos = not (\n            np.array_equal(state_after_use_at_pos.inventory, inventory_before_use_at_pos) and\n            np.array_equal(state_after_use_at_pos.grid, grid_before_use_at_pos)\n        )\n        if state_changed_by_use_at_pos:\n            potential_next_transitions.append((state_after_use_at_pos, path + [USE_ACT], inventory_before_use_at_pos))\n    \n    # 3. Explore USE_ACT on adjacent cells (after turning to face them)\n    # Refined: Only try USE_ACT if the adjacent cell contains the target item,\n    # OR if it contains any non-grabbable item (as these are often sources like trees/rocks).\n    for target_dir in range(4): # Iterate through all four possible facing directions\n        dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n        facing_r, facing_c = current_r + dr, current_c + dc\n\n        # Check if the facing cell is within grid bounds.\n        if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height):\n            facing_cell_kinds = np.where(state.grid[facing_r, facing_c, :] == 1)[0]\n            \n            should_try_adj_use = False\n            if i_kind in facing_cell_kinds: # If the target item is directly in facing cell (e.g., water/stone)\n                should_try_adj_use = True\n            else: # Check if any non-grabbable item (from world.non_grabbable_indices) is in facing cell (potential source)\n                for k_idx in facing_cell_kinds:\n                    if k_idx in world.non_grabbable_indices:\n                        should_try_adj_use = True\n                        break\n            \n            if should_try_adj_use:\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                \n                # Simulate the turns to get the agent into the correct orientation before the USE_ACT.\n                temp_state_before_use_step = state\n                for turn_action in turns_to_face:\n                    _, temp_state_before_use_step = temp_state_before_use_step.step(turn_action)\n                \n                # Capture inventory and grid states immediately before the final USE_ACT.\n                inventory_before_adj_use = np.copy(temp_state_before_use_step.inventory)\n                grid_before_adj_use = np.copy(temp_state_before_use_step.grid)\n                \n                # Perform the USE_ACT.\n                _, state_after_adj_use = temp_state_before_use_step.step(USE_ACT)\n                \n                # Only add this transition if the USE_ACT resulted in a change of state.\n                state_changed_by_adj_use = not (\n                    np.array_equal(state_after_adj_use.inventory, inventory_before_adj_use) and\n                    np.array_equal(state_after_adj_use.grid, grid_before_adj_use)\n                )\n                if state_changed_by_adj_use:\n                    potential_next_transitions.append(\n                        (state_after_adj_use, path + turns_to_face + [USE_ACT], inventory_before_adj_use)\n                    )\n\n    # --- Process all generated potential next transitions ---\n    for next_s, next_p, inv_before_action in potential_next_transitions:\n        # First, check if the target primitive was successfully collected in this transition.\n        if next_s.inventory[i_kind] > inv_before_action[i_kind]:\n            return next_p # Goal achieved! Return the path immediately.\n\n        # If not the goal, add the new state to the queue if it hasn't been visited yet.\n        next_inventory_tuple = tuple(next_s.inventory)\n        next_grid_hash = hash(next_s.grid.tobytes()) # Hash grid for the visited set key\n        next_state_key = (next_grid_hash, next_s.pos[0], next_s.pos[1], next_s.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((next_s, next_p))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 2, "scores": {"3": 2.0}}
