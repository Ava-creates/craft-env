{"timestamp": "2025-08-01T11:53:15.326365", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` with a more adaptive state exploration limit and strict pruning.\n    \n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect.\n\n    Returns:\n        List[int]: A sequence of action indices to execute.\n  \"\"\"\n  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set now includes the agent's inventory as part of the state key.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing, allowing BFS to distinguish\n  # between states that are identical in position/direction but differ in inventory (e.g., having a tool vs. not).\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  \n  # Improve MAX_EXPLORED_STATES: Make it more adaptive by including world.cookbook.n_kinds,\n  # reflecting the potential size of the inventory state space. This provides a more robust\n  # upper bound for exploration than a fixed multiplier, especially in environments with\n  # many distinct item types. The multiplier '10' is a more generous base factor for broader exploration.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * world.cookbook.n_kinds * 10 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    # This provides a strict upper bound on computation.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      return [] # Terminate BFS and report no path found within limits.\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`).\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                temp_state_after_turns = state \n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                for turn_action in turns_to_face:\n                    # CraftState.step returns a new instance, so reassignment is appropriate.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the USE action from the current position, even if not directly on the target primitive.\n    # This is important if using an item at the current position (e.g., picking up a tool)\n    # can change the inventory state, which might be necessary for later steps to collect the primitive.\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if the USE action resulted in a meaningful state change (inventory, position, or direction).\n    # This prevents adding redundant states to the queue if USE had no effect.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T11:53:56.710322", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  \n  # Get the current grid, agent's position, and direction from the environment's current state.\n  grid = current_state.grid \n  initial_pos = current_state.pos  # Agent's (row, col) tuple\n  initial_dir = current_state.dir  # Agent's facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook index.\n  # Handle cases where the primitive name might not exist in the game's index.\n  try:\n      primitive_id = current_state.world.cookbook.index[primitive]\n  except KeyError:\n      # If the primitive is not recognized, it cannot be collected.\n      return []\n  \n  # Get grid dimensions. Assuming grid is (rows, cols, kinds).\n  GRID_ROWS, GRID_COLS, _ = grid.shape\n\n  # Map symbolic action names (from DSL) to their integer indices (from env.action_specs()).\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']  # In DMLab-style, 'UP' typically means move forward.\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define changes in (row, col) for moving one step forward, based on current direction.\n  # Direction mapping: 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col + 1)\n      1: (-1, 0),  # Facing UP: (row - 1, col)\n      2: (0, -1),  # Facing LEFT: (row, col - 1)\n      3: (1, 0)    # Facing DOWN: (row + 1, col)\n  }\n\n  # Define how the agent's direction changes when turning left/right.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}   # R -> U -> L -> D -> R (Counter-clockwise)\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}  # R -> D -> L -> U -> R (Clockwise)\n\n  # Compile a set of entity kinds that block agent movement.\n  # This includes non-grabbable items (e.g., BOUNDARY, WATER, WORKSHOP_X).\n  # The agent also cannot walk *onto* the primitive itself; it must be adjacent to use it.\n  non_walkable_kind_ids = current_state.world.non_grabbable_indices.copy()\n  non_walkable_kind_ids.add(primitive_id) \n\n  # Helper function to check if a given cell (r, c) is within bounds and free of obstacles.\n  def is_cell_valid_and_walkable(r_coord, c_coord):\n    # Check if coordinates are within the grid boundaries.\n    if not (0 <= r_coord < GRID_ROWS and 0 <= c_coord < GRID_COLS):\n      return False\n\n    # Check if the cell contains any entity that blocks movement.\n    # We use the initial grid snapshot for walkability checks.\n    for kind_idx in non_walkable_kind_ids:\n      if grid[r_coord, c_coord, kind_idx] > 0:\n        return False\n    \n    return True\n\n  # BFS state representation: ((row, col), direction)\n  # The queue stores tuples: ( (current_position_tuple, current_direction_int), list_of_actions_to_reach_here ).\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # The visited set stores (position_tuple, direction_int) to prevent revisiting states\n  # and infinite loops in cyclic paths.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # This will store the sequence of actions once the goal state is found.\n\n  # Perform Breadth-First Search\n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      r, c = current_pos\n\n      # 1. Goal Check: Is the agent in the pre-collection state?\n      # This means the target primitive is in the cell directly in front of the agent.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the cell in front is within grid bounds AND contains the target primitive.\n      if (0 <= front_r < GRID_ROWS and 0 <= front_c < GRID_COLS) and\\\n         (grid[front_r, front_c, primitive_id] > 0):\n          target_path_actions = path_so_far\n          break # Shortest path to reach adjacency and correct facing found, exit BFS.\n\n      # 2. Explore possible next actions (Move Forward, Turn Left, Turn Right) from the current state.\n      \n      # --- Try Move Forward ---\n      next_r_move, next_c_move = r + DIR_TO_DRDC[current_dir][0], c + DIR_TO_DRDC[current_dir][1]\n      next_pos_move = (next_r_move, next_c_move)\n      next_dir_move = current_dir # Moving forward does not change the agent's facing direction.\n\n      # Check if the next position is valid and walkable, and if this new state hasn't been visited.\n      if is_cell_valid_and_walkable(next_r_move, next_c_move):\n          if (next_pos_move, next_dir_move) not in visited:\n              visited.add((next_pos_move, next_dir_move))\n              queue.append(((next_pos_move, next_dir_move), path_so_far + [MOVE_FORWARD_ACTION]))\n\n      # --- Try Turn Left ---\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Position remains the same when turning.\n      if (current_pos, next_dir_left) not in visited:\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_so_far + [TURN_LEFT_ACTION]))\n\n      # --- Try Turn Right ---\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Position remains the same when turning.\n      if (current_pos, next_dir_right) not in visited:\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_so_far + [TURN_RIGHT_ACTION]))\n\n  # If a path to the goal state (adjacent and facing the primitive) was found,\n  # append the USE action to complete the collection process.\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T11:53:57.884228", "function_name": "collect", "function_body": "  \"\"\"Returns a list of actions to find and collect the primitive in the passed env.\n    \n    This function implements a Breadth-First Search (BFS) to find the shortest\n    sequence of actions to move the agent adjacent to a specified primitive,\n    face it, and then \"USE\" it to collect it.\n\n    Args:\n        env (env.CraftLab): The CraftLab object representing the current simulation environment.\n        primitive (str): The string name of the primitive item to collect (e.g., \"WOOD\", \"STONE\").\n\n    Returns:\n        List[int]: A sequence of integer action indices to execute (e.g., [1, 3, 4] for UP, LEFT, USE).\n                   Returns an empty list if the primitive is unknown or unreachable.\n  \"\"\"\n  current_state = env._current_state\n  \n  # Retrieve essential information from the current state for pathfinding.\n  initial_grid = current_state.grid  # The static world layout (channels: R, C, Kinds).\n  initial_pos = current_state.pos    # Agent's starting (row, col) coordinates.\n  initial_dir = current_state.dir    # Agent's starting direction (0=RIGHT, 1=UP, 2=LEFT, 3=DOWN).\n\n  # Map the string name of the primitive to its integer ID used in the grid.\n  # If the primitive name is invalid, no actions can be generated.\n  try:\n      target_primitive_id = current_state.world.cookbook.index[primitive]\n  except KeyError:\n      return [] # Primitive not recognized, cannot collect.\n\n  # Get grid dimensions (rows, columns) for boundary checks.\n  GRID_ROWS, GRID_COLS, _ = initial_grid.shape\n\n  # Map symbolic action names to their integer IDs as defined by the environment.\n  action_spec = env.action_specs()\n  ACTION_MOVE_FORWARD = action_spec['UP']    # Typically moves the agent in its current facing direction.\n  ACTION_TURN_LEFT = action_spec['LEFT']     # Turns agent 90 degrees counter-clockwise.\n  ACTION_TURN_RIGHT = action_spec['RIGHT']   # Turns agent 90 degrees clockwise.\n  ACTION_USE = action_spec['USE']            # Interacts with the cell directly in front of the agent.\n\n  # Define changes in (row, column) for each cardinal direction (0=RIGHT, 1=UP, 2=LEFT, 3=DOWN).\n  # This helps calculate the position of the cell in front of the agent, or the new agent position after moving.\n  DIRECTION_DELTAS = {\n      0: (0, 1),   # Right: (dr=0, dc=+1)\n      1: (-1, 0),  # Up:    (dr=-1, dc=0)\n      2: (0, -1),  # Left:  (dr=0, dc=-1)\n      3: (1, 0)    # Down:  (dr=+1, dc=0)\n  }\n\n  # Define how the agent's direction changes after a turn action.\n  TURN_LEFT_DIR_MAP = {0: 1, 1: 2, 2: 3, 3: 0}   # e.g., Facing RIGHT (0) and turning LEFT leads to facing UP (1).\n  TURN_RIGHT_DIR_MAP = {0: 3, 1: 0, 2: 1, 3: 2}  # e.g., Facing RIGHT (0) and turning RIGHT leads to facing DOWN (3).\n\n  # Identify entity kinds that are impassable for the agent.\n  # This set includes \"non-grabbable\" entities (like boundaries or workshops)\n  # and also the 'primitive_id' itself, as the agent collects it from an adjacent square,\n  # not by walking onto it.\n  impassable_kind_ids = current_state.world.non_grabbable_indices.copy()\n  impassable_kind_ids.add(target_primitive_id) \n\n  # Helper function to determine if a grid cell at (r, c) is traversable.\n  def is_cell_traversable(r_coord, c_coord):\n    # 1. Check if the coordinates are within the grid boundaries.\n    if not (0 <= r_coord < GRID_ROWS and 0 <= c_coord < GRID_COLS):\n      return False\n\n    # 2. Check if the cell contains any impassable entities.\n    # We use the initial_grid (static environment) for these checks.\n    for kind_idx in impassable_kind_ids:\n      if initial_grid[r_coord, c_coord, kind_idx] > 0:\n        return False # This cell contains an impassable object.\n    \n    return True # The cell is within bounds and free of known obstacles.\n\n  # --- BFS (Breadth-First Search) Algorithm Setup ---\n  # The BFS queue stores tuples:\n  # ( (current_position_tuple, current_direction_int), list_of_actions_to_reach_this_state )\n  bfs_queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # The 'visited' set keeps track of (position_tuple, direction_int) states\n  # that have already been explored, preventing cycles and ensuring the shortest path.\n  visited_states = {(initial_pos, initial_dir)}\n\n  # This variable will store the final sequence of actions leading to the state\n  # where the agent is ready to 'USE' the primitive (i.e., adjacent and facing it).\n  shortest_path_to_pre_use_state = None\n\n  # Start the BFS traversal\n  while bfs_queue:\n      # Dequeue the current state and the path taken to reach it.\n      (current_pos, current_dir), path_actions = bfs_queue.popleft()\n      current_r, current_c = current_pos # Unpack current row and column.\n\n      # --- Goal Check: Is the agent currently in a state where the target primitive\n      # is directly in front and ready to be collected (used)? ---\n      # Calculate the coordinates of the cell directly in front of the agent.\n      dr_front, dc_front = DIRECTION_DELTAS[current_dir]\n      front_r, front_c = current_r + dr_front, current_c + dc_front\n\n      # Check if the 'front' cell is within the grid and contains the target primitive.\n      if (0 <= front_r < GRID_ROWS and 0 <= front_c < GRID_COLS) and \\\n         (initial_grid[front_r, front_c, target_primitive_id] > 0):\n          shortest_path_to_pre_use_state = path_actions # Found the path!\n          break # Exit the BFS loop; the first path found by BFS is guaranteed to be the shortest.\n\n      # --- Explore Possible Next Actions: Move Forward, Turn Left, Turn Right ---\n\n      # 1. Try to Move Forward:\n      next_r_move, next_c_move = current_r + DIRECTION_DELTAS[current_dir][0], \\\n                                 current_c + DIRECTION_DELTAS[current_dir][1]\n      next_pos_move = (next_r_move, next_c_move)\n      next_dir_move = current_dir # Direction doesn't change when moving forward.\n\n      # If the next cell is traversable and this (position, direction) state hasn't been visited:\n      if is_cell_traversable(next_r_move, next_c_move) and \\\n         ((next_pos_move, next_dir_move) not in visited_states):\n          visited_states.add((next_pos_move, next_dir_move))\n          bfs_queue.append(((next_pos_move, next_dir_move), path_actions + [ACTION_MOVE_FORWARD]))\n\n      # 2. Try to Turn Left:\n      next_dir_left = TURN_LEFT_DIR_MAP[current_dir]\n      # Position remains the same when turning.\n      if ((current_pos, next_dir_left) not in visited_states):\n          visited_states.add((current_pos, next_dir_left))\n          bfs_queue.append(((current_pos, next_dir_left), path_actions + [ACTION_TURN_LEFT]))\n\n      # 3. Try to Turn Right:\n      next_dir_right = TURN_RIGHT_DIR_MAP[current_dir]\n      # Position remains the same when turning.\n      if ((current_pos, next_dir_right) not in visited_states):\n          visited_states.add((current_pos, next_dir_right))\n          bfs_queue.append(((current_pos, next_dir_right), path_actions + [ACTION_TURN_RIGHT]))\n\n  # --- Construct the Final List of Actions ---\n  final_action_sequence = []\n  if shortest_path_to_pre_use_state is not None:\n      # If a path was found to position the agent correctly, add those actions.\n      final_action_sequence.extend(shortest_path_to_pre_use_state)\n      # Then, append the 'USE' action to actually collect the primitive.\n      final_action_sequence.append(ACTION_USE)\n      \n  return final_action_sequence", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T11:54:55.896976", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state # Access the underlying CraftState for detailed info\n\n  initial_grid = current_state.grid # (rows, columns, kinds) numpy array\n  initial_agent_pos = current_state.pos  # Agent's starting position (row, col)\n  initial_agent_dir = current_state.dir  # Agent's starting facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook's index\n  # This maps string names (e.g., \"WOOD\") to their integer representations.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Determine grid dimensions for boundary checks\n  grid_rows, grid_cols, _ = initial_grid.shape # Correctly parse shape as (rows, columns, ...)\n\n  # Retrieve integer action IDs from the environment's action specifications\n  # These are the numeric codes for actions like moving forward, turning, and using.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # Corresponds to moving forward in the current direction\n  TURN_LEFT_ACTION = action_map['LEFT']     # Corresponds to turning 90 degrees left\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Corresponds to turning 90 degrees right\n  USE_ACTION = action_map['USE']            # Action to interact with the cell directly in front\n\n  # Direction vectors (dr, dc) for agent's facing direction.\n  # These define how row and column coordinates change when moving \"forward\".\n  # Mapping: 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row-1, col)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # Mapping for updating agent's direction when turning left or right.\n  # Directions cycle: 0 -> 1 -> 2 -> 3 -> 0 for left turns.\n  TURN_LEFT_DIR_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # RIGHT->UP->LEFT->DOWN->RIGHT\n  TURN_RIGHT_DIR_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # RIGHT->DOWN->LEFT->UP->RIGHT\n\n  # Get indices of entities that block agent movement (e.g., BOUNDARY, WATER, WORKSHOP_X).\n  # The agent cannot walk onto cells containing these kinds.\n  # Convert the set to a list once for efficient NumPy array indexing during walkability checks.\n  non_walkable_kinds_indices_list = list(current_state.world.non_grabbable_indices)\n\n  # BFS Initialization:\n  # The queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_to_reach_here)\n  # A state includes both position and orientation because actions (like 'USE') depend on direction,\n  # and possible next positions depend on current direction.\n  queue = collections.deque([((initial_agent_pos, initial_agent_dir), [])])\n  \n  # The visited set stores (position_tuple, direction_int) to avoid redundant computations, cycles,\n  # and ensure finding the shortest path (BFS guarantees this for unweighted graphs).\n  visited = {(initial_agent_pos, initial_agent_dir)}\n\n  # This variable will store the sequence of actions to reach the state where the primitive is in front.\n  path_to_primitive_adjacency = None \n\n  while queue:\n      (current_pos, current_dir), path_taken = queue.popleft()\n      current_row, current_col = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent from the current state.\n      # If it is, we've found our target \"adjacency\" state for collection.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_cell_row, front_cell_col = current_row + front_dr, current_col + front_dc\n      \n      # Ensure the cell in front is within grid boundaries before checking its contents.\n      if (0 <= front_cell_row < grid_rows and 0 <= front_cell_col < grid_cols):\n          # Check if the primitive is present in this front cell.\n          if initial_grid[front_cell_row, front_cell_col, primitive_id] > 0:\n              path_to_primitive_adjacency = path_taken\n              break # Target state found, stop BFS.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n      # These actions change the agent's state (position and/or direction).\n\n      # Try Move Forward action:\n      move_dr, move_dc = DIR_TO_DRDC[current_dir] # Delta for moving forward\n      next_row, next_col = current_row + move_dr, current_col + move_dc\n      next_pos = (next_row, next_col)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # First, check if the potential next position is valid (within grid bounds)\n      # Then, check if this specific (position, direction) state has not been visited yet.\n      if (0 <= next_row < grid_rows and 0 <= next_col < grid_cols and\n          (next_pos, next_dir) not in visited):\n          \n          # Determine if the next cell is walkable.\n          # A cell is not walkable if it contains any non-grabbable entity (like a wall, water, workshop),\n          # or if it contains the primitive itself (agent must be adjacent to 'use', not on top).\n          cell_is_blocked = False\n          \n          # Check if any non-grabbable items are at the potential next position using NumPy's any.\n          if np.any(initial_grid[next_row, next_col, non_walkable_kinds_indices_list] > 0):\n              cell_is_blocked = True\n          # Agent cannot walk ONTO the primitive it wants to collect.\n          elif initial_grid[next_row, next_col, primitive_id] > 0:\n              cell_is_blocked = True\n\n          if not cell_is_blocked:\n              visited.add((next_pos, next_dir)) # Mark new state as visited\n              # Add to queue with the updated path, including the MOVE_FORWARD_ACTION.\n              queue.append(((next_pos, next_dir), path_taken + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left action:\n      next_dir_left = TURN_LEFT_DIR_MAP[current_dir] # Calculate new direction after turning left\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left)) # Mark new state as visited\n          # Add to queue with updated path, including the TURN_LEFT_ACTION.\n          queue.append(((current_pos, next_dir_left), path_taken + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right action:\n      next_dir_right = TURN_RIGHT_DIR_MAP[current_dir] # Calculate new direction after turning right\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right)) # Mark new state as visited\n          # Add to queue with updated path, including the TURN_RIGHT_ACTION.\n          queue.append(((current_pos, next_dir_right), path_taken + [TURN_RIGHT_ACTION]))\n\n  # After BFS completes (either target found or queue empty):\n  # If a path to the target adjacency state was found, append the USE action to complete the collection.\n  if path_to_primitive_adjacency is not None:\n      actions_list.extend(path_to_primitive_adjacency)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T11:54:57.052382", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state # Access the underlying CraftState for detailed information\n\n  initial_grid = current_state.grid # (rows, columns, kinds) numpy array representing the environment\n  initial_agent_pos = current_state.pos  # Agent's starting position (row, col)\n  initial_agent_dir = current_state.dir  # Agent's starting facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook's index.\n  # This translates string names (e.g., \"WOOD\") to their unique integer IDs.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Determine grid dimensions for boundary checks to ensure valid cell access.\n  grid_rows, grid_cols, _ = initial_grid.shape\n\n  # Retrieve integer action IDs from the environment's action specifications.\n  # These are the numeric codes corresponding to various agent actions.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # Action to move one step forward in current direction\n  TURN_LEFT_ACTION = action_map['LEFT']     # Action to turn 90 degrees left\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Action to turn 90 degrees right\n  USE_ACTION = action_map['USE']            # Action to interact with the cell directly in front\n\n  # Define direction vectors (dr, dc) for each of the four agent orientations.\n  # These deltas specify how row and column coordinates change when moving \"forward\".\n  # Mapping: 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # Define mappings for updating agent's direction when turning left or right.\n  # These ensure the direction cycles correctly (e.g., RIGHT -> UP -> LEFT -> DOWN -> RIGHT for left turns).\n  TURN_LEFT_DIR_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # RIGHT->UP->LEFT->DOWN->RIGHT\n  TURN_RIGHT_DIR_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # RIGHT->DOWN->LEFT->UP->RIGHT\n\n  # Get indices of entities that block agent movement (e.g., BOUNDARY, WATER, WORKSHOP_X).\n  # Convert the `set` of non-grabbable indices to a `list` once. This allows for\n  # efficient NumPy array indexing (e.g., `initial_grid[r, c, list_of_indices]`) during checks.\n  non_walkable_kinds_indices_list = list(current_state.world.non_grabbable_indices)\n\n  # BFS Initialization:\n  # The queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_here).\n  # A state in this BFS is defined by both the agent's position and its orientation,\n  # as actions like 'USE' and possible next movement cells depend on direction.\n  queue = collections.deque([((initial_agent_pos, initial_agent_dir), [])])\n  \n  # The visited set stores (position_tuple, direction_int) pairs.\n  # This prevents redundant computations, avoids cycles in the search, and\n  # ensures that the first path found by BFS is indeed the shortest one.\n  visited = {(initial_agent_pos, initial_agent_dir)}\n\n  # This variable will store the sequence of actions that leads the agent to\n  # a state where the primitive is directly in front of it and ready for collection.\n  path_to_primitive_adjacency = None \n\n  while queue:\n      (current_pos, current_dir), path_taken = queue.popleft()\n      current_row, current_col = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent from the current state.\n      # If it is, we have found the target \"adjacency\" state for collection.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_cell_row, front_cell_col = current_row + front_dr, current_col + front_dc\n      \n      # Ensure the cell in front is within grid boundaries before checking its contents.\n      if (0 <= front_cell_row < grid_rows and 0 <= front_cell_col < grid_cols):\n          # If the primitive is present in this front cell, we've found our path.\n          if initial_grid[front_cell_row, front_cell_col, primitive_id] > 0:\n              path_to_primitive_adjacency = path_taken\n              break # Target state found, exit BFS.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n      # Each action potentially changes the agent's state (position and/or direction).\n\n      # Try Move Forward action:\n      move_dr, move_dc = DIR_TO_DRDC[current_dir] # Calculate deltas for moving forward\n      next_row, next_col = current_row + move_dr, current_col + move_dc\n      next_pos = (next_row, next_col)\n      next_dir = current_dir # Moving forward does not change the agent's facing direction\n\n      # Check if the potential next position is valid (within grid boundaries)\n      # and if this specific (position, direction) state has not been visited yet.\n      if (0 <= next_row < grid_rows and 0 <= next_col < grid_cols and\n          (next_pos, next_dir) not in visited):\n          \n          # Determine if the next cell is blocked.\n          # A cell is blocked if it contains the primitive itself (agent cannot walk onto it),\n          # or if it contains any non-grabbable/non-walkable entity (e.g., a wall, water).\n          \n          # Check if the next cell contains the primitive we want to collect.\n          # Agents must be *adjacent* to primitive to 'USE' it, not on the same square.\n          is_blocked_by_primitive = initial_grid[next_row, next_col, primitive_id] > 0\n\n          # Check if the next cell contains any non-walkable terrain.\n          is_blocked_by_non_walkable_terrain = False\n          if non_walkable_kinds_indices_list: # Ensure the list of non-walkable kinds is not empty\n              # Use np.any to efficiently check if any of the non-walkable kinds are present in the cell.\n              is_blocked_by_non_walkable_terrain = np.any(initial_grid[next_row, next_col, non_walkable_kinds_indices_list] > 0)\n\n          # If the cell is not blocked by the primitive itself and not by non-walkable terrain, it's a valid move.\n          if not is_blocked_by_primitive and not is_blocked_by_non_walkable_terrain:\n              visited.add((next_pos, next_dir)) # Mark new state as visited\n              # Add to queue with the updated path, including the MOVE_FORWARD_ACTION.\n              queue.append(((next_pos, next_dir), path_taken + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left action:\n      next_dir_left = TURN_LEFT_DIR_MAP[current_dir] # Calculate the new direction after turning left\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left)) # Mark new state as visited\n          # Add to queue with the updated path, including the TURN_LEFT_ACTION.\n          queue.append(((current_pos, next_dir_left), path_taken + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right action:\n      next_dir_right = TURN_RIGHT_DIR_MAP[current_dir] # Calculate the new direction after turning right\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right)) # Mark new state as visited\n          # Add to queue with the updated path, including the TURN_RIGHT_ACTION.\n          queue.append(((current_pos, next_dir_right), path_taken + [TURN_RIGHT_ACTION]))\n\n  # After BFS completes (either a path is found or the queue becomes empty):\n  # If a path to the target adjacency state was found, append the 'USE' action to complete the collection.\n  if path_to_primitive_adjacency is not None:\n      actions_list.extend(path_to_primitive_adjacency)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T11:56:02.328484", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n  Adds explicit handling for unknown primitive names and ensures robustness.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state\n  \n  # Get the integer ID for the primitive name\n  # Use .get() method of Index to avoid KeyError if primitive is not found, returning None.\n  primitive_id = current_state.world.cookbook.index.get(primitive)\n  \n  # --- Improvement: Handle unknown primitive names ---\n  if primitive_id is None:\n      # If the primitive name does not map to a known ID in the cookbook,\n      # it cannot be collected. Return an empty list of actions.\n      return []\n\n  # Ensure the primitive is actually grabbable.\n  # The 'collect' action in this DSL implies picking up an item from the grid using 'USE'.\n  # If the item is not in the list of grabbable items (e.g., water, workshops, crafted items\n  # not yet on the grid), it cannot be collected in this manner.\n  if primitive_id not in current_state.world.grabbable_indices:\n      return []\n\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (row, column) of agent's current position\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  # Get grid dimensions (WIDTH corresponds to rows, HEIGHT to columns)\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # Map action names to their integer indices\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP'] # Assuming 'UP' corresponds to moving forward\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define changes in (row, column) for each facing direction when moving forward\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT (0): move in positive column direction\n      1: (-1, 0),  # Facing UP (1): move in negative row direction\n      2: (0, -1),  # Facing LEFT (2): move in negative column direction\n      3: (1, 0)    # Facing DOWN (3): move in positive row direction\n  }\n\n  # Define how agent's direction changes when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}   # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Identify all cell types that the agent cannot walk onto.\n  # This includes non-grabbable environment elements (like BOUNDARY, WATER, WORKSHOP_X)\n  # and also the target primitive itself, as the agent collects from an adjacent cell,\n  # not by walking over the item.\n  non_walkable_indices = current_state.world.non_grabbable_indices.union({primitive_id})\n  # Convert to a list for efficient NumPy advanced indexing in the grid check\n  non_walkable_indices_list = list(non_walkable_indices) \n\n  # BFS setup: Queue stores ( (current_position_tuple, current_direction_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (position_tuple, direction_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # To store the sequence of actions once the target state is found\n\n  # Perform Breadth-First Search\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent from the current state.\n      # This is the desired goal state for collection: agent is adjacent and facing the primitive.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the cell directly in front is within grid bounds\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          # Check if the front cell contains the primitive we want to collect (count > 0)\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Found the shortest path to an adjacent-and-facing position\n\n      # 2. Explore possible next actions: Move Forward, Turn Left, Turn Right\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if next_pos is within bounds\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT):\n          # Check if this (position, direction) state hasn't been visited yet\n          if (next_pos, next_dir) not in visited:\n              # Check if the next_pos is walkable. It must not contain any non-walkable item.\n              # np.any will be True if any of the specified obstacle kinds are present at the cell\n              if not np.any(initial_grid[next_r, next_c, non_walkable_indices_list] > 0):\n                  visited.add((next_pos, next_dir))\n                  queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning changes direction but not position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning changes direction but not position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path was found to an adjacent-and-facing state, append the USE action to the sequence.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-08-01T11:56:03.434829", "function_name": "collect", "function_body": "", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-08-01T11:57:10.145487", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Map the primitive name (string) to its integer ID.\n  # This ID is used internally by the simulation to represent different item kinds.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not found in the cookbook, it's an invalid target.\n    return []\n\n  # 2. Early exit condition: If the agent already possesses the target primitive in its inventory,\n  # no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Determine if the primitive is inherently collectible via the 'USE' action in the game.\n  # Collectible items typically include grabbable items, water, and stone.\n  # Non-collectible items (e.g., workshops, boundaries) cannot be picked up into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the target item cannot be collected using the 'USE' action, we cannot fulfill the request.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define constant integer IDs for actions and spatial relationships.\n  # These IDs are retrieved from the environment's action specifications.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  # List of basic movement actions for iteration during BFS.\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the corresponding (row_change, col_change) for the cell directly in front.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: Decreases row (moves North)\n      1: (0, 1),  # RIGHT: Increases column (moves East)\n      2: (1, 0),  # DOWN: Increases row (moves South)\n      3: (0, -1)  # LEFT: Decreases column (moves West)\n  }\n\n  # Helper function to compute the minimal sequence of turning actions required\n  # for the agent to change from its `current_dir` to a `target_dir`.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n\n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference that correctly\n      # represents the shortest turn (e.g., from 3 to 0 is 1 step clockwise).\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2 (180-degree turn, e.g., UP(0) -> DOWN(2))\n          # Two consecutive turns in the same direction achieve a 180-degree rotation.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose two RIGHT_ACTs\n\n  # 5. Initialize Breadth-First Search (BFS) data structures.\n  # The queue stores tuples of (CraftState, list_of_actions_to_reach_this_state).\n  q = collections.deque() \n  \n  # The 'visited' set keeps track of explored states to prevent cycles and redundant exploration.\n  # A state is uniquely identified by (agent_row, agent_col, agent_direction, inventory_tuple).\n  # Inventory is included because acquiring items (like tools) can change future interaction possibilities.\n  visited = set()\n\n  # Add the initial state to the queue and mark it as visited.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  # Get grid dimensions from the current state for boundary checks.\n  grid_width, grid_height, _ = current_state.grid.shape\n  \n  # Heuristic limits for BFS exploration. These values are tuned to prevent the search from running\n  # indefinitely in very complex or large state spaces, ensuring a practical search time.\n  # MAX_EXPLORED_STATES limits the number of unique (pos, dir, inventory) states considered.\n  # A multiplier (e.g., 50) accounts for various inventory combinations that can form distinct states.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 50 \n  explored_states_count = 0\n\n  # MAX_PATH_LENGTH limits the maximum number of actions in a valid path returned.\n  # If the shortest path found exceeds this, it is considered too inefficient for practical plans.\n  MAX_PATH_LENGTH = 300 # A reasonable upper bound for plan length.\n\n  # 6. BFS Loop: Continues as long as there are states to explore in the queue.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the action path leading to it\n    explored_states_count += 1\n\n    # Pruning: If the number of distinct states processed exceeds the heuristic limit,\n    # it implies that a reasonably short path might not exist, or the search is too extensive.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      return [] \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # --- Goal Check and Collection Attempt ---\n    # Check if the target primitive (`i_kind`) is present in the agent's 3x3 neighborhood.\n    if state.next_to(i_kind):\n        # If the primitive is nearby, iterate through all four possible agent orientations\n        # (UP, RIGHT, DOWN, LEFT) to determine if facing one of them would put the\n        # primitive directly in front of the agent.\n        for target_dir in range(4): \n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Verify that the cell directly in front (if facing `target_dir`) is:\n            # a) within grid boundaries, and b) actually contains an instance of the primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Calculate the sequence of turning actions required to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                \n                # Simulate these turning actions to get the agent into the correct orientation.\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    # The reward for turning is typically 0.0, so it's ignored here.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store the inventory state *before* attempting the 'USE' action.\n                # This is crucial for verifying if 'USE' successfully collected the primitive.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action from the correctly oriented state.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical verification: Check if the count of the target primitive in\n                # the inventory *increased* after the 'USE' action. This confirms\n                # successful collection, accounting for any game rules (e.g., needing\n                # a specific tool) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    # If collected, a valid path has been found. Return the full sequence\n                    # of actions: path to reach the location, turns to face, and the final USE.\n                    final_path = path + turns_to_face + [USE_ACT]\n                    \n                    # Apply path length constraint: If the shortest path found is too long,\n                    # consider it unachievable for practical purposes.\n                    if len(final_path) <= MAX_PATH_LENGTH:\n                        return final_path\n                    else:\n                        # The shortest path found is too long. No viable path within limits.\n                        return [] \n\n    # --- Explore New States through Actions ---\n    # 1. Explore possible movement actions (UP, DOWN, LEFT, RIGHT).\n    for action in move_actions:\n      _, next_state = state.step(action)\n      # Convert the inventory of the new state to a tuple for hashability in the `visited` set.\n      next_inventory_tuple = tuple(next_state.inventory) \n      # Create a unique key for the visited set, representing the agent's full state.\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      # If this new state has not been visited before, add it to the queue and mark it as visited.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # 2. Explore the 'USE' action generally from the current position.\n    # This is distinct from the 'USE' in the goal check. This general 'USE' handles scenarios\n    # where using an item at the current location might change the inventory\n    # (e.g., picking up a tool like an axe or shears), enabling future collection of other primitives,\n    # even if it doesn't directly collect the *target* primitive.\n    inventory_before_current_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Only add the state resulting from this general 'USE' if it actually led to a\n    # meaningful change (inventory, position, or direction). This prevents adding\n    # redundant states to the queue if 'USE' had no effect (e.g., using nothing or\n    # using an item that doesn't change the state).\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_current_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        # Add this 'USE'-resultant state to the queue if it's a new, unvisited state.\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS loop completes and the queue becomes empty without finding a path\n  # to collect the target primitive, it means the primitive is unreachable from the\n  # initial state under the current game conditions within the defined exploration limits.\n  return []", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T11:57:12.784382", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set tracks previously explored states to avoid cycles and redundant computation.\n  # A state is defined by (agent_row, agent_col, agent_direction, inventory_tuple).\n  # The inventory_tuple is crucial as agent capabilities can change with acquired items\n  # (e.g., picking up a tool makes new interactions possible).\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # MAX_EXPLORED_STATES is a heuristic limit to prevent excessive search in very large or complex state spaces,\n  # especially when many inventory variations might be possible for a given position/direction.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 50 \n  explored_states_count = 0\n\n  # MAX_PATH_LENGTH is a heuristic limit on the total number of actions in a plan.\n  # Paths longer than this are considered too inefficient or practically unachievable.\n  MAX_PATH_LENGTH = 250\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop and return empty list immediately.\n    # This acts as a hard limit on the total number of states processed.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      return [] \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`) in the 3x3 neighborhood.\n    if state.next_to(i_kind):\n        for target_dir in range(4): # Iterate through possible agent orientations (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell directly in front contains the target primitive\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                \n                # Prune if the potential final path (current path + turns + USE) exceeds the max length.\n                if len(path) + len(turns_to_face) + 1 > MAX_PATH_LENGTH:\n                    continue # This specific path to collect is too long, try other directions/paths.\n\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    # Apply each turn action to get the state after all turns.\n                    # Reward is ignored as we are pathfinding, not optimizing reward.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`).\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    # If collected, a valid path has been found within constraints.\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      # Prune if adding this action would make the path too long.\n      if len(path) + 1 <= MAX_PATH_LENGTH: \n        _, next_state = state.step(action)\n        next_inventory_tuple = tuple(next_state.inventory)\n        next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n          visited.add(next_state_key)\n          q.append((next_state, path + [action]))\n    \n    # Explore the USE action from the current position generally.\n    # This is important if using an item at the current position (e.g., picking up a tool)\n    # can change the inventory state, which might be necessary for later steps to collect the primitive.\n    # Prune if adding this action would make the path too long.\n    if len(path) + 1 <= MAX_PATH_LENGTH:\n        inventory_before_any_use = np.copy(state.inventory)\n        _, state_after_current_use = state.step(USE_ACT)\n        \n        # Check if the USE action resulted in a meaningful state change (inventory, position, or direction).\n        # This prevents adding redundant states to the queue if USE had no effect.\n        if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n                state_after_current_use.pos == state.pos and\n                state_after_current_use.dir == state.dir):\n\n            next_inventory_tuple = tuple(state_after_current_use.inventory)\n            next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n            if next_state_key not in visited:\n                visited.add(next_state_key)\n                q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions\n  # and within the defined exploration limits.\n  return []", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T11:59:52.513462", "function_name": "collect", "function_body": "  import heapq # This line must be inside if not available globally based on instructions\n  \n  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    return []\n\n  # 2. Semantic check: Determine if this primitive is *actually* collectible into inventory.\n  # Grabbable items can be picked up by standing on them and USEing.\n  # Special collectible environment items (water, stone) are collected by being adjacent and USEing.\n  # Primitives are a cookbook concept for basic resources.\n  # The union of these defines what 'collect' might apply to.\n  is_primitive_resource = i_kind in world.cookbook.primitives\n  is_special_collectible_environment = (i_kind == world.water_index or i_kind == world.stone_index)\n  # A grabbable item that is NOT a special environment resource means it's usually picked up from the same tile.\n  is_grabbable_on_square = i_kind in world.grabbable_indices and not is_special_collectible_environment\n\n  if not (is_primitive_resource or is_special_collectible_environment or is_grabbable_on_square):\n      # If it's not a primitive resource, a special environmental one, or generally grabbable from a square,\n      # it's not something this 'collect' function is designed to acquire.\n      return []\n\n  # 3. Check if the primitive is already in the agent's inventory.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP (row decreases)\n      1: (0, 1),  # RIGHT (col increases)\n      2: (1, 0),  # DOWN (row increases)\n      3: (0, -1)  # LEFT (col decreases)\n  }\n  \n  _ALL_DELTAS = [(-1, 0), (1, 0), (0, -1), (0, 1)] # For checking 4 adjacent cells\n\n  # Helper function to calculate the shortest sequence of turning actions.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return []\n      diff = (target_dir - current_dir + 4) % 4 # Ensure positive difference (0 to 3)\n      if diff == 1: # Current -> Current+1 (e.g., UP->RIGHT)\n          return [RIGHT_ACT]\n      elif diff == 3: # Current -> Current-1 (e.g., UP->LEFT)\n          return [LEFT_ACT]\n      else: # diff == 2 (180-degree turn, e.g., UP->DOWN)\n          return [RIGHT_ACT, RIGHT_ACT] # Or [LEFT_ACT, LEFT_ACT]\n\n  # Heuristic function for A* search.\n  # Estimates the minimum additional cost (actions) to reach the goal (acquiring i_kind).\n  # Uses Manhattan distance as a lower bound.\n  def h(state, target_i_kind_idx):\n      if state.inventory[target_i_kind_idx] > 0:\n          return 0 # Goal already achieved\n\n      min_dist_to_target = float('inf')\n      \n      grid_width, grid_height, _ = state.grid.shape\n      \n      # Find all locations of the target item on the grid\n      target_locations = np.argwhere(state.grid[:, :, target_i_kind_idx] == 1)\n\n      if len(target_locations) == 0:\n          return float('inf') # Target item not currently on grid or present\n\n      for r_item, c_item in target_locations:\n          if is_grabbable_on_square: # Agent needs to be ON the square to collect\n              dist = abs(state.pos[0] - r_item) + abs(state.pos[1] - c_item)\n              min_dist_to_target = min(min_dist_to_target, dist)\n          elif is_special_collectible_environment: # Agent needs to be ADJACENT to the square to collect\n              for dr, dc in _ALL_DELTAS:\n                  adj_r, adj_c = r_item + dr, c_item + dc\n                  # Check if adjacent cell is within grid bounds\n                  if 0 <= adj_r < grid_width and 0 <= adj_c < grid_height:\n                      dist = abs(state.pos[0] - adj_r) + abs(state.pos[1] - adj_c)\n                      min_dist_to_target = min(min_dist_to_target, dist)\n      \n      if min_dist_to_target == float('inf'):\n          return float('inf') # Target cannot be reached via direct movement path to a collectable spot\n\n      # Add 1 for the 'USE' action itself. This makes the heuristic admissible.\n      return min_dist_to_target + 1\n\n  # 5. Initialize A* Search.\n  # open_set: Priority Queue (min-heap) of (f_cost, g_cost, state_key, state_object, path_so_far)\n  #   f_cost = g_cost + h_cost\n  open_set = []\n  \n  # g_scores: Dictionary mapping state_key to the lowest known g_cost to reach that state.\n  g_scores = {}\n  \n  initial_inventory_tuple = tuple(current_state.inventory)\n  initial_state_key = (current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple)\n\n  initial_g_cost = 0\n  initial_h_cost = h(current_state, i_kind)\n  initial_f_cost = initial_g_cost + initial_h_cost\n\n  # Push the starting state to the priority queue\n  heapq.heappush(open_set, (initial_f_cost, initial_g_cost, initial_state_key, current_state, []))\n  g_scores[initial_state_key] = initial_g_cost\n\n  # Set a heuristic upper bound for explored states to prevent excessively long searches.\n  # This acts as a safeguard against very complex or unreachable scenarios.\n  grid_width, grid_height, _ = current_state.grid.shape\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 500 \n\n  explored_states_count = 0\n\n  # 6. A* Loop.\n  while open_set:\n    f_cost, g_cost, state_key, state, path = heapq.heappop(open_set)\n    explored_states_count += 1\n\n    # If we already found a shorter path to this state_key, skip.\n    # This happens if a state is added to the open_set multiple times via different paths,\n    # but a shorter path was processed earlier.\n    if g_cost > g_scores.get(state_key, float('inf')):\n        continue\n\n    # Pruning: If too many states have been explored, stop searching.\n    if explored_states_count > MAX_EXPLORED_STATES:\n        continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n\n    # List to store (next_state_object, action_cost, actions_to_reach_next_state, inventory_before_last_action_applied)\n    potential_next_transitions = []\n\n    # 1. Explore Movement Actions (UP, DOWN, LEFT, RIGHT)\n    for action in move_actions:\n        # Simulate step to get the next state.\n        # The cost of a move action is 1.\n        inventory_before_action = np.copy(state.inventory) # Capture inventory *before* this action\n        _, next_state = state.step(action)\n        potential_next_transitions.append((next_state, 1, path + [action], inventory_before_action))\n\n    # 2. Explore USE_ACT at current position\n    # This covers picking up items from the current square.\n    inventory_before_action = np.copy(state.inventory)\n    _, state_after_use_at_pos = state.step(USE_ACT)\n    # Check if the state actually changed as a result of the USE action.\n    # This avoids adding redundant states if USE did nothing (e.g., empty square).\n    state_changed_by_use_at_pos = not (\n        np.array_equal(state_after_use_at_pos.inventory, inventory_before_action) and\n        state_after_use_at_pos.pos == state.pos and\n        state_after_use_at_pos.dir == state.dir\n    )\n    if state_changed_by_use_at_pos:\n        potential_next_transitions.append((state_after_use_at_pos, 1, path + [USE_ACT], inventory_before_action))\n    \n    # 3. Explore USE_ACT on adjacent cells (after turning to face them)\n    # This covers interacting with environmental resources like water or stone.\n    for target_dir_val in range(4): # Iterate through all 4 possible facing directions\n        dr, dc = _DIR_TO_DELTA_FRONT[target_dir_val]\n        facing_r, facing_c = current_r + dr, current_c + dc\n\n        # Check if the facing cell is within bounds and contains any interactable entity.\n        if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height) and np.any(state.grid[facing_r, facing_c, :] == 1):\n            turns_to_face = _get_turning_actions(current_dir, target_dir_val)\n            \n            # Simulate the turning actions to get the state right before the final USE_ACT.\n            temp_state_before_use_step = state\n            for turn_action in turns_to_face:\n                _, temp_state_before_use_step = temp_state_before_use_step.step(turn_action)\n            \n            inventory_before_action = np.copy(temp_state_before_use_step.inventory)\n            _, state_after_adj_use = temp_state_before_use_step.step(USE_ACT)\n            \n            # Check if the state actually changed as a result of the USE action.\n            state_changed_by_adj_use = not (\n                np.array_equal(state_after_adj_use.inventory, inventory_before_action) and\n                state_after_adj_use.pos == temp_state_before_use_step.pos and\n                state_after_adj_use.dir == temp_state_before_use_step.dir\n            )\n            if state_changed_by_adj_use:\n                action_cost = len(turns_to_face) + 1 # Cost includes turns and the final USE action\n                potential_next_transitions.append(\n                    (state_after_adj_use, action_cost, path + turns_to_face + [USE_ACT], inventory_before_action)\n                )\n\n    # --- Process all generated potential next transitions ---\n    for next_s, action_cost, next_p, inv_before_action in potential_next_transitions:\n        # GOAL CHECK: If the target primitive was successfully collected in this transition.\n        if next_s.inventory[i_kind] > inv_before_action[i_kind]:\n            return next_p # Goal achieved! Return the path immediately.\n\n        # Prepare for adding to open set if not goal\n        next_inventory_tuple = tuple(next_s.inventory)\n        next_state_key = (next_s.pos[0], next_s.pos[1], next_s.dir, next_inventory_tuple)\n\n        # Calculate new g_cost and f_cost for A*\n        new_g_cost = g_cost + action_cost\n        \n        # If this path to next_state_key is shorter, or we haven't seen it yet\n        if new_g_cost < g_scores.get(next_state_key, float('inf')):\n            g_scores[next_state_key] = new_g_cost\n            new_h_cost = h(next_s, i_kind)\n            new_f_cost = new_g_cost + new_h_cost\n            \n            # Add to open set only if the heuristic is not infinite (meaning it's potentially reachable)\n            if new_h_cost != float('inf'):\n                heapq.heappush(open_set, (new_f_cost, new_g_cost, next_state_key, next_s, next_p))\n\n  # 7. If the A* queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T11:59:55.744030", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Semantic check: Determine if this primitive is *actually* collectible into inventory.\n  # This includes items defined as primitives, special environment items like water/stone,\n  # and any other items explicitly marked as grabbable.\n  is_primitive_resource = i_kind in world.cookbook.primitives\n  is_special_collectible_environment = (i_kind == world.water_index or i_kind == world.stone_index)\n  is_grabbable = i_kind in world.grabbable_indices\n\n  if not (is_primitive_resource or is_special_collectible_environment or is_grabbable):\n      # The requested primitive is not collectible.\n      return []\n\n  # 3. Check if the primitive is already in the agent's inventory.\n  if current_state.inventory[i_kind] > 0:\n      # Primitive is already collected, no actions needed.\n      return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row decreases, col stays same\n      1: (0, 1),  # RIGHT: row stays same, col increases\n      2: (1, 0),  # DOWN: row increases, col stays same\n      3: (0, -1)  # LEFT: row stays same, col decreases\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return []\n      # Calculate difference ensuring it's positive and within [0, 3]\n      diff = (target_dir - current_dir + 4) % 4\n      if diff == 1:\n          return [RIGHT_ACT] # One right turn\n      elif diff == 3:\n          return [LEFT_ACT]  # One left turn\n      else: # diff == 2 (180-degree turn)\n          return [RIGHT_ACT, RIGHT_ACT] # Two right turns (or two left turns)\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The visited set must capture the full state to prevent redundant exploration,\n  # especially if grid changes without immediate inventory/position changes.\n  # State key: (grid_hash, row, col, direction, inventory_tuple)\n  visited = set() \n\n  initial_inventory_tuple = tuple(current_state.inventory)\n  # Hash the grid to include its state in the visited key.\n  # .tobytes() converts the numpy array to a bytes object, which is hashable.\n  initial_grid_hash = hash(current_state.grid.tobytes()) \n\n  q.append((current_state, [])) # Queue stores (CraftState object, path_to_reach_this_state)\n  visited.add((initial_grid_hash, current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Set a heuristic upper bound for explored states to prevent excessively long searches\n  # on very large or complex maps. This is a practical safeguard.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 150 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft()\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent runaway search.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n\n    # List to store (next_state_object, actions_to_reach_next_state, inventory_before_last_action_applied)\n    # Storing 'inventory_before_last_action_applied' is crucial for checking if the goal item\n    # was *specifically* acquired in the last step of a transition.\n    potential_next_transitions = []\n\n    # --- Generate all potential next states from the current state ---\n\n    # 1. Explore Movement Actions (UP, DOWN, LEFT, RIGHT)\n    for action in move_actions:\n        _, next_state = state.step(action)\n        # For movement, the 'inventory_before_action' is simply the current state's inventory.\n        potential_next_transitions.append((next_state, path + [action], np.copy(state.inventory)))\n\n    # 2. Explore USE_ACT at current position\n    # This handles collecting items directly from the cell the agent is standing on (e.g., grabbable items).\n    inventory_before_use_at_pos = np.copy(state.inventory)\n    grid_before_use_at_pos = np.copy(state.grid) # Capture grid state before USE\n    _, state_after_use_at_pos = state.step(USE_ACT)\n    \n    # Only consider this transition if the USE_ACT actually resulted in a state change\n    # (e.g., inventory changed, or grid changed, or position/direction changed - though USE typically only changes inventory/grid).\n    state_changed_by_use_at_pos = not (\n        np.array_equal(state_after_use_at_pos.inventory, inventory_before_use_at_pos) and\n        state_after_use_at_pos.pos == state.pos and\n        state_after_use_at_pos.dir == state.dir and\n        np.array_equal(state_after_use_at_pos.grid, grid_before_use_at_pos) # Crucial to compare grid\n    )\n    if state_changed_by_use_at_pos:\n        potential_next_transitions.append((state_after_use_at_pos, path + [USE_ACT], inventory_before_use_at_pos))\n    \n    # 3. Explore USE_ACT on adjacent cells (after turning to face them)\n    # This handles interacting with items/structures in the surrounding environment (e.g., chopping trees, mining rocks).\n    for target_dir in range(4): # Iterate through all four possible facing directions\n        dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n        facing_r, facing_c = current_r + dr, current_c + dc\n\n        # Check if the facing cell is within grid bounds and contains *any* entity.\n        # This broad check allows interaction with any relevant environmental object\n        # that might yield the target primitive (e.g., 'ROCK' to get 'GOLD').\n        if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height) and np.any(state.grid[facing_r, facing_c, :] == 1):\n            turns_to_face = _get_turning_actions(current_dir, target_dir)\n            \n            # Simulate the turns to get the agent into the correct orientation before the USE_ACT.\n            temp_state_before_use_step = state\n            for turn_action in turns_to_face:\n                _, temp_state_before_use_step = temp_state_before_use_step.step(turn_action)\n            \n            # Capture inventory and grid states immediately before the final USE_ACT.\n            inventory_before_adj_use = np.copy(temp_state_before_use_step.inventory)\n            grid_before_adj_use = np.copy(temp_state_before_use_step.grid)\n            \n            # Perform the USE_ACT.\n            _, state_after_adj_use = temp_state_before_use_step.step(USE_ACT)\n            \n            # Only add this transition if the USE_ACT resulted in a change of state.\n            state_changed_by_adj_use = not (\n                np.array_equal(state_after_adj_use.inventory, inventory_before_adj_use) and\n                state_after_adj_use.pos == temp_state_before_use_step.pos and\n                state_after_adj_use.dir == temp_state_before_use_step.dir and\n                np.array_equal(state_after_adj_use.grid, grid_before_adj_use) # Crucial to compare grid\n            )\n            if state_changed_by_adj_use:\n                potential_next_transitions.append(\n                    (state_after_adj_use, path + turns_to_face + [USE_ACT], inventory_before_adj_use)\n                )\n\n    # --- Process all generated potential next transitions ---\n    for next_s, next_p, inv_before_action in potential_next_transitions:\n        # First, check if the target primitive was successfully collected in this transition.\n        if next_s.inventory[i_kind] > inv_before_action[i_kind]:\n            return next_p # Goal achieved! Return the path immediately.\n\n        # If not the goal, add the new state to the queue if it hasn't been visited yet.\n        next_inventory_tuple = tuple(next_s.inventory)\n        next_grid_hash = hash(next_s.grid.tobytes()) # Hash grid for the visited set key\n        next_state_key = (next_grid_hash, next_s.pos[0], next_s.pos[1], next_s.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((next_s, next_p))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 6, "scores": {"3": 2.5}}
{"timestamp": "2025-08-01T12:00:48.963983", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` with enhanced readability and robustness in walkability checks.\"\"\"\n  actions_list = []\n  current_state = env._current_state\n\n  grid = current_state.grid # numpy.ndarray of shape (num_rows, num_cols, n_kinds)\n  initial_pos = current_state.pos  # (row, col) tuple for the agent's current position\n  initial_dir = current_state.dir  # int representing agent's current facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  primitive_id = current_state.world.cookbook.index[primitive]\n  num_rows, num_cols, _ = grid.shape\n\n  # Retrieve action mapping from the environment's action specifications for explicit action IDs.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # In CraftLab, 'UP' means moving forward in current direction.\n  TURN_LEFT_ACTION = action_map['LEFT']     # Turn 90 degrees left.\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Turn 90 degrees right.\n  USE_ACTION = action_map['USE']            # Interact with the cell directly in front.\n\n  # Direction vectors (dr, dc) for agent's facing direction.\n  # These define how row and column coordinates change when moving \"forward\" relative to current direction.\n  # Mapping: 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col + 1)\n      1: (-1, 0),  # Facing UP: (row - 1, col)\n      2: (0, -1),  # Facing LEFT: (row, col - 1)\n      3: (1, 0)    # Facing DOWN: (row + 1, col)\n  }\n\n  # Mapping for updating agent's direction when turning left or right.\n  # Directions cycle: 0 -> 1 -> 2 -> 3 -> 0 for left turns (clockwise).\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  # Directions cycle: 0 -> 3 -> 2 -> 1 -> 0 for right turns (counter-clockwise).\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # Get indices of entities that block agent movement (e.g., BOUNDARY, WATER, WORKSHOP_X).\n  # These are entities the agent cannot walk onto.\n  # Convert the set to a numpy array for efficient indexing with `grid`.\n  non_walkable_kind_indices = np.array(list(current_state.world.non_grabbable_indices))\n\n  # Helper function to check if a given row and column are within the grid boundaries.\n  def _is_in_bounds(r: int, c: int) -> bool:\n      return 0 <= r < num_rows and 0 <= c < num_cols\n\n  # Helper function to determine if the agent can walk onto a specific cell (r, c).\n  # A cell is NOT walkable if:\n  # 1. It's out of grid boundaries.\n  # 2. It contains the primitive itself (agent must \"use\" from an adjacent cell, not walk on it).\n  # 3. It contains any non-grabbable entity (like a wall, water, workshop).\n  def _is_walkable_for_agent(r: int, c: int) -> bool:\n      if not _is_in_bounds(r, c):\n          return False\n      \n      # Agent cannot walk onto the primitive it wants to collect.\n      if grid[r, c, primitive_id] > 0:\n          return False\n\n      # Check if the cell contains any non-walkable (non-grabbable) entity.\n      # `np.any` is used for semantic clarity: is ANY of these kinds present in the cell?\n      # Ensure non_walkable_kind_indices is not empty before indexing to prevent errors.\n      if non_walkable_kind_indices.size > 0 and np.any(grid[r, c, non_walkable_kind_indices] > 0):\n          return False\n          \n      return True\n\n  # BFS Initialization:\n  # The queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_to_reach_here)\n  # A state includes both position and orientation because the 'USE' action depends on direction,\n  # and movement actions are relative to the current direction.\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # The visited set stores (position_tuple, direction_int) to prevent redundant computations,\n  # cycles, and ensure finding the shortest path (BFS guarantees this for unweighted graphs).\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_found = None # This will store the sequence of actions to reach the state where the primitive is in front.\n\n  # Start the Breadth-First Search\n  while queue:\n      (current_pos, current_dir), path_taken = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent from the current state.\n      # If it is, we've found our target \"adjacency\" state for collection.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the cell in front is within grid boundaries before checking its contents.\n      if _is_in_bounds(front_r, front_c) and grid[front_r, front_c, primitive_id] > 0:\n          target_path_found = path_taken\n          break # Target state found, stop BFS.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n      # These actions change the agent's state (position and/or direction).\n\n      # --- Try Move Forward action ---\n      move_dr, move_dc = DIR_TO_DRDC[current_dir] # Delta for moving forward\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if the potential next position is valid (walkable) and if this specific (position, direction)\n      # state has not been visited yet.\n      if _is_walkable_for_agent(next_r, next_c) and (next_pos, next_dir) not in visited:\n          visited.add((next_pos, next_dir)) # Mark new state as visited\n          # Add to queue with the updated path, including the MOVE_FORWARD_ACTION.\n          queue.append(((next_pos, next_dir), path_taken + [MOVE_FORWARD_ACTION]))\n\n      # --- Try Turn Left action ---\n      next_dir_left = TURN_LEFT_MAP[current_dir] # Calculate new direction after turning left\n      # Turning only changes direction, not position.\n      if (current_pos, next_dir_left) not in visited:\n          visited.add((current_pos, next_dir_left)) # Mark new state as visited\n          # Add to queue with updated path, including the TURN_LEFT_ACTION.\n          queue.append(((current_pos, next_dir_left), path_taken + [TURN_LEFT_ACTION]))\n\n      # --- Try Turn Right action ---\n      next_dir_right = TURN_RIGHT_MAP[current_dir] # Calculate new direction after turning right\n      # Turning only changes direction, not position.\n      if (current_pos, next_dir_right) not in visited:\n          visited.add((current_pos, next_dir_right)) # Mark new state as visited\n          # Add to queue with updated path, including the TURN_RIGHT_ACTION.\n          queue.append(((current_pos, next_dir_right), path_taken + [TURN_RIGHT_ACTION]))\n\n  # After BFS completes (either target found or queue empty):\n  # If a path to the target adjacency state was found, append the USE action to complete the collection.\n  if target_path_found is not None:\n      actions_list.extend(target_path_found)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T12:00:50.173643", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n\n  grid = current_state.grid\n  initial_pos = current_state.pos\n  initial_dir = current_state.dir\n\n  primitive_id = current_state.world.cookbook.index[primitive]\n  num_rows, num_cols, _ = grid.shape\n\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction vectors (dr, dc) for agent's facing direction.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # Mapping for updating agent's direction when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # Combine non-grabbable items and the primitive itself into a single set of impassable kinds.\n  # The agent cannot walk onto cells containing these items.\n  impassable_kind_indices = current_state.world.non_grabbable_indices.union({primitive_id})\n  # Convert to a list for efficient NumPy indexing.\n  impassable_kind_indices_list = list(impassable_kind_indices)\n\n  def is_in_bounds(r: int, c: int) -> bool:\n      \"\"\"Helper to check if a cell (r, c) is within the grid boundaries.\"\"\"\n      return 0 <= r < num_rows and 0 <= c < num_cols\n\n  def is_walkable_for_agent(r: int, c: int) -> bool:\n      \"\"\"Helper to determine if the agent can move onto a specific cell (r, c).\"\"\"\n      if not is_in_bounds(r, c):\n          return False\n      \n      # A cell is not walkable if it contains any of the impassable kinds.\n      # np.any checks if any element in the slice `grid[r, c, impassable_kind_indices_list]` is greater than 0.\n      if impassable_kind_indices_list and np.any(grid[r, c, impassable_kind_indices_list] > 0):\n          return False\n          \n      return True\n\n  # BFS Initialization:\n  # The queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_to_reach_here)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # The visited set stores (position_tuple, direction_int) to prevent cycles and ensure shortest path.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # Stores the path to the state where the primitive is directly in front.\n\n  while queue:\n      (current_pos, current_dir), path_taken = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent from the current state.\n      # If it is, we've found the target \"adjacency\" state.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      if is_in_bounds(front_r, front_c) and grid[front_r, front_c, primitive_id] > 0:\n          target_path = path_taken\n          break # Target found, exit BFS.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n\n      # Try Move Forward action:\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      if (is_walkable_for_agent(next_r, next_c) and\n          (next_pos, next_dir) not in visited):\n          \n          visited.add((next_pos, next_dir))\n          queue.append(((next_pos, next_dir), path_taken + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left action:\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      if ( (current_pos, next_dir_left) not in visited ):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_taken + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right action:\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      if ( (current_pos, next_dir_right) not in visited ):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_taken + [TURN_RIGHT_ACTION]))\n\n  # If a path to the target adjacency state was found, append the USE action.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T12:01:59.887648", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n  \n  This function finds the shortest sequence of actions to navigate the agent\n  to a position adjacent to the specified primitive and then uses it.\n  It uses a Breadth-First Search (BFS) algorithm to explore possible states\n  (agent position and direction) on the grid, guaranteeing the shortest path\n  in terms of action count.\n\n  Args:\n      env (env.CraftLab): The CraftLab environment object, providing access\n                          to the current game state and available actions.\n      primitive (str): The name of the primitive item to be collected (e.g., \"WOOD\", \"STONE\", \"WORKSHOP0\").\n\n  Returns:\n      List[int]: A sequence of integer action IDs that will lead the agent\n                 to collect the specified primitive. Returns an empty list\n                 if the primitive is not found or is unreachable.\n  \"\"\"\n  actions_to_take = []\n  \n  # Access the current state of the environment. This object contains all\n  # necessary information about the agent's location, inventory, and the grid.\n  current_state = env._current_state \n\n  # Extract static environment details and agent's initial conditions from the current state.\n  initial_grid = current_state.grid  # The full grid layout.\n  agent_start_pos = current_state.pos    # Agent's initial (row, col) position.\n  agent_start_dir = current_state.dir    # Agent's initial facing direction (0:Right, 1:Up, 2:Left, 3:Down).\n\n  # Get the integer ID for the target primitive from the cookbook index.\n  # This ID is crucial for identifying the primitive on the grid.\n  try:\n      primitive_kind_id = current_state.world.cookbook.index[primitive]\n  except KeyError:\n      # If the primitive name does not correspond to any known item ID in the world,\n      # it cannot be collected, so return an empty action list.\n      return []\n\n  # Determine grid dimensions (rows, columns) for boundary checks during pathfinding.\n  GRID_ROWS, GRID_COLS, _ = initial_grid.shape \n\n  # Map human-readable action names (from the DSL's perspective) to their integer\n  # representations, which are used by the environment's `step` method.\n  action_id_map = env.action_specs()\n  ACTION_MOVE_FORWARD = action_id_map['UP']      # Typically moves the agent one step in its current facing direction.\n  ACTION_TURN_LEFT = action_id_map['LEFT']        # Rotates the agent 90 degrees counter-clockwise.\n  ACTION_TURN_RIGHT = action_id_map['RIGHT']      # Rotates the agent 90 degrees clockwise.\n  ACTION_USE = action_id_map['USE']               # Interacts with the cell directly in front of the agent (e.g., collects, crafts).\n\n  # Define how agent's (row, col) position changes when moving forward based on its facing direction.\n  # This mapping represents (delta_row, delta_col) for each direction.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT (0): Moves +1 in column.\n      1: (-1, 0),  # Facing UP (1): Moves -1 in row.\n      2: (0, -1),  # Facing LEFT (2): Moves -1 in column.\n      3: (1, 0)    # Facing DOWN (3): Moves +1 in row.\n  }\n\n  # Define how agent's direction changes when performing a turn action.\n  # These operations cycle through the direction indices (0-3).\n  TURN_LEFT_DIR_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # e.g., Right(0) -> Up(1)\n  TURN_RIGHT_DIR_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # e.g., Right(0) -> Down(3)\n\n  # Retrieve indices of entity kinds that represent non-walkable terrain or obstacles.\n  # The agent cannot move into these cells.\n  non_walkable_kind_ids = current_state.world.non_grabbable_indices\n\n  # Nested helper function to determine if a given grid cell is valid for the agent to move into.\n  # This function captures the specific rules for traversability within this environment.\n  # It is nested to easily access variables from the outer `collect_v2` scope.\n  def _is_valid_and_walkable(row: int, col: int) -> bool:\n      \"\"\"Checks if the given grid cell (row, col) is within environment boundaries and\n      is not occupied by any entity that blocks agent movement, including the target\n      primitive itself (as the agent must stand *adjacent* to it).\n      \"\"\"\n      # 1. Check if the cell coordinates are within the defined grid boundaries.\n      if not (0 <= row < GRID_ROWS and 0 <= col < GRID_COLS):\n          return False\n\n      # 2. Check if the cell contains any entity that is explicitly marked as non-walkable.\n      for kind_idx in non_walkable_kind_ids:\n          if initial_grid[row, col, kind_idx] > 0:\n              return False\n      \n      # 3. An agent cannot walk directly *onto* the primitive it intends to collect.\n      # Collection implies interacting with an item from an adjacent cell.\n      if initial_grid[row, col, primitive_kind_id] > 0:\n          return False\n      \n      # If all checks pass, the cell is considered valid and walkable.\n      return True\n\n  # Initialize Breadth-First Search (BFS) for pathfinding.\n  # The `bfs_queue` stores tuples: ((agent_position, agent_direction), list_of_actions_taken_to_reach_this_state).\n  # The list of actions allows for path reconstruction once the target is found.\n  bfs_queue = collections.deque([((agent_start_pos, agent_start_dir), [])])\n  \n  # The `visited_states` set is used to keep track of (position, direction) states\n  # that have already been explored. This prevents infinite loops and ensures that\n  # the shortest path is found by avoiding redundant longer paths to the same state.\n  visited_states = {(agent_start_pos, agent_start_dir)}\n\n  # This variable will store the optimal sequence of actions leading to a state\n  # where the agent is positioned and oriented correctly to perform the 'USE' action.\n  path_to_primitive_use_position = None \n\n  # Begin the BFS traversal.\n  while bfs_queue:\n      (current_pos, current_dir), current_path_actions = bfs_queue.popleft()\n      current_row, current_col = current_pos\n\n      # Goal Check: Determine if the agent is currently in a state (position and direction)\n      # from which it can directly 'USE' (collect) the primitive. This means the primitive\n      # must be located in the grid cell immediately in front of the agent.\n      front_cell_dr, front_cell_dc = DIR_TO_DRDC[current_dir]\n      front_cell_row, front_cell_col = current_row + front_cell_dr, current_col + front_cell_dc\n      \n      # Verify if the calculated front cell is within grid boundaries AND contains the target primitive.\n      if (0 <= front_cell_row < GRID_ROWS and 0 <= front_cell_col < GRID_COLS and\n          initial_grid[front_cell_row, front_cell_col, primitive_kind_id] > 0):\n          # If both conditions are met, we've found the shortest path to a 'USE'-ready state.\n          path_to_primitive_use_position = current_path_actions\n          break # Exit the BFS loop immediately, as BFS guarantees the first found path is the shortest.\n\n      # Explore all possible next actions from the current state (move, turn left, turn right).\n\n      # Option 1: Attempt to Move Forward (ACTION_MOVE_FORWARD).\n      next_row_move, next_col_move = current_row + DIR_TO_DRDC[current_dir][0], current_col + DIR_TO_DRDC[current_dir][1]\n      next_pos_move = (next_row_move, next_col_move)\n      next_dir_move = current_dir # Moving forward does not change the agent's facing direction.\n\n      # Check if the potential next cell is valid and walkable, and if this (position, direction)\n      # state has not been visited yet.\n      if _is_valid_and_walkable(next_row_move, next_col_move):\n          if (next_pos_move, next_dir_move) not in visited_states:\n              visited_states.add((next_pos_move, next_dir_move))\n              bfs_queue.append(((next_pos_move, next_dir_move), current_path_actions + [ACTION_MOVE_FORWARD]))\n\n      # Option 2: Attempt to Turn Left (ACTION_TURN_LEFT).\n      next_dir_left = TURN_LEFT_DIR_MAP[current_dir]\n      # Turning does not change the agent's grid position.\n      if (current_pos, next_dir_left) not in visited_states:\n          visited_states.add((current_pos, next_dir_left))\n          bfs_queue.append(((current_pos, next_dir_left), current_path_actions + [ACTION_TURN_LEFT]))\n\n      # Option 3: Attempt to Turn Right (ACTION_TURN_RIGHT).\n      next_dir_right = TURN_RIGHT_DIR_MAP[current_dir]\n      # Turning does not change the agent's grid position.\n      if (current_pos, next_dir_right) not in visited_states:\n          visited_states.add((current_pos, next_dir_right))\n          bfs_queue.append(((current_pos, next_dir_right), current_path_actions + [ACTION_TURN_RIGHT]))\n\n  # After the BFS search completes:\n  # If a valid path was found to a position from which the primitive can be used,\n  # append the final `ACTION_USE` to the sequence of navigation actions.\n  if path_to_primitive_use_position is not None:\n      actions_to_take.extend(path_to_primitive_use_position)\n      actions_to_take.append(ACTION_USE)\n\n  # Return the generated sequence of actions. This list will be empty\n  # if no path was found or if the primitive was unreachable.\n  return actions_to_take", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T12:02:01.250875", "function_name": "collect", "function_body": "", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-08-01T12:03:52.494318", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n    This version includes a more adaptive search limit and minor clarity improvements.\n    \n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect.\n\n    Returns:\n        List[int]: A sequence of action indices to execute.\n  \"\"\"\n  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Semantic check: Determine if this primitive is *actually* collectible into inventory.\n  # This includes items defined as primitives, special environment items like water/stone,\n  # and any other items explicitly marked as grabbable.\n  is_primitive_resource = i_kind in world.cookbook.primitives\n  is_special_collectible_environment = (i_kind == world.water_index or i_kind == world.stone_index)\n  is_grabbable = i_kind in world.grabbable_indices\n\n  if not (is_primitive_resource or is_special_collectible_environment or is_grabbable):\n      # The requested primitive is not collectible.\n      return []\n\n  # 3. Check if the primitive is already in the agent's inventory.\n  if current_state.inventory[i_kind] > 0:\n      # Primitive is already collected, no actions needed.\n      return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  _DIRECTION_TO_DELTA_FRONT = { # Renamed for clarity\n      0: (-1, 0), # UP: row decreases, col stays same\n      1: (0, 1),  # RIGHT: row stays same, col increases\n      2: (1, 0),  # DOWN: row increases, col stays same\n      3: (0, -1)  # LEFT: row stays same, col decreases\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return []\n      # Calculate difference ensuring it's positive and within [0, 3]\n      diff = (target_dir - current_dir + 4) % 4\n      if diff == 1:\n          return [RIGHT_ACT] # One right turn\n      elif diff == 3:\n          return [LEFT_ACT]  # One left turn\n      else: # diff == 2 (180-degree turn)\n          return [RIGHT_ACT, RIGHT_ACT] # Two right turns (or two left turns)\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The visited set must capture the full state to prevent redundant exploration,\n  # especially if grid changes without immediate inventory/position changes.\n  # State key: (grid_hash, row, col, direction, inventory_tuple)\n  visited = set() \n\n  initial_inventory_tuple = tuple(current_state.inventory)\n  # Hash the grid to include its state in the visited key.\n  # .tobytes() converts the numpy array to a bytes object, which is hashable.\n  initial_grid_hash = hash(current_state.grid.tobytes()) \n\n  q.append((current_state, [])) # Queue stores (CraftState object, path_to_reach_this_state)\n  visited.add((initial_grid_hash, current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Adaptive search limit:\n  # The factor 4 is for directions. The factor 150 is a heuristic for path length.\n  # This makes the limit scale with map size.\n  MAX_EXPLORED_STATES_FACTOR = 150 \n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * MAX_EXPLORED_STATES_FACTOR \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft()\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent runaway search.\n    # This implicitly limits the search depth and prevents excessive computation on complex maps.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n\n    # List to store (next_state_object, actions_to_reach_next_state, inventory_before_last_action_applied)\n    # Storing 'inventory_before_last_action_applied' is crucial for checking if the goal item\n    # was *specifically* acquired in the last step of a transition.\n    potential_next_transitions = []\n\n    # --- Generate all potential next states from the current state ---\n\n    # 1. Explore Movement Actions (UP, DOWN, LEFT, RIGHT)\n    for action in move_actions:\n        _, next_state = state.step(action)\n        # For movement, the 'inventory_before_action' is simply the current state's inventory.\n        potential_next_transitions.append((next_state, path + [action], np.copy(state.inventory)))\n\n    # 2. Explore USE_ACT at current position\n    # This handles collecting items directly from the cell the agent is standing on (e.g., grabbable items).\n    inventory_before_use_at_pos = np.copy(state.inventory)\n    grid_before_use_at_pos = np.copy(state.grid) # Capture grid state before USE\n    _, state_after_use_at_pos = state.step(USE_ACT)\n    \n    # Only consider this transition if the USE_ACT actually resulted in a state change\n    # (e.g., inventory changed, or grid changed, or position/direction changed - though USE typically only changes inventory/grid).\n    state_changed_by_use_at_pos = not (\n        np.array_equal(state_after_use_at_pos.inventory, inventory_before_use_at_pos) and\n        state_after_use_at_pos.pos == state.pos and\n        state_after_use_at_pos.dir == state.dir and\n        np.array_equal(state_after_use_at_pos.grid, grid_before_use_at_pos) # Crucial to compare grid\n    )\n    if state_changed_by_use_at_pos:\n        potential_next_transitions.append((state_after_use_at_pos, path + [USE_ACT], inventory_before_use_at_pos))\n    \n    # 3. Explore USE_ACT on adjacent cells (after turning to face them)\n    # This handles interacting with items/structures in the surrounding environment (e.g., chopping trees, mining rocks).\n    for target_dir in range(4): # Iterate through all four possible facing directions\n        dr, dc = _DIRECTION_TO_DELTA_FRONT[target_dir] # Using renamed variable\n        facing_r, facing_c = current_r + dr, current_c + dc\n\n        # Check if the facing cell is within grid bounds and contains *any* entity.\n        # This broad check allows interaction with any relevant environmental object\n        # that might yield the target primitive (e.g., 'ROCK' to get 'GOLD').\n        if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height) and np.any(state.grid[facing_r, facing_c, :] == 1):\n            turns_to_face = _get_turning_actions(current_dir, target_dir)\n            \n            # Simulate the turns to get the agent into the correct orientation before the USE_ACT.\n            temp_state_before_use_step = state\n            for turn_action in turns_to_face:\n                _, temp_state_before_use_step = temp_state_before_use_step.step(turn_action)\n            \n            # Capture inventory and grid states immediately before the final USE_ACT.\n            inventory_before_adj_use = np.copy(temp_state_before_use_step.inventory)\n            grid_before_adj_use = np.copy(temp_state_before_use_step.grid)\n            \n            # Perform the USE_ACT.\n            _, state_after_adj_use = temp_state_before_use_step.step(USE_ACT)\n            \n            # Only add this transition if the USE_ACT resulted in a change of state.\n            state_changed_by_adj_use = not (\n                np.array_equal(state_after_adj_use.inventory, inventory_before_adj_use) and\n                state_after_adj_use.pos == temp_state_before_use_step.pos and\n                state_after_adj_use.dir == temp_state_before_use_step.dir and\n                np.array_equal(state_after_adj_use.grid, grid_before_adj_use) # Crucial to compare grid\n            )\n            if state_changed_by_adj_use:\n                potential_next_transitions.append(\n                    (state_after_adj_use, path + turns_to_face + [USE_ACT], inventory_before_adj_use)\n                )\n\n    # --- Process all generated potential next transitions ---\n    for next_s, next_p, inv_before_action in potential_next_transitions:\n        # First, check if the target primitive was successfully collected in this transition.\n        if next_s.inventory[i_kind] > inv_before_action[i_kind]:\n            return next_p # Goal achieved! Return the path immediately.\n\n        # If not the goal, add the new state to the queue if it hasn't been visited yet.\n        next_inventory_tuple = tuple(next_s.inventory)\n        next_grid_hash = hash(next_s.grid.tobytes()) # Hash grid for the visited set key\n        next_state_key = (next_grid_hash, next_s.pos[0], next_s.pos[1], next_s.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((next_s, next_p))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 6, "scores": {"3": 2.5}}
{"timestamp": "2025-08-01T12:03:55.574738", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n  Adds a maximum path length heuristic to prune excessively long searches,\n  improving practical performance by limiting search depth for single collection tasks.\n  \"\"\"\n  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Semantic check: Determine if this primitive is *actually* collectible into inventory.\n  # This includes items defined as primitives, special environment items like water/stone,\n  # and any other items explicitly marked as grabbable.\n  is_primitive_resource = i_kind in world.cookbook.primitives\n  is_special_collectible_environment = (i_kind == world.water_index or i_kind == world.stone_index)\n  is_grabbable = i_kind in world.grabbable_indices\n\n  if not (is_primitive_resource or is_special_collectible_environment or is_grabbable):\n      # The requested primitive is not collectible.\n      return []\n\n  # 3. Check if the primitive is already in the agent's inventory.\n  if current_state.inventory[i_kind] > 0:\n      # Primitive is already collected, no actions needed.\n      return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row decreases, col stays same\n      1: (0, 1),  # RIGHT: row stays same, col increases\n      2: (1, 0),  # DOWN: row increases, col stays same\n      3: (0, -1)  # LEFT: row stays same, col decreases\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return []\n      # Calculate difference ensuring it's positive and within [0, 3]\n      diff = (target_dir - current_dir + 4) % 4\n      if diff == 1:\n          return [RIGHT_ACT] # One right turn\n      elif diff == 3:\n          return [LEFT_ACT]  # One left turn\n      else: # diff == 2 (180-degree turn)\n          return [RIGHT_ACT, RIGHT_ACT] # Two right turns (or two left turns)\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The visited set must capture the full state to prevent redundant exploration,\n  # especially if grid changes without immediate inventory/position changes.\n  # State key: (grid_hash, row, col, direction, inventory_tuple)\n  visited = set() \n\n  initial_inventory_tuple = tuple(current_state.inventory)\n  # Hash the grid to include its state in the visited key.\n  # .tobytes() converts the numpy array to a bytes object, which is hashable.\n  initial_grid_hash = hash(current_state.grid.tobytes()) \n\n  q.append((current_state, [])) # Queue stores (CraftState object, path_to_reach_this_state)\n  visited.add((initial_grid_hash, current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Set a heuristic upper bound for explored states to prevent excessively long searches\n  # on very large or complex maps.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 150 \n  # New heuristic: maximum path length to consider for a single 'collect' action.\n  # This helps to prune very long sequences of actions for a sub-task.\n  MAX_PATH_LENGTH = 100 \n\n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft()\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states or the path length exceeds a heuristic limit,\n    # skip further exploration from this state to prevent runaway searches.\n    if explored_states_count > MAX_EXPLORED_STATES or len(path) >= MAX_PATH_LENGTH:\n      continue\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n\n    # List to store (next_state_object, actions_to_reach_next_state, inventory_before_last_action_applied)\n    # Storing 'inventory_before_last_action_applied' is crucial for checking if the goal item\n    # was *specifically* acquired in the last step of a transition.\n    potential_next_transitions = []\n\n    # --- Generate all potential next states from the current state ---\n\n    # 1. Explore Movement Actions (UP, DOWN, LEFT, RIGHT)\n    for action in move_actions:\n        _, next_state = state.step(action)\n        # For movement, the 'inventory_before_action' is simply the current state's inventory.\n        potential_next_transitions.append((next_state, path + [action], np.copy(state.inventory)))\n\n    # 2. Explore USE_ACT at current position\n    # This handles collecting items directly from the cell the agent is standing on (e.g., grabbable items).\n    inventory_before_use_at_pos = np.copy(state.inventory)\n    grid_before_use_at_pos = np.copy(state.grid) # Capture grid state before USE\n    _, state_after_use_at_pos = state.step(USE_ACT)\n    \n    # Only consider this transition if the USE_ACT actually resulted in a state change\n    # (e.g., inventory changed, or grid changed, or position/direction changed - though USE typically only changes inventory/grid).\n    state_changed_by_use_at_pos = not (\n        np.array_equal(state_after_use_at_pos.inventory, inventory_before_use_at_pos) and\n        state_after_use_at_pos.pos == state.pos and\n        state_after_use_at_pos.dir == state.dir and\n        np.array_equal(state_after_use_at_pos.grid, grid_before_use_at_pos) # Crucial to compare grid\n    )\n    if state_changed_by_use_at_pos:\n        potential_next_transitions.append((state_after_use_at_pos, path + [USE_ACT], inventory_before_use_at_pos))\n    \n    # 3. Explore USE_ACT on adjacent cells (after turning to face them)\n    # This handles interacting with items/structures in the surrounding environment (e.g., chopping trees, mining rocks).\n    for target_dir in range(4): # Iterate through all four possible facing directions\n        dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n        facing_r, facing_c = current_r + dr, current_c + dc\n\n        # Check if the facing cell is within grid bounds and contains *any* entity.\n        # This broad check allows interaction with any relevant environmental object\n        # that might yield the target primitive (e.g., 'ROCK' to get 'GOLD').\n        if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height) and np.any(state.grid[facing_r, facing_c, :] == 1):\n            turns_to_face = _get_turning_actions(current_dir, target_dir)\n            \n            # Simulate the turns to get the agent into the correct orientation before the USE_ACT.\n            temp_state_before_use_step = state\n            for turn_action in turns_to_face:\n                _, temp_state_before_use_step = temp_state_before_use_step.step(turn_action)\n            \n            # Capture inventory and grid states immediately before the final USE_ACT.\n            inventory_before_adj_use = np.copy(temp_state_before_use_step.inventory)\n            grid_before_adj_use = np.copy(temp_state_before_use_step.grid)\n            \n            # Perform the USE_ACT.\n            _, state_after_adj_use = temp_state_before_use_step.step(USE_ACT)\n            \n            # Only add this transition if the USE_ACT resulted in a change of state.\n            state_changed_by_adj_use = not (\n                np.array_equal(state_after_adj_use.inventory, inventory_before_adj_use) and\n                state_after_adj_use.pos == temp_state_before_use_step.pos and\n                state_after_adj_use.dir == temp_state_before_use_step.dir and\n                np.array_equal(state_after_adj_use.grid, grid_before_adj_use) # Crucial to compare grid\n            )\n            if state_changed_by_adj_use:\n                potential_next_transitions.append(\n                    (state_after_adj_use, path + turns_to_face + [USE_ACT], inventory_before_adj_use)\n                )\n\n    # --- Process all generated potential next transitions ---\n    for next_s, next_p, inv_before_action in potential_next_transitions:\n        # First, check if the target primitive was successfully collected in this transition.\n        if next_s.inventory[i_kind] > inv_before_action[i_kind]:\n            return next_p # Goal achieved! Return the path immediately.\n\n        # If not the goal, add the new state to the queue if it hasn't been visited yet.\n        next_inventory_tuple = tuple(next_s.inventory)\n        next_grid_hash = hash(next_s.grid.tobytes()) # Hash grid for the visited set key\n        next_state_key = (next_grid_hash, next_s.pos[0], next_s.pos[1], next_s.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((next_s, next_p))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 6, "scores": {"3": 2.5}}
{"timestamp": "2025-08-01T12:04:34.923109", "function_name": "collect", "function_body": "", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-08-01T12:04:36.455315", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  # This list ensures we only attempt to collect items that are actually collectable via the USE action.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  # This prunes the search space for uncollectible primitives early.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set now includes the agent's inventory as part of the state key.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing, allowing BFS to distinguish\n  # between states that are identical in position/direction but differ in inventory (e.g., having a tool vs. not).\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Increased MAX_EXPLORED_STATES due to the larger state space when tracking inventory.\n  # This is a heuristic and may need tuning for specific environment complexities.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`).\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    # Apply each turn action to simulate the new state after turning.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the USE action from the current position, even if not directly on the target primitive.\n    # This is important if using an item at the current position (e.g., picking up a tool)\n    # can change the inventory state, which might be necessary for later steps to collect the primitive.\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if the USE action resulted in a meaningful state change (inventory, position, or direction).\n    # This prevents adding redundant states to the queue if USE had no effect.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T12:05:50.958968", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n\n  This version enhances clarity and self-documentation while maintaining the\n  robust Breadth-First Search (BFS) pathfinding approach. It aims to find the\n  shortest sequence of actions to navigate the agent to a position immediately\n  adjacent to the target `primitive` and facing it, then execute the 'USE' action.\n\n  Args:\n      env (env.CraftLab): The CraftLab object representing the current simulation\n                          environment and state.\n      primitive (str): The string name of the primitive resource (e.g., \"WOOD\",\n                       \"STONE\", \"IRON\") that the agent needs to find and collect.\n\n  Returns:\n      List[int]: A sequence of integer action codes (e.g., MOVE_FORWARD, TURN_LEFT,\n                 USE) that, when executed sequentially, will lead to the collection\n                 of the primitive. Returns an empty list if the primitive is already\n                 in the agent's inventory or if it is deemed unreachable within the\n                 current grid configuration.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos  # Agent's starting (row, column) tuple\n  initial_dir = current_state.dir  # Agent's starting facing direction (0:Right, 1:Up, 2:Left, 3:Down)\n\n  # Retrieve the integer ID for the target primitive from the world's cookbook index.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  num_rows, num_cols, _ = initial_grid.shape # Extract grid dimensions (WIDTH, HEIGHT)\n\n  # Optimization: If the primitive is already in the agent's inventory, no actions are needed.\n  if current_state.inventory[primitive_id] > 0:\n      return []\n\n  # Map symbolic action names to their corresponding integer indices.\n  # These are constant for a given CraftLab environment.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']   # 'UP' typically means move forward in current direction\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define how position changes for each of the four cardinal directions.\n  # Direction 0:Right, 1:Up, 2:Left, 3:Down maps to (delta_row, delta_column).\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: column increases\n      1: (-1, 0),  # Facing UP: row decreases\n      2: (0, -1),  # Facing LEFT: column decreases\n      3: (1, 0)    # Facing DOWN: row increases\n  }\n\n  # Define how the agent's direction changes when turning left or right (cyclical).\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # e.g., Right (0) -> Up (1)\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # e.g., Right (0) -> Down (3)\n\n  # Identify all entity kinds that block agent movement.\n  # This includes entities that are inherently non-grabbable (e.g., boundaries, water, workshops)\n  # AND the specific primitive being collected (agent must stand *next to* it, not *on* it).\n  blocking_kind_ids_set = set(current_state.world.non_grabbable_indices)\n  blocking_kind_ids_set.add(primitive_id)\n  # Convert the set of blocking IDs to a NumPy array for efficient checks against the grid.\n  blocking_kind_indices = np.array(list(blocking_kind_ids_set), dtype=int)\n\n  # Initialize Breadth-First Search (BFS) structures.\n  # Queue stores tuples: ((current_pos_tuple, current_dir_int), list_of_actions_to_reach_here).\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (pos_tuple, dir_int) to prevent redundant exploration and cycles.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # This will store the action sequence leading to the desired state.\n\n  # Begin BFS traversal\n  while queue:\n      (current_pos, current_dir), path_to_current_state = queue.popleft()\n      r, c = current_pos # Deconstruct current position for easier access\n\n      # 1. Check if the current state satisfies the goal condition:\n      # Is the primitive located directly in front of the agent?\n      # Calculate the coordinates of the cell directly in front of the agent.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # First, ensure the cell in front is within the grid boundaries.\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n          # Then, check if this front cell contains the target primitive.\n          # A value > 0 in the grid at the primitive_id layer indicates presence.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path_actions = path_to_current_state\n              break # Goal state found; shortest path is guaranteed by BFS.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n      \n      # --- Attempt to Move Forward ---\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change agent's facing direction.\n\n      # Check for validity of the 'Move Forward' action:\n      # a) Is the next position within grid boundaries?\n      if not (0 <= next_r < num_rows and 0 <= next_c < num_cols):\n          # Cannot move out of bounds.\n          pass \n      # b) Has this (position, direction) state already been visited?\n      elif (next_pos, next_dir) in visited:\n          # A shorter or equal path to this state has already been found.\n          pass\n      # c) Is the next position blocked by any impassable entity?\n      # Using np.any on the slice `initial_grid[next_r, next_c, blocking_kind_indices]`\n      # efficiently checks if any blocking kind is present at `(next_r, next_c)`.\n      elif np.any(initial_grid[next_r, next_c, blocking_kind_indices] > 0):\n          # Agent cannot walk onto a blocked cell.\n          pass\n      else:\n          # If all checks pass, this is a valid and unvisited state to explore.\n          visited.add((next_pos, next_dir))\n          queue.append(((next_pos, next_dir), path_to_current_state + [MOVE_FORWARD_ACTION]))\n\n      # --- Attempt to Turn Left ---\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning actions do not change the agent's position.\n      if (current_pos, next_dir_left) not in visited:\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_to_current_state + [TURN_LEFT_ACTION]))\n\n      # --- Attempt to Turn Right ---\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning actions do not change the agent's position.\n      if (current_pos, next_dir_right) not in visited:\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_to_current_state + [TURN_RIGHT_ACTION]))\n\n  # After BFS completes, if a path to the target state was found,\n  # append the 'USE' action to the sequence of movement/turn actions.\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 1, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T12:05:52.178891", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n\n  # Extract initial state information from the current environment state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's current (row, column) tuple\n  initial_dir = current_state.dir # Agent's current facing direction (0:Right, 1:Up, 2:Left, 3:Down)\n\n  # Get the integer ID for the target primitive from the world's cookbook index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Determine grid dimensions (rows, columns) for boundary checks\n  grid_rows, grid_cols, _ = initial_grid.shape\n\n  # Optimization: If the primitive is already in the agent's inventory,\n  # no actions are needed to collect it.\n  if current_state.inventory[primitive_id] > 0:\n      return []\n\n  # Map symbolic action names (from the DSL) to their integer indices\n  # as defined by the CraftLab environment's action_specs.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # 'UP' in the DSL means move forward\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define direction vectors (delta_row, delta_col) for agent movement.\n  # This maps the integer direction (0-3) to changes in coordinates.\n  # 0:Right (East), 1:Up (North), 2:Left (West), 3:Down (South)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing Right: column increases\n      1: (-1, 0),  # Facing Up: row decreases\n      2: (0, -1),  # Facing Left: column decreases\n      3: (1, 0)    # Facing Down: row increases\n  }\n\n  # Define how the agent's direction changes when turning left or right.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0} # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Identify all entity kinds that block agent movement.\n  # This set includes non-grabbable environment elements (e.g., BOUNDARY, WATER, WORKSHOPS)\n  # and importantly, the primitive itself. The agent must stand *adjacent* to a primitive\n  # (not on top of it) to use the 'USE' action for collection.\n  blocking_kind_ids_set = set(current_state.world.non_grabbable_indices)\n  blocking_kind_ids_set.add(primitive_id)\n  \n  # Convert the set of blocking kind IDs to a NumPy array for efficient indexing\n  # when checking grid cells for obstacles.\n  blocking_kind_indices = np.array(list(blocking_kind_ids_set), dtype=int)\n\n  # Initialize Breadth-First Search (BFS) for pathfinding.\n  # The queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_here).\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # The 'visited' set keeps track of (position, direction) states already explored\n  # to prevent cycles and ensure the shortest path is found.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the action sequence once the goal state is reached.\n\n  while queue:\n      (current_pos, current_dir), path_to_current_state = queue.popleft()\n      r, c = current_pos\n\n      # 1. Goal Check: Determine if the target primitive is located in the cell\n      # directly in front of the agent. This is the condition for being able\n      # to successfully 'USE' and collect the primitive.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the cell directly in front is within the grid boundaries.\n      if (0 <= front_r < grid_rows and 0 <= front_c < grid_cols):\n          # Check if the specified primitive exists in that front cell.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_to_current_state\n              break # Shortest path to be adjacent and facing the primitive found.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n      \n      # --- Try Move Forward ---\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change the agent's facing direction.\n\n      # Check if the next position is within the grid boundaries.\n      if (0 <= next_r < grid_rows and 0 <= next_c < grid_cols):\n          # Check if this (position, direction) state has already been visited to avoid redundant paths.\n          if (next_pos, next_dir) not in visited:\n              # Check if the next position is blocked by any impassable entity.\n              # np.any returns True if any of the blocking_kind_indices layers at (next_r, next_c)\n              # have a value greater than 0, indicating an obstacle.\n              if not np.any(initial_grid[next_r, next_c, blocking_kind_indices] > 0):\n                  visited.add((next_pos, next_dir))\n                  queue.append(((next_pos, next_dir), path_to_current_state + [MOVE_FORWARD_ACTION]))\n\n      # --- Try Turn Left ---\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning actions do not change the agent's position, only its direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_to_current_state + [TURN_LEFT_ACTION]))\n\n      # --- Try Turn Right ---\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning actions do not change the agent's position, only its direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_to_current_state + [TURN_RIGHT_ACTION]))\n\n  # If a valid path to be adjacent and facing the primitive was found,\n  # append the 'USE' action to the sequence of movement actions.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 1, "scores": {"3": 0.5}}
