{"timestamp": "2025-08-01T12:32:02.996609", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  \n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  # Pre-check: Determine if the target primitive is actually collectible (grabbable).\n  # Items like BOUNDARY, WATER, STONE, and WORKSHOPS are fixed environmental features\n  # and cannot be picked up using the 'USE' action. If the primitive is not grabbable,\n  # no collection actions can be performed, so an empty list is returned immediately.\n  if primitive_id not in current_state.world.grabbable_indices:\n      return []\n\n  # Extract key information from the current state for pathfinding\n  initial_grid = current_state.grid\n  initial_agent_pos = current_state.pos # Agent's starting (row, col) position\n  initial_agent_dir = current_state.dir # Agent's starting direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get dimensions of the grid. NumPy array shape is (rows, columns, depth).\n  # Rows correspond to height, columns to width.\n  GRID_HEIGHT, GRID_WIDTH, _ = initial_grid.shape\n\n  # Map DSL actions to their corresponding integer indices as defined by the environment\n  action_specs = env.action_specs()\n  MOVE_FORWARD_ACTION = action_specs['UP']    # Corresponds to moving \"UP\" (forward in current direction)\n  TURN_LEFT_ACTION = action_specs['LEFT']\n  TURN_RIGHT_ACTION = action_specs['RIGHT']\n  USE_ACTION = action_specs['USE']\n\n  # Define changes in (row, col) for movement based on current facing direction\n  # (dr, dc) = (delta_row, delta_column)\n  DIR_TO_DELTA_POS = {\n      0: (0, 1),   # RIGHT: +1 column (East)\n      1: (-1, 0),  # UP: -1 row (North)\n      2: (0, -1),  # LEFT: -1 column (West)\n      3: (1, 0)    # DOWN: +1 row (South)\n  }\n\n  # Define how agent's direction changes when turning left or right\n  TURN_LEFT_NEW_DIR = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_NEW_DIR = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Identify all grid entity indices that block agent movement.\n  # This set includes non-grabbable items (e.g., boundaries, water, workshops)\n  # and crucially, the target `primitive_id` itself. The agent cannot move onto\n  # a square containing the item it intends to 'USE'; it must be adjacent.\n  blocking_kind_indices = current_state.world.non_grabbable_indices.copy()\n  blocking_kind_indices.add(primitive_id)\n\n\n  # Breadth-First Search (BFS) for the shortest path to a collectible state.\n  # BFS queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_here)\n  bfs_queue = collections.deque([((initial_agent_pos, initial_agent_dir), [])])\n  \n  # Visited set stores (position_tuple, direction_int) to prevent redundant exploration and cycles.\n  visited_states = {(initial_agent_pos, initial_agent_dir)}\n\n  # Variable to store the action sequence once the target state (adjacent and facing primitive) is found.\n  path_to_collection_point = None \n\n  while bfs_queue:\n      (current_pos, current_dir), current_path_actions = bfs_queue.popleft()\n      current_r, current_c = current_pos\n\n      # Check if the agent is currently positioned to 'USE' the primitive:\n      # This means the primitive must be in the cell directly in front of the agent.\n      front_dr, front_dc = DIR_TO_DELTA_POS[current_dir]\n      front_r, front_c = current_r + front_dr, current_c + front_dc\n      \n      # Ensure the cell in front is within grid boundaries\n      if (0 <= front_r < GRID_HEIGHT and 0 <= front_c < GRID_WIDTH):\n          # Check if the primitive is present in the cell directly in front (indicated by a count > 0)\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              path_to_collection_point = current_path_actions\n              break # Shortest path to a 'collectible' position found, terminate BFS.\n\n      # Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right\n      \n      # 1. Try moving forward\n      move_dr, move_dc = DIR_TO_DELTA_POS[current_dir]\n      next_r, next_c = current_r + move_dr, current_c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir_after_move = current_dir # Moving forward does not change facing direction\n\n      # Check validity of the next state: within bounds, not visited, and not blocked by any obstacles\n      if (0 <= next_r < GRID_HEIGHT and 0 <= next_c < GRID_WIDTH and\n          (next_pos, next_dir_after_move) not in visited_states):\n          \n          # Check if the next position is walkable (i.e., it does not contain any blocking entities).\n          # A cell is walkable if it doesn't contain any entity from the blocking_kind_indices set.\n          is_walkable = True\n          for kind_idx in blocking_kind_indices:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          \n          if is_walkable:\n              visited_states.add((next_pos, next_dir_after_move))\n              bfs_queue.append(((next_pos, next_dir_after_move), current_path_actions + [MOVE_FORWARD_ACTION]))\n\n      # 2. Try turning left\n      next_dir_left = TURN_LEFT_NEW_DIR[current_dir]\n      # Turning changes direction but not position.\n      if ((current_pos, next_dir_left) not in visited_states):\n          visited_states.add((current_pos, next_dir_left))\n          bfs_queue.append(((current_pos, next_dir_left), current_path_actions + [TURN_LEFT_ACTION]))\n\n      # 3. Try turning right\n      next_dir_right = TURN_RIGHT_NEW_DIR[current_dir]\n      # Turning changes direction but not position.\n      if ((current_pos, next_dir_right) not in visited_states):\n          visited_states.add((current_pos, next_dir_right))\n          bfs_queue.append(((current_pos, next_dir_right), current_path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path was successfully found to a position where the agent can 'USE' the primitive,\n  # append the 'USE' action to the sequence to complete the collection process.\n  if path_to_collection_point is not None:\n      actions_list.extend(path_to_collection_point)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 2, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T12:33:05.543459", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's current (row, column) tuple\n  initial_dir = current_state.dir # Agent's current facing direction (0:Right, 1:Up, 2:Left, 3:Down)\n\n  # Get the integer ID for the target primitive from the cookbook index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  num_rows, num_cols, _ = initial_grid.shape # Extract grid dimensions\n\n  # Map symbolic actions from action_specs to their integer indices\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define changes in (row, col) for each direction (0:Right, 1:Up, 2:Left, 3:Down)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: +1 to column (col)\n      1: (-1, 0),  # Facing UP: -1 to row (row)\n      2: (0, -1),  # Facing LEFT: -1 to column (col)\n      3: (1, 0)    # Facing DOWN: +1 to row (row)\n  }\n\n  # Define how direction changes when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Determine all item kinds that block agent movement.\n  # This includes all non-grabbable entities from the world definition.\n  # Additionally, the primitive itself is considered non-walkable because the agent needs to\n  # stand *adjacent* to it, not *on* it, to use/collect it.\n  blocking_kind_ids_set = set(current_state.world.non_grabbable_indices)\n  blocking_kind_ids_set.add(primitive_id) \n  # Convert the set to a numpy array for efficient indexing in grid checks.\n  blocking_kind_indices_np = np.array(list(blocking_kind_ids_set), dtype=int)\n\n\n  # BFS state: ((row, col), direction)\n  # Queue stores ( (current_pos_tuple, current_dir_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (current_pos_tuple, current_dir_int) to avoid re-exploring states\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # To store the action sequence once the target state is found\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # Check if the primitive is directly in the cell in front of the agent.\n      # This is the goal condition for the BFS: agent is positioned correctly to 'USE' the primitive.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the cell in front is within grid bounds\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n          # Check if the specific primitive we are looking for is in that cell\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Path to the target found, exit BFS\n\n      # Explore possible next actions: Move Forward, Turn Left, Turn Right\n      \n      # 1. Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if the next position is within bounds\n      if (0 <= next_r < num_rows and 0 <= next_c < num_cols):\n          # Check if this (position, direction) state hasn't been visited before\n          if (next_pos, next_dir) not in visited:\n              # Check if the next_pos is walkable (does not contain any blocking kind).\n              # np.any will be True if *any* of the blocking_kind_indices have a value > 0 at next_r, next_c.\n              # We negate this to check if it's *not* blocked.\n              if not np.any(initial_grid[next_r, next_c, blocking_kind_indices_np] > 0):\n                  # This is a valid and unvisited move. Add to queue and visited set.\n                  visited.add((next_pos, next_dir))\n                  queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # 2. Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # 3. Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path was found (target_path is not None), append the USE action to perform collection.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 1, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T12:33:06.708797", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` using numpy array operations for walkability checks.\"\"\"\n  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's current (row, column) tuple\n  initial_dir = current_state.dir # Agent's current facing direction (0:Right, 1:Up, 2:Left, 3:Down)\n\n  # Get the integer ID for the target primitive from the cookbook index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  num_rows, num_cols, _ = initial_grid.shape # Extract grid dimensions\n\n  # Map symbolic actions from action_specs to their integer indices\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP'] # Assumed: 'UP' action moves agent forward\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define changes in (row, col) for each direction (0:Right, 1:Up, 2:Left, 3:Down)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: +1 to column (col)\n      1: (-1, 0),  # Facing UP: -1 to row (row)\n      2: (0, -1),  # Facing LEFT: -1 to column (col)\n      3: (1, 0)    # Facing DOWN: +1 to row (row)\n  }\n\n  # Define how direction changes when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Get indices of entities that block agent movement (non-grabbable/non-walkable terrain/objects)\n  non_grabbable_indices = current_state.world.non_grabbable_indices\n  # Combine non-grabbable indices and the primitive_id into a single numpy array for efficient lookup.\n  # The primitive itself is typically not walkable, as the agent needs to be adjacent to collect it.\n  blocking_kind_indices_for_movement = np.array(list(non_grabbable_indices) + [primitive_id], dtype=int)\n\n\n  # BFS state representation: ((current_row, current_col), current_direction_int)\n  # Queue stores (state, list_of_actions_to_reach_this_state)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (state) to avoid redundant computations and cycles\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the action sequence leading to the state\n                      # where the agent is adjacent to the primitive and facing it.\n\n  while queue:\n      (current_pos, current_dir), path_to_current_state = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent at current state\n      # Calculate the coordinates of the cell directly in front of the agent\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the cell in front is within grid bounds AND contains the primitive\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols and\n          initial_grid[front_r, front_c, primitive_id] > 0):\n          \n          target_path = path_to_current_state\n          break # Found the path to be adjacent and facing the primitive\n\n      # 2. Explore possible next actions from the current state (Move Forward, Turn Left, Turn Right)\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if the next position is valid and has not been visited with this direction\n      if (next_pos, next_dir) not in visited:\n          # Check if next_pos is within bounds\n          if (0 <= next_r < num_rows and 0 <= next_c < num_cols):\n              # Check if the next_pos contains any blocking kind using numpy's any()\n              # This is generally more efficient than iterating a Python set for each kind,\n              # especially if 'blocking_kind_indices_for_movement' can be large.\n              if not np.any(initial_grid[next_r, next_c, blocking_kind_indices_for_movement] > 0):\n                  visited.add((next_pos, next_dir))\n                  queue.append(((next_pos, next_dir), path_to_current_state + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_to_current_state + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_to_current_state + [TURN_RIGHT_ACTION]))\n\n  # If a path was found to reach an adjacent and facing position, append the USE action\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 1, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T12:34:45.364207", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` with a more comprehensive immediate goal check.\n    \n    This version refines the goal checking logic to more directly identify\n    and return paths for collecting the primitive when it becomes available\n    either by being at the agent's current location (and grabbable) or\n    by being in a directly faceable adjacent cell. It consolidates the\n    'USE' action exploration for collection into a single, more immediate\n    check at each BFS step.\n\n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect.\n\n    Returns:\n        List[int]: A sequence of action indices to execute.\n  \"\"\"\n  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set includes the agent's inventory as part of the state key\n  # to distinguish between states identical in position/direction but differing in inventory.\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Increased MAX_EXPLORED_STATES due to the larger state space when tracking inventory.\n  # Use min(n_kinds, 10) as a heuristic multiplier for inventory states to cap complexity\n  # while still allowing some inventory variation.\n  MAX_EXPLORED_INVENTORY_STATES_MULTIPLIER = min(world.cookbook.n_kinds, 10) \n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * MAX_EXPLORED_INVENTORY_STATES_MULTIPLIER \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent excessive computation.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # IMPROVEMENT: Consolidated and Immediate Goal Check for Collection\n    # Attempt 1: Try USE action at the agent's current position.\n    # This covers grabbable items located on the same cell as the agent,\n    # and any other general 'USE' interaction that directly yields the primitive\n    # without requiring specific facing.\n    inventory_before_general_use = np.copy(state.inventory)\n    _, state_after_general_use = state.step(USE_ACT)\n    if state_after_general_use.inventory[i_kind] > inventory_before_general_use[i_kind]:\n        return path + [USE_ACT] # Found a path immediately by using at current location\n\n    # Attempt 2: Check if primitive is in one of the four cardinal directions and can be collected by facing.\n    # This covers resources like water, stone, or grabbable items on adjacent cells that require facing.\n    for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n        dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n        facing_r, facing_c = current_r + dr, current_c + dc\n\n        # Check if the cell in front is within grid bounds and contains the primitive.\n        if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n            state.grid[facing_r, facing_c, i_kind] == 1):\n            \n            # Simulate the turning actions to face the primitive.\n            turns_to_face = _get_turning_actions(current_dir, target_dir)\n            temp_state_after_turns = state \n            for turn_action in turns_to_face:\n                # Apply each turn action to simulate the new state after turning.\n                _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n            # Store inventory before attempting USE to verify collection.\n            inventory_before_facing_use = np.copy(temp_state_after_turns.inventory)\n\n            # Simulate the 'USE' action.\n            _, state_after_facing_use = temp_state_after_turns.step(USE_ACT)\n\n            # Critical check: Did the count of the primitive in inventory actually increase?\n            if state_after_facing_use.inventory[i_kind] > inventory_before_facing_use[i_kind]:\n                return path + turns_to_face + [USE_ACT]\n    \n    # If not collected immediately, explore possible next states through movement\n    # and also re-add the 'USE' action state (from Attempt 1) if it resulted in a different state\n    # (e.g., picking up a tool) that might enable future collection.\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the general 'USE' action from the current position. This is important\n    # if using an item at the current position (e.g., picking up a tool like an axe)\n    # can change the inventory state, which might be necessary for later steps to\n    # collect the target primitive (e.g., wood).\n    # We reuse `state_after_general_use` computed earlier.\n    next_inventory_tuple = tuple(state_after_general_use.inventory)\n    next_state_key = (state_after_general_use.pos[0], state_after_general_use.pos[1], state_after_general_use.dir, next_inventory_tuple)\n\n    # Only add this state if it's truly new and didn't result in immediate goal collection\n    # (which was checked in Attempt 1).\n    if not (np.array_equal(state_after_general_use.inventory, inventory_before_general_use) and\n            state_after_general_use.pos == state.pos and\n            state_after_general_use.dir == state.dir):\n        # This state is different, so add it for future exploration.\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_general_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T12:34:46.520498", "function_name": "collect", "function_body": "", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-08-01T12:35:37.866730", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set now includes the agent's inventory as part of the state key.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing, allowing BFS to distinguish\n  # between states that are identical in position/direction but differ in inventory (e.g., having a tool vs. not).\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Increased MAX_EXPLORED_STATES due to the larger state space when tracking inventory.\n  # This is a heuristic and may need tuning for specific environment complexities.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`).\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the USE action from the current position, even if not directly on the target primitive.\n    # This is important if using an item at the current position (e.g., picking up a tool)\n    # can change the inventory state, which might be necessary for later steps to collect the primitive.\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if the USE action resulted in a meaningful state change (inventory, position, or direction).\n    # This prevents adding redundant states to the queue if USE had no effect.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T12:35:39.153618", "function_name": "collect", "function_body": "", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-08-01T12:36:46.197505", "function_name": "collect", "function_body": "    actions_list = []\n    current_state = env._current_state # Get the current state of the environment from the CraftLab wrapper\n    \n    primitive_id = current_state.world.cookbook.index[primitive]\n\n    # Pre-check: Determine if the target primitive is actually collectible (grabbable).\n    # Items like BOUNDARY, WATER, STONE, and WORKSHOPS are fixed environmental features\n    # and cannot be picked up using the 'USE' action. If the primitive is not grabbable,\n    # no collection actions can be performed, so an empty list is returned immediately.\n    if primitive_id not in current_state.world.grabbable_indices:\n        return []\n\n    # Extract key information from the current state for pathfinding\n    initial_agent_grid = current_state.grid\n    initial_agent_pos = current_state.pos # Agent's starting (row, col) position\n    initial_agent_dir = current_state.dir # Agent's starting direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n    GRID_WIDTH, GRID_HEIGHT, _ = initial_agent_grid.shape # Get dimensions of the grid\n\n    # Map DSL actions to their corresponding integer indices as defined by the environment\n    action_specs = env.action_specs()\n    ACTION_MOVE_FORWARD = action_specs['UP']\n    ACTION_TURN_LEFT = action_specs['LEFT']\n    ACTION_TURN_RIGHT = action_specs['RIGHT']\n    ACTION_USE = action_specs['USE']\n\n    # Define changes in (row, col) for movement based on current facing direction\n    # (dr, dc) = (delta_row, delta_column)\n    DIR_TO_DELTA_POS = {\n        0: (0, 1),   # RIGHT: +1 column\n        1: (-1, 0),  # UP: -1 row\n        2: (0, -1),  # LEFT: -1 column\n        3: (1, 0)    # DOWN: +1 row\n    }\n\n    # Define how agent's direction changes when turning left or right\n    TURN_LEFT_NEXT_DIR = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n    TURN_RIGHT_NEXT_DIR = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n    # Identify all grid entity indices that block agent movement.\n    # This set includes non-grabbable items (e.g., boundaries, water, workshops)\n    # and crucially, the target `primitive_id` itself. The agent cannot move onto\n    # a square containing the item it intends to 'USE'; it must be adjacent.\n    # Convert to a NumPy array for potentially faster indexing within _is_blocked.\n    blocking_kind_indices = np.array(list(current_state.world.non_grabbable_indices.union({primitive_id})))\n\n    # Helper function to check if a position is within grid boundaries\n    def _is_valid_position(r, c):\n        return 0 <= r < GRID_WIDTH and 0 <= c < GRID_HEIGHT\n\n    # Helper function to check if a position is blocked by any obstacle\n    def _is_blocked(r, c):\n        # Check if the cell at (r, c) contains any of the blocking kinds\n        return np.any(initial_agent_grid[r, c, blocking_kind_indices] > 0)\n\n    # Breadth-First Search (BFS) for the shortest path to a collectible state.\n    # BFS queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_here)\n    bfs_queue = collections.deque([((initial_agent_pos, initial_agent_dir), [])])\n    # Visited set stores (position_tuple, direction_int) to prevent redundant exploration and cycles.\n    visited_states = {(initial_agent_pos, initial_agent_dir)}\n\n    # Variable to store the action sequence once the target state (adjacent and facing primitive) is found.\n    path_to_collection_point = None \n\n    while bfs_queue:\n        (current_pos, current_dir), current_path_actions = bfs_queue.popleft()\n        current_r, current_c = current_pos\n\n        # Check if the agent is currently positioned to 'USE' the primitive:\n        # This means the primitive must be in the cell directly in front of the agent.\n        front_dr, front_dc = DIR_TO_DELTA_POS[current_dir]\n        front_r, front_c = current_r + front_dr, current_c + front_dc\n        \n        # Ensure the cell in front is within grid boundaries and contains the primitive\n        if _is_valid_position(front_r, front_c):\n            if initial_agent_grid[front_r, front_c, primitive_id] > 0:\n                path_to_collection_point = current_path_actions\n                break # Shortest path to a 'collectible' position found, terminate BFS.\n\n        # Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right\n        \n        # 1. Try moving forward\n        move_dr, move_dc = DIR_TO_DELTA_POS[current_dir]\n        next_r, next_c = current_r + move_dr, current_c + move_dc\n        next_pos = (next_r, next_c)\n        next_dir_after_move = current_dir # Moving forward does not change facing direction\n\n        # Check validity of the next state: within bounds, not visited, and not blocked by any obstacles\n        if (_is_valid_position(next_r, next_c) and\n            (next_pos, next_dir_after_move) not in visited_states and\n            not _is_blocked(next_r, next_c)): # Use _is_blocked helper\n            \n            visited_states.add((next_pos, next_dir_after_move))\n            bfs_queue.append(((next_pos, next_dir_after_move), current_path_actions + [ACTION_MOVE_FORWARD]))\n\n        # 2. Try turning left\n        next_dir_left = TURN_LEFT_NEXT_DIR[current_dir]\n        # Turning changes direction but not position.\n        if ((current_pos, next_dir_left) not in visited_states):\n            visited_states.add((current_pos, next_dir_left))\n            bfs_queue.append(((current_pos, next_dir_left), current_path_actions + [ACTION_TURN_LEFT]))\n\n        # 3. Try turning right\n        next_dir_right = TURN_RIGHT_NEXT_DIR[current_dir]\n        # Turning changes direction but not position.\n        if ((current_pos, next_dir_right) not in visited_states):\n            visited_states.add((current_pos, next_dir_right))\n            bfs_queue.append(((current_pos, next_dir_right), current_path_actions + [ACTION_TURN_RIGHT]))\n\n    # If a path was successfully found to a position where the agent can 'USE' the primitive,\n    # append the 'USE' action to the sequence to complete the collection process.\n    if path_to_collection_point is not None:\n        actions_list.extend(path_to_collection_point)\n        actions_list.append(ACTION_USE)\n\n    return actions_list", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-08-01T12:36:47.327059", "function_name": "collect", "function_body": "", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-08-01T12:38:21.322465", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  \n  # Extract immutable state information from the current CraftState for pathfinding\n  initial_grid = current_state.grid\n  # Agent's initial position (row, col) - stored as tuple\n  initial_pos = current_state.pos \n  # Agent's initial facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n  initial_dir = current_state.dir \n\n  # Resolve the string name of the primitive to its integer ID.\n  # Improvement: Added robustness to handle cases where the primitive name is not recognized.\n  try:\n      primitive_id = current_state.world.cookbook.index[primitive]\n  except KeyError:\n      # If the primitive name is not recognized, it cannot be collected.\n      # Return an empty list of actions, indicating failure or impossibility.\n      return []\n  \n  # Determine grid dimensions for boundary checks\n  num_rows, num_cols, _ = initial_grid.shape\n\n  # Early exit: If the target primitive doesn't exist anywhere on the map, return empty list.\n  # This prevents unnecessary BFS computation when the target is absent.\n  if not np.any(initial_grid[:, :, primitive_id] > 0):\n      return [] \n\n  # Retrieve action mapping from the environment (these are constant action IDs)\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # In CraftWorld, 'UP' means move forward in current direction\n  TURN_LEFT_ACTION = action_map['LEFT']     # Turn 90 degrees left\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Turn 90 degrees right\n  USE_ACTION = action_map['USE']            # Interact with the cell in front\n\n  # Define direction vectors for movement and turning rules (constants for agent's movement mechanics)\n  # DIR_TO_DRDC: Maps agent's current direction (0-3) to a (delta_row, delta_column) vector\n  # which indicates the cell directly in front of the agent for movement/interaction.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # TURN_LEFT_MAP / TURN_RIGHT_MAP: Map current direction to the new direction after a turn.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # RIGHT -> UP -> LEFT -> DOWN -> RIGHT\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # RIGHT -> DOWN -> LEFT -> UP -> RIGHT\n\n  # Get indices of entities that block agent movement (e.g., BOUNDARY, WATER, WORKSHOP_X).\n  # The agent cannot walk onto these cells.\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # Helper function to determine if a given grid cell (r, c) is valid and walkable for the agent to *move into*.\n  def is_cell_walkable(r, c):\n      \"\"\"\n      Checks if a given grid cell (r, c) is a valid and traversable location for the agent\n      to *move into*.\n      A cell is considered walkable if:\n      1. It falls within the grid boundaries.\n      2. It does not contain the target primitive itself (agent interacts from an adjacent cell, not by stepping onto it).\n      3. It does not contain any non-grabbable entities (impassable terrain like water, boundaries, etc.).\n      \"\"\"\n      # 1. Check if the position is within grid boundaries.\n      if not (0 <= r < num_rows and 0 <= c < num_cols):\n          return False\n      \n      # 2. Check if the cell contains the target primitive.\n      # The agent interacts with primitives from an adjacent square; it cannot move onto the target primitive's cell.\n      if initial_grid[r, c, primitive_id] > 0:\n          return False\n\n      # 3. Check if the cell contains any non-walkable (non-grabbable) entities.\n      # Iterate through the indices of known non-walkable kinds. If any are present, the cell is not walkable.\n      for kind_idx in non_walkable_kinds_indices:\n          if initial_grid[r, c, kind_idx] > 0:\n              return False\n          \n      return True\n\n  # BFS initialization:\n  # The queue stores tuples: ((current_row, current_col, current_direction), list_of_actions_taken_to_reach_here)\n  # This represents a unique state (agent's position and orientation) and the path to achieve it.\n  # Improvement: Using a flat (r, c, dir) tuple for state representation in queue and visited set.\n  queue = collections.deque([((initial_pos[0], initial_pos[1], initial_dir), [])])\n  \n  # The 'visited' set stores (row, col, direction) to prevent redundant exploration\n  # and cycles, ensuring the shortest path is found.\n  visited = {(initial_pos[0], initial_pos[1], initial_dir)}\n\n  target_path = None # This variable will store the action sequence if a path to the goal is found.\n\n  # Start BFS traversal\n  while queue:\n      # Unpack current state (r, c, current_dir) and the path taken to reach it.\n      (r, c, current_dir), path_actions = queue.popleft()\n\n      # Goal Check: Is the primitive directly in front of the agent from the current state?\n      # This is the \"goal state\" for our pathfinding: being positioned to interact with the primitive.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the cell directly in front is within grid boundaries before checking its contents.\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n          # If the primitive is present in this cell, we have found a path that leads the agent\n          # to be adjacent to and facing the primitive.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Path found! Terminate BFS.\n\n      # Explore all possible next actions (Move Forward, Turn Left, Turn Right) from the current state.\n\n      # Action 1: Try Move Forward\n      # Calculate the next position if the agent moves forward. Direction remains unchanged.\n      next_r_fwd, next_c_fwd = r + DIR_TO_DRDC[current_dir][0], c + DIR_TO_DRDC[current_dir][1]\n      next_dir_fwd = current_dir # Moving forward does not change orientation.\n      next_state_fwd = (next_r_fwd, next_c_fwd, next_dir_fwd)\n\n      # Check if the next position is valid and walkable, and this new (position, direction) state\n      # has not been visited yet.\n      if is_cell_walkable(next_r_fwd, next_c_fwd) and next_state_fwd not in visited:\n          # If walkable and unvisited, add the new state to the queue and mark it as visited.\n          visited.add(next_state_fwd)\n          queue.append((next_state_fwd, path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Action 2: Try Turn Left\n      # Calculate the new direction after turning left. Position remains unchanged.\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      next_state_left = (r, c, next_dir_left) # Position does not change when turning.\n\n      # Check if this new (position, direction) state has not been visited.\n      if next_state_left not in visited:\n          # Add the new state to the queue and mark as visited.\n          visited.add(next_state_left)\n          queue.append((next_state_left, path_actions + [TURN_LEFT_ACTION]))\n\n      # Action 3: Try Turn Right\n      # Calculate the new direction after turning right. Position remains unchanged.\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      next_state_right = (r, c, next_dir_right) # Position does not change when turning.\n\n      # Check if this new (position, direction) state has not been visited.\n      if next_state_right not in visited:\n          # Add the new state to the queue and mark as visited.\n          visited.add(next_state_right)\n          queue.append((next_state_right, path_actions + [TURN_RIGHT_ACTION]))\n\n  # After BFS completes:\n  # If a path to the target (adjacent and facing the primitive) was found,\n  # extend the found path with the final 'USE' action to collect the primitive.\n  # If no path was found (target_path is None), an empty list is returned,\n  # indicating the primitive is unreachable from the current state.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T12:38:22.490621", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`. Pre-computes all possible goal states (agent adjacent and facing the primitive)\n  to optimize the BFS goal check and clearly define the target positions.\n  \n  This function implements a Breadth-First Search (BFS) to find the optimal\n  sequence of movements and turns that places the agent directly in front of\n  the target primitive, followed by a 'USE' action to collect it.\n  \n  Args:\n      env (env.CraftLab): The CraftLab object representing the current simulation state.\n      primitive (str): The string name of the primitive item to be collected (e.g., \"WOOD\", \"STONE\", \"GRASS\").\n\n  Returns:\n      List[int]: A list of integer action codes (e.g., UP, LEFT, USE) that, when executed,\n                 will lead to the collection of the primitive. Returns an empty list\n                 if the primitive is unreachable from the current state.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state\n  \n  # Extract immutable state information from the current CraftState for pathfinding\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's initial position (row, col)\n  initial_dir = current_state.dir # Agent's initial facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook's index.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Determine grid dimensions for boundary checks\n  num_rows, num_cols, _ = initial_grid.shape\n\n  # Early exit if the primitive is not present anywhere on the grid.\n  if not np.any(initial_grid[:, :, primitive_id] > 0):\n      return []\n\n  # Retrieve action mapping from the environment (these are constant action IDs)\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define direction vectors for movement and turning rules\n  # DIR_TO_DRDC: Maps agent's current direction (0-3) to a (delta_row, delta_column) vector\n  # representing the cell directly in front of the agent.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: moves to (row, col+1)\n      1: (-1, 0),  # Facing UP: moves to (row-1, col)\n      2: (0, -1),  # Facing LEFT: moves to (row, col-1)\n      3: (1, 0)    # Facing DOWN: moves to (row+1, col)\n  }\n\n  # TURN_LEFT_MAP / TURN_RIGHT_MAP: Map current direction to the new direction after a turn.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # Get indices of entities that block agent movement (e.g., BOUNDARY, WATER, WORKSHOP_X).\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # Helper function to determine if a given grid cell (r, c) is valid and walkable for the agent.\n  def is_cell_walkable(r: int, c: int) -> bool:\n      \"\"\"\n      Checks if a given grid cell (r, c) is a valid and traversable location for the agent.\n      A cell is considered walkable if:\n      1. It falls within the grid boundaries.\n      2. It does not contain the target primitive itself (agent interacts from an adjacent cell).\n      3. It does not contain any non-grabbable entities (impassable terrain like water, boundaries).\n      \"\"\"\n      # 1. Check if the position is within grid boundaries.\n      if not (0 <= r < num_rows and 0 <= c < num_cols):\n          return False\n      \n      # 2. Check if the cell contains the target primitive.\n      # The agent interacts with primitives from an adjacent square, not by stepping onto them.\n      if initial_grid[r, c, primitive_id] > 0:\n          return False\n\n      # 3. Check if the cell contains any non-walkable (non-grabbable) entities.\n      for kind_idx in non_walkable_kinds_indices:\n          if initial_grid[r, c, kind_idx] > 0:\n              return False\n          \n      return True\n\n  # --- NEW FOR COLLECT_V2: Pre-compute all potential goal states for BFS ---\n  # A goal state is defined as ((agent_pos_r, agent_pos_c), agent_dir) where\n  # the agent is positioned such that it is adjacent to and directly facing the 'primitive_id'.\n  \n  # This mapping helps determine the agent's required facing direction\n  # given the relative position of the primitive from the agent.\n  # For example, if primitive is (0,1) relative to agent (i.e., agent's right),\n  # agent must face RIGHT (0).\n  AGENT_RELATIVE_TO_PRIMITIVE_TO_AGENT_DIR = {\n      (0, 1): 0,   # Primitive is (0,1) relative to agent (agent is left), agent faces RIGHT\n      (-1, 0): 1,  # Primitive is (-1,0) relative to agent (agent is below), agent faces UP\n      (0, -1): 2,  # Primitive is (0,-1) relative to agent (agent is right), agent faces LEFT\n      (1, 0): 3,   # Primitive is (1,0) relative to agent (agent is above), agent faces DOWN\n  }\n\n  goal_states = set() # Stores ((row, col), direction) tuples that represent valid pre-collection states\n\n  # Iterate through the entire grid to find all occurrences of the target primitive.\n  for r_prim in range(num_rows):\n      for c_prim in range(num_cols):\n          if initial_grid[r_prim, c_prim, primitive_id] > 0:\n              # For each primitive found at (r_prim, c_prim), consider its 4 adjacent cells.\n              # These are the potential locations from which the agent can \"USE\" the primitive.\n              for dr_adj, dc_adj in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # Deltas for Up, Down, Left, Right relative to primitive\n                  adj_r, adj_c = r_prim + dr_adj, c_prim + dc_adj\n                  \n                  # Check if this adjacent cell is a valid and walkable spot for the agent.\n                  if is_cell_walkable(adj_r, adj_c):\n                      # Determine the vector from the agent's potential position to the primitive.\n                      # This vector is (primitive_row - agent_row, primitive_col - agent_col).\n                      vector_to_primitive = (r_prim - adj_r, c_prim - adj_c)\n                      \n                      # Get the required agent direction based on this vector.\n                      required_dir = AGENT_RELATIVE_TO_PRIMITIVE_TO_AGENT_DIR[vector_to_primitive]\n                      \n                      # Add this valid agent state (position, direction) to the set of goal states.\n                      goal_states.add(((adj_r, adj_c), required_dir))\n\n  # BFS initialization:\n  # The queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_here)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # The 'visited' set stores (position_tuple, direction_int) to prevent redundant exploration\n  # and cycles, ensuring the shortest path is found.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This variable will store the action sequence if a path to the goal is found.\n\n  # Start BFS traversal\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # Goal Check: Is the current agent state (position, direction) one of the pre-computed goal states?\n      if (current_pos, current_dir) in goal_states:\n          target_path = path_actions\n          break # Path found! Terminate BFS.\n\n      # Explore all possible next actions (Move Forward, Turn Left, Turn Right) from the current state.\n\n      # Action 1: Try Move Forward\n      next_r_fwd, next_c_fwd = r + DIR_TO_DRDC[current_dir][0], c + DIR_TO_DRDC[current_dir][1]\n      next_pos_fwd = (next_r_fwd, next_c_fwd)\n      next_dir_fwd = current_dir\n\n      if is_cell_walkable(next_r_fwd, next_c_fwd) and (next_pos_fwd, next_dir_fwd) not in visited:\n          visited.add((next_pos_fwd, next_dir_fwd))\n          queue.append(((next_pos_fwd, next_dir_fwd), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Action 2: Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      next_pos_left = current_pos\n\n      if (next_pos_left, next_dir_left) not in visited:\n          visited.add((next_pos_left, next_dir_left))\n          queue.append(((next_pos_left, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Action 3: Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      next_pos_right = current_pos\n\n      if (next_pos_right, next_dir_right) not in visited:\n          visited.add((next_pos_right, next_dir_right))\n          queue.append(((next_pos_right, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # After BFS completes:\n  # If a path to the target (adjacent and facing the primitive) was found,\n  # extend the found path with the final 'USE' action to collect the primitive.\n  # If no path was found (target_path is None), an empty list is returned,\n  # indicating the primitive is unreachable from the current state.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T12:39:05.875121", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state # Get the current state of the environment from the CraftLab wrapper\n  \n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  # Pre-check: Determine if the target primitive is actually collectible (grabbable).\n  # Items like BOUNDARY, WATER, STONE, and WORKSHOPS are fixed environmental features\n  # and cannot be picked up using the 'USE' action. If the primitive is not grabbable,\n  # no collection actions can be performed, so an empty list is returned immediately.\n  if primitive_id not in current_state.world.grabbable_indices:\n      return []\n\n  # Extract key information from the current state for pathfinding\n  initial_agent_grid = current_state.grid\n  initial_agent_pos = current_state.pos # Agent's starting (row, col) position\n  initial_agent_dir = current_state.dir # Agent's starting direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  GRID_WIDTH, GRID_HEIGHT, _ = initial_agent_grid.shape # Get dimensions of the grid\n\n  # Map DSL actions to their corresponding integer indices as defined by the environment\n  action_specs = env.action_specs()\n  ACTION_MOVE_FORWARD = action_specs['UP']\n  ACTION_TURN_LEFT = action_specs['LEFT']\n  ACTION_TURN_RIGHT = action_specs['RIGHT']\n  ACTION_USE = action_specs['USE']\n\n  # Define changes in (row, col) for movement based on current facing direction\n  # (dr, dc) = (delta_row, delta_column)\n  DIR_TO_DELTA_POS = {\n      0: (0, 1),   # RIGHT: +1 column\n      1: (-1, 0),  # UP: -1 row\n      2: (0, -1),  # LEFT: -1 column\n      3: (1, 0)    # DOWN: +1 row\n  }\n\n  # Define how agent's direction changes when turning left or right\n  TURN_LEFT_NEXT_DIR = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_NEXT_DIR = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Identify all grid entity indices that block agent movement.\n  # This set includes non-grabbable items (e.g., boundaries, water, workshops)\n  # and crucially, the target `primitive_id` itself. The agent cannot move onto\n  # a square containing the item it intends to 'USE'; it must be adjacent.\n  blocking_kind_indices = list(current_state.world.non_grabbable_indices.union({primitive_id}))\n\n  # Breadth-First Search (BFS) for the shortest path to a collectible state.\n  # BFS queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_here)\n  bfs_queue = collections.deque([((initial_agent_pos, initial_agent_dir), [])])\n  # Visited set stores (position_tuple, direction_int) to prevent redundant exploration and cycles.\n  visited_states = {(initial_agent_pos, initial_agent_dir)}\n\n  # Variable to store the action sequence once the target state (adjacent and facing primitive) is found.\n  path_to_collection_point = None \n\n  while bfs_queue:\n      (current_pos, current_dir), current_path_actions = bfs_queue.popleft()\n      current_r, current_c = current_pos\n\n      # Check if the agent is currently positioned to 'USE' the primitive:\n      # This means the primitive must be in the cell directly in front of the agent.\n      front_dr, front_dc = DIR_TO_DELTA_POS[current_dir]\n      front_r, front_c = current_r + front_dr, current_c + front_dc\n      \n      # Ensure the cell in front is within grid boundaries\n      if (0 <= front_r < GRID_WIDTH and 0 <= front_c < GRID_HEIGHT):\n          # Check if the primitive is present in the cell directly in front (indicated by a count > 0)\n          if initial_agent_grid[front_r, front_c, primitive_id] > 0:\n              path_to_collection_point = current_path_actions\n              break # Shortest path to a 'collectible' position found, terminate BFS.\n\n      # Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right\n      \n      # 1. Try moving forward\n      move_dr, move_dc = DIR_TO_DELTA_POS[current_dir]\n      next_r, next_c = current_r + move_dr, current_c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir_after_move = current_dir # Moving forward does not change facing direction\n\n      # Check validity of the next state: within bounds, not visited, and not blocked by any obstacles\n      if (0 <= next_r < GRID_WIDTH and 0 <= next_c < GRID_HEIGHT and\n          (next_pos, next_dir_after_move) not in visited_states):\n          \n          # Check if the next position is walkable (i.e., it does not contain any blocking entities).\n          # np.any returns True if any of the specified blocking kinds are present at (next_r, next_c).\n          if not np.any(initial_agent_grid[next_r, next_c, blocking_kind_indices] > 0):\n              visited_states.add((next_pos, next_dir_after_move))\n              bfs_queue.append(((next_pos, next_dir_after_move), current_path_actions + [ACTION_MOVE_FORWARD]))\n\n      # 2. Try turning left\n      next_dir_left = TURN_LEFT_NEXT_DIR[current_dir]\n      # Turning changes direction but not position.\n      if ((current_pos, next_dir_left) not in visited_states):\n          visited_states.add((current_pos, next_dir_left))\n          bfs_queue.append(((current_pos, next_dir_left), current_path_actions + [ACTION_TURN_LEFT]))\n\n      # 3. Try turning right\n      next_dir_right = TURN_RIGHT_NEXT_DIR[current_dir]\n      # Turning changes direction but not position.\n      if ((current_pos, next_dir_right) not in visited_states):\n          visited_states.add((current_pos, next_dir_right))\n          bfs_queue.append(((current_pos, next_dir_right), current_path_actions + [ACTION_TURN_RIGHT]))\n\n  # If a path was successfully found to a position where the agent can 'USE' the primitive,\n  # append the 'USE' action to the sequence to complete the collection process.\n  if path_to_collection_point is not None:\n      actions_list.extend(path_to_collection_point)\n      actions_list.append(ACTION_USE)\n\n  return actions_list", "island_id": 2, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T12:39:07.281138", "function_name": "collect", "function_body": "  \"\"\"Returns a list of actions to find and collect the primitive in the passed env.\n    This implementation uses Breadth-First Search (BFS) to find the shortest\n    sequence of actions to reach a position where the agent can 'USE' the\n    specified primitive.\n    \n    Args:\n        env (env.CraftLab): The CraftLab object containing the current game state.\n        primitive (str): The name of the primitive item to collect (e.g., \"WOOD\", \"IRON\").\n\n    Returns:\n        List[int]: A sequence of action indices (integers) to execute to collect the primitive.\n                   Returns an empty list if the primitive is not grabbable or unreachable.\n  \"\"\"\n  actions_to_take = []\n  current_env_state = env._current_state # Access the underlying CraftState for detailed info\n  \n  # --- Step 1: Pre-computation and Initialization ---\n  \n  # Get the integer ID for the target primitive from the environment's cookbook index.\n  primitive_id = current_env_state.world.cookbook.index[primitive]\n\n  # Check if the primitive is actually a grabbable item.\n  # Environmental features (like BOUNDARY, WATER, WORKSHOP) cannot be 'collected' via 'USE'.\n  if primitive_id not in current_env_state.world.grabbable_indices:\n      # If not grabbable, no actions can lead to its collection.\n      return []\n\n  # Capture the static grid layout and initial agent state for BFS.\n  # The BFS operates on this initial snapshot of the grid, assuming it doesn't change\n  # until an action is executed.\n  initial_grid = current_env_state.grid\n  initial_agent_pos = current_env_state.pos # Agent's starting (row, col) tuple\n  initial_agent_dir = current_env_state.dir # Agent's starting direction (int: 0=RIGHT, 1=UP, 2=LEFT, 3=DOWN)\n\n  GRID_ROWS, GRID_COLS, _ = initial_grid.shape # Extract grid dimensions\n\n  # Map symbolic actions to their integer IDs provided by the environment.\n  action_id_map = env.action_specs()\n  ACTION_MOVE_FORWARD = action_id_map['UP'] # 'UP' in action_specs means move forward\n  ACTION_TURN_LEFT = action_id_map['LEFT']\n  ACTION_TURN_RIGHT = action_id_map['RIGHT']\n  ACTION_USE = action_id_map['USE']\n\n  # Define delta (row, col) changes for movement based on agent's facing direction.\n  # This helps calculate the position of the cell directly in front of the agent.\n  DIRECTION_TO_DELTA_POS = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # Define how the agent's direction changes when turning left or right.\n  TURN_LEFT_DIR_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # R->U->L->D->R (clockwise rotation of direction index)\n  TURN_RIGHT_DIR_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # R->D->L->U->R (counter-clockwise rotation)\n\n  # Identify all entity kind indices that block agent movement.\n  # This set includes permanent environmental obstacles (e.g., walls, water)\n  # AND the target primitive itself. An agent cannot move onto a cell containing\n  # the item it wants to 'USE'; it must be adjacent to it.\n  all_blocking_indices = list(current_env_state.world.non_grabbable_indices.union({primitive_id}))\n\n  # --- Step 2: Breadth-First Search (BFS) Setup ---\n\n  # BFS queue: Stores tuples of ((agent_position, agent_direction), list_of_actions_taken_to_reach_this_state)\n  bfs_queue = collections.deque([((initial_agent_pos, initial_agent_dir), [])])\n  \n  # Visited set: Stores (position_tuple, direction_int) to avoid redundant computations and infinite loops.\n  visited_states = {(initial_agent_pos, initial_agent_dir)}\n\n  # Variable to store the final path found by BFS.\n  shortest_path_to_primitive = None \n\n  # --- Step 3: BFS Execution ---\n\n  while bfs_queue:\n      (current_pos, current_dir), path_actions_so_far = bfs_queue.popleft()\n      current_r, current_c = current_pos\n\n      # Check if the current state allows collection: Is the primitive directly in front?\n      delta_r_front, delta_c_front = DIRECTION_TO_DELTA_POS[current_dir]\n      front_cell_r, front_cell_c = current_r + delta_r_front, current_c + delta_c_front\n      \n      # Ensure the cell in front is within the grid boundaries.\n      if (0 <= front_cell_r < GRID_ROWS and 0 <= front_cell_c < GRID_COLS):\n          # If the cell in front contains the primitive (count > 0), we've found our target state.\n          if initial_grid[front_cell_r, front_cell_c, primitive_id] > 0:\n              shortest_path_to_primitive = path_actions_so_far\n              break # Found the shortest path, no need to explore further.\n\n      # Explore next possible states by applying actions:\n\n      # Action 1: Try to Move Forward\n      delta_r_move, delta_c_move = DIRECTION_TO_DELTA_POS[current_dir]\n      next_pos_move = (current_r + delta_r_move, current_c + delta_c_move)\n      next_dir_move = current_dir # Direction doesn't change when moving forward\n\n      # Check if the new position is valid (within bounds) and the new state hasn't been visited.\n      if (0 <= next_pos_move[0] < GRID_ROWS and 0 <= next_pos_move[1] < GRID_COLS and\n          (next_pos_move, next_dir_move) not in visited_states):\n          \n          # Check if the cell at next_pos_move is walkable (i.e., not blocked by any obstacles).\n          # np.any will be True if *any* of the `all_blocking_indices` are present in that cell.\n          if not np.any(initial_grid[next_pos_move[0], next_pos_move[1], all_blocking_indices] > 0):\n              visited_states.add((next_pos_move, next_dir_move))\n              bfs_queue.append(( (next_pos_move, next_dir_move), path_actions_so_far + [ACTION_MOVE_FORWARD] ))\n\n      # Action 2: Try to Turn Left\n      next_dir_left = TURN_LEFT_DIR_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_left) not in visited_states):\n          visited_states.add((current_pos, next_dir_left))\n          bfs_queue.append(( (current_pos, next_dir_left), path_actions_so_far + [ACTION_TURN_LEFT] ))\n\n      # Action 3: Try to Turn Right\n      next_dir_right = TURN_RIGHT_DIR_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_right) not in visited_states):\n          visited_states.add((current_pos, next_dir_right))\n          bfs_queue.append(( (current_pos, next_dir_right), path_actions_so_far + [ACTION_TURN_RIGHT] ))\n\n  # --- Step 4: Finalizing the Action List ---\n\n  # If a path was found to a position where the agent can 'USE' the primitive,\n  # append the 'USE' action to complete the collection.\n  if shortest_path_to_primitive is not None:\n      actions_to_take.extend(shortest_path_to_primitive)\n      actions_to_take.append(ACTION_USE)\n\n  return actions_to_take", "island_id": 2, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T12:40:38.588451", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  \n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  # Optimization: If the primitive is already in inventory, no actions are needed.\n  if current_state.inventory[primitive_id] > 0:\n      return []\n\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (row, col)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  # Get grid dimensions consistently using WIDTH, HEIGHT from the initial grid shape.\n  WIDTH, HEIGHT, _ = initial_grid.shape \n\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # Action to move agent forward in its current direction\n  TURN_LEFT_ACTION = action_map['LEFT']     # Action to turn agent left\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Action to turn agent right\n  USE_ACTION = action_map['USE']            # Action to interact with an object in front\n\n  # Direction mapping: (dr, dc) representing change in (row, col) for each facing direction\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT (positive column change)\n      1: (-1, 0),  # Facing UP (negative row change)\n      2: (0, -1),  # Facing LEFT (negative column change)\n      3: (1, 0)    # Facing DOWN (positive row change)\n  }\n\n  # Maps for updating the agent's direction when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Rotate counter-clockwise (R->U->L->D->R)\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Rotate clockwise (R->D->L->U->R)\n\n  # Define all kinds of entities that block agent movement onto their cells.\n  # This set includes:\n  # 1. All inherently non-grabbable items (e.g., BOUNDARY, WATER, WORKSHOP_X).\n  # 2. The target primitive itself, because the agent must stand *adjacent* to\n  #    collectible resources to 'USE' them, not on the same cell.\n  non_walkable_kinds_set = set(current_state.world.non_grabbable_indices)\n  non_walkable_kinds_set.add(primitive_id)\n  \n  # Convert the set of non-walkable kind IDs to a NumPy array for efficient vectorized lookup\n  # when checking cell walkability using np.any().\n  non_walkable_kinds_array = np.array(list(non_walkable_kinds_set), dtype=int)\n\n  # BFS initialization:\n  # The queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_here)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # The visited set stores (position_tuple, direction_int) to prevent redundant exploration and infinite loops.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # This will store the sequence of actions that leads the agent\n                              # to be adjacent to and correctly facing the primitive.\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Goal Check: Determine if the target primitive is directly in front of the agent.\n      # Calculate the coordinates of the cell directly in front based on current position and direction.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # First, ensure the cell in front is within the grid boundaries.\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          # Then, check if this front cell contains the target primitive.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path_actions = path_actions\n              break # Shortest path found: agent is positioned correctly to 'USE' the primitive.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n      \n      # Attempt to Move Forward (using the 'UP' action in CraftWorld)\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change the agent's facing direction.\n\n      # Check if the potential next position is within grid bounds AND this specific (position, direction)\n      # state has not been visited before.\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT and\n          (next_pos, next_dir) not in visited):\n          \n          # Check if the cell at next_pos is walkable. A cell is walkable if it does NOT contain\n          # any entity from our `non_walkable_kinds_array`. `np.any()` efficiently checks this.\n          if not np.any(initial_grid[next_r, next_c, non_walkable_kinds_array] > 0):\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Attempt to Turn Left (using the 'LEFT' action)\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change the agent's position, only its direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Attempt to Turn Right (using the 'RIGHT' action)\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change the agent's position, only its direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a valid path was found to reach a state where the agent is adjacent to and\n  # facing the primitive, append the 'USE' action to complete the collection.\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 1, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T12:40:39.828650", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  \n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  # Improvement for v2: If the primitive is already in inventory, no actions are needed.\n  if current_state.inventory[primitive_id] > 0:\n      return []\n\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (row, col)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  # Extract grid dimensions: (rows, columns)\n  grid_rows, grid_cols, _ = initial_grid.shape \n\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # Assumed UP moves agent forward in its current direction\n  TURN_LEFT_ACTION = action_map['LEFT']     # Assumed LEFT turns agent left\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Assumed RIGHT turns agent right\n  USE_ACTION = action_map['USE']            # Action to interact with an object in front\n\n  # Direction mapping: (dr, dc) for agent's facing direction\n  # This defines the change in (row, col) when moving \"forward\".\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # Map for updating the agent's direction when turning left/right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # RIGHT -> UP -> LEFT -> DOWN -> RIGHT\n  # Fixed a bug from previous versions: ensure correct mapping for all directions.\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # RIGHT -> DOWN -> LEFT -> UP -> RIGHT\n\n  # Determine all kinds of entities the agent cannot walk *onto*.\n  # This includes explicit non-grabbable items (like BOUNDARY, WATER, WORKSHOP)\n  # and the primitive itself (agent must be adjacent to it, not on it, to use).\n  non_walkable_kinds_set = set(current_state.world.non_grabbable_indices)\n  non_walkable_kinds_set.add(primitive_id)\n  \n  # Convert to a numpy array for efficient checking on the grid.\n  non_walkable_kinds_array = np.array(list(non_walkable_kinds_set), dtype=int)\n\n  # BFS state representation: ((current_row, current_col), current_direction_int)\n  # Queue stores ( (current_pos_tuple, current_dir_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (current_pos_tuple, current_dir_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the action sequence leading to the state\n                      # where the agent is adjacent to the primitive and facing it.\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent at the current state.\n      # If so, this is a target state, and we can stop searching.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the cell in front is within grid bounds\n      if (0 <= front_r < grid_rows and 0 <= front_c < grid_cols):\n          # Check if the front_cell contains the target primitive\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Found the path to be adjacent and facing the primitive\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if next_pos is within grid bounds and this (position, direction) state hasn't been visited\n      if (0 <= next_r < grid_rows and 0 <= next_c < grid_cols and\n          (next_pos, next_dir) not in visited):\n          \n          # Check if the next_pos is walkable.\n          # A cell is walkable if it does not contain any kind from our `non_walkable_kinds_array`.\n          # np.any efficiently checks if any non-walkable item exists in the cell's `kind` dimension.\n          if not np.any(initial_grid[next_r, next_c, non_walkable_kinds_array] > 0):\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path was found to reach an adjacent and facing position, append the USE action\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 1, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T12:41:52.868602", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Map the primitive name to its integer ID using the world's cookbook index.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Early exit: Check if the primitive is already in the agent's inventory.\n  # If the goal is already satisfied, no actions are needed.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Determine if the primitive is a type that is inherently collectible via the 'USE' action.\n  # This includes explicit primitive resources defined in the cookbook, any grabbable items,\n  # or specific global entities like water and stone. This filters out non-collectible\n  # items like workshops or boundaries.\n  is_primitive_collectible = (\n      i_kind in world.cookbook.primitives or\n      i_kind in world.grabbable_indices or\n      i_kind == world.water_index or\n      i_kind == world.stone_index\n  )\n\n  # If the target primitive itself is not designed to be collected by 'USE', return an empty path.\n  # This serves as a strong early filter for invalid collection targets.\n  if not is_primitive_collectible:\n    return []\n\n  # 4. Define action constants and directional deltas for grid navigation and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # Maps agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT) to\n  # the (row_change, col_change) needed to find the cell directly in front.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP (North)\n      1: (0, 1),  # RIGHT (East)\n      2: (1, 0),  # DOWN (South)\n      3: (0, -1)  # LEFT (West)\n  }\n\n  # Helper function to compute the shortest sequence of turns required to face a target direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the desired direction.\n\n      # Calculate the rotational difference, handling modular arithmetic for 0-3 directions.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # One clockwise turn (e.g., UP to RIGHT)\n          return [RIGHT_ACT]\n      elif diff == 3: # One counter-clockwise turn (e.g., UP to LEFT)\n          return [LEFT_ACT]\n      else: # diff == 2 (180-degree turn, e.g., UP to DOWN)\n          return [RIGHT_ACT, RIGHT_ACT] # Two successive turns in the same direction.\n\n  # 5. Initialize Breadth-First Search (BFS).\n  # The queue stores tuples of (current_CraftState, path_to_reach_this_state).\n  q = collections.deque()\n  # The 'visited' set tracks unique states to prevent redundant exploration and cycles.\n  # A state is defined by (row, col, direction, inventory_tuple), where inventory_tuple\n  # is a hashable representation of the agent's inventory array.\n  visited = set()\n\n  # Add the initial state to the queue and visited set.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Heuristic limit on the number of states to explore. This helps to prevent\n  # excessively long computations in very large or unreachable scenarios.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 20 \n  explored_states_count = 0\n\n  # 6. BFS Loop: Continues until the queue is empty or the goal is found.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and its associated action path.\n    explored_states_count += 1\n\n    # Pruning: If the number of explored states exceeds the heuristic limit, stop.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # --- Goal Check ---\n    # Check if the target primitive (`i_kind`) is in the 3x3 neighborhood around the agent.\n    if state.next_to(i_kind):\n        # If it is, iterate through all four cardinal directions to find if it's directly in front.\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell directly in front is within grid bounds and contains the primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                temp_state_after_turns = state \n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                for turn_action in turns_to_face:\n                    # Apply turns sequentially, updating the temporary state.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Record inventory before attempting 'USE' to verify successful collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Crucial verification: Check if the count of the target primitive in inventory\n                # actually increased after the 'USE' action. This confirms successful collection,\n                # implicitly accounting for any preconditions (e.g., requiring tools) handled by `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    # If collected, return the full path including turns and the final USE.\n                    return path + turns_to_face + [USE_ACT]\n\n    # --- Explore Movement Actions ---\n    # For each possible movement action, simulate the step and add the new state to the queue if unvisited.\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # --- Explore General 'USE' Action ---\n    # This is essential for picking up other grabbable items (like tools)\n    # that are not the target primitive itself but might be necessary preconditions.\n    \n    # Determine the cell directly in front of the agent.\n    front_dr, front_dc = _DIR_TO_DELTA_FRONT[current_dir]\n    facing_r, facing_c = current_r + front_dr, current_c + front_dc\n\n    # Check if the cell in front is within bounds.\n    if 0 <= facing_r < grid_width and 0 <= facing_c < grid_height:\n        is_something_useable_in_front = False\n        \n        # Optimized check: Determine if any collectible item is present at the cell directly in front.\n        # This includes any item classified as grabbable, water, or stone.\n        kinds_present_at_front = np.where(state.grid[facing_r, facing_c, :] == 1)[0]\n        \n        for kind_idx in kinds_present_at_front:\n            if (kind_idx in world.grabbable_indices or\n                kind_idx == world.water_index or\n                kind_idx == world.stone_index):\n                is_something_useable_in_front = True\n                break\n\n        # Only attempt the 'USE' action if there's something potentially interactable in front.\n        if is_something_useable_in_front:\n            inventory_before_any_use = np.copy(state.inventory)\n            _, state_after_current_use = state.step(USE_ACT)\n            \n            # Add the state after a general 'USE' action to the queue only if it resulted in\n            # a meaningful change (i.e., inventory updated, or position/direction changed).\n            # This prevents exploring redundant states where 'USE' did nothing.\n            if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n                    state_after_current_use.pos == state.pos and\n                    state_after_current_use.dir == state.dir):\n\n                next_inventory_tuple = tuple(state_after_current_use.inventory)\n                next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n                if next_state_key not in visited:\n                    visited.add(next_state_key)\n                    q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS loop completes and no path to collect the primitive was found,\n  # it means the primitive is currently unreachable from the initial state under the given rules.\n  return []", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T12:41:54.557821", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized in the world's cookbook, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If so, it's already \"collected,\" and no actions are needed.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Define the comprehensive set of all entity kinds that can be collected via the 'USE' action.\n  # This includes explicit primitive resources, grabbable items, water, and stone.\n  # This set is used for both the initial check of the target primitive and for checking\n  # if any useful item (like a tool) can be picked up on the way to the target.\n  all_useable_and_collectible_kinds = set(world.cookbook.primitives).union(world.grabbable_indices).union({world.water_index, world.stone_index})\n  \n  # If the target primitive itself is not of a type that can be collected via 'USE',\n  # then this `collect` function cannot satisfy the request.\n  if i_kind not in all_useable_and_collectible_kinds:\n    return []\n\n  # 4. Define action constants and directional deltas for grid navigation.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # Delta values for checking the cell directly in front of the agent based on its current direction.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (North)\n      1: (0, 1),  # RIGHT: row, col + 1 (East)\n      2: (1, 0),  # DOWN: row + 1, col (South)\n      3: (0, -1)  # LEFT: row, col - 1 (West)\n  }\n\n  # Helper function to compute the minimal sequence of turns to face a target direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the correct direction.\n\n      # Calculate the difference in directions, wrapping around 0-3.\n      diff = (target_dir - current_dir + 4) % 4\n\n      if diff == 1: # Target is one step clockwise.\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise.\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn.\n          return [RIGHT_ACT, RIGHT_ACT] # Two successive right turns (or left turns).\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The `visited` set stores a tuple `(row, col, direction, inventory_tuple)` to represent\n  # a unique state. Converting inventory (numpy array) to a tuple makes it hashable for the set.\n  visited = set()\n\n  # Add the initial state to the queue and visited set.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, [])) # (current_state, path_to_reach_this_state)\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Heuristic limit to prevent the BFS from running indefinitely in complex or unreachable scenarios.\n  # The multiplier (20) allows for broader exploration, especially for tool acquisition.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 20\n  explored_states_count = 0\n\n  # 6. BFS Loop: Continues until the queue is empty or the goal is found.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and its associated path.\n    explored_states_count += 1\n\n    # Pruning: If too many distinct states have been explored, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n\n    # Goal Check: Can the target primitive be collected from the current `state`?\n    # This involves checking if the primitive is in the 3x3 neighborhood around the agent.\n    if state.next_to(i_kind):\n        # Iterate through all four cardinal directions to check if the primitive is directly in front.\n        for target_dir in range(4):\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell directly in front is within bounds and contains the target primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and\n                state.grid[facing_r, facing_c, i_kind] == 1):\n\n                # Calculate and apply the turning actions required to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state\n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Record inventory *before* attempting the 'USE' action to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action on the temporary state.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Crucial verification: Check if the count of the target primitive in inventory\n                # actually increased. This confirms successful collection, accounting for any\n                # game rules (e.g., requiring tools) handled by `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT] # Found a path!\n\n    # Explore possible future states by performing movement actions.\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      # If this next state (position, direction, and inventory) has not been visited, add it to the queue.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n\n    # Explore the general 'USE' action from the current state.\n    # This is vital for scenarios where using an item at the current location (e.g., picking up a tool)\n    # might enable subsequent collection steps.\n    \n    # Determine the cell directly in front of the agent\n    front_dr, front_dc = _DIR_TO_DELTA_FRONT[current_dir]\n    facing_r, facing_c = current_r + front_dr, current_c + front_dc\n\n    # Check bounds for the cell in front\n    if 0 <= facing_r < grid_width and 0 <= facing_c < grid_height:\n        # Check if *any* of the `all_useable_and_collectible_kinds` are present in the cell directly in front.\n        # This covers grabbable items, water, stone, and other primitive resources that might be needed.\n        is_something_useable_in_front = False\n        for k_idx_to_check in all_useable_and_collectible_kinds:\n            if state.grid[facing_r, facing_c, k_idx_to_check] == 1:\n                is_something_useable_in_front = True\n                break\n\n        # Only attempt USE_ACT if there's something potentially interactable in front.\n        if is_something_useable_in_front:\n            inventory_before_any_use = np.copy(state.inventory)\n            _, state_after_current_use = state.step(USE_ACT)\n            \n            # Add to queue only if the USE action resulted in a meaningful state change.\n            # A meaningful change means inventory or position/direction was updated.\n            # Inventory change is the primary signal for resource collection.\n            if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n                    state_after_current_use.pos == state.pos and\n                    state_after_current_use.dir == state.dir):\n\n                next_inventory_tuple = tuple(state_after_current_use.inventory)\n                next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n                if next_state_key not in visited:\n                    visited.add(next_state_key)\n                    q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS loop completes and no path to collect the primitive was found,\n  # it means the primitive is currently unreachable given the environment and agent's capabilities.\n  return []", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T12:42:35.662863", "function_name": "collect", "function_body": "  actions_list = []\n  \n  # Access the internal CraftState object which holds the current grid, position, and inventory.\n  current_state = env._current_state \n\n  # Extract essential information for pathfinding from the current state.\n  initial_grid = current_state.grid  # The static grid layout of the environment.\n  initial_pos = current_state.pos    # Agent's current (row, col) position on the grid.\n  initial_dir = current_state.dir    # Agent's current facing direction (0:Right, 1:Up, 2:Left, 3:Down).\n\n  # Get the integer ID for the target primitive from the cookbook index.\n  try:\n      primitive_id = current_state.world.cookbook.index[primitive]\n  except KeyError:\n      # If the primitive name is not recognized, it cannot be collected.\n      return []\n\n  # --- Improvement: Check if the primitive is already in inventory ---\n  # If the primitive is already collected, no actions are needed.\n  if current_state.inventory[primitive_id] > 0:\n      return []\n  # ------------------------------------------------------------------\n\n  # Get grid dimensions for boundary checks during pathfinding.\n  GRID_ROWS, GRID_COLS, _ = initial_grid.shape \n\n  # Map action names (from DSL) to their integer indices (used by env.step).\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Pre-defined changes in (row, col) coordinates for each direction.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: +1 to column.\n      1: (-1, 0),  # Facing UP: -1 to row.\n      2: (0, -1),  # Facing LEFT: -1 to column.\n      3: (1, 0)    # Facing DOWN: +1 to row.\n  }\n\n  # Mapping for updating agent's direction when turning left/right.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Set of entity kind IDs that represent non-walkable terrain.\n  # These are defined in the CraftWorld's non_grabbable_indices (e.g., boundaries, water, workshops).\n  non_walkable_kind_ids = current_state.world.non_grabbable_indices\n\n  # Helper function to determine if a cell at (r, c) is a valid and walkable location for the agent.\n  def _is_valid_and_walkable(r: int, c: int) -> bool:\n      \"\"\"\n      Checks if a cell (r, c) is within grid bounds and can be walked upon by the agent.\n      A cell is not walkable if:\n      1. It's out of grid bounds.\n      2. It contains any entity explicitly defined as non-grabbable/blocking (e.g., walls, water).\n      3. It contains the target primitive itself (the agent needs to be adjacent, not on top of it).\n      \"\"\"\n      if not (0 <= r < GRID_ROWS and 0 <= c < GRID_COLS):\n          return False\n\n      # Check if the cell contains any non-grabbable/blocking obstacles.\n      # The agent cannot pass through these.\n      for kind_idx in non_walkable_kind_ids:\n          if initial_grid[r, c, kind_idx] > 0:\n              return False\n      \n      # The agent should not walk *onto* the primitive it intends to collect.\n      # It must be adjacent to it to successfully use the 'USE' action.\n      if initial_grid[r, c, primitive_id] > 0:\n          return False\n          \n      return True\n\n  # BFS Initialization:\n  # Queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_here).\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # Visited set stores (position_tuple, direction_int) to avoid redundant exploration\n  # and ensure the shortest path is found by BFS.\n  visited = {(initial_pos, initial_dir)}\n\n  # Variable to store the shortest action sequence to reach a state where the agent\n  # is adjacent to and facing the primitive.\n  path_to_adjacent_and_facing_primitive = None \n\n  # Start BFS traversal.\n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      current_r, current_c = current_pos\n\n      # Goal Check: Is the primitive directly in front of the agent at the current state?\n      # This is the state from which the 'USE' action can be executed to collect the primitive.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = current_r + front_dr, current_c + front_dc\n      \n      # Check if the cell directly in front is within grid bounds AND contains the target primitive.\n      if (0 <= front_r < GRID_ROWS and 0 <= front_c < GRID_COLS and\n          initial_grid[front_r, front_c, primitive_id] > 0):\n          path_to_adjacent_and_facing_primitive = path_so_far\n          break # Shortest path to a 'USE'-ready position found, terminate BFS.\n\n      # Explore possible next actions from the current state: Move, Turn Left, Turn Right.\n\n      # 1. Try Move Forward (corresponds to 'UP' action in CraftLab's action_specs)\n      next_r_move, next_c_move = current_r + DIR_TO_DRDC[current_dir][0], current_c + DIR_TO_DRDC[current_dir][1]\n      next_pos_move = (next_r_move, next_c_move)\n      next_dir_move = current_dir # Direction does not change when moving forward.\n\n      # Check if the proposed next cell is valid and walkable, and if this state hasn't been visited.\n      if _is_valid_and_walkable(next_r_move, next_c_move):\n          if (next_pos_move, next_dir_move) not in visited:\n              visited.add((next_pos_move, next_dir_move))\n              queue.append(((next_pos_move, next_dir_move), path_so_far + [MOVE_FORWARD_ACTION]))\n\n      # 2. Try Turn Left (corresponds to 'LEFT' action)\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Position does not change when turning.\n      if (current_pos, next_dir_left) not in visited:\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_so_far + [TURN_LEFT_ACTION]))\n\n      # 3. Try Turn Right (corresponds to 'RIGHT' action)\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Position does not change when turning.\n      if (current_pos, next_dir_right) not in visited:\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_so_far + [TURN_RIGHT_ACTION]))\n\n  # After BFS completes:\n  # If a path was found to a state where the agent is adjacent and facing the primitive,\n  # append the 'USE' action to complete the collection process.\n  if path_to_adjacent_and_facing_primitive is not None:\n      actions_list.extend(path_to_adjacent_and_facing_primitive)\n      actions_list.append(USE_ACTION)\n\n  # Return the sequence of actions. This list will be empty if the primitive\n  # was not found, was unreachable, or was already in inventory.\n  return actions_list", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T12:42:36.819360", "function_name": "collect", "function_body": "  actions_list = []\n  \n  # Access the internal CraftState object which holds the current grid, position, and inventory.\n  current_state = env._current_state \n\n  # Get the integer ID for the target primitive from the cookbook index.\n  try:\n      primitive_id = current_state.world.cookbook.index[primitive]\n  except KeyError:\n      # If the primitive name is not recognized, it cannot be collected.\n      # This indicates an invalid primitive name, so no actions are possible.\n      return []\n\n  # --- IMPROVEMENT FOR V2: Early exit if the primitive is already in inventory ---\n  # If the agent already possesses at least one unit of the primitive, no actions are needed.\n  if current_state.inventory[primitive_id] > 0:\n      return [] \n  # --------------------------------------------------------------------------------\n\n  # Extract essential information for pathfinding from the current state.\n  initial_grid = current_state.grid  # The static grid layout of the environment (for pathfinding).\n  initial_pos = current_state.pos    # Agent's current (row, col) position on the grid.\n  initial_dir = current_state.dir    # Agent's current facing direction (0:Right, 1:Up, 2:Left, 3:Down).\n\n  # Get grid dimensions for boundary checks during pathfinding.\n  GRID_ROWS, GRID_COLS, _ = initial_grid.shape \n\n  # Map action names (from DSL) to their integer indices (used by env.step).\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Pre-defined changes in (row, col) coordinates for each direction.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: +1 to column.\n      1: (-1, 0),  # Facing UP: -1 to row.\n      2: (0, -1),  # Facing LEFT: -1 to column.\n      3: (1, 0)    # Facing DOWN: +1 to row.\n  }\n\n  # Mapping for updating agent's direction when turning left/right.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Set of entity kind IDs that represent non-walkable terrain.\n  # These are defined in CraftWorld as `non_grabbable_indices` (e.g., boundaries, water, workshops).\n  non_walkable_kind_ids = current_state.world.non_grabbable_indices\n\n  # Helper function to determine if a cell at (r, c) is a valid and walkable location for the agent.\n  def _is_valid_and_walkable(r: int, c: int) -> bool:\n      \"\"\"\n      Checks if a cell (r, c) is within grid bounds and can be walked upon by the agent.\n      A cell is not walkable if it's out of bounds, if it contains a non-grabbable entity,\n      or if it is the target primitive itself (as the agent needs to be adjacent, not on top).\n      \"\"\"\n      if not (0 <= r < GRID_ROWS and 0 <= c < GRID_COLS):\n          return False\n\n      # Check for non-grabbable obstacles.\n      for kind_idx in non_walkable_kind_ids:\n          if initial_grid[r, c, kind_idx] > 0:\n              return False\n      \n      # The agent should not walk *onto* the primitive it intends to collect.\n      # It must be adjacent to it to successfully use the 'USE' action.\n      if initial_grid[r, c, primitive_id] > 0:\n          return False\n          \n      return True\n\n  # BFS Initialization:\n  # Queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_here).\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # Visited set stores (position_tuple, direction_int) to avoid redundant exploration\n  # and ensure the shortest path is found.\n  visited = {(initial_pos, initial_dir)}\n\n  # Variable to store the shortest action sequence to reach a state where the agent\n  # is adjacent to and facing the primitive.\n  path_to_adjacent_and_facing_primitive = None \n\n  # Start BFS traversal.\n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      current_r, current_c = current_pos\n\n      # Goal Check: Is the primitive directly in front of the agent at the current state?\n      # This is the desired state from which the 'USE' action can be executed.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = current_r + front_dr, current_c + front_dc\n      \n      # Check if the cell in front is within grid bounds AND contains the target primitive.\n      if (0 <= front_r < GRID_ROWS and 0 <= front_c < GRID_COLS and\n          initial_grid[front_r, front_c, primitive_id] > 0):\n          path_to_adjacent_and_facing_primitive = path_so_far\n          break # Shortest path to a 'USE'-ready position found.\n\n      # Explore possible next actions from the current state: Move, Turn Left, Turn Right.\n\n      # 1. Try Move Forward (corresponds to 'UP' action in CraftLab for movement)\n      next_r_move, next_c_move = current_r + DIR_TO_DRDC[current_dir][0], current_c + DIR_TO_DRDC[current_dir][1]\n      next_pos_move = (next_r_move, next_c_move)\n      next_dir_move = current_dir # Direction does not change when moving forward.\n\n      # Use the helper function to validate the next cell for movement.\n      if _is_valid_and_walkable(next_r_move, next_c_move):\n          if (next_pos_move, next_dir_move) not in visited:\n              visited.add((next_pos_move, next_dir_move))\n              queue.append(((next_pos_move, next_dir_move), path_so_far + [MOVE_FORWARD_ACTION]))\n\n      # 2. Try Turn Left ('LEFT' action)\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Position does not change when turning.\n      if (current_pos, next_dir_left) not in visited:\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_so_far + [TURN_LEFT_ACTION]))\n\n      # 3. Try Turn Right ('RIGHT' action)\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Position does not change when turning.\n      if (current_pos, next_dir_right) not in visited:\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_so_far + [TURN_RIGHT_ACTION]))\n\n  # After BFS completes:\n  # If a path was found to a state where the agent is adjacent and facing the primitive,\n  # append the 'USE' action to complete the collection process.\n  if path_to_adjacent_and_facing_primitive is not None:\n      actions_list.extend(path_to_adjacent_and_facing_primitive)\n      actions_list.append(USE_ACTION)\n\n  # Return the sequence of actions. This list will be empty if the primitive\n  # was not found, was unreachable, or was already in inventory (due to early exit).\n  return actions_list", "island_id": 7, "scores": {"3": 0.5}}
