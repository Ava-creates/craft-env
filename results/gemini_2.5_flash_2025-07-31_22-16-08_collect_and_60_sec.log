{"timestamp": "2025-08-01T00:09:13.305881", "function_name": "collect", "function_body": "  current_state = env._current_state\n  grid = current_state.grid\n  start_pos = current_state.pos\n\n  # Get the integer ID for the target primitive from the cookbook's index.\n  cookbook_index = env.world.cookbook.index\n  try:\n    primitive_idx = cookbook_index[primitive]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # Early exit: If the primitive is already in the agent's inventory, no collection is needed.\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # Early exit: If the primitive is not a grabbable item, it cannot be collected via 'USE' into inventory.\n  if primitive_idx not in env.world.grabbable_indices:\n    return []\n\n  # Get action mappings (e.g., 'DOWN': 0, 'UP': 1, 'USE': 4) from the environment.\n  action_map = env.action_specs()\n  \n  # Define movement directions as (dx, dy) tuples for grid coordinates.\n  # These correspond to the integer action IDs.\n  # Note: UP (0, -1), DOWN (0, 1), LEFT (-1, 0), RIGHT (1, 0) for (x, y) coordinates\n  # where y increases downwards.\n  moves = {\n      action_map['DOWN']: (0, 1),\n      action_map['UP']: (0, -1),\n      action_map['LEFT']: (-1, 0),\n      action_map['RIGHT']: (1, 0),\n  }\n\n  # Determine which grid cells are non-traversable (impassable obstacles).\n  # Non-grabbable items that are *not* workshops are considered blocking.\n  # Workshops (like BENCH) are non-grabbable but are places the agent can stand.\n  non_traversable_indices = set(env.world.non_grabbable_indices) - set(env.world.workshop_indices)\n  \n  grid_width, grid_height, _ = grid.shape\n\n  # Initialize Breadth-First Search (BFS) for pathfinding.\n  # The queue stores (current_position, list_of_actions_to_reach_this_position).\n  queue = collections.deque([(start_pos, [])])\n  # The visited set keeps track of positions already explored to prevent cycles and redundant work.\n  visited = {start_pos}\n\n  while queue:\n    current_pos, path_actions = queue.popleft()\n    cx, cy = current_pos\n\n    # 1. Check if the target primitive is within the 3x3 neighborhood of the current position.\n    # This simulates `CraftState.next_to(primitive_idx)`: if true, 'USE' can be performed.\n    is_adjacent_or_on_primitive = False\n    for dx_adj in range(-1, 2):  # Iterate through x-offsets (-1, 0, 1)\n      for dy_adj in range(-1, 2):  # Iterate through y-offsets (-1, 0, 1)\n        nx_adj, ny_adj = cx + dx_adj, cy + dy_adj\n        \n        # Check if the neighbor cell is within grid boundaries.\n        if 0 <= nx_adj < grid_width and 0 <= ny_adj < grid_height:\n          # Check if this neighbor cell contains the desired primitive.\n          if grid[nx_adj, ny_adj, primitive_idx] == 1:\n            is_adjacent_or_on_primitive = True\n            break # Primitive found in neighborhood, no need to check further.\n      if is_adjacent_or_on_primitive:\n        break # Break outer loop too if found.\n\n    if is_adjacent_or_on_primitive:\n      # If the primitive is within 'USE' range, append the 'USE' action and return the full path.\n      return path_actions + [action_map['USE']]\n\n    # 2. Explore valid, unvisited, and traversable neighboring positions.\n    for action_id, (dx_move, dy_move) in moves.items():\n      next_x, next_y = cx + dx_move, cy + dy_move\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is out of grid boundaries.\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue \n\n      # Check if the next position has already been visited in this BFS.\n      if next_pos in visited:\n        continue\n\n      # Check traversability: Determine if the agent can move into `next_pos`.\n      # A cell is blocked if it contains any 'kind' that is in our `non_traversable_indices`.\n      is_blocked = False\n      for kind_idx in non_traversable_indices:\n          if grid[next_x, next_y, kind_idx] == 1:\n              is_blocked = True\n              break\n      if is_blocked:\n        continue # Cannot move into a blocked cell.\n\n      # If the next position is traversable and unvisited, add it to the queue\n      # and mark it as visited.\n      visited.add(next_pos)\n      queue.append((next_pos, path_actions + [action_id]))\n\n  # If the BFS queue becomes empty and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the current state.\n  return []", "island_id": 1, "scores": {"3": 0.0}}
