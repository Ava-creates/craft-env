on]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 6, "scores": {"3": 1.0}}
{"timestamp": "2025-08-01T05:59:55.890051", "function_name": "collect", "function_body": "  \"\"\"Finds the shortest path and sequence of actions to collect a specified primitive\n  in the CraftWorld environment using Breadth-First Search (BFS).\n\n  Collection mechanisms:\n  1. Grabbable items (e.g., WOOD, IRON): Collected automatically by moving onto their cell.\n  2. Workshops (e.g., WORKSHOP0): Require moving onto their cell and then using ACTION_USE.\n  3. Adjacent-use primitives (e.g., STONE, WATER): Require being adjacent, facing the primitive,\n     and then using ACTION_USE.\n\n  Args:\n      env (env.CraftLab): The CraftLab environment instance.\n      primitive (str): The string name of the primitive to collect (e.g., \"WOOD\", \"STONE\").\n\n  Returns:\n      List[int]: A sequence of integer action codes (UP, DOWN, LEFT, RIGHT, USE)\n                 to collect the primitive. Returns an empty list if the primitive\n                 is unknown or unreachable.\n  \"\"\"\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # 1. Map the primitive name to its integer index using the cookbook.\n  try:\n    primitive_idx = env.world.cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not found, it's not a known item in this world.\n    return []\n\n  # 2. Get the current state of the environment.\n  current_state = env._current_state\n  agent_start_pos = current_state.pos  # (row, col)\n  agent_start_dir = current_state.dir  # 0=South, 1=North, 2=West, 3=East\n  world_grid = current_state.grid     # The full grid of the environment\n  GRID_ROWS, GRID_COLS, _ = world_grid.shape # Dimensions of the grid (HEIGHT, WIDTH, N_KINDS)\n\n  # 3. Determine the collection mechanism for the target primitive.\n  # These flags guide the pathfinding goal check and final action sequence.\n  is_grabbable_item = primitive_idx in env.world.grabbable_indices\n  is_workshop_location = primitive_idx in env.world.workshop_indices\n  # A primitive requiring adjacent + USE interaction (e.g., Stone, Water).\n  # These are non-grabbable AND NOT workshops.\n  is_adjacent_use_target = (\n      primitive_idx in env.world.non_grabbable_indices and\n      not is_workshop_location\n  )\n\n  # 4. Define movement parameters.\n  # Map movement actions to (delta_row, delta_col) and the resulting agent direction.\n  # Agent directions: 0=South, 1=North, 2=West, 3=East.\n  MOVE_ACTIONS_DATA = {\n      ACTION_UP: ((-1, 0), 1),    # Move North (row-1), face North (1)\n      ACTION_DOWN: ((1, 0), 0),   # Move South (row+1), face South (0)\n      ACTION_LEFT: ((0, -1), 2),  # Move West (col-1), face West (2)\n      ACTION_RIGHT: ((0, 1), 3)   # Move East (col+1), face East (3)\n  }\n\n  # Map agent direction to the (delta_row, delta_col) of the cell directly in front.\n  DIRECTION_TO_FORWARD_DELTA = {\n      0: (1, 0),  # Facing South: cell (r+1, c) is forward\n      1: (-1, 0), # Facing North: cell (r-1, c) is forward\n      2: (0, -1), # Facing West: cell (r, c-1) is forward\n      3: (0, 1)   # Facing East: cell (r, c+1) is forward\n  }\n\n  # 5. Helper functions for grid and state validation.\n  def _is_within_bounds(r: int, c: int) -> bool:\n      \"\"\"Checks if a given grid cell (r, c) is within the environment's boundaries.\"\"\"\n      return 0 <= r < GRID_ROWS and 0 <= c < GRID_COLS\n\n  def _is_walkable(r: int, c: int) -> bool:\n      \"\"\"\n      Determines if the agent can move onto cell (r, c).\n      A cell is walkable if it's within bounds and does not contain any impassable\n      non-grabbable entity, unless that entity is the target workshop.\n      \"\"\"\n      if not _is_within_bounds(r, c):\n          return False\n      \n      # Check all kinds that might be present at (r,c)\n      for k_idx in range(world_grid.shape[2]):\n          if world_grid[r, c, k_idx] > 0: # If there's an entity of kind k_idx at (r,c)\n              if k_idx in env.world.non_grabbable_indices:\n                  # This is a non-grabbable entity (like STONE, WATER, or a WORKSHOP).\n                  # Agent cannot walk onto it UNLESS it's the specific target primitive\n                  # AND that primitive is a workshop (which can be stood upon).\n                  if not (is_workshop_location and k_idx == primitive_idx):\n                      return False # This cell contains a non-walkable obstacle.\n      return True # No blocking obstacles found, cell is walkable.\n\n  def _is_goal_satisfied(curr_r: int, curr_c: int, curr_dir: int) -> bool:\n      \"\"\"\n      Checks if the agent, at (curr_r, curr_c) and facing curr_dir, is in a state\n      where the primitive can be collected.\n      \"\"\"\n      if is_grabbable_item:\n          # For grabbable items, merely being on the cell is enough.\n          return world_grid[curr_r, curr_c, primitive_idx] > 0\n      elif is_workshop_location:\n          # For workshops, being on the cell signifies readiness for 'USE' action.\n          return world_grid[curr_r, curr_c, primitive_idx] > 0\n      elif is_adjacent_use_target:\n          # For adjacent-use targets (e.g., Stone, Water), need to be adjacent and facing.\n          fwd_dr, fwd_dc = DIRECTION_TO_FORWARD_DELTA[curr_dir]\n          target_r, target_c = curr_r + fwd_dr, curr_c + fwd_dc\n          if _is_within_bounds(target_r, target_c) and world_grid[target_r, target_c, primitive_idx] > 0:\n              return True\n      return False\n\n  # 6. Breadth-First Search (BFS) for pathfinding.\n  # A state in BFS is defined by (agent_position (row, col), agent_direction).\n  # The queue stores: ((current_pos_tuple, current_dir_int), list_of_actions_taken_to_reach_here)\n  bfs_queue = collections.deque([((agent_start_pos, agent_start_dir), [])])\n  \n  # Set to keep track of visited states to prevent cycles and redundant exploration.\n  visited_states = {(agent_start_pos, agent_start_dir)}\n\n  shortest_path_actions = None # Will store the sequence of actions if a path is found.\n  \n  while bfs_queue:\n      (current_pos, current_dir), path_so_far = bfs_queue.popleft()\n      current_r, current_c = current_pos\n\n      # Check if the current state satisfies the collection goal.\n      if _is_goal_satisfied(current_r, current_c, current_dir):\n          shortest_path_actions = path_so_far\n          break # Found the shortest path to an actionable location.\n\n      # Explore all possible movement actions from the current state.\n      for action_val, (move_dr, move_dc), new_dir_val in MOVE_ACTIONS_DATA.values():\n          next_r, next_c = current_r + move_dr, current_c + move_dc\n          next_pos = (next_r, next_c)\n          next_state_key = (next_pos, new_dir_val)\n\n          # Add to queue only if the new position is walkable and this state hasn't been visited.\n          if _is_walkable(next_r, next_c) and next_state_key not in visited_states:\n              visited_states.add(next_state_key)\n              bfs_queue.append((next_state_key, path_so_far + [action_val]))\n  \n  # 7. Construct the final sequence of actions.\n  final_actions_list = []\n  if shortest_path_actions is not None:\n      final_actions_list = shortest_path_actions\n      # If the primitive is a workshop or requires adjacent-use, append the ACTION_USE.\n      # Grabbable items are collected merely by stepping onto their cell, no 'USE' needed.\n      if is_workshop_location or is_adjacent_use_target:\n          final_actions_list.append(ACTION_USE)\n  \n  return final_actions_list", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-08-01T05:59:57.095320", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Attempt to retrieve the integer index for the primitive string.\n  try:\n    primitive_idx = env.world.cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not found in the cookbook, it cannot be collected.\n    # Return an empty list of actions, indicating failure to find/collect.\n    return []\n\n  # Get the current state information directly from the environment.\n  current_state = env._current_state\n  agent_current_pos = current_state.pos  # Agent's current (row, col) position\n  agent_current_dir = current_state.dir  # Agent's current facing direction (0=South, 1=North, 2=West, 3=East)\n  global_grid = current_state.grid     # The full grid representation of the world\n  GRID_ROWS, GRID_COLS, _ = global_grid.shape # Dimensions of the grid (height, width, num_kinds)\n\n  # Categorize the primitive based on its collection mechanism.\n  # These flags help define the specific \"goal-ready\" state for the BFS.\n  is_grabbable_item = primitive_idx in env.world.grabbable_indices\n  is_workshop_location = primitive_idx in env.world.workshop_indices\n  \n  # Primitives that require the agent to be adjacent, facing them, and then using ACTION_USE.\n  # Examples: STONE, WATER. These are non-grabbable and explicitly not workshops.\n  is_adjacent_use_entity = (\n      primitive_idx in env.world.non_grabbable_indices and \n      not is_workshop_location\n  )\n\n  # Define how each movement action changes the agent's position (row_delta, col_delta)\n  # and its new facing direction.\n  # Mapping: Action Index -> ((row_delta, col_delta), new_direction_index)\n  MOVE_DELTAS_AND_NEW_DIRS = {\n      ACTION_UP: ((-1, 0), 1),    # Move UP (row decreases), new direction is North (1)\n      ACTION_DOWN: ((1, 0), 0),   # Move DOWN (row increases), new direction is South (0)\n      ACTION_LEFT: ((0, -1), 2),  # Move LEFT (col decreases), new direction is West (2)\n      ACTION_RIGHT: ((0, 1), 3)   # Move RIGHT (col increases), new direction is East (3)\n  }\n\n  # Maps the agent's direction to the (dr, dc) delta for the cell directly in front of the agent.\n  # This is crucial for checking `is_adjacent_use_entity` conditions.\n  DIRECTION_TO_FORWARD_DELTA = {\n      0: (1, 0),  # Facing South: cell (row+1, col) is in front\n      1: (-1, 0), # Facing North: cell (row-1, col) is in front\n      2: (0, -1), # Facing West: cell (row, col-1) is in front\n      3: (0, 1)   # Facing East: cell (row, col+1) is in front\n  }\n\n  def is_valid_grid_coord(r: int, c: int) -> bool:\n      \"\"\"Checks if a given grid cell (r, c) is within the environment boundaries.\"\"\"\n      return 0 <= r < GRID_ROWS and 0 <= c < GRID_COLS\n\n  def is_cell_walkable(r: int, c: int) -> bool:\n      \"\"\"\n      Checks if a given grid cell (r, c) is traversable by the agent.\n      A cell is considered walkable if it's within bounds and does not contain any entity\n      that acts as an impassable obstacle.\n      \"\"\"\n      if not is_valid_grid_coord(r, c):\n          return False\n      \n      # Iterate through all possible item kinds present at (r,c) to check for obstacles.\n      for k_idx in range(global_grid.shape[2]):\n          if global_grid[r, c, k_idx] > 0: # If an item of kind k_idx is present at (r,c)\n              if k_idx in env.world.non_grabbable_indices:\n                  # This is a non-grabbable entity (e.g., STONE, WATER, or a WORKSHOP).\n                  # Agent cannot generally walk onto these.\n                  # EXCEPTION: If the target primitive is a workshop, the agent *can* walk onto it.\n                  if not (is_workshop_location and k_idx == primitive_idx):\n                      return False # It's a blocking obstacle.\n      return True # If no blocking items are found, the cell is walkable.\n\n  # --- Breadth-First Search (BFS) for finding the shortest path ---\n  # The state in our BFS must include both the agent's position (r,c) and its direction.\n  # This is because the 'USE' action and specific collection types depend on orientation.\n  # The queue stores tuples: ((current_position (r,c), current_direction), list_of_actions_to_reach_here)\n  bfs_queue = collections.deque([((agent_current_pos, agent_current_dir), [])])\n  \n  # Visited set: Stores ((r,c), dir) tuples to avoid revisiting states and infinite loops,\n  # ensuring that the first path found is the shortest.\n  visited_states = {(agent_current_pos, agent_current_dir)}\n\n  shortest_action_path = None # This will store the sequence of actions once the target is found.\n  \n  while bfs_queue:\n      (current_pos, current_dir), path_to_current = bfs_queue.popleft()\n      current_r, current_c = current_pos\n\n      # Define a helper function to check if the agent is in a \"goal-ready\" state.\n      # This means the agent is positioned and oriented correctly to collect the primitive.\n      def is_goal_ready_state(r_check, c_check, dir_check):\n          if is_grabbable_item:\n              # For grabbable items, being on the cell with the item is the goal.\n              return global_grid[r_check, c_check, primitive_idx] > 0\n          elif is_workshop_location:\n              # For workshops, being on the workshop's cell is the goal (before using USE).\n              return global_grid[r_check, c_check, primitive_idx] > 0\n          elif is_adjacent_use_entity:\n              # For adjacent-use entities (e.g., STONE, WATER), need to be adjacent and facing it.\n              fwd_dr, fwd_dc = DIRECTION_TO_FORWARD_DELTA[dir_check]\n              target_r, target_c = r_check + fwd_dr, c_check + fwd_dc\n              if is_valid_grid_coord(target_r, target_c) and global_grid[target_r, target_c, primitive_idx] > 0:\n                  return True\n          return False\n\n      # Check if the current state satisfies the \"goal-ready\" condition.\n      if is_goal_ready_state(current_r, current_c, current_dir):\n          shortest_action_path = path_to_current\n          break # Shortest path to an actionable location for collection found.\n\n      # Explore valid neighboring states by applying all possible movement actions.\n      for action_val, (move_dr, move_dc), new_dir_val in MOVE_DELTAS_AND_NEW_DIRS.items():\n          next_r, next_c = current_r + move_dr, current_c + move_dc\n          next_pos_tuple = (next_r, next_c)\n          next_state_config = (next_pos_tuple, new_dir_val)\n\n          # Add the next state to the queue only if:\n          # 1. The calculated next position is walkable according to `is_cell_walkable`.\n          # 2. This specific (position, direction) state has not been visited yet in the BFS.\n          if is_cell_walkable(next_r, next_c) and next_state_config not in visited_states:\n              visited_states.add(next_state_config)\n              bfs_queue.append((next_state_config, path_to_current + [action_val]))\n  \n  # Construct the final list of actions to be returned.\n  final_actions_sequence = []\n  if shortest_action_path is not None:\n      final_actions_sequence = shortest_action_path\n      # If the primitive requires an explicit 'USE' action (workshops or adjacent-use entities),\n      # append it to the path after reaching the correct position and orientation.\n      # Grabbable primitives are implicitly collected by moving onto their cell.\n      if is_workshop_location or is_adjacent_use_entity:\n          final_actions_sequence.append(ACTION_USE)\n  \n  return final_actions_sequence", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-08-01T06:01:03.290867", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n\n  # Get the agent's initial position and direction, and a snapshot of the grid.\n  initial_agent_pos = current_state.pos  # (row, col) tuple\n  initial_agent_dir = current_state.dir  # Integer: 0 (Right), 1 (Up), 2 (Left), 3 (Down)\n  game_grid = current_state.grid         # numpy.ndarray (height, width, n_kinds)\n\n  # Retrieve the integer ID (index) for the target primitive from the game's item index.\n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  # Get grid dimensions for boundary checks during pathfinding.\n  grid_height, grid_width, _ = game_grid.shape\n\n  # Map symbolic action names (strings) to their integer codes for execution.\n  action_map = env.action_specs()\n  ACTION_MOVE_FORWARD = action_map['UP']    # In CraftWorld, 'UP' moves the agent forward.\n  ACTION_TURN_LEFT = action_map['LEFT']     # Rotates the agent counter-clockwise.\n  ACTION_TURN_RIGHT = action_map['RIGHT']   # Rotates the agent clockwise.\n  ACTION_USE = action_map['USE']            # Interacts with the entity in front.\n\n  # Define how agent's (row, col) coordinates change when moving forward, based on current direction.\n  # Directions: 0 (Right), 1 (Up), 2 (Left), 3 (Down).\n  DELTA_RC_BY_DIRECTION = {\n      0: (0, 1),   # Facing Right: moves to (row, col + 1)\n      1: (-1, 0),  # Facing Up:    moves to (row - 1, col)\n      2: (0, -1),  # Facing Left:  moves to (row, col - 1)\n      3: (1, 0)    # Facing Down:  moves to (row + 1, col)\n  }\n\n  # Define how agent's direction changes when turning left (counter-clockwise).\n  # Example: If current_dir is 0 (Right), new_dir is 1 (Up).\n  NEXT_DIR_AFTER_LEFT = {0: 1, 1: 2, 2: 3, 3: 0}\n\n  # Define how agent's direction changes when turning right (clockwise).\n  # Example: If current_dir is 0 (Right), new_dir is 3 (Down).\n  NEXT_DIR_AFTER_RIGHT = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # Get the set of entity indices that represent non-walkable terrain (e.g., boundaries, water).\n  # The agent cannot move into cells occupied by these entities.\n  impassable_entity_indices = current_state.world.non_grabbable_indices\n\n  # Helper function to check if a given cell (r, c) is a valid and traversable location for the agent.\n  # A cell is traversable if it's within grid bounds, not occupied by an impassable entity,\n  # and not occupied by the primitive itself (agent collects by being adjacent, not by stepping on it).\n  def _is_cell_traversable(r: int, c: int) -> bool:\n      # Check if coordinates are within the grid boundaries.\n      if not (0 <= r < grid_height and 0 <= c < grid_width):\n          return False\n      \n      # Check if the cell contains any entity that explicitly blocks agent movement.\n      for kind_idx in impassable_entity_indices:\n          if game_grid[r, c, kind_idx] > 0:\n              return False\n      \n      # The agent cannot move into the cell *occupied by* the primitive it wants to collect.\n      # It must be adjacent to it and use the 'USE' action.\n      if game_grid[r, c, primitive_id] > 0:\n          return False\n          \n      return True\n\n  # Initialize Breadth-First Search (BFS) for finding the shortest path.\n  # The BFS queue stores tuples: ((current_row, current_col, current_direction), list_of_actions_taken_to_reach_this_state).\n  bfs_queue = collections.deque([((initial_agent_pos[0], initial_agent_pos[1], initial_agent_dir), [])])\n  \n  # The 'visited' set keeps track of unique agent states (row, col, direction) that have already been explored.\n  # This prevents redundant searches and ensures the shortest path is found.\n  visited_states = {(initial_agent_pos[0], initial_agent_pos[1], initial_agent_dir)}\n\n  shortest_path_found = None # This will store the optimal action sequence to reach the pre-collection state.\n\n  # Start BFS traversal.\n  while bfs_queue:\n      (r, c, d), path_so_far = bfs_queue.popleft() # Get current state and path\n\n      # --- GOAL CHECK ---\n      # Determine if the target primitive is directly in front of the agent from the current state.\n      # This is the desired pre-collection state.\n      dr_front, dc_front = DELTA_RC_BY_DIRECTION[d]\n      front_r, front_c = r + dr_front, c + dc_front\n      \n      # Ensure the cell directly in front is within grid boundaries before checking its contents.\n      if (0 <= front_r < grid_height and 0 <= front_c < grid_width):\n          # If the primitive is present in the cell immediately in front, we've found our target path.\n          if game_grid[front_r, front_c, primitive_id] > 0:\n              shortest_path_found = path_so_far # Store the sequence of actions leading to this state.\n              break # Shortest path found, terminate the BFS loop.\n\n      # --- EXPLORE NEXT ACTIONS ---\n      # From the current state, try all possible valid actions (Move Forward, Turn Left, Turn Right).\n\n      # 1. Try Moving Forward (ACTION_MOVE_FORWARD):\n      # Calculate the next position if the agent moves forward. Direction remains unchanged.\n      next_r_move, next_c_move = r + DELTA_RC_BY_DIRECTION[d][0], c + DELTA_RC_BY_DIRECTION[d][1]\n      next_d_move = d \n      next_state_move = (next_r_move, next_c_move, next_d_move)\n\n      # If the next cell is traversable and this (position, direction) state hasn't been visited,\n      # add it to the queue for future exploration.\n      if _is_cell_traversable(next_r_move, next_c_move) and next_state_move not in visited_states:\n          visited_states.add(next_state_move) # Mark as visited.\n          bfs_queue.append((next_state_move, path_so_far + [ACTION_MOVE_FORWARD]))\n\n      # 2. Try Turning Left (ACTION_TURN_LEFT):\n      # Calculate the new direction after turning left. Position remains unchanged.\n      next_d_left = NEXT_DIR_AFTER_LEFT[d]\n      next_state_left = (r, c, next_d_left) # Position (r,c) is unchanged.\n\n      # If this new state (same position, new direction) has not been visited, add it to the queue.\n      if next_state_left not in visited_states:\n          visited_states.add(next_state_left) # Mark as visited.\n          bfs_queue.append((next_state_left, path_so_far + [ACTION_TURN_LEFT]))\n\n      # 3. Try Turning Right (ACTION_TURN_RIGHT):\n      # Calculate the new direction after turning right. Position remains unchanged.\n      next_d_right = NEXT_DIR_AFTER_RIGHT[d]\n      next_state_right = (r, c, next_d_right) # Position (r,c) is unchanged.\n\n      # If this new state has not been visited, add it to the queue.\n      if next_state_right not in visited_states:\n          visited_states.add(next_state_right) # Mark as visited.\n          bfs_queue.append((next_state_right, path_so_far + [ACTION_TURN_RIGHT]))\n\n  # After BFS completes:\n  # If a path to the target pre-collection state was found (i.e., shortest_path_found is not None),\n  # append the final 'USE' action to complete the collection process.\n  if shortest_path_found is not None:\n      actions_list.extend(shortest_path_found)\n      actions_list.append(ACTION_USE) # Add the crucial 'USE' action.\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
