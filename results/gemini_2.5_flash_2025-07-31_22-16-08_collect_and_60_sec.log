{"timestamp": "2025-08-01T08:30:21.664308", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` using Breadth-First Search (BFS) for pathfinding.\n    \n    This function computes the shortest sequence of actions (moves and turns)\n    required to navigate the agent to a position adjacent to the specified\n    primitive, face it, and then perform a 'USE' action to collect it.\n    It considers walkable terrain and avoids obstacles.\n\n    Args:\n        env (env.CraftLab): The CraftLab object representing the current state of the environment.\n        primitive (str): The string name of the primitive resource or object to collect\n                         (e.g., \"WOOD\", \"WORKSHOP0\", \"STONE\").\n\n    Returns:\n        List[int]: A sequence of integer action IDs (as defined by env.action_specs())\n                   to execute. Returns an empty list if the primitive is not found\n                   in the environment or is unreachable.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state\n  grid = current_state.grid # The current grid layout (numpy.ndarray: WIDTH x HEIGHT x n_kinds)\n  initial_pos = current_state.pos # Agent's current position (row, col)\n  initial_dir = current_state.dir # Agent's current facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook's index.\n  # If the primitive name is not recognized, return an empty list as it cannot be collected.\n  try:\n    primitive_id = current_state.world.cookbook.index[primitive]\n  except KeyError:\n    return []\n\n  # Extract grid dimensions for boundary checks\n  GRID_WIDTH, GRID_HEIGHT = grid.shape[0], grid.shape[1]\n\n  # Map DSL movement/turn actions to their integer indices from CraftLab's action_specs.\n  action_map = env.action_specs()\n  ACTION_MOVE_FORWARD = action_map['UP'] # Assuming 'UP' corresponds to moving forward\n  ACTION_TURN_LEFT = action_map['LEFT']\n  ACTION_TURN_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE'] # Action to interact with an object in front of the agent\n\n  # Direction mapping: (dr, dc) tuple for change in row and column for each cardinal direction.\n  # This is used to calculate the cell in front of the agent or the next position after moving.\n  # 0:RIGHT (+col), 1:UP (-row), 2:LEFT (-col), 3:DOWN (+row)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # Maps for updating the agent's direction after a turn (clockwise rotation order for clarity).\n  # A LEFT turn moves direction counter-clockwise (e.g., RIGHT(0) -> UP(1)).\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0} # R(0)->U(1)->L(2)->D(3)->R(0)\n  # A RIGHT turn moves direction clockwise (e.g., RIGHT(0) -> DOWN(3)).\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # R(0)->D(3)->L(2)->U(1)->R(0)\n\n  # Get indices of entities that block agent movement. These are typically non-grabbable\n  # entities like boundaries, water, or workshop stations, which the agent cannot walk onto.\n  non_walkable_indices = current_state.world.non_grabbable_indices\n\n  # Helper function to check if a given cell (r, c) is within bounds and free of obstacles.\n  def is_cell_valid_and_walkable(r_coord, c_coord):\n    # 1. Check if the cell coordinates are within the grid boundaries.\n    if not (0 <= r_coord < GRID_WIDTH and 0 <= c_coord < GRID_HEIGHT):\n      return False\n\n    # 2. Check if the cell contains any non-grabbable entity that blocks movement.\n    # This ensures the agent does not try to move onto walls, water, or fixed structures.\n    for kind_idx in non_walkable_indices:\n      if grid[r_coord, c_coord, kind_idx] > 0:\n        return False\n\n    # 3. Crucially, the agent cannot walk directly *onto* the primitive it intends to collect.\n    # The 'USE' action is performed from an adjacent cell.\n    if grid[r_coord, c_coord, primitive_id] > 0:\n      return False\n    \n    return True\n\n  # Initialize Breadth-First Search (BFS) structures.\n  # The queue stores tuples: ( (current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_here ).\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # The visited set stores (position_tuple, direction_int) to prevent redundant exploration\n  # and infinite loops by revisiting states already processed with a shorter or equal path.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # This will store the shortest action sequence once the goal is found.\n\n  # Begin BFS traversal\n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      r, c = current_pos # Unpack current position\n\n      # --- Goal Check ---\n      # Check if the target primitive is directly in front of the agent at the current state.\n      # This is the desired state from which the 'USE' action can be executed.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Verify the cell in front is within bounds and contains the target primitive.\n      if (0 <= front_r < GRID_WIDTH and 0 <= front_c < GRID_HEIGHT) and\\\n         (grid[front_r, front_c, primitive_id] > 0):\n          target_path_actions = path_so_far # Found the path to be adjacent and facing the primitive.\n          break # Exit BFS, as we found the shortest path.\n\n      # --- Explore Possible Next Actions ---\n      # From the current state, explore moving forward, turning left, and turning right.\n\n      # 1. Try Moving Forward\n      next_r_move, next_c_move = r + DIR_TO_DRDC[current_dir][0], c + DIR_TO_DRDC[current_dir][1]\n      next_pos_move = (next_r_move, next_c_move)\n      next_dir_move = current_dir # Direction remains unchanged after moving forward.\n\n      # If the next position is valid, walkable, and this (pos,dir) state hasn't been visited:\n      if is_cell_valid_and_walkable(next_r_move, next_c_move):\n          if (next_pos_move, next_dir_move) not in visited:\n              visited.add((next_pos_move, next_dir_move))\n              queue.append(((next_pos_move, next_dir_move), path_so_far + [ACTION_MOVE_FORWARD]))\n\n      # 2. Try Turning Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change the agent's position, only its direction.\n      if (current_pos, next_dir_left) not in visited:\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_so_far + [ACTION_TURN_LEFT]))\n\n      # 3. Try Turning Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change the agent's position, only its direction.\n      if (current_pos, next_dir_right) not in visited:\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_so_far + [ACTION_TURN_RIGHT]))\n\n  # After BFS completes, if a path to the target (adjacent and facing the primitive) was found,\n  # append the final 'USE' action to complete the collection.\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(ACTION_USE)\n\n  return actions_list", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T08:31:27.326977", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n\n  This function uses a Breadth-First Search (BFS) to find the shortest\n  sequence of actions (movement and turns) to bring the agent adjacent\n  to the specified primitive, facing it, and then appends a 'USE' action.\n\n  Args:\n      env (env.CraftLab): The CraftLab object representing the current environment.\n      primitive (str): The string name of the primitive resource to collect.\n\n  Returns:\n      List[int]: A sequence of action indices to execute to collect the primitive.\n                 Returns an empty list if the primitive is already in inventory or unreachable.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's current (row, column) tuple\n  initial_dir = current_state.dir # Agent's current facing direction (0:Right, 1:Up, 2:Left, 3:Down)\n\n  # Get the integer ID for the target primitive from the cookbook index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # === Improvement: Early exit if primitive is already in inventory ===\n  if current_state.inventory[primitive_id] > 0:\n      return []\n\n  # Map symbolic actions from action_specs to their integer indices\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define changes in (row, col) for each direction (0:R, 1:U, 2:L, 3:D)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: +1 to column (x)\n      1: (-1, 0),  # Facing UP: -1 to row (y)\n      2: (0, -1),  # Facing LEFT: -1 to column (x)\n      3: (1, 0)    # Facing DOWN: +1 to row (y)\n  }\n\n  # Define how direction changes when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # Get indices of entities that block agent movement (non-walkable terrain/objects)\n  # The primitive itself is typically not walkable, as the agent stands adjacent to collect it.\n  # Convert to a set for O(1) average time complexity for 'in' checks.\n  non_walkable_for_movement = set(current_state.world.non_grabbable_indices)\n  non_walkable_for_movement.add(primitive_id)\n\n\n  # BFS state: ((current_row, current_col), current_direction_int)\n  # Queue stores (state, list_of_actions_to_reach_this_state)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (state) to avoid redundant computations and cycles\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the action sequence leading to the state\n                      # where the agent is adjacent to the primitive and facing it.\n\n  # Helper function to check if a cell is walkable\n  def _is_cell_walkable(r, c, grid, non_walkable_indices_set):\n      \"\"\"Checks if the cell at (r, c) is within bounds and doesn't contain non-walkable items.\"\"\"\n      if not (0 <= r < WIDTH and 0 <= c < HEIGHT):\n          return False # Out of bounds\n      \n      # Check if any non-walkable item exists in this cell\n      for kind_idx in non_walkable_indices_set:\n          if grid[r, c, kind_idx] > 0:\n              return False # Contains a non-walkable item\n      return True\n\n  while queue:\n      (current_pos, current_dir), path_to_current_state = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent at current state\n      # Calculate the coordinates of the cell directly in front of the agent\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the cell in front is within grid bounds AND contains the primitive\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT and\n          initial_grid[front_r, front_c, primitive_id] > 0):\n          \n          target_path = path_to_current_state\n          break # Found the path to be adjacent and facing the primitive\n\n      # 2. Explore possible next actions from the current state (Move Forward, Turn Left, Turn Right)\n      \n      # Try Move Forward (equivalent to 'UP' in action_specs for movement)\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if the next position is valid and has not been visited with this direction\n      if (next_pos, next_dir) not in visited:\n          # Use the helper to check walkability, passing the set of non-walkable kinds\n          if _is_cell_walkable(next_r, next_c, initial_grid, non_walkable_for_movement):\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_to_current_state + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_to_current_state + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_to_current_state + [TURN_RIGHT_ACTION]))\n\n  # If a path was found to reach an adjacent and facing position, append the USE action\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 1, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T08:31:28.601075", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` using parent pointers for path reconstruction.\n\n  This function uses a Breadth-First Search (BFS) to find the shortest\n  sequence of actions (movement and turns) to bring the agent adjacent\n  to the specified primitive, facing it, and then appends a 'USE' action.\n  It reconstructs the path efficiently using parent pointers, which can be\n  more memory-efficient for long paths compared to storing full path lists\n  in the queue.\n\n  Args:\n      env (env.CraftLab): The CraftLab object representing the current environment.\n      primitive (str): The string name of the primitive resource to collect.\n\n  Returns:\n      List[int]: A sequence of action indices to execute to collect the primitive.\n                 Returns an empty list if the primitive is already in inventory\n                 or is unreachable.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state\n\n  # Retrieve essential information from the current environment state\n  # Get the unique integer ID for the target primitive from the cookbook's index.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's current (row, column) tuple\n  initial_dir = current_state.dir # Agent's current facing direction (0:Right, 1:Up, 2:Left, 3:Down)\n\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # Early exit: If the agent already possesses the primitive in its inventory, no actions are needed.\n  if current_state.inventory[primitive_id] > 0:\n      return []\n\n  # Map symbolic actions to their integer indices from the environment's action_specs.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define changes in (row, col) based on agent's current direction.\n  # This helps calculate the cell directly in front of the agent or the next position when moving.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: +1 to column (x-axis)\n      1: (-1, 0),  # Facing UP: -1 to row (y-axis)\n      2: (0, -1),  # Facing LEFT: -1 to column (x-axis)\n      3: (1, 0)    # Facing DOWN: +1 to row (y-axis)\n  }\n\n  # Define how agent's direction changes when turning.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Define which entity kinds block agent movement into a cell.\n  # This includes all non-grabbable items (e.g., boundaries, water, workshops).\n  # Crucially, it also includes the 'primitive_id' itself if it's a collectible\n  # resource (e.g., WOOD, STONE, IRON), because the agent needs to be *adjacent*\n  # to such resources to 'USE' them, not standing directly on them.\n  non_walkable_for_movement = set(current_state.world.non_grabbable_indices)\n  non_walkable_for_movement.add(primitive_id)\n\n  # BFS state: ((row, col), direction_int)\n  # `queue`: stores states to visit (just the state tuple).\n  # `visited`: stores states that have been enqueued, to prevent cycles and redundant work.\n  # `parent`: stores (current_state) -> (previous_state, action_taken_to_reach_current_state).\n  # This allows efficient path reconstruction by backtracking from the target state.\n  queue = collections.deque([((initial_pos, initial_dir))])\n  visited = {(initial_pos, initial_dir)}\n  parent = {} # Maps (state) -> ((parent_state), action_from_parent_to_state)\n\n  target_state_found = None # This will store the final state from which USE action should be performed.\n\n  # Helper function to check if a cell is within bounds and walkable.\n  def _is_cell_walkable(r, c, grid, non_walkable_indices_set):\n      \"\"\"Checks if the cell at (r, c) is within grid bounds and does not contain non-walkable items.\"\"\"\n      if not (0 <= r < WIDTH and 0 <= c < HEIGHT):\n          return False # Out of bounds\n      for kind_idx in non_walkable_indices_set:\n          if grid[r, c, kind_idx] > 0:\n              return False # Contains a non-walkable item\n      return True\n\n  # Start the BFS loop to find the shortest path to a cell adjacent to the primitive.\n  while queue:\n      current_pos_dir = queue.popleft() # Current state: ((row, col), direction)\n      current_pos, current_dir = current_pos_dir\n      r, c = current_pos\n\n      # 1. Goal Check: Determine if the target primitive is directly in front of the agent.\n      # Calculate the coordinates of the cell that the agent is currently facing.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the 'front' cell is within the grid boundaries AND contains the primitive.\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT and\n          initial_grid[front_r, front_c, primitive_id] > 0):\n          \n          target_state_found = current_pos_dir # Store this state as the goal was met.\n          break # Exit BFS, as we've found the shortest path to an actionable state.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n      \n      # --- Try Move Forward action ---\n      # Calculate the agent's new position if it moves one step forward.\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir_move = current_dir # Moving forward does not change the agent's facing direction.\n\n      next_state_move = (next_pos, next_dir_move)\n      # Check if this specific (position, direction) state has been visited before.\n      if next_state_move not in visited:\n          # Check if the next position is walkable.\n          if _is_cell_walkable(next_r, next_c, initial_grid, non_walkable_for_movement):\n              visited.add(next_state_move) # Mark this state as visited.\n              queue.append(next_state_move) # Add the new state to the queue.\n              parent[next_state_move] = (current_pos_dir, MOVE_FORWARD_ACTION) # Store parent and action.\n\n      # --- Try Turn Left action ---\n      # Calculate the new direction after turning left. The agent's position remains unchanged.\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      next_state_left = (current_pos, next_dir_left) # Position unchanged.\n      # Check if this (current_position, new_direction) state has been visited.\n      if next_state_left not in visited:\n          visited.add(next_state_left) # Mark as visited.\n          queue.append(next_state_left) # Add the new state to the queue.\n          parent[next_state_left] = (current_pos_dir, TURN_LEFT_ACTION) # Store parent and action.\n\n      # --- Try Turn Right action ---\n      # Calculate the new direction after turning right. The agent's position remains unchanged.\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      next_state_right = (current_pos, next_dir_right) # Position unchanged.\n      # Check if this (current_position, new_direction) state has been visited.\n      if next_state_right not in visited:\n          visited.add(next_state_right) # Mark as visited.\n          queue.append(next_state_right) # Add the new state to the queue.\n          parent[next_state_right] = (current_pos_dir, TURN_RIGHT_ACTION) # Store parent and action.\n\n  # Path Reconstruction:\n  # If a path was found (i.e., target_state_found is not None), reconstruct the path.\n  if target_state_found is not None:\n      path_actions = []\n      current_reconstruction_state = target_state_found\n      # Backtrack from the target state to the initial state using the 'parent' dictionary.\n      while current_reconstruction_state != (initial_pos, initial_dir):\n          # This check guards against unexpected states not found in parent, though\n          # for a correctly implemented BFS, all reachable states should have a parent.\n          if current_reconstruction_state not in parent:\n              path_actions = [] # Clear actions, indicating a path reconstruction issue.\n              break\n          \n          prev_state, action = parent[current_reconstruction_state]\n          path_actions.append(action) # Add the action that led to the current state.\n          current_reconstruction_state = prev_state # Move to the previous state.\n      \n      # The path is built in reverse chronological order (from target back to start),\n      # so reverse it to get the correct sequence of actions from start to target.\n      path_actions.reverse()\n      actions_list.extend(path_actions)\n      actions_list.append(USE_ACTION) # Append the final 'USE' action to collect the primitive.\n\n  # Return the sequence of actions. If no path was found, actions_list will be empty.\n  return actions_list", "island_id": 1, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T08:32:41.716896", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # --- Improvement for V2: Removed the restrictive `is_collectible_via_use` check. ---\n  # This allows the BFS to explore paths where a primitive might be obtained by\n  # interacting with an *environmental object* (e.g., harvesting wood from a tree),\n  # even if the primitive itself is not directly grabbable or a special case like water/stone.\n  # The general `USE_ACT` exploration within the BFS, combined with the\n  # inventory increase check, is now solely responsible for determining collectibility.\n  # This means the algorithm will try to find a way to \"use\" something to get the primitive,\n  # rather than filtering out primitives based on a simplified \"direct collectibility\" rule.\n\n  # 3. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n\n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n\n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 4. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set includes the agent's inventory as part of the state key.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing.\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Increased MAX_EXPLORED_STATES due to the larger state space when tracking inventory.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10\n  explored_states_count = 0\n\n  # 5. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n\n    # Goal Check 1: Check if the primitive is directly under the agent's feet and is grabbable.\n    # This applies to items that can be picked up by standing on them and using USE.\n    if i_kind in world.grabbable_indices and state.grid[current_r, current_c, i_kind] == 1:\n        inventory_before_use_on_self = np.copy(state.inventory)\n        _, state_after_use_on_self = state.step(USE_ACT)\n        # Verify successful collection: inventory count of i_kind increased.\n        if state_after_use_on_self.inventory[i_kind] > inventory_before_use_on_self[i_kind]:\n            return path + [USE_ACT] # Collected by using at current position\n\n    # Goal Check 2: Check for primitive in adjacent cells (cardinal directions) that can be interacted with.\n    # This covers cases like harvesting resources (e.g., water, stone, or wood from a tree), or\n    # picking up items that are next to the agent.\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Ensure facing cell is within grid bounds and contains the target primitive\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and\n                state.grid[facing_r, facing_c, i_kind] == 1):\n\n                # Simulate the turning actions to face the primitive.\n                temp_state_after_turns = state\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action on the cell in front.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`).\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n\n    # Explore the USE action from the current position generally.\n    # This is crucial for collecting items indirectly (e.g., harvesting wood from a tree),\n    # or picking up intermediate tools, or interacting with workshops.\n    # The `state.step(USE_ACT)` handles the complex game logic for what happens.\n    # This block applies a heuristic to only explore USE when an \"interesting\" object\n    # is at the agent's current position or in front of the agent.\n    do_general_use_exploration = False\n\n    # Check if agent is currently on a grabbable item (it could be the target or a tool).\n    item_at_pos_idx_flat = np.where(state.grid[current_r, current_c, :] == 1)[0]\n    if item_at_pos_idx_flat.size > 0:\n        item_at_pos_idx = item_at_pos_idx_flat[0]\n        if item_at_pos_idx in world.grabbable_indices:\n            do_general_use_exploration = True\n\n    # Check if agent is facing a workshop, a grabbable item, or another primitive resource.\n    # Interacting with workshops, picking up tools, or harvesting resources (like trees for wood)\n    # are key scenarios covered here.\n    dr, dc = _DIR_TO_DELTA_FRONT[current_dir]\n    facing_r, facing_c = current_r + dr, current_c + dc\n\n    if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height):\n        item_in_front_idx_flat = np.where(state.grid[facing_r, facing_c, :] == 1)[0]\n        if item_in_front_idx_flat.size > 0:\n            item_in_front_idx = item_in_front_idx_flat[0]\n            if (item_in_front_idx in world.grabbable_indices or\n                item_in_front_idx in world.workshop_indices or\n                item_in_front_idx in world.cookbook.primitives): # Check if facing any known primitive resource\n                do_general_use_exploration = True\n\n    if do_general_use_exploration:\n        inventory_before_any_use = np.copy(state.inventory)\n        _, state_after_current_use = state.step(USE_ACT)\n\n        # Only add to queue if the USE action resulted in a meaningful state change.\n        # This prevents adding redundant states to the queue if USE had no effect.\n        if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n                state_after_current_use.pos == state.pos and\n                state_after_current_use.dir == state.dir):\n\n            next_inventory_tuple = tuple(state_after_current_use.inventory)\n            next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n            if next_state_key not in visited:\n                visited.add(next_state_key)\n                q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 6. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T08:32:43.329978", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` by removing the restrictive is_collectible_via_use check and\n  adopting a more general BFS exploration of the USE action, relying on `CraftState.step` to\n  correctly model all interactions that can lead to collection.\"\"\"\n  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory at the very beginning.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Define action integers for all possible actions.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  all_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT, USE_ACT]\n\n  # 4. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set stores a tuple representing the agent's full state (position, direction, inventory).\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing in the set.\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, [])) # Queue stores (CraftState object, path_to_reach_this_state: list of action integers)\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  # Heuristic limit to prevent excessively long searches in complex state spaces.\n  # This typically covers grid dimensions, agent directions, and a limited number of inventory variations.\n  grid_width, grid_height, _ = current_state.grid.shape\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 20 # Increased factor for more inventory variations\n  explored_states_count = 0\n\n  # 5. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    # We continue the loop rather than breaking, allowing other branches to complete if the goal\n    # is still reachable through them, but prioritizing breadth-first search.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    # --- GOAL CHECK ---\n    # If the target primitive is now in the agent's inventory, we have found a path.\n    # This check is crucial and is performed as soon as a state is dequeued.\n    if state.inventory[i_kind] > 0:\n        return path # Goal achieved! Return the sequence of actions that led to this state.\n\n    # --- EXPLORE ACTIONS ---\n    # For each possible action, simulate its effect and add the resulting new state to the queue if unvisited.\n    for action in all_actions:\n      # Simulate the action. `state.step` returns (reward, new_state).\n      # The reward is not used here, as we are only concerned with state transitions.\n      _, next_state = state.step(action)\n\n      # Construct a unique key for the next state to check against the 'visited' set.\n      # This key must capture all relevant aspects of the state that determine reachability,\n      # specifically position, direction, and inventory.\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      # If this next state has not been visited before, add it to the queue and mark as visited.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n\n  # 6. If the BFS queue is exhausted and the goal was never reached,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T08:33:57.263762", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n  Returns a list of actions to find and collect the specified primitive in the environment.\n  This function uses a Breadth-First Search (BFS) to find the shortest path\n  to a location adjacent to the primitive, then issues a 'USE' action.\n  It handles cases where the primitive is already in inventory, immediately adjacent,\n  unreachable, or non-grabbable.\n\n  Args:\n      env (env.CraftLab): The CraftLab object representing the current simulation environment.\n      primitive (str): The string name of the primitive item to collect (e.g., \"WOOD\", \"STONE\").\n\n  Returns:\n      List[int]: A sequence of action indices (integers) to execute. Returns an empty list\n                 if the primitive is already collected, is not a grabbable item, or is unreachable.\n  \"\"\"\n  current_state = env._current_state\n  \n  # --- Step 1: Initialize essential information ---\n  # Get the unique integer ID for the primitive from the world's internal index.\n  # This mapping is crucial for interacting with the grid and inventory arrays.\n  primitive_idx = env.world.cookbook.index.index(primitive)\n  \n  # Retrieve integer IDs for standard actions from the environment's action specifications.\n  # This makes the code more readable and robust against changes in action ID assignments.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # --- Step 2: Pre-check for collection feasibility and necessity ---\n\n  # Check 2.1: If the agent already possesses the primitive in its inventory,\n  # there's no need to collect it again. Return an empty list of actions.\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # Check 2.2: Verify if the primitive is actually a 'grabbable' item.\n  # Some \"primitives\" in the DSL (e.g., BOUNDARY, WATER, WORKSHOP) might not be collectible\n  # in the sense of being added to inventory. If it's not grabbable, return an empty list.\n  if primitive_idx not in env.world.grabbable_indices:\n      # This handles cases where `collect` is called for non-grabbable environment features.\n      # The `USE` action might still apply (e.g., using a workshop), but 'collect' implies acquisition.\n      return []\n\n  # Check 2.3: Immediate collection if already adjacent.\n  # If the agent's current position allows direct interaction with the primitive\n  # (i.e., the primitive is within the 3x3 area around the agent, including the agent's cell),\n  # then the most efficient action is simply to 'USE' it.\n  if current_state.next_to(primitive_idx):\n    return [USE]\n\n  # --- Step 3: Locate all occurrences of the primitive on the grid ---\n  # We need to know where the primitive exists to target it.\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  # List to store (x, y) coordinates of all cells containing the primitive.\n  primitive_locations = []\n  for x in range(grid_width):\n    for y in range(grid_height):\n      if grid[x, y, primitive_idx] > 0: # If the primitive kind's count is > 0 at this cell\n        primitive_locations.append((x, y))\n\n  # If the primitive isn't found anywhere on the grid, it's currently unreachable.\n  if not primitive_locations:\n    return []\n\n  # --- Step 4: Define \"goal cells\" for pathfinding ---\n  # A \"goal cell\" is any grid position from which the agent can successfully perform\n  # the 'USE' action on the target primitive. Since `CraftState.next_to` checks\n  # the 3x3 neighborhood, any cell in the 3x3 vicinity of a primitive location\n  # (including the primitive's own cell if traversable) is a valid goal.\n  goal_cells = set()\n  for px, py in primitive_locations:\n    # Iterate through the 3x3 neighborhood around each primitive location.\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        gx, gy = px + dx, py + dy # Candidate goal cell coordinates.\n        # Ensure the candidate goal cell is within the grid boundaries.\n        if 0 <= gx < grid_width and 0 <= gy < grid_height:\n          goal_cells.add((gx, gy))\n\n  # --- Step 5: Identify impassable terrain for BFS ---\n  # These are entity kinds that block agent movement.\n  # By default, non-grabbable items are considered impassable, but workshops are typically traversable.\n  impassable_kinds = set(env.world.non_grabbable_indices) - set(env.world.workshop_indices)\n\n  # --- Step 6: Perform Breadth-First Search (BFS) to find the shortest path ---\n  # BFS is used because it guarantees finding the shortest path in an unweighted grid graph.\n  start_pos = current_state.pos # Agent's current (x, y) position.\n  \n  # The queue for BFS: stores (current_position (tuple), list_of_actions_taken_to_reach_here).\n  q = collections.deque([(start_pos, [])]) \n  # Set to keep track of visited positions to avoid cycles and redundant exploration.\n  visited = {start_pos} \n\n  # Define possible cardinal movements (delta_x, delta_y) and their corresponding actions.\n  # These are the only allowed moves in this environment for pathfinding.\n  MOVE_ACTIONS = [\n      ((0, -1), UP),    # Move North (decrease Y-coordinate)\n      ((0, 1), DOWN),   # Move South (increase Y-coordinate)\n      ((-1, 0), LEFT),  # Move West (decrease X-coordinate)\n      ((1, 0), RIGHT),  # Move East (increase X-coordinate)\n  ]\n\n  while q:\n    # Dequeue the current position and the path leading to it.\n    (cx, cy), path_so_far = q.popleft()\n\n    # If the current position is one of our goal cells, a path to collect the primitive is found.\n    if (cx, cy) in goal_cells:\n      # Append the 'USE' action as the final step after reaching the goal proximity.\n      return path_so_far + [USE]\n\n    # Explore all valid neighboring cells (up, down, left, right).\n    for (dx, dy), action_to_take in MOVE_ACTIONS:\n      nx, ny = cx + dx, cy + dy # Calculate the new potential position.\n      new_pos = (nx, ny)\n\n      # Check 6.1: Ensure the new position is within the grid boundaries.\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue # Skip if out of bounds.\n\n      # Check 6.2: Determine if the new position is traversable.\n      # A cell is traversable if it does not contain any impassable kind.\n      is_traversable = True\n      for k_idx in impassable_kinds:\n          if grid[nx, ny, k_idx] > 0:\n              is_traversable = False\n              break # Found an impassable item, this cell cannot be entered.\n      \n      if not is_traversable:\n          continue # Skip if the cell is impassable.\n\n      # Check 6.3: If the new position has not been visited, add it to the queue.\n      if new_pos not in visited:\n        visited.add(new_pos)\n        q.append((new_pos, path_so_far + [action_to_take]))\n\n  # --- Step 7: No path found ---\n  # If the BFS queue becomes empty and no goal cell was reached, it implies\n  # that the primitive is currently unreachable from the agent's position.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T08:33:58.511708", "function_name": "collect", "function_body": "  current_state = env._current_state\n  \n  # Get the integer index for the desired primitive.\n  # The `Index.index` method will create a new index if the item is not yet known,\n  # ensuring `primitive_idx` is always a valid integer ID.\n  primitive_idx = env.world.cookbook.index.index(primitive)\n  \n  # --- Improvement for v2: Ensure the primitive is actually grabbable. ---\n  # A `collect` action is only meaningful for items that can be picked up.\n  # If the `primitive_idx` is not among the `grabbable_indices` defined by the world,\n  # then this primitive cannot be collected, and we should return an empty action list.\n  if primitive_idx not in env.world.grabbable_indices:\n    return [] # This primitive is not grabbable, no actions to collect it.\n\n  # --- Check if the primitive is already collected (improvement carried over from v1) ---\n  # If the agent's inventory already contains at least one unit of the primitive,\n  # there's no need to perform any actions to collect it.\n  if current_state.inventory[primitive_idx] > 0:\n    return [] # Already have the primitive, so return an empty list.\n\n  # Retrieve action mappings from the environment's action specifications.\n  # This makes the code more readable and robust against changes in action integer IDs.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # 1. Immediate collection check:\n  # Check if the agent is currently in a position (within its 3x3 neighborhood)\n  # from which it can directly interact with (use/collect) the primitive.\n  if current_state.next_to(primitive_idx):\n    # If so, the most efficient action is simply to 'USE' it.\n    return [USE]\n\n  # 2. Locate all occurrences of the primitive on the grid.\n  # This step identifies all potential physical locations of the primitive in the environment.\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  primitive_locations = [] # List to store (x, y) coordinates of primitive instances.\n  for x in range(grid_width):\n    for y in range(grid_height):\n      # A primitive is present at (x, y) if its count at that specific index is greater than 0.\n      if grid[x, y, primitive_idx] > 0:\n        primitive_locations.append((x, y))\n\n  # If no instances of the primitive are found anywhere on the grid, it's unreachable.\n  if not primitive_locations:\n    return []\n\n  # 3. Define \"goal cells\" for the Breadth-First Search (BFS).\n  # A goal cell is any grid position from which the agent can successfully `USE` the primitive.\n  # Given that `CraftState.next_to` checks the 3x3 neighborhood, any cell in the 3x3\n  # vicinity (including the primitive's own cell) of a primitive's location is a valid goal.\n  goal_cells = set()\n  for px, py in primitive_locations:\n    # Iterate through the 3x3 grid centered around the primitive's location.\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        gx, gy = px + dx, py + dy # Calculate the coordinates of a potential goal cell.\n        # Ensure the potential goal cell is within the overall grid boundaries.\n        if 0 <= gx < grid_width and 0 <= gy < grid_height:\n          goal_cells.add((gx, gy))\n\n  # 4. Determine which entity kinds constitute impassable terrain for agent movement.\n  # Impassable items are generally non-grabbable entities, but workshops are specifically\n  # excluded as they are often traversable (even if non-grabbable).\n  # Converting to a set allows for efficient `in` checks during BFS.\n  impassable_kinds = set(env.world.non_grabbable_indices) - set(env.world.workshop_indices)\n\n  # 5. Perform Breadth-First Search (BFS) to find the shortest path.\n  # BFS is used because it guarantees finding the shortest path in an unweighted graph,\n  # which is suitable here as each movement action has a uniform cost (1 step).\n  start_pos = current_state.pos # The agent's current (x, y) position.\n  \n  # The BFS queue stores tuples: (current_position, list_of_actions_taken_to_reach_this_position).\n  q = collections.deque([(start_pos, [])]) \n  # A set to keep track of visited grid positions to prevent infinite loops (cycles)\n  # and redundant exploration of the same cell.\n  visited = {start_pos} \n\n  # Define the possible cardinal movements (change in x, change in y)\n  # and their corresponding action IDs.\n  DELTAS_ACTIONS = [\n      ((0, -1), UP),    # Moving North (decreases Y coordinate)\n      ((0, 1), DOWN),   # Moving South (increases Y coordinate)\n      ((-1, 0), LEFT),  # Moving West (decreases X coordinate)\n      ((1, 0), RIGHT),  # Moving East (increases X coordinate)\n  ]\n\n  while q:\n    (cx, cy), path_so_far = q.popleft() # Dequeue the current position and its path.\n\n    # If the current position is one of our target goal cells, we've found the shortest path.\n    if (cx, cy) in goal_cells:\n      # The path found leads to a position from which the primitive can be 'USE'd.\n      return path_so_far + [USE]\n\n    # Explore valid neighboring cells (in cardinal directions) for movement.\n    for (dx, dy), action in DELTAS_ACTIONS:\n      nx, ny = cx + dx, cy + dy # Calculate the new potential position.\n      new_pos = (nx, ny)\n\n      # Check 1: Ensure the new position is within the overall grid boundaries.\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue # Skip if out of bounds.\n\n      # Check 2: Determine if the new position is occupied by impassable terrain.\n      # A cell is considered impassable if it contains any of the `impassable_kinds`.\n      is_impassable_cell = False\n      for k_idx in impassable_kinds:\n          if grid[nx, ny, k_idx] > 0: # If this impassable kind is present at (nx, ny)...\n              is_impassable_cell = True\n              break # No need to check other kinds, it's already impassable.\n      \n      if is_impassable_cell:\n          continue # Skip if the cell is impassable.\n\n      # Check 3: If the new position has not been visited yet, add it to the queue.\n      if new_pos not in visited:\n        visited.add(new_pos) # Mark the new position as visited.\n        # Enqueue the new position along with the updated path.\n        q.append((new_pos, path_so_far + [action]))\n\n  # If the BFS completes and the queue becomes empty without finding a path to any goal cell,\n  # it means the primitive is unreachable from the current agent's position under current conditions.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T08:34:39.077888", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos\n  initial_dir = current_state.dir # 0:Right, 1:Up, 2:Left, 3:Down\n\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Crucial pre-check: If the primitive name is not found in the cookbook index\n  # or if it's not a grabbable item (e.g., water, boundary, workshops),\n  # it cannot be 'collected' via the USE action. Return an empty list.\n  if primitive_id is None or primitive_id not in current_state.world.grabbable_indices:\n      return []\n\n  # Retrieve grid dimensions (rows/height, columns/width)\n  GRID_ROWS, GRID_COLS, _ = initial_grid.shape\n\n  # Map string action names to their corresponding integer IDs from the environment.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # 'UP' usually means move forward relative to agent's direction.\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']            # Action to collect the item in front.\n\n  # Define changes in (row, col) for each direction when moving forward.\n  # This maps an agent's current direction (0-3) to the (delta_row, delta_col)\n  # that moving forward entails.\n  DIRECTION_VECTORS = {\n      0: (0, 1),   # Facing RIGHT (0): moving forward means (row, col+1)\n      1: (-1, 0),  # Facing UP (1): moving forward means (row-1, col)\n      2: (0, -1),  # Facing LEFT (2): moving forward means (row, col-1)\n      3: (1, 0)    # Facing DOWN (3): moving forward means (row+1, col)\n  }\n\n  # Define how the agent's direction changes when turning left or right.\n  # (current_direction: new_direction_after_turn)\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0} # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Get the set of entity indices that the agent cannot walk through.\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  def _is_valid_grid_coord(r, c):\n      \"\"\"Checks if the given row and column coordinates are within the grid boundaries.\"\"\"\n      return 0 <= r < GRID_ROWS and 0 <= c < GRID_COLS\n\n  def _is_cell_target_facing(pos, current_dir):\n      \"\"\"Checks if the given position and direction combination places the\n      target primitive directly in front of the agent, such that a 'USE' action\n      would collect it.\n      \"\"\"\n      r, c = pos\n      # Calculate the coordinates of the cell directly in front of the agent.\n      front_dr, front_dc = DIRECTION_VECTORS[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the 'front' cell is within grid boundaries.\n      if not _is_valid_grid_coord(front_r, front_c):\n          return False\n      \n      # Check if the target primitive is found in the cell directly in front.\n      # The grid stores counts of items; a count > 0 means the item is present.\n      return initial_grid[front_r, front_c, primitive_id] > 0\n\n  def _is_cell_walkable(pos):\n      \"\"\"Checks if the given cell is traversable/walkable by the agent.\n      An agent cannot walk onto non-grabbable items or onto the item it intends to collect.\n      \"\"\"\n      r, c = pos\n      # Ensure the cell itself is within grid boundaries.\n      if not _is_valid_grid_coord(r, c):\n          return False\n      \n      # A cell is not walkable if it contains any non-walkable entity (e.g., water, workshops, boundaries).\n      for kind_idx in non_walkable_kinds_indices:\n          if initial_grid[r, c, kind_idx] > 0:\n              return False\n      \n      # The agent cannot walk directly onto the primitive it's trying to collect;\n      # it must stop adjacent to it and use the 'USE' action.\n      if initial_grid[r, c, primitive_id] > 0:\n          return False\n          \n      return True\n  \n  # BFS (Breadth-First Search) for pathfinding:\n  # The BFS queue stores tuples:\n  # ( (agent_current_position_tuple, agent_current_direction_int), list_of_actions_taken_to_reach_this_state )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # The 'visited' set stores (agent_position_tuple, agent_direction_int) to prevent\n  # redundant exploration and cycles, ensuring the shortest path is found.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_found = None # This will store the sequence of actions to reach a 'ready-to-use' state.\n\n  # 1. Immediate Goal Check:\n  # First, check if the agent is already in the correct state to collect the primitive\n  # (i.e., adjacent to and facing the primitive from the initial state).\n  if _is_cell_target_facing(initial_pos, initial_dir):\n      target_path_found = [] # No prior movement actions are needed.\n\n  # 2. If not immediately at the target, perform BFS to find the shortest path.\n  if target_path_found is None:\n      while queue:\n          (current_pos, current_dir), path_actions = queue.popleft()\n          \n          # Explore possible next actions from the current state:\n          \n          # --- Action: Move Forward (MOVE_FORWARD_ACTION) ---\n          move_dr, move_dc = DIRECTION_VECTORS[current_dir]\n          next_r_fwd, next_c_fwd = current_pos[0] + move_dr, current_pos[1] + move_dc\n          next_pos_fwd = (next_r_fwd, next_c_fwd)\n          next_dir_fwd = current_dir # Direction does not change when moving.\n\n          # Check if the potential next position is walkable and this new state hasn't been visited.\n          if _is_cell_walkable(next_pos_fwd):\n              new_state_fwd = (next_pos_fwd, next_dir_fwd)\n              if new_state_fwd not in visited:\n                  visited.add(new_state_fwd)\n                  new_path_fwd = path_actions + [MOVE_FORWARD_ACTION]\n                  # After \"hypothetically\" moving, check if this new state allows for immediate collection.\n                  if _is_cell_target_facing(next_pos_fwd, next_dir_fwd):\n                      target_path_found = new_path_fwd\n                      break # Shortest path found, exit BFS.\n                  queue.append((new_state_fwd, new_path_fwd))\n\n          # --- Action: Turn Left (TURN_LEFT_ACTION) ---\n          next_dir_left = TURN_LEFT_MAP[current_dir]\n          new_state_left = (current_pos, next_dir_left) # Position remains the same, only direction changes.\n          # Check if the new state (same position, new direction) has not been visited.\n          if new_state_left not in visited:\n              visited.add(new_state_left)\n              new_path_left = path_actions + [TURN_LEFT_ACTION]\n              # After turning, check if this new state allows for immediate collection.\n              if _is_cell_target_facing(current_pos, next_dir_left):\n                  target_path_found = new_path_left\n                  break # Shortest path found, exit BFS.\n              queue.append((new_state_left, new_path_left))\n\n          # --- Action: Turn Right (TURN_RIGHT_ACTION) ---\n          next_dir_right = TURN_RIGHT_MAP[current_dir]\n          new_state_right = (current_pos, next_dir_right) # Position remains the same, only direction changes.\n          # Check if the new state (same position, new direction) has not been visited.\n          if new_state_right not in visited:\n              visited.add(new_state_right)\n              new_path_right = path_actions + [TURN_RIGHT_ACTION]\n              # After turning, check if this new state allows for immediate collection.\n              if _is_cell_target_facing(current_pos, next_dir_right):\n                  target_path_found = new_path_right\n                  break # Shortest path found, exit BFS.\n              queue.append((new_state_right, new_path_right))\n\n  # After BFS completes (either a path was found or all reachable states were explored):\n  # If a valid path to a collection point was found, append the final 'USE' action.\n  if target_path_found is not None:\n      actions_list.extend(target_path_found)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T08:34:40.328174", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos\n  initial_dir = current_state.dir\n\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Crucial check: If the primitive name is not valid or if it's not a grabbable item\n  # (e.g., a workshop, boundary, water, which are 'primitive' DSL tokens but not collectable by 'USE'),\n  # we cannot 'collect' it. Return an empty list of actions.\n  if primitive_id is None or primitive_id not in current_state.world.grabbable_indices:\n      return []\n\n  # Retrieve grid dimensions\n  GRID_ROWS, GRID_COLS, _ = initial_grid.shape\n\n  # Map string action names to their corresponding integer IDs from the environment's action_specs.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # 'UP' usually means move forward relative to agent's facing direction.\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']            # Action to collect the item directly in front.\n\n  # Define changes in (row, col) for each of the 4 directions when moving forward.\n  # Agent directions: 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n  DIRECTION_VECTORS = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # Define how the agent's direction changes when turning left or right.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0} # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Get the set of entity indices that the agent cannot walk through (e.g., water, boundary, workshops).\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  def _is_target_state(pos, current_dir):\n      \"\"\"Checks if the given agent position and direction allow for immediate collection\n      of the primitive (i.e., the primitive is in the cell directly in front of the agent).\n      \"\"\"\n      r, c = pos\n      front_dr, front_dc = DIRECTION_VECTORS[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the \"front\" cell is within the grid boundaries.\n      if not (0 <= front_r < GRID_ROWS and 0 <= front_c < GRID_COLS):\n          return False\n      \n      # Check if the target primitive is present in the cell directly in front.\n      return initial_grid[front_r, front_c, primitive_id] > 0\n\n  def _is_walkable_cell(pos):\n      \"\"\"Checks if the given cell coordinates represent a traversable/walkable cell for the agent.\"\"\"\n      r, c = pos\n      # Ensure the cell itself is within grid boundaries.\n      if not (0 <= r < GRID_ROWS and 0 <= c < GRID_COLS):\n          return False\n      \n      # A cell is not walkable if it contains any non-walkable entity (e.g., water, workshop).\n      for kind_idx in non_walkable_kinds_indices:\n          if initial_grid[r, c, kind_idx] > 0:\n              return False\n      \n      # The agent cannot walk directly *onto* the primitive it is trying to collect;\n      # it must stop adjacent to it and use the 'USE' action.\n      if initial_grid[r, c, primitive_id] > 0:\n          return False\n          \n      return True\n  \n  # BFS setup:\n  # Queue stores tuples: ((agent_position_tuple, agent_direction_int), list_of_actions_taken_to_reach_this_state)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # Visited set stores (agent_position_tuple, agent_direction_int) to avoid redundant exploration and cycles.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_movement = None # This will store the sequence of movement actions to reach the collection state.\n\n  # 1. Immediate Goal Check:\n  # First, check if the agent is already in the correct position and facing the primitive\n  # to collect it without any prior movement.\n  if _is_target_state(initial_pos, initial_dir):\n      target_path_movement = [] # No movement actions are needed.\n\n  # 2. If not immediately at the target, perform BFS to find the shortest path.\n  if target_path_movement is None:\n      while queue:\n          (current_pos, current_dir), path_actions = queue.popleft()\n          \n          # Explore possible next actions from the current state:\n\n          # --- Action: Move Forward (MOVE_FORWARD_ACTION) ---\n          move_dr, move_dc = DIRECTION_VECTORS[current_dir]\n          next_r_fwd, next_c_fwd = current_pos[0] + move_dr, current_pos[1] + move_dc\n          next_pos_fwd = (next_r_fwd, next_c_fwd)\n          next_dir_fwd = current_dir # Direction does not change when moving.\n\n          # Check if the potential next position is walkable and the new state hasn't been visited.\n          if _is_walkable_cell(next_pos_fwd):\n              new_state_fwd = (next_pos_fwd, next_dir_fwd)\n              if new_state_fwd not in visited:\n                  visited.add(new_state_fwd)\n                  new_path_fwd = path_actions + [MOVE_FORWARD_ACTION]\n                  # If this new state is a target state (can collect from here), store the path and break.\n                  if _is_target_state(next_pos_fwd, next_dir_fwd):\n                      target_path_movement = new_path_fwd\n                      break # Shortest path found, exit BFS.\n                  queue.append((new_state_fwd, new_path_fwd))\n\n          # --- Action: Turn Left (TURN_LEFT_ACTION) ---\n          next_dir_left = TURN_LEFT_MAP[current_dir]\n          new_state_left = (current_pos, next_dir_left) # Position remains unchanged after turning.\n          # Check if the new state (same position, new direction) has not been visited.\n          if new_state_left not in visited:\n              visited.add(new_state_left)\n              new_path_left = path_actions + [TURN_LEFT_ACTION]\n              # If this new state is a target state, store the path and break.\n              if _is_target_state(current_pos, next_dir_left):\n                  target_path_movement = new_path_left\n                  break # Shortest path found, exit BFS.\n              queue.append((new_state_left, new_path_left))\n\n          # --- Action: Turn Right (TURN_RIGHT_ACTION) ---\n          next_dir_right = TURN_RIGHT_MAP[current_dir]\n          new_state_right = (current_pos, next_dir_right) # Position remains unchanged after turning.\n          # Check if the new state (same position, new direction) has not been visited.\n          if new_state_right not in visited:\n              visited.add(new_state_right)\n              new_path_right = path_actions + [TURN_RIGHT_ACTION]\n              # If this new state is a target state, store the path and break.\n              if _is_target_state(current_pos, next_dir_right):\n                  target_path_movement = new_path_right\n                  break # Shortest path found, exit BFS.\n              queue.append((new_state_right, new_path_right))\n      \n  # After BFS completes (either a path was found or all reachable states were explored):\n  # If a valid sequence of movement actions was found to reach a collection point,\n  # append the final 'USE' action to complete the collection process.\n  if target_path_movement is not None:\n      actions_list.extend(target_path_movement)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T08:35:55.552926", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  # 1. Map primitive name to its integer ID and action names to their IDs.\n  primitive_idx = world.cookbook.index.index(primitive)\n  action_map = env.action_specs()\n  UP_ACTION = action_map['UP']\n  DOWN_ACTION = action_map['DOWN']\n  LEFT_ACTION = action_map['LEFT']\n  RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define agent direction constants: 0=N, 1=E, 2=S, 3=W (matches CraftState.dir)\n  DIR_NORTH = 0\n  DIR_EAST = 1\n  DIR_SOUTH = 2\n  DIR_WEST = 3\n\n  # Mapping: Agent's movement action -> ((dx, dy) effect on position, resulting agent direction)\n  # This makes the BFS state transition logic cleaner.\n  ACTION_MOVE_EFFECTS = {\n      UP_ACTION: ((0, -1), DIR_NORTH),\n      DOWN_ACTION: ((0, 1), DIR_SOUTH),\n      LEFT_ACTION: ((-1, 0), DIR_WEST),\n      RIGHT_ACTION: ((1, 0), DIR_EAST),\n  }\n\n  # Mapping: Agent's current direction -> (dx, dy) vector for the cell directly in front.\n  # Used to determine the target of a 'USE' action.\n  DIR_TO_FRONT_VEC = {\n      DIR_NORTH: (0, -1),\n      DIR_EAST: (1, 0),\n      DIR_SOUTH: (0, 1),\n      DIR_WEST: (-1, 0),\n  }\n\n  # Mapping: Vector from agent_pos to target_pos -> agent's required facing direction.\n  # Used to determine the necessary agent direction when standing next to a primitive.\n  VEC_TO_REQUIRED_DIR = {\n      (0, -1): DIR_NORTH,  # Target is North of agent\n      (1, 0): DIR_EAST,    # Target is East of agent\n      (0, 1): DIR_SOUTH,   # Target is South of agent\n      (-1, 0): DIR_WEST,   # Target is West of agent\n  }\n\n  agent_x, agent_y = current_state.pos\n  agent_dir = current_state.dir\n\n  # 2. Initial check: Can the primitive be collected immediately with 'USE'?\n  # This requires the primitive to be in the cell directly in front of the agent.\n  if agent_dir in DIR_TO_FRONT_VEC:\n      front_dx, front_dy = DIR_TO_FRONT_VEC[agent_dir]\n      target_x_front, target_y_front = agent_x + front_dx, agent_y + front_dy\n      \n      # Check if the cell in front is within bounds and contains the primitive\n      if (0 <= target_x_front < grid_width and 0 <= target_y_front < grid_height and \n          grid[target_x_front, target_y_front, primitive_idx] > 0):\n          return [USE_ACTION] # Primitive is directly collectable\n\n  # 3. Locate all instances of the primitive on the grid.\n  primitive_locations_on_grid = []\n  for x in range(grid_width):\n    for y in range(grid_height):\n      if grid[x, y, primitive_idx] > 0:\n        primitive_locations_on_grid.append((x, y))\n\n  # If no instances of the primitive are found, it's unreachable.\n  if not primitive_locations_on_grid:\n    return []\n\n  # 4. Define \"goal states\" for BFS. A goal state is (agent_x, agent_y, agent_direction)\n  # from which a single 'USE' action will successfully collect the primitive.\n  goal_states = set()\n  # Define relative agent positions (dx_rel, dy_rel) around a primitive (px, py).\n  # These are the positions an agent can be at to face and 'USE' a primitive.\n  # For 'USE' to work, the agent must be adjacent (cardinally) to the primitive.\n  CARDINAL_ADJACENT_VECS = [(-1, 0), (1, 0), (0, -1), (0, 1)] # West, East, North, South relative to primitive\n  \n  for px, py in primitive_locations_on_grid:\n    for dx_rel_to_primitive, dy_rel_to_primitive in CARDINAL_ADJACENT_VECS:\n      # Candidate agent position (gx, gy) to collect this primitive (px, py)\n      gx, gy = px + dx_rel_to_primitive, py + dy_rel_to_primitive\n\n      # Ensure this candidate agent position is within grid boundaries\n      if not (0 <= gx < grid_width and 0 <= gy < grid_height):\n        continue\n      \n      # Calculate the vector from the candidate agent position (gx, gy)\n      # to the primitive's position (px, py).\n      vec_from_agent_to_primitive = (px - gx, py - gy)\n      \n      # Determine the required agent direction to face the primitive\n      if vec_from_agent_to_primitive in VEC_TO_REQUIRED_DIR:\n        required_agent_dir = VEC_TO_REQUIRED_DIR[vec_from_agent_to_primitive]\n        goal_states.add((gx, gy, required_agent_dir))\n\n  # If no valid goal states can be formed (e.g., primitive is completely surrounded by impassable terrain),\n  # then it's effectively unreachable.\n  if not goal_states:\n      return []\n\n  # 5. Perform Breadth-First Search (BFS) to find the shortest path.\n  # The BFS state is (x, y, current_direction_of_agent).\n  start_bfs_state = (agent_x, agent_y, agent_dir)\n  \n  # BFS queue: stores (current_x, current_y, current_dir)\n  q = collections.deque([start_bfs_state]) \n  \n  # Visited set and path reconstruction: stores {(x, y, dir): (parent_x, parent_y, parent_dir, action_to_reach_here)}\n  visited_paths = {start_bfs_state: (None, None, None, None)}\n\n  # Identify impassable terrain: these are non-grabbable items that are not workshops.\n  # Agent cannot move onto these cells.\n  impassable_kinds = set()\n  for idx in world.non_grabbable_indices:\n      if idx not in world.workshop_indices: \n          impassable_kinds.add(idx)\n\n  found_goal_state = None\n\n  while q:\n    cx, cy, c_dir = q.popleft()\n    current_bfs_state = (cx, cy, c_dir)\n\n    # If the current state (position and direction) matches a goal state,\n    # we've found the shortest path to a collectable position.\n    if current_bfs_state in goal_states:\n      found_goal_state = current_bfs_state\n      break\n\n    # Explore valid next states by applying movement actions.\n    for action_id, ((dx, dy), next_dir) in ACTION_MOVE_EFFECTS.items():\n      nx, ny = cx + dx, cy + dy # Calculate new position\n      next_bfs_state = (nx, ny, next_dir) # New state includes new position AND new direction\n\n      # Check 1: Ensure new position is within grid boundaries.\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue\n\n      # Check 2: Determine if the new position is occupied by impassable terrain.\n      # A cell is impassable if any of its occupied kinds are in `impassable_kinds`.\n      is_impassable_location = False\n      for k_idx in impassable_kinds:\n          if grid[nx, ny, k_idx] > 0: \n              is_impassable_location = True\n              break\n      \n      if is_impassable_location:\n          continue # Cannot move to this cell\n\n      # Check 3: If this (position, direction) state has not been visited, add it to the queue.\n      if next_bfs_state not in visited_paths:\n        visited_paths[next_bfs_state] = (cx, cy, c_dir, action_id) # Store parent state and action\n        q.append(next_bfs_state)\n\n  # 6. Reconstruct the path of actions if a goal state was found.\n  if found_goal_state is None:\n    return [] # No path found to any goal state\n\n  path_actions = []\n  current_path_state = found_goal_state\n  \n  # Backtrack from the found goal state to the initial state\n  while current_path_state != start_bfs_state:\n    parent_x, parent_y, parent_dir, action_taken = visited_paths[current_path_state]\n    path_actions.append(action_taken)\n    current_path_state = (parent_x, parent_y, parent_dir)\n  \n  path_actions.reverse() # Path was built in reverse, so reverse it for correct order\n\n  # Finally, append the 'USE' action to collect the primitive.\n  return path_actions + [USE_ACTION]", "island_id": 9, "scores": {"3": 0.0}}
