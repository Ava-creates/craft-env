r:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 4. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set includes the agent's inventory as part of the state key.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing.\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  \n  # Dynamically scale MAX_EXPLORED_STATES based on n_kinds.\n  # The factor '10' from collect_v1 is replaced by 'len(world.cookbook.kinds)' to better account\n  # for the potential complexity of inventory states, as more distinct items in the world\n  # mean more possible inventory combinations that might need to be explored.\n  # Adding 1 to ensure the multiplier is at least 1.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * (1 + len(world.cookbook.kinds)) \n  explored_states_count = 0\n\n  # 5. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Check for primitive directly under the agent's feet.\n    # This covers cases where the primitive is grabbable and at the agent's current location.\n    # Note: `i_kind` might not be in `world.grabbable_indices` if it's collected via tool,\n    # but the game's `step` function should still handle it if it's the right kind of interaction.\n    if state.grid[current_r, current_c, i_kind] == 1: # The item is present at agent's current position\n        inventory_before_use_on_self = np.copy(state.inventory)\n        _, state_after_use_on_self = state.step(USE_ACT)\n        # Verify successful collection: inventory count increased after USE action\n        if state_after_use_on_self.inventory[i_kind] > inventory_before_use_on_self[i_kind]:\n            return path + [USE_ACT] # Collected by using at current position\n\n    # Goal Check: Check for primitive in adjacent cells (cardinal directions).\n    # This covers cases where the primitive is adjacent and can be collected by facing it and using USE.\n    # E.g., water, stone, or wood from a tree if tool is held.\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Ensure facing cell is within grid bounds and contains the target primitive\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                temp_state_after_turns = state \n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action on the cell in front.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the USE action from the current position generally.\n    # This is crucial for collecting intermediate items (e.g., tools) or interacting\n    # with workshops or environment objects that yield resources.\n    do_general_use_exploration = False\n    \n    # Check if agent is currently on a grabbable item that is NOT the target primitive.\n    # If so, picking it up might be an intermediate step (e.g., collecting a tool).\n    item_at_pos_idx_flat = np.where(state.grid[current_r, current_c, :] == 1)[0]\n    if item_at_pos_idx_flat.size > 0: \n        item_at_pos_idx = item_at_pos_idx_flat[0] \n        if item_at_pos_idx != i_kind and item_at_pos_idx in world.grabbable_indices:\n            do_general_use_exploration = True\n    \n    # Check if agent is facing an item that could be useful via 'USE' action.\n    # This includes workshops, other grabbable items, and certain environment objects.\n    dr, dc = _DIR_TO_DELTA_FRONT[current_dir]\n    facing_r, facing_c = current_r + dr, current_c + dc\n    \n    if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height):\n        item_in_front_idx_flat = np.where(state.grid[facing_r, facing_c, :] == 1)[0]\n        if item_in_front_idx_flat.size > 0:\n            item_in_front_idx = item_in_front_idx_flat[0]\n            # Conditions for exploring general USE on the item in front:\n            # 1. It's a grabbable item (and not the target primitive, as that's handled by goal checks).\n            # 2. It's a workshop (essential for crafting).\n            # 3. It's an environment object that is *not* water, stone, or boundary (these are generally\n            #    handled by direct goal checks if they are the target, or are non-interactable in a yielding way).\n            #    This covers things like 'tree' yielding 'wood'.\n            is_useful_to_use_on = (\n                item_in_front_idx in world.grabbable_indices or\n                item_in_front_idx in world.workshop_indices or\n                (item_in_front_idx in world.cookbook.environment and\n                 item_in_front_idx != world.water_index and \n                 item_in_front_idx != world.stone_index and \n                 # Assuming \"boundary\" is an index within the cookbook.\n                 # Using .get for robustness if \"boundary\" might not always be present\n                 # (though it usually is).\n                 item_in_front_idx != world.cookbook.index.get(\"boundary\", -1))\n            )\n            \n            if item_in_front_idx != i_kind and is_useful_to_use_on:\n                do_general_use_exploration = True\n\n    # If the general USE is deemed potentially useful based on context,\n    # then simulate and add to queue if it results in a meaningful state change.\n    if do_general_use_exploration:\n        inventory_before_any_use = np.copy(state.inventory)\n        _, state_after_current_use = state.step(USE_ACT)\n        \n        # Check if the USE action resulted in a meaningful state change (inventory, position, or direction).\n        # This prevents adding redundant states to the queue if USE had no effect.\n        if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n                state_after_current_use.pos == state.pos and\n                state_after_current_use.dir == state.dir):\n\n            next_inventory_tuple = tuple(state_after_current_use.inventory)\n            next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n            if next_state_key not in visited:\n                visited.add(next_state_key)\n                q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 6. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-08-01T10:53:26.853417", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (r, c)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  # --- Improvement for v1: Validate primitive is truly collectible ---\n  # Check if the requested primitive is actually a recognized collectible primitive\n  # in the environment's cookbook. This prevents trying to 'collect' non-collectible\n  # entities like boundaries or workshops using this function.\n  if primitive_id not in current_state.world.cookbook.primitives:\n      # If it's not a primitive resource defined in the cookbook,\n      # this function cannot collect it. Return an empty list.\n      return []\n  # --- End of improvement ---\n\n  GRID_WIDTH, GRID_HEIGHT, _ = initial_grid.shape\n\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP'] # Assuming 'UP' is the action for moving forward\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  # This defines how position changes when moving \"forward\" in a given direction.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT, move in positive column direction\n      1: (-1, 0),  # Facing UP, move in negative row direction\n      2: (0, -1),  # Facing LEFT, move in negative column direction\n      3: (1, 0)    # Facing DOWN, move in positive row direction\n  }\n\n  # Map for turning left/right, updating the agent's direction (0-3)\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Get indices of non-grabbable items that block movement (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # BFS state: ((row, col), direction), path_actions\n  # Queue stores ( (current_pos_tuple, current_dir_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (current_pos_tuple, current_dir_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # Stores the action list to reach the target state\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # Check if the primitive is directly in front of the agent at current state.\n      # This is the goal state for collection: agent is adjacent and facing the primitive.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the cell directly in front is within grid bounds\n      if (0 <= front_r < GRID_WIDTH and 0 <= front_c < GRID_HEIGHT):\n          # Check if the front cell contains the primitive we want to collect.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Path to target found!\n\n      # Explore possible next actions: Move Forward, Turn Left, Turn Right\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if next_pos is within bounds and this (position, direction) state hasn't been visited\n      if (0 <= next_r < GRID_WIDTH and 0 <= next_c < GRID_HEIGHT and\n          (next_pos, next_dir) not in visited):\n          \n          # Determine if the next_pos is walkable.\n          # A cell is walkable if it does not contain any entity marked as non-grabbable/non-walkable.\n          # Additionally, the agent cannot walk *onto* the primitive itself when trying to collect it.\n          is_walkable = True\n          # Check for explicit non-walkable kinds (e.g., boundary, water, workshops)\n          for kind_idx in non_walkable_kinds_indices:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          # Check if the target cell itself contains the primitive (agent cannot walk onto a collectible item)\n          if initial_grid[next_r, next_c, primitive_id] > 0:\n              is_walkable = False\n\n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path was found to an adjacent-and-facing state, append the USE action to the sequence.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 2, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T10:53:28.148344", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (r, c)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  # This defines how position changes when moving \"forward\" in a given direction.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT, move in positive column direction (positive col)\n      1: (-1, 0),  # Facing UP, move in negative row direction (negative row)\n      2: (0, -1),  # Facing LEFT, move in negative column direction (negative col)\n      3: (1, 0)    # Facing DOWN, move in positive row direction (positive row)\n  }\n\n  # Map for turning left/right, updating the agent's direction (0-3)\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Combine non-grabbable items and the target primitive itself into a single set\n  # of indices that represent non-walkable cells.\n  # The agent cannot walk onto permanent obstacles (non_grabbable) or the primitive it intends to collect.\n  non_walkable_indices = current_state.world.non_grabbable_indices.union({primitive_id})\n  # Convert to a list for efficient NumPy advanced indexing\n  non_walkable_indices_list = list(non_walkable_indices)\n\n  # BFS state: ((row, col), direction), path_actions\n  # Queue stores ( (current_pos_tuple, current_dir_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (current_pos_tuple, current_dir_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # Stores the action list to reach the target state\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent at current state\n      # Calculate the coordinates of the cell directly in front\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if front_cell is within grid bounds\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          # Check if the front_cell contains the primitive\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Path to target found (agent is adjacent and facing the primitive)\n\n      # 2. Explore possible next actions: Move Forward, Turn Left, Turn Right\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if next_pos is within bounds\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT):\n          # Check if this (position, direction) state hasn't been visited\n          if (next_pos, next_dir) not in visited:\n              # Check if next_pos is walkable (i.e., does not contain any non-walkable item)\n              # np.any will be True if any of the specified obstacle kinds are present at the cell\n              if not np.any(initial_grid[next_r, next_c, non_walkable_indices_list] > 0):\n                  visited.add((next_pos, next_dir))\n                  queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path was found, append the USE action to the sequence\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 2, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T10:55:11.246582", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set now includes the agent's inventory as part of the state key.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing, allowing BFS to distinguish\n  # between states that are identical in position/direction but differ in inventory (e.g., having a tool vs. not).\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # MAX_EXPLORED_STATES is a pragmatic limit to prevent extremely long searches.\n  # The multiplier '10' accounts for different relevant inventory states that might\n  # be reached (e.g., picking up a tool) during the search for the primitive.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # IMPROVEMENT for v2: Instead of immediately returning an empty list when MAX_EXPLORED_STATES is reached,\n    # we continue processing states already in the queue, but prevent further expansion from overly long paths.\n    # This acts as a soft limit, allowing paths that are already near completion to finish,\n    # but prevents the search from expanding indefinitely.\n    if explored_states_count > MAX_EXPLORED_STATES:\n        continue # Skip processing this state, but let BFS continue with others in the queue.\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`).\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Ensure the facing cell is within grid bounds and contains the target primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                temp_state_after_turns = state \n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                for turn_action in turns_to_face:\n                    # Reward is always 0.0, so we use `_` for the unused return value.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                # Reward is always 0.0, so we use `_` for the unused return value.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed, resource depletion) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      # Reward is always 0.0, so we use `_` for the unused return value.\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the USE action from the current position.\n    # This is important if using an item at the current position (e.g., picking up a tool)\n    # can change the inventory state, which might be necessary for later steps to collect the primitive.\n    inventory_before_any_use = np.copy(state.inventory)\n    # Reward is always 0.0, so we use `_` for the unused return value.\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if the USE action resulted in a meaningful state change (inventory, position, or direction).\n    # This prevents adding redundant states to the queue if USE had no effect.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T10:55:12.669045", "function_name": "collect", "function_body": "  \"\"\"Returns a list of actions to find and collect the primitive in the passed env.\n    \n    This version refines the search termination criteria compared to `collect_v1`.\n    It ensures that the Breadth-First Search (BFS) returns an empty list immediately\n    if the number of explored states exceeds a predefined maximum. This provides a\n    more predictable and bounded search, preventing potentially exhaustive or\n    unnecessary exploration of very long paths when a reasonably short one is not found.\n\n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect.\n\n    Returns:\n        List[int]: A sequence of action indices to execute.\n  \"\"\"\n  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set now includes the agent's inventory as part of the state key.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing, allowing BFS to distinguish\n  # between states that are identical in position/direction but differ in inventory (e.g., having a tool vs. not).\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # MAX_EXPLORED_STATES is a pragmatic limit to prevent extremely long searches.\n  # The multiplier '10' accounts for different relevant inventory states that might\n  # be reached (e.g., picking up a tool) during the search for the primitive.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    \n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    # This is an improvement over `collect_v1`'s `continue` because it ensures the BFS\n    # terminates immediately when the limit is hit, preventing potentially very long\n    # or unbounded searches if the desired item is unreachable or very far away.\n    explored_states_count += 1\n    if explored_states_count > MAX_EXPLORED_STATES:\n      return [] # Terminate BFS and report no path found within limits.\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`).\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Ensure the facing cell is within grid bounds and contains the target primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                temp_state_after_turns = state \n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                for turn_action in turns_to_face:\n                    # Reward is always 0.0, so we use `_` for the unused return value.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                # Reward is always 0.0, so we use `_` for the unused return value.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed, resource depletion) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      # Reward is always 0.0, so we use `_` for the unused return value.\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the USE action from the current position.\n    # This is important if using an item at the current position (e.g., picking up a tool)\n    # can change the inventory state, which might be necessary for later steps to collect the primitive.\n    inventory_before_any_use = np.copy(state.inventory)\n    # Reward is always 0.0, so we use `_` for the unused return value.\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if the USE action resulted in a meaningful state change (inventory, position, or direction).\n    # This prevents adding redundant states to the queue if USE had no effect.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T10:56:59.922812", "function_name": "collect", "function_body": "  # This function uses Breadth-First Search (BFS) to find the shortest sequence of actions\n  # (movements and turns) that will bring the agent to a position where it is\n  # adjacent to the specified primitive and facing it. Once such a path is found,\n  # the 'USE' action is appended to simulate collecting the primitive.\n\n  actions_list = [] # The list to store the sequence of actions to be returned.\n\n  # Access the current state of the CraftLab environment.\n  current_state = env._current_state\n\n  # Extract key information from the current state.\n  grid = current_state.grid              # The 3D numpy array representing the current grid layout.\n  initial_pos = current_state.pos        # Agent's current (row, column) position.\n  initial_dir = current_state.dir        # Agent's current facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN).\n\n  # Get the integer ID for the target primitive from the world's cookbook index.\n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  # Determine grid dimensions for boundary checks.\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Map human-readable action names to their integer IDs from the environment's action_specs.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # 'UP' in action_specs is interpreted as moving forward in current direction.\n  TURN_LEFT_ACTION = action_map['LEFT']     # Action to turn 90 degrees left.\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Action to turn 90 degrees right.\n  USE_ACTION = action_map['USE']            # Action to interact with (collect) the object in front.\n\n  # Define changes in (row, col) for moving one step forward based on current direction.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (delta_row=0, delta_col=1)\n      1: (-1, 0),  # Facing UP: (delta_row=-1, delta_col=0)\n      2: (0, -1),  # Facing LEFT: (delta_row=0, delta_col=-1)\n      3: (1, 0)    # Facing DOWN: (delta_row=1, delta_col=0)\n  }\n\n  # Define how the agent's direction changes when performing a turn.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}   # Cycles: RIGHT -> UP -> LEFT -> DOWN -> RIGHT\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Cycles: RIGHT -> DOWN -> LEFT -> UP -> RIGHT\n\n  # Retrieve the set of integer indices for entities that block agent movement.\n  # These are typically boundaries, water, or specific workshop locations where the agent cannot stand.\n  non_walkable_indices = current_state.world.non_grabbable_indices\n\n  # --- Helper function to check if a cell is valid for agent movement ---\n  def is_cell_valid_and_walkable(r_coord: int, c_coord: int) -> bool:\n    \"\"\"\n    Checks if a given grid cell is within the simulation boundaries and\n    does not contain any obstacle that prevents the agent from moving onto it.\n    \"\"\"\n    # 1. Check if the cell coordinates are within the grid's defined bounds.\n    if not (0 <= r_coord < WIDTH and 0 <= c_coord < HEIGHT):\n      return False\n\n    # 2. Check if the cell contains any non-walkable entity.\n    # The agent cannot move into a cell if it's occupied by a non-grabbable item (e.g., a wall).\n    for kind_idx in non_walkable_indices:\n      if grid[r_coord, c_coord, kind_idx] > 0:\n        return False\n\n    # 3. Importantly, the agent cannot walk directly *onto* the primitive it wants to collect.\n    # The collection mechanism (USE action) requires the agent to be adjacent to the primitive.\n    if grid[r_coord, c_coord, primitive_id] > 0:\n      return False # Cannot walk on the primitive itself.\n    \n    # If all conditions pass, the cell is considered safe and walkable.\n    return True\n\n  # --- BFS Initialization ---\n  # The queue stores states to explore. Each state is represented as:\n  # ((position_tuple), direction_int), path_of_actions_to_reach_this_state\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n\n  # The 'visited' set keeps track of states (position, direction) that have already been\n  # added to the queue, preventing redundant processing and infinite loops in cyclic maps.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # This variable will store the shortest sequence of actions\n                             # found to reach a state where the primitive can be collected.\n\n  # --- BFS Execution Loop ---\n  while queue:\n      # Dequeue the next state to explore.\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      r, c = current_pos # Unpack current row and column for convenience.\n\n      # **GOAL CHECK**: Check if the agent is currently in a \"goal state\" where it can collect the primitive.\n      # A goal state means the primitive is located in the grid cell directly in front of the agent.\n      \n      # Calculate the coordinates of the cell directly in front of the agent.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Verify if the cell in front is within grid boundaries AND if it contains the target primitive.\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT) and \\\n         (grid[front_r, front_c, primitive_id] > 0):\n          # If both conditions are met, we've found the shortest path to a position\n          # from which the agent can successfully 'USE' (collect) the primitive.\n          target_path_actions = path_so_far\n          break # Exit the BFS loop as the shortest path has been found.\n\n      # **EXPLORE NEXT STATES**: Generate and add valid successor states to the queue.\n\n      # 1. Action: Move Forward (in the current facing direction)\n      # Calculate the new position if the agent moves one step forward. Direction remains unchanged.\n      next_r_move, next_c_move = r + DIR_TO_DRDC[current_dir][0], c + DIR_TO_DRDC[current_dir][1]\n      next_pos_move = (next_r_move, next_c_move)\n      next_dir_move = current_dir # Direction does not change during forward movement.\n\n      # Check if this potential new position is valid and walkable, and if this specific\n      # (position, direction) state has not been visited before.\n      if is_cell_valid_and_walkable(next_r_move, next_c_move):\n          if (next_pos_move, next_dir_move) not in visited:\n              visited.add((next_pos_move, next_dir_move)) # Mark the new state as visited.\n              # Add the new state to the queue with the updated path.\n              queue.append(((next_pos_move, next_dir_move), path_so_far + [MOVE_FORWARD_ACTION]))\n\n      # 2. Action: Turn Left (rotate 90 degrees counter-clockwise)\n      # Calculate the new direction after turning left. Position remains unchanged.\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Check if this (position, new_direction) state has not been visited.\n      if (current_pos, next_dir_left) not in visited:\n          visited.add((current_pos, next_dir_left)) # Mark as visited.\n          # Add the new state to the queue with the updated path.\n          queue.append(((current_pos, next_dir_left), path_so_far + [TURN_LEFT_ACTION]))\n\n      # 3. Action: Turn Right (rotate 90 degrees clockwise)\n      # Calculate the new direction after turning right. Position remains unchanged.\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Check if this (position, new_direction) state has not been visited.\n      if (current_pos, next_dir_right) not in visited:\n          visited.add((current_pos, next_dir_right)) # Mark as visited.\n          # Add the new state to the queue with the updated path.\n          queue.append(((current_pos, next_dir_right), path_so_far + [TURN_RIGHT_ACTION]))\n\n  # --- Finalizing the Action List for Collection ---\n  # If a path to a \"target state\" (adjacent to and facing the primitive) was found by the BFS.\n  if target_path_actions is not None:\n      # Append the 'USE' action to the found path. This action will collect the primitive.\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n  # If `target_path_actions` remains None, it means the primitive was unreachable from the\n  # current agent state, and an empty list (initialized at the beginning) will be returned.\n\n  return actions_list", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T10:57:01.113432", "function_name": "collect", "function_body": "  actions_list = [] # This list will store the sequence of actions to be returned.\n\n  # Retrieve essential information from the current environment state.\n  current_state = env._current_state\n  grid = current_state.grid # The current grid layout (numpy.ndarray of shape (WIDTH, HEIGHT, n_kinds))\n  initial_pos = current_state.pos # Agent's current position (tuple: (row, col))\n  initial_dir = current_state.dir # Agent's current facing direction (int: 0=RIGHT, 1=UP, 2=LEFT, 3=DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook index.\n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  # *** IMPROVEMENT for collect_v2: Preliminary check for collectability ***\n  # Before starting the expensive BFS, verify if the specified primitive is actually\n  # an item that can be 'grabbed' (i.e., collected) according to the world's rules.\n  # Items like 'BOUNDARY', 'WATER', or 'WORKSHOP' are typically not grabbable.\n  grabbable_indices = current_state.world.grabbable_indices\n  if primitive_id not in grabbable_indices:\n      # If the primitive is not designated as grabbable, no actions can collect it.\n      return []\n\n  # Determine grid dimensions for boundary checks.\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Map human-readable action names to their integer IDs provided by the environment.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']   # Assuming 'UP' in action_specs means move forward in current direction.\n  TURN_LEFT_ACTION = action_map['LEFT']     # Turn 90 degrees left.\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Turn 90 degrees right.\n  USE_ACTION = action_map['USE']         # Action to interact with the object in front.\n\n  # Define changes in (row, col) for each facing direction when moving forward.\n  # Direction 0: Right (col increases), 1: Up (row decreases), 2: Left (col decreases), 3: Down (row increases).\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (delta_row=0, delta_col=1)\n      1: (-1, 0),  # Facing UP: (delta_row=-1, delta_col=0)\n      2: (0, -1),  # Facing LEFT: (delta_row=0, delta_col=-1)\n      3: (1, 0)    # Facing DOWN: (delta_row=1, delta_col=0)\n  }\n\n  # Define how the agent's direction changes when turning left or right.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}   # E.g., if facing RIGHT (0), turning left makes agent face UP (1).\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # E.g., if facing RIGHT (0), turning right makes agent face DOWN (3).\n\n  # Get the set of integer indices for entities that block agent movement (e.g., BOUNDARY, WATER, WORKSHOP locations).\n  non_walkable_indices = current_state.world.non_grabbable_indices\n\n  # --- Helper function for checking cell walkability ---\n  def is_cell_valid_and_walkable(r_coord: int, c_coord: int) -> bool:\n    \"\"\"\n    Checks if a given grid cell is within bounds and free of obstacles\n    that prevent the agent from moving onto it.\n    \"\"\"\n    # 1. Check if the cell coordinates are within the grid boundaries.\n    if not (0 <= r_coord < WIDTH and 0 <= c_coord < HEIGHT):\n      return False\n\n    # 2. Check if the cell contains any non-grabbable (non-walkable) entity.\n    # The agent cannot move onto cells occupied by these items.\n    for kind_idx in non_walkable_indices:\n      if grid[r_coord, c_coord, kind_idx] > 0:\n        return False\n\n    # 3. Crucially, the agent cannot walk directly *onto* the primitive it intends to collect.\n    # It must be adjacent to the primitive to use it.\n    if grid[r_coord, c_coord, primitive_id] > 0:\n      return False\n    \n    # If all checks pass, the cell is safe for the agent to move into.\n    return True\n\n  # --- BFS Initialization ---\n  # The queue will store tuples: ((current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_here)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # The visited set will store (position_tuple, direction_int) pairs to prevent redundant computations\n  # and infinite loops in cyclic paths.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # This will store the shortest sequence of actions to reach the \"goal state\".\n\n  # --- BFS Execution ---\n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      r, c = current_pos # Unpack current row and column.\n\n      # **GOAL CHECK**: Determine if the agent is currently in a state where it can collect the primitive.\n      # This means the primitive must be in the cell directly in front of the agent.\n      \n      # Calculate the coordinates of the cell directly in front of the agent.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the 'front' cell is within grid boundaries AND if it contains the target primitive.\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT) and\\\n         (grid[front_r, front_c, primitive_id] > 0):\n          # If true, we've found the shortest path to a position where the agent can USE the primitive.\n          target_path_actions = path_so_far\n          break # Exit the BFS loop as the shortest path is found.\n\n      # **EXPLORE NEXT STATES**: Generate possible next states by applying valid actions.\n\n      # 1. Attempt to Move Forward:\n      # Calculate the new position if the agent moves forward. Direction remains unchanged.\n      next_r_move, next_c_move = r + DIR_TO_DRDC[current_dir][0], c + DIR_TO_DRDC[current_dir][1]\n      next_pos_move = (next_r_move, next_c_move)\n      next_dir_move = current_dir # Direction does not change with forward movement.\n\n      # Check if the new position is valid and walkable, and if this new state (pos, dir) has not been visited.\n      if is_cell_valid_and_walkable(next_r_move, next_c_move):\n          if (next_pos_move, next_dir_move) not in visited:\n              visited.add((next_pos_move, next_dir_move)) # Mark new state as visited.\n              # Add the new state to the queue with the updated path.\n              queue.append(((next_pos_move, next_dir_move), path_so_far + [MOVE_FORWARD_ACTION]))\n\n      # 2. Attempt to Turn Left:\n      # Calculate the new direction after turning left. Position remains unchanged.\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Check if this new state (pos, dir) has not been visited.\n      if (current_pos, next_dir_left) not in visited:\n          visited.add((current_pos, next_dir_left)) # Mark new state as visited.\n          # Add the new state to the queue with the updated path.\n          queue.append(((current_pos, next_dir_left), path_so_far + [TURN_LEFT_ACTION]))\n\n      # 3. Attempt to Turn Right:\n      # Calculate the new direction after turning right. Position remains unchanged.\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Check if this new state (pos, dir) has not been visited.\n      if (current_pos, next_dir_right) not in visited:\n          visited.add((current_pos, next_dir_right)) # Mark new state as visited.\n          # Add the new state to the queue with the updated path.\n          queue.append(((current_pos, next_dir_right), path_so_far + [TURN_RIGHT_ACTION]))\n\n  # --- Finalizing the Action List ---\n  # If a path to the target (adjacent and facing the primitive) was successfully found during BFS.\n  if target_path_actions is not None:\n      # Extend the found path with the 'USE' action to complete the collection.\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n  # If target_path_actions is None, it means the primitive was unreachable from the current state.\n  # In this case, an empty list (initialized at the start) will be returned.\n\n  return actions_list", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T10:58:46.197119", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v0`.\n  This version adds a check to ensure the primitive is actually grabbable before attempting to collect it.\n  If the primitive is not grabbable, an empty list of actions is returned, as it cannot be 'collected' via USE.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state\n  \n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  # Improvement: Check if the primitive is actually grabbable.\n  # If it's not in the list of grabbable items, it cannot be collected using the USE action\n  # in the way 'collect' is typically interpreted (i.e., picking up an item).\n  if primitive_id not in current_state.world.grabbable_indices:\n      # If the primitive is not grabbable (e.g., WATER, STONE, WORKSHOP),\n      # it cannot be collected by picking it up. Return an empty list.\n      return []\n\n  # The rest of the logic is largely the same as collect_v0, as the BFS correctly finds a path\n  # to a position adjacent to the target grabbable primitive, and then uses USE.\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (r, c)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT, move in positive column direction (positive col)\n      1: (-1, 0),  # Facing UP, move in negative row direction (negative row)\n      2: (0, -1),  # Facing LEFT, move in negative column direction (negative col)\n      3: (1, 0)    # Facing DOWN, move in positive row direction (positive row)\n  }\n\n  # Map for turning left/right, updating the agent's direction (0-3)\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  \n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} \n\n  # Combine non-grabbable items and the target primitive itself into a single set\n  # of indices that represent non-walkable cells.\n  # The agent cannot walk onto permanent obstacles (non_grabbable) or the primitive it intends to collect.\n  non_walkable_indices = current_state.world.non_grabbable_indices.union({primitive_id})\n  non_walkable_indices_list = list(non_walkable_indices) # Convert to a list for efficient NumPy advanced indexing\n\n  # BFS state: ((row, col), direction), path_actions\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  visited = {(initial_pos, initial_dir)} # Visited set stores (current_pos_tuple, current_dir_int)\n\n  target_path = None # Stores the action list to reach the target state\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent at current state\n      # Calculate the coordinates of the cell directly in front\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if front_cell is within grid bounds\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          # Check if the front_cell contains the primitive (value > 0 indicates presence)\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Path to target found (agent is adjacent and facing the primitive)\n\n      # 2. Explore possible next actions: Move Forward, Turn Left, Turn Right\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if next_pos is within bounds\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT):\n          # Check if this (position, direction) state hasn't been visited\n          if (next_pos, next_dir) not in visited:\n              # Check if next_pos is walkable (i.e., does not contain any non-walkable item)\n              # np.any will be True if any of the specified obstacle kinds are present at the cell\n              if not np.any(initial_grid[next_r, next_c, non_walkable_indices_list] > 0):\n                  visited.add((next_pos, next_dir))\n                  queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path was found, append the USE action to the sequence\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 2, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T10:58:47.455025", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (r, c)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  # This defines how position changes when moving \"forward\" in a given direction.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT, move in positive column direction (positive col)\n      1: (-1, 0),  # Facing UP, move in negative row direction (negative row)\n      2: (0, -1),  # Facing LEFT, move in negative column direction (negative col)\n      3: (1, 0)    # Facing DOWN, move in positive row direction (positive row)\n  }\n\n  # Map for turning left/right, updating the agent's direction (0-3)\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Inverse of DIR_TO_DRDC: (dr, dc) -> dir. Used to determine the required agent direction\n  # when target primitive is at (pr,pc) and agent is at (nr,nc) where (pr-nr, pc-nc) = (dr,dc)\n  DRDC_TO_DIR = {v: k for k, v in DIR_TO_DRDC.items()}\n\n  # Define potential \"collectible\" primitive locations on the grid.\n  # A primitive can be collected if the agent is adjacent to it and facing it.\n  # We pre-calculate all target (agent_r, agent_c, agent_dir) states\n  # that would allow collection of *any* instance of the primitive.\n  target_collectible_states = set()\n  primitive_locations = [] # List of (r, c) where primitive is located\n\n  for r in range(WIDTH):\n      for c in range(HEIGHT):\n          if initial_grid[r, c, primitive_id] > 0:\n              primitive_locations.append((r, c))\n\n  # If no primitive is found, return empty list\n  if not primitive_locations:\n      return []\n\n  # For each primitive location (pr, pc), and each of its 4 cardinal neighbors (nr, nc)\n  # determine the agent_dir that would face (pr, pc) from (nr, nc).\n  for pr, pc in primitive_locations:\n      for dr, dc in [(0, 1), (0, -1), (1, 0), (-1, 0)]: # Relative offsets for N,S,E,W neighbors\n          nr, nc = pr - dr, pc - dc # Neighbor cell (agent's potential position)\n          \n          if 0 <= nr < WIDTH and 0 <= nc < HEIGHT:\n              # The agent's direction must be (dr, dc) to point to (pr, pc) from (nr, nc)\n              agent_facing_dir = DRDC_TO_DIR.get((dr, dc))\n              if agent_facing_dir is not None:\n                target_collectible_states.add(((nr, nc), agent_facing_dir))\n\n  # Combine non-grabbable items and the target primitive itself into a single set\n  # of indices that represent non-walkable cells for pathfinding.\n  non_walkable_indices = current_state.world.non_grabbable_indices.union({primitive_id})\n  non_walkable_indices_list = list(non_walkable_indices) # For efficient numpy indexing\n\n  # A* search setup\n  # Priority queue: (f_cost, g_cost, (pos, dir))\n  # f_cost = g_cost + h_cost\n  # g_cost = cost from start to current node (number of actions)\n  priority_queue = []\n  \n  # g_costs: stores the minimum g_cost found so far for each state (pos, dir)\n  g_costs = {} \n\n  # came_from: reconstructs the path (state -> previous_state, action_to_reach_current_state)\n  came_from = {} \n\n  # Heuristic function: estimate cost from (pos, dir) to the closest target_collectible_state\n  def heuristic(pos, direction):\n      min_h = float('inf')\n      r, c = pos\n      if not target_collectible_states: # Should not happen if primitive_locations is not empty\n          return 0 # No target, no cost\n\n      for (target_r, target_c), target_dir in target_collectible_states:\n          # Manhattan distance for position\n          dist_pos = abs(r - target_r) + abs(c - target_c)\n\n          # Minimum turns to match direction\n          turn_diff = (target_dir - direction + 4) % 4\n          dist_dir = min(turn_diff, 4 - turn_diff)\n          \n          min_h = min(min_h, dist_pos + dist_dir)\n      return min_h\n\n  initial_h_cost = heuristic(initial_pos, initial_dir)\n  heapq.heappush(priority_queue, (initial_h_cost, 0, (initial_pos, initial_dir)))\n  g_costs[(initial_pos, initial_dir)] = 0\n  \n  found_goal_state = None\n\n  while priority_queue:\n      f_cost, current_g_cost, (current_pos, current_dir) = heapq.heappop(priority_queue)\n\n      # If we've found a shorter path to this state previously, skip\n      if current_g_cost > g_costs.get((current_pos, current_dir), float('inf')):\n          continue\n\n      # Check if this state is a goal state (adjacent to primitive and facing it)\n      if (current_pos, current_dir) in target_collectible_states:\n          found_goal_state = (current_pos, current_dir)\n          break # Found the shortest path to a goal\n\n      r, c = current_pos\n\n      # Explore neighbors (Move Forward, Turn Left, Turn Right)\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir\n      \n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT):\n          # Ensure the next position is walkable (not an obstacle)\n          if not np.any(initial_grid[next_r, next_c, non_walkable_indices_list] > 0):\n              new_g_cost = current_g_cost + 1 # Cost of one action (move)\n              if new_g_cost < g_costs.get((next_pos, next_dir), float('inf')):\n                  g_costs[(next_pos, next_dir)] = new_g_cost\n                  h_cost = heuristic(next_pos, next_dir)\n                  heapq.heappush(priority_queue, (new_g_cost + h_cost, new_g_cost, (next_pos, next_dir)))\n                  came_from[(next_pos, next_dir)] = ((current_pos, current_dir), MOVE_FORWARD_ACTION)\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      next_pos_left = current_pos # Position does not change\n      new_g_cost_left = current_g_cost + 1 # Cost of one action (turn)\n      if new_g_cost_left < g_costs.get((next_pos_left, next_dir_left), float('inf')):\n          g_costs[(next_pos_left, next_dir_left)] = new_g_cost_left\n          h_cost_left = heuristic(next_pos_left, next_dir_left)\n          heapq.heappush(priority_queue, (new_g_cost_left + h_cost_left, new_g_cost_left, (next_pos_left, next_dir_left)))\n          came_from[(next_pos_left, next_dir_left)] = ((current_pos, current_dir), TURN_LEFT_ACTION)\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      next_pos_right = current_pos # Position does not change\n      new_g_cost_right = current_g_cost + 1 # Cost of one action (turn)\n      if new_g_cost_right < g_costs.get((next_pos_right, next_dir_right), float('inf')):\n          g_costs[(next_pos_right, next_dir_right)] = new_g_cost_right\n          h_cost_right = heuristic(next_pos_right, next_dir_right)\n          heapq.heappush(priority_queue, (new_g_cost_right + h_cost_right, new_g_cost_right, (next_pos_right, next_dir_right)))\n          came_from[(next_pos_right, next_dir_right)] = ((current_pos, current_dir), TURN_RIGHT_ACTION)\n\n  # Reconstruct path if a goal state was found\n  if found_goal_state:\n      path = []\n      current = found_goal_state\n      while current != (initial_pos, initial_dir):\n          # Retrieve the previous state and the action that led to current\n          prev_state, action = came_from[current]\n          path.append(action)\n          current = prev_state\n      actions_list.extend(path[::-1]) # Reverse to get actions from start to goal\n      actions_list.append(USE_ACTION) # Append the USE action at the end\n\n  return actions_list", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-08-01T10:59:32.733234", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  \n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  # Improvement 1: Ensure the primitive is actually grabbable.\n  # If it's not a grabbable item (e.g., BOUNDARY, WATER, STONE, WORKSHOP),\n  # it cannot be 'collected' by picking it up using the USE action.\n  # Return an empty list of actions in such cases.\n  if primitive_id not in current_state.world.grabbable_indices:\n      return []\n\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (r, c)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT, move in positive column direction\n      1: (-1, 0),  # Facing UP, move in negative row direction\n      2: (0, -1),  # Facing LEFT, move in negative column direction\n      3: (1, 0)    # Facing DOWN, move in positive row direction\n  }\n\n  # Map for turning left/right, updating the agent's direction (0-3)\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # R->U->L->D->R\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # R->D->L->U->R\n\n  # Improvement 2: Consolidate all indices that block agent movement.\n  # This includes permanent environmental obstacles (non_grabbable_indices)\n  # AND the target primitive itself (as the agent must stand next to it, not on it, to USE).\n  all_blocking_indices = list(current_state.world.non_grabbable_indices.union({primitive_id}))\n\n  # BFS state: ((row, col), direction), path_actions\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  visited = {(initial_pos, initial_dir)} # Visited set stores (current_pos_tuple, current_dir_int)\n\n  target_path = None # Stores the action list to reach the target state\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent at current state\n      # Calculate the coordinates of the cell directly in front\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if front_cell is within grid bounds\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          # Check if the front_cell contains the primitive (value > 0 indicates presence)\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Path to target found (agent is adjacent and facing the primitive)\n\n      # 2. Explore possible next actions: Move Forward, Turn Left, Turn Right\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if next_pos is within bounds\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT):\n          # Check if this (position, direction) state hasn't been visited\n          if (next_pos, next_dir) not in visited:\n              # Check if next_pos is walkable (i.e., does not contain any of the blocking items)\n              # np.any will be True if any of the specified blocking kinds are present at the cell.\n              # This covers both permanent obstacles and the target primitive itself.\n              if not np.any(initial_grid[next_r, next_c, all_blocking_indices] > 0):\n                  visited.add((next_pos, next_dir))\n                  queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path was found, append the USE action to the sequence\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 2, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T10:59:33.875107", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  \n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  # Improvement: Check if the primitive is actually grabbable.\n  # If it's not in the list of grabbable items, it cannot be collected using the USE action\n  # in the way 'collect' is typically interpreted (i.e., picking up an item).\n  if primitive_id not in current_state.world.grabbable_indices:\n      # If the primitive is not grabbable (e.g., WATER, STONE, WORKSHOP),\n      # it cannot be collected by picking it up. Return an empty list.\n      return []\n\n  # The rest of the logic is largely the same as collect_v0, as the BFS correctly finds a path\n  # to a position adjacent to the target grabbable primitive, and then uses USE.\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (r, c)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT, move in positive column direction (positive col)\n      1: (-1, 0),  # Facing UP, move in negative row direction (negative row)\n      2: (0, -1),  # Facing LEFT, move in negative column direction (negative col)\n      3: (1, 0)    # Facing DOWN, move in positive row direction (positive row)\n  }\n\n  # Map for turning left/right, updating the agent's direction (0-3)\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  \n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} \n\n  # Combine non-grabbable items and the target primitive itself into a single set\n  # of indices that represent non-walkable cells.\n  # The agent cannot walk onto permanent obstacles (non_grabbable) or the primitive it intends to collect.\n  non_walkable_indices = current_state.world.non_grabbable_indices.union({primitive_id})\n  non_walkable_indices_list = list(non_walkable_indices) # Convert to a list for efficient NumPy advanced indexing\n\n  # BFS state: ((row, col), direction), path_actions\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  visited = {(initial_pos, initial_dir)} # Visited set stores (current_pos_tuple, current_dir_int)\n\n  target_path = None # Stores the action list to reach the target state\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent at current state\n      # Calculate the coordinates of the cell directly in front\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if front_cell is within grid bounds\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          # Check if the front_cell contains the primitive (value > 0 indicates presence)\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Path to target found (agent is adjacent and facing the primitive)\n\n      # 2. Explore possible next actions: Move Forward, Turn Left, Turn Right\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if next_pos is within bounds\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT):\n          # Check if this (position, direction) state hasn't been visited\n          if (next_pos, next_dir) not in visited:\n              # Check if next_pos is walkable (i.e., does not contain any non-walkable item)\n              # np.any will be True if any of the specified obstacle kinds are present at the cell\n              if not np.any(initial_grid[next_r, next_c, non_walkable_indices_list] > 0):\n                  visited.add((next_pos, next_dir))\n                  queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path was found, append the USE action to the sequence\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 2, "scores": {"3": 0.5}}
