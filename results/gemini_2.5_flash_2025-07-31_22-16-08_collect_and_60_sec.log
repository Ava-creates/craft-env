{"timestamp": "2025-08-01T13:48:28.589670", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid # The static grid for pathfinding\n  initial_pos = current_state.pos  # Agent's starting position (row, col)\n  initial_dir = current_state.dir  # Agent's starting direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # 1. Input Validation and Early Exits:\n  # Get the integer ID for the primitive from the environment's cookbook index.\n  try:\n      primitive_id = current_state.world.cookbook.index[primitive]\n  except KeyError:\n      # If the primitive name is not recognized, it cannot be collected.\n      return []\n  \n  # Check if the primitive is already in the inventory. If yes, no actions are needed.\n  if current_state.inventory[primitive_id] > 0:\n      return []\n\n  # Check if the primitive is actually grabbable (can be picked up and added to inventory).\n  # Non-grabbable items (like 'WATER', 'WORKSHOP0') cannot be 'collected' in this manner.\n  if primitive_id not in current_state.world.grabbable_indices:\n      return []\n\n  # Get grid dimensions for boundary checks\n  GRID_ROWS, GRID_COLS, _ = initial_grid.shape \n\n  # Map DMLab action names to their integer indices for clarity and use in pathfinding.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP'] # 'UP' action typically means 'move forward' relative to current direction\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define how agent's position changes based on its facing direction\n  # Directions: 0 (Right), 1 (Up), 2 (Left), 3 (Down)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: move to (row, col+1)\n      1: (-1, 0),  # Facing UP: move to (row-1, col)\n      2: (0, -1),  # Facing LEFT: move to (row, col-1)\n      3: (1, 0)    # Facing DOWN: move to (row+1, col)\n  }\n\n  # Get indices of entities that cannot be walked upon (e.g., boundaries, water, workshops).\n  # These are considered 'obstacles' for pathfinding.\n  non_walkable_kind_ids = current_state.world.non_grabbable_indices\n\n  # --- BFS for finding path to an adjacent and facing primitive ---\n  # State in BFS queue: ((current_position_tuple, current_direction_int), list_of_actions_taken)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited states: (position_tuple, direction_int) to avoid cycles and redundant paths.\n  visited = {(initial_pos, initial_dir)}\n\n  path_to_adjacent_primitive = None # Stores the action sequence if found\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      current_r, current_c = current_pos\n\n      # A. Check for Goal Condition: Is the target primitive directly in front of the agent?\n      # Calculate the coordinates of the cell one step forward from the agent's current position and direction.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      target_r, target_c = current_r + front_dr, current_c + front_dc\n\n      # Ensure the target cell is within grid boundaries.\n      if (0 <= target_r < GRID_ROWS and 0 <= target_c < GRID_COLS):\n          # Check if the target cell contains the primitive we want to collect.\n          if initial_grid[target_r, target_c, primitive_id] > 0:\n              path_to_adjacent_primitive = path_actions # Found the path to get *adjacent* and *facing* it\n              break # Exit BFS, shortest path found\n\n      # B. Explore possible next actions (Movement and Turns):\n      \n      # 1. Try Move Forward:\n      # Calculate the next position if the agent moves forward (in its current facing direction).\n      next_move_pos = (current_r + DIR_TO_DRDC[current_dir][0],\n                       current_c + DIR_TO_DRDC[current_dir][1])\n      next_move_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if this new state (position, direction) is valid and unvisited.\n      if (0 <= next_move_pos[0] < GRID_ROWS and 0 <= next_move_pos[1] < GRID_COLS and\n          (next_move_pos, next_move_dir) not in visited):\n          \n          # Determine if the `next_move_pos` cell is walkable for the agent.\n          is_walkable = True\n          # Agent cannot walk onto non-grabbable entities (e.g., walls, water, workshops).\n          for kind_idx in non_walkable_kind_ids:\n              if initial_grid[next_move_pos[0], next_move_pos[1], kind_idx] > 0:\n                  is_walkable = False\n                  break\n          # Agent also cannot walk directly onto the target primitive itself (it must be adjacent to 'USE' it).\n          if is_walkable and initial_grid[next_move_pos[0], next_move_pos[1], primitive_id] > 0:\n              is_walkable = False\n\n          if is_walkable:\n              visited.add((next_move_pos, next_move_dir))\n              queue.append(( (next_move_pos, next_move_dir), path_actions + [MOVE_FORWARD_ACTION] ))\n\n      # 2. Try Turn Left:\n      next_turn_left_dir = (current_dir + 1) % 4 # Clockwise rotation (e.g., Right->Up->Left->Down)\n      # Turning does not change position.\n      if ((current_pos, next_turn_left_dir) not in visited):\n          visited.add((current_pos, next_turn_left_dir))\n          queue.append(( (current_pos, next_turn_left_dir), path_actions + [TURN_LEFT_ACTION] ))\n\n      # 3. Try Turn Right:\n      next_turn_right_dir = (current_dir - 1 + 4) % 4 # Counter-clockwise rotation (e.g., Right->Down->Left->Up)\n      # Adding 4 before modulo ensures the result is non-negative.\n      # Turning does not change position.\n      if ((current_pos, next_turn_right_dir) not in visited):\n          visited.add((current_pos, next_turn_right_dir))\n          queue.append(( (current_pos, next_turn_right_dir), path_actions + [TURN_RIGHT_ACTION] ))\n\n  # After BFS: If a path to being adjacent and facing the primitive was found,\n  # append the 'USE' action to actually collect it.\n  if path_to_adjacent_primitive is not None:\n      actions_list.extend(path_to_adjacent_primitive)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 7, "scores": {"3": 0.5}}
