{"timestamp": "2025-07-31T23:43:32.081744", "function_name": "collect", "function_body": "  actions = []\n  current_state = env._current_state\n  grid = current_state.grid\n  start_pos = current_state.pos\n  grid_width, grid_height, _ = grid.shape\n\n  # Get primitive ID from the cookbook's index\n  try:\n    primitive_idx = env.world.cookbook.index[primitive]\n  except KeyError:\n    # Primitive name not found in cookbook index\n    return []\n\n  # Map actions to their integer values\n  ACTIONS = env.action_specs()\n  ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = (\n      ACTIONS['UP'], ACTIONS['DOWN'], ACTIONS['LEFT'], ACTIONS['RIGHT'], ACTIONS['USE']\n  )\n  \n  # Cardinal directions for movement (dr, dc) to action constant\n  NEIGHBOR_MOVES = {\n      (-1, 0): ACTION_UP,\n      (1, 0): ACTION_DOWN,\n      (0, -1): ACTION_LEFT,\n      (0, 1): ACTION_RIGHT\n  }\n\n  # Pre-compute blocking obstacle indices for efficiency in is_traversable.\n  # These are non-grabbable items that also block movement (not water, not workshops).\n  blocking_obstacle_indices = set()\n  for k_idx in env.world.cookbook.kinds: # Iterate over all known kinds\n    if k_idx in env.world.non_grabbable_indices:\n        if k_idx != env.world.water_index and k_idx not in env.world.workshop_indices:\n            blocking_obstacle_indices.add(k_idx)\n\n  # Helper function to check if a cell (r, c) is traversable by the agent\n  def is_traversable(r, c):\n    # Check if coordinates are within grid bounds\n    if not (0 <= r < grid_width and 0 <= c < grid_height):\n      return False\n\n    # Check for water, which is always non-passable\n    if grid[r, c, env.world.water_index] == 1:\n      return False\n\n    # Check for other pre-defined blocking obstacles at this cell\n    kinds_at_cell = np.where(grid[r, c] == 1)[0]\n    for k_idx in kinds_at_cell:\n        if k_idx in blocking_obstacle_indices:\n            return False # This cell contains a known blocking obstacle\n    return True\n\n  # Determine the collection strategy based on primitive type\n  is_grabbable_resource = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n\n  # If the primitive is water or an implicit boundary (handled by is_traversable),\n  # or any other non-grabbable/non-workshop item, it cannot be \"collected\" via this function.\n  if not is_grabbable_resource and not is_workshop:\n    return []\n\n  # 1. Find all locations of the primitive on the grid\n  primitive_grid_locations = []\n  for r in range(grid_width):\n    for c in range(grid_height):\n      if grid[r, c, primitive_idx] == 1:\n        primitive_grid_locations.append((r, c))\n\n  if not primitive_grid_locations:\n    # Primitive not found anywhere on the map\n    return []\n\n  # 2. Determine target positions for BFS based on primitive type\n  target_bfs_positions = set()\n  if is_grabbable_resource:\n    # For grabbable resources, the agent needs to be *adjacent* to the resource to USE it.\n    # The `CraftState.next_to` method checks a 3x3 neighborhood.\n    NEIGHBORHOOD_OFFSETS_3x3 = [\n        (dr, dc) for dr in [-1, 0, 1] for dc in [-1, 0, 1]\n    ]\n    for pr, pc in primitive_grid_locations:\n      for dr, dc in NEIGHBORHOOD_OFFSETS_3x3:\n        nr, nc = pr + dr, pc + dc\n        if is_traversable(nr, nc):\n          target_bfs_positions.add((nr, nc))\n  elif is_workshop:\n    # For workshops, the agent needs to move *onto* the workshop location.\n    for pr, pc in primitive_grid_locations:\n      if is_traversable(pr, pc): # Ensure the workshop location itself is traversable\n        target_bfs_positions.add((pr, pc))\n\n  if not target_bfs_positions:\n    # No reachable target positions found where the agent can interact with the primitive\n    return []\n\n  # 3. Breadth-First Search (BFS) to find the shortest path\n  q = collections.deque([(start_pos, [])]) # (position, path_taken_actions)\n  visited = {start_pos}\n  path_to_target = None\n\n  while q:\n    (r, c), current_path = q.popleft()\n\n    # If the current position is one of the target BFS positions, we found the shortest path.\n    if (r, c) in target_bfs_positions:\n      path_to_target = current_path\n      break\n\n    # Explore cardinal neighbors\n    for (dr, dc), action_val in NEIGHBOR_MOVES.items():\n      next_r, next_c = r + dr, c + dc\n      \n      if (next_r, next_c) not in visited:\n        if is_traversable(next_r, next_c):\n          visited.add((next_r, next_c))\n          q.append(((next_r, next_c), current_path + [action_val]))\n\n  if path_to_target:\n    actions.extend(path_to_target)\n    # If it's a grabbable resource, an additional 'USE' action is required once adjacent.\n    if is_grabbable_resource:\n      actions.append(ACTION_USE)\n  \n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T23:43:33.264929", "function_name": "collect", "function_body": "  actions = []\n  current_state = env._current_state\n  grid = current_state.grid\n  start_pos = current_state.pos\n  grid_width, grid_height, _ = grid.shape\n\n  # Get primitive ID from the cookbook's index\n  try:\n    primitive_idx = env.world.cookbook.index[primitive]\n  except KeyError:\n    # Primitive name not found in cookbook index, cannot collect.\n    return []\n\n  # Map actions to their integer values\n  ACTIONS = env.action_specs()\n  ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = (\n      ACTIONS['UP'], ACTIONS['DOWN'], ACTIONS['LEFT'], ACTIONS['RIGHT'], ACTIONS['USE']\n  )\n  \n  # Cardinal directions for movement and their corresponding actions\n  NEIGHBOR_MOVES = {\n      (-1, 0): ACTION_UP,\n      (1, 0): ACTION_DOWN,\n      (0, -1): ACTION_LEFT,\n      (0, 1): ACTION_RIGHT\n  }\n  CARDINAL_DIRECTIONS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n  # Neighborhood offsets for a 3x3 area (used for grabbable items)\n  NEIGHBORHOOD_OFFSETS_3x3 = [\n      (dr, dc) for dr in [-1, 0, 1] for dc in [-1, 0, 1]\n  ]\n\n  # The 'collect' DSL keyword is intended specifically for grabbable items (resources that go into inventory).\n  # Workshops are generally interacted with via the 'craft' DSL function.\n  # Water and boundaries cannot be collected.\n  if primitive_idx not in env.world.grabbable_indices:\n    return []\n\n  # Pre-compute blocking indices for `is_traversable`\n  # These are non-grabbable items that block agent movement (not water, not workshops).\n  blocking_obstacles_indices = set(env.world.non_grabbable_indices) - {env.world.water_index} - set(env.world.workshop_indices)\n\n  # Helper function to check if a cell (r, c) is traversable by the agent\n  def is_traversable(r, c):\n    # Check if coordinates are within grid bounds\n    if not (0 <= r < grid_width and 0 <= c < grid_height):\n      return False\n\n    # Check for water, which is always non-passable\n    if grid[r, c, env.world.water_index] == 1:\n      return False\n\n    # Check for other blocking obstacles\n    # An agent cannot move onto a cell if it contains any of the blocking kind indices\n    kinds_at_cell = np.where(grid[r, c] == 1)[0]\n    if any(k_idx in blocking_obstacles_indices for k_idx in kinds_at_cell):\n        return False\n\n    return True\n\n  # 1. Immediate Collection Check: If already next to the primitive, simply use it.\n  # This relies on the CraftState's `next_to` method for efficiency and correctness.\n  if current_state.next_to(primitive_idx):\n    actions.append(ACTION_USE)\n    return actions\n\n  # 2. Find all grid locations where the target primitive exists.\n  primitive_grid_locations = []\n  for r in range(grid_width):\n    for c in range(grid_height):\n      if grid[r, c, primitive_idx] == 1:\n        primitive_grid_locations.append((r, c))\n\n  if not primitive_grid_locations:\n    # Primitive not found anywhere on the map\n    return []\n\n  # 3. Identify all \"collectible spots\" (traversable cells where the agent can stand\n  #    to be 'next to' the target primitive and then 'USE' it).\n  # For grabbable resources, the agent needs to be *adjacent* to the resource to USE it.\n  # The `CraftState.next_to` method checks a 3x3 neighborhood.\n  collectible_spots = set()\n  for pr, pc in primitive_grid_locations:\n    for dr, dc in NEIGHBORHOOD_OFFSETS_3x3:\n      nr, nc = pr + dr, pc + dc\n      \n      # If this potential standing spot is traversable, it's a candidate collectible spot.\n      # Being in the 3x3 neighborhood of a primitive means being \"next to\" it.\n      if is_traversable(nr, nc):\n        collectible_spots.add((nr, nc))\n\n  if not collectible_spots:\n    # No reachable (traversable) spots identified where the agent can be next to the primitive\n    return []\n\n  # 4. Breadth-First Search (BFS) to find the shortest path from the current position\n  #    to any of the identified collectible spots.\n  q = collections.deque([(start_pos, [])]) # (position, path_taken_actions)\n  visited = {start_pos}\n  path_found = None\n\n  while q:\n    (r, c), current_path = q.popleft()\n\n    # If the current position is one of the collectible spots, we found the shortest path.\n    if (r, c) in collectible_spots:\n      path_found = current_path\n      break\n\n    # Explore cardinal neighbors\n    for dr, dc in CARDINAL_DIRECTIONS:\n      next_r, next_c = r + dr, c + dc\n      \n      if (next_r, next_c) not in visited:\n        if is_traversable(next_r, next_c):\n          visited.add((next_r, next_c))\n          q.append(((next_r, next_c), current_path + [NEIGHBOR_MOVES[(dr, dc)]]))\n\n  if path_found:\n    actions.extend(path_found)\n    actions.append(ACTION_USE) # Once at the collectible spot, use the item.\n  \n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T23:44:16.096137", "function_name": "collect", "function_body": "  ACTION_UP = craft.UP\n  ACTION_DOWN = craft.DOWN\n  ACTION_LEFT = craft.LEFT\n  ACTION_RIGHT = craft.RIGHT\n  ACTION_USE = craft.USE\n\n  # Access the current state from the environment's internal attributes\n  current_state = env._current_state\n  current_grid = current_state.grid # The agent's view of the world grid\n  current_pos_x, current_pos_y = current_state.pos # Agent's current (x, y) coordinates\n\n  # Get grid dimensions for boundary checks\n  WIDTH, HEIGHT, _ = current_grid.shape\n\n  try:\n    # Convert the string name of the primitive to its corresponding integer ID\n    # Use .lower() to ensure case-insensitivity as names in the cookbook index might be lowercase.\n    primitive_idx = env.world.cookbook.index.index(primitive.lower())\n  except KeyError:\n    # If the primitive name is not found in the cookbook, it's not a known item.\n    return []\n\n  # Get sets of indices for items that cannot be traversed/picked up (e.g., walls, water)\n  impassable_indices = env.world.non_grabbable_indices\n  # Get a list of indices for items that *can* be picked up (collected)\n  grabbable_indices = env.world.grabbable_indices\n\n  # Critical check: Ensure the target primitive is actually an item that can be grabbed.\n  # If it's a \"workshop\" or \"water\" (non-grabbable), we can't \"collect\" it.\n  if primitive_idx not in grabbable_indices:\n    return []\n\n  # --- Breadth-First Search (BFS) to find the shortest path to the primitive ---\n  # The queue will store tuples of ((x, y), [list_of_actions_to_reach_this_cell])\n  q = collections.deque()\n  # The visited set will store (x, y) tuples of cells already processed to avoid cycles and redundant work\n  visited = set()\n\n  # Start the BFS from the agent's current position with an empty list of actions\n  q.append(((current_pos_x, current_pos_y), []))\n  visited.add((current_pos_x, current_pos_y))\n\n  # Define possible movements: (delta_x, delta_y, action_constant)\n  # CraftWorld's coordinate system: X increases right, Y increases down.\n  move_deltas_actions = [\n      (0, -1, ACTION_UP),    # Move North (decreases Y-coordinate)\n      (0, 1, ACTION_DOWN),   # Move South (increases Y-coordinate)\n      (-1, 0, ACTION_LEFT),  # Move West (decreases X-coordinate)\n      (1, 0, ACTION_RIGHT)   # Move East (increases X-coordinate)\n  ]\n\n  while q:\n    # Dequeue the current cell's coordinates and the path taken to reach it\n    (x, y), actions_so_far = q.popleft()\n\n    # Check if the current cell (x, y) contains the desired primitive.\n    # `current_grid[x, y, primitive_idx] > 0` checks if there's at least one instance.\n    if current_grid[x, y, primitive_idx] > 0:\n      # If found, append the USE action and return the full sequence.\n      return actions_so_far + [ACTION_USE]\n\n    # Explore all four neighboring cells (up, down, left, right)\n    for dx, dy, action_move in move_deltas_actions:\n      nx, ny = x + dx, y + dy # Calculate the neighbor's coordinates\n\n      # 1. Boundary check: Ensure the neighbor is within the grid limits\n      if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n        continue\n\n      # 2. Visited check: Skip if this neighbor has already been visited\n      if (nx, ny) in visited:\n        continue\n\n      # 3. Impassable terrain check: Determine if the neighbor cell is traversable\n      is_impassable = False\n      for k_idx in impassable_indices:\n        # If the neighbor cell contains any object identified as impassable\n        if current_grid[nx, ny, k_idx] > 0: # Use > 0 for general count\n          is_impassable = True\n          break\n      if is_impassable:\n        continue\n\n      # If the neighbor is valid (within bounds, unvisited, and traversable),\n      # add it to the visited set and enqueue it with the updated path.\n      visited.add((nx, ny))\n      q.append(((nx, ny), actions_so_far + [action_move]))\n\n  # If the BFS completes and the primitive was not found in any accessible cell,\n  # return an empty list, indicating it's uncollectable from the current state.\n  return []", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T23:44:17.400297", "function_name": "collect", "function_body": "  ACTION_UP = craft.UP\n  ACTION_DOWN = craft.DOWN\n  ACTION_LEFT = craft.LEFT\n  ACTION_RIGHT = craft.RIGHT\n  ACTION_USE = craft.USE\n\n  # Get current state information from the CraftLab environment's internal state\n  current_state = env._current_state\n  current_grid = current_state.grid # The full grid layout: (WIDTH, HEIGHT, n_kinds)\n  current_pos_x, current_pos_y = current_state.pos # Agent's current (x, y) integer position\n\n  # Get grid dimensions\n  WIDTH, HEIGHT, _ = current_grid.shape\n\n  # Convert the primitive name (string) to its corresponding integer index\n  # Using Index.__getitem__ which returns int or None.\n  primitive_idx = env.world.cookbook.index[primitive.lower()]\n  if primitive_idx is None:\n    # If the primitive name is not found in the cookbook's index, it cannot be collected.\n    return []\n\n  # Get lists of indices for impassable and grabbable items\n  impassable_indices = env.world.non_grabbable_indices\n  grabbable_indices = env.world.grabbable_indices\n\n  # Early exit: If the target primitive is not an item that can be grabbed/collected,\n  # there's no sequence of actions to \"collect\" it.\n  if primitive_idx not in grabbable_indices:\n    return []\n\n  # --- Breadth-First Search (BFS) to find the shortest path to the primitive ---\n  q = collections.deque() # Queue for BFS: stores ((x, y), [actions_to_reach_here])\n  visited = set()         # Set to keep track of visited grid cells (x, y)\n\n  # Start BFS from the agent's current position with an empty action path\n  start_node = (current_pos_x, current_pos_y)\n  q.append((start_node, [])) # (position, path_to_reach_position)\n  visited.add(start_node)\n\n  # Define possible movements (change in x, change in y, corresponding action)\n  # (dx, dy) maps to (column_change, row_change) for grid[x, y]\n  move_actions = [\n      (0, -1, ACTION_UP),    # Move North (decreases y, i.e., row index)\n      (0, 1, ACTION_DOWN),   # Move South (increases y)\n      (-1, 0, ACTION_LEFT),  # Move West (decreases x, i.e., column index)\n      (1, 0, ACTION_RIGHT)   # Move East (increases x)\n  ]\n\n  while q:\n    (x, y), actions_so_far = q.popleft()\n\n    # Check if the current cell (x, y) contains the desired primitive.\n    # `current_grid[x, y, primitive_idx] == 1` assumes 1-hot encoding for presence.\n    # If the primitive is at the current cell, and it's grabbable (checked upfront),\n    # we've found the shortest path to it. Append ACTION_USE to collect it.\n    if current_grid[x, y, primitive_idx] == 1:\n      return actions_so_far + [ACTION_USE]\n\n    # Explore neighboring cells\n    for dx, dy, action_move in move_actions:\n      nx, ny = x + dx, y + dy # Calculate neighbor's coordinates\n\n      # 1. Check if the neighbor is within grid boundaries\n      if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n        continue\n\n      # 2. Check if the neighbor has already been visited to avoid cycles and redundant work\n      if (nx, ny) in visited:\n        continue\n\n      # 3. Check if the neighbor cell contains any impassable objects.\n      # A cell is impassable if any object residing there is in the `non_grabbable_indices` set.\n      is_impassable = False\n      for k_idx in impassable_indices:\n        # Check if the cell (nx, ny) contains the impassable object `k_idx`.\n        # Assuming `current_grid` stores 0 or 1 for presence.\n        if current_grid[nx, ny, k_idx] == 1:\n          is_impassable = True\n          break\n      if is_impassable:\n        continue\n\n      # If the neighbor is valid (within bounds, not visited, and traversable),\n      # add it to the queue with its path and mark it as visited.\n      visited.add((nx, ny))\n      q.append(((nx, ny), actions_so_far + [action_move]))\n\n  # If the BFS completes and the primitive was not found anywhere accessible on the grid,\n  # return an empty list indicating that it cannot be collected from the current state.\n  return []", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T23:45:01.714513", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  ACTION_UP = action_map[\"UP\"]\n  ACTION_DOWN = action_map[\"DOWN\"]\n  ACTION_LEFT = action_map[\"LEFT\"]\n  ACTION_RIGHT = action_map[\"RIGHT\"]\n  ACTION_USE = action_map[\"USE\"]\n\n  # Get current state from the environment\n  current_state = env._current_state\n  current_grid = current_state.grid\n  # Agent's position is a tuple, convert to int for grid indexing\n  current_pos_x, current_pos_y = int(current_state.pos[0]), int(current_state.pos[1])\n  grid_width, grid_height, _ = current_grid.shape\n\n  # Get the integer ID for the target primitive from the cookbook index\n  try:\n    primitive_idx = env.world.cookbook.index.index(primitive.lower())\n  except KeyError:\n    # Primitive name not found in cookbook, cannot collect.\n    return []\n\n  # Determine if the primitive is a 'grabbable' item (like wood, iron) or\n  # a 'non-grabbable' interactive resource (like water, stone).\n  is_grabbable_item = primitive_idx in env.world.grabbable_indices\n  \n  # Define what entities explicitly block agent movement onto or through a cell.\n  # These are typically non-grabbable environmental features that are not meant to be walked on.\n  # Workshops are explicitly excluded as they are traversable standing points.\n  blocked_movement_indices = set()\n  \n  # Add common blocking terrain indices using env.world attributes.\n  # Note: `env.world.environment` contains all non-grabbable entities, including workshops.\n  # We want to block movement only for non-traversable environment items.\n  # Typically, WATER, STONE, and BOUNDARY are blocking.\n  if env.world.water_index in env.world.cookbook.kinds: # Check if exists in this scenario's kinds\n      blocked_movement_indices.add(env.world.water_index)\n  if env.world.stone_index in env.world.cookbook.kinds: # Check if exists\n      blocked_movement_indices.add(env.world.stone_index)\n  \n  # Add boundary if it exists in the cookbook index and is considered blocking.\n  try:\n      boundary_idx = env.world.cookbook.index.index(\"boundary\")\n      # A boundary is generally non-grabbable and untraversable.\n      if boundary_idx in env.world.cookbook.kinds: # Check if exists\n          blocked_movement_indices.add(boundary_idx)\n  except KeyError:\n      pass # Boundary might not be in index for all scenarios\n\n  # Helper function to check if a cell is traversable by the agent\n  def is_traversable(x, y):\n    # Check bounds\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    \n    # Check if the cell contains any entity that explicitly blocks movement.\n    # If a cell contains any item from `blocked_movement_indices`, it's not traversable.\n    for blocked_idx in blocked_movement_indices:\n      if current_grid[x, y, blocked_idx] > 0:\n        return False\n            \n    # If no blocking entities are found, the cell is traversable.\n    # This correctly allows movement onto workshops, as they are not in `blocked_movement_indices`.\n    return True\n\n  # Define cardinal movement offsets and their corresponding actions\n  move_offsets = [\n      (0, -1, ACTION_UP),    # (dx, dy, action) for North (decrement y)\n      (0, 1, ACTION_DOWN),   # for South (increment y)\n      (-1, 0, ACTION_LEFT),  # for West (decrement x)\n      (1, 0, ACTION_RIGHT)   # for East (increment x)\n  ]\n\n  # Step 1: Find all grid locations where the primitive exists.\n  primitive_grid_locations = []\n  for x in range(grid_width):\n    for y in range(grid_height):\n      if current_grid[x, y, primitive_idx] > 0:\n        primitive_grid_locations.append((x, y))\n\n  if not primitive_grid_locations:\n    return [] # Primitive not found anywhere on the grid\n\n  # Step 2: Determine the set of target cells where the agent needs to stand\n  # to interact with or pick up the primitive.\n  target_agent_standing_locations = set()\n\n  if is_grabbable_item:\n    # For grabbable items (e.g., WOOD, IRON, GRASS), the agent needs to stand *on* the item's cell.\n    for px, py in primitive_grid_locations:\n      if is_traversable(px, py): # Ensure agent can actually move onto this cell\n        target_agent_standing_locations.add((px, py))\n  elif primitive.lower() in [\"water\", \"stone\"]:\n    # For specific non-grabbable but interactive resources (WATER, STONE),\n    # the agent needs to stand *adjacent* to them (cardinal neighbors).\n    for px, py in primitive_grid_locations:\n      for dx, dy, _ in move_offsets: # Iterate through cardinal neighbors of the primitive's location\n        nx, ny = px + dx, py + dy\n        if is_traversable(nx, ny): # Ensure agent can stand on this adjacent cell\n          target_agent_standing_locations.add((nx, ny))\n  # For other non-grabbable primitives (e.g., WORKSHOP, BOUNDARY) that are not \"collected\" in this sense,\n  # target_agent_standing_locations will remain empty, which is desired as no path will be found.\n\n  if not target_agent_standing_locations:\n    return [] # No reachable target location found for the primitive\n\n  # Step 3: Perform a Breadth-First Search (BFS) to find the shortest path\n  # from the agent's current position to any of the target standing locations.\n  q = collections.deque()\n  visited = set() # Stores (x, y) tuples of visited cells\n\n  # Start BFS from the agent's current position\n  start_pos_tuple = (current_pos_x, current_pos_y)\n  q.append((start_pos_tuple, [])) # Queue stores ((x, y), [actions_to_reach_here])\n  visited.add(start_pos_tuple)\n\n  shortest_path_actions = []\n  found_path = False\n\n  while q:\n    (x, y), actions_so_far = q.popleft()\n\n    # If the current cell is one of our target standing locations, we found a path\n    if (x, y) in target_agent_standing_locations:\n      found_path = True\n      shortest_path_actions = actions_so_far\n      break # Found the shortest path, no need to continue BFS\n\n    # Explore valid neighbors\n    for dx, dy, action_move in move_offsets:\n      nx, ny = x + dx, y + dy\n\n      # Check if neighbor is within bounds, not visited, and traversable\n      if (nx, ny) not in visited and is_traversable(nx, ny):\n        visited.add((nx, ny))\n        q.append(((nx, ny), actions_so_far + [action_move]))\n\n  final_actions = []\n  if found_path:\n    final_actions.extend(shortest_path_actions)\n    # After reaching the target cell, add the USE action to interact with/collect the primitive.\n    # This applies to both grabbable items (agent stands on it) and adjacent interactive resources.\n    final_actions.append(ACTION_USE)\n\n  return final_actions", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T23:45:02.869122", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  ACTION_UP = action_map[\"UP\"]\n  ACTION_DOWN = action_map[\"DOWN\"]\n  ACTION_LEFT = action_map[\"LEFT\"]\n  ACTION_RIGHT = action_map[\"RIGHT\"]\n  ACTION_USE = action_map[\"USE\"]\n\n  # Get current state from the environment\n  current_state = env._current_state\n  current_grid = current_state.grid\n  # Agent's position is a tuple, convert to int for grid indexing\n  current_pos_x, current_pos_y = int(current_state.pos[0]), int(current_state.pos[1])\n  grid_width, grid_height, _ = current_grid.shape\n\n  # Get the integer ID for the target primitive from the cookbook index\n  # Use __getitem__ for lookup, which returns None if not found, rather than index() which might add it.\n  primitive_idx = env.world.cookbook.index[primitive.lower()]\n  if primitive_idx is None:\n    # Primitive name not found in cookbook, cannot collect.\n    return []\n\n  # Determine if the primitive is a 'grabbable' item (like wood, iron) or\n  # a 'non-grabbable' interactive resource (like water, stone).\n  is_grabbable_item = primitive_idx in env.world.grabbable_indices\n  \n  # Define what entities explicitly block agent movement.\n  # These are non-grabbable entities that are not traversable (e.g., workshops are non-grabbable but traversable).\n  blocking_terrain_indices = set()\n  for idx in env.world.non_grabbable_indices:\n      # Workshops are non-grabbable but the agent can stand on them.\n      if idx not in env.world.workshop_indices:\n          blocking_terrain_indices.add(idx)\n\n  # Helper function to check if a cell is traversable by the agent\n  def is_traversable(x, y):\n    # Check bounds\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    \n    # Check if the cell contains any entity that explicitly blocks movement\n    for blocking_idx in blocking_terrain_indices:\n      if current_grid[x, y, blocking_idx] > 0:\n        return False\n            \n    # If no blocking entities are found, it's traversable.\n    # Cells with grabbable items are traversable by default unless blocked by other terrain.\n    # Cells with workshops are also traversable because workshop_indices are excluded from blocking_terrain_indices.\n    return True\n\n  # Define cardinal movement offsets and their corresponding actions\n  move_offsets = [\n      (0, -1, ACTION_UP),    # (dx, dy, action) for North (decrement y)\n      (0, 1, ACTION_DOWN),   # for South (increment y)\n      (-1, 0, ACTION_LEFT),  # for West (decrement x)\n      (1, 0, ACTION_RIGHT)   # for East (increment x)\n  ]\n\n  # Step 1: Find all grid locations where the primitive exists.\n  primitive_grid_locations = []\n  for x in range(grid_width):\n    for y in range(grid_height):\n      if current_grid[x, y, primitive_idx] > 0:\n        primitive_grid_locations.append((x, y))\n\n  if not primitive_grid_locations:\n    return [] # Primitive not found anywhere on the grid\n\n  # Step 2: Determine the set of target cells where the agent needs to stand\n  # to interact with or pick up the primitive.\n  target_agent_standing_locations = set()\n\n  if is_grabbable_item:\n    # For grabbable items (e.g., WOOD, IRON, GRASS), the agent needs to stand *on* the item's cell.\n    for px, py in primitive_grid_locations:\n      if is_traversable(px, py): # Ensure agent can actually move onto this cell\n        target_agent_standing_locations.add((px, py))\n  elif primitive.lower() in [\"water\", \"stone\"]:\n    # For specific non-grabbable but interactive resources (WATER, STONE),\n    # the agent needs to stand *adjacent* to them (cardinal neighbors).\n    for px, py in primitive_grid_locations:\n      for dx, dy, _ in move_offsets: # Iterate through cardinal neighbors of the primitive's location\n        nx, ny = px + dx, py + dy\n        if is_traversable(nx, ny): # Ensure agent can stand on this adjacent cell\n          target_agent_standing_locations.add((nx, ny))\n  # For other non-grabbable primitives (e.g., WORKSHOP, BOUNDARY) that are not \"collected\" in this sense,\n  # target_agent_standing_locations will remain empty, which is desired as no path will be found.\n\n  if not target_agent_standing_locations:\n    return [] # No reachable target location found for the primitive\n\n  # Step 3: Perform a Breadth-First Search (BFS) to find the shortest path\n  # from the agent's current position to any of the target standing locations.\n  q = collections.deque()\n  visited = set() # Stores (x, y) tuples of visited cells\n\n  # Start BFS from the agent's current position\n  start_pos_tuple = (current_pos_x, current_pos_y)\n  q.append((start_pos_tuple, [])) # Queue stores ((x, y), [actions_to_reach_here])\n  visited.add(start_pos_tuple)\n\n  shortest_path_actions = []\n  found_path = False\n\n  while q:\n    (x, y), actions_so_far = q.popleft()\n\n    # If the current cell is one of our target standing locations, we found a path\n    if (x, y) in target_agent_standing_locations:\n      found_path = True\n      shortest_path_actions = actions_so_far\n      break # Found the shortest path, no need to continue BFS\n\n    # Explore valid neighbors\n    for dx, dy, action_move in move_offsets:\n      nx, ny = x + dx, y + dy\n\n      # Check if neighbor is within bounds, not visited, and traversable\n      if (nx, ny) not in visited and is_traversable(nx, ny):\n        visited.add((nx, ny))\n        q.append(((nx, ny), actions_so_far + [action_move]))\n\n  final_actions = []\n  if found_path:\n    final_actions.extend(shortest_path_actions)\n    # After reaching the target cell, add the USE action to interact with/collect the primitive.\n    final_actions.append(ACTION_USE)\n\n  return final_actions", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T23:45:54.928477", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` with optimized obstacle checking using NumPy masks.\"\"\"\n  state = env._current_state\n  cookbook = env.world.cookbook\n  \n  # 1. Get primitive index\n  try:\n    prim_idx = cookbook.index.index(primitive)\n  except ValueError: # If primitive string is not known\n    return []\n\n  # Determine if the primitive is grabbable (e.g., WOOD, IRON)\n  # For grabbable items, \"collect\" means to move next to them, face them, and USE.\n  # For non-grabbable items (e.g., WORKSHOP, WATER), \"collect\" means to move onto their cell.\n  prim_is_grabbable = prim_idx in env.world.grabbable_indices\n  \n  # Define action mappings and related constants\n  ACTION_MAP = env.action_specs()\n  UP, DOWN, LEFT, RIGHT, USE = ACTION_MAP[\"UP\"], ACTION_MAP[\"DOWN\"], ACTION_MAP[\"LEFT\"], ACTION_MAP[\"RIGHT\"], ACTION_MAP[\"USE\"]\n\n  # Map (dx, dy) to movement action index\n  DELTAS_BY_ACTION = {\n      UP: (-1, 0),\n      DOWN: (1, 0),\n      LEFT: (0, -1),\n      RIGHT: (0, 1)\n  }\n  \n  # Map direction index (0:N, 1:S, 2:W, 3:E) to (dx, dy)\n  DIR_TO_DELTA = {\n      0: (-1, 0), # North (UP)\n      1: (1, 0),  # South (DOWN)\n      2: (0, -1), # West (LEFT)\n      3: (0, 1)   # East (RIGHT)\n  }\n  \n  # Map (dx, dy) to direction index\n  DELTA_TO_DIR = {v: k for k, v in DIR_TO_DELTA.items()}\n\n  # Grid dimensions and total number of kinds\n  WIDTH, HEIGHT, N_KINDS = state.grid.shape \n\n  # --- Pre-calculate impassable kinds mask for efficient obstacle checking ---\n  impassable_mask = np.zeros(N_KINDS, dtype=bool)\n\n  # Add general obstacles (non-grabbable entities, e.g., workshops, and boundary)\n  general_obstacle_indices = set(env.world.non_grabbable_indices) \n  try: \n    boundary_idx = cookbook.index.index(\"BOUNDARY\")\n    general_obstacle_indices.add(boundary_idx)\n  except ValueError: \n    pass # BOUNDARY might not exist in all cookbooks\n  \n  for kind_id in general_obstacle_indices:\n      if 0 <= kind_id < N_KINDS: # Ensure kind_id is within valid bounds\n          impassable_mask[kind_id] = True\n\n  water_idx = None\n  try:\n    water_idx = cookbook.index.index(\"WATER\")\n  except ValueError: \n    pass # WATER might not exist in all cookbooks\n\n  bridge_idx = None\n  try:\n    bridge_idx = cookbook.index.index(\"BRIDGE\")\n  except ValueError: \n    pass # BRIDGE might not exist in all cookbooks\n\n  # BFS setup\n  start_pos = state.pos\n  start_dir = state.dir\n  \n  # Queue stores ( (x, y, current_dir), path_to_this_state )\n  q = collections.deque([((start_pos[0], start_pos[1], start_dir), [])])\n  \n  # Visited set stores (x, y, current_dir) to avoid cycles and redundant exploration\n  visited = {(start_pos[0], start_pos[1], start_dir)}\n\n  while q:\n    ((curr_x, curr_y, curr_dir), path_so_far) = q.popleft()\n\n    # --- Check for goal condition based on primitive type ---\n    if prim_is_grabbable:\n      # For grabbable items, the goal is to be adjacent and facing it, then USE\n      front_dx, front_dy = DIR_TO_DELTA[curr_dir]\n      target_x, target_y = curr_x + front_dx, curr_y + front_dy\n\n      if 0 <= target_x < WIDTH and 0 <= target_y < HEIGHT:\n        # Check if the primitive is at the cell the agent is facing\n        if state.grid[target_x, target_y, prim_idx] > 0:\n          # Found grabbable primitive in front, append USE action and return path\n          return list(path_so_far) + [USE]\n    else:\n      # For non-grabbable items (like WORKSHOP, WATER), the goal is to be *on* the cell\n      if state.grid[curr_x, curr_y, prim_idx] > 0:\n          # Agent is on the primitive cell, return path (no USE action needed)\n          return list(path_so_far)\n\n    # --- Explore neighbors by taking movement actions ---\n    for action, (dx, dy) in DELTAS_BY_ACTION.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      # After moving to (next_x, next_y), the agent faces the direction of movement.\n      next_dir = DELTA_TO_DIR[(dx, dy)] \n\n      # Check bounds\n      if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n        continue\n\n      # --- Optimized Check for obstacles at the next cell (next_x, next_y) ---\n      is_obstacle = False\n      cell_contents = state.grid[next_x, next_y] # Get the numpy array of counts for this cell\n\n      # Check against the pre-computed general impassable mask using NumPy's any()\n      if np.any(cell_contents[impassable_mask]):\n          is_obstacle = True\n      \n      # Special check for water if bridge is not in inventory (this is conditional and can't be fully pre-masked)\n      if not is_obstacle and water_idx is not None and cell_contents[water_idx] > 0:\n          if bridge_idx is None or state.inventory[bridge_idx] == 0: \n              is_obstacle = True\n      \n      if is_obstacle:\n        continue # Cannot move to this cell\n\n      # Check if this (position, direction) state has been visited\n      if (next_x, next_y, next_dir) not in visited:\n        visited.add((next_x, next_y, next_dir))\n        q.append(((next_x, next_y, next_dir), path_so_far + [action]))\n\n  # If no path found after exhausting the queue\n  return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-31T23:45:56.168966", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  \n  # 1. Get primitive index\n  try:\n    prim_idx = cookbook.index.index(primitive)\n  except ValueError: # If primitive string is not known\n    return []\n\n  # Determine if the primitive is grabbable (e.g., WOOD, IRON)\n  # For grabbable items, \"collect\" means to move next to them, face them, and USE.\n  # For non-grabbable items (e.g., WORKSHOP, WATER), \"collect\" means to move onto their cell.\n  prim_is_grabbable = prim_idx in env.world.grabbable_indices\n  \n  # Define action mappings and related constants\n  ACTION_MAP = env.action_specs()\n  UP, DOWN, LEFT, RIGHT, USE = ACTION_MAP[\"UP\"], ACTION_MAP[\"DOWN\"], ACTION_MAP[\"LEFT\"], ACTION_MAP[\"RIGHT\"], ACTION_MAP[\"USE\"]\n\n  # Map (dx, dy) to movement action index\n  DELTAS_BY_ACTION = {\n      UP: (-1, 0),\n      DOWN: (1, 0),\n      LEFT: (0, -1),\n      RIGHT: (0, 1)\n  }\n  \n  # Map direction index (0:N, 1:S, 2:W, 3:E) to (dx, dy)\n  DIR_TO_DELTA = {\n      0: (-1, 0), # North (UP)\n      1: (1, 0),  # South (DOWN)\n      2: (0, -1), # West (LEFT)\n      3: (0, 1)   # East (RIGHT)\n  }\n  \n  # Map (dx, dy) to direction index\n  DELTA_TO_DIR = {v: k for k, v in DIR_TO_DELTA.items()}\n\n  # Grid dimensions\n  WIDTH, HEIGHT, _ = state.grid.shape\n\n  # Obstacle indices (things we cannot walk into)\n  # Use the `non_grabbable_indices` set from the world, which typically includes boundaries and workshops.\n  obstacle_indices = set(env.world.non_grabbable_indices) \n  # Ensure \"BOUNDARY\" is considered an obstacle if it exists and wasn't already included\n  try: \n    boundary_idx = cookbook.index.index(\"BOUNDARY\")\n    obstacle_indices.add(boundary_idx)\n  except ValueError: pass \n\n  water_idx = None\n  try:\n    water_idx = cookbook.index.index(\"WATER\")\n  except ValueError: pass\n\n  bridge_idx = None\n  try:\n    bridge_idx = cookbook.index.index(\"BRIDGE\")\n  except ValueError: pass\n\n  # BFS setup\n  start_pos = state.pos\n  start_dir = state.dir\n  \n  # Queue stores ( (x, y, current_dir), path_to_this_state )\n  q = collections.deque([((start_pos[0], start_pos[1], start_dir), [])])\n  \n  # Visited set stores (x, y, current_dir) to avoid cycles and redundant exploration\n  visited = {(start_pos[0], start_pos[1], start_dir)}\n\n  while q:\n    ((curr_x, curr_y, curr_dir), path_so_far) = q.popleft()\n\n    # --- Check for goal condition based on primitive type ---\n    if prim_is_grabbable:\n      # For grabbable items, the goal is to be adjacent and facing it, then USE\n      front_dx, front_dy = DIR_TO_DELTA[curr_dir]\n      target_x, target_y = curr_x + front_dx, curr_y + front_dy\n\n      if 0 <= target_x < WIDTH and 0 <= target_y < HEIGHT:\n        if state.grid[target_x, target_y, prim_idx] > 0:\n          # Found grabbable primitive in front, append USE action and return path\n          return list(path_so_far) + [USE]\n    else:\n      # For non-grabbable items (like WORKSHOP, WATER), the goal is to be *on* the cell\n      if state.grid[curr_x, curr_y, prim_idx] > 0:\n          # Agent is on the primitive cell, return path (no USE action needed)\n          return list(path_so_far)\n\n    # --- Explore neighbors by taking movement actions ---\n    for action, (dx, dy) in DELTAS_BY_ACTION.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      # After moving to (next_x, next_y), the agent faces the direction of movement.\n      next_dir = DELTA_TO_DIR[(dx, dy)] \n\n      # Check bounds\n      if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n        continue\n\n      # Get indices of all items present at the next cell\n      # This is more efficient than iterating through all possible kinds.\n      kinds_at_next_cell = np.where(state.grid[next_x, next_y] > 0)[0]\n      \n      is_obstacle = False\n      for kind_id_at_cell in kinds_at_next_cell:\n          if kind_id_at_cell in obstacle_indices:\n              is_obstacle = True\n              break\n          if water_idx is not None and kind_id_at_cell == water_idx: \n              # Cannot pass water unless a bridge is in inventory\n              if bridge_idx is None or state.inventory[bridge_idx] == 0: \n                  is_obstacle = True\n                  break\n      if is_obstacle:\n        continue # Cannot move to this cell\n\n      # Check if this (position, direction) state has been visited\n      if (next_x, next_y, next_dir) not in visited:\n        visited.add((next_x, next_y, next_dir))\n        q.append(((next_x, next_y, next_dir), path_so_far + [action]))\n\n  # If no path found after exhausting the queue\n  return []", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T23:47:31.093857", "function_name": "collect", "function_body": "  current_state = env._current_state\n  grid = current_state.grid\n  current_pos = current_state.pos\n  grid_width, grid_height, _ = grid.shape\n\n  # 1. Get Primitive Index from the cookbook\n  cookbook = env.world.cookbook\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # Primitive name not found in cookbook index, cannot collect\n    return []\n\n  # 2. Categorize the primitive type based on world definitions and DSL primitive list.\n  is_grabbable_item = primitive_idx in env.world.grabbable_indices\n  is_workshop_location = primitive_idx in env.world.workshop_indices\n  \n  # Check if the primitive is listed as a 'primitive resource' in the cookbook (from YAML).\n  # This distinguishes between e.g., a 'BOUNDARY' (which is non-grabbable but not a resource)\n  # and 'STONE' (which might be non-grabbable but IS a resource).\n  is_defined_primitive_resource = primitive_idx in cookbook.primitives\n\n  # Filter out truly uncollectible and impassable environment features.\n  # If it's a non-grabbable entity AND not a workshop AND NOT a defined primitive resource,\n  # then it's an uncollectible, typically impassable, environmental obstacle.\n  # Examples: BOUNDARY, or WATER if WATER is not considered a 'primitive' resource to collect.\n  if (primitive_idx in env.world.non_grabbable_indices and not is_workshop_location) and not is_defined_primitive_resource:\n      return []\n\n  # 3. Helper function to determine if a cell (r, c) is traversable for the agent.\n  # A cell is traversable if it's within bounds and doesn't contain impassable non-grabbable obstacles.\n  # Workshops are generally considered traversable.\n  def is_traversable(r, c):\n      # Check bounds\n      if not (0 <= r < grid_width and 0 <= c < grid_height):\n          return False\n      \n      # Check for impassable items at (r, c).\n      # Water is generally impassable unless explicitly defined otherwise.\n      if grid[r, c, env.world.water_index] == 1:\n          return False\n\n      # Other non-grabbable items (excluding workshops) are assumed to be impassable terrain.\n      # If a primitive resource like STONE is also in non_grabbable_indices, this means\n      # the agent cannot walk *onto* the stone, but must interact from an adjacent tile.\n      kinds_at_cell = np.where(grid[r, c] == 1)[0]\n      for kind_at_cell_idx in kinds_at_cell:\n          if kind_at_cell_idx in env.world.non_grabbable_indices and\\\n             kind_at_cell_idx not in env.world.workshop_indices:\n              return False \n      return True\n\n  # 4. Find all grid locations where the primitive exists\n  primitive_grid_locations = []\n  for r in range(grid_width):\n    for c in range(grid_height):\n      if grid[r, c, primitive_idx] == 1:\n        primitive_grid_locations.append((r, c))\n\n  if not primitive_grid_locations:\n    # Primitive not found anywhere on the map\n    return []\n\n  # 5. Define \"collectible spots\" (where the agent needs to be to collect/interact)\n  # For any primitive (grabbable, non-grabbable resource, or workshop), the agent generally needs to be\n  # in its 3x3 neighborhood (including being on the spot itself if traversable).\n  collectible_spots = set()\n  \n  # Offsets for 3x3 neighborhood (including center)\n  NEIGHBORHOOD_OFFSETS = [\n      (dr, dc) for dr in [-1, 0, 1] for dc in [-1, 0, 1]\n  ]\n\n  for pr, pc in primitive_grid_locations:\n    for dr, dc in NEIGHBORHOOD_OFFSETS:\n      nr, nc = pr + dr, pc + dc\n      if is_traversable(nr, nc): # Only add traversable spots\n        collectible_spots.add((nr, nc))\n  \n  if not collectible_spots:\n    # No reachable or valid collectible spots found.\n    return []\n\n  # 6. Map actions to their integer values (using craft constants)\n  ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = (\n      craft.UP, craft.DOWN, craft.LEFT, craft.RIGHT, craft.USE\n  )\n  ACTION_MAP = {\n      (-1, 0): ACTION_UP,\n      (1, 0): ACTION_DOWN,\n      (0, -1): ACTION_LEFT,\n      (0, 1): ACTION_RIGHT\n  }\n  CARDINAL_DIRECTIONS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n  # 7. Immediate collection check: If already at a collectible spot\n  # If currently next to the primitive (for grabbable/breakable resources) or on a workshop.\n  if current_state.next_to(primitive_idx):\n    # For grabbable items or non-grabbable primitive resources that require USE (like mining stone),\n    # the USE action is needed.\n    if is_grabbable_item or is_defined_primitive_resource: \n      return [ACTION_USE]\n    # For workshops, being 'next_to' (which includes being on the spot) is sufficient.\n    # No further action needed to \"collect\" (i.e., be present at) a workshop.\n    elif is_workshop_location:\n        return []\n\n  # 8. BFS to find shortest path to any collectible spot\n  q = collections.deque([(current_pos, [])]) # (position, path_taken_actions)\n  visited = {current_pos}\n  path_found = None\n\n  while q:\n    (r, c), current_path = q.popleft()\n\n    # If the current position is a collectible spot, we found the path\n    if (r, c) in collectible_spots:\n      path_found = current_path\n      break\n\n    for dr, dc in CARDINAL_DIRECTIONS:\n      next_r, next_c = r + dr, c + dc\n      \n      if is_traversable(next_r, next_c) and (next_r, next_c) not in visited:\n          visited.add((next_r, next_c))\n          q.append(((next_r, next_c), current_path + [ACTION_MAP[(dr, dc)]]))\n\n  # 9. Construct final action list\n  final_actions = []\n  if path_found:\n    final_actions.extend(path_found)\n    # Append USE action if the item is grabbable OR a defined primitive resource (which implies USE for collection).\n    # Workshops do not require a USE action after reaching.\n    if is_grabbable_item or (is_defined_primitive_resource and not is_workshop_location):\n      final_actions.append(ACTION_USE) \n  \n  return final_actions", "island_id": 8, "scores": {"3": 0.0}}
