{"timestamp": "2025-08-01T12:55:29.528347", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Determine if the primitive is a type that can be collected via the 'USE' action.\n  # This includes explicit primitive resources (from cookbook), grabbable items, water, or stone.\n  # The crucial improvement in v2 is including `i_kind in world.cookbook.primitives` in this check.\n  is_collectible_via_use = (\n      i_kind in world.cookbook.primitives or # Added this condition in v2\n      i_kind in world.grabbable_indices or\n      i_kind == world.water_index or\n      i_kind == world.stone_index\n  )\n\n  # If the item is not intended to be collected via 'USE', return an empty path.\n  # This acts as an early exit for truly non-collectible primitives like workshops or boundaries,\n  # which are not listed in `world.cookbook.primitives` or `world.grabbable_indices`.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set includes the agent's inventory as part of the state key,\n  # allowing the algorithm to distinguish states that are identical in position/direction\n  # but differ in inventory (e.g., having a tool vs. not).\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Increased MAX_EXPLORED_STATES due to the larger state space when tracking inventory.\n  # This heuristic limit helps prevent excessive computation in complex or unreachable scenarios.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 20 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`).\n    if state.next_to(i_kind):\n        # Case 1: Primitive is directly under the agent and is grabbable.\n        # This explicit check is needed as next_to includes the current cell, and some grabbables are picked up\n        # by USE even if not facing them.\n        if i_kind in world.grabbable_indices and state.grid[current_r, current_c, i_kind] == 1:\n            inventory_before_use = np.copy(state.inventory)\n            _, state_after_use = state.step(USE_ACT)\n            if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                return path + [USE_ACT]\n\n        # Case 2: Primitive is in an adjacent cell (not current cell).\n        # Iterate through all four cardinal directions to check if the primitive is directly in front.\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell directly in front is within bounds and contains the target primitive.\n            # Also ensure it's not the agent's current cell, to avoid re-checking Case 1.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                (facing_r, facing_c) != (current_r, current_c) and # Ensure it's not the current cell\n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the general 'USE' action from the current state.\n    # This is essential for picking up other grabbable items (like tools)\n    # that are not the target primitive itself but might be necessary preconditions.\n    # Only perform USE if there's a potentially interactable entity directly in front or at the current spot.\n    \n    is_something_useable_at_current_spot = False\n    # Check if any grabbable item is present at the current agent's position.\n    for k_idx in world.grabbable_indices:\n        if state.grid[current_r, current_c, k_idx] == 1:\n            is_something_useable_at_current_spot = True\n            break\n    \n    is_something_useable_in_front = False\n    # Determine the cell directly in front of the agent\n    front_dr, front_dc = _DIR_TO_DELTA_FRONT[current_dir]\n    facing_r, facing_c = current_r + front_dr, current_c + front_dc\n\n    # Check bounds for the cell in front\n    if 0 <= facing_r < grid_width and 0 <= facing_c < grid_height:\n        # Check if any grabbable item is present in the cell directly in front.\n        for k_idx in world.grabbable_indices:\n            if state.grid[facing_r, facing_c, k_idx] == 1:\n                is_something_useable_in_front = True\n                break\n        \n        # If still not found, check for water or stone.\n        if not is_something_useable_in_front:\n            if (state.grid[facing_r, facing_c, world.water_index] == 1 or \n                state.grid[facing_r, facing_c, world.stone_index] == 1):\n                is_something_useable_in_front = True\n\n        # NEW for V2: Also check for any other primitive resources in front that might be collected by USE.\n        # This covers items like 'WOOD' (representing a tree) that might need an axe or similar tool\n        # for extraction, even if they are not directly \"grabbable\".\n        if not is_something_useable_in_front:\n            # Iterate through all possible kind indices. If any kind at this cell is a primitive resource,\n            # then it's considered useable.\n            for kind_idx_at_cell in range(state.grid.shape[2]): \n                if state.grid[facing_r, facing_c, kind_idx_at_cell] == 1 and\\\n                   kind_idx_at_cell in world.cookbook.primitives:\n                    is_something_useable_in_front = True\n                    break\n\n    # Only attempt USE_ACT if there's something potentially interactable in front or at the current spot.\n    if is_something_useable_in_front or is_something_useable_at_current_spot:\n        inventory_before_any_use = np.copy(state.inventory)\n        _, state_after_current_use = state.step(USE_ACT)\n        \n        # Add to queue only if the USE action resulted in a meaningful state change.\n        # A meaningful change means inventory or position/direction was updated.\n        # Inventory change is the primary signal for resource collection.\n        if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n                state_after_current_use.pos == state.pos and\n                state_after_current_use.dir == state.dir):\n\n            next_inventory_tuple = tuple(state_after_current_use.inventory)\n            next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n            if next_state_key not in visited:\n                visited.add(next_state_key)\n                q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T12:55:31.189970", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Map the primitive name to its integer ID.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If so, it's already \"collected,\" and no actions are needed.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Determine if the primitive is a type that can be collected via the 'USE' action.\n  # This includes grabbable items (like tools), water, or stone.\n  # ***V2 Enhancement 1: Include all primitive resources from cookbook.***\n  is_collectible_via_use = (\n      i_kind in world.cookbook.primitives or # Added this condition in v2\n      i_kind in world.grabbable_indices or\n      i_kind == world.water_index or\n      i_kind == world.stone_index\n  )\n\n  # If the item is not intended to be collected via 'USE', return an empty path.\n  # This acts as an early exit for truly non-collectible primitives like workshops or boundaries,\n  # which are not listed in `world.cookbook.primitives` or `world.grabbable_indices`.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action constants and directional deltas for grid navigation.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # Delta values for checking the cell directly in front of the agent based on its current direction.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (North)\n      1: (0, 1),  # RIGHT: row, col + 1 (East)\n      2: (1, 0),  # DOWN: row + 1, col (South)\n      3: (0, -1)  # LEFT: row, col - 1 (West)\n  }\n\n  # Helper function to compute the minimal sequence of turns to face a target direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the correct direction.\n\n      # Calculate the difference in directions, wrapping around 0-3.\n      diff = (target_dir - current_dir + 4) % 4\n\n      if diff == 1: # Target is one step clockwise.\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise.\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn.\n          return [RIGHT_ACT, RIGHT_ACT] # Two successive right turns (or left turns).\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The `visited` set stores a tuple `(row, col, direction, inventory_tuple)` to represent\n  # a unique state. Converting inventory (numpy array) to a tuple makes it hashable for the set.\n  visited = set()\n\n  # Add the initial state to the queue and visited set.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, [])) # (current_state, path_to_reach_this_state)\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Heuristic limit to prevent the BFS from running indefinitely in complex or unreachable scenarios.\n  # The multiplier (20) is chosen to allow exploration of states including tool acquisition,\n  # considering `world.cookbook.primitives` can expand the possibilities.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 20\n  explored_states_count = 0\n\n  # 6. BFS Loop: Continues until the queue is empty or the goal is found.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and its associated path.\n    explored_states_count += 1\n\n    # Pruning: If too many distinct states have been explored, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n\n    # Goal Check - can the primitive be collected from the current state?\n    # This now considers two cases:\n    # 1. The primitive is directly under the agent (and is grabbable).\n    # 2. The primitive is in an adjacent cell (requires turning to face and then USE).\n\n    # Case 1: Primitive is directly under the agent and is grabbable.\n    if i_kind in world.grabbable_indices and state.grid[current_r, current_c, i_kind] == 1:\n        inventory_before_use = np.copy(state.inventory)\n        _, state_after_use = state.step(USE_ACT) # Attempt to pick up from current spot.\n\n        if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n            return path + [USE_ACT] # Found a path by picking up from current cell.\n\n    # Case 2: Primitive is in an adjacent cell and requires facing it.\n    # We use state.next_to(i_kind) as a broader hint, then refine by checking specific directions.\n    # Note: state.next_to also checks the current cell, but we've handled that explicitly above for grabbables.\n    if state.next_to(i_kind): # This ensures an item of i_kind is in the 3x3 neighborhood.\n        # Iterate through all four cardinal directions to check if the primitive is directly in front.\n        for target_dir in range(4):\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell directly in front is within bounds and contains the target primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and\n                state.grid[facing_r, facing_c, i_kind] == 1):\n\n                # Calculate and apply the turning actions required to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state\n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Record inventory *before* attempting the 'USE' action to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action on the temporary state.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Crucial verification: Check if the count of the target primitive in inventory\n                # actually increased. This confirms successful collection, accounting for any\n                # game rules (e.g., requiring tools) handled by `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT] # Found a path!\n\n    # Explore possible future states by performing movement actions.\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      # If this next state (position, direction, and inventory) has not been visited, add it to the queue.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n\n    # Explore the general 'USE' action from the current state, even if not directly facing the target primitive.\n    # This is vital for scenarios where using an item at the current location (e.g., picking up a tool)\n    # might enable subsequent collection steps. This general 'USE' acts as a catch-all for various\n    # interactions that change the state (e.g., picking up a tool from the ground, interacting with a workshop).\n    \n    # Determine the cell directly in front of the agent\n    front_dr, front_dc = _DIR_TO_DELTA_FRONT[current_dir]\n    facing_r, facing_c = current_r + front_dr, current_c + front_dc\n\n    is_something_useable_in_front = False\n    # Check bounds for the cell in front\n    if 0 <= facing_r < grid_width and 0 <= facing_c < grid_height:\n        # Check if any grabbable item is present in the cell directly in front.\n        for k_idx in world.grabbable_indices:\n            if state.grid[facing_r, facing_c, k_idx] == 1:\n                is_something_useable_in_front = True\n                break\n        \n        # If still not found, check for water or stone.\n        if not is_something_useable_in_front:\n            if (state.grid[facing_r, facing_c, world.water_index] == 1 or \n                state.grid[facing_r, facing_c, world.stone_index] == 1):\n                is_something_useable_in_front = True\n\n        # ***V2 Enhancement 2: Also check for any other primitive resources in front that might be collected by USE.***\n        # This covers items like 'WOOD' (representing a tree) that might need an axe or similar tool\n        # for extraction, even if they are not directly \"grabbable\".\n        if not is_something_useable_in_front:\n            # Iterate through all possible kind indices. If any kind at this cell is a primitive resource,\n            # then it's considered useable.\n            for kind_idx_at_cell in range(state.grid.shape[2]): \n                if state.grid[facing_r, facing_c, kind_idx_at_cell] == 1 and\\\n                   kind_idx_at_cell in world.cookbook.primitives:\n                    is_something_useable_in_front = True\n                    break\n\n    # Only attempt USE_ACT if there's something potentially interactable in front.\n    if is_something_useable_in_front:\n        inventory_before_any_use = np.copy(state.inventory)\n        _, state_after_current_use = state.step(USE_ACT)\n        \n        # Add to queue only if the USE action resulted in a meaningful state change.\n        # A meaningful change means inventory or position/direction was updated.\n        # Inventory change is the primary signal for resource collection.\n        if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n                state_after_current_use.pos == state.pos and\n                state_after_current_use.dir == state.dir):\n\n            next_inventory_tuple = tuple(state_after_current_use.inventory)\n            next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n            if next_state_key not in visited:\n                visited.add(next_state_key)\n                q.append((state_after_current_use, path + [USE_ACT]))\n\n\n  # 7. If the BFS loop completes and no path to collect the primitive was found,\n  # it means the primitive is currently unreachable given the environment and agent's capabilities.\n  return []", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T12:57:15.643045", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n    \n    Refines the adaptive search limits and adds more detailed comments regarding the BFS strategy.\n    Specifically, it increases the maximum path length allowed, making the search more robust\n    for complex or larger grid environments where longer detours might be necessary.\n  \"\"\"\n  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Semantic check: Determine if this primitive is *actually* collectible into inventory.\n  # This includes items defined as primitives, special environment items like water/stone,\n  # and any other items explicitly marked as grabbable.\n  is_primitive_resource = i_kind in world.cookbook.primitives\n  is_special_collectible_environment = (i_kind == world.water_index or i_kind == world.stone_index)\n  is_grabbable = i_kind in world.grabbable_indices\n\n  if not (is_primitive_resource or is_special_collectible_environment or is_grabbable):\n      # The requested primitive is not collectible by means of \"collect\" action.\n      # E.g., Workshops are locations, not items that can be collected into inventory.\n      return []\n\n  # 3. Check if the primitive is already in the agent's inventory.\n  if current_state.inventory[i_kind] > 0:\n      # Primitive is already collected, no actions needed.\n      return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # Delta coordinates for each direction (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT) relative to agent's position (row_delta, col_delta).\n  _DIRECTION_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row decreases, col stays same\n      1: (0, 1),  # RIGHT: row stays same, col increases\n      2: (1, 0),  # DOWN: row increases, col stays same\n      3: (0, -1)  # LEFT: row stays same, col decreases\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return []\n      # Calculate difference ensuring it's positive and within [0, 3] for turns.\n      diff = (target_dir - current_dir + 4) % 4\n      if diff == 1: # Clockwise turn (e.g., UP to RIGHT)\n          return [RIGHT_ACT]\n      elif diff == 3: # Counter-clockwise turn (e.g., UP to LEFT)\n          return [LEFT_ACT]\n      else: # diff == 2 (180-degree turn, e.g., UP to DOWN)\n          return [RIGHT_ACT, RIGHT_ACT] # Two right turns (or two left turns)\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The `visited` set tracks states already explored to prevent cycles and redundant work.\n  # A state is defined by (grid_hash, row, col, direction, inventory_tuple).\n  # `grid.tobytes()` is used for hashing the grid, ensuring distinct grid layouts are treated as distinct states.\n  # This is crucial because `USE_ACT` can modify the grid (e.g., removing a tree).\n  visited = set() \n\n  initial_inventory_tuple = tuple(current_state.inventory)\n  initial_grid_hash = hash(current_state.grid.tobytes()) \n\n  q.append((current_state, [])) # Queue stores (CraftState object, path_to_reach_this_state)\n  visited.add((initial_grid_hash, current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_rows, grid_cols, _ = current_state.grid.shape # Get grid dimensions as (rows, columns, kinds)\n\n  # Adaptive search limits:\n  # MAX_EXPLORED_STATES: Limits the total number of unique states processed to prevent\n  #                      runaway searches in very large or complex state spaces.\n  #                      The factor 150 allows for a wide range of grid/inventory permutations.\n  MAX_EXPLORED_STATES = grid_rows * grid_cols * 4 * 150 \n  \n  # MAX_PATH_LENGTH: Limits the length of any path considered. Set adaptively based on\n  #                  the grid dimensions, allowing for longer paths on larger maps,\n  #                  plus a buffer for turns and interactions. Increased from v1's (rows+cols)*3\n  #                  to (rows+cols)*5 for greater robustness in complex environments.\n  MAX_PATH_LENGTH = (grid_rows + grid_cols) * 5 \n\n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft()\n    explored_states_count += 1\n\n    # Pruning: If exploration limits are reached, stop exploring from this path.\n    # This prevents the search from becoming excessively long or consuming too much memory/time.\n    if explored_states_count > MAX_EXPLORED_STATES or len(path) >= MAX_PATH_LENGTH:\n      continue\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n\n    # List to store (next_state_object, actions_to_reach_next_state, inventory_before_last_action_applied)\n    # Storing 'inventory_before_last_action_applied' is crucial for detecting if the goal item\n    # was *specifically* acquired in the last step of a transition.\n    potential_next_transitions = []\n\n    # --- Generate all potential next states from the current state ---\n\n    # 1. Explore Movement Actions (UP, DOWN, LEFT, RIGHT)\n    for action in move_actions:\n        # Simulate step. The 'reward' is always 0.0 for this environment implementation.\n        # The 'inventory_before_move' is the current state's inventory, for later comparison.\n        inventory_before_move = np.copy(state.inventory)\n        _, next_state = state.step(action)\n        potential_next_transitions.append((next_state, path + [action], inventory_before_move))\n\n    # 2. Explore USE_ACT at the agent's current position.\n    # This covers collecting items directly from the cell the agent is standing on (e.g., grabbable items).\n    inventory_before_use_at_pos = np.copy(state.inventory)\n    grid_before_use_at_pos = np.copy(state.grid)\n    _, state_after_use_at_pos = state.step(USE_ACT)\n    \n    # Check if USE_ACT at current position resulted in a meaningful state change.\n    # A change implies interaction (e.g., item collected, grid modified).\n    state_changed_by_use_at_pos = not (\n        np.array_equal(state_after_use_at_pos.inventory, inventory_before_use_at_pos) and\n        state_after_use_at_pos.pos == state.pos and # Position usually unchanged by USE\n        state_after_use_at_pos.dir == state.dir and # Direction usually unchanged by USE\n        np.array_equal(state_after_use_at_pos.grid, grid_before_use_at_pos) # Grid can change if item removed/resource harvested\n    )\n    if state_changed_by_use_at_pos:\n        potential_next_transitions.append((state_after_use_at_pos, path + [USE_ACT], inventory_before_use_at_pos))\n    \n    # 3. Explore USE_ACT on adjacent cells (after turning to face them).\n    # This handles interacting with entities in the surrounding environment (e.g., chopping trees, mining rocks).\n    for target_dir_idx in range(4): # Iterate through all four possible facing directions (0, 1, 2, 3)\n        row_delta, col_delta = _DIRECTION_TO_DELTA_FRONT[target_dir_idx]\n        facing_r, facing_c = current_r + row_delta, current_c + col_delta\n\n        # Check if the cell the agent would face is within grid bounds AND contains any entity.\n        # This broad check is necessary because we don't know which specific entity yields the primitive\n        # without inspecting CraftState's internal logic for USE_ACT.\n        if (0 <= facing_r < grid_rows and 0 <= facing_c < grid_cols) and np.any(state.grid[facing_r, facing_c, :] == 1):\n            turns_to_face = _get_turning_actions(current_dir, target_dir_idx)\n            \n            # Simulate the turning actions to get to the correct orientation.\n            # Create a temporary state to apply turns without altering the 'state' from the queue.\n            temp_state_before_use = state \n            for turn_action in turns_to_face:\n                _, temp_state_before_use = temp_state_before_use.step(turn_action)\n            \n            # Capture inventory and grid states immediately before the final USE_ACT.\n            inventory_before_adj_use = np.copy(temp_state_before_use.inventory)\n            grid_before_adj_use = np.copy(temp_state_before_use.grid)\n            \n            # Perform the USE_ACT.\n            _, state_after_adj_use = temp_state_before_use.step(USE_ACT)\n            \n            # Check if USE_ACT on adjacent cell resulted in a meaningful state change.\n            state_changed_by_adj_use = not (\n                np.array_equal(state_after_adj_use.inventory, inventory_before_adj_use) and\n                state_after_adj_use.pos == temp_state_before_use.pos and\n                state_after_adj_use.dir == temp_state_before_use.dir and\n                np.array_equal(state_after_adj_use.grid, grid_before_adj_use)\n            )\n            if state_changed_by_adj_use:\n                potential_next_transitions.append(\n                    (state_after_adj_use, path + turns_to_face + [USE_ACT], inventory_before_adj_use)\n                )\n\n    # --- Process all generated potential next transitions ---\n    for next_s, next_p, inv_before_action in potential_next_transitions:\n        # Check if the target primitive was successfully collected in this specific transition.\n        # This is the goal condition for the 'collect' function.\n        if next_s.inventory[i_kind] > inv_before_action[i_kind]:\n            return next_p # Goal achieved! Return the shortest path immediately (due to BFS property).\n\n        # If not the goal, add the new state to the queue if it hasn't been visited yet.\n        next_inventory_tuple = tuple(next_s.inventory)\n        next_grid_hash = hash(next_s.grid.tobytes())\n        next_state_key = (next_grid_hash, next_s.pos[0], next_s.pos[1], next_s.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((next_s, next_p))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state within the search limits.\n  return []", "island_id": 6, "scores": {"3": 2.5}}
{"timestamp": "2025-08-01T12:57:31.018596", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Semantic check: Determine if this primitive is *actually* collectible into inventory.\n  # This includes items defined as primitives, special environment items like water/stone,\n  # and any other items explicitly marked as grabbable.\n  is_primitive_resource = i_kind in world.cookbook.primitives\n  is_special_collectible_environment = (i_kind == world.water_index or i_kind == world.stone_index)\n  is_grabbable = i_kind in world.grabbable_indices\n\n  if not (is_primitive_resource or is_special_collectible_environment or is_grabbable):\n      # The requested primitive is not collectible by means of \"collect\" action.\n      # E.g., Workshops are locations, not items that can be collected into inventory.\n      return []\n\n  # 3. Check if the primitive is already in the agent's inventory.\n  if current_state.inventory[i_kind] > 0:\n      # Primitive is already collected, no actions needed.\n      return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # Delta coordinates for each direction (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT) relative to agent's position (row_delta, col_delta).\n  _DIRECTION_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row decreases, col stays same\n      1: (0, 1),  # RIGHT: row stays same, col increases\n      2: (1, 0),  # DOWN: row increases, col stays same\n      3: (0, -1)  # LEFT: row stays same, col decreases\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return []\n      # Calculate difference ensuring it's positive and within [0, 3] for turns.\n      diff = (target_dir - current_dir + 4) % 4\n      if diff == 1: # Clockwise turn (e.g., UP to RIGHT)\n          return [RIGHT_ACT]\n      elif diff == 3: # Counter-clockwise turn (e.g., UP to LEFT)\n          return [LEFT_ACT]\n      else: # diff == 2 (180-degree turn, e.g., UP to DOWN)\n          return [RIGHT_ACT, RIGHT_ACT] # Two right turns (or two left turns)\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The visited set must capture the relevant parts of the state to prevent redundant exploration.\n  # For collect_v2, the improvement is to make the 'inventory' part of the visited key\n  # specific to the target primitive's count, ignoring changes to irrelevant inventory items.\n  # State key: (grid_hash, row, col, direction, target_primitive_count_in_inventory)\n  visited = set() \n\n  initial_grid_hash = hash(current_state.grid.tobytes()) \n  initial_target_item_count = current_state.inventory[i_kind] # Only track the target item's count\n\n  q.append((current_state, [])) # Queue stores (CraftState object, path_to_reach_this_state)\n  visited.add((initial_grid_hash, current_state.pos[0], current_state.pos[1], current_state.dir, initial_target_item_count))\n\n  grid_rows, grid_cols, _ = current_state.grid.shape\n\n  # Adaptive search limits:\n  MAX_EXPLORED_STATES = grid_rows * grid_cols * 4 * 150 \n  MAX_PATH_LENGTH = (grid_rows + grid_cols) * 3 \n\n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft()\n    explored_states_count += 1\n\n    # Pruning: If exploration limits are reached, stop.\n    if explored_states_count > MAX_EXPLORED_STATES or len(path) >= MAX_PATH_LENGTH:\n      continue\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n\n    # List to store (next_state_object, actions_to_reach_next_state, inventory_before_last_action)\n    # Storing 'inventory_before_last_action' is crucial for detecting if the goal item\n    # was *specifically* acquired in the transition.\n    potential_next_transitions = []\n\n    # --- Generate all potential next states from the current state ---\n\n    # 1. Explore Movement Actions (UP, DOWN, LEFT, RIGHT)\n    for action in move_actions:\n        # Simulate step. The 'inventory_before_move' is the current state's inventory, for later comparison.\n        inventory_before_move = np.copy(state.inventory)\n        _, next_state = state.step(action)\n        potential_next_transitions.append((next_state, path + [action], inventory_before_move))\n\n    # 2. Explore USE_ACT at the agent's current position.\n    # This covers collecting items directly from the cell the agent is standing on (e.g., grabbable items).\n    inventory_before_use_at_pos = np.copy(state.inventory)\n    grid_before_use_at_pos = np.copy(state.grid)\n    _, state_after_use_at_pos = state.step(USE_ACT)\n    \n    # Check if USE_ACT at current position resulted in a meaningful state change.\n    # A change implies interaction (e.g., item collected, grid modified).\n    state_changed_by_use_at_pos = not (\n        np.array_equal(state_after_use_at_pos.inventory, inventory_before_use_at_pos) and\n        state_after_use_at_pos.pos == state.pos and \n        state_after_use_at_pos.dir == state.dir and\n        np.array_equal(state_after_use_at_pos.grid, grid_before_use_at_pos)\n    )\n    if state_changed_by_use_at_pos:\n        potential_next_transitions.append((state_after_use_at_pos, path + [USE_ACT], inventory_before_use_at_pos))\n    \n    # 3. Explore USE_ACT on adjacent cells (after turning to face them).\n    # This handles interacting with entities in the surrounding environment (e.g., chopping trees, mining rocks).\n    for target_dir_idx in range(4): # Iterate through all four possible facing directions (0, 1, 2, 3)\n        row_delta, col_delta = _DIRECTION_TO_DELTA_FRONT[target_dir_idx]\n        facing_r, facing_c = current_r + row_delta, current_c + col_delta\n\n        # Check if the cell the agent would face is within grid bounds AND contains any entity.\n        if (0 <= facing_r < grid_rows and 0 <= facing_c < grid_cols) and np.any(state.grid[facing_r, facing_c, :] == 1):\n            turns_to_face = _get_turning_actions(current_dir, target_dir_idx)\n            \n            # Simulate the turning actions to get to the correct orientation.\n            temp_state_before_use = state \n            for turn_action in turns_to_face:\n                _, temp_state_before_use = temp_state_before_use.step(turn_action)\n            \n            # Capture inventory and grid states immediately before the final USE_ACT.\n            inventory_before_adj_use = np.copy(temp_state_before_use.inventory)\n            grid_before_adj_use = np.copy(temp_state_before_use.grid)\n            \n            # Perform the USE_ACT.\n            _, state_after_adj_use = temp_state_before_use.step(USE_ACT)\n            \n            # Check if USE_ACT on adjacent cell resulted in a meaningful state change.\n            state_changed_by_adj_use = not (\n                np.array_equal(state_after_adj_use.inventory, inventory_before_adj_use) and\n                state_after_adj_use.pos == temp_state_before_use.pos and\n                state_after_adj_use.dir == temp_state_before_use.dir and\n                np.array_equal(state_after_adj_use.grid, grid_before_adj_use)\n            )\n            if state_changed_by_adj_use:\n                potential_next_transitions.append(\n                    (state_after_adj_use, path + turns_to_face + [USE_ACT], inventory_before_adj_use)\n                )\n\n    # --- Process all generated potential next transitions ---\n    for next_s, next_p, inv_before_action in potential_next_transitions:\n        # Check if the target primitive was successfully collected in this specific transition.\n        if next_s.inventory[i_kind] > inv_before_action[i_kind]:\n            return next_p # Goal achieved! Return the shortest path immediately.\n\n        # Calculate the new visited state key using only the target primitive's count.\n        next_grid_hash = hash(next_s.grid.tobytes())\n        next_target_item_count = next_s.inventory[i_kind]\n        next_state_key = (next_grid_hash, next_s.pos[0], next_s.pos[1], next_s.dir, next_target_item_count)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((next_s, next_p))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state within the search limits.\n  return []", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T12:58:23.341668", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state # Access the current state of the environment\n  \n  # Extract relevant information from the current state\n  grid = current_state.grid # The environment grid (WIDTH, HEIGHT, n_kinds)\n  initial_pos = current_state.pos # Agent's starting position (row, col)\n  initial_dir = current_state.dir # Agent's starting direction (0:R, 1:U, 2:L, 3:D)\n\n  # Get the integer ID for the target primitive from the cookbook index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Get grid dimensions\n  GRID_WIDTH, GRID_HEIGHT, _ = grid.shape\n\n  # Map action names from the DSL/environment to their integer indices\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP'] # Assuming 'UP' corresponds to moving forward\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE'] # Action to collect the item\n\n  # Define how agent's position changes when moving forward based on direction\n  # (dr, dc) tuple for (delta_row, delta_col)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT (0): (R, C+1)\n      1: (-1, 0),  # Facing UP (1):   (R-1, C)\n      2: (0, -1),  # Facing LEFT (2): (R, C-1)\n      3: (1, 0)    # Facing DOWN (3): (R+1, C)\n  }\n\n  # Define how agent's direction changes when turning\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # R(0)->U(1)->L(2)->D(3)->R(0)\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # R(0)->D(3)->L(2)->U(1)->R(0)\n\n  # Identify entity kinds that the agent cannot walk onto.\n  # This includes general non-grabbable items (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  # AND the primitive itself, as the agent needs to stop *adjacent* to it to USE.\n  unwalkable_kind_ids = set(current_state.world.non_grabbable_indices)\n  unwalkable_kind_ids.add(primitive_id) \n\n  # BFS setup\n  # Queue stores elements: ((current_pos_tuple, current_dir_int), list_of_actions_to_reach_here)\n  queue = collections.deque([((initial_pos[0], initial_pos[1], initial_dir), [])])\n  # Visited set stores (row, col, direction) tuples to avoid redundant exploration and cycles\n  visited = {(initial_pos[0], initial_pos[1], initial_dir)}\n\n  target_path_actions = None # To store the sequence of actions once the target state is found\n\n  # Start BFS\n  while queue:\n      (r, c, current_dir), path_actions = queue.popleft()\n\n      # Check if the target primitive is in the cell directly in front of the agent\n      # Calculate coordinates of the cell directly in front\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the front cell is within grid boundaries\n      if (0 <= front_r < GRID_WIDTH and 0 <= front_c < GRID_HEIGHT):\n          # Check if the front cell contains the primitive\n          if grid[front_r, front_c, primitive_id] > 0:\n              target_path_actions = path_actions # Path to reach adjacent-and-facing state found\n              break # Exit BFS, target found\n\n      # Explore possible next actions: Move Forward, Turn Left, Turn Right\n      \n      # 1. Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r_move, next_c_move = r + move_dr, c + move_dc\n      next_pos_move = (next_r_move, next_c_move)\n      next_dir_move = current_dir # Moving forward does not change facing direction\n      next_state_move = (next_r_move, next_c_move, next_dir_move)\n\n      # Check if the next position is within bounds and this (pos, dir) state hasn't been visited\n      if (0 <= next_r_move < GRID_WIDTH and 0 <= next_c_move < GRID_HEIGHT and\n          next_state_move not in visited):\n          \n          # Check if the next position is walkable\n          is_walkable = True\n          for kind_idx in unwalkable_kind_ids:\n              if grid[next_r_move, next_c_move, kind_idx] > 0: # If the cell contains an unwalkable kind\n                  is_walkable = False\n                  break\n          \n          if is_walkable:\n              visited.add(next_state_move)\n              queue.append((next_state_move, path_actions + [MOVE_FORWARD_ACTION]))\n\n      # 2. Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      next_state_left = (r, c, next_dir_left) # Turning only changes direction, not position\n      if (next_state_left not in visited):\n          visited.add(next_state_left)\n          queue.append((next_state_left, path_actions + [TURN_LEFT_ACTION]))\n\n      # 3. Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      next_state_right = (r, c, next_dir_right) # Turning only changes direction, not position\n      if (next_state_right not in visited):\n          visited.add(next_state_right)\n          queue.append((next_state_right, path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path to the adjacent-and-facing state was found, append the USE action\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T12:58:24.514803", "function_name": "collect", "function_body": "  \"\"\"Returns a list of actions to find and collect the primitive in the passed env using BFS.\n  The goal is to navigate the agent to a position *adjacent* to the primitive and *facing* it,\n  then execute the 'USE' action.\n\n    Args:\n        env (env.CraftLab): The CraftLab object containing the current game state.\n        primitive (str): The name of the primitive item to collect (e.g., \"WOOD\", \"STONE\").\n\n    Returns:\n        List[int]: A sequence of integer action IDs to execute. Returns an empty list\n                   if the primitive is not found or is unreachable.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state # Get the current state of the environment\n\n  # Extract essential information from the current state\n  grid = current_state.grid # The static grid layout (WIDTH, HEIGHT, n_kinds)\n  initial_pos = current_state.pos # Agent's current position (row, col tuple)\n  initial_dir = current_state.dir # Agent's current facing direction (int: 0=R, 1=U, 2=L, 3=D)\n\n  # Get the unique integer ID for the target primitive from the cookbook\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Get grid dimensions for boundary checks\n  GRID_WIDTH, GRID_HEIGHT, _ = grid.shape\n\n  # Map action names (from DSL/environment) to their integer indices\n  action_map = env.action_specs()\n  ACTION_MOVE_FORWARD = action_map['UP'] # Assuming 'UP' is the action to move in current facing direction\n  ACTION_TURN_LEFT = action_map['LEFT']\n  ACTION_TURN_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE'] # Action to interact/collect\n\n  # Define how agent's (row, col) position changes based on its current direction\n  # (dr, dc) = (delta_row, delta_col)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP:    (row-1, col)\n      2: (0, -1),  # Facing LEFT:  (row, col-1)\n      3: (1, 0)    # Facing DOWN:  (row+1, col)\n  }\n\n  # Define how agent's direction changes when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # R(0)->U(1)->L(2)->D(3)->R(0)\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # R(0)->D(3)->L(2)->U(1)->R(0)\n\n  # Identify entity kinds that the agent *cannot* walk onto.\n  # This includes general non-grabbable entities (e.g., BOUNDARY, WATER, WORKSHOP0/1/2)\n  # AND critically, the primitive itself. The agent must stand *adjacent* to the primitive\n  # to collect it, not on its square.\n  unwalkable_kind_ids = set(current_state.world.non_grabbable_indices)\n  unwalkable_kind_ids.add(primitive_id) \n\n  # --- BFS (Breadth-First Search) Implementation ---\n  # Queue stores tuples: ((row, col, direction), [list_of_actions_to_reach_this_state])\n  queue = collections.deque([((initial_pos[0], initial_pos[1], initial_dir), [])])\n  \n  # Visited set stores (row, col, direction) tuples to avoid re-exploring states and cycles\n  visited = {(initial_pos[0], initial_pos[1], initial_dir)}\n\n  target_path_found = None # This will store the list of actions if a path to the pre-use state is found\n\n  while queue:\n      (r, c, current_dir), path_actions = queue.popleft()\n\n      # 1. Check if the current state is the *goal state* for pathfinding:\n      # Is the target primitive located directly in front of the agent?\n      # Calculate coordinates of the cell directly in front of the agent\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the 'front' cell is within grid boundaries\n      if (0 <= front_r < GRID_WIDTH and 0 <= front_c < GRID_HEIGHT):\n          # Check if the 'front' cell contains the primitive\n          if grid[front_r, front_c, primitive_id] > 0:\n              target_path_found = path_actions # We found the path to be adjacent and facing\n              break # Exit BFS, we found the shortest path to the pre-collection state\n\n      # 2. Explore possible next actions from the current state: Move, Turn Left, Turn Right\n      \n      # --- Try Move Forward ---\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r_move, next_c_move = r + move_dr, c + move_dc\n      next_dir_move = current_dir # Direction remains the same after moving\n      next_state_move = (next_r_move, next_c_move, next_dir_move)\n\n      # Check bounds and if this specific (position, direction) state has been visited\n      if (0 <= next_r_move < GRID_WIDTH and 0 <= next_c_move < GRID_HEIGHT and\n          next_state_move not in visited):\n          \n          # Check if the potential next position is walkable (i.e., not an obstacle)\n          is_walkable = True\n          for kind_idx in unwalkable_kind_ids:\n              # If the cell contains ANY unwalkable kind, it's not walkable\n              if grid[next_r_move, next_c_move, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          \n          if is_walkable:\n              visited.add(next_state_move)\n              queue.append((next_state_move, path_actions + [ACTION_MOVE_FORWARD]))\n\n      # --- Try Turn Left ---\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      next_state_left = (r, c, next_dir_left) # Position remains the same after turning\n      if (next_state_left not in visited):\n          visited.add(next_state_left)\n          queue.append((next_state_left, path_actions + [ACTION_TURN_LEFT]))\n\n      # --- Try Turn Right ---\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      next_state_right = (r, c, next_dir_right) # Position remains the same after turning\n      if (next_state_right not in visited):\n          visited.add(next_state_right)\n          queue.append((next_state_right, path_actions + [ACTION_TURN_RIGHT]))\n\n  # --- Post-BFS Processing ---\n  # If a path to the adjacent-and-facing state was found, add the final USE action\n  if target_path_found is not None:\n      actions_list.extend(target_path_found) # Add the movement/turn actions\n      actions_list.append(ACTION_USE)      # Add the collection action\n\n  return actions_list", "island_id": 0, "scores": {"3": 0.5}}
