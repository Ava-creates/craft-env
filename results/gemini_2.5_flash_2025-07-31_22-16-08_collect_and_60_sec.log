{"timestamp": "2025-08-01T12:07:08.686611", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Determine the nature of the target primitive.\n  # This distinction is crucial for defining the \"goal state\" in BFS.\n  is_target_workshop = (i_kind in world.workshop_indices)\n  \n  # A target is \"inventory-collectible\" if its presence would typically be indicated\n  # by an increase in inventory after a 'USE' action.\n  is_target_inventory_collectible = (\n      i_kind in world.cookbook.primitives or \n      i_kind in world.grabbable_indices or\n      i_kind == world.water_index or\n      i_kind == world.stone_index\n  )\n\n  # If the target is neither a workshop nor an inventory-collectible item,\n  # then 'collect' cannot achieve this goal. (e.g., \"boundary\" cannot be collected)\n  if not is_target_workshop and not is_target_inventory_collectible:\n      return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set includes the agent's inventory as part of the state key,\n  # allowing the algorithm to distinguish states that are identical in position/direction\n  # but differ in inventory (e.g., having a tool vs. not).\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Increased MAX_EXPLORED_STATES due to the larger state space when tracking inventory\n  # and considering workshop interactions. This heuristic limit helps prevent excessive \n  # computation in complex or unreachable scenarios.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 40 # Increased multiplier from 20 to 40 for v2\n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # --- GOAL CHECK ---\n    # Case 1: If the target primitive is a workshop, the goal is to be at its location.\n    if is_target_workshop:\n        if state.grid[current_r, current_c, i_kind] == 1:\n            return path # Agent is standing on the workshop. Goal achieved.\n\n    # Case 2: If the target primitive is an inventory-collectible item.\n    if is_target_inventory_collectible:\n        # Check if the primitive is in the 3x3 neighborhood around the agent.\n        if state.next_to(i_kind):\n            # If so, find its exact location, turn towards it, and attempt to 'USE'.\n            for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n                dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n                facing_r, facing_c = current_r + dr, current_c + dc\n\n                if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                    state.grid[facing_r, facing_c, i_kind] == 1):\n                    \n                    # Simulate the turning actions to face the primitive.\n                    turns_to_face = _get_turning_actions(current_dir, target_dir)\n                    temp_state_after_turns = state \n                    for turn_action in turns_to_face:\n                        _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                    # Store inventory before attempting USE to verify collection.\n                    inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                    # Simulate the 'USE' action.\n                    _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                    # Critical check: Did the count of the primitive in inventory actually increase?\n                    # This verifies successful collection, accounting for any internal game rules\n                    # (e.g., tools needed) implemented in `CraftState.step`.\n                    if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                        return path + turns_to_face + [USE_ACT]\n\n    # --- EXPLORE ACTIONS ---\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the general 'USE' action from the current state.\n    # This is essential for picking up other grabbable items (like tools),\n    # gathering basic resources (water/stone), or for crafting at workshops\n    # that are not the target primitive itself but might be necessary preconditions.\n    \n    is_action_use_applicable = False\n\n    # Check 1: Is there something interactable directly in front of the agent?\n    front_dr, front_dc = _DIR_TO_DELTA_FRONT[current_dir]\n    facing_r, facing_c = current_r + front_dr, current_c + front_dc\n\n    if 0 <= facing_r < grid_width and 0 <= facing_c < grid_height:\n        # Check for any kind of entity in front that might be interacted with via 'USE'.\n        for kind_idx_at_cell in range(state.grid.shape[2]): \n            if state.grid[facing_r, facing_c, kind_idx_at_cell] == 1:\n                # This includes grabbable items, water, stone, and any cookbook primitive.\n                if (kind_idx_at_cell in world.grabbable_indices or\n                    kind_idx_at_cell == world.water_index or\n                    kind_idx_at_cell == world.stone_index or\n                    kind_idx_at_cell in world.cookbook.primitives):\n                    is_action_use_applicable = True\n                    break\n    \n    # Check 2: Is the agent standing on a workshop?\n    # The 'USE' action can also trigger crafting if the agent is positioned on a workshop tile.\n    if not is_action_use_applicable: # Only check this if not already applicable by front cell\n        for workshop_idx in world.workshop_indices:\n            if state.grid[current_r, current_c, workshop_idx] == 1:\n                is_action_use_applicable = True\n                break\n\n    # Only attempt USE_ACT if `is_action_use_applicable` is True.\n    if is_action_use_applicable:\n        inventory_before_any_use = np.copy(state.inventory)\n        _, state_after_current_use = state.step(USE_ACT)\n        \n        # Add to queue only if the USE action resulted in a meaningful state change.\n        # A meaningful change means inventory or position/direction was updated.\n        # Inventory change is the primary signal for resource collection/crafting.\n        if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n                state_after_current_use.pos == state.pos and\n                state_after_current_use.dir == state.dir):\n\n            next_inventory_tuple = tuple(state_after_current_use.inventory)\n            next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n            if next_state_key not in visited:\n                visited.add(next_state_key)\n                q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T12:08:37.054784", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` with optimized 'USE' action exploration conditions.\n    \n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect.\n\n    Returns:\n        List[int]: A sequence of action indices to execute.\n  \"\"\"\n  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set stores a tuple representing (row, col, direction, inventory_tuple).\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing.\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # MAX_EXPLORED_STATES is a pragmatic limit to prevent extremely long searches.\n  # The multiplier '10' accounts for different relevant inventory states that might\n  # be reached (e.g., picking up a tool) during the search for the primitive.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # OPTIMIZATION for v2: Pre-convert `world.grabbable_indices` and `world.workshop_indices`\n  # to sets for faster `O(1)` average time lookups during the BFS loop.\n  grabbable_indices_set = set(world.grabbable_indices)\n  workshop_indices_set = set(world.workshop_indices)\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, skip processing this state.\n    # This acts as a soft limit, allowing states already in the queue to be processed,\n    # but prevents the search from expanding indefinitely from very long paths.\n    if explored_states_count > MAX_EXPLORED_STATES:\n        continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`).\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Ensure the facing cell is within grid bounds and contains the target primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                temp_state_after_turns = state \n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                for turn_action in turns_to_face:\n                    # Reward is always 0.0 in this implementation, so we use `_`.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                # Reward is always 0.0 in this implementation, so we use `_`.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed, resource depletion) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      # Reward is always 0.0, so we use `_`.\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # OPTIMIZATION for v2: More efficiently check if a 'USE' action is worth exploring.\n    # A USE action is considered potentially useful if the agent is next to any grabbable item\n    # (which could be a tool or resource) OR if the agent is currently on a workshop.\n    \n    found_any_grabbable_next_to = False\n    # Check 3x3 neighborhood for any grabbable item (excluding current cell for 'next_to' semantic).\n    # This avoids repeated calls to `state.next_to` for each grabbable_index,\n    # improving efficiency when there are many grabbable types.\n    for r_offset in [-1, 0, 1]:\n        for c_offset in [-1, 0, 1]:\n            nr, nc = current_r + r_offset, current_c + c_offset\n            # Ensure cell is within grid bounds and is not the agent's current position (itself).\n            if (0 <= nr < grid_width and 0 <= nc < grid_height and \n                (nr, nc) != (current_r, current_c)): \n                # Check if *any* grabbable item is present at this (nr, nc) location.\n                for grabbable_idx in grabbable_indices_set: # Use the pre-converted set for O(1) average lookup\n                    if state.grid[nr, nc, grabbable_idx] == 1:\n                        found_any_grabbable_next_to = True\n                        break # Found one grabbable in this cell, no need to check others for this cell\n            if found_any_grabbable_next_to:\n                break # Found a grabbable in the neighborhood, no need to check other cells\n        if found_any_grabbable_next_to:\n            break # Found a grabbable in the neighborhood, no need to check other rows\n\n    # Check if agent is currently on a workshop cell.\n    is_on_workshop = any(state.grid[current_r, current_c, idx] == 1 for idx in workshop_indices_set) # Use the pre-converted set\n\n    if found_any_grabbable_next_to or is_on_workshop:\n        inventory_before_any_use = np.copy(state.inventory)\n        # Reward is always 0.0, so we use `_`.\n        _, state_after_current_use = state.step(USE_ACT)\n        \n        # Only add to queue if the USE action resulted in a meaningful state change\n        # (inventory, position, or direction changed). This prevents exploring redundant states.\n        if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n                state_after_current_use.pos == state.pos and\n                state_after_current_use.dir == state.dir):\n\n            next_inventory_tuple = tuple(state_after_current_use.inventory)\n            next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n            if next_state_key not in visited:\n                visited.add(next_state_key)\n                q.append((state_after_current_use, path + [USE_ACT]))\n\n  # If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T12:08:38.496951", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  # This avoids unnecessary searches for items that can't be \"collected\" this way.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n  all_actions = move_actions + [USE_ACT] # All actions to explore in BFS\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set now includes the agent's inventory as part of the state key.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing, allowing BFS to distinguish\n  # between states that are identical in position/direction but differ in inventory (e.g., having a tool vs. not).\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, [])) # Queue stores (CraftState, list of actions to reach this state)\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  \n  # IMPROVEMENT for v2: Introduce explicit search limits for performance and practicality.\n  # MAX_STATES_TO_EXPLORE limits the total number of unique (position, direction, inventory) states visited.\n  # This prevents the search from becoming too wide. The '10' is a heuristic for relevant inventory states.\n  MAX_STATES_TO_EXPLORE = grid_width * grid_height * 4 * 10 \n  # MAX_PATH_LENGTH limits the maximum number of actions in a found plan.\n  # This prevents the search from becoming too deep, ensuring plans are reasonably short.\n  MAX_PATH_LENGTH = 75 # A heuristic: collecting a primitive usually shouldn't take more than this many steps.\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n\n    # Pruning based on maximum path length.\n    # If the current path is already too long, we don't explore further from this state.\n    if len(path) >= MAX_PATH_LENGTH:\n        continue # Skip processing this state, but continue with shorter paths in the queue.\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`) in the 3x3 neighborhood.\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Ensure the facing cell is within grid bounds and contains the target primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                temp_state_after_turns = state \n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                for turn_action in turns_to_face:\n                    # Reward is always 0.0, so we use `_` for the unused return value.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                # Reward is always 0.0, so we use `_` for the unused return value.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed, resource depletion) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore all possible actions (movements and the generic USE action).\n    # Trying USE is important because it might involve picking up tools or interacting with\n    # objects at the current location which are necessary for subsequent steps to collect the primitive.\n    for action in all_actions:\n      inventory_before_step = np.copy(state.inventory) # Snapshot inventory before the step.\n\n      # Reward is always 0.0, so we use `_` for the unused return value.\n      _, next_state = state.step(action)\n      \n      # Pruning: Check if the action actually resulted in a meaningful state change.\n      # If the inventory, position, and direction are all unchanged, this action was a no-op\n      # (e.g., moving into a wall, using an empty space). Don't explore this redundant branch.\n      if (np.array_equal(next_state.inventory, inventory_before_step) and\n          next_state.pos == state.pos and\n          next_state.dir == state.dir):\n          continue # Action had no effect, don't add to queue.\n\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      # IMPROVEMENT for v2: Pruning based on maximum number of visited states.\n      # This check is performed *before* adding a new state to the visited set and queue,\n      # ensuring we don't exceed the total state exploration budget.\n      if len(visited) >= MAX_STATES_TO_EXPLORE:\n          continue # Don't add more states if we've already explored too many unique ones.\n\n      if next_state_key not in visited:\n          visited.add(next_state_key)\n          q.append((next_state, path + [action]))\n\n  # If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions\n  # and the defined search limits.\n  return []", "island_id": 5, "scores": {"3": 1.5}}
