{"timestamp": "2025-08-01T11:01:43.785859", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (r, c)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  # Get the integer ID for the target primitive\n  primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # Map DSL movement/turn actions to their integer indices from action_specs\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  # Defines how position changes when moving \"forward\" in a given direction.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT (positive column)\n      1: (-1, 0),  # Facing UP (negative row)\n      2: (0, -1),  # Facing LEFT (negative column)\n      3: (1, 0)    # Facing DOWN (positive row)\n  }\n\n  # Map for turning left/right, updating the agent's direction (0-3)\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Identify all kinds of entities that the agent cannot walk onto.\n  # This includes general non-grabbable items (like boundaries, water, workshops)\n  # AND the primitive itself (as the agent needs to stop *adjacent* to it, not on it).\n  unwalkable_kind_ids = set(current_state.world.non_grabbable_indices)\n  unwalkable_kind_ids.add(primitive_id) \n\n  # BFS state: ((row, col), direction), path_actions\n  # Queue stores ( (current_pos_tuple, current_dir_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (current_pos_tuple, current_dir_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # Stores the action list to reach the target state\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent at the current state.\n      # This is the goal condition: being adjacent to the primitive and facing it.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the cell in front is within grid bounds\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          # Check if the front_cell contains the primitive\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Path to target found!\n\n      # 2. Explore possible next actions: Move Forward, Turn Left, Turn Right\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if next_pos is within bounds and this (position, direction) state hasn't been visited\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT and\n          (next_pos, next_dir) not in visited):\n          \n          # Determine if the next position is walkable\n          is_walkable = True\n          # A cell is walkable if it does not contain any of the unwalkable kinds.\n          for kind_idx in unwalkable_kind_ids:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable = False\n                  break\n\n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path was found to an adjacent-and-facing state, append the USE action to the sequence.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T11:01:45.034971", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state # Access the current state of the environment\n  \n  # Extract relevant information from the current state\n  grid = current_state.grid # The environment grid (WIDTH, HEIGHT, n_kinds)\n  initial_pos = current_state.pos # Agent's starting position (row, col)\n  initial_dir = current_state.dir # Agent's starting direction (0:R, 1:U, 2:L, 3:D)\n\n  # Get the integer ID for the target primitive from the cookbook index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Get grid dimensions\n  GRID_WIDTH, GRID_HEIGHT, _ = grid.shape\n\n  # Map action names from the DSL/environment to their integer indices\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP'] # Assuming 'UP' corresponds to moving forward\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE'] # Action to collect the item\n\n  # Define how agent's position changes when moving forward based on direction\n  # (dr, dc) tuple for (delta_row, delta_col)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT (0): (R, C+1)\n      1: (-1, 0),  # Facing UP (1):   (R-1, C)\n      2: (0, -1),  # Facing LEFT (2): (R, C-1)\n      3: (1, 0)    # Facing DOWN (3): (R+1, C)\n  }\n\n  # Define how agent's direction changes when turning\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # R(0)->U(1)->L(2)->D(3)->R(0)\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # R(0)->D(3)->L(2)->U(1)->R(0)\n\n  # Identify entity kinds that the agent cannot walk onto.\n  # This includes general non-grabbable items (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  # AND the primitive itself, as the agent needs to stop *adjacent* to it to USE.\n  unwalkable_kind_ids = set(current_state.world.non_grabbable_indices)\n  unwalkable_kind_ids.add(primitive_id) \n\n  # BFS setup\n  # Queue stores elements: ((current_pos_tuple, current_dir_int), list_of_actions_to_reach_here)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (position, direction) pairs to avoid redundant exploration and cycles\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # To store the sequence of actions once the target state is found\n\n  # Start BFS\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # Check if the target primitive is in the cell directly in front of the agent\n      # Calculate coordinates of the cell directly in front\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the front cell is within grid boundaries\n      if (0 <= front_r < GRID_WIDTH and 0 <= front_c < GRID_HEIGHT):\n          # Check if the front cell contains the primitive\n          if grid[front_r, front_c, primitive_id] > 0:\n              target_path_actions = path_actions # Path to reach adjacent-and-facing state found\n              break # Exit BFS, target found\n\n      # Explore possible next actions: Move Forward, Turn Left, Turn Right\n      \n      # 1. Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if the next position is within bounds and this (pos, dir) state hasn't been visited\n      if (0 <= next_r < GRID_WIDTH and 0 <= next_c < GRID_HEIGHT and\n          (next_pos, next_dir) not in visited):\n          \n          # Check if the next position is walkable\n          is_walkable = True\n          for kind_idx in unwalkable_kind_ids:\n              if grid[next_r, next_c, kind_idx] > 0: # If the cell contains an unwalkable kind\n                  is_walkable = False\n                  break\n          \n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # 2. Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning only changes direction, not position\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # 3. Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning only changes direction, not position\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path to the adjacent-and-facing state was found, append the USE action\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T11:02:35.144986", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  \n  # Extract immutable state information from the current CraftState for pathfinding\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's initial position (row, col)\n  initial_dir = current_state.dir # Agent's initial facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook's index.\n  # This ID is used to identify the primitive on the grid.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Determine grid dimensions for boundary checks\n  num_rows, num_cols, _ = initial_grid.shape\n\n  # Retrieve action mapping from the environment (these are constant action IDs)\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # In CraftWorld, 'UP' means move forward in current direction\n  TURN_LEFT_ACTION = action_map['LEFT']     # Turn 90 degrees left\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Turn 90 degrees right\n  USE_ACTION = action_map['USE']            # Interact with the cell in front\n\n  # Define direction vectors for movement and turning rules (constants for agent's movement mechanics)\n  # DIR_TO_DRDC: Maps agent's current direction (0-3) to a (delta_row, delta_column) vector\n  # which indicates the cell directly in front of the agent for movement/interaction.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # TURN_LEFT_MAP / TURN_RIGHT_MAP: Map current direction to the new direction after a turn.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # RIGHT -> UP -> LEFT -> DOWN -> RIGHT\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # RIGHT -> DOWN -> LEFT -> UP -> RIGHT\n\n  # Get indices of entities that block agent movement (e.g., BOUNDARY, WATER, WORKSHOP_X).\n  # The agent cannot walk onto these cells.\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # Helper function to determine if a given grid cell (r, c) is valid and walkable for the agent.\n  def is_cell_walkable(r, c):\n      # 1. Check if the position is within grid boundaries.\n      if not (0 <= r < num_rows and 0 <= c < num_cols):\n          return False\n      \n      # 2. Check if the cell contains the target primitive.\n      # The agent interacts with primitives from an adjacent square, not by stepping onto them.\n      if initial_grid[r, c, primitive_id] > 0:\n          return False\n\n      # 3. Check if the cell contains any non-walkable (non-grabbable) entities.\n      # Iterate through the indices of known non-walkable kinds. If any are present, the cell is not walkable.\n      for kind_idx in non_walkable_kinds_indices:\n          if initial_grid[r, c, kind_idx] > 0:\n              return False\n          \n      return True\n\n  # BFS initialization:\n  # The queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_here)\n  # This represents a unique state (agent's position and orientation) and the path to achieve it.\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # The 'visited' set stores (position_tuple, direction_int) to prevent redundant exploration\n  # and cycles, ensuring the shortest path is found.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This variable will store the action sequence if a path to the goal is found.\n\n  # Start BFS traversal\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # Goal Check: Is the primitive directly in front of the agent from the current state?\n      # This is the \"goal state\" for our pathfinding: being positioned to interact with the primitive.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the cell directly in front is within grid boundaries before checking its contents.\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n          # If the primitive is present in this cell, we have found a path that leads the agent\n          # to be adjacent to and facing the primitive.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Path found! Terminate BFS.\n\n      # Explore all possible next actions (Move Forward, Turn Left, Turn Right) from the current state.\n\n      # Action 1: Try Move Forward\n      # Calculate the next position if the agent moves forward. Direction remains unchanged.\n      next_r_fwd, next_c_fwd = r + DIR_TO_DRDC[current_dir][0], c + DIR_TO_DRDC[current_dir][1]\n      next_pos_fwd = (next_r_fwd, next_c_fwd)\n      next_dir_fwd = current_dir # Moving forward does not change orientation.\n\n      # Check if the next position is valid and walkable, and this new (position, direction) state\n      # has not been visited yet.\n      if is_cell_walkable(next_r_fwd, next_c_fwd) and (next_pos_fwd, next_dir_fwd) not in visited:\n          # If walkable and unvisited, add the new state to the queue and mark it as visited.\n          visited.add((next_pos_fwd, next_dir_fwd))\n          queue.append(((next_pos_fwd, next_dir_fwd), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Action 2: Try Turn Left\n      # Calculate the new direction after turning left. Position remains unchanged.\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      next_pos_left = current_pos # Position does not change when turning.\n\n      # Check if this new (position, direction) state has not been visited.\n      if (next_pos_left, next_dir_left) not in visited:\n          # Add the new state to the queue and mark as visited.\n          visited.add((next_pos_left, next_dir_left))\n          queue.append(((next_pos_left, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Action 3: Try Turn Right\n      # Calculate the new direction after turning right. Position remains unchanged.\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      next_pos_right = current_pos # Position does not change when turning.\n\n      # Check if this new (position, direction) state has not been visited.\n      if (next_pos_right, next_dir_right) not in visited:\n          # Add the new state to the queue and mark as visited.\n          visited.add((next_pos_right, next_dir_right))\n          queue.append(((next_pos_right, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # After BFS completes:\n  # If a path to the target (adjacent and facing the primitive) was found,\n  # extend the found path with the final 'USE' action to collect the primitive.\n  # If no path was found (target_path is None), an empty list is returned,\n  # indicating the primitive is unreachable from the current state.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T11:02:36.265457", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` using a clearer BFS structure and helper functions.\n    \n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect.\n\n    Returns:\n        List[int]: A sequence of action indices to execute. An empty list if unreachable.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state\n  \n  # Extract immutable state information for pathfinding (grid, agent's initial pose, world info)\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos \n  initial_dir = current_state.dir \n\n  # Get the integer ID for the target primitive. This ID is used to locate the primitive on the grid.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Retrieve grid dimensions for boundary checks\n  num_rows, num_cols, _ = initial_grid.shape\n\n  # Map action names to their integer IDs provided by the environment\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # 'UP' action moves agent forward in its current direction\n  TURN_LEFT_ACTION = action_map['LEFT']     # Rotates agent 90 degrees counter-clockwise\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Rotates agent 90 degrees clockwise\n  USE_ACTION = action_map['USE']            # Interacts with the cell directly in front of the agent\n\n  # Define agent movement and rotation mechanics:\n  # DIR_TO_DRDC: Maps direction (0=RIGHT, 1=UP, 2=LEFT, 3=DOWN) to (delta_row, delta_col) for the cell directly \"forward\".\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # TURN_MAPS: Define how agent's direction changes when turning.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # RIGHT -> UP -> LEFT -> DOWN -> RIGHT\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # RIGHT -> DOWN -> LEFT -> UP -> RIGHT\n\n  # Identify non-walkable entity types. These are grid cells the agent cannot step onto.\n  # This set includes boundaries, water, and fixed workshop locations.\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # --- Helper functions for clarity in BFS ---\n\n  def _is_within_bounds(r, c):\n      \"\"\"Checks if a given grid coordinate (r, c) is within the environment's boundaries.\"\"\"\n      return 0 <= r < num_rows and 0 <= c < num_cols\n\n  def _is_walkable(r, c):\n      \"\"\"Checks if the cell at (r, c) can be entered by the agent.\"\"\"\n      # Agent cannot walk onto the target primitive itself (it interacts with it from an adjacent square).\n      if initial_grid[r, c, primitive_id] > 0:\n          return False\n      \n      # Agent cannot walk onto any non-grabbable entities.\n      # `any()` is efficient here for checking if _any_ of the non_walkable_kinds_indices are present.\n      if any(initial_grid[r, c, kind_idx] > 0 for kind_idx in non_walkable_kinds_indices):\n          return False\n          \n      return True\n\n  # --- BFS Initialization ---\n  # Queue stores ( (position_tuple, direction_int), list_of_actions_taken )\n  # Each element represents a unique agent state (location + orientation) and the path to reach it.\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # Visited set stores (position_tuple, direction_int) to avoid redundant computations and infinite loops.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_found = None # This will store the sequence of actions if a path to the goal is found.\n\n  # --- BFS Traversal ---\n  while queue:\n      (current_pos, current_dir), path_to_current_state = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check for Goal State: Is the primitive directly in front of the agent?\n      # If so, we've found the shortest path to a state from which the 'USE' action can be applied.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      if _is_within_bounds(front_r, front_c) and initial_grid[front_r, front_c, primitive_id] > 0:\n          target_path_found = path_to_current_state\n          break # Goal reached, shortest path found. Exit BFS.\n\n      # 2. Explore possible next states (Move, Turn Left, Turn Right) from the current state.\n\n      # --- Try Move Forward ---\n      next_r, next_c = r + front_dr, c + front_dc # Note: `front_dr, front_dc` are also the move deltas.\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Direction does not change when moving forward.\n\n      # Check if the potential next cell is valid (within bounds) and walkable.\n      if _is_within_bounds(next_r, next_c) and _is_walkable(next_r, next_c):\n          # If the new (position, direction) state has not been visited, add it to queue.\n          if (next_pos, next_dir) not in visited:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_to_current_state + [MOVE_FORWARD_ACTION]))\n\n      # --- Try Turn Left ---\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_to_current_state + [TURN_LEFT_ACTION]))\n\n      # --- Try Turn Right ---\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_to_current_state + [TURN_RIGHT_ACTION]))\n\n  # --- Construct Final Action List ---\n  if target_path_found is not None:\n      # If a path was found to be adjacent and facing the primitive, append the final 'USE' action.\n      actions_list.extend(target_path_found)\n      actions_list.append(USE_ACTION)\n  \n  # If no path was found (target_path_found is None), actions_list remains empty,\n  # indicating the primitive is unreachable or already collected (though the latter isn't checked here).\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T11:04:09.329495", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Map the primitive name to its integer ID.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized in the world's cookbook, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If so, it's already \"collected,\" and no actions are needed.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Determine if the primitive is a type that can be collected via the 'USE' action.\n  # This includes grabbable items (like tools), water, or stone. Other items (e.g., workshops, boundaries)\n  # are not typically \"collected\" into inventory by the 'USE' action in CraftWorld.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or\n      i_kind == world.water_index or\n      i_kind == world.stone_index\n  )\n\n  # If the item is not intended to be collected via 'USE', return an empty path.\n  # This acts as an early exit for non-collectible primitives.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action constants and directional deltas for grid navigation.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # Delta values for checking the cell directly in front of the agent based on its current direction.\n  # This helps in identifying what the agent is facing.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (North)\n      1: (0, 1),  # RIGHT: row, col + 1 (East)\n      2: (1, 0),  # DOWN: row + 1, col (South)\n      3: (0, -1)  # LEFT: row, col - 1 (West)\n  }\n\n  # Helper function to compute the minimal sequence of turns to face a target direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Agent is already facing the correct direction.\n\n      # Calculate the difference in directions, wrapping around 0-3.\n      # Adding 4 and taking modulo 4 handles negative results correctly for cyclic directions.\n      diff = (target_dir - current_dir + 4) % 4\n\n      if diff == 1: # Target is one step clockwise (e.g., current UP (0), target RIGHT (1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., current UP (0), target LEFT (3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., current UP (0), target DOWN (2))\n          # Two successive turns in either direction (e.g., two RIGHTs or two LEFTs) will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choosing two right turns.\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The `visited` set stores a tuple `(row, col, direction, inventory_tuple)` to represent\n  # a unique state. The inventory is converted to a tuple to make it hashable for the set.\n  # Including inventory in the state is crucial to handle scenarios where acquiring intermediate\n  # items (like tools) changes the agent's capabilities and thus represents a distinct state.\n  visited = set()\n\n  # Add the initial state to the queue and visited set.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, [])) # Queue stores (CraftState object, list of actions to reach this state)\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Heuristic limit to prevent the BFS from running indefinitely in very complex or unreachable scenarios.\n  # This multiplier (e.g., 10) provides a safeguard, especially given the state space expands\n  # due to tracking inventory changes. A path is typically found much sooner if one exists.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10\n  explored_states_count = 0\n\n  # 6. BFS Loop: Continues until the queue is empty or the goal (primitive collected) is found.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and its associated path.\n    explored_states_count += 1\n\n    # Pruning: If too many distinct states have been explored, stop to prevent excessive computation.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n\n    # Goal Check: Can the target primitive be collected from the current `state`?\n    # This involves checking if the primitive `i_kind` is within the 3x3 neighborhood around the agent.\n    # If it is, then attempt to position and 'USE' to collect it.\n    if state.next_to(i_kind):\n        # Iterate through all four cardinal directions to check if the primitive is directly in front\n        # from any of these orientations.\n        for target_dir in range(4):\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell directly in front (after simulated turn) is within grid bounds\n            # and actually contains the target primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and\n                state.grid[facing_r, facing_c, i_kind] == 1):\n\n                # Calculate the turning actions required to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state # Start from current state to simulate turns\n                for turn_action in turns_to_face:\n                    # Apply each turning action sequentially to get to the correct facing state.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Record inventory *before* attempting the 'USE' action.\n                # This allows us to verify if 'USE' successfully collected the primitive.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action on the temporary state.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Crucial verification: Check if the count of the target primitive in inventory\n                # actually increased after the 'USE' action. This confirms successful collection,\n                # accounting for any internal game rules (e.g., requiring tools) handled by `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT] # Path found! Return the sequence of actions.\n\n    # Explore possible future states by performing movement actions (UP, DOWN, LEFT, RIGHT).\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      # If this next state (defined by position, direction, and inventory) has not been visited, add it to the queue.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n\n    # Explore the general 'USE' action from the current state.\n    # This is essential because 'USE' can pick up other grabbable items (like tools)\n    # that are not the target primitive itself but might be necessary preconditions\n    # for collecting the target primitive later (e.g., picking up an axe to chop wood).\n    \n    # Determine the cell directly in front of the agent for the general 'USE' check.\n    front_dr, front_dc = _DIR_TO_DELTA_FRONT[current_dir]\n    facing_r, facing_c = current_r + front_dr, current_c + front_dc\n\n    # Only consider performing a 'USE' action if there's something potentially interactable\n    # in the cell directly in front of the agent. This prunes unnecessary 'USE' actions.\n    if 0 <= facing_r < grid_width and 0 <= facing_c < grid_height:\n        is_something_useable_in_front = False\n        \n        # Check for any grabbable item in the cell in front.\n        for k_idx in world.grabbable_indices:\n            if state.grid[facing_r, facing_c, k_idx] == 1:\n                is_something_useable_in_front = True\n                break\n        \n        # Also check specifically for water or stone, as these are often 'useable' but might not\n        # always be classified purely as 'grabbable' depending on context.\n        if not is_something_useable_in_front:\n            if (state.grid[facing_r, facing_c, world.water_index] == 1 or\n                state.grid[facing_r, facing_c, world.stone_index] == 1):\n                is_something_useable_in_front = True\n\n        # If there's something interactable, simulate the 'USE' action.\n        if is_something_useable_in_front:\n            inventory_before_any_use = np.copy(state.inventory)\n            _, state_after_current_use = state.step(USE_ACT)\n            \n            # Add the new state to the queue only if the 'USE' action resulted in a meaningful change\n            # (i.e., inventory changed, or agent moved/turned unexpectedly). This prevents exploring\n            # redundant states where 'USE' had no effect.\n            if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n                    state_after_current_use.pos == state.pos and\n                    state_after_current_use.dir == state.dir):\n\n                next_inventory_tuple = tuple(state_after_current_use.inventory)\n                next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n                if next_state_key not in visited:\n                    visited.add(next_state_key)\n                    q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS loop completes and no path to collect the primitive was found,\n  # it means the primitive is currently unreachable from the initial state given the environment and agent's capabilities.\n  return []", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T11:04:10.706693", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Map the primitive name to its integer ID.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized in the world's cookbook, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If so, it's already \"collected,\" and no actions are needed.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Determine if the primitive is a type that can be collected via the 'USE' action.\n  # This includes grabbable items (like tools), water, or stone. Other items (e.g., workshops, boundaries)\n  # are not typically \"collected\" into inventory by 'USE'.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or\n      i_kind == world.water_index or\n      i_kind == world.stone_index\n  )\n\n  # If the item is not intended to be collected via 'USE', return an empty path.\n  # This acts as an early exit for uncollectible types.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action constants and directional deltas for grid navigation.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # Delta values for checking the cell directly in front of the agent based on its current direction.\n  # (row_change, col_change) for each of the 4 directions (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT).\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP (North)\n      1: (0, 1),  # RIGHT (East)\n      2: (1, 0),  # DOWN (South)\n      3: (0, -1)  # LEFT (West)\n  }\n\n  # Helper function to compute the minimal sequence of turns to face a target direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the correct direction.\n\n      # Calculate the difference in directions, wrapping around 0-3.\n      # The +4 % 4 ensures a positive result for modulo operation.\n      diff = (target_dir - current_dir + 4) % 4\n\n      if diff == 1: # Target is one step clockwise (e.g., 0->1, 1->2, 2->3, 3->0).\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., 0->3, 1->0, etc.).\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., 0->2, 1->3).\n          return [RIGHT_ACT, RIGHT_ACT] # Two successive right turns (or left turns).\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The `visited` set stores a tuple `(row, col, direction, inventory_tuple)` to represent\n  # a unique state. Converting inventory (numpy array) to a tuple makes it hashable for the set.\n  visited = set()\n\n  # Add the initial state to the queue and visited set.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, [])) # (current_state, path_to_reach_this_state)\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, n_kinds = current_state.grid.shape\n  # Heuristic limit to prevent the BFS from running indefinitely in complex or unreachable scenarios.\n  # The multiplier (10) allows for sufficient exploration, including states where intermediate tools are acquired.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10\n  explored_states_count = 0\n\n  # Pre-compute a boolean mask for the 'n_kinds' dimension to quickly check\n  # if any 'useable' item (grabbable, water, stone) is present at a grid cell.\n  # This optimizes the `is_something_useable_in_front` check within the BFS loop.\n  all_useable_kind_indices = list(set(world.grabbable_indices) | {world.water_index, world.stone_index})\n  useable_kind_mask = np.zeros(n_kinds, dtype=bool)\n  for idx in all_useable_kind_indices:\n      if 0 <= idx < n_kinds: # Ensure index is valid for the grid dimension\n          useable_kind_mask[idx] = True\n\n  # 6. BFS Loop: Continues until the queue is empty or the goal is found.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and its associated path.\n    explored_states_count += 1\n\n    # Pruning: If too many distinct states have been explored, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n\n    # Goal Check: Can the target primitive be collected from the current `state`?\n    # First, check if the primitive is within the 3x3 neighborhood.\n    if state.next_to(i_kind):\n        # If it's nearby, iterate through all four cardinal directions to check if it's directly in front.\n        for target_dir in range(4):\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell directly in front is within bounds and contains the target primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and\n                state.grid[facing_r, facing_c, i_kind] == 1):\n\n                # Calculate and apply the turning actions required to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state\n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Record inventory *before* attempting the 'USE' action to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action on the temporary state.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Crucial verification: Check if the count of the target primitive in inventory\n                # actually increased. This confirms successful collection, accounting for any\n                # game rules (e.g., requiring tools) handled by `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT] # Found a path!\n\n    # Explore possible future states by performing movement actions.\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      # If this next state (position, direction, and inventory) has not been visited, add it to the queue.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n\n    # Explore the 'USE' action from the current state.\n    # This is vital for scenarios where using an item at the current location (e.g., picking up a tool)\n    # or crafting at a workshop might enable subsequent collection steps.\n    \n    # Determine the cell directly in front of the agent. This is the primary target for a 'USE' action.\n    front_dr, front_dc = _DIR_TO_DELTA_FRONT[current_dir]\n    facing_r, facing_c = current_r + front_dr, current_c + front_dc\n\n    # Check bounds for the cell in front.\n    if 0 <= facing_r < grid_width and 0 <= facing_c < grid_height:\n        # Optimized check: Use the pre-computed `useable_kind_mask` to quickly determine\n        # if *any* useable item (grabbable, water, stone) is present in the cell directly in front.\n        is_something_useable_in_front = np.any(state.grid[facing_r, facing_c, useable_kind_mask])\n    else:\n        is_something_useable_in_front = False # Cannot use something out of bounds\n\n    # Additionally, check if the agent is standing on a workshop, as 'USE' might apply there (e.g., crafting).\n    is_standing_on_workshop = np.any(state.grid[current_r, current_c, list(world.workshop_indices)])\n\n    # Only attempt USE_ACT if there's something potentially interactable in front OR if standing on a workshop.\n    if is_something_useable_in_front or is_standing_on_workshop:\n        inventory_before_any_use = np.copy(state.inventory)\n        _, state_after_current_use = state.step(USE_ACT)\n        \n        # Add to queue only if the 'USE' action resulted in a meaningful state change.\n        # This prevents redundant exploration of states where 'USE' did nothing.\n        if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n                state_after_current_use.pos == state.pos and\n                state_after_current_use.dir == state.dir):\n\n            next_inventory_tuple = tuple(state_after_current_use.inventory)\n            next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n            if next_state_key not in visited:\n                visited.add(next_state_key)\n                q.append((state_after_current_use, path + [USE_ACT]))\n    # If the agent is not facing a valid cell or nothing useable is in front and not on a workshop,\n    # the 'USE' action is not considered for exploration from this specific state.\n\n  # 7. If the BFS loop completes and no path to collect the primitive was found,\n  # it means the primitive is currently unreachable given the environment and agent's capabilities.\n  return []", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T11:04:51.661445", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`. Adds robust error handling for unknown primitives.\n\n  This function implements a Breadth-First Search (BFS) to discover the shortest sequence\n  of actions (moves and turns) required for the agent to reach a position directly adjacent\n  to the specified primitive and facing it. Once such a position is reached, a 'USE' action\n  is appended to the action list to collect the primitive.\n\n  Args:\n      env (env.CraftLab): The CraftLab environment instance, providing access to the current state\n                          and action mappings.\n      primitive (str): The string name of the primitive item to be collected\n                       (e.g., \"WOOD\", \"STONE\", \"GRASS\").\n\n  Returns:\n      List[int]: A sequence of integer action indices (e.g., [0, 1, 4]) that, when executed,\n                 will lead the agent to collect the specified primitive. Returns an empty list\n                 if the primitive is unreachable, or if the primitive name is not recognized.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state\n\n  # Extract essential information from the current state for pathfinding\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos\n  initial_dir = current_state.dir\n\n  # Robustly get the integer ID for the target primitive from the cookbook index.\n  # If the primitive name is not found, it cannot be collected, so return an empty list.\n  try:\n      primitive_id = current_state.world.cookbook.index[primitive]\n  except KeyError:\n      return []\n\n  num_rows, num_cols, _ = initial_grid.shape\n\n  # Map symbolic action names to their integer indices as defined by the environment\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define changes in (row, col) for each of the four agent directions.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: +1 to column\n      1: (-1, 0),  # Facing UP: -1 to row\n      2: (0, -1),  # Facing LEFT: -1 to column\n      3: (1, 0)    # Facing DOWN: +1 to row\n  }\n\n  # Define how the agent's direction changes when turning left or right.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # Identify entities that block agent movement.\n  non_walkable_for_movement_set = set(current_state.world.non_grabbable_indices)\n  non_walkable_for_movement_set.add(primitive_id) # Agent cannot move onto the primitive's cell\n\n  # Convert the set of non-walkable indices to a numpy array for efficient lookup\n  non_walkable_for_movement_array = np.array(list(non_walkable_for_movement_set), dtype=int)\n\n  # Initialize BFS data structures:\n  # queue: Stores tuples of ((agent_position, agent_direction), list_of_actions_to_reach_this_state)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # visited: A set to keep track of (position, direction) states already explored.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_to_adjacent_facing = None\n\n  # Start the Breadth-First Search\n  while queue:\n      (current_pos, current_dir), path_to_current_state = queue.popleft()\n      r, c = current_pos\n\n      # --- Goal Check: Is the primitive directly in front of the agent in this state? ---\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the 'front_cell' is within grid boundaries AND contains the target primitive\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols and\n          initial_grid[front_r, front_c, primitive_id] > 0):\n          \n          target_path_to_adjacent_facing = path_to_current_state\n          break # Goal reached: Agent is adjacent to and facing the primitive. Exit BFS.\n\n      # --- Explore possible next actions from the current state ---\n      \n      # 1. Try to Move Forward (e.g., 'UP' action)\n      next_r_move, next_c_move = r + DIR_TO_DRDC[current_dir][0], c + DIR_TO_DRDC[current_dir][1]\n      next_pos_move = (next_r_move, next_c_move)\n      next_dir_move = current_dir # Moving forward does not change direction\n\n      # Check if the potential next position is traversable and if this (pos, dir) state is new\n      if (next_pos_move, next_dir_move) not in visited:\n          if 0 <= next_r_move < num_rows and 0 <= next_c_move < num_cols:\n              # Check if the cell at (next_r_move, next_c_move) contains any non-walkable entity\n              if not np.any(initial_grid[next_r_move, next_c_move, non_walkable_for_movement_array] > 0):\n                  visited.add((next_pos_move, next_dir_move))\n                  queue.append(((next_pos_move, next_dir_move), path_to_current_state + [MOVE_FORWARD_ACTION]))\n\n      # 2. Try to Turn Left (e.g., 'LEFT' action)\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change the agent's position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_to_current_state + [TURN_LEFT_ACTION]))\n\n      # 3. Try to Turn Right (e.g., 'RIGHT' action)\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change the agent's position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_to_current_state + [TURN_RIGHT_ACTION]))\n\n  # If a path was successfully found, append the final 'USE' action.\n  if target_path_to_adjacent_facing is not None:\n      actions_list.extend(target_path_to_adjacent_facing)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 1, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T11:04:52.917509", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n\n  # Access initial grid, agent's position, and direction from the current state.\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos\n  initial_dir = current_state.dir\n\n  # Get the integer ID for the target primitive from the cookbook index.\n  # This adds robustness: if the primitive name is unknown, we return an empty list.\n  try:\n      primitive_id = current_state.world.cookbook.index[primitive]\n  except KeyError:\n      return [] # Primitive not found in the environment's index, cannot collect.\n\n  num_rows, num_cols, _ = initial_grid.shape # Get grid dimensions.\n\n  # Map symbolic action names to their integer indices as defined by the environment.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define changes in (row, col) for each of the four agent directions (0:Right, 1:Up, 2:Left, 3:Down).\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: moves +1 to column.\n      1: (-1, 0),  # Facing UP: moves -1 to row.\n      2: (0, -1),  # Facing LEFT: moves -1 to column.\n      3: (1, 0)    # Facing DOWN: moves +1 to row.\n  }\n\n  # Define how agent's direction changes when turning left or right.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Identify entities that block agent movement.\n  # This includes non-grabbable items (e.g., water, boundary) and the primitive itself,\n  # as the agent must stand *next* to the primitive to collect it, not on top of it.\n  non_walkable_for_movement_set = set(current_state.world.non_grabbable_indices)\n  non_walkable_for_movement_set.add(primitive_id)\n  \n  # Convert to a numpy array for efficient checking if a cell is blocked.\n  non_walkable_for_movement_array = np.array(list(non_walkable_for_movement_set), dtype=int)\n\n  # Initialize BFS data structures:\n  # queue: Stores ( (agent_position, agent_direction), list_of_actions_to_reach_this_state ).\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # visited: A set to keep track of (position, direction) states already explored,\n  #          preventing cycles and redundant computations.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_to_adjacent_facing = None # Stores the action sequence to the goal state.\n\n  # Start the Breadth-First Search\n  while queue:\n      # Dequeue the current state and the path to reach it.\n      (current_pos, current_dir), path_to_current_state = queue.popleft()\n      r, c = current_pos # Agent's current row and column.\n\n      # --- Goal Check: Is the primitive directly in front of the agent in this state? ---\n      # Calculate the coordinates of the cell directly in front of the agent.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the 'front_cell' is within grid boundaries AND contains the target primitive.\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols and\n          initial_grid[front_r, front_c, primitive_id] > 0):\n          \n          target_path_to_adjacent_facing = path_to_current_state\n          break # Goal reached: Agent is adjacent to and facing the primitive. Exit BFS.\n\n      # --- Explore possible next actions from the current state ---\n      \n      # 1. Try to Move Forward (using the 'UP' action)\n      next_r_move, next_c_move = r + DIR_TO_DRDC[current_dir][0], c + DIR_TO_DRDC[current_dir][1]\n      next_pos_move = (next_r_move, next_c_move)\n      next_dir_move = current_dir # Moving forward does not change direction.\n\n      # Check if the potential next position is traversable and if this (pos, dir) state is new.\n      if (next_pos_move, next_dir_move) not in visited:\n          if (0 <= next_r_move < num_rows and 0 <= next_c_move < num_cols): # Check grid boundaries.\n              # Check if the target cell contains any non-walkable entity.\n              # np.any efficiently checks if any value > 0 exists for the specified kinds in the cell.\n              if not np.any(initial_grid[next_r_move, next_c_move, non_walkable_for_movement_array] > 0):\n                  visited.add((next_pos_move, next_dir_move))\n                  queue.append(((next_pos_move, next_dir_move), path_to_current_state + [MOVE_FORWARD_ACTION]))\n\n      # 2. Try to Turn Left (using the 'LEFT' action)\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change the agent's position, only its direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_to_current_state + [TURN_LEFT_ACTION]))\n\n      # 3. Try to Turn Right (using the 'RIGHT' action)\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change the agent's position, only its direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_to_current_state + [TURN_RIGHT_ACTION]))\n\n  # If a path was successfully found to a state where the agent is adjacent to and facing the primitive,\n  # append the final 'USE' action to the path.\n  if target_path_to_adjacent_facing is not None:\n      actions_list.extend(target_path_to_adjacent_facing)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 1, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T11:05:36.811753", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos\n  initial_dir = current_state.dir\n\n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  grid_rows, grid_cols, _ = initial_grid.shape\n\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  TURN_LEFT_DIR_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  TURN_RIGHT_DIR_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_to_adjacency = None\n\n  while queue:\n      (current_pos, current_dir), path_taken = queue.popleft()\n      current_row, current_col = current_pos\n\n      # Check if the primitive is directly in front of the agent\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_cell_row, front_cell_col = current_row + front_dr, current_col + front_dc\n      \n      if (0 <= front_cell_row < grid_rows and 0 <= front_cell_col < grid_cols):\n          if initial_grid[front_cell_row, front_cell_col, primitive_id] > 0:\n              target_path_to_adjacency = path_taken\n              break\n\n      # Explore Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_row, next_col = current_row + move_dr, current_col + move_dc\n      next_pos = (next_row, next_col)\n      next_dir = current_dir\n\n      if (0 <= next_row < grid_rows and 0 <= next_col < grid_cols and\n          (next_pos, next_dir) not in visited):\n          \n          is_walkable = True\n          # A cell is not walkable if it contains the primitive (agent needs to be adjacent to 'use')\n          if initial_grid[next_row, next_col, primitive_id] > 0:\n              is_walkable = False\n          # Or if it contains any other non-grabbable/non-walkable entity\n          elif any(initial_grid[next_row, next_col, kind_idx] > 0 for kind_idx in non_walkable_kinds_indices):\n              is_walkable = False\n\n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_taken + [MOVE_FORWARD_ACTION]))\n\n      # Explore Turn Left\n      next_dir_left = TURN_LEFT_DIR_MAP[current_dir]\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_taken + [TURN_LEFT_ACTION]))\n\n      # Explore Turn Right\n      next_dir_right = TURN_RIGHT_DIR_MAP[current_dir]\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_taken + [TURN_RIGHT_ACTION]))\n\n  if target_path_to_adjacency is not None:\n      actions_list.extend(target_path_to_adjacency)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T11:05:37.927143", "function_name": "collect", "function_body": "  actions_list = [] # Stores the sequence of action IDs to be returned\n  current_state = env._current_state # Get the current state of the environment\n\n  # Extract key information from the current CraftState\n  grid = current_state.grid  # The 3D NumPy array representing the grid (height, width, kinds)\n  agent_pos = current_state.pos    # Agent's current (row, column) tuple\n  agent_dir = current_state.dir    # Agent's current facing direction (int: 0=RIGHT, 1=UP, 2=LEFT, 3=DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook's index.\n  # This maps the string name (e.g., \"WOOD\") to its internal integer representation.\n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  # Determine grid dimensions for boundary checks.\n  grid_rows, grid_cols, _ = grid.shape\n\n  # Retrieve integer action IDs from the environment's action specifications.\n  # These are the numeric codes (0-4) that correspond to specific actions.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # In this DMLab-style env, 'UP' means move forward.\n  TURN_LEFT_ACTION = action_map['LEFT']     # Turn 90 degrees counter-clockwise.\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Turn 90 degrees clockwise.\n  USE_ACTION = action_map['USE']            # Interact with the cell directly in front.\n\n  # Define direction vectors (delta_row, delta_col) based on agent's facing direction.\n  # This helps calculate the coordinates of the cell in front or a cell after moving.\n  # Mapping: 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN (assuming a standard coordinate system where (0,0) is top-left)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: column increases\n      1: (-1, 0),  # Facing UP: row decreases\n      2: (0, -1),  # Facing LEFT: column decreases\n      3: (1, 0)    # Facing DOWN: row increases\n  }\n\n  # Define how the agent's direction changes when turning left or right.\n  # Directions cycle through 0, 1, 2, 3.\n  TURN_LEFT_DIR_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # RIGHT->UP->LEFT->DOWN->RIGHT\n  TURN_RIGHT_DIR_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # RIGHT->DOWN->LEFT->UP->RIGHT\n\n  # Get indices of entities that block agent movement.\n  # The agent cannot walk onto cells containing these kinds (e.g., BOUNDARY, WATER, WORKSHOP_X).\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # BFS Initialization:\n  # The queue stores tuples: ((current_agent_position, current_agent_direction), list_of_actions_to_reach_here).\n  # A \"state\" in BFS is defined by (position, direction) because the outcome of actions depends on both.\n  queue = collections.deque([((agent_pos, agent_dir), [])])\n  \n  # The visited set stores (position, direction) tuples to avoid revisiting states,\n  # preventing cycles, and ensuring the shortest path is found (BFS property for unweighted steps).\n  visited = {(agent_pos, agent_dir)}\n\n  # This variable will store the sequence of actions to reach the state\n  # where the primitive is directly in front of the agent.\n  path_to_primitive_adjacency = None \n\n  # Start BFS traversal\n  while queue:\n      (current_pos, current_dir), path_taken = queue.popleft()\n      current_row, current_col = current_pos\n\n      # 1. Check if the target primitive is directly in front of the agent from the current state.\n      # If it is, we've found the desired \"adjacency\" state for collection.\n      \n      # Calculate coordinates of the cell directly in front of the agent.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_cell_row, front_cell_col = current_row + front_dr, current_col + front_dc\n      \n      # Ensure the cell in front is within grid boundaries before checking its contents.\n      if (0 <= front_cell_row < grid_rows and 0 <= front_cell_col < grid_cols):\n          # Check if the primitive is present in this front cell (i.e., its count is > 0).\n          if grid[front_cell_row, front_cell_col, primitive_id] > 0:\n              path_to_primitive_adjacency = path_taken # Store the path leading to this adjacent state.\n              break # Target state found, exit the BFS loop as we found the shortest path.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n      # These actions lead to new agent states (position and/or direction).\n\n      # --- Try Move Forward action ---\n      move_dr, move_dc = DIR_TO_DRDC[current_dir] # Delta for moving forward\n      next_row, next_col = current_row + move_dr, current_col + move_dc\n      next_pos = (next_row, next_col)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if the potential next position is valid (within grid bounds)\n      # and if this specific (position, direction) state has not been visited yet.\n      if (0 <= next_row < grid_rows and 0 <= next_col < grid_cols and\n          (next_pos, next_dir) not in visited):\n          \n          # Determine if the next cell is walkable.\n          # A cell is NOT walkable if it contains any non-grabbable entity (like a wall, water, workshop),\n          # or if it contains the primitive itself (agent needs to be ADJACENT to 'use', not on top).\n          is_walkable = True\n          for kind_idx in non_walkable_kinds_indices:\n              if grid[next_row, next_col, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          # If the target primitive is on the next cell, it's not walkable for movement,\n          # as the agent needs to be next to it, not on it, to 'USE' it.\n          if grid[next_row, next_col, primitive_id] > 0:\n              is_walkable = False\n\n          if is_walkable:\n              visited.add((next_pos, next_dir)) # Mark new state as visited\n              # Add to queue with the updated path, including the MOVE_FORWARD_ACTION.\n              queue.append(((next_pos, next_dir), path_taken + [MOVE_FORWARD_ACTION]))\n\n      # --- Try Turn Left action ---\n      next_dir_left = TURN_LEFT_DIR_MAP[current_dir] # Calculate new direction after turning left\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left)) # Mark new state as visited\n          # Add to queue with updated path, including the TURN_LEFT_ACTION.\n          queue.append(((current_pos, next_dir_left), path_taken + [TURN_LEFT_ACTION]))\n\n      # --- Try Turn Right action ---\n      next_dir_right = TURN_RIGHT_DIR_MAP[current_dir] # Calculate new direction after turning right\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right)) # Mark new state as visited\n          # Add to queue with updated path, including the TURN_RIGHT_ACTION.\n          queue.append(((current_pos, next_dir_right), path_taken + [TURN_RIGHT_ACTION]))\n\n  # After BFS completes (either target found or queue empty):\n  # If a path to the target adjacency state was found, append the 'USE' action to complete the collection.\n  if path_to_primitive_adjacency is not None:\n      actions_list.extend(path_to_primitive_adjacency)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T11:06:49.102870", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world # Access to game world configuration (cookbook, indices, etc.)\n\n  # 1. Map the primitive name to its integer ID.\n  # If the primitive is not recognized, it cannot be collected.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If so, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is something that can be collected\n  # via the 'USE' action. This includes grabbable items, water, and stone.\n  # Entities like workshops, boundaries, or bridges are not typically 'collected' into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not a 'USE'-collectible primitive, then this function cannot collect it.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action constants and utility mappings.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # Maps agent's direction (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT) to a delta (dr, dc)\n  # representing the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP (North)\n      1: (0, 1),  # RIGHT (East)\n      2: (1, 0),  # DOWN (South)\n      3: (0, -1)  # LEFT (West)\n  }\n\n  # Helper function to compute the minimal turning actions (LEFT/RIGHT)\n  # required to face a `target_dir` from the `current_dir`.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # The +4 and %4 ensure a positive difference for consistent modulo behavior.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          return [RIGHT_ACT, RIGHT_ACT] # Two consecutive right turns (or left turns)\n\n  # 5. Initialize Breadth-First Search (BFS) structures.\n  q = collections.deque()\n  # `visited` stores a tuple (row, col, direction, inventory_tuple) to represent a unique state.\n  # Using a tuple of the inventory (which is a numpy array) allows it to be hashable.\n  visited = set()\n\n  # Start BFS from the current environment state.\n  # Inventory is converted to a tuple to be part of the hashable state key.\n  initial_inventory_tuple = tuple(current_state.inventory.tolist()) # .tolist() for better tuple creation\n  q.append((current_state, [])) # (CraftState object, list of actions to reach this state)\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Maximum number of states to explore. This prevents infinite loops in complex\n  # scenarios or exceedingly long searches. The multiplier '4' is for directions,\n  # '10' is a heuristic for different relevant inventory states (e.g., having a tool).\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 6. BFS Loop: Explore states layer by layer to find the shortest path.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path taken to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      # If this happens, it means either the path is too long, or unreachable within practical limits.\n      continue # Continue to next in queue if any, or terminate BFS if queue empty.\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from the current 'state'?\n    # First, check if the primitive is in any adjacent cell.\n    if state.next_to(i_kind):\n        # Iterate through all four possible facing directions.\n        for target_dir in range(4): \n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell in front is within bounds and contains the target primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # If yes, calculate actions to turn and face it.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    # Simulate turns. Reward is always 0.0 in CraftLab, so discard.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Record inventory *before* attempting the 'USE' action.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action. This is where collection happens.\n                # Reward is always 0.0, so discard.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Crucial check: Verify that the primitive's count in the inventory actually increased.\n                # This confirms successful collection, accounting for any internal game rules\n                # like tool requirements, resource depletion, etc.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    # Found a path! Return the sequence of actions.\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible actions from the current state:\n    # 1. Movement actions (UP, DOWN, LEFT, RIGHT).\n    for action in move_actions:\n      # Simulate taking the action to get the next state.\n      _, next_state = state.step(action)\n      \n      # Construct a hashable key for the next state, including inventory.\n      next_inventory_tuple = tuple(next_state.inventory.tolist())\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      # If this state has not been visited, add it to the queue and visited set.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # 2. 'USE' action from the current position (not necessarily facing the target primitive).\n    # This is important for scenarios where using an item *at the agent's current location*\n    # (e.g., picking up a tool, using a workbench) changes the state in a way that\n    # facilitates future collection of the primitive.\n    inventory_before_current_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if the 'USE' action actually resulted in a meaningful state change.\n    # This prevents adding redundant states to the queue if 'USE' had no effect.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_current_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory.tolist())\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # If the BFS queue is exhausted and no path leading to the collection of the primitive\n  # was found, it means the primitive is currently unreachable or uncollectible.\n  return []", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T11:06:50.513195", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  # This maps the string name (e.g., \"wood\") to its unique integer ID in the environment.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized by the cookbook, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If the goal (collecting the primitive) is already met, no actions are needed.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # The 'collect' function specifically targets items that can be picked up and added to inventory,\n  # or primary resources like water or stone that are gathered via 'USE'.\n  # Non-grabbable entities like workshops, boundaries, or crafting outputs (e.g., PLANK, BED)\n  # are not \"collected\" in this manner; they are typically crafted or interacted with differently.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item cannot be collected using the 'USE' action (e.g., it's a structural element or a crafted item),\n  # then this `collect` function is not applicable.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integer IDs from the environment's action_specs.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set stores unique states to avoid redundant exploration and cycles.\n  # A state is defined by the agent's (position, direction, and current inventory).\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing, as numpy arrays are not hashable by default.\n  # Including inventory in the state is crucial because picking up tools or other items changes\n  # the available actions or future collection possibilities, making it a distinct state.\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, [])) # Queue stores (CraftState object, list of actions to reach it)\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # MAX_EXPLORED_STATES is a pragmatic limit to prevent extremely long searches on complex\n  # or unsolvable maps. The multiplier '4' accounts for directions, and '10' for variations\n  # in inventory relevant to a typical collection task. This is a heuristic.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 6. BFS Loop: Explore states layer by layer to find the shortest path.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    # This acts as a safety break for very large or difficult search spaces.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This involves checking if the primitive is in the agent's immediate vicinity (3x3 neighborhood)\n    # and then simulating the actions to face and 'USE' it.\n    if state.next_to(i_kind):\n        # Iterate through all four possible cardinal directions (UP, RIGHT, DOWN, LEFT)\n        for target_dir in range(4): \n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell directly in front of the agent (if facing `target_dir`)\n            # is within grid bounds and contains the target primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Calculate and simulate the turning actions required to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    # _ is used as reward is always 0.0 in this implementation\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify successful collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This confirms successful collection, accounting for any internal game rules\n                # (e.g., tools needed, resource depletion) implemented within `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    # If collected, return the full sequence of actions:\n                    # path to reach current state + turns + USE action.\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions (UP, DOWN, LEFT, RIGHT).\n    for action in move_actions:\n      # Simulate the action to get the next state.\n      _, next_state = state.step(action)\n      # Create a hashable key for the next state, including inventory.\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      # If this state has not been visited before, add it to the queue and visited set.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the 'USE' action from the current position.\n    # This is important even if the primitive is not directly adjacent, because 'USE'\n    # can sometimes pick up tools or interact with other objects (e.g., workshop)\n    # that change the inventory and thus enable future collection.\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if the 'USE' action resulted in a meaningful state change.\n    # If USE did nothing (e.g., no grabbable item, no interactable object),\n    # we don't add a redundant state to the queue.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        # If this new state (after USE) has not been visited, add it.\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is currently unreachable from the initial state given the allowed actions.\n  return []", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T11:07:22.665420", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  # This list ensures we only attempt to collect items that are actually collectable via the USE action.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  # This prunes the search space for uncollectible primitives early.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set includes the agent's inventory as part of the state key.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing, allowing BFS to distinguish\n  # between states that are identical in position/direction but differ in inventory (e.g., having a tool vs. not).\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Maximum number of unique states to explore. This limit prevents excessive computation\n  # for very large or complex environments where a path might not exist or is too long.\n  # The factor '10' for inventory captures common scenarios where inventory changes enable new paths.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`).\n    if state.next_to(i_kind):\n        # Iterate through all four cardinal directions to find the target primitive.\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell in front is within grid bounds and contains the primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    # Apply each turn action to simulate the new state after turning.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the USE action from the current position, even if not directly facing the target primitive.\n    # This is important if using an item at the current position (e.g., picking up a tool like an axe)\n    # can change the inventory state, which might be necessary for later steps to collect the target primitive (e.g., wood).\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if the USE action resulted in a meaningful state change (inventory, position, or direction).\n    # This prevents adding redundant states to the queue if USE had no effect.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 4, "scores": {"3": 1.5}}
