{"timestamp": "2025-08-01T11:22:17.430377", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind_target = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory at the very beginning.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind_target] > 0:\n      return []\n\n  # 3. Define action integers for all possible actions.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  all_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT, USE_ACT]\n\n  # 4. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set stores a tuple representing the agent's full state (position, direction, inventory).\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing in the set.\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, [])) # Queue stores (CraftState object, path_to_reach_this_state: list of action integers)\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  # Set a heuristic limit for explored states to prevent excessively long searches in large or complex state spaces.\n  # This limit is based on grid dimensions, possible agent directions, and a proxy for inventory complexity\n  # (total number of kinds in the cookbook, as inventory can change state space).\n  grid_width, grid_height, _ = current_state.grid.shape\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * (world.cookbook.n_kinds + 1) * 2 \n  explored_states_count = 0\n\n  # 5. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    # We continue the loop rather than breaking, allowing other branches to complete if the goal\n    # is still reachable through them, but prioritizing breadth-first search.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    # --- GOAL CHECK ---\n    # If the target primitive is now in the agent's inventory, we have found a path.\n    # This check is crucial and is performed as soon as a state is dequeued.\n    if state.inventory[i_kind_target] > 0:\n        return path # Goal achieved! Return the sequence of actions that led to this state.\n\n    # --- EXPLORE ACTIONS ---\n    # For each possible action, simulate its effect and add the resulting new state to the queue if unvisited.\n    for action in all_actions:\n      # Simulate the action. `state.step` returns (reward, new_state).\n      # The reward is not used here, as we are only concerned with state transitions.\n      _, next_state = state.step(action)\n\n      # Construct a unique key for the next state to check against the 'visited' set.\n      # This key must capture all relevant aspects of the state that determine reachability,\n      # specifically position, direction, and inventory.\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      # If this next state has not been visited before, add it to the queue and mark as visited.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n\n  # 6. If the BFS queue is exhausted and the goal was never reached,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T11:23:18.497702", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE' (e.g., workshops, boundaries),\n  # we return an empty list as it implies it's not meant to be picked up into inventory.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set now includes the agent's inventory as part of the state key.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing, allowing BFS to distinguish\n  # between states that are identical in position/direction but differ in inventory (e.g., having a tool vs. not).\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Heuristic for maximum states to explore to prevent excessively long searches.\n  # This considers position, direction, and a simplified representation of relevant inventory states\n  # (e.g., presence/absence of key tools). The '32' is a heuristic factor, approximating 2^5\n  # for about 5 distinct tool-like items that might change search paths.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 32 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check - First, check if the grabbable primitive can be collected from the agent's current cell.\n    # This applies to grabbable items that can be picked up by standing on them and using USE.\n    if i_kind in world.grabbable_indices and state.grid[current_r, current_c, i_kind] == 1:\n        inventory_before_use_on_self = np.copy(state.inventory)\n        _, state_after_use_on_self = state.step(USE_ACT)\n        # Verify successful collection: inventory count of i_kind increased\n        if state_after_use_on_self.inventory[i_kind] > inventory_before_use_on_self[i_kind]:\n            return path + [USE_ACT] # Collected by using at current position\n    \n    # Goal Check: Check if the primitive can be collected from an adjacent cell (cardinal directions).\n    # `state.next_to(i_kind)` checks the 3x3 neighborhood. We then iterate through cardinal directions\n    # to find the specific cell and face it.\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Ensure the facing coordinates are within grid bounds and contain the target primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                temp_state_after_turns = state \n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action on the cell in front.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible next states:\n    # 6c. Explore movement actions.\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # 6d. Explore the general 'USE' action from the current position if it's potentially useful.\n    # This is crucial for acquiring tools or interacting with environmental elements\n    # that are not the target primitive but are necessary for subsequent collection steps.\n    \n    do_general_use_exploration = False\n    \n    # Check if agent is currently on a grabbable item that is NOT the target primitive.\n    # If so, picking it up might be an intermediate step (e.g., collecting a tool).\n    item_at_pos_idx_flat = np.where(state.grid[current_r, current_c, :] == 1)[0]\n    if item_at_pos_idx_flat.size > 0: # Check if there's any item at this position\n        item_at_pos_idx = item_at_pos_idx_flat[0] # Take the first if multiple\n        if item_at_pos_idx != i_kind and item_at_pos_idx in world.grabbable_indices:\n            do_general_use_exploration = True\n    \n    # Check if agent is facing a workshop or another grabbable item (not the target primitive).\n    # Workshops are crucial for crafting and sometimes provide items or functionality.\n    # Other grabbables might be tools.\n    dr, dc = _DIR_TO_DELTA_FRONT[current_dir]\n    facing_r, facing_c = current_r + dr, current_c + dc\n    \n    if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height):\n        item_in_front_idx_flat = np.where(state.grid[facing_r, facing_c, :] == 1)[0]\n        if item_in_front_idx_flat.size > 0:\n            item_in_front_idx = item_in_front_idx_flat[0]\n            if (item_in_front_idx != i_kind and \n                (item_in_front_idx in world.grabbable_indices or item_in_front_idx in world.workshop_indices)):\n                do_general_use_exploration = True\n\n    # If the general USE is deemed potentially useful, simulate and add to queue.\n    if do_general_use_exploration:\n        inventory_before_any_use = np.copy(state.inventory)\n        _, state_after_current_use = state.step(USE_ACT)\n        \n        # Check if the USE action resulted in a meaningful state change (inventory, position, or direction).\n        # This prevents adding redundant states to the queue if USE had no effect.\n        if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n                state_after_current_use.pos == state.pos and\n                state_after_current_use.dir == state.dir):\n\n            next_inventory_tuple = tuple(state_after_current_use.inventory)\n            next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n            if next_state_key not in visited:\n                visited.add(next_state_key)\n                q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions\n  # or within the `MAX_EXPLORED_STATES` limit.\n  return []", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T11:23:19.843596", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set includes the agent's inventory as part of the state key.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing.\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Increased MAX_EXPLORED_STATES due to the larger state space when tracking inventory.\n  # This heuristic limit helps prevent excessively long searches in complex scenarios.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check 1: Primitive directly under agent's feet (grabbable only).\n    # This applies to grabbable items that can be picked up by standing on them and using USE.\n    if i_kind in world.grabbable_indices and state.grid[current_r, current_c, i_kind] == 1:\n        inventory_before_use_on_self = np.copy(state.inventory)\n        _, state_after_use_on_self = state.step(USE_ACT)\n        # Verify successful collection\n        if state_after_use_on_self.inventory[i_kind] > inventory_before_use_on_self[i_kind]:\n            return path + [USE_ACT] # Collected by using at current position\n    \n    # Goal Check 2: Primitive in an adjacent cell (cardinal directions).\n    # This check relies on `state.next_to(i_kind)` which covers the 3x3 neighborhood.\n    # We then iterate through cardinal directions to find the specific cell and face it.\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Ensure facing cell is within grid bounds and contains the target primitive\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                temp_state_after_turns = state \n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action on the cell in front.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # IMPROVEMENT for collect_v2: Make the \"Explore General USE\" action more targeted.\n    # Instead of exploring `USE` unconditionally if it changes state, only explore it if\n    # it potentially interacts with a non-target grabbable item (e.g., a tool) or a workshop.\n    \n    do_general_use_exploration = False\n    \n    # Case A: Agent is currently on a grabbable item that is NOT the target primitive.\n    # Check if there's any item at the current position and if it's a grabbable non-target.\n    item_at_pos_indices = np.where(state.grid[current_r, current_c, :] == 1)[0]\n    if item_at_pos_indices.size > 0: # Check if there's any item at this position\n        item_at_pos_idx = item_at_pos_indices[0] # Take the first if multiple are present (assuming one-hot or primary)\n        if item_at_pos_idx != i_kind and item_at_pos_idx in world.grabbable_indices:\n            do_general_use_exploration = True\n    \n    # Case B: Agent is facing a grabbable item (NOT the target primitive) or a workshop.\n    dr, dc = _DIR_TO_DELTA_FRONT[current_dir]\n    facing_r, facing_c = current_r + dr, current_c + dc\n    \n    if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height):\n        item_in_front_indices = np.where(state.grid[facing_r, facing_c, :] == 1)[0]\n        if item_in_front_indices.size > 0:\n            item_in_front_idx = item_in_front_indices[0]\n            if (item_in_front_idx != i_kind and \n                (item_in_front_idx in world.grabbable_indices or item_in_front_idx in world.workshop_indices)):\n                do_general_use_exploration = True\n\n    # If the general USE is deemed potentially useful, simulate and add to queue.\n    if do_general_use_exploration:\n        inventory_before_any_use = np.copy(state.inventory)\n        _, state_after_current_use = state.step(USE_ACT)\n        \n        # Check if the USE action actually resulted in a meaningful state change (inventory, position, or direction).\n        # This prevents adding redundant states to the queue if USE had no effect.\n        if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n                state_after_current_use.pos == state.pos and\n                state_after_current_use.dir == state.dir):\n\n            next_inventory_tuple = tuple(state_after_current_use.inventory)\n            next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n            if next_state_key not in visited:\n                visited.add(next_state_key)\n                q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T11:24:27.829924", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  grid_snapshot = current_state.grid\n  start_pos = current_state.pos  # (row, col)\n  start_dir = current_state.dir  # int (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  target_primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = grid_snapshot.shape\n\n  action_map = env.action_specs()\n  MOVE_FORWARD = action_map['UP']\n  TURN_LEFT = action_map['LEFT']\n  TURN_RIGHT = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction\n  # Used to calculate the cell in front or the next position when moving forward.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (dr, dc) = (0, 1) - column increases\n      1: (-1, 0),  # Facing UP: (dr, dc) = (-1, 0) - row decreases\n      2: (0, -1),  # Facing LEFT: (dr, dc) = (0, -1) - column decreases\n      3: (1, 0)    # Facing DOWN: (dr, dc) = (1, 0) - row increases\n  }\n\n  # Maps for updating direction when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right(0) -> Up(1) -> Left(2) -> Down(3) -> Right(0)\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right(0) -> Down(3) -> Left(2) -> Up(1) -> Right(0)\n\n  # Get indices of entities that block movement (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  non_walkable_kind_ids = current_state.world.non_grabbable_indices\n\n  # BFS queue: stores ((current_r, current_c), current_dir), list_of_actions_to_reach_here\n  queue = collections.deque([((start_pos, start_dir), [])])\n  # Visited set: stores (current_pos_tuple, current_dir_int) to prevent redundant exploration\n  visited = {(start_pos, start_dir)}\n\n  target_path_actions = None # To store the path of actions once the target is found\n\n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      r, c = current_pos\n\n      # Check if the target primitive is directly in front of the agent at the current state.\n      # If so, this is a valid state from which to perform the USE action.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the cell in front is within grid boundaries\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          # Check if the cell in front contains the target primitive\n          if grid_snapshot[front_r, front_c, target_primitive_id] > 0:\n              target_path_actions = path_so_far\n              break # Found the shortest path to be adjacent and facing the primitive\n\n      # Explore possible next actions: Move Forward, Turn Left, Turn Right\n\n      # --- Option 1: Try Moving Forward ---\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos_after_move = (next_r, next_c)\n      next_dir_after_move = current_dir # Direction does not change when moving forward\n\n      # Check if the next position is within grid boundaries\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT):\n          # Check if this (position, direction) state has not been visited yet\n          if (next_pos_after_move, next_dir_after_move) not in visited:\n              \n              # Determine if the potential next cell (next_r, next_c) is walkable.\n              # A cell is walkable if it does NOT contain any non-grabbable entities\n              # AND it is NOT the primitive we are trying to collect (agent cannot walk onto it).\n              is_cell_walkable = True\n              \n              # Check for any non-grabbable items that inherently block movement (e.g., boundaries, water, workshops)\n              for kind_idx in non_walkable_kind_ids:\n                  if grid_snapshot[next_r, next_c, kind_idx] > 0:\n                      is_cell_walkable = False\n                      break\n              \n              # If the cell is still considered walkable, additionally ensure it does not contain the target primitive itself.\n              # The agent needs to be *adjacent* to the primitive to 'USE' it, not on top of it.\n              if is_cell_walkable and grid_snapshot[next_r, next_c, target_primitive_id] > 0:\n                  is_cell_walkable = False\n\n              if is_cell_walkable:\n                  visited.add((next_pos_after_move, next_dir_after_move))\n                  queue.append(((next_pos_after_move, next_dir_after_move), path_so_far + [MOVE_FORWARD]))\n\n      # --- Option 2: Try Turning Left ---\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_so_far + [TURN_LEFT]))\n\n      # --- Option 3: Try Turning Right ---\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_so_far + [TURN_RIGHT]))\n\n  # If a path to the target (adjacent and facing the primitive) was found,\n  # append the USE action to the sequence.\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T11:24:28.948919", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  grid_snapshot = current_state.grid\n  start_pos = current_state.pos  # (row, col)\n  start_dir = current_state.dir  # int (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get target primitive ID\n  target_primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = grid_snapshot.shape\n\n  # Get action integer mappings from env.action_specs()\n  action_map = env.action_specs()\n  MOVE_FORWARD = action_map['UP']\n  TURN_LEFT = action_map['LEFT']\n  TURN_RIGHT = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define direction mappings for movement and turns\n  # DIR_TO_DRDC: Maps current direction to (delta_row, delta_col) for moving forward\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: row stays same, col increases\n      1: (-1, 0),  # Facing UP: row decreases, col stays same\n      2: (0, -1),  # Facing LEFT: row stays same, col decreases\n      3: (1, 0)    # Facing DOWN: row increases, col stays same\n  }\n  # TURN_LEFT_MAP: Maps current direction to new direction after turning left\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0} # R(0)->U(1)->L(2)->D(3)->R(0)\n  # TURN_RIGHT_MAP: Maps current direction to new direction after turning right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # R(0)->D(3)->L(2)->U(1)->R(0)\n\n  # Get indices of entities that block agent movement (non-grabbable items)\n  non_walkable_kind_ids = current_state.world.non_grabbable_indices\n\n  # Helper function to determine if a grid position is blocked for movement.\n  # This function is nested to have direct access to `grid_snapshot`, `WIDTH`, `HEIGHT`,\n  # `non_walkable_kind_ids`, and `target_primitive_id` from the outer scope.\n  def _is_position_blocked(r: int, c: int) -> bool:\n      \"\"\"Checks if a given grid position (r, c) is blocked for agent movement.\n      A position is blocked if it's out of bounds, contains a non-walkable obstacle,\n      or contains the target primitive itself (agent cannot walk onto it).\n      \"\"\"\n      # Check if out of bounds\n      if not (0 <= r < WIDTH and 0 <= c < HEIGHT):\n          return True\n      \n      # Check if it contains any non-grabbable (non-walkable) entity\n      for kind_idx in non_walkable_kind_ids:\n          if grid_snapshot[r, c, kind_idx] > 0:\n              return True # Blocked by obstacle\n              \n      # Check if it contains the target primitive itself (agent cannot walk onto it)\n      # The agent must stay adjacent to the primitive to \"USE\" it.\n      if grid_snapshot[r, c, target_primitive_id] > 0:\n          return True # Blocked by the target primitive\n          \n      return False # Not blocked\n\n  # BFS Initialization\n  # The queue stores tuples: ((current_row, current_col), current_direction), list_of_actions_to_reach_here\n  queue = collections.deque([((start_pos, start_dir), [])])\n  # The visited set stores (position_tuple, direction_int) to avoid cycles and redundant paths\n  visited = {(start_pos, start_dir)}\n\n  target_path_actions = None # Will store the sequence of actions to reach the goal state\n\n  # Perform BFS\n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      r, c = current_pos\n\n      # Check if the target primitive is directly in front of the agent at the current state.\n      # This is our goal: be adjacent to and facing the primitive.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the cell directly in front is within grid boundaries before checking its content\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          # If the cell in front contains the target primitive, we've found a path to the goal state\n          if grid_snapshot[front_r, front_c, target_primitive_id] > 0:\n              target_path_actions = path_so_far\n              break # Shortest path to target found, exit BFS\n\n      # Explore possible next actions: Move Forward, Turn Left, Turn Right\n\n      # Option 1: Try Moving Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r_move, next_c_move = r + move_dr, c + move_dc\n      next_pos_move = (next_r_move, next_c_move)\n      next_dir_move = current_dir # Direction does not change when moving forward\n\n      # Check if the next position is valid (within bounds and not blocked by obstacles/primitive itself)\n      if not _is_position_blocked(next_r_move, next_c_move):\n          # If the state (position, direction) has not been visited, add it to queue\n          if (next_pos_move, next_dir_move) not in visited:\n              visited.add((next_pos_move, next_dir_move))\n              queue.append(((next_pos_move, next_dir_move), path_so_far + [MOVE_FORWARD]))\n\n      # Option 2: Try Turning Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_so_far + [TURN_LEFT]))\n\n      # Option 3: Try Turning Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_so_far + [TURN_RIGHT]))\n\n  # If a path to the goal (adjacent and facing the primitive) was found,\n  # append the USE action to the sequence.\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T11:25:45.980210", "function_name": "collect", "function_body": "", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-08-01T11:25:47.390362", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # Helper to create a hashable state key (row, col, direction, inventory_tuple)\n  def _get_state_key(state: craft.CraftState):\n      return (state.pos[0], state.pos[1], state.dir, tuple(state.inventory))\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind_target = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind_target] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind_target in world.grabbable_indices or \n      i_kind_target == world.water_index or \n      i_kind_target == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  # This is an important pruning step. Some \"primitives\" in the DSL (like WORKSHOP0)\n  # are locations, not items to be \"collected\" into inventory.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # parent_map stores {state_key: (previous_state_key, action_taken_to_reach_this_state)}\n  parent_map = {}\n\n  # Start BFS from the current environment state.\n  initial_state_key = _get_state_key(current_state)\n  q.append(current_state)\n  parent_map[initial_state_key] = (None, None) # No parent for the starting state\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Heuristic limit to prevent excessively long searches.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # Variables to store the goal state and its final collecting actions\n  found_goal_state_pre_use = None\n  final_collection_actions_suffix = []\n\n  # 6. BFS Loop.\n  while q:\n    state = q.popleft()\n    current_state_key = _get_state_key(state)\n    \n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count >= MAX_EXPLORED_STATES: \n      continue \n\n    explored_states_count += 1 \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # --- GOAL CHECK 1: Primitive found under agent's feet after a sequence of actions ---\n    # This covers cases where the agent moves onto a grabbable item and then 'USE's it.\n    if state.grid[current_r, current_c, i_kind_target] == 1:\n        inventory_before_use_on_self = np.copy(state.inventory)\n        _, state_after_use_on_self = state.step(USE_ACT)\n        \n        # Verify successful collection: inventory count increased after USE action\n        if state_after_use_on_self.inventory[i_kind_target] > inventory_before_use_on_self[i_kind_target]:\n            found_goal_state_pre_use = state \n            final_collection_actions_suffix = [USE_ACT]\n            break # Goal achieved! Exit the BFS loop.\n\n    # --- GOAL CHECK 2: Primitive found in an adjacent cell, requiring turning and then USE ---\n    # This covers resources like trees, iron_ore, etc., that are \"used\" when facing them.\n    # state.next_to(i_kind_target) checks the 3x3 neighborhood.\n    # We then iterate through cardinal directions to find the specific cell and face it.\n    for target_dir_val in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n        dr, dc = _DIR_TO_DELTA_FRONT[target_dir_val]\n        facing_r, facing_c = current_r + dr, current_c + dc\n\n        # Ensure facing cell is within grid bounds and contains the target primitive\n        if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n            state.grid[facing_r, facing_c, i_kind_target] == 1):\n            \n            # Simulate the turning actions to face the primitive.\n            temp_state_after_turns = state \n            turns_to_face = _get_turning_actions(current_dir, target_dir_val)\n            \n            temp_path_segment_for_turns = []\n            for turn_action in turns_to_face:\n                _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n                temp_path_segment_for_turns.append(turn_action) \n\n            inventory_before_use_facing = np.copy(temp_state_after_turns.inventory)\n            _, state_after_use_facing = temp_state_after_turns.step(USE_ACT)\n\n            # Critical check: Did the count of the primitive in inventory actually increase?\n            if state_after_use_facing.inventory[i_kind_target] > inventory_before_use_facing[i_kind_target]:\n                found_goal_state_pre_use = state \n                final_collection_actions_suffix = temp_path_segment_for_turns + [USE_ACT]\n                break # Exit this inner loop, we found a way to collect.\n    \n    # If a goal state was found in either of the above checks, break out of the main BFS loop.\n    if found_goal_state_pre_use is not None:\n        break\n\n\n    # --- EXPLORE ACTIONS ---\n    # 1. Movement actions\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_state_key = _get_state_key(next_state)\n\n      if next_state_key not in parent_map: \n        parent_map[next_state_key] = (current_state_key, action)\n        q.append(next_state)\n    \n    # 2. General USE action exploration (to pick up tools or interact with workshops, etc.)\n    inventory_before_general_use = np.copy(state.inventory)\n    _, state_after_general_use = state.step(USE_ACT)\n    \n    # Check if the USE action resulted in a meaningful state change\n    if not (np.array_equal(state_after_general_use.inventory, inventory_before_general_use) and\n            state_after_general_use.pos == state.pos and\n            state_after_general_use.dir == state.dir):\n\n        next_state_key = _get_state_key(state_after_general_use)\n\n        if next_state_key not in parent_map:\n            parent_map[next_state_key] = (current_state_key, USE_ACT)\n            q.append(state_after_general_use)\n\n  # 7. Path Reconstruction.\n  # If found_goal_state_pre_use is None, it means the BFS exhausted all reachable states\n  # without finding a path to collect the primitive.\n  if found_goal_state_pre_use is None:\n      return []\n\n  path_to_pre_use_state = []\n  current_key_reconstruction = _get_state_key(found_goal_state_pre_use)\n\n  # Backtrack from the state right before the final collection actions (turns + USE)\n  # until the initial state (parent is None).\n  while parent_map[current_key_reconstruction][0] is not None:\n      prev_key, action = parent_map[current_key_reconstruction]\n      path_to_pre_use_state.append(action)\n      current_key_reconstruction = prev_key\n  path_to_pre_use_state.reverse() # The path was built in reverse order, so reverse it.\n  \n  # Combine the path to the pre-USE state with the actions needed for final collection.\n  full_path = path_to_pre_use_state + final_collection_actions_suffix\n  return full_path", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T11:26:49.539881", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set now includes the agent's inventory as part of the state key.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing, allowing BFS to distinguish\n  # between states that are identical in position/direction but differ in inventory (e.g., having a tool vs. not).\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # MAX_EXPLORED_STATES is a pragmatic limit to prevent extremely long searches.\n  # The multiplier '10' accounts for different relevant inventory states that might\n  # be reached (e.g., picking up a tool) during the search for the primitive.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # This acts as a soft limit, allowing paths that are already near completion to finish,\n    # but prevents the search from expanding indefinitely.\n    if explored_states_count > MAX_EXPLORED_STATES:\n        continue # Skip processing this state, but let BFS continue with others in the queue.\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`).\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Ensure the facing cell is within grid bounds and contains the target primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                temp_state_after_turns = state \n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                for turn_action in turns_to_face:\n                    # Reward is always 0.0, so we use `_` for the unused return value.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                # Reward is always 0.0, so we use `_` for the unused return value.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed, resource depletion) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      # Reward is always 0.0, so we use `_` for the unused return value.\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the USE action from the current position.\n    # This is important if using an item at the current position (e.g., picking up a tool)\n    # can change the inventory state, which might be necessary for later steps to collect the primitive.\n    inventory_before_any_use = np.copy(state.inventory)\n    # Reward is always 0.0, so we use `_` for the unused return value.\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if the USE action resulted in a meaningful state change (inventory, position, or direction).\n    # This prevents adding redundant states to the queue if USE had no effect.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T11:26:51.516180", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n  \n  This version refines the state exploration limit to better adapt to the environment's\n  complexity by using `world.cookbook.n_kinds` in the `MAX_EXPLORED_STATES` calculation,\n  providing a more principled heuristic for the inventory state space.\n  \"\"\"\n  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  # This check helps prune the search early if the goal is fundamentally uncollectible by USE.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set stores (row, col, direction, inventory_tuple) to ensure\n  # identical states with different inventories are treated distinctly.\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  \n  # MAX_EXPLORED_STATES: This is a pragmatic limit to prevent extremely long searches\n  # in very large or complex environments, or when no path exists.\n  # The factor `world.cookbook.n_kinds` is used as a heuristic for the potential\n  # diversity of relevant inventory states, making it more adaptive than a fixed constant.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * world.cookbook.n_kinds\n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Apply the soft limit: if too many states have been explored,\n    # prevent further expansion from this path, but allow existing queue items to be processed.\n    if explored_states_count > MAX_EXPLORED_STATES:\n        continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This specifically checks for the target primitive (`i_kind`) in the immediate vicinity\n    # and attempts to collect it.\n    if state.next_to(i_kind):\n        for target_dir in range(4): # Iterate through all 4 cardinal directions (UP, RIGHT, DOWN, LEFT)\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Ensure the cell directly in front is within grid bounds and contains the target primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions required to face the primitive.\n                temp_state_after_turns = state \n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                for turn_action in turns_to_face:\n                    # Reward is always 0.0 in this implementation, so we discard it.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify successful collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action. This is where the collection attempt happens.\n                # Reward is always 0.0, so we discard it.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical success check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed, resource depletion) handled by `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      # Reward is always 0.0, so we discard it.\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      # Add the new state to the queue if it hasn't been visited with this inventory configuration.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the USE action from the current position.\n    # This is important if using an item at the current position (e.g., picking up a tool\n    # or activating something) can change the inventory state or open up new paths.\n    inventory_before_any_use = np.copy(state.inventory)\n    # Reward is always 0.0, so we discard it.\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if the USE action resulted in a meaningful state change.\n    # This prevents adding redundant states to the queue if USE had no effect (e.g., using an empty cell).\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions\n  # and exploration limits.\n  return []", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T11:28:24.373644", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n  Specifically enhances:\n  1. The initial check for whether a primitive is collectible to include all items\n     designated as 'primitive resources' by the cookbook, ensuring the function\n     attempts to collect them if they are not already in inventory.\n  2. The general `USE` action exploration to consider all primitive resources\n     in front of the agent as potentially interactable, not just grabbable items,\n     water, or stone. This is important for scenarios where tools are needed\n     to acquire resources (e.g., using an axe on wood).\n  \"\"\"\n  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Determine if the primitive is a type that can be collected via the 'USE' action.\n  # This includes explicit primitive resources (from cookbook), grabbable items, water, or stone.\n  # The crucial improvement in v2 is including `i_kind in world.cookbook.primitives` in this check.\n  is_collectible_via_use = (\n      i_kind in world.cookbook.primitives or # Added this condition in v2\n      i_kind in world.grabbable_indices or\n      i_kind == world.water_index or\n      i_kind == world.stone_index\n  )\n\n  # If the item is not intended to be collected via 'USE', return an empty path.\n  # This acts as an early exit for truly non-collectible primitives like workshops or boundaries,\n  # which are not listed in `world.cookbook.primitives` or `world.grabbable_indices`.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set includes the agent's inventory as part of the state key,\n  # allowing the algorithm to distinguish states that are identical in position/direction\n  # but differ in inventory (e.g., having a tool vs. not).\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Increased MAX_EXPLORED_STATES due to the larger state space when tracking inventory.\n  # This heuristic limit helps prevent excessive computation in complex or unreachable scenarios.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 20 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`).\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the general 'USE' action from the current state.\n    # This is essential for picking up other grabbable items (like tools)\n    # that are not the target primitive itself but might be necessary preconditions.\n    # Only perform USE if there's a potentially interactable entity directly in front.\n    \n    # Determine the cell directly in front of the agent\n    front_dr, front_dc = _DIR_TO_DELTA_FRONT[current_dir]\n    facing_r, facing_c = current_r + front_dr, current_c + front_dc\n\n    # Check bounds for the cell in front\n    if 0 <= facing_r < grid_width and 0 <= facing_c < grid_height:\n        is_something_useable_in_front = False\n        \n        # Check if any grabbable item is present in the cell directly in front.\n        for k_idx in world.grabbable_indices:\n            if state.grid[facing_r, facing_c, k_idx] == 1:\n                is_something_useable_in_front = True\n                break\n        \n        # If still not found, check for water or stone.\n        if not is_something_useable_in_front:\n            if (state.grid[facing_r, facing_c, world.water_index] == 1 or \n                state.grid[facing_r, facing_c, world.stone_index] == 1):\n                is_something_useable_in_front = True\n\n        # NEW for V2: Also check for any other primitive resources in front that might be collected by USE.\n        # This covers items like 'WOOD' (representing a tree) that might need an axe or similar tool\n        # for extraction, even if they are not directly \"grabbable\".\n        if not is_something_useable_in_front:\n            # Iterate through all possible kind indices. If any kind at this cell is a primitive resource,\n            # then it's considered useable.\n            for kind_idx_at_cell in range(state.grid.shape[2]): \n                if state.grid[facing_r, facing_c, kind_idx_at_cell] == 1 and \\\n                   kind_idx_at_cell in world.cookbook.primitives:\n                    is_something_useable_in_front = True\n                    break\n\n        # Only attempt USE_ACT if there's something potentially interactable in front.\n        if is_something_useable_in_front:\n            inventory_before_any_use = np.copy(state.inventory)\n            _, state_after_current_use = state.step(USE_ACT)\n            \n            # Add to queue only if the USE action resulted in a meaningful state change.\n            # A meaningful change means inventory or position/direction was updated.\n            # Inventory change is the primary signal for resource collection.\n            if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n                    state_after_current_use.pos == state.pos and\n                    state_after_current_use.dir == state.dir):\n\n                next_inventory_tuple = tuple(state_after_current_use.inventory)\n                next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n                if next_state_key not in visited:\n                    visited.add(next_state_key)\n                    q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 9, "scores": {"3": 1.5}}
