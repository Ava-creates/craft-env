{"timestamp": "2025-08-01T10:36:15.895967", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` by tracking inventory in BFS visited states.\n    \n    This version refines the state exploration and goal checking, ensuring robustness\n    by comprehensively considering agent's position, direction, and inventory\n    as part of the visited state. It properly handles scenarios where intermediate\n    actions (like picking up a tool) are necessary to collect the target primitive.\n    The primary improvement over `collect_v0` (which `collect_v1` also had)\n    is the inclusion of inventory state in the BFS's `visited` set to prevent\n    infinite loops or missing valid paths when inventory changes affect reachability.\n    `collect_v2` solidifies the logic introduced in `v1`, ensuring all relevant\n    state transitions are considered for finding the shortest collection path.\n\n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect.\n\n    Returns:\n        List[int]: A sequence of action indices to execute.\n  \"\"\"\n  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set now includes the agent's inventory as part of the state key.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing, allowing BFS to distinguish\n  # between states that are identical in position/direction but differ in inventory (e.g., having a tool vs. not).\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Increased MAX_EXPLORED_STATES due to the larger state space when tracking inventory.\n  # This is a heuristic and may need tuning for specific environment complexities.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`).\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the USE action from the current position, even if not directly on the target primitive.\n    # This is important if using an item at the current position (e.g., picking up a tool)\n    # can change the inventory state, which might be necessary for later steps to collect the primitive.\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if the USE action resulted in a meaningful state change (inventory, position, or direction).\n    # This prevents adding redundant states to the queue if USE had no effect.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T10:37:03.570435", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  \n  # Extract immutable state information for BFS planning\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's initial position (row, col)\n  initial_dir = current_state.dir # Agent's initial facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive. This is what we're looking for.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Determine grid dimensions for boundary checks\n  num_rows, num_cols, _ = initial_grid.shape\n\n  # Retrieve action mapping from the environment (these are constant action IDs)\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # In CraftWorld, 'UP' means move forward\n  TURN_LEFT_ACTION = action_map['LEFT']     # Turn 90 degrees left\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Turn 90 degrees right\n  USE_ACTION = action_map['USE']            # Interact with the cell in front\n\n  # Define direction vectors for movement and turning rules (constants for agent's movement mechanics)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # Consolidated set of all indices that block agent movement (cannot walk ONTO them).\n  # This includes the primitive itself (as the agent needs to be adjacent to use it)\n  # and other non-grabbable entities like boundaries, water, or impassable workshops.\n  all_blocked_walk_indices = set(current_state.world.non_grabbable_indices)\n  all_blocked_walk_indices.add(primitive_id)\n  # Convert to a NumPy array for efficient vectorized checks on the grid.\n  all_blocked_walk_indices_np = np.array(list(all_blocked_walk_indices))\n\n  # BFS Initialization:\n  # The queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_here)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # The 'visited' set stores (position_tuple, direction_int) to prevent redundant exploration\n  # and cycles, ensuring the shortest path is found.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This variable will store the action sequence if a path is found.\n\n  # Start BFS traversal\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # Check if the target primitive is directly in front of the agent from the current state.\n      # This is the \"goal state\" for our pathfinding: being positioned to interact with the primitive.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the cell directly in front is within grid boundaries before checking its contents.\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n          # If the primitive is present in this cell, we have found a path that leads the agent\n          # to be adjacent to and facing the primitive.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Path found! Terminate BFS.\n\n      # Explore all possible next actions (Move Forward, Turn Left, Turn Right) from the current state.\n\n      # --- Try Move Forward Action ---\n      # Calculate the next position if the agent moves forward. Direction remains unchanged.\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change orientation.\n\n      # Check if the next position is within bounds and this new (position, direction) state\n      # has not been visited yet.\n      if (0 <= next_r < num_rows and 0 <= next_c < num_cols and\n          (next_pos, next_dir) not in visited):\n          \n          # Determine if the next cell is walkable.\n          # A cell is not walkable if it contains the primitive itself or any non-grabbable entity.\n          is_blocked = False\n          if len(all_blocked_walk_indices_np) > 0:\n              # np.any checks if any of the specified kind indices have a count > 0 in the cell\n              is_blocked = np.any(initial_grid[next_r, next_c, all_blocked_walk_indices_np] > 0)\n          \n          if not is_blocked: # If it's not blocked, it's walkable.\n              # If walkable, add the new state to the queue and mark it as visited.\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # --- Try Turn Left Action ---\n      # Calculate the new direction after turning left. Position remains unchanged.\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      if ((current_pos, next_dir_left) not in visited):\n          # Add the new state to the queue and mark as visited.\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # --- Try Turn Right Action ---\n      # Calculate the new direction after turning right. Position remains unchanged.\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      if ((current_pos, next_dir_right) not in visited):\n          # Add the new state to the queue and mark as visited.\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # After BFS completes:\n  # If a path to the target (adjacent and facing the primitive) was found,\n  # extend the found path with the final 'USE' action to collect the primitive.\n  # If no path was found (target_path is None), an empty list is returned,\n  # indicating the primitive is unreachable from the current state.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T10:37:04.709851", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  \n  # Extract immutable state information for BFS pathfinding\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's initial position (row, col)\n  initial_dir = current_state.dir # Agent's initial facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook's index.\n  # This ID is used to locate the primitive on the grid.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Determine grid dimensions for boundary checks during path exploration.\n  num_rows, num_cols, _ = initial_grid.shape\n\n  # Retrieve action mapping from the environment. These are constant integer IDs for actions.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # 'UP' means move forward in current direction\n  TURN_LEFT_ACTION = action_map['LEFT']     # Turn 90 degrees left\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Turn 90 degrees right\n  USE_ACTION = action_map['USE']            # Interact with the cell directly in front\n\n  # Define direction vectors for agent movement (delta_row, delta_column).\n  # These map the agent's current orientation (0-3) to the coordinates of the cell directly in front.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (current_row, current_col + 1)\n      1: (-1, 0),  # Facing UP: (current_row - 1, current_col)\n      2: (0, -1),  # Facing LEFT: (current_row, current_col - 1)\n      3: (1, 0)    # Facing DOWN: (current_row + 1, current_col)\n  }\n\n  # Define maps for new directions after turning left or right.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # e.g., RIGHT (0) -> UP (1)\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # e.g., RIGHT (0) -> DOWN (3)\n\n  # Convert the set of non-grabbable (and thus non-walkable) indices to a NumPy array for efficient checks.\n  # These are entities the agent cannot walk over (e.g., 'BOUNDARY', 'WATER', workshops).\n  non_walkable_kinds_indices_np = np.array(list(current_state.world.non_grabbable_indices))\n\n  # BFS Initialization:\n  # The queue stores tuples of: ((current_position_tuple, current_direction_int), list_of_actions_taken_so_far)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # The 'visited' set stores (position_tuple, direction_int) to prevent redundant exploration\n  # and cycles, ensuring the shortest path is found.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # This will store the sequence of actions if a path is found.\n\n  # Start BFS traversal\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # Check if the target primitive is directly in front of the agent from the current state.\n      # This is the \"goal state\" for our pathfinding: being positioned to interact with the primitive.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the cell directly in front is within grid boundaries before checking its contents.\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n          # If the primitive is present in this cell, we have found a valid path\n          # that leads the agent to be adjacent to and facing the primitive.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path_actions = path_actions\n              break # Path found! Terminate BFS.\n\n      # Explore all possible next actions (Move Forward, Turn Left, Turn Right) from the current state.\n\n      # --- Try Move Forward Action ---\n      # Calculate the next position if the agent moves forward. Direction remains unchanged.\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change orientation.\n\n      # Check if the next position is within bounds.\n      if (0 <= next_r < num_rows and 0 <= next_c < num_cols):\n          # Check if this new (position, direction) state has not been visited yet.\n          if ((next_pos, next_dir) not in visited):\n              \n              # Determine if the next cell is walkable.\n              # The agent cannot walk onto:\n              # 1. The target primitive itself (interaction is from an adjacent square, not by stepping on it).\n              # 2. Any other non-walkable entities (e.g., BOUNDARY, WATER, WORKSHOP_X that are impassable).\n              \n              # Check if the cell contains the primitive itself (agent must be adjacent, not on top)\n              is_not_target_primitive = (initial_grid[next_r, next_c, primitive_id] == 0)\n              \n              # Check if the cell contains any other non-walkable obstacles\n              contains_other_non_walkable_obstacle = False\n              if non_walkable_kinds_indices_np.size > 0: # Check if the array of non-walkables is not empty\n                  # Slice the grid at the next_pos for all known non-walkable kinds.\n                  # If any of these counts are > 0, it means an obstacle is present.\n                  if np.any(initial_grid[next_r, next_c, non_walkable_kinds_indices_np] > 0):\n                      contains_other_non_walkable_obstacle = True\n              \n              # A cell is considered walkable if it's not the target primitive and contains no other obstacles.\n              is_walkable = is_not_target_primitive and not contains_other_non_walkable_obstacle\n\n              if is_walkable:\n                  # If walkable, add the new state to the queue and mark it as visited.\n                  visited.add((next_pos, next_dir))\n                  queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # --- Try Turn Left Action ---\n      # Calculate the new direction after turning left. Position remains unchanged.\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      if ((current_pos, next_dir_left) not in visited):\n          # Add the new state to the queue and mark as visited.\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # --- Try Turn Right Action ---\n      # Calculate the new direction after turning right. Position remains unchanged.\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      if ((current_pos, next_dir_right) not in visited):\n          # Add the new state to the queue and mark as visited.\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # After BFS completes:\n  # If a path to the target (adjacent and facing the primitive) was found,\n  # extend the found path with the final 'USE' action to collect the primitive.\n  # If no path was found (target_path_actions is None), an empty list is returned,\n  # indicating the primitive is unreachable from the current state.\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T10:38:28.849744", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (r, c)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  # Robustly get primitive ID. If not found (e.g., invalid primitive name), return empty list.\n  primitive_id = current_state.world.cookbook.index.get(primitive)\n  if primitive_id is None:\n      # The primitive name is not recognized in the game's index.\n      return []\n\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  action_map = env.action_specs()\n  # Map DSL movement/turn actions to their integer indices from action_specs\n  # In Craft, 'UP' action typically means 'move forward' relative to current direction.\n  MOVE_FORWARD_ACTION = action_map['UP'] \n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define explicit direction constants for clarity\n  DIR_RIGHT = 0\n  DIR_UP = 1\n  DIR_LEFT = 2\n  DIR_DOWN = 3\n\n  # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  # This defines how position changes when moving \"forward\" in a given direction.\n  DIR_TO_DRDC = {\n      DIR_RIGHT: (0, 1),   # Facing RIGHT (0), moving increases column index\n      DIR_UP: (-1, 0),     # Facing UP (1), moving decreases row index\n      DIR_LEFT: (0, -1),   # Facing LEFT (2), moving decreases column index\n      DIR_DOWN: (1, 0)     # Facing DOWN (3), moving increases row index\n  }\n\n  # Map for turning left/right, updating the agent's direction (0-3)\n  TURN_LEFT_MAP = {\n      DIR_RIGHT: DIR_UP,\n      DIR_UP: DIR_LEFT,\n      DIR_LEFT: DIR_DOWN,\n      DIR_DOWN: DIR_RIGHT\n  }\n  TURN_RIGHT_MAP = {\n      DIR_RIGHT: DIR_DOWN,\n      DIR_UP: DIR_RIGHT,\n      DIR_LEFT: DIR_UP,\n      DIR_DOWN: DIR_LEFT\n  }\n\n  # Identify all kinds of entities that the agent cannot walk onto.\n  # This includes general non-grabbable items (like boundaries, water, workshops)\n  # AND the primitive itself (as the agent needs to stop *adjacent* to it, not on it).\n  unwalkable_kind_ids = set(current_state.world.non_grabbable_indices)\n  unwalkable_kind_ids.add(primitive_id) \n\n  # BFS state: ((row, col), direction), path_actions\n  # Queue stores ( (current_pos_tuple, current_dir_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (current_pos_tuple, current_dir_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # Stores the action list to reach the target state\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent at current state\n      # Calculate the coordinates of the cell directly in front\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if front_cell is within grid bounds\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          # Check if the front_cell contains the primitive\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Path to target found (agent is adjacent and facing the primitive)\n\n      # 2. Explore possible next actions: Move Forward, Turn Left, Turn Right\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if next_pos is within bounds and this (position, direction) state hasn't been visited\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT and\n          (next_pos, next_dir) not in visited):\n          \n          # Determine if the next position is walkable\n          is_walkable = True\n          # A cell is walkable if it doesn't contain any of the unwalkable kinds.\n          # Iterate through the grid layer at the potential next position.\n          # If any unwalkable kind is present, it's not walkable.\n          for kind_idx in unwalkable_kind_ids:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable = False\n                  break\n\n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path was found, append the USE action to the sequence\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-08-01T10:38:29.992244", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (r, c)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  action_map = env.action_specs()\n  # Map DSL movement/turn actions to their integer indices from action_specs\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  # This defines how position changes when moving \"forward\" in a given direction.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT, move in positive column direction (columns increase)\n      1: (-1, 0),  # Facing UP, move in negative row direction (rows decrease)\n      2: (0, -1),  # Facing LEFT, move in negative column direction (columns decrease)\n      3: (1, 0)    # Facing DOWN, move in positive row direction (rows increase)\n  }\n\n  # Map for turning left/right, updating the agent's direction (0-3)\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Identify all kinds of entities that the agent cannot walk onto.\n  # This includes general non-grabbable items (like boundaries, water, workshops)\n  # AND the primitive itself (as the agent needs to stop *adjacent* to it, not on it, for the USE action).\n  unwalkable_kind_ids = set(current_state.world.non_grabbable_indices)\n  unwalkable_kind_ids.add(primitive_id) \n\n  # BFS state: ((row, col), direction), path_actions\n  # Queue stores ( (current_pos_tuple, current_dir_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (current_pos_tuple, current_dir_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # Stores the action list to reach the target state\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent at current state\n      # Calculate the coordinates of the cell directly in front\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if front_cell is within grid bounds\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          # Check if the front_cell contains the primitive\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Path to target found (agent is adjacent and facing the primitive)\n\n      # 2. Explore possible next actions: Move Forward, Turn Left, Turn Right\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if next_pos is within bounds and this (position, direction) state hasn't been visited\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT and\n          (next_pos, next_dir) not in visited):\n          \n          # Determine if the next position is walkable\n          is_walkable = True\n          # A cell is walkable if it doesn't contain any of the unwalkable kinds.\n          for kind_idx in unwalkable_kind_ids:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable = False\n                  break\n\n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path was found, append the USE action to the sequence\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T10:39:05.424965", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (row, col)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Extract grid dimensions: (rows, columns)\n  grid_rows, grid_cols, _ = initial_grid.shape \n\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # Assumed UP moves agent forward in its current direction\n  TURN_LEFT_ACTION = action_map['LEFT']     # Assumed LEFT turns agent left\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Assumed RIGHT turns agent right\n  USE_ACTION = action_map['USE']            # Action to interact with an object in front\n\n  # Direction mapping: (dr, dc) for agent's facing direction\n  # This defines the change in (row, col) when moving \"forward\".\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # Map for updating the agent's direction when turning left/right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # RIGHT -> UP -> LEFT -> DOWN -> RIGHT\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # RIGHT -> DOWN -> LEFT -> UP -> RIGHT\n\n  # Determine all kinds of entities the agent cannot walk *onto*.\n  # This includes explicit non-grabbable items (like BOUNDARY, WATER, WORKSHOP)\n  # and the primitive itself (agent must be adjacent to it, not on it, to use).\n  non_walkable_kinds_set = set(current_state.world.non_grabbable_indices)\n  non_walkable_kinds_set.add(primitive_id)\n  \n  # Convert to a numpy array for efficient checking on the grid.\n  non_walkable_kinds_array = np.array(list(non_walkable_kinds_set), dtype=int)\n\n  # BFS state representation: ((current_row, current_col), current_direction_int)\n  # Queue stores ( (current_pos_tuple, current_dir_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (current_pos_tuple, current_dir_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the action sequence leading to the state\n                      # where the agent is adjacent to the primitive and facing it.\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent at the current state.\n      # If so, this is a target state, and we can stop searching.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the cell in front is within grid bounds\n      if (0 <= front_r < grid_rows and 0 <= front_c < grid_cols):\n          # Check if the front_cell contains the target primitive\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Found the path to be adjacent and facing the primitive\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if next_pos is within grid bounds and this (position, direction) state hasn't been visited\n      if (0 <= next_r < grid_rows and 0 <= next_c < grid_cols and\n          (next_pos, next_dir) not in visited):\n          \n          # Check if the next_pos is walkable.\n          # A cell is walkable if it does not contain any kind from our `non_walkable_kinds_array`.\n          # np.any efficiently checks if any non-walkable item exists in the cell's `kind` dimension.\n          if not np.any(initial_grid[next_r, next_c, non_walkable_kinds_array] > 0):\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path was found to reach an adjacent and facing position, append the USE action\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 1, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T10:39:06.538801", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  grid = current_state.grid\n  initial_pos = current_state.pos # tuple (r, c)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  # Get the integer ID for the target primitive\n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  # Get grid dimensions\n  grid_rows, grid_cols, _ = grid.shape \n\n  # Map DSL actions to their integer indices from the environment's action_specs\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define direction vectors for moving forward based on agent's current direction\n  # DIR_TO_DRDC[direction]: (delta_row, delta_col)\n  # 0:RIGHT (+col), 1:UP (-row), 2:LEFT (-col), 3:DOWN (+row)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Right: (row, col+1)\n      1: (-1, 0),  # Up:    (row-1, col)\n      2: (0, -1),  # Left:  (row, col-1)\n      3: (1, 0)    # Down:  (row+1, col)\n  }\n\n  # Define how turning actions update the agent's direction\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Identify all kinds that block agent movement.\n  # This includes non-grabbable items (like boundaries, water, workshops)\n  # and the primitive itself, as the agent cannot walk ONTO the primitive,\n  # but must be adjacent to it to 'USE' it.\n  blocking_kinds_set = set(current_state.world.non_grabbable_indices)\n  blocking_kinds_set.add(primitive_id) \n  # Convert to a numpy array for efficient checking using np.any\n  blocking_kinds_array = np.array(list(blocking_kinds_set), dtype=int)\n\n\n  # BFS initialization:\n  # Queue stores tuples of ( (current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (position, direction) tuples to prevent redundant exploration and cycles\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_to_adjacency = None # This will store the action sequence leading to the state\n                                   # where the agent is adjacent to the primitive and facing it.\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # Step 1: Check if the primitive is directly in front of the agent at the current state.\n      # This is our goal condition for stopping the BFS.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the cell in front is within grid boundaries\n      if (0 <= front_r < grid_rows and 0 <= front_c < grid_cols):\n          # If the front cell contains the primitive, we've found the path to be adjacent and facing it.\n          if grid[front_r, front_c, primitive_id] > 0:\n              target_path_to_adjacency = path_actions\n              break # Path to target found, exit BFS\n\n      # Step 2: Explore possible next actions (Move Forward, Turn Left, Turn Right)\n\n      # Action: Move Forward\n      next_r_forward, next_c_forward = r + front_dr, c + front_dc # Reuse front_dr, front_dc for movement\n      next_pos_forward = (next_r_forward, next_c_forward)\n      next_dir_forward = current_dir # Direction does not change when moving forward\n\n      # Check if the forward move is valid:\n      # - Within grid boundaries\n      # - This (position, direction) state has not been visited yet\n      # - The target cell is walkable (does not contain any blocking kinds)\n      if (0 <= next_r_forward < grid_rows and 0 <= next_c_forward < grid_cols and\n          (next_pos_forward, next_dir_forward) not in visited):\n          \n          # Check if the cell at next_pos_forward is walkable using the pre-computed blocking_kinds_array.\n          # np.any will be True if any of the blocking kinds are present in the cell.\n          is_walkable = not np.any(grid[next_r_forward, next_c_forward, blocking_kinds_array] > 0)\n          \n          if is_walkable:\n              visited.add((next_pos_forward, next_dir_forward))\n              queue.append(((next_pos_forward, next_dir_forward), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Action: Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Position remains the same when turning\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Action: Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Position remains the same when turning\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path was found to reach the state where the agent is adjacent to the primitive and facing it,\n  # append the USE action to complete the collection process.\n  if target_path_to_adjacency is not None:\n      actions_list.extend(target_path_to_adjacency)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 1, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T10:39:59.127520", "function_name": "collect", "function_body": "  actions_list = []\n  \n  # Access the internal CraftState object which holds the current grid, agent position, direction, and inventory.\n  current_state = env._current_state \n\n  # Extract initial conditions for the agent's starting point and orientation.\n  initial_grid = current_state.grid  # The static grid layout of the environment.\n  initial_pos = current_state.pos    # Agent's current (row, col) position on the grid.\n  initial_dir = current_state.dir    # Agent's current facing direction (0:Right, 1:Up, 2:Left, 3:Down).\n\n  # Retrieve the integer ID for the target primitive from the environment's cookbook index.\n  # This ID is crucial for identifying the primitive on the grid.\n  try:\n      primitive_id = current_state.world.cookbook.index[primitive]\n  except KeyError:\n      # If the specified primitive name does not exist in the environment's index,\n      # it cannot be collected. Return an empty list of actions immediately.\n      return []\n\n  # Get the dimensions of the grid for boundary checks during pathfinding.\n  GRID_ROWS, GRID_COLS, _ = initial_grid.shape \n\n  # Obtain the integer mapping for actions from the environment's action specifications.\n  # This ensures the generated actions are compatible with `env.step()`.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # Action to move one step in the current facing direction.\n  TURN_LEFT_ACTION = action_map['LEFT']     # Action to rotate the agent 90 degrees counter-clockwise.\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Action to rotate the agent 90 degrees clockwise.\n  USE_ACTION = action_map['USE']            # Action to interact with (e.g., collect) the cell directly in front.\n\n  # Define the change in (row, col) coordinates for each facing direction.\n  # This helps in calculating the next position after moving or identifying the cell in front.\n  # Directions: 0 (Right), 1 (Up), 2 (Left), 3 (Down).\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: column increases.\n      1: (-1, 0),  # Facing UP: row decreases.\n      2: (0, -1),  # Facing LEFT: column decreases.\n      3: (1, 0)    # Facing DOWN: row increases.\n  }\n\n  # Obtain the set of integer IDs for entities that block agent movement.\n  # These are entities that the agent cannot walk over (e.g., 'BOUNDARY', 'WATER', 'WORKSHOP_X').\n  non_walkable_kind_ids = current_state.world.non_grabbable_indices\n\n  # Initialize Breadth-First Search (BFS) data structures.\n  # The queue stores tuples: ((current_position, current_direction), list_of_actions_taken_to_reach_here).\n  # This allows finding the shortest path and reconstructing the sequence of actions.\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # The visited set stores (position, direction) pairs to prevent redundant exploration\n  # of states and guarantee that the first path found is indeed the shortest.\n  visited = {(initial_pos, initial_dir)}\n\n  # Variable to store the sequence of actions that leads the agent to a position\n  # where it is adjacent to and facing the target primitive.\n  path_to_adjacent_primitive = None \n\n  # Perform BFS traversal until the queue is empty or the target is found.\n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      current_r, current_c = current_pos\n\n      # 1. Goal Check: Determine if the agent is currently in a \"collectable\" state.\n      # This means the target primitive must be directly in front of the agent.\n      \n      # Calculate the coordinates of the cell directly in front of the agent based on current direction.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = current_r + front_dr, current_c + front_dc\n      \n      # Check if the cell in front is within grid boundaries.\n      if 0 <= front_r < GRID_ROWS and 0 <= front_c < GRID_COLS:\n          # Check if the cell in front contains the target primitive.\n          # `initial_grid[r, c, kind_id] > 0` indicates the presence of `kind_id` at `(r,c)`.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              path_to_adjacent_primitive = path_so_far\n              break # Shortest path to a 'USE' position found! Exit BFS.\n\n      # 2. Explore possible next actions from the current state (move, turn left, turn right).\n      # For each action, compute the resulting new state and add it to the queue if valid and unvisited.\n\n      # --- Option A: Try to Move Forward (using the 'UP' action) ---\n      next_r_move, next_c_move = current_r + DIR_TO_DRDC[current_dir][0], current_c + DIR_TO_DRDC[current_dir][1]\n      next_pos_move = (next_r_move, next_c_move)\n      next_dir_move = current_dir # Direction does not change when moving forward.\n\n      # Check if the potential next position is within grid bounds AND has not been visited\n      # with the same orientation (to ensure optimality).\n      if (0 <= next_r_move < GRID_ROWS and 0 <= next_c_move < GRID_COLS and\n          (next_pos_move, next_dir_move) not in visited):\n          \n          # Determine if the `next_pos_move` cell is walkable for the agent.\n          # A cell is walkable if:\n          #   a) It does not contain any entity from the `non_walkable_kind_ids` set.\n          #   b) It is NOT the target `primitive_id` itself (agent typically stands beside, not on, the primitive).\n          is_walkable = True\n          for kind_idx in non_walkable_kind_ids:\n              if initial_grid[next_r_move, next_c_move, kind_idx] > 0:\n                  is_walkable = False\n                  break # Found a blocking entity, so this cell is not walkable.\n          \n          # Additionally, prevent the agent from walking directly onto the primitive it wants to collect.\n          if is_walkable and initial_grid[next_r_move, next_c_move, primitive_id] > 0:\n              is_walkable = False\n\n          if is_walkable:\n              # If the next state is valid and walkable, add it to the visited set and the queue.\n              visited.add((next_pos_move, next_dir_move))\n              queue.append(((next_pos_move, next_dir_move), path_so_far + [MOVE_FORWARD_ACTION]))\n\n      # --- Option B: Try to Turn Left (using the 'LEFT' action) ---\n      # Calculate the new direction after a 90-degree counter-clockwise turn.\n      # The direction cycle is: Right(0) -> Up(1) -> Left(2) -> Down(3) -> Right(0).\n      next_dir_left = (current_dir + 1) % 4\n      # Position remains unchanged during a turn.\n      if (current_pos, next_dir_left) not in visited:\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_so_far + [TURN_LEFT_ACTION]))\n\n      # --- Option C: Try to Turn Right (using the 'RIGHT' action) ---\n      # Calculate the new direction after a 90-degree clockwise turn.\n      # The direction cycle is: Right(0) -> Down(3) -> Left(2) -> Up(1) -> Right(0).\n      # Adding 4 before modulo handles negative results from (current_dir - 1) correctly in Python.\n      next_dir_right = (current_dir - 1 + 4) % 4 \n      # Position remains unchanged during a turn.\n      if (current_pos, next_dir_right) not in visited:\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_so_far + [TURN_RIGHT_ACTION]))\n\n  # After the BFS completes:\n  # If a path was successfully found to a state where the agent is ready to collect the primitive,\n  # append the 'USE' action to the sequence.\n  if path_to_adjacent_primitive is not None:\n      actions_list.extend(path_to_adjacent_primitive)\n      actions_list.append(USE_ACTION)\n\n  # Return the generated sequence of actions.\n  # This list will be empty if the primitive was not found on the grid or was unreachable.\n  return actions_list", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T10:40:00.320176", "function_name": "collect", "function_body": "  actions_list = []\n  \n  # Access the internal CraftState object which holds the current grid, position, and inventory.\n  current_state = env._current_state \n\n  # Extract essential information for pathfinding from the current state.\n  initial_grid = current_state.grid  # The static grid layout of the environment.\n  initial_pos = current_state.pos    # Agent's current (row, col) position on the grid.\n  initial_dir = current_state.dir    # Agent's current facing direction (0:Right, 1:Up, 2:Left, 3:Down).\n\n  # Get the integer ID for the target primitive from the cookbook index.\n  try:\n      primitive_id = current_state.world.cookbook.index[primitive]\n  except KeyError:\n      # If the primitive name is not recognized, it cannot be collected.\n      return []\n\n  # Get grid dimensions for boundary checks during pathfinding.\n  GRID_ROWS, GRID_COLS, _ = initial_grid.shape \n\n  # Map action names (from DSL) to their integer indices (used by env.step).\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Pre-defined changes in (row, col) coordinates for each direction.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: +1 to column.\n      1: (-1, 0),  # Facing UP: -1 to row.\n      2: (0, -1),  # Facing LEFT: -1 to column.\n      3: (1, 0)    # Facing DOWN: +1 to row.\n  }\n\n  # Set of entity kind IDs that represent non-walkable terrain.\n  non_walkable_kind_ids = current_state.world.non_grabbable_indices\n\n  # Helper function to determine if a cell at (r, c) is a valid and walkable location for the agent.\n  # This encapsulates the complex logic from v1 for better readability and reusability.\n  def _is_walkable_cell(r, c):\n      \"\"\"Checks if the given grid cell (r, c) is within bounds and does not contain\n      any blocking entities or the primitive itself (as agent stands next to it).\"\"\"\n      # 1. Check if the cell is within the grid boundaries.\n      if not (0 <= r < GRID_ROWS and 0 <= c < GRID_COLS):\n          return False\n\n      # 2. Check if the cell contains any non-grabbable entity that blocks movement.\n      for kind_idx in non_walkable_kind_ids:\n          if initial_grid[r, c, kind_idx] > 0:\n              return False\n      \n      # 3. Agent cannot walk directly *onto* the primitive it intends to collect.\n      if initial_grid[r, c, primitive_id] > 0:\n          return False\n      \n      return True\n\n  # BFS Initialization:\n  # Queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_here).\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # Visited set stores (position_tuple, direction_int) to avoid redundant exploration\n  # and ensure the shortest path is found.\n  visited = {(initial_pos, initial_dir)}\n\n  # Variable to store the shortest action sequence to reach a state where the agent\n  # is adjacent to and facing the primitive.\n  path_to_adjacent_primitive = None \n\n  # Start BFS traversal.\n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      current_r, current_c = current_pos\n\n      # Goal Check: Is the primitive directly in front of the agent at the current state?\n      # This is the state from which the 'USE' action can be executed.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = current_r + front_dr, current_c + front_dc\n      \n      # Check if the cell in front is within grid bounds AND contains the target primitive.\n      if (0 <= front_r < GRID_ROWS and 0 <= front_c < GRID_COLS and\n          initial_grid[front_r, front_c, primitive_id] > 0):\n          path_to_adjacent_primitive = path_so_far\n          break # Shortest path to a 'USE'-ready position found.\n\n      # Explore possible next actions from the current state: Move, Turn Left, Turn Right.\n\n      # Option 1: Move Forward (UP action in CraftLab context)\n      next_r_move, next_c_move = current_r + DIR_TO_DRDC[current_dir][0], current_c + DIR_TO_DRDC[current_dir][1]\n      next_pos_move = (next_r_move, next_c_move)\n      next_dir_move = current_dir # Direction does not change when moving forward.\n\n      # Use the extracted helper function to validate the next cell.\n      if _is_walkable_cell(next_r_move, next_c_move):\n          if (next_pos_move, next_dir_move) not in visited:\n              visited.add((next_pos_move, next_dir_move))\n              queue.append(((next_pos_move, next_dir_move), path_so_far + [MOVE_FORWARD_ACTION]))\n\n      # Option 2: Turn Left (LEFT action)\n      next_dir_left = (current_dir + 1) % 4 # Cycle directions: 0->1, 1->2, 2->3, 3->0 (Right->Up->Left->Down->Right)\n      # Position does not change when turning.\n      if (current_pos, next_dir_left) not in visited:\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_so_far + [TURN_LEFT_ACTION]))\n\n      # Option 3: Turn Right (RIGHT action)\n      next_dir_right = (current_dir - 1 + 4) % 4 # Cycle directions: 0->3, 1->0, 2->1, 3->2 (Right->Down->Left->Up->Right)\n      # Position does not change when turning.\n      if (current_pos, next_dir_right) not in visited:\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_so_far + [TURN_RIGHT_ACTION]))\n\n  # After BFS completes:\n  # If a path was found to a state where the agent is adjacent and facing the primitive,\n  # append the 'USE' action to complete the collection process.\n  if path_to_adjacent_primitive is not None:\n      actions_list.extend(path_to_adjacent_primitive)\n      actions_list.append(USE_ACTION)\n\n  # Return the sequence of actions. This list will be empty if the primitive\n  # was not found or was unreachable.\n  return actions_list", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T10:40:53.872242", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's initial position (row, col)\n  initial_dir = current_state.dir # Agent's initial facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Retrieve the integer ID for the target primitive from the cookbook's index.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Get grid dimensions: num_rows corresponds to grid.shape[0], num_cols to grid.shape[1].\n  num_rows, num_cols, _ = initial_grid.shape\n\n  # Retrieve numerical action codes from the environment's action_specs for clarity and consistency.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # Action to move forward in the current direction.\n  TURN_LEFT_ACTION = action_map['LEFT']     # Action to turn 90 degrees left.\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Action to turn 90 degrees right.\n  USE_ACTION = action_map['USE']            # Action to interact with (collect) the item in the cell directly in front.\n\n  # Define how movement changes row/column based on the agent's current direction.\n  # This mapping specifies (delta_row, delta_column) for moving \"forward\" given the agent's direction.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: moves to (row, col+1)\n      1: (-1, 0),  # Facing UP: moves to (row-1, col)\n      2: (0, -1),  # Facing LEFT: moves to (row, col-1)\n      3: (1, 0)    # Facing DOWN: moves to (row+1, col)\n  }\n\n  # Define how turns update the agent's direction. Directions wrap around (e.g., UP from RIGHT, RIGHT from DOWN).\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # RIGHT(0)->UP(1)->LEFT(2)->DOWN(3)->RIGHT(0)\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # RIGHT(0)->DOWN(3)->LEFT(2)->UP(1)->RIGHT(0)\n\n  # Get indices of entities that block agent movement (e.g., BOUNDARY, WATER, WORKSHOP locations).\n  # These are entities the agent cannot occupy a cell with. Convert to a list for efficient NumPy indexing.\n  non_walkable_kinds_indices_list = list(current_state.world.non_grabbable_indices)\n\n  # Helper function to determine if a specific grid cell (r, c) is traversable by the agent.\n  # A cell is walkable if it's within bounds and does not contain any non-walkable entities,\n  # nor the primitive itself (as collection is done from an adjacent cell via 'USE').\n  def is_valid_and_walkable_cell(r: int, c: int) -> bool:\n      # Check if coordinates are within the grid boundaries.\n      if not (0 <= r < num_rows and 0 <= c < num_cols):\n          return False\n      \n      # The agent cannot move *into* the cell occupied by the primitive it wants to collect.\n      # Collection (via 'USE' action) happens from an adjacent cell.\n      if initial_grid[r, c, primitive_id] > 0:\n          return False\n          \n      # Check if the cell contains any entity that explicitly blocks agent movement.\n      # This is done by summing the counts of all non-walkable kinds at (r,c).\n      # If the sum is greater than 0, it means at least one blocking entity is present.\n      if non_walkable_kinds_indices_list and np.sum(initial_grid[r, c, non_walkable_kinds_indices_list]) > 0:\n          return False\n          \n      return True\n\n  # Initialize Breadth-First Search (BFS) to find the shortest path.\n  # The queue stores tuples: ((agent_position_tuple, agent_direction_int), list_of_actions_taken_so_far).\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # The visited set stores (agent_position_tuple, agent_direction_int) tuples.\n  # This prevents re-exploring states already visited, ensuring the shortest path is found.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the optimal action sequence to reach the pre-collection state.\n\n  # Begin BFS traversal.\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Goal Check: Determine if the primitive is directly in front of the agent from the current state.\n      # This is the target condition: being adjacent to and facing the primitive, ready to 'USE'.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the cell in front is within grid boundaries before checking its contents.\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n          # If the primitive is present in the cell directly in front, we have found our target state.\n          target_primitive_count = initial_grid[front_r, front_c, primitive_id]\n          if target_primitive_count > 0:\n              target_path = path_actions\n              break # Shortest path found, exit the BFS loop.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n\n      # Try Moving Forward (Action: MOVE_FORWARD_ACTION)\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Direction remains unchanged when moving forward.\n\n      # If the next cell is walkable and this specific (position, direction) state has not been visited,\n      # add it to the queue for future exploration.\n      if is_valid_and_walkable_cell(next_r, next_c) and (next_pos, next_dir) not in visited:\n          visited.add((next_pos, next_dir))\n          queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turning Left (Action: TURN_LEFT_ACTION)\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Position does not change when turning.\n      if (current_pos, next_dir_left) not in visited:\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turning Right (Action: TURN_RIGHT_ACTION)\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Position does not change when turning.\n      if (current_pos, next_dir_right) not in visited:\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path to the target pre-collection state was found (i.e., target_path is not None),\n  # append the final 'USE' action to complete the collection process.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION) # Add the crucial 'USE' action to collect the primitive.\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T10:40:55.100138", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n    Finds the shortest path from the agent's current position and direction to a state\n    where the specified `primitive` is directly in front of the agent, and then adds\n    the 'USE' action to collect it. Uses Breadth-First Search (BFS) for pathfinding.\n\n    Args:\n        env (env.CraftLab): The CraftLab object containing the current game state.\n        primitive (str): The string name of the primitive item to collect (e.g., \"WOOD\", \"STONE\").\n\n    Returns:\n        List[int]: A sequence of action indices (integers) that the agent should execute\n                   to find and collect the primitive. Returns an empty list if the primitive\n                   cannot be reached or collected.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's starting position (row, col)\n  initial_dir = current_state.dir # Agent's initial facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Resolve the string name of the primitive to its integer ID using the cookbook's index.\n  # This ID is crucial for identifying the primitive on the grid.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Get grid dimensions: num_rows corresponds to grid.shape[0], num_cols to grid.shape[1].\n  num_rows, num_cols, _ = initial_grid.shape\n\n  # Retrieve numerical action codes from the environment's action_specs for clearer code.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define how movement changes row/column based on the agent's current direction.\n  # This mapping specifies the (delta_row, delta_column) for moving \"forward\" relative\n  # to the agent's current orientation (0:R, 1:U, 2:L, 3:D).\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: moves to (row, col+1)\n      1: (-1, 0),  # Facing UP: moves to (row-1, col)\n      2: (0, -1),  # Facing LEFT: moves to (row, col-1)\n      3: (1, 0)    # Facing DOWN: moves to (row+1, col)\n  }\n\n  # Define how turns update the agent's direction.\n  # These mappings ensure correct cyclic updates for 0-3 directions.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # RIGHT(0)->UP(1)->LEFT(2)->DOWN(3)->RIGHT(0)\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # RIGHT(0)->DOWN(3)->LEFT(2)->UP(1)->RIGHT(0)\n\n  # Pre-fetch indices of non-grabbable entities that block agent movement.\n  # Converting to a list allows for more flexible indexing/iteration, especially with numpy.\n  non_walkable_kinds_indices = list(current_state.world.non_grabbable_indices)\n\n  # Helper function to determine if a cell (r, c) is a valid and walkable location for the agent.\n  # A cell is walkable if it's within grid boundaries and does not contain any static obstacles\n  # or the primitive itself (as collection requires being adjacent, not occupying the same cell).\n  def _is_valid_and_walkable(r: int, c: int) -> bool:\n      # Check boundary conditions first.\n      if not (0 <= r < num_rows and 0 <= c < num_cols):\n          return False\n      \n      # The agent cannot move into the cell occupied by the primitive it intends to collect.\n      # Collection (via 'USE' action) occurs from an adjacent cell.\n      if initial_grid[r, c, primitive_id] > 0:\n          return False\n          \n      # Check if the cell contains any non-walkable entities (e.g., BOUNDARY, WATER, WORKSHOP_X).\n      # Summing the counts of all non-grabbable kinds at (r,c) quickly tells us if any are present.\n      if non_walkable_kinds_indices and np.sum(initial_grid[r, c, non_walkable_kinds_indices]) > 0:\n          return False\n          \n      return True\n\n  # Initialize Breadth-First Search (BFS) for finding the shortest path.\n  # The queue stores tuples: ((agent_position_tuple, agent_direction_int), list_of_actions_taken_so_far).\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # The visited set stores (agent_position_tuple, agent_direction_int) tuples.\n  # This prevents re-exploring states already processed, guaranteeing the shortest path.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the optimal action sequence to reach the pre-collection state.\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Goal Check: Determine if the primitive is directly in front of the agent from the current state.\n      # This is the desired pre-collection state: adjacent to and facing the primitive, ready to 'USE'.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the cell in front is within grid boundaries before checking its contents.\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n          # If the primitive is present in the cell directly in front, we have found our target state.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Shortest path found, exit the BFS loop.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n\n      # Try Moving Forward (Action: MOVE_FORWARD_ACTION)\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Direction remains unchanged when moving forward.\n\n      # If the next cell is valid and walkable for the agent, and this specific (position, direction)\n      # state has not been visited, add it to the queue for future exploration.\n      if _is_valid_and_walkable(next_r, next_c) and (next_pos, next_dir) not in visited:\n          visited.add((next_pos, next_dir))\n          queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turning Left (Action: TURN_LEFT_ACTION)\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Position does not change when turning.\n      if (current_pos, next_dir_left) not in visited:\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turning Right (Action: TURN_RIGHT_ACTION)\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Position does not change when turning.\n      if (current_pos, next_dir_right) not in visited:\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path to the target pre-collection state was found (i.e., target_path is not None),\n  # append the final 'USE' action to complete the collection process.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION) # Add the crucial 'USE' action to collect the primitive.\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T10:42:19.844565", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` by providing more detailed comments and a clearer structure of the BFS.\"\"\"\n  \"\"\"This implementation uses Breadth-First Search (BFS) to find the shortest\n  sequence of actions to collect a specified primitive from the environment.\n  It tracks the agent's position, direction, and critically, its inventory\n  within the BFS `visited` set to properly handle scenarios where collecting\n  intermediate tools (like an axe) is necessary before collecting the target\n  primitive (like wood). It also explores the 'USE' action generally to account\n  for picking up such intermediate items.\n\n  Args:\n      env (env.CraftLab): The CraftLab object representing the current simulation.\n      primitive (str): The name of the primitive resource to collect (e.g., \"wood\", \"stone\").\n\n  Returns:\n      List[int]: A sequence of integer action indices (e.g., `[UP, UP, USE]`)\n                 that, when executed, will lead to the collection of the primitive.\n                 Returns an empty list if the primitive is already in inventory\n                 or if no path is found.\n  \"\"\"\n  current_state = env._current_state\n  world = env.world\n\n  # 1. Map the primitive name to its integer ID.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized in the world's cookbook, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If so, it's already \"collected,\" and no actions are needed.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Determine if the primitive is a type that can be collected via the 'USE' action.\n  # This includes grabbable items (like tools), water, or stone. Other items (e.g., workshops, boundaries)\n  # are not typically \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or\n      i_kind == world.water_index or\n      i_kind == world.stone_index\n  )\n\n  # If the item is not intended to be collected via 'USE', return an empty path.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action constants and directional deltas for grid navigation.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # Delta values for checking the cell directly in front of the agent based on its current direction.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (North)\n      1: (0, 1),  # RIGHT: row, col + 1 (East)\n      2: (1, 0),  # DOWN: row + 1, col (South)\n      3: (0, -1)  # LEFT: row, col - 1 (West)\n  }\n\n  # Helper function to compute the minimal sequence of turns to face a target direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the correct direction.\n\n      # Calculate the difference in directions, wrapping around 0-3.\n      diff = (target_dir - current_dir + 4) % 4\n\n      if diff == 1: # Target is one step clockwise.\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise.\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn.\n          return [RIGHT_ACT, RIGHT_ACT] # Two successive right turns (or left turns).\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The `visited` set stores a tuple `(row, col, direction, inventory_tuple)` to represent\n  # a unique state. Converting inventory (numpy array) to a tuple makes it hashable for the set.\n  visited = set()\n\n  # Add the initial state to the queue and visited set.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, [])) # (current_state, path_to_reach_this_state)\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Heuristic limit to prevent the BFS from running indefinitely in complex or unreachable scenarios.\n  # The multiplier (10) is chosen to allow exploration of states including tool acquisition.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10\n  explored_states_count = 0\n\n  # 6. BFS Loop: Continues until the queue is empty or the goal is found.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and its associated path.\n    explored_states_count += 1\n\n    # Pruning: If too many distinct states have been explored, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n\n    # Goal Check: Can the target primitive be collected from the current `state`?\n    # This involves checking if the primitive is in the 3x3 neighborhood around the agent.\n    if state.next_to(i_kind):\n        # Iterate through all four cardinal directions to check if the primitive is directly in front.\n        for target_dir in range(4):\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell directly in front is within bounds and contains the target primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and\n                state.grid[facing_r, facing_c, i_kind] == 1):\n\n                # Calculate and apply the turning actions required to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state\n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Record inventory *before* attempting the 'USE' action to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action on the temporary state.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Crucial verification: Check if the count of the target primitive in inventory\n                # actually increased. This confirms successful collection, accounting for any\n                # game rules (e.g., requiring tools) handled by `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT] # Found a path!\n\n    # Explore possible future states by performing movement actions.\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      # If this next state (position, direction, and inventory) has not been visited, add it to the queue.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n\n    # Explore the 'USE' action from the current state, even if not directly facing the target primitive.\n    # This is vital for scenarios where using an item at the current location (e.g., picking up a tool)\n    # might enable subsequent collection steps.\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n\n    # Only add the state after a general 'USE' action if it actually caused a change\n    # in inventory, position, or direction, preventing redundant explorations.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS loop completes and no path to collect the primitive was found,\n  # it means the primitive is currently unreachable given the environment and agent's capabilities.\n  return []", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T10:42:21.398889", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set now includes the agent's inventory as part of the state key,\n  # allowing the algorithm to distinguish states that are identical in position/direction\n  # but differ in inventory (e.g., having a tool vs. not).\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Increased MAX_EXPLORED_STATES due to the larger state space when tracking inventory.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`).\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # IMPROVEMENT for v2: More targeted USE action.\n    # Instead of always performing USE, check if there's *any* grabbable item\n    # or a specifically \"useable\" entity (like water/stone) directly in front of the agent.\n    # This prevents redundant exploration of USE actions that are guaranteed to do nothing.\n    \n    # Determine the cell directly in front of the agent\n    front_dr, front_dc = _DIR_TO_DELTA_FRONT[current_dir]\n    facing_r, facing_c = current_r + front_dr, current_c + front_dc\n\n    # Check bounds for the cell in front\n    if 0 <= facing_r < grid_width and 0 <= facing_c < grid_height:\n        # Check if any grabbable item or a special useable resource (water, stone)\n        # is present in the cell directly in front of the agent.\n        is_something_useable_in_front = False\n        \n        # Check grabbable items\n        for k_idx in world.grabbable_indices:\n            if state.grid[facing_r, facing_c, k_idx] == 1:\n                is_something_useable_in_front = True\n                break\n        \n        # If no grabbable item, check for water or stone\n        if not is_something_useable_in_front:\n            if (state.grid[facing_r, facing_c, world.water_index] == 1 or \n                state.grid[facing_r, facing_c, world.stone_index] == 1):\n                is_something_useable_in_front = True\n\n        # Only attempt USE_ACT if there's something potentially interactable in front.\n        if is_something_useable_in_front:\n            inventory_before_any_use = np.copy(state.inventory)\n            _, state_after_current_use = state.step(USE_ACT)\n            \n            # Add to queue only if the USE action resulted in a meaningful state change.\n            if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n                    state_after_current_use.pos == state.pos and\n                    state_after_current_use.dir == state.dir):\n\n                next_inventory_tuple = tuple(state_after_current_use.inventory)\n                next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n                if next_state_key not in visited:\n                    visited.add(next_state_key)\n                    q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T10:43:44.861897", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` by correctly handling immediate collection of items\n  on the agent's current cell, and clarifying the BFS structure.\n\n  This implementation extends `collect_v1`'s Breadth-First Search (BFS) to correctly\n  identify paths where a collectible primitive might be located directly under the agent.\n  `collect_v1` primarily focused on checking cells *adjacent* to the agent for collection.\n  `collect_v2` ensures that if a grabbable item (like a tool) is present on the agent's\n  current position, a simple 'USE' action without movement or turning is considered\n  as a valid collection step, making the path finding more complete.\n\n  Args:\n      env (env.CraftLab): The CraftLab object representing the current simulation.\n      primitive (str): The name of the primitive resource to collect (e.g., \"wood\", \"axe\").\n\n  Returns:\n      List[int]: A sequence of integer action indices (e.g., `[UP, UP, USE]`)\n                 that, when executed, will lead to the collection of the primitive.\n                 Returns an empty list if the primitive is already in inventory\n                 or if no path is found.\n  \"\"\"\n  current_state = env._current_state\n  world = env.world\n\n  # 1. Map the primitive name to its integer ID.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If so, it's already \"collected,\" and no actions are needed.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Determine if the primitive is a type that can be collected via the 'USE' action.\n  # This includes grabbable items (like tools), water, or stone. Other items (e.g., workshops, boundaries)\n  # are not typically \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or\n      i_kind == world.water_index or\n      i_kind == world.stone_index\n  )\n\n  # If the item is not intended to be collected via 'USE', return an empty path.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action constants and directional deltas for grid navigation.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # Delta values for checking the cell directly in front of the agent based on its current direction.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (North)\n      1: (0, 1),  # RIGHT: row, col + 1 (East)\n      2: (1, 0),  # DOWN: row + 1, col (South)\n      3: (0, -1)  # LEFT: row, col - 1 (West)\n  }\n\n  # Helper function to compute the minimal sequence of turns to face a target direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the correct direction.\n\n      # Calculate the difference in directions, wrapping around 0-3.\n      diff = (target_dir - current_dir + 4) % 4\n\n      if diff == 1: # Target is one step clockwise.\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise.\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn.\n          return [RIGHT_ACT, RIGHT_ACT] # Two successive right turns (or left turns).\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The `visited` set stores a tuple `(row, col, direction, inventory_tuple)` to represent\n  # a unique state. Converting inventory (numpy array) to a tuple makes it hashable for the set.\n  visited = set()\n\n  # Add the initial state to the queue and visited set.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, [])) # (current_state, path_to_reach_this_state)\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Heuristic limit to prevent the BFS from running indefinitely in complex or unreachable scenarios.\n  # The multiplier (10) is chosen to allow exploration of states including tool acquisition.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10\n  explored_states_count = 0\n\n  # 6. BFS Loop: Continues until the queue is empty or the goal is found.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and its associated path.\n    explored_states_count += 1\n\n    # Pruning: If too many distinct states have been explored, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n\n    # IMPROVEMENT for collect_v2: Goal Check - can the primitive be collected from the current state?\n    # This now considers two cases:\n    # 1. The primitive is directly under the agent (and is grabbable).\n    # 2. The primitive is in an adjacent cell (requires turning to face and then USE).\n\n    # Case 1: Primitive is directly under the agent and is grabbable.\n    if i_kind in world.grabbable_indices and state.grid[current_r, current_c, i_kind] == 1:\n        inventory_before_use = np.copy(state.inventory)\n        _, state_after_use = state.step(USE_ACT) # Attempt to pick up from current spot.\n\n        if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n            return path + [USE_ACT] # Found a path by picking up from current cell.\n\n    # Case 2: Primitive is in an adjacent cell and requires facing it.\n    # We use state.next_to(i_kind) as a broader hint, then refine by checking specific directions.\n    # Note: state.next_to also checks the current cell, but we've handled that explicitly above for grabbables.\n    if state.next_to(i_kind): # This ensures an item of i_kind is in the 3x3 neighborhood.\n        # Iterate through all four cardinal directions to check if the primitive is directly in front.\n        for target_dir in range(4):\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell directly in front is within bounds and contains the target primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and\n                state.grid[facing_r, facing_c, i_kind] == 1):\n\n                # Calculate and apply the turning actions required to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state\n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Record inventory *before* attempting the 'USE' action to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action on the temporary state.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Crucial verification: Check if the count of the target primitive in inventory\n                # actually increased. This confirms successful collection, accounting for any\n                # game rules (e.g., requiring tools) handled by `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT] # Found a path!\n\n    # Explore possible future states by performing movement actions.\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      # If this next state (position, direction, and inventory) has not been visited, add it to the queue.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n\n    # Explore the 'USE' action from the current state, even if not directly facing the target primitive.\n    # This is vital for scenarios where using an item at the current location (e.g., picking up a tool)\n    # might enable subsequent collection steps. This general 'USE' acts as a catch-all for various\n    # interactions that change the state (e.g., picking up a tool from the ground, interacting with a workshop).\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n\n    # Only add the state after a general 'USE' action if it actually caused a change\n    # in inventory, position, or direction, preventing redundant explorations.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS loop completes and no path to collect the primitive was found,\n  # it means the primitive is currently unreachable given the environment and agent's capabilities.\n  return []", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T10:43:46.349807", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Map the primitive name to its integer ID.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized in the world's cookbook, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If so, it's already \"collected,\" and no actions are needed.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Determine if the primitive is a type that can be collected via the 'USE' action.\n  # This includes grabbable items (like tools), water, or stone. Other items (e.g., workshops, boundaries)\n  # are not typically \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or\n      i_kind == world.water_index or\n      i_kind == world.stone_index\n  )\n\n  # If the item is not intended to be collected via 'USE', return an empty path.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action constants and directional deltas for grid navigation.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # Delta values for checking the cell directly in front of the agent based on its current direction.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (North)\n      1: (0, 1),  # RIGHT: row, col + 1 (East)\n      2: (1, 0),  # DOWN: row + 1, col (South)\n      3: (0, -1)  # LEFT: row, col - 1 (West)\n  }\n\n  # Helper function to compute the minimal sequence of turns to face a target direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the correct direction.\n\n      # Calculate the difference in directions, wrapping around 0-3.\n      diff = (target_dir - current_dir + 4) % 4\n\n      if diff == 1: # Target is one step clockwise.\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise.\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn.\n          return [RIGHT_ACT, RIGHT_ACT] # Two successive right turns (or left turns).\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The `visited` set stores a tuple `(row, col, direction, inventory_tuple)` to represent\n  # a unique state. Converting inventory (numpy array) to a tuple makes it hashable for the set.\n  visited = set()\n\n  # Add the initial state to the queue and visited set.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, [])) # (current_state, path_to_reach_this_state)\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Heuristic limit to prevent the BFS from running indefinitely in complex or unreachable scenarios.\n  # The multiplier (10) is chosen to allow exploration of states including tool acquisition.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10\n  explored_states_count = 0\n\n  # 6. BFS Loop: Continues until the queue is empty or the goal is found.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and its associated path.\n    explored_states_count += 1\n\n    # Pruning: If too many distinct states have been explored, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n\n    # Goal Check: Can the target primitive be collected from the current `state`?\n    # This involves checking if the primitive is in the 3x3 neighborhood around the agent.\n    if state.next_to(i_kind):\n        # Iterate through all four cardinal directions to check if the primitive is directly in front.\n        for target_dir in range(4):\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell directly in front is within bounds and contains the target primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and\n                state.grid[facing_r, facing_c, i_kind] == 1):\n\n                # Calculate and apply the turning actions required to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state\n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Record inventory *before* attempting the 'USE' action to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action on the temporary state.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Crucial verification: Check if the count of the target primitive in inventory\n                # actually increased. This confirms successful collection, accounting for any\n                # game rules (e.g., requiring tools) handled by `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT] # Found a path!\n\n    # Explore possible future states by performing movement actions.\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      # If this next state (position, direction, and inventory) has not been visited, add it to the queue.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n\n    # Explore the 'USE' action from the current state, even if not directly facing the target primitive.\n    # This is vital for scenarios where using an item at the current location (e.g., picking up a tool)\n    # might enable subsequent collection steps.\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n\n    # Only add the state after a general 'USE' action if it actually caused a change\n    # in inventory, position, or direction, preventing redundant explorations.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS loop completes and no path to collect the primitive was found,\n  # it means the primitive is currently unreachable given the environment and agent's capabilities.\n  return []", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T10:44:25.637286", "function_name": "collect", "function_body": "    actions_list = []\n    current_state = env._current_state\n    grid = current_state.grid # The current grid layout\n    initial_pos = current_state.pos # Agent's current (row, col) position\n    initial_dir = current_state.dir # Agent's current facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n    # Get the unique integer ID for the target primitive from the cookbook's index.\n    # This ID is used to locate the primitive in the grid and check inventory.\n    primitive_id = current_state.world.cookbook.index[primitive]\n    \n    # Get grid dimensions for boundary checks.\n    num_rows, num_cols, _ = grid.shape\n\n    # Retrieve integer codes for actions from the environment's action specifications.\n    action_map = env.action_specs()\n    MOVE_FORWARD = action_map['UP']    # 'UP' action moves the agent forward in its current direction\n    TURN_LEFT = action_map['LEFT']     # Turn 90 degrees counter-clockwise\n    TURN_RIGHT = action_map['RIGHT']   # Turn 90 degrees clockwise\n    USE = action_map['USE']            # Interact with the cell directly in front of the agent\n\n    # Map agent's direction (0,1,2,3) to row and column changes (delta_r, delta_c) when moving forward.\n    DIR_TO_DRDC = {\n        0: (0, 1),   # Facing RIGHT: (row, col + 1)\n        1: (-1, 0),  # Facing UP: (row - 1, col)\n        2: (0, -1),  # Facing LEFT: (row, col - 1)\n        3: (1, 0)    # Facing DOWN: (row + 1, col)\n    }\n\n    # Maps for calculating new direction after turning left or right.\n    TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # RIGHT -> UP -> LEFT -> DOWN -> RIGHT\n    TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # RIGHT -> DOWN -> LEFT -> UP -> RIGHT\n\n    # Get indices of entities that are non-grabbable, typically representing obstacles the agent cannot walk over.\n    non_walkable_kind_ids = current_state.world.non_grabbable_indices # This is a set for efficient lookups.\n\n    # Helper function to determine if a given grid cell (r, c) is a valid and walkable target for agent movement.\n    def is_valid_movement_target(r, c):\n        # 1. Check if the cell is within the grid boundaries.\n        if not (0 <= r < num_rows and 0 <= c < num_cols):\n            return False\n        \n        # 2. Check if the cell contains the primitive itself. The agent must be *adjacent* to the primitive\n        # to collect it using the 'USE' action, not on top of it.\n        if grid[r, c, primitive_id] > 0:\n            return False\n        \n        # 3. Check if the cell contains any non-walkable obstacles (e.g., BOUNDARY, WATER, WORKSHOP benches).\n        # Iterate through the set of non-walkable kind IDs. If any are present at (r, c), it's not walkable.\n        for kind_id in non_walkable_kind_ids:\n            if grid[r, c, kind_id] > 0:\n                return False\n                \n        return True\n\n    # Breadth-First Search (BFS) initialization:\n    # The queue stores tuples: ( (current_position_tuple (r, c), current_direction_int), list_of_actions_taken_to_reach_here )\n    # This allows us to track both position and orientation, and reconstruct the path.\n    queue = collections.deque([(((initial_pos[0], initial_pos[1]), initial_dir), [])])\n    \n    # The visited set stores (position_tuple, direction_int) pairs to prevent redundant exploration\n    # and ensure that the shortest path is found by avoiding cycles.\n    visited = {(initial_pos, initial_dir)}\n\n    target_path_to_adj = None # This will store the sequence of actions to reach the state where the primitive is in front.\n\n    # Start the BFS traversal.\n    while queue:\n        # Dequeue the current state and the path taken to reach it.\n        ((r, c), current_dir), path_actions = queue.popleft()\n\n        # 1. Check if the primitive is directly in front of the agent from the current state.\n        # This is the primary goal condition for collection: being one step away and facing the primitive.\n        dr_front, dc_front = DIR_TO_DRDC[current_dir]\n        front_r, front_c = r + dr_front, c + dc_front\n\n        # Ensure the cell directly in front is within grid boundaries.\n        if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n            # If the primitive is present in this cell, we have found the shortest path\n            # to a state where the agent is adjacent to and facing the primitive.\n            if grid[front_r, front_c, primitive_id] > 0:\n                target_path_to_adj = path_actions\n                break # Shortest path found, exit BFS.\n\n        # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n\n        # Attempt to Move Forward:\n        dr_move, dc_move = DIR_TO_DRDC[current_dir]\n        next_r, next_c = r + dr_move, c + dc_move\n        next_pos = (next_r, next_c)\n        next_dir_move = current_dir # Moving forward does not change direction.\n\n        # Check if the intended next position is valid and walkable, and if this (pos, dir) state hasn't been visited.\n        if is_valid_movement_target(next_r, next_c):\n            if (next_pos, next_dir_move) not in visited:\n                visited.add((next_pos, next_dir_move))\n                queue.append(((next_pos, next_dir_move), path_actions + [MOVE_FORWARD]))\n\n        # Attempt to Turn Left:\n        next_dir_left = TURN_LEFT_MAP[current_dir]\n        # Turning only changes direction, not position.\n        if (((r, c), next_dir_left) not in visited):\n            visited.add(((r, c), next_dir_left))\n            queue.append((((r, c), next_dir_left), path_actions + [TURN_LEFT]))\n\n        # Attempt to Turn Right:\n        next_dir_right = TURN_RIGHT_MAP[current_dir]\n        # Turning only changes direction, not position.\n        if (((r, c), next_dir_right) not in visited):\n            visited.add(((r, c), next_dir_right))\n            queue.append((((r, c), next_dir_right), path_actions + [TURN_RIGHT]))\n\n    # If a path was found to an adjacent state where the primitive is in front,\n    # append the final 'USE' action to complete the collection process.\n    if target_path_to_adj is not None:\n        actions_list.extend(target_path_to_adj)\n        actions_list.append(USE)\n\n    return actions_list", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-08-01T10:44:26.748556", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos  # Agent's initial position (row, col)\n  initial_dir = current_state.dir  # Agent's initial facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook's index.\n  # This mapping is crucial for identifying the primitive in the grid or inventory.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Determine grid dimensions for boundary checks.\n  num_rows, num_cols, _ = initial_grid.shape\n\n  # Retrieve action mapping from the environment to get integer codes for actions.\n  # This ensures compatibility with the `env.step()` method.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # In CraftWorld, 'UP' means move forward in current direction.\n  TURN_LEFT_ACTION = action_map['LEFT']     # Turn 90 degrees left.\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Turn 90 degrees right.\n  USE_ACTION = action_map['USE']            # Interact with the cell directly in front.\n\n  # Direction vectors (dr, dc) corresponding to agent's facing direction.\n  # Used to calculate the coordinates of the cell directly in front of the agent,\n  # or the new position after moving one step forward.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # Mapping for updating agent's direction when turning left or right.\n  # These define the cyclic nature of directions (e.g., RIGHT -> UP -> LEFT -> DOWN -> RIGHT).\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # Get indices of entities that are considered obstacles and cannot be walked upon.\n  # These are \"non-grabbable\" entities like boundaries, water, or workshop locations.\n  non_walkable_kind_ids = current_state.world.non_grabbable_indices\n\n  # BFS initialization:\n  # The queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_here).\n  # This allows us to reconstruct the path and keep track of the agent's orientation.\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # The visited set stores (position_tuple, direction_int) pairs to prevent redundant exploration\n  # and cycles, ensuring the shortest path is found.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_to_adjacent_state = None # This will store the sequence of actions to reach the state where the primitive is in front.\n\n  # Start the Breadth-First Search to find the shortest path.\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent from the current state.\n      # This is our primary goal condition for pathfinding: being one step away and facing the primitive.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the cell in front is within grid boundaries before checking its contents.\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n          # If the primitive is found in this cell, we have found the path to an adjacent state.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path_to_adjacent_state = path_actions\n              break # Shortest path to an adjacent state found, exit BFS.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n\n      # --- Attempt to Move Forward ---\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change direction.\n\n      # Check if the next position is within grid bounds.\n      if (0 <= next_r < num_rows and 0 <= next_c < num_cols):\n          # Check if this new (position, direction) state has already been visited.\n          if (next_pos, next_dir) not in visited:\n              # Determine if the next cell is walkable.\n              # The agent cannot move onto non-grabbable entities (obstacles).\n              is_walkable = True\n              for kind_idx in non_walkable_kind_ids:\n                  if initial_grid[next_r, next_c, kind_idx] > 0:\n                      is_walkable = False\n                      break\n              \n              # Additionally, ensure the agent doesn't try to walk *onto* the primitive itself.\n              # Collection happens from an adjacent square using the USE action, not by occupying the same cell.\n              if initial_grid[next_r, next_c, primitive_id] > 0:\n                  is_walkable = False\n\n              if is_walkable:\n                  visited.add((next_pos, next_dir))\n                  queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # --- Attempt to Turn Left ---\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # --- Attempt to Turn Right ---\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path to the target adjacent state was found (i.e., target_path_to_adjacent_state is not None),\n  # append the final 'USE' action to complete the collection.\n  if target_path_to_adjacent_state is not None:\n      actions_list.extend(target_path_to_adjacent_state)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T10:45:13.357924", "function_name": "collect", "function_body": "", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-08-01T10:45:14.500164", "function_name": "collect", "function_body": "  actions_list = []\n  \n  # Access the internal CraftState object which holds the current grid, position, and inventory.\n  current_state = env._current_state \n\n  # Extract essential information for pathfinding from the current state.\n  initial_grid = current_state.grid  # The static grid layout of the environment.\n  initial_pos = current_state.pos    # Agent's current (row, col) position on the grid.\n  initial_dir = current_state.dir    # Agent's current facing direction (0:Right, 1:Up, 2:Left, 3:Down).\n\n  # Get the integer ID for the target primitive from the cookbook index.\n  try:\n      primitive_id = current_state.world.cookbook.index[primitive]\n  except KeyError:\n      # If the primitive name is not recognized, it cannot be collected.\n      return []\n\n  # Get grid dimensions for boundary checks during pathfinding.\n  GRID_ROWS, GRID_COLS, _ = initial_grid.shape \n\n  # Map action names (from DSL) to their integer indices (used by env.step).\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Pre-defined changes in (row, col) coordinates for each direction.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: +1 to column.\n      1: (-1, 0),  # Facing UP: -1 to row.\n      2: (0, -1),  # Facing LEFT: -1 to column.\n      3: (1, 0)    # Facing DOWN: +1 to row.\n  }\n\n  # Mapping for updating agent's direction when turning left/right.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Set of entity kind IDs that represent non-walkable terrain.\n  non_walkable_kind_ids = current_state.world.non_grabbable_indices\n\n  # Helper function to determine if a cell at (r, c) is a valid and walkable location for the agent.\n  def _is_valid_and_walkable(r: int, c: int) -> bool:\n      \"\"\"\n      Checks if a cell (r, c) is within grid bounds and can be walked upon.\n      A cell is not walkable if it's out of bounds, if it contains a non-grabbable entity,\n      or if it is the target primitive itself (as agent needs to be adjacent).\n      \"\"\"\n      if not (0 <= r < GRID_ROWS and 0 <= c < GRID_COLS):\n          return False\n\n      # Check for non-grabbable obstacles (e.g., boundaries, water, workshops).\n      for kind_idx in non_walkable_kind_ids:\n          if initial_grid[r, c, kind_idx] > 0:\n              return False\n      \n      # Agent should not walk *onto* the primitive it intends to collect.\n      # It must be adjacent to it to use the 'USE' action.\n      if initial_grid[r, c, primitive_id] > 0:\n          return False\n          \n      return True\n\n  # BFS Initialization:\n  # Queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_here).\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # Visited set stores (position_tuple, direction_int) to avoid redundant exploration\n  # and ensure the shortest path is found.\n  visited = {(initial_pos, initial_dir)}\n\n  # Variable to store the shortest action sequence to reach a state where the agent\n  # is adjacent to and facing the primitive.\n  path_to_adjacent_and_facing_primitive = None \n\n  # Start BFS traversal.\n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      current_r, current_c = current_pos\n\n      # Goal Check: Is the primitive directly in front of the agent at the current state?\n      # This is the state from which the 'USE' action can be executed.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = current_r + front_dr, current_c + front_dc\n      \n      # Check if the cell in front is within grid bounds AND contains the target primitive.\n      if (0 <= front_r < GRID_ROWS and 0 <= front_c < GRID_COLS and\n          initial_grid[front_r, front_c, primitive_id] > 0):\n          path_to_adjacent_and_facing_primitive = path_so_far\n          break # Shortest path to a 'USE'-ready position found.\n\n      # Explore possible next actions from the current state: Move, Turn Left, Turn Right.\n\n      # 1. Try Move Forward (UP action in CraftLab context)\n      next_r_move, next_c_move = current_r + DIR_TO_DRDC[current_dir][0], current_c + DIR_TO_DRDC[current_dir][1]\n      next_pos_move = (next_r_move, next_c_move)\n      next_dir_move = current_dir # Direction does not change when moving forward.\n\n      # Use the extracted helper function to validate the next cell for movement.\n      if _is_valid_and_walkable(next_r_move, next_c_move):\n          if (next_pos_move, next_dir_move) not in visited:\n              visited.add((next_pos_move, next_dir_move))\n              queue.append(((next_pos_move, next_dir_move), path_so_far + [MOVE_FORWARD_ACTION]))\n\n      # 2. Try Turn Left (LEFT action)\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Position does not change when turning.\n      if (current_pos, next_dir_left) not in visited:\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_so_far + [TURN_LEFT_ACTION]))\n\n      # 3. Try Turn Right (RIGHT action)\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Position does not change when turning.\n      if (current_pos, next_dir_right) not in visited:\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_so_far + [TURN_RIGHT_ACTION]))\n\n  # After BFS completes:\n  # If a path was found to a state where the agent is adjacent and facing the primitive,\n  # append the 'USE' action to complete the collection process.\n  if path_to_adjacent_and_facing_primitive is not None:\n      actions_list.extend(path_to_adjacent_and_facing_primitive)\n      actions_list.append(USE_ACTION)\n\n  # Return the sequence of actions. This list will be empty if the primitive\n  # was not found or was unreachable.\n  return actions_list", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T10:46:04.539559", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set now includes the agent's inventory as part of the state key.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing, allowing BFS to distinguish\n  # between states that are identical in position/direction but differ in inventory (e.g., having a tool vs. not).\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Increased MAX_EXPLORED_STATES due to the larger state space when tracking inventory.\n  # This is a heuristic and may need tuning for specific environment complexities.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`).\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the USE action from the current position, even if not directly on the target primitive.\n    # This is important if using an item at the current position (e.g., picking up a tool)\n    # can change the inventory state, which might be necessary for later steps to collect the primitive.\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if the USE action resulted in a meaningful state change (inventory, position, or direction).\n    # This prevents adding redundant states to the queue if USE had no effect.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T10:46:05.787096", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # In collect_v1 (the simpler version), the 'visited' set only tracks (position, direction).\n  # It does NOT track inventory, meaning it cannot distinguish between states\n  # where an agent has picked up a tool versus not, if position/direction are the same.\n  visited = set()\n\n  # Start BFS from the current environment state.\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Reduced MAX_EXPLORED_STATES compared to v0, as the state space (pos, dir) is smaller\n  # when not tracking inventory.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 2 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() \n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`).\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      # Simplified next_state_key: only position and direction.\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # NOTE: The general exploration of the 'USE' action from any state,\n    # which checks for inventory changes (e.g., picking up a tool) and adds\n    # the new state to the queue, is omitted in this 'collect_v1' version.\n    # This feature is part of the 'collect_v0' improvement, making v0\n    # capable of finding paths that involve acquiring intermediate tools.\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 5, "scores": {"3": 1.0}}
{"timestamp": "2025-08-01T10:46:57.054587", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set now includes the agent's inventory as part of the state key.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing, allowing BFS to distinguish\n  # between states that are identical in position/direction but differ in inventory (e.g., having a tool vs. not).\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Increased MAX_EXPLORED_STATES due to the larger state space when tracking inventory.\n  # This is a heuristic and may need tuning for specific environment complexities.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    \n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    # In contrast to collect_v1, this ensures the BFS terminates immediately when the limit is hit.\n    explored_states_count += 1\n    if explored_states_count > MAX_EXPLORED_STATES:\n      return [] # Terminate BFS and report no path found within limits.\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`).\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the USE action from the current position, even if not directly on the target primitive.\n    # This is important if using an item at the current position (e.g., picking up a tool)\n    # can change the inventory state, which might be necessary for later steps to collect the primitive.\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if the USE action resulted in a meaningful state change (inventory, position, or direction).\n    # This prevents adding redundant states to the queue if USE had no effect.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T10:46:58.564982", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set now includes the agent's inventory as part of the state key.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing, allowing BFS to distinguish\n  # between states that are identical in position/direction but differ in inventory (e.g., having a tool vs. not).\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Increased MAX_EXPLORED_STATES due to the larger state space when tracking inventory.\n  # This is a heuristic and may need tuning for specific environment complexities.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`).\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the USE action from the current position, even if not directly on the target primitive.\n    # This is important if using an item at the current position (e.g., picking up a tool)\n    # can change the inventory state, which might be necessary for later steps to collect the primitive.\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if the USE action resulted in a meaningful state change (inventory, position, or direction).\n    # This prevents adding redundant states to the queue if USE had no effect.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T10:47:47.997648", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (r, c)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  action_map = env.action_specs()\n  # Map DSL movement/turn actions to their integer indices from action_specs\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  # This defines how position changes when moving \"forward\" in a given direction.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT, move in positive column direction\n      1: (-1, 0),  # Facing UP, move in negative row direction\n      2: (0, -1),  # Facing LEFT, move in negative column direction\n      3: (1, 0)    # Facing DOWN, move in positive row direction\n  }\n\n  # Map for turning left/right, updating the agent's direction (0-3)\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # R->U->L->D->R\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # R->D->L->U->R\n\n  # Identify all kinds of entities that the agent cannot walk onto.\n  # This includes general non-grabbable items (like boundaries, water, workshops)\n  # AND the primitive itself (as the agent needs to stop *adjacent* to it, not on it).\n  unwalkable_kind_ids = set(current_state.world.non_grabbable_indices)\n  unwalkable_kind_ids.add(primitive_id) \n\n  # BFS state: ((row, col), direction), path_actions\n  # Queue stores ( (current_pos_tuple, current_dir_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (current_pos_tuple, current_dir_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # Stores the action list to reach the target state\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent at current state\n      # Calculate the coordinates of the cell directly in front\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if front_cell is within grid bounds\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          # Check if the front_cell contains the primitive\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Path to target found (agent is adjacent and facing the primitive)\n\n      # 2. Explore possible next actions: Move Forward, Turn Left, Turn Right\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if next_pos is within bounds and this (position, direction) state hasn't been visited\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT and\n          (next_pos, next_dir) not in visited):\n          \n          # Determine if the next position is walkable\n          is_walkable = True\n          # A cell is walkable if it doesn't contain any of the unwalkable kinds.\n          for kind_idx in unwalkable_kind_ids:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable = False\n                  break\n\n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path was found, append the USE action to the sequence\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T10:47:49.187416", "function_name": "collect", "function_body": "  \"\"\"Returns a list of actions to find and collect the primitive in the passed env.\n    \n    This function implements a Breadth-First Search (BFS) algorithm to find the shortest\n    sequence of actions (movements and turns) required for the agent to reach a position\n    adjacent to the specified primitive and facing it, followed by a 'USE' action.\n\n    Args:\n        env (env.CraftLab): The CraftLab object representing the current environment state.\n        primitive (str): The name of the primitive resource to collect (e.g., \"WOOD\", \"STONE\").\n\n    Returns:\n        List[int]: A sequence of integer action indices to execute. Returns an empty\n                   list if the primitive is unreachable from the current state.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state\n  \n  # Extract relevant initial state information for pathfinding\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's (row, col) position\n  initial_dir = current_state.dir # Agent's facing direction (0:Right, 1:Up, 2:Left, 3:Down)\n\n  # Get the integer ID for the target primitive from the cookbook's index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Get grid dimensions (WIDTH and HEIGHT are typically defined by the environment)\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # Map human-readable action names to their integer indices from the environment's action_specs\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # In CraftWorld, 'UP' means move forward in current direction\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define how position changes based on current direction when moving \"forward\"\n  # (dr, dc) = (delta_row, delta_column)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: row stays, column increases\n      1: (-1, 0),  # Facing UP: row decreases, column stays\n      2: (0, -1),  # Facing LEFT: row stays, column decreases\n      3: (1, 0)    # Facing DOWN: row increases, column stays\n  }\n\n  # Define how direction changes when turning left (cyclical mapping)\n  TURN_LEFT_MAP = {\n      0: 1,  # Right (0) -> Up (1)\n      1: 2,  # Up (1) -> Left (2)\n      2: 3,  # Left (2) -> Down (3)\n      3: 0   # Down (3) -> Right (0)\n  }\n  \n  # Define how direction changes when turning right (cyclical mapping)\n  TURN_RIGHT_MAP = {\n      0: 3,  # Right (0) -> Down (3)\n      1: 0,  # Up (1) -> Right (0)\n      2: 1,  # Left (2) -> Up (1)\n      3: 2   # Down (3) -> Left (2)\n  }\n\n  # Identify all kinds of entities that the agent cannot walk onto.\n  # This set includes general non-grabbable items (like boundaries, water, workshops)\n  # AND the primitive itself (as the agent must be adjacent to it, not on it, for the USE action).\n  unwalkable_kind_ids = set(current_state.world.non_grabbable_indices)\n  unwalkable_kind_ids.add(primitive_id) \n\n  # BFS initialization:\n  # The queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_to_reach_here)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # The visited set stores (position_tuple, direction_int) to prevent redundant exploration and cycles\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This variable will store the sequence of actions to the goal state if found\n\n  # Start Breadth-First Search\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the current state is a goal state: agent is adjacent to and facing the primitive.\n      # Calculate the coordinates of the cell directly in front of the agent\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the calculated front cell is within grid bounds\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          # Check if the cell directly in front contains the target primitive\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Goal reached! The shortest path (in terms of actions) has been found.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right\n      \n      # Try Move Forward action\n      next_r_move, next_c_move = r + DIR_TO_DRDC[current_dir][0], c + DIR_TO_DRDC[current_dir][1]\n      next_pos_move = (next_r_move, next_c_move)\n      next_dir_move = current_dir # Moving forward does not change the agent's facing direction\n\n      # Check if the new position is within grid boundaries and if this (position, direction) state hasn't been visited\n      if (0 <= next_r_move < WIDTH and 0 <= next_c_move < HEIGHT and\n          (next_pos_move, next_dir_move) not in visited):\n          \n          # Determine if the next position is walkable (i.e., does not contain any unwalkable kinds)\n          is_walkable = True\n          for kind_idx in unwalkable_kind_ids:\n              if initial_grid[next_r_move, next_c_move, kind_idx] > 0:\n                  is_walkable = False\n                  break # Not walkable if any unwalkable item is present\n\n          if is_walkable:\n              visited.add((next_pos_move, next_dir_move))\n              queue.append(((next_pos_move, next_dir_move), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left action\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right action\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # After BFS completes: if a path to the target state was found, append the 'USE' action\n  # to the sequence to complete the collection process.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T10:48:45.302214", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`. Finds a path to an adjacent cell of the\n  primitive and then uses the primitive. Uses BFS for pathfinding to guarantee\n  the shortest sequence of actions.\n\n    Args:\n        env (env.CraftLab): The CraftLab object containing the current game state.\n        primitive (str): The name of the primitive item to collect (e.g., \"WOOD\", \"STONE\").\n\n    Returns:\n        List[int]: A sequence of action indices (integers) to execute to collect\n                   the primitive. Returns an empty list if the primitive is\n                   unreachable or not found on the initial grid.\n  \"\"\"\n  actions_list = [] # List to store the final sequence of actions\n  current_state = env._current_state # Get the current CraftState object\n  initial_grid = current_state.grid  # The grid layout at the start of collection\n  initial_pos = current_state.pos    # Agent's starting position (row, col)\n  initial_dir = current_state.dir    # Agent's starting direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook's index\n  primitive_id = current_state.world.cookbook.index.get(primitive)\n  if primitive_id is None:\n      # This indicates an invalid primitive name. Return empty list as nothing can be collected.\n      return []\n\n  # Extract grid dimensions for boundary checks\n  GRID_ROWS, GRID_COLS, _ = initial_grid.shape\n\n  # Map action names to their corresponding integer IDs from the environment's action_specs\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP'] # In CraftWorld, 'UP' action means move forward\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define changes in (row, col) for each facing direction when moving \"forward\"\n  # Direction 0: Right (positive column, no row change)\n  # Direction 1: Up (negative row, no column change)\n  # Direction 2: Left (negative column, no row change)\n  # Direction 3: Down (positive row, no column change)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (delta_row, delta_col)\n      1: (-1, 0),  # Facing UP: (delta_row, delta_col)\n      2: (0, -1),  # Facing LEFT: (delta_row, delta_col)\n      3: (1, 0)    # Facing DOWN: (delta_row, delta_col)\n  }\n\n  # Define how direction changes when turning left\n  # e.g., if currently facing RIGHT (0), turning LEFT makes agent face UP (1)\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  # Define how direction changes when turning right\n  # e.g., if currently facing RIGHT (0), turning RIGHT makes agent face DOWN (3)\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # Determine which item kinds block agent movement.\n  # This set includes entities that cannot be stepped on (e.g., boundaries, water, workshops)\n  # and importantly, the primitive itself, as the agent collects it by using while standing *adjacent* to it.\n  blocking_kind_ids_set = set(current_state.world.non_grabbable_indices)\n  blocking_kind_ids_set.add(primitive_id)\n  # Convert to a NumPy array for efficient checking against grid layers using `np.any`\n  blocking_kind_indices = np.array(list(blocking_kind_ids_set), dtype=int)\n\n  # Initialize BFS (Breadth-First Search) components:\n  # The queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_here)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # The visited set stores (position, direction) pairs to avoid redundant exploration and infinite loops\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # This variable will store the sequence of actions once the target state is found\n\n  # Start the BFS exploration\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos # Current row and column of the agent's position\n\n      # 1. Check if the primitive is immediately in front of the agent from the current state.\n      # This is our goal condition for pathfinding: the agent is adjacent and facing the primitive.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the cell directly in front is within the grid boundaries\n      if (0 <= front_r < GRID_ROWS and 0 <= front_c < GRID_COLS):\n          # Check if the target primitive is present in that cell's kind layer\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path_actions = path_actions # Found the shortest path to the \"use\" position\n              break # Exit BFS as the shortest path is guaranteed by BFS and has been found\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right\n      \n      # --- Try Move Forward ---\n      # Calculate the prospective new position if the agent moves one step forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Agent's direction does not change when moving forward\n\n      # Check if the proposed new state (position, direction) is valid for a move:\n      # a) It must be within the grid boundaries.\n      # b) This specific (position, direction) state must not have been visited before (to ensure shortest path and avoid cycles).\n      # c) The cell at `next_pos` must not be blocked by any obstacle (e.g., water, boundary, or the primitive itself).\n      if (0 <= next_r < GRID_ROWS and 0 <= next_c < GRID_COLS and\n          (next_pos, next_dir) not in visited and\n          not np.any(initial_grid[next_r, next_c, blocking_kind_indices] > 0)):\n          \n          visited.add((next_pos, next_dir)) # Mark the new state as visited\n          # Enqueue the new state along with the sequence of actions taken to reach it\n          queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # --- Try Turn Left ---\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning only changes the agent's direction, not its position\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # --- Try Turn Right ---\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning only changes the agent's direction, not its position\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # After BFS completes:\n  # If `target_path_actions` is not None, it means a path to the \"use\" position was found.\n  # We then append the final `USE_ACTION` to this path, as it's the action that collects the primitive.\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-08-01T10:48:46.538112", "function_name": "collect", "function_body": "  \"\"\"Finds a path for the agent to move to a cell adjacent to the specified primitive,\n  face it, and then use it to collect it. Uses Breadth-First Search (BFS) for pathfinding.\n\n    Args:\n        env (env.CraftLab): The CraftLab object representing the current simulation environment.\n        primitive (str): The string name of the primitive item to collect (e.g., \"WOOD\", \"STONE\").\n\n    Returns:\n        List[int]: A sequence of integer action IDs (move, turn, then use) that, when\n                   executed, should lead to the collection of the primitive.\n                   Returns an empty list if the primitive is unreachable or not found.\n  \"\"\"\n  actions_taken = []\n  current_state = env._current_state\n  \n  # Extract relevant state information\n  grid = current_state.grid\n  initial_agent_pos = current_state.pos  # (row, col) tuple\n  initial_agent_dir = current_state.dir  # int: 0=RIGHT, 1=UP, 2=LEFT, 3=DOWN\n\n  # Get the numerical ID for the target primitive from the environment's cookbook index\n  try:\n    primitive_kind_id = current_state.world.cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not valid, it cannot be collected.\n    return []\n\n  # Get grid dimensions (rows, columns)\n  GRID_ROWS, GRID_COLS, _ = grid.shape\n\n  # Map action names to their integer IDs from the environment's action_specs\n  action_ids = env.action_specs()\n  MOVE_FORWARD_ACTION = action_ids['UP']    # In CraftWorld, 'UP' is move forward relative to agent's direction\n  TURN_LEFT_ACTION = action_ids['LEFT']\n  TURN_RIGHT_ACTION = action_ids['RIGHT']\n  USE_ACTION = action_ids['USE']\n\n  # Define how agent's (row, col) position changes based on its direction when moving forward\n  # dir: 0=Right, 1=Up, 2=Left, 3=Down\n  DIRECTION_TO_DR_DC = {\n      0: (0, 1),   # Facing RIGHT: (row_change, col_change) -> (0, +1)\n      1: (-1, 0),  # Facing UP:    (-1, 0)\n      2: (0, -1),  # Facing LEFT:  (0, -1)\n      3: (1, 0)    # Facing DOWN:  (+1, 0)\n  }\n\n  # Define how agent's direction changes when turning left or right\n  TURN_LEFT_EFFECT = {0: 1, 1: 2, 2: 3, 3: 0}   # R->U->L->D->R\n  TURN_RIGHT_EFFECT = {0: 3, 1: 0, 2: 1, 3: 2}  # R->D->L->U->R\n\n  # Pre-compute a set of all entity kinds that block agent movement.\n  # This includes non-grabbable environment entities (e.g., boundaries, water, workshops)\n  # AND the primitive itself (agent collects by using next to it, not by stepping on it).\n  blocking_entity_kind_ids = set(current_state.world.non_grabbable_indices)\n  blocking_entity_kind_ids.add(primitive_kind_id)\n  blocking_indices_array = np.array(list(blocking_entity_kind_ids), dtype=int)\n\n  # BFS Queue: stores ( (current_position_tuple, current_direction_int), list_of_actions_to_reach_here )\n  # Each item in the queue represents a state (position, direction) and the path taken to reach it.\n  bfs_queue = collections.deque([((initial_agent_pos, initial_agent_dir), [])])\n  \n  # Visited set: stores (position_tuple, direction_int) to avoid re-visiting states\n  # and finding non-optimal paths (BFS naturally finds shortest path in terms of actions).\n  visited_states = {(initial_agent_pos, initial_agent_dir)}\n\n  # This will store the sequence of actions once the target state is found\n  found_path_to_target = None\n\n  while bfs_queue:\n      (current_pos, current_dir), path_actions = bfs_queue.popleft()\n      current_r, current_c = current_pos\n\n      # --- Goal Check: Is the primitive directly in front of the agent? ---\n      # Calculate the coordinates of the cell immediately in front of the agent\n      dr_front, dc_front = DIRECTION_TO_DR_DC[current_dir]\n      front_r, front_c = current_r + dr_front, current_c + dc_front\n\n      # Check if the 'front' cell is within the grid boundaries\n      if (0 <= front_r < GRID_ROWS and 0 <= front_c < GRID_COLS):\n          # If the target primitive is in the cell directly in front, we have found our path.\n          if grid[front_r, front_c, primitive_kind_id] > 0:\n              found_path_to_target = path_actions\n              break # Exit BFS loop, shortest path found.\n\n      # --- Explore Possible Next Actions (Move Forward, Turn Left, Turn Right) ---\n\n      # 1. Try Move Forward\n      move_dr, move_dc = DIRECTION_TO_DR_DC[current_dir]\n      next_pos_after_move = (current_r + move_dr, current_c + move_dc)\n      next_dir_after_move = current_dir # Direction does not change when moving\n\n      next_r_move, next_c_move = next_pos_after_move\n\n      # Check if the potential next position is valid:\n      # a) Within grid boundaries.\n      # b) The (position, direction) state has not been visited before.\n      # c) The cell at next_pos_after_move is not blocked by any impassable entity.\n      if (0 <= next_r_move < GRID_ROWS and 0 <= next_c_move < GRID_COLS and\n          (next_pos_after_move, next_dir_after_move) not in visited_states and\n          not np.any(grid[next_r_move, next_c_move, blocking_indices_array] > 0)):\n          \n          visited_states.add((next_pos_after_move, next_dir_after_move))\n          bfs_queue.append(( (next_r_move, next_c_move), next_dir_after_move, path_actions + [MOVE_FORWARD_ACTION] ))\n\n      # 2. Try Turn Left\n      next_dir_after_turn_left = TURN_LEFT_EFFECT[current_dir]\n      # Position does not change when turning.\n      if ((current_pos, next_dir_after_turn_left) not in visited_states):\n          visited_states.add((current_pos, next_dir_after_turn_left))\n          bfs_queue.append(( current_pos, next_dir_after_turn_left, path_actions + [TURN_LEFT_ACTION] ))\n\n      # 3. Try Turn Right\n      next_dir_after_turn_right = TURN_RIGHT_EFFECT[current_dir]\n      # Position does not change when turning.\n      if ((current_pos, next_dir_after_turn_right) not in visited_states):\n          visited_states.add((current_pos, next_dir_after_turn_right))\n          bfs_queue.append(( current_pos, next_dir_after_turn_right, path_actions + [TURN_RIGHT_ACTION] ))\n\n  # If a path was found to the state where the agent is adjacent and facing the primitive,\n  # append the USE action to the sequence and return the full path.\n  if found_path_to_target is not None:\n      actions_taken.extend(found_path_to_target)\n      actions_taken.append(USE_ACTION)\n\n  return actions_taken", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-08-01T10:50:05.932628", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set now includes the agent's inventory as part of the state key.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing, allowing BFS to distinguish\n  # between states that are identical in position/direction but differ in inventory (e.g., having a tool vs. not).\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # MAX_EXPLORED_STATES is a pragmatic limit to prevent extremely long searches.\n  # The multiplier '10' accounts for different relevant inventory states that might\n  # be reached (e.g., picking up a tool) during the search for the primitive.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`).\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Ensure the facing cell is within grid bounds and contains the target primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                temp_state_after_turns = state \n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                for turn_action in turns_to_face:\n                    # Reward is always 0.0, so we use `_` for the unused return value.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                # Reward is always 0.0, so we use `_` for the unused return value.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed, resource depletion) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      # Reward is always 0.0, so we use `_` for the unused return value.\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the USE action from the current position.\n    # This is important if using an item at the current position (e.g., picking up a tool)\n    # can change the inventory state, which might be necessary for later steps to collect the primitive.\n    inventory_before_any_use = np.copy(state.inventory)\n    # Reward is always 0.0, so we use `_` for the unused return value.\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if the USE action resulted in a meaningful state change (inventory, position, or direction).\n    # This prevents adding redundant states to the queue if USE had no effect.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T10:50:08.640813", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` with a more adaptive state exploration limit.\n    \n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect.\n\n    Returns:\n        List[int]: A sequence of action indices to execute.\n  \"\"\"\n  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set now includes the agent's inventory as part of the state key.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing, allowing BFS to distinguish\n  # between states that are identical in position/direction but differ in inventory (e.g., having a tool vs. not).\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  \n  # Improve MAX_EXPLORED_STATES: Make it more adaptive by including world.cookbook.n_kinds,\n  # reflecting the potential size of the inventory state space. This provides a more robust\n  # upper bound for exploration than a fixed multiplier, especially in environments with\n  # many distinct item types. The multiplier '2' is a base factor to allow some depth in exploration.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * world.cookbook.n_kinds * 2 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`).\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                temp_state_after_turns = state \n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                for turn_action in turns_to_face:\n                    # CraftState.step returns a new instance, so reassignment is appropriate.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the USE action from the current position, even if not directly on the target primitive.\n    # This is important if using an item at the current position (e.g., picking up a tool)\n    # can change the inventory state, which might be necessary for later steps to collect the primitive.\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if the USE action resulted in a meaningful state change (inventory, position, or direction).\n    # This prevents adding redundant states to the queue if USE had no effect.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 5, "scores": {"3": 1.5}}
