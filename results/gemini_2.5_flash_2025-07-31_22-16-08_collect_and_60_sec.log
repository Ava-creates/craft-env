{"timestamp": "2025-08-01T03:22:48.972455", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  ACTION_UP = action_map[\"UP\"]\n  ACTION_DOWN = action_map[\"DOWN\"]\n  ACTION_LEFT = action_map[\"LEFT\"]\n  ACTION_RIGHT = action_map[\"RIGHT\"]\n  ACTION_USE = action_map[\"USE\"]\n\n  # 1. Get current state from the environment\n  current_state = env._current_state\n  current_pos_x, current_pos_y = int(current_state.pos[0]), int(current_state.pos[1])\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  # 2. Get the integer ID for the target primitive.\n  # The Index.__getitem__ method returns int or None.\n  primitive_idx = env.world.cookbook.index[primitive.lower()]\n  if primitive_idx is None:\n    return [] # Primitive name not found in cookbook index, cannot collect.\n\n  # 3. Define what entity kinds explicitly block agent movement onto a cell.\n  # Workshops are explicitly traversable points. Water, Stone, Boundary are generally not.\n  blocked_movement_indices = set()\n  \n  # Add water and stone indices if they are part of the cookbook's kinds\n  if env.world.water_index in env.world.cookbook.kinds: \n      blocked_movement_indices.add(env.world.water_index)\n  if env.world.stone_index in env.world.cookbook.kinds: \n      blocked_movement_indices.add(env.world.stone_index)\n  \n  # Try to get boundary index; add it if it exists and is considered a blocking kind.\n  boundary_idx = env.world.cookbook.index.get(\"boundary\")\n  if boundary_idx is not None and boundary_idx in env.world.cookbook.kinds:\n      blocked_movement_indices.add(boundary_idx)\n\n  # Helper function to check if a cell is traversable by the agent\n  def is_traversable(x, y):\n    # Check bounds\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    \n    # Check if the cell contains any entity that explicitly blocks movement.\n    # If a cell contains any item from `blocked_movement_indices`, it's not traversable.\n    for blocked_id in blocked_movement_indices:\n      if grid[x, y, blocked_id] > 0: # If the blocking entity is present in this cell\n        return False\n            \n    return True\n\n  # 4. Define cardinal movement offsets and their corresponding actions\n  move_offsets = [\n      (0, -1, ACTION_UP),    # (dx, dy, action) for North (decreases y)\n      (0, 1, ACTION_DOWN),   # for South (increases y)\n      (-1, 0, ACTION_LEFT),  # for West (decreases x)\n      (1, 0, ACTION_RIGHT)   # for East (increases x)\n  ]\n\n  # 5. Find all grid locations where the primitive exists.\n  primitive_grid_locations = []\n  for x in range(grid_width):\n    for y in range(grid_height):\n      if grid[x, y, primitive_idx] > 0:\n        primitive_grid_locations.append((x, y))\n\n  if not primitive_grid_locations:\n    return [] # Primitive not found anywhere on the grid\n\n  # 6. Determine the set of target cells where the agent needs to stand\n  # to interact with or pick up the primitive.\n  target_agent_standing_locations = set()\n\n  is_grabbable_item = primitive_idx in env.world.grabbable_indices\n  is_water_or_stone = (primitive_idx == env.world.water_index or primitive_idx == env.world.stone_index)\n\n  if is_grabbable_item:\n    # For grabbable items (e.g., WOOD, IRON, GRASS, etc.), the agent needs to stand *on* the item's cell.\n    for px, py in primitive_grid_locations:\n      if is_traversable(px, py): # Ensure the cell is traversable by the agent\n        target_agent_standing_locations.add((px, py))\n  elif is_water_or_stone:\n    # For WATER or STONE, the agent needs to stand *adjacent* (cardinally) to them.\n    for px, py in primitive_grid_locations:\n      for dx, dy, _ in move_offsets: \n        nx, ny = px + dx, py + dy\n        if is_traversable(nx, ny): # Ensure the adjacent cell is traversable\n          target_agent_standing_locations.add((nx, ny))\n  else:\n    # If the primitive is neither a grabbable item nor water/stone, \n    # it's likely a non-collectible entity like a workshop or boundary.\n    # For these, the 'collect' function should return an empty list.\n    return [] \n\n  if not target_agent_standing_locations:\n    # No reachable target location found for the primitive, or it's not a collectable type.\n    return [] \n\n  # 7. Perform a Breadth-First Search (BFS) to find the shortest path\n  # from the agent's current position to any of the target standing locations.\n  q = collections.deque()\n  visited = set() # Stores (x, y) tuples of visited cells\n\n  start_pos_tuple = (current_pos_x, current_pos_y)\n  \n  # It's crucial that the agent's starting position is traversable; otherwise, no path can be found.\n  if not is_traversable(current_pos_x, current_pos_y):\n      return [] \n\n  q.append((start_pos_tuple, [])) # Queue stores ((x, y), [actions_to_reach_here])\n  visited.add(start_pos_tuple)\n\n  shortest_path_actions = []\n  found_path = False\n\n  while q:\n    (x, y), actions_so_far = q.popleft()\n\n    # If the current cell is one of our target standing locations, we found a path\n    if (x, y) in target_agent_standing_locations:\n      found_path = True\n      shortest_path_actions = actions_so_far\n      break # Found the shortest path, no need to continue BFS\n\n    # Explore valid neighbors\n    for dx, dy, action_move in move_offsets:\n      nx, ny = x + dx, y + dy\n\n      # Check if neighbor is within bounds, not visited, and traversable\n      if (nx, ny) not in visited and is_traversable(nx, ny):\n        visited.add((nx, ny))\n        q.append(((nx, ny), actions_so_far + [action_move]))\n\n  final_actions = []\n  if found_path:\n    final_actions.extend(shortest_path_actions)\n    # After reaching the target cell, add the USE action to interact with/collect the primitive.\n    final_actions.append(ACTION_USE)\n\n  return final_actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-08-01T03:24:15.563624", "function_name": "collect", "function_body": "  actions = []\n\n  # 1. Get Action Mappings and Primitive Index\n  action_map = env.action_specs()\n  UP, DOWN, LEFT, RIGHT, USE = action_map['UP'], action_map['DOWN'], action_map['LEFT'], action_map['RIGHT'], action_map['USE']\n\n  # Use try-except for robustness if primitive name is not found in the index.\n  try:\n      primitive_idx = env.world.cookbook.index[primitive]\n  except KeyError:\n      # If the primitive name is unknown, it cannot be collected.\n      # Return an empty list, indicating no actions can be taken.\n      return []\n\n  # --- Improvement for v2: Check if primitive is already in inventory ---\n  current_state = env._current_state\n  if current_state.inventory[primitive_idx] > 0:\n      # If the agent already has at least one of the primitive, no collection actions are needed.\n      return []\n  # ------------------------------------------------------------------\n\n  start_pos = current_state.pos\n  start_dir = current_state.dir # Initial direction of the agent (0:S, 1:N, 2:W, 3:E)\n  global_grid = current_state.grid\n  W, H, _ = global_grid.shape # Grid dimensions\n\n  # Determine if the primitive is grabbable (can be walked onto and picked up)\n  # or non-grabbable (requires being adjacent and using the 'USE' action).\n  primitive_is_grabbable = primitive_idx in env.world.grabbable_indices\n\n  # Map DMLab action values to (dr, dc) movement deltas AND CraftState.dir values.\n  # The agent's direction updates to match the last movement action.\n  action_to_move_and_dir = {\n      UP: ((-1, 0), 1),    # Move UP (North), new direction is North (1)\n      DOWN: ((1, 0), 0),   # Move DOWN (South), new direction is South (0)\n      LEFT: ((0, -1), 2),  # Move LEFT (West), new direction is West (2)\n      RIGHT: ((0, 1), 3)   # Move RIGHT (East), new direction is East (3)\n  }\n\n  # Map CraftState.dir values to (dr, dc) deltas for the cell \"in front\" of the agent.\n  # This is crucial for determining where the 'USE' action will apply.\n  dir_to_fwd_delta = {\n      0: (1, 0),  # Facing South, cell in front is (row+1, col)\n      1: (-1, 0), # Facing North, cell in front is (row-1, col)\n      2: (0, -1), # Facing West, cell in front is (row, col-1)\n      3: (0, 1)   # Facing East, cell in front is (row, col+1)\n  }\n\n  # Obstacle indices: cells that cannot be stepped onto (e.g., Water, Stone, Workshops).\n  # The `CraftState.step` method prevents movement into any cell containing a non-grabbable item.\n  obstacle_indices = env.world.non_grabbable_indices\n\n  def is_valid_move(r, c):\n      \"\"\"Checks if (r, c) is within grid bounds and doesn't contain any non-grabbable obstacles.\"\"\"\n      if not (0 <= r < W and 0 <= c < H):\n          return False\n      # A cell is an obstacle if it contains *any* non-grabbable item.\n      # The agent *can* walk onto grabbable items (e.g., WOOD, IRON), but not non-grabbable ones.\n      if any(global_grid[r, c, obs_idx] == 1 for obs_idx in obstacle_indices):\n          return False\n      return True\n  \n  # BFS Queue: Stores tuples of ( (current_position (r,c), current_direction (int)), path_so_far (list of actions) )\n  queue = collections.deque([((start_pos, start_dir), [])])\n  \n  # Visited set: Stores (position (r,c), direction (int)) tuples to avoid redundant exploration.\n  # A state is defined by both position and direction because the 'USE' action depends on direction.\n  visited = {(start_pos, start_dir)}\n\n  path_to_target = None # This will store the sequence of actions to reach the target state.\n  \n  while queue:\n      (pos, current_dir_val), path_so_far = queue.popleft()\n      r, c = pos\n\n      # Check if the current state (position and direction) satisfies the collection goal.\n      if primitive_is_grabbable:\n          # For grabbable items (e.g., WOOD, IRON), the agent needs to be on the same cell\n          # as the primitive to collect it.\n          if global_grid[r, c, primitive_idx] == 1:\n              path_to_target = path_so_far\n              break # Found the shortest path to a cell containing the grabbable item.\n      else:\n          # For non-grabbable items (e.g., STONE, WATER, WORKSHOP), the agent must be\n          # adjacent to the primitive AND facing it to use the 'USE' action.\n          fwd_dr, fwd_dc = dir_to_fwd_delta[current_dir_val]\n          target_r, target_c = r + fwd_dr, c + fwd_dc\n\n          # Check if the cell directly in front contains the primitive.\n          if 0 <= target_r < W and 0 <= target_c < H and global_grid[target_r, target_c, primitive_idx] == 1:\n              path_to_target = path_so_far\n              break # Found the shortest path ending in the correct position and direction to use the primitive.\n\n      # Explore neighbors by applying movement actions.\n      for action_val, (move_delta, new_dir_val) in action_to_move_and_dir.items():\n          dr, dc = move_delta\n          next_r, next_c = r + dr, c + dc\n          next_pos = (next_r, next_c)\n          next_state_node = (next_pos, new_dir_val) # The (position, direction) tuple for the next state\n\n          # Only proceed if the next position is valid (within bounds and not an obstacle)\n          # and this (position, direction) state has not been visited before.\n          if is_valid_move(next_r, next_c) and next_state_node not in visited:\n              visited.add(next_state_node)\n              queue.append((next_state_node, path_so_far + [action_val]))\n  \n  if path_to_target:\n      # If a path was found, append the USE action at the end to perform the collection.\n      actions = path_to_target + [USE]\n  \n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T03:24:16.754157", "function_name": "collect", "function_body": "", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-08-01T03:25:25.353093", "function_name": "collect", "function_body": "  current_state = env._current_state\n  # Get the integer index for the primitive from the cookbook\n  primitive_idx = env.world.cookbook.index.index(primitive)\n  \n  # Get action mappings from the environment's action_specs for clarity\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # 1. If the agent is already next to the primitive, simply use it.\n  # This leverages the CraftState's built-in `next_to` check, which is efficient.\n  if current_state.next_to(primitive_idx):\n    return [USE]\n\n  # 2. Find all grid locations where the primitive exists.\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  # List to store (x, y) coordinates of primitive occurrences\n  primitive_locations_on_grid = [] \n  # Iterate through the grid to find where the primitive is located\n  for x in range(grid_width):\n    for y in range(grid_height):\n      # If the primitive_idx layer at (x, y) has a value > 0, it means the primitive is there\n      if grid[x, y, primitive_idx] > 0:\n        primitive_locations_on_grid.append((x, y))\n\n  # If the primitive isn't anywhere on the map, we can't collect it.\n  if not primitive_locations_on_grid:\n    return []\n\n  # 3. Determine all \"goal cells\" for the BFS. \n  # A goal cell is any cell adjacent to (or on top of) the primitive, \n  # from which the agent can use the 'USE' action.\n  # For CraftWorld, 'USE' acts on the 3x3 neighborhood. So, any cell (gx,gy)\n  # such that a primitive location (px,py) is in its 3x3 neighborhood.\n  goal_cells = set()\n  for px, py in primitive_locations_on_grid:\n    # Iterate through the 3x3 neighborhood around each primitive location\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        gx, gy = px + dx, py + dy\n        # Ensure the potential goal cell is within grid bounds\n        if 0 <= gx < grid_width and 0 <= gy < grid_height:\n          goal_cells.add((gx, gy))\n\n  # 4. Perform Breadth-First Search (BFS) to find the shortest path.\n  start_pos = current_state.pos\n  \n  # BFS queue: stores (current_position, path_taken_actions_to_reach_current_position)\n  q = collections.deque([(start_pos, [])]) \n  # Set to keep track of visited positions to avoid redundant exploration and cycles\n  visited = {start_pos} \n\n  # Define possible movement deltas and their corresponding action indices\n  # (dx, dy) -> action\n  MOVE_DELTAS_AND_ACTIONS = [\n      ((0, -1), UP),    # Move North (Up on screen Y-)\n      ((0, 1), DOWN),   # Move South (Down on screen Y+)\n      ((-1, 0), LEFT),  # Move West (Left on screen X-)\n      ((1, 0), RIGHT),  # Move East (Right on screen X+)\n  ]\n\n  # Identify impassable kinds. Based on the CraftState.step description,\n  # \"movement into occupied cells is blocked unless the occupying entity is a workshop, water, or the agent can pick it up\".\n  # This implies that non-grabbable entities that are NOT workshops and NOT water are impassable.\n  impassable_kinds = set()\n  for idx in env.world.non_grabbable_indices:\n      # If the entity is non-grabbable but IS a workshop or IS water, it's traversable.\n      # So, we add it to impassable_kinds only if it's NOT a workshop AND NOT water.\n      if idx not in env.world.workshop_indices and idx != env.world.water_index:\n          impassable_kinds.add(idx)\n\n  while q:\n    (cx, cy), path = q.popleft() # Dequeue the current position and its path\n\n    # If the current position is one of our target goal cells, we've found the shortest path\n    if (cx, cy) in goal_cells:\n      # The path found leads to the cell from which 'USE' can be applied.\n      return path + [USE]\n\n    # Explore valid neighbors\n    for (dx, dy), action in MOVE_DELTAS_AND_ACTIONS:\n      nx, ny = cx + dx, cy + dy # Calculate new potential position\n      new_pos = (nx, ny)\n\n      # Check if the new position is within grid boundaries\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue\n\n      # Check if the new position is impassable.\n      # A cell is impassable if any of the 'impassable_kinds' are present there.\n      is_impassable = False\n      for k_idx in impassable_kinds:\n          # Check if this specific impassable kind exists at (nx,ny) with a count > 0\n          if grid[nx, ny, k_idx] > 0: \n              is_impassable = True\n              break\n      \n      if is_impassable:\n          continue # Cannot move to this cell, skip it\n\n      # If the new position has not been visited yet, add it to the queue\n      if new_pos not in visited:\n        visited.add(new_pos)\n        q.append((new_pos, path + [action]))\n\n  # If the BFS queue becomes empty and no path to a goal cell was found,\n  # it means the primitive is unreachable from the current state.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T03:25:26.510273", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` using NumPy optimizations and cleaner set operations.\"\"\"\n  current_state = env._current_state\n  # Get the integer index for the primitive from the cookbook\n  primitive_idx = env.world.cookbook.index.index(primitive)\n  \n  # Get action mappings from the environment's action_specs for clarity\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # 1. If the agent is already next to the primitive, simply use it.\n  # This leverages the CraftState's built-in `next_to` check, which is efficient.\n  if current_state.next_to(primitive_idx):\n    return [USE]\n\n  # 2. Find all grid locations where the primitive exists.\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  # Use numpy.argwhere to efficiently find all (x, y) coordinates\n  # where the primitive_idx layer has a value greater than 0.\n  # np.argwhere returns an array of shape (N, 2), convert to list of tuples.\n  primitive_locations_on_grid = [\n      tuple(loc) for loc in np.argwhere(grid[:, :, primitive_idx] > 0)\n  ]\n\n  # If the primitive isn't anywhere on the map, we can't collect it.\n  if not primitive_locations_on_grid:\n    return []\n\n  # 3. Determine all \"goal cells\" for the BFS. \n  # A goal cell is any cell in the 3x3 neighborhood around a primitive location.\n  # The 'USE' action operates on this 3x3 area.\n  goal_cells = set()\n  for px, py in primitive_locations_on_grid:\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        gx, gy = px + dx, py + dy\n        # Ensure the potential goal cell is within grid boundaries\n        if 0 <= gx < grid_width and 0 <= gy < grid_height:\n          goal_cells.add((gx, gy))\n\n  # 4. Perform Breadth-First Search (BFS) to find the shortest path.\n  start_pos = current_state.pos\n  \n  # BFS queue: stores (current_position, path_taken_actions_to_reach_current_position)\n  q = collections.deque([(start_pos, [])]) \n  # Set to keep track of visited positions to avoid redundant exploration and cycles\n  visited = {start_pos} \n\n  # Define possible movement deltas and their corresponding action indices\n  # (dx, dy) -> action\n  MOVE_DELTAS_AND_ACTIONS = [\n      ((0, -1), UP),    # Move North (Up on screen Y-)\n      ((0, 1), DOWN),   # Move South (Down on screen Y+)\n      ((-1, 0), LEFT),  # Move West (Left on screen X-)\n      ((1, 0), RIGHT),  # Move East (Right on screen X+)\n  ]\n\n  # Identify truly impassable kinds using set difference for clarity.\n  # These are non-grabbable items that are not workshops (which are usually traversable).\n  impassable_kinds = set(env.world.non_grabbable_indices) - set(env.world.workshop_indices)\n\n  while q:\n    (cx, cy), path = q.popleft() # Dequeue the current position and its path\n\n    # If the current position is one of our target goal cells, we've found the shortest path\n    if (cx, cy) in goal_cells:\n      # The path found leads to the cell from which 'USE' can be applied.\n      return path + [USE]\n\n    # Explore valid neighbors\n    for (dx, dy), action in MOVE_DELTAS_AND_ACTIONS:\n      nx, ny = cx + dx, cy + dy # Calculate new potential position\n      new_pos = (nx, ny)\n\n      # Check if the new position is within grid boundaries\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue\n\n      # Check if the new position is impassable.\n      # A cell is impassable if any of the 'impassable_kinds' are present there.\n      is_impassable = False\n      for k_idx in impassable_kinds:\n          # Check if this specific impassable kind exists at (nx,ny) with a count > 0\n          if grid[nx, ny, k_idx] > 0: \n              is_impassable = True\n              break\n      \n      if is_impassable:\n          continue # Cannot move to this cell, skip it\n\n      # If the new position has not been visited yet, add it to the queue\n      if new_pos not in visited:\n        visited.add(new_pos)\n        q.append((new_pos, path + [action]))\n\n  # If the BFS queue becomes empty and no path to a goal cell was found,\n  # it means the primitive is unreachable from the current state.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T03:27:03.791717", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n  This version assumes that a primitive can be collected by moving to a cell that is\n  either on the primitive's location or adjacent to it, and then performing the USE action.\n  It uses Breadth-First Search (BFS) to find the shortest path to such a \"collectable\" position.\n  \"\"\"\n  action_map = env.action_specs()\n  ACTION_UP = action_map[\"UP\"]\n  ACTION_DOWN = action_map[\"DOWN\"]\n  ACTION_LEFT = action_map[\"LEFT\"]\n  ACTION_RIGHT = action_map[\"RIGHT\"]\n  ACTION_USE = action_map[\"USE\"]\n\n  # Convert the primitive name to its integer ID.\n  primitive_id = env.world.cookbook.index[primitive.lower()]\n  if primitive_id is None:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # Crucial check: Ensure the primitive is actually a \"grabbable\" item.\n  # The 'collect' function is intended for items that can be picked up.\n  if primitive_id not in env.world.grabbable_indices:\n    # This primitive cannot be collected by simply moving to it and using 'USE'.\n    return []\n\n  # Retrieve the current state of the environment.\n  current_state = env._current_state\n  agent_pos = current_state.pos\n  current_grid = current_state.grid\n  grid_width, grid_height, _ = current_grid.shape\n\n  # Identify kinds of entities that act as obstacles (cannot be traversed).\n  obstacle_kind_ids = env.world.non_grabbable_indices\n\n  # Define possible movements and their corresponding actions.\n  move_actions = [\n      (0, -1, ACTION_UP),    # North\n      (0, 1, ACTION_DOWN),   # South\n      (-1, 0, ACTION_LEFT),  # West\n      (1, 0, ACTION_RIGHT)   # East\n  ]\n\n  # Find all locations on the grid where the primitive exists.\n  # This set helps determine if a primitive is present anywhere for collection.\n  primitive_locations_on_grid = set()\n  for x in range(grid_width):\n    for y in range(grid_height):\n      if current_grid[x, y, primitive_id] > 0:\n        primitive_locations_on_grid.add((x, y))\n  \n  if not primitive_locations_on_grid:\n    # No primitive of this kind found on the grid, so it cannot be collected.\n    return []\n\n  # Initialize Breadth-First Search (BFS) for pathfinding.\n  queue = collections.deque([(agent_pos, [])])\n  visited_positions = {agent_pos}\n\n  while queue:\n    current_pos, path_to_here = queue.popleft()\n    cx, cy = current_pos\n\n    # Check if the current position is a \"collectable\" position.\n    # A position is collectable if the primitive_id is present in the 3x3 neighborhood\n    # around the current position (including the current position itself).\n    # This is effectively what CraftState.next_to(primitive_id) checks.\n    is_collectable_position = False\n    for dx_n in [-1, 0, 1]:\n      for dy_n in [-1, 0, 1]:\n        nx, ny = cx + dx_n, cy + dy_n\n        # Check bounds for the neighbor cell\n        if 0 <= nx < grid_width and 0 <= ny < grid_height:\n          # Check if this neighbor cell contains the primitive.\n          if current_grid[nx, ny, primitive_id] > 0:\n            is_collectable_position = True\n            break\n      if is_collectable_position:\n        break\n\n    if is_collectable_position:\n      # If we reached a position from which the primitive can be collected,\n      # add the 'USE' action and return the complete path.\n      return path_to_here + [ACTION_USE]\n\n    # Explore all adjacent cells (neighbors).\n    for dx, dy, action_for_move in move_actions:\n      next_x, next_y = cx + dx, cy + dy\n      next_pos = (next_x, next_y)\n\n      # 1. Boundary check: Ensure the neighbor is within the grid.\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      # 2. Visited check: Skip if this cell has already been processed.\n      if next_pos in visited_positions:\n        continue\n\n      # 3. Obstacle check: Determine if the neighbor cell is blocked by non-grabbable items.\n      is_blocked = False\n      for obstacle_id in obstacle_kind_ids:\n        if current_grid[next_x, next_y, obstacle_id] > 0:\n          is_blocked = True\n          break # Found an obstacle, this cell is blocked\n      \n      if is_blocked:\n        continue # Cannot move to a blocked cell.\n\n      # If the neighbor is valid (within bounds, unvisited, and traversable),\n      # add it to the BFS queue and mark it as visited.\n      visited_positions.add(next_pos)\n      queue.append((next_pos, path_to_here + [action_for_move]))\n\n  # If the queue becomes empty and the primitive was not found/reached,\n  # it means the primitive is unreachable from the current agent's position.\n  return []", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T03:27:05.068333", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  ACTION_UP = action_map[\"UP\"]\n  ACTION_DOWN = action_map[\"DOWN\"]\n  ACTION_LEFT = action_map[\"LEFT\"]\n  ACTION_RIGHT = action_map[\"RIGHT\"]\n  ACTION_USE = action_map[\"USE\"]\n\n  primitive_id = env.world.cookbook.index[primitive.lower()]\n  if primitive_id is None:\n    return []\n\n  # Check if agent already has the primitive. If so, no need to collect more.\n  current_state = env._current_state\n  if current_state.inventory[primitive_id] > 0:\n      return []\n\n  if primitive_id not in env.world.grabbable_indices:\n    return []\n\n  agent_pos = current_state.pos\n  current_grid = current_state.grid\n  grid_width, grid_height, _ = current_grid.shape\n\n  obstacle_kind_ids = env.world.non_grabbable_indices\n\n  # Pre-calculate blocked cells for efficiency in BFS.\n  # A cell is blocked if it contains any of the identified obstacle kinds.\n  blocked_cells = np.zeros((grid_width, grid_height), dtype=bool)\n  for x in range(grid_width):\n    for y in range(grid_height):\n      for obstacle_id in obstacle_kind_ids:\n        if current_grid[x, y, obstacle_id] > 0:\n          blocked_cells[x, y] = True\n          break\n\n  move_actions = [\n      (0, -1, ACTION_UP),\n      (0, 1, ACTION_DOWN),\n      (-1, 0, ACTION_LEFT),\n      (1, 0, ACTION_RIGHT)\n  ]\n\n  queue = collections.deque([(agent_pos, [])])\n  visited_positions = {agent_pos}\n\n  while queue:\n    current_pos, path_to_here = queue.popleft()\n    cx, cy = current_pos\n\n    # If the primitive is found at the current position, the path is complete.\n    # Assuming 'USE' when standing on a grabbable item picks it up.\n    if current_grid[cx, cy, primitive_id] > 0:\n      return path_to_here + [ACTION_USE]\n\n    for dx, dy, action_for_move in move_actions:\n      next_x, next_y = cx + dx, cy + dy\n      next_pos = (next_x, next_y)\n\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      if next_pos in visited_positions:\n        continue\n      \n      # Use the pre-calculated blocked_cells array\n      if blocked_cells[next_x, next_y]:\n        continue\n\n      visited_positions.add(next_pos)\n      queue.append((next_pos, path_to_here + [action_for_move]))\n\n  return []", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T03:28:23.572224", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  try:\n    primitive_idx = env.world.cookbook.index[primitive]\n  except KeyError:\n    # Primitive name not recognized, cannot collect.\n    return []\n\n  current_state = env._current_state\n  start_pos = current_state.pos  # Agent's starting (row, col) position\n  start_dir = current_state.dir  # Agent's starting direction\n  global_grid = current_state.grid # The full grid representation of the world\n  GRID_WIDTH, GRID_HEIGHT, _ = global_grid.shape # Dimensions of the grid\n\n  # Categorize the primitive based on how it's \"collected\"\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  \n  # Type 1: Requires agent to be ON the cell containing the primitive.\n  # This applies to grabbable items (picked up by walking over) and workshops (interacted by standing on).\n  target_requires_on_cell = is_grabbable or is_workshop\n  \n  # Type 2: Requires agent to be ADJACENT to and FACING the primitive, then use ACTION_USE.\n  # This applies to non-grabbable environment features like stone or water, if they are meant\n  # to be 'collected' by the DSL 'collect' function.\n  target_requires_adjacent_use = (\n      primitive_idx in env.world.non_grabbable_indices and # Is a non-grabbable item\n      not is_workshop # But not a workshop (workshops are 'on-cell' type)\n  )\n\n  # Define how movement actions change the agent's position and direction.\n  # CraftState.dir values: 0=South, 1=North, 2=West, 3=East.\n  # Format: action_value: ((row_delta, col_delta), new_direction_value)\n  MOVE_ACTIONS_DATA = {\n      ACTION_UP: ((-1, 0), 1),    # Move UP (row-1), new direction is North (1)\n      ACTION_DOWN: ((1, 0), 0),   # Move DOWN (row+1), new direction is South (0)\n      ACTION_LEFT: ((0, -1), 2),  # Move LEFT (col-1), new direction is West (2)\n      ACTION_RIGHT: ((0, 1), 3)   # Move RIGHT (col+1), new direction is East (3)\n  }\n\n  # Define how agent's direction maps to the coordinates of the cell directly in front.\n  DIRECTION_TO_FORWARD_DELTA = {\n      0: (1, 0),  # Facing South: cell (row+1, col) is in front\n      1: (-1, 0), # Facing North: cell (row-1, col) is in front\n      2: (0, -1), # Facing West: cell (row, col-1) is in front\n      3: (0, 1)   # Facing East: cell (row, col+1) is in front\n  }\n\n  def is_within_bounds(r: int, c: int) -> bool:\n      \"\"\"Checks if a given grid cell (r, c) is within the environment boundaries.\"\"\"\n      return 0 <= r < GRID_WIDTH and 0 <= c < GRID_HEIGHT\n\n  # Precompute indices of fixed obstacles (non-grabbable and not workshops) for efficiency.\n  # These are entities that the agent cannot walk *onto*.\n  _fixed_obstacle_indices = env.world.non_grabbable_indices.difference(env.world.workshop_indices)\n\n  def is_walkable(r: int, c: int) -> bool:\n      \"\"\"\n      Checks if a given grid cell (r, c) is a valid and traversable location for the agent.\n      A cell is walkable if it's within bounds and does not contain any fixed obstacles\n      or the target primitive itself if that primitive requires adjacent-and-use collection.\n      \"\"\"\n      if not is_within_bounds(r, c):\n          return False\n      \n      # Special case: If the target primitive requires 'adjacent-and-use' collection (e.g., STONE, WATER),\n      # the agent cannot walk *onto* the cell containing that primitive itself.\n      if target_requires_adjacent_use and global_grid[r, c, primitive_idx] > 0:\n          return False\n      \n      # Check if the cell contains any other fixed obstacle (e.g., BOUNDARY, WATER, STONE if not target).\n      for k_idx in _fixed_obstacle_indices:\n          if global_grid[r, c, k_idx] > 0:\n              return False # This cell contains an impassable obstacle.\n              \n      return True\n\n  # --- Breadth-First Search (BFS) for pathfinding ---\n  # Queue stores tuples: ( (current_position (r,c), current_direction), path_so_far (list of actions) )\n  # BFS explores states defined by both position AND direction, which is crucial for the 'USE' action.\n  queue = collections.deque([((start_pos, start_dir), [])])\n  \n  # Visited set: Stores ((r,c), dir) tuples to avoid revisiting states and infinite loops.\n  visited = {(start_pos, start_dir)}\n\n  shortest_path = None # This will store the sequence of actions to reach the target state.\n  \n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the current state satisfies the collection goal.\n      if target_requires_on_cell:\n          # Goal: Agent is on the cell containing the primitive (grabbable item or workshop).\n          if global_grid[r, c, primitive_idx] > 0:\n              shortest_path = path_so_far\n              break # Found the shortest path to be on the target cell.\n      elif target_requires_adjacent_use:\n          # Goal: Agent is adjacent to and facing the primitive.\n          fwd_dr, fwd_dc = DIRECTION_TO_FORWARD_DELTA[current_dir]\n          target_r, target_c = r + fwd_dr, c + fwd_dc\n          \n          if (is_within_bounds(target_r, target_c) and\n              global_grid[target_r, target_c, primitive_idx] > 0):\n              shortest_path = path_so_far\n              break # Found the shortest path to be in position and orientation to 'USE' the primitive.\n\n      # 2. Explore valid neighboring states (movement actions).\n      # Iterate over (action_value, (move_delta, new_direction_value)) pairs\n      for action_val, (move_delta, new_dir_val) in MOVE_ACTIONS_DATA.items():\n          move_dr, move_dc = move_delta # Unpack the (dr, dc) tuple from move_delta\n          next_r, next_c = r + move_dr, c + move_dc\n          next_pos = (next_r, next_c)\n          next_state_tuple = (next_pos, new_dir_val)\n\n          # Only add to queue if the next position is walkable and this specific (pos, dir) state\n          # has not been visited yet.\n          if is_walkable(next_r, next_c) and next_state_tuple not in visited:\n              visited.add(next_state_tuple)\n              queue.append((next_state_tuple, path_so_far + [action_val]))\n  \n  final_actions = []\n  if shortest_path is not None:\n      final_actions = shortest_path\n      # If the primitive requires \"adjacent-and-use\" collection, append the USE action.\n      if target_requires_adjacent_use:\n          final_actions.append(ACTION_USE)\n  \n  return final_actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T03:28:24.973654", "function_name": "collect", "function_body": "  # 1. Get action mappings from the environment's action_specs\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # 2. Get the integer index for the primitive from the cookbook.\n  # If the primitive name is not recognized, return an empty list of actions.\n  try:\n    primitive_idx = env.world.cookbook.index[primitive]\n  except KeyError:\n    return []\n\n  # 3. Get the current state information from the environment.\n  current_state = env._current_state\n  start_pos = current_state.pos  # Agent's starting (row, col) position\n  start_dir = current_state.dir  # Agent's starting direction\n  global_grid = current_state.grid # The full grid representation of the world\n  GRID_WIDTH, GRID_HEIGHT, _ = global_grid.shape # Dimensions of the grid\n\n  # 4. Categorize the primitive based on how it's \"collected\" in the environment.\n  # This determines the target condition for the BFS.\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  \n  # Type 1: Requires agent to be ON the cell containing the primitive.\n  # This applies to grabbable items (picked up by walking over) and workshops (if 'collect' means reaching them).\n  target_requires_on_cell = is_grabbable or is_workshop\n  \n  # Type 2: Requires agent to be ADJACENT to and FACING the primitive, then use ACTION_USE.\n  # This applies to non-grabbable environment features like \"STONE\" or \"WATER\" sources.\n  target_requires_adjacent_use = (\n      primitive_idx in env.world.non_grabbable_indices and # It's a non-grabbable item\n      not is_workshop # ... and it's not a workshop (workshops are typically 'on-cell' for 'collect')\n  )\n\n  # 5. Define movement actions and their effects on agent's position and direction.\n  # CraftState.dir mapping: 0=South, 1=North, 2=West, 3=East.\n  # Each entry is (action_value, (row_delta, col_delta), new_direction_value).\n  # The new_direction_value reflects the direction the agent faces after the move.\n  MOVE_ACTIONS_DATA = {\n      ACTION_UP: ((-1, 0), 1),    # Move UP (row-1), new direction is North (1)\n      ACTION_DOWN: ((1, 0), 0),   # Move DOWN (row+1), new direction is South (0)\n      ACTION_LEFT: ((0, -1), 2),  # Move LEFT (col-1), new direction is West (2)\n      ACTION_RIGHT: ((0, 1), 3)   # Move RIGHT (col+1), new direction is East (3)\n  }\n\n  # 6. Define how agent's direction maps to the coordinates of the cell directly in front.\n  DIRECTION_TO_FORWARD_DELTA = {\n      0: (1, 0),  # Facing South: cell (row+1, col) is in front\n      1: (-1, 0), # Facing North: cell (row-1, col) is in front\n      2: (0, -1), # Facing West: cell (row, col-1) is in front\n      3: (0, 1)   # Facing East: cell (row, col+1) is in front\n  }\n\n  # Helper function to check if a grid cell is within the environment boundaries.\n  def is_within_bounds(r: int, c: int) -> bool:\n      return 0 <= r < GRID_WIDTH and 0 <= c < GRID_HEIGHT\n\n  # Helper function to check if a grid cell is traversable by the agent.\n  def is_walkable(r: int, c: int) -> bool:\n      if not is_within_bounds(r, c):\n          return False\n      \n      # Iterate through all possible kind indices at the cell (r,c) to check its contents.\n      for k_idx in range(global_grid.shape[2]):\n          if global_grid[r, c, k_idx] > 0: # If something of kind k_idx is present at (r,c)\n              # If the cell contains any non-grabbable item that is NOT a workshop,\n              # it is considered an obstacle and cannot be walked upon.\n              if k_idx in env.world.non_grabbable_indices and k_idx not in env.world.workshop_indices:\n                  return False # This cell contains a fixed obstacle (e.g., BOUNDARY, STONE, WATER)\n              \n              # If the current cell contains the *target primitive* itself,\n              # AND that primitive requires *adjacent-and-use* collection (e.g., STONE, WATER),\n              # then the agent must NOT walk onto this cell. Instead, it must stand adjacent.\n              if k_idx == primitive_idx and target_requires_adjacent_use:\n                  return False\n      return True\n\n  # 7. --- Breadth-First Search (BFS) for pathfinding ---\n  # The BFS state must include both position and direction because the 'USE' action\n  # is direction-dependent.\n  # Queue stores tuples: ( (current_position (r,c), current_direction), path_so_far (list of actions) )\n  queue = collections.deque([((start_pos, start_dir), [])])\n  \n  # Visited set: Stores ((r,c), dir) tuples to avoid revisiting states and infinite loops.\n  visited = {(start_pos, start_dir)}\n\n  shortest_path = None # This will store the sequence of actions to reach the target state.\n  \n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      r, c = current_pos\n\n      # Check if the current state satisfies the collection goal.\n      if target_requires_on_cell:\n          # Goal: Agent is on the cell containing the primitive (e.g., a grabbable item or a workshop location).\n          if global_grid[r, c, primitive_idx] > 0:\n              shortest_path = path_so_far\n              break # Found the shortest path to be on the target cell.\n      elif target_requires_adjacent_use:\n          # Goal: Agent is adjacent to and facing the primitive.\n          fwd_dr, fwd_dc = DIRECTION_TO_FORWARD_DELTA[current_dir]\n          target_r, target_c = r + fwd_dr, c + fwd_dc\n          \n          # Check if the cell directly in front contains the primitive and is within bounds.\n          if (is_within_bounds(target_r, target_c) and\n              global_grid[target_r, target_c, primitive_idx] > 0):\n              shortest_path = path_so_far\n              break # Found the shortest path to be in position and orientation to 'USE' the primitive.\n\n      # Explore valid neighboring states by trying all possible movement actions (UP, DOWN, LEFT, RIGHT).\n      for action_val, (move_dr, move_dc), new_dir_val in [\n          (ACTION_UP, MOVE_ACTIONS_DATA[ACTION_UP][0], MOVE_ACTIONS_DATA[ACTION_UP][1]),\n          (ACTION_DOWN, MOVE_ACTIONS_DATA[ACTION_DOWN][0], MOVE_ACTIONS_DATA[ACTION_DOWN][1]),\n          (ACTION_LEFT, MOVE_ACTIONS_DATA[ACTION_LEFT][0], MOVE_ACTIONS_DATA[ACTION_LEFT][1]),\n          (ACTION_RIGHT, MOVE_ACTIONS_DATA[ACTION_RIGHT][0], MOVE_ACTIONS_DATA[ACTION_RIGHT][1])\n      ]:\n          next_r, next_c = r + move_dr, c + move_dc\n          next_pos = (next_r, next_c)\n          next_state_tuple = (next_pos, new_dir_val)\n\n          # Only add to queue if the next position is walkable and this specific (pos, dir) state\n          # has not been visited yet.\n          if is_walkable(next_r, next_c) and next_state_tuple not in visited:\n              visited.add(next_state_tuple)\n              queue.append((next_state_tuple, path_so_far + [action_val]))\n  \n  # 8. Construct the final sequence of actions.\n  final_actions = []\n  if shortest_path is not None:\n      final_actions = shortest_path\n      # If the primitive requires \"adjacent-and-use\" collection, append the USE action\n      # AFTER reaching the target position and orientation.\n      if target_requires_adjacent_use:\n          final_actions.append(ACTION_USE)\n  \n  return final_actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T03:29:18.399069", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  ACTION_UP = action_map[\"UP\"]\n  ACTION_DOWN = action_map[\"DOWN\"]\n  ACTION_LEFT = action_map[\"LEFT\"]\n  ACTION_RIGHT = action_map[\"RIGHT\"]\n  ACTION_USE = action_map[\"USE\"]\n\n  # 1. Get the integer ID for the target primitive\n  # Convert primitive name to lowercase as internal indices might be case-insensitive.\n  primitive_id = env.world.cookbook.index[primitive.lower()]\n  if primitive_id is None:\n    # Primitive name not found in the game's index.\n    return []\n\n  # 2. Check if the primitive is grabbable (can be collected).\n  # If it's not in the list of grabbable items, it cannot be \"collected\" via a USE action.\n  if primitive_id not in env.world.grabbable_indices:\n    return []\n\n  # 3. Get current state details\n  current_state = env._current_state\n  start_pos = current_state.pos\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  # 4. Identify obstacle kinds (items that block movement)\n  # `non_grabbable_indices` typically represent static, impassable environment features.\n  impassable_kinds_ids = env.world.non_grabbable_indices\n\n  # Define possible movements and their corresponding actions: (dx, dy, action)\n  # (dx, dy) represent changes in (column index, row index)\n  move_actions = [\n      (0, -1, ACTION_UP),    # Move North (decreases y)\n      (0, 1, ACTION_DOWN),   # Move South (increases y)\n      (-1, 0, ACTION_LEFT),  # Move West (decreases x)\n      (1, 0, ACTION_RIGHT)   # Move East (increases x)\n  ]\n\n  # 5. BFS Initialization\n  # Queue for BFS: stores tuples of (current_position, path_taken_to_reach_current_position)\n  queue = collections.deque([(start_pos, [])])\n  # Set to keep track of visited grid cells (x, y) to prevent cycles and redundant exploration\n  visited = {start_pos}\n\n  # 6. BFS loop to find the shortest path to a location from which the primitive can be collected.\n  # The \"USE\" action operates on items in the 3x3 neighborhood of the agent.\n  while queue:\n    current_pos, path_so_far = queue.popleft()\n    cx, cy = current_pos\n\n    # Check if the target primitive is present in the 3x3 neighborhood of the current position (cx, cy).\n    # This aligns with the `CraftState.next_to()` method and the `USE` action mechanics.\n    is_primitive_in_neighborhood = False\n    for dx_neighbor in [-1, 0, 1]:\n      for dy_neighbor in [-1, 0, 1]:\n        # Calculate coordinates of a cell in the 3x3 neighborhood\n        nx_neighbor, ny_neighbor = cx + dx_neighbor, cy + dy_neighbor\n        \n        # Ensure the neighbor cell is within grid boundaries\n        if 0 <= nx_neighbor < grid_width and 0 <= ny_neighbor < grid_height:\n          # Check if the target primitive is present at this neighbor cell\n          if grid[nx_neighbor, ny_neighbor, primitive_id] > 0:\n            is_primitive_in_neighborhood = True\n            break # Found the primitive, no need to check other cells in this neighborhood\n      if is_primitive_in_neighborhood:\n        break # Found the primitive, no need to check other rows in this neighborhood\n    \n    if is_primitive_in_neighborhood:\n      # We have reached a position (current_pos) from which the primitive can be collected.\n      # Append the ACTION_USE to the path and return the sequence of actions.\n      return path_so_far + [ACTION_USE]\n\n    # Explore valid neighboring cells (possible next moves for the agent)\n    for dx_move, dy_move, action_move in move_actions:\n      nx_move, ny_move = cx + dx_move, cy + dy_move # Calculate the next agent position\n      next_pos = (nx_move, ny_move)\n\n      # 6a. Boundary Check: Ensure the next position is within the grid boundaries\n      if not (0 <= nx_move < grid_width and 0 <= ny_move < grid_height):\n        continue\n\n      # 6b. Visited Check: Skip if the next position has already been visited\n      if next_pos in visited:\n        continue\n\n      # 6c. Obstacle Check: Determine if the next position is blocked by an impassable object.\n      # A cell is considered blocked if any item from `impassable_kinds_ids` is present there.\n      is_blocked = False\n      for kind_id in impassable_kinds_ids:\n        if grid[nx_move, ny_move, kind_id] > 0:\n          is_blocked = True\n          break\n      \n      if is_blocked:\n        continue # Skip this move if it leads to a blocked cell\n\n      # If the move is valid (within bounds, not visited, and not blocked),\n      # add it to the queue and mark it as visited.\n      visited.add(next_pos)\n      queue.append((next_pos, path_so_far + [action_move]))\n\n  # 7. If the BFS completes and no path to collect the primitive was found (meaning it's unreachable),\n  # return an empty list.\n  return []", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T03:29:19.572815", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  ACTION_UP = action_map[\"UP\"]\n  ACTION_DOWN = action_map[\"DOWN\"]\n  ACTION_LEFT = action_map[\"LEFT\"]\n  ACTION_RIGHT = action_map[\"RIGHT\"]\n  ACTION_USE = action_map[\"USE\"]\n\n  # 1. Get the integer ID for the target primitive\n  # Convert primitive name to lowercase as internal indexing often uses consistent casing.\n  primitive_id = env.world.cookbook.index[primitive.lower()]\n  if primitive_id is None:\n    # Primitive name not found in the game's index.\n    return []\n\n  # 2. Check if the primitive is grabbable (can be collected).\n  # If it's not in the list of grabbable items, it cannot be \"collected\" via a USE action.\n  if primitive_id not in env.world.grabbable_indices:\n    return []\n\n  # 3. Get current state details\n  current_state = env._current_state\n  start_pos = current_state.pos # Agent's current (x, y) position\n  grid = current_state.grid     # Current grid layout: (WIDTH, HEIGHT, n_kinds)\n  grid_width, grid_height, _ = grid.shape # Dimensions of the grid\n\n  # 4. Identify obstacle kinds (items that block movement)\n  # Entities in `non_grabbable_indices` are typically static environment features\n  # (like boundaries, workshops, water) that act as impassable barriers.\n  impassable_kinds_ids = env.world.non_grabbable_indices\n\n  # 5. Define possible movements and their corresponding actions: (dx, dy, action)\n  # (dx, dy) represent changes in (column index, row index)\n  move_actions = [\n      (0, -1, ACTION_UP),    # Move North (decreases y)\n      (0, 1, ACTION_DOWN),   # Move South (increases y)\n      (-1, 0, ACTION_LEFT),  # Move West (decreases x)\n      (1, 0, ACTION_RIGHT)   # Move East (increases x)\n  ]\n\n  # 6. BFS Initialization\n  # Queue for BFS: stores tuples of (current_position, path_taken_to_reach_current_position)\n  queue = collections.deque([(start_pos, [])])\n  # Set to keep track of visited grid cells (x, y) to prevent cycles and redundant exploration\n  visited = {start_pos}\n\n  # 7. BFS loop to find the shortest path to a location from which the primitive is collectible.\n  # The goal is to reach a cell (cx, cy) such that the primitive_id is present\n  # in its 3x3 neighborhood (including (cx,cy) itself), assuming the USE action\n  # collects from this vicinity (as suggested by CraftState.next_to).\n  while queue:\n    current_pos, path_so_far = queue.popleft()\n    cx, cy = current_pos\n\n    # 7a. Check if the target primitive is in the 3x3 neighborhood of the current position.\n    found_primitive_in_vicinity = False\n    for dx_vicinity in [-1, 0, 1]:\n      for dy_vicinity in [-1, 0, 1]:\n        px, py = cx + dx_vicinity, cy + dy_vicinity # Candidate neighbor position\n        \n        # Check boundary for the neighbor cell\n        if not (0 <= px < grid_width and 0 <= py < grid_height):\n          continue\n        \n        # Check if the primitive is present at this neighbor cell\n        if grid[px, py, primitive_id] > 0:\n          found_primitive_in_vicinity = True\n          break # Found primitive in this 3x3 neighborhood, no need to check further\n      if found_primitive_in_vicinity:\n        break\n\n    if found_primitive_in_vicinity:\n      # We have reached a position from which the primitive can be collected.\n      # Append the USE action to the path and return.\n      return path_so_far + [ACTION_USE]\n\n    # 7b. Explore neighboring cells (possible next moves)\n    for dx_move, dy_move, action_move in move_actions:\n      nx, ny = cx + dx_move, cy + dy_move # Calculate neighbor's coordinates for potential movement\n      next_pos = (nx, ny)\n\n      # Boundary Check: Ensure the next position is within the grid boundaries\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue\n\n      # Visited Check: Skip if the next position has already been visited\n      if next_pos in visited:\n        continue\n\n      # Obstacle Check: Determine if the next position is blocked by an impassable object.\n      is_blocked = False\n      for kind_id in impassable_kinds_ids:\n        if grid[nx, ny, kind_id] > 0: # If this impassable kind is present at (nx, ny)\n          is_blocked = True\n          break\n      \n      if is_blocked:\n        continue # Skip this move if it leads to a blocked cell\n\n      # If the move is valid (within bounds, not visited, and not blocked),\n      # add it to the queue and mark it as visited.\n      visited.add(next_pos)\n      queue.append((next_pos, path_so_far + [action_move]))\n\n  # 8. If the BFS completes and no path to a collectible location was found,\n  # return an empty list, indicating the primitive is unreachable.\n  return []", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T03:30:07.844021", "function_name": "collect", "function_body": "  \"\"\"Returns a list of actions to find and collect the primitive in the passed env.\n    This version refines `collect_v1` by improving clarity and minor optimizations.\n    \n    Args:\n        env (env.CraftLab): The CraftLab object representing the current simulation state.\n        primitive (str): The string name of the primitive item to collect (e.g., \"WOOD\", \"STONE\").\n\n    Returns:\n        List[int]: A sequence of action indices (e.g., UP, DOWN, USE) to execute.\n                   Returns an empty list if the primitive cannot be found, is not grabbable,\n                   or is unreachable.\n  \"\"\"\n  actions = [] # Initialize the list to store the sequence of actions.\n\n  # Retrieve essential state information from the environment.\n  current_state = env._current_state\n  grid = current_state.grid\n  current_pos = current_state.pos # Agent's current (row, column) position on the grid.\n\n  # Map the string name of the primitive to its integer ID using the cookbook's index.\n  # This ID is used to identify the primitive in the grid and inventory arrays.\n  primitive_id = env.world.cookbook.index.get(primitive)\n  if primitive_id is None:\n      # If the primitive name does not exist in the cookbook, it cannot be collected.\n      return []\n\n  # Cache action mappings for efficiency and readability.\n  ACTION_MAP = env.action_specs()\n  DOWN = ACTION_MAP['DOWN']\n  UP = ACTION_MAP['UP']\n  LEFT = ACTION_MAP['LEFT']\n  RIGHT = ACTION_MAP['RIGHT']\n  USE = ACTION_MAP['USE']\n\n  # Define movement deltas for each cardinal direction (row_change, col_change).\n  # This mapping is crucial for calculating new positions during BFS.\n  MOVEMENT_DELTAS = {\n      UP: (-1, 0),    # Moving UP decreases the row index.\n      DOWN: (1, 0),   # Moving DOWN increases the row index.\n      LEFT: (0, -1),  # Moving LEFT decreases the column index.\n      RIGHT: (0, 1)   # Moving RIGHT increases the column index.\n  }\n\n  # Get grid dimensions. `grid.shape` is (WIDTH, HEIGHT, n_kinds).\n  GRID_ROWS, GRID_COLS, _ = grid.shape\n\n  # --- Step 1: Pre-conditions and Quick Exit Checks ---\n\n  # Check if the primitive is actually a grabbable item.\n  # Non-grabbable items (like BOUNDARY, WATER, WORKSHOPs) cannot be \"collected\" into inventory.\n  if primitive_id not in env.world.grabbable_indices:\n      return [] # Return empty list if the item cannot be picked up.\n\n  # Check if the agent is already positioned directly next to (or on) the primitive.\n  # The `CraftState.next_to()` method efficiently checks the 3x3 neighborhood.\n  if current_state.next_to(primitive_id):\n      actions.append(USE) # If so, only a 'USE' action is required.\n      return actions\n\n  # --- Step 2: Identify all instances of the primitive and potential 'use' spots ---\n\n  # Find all grid locations where the target primitive exists.\n  primitive_locations = []\n  for r in range(GRID_ROWS):\n      for c in range(GRID_COLS):\n          if grid[r, c, primitive_id] == 1: # If the primitive layer at (r, c) is 1.\n              primitive_locations.append((r, c))\n\n  # If no instances of the primitive are found on the entire grid, it's unreachable.\n  if not primitive_locations:\n      return []\n\n  # Determine all valid 'target use positions'. These are cells from which the agent\n  # can successfully perform a 'USE' action to collect the primitive.\n  # A cell is a target use position if:\n  # 1. It is adjacent to a primitive location (Manhattan distance 1).\n  # 2. It is within grid boundaries.\n  # 3. It is traversable by the agent (does not contain non-grabbable obstacles).\n  target_use_positions = set()\n  for pr, pc in primitive_locations: # For each location where the primitive is found.\n      for dr, dc in MOVEMENT_DELTAS.values(): # Check all 4 adjacent directions.\n          adj_r, adj_c = pr + dr, pc + dc # Calculate adjacent cell coordinates.\n\n          # Boundary check: Ensure adjacent cell is within the grid.\n          if not (0 <= adj_r < GRID_ROWS and 0 <= adj_c < GRID_COLS):\n              continue\n\n          # Traversability check: Ensure agent can stand on this adjacent cell.\n          is_traversable = True\n          for kind_idx in env.world.non_grabbable_indices:\n              if grid[adj_r, adj_c, kind_idx] == 1: # If cell contains an obstacle.\n                  is_traversable = False\n                  break # This cell is blocked, no need to check other kinds.\n          \n          if is_traversable:\n              target_use_positions.add((adj_r, adj_c)) # Add to the set of valid targets.\n    \n  # If there are no traversable cells from which to use the primitive, it's uncollectable.\n  if not target_use_positions:\n      return []\n\n  # --- Step 3: Breadth-First Search (BFS) for the Shortest Path ---\n\n  # The BFS queue stores tuples: `((row, col), [list_of_actions_to_reach_here])`.\n  # This allows reconstructing the path once the target is found.\n  q = collections.deque([(current_pos, [])]) \n  \n  # The `visited` set prevents revisiting cells and infinite loops, ensuring shortest path.\n  visited = {current_pos} \n\n  shortest_path_to_target = None # Will store the shortest path found by BFS.\n\n  while q:\n      (r, c), path_so_far = q.popleft() # Dequeue the current cell and its path.\n\n      # Check if the current cell is one of our desired 'target use positions'.\n      if (r, c) in target_use_positions:\n          shortest_path_to_target = path_so_far # Path found!\n          break # Exit BFS as the shortest path to a target has been found.\n\n      # Explore valid neighbors (up, down, left, right) from the current cell.\n      for action_dir, (dr, dc) in MOVEMENT_DELTAS.items():\n          nr, nc = r + dr, c + dc # Calculate the coordinates of the neighbor.\n\n          # 1. Boundary check: Is the neighbor within the grid limits?\n          if not (0 <= nr < GRID_ROWS and 0 <= nc < GRID_COLS):\n              continue\n          \n          # 2. Traversability check: Can the agent move onto this neighbor cell?\n          # This is the same check used for `target_use_positions`.\n          is_traversable = True\n          for kind_idx in env.world.non_grabbable_indices:\n              if grid[nr, nc, kind_idx] == 1: \n                  is_traversable = False\n                  break \n          \n          if not is_traversable:\n              continue \n          \n          # 3. Visited check: Has this neighbor already been visited by BFS?\n          if (nr, nc) not in visited:\n              visited.add((nr, nc)) # Mark as visited.\n              new_path = path_so_far + [action_dir] # Extend the path.\n              q.append(((nr, nc), new_path)) # Add the neighbor to the queue.\n    \n  # --- Step 4: Construct the final action sequence ---\n\n  # If a path to a valid 'target use position' was found:\n  if shortest_path_to_target is not None:\n      actions.extend(shortest_path_to_target) # Add the movement actions.\n      actions.append(USE) # Finally, add the 'USE' action to collect the primitive.\n  \n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-08-01T03:30:09.000383", "function_name": "collect", "function_body": "  actions = []\n  \n  current_state = env._current_state \n  grid = current_state.grid\n  current_pos = current_state.pos\n  \n  # Get the integer ID for the specified primitive string.\n  # The cookbook's index maps string names to integer IDs.\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Get grid dimensions. grid.shape gives (rows, columns, kinds).\n  GRID_ROWS, GRID_COLS, _ = grid.shape\n\n  # Retrieve action mappings from the environment's action specifications.\n  # This ensures correct integer values for actions.\n  _action_specs = env.action_specs()\n  DOWN = _action_specs['DOWN']\n  UP = _action_specs['UP']\n  LEFT = _action_specs['LEFT']\n  RIGHT = _action_specs['RIGHT']\n  USE = _action_specs['USE']\n\n  # Define movement deltas for cardinal directions (row_change, col_change).\n  MOVEMENT_DELTAS = {\n      UP: (-1, 0),    # Moving UP decreases the row index\n      DOWN: (1, 0),   # Moving DOWN increases the row index\n      LEFT: (0, -1),  # Moving LEFT decreases the column index\n      RIGHT: (0, 1)   # Moving RIGHT increases the column index\n  }\n\n  # Pre-check: If the primitive cannot be picked up (i.e., not in grabbable_indices),\n  # then a \"collect\" action is not applicable.\n  if primitive_id not in env.world.grabbable_indices:\n      return []\n\n  # Step 1: Check if the agent is already adjacent to the primitive.\n  # If so, only a 'USE' action is needed to collect it.\n  if current_state.next_to(primitive_id):\n      actions.append(USE)\n      return actions\n\n  # Step 2: Locate all occurrences of the target primitive on the grid.\n  primitive_locations = []\n  for r in range(GRID_ROWS):\n      for c in range(GRID_COLS):\n          if grid[r, c, primitive_id] == 1:\n              primitive_locations.append((r, c))\n\n  # If no instances of the primitive are found on the grid, it cannot be collected.\n  if not primitive_locations:\n      return []\n\n  # Step 3: Identify all valid \"target use positions\".\n  # A target use position is a grid cell from which the agent can apply 'USE'\n  # to collect the desired primitive. This cell must be:\n  #   a) Adjacent (Manhattan distance of 1) to a primitive location.\n  #   b) Traversable by the agent (not an obstacle).\n  target_use_positions = set()\n  for pr, pc in primitive_locations:\n      for dr, dc in MOVEMENT_DELTAS.values(): # Check all 4 cardinal neighbors\n          adj_r, adj_c = pr + dr, pc + dc\n\n          # Ensure the adjacent cell is within grid boundaries.\n          if not (0 <= adj_r < GRID_ROWS and 0 <= adj_c < GRID_COLS):\n              continue\n\n          # Check if the adjacent cell is traversable.\n          # A cell is traversable if it does not contain any non-grabbable entities.\n          is_traversable = True\n          for kind_idx in env.world.non_grabbable_indices:\n              if grid[adj_r, adj_c, kind_idx] == 1: \n                  is_traversable = False\n                  break \n          \n          if is_traversable:\n              target_use_positions.add((adj_r, adj_c))\n    \n  # If there are no traversable spots from which to use the primitive, it's unreachable.\n  if not target_use_positions:\n      return []\n\n  # Step 4: Perform Breadth-First Search (BFS) to find the shortest path.\n  # The BFS aims to find the shortest sequence of movement actions\n  # to reach any of the pre-computed `target_use_positions`.\n  \n  # Queue stores tuples: `((current_row, current_col), [list_of_actions_to_reach_here])`.\n  q = collections.deque([(current_pos, [])]) \n  \n  # Set to keep track of visited (row, col) positions to prevent cycles and redundant exploration.\n  visited = {current_pos} \n\n  # Variable to store the shortest path found to a target use position.\n  shortest_path_to_target = None \n\n  # Start the BFS traversal.\n  while q:\n      (r, c), path_so_far = q.popleft()\n\n      # If the current cell in BFS is one of our target use positions, we've found\n      # the shortest path to a valid collection spot.\n      if (r, c) in target_use_positions:\n          shortest_path_to_target = path_so_far \n          break \n\n      # Explore valid neighboring cells (up, down, left, right).\n      for action_dir, (dr, dc) in MOVEMENT_DELTAS.items():\n          nr, nc = r + dr, c + dc # Calculate the coordinates of the potential new position.\n\n          # Boundary check: Ensure the new position is within the grid limits.\n          if not (0 <= nr < GRID_ROWS and 0 <= nc < GRID_COLS):\n              continue\n          \n          # Traversability check: Ensure the new position is not an obstacle.\n          is_traversable = True\n          for kind_idx in env.world.non_grabbable_indices:\n              if grid[nr, nc, kind_idx] == 1: \n                  is_traversable = False\n                  break \n          \n          if not is_traversable:\n              continue \n          \n          # If the neighbor is traversable and has not been visited, add it to the queue.\n          if (nr, nc) not in visited:\n              visited.add((nr, nc)) \n              new_path = path_so_far + [action_dir] \n              q.append(((nr, nc), new_path)) \n    \n  # Step 5: Construct the final action sequence.\n  # If a path to a target use position was found during BFS, append these movement actions\n  # followed by the 'USE' action.\n  if shortest_path_to_target is not None:\n      actions.extend(shortest_path_to_target)\n      actions.append(USE) \n  \n  return actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T03:31:45.636420", "function_name": "collect", "function_body": "  # Initialize the list to store the sequence of actions.\n  action_sequence = []\n\n  # Get the current state of the environment from the CraftLab wrapper.\n  current_state = env._current_state\n\n  # Extract initial agent and world information for pathfinding.\n  initial_grid = current_state.grid\n  initial_agent_pos = current_state.pos  # (row, col) tuple\n  initial_agent_dir = current_state.dir  # Integer: 0:Right, 1:Up, 2:Left, 3:Down\n\n  # Map the string name of the primitive to its numerical ID used in the grid.\n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  # Get grid dimensions for boundary checks.\n  GRID_WIDTH, GRID_HEIGHT, _ = initial_grid.shape\n\n  # Retrieve action integer IDs from the environment's action specifications.\n  action_specs = env.action_specs()\n  ACTION_MOVE_FORWARD = action_specs['UP']    # In CraftWorld, 'UP' means move forward relative to current direction.\n  ACTION_TURN_LEFT = action_specs['LEFT']\n  ACTION_TURN_RIGHT = action_specs['RIGHT']\n  ACTION_USE = action_specs['USE']\n\n  # Define changes in (row, column) based on agent's current direction when moving forward.\n  # Direction (key) -> (delta_row, delta_column)\n  DIR_TO_DELTA_RC = {\n      0: (0, 1),   # Facing RIGHT\n      1: (-1, 0),  # Facing UP\n      2: (0, -1),  # Facing LEFT\n      3: (1, 0)    # Facing DOWN\n  }\n\n  # Define how agent's direction changes after a left or right turn.\n  # Current Direction (key) -> New Direction (value)\n  TURN_LEFT_DIR_MAP = {0: 1, 1: 2, 2: 3, 3: 0}   # Rotate 90 degrees counter-clockwise\n  TURN_RIGHT_DIR_MAP = {0: 3, 1: 0, 2: 1, 3: 2}  # Rotate 90 degrees clockwise\n\n  # Identify entity kinds that serve as obstacles (agent cannot move onto these cells).\n  # This includes non-grabbable environment features like boundaries, water, workshops.\n  obstacle_kind_ids = set(current_state.world.non_grabbable_indices)\n  \n  # Crucially, if the target primitive is a grabbable item (e.g., WOOD, STONE),\n  # the agent cannot move *onto* its cell to collect it. It must be adjacent and\n  # use the 'USE' action. Therefore, the primitive itself also acts as an obstacle\n  # to movement.\n  if primitive_id in current_state.world.grabbable_indices:\n      obstacle_kind_ids.add(primitive_id)\n  \n  # Initialize the Breadth-First Search (BFS) queue.\n  # Each element is a tuple: `((position, direction), path_to_reach_here)`.\n  # `position` is a (row, col) tuple.\n  # `direction` is an integer (0-3).\n  # `path_to_reach_here` is a list of action IDs.\n  bfs_queue = collections.deque([((initial_agent_pos, initial_agent_dir), [])])\n  \n  # Initialize the set of visited states to prevent cycles and redundant exploration.\n  # A state is defined by (position, direction).\n  visited_states = {(initial_agent_pos, initial_agent_dir)}\n\n  # This variable will store the shortest sequence of actions (excluding the final USE)\n  # that leads the agent to a state where the primitive is directly in front.\n  path_to_primitive_front = None\n\n  # --- BFS Main Loop ---\n  while bfs_queue:\n      (current_pos, current_dir), actions_so_far = bfs_queue.popleft()\n      current_r, current_c = current_pos\n\n      # 1. Check if the goal is met: Is the primitive directly in front of the agent?\n      # Calculate the coordinates of the cell directly in front of the agent.\n      front_dr, front_dc = DIR_TO_DELTA_RC[current_dir]\n      front_r, front_c = current_r + front_dr, current_c + front_dc\n      \n      # Ensure the target cell is within grid boundaries.\n      if (0 <= front_r < GRID_WIDTH and 0 <= front_c < GRID_HEIGHT):\n          # Check if the primitive exists in the cell directly in front.\n          # A value > 0 indicates presence.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              path_to_primitive_front = actions_so_far\n              break # Goal reached, shortest path found, exit BFS.\n\n      # 2. Explore possible next actions from the current state.\n      \n      # --- Try Moving Forward (ACTION_MOVE_FORWARD) ---\n      next_r_move, next_c_move = current_r + DIR_TO_DELTA_RC[current_dir][0], current_c + DIR_TO_DELTA_RC[current_dir][1]\n      next_pos_move = (next_r_move, next_c_move)\n      next_dir_move = current_dir # Direction doesn't change when moving forward.\n\n      # Check if the new position is valid and the state hasn't been visited.\n      if (0 <= next_r_move < GRID_WIDTH and 0 <= next_c_move < GRID_HEIGHT and\n          (next_pos_move, next_dir_move) not in visited_states):\n          \n          is_walkable_to_next_cell = True\n          # Check if the next cell contains any obstacle.\n          for obstacle_id in obstacle_kind_ids:\n              if initial_grid[next_r_move, next_c_move, obstacle_id] > 0:\n                  is_walkable_to_next_cell = False\n                  break # Found an obstacle, cannot move to this cell.\n\n          if is_walkable_to_next_cell:\n              visited_states.add((next_pos_move, next_dir_move)) # Mark new state as visited.\n              bfs_queue.append((\n                  (next_pos_move, next_dir_move),\n                  actions_so_far + [ACTION_MOVE_FORWARD]\n              ))\n\n      # --- Try Turning Left (ACTION_TURN_LEFT) ---\n      next_dir_left = TURN_LEFT_DIR_MAP[current_dir]\n      # Position remains the same when turning.\n      if ((current_pos, next_dir_left) not in visited_states):\n          visited_states.add((current_pos, next_dir_left))\n          bfs_queue.append((\n              (current_pos, next_dir_left),\n              actions_so_far + [ACTION_TURN_LEFT]\n          ))\n\n      # --- Try Turning Right (ACTION_TURN_RIGHT) ---\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Position remains the same when turning.\n      if ((current_pos, next_dir_right) not in visited_states):\n          visited_states.add((current_pos, next_dir_right))\n          bfs_queue.append((\n              (current_pos, next_dir_right),\n              actions_so_far + [ACTION_TURN_RIGHT]\n          ))\n\n  # --- Final Action Sequence Construction ---\n  # If a path to being in front of the primitive was found, append the final 'USE' action.\n  if path_to_primitive_front is not None:\n      action_sequence.extend(path_to_primitive_front)\n      action_sequence.append(ACTION_USE)\n\n  return action_sequence", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-08-01T03:31:46.857576", "function_name": "collect", "function_body": "  \"\"\"Returns a sequence of actions to navigate to and collect a specified primitive.\n\n  This function employs a Breadth-First Search (BFS) algorithm to determine the\n  shortest sequence of actions (movements and turns) required for the agent\n  to reach a state where it is directly facing the target `primitive`. Once\n  such a state is identified, a 'USE' action is appended to the action sequence\n  to simulate the collection of the primitive. The search rigorously considers\n  grid boundaries and various types of obstacles (non-grabbable items and the\n  primitive itself, if grabbable).\n\n  Args:\n      env (env.CraftLab): The current CraftLab environment instance. This provides\n                          access to the underlying CraftState, including the grid\n                          layout, agent's current position and direction, and\n                          the world's configuration (e.g., item indices, obstacles).\n      primitive (str): The string name of the primitive item to be collected\n                       (e.g., \"WOOD\", \"STONE\", \"GOLD\", \"GRASS\").\n\n  Returns:\n      List[int]: A list of integer action codes (as defined by `env.action_specs()`)\n                 that, when executed sequentially, will lead the agent to collect\n                 the specified primitive. Returns an empty list if the primitive\n                 is not found or is unreachable within the current grid configuration.\n  \"\"\"\n  action_sequence_to_collect = []\n\n  # Retrieve the current game state from the environment wrapper.\n  # The grid, agent's position, and direction are treated as initial conditions for BFS.\n  current_craft_state = env._current_state\n  initial_grid = current_craft_state.grid\n  initial_agent_position = current_craft_state.pos  # (row, col) tuple\n  initial_agent_direction = current_craft_state.dir  # int: 0=RIGHT, 1=UP, 2=LEFT, 3=DOWN\n\n  # Map the string name of the primitive to its integer ID used in the grid.\n  primitive_id = current_craft_state.world.cookbook.index[primitive]\n\n  # Get grid dimensions for boundary checks.\n  GRID_ROWS, GRID_COLS, _ = initial_grid.shape\n\n  # Retrieve numerical action codes from the environment's action specifications.\n  # This makes the code resilient to changes in action mapping.\n  action_id_map = env.action_specs()\n  ACTION_MOVE_FORWARD = action_id_map['UP']  # In CraftWorld, 'UP' means move in current facing direction\n  ACTION_TURN_LEFT = action_id_map['LEFT']\n  ACTION_TURN_RIGHT = action_id_map['RIGHT']\n  ACTION_USE = action_id_map['USE']          # Action to interact with/collect items\n\n  # Define changes in (row, column) coordinates for each of the four directions\n  # when the agent moves forward or for checking the cell in front.\n  # Direction (key) -> (delta_row, delta_col)\n  DIRECTION_TO_DELTA_RC = {\n      0: (0, 1),   # Facing RIGHT (0): move right (+1 col)\n      1: (-1, 0),  # Facing UP (1): move up (-1 row)\n      2: (0, -1),  # Facing LEFT (2): move left (-1 col)\n      3: (1, 0)    # Facing DOWN (3): move down (+1 row)\n  }\n\n  # Define how agent's direction changes upon turning left or right.\n  # Current Direction (key) -> New Direction (value)\n  TURN_LEFT_DIRECTION_MAP = {0: 1, 1: 2, 2: 3, 3: 0}   # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_DIRECTION_MAP = {0: 3, 1: 0, 2: 1, 3: 2}  # Right -> Down -> Left -> Up -> Right\n\n  # Determine which entity kinds act as obstacles.\n  # Agent cannot move onto cells containing these items.\n  obstacle_kind_ids = set(current_craft_state.world.non_grabbable_indices)\n  # Additionally, if the target primitive is a grabbable resource (e.g., WOOD, STONE),\n  # the agent cannot path *onto* its cell; it must interact from an adjacent cell.\n  # So, the primitive itself also acts as a temporary obstacle for pathfinding.\n  if primitive_id in current_craft_state.world.grabbable_indices:\n      obstacle_kind_ids.add(primitive_id)\n  \n  # --- Breadth-First Search (BFS) Initialization ---\n  # The BFS queue stores tuples:\n  #   ((agent_position_tuple, agent_direction_int), list_of_actions_to_reach_this_state)\n  # This allows tracking both the agent's spatial location and its orientation.\n  bfs_queue = collections.deque([((initial_agent_position, initial_agent_direction), [])])\n  \n  # The 'visited' set stores (position_tuple, direction_int) pairs that have already\n  # been processed. This prevents infinite loops and ensures the shortest path.\n  visited_states = {(initial_agent_position, initial_agent_direction)}\n\n  # This variable will store the path found by BFS to the goal state.\n  path_to_facing_primitive = None\n\n  # --- Main BFS Loop ---\n  while bfs_queue:\n      # Dequeue the current agent state and the sequence of actions that led to it.\n      (current_pos_r, current_pos_c), current_dir, actions_so_far = bfs_queue.popleft()\n      \n      # 1. Goal Check: Is the primitive directly in front of the agent in the current state?\n      # Calculate the coordinates of the cell directly in front of the agent.\n      front_dr, front_dc = DIRECTION_TO_DELTA_RC[current_dir]\n      cell_in_front_r, cell_in_front_c = current_pos_r + front_dr, current_pos_c + front_dc\n      \n      # Ensure the cell in front is within grid boundaries.\n      if (0 <= cell_in_front_r < GRID_ROWS and 0 <= cell_in_front_c < GRID_COLS):\n          # Check if the target primitive is present in the cell directly in front.\n          # A value > 0 in the primitive's channel indicates its presence.\n          if initial_grid[cell_in_front_r, cell_in_front_c, primitive_id] > 0:\n              path_to_facing_primitive = actions_so_far # Store the path leading to this state.\n              break # Goal achieved: shortest path found, terminate BFS.\n\n      # 2. Explore Possible Next Actions (Move Forward, Turn Left, Turn Right) from current state.\n\n      # Try ACTION_MOVE_FORWARD:\n      # Calculate the next position if the agent moves forward. Direction remains the same.\n      move_dr, move_dc = DIRECTION_TO_DELTA_RC[current_dir]\n      next_pos_r, next_pos_c = current_pos_r + move_dr, current_pos_c + move_dc\n      next_agent_pos_after_move = (next_pos_r, next_pos_c)\n      next_agent_dir_after_move = current_dir # Direction doesn't change when moving.\n\n      # Check conditions for a valid forward move:\n      # a) New position must be within grid boundaries.\n      # b) This new (position, direction) state must not have been visited before.\n      # c) The cell at `next_agent_pos_after_move` must be walkable (not contain any obstacle kinds).\n      if (0 <= next_pos_r < GRID_ROWS and 0 <= next_pos_c < GRID_COLS and\n          (next_agent_pos_after_move, next_agent_dir_after_move) not in visited_states):\n          \n          is_cell_walkable = True\n          # Check if the prospective cell contains any defined obstacle kinds.\n          for obstacle_id in obstacle_kind_ids:\n              if initial_grid[next_pos_r, next_pos_c, obstacle_id] > 0:\n                  is_cell_walkable = False\n                  break # Found an obstacle, this path is invalid.\n\n          if is_cell_walkable:\n              visited_states.add((next_agent_pos_after_move, next_agent_dir_after_move)) # Mark as visited.\n              # Add the new state and its accumulated path to the BFS queue.\n              bfs_queue.append((\n                  (next_agent_pos_after_move, next_agent_dir_after_move),\n                  actions_so_far + [ACTION_MOVE_FORWARD]\n              ))\n\n      # Try ACTION_TURN_LEFT:\n      # Calculate the new direction after turning left. Position remains unchanged.\n      next_agent_dir_after_left_turn = TURN_LEFT_DIRECTION_MAP[current_dir]\n      \n      # Check if this new (position, direction) state hasn't been visited.\n      current_agent_pos = (current_pos_r, current_pos_c)\n      if ((current_agent_pos, next_agent_dir_after_left_turn) not in visited_states):\n          visited_states.add((current_agent_pos, next_agent_dir_after_left_turn)) # Mark as visited.\n          # Add the new state and its path to the BFS queue.\n          bfs_queue.append((\n              (current_agent_pos, next_agent_dir_after_left_turn),\n              actions_so_far + [ACTION_TURN_LEFT]\n          ))\n\n      # Try ACTION_TURN_RIGHT:\n      # Calculate the new direction after turning right. Position remains unchanged.\n      next_agent_dir_after_right_turn = TURN_RIGHT_DIRECTION_MAP[current_dir]\n      \n      # Check if this new (position, direction) state hasn't been visited.\n      if ((current_agent_pos, next_agent_dir_after_right_turn) not in visited_states):\n          visited_states.add((current_agent_pos, next_agent_dir_after_right_turn)) # Mark as visited.\n          # Add the new state and its path to the BFS queue.\n          bfs_queue.append((\n              (current_agent_pos, next_agent_dir_after_right_turn),\n              actions_so_far + [ACTION_TURN_RIGHT]\n          ))\n\n  # --- Final Action Sequence Assembly ---\n  # If a path was successfully found (i.e., the agent can reach a state where it faces the primitive),\n  # append the final 'USE' action to the movement sequence.\n  if path_to_facing_primitive is not None:\n      action_sequence_to_collect.extend(path_to_facing_primitive)\n      action_sequence_to_collect.append(ACTION_USE)\n\n  return action_sequence_to_collect", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-08-01T03:33:17.854771", "function_name": "collect", "function_body": "  primitive_id = env.world.cookbook.index[primitive]\n  \n  if primitive_id is None:\n      return []\n\n  state = env._current_state\n  current_pos = state.pos\n  current_dir = state.dir # Initial facing direction\n  grid = state.grid\n  \n  width, height, _ = grid.shape \n\n  actions_map = env.action_specs()\n  UP = actions_map['UP']\n  DOWN = actions_map['DOWN']\n  LEFT = actions_map['LEFT']\n  RIGHT = actions_map['RIGHT']\n  USE = actions_map['USE']\n\n  # Map direction index (which is also the action index for movement) to its (dr, dc) delta.\n  # These deltas represent both the movement taken by the action and the direction the agent faces after the action.\n  direction_deltas_map = {\n      DOWN: (1, 0),\n      UP: (-1, 0),\n      LEFT: (0, -1),\n      RIGHT: (0, 1)\n  }\n\n  # BFS setup:\n  # Queue stores tuples: ((row, col, facing_direction_idx), [list_of_actions_to_reach_this_state])\n  q = collections.deque([((current_pos[0], current_pos[1], current_dir), [])]) \n  \n  # Visited set stores (row, col, facing_direction_idx) tuples to prevent revisiting states\n  visited = {(current_pos[0], current_pos[1], current_dir)}\n\n  while q:\n      (r, c, d), path_actions = q.popleft()\n\n      # Check if the current (r, c, d) state allows for immediate collection via USE action.\n      # The USE action interacts with the cell directly in front of the agent.\n      dr_face, dc_face = direction_deltas_map[d] # Get delta for the direction agent is currently facing\n      target_r, target_c = r + dr_face, c + dc_face # Coordinates of the cell directly in front\n\n      # Check if the target cell is within grid boundaries\n      if 0 <= target_r < width and 0 <= target_c < height:\n          # Check if the target cell contains the primitive we want to collect\n          if grid[target_r, target_c, primitive_id] > 0:\n              return path_actions + [USE] # Path found! Append USE action.\n\n      # Explore movement neighbors (UP, DOWN, LEFT, RIGHT)\n      # Each movement action not only changes the agent's position but also sets its facing direction.\n      for move_action in [UP, DOWN, LEFT, RIGHT]:\n          next_dir_idx = move_action # After moving, agent faces the direction it just moved\n          dr_move, dc_move = direction_deltas_map[move_action] # Delta for the movement itself\n\n          nr, nc = r + dr_move, c + dc_move # New row, new col after movement\n          next_state_tuple = (nr, nc, next_dir_idx) # The new state (position and facing direction)\n\n          # 1. Check if the next position (nr, nc) is within grid boundaries\n          if not (0 <= nr < width and 0 <= nc < height):\n              continue\n          \n          # 2. Check for obstacles: A cell is considered an obstacle if it contains\n          #    any non-grabbable environment item (e.g., WATER, WORKSHOP) AND\n          #    that item is NOT the primitive we are trying to collect.\n          is_obstacle = False\n          for env_item_id in env.world.cookbook.environment:\n              if grid[nr, nc, env_item_id] > 0: # If the next cell contains an environment item...\n                  # And this environment item is NOT the primitive we are trying to collect,\n                  # then it's an untraversable obstacle.\n                  if env_item_id != primitive_id:\n                      is_obstacle = True\n                      break\n          \n          if is_obstacle:\n              continue\n\n          # 3. If the new state (position and facing direction) has not been visited, add it to the queue\n          if next_state_tuple not in visited:\n              visited.add(next_state_tuple)\n              q.append((next_state_tuple, path_actions + [move_action]))\n\n  # If the BFS completes and the primitive was not found anywhere reachable or collectable\n  return []", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T03:33:19.015988", "function_name": "collect", "function_body": "  primitive_id = env.world.cookbook.index[primitive]\n  \n  # If the primitive name is not found in the cookbook's index, it cannot be collected.\n  if primitive_id is None:\n      return []\n\n  state = env._current_state\n  current_pos = state.pos\n  grid = state.grid\n  \n  # Grid dimensions (WIDTH, HEIGHT, n_kinds)\n  width, height, _ = grid.shape \n\n  # Get action mappings from the environment\n  actions_map = env.action_specs()\n  UP = actions_map['UP']\n  DOWN = actions_map['DOWN']\n  LEFT = actions_map['LEFT']\n  RIGHT = actions_map['RIGHT']\n  USE = actions_map['USE']\n\n  # Determine if the primitive is grabbable (can be picked up by moving onto it)\n  # or non-grabbable (e.g., workshop, water, usually interacted with from an adjacent cell).\n  is_grabbable = primitive_id in env.world.grabbable_indices\n  is_non_grabbable = primitive_id in env.world.non_grabbable_indices\n\n  # BFS setup:\n  # Queue stores tuples: ((row, col), [list_of_actions_to_reach_this_pos])\n  q = collections.deque([(current_pos, [])]) \n  # Visited set stores (row, col) tuples to prevent revisiting cells\n  visited = {current_pos}\n\n  # Define possible movements (dr, dc, action_index)\n  move_deltas = [\n      (1, 0, DOWN),  # Move Down (increase row)\n      (-1, 0, UP),   # Move Up (decrease row)\n      (0, 1, RIGHT), # Move Right (increase col)\n      (0, -1, LEFT)  # Move Left (decrease col)\n  ]\n\n  # Define adjacency deltas for checking neighbors (for non-grabbable items)\n  adj_deltas = [(-1, 0), (1, 0), (0, -1), (0, 1)] # North, South, West, East\n\n  while q:\n      (r, c), path_actions = q.popleft()\n\n      # Goal Check:\n      if is_grabbable:\n          # If the primitive is grabbable, we need to move onto its cell to collect it.\n          if grid[r, c, primitive_id] > 0:\n              return path_actions + [USE]\n      elif is_non_grabbable:\n          # If the primitive is non-grabbable, we usually need to be ADJACENT to it to interact/collect.\n          found_adjacent_primitive = False\n          for dr_adj, dc_adj in adj_deltas:\n              ar, ac = r + dr_adj, c + dc_adj\n              # Check bounds for adjacent cell\n              if 0 <= ar < width and 0 <= ac < height:\n                  if grid[ar, ac, primitive_id] > 0:\n                      found_adjacent_primitive = True\n                      break\n          if found_adjacent_primitive:\n              return path_actions + [USE]\n      # Note: If a primitive is neither explicitly grabbable nor non-grabbable based on CraftWorld's lists,\n      # it won't be collected by this BFS. This typically implies it's a crafted item, not a primitive to collect.\n\n      # Explore neighbors\n      for dr, dc, action in move_deltas:\n          nr, nc = r + dr, c + dc # Next row, next col\n          next_pos = (nr, nc)\n\n          # 1. Check if the next position is within grid boundaries\n          if not (0 <= nr < width and 0 <= nc < height):\n              continue\n          \n          # 2. Check if the next position has already been visited\n          if next_pos in visited:\n              continue\n\n          # 3. Obstacle Check:\n          # A cell is considered an obstacle if it contains ANY non-grabbable item.\n          # This assumes non-grabbable entities (like WATER, WORKSHOPs) are generally impassable terrain.\n          is_obstacle = False\n          for non_grabbable_idx in env.world.non_grabbable_indices:\n              if grid[nr, nc, non_grabbable_idx] > 0:\n                  is_obstacle = True\n                  break # Found an impassable obstacle\n          \n          if is_obstacle:\n              continue # Cannot move to this cell because it's an obstacle\n\n          # If the cell is traversable and not yet visited, add it to the queue\n          visited.add(next_pos)\n          q.append((next_pos, path_actions + [action]))\n\n  # If the BFS completes and the primitive was not found anywhere reachable\n  return []", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T03:35:02.850997", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` by assuming 'USE' action is directional.\n  It finds a path to a position and orientation where the primitive is directly in front\n  of the agent, then appends a USE action.\n    \n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect.\n\n    Returns:\n        List[int]: A sequence of action indices to execute.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (r, c)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # If the primitive cannot be picked up (e.g., it's a terrain feature, water, or a workshop),\n  # return an empty list immediately as it's not \"collectible\".\n  # This check ensures that 'collect' is only attempted for truly grabbable items.\n  if primitive_id in current_state.world.non_grabbable_indices:\n      return []\n\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  # These are changes in (row, column) when moving forward.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT (positive column direction)\n      1: (-1, 0),  # Facing UP (negative row direction)\n      2: (0, -1),  # Facing LEFT (negative column direction)\n      3: (1, 0)    # Facing DOWN (positive row direction)\n  }\n\n  # Map for turning left/right, updating the agent's direction (0-3)\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0} # R->U->L->D->R\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # R->D->L->U->R\n\n  # Get indices of non-grabbable items that block movement (e.g., BOUNDARY, WATER, WORKSHOP_X).\n  # These are considered obstacles for pathfinding.\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # Optimization: Check if primitive is directly in front at the *initial* state.\n  # If so, a single USE action is sufficient. This replaces the less precise `next_to`\n  # check from `collect_v1` to be consistent with directional USE.\n  initial_front_dr, initial_front_dc = DIR_TO_DRDC[initial_dir]\n  initial_front_r, initial_front_c = initial_pos[0] + initial_front_dr, initial_pos[1] + initial_front_dc\n  \n  if (0 <= initial_front_r < WIDTH and 0 <= initial_front_c < HEIGHT and\n      initial_grid[initial_front_r, initial_front_c, primitive_id] > 0):\n      return [USE_ACTION] # Primitive is directly in front, just use it.\n\n  # BFS for shortest path to a (position, direction) state where the primitive is in front.\n  # Queue stores ( (current_pos_tuple, current_dir_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (current_pos_tuple, current_dir_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # Stores the action list to reach the target state\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # Check if the current state (pos, dir) is a goal state for collecting the primitive.\n      # A goal state is reached if the primitive is in the cell *directly in front* of the agent.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      check_r, check_c = r + front_dr, c + front_dc\n      \n      # Ensure the checked cell is within grid bounds and contains the primitive.\n      if (0 <= check_r < WIDTH and 0 <= check_c < HEIGHT and\n          initial_grid[check_r, check_c, primitive_id] > 0):\n          target_path = path_actions\n          break # Found a path to a position and orientation for collection.\n\n      # Explore possible next actions: Move Forward, Turn Left, Turn Right\n      \n      # Try Move Forward action\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if next_pos is within grid bounds and this (position, direction) state hasn't been visited.\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT and\n          (next_pos, next_dir) not in visited):\n          \n          is_walkable = True\n          # A cell is walkable if it doesn't contain any non-grabbable entity (e.g., boundary, water, workshops).\n          # Grabbable primitives (like WOOD, STONE) are considered walkable, as the agent can move over them.\n          for kind_idx in non_walkable_kinds_indices:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable = False\n                  break\n\n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left action\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right action\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path was found to a collectable position and orientation, append the USE action.\n  # This USE action will be executed after all movement and turning actions in 'target_path'.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T03:35:04.105829", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n    Ensures that the agent can traverse cells containing collectable primitive resources\n    (e.g., WOOD, STONE, ROCK) as part of finding the shortest path to a collection point.\n    These resources are considered traversable if they are not explicitly listed as\n    non-walkable entities (like BOUNDARY, WATER, or WORKSHOPS).\n    \n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect.\n\n    Returns:\n        List[int]: A sequence of action indices to execute.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (r, c)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # As refined in collect_v1: If the primitive cannot be picked up into inventory\n  # (e.g., it's a terrain feature like WATER, or a WORKSHOP),\n  # return an empty list immediately as it's not \"collectible\" in the inventory sense.\n  if primitive_id in current_state.world.non_grabbable_indices:\n      return []\n\n  action_map = env.action_specs()\n  # Map DSL movement/turn actions to their integer indices from action_specs\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT, move in positive column direction (c)\n      1: (-1, 0),  # Facing UP, move in negative row direction (r)\n      2: (0, -1),  # Facing LEFT, move in negative column direction (c)\n      3: (1, 0)    # Facing DOWN, move in positive row direction (r)\n  }\n\n  # Map for turning left/right, updating the agent's direction (0-3)\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # Get indices of non-grabbable items that consistently block movement (e.g., BOUNDARY, WATER, WORKSHOP_X).\n  # Items explicitly marked as non-grabbable are considered non-walkable.\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # Optimization: If the primitive is already collectible from the current position, just use it.\n  # The `next_to` method checks the 3x3 neighborhood around the agent's position.\n  if current_state.next_to(primitive_id):\n      return [USE_ACTION]\n\n  # BFS state: ((row, col), direction), path_actions\n  # Queue stores ( (current_pos_tuple, current_dir_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (current_pos_tuple, current_dir_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # Stores the action list to reach the target state\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # Check if the current position (r, c) is suitable for collecting the primitive.\n      # This means the primitive must be in the 3x3 neighborhood of (r, c).\n      found_collectable_position = False\n      for dr_check in [-1, 0, 1]:\n          for dc_check in [-1, 0, 1]:\n              check_r, check_c = r + dr_check, c + dc_check\n              # Ensure the checked cell is within grid bounds\n              if (0 <= check_r < WIDTH and 0 <= check_c < HEIGHT and\n                  initial_grid[check_r, check_c, primitive_id] > 0):\n                  found_collectable_position = True\n                  break # Found the primitive in the neighborhood\n          if found_collectable_position:\n              break\n\n      if found_collectable_position:\n          target_path = path_actions\n          break # Path to a position from which the primitive can be collected is found\n\n      # Explore possible next actions: Move Forward, Turn Left, Turn Right\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if next_pos is within bounds and this (position, direction) state hasn't been visited\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT and\n          (next_pos, next_dir) not in visited):\n          \n          is_walkable = True\n          # A cell is walkable if it doesn't contain any explicitly non-walkable entities.\n          # This specifically means that cells containing grabbable primitives (like WOOD, STONE)\n          # are considered walkable, allowing the agent to move over them if necessary to\n          # reach the optimal collection point. This is consistent with the desired behavior\n          # hinted for v2.\n          for kind_idx in non_walkable_kinds_indices:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable = False\n                  break\n\n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path was found to a collectable position, append the USE action\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T03:36:24.762551", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook\n  try:\n    primitive_idx = world.cookbook.index[primitive]\n  except KeyError:\n    # Primitive not found in the cookbook, cannot be collected.\n    return []\n\n  # 2. Pre-check: If the primitive is already in the agent's inventory, no actions are needed.\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # 3. Define action integers and grid dimensions\n  action_map = env.action_specs()\n  USE_ACT = action_map[\"USE\"]\n  WIDTH, HEIGHT, _ = current_state.grid.shape\n\n  # Map movement action IDs to their corresponding row/column delta.\n  _MOVE_DELTAS = {\n      action_map['DOWN']: (1, 0),\n      action_map['UP']: (-1, 0),\n      action_map['LEFT']: (0, -1),\n      action_map['RIGHT']: (0, 1),\n  }\n\n  # Map movement action IDs to the new direction the agent will be facing after the move.\n  # CraftState.dir: 0=DOWN, 1=UP, 2=LEFT, 3=RIGHT.\n  _ACTION_TO_NEW_DIR = {\n      action_map['DOWN']: 0,\n      action_map['UP']: 1,\n      action_map['LEFT']: 2,\n      action_map['RIGHT']: 3\n  }\n\n  # Map direction indices (0-3) to the (dr, dc) delta for the cell *in front* of the agent.\n  _DIR_TO_DELTA = {\n      0: (1, 0),  # DOWN\n      1: (-1, 0), # UP\n      2: (0, -1), # LEFT\n      3: (0, 1)   # RIGHT\n  }\n\n  # Identify indices of objects that generally act as obstacles for movement.\n  # These are typically non-grabbable entities like boundaries, water, or other specific\n  # workshop types that are not the target we want to interact with.\n  obstacle_indices = set(world.non_grabbable_indices)\n\n  # Determine if the target primitive requires a 'USE' action to be collected.\n  # Grabbable items (e.g., WOOD, IRON, STONE) typically require a 'USE' action when adjacent.\n  # Non-grabbable items (e.g., WORKSHOPs, BOUNDARY, WATER) are \"collected\" by simply being\n  # adjacent to them (or on them, for workshops).\n  requires_use_action = (primitive_idx in world.grabbable_indices)\n\n  # BFS setup\n  # Queue stores tuples of ((row, column), direction, list_of_actions_to_reach_here).\n  q = collections.deque([((current_state.pos[0], current_state.pos[1]), current_state.dir, [])])\n\n  # Visited set: stores tuples of ((row, column), direction) to avoid redundant exploration and cycles.\n  # A state is uniquely defined by the agent's position and facing direction.\n  visited = {(current_state.pos[0], current_state.pos[1], current_state.dir)}\n\n  # Maximum search depth to prevent infinite loops in complex or unreachable scenarios.\n  # A conservative estimate is twice the total number of unique (position, direction) states.\n  max_search_length = WIDTH * HEIGHT * len(_MOVE_DELTAS) * 2\n\n  while q:\n    (r, c), current_dir, path = q.popleft()\n\n    # Pruning: If the current path length exceeds the maximum search depth,\n    # it's likely inefficient or indicates an unreachable goal.\n    if len(path) > max_search_length:\n      continue\n\n    # --- Goal Check ---\n    # Check if the agent's current simulated state allows for the collection of the primitive.\n    \n    if requires_use_action:\n      # If 'USE' is required, the primitive must be in the cell directly in front of the agent.\n      dr_front, dc_front = _DIR_TO_DELTA[current_dir]\n      nr_front, nc_front = r + dr_front, c + dc_front\n\n      # Check if the cell in front is within grid bounds and contains the target primitive.\n      if (0 <= nr_front < WIDTH and 0 <= nc_front < HEIGHT and\n              current_state.grid[nr_front, nc_front, primitive_idx] == 1):\n        # Goal reached: primitive is in front. Append 'USE' action and return the path.\n        return path + [USE_ACT]\n    else:\n      # If 'USE' is NOT required (e.g., for workshops, boundary, water),\n      # \"collection\" means being adjacent to or on the primitive.\n      # Check the 3x3 neighborhood around the agent's current position (including the agent's own cell).\n      found_adjacent = False\n      for dr_nb in [-1, 0, 1]:\n        for dc_nb in [-1, 0, 1]:\n          nr_nb, nc_nb = r + dr_nb, c + dc_nb\n          # Check if the neighbor cell is within grid bounds\n          if 0 <= nr_nb < WIDTH and 0 <= nc_nb < HEIGHT:\n            # Check if the primitive exists at the neighbor cell.\n            if current_state.grid[nr_nb, nc_nb, primitive_idx] == 1:\n              found_adjacent = True\n              break\n        if found_adjacent:\n          break\n      \n      if found_adjacent:\n        # Goal reached: primitive is adjacent or at the current position. No 'USE' action needed.\n        return path\n\n    # --- Explore Neighbors (Movement Actions) ---\n    # Iterate through all possible movement actions (UP, DOWN, LEFT, RIGHT)\n    for action_id, (dr, dc) in _MOVE_DELTAS.items():\n      nr, nc = r + dr, c + dc # Calculate the new potential position.\n      new_dir = _ACTION_TO_NEW_DIR[action_id] # Determine the new facing direction after this move.\n\n      # 1. Check if the new position is within the grid boundaries.\n      if not (0 <= nr < WIDTH and 0 <= nc < HEIGHT):\n        continue\n\n      # 2. Check if this specific (position, direction) state has already been visited\n      # to avoid redundant computations and cycles in the path.\n      if (nr, nc, new_dir) in visited:\n        continue\n\n      # 3. Determine if the new position is traversable.\n      # A cell is traversable if it does not contain any blocking obstacles.\n      # A special rule applies: if the obstacle is the target primitive itself AND\n      # that primitive is a non-grabbable type (like a workshop you can stand on),\n      # then it is NOT considered an obstacle for THIS path, allowing the agent to move onto it.\n      is_traversable = True\n      for obstacle_kind_idx in obstacle_indices:\n        # If the current obstacle is the primitive we are trying to collect, AND\n        # we don't need to 'USE' it (meaning we can interact by being adjacent or on it),\n        # THEN this specific primitive_idx does NOT block movement onto its cell.\n        if obstacle_kind_idx == primitive_idx and not requires_use_action:\n            continue # Allow movement onto the target if it's a \"stand-on\" type (e.g., a workshop)\n        \n        # Otherwise, if the cell contains this obstacle, it is not traversable.\n        if current_state.grid[nr, nc, obstacle_kind_idx] == 1:\n          is_traversable = False\n          break\n      \n      if not is_traversable:\n        continue # Cannot move into an impassable cell.\n\n      # If the new state is valid and traversable, add it to the queue for further exploration\n      # and mark it as visited.\n      visited.add((nr, nc, new_dir))\n      q.append(((nr, nc), new_dir, path + [action_id]))\n\n  # If the BFS completes without finding a path to collect the primitive, return an empty list.\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T03:36:25.926495", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Obtain the integer ID for the requested primitive from the world's cookbook index.\n  try:\n    primitive_idx = world.cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name does not correspond to a known item, it cannot be collected.\n    return []\n\n  # 2. Pre-check: If the primitive is already present in the agent's inventory,\n  # no actions are required to collect it. This is an immediate success condition.\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # 3. Initialize essential data structures and constants for pathfinding.\n  action_map = env.action_specs()\n  USE_ACT = action_map[\"USE\"]\n  WIDTH, HEIGHT, _ = current_state.grid.shape # Get grid dimensions from the current state.\n\n  # Define movement deltas for each action (row, column changes).\n  _MOVE_DELTAS = {\n      action_map['DOWN']: (1, 0),\n      action_map['UP']: (-1, 0),\n      action_map['LEFT']: (0, -1),\n      action_map['RIGHT']: (0, 1),\n  }\n\n  # Map movement actions to the agent's new facing direction.\n  # CraftState.dir: 0=DOWN, 1=UP, 2=LEFT, 3=RIGHT.\n  _ACTION_TO_NEW_DIR = {\n      action_map['DOWN']: 0,\n      action_map['UP']: 1,\n      action_map['LEFT']: 2,\n      action_map['RIGHT']: 3\n  }\n\n  # Map direction indices to the (dr, dc) delta for the cell directly in front of the agent.\n  # This is crucial for checking `USE` action targets.\n  _DIR_TO_DELTA = {\n      0: (1, 0),  # DOWN: (dr, dc) = (+1, 0)\n      1: (-1, 0), # UP:   (dr, dc) = (-1, 0)\n      2: (0, -1), # LEFT: (dr, dc) = (0, -1)\n      3: (0, 1)   # RIGHT: (dr, dc) = (0, +1)\n  }\n\n  # Identify objects that are impassable (cannot be walked through).\n  # These are generally all non-grabbable items unless explicitly allowed (e.g., workshops).\n  impassable_object_indices = set(world.non_grabbable_indices)\n\n  # Determine if the target primitive requires a 'USE' action to be collected.\n  # Grabbable items (e.g., WOOD, STONE) require 'USE'.\n  # Non-grabbable items (e.g., WORKSHOPs, BOUNDARY) only require reaching adjacency/position.\n  requires_use_action = (primitive_idx in world.grabbable_indices)\n\n  # 4. Implement Breadth-First Search (BFS) to find the shortest path.\n  # The queue stores tuples: ((row, column), current_direction, list_of_actions_taken_to_reach_here).\n  q = collections.deque([((current_state.pos[0], current_state.pos[1]), current_state.dir, [])])\n\n  # The visited set stores (row, column, direction) tuples to prevent cycles and redundant exploration.\n  visited = {(current_state.pos[0], current_state.pos[1], current_state.dir)}\n\n  # Define a maximum search length to prevent infinite loops in complex or unreachable scenarios.\n  # This is a heuristic based on the total number of unique (position, direction) states.\n  max_search_length = WIDTH * HEIGHT * len(_MOVE_DELTAS) * 2\n\n  while q:\n    (r, c), current_dir, path = q.popleft()\n\n    # Pruning: If the current path is excessively long, it's likely inefficient or means the goal is unreachable.\n    if len(path) > max_search_length:\n      continue\n\n    # --- Goal Check ---\n    # Check if the current (position, direction) state allows for collecting the primitive.\n    \n    if requires_use_action:\n      # If 'USE' is required, the agent must be facing the primitive.\n      # Calculate the coordinates of the cell directly in front of the agent.\n      dr_front, dc_front = _DIR_TO_DELTA[current_dir]\n      nr_front, nc_front = r + dr_front, c + dc_front\n\n      # Verify if the cell in front is within grid boundaries and contains the primitive.\n      if (0 <= nr_front < WIDTH and 0 <= nc_front < HEIGHT and\n              current_state.grid[nr_front, nc_front, primitive_idx] == 1):\n        # Goal reached: primitive found in front, append 'USE' action and return the path.\n        return path + [USE_ACT]\n    else:\n      # If 'USE' is NOT required (e.g., for workshops or boundaries),\n      # being adjacent to (or on the same cell as) the primitive is sufficient.\n      # Check the 3x3 neighborhood around the agent's current position (including current cell).\n      for dr_nb in [-1, 0, 1]:\n        for dc_nb in [-1, 0, 1]:\n          nr_nb, nc_nb = r + dr_nb, c + dc_nb\n          \n          # Check if the neighbor cell is within grid bounds.\n          if 0 <= nr_nb < WIDTH and 0 <= nc_nb < HEIGHT:\n            # Check if the primitive exists at the neighbor cell (or current cell).\n            if current_state.grid[nr_nb, nc_nb, primitive_idx] == 1:\n              # Goal reached: primitive found adjacent or at current position. Return the path.\n              return path\n\n    # --- Explore Neighbors (Movement Actions) ---\n    # Iterate through possible movement actions to find next states to explore.\n    for action_id, (dr, dc) in _MOVE_DELTAS.items():\n      nr, nc = r + dr, c + dc # Calculate the new position after performing this move.\n      new_dir = _ACTION_TO_NEW_DIR[action_id] # Determine the new facing direction.\n\n      # Check if the new position is within the grid boundaries.\n      if not (0 <= nr < WIDTH and 0 <= nc < HEIGHT):\n        continue\n\n      # Check if this specific (position, direction) state has already been visited to avoid cycles.\n      if (nr, nc, new_dir) in visited:\n        continue\n\n      # Determine if the new position is traversable (i.e., does not contain impassable objects).\n      is_traversable = True\n      for impassable_k_idx in impassable_object_indices:\n        # Special handling for when the 'primitive' itself is an impassable object (e.g., WORKSHOP):\n        # If we don't need to 'USE' it (meaning we just need to get adjacent or onto it),\n        # then we *can* move onto that tile. This allows agents to path onto workshop tiles.\n        if impassable_k_idx == primitive_idx and not requires_use_action:\n            continue # Skip the impassability check for the target primitive if it's non-grabbable.\n        \n        # If the cell contains any other impassable object (e.g., a wall, water if not swimmable),\n        # it is not traversable.\n        if current_state.grid[nr, nc, impassable_k_idx] == 1:\n          is_traversable = False\n          break\n      \n      if not is_traversable:\n        continue # Cannot move into an impassable cell.\n\n      # If the new state (position, direction) is valid and traversable, add it to the queue\n      # for further exploration and mark it as visited.\n      visited.add((nr, nc, new_dir))\n      q.append(((nr, nc), new_dir, path + [action_id]))\n\n  # If the BFS completes and the queue becomes empty without finding a path to collect the primitive,\n  # it means the primitive is unreachable from the current state. Return an empty list.\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T03:37:21.228059", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` with refined walkability logic.\n    Returns a list of actions to find and collect the primitive in the passed env.\n    \n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect.\n\n    Returns:\n        List[int]: A sequence of action indices to execute.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's starting (row, col) tuple\n  initial_dir = current_state.dir # Agent's starting direction (int: 0=RIGHT, 1=UP, 2=LEFT, 3=DOWN)\n\n  # Convert the string name of the primitive (e.g., \"WOOD\") to its integer ID.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Get grid dimensions (WIDTH, HEIGHT) from the initial_grid shape.\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # Early exit: If the primitive is not grabbable (e.g., a workshop, boundary, or water),\n  # it cannot be \"collected\" in the sense of picking it up into inventory.\n  # The `grabbable_indices` provides the definitive list of items that can be picked up.\n  if primitive_id not in current_state.world.grabbable_indices:\n      return []\n\n  # Retrieve the mapping from action names (strings) to their integer codes.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']   # 'UP' action typically means 'move forward' relative to agent's facing\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']            # The action to collect or interact with an item.\n\n  # Define how agent's (row, col) coordinates change when moving forward for each direction.\n  # This is also used to determine the coordinates of the cell directly in front of the agent.\n  # Direction (key) -> (delta_row, delta_col)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT (0): cell in front is (r, c+1)\n      1: (-1, 0),  # Facing UP (1): cell in front is (r-1, c)\n      2: (0, -1),  # Facing LEFT (2): cell in front is (r, c-1)\n      3: (1, 0)    # Facing DOWN (3): cell in front is (r+1, c)\n  }\n\n  # Define how agent's direction changes when turning left or right.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Define entities that explicitly block agent movement.\n  # In CraftWorld, \"water\" and \"boundary\" are generally unwalkable terrain.\n  # Workshops, although non-grabbable, are typically walkable locations.\n  unwalkable_entities_ids = {current_state.world.water_index}\n  # Boundary checks are implicitly handled by checking (0 <= next_r < WIDTH) etc.\n\n  # BFS Initialization:\n  # The queue stores tuples: ((agent_position_tuple, agent_direction_int), list_of_actions_to_reach_this_state).\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # The 'visited' set stores (position, direction) pairs to prevent redundant exploration and cycles.\n  visited = {(initial_pos, initial_dir)}\n\n  shortest_path_to_target_state = None # To store the path when a goal state is found.\n\n  # Main BFS Loop\n  while queue:\n      # Dequeue the current agent state and the sequence of actions that led to it.\n      (current_r, current_c), current_dir = queue.popleft()\n      path_actions = queue.popleft() # Updated to be correctly popped\n\n      # --- Goal Check: Is the primitive directly in front of the agent? ---\n      # Calculate the coordinates of the cell directly in front of the agent.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      target_r_in_front, target_c_in_front = current_r + front_dr, current_c + front_dc\n\n      # Check if the cell in front is within grid bounds AND contains the primitive.\n      if (0 <= target_r_in_front < WIDTH and 0 <= target_c_in_front < HEIGHT and\n          initial_grid[target_r_in_front, target_c_in_front, primitive_id] > 0):\n          # Found the shortest path (movement and turn actions) to a state\n          # from which the primitive can be collected (by a 'USE' action).\n          shortest_path_to_target_state = path_actions\n          break # Goal reached, terminate BFS as we want the shortest path.\n\n      # --- Explore Possible Next Actions (Move Forward, Turn Left, Turn Right) ---\n\n      # 1. Try MOVE_FORWARD_ACTION:\n      # Calculate the agent's next position if it moves one step forward.\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r_move, next_c_move = current_r + move_dr, current_c + move_dc\n      next_pos_move = (next_r_move, next_c_move)\n      next_dir_move = current_dir # Agent's direction remains unchanged when moving forward.\n\n      # Check if the potential next state is valid (within bounds and unvisited).\n      if (0 <= next_r_move < WIDTH and 0 <= next_c_move < HEIGHT and\n          (next_pos_move, next_dir_move) not in visited):\n          \n          # Determine if the cell at `next_pos_move` is walkable (i.e., not an obstacle).\n          is_walkable_cell = True\n          # Check if the cell contains any explicitly unwalkable entity (e.g., water).\n          for entity_idx in unwalkable_entities_ids:\n              if initial_grid[next_r_move, next_c_move, entity_idx] > 0:\n                  is_walkable_cell = False\n                  break\n          \n          # Important note for CraftWorld: The agent *can* walk onto cells containing\n          # grabbable primitives (like WOOD, GRASS) or non-grabbable but walkable entities\n          # (like WORKSHOPs). We only block movement for true obstacles like water.\n\n          if is_walkable_cell:\n              visited.add((next_pos_move, next_dir_move)) # Mark the new state as visited.\n              # Add the new state and its accumulated path to the BFS queue.\n              queue.append((\n                  (next_pos_move, next_dir_move),\n                  path_actions + [MOVE_FORWARD_ACTION]\n              ))\n\n      # 2. Try TURN_LEFT_ACTION:\n      # Calculate the agent's new direction after turning left. Position remains the same.\n      next_dir_turn_left = TURN_LEFT_MAP[current_dir]\n      if ((current_r, current_c), next_dir_turn_left) not in visited:\n          visited.add(((current_r, current_c), next_dir_turn_left))\n          queue.append((\n              ((current_r, current_c), next_dir_turn_left),\n              path_actions + [TURN_LEFT_ACTION]\n          ))\n\n      # 3. Try TURN_RIGHT_ACTION:\n      # Calculate the agent's new direction after turning right. Position remains the same.\n      next_dir_turn_right = TURN_RIGHT_MAP[current_dir]\n      if ((current_r, current_c), next_dir_turn_right) not in visited:\n          visited.add(((current_r, current_c), next_dir_turn_right))\n          queue.append((\n              ((current_r, current_c), next_dir_turn_right),\n              path_actions + [TURN_RIGHT_ACTION]\n          ))\n\n  # --- Final Action Sequence Assembly ---\n  # If a path was successfully found to a state where the primitive is in front,\n  # append the final 'USE' action to the sequence of movement and turn actions.\n  if shortest_path_to_target_state is not None:\n      actions_list.extend(shortest_path_to_target_state)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-08-01T03:37:22.340481", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\"\"\"\n  \"\"\"Returns a list of actions to find and collect the primitive in the passed env.\n    This version assumes the 'USE' action works on the cell directly in front of the agent.\n    It corrects the walkability logic to ensure the agent does not pathfind *onto* the primitive\n    it intends to collect, as it needs to be adjacent and facing it for the USE action.\n    \n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect.\n\n    Returns:\n        List[int]: A sequence of action indices to execute.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (r, c)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # Early exit: If the primitive is not something that can be picked up, return empty list.\n  if primitive_id not in current_state.world.grabbable_indices:\n      return []\n\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP'] # 'UP' action typically means 'move forward' relative to agent's facing\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Mapping for agent's facing direction to (delta_row, delta_col) for movement and looking forward.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1) is in front\n      1: (-1, 0),  # Facing UP: (row-1, col) is in front\n      2: (0, -1),  # Facing LEFT: (row, col-1) is in front\n      3: (1, 0)    # Facing DOWN: (row+1, col) is in front\n  }\n\n  # Mappings for changing agent's direction when turning.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # Identify entity kinds that completely block agent movement (e.g., BOUNDARY, WATER, WORKSHOP_X).\n  # These are static obstacles the agent cannot pass through.\n  non_walkable_fixed_obstacles = current_state.world.non_grabbable_indices\n\n  # BFS initialization: queue stores ((current_pos_tuple, current_dir_int), list_of_actions_to_reach_here).\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set to avoid cycles and redundant paths: stores (current_pos_tuple, current_dir_int).\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # Will store the sequence of actions leading to the goal state.\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # Goal Check: Is the primitive directly in front of the agent at its current state?\n      # The 'USE' action is assumed to apply to the cell directly in front.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      target_r_in_front, target_c_in_front = r + front_dr, c + front_dc\n\n      is_primitive_in_front = False\n      if (0 <= target_r_in_front < WIDTH and 0 <= target_c_in_front < HEIGHT and\n          initial_grid[target_r_in_front, target_c_in_front, primitive_id] > 0):\n          is_primitive_in_front = True\n\n      if is_primitive_in_front:\n          target_path = path_actions\n          break # Shortest path to a suitable position and direction found.\n\n      # Explore possible next actions: Move Forward, Turn Left, Turn Right\n      \n      # 1. Try MOVE_FORWARD_ACTION:\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction.\n\n      # Check if the next position is within grid bounds and this state hasn't been visited.\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT and\n          (next_pos, next_dir) not in visited):\n          \n          is_walkable = True\n          # Check for fixed obstacles that prevent movement.\n          for kind_idx in non_walkable_fixed_obstacles:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          \n          # v2 Improvement: A cell containing the *target primitive* itself is also NOT walkable.\n          # The agent needs to stand *adjacent* to the primitive to 'USE' it, not on top of it.\n          if is_walkable and initial_grid[next_r, next_c, primitive_id] > 0:\n              is_walkable = False\n\n          if is_walkable:\n              visited.add((next_pos, next_dir)) # Mark the new state as visited.\n              # Add the new state and its accumulated path to the BFS queue.\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # 2. Try TURN_LEFT_ACTION:\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # 3. Try TURN_RIGHT_ACTION:\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path was found to a position where the primitive can be collected (i.e., it's in front),\n  # append the final 'USE' action to the sequence of movement and turn actions.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T03:38:35.862822", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  ACTION_UP = action_map[\"UP\"]\n  ACTION_DOWN = action_map[\"DOWN\"]\n  ACTION_LEFT = action_map[\"LEFT\"]\n  ACTION_RIGHT = action_map[\"RIGHT\"]\n  ACTION_USE = action_map[\"USE\"]\n\n  # Get current state details\n  current_state = env._current_state\n  current_grid = current_state.grid\n  # Agent's position is a tuple (float, float), convert to int for grid indexing\n  current_pos_x, current_pos_y = int(current_state.pos[0]), int(current_state.pos[1])\n  grid_width, grid_height, _ = current_grid.shape\n\n  # Get the integer ID for the target primitive from the cookbook index.\n  # Use .lower() as internal names are typically lowercase.\n  try:\n    primitive_idx = env.world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # Primitive name not found in the environment's cookbook, cannot collect.\n    return []\n\n  # Determine properties of the target primitive\n  is_grabbable_item = primitive_idx in env.world.grabbable_indices\n  is_workshop_item = primitive_idx in env.world.workshop_indices # Check if it's a workshop (e.g., WORKSHOP0)\n\n  # Define entities that block agent movement.\n  # Start with all non-grabbable entities, then remove workshops, as they are traversable.\n  blocking_entities = set(env.world.non_grabbable_indices) - set(env.world.workshop_indices)\n  \n  # Ensure \"boundary\" is considered a blocking entity if it's indexed.\n  try:\n      boundary_idx = env.world.cookbook.index[\"boundary\"]\n      blocking_entities.add(boundary_idx)\n  except KeyError:\n      pass # Boundary might not be in the index in some scenarios\n\n  # Helper function to check if a cell is traversable by the agent\n  def is_traversable(x, y):\n    # Check if the position is within grid boundaries\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    \n    # Check if the cell contains any entity that explicitly blocks movement\n    for block_idx in blocking_entities:\n      if current_grid[x, y, block_idx] > 0:\n        return False\n            \n    # If no blocking entities are found, the cell is traversable.\n    # Workshops are inherently traversable because they were removed from `blocking_entities`.\n    return True\n\n  # Define cardinal movement offsets and their corresponding actions\n  move_offsets = [\n      (0, -1, ACTION_UP),    # North (decrement y)\n      (0, 1, ACTION_DOWN),   # South (increment y)\n      (-1, 0, ACTION_LEFT),  # West (decrement x)\n      (1, 0, ACTION_RIGHT)   # East (increment x)\n  ]\n\n  # Step 1: Find all grid locations where the primitive exists.\n  primitive_grid_locations = []\n  for x in range(grid_width):\n    for y in range(grid_height):\n      if current_grid[x, y, primitive_idx] > 0:\n        primitive_grid_locations.append((x, y))\n\n  if not primitive_grid_locations:\n    return [] # Primitive not found anywhere on the grid\n\n  # Step 2: Determine the set of target cells where the agent needs to stand\n  # to interact with or pick up the primitive.\n  target_agent_standing_locations = set()\n\n  if is_grabbable_item:\n    # For grabbable items (e.g., WOOD, IRON), the agent needs to stand *on* the item's cell.\n    for px, py in primitive_grid_locations:\n      if is_traversable(px, py): # Ensure agent can actually move onto this cell\n        target_agent_standing_locations.add((px, py))\n  elif primitive.lower() in [\"water\", \"stone\"]:\n    # For specific non-grabbable but interactive resources (WATER, STONE),\n    # the agent needs to stand *adjacent* to them (cardinal neighbors).\n    for px, py in primitive_grid_locations:\n      for dx, dy, _ in move_offsets: # Iterate through cardinal neighbors of the primitive's location\n        nx, ny = px + dx, py + dy\n        if is_traversable(nx, ny): # Ensure agent can stand on this adjacent cell\n          target_agent_standing_locations.add((nx, ny))\n  elif is_workshop_item:\n    # For workshops, the agent needs to stand *on* the workshop cell.\n    for px, py in primitive_grid_locations:\n      if is_traversable(px, py): # Workshops are defined as traversable by `is_traversable`\n        target_agent_standing_locations.add((px, py))\n  # For other non-collectable primitives (like BOUNDARY if it could be a target),\n  # target_agent_standing_locations will remain empty, leading to an empty path.\n\n  if not target_agent_standing_locations:\n    return [] # No reachable target location found for the primitive\n\n  # Step 3: Perform a Breadth-First Search (BFS) to find the shortest path\n  # from the agent's current position to any of the target standing locations.\n  q = collections.deque()\n  visited = set() # Stores (x, y) tuples of visited cells\n\n  # Start BFS from the agent's current position\n  start_pos_tuple = (current_pos_x, current_pos_y)\n  q.append((start_pos_tuple, [])) # Queue stores ((x, y), [actions_to_reach_here])\n  visited.add(start_pos_tuple)\n\n  shortest_path_actions = []\n  found_path = False\n\n  while q:\n    (x, y), actions_so_far = q.popleft()\n\n    # If the current cell is one of our target standing locations, we found a path\n    if (x, y) in target_agent_standing_locations:\n      found_path = True\n      shortest_path_actions = actions_so_far\n      break # Found the shortest path, no need to continue BFS\n\n    # Explore valid neighbors\n    for dx, dy, action_move in move_offsets:\n      nx, ny = x + dx, y + dy\n\n      # Check if neighbor is within bounds, not visited, and traversable\n      if (nx, ny) not in visited and is_traversable(nx, ny):\n        visited.add((nx, ny))\n        q.append(((nx, ny), actions_so_far + [action_move]))\n\n  final_actions = []\n  if found_path:\n    final_actions.extend(shortest_path_actions)\n    \n    # After reaching the target cell, add the USE action if required for collection.\n    # This applies to grabbable items and interactive resources like water/stone.\n    # Workshops do not typically require a USE action for \"collection\" (just for crafting).\n    if is_grabbable_item or primitive.lower() in [\"water\", \"stone\"]:\n      final_actions.append(ACTION_USE)\n\n  return final_actions", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T03:38:37.293808", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  ACTION_UP = action_map[\"UP\"]\n  ACTION_DOWN = action_map[\"DOWN\"]\n  ACTION_LEFT = action_map[\"LEFT\"]\n  ACTION_RIGHT = action_map[\"RIGHT\"]\n  ACTION_USE = action_map[\"USE\"]\n\n  # Get current state details\n  current_state = env._current_state\n  current_grid = current_state.grid\n  # Agent's position is a tuple, convert to int for grid indexing\n  start_pos = (int(current_state.pos[0]), int(current_state.pos[1]))\n  grid_width, grid_height, _ = current_grid.shape\n\n  # Get the integer ID for the target primitive from the cookbook index.\n  try:\n    primitive_idx = env.world.cookbook.index.index(primitive.lower())\n  except KeyError:\n    # Primitive name not found in the environment's cookbook, cannot collect.\n    return []\n\n  # Determine primitive interaction type\n  is_grabbable_item = primitive_idx in env.world.grabbable_indices\n  is_water_or_stone = (primitive_idx == env.world.water_index or\n                       primitive_idx == env.world.stone_index)\n  is_workshop = primitive_idx in env.world.workshop_indices\n  \n  # A primitive like \"boundary\" is not typically \"collectable\" or \"useable\" in this context.\n  # If the goal is \"boundary\", just return empty actions.\n  try:\n    if primitive_idx == env.world.cookbook.index.index(\"boundary\"):\n      return []\n  except KeyError:\n    pass # Boundary might not always be present or indexed\n\n  # Define cardinal movement offsets and their corresponding actions\n  move_offsets = [\n      (0, -1, ACTION_UP),    # (dx, dy, action) for North (decrement y)\n      (0, 1, ACTION_DOWN),   # for South (increment y)\n      (-1, 0, ACTION_LEFT),  # for West (decrement x)\n      (1, 0, ACTION_RIGHT)   # for East (increment x)\n  ]\n\n  # Helper function to check if a cell is traversable by the agent.\n  # An agent can move onto a cell if it's within bounds and doesn't contain\n  # blocking non-grabbable entities (excluding workshops, which are traversable).\n  def is_traversable(x, y):\n    # Check if the position is within grid boundaries\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    \n    # Check for blocking entities at the cell (x, y).\n    # A cell is blocked if it contains any non-grabbable item\n    # AND that item is NOT one of the workshops (workshops are interactive but traversable).\n    for kind_id in env.world.non_grabbable_indices:\n        if current_grid[x, y, kind_id] > 0 and kind_id not in env.world.workshop_indices:\n            return False # This cell contains a non-traversable obstacle\n    \n    return True # The cell is traversable\n\n  # Step 1: Find all grid locations where the primitive currently exists.\n  primitive_grid_locations = []\n  for x in range(grid_width):\n    for y in range(grid_height):\n      if current_grid[x, y, primitive_idx] > 0:\n        primitive_grid_locations.append((x, y))\n\n  if not primitive_grid_locations:\n    return [] # Primitive not found anywhere on the grid\n\n  # Step 2: Determine the set of target cells where the agent needs to stand\n  # to interact with or pick up the primitive.\n  target_agent_standing_locations = set()\n\n  # Populate target_agent_standing_locations based on primitive interaction type\n  for px, py in primitive_grid_locations:\n    if is_grabbable_item or is_workshop:\n      # For grabbable items (e.g., WOOD) or workshops, the agent needs to stand *on* their cell.\n      if is_traversable(px, py):\n        target_agent_standing_locations.add((px, py))\n    elif is_water_or_stone:\n      # For resources like WATER or STONE, the agent needs to stand *adjacent* to them.\n      for dx, dy, _ in move_offsets: # Iterate through cardinal neighbors of the primitive's location\n        nx, ny = px + dx, py + dy\n        if is_traversable(nx, ny): # Ensure the adjacent cell is traversable\n          target_agent_standing_locations.add((nx, ny))\n    # For other non-interactive primitive types (e.g., boundary),\n    # target_agent_standing_locations will not be populated, which is correct.\n\n  if not target_agent_standing_locations:\n    return [] # No reachable target location found for the primitive\n\n  # Step 3: Perform a Breadth-First Search (BFS) to find the shortest path\n  # from the agent's current position to any of the target standing locations.\n  q = collections.deque()\n  visited = set() # Stores (x, y) tuples of visited cells to prevent cycles and redundant exploration\n\n  # Start BFS from the agent's current position\n  q.append((start_pos, [])) # Queue stores ((x, y), [actions_to_reach_here])\n  visited.add(start_pos)\n\n  shortest_path_actions = []\n  found_path = False\n\n  while q:\n    (x, y), actions_so_far = q.popleft()\n\n    # If the current cell is one of our target standing locations, we found a path\n    if (x, y) in target_agent_standing_locations:\n      found_path = True\n      shortest_path_actions = actions_so_far\n      break # Found the shortest path, no need to continue BFS\n\n    # Explore valid neighbors (possible next moves)\n    for dx, dy, action_move in move_offsets:\n      nx, ny = x + dx, y + dy\n      next_pos = (nx, ny)\n\n      # Check if neighbor is within bounds, not visited, and traversable\n      if next_pos not in visited and is_traversable(nx, ny):\n        visited.add(next_pos)\n        q.append((next_pos, actions_so_far + [action_move]))\n\n  final_actions = []\n  if found_path:\n    final_actions.extend(shortest_path_actions)\n    \n    # After reaching the target cell, append the USE action to interact with/collect the primitive.\n    # This is applicable for grabbable items, mineable resources, and workshops.\n    final_actions.append(ACTION_USE)\n\n  return final_actions", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T03:39:44.089012", "function_name": "collect", "function_body": "  \"\"\"Finds the shortest sequence of actions to move the agent to a position adjacent\n  to the specified primitive, facing it, and then performing a 'USE' action to collect it.\n  \n  This version refines pathfinding logic by explicitly clarifying what constitutes an unwalkable cell\n  for the purpose of reaching and collecting an item.\n\n    Args:\n        env (env.CraftLab): The CraftLab object containing the current state.\n        primitive (str): The name of the primitive resource to collect.\n\n    Returns:\n        List[int]: A sequence of action indices to execute to collect the primitive.\n                   Returns an empty list if the primitive is not found or reachable.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's initial position (row, col)\n  initial_dir = current_state.dir # Agent's initial facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook's index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Determine grid dimensions\n  num_rows, num_cols, _ = initial_grid.shape\n\n  # Retrieve action mapping from the environment\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction vectors (dr, dc) for agent's facing direction\n  # (dr, dc) indicates how row and column change when moving \"forward\"\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # Mapping for updating agent's direction when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # RIGHT->UP->LEFT->DOWN->RIGHT\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # RIGHT->DOWN->LEFT->UP->RIGHT\n\n  # Get indices of entities that are inherently non-walkable (e.g., BOUNDARY, WATER, WORKSHOP_X).\n  # These are defined by the world configuration as unpassable terrain or fixed objects.\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # BFS initialization:\n  # Queue stores ( (current_position_tuple, current_direction_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (position_tuple, direction_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the sequence of actions to reach the state where the primitive is in front\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent from the current state.\n      # This is the desired pre-condition for executing the 'USE' action.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the cell in front is within grid boundaries\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n          # If the primitive is present in this cell, we've found our target adjacent state.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Path found! The agent is positioned adjacent to and facing the primitive.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right\n\n      # Attempt to Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Direction does not change when moving forward\n\n      # Check if the next position is within bounds and this (position, direction) state hasn't been visited\n      if (0 <= next_r < num_rows and 0 <= next_c < num_cols and\n          (next_pos, next_dir) not in visited):\n          \n          # Determine if the next cell is walkable for the agent.\n          # A cell is considered non-walkable if:\n          #   a) It contains the target primitive itself. Agent collects by standing next to it, not on it.\n          #   b) It contains any entity specified in `non_walkable_kinds_indices`\n          #      (e.g., BOUNDARY, WATER, or certain WORKSHOP types that are fixed terrain).\n          is_walkable = not (\n              initial_grid[next_r, next_c, primitive_id] > 0 or\n              any(initial_grid[next_r, next_c, kind_idx] > 0 for kind_idx in non_walkable_kinds_indices)\n          )\n\n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Attempt to Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Attempt to Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path to the target adjacent state was found, append the USE action to complete the collection\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T03:39:45.212214", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  \n  # Extract immutable state information for BFS planning\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's initial position (row, col)\n  initial_dir = current_state.dir # Agent's initial facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook's index\n  # This mapping is crucial for identifying the target on the grid.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Determine grid dimensions for boundary checks\n  num_rows, num_cols, _ = initial_grid.shape\n\n  # Retrieve action mapping from the environment (these are constant action IDs)\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # In CraftWorld, 'UP' means move forward in current direction\n  TURN_LEFT_ACTION = action_map['LEFT']     # Turn 90 degrees left\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Turn 90 degrees right\n  USE_ACTION = action_map['USE']            # Interact with the cell in front\n\n  # Define direction vectors for movement and turning rules (constants for agent's movement mechanics)\n  # DIR_TO_DRDC: Maps agent's current direction (0-3) to a (delta_row, delta_column) vector\n  # which indicates the cell directly in front of the agent.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # TURN_LEFT_MAP / TURN_RIGHT_MAP: Map current direction to the new direction after a turn.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # RIGHT->UP->LEFT->DOWN->RIGHT\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # RIGHT->DOWN->LEFT->UP->RIGHT\n\n  # Get indices of entities that block agent movement (e.g., BOUNDARY, WATER, WORKSHOP_X).\n  # The agent cannot walk onto these cells.\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # BFS initialization:\n  # The queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_here)\n  # This represents a state (agent's position and orientation) and the path to achieve it.\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # The 'visited' set stores (position_tuple, direction_int) to prevent redundant exploration\n  # and cycles, ensuring the shortest path is found.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This variable will store the action sequence if a path is found.\n\n  # Start BFS traversal\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # Check if the target primitive is directly in front of the agent from the current state.\n      # This is the \"goal state\" for our pathfinding: being positioned to interact with the primitive.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the cell directly in front is within grid boundaries before checking its contents.\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n          # If the primitive is present in this cell, we have found a path that leads the agent\n          # to be adjacent to and facing the primitive.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Path found! Terminate BFS.\n\n      # Explore all possible next actions (Move Forward, Turn Left, Turn Right) from the current state.\n\n      # --- Try Move Forward Action ---\n      # Calculate the next position if the agent moves forward. Direction remains unchanged.\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change orientation.\n\n      # Check if the next position is within bounds and this new (position, direction) state\n      # has not been visited yet.\n      if (0 <= next_r < num_rows and 0 <= next_c < num_cols and\n          (next_pos, next_dir) not in visited):\n          \n          # Determine if the next cell is walkable.\n          # The agent cannot walk onto:\n          # 1. The primitive itself (interaction is from an adjacent square, not by stepping on it).\n          # 2. Any non-grabbable entities (like boundaries, water, or specific workshops that are impassable).\n          is_walkable = not (\n              initial_grid[next_r, next_c, primitive_id] > 0 or\n              any(initial_grid[next_r, next_c, kind_idx] > 0 for kind_idx in non_walkable_kinds_indices)\n          )\n\n          if is_walkable:\n              # If walkable, add the new state to the queue and mark it as visited.\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # --- Try Turn Left Action ---\n      # Calculate the new direction after turning left. Position remains unchanged.\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      if ((current_pos, next_dir_left) not in visited):\n          # Add the new state to the queue and mark as visited.\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # --- Try Turn Right Action ---\n      # Calculate the new direction after turning right. Position remains unchanged.\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      if ((current_pos, next_dir_right) not in visited):\n          # Add the new state to the queue and mark as visited.\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # After BFS completes:\n  # If a path to the target (adjacent and facing the primitive) was found,\n  # extend the found path with the final 'USE' action to collect the primitive.\n  # If no path was found (target_path is None), an empty list is returned,\n  # indicating the primitive is unreachable from the current state.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T03:41:00.966758", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (r, c)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  # Get the integer ID for the target primitive from the cookbook index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # === Crucial Check: Ensure the primitive is actually grabbable ===\n  # The 'collect' function implies picking up an item into inventory.\n  # If the primitive cannot be picked up (e.g., WORKSHOP, WATER, BOUNDARY),\n  # then it cannot be \"collected\" in the sense of adding to inventory.\n  # `current_state.world.grabbable_indices` is the authoritative source for this.\n  if primitive_id not in current_state.world.grabbable_indices:\n      return [] # Return empty list if the item is not grabbable\n\n  # Retrieve action mapping from the environment's action specifications\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP'] # 'UP' in action_specs often maps to 'move forward'\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  # This helps calculate the next position when moving forward from (r, c).\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: move to (r, c+1)\n      1: (-1, 0),  # Facing UP: move to (r-1, c)\n      2: (0, -1),  # Facing LEFT: move to (r, c-1)\n      3: (1, 0)    # Facing DOWN: move to (r+1, c)\n  }\n\n  # Maps for updating the agent's direction when turning left/right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0} # R -> U -> L -> D -> R\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # R -> D -> L -> U -> R\n\n  # Identify non-walkable entities (e.g., BOUNDARY, WATER, WORKSHOP_X) that block agent movement.\n  # These are directly obtained from `non_grabbable_indices` in CraftWorld.\n  non_walkable_kind_indices = current_state.world.non_grabbable_indices\n\n  # Optimization: If the primitive is already within the 3x3 neighborhood of the agent's current position,\n  # no pathfinding is needed; just perform the 'USE' action.\n  # `CraftState.next_to` directly checks this condition.\n  if current_state.next_to(primitive_id):\n      return [USE_ACTION]\n\n  # Initialize Breadth-First Search (BFS) for finding the shortest path in terms of actions.\n  # Each state in the queue is represented as:\n  # ((current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_this_state)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # The 'visited' set keeps track of (position_tuple, direction_int) pairs that have been\n  # explored to avoid redundant computations and cycles, ensuring the shortest path is found.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # This will store the sequence of actions to reach a collectable position\n\n  # BFS Loop\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # Check if the current agent position (r, c) is a \"goal\" state for collection.\n      # A goal state means the target `primitive_id` is within the 3x3 neighborhood of (r, c).\n      # This re-implements the logic of `CraftState.next_to` relative to the current BFS state.\n      is_primitive_adjacent = False\n      for dr_check in [-1, 0, 1]:\n          for dc_check in [-1, 0, 1]:\n              check_r, check_c = r + dr_check, c + dc_check\n              # Ensure the cell being checked is within grid bounds and contains the primitive.\n              if (0 <= check_r < WIDTH and 0 <= check_c < HEIGHT and\n                  initial_grid[check_r, check_c, primitive_id] > 0):\n                  is_primitive_adjacent = True\n                  break # Primitive found in neighborhood\n          if is_primitive_adjacent:\n              break # Stop checking once found\n\n      if is_primitive_adjacent:\n          target_path_actions = path_actions # Shortest path to a collectable position found!\n          break # Terminate BFS\n\n      # Explore all possible next actions from the current state: Move Forward, Turn Left, Turn Right\n\n      # 1. Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if the potential next position is within grid bounds AND this (pos, dir) state hasn't been visited\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT and\n          (next_pos, next_dir) not in visited):\n          \n          # Determine if the next cell (next_r, next_c) is walkable.\n          # A cell is considered walkable if it is not occupied by any entity\n          # categorized as a non-walkable obstacle (e.g., boundary, water, workshops).\n          is_walkable_cell = True\n          for kind_idx in non_walkable_kind_indices:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable_cell = False # Found a non-walkable obstacle\n                  break\n          \n          # Note: Grabbable primitives (e.g., WOOD, GRASS) are generally not considered obstacles for movement.\n          # The agent can typically walk onto their cells. This logic correctly allows that.\n\n          if is_walkable_cell:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # 2. Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning changes direction but not position.\n      if (current_pos, next_dir_left) not in visited:\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # 3. Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning changes direction but not position.\n      if (current_pos, next_dir_right) not in visited:\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path to a collectable position was found, append the 'USE' action to perform the collection.\n  # If `target_path_actions` remains None, it means the primitive is unreachable, and an empty list is returned.\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T03:41:02.143205", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (r, c)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  # Get the integer ID for the target primitive from the cookbook index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # Improvement for v2: Ensure the primitive is actually grabbable.\n  # The 'collect' function implies picking up an item into inventory.\n  # If the primitive is an entity that cannot be picked up (e.g., WORKSHOP, WATER, BOUNDARY,\n  # or specific environmental \"STONE\" that is not a collectible resource),\n  # it cannot be \"collected\". In such cases, return an empty list immediately.\n  # The `grabbable_indices` is the authoritative source for what can be picked up.\n  if primitive_id not in current_state.world.grabbable_indices:\n      return []\n\n  # Retrieve action mapping from the environment's action specifications\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP'] # 'UP' in action_specs typically implies moving forward\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  # This helps calculate the next position when moving forward\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: +1 to column (c)\n      1: (-1, 0),  # Facing UP: -1 to row (r)\n      2: (0, -1),  # Facing LEFT: -1 to column (c)\n      3: (1, 0)    # Facing DOWN: +1 to row (r)\n  }\n\n  # Maps for updating the agent's direction when turning left/right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0} # R -> U -> L -> D -> R\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # R -> D -> L -> U -> R\n\n  # Identify non-walkable entities (e.g., BOUNDARY, WATER, WORKSHOP_X) that block agent movement.\n  # These are derived from `non_grabbable_indices` because non-grabbable items generally block movement.\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # --- Nested Helper Functions for Readability and Modularity ---\n  def _is_cell_traversable(r, c):\n      \"\"\"Checks if a given grid cell (r, c) is within bounds and does not contain non-walkable entities.\n      \n      Args:\n          r (int): Row coordinate.\n          c (int): Column coordinate.\n      Returns:\n          bool: True if the cell can be entered by the agent, False otherwise.\n      \"\"\"\n      if not (0 <= r < WIDTH and 0 <= c < HEIGHT):\n          return False  # Out of bounds\n\n      # Check if the cell is occupied by any entity that blocks movement.\n      for kind_idx in non_walkable_kinds_indices:\n          if initial_grid[r, c, kind_idx] > 0:\n              return False  # Contains a blocking entity\n      return True\n\n  def _is_primitive_collectable_from_position(agent_r, agent_c):\n      \"\"\"Checks if the target primitive is in the 3x3 neighborhood of (agent_r, agent_c).\n      \n      Args:\n          agent_r (int): Agent's current row.\n          agent_c (int): Agent's current column.\n      Returns:\n          bool: True if the primitive is in the neighborhood and can be collected, False otherwise.\n      \"\"\"\n      for dr_check in [-1, 0, 1]:\n          for dc_check in [-1, 0, 1]:\n              check_r, check_c = agent_r + dr_check, agent_c + dc_check\n              if (0 <= check_r < WIDTH and 0 <= check_c < HEIGHT and\n                  initial_grid[check_r, check_c, primitive_id] > 0):\n                  return True\n      return False\n  # --- End of Nested Helper Functions ---\n\n  # Optimization: If the primitive is already in the 3x3 neighborhood of the agent's current position,\n  # no pathfinding is needed; just use the item. This leverages the CraftState's `next_to` method.\n  if current_state.next_to(primitive_id):\n      return [USE_ACTION]\n\n  # Initialize Breadth-First Search (BFS) for shortest path in terms of actions.\n  # Queue stores ( (current_position_tuple, current_direction_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (position_tuple, direction_int) to avoid redundant computations and cycles.\n  # This ensures we find the shortest path by not re-exploring states already visited with a shorter path.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the sequence of actions to reach a collectable position\n\n  # BFS Loop\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # Check if the current position is a \"goal\" state for collection.\n      # A goal state means the primitive is within the 3x3 neighborhood of the agent's current (r, c).\n      if _is_primitive_collectable_from_position(r, c):\n          target_path = path_actions # Shortest path found, terminate BFS\n          break\n\n      # Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right\n\n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if the next position is traversable and this (position, direction) state has not been visited\n      if _is_cell_traversable(next_r, next_c) and\\\n         (next_pos, next_dir) not in visited:\n          visited.add((next_pos, next_dir))\n          queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning changes direction but not position\n      if (current_pos, next_dir_left) not in visited:\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning changes direction but not position\n      if (current_pos, next_dir_right) not in visited:\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path to a collectable position was found, append the USE action to perform the collection.\n  # If no path is found (target_path remains None), an empty list is returned, indicating unreachability.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T03:42:03.840916", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's initial position (row, col)\n  initial_dir = current_state.dir # Agent's initial facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook's index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Determine grid dimensions: num_rows corresponds to grid.shape[0], num_cols to grid.shape[1]\n  num_rows, num_cols, _ = initial_grid.shape\n\n  # Retrieve action mapping from the environment\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction vectors (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # Mapping for updating agent's direction when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # Get indices of entities that block agent movement (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # Helper function to check if a given cell (r, c) is walkable by the agent\n  def is_cell_walkable(r: int, c: int) -> bool:\n      # Check if the cell is within grid boundaries\n      if not (0 <= r < num_rows and 0 <= c < num_cols):\n          return False\n      \n      # Check if the cell contains any non-walkable entity (like boundaries, water, workshops)\n      for kind_idx in non_walkable_kinds_indices:\n          if initial_grid[r, c, kind_idx] > 0:\n              return False\n      \n      # The agent cannot walk onto the primitive itself, as it needs to be \"used\" from an adjacent square.\n      # This prevents the agent from occupying the same space as the collectible item.\n      if initial_grid[r, c, primitive_id] > 0:\n          return False\n          \n      return True\n\n  # BFS initialization:\n  # Queue stores ( (current_position_tuple, current_direction_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (position_tuple, direction_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the sequence of actions to reach the state where the primitive is in front\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent from the current state.\n      # If it is, then the agent is in a position to use the USE_ACTION to collect it.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the cell in front is within grid boundaries\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n          # Check if the primitive is present in the cell directly in front\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Path found! The agent is adjacent and facing the primitive.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right\n\n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Direction doesn't change when moving forward\n\n      # Check if the next position is walkable and this (position, direction) state hasn't been visited\n      if is_cell_walkable(next_r, next_c) and (next_pos, next_dir) not in visited:\n          visited.add((next_pos, next_dir))\n          queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path to the target state was found, append the USE action to complete the collection\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION) # Add the final USE action to collect the primitive\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T03:42:05.198695", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's initial position (row, col)\n  initial_dir = current_state.dir # Agent's initial facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook's index\n  # This might raise KeyError if primitive is not in the index, assuming valid input from DSL.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Determine grid dimensions: num_rows corresponds to grid.shape[0], num_cols to grid.shape[1]\n  num_rows, num_cols, _ = initial_grid.shape\n\n  # Retrieve action mapping from the environment\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # Corresponds to moving forward in the current direction\n  TURN_LEFT_ACTION = action_map['LEFT']     # Corresponds to turning 90 degrees left\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Corresponds to turning 90 degrees right\n  USE_ACTION = action_map['USE']            # Action to interact with the cell in front\n\n  # Direction vectors (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  # (dr, dc) indicates how row and column change when moving \"forward\"\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # Mapping for updating agent's direction when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # RIGHT->UP->LEFT->DOWN->RIGHT\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # RIGHT->DOWN->LEFT->UP->RIGHT\n\n  # Get indices of entities that block agent movement (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  # Convert the set to a list once for efficient NumPy array indexing.\n  non_walkable_kinds_indices_list = list(current_state.world.non_grabbable_indices)\n\n  # BFS initialization:\n  # Queue stores ( (current_position_tuple, current_direction_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (position_tuple, direction_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the sequence of actions to reach the state where the primitive is in front\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent from the current state (ready for USE action)\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the cell in front is within grid boundaries\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n          # Check if the primitive is in this cell\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Path found! The agent is adjacent and facing the primitive.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right\n\n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Direction doesn't change when moving forward\n\n      # Check if the next position is within bounds and this (position, direction) state hasn't been visited\n      if (0 <= next_r < num_rows and 0 <= next_c < num_cols and\n          (next_pos, next_dir) not in visited):\n          \n          is_walkable = True\n          # Check if the next cell contains any non-walkable entity (e.g., BOUNDARY, WATER, WORKSHOP_X)\n          # by summing counts for all non-grabbable kinds at that cell.\n          # Only perform sum if there are non-walkable kinds defined to avoid error on empty list.\n          if non_walkable_kinds_indices_list and np.sum(initial_grid[next_r, next_c, non_walkable_kinds_indices_list]) > 0:\n              is_walkable = False\n          # Agent also cannot walk onto the primitive itself, as it needs to be \"used\" from an adjacent square\n          elif initial_grid[next_r, next_c, primitive_id] > 0:\n              is_walkable = False\n\n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path to the target state was found, append the USE action to complete the collection\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T03:42:45.824743", "function_name": "collect", "function_body": "", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-08-01T03:42:46.946589", "function_name": "collect", "function_body": "  current_state = env._current_state\n  primitive_idx = env.world.cookbook.index.index(primitive)\n  \n  # Get action mappings from the environment's action_specs\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # 1. If the agent is already next to the primitive, simply use it.\n  if current_state.next_to(primitive_idx):\n    return [USE]\n\n  # 2. Find all locations of the primitive on the grid.\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  all_primitive_locations = []\n  for x in range(grid_width):\n    for y in range(grid_height):\n      # Check if the primitive kind is present at this grid cell\n      if grid[x, y, primitive_idx] > 0:\n        all_primitive_locations.append((x, y))\n\n  if not all_primitive_locations:\n    # Primitive not found on the grid, return an empty action list.\n    return []\n\n  # 3. Determine all \"goal cells\" for the BFS. A goal cell is any cell\n  # from which the primitive can be collected (i.e., within its 3x3 neighborhood).\n  goal_cells = set()\n  for px, py in all_primitive_locations:\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        gx, gy = px + dx, py + dy\n        # Ensure the potential goal cell is within grid bounds\n        if 0 <= gx < grid_width and 0 <= gy < grid_height:\n          goal_cells.add((gx, gy))\n\n  # 4. Perform Breadth-First Search (BFS) to find the shortest path\n  # from the agent's current position to any of the goal cells,\n  # considering impassable terrain.\n  start_pos = current_state.pos\n  \n  q = collections.deque([(start_pos, [])]) # Queue stores (current_position, path_taken_actions)\n  visited = {start_pos} # Set to keep track of visited positions to avoid cycles\n\n  # Define possible moves (dx, dy) and their corresponding action indices\n  DELTAS_ACTIONS = [\n      ((0, -1), UP),    # Move Y- (Up)\n      ((0, 1), DOWN),   # Move Y+ (Down)\n      ((-1, 0), LEFT),  # Move X- (Left)\n      ((1, 0), RIGHT),  # Move X+ (Right)\n  ]\n\n  # Identify impassable kinds for movement.\n  # We assume items that are non-grabbable AND are NOT workshops are impassable.\n  impassable_kinds = set()\n  for idx in env.world.non_grabbable_indices:\n      # Check if this non-grabbable item is *not* a workshop\n      if idx not in env.world.workshop_indices:\n          impassable_kinds.add(idx)\n\n  while q:\n    (cx, cy), path = q.popleft()\n\n    # If the current position is a goal cell, we have found a path\n    if (cx, cy) in goal_cells:\n      # Return the path to this cell, followed by the USE action\n      return path + [USE]\n\n    # Explore valid neighboring cells\n    for (dx, dy), action in DELTAS_ACTIONS:\n      nx, ny = cx + dx, cy + dy\n      new_pos = (nx, ny)\n\n      # Check if the new position is within grid boundaries\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue\n\n      # Check for impassability: A cell is impassable if it contains\n      # any kind from the 'impassable_kinds' set.\n      is_impassable = False\n      # Iterate through all kinds that *might* be at (nx, ny) that are in impassable_kinds\n      for k_idx in impassable_kinds:\n          if grid[nx, ny, k_idx] > 0: # If this impassable kind is present at (nx, ny)\n              is_impassable = True\n              break\n      \n      if is_impassable:\n          continue # Cannot move to this cell, skip it\n\n      # If the new position has not been visited, add it to the queue\n      if new_pos not in visited:\n        visited.add(new_pos)\n        q.append((new_pos, path + [action]))\n\n  # If the BFS completes and no path to a goal cell is found,\n  # it means the primitive is unreachable, return an empty list.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T03:43:59.907228", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid # The grid state at the start of collection\n  initial_pos = current_state.pos # Agent's starting (row, col)\n  initial_dir = current_state.dir # Agent's starting direction (0:R, 1:U, 2:L, 3:D)\n\n  # Get the integer ID for the target primitive from the cookbook index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = initial_grid.shape # Get grid dimensions\n\n  # === Improvement for v2: Early exit if the primitive is not grabbable ===\n  # If the primitive cannot be picked up into inventory (e.g., it's a terrain feature like water or a workshop),\n  # return an empty list immediately, as it's not \"collectible\" in the sense of adding to inventory.\n  if primitive_id in current_state.world.non_grabbable_indices:\n      return []\n\n  # Get action mappings from the environment's action specifications\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define changes in (row, col) for each direction when moving forward\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT (0), moves in positive column (c+1)\n      1: (-1, 0),  # Facing UP (1), moves in negative row (r-1)\n      2: (0, -1),  # Facing LEFT (2), moves in negative column (c-1)\n      3: (1, 0)    # Facing DOWN (3), moves in positive row (r+1)\n  }\n\n  # Define how agent's direction changes for left/right turns\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # R(0)->U(1)->L(2)->D(3)->R(0)\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # R(0)->D(3)->L(2)->U(1)->R(0)\n\n  # Get indices of entities that block movement (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # BFS initialization: Queue stores ( (current_pos_tuple, current_dir_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (position, direction) tuples to prevent cycles and redundant exploration\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the action sequence if a target state is found\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Goal Check: Is the primitive directly in front of the agent in the current state?\n      # Calculate the coordinates of the cell directly in front of the agent\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the \"front\" cell is within grid bounds\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          # If the primitive exists in that front cell (and its count is > 0), we've reached a collectable state.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions # The actions to get to this (pos, dir) state\n              break # Found the path, exit BFS\n\n      # 2. Explore possible next actions: Move Forward, Turn Left, Turn Right\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir] # Delta for moving forward\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Direction does not change when moving forward\n\n      # Check if the next position is within bounds and this (position, direction) state hasn't been visited\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT and\n          (next_pos, next_dir) not in visited):\n          \n          # Check if the next position is walkable\n          is_walkable = True\n          # Agent cannot walk onto non-grabbable/blocking entities (e.g., boundaries, water, workshops).\n          for kind_idx in non_walkable_kinds_indices:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          # Agent also cannot walk onto the primitive itself to collect it; it must be adjacent\n          if is_walkable and initial_grid[next_r, next_c, primitive_id] > 0:\n              is_walkable = False\n\n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path was successfully found to a state where the primitive is in front,\n  # append the USE action to complete the collection.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T03:44:01.201288", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid # The grid state at the start of collection\n  initial_pos = current_state.pos # Agent's starting (row, col)\n  initial_dir = current_state.dir # Agent's starting direction (0:R, 1:U, 2:L, 3:D)\n\n  # Get the integer ID for the target primitive from the cookbook index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = initial_grid.shape # Get grid dimensions\n\n  # Improvement for v2: Check if the primitive is actually grabbable.\n  # If it's a non-grabbable entity (like WATER, BOUNDARY, WORKSHOPs),\n  # it cannot be \"collected\" into inventory. Return an empty list.\n  if primitive_id in current_state.world.non_grabbable_indices:\n      return [] # Cannot collect non-grabbable items.\n\n  # Get action mappings from the environment's action specifications\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define changes in (row, col) for each direction when moving forward\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT (0), moves in positive column (c+1)\n      1: (-1, 0),  # Facing UP (1), moves in negative row (r-1)\n      2: (0, -1),  # Facing LEFT (2), moves in negative column (c-1)\n      3: (1, 0)    # Facing DOWN (3), moves in positive row (r+1)\n  }\n\n  # Define how agent's direction changes for left/right turns\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # R(0)->U(1)->L(2)->D(3)->R(0)\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # R(0)->D(3)->L(2)->U(1)->R(0)\n\n  # Get indices of entities that block movement (e.g., BOUNDARY, WATER, WORKSHOP_X).\n  # These are considered non-walkable.\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # BFS initialization: Queue stores ( (current_pos_tuple, current_dir_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (position, direction) tuples to prevent cycles and redundant exploration\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the action sequence if a target state is found\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Goal Check: Is the primitive directly in front of the agent in the current state?\n      # Calculate the coordinates of the cell directly in front of the agent\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the \"front\" cell is within grid bounds\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          # If the primitive exists in that front cell (and its count is > 0), we've reached a collectable state\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions # The actions to get to this (pos, dir) state\n              break # Found the path, exit BFS\n\n      # 2. Explore possible next actions: Move Forward, Turn Left, Turn Right\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir] # Dr,Dc for moving forward\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Direction does not change when moving forward\n\n      # Check if the next position is within bounds and this (position, direction) state hasn't been visited\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT and\n          (next_pos, next_dir) not in visited):\n          \n          # Check if the next position is walkable\n          is_walkable = True\n          # Agent cannot walk onto non-grabbable/blocking entities.\n          for kind_idx in non_walkable_kinds_indices:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          \n          # Additionally, agent cannot walk onto the target primitive itself (if it's a grabbable item).\n          # It must be adjacent to it to USE. This is distinct from fixed non-grabbable terrain.\n          if is_walkable and initial_grid[next_r, next_c, primitive_id] > 0:\n              is_walkable = False\n\n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path was successfully found to a state where the primitive is in front,\n  # append the USE action to complete the collection.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T03:45:00.934845", "function_name": "collect", "function_body": "  actions = []\n\n  # 1. Get Primitive Index from the cookbook.\n  cookbook = env.world.cookbook\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # Primitive name not found in cookbook index, cannot collect it.\n    return []\n\n  # 2. Check if the primitive is grabbable. The 'collect' DSL command\n  #    is specifically for items that go into the inventory.\n  #    Workshops, water, boundaries etc. are not \"collected\" in this manner.\n  if primitive_idx not in env.world.grabbable_indices:\n    return []\n\n  # Get current state details\n  current_state = env._current_state\n  current_pos = current_state.pos\n  grid = current_state.grid\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Define cardinal directions and their corresponding actions for BFS\n  CARDINAL_DIRECTIONS = [\n      (-1, 0, craft.UP),    # North / UP\n      (1, 0, craft.DOWN),   # South / DOWN\n      (0, -1, craft.LEFT),  # West / LEFT\n      (0, 1, craft.RIGHT)   # East / RIGHT\n  ]\n\n  # Helper function to check if a cell (r, c) is traversable by the agent.\n  # Water is an impassable obstacle. Other non-grabbable entities (except workshops)\n  # are also considered obstacles.\n  def _is_traversable(r, c):\n    # Check bounds\n    if not (0 <= r < WIDTH and 0 <= c < HEIGHT):\n        return False\n\n    # Check for water, which is always an obstacle.\n    if grid[r, c, env.world.water_index] == 1:\n        return False\n\n    # Check for other non-grabbable items that are obstacles.\n    # Workshops (WORKSHOP0, WORKSHOP1, WORKSHOP2) are non-grabbable but are traversable.\n    # Stone or Boundary might be non-grabbable and non-traversable.\n    for kind_at_cell_idx in np.where(grid[r, c] == 1)[0]:\n        if kind_at_cell_idx in env.world.non_grabbable_indices and \\\n           kind_at_cell_idx not in env.world.workshop_indices:\n            # If it's a non-grabbable, and not a workshop, it's an obstacle.\n            # Water is already handled above.\n            if kind_at_cell_idx != env.world.water_index:\n                return False\n    return True\n\n  # 3. Immediate Collection Check: If the agent is already in a position\n  #    to collect the primitive, just return the 'USE' action.\n  #    `CraftState.next_to` checks if `primitive_idx` is in the 3x3 neighborhood.\n  if current_state.next_to(primitive_idx):\n    return [craft.USE]\n\n  # 4. Find all locations on the grid where the target primitive physically exists.\n  primitive_physical_locations = []\n  for r_p in range(WIDTH):\n    for c_p in range(HEIGHT):\n      if grid[r_p, c_p, primitive_idx] == 1:\n        primitive_physical_locations.append((r_p, c_p))\n\n  if not primitive_physical_locations:\n    # Primitive not found anywhere on the map.\n    return []\n\n  # 5. Identify all \"collectible agent spots\": these are traversable grid cells\n  #    from which the agent can successfully 'USE' to pick up the primitive.\n  #    A spot (r_agent, c_agent) is collectible if:\n  #    a) It is traversable.\n  #    b) There is a primitive_physical_location (r_p, c_p) within its 3x3 neighborhood.\n  collectible_agent_spots = set()\n  \n  # Offsets for a 3x3 neighborhood (including the center).\n  # This set of offsets aligns with `CraftState.next_to`'s check.\n  NEIGHBORHOOD_OFFSETS = [\n      (dr, dc) for dr in [-1, 0, 1] for dc in [-1, 0, 1]\n  ]\n\n  for r_p, c_p in primitive_physical_locations:\n    # For each primitive's physical location, iterate through its 3x3 neighborhood\n    # to find potential agent standing positions.\n    for dr_offset, dc_offset in NEIGHBORHOOD_OFFSETS:\n      r_agent, c_agent = r_p + dr_offset, c_p + dc_offset\n      \n      if _is_traversable(r_agent, c_agent):\n        collectible_agent_spots.add((r_agent, c_agent))\n\n  if not collectible_agent_spots:\n    # No traversable spots identified from which the agent can collect the primitive.\n    return []\n\n  # 6. Breadth-First Search (BFS) to find the shortest path from the current position\n  #    to any of the identified `collectible_agent_spots`.\n  queue = collections.deque([(current_pos, [])]) # (current_position, path_actions_to_reach_here)\n  visited = {current_pos}\n  path_to_collect_spot = None\n\n  while queue:\n    (r, c), current_path = queue.popleft()\n\n    # If the current position is one of our target collectible spots, we've found the path.\n    if (r, c) in collectible_agent_spots:\n      path_to_collect_spot = current_path\n      break\n\n    # Explore neighbors in cardinal directions\n    for dr, dc, action in CARDINAL_DIRECTIONS:\n      next_r, next_c = r + dr, c + dc\n      next_pos = (next_r, next_c)\n      \n      if _is_traversable(next_r, next_c) and next_pos not in visited:\n          visited.add(next_pos)\n          queue.append((next_pos, current_path + [action]))\n\n  # 7. Construct and return the final action sequence.\n  if path_to_collect_spot is not None:\n    # Move to the collectible spot, then 'USE' to pick up the primitive.\n    actions.extend(path_to_collect_spot)\n    actions.append(craft.USE)\n  \n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T03:45:02.055407", "function_name": "collect", "function_body": "  \"\"\"Returns a list of actions to find and collect the primitive in the passed env.\n    \n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect.\n\n    Returns:\n        List[int]: A sequence of action indices to execute.\n  \"\"\"\n  # 1. Initialize action list and retrieve necessary environment data.\n  actions = []\n  current_state = env._current_state\n  current_pos = current_state.pos\n  grid = current_state.grid\n  WIDTH, HEIGHT, _ = grid.shape\n  cookbook = env.world.cookbook\n\n  # 2. Map the primitive name (string) to its integer ID using the cookbook index.\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not recognized in the cookbook, it cannot be collected.\n    return []\n\n  # 3. Check if the target item is actually grabbable.\n  # The 'collect' DSL command is specifically designed for items that can be picked up\n  # and added to the inventory. Non-grabbable items (like workshops or environmental features)\n  # cannot be 'collected' in this manner.\n  if primitive_idx not in env.world.grabbable_indices:\n    return []\n\n  # 4. Define a helper function to determine if a grid cell is traversable by the agent.\n  # This is crucial for pathfinding, ensuring the agent doesn't try to move through obstacles.\n  def is_traversable(r: int, c: int) -> bool:\n    # Check if the coordinates are within the grid boundaries.\n    if not (0 <= r < WIDTH and 0 <= c < HEIGHT):\n      return False\n\n    # Check for impassable terrain: Water.\n    if grid[r, c, env.world.water_index] == 1:\n      return False\n\n    # Check for other non-grabbable obstacles. Workshops are typically traversable,\n    # so we exclude them from this obstacle check.\n    for kind_idx in np.where(grid[r, c] == 1)[0]: # Get all item kinds present at this cell\n      if kind_idx in env.world.non_grabbable_indices and \\\n         kind_idx != env.world.water_index and \\\n         kind_idx not in env.world.workshop_indices:\n        return False # This cell contains an unpassable non-grabbable obstacle.\n    return True\n\n  # 5. Immediate Collection Check: If the agent is already adjacent to (or on the same cell as)\n  # the primitive, only the 'USE' action is needed. The `CraftState.next_to` method efficiently\n  # checks the 3x3 neighborhood around the agent's current position.\n  if current_state.next_to(primitive_idx):\n    actions.append(craft.USE)\n    return actions\n\n  # 6. Locate all instances of the target primitive on the grid.\n  # This provides the possible targets for collection.\n  primitive_locations_on_grid = []\n  for r in range(WIDTH):\n    for c in range(HEIGHT):\n      if grid[r, c, primitive_idx] == 1:\n        primitive_locations_on_grid.append((r, c))\n\n  if not primitive_locations_on_grid:\n    # If no instances of the primitive are found on the map, it cannot be collected.\n    return []\n\n  # 7. Identify all \"collectible spots\": these are traversable grid cells from which\n  # the agent can perform the 'USE' action to collect the primitive. A collectible spot\n  # is any traversable cell within the 3x3 neighborhood of a primitive's actual location.\n  collectible_spots = set()\n  # Define relative offsets for a 3x3 neighborhood (including the center itself).\n  NEIGHBORHOOD_OFFSETS = [\n      (dr, dc) for dr in [-1, 0, 1] for dc in [-1, 0, 1]\n  ]\n\n  for pr, pc in primitive_locations_on_grid:\n    for dr, dc in NEIGHBORHOOD_OFFSETS:\n      potential_collect_r, potential_collect_c = pr + dr, pc + dc\n      if is_traversable(potential_collect_r, potential_collect_c):\n        collectible_spots.add((potential_collect_r, potential_collect_c))\n  \n  if not collectible_spots:\n    # If no traversable cells are found from which the primitive can be collected, it's unreachable.\n    return []\n\n  # 8. Perform a Breadth-First Search (BFS) to find the shortest sequence of actions\n  # to reach any of the identified collectible spots from the agent's current position.\n  queue = collections.deque([(current_pos, [])]) # Queue stores (current_position, path_taken_so_far)\n  visited = {current_pos} # Set to keep track of visited positions to avoid cycles and redundant checks.\n  \n  # Define cardinal movements and their corresponding action constants from the `craft` module.\n  CARDINAL_MOVES = [\n      ((-1, 0), craft.UP),    # Move North (row - 1, col) -> UP action\n      ((1, 0), craft.DOWN),   # Move South (row + 1, col) -> DOWN action\n      ((0, -1), craft.LEFT),  # Move West (row, col - 1) -> LEFT action\n      ((0, 1), craft.RIGHT)   # Move East (row, col + 1) -> RIGHT action\n  ]\n\n  path_to_collect_spot = None # Stores the action sequence to the first found collectible spot.\n\n  while queue:\n    (r, c), current_path = queue.popleft()\n\n    # If the current position is one of our target collectible spots, we've found the shortest path.\n    if (r, c) in collectible_spots:\n      path_to_collect_spot = current_path\n      break # Exit BFS as soon as the first (shortest) path is found.\n\n    # Explore neighboring cells reachable by cardinal movements.\n    for (dr, dc), action_move in CARDINAL_MOVES:\n      next_r, next_c = r + dr, c + dc\n      next_pos = (next_r, next_c)\n\n      # Only add to queue if the next position is within bounds, traversable, and not yet visited.\n      if next_pos not in visited and is_traversable(next_r, next_c):\n        visited.add(next_pos)\n        queue.append((next_pos, current_path + [action_move]))\n\n  # 9. Construct the final sequence of actions.\n  if path_to_collect_spot is not None:\n    actions.extend(path_to_collect_spot) # First, move to the collectible spot.\n    actions.append(craft.USE) # Then, perform the 'USE' action to collect the item.\n  \n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T03:45:26.788731", "function_name": "collect", "function_body": "  primitive_idx = env.world.cookbook.index.index(primitive)\n  current_state = env._current_state\n\n  # Improvement for collect_v2: Check if the primitive is already in inventory.\n  # If the agent already has the primitive, no collection actions are needed.\n  if current_state.inventory[primitive_idx] > 0:\n      return []\n\n  # Ensure the requested primitive is actually grabbable.\n  # If it's a non-grabbable entity (like \"water\", \"boundary\", or a \"workshop\"),\n  # it cannot be \"collected\" into inventory. In such cases, return an empty list.\n  if primitive_idx not in env.world.grabbable_indices:\n    return []\n\n  # The remaining logic is a BFS-based pathfinding, identical to collect_v1,\n  # which efficiently finds the shortest path to an adjacent grabbable primitive\n  # and includes the 'USE' action.\n\n  grid = current_state.grid\n  start_pos = current_state.pos # Agent's current position (x, y)\n  \n  grid_width, grid_height, _ = grid.shape\n\n  # Define movement actions and their corresponding (delta_x, delta_y)\n  # (x corresponds to column, y corresponds to row)\n  moves = {\n      craft.UP: (0, -1),   # Move up: y decreases\n      craft.DOWN: (0, 1),    # Move down: y increases\n      craft.LEFT: (-1, 0),   # Move left: x decreases\n      craft.RIGHT: (1, 0)    # Move right: x increases\n  }\n\n  # BFS setup\n  # Queue stores tuples of ((current_x, current_y), path_taken_so_far)\n  queue = collections.deque([(start_pos, [])])\n  # Set of visited positions to prevent cycles and redundant exploration\n  visited = {start_pos}\n\n  while queue:\n    (x, y), path = queue.popleft()\n\n    # Check if the target primitive is in the 3x3 neighborhood of the current position\n    # This directly implements the logic of CraftState.next_to(primitive_idx)\n    found_adjacent_primitive = False\n    for dx_adj in [-1, 0, 1]:\n      for dy_adj in [-1, 0, 1]:\n        nx_adj, ny_adj = x + dx_adj, y + dy_adj\n\n        # Check if the adjacent cell is within grid bounds\n        if 0 <= nx_adj < grid_width and 0 <= ny_adj < grid_height:\n          # Check if the primitive is present at this adjacent cell (count > 0)\n          if grid[nx_adj, ny_adj, primitive_idx] > 0:\n            found_adjacent_primitive = True\n            break # Found primitive in neighborhood, no need to check further adjacent cells\n      if found_adjacent_primitive:\n        break # Found primitive, break out of outer loop too\n\n    if found_adjacent_primitive:\n      # If the primitive is adjacent (and confirmed grabbable earlier),\n      # the next action should be USE to collect it.\n      return path + [craft.USE]\n\n    # Explore valid neighbors (UP, DOWN, LEFT, RIGHT) for movement\n    for action, (dx_move, dy_move) in moves.items():\n      next_x, next_y = x + dx_move, y + dy_move\n      next_pos = (next_x, next_y)\n\n      # Check validity of the next_pos:\n      # 1. Bounds check: Ensure new position is within the grid\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      # 2. Visited check: Avoid revisiting already explored positions to find shortest path\n      if next_pos in visited:\n        continue\n\n      # 3. Traversability check: Ensure the cell is not an obstacle.\n      # Obstacles are defined by non_grabbable_indices from CraftWorld.\n      is_obstacle = False\n      for k_idx in env.world.non_grabbable_indices:\n          if grid[next_x, next_y, k_idx] > 0:\n              is_obstacle = True\n              break\n      if is_obstacle:\n          continue # Cannot move into an obstacle cell\n\n      # If all checks pass, add the new position to the queue and mark as visited\n      visited.add(next_pos)\n      queue.append((next_pos, path + [action]))\n\n  # If the queue becomes empty and no path to the primitive was found\n  return []", "island_id": 7, "scores": {"3": 0.0}}
