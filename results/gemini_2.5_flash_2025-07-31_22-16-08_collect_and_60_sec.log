{"timestamp": "2025-08-01T11:13:19.842338", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set now includes the agent's inventory as part of the state key.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing, allowing BFS to distinguish\n  # between states that are identical in position/direction but differ in inventory (e.g., having a tool vs. not).\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # MAX_EXPLORED_STATES remains as a heuristic limit to prevent excessive computation.\n  # This value may need tuning based on environment size and complexity.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`).\n    if state.next_to(i_kind):\n        # Iterate over all 4 directions to see if the primitive is in an adjacent cell.\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the adjacent cell is within bounds and contains the primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Removed the general 'USE_ACT' exploration branch from `collect_v1`.\n    # In `collect_v1`, the `USE_ACT` was explored as a general action, even if it didn't\n    # directly lead to collecting the `primitive`. This could lead to exploring\n    # states where other items were picked up (e.g., tools), which is outside the\n    # direct scope of `collect(primitive)`.\n    # The primary purpose of `collect(primitive)` is to find and acquire the\n    # specified primitive directly. The `USE_ACT` is now only considered as the\n    # final action when the agent is correctly positioned and oriented next to\n    # the target primitive, as handled within the goal check section above.\n    # This change aims to make the BFS more focused and efficient for the\n    # specific task of collecting a primitive resource.\n\n  # If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 5, "scores": {"3": 1.0}}
{"timestamp": "2025-08-01T11:13:21.353285", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set now includes the agent's inventory as part of the state key.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing, allowing BFS to distinguish\n  # between states that are identical in position/direction but differ in inventory (e.g., having a tool vs. not).\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Increased MAX_EXPLORED_STATES due to the larger state space when tracking inventory.\n  # This is a heuristic and may need tuning for specific environment complexities.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`).\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # --- START OF V2 IMPROVEMENT ---\n    # Explore the USE action from the current position, but only if it's likely to be useful.\n    # A USE action is considered potentially useful if the agent is next to any grabbable item\n    # (which could be a tool or resource) OR if the agent is currently on a workshop.\n    \n    is_next_to_grabbable = any(state.next_to(idx) for idx in world.grabbable_indices)\n    is_on_workshop = any(state.grid[current_r, current_c, idx] == 1 for idx in world.workshop_indices)\n\n    if is_next_to_grabbable or is_on_workshop:\n        inventory_before_any_use = np.copy(state.inventory)\n        _, state_after_current_use = state.step(USE_ACT)\n        \n        # Only add to queue if the USE action resulted in a meaningful state change\n        # (inventory, position, or direction changed). This also implicitly covers\n        # cases where USE does nothing and thus doesn't need to be explored.\n        if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n                state_after_current_use.pos == state.pos and\n                state_after_current_use.dir == state.dir):\n\n            next_inventory_tuple = tuple(state_after_current_use.inventory)\n            next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n            if next_state_key not in visited:\n                visited.add(next_state_key)\n                q.append((state_after_current_use, path + [USE_ACT]))\n    # --- END OF V2 IMPROVEMENT ---\n\n  # If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T11:14:12.225409", "function_name": "collect", "function_body": "", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-08-01T11:14:13.438606", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  \n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  # CRITICAL IMPROVEMENT: Check if the primitive is actually grabbable.\n  # If it's not in the list of grabbable items (e.g., WATER, STONE, WORKSHOP),\n  # it cannot be 'collected' by picking it up using the USE action.\n  # In such cases, this function should return an empty list, as it's not a collectable item.\n  if primitive_id not in current_state.world.grabbable_indices:\n      return []\n\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (row, col)\n  initial_dir = current_state.dir # int (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  action_map = env.action_specs()\n  # Map DSL movement/turn actions to their integer indices from action_specs\n  MOVE_FORWARD_ACTION = action_map['UP'] # Assuming 'UP' means move forward in current direction\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  # This defines how position changes when moving \"forward\" in a given direction.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT, move positive column (East)\n      1: (-1, 0),  # Facing UP, move negative row (North)\n      2: (0, -1),  # Facing LEFT, move negative column (West)\n      3: (1, 0)    # Facing DOWN, move positive row (South)\n  }\n\n  # Map for turning left/right, updating the agent's direction (0-3)\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Define cells that are not walkable by the agent.\n  # This includes all non-grabbable entities (like boundaries, water, workshops)\n  # and also the primitive itself (the agent wants to be adjacent to it, not on it).\n  # Convert to list for efficient NumPy advanced indexing.\n  non_walkable_indices = list(current_state.world.non_grabbable_indices.union({primitive_id}))\n\n  # BFS state: ((row, col), direction), path_actions\n  # Queue stores ( (current_pos_tuple, current_dir_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (current_pos_tuple, current_dir_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # Stores the action list to reach the target state (adjacent and facing primitive)\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent at the current state.\n      # If so, this path is a candidate for reaching the target.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if front_cell is within grid bounds\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          # Check if the front_cell contains the primitive (its count > 0)\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Found the shortest path to be adjacent and facing the primitive\n\n      # 2. Explore possible next actions: Move Forward, Turn Left, Turn Right\n      \n      # Try Move Forward (UP action in DSL)\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if next_pos is within bounds and this (position, direction) state hasn't been visited\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT and\n          (next_pos, next_dir) not in visited):\n          \n          # Check if the next_pos cell is walkable.\n          # It's walkable if none of the non_walkable_indices are present in that cell.\n          # np.any will be True if any of the specified obstacle kinds are present at the cell.\n          if not np.any(initial_grid[next_r, next_c, non_walkable_indices] > 0):\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left (LEFT action in DSL)\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right (RIGHT action in DSL)\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path was found to an adjacent and facing position, append the USE action\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 2, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T11:14:46.588565", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  \n  # Retrieve the agent's current state: grid, position, and direction.\n  # These are crucial for defining the starting point of our pathfinding (BFS).\n  grid = current_state.grid\n  agent_pos = current_state.pos  # Agent's current (row, col) tuple\n  agent_dir = current_state.dir  # Agent's current facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Map the string name of the primitive (e.g., \"WOOD\", \"STONE\") to its numerical ID.\n  # This ID is used to locate the primitive on the grid.\n  primitive_kind_id = current_state.world.cookbook.index[primitive]\n  \n  # Get the dimensions of the grid. This is essential for boundary checks during movement.\n  num_rows, num_cols, _ = grid.shape\n\n  # Obtain the integer codes for each possible action from the environment's specifications.\n  # These are the actual numerical values passed to `env.step()`.\n  action_codes = env.action_specs()\n  ACTION_FORWARD = action_codes['UP']      # Moves the agent one step forward in its current direction.\n  ACTION_TURN_LEFT = action_codes['LEFT']   # Turns the agent 90 degrees counter-clockwise.\n  ACTION_TURN_RIGHT = action_codes['RIGHT'] # Turns the agent 90 degrees clockwise.\n  ACTION_USE = action_codes['USE']         # Interacts with the entity directly in front of the agent (e.g., collects a primitive).\n\n  # Define the change in (row, col) coordinates when moving forward for each of the four directions.\n  # This helps calculate the next cell the agent would occupy or the cell directly in front of it.\n  DIRECTION_TO_DELTAS = {\n      0: (0, 1),   # Facing RIGHT (East): row stays, col increases\n      1: (-1, 0),  # Facing UP (North): row decreases, col stays\n      2: (0, -1),  # Facing LEFT (West): row stays, col decreases\n      3: (1, 0)    # Facing DOWN (South): row increases, col stays\n  }\n\n  # Define how the agent's direction changes when performing a turn.\n  # These maps ensure the cyclic nature of directions (0->1->2->3->0).\n  TURN_LEFT_DIR_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Example: From RIGHT (0) to UP (1)\n  TURN_RIGHT_DIR_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Example: From RIGHT (0) to DOWN (3)\n\n  # Get the set of integer IDs for entities that are considered \"non-grabbable\" or impassable terrain.\n  # The agent cannot move onto these cells (e.g., boundaries, water, workshops).\n  impassable_kind_ids = current_state.world.non_grabbable_indices\n\n  # Helper function to check if a specific grid cell (r, c) is a valid and walkable location for the agent.\n  # This prevents the agent from attempting to move out of bounds or into obstacles.\n  def is_valid_walkable_cell(r: int, c: int) -> bool:\n      # 1. Check if the coordinates are within the grid boundaries.\n      if not (0 <= r < num_rows and 0 <= c < num_cols):\n          return False\n      \n      # 2. Check if the cell contains any 'impassable' entities.\n      # The agent cannot walk through or onto these specific types of objects.\n      for kind_id in impassable_kind_ids:\n          if grid[r, c, kind_id] > 0:\n              return False\n      \n      # 3. Importantly, the agent cannot walk *onto* the primitive it is trying to collect.\n      # Collection happens from an *adjacent* square using the 'USE' action.\n      if grid[r, c, primitive_kind_id] > 0:\n          return False\n          \n      # If all checks pass, the cell is safe and traversable.\n      return True\n\n  # Initialize Breadth-First Search (BFS):\n  # `queue`: Stores tuples of `((position_tuple, direction_int), list_of_actions_taken)`.\n  # This allows us to explore states layer by layer, guaranteeing the shortest path.\n  queue = collections.deque([((agent_pos, agent_dir), [])])\n  \n  # `visited`: A set to keep track of `(position_tuple, direction_int)` states that have already\n  # been visited. This prevents redundant computations and infinite loops in cyclic environments.\n  visited = {(agent_pos, agent_dir)}\n\n  # This variable will store the action sequence that leads the agent to be\n  # directly adjacent to and facing the target primitive.\n  path_to_primitive_adjacency = None \n\n  # Start the BFS traversal\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      current_row, current_col = current_pos\n\n      # --- Goal Check: Is the primitive directly in front of the agent? ---\n      # Calculate the coordinates of the cell directly in front of the agent based on its current direction.\n      dr_front, dc_front = DIRECTION_TO_DELTAS[current_dir]\n      front_cell_r, front_cell_c = current_row + dr_front, current_col + dc_front\n      \n      # Ensure the 'front' cell is within bounds before checking its contents.\n      if (0 <= front_cell_r < num_rows and 0 <= front_cell_c < num_cols):\n          # If the target primitive is present in the 'front' cell, we've found our path!\n          # This is the state where the agent is positioned correctly to perform the 'USE' action.\n          if grid[front_cell_r, front_cell_c, primitive_kind_id] > 0:\n              path_to_primitive_adjacency = path_actions # Store the sequence of actions that led to this state.\n              break # Found the shortest path, terminate BFS.\n\n      # --- Explore Possible Next Actions (Move Forward, Turn Left, Turn Right) ---\n\n      # A) Try moving ACTION_FORWARD:\n      # Calculate the next position if the agent moves forward. The direction remains the same.\n      next_pos_fwd = (front_cell_r, front_cell_c) # Agent moves into the cell that was previously in front.\n      next_dir_fwd = current_dir # Direction does not change with forward movement.\n\n      # Check if the next position is valid and walkable, and if this new (pos, dir) state hasn't been visited.\n      if is_valid_walkable_cell(next_pos_fwd[0], next_pos_fwd[1]) and \\\n         (next_pos_fwd, next_dir_fwd) not in visited:\n          # If valid, add the new state to the queue for exploration and mark it as visited.\n          visited.add((next_pos_fwd, next_dir_fwd))\n          queue.append(((next_pos_fwd, next_dir_fwd), path_actions + [ACTION_FORWARD]))\n\n      # B) Try ACTION_TURN_LEFT:\n      # Calculate the new direction after turning left. The agent's position remains unchanged.\n      next_dir_left = TURN_LEFT_DIR_MAP[current_dir]\n      # Check if this new state (same position, new direction) hasn't been visited.\n      if (current_pos, next_dir_left) not in visited:\n          # If valid, add to queue and mark as visited.\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [ACTION_TURN_LEFT]))\n\n      # C) Try ACTION_TURN_RIGHT:\n      # Calculate the new direction after turning right. The agent's position remains unchanged.\n      next_dir_right = TURN_RIGHT_DIR_MAP[current_dir]\n      # Check if this new state hasn't been visited.\n      if (current_pos, next_dir_right) not in visited:\n          # If valid, add to queue and mark as visited.\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [ACTION_TURN_RIGHT]))\n\n  # --- Finalize the Action Sequence ---\n  # If a path was found that leads the agent to be adjacent to and facing the primitive:\n  if path_to_primitive_adjacency is not None:\n      # Extend the accumulated actions with the final 'USE' action to collect the primitive.\n      actions_list.extend(path_to_primitive_adjacency)\n      actions_list.append(ACTION_USE)\n  \n  # Return the complete sequence of actions. If no path was found, `actions_list` will be empty.\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T11:14:47.850729", "function_name": "collect", "function_body": "  current_state = env._current_state\n  \n  # Store initial grid state, agent's position, and direction.\n  # These are fixed for the duration of the pathfinding task in the static environment.\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos  # Agent's starting (row, col) tuple\n  initial_dir = current_state.dir  # Agent's starting direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Resolve the primitive's string name (e.g., \"WOOD\") to its numerical ID.\n  # This ID is critical for identifying the primitive on the grid.\n  primitive_kind_id = current_state.world.cookbook.index[primitive]\n  \n  # Get grid dimensions for boundary checks during movement.\n  num_rows, num_cols, _ = initial_grid.shape\n\n  # Retrieve numerical action codes from the environment's action specifications.\n  # These integers are what `env.step()` expects to perform actions.\n  action_codes = env.action_specs()\n  ACTION_FORWARD = action_codes['UP']      # Action to move forward in the current direction.\n  ACTION_TURN_LEFT = action_codes['LEFT']   # Action to turn 90 degrees left.\n  ACTION_TURN_RIGHT = action_codes['RIGHT'] # Action to turn 90 degrees right.\n  ACTION_USE = action_codes['USE']         # Action to interact with the entity directly in front.\n\n  # Mapping agent's direction (0-3) to a (delta_row, delta_column) vector.\n  # This vector indicates how the agent's position changes when it moves forward,\n  # or which cell is directly in front of it.\n  DIRECTION_TO_DELTAS = {\n      0: (0, 1),   # Facing RIGHT (East): (row, col+1)\n      1: (-1, 0),  # Facing UP (North): (row-1, col)\n      2: (0, -1),  # Facing LEFT (West): (row, col-1)\n      3: (1, 0)    # Facing DOWN (South): (row+1, col)\n  }\n\n  # Mappings for the new direction after performing a turn. These ensure cyclic rotation.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # e.g., RIGHT(0) -> UP(1)\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # e.g., RIGHT(0) -> DOWN(3)\n\n  # Get the set of integer IDs for entities that are considered non-walkable terrain.\n  # The agent cannot move onto cells containing these items (e.g., boundaries, water, workshops).\n  impassable_kind_ids = current_state.world.non_grabbable_indices\n\n  # Helper function to check if a given grid cell (r, c) is a valid and walkable location for the agent.\n  def is_cell_walkable(r: int, c: int) -> bool:\n      # First, check if the cell coordinates are within the grid boundaries.\n      if not (0 <= r < num_rows and 0 <= c < num_cols):\n          return False\n      \n      # Second, check if the cell contains any entities marked as generally impassable.\n      # The agent cannot physically occupy a space with these objects.\n      for kind_id in impassable_kind_ids:\n          if initial_grid[r, c, kind_id] > 0:\n              return False\n      \n      # Third, the agent cannot walk directly onto the primitive it intends to collect.\n      # The 'USE' action operates on an adjacent cell, not the cell the agent occupies.\n      if initial_grid[r, c, primitive_kind_id] > 0:\n          return False\n      \n      # If all checks pass, the cell is considered safe and free for agent movement.\n      return True\n\n  # BFS Initialization:\n  # The queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_this_state).\n  # Each tuple represents a unique state (agent's location and orientation) and the path to reach it.\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # The 'visited' set stores (position_tuple, direction_int) to prevent redundant state explorations\n  # and infinite loops, ensuring that the shortest path is found.\n  visited = {(initial_pos, initial_dir)}\n\n  # This variable will store the action sequence if a path is found,\n  # leading the agent to be adjacent to and facing the primitive (the state *before* the 'USE' action).\n  path_to_target_adjacency = None \n\n  # BFS Traversal Loop: Continue as long as there are states to explore in the queue.\n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      current_row, current_col = current_pos\n\n      # 1. Check for Goal State: Is the target primitive directly in front of the agent?\n      # This is the desired state for performing the 'USE' action.\n      delta_r_front, delta_c_front = DIRECTION_TO_DELTAS[current_dir]\n      front_cell_r, front_cell_c = current_row + delta_r_front, current_col + delta_c_front\n      \n      # Ensure the cell directly in front is within grid boundaries before checking its contents.\n      if (0 <= front_cell_r < num_rows and 0 <= front_cell_c < num_cols):\n          # If the primitive is present in this 'front' cell, we've successfully found a path\n          # that leads the agent to be in a position to interact with the primitive.\n          if initial_grid[front_cell_r, front_cell_c, primitive_kind_id] > 0:\n              path_to_target_adjacency = path_so_far # Store the action sequence up to this point.\n              break # Goal reached! Terminate BFS as the shortest path has been found.\n\n      # 2. Explore all possible next actions (Move Forward, Turn Left, Turn Right) from the current state.\n\n      # A) Try ACTION_FORWARD:\n      # Calculate the agent's next position if it moves one step forward. Its direction remains unchanged.\n      next_pos_fwd = (front_cell_r, front_cell_c) # The agent moves into the cell that was previously 'front'.\n      next_dir_fwd = current_dir # Moving forward does not change orientation.\n\n      # Check if the calculated next position is walkable and if this new (position, direction) state\n      # has not been visited yet to avoid redundant paths and loops.\n      if is_cell_walkable(next_pos_fwd[0], next_pos_fwd[1]) and \\\n         (next_pos_fwd, next_dir_fwd) not in visited:\n          # If valid, add this new state to the queue and mark it as visited.\n          visited.add((next_pos_fwd, next_dir_fwd))\n          queue.append(((next_pos_fwd, next_dir_fwd), path_so_far + [ACTION_FORWARD]))\n\n      # B) Try ACTION_TURN_LEFT:\n      # Calculate the agent's new direction after turning left. Its position remains unchanged.\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Check if this new state (same position, new direction) has not been visited.\n      if ((current_pos, next_dir_left) not in visited):\n          # If valid, add this new state to the queue and mark it as visited.\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_so_far + [ACTION_TURN_LEFT]))\n\n      # C) Try ACTION_TURN_RIGHT:\n      # Calculate the agent's new direction after turning right. Its position remains unchanged.\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Check if this new state has not been visited.\n      if ((current_pos, next_dir_right) not in visited):\n          # If valid, add this new state to the queue and mark it as visited.\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_so_far + [ACTION_TURN_RIGHT]))\n\n  # 3. Finalize Actions:\n  # After the BFS completes:\n  # If a path to the target state (agent adjacent to and facing the primitive) was found,\n  # append the final 'USE' action to the discovered path to complete the collection sequence.\n  # If no path was found (path_to_target_adjacency remains None), an empty list is returned,\n  # indicating the primitive is currently unreachable from the agent's initial state.\n  final_action_sequence = []\n  if path_to_target_adjacency is not None:\n      final_action_sequence.extend(path_to_target_adjacency)\n      final_action_sequence.append(ACTION_USE)\n\n  return final_action_sequence", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T11:15:34.632795", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`. Finds and collects a primitive using BFS.\n\n    This function performs a Breadth-First Search (BFS) to find the shortest\n    sequence of actions (movements and turns) that will position the agent\n    adjacent to the target primitive and facing it, followed by a 'USE' action.\n    It considers unwalkable terrain to ensure a valid path.\n\n    Args:\n        env (env.CraftLab): The CraftLab object representing the current simulation environment.\n        primitive (str): The string name of the primitive item to collect (e.g., \"WOOD\", \"STONE\").\n\n    Returns:\n        List[int]: A sequence of integer action indices (e.g., MOVE_FORWARD, TURN_LEFT, USE)\n                   to execute in the environment. Returns an empty list if the primitive\n                   is unreachable or not found.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state\n\n  # Extract current state information\n  # The grid is typically indexed as grid[row, col, kind_id]\n  grid = current_state.grid \n  initial_pos = current_state.pos # Agent's current (row, col) tuple\n  initial_dir = current_state.dir # Agent's current facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook index\n  try:\n    primitive_id = current_state.world.cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not found in the cookbook, it cannot be collected.\n    return []\n  \n  # Determine grid dimensions (number of rows, number of columns)\n  GRID_ROWS, GRID_COLS, _ = grid.shape\n\n  # Map action names from the DSL/environment to their integer indices\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP'] # 'UP' action typically means moving forward in the current direction\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE'] # Action to collect the item\n\n  # Define how agent's (row, col) position changes when moving forward based on direction\n  # DIR_TO_DRDC maps current_dir to a (delta_row, delta_col) tuple\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT (0): (row, col+1)\n      1: (-1, 0),  # Facing UP (1):   (row-1, col)\n      2: (0, -1),  # Facing LEFT (2): (row, col-1)\n      3: (1, 0)    # Facing DOWN (3): (row+1, col)\n  }\n\n  # Define how agent's direction changes when turning\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right(0) -> Up(1) -> Left(2) -> Down(3) -> Right(0)\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right(0) -> Down(3) -> Left(2) -> Up(1) -> Right(0)\n\n  # Identify entity kinds that the agent cannot walk onto.\n  # This set includes general non-grabbable items (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  # AND the primitive itself, as the agent needs to stop *adjacent* to it to USE, not on it.\n  unwalkable_kind_ids = set(current_state.world.non_grabbable_indices)\n  unwalkable_kind_ids.add(primitive_id) \n\n  # BFS setup:\n  # The queue stores elements: ((current_pos_tuple, current_dir_int), list_of_actions_to_reach_here)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # The visited set stores (position, direction) pairs to avoid redundant exploration and cycles\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # This will store the sequence of actions once the target state is found\n\n  # Start BFS\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos # Deconstruct current_pos into row and column\n\n      # 1. Check if the target primitive is in the cell directly in front of the agent\n      # Calculate coordinates of the cell directly in front of the agent\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the front cell is within grid boundaries\n      if (0 <= front_r < GRID_ROWS and 0 <= front_c < GRID_COLS):\n          # Check if the front cell contains the primitive we are looking for\n          if grid[front_r, front_c, primitive_id] > 0:\n              target_path_actions = path_actions # Path to reach adjacent-and-facing state found\n              break # Exit BFS, target found\n\n      # 2. Explore possible next actions: Move Forward, Turn Left, Turn Right\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if the next position is within bounds and this (pos, dir) state hasn't been visited\n      if (0 <= next_r < GRID_ROWS and 0 <= next_c < GRID_COLS and\n          (next_pos, next_dir) not in visited):\n          \n          # Check if the next position is walkable (i.e., does not contain any unwalkable kinds)\n          is_walkable = True\n          for kind_idx in unwalkable_kind_ids:\n              if grid[next_r, next_c, kind_idx] > 0: # If the cell contains an unwalkable kind\n                  is_walkable = False\n                  break # Not walkable, no need to check other kinds in this cell\n          \n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning only changes direction, not position\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning only changes direction, not position\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path to the adjacent-and-facing state was found, append the USE action\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T11:15:35.831632", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state # Get the current CraftState object\n  \n  # Extract current grid, agent's position, and direction\n  grid = current_state.grid # numpy.ndarray of shape (WIDTH, HEIGHT, n_kinds)\n  initial_pos = current_state.pos # tuple (row, col)\n  initial_dir = current_state.dir # int (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Get grid dimensions\n  GRID_WIDTH, GRID_HEIGHT, _ = grid.shape\n\n  # Map action names from the DSL/environment to their integer indices\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP'] # 'UP' is typically used for moving forward in current direction\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE'] # Action to collect the item\n\n  # Define how agent's position changes when moving forward based on current direction\n  # (dr, dc) tuple for (delta_row, delta_col)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (R, C+1)\n      1: (-1, 0),  # Facing UP:   (R-1, C)\n      2: (0, -1),  # Facing LEFT: (R, C-1)\n      3: (1, 0)    # Facing DOWN: (R+1, C)\n  }\n\n  # Define how agent's direction changes when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # R(0)->U(1)->L(2)->D(3)->R(0)\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # R(0)->D(3)->L(2)->U(1)->R(0)\n\n  # Identify entity kinds that the agent cannot walk onto.\n  # This includes general non-grabbable items (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  # It also importantly includes the primitive itself, as the agent needs to stop *adjacent* to it\n  # and face it to use the 'USE' action, not step directly onto it.\n  unwalkable_kind_ids = set(current_state.world.non_grabbable_indices)\n  unwalkable_kind_ids.add(primitive_id) \n\n  # BFS setup\n  # Queue stores elements: ((current_pos_tuple, current_dir_int), list_of_actions_to_reach_here)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (position, direction) pairs to avoid redundant exploration and cycles\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # To store the sequence of actions once the target state is found\n\n  # Start BFS\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the target primitive is in the cell directly in front of the agent\n      # Calculate coordinates of the cell directly in front of the agent\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the front cell is within grid boundaries\n      if (0 <= front_r < GRID_WIDTH and 0 <= front_c < GRID_HEIGHT):\n          # Check if the front cell contains the primitive we are looking for\n          if grid[front_r, front_c, primitive_id] > 0:\n              target_path_actions = path_actions # Path to reach adjacent-and-facing state found\n              break # Exit BFS, target found\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if the next position is within bounds and this (pos, dir) state hasn't been visited\n      if (0 <= next_r < GRID_WIDTH and 0 <= next_c < GRID_HEIGHT and\n          (next_pos, next_dir) not in visited):\n          \n          # Check if the next position is walkable\n          is_walkable = True\n          for kind_idx in unwalkable_kind_ids:\n              if grid[next_r, next_c, kind_idx] > 0: # If the cell contains an unwalkable kind\n                  is_walkable = False\n                  break\n          \n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      next_state_left = (current_pos, next_dir_left)\n      if (next_state_left not in visited):\n          visited.add(next_state_left)\n          queue.append((next_state_left, path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      next_state_right = (current_pos, next_dir_right)\n      if (next_state_right not in visited):\n          visited.add(next_state_right)\n          queue.append((next_state_right, path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path to the adjacent-and-facing state was found, append the USE action\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T11:16:31.633671", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n\n  # Extract relevant information from the current state of the environment.\n  # This includes the grid layout, agent's current position, and facing direction.\n  grid = current_state.grid  # The environment grid (WIDTH, HEIGHT, n_kinds)\n  initial_pos = current_state.pos  # Agent's current position as (row, col) tuple\n  initial_dir = current_state.dir  # Agent's current facing direction (0:Right, 1:Up, 2:Left, 3:Down)\n\n  # Obtain the integer ID for the target primitive from the world's cookbook index.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Get grid dimensions for boundary checks.\n  GRID_WIDTH, GRID_HEIGHT, _ = grid.shape\n\n  # Map action names (from DSL/environment) to their corresponding integer indices.\n  # These indices are used when constructing the sequence of actions.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']  # Assuming 'UP' corresponds to moving forward in the current direction.\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']  # Action to collect the item (e.g., chop wood, mine stone).\n\n  # Define how the agent's position changes when moving forward based on its direction.\n  # This is a mapping from direction integer (0-3) to a (delta_row, delta_col) tuple.\n  # 0: Right (col + 1), 1: Up (row - 1), 2: Left (col - 1), 3: Down (row + 1)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing Right (positive column change)\n      1: (-1, 0),  # Facing Up (negative row change)\n      2: (0, -1),  # Facing Left (negative column change)\n      3: (1, 0)    # Facing Down (positive row change)\n  }\n\n  # Define how the agent's direction changes when turning left or right.\n  # These are cyclical mappings for direction integers (0-3).\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # e.g., Right(0) -> Up(1)\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # e.g., Right(0) -> Down(3)\n\n  # Identify entity kinds that the agent cannot walk onto.\n  # This includes entities like 'BOUNDARY', 'WATER', and 'WORKSHOP' locations.\n  # Crucially, the primitive itself (`primitive_id`) is also added to this set\n  # because the agent needs to stop *adjacent* to it and face it to use the `USE` action,\n  # rather than walking directly onto its cell.\n  unwalkable_kind_ids = set(current_state.world.non_grabbable_indices)\n  unwalkable_kind_ids.add(primitive_id) \n\n  # Initialize Breadth-First Search (BFS) for finding the shortest path.\n  # The queue stores states as: ((current_pos_tuple, current_dir_int), list_of_actions_to_reach_this_state).\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # The 'visited' set keeps track of (position, direction) pairs to prevent redundant exploration and cycles.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # This variable will store the action sequence once the primitive is found and faced.\n\n  # Start the BFS loop to explore the state space.\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the target primitive is in the cell directly in front of the agent.\n      # This is the goal condition for our pathfinding: being adjacent to and facing the primitive.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the calculated 'front' cell is within the grid boundaries.\n      if (0 <= front_r < GRID_WIDTH and 0 <= front_c < GRID_HEIGHT):\n          # If the cell in front contains the primitive, we have found the path to the collection point.\n          if grid[front_r, front_c, primitive_id] > 0:\n              target_path_actions = path_actions # Store the path leading to this \"adjacent and facing\" state.\n              break # Exit BFS, as the shortest path to the goal state has been found.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n      \n      # Try moving Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir] # Delta for moving forward\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change the agent's facing direction.\n\n      # Check if the next position is within grid boundaries AND if this (position, direction) state has not been visited.\n      if (0 <= next_r < GRID_WIDTH and 0 <= next_c < GRID_HEIGHT and\n          (next_pos, next_dir) not in visited):\n          \n          # Determine if the cell at `next_pos` is walkable.\n          # A cell is unwalkable if it contains any entity kind specified in `unwalkable_kind_ids`.\n          is_walkable = True\n          for kind_idx in unwalkable_kind_ids:\n              if grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          \n          if is_walkable:\n              # If the cell is walkable and the state is unvisited, add it to the visited set and the queue.\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try turning Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning only changes direction, not the agent's position.\n      if ((current_pos, next_dir_left) not in visited):\n          # If this (position, new_direction) state is unvisited, add it.\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try turning Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning only changes direction, not the agent's position.\n      if ((current_pos, next_dir_right) not in visited):\n          # If this (position, new_direction) state is unvisited, add it.\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # After the BFS search completes:\n  # If a `target_path_actions` was found (meaning the primitive was located and a path to it exists),\n  # append the `USE_ACTION` to the sequence to actually collect the primitive.\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n  \n  return actions_list", "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T11:16:32.873225", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n  Finds the shortest path to a primitive, positions the agent adjacent and facing it,\n  then returns the sequence of actions to collect it. Uses Breadth-First Search (BFS).\n\n  Args:\n      env (env.CraftLab): The CraftLab environment object.\n      primitive (str): The name of the primitive resource to collect (e.g., \"WOOD\", \"STONE\").\n\n  Returns:\n      List[int]: A sequence of integer action codes (e.g., UP, LEFT, USE) to execute.\n                 Returns an empty list if the primitive is unreachable or not found.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state # Access the internal CraftState instance\n\n  # Extract key information from the current state\n  grid = current_state.grid # The grid representing the world layout (WIDTH, HEIGHT, n_kinds)\n  initial_pos = current_state.pos # Agent's starting (row, col) tuple\n  initial_dir = current_state.dir # Agent's starting direction (0:Right, 1:Up, 2:Left, 3:Down)\n\n  # Get the integer ID for the target primitive from the cookbook's index\n  try:\n    primitive_id = current_state.world.cookbook.index[primitive]\n  except KeyError:\n    # Primitive not found in cookbook, cannot collect.\n    return []\n  \n  # Get grid dimensions for boundary checks\n  GRID_WIDTH, GRID_HEIGHT, _ = grid.shape\n\n  # Map action names to their integer indices using the environment's action_specs\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # Assuming 'UP' means move forward in current direction\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']            # Action to collect the item\n\n  # Define how agent's position changes when moving forward based on its current direction.\n  # (delta_row, delta_col) for each direction index.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT (0): (row, col + 1)\n      1: (-1, 0),  # Facing UP (1):    (row - 1, col)\n      2: (0, -1),  # Facing LEFT (2):  (row, col - 1)\n      3: (1, 0)    # Facing DOWN (3):  (row + 1, col)\n  }\n\n  # Define how agent's direction changes when turning left or right.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}   # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}  # Right -> Down -> Left -> Up -> Right\n\n  # Identify all entity kinds that the agent cannot walk onto.\n  # This includes general non-grabbable items (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  # AND the primitive itself, as the agent needs to stop *adjacent* to it, not on it, to USE.\n  unwalkable_kind_ids = set(current_state.world.non_grabbable_indices)\n  unwalkable_kind_ids.add(primitive_id) # Cannot walk *onto* the primitive we want to collect.\n\n  # BFS setup:\n  # Queue stores elements: ((current_pos_tuple, current_dir_int), list_of_actions_to_reach_here)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # Visited set stores (position, direction) pairs to avoid redundant exploration and cycles.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # Will store the sequence of actions once the target state is found\n\n  # Start Breadth-First Search\n  while queue:\n      (current_pos_tuple, current_dir_int), path_actions = queue.popleft()\n      r, c = current_pos_tuple\n\n      # 1. Goal Check: Is the target primitive directly in front of the agent in this state?\n      # Calculate coordinates of the cell directly in front of the agent\n      front_dr, front_dc = DIR_TO_DRDC[current_dir_int]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the front cell is within grid boundaries\n      if (0 <= front_r < GRID_WIDTH and 0 <= front_c < GRID_HEIGHT):\n          # Check if the front cell contains the primitive. If it does, we've found our target state.\n          if grid[front_r, front_c, primitive_id] > 0:\n              target_path_actions = path_actions # Store the path to this state\n              break # Exit BFS, as we found the shortest path to be adjacent and facing.\n\n      # 2. Explore possible next actions: Move Forward, Turn Left, Turn Right\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir_int]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos_tuple = (next_r, next_c)\n      next_dir_int = current_dir_int # Moving forward does not change facing direction\n\n      # Check if the next position is within bounds and this (pos, dir) state hasn't been visited.\n      if (0 <= next_r < GRID_WIDTH and 0 <= next_c < GRID_HEIGHT and\n          (next_pos_tuple, next_dir_int) not in visited):\n          \n          # Check if the next position is walkable (i.e., doesn't contain any unwalkable kind).\n          is_walkable = True\n          for kind_idx in unwalkable_kind_ids:\n              if grid[next_r, next_c, kind_idx] > 0: # If the cell contains an unwalkable kind\n                  is_walkable = False\n                  break\n          \n          if is_walkable:\n              visited.add((next_pos_tuple, next_dir_int))\n              queue.append(((next_pos_tuple, next_dir_int), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir_int]\n      # Turning only changes direction, not position.\n      if ((current_pos_tuple, next_dir_left) not in visited):\n          visited.add((current_pos_tuple, next_dir_left))\n          queue.append(((current_pos_tuple, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir_int]\n      # Turning only changes direction, not position.\n      if ((current_pos_tuple, next_dir_right) not in visited):\n          visited.add((current_pos_tuple, next_dir_right))\n          queue.append(((current_pos_tuple, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path to the adjacent-and-facing state was found, append the USE action.\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T11:17:56.223373", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's starting position (row, col)\n  initial_dir = current_state.dir # Agent's starting direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # 1. Validate the target primitive:\n  # Get the integer ID for the primitive from the environment's cookbook index.\n  try:\n      primitive_id = current_state.world.cookbook.index[primitive]\n  except KeyError:\n      # If the primitive name is not recognized in the cookbook, it cannot be collected.\n      return []\n  \n  # Check if the primitive is actually grabbable (can be picked up and added to inventory).\n  # If it's not in the grabbable_indices set, it's not a collectible item via 'USE' in the inventory sense.\n  if primitive_id not in current_state.world.grabbable_indices:\n      # For example, \"WATER\" or \"WORKSHOP0\" might be listed as 'primitives' in the DSL\n      # but are typically non-grabbable entities in the environment.\n      return []\n\n  # Get grid dimensions for boundary checks\n  GRID_ROWS, GRID_COLS, _ = initial_grid.shape \n\n  # Map action names to their integer indices for clarity and robustness\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP'] # 'UP' action typically means 'move forward' relative to current direction\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define how agent's position changes based on its facing direction\n  # Directions: 0 (Right), 1 (Up), 2 (Left), 3 (Down)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # Get indices of entities that cannot be walked upon (e.g., walls, water bodies, workshops)\n  non_walkable_kind_ids = current_state.world.non_grabbable_indices\n\n  # --- BFS Helper Function ---\n  def _find_path_to_adjacent_facing_primitive(\n      start_pos: tuple[int, int],\n      start_dir: int,\n      target_primitive_id: int,\n  ) -> list[int] | None:\n      \"\"\"\n      Performs a Breadth-First Search (BFS) to find the shortest sequence of\n      movement and turn actions for the agent to reach a state where it is\n      adjacent to the `target_primitive_id` and facing it.\n\n      Args:\n          start_pos (tuple[int, int]): Agent's starting (row, col) coordinates.\n          start_dir (int): Agent's starting direction (0-3).\n          target_primitive_id (int): The integer ID of the primitive to find.\n\n      Returns:\n          list[int] | None: A list of action indices representing the path,\n                            or None if no such path is found (e.g., unreachable primitive).\n      \"\"\"\n      # BFS Queue: stores ( (current_position, current_direction), path_taken_to_reach_here )\n      queue = collections.deque([((start_pos, start_dir), [])])\n      # Visited set: stores (position, direction) tuples to prevent redundant explorations\n      # and ensure the shortest path is found in an unweighted graph.\n      visited = {(start_pos, start_dir)}\n\n      while queue:\n          # Dequeue the current state and the sequence of actions that led to it\n          (current_pos, current_dir), path_actions = queue.popleft()\n          current_r, current_c = current_pos\n\n          # A. Check for target condition: Is the primitive directly in front of the agent?\n          # Calculate the coordinates of the cell directly in front of the agent.\n          front_dr, front_dc = DIR_TO_DRDC[current_dir]\n          front_r, front_c = current_r + front_dr, current_c + front_dc\n\n          # Ensure the cell in front is within grid boundaries\n          if (0 <= front_r < GRID_ROWS and 0 <= front_c < GRID_COLS):\n              # If the cell in front contains the target primitive, we've found our goal state.\n              if initial_grid[front_r, front_c, target_primitive_id] > 0:\n                  return path_actions # Return the path leading to this state (before the 'USE' action)\n\n          # B. Explore next possible actions: Move Forward, Turn Left, Turn Right\n          \n          # 1. Try Move Forward:\n          # Calculate the potential next position if the agent moves forward.\n          move_dr, move_dc = DIR_TO_DRDC[current_dir]\n          next_r, next_c = current_r + move_dr, current_c + move_dc\n          next_pos = (next_r, next_c)\n          next_dir_after_move = current_dir # Moving forward does not change the agent's facing direction\n\n          # Check if the potential next position is valid (within bounds, walkable, and not already visited).\n          if (0 <= next_r < GRID_ROWS and 0 <= next_c < GRID_COLS and\n              (next_pos, next_dir_after_move) not in visited):\n              \n              # Determine if the `next_pos` cell is walkable for the agent:\n              is_walkable = True\n              # An agent cannot walk onto cells containing non-grabbable entities (e.g., walls, water, workshops).\n              for kind_idx in non_walkable_kind_ids:\n                  if initial_grid[next_r, next_c, kind_idx] > 0:\n                      is_walkable = False\n                      break\n              # An agent also cannot walk directly onto the target primitive itself;\n              # it needs to be adjacent to it to 'USE' it.\n              if is_walkable and initial_grid[next_r, next_c, target_primitive_id] > 0:\n                  is_walkable = False\n\n              if is_walkable:\n                  visited.add((next_pos, next_dir_after_move))\n                  queue.append(((next_pos, next_dir_after_move), path_actions + [MOVE_FORWARD_ACTION]))\n\n          # 2. Try Turn Left:\n          # Calculate the new direction after turning left (counter-clockwise rotation).\n          # Directions: 0(R) -> 1(U) -> 2(L) -> 3(D) -> 0(R)\n          next_dir_left = (current_dir + 1) % 4\n          # Turning changes only direction, not position.\n          if ((current_pos, next_dir_left) not in visited):\n              visited.add((current_pos, next_dir_left))\n              queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n          # 3. Try Turn Right:\n          # Calculate the new direction after turning right (clockwise rotation).\n          # Directions: 0(R) -> 3(D) -> 2(L) -> 1(U) -> 0(R)\n          # Adding 4 before modulo ensures the result of (current_dir - 1) is non-negative.\n          next_dir_right = (current_dir - 1 + 4) % 4\n          # Turning changes only direction, not position.\n          if ((current_pos, next_dir_right) not in visited):\n              visited.add((current_pos, next_dir_right))\n              queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n      return None # If the queue becomes empty and the target state was not found, the primitive is unreachable.\n\n  # Call the BFS helper to find the sequence of movement and turn actions\n  # to position the agent adjacent to and facing the target primitive.\n  path_to_primitive = _find_path_to_adjacent_facing_primitive(\n      start_pos=initial_pos,\n      start_dir=initial_dir,\n      target_primitive_id=primitive_id,\n  )\n\n  # If a valid path was successfully found, append the 'USE' action to complete the collection.\n  if path_to_primitive is not None:\n      actions_list.extend(path_to_primitive)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T11:17:57.370707", "function_name": "collect", "function_body": "", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-08-01T11:19:22.133644", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID (this is the *target* item we want in inventory).\n  try:\n    i_kind_target = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # Primitive name not recognized by the cookbook index.\n    return [] \n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind_target] > 0:\n      return []\n\n  # 3. Determine the 'source' entity kind on the grid that needs to be interacted with\n  # to yield the target primitive. This distinction is crucial for primitives\n  # like \"wood\" (target) which comes from \"tree\" (source).\n  i_kind_source = -1 # Default to an invalid value, will be set below if collectible.\n\n  # Case A: The primitive itself is a direct environmental resource (like water/stone)\n  # or is directly grabbable (can be picked up directly from the grid).\n  # The DSL `primitive` list includes WATER and STONE. It also includes WOOD, IRON, etc.\n  # For items that are directly grabbable (like 'stick' if it were a primitive), their source is themselves.\n  \n  if i_kind_target == world.water_index:\n      i_kind_source = world.water_index\n  elif i_kind_target == world.stone_index:\n      i_kind_source = world.stone_index\n  # If the target primitive is something that can be picked up directly from the grid (e.g., a \"stick\" if it was a primitive),\n  # then the source entity to interact with is the primitive itself on the grid.\n  # Note: The DSL 'primitive' list mostly consists of resources derived from other entities,\n  # but this check is good for generality.\n  elif i_kind_target in world.grabbable_indices:\n      i_kind_source = i_kind_target\n  else:\n      # Case B: The primitive is obtained from a *different* source entity on the grid.\n      # This requires a mapping from the desired primitive (e.g., \"wood\") to its source entity (e.g., \"tree\").\n      # This mapping is specific to how CraftWorld generates resources.\n      primitive_to_source_entity_name = {\n          \"wood\": \"tree\",\n          \"iron\": \"iron_ore\",\n          \"grass\": \"grass_block\",\n          \"rock\": \"rock_block\",\n          \"gold\": \"gold_ore\",\n          \"gem\": \"gem_ore\",\n          # Add other explicit mappings if there are more complex dependencies.\n      }\n      source_entity_name = primitive_to_source_entity_name.get(primitive.lower())\n\n      if source_entity_name:\n          try:\n              i_kind_source = world.cookbook.index[source_entity_name]\n          except KeyError:\n              # The source entity (e.g., 'tree') itself is not recognized in the cookbook index.\n              # This means either the environment does not contain this source or the mapping is incorrect.\n              return []\n      else:\n          # If it's not a direct grabbable/resource AND no specific source entity mapping exists,\n          # then this primitive is not collectible via a simple 'USE' action on a grid object.\n          # (e.g., it might be a workshop, boundary, or exclusively craftable).\n          return []\n\n  # If i_kind_source is still invalid after all checks, it means the primitive cannot be collected\n  # via interacting with an environmental object.\n  if i_kind_source == -1:\n      return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n\n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n\n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set stores (row, col, direction, inventory_tuple) to avoid cycles\n  # and redundant exploration, as inventory changes can open up new possibilities\n  # (e.g., acquiring a tool that enables later collection).\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n\n  # A robust upper bound for explored states to prevent excessively long searches.\n  # It considers grid size, directions, and a heuristic factor for inventory variations.\n  # Increased MAX_EXPLORED_STATES for deeper exploration in complex scenarios.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 200 # Further increased for V2\n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n\n    # Goal Check 1: Is the 'source' entity (i_kind_source) at the agent's current position?\n    # This covers cases like picking up a loose item that is directly the source (e.g., a \"stick\")\n    # or stepping onto a water/stone tile and using it.\n    if state.grid[current_r, current_c, i_kind_source] == 1:\n        inventory_before_use_on_self = np.copy(state.inventory)\n        _, state_after_use_on_self = state.step(USE_ACT)\n\n        # Verify successful collection: check if the *target primitive's* count increased in inventory.\n        # This is crucial because using on a source might produce the target, or something else (e.g., nothing without tool).\n        if state_after_use_on_self.inventory[i_kind_target] > inventory_before_use_on_self[i_kind_target]:\n            return path + [USE_ACT] # Collected by using at current position\n\n    # Goal Check 2: Is the 'source' entity (i_kind_source) in an adjacent cell?\n    # Iterate through cardinal directions to find the specific cell containing the source entity.\n    # Optimization: Use state.next_to() to quickly check if the source is nearby before iterating directions.\n    # state.next_to(i_kind_source) covers the 3x3 neighborhood.\n    if state.next_to(i_kind_source):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Ensure facing cell is within grid bounds and contains the target source entity\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and\n                state.grid[facing_r, facing_c, i_kind_source] == 1):\n\n                # Simulate the turning actions required to face the source entity.\n                temp_state_after_turns = state\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action on the cell in front.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the *target primitive* in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., requiring tools, or multiple uses) implemented in `CraftState.step`).\n                if state_after_use.inventory[i_kind_target] > inventory_before_use[i_kind_target]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n\n    # Explore the USE action from the current position generally.\n    # This is important if using an item at the current position (e.g., picking up a tool,\n    # or interacting with a workshop) changes the inventory state. Such changes might be\n    # necessary for later steps to collect the *target* primitive (e.g., crafting a required tool).\n    # This block adds a state to the queue if the USE action results in a \"meaningful\" state change.\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n\n    # Only add to queue if the USE action resulted in a meaningful state change\n    # (inventory, position, or direction changed) and is not already visited.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 6, "scores": {"3": 1.5}}
