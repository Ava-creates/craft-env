          state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T07:27:47.529166", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set now includes the agent's inventory as part of the state key.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing, allowing BFS to distinguish\n  # between states that are identical in position/direction but differ in inventory (e.g., having a tool vs. not).\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # MAX_EXPLORED_STATES is a heuristic limit to prevent excessive search in large state spaces.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`) in the 3x3 neighborhood.\n    if state.next_to(i_kind):\n        for target_dir in range(4): # Iterate through possible agent orientations (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell directly in front contains the target primitive\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    # Apply each turn action to get the state after all turns.\n                    # Reward is ignored as we are pathfinding, not optimizing reward.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the USE action from the current position generally.\n    # This is important if using an item at the current position (e.g., picking up a tool)\n    # can change the inventory state, which might be necessary for later steps to collect the primitive.\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if the USE action resulted in a meaningful state change (inventory, position, or direction).\n    # This prevents adding redundant states to the queue if USE had no effect.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T07:27:49.066774", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n  all_actions_to_explore = move_actions + [USE_ACT] # Include USE for general state exploration (e.g., getting tools)\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set stores a tuple representing the state: (row, col, direction, inventory_tuple).\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing, allowing BFS to distinguish\n  # between states that are identical in position/direction but differ in inventory.\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # MAX_EXPLORED_STATES is a heuristic limit to prevent excessive search in large state spaces.\n  # This limit is set to 10 times the number of unique (position, direction) states.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`) in the 3x3 neighborhood.\n    if state.next_to(i_kind):\n        for target_dir in range(4): # Iterate through possible agent orientations (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell directly in front contains the target primitive\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    # Apply each turn action to get the state after all turns.\n                    # Reward is ignored as we are pathfinding, not optimizing reward.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`).\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore all possible actions (movements and general USE)\n    # The USE_ACT is explored generally here, for picking up tools etc.\n    # The specific USE_ACT for the goal (if an item is in front) is handled in the goal check part above.\n    for action in all_actions_to_explore:\n        _, next_state = state.step(action)\n        next_inventory_tuple = tuple(next_state.inventory)\n        next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n        # Determine if the action caused a meaningful state change.\n        # This is especially important for USE_ACT, which might sometimes have no effect.\n        # Movement actions always cause a change in position or direction.\n        state_actually_changed = not (\n            action == USE_ACT and \n            np.array_equal(next_state.inventory, state.inventory) and\n            next_state.pos == state.pos and\n            next_state.dir == state.dir\n        )\n\n        if next_state_key not in visited and state_actually_changed:\n            visited.add(next_state_key)\n            q.append((next_state, path + [action]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T07:29:17.006032", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  \n  # Retrieve critical information from the current state for pathfinding\n  grid = current_state.grid # The environment grid (WIDTH, HEIGHT, n_kinds)\n  agent_pos = current_state.pos # Agent's current (row, column) position\n  agent_dir = current_state.dir # Agent's current facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the environment's cookbook\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Extract grid dimensions for boundary checks\n  GRID_WIDTH, GRID_HEIGHT, _ = grid.shape # Note: WIDTH corresponds to rows, HEIGHT to columns\n\n  # Map human-readable action names from the environment's action_specs to their integer IDs\n  action_map = env.action_specs()\n  ACTION_MOVE_FORWARD = action_map['UP']    # Action to move one step forward in current direction\n  ACTION_TURN_LEFT = action_map['LEFT']     # Action to turn 90 degrees counter-clockwise\n  ACTION_TURN_RIGHT = action_map['RIGHT']   # Action to turn 90 degrees clockwise\n  ACTION_USE = action_map['USE']            # Action to interact with the cell directly in front of the agent\n\n  # Define how agent's (row, column) position changes based on its facing direction when moving forward\n  # (delta_row, delta_column) for directions 0 (RIGHT), 1 (UP), 2 (LEFT), 3 (DOWN)\n  DIRECTION_TO_DELTA_POS = {\n      0: (0, 1),   # RIGHT: (0, +1)\n      1: (-1, 0),  # UP:    (-1, 0)\n      2: (0, -1),  # LEFT:  (0, -1)\n      3: (1, 0)    # DOWN:  (+1, 0)\n  }\n\n  # Define how the agent's direction changes when performing a 'TURN_LEFT' action\n  TURN_LEFT_DIRECTION_MAP = {\n      0: 1,  # RIGHT (0) -> UP (1)\n      1: 2,  # UP (1)    -> LEFT (2)\n      2: 3,  # LEFT (2)  -> DOWN (3)\n      3: 0   # DOWN (3)  -> RIGHT (0)\n  }\n\n  # Define how the agent's direction changes when performing a 'TURN_RIGHT' action\n  TURN_RIGHT_DIRECTION_MAP = {\n      0: 3,  # RIGHT (0) -> DOWN (3)\n      1: 0,  # UP (1)    -> RIGHT (0)\n      2: 1,  # LEFT (2)  -> UP (1)\n      3: 2   # DOWN (3)  -> LEFT (2)\n  }\n\n  # Get a set of integer IDs for entities that cannot be walked upon by the agent\n  non_walkable_entity_ids = current_state.world.non_grabbable_indices\n\n  # --- Breadth-First Search (BFS) for pathfinding to the primitive ---\n  # The queue will store tuples: ((current_row, current_col), current_direction, list_of_actions_taken_to_reach_here)\n  bfs_queue = collections.deque([((agent_pos[0], agent_pos[1]), agent_dir, [])])\n  \n  # The visited set will store ( (row, col), direction ) pairs to avoid redundant computations\n  # and prevent infinite loops in cyclic paths.\n  visited_states = {((agent_pos[0], agent_pos[1]), agent_dir)}\n\n  # This variable will store the sequence of movement and turn actions\n  # that leads the agent to be adjacent to and facing the target primitive.\n  found_path_to_primitive = None \n\n  while bfs_queue:\n      (r, c), current_direction, current_path = bfs_queue.popleft()\n\n      # 1. Check if the current state satisfies the collection condition:\n      # Is the target primitive located directly in front of the agent?\n      front_dr, front_dc = DIRECTION_TO_DELTA_POS[current_direction]\n      cell_in_front_r, cell_in_front_c = r + front_dr, c + front_dc\n      \n      # Ensure the 'cell in front' is within the grid boundaries\n      if (0 <= cell_in_front_r < GRID_WIDTH and 0 <= cell_in_front_c < GRID_HEIGHT):\n          # If the cell contains the primitive, we've found our target location and orientation.\n          if grid[cell_in_front_r, cell_in_front_c, primitive_id] > 0:\n              found_path_to_primitive = current_path # Store the path leading to this pre-collection state.\n              break # Exit BFS, as the shortest path has been found.\n\n      # 2. Explore possible next actions: Move Forward, Turn Left, Turn Right\n      \n      # --- Attempt Move Forward ---\n      move_dr, move_dc = DIRECTION_TO_DELTA_POS[current_direction]\n      next_r_after_move, next_c_after_move = r + move_dr, c + move_dc\n      next_pos_after_move = (next_r_after_after_move, next_c_after_move)\n      next_dir_after_move = current_direction # Agent's direction does not change when moving forward\n\n      # Check if the new position is within grid boundaries and if this (position, direction) state hasn't been visited\n      if (0 <= next_r_after_move < GRID_WIDTH and 0 <= next_c_after_move < GRID_HEIGHT and\n          (next_pos_after_move, next_dir_after_move) not in visited_states):\n          \n          # Determine if the cell at `next_pos_after_move` is walkable for the agent.\n          # A cell is not walkable if it contains any non-grabbable entities (e.g., boundaries, water, workshops).\n          # Also, the agent cannot walk *onto* the primitive it intends to collect; it must remain adjacent to it.\n          is_next_cell_walkable = True\n          for kind_index in non_walkable_entity_ids:\n              if grid[next_r_after_move, next_c_after_move, kind_index] > 0:\n                  is_next_cell_walkable = False\n                  break\n          # Special check: cannot walk onto the primitive itself\n          if is_next_cell_walkable and grid[next_r_after_move, next_c_after_move, primitive_id] > 0:\n              is_next_cell_walkable = False\n\n          if is_next_cell_walkable:\n              visited_states.add((next_pos_after_move, next_dir_after_move))\n              bfs_queue.append((next_pos_after_move, next_dir_after_move, current_path + [ACTION_MOVE_FORWARD]))\n\n      # --- Attempt Turn Left ---\n      next_direction_after_turn_left = TURN_LEFT_DIRECTION_MAP[current_direction]\n      # Turning actions only change direction, not position.\n      if ((r, c), next_direction_after_turn_left) not in visited_states:\n          visited_states.add(((r, c), next_direction_after_turn_left))\n          bfs_queue.append(((r, c), next_direction_after_turn_left, current_path + [ACTION_TURN_LEFT]))\n\n      # --- Attempt Turn Right ---\n      next_direction_after_turn_right = TURN_RIGHT_DIRECTION_MAP[current_direction]\n      # Turning actions only change direction, not position.\n      if ((r, c), next_direction_after_turn_right) not in visited_states:\n          visited_states.add(((r, c), next_direction_after_turn_right))\n          bfs_queue.append(((r, c), next_direction_after_turn_right, current_path + [ACTION_TURN_RIGHT]))\n\n  # If a path was successfully found (i.e., `found_path_to_primitive` is not None),\n  # extend the actions list with the movement/turn path and then append the 'USE' action\n  # to actually collect the primitive.\n  if found_path_to_primitive is not None:\n      actions_list.extend(found_path_to_primitive)\n      actions_list.append(ACTION_USE)\n\n  return actions_list", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-08-01T07:29:18.233841", "function_name": "collect", "function_body": "", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-08-01T07:30:14.865474", "function_name": "collect", "function_body": "  actions_sequence = [] # List to store the final sequence of actions\n\n  # Get the current state from the environment wrapper.\n  current_state = env._current_state\n\n  # Extract initial conditions for pathfinding (grid, agent's position, direction).\n  # The grid is considered static for pathfinding purposes for BFS.\n  initial_grid = current_state.grid\n  agent_initial_pos = current_state.pos # (row, column) tuple\n  agent_initial_dir = current_state.dir # Integer (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the world's cookbook index.\n  primitive_kind_id = current_state.world.cookbook.index[primitive]\n\n  # Get grid dimensions for boundary checks.\n  GRID_WIDTH, GRID_HEIGHT, _ = initial_grid.shape\n\n  # Map symbolic action names to their integer codes for environment interaction.\n  action_map = env.action_specs()\n  ACTION_MOVE_FORWARD = action_map['UP']    # In CraftWorld, 'UP' moves agent forward\n  ACTION_TURN_LEFT = action_map['LEFT']\n  ACTION_TURN_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']            # Action to collect/interact with an item\n\n  # Define how agent's (dr, dc) changes based on its current direction.\n  # (delta_row, delta_column) for moving one step forward.\n  DIRECTION_VECTORS = {\n      0: (0, 1),   # RIGHT: +1 to column\n      1: (-1, 0),  # UP: -1 to row\n      2: (0, -1),  # LEFT: -1 to column\n      3: (1, 0)    # DOWN: +1 to row\n  }\n\n  # Define how agent's direction changes when turning.\n  # (current_dir -> new_dir)\n  TURN_LEFT_EFFECT = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_EFFECT = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Define which entity kinds act as impassable obstacles for agent movement.\n  # These are entities the agent cannot walk *through* or *onto*.\n  impassable_kinds_ids = set(current_state.world.non_grabbable_indices)\n  # When collecting a grabbable primitive, the agent must be *adjacent*\n  # to it, not occupying the same cell. So the primitive itself is also an obstacle\n  # for movement into its cell.\n  impassable_kinds_ids.add(primitive_kind_id)\n\n  # --- Helper Functions for Readability and Modularity ---\n  def _is_cell_valid_and_walkable(r, c):\n      \"\"\"\n      Checks if a given grid cell (r, c) is within bounds and does not contain\n      any impassable items.\n      \"\"\"\n      if not (0 <= r < GRID_WIDTH and 0 <= c < GRID_HEIGHT):\n          return False  # Out of bounds\n\n      # Check if the cell contains any obstacle defined in impassable_kinds_ids\n      for kind_idx in impassable_kinds_ids:\n          if initial_grid[r, c, kind_idx] > 0:\n              return False  # Contains an impassable item\n\n      return True\n\n  def _is_primitive_in_agent_neighborhood(agent_r, agent_c):\n      \"\"\"\n      Checks if the target primitive is present in any cell within the\n      3x3 neighborhood centered at (agent_r, agent_c) on the initial grid.\n      \"\"\"\n      for dr_check in [-1, 0, 1]:\n          for dc_check in [-1, 0, 1]:\n              check_r, check_c = agent_r + dr_check, agent_c + dc_check\n              # Ensure the cell being checked is within grid boundaries.\n              if (0 <= check_r < GRID_WIDTH and 0 <= check_c < GRID_HEIGHT):\n                  # Check if the primitive kind exists at this neighboring cell on the initial grid.\n                  if initial_grid[check_r, check_c, primitive_kind_id] > 0:\n                      return True\n      return False\n  # --- End of Helper Functions ---\n\n  # Early Exit: If the primitive is already in the agent's 3x3 neighborhood,\n  # the agent can collect it immediately with a 'USE' action.\n  # The `CraftState.next_to` method efficiently checks this.\n  if current_state.next_to(primitive_kind_id):\n      return [ACTION_USE]\n\n  # Initialize Breadth-First Search (BFS) for pathfinding.\n  # Queue element: ((agent_position, agent_direction), list_of_actions_taken)\n  # Agent position: (row, column) tuple. Agent direction: integer (0-3).\n  bfs_queue = collections.deque([((agent_initial_pos, agent_initial_dir), [])])\n\n  # Set to keep track of visited (position, direction) states to prevent cycles\n  # and ensure finding the shortest path.\n  visited_states = {(agent_initial_pos, agent_initial_dir)}\n\n  # This will store the sequence of actions once a path to a collectible location is found.\n  path_to_collectible_location = None\n\n  # BFS loop continues until all reachable states are explored or a target path is found.\n  while bfs_queue:\n      (current_pos, current_dir), current_path = bfs_queue.popleft()\n      r, c = current_pos # Unpack current row and column\n\n      # Goal Check: Check if the primitive is reachable from the current agent's position.\n      if _is_primitive_in_agent_neighborhood(r, c):\n          path_to_collectible_location = current_path\n          break # Exit BFS, as the shortest path is found.\n\n      # Explore next possible states by trying each allowed action: Move, Turn Left, Turn Right.\n\n      # 1. Try MOVE_FORWARD:\n      dr_move, dc_move = DIRECTION_VECTORS[current_dir]\n      next_r_move, next_c_move = r + dr_move, c + dc_move\n      next_pos_move = (next_r_move, next_c_move)\n      next_dir_move = current_dir # Direction doesn't change when moving forward\n\n      # Check validity of the new state (within bounds, walkable, and not previously visited).\n      if _is_cell_valid_and_walkable(next_r_move, next_c_move) and \\\n         (next_pos_move, next_dir_move) not in visited_states:\n          visited_states.add((next_pos_move, next_dir_move)) # Mark new state as visited\n          # Add the new state to the queue with its updated path.\n          bfs_queue.append(((next_pos_move, next_dir_move), current_path + [ACTION_MOVE_FORWARD]))\n\n      # 2. Try TURN_LEFT:\n      next_dir_left = TURN_LEFT_EFFECT[current_dir]\n      # Position remains the same when turning.\n      if (current_pos, next_dir_left) not in visited_states:\n          visited_states.add((current_pos, next_dir_left))\n          bfs_queue.append(((current_pos, next_dir_left), current_path + [ACTION_TURN_LEFT]))\n\n      # 3. Try TURN_RIGHT:\n      next_dir_right = TURN_RIGHT_EFFECT[current_dir]\n      # Position remains the same when turning.\n      if (current_pos, next_dir_right) not in visited_states:\n          visited_states.add((current_pos, next_dir_right))\n          bfs_queue.append(((current_pos, next_dir_right), current_path + [ACTION_TURN_RIGHT]))\n\n  # After BFS completes:\n  # If a path to a collectible location was found, append the final 'USE' action.\n  if path_to_collectible_location is not None:\n      actions_sequence.extend(path_to_collectible_location)\n      actions_sequence.append(ACTION_USE)\n\n  return actions_sequence", "island_id": 5, "scores": {"3": 0.5}}
