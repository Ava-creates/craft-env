{"timestamp": "2025-08-01T04:36:55.080866", "function_name": "collect", "function_body": "  actions = []\n  \n  current_state = env._current_state \n  grid = current_state.grid\n  current_pos = current_state.pos\n  \n  WIDTH, HEIGHT, _ = grid.shape\n\n  primitive_id = env.world.cookbook.index[primitive]\n\n  ACTION_MAP = env.action_specs()\n  UP = ACTION_MAP['UP']\n  DOWN = ACTION_MAP['DOWN']\n  LEFT = ACTION_MAP['LEFT']\n  RIGHT = ACTION_MAP['RIGHT']\n  USE = ACTION_MAP['USE']\n\n  DELTAS = {\n      UP: (-1, 0),\n      DOWN: (1, 0),\n      LEFT: (0, -1),\n      RIGHT: (0, 1)\n  }\n\n  # 1. Early exit: If the primitive is not grabbable, we cannot collect it.\n  if primitive_id not in env.world.grabbable_indices:\n      return []\n\n  # 2. Early exit: If the agent is already next to the primitive, just use it.\n  if current_state.next_to(primitive_id):\n      return [USE]\n\n  # 3. Find all locations of the target primitive on the grid.\n  primitive_locations = []\n  for r in range(WIDTH):\n      for c in range(HEIGHT):\n          if grid[r, c, primitive_id] == 1:\n              primitive_locations.append((r, c))\n\n  # If the primitive is not found anywhere, return an empty list.\n  if not primitive_locations:\n      return []\n\n  # 4. Perform Breadth-First Search (BFS) to find the shortest path\n  #    to a cell from which the primitive can be collected (i.e., adjacent to it).\n  \n  # Queue stores tuples: ((current_row, current_col), [list_of_actions_to_reach_here])\n  q = collections.deque([(current_pos, [])]) \n  visited = {current_pos} # Set to keep track of visited positions to avoid cycles\n\n  target_adj_pos_path = None # Stores the path to the adjacent cell once found\n\n  while q:\n      (r, c), path = q.popleft()\n\n      # Check if the current position (r, c) is adjacent to any primitive location.\n      # Being adjacent means we can perform the 'USE' action from here.\n      for pr, pc in primitive_locations:\n          # Manhattan distance of 1 means direct adjacency (horizontal or vertical)\n          if abs(r - pr) + abs(c - pc) == 1: \n              target_adj_pos_path = path \n              break # Found the shortest path to an adjacent cell, so break from this inner loop\n      \n      if target_adj_pos_path is not None:\n          break # Exit BFS, as the shortest path to an adjacent cell has been found\n\n      # Explore valid neighbors (UP, DOWN, LEFT, RIGHT)\n      for action_dir, (dr, dc) in DELTAS.items():\n          nr, nc = r + dr, c + dc # New potential position\n\n          # Check bounds: Ensure the new position is within the grid boundaries\n          if not (0 <= nr < WIDTH and 0 <= nc < HEIGHT):\n              continue\n          \n          # Check traversability:\n          # A cell is non-traversable if it contains any item from the non_grabbable_indices set.\n          is_traversable = True\n          for i_kind in env.world.non_grabbable_indices:\n              if grid[nr, nc, i_kind] == 1: \n                  is_traversable = False\n                  break \n          \n          if not is_traversable:\n              continue \n          \n          # If the neighbor has not been visited, add it to the queue\n          if (nr, nc) not in visited:\n              visited.add((nr, nc))\n              new_path = path + [action_dir]\n              q.append(((nr, nc), new_path))\n    \n  # 5. If a path to an adjacent cell was found, extend the actions list with this path\n  #    and then append a 'USE' action to actually collect the primitive.\n  if target_adj_pos_path is not None:\n      actions.extend(target_adj_pos_path)\n      actions.append(USE) # Perform 'USE' action once adjacent\n  \n  return actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T04:37:43.560279", "function_name": "collect", "function_body": "  \"\"\"Computes a sequence of actions to find and collect a specified grabbable primitive.\n  It uses Breadth-First Search (BFS) to find the shortest path to a cell\n  adjacent to any instance of the primitive, and then appends a 'USE' action.\n\n  Args:\n      env (env.CraftLab): The CraftLab environment object representing the current game state.\n      primitive (str): The name of the primitive item to be collected (e.g., \"WOOD\", \"IRON\").\n\n  Returns:\n      List[int]: A list of integer action codes (UP, DOWN, LEFT, RIGHT, USE)\n                 representing the optimal sequence to collect the primitive.\n                 Returns an empty list if the primitive is not grabbable,\n                 or if no path to an adjacent primitive is found.\n  \"\"\"\n  # 1. Initialize State and Environment Information\n  current_state = env._current_state \n  grid = current_state.grid\n  agent_start_pos = current_state.pos\n  grid_width, grid_height, _ = grid.shape\n\n  # Retrieve the integer ID for the target primitive from the world's cookbook index.\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Map action names to their corresponding integer codes using env.action_specs().\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define possible movement directions (delta row, delta col) and their associated actions.\n  MOVEMENT_DELTAS = [\n      ((-1, 0), ACTION_UP),    # Row decreases -> Up\n      ((1, 0), ACTION_DOWN),   # Row increases -> Down\n      ((0, -1), ACTION_LEFT),  # Col decreases -> Left\n      ((0, 1), ACTION_RIGHT)   # Col increases -> Right\n  ]\n\n  # Pre-calculate indices of non-grabbable items for efficient traversability checks.\n  # Convert to a list to use with numpy advanced indexing later.\n  non_grabbable_kind_indices = list(env.world.non_grabbable_indices)\n  \n  # 2. Pre-checks and Immediate Collection\n  # If the primitive cannot be picked up (e.g., water, workshop, boundary), return empty path.\n  if primitive_id not in env.world.grabbable_indices:\n      return []\n\n  # If the agent is already adjacent to the primitive, only a 'USE' action is needed.\n  if current_state.next_to(primitive_id):\n      return [ACTION_USE]\n\n  # 3. Breadth-First Search (BFS) for Shortest Path\n  # The queue stores tuples: (current_position (r, c), list_of_actions_taken_to_reach_here).\n  # The `visited` set prevents revisiting locations, ensuring the shortest path is found\n  # and avoiding infinite loops in cyclic environments.\n  q = collections.deque([(agent_start_pos, [])]) \n  visited = {agent_start_pos} \n\n  shortest_path_actions = []\n  target_adjacent_position_found = False\n\n  while q:\n      (current_r, current_c), path_actions_so_far = q.popleft()\n\n      # Create a temporary CraftState object for the current position in the BFS.\n      # This allows using the built-in `next_to` method to check adjacency to the primitive.\n      temp_state_for_check = craft.CraftState(\n          scenario=current_state.scenario,\n          grid=grid,\n          pos=(current_r, current_c),\n          dir=current_state.dir,      # Agent's direction does not affect `next_to` check\n          inventory=current_state.inventory # Inventory state does not affect `next_to` check\n      )\n\n      # Check if the current position (in the BFS) is adjacent to the target primitive.\n      # If so, we've found the shortest sequence of movements to reach a collecting position.\n      if temp_state_for_check.next_to(primitive_id):\n          shortest_path_actions = path_actions_so_far\n          target_adjacent_position_found = True\n          break  # Exit BFS: the shortest path to an adjacent cell has been found.\n\n      # Explore all valid neighboring cells from the current position.\n      for (dr, dc), action_to_take in MOVEMENT_DELTAS:\n          next_r, next_c = current_r + dr, current_c + dc\n          next_pos = (next_r, next_c)\n\n          # --- Validity Checks for Next Position ---\n          # 1. Boundary Check: Ensure next_pos is within grid dimensions (WIDTH x HEIGHT).\n          if not (0 <= next_r < grid_width and 0 <= next_c < grid_height):\n              continue\n\n          # 2. Traversability Check: Ensure next_pos is not an impassable obstacle.\n          # A cell is an obstacle if it contains any non-grabbable item.\n          is_obstacle = False\n          if non_grabbable_kind_indices: # Only check if there are any non-grabbable kinds defined\n              # Use numpy.any to efficiently check if any non-grabbable item occupies the cell.\n              if np.any(grid[next_r, next_c, non_grabbable_kind_indices]):\n                  is_obstacle = True\n          \n          if is_obstacle:\n              continue\n\n          # 3. Visited Check: Avoid re-exploring positions that have already been visited.\n          if next_pos not in visited:\n              visited.add(next_pos)\n              # Add the new valid position to the queue with the accumulated path actions.\n              q.append((next_pos, path_actions_so_far + [action_to_take]))\n\n  # 4. Construct the Final Action Sequence\n  final_actions_sequence = shortest_path_actions\n\n  # If a path was successfully found to a cell adjacent to the primitive,\n  # append the 'USE' action to complete the collection.\n  if target_adjacent_position_found:\n      final_actions_sequence.append(ACTION_USE)\n  \n  return final_actions_sequence", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T04:37:44.675522", "function_name": "collect", "function_body": "  # 1. Initialize State and Environment Information\n  # Retrieve the current state from the environment to access grid, agent's position, etc.\n  current_state = env._current_state \n  grid = current_state.grid\n  agent_start_pos = current_state.pos\n  grid_width, grid_height, _ = grid.shape\n\n  # Get the integer ID for the target primitive from the world's cookbook index.\n  # This ID is crucial for identifying the primitive on the grid and in checks.\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Map action names (strings) to their corresponding integer codes using env.action_specs().\n  # This makes the code more readable and robust to changes in action mapping.\n  ACTION_MAP = env.action_specs()\n  MOVE_UP = ACTION_MAP['UP']\n  MOVE_DOWN = ACTION_MAP['DOWN']\n  MOVE_LEFT = ACTION_MAP['LEFT']\n  MOVE_RIGHT = ACTION_MAP['RIGHT']\n  ACTION_USE = ACTION_MAP['USE']\n\n  # Define possible movement directions as (delta_row, delta_column) along with their\n  # corresponding action codes. This structure is useful for iterating through neighbors in BFS.\n  MOVEMENT_DIRECTIONS = [\n      ((-1, 0), MOVE_UP),    # Move Up: Decreases row index\n      ((1, 0), MOVE_DOWN),   # Move Down: Increases row index\n      ((0, -1), MOVE_LEFT),  # Move Left: Decreases column index\n      ((0, 1), MOVE_RIGHT)   # Move Right: Increases column index\n  ]\n\n  # 2. Pre-checks for Early Exit\n  # Check if the primitive is actually grabbable. Non-grabbable items (like WATER, BOUNDARY, WORKSHOP)\n  # cannot be picked up and added to inventory, so an empty action list is returned.\n  if primitive_id not in env.world.grabbable_indices:\n      return []\n\n  # Check if the agent is already positioned next to the primitive.\n  # If `current_state.next_to(primitive_id)` is true, only a single 'USE' action is needed.\n  # This is the most efficient and direct way to collect.\n  if current_state.next_to(primitive_id):\n      return [ACTION_USE]\n\n  # 3. Breadth-First Search (BFS) for the Shortest Path\n  # The BFS aims to find the shortest sequence of movement actions from the agent's\n  # starting position to any cell from which the target primitive can be collected\n  # (i.e., a cell adjacent to the primitive).\n\n  # The queue stores tuples: (current_position (row, column), list_of_actions_taken_to_reach_here).\n  q = collections.deque([(agent_start_pos, [])]) \n  # The `visited` set tracks already explored positions to prevent cycles and ensure\n  # that the first path found is indeed the shortest one (for unweighted graph traversal).\n  visited = {agent_start_pos} \n\n  # Variables to store the shortest path found and a flag indicating success.\n  shortest_path_to_adjacent_pos = [] \n  target_reachable = False \n\n  while q:\n      (current_r, current_c), path_actions_so_far = q.popleft()\n\n      # To check if `current_pos` (the position dequeued from BFS) is adjacent to the primitive,\n      # we temporarily simulate the agent being at `(current_r, current_c)` and use `next_to`.\n      # We create a `CraftState` object for this purpose, copying relevant parts of the\n      # current environment state. The grid, scenario, world, direction, and inventory\n      # remain constant during pathfinding; only the position varies.\n      temp_state = craft.CraftState(\n          scenario=current_state.scenario,\n          grid=grid,\n          pos=(current_r, current_c),\n          dir=current_state.dir,      \n          inventory=current_state.inventory \n      )\n\n      # If the agent, when at `(current_r, current_c)`, is next to the primitive,\n      # we have found the shortest path to a valid collection point.\n      if temp_state.next_to(primitive_id):\n          shortest_path_to_adjacent_pos = path_actions_so_far\n          target_reachable = True\n          break  # Exit BFS immediately as the shortest path is found.\n\n      # Explore all four cardinal neighbors from the current position.\n      for (dr, dc), action_to_take in MOVEMENT_DIRECTIONS:\n          next_r, next_c = current_r + dr, current_c + dc\n          next_pos = (next_r, next_c)\n\n          # --- Validity Checks for the Potential Next Position ---\n          # Check 1: Boundary Check - Ensure `next_pos` is within the grid boundaries.\n          if not (0 <= next_r < grid_width and 0 <= next_c < grid_height):\n              continue\n\n          # Check 2: Traversability Check - Ensure `next_pos` is not an impassable obstacle.\n          # An obstacle is any cell occupied by a non-grabbable item (e.g., \"WATER\", \"BOUNDARY\").\n          is_traversable = True\n          for kind_idx in env.world.non_grabbable_indices:\n              if grid[next_r, next_c, kind_idx] == 1: # Check if this cell contains a non-grabbable item.\n                  is_traversable = False\n                  break\n          if not is_traversable:\n              continue # If it's an obstacle, skip this neighbor.\n\n          # Check 3: Visited Check - Avoid re-queueing positions that have already been visited.\n          # This is essential for BFS to find the shortest path and prevent infinite loops.\n          if next_pos not in visited:\n              visited.add(next_pos)\n              # Add the valid, unvisited neighbor to the queue, extending the path.\n              q.append((next_pos, path_actions_so_far + [action_to_take]))\n\n  # 4. Construct the Final Action Sequence\n  final_actions_sequence = shortest_path_to_adjacent_pos\n\n  # If a path was successfully found to a cell adjacent to the primitive,\n  # append the 'USE' action. This completes the collection sequence.\n  if target_reachable:\n      final_actions_sequence.append(ACTION_USE)\n  \n  return final_actions_sequence", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T04:38:39.122506", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # Primitive name not found in the cookbook, so it cannot be collected.\n    return []\n\n  # 2. Semantic check: Ensure the item is actually grabbable and collectible via 'USE'.\n  # The 'collect' action in the DSL implies acquiring the item into inventory.\n  # This typically applies to items in `world.grabbable_indices` (e.g., WOOD, IRON)\n  # and also to WATER and STONE, which require a tool but are collected via 'USE'.\n  # Other non-grabbable items (like WORKSHOPS, BOUNDARIES) are not \"collected\" in this sense.\n  is_primitive_grabbable = i_kind in world.grabbable_indices\n  is_primitive_water_or_stone = (i_kind == world.water_index or i_kind == world.stone_index)\n  \n  if not (is_primitive_grabbable or is_primitive_water_or_stone):\n    # This primitive cannot be collected via the 'USE' action.\n    return []\n\n  # 3. Define action integers and direction deltas\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # Map CraftState.dir (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT) to (dr, dc) of the cell directly in front\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col\n      1: (0, 1),  # RIGHT: row, col + 1\n      2: (1, 0),  # DOWN: row + 1, col\n      3: (0, -1)  # LEFT: row, col - 1\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  def get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return []\n      \n      turning_actions = []\n      # Calculate the difference in directions (modulo 4 for circularity)\n      # A positive difference means clockwise turns, negative means counter-clockwise.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP -> RIGHT)\n          turning_actions.append(RIGHT_ACT)\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP -> LEFT)\n          turning_actions.append(LEFT_ACT)\n      else: # diff == 2, 180-degree turn (e.g., UP -> DOWN)\n          # Two consecutive right turns (or two left turns)\n          turning_actions.append(RIGHT_ACT)\n          turning_actions.append(RIGHT_ACT)\n      return turning_actions\n\n  # BFS setup\n  # Queue stores tuples of (CraftState object, list of actions to reach this state)\n  q = collections.deque()\n  # Visited set stores (position_x, position_y, direction) to avoid cycles and redundant work.\n  # This accurately captures the agent's state for pathfinding.\n  visited = set()\n\n  # Add the initial state to the queue\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Maximum states to explore to prevent infinite loops or excessively long searches.\n  # Total unique (pos, dir) states is grid_width * grid_height * 4.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 2 # A multiplier for robustness\n\n  explored_states_count = 0\n\n  while q:\n    state, path = q.popleft()\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop exploring this path.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    # Check if we can collect the primitive from this state by turning and using.\n    # We iterate through all 4 possible directions the agent could *turn to face*.\n    for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n        # Calculate the coordinates of the cell directly in front if agent faces `target_dir`\n        dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n        facing_r, facing_c = state.pos[0] + dr, state.pos[1] + dc\n\n        # Check if the calculated facing cell is within grid bounds\n        # AND if it contains the desired primitive.\n        if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n            state.grid[facing_r, facing_c, i_kind] == 1):\n            \n            # We found a primitive that can be faced and used.\n            # Calculate the sequence of actions to turn from the current direction (`state.dir`)\n            # to the `target_dir` needed to face the primitive.\n            turns = get_turning_actions(state.dir, target_dir)\n            \n            # The complete sequence of actions is:\n            # (path to current state) + (turning actions) + (USE action)\n            return path + turns + [USE_ACT]\n\n    # If the primitive is not directly collectible from this state,\n    # explore possible movement actions from the current state.\n    for action in move_actions:\n      # Simulate the action to get the next state.\n      # `state.step(action)` handles all internal game logic like collisions,\n      # updating position, direction, etc.\n      _, next_state = state.step(action)\n\n      # Create a unique key for the next state to check if it has been visited.\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        # Add the next state and its path to the queue for further exploration.\n        q.append((next_state, path + [action]))\n\n  # If the queue is exhausted and no path to collect the primitive was found, return an empty list.\n  return []", "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T04:38:40.300269", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # Primitive name not found in the cookbook, so it cannot be collected.\n    return []\n\n  # 2. Semantic check: Ensure the item is actually grabbable and collectible via 'USE'.\n  # This implies items in `world.grabbable_indices` or `water`/`stone` via 'USE'.\n  is_primitive_grabbable = i_kind in world.grabbable_indices\n  is_primitive_water_or_stone = (i_kind == world.water_index or i_kind == world.stone_index)\n  \n  if not (is_primitive_grabbable or is_primitive_water_or_stone):\n    # This primitive cannot be collected via the 'USE' action.\n    return []\n\n  # 3. Define action integers and direction deltas\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # Map CraftState.dir (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT) to (dr, dc) of the cell directly in front\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col\n      1: (0, 1),  # RIGHT: row, col + 1\n      2: (1, 0),  # DOWN: row + 1, col\n      3: (0, -1)  # LEFT: row, col - 1\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  def get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return []\n      \n      turning_actions = []\n      # Calculate the difference in directions (modulo 4 for circularity)\n      # A positive difference means clockwise turns, negative means counter-clockwise.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP -> RIGHT)\n          turning_actions.append(RIGHT_ACT)\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP -> LEFT)\n          turning_actions.append(LEFT_ACT)\n      else: # diff == 2, 180-degree turn (e.g., UP -> DOWN)\n          # Two consecutive right turns (or two left turns)\n          turning_actions.append(RIGHT_ACT)\n          turning_actions.append(RIGHT_ACT)\n      return turning_actions\n\n  # BFS setup\n  # Queue stores tuples of (CraftState object, list of actions to reach this state)\n  q = collections.deque()\n  # Visited set stores (position_x, position_y, direction) to avoid cycles and redundant work.\n  # This accurately captures the agent's state for pathfinding.\n  visited = set()\n\n  # Add the initial state to the queue\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Maximum states to explore to prevent infinite loops or excessively long searches.\n  # Total unique (pos, dir) states is grid_width * grid_height * 4.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 2 # A multiplier for robustness\n\n  explored_states_count = 0\n\n  while q:\n    state, path = q.popleft()\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop exploring this path.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    # --- Start of improvement for v2: Use `state.next_to` for early checking ---\n    # Check if the primitive is within the 3x3 neighborhood of the agent.\n    # If it is not, no amount of turning will help, so we can directly proceed to explore movement actions.\n    if state.next_to(i_kind):\n        # If nearby, then iterate through all 4 possible directions the agent could *turn to face*.\n        for target_dir in range(4): \n            # Calculate the coordinates of the cell directly in front if agent faces `target_dir`\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = state.pos[0] + dr, state.pos[1] + dc\n\n            # Check if the calculated facing cell is within grid bounds\n            # AND if it contains the desired primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # We found a primitive that can be faced and used.\n                # Calculate the sequence of actions to turn from the current direction (`state.dir`)\n                # to the `target_dir` needed to face the primitive.\n                turns = get_turning_actions(state.dir, target_dir)\n                \n                # The complete sequence of actions is:\n                # (path to current state) + (turning actions) + (USE action)\n                return path + turns + [USE_ACT]\n    # --- End of improvement for v2 ---\n\n    # If the primitive is not directly collectible from this state (either not nearby,\n    # or nearby but not in a directly faceable cell), explore possible movement actions.\n    for action in move_actions:\n      # Simulate the action to get the next state.\n      # `state.step(action)` handles all internal game logic like collisions,\n      # updating position, direction, etc.\n      _, next_state = state.step(action)\n\n      # Create a unique key for the next state to check if it has been visited.\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        # Add the next state and its path to the queue for further exploration.\n        q.append((next_state, path + [action]))\n\n  # If the queue is exhausted and no path to collect the primitive was found, return an empty list.\n  return []", "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T04:39:29.943034", "function_name": "collect", "function_body": "  actions = []\n  \n  # Get the current state directly for grid and position information\n  current_state = env._current_state \n  grid = current_state.grid\n  current_pos = current_state.pos\n  \n  # Get the integer ID of the primitive from the cookbook index\n  # This will raise a KeyError if the primitive name is not valid.\n  primitive_id = env.world.cookbook.index[primitive]\n\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Retrieve action mapping from the environment for robustness\n  action_map = env.action_specs()\n  DOWN = action_map['DOWN']\n  UP = action_map['UP']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Define movement deltas for the 4 cardinal directions\n  DELTAS = {\n      UP: (-1, 0),    # Row decreases when moving UP\n      DOWN: (1, 0),   # Row increases when moving DOWN\n      LEFT: (0, -1),  # Column decreases when moving LEFT\n      RIGHT: (0, 1)   # Column increases when moving RIGHT\n  }\n\n  # 1. Find all locations of the target primitive on the grid\n  primitive_locations = []\n  for r in range(WIDTH):\n      for c in range(HEIGHT):\n          # Check if the primitive_id occupies this cell\n          if grid[r, c, primitive_id] == 1:\n              primitive_locations.append((r, c))\n\n  # If the primitive is not found anywhere on the grid, no actions can be taken.\n  if not primitive_locations:\n      return []\n\n  # 2. Perform Breadth-First Search (BFS) to find the shortest path\n  #    to a cell that is cardinally adjacent to any primitive location.\n  # The queue stores tuples: ((current_row, current_col), [list_of_actions_to_reach_here])\n  q = collections.deque([(current_pos, [])]) \n  visited = {current_pos} # Set to keep track of visited positions to avoid cycles and redundant work\n\n  target_adj_pos_path = None # Stores the action path to the adjacent cell once found\n\n  while q:\n      (r, c), path = q.popleft()\n\n      # Check if the current position (r, c) is cardinally adjacent to any of the primitive locations.\n      # Being adjacent means we can 'USE' the primitive from here.\n      for pr, pc in primitive_locations:\n          # Manhattan distance of 1 indicates direct adjacency (up, down, left, or right)\n          if abs(r - pr) + abs(c - pc) == 1: \n              target_adj_pos_path = path # This is the shortest path to an adjacent cell\n              break # Found the shortest path, exit this inner loop\n      \n      if target_adj_pos_path is not None:\n          break # Exit BFS, as the optimal path has been found\n\n      # Explore valid neighboring cells (UP, DOWN, LEFT, RIGHT)\n      for action_dir, (dr, dc) in DELTAS.items():\n          nr, nc = r + dr, c + dc # Calculate the new potential position\n          next_pos = (nr, nc)\n\n          # Check 1: Ensure the new position is within the grid boundaries\n          if not (0 <= nr < WIDTH and 0 <= nc < HEIGHT):\n              continue\n          \n          # Check 2: Ensure the new position is traversable.\n          # A cell is non-traversable if it contains any item whose kind index\n          # is in the world's non_grabbable_indices set (e.g., BOUNDARY, WATER, WORKSHOP structures).\n          is_traversable = True\n          for i_kind in env.world.non_grabbable_indices:\n              if grid[nr, nc, i_kind] == 1: # If this cell contains a non-grabbable item\n                  is_traversable = False\n                  break # This neighbor is an obstacle\n          \n          if not is_traversable:\n              continue # Skip this neighbor if it's an obstacle\n          \n          # Check 3: If the neighbor has not been visited, add it to the queue\n          if next_pos not in visited:\n              visited.add(next_pos)\n              new_path = path + [action_dir]\n              q.append((next_pos, new_path))\n    \n  # 3. Construct the final sequence of actions.\n  #    If a path to an adjacent cell was found, extend the actions list with this path\n  #    and then append a 'USE' action if the primitive is grabbable.\n  if target_adj_pos_path is not None:\n      actions.extend(target_adj_pos_path)\n      \n      # Only append the 'USE' action if the primitive is an item that can be picked up.\n      # Some \"primitives\" like 'WORKSHOP' or 'WATER' are not grabbable.\n      if primitive_id in current_state.world.grabbable_indices:\n          actions.append(USE) \n  \n  return actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T04:39:31.012759", "function_name": "collect", "function_body": "  actions = []\n  \n  # Get the current state directly for grid and position information\n  current_state = env._current_state \n  grid = current_state.grid\n  current_pos = current_state.pos\n  \n  # Get the integer ID of the primitive from the cookbook index\n  primitive_id = env.world.cookbook.index[primitive]\n\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Retrieve action mapping from the environment for robustness\n  _action_specs = env.action_specs()\n  DOWN = _action_specs['DOWN']\n  UP = _action_specs['UP']\n  LEFT = _action_specs['LEFT']\n  RIGHT = _action_specs['RIGHT']\n  USE = _action_specs['USE']\n\n  # Define movement deltas for convenience for the 4 cardinal directions\n  DELTAS = {\n      UP: (-1, 0),\n      DOWN: (1, 0),\n      LEFT: (0, -1),\n      RIGHT: (0, 1)\n  }\n\n  # 1. Find all locations of the target primitive on the grid using numpy.where\n  # This is a more idiomatic and potentially faster way to find coordinates in a NumPy array.\n  row_indices, col_indices = np.where(grid[:, :, primitive_id] == 1)\n  primitive_locations = list(zip(row_indices, col_indices))\n\n  # If the primitive is not found anywhere on the grid, return an empty list\n  if not primitive_locations:\n      return []\n\n  # 2. Perform Breadth-First Search (BFS) to find the shortest path\n  #    to a cell cardinally adjacent to any primitive location.\n  # Queue stores tuples: ((current_row, current_col), [list_of_actions_to_reach_here])\n  q = collections.deque([(current_pos, [])]) \n  visited = {current_pos} # Set to keep track of visited positions to avoid cycles\n\n  target_adj_pos_path = None # Stores the path to the adjacent cell once found\n\n  while q:\n      (r, c), path = q.popleft()\n\n      # Check if the current position (r, c) is cardinally adjacent to any of the primitive locations.\n      # Manhattan distance of 1 means cells are directly adjacent (horizontally or vertically).\n      # If the agent starts already adjacent, 'path' will be empty and this condition will be met.\n      for pr, pc in primitive_locations:\n          if abs(r - pr) + abs(c - pc) == 1: \n              target_adj_pos_path = path \n              break # Found the shortest path to an adjacent cell, so break from this inner loop\n      \n      if target_adj_pos_path is not None:\n          break # Exit BFS, as the shortest path to an adjacent cell has been found\n\n      # Explore valid neighbors (UP, DOWN, LEFT, RIGHT)\n      for action_dir, (dr, dc) in DELTAS.items():\n          nr, nc = r + dr, c + dc # New potential position\n          next_pos = (nr, nc)\n\n          # Check bounds: Ensure the new position is within the grid boundaries\n          if not (0 <= nr < WIDTH and 0 <= nc < HEIGHT):\n              continue\n          \n          # Check traversability:\n          # A cell is considered non-traversable if it contains any item\n          # whose kind index is in the world's non_grabbable_indices set (e.g., BOUNDARY, WATER, WORKSHOP structures).\n          is_traversable = True\n          for i_kind in env.world.non_grabbable_indices:\n              if grid[nr, nc, i_kind] == 1: # If this cell contains a non-grabbable item\n                  is_traversable = False\n                  break # This neighbor is an obstacle\n          \n          if not is_traversable:\n              continue # Skip this neighbor if it's an obstacle\n          \n          # If the neighbor has not been visited, add it to the queue\n          if next_pos not in visited:\n              visited.add(next_pos)\n              new_path = path + [action_dir]\n              q.append((next_pos, new_path))\n    \n  # 3. If a path to an adjacent cell was found, extend the actions list with this path.\n  #    Then, append a 'USE' action if the primitive is meant to be \"collected\" into inventory.\n  #    For non-grabbable primitives like WORKSHOPs, 'USE' is still appropriate for interaction.\n  if target_adj_pos_path is not None:\n      actions.extend(target_adj_pos_path)\n      # Append USE only if the primitive is a grabbable item that adds to inventory.\n      # If the primitive is a workshop, 'USE' still makes sense for interaction,\n      # but it won't be in grabbable_indices. This function's name \"collect\" implies\n      # picking up, so restricting USE to grabbable items aligns with that.\n      if primitive_id in current_state.world.grabbable_indices:\n          actions.append(USE) \n  \n  return actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T04:40:19.291445", "function_name": "collect", "function_body": "  primitive_id = env.world.cookbook.index[primitive]\n  \n  if primitive_id is None:\n      return []\n\n  state = env._current_state\n  current_pos = state.pos\n  current_dir = state.dir # Agent's initial facing direction (0=DOWN, 1=UP, 2=LEFT, 3=RIGHT)\n  grid = state.grid\n  \n  width, height, _ = grid.shape \n\n  actions_map = env.action_specs()\n  UP = actions_map['UP']\n  DOWN = actions_map['DOWN']\n  LEFT = actions_map['LEFT']\n  RIGHT = actions_map['RIGHT']\n  USE = actions_map['USE']\n\n  # Map action index (which also corresponds to a direction) to its (dr, dc) delta.\n  # These deltas represent both the movement if that action is taken, and the direction faced after.\n  direction_deltas = {\n      DOWN: (1, 0),\n      UP: (-1, 0),\n      LEFT: (0, -1),\n      RIGHT: (0, 1)\n  }\n\n  # BFS setup:\n  # Queue stores tuples: ((row, col, facing_direction_idx), [list_of_actions_to_reach_this_state])\n  q = collections.deque([((current_pos[0], current_pos[1], current_dir), [])]) \n  \n  # Visited set stores (row, col, facing_direction_idx) tuples to prevent revisiting states\n  visited = {(current_pos[0], current_pos[1], current_dir)}\n\n  while q:\n      (r, c, d), path_actions = q.popleft()\n\n      # 1. Check if the current (r, c, d) state allows for immediate collection via USE action.\n      # The USE action interacts with the cell directly in front of the agent.\n      dr_face, dc_face = direction_deltas[d] # Get delta for the direction agent is currently facing\n      target_r, target_c = r + dr_face, c + dc_face # Coordinates of the cell directly in front\n\n      # Ensure the target cell is within grid boundaries\n      if 0 <= target_r < width and 0 <= target_c < height:\n          # Check if the target cell contains the primitive we want to collect\n          if grid[target_r, target_c, primitive_id] > 0:\n              return path_actions + [USE] # Path found! Append USE action and return.\n\n      # 2. Explore movement neighbors (UP, DOWN, LEFT, RIGHT)\n      # Each movement action changes the agent's position and sets its new facing direction.\n      for move_action in [UP, DOWN, LEFT, RIGHT]:\n          next_dir = move_action # After moving, agent faces the direction it just moved\n          dr_move, dc_move = direction_deltas[move_action] # Delta for the movement itself\n\n          nr, nc = r + dr_move, c + dc_move # New row, new col after movement\n          next_state_tuple = (nr, nc, next_dir) # The new state (position and facing direction)\n\n          # a. Check if the next position (nr, nc) is within grid boundaries\n          if not (0 <= nr < width and 0 <= nc < height):\n              continue\n          \n          # b. Check for obstacles: A cell is considered an obstacle if it contains\n          #    any entity that is categorized as non-grabbable (impassable terrain/structures).\n          is_obstacle = False\n          for non_grabbable_id in env.world.non_grabbable_indices:\n              if grid[nr, nc, non_grabbable_id] > 0: # If the next cell contains a non-grabbable item...\n                  is_obstacle = True\n                  break # It's an obstacle, no need to check further for this cell\n          \n          if is_obstacle:\n              continue\n\n          # c. If the new state (position and facing direction) has not been visited, add it to the queue\n          if next_state_tuple not in visited:\n              visited.add(next_state_tuple)\n              q.append((next_state_tuple, path_actions + [move_action]))\n\n  # If the BFS completes and the primitive was not found anywhere reachable or collectable,\n  # return an empty list, indicating no path was found.\n  return []", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T04:40:20.604435", "function_name": "collect", "function_body": "  primitive_id = env.world.cookbook.index[primitive]\n  \n  # If the primitive name is not found in the cookbook's index, it cannot be collected.\n  if primitive_id is None:\n      return []\n\n  # Get the current state information from the environment\n  state = env._current_state\n  current_pos = state.pos\n  current_dir = state.dir # Agent's current facing direction (e.g., 0 for DOWN, 1 for UP, etc.)\n  grid = state.grid\n  \n  # Grid dimensions (WIDTH, HEIGHT, n_kinds)\n  width, height, _ = grid.shape \n\n  # Retrieve action mappings for movement and 'USE' from the environment's action_specs\n  actions_map = env.action_specs()\n  UP = actions_map['UP']\n  DOWN = actions_map['DOWN']\n  LEFT = actions_map['LEFT']\n  RIGHT = actions_map['RIGHT']\n  USE = actions_map['USE']\n\n  # Map direction index (which is also the action index for movement) to its (dr, dc) delta.\n  # These deltas represent the change in position when moving, and also the relative position\n  # of the cell directly in front of the agent when facing that direction.\n  direction_deltas_map = {\n      DOWN: (1, 0),   # Moving/facing DOWN: row increases\n      UP: (-1, 0),    # Moving/facing UP: row decreases\n      LEFT: (0, -1),  # Moving/facing LEFT: column decreases\n      RIGHT: (0, 1)   # Moving/facing RIGHT: column increases\n  }\n\n  # Initialize Breadth-First Search (BFS):\n  # Queue stores tuples: ((row, col, facing_direction_idx), [list_of_actions_to_reach_this_state])\n  q = collections.deque([((current_pos[0], current_pos[1], current_dir), [])]) \n  \n  # Visited set stores (row, col, facing_direction_idx) tuples to prevent revisiting states\n  # and thus avoid infinite loops and redundant paths.\n  visited = {(current_pos[0], current_pos[1], current_dir)}\n\n  while q:\n      (r, c, d), path_actions = q.popleft() # Dequeue the current state and its path\n\n      # Check for immediate collection:\n      # The 'USE' action operates on the cell directly in front of the agent.\n      dr_face, dc_face = direction_deltas_map[d] # Get delta for the direction the agent is currently facing\n      target_r, target_c = r + dr_face, c + dc_face # Coordinates of the cell directly in front\n\n      # Ensure the target cell is within grid boundaries\n      if 0 <= target_r < width and 0 <= target_c < height:\n          # If the target cell contains the primitive we want to collect (count > 0)...\n          if grid[target_r, target_c, primitive_id] > 0:\n              # ...we have found a path! Append the 'USE' action and return the complete sequence.\n              return path_actions + [USE]\n\n      # Explore movement options (UP, DOWN, LEFT, RIGHT) from the current state.\n      # Each movement action results in a new position and a new facing direction.\n      for move_action in [UP, DOWN, LEFT, RIGHT]:\n          # After executing a movement action, the agent's new facing direction is the direction of that movement.\n          next_dir = move_action \n          \n          # Get the displacement (change in row, change in column) for the chosen movement action.\n          dr_move, dc_move = direction_deltas_map[move_action] \n\n          # Calculate the new position after movement.\n          nr, nc = r + dr_move, c + dc_move \n          \n          # Form the tuple representing the next state (new position and new facing direction).\n          next_state_tuple = (nr, nc, next_dir) \n\n          # 1. Boundary check: Ensure the next position (nr, nc) is within the grid limits.\n          if not (0 <= nr < width and 0 <= nc < height):\n              continue # Skip this move as it goes out of bounds.\n          \n          # 2. Obstacle check: Determine if the next position is traversable.\n          # A cell is considered an obstacle if it contains any non-grabbable environment item\n          # (e.g., WATER, WORKSHOP) AND that specific item is NOT the primitive we are trying to collect.\n          # This allows the agent to move onto a cell if the primitive itself is an environment item\n          # (e.g., moving onto a \"stone\" block if \"stone\" is the primitive to collect).\n          is_obstacle = False\n          for env_item_id in env.world.cookbook.environment:\n              # If an environment item is present at the next position...\n              if grid[nr, nc, env_item_id] > 0:\n                  # ...and this environment item is NOT the primitive we are looking for (meaning it's a true barrier)...\n                  if env_item_id != primitive_id:\n                      is_obstacle = True\n                      break # It's an obstacle, no need to check further environment items for this cell.\n          \n          if is_obstacle:\n              continue # Cannot move to this cell due to an untraversable obstacle.\n\n          # 3. Visited check: If this new state (position and facing direction) has not been visited before,\n          #    add it to the visited set and enqueue it for future exploration.\n          if next_state_tuple not in visited:\n              visited.add(next_state_tuple) # Mark as visited\n              # Enqueue the new state along with the updated path (current path + the move action).\n              q.append((next_state_tuple, path_actions + [move_action]))\n\n  # If the BFS completes and the queue becomes empty without finding a path to collect the primitive,\n  # it implies the primitive is either unreachable or not present in the environment.\n  return []", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T04:41:35.032394", "function_name": "collect", "function_body": "  actions = []\n\n  # Get primitive index and action mappings\n  try:\n    primitive_idx = env.world.cookbook.index[primitive]\n  except KeyError:\n    # Primitive name not recognized, cannot collect.\n    return []\n\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  current_state = env._current_state\n  start_pos = current_state.pos  # Agent's starting (row, col) position\n  start_dir = current_state.dir  # Agent's starting direction (0=South, 1=North, 2=West, 3=East)\n  global_grid = current_state.grid # The full grid representation of the world\n  GRID_WIDTH, GRID_HEIGHT, _ = global_grid.shape # Dimensions of the grid\n\n  # Classify the target primitive based on world attributes\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  # If not grabbable and not a workshop, it's considered an \"other non-grabbable\"\n  # like water or stone, which are typically environmental features.\n  is_other_non_grabbable = not is_grabbable and not is_workshop\n\n  # Movement deltas and resulting directions for each action.\n  # CraftState's step method automatically aligns agent direction with movement.\n  # So, moving UP results in facing North, DOWN in South, etc.\n  ACTION_DELTAS_AND_DIRS = {\n      ACTION_UP: ((-1, 0), 1),    # Move UP (row-1), new direction is North (1)\n      ACTION_DOWN: ((1, 0), 0),   # Move DOWN (row+1), new direction is South (0)\n      ACTION_LEFT: ((0, -1), 2),  # Move LEFT (col-1), new direction is West (2)\n      ACTION_RIGHT: ((0, 1), 3)   # Move RIGHT (col+1), new direction is East (3)\n  }\n\n  # Delta for the cell directly in front of the agent, based on current direction.\n  # This is crucial for determining where the 'USE' action will apply.\n  DIRECTION_TO_FORWARD_DELTA = {\n      0: (1, 0),  # Facing South (0): (row+1, col) is in front\n      1: (-1, 0), # Facing North (1): (row-1, col) is in front\n      2: (0, -1), # Facing West (2): (row, col-1) is in front\n      3: (0, 1)   # Facing East (3): (row, col+1) is in front\n  }\n  \n  def cell_has_primitive(r: int, c: int, p_idx: int) -> bool:\n      \"\"\"Checks if a given grid cell (r, c) is within boundaries and contains the primitive.\"\"\"\n      if not (0 <= r < GRID_WIDTH and 0 <= c < GRID_HEIGHT):\n          return False\n      return global_grid[r, c, p_idx] > 0\n\n  def is_adjacent_to_primitive(r: int, c: int, p_idx: int) -> bool:\n      \"\"\"Checks if a given grid cell (r, c) is adjacent (8-way) to the primitive.\"\"\"\n      for dr in [-1, 0, 1]:\n          for dc in [-1, 0, 1]:\n              if dr == 0 and dc == 0: continue # Skip current cell\n              nr, nc = r + dr, c + dc\n              if cell_has_primitive(nr, nc, p_idx):\n                  return True\n      return False\n\n  def is_walkable(r: int, c: int) -> bool:\n      \"\"\"\n      Checks if a given grid cell (r, c) is within boundaries and can be walked onto by the agent.\n      This function takes into account the type of primitive being targeted for collection.\n      \"\"\"\n      if not (0 <= r < GRID_WIDTH and 0 <= c < GRID_HEIGHT):\n          return False\n      \n      # Check if the cell contains any general non-grabbable obstacle.\n      # This includes water, stone, and other fixed environmental features that block movement.\n      for kind_idx in env.world.non_grabbable_indices:\n          if global_grid[r, c, kind_idx] > 0: # If this kind of obstacle is present at (r,c)\n              # EXCEPTION: If the obstacle is the *specific workshop* we are targeting,\n              # and our goal is to step onto it, then it is traversable.\n              if kind_idx == primitive_idx and is_workshop:\n                  continue # It's traversable for this specific goal (stepping onto a target workshop).\n              return False # Otherwise, it's a blocking obstacle.\n\n      # Also, cannot walk directly onto a cell that *itself* contains a grabbable primitive.\n      # Grabbable items (like WOOD, IRON) are collected by facing them and using 'USE' from an adjacent cell.\n      if is_grabbable and cell_has_primitive(r, c, primitive_idx):\n          return False\n\n      return True\n\n  # --- Breadth-First Search (BFS) for pathfinding ---\n  # Queue stores tuples: ((current_position (r,c), current_direction (int)), path_so_far (list of actions))\n  # The agent's current direction is part of the state because the 'USE' action depends on facing.\n  queue = collections.deque([((start_pos, start_dir), [])])\n  \n  # Visited set: Stores (position (r,c), direction (int)) tuples to avoid revisiting states and infinite loops.\n  visited = {(start_pos, start_dir)}\n\n  shortest_path_to_action_pos = None # This will store the sequence of actions to reach the target state.\n  \n  while queue:\n      (current_pos, current_dir_val), path_so_far = queue.popleft()\n      r, c = current_pos\n\n      # Check if the current state satisfies the collection goal based on primitive type.\n      goal_satisfied = False\n      if is_grabbable:\n          # Goal for grabbable items: Agent must be adjacent to and facing the item.\n          fwd_dr, fwd_dc = DIRECTION_TO_FORWARD_DELTA[current_dir_val]\n          target_r, target_c = r + fwd_dr, c + fwd_dc\n          if cell_has_primitive(target_r, target_c, primitive_idx):\n              goal_satisfied = True\n      elif is_workshop:\n          # Goal for workshops: Agent must be on the workshop cell.\n          if cell_has_primitive(r, c, primitive_idx):\n              goal_satisfied = True\n      elif is_other_non_grabbable:\n          # Goal for other non-grabbables (e.g., WATER, STONE): Agent must be adjacent to the primitive.\n          if is_adjacent_to_primitive(r, c, primitive_idx):\n              goal_satisfied = True\n\n      if goal_satisfied:\n          shortest_path_to_action_pos = path_so_far\n          break # Found the shortest path to an actionable state.\n\n      # Explore valid neighboring states by performing movement actions.\n      for action_val, (move_delta, new_dir_val) in ACTION_DELTAS_AND_DIRS.items():\n          dr, dc = move_delta\n          next_r, next_c = r + dr, c + dc\n          next_pos = (next_r, next_c)\n          next_state_tuple = (next_pos, new_dir_val)\n\n          # Only add to queue if the next position is walkable and this specific (pos, dir) state\n          # has not been visited yet.\n          if is_walkable(next_r, next_c) and next_state_tuple not in visited:\n              visited.add(next_state_tuple)\n              queue.append((next_state_tuple, path_so_far + [action_val]))\n  \n  # Construct the final sequence of actions\n  if shortest_path_to_action_pos is not None:\n      if is_grabbable:\n          # For grabbable items, append the 'USE' action at the end to collect them.\n          actions = shortest_path_to_action_pos + [ACTION_USE]\n      elif is_workshop or is_other_non_grabbable:\n          # For workshops and other non-grabbables, reaching the target cell or adjacency\n          # is sufficient for \"collection\"; no 'USE' action is needed.\n          actions = shortest_path_to_action_pos\n  \n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T04:41:36.160841", "function_name": "collect", "function_body": "  try:\n    primitive_idx = env.world.cookbook.index[primitive]\n  except KeyError:\n    # Primitive name not recognized, cannot collect.\n    return []\n\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  current_state = env._current_state\n  start_pos = current_state.pos  # Agent's starting (row, col) position\n  start_dir = current_state.dir  # Agent's starting direction (0=South, 1=North, 2=West, 3=East)\n  global_grid = current_state.grid # The full grid representation of the world\n  GRID_ROWS, GRID_COLS, _ = global_grid.shape # Dimensions of the grid (WIDTH, HEIGHT are usually X, Y, so here it's (rows, cols))\n\n  # Categorize the primitive based on its type and how it's interacted with.\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  # Other non-grabbables like WATER, STONE, BOUNDARY are just \"environmental\" and typically occupy a cell.\n  # \"Collection\" for them means being on their cell.\n\n  # Movement deltas and resulting directions for each action\n  # The values for `new_dir_val` correspond to CraftState.dir: 0=South, 1=North, 2=West, 3=East.\n  ACTION_DELTAS_AND_DIRS = {\n      ACTION_UP: ((-1, 0), 1),    # Move UP (row-1), new direction is North (dir=1)\n      ACTION_DOWN: ((1, 0), 0),   # Move DOWN (row+1), new direction is South (dir=0)\n      ACTION_LEFT: ((0, -1), 2),  # Move LEFT (col-1), new direction is West (dir=2)\n      ACTION_RIGHT: ((0, 1), 3)   # Move RIGHT (col+1), new direction is East (dir=3)\n  }\n\n  # Delta for the cell directly in front of the agent, based on current direction.\n  # This is crucial for determining where the 'USE' action will apply for grabbable items.\n  DIRECTION_TO_FORWARD_DELTA = {\n      0: (1, 0),  # Facing South: (row+1, col) is in front\n      1: (-1, 0), # Facing North: (row-1, col) is in front\n      2: (0, -1), # Facing West: (row, col-1) is in front\n      3: (0, 1)   # Facing East: (row, col+1) is in front\n  }\n\n  # Indices of entities that generally block agent movement.\n  # This set includes things like boundary, water, stone, and fixed workshops IF NOT THE TARGET.\n  # Note: env.world.non_grabbable_indices includes workshops.\n  blocking_obstacle_indices = env.world.non_grabbable_indices\n\n  def is_walkable(r: int, c: int, target_primitive_idx: int) -> bool:\n      \"\"\"\n      Checks if a given grid cell (r, c) is within boundaries and can be walked onto by the agent.\n      \"\"\"\n      # 1. Check grid boundaries\n      if not (0 <= r < GRID_ROWS and 0 <= c < GRID_COLS):\n          return False\n      \n      # 2. Check for blocking obstacles at the target cell (r, c).\n      # Iterate through all kinds of items that can be at (r,c) to check for blockages.\n      for kind_idx in range(global_grid.shape[2]): # Loop through all possible kind indices\n          if global_grid[r, c, kind_idx] > 0: # If this kind of item is present at (r,c)\n              # If it's a known non-grabbable blocking obstacle...\n              if kind_idx in blocking_obstacle_indices:\n                  # ...and it's NOT the specific workshop we are trying to reach (workshops are traversable)\n                  if not (kind_idx == target_primitive_idx and is_workshop):\n                      return False # It's an impassable obstacle.\n\n              # If it's a grabbable item that we are targeting, we cannot walk directly onto it.\n              # We need to be adjacent to 'USE' it.\n              if kind_idx == target_primitive_idx and is_grabbable:\n                  return False\n                  \n      return True\n  \n  # --- Breadth-First Search (BFS) for pathfinding ---\n  # Queue stores tuples: ( (current_position (r,c), current_direction (int)), path_so_far (list of actions) )\n  # The state includes direction because 'USE' action for grabbables depends on facing direction.\n  queue = collections.deque([((start_pos, start_dir), [])])\n  \n  # Visited set: Stores (position (r,c), direction (int)) tuples to avoid revisiting states and infinite loops.\n  visited = {(start_pos, start_dir)}\n\n  shortest_path_found = None # This will store the sequence of actions to reach the target state.\n  \n  while queue:\n      (current_pos, current_dir_val), path_so_far = queue.popleft()\n      r, c = current_pos\n\n      # Check if the current state satisfies the collection goal.\n      # Goal condition depends on the type of primitive.\n      goal_achieved = False\n      if is_grabbable:\n          # For grabbable items (e.g., WOOD, IRON), the agent needs to be adjacent and facing the item.\n          fwd_dr, fwd_dc = DIRECTION_TO_FORWARD_DELTA[current_dir_val]\n          target_r, target_c = r + fwd_dr, c + fwd_dc\n\n          # Check if the cell directly in front of the agent contains the grabbable primitive.\n          if (0 <= target_r < GRID_ROWS and \n              0 <= target_c < GRID_COLS and \n              global_grid[target_r, target_c, primitive_idx] > 0):\n              goal_achieved = True\n              shortest_path_found = path_so_far # Path to position for USE\n              \n      else: # This covers workshops and other non-grabbable environmental items.\n          # For these, the agent needs to be ON the cell containing the primitive.\n          if global_grid[r, c, primitive_idx] > 0:\n              goal_achieved = True\n              shortest_path_found = path_so_far # Path to the target cell\n\n      if goal_achieved:\n          break # Found the shortest path to an actionable position/orientation.\n\n      # Explore valid neighboring states (movement actions).\n      for action_val, (move_delta, new_dir_val) in ACTION_DELTAS_AND_DIRS.items():\n          dr, dc = move_delta\n          next_r, next_c = r + dr, c + dc\n          next_pos = (next_r, next_c)\n          next_state_tuple = (next_pos, new_dir_val)\n\n          # Only add to queue if the next position is walkable (considering target type)\n          # and this specific (pos, dir) state has not been visited yet.\n          if is_walkable(next_r, next_c, primitive_idx) and next_state_tuple not in visited:\n              visited.add(next_state_tuple)\n              queue.append((next_state_tuple, path_so_far + [action_val]))\n  \n  final_actions = []\n  if shortest_path_found is not None:\n      # If a path was found:\n      if is_grabbable:\n          # For grabbable items, append the 'USE' action at the end to pick them up.\n          final_actions = shortest_path_found + [ACTION_USE]\n      else:\n          # For workshops and other non-grabbable environmental items,\n          # reaching the target cell is sufficient. No 'USE' action is needed.\n          final_actions = shortest_path_found\n  \n  return final_actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T04:42:33.267137", "function_name": "collect", "function_body": "  primitive_id = env.world.cookbook.index[primitive]\n  \n  # If the primitive name is not found in the cookbook's index, it cannot be collected.\n  if primitive_id is None:\n      return []\n\n  # Get the current state information from the environment\n  state = env._current_state\n  current_pos = state.pos # (r, c) tuple for agent's current position\n  grid = state.grid # The current grid layout\n  \n  # Grid dimensions (WIDTH, HEIGHT, n_kinds)\n  width, height, _ = grid.shape \n\n  # Retrieve action mappings for movement and 'USE' from the environment's action_specs\n  actions_map = env.action_specs()\n  UP = actions_map['UP']\n  DOWN = actions_map['DOWN']\n  LEFT = actions_map['LEFT']\n  RIGHT = actions_map['RIGHT']\n  USE = actions_map['USE']\n\n  # Initialize Breadth-First Search (BFS)\n  # The queue stores tuples: ((row, col), [list_of_actions_to_reach_this_position])\n  q = collections.deque([(current_pos, [])]) \n  # The visited set stores (row, col) tuples to prevent revisiting cells and infinite loops\n  visited = {current_pos}\n\n  # Define possible movements as (delta_row, delta_col, corresponding_action_index)\n  move_deltas = [\n      (1, 0, DOWN),  # Moving down increases the row index\n      (-1, 0, UP),   # Moving up decreases the row index\n      (0, 1, RIGHT), # Moving right increases the column index\n      (0, -1, LEFT)  # Moving left decreases the column index\n  ]\n\n  while q:\n      (r, c), path_actions = q.popleft()\n\n      # Check for collection opportunity at the current position (r, c):\n      # According to CraftState.next_to, the 'USE' action interacts with any item\n      # in the 3x3 neighborhood around the agent's current position.\n      collection_possible = False\n      # Iterate through all 9 cells (including the agent's current cell) in the 3x3 neighborhood\n      for dr_check in [-1, 0, 1]:\n          for dc_check in [-1, 0, 1]:\n              check_r, check_c = r + dr_check, c + dc_check\n\n              # Ensure the cell being checked is within grid boundaries\n              if 0 <= check_r < width and 0 <= check_c < height:\n                  # If the target primitive is found in this nearby cell\n                  if grid[check_r, check_c, primitive_id] > 0:\n                      collection_possible = True\n                      break # Primitive found in neighborhood, no need to check other cells in 3x3 area\n          if collection_possible:\n              break # Break outer loop too if collection is possible\n\n      if collection_possible:\n          # If the primitive is found in the 3x3 neighborhood of the current position,\n          # append the 'USE' action to the path and return the sequence.\n          return path_actions + [USE]\n\n\n      # Explore all valid neighbors from the current position (r, c)\n      for dr_move, dc_move, action in move_deltas:\n          nr, nc = r + dr_move, c + dc_move # Calculate the next row and column after a move\n          next_pos = (nr, nc)\n\n          # 1. Boundary check: Ensure the next position is within the grid limits\n          if not (0 <= nr < width and 0 <= nc < height):\n              continue # Skip this move if it goes out of bounds\n          \n          # 2. Obstacle check: Determine if the next position is blocked.\n          # A cell is considered an obstacle if it contains any entity from\n          # `non_grabbable_indices` that IS NOT the primitive we are trying to collect.\n          # This allows moving onto cells containing the target primitive itself,\n          # even if that primitive is categorized as non-grabbable (e.g., 'WATER').\n          is_obstacle = False\n          # Iterate through the known non-grabbable entities configured in the world\n          for obstacle_id in env.world.non_grabbable_indices:\n              # If a non-grabbable item is present at the next position...\n              if grid[nr, nc, obstacle_id] > 0:\n                  # ...and this item is not the primitive we are seeking (i.e., it's a true barrier)...\n                  if obstacle_id != primitive_id: \n                      is_obstacle = True\n                      break # It's an impassable obstacle, no need to check further obstacles for this cell\n          \n          if is_obstacle:\n              continue # Skip this cell as it's blocked by an obstacle\n\n          # 3. Visited check: Ensure this cell has not been visited before with a shorter path\n          # to avoid redundant paths and infinite loops.\n          if next_pos not in visited:\n              visited.add(next_pos) # Mark the new position as visited\n              # Add the next position and the updated path to the queue for further exploration\n              q.append((next_pos, path_actions + [action]))\n\n  # If the BFS completes and the primitive was not found anywhere reachable or collectable,\n  # return an empty list, indicating no path was found.\n  return []", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T04:42:34.667495", "function_name": "collect", "function_body": "  primitive_id = env.world.cookbook.index[primitive]\n  \n  if primitive_id is None:\n      # The requested primitive name does not exist in the cookbook's index.\n      return []\n\n  state = env._current_state\n  current_pos = state.pos\n  current_dir = state.dir # Agent's initial facing direction (0=DOWN, 1=UP, 2=LEFT, 3=RIGHT, assuming standard mapping)\n  grid = state.grid\n  \n  width, height, _ = grid.shape \n\n  actions_map = env.action_specs()\n  UP = actions_map['UP']\n  DOWN = actions_map['DOWN']\n  LEFT = actions_map['LEFT']\n  RIGHT = actions_map['RIGHT']\n  USE = actions_map['USE']\n\n  # Map action index (which also corresponds to a direction) to its (dr, dc) delta.\n  # These deltas represent both the movement if that action is taken, and the direction faced after.\n  # For example, if the agent moves DOWN, its new position is (r+1, c) and its new facing direction is DOWN.\n  direction_deltas = {\n      DOWN: (1, 0),\n      UP: (-1, 0),\n      LEFT: (0, -1),\n      RIGHT: (0, 1)\n  }\n\n  # BFS setup:\n  # The queue stores tuples: ((row, col, facing_direction_idx), [list_of_actions_to_reach_this_state])\n  # We need to track facing_direction because the 'USE' action depends on it.\n  q = collections.deque([((current_pos[0], current_pos[1], current_dir), [])]) \n  \n  # The visited set stores (row, col, facing_direction_idx) tuples to prevent revisiting states\n  # and infinite loops in the search.\n  visited = {(current_pos[0], current_pos[1], current_dir)}\n\n  while q:\n      (r, c, d), path_actions = q.popleft()\n\n      # 1. Check if the current (r, c, d) state allows for immediate collection via a 'USE' action.\n      # The 'USE' action interacts with the cell directly in front of the agent.\n      dr_face, dc_face = direction_deltas[d] # Get delta for the direction the agent is currently facing.\n      target_r, target_c = r + dr_face, c + dc_face # Coordinates of the cell directly in front of the agent.\n\n      # Ensure the target cell is within grid boundaries.\n      if 0 <= target_r < width and 0 <= target_c < height:\n          # Check if the target cell contains the primitive we want to collect.\n          if grid[target_r, target_c, primitive_id] > 0:\n              # Path found! Append the 'USE' action and return the complete sequence of actions.\n              return path_actions + [USE]\n\n      # 2. Explore movement neighbors (UP, DOWN, LEFT, RIGHT).\n      # Each movement action changes the agent's position and sets its new facing direction.\n      for move_action in [UP, DOWN, LEFT, RIGHT]:\n          next_dir = move_action # After moving, the agent faces the direction it just moved.\n          dr_move, dc_move = direction_deltas[move_action] # Delta for the movement itself.\n\n          nr, nc = r + dr_move, c + dc_move # New row, new col after movement.\n          next_state_tuple = (nr, nc, next_dir) # The new state (position and facing direction).\n\n          # a. Boundary check: Ensure the next position (nr, nc) is within grid boundaries.\n          if not (0 <= nr < width and 0 <= nc < height):\n              continue # Skip this move if it goes out of bounds.\n          \n          # b. Obstacle check: Determine if the next position is blocked.\n          # A cell is considered an obstacle if it contains any entity that is categorized as non-grabbable\n          # (e.g., BOUNDARY, WATER, WORKSHOP locations). These are generally impassable for movement.\n          is_obstacle = False\n          for non_grabbable_idx in env.world.non_grabbable_indices:\n              if grid[nr, nc, non_grabbable_idx] > 0: # If the next cell contains a non-grabbable item...\n                  is_obstacle = True\n                  break # It's an obstacle, no need to check further for this cell.\n          \n          if is_obstacle:\n              continue # Skip this move if the next cell is an obstacle.\n\n          # c. Visited check: If the new state (position and facing direction) has not been visited,\n          # add it to the queue for further exploration.\n          if next_state_tuple not in visited:\n              visited.add(next_state_tuple) # Mark the new state as visited.\n              q.append((next_state_tuple, path_actions + [move_action])) # Add to queue with updated path.\n\n  # If the BFS completes and the primitive was not found anywhere reachable or collectable,\n  # return an empty list, indicating no path was found.\n  return []", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T04:43:06.448987", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's initial position (row, col)\n  initial_dir = current_state.dir # Agent's initial facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook's index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Determine grid dimensions: num_rows corresponds to grid.shape[0], num_cols to grid.shape[1]\n  num_rows, num_cols, _ = initial_grid.shape\n\n  # Retrieve action mapping from the environment\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # Corresponds to moving forward in the current direction\n  TURN_LEFT_ACTION = action_map['LEFT']     # Corresponds to turning 90 degrees left\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Corresponds to turning 90 degrees right\n  USE_ACTION = action_map['USE']            # Action to interact with the cell in front\n\n  # Direction vectors (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  # (dr, dc) indicates how row and column change when moving \"forward\"\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # Mapping for updating agent's direction when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # RIGHT->UP->LEFT->DOWN->RIGHT\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # RIGHT->DOWN->LEFT->UP->RIGHT\n\n  # Get indices of entities that block agent movement (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # Helper function to check if a cell at (r, c) is valid for the agent to move into\n  def _is_valid_and_walkable(r: int, c: int) -> bool:\n      # Check if the coordinates are within the grid boundaries\n      if not (0 <= r < num_rows and 0 <= c < num_cols):\n          return False\n      \n      # Check if the cell contains any non-walkable entity (e.g., boundary, water, workshop)\n      # The agent cannot move onto these types of entities.\n      for kind_idx in non_walkable_kinds_indices:\n          if initial_grid[r, c, kind_idx] > 0:\n              return False\n      \n      # The agent cannot walk onto the primitive itself to collect it;\n      # it must be adjacent and then use the 'USE' action.\n      if initial_grid[r, c, primitive_id] > 0:\n          return False\n      \n      return True\n\n  # BFS initialization:\n  # Queue stores ( (current_position_tuple, current_direction_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (position_tuple, direction_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the sequence of actions to reach the state where the primitive is in front\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent from the current state\n      # If so, we've found a path to be adjacent and facing the primitive, so we can collect it with USE.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the cell in front is within grid boundaries\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n          # Check if the primitive is in this cell\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Path found! The agent is adjacent and facing the primitive.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right\n\n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Direction doesn't change when moving forward\n\n      # Check if the next position is valid and walkable, and if this state hasn't been visited\n      if _is_valid_and_walkable(next_r, next_c) and\\\n         (next_pos, next_dir) not in visited:\n          visited.add((next_pos, next_dir))\n          queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path to the target state was found, append the USE action to complete the collection\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T04:43:08.031805", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  \n  # Immutable state information for planning the path\n  initial_grid = current_state.grid\n  initial_agent_pos = current_state.pos  # Agent's initial position (row, col)\n  initial_agent_dir = current_state.dir  # Agent's initial facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive. This ID is used to locate it on the grid.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Grid dimensions for boundary checks\n  num_rows, num_cols, _ = initial_grid.shape\n\n  # Retrieve action mapping from the environment. These are constant integer IDs.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # 'UP' action moves agent forward in current direction\n  TURN_LEFT_ACTION = action_map['LEFT']     # 'LEFT' action turns agent 90 degrees left\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # 'RIGHT' action turns agent 90 degrees right\n  USE_ACTION = action_map['USE']            # 'USE' action interacts with cell in front\n\n  # Define direction vectors and turning rules for the agent's movement mechanics.\n  # DIR_TO_DRDC: Maps agent's direction (0-3) to a (delta_row, delta_column) vector,\n  # indicating the coordinates of the cell directly in front of the agent.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT (East): (row, col+1)\n      1: (-1, 0),  # Facing UP (North): (row-1, col)\n      2: (0, -1),  # Facing LEFT (West): (row, col-1)\n      3: (1, 0)    # Facing DOWN (South): (row+1, col)\n  }\n\n  # TURN_LEFT_MAP / TURN_RIGHT_MAP: Map current direction to the new direction after a turn.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # e.g., RIGHT(0) -> UP(1)\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # e.g., RIGHT(0) -> DOWN(3)\n\n  # Get indices of entities that the agent cannot walk onto.\n  # This includes boundaries, water, and workshops.\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # Helper function to determine if a grid cell is valid for the agent to occupy.\n  # The agent cannot move onto boundaries, water, workshops, or the primitive itself (it must be adjacent).\n  def _is_valid_and_walkable(r: int, c: int) -> bool:\n      # Check grid boundaries\n      if not (0 <= r < num_rows and 0 <= c < num_cols):\n          return False\n      \n      # Check if the cell contains any non-walkable entity\n      for kind_idx in non_walkable_kinds_indices:\n          if initial_grid[r, c, kind_idx] > 0:\n              return False\n      \n      # The agent cannot walk onto the primitive it intends to collect;\n      # collection happens from an adjacent cell using the 'USE' action.\n      if initial_grid[r, c, primitive_id] > 0:\n          return False\n      \n      return True\n\n  # BFS (Breadth-First Search) Initialization:\n  # The queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_here)\n  # This represents a state (agent's position and orientation) and the path (sequence of actions) to achieve it.\n  queue = collections.deque([((initial_agent_pos, initial_agent_dir), [])])\n  \n  # The 'visited' set stores (position_tuple, direction_int) to prevent redundant exploration\n  # and cycles, ensuring the shortest path is found.\n  visited = {(initial_agent_pos, initial_agent_dir)}\n\n  target_path_to_adjacency = None # This variable will store the action sequence if a path is found.\n\n  # Start BFS traversal\n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the target primitive is directly in front of the agent from the current state.\n      # This is the \"goal state\" for our pathfinding: being positioned to interact with the primitive.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the cell directly in front is within grid boundaries before checking its contents.\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n          # If the primitive is present in this cell, we have found a path that leads the agent\n          # to be adjacent to and facing the primitive.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path_to_adjacency = path_so_far\n              break # Path found! Terminate BFS as we found the shortest path.\n\n      # 2. Explore all possible next actions (Move Forward, Turn Left, Turn Right) from the current state.\n\n      # --- Try Move Forward Action ---\n      # Calculate the next position if the agent moves forward. Direction remains unchanged.\n      next_r, next_c = r + DIR_TO_DRDC[current_dir][0], c + DIR_TO_DRDC[current_dir][1]\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change orientation.\n\n      # Check if the potential next position is valid and walkable, and this new state has not been visited yet.\n      if _is_valid_and_walkable(next_r, next_c) and\\\n         (next_pos, next_dir) not in visited:\n          visited.add((next_pos, next_dir))\n          queue.append(((next_pos, next_dir), path_so_far + [MOVE_FORWARD_ACTION]))\n\n      # --- Try Turn Left Action ---\n      # Calculate the new direction after turning left. Position remains unchanged.\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      if ((current_pos, next_dir_left) not in visited):\n          # Add the new state to the queue and mark as visited.\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_so_far + [TURN_LEFT_ACTION]))\n\n      # --- Try Turn Right Action ---\n      # Calculate the new direction after turning right. Position remains unchanged.\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      if ((current_pos, next_dir_right) not in visited):\n          # Add the new state to the queue and mark as visited.\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_so_far + [TURN_RIGHT_ACTION]))\n\n  # After BFS completes:\n  # If a path to the target (adjacent to and facing the primitive) was found,\n  # extend the found path with the final 'USE' action to collect the primitive.\n  # If no path was found (target_path_to_adjacency is None), an empty list is returned,\n  # indicating the primitive is unreachable from the current state.\n  if target_path_to_adjacency is not None:\n      actions_list.extend(target_path_to_adjacency)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T04:44:39.340594", "function_name": "collect", "function_body": "  \"\"\"Returns a list of actions to find and collect the primitive in the passed env.\n\n    This function uses a Breadth-First Search (BFS) to find the shortest sequence of\n    movement actions to reach a position from which the target primitive can be\n    collected using the 'USE' action. Once such a position is found, it calculates\n    the necessary turning actions to face the primitive and then appends the 'USE' action.\n\n    Args:\n        env (env.CraftLab): The CraftLab object representing the current environment.\n        primitive (str): The name of the primitive resource to collect (e.g., \"wood\", \"iron\").\n\n    Returns:\n        List[int]: A sequence of action indices (integers) to execute to collect the primitive.\n                   Returns an empty list if the primitive cannot be found or collected,\n                   or if a path is too long to find within defined limits.\n  \"\"\"\n  current_state = env._current_state\n  world = env.world # Access the CraftWorld instance for cookbook and indices\n\n  # 1. Get the integer ID for the primitive from the cookbook's index.\n  # Convert the primitive name to lowercase as per common practice for lookups.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Semantic check: Determine if the identified item is actually collectible via 'USE'.\n  # This includes grabbable items (like 'wood', 'iron') and special resources like 'water'/'stone'.\n  # Items like workshops or boundaries are not \"collected\" in this manner.\n  is_primitive_grabbable = i_kind in world.grabbable_indices\n  is_primitive_water_or_stone = (i_kind == world.water_index or i_kind == world.stone_index)\n\n  if not (is_primitive_grabbable or is_primitive_water_or_stone):\n    # This item is not designed to be collected using the 'USE' action in the game.\n    return []\n\n  # 3. Define action integer IDs from the environment's action specifications.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  # List of actions that change the agent's position.\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # 4. Helper mapping: Relates agent's facing direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (delta_row, delta_column) coordinates of the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (e.g., (r,c) facing UP sees (r-1,c))\n      1: (0, 1),  # RIGHT: row, col + 1\n      2: (1, 0),  # DOWN: row + 1, col\n      3: (0, -1)  # LEFT: row, col - 1\n  }\n\n  # 5. Helper function: Calculates the shortest sequence of turning actions.\n  # This is crucial because turning takes 'time' (actions) but doesn't change position.\n  def get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the correct direction\n\n      turning_actions = []\n      # Calculate the difference in directions, accounting for circularity (0-3).\n      # `diff` represents the number of clockwise turns needed.\n      diff = (target_dir - current_dir + 4) % 4\n\n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          turning_actions.append(RIGHT_ACT)\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          turning_actions.append(LEFT_ACT)\n      else: # diff == 2, a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # This can be achieved with two consecutive right turns or two left turns.\n          turning_actions.append(RIGHT_ACT)\n          turning_actions.append(RIGHT_ACT)\n      return turning_actions\n\n  # 6. BFS Setup:\n  # `q`: A deque to store (CraftState object, list of actions to reach this state).\n  # `visited`: A set to keep track of explored states (agent_row, agent_col, agent_direction)\n  #            to prevent cycles and redundant exploration. Including direction is vital\n  #            as the agent's facing direction affects which cells it can interact with.\n  q = collections.deque()\n  visited = set()\n\n  # Start the BFS from the current environment state.\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir))\n\n  # Get grid dimensions for boundary checks and setting exploration limits.\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Maximum states to explore to prevent excessively long searches or infinite loops\n  # in very complex or unachievable scenarios. This bounds the search.\n  # The total number of unique (position, direction) states is WIDTH * HEIGHT * 4.\n  # Multiplied by a factor (e.g., 2) for robustness.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 2\n  explored_states_count = 0\n\n  # 7. BFS Main Loop:\n  while q:\n    state, path = q.popleft() # Dequeue the next state and its path\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop this path to prevent runaway searches.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue\n\n    # Goal Check: From the current `state` (agent at `state.pos` and facing `state.dir`),\n    # check if the primitive can be collected by turning and using.\n    # We iterate through all 4 possible directions the agent *could turn to face*.\n    for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n        # Calculate the coordinates of the cell that would be directly in front\n        # if the agent were to turn to `target_dir`.\n        dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n        facing_r, facing_c = state.pos[0] + dr, state.pos[1] + dc\n\n        # Check if the calculated 'facing' cell is within grid bounds\n        # AND if that cell currently contains the desired primitive.\n        if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and\n            state.grid[facing_r, facing_c, i_kind] == 1):\n\n            # If the primitive is found in a cell that can be faced,\n            # calculate the minimum turns required to face it from the current `state.dir`.\n            turns = get_turning_actions(state.dir, target_dir)\n\n            # The complete sequence of actions is:\n            # (path taken to reach `state`) + (turning actions) + (USE action).\n            return path + turns + [USE_ACT]\n\n    # If the primitive is not directly collectible from this `state` by just turning,\n    # explore possible movement actions from the current `state` to find a new position.\n    for action in move_actions:\n      # Simulate the action: `state.step(action)` returns the reward (unused here)\n      # and the `next_state` object. `state.step` creates a new `CraftState` instance,\n      # ensuring immutability for BFS exploration.\n      _, next_state = state.step(action)\n\n      # Create a unique key for the `next_state` to check against the `visited` set.\n      # This key must include position and direction.\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir)\n\n      if next_state_key not in visited:\n        # If this state hasn't been visited before, mark it as visited and add to the queue.\n        visited.add(next_state_key)\n        q.append((next_state, path + [action])) # Append the action to the path\n\n  # 8. No Path Found:\n  # If the BFS queue becomes empty and no path to collect the primitive was found,\n  # it means the primitive is unreachable or cannot be collected.\n  return []", "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T04:44:40.465362", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # Primitive name not found in the cookbook, so it cannot be collected.\n    return []\n\n  # 2. Semantic check: Ensure the item is actually grabbable and collectible via 'USE'.\n  # The 'collect' action in the DSL implies acquiring the item into inventory.\n  # This typically applies to items in `world.grabbable_indices` (e.g., WOOD, IRON)\n  # and also to WATER and STONE, which require a tool but are collected via 'USE'.\n  # Other non-grabbable items (like WORKSHOPS, BOUNDARIES) are not \"collected\" in this sense.\n  is_primitive_grabbable = i_kind in world.grabbable_indices\n  is_primitive_water_or_stone = (i_kind == world.water_index or i_kind == world.stone_index)\n  \n  if not (is_primitive_grabbable or is_primitive_water_or_stone):\n    # This primitive cannot be collected via the 'USE' action.\n    return []\n\n  # 3. Define action integers and direction deltas\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # Map CraftState.dir (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT) to (dr, dc) of the cell directly in front\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col\n      1: (0, 1),  # RIGHT: row, col + 1\n      2: (1, 0),  # DOWN: row + 1, col\n      3: (0, -1)  # LEFT: row, col - 1\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  def get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return []\n      \n      turning_actions = []\n      # Calculate the difference in directions (modulo 4 for circularity)\n      # A positive difference means clockwise turns, negative means counter-clockwise.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP -> RIGHT)\n          turning_actions.append(RIGHT_ACT)\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP -> LEFT)\n          turning_actions.append(LEFT_ACT)\n      else: # diff == 2, 180-degree turn (e.g., UP -> DOWN)\n          # Two consecutive right turns (or two left turns)\n          turning_actions.append(RIGHT_ACT)\n          turning_actions.append(RIGHT_ACT)\n      return turning_actions\n\n  # BFS setup\n  # Queue stores tuples of (CraftState object, list of actions to reach this state)\n  q = collections.deque()\n  # Visited set stores (position_x, position_y, direction) to avoid cycles and redundant work.\n  # This accurately captures the agent's state for pathfinding.\n  visited = set()\n\n  # Add the initial state to the queue\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Maximum states to explore to prevent infinite loops or excessively long searches.\n  # Total unique (pos, dir) states is grid_width * grid_height * 4.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 2 # A multiplier for robustness\n\n  explored_states_count = 0\n\n  while q:\n    state, path = q.popleft()\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop exploring this path.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    # Check if we can collect the primitive from this state by turning and using.\n    # We iterate through all 4 possible directions the agent could *turn to face*.\n    for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n        # Calculate the coordinates of the cell directly in front if agent faces `target_dir`\n        dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n        facing_r, facing_c = state.pos[0] + dr, state.pos[1] + dc\n\n        # Check if the calculated facing cell is within grid bounds\n        # AND if it contains the desired primitive.\n        if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n            state.grid[facing_r, facing_c, i_kind] == 1):\n            \n            # We found a primitive that can be faced and used.\n            # Calculate the sequence of actions to turn from the current direction (`state.dir`)\n            # to the `target_dir` needed to face the primitive.\n            turns = get_turning_actions(state.dir, target_dir)\n            \n            # The complete sequence of actions is:\n            # (path to current state) + (turning actions) + (USE action)\n            return path + turns + [USE_ACT]\n\n    # If the primitive is not directly collectible from this state,\n    # explore possible movement actions from the current state.\n    for action in move_actions:\n      # Simulate the action to get the next state.\n      # `state.step(action)` handles all internal game logic like collisions,\n      # updating position, direction, etc.\n      _, next_state = state.step(action)\n\n      # Create a unique key for the next state to check if it has been visited.\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        # Add the next state and its path to the queue for further exploration.\n        q.append((next_state, path + [action]))\n\n  # If the queue is exhausted and no path to collect the primitive was found, return an empty list.\n  return []", "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T04:45:38.408905", "function_name": "collect", "function_body": "  current_state = env._current_state\n  \n  # Get the integer index for the desired primitive.\n  # This will raise a KeyError if the primitive name is not known.\n  primitive_idx = env.world.cookbook.index.index(primitive)\n  \n  # Retrieve action mappings for clarity and correct usage of action indices.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # 1. Immediate collection check:\n  # If the agent is already within the 3x3 neighborhood (including its own cell)\n  # of the primitive, it can directly use/collect it.\n  if current_state.next_to(primitive_idx):\n    return [USE]\n\n  # 2. Identify all grid locations where the primitive currently exists.\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  primitive_on_grid_locations = []\n  for x in range(grid_width):\n    for y in range(grid_height):\n      # Check if the primitive kind is present at this grid cell (count > 0).\n      if grid[x, y, primitive_idx] > 0:\n        primitive_on_grid_locations.append((x, y))\n\n  # If no instances of the primitive are found on the grid, it's not collectible from the world.\n  if not primitive_on_grid_locations:\n    return []\n\n  # 3. Define \"target collection cells\" for the BFS.\n  # A target cell is any cell from which the agent can successfully collect the primitive.\n  # This means any cell within the 3x3 neighborhood of a primitive location.\n  target_collection_cells = set()\n  for px, py in primitive_on_grid_locations:\n    # Iterate through all 3x3 neighbors (including (0,0) for the primitive's own cell).\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        gx, gy = px + dx, py + dy\n        # Ensure the potential target cell is within the grid boundaries.\n        if 0 <= gx < grid_width and 0 <= gy < grid_height:\n          target_collection_cells.add((gx, gy))\n\n  # 4. Determine which entity kinds make a cell impassable for agent movement.\n  # In CraftWorld, non-grabbable entities are typically impassable, with the\n  # exception of workshops, which are non-grabbable but usually traversable.\n  impassable_for_movement_kinds = set(env.world.non_grabbable_indices) - set(env.world.workshop_indices)\n\n  # 5. Perform Breadth-First Search (BFS) to find the shortest path\n  # from the agent's current position to any of the identified target collection cells.\n  start_pos = current_state.pos\n  \n  # BFS queue: stores tuples of (current_position, list_of_actions_taken_to_reach_here).\n  bfs_queue = collections.deque([(start_pos, [])]) \n  # Set to keep track of visited positions to prevent cycles and redundant exploration.\n  visited_positions = {start_pos} \n\n  # Define possible cardinal moves (delta_x, delta_y) and their corresponding action indices.\n  cardinal_movement_actions = [\n      ((0, -1), UP),    # Move North (decreases Y coordinate)\n      ((0, 1), DOWN),   # Move South (increases Y coordinate)\n      ((-1, 0), LEFT),  # Move West (decreases X coordinate)\n      ((1, 0), RIGHT),  # Move East (increases X coordinate)\n  ]\n\n  while bfs_queue:\n    (cx, cy), path_to_current = bfs_queue.popleft() # Get the current position and the path to it\n\n    # If the current position is one of our target collection cells, we have found the shortest path.\n    if (cx, cy) in target_collection_cells:\n      # Append the USE action, as the agent is now in a valid position to collect the primitive.\n      return path_to_current + [USE]\n\n    # Explore valid neighboring cells for movement (cardinal directions only).\n    for (dx, dy), action in cardinal_movement_actions:\n      nx, ny = cx + dx, cy + dy # Calculate the new potential position\n      next_pos = (nx, ny)\n\n      # Check if the new position is within the overall grid boundaries.\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue # Skip if out of bounds.\n\n      # Check if the new position is traversable (not impassable).\n      # A cell is considered impassable if it contains any of the `impassable_for_movement_kinds`.\n      is_cell_impassable = False\n      for k_idx in impassable_for_movement_kinds:\n          if grid[nx, ny, k_idx] > 0: # If this impassable kind is present at (nx, ny)\n              is_cell_impassable = True\n              break # No need to check other kinds, it's already impassable.\n      \n      if is_cell_impassable:\n          continue # Skip if the cell is impassable.\n\n      # If the new position is valid and has not been visited, add it to the queue for exploration.\n      if next_pos not in visited_positions:\n        visited_positions.add(next_pos)\n        bfs_queue.append((next_pos, path_to_current + [action]))\n\n  # If the BFS completes and the queue becomes empty without finding a path to any target cell,\n  # it means the primitive is unreachable from the current agent's position.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T04:45:39.525095", "function_name": "collect", "function_body": "  \"\"\"Returns a list of actions to find and collect the primitive in the passed env.\n    \n    This implementation uses Breadth-First Search (BFS) to find the shortest\n    path to a cell from which the primitive can be collected. It accounts for\n    impassable terrain and aims to be a robust solution.\n\n    Args:\n        env (env.CraftLab): The CraftLab object containing the current game state.\n        primitive (str): The name of the primitive item to collect (e.g., \"WOOD\", \"STONE\").\n\n    Returns:\n        List[int]: A sequence of action indices to execute (e.g., [UP, UP, USE]).\n                   An empty list is returned if the primitive is not found on the map,\n                   or if it is unreachable from the agent's current position.\n  \"\"\"\n  current_state = env._current_state\n  \n  # Map the string name of the primitive to its corresponding integer index\n  # used internally by the simulation. This will raise an error if the\n  # primitive name is not recognized, which is desired.\n  primitive_idx = env.world.cookbook.index.index(primitive)\n  \n  # Retrieve integer codes for fundamental movement and interaction actions.\n  # This makes the code more readable and robust to changes in action mapping.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # 1. Immediate Collection Check:\n  # If the agent is already in a position where it can interact with (collect)\n  # the primitive (i.e., within its 3x3 neighborhood), the only action needed is USE.\n  if current_state.next_to(primitive_idx):\n    return [USE]\n\n  # 2. Identify all physical locations of the primitive on the game grid.\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  primitive_grid_locations = []\n  for x in range(grid_width):\n    for y in range(grid_height):\n      # A primitive is present if its count at this (x,y) cell is greater than 0.\n      if grid[x, y, primitive_idx] > 0:\n        primitive_grid_locations.append((x, y))\n\n  # If no instances of the primitive are found anywhere on the grid,\n  # it cannot be collected, so return an empty list of actions.\n  if not primitive_grid_locations:\n    return []\n\n  # 3. Define \"Goal Cells\" for the BFS:\n  # A goal cell is any traversable cell from which the agent can successfully\n  # \"collect\" the primitive using the 'USE' action. Based on `CraftState.next_to`,\n  # this includes any cell within the 3x3 neighborhood of a primitive's location.\n  goal_cells = set()\n  for px, py in primitive_grid_locations:\n    # Iterate through all 3x3 neighbor offsets (including (0,0) for the primitive's own cell).\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        gx, gy = px + dx, py + dy\n        # Ensure the potential goal cell is within the grid boundaries.\n        if 0 <= gx < grid_width and 0 <= gy < grid_height:\n          goal_cells.add((gx, gy))\n\n  # 4. Determine which cell types are impassable for agent movement.\n  # Impassable kinds are typically non-grabbable items that are not designated\n  # as 'workshop' locations (which are usually traversable).\n  # Examples: water, stone, boundaries.\n  impassable_kinds = set(env.world.non_grabbable_indices) - set(env.world.workshop_indices)\n\n  # 5. Perform Breadth-First Search (BFS) to find the shortest path\n  # from the agent's current position to any of the identified goal cells.\n  start_pos = current_state.pos\n  \n  # BFS Queue: stores tuples of (current_position, list_of_actions_to_reach_this_position).\n  q = collections.deque([(start_pos, [])]) \n  # Set to keep track of visited positions to prevent infinite loops and redundant paths.\n  visited = {start_pos} \n\n  # Define possible cardinal movement directions and their corresponding action indices.\n  # CraftWorld typically uses 4-directional movement (UP, DOWN, LEFT, RIGHT).\n  DELTAS_ACTIONS = [\n      ((0, -1), UP),    # Move North (decreasing Y-coordinate)\n      ((0, 1), DOWN),   # Move South (increasing Y-coordinate)\n      ((-1, 0), LEFT),  # Move West (decreasing X-coordinate)\n      ((1, 0), RIGHT),  # Move East (increasing X-coordinate)\n  ]\n\n  while q:\n    # Dequeue the current position and the path leading to it.\n    (cx, cy), path_to_current = q.popleft() \n\n    # If the current position is one of our target goal cells, we've found the shortest path.\n    if (cx, cy) in goal_cells:\n      # Append the 'USE' action as the final step to collect the primitive.\n      return path_to_current + [USE]\n\n    # Explore all valid, unvisited, and traversable neighboring cells.\n    for (dx, dy), action in DELTAS_ACTIONS:\n      nx, ny = cx + dx, cy + dy # Calculate the new potential position.\n      new_pos = (nx, ny)\n\n      # Check 1: Boundary Check - Is the new position within the grid?\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue # Skip if out of bounds.\n\n      # Check 2: Impassability Check - Does the new position contain an impassable kind?\n      is_impassable_cell = False\n      for k_idx in impassable_kinds:\n          # If an impassable kind is present at the new cell, it's blocked.\n          if grid[nx, ny, k_idx] > 0: \n              is_impassable_cell = True\n              break # No need to check further kinds for this cell.\n      \n      if is_impassable_cell:\n          continue # Skip if the cell is impassable.\n\n      # Check 3: Visited Check - Has this position already been explored?\n      if new_pos not in visited:\n        visited.add(new_pos) # Mark as visited.\n        # Enqueue the new position along with the updated path.\n        q.append((new_pos, path_to_current + [action]))\n\n  # If the BFS queue becomes empty and no goal cell was reached,\n  # it means the primitive is unreachable from the agent's current position.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T04:47:05.859165", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # Primitive name not found in the cookbook, so it cannot be collected.\n    return []\n\n  # 2. Semantic check: Ensure the item is actually grabbable and collectible via 'USE'.\n  is_primitive_grabbable = i_kind in world.grabbable_indices\n  is_primitive_water_or_stone = (i_kind == world.water_index or i_kind == world.stone_index)\n  \n  if not (is_primitive_grabbable or is_primitive_water_or_stone):\n    # This primitive cannot be collected via the 'USE' action.\n    return []\n\n  # 3. Define action integers and direction deltas\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # Map CraftState.dir (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT) to (dr, dc) of the cell directly in front\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col\n      1: (0, 1),  # RIGHT: row, col + 1\n      2: (1, 0),  # DOWN: row + 1, col\n      3: (0, -1)  # LEFT: row, col - 1\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  def get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return []\n      \n      turning_actions = []\n      # Calculate the difference in directions (modulo 4 for circularity)\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP -> RIGHT)\n          turning_actions.append(RIGHT_ACT)\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP -> LEFT)\n          turning_actions.append(LEFT_ACT)\n      else: # diff == 2, 180-degree turn (e.g., UP -> DOWN)\n          turning_actions.append(RIGHT_ACT)\n          turning_actions.append(RIGHT_ACT)\n      return turning_actions\n\n  # BFS setup with parent pointers for efficient path reconstruction\n  # Queue stores tuples of (state_key, CraftState object)\n  q = collections.deque()\n  # Visited set stores (position_x, position_y, direction) to avoid cycles and redundant work.\n  visited = set()\n  # parent_info maps state_key -> (parent_state_key, action_from_parent_to_current)\n  parent_info = {} \n\n  # Initial state setup\n  initial_state_key = (current_state.pos[0], current_state.pos[1], current_state.dir)\n  q.append((initial_state_key, current_state))\n  visited.add(initial_state_key)\n  parent_info[initial_state_key] = (None, None) # The root state has no parent\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Maximum states to explore to prevent infinite loops or excessively long searches.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 2 # A multiplier for robustness\n\n  explored_states_count = 0\n\n  while q:\n    # Pop the current state key and the state object itself\n    state_key, state = q.popleft()\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop exploring this path.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c, current_dir = state_key # Unpack for convenience\n\n    # Check if we can collect the primitive from this state by turning and using.\n    if state.next_to(i_kind):\n        # If nearby, then iterate through all 4 possible directions the agent could *turn to face*.\n        for target_dir in range(4): \n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the calculated facing cell is within grid bounds\n            # AND if it contains the desired primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # We found a primitive that can be faced and used.\n                # Calculate the sequence of actions to turn from the current direction (`current_dir`)\n                # to the `target_dir` needed to face the primitive.\n                turns = get_turning_actions(current_dir, target_dir)\n                \n                # Reconstruct the path from the initial state to the current `state_key`\n                path_to_current_state = []\n                curr_reconstruct_key = state_key\n                while parent_info[curr_reconstruct_key][0] is not None: # Stop when we reach the initial state's key (parent is None)\n                    parent_key, action_from_parent = parent_info[curr_reconstruct_key]\n                    path_to_current_state.append(action_from_parent)\n                    curr_reconstruct_key = parent_key\n                path_to_current_state.reverse() # Path was built in reverse order, so reverse it\n\n                # The complete sequence of actions is:\n                # (path to current state) + (turning actions) + (USE action)\n                return path_to_current_state + turns + [USE_ACT]\n\n    # If the primitive is not directly collectible from this state,\n    # explore possible movement actions from the current state.\n    for action in move_actions:\n      # Simulate the action to get the next state.\n      # `state.step(action)` creates a new CraftState object and handles all game logic.\n      _, next_state = state.step(action) \n\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        parent_info[next_state_key] = (state_key, action) # Store parent and the action taken to reach this state\n        q.append((next_state_key, next_state)) # Add new state to queue for further exploration\n\n  # If the queue is exhausted and no path to collect the primitive was found, return an empty list.\n  return []", "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T04:47:07.157105", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # Primitive name not found in the cookbook, so it cannot be collected.\n    return []\n\n  # 2. Semantic check: Ensure the item is actually grabbable and collectible via 'USE'.\n  # This implies items in `world.grabbable_indices` or `water`/`stone` via 'USE'.\n  is_primitive_grabbable = i_kind in world.grabbable_indices\n  is_primitive_water_or_stone = (i_kind == world.water_index or i_kind == world.stone_index)\n  \n  if not (is_primitive_grabbable or is_primitive_water_or_stone):\n    # This primitive cannot be collected via the 'USE' action.\n    return []\n\n  # 3. Define action integers and direction deltas\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # Map CraftState.dir (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT) to (dr, dc) of the cell directly in front\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col\n      1: (0, 1),  # RIGHT: row, col + 1\n      2: (1, 0),  # DOWN: row + 1, col\n      3: (0, -1)  # LEFT: row, col - 1\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  def get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return []\n      \n      turning_actions = []\n      # Calculate the difference in directions (modulo 4 for circularity)\n      # A positive difference means clockwise turns, negative means counter-clockwise.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP -> RIGHT)\n          turning_actions.append(RIGHT_ACT)\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP -> LEFT)\n          turning_actions.append(LEFT_ACT)\n      else: # diff == 2, 180-degree turn (e.g., UP -> DOWN)\n          # Two consecutive right turns (or two left turns)\n          turning_actions.append(RIGHT_ACT)\n          turning_actions.append(RIGHT_ACT)\n      return turning_actions\n\n  # BFS setup\n  # Queue stores tuples of (CraftState object, list of actions to reach this state)\n  q = collections.deque()\n  # Visited set stores (position_x, position_y, direction) to avoid cycles and redundant work.\n  # This accurately captures the agent's state for pathfinding.\n  visited = set()\n\n  # Add the initial state to the queue\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Maximum states to explore to prevent infinite loops or excessively long searches.\n  # Total unique (pos, dir) states is grid_width * grid_height * 4.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 2 # A multiplier for robustness\n\n  explored_states_count = 0\n\n  while q:\n    state, path = q.popleft()\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop exploring this path.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    # Check if the primitive is within the 3x3 neighborhood of the agent.\n    # If it is not, no amount of turning will help to collect it from this position,\n    # so we can directly proceed to explore movement actions.\n    if state.next_to(i_kind):\n        # If nearby, then iterate through all 4 possible directions the agent could *turn to face*.\n        for target_dir in range(4): \n            # Calculate the coordinates of the cell directly in front if agent faces `target_dir`\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = state.pos[0] + dr, state.pos[1] + dc\n\n            # Check if the calculated facing cell is within grid bounds\n            # AND if it contains the desired primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # We found a primitive that can be faced and used.\n                # Calculate the sequence of actions to turn from the current direction (`state.dir`)\n                # to the `target_dir` needed to face the primitive.\n                turns = get_turning_actions(state.dir, target_dir)\n                \n                # The complete sequence of actions is:\n                # (path to current state) + (turning actions) + (USE action)\n                return path + turns + [USE_ACT]\n\n    # If the primitive is not directly collectible from this state (either not nearby,\n    # or nearby but not in a directly faceable cell), explore possible movement actions.\n    for action in move_actions:\n      # Simulate the action to get the next state.\n      # `state.step(action)` handles all internal game logic like collisions,\n      # updating position, direction, etc.\n      _, next_state = state.step(action)\n\n      # Create a unique key for the next state to check if it has been visited.\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        # Add the next state and its path to the queue for further exploration.\n        q.append((next_state, path + [action]))\n\n  # If the queue is exhausted and no path to collect the primitive was found, return an empty list.\n  return []", "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T04:48:26.089756", "function_name": "collect", "function_body": "  try:\n    # Get the integer index for the target primitive from the cookbook.\n    primitive_idx = env.world.cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # Map action names to their integer IDs for clarity.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Get the current state details from the environment.\n  current_state = env._current_state\n  start_pos = current_state.pos  # Agent's starting (row, col) position\n  start_dir = current_state.dir  # Agent's starting direction (0=South, 1=North, 2=West, 3=East)\n  global_grid = current_state.grid # The full grid representation of the world\n  GRID_WIDTH, GRID_HEIGHT, _ = global_grid.shape # Dimensions of the grid (WIDTH, HEIGHT)\n\n  # Determine if the primitive is a 'grabbable' item (e.g., wood, iron) that needs\n  # to be picked up using 'USE', or a 'non-grabbable' item (e.g., workshop, water, stone)\n  # which is \"collected\" by merely moving onto its cell.\n  primitive_is_grabbable = primitive_idx in env.world.grabbable_indices\n  \n  # Define how movement actions change the agent's position (dr, dc) and its new direction.\n  # The new_dir_val corresponds to CraftState.dir: 0=South, 1=North, 2=West, 3=East.\n  ACTION_DELTAS_AND_DIRS = {\n      ACTION_UP: ((-1, 0), 1),    # Move UP (row-1), new direction is North\n      ACTION_DOWN: ((1, 0), 0),   # Move DOWN (row+1), new direction is South\n      ACTION_LEFT: ((0, -1), 2),  # Move LEFT (col-1), new direction is West\n      ACTION_RIGHT: ((0, 1), 3)   # Move RIGHT (col+1), new direction is East\n  }\n\n  # Define the coordinate delta for the cell directly in front of the agent, based on its direction.\n  # This is crucial for determining the target cell for the 'USE' action.\n  DIRECTION_TO_FORWARD_DELTA = {\n      0: (1, 0),  # Facing South: (row+1, col) is in front\n      1: (-1, 0), # Facing North: (row-1, col) is in front\n      2: (0, -1), # Facing West: (row, col-1) is in front\n      3: (0, 1)   # Facing East: (row, col+1) is in front\n  }\n\n  # Get the indices of items that generally block agent movement (impassable obstacles).\n  non_grabbable_obstacles = env.world.non_grabbable_indices\n\n  def is_walkable(r: int, c: int) -> bool:\n      \"\"\"\n      Checks if a given grid cell (r, c) is within boundaries and can be safely walked onto by the agent.\n      This version explicitly handles grabbable/non-grabbable targets and general obstacles.\n      \"\"\"\n      # 1. Check grid boundaries.\n      if not (0 <= r < GRID_WIDTH and 0 <= c < GRID_HEIGHT):\n          return False\n      \n      # Get all item kinds present at this cell (r, c)\n      items_at_cell_indices = np.where(global_grid[r, c, :] > 0)[0]\n\n      # 2. Check rules based on whether the target primitive is grabbable or not.\n      if primitive_is_grabbable:\n          # If our target is a grabbable item (e.g., WOOD), we CANNOT walk onto its cell.\n          # We must be adjacent and USE it.\n          if primitive_idx in items_at_cell_indices:\n              return False\n      else: # primitive is non-grabbable (e.g., WORKSHOP0, WATER, STONE)\n          # If our target is a non-grabbable item, we *can* walk onto its cell to \"collect\" it.\n          # So, if this cell contains the non-grabbable target, it's NOT an obstacle related to the target itself.\n          # We proceed to check for other general obstacles.\n          pass \n\n      # 3. Check for any *other* non-grabbable obstacles (e.g., BOUNDARY, STONE, WATER, or\n      #    a WORKSHOP that is NOT our specific target WORKSHOP).\n      for item_idx_at_cell in items_at_cell_indices:\n          # An item at the cell is an obstacle (not walkable) if:\n          # a) It's generally a non-grabbable entity (like a wall, water, or workshop).\n          # b) AND it's NOT the specific non-grabbable primitive we are trying to collect.\n          #    (If it *is* our specific non-grabbable target, we *can* walk on it, handled by the 'not' clause).\n          if item_idx_at_cell in non_grabbable_obstacles and \\\n             not (item_idx_at_cell == primitive_idx and not primitive_is_grabbable):\n              return False # This is an impassable obstacle.\n\n      return True\n  \n  # --- Breadth-First Search (BFS) for optimal pathfinding ---\n  # The queue stores tuples: ( (current_position (r,c), current_direction (int)), path_so_far (list of actions) )\n  # The agent's direction is included in the state as the 'USE' action's effect depends on it.\n  queue = collections.deque([((start_pos, start_dir), [])])\n  \n  # The visited set stores (position (r,c), direction (int)) tuples to prevent revisiting states\n  # and falling into infinite loops.\n  visited = {(start_pos, start_dir)}\n\n  shortest_path_to_goal = None # This will store the sequence of actions to reach the target state.\n  \n  while queue:\n      (current_pos, current_dir_val), path_so_far = queue.popleft()\n      r, c = current_pos\n\n      # Check if the current state satisfies the collection goal.\n      if primitive_is_grabbable:\n          # For grabbable items (e.g., WOOD, IRON), the agent needs to be adjacent and facing the item.\n          fwd_dr, fwd_dc = DIRECTION_TO_FORWARD_DELTA[current_dir_val]\n          target_r, target_c = r + fwd_dr, c + fwd_dc\n\n          # Check if the cell directly in front of the agent contains the grabbable primitive.\n          if (0 <= target_r < GRID_WIDTH and \n              0 <= target_c < GRID_HEIGHT and \n              global_grid[target_r, target_c, primitive_idx] > 0):\n              shortest_path_to_goal = path_so_far\n              break # Found the shortest path to be in position and orientation to 'USE'.\n      else:\n          # For non-grabbable environmental items (e.g., WORKSHOP, WATER, STONE),\n          # the agent needs to be ON the cell containing the primitive.\n          if global_grid[r, c, primitive_idx] > 0:\n              shortest_path_to_goal = path_so_far\n              break # Found the shortest path to be on the target cell.\n\n      # Explore valid neighboring states by applying movement actions.\n      for action_val, (move_delta, new_dir_val) in ACTION_DELTAS_AND_DIRS.items():\n          dr, dc = move_delta\n          next_r, next_c = r + dr, c + dc\n          next_pos = (next_r, next_c)\n          next_state_tuple = (next_pos, new_dir_val)\n\n          # Only add to queue if the next position is walkable and this specific (pos, dir) state\n          # has not been visited yet.\n          if is_walkable(next_r, next_c) and next_state_tuple not in visited:\n              visited.add(next_state_tuple)\n              queue.append((next_state_tuple, path_so_far + [action_val]))\n  \n  final_actions = []\n  if shortest_path_to_goal is not None:\n      # If a path was found, determine the final actions.\n      if primitive_is_grabbable:\n          # For grabbable items, an additional 'USE' action is required to pick them up.\n          final_actions = shortest_path_to_goal + [ACTION_USE]\n      else:\n          # For non-grabbable environmental items, simply reaching the target cell is sufficient;\n          # no 'USE' action is needed.\n          final_actions = shortest_path_to_goal\n  \n  return final_actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T04:48:27.299908", "function_name": "collect", "function_body": "  try:\n    # Get the integer index for the target primitive from the cookbook.\n    primitive_idx = env.world.cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # Map action names to their integer IDs for clarity.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Get the current state details from the environment.\n  current_state = env._current_state\n  start_pos = current_state.pos  # Agent's starting (row, col) position\n  start_dir = current_state.dir  # Agent's starting direction (0=South, 1=North, 2=West, 3=East)\n  global_grid = current_state.grid # The full grid representation of the world\n  GRID_WIDTH, GRID_HEIGHT, _ = global_grid.shape # Dimensions of the grid (WIDTH, HEIGHT)\n\n  # Determine if the primitive is a 'grabbable' item (e.g., wood, iron) that needs\n  # to be picked up using 'USE', or a 'non-grabbable' item (e.g., workshop, water, stone)\n  # which is \"collected\" by merely moving onto its cell.\n  primitive_is_grabbable = primitive_idx in env.world.grabbable_indices\n  \n  # Define how movement actions change the agent's position (dr, dc) and its new direction.\n  # The new_dir_val corresponds to CraftState.dir: 0=South, 1=North, 2=West, 3=East.\n  ACTION_DELTAS_AND_DIRS = {\n      ACTION_UP: ((-1, 0), 1),    # Move UP (row-1), new direction is North\n      ACTION_DOWN: ((1, 0), 0),   # Move DOWN (row+1), new direction is South\n      ACTION_LEFT: ((0, -1), 2),  # Move LEFT (col-1), new direction is West\n      ACTION_RIGHT: ((0, 1), 3)   # Move RIGHT (col+1), new direction is East\n  }\n\n  # Define the coordinate delta for the cell directly in front of the agent, based on its direction.\n  # This is crucial for determining the target cell for the 'USE' action.\n  DIRECTION_TO_FORWARD_DELTA = {\n      0: (1, 0),  # Facing South: (row+1, col) is in front\n      1: (-1, 0), # Facing North: (row-1, col) is in front\n      2: (0, -1), # Facing West: (row, col-1) is in front\n      3: (0, 1)   # Facing East: (row, col+1) is in front\n  }\n\n  # Get the indices of items that generally block agent movement (impassable obstacles).\n  # These are entities like water, stone, and fixed workshops (unless the workshop is the target).\n  non_grabbable_obstacles = env.world.non_grabbable_indices\n\n  def is_walkable(r: int, c: int) -> bool:\n      \"\"\"\n      Checks if a given grid cell (r, c) is within boundaries and can be safely walked onto by the agent.\n      \"\"\"\n      # 1. Check grid boundaries.\n      if not (0 <= r < GRID_WIDTH and 0 <= c < GRID_HEIGHT):\n          return False\n      \n      # 2. Check for general non-grabbable obstacles.\n      for kind_idx in non_grabbable_obstacles:\n          if global_grid[r, c, kind_idx] > 0: # If this kind of obstacle is present at (r,c)\n              # Exception: If the obstacle is the *specific* non-grabbable primitive we are targeting,\n              # then we *are* allowed to walk onto it. (e.g., walking onto a WORKSHOP0 to \"collect\" it).\n              if not (kind_idx == primitive_idx and not primitive_is_grabbable):\n                  return False # It's an impassable obstacle AND not our special walkable target.\n      \n      # 3. Check for grabbable items on the cell.\n      # If the primitive we're looking for is grabbable (e.g., WOOD, IRON), we *cannot* walk directly\n      # onto its occupied cell. We must remain adjacent to 'USE' it.\n      if primitive_is_grabbable and global_grid[r,c,primitive_idx] > 0:\n          return False\n          \n      return True\n  \n  # --- V2 Improvement: Immediate check for goal satisfaction at the current state ---\n  # This optimizes for cases where the primitive is already reachable/collectible\n  # from the agent's current position and direction, avoiding a full BFS.\n  if primitive_is_grabbable:\n      fwd_dr, fwd_dc = DIRECTION_TO_FORWARD_DELTA[start_dir]\n      target_r, target_c = start_pos[0] + fwd_dr, start_pos[1] + fwd_dc\n      # Check if the cell directly in front of the agent contains the grabbable primitive.\n      if (0 <= target_r < GRID_WIDTH and \n          0 <= target_c < GRID_HEIGHT and \n          global_grid[target_r, target_c, primitive_idx] > 0):\n          # Agent is already adjacent and facing the grabbable primitive.\n          return [ACTION_USE]\n  else:\n      # For non-grabbable environmental items, check if the agent is already ON the cell.\n      if global_grid[start_pos[0], start_pos[1], primitive_idx] > 0:\n          return [] # Already \"collected\" by being on it.\n  # --- End V2 Improvement ---\n\n  # --- Breadth-First Search (BFS) for optimal pathfinding ---\n  # The queue stores tuples: ( (current_position (r,c), current_direction (int)), path_so_far (list of actions) )\n  # The agent's direction is included in the state as the 'USE' action's effect depends on it.\n  queue = collections.deque([((start_pos, start_dir), [])])\n  \n  # The visited set stores (position (r,c), direction (int)) tuples to prevent revisiting states\n  # and falling into infinite loops.\n  visited = {(start_pos, start_dir)}\n\n  shortest_path_to_goal = None # This will store the sequence of actions to reach the target state.\n  \n  while queue:\n      (current_pos, current_dir_val), path_so_far = queue.popleft()\n      r, c = current_pos\n\n      # Check if the current state satisfies the collection goal (for states reached during BFS).\n      if primitive_is_grabbable:\n          # For grabbable items (e.g., WOOD, IRON), the agent needs to be adjacent and facing the item.\n          fwd_dr, fwd_dc = DIRECTION_TO_FORWARD_DELTA[current_dir_val]\n          target_r, target_c = r + fwd_dr, c + fwd_dc\n\n          # Check if the cell directly in front of the agent contains the grabbable primitive.\n          if (0 <= target_r < GRID_WIDTH and \n              0 <= target_c < GRID_HEIGHT and \n              global_grid[target_r, target_c, primitive_idx] > 0):\n              shortest_path_to_goal = path_so_far\n              break # Found the shortest path to be in position and orientation to 'USE'.\n      else:\n          # For non-grabbable environmental items (e.g., WORKSHOP, WATER, STONE),\n          # the agent needs to be ON the cell containing the primitive.\n          if global_grid[r, c, primitive_idx] > 0:\n              shortest_path_to_goal = path_so_far\n              break # Found the shortest path to be on the target cell.\n\n      # Explore valid neighboring states by applying movement actions.\n      for action_val, (move_delta, new_dir_val) in ACTION_DELTAS_AND_DIRS.items():\n          dr, dc = move_delta\n          next_r, next_c = r + dr, c + dc\n          next_pos = (next_r, next_c)\n          next_state_tuple = (next_pos, new_dir_val)\n\n          # Only add to queue if the next position is walkable and this specific (pos, dir) state\n          # has not been visited yet.\n          if is_walkable(next_r, next_c) and next_state_tuple not in visited:\n              visited.add(next_state_tuple)\n              queue.append((next_state_tuple, path_so_far + [action_val]))\n  \n  final_actions = []\n  if shortest_path_to_goal is not None:\n      # If a path was found, determine the final actions.\n      if primitive_is_grabbable:\n          # For grabbable items, an additional 'USE' action is required to pick them up.\n          final_actions = shortest_path_to_goal + [ACTION_USE]\n      else:\n          # For non-grabbable environmental items, simply reaching the target cell is sufficient;\n          # no 'USE' action is needed.\n          final_actions = shortest_path_to_goal\n  \n  return final_actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T04:49:18.581810", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's initial position (row, col)\n  initial_dir = current_state.dir # Agent's initial facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook's index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Determine grid dimensions: num_rows corresponds to grid.shape[0], num_cols to grid.shape[1]\n  num_rows, num_cols, _ = initial_grid.shape\n\n  # Retrieve action mapping from the environment\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction vectors (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  # (dr, dc) indicates how row and column change when moving \"forward\"\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # Mapping for updating agent's direction when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # Get indices of entities that block agent movement (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # Helper function to check if a given cell (r, c) is walkable by the agent\n  def is_cell_walkable(r: int, c: int) -> bool:\n      # Check if the cell is within grid boundaries\n      if not (0 <= r < num_rows and 0 <= c < num_cols):\n          return False\n      \n      # Check if the cell contains any non-walkable entity (like boundaries, water, workshops)\n      for kind_idx in non_walkable_kinds_indices:\n          if initial_grid[r, c, kind_idx] > 0:\n              return False\n      \n      # The agent cannot walk onto the primitive itself, as it needs to be \"used\" from an adjacent square.\n      # This prevents the agent from occupying the same space as the collectible item.\n      if initial_grid[r, c, primitive_id] > 0:\n          return False\n          \n      return True\n\n  # BFS initialization:\n  # Queue stores ( (current_position_tuple, current_direction_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (position_tuple, direction_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the sequence of actions to reach the state where the primitive is in front\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent from the current state.\n      # If it is, then the agent is in a position to use the USE_ACTION to collect it.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the cell in front is within grid boundaries\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n          # Check if the primitive is present in the cell directly in front\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Path found! The agent is adjacent and facing the primitive.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right\n\n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Direction doesn't change when moving forward\n\n      # Check if the next position is walkable and this (position, direction) state hasn't been visited\n      if is_cell_walkable(next_r, next_c) and (next_pos, next_dir) not in visited:\n          visited.add((next_pos, next_dir))\n          queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path to the target state was found, append the USE action to complete the collection\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION) # Add the final USE action to collect the primitive\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T04:49:20.083921", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`. Finds the shortest sequence of actions to\n  navigate to a specified primitive and collect it using the 'USE' action.\n  \n  This function implements a Breadth-First Search (BFS) to find the optimal\n  sequence of movements and turns that places the agent directly in front of\n  the target primitive, followed by a 'USE' action to collect it.\n  \n  Args:\n      env (env.CraftLab): The CraftLab object representing the current simulation state.\n      primitive (str): The string name of the primitive item to be collected (e.g., \"WOOD\", \"STONE\", \"GRASS\").\n\n  Returns:\n      List[int]: A list of integer action codes (e.g., UP, LEFT, USE) that, when executed,\n                 will lead to the collection of the primitive. Returns an empty list\n                 if the primitive is unreachable from the current state.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's starting position (row, col)\n  initial_dir = current_state.dir # Agent's initial facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Resolve the string name of the primitive to its integer ID using the cookbook's index.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Get grid dimensions: num_rows corresponds to grid.shape[0], num_cols to grid.shape[1].\n  num_rows, num_cols, _ = initial_grid.shape\n\n  # Retrieve numerical action codes from the environment's action_specs.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define how movement changes row/column based on the agent's current direction.\n  # This maps an agent's direction (0=R, 1=U, 2=L, 3=D) to the (delta_row, delta_column)\n  # for moving \"forward\".\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: moves to (row, col+1)\n      1: (-1, 0),  # Facing UP: moves to (row-1, col)\n      2: (0, -1),  # Facing LEFT: moves to (row, col-1)\n      3: (1, 0)    # Facing DOWN: moves to (row+1, col)\n  }\n\n  # Define how turns update the agent's direction (clockwise order for turns).\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # RIGHT->UP->LEFT->DOWN->RIGHT\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # RIGHT->DOWN->LEFT->UP->RIGHT\n\n  # Get indices of entities that block agent movement (e.g., BOUNDARY, WATER, WORKSHOP_X).\n  # These are entities the agent cannot occupy a cell with.\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # Helper function to determine if the agent can move into a specific cell (r, c).\n  # A cell is walkable if it's within bounds and does not contain any non-walkable\n  # entities, including the primitive itself (as the agent needs to be adjacent to collect).\n  def _is_walkable_for_agent(r: int, c: int) -> bool:\n      # Check if coordinates are within the grid boundaries.\n      if not (0 <= r < num_rows and 0 <= c < num_cols):\n          return False\n      \n      # Check if the cell contains any entity that explicitly blocks agent movement.\n      for kind_idx in non_walkable_kinds_indices:\n          if initial_grid[r, c, kind_idx] > 0:\n              return False\n      \n      # The agent cannot move into the cell *occupied by* the primitive it wants to collect.\n      # It must be adjacent to it and use the 'USE' action. This prevents the agent from\n      # pathing directly over a collectible item.\n      if initial_grid[r, c, primitive_id] > 0:\n          return False\n          \n      return True\n\n  # Initialize Breadth-First Search (BFS) for finding the shortest path.\n  # The queue stores tuples: ((agent_position_tuple, agent_direction_int), list_of_actions_taken_so_far).\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # The visited set stores (agent_position_tuple, agent_direction_int) tuples to prevent\n  # re-exploring states already visited, ensuring the shortest path is found.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the optimal action sequence to reach the pre-collection state.\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Goal Check: Determine if the primitive is directly in front of the agent from the current state.\n      # This is the target condition: being adjacent to and facing the primitive, ready to 'USE'.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the cell in front is within grid boundaries before checking its contents.\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n          # If the primitive is present in the cell directly in front, we have found our target state.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Shortest path found, exit the BFS loop.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n\n      # Try Moving Forward (Action: MOVE_FORWARD_ACTION)\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Direction remains unchanged when moving forward.\n\n      # If the next cell is walkable and this specific (position, direction) state has not been visited,\n      # add it to the queue for future exploration.\n      if _is_walkable_for_agent(next_r, next_c) and (next_pos, next_dir) not in visited:\n          visited.add((next_pos, next_dir))\n          queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turning Left (Action: TURN_LEFT_ACTION)\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      next_pos_left = current_pos # Position does not change when turning.\n\n      # If this (position, new_direction) state has not been visited, add it to the queue.\n      if (next_pos_left, next_dir_left) not in visited:\n          visited.add((next_pos_left, next_dir_left))\n          queue.append(((next_pos_left, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turning Right (Action: TURN_RIGHT_ACTION)\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      next_pos_right = current_pos # Position does not change when turning.\n\n      # If this (position, new_direction) state has not been visited, add it to the queue.\n      if (next_pos_right, next_dir_right) not in visited:\n          visited.add((next_pos_right, next_dir_right))\n          queue.append(((next_pos_right, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path to the target pre-collection state was found (i.e., target_path is not None),\n  # append the final 'USE' action to complete the collection process.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION) # Add the crucial 'USE' action to collect the primitive.\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T04:50:24.848270", "function_name": "collect", "function_body": "  actions_to_take = []\n  current_state = env._current_state\n\n  # Extract essential information from the current state\n  grid = current_state.grid  # (rows, columns, kinds) numpy array\n  initial_agent_pos = current_state.pos  # (row, col) tuple\n  initial_agent_dir = current_state.dir  # int (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook's index.\n  # This mapping is crucial for identifying the primitive on the grid.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Determine grid dimensions for boundary checks.\n  num_rows, num_cols, _ = grid.shape\n\n  # Retrieve integer action IDs from the environment's action specifications.\n  # These are the numeric codes for actions the agent can perform.\n  action_map = env.action_specs()\n  ACTION_MOVE_FORWARD = action_map['UP']\n  ACTION_TURN_LEFT = action_map['LEFT']\n  ACTION_TURN_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define constants for agent directions and their corresponding (delta_row, delta_col) movements.\n  # This maps a direction integer to how coordinates change when moving \"forward\".\n  DIR_RIGHT = 0\n  DIR_UP = 1\n  DIR_LEFT = 2\n  DIR_DOWN = 3\n  \n  DIR_TO_DELTA_RC = {\n      DIR_RIGHT: (0, 1),   # (row, col+1)\n      DIR_UP: (-1, 0),     # (row-1, col)\n      DIR_LEFT: (0, -1),   # (row, col-1)\n      DIR_DOWN: (1, 0)     # (row+1, col)\n  }\n\n  # Define how agent's direction changes when turning left or right.\n  # Directions cycle: 0 -> 1 -> 2 -> 3 -> 0\n  TURN_LEFT_DIR_MAP = {\n      DIR_RIGHT: DIR_UP,\n      DIR_UP: DIR_LEFT,\n      DIR_LEFT: DIR_DOWN,\n      DIR_DOWN: DIR_RIGHT\n  }\n  TURN_RIGHT_DIR_MAP = {\n      DIR_RIGHT: DIR_DOWN,\n      DIR_UP: DIR_RIGHT,\n      DIR_LEFT: DIR_UP,\n      DIR_DOWN: DIR_LEFT\n  }\n\n  # Get indices of entities that block agent movement (e.g., BOUNDARY, WATER, WORKSHOP_X).\n  # The agent cannot walk onto cells containing these kinds.\n  # Convert to a tuple for efficient iteration and consistency.\n  non_walkable_kind_indices = tuple(current_state.world.non_grabbable_indices)\n\n  # Helper function to check if a given (row, col) is within the grid boundaries.\n  def is_within_bounds(r: int, c: int) -> bool:\n      return 0 <= r < num_rows and 0 <= c < num_cols\n\n  # Helper function to determine if the agent can move onto a specific cell.\n  # A cell is NOT walkable if it's out of bounds, contains any non-grabbable entity,\n  # or contains the target primitive itself (agent must be adjacent to 'use', not on top).\n  def is_cell_walkable(r: int, c: int) -> bool:\n      if not is_within_bounds(r, c):\n          return False\n      \n      # Agent cannot walk directly onto the primitive it wants to collect; it must \"use\" it from an adjacent cell.\n      if grid[r, c, primitive_id] > 0:\n          return False\n\n      # Check if the cell contains any non-grabbable entity that blocks movement.\n      if any(grid[r, c, kind_idx] > 0 for kind_idx in non_walkable_kind_indices):\n          return False\n          \n      return True\n\n  # BFS Initialization:\n  # The queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_to_reach_here).\n  queue = collections.deque([((initial_agent_pos, initial_agent_dir), [])])\n  \n  # The visited set stores (position_tuple, direction_int) to avoid redundant computations,\n  # prevent cycles, and ensure finding the shortest path (BFS guarantees this for unweighted graphs).\n  visited_states = {(initial_agent_pos, initial_agent_dir)}\n\n  path_to_primitive_adjacency = None # This will store the sequence of actions to reach the state where the primitive is in front.\n\n  while queue:\n      (current_pos, current_dir), path_taken = queue.popleft()\n      current_row, current_col = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent from the current state.\n      # If it is, we have found the target 'adjacency' state, and the path to reach it.\n      delta_r_front, delta_c_front = DIR_TO_DELTA_RC[current_dir]\n      front_cell_row, front_cell_col = current_row + delta_r_front, current_col + delta_c_front\n      \n      # Verify the cell in front is within bounds and contains the target primitive.\n      if (is_within_bounds(front_cell_row, front_cell_col) and \n          grid[front_cell_row, front_cell_col, primitive_id] > 0):\n          \n          path_to_primitive_adjacency = path_taken\n          break # Target found, exit the BFS loop.\n\n      # 2. Explore possible next actions (Move Forward, Turn Left, Turn Right)\n      #    from the current state and add valid, unvisited next states to the queue.\n\n      # A. Try Move Forward action:\n      next_row_move, next_col_move = current_row + delta_r_front, current_col + delta_c_front\n      next_pos_move = (next_row_move, next_col_move)\n      next_dir_move = current_dir # Agent's direction remains unchanged after moving straight.\n\n      if (is_cell_walkable(next_row_move, next_col_move) and\n          (next_pos_move, next_dir_move) not in visited_states):\n          \n          visited_states.add((next_pos_move, next_dir_move))\n          queue.append(((next_pos_move, next_dir_move), path_taken + [ACTION_MOVE_FORWARD]))\n\n      # B. Try Turn Left action:\n      next_dir_left = TURN_LEFT_DIR_MAP[current_dir]\n      # Agent's position remains unchanged when turning.\n      if ((current_pos, next_dir_left) not in visited_states):\n          visited_states.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_taken + [ACTION_TURN_LEFT]))\n\n      # C. Try Turn Right action:\n      next_dir_right = TURN_RIGHT_DIR_MAP[current_dir]\n      # Agent's position remains unchanged when turning.\n      if ((current_pos, next_dir_right) not in visited_states):\n          visited_states.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_taken + [ACTION_TURN_RIGHT]))\n\n  # After BFS completes:\n  # If a path to being adjacent to the primitive was found, append the 'USE' action\n  # to the collected path to finalize the primitive collection.\n  if path_to_primitive_adjacency is not None:\n      actions_to_take.extend(path_to_primitive_adjacency)\n      actions_to_take.append(ACTION_USE)\n\n  return actions_to_take", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T04:50:26.407135", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n  This function implements a Breadth-First Search (BFS) to find the shortest sequence\n  of actions required for the agent to move to a position adjacent to the specified\n  primitive and then collect it using the 'USE' action.\n\n  Improvements over v1 primarily focus on enhanced comment clarity and explicit\n  robustness in handling walkability conditions.\n    \n    Args:\n        env (env.CraftLab): The CraftLab object representing the current simulation state.\n        primitive (str): The string name of the primitive item to collect (e.g., \"WOOD\", \"STONE\", \"WATER\").\n\n    Returns:\n        List[int]: A sequence of integer action indices (e.g., MOVE_FORWARD, TURN_LEFT, USE).\n                   Returns an empty list if the primitive is unreachable or not found on the grid.\n  \"\"\"\n  actions_to_collect = []\n  # Access the current internal state of the environment.\n  # CraftState contains the grid, agent's position, direction, and inventory.\n  current_state = env._current_state \n\n  grid: np.ndarray = current_state.grid  # The current grid layout (numpy.ndarray: rows x cols x n_kinds)\n  initial_pos: tuple[int, int] = current_state.pos  # Agent's current position (row, col)\n  initial_dir: int = current_state.dir  # Agent's current facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook's index.\n  # This mapping is crucial for identifying the primitive on the grid.\n  primitive_id: int = current_state.world.cookbook.index[primitive]\n  num_rows, num_cols, _ = grid.shape # Grid dimensions for boundary checks\n\n  # Retrieve integer action IDs from the environment's action specifications.\n  # These numerical codes are used to control the agent's movements and interactions.\n  action_map: dict[str, int] = env.action_specs()\n  MOVE_FORWARD_ACTION: int = action_map['UP']    # Action to move forward in the current direction\n  TURN_LEFT_ACTION: int = action_map['LEFT']     # Action to turn 90 degrees left\n  TURN_RIGHT_ACTION: int = action_map['RIGHT']   # Action to turn 90 degrees right\n  USE_ACTION: int = action_map['USE']            # Action to interact with the cell directly in front\n\n  # Direction vectors (dr, dc) representing changes in row and column for each facing direction.\n  # This helps calculate the next position when moving forward or identifying the cell in front.\n  # Mapping: 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n  DIR_TO_DRDC: dict[int, tuple[int, int]] = {\n      0: (0, 1),   # Facing RIGHT: (row, col + 1)\n      1: (-1, 0),  # Facing UP: (row - 1, col)\n      2: (0, -1),  # Facing LEFT: (row, col - 1)\n      3: (1, 0)    # Facing DOWN: (row + 1, col)\n  }\n\n  # Mappings to update the agent's direction when turning left or right.\n  # Directions cycle: 0 -> 1 -> 2 -> 3 -> 0 for left turns.\n  #                or 0 -> 3 -> 2 -> 1 -> 0 for right turns.\n  TURN_LEFT_MAP: dict[int, int] = {0: 1, 1: 2, 2: 3, 3: 0}\n  TURN_RIGHT_MAP: dict[int, int] = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # Get indices of entities that block agent movement (e.g., BOUNDARY, WATER, WORKSHOP_X).\n  # These are defined as non-grabbable items in the cookbook's environment set.\n  # Convert to a list for efficient NumPy array indexing.\n  non_walkable_kind_indices: list[int] = list(current_state.world.non_grabbable_indices)\n\n  # --- Helper Functions for BFS ---\n\n  def _is_in_bounds(r: int, c: int) -> bool:\n      \"\"\"Checks if a given grid coordinate (r, c) is within the grid boundaries.\"\"\"\n      return 0 <= r < num_rows and 0 <= c < num_cols\n\n  def _is_cell_walkable(r: int, c: int) -> bool:\n      \"\"\"Determines if the agent can physically move onto a specific grid cell (r, c).\n      \n      A cell is considered NOT walkable if:\n      1. It is outside the grid boundaries.\n      2. It contains the target primitive itself. The agent must be adjacent to the primitive to 'USE' it,\n         not occupying the same cell. This applies even if the primitive is a \"grabbable\" item like WOOD.\n      3. It contains any entity explicitly marked as non-grabbable/non-walkable (e.g., walls, water, workshops).\n         These are general environmental obstacles.\n      \"\"\"\n      if not _is_in_bounds(r, c):\n          return False\n      \n      # Condition 2: Agent cannot walk onto the primitive it intends to collect.\n      # This check is crucial for primitives like WOOD or STONE, which are grabbable but not walkable.\n      if grid[r, c, primitive_id] > 0:\n          return False\n\n      # Condition 3: Check if the cell contains any known non-walkable environmental entity.\n      # `non_walkable_kind_indices` contains IDs of items from `cookbook.environment` (e.g., BOUNDARY, WORKSHOPS, WATER).\n      # `np.any()` checks if any of these non-walkable kinds are present in the specified cell.\n      if non_walkable_kind_indices and np.any(grid[r, c, non_walkable_kind_indices] > 0):\n          return False\n          \n      return True\n\n  # --- Breadth-First Search (BFS) Implementation ---\n\n  # The queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_to_reach_here)\n  # This composite structure allows tracking both the state and the path to reach it.\n  queue: collections.deque[tuple[tuple[tuple[int, int], int], list[int]]] = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # The visited set stores (position_tuple, direction_int) to prevent redundant computations and cycles.\n  # This is essential for ensuring the shortest path is found in an unweighted graph.\n  visited: set[tuple[tuple[int, int], int]] = {(initial_pos, initial_dir)}\n\n  # This variable will store the sequence of actions to reach a state where the primitive is directly in front.\n  path_to_target_adjacency: list[int] | None = None \n\n  while queue:\n      # Dequeue the current state (position and direction) and the path taken to reach it.\n      (current_pos, current_dir), path_taken = queue.popleft()\n      current_r, current_c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent from the current state.\n      # If this condition is met, we've found the optimal sequence of moves to get ready for the 'USE' action.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = current_r + front_dr, current_c + front_dc\n      \n      # Ensure the cell in front is within grid boundaries and contains the primitive.\n      if _is_in_bounds(front_r, front_c) and grid[front_r, front_c, primitive_id] > 0:\n          path_to_target_adjacency = path_taken\n          break # Shortest path to target adjacency found, terminate BFS.\n\n      # 2. Explore all valid next actions (Move Forward, Turn Left, Turn Right) from the current state.\n\n      # --- Try Move Forward Action ---\n      # Calculate the next position if the agent moves forward. Direction remains unchanged.\n      next_r_move, next_c_move = current_r + DIR_TO_DRDC[current_dir][0], current_c + DIR_TO_DRDC[current_dir][1]\n      next_pos_move: tuple[int, int] = (next_r_move, next_c_move)\n      next_dir_move: int = current_dir \n      next_state_move: tuple[tuple[int, int], int] = (next_pos_move, next_dir_move)\n\n      # If the next cell is walkable and this state (position + direction) hasn't been visited, add it to the queue.\n      if _is_cell_walkable(next_r_move, next_c_move) and next_state_move not in visited:\n          visited.add(next_state_move)\n          queue.append((next_state_move, path_taken + [MOVE_FORWARD_ACTION]))\n\n      # --- Try Turn Left Action ---\n      # Calculate the new direction after turning left. Position remains unchanged.\n      next_dir_left: int = TURN_LEFT_MAP[current_dir]\n      next_state_left: tuple[tuple[int, int], int] = (current_pos, next_dir_left)\n\n      # If this new state hasn't been visited, add it to the queue.\n      if next_state_left not in visited:\n          visited.add(next_state_left)\n          queue.append((next_state_left, path_taken + [TURN_LEFT_ACTION]))\n\n      # --- Try Turn Right Action ---\n      # Calculate the new direction after turning right. Position remains unchanged.\n      next_dir_right: int = TURN_RIGHT_MAP[current_dir]\n      next_state_right: tuple[tuple[int, int], int] = (current_pos, next_dir_right)\n\n      # If this new state hasn't been visited, add it to the queue.\n      if next_state_right not in visited:\n          visited.add(next_state_right)\n          queue.append((next_state_right, path_taken + [TURN_RIGHT_ACTION]))\n\n  # --- Post-BFS Processing ---\n\n  # If a path to the required adjacency state was found, extend the actions list with that path\n  # and then append the final 'USE' action to collect the primitive.\n  if path_to_target_adjacency is not None:\n      actions_to_collect.extend(path_to_target_adjacency)\n      actions_to_collect.append(USE_ACTION)\n\n  return actions_to_collect", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T04:51:36.392417", "function_name": "collect", "function_body": "  current_state = env._current_state\n  \n  # Obtain the unique integer ID for the target primitive from the cookbook.\n  # This ID is crucial for interacting with the grid and inventory representations.\n  primitive_idx = env.world.cookbook.index.index(primitive)\n  \n  # --- Step 1: Pre-check for existing primitive in inventory ---\n  # If the agent's inventory already holds at least one unit of the desired primitive,\n  # there's no need to execute any collection actions. This optimizes for cases\n  # where the DSL might redundantly request collection of an already acquired item.\n  if current_state.inventory[primitive_idx] > 0:\n    return [] # Primitive is already in inventory, return an empty action list.\n\n  # Retrieve integer mappings for all possible actions (UP, DOWN, LEFT, RIGHT, USE).\n  # This makes the code more readable and robust against changes in action indexing.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # --- Step 2: Immediate collection check ---\n  # Check if the agent is currently positioned within the 3x3 neighborhood of a primitive.\n  # The `CraftState.next_to` method efficiently performs this check.\n  # If true, a single 'USE' action is sufficient to collect the primitive.\n  if current_state.next_to(primitive_idx):\n    return [USE]\n\n  # --- Step 3: Identify all physical locations of the primitive on the grid ---\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  primitive_locations_on_grid = []\n  # Iterate through every cell on the grid to find where the primitive entity is present.\n  for x in range(grid_width):\n    for y in range(grid_height):\n      # The third dimension of the grid (index `primitive_idx`) represents the count\n      # of that specific item at (x, y). A value greater than 0 means it's there.\n      if grid[x, y, primitive_idx] > 0:\n        primitive_locations_on_grid.append((x, y))\n\n  # If the primitive is not found anywhere on the map, it's impossible to collect.\n  # This is an important edge case; if the item doesn't exist, we can't get it.\n  if not primitive_locations_on_grid:\n    return []\n\n  # --- Step 4: Define \"goal cells\" for pathfinding ---\n  # A \"goal cell\" is any grid position from which the agent can successfully perform\n  # the 'USE' action to collect the primitive. Given that 'USE' interacts with\n  # a 3x3 area, any cell adjacent to (including diagonals) or directly on top of\n  # a primitive's location is a valid goal cell for the agent to move to.\n  goal_cells = set()\n  for px, py in primitive_locations_on_grid:\n    # Iterate through the 3x3 neighborhood relative to the primitive's location.\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        gx, gy = px + dx, py + dy\n        # Ensure the calculated goal cell is within the valid grid boundaries.\n        if 0 <= gx < grid_width and 0 <= gy < grid_height:\n          goal_cells.add((gx, gy))\n\n  # --- Step 5: Determine impassable grid cell types ---\n  # These are entities that the agent cannot move through. In CraftWorld,\n  # non-grabbable items typically block movement, but workshops (which are also\n  # non-grabbable) are generally traversable interaction points.\n  impassable_kinds = set(env.world.non_grabbable_indices) - set(env.world.workshop_indices)\n\n  # --- Step 6: Perform Breadth-First Search (BFS) for the shortest path ---\n  # BFS is used to find the shortest sequence of movement actions from the agent's\n  # current position to any of the identified goal cells.\n  start_pos = current_state.pos\n  \n  # The BFS queue stores tuples: (current_position, list_of_actions_to_reach_here).\n  # This allows reconstruction of the path once the goal is found.\n  q = collections.deque([(start_pos, [])]) \n  # The 'visited' set prevents infinite loops and redundant path exploration.\n  visited = {start_pos} \n\n  # Define cardinal movement directions and their corresponding action constants.\n  # This ensures correctness and readability for movement logic.\n  MOVE_DELTAS_AND_ACTIONS = [\n      ((0, -1), UP),    # Move North (decreases Y coordinate)\n      ((0, 1), DOWN),   # Move South (increases Y coordinate)\n      ((-1, 0), LEFT),  # Move West (decreases X coordinate)\n      ((1, 0), RIGHT),  # Move East (increases X coordinate)\n  ]\n\n  while q:\n    # Dequeue the current position and the path that led to it.\n    (cx, cy), path_so_far = q.popleft() \n\n    # If the current position is one of the desired goal cells, we've found the path.\n    if (cx, cy) in goal_cells:\n      # Append the 'USE' action as the final step, since the agent is now positioned\n      # to collect the primitive.\n      return path_so_far + [USE]\n\n    # Explore all four cardinal neighbors from the current position.\n    for (dx, dy), action in MOVE_DELTAS_AND_ACTIONS:\n      nx, ny = cx + dx, cy + dy # Calculate the coordinates of the neighboring cell.\n      new_pos = (nx, ny)\n\n      # Check for grid boundary violations. Agents cannot move outside the map.\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue # Skip this neighbor if it's out of bounds.\n\n      # Check if the neighboring cell is impassable.\n      # This involves checking if any 'impassable_kind' item exists at (nx, ny).\n      is_impassable_cell = False\n      for k_idx in impassable_kinds:\n          if grid[nx, ny, k_idx] > 0: # If an impassable object occupies this cell\n              is_impassable_cell = True\n              break \n      \n      if is_impassable_cell:\n          continue # Skip this neighbor if it contains an impassable object.\n\n      # If the new position is valid (within bounds, traversable) and has not been\n      # visited yet during this BFS, add it to the queue for future exploration.\n      if new_pos not in visited:\n        visited.add(new_pos)\n        q.append((new_pos, path_so_far + [action]))\n\n  # --- Step 7: Handle unreachable primitive ---\n  # If the BFS completes (queue becomes empty) and no path to a goal cell was found,\n  # it implies that the primitive is currently unreachable from the agent's position.\n  # In such a scenario, no actions can be generated to collect it.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T04:51:37.697560", "function_name": "collect", "function_body": "  current_state = env._current_state\n  \n  # Get the integer index for the desired primitive from the cookbook.\n  # This will raise a KeyError if the primitive name is not recognized,\n  # indicating an invalid input to the DSL function.\n  primitive_idx = env.world.cookbook.index.index(primitive)\n  \n  # Retrieve action mappings for clarity and to ensure correct action indices are used.\n  # These are constants defining the integer representation of actions.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Helper function to determine if a grid cell is traversable by the agent.\n  # A cell is generally impassable if it contains certain non-grabbable entities\n  # that are not designated as workshops (which are often traversable interaction points).\n  def _is_cell_impassable(grid_cell_contents: np.ndarray, world: craft.CraftWorld) -> bool:\n    \"\"\"\n    Checks if a given cell (represented by its content vector) is impassable for agent movement.\n    A cell is considered impassable if it contains any \"non-grabbable\" item that is not a \"workshop\".\n    Workshops are typically non-grabbable but are often locations the agent needs to move onto.\n    \"\"\"\n    # Pre-calculate the set of indices that define impassable types.\n    # This set is static for a given CraftWorld configuration.\n    impassable_types = set(world.non_grabbable_indices) - set(world.workshop_indices)\n    \n    # Iterate through the indices of known impassable types.\n    for k_idx in impassable_types:\n      # If this impassable type is present in the cell (its count > 0), the cell is impassable.\n      if grid_cell_contents[k_idx] > 0:\n        return True # Found an impassable item, so the cell cannot be entered.\n    return False # No impassable items found, the cell is traversable.\n\n  # --- Collection Logic ---\n\n  # 1. Check if the primitive is already in the agent's inventory.\n  # If so, no actions are needed for collection.\n  if current_state.inventory[primitive_idx] > 0:\n    return [] \n\n  # 2. Check for immediate collection: If the agent is already in a position\n  # to collect the primitive (i.e., within its 3x3 neighborhood), simply use it.\n  if current_state.next_to(primitive_idx):\n    return [USE]\n\n  # 3. Identify all grid locations where instances of the primitive exist.\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  primitive_locations = []\n  for x in range(grid_width):\n    for y in range(grid_height):\n      # If the primitive kind's layer at (x,y) has a count > 0, the primitive is there.\n      if grid[x, y, primitive_idx] > 0:\n        primitive_locations.append((x, y))\n\n  # If no instances of the primitive are found on the entire grid, it's unreachable.\n  if not primitive_locations:\n    return []\n\n  # 4. Determine all \"goal cells\" for the BFS.\n  # A goal cell is any cell from which the agent can successfully `USE` the primitive.\n  # Given `CraftState.next_to` and the 'USE' action operate on the 3x3 neighborhood,\n  # any cell within the 3x3 vicinity of a primitive location is a valid goal cell.\n  goal_cells = set()\n  for px, py in primitive_locations:\n    # Iterate through the 3x3 neighborhood around each primitive location (including the center).\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        gx, gy = px + dx, py + dy\n        # Ensure the potential goal cell is within the overall grid boundaries.\n        if 0 <= gx < grid_width and 0 <= gy < grid_height:\n          goal_cells.add((gx, gy))\n\n  # 5. Perform Breadth-First Search (BFS) to find the shortest path.\n  start_pos = current_state.pos\n  \n  # BFS queue: stores (current_position (tuple), path_taken_actions_to_reach_here (list of ints))\n  q = collections.deque([(start_pos, [])]) \n  # Set to keep track of visited positions to avoid cycles and redundant computation.\n  visited = {start_pos} \n\n  # Define possible cardinal movement deltas and their corresponding action indices.\n  # These map (delta_x, delta_y) to the specific action constant.\n  MOVE_DELTAS_AND_ACTIONS = [\n      ((0, -1), UP),    # Moving North (decreases Y coordinate)\n      ((0, 1), DOWN),   # Moving South (increases Y coordinate)\n      ((-1, 0), LEFT),  # Moving West (decreases X coordinate)\n      ((1, 0), RIGHT),  # Moving East (increases X coordinate)\n  ]\n\n  while q:\n    (cx, cy), path_so_far = q.popleft() # Dequeue the current position and its path\n\n    # If the current position is one of our target goal cells, we've found the shortest path.\n    if (cx, cy) in goal_cells:\n      # Append the USE action, as the agent is now in a position to collect the primitive.\n      return path_so_far + [USE]\n\n    # Explore valid neighboring cells (cardinal directions) from the current position.\n    for (dx, dy), action in MOVE_DELTAS_AND_ACTIONS:\n      nx, ny = cx + dx, cy + dy # Calculate the new potential position.\n      new_pos = (nx, ny)\n\n      # Check 1: Is the new position within the overall grid boundaries?\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue # Skip if out of bounds.\n\n      # Check 2: Is the new position traversable (i.e., not impassable)?\n      # Utilize the helper function for clear logic.\n      if _is_cell_impassable(grid[nx, ny, :], env.world):\n          continue # Skip if the cell contains blocking items.\n\n      # Check 3: Has this new position already been visited during the BFS?\n      if new_pos not in visited:\n        visited.add(new_pos) # Mark as visited.\n        # Enqueue the new position along with the updated path.\n        q.append((new_pos, path_so_far + [action]))\n\n  # If the BFS completes and the queue becomes empty without finding a path\n  # to any of the goal cells, it means the primitive is unreachable from the current state.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T04:52:43.254055", "function_name": "collect", "function_body": "", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-08-01T04:52:44.454809", "function_name": "collect", "function_body": "  actions = []\n  current_state = env._current_state\n  grid = current_state.grid\n  start_pos = current_state.pos\n  grid_width, grid_height, _ = grid.shape\n\n  # 1. Retrieve the integer index for the requested primitive from the cookbook.\n  cookbook = env.world.cookbook\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # Define constants for movement directions and their corresponding actions.\n  ACTION_MAP = {\n      (-1, 0): craft.UP,\n      (1, 0): craft.DOWN,\n      (0, -1): craft.LEFT,\n      (0, 1): craft.RIGHT\n  }\n  CARDINAL_DIRECTIONS = [(-1, 0), (1, 0), (0, -1), (0, 1)] # For BFS exploration\n\n  # Determine if the primitive is a grabbable resource (e.g., WOOD, STONE) or a workshop.\n  # This distinction affects where the agent needs to be and if a 'USE' action is needed.\n  is_grabbable_resource = primitive_idx in env.world.grabbable_indices\n  is_workshop_location = primitive_idx in env.world.workshop_indices\n\n  # If the primitive is an uncollectible, non-traversable entity (like WATER or BOUNDARY)\n  # and not a workshop, then this function cannot collect it.\n  if primitive_idx in env.world.non_grabbable_indices and not is_workshop_location:\n    return []\n\n  # 2. Define a helper function to determine if a grid cell is traversable by the agent.\n  # This is crucial for the Breadth-First Search (BFS) algorithm.\n  def is_traversable(r, c):\n    \"\"\"Checks if the cell at (r, c) is within grid bounds and free of blocking entities.\"\"\"\n    # Check if the coordinates are within the grid boundaries.\n    if not (0 <= r < grid_width and 0 <= c < grid_height):\n      return False\n\n    # Water cells are generally impassable.\n    if grid[r, c, env.world.water_index] == 1:\n      return False\n\n    # Iterate through all kinds present at the current cell.\n    # If any of them are non-grabbable and *not* a workshop, they block movement.\n    # Workshops are considered traversable for the purpose of pathfinding.\n    kinds_at_cell = np.where(grid[r, c] == 1)[0]\n    for k_idx in kinds_at_cell:\n      if k_idx in env.world.non_grabbable_indices and k_idx not in env.world.workshop_indices:\n        return False # This cell contains a non-passable obstacle.\n    return True\n\n  # 3. Find all locations on the grid where the target primitive currently exists.\n  # Using numpy.where for efficient indexing.\n  primitive_rows, primitive_cols = np.where(grid[:, :, primitive_idx] == 1)\n  primitive_locations_on_grid = list(zip(primitive_rows, primitive_cols))\n\n  if not primitive_locations_on_grid:\n    # The primitive is not present anywhere on the map.\n    return []\n\n  # 4. Identify all \"target BFS locations\". These are the grid cells where the agent\n  # needs to be positioned to interact with the primitive.\n  target_bfs_locations = set()\n\n  if is_grabbable_resource:\n    # For grabbable resources, the agent needs to be in any cell within a 3x3 neighborhood\n    # (including the resource's cell itself) to collect it using 'USE'.\n    NEIGHBORHOOD_OFFSETS_3x3 = [\n        (dr, dc) for dr in [-1, 0, 1] for dc in [-1, 0, 1]\n    ]\n    for pr, pc in primitive_locations_on_grid:\n      for dr, dc in NEIGHBORHOOD_OFFSETS_3x3:\n        nr, nc = pr + dr, pc + dc\n        if is_traversable(nr, nc):\n          target_bfs_locations.add((nr, nc))\n  elif is_workshop_location:\n    # For workshops, the agent must move directly onto the workshop's cell to interact.\n    for wr, wc in primitive_locations_on_grid:\n      if is_traversable(wr, wc):\n        target_bfs_locations.add((wr, wc))\n  else:\n    # This case should ideally be caught by the initial validity check;\n    # it indicates an unhandled type of primitive for 'collect'.\n    return []\n\n  if not target_bfs_locations:\n    # No reachable (traversable) cells identified where the agent can interact with the primitive.\n    return []\n\n  # 5. Immediate check: If the agent is already at a target location,\n  # handle the collection directly without pathfinding.\n  if start_pos in target_bfs_locations:\n    if is_grabbable_resource:\n      # Agent is in position to collect a grabbable resource.\n      return [craft.USE]\n    else: # is_workshop_location\n      # Agent is already on the workshop. 'collect' means reaching it,\n      # 'craft' will then handle the 'USE' action. So no movement actions are needed.\n      return []\n\n  # 6. Perform a Breadth-First Search (BFS) to find the shortest path\n  # from the agent's current position to any of the target BFS locations.\n  # The queue stores tuples of (current_position, list_of_actions_taken_to_reach_here).\n  queue = collections.deque([(start_pos, [])])\n  visited = {start_pos} # Keeps track of visited (row, col) tuples to avoid cycles and redundant checks.\n\n  shortest_path_actions = None # Will store the sequence of actions for the shortest path.\n\n  while queue:\n    (r, c), current_path_actions = queue.popleft()\n\n    # If the current position is one of our target locations, we have found a shortest path.\n    if (r, c) in target_bfs_locations:\n      shortest_path_actions = current_path_actions\n      break # Exit BFS as the shortest path is found.\n\n    # Explore all four cardinal neighbors (UP, DOWN, LEFT, RIGHT).\n    for dr, dc in CARDINAL_DIRECTIONS:\n      next_r, next_c = r + dr, c + dc\n      \n      # If the neighbor has not been visited and is traversable, add it to the queue.\n      if (next_r, next_c) not in visited:\n        if is_traversable(next_r, next_c):\n          visited.add((next_r, next_c))\n          # Append the corresponding action to the path and add to queue.\n          queue.append(((next_r, next_c), current_path_actions + [ACTION_MAP[(dr, dc)]]))\n\n  if shortest_path_actions is None:\n    # No path was found from the agent's current position to any target location.\n    return []\n\n  # 7. Construct the final sequence of actions to return.\n  actions.extend(shortest_path_actions)\n\n  # If the primitive is a grabbable resource, an additional 'USE' action is required\n  # after reaching the target location to actually collect it into inventory.\n  # For workshops, the 'USE' action is part of the 'craft' DSL command.\n  if is_grabbable_resource:\n    actions.append(craft.USE)\n\n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T04:53:28.716980", "function_name": "collect", "function_body": "  actions_list = []\n  # Get the current state of the environment. This includes the grid,\n  # agent's position, direction, and inventory.\n  current_state = env._current_state\n\n  # Store initial grid, position, and direction. These are constant for pathfinding.\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's starting (row, column) tuple\n  initial_dir = current_state.dir # Agent's starting direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the world's cookbook index.\n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  # Get grid dimensions for boundary checks.\n  HEIGHT, WIDTH, _ = initial_grid.shape # Note: numpy arrays are typically (rows, cols)\n\n  # Retrieve the mapping from action names (strings) to their integer codes.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # In CraftLab, 'UP' typically means move forward\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE'] # Action to perform collection/interaction\n\n  # Define how agent's (row, col) position changes based on direction when moving forward.\n  # (dr, dc) = (delta_row, delta_column)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT (0): move +1 column\n      1: (-1, 0),  # Facing UP (1): move -1 row\n      2: (0, -1),  # Facing LEFT (2): move -1 column\n      3: (1, 0)    # Facing DOWN (3): move +1 row\n  }\n\n  # Define how agent's direction changes when turning left or right.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0} # RIGHT->UP, UP->LEFT, LEFT->DOWN, DOWN->RIGHT\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # RIGHT->DOWN, UP->RIGHT, LEFT->UP, DOWN->LEFT\n\n  # Identify all entity kinds that block agent movement.\n  # These include non-grabbable items (e.g., BOUNDARY, WATER, WORKSHOPS).\n  obstacles_to_movement_indices = set(current_state.world.non_grabbable_indices)\n  \n  # For grabbable primitives (like WOOD, STONE), the agent cannot walk *onto* the\n  # primitive's cell but must interact from an adjacent cell. So, the primitive's\n  # own ID is also an obstacle to *movement*.\n  # This distinction is important for pathfinding.\n  obstacles_to_movement_indices.add(primitive_id)\n  \n  # Early Exit Optimization: If the primitive is already in the agent's 3x3\n  # neighborhood (i.e., immediately collectible), just return the USE action.\n  # The `CraftState.next_to` method provides this check efficiently.\n  if current_state.next_to(primitive_id):\n      return [USE_ACTION]\n\n  # Initialize Breadth-First Search (BFS) for pathfinding.\n  # Queue stores tuples: ((current_pos_tuple, current_direction_int), list_of_actions_taken)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set keeps track of (position, direction) pairs already explored\n  # to prevent cycles and ensure the shortest path is found.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # This will store the shortest action sequence to a collectible state.\n\n  # Main BFS loop: continues until the queue is empty or a path is found.\n  while queue:\n      # Dequeue the current state and the path leading to it.\n      (r, c), current_dir = queue_state, current_pos = queue.popleft()\n      current_pos, current_dir = queue_state\n\n      # Check if the current agent position is a \"goal state\" for collection.\n      # A goal state means the primitive is located in any cell within the 3x3 neighborhood\n      # around the agent's current position on the *initial grid*.\n      found_collectable_position = False\n      for dr_check in [-1, 0, 1]:\n          for dc_check in [-1, 0, 1]:\n              check_r, check_c = current_pos[0] + dr_check, current_pos[1] + dc_check\n              # Ensure the cell being checked is within grid boundaries.\n              if (0 <= check_r < HEIGHT and 0 <= check_c < WIDTH and\n                  initial_grid[check_r, check_c, primitive_id] > 0):\n                  found_collectable_position = True\n                  break\n          if found_collectable_position:\n              break\n\n      if found_collectable_position:\n          target_path_actions = path_actions # A shortest path to a collectible state is found.\n          break # Terminate BFS; we found the shortest path.\n\n      # Explore possible next states by applying valid actions: Move Forward, Turn Left, Turn Right.\n\n      # 1. Try MOVE_FORWARD_ACTION:\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = current_pos[0] + move_dr, current_pos[1] + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change direction.\n\n      # Check if the potential next position is valid (within bounds and not visited).\n      if (0 <= next_r < HEIGHT and 0 <= next_c < WIDTH and\n          (next_pos, next_dir) not in visited):\n          \n          is_walkable = True\n          # Verify that the cell at `next_pos` does not contain any obstacle.\n          for kind_idx in obstacles_to_movement_indices:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable = False\n                  break\n\n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # 2. Try TURN_LEFT_ACTION:\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # 3. Try TURN_RIGHT_ACTION:\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # After BFS completes:\n  # If a path to a collectable position was found, append the final 'USE' action.\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-08-01T04:53:29.838467", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\"\"\"\n  actions_sequence = [] # List to store the final sequence of actions\n\n  # Get the current state from the environment wrapper.\n  current_state = env._current_state\n\n  # Extract initial conditions for pathfinding (grid, agent's position, direction).\n  # The grid is considered static for pathfinding purposes.\n  initial_grid = current_state.grid\n  agent_initial_pos = current_state.pos # (row, column) tuple\n  agent_initial_dir = current_state.dir # Integer (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the world's cookbook index.\n  primitive_kind_id = current_state.world.cookbook.index[primitive]\n\n  # Get grid dimensions for boundary checks.\n  GRID_WIDTH, GRID_HEIGHT, _ = initial_grid.shape\n\n  # Map symbolic action names to their integer codes for environment interaction.\n  action_map = env.action_specs()\n  ACTION_MOVE_FORWARD = action_map['UP']    # In CraftWorld, 'UP' moves agent forward\n  ACTION_TURN_LEFT = action_map['LEFT']\n  ACTION_TURN_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']            # Action to collect/interact with an item\n\n  # Define how agent's (dr, dc) changes based on its current direction.\n  # (delta_row, delta_column) for moving one step forward.\n  DIRECTION_VECTORS = {\n      0: (0, 1),   # RIGHT: +1 to column\n      1: (-1, 0),  # UP: -1 to row\n      2: (0, -1),  # LEFT: -1 to column\n      3: (1, 0)    # DOWN: +1 to row\n  }\n\n  # Define how agent's direction changes when turning.\n  # (current_dir -> new_dir)\n  TURN_LEFT_EFFECT = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_EFFECT = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Define which entity kinds act as impassable obstacles for agent movement.\n  # These are entities the agent cannot walk *through* or *onto*.\n  impassable_kinds_ids = set(current_state.world.non_grabbable_indices)\n  # Additionally, when collecting a grabbable primitive, the agent must be *adjacent*\n  # to it, not occupying the same cell. So the primitive itself is also an obstacle.\n  impassable_kinds_ids.add(primitive_kind_id)\n\n  # Early Exit: If the primitive is already in the agent's 3x3 neighborhood,\n  # the agent can collect it immediately with a 'USE' action.\n  # The `CraftState.next_to` method efficiently checks this.\n  if current_state.next_to(primitive_kind_id):\n      return [ACTION_USE]\n\n  # Initialize Breadth-First Search (BFS) for pathfinding.\n  # Queue element: ((agent_position, agent_direction), list_of_actions_taken)\n  # Agent position: (row, column) tuple. Agent direction: integer (0-3).\n  bfs_queue = collections.deque([((agent_initial_pos, agent_initial_dir), [])])\n\n  # Set to keep track of visited (position, direction) states to prevent cycles\n  # and ensure finding the shortest path.\n  visited_states = {(agent_initial_pos, agent_initial_dir)}\n\n  # This will store the sequence of actions once a path to a collectible location is found.\n  path_to_collectible_location = None\n\n  # BFS loop continues until all reachable states are explored or a target path is found.\n  while bfs_queue:\n      (current_pos, current_dir), current_path = bfs_queue.popleft()\n      r, c = current_pos # Unpack current row and column\n\n      # Check if the current agent's position (r, c) makes the target primitive\n      # accessible within its 3x3 neighborhood. This check is performed against\n      # the initial grid configuration.\n      is_primitive_in_neighborhood = False\n      for dr_check in [-1, 0, 1]:\n          for dc_check in [-1, 0, 1]:\n              check_r, check_c = r + dr_check, c + dc_check\n              # Ensure the cell being checked is within grid boundaries.\n              if (0 <= check_r < GRID_WIDTH and 0 <= check_c < GRID_HEIGHT):\n                  # Check if the primitive kind exists at this neighboring cell on the initial grid.\n                  if initial_grid[check_r, check_c, primitive_kind_id] > 0:\n                      is_primitive_in_neighborhood = True\n                      break # Found the primitive in the neighborhood\n          if is_primitive_in_neighborhood:\n              break # Break outer loop too\n\n      # If the primitive is reachable from the current position, we found our target.\n      if is_primitive_in_neighborhood:\n          path_to_collectible_location = current_path\n          break # Exit BFS, as the shortest path is found.\n\n      # Explore next possible states by trying each allowed action: Move, Turn Left, Turn Right.\n\n      # 1. Try MOVE_FORWARD:\n      dr_move, dc_move = DIRECTION_VECTORS[current_dir]\n      next_r_move, next_c_move = r + dr_move, c + dc_move\n      next_pos_move = (next_r_move, next_c_move)\n      next_dir_move = current_dir # Direction doesn't change when moving forward\n\n      # Check validity of the new state: within bounds and not previously visited.\n      if (0 <= next_r_move < GRID_WIDTH and 0 <= next_c_move < GRID_HEIGHT and\n          (next_pos_move, next_dir_move) not in visited_states):\n\n          # Check if the proposed next cell contains any impassable obstacles.\n          is_walkable_path = True\n          for kind_idx in impassable_kinds_ids:\n              if initial_grid[next_r_move, next_c_move, kind_idx] > 0:\n                  is_walkable_path = False\n                  break # Found an obstacle, cannot move here.\n\n          if is_walkable_path:\n              visited_states.add((next_pos_move, next_dir_move)) # Mark new state as visited\n              # Add the new state to the queue with its updated path.\n              bfs_queue.append(((next_pos_move, next_dir_move), current_path + [ACTION_MOVE_FORWARD]))\n\n      # 2. Try TURN_LEFT:\n      next_dir_left = TURN_LEFT_EFFECT[current_dir]\n      # Position remains the same when turning.\n      if ((current_pos, next_dir_left) not in visited_states):\n          visited_states.add((current_pos, next_dir_left))\n          bfs_queue.append(((current_pos, next_dir_left), current_path + [ACTION_TURN_LEFT]))\n\n      # 3. Try TURN_RIGHT:\n      next_dir_right = TURN_RIGHT_EFFECT[current_dir]\n      # Position remains the same when turning.\n      if ((current_pos, next_dir_right) not in visited_states):\n          visited_states.add((current_pos, next_dir_right))\n          bfs_queue.append(((current_pos, next_dir_right), current_path + [ACTION_TURN_RIGHT]))\n\n  # After BFS completes:\n  # If a path to a collectible location was found, append the final 'USE' action.\n  if path_to_collectible_location is not None:\n      actions_sequence.extend(path_to_collectible_location)\n      actions_sequence.append(ACTION_USE)\n\n  return actions_sequence", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T04:54:31.484572", "function_name": "collect", "function_body": "  actions = []\n  current_state = env._current_state\n  grid = current_state.grid\n  start_pos = current_state.pos\n  grid_width, grid_height, _ = grid.shape\n\n  # 1. Map primitive name to its integer index using the Cookbook\n  cookbook = env.world.cookbook\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # The primitive name is not recognized in the game's cookbook.\n    return []\n\n  # Define constants for actions and directions for clarity\n  ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = (\n      craft.UP, craft.DOWN, craft.LEFT, craft.RIGHT, craft.USE\n  )\n  # Map (dr, dc) offsets to their corresponding action integers for BFS path reconstruction\n  CARDINAL_DIRECTIONS = [(-1, 0), (1, 0), (0, -1), (0, 1)] # (dr, dc) for (UP, DOWN, LEFT, RIGHT) respectively\n  ACTION_MAP = {\n      (-1, 0): ACTION_UP,\n      (1, 0): ACTION_DOWN,\n      (0, -1): ACTION_LEFT,\n      (0, 1): ACTION_RIGHT\n  }\n\n  # 2. Categorize the primitive type to determine how to interact with it\n  is_grabbable_resource = primitive_idx in env.world.grabbable_indices\n  is_workshop_location = primitive_idx in env.world.workshop_indices\n  \n  # Primitives that are not grabbable and not workshops (e.g., water, boundary) cannot be \"collected\"\n  # or \"interacted\" with via this function's typical logic.\n  if primitive_idx in env.world.non_grabbable_indices and not is_workshop_location:\n    return []\n\n  # 3. Helper function to check if a grid cell is traversable for agent movement\n  def is_traversable(r, c):\n    # Check grid bounds first\n    if not (0 <= r < grid_width and 0 <= c < grid_height):\n      return False\n\n    # Water is always impassable.\n    if grid[r, c, env.world.water_index] == 1:\n      return False\n    \n    # Check if any other non-grabbable obstacle (excluding workshops, which are traversable)\n    # is present at this cell.\n    # np.where(grid[r,c] == 1)[0] gives indices of all kinds present at (r,c)\n    kinds_at_cell = np.where(grid[r, c] == 1)[0]\n    for k_idx in kinds_at_cell:\n      if k_idx in env.world.non_grabbable_indices and k_idx not in env.world.workshop_indices:\n        return False # This cell contains an obstacle that blocks movement\n\n    return True\n\n  # 4. Find all physical locations of the target primitive on the grid\n  primitive_locations_on_grid = []\n  for r in range(grid_width):\n    for c in range(grid_height):\n      if grid[r, c, primitive_idx] == 1:\n        primitive_locations_on_grid.append((r, c))\n\n  if not primitive_locations_on_grid:\n    # The primitive is not present anywhere on the current map.\n    return []\n\n  # 5. Determine the \"target BFS locations\" where the agent needs to be positioned\n  # to successfully interact with the primitive. These are the goal nodes for our BFS.\n  target_bfs_locations = set()\n\n  if is_grabbable_resource:\n    # For grabbable items (e.g., WOOD, IRON), the agent needs to be in the 3x3 neighborhood\n    # of the resource to use it. This includes standing directly on the resource cell itself.\n    NEIGHBORHOOD_OFFSETS = [\n        (dr, dc) for dr in [-1, 0, 1] for dc in [-1, 0, 1]\n    ]\n    for pr, pc in primitive_locations_on_grid:\n      for dr, dc in NEIGHBORHOOD_OFFSETS:\n        nr, nc = pr + dr, pc + dc\n        if is_traversable(nr, nc):\n          target_bfs_locations.add((nr, nc))\n  elif is_workshop_location:\n    # For workshops (e.g., WORKSHOP0, WORKSHOP1), the agent needs to move directly onto the\n    # workshop's cell to use it for crafting.\n    for wr, wc in primitive_locations_on_grid:\n      if is_traversable(wr, wc):\n        target_bfs_locations.add((wr, wc))\n  else:\n    # This scenario should ideally be covered by earlier checks, but serves as a safeguard\n    # for any unhandled primitive types.\n    return []\n\n  if not target_bfs_locations:\n    # Even if the primitive exists, there might be no traversable spots from which to interact.\n    return []\n\n  # 6. Perform Breadth-First Search (BFS) to find the shortest path\n  # The queue stores tuples: (current_position (row, col), list_of_actions_taken_to_reach_here)\n  queue = collections.deque([(start_pos, [])])\n  visited = {start_pos} # Set of visited (row, col) tuples to prevent cycles and redundant exploration\n  \n  shortest_path_actions = None # This will store the sequence of actions for the shortest path found\n\n  while queue:\n    (r, c), current_path = queue.popleft()\n\n    # If the current position is one of our target interaction locations, we have found a shortest path.\n    if (r, c) in target_bfs_locations:\n      shortest_path_actions = current_path\n      break # Exit BFS, as we found the shortest path to any target\n\n    # Explore all four cardinal (UP, DOWN, LEFT, RIGHT) neighbors\n    for dr, dc in CARDINAL_DIRECTIONS:\n      next_r, next_c = r + dr, c + dc\n      \n      if (next_r, next_c) not in visited: # Only visit unvisited cells\n        if is_traversable(next_r, next_c): # Only move to traversable cells\n          visited.add((next_r, next_c))\n          queue.append(((next_r, next_c), current_path + [ACTION_MAP[(dr, dc)]]))\n\n  if shortest_path_actions is None:\n    # No path could be found from the agent's current position to any target interaction location.\n    return []\n\n  # 7. Construct the final sequence of actions\n  actions.extend(shortest_path_actions)\n\n  # If the primitive is a grabbable resource, an additional 'USE' action is required\n  # once the agent reaches the interaction location. Workshops do not require a 'USE' action\n  # for the 'collect' DSL command; being on the tile is sufficient for 'craft' actions.\n  if is_grabbable_resource:\n    actions.append(ACTION_USE)\n\n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T04:54:32.691265", "function_name": "collect", "function_body": "", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-08-01T04:56:19.306135", "function_name": "collect", "function_body": "  primitive_id = env.world.cookbook.index[primitive]\n  \n  if primitive_id is None:\n      return []\n\n  state = env._current_state\n  current_pos = state.pos\n  current_dir = state.dir # Agent's initial facing direction (0=DOWN, 1=UP, 2=LEFT, 3=RIGHT)\n  grid = state.grid\n  \n  width, height, _ = grid.shape \n\n  actions_map = env.action_specs()\n  UP = actions_map['UP']\n  DOWN = actions_map['DOWN']\n  LEFT = actions_map['LEFT']\n  RIGHT = actions_map['RIGHT']\n  USE = actions_map['USE']\n\n  # Map action index (which also corresponds to a direction) to its (dr, dc) delta.\n  # These deltas represent both the movement if that action is taken, and the direction faced after.\n  direction_deltas = {\n      DOWN: (1, 0),\n      UP: (-1, 0),\n      LEFT: (0, -1),\n      RIGHT: (0, 1)\n  }\n\n  # BFS setup:\n  # Queue stores tuples: ((row, col, facing_direction_idx), [list_of_actions_to_reach_this_state])\n  q = collections.deque([((current_pos[0], current_pos[1], current_dir), [])]) \n  \n  # Visited set stores (row, col, facing_direction_idx) tuples to prevent revisiting states\n  visited = {(current_pos[0], current_pos[1], current_dir)}\n\n  # Cache grabbable and non-grabbable indices for efficient lookup\n  grabbable_indices_set = set(env.world.grabbable_indices)\n  non_grabbable_indices_set = env.world.non_grabbable_indices\n\n  while q:\n      (r, c, d), path_actions = q.popleft()\n\n      # 1. Check if the current (r, c, d) state allows for immediate collection via USE action.\n      # The USE action interacts with the cell directly in front of the agent.\n      dr_face, dc_face = direction_deltas[d] # Get delta for the direction agent is currently facing\n      target_r, target_c = r + dr_face, c + dc_face # Coordinates of the cell directly in front\n\n      # Ensure the target cell is within grid boundaries\n      if 0 <= target_r < width and 0 <= target_c < height:\n          # Check if the target cell contains the primitive we want to collect\n          if grid[target_r, target_c, primitive_id] > 0:\n              # Path found! Append USE action and return.\n              return path_actions + [USE] \n\n      # 2. Explore movement neighbors (UP, DOWN, LEFT, RIGHT)\n      # Each movement action changes the agent's position and sets its new facing direction.\n      for move_action in [UP, DOWN, LEFT, RIGHT]:\n          next_dir = move_action # After moving, agent faces the direction it just moved\n          dr_move, dc_move = direction_deltas[move_action] # Delta for the movement itself\n\n          nr, nc = r + dr_move, c + dc_move # New row, new col after movement\n          next_state_tuple = (nr, nc, next_dir) # The new state (position and facing direction)\n\n          # a. Check if the next position (nr, nc) is within grid boundaries\n          if not (0 <= nr < width and 0 <= nc < height):\n              continue\n          \n          # b. Improved Obstacle Check for `collect_v2`:\n          # A cell is considered an obstacle for movement if it contains:\n          #   - Any entity from the `non_grabbable_indices_set` (impassable terrain/structures).\n          #   - OR, the specific primitive we are trying to collect, IF that primitive is a grabbable item.\n          #     This prevents the agent from walking *onto* a grabbable item it intends to 'USE' from an adjacent square.\n          is_obstacle = False\n          \n          # Check for general non-grabbable obstacles (e.g., water, workshops, boundaries)\n          for non_grabbable_item_id in non_grabbable_indices_set:\n              if grid[nr, nc, non_grabbable_item_id] > 0:\n                  is_obstacle = True\n                  break\n          \n          # Additionally, if the target primitive is a grabbable item (like WOOD, STONE) AND\n          # the next cell contains this primitive, consider it an obstacle for movement.\n          # This ensures the agent stops adjacent to it, ready to USE from an adjacent position.\n          # This check only applies if the cell wasn't already determined to be an obstacle by a non-grabbable item.\n          if not is_obstacle and primitive_id in grabbable_indices_set and grid[nr, nc, primitive_id] > 0:\n              is_obstacle = True\n\n          if is_obstacle:\n              continue\n\n          # c. If the new state (position and facing direction) has not been visited, add it to the queue\n          if next_state_tuple not in visited:\n              visited.add(next_state_tuple)\n              q.append((next_state_tuple, path_actions + [move_action]))\n\n  # If the BFS completes and the primitive was not found anywhere reachable or collectable,\n  # return an empty list, indicating no path was found.\n  return []", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T04:56:20.619374", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n  Adds a check to ensure the target primitive is actually collectable (a resource or grabbable item).\n  \"\"\"\n  primitive_id = env.world.cookbook.index[primitive]\n  \n  if primitive_id is None:\n      return []\n\n  # Improvement: Filter out non-collectable environment features.\n  # The 'collect' function implies obtaining the item into inventory.\n  # Some 'primitives' in the DSL (e.g., WORKSHOP, BOUNDARY) are environmental\n  # features that cannot be picked up or harvested into inventory.\n  # If the primitive_id is in the set of non-grabbable entities AND it's not\n  # categorized as a 'primitive resource' (which suggests it can be harvested,\n  # like WOOD or STONE), then we assume it's not a valid target for 'collect'.\n  if (primitive_id in env.world.non_grabbable_indices and \n      primitive_id not in env.world.cookbook.primitives):\n      return []\n\n  state = env._current_state\n  current_pos = state.pos\n  current_dir = state.dir # Agent's initial facing direction (0=DOWN, 1=UP, 2=LEFT, 3=RIGHT)\n  grid = state.grid\n  \n  width, height, _ = grid.shape \n\n  actions_map = env.action_specs()\n  UP = actions_map['UP']\n  DOWN = actions_map['DOWN']\n  LEFT = actions_map['LEFT']\n  RIGHT = actions_map['RIGHT']\n  USE = actions_map['USE']\n\n  # Map action index (which also corresponds to a direction) to its (dr, dc) delta.\n  # These deltas represent both the movement if that action is taken, and the direction faced after.\n  direction_deltas = {\n      DOWN: (1, 0),\n      UP: (-1, 0),\n      LEFT: (0, -1),\n      RIGHT: (0, 1)\n  }\n\n  # BFS setup:\n  # Queue stores tuples: ((row, col, facing_direction_idx), [list_of_actions_to_reach_this_state])\n  q = collections.deque([((current_pos[0], current_pos[1], current_dir), [])]) \n  \n  # Visited set stores (row, col, facing_direction_idx) tuples to prevent revisiting states\n  visited = {(current_pos[0], current_pos[1], current_dir)}\n\n  while q:\n      (r, c, d), path_actions = q.popleft()\n\n      # 1. Check if the current (r, c, d) state allows for immediate collection via USE action.\n      # The USE action interacts with the cell directly in front of the agent.\n      dr_face, dc_face = direction_deltas[d] # Get delta for the direction agent is currently facing\n      target_r, target_c = r + dr_face, c + dc_face # Coordinates of the cell directly in front\n\n      # Ensure the target cell is within grid boundaries\n      if 0 <= target_r < width and 0 <= target_c < height:\n          # Check if the target cell contains the primitive we want to collect\n          if grid[target_r, target_c, primitive_id] > 0:\n              return path_actions + [USE] # Path found! Append USE action and return.\n\n      # 2. Explore movement neighbors (UP, DOWN, LEFT, RIGHT)\n      # Each movement action changes the agent's position and sets its new facing direction.\n      for move_action in [UP, DOWN, LEFT, RIGHT]:\n          next_dir = move_action # After moving, agent faces the direction it just moved\n          dr_move, dc_move = direction_deltas[move_action] # Delta for the movement itself\n\n          nr, nc = r + dr_move, c + dc_move # New row, new col after movement\n          next_state_tuple = (nr, nc, next_dir) # The new state (position and facing direction)\n\n          # a. Check if the next position (nr, nc) is within grid boundaries\n          if not (0 <= nr < width and 0 <= nc < height):\n              continue\n          \n          # b. Check for obstacles: A cell is considered an obstacle if it contains\n          #    any entity that is categorized as non-grabbable (impassable terrain/structures).\n          is_obstacle = False\n          for non_grabbable_id in env.world.non_grabbable_indices:\n              if grid[nr, nc, non_grabbable_id] > 0: # If the next cell contains a non-grabbable item...\n                  is_obstacle = True\n                  break # It's an obstacle, no need to check further for this cell\n          \n          if is_obstacle:\n              continue\n\n          # c. If the new state (position and facing direction) has not been visited, add it to the queue\n          if next_state_tuple not in visited:\n              visited.add(next_state_tuple)\n              q.append((next_state_tuple, path_actions + [move_action]))\n\n  # If the BFS completes and the primitive was not found anywhere reachable or collectable,\n  # return an empty list, indicating no path was found.\n  return []", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T04:57:23.619439", "function_name": "collect", "function_body": "", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-08-01T04:57:25.023738", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # Primitive name not found in the cookbook, so it cannot be collected.\n    return []\n\n  # 2. Semantic check: Ensure the item is actually grabbable and collectible via 'USE'.\n  # Grabbable items can be picked up, water/stone can be collected with USE.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  if not is_collectible_via_use:\n    # This primitive cannot be collected via the 'USE' action.\n    return []\n\n  # 3. Define action integers and direction deltas\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # Map CraftState.dir (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT) to (dr, dc) of the cell directly in front\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col\n      1: (0, 1),  # RIGHT: row, col + 1\n      2: (1, 0),  # DOWN: row + 1, col\n      3: (0, -1)  # LEFT: row, col - 1\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return []\n      \n      # Calculate the difference in directions (modulo 4 for circularity)\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP -> RIGHT)\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP -> LEFT)\n          return [LEFT_ACT]\n      else: # diff == 2, 180-degree turn (e.g., UP -> DOWN)\n          return [RIGHT_ACT, RIGHT_ACT] # Two consecutive right turns (or two left)\n\n  # BFS setup\n  # Queue stores (state_key, CraftState object)\n  q = collections.deque()\n  \n  # Visited set stores (position_r, position_c, direction) to avoid cycles and redundant work.\n  visited = set()\n  \n  # parent_info maps state_key -> (parent_state_key, action_from_parent_to_current)\n  parent_info = {} \n\n  # Indices for state_key tuple for clarity\n  ROW, COL, DIR = 0, 1, 2\n\n  # Initial state setup\n  initial_state_key = (current_state.pos[0], current_state.pos[1], current_state.dir)\n  q.append((initial_state_key, current_state))\n  visited.add(initial_state_key)\n  parent_info[initial_state_key] = (None, None) # The root state has no parent\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Maximum states to explore to prevent infinite loops or excessively long searches.\n  # Total unique (pos, dir) states is grid_width * grid_height * 4.\n  # A multiplier (e.g., 2) allows for some redundant exploration in complex layouts.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 2 \n\n  explored_states_count = 0\n\n  while q:\n    state_key, state = q.popleft()\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop exploring this path.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c, current_dir = state_key # Unpack for convenience\n\n    # Check if we can collect the primitive from this state by turning and using.\n    # state.next_to(i_kind) quickly checks if the primitive is in the 3x3 neighborhood.\n    if state.next_to(i_kind):\n        # If nearby, iterate through all 4 possible directions the agent could *turn to face*.\n        for target_dir in range(4): \n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the calculated facing cell is within grid bounds\n            # AND if it contains the desired primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Primitive found directly in front!\n                # Calculate actions to turn from current direction to target_dir.\n                turns = _get_turning_actions(current_dir, target_dir)\n                \n                # Reconstruct the path from the initial state to the current `state_key`.\n                # Path is built in reverse, so it needs to be reversed at the end.\n                path_to_current_state = []\n                curr_reconstruct_key = state_key\n                while parent_info[curr_reconstruct_key][0] is not None:\n                    parent_key, action_from_parent = parent_info[curr_reconstruct_key]\n                    path_to_current_state.append(action_from_parent)\n                    curr_reconstruct_key = parent_key\n                path_to_current_state.reverse() \n\n                # The complete sequence of actions is:\n                # (path to current state) + (turning actions) + (USE action)\n                return path_to_current_state + turns + [USE_ACT]\n\n    # If the primitive is not collectible from this state, explore movement actions.\n    for action in move_actions:\n      # Simulate the action to get the next state.\n      # state.step() creates a new CraftState object and handles game logic.\n      _, next_state = state.step(action) \n\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        parent_info[next_state_key] = (state_key, action) # Store parent and action\n        q.append((next_state_key, next_state)) # Add new state to queue\n\n  # If the queue is exhausted and no path to collect the primitive was found, return an empty list.\n  return []", "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T04:58:27.832582", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n  grid = current_state.grid\n  \n  # 1. Get the integer index for the primitive\n  # Using .index() is robust, ensuring the item is mapped to an integer ID.\n  i_primitive = world.cookbook.index.index(primitive) \n\n  # Get the set of impassable terrain indices.\n  # These are entities that the agent cannot walk over or through.\n  impassable_indices = world.non_grabbable_indices\n\n  # Define possible movement deltas (dx, dy) for (x, y) coordinates\n  # and their corresponding actions (from craft.py, matching DMLab actions).\n  # The grid is (WIDTH, HEIGHT, n_kinds) where WIDTH corresponds to x, HEIGHT to y.\n  # UP: decreases y-coordinate\n  # DOWN: increases y-coordinate\n  # LEFT: decreases x-coordinate\n  # RIGHT: increases x-coordinate\n  move_deltas_and_actions = [\n      (0, -1), # UP (x_delta=0, y_delta=-1)\n      (0, 1),  # DOWN (x_delta=0, y_delta=1)\n      (-1, 0), # LEFT (x_delta=-1, y_delta=0)\n      (1, 0)   # RIGHT (x_delta=1, y_delta=0)\n  ]\n  delta_to_action = {\n      (0, -1): craft.UP,\n      (0, 1): craft.DOWN,\n      (-1, 0): craft.LEFT,\n      (1, 0): craft.RIGHT\n  }\n  \n  start_pos = current_state.pos # Agent's current (x, y) position\n  grid_width, grid_height, _ = grid.shape # Unpack dimensions: (WIDTH, HEIGHT, n_kinds)\n\n  # Step 1: Identify all cells on the grid that contain the primitive.\n  primitive_locations = []\n  for x in range(grid_width):\n      for y in range(grid_height):\n          # Check if the primitive exists at this specific (x, y) location\n          if grid[x, y, i_primitive] > 0: # Check if count is greater than 0\n              primitive_locations.append((x, y))\n  \n  if not primitive_locations:\n      # The primitive does not exist anywhere on the current grid\n      return []\n\n  # Step 2: Determine all \"valid_use_positions\".\n  # These are cells where the agent can stand such that the primitive\n  # is within its 3x3 neighborhood. This directly aligns with CraftState.next_to.\n  valid_use_positions = set()\n  for px, py in primitive_locations: # primitive x, primitive y\n      # Iterate through the 3x3 neighborhood centered at (px, py)\n      for dx_offset in [-1, 0, 1]:\n          for dy_offset in [-1, 0, 1]:\n              agent_target_x, agent_target_y = px + dx_offset, py + dy_offset\n              \n              # Ensure the potential agent position is within grid boundaries\n              if not (0 <= agent_target_x < grid_width and 0 <= agent_target_y < grid_height):\n                  continue\n\n              # Ensure the potential agent position is traversable (does not contain impassable objects)\n              is_traversable = True\n              for imp_idx in impassable_indices:\n                  if grid[agent_target_x, agent_target_y, imp_idx] > 0:\n                      is_traversable = False\n                      break\n              \n              if is_traversable:\n                  valid_use_positions.add((agent_target_x, agent_target_y))\n  \n  if not valid_use_positions: # No traversable spots next to any primitive\n      return []\n\n  # Step 3: Perform Breadth-First Search (BFS) to find the shortest path\n  # from the agent's start_pos to any of the valid_use_positions.\n  queue = collections.deque([(start_pos, [])]) # (current_position, path_of_actions)\n  visited = {start_pos} # Keep track of visited positions to avoid cycles and redundant exploration\n\n  found_path = None\n\n  while queue:\n    curr_pos, path = queue.popleft() # curr_pos is (x, y)\n\n    # If the current position is one of the valid interaction spots, we've found our path\n    if curr_pos in valid_use_positions:\n      found_path = path\n      break \n\n    # Explore all four cardinal neighbors (UP, DOWN, LEFT, RIGHT)\n    for dx, dy in move_deltas_and_actions:\n      next_x, next_y = curr_pos[0] + dx, curr_pos[1] + dy\n      next_pos = (next_x, next_y)\n\n      # Check 1: Ensure the next position is within grid boundaries\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      # Check 2: Ensure the next position is traversable (does not contain impassable objects)\n      is_next_pos_impassable = False\n      for imp_idx in impassable_indices:\n          if grid[next_x, next_y, imp_idx] > 0:\n              is_next_pos_impassable = True\n              break\n      if is_next_pos_impassable:\n          continue\n\n      # Check 3: Avoid revisiting already explored positions to find the shortest path\n      if next_pos not in visited:\n        visited.add(next_pos)\n        action_to_take = delta_to_action[(dx, dy)] \n        queue.append((next_pos, path + [action_to_take]))\n\n  if found_path is None:\n    # No path found to any valid interaction spot for the primitive\n    return []\n  \n  # Once the agent reaches a `valid_use_position`, a 'USE' action is required\n  # to actually collect or interact with the primitive.\n  found_path.append(craft.USE)\n  \n  return found_path", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T04:58:29.294079", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n  grid = current_state.grid # grid is (HEIGHT, WIDTH, n_kinds) in numpy, often accessed as (row, col) or (y, x)\n  \n  # 1. Get the integer index for the primitive\n  i_primitive = world.cookbook.index[primitive]\n  if i_primitive is None:\n      # If the primitive name is not recognized, no actions can be taken.\n      return []\n\n  # Get indices for impassable terrain from the world's non_grabbable_indices set.\n  # These are entities the agent cannot move through.\n  impassable_indices = world.non_grabbable_indices\n\n  # Define possible movement directions and their corresponding actions and deltas.\n  # Delats are (delta_row, delta_col)\n  move_deltas_and_actions = [\n      ((-1, 0), craft.UP),    # Move Up: Decreases row index\n      ((1, 0), craft.DOWN),   # Move Down: Increases row index\n      ((0, -1), craft.LEFT),  # Move Left: Decreases column index\n      ((0, 1), craft.RIGHT)   # Move Right: Increases column index\n  ]\n\n  start_pos = current_state.pos # Agent's current (row, col)\n  grid_height, grid_width, _ = grid.shape\n\n  # Helper function to determine if a cell is traversable.\n  # A cell is traversable if it's within grid bounds and does not contain any impassable objects.\n  def is_traversable(r, c, grid_data, impassable_idx_set):\n      if not (0 <= r < grid_height and 0 <= c < grid_width):\n          return False  # Out of bounds\n      \n      # Check if the cell contains any impassable objects\n      for k_idx in impassable_idx_set:\n          if grid_data[r, c, k_idx] > 0:\n              return False  # Contains an impassable object\n      return True  # Cell is traversable\n\n  # Step 1: Identify all cells on the grid that contain the primitive.\n  primitive_locations = []\n  for r in range(grid_height):\n      for c in range(grid_width):\n          # Check if the primitive exists at this specific (r, c) location\n          if grid[r, c, i_primitive] > 0:\n              primitive_locations.append((r, c))\n  \n  if not primitive_locations:\n      # The primitive does not exist anywhere on the current grid\n      return []\n\n  # Step 2: Determine all \"valid_use_positions\".\n  # These are cells where the agent can stand such that the primitive\n  # is within its 3x3 neighborhood (including the cell the agent is on).\n  # This corresponds to positions where CraftState.next_to(i_primitive) would be True.\n  valid_use_positions = set()\n  for pr, pc in primitive_locations:\n      # Iterate through the 3x3 neighborhood centered at (pr, pc)\n      for dr_offset in [-1, 0, 1]:\n          for dc_offset in [-1, 0, 1]:\n              target_r, target_c = pr + dr_offset, pc + dc_offset\n              # Ensure the target position is within grid boundaries\n              if 0 <= target_r < grid_height and 0 <= target_c < grid_width:\n                  valid_use_positions.add((target_r, target_c))\n\n  # Step 3: Perform Breadth-First Search (BFS) to find the shortest path\n  # from the agent's start_pos to any of the valid_use_positions.\n  \n  # The queue stores tuples: (current_position, list_of_actions_to_reach_current_position)\n  queue = collections.deque([(start_pos, [])])\n  \n  # The visited set stores positions to avoid cycles and redundant exploration.\n  visited = {start_pos}\n\n  # Optimization: If the agent is already at a valid_use_position, just perform USE.\n  if start_pos in valid_use_positions:\n      return [craft.USE]\n\n  while queue:\n      (curr_r, curr_c), path = queue.popleft()\n\n      # Explore neighbors (UP, DOWN, LEFT, RIGHT)\n      for (dr, dc), action in move_deltas_and_actions:\n          next_r, next_c = curr_r + dr, curr_c + dc\n          next_pos = (next_r, next_c)\n\n          if next_pos in visited:\n              continue # Skip if already visited\n\n          # Check if the next position is traversable\n          if is_traversable(next_r, next_c, grid, impassable_indices):\n              visited.add(next_pos) # Mark as visited\n              new_path = path + [action] # Extend the path with the current action\n              \n              # If the next position is a valid interaction spot, we've found the shortest path.\n              # BFS guarantees the first path found to a target is the shortest.\n              if next_pos in valid_use_positions:\n                  # Append the USE action and return the complete path\n                  return new_path + [craft.USE]\n              \n              # Otherwise, add the next position to the queue for further exploration\n              queue.append((next_pos, new_path))\n\n  # If the BFS queue becomes empty and no path was found, return an empty list.\n  return []", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T04:59:41.468756", "function_name": "collect", "function_body": "  # Get the current state from the environment\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos  # Agent's initial (row, col) position\n  initial_dir = current_state.dir  # Agent's initial facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the primitive we want to collect\n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  # Get grid dimensions\n  num_rows, num_cols, _ = initial_grid.shape\n\n  # Retrieve action mappings for movement and use actions\n  action_map = env.action_specs()\n  MOVE_FORWARD = action_map['UP']  # 'UP' action moves agent forward relative to its facing direction\n  TURN_LEFT = action_map['LEFT']\n  TURN_RIGHT = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define how agent's (row, col) changes when moving forward based on its direction\n  # Direction mapping: 0=RIGHT, 1=UP, 2=LEFT, 3=DOWN\n  DELTA_POS_BY_DIR = {\n      0: (0, 1),   # Right (no change in row, +1 in col)\n      1: (-1, 0),  # Up (-1 in row, no change in col)\n      2: (0, -1),  # Left (no change in row, -1 in col)\n      3: (1, 0)    # Down (+1 in row, no change in col)\n  }\n\n  # Define how agent's direction changes when turning left or right\n  TURN_LEFT_DIR_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # e.g., Right (0) -> Up (1)\n  TURN_RIGHT_DIR_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # e.g., Right (0) -> Down (3)\n\n  # Get indices of entities that block agent movement (e.g., walls, water, workshops)\n  # The agent cannot move into cells occupied by these entities.\n  impassable_entity_ids = current_state.world.non_grabbable_indices\n\n  # Helper function to check if a cell (r, c) is a valid and traversable location for the agent\n  def is_traversable(r: int, c: int) -> bool:\n      # Check if coordinates are within the grid boundaries\n      if not (0 <= r < num_rows and 0 <= c < num_cols):\n          return False\n      \n      # Check if the cell contains any entity that blocks agent movement\n      for entity_id in impassable_entity_ids:\n          if initial_grid[r, c, entity_id] > 0:\n              return False\n      \n      # The agent cannot move into the cell where the primitive itself is located.\n      # It must be adjacent to the primitive and use the 'USE' action to collect it.\n      if initial_grid[r, c, primitive_id] > 0:\n          return False\n          \n      return True\n\n  # Initialize Breadth-First Search (BFS) to find the shortest path\n  # Queue stores tuples: ((agent_position_tuple, agent_direction_int), list_of_actions_taken_to_reach_this_state)\n  bfs_queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (position_tuple, direction_int) to avoid redundant computations and cycles,\n  # ensuring that the first path found is the shortest.\n  visited_states = {(initial_pos, initial_dir)}\n\n  shortest_path_to_primitive = None # Stores the action sequence leading to the primitive-facing state\n\n  while bfs_queue:\n      (current_pos, current_dir), path_so_far = bfs_queue.popleft()\n      current_r, current_c = current_pos\n\n      # 1. Check if the current state is the \"goal\" state for collection:\n      # Is the primitive directly in front of the agent?\n      dr_front, dc_front = DELTA_POS_BY_DIR[current_dir]\n      front_r, front_c = current_r + dr_front, current_c + dc_front\n      \n      # Check if the cell in front is within grid boundaries\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n          # Check if the primitive is in the cell directly in front\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              shortest_path_to_primitive = path_so_far\n              break # Found the shortest path to a position where we can collect!\n\n      # 2. Explore possible next actions from the current state: Move, Turn Left, Turn Right\n\n      # Option A: Move Forward\n      next_r_move, next_c_move = current_r + DELTA_POS_BY_DIR[current_dir][0], \\\n                                 current_c + DELTA_POS_BY_DIR[current_dir][1]\n      next_pos_move = (next_r_move, next_c_move)\n      next_dir_move = current_dir # Direction doesn't change on move\n\n      # If the next cell is traversable and this state (position, direction) hasn't been visited\n      if is_traversable(next_r_move, next_c_move) and \\\n         (next_pos_move, next_dir_move) not in visited_states:\n          visited_states.add((next_pos_move, next_dir_move))\n          bfs_queue.append(((next_pos_move, next_dir_move), path_so_far + [MOVE_FORWARD]))\n\n      # Option B: Turn Left\n      next_dir_turn_left = TURN_LEFT_DIR_MAP[current_dir]\n      # Position does not change when turning\n      if (current_pos, next_dir_turn_left) not in visited_states:\n          visited_states.add((current_pos, next_dir_turn_left))\n          bfs_queue.append(((current_pos, next_dir_turn_left), path_so_far + [TURN_LEFT]))\n\n      # Option C: Turn Right\n      next_dir_turn_right = TURN_RIGHT_DIR_MAP[current_dir]\n      # Position does not change when turning\n      if (current_pos, next_dir_turn_right) not in visited_states:\n          visited_states.add((current_pos, next_dir_turn_right))\n          bfs_queue.append(((current_pos, next_dir_turn_right), path_so_far + [TURN_RIGHT]))\n\n  # If a path to the primitive-facing state was found, append the 'USE' action\n  # to the path to complete the collection.\n  final_actions = []\n  if shortest_path_to_primitive is not None:\n      final_actions.extend(shortest_path_to_primitive)\n      final_actions.append(USE_ACTION) # The final action to collect the primitive\n\n  return final_actions", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T04:59:42.729674", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's initial position (row, col)\n  initial_dir = current_state.dir # Agent's initial facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Resolve the string name of the primitive to its integer ID.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # --- Improvement for v2: Ensure the primitive is actually grabbable ---\n  # If the goal of 'collect' is to acquire items into the agent's inventory,\n  # then the specified primitive must be one that can be picked up.\n  # If it's a non-grabbable item (like 'BOUNDARY', 'WATER', or 'WORKSHOPX'),\n  # this function should not attempt to find a path to 'collect' it,\n  # as 'USE' on such items does not result in inventory acquisition.\n  if primitive_id not in current_state.world.grabbable_indices:\n      # If the primitive is not grabbable, return an empty list of actions,\n      # signifying that it cannot be 'collected' in the sense of adding to inventory.\n      return []\n\n  num_rows, num_cols, _ = initial_grid.shape\n\n  # Retrieve numerical action codes from the environment's action_specs.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define how movement changes row/column based on the agent's current direction.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: moves to (row, col+1)\n      1: (-1, 0),  # Facing UP: moves to (row-1, col)\n      2: (0, -1),  # Facing LEFT: moves to (row, col-1)\n      3: (1, 0)    # Facing DOWN: moves to (row+1, col)\n  }\n\n  # Define how turns update the agent's direction (clockwise order for turns).\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # Get indices of entities that block agent movement (e.g., BOUNDARY, WATER, WORKSHOP_X).\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # Helper function to determine if the agent can move into a specific cell (r, c).\n  def is_cell_walkable(r: int, c: int) -> bool:\n      # Check if coordinates are within the grid boundaries.\n      if not (0 <= r < num_rows and 0 <= c < num_cols):\n          return False\n      \n      # Check if the cell contains any entity that explicitly blocks agent movement.\n      for kind_idx in non_walkable_kinds_indices:\n          if initial_grid[r, c, kind_idx] > 0:\n              return False\n      \n      # The agent cannot move into the cell *occupied by* the primitive it wants to collect.\n      # It must be adjacent to it and use the 'USE' action.\n      if initial_grid[r, c, primitive_id] > 0:\n          return False\n          \n      return True\n\n  # Initialize Breadth-First Search (BFS) for finding the shortest path.\n  # The queue stores tuples: ((agent_position_tuple, agent_direction_int), list_of_actions_taken_so_far).\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # The visited set stores (agent_position_tuple, agent_direction_int) tuples to prevent\n  # re-exploring states already visited.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the optimal action sequence to reach the pre-collection state.\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Goal Check: Determine if the primitive is directly in front of the agent from the current state.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the cell in front is within grid boundaries before checking its contents.\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n          # If the primitive is present in the cell directly in front, we have found our target state.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Shortest path found, exit the BFS loop.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n\n      # Try Moving Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Direction remains unchanged.\n\n      if is_cell_walkable(next_r, next_c) and (next_pos, next_dir) not in visited:\n          visited.add((next_pos, next_dir))\n          queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turning Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Position does not change when turning.\n      if (current_pos, next_dir_left) not in visited:\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turning Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Position does not change when turning.\n      if (current_pos, next_dir_right) not in visited:\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path to the target pre-collection state was found, append the final 'USE' action.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION) # Add the crucial 'USE' action to collect the primitive.\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T05:00:22.900441", "function_name": "collect", "function_body": "  \"\"\"Returns a list of actions to find and collect the primitive in the passed env.\n    \n    This version refines pathfinding for efficiency and clarity, ensuring\n    optimal traversal logic by pre-computing obstacle locations.\n\n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect.\n\n    Returns:\n        List[int]: A sequence of action indices to execute.\n  \"\"\"\n  actions = []\n  \n  # 1. Retrieve current environment state and essential IDs.\n  #    `_current_state` holds the dynamic game state including the grid, \n  #    agent's position, and inventory.\n  current_state = env._current_state \n  grid = current_state.grid\n  current_pos = current_state.pos # Agent's current (row, column) position\n  \n  # Get the integer ID for the specified primitive string.\n  # We assume 'primitive' is a valid, existing item name in the cookbook's index.\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Get grid dimensions (number of rows and columns) for boundary checks.\n  GRID_ROWS, GRID_COLS, _ = grid.shape\n\n  # Map action names (e.g., \"UP\", \"USE\") to their corresponding integer values.\n  # This makes the code robust to changes in the environment's action mapping.\n  action_specs = env.action_specs()\n  DOWN = action_specs['DOWN']\n  UP = action_specs['UP']\n  LEFT = action_specs['LEFT']\n  RIGHT = action_specs['RIGHT']\n  USE = action_specs['USE']\n\n  # Define movement deltas for the four cardinal directions.\n  # These tuples (row_change, col_change) correspond to moving up, down, left, or right.\n  MOVEMENT_DELTAS = {\n      UP: (-1, 0),    # Moving UP decreases the row index\n      DOWN: (1, 0),   # Moving DOWN increases the row index\n      LEFT: (0, -1),  # Moving LEFT decreases the column index\n      RIGHT: (0, 1)   # Moving RIGHT increases the column index\n  }\n\n  # 2. Pre-compute an obstacle map for efficient traversability checks during BFS.\n  #    This avoids repeatedly checking for non-grabbable items for every neighbor\n  #    during the pathfinding process. A cell is an obstacle if it contains any\n  #    entity that cannot be walked on or picked up (e.g., BOUNDARY, WATER, WORKSHOP).\n  is_obstacle_map = np.zeros((GRID_ROWS, GRID_COLS), dtype=bool)\n  for r in range(GRID_ROWS):\n      for c in range(GRID_COLS):\n          # Check if any of the \"non_grabbable_indices\" (obstacles) are present at (r,c).\n          is_obstacle_map[r, c] = any(grid[r, c, kind_idx] == 1 \n                                      for kind_idx in env.world.non_grabbable_indices)\n\n  # 3. Immediate check: If the agent is already adjacent to the primitive.\n  #    The `next_to` method efficiently checks if the primitive is within the 3x3\n  #    neighborhood of the agent. If so, only a 'USE' action is needed.\n  if current_state.next_to(primitive_id):\n      actions.append(USE)\n      return actions\n\n  # 4. Locate all occurrences of the target primitive on the grid.\n  #    We need to know all possible target locations for our pathfinding.\n  primitive_locations = []\n  for r in range(GRID_ROWS):\n      for c in range(GRID_COLS):\n          # If the primitive's ID layer at (r, c) is 1, the primitive is present.\n          if grid[r, c, primitive_id] == 1:\n              primitive_locations.append((r, c))\n\n  # If no instances of the primitive are found anywhere on the grid,\n  # it cannot be collected, so return an empty list of actions.\n  if not primitive_locations:\n      return []\n\n  # 5. Perform Breadth-First Search (BFS) to find the shortest path.\n  #    The goal is to find the shortest sequence of movement actions that lead\n  #    the agent to a cell *adjacent* to any of the primitive locations.\n\n  # The BFS queue stores tuples: `((current_row, current_col), [list_of_actions_to_reach_here])`.\n  q = collections.deque([(current_pos, [])]) \n  \n  # The `visited` set keeps track of `(row, col)` positions already explored\n  # to prevent cycles and redundant path computations.\n  visited = {current_pos} \n\n  # This variable will store the shortest path found to an adjacent cell.\n  shortest_path_to_adjacent = None \n\n  # Start the BFS traversal.\n  while q:\n      (r, c), path_so_far = q.popleft()\n\n      # Check if the current cell (r, c) is adjacent to any of the primitive locations.\n      # Adjacency is defined as a Manhattan distance of 1 (directly horizontal or vertical).\n      for pr, pc in primitive_locations:\n          if abs(r - pr) + abs(c - pc) == 1: \n              shortest_path_to_adjacent = path_so_far # Path found! Store it.\n              break # Exit inner loop, as we've found a target.\n      \n      # If a path to an adjacent cell was found, we can stop the BFS.\n      if shortest_path_to_adjacent is not None:\n          break \n\n      # Explore valid neighboring cells (up, down, left, right).\n      for action_dir, (dr, dc) in MOVEMENT_DELTAS.items():\n          nr, nc = r + dr, c + dc # Calculate the coordinates of the potential new position.\n\n          # Boundary check: Ensure the new position is within the grid limits.\n          if not (0 <= nr < GRID_ROWS and 0 <= nc < GRID_COLS):\n              continue\n          \n          # Obstacle check: Use the pre-computed `is_obstacle_map` for efficiency.\n          if is_obstacle_map[nr, nc]:\n              continue # Skip this neighbor if it's an obstacle.\n          \n          # If the neighbor is traversable and has not been visited yet, add it to the queue.\n          if (nr, nc) not in visited:\n              visited.add((nr, nc)) # Mark this position as visited.\n              # Extend the path with the action taken to reach this new position.\n              new_path = path_so_far + [action_dir] \n              q.append(((nr, nc), new_path)) # Add the new state to the BFS queue.\n    \n  # 6. Construct the final action sequence.\n  #    If a path to an adjacent cell was successfully found during BFS,\n  #    append these movement actions to the `actions` list.\n  if shortest_path_to_adjacent is not None:\n      actions.extend(shortest_path_to_adjacent)\n      # After reaching a cell adjacent to the primitive, perform the 'USE' action.\n      # This typically picks up grabbable items or interacts with non-grabbable structures.\n      actions.append(USE) \n  \n  return actions", "island_id": 0, "scores": {"3": 0.0}}
