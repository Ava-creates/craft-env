{"timestamp": "2025-08-01T07:03:32.706106", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_agent_pos = current_state.pos  # Agent's initial position (row, col)\n  initial_agent_dir = current_state.dir  # Agent's initial facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook's index.\n  # This assumes 'primitive' is a valid, known item in the environment's index.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Determine grid dimensions (height, width, number of kinds)\n  num_rows, num_cols, _ = initial_grid.shape\n\n  # Retrieve integer action IDs from the environment's action specifications.\n  # These are fixed constants used for controlling the agent.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # Corresponds to moving forward in the current direction\n  TURN_LEFT_ACTION = action_map['LEFT']     # Corresponds to turning 90 degrees left\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Corresponds to turning 90 degrees right\n  USE_ITEM_ACTION = action_map['USE']            # Action to interact with the cell directly in front\n\n  # Define how agent's (row, col) position changes based on its direction when moving forward.\n  # (dr, dc) represents (delta_row, delta_col)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # Define how agent's direction changes when turning left or right.\n  TURN_LEFT_DIR_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # RIGHT->UP->LEFT->DOWN->RIGHT\n  TURN_RIGHT_DIR_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # RIGHT->DOWN->LEFT->UP->RIGHT\n\n  # Get indices of entities that block agent movement (e.g., BOUNDARY, WATER, WORKSHOP_X).\n  # The agent cannot walk onto these cells. Converting set to list for NumPy indexing.\n  non_walkable_kinds_indices = list(current_state.world.non_grabbable_indices)\n\n  # BFS Initialization:\n  # The queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_to_reach_here)\n  queue = collections.deque([((initial_agent_pos, initial_agent_dir), [])])\n  \n  # The visited set stores (position_tuple, direction_int) pairs to avoid\n  # revisiting states and finding suboptimal paths (ensures shortest path).\n  visited = {(initial_agent_pos, initial_agent_dir)}\n\n  # This variable will store the sequence of actions leading to the state\n  # where the agent is adjacent to the primitive and facing it.\n  path_to_primitive_adjacent = None \n\n  # Start BFS traversal\n  while queue:\n      (current_pos, current_dir), path_taken = queue.popleft()\n      current_row, current_col = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent from the current state.\n      # This is the goal state for the pathfinding part of collection.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_cell_row, front_cell_col = current_row + front_dr, current_col + front_dc\n      \n      # Ensure the front cell is within grid boundaries\n      if (0 <= front_cell_row < num_rows and 0 <= front_cell_col < num_cols):\n          # Check if the primitive is present in this front cell (i.e., its count is > 0)\n          if initial_grid[front_cell_row, front_cell_col, primitive_id] > 0:\n              path_to_primitive_adjacent = path_taken\n              break # Found the shortest path to an adjacent and facing state, exit BFS.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n\n      # Try Move Forward action:\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_row, next_col = current_row + move_dr, current_col + move_dc\n      next_pos = (next_row, next_col)\n      next_dir = current_dir # Direction does not change when moving forward\n\n      # Check if the potential next position is valid (within bounds) and has not been visited with this orientation.\n      if (0 <= next_row < num_rows and 0 <= next_col < num_cols and\n          (next_pos, next_dir) not in visited):\n          \n          # Determine if the next cell is walkable.\n          # A cell is not walkable if it contains any non-grabbable entity (like boundary, water, workshop)\n          # or if it contains the primitive itself (as the primitive needs to be \"used\" from an adjacent square, not walked onto).\n          is_walkable = True\n          \n          # Check for non-walkable entities at the next cell.\n          # np.sum is used to check if any of the non-grabbable kinds are present in the cell.\n          if non_walkable_kinds_indices and np.sum(initial_grid[next_row, next_col, non_walkable_kinds_indices]) > 0:\n              is_walkable = False\n          \n          # Also, ensure we don't try to walk onto the primitive itself.\n          if is_walkable and initial_grid[next_row, next_col, primitive_id] > 0: \n              is_walkable = False\n\n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_taken + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left action:\n      next_dir_left = TURN_LEFT_DIR_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_taken + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right action:\n      next_dir_right = TURN_RIGHT_DIR_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_taken + [TURN_RIGHT_ACTION]))\n\n  # If a path to the target adjacency state was found,\n  # append the USE action to complete the collection.\n  if path_to_primitive_adjacent is not None:\n      actions_list.extend(path_to_primitive_adjacent)\n      actions_list.append(USE_ITEM_ACTION)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T07:04:36.458034", "function_name": "collect", "function_body": "  actions = []\n\n  # Resolve the primitive name string to its corresponding integer ID.\n  try:\n    primitive_id = env.world.cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # Early exit: If the primitive is not a grabbable item (e.g., 'WATER', 'BOUNDARY', 'WORKSHOP0'),\n  # it cannot be \"collected\" into the agent's inventory.\n  if primitive_id not in env.world.grabbable_indices:\n    return []\n\n  current_state = env._current_state\n  grid = current_state.grid\n  current_pos = current_state.pos\n\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Retrieve action mappings for robustness.\n  _action_specs = env.action_specs()\n  DOWN = _action_specs['DOWN']\n  UP = _action_specs['UP']\n  LEFT = _action_specs['LEFT']\n  RIGHT = _action_specs['RIGHT']\n  USE = _action_specs['USE']\n\n  # Define movement deltas for cardinal directions, mapping actions to (dr, dc).\n  DELTAS = {\n      UP: (-1, 0),\n      DOWN: (1, 0),\n      LEFT: (0, -1),\n      RIGHT: (0, 1)\n  }\n\n  # 1. Immediate Check: Is the agent already adjacent to the primitive?\n  # The `next_to` method checks the 3x3 neighborhood.\n  if current_state.next_to(primitive_id):\n      # Since we've already confirmed `primitive_id` is grabbable,\n      # a single 'USE' action is sufficient.\n      actions.append(USE)\n      return actions\n\n  # 2. Find all grid locations where the target primitive exists.\n  primitive_locations = []\n  for r in range(WIDTH):\n      for c in range(HEIGHT):\n          # A value of 1 in the primitive's layer indicates its presence.\n          if grid[r, c, primitive_id] == 1:\n              primitive_locations.append((r, c))\n\n  # If the primitive is not found anywhere on the grid, it cannot be collected.\n  if not primitive_locations:\n      return []\n\n  # 3. Perform Breadth-First Search (BFS) to find the shortest path\n  #    to a traversable cell that is cardinally adjacent to any primitive location.\n  # The queue stores tuples: ((current_row, current_col), [list_of_actions_to_reach_here]).\n  q = collections.deque([(current_pos, [])])\n  # The `visited` set tracks grid positions already explored to prevent cycles\n  # and ensure the shortest path is found.\n  visited = {current_pos}\n\n  target_adj_pos_path = None # This will store the action sequence to the adjacent cell.\n\n  while q:\n      (r, c), path = q.popleft()\n\n      # Check if the current BFS position (r, c) is cardinally adjacent to any primitive location.\n      # Manhattan distance of 1 means it's a direct neighbor (up, down, left, right).\n      for pr, pc in primitive_locations:\n          if abs(r - pr) + abs(c - pc) == 1:\n              target_adj_pos_path = path # Found the shortest path to an adjacent cell.\n              break # Exit inner loop as the target is identified for this path.\n      \n      if target_adj_pos_path is not None:\n          break # Exit the BFS loop once the optimal path to an adjacent cell is found.\n\n      # Explore valid neighboring cells (UP, DOWN, LEFT, RIGHT) from the current position.\n      for action_dir, (dr, dc) in DELTAS.items():\n          nr, nc = r + dr, c + dc # Calculate the potential new position.\n          next_pos = (nr, nc)\n\n          # Boundary Check: Ensure the new position is within grid limits.\n          if not (0 <= nr < WIDTH and 0 <= nc < HEIGHT):\n              continue\n          \n          # Traversability Check:\n          # A cell is non-traversable if it contains any item from `non_grabbable_indices`.\n          # Agent cannot move onto these cells (e.g., walls, water, workshops).\n          is_traversable = True\n          for i_kind in env.world.non_grabbable_indices:\n              if grid[nr, nc, i_kind] == 1:\n                  is_traversable = False\n                  break\n          \n          if not is_traversable:\n              continue # Skip this neighbor if it's an obstacle.\n          \n          # Visited Check: If the neighbor has not been visited, add it to the queue.\n          if next_pos not in visited:\n              visited.add(next_pos) # Mark the new position as visited.\n              new_path = path + [action_dir] # Extend the current path.\n              q.append((next_pos, new_path)) # Add the new state to the queue.\n    \n  # 4. Construct the final sequence of actions.\n  # If a path to an adjacent cell was found, extend the actions list with this path.\n  if target_adj_pos_path is not None:\n      actions.extend(target_adj_pos_path)\n      # Append the 'USE' action to collect the primitive, as it's guaranteed to be grabbable\n      # and the agent is now in an adjacent traversable position.\n      actions.append(USE)\n  \n  return actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T07:04:37.594008", "function_name": "collect", "function_body": "  actions = []\n\n  # Access the current state of the environment.\n  current_state = env._current_state \n  grid = current_state.grid\n  current_pos = current_state.pos\n  initial_dir = current_state.dir # Agent's initial facing direction\n\n  # Resolve the primitive name string to its corresponding integer ID.\n  try:\n    primitive_id = env.world.cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # Get grid dimensions.\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Retrieve action mappings from the environment's action_specs.\n  _action_specs = env.action_specs()\n  ACTION_DOWN = _action_specs['DOWN']\n  ACTION_UP = _action_specs['UP']\n  ACTION_LEFT = _action_specs['LEFT']\n  ACTION_RIGHT = _action_specs['RIGHT']\n  ACTION_USE = _action_specs['USE']\n\n  # Define movement deltas for cardinal directions, mapping action constants to (dr, dc) tuples.\n  # This mapping is used to determine new positions and the direction the agent faces after a move.\n  DELTAS_MAP = {\n      ACTION_UP: (-1, 0),    # Moving UP decreases the row index.\n      ACTION_DOWN: (1, 0),   # Moving DOWN increases the row index.\n      ACTION_LEFT: (0, -1),  # Moving LEFT decreases the column index.\n      ACTION_RIGHT: (0, 1)   # Moving RIGHT increases the column index.\n  }\n  \n  # List of all possible movement actions (for BFS exploration).\n  MOVE_ACTIONS = [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]\n\n  # Essential check: If the primitive is not grabbable, it cannot be collected into inventory.\n  # If we try to collect a non-grabbable item (like 'WATER'), we return an empty list.\n  if primitive_id not in env.world.grabbable_indices:\n      return []\n\n  # 1. Immediate Check: Is the agent already positioned and facing the primitive?\n  # Calculate the cell directly in front of the agent based on its current position and direction.\n  r_front, c_front = current_pos[0] + DELTAS_MAP[initial_dir][0], \\\n                     current_pos[1] + DELTAS_MAP[initial_dir][1]\n\n  # Check if the 'front' cell is within grid boundaries.\n  if (0 <= r_front < WIDTH and 0 <= c_front < HEIGHT):\n      # If the cell in front contains the primitive, a single 'USE' action is sufficient.\n      if grid[r_front, c_front, primitive_id] == 1:\n          actions.append(ACTION_USE)\n          return actions\n\n  # 2. Find all locations of the target primitive on the grid.\n  primitive_locations = set() # Use a set for faster lookups\n  for r in range(WIDTH):\n      for c in range(HEIGHT):\n          if grid[r, c, primitive_id] == 1:\n              primitive_locations.add((r, c))\n\n  # If the primitive isn't found anywhere on the grid, it cannot be collected.\n  if not primitive_locations:\n      return []\n\n  # 3. Perform Breadth-First Search (BFS) to find the shortest path\n  #    to a state ((row, col), direction) from which the primitive can be collected.\n  # A state in BFS is ((current_row, current_col), current_facing_direction).\n  # The queue stores tuples: (state, [list_of_actions_to_reach_here]).\n  q = collections.deque([(((current_pos), initial_dir), [])]) \n  \n  # The `visited` set tracks (position, direction) pairs already explored\n  # to prevent cycles and ensure the shortest path in terms of steps.\n  visited = {(current_pos, initial_dir)} \n\n  target_path = None # This will store the action sequence to the collection-ready state.\n\n  while q:\n      ((r, c), current_dir), path = q.popleft()\n\n      # Goal Check: Is the current (position, direction) state suitable for collecting?\n      # Calculate the cell that the agent is currently facing.\n      dr_facing, dc_facing = DELTAS_MAP[current_dir]\n      front_r, front_c = r + dr_facing, c + dc_facing\n\n      # If the cell in front is within bounds and contains the primitive, we found our target.\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT) and \\\n         ((front_r, front_c) in primitive_locations):\n          target_path = path # Found the shortest path to this collection-ready state.\n          break # Exit BFS, the optimal path is found.\n\n      # Explore valid neighboring cells by performing movement actions.\n      for move_action in MOVE_ACTIONS:\n          dr_move, dc_move = DELTAS_MAP[move_action]\n          nr, nc = r + dr_move, c + dc_move # Calculate the potential new position.\n          new_dir = move_action # The agent's direction will be updated to the direction of movement.\n          next_state_in_bfs = ((nr, nc), new_dir)\n\n          # Boundary Check: Ensure the new position is within the grid limits.\n          if not (0 <= nr < WIDTH and 0 <= nc < HEIGHT):\n              continue\n          \n          # Traversability Check:\n          # A cell is non-traversable if it contains any item from the `non_grabbable_indices` set.\n          is_traversable = True\n          for i_kind in env.world.non_grabbable_indices:\n              if grid[nr, nc, i_kind] == 1: \n                  is_traversable = False\n                  break \n          \n          if not is_traversable:\n              continue \n          \n          # Visited Check: If this (position, direction) state has not been visited, add it to the queue.\n          if next_state_in_bfs not in visited:\n              visited.add(next_state_in_bfs) \n              new_path = path + [move_action] \n              q.append((next_state_in_bfs, new_path)) \n    \n  # 4. Construct the final sequence of actions.\n  if target_path is not None:\n      actions.extend(target_path)\n      actions.append(ACTION_USE) # Once positioned and facing, perform the 'USE' action.\n  \n  return actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T07:05:24.970956", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's current (row, column) tuple\n  initial_dir = current_state.dir # Agent's current facing direction (0:Right, 1:Up, 2:Left, 3:Down)\n\n  # Get the integer ID for the target primitive from the cookbook index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  num_rows, num_cols, _ = initial_grid.shape # Extract grid dimensions\n\n  # Map symbolic actions from action_specs to their integer indices\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP'] # 'UP' in action_specs typically means \"move forward\"\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define changes in (row, col) for each direction (0:Right, 1:Up, 2:Left, 3:Down)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: +1 to column (col)\n      1: (-1, 0),  # Facing UP: -1 to row (row)\n      2: (0, -1),  # Facing LEFT: -1 to column (col)\n      3: (1, 0)    # Facing DOWN: +1 to row (row)\n  }\n\n  # Define how direction changes when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Get indices of entities that block agent movement (non-grabbable terrain/objects)\n  non_grabbable_indices = current_state.world.non_grabbable_indices\n  # Create a set of non-walkable indices for efficient lookups.\n  # The primitive itself is typically not walkable, as the agent needs to be adjacent to collect it.\n  non_walkable_for_movement_set = set(non_grabbable_indices)\n  non_walkable_for_movement_set.add(primitive_id)\n  \n  # Convert to a numpy array once for efficient grid checking during BFS.\n  # This is an optimization for potentially faster checks compared to iterating a Python set.\n  non_walkable_for_movement_array = np.array(list(non_walkable_for_movement_set), dtype=int)\n\n\n  # BFS state representation: ((current_row, current_col), current_direction_int)\n  # Queue stores (state, list_of_actions_to_reach_this_state)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (state) to avoid redundant computations and cycles\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the action sequence leading to the state\n                      # where the agent is adjacent to the primitive and facing it.\n\n  while queue:\n      (current_pos, current_dir), path_to_current_state = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent at current state\n      # Calculate the coordinates of the cell directly in front of the agent\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the cell in front is within grid bounds AND contains the primitive\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols and\n          initial_grid[front_r, front_c, primitive_id] > 0):\n          \n          target_path = path_to_current_state\n          break # Found the path to be adjacent and facing the primitive\n\n      # 2. Explore possible next actions from the current state (Move Forward, Turn Left, Turn Right)\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if the next position is valid and has not been visited with this direction\n      if (next_pos, next_dir) not in visited:\n          # Check bounds first\n          if 0 <= next_r < num_rows and 0 <= next_c < num_cols:\n              # Check if the next_pos contains any blocking kind using the pre-computed numpy array.\n              # np.any efficiently checks if any non-walkable item exists in the cell's `kind` dimension.\n              if not np.any(initial_grid[next_r, next_c, non_walkable_for_movement_array] > 0):\n                  visited.add((next_pos, next_dir))\n                  queue.append(((next_pos, next_dir), path_to_current_state + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_to_current_state + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_to_current_state + [TURN_RIGHT_ACTION]))\n\n  # If a path was found to reach an adjacent and facing position, append the USE action\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 1, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T07:05:26.173381", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's current (row, column) tuple\n  initial_dir = current_state.dir # Agent's current facing direction (0:Right, 1:Up, 2:Left, 3:Down)\n\n  # Get the integer ID for the target primitive from the cookbook index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  num_rows, num_cols, _ = initial_grid.shape # Extract grid dimensions\n\n  # Map symbolic actions from action_specs to their integer indices\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP'] # Assuming 'UP' is the action for moving forward\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define changes in (row, col) for each direction (0:Right, 1:Up, 2:Left, 3:Down)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: +1 to column (col)\n      1: (-1, 0),  # Facing UP: -1 to row (row)\n      2: (0, -1),  # Facing LEFT: -1 to column (col)\n      3: (1, 0)    # Facing DOWN: +1 to row (row)\n  }\n\n  # Define how direction changes when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Get indices of entities that block agent movement (non-grabbable/non-walkable terrain/objects)\n  non_grabbable_indices = current_state.world.non_grabbable_indices\n  # Create a set of non-walkable indices for efficient lookups.\n  # The primitive itself is typically not walkable, as the agent needs to be adjacent to collect it.\n  non_walkable_for_movement = set(non_grabbable_indices)\n  non_walkable_for_movement.add(primitive_id)\n  # Convert to numpy array for efficient indexing in the grid check\n  blocking_kind_indices_np = np.array(list(non_walkable_for_movement), dtype=int)\n\n\n  # BFS state representation: ((current_row, current_col), current_direction_int)\n  # Queue stores (state, list_of_actions_to_reach_this_state)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (state) to avoid redundant computations and cycles\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the action sequence leading to the state\n                      # where the agent is adjacent to the primitive and facing it.\n\n  while queue:\n      (current_pos, current_dir), path_to_current_state = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent at current state\n      # Calculate the coordinates of the cell directly in front of the agent\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the cell in front is within grid bounds AND contains the primitive\n      # The primitive might be a multi-layer item, so > 0 check is correct.\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols and\n          initial_grid[front_r, front_c, primitive_id] > 0):\n          \n          target_path = path_to_current_state\n          break # Found the path to be adjacent and facing the primitive\n\n      # 2. Explore possible next actions from the current state (Move Forward, Turn Left, Turn Right)\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if the next position is valid and has not been visited with this direction\n      if (next_pos, next_dir) not in visited:\n          # Check bounds for the next position\n          is_in_bounds = (0 <= next_r < num_rows and 0 <= next_c < num_cols)\n          \n          if is_in_bounds:\n              # Check if the next position contains any blocking kind using the pre-computed numpy array.\n              is_walkable_cell = not np.any(initial_grid[next_r, next_c, blocking_kind_indices_np] > 0)\n\n              if is_walkable_cell:\n                  visited.add((next_pos, next_dir))\n                  queue.append(((next_pos, next_dir), path_to_current_state + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_to_current_state + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_to_current_state + [TURN_RIGHT_ACTION]))\n\n  # If a path was found to reach an adjacent and facing position, append the USE action\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 1, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T07:06:10.716572", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  \n  # Extract immutable state information for BFS planning\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's initial position (row, col)\n  initial_dir = current_state.dir # Agent's initial facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive. This is what we're looking for.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Determine grid dimensions for boundary checks\n  num_rows, num_cols, _ = initial_grid.shape\n\n  # Retrieve action mapping from the environment (these are constant action IDs)\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # In CraftWorld, 'UP' means move forward\n  TURN_LEFT_ACTION = action_map['LEFT']     # Turn 90 degrees left\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Turn 90 degrees right\n  USE_ACTION = action_map['USE']            # Interact with the cell in front\n\n  # Define direction vectors for movement and turning rules (constants for agent's movement mechanics)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # Pre-process non-walkable entity indices for efficient lookup\n  # These are entities the agent cannot walk onto. Converting to a NumPy array for fast slicing.\n  non_walkable_kinds_indices_np = np.array(list(current_state.world.non_grabbable_indices))\n\n  # BFS Initialization\n  # Queue stores ( (current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (position_tuple, direction_int) to prevent redundant exploration and cycles.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # Stores the action sequence if a path is found.\n\n  # Start BFS traversal\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # Check if the target primitive is directly in front of the agent.\n      # This is the \"goal state\" for our pathfinding: being positioned to interact with the primitive.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the cell in front is within grid boundaries\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n          # If the primitive is present in this cell, we've found our path to be adjacent.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Path found! Terminate BFS.\n\n      # Explore possible next actions: Move Forward, Turn Left, Turn Right\n\n      # --- Try Move Forward ---\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Direction doesn't change when moving forward\n\n      # Check boundary conditions and if the new state (position, direction) has been visited\n      if (0 <= next_r < num_rows and 0 <= next_c < num_cols and\n          (next_pos, next_dir) not in visited):\n          \n          # Determine if the next cell is walkable.\n          # The agent cannot walk onto:\n          # 1. The primitive itself (must be adjacent to use the 'USE' action).\n          # 2. Any non-grabbable entities (like boundaries, water, or specific workshops that are impassable).\n          \n          # Check if the cell contains the primitive itself\n          can_walk_on_primitive_spot = (initial_grid[next_r, next_c, primitive_id] == 0)\n          \n          # Check for other non-walkable entities using NumPy for efficiency\n          no_obstacles_in_spot = True\n          if len(non_walkable_kinds_indices_np) > 0:\n              if np.any(initial_grid[next_r, next_c, non_walkable_kinds_indices_np] > 0):\n                  no_obstacles_in_spot = False\n          \n          is_walkable = can_walk_on_primitive_spot and no_obstacles_in_spot\n\n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # --- Try Turn Left ---\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # --- Try Turn Right ---\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path was found, append the final USE action to collect the primitive.\n  # If no path was found (target_path remains None), an empty list is returned.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T07:06:11.918631", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  \n  # Extract immutable state information for BFS planning.\n  # These are snapshots of the initial environment and agent's starting conditions.\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's initial position (row, col)\n  initial_dir = current_state.dir # Agent's initial facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive. This ID is used to locate the primitive on the grid.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Get grid dimensions for boundary checks during pathfinding.\n  num_rows, num_cols, _ = initial_grid.shape\n\n  # Retrieve action mapping from the environment. These are constant integer IDs for actions.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # In CraftWorld, 'UP' means move forward in current direction.\n  TURN_LEFT_ACTION = action_map['LEFT']     # Turn 90 degrees left.\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Turn 90 degrees right.\n  USE_ACTION = action_map['USE']            # Interact with the cell in front of the agent.\n\n  # Define direction vectors and turning rules.\n  # DIR_TO_DRDC: Maps agent's current direction (0-3) to a (delta_row, delta_column) vector,\n  # indicating the cell directly in front of the agent relative to its current position.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # TURN_LEFT_MAP / TURN_RIGHT_MAP: Map current direction to the new direction after a turn.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Cyclic mapping for left turn (e.g., Right -> Up)\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Cyclic mapping for right turn (e.g., Right -> Down)\n\n  # Pre-process non-walkable entities for efficient checking.\n  # These are entities the agent cannot move onto (e.g., boundaries, water, some workshops).\n  # Converting to a NumPy array allows for vectorized checks on grid slices.\n  non_walkable_kinds_indices_np = np.array(list(current_state.world.non_grabbable_indices))\n\n  # BFS initialization:\n  # The queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_here).\n  # Each element represents a state (agent's position and orientation) and the path to achieve it.\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # The 'visited' set stores (position_tuple, direction_int) to prevent redundant exploration\n  # and cycles, ensuring that the shortest path is found.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This variable will store the sequence of actions if a path is found.\n\n  # Start BFS traversal\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos # Current row and column of the agent.\n\n      # 1. Check if the target primitive is directly in front of the agent from the current state.\n      # This is the \"goal state\" for our pathfinding: being positioned to interact with the primitive.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the cell directly in front is within grid boundaries before checking its contents.\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n          # If the primitive is present in this cell, we have found a path that leads the agent\n          # to be adjacent to and facing the primitive.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Path found! Terminate BFS.\n\n      # 2. Explore all possible next actions (Move Forward, Turn Left, Turn Right) from the current state.\n\n      # --- Try Move Forward Action ---\n      # Calculate the next position if the agent moves forward. Direction remains unchanged.\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change orientation.\n\n      # Check if the next position is within bounds and this new (position, direction) state\n      # has not been visited yet.\n      if (0 <= next_r < num_rows and 0 <= next_c < num_cols and\n          (next_pos, next_dir) not in visited):\n          \n          # Determine if the next cell is walkable.\n          # The agent cannot walk onto:\n          # a) The primitive itself (interaction is from an adjacent square, not by stepping on it).\n          # b) Any non-grabbable entities (like boundaries, water, or specific impassable workshops).\n          \n          # Check if the target primitive is in the next cell.\n          is_primitive_in_next_cell = (initial_grid[next_r, next_c, primitive_id] > 0)\n          \n          # Check if any non-walkable entities are in the next cell.\n          # Use np.any with the pre-converted numpy array for efficiency.\n          is_non_walkable_in_next_cell = False\n          if len(non_walkable_kinds_indices_np) > 0:\n              # Slicing the grid at [next_r, next_c] for all kinds, then indexing with\n              # non_walkable_kinds_indices_np selects counts of only non-walkable items.\n              # np.any checks if any of these counts are greater than 0.\n              is_non_walkable_in_next_cell = np.any(initial_grid[next_r, next_c, non_walkable_kinds_indices_np] > 0)\n\n          is_walkable = not (is_primitive_in_next_cell or is_non_walkable_in_next_cell)\n\n          if is_walkable:\n              # If the cell is walkable, add the new state to the queue and mark it as visited.\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # --- Try Turn Left Action ---\n      # Calculate the new direction after turning left. Position remains unchanged.\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Only add to queue if this (position, direction) state hasn't been visited.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # --- Try Turn Right Action ---\n      # Calculate the new direction after turning right. Position remains unchanged.\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Only add to queue if this (position, direction) state hasn't been visited.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # After BFS completes:\n  # If a path to the target (adjacent and facing the primitive) was found,\n  # extend the found path with the final 'USE' action to collect the primitive.\n  # If no path was found (target_path is None), an empty list is returned,\n  # indicating the primitive is unreachable from the current state.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T07:07:40.193689", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (r, c)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  # Get the integer ID for the target primitive from the cookbook index.\n  # This ID is used to locate the primitive on the grid.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  GRID_WIDTH, GRID_HEIGHT, _ = initial_grid.shape\n\n  # Retrieve action mapping from the environment's action specifications.\n  # This ensures compatibility with the environment's `step` method.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # Corresponds to moving in the agent's current direction\n  TURN_LEFT_ACTION = action_map['LEFT']    # Turn 90 degrees left\n  TURN_RIGHT_ACTION = action_map['RIGHT']  # Turn 90 degrees right\n  USE_ACTION = action_map['USE']          # Interact with the cell in front or nearby\n\n  # Define changes in (row, column) for each facing direction when moving forward.\n  # Directions: 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Right: +1 column\n      1: (-1, 0),  # Up:    -1 row\n      2: (0, -1),  # Left:  -1 column\n      3: (1, 0)    # Down:  +1 row\n  }\n\n  # Define how direction changes when turning.\n  # These mappings cycle through the four cardinal directions (0, 1, 2, 3).\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}   # Cycle: R -> U -> L -> D -> R\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}  # Cycle: R -> D -> L -> U -> R\n\n  # Get indices of entities that are considered non-walkable obstacles (e.g., walls, water, workshops).\n  # These are defined in the CraftWorld and cannot be moved onto.\n  # This version (collect_v2) improves upon collect_v0 by treating grabbable primitives\n  # (like WOOD, STONE) as traversable, allowing the agent to walk over them.\n  # Only genuinely non-grabbable items (like BOUNDARY, WATER, WORKSHOP) are considered obstacles.\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # Early Exit Optimization: If the primitive is already within the agent's 3x3 collection range,\n  # directly apply the USE action. This avoids unnecessary pathfinding.\n  # The `CraftState.next_to()` method conveniently checks this condition.\n  if current_state.next_to(primitive_id):\n      return [USE_ACTION]\n\n  # --- Breadth-First Search (BFS) for Shortest Path to a Collectable Position ---\n  # The queue stores states: ( (current_position_tuple, current_direction_int), list_of_actions_to_reach_this_state )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # The visited set prevents revisiting states and finding suboptimal paths (due to BFS property).\n  # A state is uniquely defined by (position_tuple, direction_int).\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the sequence of actions to reach a state from which 'USE' is possible.\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos # Extract current row and column\n\n      # Check if the current agent position (r, c) is a valid location to collect the primitive.\n      # A primitive is collectable if it's found in any cell within the 3x3 neighborhood around the agent.\n      found_collectable_position = False\n      for dr_check in [-1, 0, 1]:\n          for dc_check in [-1, 0, 1]:\n              check_r, check_c = r + dr_check, c + dc_check\n              # Ensure the cell being checked is within grid boundaries\n              if (0 <= check_r < GRID_WIDTH and 0 <= check_c < GRID_HEIGHT and\n                  initial_grid[check_r, check_c, primitive_id] > 0):\n                  found_collectable_position = True\n                  break # Found the primitive in the neighborhood, no need to check further cells for this position.\n          if found_collectable_position:\n              break\n\n      # If a collectable position is found, this path is the shortest to it (due to BFS).\n      if found_collectable_position:\n          target_path = path_actions\n          break # Terminate BFS as the goal is achieved (path to collection point found).\n\n      # Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n\n      # 1. Try Move Forward action\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir_move = current_dir # Agent's direction remains unchanged after moving forward.\n\n      # Check if the potential next position is within grid boundaries and this (position, direction) state\n      # has not been visited before to avoid redundant computations and infinite loops.\n      if (0 <= next_r < GRID_WIDTH and 0 <= next_c < GRID_HEIGHT and\n          (next_pos, next_dir_move) not in visited):\n          \n          is_walkable = True\n          # Determine if the target cell for movement contains any non-walkable entity (obstacle).\n          # The agent cannot move onto cells containing `BOUNDARY`, `WATER`, or `WORKSHOP` types.\n          for kind_idx in non_walkable_kinds_indices:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          \n          if is_walkable:\n              visited.add((next_pos, next_dir_move)) # Mark the new state as visited.\n              queue.append(((next_pos, next_dir_move), path_actions + [MOVE_FORWARD_ACTION])) # Add to queue for exploration.\n\n      # 2. Try Turn Left action\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning changes direction but not position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # 3. Try Turn Right action\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning changes direction but not position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path to a collectable position was found during the BFS, append the 'USE' action\n  # to the path to actually collect the primitive.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T07:07:41.504453", "function_name": "collect", "function_body": "  actions_list = []\n  # Get the current state of the environment. This state includes the grid,\n  # agent's position, direction, and inventory.\n  current_state = env._current_state\n\n  # Store initial grid, position, and direction for pathfinding.\n  # The grid is considered static during pathfinding; only agent's (pos, dir) changes.\n  initial_grid = current_state.grid\n  initial_agent_pos = current_state.pos # Agent's starting row, column tuple (r, c)\n  initial_agent_dir = current_state.dir # Agent's starting direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the world's cookbook index.\n  # This ID is used to locate the primitive on the grid.\n  primitive_kind_id = current_state.world.cookbook.index[primitive]\n\n  # Get grid dimensions to check boundaries during pathfinding.\n  GRID_WIDTH, GRID_HEIGHT, _ = initial_grid.shape\n\n  # Retrieve the mapping from action names (strings) to their integer codes.\n  # This ensures compatibility with the environment's `step` method.\n  action_name_to_id = env.action_specs()\n  \n  # Map DSL movement/turn actions to their integer indices.\n  MOVE_FORWARD_ACTION_ID = action_name_to_id['UP'] # 'UP' in DSL means 'move forward'\n  TURN_LEFT_ACTION_ID = action_name_to_id['LEFT']\n  TURN_RIGHT_ACTION_ID = action_name_to_id['RIGHT']\n  USE_ACTION_ID = action_name_to_id['USE'] # Action to perform collection/interaction\n\n  # Define direction vectors for moving forward based on current orientation.\n  # Maps agent's direction index to (delta_row, delta_column) for a forward step.\n  # Agent's direction (dir): 0=RIGHT, 1=UP, 2=LEFT, 3=DOWN\n  DIRECTION_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col + 1)\n      1: (-1, 0),  # Facing UP: (row - 1, col)\n      2: (0, -1),  # Facing LEFT: (row, col - 1)\n      3: (1, 0)    # Facing DOWN: (row + 1, col)\n  }\n\n  # Define how agent's direction changes when turning left or right.\n  # These mappings cycle through the four cardinal directions (0, 1, 2, 3).\n  TURN_LEFT_DIR_MAP = {0: 1, 1: 2, 2: 3, 3: 0} # Example: RIGHT (0) -> UP (1)\n  TURN_RIGHT_DIR_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Example: RIGHT (0) -> DOWN (3)\n\n  # Identify all entity kinds that act as *unwalkable* obstacles to agent movement.\n  # An agent cannot walk onto cells containing these items. This set usually includes\n  # BOUNDARY, WATER, WORKSHOP locations, etc.\n  unwalkable_kind_ids = set(current_state.world.non_grabbable_indices)\n  \n  # IMPORTANT NOTE for collect_v2: Unlike collect_v0, this version (collect_v2)\n  # explicitly allows the agent to walk onto cells containing the primitive itself\n  # (e.g., walking over a block of wood or stone). Grabbable items are only\n  # obstacles if they are explicitly listed in `non_grabbable_indices`.\n  # This means we do NOT add `primitive_kind_id` to `unwalkable_kind_ids` if it's grabbable.\n\n  # Early Exit Optimization: If the primitive is already in the agent's 3x3\n  # neighborhood (i.e., immediately collectible from the current position), just return the USE action.\n  # The `CraftState.next_to` method provides this check efficiently.\n  if current_state.next_to(primitive_kind_id):\n      return [USE_ACTION_ID]\n\n  # Initialize Breadth-First Search (BFS) for pathfinding.\n  # The BFS queue stores tuples:\n  #   ((current_position_tuple (r, c), current_direction_int), list_of_actions_taken_to_reach_here)\n  # This structure allows tracking both spatial location and agent orientation.\n  bfs_queue = collections.deque([((initial_agent_pos, initial_agent_dir), [])])\n  \n  # The 'visited' set keeps track of (position, direction) pairs already explored\n  # to prevent cycles and redundant computations, ensuring the shortest path is found.\n  visited_states = {(initial_agent_pos, initial_agent_dir)}\n\n  path_to_collection_spot = None # This will store the shortest action sequence to a collectible state.\n\n  # Main BFS loop: continues until the queue is empty or a path to a goal is found.\n  while bfs_queue:\n      # Dequeue the current state (position and direction) and the path leading to it.\n      (current_pos, current_dir), current_path_actions = bfs_queue.popleft()\n      r, c = current_pos\n\n      # Check if the current agent position (r, c) is a \"goal state\" for collection.\n      # A goal state means the primitive is located in any cell within the 3x3 neighborhood\n      # around the agent's current position on the initial grid. This mirrors the `CraftState.next_to` logic.\n      is_primitive_in_neighborhood = False\n      for dr_offset in [-1, 0, 1]: # Iterate through relative row offsets (-1, 0, 1)\n          for dc_offset in [-1, 0, 1]: # Iterate through relative column offsets (-1, 0, 1)\n              check_r, check_c = r + dr_offset, c + dc_offset\n              # Ensure the cell being checked is within grid boundaries.\n              if (0 <= check_r < GRID_WIDTH and 0 <= check_c < GRID_HEIGHT and\n                  initial_grid[check_r, check_c, primitive_kind_id] > 0):\n                  is_primitive_in_neighborhood = True\n                  break # Primitive found in neighborhood, no need to check further cells for this position.\n          if is_primitive_in_neighborhood:\n              break # Break outer loop too if found.\n\n      if is_primitive_in_neighborhood:\n          path_to_collection_spot = current_path_actions # A shortest path to a collectible state is found.\n          break # Terminate BFS; no need to explore further as we found the shortest path.\n\n      # Explore possible next states by applying valid actions: Move Forward, Turn Left, Turn Right.\n\n      # 1. Try MOVE_FORWARD_ACTION:\n      delta_r, delta_c = DIRECTION_TO_DRDC[current_dir]\n      next_r, next_c = r + delta_r, c + delta_c\n      next_agent_pos = (next_r, next_c)\n      next_agent_dir_after_move = current_dir # Moving forward does not change the agent's facing direction.\n\n      # Check if the potential next position is valid (within bounds and not previously visited with this direction).\n      if (0 <= next_r < GRID_WIDTH and 0 <= next_c < GRID_HEIGHT and\n          (next_agent_pos, next_agent_dir_after_move) not in visited_states):\n          \n          is_cell_walkable = True\n          # Verify that the cell at `next_agent_pos` does not contain any unwalkable obstacle.\n          for kind_idx in unwalkable_kind_ids:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_cell_walkable = False\n                  break # This cell contains an unwalkable obstacle, so it's not walkable.\n\n          if is_cell_walkable:\n              visited_states.add((next_agent_pos, next_agent_dir_after_move)) # Mark the new state as visited.\n              # Add the new state to the queue with the updated path.\n              bfs_queue.append(((next_agent_pos, next_agent_dir_after_move), \n                                current_path_actions + [MOVE_FORWARD_ACTION_ID]))\n\n      # 2. Try TURN_LEFT_ACTION:\n      next_agent_dir_left = TURN_LEFT_DIR_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_agent_dir_left) not in visited_states):\n          visited_states.add((current_pos, next_agent_dir_left))\n          bfs_queue.append(((current_pos, next_agent_dir_left), \n                            current_path_actions + [TURN_LEFT_ACTION_ID]))\n\n      # 3. Try TURN_RIGHT_ACTION:\n      next_agent_dir_right = TURN_RIGHT_DIR_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_agent_dir_right) not in visited_states):\n          visited_states.add((current_pos, next_agent_dir_right))\n          bfs_queue.append(((current_pos, next_agent_dir_right), \n                            current_path_actions + [TURN_RIGHT_ACTION_ID]))\n\n  # After BFS completes:\n  # If a path to a collectable position was found (`path_to_collection_spot` is not None),\n  # append the final 'USE' action to perform the collection.\n  if path_to_collection_spot is not None:\n      actions_list.extend(path_to_collection_spot)\n      actions_list.append(USE_ACTION_ID)\n\n  return actions_list", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T07:08:34.464482", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid # The numpy array representing the initial grid (height, width, n_kinds)\n  initial_pos = current_state.pos # Agent's starting (row, col) tuple\n  initial_dir = current_state.dir # Agent's starting direction (0:R, 1:U, 2:L, 3:D)\n\n  # Get the integer ID for the target primitive from the cookbook index\n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  # Extract grid dimensions. Assuming initial_grid.shape is (rows, cols, kinds).\n  # The environment's definition of (WIDTH, HEIGHT, n_kinds) for grid shape\n  # implies WIDTH refers to the number of rows (Y-dimension) and HEIGHT to the number of columns (X-dimension)\n  # when accessing grid[row, col]. This naming convention is unusual but consistent with prior versions.\n  NUM_ROWS, NUM_COLS, _ = initial_grid.shape\n\n  # If the primitive is non-grabbable (e.g., WATER, WORKSHOP, BOUNDARY), it cannot be collected.\n  # Return an empty list of actions.\n  if primitive_id in current_state.world.non_grabbable_indices:\n      return []\n\n  # Get action mappings from the environment's action specifications\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP'] # 'UP' in action_specs maps to moving forward\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define changes in (row, col) for each direction when moving forward or checking the cell in front\n  # Direction values: 0 (Right), 1 (Up), 2 (Left), 3 (Down)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row+0, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col+0)\n      2: (0, -1),  # Facing LEFT: (row+0, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col+0)\n  }\n\n  # Define how agent's direction changes for left/right turns\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # R->U->L->D->R\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # R->D->L->U->R\n\n  # Define what constitutes an obstacle for movement.\n  # Agent cannot walk onto non-grabbable entities (e.g., BOUNDARY, WATER, WORKSHOPs).\n  # Additionally, for 'collect', the agent should not walk onto the grabbable primitive itself,\n  # but stand adjacent to it and 'USE' it.\n  obstacles_to_movement_indices = set(current_state.world.non_grabbable_indices)\n  if primitive_id in current_state.world.grabbable_indices:\n      obstacles_to_movement_indices.add(primitive_id)\n  \n  # Optimization: If the primitive is already directly in front of the agent at the start,\n  # and it is a grabbable item, we can just use it immediately.\n  r_curr, c_curr = initial_pos\n  dr_facing, dc_facing = DIR_TO_DRDC[initial_dir]\n  front_r, front_c = r_curr + dr_facing, c_curr + dc_facing\n\n  if (0 <= front_r < NUM_ROWS and 0 <= front_c < NUM_COLS and\n      initial_grid[front_r, front_c, primitive_id] > 0 and\n      primitive_id in current_state.world.grabbable_indices):\n      return [USE_ACTION]\n\n  # BFS initialization:\n  # Queue stores ( (current_pos_tuple, current_dir_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (position, direction) tuples to prevent cycles and redundant exploration\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_to_adjacent = None # This will store the action sequence if a target state is found\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Goal Check: Is the primitive directly in front of the agent in the current state?\n      # Calculate the coordinates of the cell directly in front of the agent based on current_dir\n      dr_facing, dc_facing = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + dr_facing, c + dc_facing\n      \n      # Check if the \"front\" cell is within grid bounds\n      if (0 <= front_r < NUM_ROWS and 0 <= front_c < NUM_COLS):\n          # If the primitive exists in that front cell (count > 0) AND it's a grabbable item,\n          # we have reached a state from which the primitive can be collected.\n          if initial_grid[front_r, front_c, primitive_id] > 0 and \\\n             primitive_id in current_state.world.grabbable_indices:\n              target_path_to_adjacent = path_actions # Actions to get to this (pos, dir) state\n              break # Found the path, exit BFS\n\n      # 2. Explore possible next actions: Move Forward, Turn Left, Turn Right\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir] # Dr, Dc for moving forward\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Direction does not change when moving forward\n\n      # Check if the next position is within grid bounds\n      if (0 <= next_r < NUM_ROWS and 0 <= next_c < NUM_COLS):\n          # Check if this (position, direction) state has already been visited\n          if (next_pos, next_dir) not in visited:\n              is_walkable = True\n              # Check if the next position contains any obstacle\n              for kind_idx in obstacles_to_movement_indices:\n                  if initial_grid[next_r, next_c, kind_idx] > 0:\n                      is_walkable = False\n                      break\n              \n              if is_walkable:\n                  visited.add((next_pos, next_dir))\n                  queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path was successfully found to a state where the primitive is in front,\n  # append the USE action to complete the collection.\n  if target_path_to_adjacent is not None:\n      actions_list.extend(target_path_to_adjacent)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T07:08:35.654720", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (r, c)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  # Get the integer ID for the target primitive from the cookbook index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # Early exit: If the primitive to be collected is not grabbable (e.g., WATER, WORKSHOP),\n  # it cannot be added to inventory. Return an empty action list.\n  if primitive_id in current_state.world.non_grabbable_indices:\n      return []\n\n  # Get action mappings from the environment's action specifications\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  # This mapping is used to calculate the cell *in front* of the agent for interaction and movement.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT, moves in positive column (c+1)\n      1: (-1, 0),  # Facing UP, moves in negative row (r-1)\n      2: (0, -1),  # Facing LEFT, moves in negative column (c-1)\n      3: (1, 0)    # Facing DOWN, moves in positive row (r+1)\n  }\n\n  # Map for turning left/right, updating the agent's direction (0-3)\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # R(0)->U(1)->L(2)->D(3)->R(0)\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # R(0)->D(3)->L(2)->U(1)->R(0)\n\n  # Define obstacles for movement: These are entities the agent cannot walk onto.\n  # This includes all non-grabbable items (like BOUNDARY, WATER, WORKSHOPs)\n  # and the primitive itself, if it's grabbable, because the agent needs to\n  # stand *adjacent* to it to use the 'USE' action to pick it up.\n  obstacles_to_movement_indices = set(current_state.world.non_grabbable_indices)\n  if primitive_id in current_state.world.grabbable_indices:\n      obstacles_to_movement_indices.add(primitive_id)\n  \n  # Optimization: If the primitive is already directly in front of the agent at the start,\n  # and it's a grabbable item (which is ensured by the early exit check above),\n  # simply return the USE action.\n  r, c = initial_pos\n  dr_facing, dc_facing = DIR_TO_DRDC[initial_dir]\n  front_r, front_c = r + dr_facing, c + dc_facing\n\n  if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT and\n      initial_grid[front_r, front_c, primitive_id] > 0): # No need to check grabbable_indices here due to early exit\n      return [USE_ACTION]\n\n  # BFS initialization:\n  # Queue stores ( ((row, col), direction), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores ( (row, col), direction ) tuples to prevent cycles and redundant exploration\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the action sequence if a target state is found\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Goal Check: Is the primitive directly in front of the agent in the current state?\n      # Calculate the coordinates of the cell directly in front of the agent\n      dr_facing, dc_facing = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + dr_facing, c + dc_facing\n      \n      # Check if the \"front\" cell is within grid bounds and contains the target primitive.\n      # The check for `primitive_id in current_state.world.grabbable_indices` is implicit\n      # because the function would have returned early if it wasn't grabbable.\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT and\n          initial_grid[front_r, front_c, primitive_id] > 0):\n          \n          target_path = path_actions # Path to reach this (pos, dir) state\n          break # Found the path, exit BFS\n\n      # 2. Explore possible next actions: Move Forward, Turn Left, Turn Right\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir] # Dr, Dc for moving forward\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Direction does not change when moving forward\n\n      # Check if the next position is within bounds and this (position, direction) state hasn't been visited\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT and\n          (next_pos, next_dir) not in visited):\n          \n          is_walkable = True\n          # Check if the next position contains any obstacles\n          for kind_idx in obstacles_to_movement_indices:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          \n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path was successfully found to a state where the primitive is in front,\n  # append the USE action to complete the collection.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T07:09:26.022925", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or\n      i_kind == world.water_index or\n      i_kind == world.stone_index\n  )\n\n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n\n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n\n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set includes the agent's inventory as part of the state key.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing.\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Increased MAX_EXPLORED_STATES due to the larger state space when tracking inventory.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10\n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n\n    # Goal Check - Check if the primitive is directly under the agent's feet.\n    # This applies to grabbable items that can be picked up by standing on them and using USE.\n    if i_kind in world.grabbable_indices and state.grid[current_r, current_c, i_kind] == 1:\n        inventory_before_use_on_self = np.copy(state.inventory)\n        _, state_after_use_on_self = state.step(USE_ACT)\n        # Verify successful collection\n        if state_after_use_on_self.inventory[i_kind] > inventory_before_use_on_self[i_kind]:\n            return path + [USE_ACT] # Collected by using at current position\n\n    # Goal Check: Check for primitive in adjacent cells (cardinal directions).\n    # This check relies on `state.next_to(i_kind)` which covers the 3x3 neighborhood.\n    # We then iterate through cardinal directions to find the specific cell and face it.\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Ensure facing cell is within grid bounds and contains the target primitive\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and\n                state.grid[facing_r, facing_c, i_kind] == 1):\n\n                # Simulate the turning actions to face the primitive.\n                temp_state_after_turns = state\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action on the cell in front.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`).\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n\n    # Explore the USE action from the current position generally.\n    # This is important if using an item at the current position (e.g., picking up a tool,\n    # or interacting with a workshop) changes the inventory state, which might be necessary\n    # for later steps to collect the *target* primitive. This complements the specific\n    # goal checks above.\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n\n    # Check if the USE action resulted in a meaningful state change (inventory, position, or direction).\n    # This prevents adding redundant states to the queue if USE had no effect.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 6, "scores": {"3": 1.5}}
