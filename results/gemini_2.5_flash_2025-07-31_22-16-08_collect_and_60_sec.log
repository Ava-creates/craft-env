{"timestamp": "2025-08-01T12:12:30.565552", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  \n  # Get the integer ID for the target primitive from the cookbook's index.\n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  # Improvement 1: Only attempt to collect if the item is grabbable.\n  # Non-grabbable items (like WATER, STONE, WORKSHOPs, BOUNDARY) cannot be picked up using the 'USE' action.\n  if primitive_id not in current_state.world.grabbable_indices:\n      # If the primitive is not grabbable, there are no actions to collect it.\n      return []\n\n  # Get initial state components for the BFS.\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's starting (row, col)\n  initial_dir = current_state.dir # Agent's starting direction (0:R, 1:U, 2:L, 3:D)\n\n  # Grid dimensions.\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # Map action names to their integer IDs.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP'] # In CraftWorld, UP moves the agent forward in its current direction.\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define how position changes for each direction when moving forward.\n  # (dr, dc) for agent's facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: +1 to column (row stays same)\n      1: (-1, 0),  # Facing UP: -1 to row (column stays same)\n      2: (0, -1),  # Facing LEFT: -1 to column (row stays same)\n      3: (1, 0)    # Facing DOWN: +1 to row (column stays same)\n  }\n\n  # Define how direction changes when turning left or right.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}   # R->U->L->D->R\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # R->D->L->U->R\n\n  # Improvement 2: Consolidate all indices that block agent movement.\n  # The agent cannot move onto permanent obstacles (non_grabbable_indices)\n  # and also cannot move onto the primitive it intends to collect (it must be adjacent).\n  # Convert to a list for efficient NumPy advanced indexing.\n  all_blocking_indices = list(current_state.world.non_grabbable_indices.union({primitive_id}))\n\n  # BFS state: ((current_row, current_col), current_direction_int), list_of_actions_taken_to_reach_this_state\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set: stores ((row, col), direction) tuples to avoid redundant exploration and cycles.\n  visited = {(initial_pos, initial_dir)} \n\n  target_path = None # This will store the sequence of actions to reach the state immediately before 'USE'.\n\n  # Perform Breadth-First Search (BFS) to find the shortest path.\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Goal Check: Is the primitive directly in front of the agent?\n      # Calculate the coordinates of the cell directly in front of the agent.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the cell in front is within grid boundaries.\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          # Check if the primitive is present in the cell directly in front (value > 0).\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Found the shortest path to a state where USE can be applied.\n\n      # 2. Explore Possible Next Actions (Move Forward, Turn Left, Turn Right)\n      \n      # Try Move Forward action:\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction.\n\n      # Check if the next position is within grid boundaries.\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT):\n          # Check if this (position, direction) state has not been visited yet.\n          if (next_pos, next_dir) not in visited:\n              # Check if the next position is walkable (i.e., it does not contain any blocking items).\n              # np.any will be True if any of the specified blocking kinds are present at the cell.\n              if not np.any(initial_grid[next_r, next_c, all_blocking_indices] > 0):\n                  visited.add((next_pos, next_dir))\n                  queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left action:\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right action:\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path to the target state was found, append the 'USE' action to complete the collection.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 2, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T12:12:31.679403", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  \n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  # Check if the primitive is actually grabbable.\n  # If it's not a grabbable item (e.g., BOUNDARY, WATER, STONE, WORKSHOP),\n  # it cannot be 'collected' by picking it up using the USE action.\n  # Return an empty list of actions in such cases.\n  if primitive_id not in current_state.world.grabbable_indices:\n      return []\n\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (r, c)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT, move in positive column direction\n      1: (-1, 0),  # Facing UP, move in negative row direction\n      2: (0, -1),  # Facing LEFT, move in negative column direction\n      3: (1, 0)    # Facing DOWN, move in positive row direction\n  }\n\n  # Map for turning left/right, updating the agent's direction (0:R, 1:U, 2:L, 3:D)\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # R->U->L->D->R\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # R->D->L->U->R\n\n  # Consolidate all indices that block agent movement.\n  # This includes permanent environmental obstacles (non_grabbable_indices)\n  # AND the target primitive itself (as the agent must stand next to it, not on it, to USE).\n  all_blocking_indices = list(current_state.world.non_grabbable_indices.union({primitive_id}))\n\n  # BFS state: ((row, col), direction), path_actions\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  visited = {(initial_pos, initial_dir)} # Visited set stores (current_pos_tuple, current_dir_int)\n\n  target_path = None # Stores the action list to reach the target state\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent at current state\n      # Calculate the coordinates of the cell directly in front\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if front_cell is within grid bounds\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          # Check if the front_cell contains the primitive (value > 0 indicates presence)\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Path to target found (agent is adjacent and facing the primitive)\n\n      # 2. Explore possible next actions: Move Forward, Turn Left, Turn Right\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if next_pos is within bounds\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT):\n          # Check if this (position, direction) state hasn't been visited\n          if (next_pos, next_dir) not in visited:\n              # Check if next_pos is walkable (i.e., does not contain any of the blocking items)\n              # np.any will be True if any of the specified blocking kinds are present at the cell.\n              # This covers both permanent obstacles and the target primitive itself.\n              if not np.any(initial_grid[next_r, next_c, all_blocking_indices] > 0):\n                  visited.add((next_pos, next_dir))\n                  queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path was found, append the USE action to the sequence\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 2, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T12:14:04.918213", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Resolve the primitive's string name to its unique integer ID.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Early exit: Check if the primitive is already in the agent's inventory.\n  # If the agent already possesses at least one unit of the target item, no collection is needed.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic Check: Determine if this primitive is inherently collectible via the 'USE' action.\n  # Items like workshops, boundaries, or fixed terrain features are generally not collected.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define numerical action codes and spatial transformations.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps agent direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) for the cell directly in front.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP\n      1: (0, 1),  # RIGHT\n      2: (1, 0),  # DOWN\n      3: (0, -1)  # LEFT\n  }\n\n  # Helper function to compute the shortest sequence of turning actions (LEFT/RIGHT)\n  # to face a target direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return []\n      \n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Clockwise turn\n          return [RIGHT_ACT]\n      elif diff == 3: # Counter-clockwise turn\n          return [LEFT_ACT]\n      else: # 180-degree turn\n          return [RIGHT_ACT, RIGHT_ACT] # Two turns in the same direction\n\n  # --- Improvement for collect_v2: Immediate collection check ---\n  # Before starting BFS, check if the primitive can be collected from the initial state\n  # with zero or one action (a turn + USE). This optimizes for very close targets.\n  grid_width, grid_height, _ = current_state.grid.shape # Get grid dimensions.\n\n  if current_state.next_to(i_kind): # Check if the primitive is in the 3x3 neighborhood\n    current_r, current_c = current_state.pos\n    current_dir = current_state.dir\n\n    # Iterate through all 4 possible facing directions.\n    for target_dir in range(4): \n        dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n        facing_r, facing_c = current_r + dr, current_c + dc\n\n        # Check if the cell directly in front (after hypothetical turn) is valid and contains the primitive.\n        if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n            current_state.grid[facing_r, facing_c, i_kind] == 1):\n            \n            # Get the actions needed to turn to face the primitive.\n            turns_to_face = _get_turning_actions(current_dir, target_dir)\n            \n            # Simulate these turns on a temporary state derived from the initial state.\n            temp_state_before_use = current_state \n            for turn_action in turns_to_face:\n                _, temp_state_before_use = temp_state_before_use.step(turn_action)\n\n            # Record inventory before attempting 'USE' to verify successful collection.\n            inventory_before_use = np.copy(temp_state_before_use.inventory)\n            \n            # Simulate the 'USE' action.\n            _, state_after_use = temp_state_before_use.step(USE_ACT)\n\n            # If the primitive count in inventory increased, we successfully collected it.\n            return_actions = turns_to_face + [USE_ACT]\n            if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                return return_actions\n  # --- End of immediate collection check ---\n\n  # 5. Initialize Breadth-First Search (BFS) components.\n  q = collections.deque() # Queue for BFS, storing (CraftState, unique_state_key) tuples.\n  # `visited` set tracks explored unique states to prevent cycles and redundant work.\n  # A state is defined by (agent_row, agent_col, agent_direction, inventory_tuple).\n  # Inventory is converted to a tuple because numpy arrays are not hashable.\n  visited = set()\n  # `came_from` dictionary reconstructs the path by mapping a state_key to\n  # (the key of the previous state, the action taken to reach the current state).\n  came_from = {} \n\n  # Prepare the initial state for BFS.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  initial_state_key = (current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple)\n  \n  # Add the initial state to the queue and mark it as visited.\n  q.append((current_state, initial_state_key))\n  visited.add(initial_state_key)\n\n  # `grid_width, grid_height, _` is already defined from the immediate check.\n  # MAX_EXPLORED_STATES is a heuristic limit to prevent infinite loops in large state spaces.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 30 \n  explored_states_count = 0\n\n  # 6. BFS Loop: Explore states layer by layer to find the shortest action sequence.\n  while q:\n    # Dequeue the current state and its unique key.\n    state, current_state_key = q.popleft() \n    explored_states_count += 1\n\n    # Pruning: If the number of explored distinct states exceeds the limit,\n    # return an empty list, indicating failure to find a path within limits.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      return []\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Condition Check: Can the primitive be collected from the current `state`?\n    # This check is performed for every state dequeued from the queue.\n    if state.next_to(i_kind):\n        # If nearby, check if any agent orientation would face the primitive directly.\n        for target_dir in range(4): \n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # If the cell in front contains the target primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate turns to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_before_use = state \n                for turn_action in turns_to_face:\n                    _, temp_state_before_use = temp_state_before_use.step(turn_action)\n\n                inventory_before_use = np.copy(temp_state_before_use.inventory)\n                _, state_after_use = temp_state_before_use.step(USE_ACT)\n\n                # Crucial Verification: Did the 'USE' action successfully increase\n                # the count of the target primitive in the inventory?\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    # If collected, a successful path has been found. Reconstruct and return it.\n                    final_path = []\n                    temp_key = current_state_key\n                    # Reconstruct the path by backtracking from the current state key.\n                    while temp_key != initial_state_key:\n                        prev_key, action = came_from[temp_key]\n                        final_path.insert(0, action) # Insert at the beginning to build path in correct order.\n                        temp_key = prev_key\n                    \n                    # The complete path includes actions to reach current state, turns, and USE.\n                    return final_path + turns_to_face + [USE_ACT]\n\n    # Explore next possible states by applying allowed actions from the current state.\n    # Consider both movement actions and the general 'USE' action (e.g., to pick up tools).\n    actions_to_consider = move_actions + [USE_ACT]\n    \n    for action in actions_to_consider:\n        _, next_state = state.step(action) # Simulate the action.\n        \n        # Create a unique key for the new state, including its inventory.\n        next_inventory_tuple = tuple(next_state.inventory)\n        next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n        # If this new state hasn't been visited, add it to the queue for exploration.\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            came_from[next_state_key] = (current_state_key, action) # Store how we reached this state.\n            q.append((next_state, next_state_key)) # Add to the BFS queue.\n\n  # 7. If the BFS loop finishes and the queue is empty without finding a solution,\n  # it means the target primitive is unreachable from the initial state under the given conditions.\n  return []", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T12:14:07.537190", "function_name": "collect", "function_body": "  \"\"\"Returns a list of actions to find and collect the primitive in the passed env.\n    \n    This `v2` implementation refines the Breadth-First Search (BFS) approach from `collect_v1`\n    to be even more robust in finding the shortest sequence of actions. It accounts for\n    dynamic environment changes, such as acquiring necessary tools via the 'USE' action,\n    which might then enable the collection of the target primitive.\n    \n    Args:\n        env (env.CraftLab): The CraftLab object containing the current state of the game.\n        primitive (str): The name of the primitive item to collect (e.g., \"wood\", \"stone\").\n\n    Returns:\n        List[int]: A sequence of action indices (e.g., UP, DOWN, USE) to execute.\n                   Returns an empty list if the primitive is already collected,\n                   cannot be collected (e.g., a non-collectible entity), or\n                   is unreachable within the defined search limits.\n  \"\"\"\n  current_state = env._current_state\n  world = env.world\n\n  # 1. Resolve the primitive's string name to its unique integer ID.\n  # The cookbook maintains mappings from item names (converted to lowercase) to integer IDs.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not found in the game's item index, it is considered invalid.\n    return []\n\n  # 2. Early exit: Check if the primitive is already present in the agent's inventory.\n  # If the agent already possesses at least one unit of the target item, no further\n  # collection actions are required.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic Check: Determine if this primitive can be collected using the 'USE' action.\n  # This function specifically targets environmental resources that are gathered.\n  # Not all items in the game are 'collectible' in this manner; workshops or boundaries,\n  # for instance, are not picked up into inventory.\n  # Collectible items typically include 'grabbable_indices' (items like tools, crafted goods\n  # found on the ground) and specific resources like 'water' or 'stone' which are gathered\n  # by interacting with their grid locations.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the target item is not of a type that can be collected via the 'USE' action\n  # (e.g., it's a structural element like a workshop or boundary), then no path exists\n  # for its collection via this function's logic.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define numerical action codes and spatial transformations for agent movement and interaction.\n  action_map = env.action_specs() # Get the standard mapping from action names (strings) to integer IDs.\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's internal direction integer (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n  # to the (row_change, col_change) required to locate the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # Facing North (row decreases)\n      1: (0, 1),  # Facing East (col increases)\n      2: (1, 0),  # Facing South (row increases)\n      3: (0, -1)  # Facing West (col decreases)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions (LEFT/RIGHT)\n  # required to change the agent's current facing direction to a specific target direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # No turning needed if already facing the correct direction.\n      \n      # Compute the difference in directions, handling the circular nature of directions (0-3).\n      # The modulo 4 operation ensures the result is within [0, 3].\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., from UP (0) to RIGHT (1)).\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., from UP (0) to LEFT (3)).\n          return [LEFT_ACT]\n      else: # `diff == 2` signifies a 180-degree turn (e.g., from UP (0) to DOWN (2)).\n          # This can be achieved with two consecutive turns in either direction.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choosing two RIGHT turns.\n\n  # 5. Initialize Breadth-First Search (BFS) data structures.\n  q = collections.deque() # The queue for BFS, holding `(CraftState, unique_state_key)` tuples.\n  \n  # `visited` set stores unique state keys to prevent redundant exploration and cycles.\n  # A state key uniquely identifies an agent's situation: (row, col, direction, inventory_tuple).\n  # The inventory is converted to a tuple because NumPy arrays are not hashable.\n  visited = set()\n  \n  # `came_from` dictionary is used for path reconstruction: it maps a `current_state_key`\n  # to a tuple of `(previous_state_key, action_taken_to_reach_current_state)`.\n  came_from = {} \n\n  # Prepare the initial state for the BFS.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  initial_state_key = (current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple)\n  \n  # Add the initial state to the queue and mark it as visited.\n  q.append((current_state, initial_state_key))\n  visited.add(initial_state_key)\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # `MAX_EXPLORED_STATES` is a heuristic limit to prevent the search from running indefinitely\n  # in scenarios with extremely large state spaces or unreachable goals. This value balances\n  # search completeness with practical performance. The multiplier (50) allows for more\n  # extensive exploration compared to `v1`, suitable for longer paths or more complex scenarios.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 50 \n  explored_states_count = 0\n\n  # 6. BFS Loop: Continuously explore states layer by layer until the goal is found\n  # or the queue is exhausted (meaning the goal is unreachable).\n  while q:\n    # Dequeue the current state object and its unique identifier for processing.\n    state, current_state_key = q.popleft() \n    explored_states_count += 1\n\n    # Pruning: If the number of distinct states explored exceeds the predefined limit,\n    # we stop the search. This prevents excessive computation time.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      # If the limit is reached, it implies either a very long path or an unreachable goal.\n      return [] \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Condition Check: Can the target primitive be collected from the current `state`?\n    # This involves checking if the primitive is within the agent's immediate 3x3 neighborhood.\n    if state.next_to(i_kind):\n        # If the primitive is nearby, iterate through all four possible agent orientations\n        # to find one that directly faces the primitive.\n        for target_dir in range(4): # Directions: 0=UP, 1=RIGHT, 2=DOWN, 3=LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Verify that the cell directly in front (if facing `target_dir`) is within\n            # grid bounds AND contains an instance of the target primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the necessary turning actions to make the agent face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_before_use = state \n                for turn_action in turns_to_face:\n                    # Apply each turn action sequentially to update the temporary state.\n                    _, temp_state_before_use = temp_state_before_use.step(turn_action)\n\n                # Capture the agent's inventory *before* attempting the 'USE' action.\n                # This is crucial for verifying successful collection later.\n                inventory_before_use = np.copy(temp_state_before_use.inventory)\n\n                # Simulate the 'USE' action. This is the attempt to collect the primitive.\n                # The `CraftState.step` method encapsulates the game's collection logic\n                # (e.g., requiring tools for certain items).\n                _, state_after_use = temp_state_before_use.step(USE_ACT)\n\n                # Crucial Verification: Check if the 'USE' action actually increased the count\n                # of the target primitive in the inventory. This confirms successful collection.\n                # If a tool was required and not present, this check would fail, and the path\n                # would not be considered a solution for *collecting* the primitive.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    # If successfully collected, a solution path has been found.\n                    # Reconstruct the full path by backtracking from the current state.\n                    final_path = []\n                    temp_key = current_state_key\n                    # Backtrack from the goal-reaching state key to the initial state key.\n                    while temp_key != initial_state_key:\n                        prev_key, action = came_from[temp_key]\n                        final_path.insert(0, action) # Prepend action to build path in correct order.\n                        temp_key = prev_key\n                    \n                    # The complete sequence of actions includes:\n                    # 1. Actions to reach the location adjacent to the primitive.\n                    # 2. Turning actions to face the primitive.\n                    # 3. The final 'USE' action to collect it.\n                    return final_path + turns_to_face + [USE_ACT]\n\n    # Explore next possible states by applying all allowed actions from the current state.\n    # This includes both movement actions and the general 'USE' action. The 'USE' action\n    # is included here because it might lead to acquiring new tools or items (by picking them up\n    # from the ground), which could change the inventory state and unlock subsequent collection\n    # possibilities for the primary target primitive.\n    actions_to_consider = move_actions + [USE_ACT]\n    \n    for action in actions_to_consider:\n        # Simulate the action to get the next game state.\n        # `CraftState.step` returns a new `CraftState` object, preserving immutability for BFS.\n        _, next_state = state.step(action) \n        \n        # Construct a unique key for the new state to check against `visited` set.\n        next_inventory_tuple = tuple(next_state.inventory)\n        next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n        # If this new state has not been visited before, add it to the queue for exploration.\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            came_from[next_state_key] = (current_state_key, action) # Record the path segment.\n            q.append((next_state, next_state_key)) # Add the state to the BFS queue.\n\n  # 7. If the BFS loop completes and the queue becomes empty without finding a solution,\n  # it indicates that the target primitive is unreachable from the initial state given\n  # the game rules and the defined search limits.\n  return []", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T12:15:56.541066", "function_name": "collect", "function_body": "  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (r, c)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  # This defines how position changes when moving \"forward\" in a given direction.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT, move in positive column direction (positive col)\n      1: (-1, 0),  # Facing UP, move in negative row direction (negative row)\n      2: (0, -1),  # Facing LEFT, move in negative column direction (negative col)\n      3: (1, 0)    # Facing DOWN, move in positive row direction (positive row)\n  }\n\n  # Map for turning left/right, updating the agent's direction (0-3)\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Optimization/Correctness Check: If the primitive is not grabbable,\n  # it cannot be 'collected' by picking it up. Return an empty list of actions.\n  if primitive_id not in current_state.world.grabbable_indices:\n      return []\n\n  # Define all non-walkable entities for pathfinding.\n  # This includes all non-grabbable items (like WATER, WORKSHOPs, etc.)\n  # AND the primitive itself (as the agent needs to be adjacent to collect, not on top of it).\n  non_walkable_kind_ids = list(current_state.world.non_grabbable_indices.union({primitive_id}))\n\n  # BFS state: ((row, col), direction), path_actions\n  # Queue stores ( (current_pos_tuple, current_dir_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (current_pos_tuple, current_dir_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # Stores the action list to reach the target state\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent at current state\n      # Calculate the coordinates of the cell directly in front\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if front_cell is within grid bounds\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          # Check if the front_cell contains the primitive (value > 0 indicates presence)\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Path to target found (agent is adjacent and facing the primitive)\n\n      # 2. Explore possible next actions: Move Forward, Turn Left, Turn Right\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if next_pos is within bounds\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT):\n          # Check if this (position, direction) state hasn't been visited\n          if (next_pos, next_dir) not in visited:\n              # Check if next_pos is walkable (i.e., does not contain any non-walkable item)\n              # np.any will be True if any of the specified obstacle kinds are present at the cell\n              if not np.any(initial_grid[next_r, next_c, non_walkable_kind_ids] > 0):\n                  visited.add((next_pos, next_dir))\n                  queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path was found, append the USE action to the sequence\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-08-01T12:15:57.761015", "function_name": "collect", "function_body": "", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-08-01T12:17:09.757749", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos  # (row, col)\n  initial_dir = current_state.dir  # int (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # Optimization: If the primitive is already in inventory, no actions are needed.\n  if current_state.inventory[primitive_id] > 0:\n      return []\n\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction.\n  # This helps determine the cell in front or the next position when moving forward.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (dr, dc) = (0, 1) - column increases\n      1: (-1, 0),  # Facing UP: (dr, dc) = (-1, 0) - row decreases\n      2: (0, -1),  # Facing LEFT: (dr, dc) = (0, -1) - column decreases\n      3: (1, 0)    # Facing DOWN: (dr, dc) = (1, 0) - row increases\n  }\n\n  # Maps for updating direction when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right(0) -> Up(1) -> Left(2) -> Down(3) -> Right(0)\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right(0) -> Down(3) -> Left(2) -> Up(1) -> Right(0)\n\n  # Get indices of entities that block movement (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  non_walkable_kind_ids = current_state.world.non_grabbable_indices\n\n  # BFS queue: stores ((current_r, current_c), current_dir), list_of_actions_to_reach_here\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set: stores (current_pos_tuple, current_dir_int) to prevent redundant exploration\n  visited = {(initial_pos, initial_dir)}\n\n  path_to_adjacent_primitive = None # To store the path of actions once the target is found\n\n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the current state satisfies the target condition:\n      # The target primitive must be directly in front of the agent.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the cell in front is within grid boundaries\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          # Check if the cell in front contains the target primitive\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              path_to_adjacent_primitive = path_so_far\n              break # Found the shortest path to be adjacent and facing the primitive\n\n      # 2. Explore possible next actions: Move Forward, Turn Left, Turn Right\n\n      # --- Option A: Try Moving Forward ---\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos_after_move = (next_r, next_c)\n      next_dir_after_move = current_dir # Direction does not change when moving forward\n\n      # Check if the next position is within grid boundaries\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT):\n          # Check if this (position, direction) state has not been visited yet\n          if (next_pos_after_move, next_dir_after_move) not in visited:\n              \n              # Determine if the potential next cell (next_r, next_c) is walkable.\n              # A cell is walkable if:\n              #   a) It does NOT contain any non-grabbable entities (e.g., boundaries, water, workshops).\n              #   b) It is NOT the primitive we are trying to collect (agent cannot walk onto it if it's a resource).\n              is_cell_walkable = True\n              \n              # Check for any non-grabbable items that inherently block movement\n              for kind_idx in non_walkable_kind_ids:\n                  if initial_grid[next_r, next_c, kind_idx] > 0:\n                      is_cell_walkable = False\n                      break\n              \n              # If the cell is still considered walkable, additionally ensure it does not contain the target primitive itself.\n              # The agent needs to be *adjacent* to the primitive to 'USE' it, not on top of it.\n              if is_cell_walkable and initial_grid[next_r, next_c, primitive_id] > 0:\n                  is_cell_walkable = False\n\n              if is_cell_walkable:\n                  visited.add((next_pos_after_move, next_dir_after_move))\n                  queue.append(((next_pos_after_move, next_dir_after_move), path_so_far + [MOVE_FORWARD_ACTION]))\n\n      # --- Option B: Try Turning Left ---\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_so_far + [TURN_LEFT_ACTION]))\n\n      # --- Option C: Try Turning Right ---\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_so_far + [TURN_RIGHT_ACTION]))\n\n  # If a path to the target (adjacent and facing the primitive) was found,\n  # append the USE action to the sequence.\n  if path_to_adjacent_primitive is not None:\n      actions_list.extend(path_to_adjacent_primitive)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T12:17:10.967239", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n\n  This version refines the pathfinding logic by pre-computing a set of impassable\n  entity kinds, making the 'walkability' check clearer and potentially slightly\n  more efficient by avoiding redundant checks for the target primitive within the loop.\n    \n  Args:\n      env (env.CraftLab): The CraftLab object.\n      primitive (str): The name of the primitive to collect.\n\n  Returns:\n      List[int]: A sequence of action indices to execute.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (r, c)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = initial_grid.shape # (rows, columns, kinds)\n\n  # Check if the primitive is already in inventory. If so, no actions are needed.\n  if current_state.inventory[primitive_id] > 0:\n      return [] \n\n  action_map = env.action_specs()\n  USE_ACTION = action_map['USE']\n\n  # Pre-compute a set of impassable kinds for pathfinding.\n  # These are entities the agent cannot walk *onto*. This includes all\n  # non-grabbable items (like boundaries, water, workshops) and also the\n  # specific primitive we are trying to collect (as agent must be adjacent).\n  impassable_kinds = set(current_state.world.non_grabbable_indices)\n  impassable_kinds.add(primitive_id) # Agent cannot walk onto the primitive it wants to collect.\n\n  # Define the BFS helper function locally to encapsulate pathfinding logic.\n  def _find_path_to_adjacent_facing_primitive(\n      start_pos: tuple[int, int],\n      start_dir: int,\n      target_primitive_id: int,\n  ) -> list[int] | None:\n      \"\"\"\n      Internal helper function to find a sequence of movement/turn actions (BFS)\n      to reach a state where the agent is adjacent to and facing the target primitive.\n      \"\"\"\n      # Extract action indices from the outer scope's action_map\n      MOVE_FORWARD_ACTION = action_map['UP']\n      TURN_LEFT_ACTION = action_map['LEFT']\n      TURN_RIGHT_ACTION = action_map['RIGHT']\n\n      # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n      DIR_TO_DRDC = {\n          0: (0, 1),   # Facing RIGHT, move in positive column direction\n          1: (-1, 0),  # Facing UP, move in negative row direction\n          2: (0, -1),  # Facing LEFT, move in negative column direction\n          3: (1, 0)    # Facing DOWN, move in positive row direction\n      }\n\n      # Map for updating agent's direction when turning left/right\n      TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n      TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n      # BFS Queue: stores ( (current_pos_tuple, current_dir_int), list_of_actions_to_reach_here )\n      queue = collections.deque([((start_pos, start_dir), [])])\n      # Visited set: stores (position_tuple, direction_int) to avoid redundant paths and cycles\n      visited = {(start_pos, start_dir)}\n\n      while queue:\n          (current_pos, current_dir), path_actions = queue.popleft()\n          r, c = current_pos\n\n          # 1. Check if the current state satisfies the target condition:\n          # The primitive must be in the cell directly in front of the agent.\n          front_dr, front_dc = DIR_TO_DRDC[current_dir]\n          front_r, front_c = r + front_dr, c + front_dc\n\n          # Ensure the cell in front is within grid bounds\n          if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n              # Check if the cell in front contains the target primitive\n              if initial_grid[front_r, front_c, target_primitive_id] > 0:\n                  return path_actions # Path found, return the sequence of actions\n\n          # 2. Explore possible next actions: Move Forward, Turn Left, Turn Right\n          \n          # Try Move Forward\n          move_dr, move_dc = DIR_TO_DRDC[current_dir]\n          next_r, next_c = r + move_dr, c + move_dc\n          next_pos = (next_r, next_c)\n          next_dir = current_dir # Moving forward does not change facing direction\n\n          # Check if the next position is within bounds and this (position, direction) state hasn't been visited\n          if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT and\n              (next_pos, next_dir) not in visited):\n              \n              # Determine if the next position is walkable:\n              # It must not contain any of the pre-computed 'impassable_kinds'.\n              is_walkable = True\n              for kind_idx in impassable_kinds:\n                  if initial_grid[next_r, next_c, kind_idx] > 0:\n                      is_walkable = False\n                      break\n              \n              if is_walkable:\n                  visited.add((next_pos, next_dir))\n                  queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n          # Try Turn Left\n          next_dir_left = TURN_LEFT_MAP[current_dir]\n          if ((current_pos, next_dir_left) not in visited):\n              visited.add((current_pos, next_dir_left))\n              queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n          # Try Turn Right\n          next_dir_right = TURN_RIGHT_MAP[current_dir]\n          if ((current_pos, next_dir_right) not in visited):\n              visited.add((current_pos, next_dir_right))\n              queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n      return None # No path found after exploring all reachable states\n\n  # Call the nested BFS helper function to find the movement/turn sequence\n  path_to_primitive = _find_path_to_adjacent_facing_primitive(\n      start_pos=initial_pos,\n      start_dir=initial_dir,\n      target_primitive_id=primitive_id,\n  )\n\n  # If a valid path to the primitive was found, append the 'USE' action to the sequence.\n  # The 'USE' action is assumed to \"collect\" the primitive once the agent is in the correct position.\n  if path_to_primitive is not None:\n      actions_list.extend(path_to_primitive)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T12:18:13.688398", "function_name": "collect", "function_body": "", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-08-01T12:18:14.950936", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  \n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  # Essential check: If the primitive is not a 'grabbable' item (e.g., it's a fixed\n  # environmental feature like WATER, STONE, WORKSHOP, or a BOUNDARY),\n  # it cannot be collected using the USE action. In such cases, no actions\n  # can lead to its collection, so an empty list is returned.\n  if primitive_id not in current_state.world.grabbable_indices:\n      return []\n\n  # Get initial state components\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (row, col)\n  initial_dir = current_state.dir # int (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # Map DSL actions to their integer indices provided by the environment\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP'] # Agent moves forward in its current direction\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define changes in (row, col) for each facing direction when moving forward\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT (East): row no change, col +1\n      1: (-1, 0),  # Facing UP (North): row -1, col no change\n      2: (0, -1),  # Facing LEFT (West): row no change, col -1\n      3: (1, 0)    # Facing DOWN (South): row +1, col no change\n  }\n\n  # Define how direction changes when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Identify all grid entity indices that block agent movement.\n  # This includes permanent environment obstacles (e.g., boundaries, water, workshops)\n  # AND the target primitive itself. The agent must stand *adjacent* to the primitive\n  # to use it, not on the same square.\n  non_walkable_indices = list(current_state.world.non_grabbable_indices.union({primitive_id}))\n\n  # Breadth-First Search (BFS) for shortest path\n  # Queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_to_reach_here)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (position_tuple, direction_int) to prevent cycles and revisit states\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # Stores the action sequence once the target state is found\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the agent is currently adjacent to and facing the primitive.\n      # This is the goal state for collecting an item.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the cell in front is within grid boundaries\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          # Check if the primitive is present in the cell directly in front of the agent\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path_actions = path_actions\n              break # Shortest path to target (adjacent and facing) found\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right\n      \n      # --- Try Move Forward ---\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if the next position is within bounds and the new state hasn't been visited\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT and\n          (next_pos, next_dir) not in visited):\n          \n          # Check if the next position is walkable (i.e., it does not contain any blocking entities)\n          # np.any returns True if any element in the given slice is True (or > 0).\n          if not np.any(initial_grid[next_r, next_c, non_walkable_indices] > 0):\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # --- Try Turn Left ---\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning changes direction but not position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # --- Try Turn Right ---\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning changes direction but not position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path was found to the position where the agent can USE the primitive,\n  # append the USE action to complete the collection process.\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 2, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T12:20:28.280459", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n\n  This implementation uses Breadth-First Search (BFS) to find the shortest\n  sequence of actions (moves and 'USE' actions) to collect the specified primitive.\n  It considers both direct collection (if the primitive is under the agent or adjacent)\n  and multi-step collection that might involve picking up tools first.\n\n  The \"improvement\" over a hypothetical less robust version lies in its comprehensive\n  state representation for the BFS (including position, direction, and full inventory)\n  to accurately account for all relevant state changes, especially when acquiring\n  tools is a prerequisite for collecting the target primitive. It also correctly\n  handles different ways a primitive can be 'collected' (from underfoot or by facing).\n\n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect.\n\n    Returns:\n        List[int]: A sequence of action indices to execute, or an empty list if\n                   the primitive is already collected or unreachable.\n  \"\"\"\n  current_state = env._current_state\n  world = env.world\n\n  # 1. Map the primitive name to its integer ID.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If so, it's already \"collected,\" and no actions are needed.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Determine if the primitive is a type that can be collected via the 'USE' action.\n  # This includes grabbable items (like tools), water, or stone. Other items (e.g., workshops, boundaries)\n  # are not typically \"collected\" into inventory by this function.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or\n      i_kind == world.water_index or\n      i_kind == world.stone_index\n  )\n\n  # If the item is not intended to be collected via 'USE', return an empty path.\n  # This prevents the agent from trying to \"collect\" non-collectible entities like workshops or boundaries.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action constants and directional deltas for grid navigation.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # Delta values for checking the cell directly in front of the agent based on its current direction.\n  # Direction mapping: 0=UP, 1=RIGHT, 2=DOWN, 3=LEFT\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (North)\n      1: (0, 1),  # RIGHT: row, col + 1 (East)\n      2: (1, 0),  # DOWN: row + 1, col (South)\n      3: (0, -1)  # LEFT: row, col - 1 (West)\n  }\n\n  # Helper function to compute the minimal sequence of turns to face a target direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the correct direction.\n\n      # Calculate the difference in directions, wrapping around 0-3.\n      diff = (target_dir - current_dir + 4) % 4\n\n      if diff == 1: # Target is one step clockwise (e.g., UP to RIGHT).\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP to LEFT).\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP to DOWN).\n          return [RIGHT_ACT, RIGHT_ACT] # Two successive right turns (or left turns).\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The `visited` set stores a tuple `(row, col, direction, inventory_tuple)` to represent\n  # a unique state. Converting inventory (numpy array) to a tuple makes it hashable for the set.\n  # This state definition is crucial to handle scenarios where acquiring tools or other\n  # inventory changes unlock new interactions.\n  visited = set()\n\n  # Add the initial state to the queue and visited set.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, [])) # (current_state, path_to_reach_this_state)\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Heuristic limit to prevent the BFS from running indefinitely in complex or unreachable scenarios.\n  # The multiplier (10) is chosen to allow exploration of states including tool acquisition.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10\n  explored_states_count = 0\n\n  # 6. BFS Loop: Continues until the queue is empty or the goal is found.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and its associated path.\n    explored_states_count += 1\n\n    # Pruning: If too many distinct states have been explored, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n\n    # Goal Check - can the primitive be collected from the current state?\n    # This considers two main cases for performing a 'USE' action:\n    # 1. The primitive is directly under the agent (and is grabbable).\n    # 2. The primitive is in an adjacent cell (requires turning to face and then USE).\n\n    # Case 1: Primitive is directly under the agent and is a grabbable item.\n    if i_kind in world.grabbable_indices and state.grid[current_r, current_c, i_kind] == 1:\n        inventory_before_use = np.copy(state.inventory)\n        _, state_after_use = state.step(USE_ACT) # Simulate picking up from current spot.\n\n        if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n            return path + [USE_ACT] # Found a path by picking up from current cell.\n\n    # Case 2: Primitive is in an adjacent cell and requires facing it.\n    # `state.next_to(i_kind)` checks if any cell in the 3x3 neighborhood contains the item.\n    if state.next_to(i_kind):\n        # Iterate through all four cardinal directions to check if the primitive is directly in front.\n        for target_dir in range(4):\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell directly in front is within bounds and contains the target primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and\n                state.grid[facing_r, facing_c, i_kind] == 1):\n\n                # Calculate and apply the turning actions required to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state\n                for turn_action in turns_to_face:\n                    # Simulate turns to get to the correct facing direction.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Record inventory *before* attempting the 'USE' action to verify successful collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action on the temporary state (after turns).\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Crucial verification: Check if the count of the target primitive in inventory\n                # actually increased. This confirms successful collection, accounting for any\n                # game rules (e.g., requiring tools) handled by `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT] # Found a valid collection path!\n\n    # Explore possible future states by performing movement actions (UP, DOWN, LEFT, RIGHT).\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory) # Convert array to hashable tuple\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      # If this next state (position, direction, and inventory) has not been visited, add it to the queue.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n\n    # Explore the general 'USE' action from the current state.\n    # This is vital for scenarios where using an item at the current location (e.g., picking up a tool\n    # that is not the target primitive, or interacting with a workshop) might enable subsequent collection steps.\n    # This broad 'USE' action acts as a catch-all for various interactions that change the state.\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n\n    # Only add the state after a general 'USE' action if it actually caused a significant change\n    # in inventory, position, or direction. This prevents adding redundant states if 'USE' does nothing.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS loop completes and no path to collect the primitive was found,\n  # it means the primitive is currently unreachable given the environment and agent's capabilities.\n  return []", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T12:20:29.796845", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Map the primitive name to its integer ID.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If so, it's already \"collected,\" and no actions are needed.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Determine if the primitive is a type that can be collected via the 'USE' action.\n  # This includes grabbable items (like tools), water, or stone. Other items (e.g., workshops, boundaries)\n  # are not typically \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or\n      i_kind == world.water_index or\n      i_kind == world.stone_index\n  )\n\n  # If the item is not intended to be collected via 'USE', return an empty path.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action constants and directional deltas for grid navigation.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # Delta values for checking the cell directly in front of the agent based on its current direction.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (North)\n      1: (0, 1),  # RIGHT: row, col + 1 (East)\n      2: (1, 0),  # DOWN: row + 1, col (South)\n      3: (0, -1)  # LEFT: row, col - 1 (West)\n  }\n\n  # Helper function to compute the minimal sequence of turns to face a target direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the correct direction.\n\n      # Calculate the difference in directions, wrapping around 0-3.\n      diff = (target_dir - current_dir + 4) % 4\n\n      if diff == 1: # Target is one step clockwise.\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise.\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn.\n          return [RIGHT_ACT, RIGHT_ACT] # Two successive right turns (or left turns).\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The `visited` set stores a tuple `(row, col, direction, inventory_tuple)` to represent\n  # a unique state. Converting inventory (numpy array) to a tuple makes it hashable for the set.\n  visited = set()\n\n  # Add the initial state to the queue and visited set.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, [])) # (current_state, path_to_reach_this_state)\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  \n  # Heuristic limits for pruning the search space.\n  # MAX_EXPLORED_STATES limits the number of unique (pos, dir, inv) states visited.\n  # MAX_PATH_LENGTH limits the maximum number of actions in a path. This helps prevent\n  # searches for extremely long (and likely inefficient or impossible) paths.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10\n  MAX_PATH_LENGTH = grid_width * grid_height * 4 # A path longer than this often suggests unreachability.\n  \n  explored_states_count = 0\n\n  # 6. BFS Loop: Continues until the queue is empty or the goal is found.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and its associated path.\n    explored_states_count += 1\n\n    # Pruning: If too many distinct states have been explored or the current path is too long, skip this branch.\n    if explored_states_count > MAX_EXPLORED_STATES or len(path) > MAX_PATH_LENGTH:\n      continue\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n\n    # Goal Check - can the primitive be collected from the current state?\n    # This now considers two cases:\n    # 1. The primitive is directly under the agent (and is grabbable).\n    # 2. The primitive is in an adjacent cell (requires turning to face and then USE).\n\n    # Case 1: Primitive is directly under the agent and is grabbable.\n    if i_kind in world.grabbable_indices and state.grid[current_r, current_c, i_kind] == 1:\n        inventory_before_use = np.copy(state.inventory)\n        _, state_after_use = state.step(USE_ACT) # Attempt to pick up from current spot.\n\n        if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n            return path + [USE_ACT] # Found a path by picking up from current cell.\n\n    # Case 2: Primitive is in an adjacent cell and requires facing it.\n    # We use state.next_to(i_kind) as a broader hint, then refine by checking specific directions.\n    # Note: state.next_to also checks the current cell, but we've handled that explicitly above for grabbables.\n    if state.next_to(i_kind): # This ensures an item of i_kind is in the 3x3 neighborhood.\n        # Iterate through all four cardinal directions to check if the primitive is directly in front.\n        for target_dir in range(4):\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell directly in front is within bounds and contains the target primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and\n                state.grid[facing_r, facing_c, i_kind] == 1):\n\n                # Calculate and apply the turning actions required to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state\n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Record inventory *before* attempting the 'USE' action to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action on the temporary state.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Crucial verification: Check if the count of the target primitive in inventory\n                # actually increased. This confirms successful collection, accounting for any\n                # game rules (e.g., requiring tools) handled by `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT] # Found a path!\n\n    # Explore possible future states by performing movement actions.\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      # If this next state (position, direction, and inventory) has not been visited, add it to the queue.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n\n    # Explore the 'USE' action from the current state, even if not directly facing the target primitive.\n    # This is vital for scenarios where using an item at the current location (e.g., picking up a tool)\n    # might enable subsequent collection steps. This general 'USE' acts as a catch-all for various\n    # interactions that change the state (e.g., picking up a tool from the ground, interacting with a workshop).\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n\n    # Only add the state after a general 'USE' action if it actually caused a change\n    # in inventory, position, or direction, preventing redundant explorations.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS loop completes and no path to collect the primitive was found,\n  # it means the primitive is currently unreachable given the environment and agent's capabilities.\n  return []", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T12:22:00.412783", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  \n  # Get the integer ID for the target primitive from the cookbook index.\n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  # --- Improvement for collect_v2: Handle non-grabbable primitives upfront. ---\n  # If the primitive is classified as non-grabbable, it cannot be \"collected\" into inventory.\n  # Therefore, no actions can lead to its collection, so we return an empty list.\n  if primitive_id in current_state.world.non_grabbable_indices:\n      return []\n\n  # Early exit if the primitive is already in inventory (from collect_v1).\n  if current_state.inventory[primitive_id] > 0:\n      return []\n\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's current (row, column) tuple\n  initial_dir = current_state.dir # Agent's current facing direction (0:Right, 1:Up, 2:Left, 3:Down)\n\n  num_rows, num_cols, _ = initial_grid.shape # Extract grid dimensions\n\n  # Map symbolic actions from action_specs to their integer indices.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP'] # 'UP' in action_specs typically means \"move forward\"\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define changes in (row, col) for each direction (0:Right, 1:Up, 2:Left, 3:Down).\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: +1 to column (col)\n      1: (-1, 0),  # Facing UP: -1 to row (row)\n      2: (0, -1),  # Facing LEFT: -1 to column (col)\n      3: (1, 0)    # Facing DOWN: +1 to row (row)\n  }\n\n  # Define how direction changes when turning left or right.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Get indices of entities that block agent movement (non-grabbable terrain/objects).\n  non_grabbable_indices = current_state.world.non_grabbable_indices\n  \n  # Create a set of non-walkable indices for efficient lookups during BFS.\n  # The primitive itself is typically not walkable, as the agent needs to be adjacent to collect it.\n  non_walkable_for_movement_set = set(non_grabbable_indices)\n  non_walkable_for_movement_set.add(primitive_id)\n  \n  # Convert to a numpy array once for efficient grid checking during BFS.\n  non_walkable_for_movement_array = np.array(list(non_walkable_for_movement_set), dtype=int)\n\n  # BFS initialization:\n  # queue: stores ( (current_position_tuple, current_direction_int), list_of_actions_to_reach_here )\n  # visited: stores (position_tuple, direction_int) pairs to prevent redundant exploration and cycles.\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # This will store the action sequence leading to the state\n                              # where the agent is adjacent to the primitive and facing it.\n\n  while queue:\n      (current_pos, current_dir), path_to_current_state = queue.popleft()\n      r, c = current_pos\n\n      # 1. Goal Check: Is the primitive directly in front of the agent at the current state?\n      # Calculate the coordinates of the cell directly in front of the agent.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the cell in front is within grid bounds AND contains the primitive.\n      # We check the `initial_grid` because the BFS is finding a path through the static environment.\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols and\n          initial_grid[front_r, front_c, primitive_id] > 0):\n          \n          target_path_actions = path_to_current_state\n          break # Found the shortest path to be adjacent and facing the primitive.\n\n      # 2. Explore possible next actions from the current state (Move Forward, Turn Left, Turn Right).\n      \n      # --- Try Move Forward ---\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction.\n\n      # Check if the next position is within grid boundaries.\n      if (0 <= next_r < num_rows and 0 <= next_c < num_cols):\n          # Check if this specific (position, direction) state has not been visited yet.\n          if (next_pos, next_dir) not in visited:\n              # Check if the next position is walkable.\n              # A cell is not walkable if it contains any of the blocking kinds.\n              is_walkable = not np.any(initial_grid[next_r, next_c, non_walkable_for_movement_array] > 0)\n              \n              if is_walkable:\n                  visited.add((next_pos, next_dir)) # Mark this state as visited.\n                  # Add the new state to the queue with the updated path of actions.\n                  queue.append(((next_pos, next_dir), path_to_current_state + [MOVE_FORWARD_ACTION]))\n\n      # --- Try Turn Left ---\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if (current_pos, next_dir_left) not in visited:\n          visited.add((current_pos, next_dir_left)) # Mark as visited.\n          queue.append(((current_pos, next_dir_left), path_to_current_state + [TURN_LEFT_ACTION]))\n\n      # --- Try Turn Right ---\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if (current_pos, next_dir_right) not in visited:\n          visited.add((current_pos, next_dir_right)) # Mark as visited.\n          queue.append(((current_pos, next_dir_right), path_to_current_state + [TURN_RIGHT_ACTION]))\n\n  # If a path was found to reach an adjacent and facing position, append the final USE action.\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 1, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T12:22:01.574376", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  \n  # Get the integer ID for the target primitive from the cookbook index.\n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  # --- V2 Improvement: Validate if the primitive is actually a \"collectible resource\". ---\n  # Primitives that are part of the 'cookbook.primitives' set are considered resources \n  # that can be collected into inventory. Others (like WORKSHOP, WATER, BOUNDARY, etc.) \n  # are typically environment features that are interacted with or are obstacles, \n  # but not 'collected' into inventory.\n  # This check ensures 'collect' adheres strictly to gathering resources.\n  if primitive_id not in current_state.world.cookbook.primitives:\n      # If it's not a collectible resource according to the cookbook, \n      # we return an empty list, as this function's purpose is \"collection\".\n      # Other DSL functions might handle interaction with non-collectible environment features.\n      return []\n\n  # Early exit if the primitive is already in inventory.\n  # This is crucial for efficiency, preventing unnecessary pathfinding.\n  if current_state.inventory[primitive_id] > 0:\n      return []\n\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's current (row, column) tuple\n  initial_dir = current_state.dir # Agent's current facing direction (0:Right, 1:Up, 2:Left, 3:Down)\n\n  num_rows, num_cols, _ = initial_grid.shape # Extract grid dimensions\n\n  # Map symbolic actions from action_specs to their integer indices.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP'] # 'UP' in action_specs typically means \"move forward\"\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define changes in (row, col) for each direction (0:Right, 1:Up, 2:Left, 3:Down).\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: +1 to column (col)\n      1: (-1, 0),  # Facing UP: -1 to row (row)\n      2: (0, -1),  # Facing LEFT: -1 to column (col)\n      3: (1, 0)    # Facing DOWN: +1 to row (row)\n  }\n\n  # Define how direction changes when turning left or right.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Get indices of entities that block agent movement (non-grabbable terrain/objects).\n  non_grabbable_indices = current_state.world.non_grabbable_indices\n  \n  # Create a set of non-walkable indices for efficient lookups during BFS.\n  # The primitive itself is added to this set to ensure the agent stands adjacent to it \n  # (not on it) to use the USE_ACTION.\n  non_walkable_for_movement_set = set(non_grabbable_indices)\n  non_walkable_for_movement_set.add(primitive_id)\n  \n  # Convert to a numpy array once for efficient grid checking during BFS using np.any.\n  non_walkable_for_movement_array = np.array(list(non_walkable_for_movement_set), dtype=int)\n\n\n  # BFS initialization:\n  # queue: stores ( (current_position_tuple, current_direction_int), list_of_actions_to_reach_here )\n  # visited: stores (position_tuple, direction_int) pairs to prevent redundant exploration and cycles.\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # This will store the action sequence leading to the state\n                              # where the agent is adjacent to the primitive and facing it.\n\n  while queue:\n      (current_pos, current_dir), path_to_current_state = queue.popleft()\n      r, c = current_pos\n\n      # 1. Goal Check: Is the primitive directly in front of the agent at the current state?\n      # Calculate the coordinates of the cell directly in front of the agent.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the cell in front is within grid bounds AND contains the primitive.\n      # We check the `initial_grid` because the BFS is finding a path through the static environment\n      # at the moment the `collect` function is called.\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols and\n          initial_grid[front_r, front_c, primitive_id] > 0):\n          \n          target_path_actions = path_to_current_state\n          break # Found the shortest path to be adjacent and facing the primitive.\n\n      # 2. Explore possible next actions from the current state (Move Forward, Turn Left, Turn Right).\n      \n      # --- Try Move Forward ---\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction.\n\n      # Check if the next position is within grid boundaries.\n      if (0 <= next_r < num_rows and 0 <= next_c < num_cols):\n          # Check if this specific (position, direction) state has not been visited yet.\n          if (next_pos, next_dir) not in visited:\n              # Check if the next position is walkable. A cell is not walkable if it contains \n              # any of the blocking kinds (e.g., boundary, water, workshop, or the primitive itself).\n              is_walkable = not np.any(initial_grid[next_r, next_c, non_walkable_for_movement_array] > 0)\n              \n              if is_walkable:\n                  visited.add((next_pos, next_dir)) # Mark this state as visited.\n                  # Add the new state to the queue with the updated path of actions.\n                  queue.append(((next_pos, next_dir), path_to_current_state + [MOVE_FORWARD_ACTION]))\n\n      # --- Try Turn Left ---\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if (current_pos, next_dir_left) not in visited:\n          visited.add((current_pos, next_dir_left)) # Mark as visited.\n          queue.append(((current_pos, next_dir_left), path_to_current_state + [TURN_LEFT_ACTION]))\n\n      # --- Try Turn Right ---\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if (current_pos, next_dir_right) not in visited:\n          visited.add((current_pos, next_dir_right)) # Mark as visited.\n          queue.append(((current_pos, next_dir_right), path_to_current_state + [TURN_RIGHT_ACTION]))\n\n  # If a path was found to reach an adjacent and facing position, append the final USE action.\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 1, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T12:22:31.325514", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos  # tuple (r, c)\n  initial_dir = current_state.dir  # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  action_map = env.action_specs()\n  # Map DSL movement/turn actions to their integer indices from action_specs\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT, moves in positive column direction\n      1: (-1, 0),  # Facing UP, moves in negative row direction\n      2: (0, -1),  # Facing LEFT, moves in negative column direction\n      3: (1, 0)    # Facing DOWN, moves in positive row direction\n  }\n\n  # Map for turning left/right, updating the agent's direction (0-3)\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # R(0)->U(1)->L(2)->D(3)->R(0)\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # R(0)->D(3)->L(2)->U(1)->R(0)\n\n  # Identify all kinds of entities that the agent cannot walk onto.\n  # This includes general non-grabbable items (like boundaries, water, workshops)\n  # AND the primitive itself (as the agent needs to stop *adjacent* to it, not on it).\n  unwalkable_kind_ids = set(current_state.world.non_grabbable_indices)\n  unwalkable_kind_ids.add(primitive_id) \n\n  # BFS state: ((row, col, direction), path_actions)\n  # Queue stores ( (current_pos_tuple, current_dir_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos[0], initial_pos[1], initial_dir), [])])\n  \n  # Visited set stores (row, col, direction) to avoid cycles and redundant paths\n  visited = {(initial_pos[0], initial_pos[1], initial_dir)}\n\n  target_path = None # Stores the action list to reach the target state\n\n  while queue:\n      (r, c, current_dir), path_actions = queue.popleft()\n\n      # 1. Check if the primitive is directly in front of the agent in the current state\n      # Calculate the coordinates of the cell directly in front\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if front_cell is within grid bounds\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          # Check if the front_cell contains the primitive\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Path to target found (agent is adjacent and facing the primitive)\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r_move, next_c_move = r + move_dr, c + move_dc\n      next_dir_move = current_dir # Moving forward does not change facing direction\n      next_state_move = (next_r_move, next_c_move, next_dir_move)\n\n      # Check if next_pos is within bounds and this (position, direction) state hasn't been visited\n      if (0 <= next_r_move < WIDTH and 0 <= next_c_move < HEIGHT and\n          next_state_move not in visited):\n          \n          # Determine if the next position is walkable\n          is_walkable = True\n          # A cell is walkable if it doesn't contain any of the unwalkable kinds.\n          for kind_idx in unwalkable_kind_ids:\n              if initial_grid[next_r_move, next_c_move, kind_idx] > 0:\n                  is_walkable = False\n                  break\n\n          if is_walkable:\n              visited.add(next_state_move)\n              queue.append((next_state_move, path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      next_state_left = (r, c, next_dir_left) # Turning does not change position\n      if (next_state_left not in visited):\n          visited.add(next_state_left)\n          queue.append((next_state_left, path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      next_state_right = (r, c, next_dir_right) # Turning does not change position\n      if (next_state_right not in visited):\n          visited.add(next_state_right)\n          queue.append((next_state_right, path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path was found, append the USE action to the sequence\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 0, "scores": {"3": 0.5}}
