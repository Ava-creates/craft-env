f the USE_ACT resulted in a change of state.\n            state_changed_by_adj_use = not (\n                np.array_equal(state_after_adj_use.inventory, inv_before_adj_use) and\n                state_after_adj_use.pos == temp_state_before_use.pos and\n                state_after_adj_use.dir == temp_state_before_use.dir and\n                np.array_equal(state_after_adj_use.grid, grid_before_adj_use) \n            )\n            if state_changed_by_adj_use:\n                next_s = state_after_adj_use\n                next_p = path + turns_to_face + [USE_ACT]\n                # inv_before_adj_use is correctly the inventory before this specific USE_ACT\n\n                # Check if primitive was collected after this action.\n                if next_s.inventory[i_kind] > inv_before_adj_use[i_kind]:\n                    return next_p # Goal achieved! Return the shortest path immediately.\n\n                # Add to queue if not visited.\n                next_inventory_tuple = tuple(next_s.inventory)\n                next_grid_hash = hash(next_s.grid.tobytes())\n                next_state_key = (next_grid_hash, next_s.pos[0], next_s.pos[1], next_s.dir, next_inventory_tuple)\n\n                if next_state_key not in visited:\n                    visited.add(next_state_key)\n                    q.append((next_s, next_p))\n  \n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions\n  # and within the defined search limits.\n  return []", "island_id": 6, "scores": {"3": 2.5}}
{"timestamp": "2025-08-01T15:37:55.126788", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized or not in the cookbook, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific natural resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not something that can be collected by using it in the world,\n  # a BFS for collection via 'USE' is not appropriate.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP (North)\n      1: (0, 1),  # RIGHT (East)\n      2: (1, 0),  # DOWN (South)\n      3: (0, -1)  # LEFT (West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference in [0, 3].\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set tracks states using a tuple of (row, col, direction, inventory_tuple).\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing, allowing BFS to distinguish\n  # between states that are identical in position/direction but differ in inventory (e.g., after picking up a tool).\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))  # (CraftState object, path_list)\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # MAX_EXPLORED_STATES is a pragmatic limit to prevent extremely long searches.\n  # The multiplier '10' accounts for the increased state space due to varying inventory.\n  # This is a heuristic and may need tuning for specific environment complexities.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop exploring new paths from here.\n    # We continue processing states already in the queue, but prevent further expansion from overly long searches.\n    if explored_states_count > MAX_EXPLORED_STATES:\n        continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`) in the 3x3 neighborhood.\n    if state.next_to(i_kind):\n        for target_dir in range(4): # Iterate through all 4 possible facing directions\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Ensure the cell directly in front is within grid bounds and contains the target primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    # Reward is always 0.0 in this implementation, so we ignore it.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection success.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                # Reward is always 0.0, so we ignore it.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed, resource depletion) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Expand possible actions from the current state:\n    # 1. Movement Actions\n    for action in move_actions:\n      # Reward is always 0.0, so we ignore it.\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory) # Convert inventory to tuple for hashing\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # 2. 'USE' Action: Refined exploration for collect_v2.\n    # Only explore USE if the agent is next to a grabbable item (e.g., tools, other resources)\n    # OR specific natural resources (like water or stone) that can be 'used' for collection.\n    # This avoids exploring USE actions on workshops, which are for crafting, not direct collection.\n    should_explore_general_use = (\n        any(state.next_to(idx) for idx in world.grabbable_indices) or\n        state.next_to(world.water_index) or\n        state.next_to(world.stone_index)\n    )\n\n    if should_explore_general_use:\n        inventory_before_any_use = np.copy(state.inventory)\n        _, state_after_current_use = state.step(USE_ACT)\n        \n        # Only add to queue if the USE action resulted in a meaningful state change\n        # (inventory, position, or direction changed). This also implicitly covers\n        # cases where USE does nothing and thus doesn't need to be explored.\n        if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n                state_after_current_use.pos == state.pos and\n                state_after_current_use.dir == state.dir):\n\n            next_inventory_tuple = tuple(state_after_current_use.inventory)\n            next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n            if next_state_key not in visited:\n                visited.add(next_state_key)\n                q.append((state_after_current_use, path + [USE_ACT]))\n\n  # If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T15:37:56.655992", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n  This version enhances robustness by reverting the specific heuristic for exploring the 'USE' action\n  that was introduced in `v1`. Instead, it allows the 'USE' action to be considered in any scenario\n  where it results in a meaningful change to the agent's position, direction, or inventory,\n  making the search more complete for complex environment interactions.\n    \n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect.\n\n    Returns:\n        List[int]: A sequence of action indices to execute.\n  \"\"\"\n  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized or not in the cookbook, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific natural resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not something that can be collected by using it in the world,\n  # a BFS for collection via 'USE' is not appropriate.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP (North)\n      1: (0, 1),  # RIGHT (East)\n      2: (1, 0),  # DOWN (South)\n      3: (0, -1)  # LEFT (West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference in [0, 3].\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set tracks states using a tuple of (row, col, direction, inventory_tuple).\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing, allowing BFS to distinguish\n  # between states that are identical in position/direction but differ in inventory (e.g., after picking up a tool).\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))  # (CraftState object, path_list)\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # MAX_EXPLORED_STATES is a pragmatic limit to prevent extremely long searches.\n  # The multiplier '10' accounts for the increased state space due to varying inventory.\n  # This is a heuristic and may need tuning for specific environment complexities.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop exploring new paths from here.\n    if explored_states_count > MAX_EXPLORED_STATES:\n        continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`) in the 3x3 neighborhood.\n    if state.next_to(i_kind):\n        for target_dir in range(4): # Iterate through all 4 possible facing directions\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Ensure the cell directly in front is within grid bounds and contains the target primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    # Reward is always 0.0 in this implementation, so we ignore it.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection success.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                # Reward is always 0.0, so we ignore it.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed, resource depletion) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      # Reward is always 0.0, so we ignore it.\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory) # Convert inventory to tuple for hashing\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # --- V2 Improvement: Generalize 'USE' action exploration ---\n    # In `v1`, the 'USE' action was only explored if the agent was next to a grabbable\n    # item or on a workshop. This `v2` version removes that heuristic, making the search\n    # more robust by considering the 'USE' action whenever it leads to *any* change\n    # in the agent's position, direction, or inventory. This allows the agent to\n    # interact with more diverse environmental elements (e.g., activating a mechanism\n    # or clearing a path not directly classified as grabbable/workshop interaction)\n    # that might be necessary for collection.\n    \n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Only add to queue if the USE action resulted in a meaningful state change\n    # (inventory, position, or direction changed). This also implicitly covers\n    # cases where USE does nothing (no change) and thus doesn't need to be explored.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n    # --- End of V2 Improvement ---\n\n  # If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T15:38:53.554681", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Ensure the primitive is a resource that can be collected\n  # using the 'USE' action. `world.cookbook.primitives` contains indices for\n  # actual primitive resources that are intended to be collected.\n  if i_kind not in world.cookbook.primitives:\n      return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set includes the agent's current inventory as part of the state key.\n  # This is crucial for states where acquiring a tool or using an item changes the inventory\n  # and thus affects future actions or collectibility.\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  \n  # Heuristic limit for visited states to prevent excessively long searches.\n  # Increased due to larger state space when tracking inventory.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 20 # Allow more exploration\n  explored_states_count = 0\n\n  # Max path length to limit search depth.\n  # A generous heuristic: Max cells in grid + buffer for turns/uses/short detours.\n  MAX_PATH_LENGTH = grid_width * grid_height + (grid_width + grid_height) * 2\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    # Pruning: If the current path length exceeds the maximum allowed, prune this branch.\n    if len(path) >= MAX_PATH_LENGTH:\n        continue\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`) in the immediate vicinity.\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell in front is within grid bounds and contains the target primitive\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                \n                # Pruning: Check if this collection path (current_path + turns + USE) exceeds max_path_length\n                if len(path) + len(turns_to_face) + 1 > MAX_PATH_LENGTH:\n                    continue # This path is too long to be considered valid\n\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    # _ is reward, which is always 0.0 for this implementation, so we ignore it.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection success.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                # `CraftState.step(USE_ACT)` implicitly handles any tool requirements or other game logic.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This confirms successful collection, even if tools were consumed or needed.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore the USE action from the current position FIRST,\n    # before exploring movement actions. This prioritizes picking up items (like tools)\n    # that might be at the agent's current location and change its inventory.\n    # Pruning: Ensure adding this action does not exceed the maximum path length.\n    if len(path) + 1 <= MAX_PATH_LENGTH:\n        inventory_before_any_use = np.copy(state.inventory)\n        _, state_after_current_use = state.step(USE_ACT)\n        \n        # Check if the USE action resulted in a meaningful state change (inventory, position, or direction).\n        # This prevents adding redundant states to the queue if USE had no effect in this particular state.\n        if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n                state_after_current_use.pos == state.pos and\n                state_after_current_use.dir == state.dir):\n\n            next_inventory_tuple = tuple(state_after_current_use.inventory)\n            next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n            if next_state_key not in visited:\n                visited.add(next_state_key)\n                q.append((state_after_current_use, path + [USE_ACT]))\n\n    # Explore possible movement actions:\n    # Pruning: Ensure adding these actions does not exceed the maximum path length.\n    if len(path) + 1 <= MAX_PATH_LENGTH:\n        for action in move_actions:\n            _, next_state = state.step(action)\n            next_inventory_tuple = tuple(next_state.inventory)\n            next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n            if next_state_key not in visited:\n                visited.add(next_state_key)\n                q.append((next_state, path + [action]))\n    \n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T15:38:55.050037", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # The `world.cookbook.primitives` set contains indices for actual collectible resources.\n  # If the item is not listed as a primitive, it typically cannot be collected via 'USE'.\n  if i_kind not in world.cookbook.primitives:\n      return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set includes the agent's current inventory as part of the state key.\n  # This is crucial for states where acquiring a tool or using an item changes the inventory\n  # and thus affects future actions or collectibility.\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  \n  # Heuristic limit for visited states to prevent excessively long searches.\n  # This acts as a breadth limit on the number of unique states explored.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # V2 Improvement: Explicit maximum path length to limit search depth.\n  # This prevents exploring overly long or indirect paths for a simple collection task.\n  # A generous heuristic: Max cells in grid + buffer for turns/uses/short detours.\n  MAX_PATH_LENGTH = grid_width * grid_height * 2 # Allows for some back-and-forth or detours\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct state-inventory combinations, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    # V2 Pruning: If the current path length exceeds the maximum allowed, prune this branch.\n    if len(path) >= MAX_PATH_LENGTH:\n        continue\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`) in the immediate vicinity.\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell in front is within grid bounds and contains the target primitive\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                \n                # V2 Pruning: Check if this collection path (current_path + turns + USE) exceeds max_path_length\n                if len(path) + len(turns_to_face) + 1 > MAX_PATH_LENGTH:\n                    continue # This path is too long to be considered valid\n\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    # _ is reward, which is always 0.0 for this implementation, so we ignore it.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection success.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                # `CraftState.step(USE_ACT)` implicitly handles any tool requirements or other game logic.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This confirms successful collection, even if tools were consumed or needed.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible actions: First, try the 'USE' action, then movement actions.\n    # This prioritizes picking up items (like tools) that might be at the agent's current location.\n\n    # V2 Pruning: Ensure adding this action does not exceed the maximum path length.\n    if len(path) + 1 <= MAX_PATH_LENGTH:\n        inventory_before_any_use = np.copy(state.inventory)\n        _, state_after_current_use = state.step(USE_ACT)\n        \n        # Check if the USE action resulted in a meaningful state change (inventory, position, or direction).\n        # This prevents adding redundant states to the queue if USE had no effect in this particular state.\n        if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n                state_after_current_use.pos == state.pos and\n                state_after_current_use.dir == state.dir):\n\n            next_inventory_tuple = tuple(state_after_current_use.inventory)\n            next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n            if next_state_key not in visited:\n                visited.add(next_state_key)\n                q.append((state_after_current_use, path + [USE_ACT]))\n\n    # Explore possible movement actions:\n    # V2 Pruning: Ensure adding these actions does not exceed the maximum path length.\n    if len(path) + 1 <= MAX_PATH_LENGTH:\n        for action in move_actions:\n            _, next_state = state.step(action)\n            next_inventory_tuple = tuple(next_state.inventory)\n            next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n            if next_state_key not in visited:\n                visited.add(next_state_key)\n                q.append((next_state, path + [action]))\n    \n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T15:40:07.479021", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Retrieve the numerical ID for the target primitive.\n  # Convert the primitive name to lowercase to match the cookbook's index keys.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not found in the game's index, it's an invalid target.\n    return []\n\n  # 2. Early exit: Check if the primitive is already present in the agent's inventory.\n  # If the agent already possesses the item, no actions are needed for its collection.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is designed to be collected via the 'USE' action.\n  # Collectible items typically include grabbable objects (which can be picked up)\n  # and specific environmental resources (like \"water\" or \"stone\") that are gathered by using them.\n  # Items like workshops, boundaries, or bridges are generally static environmental features and not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the target item cannot be collected by using it, we cannot fulfill the request.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Map action names to their integer IDs provided by the environment's action specifications.\n  # These constants simplify the action representation within the pathfinding logic.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  # A list of all basic movement actions for convenient iteration.\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # Helper mapping: agent's direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT) to\n  # the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: Decrement row\n      1: (0, 1),  # RIGHT: Increment column\n      2: (1, 0),  # DOWN: Increment row\n      3: (0, -1)  # LEFT: Decrement column\n  }\n\n  # Nested helper function to determine the minimal turning actions required to face a target direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the desired direction.\n\n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference in the range [0, 3].\n      diff = (target_dir - current_dir + 4) % 4\n      \n      # Based on the difference, return the shortest sequence of turns.\n      if diff == 1: # One clockwise turn (e.g., from UP to RIGHT)\n          return [RIGHT_ACT]\n      elif diff == 3: # One counter-clockwise turn (e.g., from UP to LEFT)\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., from UP to DOWN)\n          # This can be achieved by two consecutive turns in the same direction.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choosing two RIGHT turns.\n\n  # 5. Initialize Breadth-First Search (BFS) data structures.\n  # `q`: A deque storing tuples of (CraftState, list_of_actions_to_reach_this_state).\n  # BFS guarantees the shortest path in terms of the number of actions because actions have uniform cost (1 step).\n  q = collections.deque()\n  \n  # `visited`: A set to store visited states and prevent redundant exploration and cycles.\n  # A state is defined by (row, col, direction, inventory_as_tuple).\n  # Converting inventory (numpy.ndarray) to a tuple makes it hashable for set membership.\n  # This inventory-awareness is crucial for paths that may require intermediate tool collection or crafting.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  visited = set([(current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple)])\n\n  # Add the initial state to the queue to begin the search.\n  q.append((current_state, [])) # The initial path is empty.\n\n  # Get grid dimensions for defining search boundaries and heuristics.\n  grid_width, grid_height, _ = current_state.grid.shape\n  \n  # Define a heuristic limit for the number of distinct states to explore.\n  # This prevents the BFS from running indefinitely in complex or unachievable scenarios.\n  # It's set to approximately 10 times the number of unique (position, direction) states.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0 # Counter for states processed from the queue.\n\n  # 6. BFS Loop: Continue until the queue is empty or a path to the primitive is found.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and its action history.\n    explored_states_count += 1\n\n    # Pruning: If the exploration limit is reached, stop expanding this branch.\n    # This acts as a timeout for finding a reasonably short path.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      return [] # Return an empty list, indicating no path found within the limits.\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # --- Goal Check: Can we collect the target primitive from this `current_state`? ---\n    # Check if the target primitive (`i_kind`) is in the agent's immediate 3x3 neighborhood.\n    if state.next_to(i_kind):\n        # If it is, iterate through all four possible directions (UP, RIGHT, DOWN, LEFT)\n        # to determine if facing any of them positions the agent directly in front of the primitive.\n        for target_dir in range(4): \n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell directly in front of the agent (if facing `target_dir`)\n            # is within grid bounds AND contains the target primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Calculate and simulate the turning actions required to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state # Start from the current state (from BFS queue).\n                for turn_action in turns_to_face:\n                    # Apply each turn action. Reward from `CraftState.step` is typically 0.0 for movement.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Capture the inventory *before* attempting the 'USE' action.\n                # This is essential to verify that the 'USE' action actually resulted in collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action. This is the collection attempt.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Verify successful collection: The count of the primitive in inventory must have increased.\n                # This inherently handles any internal game logic (e.g., needing a specific tool to collect).\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    # Path found! Return the complete sequence of actions.\n                    return path + turns_to_face + [USE_ACT]\n\n    # --- State Expansion: Explore possible next states from the current one. ---\n\n    # 1. Explore all possible movement actions (UP, DOWN, LEFT, RIGHT).\n    for action in move_actions:\n      _, next_state = state.step(action) # Simulate the action to get the resulting new state.\n      # Convert the new state's inventory to a hashable tuple for the `visited` set.\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      # If this next state has not been visited before (in its exact configuration), add it to the queue.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action])) # Append the action to the path.\n    \n    # 2. Explore the 'USE' action from the current position.\n    # This is critical for scenarios where using an item at the current location\n    # (e.g., picking up an axe, or using a workbench to craft a tool)\n    # changes the inventory and thus enables subsequent collection steps,\n    # even if it doesn't directly collect the *target* primitive.\n    inventory_before_current_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Only add the new state if the 'USE' action resulted in a tangible change (e.g., inventory change).\n    # This prevents adding redundant states to the queue if 'USE' had no effect (e.g., using it in an empty space).\n    if not np.array_equal(state_after_current_use.inventory, inventory_before_current_use):\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS loop completes and the queue becomes empty without finding a path,\n  # it indicates that the primitive is unreachable from the initial state\n  # under the current game conditions and within the defined exploration limits.\n  return []", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T15:40:09.015946", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Validate the primitive name and retrieve its integer ID from the world's index.\n  try:\n    primitive_id = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not found in the game's index, it's invalid or unknown.\n    return []\n\n  # 2. Early exit: If the primitive is already in the agent's inventory, no actions are needed.\n  if current_state.inventory[primitive_id] > 0:\n      return []\n\n  # 3. Determine if the primitive is semantically collectible via the 'USE' action.\n  # This function specifically handles collection from the environment.\n  # Items that are grabbable (can be picked up directly) or specific environmental\n  # resources (like water, stone) fall into this category. Other items (e.g., workshops)\n  # are typically static environment features, not inventory items collected via 'USE'.\n  is_collectible_via_use = (\n      primitive_id in world.grabbable_indices or \n      primitive_id == world.water_index or \n      primitive_id == world.stone_index\n  )\n  \n  if not is_collectible_via_use:\n    # If the target item cannot be collected by using it, we cannot fulfill this request.\n    return []\n\n  # 4. Map action names to their numerical IDs as defined by the environment.\n  action_map = env.action_specs()\n  UP_ACTION = action_map[\"UP\"]\n  DOWN_ACTION = action_map[\"DOWN\"]\n  LEFT_ACTION = action_map[\"LEFT\"]\n  RIGHT_ACTION = action_map[\"RIGHT\"]\n  USE_ACTION = action_map[\"USE\"]\n\n  movement_actions = [UP_ACTION, DOWN_ACTION, LEFT_ACTION, RIGHT_ACTION]\n\n  # Helper mapping: Agent's direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT) to (row_change, col_change).\n  # This helps determine the cell directly in front of the agent.\n  DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: Decrement row\n      1: (0, 1),  # RIGHT: Increment column\n      2: (1, 0),  # DOWN: Increment row\n      3: (0, -1)  # LEFT: Decrement column\n  }\n\n  # Nested helper function to calculate the minimum turning actions to face a target direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the desired direction\n\n      # Calculate the shortest angular difference, handling circularity.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # One right turn\n          return [RIGHT_ACTION]\n      elif diff == 3: # One left turn\n          return [LEFT_ACTION]\n      else: # diff == 2 (180-degree turn)\n          return [RIGHT_ACTION, RIGHT_ACTION] # Two right turns (or two left turns)\n\n  # 5. Initialize BFS structures.\n  # `q`: A deque to store (CraftState, list_of_actions_to_reach_this_state).\n  q = collections.deque()\n  \n  # `visited`: A set to keep track of unique states already explored.\n  # A state is defined by (agent_row, agent_col, agent_direction, inventory_as_tuple).\n  # Including inventory is crucial for problems where collecting intermediate items (e.g., tools)\n  # changes the agent's capabilities and thus opens new paths.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  visited_states = set([(current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple)])\n\n  # Add the initial state to the queue.\n  q.append((current_state, []))\n\n  # Get grid dimensions for boundary checks and heuristic limit calculation.\n  grid_width, grid_height, _ = current_state.grid.shape\n  \n  # Heuristic limit for the number of states to explore to prevent excessive computation\n  # in very large or unsolvable scenarios. This helps to bound the search time.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 # Approx 10x (pos * dir) states\n  explored_count = 0 \n\n  # 6. BFS Loop: Continues until the queue is empty or the primitive is collected.\n  while q:\n    state, path_to_state = q.popleft() # Dequeue the current state and its accumulated path.\n    explored_count += 1\n\n    # Pruning: If exploration limit is reached, stop to prevent timeouts for complex searches.\n    if explored_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_row, current_col = state.pos\n    current_direction = state.dir\n    \n    # --- Goal Check: Can the target primitive be collected from this `state`? ---\n    # First, check if the primitive is within the agent's 3x3 neighborhood.\n    if state.next_to(primitive_id):\n        # If it's nearby, we need to check if we can turn to face it directly.\n        for target_facing_dir in range(4): # Iterate through UP, RIGHT, DOWN, LEFT\n            dr, dc = DIR_TO_DELTA_FRONT[target_facing_dir]\n            cell_in_front_row, cell_in_front_col = current_row + dr, current_col + dc\n\n            # Check if the cell directly in front (after hypothetical turn) is within bounds\n            # AND contains the target primitive.\n            if (0 <= cell_in_front_row < grid_width and \n                0 <= cell_in_front_col < grid_height and \n                state.grid[cell_in_front_row, cell_in_front_col, primitive_id] == 1):\n                \n                # If found, calculate the turns needed to face it.\n                turns_sequence = _get_turning_actions(current_direction, target_facing_dir)\n                \n                # Simulate applying the turns to get the state just before 'USE'.\n                state_after_turns = state \n                for turn_action in turns_sequence:\n                    _, state_after_turns = state_after_turns.step(turn_action)\n\n                # Record inventory before 'USE' to verify successful collection.\n                inventory_before_use = np.copy(state_after_turns.inventory)\n\n                # Simulate the 'USE' action to attempt collection.\n                _, state_after_use = state_after_turns.step(USE_ACTION)\n\n                # Verify collection: Check if the count of the primitive in inventory increased.\n                # This is the most robust way to confirm success, leveraging game mechanics.\n                if state_after_use.inventory[primitive_id] > inventory_before_use[primitive_id]:\n                    # Path found! Return the complete sequence of actions.\n                    return path_to_state + turns_sequence + [USE_ACTION]\n\n    # --- State Expansion: Explore possible next states from the current one ---\n\n    # 1. Explore all movement actions (UP, DOWN, LEFT, RIGHT).\n    for action in movement_actions:\n      _, next_state = state.step(action) # Step returns a new CraftState object.\n      next_inventory_tuple = tuple(next_state.inventory)\n      \n      # Define the key for the visited set.\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      # If this new state (position, direction, and inventory) has not been visited, add it.\n      if next_state_key not in visited_states:\n        visited_states.add(next_state_key)\n        q.append((next_state, path_to_state + [action])) # Add to queue with updated path.\n    \n    # 2. Explore the 'USE' action from the current position.\n    # This is important for collecting items that are at the agent's feet,\n    # or for general interactions that change inventory/capabilities without movement.\n    # (e.g., picking up a tool, activating something in place).\n    inventory_at_current_state = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACTION)\n    \n    # Only add this state if the 'USE' action actually changed the inventory.\n    # If inventory is unchanged, and pos/dir are also unchanged by USE, it's a redundant state.\n    if not np.array_equal(state_after_current_use.inventory, inventory_at_current_state):\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited_states:\n            visited_states.add(next_state_key)\n            q.append((state_after_current_use, path_to_state + [USE_ACTION]))\n\n  # 7. If the BFS loop completes (queue is empty) without finding a path to collect the primitive,\n  # it means the primitive is unreachable under the current conditions or within the search limits.\n  return []", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T15:42:27.875846", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world # Access to Cookbook, indices, etc.\n\n  # 1. Resolve primitive name to its integer ID and perform initial validity checks.\n  try:\n    primitive_id = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # Primitive name not found in the world's index.\n    return []\n\n  # Determine if the item is semantically collectible.\n  # This includes explicit primitives, special environmental features (water/stone),\n  # or any item classified as grabbable.\n  is_collectible = (\n      primitive_id in world.cookbook.primitives or\n      primitive_id == world.water_index or\n      primitive_id == world.stone_index or\n      primitive_id in world.grabbable_indices\n  )\n  if not is_collectible:\n    # The requested item cannot be acquired via 'collect' action semantics.\n    return []\n\n  # 2. Early exit: If the primitive is already in inventory, no actions are needed.\n  if current_state.inventory[primitive_id] > 0:\n    return []\n\n  # 3. Define action constants and movement/interaction helper utilities.\n  action_specs = env.action_specs()\n  ACTION_UP = action_specs[\"UP\"]\n  ACTION_DOWN = action_specs[\"DOWN\"]\n  ACTION_LEFT = action_specs[\"LEFT\"]\n  ACTION_RIGHT = action_specs[\"RIGHT\"]\n  ACTION_USE = action_specs[\"USE\"]\n\n  MOVEMENT_ACTIONS = [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]\n\n  # Delta coordinates for cells directly in front of the agent, based on its direction.\n  # Direction 0: UP, 1: RIGHT, 2: DOWN, 3: LEFT\n  DIRECTION_TO_FRONT_DELTA = {\n      0: (-1, 0), # UP: row decreases\n      1: (0, 1),  # RIGHT: col increases\n      2: (1, 0),  # DOWN: row increases\n      3: (0, -1)  # LEFT: col decreases\n  }\n\n  def _get_turns_to_face(current_dir: int, target_dir: int) -> list[int]:\n      \"\"\"Calculates the minimal turning actions to change agent's facing direction.\"\"\"\n      if current_dir == target_dir:\n          return [] # Already facing correctly.\n      \n      # Calculate turns needed (clockwise difference, modulo 4 for wrapping).\n      diff = (target_dir - current_dir + 4) % 4\n      if diff == 1: # 90 degrees clockwise\n          return [ACTION_RIGHT]\n      elif diff == 3: # 270 degrees clockwise (90 degrees counter-clockwise)\n          return [ACTION_LEFT]\n      else: # diff == 2 (180 degrees)\n          return [ACTION_RIGHT, ACTION_RIGHT] # Two right turns (or two left turns)\n\n  # 4. Initialize BFS structures.\n  # Queue stores (current_state_object, list_of_actions_to_reach_this_state)\n  bfs_queue = collections.deque()\n  \n  # Visited set to prevent cycles and redundant state exploration.\n  # A state is defined by (grid_hash, agent_row, agent_col, agent_direction, inventory_tuple).\n  visited_states = set() \n\n  initial_inventory_tuple = tuple(current_state.inventory)\n  # Hash the entire grid to capture its current layout. This is crucial as 'USE'\n  # actions can modify the grid (e.g., removing a tree after chopping).\n  initial_grid_hash = hash(current_state.grid.tobytes()) \n\n  bfs_queue.append((current_state, []))\n  visited_states.add((initial_grid_hash, current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_rows, grid_cols, _ = current_state.grid.shape\n  \n  # Heuristic limits to manage computational complexity for large state spaces.\n  # These are crucial to prevent unbounded searches in complex environments.\n  # v2 Improvement: Increase search limits to allow finding paths in more complex scenarios.\n  # These values are chosen to balance search time with completeness for typical CraftWorld sizes.\n  MAX_EXPLORED_UNIQUE_STATES = grid_rows * grid_cols * 4 * 250 # Increased multiplier from 150 to 250.\n  MAX_PATH_LENGTH = 400 # Increased path length limit from 250 to 400.\n\n  states_explored_counter = 0\n\n  # 5. BFS Loop: Explore states layer by layer.\n  while bfs_queue:\n    current_bfs_state, current_path = bfs_queue.popleft()\n    states_explored_counter += 1\n\n    # Pruning: Stop exploring this path if limits are exceeded.\n    if states_explored_counter > MAX_EXPLORED_UNIQUE_STATES or len(current_path) >= MAX_PATH_LENGTH:\n      continue \n\n    agent_r, agent_c = current_bfs_state.pos\n    agent_dir = current_bfs_state.dir\n\n    # List to hold potential next transitions:\n    # (next_state, complete_action_sequence, inventory_before_last_action)\n    # Storing `inventory_before_last_action` allows precise detection of goal acquisition.\n    potential_transitions = []\n\n    # --- Generate Next States from Current BFS State ---\n\n    # A. Movement Actions: UP, DOWN, LEFT, RIGHT\n    for action in MOVEMENT_ACTIONS:\n        # env.step returns a new state object, so current_bfs_state.inventory is implicitly 'inventory before action'.\n        _, next_s_after_move = current_bfs_state.step(action)\n        potential_transitions.append((next_s_after_move, current_path + [action], current_bfs_state.inventory))\n\n    # B. ACTION_USE at the Agent's Current Position\n    # This covers collecting items directly from the tile the agent is standing on.\n    inventory_before_use_at_pos = current_bfs_state.inventory\n    grid_before_use_at_pos = current_bfs_state.grid # Capture grid state before USE\n    _, next_s_after_use_at_pos = current_bfs_state.step(ACTION_USE)\n    \n    # Check if the USE action at position had any effect (inventory change, grid change, etc.)\n    state_changed_by_pos_use = not (\n        np.array_equal(next_s_after_use_at_pos.inventory, inventory_before_use_at_pos) and\n        np.array_equal(next_s_after_use_at_pos.grid, grid_before_use_at_pos) and\n        next_s_after_use_at_pos.pos == current_bfs_state.pos and\n        next_s_after_use_at_pos.dir == current_bfs_state.dir\n    )\n    if state_changed_by_pos_use:\n        potential_transitions.append((next_s_after_use_at_pos, current_path + [ACTION_USE], inventory_before_use_at_pos))\n    \n    # C. ACTION_USE on Adjacent Cells (after turning to face them)\n    # This covers interactions with entities in the 8-neighborhood that require facing (e.g., chopping a tree, mining a rock).\n    for target_facing_direction in range(4): # Iterate through UP, RIGHT, DOWN, LEFT as target directions\n        dr, dc = DIRECTION_TO_FRONT_DELTA[target_facing_direction]\n        facing_r, facing_c = agent_r + dr, agent_c + dc\n\n        # Check if the cell directly in front is within bounds and contains *any* entity.\n        # We don't need to check for `primitive_id` specifically here, as 'USE' might\n        # interact with one entity (e.g., \"ROCK\") to yield another (e.g., \"GOLD\").\n        if (0 <= facing_r < grid_rows and 0 <= facing_c < grid_cols) and np.any(current_bfs_state.grid[facing_r, facing_c, :] == 1):\n            \n            # 1. Get actions to turn the agent towards the target cell.\n            turning_actions = _get_turns_to_face(agent_dir, target_facing_direction)\n            \n            # 2. Simulate these turning actions to get an intermediate state where agent is oriented.\n            temp_state_after_turns = current_bfs_state\n            for turn_action in turning_actions:\n                _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n            \n            # 3. Capture inventory and grid states BEFORE performing the final USE action.\n            inventory_before_adj_use = temp_state_after_turns.inventory\n            grid_before_adj_use = temp_state_after_turns.grid\n            \n            # 4. Perform the ACTION_USE from the correctly oriented state.\n            _, next_s_after_adj_use = temp_state_after_turns.step(ACTION_USE)\n            \n            # Check if the USE action on the adjacent cell had any effect.\n            state_changed_by_adj_use = not (\n                np.array_equal(next_s_after_adj_use.inventory, inventory_before_adj_use) and\n                np.array_equal(next_s_after_adj_use.grid, grid_before_adj_use) and\n                next_s_after_adj_use.pos == temp_state_after_turns.pos and\n                next_s_after_adj_use.dir == temp_state_after_turns.dir\n            )\n            if state_changed_by_adj_use:\n                potential_transitions.append(\n                    (next_s_after_adj_use, current_path + turning_actions + [ACTION_USE], inventory_before_adj_use)\n                )\n\n    # --- Process all Generated Potential Transitions ---\n    for next_state, full_action_sequence, inv_before_last_action in potential_transitions:\n        # Check if the target primitive was acquired specifically in the LAST step of this path.\n        if next_state.inventory[primitive_id] > inv_before_last_action[primitive_id]:\n            return full_action_sequence # Goal achieved! Return the shortest path found.\n\n        # If not the goal, add the new state to the BFS queue if it hasn't been visited.\n        next_inventory_tuple = tuple(next_state.inventory)\n        next_grid_hash = hash(next_state.grid.tobytes())\n        next_state_key = (next_grid_hash, next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n        if next_state_key not in visited_states:\n            visited_states.add(next_state_key)\n            bfs_queue.append((next_state, full_action_sequence))\n\n  # 6. If the BFS queue is exhausted and no path was found, the primitive is unreachable\n  # under current conditions or within the defined search limits.\n  return []", "island_id": 2, "scores": {"3": 2.5}}
