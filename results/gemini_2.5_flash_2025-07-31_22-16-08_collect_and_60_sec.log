nd_ids_set), dtype=int)\n\n  # BFS state: ((row, col), direction), path_actions\n  # Queue stores ( (current_pos_tuple, current_dir_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (current_pos_tuple, current_dir_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # Stores the action list to reach the target state\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent at current state\n      # Calculate the coordinates of the cell directly in front\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if front_cell is within grid bounds\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          # Check if the front_cell contains the primitive\n          # This assumes the primitive's kind_id will be > 0 at its location.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Path to target found (agent is adjacent and facing the primitive)\n\n      # 2. Explore possible next actions: Move Forward, Turn Left, Turn Right\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if next_pos is within bounds\n      if not (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT):\n          # Skip this move, it's out of bounds\n          pass # Use 'pass' to not nest the next checks too deeply.\n      elif (next_pos, next_dir) in visited:\n          # Skip, already visited this state via a shorter or equal path\n          pass\n      else:\n          # Check if the next_pos contains any blocking kind using the pre-computed array.\n          # If np.any returns True, it means at least one blocking kind is present, so the cell is not walkable.\n          if not np.any(initial_grid[next_r, next_c, blocking_kind_indices] > 0):\n              # If all checks pass, it's a valid move. Add to queue.\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path was found, append the USE action to the sequence\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 1, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T07:35:16.558600", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (r, c)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  # Resolve the primitive name to its integer ID\n  # This might raise KeyError if primitive is not in the cookbook, but problem assumes valid inputs.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Get grid dimensions\n  GRID_WIDTH, GRID_HEIGHT, _ = initial_grid.shape # initial_grid.shape is (WIDTH, HEIGHT, n_kinds)\n\n  # Get integer action codes from the environment's action specifications\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define how agent's position changes based on its current direction when moving 'forward'.\n  # Directions: 0 (Right), 1 (Up), 2 (Left), 3 (Down)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col + 1)\n      1: (-1, 0),  # Facing UP: (row - 1, col)\n      2: (0, -1),  # Facing LEFT: (row, col - 1)\n      3: (1, 0)    # Facing DOWN: (row + 1, col)\n  }\n\n  # Define how agent's direction changes when turning left/right.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Identify entities that block agent movement. These are typically non-grabbable items\n  # like boundaries, water, or workshops, that the agent cannot walk through.\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # BFS Queue: stores ( (current_position_tuple, current_direction_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set: stores (position_tuple, direction_int) to prevent redundant explorations and cycles\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # Will store the sequence of actions to reach the goal state\n\n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      current_r, current_c = current_pos\n\n      # Check if the current state satisfies the goal: primitive is in the cell directly in front.\n      # Calculate the coordinates of the cell in front of the agent\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = current_r + front_dr, current_c + front_dc\n      \n      # Ensure the cell in front is within grid boundaries\n      if (0 <= front_r < GRID_WIDTH and 0 <= front_c < GRID_HEIGHT):\n          # Check if the cell in front contains the target primitive\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path_actions = path_so_far\n              break # Goal state found, exit BFS\n\n      # Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right\n      \n      # 1. Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = current_r + move_dr, current_c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if the next position is within bounds and this (position, direction) state hasn't been visited\n      if (0 <= next_r < GRID_WIDTH and 0 <= next_c < GRID_HEIGHT and\n          (next_pos, next_dir) not in visited):\n          \n          # Determine if the next position is walkable\n          is_walkable = True\n          # Agent cannot walk onto cells containing non-grabbable entities\n          for kind_idx in non_walkable_kinds_indices:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          # Agent also cannot walk onto the target primitive itself (it needs to be adjacent to 'USE' it)\n          if initial_grid[next_r, next_c, primitive_id] > 0:\n              is_walkable = False\n\n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_so_far + [MOVE_FORWARD_ACTION]))\n\n      # 2. Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_so_far + [TURN_LEFT_ACTION]))\n\n      # 3. Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_so_far + [TURN_RIGHT_ACTION]))\n\n  # If a path to being adjacent and facing the primitive was found, append the 'USE' action.\n  # The 'USE' action is the final step to \"collect\" the primitive.\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T07:35:17.684460", "function_name": "collect", "function_body": "  \"\"\"Returns a list of actions to find and collect the primitive in the passed env.\n    \n    This version assumes that the actions UP/DOWN/LEFT/RIGHT are cardinal movements on the grid,\n    and that performing one of these actions *also* updates the agent's facing direction\n    to match the direction of movement. The 'USE' action then interacts with what the agent is facing.\n\n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect.\n\n    Returns:\n        List[int]: A sequence of action indices to execute.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (row, col)\n  initial_dir = current_state.dir # int (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN) initially\n\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  GRID_ROWS, GRID_COLS, _ = initial_grid.shape \n\n  action_map = env.action_specs()\n  # Map cardinal movement actions to their integer indices from the environment\n  ACTION_UP = action_map['UP']     # Corresponds to moving North\n  ACTION_DOWN = action_map['DOWN'] # Corresponds to moving South\n  ACTION_LEFT = action_map['LEFT'] # Corresponds to moving West\n  ACTION_RIGHT = action_map['RIGHT'] # Corresponds to moving East\n  ACTION_USE = action_map['USE']\n\n  # Mapping from an action (e.g., ACTION_UP) to its (dr, dc) effect on position\n  # and the resulting facing direction (assuming movement aligns direction).\n  # Direction mapping for agent's dir attribute: 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n  ACTION_EFFECTS = {\n      ACTION_UP:    ((-1, 0), 1), # Move North (row-1), resulting facing direction is UP (1)\n      ACTION_DOWN:  ((1, 0), 3),  # Move South (row+1), resulting facing direction is DOWN (3)\n      ACTION_LEFT:  ((0, -1), 2), # Move West (col-1), resulting facing direction is LEFT (2)\n      ACTION_RIGHT: ((0, 1), 0),  # Move East (col+1), resulting facing direction is RIGHT (0)\n  }\n\n  # This maps an agent's facing direction to the (dr, dc) offset of the cell directly in front.\n  DIR_TO_DRDC_FOR_FACING = {\n      0: (0, 1),   # Facing RIGHT (dir=0): cell is (r, c+1)\n      1: (-1, 0),  # Facing UP (dir=1): cell is (r-1, c)\n      2: (0, -1),  # Facing LEFT (dir=2): cell is (r, c-1)\n      3: (1, 0)    # Facing DOWN (dir=3): cell is (r+1, c)\n  }\n\n  # Get indices of non-grabbable items that act as obstacles (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # BFS Queue: stores ( (current_position_tuple, current_direction_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set: stores (position_tuple, direction_int) to avoid redundant paths and cycles\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_to_adjacent_facing_primitive = None # Stores the sequence of actions to reach the state just before 'USE'\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the current state satisfies the condition to 'USE' the primitive:\n      # The primitive must be in the cell directly in front of the agent given its current direction.\n      front_dr, front_dc = DIR_TO_DRDC_FOR_FACING[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n\n      # Ensure the cell in front is within grid bounds\n      if (0 <= front_r < GRID_ROWS and 0 <= front_c < GRID_COLS):\n          # Check if the cell in front contains the target primitive\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path_to_adjacent_facing_primitive = path_actions\n              break # Path found, exit BFS as we've found the shortest sequence of movements\n\n      # 2. Explore possible next actions (cardinal movements):\n      for action_type, ((dr, dc), new_dir_after_move) in ACTION_EFFECTS.items():\n          next_r, next_c = r + dr, c + dc\n          next_pos = (next_r, next_c)\n          next_state_tuple = (next_pos, new_dir_after_move)\n\n          # Check if the next position is within grid bounds\n          if not (0 <= next_r < GRID_ROWS and 0 <= next_c < GRID_COLS):\n              continue # Skip if out of bounds\n\n          # Check if this (position, direction) state has already been visited\n          if next_state_tuple in visited:\n              continue # Skip if already visited\n\n          # Check if the next position is walkable\n          # A cell is walkable if it does not contain any non-walkable entity (e.g., boundary, water, workshops).\n          is_walkable = True\n          for kind_idx in non_walkable_kinds_indices:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          # Also, the agent cannot walk directly onto the target primitive itself;\n          # it needs to be adjacent to it to 'USE' it.\n          if initial_grid[next_r, next_c, primitive_id] > 0:\n              is_walkable = False\n          \n          if is_walkable:\n              visited.add(next_state_tuple)\n              queue.append((next_state_tuple, path_actions + [action_type]))\n\n  # If a valid path leading to a state where the agent is adjacent to and facing the primitive was found,\n  # append the 'USE' action to complete the collection sequence.\n  if target_path_to_adjacent_facing_primitive is not None:\n      actions_list.extend(target_path_to_adjacent_facing_primitive)\n      actions_list.append(ACTION_USE)\n\n  return actions_list", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T07:36:06.288349", "function_name": "collect", "function_body": "  actions_list = [] # List to store the sequence of actions\n  current_state = env._current_state # Get the current state of the environment\n  \n  # Extract relevant initial state information from the current state\n  initial_grid = current_state.grid # The grid layout\n  initial_pos = current_state.pos # Agent's starting position (row, column tuple)\n  initial_dir = current_state.dir # Agent's starting direction (int: 0=RIGHT, 1=UP, 2=LEFT, 3=DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook's index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Get grid dimensions (assuming WIDTH is rows, HEIGHT is columns based on CraftScenario grid shape)\n  GRID_ROWS, GRID_COLS, _ = initial_grid.shape \n\n  # --- Pre-computation and Checks for Robustness ---\n\n  # 1. Critical Check: Ensure the primitive is actually grabbable.\n  # The `collect` function's intent is to pick up an item into inventory using the 'USE' action.\n  # If the item's ID is not in `current_state.world.grabbable_indices` (e.g., it's a `WORKSHOP`, `WATER`, or `BOUNDARY`),\n  # it cannot be collected in this manner.\n  if primitive_id not in current_state.world.grabbable_indices:\n      return [] # Uncollectable item, return an empty action list\n\n  # 2. Retrieve action mapping from the environment's action specifications.\n  # This ensures we use the correct integer IDs for actions as defined by the `CraftLab` environment.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # 'UP' action is generally interpreted as moving forward\n  TURN_LEFT_ACTION = action_map['LEFT']     # Turn 90 degrees left\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Turn 90 degrees right\n  USE_ACTION = action_map['USE']            # Interact with adjacent cells, used for collecting items\n\n  # 3. Define direction vectors for movement and turning rules.\n  # `DIR_TO_DRDC` maps the agent's integer direction (0-3) to a (delta_row, delta_col) tuple\n  # representing the change in coordinates when the agent moves one step forward.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT (0): move to (row, col+1)\n      1: (-1, 0),  # Facing UP (1): move to (row-1, col)\n      2: (0, -1),  # Facing LEFT (2): move to (row, col-1)\n      3: (1, 0)    # Facing DOWN (3): move to (row+1, col)\n  }\n\n  # `TURN_LEFT_MAP` and `TURN_RIGHT_MAP` define how the agent's direction changes after a turn.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # R(0) -> U(1) -> L(2) -> D(3) -> R(0)\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # R(0) -> D(3) -> L(2) -> U(1) -> R(0)\n\n  # 4. Identify non-walkable entities. These are typically non-grabbable items that also block agent movement.\n  # We assume all items listed in `current_state.world.non_grabbable_indices` cannot be walked through.\n  non_walkable_kind_indices = current_state.world.non_grabbable_indices\n\n  # 5. Optimization: If the primitive is already within the 3x3 neighborhood of the agent's current position,\n  # no pathfinding is needed. We can immediately perform the 'USE' action.\n  # `CraftState.next_to()` is a convenient method for this check.\n  if current_state.next_to(primitive_id):\n      return [USE_ACTION]\n\n  # --- Breadth-First Search (BFS) for Shortest Path ---\n  # The BFS queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_this_state)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # The 'visited' set keeps track of (position_tuple, direction_int) pairs that have already been\n  # explored. This prevents redundant computations and ensures that the shortest path in terms of\n  # actions is found.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # This variable will store the found sequence of actions once a goal is reached\n\n  # BFS Loop: Continues as long as there are states (positions + directions) to explore\n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      r, c = current_pos # Unpack current row and column coordinates\n\n      # --- Goal Condition Check for BFS ---\n      # Check if the target primitive is within the 3x3 neighborhood of the agent's current (r, c).\n      # This is the \"goal\" state for our BFS: when the agent is in a position to `USE` the primitive.\n      is_primitive_adjacent = False\n      for dr_check in [-1, 0, 1]: # Iterate over rows in the 3x3 neighborhood (relative to agent)\n          for dc_check in [-1, 0, 1]: # Iterate over columns in the 3x3 neighborhood\n              check_r, check_c = r + dr_check, c + dc_check # Calculate absolute coordinates of the neighbor cell\n\n              # Ensure the neighbor cell is within grid boundaries AND contains the target primitive\n              if (0 <= check_r < GRID_ROWS and 0 <= check_c < GRID_COLS and\n                  initial_grid[check_r, check_c, primitive_id] > 0):\n                  is_primitive_adjacent = True # Primitive found in the current neighborhood\n                  break # Exit inner loop once primitive is found\n          if is_primitive_adjacent:\n              break # Exit outer loop once primitive is found\n\n      if is_primitive_adjacent:\n          target_path_actions = path_so_far # Shortest path to a collectable position found!\n          break # Terminate the BFS, as we've found the optimal path\n\n      # --- Explore All Possible Next Actions from the Current State ---\n      # For each possible action (Move Forward, Turn Left, Turn Right), calculate the resulting state\n      # and add it to the queue if it's valid and hasn't been visited before.\n\n      # 1. Try Move Forward (`MOVE_FORWARD_ACTION`)\n      move_dr, move_dc = DIR_TO_DRDC[current_dir] # Get the delta (row, col change) based on current direction\n      next_r, next_c = r + move_dr, c + move_dc # Calculate the potential next position\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # The agent's direction does not change when moving forward\n\n      # Check if the potential next position is valid (within grid bounds and the resulting (pos, dir) state hasn't been visited)\n      is_valid_move_forward = False\n      if (0 <= next_r < GRID_ROWS and 0 <= next_c < GRID_COLS and\n          (next_pos, next_dir) not in visited):\n          \n          # Additionally, check if the proposed `next_pos` cell is traversable.\n          # A cell is traversable if it's not occupied by any non-walkable obstacle.\n          is_walkable_cell = True\n          for kind_idx in non_walkable_kind_indices:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable_cell = False # The cell contains a blocking obstacle\n                  break # No need to check other non-walkable kinds\n          \n          # Note: Grabbable primitives (like WOOD, GRASS) are usually traversable, meaning the agent can walk onto their cells.\n          if is_walkable_cell:\n              is_valid_move_forward = True\n\n      if is_valid_move_forward:\n          visited.add((next_pos, next_dir)) # Mark the new state as visited\n          queue.append(((next_pos, next_dir), path_so_far + [MOVE_FORWARD_ACTION])) # Add the new state and path to the queue\n\n      # 2. Try Turn Left (`TURN_LEFT_ACTION`)\n      next_dir_left = TURN_LEFT_MAP[current_dir] # Calculate the new direction after turning left\n      # The agent's position does not change when turning.\n      if (current_pos, next_dir_left) not in visited:\n          visited.add((current_pos, next_dir_left)) # Mark the new state as visited\n          queue.append(((current_pos, next_dir_left), path_so_far + [TURN_LEFT_ACTION])) # Add the new state and path to the queue\n\n      # 3. Try Turn Right (`TURN_RIGHT_ACTION`)\n      next_dir_right = TURN_RIGHT_MAP[current_dir] # Calculate the new direction after turning right\n      # The agent's position does not change when turning.\n      if (current_pos, next_dir_right) not in visited:\n          visited.add((current_pos, next_dir_right)) # Mark the new state as visited\n          queue.append(((current_pos, next_dir_right), path_so_far + [TURN_RIGHT_ACTION])) # Add the new state and path to the queue\n\n  # --- Final Action Sequence Construction ---\n  # If a path to a collectable position was found during the BFS:\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions) # Append the sequence of movement/turn actions\n      actions_list.append(USE_ACTION) # Append the final 'USE' action to actually collect the primitive\n  # If `target_path_actions` remains None, it means the primitive is unreachable or not present,\n  # and in this case, `actions_list` will remain empty, which is the correct behavior.\n\n  return actions_list", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T07:36:07.414818", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (r, c)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  # Get the integer ID for the target primitive from the cookbook index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # === Crucial Check: Ensure the primitive is actually grabbable ===\n  # The 'collect' function implies picking up an item into inventory.\n  # If the primitive cannot be picked up (e.g., WORKSHOP, WATER, BOUNDARY),\n  # then it cannot be \"collected\" in the sense of adding to inventory.\n  # `current_state.world.grabbable_indices` is the authoritative source for this.\n  if primitive_id not in current_state.world.grabbable_indices:\n      return [] # Return empty list if the item is not grabbable\n\n  # Retrieve action mapping from the environment's action specifications\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP'] # 'UP' in action_specs often maps to 'move forward'\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  # This helps calculate the next position when moving forward from (r, c).\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: move to (r, c+1)\n      1: (-1, 0),  # Facing UP: move to (r-1, c)\n      2: (0, -1),  # Facing LEFT: move to (r, c-1)\n      3: (1, 0)    # Facing DOWN: move to (r+1, c)\n  }\n\n  # Maps for updating the agent's direction when turning left/right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0} # R -> U -> L -> D -> R\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # R -> D -> L -> U -> R\n\n  # Identify non-walkable entities (e.g., BOUNDARY, WATER, WORKSHOP_X) that block agent movement.\n  # These are directly obtained from `non_grabbable_indices` in CraftWorld.\n  non_walkable_kind_indices = current_state.world.non_grabbable_indices\n\n  # Optimization: If the primitive is already within the 3x3 neighborhood of the agent's current position,\n  # no pathfinding is needed; just perform the 'USE' action.\n  # `CraftState.next_to` directly checks this condition.\n  if current_state.next_to(primitive_id):\n      return [USE_ACTION]\n\n  # Initialize Breadth-First Search (BFS) for finding the shortest path in terms of actions.\n  # Each state in the queue is represented as:\n  # ((current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_this_state)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # The 'visited' set keeps track of (position_tuple, direction_int) pairs that have been\n  # explored to avoid redundant computations and cycles, ensuring the shortest path is found.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # This will store the sequence of actions to reach a collectable position\n\n  # BFS Loop\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # Check if the current agent position (r, c) is a \"goal\" state for collection.\n      # A goal state means the target `primitive_id` is within the 3x3 neighborhood of (r, c).\n      # This re-implements the logic of `CraftState.next_to` relative to the current BFS state.\n      is_primitive_adjacent = False\n      for dr_check in [-1, 0, 1]:\n          for dc_check in [-1, 0, 1]:\n              check_r, check_c = r + dr_check, c + dc_check\n              # Ensure the cell being checked is within grid bounds and contains the primitive.\n              if (0 <= check_r < WIDTH and 0 <= check_c < HEIGHT and\n                  initial_grid[check_r, check_c, primitive_id] > 0):\n                  is_primitive_adjacent = True\n                  break # Primitive found in neighborhood\n          if is_primitive_adjacent:\n              break # Stop checking once found\n\n      if is_primitive_adjacent:\n          target_path_actions = path_actions # Shortest path to a collectable position found!\n          break # Terminate BFS\n\n      # Explore all possible next actions from the current state: Move Forward, Turn Left, Turn Right\n\n      # 1. Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if the potential next position is within grid bounds AND this (pos, dir) state hasn't been visited\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT and\n          (next_pos, next_dir) not in visited):\n          \n          # Determine if the next cell (next_r, next_c) is walkable.\n          # A cell is considered walkable if it is not occupied by any entity\n          # categorized as a non-walkable obstacle (e.g., boundary, water, workshops).\n          is_walkable_cell = True\n          for kind_idx in non_walkable_kind_indices:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable_cell = False # Found a non-walkable obstacle\n                  break\n          \n          # Note: Grabbable primitives (e.g., WOOD, GRASS) are generally not considered obstacles for movement.\n          # The agent can typically walk onto their cells. This logic correctly allows that.\n\n          if is_walkable_cell:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # 2. Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning changes direction but not position.\n      if (current_pos, next_dir_left) not in visited:\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # 3. Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning changes direction but not position.\n      if (current_pos, next_dir_right) not in visited:\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path to a collectable position was found, append the 'USE' action to perform the collection.\n  # If `target_path_actions` remains None, it means the primitive is unreachable, and an empty list is returned.\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T07:37:32.333876", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Map the primitive name (string) to its internal integer ID using the world's cookbook index.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already present in the agent's inventory.\n  # If it is, the \"collection\" is already complete, so no actions are needed.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Perform a semantic check: Determine if this primitive is a type that can generally\n  # be collected via the 'USE' action. This typically includes grabbable items (like wood,\n  # iron, grass) and specific resources (like water, stone). Non-grabbable entities\n  # (e.g., workshops, boundaries) are not considered collectible in this context.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the target primitive is not designated as collectible through 'USE', return an empty path.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define numerical action codes from the environment's action specifications\n  # and spatial deltas for calculating positions relative to the agent's direction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) tuple, indicating the grid cell directly in front.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: Decreases row (moves North)\n      1: (0, 1),  # RIGHT: Increases col (moves East)\n      2: (1, 0),  # DOWN: Increases row (moves South)\n      3: (0, -1)  # LEFT: Decreases col (moves West)\n  }\n\n  # Helper function to compute the shortest sequence of turning actions (LEFT/RIGHT)\n  # required to change the agent's current direction to a target direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling the circular nature of directions (0-3).\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive turns in the same direction (e.g., two RIGHT_ACTs) achieve this.\n          return [RIGHT_ACT, RIGHT_ACT]\n\n  # 5. Initialize Breadth-First Search (BFS) data structures.\n  q = collections.deque() # The queue for BFS, storing (CraftState, path_taken_to_reach_this_state).\n  \n  # The `visited` set tracks unique states that have already been explored.\n  # A state is defined by the agent's (row, col, direction) AND its current inventory.\n  # The inventory (a numpy.ndarray) is converted to a tuple to make it hashable for the set.\n  visited = set()\n\n  # Add the initial state of the environment to the queue and mark it as visited.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  # Get grid dimensions for boundary checks and to set a heuristic limit for explored states.\n  grid_width, grid_height, _ = current_state.grid.shape\n  # `MAX_EXPLORED_STATES` is a heuristic limit to prevent the BFS from consuming excessive\n  # computational resources in very large or complex scenarios, especially when numerous\n  # inventory permutations might be possible for a given position and direction.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 20 # 4 directions, *20 for rough inventory states\n  explored_states_count = 0\n\n  # 6. BFS Loop: Continue as long as there are states in the queue to explore.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path of actions taken to reach it.\n    explored_states_count += 1\n\n    # Pruning: If the number of explored unique states exceeds the defined limit, skip further expansion\n    # from this branch to manage performance.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Determine if the target primitive (`i_kind`) can be collected from the current `state`.\n    # First, check if the primitive is within the agent's immediate 3x3 neighborhood.\n    if state.next_to(i_kind):\n        # If the primitive is nearby, iterate through all four possible agent orientations (UP, RIGHT, DOWN, LEFT)\n        # to find if facing a specific direction allows interaction with the primitive.\n        for target_dir in range(4): \n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Verify that the cell directly in front (when facing `target_dir`) is within grid bounds\n            # and specifically contains an instance of the target primitive (`i_kind`).\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Calculate the sequence of turning actions needed to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                # Apply each turn action to simulate the agent's orientation change.\n                for turn_action in turns_to_face:\n                    # Reward is disregarded during pathfinding, focus is on state transition.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store the inventory state *before* attempting the 'USE' action.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action. This is the attempt to collect the primitive.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical validation: Check if the 'USE' action successfully increased the count\n                # of the target primitive in the inventory. This confirms actual collection,\n                # accounting for any underlying game rules (e.g., requiring a specific tool).\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    # If collected successfully, return the complete sequence of actions.\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore non-goal-specific actions to find new states and paths:\n\n    # A. Explore all possible movement actions (UP, DOWN, LEFT, RIGHT).\n    for action in move_actions:\n      _, next_state = state.step(action) # Simulate the action to get the next state.\n      next_inventory_tuple = tuple(next_state.inventory)\n      # Create a unique key for the next state, including position, direction, and inventory.\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      # If this next state has not been visited before, add it to the queue for future exploration.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # B. Explore a general 'USE' action from the current position.\n    # This is vital because 'USE' might activate a workshop, pick up an unrelated item (e.g., a tool),\n    # or perform some interaction that changes the environment or inventory in a way\n    # that enables future collection of the target primitive.\n    inventory_before_any_use = np.copy(state.inventory) # Capture inventory before this general USE.\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Only add the state resulting from this general 'USE' action if it caused a meaningful change.\n    # A change is considered meaningful if the inventory, agent's position, or direction changed.\n    # This prevents adding redundant states to the queue where 'USE' had no discernible effect.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue becomes empty and the target primitive has not been collected,\n  # it implies that there is no reachable path from the initial state that leads to its collection.\n  return []", "island_id": 8, "scores": {"3": 1.5}}
