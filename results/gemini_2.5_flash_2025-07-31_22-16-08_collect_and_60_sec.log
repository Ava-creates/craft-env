e.get(primitive.lower())\n      \n      if source_entity_name:\n          try:\n              i_kind_source = world.cookbook.index[source_entity_name]\n          except KeyError:\n              # The source entity (e.g., 'tree') itself is not recognized in the cookbook index.\n              # This means either the environment does not contain this source or the mapping is incorrect.\n              return []\n      else:\n          # If it's not a direct grabbable/resource AND no specific source entity mapping exists,\n          # then this primitive is not collectible via a simple 'USE' action on the grid \n          # (e.g., it's a workshop, boundary, or exclusively craftable).\n          return []\n\n  # If i_kind_source is still invalid after all checks, it means the primitive cannot be collected.\n  if i_kind_source == -1:\n      return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set includes the agent's inventory as part of the state key,\n  # as inventory changes can open up new possibilities (e.g., gaining a tool).\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  \n  # Dynamically scale MAX_EXPLORED_STATES based on the grid size and number of unique item kinds.\n  # This provides a more robust exploration limit than a fixed constant.\n  # A factor of (1 + len(world.cookbook.kinds)) accounts for increased state space complexity due to inventory.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * (1 + len(world.cookbook.kinds)) \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check 1: Is the 'source' entity (i_kind_source) at the agent's current position?\n    # This covers cases like picking up a loose item.\n    if state.grid[current_r, current_c, i_kind_source] == 1:\n        inventory_before_use_on_self = np.copy(state.inventory)\n        _, state_after_use_on_self = state.step(USE_ACT)\n        \n        # Verify successful collection: check if the *target primitive's* count increased in inventory.\n        # This is crucial because using on a source might produce the target, or something else.\n        if state_after_use_on_self.inventory[i_kind_target] > inventory_before_use_on_self[i_kind_target]:\n            return path + [USE_ACT] # Collected by using at current position\n\n    # Goal Check 2: Is the 'source' entity (i_kind_source) in an adjacent cell?\n    # Iterate through cardinal directions to find the specific cell containing the source entity.\n    # state.next_to(i_kind_source) provides a quick check, but we need to find the specific cell\n    # and orient towards it.\n    for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n        dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n        facing_r, facing_c = current_r + dr, current_c + dc\n\n        # Ensure facing cell is within grid bounds and contains the target source entity\n        if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n            state.grid[facing_r, facing_c, i_kind_source] == 1):\n            \n            # Simulate the turning actions required to face the source entity.\n            temp_state_after_turns = state \n            turns_to_face = _get_turning_actions(current_dir, target_dir)\n            for turn_action in turns_to_face:\n                _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n            # Store inventory before attempting USE to verify collection.\n            inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n            # Simulate the 'USE' action on the cell in front.\n            _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n            # Critical check: Did the count of the *target primitive* in inventory actually increase?\n            # This verifies successful collection, accounting for any internal game rules\n            # (e.g., requiring tools, or multiple uses) implemented in `CraftState.step`.\n            if state_after_use.inventory[i_kind_target] > inventory_before_use[i_kind_target]:\n                return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the USE action from the current position generally.\n    # This is important if using an item at the current position (e.g., picking up a tool,\n    # or interacting with a workshop) changes the inventory state. Such changes might be\n    # necessary for later steps to collect the *target* primitive.\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if the USE action resulted in a meaningful state change (inventory, position, or direction).\n    # This prevents adding redundant states to the queue if USE had no effect.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T08:07:47.837381", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` by refining the source entity identification and consolidating goal-checking logic for clarity and potential robustness.\n    \n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect.\n\n    Returns:\n        List[int]: A sequence of action indices to execute.\n  \"\"\"\n  current_state = env._current_state\n  world = env.world\n\n  # 1. Determine the integer ID of the primitive we ultimately want to collect.\n  try:\n    i_kind_target = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized in the world's index, it cannot be collected.\n    return []\n\n  # 2. Early exit: If the target primitive is already in the agent's inventory, no actions are needed.\n  if current_state.inventory[i_kind_target] > 0:\n      return []\n\n  # 3. Identify the 'source' entity (grid kind) that needs to be interacted with\n  # on the grid to obtain the target primitive. This is a crucial semantic step.\n  i_kind_source = -1 # Initialize with an invalid value\n\n  # Specific mappings for primitives that are gathered from distinct grid entities (e.g., 'wood' from 'tree').\n  # This mapping captures domain knowledge about the CraftWorld environment's gathering mechanics.\n  primitive_to_source_entity_name = {\n      \"wood\": \"tree\",\n      \"iron\": \"iron_ore\",\n      \"grass\": \"grass_block\", \n      \"gold\": \"gold_ore\",\n      \"gem\": \"gem_ore\",\n  }\n  source_entity_name = primitive_to_source_entity_name.get(primitive.lower())\n  \n  if source_entity_name:\n      try:\n          # Get the ID of the source entity that appears on the grid.\n          i_kind_source = world.cookbook.index[source_entity_name]\n      except KeyError:\n          # The designated source entity (e.g., 'tree') is not found in the world's index.\n          # This indicates a misconfiguration or a missing entity.\n          return []\n  elif i_kind_target in world.grabbable_indices:\n      # If the target primitive itself is directly grabbable (can be picked up).\n      # In this case, the source entity on the grid is the primitive itself.\n      i_kind_source = i_kind_target\n  elif i_kind_target == world.water_index:\n      # Special handling for 'water', which is typically a specific grid block.\n      i_kind_source = world.water_index\n  elif i_kind_target == world.stone_index:\n      # Special handling for 'stone', which is typically a specific grid block.\n      i_kind_source = world.stone_index\n  else:\n      # If the primitive doesn't fit any of the above categories, it's not collectible\n      # via a simple 'USE' action on a grid entity using this function's logic.\n      return []\n\n  # If `i_kind_source` is still invalid, it means we couldn't determine a collectable source.\n  if i_kind_source == -1:\n      return []\n\n  # 4. Define action integer IDs and helpers for movement/interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # Maps agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT) to (row_change, col_change)\n  # for the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      diff = (target_dir - current_dir + 4) % 4 # Ensure difference is positive and within 0-3\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP to RIGHT)\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP to LEFT)\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP to DOWN)\n          return [RIGHT_ACT, RIGHT_ACT] # Two consecutive turns in the same direction\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set tracks (row, col, direction, inventory_tuple) to prevent cycles\n  # and redundant exploration of states. Inventory is included because collecting\n  # a tool might open up new possibilities.\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Heuristic limit for explored states to prevent excessive runtime.\n  # This limit balances search completeness with practical performance.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 30 # Increased slightly for more complex scenarios\n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If the number of explored states exceeds the limit, skip further expansion from this path.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # --- Goal Check: Find and collect the source entity ---\n    # Attempt to collect the primitive by interacting with the identified source entity.\n    # This involves checking the agent's current position and its immediate cardinal surroundings.\n\n    potential_target_interactions = [] # List of (target_position, required_facing_direction_for_interaction)\n\n    # Case A: Source entity is at the agent's current position.\n    if state.grid[current_r, current_c, i_kind_source] == 1:\n        # For items collected by standing on them (e.g., some grabbables), no turning is needed.\n        # The agent is effectively \"facing\" itself.\n        potential_target_interactions.append(((current_r, current_c), current_dir)) \n    \n    # Case B: Source entity is in an adjacent cell.\n    # Check all four cardinal directions (UP, RIGHT, DOWN, LEFT) from the agent's current position.\n    for target_dir in range(4): \n        dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n        adj_r, adj_c = current_r + dr, current_c + dc\n\n        # Ensure the adjacent cell is within grid bounds and contains the source entity.\n        if (0 <= adj_r < grid_width and 0 <= adj_c < grid_height and \n            state.grid[adj_r, adj_c, i_kind_source] == 1):\n            \n            # If found, add this target interaction: the cell's position and the direction the agent needs to face.\n            potential_target_interactions.append(((adj_r, adj_c), target_dir))\n\n    # Iterate through all identified potential interactions for collection.\n    for _, required_face_dir in potential_target_interactions:\n        # Simulate the turning actions required to face the source entity.\n        temp_state_after_turns = state \n        turns_to_face = _get_turning_actions(current_dir, required_face_dir)\n        for turn_action in turns_to_face:\n            _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n        # Store inventory before attempting 'USE' to accurately verify collection.\n        inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n        # Simulate the 'USE' action on the cell in front (which now contains the source entity).\n        _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n        # CRITICAL VERIFICATION: Check if the count of the *target primitive* in inventory actually increased.\n        # This confirms successful collection and implicitly accounts for internal game rules\n        # such as requiring a specific tool (if the tool wasn't available, the count wouldn't increase).\n        if state_after_use.inventory[i_kind_target] > inventory_before_use[i_kind_target]:\n            return path + turns_to_face + [USE_ACT] # Found a successful collection path!\n\n    # --- Explore next states by taking available actions ---\n    # Explore possible movement actions (UP, DOWN, LEFT, RIGHT).\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory) # Convert inventory to tuple for hashing in 'visited' set\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      # If this next state has not been visited before, add it to the queue.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the general 'USE' action from the current position.\n    # This is important for scenarios where using an item at the current spot (e.g., picking up a tool,\n    # or interacting with a workshop) changes the state (especially inventory) in a way that enables\n    # future steps to collect the *target* primitive.\n    inventory_before_general_use = np.copy(state.inventory)\n    _, state_after_general_use = state.step(USE_ACT)\n    \n    # Add to the queue only if the 'USE' action resulted in a meaningful state change.\n    # This prunes redundant states where 'USE' had no effect (e.g., using nothing in empty space).\n    if not (np.array_equal(state_after_general_use.inventory, inventory_before_general_use) and\n            state_after_general_use.pos == state.pos and\n            state_after_general_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_general_use.inventory)\n        next_state_key = (state_after_general_use.pos[0], state_after_general_use.pos[1], state_after_general_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_general_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is currently unreachable from the initial state given the explored conditions.\n  return []", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-08-01T08:07:48.963315", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the integer ID for the *target primitive* (what we want in inventory).\n  try:\n    i_kind_target = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized in the world's index, it cannot be collected.\n    return []\n\n  # 2. Early Exit: If the target primitive is already in the agent's inventory,\n  # no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind_target] > 0:\n      return []\n\n  # 3. Identify the *source entity* on the grid that yields the target primitive.\n  # This is the entity we need to find and interact with using the 'USE' action.\n  i_kind_source = -1 # Initialize with an invalid index\n\n  # Explicit mappings for primitives that come from specific grid entities.\n  # This list should be exhaustive for all 'collectible' primitives that aren't themselves directly grabbable.\n  # Example: 'wood' comes from 'tree', 'iron' from 'iron_ore', etc.\n  primitive_to_source_entity_name = {\n      \"wood\": \"tree\",\n      \"iron\": \"iron_ore\",\n      \"grass\": \"grass_block\", \n      \"rock\": \"rock\", # 'rock' primitive might be collected from a 'rock' entity\n      \"gold\": \"gold_ore\",\n      \"gem\": \"gem_ore\",\n      # Add other mappings if the environment contains more implicit resource sources.\n  }\n  \n  source_entity_name = primitive_to_source_entity_name.get(primitive.lower())\n\n  if source_entity_name:\n      try:\n          i_kind_source = world.cookbook.index[source_entity_name]\n      except KeyError:\n          # The source entity (e.g., 'tree') itself is not in the world's index.\n          # This implies the game world does not contain this source.\n          return []\n  elif i_kind_target in world.grabbable_indices:\n      # If the target primitive itself is directly grabbable (can be picked up\n      # by standing on it or using 'USE' next to it, like a tool or crafted item).\n      i_kind_source = i_kind_target\n  elif i_kind_target == world.water_index:\n      # Special case for \"water\" which is its own source.\n      i_kind_source = world.water_index\n  elif i_kind_target == world.stone_index:\n      # Special case for \"stone\" which is its own source.\n      i_kind_source = world.stone_index\n  \n  # If after all checks, we still don't have a valid source kind, this primitive\n  # cannot be collected by finding an entity on the grid and using 'USE'.\n  # It might be an environment entity (like a workshop or boundary) or purely craftable.\n  if i_kind_source == -1:\n      return []\n\n  # 4. Define action integers and direction deltas.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # Delta coordinates for facing cardinal directions.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (North)\n      1: (0, 1),  # RIGHT: row, col + 1 (East)\n      2: (1, 0),  # DOWN: row + 1, col (South)\n      3: (0, -1)  # LEFT: row, col - 1 (West)\n  }\n\n  # Helper function to compute turning actions (Left/Right) to face a target direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return []\n      \n      diff = (target_dir - current_dir + 4) % 4\n      if diff == 1: # Clockwise turn (e.g., UP to RIGHT)\n          return [RIGHT_ACT]\n      elif diff == 3: # Counter-clockwise turn (e.g., UP to LEFT)\n          return [LEFT_ACT]\n      else: # diff == 2, 180-degree turn\n          return [RIGHT_ACT, RIGHT_ACT] # Two rights or two lefts\n\n  # 5. Initialize Breadth-First Search (BFS) for pathfinding.\n  q = collections.deque()\n  # `visited` set stores a tuple (row, col, direction, inventory_hash).\n  # Inventory is hashed to a tuple for hashability and to distinguish states\n  # where inventory changes (e.g., picking up a tool makes an action possible).\n  visited = set()\n\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, [])) # (current_state_object, list_of_actions_to_reach_this_state)\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Heuristic limit on explored states to prevent excessive runtime.\n  # Multiplied by 4 (directions) and 20 (rough multiplier for inventory states).\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 20 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Get the next state to explore and the path leading to it\n    explored_states_count += 1\n\n    # Pruning: Stop if the search explores too many unique states.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check A: Is the *source entity* directly at the agent's current position?\n    # This applies if `i_kind_source` is a grabbable item that can be picked up\n    # by standing on it (common in some grid-based games).\n    if state.grid[current_r, current_c, i_kind_source] == 1:\n        inventory_before_use = np.copy(state.inventory)\n        _, state_after_use = state.step(USE_ACT) # Simulate using action at current spot\n        \n        # Did collecting the source entity increase the *target primitive* count?\n        if state_after_use.inventory[i_kind_target] > inventory_before_use[i_kind_target]:\n            return path + [USE_ACT] # Found a path!\n\n    # Goal Check B: Is the *source entity* in an adjacent cell (cardinal directions)?\n    # We iterate through all 4 cardinal directions and check the cell in front.\n    for target_dir in range(4): \n        dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n        facing_r, facing_c = current_r + dr, current_c + dc\n\n        # Ensure the cell is within grid bounds and contains the `i_kind_source`.\n        if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n            state.grid[facing_r, facing_c, i_kind_source] == 1):\n            \n            # Calculate and append turning actions to face the source.\n            turns_to_face = _get_turning_actions(current_dir, target_dir)\n            temp_state_after_turns = state\n            for turn_action in turns_to_face:\n                _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n            # Store inventory before attempting USE to verify collection.\n            inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n            # Simulate the 'USE' action on the cell in front.\n            _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n            # Critical verification: Did the *target primitive* count increase?\n            # This handles implicit game mechanics like tool requirements.\n            if state_after_use.inventory[i_kind_target] > inventory_before_use[i_kind_target]:\n                return path + turns_to_face + [USE_ACT] # Found a path!\n\n    # Explore possible next states by taking available actions.\n\n    # 1. Try movement actions (UP, DOWN, LEFT, RIGHT).\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # 2. Try the 'USE' action from the current position.\n    # This is crucial even if it doesn't directly yield the primitive, as it might\n    # pick up a tool, open a container, or change the environment in a way\n    # that enables future collection actions.\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Only add to queue if USE had a meaningful effect (inventory, position, or direction changed).\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is currently unreachable under the defined search constraints.\n  return []", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-08-01T08:08:51.014427", "function_name": "collect", "function_body": "  \"\"\"Returns a list of actions to find and collect the primitive in the passed env.\n    \n    This is an improved version of `collect_v1`, further refining the search logic\n    and ensuring robust pathfinding for collecting primitive resources or interacting\n    with workshops.\n\n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect (e.g., \"WOOD\", \"WATER\", \"WORKSHOP0\").\n\n    Returns:\n        List[int]: A sequence of action indices to execute to collect the primitive.\n                   Returns an empty list if the primitive is already in inventory\n                   or if no path to the primitive is found.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state\n  \n  # Get the integer ID for the target primitive from the cookbook index.\n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  # Early exit: If the primitive is already in the agent's inventory, no actions are needed.\n  if current_state.inventory[primitive_id] > 0:\n      return []\n\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's starting position (row, column)\n  initial_dir = current_state.dir # Agent's starting direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # Get action mappings from the environment's action specifications.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP'] # 'UP' typically means moving forward relative to agent's direction.\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for changing row and column based on agent's facing direction.\n  # Used to calculate the cell directly in front or the next position when moving forward.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT (positive column change)\n      1: (-1, 0),  # Facing UP (negative row change)\n      2: (0, -1),  # Facing LEFT (negative column change)\n      3: (1, 0)    # Facing DOWN (positive row change)\n  }\n\n  # Maps for updating agent's direction after turning left or right.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Identify all entity kinds that inherently block movement (e.g., BOUNDARY, WATER, WORKSHOP_X).\n  # These are defined as \"non-grabbable\" in the CraftWorld configuration.\n  non_grabbable_kinds_set = current_state.world.non_grabbable_indices\n\n  # Define the complete set of entity kinds that block agent movement into a cell.\n  # This includes `non_grabbable_kinds_set` and the `primitive` itself if it's a collectible\n  # resource (e.g., WOOD, STONE), as the agent should stand *adjacent* to collect, not *on*.\n  # If the primitive is already a non-grabbable (like a workshop), adding it again has no effect.\n  blocking_kinds_for_movement = set(non_grabbable_kinds_set)\n  if primitive_id not in blocking_kinds_for_movement:\n      blocking_kinds_for_movement.add(primitive_id)\n  \n  # Convert the set to a list for efficient NumPy array indexing during grid cell checks.\n  blocking_kinds_for_movement_list = list(blocking_kinds_for_movement)\n\n  # Initialize Breadth-First Search (BFS) structures:\n  # queue: stores ( (current_position_tuple, current_direction_int), list_of_actions_to_reach_here )\n  # visited: stores (position_tuple, direction_int) pairs to prevent redundant exploration and cycles.\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # This will store the sequence of actions if a path to the primitive is found.\n\n  # BFS loop to find the shortest path.\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos # Current row and column of the agent.\n\n      # 1. Goal Check: Determine if the target primitive is directly in front of the agent.\n      # Calculate the coordinates of the cell directly in front of the agent.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the front cell is within the grid boundaries.\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          # Check if the front cell contains the primitive we are looking for.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path_actions = path_actions # Path found! Store the actions.\n              break # Exit BFS, as we found the shortest path to an adjacent position.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n      \n      # Try Move Forward action:\n      # Calculate the next position if the agent moves forward.\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change the agent's facing direction.\n\n      # Check if the next position is within grid boundaries.\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT):\n          # Check if this specific (position, direction) state has not been visited yet.\n          if (next_pos, next_dir) not in visited:\n              # Check if the next position is walkable. A cell is not walkable if it contains any\n              # of the blocking kinds (e.g., boundary, water, workshop, or the primitive itself if collectible).\n              # np.any will return True if any of the specified kind indices have a count > 0 at that cell.\n              is_walkable = not np.any(initial_grid[next_r, next_c, blocking_kinds_for_movement_list] > 0)\n              \n              if is_walkable:\n                  visited.add((next_pos, next_dir)) # Mark this state as visited.\n                  # Add the new state to the queue with the updated path of actions.\n                  queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left action:\n      # Calculate the new direction after turning left. Position remains unchanged.\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Check if this (current_position, new_direction) state has not been visited.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left)) # Mark as visited.\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right action:\n      # Calculate the new direction after turning right. Position remains unchanged.\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Check if this (current_position, new_direction) state has not been visited.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right)) # Mark as visited.\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # After BFS completes:\n  # If a path was found (i.e., target_path_actions is not None), append the final USE action.\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 1, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T08:08:52.310384", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n    \n    This version builds upon the robust pathfinding and blocking logic established\n    in `collect_v1`. It ensures the agent finds a path to a cell adjacent to the\n    target primitive and then uses the 'USE' action to collect it.\n    \n    Refinements include:\n    - **Early Exit**: If the primitive is already in the inventory, no actions are needed.\n    - **Robust Walkability Check**: Properly identifies cells that block movement\n      (e.g., boundaries, water, and the primitive itself if it's a collectible resource).\n    - **BFS for Shortest Path**: Employs a Breadth-First Search to find the\n      shortest sequence of movements and turns to position the agent correctly.\n    - **Consistent Interaction**: Ensures the agent is positioned directly\n      adjacent to the primitive, facing it, before executing the 'USE' action,\n      which is the standard interaction mechanism for both collectible resources\n      (like WOOD) and interactive points (like WORKSHOPs).\n\n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect.\n\n    Returns:\n        List[int]: A sequence of action indices to execute.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state\n  \n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  # Optimization: If the primitive is already in inventory, no actions are needed.\n  if current_state.inventory[primitive_id] > 0:\n      return []\n\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (r, c)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  action_map = env.action_specs()\n  # Map DSL movement/turn actions to their integer indices from action_specs\n  # 'UP' is typically interpreted as moving forward relative to agent's direction.\n  MOVE_FORWARD_ACTION = action_map['UP'] \n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  # This defines how position changes when moving \"forward\" in a given direction.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT (positive column, X-axis)\n      1: (-1, 0),  # Facing UP (negative row, Y-axis)\n      2: (0, -1),  # Facing LEFT (negative column, X-axis)\n      3: (1, 0)    # Facing DOWN (positive row, Y-axis)\n  }\n\n  # Map for turning left/right, updating the agent's direction (0-3)\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Prepare the set of kinds that inherently block movement (e.g., BOUNDARY, WATER, WORKSHOP_X).\n  # These are \"non-grabbable\" items according to CraftWorld's definition and cannot be walked through.\n  non_grabbable_kinds_set = current_state.world.non_grabbable_indices\n\n  # Define all blocking kinds for movement into a cell.\n  # This includes inherently non-grabbable items AND the primitive itself (agent cannot walk ONTO the primitive\n  # if it's a collectible resource like WOOD or STONE; it must stand adjacent to it).\n  blocking_kinds_for_movement = set(non_grabbable_kinds_set)\n  # If the target primitive is a grabbable resource (e.g., WOOD, STONE), it should also block movement onto its cell.\n  # If it's already non-grabbable (e.g., WORKSHOP0), it's already in the set.\n  if primitive_id not in blocking_kinds_for_movement:\n      blocking_kinds_for_movement.add(primitive_id)\n  \n  # Convert the set to a list for efficient NumPy array indexing.\n  blocking_kinds_for_movement_list = list(blocking_kinds_for_movement)\n\n  # BFS state: ((row, col), direction), path_actions\n  # Queue stores ( (current_pos_tuple, current_dir_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (current_pos_tuple, current_dir_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # Stores the action list to reach the target state\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Goal Check: Is the primitive directly in front of the agent at the current state?\n      # Calculate the coordinates of the cell directly in front.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the front_cell is within grid bounds.\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          # Check if the front_cell contains the primitive.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path_actions = path_actions\n              break # Path to target found (agent is adjacent and facing the primitive).\n\n      # 2. Explore possible next actions: Move Forward, Turn Left, Turn Right.\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction.\n\n      # Check if next_pos is within bounds.\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT):\n          # Check if this (position, direction) state hasn't been visited to avoid redundant paths.\n          if (next_pos, next_dir) not in visited:\n              # Check if the next_pos contains any blocking kind using NumPy's any function.\n              # If np.any returns True, it means at least one blocking kind is present, so the cell is not walkable.\n              if not np.any(initial_grid[next_r, next_c, blocking_kinds_for_movement_list] > 0):\n                  visited.add((next_pos, next_dir))\n                  queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path was found, append the USE action to the sequence.\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 1, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T08:09:34.349341", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  world = current_state.world\n  grid = current_state.grid\n  initial_pos = current_state.pos  # Agent's starting (row, col)\n  initial_dir = current_state.dir  # Agent's starting direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook index\n  primitive_id = world.cookbook.index[primitive]\n  grid_height, grid_width, _ = grid.shape\n\n  # Map DSL action names to their corresponding integer IDs from the environment's action_specs\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']   # 'UP' typically means move forward in current facing direction\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define changes in (row, col) for each direction when moving forward\n  # Direction 0: Right (+col), 1: Up (-row), 2: Left (-col), 3: Down (+row)\n  DRDC_FOR_DIR = {\n      0: (0, 1),   # Facing RIGHT: (row, col + 1)\n      1: (-1, 0),  # Facing UP: (row - 1, col)\n      2: (0, -1),  # Facing LEFT: (row, col - 1)\n      3: (1, 0)    # Facing DOWN: (row + 1, col)\n  }\n\n  # Define how direction changes when turning left or right\n  NEXT_DIR_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # e.g., Right (0) -> Up (1)\n  NEXT_DIR_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # e.g., Right (0) -> Down (3)\n\n  # Identify entity kinds that block agent movement (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  non_walkable_kind_ids = world.non_grabbable_indices\n\n  # Use Breadth-First Search (BFS) to find the shortest sequence of actions.\n  # BFS queue stores: ((current_position_tuple, current_direction_int), list_of_actions_to_reach_here)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # Visited set stores: (position_tuple, direction_int) to prevent redundant exploration and cycles.\n  visited = set()\n  visited.add((initial_pos, initial_dir))\n\n  # This variable will store the action sequence to reach the state where the agent is\n  # adjacent to the primitive and facing it, *before* applying the USE action.\n  path_to_primitive_location = None \n\n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      current_r, current_c = current_pos\n\n      # Check if the primitive is in the cell directly in front of the agent.\n      # This is the \"goal\" condition for the BFS: agent is ready to USE the primitive.\n      dr_front, dc_front = DRDC_FOR_DIR[current_dir]\n      front_r, front_c = current_r + dr_front, current_c + dc_front\n      \n      # Ensure the front cell is within grid boundaries\n      if (0 <= front_r < grid_height and 0 <= front_c < grid_width):\n          # If the primitive is found in the cell directly in front, we have reached our target state.\n          if grid[front_r, front_c, primitive_id] > 0:\n              path_to_primitive_location = path_so_far\n              break # Found the shortest path, no need to explore further in this branch.\n\n      # Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right\n      \n      # Option 1: Try to Move Forward\n      next_r_move, next_c_move = current_r + DRDC_FOR_DIR[current_dir][0], current_c + DRDC_FOR_DIR[current_dir][1]\n      next_pos_move = (next_r_move, next_c_move)\n      next_dir_move = current_dir # Direction does not change when moving forward\n\n      # Check if the potential next position is within grid bounds.\n      if (0 <= next_r_move < grid_height and 0 <= next_c_move < grid_width):\n          # Determine if the next cell is walkable.\n          # An agent cannot walk onto non-grabbable items or onto the primitive itself.\n          is_walkable = True\n          if grid[next_r_move, next_c_move, primitive_id] > 0:\n              # Agent cannot walk onto the primitive itself, only adjacent to it.\n              is_walkable = False\n          else:\n              for kind_idx in non_walkable_kind_ids:\n                  if grid[next_r_move, next_c_move, kind_idx] > 0:\n                      is_walkable = False # Cannot walk onto other non-grabbable entities\n                      break\n          \n          # If walkable and this (position, direction) state hasn't been visited, add to queue.\n          if is_walkable and ((next_pos_move, next_dir_move) not in visited):\n              visited.add((next_pos_move, next_dir_move))\n              queue.append(((next_pos_move, next_dir_move), path_so_far + [MOVE_FORWARD_ACTION]))\n\n      # Option 2: Try to Turn Left\n      next_dir_left = NEXT_DIR_LEFT_MAP[current_dir]\n      next_pos_turn = current_pos # Position does not change when turning.\n      \n      # If this (position, direction) state hasn't been visited, add to queue.\n      if ((next_pos_turn, next_dir_left) not in visited):\n          visited.add((next_pos_turn, next_dir_left))\n          queue.append(((next_pos_turn, next_dir_left), path_so_far + [TURN_LEFT_ACTION]))\n\n      # Option 3: Try to Turn Right\n      next_dir_right = NEXT_DIR_RIGHT_MAP[current_dir]\n      \n      # If this (position, direction) state hasn't been visited, add to queue.\n      if ((next_pos_turn, next_dir_right) not in visited):\n          visited.add((next_pos_turn, next_dir_right))\n          queue.append(((next_pos_turn, next_dir_right), path_so_far + [TURN_RIGHT_ACTION]))\n\n  # If a path to being adjacent and facing the primitive was found, append the USE action\n  # and return the complete sequence. Otherwise, return an empty list.\n  if path_to_primitive_location is not None:\n      actions_list.extend(path_to_primitive_location)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 2, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T08:09:35.458755", "function_name": "collect", "function_body": "  actions_to_take = []\n  current_craft_state = env._current_state\n  world_config = current_craft_state.world\n  \n  # Extract relevant state information\n  initial_grid = current_craft_state.grid\n  initial_pos = current_craft_state.pos  # Agent's current position (row, col)\n  initial_dir = current_craft_state.dir  # Agent's current facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook index\n  primitive_id = world_config.cookbook.index[primitive]\n  \n  # Get grid dimensions\n  grid_rows, grid_cols, _ = initial_grid.shape\n\n  # Map symbolic action names to their integer IDs from the environment's action specifications\n  action_ids = env.action_specs()\n  MOVE_FORWARD = action_ids['UP']    # 'UP' action moves the agent in its current facing direction\n  TURN_LEFT = action_ids['LEFT']\n  TURN_RIGHT = action_ids['RIGHT']\n  USE_ACTION = action_ids['USE']\n\n  # Define how agent's (row, col) position changes when moving 'forward' based on direction\n  # (delta_row, delta_col) for each direction\n  DELTA_POS_FOR_DIR = {\n      0: (0, 1),   # Facing RIGHT: moves (r, c+1)\n      1: (-1, 0),  # Facing UP: moves (r-1, c)\n      2: (0, -1),  # Facing LEFT: moves (r, c-1)\n      3: (1, 0)    # Facing DOWN: moves (r+1, c)\n  }\n\n  # Define how agent's direction changes when turning left or right\n  NEXT_DIR_AFTER_LEFT_TURN = {0: 1, 1: 2, 2: 3, 3: 0} # e.g., Right (0) -> Up (1)\n  NEXT_DIR_AFTER_RIGHT_TURN = {0: 3, 1: 0, 2: 1, 3: 2} # e.g., Right (0) -> Down (3)\n\n  # Get indices of entities that block agent movement (e.g., boundaries, water, workshops)\n  unwalkable_entity_ids = world_config.non_grabbable_indices\n\n  # BFS state: ((current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_this_state)\n  # Queue for BFS exploration\n  bfs_queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # Set to keep track of visited (position, direction) states to avoid cycles and re-exploration\n  visited_states = set()\n  visited_states.add((initial_pos, initial_dir))\n\n  # Variable to store the shortest path found to the \"ready to use\" state\n  # This state is when the agent is adjacent to the primitive and facing it.\n  shortest_path_to_primitive_front = None\n\n  while bfs_queue:\n      (current_pos, current_dir), actions_so_far = bfs_queue.popleft()\n      current_r, current_c = current_pos\n\n      # --- Goal Check: Is the primitive directly in front of the agent? ---\n      dr_front, dc_front = DELTA_POS_FOR_DIR[current_dir]\n      cell_in_front_r, cell_in_front_c = current_r + dr_front, current_c + dc_front\n      \n      # Check if the cell in front is within grid boundaries\n      if (0 <= cell_in_front_r < grid_rows and 0 <= cell_in_front_c < grid_cols):\n          # If the primitive is present in the cell directly in front, we've found our target state.\n          # The agent is now in position to 'USE' the primitive.\n          if initial_grid[cell_in_front_r, cell_in_front_c, primitive_id] > 0:\n              shortest_path_to_primitive_front = actions_so_far\n              break # Shortest path found, terminate BFS.\n\n      # --- Explore Next Possible Actions (Move Forward, Turn Left, Turn Right) ---\n\n      # 1. Try to Move Forward\n      next_pos_after_move = (current_r + DELTA_POS_FOR_DIR[current_dir][0],\n                             current_c + DELTA_POS_FOR_DIR[current_dir][1])\n      next_dir_after_move = current_dir # Direction doesn't change when moving\n      \n      next_r_move, next_c_move = next_pos_after_move\n\n      # Check if the next position is within bounds and the new state hasn't been visited\n      if (0 <= next_r_move < grid_rows and 0 <= next_c_move < grid_cols and\n          (next_pos_after_move, next_dir_after_move) not in visited_states):\n          \n          # Determine if the next cell is walkable.\n          # The agent cannot walk onto cells containing unwalkable entities or onto the primitive itself.\n          is_next_cell_walkable = True\n          \n          # Cannot walk directly onto the primitive itself, as interaction happens from an adjacent cell.\n          if initial_grid[next_r_move, next_c_move, primitive_id] > 0:\n              is_next_cell_walkable = False\n          else: \n              # Check for other unwalkable entities (e.g., boundaries, water, workshops)\n              for kind_idx in unwalkable_entity_ids:\n                  if initial_grid[next_r_move, next_c_move, kind_idx] > 0:\n                      is_next_cell_walkable = False\n                      break\n          \n          if is_next_cell_walkable:\n              visited_states.add((next_pos_after_move, next_dir_after_move))\n              bfs_queue.append(((next_pos_after_move, next_dir_after_move), actions_so_far + [MOVE_FORWARD]))\n\n      # 2. Try to Turn Left\n      next_dir_after_left_turn = NEXT_DIR_AFTER_LEFT_TURN[current_dir]\n      # Turning only changes direction, not position\n      if ((current_pos, next_dir_after_left_turn) not in visited_states):\n          visited_states.add((current_pos, next_dir_after_left_turn))\n          bfs_queue.append(((current_pos, next_dir_after_left_turn), actions_so_far + [TURN_LEFT]))\n\n      # 3. Try to Turn Right\n      next_dir_after_right_turn = NEXT_DIR_AFTER_RIGHT_TURN[current_dir]\n      # Turning only changes direction, not position\n      if ((current_pos, next_dir_after_right_turn) not in visited_states):\n          visited_states.add((current_pos, next_dir_after_right_turn))\n          bfs_queue.append(((current_pos, next_dir_after_right_turn), actions_so_far + [TURN_RIGHT]))\n\n  # If a path was found to position the agent correctly, append the final USE action to collect the primitive\n  if shortest_path_to_primitive_front is not None:\n      actions_to_take.extend(shortest_path_to_primitive_front)\n      actions_to_take.append(USE_ACTION)\n\n  return actions_to_take", "island_id": 2, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T08:10:36.585208", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\"\"\"\n  \"\"\"Returns a list of actions to find and collect the primitive in the passed env.\n    \n    This version refines the state exploration within the BFS, ensuring efficiency\n    by relying solely on the `visited` set to manage unique states for movement\n    and `USE` actions. It maintains the crucial inventory-aware BFS for complex\n    collection paths that might require intermediate tool acquisition.\n\n    The primary improvement over collect_v1 is a more direct termination\n    of the BFS when the `MAX_EXPLORED_STATES` limit is reached, preventing\n    further wasteful computation once the search space is deemed too large.\n\n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect.\n\n    Returns:\n        List[int]: A sequence of action indices to execute.\n  \"\"\"\n  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set includes the agent's inventory as part of the state key.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing, allowing BFS to distinguish\n  # between states that are identical in position/direction but differ in inventory (e.g., having a tool vs. not).\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Heuristic limit for explored states to prevent excessive computation in very large or complex scenarios.\n  # The factor of 10 accounts for the additional state dimensions (direction, inventory).\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    # This is an improvement over v1, which used `continue`, potentially wasting cycles\n    # processing other states in the queue after the limit was effectively reached.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      return [] \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`).\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell in front is within bounds and contains the target primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    # _ is reward, which is always 0.0 for CraftState.step here.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the USE action from the current position.\n    # This is crucial for collecting intermediate items (like tools)\n    # that are not the target primitive but enable its collection.\n    # The `visited` set will inherently prevent adding redundant states\n    # where USE had no effect (as the state key wouldn't change).\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    next_inventory_tuple = tuple(state_after_current_use.inventory)\n    next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n    if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T08:10:38.159393", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n\n    This function implements a Breadth-First Search (BFS) to find the shortest\n    sequence of actions to collect a specified primitive item in the CraftLab\n    environment. It considers both movement and the 'USE' action, and is\n    robust enough to find paths that require intermediate tool collection\n    (e.g., collecting an axe before collecting wood).\n\n    Args:\n        env (env.CraftLab): The CraftLab object representing the current\n                            environment state.\n        primitive (str): The name of the primitive item to collect (e.g., \"wood\", \"iron\").\n\n    Returns:\n        List[int]: A sequence of action indices (integers) to execute to collect\n                   the primitive. Returns an empty list if the primitive is\n                   already in inventory, is not collectible, or cannot be\n                   reached/collected within the search limits.\n  \"\"\"\n  current_state = env._current_state\n  world = env.world\n\n  # 1. Obtain the integer ID for the primitive from the cookbook's index.\n  # This mapping is essential for interacting with the grid and inventory arrays.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized by the world's cookbook,\n    # it cannot be collected.\n    return []\n\n  # 2. Early exit: Check if the primitive is already in the agent's inventory.\n  # If so, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is something that can be\n  # collected via the 'USE' action. This excludes non-grabbable entities like\n  # workshops, boundaries, or bridges, which are not intended to be picked up\n  # and added to inventory. Water and Stone are special cases that are\n  # collectible but might not be in grabbable_indices.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not a collectible type via 'USE', a BFS search for it is\n  # irrelevant for this 'collect' function's purpose.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integer mappings and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: moves North (decreases row index)\n      1: (0, 1),  # RIGHT: moves East (increases column index)\n      2: (1, 0),  # DOWN: moves South (increases row index)\n      3: (0, -1)  # LEFT: moves West (decreases column index)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # required to change the agent's current direction to a target direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Agent is already facing the target direction\n      \n      # Calculate the difference in directions, handling the circular nature (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference and correctly\n      # wraps around for directions.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose two RIGHT_ACTs\n\n  # 5. Initialize Breadth-First Search (BFS) structures.\n  q = collections.deque()\n  # The 'visited' set is crucial for preventing redundant exploration and cycles.\n  # A state is defined by (position_row, position_col, direction, inventory_tuple).\n  # The inventory is included because collecting items (especially tools) changes\n  # the agent's capabilities and thus constitutes a distinct state.\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory) # Convert array to tuple for hashing\n  q.append((current_state, [])) # Queue stores (CraftState object, path_taken_to_reach_this_state)\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # MAX_EXPLORED_STATES is a heuristic limit to prevent the search from becoming\n  # excessively long in complex or unreachable scenarios. The multiplier accounts\n  # for different directions and various inventory states at each grid cell.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If the number of explored distinct states exceeds the limit,\n    # we continue to process states already in the queue, but stop exploring new\n    # states from this point to prevent unbounded search.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # We check if the target primitive (`i_kind`) is present in the agent's\n    # 3x3 neighborhood (including the agent's own cell).\n    if state.next_to(i_kind):\n        # Iterate through all four possible agent orientations (UP, RIGHT, DOWN, LEFT)\n        # to see if facing any of them would allow collection.\n        for target_dir in range(4): \n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell directly in front of the agent (if it were to face `target_dir`)\n            # is within grid bounds and contains the target primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions required to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    # Apply each turn action sequentially to update the state's direction.\n                    # The reward from `step` is ignored as we are pathfinding, not optimizing reward.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Record the inventory *before* attempting the 'USE' action.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action. `CraftState.step` internally handles\n                # whether the 'USE' action successfully collects the item (e.g., if a\n                # tool is required, it will only succeed if the tool is in inventory).\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical success check: Did the count of the primitive in inventory\n                # *actually increase* after the 'USE' action? This confirms successful\n                # collection, accounting for all game mechanics.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    # If collected, return the complete sequence of actions.\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible successor states by taking actions:\n    # 1. Movement actions (UP, DOWN, LEFT, RIGHT).\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      # Only enqueue if this exact state (pos, dir, inventory) has not been visited before.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # 2. The 'USE' action from the current position.\n    # This is critical for scenarios where an intermediate item (like a tool)\n    # needs to be collected *before* the target primitive can be acquired.\n    # The `CraftState.step(USE_ACT)` will simulate this, and if it changes the\n    # inventory (e.g., by picking up a tool), this new state will be explored.\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    next_inventory_tuple = tuple(state_after_current_use.inventory)\n    next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n    # Only enqueue if this exact state has not been visited. If the `USE` action\n    # had no effect (e.g., nothing to pick up, no valid interaction), then\n    # `state_after_current_use` would be identical to `state`, and `next_state_key`\n    # would already be in `visited`, preventing redundant additions.\n    if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current\n  # environment conditions and search limits.\n  return []", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T08:11:44.395753", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (row, col)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  # Attempt to get the primitive's ID. If the primitive name is not found\n  # in the cookbook's index, it means it's an unknown or invalid primitive.\n  # In such cases, no actions can be generated, so return an empty list.\n  try:\n      primitive_id = current_state.world.cookbook.index[primitive]\n  except KeyError:\n      return [] # Primitive not found, return an empty list of actions.\n\n  GRID_ROWS, GRID_COLS, _ = initial_grid.shape # Grid dimensions (rows, columns)\n\n  action_map = env.action_specs()\n  # Map DSL movement/turn actions to their integer indices from action_specs.\n  # 'UP' typically moves the agent forward in its current facing direction.\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction.\n  # This tuple indicates how the (row, col) position changes when moving \"forward\" or determining the cell directly in front.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col + 1)\n      1: (-1, 0),  # Facing UP: (row - 1, col)\n      2: (0, -1),  # Facing LEFT: (row, col - 1)\n      3: (1, 0)    # Facing DOWN: (row + 1, col)\n  }\n\n  # Maps for updating the agent's direction when turning left or right.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # RIGHT -> UP -> LEFT -> DOWN -> RIGHT\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # RIGHT -> DOWN -> LEFT -> UP -> RIGHT\n\n  # Define all kinds of entities that block agent movement.\n  # This includes non-grabbable environment entities and the primitive itself (agent must stand next to it, not on it).\n  unwalkable_kind_indices = set(current_state.world.non_grabbable_indices)\n  unwalkable_kind_indices.add(primitive_id) \n\n  # --- Immediate Goal Check ---\n  # Check if the primitive is already directly in front of the agent at the initial state.\n  # If so, the only action needed is 'USE'. This is the fastest path.\n  r_curr, c_curr = initial_pos\n  dr_front, dc_front = DIR_TO_DRDC[initial_dir]\n  r_front, c_front = r_curr + dr_front, c_curr + dc_front\n\n  if (0 <= r_front < GRID_ROWS and 0 <= c_front < GRID_COLS and\n      initial_grid[r_front, c_front, primitive_id] > 0):\n      return [USE_ACTION]\n\n  # --- Breadth-First Search (BFS) Setup ---\n  # BFS state: ((current_position_tuple, current_direction_int), list_of_actions_to_reach_this_state)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # `visited` set tracks (position, direction) pairs to prevent redundant exploration and infinite loops.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # This will store the shortest action sequence to reach the \"ready to use\" state.\n\n  # --- BFS Loop ---\n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      r, c = current_pos\n\n      # Check if the primitive is now directly in front of the agent in the *current* BFS state.\n      # This is the primary goal condition for the BFS: to find a path to a cell\n      # adjacent to the primitive, with the agent facing it.\n      dr_front, dc_front = DIR_TO_DRDC[current_dir]\n      r_front, c_front = r + dr_front, c + dc_front\n      \n      # Ensure the cell in front is within grid boundaries.\n      if (0 <= r_front < GRID_ROWS and 0 <= c_front < GRID_COLS):\n          # If the cell in front contains the primitive, we have found the shortest path\n          # to a state where the agent can 'USE' the primitive.\n          if initial_grid[r_front, c_front, primitive_id] > 0:\n              target_path_actions = path_so_far\n              break # Shortest path to target interaction state found, exit BFS.\n\n      # --- Explore Possible Next Actions (Move Forward, Turn Left, Turn Right) ---\n      \n      # 1. Try moving Forward\n      dr_move, dc_move = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + dr_move, c + dc_move\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change the agent's facing direction.\n\n      # Check if the potential next position is valid and this (pos, dir) state hasn't been visited.\n      if (0 <= next_r < GRID_ROWS and 0 <= next_c < GRID_COLS and\n          (next_pos, next_dir) not in visited):\n          \n          # Determine if the 'next_pos' cell is walkable.\n          # A cell is not walkable if it contains any of the `unwalkable_kind_indices`.\n          is_cell_blocked = False\n          for kind_idx in unwalkable_kind_indices:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_cell_blocked = True\n                  break # Found a blocking entity, cell is not walkable.\n\n          if not is_cell_blocked:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_so_far + [MOVE_FORWARD_ACTION]))\n\n      # 2. Try turning Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change the agent's position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_so_far + [TURN_LEFT_ACTION]))\n\n      # 3. Try turning Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change the agent's position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_so_far + [TURN_RIGHT_ACTION]))\n\n  # --- Finalizing Actions ---\n  # If a path was successfully found to the \"ready to use\" state, append the final 'USE' action.\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 2, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T08:11:45.677749", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's starting position (row, col)\n  initial_dir = current_state.dir # Agent's starting direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Attempt to get the primitive's integer ID from the world's cookbook index.\n  # If the primitive name is not found, it's an invalid target, so return an empty list.\n  try:\n      primitive_id = current_state.world.cookbook.index[primitive]\n  except KeyError:\n      return []\n\n  GRID_ROWS, GRID_COLS, _ = initial_grid.shape # Get dimensions of the grid\n\n  # Retrieve numerical action IDs from the environment's action_specs.\n  # 'UP' is typically used for moving forward in the current facing direction.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Mapping of agent's direction (0-3) to corresponding change in (row, column) coordinates.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: column increases\n      1: (-1, 0),  # Facing UP: row decreases\n      2: (0, -1),  # Facing LEFT: column decreases\n      3: (1, 0)    # Facing DOWN: row increases\n  }\n\n  # Maps for updating agent's direction when turning left or right.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Get the set of indices for entities that cannot be walked upon (e.g., boundaries, water, workshops).\n  blocking_kind_indices = current_state.world.non_grabbable_indices\n\n  # --- Breadth-First Search (BFS) Initialization ---\n  # BFS state: ((current_position_tuple, current_direction_int), list_of_actions_to_reach_this_state)\n  # The queue stores states to be explored.\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # The `visited` set tracks (position, direction) pairs to prevent redundant exploration and cycles.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # This will store the shortest action sequence to reach the \"ready to use\" state.\n\n  # --- BFS Main Loop ---\n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      r_curr, c_curr = current_pos\n\n      # Check if the primitive is directly in front of the agent in the *current* BFS state.\n      # This is the primary goal condition for the BFS: to find a path to a cell\n      # adjacent to the primitive, with the agent facing it.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      r_front, c_front = r_curr + front_dr, c_curr + front_dc\n      \n      # Check if the cell directly in front is within grid boundaries.\n      if (0 <= r_front < GRID_ROWS and 0 <= c_front < GRID_COLS):\n          # If the cell in front contains the target primitive, we've found the shortest path.\n          if initial_grid[r_front, c_front, primitive_id] > 0:\n              target_path_actions = path_so_far\n              break # Shortest path to the target interaction state found, exit BFS.\n\n      # --- Explore Possible Next Actions (Move Forward, Turn Left, Turn Right) ---\n      \n      # 1. Try moving Forward\n      # Calculate the next position after moving forward. Agent's direction remains unchanged.\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r_curr + move_dr, c_curr + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir\n\n      # Check if the `next_pos` is within grid boundaries and this specific (position, direction)\n      # state has not been visited yet.\n      if (0 <= next_r < GRID_ROWS and 0 <= next_c < GRID_COLS and\n          (next_pos, next_dir) not in visited):\n          \n          # Determine if the `next_pos` cell is walkable.\n          # A cell is considered unwalkable if it contains any 'blocking_kind' (e.g., BOUNDARY, WATER)\n          # OR if it contains the target `primitive_id` itself (agent must stand *adjacent* to it, not on it, to USE).\n          unwalkable_check_kinds = set(blocking_kind_indices)\n          unwalkable_check_kinds.add(primitive_id) \n\n          is_cell_unwalkable = False\n          for kind_idx in unwalkable_check_kinds:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_cell_unwalkable = True\n                  break # Found a blocking entity, cell is not walkable.\n\n          if not is_cell_unwalkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_so_far + [MOVE_FORWARD_ACTION]))\n\n      # 2. Try turning Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning changes only the agent's direction, not its position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_so_far + [TURN_LEFT_ACTION]))\n\n      # 3. Try turning Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning changes only the agent's direction, not its position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_so_far + [TURN_RIGHT_ACTION]))\n\n  # --- After BFS Completion ---\n  # If a path was found to the \"ready to use\" state (target_path_actions is not None),\n  # append the final 'USE' action to complete the collection.\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 2, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T08:12:28.039577", "function_name": "collect", "function_body": "  current_state = env._current_state\n  \n  # 1. Retrieve the integer index for the target primitive.\n  # The `__getitem__` method (square bracket notation) of the Index class is used\n  # as it returns `None` if the item is not found, which is safer than `index()`\n  # which would create a new index if it doesn't exist, and we only want to lookup.\n  primitive_idx = env.world.cookbook.index[primitive] \n  if primitive_idx is None:\n    # If the primitive name is not recognized by the environment's cookbook,\n    # it cannot be collected, so return an empty action list.\n    return []\n\n  # 2. Map action names to their corresponding integer IDs for better readability.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # 3. Optimization: Check if the primitive is already in the agent's inventory.\n  # If the agent already possesses the primitive, no collection actions are needed.\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # 4. Immediate collection check:\n  # Determine if the agent is currently positioned such that it can directly 'USE'\n  # (collect) the primitive. `next_to` checks the 3x3 neighborhood around the agent.\n  if current_state.next_to(primitive_idx):\n    # If already in range, simply apply the USE action.\n    return [ACTION_USE]\n\n  # 5. Locate all instances of the primitive on the current grid.\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  primitive_locations = [] # Stores (x, y) coordinates of cells containing the primitive.\n  for x in range(grid_width):\n    for y in range(grid_height):\n      # The grid stores counts of each item kind per cell. If count > 0, the item is present.\n      if grid[x, y, primitive_idx] > 0:\n        primitive_locations.append((x, y))\n\n  # If the primitive is not found anywhere on the grid, it's currently unreachable.\n  if not primitive_locations:\n    return []\n\n  # 6. Define \"goal cells\" for the pathfinding algorithm.\n  # A goal cell is any grid position from which the agent can successfully 'USE' the primitive.\n  # Since `current_state.next_to` checks a 3x3 area, any cell within the 3x3 neighborhood\n  # of a primitive location is considered a valid goal cell for movement.\n  goal_cells = set()\n  for px, py in primitive_locations:\n    # Iterate through the 3x3 neighborhood (including the primitive's own cell).\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        gx, gy = px + dx, py + dy # Calculate the absolute coordinates of the potential goal cell.\n        # Ensure the potential goal cell is within the overall grid boundaries.\n        if 0 <= gx < grid_width and 0 <= gy < grid_height:\n          goal_cells.add((gx, gy))\n\n  # 7. Identify impassable terrain for agent movement.\n  # Impassable items are generally non-grabbable entities, but typically workshops\n  # are traversable locations, so they are excluded from the impassable set.\n  impassable_entity_indices = set(env.world.non_grabbable_indices) - set(env.world.workshop_indices)\n\n  # 8. Perform Breadth-First Search (BFS) to find the shortest path to a goal cell.\n  # BFS is used as it guarantees the shortest path in an unweighted grid environment.\n  start_pos = current_state.pos # Agent's current (x, y) position.\n  \n  # BFS queue: Stores tuples of (current_position, list_of_actions_taken_to_reach_here).\n  bfs_queue = collections.deque([(start_pos, [])]) \n  # 'visited' set: Keeps track of grid positions already explored to prevent cycles and redundant work.\n  visited_positions = {start_pos} \n\n  # Define valid movement deltas (changes in x, y coordinates) and their corresponding actions.\n  MOVE_DELTAS_AND_ACTIONS = [\n      ((0, -1), ACTION_UP),    # Move North (decreases Y)\n      ((0, 1), ACTION_DOWN),   # Move South (increases Y)\n      ((-1, 0), ACTION_LEFT),  # Move West (decreases X)\n      ((1, 0), ACTION_RIGHT),  # Move East (increases X)\n  ]\n\n  while bfs_queue:\n    (current_x, current_y), path_so_far = bfs_queue.popleft()\n\n    # If the current position is one of the identified goal cells, we have found the shortest path.\n    if (current_x, current_y) in goal_cells:\n      # Append the 'USE' action to the path, as the agent is now in a position to collect.\n      return path_so_far + [ACTION_USE]\n\n    # Explore all four cardinal neighbors from the current position.\n    for (dx, dy), action_to_take in MOVE_DELTAS_AND_ACTIONS:\n      next_x, next_y = current_x + dx, current_y + dy\n      next_pos = (next_x, next_y)\n\n      # Check 1: Ensure the next position is within the grid boundaries.\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue # Skip if out of bounds.\n\n      # Check 2: Determine if the next position is blocked by impassable terrain.\n      is_blocked = False\n      for entity_kind_idx in impassable_entity_indices:\n          # If any impassable entity is present at the next position (count > 0), it's blocked.\n          if grid[next_x, next_y, entity_kind_idx] > 0: \n              is_blocked = True\n              break\n      \n      if is_blocked:\n          continue # Cannot move to this cell, skip it.\n\n      # Check 3: If the next position has not been visited yet, add it to the queue.\n      if next_pos not in visited_positions:\n        visited_positions.add(next_pos)\n        # Add the new position and the updated path to the queue for further exploration.\n        bfs_queue.append((next_pos, path_so_far + [action_to_take]))\n\n  # If the BFS completes and the queue becomes empty without finding any path to a goal cell,\n  # it means the primitive is unreachable from the current agent's state (e.g., completely\n  # surrounded by obstacles, or no primitive instances found on the grid after initial check).\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T08:12:29.295187", "function_name": "collect", "function_body": "  current_state = env._current_state\n  \n  # Step 1: Validate the primitive and retrieve its integer ID.\n  # We use the __getitem__ method of the Index object (accessed via `[]`)\n  # to get the existing ID without adding new entries if the primitive is unknown.\n  primitive_idx = env.world.cookbook.index[primitive] \n  if primitive_idx is None:\n    # If the primitive name does not correspond to a known item in the world,\n    # it cannot be collected, so we return an empty action list.\n    return []\n\n  # Step 2: Define action mappings for clarity.\n  # This makes the action sequence more readable and less prone to errors\n  # compared to using magic numbers (0, 1, 2, 3, 4 directly).\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Step 3: Prioritize immediate collection.\n  # Check if the agent's inventory already contains the primitive. If so, no further\n  # actions are required to \"collect\" it, as it's already possessed.\n  if current_state.inventory[primitive_idx] > 0:\n    return [] \n\n  # Check if the agent is already in a position to collect the primitive (i.e., within 3x3 neighborhood).\n  # If so, the most direct action is to simply \"USE\" it. This avoids unnecessary movement.\n  if current_state.next_to(primitive_idx):\n    return [USE]\n\n  # Step 4: Identify all physical locations of the primitive on the grid.\n  # The agent needs to navigate to a spot near one of these locations.\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  primitive_locations_on_grid = [] # Stores (x, y) coordinates where the primitive exists\n  for x in range(grid_width):\n    for y in range(grid_height):\n      # The grid stores counts for each item kind at each cell. A count > 0 means it's present.\n      if grid[x, y, primitive_idx] > 0:\n        primitive_locations_on_grid.append((x, y))\n\n  # If the primitive is not found anywhere on the current grid, it's currently unreachable.\n  if not primitive_locations_on_grid:\n    return []\n\n  # Step 5: Determine \"goal cells\" for pathfinding.\n  # A goal cell is any grid position from which the agent can successfully interact with\n  # (i.e., 'USE') the target primitive. Since `CraftState.next_to` considers a 3x3 area,\n  # any cell within the 3x3 neighborhood of a primitive's location is a valid goal.\n  goal_cells = set()\n  for px, py in primitive_locations_on_grid:\n    # Iterate through a 3x3 square centered at the primitive's location (px, py).\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        gx, gy = px + dx, py + dy # Calculate potential goal cell coordinates\n        # Ensure the calculated goal cell is within the overall grid boundaries.\n        if 0 <= gx < grid_width and 0 <= gy < grid_height:\n          goal_cells.add((gx, gy))\n\n  # Step 6: Identify impassable terrain for movement.\n  # The agent cannot move into cells occupied by certain non-grabbable items.\n  # Workshops are explicitly excluded from being impassable as they are typically traversable areas.\n  impassable_kinds = set()\n  for idx in env.world.non_grabbable_indices:\n      if idx not in env.world.workshop_indices: \n          impassable_kinds.add(idx)\n\n  # Step 7: Perform Breadth-First Search (BFS) to find the shortest path.\n  # BFS is ideal here because it guarantees finding the shortest path in an unweighted graph,\n  # where each movement action has a uniform cost (1 step).\n  start_pos = current_state.pos\n  \n  # The BFS queue stores tuples: (current_position (x,y), list_of_actions_taken_to_reach_here).\n  q = collections.deque([(start_pos, [])]) \n  # The 'visited' set keeps track of positions already explored to prevent cycles and redundant work.\n  visited = {start_pos} \n\n  # Define possible cardinal movement directions and their corresponding action IDs.\n  # Format: ((delta_x, delta_y), action_id)\n  MOVE_DELTAS_AND_ACTIONS = [\n      ((0, -1), UP),    # Move North (Y-coordinate decreases)\n      ((0, 1), DOWN),   # Move South (Y-coordinate increases)\n      ((-1, 0), LEFT),  # Move West (X-coordinate decreases)\n      ((1, 0), RIGHT),  # Move East (X-coordinate increases)\n  ]\n\n  while q:\n    (cx, cy), path_so_far = q.popleft() # Get current position and the path leading to it\n\n    # If the current position is one of our designated goal cells, we've found the shortest path.\n    if (cx, cy) in goal_cells:\n      # The path found leads to a cell from which 'USE' can be applied to collect the primitive.\n      return path_so_far + [USE]\n\n    # Explore valid neighboring cells for movement.\n    for (dx, dy), action_to_take in MOVE_DELTAS_AND_ACTIONS:\n      nx, ny = cx + dx, cy + dy # Calculate the new potential position\n      new_pos = (nx, ny)\n\n      # Check 7.1: Ensure the new position is within the overall grid boundaries.\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue # Skip if out of bounds.\n\n      # Check 7.2: Determine if the new position is occupied by impassable terrain.\n      is_impassable_location = False\n      for k_idx in impassable_kinds:\n          # If any impassable kind is present at the new position (count > 0), it's blocked.\n          if grid[nx, ny, k_idx] > 0: \n              is_impassable_location = True\n              break\n      \n      if is_impassable_location:\n          continue # Cannot move to this cell, skip it.\n\n      # Check 7.3: If the new position has not been visited yet, add it to the queue\n      # along with the path taken to reach it.\n      if new_pos not in visited:\n        visited.add(new_pos)\n        q.append((new_pos, path_so_far + [action_to_take]))\n\n  # Step 8: If BFS completes without finding a path.\n  # If the queue becomes empty and no goal cell was reached, it means the primitive\n  # is unreachable from the current state (e.g., completely surrounded by impassable terrain,\n  # or the primitive itself is located in an isolated/unreachable area).\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T08:13:16.663284", "function_name": "collect", "function_body": "  current_state = env._current_state\n  current_grid = current_state.grid\n  current_pos = current_state.pos # (x, y) tuple\n\n  # Get the integer index for the primitive from the cookbook\n  primitive_idx = env.world.cookbook.index.index(primitive)\n  \n  # Get action mappings from the environment's action_specs for clarity\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # 1. Immediate check: If the agent is already in a position to collect the primitive.\n  # This leverages the CraftState's built-in `next_to` check.\n  if current_state.next_to(primitive_idx):\n    return [USE]\n\n  # 2. Find all grid locations where the primitive exists using NumPy's np.where.\n  # np.where returns a tuple of arrays (x_coords, y_coords) for non-zero elements.\n  primitive_x_coords, primitive_y_coords = np.where(current_grid[:, :, primitive_idx] > 0)\n  \n  # Combine the x and y coordinates into a list of (x, y) tuples\n  primitive_locations_on_grid = list(zip(primitive_x_coords, primitive_y_coords))\n\n  # If the primitive isn't anywhere on the map, we can't collect it.\n  if not primitive_locations_on_grid:\n    return []\n\n  # 3. Determine all \"goal cells\" for the BFS. \n  # A goal cell is any cell (gx, gy) from which the agent can use the 'USE' action\n  # to collect a primitive at (px,py). 'USE' acts on the 3x3 neighborhood.\n  goal_cells = set()\n  grid_width, grid_height, _ = current_grid.shape\n  for px, py in primitive_locations_on_grid:\n    # Iterate through the 3x3 neighborhood around each primitive location\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        gx, gy = px + dx, py + dy\n        # Ensure the potential goal cell is within grid bounds\n        if 0 <= gx < grid_width and 0 <= gy < grid_height:\n          goal_cells.add((gx, gy))\n\n  # 4. Perform Breadth-First Search (BFS) to find the shortest path.\n  \n  # BFS queue: stores (current_position, path_taken_actions_to_reach_current_position)\n  q = collections.deque([(current_pos, [])]) \n  # Set to keep track of visited positions to avoid redundant exploration and cycles\n  visited = {current_pos} \n\n  # Define possible movement deltas and their corresponding action indices\n  # Format: ((delta_x, delta_y), action_index)\n  MOVE_DELTAS_AND_ACTIONS = [\n      ((0, -1), UP),    # Move North (decreases Y)\n      ((0, 1), DOWN),   # Move South (increases Y)\n      ((-1, 0), LEFT),  # Move West (decreases X)\n      ((1, 0), RIGHT),  # Move East (increases X)\n  ]\n\n  # Identify impassable kinds. These are non-grabbable items that are NOT workshops.\n  # The agent cannot move into cells containing these specific kinds.\n  impassable_kind_indices = set()\n  for idx in env.world.non_grabbable_indices:\n      # Workshops are typically traversable, even if non-grabbable.\n      if idx not in env.world.workshop_indices: \n          impassable_kind_indices.add(idx)\n\n  while q:\n    (cx, cy), path = q.popleft() # Dequeue the current position and its path\n\n    # If the current position is one of our target goal cells, we've found the shortest path\n    if (cx, cy) in goal_cells:\n      # The path found leads to a cell from which 'USE' can be applied.\n      return path + [USE]\n\n    # Explore valid neighbors\n    for (dx, dy), action in MOVE_DELTAS_AND_ACTIONS:\n      nx, ny = cx + dx, cy + dy # Calculate new potential position\n\n      # Check if the new position is within grid boundaries\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue\n\n      new_pos = (nx, ny)\n\n      # Check if the new position is impassable.\n      # A cell is impassable if any of the 'impassable_kind_indices' are present there with count > 0.\n      is_impassable = False\n      for k_idx in impassable_kind_indices:\n          if current_grid[nx, ny, k_idx] > 0: \n              is_impassable = True\n              break\n      \n      if is_impassable:\n          continue # Cannot move to this cell, skip it\n\n      # If the new position has not been visited yet, add it to the queue\n      if new_pos not in visited:\n        visited.add(new_pos)\n        q.append((new_pos, path + [action]))\n\n  # If the BFS completes and no path to a goal cell was found,\n  # it means the primitive is unreachable from the current state.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
