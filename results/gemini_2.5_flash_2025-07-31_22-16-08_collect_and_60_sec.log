{"timestamp": "2025-08-01T07:31:04.649966", "function_name": "collect", "function_body": "  \"\"\"Finds the shortest sequence of actions to move the agent to a position adjacent\n  to the specified primitive, facing it, and then performing a 'USE' action to collect it.\n  \n  This function uses a Breadth-First Search (BFS) to find the optimal path\n  in terms of actions (movements and turns) from the agent's current state\n  to a state where the primitive is directly in front, ready to be 'USE'd.\n\n    Args:\n        env (env.CraftLab): The CraftLab object containing the current state of the simulation.\n        primitive (str): The name of the primitive resource (e.g., \"WOOD\", \"STONE\") to collect.\n\n    Returns:\n        List[int]: A sequence of action indices (integers) to execute. The list\n                   will be empty if the primitive is not found or is unreachable.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state # Access the current CraftState from the CraftLab environment\n  \n  # Extract relevant information from the current game state\n  grid = current_state.grid\n  initial_pos = current_state.pos # Agent's current position (row, col)\n  initial_dir = current_state.dir # Agent's current facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the world's cookbook index.\n  # This ID is used to query the grid contents.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Get grid dimensions for boundary checks\n  num_rows, num_cols, _ = grid.shape\n\n  # Retrieve action integer mappings from the environment's action_specs.\n  action_map = env.action_specs()\n  ACTION_MOVE_FORWARD = action_map['UP']\n  ACTION_TURN_LEFT = action_map['LEFT']\n  ACTION_TURN_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define how agent's coordinates change based on its current direction when moving forward.\n  # Key: current_direction_int, Value: (delta_row, delta_column)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col + 1)\n      1: (-1, 0),  # Facing UP: (row - 1, col)\n      2: (0, -1),  # Facing LEFT: (row, col - 1)\n      3: (1, 0)    # Facing DOWN: (row + 1, col)\n  }\n\n  # Define how agent's direction changes when turning left or right.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # e.g., RIGHT (0) -> UP (1)\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # e.g., RIGHT (0) -> DOWN (3)\n\n  # Get the set of entity indices that represent non-walkable terrain.\n  # These are entities the agent cannot move onto.\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # Helper function to check if a given cell (r, c) is within grid boundaries\n  # and does not contain any non-walkable entities or the primitive itself.\n  def _is_cell_walkable(r: int, c: int) -> bool:\n      # Check if coordinates are within the grid bounds.\n      if not (0 <= r < num_rows and 0 <= c < num_cols):\n          return False\n      \n      # The agent cannot move *onto* the primitive it intends to collect.\n      # Collection happens when adjacent and using the 'USE' action.\n      if grid[r, c, primitive_id] > 0:\n          return False\n      \n      # Check if the cell contains any impassable entities.\n      # These typically include boundaries, water, and fixed workshop structures.\n      for kind_idx in non_walkable_kinds_indices:\n          if grid[r, c, kind_idx] > 0:\n              return False\n      \n      return True\n\n  # Initialize Breadth-First Search (BFS).\n  # The queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_taken_so_far).\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # The 'visited' set keeps track of (position, direction) states already explored.\n  # This prevents redundant searches and ensures finding the shortest path (in terms of actions).\n  visited = {(initial_pos, initial_dir)}\n\n  # This variable will store the action sequence once a path to the target is found.\n  target_path_to_adjacent_state = None \n\n  # Start BFS traversal.\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos # Unpack current row and column.\n\n      # Check if the target primitive is in the cell directly in front of the agent.\n      # This is the desired goal state for collection (being adjacent and facing the item).\n      delta_r_front, delta_c_front = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + delta_r_front, c + delta_c_front\n      \n      # Ensure the cell directly in front is within grid boundaries before checking its contents.\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n          # If the primitive is present in the cell immediately in front, we've found our path.\n          if grid[front_r, front_c, primitive_id] > 0:\n              target_path_to_adjacent_state = path_actions # Store the sequence of actions leading to this state.\n              break # Path found, exit the BFS loop.\n\n      # Explore all possible next actions (Move Forward, Turn Left, Turn Right) from the current state.\n\n      # 1. Try MOVE_FORWARD_ACTION:\n      # Calculate the next position if the agent moves forward. Direction remains unchanged.\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change orientation.\n\n      # Check if the calculated next position is valid and traversable, and if this new state (pos, dir)\n      # has not been visited yet.\n      if _is_cell_walkable(next_r, next_c) and (next_pos, next_dir) not in visited:\n          visited.add((next_pos, next_dir)) # Mark as visited.\n          # Add the new state and the extended path to the queue for further exploration.\n          queue.append(((next_pos, next_dir), path_actions + [ACTION_MOVE_FORWARD]))\n\n      # 2. Try TURN_LEFT_ACTION:\n      # Calculate the new direction after turning left. Position remains unchanged.\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Check if this new state (same position, new direction) has not been visited.\n      if (current_pos, next_dir_left) not in visited:\n          visited.add((current_pos, next_dir_left)) # Mark as visited.\n          # Add the new state and extended path to the queue.\n          queue.append(((current_pos, next_dir_left), path_actions + [ACTION_TURN_LEFT]))\n\n      # 3. Try TURN_RIGHT_ACTION:\n      # Calculate the new direction after turning right. Position remains unchanged.\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Check if this new state has not been visited.\n      if (current_pos, next_dir_right) not in visited:\n          visited.add((current_pos, next_dir_right)) # Mark as visited.\n          # Add the new state and extended path to the queue.\n          queue.append(((current_pos, next_dir_right), path_actions + [ACTION_TURN_RIGHT]))\n\n  # After BFS completes:\n  # If a path to the target state (agent adjacent and facing the primitive) was found,\n  # append the final 'USE' action to the discovered path. This completes the collection sequence.\n  # If no path was found (target_path_to_adjacent_state remains None), an empty list is returned,\n  # indicating that the primitive is unreachable from the current state.\n  if target_path_to_adjacent_state is not None:\n      actions_list.extend(target_path_to_adjacent_state)\n      actions_list.append(ACTION_USE)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T07:31:05.823801", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state # Access the current CraftState from the CraftLab environment\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's current position (row, col)\n  initial_dir = current_state.dir # Agent's current facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the world's cookbook index.\n  # This ID is used to query the grid.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Grid dimensions: shape is (WIDTH, HEIGHT, n_kinds)\n  num_rows, num_cols, _ = initial_grid.shape\n\n  # Retrieve action mapping from the environment (e.g., 'UP' -> 1, 'USE' -> 4)\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define changes in (row, col) for each facing direction when moving forward.\n  # This helps calculate the next position based on current direction.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # Define how agent's direction changes when turning left or right.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # RIGHT->UP->LEFT->DOWN->RIGHT\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # RIGHT->DOWN->LEFT->UP->RIGHT\n\n  # Identify entities that the agent cannot walk onto.\n  # This includes boundaries, water, and fixed structures like workshops (as per common game mechanics).\n  # The `non_grabbable_indices` are entities that cannot be picked up; typically, these also block movement.\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # BFS initialization:\n  # Queue stores tuples of ( (current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_here )\n  # Each state in the BFS is defined by (agent_row, agent_col, agent_direction).\n  # We store the path of actions taken to reach that state.\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # Visited set stores (position_tuple, direction_int) to prevent revisiting states\n  # and finding non-optimal paths (BFS guarantees shortest path if states are (pos, dir)).\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the action sequence to the adjacent-and-facing state.\n\n  # Start BFS traversal\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the target primitive is directly in front of the agent from the current (r,c,dir) state.\n      # If so, we've found the path to the desired pre-collection state.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the cell in front is within grid boundaries before checking its contents.\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n          # If the primitive is present in the cell directly in front, we have a solution path.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions # The path *to* this state.\n              break # Exit BFS, shortest path found.\n\n      # 2. Explore possible next actions from the current state (Move Forward, Turn Left, Turn Right).\n\n      # --- Attempt to Move Forward ---\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change direction.\n\n      # Check if the next position is within grid boundaries and this specific (pos, dir) state hasn't been visited.\n      if (0 <= next_r < num_rows and 0 <= next_c < num_cols and\n          (next_pos, next_dir) not in visited):\n          \n          # Determine if the next cell is walkable for the agent.\n          # A cell is considered non-walkable if:\n          #   a) It contains the target primitive itself. Agent collects by standing *next* to it, not on it.\n          #   b) It contains any entity specified in `non_walkable_kinds_indices`\n          #      (e.g., BOUNDARY, WATER, or certain WORKSHOP types that are fixed terrain and impassable).\n          is_walkable = not (\n              initial_grid[next_r, next_c, primitive_id] > 0 or\n              any(initial_grid[next_r, next_c, kind_idx] > 0 for kind_idx in non_walkable_kinds_indices)\n          )\n\n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # --- Attempt to Turn Left ---\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # --- Attempt to Turn Right ---\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path to the target adjacent state was found (target_path is not None),\n  # append the final 'USE' action to complete the collection.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T07:32:03.315487", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`. Pre-computes an impassable grid for faster BFS lookups.\n    \n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect.\n\n    Returns:\n        List[int]: A sequence of action indices to execute.\n  \"\"\"\n  current_state = env._current_state\n  \n  # --- 1. Pre-computation and Initialization ---\n\n  # Map the primitive's string name to its internal integer ID.\n  # This relies on the Cookbook's index, which is robust.\n  primitive_idx = env.world.cookbook.index.index(primitive)\n  \n  # Retrieve essential action indices for readability and consistency.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Define cardinal movement directions and their corresponding actions.\n  DELTAS_ACTIONS = [\n      ((0, -1), UP),    # Move North (decreasing Y-coordinate)\n      ((0, 1), DOWN),   # Move South (increasing Y-coordinate)\n      ((-1, 0), LEFT),  # Move West (decreasing X-coordinate)\n      ((1, 0), RIGHT),  # Move East (increasing X-coordinate)\n  ]\n\n  # Determine which entity kinds are impassable for agent movement.\n  # These are typically non-grabbable items that are not workshops (which are traversable).\n  # Convert to a numpy array for efficient indexing.\n  impassable_kinds = set(env.world.non_grabbable_indices) - set(env.world.workshop_indices)\n  impassable_kinds_array = np.array(list(impassable_kinds)) if impassable_kinds else np.array([])\n\n  # Get current grid dimensions for boundary checks.\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  # --- Optimization: Pre-compute impassable grid for O(1) lookup during BFS ---\n  # Create a boolean grid where True indicates an impassable cell.\n  is_impassable_grid = np.zeros((grid_width, grid_height), dtype=bool)\n  if impassable_kinds_array.size > 0:\n      # Select only the channels corresponding to impassable kinds.\n      # `grid[:, :, impassable_kinds_array]` results in a (WIDTH, HEIGHT, num_impassable_kinds) array.\n      impassable_channels = grid[:, :, impassable_kinds_array]\n      # A cell is impassable if any of the selected channels at that cell are > 0.\n      is_impassable_grid = np.any(impassable_channels > 0, axis=-1)\n\n  # --- 2. Initial Checks ---\n\n  # If the primitive is already in the agent's inventory, no actions are required.\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # If the agent is already adjacent to the primitive, a single USE action is sufficient.\n  if current_state.next_to(primitive_idx):\n    return [USE]\n\n  # --- 3. Locate Primitives on Grid and Define Goal Cells ---\n\n  primitive_grid_locations = []\n  # Iterate over the grid to find all occurrences of the target primitive.\n  for x in range(grid_width):\n    for y in range(grid_height):\n      if grid[x, y, primitive_idx] > 0:\n        primitive_grid_locations.append((x, y))\n\n  # If the primitive is not found anywhere on the map, it's unreachable.\n  if not primitive_grid_locations:\n    return []\n\n  # Define \"goal cells\" for the BFS. These are all valid, traversable cells\n  # from which the agent can successfully `USE` to collect the primitive\n  # (i.e., any cell within the 3x3 neighborhood of a primitive's location).\n  goal_cells = set()\n  for px, py in primitive_grid_locations:\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        gx, gy = px + dx, py + dy\n        # Add to goal_cells only if within bounds and traversable.\n        if (0 <= gx < grid_width and 0 <= gy < grid_height and\n            not is_impassable_grid[gx, gy]):\n          goal_cells.add((gx, gy))\n\n  # If no traversable goal cells exist around any primitive, then it's unreachable.\n  if not goal_cells:\n    return []\n\n  # --- 4. Breadth-First Search (BFS) ---\n  \n  start_pos = current_state.pos\n  \n  # BFS queue: stores (current_position, list_of_actions_taken_to_reach_here).\n  q = collections.deque([(start_pos, [])]) \n  # Set of visited positions to avoid cycles and re-exploring paths.\n  visited = {start_pos} \n\n  # Edge case: If the agent's starting position is itself impassable, no path is possible.\n  if is_impassable_grid[start_pos[0], start_pos[1]]:\n      return []\n\n  while q:\n    (cx, cy), path_to_current = q.popleft() \n\n    # If the current position is a goal cell, we've found the shortest path.\n    # Note: `goal_cells` already ensures that any cell added to it is traversable.\n    if (cx, cy) in goal_cells:\n      return path_to_current + [USE] # Append USE as the final collection action.\n\n    # Explore all valid, unvisited, and traversable neighboring cells.\n    for (dx, dy), action in DELTAS_ACTIONS:\n      nx, ny = cx + dx, cy + dy # Calculate the new potential position.\n      new_pos = (nx, ny)\n\n      # Check 1: Boundary Check - Is the new position within the grid boundaries?\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue # Skip if out of bounds.\n\n      # Check 2: Impassability Check - Is the new position impassable?\n      # Use the pre-computed grid for efficient O(1) lookup.\n      if is_impassable_grid[nx, ny]:\n          continue # Skip if the cell is impassable.\n\n      # Check 3: Visited Check - Has this position already been explored?\n      if new_pos not in visited:\n        visited.add(new_pos) # Mark as visited.\n        q.append((new_pos, path_to_current + [action])) # Enqueue new position and path.\n\n  # If the BFS completes and the queue is empty, no path to a goal cell was found.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T07:32:04.472110", "function_name": "collect", "function_body": "  current_state = env._current_state\n  \n  # --- 1. Pre-computation and Initialization ---\n\n  # Map the primitive's string name to its internal integer ID.\n  # This relies on the Cookbook's index, which is robust.\n  primitive_idx = env.world.cookbook.index.index(primitive)\n  \n  # Retrieve essential action indices for readability and consistency.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Define cardinal movement directions and their corresponding actions.\n  DELTAS_ACTIONS = [\n      ((0, -1), UP),    # Move North (decreasing Y-coordinate)\n      ((0, 1), DOWN),   # Move South (increasing Y-coordinate)\n      ((-1, 0), LEFT),  # Move West (decreasing X-coordinate)\n      ((1, 0), RIGHT),  # Move East (increasing X-coordinate)\n  ]\n\n  # Determine which entity kinds are impassable for agent movement.\n  # These are typically non-grabbable items that are not workshops (which are traversable).\n  # Convert to a numpy array for efficient indexing in the BFS loop's impassability check.\n  impassable_kinds = set(env.world.non_grabbable_indices) - set(env.world.workshop_indices)\n  impassable_kinds_array = np.array(list(impassable_kinds)) if impassable_kinds else np.array([])\n\n  # Get current grid dimensions for boundary checks.\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  # --- 2. Initial Checks ---\n\n  # If the primitive is already in the agent's inventory, no actions are required.\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # If the agent is already adjacent to the primitive, a single USE action is sufficient.\n  if current_state.next_to(primitive_idx):\n    return [USE]\n\n  # --- 3. Locate Primitives on Grid and Define Goal Cells ---\n\n  primitive_grid_locations = []\n  # Iterate over the grid to find all occurrences of the target primitive.\n  for x in range(grid_width):\n    for y in range(grid_height):\n      if grid[x, y, primitive_idx] > 0:\n        primitive_grid_locations.append((x, y))\n\n  # If the primitive is not found anywhere on the map, it's unreachable.\n  if not primitive_grid_locations:\n    return []\n\n  # Define \"goal cells\" for the BFS. These are all valid, traversable cells\n  # from which the agent can successfully `USE` to collect the primitive\n  # (i.e., any cell within the 3x3 neighborhood of a primitive's location).\n  goal_cells = set()\n  for px, py in primitive_grid_locations:\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        gx, gy = px + dx, py + dy\n        if 0 <= gx < grid_width and 0 <= gy < grid_height:\n          goal_cells.add((gx, gy))\n\n  # --- 4. Breadth-First Search (BFS) ---\n  \n  start_pos = current_state.pos\n  \n  # BFS queue: stores (current_position, list_of_actions_taken_to_reach_here).\n  q = collections.deque([(start_pos, [])]) \n  # Set of visited positions to avoid cycles and re-exploring paths.\n  visited = {start_pos} \n\n  while q:\n    (cx, cy), path_to_current = q.popleft() \n\n    # If the current position is a goal cell, we've found the shortest path.\n    if (cx, cy) in goal_cells:\n      return path_to_current + [USE] # Append USE as the final collection action.\n\n    # Explore all valid, unvisited, and traversable neighboring cells.\n    for (dx, dy), action in DELTAS_ACTIONS:\n      nx, ny = cx + dx, cy + dy # Calculate the new potential position.\n      new_pos = (nx, ny)\n\n      # Check 1: Boundary Check - Is the new position within the grid boundaries?\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue # Skip if out of bounds.\n\n      # Check 2: Impassability Check - Does the new position contain an impassable kind?\n      # Efficiently check if any of the impassable_kinds are present at (nx, ny)\n      # using numpy's any() over the relevant slice of the grid.\n      if impassable_kinds_array.size > 0 and np.any(grid[nx, ny, impassable_kinds_array] > 0):\n          continue # Skip if the cell is impassable.\n\n      # Check 3: Visited Check - Has this position already been explored?\n      if new_pos not in visited:\n        visited.add(new_pos) # Mark as visited.\n        q.append((new_pos, path_to_current + [action])) # Enqueue new position and path.\n\n  # If the BFS completes and the queue is empty, no path to a goal cell was found.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T07:33:16.491732", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized (e.g., not in cookbook), it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: If the target primitive is an entity that is never meant\n  # to be collected into inventory (e.g., a permanent workshop, boundary, or\n  # other non-grabbable environment feature), filter it out early.\n  # These items are typically part of the 'environment' set in the cookbook.\n  if i_kind in world.cookbook.environment:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set stores a tuple (row, col, direction, inventory_tuple).\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing, allowing BFS to distinguish\n  # between states that are identical in position/direction but differ in inventory (e.g., after collecting a tool).\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Heuristic limit to prevent excessively long searches in very complex or large state spaces.\n  # This value can be tuned; it aims to cover typical map sizes and a reasonable number of inventory states.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    # This prevents the search from running indefinitely in highly complex or unreachable scenarios.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Attempt to collect the primitive by using at the current cell.\n    # This covers scenarios where an item can be picked up by standing on it and using USE.\n    inventory_before_use_at_current_pos = np.copy(state.inventory)\n    _, state_after_use_at_current_pos = state.step(USE_ACT)\n    # Verify successful collection by checking if the primitive's count increased in inventory.\n    if state_after_use_at_current_pos.inventory[i_kind] > inventory_before_use_at_current_pos[i_kind]:\n        return path + [USE_ACT] # Primitive collected! Return the path.\n\n    # Goal Check: Attempt to collect the primitive by using an entity in an adjacent cardinal direction.\n    # This covers scenarios like gathering resources (e.g., wood from a tree) or interacting with\n    # workshops in front of the agent.\n    for target_dir in range(4): # Iterate through 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n        dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n        facing_r, facing_c = current_r + dr, current_c + dc\n\n        # Ensure the cell in front is within grid bounds.\n        if 0 <= facing_r < grid_width and 0 <= facing_c < grid_height:\n            # Simulate the turning actions required to face the target direction.\n            turns_to_face = _get_turning_actions(current_dir, target_dir)\n            temp_state_after_turns = state \n            for turn_action in turns_to_face:\n                _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n            # Store inventory before attempting USE to verify if collection occurs.\n            inventory_before_use_adjacent = np.copy(temp_state_after_turns.inventory)\n\n            # Simulate the 'USE' action on the cell in front.\n            _, state_after_use_adjacent = temp_state_after_turns.step(USE_ACT)\n\n            # Critical check: Did the count of the primitive in inventory actually increase?\n            # This verifies successful collection, accounting for any internal game rules\n            # (e.g., tools needed, specific entity interaction) implemented in `CraftState.step`.\n            if state_after_use_adjacent.inventory[i_kind] > inventory_before_use_adjacent[i_kind]:\n                return path + turns_to_face + [USE_ACT] # Primitive collected! Return the path.\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the USE action from the current position generally, even if it doesn't immediately\n    # satisfy the primary goal. This is crucial for discovering paths where an intermediate USE\n    # action (e.g., crafting a tool at a workbench, picking up a required key item) is required\n    # to eventually collect the target primitive.\n    inventory_before_general_use = np.copy(state.inventory)\n    _, state_after_current_use_general = state.step(USE_ACT)\n    \n    # Only add the resulting state to the queue if the general USE action had a meaningful effect\n    # (i.e., changed inventory, position, or direction) and it hasn't been visited before.\n    # This avoids exploring redundant states where USE did nothing.\n    if not (np.array_equal(state_after_current_use_general.inventory, inventory_before_general_use) and\n            state_after_current_use_general.pos == state.pos and\n            state_after_current_use_general.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use_general.inventory)\n        next_state_key = (state_after_current_use_general.pos[0], state_after_current_use_general.pos[1], state_after_current_use_general.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use_general, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions\n  # and the search depth (limited by MAX_EXPLORED_STATES).\n  return []", "island_id": 6, "scores": {"3": 1.5}}
