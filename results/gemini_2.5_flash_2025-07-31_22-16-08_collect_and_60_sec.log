{"timestamp": "2025-08-01T06:02:06.983172", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\"\"\"\n  \"\"\"Returns a list of actions to find and collect the primitive in the passed env.\n    This function uses a Breadth-First Search (BFS) to find the shortest sequence of\n    movement actions to reach a position adjacent to the specified primitive,\n    followed by a 'USE' action to collect it.\n    \n    Args:\n        env (env.CraftLab): The CraftLab object representing the current simulation state.\n        primitive (str): The name of the primitive item to collect (e.g., \"WOOD\", \"STONE\").\n\n    Returns:\n        List[int]: A sequence of integer action indices to execute. An empty list\n                   is returned if the primitive is unreachable or not found on the grid.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state # Access the underlying CraftState for detailed info\n\n  initial_grid = current_state.grid # (rows, columns, kinds) numpy array\n  initial_agent_pos = current_state.pos  # Agent's starting position (row, col)\n  initial_agent_dir = current_state.dir  # Agent's starting facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook's index\n  # This maps string names (e.g., \"WOOD\") to their integer representations.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Determine grid dimensions for boundary checks\n  grid_rows, grid_cols, _ = initial_grid.shape # Correctly parse shape as (rows, columns, ...)\n\n  # Retrieve integer action IDs from the environment's action specifications\n  # These are the numeric codes for actions like moving forward, turning, and using.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # Corresponds to moving forward in the current direction\n  TURN_LEFT_ACTION = action_map['LEFT']     # Corresponds to turning 90 degrees left\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Corresponds to turning 90 degrees right\n  USE_ACTION = action_map['USE']            # Action to interact with the cell directly in front\n\n  # Direction vectors (dr, dc) for agent's facing direction.\n  # These define how row and column coordinates change when moving \"forward\".\n  # Mapping: 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row-1, col)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # Mapping for updating agent's direction when turning left or right.\n  # Directions cycle: 0 -> 1 -> 2 -> 3 -> 0 for left turns.\n  TURN_LEFT_DIR_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # RIGHT->UP->LEFT->DOWN->RIGHT\n  TURN_RIGHT_DIR_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # RIGHT->DOWN->LEFT->UP->RIGHT\n\n  # Get indices of entities that block agent movement (e.g., BOUNDARY, WATER, WORKSHOP_X).\n  # The agent cannot walk onto cells containing these kinds.\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # BFS Initialization:\n  # The queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_to_reach_here)\n  # A state includes both position and orientation because actions (like 'USE') depend on direction,\n  # and possible next positions depend on current direction.\n  queue = collections.deque([((initial_agent_pos, initial_agent_dir), [])])\n  \n  # The visited set stores (position_tuple, direction_int) to avoid redundant computations, cycles,\n  # and ensure finding the shortest path (BFS guarantees this for unweighted graphs).\n  visited = {(initial_agent_pos, initial_agent_dir)}\n\n  # This variable will store the sequence of actions to reach the state where the primitive is in front.\n  path_to_primitive_adjacency = None \n\n  while queue:\n      (current_pos, current_dir), path_taken = queue.popleft()\n      current_row, current_col = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent from the current state.\n      # If it is, we've found our target \"adjacency\" state for collection.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_cell_row, front_cell_col = current_row + front_dr, current_col + front_dc\n      \n      # Ensure the cell in front is within grid boundaries before checking its contents.\n      if (0 <= front_cell_row < grid_rows and 0 <= front_cell_col < grid_cols):\n          # Check if the primitive is present in this front cell.\n          if initial_grid[front_cell_row, front_cell_col, primitive_id] > 0:\n              path_to_primitive_adjacency = path_taken\n              break # Target state found, stop BFS.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n      # These actions change the agent's state (position and/or direction).\n\n      # Try Move Forward action:\n      move_dr, move_dc = DIR_TO_DRDC[current_dir] # Delta for moving forward\n      next_row, next_col = current_row + move_dr, current_col + move_dc\n      next_pos = (next_row, next_col)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if the potential next position is valid (within grid bounds)\n      # and if this specific (position, direction) state has not been visited yet.\n      if (0 <= next_row < grid_rows and 0 <= next_col < grid_cols and\n          (next_pos, next_dir) not in visited):\n          \n          # Determine if the next cell is walkable.\n          # A cell is not walkable if it contains any non-grabbable entity (like a wall, water, workshop),\n          # or if it contains the primitive itself (agent must be adjacent to 'use', not on top).\n          is_walkable = True\n          for kind_idx in non_walkable_kinds_indices:\n              if initial_grid[next_row, next_col, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          # Agent cannot walk onto the primitive it wants to collect.\n          if initial_grid[next_row, next_col, primitive_id] > 0:\n              is_walkable = False\n\n          if is_walkable:\n              visited.add((next_pos, next_dir)) # Mark new state as visited\n              # Add to queue with the updated path, including the MOVE_FORWARD_ACTION.\n              queue.append(((next_pos, next_dir), path_taken + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left action:\n      next_dir_left = TURN_LEFT_DIR_MAP[current_dir] # Calculate new direction after turning left\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left)) # Mark new state as visited\n          # Add to queue with updated path, including the TURN_LEFT_ACTION.\n          queue.append(((current_pos, next_dir_left), path_taken + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right action:\n      next_dir_right = TURN_RIGHT_DIR_MAP[current_dir] # Calculate new direction after turning right\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right)) # Mark new state as visited\n          # Add to queue with updated path, including the TURN_RIGHT_ACTION.\n          queue.append(((current_pos, next_dir_right), path_taken + [TURN_RIGHT_ACTION]))\n\n  # After BFS completes (either target found or queue empty):\n  # If a path to the target adjacency state was found, append the USE action to complete the collection.\n  if path_to_primitive_adjacency is not None:\n      actions_list.extend(path_to_primitive_adjacency)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T06:02:08.213943", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n    This function uses a Breadth-First Search (BFS) to find the shortest sequence of\n    movement actions to reach a position adjacent to the specified primitive,\n    followed by a 'USE' action to collect it.\n    \n    Args:\n        env (env.CraftLab): The CraftLab object representing the current simulation state.\n        primitive (str): The name of the primitive item to collect (e.g., \"WOOD\", \"STONE\").\n\n    Returns:\n        List[int]: A sequence of integer action indices to execute. An empty list\n                   is returned if the primitive is unreachable or not found on the grid.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state # Access the underlying CraftState for detailed info\n\n  initial_grid = current_state.grid # (rows, columns, kinds) numpy array\n  initial_agent_pos = current_state.pos  # Agent's starting position (row, col)\n  initial_agent_dir = current_state.dir  # Agent's starting facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook's index\n  # This maps string names (e.g., \"WOOD\") to their integer representations.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Determine grid dimensions for boundary checks\n  grid_rows, grid_cols, _ = initial_grid.shape\n\n  # Retrieve integer action IDs from the environment's action specifications\n  # These are the numeric codes for actions like moving forward, turning, and using.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # Corresponds to moving forward in the current direction\n  TURN_LEFT_ACTION = action_map['LEFT']     # Corresponds to turning 90 degrees left\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Corresponds to turning 90 degrees right\n  USE_ACTION = action_map['USE']            # Action to interact with the cell directly in front\n\n  # Direction vectors (dr, dc) for agent's facing direction.\n  # These define how row and column coordinates change when moving \"forward\".\n  # Mapping: 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # Mapping for updating agent's direction when turning left or right.\n  # Directions cycle: 0 -> 1 -> 2 -> 3 -> 0 for left turns.\n  TURN_LEFT_DIR_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # RIGHT->UP->LEFT->DOWN->RIGHT\n  TURN_RIGHT_DIR_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # RIGHT->DOWN->LEFT->UP->RIGHT\n\n  # Define all kinds that block agent movement into a cell.\n  # This includes non-grabbable entities (like walls, water, workshops) AND the primitive itself.\n  # The agent needs to be *adjacent* to the primitive to 'USE' it, not occupy its cell.\n  blocking_kinds_indices = current_state.world.non_grabbable_indices.union({primitive_id})\n\n  # BFS Initialization:\n  # The queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_to_reach_here)\n  # A state includes both position and orientation because actions (like 'USE') depend on direction,\n  # and possible next positions depend on current direction.\n  queue = collections.deque([((initial_agent_pos, initial_agent_dir), [])])\n  \n  # The visited set stores (position_tuple, direction_int) to avoid redundant computations, cycles,\n  # and ensure finding the shortest path (BFS guarantees this for unweighted graphs).\n  visited = {(initial_agent_pos, initial_agent_dir)}\n\n  # This variable will store the sequence of actions to reach the state where the primitive is in front.\n  path_to_primitive_adjacency = None \n\n  while queue:\n      (current_pos, current_dir), path_taken = queue.popleft()\n      current_row, current_col = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent from the current state.\n      # If it is, we've found our target \"adjacency\" state for collection.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_cell_row, front_cell_col = current_row + front_dr, current_col + front_dc\n      \n      # Ensure the cell in front is within grid boundaries before checking its contents.\n      if (0 <= front_cell_row < grid_rows and 0 <= front_cell_col < grid_cols):\n          # Check if the primitive is present in this front cell.\n          if initial_grid[front_cell_row, front_cell_col, primitive_id] > 0:\n              path_to_primitive_adjacency = path_taken\n              break # Target state found, stop BFS.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n      # These actions change the agent's state (position and/or direction).\n\n      # Try Move Forward action:\n      move_dr, move_dc = DIR_TO_DRDC[current_dir] # Delta for moving forward\n      next_row, next_col = current_row + move_dr, current_col + move_dc\n      next_pos = (next_row, next_col)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if the potential next position is valid (within grid bounds)\n      # and if this specific (position, direction) state has not been visited yet.\n      if (0 <= next_row < grid_rows and 0 <= next_col < grid_cols and\n          (next_pos, next_dir) not in visited):\n          \n          # Determine if the next cell is walkable.\n          # A cell is not walkable if it contains any kind from the 'blocking_kinds_indices' set.\n          is_walkable = True\n          for kind_idx in blocking_kinds_indices:\n              if initial_grid[next_row, next_col, kind_idx] > 0:\n                  is_walkable = False\n                  break\n\n          if is_walkable:\n              visited.add((next_pos, next_dir)) # Mark new state as visited\n              # Add to queue with the updated path, including the MOVE_FORWARD_ACTION.\n              queue.append(((next_pos, next_dir), path_taken + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left action:\n      next_dir_left = TURN_LEFT_DIR_MAP[current_dir] # Calculate new direction after turning left\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left)) # Mark new state as visited\n          # Add to queue with updated path, including the TURN_LEFT_ACTION.\n          queue.append(((current_pos, next_dir_left), path_taken + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right action:\n      next_dir_right = TURN_RIGHT_DIR_MAP[current_dir] # Calculate new direction after turning right\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right)) # Mark new state as visited\n          # Add to queue with updated path, including the TURN_RIGHT_ACTION.\n          queue.append(((current_pos, next_dir_right), path_taken + [TURN_RIGHT_ACTION]))\n\n  # After BFS completes (either target found or queue empty):\n  # If a path to the target adjacency state was found, append the USE action to complete the collection.\n  if path_to_primitive_adjacency is not None:\n      actions_list.extend(path_to_primitive_adjacency)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T06:02:48.195621", "function_name": "collect", "function_body": "", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-08-01T06:02:49.406572", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  ACTION_UP = action_map[\"UP\"]\n  ACTION_DOWN = action_map[\"DOWN\"]\n  ACTION_LEFT = action_map[\"LEFT\"]\n  ACTION_RIGHT = action_map[\"RIGHT\"]\n  ACTION_USE = action_map[\"USE\"]\n\n  # Get current state details from the environment\n  current_state = env._current_state\n  current_grid = current_state.grid\n  start_pos = current_state.pos\n  grid_width, grid_height, _ = current_grid.shape\n\n  # Convert the primitive name (string) to its corresponding integer index ID.\n  # Use .lower() for robustness and the __getitem__ method (via []) for lookup.\n  # This returns an integer ID or None if the item is not found.\n  primitive_id = env.world.cookbook.index[primitive.lower()]\n  if primitive_id is None:\n    # If the primitive name is not found in the cookbook's index, it cannot be collected.\n    return []\n\n  # Determine if the target primitive is grabbable (can be picked up with ACTION_USE).\n  # Items like 'WOOD' or 'IRON' are grabbable, while 'WORKSHOP0' or 'WATER' are not.\n  grabbable_kind_ids_set = set(env.world.grabbable_indices)\n  is_grabbable_target = (primitive_id in grabbable_kind_ids_set)\n\n  # Optimization: If the primitive is grabbable AND already in inventory,\n  # no further collection actions are needed.\n  # This check does not apply to non-grabbable items (like workshops) because\n  # \"collecting\" them means reaching their location, not acquiring them in inventory.\n  if is_grabbable_target and current_state.inventory[primitive_id] > 0:\n      return []\n\n  # Get indices for entities that are generally impassable (non-grabbable and block agent movement).\n  # This set typically includes things like \"water\", \"stone\", \"workshop\", \"boundary\".\n  impassable_kind_ids_set = set(env.world.non_grabbable_indices)\n\n  # BFS initialization for pathfinding.\n  # The queue stores tuples: (current_position (x, y), list_of_actions_taken_to_reach_here).\n  queue = collections.deque([(start_pos, [])])\n  # The visited set stores positions (x, y) to avoid cycles and redundant exploration.\n  visited = {start_pos}\n\n  # Define possible moves, their corresponding (dx, dy) deltas, and action IDs.\n  move_actions_with_deltas = [\n      (ACTION_UP, (0, -1)),    # Move North (decreases y-coordinate)\n      (ACTION_DOWN, (0, 1)),   # Move South (increases y-coordinate)\n      (ACTION_LEFT, (-1, 0)),  # Move West (decreases x-coordinate)\n      (ACTION_RIGHT, (1, 0)),  # Move East (increases x-coordinate)\n  ]\n\n  while queue:\n    current_pos, path_so_far = queue.popleft()\n    cx, cy = current_pos\n\n    # Check if the target primitive is present at the current cell.\n    # The grid stores counts of items, so we check if the count is greater than 0.\n    if current_grid[cx, cy, primitive_id] > 0:\n      # The primitive has been found at the current location.\n      if is_grabbable_target:\n        # If it's a grabbable item (e.g., WOOD, IRON), we append ACTION_USE to pick it up.\n        return path_so_far + [ACTION_USE]\n      else:\n        # If it's a non-grabbable feature (e.g., WORKSHOP0, WATER),\n        # \"collecting\" it simply means reaching its location. No ACTION_USE is needed.\n        return path_so_far\n\n    # Explore all valid neighboring cells from the current position.\n    for action_to_take, (dx, dy) in move_actions_with_deltas:\n      nx, ny = cx + dx, cy + dy  # Calculate the neighbor's coordinates\n      next_pos = (nx, ny)\n\n      # 1. Check if the neighbor position is within the grid boundaries.\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue\n\n      # 2. Check if the neighbor cell has already been visited in this BFS.\n      if next_pos in visited:\n        continue\n\n      # 3. Check if the neighbor cell contains any impassable obstacles.\n      # A cell is considered an obstacle if it contains any item from `impassable_kind_ids_set`\n      # that is *not* the `primitive_id` we are trying to collect. This allows the agent\n      # to pathfind onto the target primitive's tile even if the target itself is generally\n      # non-grabbable (e.g., moving onto a workshop tile when trying to \"collect\" a workshop).\n      is_obstacle_cell = False\n      for kind_id in impassable_kind_ids_set:\n        # If the cell contains an impassable kind that is *not* our target primitive AND its count is > 0\n        if kind_id != primitive_id and current_grid[nx, ny, kind_id] > 0:\n          is_obstacle_cell = True\n          break  # Found a blocking obstacle, no need to check further items in this cell\n      \n      if is_obstacle_cell:\n        continue  # Skip this neighbor if it's an impassable obstacle\n\n      # If the neighbor is valid (within bounds, not visited, and traversable),\n      # add it to the queue with the updated path and mark it as visited.\n      visited.add(next_pos)\n      queue.append((next_pos, path_so_far + [action_to_take]))\n\n  # If the BFS completes and the primitive was not found anywhere accessible on the grid,\n  # return an empty list, indicating that it cannot be collected from the current state.\n  return []", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T06:03:26.645012", "function_name": "collect", "function_body": "  actions = []\n\n  # 1. Validate primitive and get its index\n  try:\n    primitive_idx = env.world.cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Get action mappings from the environment's action_specs\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # 3. Get current state information\n  current_state = env._current_state\n  start_pos = current_state.pos  # (row, col) tuple\n  start_dir = current_state.dir  # 0:South, 1:North, 2:West, 3:East\n  global_grid = current_state.grid\n  grid_rows, grid_cols, _ = global_grid.shape # Grid dimensions (Height, Width)\n\n  # 4. Determine primitive type for collection logic\n  primitive_is_grabbable = primitive_idx in env.world.grabbable_indices\n  primitive_is_workshop = primitive_idx in env.world.workshop_indices\n\n  # 5. Define movement deltas and corresponding new agent directions\n  # (delta_row, delta_col), new_direction_value\n  movement_actions = {\n      ACTION_UP: ((-1, 0), 1),    # Move UP (row-1), new direction is North (1)\n      ACTION_DOWN: ((1, 0), 0),   # Move DOWN (row+1), new direction is South (0)\n      ACTION_LEFT: ((0, -1), 2),  # Move LEFT (col-1), new direction is West (2)\n      ACTION_RIGHT: ((0, 1), 3)   # Move RIGHT (col+1), new direction is East (3)\n  }\n\n  # 6. Define deltas for the cell \"in front\" of the agent based on its direction\n  # This is used to check where the 'USE' action applies for non-grabbable items.\n  # (delta_row, delta_col)\n  direction_to_forward_delta = {\n      0: (1, 0),  # Facing South: cell (row+1, col)\n      1: (-1, 0), # Facing North: cell (row-1, col)\n      2: (0, -1), # Facing West: cell (row, col-1)\n      3: (0, 1)   # Facing East: cell (row, col+1)\n  }\n\n  # 7. Identify general obstacle indices (non-grabbable items block movement)\n  obstacle_indices = env.world.non_grabbable_indices\n\n  def is_valid_position(r, c, target_primitive_idx, is_target_workshop):\n      \"\"\"\n      Checks if (r, c) is within grid bounds and is a traversable cell for agent movement.\n      A cell is traversable if it's in bounds and doesn't contain a blocking obstacle.\n      Special rule: If the target primitive is a workshop, the agent *can* move onto it,\n      even if it's generally non-grabbable (as workshops are locations to reach, not obstacles).\n      \"\"\"\n      # Check bounds\n      if not (0 <= r < grid_rows and 0 <= c < grid_cols):\n          return False\n      \n      # Check if the cell contains any blocking non-grabbable item.\n      # Iterate through all possible kinds that might be present at (r,c)\n      for kind_idx in env.world.cookbook.kinds: \n          if global_grid[r, c, kind_idx] > 0: # If this 'kind_idx' is present at (r,c)\n              if kind_idx in obstacle_indices: # If this kind is a generally non-grabbable item\n                  # Allow movement onto the target workshop itself, if that's what we're collecting.\n                  if kind_idx == target_primitive_idx and is_target_workshop:\n                      continue # This specific non-grabbable (the target workshop) is NOT an obstacle for this path\n                  else:\n                      # Otherwise, it's a general blocking obstacle (e.g., WATER, STONE, BOUNDARY, or other workshops)\n                      return False \n      return True\n  \n  # 8. BFS Initialization\n  # Queue stores tuples: ((current_position (r,c), current_direction (int)), path_so_far (list of actions))\n  queue = collections.deque([((start_pos, start_dir), [])])\n  \n  # Visited set stores ((r,c), dir) tuples to avoid redundant computations and cycles.\n  visited = {(start_pos, start_dir)}\n\n  path_to_collection_spot = None # Stores the actions to reach the state where 'USE' can be applied.\n  needs_use_action = False      # Flag to indicate if a 'USE' action is required at the end.\n  \n  # 9. BFS Loop\n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      r, c = current_pos\n\n      # Check if the current state (position and direction) is a valid spot to collect the primitive.\n      collection_achievable_from_current_state = False\n\n      if primitive_is_workshop:\n          # For workshops, the agent just needs to be ON the workshop's cell.\n          # No 'USE' action is typically performed to 'collect' a workshop itself.\n          if global_grid[r, c, primitive_idx] > 0:\n              collection_achievable_from_current_state = True\n              needs_use_action = False\n      elif primitive_is_grabbable:\n          # For grabbable items (e.g., WOOD), the agent must be ON the cell and 'USE' it.\n          if global_grid[r, c, primitive_idx] > 0:\n              collection_achievable_from_current_state = True\n              needs_use_action = True\n      else: # Non-grabbable, non-workshop items (e.g., WATER, STONE)\n          # The agent must be ADJACENT and FACING the primitive, then 'USE' it.\n          fwd_dr, fwd_dc = direction_to_forward_delta[current_dir]\n          target_r, target_c = r + fwd_dr, c + fwd_dc\n\n          # Check if the cell directly in front is within bounds and contains the primitive.\n          if (0 <= target_r < grid_rows and 0 <= target_c < grid_cols and\n              global_grid[target_r, target_c, primitive_idx] > 0):\n              collection_achievable_from_current_state = True\n              needs_use_action = True\n      \n      if collection_achievable_from_current_state:\n          path_to_collection_spot = path_so_far\n          break # Found the shortest path to a collection spot.\n\n      # Explore valid neighbors by trying all possible movement actions (UP, DOWN, LEFT, RIGHT).\n      for action_val, ((dr, dc), new_dir_val) in movement_actions.items():\n          next_r, next_c = r + dr, c + dc\n          next_pos = (next_r, next_c)\n          next_state_key = (next_pos, new_dir_val) # State includes position and direction\n\n          # Only proceed if the next position is valid to move onto and this state hasn't been visited.\n          if (is_valid_position(next_r, next_c, primitive_idx, primitive_is_workshop) and\n              next_state_key not in visited):\n              \n              visited.add(next_state_key)\n              queue.append((next_state_key, path_so_far + [action_val]))\n  \n  # 10. Construct final action sequence\n  if path_to_collection_spot is not None:\n      # If a path to the collection spot was found, append the 'USE' action if needed.\n      if needs_use_action:\n          actions = path_to_collection_spot + [ACTION_USE]\n      else:\n          actions = path_to_collection_spot\n  \n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T06:03:27.856426", "function_name": "collect", "function_body": "  actions = []\n\n  # 1. Validate primitive and get its index\n  try:\n    primitive_idx = env.world.cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Get action mappings from the environment's action_specs\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # 3. Get current state information\n  current_state = env._current_state\n  start_pos = current_state.pos  # (row, col) tuple\n  start_dir = current_state.dir  # 0:South, 1:North, 2:West, 3:East\n  global_grid = current_state.grid\n  grid_rows, grid_cols, _ = global_grid.shape # Grid dimensions (Height, Width, Kinds)\n\n  # 4. Determine primitive type for collection logic\n  # Workshops are locations to reach. Grabbable items are picked up when on their cell + USE.\n  # Non-grabbable, non-workshop items require being adjacent + facing + USE.\n  primitive_is_grabbable = primitive_idx in env.world.grabbable_indices\n  primitive_is_workshop = primitive_idx in env.world.workshop_indices\n  # This covers items like STONE, WATER, etc., that are non-grabbable and not workshops.\n  primitive_is_adjacent_use_item = (primitive_idx in env.world.non_grabbable_indices and\n                                    not primitive_is_workshop)\n\n  # 5. Define movement deltas and corresponding new agent directions\n  # Maps DMLab action value to ((delta_row, delta_col), new_direction_value)\n  # CraftState.dir: 0=South (DOWN), 1=North (UP), 2=West (LEFT), 3=East (RIGHT).\n  movement_actions_map = {\n      ACTION_UP: ((-1, 0), 1),    # Move UP, agent faces North\n      ACTION_DOWN: ((1, 0), 0),   # Move DOWN, agent faces South\n      ACTION_LEFT: ((0, -1), 2),  # Move LEFT, agent faces West\n      ACTION_RIGHT: ((0, 1), 3)   # Move RIGHT, agent faces East\n  }\n\n  # 6. Define deltas for the cell \"in front\" of the agent based on its direction\n  # This is crucial for determining where the USE action will apply for adjacent interactions.\n  # Maps CraftState.dir value to (delta_row, delta_col) for the cell in front.\n  direction_to_forward_delta = {\n      0: (1, 0),  # Facing South: cell (row+1, col)\n      1: (-1, 0), # Facing North: cell (row-1, col)\n      2: (0, -1), # Facing West: cell (row, col-1)\n      3: (0, 1)   # Facing East: cell (row, col+1)\n  }\n\n  # 7. Identify general obstacle indices (non-grabbable items typically block movement)\n  # This set includes WATER, STONE, BOUNDARY, etc., and potentially other workshops.\n  obstacle_indices = env.world.non_grabbable_indices\n\n  def is_traversable(r, c):\n      \"\"\"\n      Checks if (r, c) is within grid bounds and is a cell the agent can step onto.\n      A cell is traversable if it's in bounds and does not contain any blocking obstacle.\n      Special rule: If the cell contains the *target workshop* we are trying to reach,\n      it is considered traversable, allowing the agent to stand on it.\n      \"\"\"\n      # Check bounds first\n      if not (0 <= r < grid_rows and 0 <= c < grid_cols):\n          return False\n      \n      # Iterate through all kinds that might be present at (r,c)\n      for kind_idx in env.world.cookbook.kinds: \n          if global_grid[r, c, kind_idx] > 0: # If an item of 'kind_idx' is present at (r,c)\n              if kind_idx in obstacle_indices: # If this kind is a generally non-grabbable item\n                  # If the current kind_idx is the *target workshop* and the target is a workshop,\n                  # then it's NOT an obstacle for movement *onto* itself.\n                  if kind_idx == primitive_idx and primitive_is_workshop:\n                      continue # Allowed to step on the target workshop\n                  else:\n                      # Otherwise, it's a blocking obstacle (e.g., Water, Stone, Boundary,\n                      # or a workshop that is NOT the current target primitive).\n                      return False \n      return True\n  \n  # 8. BFS Initialization\n  # Queue stores tuples: ((current_position (r,c), current_direction (int)), path_so_far (list of actions))\n  queue = collections.deque([(((start_pos), start_dir), [])])\n  \n  # Visited set stores ((r,c), dir) tuples to avoid redundant computations and cycles.\n  visited = {((start_pos), start_dir)}\n\n  path_to_collection_spot = None # Stores the sequence of actions to reach the target state.\n  needs_use_action = False      # Flag to indicate if a 'USE' action is required at the end.\n  \n  # 9. BFS Loop\n  while queue:\n      ((r, c), current_dir_val), path_so_far = queue.popleft()\n\n      # Check if the current state (position and direction) satisfies the collection goal.\n      collection_achieved_in_current_state = False\n\n      if primitive_is_workshop:\n          # For workshops, the agent just needs to be ON the workshop's cell.\n          # We check if the primitive_idx is present at the current location (r, c).\n          if global_grid[r, c, primitive_idx] > 0:\n              collection_achieved_in_current_state = True\n              needs_use_action = False # No 'USE' action for reaching a workshop.\n      elif primitive_is_grabbable:\n          # For grabbable items (e.g., WOOD, IRON), the agent must be ON the cell\n          # containing the item, and then 'USE' it.\n          if global_grid[r, c, primitive_idx] > 0:\n              collection_achieved_in_current_state = True\n              needs_use_action = True\n      elif primitive_is_adjacent_use_item:\n          # For non-grabbable, non-workshop items (e.g., WATER, STONE),\n          # the agent must be ADJACENT to the primitive AND facing it, then 'USE' it.\n          fwd_dr, fwd_dc = direction_to_forward_delta[current_dir_val]\n          target_r_in_front, target_c_in_front = r + fwd_dr, c + fwd_dc\n\n          # Check if the cell directly in front contains the primitive.\n          if (0 <= target_r_in_front < grid_rows and 0 <= target_c_in_front < grid_cols and\n              global_grid[target_r_in_front, target_c_in_front, primitive_idx] > 0):\n              collection_achieved_in_current_state = True\n              needs_use_action = True\n      \n      if collection_achieved_in_current_state:\n          path_to_collection_spot = path_so_far\n          break # Found the shortest path to a collection spot.\n\n      # Explore valid neighbors by trying all possible movement actions (UP, DOWN, LEFT, RIGHT).\n      for action_val, ((dr, dc), new_dir_val) in movement_actions_map.items():\n          next_r, next_c = r + dr, c + dc\n          next_pos = (next_r, next_c)\n          next_state_key = (next_pos, new_dir_val) # State includes position and direction\n\n          # Only proceed if the next position is valid to move onto and this state hasn't been visited.\n          if is_traversable(next_r, next_c) and next_state_key not in visited:\n              visited.add(next_state_key)\n              queue.append((next_state_key, path_so_far + [action_val]))\n  \n  # 10. Construct final action sequence\n  if path_to_collection_spot is not None:\n      # If a path to the collection spot was found, append the 'USE' action if needed.\n      if needs_use_action:\n          actions = path_to_collection_spot + [ACTION_USE]\n      else:\n          actions = path_to_collection_spot\n  \n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T06:05:01.285231", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with pathfinding.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Pre-calculate all locations of the primitive on the grid.\n  # This is used for the A* heuristic to estimate distance to the goal.\n  grid_width, grid_height, _ = current_state.grid.shape\n  primitive_locations = []\n  for r in range(grid_width):\n      for c in range(grid_height):\n          if current_state.grid[r, c, i_kind] == 1:\n              primitive_locations.append((r, c))\n\n  # If no primitive of this kind exists on the grid, it's unreachable.\n  if not primitive_locations:\n      return []\n\n  # Heuristic function for A*: Manhattan distance to the nearest primitive location.\n  # This provides an admissible (never overestimates) heuristic for grid movement.\n  def _calculate_heuristic(pos: tuple[int, int], target_locations: list[tuple[int, int]]) -> int:\n      if not target_locations:\n          return float('inf') # No targets, effectively infinite cost\n      \n      min_dist = float('inf')\n      for tr, tc in target_locations:\n          dist = abs(pos[0] - tr) + abs(pos[1] - tc)\n          min_dist = min(min_dist, dist)\n      return min_dist\n\n  # 6. Initialize A* search.\n  # The priority queue 'q' stores tuples: (f_cost, g_cost, CraftState object, list of actions).\n  # f_cost = g_cost + h_cost\n  # g_cost = actual cost (number of actions) from start to current state.\n  # h_cost = estimated cost (heuristic) from current state to goal.\n  q = [] \n  # 'g_scores' tracks the cheapest g_cost found so far to reach a specific (pos, dir) state.\n  # This helps avoid re-exploring states via longer paths, crucial for A*.\n  g_scores = {} \n\n  initial_g_cost = 0\n  initial_h_cost = _calculate_heuristic(current_state.pos, primitive_locations)\n  initial_f_cost = initial_g_cost + initial_h_cost\n\n  # Push the initial state onto the priority queue.\n  heapq.heappush(q, (initial_f_cost, initial_g_cost, current_state, []))\n  g_scores[(current_state.pos[0], current_state.pos[1], current_state.dir)] = initial_g_cost\n\n  # Set a maximum number of states to explore to prevent excessively long searches\n  # or infinite loops in very complex or unreachable scenarios.\n  # The total number of unique (position, direction) states is `grid_width * grid_height * 4`.\n  # A multiplier is added for robustness.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 3 \n  explored_states_count = 0\n\n  # 7. A* Loop.\n  while q:\n    f_cost, g_cost, state, path = heapq.heappop(q) # Pop the state with the lowest f_cost\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    current_state_key = (current_r, current_c, current_dir)\n\n    # If we have already found a shorter or equal cost path to this state, skip this one.\n    # This handles cases where `heapq` might return an outdated entry.\n    if g_cost > g_scores.get(current_state_key, float('inf')):\n        continue\n    \n    explored_states_count += 1\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    # Goal Check: Can we collect the primitive from this `state`?\n    # First, check if the desired primitive is located in the 3x3 neighborhood of the agent.\n    if state.next_to(i_kind):\n        # If the primitive is nearby, iterate through all 4 possible directions the agent could face.\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            # Calculate the coordinates of the cell that would be directly in front of the agent\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the calculated facing cell is within grid bounds\n            # AND if that specific cell contains an instance of the desired primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # We've found the primitive on the grid and can face it.\n                # Now, simulate the turns and the 'USE' action to verify collection.\n                \n                # 1. Simulate the turning actions to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    # state.step() returns a *new* CraftState object, ensuring proper simulation.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store the inventory *before* attempting the 'USE' action.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # 2. Simulate the 'USE' action from the state where the agent is facing the primitive.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # 3. Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies that the primitive was successfully collected (e.g., if tools were present).\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    # Success! The primitive was collected.\n                    # The complete sequence of actions is:\n                    # (actions to reach current state) + (turning actions) + (USE action to collect).\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions.\n    for action in move_actions:\n      # Simulate the action to get the next state without modifying the current environment.\n      _, next_state = state.step(action)\n      next_g_cost = g_cost + 1 # Each move action costs 1 step\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir)\n\n      # If this path to next_state is shorter than any previously found path, or it's a new state.\n      if next_g_cost < g_scores.get(next_state_key, float('inf')):\n        g_scores[next_state_key] = next_g_cost\n        next_h_cost = _calculate_heuristic(next_state.pos, primitive_locations)\n        next_f_cost = next_g_cost + next_h_cost\n        # Push the new state onto the priority queue.\n        heapq.heappush(q, (next_f_cost, next_g_cost, next_state, path + [action]))\n\n  # 8. If the A* queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-08-01T06:05:02.935281", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` by tracking inventory in BFS visited states.\n    \n    This improvement makes the BFS more robust by including the agent's current\n    inventory state as part of the 'visited' set key. This allows the algorithm\n    to correctly find paths where collecting a tool (e.g., an axe as a grabbable item)\n    is an intermediate step to then collect the target primitive (e.g., wood).\n    The USE action is also explored generally, not just when facing the target primitive,\n    to account for picking up such intermediate items.\n\n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect.\n\n    Returns:\n        List[int]: A sequence of action indices to execute.\n  \"\"\"\n  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # IMPROVEMENT: The 'visited' set now includes the agent's inventory as part of the state key.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing, allowing BFS to distinguish\n  # between states that are identical in position/direction but differ in inventory (e.g., having a tool vs. not).\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Increased MAX_EXPLORED_STATES due to the larger state space when tracking inventory.\n  # This is a heuristic and may need tuning for specific environment complexities.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`).\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the USE action from the current position, even if not directly on the target primitive.\n    # This is important if using an item at the current position (e.g., picking up a tool)\n    # can change the inventory state, which might be necessary for later steps to collect the primitive.\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if the USE action resulted in a meaningful state change (inventory, position, or direction).\n    # This prevents adding redundant states to the queue if USE had no effect.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 6, "scores": {"3": 1.5}}
