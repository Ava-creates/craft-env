{"timestamp": "2025-08-01T00:27:39.441038", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  \n  # 1. Get primitive index. If primitive name is not known, return empty path.\n  prim_idx = cookbook.index.get(primitive)\n  if prim_idx is None:\n      return []\n\n  # 2. If the primitive is a grabbable item and already in inventory, no need to collect.\n  if prim_idx in env.world.grabbable_indices and state.inventory[prim_idx] > 0:\n      return []\n\n  # Define action mappings and related constants\n  ACTION_MAP = env.action_specs()\n  ACTION_UP = ACTION_MAP['UP']\n  ACTION_DOWN = ACTION_MAP['DOWN']\n  ACTION_LEFT = ACTION_MAP['LEFT']\n  ACTION_RIGHT = ACTION_MAP['RIGHT']\n  ACTION_USE = ACTION_MAP['USE']\n\n  # Map (dx, dy) relative to current position to movement action index\n  DELTAS_TO_ACTION = {\n      (0, -1): ACTION_UP,    # Move Up (decreases Y)\n      (0, 1): ACTION_DOWN,   # Move Down (increases Y)\n      (-1, 0): ACTION_LEFT,  # Move Left (decreases X)\n      (1, 0): ACTION_RIGHT   # Move Right (increases X)\n  }\n  \n  # Map agent's internal direction index to (dx, dy) for the cell in front\n  # Directions: 0=North (up), 1=East (right), 2=South (down), 3=West (left)\n  DIR_TO_DELTA = {\n      0: (0, -1), # North: (x, y-1)\n      1: (1, 0),  # East: (x+1, y)\n      2: (0, 1),  # South: (x, y+1)\n      3: (-1, 0)  # West: (x-1, y)\n  }\n  \n  # Map movement action to the new direction the agent will face\n  MOVE_ACTION_TO_NEW_DIR = {\n      ACTION_UP: 0,    # Moving UP makes agent face North (0)\n      ACTION_RIGHT: 1, # Moving RIGHT makes agent face East (1)\n      ACTION_DOWN: 2,  # Moving DOWN makes agent face South (2)\n      ACTION_LEFT: 3   # Moving LEFT makes agent face West (3)\n  }\n\n  # Grid dimensions\n  WIDTH, HEIGHT, _ = state.grid.shape\n\n  # Identify indices for common obstacles\n  boundary_idx = cookbook.index.get(\"BOUNDARY\")\n  water_idx = cookbook.index.get(\"WATER\")\n  bridge_idx = cookbook.index.get(\"BRIDGE\")\n\n  # BFS setup\n  start_pos_x, start_pos_y = state.pos\n  start_dir = state.dir\n  \n  # Queue stores ( (x, y, current_dir), path_to_this_state )\n  q = collections.deque([((start_pos_x, start_pos_y, start_dir), [])])\n  \n  # Visited set stores (x, y, current_dir) to avoid cycles and redundant exploration\n  visited = {(start_pos_x, start_pos_y, start_dir)}\n\n  while q:\n    ((curr_x, curr_y, curr_dir), path_so_far) = q.popleft()\n\n    # Check if the primitive is directly in front of the agent from current_pos\n    # (i.e., can we USE it from here?)\n    front_dx, front_dy = DIR_TO_DELTA[curr_dir]\n    target_obj_x, target_obj_y = curr_x + front_dx, curr_y + front_dy\n\n    # Ensure the target cell for the primitive is within grid bounds\n    if 0 <= target_obj_x < WIDTH and 0 <= target_obj_y < HEIGHT:\n      # If the primitive is found at the cell directly in front\n      if state.grid[target_obj_x, target_obj_y, prim_idx] > 0:\n        final_actions = list(path_so_far)\n        \n        # If it's a grabbable item, we need to USE it to collect it.\n        # Otherwise (e.g., workshop), just reaching the adjacent position is \"collecting\" it.\n        if prim_idx in env.world.grabbable_indices:\n          final_actions.append(ACTION_USE)\n        return final_actions\n\n    # Explore neighbors by taking movement actions\n    for action_val, (move_dx, move_dy) in DELTAS_TO_ACTION.items():\n      next_x, next_y = curr_x + move_dx, curr_y + move_dy\n      next_dir = MOVE_ACTION_TO_NEW_DIR[action_val] # Agent's new direction after this move\n\n      # Check bounds for the next position\n      if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n        continue\n\n      # Check for obstacles at the next position\n      is_blocked = False\n      \n      # 1. Check for BOUNDARY\n      if boundary_idx is not None and state.grid[next_x, next_y, boundary_idx] > 0:\n          is_blocked = True\n      \n      # 2. Check for WORKSHOPS (assuming workshops are impassable terrain features)\n      if not is_blocked:\n          for workshop_kind_idx in env.world.workshop_indices:\n              if state.grid[next_x, next_y, workshop_kind_idx] > 0:\n                  is_blocked = True\n                  break\n      \n      # 3. Check for WATER (if no bridge in inventory)\n      if not is_blocked and water_idx is not None and state.grid[next_x, next_y, water_idx] > 0:\n          if bridge_idx is None or state.inventory[bridge_idx] == 0:\n              is_blocked = True\n      \n      if is_blocked:\n        continue # Cannot move to this cell\n\n      # Check if this (position, direction) state has been visited\n      next_state_tuple = (next_x, next_y, next_dir)\n      if next_state_tuple not in visited:\n        visited.add(next_state_tuple)\n        q.append((next_state_tuple, path_so_far + [action_val]))\n\n  # If no path found after exhausting the queue\n  return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-08-01T00:27:40.672838", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  \n  # 1. Get primitive index\n  try:\n    prim_idx = cookbook.index.index(primitive)\n  except ValueError: # If primitive string is not known in the cookbook's index\n    return []\n\n  # 2. Initial check: If the primitive is already in the agent's inventory and it's a grabbable item,\n  # then it's already \"collected\". Return an empty list of actions.\n  if prim_idx in env.world.grabbable_indices:\n      if state.inventory[prim_idx] > 0:\n          return [] \n\n  # Define action mappings and related constants\n  ACTION_MAP = env.action_specs()\n  ACTION_UP = ACTION_MAP[\"UP\"]\n  ACTION_DOWN = ACTION_MAP[\"DOWN\"]\n  ACTION_LEFT = ACTION_MAP[\"LEFT\"]\n  ACTION_RIGHT = ACTION_MAP[\"RIGHT\"]\n  ACTION_USE = ACTION_MAP[\"USE\"]\n\n  # Map movement actions to changes in (row, col) coordinates\n  # Assuming (0,0) is top-left, x/row increases downwards, y/col increases rightwards.\n  DELTAS_BY_ACTION = {\n      ACTION_UP: (-1, 0),    # Move to row-1, same col\n      ACTION_DOWN: (1, 0),   # Move to row+1, same col\n      ACTION_LEFT: (0, -1),  # Move to same row, col-1\n      ACTION_RIGHT: (0, 1)   # Move to same row, col+1\n  }\n  \n  # Map internal direction index (0:N, 1:S, 2:W, 3:E) to (dx, dy)\n  # (dx, dy) represents the cell *in front* of the agent when facing that direction.\n  DIR_TO_DELTA = {\n      0: (-1, 0), # North: facing cell at row-1\n      1: (1, 0),  # South: facing cell at row+1\n      2: (0, -1), # West: facing cell at col-1\n      3: (0, 1)   # East: facing cell at col+1\n  }\n  \n  # Map (dx, dy) of movement to the resulting direction index of the agent.\n  # When the agent moves (dx, dy), its new facing direction is assumed to be (dx, dy).\n  DELTA_TO_DIR = {v: k for k, v in DIR_TO_DELTA.items()}\n\n  # Grid dimensions\n  WIDTH, HEIGHT, _ = state.grid.shape\n\n  # Identify indices of known obstacles (cells that cannot be entered)\n  obstacle_indices = set()\n  try:\n    obstacle_indices.add(cookbook.index.index(\"BOUNDARY\"))\n  except ValueError: # \"BOUNDARY\" might not exist in all cookbooks\n    pass \n\n  water_idx = None\n  try:\n    water_idx = cookbook.index.index(\"WATER\")\n  except ValueError: # \"WATER\" might not exist\n    pass\n\n  bridge_idx = None\n  try:\n    bridge_idx = cookbook.index.index(\"BRIDGE\")\n  except ValueError: # \"BRIDGE\" might not exist\n    pass\n\n  # BFS setup\n  start_pos = state.pos\n  start_dir = state.dir\n  \n  # Queue for BFS: stores ( (current_x, current_y, current_direction), path_to_this_state )\n  q = collections.deque([((start_pos[0], start_pos[1], start_dir), [])])\n  \n  # Visited set: stores (x, y, current_direction) tuples to avoid cycles and redundant paths.\n  visited = {(start_pos[0], start_pos[1], start_dir)}\n\n  while q:\n    ((curr_x, curr_y, curr_dir), path_so_far) = q.popleft()\n\n    # Check if the primitive is directly in front of the agent at the current state.\n    # This determines if a 'USE' action (or just reaching) would collect it.\n    front_dx, front_dy = DIR_TO_DELTA[curr_dir]\n    target_x, target_y = curr_x + front_dx, curr_y + front_dy\n\n    # Ensure the target cell is within grid boundaries\n    if 0 <= target_x < WIDTH and 0 <= target_y < HEIGHT:\n      # If the primitive is found in the cell the agent is currently facing\n      if state.grid[target_x, target_y, prim_idx] > 0:\n        final_actions = list(path_so_far)\n        \n        # If it's a grabbable item (e.g., WOOD, STONE), append the USE action.\n        # For non-grabbable items (e.g., WORKSHOP, WATER), reaching and facing it is sufficient\n        # and no 'USE' action is needed.\n        if prim_idx in env.world.grabbable_indices:\n          final_actions.append(ACTION_USE)\n        return final_actions\n\n    # Explore neighboring cells by taking movement actions\n    for action, (dx, dy) in DELTAS_BY_ACTION.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_dir = DELTA_TO_DIR[(dx, dy)] # The new direction after moving (facing the direction of movement)\n\n      # Check if the next position is within grid boundaries\n      if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n        continue\n\n      # Check for obstacles at the next position. Agent cannot move into these cells.\n      is_obstacle = False\n      # Iterate over all kinds that might be present in the target cell\n      for kind_id_in_cell in cookbook.kinds: \n          if state.grid[next_x, next_y, kind_id_in_cell] > 0: # If this kind is present\n              if kind_id_in_cell in obstacle_indices: # If it's a hard boundary\n                  is_obstacle = True\n                  break\n              if water_idx is not None and kind_id_in_cell == water_idx: # If it's water\n                  # Water is an obstacle unless the agent has a bridge in inventory\n                  if bridge_idx is None or state.inventory[bridge_idx] == 0:\n                      is_obstacle = True\n                      break\n      if is_obstacle:\n        continue # Cannot move to this cell, skip to next action\n\n      # If the next state (position and direction) has not been visited, add it to the queue\n      if (next_x, next_y, next_dir) not in visited:\n        visited.add((next_x, next_y, next_dir))\n        q.append(((next_x, next_y, next_dir), path_so_far + [action]))\n\n  # If the BFS completes without finding a path to the primitive, return an empty list.\n  return []", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T00:29:07.748391", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  try:\n    primitive_idx = env.world.cookbook.index[primitive]\n  except KeyError:\n    # Primitive name not recognized, cannot collect.\n    return []\n\n  current_state = env._current_state\n  start_pos = current_state.pos  # Agent's starting (row, col) position\n  start_dir = current_state.dir  # Agent's starting direction\n  global_grid = current_state.grid # The full grid representation of the world\n  GRID_WIDTH, GRID_HEIGHT, _ = global_grid.shape # Dimensions of the grid\n\n  # Categorize the primitive based on how it's \"collected\"\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  \n  # Type 1: Requires agent to be ON the cell containing the primitive.\n  # This applies to grabbable items (picked up by walking over) and workshops (interacted by standing on).\n  target_requires_on_cell = is_grabbable or is_workshop\n  \n  # Type 2: Requires agent to be ADJACENT to and FACING the primitive, then use ACTION_USE.\n  # This applies to non-grabbable environment features like stone or water, if they are meant\n  # to be 'collected' by the DSL 'collect' function.\n  target_requires_adjacent_use = (\n      primitive_idx in env.world.non_grabbable_indices and # Is a non-grabbable item\n      not is_workshop # But not a workshop (workshops are 'on-cell' type)\n  )\n\n  # Define how movement actions change the agent's position and direction.\n  # CraftState.dir: 0=South, 1=North, 2=West, 3=East.\n  MOVE_ACTIONS_DATA = {\n      ACTION_UP: ((-1, 0), 1),    # Move UP (row-1), new direction is North (1)\n      ACTION_DOWN: ((1, 0), 0),   # Move DOWN (row+1), new direction is South (0)\n      ACTION_LEFT: ((0, -1), 2),  # Move LEFT (col-1), new direction is West (2)\n      ACTION_RIGHT: ((0, 1), 3)   # Move RIGHT (col+1), new direction is East (3)\n  }\n\n  # Define how agent's direction maps to the coordinates of the cell directly in front.\n  DIRECTION_TO_FORWARD_DELTA = {\n      0: (1, 0),  # Facing South: cell (row+1, col) is in front\n      1: (-1, 0), # Facing North: cell (row-1, col) is in front\n      2: (0, -1), # Facing West: cell (row, col-1) is in front\n      3: (0, 1)   # Facing East: cell (row, col+1) is in front\n  }\n\n  def is_within_bounds(r: int, c: int) -> bool:\n      \"\"\"Checks if a given grid cell (r, c) is within the environment boundaries.\"\"\"\n      return 0 <= r < GRID_WIDTH and 0 <= c < GRID_HEIGHT\n\n  def is_walkable(r: int, c: int) -> bool:\n      \"\"\"\n      Checks if a given grid cell (r, c) is a valid and traversable location for the agent.\n      \"\"\"\n      if not is_within_bounds(r, c):\n          return False\n      \n      # Iterate through all possible kind indices at the cell (r,c)\n      for k_idx in range(global_grid.shape[2]):\n          if global_grid[r, c, k_idx] > 0: # If something of kind k_idx is present at (r,c)\n              if k_idx in env.world.non_grabbable_indices:\n                  # This is a non-grabbable entity (potential obstacle).\n                  # Agent can only walk onto it if it's the specific target primitive\n                  # AND that primitive is an \"on-cell\" type (e.g., a workshop).\n                  if not (target_requires_on_cell and k_idx == primitive_idx):\n                      return False # It's an obstacle we cannot walk onto.\n              elif k_idx == primitive_idx and target_requires_adjacent_use:\n                  # If the cell contains the *specific* primitive we're looking for,\n                  # AND that primitive requires \"adjacent-and-use\" collection (e.g., stone),\n                  # then the agent must NOT walk onto this cell.\n                  return False \n      return True\n\n  # --- Breadth-First Search (BFS) for pathfinding ---\n  # Queue stores tuples: ( (current_position (r,c), current_direction), path_so_far (list of actions) )\n  # BFS explores states defined by both position AND direction, which is crucial for the 'USE' action.\n  queue = collections.deque([((start_pos, start_dir), [])])\n  \n  # Visited set: Stores ((r,c), dir) tuples to avoid revisiting states and infinite loops.\n  visited = {(start_pos, start_dir)}\n\n  shortest_path = None # This will store the sequence of actions to reach the target state.\n  \n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the current state satisfies the collection goal.\n      if target_requires_on_cell:\n          # Goal: Agent is on the cell containing the primitive (grabbable item or workshop).\n          if global_grid[r, c, primitive_idx] > 0:\n              shortest_path = path_so_far\n              break # Found the shortest path to be on the target cell.\n      elif target_requires_adjacent_use:\n          # Goal: Agent is adjacent to and facing the primitive.\n          fwd_dr, fwd_dc = DIRECTION_TO_FORWARD_DELTA[current_dir]\n          target_r, target_c = r + fwd_dr, c + fwd_dc\n          \n          if (is_within_bounds(target_r, target_c) and\n              global_grid[target_r, target_c, primitive_idx] > 0):\n              shortest_path = path_so_far\n              break # Found the shortest path to be in position and orientation to 'USE' the primitive.\n\n      # 2. Explore valid neighboring states (movement actions).\n      for action_val, (move_dr, move_dc), new_dir_val in [\n          (ACTION_UP, (-1, 0), 1),\n          (ACTION_DOWN, (1, 0), 0),\n          (ACTION_LEFT, (0, -1), 2),\n          (ACTION_RIGHT, (0, 1), 3)\n      ]:\n          next_r, next_c = r + move_dr, c + move_dc\n          next_pos = (next_r, next_c)\n          next_state_tuple = (next_pos, new_dir_val)\n\n          # Only add to queue if the next position is walkable and this specific (pos, dir) state\n          # has not been visited yet.\n          if is_walkable(next_r, next_c) and next_state_tuple not in visited:\n              visited.add(next_state_tuple)\n              queue.append((next_state_tuple, path_so_far + [action_val]))\n  \n  final_actions = []\n  if shortest_path is not None:\n      final_actions = shortest_path\n      # If the primitive requires \"adjacent-and-use\" collection, append the USE action.\n      if target_requires_adjacent_use:\n          final_actions.append(ACTION_USE)\n  \n  return final_actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T00:29:09.164965", "function_name": "collect", "function_body": "  try:\n    primitive_idx = env.world.cookbook.index[primitive]\n  except KeyError:\n    # Primitive name not recognized, cannot collect.\n    return []\n\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  current_state = env._current_state\n  start_pos = current_state.pos  # Agent's starting (row, col) position\n  start_dir = current_state.dir  # Agent's starting direction (0=South, 1=North, 2=West, 3=East)\n  global_grid = current_state.grid # The full grid representation of the world\n  GRID_WIDTH, GRID_HEIGHT, _ = global_grid.shape # Dimensions of the grid\n\n  # Determine if the primitive is something that gets picked up into inventory (e.g., wood, iron).\n  # If false, it's an environmental item (e.g., workshop, water, stone) that you simply move onto.\n  primitive_is_grabbable = primitive_idx in env.world.grabbable_indices\n  \n  # Movement deltas and resulting directions for each action\n  # The values for `new_dir_val` correspond to CraftState.dir: 0=South, 1=North, 2=West, 3=East.\n  ACTION_DELTAS_AND_DIRS = {\n      ACTION_UP: ((-1, 0), 1),    # Move UP (row-1), new direction is North\n      ACTION_DOWN: ((1, 0), 0),   # Move DOWN (row+1), new direction is South\n      ACTION_LEFT: ((0, -1), 2),  # Move LEFT (col-1), new direction is West\n      ACTION_RIGHT: ((0, 1), 3)   # Move RIGHT (col+1), new direction is East\n  }\n\n  # Delta for the cell directly in front of the agent, based on current direction.\n  # This is crucial for determining where the 'USE' action will apply.\n  DIRECTION_TO_FORWARD_DELTA = {\n      0: (1, 0),  # Facing South: (row+1, col) is in front\n      1: (-1, 0), # Facing North: (row-1, col) is in front\n      2: (0, -1), # Facing West: (row, col-1) is in front\n      3: (0, 1)   # Facing East: (row, col+1) is in front\n  }\n\n  # Indices of entities that generally block agent movement.\n  # This set includes things like water, stone, and fixed workshops.\n  non_grabbable_obstacles = env.world.non_grabbable_indices\n\n  def is_walkable(r: int, c: int) -> bool:\n      \"\"\"\n      Checks if a given grid cell (r, c) is within boundaries and can be walked onto by the agent.\n      \"\"\"\n      # Check grid boundaries\n      if not (0 <= r < GRID_WIDTH and 0 <= c < GRID_HEIGHT):\n          return False\n      \n      # Check if the cell contains any non-grabbable obstacle.\n      for kind_idx in non_grabbable_obstacles:\n          if global_grid[r, c, kind_idx] > 0: # If this kind of obstacle is present at (r,c)\n              # If the obstacle is the *specific* non-grabbable primitive we are targeting (e.g., a workshop),\n              # then we *are* allowed to walk onto it.\n              if not (kind_idx == primitive_idx and not primitive_is_grabbable):\n                  return False # It's an impassable obstacle, and not the specific target we can walk onto.\n      \n      # If the target is a grabbable item (e.g., WOOD, IRON), we cannot walk directly onto its occupied cell.\n      # We need to be adjacent to it to 'USE' it.\n      if primitive_is_grabbable and global_grid[r,c,primitive_idx] > 0:\n          return False\n          \n      return True\n  \n  # --- Breadth-First Search (BFS) for pathfinding ---\n  # Queue stores tuples: ( (current_position (r,c), current_direction (int)), path_so_far (list of actions) )\n  # The state includes direction because 'USE' action depends on facing direction.\n  queue = collections.deque([((start_pos, start_dir), [])])\n  \n  # Visited set: Stores (position (r,c), direction (int)) tuples to avoid revisiting states and infinite loops.\n  visited = {(start_pos, start_dir)}\n\n  shortest_path_found = None # This will store the sequence of actions to reach the target state.\n  \n  while queue:\n      (current_pos, current_dir_val), path_so_far = queue.popleft()\n      r, c = current_pos\n\n      # Check if the current state satisfies the collection goal.\n      if primitive_is_grabbable:\n          # For grabbable items (e.g., WOOD, IRON), the agent needs to be adjacent and facing the item.\n          fwd_dr, fwd_dc = DIRECTION_TO_FORWARD_DELTA[current_dir_val]\n          target_r, target_c = r + fwd_dr, c + fwd_dc\n\n          # Check if the cell directly in front of the agent contains the grabbable primitive.\n          if (0 <= target_r < GRID_WIDTH and \n              0 <= target_c < GRID_HEIGHT and \n              global_grid[target_r, target_c, primitive_idx] > 0):\n              shortest_path_found = path_so_far\n              break # Found the shortest path to be in position and orientation to 'USE'.\n      else:\n          # For non-grabbable environmental items (e.g., WORKSHOP, WATER, STONE),\n          # the agent needs to be ON the cell containing the primitive.\n          if global_grid[r, c, primitive_idx] > 0:\n              shortest_path_found = path_so_far\n              break # Found the shortest path to be on the target cell.\n\n      # Explore valid neighboring states (movement actions).\n      for action_val, (move_delta, new_dir_val) in ACTION_DELTAS_AND_DIRS.items():\n          dr, dc = move_delta\n          next_r, next_c = r + dr, c + dc\n          next_pos = (next_r, next_c)\n          next_state_tuple = (next_pos, new_dir_val)\n\n          # Only add to queue if the next position is walkable and this specific (pos, dir) state\n          # has not been visited yet.\n          if is_walkable(next_r, next_c) and next_state_tuple not in visited:\n              visited.add(next_state_tuple)\n              queue.append((next_state_tuple, path_so_far + [action_val]))\n  \n  final_actions = []\n  if shortest_path_found is not None:\n      # If a path was found:\n      if primitive_is_grabbable:\n          # For grabbable items, append the 'USE' action at the end to pick them up.\n          final_actions = shortest_path_found + [ACTION_USE]\n      else:\n          # For non-grabbable environmental items, no 'USE' action is needed;\n          # reaching the target cell is sufficient for 'collection'.\n          final_actions = shortest_path_found\n  \n  return final_actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T00:30:08.932470", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  DOWN = action_map['DOWN']\n  UP = action_map['UP']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  current_state = env._current_state\n  current_pos = current_state.pos\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  primitive_idx = env.world.cookbook.index[primitive]\n\n  if primitive_idx not in env.world.grabbable_indices:\n      # If the item is not grabbable (e.g., WATER, WORKSHOP), it cannot be collected.\n      return []\n\n  if current_state.next_to(primitive_idx):\n      # If the agent is already in the 3x3 neighborhood of the primitive, just use it.\n      return [USE]\n\n  # Find all grid locations where the primitive exists\n  primitive_locations = []\n  for x in range(grid_width):\n      for y in range(grid_height):\n          if grid[x, y, primitive_idx] > 0:\n              primitive_locations.append((x, y))\n\n  if not primitive_locations:\n      # Primitive not found anywhere on the map\n      return []\n\n  # Define possible movement deltas (cardinal movements)\n  move_deltas = {\n      (0, -1): UP,\n      (0, 1): DOWN,\n      (-1, 0): LEFT,\n      (1, 0): RIGHT\n  }\n\n  # Identify non-grabbable indices which represent impassable terrain (obstacles)\n  obstacle_indices = env.world.non_grabbable_indices\n\n  # Determine all possible target cells for the BFS.\n  # These are cells where the agent can stand such that the primitive_idx is in its 3x3 neighborhood.\n  # This aligns with the `current_state.next_to()` method's definition.\n  target_cells_for_use = set()\n  for px, py in primitive_locations:\n      # Iterate through the 3x3 neighborhood (including diagonals) around the primitive location\n      for dx in [-1, 0, 1]:\n          for dy in [-1, 0, 1]:\n              nx, ny = px + dx, py + dy\n\n              # Check if the potential target cell is within grid bounds\n              if 0 <= nx < grid_width and 0 <= ny < grid_height:\n                  # Check if the potential target cell is traversable (not an obstacle)\n                  is_obstacle_at_neighbor = False\n                  for obs_idx in obstacle_indices:\n                      if grid[nx, ny, obs_idx] > 0:\n                          is_obstacle_at_neighbor = True\n                          break\n                  \n                  if not is_obstacle_at_neighbor:\n                      target_cells_for_use.add((nx, ny))\n  \n  # If no traversable target cells can be found, the primitive is unreachable\n  if not target_cells_for_use:\n      return []\n\n  # Perform a Breadth-First Search (BFS) to find the shortest path\n  # Queue stores tuples: ((current_x, current_y), list_of_actions_taken)\n  queue = collections.deque([(current_pos, [])])\n  visited = {current_pos} # Keep track of visited coordinates to avoid loops\n  found_path = None\n\n  while queue:\n      (x, y), path = queue.popleft()\n\n      # If the current cell is one of our target cells, we've found a path.\n      # The BFS ensures this is the shortest path.\n      if (x, y) in target_cells_for_use:\n          found_path = path\n          break\n\n      # Explore neighboring cells (cardinal movements only)\n      for (dx, dy), action_to_take in move_deltas.items():\n          nx, ny = x + dx, y + dy\n\n          # Check bounds for the new cell\n          if 0 <= nx < grid_width and 0 <= ny < grid_height:\n              # Check if the new cell is an obstacle\n              is_obstacle = False\n              for obs_idx in obstacle_indices:\n                  if grid[nx, ny, obs_idx] > 0:\n                      is_obstacle = True\n                      break\n              \n              # If not an obstacle and not yet visited, add to queue\n              if not is_obstacle and (nx, ny) not in visited:\n                  visited.add((nx, ny))\n                  queue.append(((nx, ny), path + [action_to_take]))\n\n  # If a path was found, append the USE action to collect the primitive\n  if found_path is None:\n      # No path could be found to any cell from which the primitive can be collected\n      return []\n  else:\n      # Path found, now perform the USE action\n      return found_path + [USE]", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T00:30:10.184804", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  DOWN = action_map['DOWN']\n  UP = action_map['UP']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  current_state = env._current_state\n  current_pos = current_state.pos\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  # Get the integer index for the desired primitive\n  primitive_idx = env.world.cookbook.index[primitive]\n\n  # Check if the primitive can actually be picked up (is grabbable).\n  # If it's not a grabbable item (e.g., WATER, WORKSHOP), it cannot be collected.\n  if primitive_idx not in env.world.grabbable_indices:\n      return []\n\n  # If the agent is already next to the primitive, just use it.\n  # 'next_to' checks the 3x3 neighborhood, including the agent's current cell.\n  if current_state.next_to(primitive_idx):\n      return [USE]\n\n  # Find all grid locations where the primitive exists\n  primitive_locations = []\n  for x in range(grid_width):\n      for y in range(grid_height):\n          if grid[x, y, primitive_idx] > 0:\n              primitive_locations.append((x, y))\n\n  if not primitive_locations:\n      # Primitive not found anywhere on the map\n      return []\n\n  # Define possible movement deltas and their corresponding actions.\n  # These are cardinal movements used for BFS exploration.\n  move_deltas = {\n      (0, -1): UP,\n      (0, 1): DOWN,\n      (-1, 0): LEFT,\n      (1, 0): RIGHT\n  }\n\n  # Identify non-grabbable indices which represent impassable terrain (obstacles)\n  obstacle_indices = env.world.non_grabbable_indices\n\n  # Determine all possible target cells for the BFS.\n  # These are cells where the agent can stand and successfully use the 'USE' action\n  # to collect the primitive. This means any traversable cell that is within the 3x3\n  # neighborhood of a primitive instance.\n  relative_neighbor_offsets = [\n      (x, y) for x in [-1, 0, 1] for y in [-1, 0, 1]\n  ]\n\n  target_cells_for_use = set()\n  for px, py in primitive_locations:\n      for dx, dy in relative_neighbor_offsets:\n          nx, ny = px + dx, py + dy\n\n          # Check if the potential target cell is within grid bounds\n          if 0 <= nx < grid_width and 0 <= ny < grid_height:\n              # Check if the potential target cell is an obstacle\n              is_obstacle_at_neighbor = False\n              for obs_idx in obstacle_indices:\n                  if grid[nx, ny, obs_idx] > 0:\n                      is_obstacle_at_neighbor = True\n                      break\n              # If not an obstacle, add to the set of target cells\n              if not is_obstacle_at_neighbor:\n                  target_cells_for_use.add((nx, ny))\n  \n  # If no traversable target cells can be found, the primitive is unreachable\n  if not target_cells_for_use:\n      return []\n\n  # Perform a Breadth-First Search (BFS) to find the shortest path\n  # Queue stores tuples: ((current_x, current_y), list_of_actions_taken)\n  queue = collections.deque([(current_pos, [])])\n  visited = {current_pos} # Keep track of visited coordinates to avoid loops\n  found_path = None\n\n  while queue:\n      (x, y), path = queue.popleft()\n\n      # If the current cell is one of our target cells, we've found a path.\n      # The BFS ensures this is the shortest path by number of cardinal steps.\n      if (x, y) in target_cells_for_use:\n          found_path = path\n          break\n\n      # Explore neighboring cells using cardinal moves\n      for (dx, dy), action_to_take in move_deltas.items():\n          nx, ny = x + dx, y + dy\n\n          # Check bounds for the new cell\n          if 0 <= nx < grid_width and 0 <= ny < grid_height:\n              # Check if the new cell is an obstacle\n              is_obstacle = False\n              for obs_idx in obstacle_indices:\n                  if grid[nx, ny, obs_idx] > 0:\n                      is_obstacle = True\n                      break\n              \n              # If not an obstacle and not yet visited, add to queue\n              if not is_obstacle and (nx, ny) not in visited:\n                  visited.add((nx, ny))\n                  queue.append(((nx, ny), path + [action_to_take]))\n\n  # If a path was found, append the USE action to collect the primitive\n  if found_path is None:\n      # No path could be found to any cell from which the primitive can be collected\n      return []\n  else:\n      # Path found, now perform the USE action\n      return found_path + [USE]", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T00:31:21.428559", "function_name": "collect", "function_body": "  \"\"\"Returns a list of actions to find and collect the primitive in the passed env.\n    \n    This version correctly distinguishes between grabbable resources, non-grabbable resources,\n    and workshops, applying appropriate movement and collection logic (e.g., being on the cell,\n    being adjacent, and whether a USE action is required).\n\n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect.\n\n    Returns:\n        List[int]: A sequence of action indices to execute. An empty list if no path is found.\n  \"\"\"\n  actions = []\n\n  # 1. Get Action Mappings and Primitive Index\n  action_map = env.action_specs()\n  UP, DOWN, LEFT, RIGHT, USE = action_map['UP'], action_map['DOWN'], action_map['LEFT'], action_map['RIGHT'], action_map['USE']\n\n  primitive_idx = env.world.cookbook.index[primitive]\n\n  # Get current state information\n  current_state = env._current_state\n  start_pos = current_state.pos\n  global_grid = current_state.grid\n  W, H, _ = global_grid.shape\n\n  # Determine the type of primitive\n  is_workshop = primitive_idx in env.world.workshop_indices\n  is_grabbable_resource = primitive_idx in env.world.grabbable_indices\n  # A non-grabbable resource is something like STONE, WATER that's in non_grabbable_indices\n  # but NOT a workshop.\n  is_non_grabbable_resource = (primitive_idx in env.world.non_grabbable_indices and not is_workshop)\n\n  # Define movement deltas for BFS\n  move_deltas = {\n      UP: (-1, 0),\n      DOWN: (1, 0),\n      LEFT: (0, -1),\n      RIGHT: (0, 1)\n  }\n\n  def is_within_bounds(r, c):\n      \"\"\"Checks if coordinates (r, c) are within the grid boundaries.\"\"\"\n      return 0 <= r < W and 0 <= c < H\n\n  def is_traversable(r, c):\n      \"\"\"Checks if (r, c) is a cell the agent can step onto.\n      \n      A cell is traversable if it's within bounds and doesn't contain any\n      non-grabbable item that is NOT a workshop. (Workshops are exceptions\n      and can be stepped onto even if they are non-grabbable).\n      \"\"\"\n      if not is_within_bounds(r, c):\n          return False\n      \n      # Check for items that block movement\n      for k_idx in range(global_grid.shape[2]): # Iterate through all possible kinds\n          if global_grid[r, c, k_idx] == 1: # If this cell contains an item of kind k_idx\n              if k_idx in env.world.non_grabbable_indices:\n                  # If it's a non-grabbable item AND NOT a workshop, then it's an obstacle.\n                  # Workshops are special non-grabbable items that can be stepped onto.\n                  if k_idx not in env.world.workshop_indices:\n                      return False\n      return True\n\n  def is_adjacent_to_kind(r, c, kind_idx):\n      \"\"\"Checks if (r, c) is adjacent (8-way) to a cell containing kind_idx.\"\"\"\n      for dr in [-1, 0, 1]:\n          for dc in [-1, 0, 1]:\n              if dr == 0 and dc == 0:\n                  continue # Skip current cell (agent's current cell)\n              nr, nc = r + dr, c + dc\n              if is_within_bounds(nr, nc) and global_grid[nr, nc, kind_idx] == 1:\n                  return True\n      return False\n  \n  # BFS Queue: (current_position (r,c), path_so_far (list of actions))\n  queue = collections.deque([(start_pos, [])])\n  visited = {start_pos} # Set of (r, c) tuples already visited\n\n  path_to_target = None # Stores the action path to the desired location\n\n  while queue:\n      (r, c), path_so_far = queue.popleft()\n\n      # Check if current position satisfies the goal for collection/reaching\n      if is_workshop:\n          # Goal for workshop: agent must be ON the workshop cell\n          if global_grid[r, c, primitive_idx] == 1:\n              path_to_target = path_so_far\n              break # Found the shortest path to the workshop location\n      elif is_grabbable_resource:\n          # Goal for grabbable resource (e.g., WOOD, IRON): agent must be ON the cell containing the resource\n          if global_grid[r, c, primitive_idx] == 1:\n              path_to_target = path_so_far\n              break # Found the shortest path to the resource\n      elif is_non_grabbable_resource:\n          # Goal for non-grabbable resource (e.g., STONE, WATER): agent must be ADJACENT to it\n          if is_adjacent_to_kind(r, c, primitive_idx):\n              path_to_target = path_so_far\n              break # Found the shortest path to adjacency\n\n      # Explore neighbors (possible moves)\n      for action_val, (dr, dc) in move_deltas.items():\n          next_r, next_c = r + dr, c + dc\n          next_pos = (next_r, next_c)\n\n          if is_traversable(next_r, next_c) and next_pos not in visited:\n              visited.add(next_pos)\n              queue.append((next_pos, path_so_far + [action_val]))\n  \n  if path_to_target:\n      # If a path was found, append the USE action if it's a resource (grabbable or non-grabbable).\n      # Workshops don't require a USE action for \"collection\" as they are locations for crafting.\n      if is_grabbable_resource or is_non_grabbable_resource:\n          actions = path_to_target + [USE]\n      else: # It's a workshop\n          actions = path_to_target\n  \n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T00:31:22.580440", "function_name": "collect", "function_body": "  actions = []\n\n  # 1. Get Action Mappings and Primitive Index\n  action_map = env.action_specs()\n  UP, DOWN, LEFT, RIGHT, USE = action_map['UP'], action_map['DOWN'], action_map['LEFT'], action_map['RIGHT'], action_map['USE']\n\n  primitive_idx = env.world.cookbook.index[primitive]\n\n  # Get current state information\n  current_state = env._current_state\n  start_pos = current_state.pos\n  global_grid = current_state.grid\n  W, H, _ = global_grid.shape\n\n  # Determine type of primitive to define goal condition and traversability\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  \n  # Define movement deltas for BFS\n  move_deltas = {\n      UP: (-1, 0),\n      DOWN: (1, 0),\n      LEFT: (0, -1),\n      RIGHT: (0, 1)\n  }\n\n  # `non_grabbable_indices` are generally obstacles.\n  # Workshops are a special case: they are non-grabbable but might be traversable if they are the goal itself.\n  general_obstacle_indices = env.world.non_grabbable_indices\n\n  def is_valid_move_cell(r, c, target_primitive_idx, target_is_traversable_workshop):\n      \"\"\"Checks if (r, c) is within bounds and doesn't contain un-traversable obstacles.\n      \n      Args:\n          r (int): Row coordinate.\n          c (int): Column coordinate.\n          target_primitive_idx (int): The index of the primitive we are trying to collect.\n          target_is_traversable_workshop (bool): True if the target primitive is a workshop\n                                                  and we are allowed to step onto its cell.\n      Returns:\n          bool: True if the cell is traversable, False otherwise.\n      \"\"\"\n      if not (0 <= r < W and 0 <= c < H):\n          return False\n      \n      # Check if the cell contains any non-grabbable item that blocks movement\n      for k_idx in general_obstacle_indices:\n          if global_grid[r, c, k_idx] == 1: # If this cell contains an item marked as a general obstacle\n              # Exception: If the obstacle is our *specific target primitive* AND it's a workshop\n              # that we are allowed to step onto, then it's traversable.\n              if k_idx == target_primitive_idx and target_is_traversable_workshop:\n                  continue # This specific obstacle (the target workshop) is traversable for this goal\n              else:\n                  return False # It's a blocking obstacle (either not our target, or not a traversable workshop)\n      return True\n\n  def is_adjacent_to_kind(r, c, kind_idx_to_check):\n      \"\"\"Checks if (r, c) is adjacent (8-way) to a cell containing kind_idx_to_check.\n      \n      Args:\n          r (int): Row coordinate.\n          c (int): Column coordinate.\n          kind_idx_to_check (int): The index of the entity kind to check for adjacency.\n      Returns:\n          bool: True if adjacent to the kind, False otherwise.\n      \"\"\"\n      for dr in [-1, 0, 1]:\n          for dc in [-1, 0, 1]:\n              if dr == 0 and dc == 0:\n                  continue # Skip current cell\n              nr, nc = r + dr, c + dc\n              if 0 <= nr < W and 0 <= nc < H and global_grid[nr, nc, kind_idx_to_check] == 1:\n                  return True\n      return False\n  \n  # BFS Queue: (current_position (r,c), path_so_far (list of actions))\n  queue = collections.deque([(start_pos, [])])\n  visited = {start_pos} # Set of (r, c) tuples already visited to prevent cycles\n\n  path_to_target = None\n  \n  while queue:\n      (r, c), path_so_far = queue.popleft()\n\n      # Check if current position satisfies the collection goal\n      is_current_pos_target = False\n      if is_grabbable:\n          # For grabbable items (e.g., WOOD, IRON), the agent needs to be ON the cell containing the primitive.\n          if global_grid[r, c, primitive_idx] == 1:\n              is_current_pos_target = True\n      elif is_workshop:\n          # For workshops (e.g., WORKSHOP0), the agent needs to be ON the workshop cell.\n          if global_grid[r, c, primitive_idx] == 1:\n              is_current_pos_target = True\n      else:\n          # For other non-grabbables (e.g., STONE, WATER), the agent needs to be ADJACENT to the primitive.\n          if is_adjacent_to_kind(r, c, primitive_idx):\n              is_current_pos_target = True\n\n      if is_current_pos_target:\n          path_to_target = path_so_far\n          break # Found the shortest path to an actionable location\n\n      # Explore neighbors (movement)\n      for action_val, (dr, dc) in move_deltas.items():\n          next_r, next_c = r + dr, c + dc\n          next_pos = (next_r, next_c)\n\n          # Determine if the target primitive is a workshop that we are allowed to step onto.\n          # This flag is passed to `is_valid_move_cell` to make the correct traversability decision for `next_pos`.\n          can_step_on_target_workshop = is_workshop \n          \n          if is_valid_move_cell(next_r, next_c, primitive_idx, can_step_on_target_workshop) and next_pos not in visited:\n              visited.add(next_pos)\n              queue.append((next_pos, path_so_far + [action_val]))\n  \n  if path_to_target:\n      # If a path was found, append the USE action at the end to collect/interact with the primitive.\n      actions = path_to_target + [USE]\n  \n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T00:32:26.706119", "function_name": "collect", "function_body": "  action_mapping = env.action_specs()\n  # Define action IDs for clarity, using the mapping from the environment\n  MOVE_UP = action_mapping['UP']\n  MOVE_DOWN = action_mapping['DOWN']\n  MOVE_LEFT = action_mapping['LEFT']\n  MOVE_RIGHT = action_mapping['RIGHT']\n  USE_ACTION = action_mapping['USE']\n\n  cookbook = env.world.cookbook\n  \n  # Get the integer ID for the target primitive from the cookbook's index.\n  primitive_id = cookbook.index[primitive]\n  if primitive_id is None:\n      # If the primitive name is not recognized, it cannot be collected.\n      return []\n\n  # The initial state from which the collection path should start.\n  initial_craft_state = env._current_state\n  \n  # Determine if the primitive is a 'grabbable' item (like wood, iron)\n  # or a 'non-grabbable' environmental feature (like stone, workshops).\n  # This distinction is crucial for defining the 'goal' state in the BFS.\n  is_grabbable = primitive_id in env.world.grabbable_indices\n  \n  # Pre-scan the grid to find all locations where the primitive exists.\n  # This optimizes the goal checking during BFS.\n  primitive_grid_locations = set() \n  current_grid = initial_craft_state.grid\n  grid_width, grid_height, _ = current_grid.shape\n\n  for r in range(grid_width):\n      for c in range(grid_height):\n          if current_grid[r, c, primitive_id] > 0: # Check if the primitive exists at this cell\n              primitive_grid_locations.add((r, c))\n\n  # If the primitive is not found anywhere on the map, it's unreachable.\n  if not primitive_grid_locations:\n      return []\n\n  # Define how agent's direction (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT) maps to (row, col) offsets\n  # for the cell directly in front of the agent. This is crucial for 'USE' action on non-grabbables.\n  direction_to_forward_offset = {\n      0: (-1, 0), # UP: row - 1\n      1: (0, 1),  # RIGHT: col + 1\n      2: (1, 0),  # DOWN: row + 1\n      3: (0, -1)  # LEFT: col - 1\n  }\n  \n  # BFS queue: Stores tuples of (CraftState, list_of_actions_to_reach_this_state).\n  # Storing the actual CraftState object allows leveraging its .step() method\n  # for accurate simulation of movement and environment interactions.\n  search_queue = collections.deque([(initial_craft_state, [])])\n  \n  # Visited set: Tracks (agent_position, agent_direction) to prevent cycles\n  # and ensure the shortest path is found by BFS.\n  visited_states = {(initial_craft_state.pos, initial_craft_state.dir)} \n\n  # A safety limit for BFS depth to prevent excessively long computations,\n  # especially on large or sparse maps.\n  MAX_BFS_DEPTH = 500 \n\n  # List of all possible movement actions for exploring neighbors.\n  movement_actions = [MOVE_UP, MOVE_DOWN, MOVE_LEFT, MOVE_RIGHT]\n\n  # Start the Breadth-First Search\n  while search_queue:\n    current_state_in_bfs, current_path = search_queue.popleft()\n\n    # Prune paths that exceed the maximum search depth to manage computational cost.\n    if len(current_path) > MAX_BFS_DEPTH:\n        continue\n\n    # --- Goal Check: Determine if the primitive can be collected from the current state ---\n    can_collect_with_use = False\n    if is_grabbable:\n        # For grabbable items, the agent collects them by standing directly on their location\n        # and performing a 'USE' action.\n        if current_state_in_bfs.pos in primitive_grid_locations:\n            can_collect_with_use = True\n    else:\n        # For non-grabbable items (like a stone block to be mined, or a workshop),\n        # the agent typically needs to be adjacent to and facing the item to 'USE' it.\n        dr_front, dc_front = direction_to_forward_offset[current_state_in_bfs.dir]\n        front_cell_r = current_state_in_bfs.pos[0] + dr_front\n        front_cell_c = current_state_in_bfs.pos[1] + dc_front\n        \n        # Check if the calculated 'front' cell is within grid boundaries and contains the primitive.\n        if (0 <= front_cell_r < grid_width and 0 <= front_cell_c < grid_height) and \\\n           ((front_cell_r, front_cell_c) in primitive_grid_locations):\n            can_collect_with_use = True\n\n    if can_collect_with_use:\n        # If the goal condition is met, return the sequence of actions leading to this state,\n        # appended with the final 'USE' action.\n        return current_path + [USE_ACTION]\n\n    # --- Explore next possible states by simulating movement actions ---\n    for action in movement_actions:\n      # Simulate the action by calling the CraftState's step method.\n      # This returns a new CraftState instance reflecting the result of the action,\n      # including changes to position, direction, grid, and inventory.\n      # The reward is not used for pathfinding here (always 0.0 in this environment).\n      _reward, next_craft_state = current_state_in_bfs.step(action)\n      \n      # Define the key for the next state in the visited set (position and direction).\n      next_state_key = (next_craft_state.pos, next_craft_state.dir)\n\n      # Add the new state to the queue only if this specific (position, direction)\n      # combination has not been visited before.\n      if next_state_key not in visited_states:\n        visited_states.add(next_state_key)\n        search_queue.append((next_craft_state, current_path + [action]))\n\n  # If the BFS queue becomes empty and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state within the search limits.\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T00:32:27.999873", "function_name": "collect", "function_body": "  actions = []\n  \n  # Get necessary world and state information\n  action_map = env.action_specs()\n  current_state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n  grid = current_state.grid\n  WIDTH, HEIGHT, _ = grid.shape # Get grid dimensions\n\n  # Map action names to their integer IDs for convenience\n  MOVE_UP = action_map['UP']\n  MOVE_DOWN = action_map['DOWN']\n  MOVE_LEFT = action_map['LEFT']\n  MOVE_RIGHT = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Get the integer ID for the primitive string name using the Cookbook's index.\n  primitive_id = cookbook.index[primitive]\n  if primitive_id is None:\n      # If the primitive name is not recognized, no actions can be taken to collect it.\n      return []\n\n  # Determine if the target primitive is a grabbable item (e.g., wood, iron, grass)\n  # or a non-grabbable item (e.g., stone, workshops) that requires interaction while adjacent.\n  is_primitive_grabbable = primitive_id in world.grabbable_indices\n\n  # Pre-calculate all locations on the grid where the primitive exists.\n  # This set will contain (row, column) tuples of all cells containing the primitive.\n  primitive_locations = set() \n  for r_idx in range(WIDTH):\n      for c_idx in range(HEIGHT):\n          if grid[r_idx, c_idx, primitive_id] > 0:\n              primitive_locations.add((r_idx, c_idx))\n\n  # If no instance of the primitive exists on the grid, no path is possible.\n  if not primitive_locations:\n      return []\n\n  # Mapping from agent's internal direction (int) to (dr, dc) delta for the cell directly in front.\n  # Assumed direction mapping: 0=UP, 1=RIGHT, 2=DOWN, 3=LEFT, consistent with CraftState.dir.\n  dir_to_delta = {\n      0: (-1, 0), # UP: (row - 1, col)\n      1: (0, 1),  # RIGHT: (row, col + 1)\n      2: (1, 0),  # DOWN: (row + 1, col)\n      3: (0, -1)  # LEFT: (row, col - 1)\n  }\n  \n  # BFS State: (CraftState object, path_of_actions (list))\n  # We store the actual CraftState object in the queue to leverage its `.step()` method\n  # for accurate transition and collision logic as defined by the environment.\n  queue = collections.deque([(current_state, [])])\n  \n  # The visited set tracks unique states identified by (agent_position (tuple), agent_direction (int)).\n  # This prevents cycles and ensures the shortest path is found (due to BFS property).\n  visited = {(current_state.pos, current_state.dir)} \n\n  # A safety limit to prevent excessively long computations or infinite loops\n  # on very large maps or for unreachable items.\n  MAX_SEARCH_DEPTH = 500 \n\n  # List of all possible movement actions\n  movement_actions = [MOVE_UP, MOVE_DOWN, MOVE_LEFT, MOVE_RIGHT]\n\n  while queue:\n    current_bfs_state, path = queue.popleft()\n\n    # Prune paths that exceed the maximum search depth to manage computational cost.\n    if len(path) > MAX_SEARCH_DEPTH:\n        continue\n\n    # --- Goal Check ---\n    # Check if the current state allows for collecting the primitive with a 'USE' action.\n    if is_primitive_grabbable:\n        # For grabbable items, the agent typically needs to be ON the same square as the item.\n        # Once on the square, a 'USE' action should pick it up.\n        if current_bfs_state.pos in primitive_locations:\n            return path + [USE_ACTION]\n    else:\n        # For non-grabbable items (like a 'stone' block to be mined, or a 'workshop'),\n        # the agent usually needs to be adjacent to and facing the item to 'USE' it.\n        dr_front, dc_front = dir_to_delta[current_bfs_state.dir]\n        front_r, front_c = current_bfs_state.pos[0] + dr_front, current_bfs_state.pos[1] + dc_front\n        \n        # Check if the cell in front is within grid boundaries and contains the primitive.\n        if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT) and\\\n           ((front_r, front_c) in primitive_locations):\n            return path + [USE_ACTION]\n\n    # --- Explore Neighbors (Movement Actions) ---\n    # For each possible movement action, simulate the step and add the new state to the queue.\n    for action in movement_actions:\n      # current_bfs_state.step(action) returns a NEW CraftState instance, ensuring\n      # the BFS explores distinct states without modifying previously enqueued ones.\n      # The reward is not relevant for pathfinding in this context (always 0.0).\n      _reward, next_state = current_bfs_state.step(action)\n      \n      next_pos = next_state.pos\n      next_dir = next_state.dir\n      next_state_key = (next_pos, next_dir)\n\n      # Add the next state to the queue only if it has not been visited yet.\n      # This prevents redundant exploration and ensures optimality (shortest path).\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        queue.append((next_state, path + [action]))\n\n  # If the BFS queue becomes empty and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the current state within the search limits.\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T00:34:04.542253", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  \n  # Action mappings and movement deltas\n  ACTION_MAP = env.action_specs()\n  UP, DOWN, LEFT, RIGHT, USE = ACTION_MAP[\"UP\"], ACTION_MAP[\"DOWN\"], ACTION_MAP[\"LEFT\"], ACTION_MAP[\"RIGHT\"], ACTION_MAP[\"USE\"]\n\n  # Map movement actions to their (dx, dy) deltas (row change, column change)\n  # CraftWorld convention: X (rows) increase downwards, Y (columns) increase rightwards\n  DELTAS_BY_ACTION = {\n      UP: (-1, 0),    # Move up: decrease row (x-1)\n      DOWN: (1, 0),    # Move down: increase row (x+1)\n      LEFT: (0, -1),   # Move left: decrease column (y-1)\n      RIGHT: (0, 1)    # Move right: increase column (y+1)\n  }\n  \n  # Map agent's internal direction (0:N, 1:S, 2:W, 3:E) to (dx, dy) deltas for the cell in front\n  # From CraftState: dir 0 (North/UP), 1 (South/DOWN), 2 (West/LEFT), 3 (East/RIGHT)\n  DIR_TO_DELTA = {\n      0: (-1, 0), # North (UP)\n      1: (1, 0),  # South (DOWN)\n      2: (0, -1), # West (LEFT)\n      3: (0, 1)   # East (RIGHT)\n  }\n  \n  # Map (dx, dy) deltas to the corresponding agent direction index\n  DELTA_TO_DIR = {v: k for k, v in DIR_TO_DELTA.items()}\n\n  # 1. Get primitive index\n  try:\n    prim_idx = cookbook.index.index(primitive)\n  except ValueError:\n    # Primitive string is not known in the cookbook's index, cannot collect.\n    return []\n\n  # Refinement for v2: Ensure the target is actually classified as a 'primitive' resource\n  # according to the cookbook's definition. The DSL `primitive` implies it should be.\n  if prim_idx not in cookbook.primitives:\n      # If the requested item is not a 'primitive' (e.g., it's an environment object like WORKSHOP\n      # or a crafted item), this 'collect' function is likely not the appropriate strategy.\n      return []\n\n  # 2. Early Exit: Check if the primitive is already in the agent's inventory\n  if state.inventory[prim_idx] > 0:\n      return []\n\n  # Grid dimensions\n  WIDTH, HEIGHT, _ = state.grid.shape\n\n  # Identify impassable terrain types for pathfinding\n  impassable_kind_ids = set()\n  \n  # Add BOUNDARY as an absolute impassable obstacle\n  # Using .get() for robustness in case 'BOUNDARY' index is not present in some cookbooks\n  boundary_idx = cookbook.index.contents.get(\"BOUNDARY\")\n  if boundary_idx is not None:\n      impassable_kind_ids.add(boundary_idx)\n\n  # Special handling for WATER: impassable unless BRIDGE is in inventory\n  water_idx = cookbook.index.contents.get(\"WATER\")\n  bridge_idx = cookbook.index.contents.get(\"BRIDGE\")\n  \n  # BFS setup\n  start_pos = state.pos\n  start_dir = state.dir # Agent's current direction\n  \n  # Queue stores tuples of ((current_x, current_y, current_direction), [list_of_actions_to_reach_this_state])\n  q = collections.deque([((start_pos[0], start_pos[1], start_dir), [])])\n  \n  # Visited set stores (x, y, direction) tuples to avoid redundant exploration and cycles\n  visited = {(start_pos[0], start_pos[1], start_dir)}\n\n  while q:\n    ((curr_x, curr_y, curr_dir), path_so_far) = q.popleft()\n\n    # Check if the primitive is directly in front of the agent from the current (position, direction)\n    # This is the target condition: agent is positioned to interact with (e.g., USE) the primitive.\n    front_dx, front_dy = DIR_TO_DELTA[curr_dir]\n    prim_x, prim_y = curr_x + front_dx, curr_y + front_dy\n\n    # Check bounds for the cell directly in front\n    if 0 <= prim_x < WIDTH and 0 <= prim_y < HEIGHT:\n      # If the primitive is present in the cell in front\n      if state.grid[prim_x, prim_y, prim_idx] > 0:\n        final_actions = list(path_so_far) # Create a copy of the path\n\n        # If the primitive is grabbable (can be picked up), append the USE action.\n        # For non-grabbable primitives (e.g., WORKSHOPs, WATER), 'collect' might mean\n        # just reaching an adjacent position and facing it, so no 'USE' action is added.\n        if prim_idx in env.world.grabbable_indices:\n          final_actions.append(USE)\n        return final_actions\n\n    # Explore neighbors by considering all possible movement actions (UP, DOWN, LEFT, RIGHT)\n    for action, (dx, dy) in DELTAS_BY_ACTION.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      # The agent's new direction will be determined by the movement action taken by CraftState.step()\n      next_dir = DELTA_TO_DIR[(dx, dy)]\n\n      # Check bounds for the next cell\n      if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n        continue\n\n      # Check for impassable terrain in the next cell\n      is_impassable = False\n      \n      # Get indices of all kinds present in the proposed next cell\n      kinds_in_next_cell = np.where(state.grid[next_x, next_y] > 0)[0] \n      \n      for kind_id_in_cell in kinds_in_next_cell:\n          if kind_id_in_cell in impassable_kind_ids:\n              is_impassable = True\n              break\n          # Special handling for WATER: only impassable if no BRIDGE in inventory\n          if water_idx is not None and kind_id_in_cell == water_idx:\n              if bridge_idx is None or state.inventory[bridge_idx] == 0:\n                  is_impassable = True\n                  break\n      \n      if is_impassable:\n        continue # Cannot move to this cell\n\n      # Check if this (position, direction) state has already been visited\n      if (next_x, next_y, next_dir) not in visited:\n        visited.add((next_x, next_y, next_dir))\n        q.append(((next_x, next_y, next_dir), path_so_far + [action]))\n\n  # If the BFS queue is exhausted and no path to the primitive was found\n  return []", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T00:34:05.659412", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  \n  # 1. Get primitive index\n  try:\n    prim_idx = cookbook.index.index(primitive)\n  except ValueError: # If primitive string is not known in the cookbook's index\n    return []\n\n  # 2. Early Exit: Check if the primitive is already in the agent's inventory\n  if state.inventory[prim_idx] > 0:\n      return []\n\n  # Define action mappings\n  ACTION_MAP = env.action_specs()\n  UP, DOWN, LEFT, RIGHT, USE = ACTION_MAP[\"UP\"], ACTION_MAP[\"DOWN\"], ACTION_MAP[\"LEFT\"], ACTION_MAP[\"RIGHT\"], ACTION_MAP[\"USE\"]\n\n  # *** IMPROVEMENT FOR collect_v2 ***\n  # If the primitive is grabbable and the agent is currently standing directly on it,\n  # a single USE action is sufficient to collect it.\n  if prim_idx in env.world.grabbable_indices:\n      curr_x, curr_y = state.pos\n      if state.grid[curr_x, curr_y, prim_idx] > 0:\n          return [USE]\n  # ***********************************\n\n  # Map movement actions to their (dx, dy) deltas (row change, column change)\n  # CraftWorld convention: X (rows) increase downwards, Y (columns) increase rightwards\n  DELTAS_BY_ACTION = {\n      UP: (-1, 0),    # Move up: decrease row (x-1)\n      DOWN: (1, 0),    # Move down: increase row (x+1)\n      LEFT: (0, -1),   # Move left: decrease column (y-1)\n      RIGHT: (0, 1)    # Move right: increase column (y+1)\n  }\n  \n  # Map agent's internal direction (0:N, 1:S, 2:W, 3:E) to (dx, dy) deltas for the cell in front\n  # From CraftState: dir 0 (North/UP), 1 (South/DOWN), 2 (West/LEFT), 3 (East/RIGHT)\n  DIR_TO_DELTA = {\n      0: (-1, 0), # North (UP)\n      1: (1, 0),  # South (DOWN)\n      2: (0, -1), # West (LEFT)\n      3: (0, 1)   # East (RIGHT)\n  }\n  \n  # Map (dx, dy) deltas to the corresponding agent direction index\n  DELTA_TO_DIR = {v: k for k, v in DIR_TO_DELTA.items()}\n\n  # Grid dimensions\n  WIDTH, HEIGHT, _ = state.grid.shape\n\n  # Identify impassable terrain types for pathfinding\n  impassable_kind_ids = set()\n  water_idx = None\n  bridge_idx = None\n\n  # Add BOUNDARY as an absolute impassable obstacle\n  try:\n    impassable_kind_ids.add(cookbook.index.index(\"BOUNDARY\"))\n  except ValueError:\n    pass # BOUNDARY might not exist in all worlds/cookbooks\n\n  # Get indices for WATER and BRIDGE to handle water crossings\n  try:\n    water_idx = cookbook.index.index(\"WATER\")\n  except ValueError:\n    pass\n  try:\n    bridge_idx = cookbook.index.index(\"BRIDGE\")\n  except ValueError:\n    pass\n\n  # BFS setup\n  start_pos = state.pos\n  start_dir = state.dir # Agent's current direction\n  \n  # Queue stores tuples of ((current_x, current_y, current_direction), [list_of_actions_to_reach_this_state])\n  q = collections.deque([((start_pos[0], start_pos[1], start_dir), [])])\n  \n  # Visited set stores (x, y, direction) tuples to avoid redundant exploration and cycles\n  visited = {(start_pos[0], start_pos[1], start_dir)}\n\n  while q:\n    ((curr_x, curr_y, curr_dir), path_so_far) = q.popleft()\n\n    # Check if the primitive is directly in front of the agent from the current (position, direction)\n    # This is the target condition: agent is positioned to interact with (e.g., USE) the primitive.\n    front_dx, front_dy = DIR_TO_DELTA[curr_dir]\n    prim_x, prim_y = curr_x + front_dx, curr_y + front_dy\n\n    # Check bounds for the cell directly in front\n    if 0 <= prim_x < WIDTH and 0 <= prim_y < HEIGHT:\n      # If the primitive is present in the cell in front\n      if state.grid[prim_x, prim_y, prim_idx] > 0:\n        final_actions = list(path_so_far) # Create a copy of the path\n\n        # If the primitive is grabbable (can be picked up), append the USE action\n        if prim_idx in env.world.grabbable_indices:\n          final_actions.append(USE)\n        # For non-grabbable primitives (e.g., WORKSHOPs, WATER, BOUNDARY),\n        # 'collect' typically means just reaching an adjacent position and facing it.\n        # No 'USE' action is appended in this case.\n        return final_actions\n\n    # Explore neighbors by considering all possible movement actions (UP, DOWN, LEFT, RIGHT)\n    for action, (dx, dy) in DELTAS_BY_ACTION.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      # The agent's new direction will be determined by the movement action taken\n      next_dir = DELTA_TO_DIR[(dx, dy)]\n\n      # Check bounds for the next cell\n      if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n        continue\n\n      # Check for impassable terrain in the next cell\n      is_impassable = False\n      # Get indices of all kinds present in the proposed next cell\n      kinds_in_next_cell = np.where(state.grid[next_x, next_y] > 0)[0] \n      \n      for kind_id_in_cell in kinds_in_next_cell:\n          if kind_id_in_cell in impassable_kind_ids:\n              is_impassable = True\n              break\n          # Special handling for WATER: only impassable if no BRIDGE in inventory\n          if water_idx is not None and kind_id_in_cell == water_idx:\n              if bridge_idx is None or state.inventory[bridge_idx] == 0:\n                  is_impassable = True\n                  break\n      \n      if is_impassable:\n        continue # Cannot move to this cell\n\n      # Check if this (position, direction) state has already been visited\n      if (next_x, next_y, next_dir) not in visited:\n        visited.add((next_x, next_y, next_dir))\n        q.append(((next_x, next_y, next_dir), path_so_far + [action]))\n\n  # If the BFS queue is exhausted and no path to the primitive was found\n  return []", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T00:34:30.255953", "function_name": "collect", "function_body": "  actions = []\n\n  # 1. Get Primitive Index: Retrieve the integer ID for the primitive.\n  cookbook = env.world.cookbook\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # Primitive name not found in the cookbook index.\n    return []\n\n  # 2. Check Grabbability: The 'collect' DSL command is for grabbable items.\n  # If the target primitive is not grabbable (e.g., a workshop, water, boundary),\n  # this function is not applicable.\n  if primitive_idx not in env.world.grabbable_indices:\n    return []\n\n  # Get current state information from the environment.\n  current_state = env._current_state\n  current_pos = current_state.pos\n  grid = current_state.grid\n  WIDTH, HEIGHT, _ = grid.shape # Dimensions of the grid\n\n  # 3. Immediate Collection Check: If the agent is already in a position to collect the primitive\n  # (i.e., next to it), simply append the 'USE' action and return. This avoids unnecessary pathfinding.\n  if current_state.next_to(primitive_idx):\n    actions.append(craft.USE)\n    return actions\n\n  # 4. Define Blocking Movement Indices and Traversability Helper:\n  # These are entities that prevent the agent from moving into a cell.\n  # Water always blocks movement. Other non-grabbable items also block, unless they are workshops\n  # (workshops are traversable for movement, though not 'collected' by this function).\n  blocking_movement_indices = {env.world.water_index}\n  for k_idx in env.world.non_grabbable_indices:\n    if k_idx != env.world.water_index and k_idx not in env.world.workshop_indices:\n      blocking_movement_indices.add(k_idx)\n\n  def is_traversable(r, c):\n    \"\"\"Checks if a given grid cell (r, c) is within bounds and traversable.\"\"\"\n    # Check if coordinates are within grid boundaries.\n    if not (0 <= r < WIDTH and 0 <= c < HEIGHT):\n      return False\n\n    # Check for any blocking items at this cell.\n    for blocked_idx in blocking_movement_indices:\n      if grid[r, c, blocked_idx] == 1:\n        return False # This cell contains an unpassable obstacle.\n    return True # The cell is traversable.\n\n  # 5. Find all grid locations where the target primitive exists.\n  target_primitive_locations = []\n  for r in range(WIDTH):\n    for c in range(HEIGHT):\n      if grid[r, c, primitive_idx] == 1:\n        target_primitive_locations.append((r, c))\n\n  if not target_primitive_locations:\n    # The primitive does not exist anywhere on the current map.\n    return []\n\n  # 6. Identify all \"collectible spots\": these are traversable cells where the agent can stand\n  # to be 'next to' one of the target primitive instances.\n  collectible_spots = set()\n  # Define offsets for a 3x3 neighborhood (including the center, as one can stand on the item itself if traversable)\n  NEIGHBORHOOD_OFFSETS = [\n      (dr, dc) for dr in [-1, 0, 1] for dc in [-1, 0, 1]\n  ]\n\n  for pr, pc in target_primitive_locations:\n    for dr, dc in NEIGHBORHOOD_OFFSETS:\n      nr, nc = pr + dr, pc + dc\n      \n      # If this potential standing spot is traversable, it's a valid \"collectible spot\".\n      if is_traversable(nr, nc):\n        collectible_spots.add((nr, nc))\n\n  if not collectible_spots:\n    # No reachable (traversable) spots identified where the agent can be next to the primitive.\n    return []\n\n  # 7. Perform a Breadth-First Search (BFS) to find the shortest path from the agent's\n  # current position to any of the identified collectible spots.\n  q = collections.deque([(current_pos, [])]) # Queue stores (current_position, path_taken_actions)\n  visited = {current_pos} # Set to keep track of visited grid cells to prevent cycles and redundant exploration.\n  path_found = None # Will store the shortest sequence of actions found.\n\n  # Map (dr, dc) for cardinal directions to action constants for pathfinding.\n  ACTION_MAP = {\n      (-1, 0): craft.UP,\n      (1, 0): craft.DOWN,\n      (0, -1): craft.LEFT,\n      (0, 1): craft.RIGHT\n  }\n  CARDINAL_DIRECTIONS = [(-1, 0), (1, 0), (0, -1), (0, 1)] # Only allow cardinal moves.\n\n  while q:\n    (r, c), current_path = q.popleft()\n\n    # If the current position is one of our target collectible spots, we have found the shortest path.\n    if (r, c) in collectible_spots:\n      path_found = current_path\n      break\n\n    # Explore cardinal neighbors (UP, DOWN, LEFT, RIGHT).\n    for dr, dc in CARDINAL_DIRECTIONS:\n      next_r, next_c = r + dr, c + dc\n      \n      if (next_r, next_c) not in visited: # Only explore if not visited\n        if is_traversable(next_r, next_c): # Only explore if the cell is traversable\n          visited.add((next_r, next_c))\n          q.append(((next_r, next_c), current_path + [ACTION_MAP[(dr, dc)]]))\n\n  # 8. Construct the final sequence of actions if a path was found.\n  if path_found:\n    actions.extend(path_found)\n    actions.append(craft.USE) # After moving to the collectible spot, perform the 'USE' action to pick up the item.\n  \n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T00:34:31.484297", "function_name": "collect", "function_body": "  actions = []\n\n  # 1. Get Primitive Index from the cookbook.\n  cookbook = env.world.cookbook\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # Primitive name not found in the cookbook index.\n    return []\n\n  # The 'collect' DSL command is specifically designed for 'grabbable' items (resources\n  # that can be picked up and go into the agent's inventory). Workshops are interacted\n  # with using 'craft', and environmental features like water or boundaries cannot be collected.\n  if primitive_idx not in env.world.grabbable_indices:\n    return []\n\n  # Get current state information from the environment.\n  current_state = env._current_state\n  agent_pos = current_state.pos\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  # 2. Immediate Collection Check: If the agent is already in a position to collect the primitive\n  # (i.e., next to it, as determined by CraftState.next_to), simply append the 'USE' action and return.\n  if current_state.next_to(primitive_idx):\n    actions.append(craft.USE)\n    return actions\n\n  # 3. Define mapping for cardinal directions to action constants for pathfinding.\n  ACTION_MAP = {\n      (-1, 0): craft.UP,\n      (1, 0): craft.DOWN,\n      (0, -1): craft.LEFT,\n      (0, 1): craft.RIGHT\n  }\n  CARDINAL_DIRECTIONS = [(-1, 0), (1, 0), (0, -1), (0, 1)] # For BFS movement\n\n  # Define offsets for a 3x3 neighborhood relative to a primitive's location.\n  # These are potential \"standing spots\" where the agent can be \"next to\" the primitive.\n  NEIGHBORHOOD_OFFSETS = [\n      (dr, dc) for dr in [-1, 0, 1] for dc in [-1, 0, 1]\n  ]\n\n  # 4. Pre-compute a set of indices for entities that block agent movement.\n  # Water is always blocking. Other non-grabbable entities block movement unless\n  # they are workshops (workshops are traversable for agent movement).\n  blocking_kind_indices = {env.world.water_index}\n  for idx in env.world.non_grabbable_indices:\n    if idx != env.world.water_index and idx not in env.world.workshop_indices:\n      blocking_kind_indices.add(idx)\n\n  # Helper function to determine if a grid cell (r, c) is traversable by the agent.\n  def is_traversable(r, c):\n      # Check if coordinates are within grid boundaries.\n      if not (0 <= r < grid_width and 0 <= c < grid_height):\n          return False\n\n      # Check for any blocking items at this cell.\n      for k_idx in blocking_kind_indices:\n          if grid[r, c, k_idx] == 1:\n              return False # This cell contains an unpassable obstacle.\n      return True\n\n  # 5. Find all grid locations where the target primitive exists.\n  # Using np.where is efficient for this.\n  primitive_rows, primitive_cols = np.where(grid[:, :, primitive_idx] == 1)\n  primitive_locations_on_grid = list(zip(primitive_rows, primitive_cols))\n\n  if not primitive_locations_on_grid:\n    # The primitive does not exist anywhere on the current map.\n    return []\n\n  # 6. Identify all \"collectible spots\": these are traversable cells where the agent\n  # can stand to be 'next to' one of the target primitive instances.\n  collectible_spots = set()\n  for pr, pc in primitive_locations_on_grid:\n    for dr, dc in NEIGHBORHOOD_OFFSETS:\n      nr, nc = pr + dr, pc + dc\n      \n      # If this potential standing spot is traversable, it's a valid \"collectible spot\".\n      if is_traversable(nr, nc):\n        collectible_spots.add((nr, nc))\n\n  if not collectible_spots:\n    # No reachable (traversable) spots identified where the agent can be next to the primitive.\n    return []\n\n  # 7. Perform a Breadth-First Search (BFS) to find the shortest path from the agent's\n  # current position to any of the identified collectible spots.\n  q = collections.deque([(agent_pos, [])]) # Queue stores (current_position, path_taken_actions)\n  visited = {agent_pos} # Set to keep track of visited grid cells to prevent cycles.\n  path_to_collect_spot = None # Will store the shortest sequence of actions found.\n\n  while q:\n    (r, c), current_path = q.popleft()\n\n    # If the current position is one of our target collectible spots, we have found the shortest path.\n    if (r, c) in collectible_spots:\n      path_to_collect_spot = current_path\n      break\n\n    # Explore cardinal neighbors (UP, DOWN, LEFT, RIGHT).\n    for dr, dc in CARDINAL_DIRECTIONS:\n      next_r, next_c = r + dr, c + dc\n      \n      if (next_r, next_c) not in visited:\n        if is_traversable(next_r, next_c):\n          visited.add((next_r, next_c))\n          q.append(((next_r, next_c), current_path + [ACTION_MAP[(dr, dc)]]))\n\n  # 8. Construct the final sequence of actions if a path was found.\n  if path_to_collect_spot:\n    actions.extend(path_to_collect_spot)\n    actions.append(craft.USE) # After moving to the collectible spot, perform the 'USE' action.\n  \n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T00:35:36.502291", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (r, c)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  # Used to calculate new position after moving forward.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: +1 to column\n      1: (-1, 0),  # Facing UP: -1 to row\n      2: (0, -1),  # Facing LEFT: -1 to column\n      3: (1, 0)    # Facing DOWN: +1 to row\n  }\n\n  # Maps for turning left/right, updating the agent's direction (0-3)\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # Get indices of non-grabbable items that block movement (e.g., BOUNDARY, WATER, WORKSHOP_X).\n  # The agent cannot move into these cells.\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # Optimization: If the primitive is already collectible from the current position, just use it.\n  # The `next_to` method checks the 3x3 neighborhood around the agent's current position.\n  if current_state.next_to(primitive_id):\n      return [USE_ACTION]\n\n  # BFS state: ((row, col), direction)\n  # Queue stores ( (current_pos_tuple, current_dir_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (current_pos_tuple, current_dir_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # Stores the action list to reach the target state\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # Check if the current (r, c) position is suitable for collecting the primitive.\n      # This means the primitive must be present in the 3x3 neighborhood of (r, c) on the initial grid.\n      found_collectable_position = False\n      for dr_check in [-1, 0, 1]:\n          for dc_check in [-1, 0, 1]:\n              check_r, check_c = r + dr_check, c + dc_check\n              # Ensure the checked cell is within grid bounds\n              if (0 <= check_r < WIDTH and 0 <= check_c < HEIGHT and\n                  initial_grid[check_r, check_c, primitive_id] > 0):\n                  found_collectable_position = True\n                  break # Found the primitive in the neighborhood\n          if found_collectable_position:\n              break\n\n      if found_collectable_position:\n          target_path = path_actions\n          break # Path to a position from which the primitive can be collected is found\n\n      # Explore possible next actions: Move Forward, Turn Left, Turn Right\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if next_pos is within bounds and this (position, direction) state hasn't been visited\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT and\n          (next_pos, next_dir) not in visited):\n          \n          is_walkable = True\n          # A cell is walkable if it does not contain any non-grabbable entity (e.g., boundary, water, workshops).\n          for kind_idx in non_walkable_kinds_indices:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          # The agent cannot walk onto the primitive itself when trying to collect it;\n          # it needs to be adjacent.\n          if initial_grid[next_r, next_c, primitive_id] > 0:\n              is_walkable = False\n\n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path was found to a collectable position, append the USE action to complete the task.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T00:35:37.752917", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (r, c)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  # Get the integer ID for the target primitive from the cookbook index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # Retrieve action mapping from the environment's action specifications\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP'] # 'UP' in action_specs implies moving forward\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  # This helps calculate the next position when moving forward\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: +1 to column (c)\n      1: (-1, 0),  # Facing UP: -1 to row (r)\n      2: (0, -1),  # Facing LEFT: -1 to column (c)\n      3: (1, 0)    # Facing DOWN: +1 to row (r)\n  }\n\n  # Maps for updating the agent's direction when turning left/right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0} # R -> U -> L -> D -> R\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # R -> D -> L -> U -> R\n\n  # Identify non-walkable entities (e.g., BOUNDARY, WATER, WORKSHOP_X) that block agent movement\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # Optimization: If the primitive is already in the 3x3 neighborhood of the agent's current position,\n  # no pathfinding is needed; just use the item.\n  if current_state.next_to(primitive_id):\n      return [USE_ACTION]\n\n  # Initialize Breadth-First Search (BFS)\n  # Queue stores ( (current_position_tuple, current_direction_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (position_tuple, direction_int) to avoid redundant computations and cycles\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the sequence of actions to reach a collectable position\n\n  # BFS Loop\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # Check if the current position is a \"goal\" state for collection.\n      # A goal state means the primitive is within the 3x3 neighborhood of the agent's current (r, c).\n      is_collectable_position = False\n      for dr_check in [-1, 0, 1]:\n          for dc_check in [-1, 0, 1]:\n              check_r, check_c = r + dr_check, c + dc_check\n              # Ensure the cell being checked is within grid bounds\n              if (0 <= check_r < WIDTH and 0 <= check_c < HEIGHT and\n                  initial_grid[check_r, check_c, primitive_id] > 0):\n                  is_collectable_position = True\n                  break # Found the primitive in the neighborhood\n          if is_collectable_position:\n              break\n\n      if is_collectable_position:\n          target_path = path_actions # Path to reach this collectable position\n          break # Shortest path found, terminate BFS\n\n      # Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right\n\n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if the next position is within bounds and has not been visited with this direction\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT and\n          (next_pos, next_dir) not in visited):\n          \n          is_walkable = True\n          # A cell is considered walkable if it does not contain any non-grabbable entity\n          # and also not the primitive itself (agent collects from adjacent, not by walking over it).\n          for kind_idx in non_walkable_kinds_indices:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          # Ensure the agent does not try to walk onto the primitive itself\n          if initial_grid[next_r, next_c, primitive_id] > 0:\n              is_walkable = False\n\n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning changes direction but not position\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning changes direction but not position\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path to a collectable position was found, append the USE action to perform the collection\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T00:36:24.595330", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  ACTION_UP = action_map[\"UP\"]\n  ACTION_DOWN = action_map[\"DOWN\"]\n  ACTION_LEFT = action_map[\"LEFT\"]\n  ACTION_RIGHT = action_map[\"RIGHT\"]\n  ACTION_USE = action_map[\"USE\"]\n\n  # 1. Get the integer ID for the target primitive.\n  # Convert to lowercase as names in the cookbook index are typically lowercased.\n  primitive_id = env.world.cookbook.index[primitive.lower()]\n  if primitive_id is None:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Crucial check: If the target primitive is not an item that can be grabbed/collected,\n  # there's no sequence of actions to \"collect\" it.\n  if primitive_id not in env.world.grabbable_indices:\n    return []\n\n  # 3. Get current state details from the environment\n  current_state = env._current_state\n  start_pos = current_state.pos  # Agent's current (x, y) integer position\n  grid = current_state.grid      # The full grid layout: (WIDTH, HEIGHT, n_kinds)\n  \n  # Get grid dimensions\n  grid_width, grid_height, _ = grid.shape\n\n  # 4. Define obstacle kinds: A cell is considered an obstacle if it contains\n  # ANY item from the `non_grabbable_indices` set.\n  obstacle_kind_ids = env.world.non_grabbable_indices\n\n  # 5. Define possible movements (change in x, change in y, corresponding action)\n  # (dx, dy) maps to (column_change, row_change) for grid[x, y]\n  move_actions = [\n      (0, -1, ACTION_UP),    # Move North (decreases y, i.e., row index)\n      (0, 1, ACTION_DOWN),   # Move South (increases y)\n      (-1, 0, ACTION_LEFT),  # Move West (decreases x, i.e., column index)\n      (1, 0, ACTION_RIGHT)   # Move East (increases x)\n  ]\n\n  # 6. Initialize Breadth-First Search (BFS)\n  # Queue stores tuples: ((x, y), [actions_to_reach_here])\n  queue = collections.deque([(start_pos, [])])\n  # Set to keep track of visited grid cells ((x, y) tuples) to avoid cycles and redundant work\n  visited = {start_pos}\n\n  # 7. BFS loop to find the shortest path to the primitive\n  while queue:\n    current_pos, path_so_far = queue.popleft()\n    cx, cy = current_pos\n\n    # Check if the current cell (cx, cy) contains the desired primitive.\n    # `grid[cx, cy, primitive_id] > 0` indicates presence (e.g., 1 for 1-hot encoding).\n    if grid[cx, cy, primitive_id] > 0:\n      # If the primitive is at the current cell, and it's grabbable (checked upfront),\n      # we've found the shortest path to it. Append ACTION_USE to collect it.\n      return path_so_far + [ACTION_USE]\n\n    # Explore neighboring cells\n    for dx, dy, action_move in move_actions:\n      nx, ny = cx + dx, cy + dy  # Calculate neighbor's coordinates\n      next_pos = (nx, ny)\n\n      # Check 1: Is the neighbor within grid boundaries?\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue\n\n      # Check 2: Has the neighbor already been visited?\n      if next_pos in visited:\n        continue\n\n      # Check 3: Is the neighbor cell an obstacle?\n      # A cell is an obstacle if it contains any object that is in the `non_grabbable_indices` set.\n      is_obstacle_cell = False\n      for obstacle_id in obstacle_kind_ids:\n        if grid[nx, ny, obstacle_id] > 0:  # If this obstacle is present in the cell\n          is_obstacle_cell = True\n          break\n      \n      if is_obstacle_cell:\n        continue  # Skip this move if it leads to an impassable object\n\n      # If the neighbor is valid (within bounds, not visited, and traversable),\n      # add it to the queue with its path and mark it as visited.\n      visited.add(next_pos)\n      queue.append((next_pos, path_so_far + [action_move]))\n\n  # 8. If the BFS completes and the primitive was not found anywhere accessible on the grid,\n  # return an empty list, indicating that it cannot be collected from the current state.\n  return []", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T00:36:25.954162", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  ACTION_UP = action_map[\"UP\"]\n  ACTION_DOWN = action_map[\"DOWN\"]\n  ACTION_LEFT = action_map[\"LEFT\"]\n  ACTION_RIGHT = action_map[\"RIGHT\"]\n  ACTION_USE = action_map[\"USE\"]\n\n  # Get the integer ID for the target primitive.\n  # The DSL's `primitive` names are capitalized (e.g., 'WOOD').\n  # It's safer to use `.lower()` if the cookbook's internal index keys are lowercase.\n  primitive_id = env.world.cookbook.index[primitive.lower()]\n  if primitive_id is None:\n    # This scenario should ideally be prevented by the DSL's validation,\n    # but as a safeguard, return empty if the primitive name is not recognized.\n    return []\n\n  # Crucial check: If the target primitive is not an item that can be grabbed/collected,\n  # there is no sequence of actions to \"collect\" it.\n  if primitive_id not in env.world.grabbable_indices:\n    return []\n\n  # Get current state details from the environment.\n  current_state = env._current_state\n  start_pos = current_state.pos  # Agent's current (x, y) integer position\n  grid = current_state.grid      # The full grid layout: (WIDTH, HEIGHT, n_kinds)\n  \n  # Get grid dimensions for boundary checks.\n  grid_width, grid_height, _ = grid.shape\n\n  # Define obstacle kinds: A cell is considered an obstacle if it contains\n  # ANY item from the `non_grabbable_indices` set. These are entities that block movement.\n  obstacle_kind_ids = env.world.non_grabbable_indices\n\n  # Define possible movements (change in x, change in y, corresponding action).\n  # (dx, dy) maps to (column_change, row_change) for grid[column_index, row_index].\n  move_deltas = [\n      (0, -1, ACTION_UP),    # Move North (decreases y, i.e., row index)\n      (0, 1, ACTION_DOWN),   # Move South (increases y)\n      (-1, 0, ACTION_LEFT),  # Move West (decreases x, i.e., column index)\n      (1, 0, ACTION_RIGHT)   # Move East (increases x)\n  ]\n\n  # Initialize Breadth-First Search (BFS).\n  # The queue stores tuples: (current_position, list_of_actions_to_reach_here).\n  queue = collections.deque([(start_pos, [])])\n  # The set `visited` keeps track of grid cells ((x, y) tuples) that have been\n  # added to the queue to avoid cycles and redundant exploration.\n  visited = {start_pos}\n\n  # BFS loop to find the shortest path to the primitive.\n  while queue:\n    current_pos, path_so_far = queue.popleft()\n    cx, cy = current_pos\n\n    # Check if the current cell (cx, cy) contains the desired primitive.\n    # `grid[cx, cy, primitive_id] > 0` indicates the primitive is present at this location.\n    if grid[cx, cy, primitive_id] > 0:\n      # If the primitive is found at the current cell, we've discovered the shortest path to it.\n      # Append ACTION_USE to the path to simulate collecting the primitive.\n      return path_so_far + [ACTION_USE]\n\n    # Explore neighboring cells.\n    for dx, dy, action_move in move_deltas:\n      nx, ny = cx + dx, cy + dy  # Calculate the neighbor's coordinates.\n      next_pos = (nx, ny)\n\n      # 1. Boundary check: Ensure the neighbor is within the grid boundaries.\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue\n\n      # 2. Visited check: Skip if this neighbor has already been visited (or is in queue).\n      if next_pos in visited:\n        continue\n\n      # 3. Obstacle check: Determine if the neighbor cell is blocked by a non-grabbable item.\n      # We cannot move into a cell that contains any of the defined non-grabbable entities.\n      is_obstacle_cell = False\n      for obstacle_id in obstacle_kind_ids:\n        if grid[nx, ny, obstacle_id] > 0:  # If this obstacle is present in the cell.\n          is_obstacle_cell = True\n          break\n      \n      if is_obstacle_cell:\n        continue  # Skip this move if it leads to an impassable obstacle.\n\n      # If the neighbor is valid (within bounds, not visited, and traversable),\n      # add it to the queue with its path and mark it as visited.\n      visited.add(next_pos)\n      queue.append((next_pos, path_so_far + [action_move]))\n\n  # If the BFS completes and the primitive was not found anywhere accessible on the grid,\n  # return an empty list, indicating that it cannot be collected from the current state.\n  return []", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T00:37:02.467838", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\"\"\"\n  actions = []\n  \n  current_state = env._current_state \n  grid = current_state.grid\n  current_pos = current_state.pos\n  \n  primitive_id = env.world.cookbook.index[primitive]\n\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Retrieve action mapping from the environment for robustness\n  _action_specs = env.action_specs()\n  DOWN = _action_specs['DOWN']\n  UP = _action_specs['UP']\n  LEFT = _action_specs['LEFT']\n  RIGHT = _action_specs['RIGHT']\n  USE = _action_specs['USE']\n\n  DELTAS = {\n      UP: (-1, 0),\n      DOWN: (1, 0),\n      LEFT: (0, -1),\n      RIGHT: (0, 1)\n  }\n\n  # V2 Improvement: Ensure the primitive is actually grabbable.\n  if primitive_id not in env.world.grabbable_indices:\n      return []\n\n  # 1. Check if the agent is already next to the primitive\n  if current_state.next_to(primitive_id):\n      actions.append(USE)\n      return actions\n\n  # 2. Find all locations of the target primitive on the grid\n  primitive_locations = []\n  for r in range(WIDTH):\n      for c in range(HEIGHT):\n          if grid[r, c, primitive_id] == 1:\n              primitive_locations.append((r, c))\n\n  if not primitive_locations:\n      return []\n\n  # V2 Improvement: Pre-compute all valid \"target use positions\".\n  # A \"target use position\" is a grid cell from which the agent can apply 'USE'\n  # to collect the desired primitive. This cell must be adjacent to a primitive\n  # location AND must be traversable by the agent.\n  target_use_positions = set()\n  for pr, pc in primitive_locations:\n      for dr, dc in DELTAS.values(): # Iterate through all 4 cardinal directions\n          adj_r, adj_c = pr + dr, pc + dc\n\n          # Ensure the adjacent cell is within grid boundaries\n          if not (0 <= adj_r < WIDTH and 0 <= adj_c < HEIGHT):\n              continue\n\n          # Ensure the adjacent cell is traversable (not an obstacle).\n          # An agent must be able to stand on this cell to use a primitive next to it.\n          is_traversable = True\n          for i_kind in env.world.non_grabbable_indices:\n              if grid[adj_r, adj_c, i_kind] == 1: # If this cell contains a non-grabbable item\n                  is_traversable = False\n                  break # This neighbor is an obstacle\n          \n          if is_traversable:\n              target_use_positions.add((adj_r, adj_c))\n    \n  # If there are no traversable spots from which to use the primitive, it's uncollectable.\n  if not target_use_positions:\n      return []\n\n  # 3. Perform Breadth-First Search (BFS) to find the shortest path\n  #    to any of the pre-computed `target_use_positions`.\n  q = collections.deque([(current_pos, [])]) \n  visited = {current_pos} \n\n  target_adj_pos_path = None \n\n  while q:\n      (r, c), path = q.popleft()\n\n      # Directly check if the current BFS node (r, c) is one of our pre-computed target positions.\n      if (r, c) in target_use_positions:\n          target_adj_pos_path = path \n          break \n\n      # Explore valid neighboring cells from the current position (r, c).\n      for action_dir, (dr, dc) in DELTAS.items():\n          nr, nc = r + dr, c + dc \n\n          # Check 1: Ensure the new position is within the grid boundaries.\n          if not (0 <= nr < WIDTH and 0 <= nc < HEIGHT):\n              continue\n          \n          # Check 2: Ensure the new position is traversable (not an obstacle).\n          is_traversable = True\n          for i_kind in env.world.non_grabbable_indices:\n              if grid[nr, nc, i_kind] == 1: \n                  is_traversable = False\n                  break \n          \n          if not is_traversable:\n              continue \n          \n          # Check 3: If this neighbor has not been visited yet, add it to the queue.\n          if (nr, nc) not in visited:\n              visited.add((nr, nc))\n              q.append(((nr, nc), path + [action_dir]))\n    \n  # 4. Construct the final sequence of actions.\n  if target_adj_pos_path is not None:\n      actions.extend(target_adj_pos_path)\n      actions.append(USE) \n  \n  return actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T00:37:03.637707", "function_name": "collect", "function_body": "  \"\"\"Returns a list of actions to find and collect the primitive in the passed env.\n    \n    This version enhances previous iterations by robustly handling traversability checks\n    for potential agent positions and ensuring the target primitive is grabbable.\n\n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect.\n\n    Returns:\n        List[int]: A sequence of action indices to execute.\n  \"\"\"\n  actions = []\n  \n  # Get the current state, grid, and agent position from the environment.\n  # CraftLab stores the current state in _current_state.\n  current_state = env._current_state \n  grid = current_state.grid\n  current_pos = current_state.pos\n  \n  # Retrieve the integer ID of the primitive from the cookbook's index.\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Essential check: If the primitive is not grabbable, it cannot be collected into inventory.\n  # This prevents attempts to 'collect' non-grabbable items like boundaries or workshops.\n  if primitive_id not in env.world.grabbable_indices:\n      return []\n\n  # Get grid dimensions.\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Retrieve action mappings dynamically from the environment for robustness.\n  action_map = env.action_specs()\n  DOWN = action_map['DOWN']\n  UP = action_map['UP']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Define movement deltas for convenience for the 4 cardinal directions.\n  # Maps action constant to (row_change, col_change).\n  DELTAS = {\n      UP: (-1, 0),\n      DOWN: (1, 0),\n      LEFT: (0, -1),\n      RIGHT: (0, 1)\n  }\n\n  # Step 1: Check if the agent is already in a position to collect the primitive.\n  # `current_state.next_to(primitive_id)` checks if any cell in the 3x3 neighborhood\n  # around the agent's current position contains the primitive.\n  if current_state.next_to(primitive_id):\n      actions.append(USE)\n      return actions # Only a 'USE' action is needed.\n\n  # Step 2: Identify all grid locations where the primitive exists.\n  primitive_locations = []\n  for r in range(WIDTH):\n      for c in range(HEIGHT):\n          # A value of 1 in the grid at [r, c, primitive_id] means the primitive is present.\n          if grid[r, c, primitive_id] == 1:\n              primitive_locations.append((r, c))\n\n  # If no instance of the primitive is found on the grid, it's uncollectable.\n  if not primitive_locations:\n      return []\n\n  # Step 3: Determine all valid \"target use positions\".\n  # These are grid cells where the agent can stand to 'USE' and collect the primitive.\n  # A valid position must be:\n  #   a) Adjacent (Manhattan distance 1) to a primitive's location.\n  #   b) Traversable (agent can physically occupy this cell).\n  target_use_positions = set()\n  for prim_r, prim_c in primitive_locations:\n      for dr, dc in DELTAS.values(): # Check all 4 neighbors of each primitive location\n          potential_agent_r, potential_agent_c = prim_r + dr, prim_c + dc\n\n          # Check bounds for the potential agent position.\n          if not (0 <= potential_agent_r < WIDTH and 0 <= potential_agent_c < HEIGHT):\n              continue\n\n          # Check traversability for the potential agent position.\n          # A cell is non-traversable if it contains any non-grabbable entity.\n          is_traversable = True\n          for i_kind in env.world.non_grabbable_indices:\n              if grid[potential_agent_r, potential_agent_c, i_kind] == 1:\n                  is_traversable = False\n                  break # This cell is an obstacle.\n          \n          if is_traversable:\n              target_use_positions.add((potential_agent_r, potential_agent_c))\n    \n  # If no traversable positions exist from which to use the primitive, it cannot be collected.\n  if not target_use_positions:\n      return []\n\n  # Step 4: Perform Breadth-First Search (BFS) to find the shortest path\n  #         from the agent's current position to any of the `target_use_positions`.\n  # Queue stores tuples: ((current_row, current_col), [list_of_actions_to_reach_here])\n  q = collections.deque([(current_pos, [])]) \n  visited = {current_pos} # Keep track of visited (row, col) to prevent cycles and find shortest path.\n\n  shortest_path_to_use_pos = None # This will store the action sequence once found.\n\n  while q:\n      (r, c), path = q.popleft()\n\n      # If the current BFS node is one of our valid target use positions,\n      # we've found the shortest path to a spot from which to 'USE'.\n      if (r, c) in target_use_positions:\n          shortest_path_to_use_pos = path\n          break # Exit BFS, as the shortest path is guaranteed by BFS properties.\n\n      # Explore all four cardinal neighbors.\n      for action_dir, (dr, dc) in DELTAS.items():\n          next_r, next_c = r + dr, c + dc", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-08-01T00:38:22.834402", "function_name": "collect", "function_body": "  actions = [] # The list of actions to be returned\n    \n  # 1. Retrieve essential environment information\n  action_map = env.action_specs() # Maps action names (str) to integer IDs\n  # Define action constants for readability\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  cookbook = env.world.cookbook # Contains mapping of names to IDs, recipes, etc.\n  \n  # Get the integer ID for the primitive string name\n  try:\n      primitive_id = cookbook.index.index(primitive)\n  except KeyError:\n      # If the primitive name is not recognized in the cookbook, it's an invalid target.\n      return []\n\n  # Get the current state of the agent and the grid\n  current_state = env._current_state\n  grid = current_state.grid # (WIDTH, HEIGHT, n_kinds)\n  start_pos = current_state.pos # (r, c) tuple\n  start_dir = current_state.dir # Integer direction (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n\n  # Grid dimensions\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Identify indices of impassable terrain types\n  # 'boundary' is typically an impassable wall\n  boundary_id = cookbook.index.index(\"boundary\") \n  # 'water' is also typically impassable to walk onto\n  water_id = env.world.water_index \n\n  # Determine if the primitive is 'grabbable' (can be picked up by standing on it)\n  # Grabbable items (like wood, iron, grass) are picked up by standing on their cell and using.\n  # Non-grabbable items (like workshops, stone, gold, gem) are interacted with from an adjacent cell.\n  is_grabbable = primitive_id in env.world.grabbable_indices\n\n  # 2. Helper function to check if a grid position is valid for the agent to occupy\n  def is_valid_pos(r, c):\n    \"\"\"Checks if a cell (r, c) is within grid bounds and does not contain impassable terrain.\"\"\"\n    if not (0 <= r < WIDTH and 0 <= c < HEIGHT):\n      return False # Out of bounds\n    # Check if the cell contains impassable elements\n    if grid[r, c, boundary_id] > 0 or grid[r, c, water_id] > 0:\n      return False # Cannot walk onto boundary or water\n    return True\n\n  # 3. Find all locations of the target primitive on the grid\n  primitive_locations = [] # Stores (r, c) tuples for cells containing the primitive\n  for r in range(WIDTH):\n      for c in range(HEIGHT):\n          if grid[r, c, primitive_id] > 0: # Check if the primitive kind exists at this cell\n              primitive_locations.append((r, c))\n\n  # If the primitive is not present anywhere on the map, it cannot be collected.\n  if not primitive_locations:\n      return []\n\n  # 4. Define movement mechanics for BFS\n  # Maps action -> (dr, dc) delta for agent's position change\n  move_deltas = {\n      UP: (-1, 0), # Move UP: row decreases\n      DOWN: (1, 0), # Move DOWN: row increases\n      LEFT: (0, -1), # Move LEFT: column decreases\n      RIGHT: (0, 1) # Move RIGHT: column increases\n  }\n\n  # Maps action -> resulting agent direction ID after performing the move\n  # (Assumes DMLab-style directions: 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n  action_to_direction_map = {\n      UP: 0,\n      RIGHT: 1,\n      DOWN: 2,\n      LEFT: 3,\n  }\n\n  # Maps agent's direction ID -> (dr, dc) delta from agent's position to the cell it's facing\n  dir_to_delta = {\n      0: (-1, 0), # Facing UP: cell in front is (r-1, c)\n      1: (0, 1),  # Facing RIGHT: cell in front is (r, c+1)\n      2: (1, 0),  # Facing DOWN: cell in front is (r+1, c)\n      3: (0, -1)  # Facing LEFT: cell in front is (r, c-1)\n  }\n\n  # 5. Pre-compute all (position, direction) states from which 'USE' will succeed.\n  # These are the target states for our BFS.\n  # A state is defined by (row, column, agent_direction_id).\n  target_use_states = set()\n  for pr, pc in primitive_locations: # For each location where the primitive is found\n      if is_grabbable:\n          # If the item is grabbable (e.g., WOOD, IRON), the agent must be ON its cell.\n          # The direction of the agent doesn't matter for picking up an item on its current cell.\n          if is_valid_pos(pr, pc): # Ensure the agent can actually stand on this cell\n              for d_id in action_to_direction_map.values(): # Iterate all 4 possible agent directions\n                  target_use_states.add((pr, pc, d_id))\n      else:\n          # If the item is non-grabbable (e.g., WORKSHOP0, STONE), the agent must be ADJACENT to it AND FACING it.\n          # Iterate through the 4 possible directions the agent could face to interact with the primitive.\n          for facing_dir_id, (dr_prim_rel, dc_prim_rel) in dir_to_delta.items():\n              # (dr_prim_rel, dc_prim_rel) is the delta from the *agent's position* to the *primitive's position*.\n              # So, if primitive is at (pr, pc), the agent's required position (ar, ac) is:\n              # (ar, ac) = (pr - dr_prim_rel, pc - dc_prim_rel)\n              ar, ac = pr - dr_prim_rel, pc - dc_prim_rel\n              \n              # Check if this calculated agent position is valid to stand on\n              if is_valid_pos(ar, ac):\n                  # Add this agent state (position and direction) as a target from which USE can occur.\n                  target_use_states.add((ar, ac, facing_dir_id))\n\n  # 6. Perform Breadth-First Search (BFS)\n  # BFS State: ((current_row, current_col), current_direction, path_of_actions_so_far)\n  queue = collections.deque([(start_pos, start_dir, [])])\n  # visited set: Stores (position, direction) tuples to avoid re-exploring states and find shortest path\n  visited = {(start_pos, start_dir)}\n\n  while queue:\n    (r, c), current_dir, path = queue.popleft() # Dequeue the current state\n\n    # --- Goal Check ---\n    # If the current state (position and direction) is one from which 'USE' can be performed\n    if (r, c, current_dir) in target_use_states:\n        return path + [USE] # Return the path found, appended with the final 'USE' action\n\n    # --- Explore Neighbors (Possible Next Moves) ---\n    for action, (dr, dc) in move_deltas.items():\n      next_r, next_c = r + dr, c + dc\n      next_pos = (next_r, next_c)\n      \n      # When the agent performs a movement action, its direction typically changes to match the movement.\n      next_dir = action_to_direction_map[action] \n\n      # Check if the next position is valid to move to, and if this exact (position, direction)\n      # state has not been visited yet (to guarantee shortest path and prevent loops).\n      if is_valid_pos(next_r, next_c) and (next_pos, next_dir) not in visited:\n        visited.add((next_pos, next_dir)) # Mark as visited\n        queue.append((next_pos, next_dir, path + [action])) # Enqueue the new state with updated path\n\n  # If the BFS queue becomes empty and no path to a target 'USE' state was found\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T00:38:24.028182", "function_name": "collect", "function_body": "  actions = []\n    \n  # Get the action mapping (e.g., 'UP' -> 1, 'USE' -> 4)\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Get relevant IDs from the environment's world and cookbook\n  cookbook = env.world.cookbook\n  try:\n      primitive_id = cookbook.index.index(primitive)\n  except KeyError:\n      # If the primitive name is not recognized, return an empty list of actions.\n      return []\n\n  # Get the current state information\n  current_state = env._current_state\n  grid = current_state.grid\n  start_pos = current_state.pos\n  start_dir = current_state.dir # Agent's current facing direction\n\n  # Grid dimensions (WIDTH is first dimension, HEIGHT is second)\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Identify impassable terrain types (unchanged from v1, assuming only boundary and water are always blocked)\n  boundary_id = cookbook.index.index(\"boundary\")\n  water_id = env.world.water_index\n\n  # Determine item properties\n  is_grabbable = primitive_id in env.world.grabbable_indices\n  is_workshop = primitive_id in env.world.workshop_indices\n\n  # Helper function to check if a position is valid for the agent to stand on\n  def is_valid_pos(r, c):\n    if not (0 <= r < WIDTH and 0 <= c < HEIGHT):\n      return False\n    # Cells containing boundary or water are generally impassable for movement\n    if grid[r, c, boundary_id] > 0 or grid[r, c, water_id] > 0:\n      return False\n    return True\n\n  # Pre-compute all primitive locations on the grid\n  primitive_locations = [] # List of (r, c) tuples where the primitive exists\n  for r in range(WIDTH):\n      for c in range(HEIGHT):\n          if grid[r, c, primitive_id] > 0:\n              primitive_locations.append((r, c))\n\n  # If no instance of the primitive exists on the grid, no path is possible\n  if not primitive_locations:\n      return []\n\n  # Define possible movement deltas and their corresponding actions\n  move_deltas = {\n      UP: (-1, 0), # Row decreases for UP\n      DOWN: (1, 0), # Row increases for DOWN\n      LEFT: (0, -1), # Column decreases for LEFT\n      RIGHT: (0, 1) # Column increases for RIGHT\n  }\n\n  # Maps action to the resulting agent direction ID\n  # (Assuming DMLab-style directions: 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n  action_to_direction_map = {\n      UP: 0,\n      RIGHT: 1,\n      DOWN: 2,\n      LEFT: 3,\n  }\n\n  # Maps direction ID to the (dr, dc) delta from the agent's position to the cell it faces\n  dir_to_delta = {\n      0: (-1, 0), # UP\n      1: (0, 1),  # RIGHT\n      2: (1, 0),  # DOWN\n      3: (0, -1)  # LEFT\n  }\n\n  # Pre-compute all target (position, direction) states from which 'USE' will succeed.\n  target_use_states = set()\n  for pr, pc in primitive_locations:\n      if is_grabbable or is_workshop:\n          # For grabbable items (e.g., WOOD, IRON) or workshops (WORKSHOP0),\n          # the agent typically needs to be ON (pr, pc) to interact/collect.\n          # Direction does not matter for the 'USE' action in this context, but we need to cover all\n          # possible directions for the BFS state.\n          if is_valid_pos(pr, pc): # Agent must be able to stand on this tile\n              for d_id in action_to_direction_map.values(): # Iterate over all 4 possible agent directions\n                  target_use_states.add((pr, pc, d_id))\n      else:\n          # For other non-grabbable items (like STONE, WATER, BOUNDARY if they are interactable)\n          # the agent usually needs to be ADJACENT to (pr, pc) and FACING it.\n          for facing_dir_id, (dr_face, dc_face) in dir_to_delta.items():\n              # Calculate the potential agent position (ar, ac) such that it faces (pr, pc)\n              ar, ac = pr - dr_face, pc - dc_face\n              \n              if is_valid_pos(ar, ac): # Agent must be able to stand on this tile\n                  target_use_states.add((ar, ac, facing_dir_id))\n\n  # BFS State: (current_position (r,c), current_direction (int), path_of_actions (list))\n  queue = collections.deque([(start_pos, start_dir, [])])\n  # Visited set tracks (position, direction) pairs to avoid cycles and redundant paths\n  visited = {(start_pos, start_dir)}\n\n  while queue:\n    (r, c), current_dir, path = queue.popleft()\n\n    # --- Goal Check ---\n    # Check if the current (position, direction) state is one from which 'USE' will succeed.\n    if (r, c, current_dir) in target_use_states:\n        return path + [USE]\n\n    # --- Explore Neighbors (Movement Actions) ---\n    for action, (dr, dc) in move_deltas.items():\n      next_r, next_c = r + dr, c + dc\n      next_pos = (next_r, next_c)\n      \n      # When the agent moves, its direction changes to the direction of movement.\n      # This is a critical detail for CraftWorld's movement model.\n      next_dir = action_to_direction_map[action] \n\n      # Check if the next position is valid and this specific (position, direction) state\n      # has not been visited yet to ensure shortest path and avoid infinite loops.\n      if is_valid_pos(next_r, next_c) and (next_pos, next_dir) not in visited:\n        visited.add((next_pos, next_dir))\n        queue.append((next_pos, next_dir, path + [action]))\n\n  # If the queue becomes empty and no path to a primitive was found\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T00:39:06.938942", "function_name": "collect", "function_body": "", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-08-01T00:39:08.300573", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  ACTION_UP = action_map[\"UP\"]\n  ACTION_DOWN = action_map[\"DOWN\"]\n  ACTION_LEFT = action_map[\"LEFT\"]\n  ACTION_RIGHT = action_map[\"RIGHT\"]\n  ACTION_USE = action_map[\"USE\"]\n\n  # Get current state details\n  current_state = env._current_state\n  current_grid = current_state.grid\n  start_pos = current_state.pos\n  grid_width, grid_height, _ = current_grid.shape\n\n  # Get the integer ID for the target primitive from the cookbook index\n  try:\n    # Use .index() to reliably get the integer ID for the primitive name.\n    # This also raises a KeyError if the primitive name is not known.\n    primitive_id = env.world.cookbook.index.index(primitive)\n  except KeyError:\n    # If the primitive is unknown, it cannot be collected.\n    return []\n\n  # Determine if the target primitive is grabbable (can be picked up with USE_ACTION)\n  grabbable_ids_set = set(env.world.grabbable_indices)\n  is_grabbable_target = (primitive_id in grabbable_ids_set)\n\n  # Get indices for entities that are generally impassable (non-grabbable and block movement)\n  # This set typically includes things like water, stone, and workshops.\n  impassable_kind_ids = set(env.world.non_grabbable_indices)\n\n  # BFS initialization for pathfinding\n  # Queue stores tuples: (current_position (x, y), path_taken_so_far_as_action_list)\n  queue = collections.deque([(start_pos, [])])\n  # Visited set stores positions to avoid cycles and redundant exploration\n  visited = {start_pos}\n\n  # Define possible moves and their corresponding (dx, dy) deltas\n  move_deltas = {\n      ACTION_UP: (0, -1),\n      ACTION_DOWN: (0, 1),\n      ACTION_LEFT: (-1, 0),\n      ACTION_RIGHT: (1, 0),\n  }\n\n  # BFS loop to find the shortest path to the primitive\n  while queue:\n    current_pos, path_so_far = queue.popleft()\n    cx, cy = current_pos\n\n    # Check if the current cell contains the target primitive\n    # We use > 0 because a cell might contain multiple units of a kind.\n    if current_grid[cx, cy, primitive_id] > 0:\n      # Primitive found at current location.\n      if is_grabbable_target:\n        # If it's a grabbable item (e.g., WOOD, IRON), append USE_ACTION to pick it up.\n        return path_so_far + [ACTION_USE]\n      else:\n        # If it's a non-grabbable feature (e.g., WORKSHOP0, WATER),\n        # \"collecting\" means simply reaching its location. No USE_ACTION needed.\n        return path_so_far\n\n    # Explore neighboring cells\n    for action, (dx, dy) in move_deltas.items():\n      nx, ny = cx + dx, cy + dy\n      next_pos = (nx, ny)\n\n      # 1. Check if the next position is within grid boundaries\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue\n\n      # 2. Check if the next position has already been visited\n      if next_pos in visited:\n        continue\n\n      # 3. Check for obstacles at the next position.\n      # A cell is considered an obstacle if it contains any impassable item\n      # that is NOT the primitive we are trying to collect. This allows the agent\n      # to pathfind *onto* the target primitive's tile even if it's generally\n      # non-grabbable (e.g., moving onto a workshop tile when trying to \"collect\" a workshop).\n      is_obstacle_cell = False\n      for kind_id in impassable_kind_ids:\n        # If the cell contains an impassable kind that is *not* our target primitive\n        if kind_id != primitive_id and current_grid[nx, ny, kind_id] > 0:\n          is_obstacle_cell = True\n          break\n      \n      if is_obstacle_cell:\n        continue # Skip this move if it leads to an impassable obstacle\n\n      # If the move is valid (within bounds, not visited, not an obstacle), add it to the queue\n      visited.add(next_pos)\n      queue.append((next_pos, path_so_far + [action]))\n\n  # If the BFS completes and no path to the primitive was found, return an empty list\n  return []", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T00:40:00.081112", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (r, c)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  # Get the integer ID for the target primitive from the cookbook index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # Retrieve action mapping from the environment's action specifications\n  action_map = env.action_specs()\n  # DSL 'UP' action typically means 'move forward' in the agent's current direction.\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  # This helps calculate the next position when moving forward based on current direction.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: +1 to column (c)\n      1: (-1, 0),  # Facing UP: -1 to row (r)\n      2: (0, -1),  # Facing LEFT: -1 to column (c)\n      3: (1, 0)    # Facing DOWN: +1 to row (r)\n  }\n\n  # Maps for updating the agent's direction when turning left/right.\n  # These cycle through the directions (0, 1, 2, 3).\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0} # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Identify non-walkable entities (e.g., BOUNDARY, WATER, WORKSHOP_X) that block agent movement.\n  # These indices are obtained from the CraftWorld configuration.\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # Optimization: If the primitive is already in the 3x3 neighborhood of the agent's current position,\n  # no pathfinding is needed; just execute the USE action directly.\n  # The `next_to` method efficiently checks this condition.\n  if current_state.next_to(primitive_id):\n      return [USE_ACTION]\n\n  # Initialize Breadth-First Search (BFS) for pathfinding.\n  # The queue stores tuples: ( (current_position_tuple, current_direction_int), list_of_actions_to_reach_here ).\n  # This allows us to track both location and orientation, which are crucial for movement.\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # The visited set stores (position_tuple, direction_int) pairs to avoid redundant computations\n  # and infinite loops in cyclic paths.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This variable will store the shortest sequence of actions found to reach a collectable state.\n\n  # BFS Loop: continues as long as there are states to explore.\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # Check if the current position is a \"goal\" state for collection.\n      # A goal state means the primitive is located in any cell within the 3x3 neighborhood\n      # centered at the agent's current position (r, c) on the initial grid.\n      is_collectable_position = False\n      for dr_check in [-1, 0, 1]: # Iterate over relative row offsets (-1, 0, 1)\n          for dc_check in [-1, 0, 1]: # Iterate over relative column offsets (-1, 0, 1)\n              check_r, check_c = r + dr_check, c + dc_check\n              # Ensure the cell being checked is within grid bounds.\n              if (0 <= check_r < WIDTH and 0 <= check_c < HEIGHT and\n                  initial_grid[check_r, check_c, primitive_id] > 0):\n                  is_collectable_position = True\n                  break # Found the primitive in the neighborhood, no need to check further cells for this position.\n          if is_collectable_position:\n              break # Found for current position, break outer loop too.\n\n      if is_collectable_position:\n          target_path = path_actions # Shortest path to this position found.\n          break # Terminate BFS as the goal is reached.\n\n      # Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n\n      # 1. Try Move Forward:\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change the agent's facing direction.\n\n      # Check if the next position is within grid bounds and if this (position, direction) state\n      # has not been visited before.\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT and\n          (next_pos, next_dir) not in visited):\n          \n          is_walkable = True\n          # A cell is considered walkable if it does not contain any non-grabbable entity.\n          # We check the original grid's state for this.\n          for kind_idx in non_walkable_kinds_indices:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          # Additionally, the agent cannot walk onto the primitive itself to collect it;\n          # collection happens from an adjacent cell.\n          if initial_grid[next_r, next_c, primitive_id] > 0:\n              is_walkable = False\n\n          if is_walkable:\n              visited.add((next_pos, next_dir)) # Mark new state as visited.\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION])) # Add to queue for exploration.\n\n      # 2. Try Turn Left:\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning changes only direction, not position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # 3. Try Turn Right:\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning changes only direction, not position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # After BFS completes:\n  # If a path to a collectable position was found, append the final USE action\n  # to actually perform the collection.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T00:40:01.293849", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid # The grid layout at the start of the collection task\n  initial_pos = current_state.pos   # Agent's starting position (row, col)\n  initial_dir = current_state.dir   # Agent's starting direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive\n  primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = initial_grid.shape # Grid dimensions\n\n  # Get the action mappings from the environment\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # 'UP' in action_specs implies moving forward\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction\n  # This helps calculate the new position after a 'MOVE_FORWARD' action.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Right: +1 to column\n      1: (-1, 0),  # Up: -1 to row\n      2: (0, -1),  # Left: -1 to column\n      3: (1, 0)    # Down: +1 to row\n  }\n\n  # Maps for updating the agent's direction when turning left/right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # R -> U -> L -> D -> R\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # R -> D -> L -> U -> R\n\n  # Identify non-walkable entities (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # Optimization: If the primitive is already in the 3x3 neighborhood of the agent,\n  # no pathfinding is needed; just use the item.\n  if current_state.next_to(primitive_id):\n      return [USE_ACTION]\n\n  # Initialize Breadth-First Search (BFS)\n  # Queue stores ( (current_position_tuple, current_direction_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (position_tuple, direction_int) to avoid redundant computations and cycles\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the sequence of actions to reach a collectable position\n\n  # BFS Loop\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # Check if the current position is a \"goal\" state for collection.\n      # A goal state means the primitive exists within the 3x3 neighborhood\n      # of the agent's current (r, c) on the *initial grid*.\n      is_collectable_position = False\n      for dr_check in [-1, 0, 1]:\n          for dc_check in [-1, 0, 1]:\n              check_r, check_c = r + dr_check, c + dc_check\n              # Ensure the cell being checked is within grid bounds\n              if (0 <= check_r < WIDTH and 0 <= check_c < HEIGHT and\n                  initial_grid[check_r, check_c, primitive_id] > 0):\n                  is_collectable_position = True\n                  break # Found the primitive in the neighborhood\n          if is_collectable_position:\n              break\n\n      if is_collectable_position:\n          target_path = path_actions # Path to reach this collectable position\n          break # Shortest path found, terminate BFS\n\n      # Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right\n\n      # 1. Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir_move = current_dir # Moving forward does not change facing direction\n\n      # Check if the next position is within bounds and has not been visited with this direction\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT and\n          (next_pos, next_dir_move) not in visited):\n          \n          is_walkable = True\n          # A cell is considered walkable if it does not contain any non-grabbable entity.\n          # Also, the agent cannot walk *onto* the primitive itself; it needs to be adjacent.\n          for kind_idx in non_walkable_kinds_indices:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          if initial_grid[next_r, next_c, primitive_id] > 0: # Cannot walk on the primitive itself\n              is_walkable = False\n\n          if is_walkable:\n              visited.add((next_pos, next_dir_move))\n              queue.append(((next_pos, next_dir_move), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # 2. Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning changes direction but not position\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # 3. Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning changes direction but not position\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path to a collectable position was found, append the USE action to perform the collection\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T00:40:41.220809", "function_name": "collect", "function_body": "", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-08-01T00:40:42.558407", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  \n  # 1. Get primitive index\n  try:\n    prim_idx = cookbook.index.index(primitive)\n  except ValueError: # If primitive string is not known in the cookbook's index\n    return []\n\n  # 2. Early Exit: Check if the primitive is already in the agent's inventory\n  if state.inventory[prim_idx] > 0:\n      return []\n\n  # 3. Define action mappings and related constants\n  ACTION_MAP = env.action_specs()\n  UP, DOWN, LEFT, RIGHT, USE = ACTION_MAP[\"UP\"], ACTION_MAP[\"DOWN\"], ACTION_MAP[\"LEFT\"], ACTION_MAP[\"RIGHT\"], ACTION_MAP[\"USE\"]\n\n  # Map movement actions to their (dx, dy) deltas (row change, column change)\n  # CraftWorld convention: X (rows) increase downwards, Y (columns) increase rightwards\n  DELTAS_BY_ACTION = {\n      UP: (-1, 0),    # Move up: decrease row (x-1)\n      DOWN: (1, 0),    # Move down: increase row (x+1)\n      LEFT: (0, -1),   # Move left: decrease column (y-1)\n      RIGHT: (0, 1)    # Move right: increase column (y+1)\n  }\n  \n  # Map agent's internal direction (0:N, 1:S, 2:W, 3:E) to (dx, dy) deltas for the cell in front\n  # From CraftState: dir 0 (North/UP), 1 (South/DOWN), 2 (West/LEFT), 3 (East/RIGHT)\n  DIR_TO_DELTA = {\n      0: (-1, 0), # North (UP)\n      1: (1, 0),  # South (DOWN)\n      2: (0, -1), # West (LEFT)\n      3: (0, 1)   # East (RIGHT)\n  }\n  \n  # Map (dx, dy) deltas to the corresponding agent direction index\n  DELTA_TO_DIR = {v: k for k, v in DIR_TO_DELTA.items()}\n\n  # Grid dimensions\n  WIDTH, HEIGHT, _ = state.grid.shape\n\n  # 4. Immediate grab if standing directly on a grabbable item\n  if prim_idx in env.world.grabbable_indices:\n      curr_x, curr_y = state.pos\n      if state.grid[curr_x, curr_y, prim_idx] > 0:\n          return [USE]\n\n  # 5. Identify impassable terrain types for pathfinding\n  impassable_kind_ids = set()\n  water_idx = None\n  bridge_idx = None\n\n  # Add BOUNDARY as an absolute impassable obstacle\n  try:\n    impassable_kind_ids.add(cookbook.index.index(\"BOUNDARY\"))\n  except ValueError:\n    pass # BOUNDARY might not exist in all worlds/cookbooks\n\n  # Get indices for WATER and BRIDGE to handle water crossings\n  try:\n    water_idx = cookbook.index.index(\"WATER\")\n  except ValueError:\n    pass\n  try:\n    bridge_idx = cookbook.index.index(\"BRIDGE\")\n  except ValueError:\n    pass\n\n  # 6. BFS setup for pathfinding\n  start_pos = state.pos\n  start_dir = state.dir # Agent's current direction\n  \n  # State in BFS: (x, y, direction)\n  start_bfs_state = (start_pos[0], start_pos[1], start_dir)\n  \n  # Queue stores (x, y, direction) states to explore\n  q = collections.deque([(start_bfs_state)])\n  \n  # Visited set stores (x, y, direction) to avoid redundant exploration and cycles\n  visited = {start_bfs_state}\n\n  # Parent dictionary to reconstruct path: (child_state) -> (parent_state, action_taken_to_reach_child)\n  parents = {}\n  \n  # This will store the (x, y, dir) state from which the primitive can be 'used' or 'collected'\n  found_target_bfs_state = None \n\n  # BFS loop\n  while q:\n    curr_x, curr_y, curr_dir = q.popleft()\n    curr_bfs_state = (curr_x, curr_y, curr_dir)\n\n    # Check if the primitive is directly in front of the agent from the current (position, direction)\n    # This is the target condition: agent is positioned to interact with (e.g., USE) the primitive.\n    front_dx, front_dy = DIR_TO_DELTA[curr_dir]\n    prim_x, prim_y = curr_x + front_dx, curr_y + front_dy\n\n    # Check bounds for the cell directly in front\n    if 0 <= prim_x < WIDTH and 0 <= prim_y < HEIGHT:\n      # If the primitive is present in the cell in front\n      if state.grid[prim_x, prim_y, prim_idx] > 0:\n        found_target_bfs_state = curr_bfs_state\n        break # Found a path to a state from which we can collect, exit BFS\n\n    # Explore neighbors by considering all possible movement actions (UP, DOWN, LEFT, RIGHT)\n    for action, (dx, dy) in DELTAS_BY_ACTION.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_dir = DELTA_TO_DIR[(dx, dy)] # Agent's new direction after this movement action\n      next_bfs_state = (next_x, next_y, next_dir)\n\n      # Check bounds for the next cell\n      if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n        continue\n\n      # Check for impassable terrain in the next cell\n      is_impassable = False\n      # Get indices of all kinds present in the proposed next cell\n      kinds_in_next_cell = np.where(state.grid[next_x, next_y] > 0)[0] \n      \n      for kind_id_in_cell in kinds_in_next_cell:\n          if kind_id_in_cell in impassable_kind_ids:\n              is_impassable = True\n              break\n          # Special handling for WATER: only impassable if no BRIDGE in inventory\n          if water_idx is not None and kind_id_in_cell == water_idx:\n              if bridge_idx is None or state.inventory[bridge_idx] == 0:\n                  is_impassable = True\n                  break\n      \n      if is_impassable:\n        continue # Cannot move to this cell\n\n      # Check if this (position, direction) state has already been visited\n      if next_bfs_state not in visited:\n        visited.add(next_bfs_state)\n        parents[next_bfs_state] = (curr_bfs_state, action) # Store parent state and the action taken to reach this state\n        q.append(next_bfs_state)\n\n  # 7. Path Reconstruction\n  final_actions = []\n  if found_target_bfs_state:\n    curr = found_target_bfs_state\n    # Backtrack from target state to start state using the parents dictionary\n    while curr != start_bfs_state:\n      parent_state, action = parents[curr]\n      final_actions.append(action)\n      curr = parent_state\n    \n    final_actions.reverse() # Actions are currently in reverse order, reverse them to get correct sequence\n\n    # If the primitive is grabbable, append the USE action after reaching the target position\n    if prim_idx in env.world.grabbable_indices:\n      final_actions.append(USE)\n  \n  return final_actions", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T00:41:30.915588", "function_name": "collect", "function_body": "  # Get primitive index using .get, which returns None if not found\n  primitive_idx = env.world.cookbook.index.get(primitive)\n  if primitive_idx is None:\n    return [] # Primitive name not recognized by the cookbook or not a valid target\n\n  actions_map = env.action_specs()\n  UP, DOWN, LEFT, RIGHT, USE = (actions_map['UP'], actions_map['DOWN'],\n                                actions_map['LEFT'], actions_map['RIGHT'],\n                                actions_map['USE'])\n\n  # Map movement actions to (dx, dy) and the agent's new facing direction (ndir)\n  # (dx_move, dy_move) is the relative change in agent's position\n  # ndir is the agent's direction AFTER making this move (0:Right, 1:Up, 2:Left, 3:Down)\n  action_to_state_change = {\n      UP: (0, -1, 1),    # Move up: y decreases, new dir is 1 (Up)\n      DOWN: (0, 1, 3),   # Move down: y increases, new dir is 3 (Down)\n      LEFT: (-1, 0, 2),  # Move left: x decreases, new dir is 2 (Left)\n      RIGHT: (1, 0, 0)   # Move right: x increases, new dir is 0 (Right)\n  }\n\n  # Get current state information\n  current_state = env._current_state\n  grid = current_state.grid\n  start_pos_x, start_pos_y = current_state.pos\n  start_dir = current_state.dir # Agent's initial facing direction\n  GRID_WIDTH, GRID_HEIGHT, _ = grid.shape\n\n  # Identify special indices for game elements, using .get for robustness\n  # water_index and stone_index are direct attributes on CraftWorld, so they are guaranteed to exist\n  water_idx = env.world.water_index\n  stone_idx = env.world.stone_index\n  \n  # Use .get for other potential adjacent-use primitives that might not be in every cookbook\n  boundary_idx = env.world.cookbook.index.get('boundary')\n  grass_idx = env.world.cookbook.index.get('grass')\n  rock_idx = env.world.cookbook.index.get('rock')\n\n  grabbable_indices = env.world.grabbable_indices # Items like WOOD, IRON, GOLD, GEM, PLANK, STICK, etc.\n  workshop_indices = env.world.workshop_indices # WORKSHOP0, WORKSHOP1, WORKSHOP2\n\n  # Categorize the primitive based on how the 'USE' action interacts with it.\n  # This follows the priority of the CraftState.step's USE action logic:\n  # 1. On-top pickup: agent stands on the item and uses USE (direction does not matter).\n  # 2. Adjacent-facing use: agent is adjacent to the item and faces it, then uses USE.\n\n  # Primitives collected by being adjacent and facing them (e.g., WATER, STONE, GRASS, ROCK, WORKSHOPS)\n  is_adjacent_use = (\n      primitive_idx == water_idx or\n      primitive_idx == stone_idx or\n      (grass_idx is not None and primitive_idx == grass_idx) or\n      (rock_idx is not None and primitive_idx == rock_idx) or\n      primitive_idx in workshop_indices\n  )\n  \n  # Primitives collected by standing on them (other grabbable items not covered by adjacent_use)\n  is_on_top_pickup = (not is_adjacent_use and primitive_idx in grabbable_indices)\n\n  if not (is_on_top_pickup or is_adjacent_use):\n      return [] # Primitive is not collectible by these defined methods (e.g., 'boundary' or an unknown type)\n  \n  # Ensure the primitive is not the boundary itself, as it's not truly 'collectible'\n  # This check also ensures boundary_idx is valid before comparison\n  if boundary_idx is not None and primitive_idx == boundary_idx:\n      return []\n\n  # Find all grid locations containing the primitive\n  primitive_locations = [] # Stores (x, y) tuples of primitive's location\n  for x in range(GRID_WIDTH):\n      for y in range(GRID_HEIGHT):\n          if grid[x, y, primitive_idx] > 0:\n              primitive_locations.append((x, y))\n\n  if not primitive_locations:\n      return [] # Primitive not found on the map\n\n  # Determine the target agent states (position and direction) for BFS.\n  # A state is (ax, ay, adir) where (ax, ay) is agent's position, adir is agent's direction.\n  bfs_target_agent_states = set()\n\n  if is_on_top_pickup:\n      # For items picked up by standing on them, agent must be on (px,py).\n      # Direction does not matter for the 'USE' action when on the item.\n      # We add all possible directions as target states to allow maximum flexibility for BFS.\n      for px, py in primitive_locations:\n          for d in range(4): # 0, 1, 2, 3 for Right, Up, Left, Down\n              bfs_target_agent_states.add((px, py, d))\n  elif is_adjacent_use:\n      # For items collected by being adjacent and facing them, agent must be at (ax,ay) facing (px,py).\n      for px, py in primitive_locations:\n          # Check 4 cardinal adjacent cells for the agent's potential position\n          for dx_adj, dy_adj in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # Left, Right, Up, Down relative to primitive\n              ax, ay = px + dx_adj, py + dy_adj # Agent's potential position\n\n              # Ensure agent's potential position is within grid bounds\n              if not (0 <= ax < GRID_WIDTH and 0 <= ay < GRID_HEIGHT):\n                  continue\n              \n              # Ensure agent's potential position is not a boundary cell\n              if boundary_idx is not None and grid[ax, ay, boundary_idx] > 0:\n                  continue\n\n              # Determine the required direction for the agent to face the primitive (px, py)\n              # The relative position of the primitive from the agent's perspective\n              rel_x, rel_y = px - ax, py - ay\n              required_dir = -1 # Placeholder for the direction agent must face\n\n              if rel_x == 1 and rel_y == 0:  # Primitive is to the Right of agent\n                  required_dir = 0 # Agent must face Right\n              elif rel_x == -1 and rel_y == 0: # Primitive is to the Left of agent\n                  required_dir = 2 # Agent must face Left\n              elif rel_x == 0 and rel_y == -1: # Primitive is Up from agent\n                  required_dir = 1 # Agent must face Up\n              elif rel_x == 0 and rel_y == 1:  # Primitive is Down from agent\n                  required_dir = 3 # Agent must face Down\n              \n              if required_dir != -1: # If a valid facing direction was determined\n                  bfs_target_agent_states.add((ax, ay, required_dir))\n  \n  if not bfs_target_agent_states:\n      return [] # No valid target states could be determined (e.g., primitive is isolated or unreachable)\n\n  # Perform Breadth-First Search (BFS) to find the shortest path\n  # Queue stores (current_x, current_y, current_dir, path_taken_so_far)\n  q = collections.deque([(start_pos_x, start_pos_y, start_dir, [])]) \n  # Visited set stores (x, y, dir) tuples to avoid revisiting states and infinite loops\n  visited = {(start_pos_x, start_pos_y, start_dir)}\n\n  while q:\n      cx, cy, cdir, path = q.popleft()\n\n      # Check if the current agent state (position and direction) is one of the target states\n      if (cx, cy, cdir) in bfs_target_agent_states:\n          return path + [USE] # Add the 'USE' action to the path and return\n\n      # Explore neighboring states by performing movement actions\n      for action_val, (dx_move, dy_move, ndir) in action_to_state_change.items():\n          nx, ny = cx + dx_move, cy + dy_move # New position after action\n\n          # Check if the new cell is within grid boundaries\n          if not (0 <= nx < GRID_WIDTH and 0 <= ny < GRID_HEIGHT):\n              continue\n          \n          # Check if the new cell is blocked by a 'boundary'\n          if boundary_idx is not None and grid[nx, ny, boundary_idx] > 0:\n              continue\n\n          # Add the new state to the queue if it has not been visited before\n          if (nx, ny, ndir) not in visited:\n              visited.add((nx, ny, ndir))\n              q.append((nx, ny, ndir, path + [action_val]))\n\n  return [] # No path found to the primitive from the starting position", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-08-01T00:41:32.159687", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\"\"\"\n  primitive_idx = env.world.cookbook.index.index(primitive)\n  actions_map = env.action_specs()\n  UP, DOWN, LEFT, RIGHT, USE = (actions_map['UP'], actions_map['DOWN'],\n                                actions_map['LEFT'], actions_map['RIGHT'],\n                                actions_map['USE'])\n\n  # Map movement actions to (dx, dy) and the agent's new facing direction (ndir)\n  # (dx_move, dy_move) is the relative change in agent's position\n  # ndir is the agent's direction AFTER making this move (0:Right, 1:Up, 2:Left, 3:Down)\n  action_to_state_change = {\n      UP: (0, -1, 1),    # Move up: y decreases, new dir is 1 (Up)\n      DOWN: (0, 1, 3),   # Move down: y increases, new dir is 3 (Down)\n      LEFT: (-1, 0, 2),  # Move left: x decreases, new dir is 2 (Left)\n      RIGHT: (1, 0, 0)   # Move right: x increases, new dir is 0 (Right)\n  }\n\n  # Get current state information\n  current_state = env._current_state\n  grid = current_state.grid\n  start_pos_x, start_pos_y = current_state.pos\n  start_dir = current_state.dir # Agent's initial facing direction\n  GRID_WIDTH, GRID_HEIGHT, _ = grid.shape\n\n  # Identify special indices for game elements\n  boundary_idx = env.world.cookbook.index.index('boundary')\n  water_idx = env.world.water_index\n  stone_idx = env.world.stone_index\n  \n  # Assuming grass and rock also have indices, as they are part of common primitives\n  try:\n    grass_idx = env.world.cookbook.index.index('grass')\n  except ValueError: # Handle cases where 'grass' might not be in the cookbook's index\n    grass_idx = -1 # Assign an invalid index\n  try:\n    rock_idx = env.world.cookbook.index.index('rock')\n  except ValueError: # Handle cases where 'rock' might not be in the cookbook's index\n    rock_idx = -1 # Assign an invalid index\n\n  grabbable_indices = env.world.grabbable_indices # Items like WOOD, IRON, GOLD, GEM, PLANK, STICK, etc.\n  workshop_indices = env.world.workshop_indices # WORKSHOP0, WORKSHOP1, WORKSHOP2\n\n  # Categorize the primitive based on how the 'USE' action interacts with it.\n  # This follows the priority of the CraftState.step's USE action logic:\n  # 1. On-top pickup: agent stands on the item and uses USE (direction does not matter).\n  # 2. Adjacent-facing use: agent is adjacent to the item and faces it, then uses USE.\n\n  # Primitives collected by being adjacent and facing them (e.g., WATER, STONE, GRASS, ROCK, WORKSHOPS)\n  is_adjacent_use = (primitive_idx == water_idx or\n                     primitive_idx == stone_idx or\n                     primitive_idx == grass_idx or\n                     primitive_idx == rock_idx or\n                     primitive_idx in workshop_indices)\n  \n  # Primitives collected by standing on them (other grabbable items not covered by adjacent_use)\n  is_on_top_pickup = (not is_adjacent_use and primitive_idx in grabbable_indices)\n\n  if not (is_on_top_pickup or is_adjacent_use):\n      return [] # Primitive is not collectible by these defined methods (e.g., 'boundary' or an unknown type)\n  \n  # Ensure the primitive is not the boundary itself, as it's not truly 'collectible'\n  if primitive_idx == boundary_idx:\n      return []\n\n  # Find all grid locations containing the primitive\n  primitive_locations = [] # Stores (x, y) tuples of primitive's location\n  for x in range(GRID_WIDTH):\n      for y in range(GRID_HEIGHT):\n          if grid[x, y, primitive_idx] > 0:\n              primitive_locations.append((x, y))\n\n  if not primitive_locations:\n      return [] # Primitive not found on the map\n\n  # Determine the target agent states (position and direction) for BFS.\n  # A state is (ax, ay, adir) where (ax, ay) is agent's position, adir is agent's direction.\n  bfs_target_agent_states = set()\n\n  if is_on_top_pickup:\n      # For items picked up by standing on them, agent must be on (px,py).\n      # Direction does not matter for the 'USE' action when on the item.\n      # We add all possible directions as target states to allow maximum flexibility for BFS.\n      for px, py in primitive_locations:\n          for d in range(4): # 0, 1, 2, 3 for Right, Up, Left, Down\n              bfs_target_agent_states.add((px, py, d))\n  elif is_adjacent_use:\n      # For items collected by being adjacent and facing them, agent must be at (ax,ay) facing (px,py).\n      for px, py in primitive_locations:\n          # Check 4 cardinal adjacent cells for the agent's potential position\n          for dx_adj, dy_adj in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # Left, Right, Up, Down relative to primitive\n              ax, ay = px + dx_adj, py + dy_adj # Agent's potential position\n\n              # Ensure agent's potential position is within grid bounds\n              if not (0 <= ax < GRID_WIDTH and 0 <= ay < GRID_HEIGHT):\n                  continue\n              \n              # Ensure agent's potential position is not a boundary cell\n              if grid[ax, ay, boundary_idx] > 0:\n                  continue\n\n              # Determine the required direction for the agent to face the primitive (px, py)\n              # The relative position of the primitive from the agent's perspective\n              rel_x, rel_y = px - ax, py - ay\n              required_dir = -1 # Placeholder for the direction agent must face\n\n              if rel_x == 1 and rel_y == 0:  # Primitive is to the Right of agent\n                  required_dir = 0 # Agent must face Right\n              elif rel_x == -1 and rel_y == 0: # Primitive is to the Left of agent\n                  required_dir = 2 # Agent must face Left\n              elif rel_x == 0 and rel_y == -1: # Primitive is Up from agent\n                  required_dir = 1 # Agent must face Up\n              elif rel_x == 0 and rel_y == 1:  # Primitive is Down from agent\n                  required_dir = 3 # Agent must face Down\n              \n              if required_dir != -1: # If a valid facing direction was determined\n                  bfs_target_agent_states.add((ax, ay, required_dir))\n  \n  if not bfs_target_agent_states:\n      return [] # No valid target states could be determined (e.g., primitive is isolated or unreachable)\n\n  # Perform Breadth-First Search (BFS) to find the shortest path\n  # Queue stores (current_x, current_y, current_dir, path_taken_so_far)\n  q = collections.deque([(start_pos_x, start_pos_y, start_dir, [])]) \n  # Visited set stores (x, y, dir) tuples to avoid revisiting states and infinite loops\n  visited = {(start_pos_x, start_pos_y, start_dir)}\n\n  while q:\n      cx, cy, cdir, path = q.popleft()\n\n      # Check if the current agent state (position and direction) is one of the target states\n      if (cx, cy, cdir) in bfs_target_agent_states:\n          return path + [USE] # Add the 'USE' action to the path and return\n\n      # Explore neighboring states by performing movement actions\n      for action_val, (dx_move, dy_move, ndir) in action_to_state_change.items():\n          nx, ny = cx + dx_move, cy + dy_move # New position after action\n\n          # Check if the new cell is within grid boundaries\n          if not (0 <= nx < GRID_WIDTH and 0 <= ny < GRID_HEIGHT):\n              continue\n          \n          # Check if the new cell is blocked by a 'boundary'\n          if grid[nx, ny, boundary_idx] > 0:\n              continue\n\n          # Add the new state to the queue if it has not been visited before\n          if (nx, ny, ndir) not in visited:\n              visited.add((nx, ny, ndir))\n              q.append((nx, ny, ndir, path + [action_val]))\n\n  return [] # No path found to the primitive from the starting position", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T00:42:46.277573", "function_name": "collect", "function_body": "  # Get action integer values from the environment's action_specs\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Get relevant IDs from the environment's world and cookbook\n  cookbook = env.world.cookbook\n  try:\n      primitive_id = cookbook.index.index(primitive)\n  except KeyError:\n      # If the primitive name is not recognized (e.g., not in cookbook),\n      # return an empty list of actions as it cannot be collected.\n      return []\n\n  # Get the current state information\n  current_state = env._current_state\n  grid = current_state.grid\n  start_pos = current_state.pos\n  start_dir = current_state.dir # Agent's current facing direction\n\n  # Grid dimensions (WIDTH is first dimension, HEIGHT is second)\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Define IDs of entities that are considered strictly impassable for agent movement.\n  # In CraftWorld, 'boundary' and 'water' are typically impassable. 'stone' is also\n  # often treated as a solid block that cannot be walked onto, only mined from adjacent.\n  impassable_terrain_ids = {\n      cookbook.index.index(\"boundary\"),\n      env.world.water_index,\n      env.world.stone_index # Assuming stone blocks movement too\n  }\n\n  # Helper function to check if a position (r, c) is valid for the agent to stand on.\n  # This means it must be within grid bounds and not contain any impassable terrain.\n  def is_valid_walk_pos(r, c):\n    # Check if the position is within the grid boundaries.\n    if not (0 <= r < WIDTH and 0 <= c < HEIGHT):\n      return False\n    # Check if the cell at (r, c) contains any of the defined impassable terrain types.\n    # The grid stores 1 for presence, 0 for absence of a specific kind.\n    for impassable_id in impassable_terrain_ids:\n        if grid[r, c, impassable_id] > 0:\n            return False # This cell contains an impassable block\n    return True\n\n  # Determine if the primitive itself is grabbable (can be picked up by standing on its cell and using USE).\n  # This dictates whether we need to find a path to the primitive's cell or an adjacent cell.\n  is_grabbable = primitive_id in env.world.grabbable_indices\n\n  # Pre-compute all locations on the grid where the target primitive exists.\n  primitive_locations = [] # List of (row, col) tuples\n  for r in range(WIDTH):\n      for c in range(HEIGHT):\n          if grid[r, c, primitive_id] > 0:\n              primitive_locations.append((r, c))\n\n  # If there are no instances of the primitive found on the grid, it's impossible to collect.\n  if not primitive_locations:\n      return []\n\n  # Define possible movement deltas (dr, dc) and their corresponding action IDs.\n  # These also imply the new agent direction after the move.\n  move_deltas = {\n      UP: (-1, 0), # Moving UP changes row by -1\n      DOWN: (1, 0), # Moving DOWN changes row by +1\n      LEFT: (0, -1), # Moving LEFT changes col by -1\n      RIGHT: (0, 1) # Moving RIGHT changes col by +1\n  }\n\n  # Map action IDs to the resulting agent direction ID after performing that move.\n  # DMLab-style directions: 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n  action_to_direction_map = {\n      UP: 0,\n      RIGHT: 1,\n      DOWN: 2,\n      LEFT: 3,\n  }\n\n  # Map direction ID to the (dr, dc) delta that points to the cell *in front of* the agent.\n  # This is used for non-grabbable items where the agent must face the item.\n  dir_to_look_delta = {\n      0: (-1, 0), # UP\n      1: (0, 1),  # RIGHT\n      2: (1, 0),  # DOWN\n      3: (0, -1)  # LEFT\n  }\n\n\n  # Pre-compute all valid (agent_pos_r, agent_pos_c, agent_direction_id) states\n  # from which a single 'USE' action would successfully collect the primitive.\n  target_use_states = set()\n  for pr, pc in primitive_locations: # Iterate through each primitive instance location\n      if is_grabbable:\n          # If the item is grabbable, the agent needs to stand on the same cell (pr, pc).\n          # The agent's direction does not typically matter for picking up grabbable items.\n          if is_valid_walk_pos(pr, pc): # Ensure agent can actually walk onto this cell.\n              # Add all 4 possible agent directions, as any direction works when standing on a grabbable item.\n              for d_id in action_to_direction_map.values():\n                  target_use_states.add((pr, pc, d_id))\n      else:\n          # If the item is non-grabbable (e.g., stone, workshop), the agent must be\n          # adjacent to it and facing it to 'USE' it.\n          for facing_dir_id, (dr_look, dc_look) in dir_to_look_delta.items():\n              # Calculate the required agent position (ar, ac) such that if the agent\n              # is at (ar, ac) and faces `facing_dir_id`, it will be looking at (pr, pc).\n              # (ar + dr_look, ac + dc_look) = (pr, pc)  => (ar, ac) = (pr - dr_look, pc - dc_look)\n              ar, ac = pr - dr_look, pc - dc_look\n              \n              # Check if this calculated agent position is valid to stand on.\n              if is_valid_walk_pos(ar, ac):\n                  target_use_states.add((ar, ac, facing_dir_id))\n\n  # Initialize BFS: State is (current_position (r,c), current_direction (int), path_of_actions (list)).\n  queue = collections.deque([(start_pos, start_dir, [])])\n  # Keep track of visited (position, direction) pairs to prevent cycles and find shortest path.\n  visited = {(start_pos, start_dir)}\n\n  while queue:\n    (r, c), current_dir, path = queue.popleft()\n\n    # --- Goal Check ---\n    # If the current agent state (position and direction) is one from which 'USE' would succeed,\n    # we have found the shortest path to collect the primitive.\n    if (r, c, current_dir) in target_use_states:\n        return path + [USE] # Append the final USE action and return the complete path.\n\n    # --- Explore Neighbors (Movement Actions) ---\n    # For each possible movement action (UP, DOWN, LEFT, RIGHT).\n    for action, (dr, dc) in move_deltas.items():\n      next_r, next_c = r + dr, c + dc\n      next_pos = (next_r, next_c)\n      \n      # When the agent moves, its facing direction updates to the direction of movement.\n      next_dir = action_to_direction_map[action] \n\n      # Only explore this new state if the next position is walkable and this\n      # (position, direction) state has not been visited before.\n      if is_valid_walk_pos(next_r, next_c) and (next_pos, next_dir) not in visited:\n        visited.add((next_pos, next_dir))\n        # Add the new state to the queue, appending the current action to the path.\n        queue.append((next_pos, next_dir, path + [action]))\n\n  # If the BFS queue becomes empty and no path to a collectable primitive was found,\n  # it means the primitive is unreachable or doesn't exist in a collectable state.\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T00:42:47.503683", "function_name": "collect", "function_body": "  actions = []\n    \n  # Get the action mapping (e.g., 'UP' -> 1, 'USE' -> 4)\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Get relevant IDs from the environment's world and cookbook\n  cookbook = env.world.cookbook\n  try:\n      primitive_id = cookbook.index.index(primitive)\n  except KeyError:\n      # If the primitive name is not recognized, return an empty list of actions.\n      return []\n\n  # Get the current state information\n  current_state = env._current_state\n  grid = current_state.grid\n  start_pos = current_state.pos\n  start_dir = current_state.dir # Agent's current facing direction\n\n  # Grid dimensions (WIDTH is first dimension, HEIGHT is second)\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Identify impassable terrain types and special traversable types\n  boundary_id = cookbook.index.index(\"boundary\")\n  water_id = env.world.water_index\n  \n  # Agent direction mapping (DMLab-style: 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n  action_to_direction_map = {\n      UP: 0,\n      RIGHT: 1,\n      DOWN: 2,\n      LEFT: 3,\n  }\n\n  # Delta from agent's position to the cell *in front* of the agent, based on agent's direction\n  dir_to_delta = {\n      0: (-1, 0), # UP: (r-1, c)\n      1: (0, 1),  # RIGHT: (r, c+1)\n      2: (1, 0),  # DOWN: (r+1, c)\n      3: (0, -1)  # LEFT: (r, c-1)\n  }\n\n  # Movement deltas for the agent's position based on action\n  move_deltas = {\n      UP: (-1, 0),\n      DOWN: (1, 0),\n      LEFT: (0, -1),\n      RIGHT: (0, 1)\n  }\n\n  # Helper function to check if a position is traversable by the agent\n  def is_traversable_for_agent(r, c, current_grid):\n    # 1. Check if position is within grid bounds\n    if not (0 <= r < WIDTH and 0 <= c < HEIGHT):\n      return False\n    \n    # 2. Check content of the cell at (r,c)\n    # Get all kinds present at (r,c) (indices where value is 1)\n    kinds_at_cell = np.where(current_grid[r, c] == 1)[0]\n\n    # If the cell is effectively empty (contains only 'empty' or no explicit items), it's traversable.\n    # Assuming index 0 is 'empty' or no items means traversable.\n    if len(kinds_at_cell) == 0 or (len(kinds_at_cell) == 1 and kinds_at_cell[0] == cookbook.index.index(\"empty\")): # Assuming \"empty\" can be a kind\n        return True\n    \n    # Iterate through all items present in the cell\n    for kind_in_cell_id in kinds_at_cell:\n        # Boundary and water are always impassable for walking onto\n        if kind_in_cell_id == boundary_id or kind_in_cell_id == water_id:\n            return False\n        \n        # Other non-grabbable items (e.g., stone, wood blocks in some setups) are generally impassable\n        # UNLESS they are workshops (which are designed to be traversable).\n        if kind_in_cell_id in env.world.non_grabbable_indices and \\\n           kind_in_cell_id not in env.world.workshop_indices:\n            # If it's a non-grabbable obstacle and not a workshop, agent cannot walk onto it.\n            return False\n            \n    return True # If none of the above conditions returned False, the cell is traversable.\n\n\n  # Pre-compute all primitive locations on the grid\n  primitive_locations = [] # List of (r, c) tuples where the primitive exists\n  for r in range(WIDTH):\n      for c in range(HEIGHT):\n          if grid[r, c, primitive_id] > 0:\n              primitive_locations.append((r, c))\n\n  # If no instance of the primitive exists on the grid, no path is possible\n  if not primitive_locations:\n      return []\n\n  # Determine if the primitive is grabbable (can be picked up by standing on it and USE)\n  is_grabbable = primitive_id in env.world.grabbable_indices\n\n  # Pre-compute all target (position, direction) states from which 'USE' will succeed.\n  # This set will contain (row, col, direction_id) tuples for the agent's state.\n  target_use_states = set()\n  for pr, pc in primitive_locations:\n      if is_grabbable:\n          # For grabbable items, the agent must be ON (pr, pc). Direction doesn't matter for USE.\n          # Add (pr, pc, any_direction) as a valid target state, provided the agent can stand on (pr, pc).\n          if is_traversable_for_agent(pr, pc, grid):\n              for d_id in action_to_direction_map.values(): # Iterate over all 4 possible agent directions (0,1,2,3)\n                  target_use_states.add((pr, pc, d_id))\n      else:\n          # For non-grabbable items (e.g., workshops, or a mineable stone block),\n          # the agent must be adjacent to (pr, pc) and facing it.\n          # Iterate through the 4 possible neighboring cells where the agent could stand\n          for facing_dir_id, (dr_prim_rel, dc_prim_rel) in dir_to_delta.items():\n              # (dr_prim_rel, dc_prim_rel) is the delta from the agent's position to the primitive's position.\n              # So, if primitive is at (pr, pc), the agent's position (ar, ac) is (pr - dr_prim_rel, pc - dc_prim_rel).\n              ar, ac = pr - dr_prim_rel, pc - dc_prim_rel\n              \n              # Check if this potential agent position is valid to stand on\n              if is_traversable_for_agent(ar, ac, grid):\n                  # If the agent is at (ar, ac) and faces `facing_dir_id`, it will be looking at (pr, pc).\n                  target_use_states.add((ar, ac, facing_dir_id))\n\n  # BFS State: (current_position (r,c), current_direction (int), path_of_actions (list))\n  queue = collections.deque([(start_pos, start_dir, [])])\n  # Visited set tracks (position, direction) pairs to avoid cycles and redundant paths\n  visited = {(start_pos, start_dir)}\n\n  while queue:\n    (r, c), current_dir, path = queue.popleft()\n\n    # --- Goal Check ---\n    # Check if the current (position, direction) state is one from which 'USE' will succeed.\n    if (r, c, current_dir) in target_use_states:\n        return path + [USE]\n\n    # --- Explore Neighbors (Movement Actions) ---\n    for action, (dr, dc) in move_deltas.items():\n      next_r, next_c = r + dr, c + dc\n      next_pos = (next_r, next_c)\n      \n      # When the agent moves, its direction changes to the direction of movement.\n      next_dir = action_to_direction_map[action] \n\n      # Check if the next position is traversable and this specific (position, direction) state\n      # has not been visited yet to ensure shortest path and avoid infinite loops.\n      if is_traversable_for_agent(next_r, next_c, grid) and (next_pos, next_dir) not in visited:\n        visited.add((next_pos, next_dir))\n        queue.append((next_pos, next_dir, path + [action]))\n\n  # If the queue becomes empty and no path to a primitive was found\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T00:43:49.674853", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  DOWN_ACTION = action_map['DOWN']\n  UP_ACTION = action_map['UP']\n  LEFT_ACTION = action_map['LEFT']\n  RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  current_state = env._current_state\n  start_pos = current_state.pos\n  start_dir = current_state.dir # Agent's initial facing direction (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  world = env.world\n  primitive_idx = world.cookbook.index[primitive]\n\n  # Only grabbable items can be \"collected\" into inventory via the USE action\n  if primitive_idx not in world.grabbable_indices:\n      return []\n\n  # Define movement deltas and corresponding resulting agent directions\n  # Directions: 0: UP, 1: RIGHT, 2: DOWN, 3: LEFT\n  move_deltas = {\n      UP_ACTION: (0, -1),\n      DOWN_ACTION: (0, 1),\n      LEFT_ACTION: (-1, 0),\n      RIGHT_ACTION: (1, 0)\n  }\n\n  # Mapping from action ID to the new direction the agent will face after that action\n  action_to_new_dir = {\n      UP_ACTION: 0,    # Agent faces UP (North)\n      RIGHT_ACTION: 1, # Agent faces RIGHT (East)\n      DOWN_ACTION: 2,  # Agent faces DOWN (South)\n      LEFT_ACTION: 3   # Agent faces LEFT (West)\n  }\n\n  # Deltas representing the cell *in front* of the agent for each direction\n  # This is the cell where the USE action would apply.\n  direction_to_facing_delta = {\n      0: (0, -1),  # Facing UP: targets cell (x, y-1)\n      1: (1, 0),   # Facing RIGHT: targets cell (x+1, y)\n      2: (0, 1),   # Facing DOWN: targets cell (x, y+1)\n      3: (-1, 0)   # Facing LEFT: targets cell (x-1, y)\n  }\n\n  # Indices of entities that block movement\n  obstacle_indices = world.non_grabbable_indices\n\n  # BFS state: (current_x, current_y, current_direction, list_of_actions_taken)\n  queue = collections.deque([(start_pos[0], start_pos[1], start_dir, [])])\n  \n  # Visited set: (x, y, direction) to avoid cycles and redundant paths that reach\n  # the same physical location with the same orientation.\n  visited = {(start_pos[0], start_pos[1], start_dir)}\n\n  while queue:\n      curr_x, curr_y, curr_dir, path_actions = queue.popleft()\n\n      # Check if the primitive is in the cell *in front* of the agent, allowing a USE action\n      face_dx, face_dy = direction_to_facing_delta[curr_dir]\n      target_x, target_y = curr_x + face_dx, curr_y + face_dy\n\n      # Check if the target cell is within grid bounds\n      if 0 <= target_x < grid_width and 0 <= target_y < grid_height:\n          # Check if the primitive is at the target cell\n          if grid[target_x, target_y, primitive_idx] > 0:\n              return path_actions + [USE_ACTION] # Found path and can collect!\n\n      # Explore neighbors by performing cardinal moves\n      for action_id, (move_dx, move_dy) in move_deltas.items():\n          next_x, next_y = curr_x + move_dx, curr_y + move_dy\n          next_dir = action_to_new_dir[action_id] # Agent's direction after this move\n\n          # Check if the next cell is within grid bounds\n          if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n              continue\n\n          # Check if the next cell is occupied by an obstacle\n          is_obstacle = False\n          for k_idx in range(grid.shape[2]): # Iterate through all possible kinds at the cell\n              if grid[next_x, next_y, k_idx] > 0 and k_idx in obstacle_indices:\n                  is_obstacle = True\n                  break\n          if is_obstacle:\n              continue\n\n          # Check if this (position, direction) state has already been visited\n          if (next_x, next_y, next_dir) not in visited:\n              visited.add((next_x, next_y, next_dir))\n              queue.append((next_x, next_y, next_dir, path_actions + [action_id]))\n\n  # If BFS completes and no path to collect the primitive is found\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T00:43:51.024527", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  DOWN = action_map['DOWN']\n  UP = action_map['UP']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  current_state = env._current_state\n  current_pos = current_state.pos\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  # Get the integer index for the desired primitive\n  primitive_idx = env.world.cookbook.index[primitive]\n\n  # Only 'grabbable' items can be \"collected\" into inventory.\n  # If the requested primitive is not in the list of grabbable items,\n  # it cannot be collected using this function's logic.\n  if primitive_idx not in env.world.grabbable_indices:\n      return []\n\n  # If the agent is already in a position to use the primitive (i.e., within its 3x3 neighborhood),\n  # simply return the USE action. 'next_to' handles this check.\n  if current_state.next_to(primitive_idx):\n      return [USE]\n\n  # Find all grid locations where the primitive exists.\n  primitive_locations = []\n  for x in range(grid_width):\n      for y in range(grid_height):\n          if grid[x, y, primitive_idx] > 0:\n              primitive_locations.append((x, y))\n\n  # If the primitive is not found anywhere on the map, it's unreachable.\n  if not primitive_locations:\n      return []\n\n  # Define possible cardinal movement deltas and their corresponding action IDs.\n  move_deltas = {\n      (0, -1): UP,\n      (0, 1): DOWN,\n      (-1, 0): LEFT,\n      (1, 0): RIGHT\n  }\n\n  # Define true movement obstacles (cells that cannot be entered).\n  # Based on common CraftWorld assumptions, WATER and STONE are generally impassable terrain.\n  # Workshops (though non-grabbable) are typically traversable.\n  impassable_terrain_indices = {env.world.water_index, env.world.stone_index}\n\n  # Determine all possible \"target cells\" for the BFS.\n  # These are traversable cells from which the agent can successfully use the 'USE' action\n  # to collect the primitive. This means any traversable cell within the 3x3 neighborhood\n  # of any primitive instance.\n  relative_neighbor_offsets = [\n      (x, y) for x in [-1, 0, 1] for y in [-1, 0, 1]\n  ]\n\n  target_cells_for_use = set()\n  for px, py in primitive_locations:\n      for dx, dy in relative_neighbor_offsets:\n          nx, ny = px + dx, py + dy\n\n          # Check if the potential target cell is within grid bounds.\n          if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n              continue\n          \n          # Check if the potential target cell itself contains any impassable terrain.\n          is_cell_an_obstacle = False\n          for obs_idx in impassable_terrain_indices:\n              if grid[nx, ny, obs_idx] > 0:\n                  is_cell_an_obstacle = True\n                  break\n          \n          # If the cell is traversable, add it to our set of potential target destinations.\n          if not is_cell_an_obstacle:\n              target_cells_for_use.add((nx, ny))\n  \n  # If no traversable target cells can be found (e.g., all primitives are surrounded by obstacles),\n  # then the primitive is effectively unreachable.\n  if not target_cells_for_use:\n      return []\n\n  # Perform a Breadth-First Search (BFS) to find the shortest path from the agent's\n  # current position to any of the `target_cells_for_use`.\n  # The queue stores tuples: ((current_x, current_y), list_of_actions_taken_to_reach_here).\n  queue = collections.deque([(current_pos, [])])\n  visited = {current_pos} # Keep track of visited coordinates to avoid redundant paths/loops.\n  found_path = None\n\n  while queue:\n      (x, y), path = queue.popleft()\n\n      # If the current cell is one of our target cells, we've found the shortest path.\n      # BFS guarantees the first path found is the shortest.\n      if (x, y) in target_cells_for_use:\n          found_path = path\n          break\n\n      # Explore all four cardinal neighboring cells.\n      for (dx, dy), action_to_take in move_deltas.items():\n          nx, ny = x + dx, y + dy\n\n          # Check boundary conditions for the new cell.\n          if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n              continue\n          \n          # Check if the new cell contains any impassable terrain.\n          is_obstacle_for_movement = False\n          for obs_idx in impassable_terrain_indices:\n              if grid[nx, ny, obs_idx] > 0:\n                  is_obstacle_for_movement = True\n                  break\n          \n          # If the new cell is not an obstacle and has not been visited yet, add it to the queue.\n          if not is_obstacle_for_movement and (nx, ny) not in visited:\n              visited.add((nx, ny))\n              queue.append(((nx, ny), path + [action_to_take]))\n\n  # If a path was found, append the 'USE' action to actually collect the primitive.\n  if found_path is None:\n      # No path could be found to any valid cell from which the primitive can be collected.\n      return []\n  else:\n      # Return the path to the target cell followed by the USE action.\n      return found_path + [USE]", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T00:44:51.241209", "function_name": "collect", "function_body": "  ACTION_UP = craft.UP\n  ACTION_DOWN = craft.DOWN\n  ACTION_LEFT = craft.LEFT\n  ACTION_RIGHT = craft.RIGHT\n  ACTION_USE = craft.USE\n\n  WIDTH = craft.WIDTH\n  HEIGHT = craft.HEIGHT\n\n  # 1. Get current state information and the integer index for the target primitive.\n  # We access the internal `_current_state` for direct and efficient access to grid and position.\n  current_state = env._current_state\n  current_grid = current_state.grid  # numpy.ndarray of shape (WIDTH, HEIGHT, n_kinds)\n  current_pos_x, current_pos_y = current_state.pos  # tuple (int, int)\n\n  try:\n    # Convert the primitive name to lowercase as cookbook indices are typically stored this way.\n    primitive_idx = env.world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not found in the cookbook, it cannot be collected.\n    return []\n\n  # Define indices for terrain that the agent cannot move through (obstacles).\n  # These are entities that are not \"grabbable\" and block movement.\n  impassable_indices = env.world.non_grabbable_indices\n  \n  # Define indices for items that can actually be \"collected\" (picked up and added to inventory)\n  # using the USE action when the agent is next to them.\n  collectable_indices = env.world.grabbable_indices\n\n  # 2. Perform a Breadth-First Search (BFS) to find the shortest path\n  # to a cell from which the target primitive can be collected (i.e., is in the 3x3 neighborhood).\n  q = collections.deque()\n  visited = set()  # Stores (x, y) tuples of visited agent positions.\n\n  # Each item in the queue is ((agent_x, agent_y), [list_of_actions_to_reach_here])\n  q.append(((current_pos_x, current_pos_y), []))\n  visited.add((current_pos_x, current_pos_y))\n\n  target_found = False\n  path_to_collection_point = []\n\n  # Define possible agent movements (dx, dy) and their corresponding action IDs.\n  # CraftWorld's Y-axis increases downwards, X-axis increases to the right.\n  move_actions = [\n      (0, -1, ACTION_UP),    # Move North (decreases y)\n      (0, 1, ACTION_DOWN),   # Move South (increases y)\n      (-1, 0, ACTION_LEFT),  # Move West (decreases x)\n      (1, 0, ACTION_RIGHT)   # Move East (increases x)\n  ]\n\n  # Offsets to check the 3x3 neighborhood around the agent's current position (including self).\n  # This is used to determine if a primitive is within \"USE\" range.\n  neighborhood_offsets = [(dx, dy) for dx in [-1, 0, 1] for dy in [-1, 0, 1]]\n\n  while q:\n    (x, y), actions_so_far = q.popleft()\n\n    # Check if the current agent position (x, y) is a valid point from which to 'USE'\n    # to collect the desired primitive. This means checking if the primitive is within\n    # the 3x3 neighborhood of (x, y) on the static grid.\n    for ndx, ndy in neighborhood_offsets:\n      item_x, item_y = x + ndx, y + ndy\n\n      # Ensure the potential item location is within grid boundaries.\n      if not (0 <= item_x < WIDTH and 0 <= item_y < HEIGHT):\n        continue\n\n      # Check if the primitive exists at this neighbor location (value 1 indicates presence)\n      # and if it is an item that can actually be collected (is in `collectable_indices`).\n      if current_grid[item_x, item_y, primitive_idx] == 1:\n        if primitive_idx in collectable_indices:\n          target_found = True\n          path_to_collection_point = actions_so_far\n          break  # Found the shortest path to a valid collection point.\n    \n    if target_found:\n      break  # Exit the main BFS loop as a path to a collection point has been found.\n\n    # If the current position is not a collection point, explore valid neighboring cells\n    # to move to a new position.\n    for dx_move, dy_move, action_move in move_actions:\n      nx, ny = x + dx_move, y + dy_move\n\n      # Check if the next agent position is within grid boundaries.\n      if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n        continue\n\n      # Check if this neighbor cell has already been visited to avoid cycles and redundant work.\n      if (nx, ny) in visited:\n        continue\n\n      # Check if the proposed next cell (nx, ny) is passable (does not contain impassable terrain).\n      is_impassable_path = False\n      for k_idx in impassable_indices:\n        if current_grid[nx, ny, k_idx] == 1:  # If this cell contains an impassable object\n          is_impassable_path = True\n          break\n      if is_impassable_path:\n        continue\n\n      # If the neighbor is valid, unvisited, and passable, add it to the queue\n      # with the updated path.\n      visited.add((nx, ny))\n      q.append(((nx, ny), actions_so_far + [action_move]))\n\n  final_actions = []\n  if target_found:\n    # First, append all movement actions required to reach the collection point.\n    final_actions.extend(path_to_collection_point)\n    # Then, append the 'USE' action to attempt collecting the primitive.\n    final_actions.append(ACTION_USE)\n\n  return final_actions", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T00:44:52.423243", "function_name": "collect", "function_body": "  ACTION_UP = craft.UP\n  ACTION_DOWN = craft.DOWN\n  ACTION_LEFT = craft.LEFT\n  ACTION_RIGHT = craft.RIGHT\n  ACTION_USE = craft.USE\n\n  # Get current state information directly from the environment's internal state\n  current_state = env._current_state\n  current_grid = current_state.grid\n  current_pos_x, current_pos_y = current_state.pos\n  grid_width, grid_height, _ = current_grid.shape\n\n  # Get the integer ID for the target primitive from the cookbook index\n  try:\n    # Use .lower() to ensure case-insensitivity matching with cookbook entries\n    primitive_idx = env.world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not found in the cookbook, it cannot be collected.\n    return []\n\n  # Define indices for impassable terrain (non-grabbable environment entities)\n  # Agent cannot move into cells containing these\n  impassable_indices = env.world.non_grabbable_indices\n  # Define indices for entities that can be picked up\n  grabbable_indices = env.world.grabbable_indices\n  # Define indices for workshop locations, which are interactable but not grabbable\n  workshop_indices = env.world.workshop_indices\n\n  # BFS for shortest path to any cell from which the primitive can be interacted with (e.g., USEd).\n  # This means finding a path to a cell (agent_x, agent_y) such that the primitive_idx is\n  # in the 3x3 neighborhood of (agent_x, agent_y).\n  q = collections.deque()\n  visited = set() # Stores (x, y) tuples of visited cells\n\n  # Initial state: ((current_x, current_y), list_of_actions_to_reach_here)\n  q.append(((current_pos_x, current_pos_y), []))\n  visited.add((current_pos_x, current_pos_y))\n\n  target_found = False\n  path_to_target_pos = []\n\n  # Define possible movements and corresponding actions\n  # (dx, dy, action) where (dx, dy) is the change in (x, y) position\n  move_actions = [\n      (0, -1, ACTION_UP),    # Move North (decreases y)\n      (0, 1, ACTION_DOWN),   # Move South (increases y)\n      (-1, 0, ACTION_LEFT),  # Move West (decreases x)\n      (1, 0, ACTION_RIGHT)   # Move East (increases x)\n  ]\n\n  # Offsets for checking the 3x3 neighborhood (including self)\n  neighborhood_offsets = [(dx, dy) for dx in [-1, 0, 1] for dy in [-1, 0, 1]]\n\n  while q:\n    (x, y), actions_so_far = q.popleft()\n\n    # Check if the current cell (x, y) is a valid position to *USE* from\n    # This means checking if the target primitive is within its 3x3 neighborhood.\n    for ndx, ndy in neighborhood_offsets:\n      nx_item, ny_item = x + ndx, y + ndy\n\n      # Check bounds for the potential item location\n      if not (0 <= nx_item < grid_width and 0 <= ny_item < grid_height):\n        continue\n\n      # Check if the primitive exists at this neighbor location\n      if current_grid[nx_item, ny_item, primitive_idx] == 1:\n        # Check if it's a type of primitive that can be interacted with via 'USE' for 'COLLECT'\n        # This includes both grabbable items and workshops.\n        if primitive_idx in grabbable_indices or primitive_idx in workshop_indices:\n          target_found = True\n          path_to_target_pos = actions_so_far\n          break # Found a suitable primitive in 3x3 neighborhood, so (x,y) is a valid interaction point\n    \n    if target_found: # Break from the main BFS loop if an interaction point is found\n      break\n\n    # If not an interaction point, explore neighbors to move to a new position\n    for dx_move, dy_move, action_move in move_actions:\n      nx, ny = x + dx_move, y + dy_move\n\n      # Check bounds for the next agent position\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue\n\n      # Check if this neighbor cell has already been visited\n      if (nx, ny) in visited:\n        continue\n\n      # Check for impassable terrain at (nx, ny) for the agent to move into\n      is_impassable_path = False\n      for k_idx in impassable_indices:\n        if current_grid[nx, ny, k_idx] == 1: # If this cell contains an impassable object\n          is_impassable_path = True\n          break\n      if is_impassable_path:\n        continue\n\n      # Valid, unvisited, and passable neighbor, add to queue\n      visited.add((nx, ny))\n      q.append(((nx, ny), actions_so_far + [action_move]))\n\n  final_actions = []\n  if target_found:\n    final_actions.extend(path_to_target_pos)\n    # After reaching the cell from which the primitive can be interacted with,\n    # apply the 'USE' action.\n    final_actions.append(ACTION_USE)\n\n  return final_actions", "island_id": 2, "scores": {"3": 0.0}}
